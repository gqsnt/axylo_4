{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'NODE'\nimport { test } from 'node:test';\nimport assert from 'node:assert/strict';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { pathToFileURL } from 'node:url';\nimport { readArtifact } from './bench/build.mjs';\nimport { harnessDifferences } from './bench/run.mjs';\nimport { axyloAdapter } from './bench/src/adapters/axylo-common.js';\n\ntest('all existing sealed artifacts still satisfy their manifests', () => {\n const dirs=fs.readdirSync('bench/artifacts').filter(d=>fs.existsSync(path.join('bench/artifacts',d,'manifest.json')));\n for(const d of dirs) readArtifact(path.join('bench/artifacts',d));\n console.log('Verified sealed artifacts:',dirs.length);\n});\n\ntest('two-build exception stays limited to Canvas adapter presence', () => {\n const cap='axylo/capabilities.json',canvas='adapters/axylo-canvas.js';\n const base={'index.html':{sha256:'html'},'page.js':{sha256:'page'},'adapters/axylo.js':{sha256:'adapter'},[cap]:{sha256:'svg'}};\n const old={...base,[canvas]:{sha256:'canvas'},[cap]:{sha256:'both'}};\n assert.deepEqual(harnessDifferences(old,base,'axylo'),[]);\n assert.deepEqual(harnessDifferences(old,base,'axylo-canvas'),[canvas]);\n for(const name of ['index.html','page.js','adapters/axylo.js','adapters/axylo-svg.js','adapters/uplot.js']) {\n  const changed={...base,[name]:{sha256:'different'}};\n  assert.ok(harnessDifferences(old,changed,'axylo').includes(name));\n }\n assert.deepEqual(harnessDifferences(old,{...old,[canvas]:{sha256:'different'}},'axylo'),[canvas]);\n const noCaps={...old};delete noCaps[cap];\n assert.ok(harnessDifferences(noCaps,base,'axylo').includes(canvas));\n});\n\nglobalThis.__VERSIONS__={axylo:'test'};\nlet requests=[],received=[];\nglobalThis.document={createElement:()=>({}),head:{appendChild:s=>{requests.push(s.src);s.onload();}}};\nglobalThis.Axylo={line:(_el,options)=>{received.push(options);return {__bench:{ready:()=>Promise.resolve()}};},scatter:(_el,options)=>{received.push(options);return {__bench:{ready:()=>Promise.resolve()}};}};\nconst fixture={x:new Float64Array([1,2]),ys:[new Float64Array([2,3])],names:['series']};\n\ntest('current adapter handles rebuilt legacy and SVG-only capabilities', async () => {\n for(const canvasMarks of [true,false]) for(const renderer of [undefined,'svg','canvas']) {\n  requests=[];received=[];\n  globalThis.fetch=async url=>{assert.ok(url.pathname.endsWith('/axylo/capabilities.json'));requests.push('capabilities');return {ok:true,json:async()=>({canvasMarks})};};\n  const adapter=axyloAdapter('test',renderer?{renderer}:{});\n  if(\"'!canvasMarks&&renderer==='\"'canvas'){await assert.rejects(adapter.load({}),/SVG only/);assert.deepEqual(requests,['capabilities']);continue;}\n  await adapter.load({});\n  assert.equal(requests[0],'capabilities');\n  assert.equal(requests[1],'./axylo/axylo.bench.iife.min.js');\n  assert.equal(adapter.expectRendererFor({}),renderer??(canvasMarks?null:'svg'));\n  for(const kind of ['line','scatter']) {\n   adapter.create({},fixture,{kind,params:{}});\n   const options=received.at(-1);\n   if(canvasMarks&&renderer)assert.equal(options.__renderer,renderer);else assert.equal(Object.hasOwn(options,'__renderer'),false);\n  }\n }\n});\n\ntest('older sealed adapters load without capabilities and retain their own renderer behavior', async () => {\n globalThis.fetch=async()=>{throw new Error('old sealed adapters must not request new capabilities');};\n for(const [artifact,id,renderer] of [\n  ['20261119T091624Z-b643862f-b78698','axylo-canvas','canvas'],\n  ['20261119T091624Z-b643862f-b78698','axylo-svg','svg'],\n  ['20261122T042403Z-bb2826ac-ec008a','axylo-svg',null],\n ]) {\n  const adapter=(await import(pathToFileURL(path.resolve('bench/artifacts',artifact,'adapters',id+'.js')).href)).default;\n  requests=[];received=[];await adapter.load({});adapter.create({},fixture,{params:{}});\n  if(renderer)assert.equal(received.at(-1).__renderer,renderer);else assert.equal(Object.hasOwn(received.at(-1),'__renderer'),false);\n  assert.equal(requests.length,1);\n }\n});\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
