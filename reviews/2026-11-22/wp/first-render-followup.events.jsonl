2\t      readonly rule?: 'exact' | 'lattice' }\n   593\t  | { readonly kind: 'slice'; readonly sliceKey: string };\n   594\t\n   595\t/** One row of a tooltip or one announced point, as text. All text comes from the frame through the formatters. */\n   596\texport interface DatumText {\n   597\t  readonly ref: DatumRef;\n   598\t  readonly seriesIndex: number;\n   599\t  readonly seriesLabel: string;\n   600\t  /** x as the reader sees it. */\n   601\t  readonly x: string;\n   602\t  /** The value with its unit, or \"No data\" / \"No observation\". */\n   603\t  readonly value: string;\n   604\t  readonly state: SlotState;\n   605\t  /** Share of the whole for a donut slice, formatted; null elsewhere. */\n   606\t  readonly percent: string | null;\n   607\t  /** Source row index, or -1. */\n   608\t  readonly row: number;\n   609\t}\n   610\t\n   611\texport interface TooltipModel {\n   612\t  /** Heading: the x value (with its time zone for instants), the category, or the slice label. */\n   613\t  readonly title: string;\n   614\t  /** At most eight rows (spec I1). */\n   615\t  readonly rows: readonly DatumText[];\n     1\t/**\n     2\t * `createChart`: the browser host of the controller (controller.ts). It resolves the target, builds the\n     3\t * figure, the mark and text renderers and the interaction layer, and connects the page's observers to the\n     4\t * controller. Every setup step registers its own cleanup as soon as it succeeded, so a failure part-way\n     5\t * through creation, or `destroy()`, leaves the target as it was (including the custom properties the theme\n     6\t * wrote on it).\n     7\t *\n     8\t * Document-level listeners (theme and environment watchers, the interaction layer's keyboard and pointer\n     9\t * listeners on the document) are released when the target leaves the document without `destroy()`, so a\n    10\t * forgotten chart does not stay reachable from the page, and are attached again if the target comes back.\n    11\t * Detachment is noticed by the observers the chart already has (the resize observer reports a zero box),\n    12\t * not by polling.\n    13\t */\n    14\timport { svgRendererWith } from '../render/svg';\n    15\timport { createTextLayer, type TextLayer } from '../render/text';\n    16\timport { ensureStyles, resolveTheme, watchTheme } from '../theme';\n    17\timport { createFigure, type Figure } from '../dom/figure';\n    18\timport { createInteraction, type Interaction } from '../dom/interaction';\n    19\timport { mappingOf } from '../dom/mapping';\n    20\timport type { DeliveryConsole } from './delivery';\n    21\timport { createMeasurer, noteFontLoad, readTextStyle, resolveLocale, viewerTimeZone, watchEnvironment, watchLanguage } from './environment';\n    22\timport { controllerFor, type ChartHandle, type Controller, type ControllerActions } from './controller';\n    23\timport type { Composition } from './composition';\n    24\t\n    25\texport type { BenchHook, ChartHandle, ChartKind, DevHook, Stage } from './controller';\n    26\t\n    27\texport interface ChartEnvironmentOverrides {\n    28\t  readonly console?: DeliveryConsole | null;\n    29\t}\n    30\t\n    31\t/** Suffixes of the ids a chart gives its elements (figure, interaction, table). */\n    32\tconst ID_SUFFIXES = ['', '-t', '-st', '-s', '-m', '-n', '-i', '-proxy', '-table', '-table-caption', '-table-jump', '-table-jump-error'];\n    33\tlet instances = 0;\n    34\t\n    35\t/** An id prefix none of whose element ids exist in the page yet (spec A1: ids unique per chart). */\n    36\tfunction allocateId(doc: Document): string {\n    37\t  for (;;) {\n    38\t    const id = `axylo-${++instances}`;\n    39\t    if (ID_SUFFIXES.every(suffix => doc.getElementById(id + suffix) === null)) return id;\n    40\t  }\n    41\t}\n    42\t\n    43\texport function createChart(composition: Composition, target: unknown, input: unknown, overrides: ChartEnvironmentOverrides = {}): ChartHandle {\n    44\t  co