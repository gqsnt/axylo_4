  309\t};\n   310\t\n   311\t/** The SVG renderer with every mark handler (a chart kind's composition uses svgRendererWith and its own). */\n   312\texport function createSvgRenderer(doc: Document = document): MarkRenderer {\n   313\t  return svgRendererWith(ALL_MARKS, doc);\n   314\t}\n   315\t\n   316\texport function svgRendererWith(marks: SvgMarks, doc: Document = document): MarkRenderer {\n   317\t  const svg = doc.createElementNS(NS, 'svg');\n   318\t  svg.setAttribute('class', 'axylo-svg');\n   319\t  svg.setAttribute('aria-hidden', 'true');\n   320\t  svg.setAttribute('focusable', 'false');\n   350\t    (marks[mark.type] as SvgMark | undefined)?.(context, n, mark, bindings, dpr, clip);\n   351\t  }\n   352\t\n   353\t  return {\n   354\t    kind: 'svg',\n   355\t    element: svg,\n   356\t    draw(scene: Scene, bindings: PaintBindings, _theme: ResolvedTheme, devicePixelRatio: number): void {\n   357\t      const dpr = devicePixelRatio > 0 ? devicePixelRatio : 1;\n   358\t      if (scene.width !== width || scene.height !== height) {\n   359\t        width = scene.width;\n   360\t        height = scene.height;\n   361\t        svg.setAttribute('width', String(width));\n   362\t        svg.setAttribute('height', String(height));\n   363\t        svg.setAttribute('viewBox', `0 0 ${width} ${height}`);\n   364\t        attr(background, 'width', String(Math.max(0, width)));\n   365\t        attr(background, 'height', String(Math.max(0, height)));\n   366\t      }\n   367\t      setRect(sceneClip, scene.clip);\n   368\t      const url = `url(#${sceneClipId})`;\n   369\t      const next: SvgNode[] = [];\n   370\t      scene.marks.forEach((mark, i) => {\n   371\t        const key = keyOf(mark);\n   372\t        let n = slots[i];\n   373\t        if (n === undefined || n.key !== key) {\n   374\t          const fresh = node(doc, TAGS[key]!, key);\n   375\t          if (n === undefined) sceneGroup.appendChild(fresh.el);\n   376\t          else sceneGroup.replaceChild(fresh.el, n.el);\n   377\t          n = fresh;\n   378\t        }\n   379\t        update(n, mark, bindings, dpr, mark.type === 'rule' && unclippedRule(mark.role) ? null : url, scene.clip);\n   380\t        next.push(n);\n   381\t      });\n   382\t      for (let i = scene.marks.length; i < slots.length; i++) slots[i]!.el.remove();\n   383\t      slots = next;\n   384\t    },\n   385\t    drawOverlay(overlay: Overlay | null, bindings: PaintBindings, _theme: ResolvedTheme, devicePixelRatio: number): void {\n   386\t      const dpr = devicePixelRatio > 0 ? devicePixelRatio : 1;\n   387\t      overlayGroup.replaceChildren();\n   388\t      if (overlay === null) return;\n   389\t      setRect(overlayClip, overlay.clip);\n   390\t      const url = `url(#${overlayClipId})`;\n   391\t      const add = (mark: Mark, clipUrl: string | null, clip: Rect | null): void => {\n   392\t        const key = keyOf(mark);\n   393\t        const n = node(doc, TAGS[key]!, key);\n   394\t        update(n, mark, bindings, dpr, clipUrl, clip);\n   395\t        overlayGroup.appendChild(n.el);\n   396\t      };\n   397\t      for (const m of overlay.clipped) add(m, url, overlay.clip);\n   398\t      for (const m of overlay.unclipped) add(m, null, null);\n   399\t    },\n   400\t    destroy(): void {\n   401\t      svg.remove();\n   402\t      slots = [];\n   403\t    },\n   404\t  };\n   405\t}\n   406\t\n   407\tfunction clipPath(doc: Document, defs: SVGElement, id: string): SvgNode {\n   408\t  const clip = doc.createElementNS(NS, 'clipPath');\npackages/axylo/src/core/environment.ts:96:        ctx = doc.createElement('canvas').getContext('2d');\npackages/axylo/src/core/contracts.ts:351:/** Injected into layout. Browser: canvas measureText with the page's computed spacing applied. Tests: fixed metrics. */\npackages/axylo/src/core/contracts.ts:566:  readonly kind: 'canvas' | 'svg';\npackages/axylo/src/theme/color.ts:94: * read over white, the initial page canvas. Translucent series colors are composited over the background.\npackages/axylo/src/core/instrument.ts:50:    renderer: 'canvas' | 'svg';\npackages/axylo/src/core/instrument.ts:63:  readonly renderer: 'canvas' | 'svg';\npackages/axylo/src/core/instrument.ts:98:  renderer(): 'canvas' | 'svg';\npackages/axylo/src/render/svg.ts:8: * series color is always a color, never an SVG paint server (`url(#…)`), exactly as for the canvas\npackages/axylo/src/theme/resolve.ts:114:  const [overrideText, canvasText] = override ? probeColors(element, ['var(--axylo-background)', 'Canvas']) : [];\npackages/axylo/src/theme/resolve.ts:119:  const scheme = decideScheme(style, overridden ? background : null, element, canvasText);\npackages/axylo/src/theme/resolve.ts:168:function decideScheme(style: CSSStyleDeclaration, background: Rgba | null, element: HTMLElement, canvas?: string): 'light' | 'dark' {\npackages/axylo/src/theme/resolve.ts:175:    const used = parseColor(canvas ?? probeColors(element, ['Canvas'])[0]!);\npackages/axylo/src/theme/resolve.ts:186: * is opaque, over the document's canvas color. A background image on the way up makes it unknown.\npackages/axylo/src/theme/resolve.ts:204:    // The page canvas: the `Canvas` system color under the root's color-scheme.\npackages/axylo/src/theme/resolve.ts:205:    const [canvas] = probeColors(element.ownerDocument.documentElement, ['Canvas']);\npackages/axylo/src/theme/resolve.ts:206:    color = parseColor(canvas!) ?? { r: 1, g: 1, b: 1, a: 1 };\npackages/axylo/src/theme/resolve.ts:294: * Those are converted by painting one pixel, so canvas and the contrast check always get sRGB. An empty\npackages/axylo/src/theme/resolve.ts:295: * or unknown value is returned as is rather than as the canvas's initial black.\npackages/axylo/src/theme/resolve.ts:299:  const canvas = doc.createElement('canvas');\npackages/axylo/src/theme/resolve.ts:300:  canvas.width = 1;\npackages/axylo/src/theme/resolve.ts:301:  canvas.height = 1;\npackages/axylo/src/theme/resolve.ts:302:  const ctx = canvas.getContext('2d', { willReadFrequently: true });\n     1\texport { createSvgRenderer } from './svg';\n     2\texport { createTextLayer, type TextLayer } from './text';\n     1\t# Decision 0002: SVG draws the marks in 1.0\n     2\t\n     3\tStatus: **final for 1.0**, confirmed by the owner on 2026-11-22. All shipped chart types draw marks with SVG. The benchmark harness retains the old Canvas records and can replay the renderer decision on the original sealed artifact.\n     4\t\n     5\t## Release evidence\n     6\t\n     7\t- The software family selected SVG under [rule 3](../04-plan-performance.md#51-declared-endpoints-provisional-until-the-pilot). Eight timing endpoints were too noisy to distinguish the renderers by the declared tolerances. Neither renderer had a late streaming run. The old Canvas implementation added 2,269 bytes gzipped in the matched script-tag measurement, above rule 3’s 512-byte cutoff. [Software decision](../../bench/decision/no-idle-2026-11-21/decision-renderer-20261121T143350Z.json)\n     8\t- The GPU family returned no decision because the dashboard GPU-memory result depended on run order. Canvas took less main-thread time on both GPU resize workloads beyond the tolerance, with neither difference reaching the worthwhile margin. [GPU decision](../../bench/decision/no-idle-2026-11-21/decision-gpu-20261121T143402Z.json)\n     9\t- Both families ran on Chrome 158.0.8127.36 on the same reference desktop, using artifact `20261119T091624Z-b643862f-b78698`. The owner accepted the 2026-11-21 measurements and dropped the idle-machine rule. Load is recorded with the results. [Benchmark method](../../bench/README.md)\n    10\t\n    11\tThe SVG implementation uses CSS paint expressions for live theme changes and retains the plot's device-pixel geometry. 1.0 has no Canvas marks option. HTML text, accessibility, hit testing and streaming remain independent of the mark renderer.\n    12\t\n    13\tThe packed consumer bundles shrank by 2,487 gzipped bytes for all chart types (118,252 to 115,765) and 1,646 for the line-only entry (98,627 to 96,981). These before-and-after pack measurements include the related removal of the switch and Canvas-only styles.\n    14\t\n    15\t## Historical M1 review and measurements\n    16\t\n    17\tThe table below is kept as measured. These statements made from it in the first version are withdrawn or narrowed:\n    18\t\n    19\t- **Withdrawn: \"nothing measured favours canvas except all-thread CPU during resize.\"** The recorded heap, DOM-node and layout counts also favour canvas.\n    20\t- **Withdrawn: the resize CPU gap is raster work.** The number is CPU for the whole renderer process; no stage was traced.\n    21\t- **Withdrawn: simplification bounds every chart by its width.** It was shown for line series only; point marks and many-series charts were not measured.\n    22\t- **Withdrawn: an SVG theme change needs no run-time work.** Both renderers recorded six DOM mutations per toggle; \"no canvas drawing call\" is all that was observed.\n    23\t- **Withdrawn: normalization and garbage collection explain the gap to uPlot.** About 71–73% of busy time in the production profiles is unmapped; the normalization share comes from development builds. It is a hypothesis to test, not a finding.\n    24\t- **Narrowed: \"half the renderer memory.\"** The halving is of the increase above a data-only page at pixel ratio 2 (34.2 → 17.7 MiB). Absolute renderer memory was 74.7 → 56.2 MiB, and at pixel ratio 1 the increase was 23.1 → 18.4 MiB.\n    25\t- **Narrowed: \"no frame later than 25 ms.\"** True of the recorded animation-frame callbacks; the window can miss an interval that spans its boundary, and a callback is not a presented frame.\n    26\t- **Void: every 24-chart page row** (page at pixel ratio 1 and 2, resize of the 24-chart page, and the memory row). The harness fix pass found that these runs drew no marks: at 230 × 115 px each tile is below the 120 × 80 px plot minimum of spec L8, so every chart showed its text fallback. The SVG records carry `svgPaths: 0`; the canvas runs held empty canvases. The numbers compare two empty charts and say nothing about the renderers. The harness now rejects a run whose chart drew no marks, and the page workload uses 340 × 200 px tiles.\n    27\t- **Narrowed: verdicts.** 149 metric comparisons were judged without adjustment for choosing among them, on six pairs or fewer per workload, with noise bands from one session and two workload shapes. Two \"SVG lower\" rows allow a gain as small as 0.16 ms (10,000 points) and 6.3 ms (dashboard at pixel ratio 2).\n    28\t\n    29\tEvidence: [bench/results/m1-renderer-comparison.md](../../bench/results/m1-renderer-comparison.md). One session of 39 runs, production build, headless Chrome 157, machine under load from other work, A-versus-A noise bands for two workloads only.\n    30\t\n    31\t### What M1 measured\n    32\t\n    33\tCanvas → SVG, medians of main-thread task time unless stated. \"Lower\" means the 95% interval cleared zero and the noise band where one existed.\n    34\t\n    35\t| Workload | Canvas | SVG | Verdict |\n    36\t|---|---|---|---|\n    37\t| Streaming, per update | 2.26 ms | 1.45 ms | SVG lower |\n    38\t| Theme change, per toggle | 2.68 ms and 27 drawing calls | 2.01 ms and no drawing call | SVG lower |\n    39\t| Resize, one chart of 100,000 points | 915 ms | 472 ms | SVG lower on the main thread |\n    40\t| Same, CPU across all threads | 1,035 ms | 1,770 ms | **SVG higher** |\n    41\t| Resize, 24-chart page | 730 ms | 525 ms | Void: no marks were drawn |\n    42\t| First chart, 10,000 points | 34.0 ms | 28.4 ms | SVG lower |\n    43\t| 24-chart page at pixel ratio 2 | 199 ms | 158 ms | Void: no marks were drawn |\n    44\t| First chart, 3 × 120 | 23.6 ms | 19.8 ms | Inconclusive |\n    45\t| First chart, 100,000 points | 81.8 ms | 83.5 ms | Inconclusive |\n    46\t| First chart, 1,000,000 points | 622 ms | 652 ms | Inconclusive (4 blocks) |\n    47\t| Memory, 24-chart page at pixel ratio 2 | 34.2 MiB renderer, 11.5 MiB GPU, 7.7 MiB backing stores | 17.7 MiB, 2.2 MiB, none | Void: no marks were drawn |\n    48\t\n    49\tNo frame was later than 25 ms in any configuration, so frame pacing does not separate the two.\n    50\t\n    51\t### Why SVG was the working default\n    52\t\n    53\t1. On the line workloads measured, main-thread task time was lower with SVG or the two could not be told apart.\n    54\t2. Line series are simplified to a few vertices per pixel column before either renderer sees them, so for line charts the path size follows the plot width, not the data.\n    55\t3. SVG follows the page with less code: forced colors and print work through CSS, browser zoom stays sharp, and there is no backing store to size, cap or lose. This is a design argument, not a measurement.\n    56\t\n    57\t### What M1 did not establish\n    58\t\n    59\t- **GPU rasterization was not measured.** Headless Chrome here does not use a GPU. The resize, pixel-ratio-2 and process-memory results need a headed, GPU-backed rerun before they transfer.\n    60\t- **Dense point marks were not measured.** A scatter chart with tens of thousands of markers is the case most likely to favour canvas.\n    61\t- **One browser, one machine, one session.** Firefox and Safari may order the two differently.\n    62\t- **Many series, pan and zoom, and the budget workloads P4, P7 and P8 were not measured**, and the million-point comparison has four pairs.\n    63\t- Both renderers are far from uPlot in the configurations measured (about 80 ms against 12 ms at 100,000 points; uPlot draws no tooltip or accessibility layer). Where that time goes is not established.\n","exit_code":0,"status":"completed"}}
