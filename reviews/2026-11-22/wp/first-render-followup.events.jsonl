lumns: the store's own\n    54\t   * storage (streaming), the normalized frame (static) and the drawn scene.\n    55\t   */\n    56\t  memory(): { bytes: number; buffers: { name: string; bytes: number }[] };\n    57\t}\n    58\t\n    59\texport interface DevHook {\n    60\t  stages(): Record<Stage, number>;\n    61\t  /** Makes the named stage throw, to test the internal-error state; null stops it. */\n    62\t  fail(stage: Stage | null): void;\n    63\t  readonly renderer: 'canvas' | 'svg';\n    64\t  /** Rows the streaming store still holds for revisions not yet retired (0 for a static chart). */\n    65\t  retainedRows(): number;\n    66\t  /** Revisions whose rows the streaming store can still answer for (its row sources), 0 for a static chart. */\n    67\t  retainedSources(): number;\n    68\t}\n    69\t\n    70\texport type ChartHandle = Chart<unknown, Record<string, unknown>> & { __bench?: BenchHook; __dev?: DevHook };\n    71\t\n    72\t// Whether a build carries the instrumentation is `__DEV__ || (typeof __BENCH__ !== 'undefined' && __BENCH__)`,\n    73\t// written out where the controller uses it rather than named here: the build must see the constants to drop what\n    74\t// they guard. `typeof` keeps a build that defines only __DEV__ working (it then has none).\n    75\t\n    76\t/** Counts the stages that ran and makes one throw on request (the internal-error tests). */\n    77\texport class StageCounter {\n    78\t  readonly counts = Object.fromEntries(STAGES.map(s => [s, 0])) as Record<Stage, number>;\n    79\t  failing: Stage | null = null;\n    80\t  ran(name: Stage): void {\n    81\t    this.counts[name]++;\n    82\t    if (this.failing === name) throw new Error(`Axylo test hook: forced failure in the ${name} stage.`);\n    83\t  }\n    84\t}\n    85\t\n    86\t/** What the controller lets the instrumentation read; the frame on screen and its revision. */\n    87\texport interface Probe {\n    88\t  readonly stages: StageCounter;\n    89\t  /** Th