ered: !!a.clustered });\n    39\t    case 'theme': return def(a.fixture === 'trend' ? { fixture: 'trend', toggles: n(a.toggles) ?? 20 } : { size: a.size ?? '3x120', toggles: n(a.toggles) ?? 20 });\n    40\t    case 'resize': return def({ size: a.size ?? '1x100000', charts: n(a.charts) ?? 1 });\n    41\t    case 'stream': return def({ window: n(a.window) ?? 600, samples: n(a.samples) ?? 300 });\n    42\t    case 'hover': return def({ size: a.size ?? '1x100000', gaps: false, moves: n(a.moves) ?? 200 });\n    43\t    case 'zoom': return def({ size: a.size ?? '1x100000', gaps: false });\n    44\t    case 'mem': return def({ size: a.size ?? '1x1000000', gaps: false });\n    45\t    case 'lifecycle': return def({ fixture: 'trend', cycles: n(a.cycles) ?? 2500 }); // plan 5.1: windows 1,500-2,000 and 2,000-2,500\n    46\t    default: throw new Error(`unknown workload ${workload}`);\n    47\t  }\n    48\t}\n    49\t\n    50\tconst tagOf = (workload, p) => workload === 'stream' ? `w${p.window}`\n    51\t  : `${p.fixture ?? p.size}${p.gaps ? '-gaps' : ''}${p.clustered ? '-clustered' : ''}${p.charts > 1 ? `-x${p.charts}` : ''}${p.cycles ? `-c${p.cycles}` : ''}`;\n    52\tconst slug = ref => ref.replace(/[^a-zA-Z0-9.-]+/g, '_');\n    53\tconst artifactSlot = m => ({ artifact: m.id, dir: m.dir, manifestSha256: m.manifestSha256, source: { head: m.source.head, uncommitted: m.source.uncommitted, axyloSourceHash: m.source.axyloSourceHash, shippedOptions: m.source.shippedOptions, distComparison: m.source.distComparison }, bench: m.bench, files: Object.fromEntries(Object.entries(m.files).map(([p, f]) => [p, f.sha256])), served: {} });\n    54\tconst HARNESS = rel => rel === 'index.html' || rel === 'page.js' || rel.startsWith('adapters/');\n    55\tconst CANVAS_ADAPTER = 'adapters/axylo-canvas.js';\n    56\tconst CAPABILITIES = 'axylo/capabilities.json';\n    57\t\n    58\texport function harnessDifferences(a, b, adapterId) {\n    59\t  // The historical Canvas adapter may be absent from SVG-only artifacts made with this harness.\n    60\t  // Its absence is irrelevant when the comparison loads another adapter.\n    61\t  const optionalCanvas = adapterId !== 'axylo-canvas' && a[CAPABILITIES] && b[CAPABILITIES] &&\n    62\t    Boolean(a[CANVAS_ADAPTER]) !== Boolean(b[CANVAS_ADAPTER]);\n    63\t  return Object.keys({ ...a, ...b }).filter(rel => HARNESS(rel) &&\n    64\t    (rel !== CANVAS_ADAPTER || !optionalCanvas) && a[rel]?.sha256 !== b[rel]?.sha256);\n    65\t}\n    66\t\n    67\t/**\n    68\t * One balanced job. cfg: { mode: 'compare' | 'aa' | 'builds', A: { ref, slot }, B: { ref, slot }, artifacts: { A, B? },\n    69\t * workload, params, blocks, seed, bootstrapSeed, settleMs, timeoutMs, dpr, headed, noiseIds, historyDir, quiet,\n    70\t * command, label }. Returns the record (also written to history).\n    71\t */\n    72\texport async function runSession(cfg) {\n    73\t  const log = (...m) => { if (!cfg.quiet) console.log(...m); };\n    74\t  const order = balancedOrder(cfg.blocks, cfg.seed);\n    75\t  const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z');\n    76\t  const who = cfg.mode === 'aa' ? `aa-${slug(cfg.A.ref)}` : cfg.mode === 'builds' ? `builds-${slug(cfg.A.ref)}` : `${slug(cfg.A.ref)}-vs-${slug(cfg.B.ref)}`;\n    77\t  const runId = `${stamp}-${cfg.workload}-${tagOf(cfg.workload, cfg.params)}${cfg.dpr !== 1 ? `-dpr${cfg.dpr}` : ''}-${who}-${crypto.randomBytes(2).toString('hex')}`;\n    78\t  fs.mkdirSync(cfg.historyDir, { recursive: true });\n    79\t  const file = path.join(cfg.historyDir, `${runId}.json`);\n    80\t  const refA = parseAdapterRef(cfg.A.ref), refB = parseAdapterRef(cfg.B.ref);\n    81\t  const record = {\n    82\t    schema: 'axylo-bench/2',\n    83\t    runId,\n    84\t    // Stays \"interrupted\" until the last run is analysed; a run cut short by a restart is never merged with another.\n    85\t    status: 'interrupted',\n    86\t    startedAt: new Date().toISOString(),\n    87\t    command: cfg.command ?? null,\n    88\t    design: {\n    89\t      raster: cfg.gpu ? 'gpu' : 'software',\n    90\t      mode: cfg.mode, baseline: cfg.A.ref, candidate: cfg.B.ref, labels: { A: cfg.A.ref, B: cfg.B.ref }, adapters: { A: refA, B: refB },\n    91\t      ...(cfg.mode === 'builds' ? { builds: { A: cfg.artifacts.A.dir, B: cfg.artifacts.B.dir } } : {}),\n    92\t      workload: cfg.workload, params: cfg.params, blocks: cfg.blocks, order, seed: cfg.seed, bootstrapSeed: cfg.bootstrapSeed,\n    93\t      settleMs: cfg.settleMs, timeoutMs: cfg.timeoutMs, dpr: cfg.dpr, viewport: [1440, 900],\n    94\t      warmup: 'one untimed admission run per side (A then B), then one untimed warm-up run per side in the opposite order (B then A), so each side has run twice in this browser before timing starts',\n    95\t      isolate: !!cfg.isolate,\n    96\t      isolation: cfg.isolate ? 'a fresh browser process for every run (plan 5.1, where order changes the estimate)' : 'one browser process for the session, a fresh context per run',\n    97\t      endpoint: cfg.endpoint ?? null,\n    98\t      noiseFrom: null,\n    99\t    },\n   100\t    environment: null,\n   274\t        screen: { type: 'boolean', default: false }, tolerance: { type: 'string' }, 'allow-harness-difference': { type: 'boolean', default: false },\n   275\t        quiet: { type: 'boolean', default: false }, isolate: { type: 'boolean', default: false }, endpoint: { type: 'string' }, gpu: { type: 'boolean', default: false },\n   276\t      },\n   277\t    }));\n   278\t  } catch (e) { die(e.message); }\n   279\t  // --endpoint pins the recipe of a declared endpoint (src/decision.js): workload and parameters come from the table,\n   280\t  // and the renderer comparison's adapters are the default sides.\n   281\t  const ep = a.endpoint ? endpointById(a.endpoint) : null;\n   282\t  if (a.endpoint && !ep) die(`unknown endpoint ${a.endpoint}`);\n   283\t  if (ep && (a.size || a.fixture || a.charts || a.window || a.samples || a.moves || a.cycles || a.gaps || a.clustered)) die('--endpoint fixes the workload parameters; do not combine it with --size, --fixture and the like');\n   284\t  const workload = ep ? ep.workload : a.workload;\n   285\t  if (!WORKLOADS.includes(workload)) die(`unknown workload ${workload} (${WORKLOADS.join(', ')})`);\n   286\t  if (a.fixture && a.fixture !== 'trend') die(`unknown fixture ${a.fixture} (trend)`);\n   287\t  let params;\n   288\t  try { params = ep ? { ...ep.params } : workloadParams(workload, a); } catch (e) { die(e.message); }\n   289\t  if ((ep?.family === 'renderer' || ep?.family === 'gpu') && !a.aa && !a.base) { a.baseline ??= RENDERERS.A.adapter; a.candidate ??= RENDERERS.B.adapter; }\n   290\t  const blocks = a.blocks === undefined ? DEFAULT_BLOCKS : Number(a.blocks);\n   291\t  let seed, bootstrapSeed;\n   292\t  try {\n   293\t    seed = a.seed !== undefined ? parseSeed(a.seed, '--seed') : crypto.randomInt(1, 2 ** 31);\n   294\t    bootstrapSeed = a['bootstrap-seed'] !== undefined ? parseSeed(a['bootstrap-seed'], '--bootstrap-seed') : DEFAULT_BOOTSTRAP_SEED;\n   295\t    balancedOrder(blocks, seed);\n   296\t  } catch (e) { die(e.message); }\n   297\t  const settleMs = Number(a.settle), timeoutMs = Number(a.timeout), dpr = ep?.dpr ?? Number(a.dpr);\n   298\t  if (ep?.raster === 'gpu' && !a.gpu) die(`endpoint ${ep.id} belongs to the gpu family: add --gpu`);\n   299\t  if (!(dpr === 1 || dpr === 2)) die(`--dpr must be 1 or 2, got ${a.dpr}`);\n   300\t  const historyDir = path.resolve(a['history-dir'] ?? path.join(BENCH, 'history'));\n   301\t\n   302\t  let mode, A, B, artifacts;\n   303\t  try {\n   304\t    if (a.base) {\n   305\t      if (!a.candidate || !a.adapter) die('two-build mode needs --adapter <ref> --base <artifact dir> --candidate <artifact dir>');\n   306\t      mode = 'builds';\n   307\t      const ref = parseAdapterRef(a.adapter);\n   308\t      A = { ref: a.adapter, slot: 'A' }; B = { ref: a.adapter, slot: 'B' };\n   309\t      artifacts = { A: readArtifact(a.base), B: readArtifact(a.candidate) };\n   310\t      if (artifacts.A.id === artifacts.B.id) die('--base and --candidate are the same artifact; use --aa for A-versus-A');\n   311\t      // Only the library may differ: a different page or adapter would confound the comparison.\n   312\t      const diff = harnessDifferences(artifacts.A.files, artifacts.B.files, ref.id);\n   313\t      if (diff.length && !a['allow-harness-difference']) die(`the two artifacts differ in harness files, not only in the library: ${diff.join(', ')} (rebuild both with the same bench/, or pass --allow-harness-difference)`);\n   314\t    } else {\n   315\t      const aa = a.aa ?? null;\n   316\t      const baseline = aa ?? a.baseline, candidate = aa ?? a.candidate;\n   317\t      if (!baseline || !candidate) die('give --baseline and --candidate, or --aa <adapter>, or --adapter with --base and --candidate');\n   318\t      parseAdapterRef(baseline); parseAdapterRef(candidate);\n   319\t      mode = aa ? 'aa' : 'compare';\n   320\t      A = { ref: baseline, slot: 'A' }; B = { ref: candidate, slot: 'A' };\n   321\t      artifacts = { A: a.artifact ? readArtifact(a.artifact) : readArtifact((await build({ source: a.source })).dir) };\n   322\t      if (!a.artifact && !a.quiet) console.log(`built session artifact ${artifacts.A.dir}`);\n   323\t    }\n   324\t  } catch (e) { die(e.message); }\n   325\t  if (a.screen && mode !== 'builds') die('--screen applies to two-build mode (--base/--candidate)');\n   326\t  let tolerance = null;\n   327\t  if (a.screen) { tolerance = Number(a.tolerance); if (a.tolerance === undefined || !Number.isFinite(tolerance)) die('--screen needs --tolerance <largest regression tolerated, in the primary metric\\'s unit>; the plan has it declared per workload before measuring'); }\n   328\t\n   329\t  const cfg = { mode, A, B, artifacts, workload, params, blocks, isolate: a.isolate, gpu: a.gpu, endpoint: ep?.id, seed, bootstrapSeed, settleMs, timeoutMs, dpr, headed: a.headed, noiseIds: a.noise ? a.noise.split(',') : null, historyDir, quiet: a.quiet, command: process.argv.slice(2) };\n   330\t  try {\n   331\t    const first = await runSession(cfg);\n   332\t    if (!a.screen) return;\n   333\t    const v1 = screeningVerdict(first, tolerance);\n   334\t    console.log(`screening, first job ${first.runId}: ${v1.status} (${v1.why})`);\n   335\t    if (!v1.exceeds && !v1.failed) return;\n   340\t    console.log(flagged ? `FLAGGED: ${v1.status} then ${v2.status}, two jobs in a row` : 'not flagged: the rerun did not confirm the first job');\n   341\t    const screenFile = path.join(historyDir, `${again.runId}.screening.json`);\n   342\t    fs.writeFileSync(screenFile, JSON.stringify({ schema: 'axylo-bench-screening/1', tolerance, jobs: [first.runId, again.runId], verdicts: [v1, v2], flagged }, null, 1));\n   343\t    if (flagged) process.exitCode = 3;\n   344\t  } catch (e) {\n   345\t    console.error(e?.message ?? e);\n   346\t    process.exit(1);\n   347\t  }\n   348\t}\n   349\t\n   350\tif (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) await main();\n     1\t// Browser side of the runner: a file server for sealed artifacts that lives only as long as the calling script,\n     2\t// system Chrome through Playwright, and one run in a fresh browser context.\n     3\timport http from 'node:http';\n     4\timport fs from 'node:fs';\n     5\timport os from 'node:os';\n     6\timport path from 'node:path';\n     7\timport { execFileSync } from 'node:child_process';\n     8\timport { chromium } from 'playwright-core';\n     9\timport { BENCH, REPO, sha256 } from '../build.mjs';\n    10\timport { workloadData, expectedView, heldColumns, checksum, zoomSteps } from '../src/fixtures.js';\n    11\timport { checkViews } from '../src/admission.js';\n    12\timport { streamCompletion } from '../src/stats.js';\n    13\t\n    14\tconst TYPES = { '.html': 'text/html', '.js': 'text/javascript', '.json': 'application/json', '.css': 'text/css', '.map': 'application/json' };\n    15\t\n    16\t/**\n    17\t * Serves sealed artifacts (build.mjs readArtifact manifests), one per slot, at /<slot>/<path>. Only files in the\n    18\t * slot's manifest are served, each read whole, hashed and compared with the manifest before a byte goes out; a\n    19\t * mismatch is answered with 500 and recorded. `served()` returns, per slot, the hash of every file actually sent.\n    20\t */\n    21\texport function startServer(slots) {\n    22\t  const served = Object.fromEntries(Object.keys(slots).map(s => [s, {}]));\n    23\t  const violations = [];\n    24\t  const server = http.createServer((req, res) => {\n    25\t    const url = new URL(req.url, 'http://x');\n    26\t    const m = /^\\/([A-Za-z0-9]+)\\/(.*)$/.exec(url.pathname);\n    27\t    const slot = m && slots[m[1]];\n    28\t    const rel = m ? decodeURIComponent(m[2]) || 'index.html' : null;\n    29\t    const entry = slot?.files?.[rel];\n    30\t    if (!entry || rel === 'manifest.json') { res.writeHead(404); res.end('not found'); return; }\n    31\t    let bytes;\n    32\t    try { bytes = fs.readFileSync(path.join(slot.dir, rel)); } catch { res.writeHead(404); res.end('not found'); return; }\n    33\t    const h = sha256(bytes);\n    34\t    if (h !== entry.sha256) { violations.push(`${m[1]}/${rel}: served bytes ${h.slice(0, 12)} differ from the manifest ${entry.sha256.slice(0, 12)}`); res.writeHead(500); res.end('artifact changed'); return; }\n    35\t    served[m[1]][rel] = h;\n    36\t    res.writeHead(200, { 'content-type': TYPES[path.extname(rel)] ?? 'application/octet-stream', 'cache-control': 'no-store' });\n    37\t    res.end(bytes);\n    38\t  });\n    39\t  return new Promise(resolve => server.listen(0, '127.0.0.1', () => resolve({\n    40\t    base: `http://127.0.0.1:${server.address().port}/`,\n    41\t    url: slot => `http://127.0.0.1:${server.address().port}/${slot}/`,\n    42\t    served: () => JSON.parse(JSON.stringify(served)),\n    43\t    violations: () => [...violations],\n    44\t    close: () => new Promise(r => server.close(r)),\n    45\t  })));\n    46\t}\n    47\t\n    48\t/** Flags that let headless Chrome rasterize on this machine's GPU (owner, 2026-11-18). Headed uses the desktop's. */\n    49\texport const GPU_FLAGS = ['--enable-gpu', '--use-angle=gl', '--ignore-gpu-blocklist'];\n    50\t\n    51\texport async function launchBrowser({ headed = false, gpu = false } = {}) {\n    52\t  const args = gpu ? (headed ? ['--ignore-gpu-blocklist'] : GPU_FLAGS) : [];\n    53\t  // A headed browser needs the desktop session; DISPLAY :0 unless the caller has one.\n    54\t  const env = headed ? { ...process.env, DISPLAY: process.env.DISPLAY ?? ':0' } : undefined;\n    55\t  return chromium.launch({ channel: 'chrome', headless: !headed, args, ...(env ? { env } : {}) });\n    56\t}\n    57\t\n    58\t/**\n   155\t      if (result.adapter?.expectRenderer && d.renderer.kind !== result.adapter.expectRenderer) reasons.push(`chart ${i}: renderer ${d.renderer.kind}, asked for ${result.adapter.expectRenderer}`);\n   156\t      if (!d.hasMarks) reasons.push(`chart ${i}: no marks drawn`);\n   157\t    });\n   158\t    return { admitted: !reasons.length, reasons, limits: ['release build (shipped bytes, no hook): a sanity run, readiness guessed from two frames; not a timing for any endpoint'], sanity: true };\n   159\t  }\n   160\t  const exp = expectedFor(spec.workload, spec.params);\n   161\t  if (result.checksum !== exp.checksum) return { admitted: false, reasons: [`page fixture checksum ${result.checksum} differs from the runner's ${exp.checksum}`], limits: [] };\n   162\t  const expectRenderer = result.adapter?.expectRenderer;\n   163\t  const view = checkViews(exp.views, result.describe, exp.columns.map(columns => ({ columns, requireDrawn, expectRenderer })));\n   164\t  // Workload-specific end states, checked in the page: the marks changed color (theme), the charts follow their\n   165\t  // container's width (resize), the readout followed the pointer (hover), the final zoom window (zoom).\n   166\t  const extra = [];\n   167\t  // Resize probe: the readback at the narrowest width is admitted like the final one (drawn geometry, renderer).\n   168\t  if (result.intermediateDescribe) {\n   169\t    const mid = checkViews(exp.views, result.intermediateDescribe, exp.columns.map(columns => ({ columns, requireDrawn, expectRenderer })));\n   170\t    for (const r of mid.reasons) extra.push(`at the narrowest width: ${r}`);\n   171\t  }\n   172\t  for (const [key, label] of [['themeCheck', 'theme'], ['resizeCheck', 'resize'], ['hoverCheck', 'hover'], ['zoomCheck', 'zoom'], ['lifecycleCheck', 'lifecycle'], ['compactCheck', 'compact']]) {\n   173\t    const c = result[key];\n   174\t    if (c && !c.ok) for (const r of c.reasons) extra.push(`${label}: ${r}`);\n   175\t  }\n   176\t  return { admitted: view.admitted && extra.length === 0, reasons: [...view.reasons, ...extra], limits: view.limits };\n   177\t}\n   178\t\n   179\tconst DURATIONS = ['TaskDuration', 'ScriptDuration', 'LayoutDuration', 'RecalcStyleDuration', 'DevToolsCommandDuration', 'V8CompileDuration', 'TaskOtherDuration', 'ThreadTime'];\n   180\tconst COUNTS = ['LayoutCount', 'RecalcStyleCount', 'Nodes', 'JSEventListeners', 'JSHeapUsedSize', 'JSHeapTotalSize'];\n   181\t\n   182\t/** Every \"<name>:start\" / \"<name>:end\" snapshot pair -> metric deltas, keyed \"<name>:start-><name>:end\". */\n   183\tfunction deltas(snaps, cpu, pagePid, gpuPid) {\n   184\t  const out = {};\n   185\t  for (const from of Object.keys(snaps)) {\n   186\t    if (!from.endsWith(':start')) continue;\n   187\t    const to = `${from.slice(0, -6)}:end`;\n   188\t    if (!snaps[to]) continue;\n   189\t    const d = {};\n   190\t    for (const k of [...DURATIONS, ...COUNTS]) if (k in snaps[from] && k in snaps[to]) d[k] = snaps[to][k] - snaps[from][k];\n   191\t    d.endNodes = snaps[to].Nodes;\n   192\t    d.endJSHeapUsedSize = snaps[to].JSHeapUsedSize;\n   193\t    // CPU time of whole processes (all threads), from the browser: the page's renderer and the GPU process.\n   194\t    const c0 = cpu[from], c1 = cpu[to];\n   195\t    if (c0 && c1) {\n   196\t      if (pagePid && pagePid in c0 && pagePid in c1) d.rendererCpu = c1[pagePid] - c0[pagePid];\n   197\t      if (gpuPid && gpuPid in c0 && gpuPid in c1) d.gpuCpu = c1[gpuPid] - c0[gpuPid];\n   198\t    }\n   199\t    out[`${from}->${to}`] = d;\n   200\t  }\n   201\t  return out;\n   202\t}\n   203\t\n   204\t/** Linux only: proportional set size and resident size of a process, in bytes, from /proc. */\n   205\tfunction procMemory(pid) {\n   206\t  try {\n   207\t    const t = fs.readFileSync(`/proc/${pid}/smaps_rollup`, 'utf8');\n   208\t    const kb = name => Number((new RegExp(`^${name}:\\\\s+(\\\\d+) kB`, 'm').exec(t) ?? [])[1]) * 1024;\n   209\t    return { pss: kb('Pss'), rss: kb('Rss') };\n   210\t  } catch (e) { return { na: `not available: ${e.code ?? e.message}` }; }\n   211\t}\n   212\t\n   213\t/**\n   214\t * One run in a fresh context. Returns { outcome, ... } where outcome is one of\n   215\t * ok | not-admitted | incomplete | not-available | error | timeout | crash.\n   216\t * spec: { adapter, adapterParams?, workload, params, settleMs, timeoutMs, dpr?, slot?, probe?: 'geometry' | 'counters',\n   217\t *         profile?: { file } }\n   218\t */\n   219\texport async function runOnce(browser, server, spec) {\n   220\t  const started = Date.now();\n   221\t  const ctx = await browser.newContext({ viewport: { width: 1440, height: 900 }, deviceScaleFactor: spec.dpr ?? 1, timezoneId: 'UTC', locale: 'en-US' });\n   222\t  const logs = [], pageErrors = [], snaps = {}, cpu = {}, mem = {}, profiles = {};\n   223\t  let settle;\n   224\t  const finished = new Promise(r => { settle = r; });\n   225\t  let timer, bcdp;\n   226\t  try {\n   227\t    const page = await ctx.newPage();\n   228\t    const cdp = await ctx.newCDPSession(page);\n   229\t    bcdp = await browser.newBrowserCDPSession();\n   230\t    await cdp.send('Performance.enable', { timeDomain: 'timeTicks' });\n   231\t    const processes = async () => (await bcdp.send('SystemInfo.getProcessInfo')).processInfo;\n   232\t    const cpuSample = async label => { cpu[label] = Object.fromEntries((await processes()).map(p => [p.id, p.cpuTime])); };\n   233\t    let profiling = null;\n   234\t    const startProfile = async name => {\n   235\t      await cdp.send('Profiler.enable');\n","exit_code":0,"status":"completed"}}
