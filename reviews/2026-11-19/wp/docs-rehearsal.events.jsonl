{"type":"item.completed","item":{"id":"item_2","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/data/values.ts && rg -n '\"'^#{1,4} '\"' docs/02-product-spec.md docs/03-plan-typescript-release.md\"","aggregated_output":"import { SLOT_ABSENT_FIELD, SLOT_INVALID, SLOT_NULL, SLOT_VALUE, type DiagnosticSink, type SlotState } from '../core/contracts';\nimport type { ResolvedValueField } from './options';\nimport { Reports } from './reports';\nimport type { Table } from './table';\n\nconst decimal = /^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$/;\nexport type ValueMode = 'empty' | 'decimal' | 'other';\nexport type ValueCounts = Record<Exclude<ValueMode, 'empty'>, number>;\n\nexport function valueMode(value: unknown, column: boolean): ValueMode {\n  if (value == null || value === '' || (column && typeof value === 'number' && Number.isNaN(value))) return 'empty';\n  return typeof value === 'string' && decimal.test(value) ? 'decimal' : 'other';\n}\n\nexport function inspectValues(table: Table, field: string, included?: (row: number) => boolean): ValueMode {\n  let mode: ValueMode = 'empty';\n  for (let i = 0; i < table.length; i++) {\n    if (included && !included(i)) continue;\n    const next = valueMode(table.read(i, field), table.isColumnRow(i));\n    if (next === 'other') return next;\n    if (next === 'decimal') mode = next;\n  }\n  return mode;\n}\n\nexport interface Values {\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n}\n\nexport function readValues(\n  table: Table,\n  field: ResolvedValueField,\n  sink: DiagnosticSink,\n  impute: boolean,\n  startRow = 0,\n  mode?: ValueMode,\n  included?: (row: number) => boolean,\n  outcome?: string,\n  counts?: ValueCounts,\n): Values {\n  const column = table.columns?.[field.field];\n  const borrowed = column instanceof Float64Array || column instanceof Float32Array;\n  const zero = impute && field.missing === 'zero';\n  const slot = new Uint8Array(table.length);\n  let y = borrowed ? column : new Float64Array(table.length);\n  let i = 0;\n  if (borrowed && !included) {\n    // Values and typed NaNs can stay in the caller's storage without generic row validation.\n    let missing = 0;\n    for (; i < table.length; i++) {\n      const value = column[i]!;\n      if (Number.isFinite(value)) continue;\n      if (zero || !Number.isNaN(value)) break;\n      slot[i] = SLOT_NULL;\n      missing++;\n    }\n    if (counts) counts.other += i - missing;\n    if (i === table.length) return { y, slot };\n  }\n  const reports = new Reports(field.field, sink);\n  mode ??= borrowed ? 'other' : inspectValues(table, field.field, included);\n\n  for (; i < table.length; i++) {\n    if (included && !included(i)) continue;\n    const raw = column === undefined ? table.read(i, field.field) : column[i];\n    if (counts) {\n      const kind = valueMode(raw, table.isColumnRow(i));\n      if (kind !== 'empty') counts[kind]++;\n    }\n    let value = NaN;\n    let state: SlotState = SLOT_VALUE;\n    if (typeof raw === 'number') {\n      if (Number.isFinite(raw)) value = raw;\n      else if (Number.isNaN(raw) && (column || table.isColumnRow(i))) state = SLOT_NULL;\n      else {\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n      }\n    } else if (raw === undefined) {\n      state = SLOT_ABSENT_FIELD;\n      reports.add('AX102', zero ? 'changed' : 'omitted', startRow + table.rowIndex(i), undefined, undefined,\n        { outcome: zero ? undefined : outcome });\n    } else if (raw === null || raw === '') {\n      state = SLOT_NULL;\n    } else if (mode === 'decimal') {\n      value = Number(raw);\n      if (!Number.isFinite(value)) {\n        value = NaN;\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n      }\n      if (field.parse !== 'number') reports.add('AX104', 'none', startRow + table.rowIndex(i));\n    } else {\n      state = SLOT_INVALID;\n      reports.add('AX106', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n    }\n    if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) value = 0;\n    if (y === column && !Object.is(y[i], value)) {\n      // Infinity and explicit zero imputation cannot be represented by an unchanged borrowed view.\n      y = y.slice();\n    }\n    if (y !== column) y[i] = value;\n    slot[i] = state;\n  }\n\n  reports.flush(sink);\n  return { y, slot };\n}\ndocs/02-product-spec.md:1:# Phase 1b: Axylo product specification\ndocs/02-product-spec.md:7:## 1. What Axylo is\ndocs/02-product-spec.md:15:### 1.1 Why someone would choose it\ndocs/02-product-spec.md:29:### 1.2 Who it is for\ndocs/02-product-spec.md:35:### 1.3 Principles\ndocs/02-product-spec.md:46:## 2. Scope of the first release\ndocs/02-product-spec.md:48:### 2.1 Chart types\ndocs/02-product-spec.md:65:### 2.2 Workflows\ndocs/02-product-spec.md:76:### 2.3 Supported environments\ndocs/02-product-spec.md:87:## 3. Acceptance criteria: the reader's experience\ndocs/02-product-spec.md:91:### 3.1 Faithful representation\ndocs/02-product-spec.md:108:### 3.2 Legibility\ndocs/02-product-spec.md:121:### 3.3 Interaction\ndocs/02-product-spec.md:132:### 3.4 Accessibility\ndocs/02-product-spec.md:149:### 3.5 Diagnostic registry\ndocs/02-product-spec.md:189:### 3.6 Type matrix\ndocs/02-product-spec.md:201:### 3.7 Compact variant\ndocs/02-product-spec.md:215:### 3.8 What the evidence will and will not show\ndocs/02-product-spec.md:219:## 4. Acceptance criteria: the developer's experience\ndocs/02-product-spec.md:236:## 5. Performance budgets\ndocs/02-product-spec.md:257:## 6. Decisions and the findings behind them\ndocs/02-product-spec.md:282:## 7. Changes this revision rejected\ndocs/02-product-spec.md:291:## 8. Decisions still open\ndocs/03-plan-typescript-release.md:1:# Phase 2 plan: Axylo 1.0 in TypeScript\ndocs/03-plan-typescript-release.md:9