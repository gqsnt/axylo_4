{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"node -p '/\"'^[+-]?'\"\\\\d+(?:\\\\.\\\\d+)?(?:[eE][+-]?\\\\d+)?\"'$/.test(\"40'\"\\\\n\\\")'\nsed -n '72,108p' apps/docs/lib/site.mjs\nrg -n 'node\\\\b|allowJs|tsconfig' apps/docs/test/{examples,site}.browser.test.ts apps/docs/lib/consumer.mjs\nsed -n '145,178p' rehearsal/reader.mjs\nsed -n '204,235p' apps/docs/pages/options.md\ncat packages/axylo/package.json\"","aggregated_output":"false\n * scripts/build.mjs itself, so it follows the library's build by construction: the stylesheet must equal\n * `stylesheets().minified` (dist/axylo.css is that text), and the development bundle, rebuilt from\n * packages/axylo/src in memory with the build's DEVELOPMENT constants and the options it uses for\n * axylo.dev.js, must equal the installed file byte for byte. Anything else means packages/axylo/dist is older\n * or newer than its source.\n */\nasync function checkSameRevision(css, bundle, { unchecked = false, log = () => {} } = {}) {\n  const problems = [];\n  const { stylesheets, DEVELOPMENT } = await import(pathToFileURL(path.join(repoRoot, 'scripts/build.mjs')).href);\n  const { minified } = await stylesheets();\n  if (minified !== css) problems.push('the installed axylo.css differs from the minified packages/axylo/src/theme/css.ts');\n  const rebuilt = await build({\n    entryPoints: [path.join(repoRoot, 'packages/axylo/src/index.ts')], bundle: true, target: 'es2022', legalComments: 'none',\n    logLevel: 'silent', format: 'esm', define: DEVELOPMENT, write: false, outfile: path.join(repoRoot, 'packages/axylo/dist/axylo.dev.js'),\n    absWorkingDir: repoRoot,\n  });\n  if (Buffer.from(rebuilt.outputFiles[0].contents).toString('utf8') !== bundle) {\n    problems.push('the installed axylo.dev.js differs from what packages/axylo/src builds to now');\n  }\n  const source = JSON.parse(fs.readFileSync(path.join(repoRoot, 'packages/axylo/package.json'), 'utf8')).version;\n  const shipped = JSON.parse(fs.readFileSync(path.join(installed('axylo'), 'package.json'), 'utf8')).version;\n  if (source !== shipped) problems.push(`version ${shipped} installed, ${source} in source`);\n  if (problems.length && !unchecked) {\n    throw new Error(`The packed library and its source differ (run \\`npm run build\\`, then build the site again):\\n  ${problems.join('\\n  ')}`);\n  }\n  for (const p of problems) log(`unchecked library: ${p}`);\n  return { messages: (await importSource('packages/axylo/src/messages/index.ts')).defaultMessages, problems };\n}\n\nconst DIST = path.join(docsRoot, 'dist');\n/** Where a build that skipped the revision check goes: never the site's own output. */\nexport const UNCHECKED_DIR = path.join(docsRoot, '.cache/unchecked-site');\n\n/** Keeps staging on the output filesystem so the finished site can be renamed into place. */\nexport async function stageSite(outDir, writeSite) {\n  const staging = `${outDir}.tmp-${process.pid}`;\n  fs.rmSync(staging, { recursive: true, force: true });\napps/docs/lib/consumer.mjs:16:import { execFileSync } from 'node:child_process';\napps/docs/lib/consumer.mjs:17:import fs from 'node:fs';\napps/docs/lib/consumer.mjs:18:import path from 'node:path';\napps/docs/lib/consumer.mjs:131:    compilerOptions: { ...STRICT, lib: ['ES2022', 'DOM', 'DOM.Iterable'], allowJs: true, checkJs: true },\napps/docs/lib/consumer.mjs:134:  const node = { compilerOptions: { ...STRICT, lib: ['ES2022', 'DOM'] }, include: ['src/node/*.ts'] };\napps/docs/lib/consumer.mjs:135:  fs.writeFileSync(path.join(consumerDir, 'tsconfig.json'), JSON.stringify(browser, null, 2));\napps/docs/lib/consumer.mjs:136:  fs.writeFileSync(path.join(consumerDir, 'tsconfig.node.json'), JSON.stringify(node, null, 2));\napps/docs/lib/consumer.mjs:137:  return { browser: path.join(consumerDir, 'tsconfig.json'), node: path.join(consumerDir, 'tsconfig.node.json') };\napps/docs/test/site.browser.test.ts:8:import fs from 'node:fs';\napps/docs/test/site.browser.test.ts:9:import path from 'node:path';\napps/docs/test/site.browser.test.ts:10:import { createRequire } from 'node:module';\napps/docs/test/examples.browser.test.ts:21:import { execFileSync } from 'node:child_process';\napps/docs/test/examples.browser.test.ts:22:import path from 'node:path';\napps/docs/test/examples.browser.test.ts:36:  // Through node itself, so the same call works on Windows, where node_modules/.bin/tsc is a shell script.\napps/docs/test/examples.browser.test.ts:67:    const { node: config } = writeConsumerTsconfigs();\napps/docs/test/examples.browser.test.ts:69:    const result = typecheck(config, ['vitest', '@vitest', 'chai', '@types/chai', '@types/deep-eql', 'expect-type', 'tinyrainbow', '@standard-schema', 'vite', 'tinybench', 'tinyexec', 'pathe', '@types/estree', 'rollup', 'esbuild', 'postcss', 'source-map-js', 'nanoid', 'picocolors', 'lightningcss', 'rolldown', '@rolldown', '@oxc-project', 'obug', 'std-env', 'magic-string', '@jridgewell', 'estree-walker', 'fdir', 'picomatch', 'tinyglobby', 'es-module-lexer', 'why-is-node-running', 'detect-libc', 'assertion-error', '@types/node', 'undici-types']);\n        .map(([, command, x, y]) => ({ command, x: new DOMPoint(+x, +y).matrixTransform(matrix).x }));\n    }));\n  const present = expected.rows.flatMap(([day, value], index) => value === null ? [] : [{ day, index }]);\n  const step = (vertices.at(-1)?.x - vertices[0]?.x) / (present.at(-1).index - present[0].index);\n  const ordered = step > 0 && vertices.length === present.length &&\n    vertices.every(({ x }, i) => Math.abs(x - (vertices[0].x + (present[i].index - present[0].index) * step)) <= 1);\n  const gaps = expected.rows.flatMap(([day, value]) => value === null ? [day] : []);\n  const broken = ordered && present.every(({ index }, i) => {\n    const startsRun = i === 0 || index - present[i - 1].index > 1;\n    return vertices[i].command === (startsRun ? 'M' : 'L');\n  });\n  return {\n    order: { pass: ordered, detail: `Expected ${present.length} left-to-right calendar slots, saw ${vertices.length} stroke vertices.` },\n    gaps: { pass: broken, detail: gaps.length ? `Expected stroke breaks at ${gaps.join(', ')}.` : 'Expected one continuous stroke.' },\n  };\n}\n| `zoom` | `readonly [XValue, XValue] \\| null` | A `zoom()` call or the reader changed the visible range; `null` for the whole range. Not sent when the view moves with appended data. |\n\n<!-- options: Point -->\n| Point key | Type | Meaning |\n|---|---|---|\n| `series` | `string` | The series key: the `series` value for long rows, the field name for wide rows, the slice label on a donut. |\n| `x` | `XValue` | In the form `zoom()` accepts: a `Date` for an instant, `'YYYY-MM-DD'` for a calendar date, an ISO date-time without offset for a wall-clock time, the category, otherwise the number. |\n| `y` | `number \\| null` | The value; `null` for no data. |\n| `row` | `Row \\| null` | Your row; with typed columns, an object built from the columns at that index; `null` for a position no row holds. |\n| `index` | `number` | The row's index in your data; `-1` when `row` is `null`. |\n\n### Diagnostic\n\n<!-- options: Diagnostic -->\n| Key | Type | Meaning |\n|---|---|---|\n| `code` | `` `AX${number}` `` | Stable code, with a page under [Diagnostics](diagnostics.md). |\n| `level` | `'error' \\| 'warning' \\| 'hint'` | See [levels](diagnostics.md#levels-and-who-is-told). |\n| `message` | `string` | What is wrong, where, and how to fix it. |\n| `chart` | `string` | The chart's title, else its element id. |\n| `field` | `string` | The field or option, when it is about one. |\n| `rows` | `readonly number[]` | The first offending rows in your data, at most ten, when it is about rows. |\n| `count` | `number` | How many values or rows in all, when it counts them. |\n\n## validate\n\n`validate(type, options)` takes `'line'`, `'area'`, `'bar'`, `'scatter'` or `'donut'` and that type's options, runs the checks a created chart runs from its call without a DOM, and returns `Diagnostic[]`. It cannot find what needs a page: contrast, sizes, label fitting, formatters, or whether a `labelledBy` id exists. See [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\n\n## Messages\n\nEvery message the chart shows the reader can be replaced through `messages`: the notes, states, controls, the table's labels, the generated name and summary. Diagnostics for developers keep the registry's English wording. Placeholders in braces are filled in by the chart; an override should keep the ones it needs. `{seeTable}` is filled with `seeTable` when the chart has a table and removed when it does not (`table: false`), so a translated note that keeps it reads right either way:\n\n{\n  \"name\": \"axylo\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Everyday charts that are faithful to the data, readable everywhere and accessible by default.\",\n  \"license\": \"MIT\",\n  \"type\": \"module\",\n  \"sideEffects\": [\"*.css\"],\n  \"files\": [\n    \"dist/axylo.js\",\n    \"dist/axylo.dev.js\",\n    \"dist/axylo.iife.js\",\n    \"dist/axylo.iife.min.js\",\n    \"dist/axylo.css\",\n    \"dist/index.d.ts\",\n    \"dist/public.d.ts\"\n  ],\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"development\": \"./dist/axylo.dev.js\",\n      \"default\": \"./dist/axylo.js\"\n    },\n    \"./axylo.css\": \"./dist/axylo.css\"\n  }\n}\n","exit_code":0,"status":"completed"}}
