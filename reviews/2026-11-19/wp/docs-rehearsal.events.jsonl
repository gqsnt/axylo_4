e library's defaultMessages; where each is shown from data/messages.mjs, key for key. */\napps/docs/lib/site.mjs:518:function messagesTable(ctx, link) {\napps/docs/lib/site.mjs:519:  const keys = Object.keys(ctx.messages);\napps/docs/lib/site.mjs:520:  const unknown = Object.keys(ctx.messageUses).filter(key => !keys.includes(key));\napps/docs/lib/site.mjs:521:  const undescribed = keys.filter(key => !Object.hasOwn(ctx.messageUses, key));\napps/docs/lib/site.mjs:523:    throw new Error(`apps/docs/data/messages.mjs and defaultMessages differ: ${[...undescribed.map(k => `no entry for ${k}`), ...unknown.map(k => `${k} is not a message key`)].join(', ')}`);\napps/docs/lib/site.mjs:525:  const rows = Object.entries(ctx.messages).map(([key, text]) => [\napps/docs/lib/site.mjs:526:    `<th scope=\"row\"><code>${escapeHtml(key)}</code></th>`, `<td>${escapeHtml(text)}</td>`, `<td>${renderInline(ctx.messageUses[key], link)}</td>`,\napps/docs/lib/site.mjs:528:  return htmlTable(['Key', 'Built-in English text', 'Where it is shown'], rows, 'Built-in messages');\napps/docs/lib/site.mjs:531:function paletteTable(ctx) {\napps/docs/lib/site.mjs:546: * `validate()`, so the page shows the message exactly as the library writes it; the others need a page\napps/docs/lib/site.mjs:547: * (contrast, size, labels, formatters, appends) and show the registry's message for the sample details in\napps/docs/lib/site.mjs:550:async function diagnosticOutput(diagnostics) {\napps/docs/lib/site.mjs:562:        return mine.map(x => `[axylo ${x.code}] ${JSON.stringify(x.chart)}: ${x.message}`);\napps/docs/lib/site.mjs:566:      return [`[axylo ${d.code}] ${JSON.stringify(input.sample.chart ?? 'Chart title')}: ${made.message}`];\napps/docs/lib/site.mjs:572:function renderDiagnosticPage(d, ctx) {\napps/docs/lib/site.mjs:579:    ? 'Checked with <code>validate()</code> from the packed package when this site was built; the message is its output.'\napps/docs/lib/site.mjs:580:    : 'This needs a page to arise. The documentation\\'s browser test runs this input and checks the code, the field, what the reader sees and that the message printed is the one shown here, which the build made from the registry with the details of this input.';\napps/docs/lib/site.mjs:612:function outcomeTable(code, input, name) {\napps/docs/lib/site.mjs:614:  const reader = o.reader === 'nothing' ? 'No note and no message: the chart as drawn.'\napps/docs/lib/site.mjs:615:    : o.reader === 'fallback' ? 'The title, a short summary and the table control, in place of the plot.'\napps/docs/lib/site.mjs:617:        : o.reader.startsWith('message: ') ? `“${escapeHtml(o.reader.slice(9))}” in place of the plot.`\napps/docs/lib/site.mjs:627:  return `<div class=\"table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"${escapeHtml(name)}\"><table><tbody>${rows.map(([k, v]) => `<tr><th scope=\"row\">${k}</th><td>${v}</td></tr>`).join('')}</tbody></table></div>`;\napps/docs/lib/site.mjs:630:function missingReader(code) {\napps/docs/lib/site.mjs:631:  throw new Error(`${code}: outcome.reader must be nothing, fallback, note: … or message: …`);\napps/docs/lib/site.mjs:634:function levelText(level) {\napps/docs/lib/site.mjs:642:function writeSourcePage(outDir, relative, ctx) {\napps/docs/lib/site.mjs:658:function layout({ title, body, current, base, ctx, sourceFile }) {\napps/docs/lib/site.mjs:685:<footer class=\"page-footer\"><p>Source of this page: <code>${escapeHtml(sourceFile)}</code>. Built from revision ${escapeHtml(at)}. The live examples run the packed packages (version ${escapeHtml(ctx.version)}, development condition), installed into a clean consumer.</p>${ctx.unchecked.length ? `<p><strong>Not for publishing:</strong> this site was built against a packed library that is not the build of its source (${escapeHtml(ctx.unchecked.join('; '))}).</p>` : ''}</footer>\napps/docs/lib/site.mjs:697: * of source pages included), assets and example pages. No page has two elements with the same id.\napps/docs/lib/site.mjs:699:export function checkSite(outDir) {\n// Builds the documentation site into apps/docs/dist. Needs the library built first (`npm run build`).\n// Usage: node apps/docs/build.mjs [--unchecked-library]\n//\n// --unchecked-library builds even when packages/axylo/dist is not the build of its current source, into\n// apps/docs/.cache/unchecked-site, with every page saying so. It is for checking pages while a rebuild of the\n// library is pending; it never replaces apps/docs/dist.\nimport { buildSite } from './lib/site.mjs';\n\nconst args = process.argv.slice(2);\nconst unknown = args.filter(a => a !== '--unchecked-library');\nif (unknown.length) throw new Error(`unknown argument ${unknown[0]} (usage: node apps/docs/build.mjs [--unchecked-library])`);\nconst started = Date.now();\nconst result = await buildSite({ log: message => console.warn(message), uncheckedLibrary: args.includes('--unchecked-library') });\nconst words = result.pages.reduce((sum, p) => sum + p.words, 0);\nconsole.log(`built ${result.pages.length} pages (${words} words), ${result.diagnostics} diagnostic pages and ${result.examples.length} examples in ${Date.now() - started} ms, into ${result.outDir}`);\nfor (const p of result.pages) console.log(`  ${p.page.padEnd(18)} ${String(p.words).padStart(5)} words`);\nif (result.unchecked.length) console.log(`NOT FOR PUBLISHING: built against a packed library that is not the build of its source (${result.unchecked.length} differences).`);\nimport { fileURLToPath } from 'node:url';\nimport { defineConfig } from 'vitest/config';\n\n// The documentation's tests alone, with the same split as the root vitest.config.ts (which includes them\n// too): unit tests in Node, and browser tests (*.browser.test.ts) against the packed library and the built\n// site when AXYLO_BROWSER is set.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    root: fileURLToPath(new URL('../..', import.meta.url)),\n    // The Node examples run against the packed package, from node.browser.test.ts, after the build.\n    include: process.env.AXYLO_BROWSER ? ['apps/docs/test/**/*.browser.test.ts'] : ['apps/docs/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 30000,\n    hookTimeout: 120000,\n    fileParallelism: false,\n  },\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '90,165p' apps/docs/pages/data.md && cat apps/docs/pages/diagnostics.md && rg -n 'validate\\\\(' apps/docs/pages\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '90,165p' apps/docs/pages/data.md && cat apps/docs/pages/diagnostics.md && rg -n 'validate\\\\(' apps/docs/pages\"","aggregated_output":"\n## Missing values\n\nAxylo never draws a missing value as zero unless you ask, and does not connect a line across a missing value it knows about. It knows about one when your data says so:\n\n| In your data | Drawn | Reported |\n|---|---|---|\n| `null`, or `''` | A gap | Nothing: this is how to say \"no data\" |\n| `NaN` in a `Float64Array` or `Float32Array` | A gap | Nothing |\n| The value field absent from a row (`undefined`) | A gap | Warning [AX102](diagnostics.md#ax102), and the reader's note |\n| The x or series field absent from a row | The row is not drawn | Warning [AX102](diagnostics.md#ax102), and the reader's note |\n| `NaN` or `Infinity` in rows | A gap | Warning [AX103](diagnostics.md#ax103), and the reader's note |\n| `0` | Zero | Nothing |\n\nA day with **no row at all** is different: the data says nothing about it. Axylo infers that a step is missing only from a series' own rows, when the x axis is dates, instants, wall-clock times or numbers and the series is regular: it has at least three rows, every interval between neighbouring rows is a whole multiple of the smallest one, and at least half of the intervals are the smallest one. A missing step it infers is drawn as a gap, as if the row held `null`, with hint [AX105](diagnostics.md#ax105). It infers nothing before the first row or after the last, in a series of one or two rows, in an irregular series, or when there would be more than twice as many missing steps as rows (and more than 1,000). Another series having a row at that x does not make the step missing in this one: a slot a series simply has no row for (a weekly series beside a daily one) is not a gap, its line is joined across it, and a bar chart draws no bar and no \"no data\" mark there. In a stack it is different, see below. So **when you know a day is missing, send it with `null`**: that is the instruction Axylo always follows.\n\nA value standing alone between two gaps is drawn as a point, so it does not vanish. On a bar chart a missing value gets a small \"no data\" mark (at the baseline, or for a stacked bar at the edge of its stack), distinct from a zero bar. Tooltip, table and announcements say \"No data\". When a warning means values were left out, the chart shows a short note to the reader (\"Values not shown: 3. See table.\") inside the figure, in every build.\n\n**In a stack** (stacked areas or bars), a series with no value at an x is a missing part, whatever the reason: a `null`, an inferred missing step, or no row there at all. The part has zero height, the series' line follows its band, and the total at that x is marked \"incomplete\" in the tooltip, the table and announcements, so a stack never shows a total made of values the data does not contain. A weekly series stacked with a daily one is incomplete on the days between its rows; see [the area chart's example](area.md#edge-case-a-missing-part-of-a-stack).\n\nFor counts, where a day without a row means nothing happened, declare it: `missing: 'zero'` turns null, absent and inferred-missing values of that field into zeros, and the note says the values are shown differently from the data.\n\n[example: missing](../examples/missing.ts)\n\nHere are the values an application sends by mistake, all at once. The note under the chart is what the reader sees; the console has one line per code.\n\n[example: line-dirty](../examples/line-dirty.ts)\n\n## Numbers sent as strings\n\nSome database drivers return counts and decimals as strings (Postgres `bigint` and `numeric`, BigQuery). Axylo looks at the whole field:\n\n- When every value is a plain decimal string (`'40'`, `'-1.5'`, and exponent notation such as `'1e3'`), the field is converted and drawn, and hint [AX104](diagnostics.md#ax104) asks you to say so with `parse: 'number'`. With that, there is no hint, and TypeScript accepts the string field on a value axis.\n- When the field also holds a number, or any string that is not a plain decimal (`'1,234'`, `'n/a'`), or another kind of value (`true`), every string in it is rejected, plain decimals included. They are not drawn, and they are warning [AX106](diagnostics.md#ax106).\n\nThe conversion is to JavaScript numbers. Integers are exact up to 9,007,199,254,740,991 (`Number.MAX_SAFE_INTEGER`); a larger one is rounded to the nearest number JavaScript can hold, without a diagnostic: `'9007199254740993'` reads 9,007,199,254,740,992. A string too large for a number (`'1e999'`) becomes infinite and is [AX103](diagnostics.md#ax103). When exact counts could exceed that limit, check them with `Number.isSafeInteger(Number(value))` before charting.\n\n[example: numeric-strings](../examples/numeric-strings.ts)\n\n## Order and duplicates\n\nRows can come in any order. Line, area and scatter charts are drawn in x order, and each value stays with its own row; categories keep the order in which they first appear.\n\n[example: unsorted](../examples/unsorted.ts)\n\nOn a line, area or bar chart one x has one value per series. Two rows with the same x in the same series are error [AX108](diagnostics.md#ax108): that series is not drawn, while the other series are; with no series left to draw, the chart shows its error state and keeps its table. Axylo does not know whether you meant the sum, the last or the average. Two donut slices with the same label are the same error, and the donut is not drawn. On a scatter chart repeated x values, and repeated points, are ordinary data.\n\n## Units, formats and percentages\n\n| Option on a value field | What it does |\n|---|---|\n| `label` | The axis title, and the series name in tooltip, table and announcements. Default: the field name. |\n| `unit` | Follows every value in tooltip, table and announcements, and is part of the axis title. |\n| `format` | How values are written in tooltip, table and announcements: `Intl.NumberFormat` options, or a function. Default: the locale's grouping, the full integer part and up to six significant fraction digits (`123,456.75`). |\n| `tickFormat` | How axis ticks are written. Default: the locale's grouping with the fraction digits the tick step needs (`50,000`); compact (`1.2M`) when the largest tick is at least a million; scientific from 10¹⁵. |\n| `scale: 'percent'` | The values are percentages from 0 to 100. |\n| `scale: 'ratio'` | The values are fractions from 0 to 1, shown as percentages. |\n\nA percent or ratio scale is declared, never guessed from a label. Its axis ends at full scale (100%) only when the largest value is at least half of full scale and not above it; otherwise it ends at the first tick at or above the data, so 4% is not drawn as a sliver of 100%. Numbers and dates are formatted for the `locale` option if given, else the document's language (`<html lang>`), else the browser's. A formatter that fails (a function that throws, or `Intl` options that `Intl` rejects) is warning [AX160](diagnostics.md#ax160), and the default format is used for that value.\n\n[example: units](../examples/units.ts)\n\nBar and area value axes always include zero, since a bar's length and an area's height are their values. A `domain` that leaves zero out is widened, with warning [AX110](diagnostics.md#ax110). Line and scatter axes fit the data.\n\nValue axes (y, and both axes of a scatter chart) end on a drawn tick at or beyond the data, the reference lines and bands, and stack totals; in a plot too narrow to label an end tick, the axis takes the next coarser step. A date, time or number x axis of a line, area or bar chart spans exactly its data instead (for bars, plus half a band at each end), so a time series is not padded to the next round tick.\n\n## What Axylo reads, keeps and copies\n\n- **Rows** are read when the chart is created or updated, and never changed. Their values are copied into Axylo's own typed arrays. Events hand back your own row object (`point.row`), and diagnostics name rows by their index in your data. A position no row of yours holds (an inferred missing day, a donut's \"Other\") has `row: null` and `index: -1`; check before you look a row up.\n- **Typed columns** of values (`Float64Array`, `Float32Array`) are read in place, without a copy, when Axylo can: the x values are already in order, no missing step is inferred, and no value has to change (no `Infinity`, no `missing: 'zero'` to apply). Otherwise Axylo copies what it needs; grouping long columns into series and scatter charts can need new storage too. Either way, do not change an array after passing it: to change the data, pass new arrays with `update({ data })`.\n- **Appended rows** are read once and added to the chart's own storage; `keep` limits how much is kept. See [Updating, streaming and zoom](updating.md#append-and-keep).\n\n## Checking data before you draw\n\n`validate(type, options)` runs the same reading and checking as a chart, without a page, and returns the diagnostics. Use it in Node, in a unit test, or in a coding agent's loop before rendering. See [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\n# Diagnostics\n\nAfter this page you can read an Axylo diagnostic, collect diagnostics in your own code, make a chart throw on them, and check a chart's data in Node or in a test before anything is drawn. Every code has its own page, listed at the end.\n\n## Reading one\n\nWhen Axylo cannot draw something as given, it prints one line to the console:\n\n[output: AX103](../data/diagnostics.mjs)\n\n| Part | Here |\n|---|---|\n| Code | `AX103`. Stable across releases; each has a page. |\n| Chart | `\"Conversion\"`: the chart's title, or its element id when it has none. |\n| What and where | The field, how many values, and the first rows (up to ten), numbered in your own data as you passed it. A diagnostic about the chart as a whole (no name, too many series, low contrast) has no field and no rows. |\n| Fix | What to change. |\n| Outcome | What the chart did instead: here, gaps. |\n\n## Levels and who is told\n\n| Level | Means | Console |\n|---|---|---|\n| Error | Something cannot be drawn as given: the chart, a series, or the donut. | Every build, once per code per page, with `console.warn` |\n| Warning | Something is not drawn as given, or an option is ignored. | Every build, once per code per page, with `console.warn` |\n| Hint | Advice for you. | Development builds only, with `console.info` |\n\nThe level says who is told; it does not by itself say what stays on screen. That depends on the code, and each code's page says it, with a checked minimal input. For example: an error about one series ([AX108](diagnostics.md#ax108)) leaves the other series drawn; a warning can put the chart in its error state when the ignored option was needed to draw at all (a `y` list on a scatter chart, [AX150](diagnostics.md#ax150)); and some hints come with a visible change: an inferred missing step is drawn as a gap ([AX105](diagnostics.md#ax105)), a plot too small to draw is replaced by its summary ([AX142](diagnostics.md#ax142)), hidden labels get a note ([AX143](diagnostics.md#ax143)).\n\nWhen values were left out or changed, the chart shows the reader a note in the figure (\"Values not shown: 3. See table.\", or \"Values shown differently from the data\"), in every build, and in the accessibility tree.\n\n## Collecting them in your code\n\nEach diagnostic is an object:\n\n```ts\ninterface Diagnostic {\n  code: `AX${number}`;           // 'AX103'\n  level: 'error' | 'warning' | 'hint';\n  message: string;               // what is wrong, where, and how to fix it\n  chart: string;                 // the chart's title, else its element id\n  field?: string;                // when it is about a field\n  rows?: readonly number[];      // first rows, in your data, at most 10\n  count?: number;                // how many values or rows in all\n}\n```\n\n`chart.diagnostics` lists them for the current options and data, up to date as soon as a create, `update` or `append` returns. `onDiagnostic` is called once for each diagnostic the chart newly finds, in every build and at every level, so it is the place to send them to your error tracking. A listener that throws is reported once and otherwise ignored; it cannot break the chart.\n\n[example: diagnostics-listener](../examples/diagnostics-listener.html)\n\n## When they are found\n\nMost diagnostics are found while a call checks its input: the create, `update` or `append` call. Those are in `chart.diagnostics` when the call returns. A few can only be found later, while drawing: low contrast after the page's CSS changes ([AX141](diagnostics.md#ax141)), a plot too small ([AX142](diagnostics.md#ax142)), labels that stop fitting after a resize ([AX143](diagnostics.md#ax143)), more bars than pixels ([AX132](diagnostics.md#ax132)), a formatter that fails ([AX160](diagnostics.md#ax160)), a `labelledBy` that names no element when there is no `title` ([AX140](diagnostics.md#ax140)), and an internal failure ([AX199](diagnostics.md#ax199)). They are reported when found, through the same console line and `onDiagnostic`. A `zoom()` call that cannot apply (a category axis, a donut, a compact chart) is reported when it is made, through the console line and `onDiagnostic` only: it changes nothing, so `chart.diagnostics` does not list it ([AX150](diagnostics.md#ax150)).\n\n## Strict mode\n\n`strict: true` makes the chart throw on any error or warning found while checking a create, `update` or `append` call, synchronously from that call. The chart keeps its last valid state; a rejected create leaves nothing in the page. The error is named `AxyloStrictError`, and its `diagnostics` property has every diagnostic of the rejected call. Hints never throw, and neither do diagnostics found later while drawing. A failure while a call is being checked (such as a row getter that throws, [AX199](diagnostics.md#ax199)) rejects that call too, with AX199 after what it had found; a failure later, while drawing, is never thrown. Each code's page says whether a strict chart throws it. See the example in [Updating](updating.md#strict-mode).\n\n## validate() in Node and in tests\n\n`validate(type, options)` runs the same reading and checking as creating a chart (options, data, view, name) without a DOM, and returns the diagnostics a created chart would report from its call. It takes the same options as the chart type, so it type-checks the same way. Importing `axylo` in Node does not touch the DOM.\n\nUse it on a server, in a build step, or in a coding agent's loop:\n\n[source: examples/node/validate.ts](../examples/node/validate.ts)\n\nOr in a unit test, so that a change in the data a query returns fails the build instead of a dashboard:\n\n[source: examples/node/chart-data.test.ts](../examples/node/chart-data.test.ts)\n\nBoth files are type-checked and run by this documentation's own tests, against the packed package. The package's declarations refer to DOM types, so a TypeScript configuration for Node code needs `\"lib\": [\"ES2022\", \"DOM\"]` (or `skipLibCheck`). `validate()` cannot find what only a page can show: the diagnostics listed under \"When they are found\" need a browser. It can tell that a chart has neither `title` nor `labelledBy`, but not whether a `labelledBy` id exists.\n\n## Every code\n\n[table: diagnostic codes](../data/diagnostics.mjs)\napps/docs/pages/stability.md:34:| Node | Importing `axylo` touches no DOM, and `validate()` runs there. Charts themselves need a browser. |\napps/docs/pages/options.md:230:`validate(type, options)` takes `'line'`, `'area'`, `'bar'`, `'scatter'` or `'donut'` and that type's options, runs the checks a created chart runs from its call without a DOM, and returns `Diagnostic[]`. It cannot find what needs a page: contrast, sizes, label fitting, formatters, or whether a `labelledBy` id exists. See [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\napps/docs/pages/getting-started.md:17:TypeScript 5.4 or later gives you checked field names. The package's declarations refer to DOM types (`HTMLElement`), so a TypeScript project needs the `DOM` library in `lib`, also for code that only calls `validate()` in Node. Plain JavaScript works the same without types.\napps/docs/pages/getting-started.md:77:**3. Check the values without drawing.** `validate()` runs the same checks as creating the chart, in Node or in a test, with the same options as the chart:\napps/docs/pages/getting-started.md:82:const problems = validate('line', { title: 'Monthly visitors', data: rows, x: 'month', y: 'visitors' });\napps/docs/pages/data.md:164:`validate(type, options)` runs the same reading and checking as a chart, without a page, and returns the diagnostics. Use it in Node, in a unit test, or in a coding agent's loop before rendering. See [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\napps/docs/pages/diagnostics.md:59:## validate() in Node and in tests\napps/docs/pages/diagnostics.md:61:`validate(type, options)` runs the same reading and checking as creating a chart (options, data, view, name) without a DOM, and returns the diagnostics a created chart would report from its call. It takes the same options as the chart type, so it type-checks the same way. Importing `axylo` in Node does not touch the DOM.\napps/docs/pages/diagnostics.md:71:Both files are type-checked and run by this documentation's own tests, against the packed package. The package's declarations refer to DOM types, so a TypeScript configuration for Node code needs `\"lib\": [\"ES2022\", \"DOM\"]` (or `skipLibCheck`). `validate()` cannot find what only a page can show: the diagnostics listed under \"When they are found\" need a browser. It can tell that a chart has neither `title` nor `labelledBy`, but not whether a `labelledBy` id exists.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,100p;121,165p' apps/docs/pages/options.md && cat rehearsal/files.mjs && sed -n '45,75p' rehearsal/protocol.mjs && sed -n '204,265p' rehearsal/grade.mjs && sed -n '1,30p' rehearsal/test/fixtures.test.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,100p;121,165p' apps/docs/pages/options.md && cat rehearsal/files.mjs && sed -n '45,75p' rehearsal/protocol.mjs && sed -n '204,265p' rehearsal/grade.mjs && sed -n '1,30p' rehearsal/test/fixtures.test.mjs\"","aggregated_output":"# Options reference\n\nAfter this page you can look up any option of any chart type, any field option, and every member of the chart handle, with its type, its default and what it does. The groups follow the declarations in `packages/axylo/src/public.ts`, which are the source of truth. Tests check that every key of those declarations is here with the type written here, and that each default written in `code` is what the chart does when the option is left out.\n\nTypes are written in TypeScript. `Row` is the type of one of your rows (for typed columns it is inferred from the columns), `Options` the options type of the chart, and `XValue` is `number | string | Date`, a value on an x axis.\n\n## Which options apply where\n\n| Group | line | area | bar | scatter | donut |\n|---|---|---|---|---|---|\n| [Common options](#common-options) | yes | yes | yes | yes | yes |\n| [Encoding](#encoding-line-area-bar) (`x`, `y`, `series`) | yes | yes | yes | – | – |\n| [Cartesian options](#cartesian-options) (`zoom`, `reference`) | yes | yes | yes | yes | – |\n| [`compact`](#compact) | yes | yes | yes | – | – |\n| [`stacked`](#area-options) | – | yes | – | – | – |\n| [`layout`, `horizontal`](#bar-options) | – | – | yes | – | – |\n| [Scatter encoding](#scatter-options) | – | – | – | yes | – |\n| [Donut encoding](#donut-options) (`label`, `value`) | – | – | – | – | yes |\n\nAn option that does not apply to a chart type does not compile, and at run time is ignored with [AX150](diagnostics.md#ax150).\n\n## Common options\n\nOn every chart type.\n\n<!-- options: CommonOptions -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `data` | `Data<Row>` | required | The rows (`readonly Row[]`), or `{ columns }` with one array or typed array per field, all of equal length. See [Your data](data.md). |\n| `title` | `string \\| Title` | none | Visible heading and accessible name. Without it (and without `labelledBy`) the name is generated, with AX140. In a compact chart it is the accessible name only. |\n| `labelledBy` | `string` | none | Id of an existing heading that names the chart, for cards that already show a title. |\n| `subtitle` | `string` | none | A line under the title. |\n| `description` | `string` | none | Added to the generated summary. The time zone and any omitted values are always stated. |\n| `state` | `'ready' \\| 'loading' \\| { error: string } \\| { empty: string }` | `'ready'` | Shows a loading, error or empty message inside the plot instead of the data. |\n| `legend` | `'auto' \\| false \\| 'top' \\| 'right' \\| 'bottom'` | `'auto'` | Where the legend goes, or `false` for none. `'auto'` places it under the plot. A chart with one series has no legend entries. |\n| `tooltip` | `boolean` | `true` | The pointer readout: the tooltip, or in a small plot the strip under it. With `false` nothing is pinned, and a click still selects. Keyboard reading is not affected. |\n| `table` | `boolean` | `true` | The \"View as table\" control. |\n| `colors` | `Readonly<Record<string, string>>` | none | A CSS colour per series key: the `series` value for long rows, the field name for wide rows, the slice label on a donut. |\n| `messages` | `Partial<Messages>` | built-in English | Replacements for text the reader sees. See [Messages](#messages). |\n| `locale` | `string` | the document's language | Locale for numbers and dates: this option, else `<html lang>`, else the browser's. |\n| `strict` | `boolean` | `false` | Throw on any error or warning found while checking a create, `update` or `append` call, from that call. |\n| `onDiagnostic` | `(diagnostic: Diagnostic) => void` | none | Called once for each diagnostic the chart newly finds, in every build. |\n\n### Title\n\nWhen `title` is an object:\n\n<!-- options: Title -->\n| Key | Type | Default | Meaning |\n|---|---|---|---|\n| `text` | `string` | required | The title. |\n| `visible` | `boolean` | `true` | `false` keeps it as the accessible name but hides it visually. |\n| `level` | `2 \\| 3 \\| 4 \\| 5 \\| 6` | `3` | The heading level, to fit the page's outline. |\n\n## Encoding (line, area, bar)\n\nLong rows name one `y` and a `series`; wide rows give `y` as a list and no `series`. The two forms are exclusive. One series needs only a single `y`.\n\n<!-- options: Encoding -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `x` | `XField<Row>` | required | The x field: a key, or an [x field object](#x-fields). |\n| `y` | `ValueField<Row> \\| readonly ValueField<Row>[]` | required | The value field, or one field per series. See [Value fields](#value-fields). The first field sets the shared value axis's domain and scale. |\n| `series` | `SeriesKey<Row>` | none | The field whose value names and keys each row's series (long rows only). |\n\n## Cartesian options\n\nOn line, area, bar and scatter charts.\n\n<!-- options: CartesianOptions -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `zoom` | `boolean \\| 'touch'` | `true` | Zoom and pan, on date, time and number x axes only: a category axis and a compact chart never zoom. `'touch'` also takes pinch and two-finger drag on touch screens. |\n| `reference` | `readonly Reference[]` | none | Reference lines and bands. See [Reference](#reference). Not on compact charts. |\n\n### Reference\n\n<!-- options: Reference -->\n| Key | Type | Default | Meaning |\n|---|---|---|---|\n| `x` | `XValue \\| readonly [XValue, XValue]` | none | A line at an x value, or a band between two. |\n| `y` | `number \\| readonly [number, number]` | none | A line at a value, or a band between two. On a horizontal bar chart it runs up and down the plot. |\n| `label` | `string` | required | Shown beside the line or band, and listed in the summary and the table caption. |\n\nA reference widens the automatic value domain to include it. An author `domain` that leaves it out keeps it out of the drawing; the summary still lists it.\n\n## Compact\n\n<!-- options: CompactOption -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `compact` | `boolean` | `false` | Line, area and bar only. Marks only, as an image with a text alternative. See [Compact](compact.md). |\n\n## Area options\n\n<!-- options: AreaOptions -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `stacked` | `boolean` | `false` | Stack the series; the tooltip adds the total, or both totals when signs are mixed. |\n\n\n<!-- options: DonutOptions -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `label` | `SeriesKey<Row>` | required | The field that names, and keys, each slice. |\n| `value` | `ValueField<Row>` | required | The value of each slice. Not negative. |\n\n## Value fields\n\nA value field is a key of `Row` whose values are numbers (or `null`), or an object. A key whose values are strings is accepted only in the object form with `parse: 'number'`.\n\n<!-- options: ValueField -->\n| Key | Type | Default | Meaning |\n|---|---|---|---|\n| `field` | `NumberKey<Row> \\| StringKey<Row>` | required | The key of the row: a number field, or a string field with `parse`. |\n| `parse` | `'number'` | none | The field holds numbers as strings; convert them to JavaScript numbers (exact for integers up to 9,007,199,254,740,991). |\n| `label` | `string` | the field name | Axis title, and the series name in tooltip, table and announcements. |\n| `unit` | `string` | none | Follows values in tooltip, table and announcements: `'ms'`, `'USD'`. |\n| `scale` | `'percent' \\| 'ratio'` | none | Percentage data: `'percent'` is 0–100, `'ratio'` is 0–1. Never inferred. |\n| `format` | `Intl.NumberFormatOptions \\| ((value: number) => string)` | the locale's grouping, the full integer part and up to six significant fraction digits | How values are written in tooltip, table and announcements. |\n| `tickFormat` | `Intl.NumberFormatOptions \\| ((value: number) => string)` | the locale's grouping, with the step's fraction digits; compact from a largest tick of one million, scientific from 10¹⁵ | How axis ticks are written. |\n| `missing` | `'gap' \\| 'zero'` | `'gap'` | What a missing value means. `'zero'` is for counts where absence means none. |\n| `domain` | `readonly [number, number]` | from the data | Author bounds. On bar and area, widened to include zero (AX110). In a wide chart only the first field's applies. |\n\n## X fields\n\nAn x field is a key of `Row` whose values are numbers, strings or `Date`s, or an object.\n\n<!-- options: XField -->\n| Key | Type | Default | Meaning |\n|---|---|---|---|\n| `field` | `XKey<Row>` | required | The key of the row. |\n| `type` | `'number' \\| 'time' \\| 'date' \\| 'category'` | inferred | `'date'`: calendar dates; `'time'`: instants; numbers are never inferred to be instants. See [how Axylo decides](data.md#how-axylo-decides). |\n| `ordered` | `boolean` | `false` | Category axes: the categories have a natural order, so labels may be thinned when they do not fit. |\n| `timeZone` | `'local' \\| 'UTC' \\| (string & {})` | `'local'` | For instants: the zone they are shown in. `'local'` is the viewer's; otherwise `'UTC'` or an IANA zone name. |\n| `label` | `string` | the field name | Axis title of a number axis; a date, time or category axis is titled only when you give one. |\n| `unit` | `string` | none | Follows x values in tooltip, table and announcements. |\n| `format` | `Intl.DateTimeFormatOptions \\| Intl.NumberFormatOptions \\| ((value: XValue) => string)` | from the kind of x | How x values are written in tooltip, table and announcements. |\n| `tickFormat` | `Intl.DateTimeFormatOptions \\| Intl.NumberFormatOptions \\| ((value: XValue) => string)` | from the kind of x | How x ticks are written. |\n| `domain` | `readonly [XValue, XValue]` | from the data | Author bounds for x. |\n\nFor scatter charts the x field takes the same keys except `ordered`, and `type` without `'category'`:\n\n<!-- options: ScatterXField -->\n| Key | Type | Default | Meaning |\nimport { readFile, rename, rm, writeFile } from 'node:fs/promises';\nimport { randomUUID } from 'node:crypto';\nimport { isAbsolute, join, relative, sep } from 'node:path';\nimport { fileURLToPath, pathToFileURL } from 'node:url';\n\nexport const rehearsal = fileURLToPath(new URL('.', import.meta.url));\nexport const repository = fileURLToPath(new URL('..', import.meta.url));\nexport const tasks = ['daily-visits', 'regional-sales', 'signups', 'daily-revenue'];\n\nexport function inside(root, file) {\n  const path = relative(root, file);\n  return path !== '..' && !path.startsWith('..' + sep) && !isAbsolute(path);\n}\n\nexport function taskFiles(task) {\n  if (!task || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(task)) throw new Error('Supply a task ID from rehearsal/prompts.');\n  return {\n    prompt: join(rehearsal, 'prompts', task + '.md'),\n    fixture: join(rehearsal, 'fixtures', task + '.json'),\n    expected: join(rehearsal, 'fixtures', task + '.expected.json'),\n    alternate: join(rehearsal, 'fixtures', task + '.alternate.json'),\n    alternateExpected: join(rehearsal, 'fixtures', task + '.alternate.expected.json'),\n  };\n}\n\nexport async function readJson(file) {\n  return JSON.parse(await readFile(file, 'utf8'));\n}\n\nexport async function writeJson(file, value) {\n  const temporary = file + '.' + randomUUID() + '.tmp';\n  try {\n    await writeFile(temporary, JSON.stringify(value, null, 2) + '\\n', { flag: 'wx' });\n    await rename(temporary, file);\n  } finally {\n    await rm(temporary, { force: true });\n  }\n}\n\nexport function isMain(url) {\n  return !!process.argv[1] && pathToFileURL(process.argv[1]).href === url;\n}\nexport async function inputChanges(workspace, original) {\n  try {\n    const current = await stagedHashes(workspace);\n    return Object.keys(current).filter(key => current[key] !== original[key]).join(', ');\n  } catch (error) {\n    return error.message;\n  }\n}\n\nexport async function inputHashes(workspace, task) {\n  const { alternate, expected, alternateExpected } = taskFiles(task);\n  const sources = {\n    package: fileHash(packedPackage),\n    alternate: fileHash(alternate),\n    expected: fileHash(expected),\n    alternateExpected: fileHash(alternateExpected),\n    grader: Promise.all([\n      ...['grade.mjs', 'reader.mjs', 'table.mjs', 'files.mjs'].map(file => fileHash(join(rehearsal, file))),\n      fileHash(join(repository, 'packages/axylo/src/diagnostics/registry.ts')),\n    ]).then(hashes => digest(JSON.stringify(hashes))),\n  };\n  const [staged, entries] = await Promise.all([\n    stagedHashes(workspace),\n    Promise.all(Object.entries(sources).map(async ([key, hash]) => [key, await hash])),\n  ]);\n  return { ...staged, ...Object.fromEntries(entries) };\n}\n\nexport async function readRecords(root) {\n  const entries = await readdir(root, { withFileTypes: true }).catch(error => {\n    if (error.code === 'ENOENT') return [];\n\n  return {\n    input,\n    timezoneId,\n    criteria: criteriaNames.map(name => criteria.find(item => item.name === name) ??\n      criterion(name, false, 'Unavailable after render failure.')),\n    diagnostics: [...diagnostics.values()],\n    ...(table ? { table } : {}),\n  };\n}\n\nexport async function grade(workspace, task, { launch = () => chromium.launch({ channel: 'chrome', headless: true, timeout: 15000 }) } = {}) {\n  workspace = await realpath(workspace);\n  const taskPaths = taskFiles(task);\n  const inputs = await Promise.all([\n    ['primary', taskPaths.fixture, taskPaths.expected],\n    ['alternate', taskPaths.alternate, taskPaths.alternateExpected],\n  ].map(async ([name, fixture, expected]) => ({ name, data: await readJson(fixture), expected: await readJson(expected) })));\n  const save = async result => {\n    await writeJson(join(workspace, 'grade.json'), result);\n    return result;\n  };\n  const fail = (name, detail) => save({ pass: false, criteria: [criterion(name, false, detail)], diagnostics: [], timezones: [] });\n\n  let bundles;\n  try {\n    if (!(await lstat(join(workspace, 'chart.js'))).isFile()) {\n      return fail('render', 'chart.js must be a regular file.');\n    }\n    // Grade the original fixture even if the agent changed its local copy while experimenting.\n    bundles = await Promise.all(inputs.map(async input => ({ ...input, files: await bundle(workspace, input.data) })));\n  } catch (error) {\n    return fail('render', error.code === 'ENOENT' ? 'chart.js is missing.' : String(error));\n  }\n\n  const levels = await registryLevels();\n  let browser;\n  try {\n    browser = await launch();\n  } catch (error) {\n    return fail('browser', String(error));\n  }\n  try {\n    const timezones = [];\n    for (const { name, files, expected } of bundles) {\n      for (const timezoneId of zones) timezones.push(await inspect(browser, files, expected, levels, timezoneId, name));\n    }\n    const criteria = criteriaNames.map(name => {\n      const results = timezones.map(zone => zone.criteria.find(item => item.name === name));\n      return criterion(name, results.every(item => item.pass),\n        results.map((item, index) => `${timezones[index].input} / ${timezones[index].timezoneId}: ${item.detail}`).join(' | '));\n    });\n    return await save({\n      pass: criteria.every(item => item.pass),\n      browserVersion: browser.version(),\n      criteria,\n      diagnostics: timezones.flatMap(zone => zone.diagnostics),\n      timezones,\n    });\n  } catch (error) {\n    if (!browser.isConnected()) return fail('browser', String(error));\n    throw error;\nimport { describe, expect, it } from 'vitest';\nimport fc from 'fast-check';\nimport { readJson, taskFiles } from '../files.mjs';\nimport { calendarDate, compareHeaders, compareRows } from '../table.mjs';\n\nconst specs = [\n  ['daily-visits', [2026, 3, 1, 30], ['visits'], [6, 12, 26]],\n  ['signups', [2026, 4, 6, 7], ['signpus'], []],\n  ['daily-revenue', [2026, 5, 1, 8], ['revenue'], [4]],\n  ['regional-sales', null, ['north', 'central', 'west'], []],\n];\n\nfunction quarterOrdinal(label) {\n  const [, year, quarter] = /^(\\d{4}) Q([1-4])$/.exec(label);\n  return Number(year) * 4 + Number(quarter);\n}\n\ndescribe('fixture expectations', () => {\n  it.each(specs)('%s follows the calendar or quarters and preserves the source values in both inputs', async (task, period, keys, missing) => {\n    const files = taskFiles(task);\n    const [primary, expected, alternate, alternateExpected] = await Promise.all(\n      [files.fixture, files.expected, files.alternate, files.alternateExpected].map(readJson));\n    expect(alternateExpected.series).toEqual(expected.series);\n    expect(alternateExpected.rows.map(row => row[0])).toEqual(expected.rows.map(row => row[0]));\n    for (const [i, [day, ...values]] of expected.rows.entries()) {\n      expect(alternateExpected.rows[i][0]).toBe(day);\n      for (const [j, value] of values.entries()) {\n        if (value !== null) expect(alternateExpected.rows[i][j + 1]).not.toBe(value);\n      }\n    }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,145p' apps/docs/lib/consumer.mjs && sed -n '1,125p' apps/docs/lib/examples.mjs && sed -n '1,130p' apps/docs/test/markdown.test.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,145p' apps/docs/lib/consumer.mjs && sed -n '1,125p' apps/docs/lib/examples.mjs && sed -n '1,130p' apps/docs/test/markdown.test.ts\"","aggregated_output":"/**\n * A clean consumer of the packed packages, for the documentation's examples (spec DX10), set up the way\n * tests/dist does it (tests/dist/README.md, scripts/pack.mjs): `npm pack` each package as npm would publish\n * it, then `npm install --offline` the tarballs through `file:` specifiers into a project of its own, so\n * nothing is linked to the workspace. The consumer lives under apps/docs/.cache (git-ignored):\n *\n *   .cache/packed/<name>-<version>.tgz     the tarballs\n *   .cache/consumer/package.json           axylo\n *   .cache/consumer/node_modules           npm's install of those, offline\n *   .cache/consumer/src/…                  copies of the examples, so they resolve from the consumer\n *\n * The consumer sits under the repository, whose root node_modules links the workspace packages; anything it\n * did not install could be found there by walking up. `guard()` (esbuild) and `listFilesOutside()`\n * (TypeScript) turn such a fallback into an error.\n */\nimport { execFileSync } from 'node:child_process';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { cacheDir, repoRoot } from './examples.mjs';\n\nexport const PACKAGES = { axylo: 'packages/axylo' };\nexport const packedDir = path.join(cacheDir, 'packed');\nexport const consumerDir = path.join(cacheDir, 'consumer');\nconst windows = process.platform === 'win32';\n\n// npm started through npm run or Vitest passes its own settings down as npm_config_* variables; the consumer\n// installs with defaults, as tests/dist does.\nconst env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !/^npm_/i.test(k)));\nconst npm = (args, options) =>\n  execFileSync(windows ? 'npm.cmd' : 'npm', args, { encoding: 'utf8', shell: windows, env, stdio: 'pipe', ...options });\n\nexport const inside = (parent, child) => {\n  const relative = path.relative(parent, child);\n  return relative !== '' && !relative.startsWith('..') && !path.isAbsolute(relative);\n};\n\nfunction walk(dir, base = dir) {\n  return fs.readdirSync(dir, { withFileTypes: true }).flatMap(e =>\n    e.isDirectory() ? walk(path.join(dir, e.name), base) : [path.relative(base, path.join(dir, e.name)).split(path.sep).join('/')]);\n}\n\n/**\n * Packs both packages from their current dist and installs them into the consumer. The install is skipped\n * when the consumer already holds exactly these tarballs (same integrity). Returns what npm pack reported.\n */\nexport function prepareConsumer({ log = () => {} } = {}) {\n  fs.rmSync(packedDir, { recursive: true, force: true });\n  fs.mkdirSync(packedDir, { recursive: true });\n  const packed = {};\n  for (const [name, dir] of Object.entries(PACKAGES)) {\n    const [report] = JSON.parse(npm(['pack', '--json', '--ignore-scripts', '--pack-destination', packedDir], { cwd: path.join(repoRoot, dir) }));\n    packed[name] = { tarball: report.filename, integrity: report.integrity, version: report.version, files: report.files.map(f => f.path).sort() };\n  }\n  fs.mkdirSync(consumerDir, { recursive: true });\n  const manifest = {\n    name: 'axylo-docs-consumer',\n    private: true,\n    type: 'module',\n    description: 'Installs the packed tarballs for the documentation examples (apps/docs/lib/consumer.mjs). Generated.',\n    dependencies: { axylo: `file:../packed/${packed.axylo.tarball}` },\n  };\n  fs.writeFileSync(path.join(consumerDir, 'package.json'), JSON.stringify(manifest, null, 2) + '\\n');\n  const record = path.join(consumerDir, '.installed.json');\n  const wanted = JSON.stringify(Object.fromEntries(Object.entries(packed).map(([n, p]) => [n, p.integrity])));\n  const current = fs.existsSync(record) ? fs.readFileSync(record, 'utf8') : '';\n  if (current !== wanted || !fs.existsSync(path.join(consumerDir, 'node_modules/axylo'))) {\n    fs.rmSync(path.join(consumerDir, 'node_modules'), { recursive: true, force: true });\n    const install = mode => npm(['install', mode, '--ignore-scripts', '--no-audit', '--no-fund', '--no-package-lock', '--loglevel=error'], { cwd: consumerDir });\n    // Only the local tarball is installed, so nothing comes from a registry or the npm cache.\n    install('--offline');\n    fs.writeFileSync(record, wanted);\n    log(`docs consumer: installed ${Object.values(packed).map(p => p.tarball).join(', ')}`);\n  }\n  for (const [name, p] of Object.entries(packed)) {\n    const at = path.join(consumerDir, 'node_modules', name);\n    if (fs.lstatSync(at).isSymbolicLink()) throw new Error(`docs consumer: npm linked ${name} instead of installing the tarball`);\n    if (walk(at).sort().join('\\n') !== p.files.join('\\n')) throw new Error(`docs consumer: installed ${name} differs from npm pack's file list`);\n  }\n  return packed;\n}\n\n/** The installed package's directory in the consumer. */\nexport const installed = name => path.join(consumerDir, 'node_modules', name);\n\n/** An esbuild plugin that fails the build when an import resolves outside the consumer. */\nexport function guard(roots = [consumerDir]) {\n  return {\n    name: 'docs-consumer-guard',\n    setup(build) {\n      build.onResolve({ filter: /.*/ }, async args => {\n        if (args.pluginData?.guarded || args.kind === 'entry-point') return undefined;\n        const result = await build.resolve(args.path, {\n          kind: args.kind, importer: args.importer, resolveDir: args.resolveDir, namespace: args.namespace, pluginData: { guarded: true },\n        });\n        if (result.errors.length > 0 || result.external || result.namespace !== 'file') return result;\n        if (!roots.some(r => inside(r, result.path))) {\n          return { errors: [{ text: `[docs consumer guard] ${JSON.stringify(args.path)} from ${args.importer} resolved outside the consumer, to ${result.path}` }] };\n        }\n        return result;\n      });\n    },\n  };\n}\n\n/**\n * Files TypeScript read (`--listFiles` output) that are neither in the consumer nor the compiler's own\n * libraries: a declaration found by walking up into the workspace.\n */\nexport function listFilesOutside(listing, allowed = []) {\n  const typescript = path.dirname(fs.realpathSync(path.join(repoRoot, 'node_modules/typescript/package.json')));\n  return listing.split(/\\r?\\n/).map(l => l.trim()).filter(Boolean).filter(file => {\n    const at = path.resolve(file);\n    if (inside(consumerDir, at) || inside(typescript, at) || /[\\\\/]@typescript[\\\\/]/.test(at) || /[\\\\/]lib\\.[\\w.]*\\.d\\.ts$/.test(at)) return false;\n    return !allowed.some(dir => inside(path.join(repoRoot, 'node_modules', dir), at));\n  });\n}\n\nconst STRICT = {\n  target: 'ES2022', module: 'ESNext', moduleResolution: 'Bundler', strict: true, noUncheckedIndexedAccess: true,\n  noImplicitOverride: true, noFallthroughCasesInSwitch: true, isolatedModules: true, noEmit: true, skipLibCheck: false,\n  types: [],\n};\n\n/**\n * The consumer's TypeScript configurations: one for the browser examples (the .ts files, and the\n * scripts of the .html examples as JavaScript under checkJs, all strict), one for the Node examples. Library\n * checking is on, so the packed declarations are checked as a consumer's compiler reads them.\n */\nexport function writeConsumerTsconfigs() {\n  const browser = {\n    compilerOptions: { ...STRICT, lib: ['ES2022', 'DOM', 'DOM.Iterable'], allowJs: true, checkJs: true },\n    include: ['src/*.ts', 'src/*.js'],\n  };\n  const node = { compilerOptions: { ...STRICT, lib: ['ES2022', 'DOM'] }, include: ['src/node/*.ts'] };\n  fs.writeFileSync(path.join(consumerDir, 'tsconfig.json'), JSON.stringify(browser, null, 2));\n  fs.writeFileSync(path.join(consumerDir, 'tsconfig.node.json'), JSON.stringify(node, null, 2));\n  return { browser: path.join(consumerDir, 'tsconfig.json'), node: path.join(consumerDir, 'tsconfig.node.json') };\n}\n/**\n * Runnable examples: files in apps/docs/examples, each one a complete program a reader can copy.\n *\n * - `name.ts`: a module that imports from 'axylo' and draws into elements it names by id, as in\n *   `line('#chart', …)`. Its host is a page with one empty <div> per id, and a bundler (or an import map)\n *   that resolves `axylo`.\n * - `name.html`: the body of a page: markup and scripts. A module script imports `axylo` by name, so its\n *   page needs a bundler or an import map; a classic script uses the `Axylo` global of the script-tag file.\n * - `_name.ts`: a helper module shared by examples (the Phase 1 fixtures), not an example.\n *\n * What an example promises is written in its own comments, in words the reader sees too:\n * - \"Raises AX111 on purpose\" (or \"Raises AX102, AX103 and AX106 on purpose\") lists the diagnostics it\n *   demonstrates; the browser test fails on any other code, and on a listed code that does not appear.\n * - \"Draws no marks on purpose\" marks an example whose charts show a state (loading, empty, error) instead.\n */\nimport fs from 'node:fs';\nimport path from 'node:path';\n\nexport const docsRoot = path.resolve(import.meta.dirname, '..');\nexport const repoRoot = path.resolve(docsRoot, '../..');\nexport const examplesDir = path.join(docsRoot, 'examples');\n/** Generated inputs that are not the site: the packed consumer and compiler probes. Git-ignored. */\nexport const cacheDir = path.join(docsRoot, '.cache');\n\nconst CHART_CALL = /\\b(?:line|area|bar|scatter|donut)\\(\\s*(['\"])#([\\w-]+)\\1|getElementById\\(\\s*(['\"])([\\w-]+)\\3\\s*\\)/g;\nconst RAISES = /Raises ((?:AX\\d{3})(?:(?:, | and )AX\\d{3})*) on purpose/;\nconst NO_MARKS = /Draws no marks on purpose/;\nexport const MODULE_SCRIPT = /<script type=\"module\">([\\s\\S]*?)<\\/script>/g;\nexport const CLASSIC_SCRIPT = /<script>([\\s\\S]*?)<\\/script>/g;\nconst HELPER_IMPORT = /from '\\.\\/(_[\\w-]+)'/g;\n\n/**\n * The first-chart snippets of the repository (examples/first-chart, maintained with the distribution tests)\n * also run on the site, under these names, so the Getting started page shows them live beside their source.\n */\nexport const EXTERNAL = [\n  { name: 'first-chart-npm', path: 'examples/first-chart/npm.ts' },\n  { name: 'first-chart-script', path: 'examples/first-chart/script.html' },\n];\n\nexport function listExamples() {\n  const own = fs.readdirSync(examplesDir)\n    .filter(file => /\\.(ts|html)$/.test(file) && !file.endsWith('.d.ts') && !file.startsWith('_'))\n    .sort()\n    .map(file => readExample(file));\n  const external = EXTERNAL.filter(e => fs.existsSync(path.join(repoRoot, e.path)))\n    .map(e => readExample(path.basename(e.path), path.join(repoRoot, path.dirname(e.path)), e.name));\n  return [...external, ...own];\n}\n\n/** Helper modules (`_name.ts`) the examples import. */\nexport function listHelpers() {\n  return fs.readdirSync(examplesDir).filter(file => /^_[\\w-]+\\.ts$/.test(file)).sort();\n}\n\nexport function readExample(file, dir = examplesDir, as = null) {\n  const ext = path.extname(file).slice(1);\n  const name = as ?? path.basename(file, path.extname(file));\n  const source = fs.readFileSync(path.join(dir, file), 'utf8');\n  const repoFile = path.relative(repoRoot, path.join(dir, file)).split(path.sep).join('/');\n  // The script-tag snippet is a whole document that loads the package from a CDN.\n  const documentPage = ext === 'html' && /^<!doctype html>/i.test(source.trimStart());\n  const raises = RAISES.exec(source)?.[1].split(/, | and /) ?? [];\n  const targets = ext === 'ts' ? [...new Set([...source.matchAll(CHART_CALL)].map(m => m[2] ?? m[4]))] : [];\n  if (ext === 'ts' && targets.length === 0) throw new Error(`${file}: no chart call with a '#id' target, and no getElementById('id')`);\n  const helpers = [...new Set([...source.matchAll(HELPER_IMPORT)].map(m => `${m[1]}.ts`))];\n  for (const helper of helpers) if (!fs.existsSync(path.join(examplesDir, helper))) throw new Error(`${file}: imports ${helper}, which does not exist`);\n  const scriptTag = ext === 'html' && /<script src=\"[^\"]*axylo\\.iife(?:\\.min)?\\.js\"><\\/script>/.test(source);\n  return { file, name, ext, source, repoFile, raises, noMarks: NO_MARKS.test(source), targets, helpers, scriptTag, documentPage };\n}\n\n/** The scripts of an .html example, in order, with the line each starts on. */\nexport function htmlScripts(example) {\n  const out = [];\n  let n = 0;\n  for (const m of example.source.matchAll(MODULE_SCRIPT)) {\n    out.push({ kind: 'module', file: `${example.name}.${++n}.js`, line: lineOf(example.source, m.index), code: m[1], match: m[0] });\n  }\n  for (const m of example.source.matchAll(CLASSIC_SCRIPT)) {\n    out.push({ kind: 'classic', file: `${example.name}.${++n}.classic.js`, line: lineOf(example.source, m.index), code: m[1], match: m[0] });\n  }\n  return out;\n}\n\nfunction lineOf(text, index) {\n  return text.slice(0, index).split('\\n').length;\n}\n\n/** What a reader must supply around an example to run it on their own page. */\nexport function hostOf(example) {\n  if (example.documentPage) {\n    return { markup: null, text: 'A whole page. Its two URLs point at jsDelivr, which serves published npm packages. Axylo is not published yet, so this site serves the page with those two files taken from the packed package, and adds its own stylesheet (for the font and colours of the frame) and the script that sizes the frame.' };\n  }\n  if (example.ext === 'ts') {\n    return {\n      markup: example.targets.map(id => `<div id=\"${id}\"></div>`).join('\\n'),\n      text: `The page needs ${example.targets.length === 1 ? 'an element' : 'elements'} with ${example.targets.map(id => `id \"${id}\"`).join(', ')}, and a bundler (or an import map) that resolves the \\`axylo\\` package.`,\n    };\n  }\n  if (example.scriptTag) {\n    return { markup: null, text: 'This is the body of a page. It loads `axylo.iife.js` from the same folder: copy that file from `node_modules/axylo/dist/`.' };\n  }\n  return { markup: null, text: 'This is the body of a page. Its module script imports `axylo` by name, so the page needs a bundler or an import map that resolves it.' };\n}\n\n/**\n * Copies the examples into the packed consumer's `src`, so that they resolve `axylo` from the installed\n * tarball: .ts files and helpers as they are; each script of an .html example as\n * a .js file (classic scripts get `export {}` for a scope of their own, and a declaration of the `Axylo`\n * global from the package's own types); the Node examples under `src/node`.\n */\nexport function writeConsumerSources(consumerDir) {\n  const src = path.join(consumerDir, 'src');\n  fs.rmSync(src, { recursive: true, force: true });\n  fs.mkdirSync(path.join(src, 'node'), { recursive: true });\n  for (const e of listExamples().filter(e => e.ext !== 'html')) {\n    fs.writeFileSync(path.join(src, `${e.name}.${e.ext}`), e.source);\n  }\n  for (const file of listHelpers()) fs.copyFileSync(path.join(examplesDir, file), path.join(src, file));\n  fs.writeFileSync(path.join(src, 'globals.d.ts'), \"declare const Axylo: typeof import('axylo');\\n\");\n  const scripts = {};\n  for (const example of listExamples().filter(e => e.ext === 'html')) {\n    for (const script of htmlScripts(example)) {\n      fs.writeFileSync(path.join(src, script.file), script.kind === 'classic' ? script.code + '\\nexport {};\\n' : script.code);\n      scripts[script.file] = { example: example.file, line: script.line, kind: script.kind };\n// The documentation's Markdown converter, on the subset the pages use. Expected HTML is written by hand.\nimport { describe, expect, it } from 'vitest';\nimport { checkHref, escapeHtml, markdownToHtml, renderInline, slug, splitRow, wordCount } from '../lib/markdown.mjs';\n\ndescribe('inline', () => {\n  it('escapes every special character in text', () => {\n    expect(renderInline(`a < b & \"c\" > 'd'`)).toBe('a &lt; b &amp; &quot;c&quot; &gt; &#39;d&#39;');\n  });\n  it('never passes HTML through', () => {\n    expect(renderInline('<script>alert(1)</script>')).toBe('&lt;script&gt;alert(1)&lt;/script&gt;');\n    expect(renderInline('<img src=x onerror=alert(1)>')).not.toContain('<img');\n  });\n  it('renders code spans with their content escaped', () => {\n    expect(renderInline('use `<div>` here')).toBe('use <code>&lt;div&gt;</code> here');\n  });\n  it('renders a code span that contains a backtick with a double fence', () => {\n    expect(renderInline('`` `AX${number}` ``')).toBe('<code>`AX${number}`</code>');\n  });\n  it('renders strong and emphasis, and leaves a lone asterisk alone', () => {\n    expect(renderInline('**bold** and *em*')).toBe('<strong>bold</strong> and <em>em</em>');\n    expect(renderInline('2 * 3 = 6')).toBe('2 * 3 = 6');\n  });\n  it('renders links, rewrites their targets and escapes them', () => {\n    const link = (url: string) => url.replace(/\\.md/, '.html');\n    expect(renderInline('see [the data page](data.md#gaps)', link)).toBe('see <a href=\"data.html#gaps\">the data page</a>');\n    expect(renderInline('[x](a.md?b=1&c=2)')).toBe('<a href=\"a.md?b=1&amp;c=2\">x</a>');\n    expect(() => renderInline('[x](a\"b)')).toThrow();\n  });\n  it('allows code inside link text', () => {\n    expect(renderInline('[`zoom`](updating.md)')).toBe('<a href=\"updating.md\"><code>zoom</code></a>');\n  });\n  it('allows only relative paths, fragments, https: and mailto: as link destinations', () => {\n    for (const ok of ['data.md#gaps', '#top', '../x/y.ts', 'https://example.org/a', 'mailto:someone@example.org']) expect(checkHref(ok)).toBe(ok);\n    for (const bad of ['javascript:alert(1)', 'custom:chapter', 'data:text/html,x', '//evil.example/x', 'http://example.org', 'JavaScript:x', 'a b']) {\n      expect(() => checkHref(bad), bad).toThrow();\n    }\n    expect(() => renderInline('[Custom](custom:chapter)')).toThrow(/not allowed/);\n  });\n  it('re