> `<div id=\"${escapeHtml(id)}\" class=\"example-target\"></div>`).join('\\n') +\napps/docs/lib/site.mjs:264:<body class=\"example-page\">\napps/docs/lib/site.mjs:273:function renderPage(entry, source, index, ctx) {\napps/docs/lib/site.mjs:299:export function pageLink(url, from, base, ctx) {\napps/docs/lib/site.mjs:318:function directive({ kind, name, target }, where, ctx, ids) {\napps/docs/lib/site.mjs:319:  if (kind === 'example') return exampleBlock(name, target, where, ctx, ids);\napps/docs/lib/site.mjs:321:  if (kind === 'table') return generatedTable(name, target, where, ctx);\napps/docs/lib/site.mjs:327:function diagnosticOutputBlock(code, target, where, ctx) {\napps/docs/lib/site.mjs:335:function repoPath(where, target) {\napps/docs/lib/site.mjs:339:function listText(items) {\napps/docs/lib/site.mjs:343:function exampleBlock(name, target, where, ctx, ids) {\napps/docs/lib/site.mjs:345:  const example = ctx.examples.find(e => e.repoFile === relative);\napps/docs/lib/site.mjs:346:  if (!example) throw new Error(`${path.relative(repoRoot, where)}: example ${target} does not exist`);\napps/docs/lib/site.mjs:347:  if (example.name !== name) throw new Error(`${path.relative(repoRoot, where)}: example link text \"${name}\" does not match ${example.file}`);\napps/docs/lib/site.mjs:348:  const full = listExamples().find(e => e.name === example.name);\napps/docs/lib/site.mjs:349:  const raises = example.raises.length\napps/docs/lib/site.mjs:350:    ? `<p class=\"example-note\">This example raises ${listText(example.raises.map(c => `<a href=\"diagnostics/${c}.html\">${c}</a>`))} on purpose.</p>`\napps/docs/lib/site.mjs:353:  const helpers = full.helpers.map(h => `<a href=\"${sourcePath(`apps/docs/examples/${h}`)}\">examples/${escapeHtml(h)}</a>`);\napps/docs/lib/site.mjs:354:  const hostBlock = `<div class=\"example-host\"><p><strong>To run it yourself:</strong> ${renderInline(host.text)}${helpers.length ? ` It also imports ${listText(helpers)}, the shared fixture, whi