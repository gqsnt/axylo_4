.all([fixture, answer, taskFiles('daily-revenue').expected].map(readJson));\n+    const days = Array.from({ length: 8 }, (_, index) => new Date(Date.UTC(2026, 4, index + 1)).toISOString().slice(0, 10));\n+    const dates = data.map(row => row.day.slice(0, 10));\n+    expect(data.every(row => row.day.endsWith('T00:00:00Z'))).toBe(true);\n+    expect(dates).not.toEqual(dates.toSorted());\n+    expect(dates.toSorted()).toEqual(days.filter(day => day !== '2026-05-04'));\n+    expect(data.map(row => row.revenue)).toEqual(expect.arrayContaining(['+2', '.5', '0x10']));\n+    const observations = new Map(data.map(row => [row.day.slice(0, 10), decimalValue(row.revenue)]));\n+    expect(expected).toEqual({\n+      ...primary,\n+      rows: days.map(day => [day, observations.get(day) ?? null]),\n+      valuesNotShown: [...observations.values()].filter(value => value === null).length,\n+    });\n+  });\n+\n   it('accepts formatted numbers and omitted gaps, and rejects a zero substituted for any gap', () => {\n     fc.assert(fc.property(fc.array(fc.integer({ min: -1000000, max: 1000000 }), { minLength: 1, maxLength: 12 }), values => {\n       const expected = {\n<div id=\"raw\"></div>\n<div id=\"normalized\"></div>\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  // Raises AX106 on purpose.\n  const rows = [\n    { day: '2026-03-02', revenue: 1250 },\n    { day: '2026-03-03', revenue: '1340.5' },\n    { day: '2026-03-04', revenue: 980 },\n  ];\n\n  line('#raw', {\n    title: 'Revenue as received',\n    data: rows,\n    x: 'day',\n    // @ts-expect-error The mixed field fails type checking. This shows what happens in JavaScript.\n    y: { field: 'revenue', label: 'Revenue', parse: 'number' },\n  });\n\n  const decimal = /^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$/;\n  const input = [...rows, { day: '2026-03-05', revenue: '0x10' }];\n  const normalized = input.map(row => {\n    if (typeof row.revenue === 'string' && decimal.test(row.revenue)) {\n      return { ...row