{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat rehearsal/test/fixtures.test.mjs rehearsal/fixtures/daily-revenue* && cat rehearsal/README.md && rg -n 'alternate|expected\\\\.json|fixture' rehearsal -g '*.mjs' -g '\"'!**/records/**'\"'\"","aggregated_output":"import { describe, expect, it } from 'vitest';\nimport fc from 'fast-check';\nimport { readJson, taskFiles } from '../files.mjs';\nimport { calendarDate, compareHeaders, compareRows } from '../table.mjs';\n\nconst specs = [\n  ['daily-visits', [2026, 3, 1, 30], ['visits'], [6, 12, 26]],\n  ['signups', [2026, 4, 6, 7], ['signpus'], []],\n  ['daily-revenue', [2026, 5, 1, 8], ['revenue'], [4]],\n  ['regional-sales', null, ['north', 'central', 'west'], []],\n];\n\nfunction quarterOrdinal(label) {\n  const [, year, quarter] = /^(\\d{4}) Q([1-4])$/.exec(label);\n  return Number(year) * 4 + Number(quarter);\n}\n\ndescribe('fixture expectations', () => {\n  it.each(specs)('%s follows the calendar or quarters and preserves the source values in both inputs', async (task, period, keys, missing) => {\n    const files = taskFiles(task);\n    const [primary, expected, alternate, alternateExpected] = await Promise.all(\n      [files.fixture, files.expected, files.alternate, files.alternateExpected].map(readJson));\n    expect(alternateExpected.series).toEqual(expected.series);\n    expect(alternateExpected.rows.map(row => row[0])).toEqual(expected.rows.map(row => row[0]));\n    for (const [i, [day, ...values]] of expected.rows.entries()) {\n      expect(alternateExpected.rows[i][0]).toBe(day);\n      for (const [j, value] of values.entries()) {\n        if (value !== null) expect(alternateExpected.rows[i][j + 1]).not.toBe(value);\n      }\n    }\n    for (const [data, answer] of [[primary, expected], [alternate, alternateExpected]]) {\n      if (!period) {\n        expect(data.every(row => keys.every(key => typeof row[key] === 'string'))).toBe(true);\n        const quarters = data.toSorted((a, b) => quarterOrdinal(a.quarter) - quarterOrdinal(b.quarter));\n        expect(quarters.map(row => row.quarter)).not.toEqual(data.map(row => row.quarter));\n        expect(answer.rows).toEqual(quarters.map(row => [row.quarter, ...keys.map(key => Number(row[key]))]));\n        continue;\n      }\n\n      const [year, month, start, count] = period;\n      const days = Array.from({ length: count }, (_, index) =>\n        new Date(Date.UTC(year, month - 1, start + index)).toISOString().split('T')[0]);\n      const observations = new Map(data.map(row => [row.day.split('T')[0], row]));\n      expect(observations.size).toBe(data.length);\n      expect(data.length).toBe(days.length - missing.length);\n      expect(days.filter(day => !observations.has(day)).map(day => Number(day.slice(-2)))).toEqual(missing);\n      const omitted = data.flatMap(row => keys.filter(key => !Object.hasOwn(row, key)));\n      expect(omitted).toHaveLength(task === 'signups' && data === alternate ? 1 : 0);\n      expect(answer.valuesNotShown ?? 0).toBe(omitted.length);\n      expect(answer.rows).toEqual(days.map(day => {\n        const row = observations.get(day);\n        return [day, ...keys.map(key => row && Object.hasOwn(row, key) ? Number(row[key]) : null)];\n      }));\n      if (missing.length) {\n        expect(data.map(row => row.day)).not.toEqual(data.map(row => row.day).sort());\n        expect(data.every(row => row.day.endsWith('T00:00:00Z'))).toBe(true);\n      }\n    }\n  });\n\n  it('accepts formatted numbers and omitted gaps, and rejects a zero substituted for any gap', () => {\n    fc.assert(fc.property(fc.array(fc.integer({ min: -1000000, max: 1000000 }), { minLength: 1, maxLength: 12 }), values => {\n      const expected = {\n        x: 'category', series: [{ label: 'Sales' }],\n        rows: [['Missing', null], ...values.map((value, i) => [String(i), value])],\n      };\n      const format = new Intl.NumberFormat('en-US');\n      const displayed = values.map((value, i) => [String(i), format.format(value)]);\n      expect(compareRows(expected, displayed).pass).toBe(true);\n      expect(compareRows(expected, [['Missing', 'No data'], ...displayed]).pass).toBe(true);\n      expect(compareRows(expected, [['Missing', '0'], ...displayed]).pass).toBe(false);\n    }), { numRuns: 1000 });\n  });\n\n  it.each(['Apr 6, 2026', 'April 6 2026', '06 April 2026', '6 Apr. 2026', '2026-04-06', '4/6/2026',\n    'Monday, April 6, 2026'])('reads %s as the same date', text => {\n    expect(calendarDate(text)).toBe('2026-04-06');\n  });\n\n  it.each(['Apr 6, 2026, 9:00 AM GMT+9', '2026-04-06T00:00:00Z', '31 April 2026'])('rejects %s as a calendar date', text => {\n    expect(calendarDate(text)).toBeNull();\n  });\n\n  it('compares every label and unit and accepts reordered series with their values', () => {\n    const expected = {\n      x: 'date', series: [{ label: 'North', unit: 'USD' }, { label: 'West' }],\n      rows: [['2026-04-06', 1250.5, 12]],\n    };\n    expect(compareHeaders(expected, ['Day', 'west', 'North (USD)'])).toMatchObject({ pass: true, order: [2, 1] });\n    expect(compareHeaders(expected, ['Day', 'West', 'North (kg)']).pass).toBe(false);\n    expect(compareHeaders(expected, ['Day', 'West', 'North']).pass).toBe(false);\n    expect(compareHeaders(expected, ['Day', 'West (kg)', 'North (USD)']).pass).toBe(false);\n    expect(compareRows(expected, [['06 April 2026', '12', '1,250.50 USD']], [2, 1]).pass).toBe(true);\n    expect(compareRows(expected, [['06 April 2026', '12', '1,250.50']], [2, 1]).pass).toBe(false);\n  });\n});\n{\n  \"title\": \"Daily store revenue\",\n  \"type\": \"line\",\n  \"x\": \"date\",\n  \"series\": [\n    {\n      \"label\": \"Revenue\"\n    }\n  ],\n  \"rows\": [\n    [\"2026-05-01\", 1425.25],\n    [\"2026-05-02\", 1082.5],\n    [\"2026-05-03\", 1047.75],\n    [\"2026-05-04\", null],\n    [\"2026-05-05\", 1837.5],\n    [\"2026-05-06\", 1649.75],\n    [\"2026-05-07\", 1728.5],\n    [\"2026-05-08\", 1941.25]\n  ]\n}\n[\n  {\"day\": \"2026-05-07T00:00:00Z\", \"revenue\": \"1728.5\"},\n  {\"day\": \"2026-05-03T00:00:00Z\", \"revenue\": \"1047.75\"},\n  {\"day\": \"2026-05-05T00:00:00Z\", \"revenue\": 1837.5},\n  {\"day\": \"2026-05-01T00:00:00Z\", \"revenue\": \"1425.25\"},\n  {\"day\": \"2026-05-08T00:00:00Z\", \"revenue\": 1941.25},\n  {\"day\": \"2026-05-02T00:00:00Z\", \"revenue\": \"1082.5\"},\n  {\"day\": \"2026-05-06T00:00:00Z\", \"revenue\": \"1649.75\"}\n]\n{\n  \"title\": \"Daily store revenue\",\n  \"type\": \"line\",\n  \"x\": \"date\",\n  \"series\": [\n    {\n      \"label\": \"Revenue\"\n    }\n  ],\n  \"rows\": [\n    [\"2026-05-01\", 1302.25],\n    [\"2026-05-02\", 984.5],\n    [\"2026-05-03\", 899.75],\n    [\"2026-05-04\", null],\n    [\"2026-05-05\", 1576.5],\n    [\"2026-05-06\", 1438.75],\n    [\"2026-05-07\", 1693.5],\n    [\"2026-05-08\", 1705.25]\n  ]\n}\n[\n  { \"day\": \"2026-05-06T00:00:00Z\", \"revenue\": \"1438.75\" },\n  { \"day\": \"2026-05-02T00:00:00Z\", \"revenue\": \"984.5\" },\n  { \"day\": \"2026-05-08T00:00:00Z\", \"revenue\": 1705.25 },\n  { \"day\": \"2026-05-01T00:00:00Z\", \"revenue\": \"1302.25\" },\n  { \"day\": \"2026-05-05T00:00:00Z\", \"revenue\": 1576.5 },\n  { \"day\": \"2026-05-03T00:00:00Z\", \"revenue\": \"899.75\" },\n  { \"day\": \"2026-05-07T00:00:00Z\", \"revenue\": \"1693.5\" }\n]\n# DX12 agent rehearsal\n\nUse one records directory per release rehearsal. Build the published docs and pack the release candidate before running. The harness reads `apps/docs/dist` and `tests/dist/.packed/axylo-0.0.0.tgz`. Installations of Codex CLI, Claude Code, system Chrome, and the repository development dependencies are required. Codex uses the file login at `~/.codex/auth.json`. Claude uses `ANTHROPIC_API_KEY` when nonempty and otherwise uses the machine's OAuth login at `~/.claude/.credentials.json`.\n\n```sh\nnode rehearsal/run.mjs --attempts 3 --parallel 2 --records /tmp/axylo-release-rehearsal\nnode rehearsal/summary.mjs --records /tmp/axylo-release-rehearsal\n```\n\n## Release protocol\n\n- Use the fixed prompts for `daily-visits`, `regional-sales`, `signups`, and `daily-revenue`. Run three fresh, uncoached attempts per task with each of Codex CLI `gpt-6.2-sol` and Claude Code `claude-opus-5-5`. Both request `xhigh` effort and have 20 minutes per attempt. Codex reports the observed model and effort through its rollout. Claude reports the observed model in assistant messages. The invocation records the requested `--effort` and the stream leaves effective effort unknown. An observed Claude version suffix is retained and must agree across counted runs for that agent.\n- Give each agent the same prompt bytes, published docs, installed package and primary data. Allow reading inputs, writing the answer and running documented Node self-checks within the time limit. Grade after the CLI exits. Keep grading data, expected results and grader output out of the staged inputs and give the agent no feedback or follow-up.\n- An invocation fills open slots up to `--attempts` per selected cell. The default is three. `--parallel` caps concurrent attempts and defaults to one. Omit `--agent` and `--task` to run all eight cells. Use one runner invocation at a time for a records directory. `--workdir` selects the scratch parent outside the repository and defaults to the system temporary directory. Records default to `rehearsal/records/`.\n- Keep passes, failures and timeouts as counted outcomes. Only voids and infrastructure failures leave slots open. A CLI authentication or provider failure or an exit before a model turn is an infrastructure failure. The runner records the reason and uses saved transcripts to identify older infrastructure failures. Rerun the same batch to fill open slots after inspecting the saved reason. The new record links to the record it replaces. A harness timeout still counts when truncation leaves the audit unverifiable and the transcript has no recorded path violation or evidence of a CLI infrastructure failure.\n- The owner decided on 2026-11-19 that the 1.0 rehearsal rule requires at least two passes in three counted slots in each of the eight agent × task cells. The summary shows the counts and rule status for each cell, the batch totals, and the recorded failures. It also checks that counted records use matching docs, package, task inputs, grader, tool versions and observed model IDs. Keep the release candidate and CLI installations fixed while collecting a batch. An empty summary displays zero counts for all cells.\n- Report this as “agent rehearsal: these prompts, these models, Chrome; not user evidence”. With three independent runs per cell, the two-sided exact 95% binomial interval is 9.43% to 99.16% for two successes and 29.24% to 100% for three. The counts apply to these line and bar tasks in Chrome and do not establish general success rates or human usability.\n\n## Isolation and audit\n\nEach attempt gets a newly created directory outside the repository with a fresh home, temporary storage and workspace. The workspace contains copies of the published docs, the unpacked package, primary data and prompt, and a writable location for `chart.js` and its helpers. The docs retain published examples and exclude internal source snapshots. The runner applies `chmod -R a-w` to `docs/` and `node_modules/` and removes write permission from the fixture, prompt and package manifest. These file modes protect against accidental writes. A sufficiently privileged or same-owner subprocess can still change modes or replace inputs. The runner verifies staged input hashes before grading, and the browser grader supplies canonical data from the harness.\n\n- **Codex CLI 0.170.0.** The runner assigns a fresh `CODEX_HOME` and symlinks only `auth.json` from the real login. It uses `--ignore-user-config` and `--ignore-rules`, disables apps, plugins, memory and hooks, skips host skill discovery, and disables web search. It uses `-s workspace-write`, `-a never`, and `sandbox_workspace_write.network_access=false`. The CLI help describes `--sandbox` as selecting the sandbox for “model-generated shell commands” and says `--ignore-user-config` still uses `CODEX_HOME` for auth. Workspace-write applies write and network restrictions to agent commands. It allows host reads, and Codex's shell can run more than Node. The prompt and audit constrain use of that wider surface.\n- **Claude Code 2.1.327.** Each attempt has a fresh `HOME` and `CLAUDE_CONFIG_DIR`. With an API key, the runner passes it through and uses `--bare`, which skips OAuth, auto-memory and `CLAUDE.md` discovery. For OAuth the only initial config entry is a `.credentials.json` symlink into the real home. The runner creates and removes the symlink without opening the credential file. The fresh config and staged workspace contain no local Claude customizations or saved memory. Without `--bare`, `--safe-mode` disables `CLAUDE.md` discovery, skills, installed plugins, hooks and other customizations, and `CLAUDE_CODE_DISABLE_AUTO_MEMORY=1` turns off auto-memory. Built-in plugins, admin-managed settings and managed plugin hooks can still apply.\n- Both Claude modes keep `--restricted`, which ignores user, project and local settings and confines file tools to working directories. `--strict-mcp-config` limits MCP to the supplied empty configuration, `--disable-slash-commands` disables skills and commands, and `--no-session-persistence` turns off session saves in print mode. The built-in allowlist exposes file tools and Bash, with `--allowedTools` limiting Bash permission to `node …` and `dontAsk` denying other calls. `--permission-prompts none` denies anything that would prompt. Web tools and Chrome are absent. A Node subprocess can have host filesystem and network access through the operating system.\n- Both CLIs need their provider transport. These CLI controls give fresh session state and restrict configured tools. They do not provide a filesystem namespace or a transport-only network policy for Claude's Node subprocess. For strictly enforced docs-only reads and network isolation, use external isolation that enforces those boundaries for both CLIs. Keep host managed policies fixed and record them with the rehearsal if they apply.\n\nThe audit requires a parseable transcript with the CLI's start and terminal events. Empty, malformed, or truncated transcripts are **unverifiable**. The audit takes paths from file-tool inputs and literal shell file operands, including redirects and paths relative to an explicit working directory or a `cd` command. It skips command bodies blocked by the CLI before execution, file contents, inline programs, search patterns, tool output and assistant prose. The audit can resolve symlinks when it has filesystem evidence. “No findings” describes the transcript only. A subprocess's actual reads, dynamically constructed paths and fetches from Node code are outside the transcript's coverage.\n\nThe attempt's workspace, fresh home and config, and temporary storage are all inside its run directory. Recorded accesses to the repository, the real home, another attempt or the linked login void an attempt, even for missing files and after a timeout. System tools are allowed. Other outside paths are recorded under “looked outside the workspace,” with each path's existence. Only existing paths in that group void the attempt. Excluded tools also make a completed audit ineligible for grading.\n\nEach record stores `run.json` with the CLI version, arguments, requested and observed model metadata, elapsed time and status, and SHA-256 hashes of both inputs, their expected results, the prompt, copied docs, packed library and grader. Claude records include `claudeMode` as `bare` or `fresh-config`. The record also stores the transcript, stderr, answer files if present, and the grade and Chrome version if the answer reached Chrome. Audit version 2 records the original workspace and the filesystem observations used to resolve paths. The disposable workspace and home, including the credential symlink, are removed after saving the record. An interrupted batch may leave an incomplete record or scratch directory.\n\n## Reader grading and verification\n\nThe grader uses clean headless Chrome contexts in Los Angeles and Tokyo with English (US) as the page locale. Each answer must handle the original and changed-value input. The alternate signups input has an absent value field that should produce an omission note. Dates are graded as calendar days, including unambiguous month-first and day-first forms. Series labels must match the requested fields. The fixtures declare no measurement unit or currency. The grader opens the standard table control, checks caption, semantic headers and rows, reads the plotted x order and SVG stroke breaks, samples the first calendar date through the plot control, and checks title clipping and omission counts in both the visible note and the accessibility tree.\n\nRe-auditing is allowed because the audit applies deterministic rules to the saved transcript and its path context. Version 1 records lack saved filesystem observations, so replay checks outside file existence on the host and can only resolve symlinks still present there. Run the command on the original host with the release candidate's built docs and packed library available. Use one writer at a time for the records directory.\n\n```sh\nnode rehearsal/reaudit.mjs --records rehearsal/records/release-1e93128\nnode rehearsal/summary.mjs --records rehearsal/records/release-1e93128\n```\n\nThe command re-audits every record and uses the runner's grader for voids eligible for grading. It prepares a fresh workspace, verifies the input and grader hashes in `run.json`, then restores and grades the saved answer. A hash mismatch or a browser infrastructure error leaves the previous verdict in place and causes exit 2. The transcript and answer stay intact. Every updated record keeps the previous verdict, audit version and date in `run.json` under `history`. A re-audited record entering a counted slot keeps its original attempt number. The summary uses the latest verdicts and reports how many records were re-audited.\n\nFor a single prepared workspace or the test suite, use the following commands.\n\n```sh\nnode rehearsal/grade.mjs --task daily-visits --workdir /path/to/prepared/workspace\nnpx --no-install vitest run --root rehearsal --exclude '**/*.browser.test.mjs'\nnpx --no-install vitest run --root rehearsal\n```\n\nThe first Vitest command runs fixture, comparator, audit and local-runner tests without Chrome. The second also runs the browser references and negative controls. The runner exits 0 when all newly scheduled attempts pass or there are no open slots, 1 for any new failed, timed-out or void attempt, and 2 for setup or infrastructure errors. Use the summary to evaluate the whole release rehearsal.\nrehearsal/protocol.mjs:55:  const { alternate, expected, alternateExpected } = taskFiles(task);\nrehearsal/protocol.mjs:58:    alternate: fileHash(alternate),\nrehearsal/protocol.mjs:60:    alternateExpected: fileHash(alternateExpected),\nrehearsal/grade.mjs:219:    ['primary', taskPaths.fixture, taskPaths.expected],\nrehearsal/grade.mjs:220:    ['alternate', taskPaths.alternate, taskPaths.alternateExpected],\nrehearsal/grade.mjs:221:  ].map(async ([name, fixture, expected]) => ({ name, data: await readJson(fixture), expected: await readJson(expected) })));\nrehearsal/grade.mjs:233:    // Grade the original fixture even if the agent changed its local copy while experimenting.\nrehearsal/files.mjs:19:    fixture: join(rehearsal, 'fixtures', task + '.json'),\nrehearsal/files.mjs:20:    expected: join(rehearsal, 'fixtures', task + '.expected.json'),\nrehearsal/files.mjs:21:    alternate: join(rehearsal, 'fixtures', task + '.alternate.json'),\nrehearsal/files.mjs:22:    alternateExpected: join(rehearsal, 'fixtures', task + '.alternate.expected.json'),\nrehearsal/workspace.mjs:37:  const { prompt, fixture, expected } = taskFiles(task);\nrehearsal/workspace.mjs:91:    await copyFile(fixture, join(workspace, 'data.json'));\nrehearsal/test/grade.browser.test.mjs:71:  const transcript = new URL('./fixtures/release-1e93128/codex-regional-sales-2.jsonl', import.meta.url);\nrehearsal/test/grade.browser.test.mjs:86:    ['primary', LA], ['primary', Tokyo], ['alternate', LA], ['alternate', Tokyo],\nrehearsal/test/grade.browser.test.mjs:110:    ['primary', LA], ['primary', Tokyo], ['alternate', LA], ['alternate', Tokyo],\nrehearsal/test/grade.browser.test.mjs:165:  const primary = await readJson(taskFiles(task).fixture);\nrehearsal/test/grade.browser.test.mjs:169:  expect(result.timezones.filter(zone => zone.input === 'alternate').every(zone => !criterion(zone, 'table rows').pass)).toBe(true);\nrehearsal/test/fixtures.test.mjs:18:describe('fixture expectations', () => {\nrehearsal/test/fixtures.test.mjs:21:    const [primary, expected, alternate, alternateExpected] = await Promise.all(\nrehearsal/test/fixtures.test.mjs:22:      [files.fixture, files.expected, files.alternate, files.alternateExpected].map(readJson));\nrehearsal/test/fixtures.test.mjs:23:    expect(alternateExpected.series).toEqual(expected.series);\nrehearsal/test/fixtures.test.mjs:24:    expect(alternateExpected.rows.map(row => row[0])).toEqual(expected.rows.map(row => row[0]));\nrehearsal/test/fixtures.test.mjs:26:      expect(alternateExpected.rows[i][0]).toBe(day);\nrehearsal/test/fixtures.test.mjs:28:        if (value !== null) expect(alternateExpected.rows[i][j + 1]).not.toBe(value);\nrehearsal/test/fixtures.test.mjs:31:    for (const [data, answer] of [[primary, expected], [alternate, alternateExpected]]) {\nrehearsal/test/fixtures.test.mjs:48:      expect(omitted).toHaveLength(task === 'signups' && data === alternate ? 1 : 0);\nrehearsal/test/reaudit.test.mjs:14:const fixtures = new URL('./fixtures/release-1e93128/', import.meta.url);\nrehearsal/test/reaudit.test.mjs:15:const fixture = name => readFile(new URL(name + '.jsonl', fixtures), 'utf8');\nrehearsal/test/reaudit.test.mjs:40:  const log = await fixture(`${agent}-${task}-${slot}`);\nrehearsal/test/reaudit.test.mjs:48:  const transcript = await fixture('codex-daily-revenue-3');\nrehearsal/test/reaudit.test.mjs:116:  await cp(new URL('codex-daily-revenue-3.jsonl', fixtures), join(saved, 'transcript.jsonl'));\nrehearsal/test/reaudit.test.mjs:123:    cli: { args: ['-C', revenueWorkspace], version: 'fixture-cli' }, exit: { code: 0, signal: null, timedOut: false, error: null },\nrehearsal/test/reaudit.test.mjs:125:    ...(status === 'pass' ? { browserVersion: 'fixture Chrome' } : {}) };\nrehearsal/test/reaudit.test.mjs:147:    expect(await readFile(join(workspace, 'data.json'), 'utf8')).toBe(await readFile(taskFiles(task).fixture, 'utf8'));\nrehearsal/test/reaudit.test.mjs:150:    return { pass: true, criteria: [], browserVersion: 'fixture Chrome' };\nrehearsal/test/reaudit.test.mjs:159:  expect(await readJson(join(saved, 'grade.json'))).toMatchObject({ pass: true, browserVersion: 'fixture Chrome' });\nrehearsal/test/reaudit.test.mjs:164:  expect(await readFile(join(saved, 'transcript.jsonl'), 'utf8')).toBe(await fixture('codex-daily-revenue-3'));\nrehearsal/test/runner.test.mjs:60:  const log = await readFile(new URL('./fixtures/claude-daily-visits-trial.jsonl', import.meta.url), 'utf8');\nrehearsal/test/runner.test.mjs:147:  const flags = args('claude', 'fixture-key');\nrehearsal/test/runner.test.mjs:155:  ['bare', 'fixture-key'],\nrehearsal/test/runner.test.mjs:164:  await writeFile(login, 'fixture credential', { mode: 0o600 });\nrehearsal/test/runner.test.mjs:178:  echo fixture-version\nrehearsal/test/runner.test.mjs:182:  fixture-key) key_state=fixture ;;\nrehearsal/test/runner.test.mjs:210:    cli: { version: 'fixture-version', args }, requested: { effort },\nrehearsal/test/runner.test.mjs:215:  expect(childKey).toBe(key ? 'fixture' : 'unset');\nrehearsal/test/runner.test.mjs:237:  expect(await readFile(login, 'utf8')).toBe('fixture credential');\nrehearsal/test/runner.test.mjs:248:    '#!/bin/sh', 'if [ \"$1\" = \"--version\" ]; then echo fixture-version; exit 0; fi',\nrehearsal/test/runner.test.mjs:255:  expect(await agentVersion('codex', options)).toBe('fixture-version');\nrehearsal/test/runner.test.mjs:323:  await writeFile(login, 'fixture credential');\nrehearsal/test/runner.test.mjs:329:    records, workdir: scratch, claudeLogin: login, version: async () => 'fixture-version', gradeAnswer,\nrehearsal/test/runner.test.mjs:351:  await Promise.all([mkdir(records), writeFile(login, 'fixture credential')]);\nrehearsal/test/runner.test.mjs:354:    records, workdir: scratch, login, version: async () => 'fixture-version', gradeAnswer,\nrehearsal/test/runner.test.mjs:380:    records, workdir: scratch, claudeLogin: join(scratch, '.credentials.json'), version: async () => 'fixture-version',\nrehearsal/test/runner.test.mjs:396:    status, timeoutMs, cli: { version: 'fixture-version', args: expect.arrayContaining(['--effort', effort]) },\nrehearsal/test/runner.test.mjs:397:    hashes: { input: expect.stringMatching(/^[a-f0-9]{64}$/), alternate: expect.stringMatching(/^[a-f0-9]{64}$/),\nrehearsal/test/runner.test.mjs:439:    version: async () => 'fixture-version', gradeAnswer,\nrehearsal/test/runner.test.mjs:508:    hashes: { docs: 'docs', grader: 'grader', package: 'package' }, cli: { version: cell.agent }, browserVersion: 'fixture Chrome',\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"cat apps/docs/pages/{data,options,diagnostics,stability,conformance}.md && rg -n 'validate\\\\(' apps/docs -g '\"'!dist/**'\"' -g '\"'!**/dist/**'\"'\"","aggregated_output":"# Your data\n\nAfter this page you can pass the same table as long rows, wide rows or typed columns; say which kind of time your x values are; control what happens to missing values; and give values a unit, a format and a percent scale.\n\n## One table, three shapes\n\nTake four days with two readings per day: sessions for two channels.\n\n| day | Direct | Referral |\n|---|---|---|\n| 2026-03-02 | 3,120 | 410 |\n| 2026-03-03 | 3,380 | 455 |\n| 2026-03-04 | 3,290 | 390 |\n| 2026-03-05 | 3,510 | 520 |\n\nAxylo accepts this table in three shapes. All three produce the same chart, the same table view and the same diagnostics; row numbers in diagnostics and events refer to your own data in the shape you gave it.\n\n### Long rows\n\nOne row per x and series, as most SQL queries and APIs return it. `series` names the field whose value says which series a row belongs to; that value is the series' key and its name.\n\n[example: data-long](../examples/data-long.ts)\n\n### Wide rows\n\nOne row per x, one field per series. `y` is a list of fields, and there is no `series`. Passing both is a type error, and at run time it raises [AX150](diagnostics.md#ax150). Each field is a series: its key is the field name (`direct`), its name for the reader is the field's `label` (`'Direct'`). Use the key in `colors` and in event handlers, and the label for display. The series share one value axis: the first field's `domain`, `scale` and `tickFormat` set it (a `tickFormat` on a later field is reported, [AX150](diagnostics.md#ax150)), and with more than one field the axis is titled \"Value\" (the `value` message). The chart's generated name and its summary name the series rather than that axis (\"Line chart of Visits and Signups by day\", with fields labelled `'Visits'` and `'Signups'`). When the series have different units, the summary gives each series' range in its own unit and no range for the chart as a whole.\n\n[example: data-wide](../examples/data-wide.ts)\n\n### Typed columns\n\n`data: { columns }` with one array-like per field (an array or a typed array), all of the same length; different lengths are error [AX100](diagnostics.md#ax100). In a `Float64Array` or `Float32Array`, `NaN` means \"no value\" and raises nothing. This shape suits large data, because Axylo can read such a column in place; see [what Axylo reads, keeps and copies](data.md#what-axylo-reads-keeps-and-copies).\n\n[example: data-columns](../examples/data-columns.ts)\n\n## Fields\n\nA field is a key of your rows, written as a string, or an object when it needs more:\n\n```ts\nx: 'day'\ny: { field: 'sessions', label: 'Sessions', unit: 'visits' }\n```\n\nThe object form adds a label (the axis title, and the series name in tooltip, table and announcements), a unit, formats, a scale, a missing-value rule and author bounds. The [options reference](options.md#value-fields) lists them all.\n\nWith TypeScript, field names are checked against your row type. A misspelled field, a text field on a value axis, or wide `y` together with `series` does not compile. With untyped rows (from `fetch().json()`, say) the same mistakes are reported at run time: a field that no row has is [AX101](diagnostics.md#ax101), and the message lists the keys the rows do have and, when one is close, the closest match. With no rows, there is nothing to check a field against, and nothing is reported.\n\n## Three kinds of time\n\nDates are where charts most often go wrong without anyone noticing. Axylo keeps three kinds apart and never mixes them silently.\n\n| Kind | Looks like | Means | Shown |\n|---|---|---|---|\n| Calendar date | `'2026-02-24'`, `'2026-02'`, `'2026'` | A day, month or year, wherever you are | The same in every time zone |\n| Instant | Epoch milliseconds with `type: 'time'`, a `Date`, `'2026-02-24T09:30:00Z'`, `'2026-02-24T09:30:00+01:00'` | One moment, the same everywhere | In `timeZone` (default: the viewer's zone), with the zone named in the tooltip heading and the summary |\n| Wall-clock time | `'2026-02-24T09:30'` (no offset) | What a clock showed, zone unknown | As written, with hint [AX112](diagnostics.md#ax112) |\n\n### The off-by-one-day trap\n\nA daily metric is a calendar date. Many back ends send it as an instant at UTC midnight: `'2026-02-24T00:00:00Z'`, or the epoch milliseconds of that moment. For a viewer in New York that moment is the evening of 23 February, so every daily value appears one day early. In Berlin it is still the 24th. Showing the instant in the viewer's zone is correct for an instant; the data said \"this moment\", not \"this day\".\n\nThe example below has the same five values sent both ways. Your browser's time zone decides how the first chart reads: west of UTC, its first point is on the 23rd.\n\n[example: dates](../examples/dates.ts)\n\nAxylo notices at least two distinct instants that all fall at the same time of day, whole days apart, and raises hint [AX111](diagnostics.md#ax111). The fix is one of:\n\n- Send calendar dates: `'2026-02-24'`. `new Date(ms).toISOString().slice(0, 10)` turns a UTC midnight into one.\n- Keep the values and declare `x: { field: 'day', type: 'date' }`. Axylo then reads each instant (string, number or `Date`) as the calendar day it falls on in UTC, as the [daily example](getting-started.md#daily-data-five-things-to-get-right) does.\n- If they really are instants and everyone should see UTC, set `x: { field: 'day', type: 'time', timeZone: 'UTC' }`.\n\n### How Axylo decides\n\nWhen `type` is not given, each value of the x field votes for a kind:\n\n- `YYYY-MM-DD`, `YYYY-MM` or `YYYY` strings for a calendar date;\n- date-time strings with `Z` or an offset, and `Date` objects, for an instant;\n- date-time strings without an offset for a wall-clock time;\n- finite numbers for a number. A bare number is never taken for an instant: epoch milliseconds need `type: 'time'`, and numbers that look like timestamps raise hint [AX109](diagnostics.md#ax109);\n- anything else for a category.\n\nCategories win when they are at least as many as all the other votes together. Otherwise the kind with the most votes wins, ties going to date, then instant, then wall-clock time, then number. Values of any other kind are then unusable: they are not drawn, and they raise [AX107](diagnostics.md#ax107) with a note to the reader. Three category strings, two dates and two numbers therefore make a date axis that keeps the two dates. When a feed mixes kinds, declare `type`.\n\nCategories keep the order in which they first appear.\n\n`timeZone` takes `'local'` (the default, the viewer's zone), `'UTC'`, or an IANA zone such as `'Europe/Paris'`. It applies to instants. A zone the browser does not know is [AX152](diagnostics.md#ax152), and the viewer's zone is used.\n\nCalendar periods other than years and months (quarters, ISO weeks) are categories in 1.0: write them as you want them read (`'2025 Q1'`) and set `ordered: true` on the x field so that their labels may be thinned when they do not fit.\n\n## Missing values\n\nAxylo never draws a missing value as zero unless you ask, and does not connect a line across a missing value it knows about. It knows about one when your data says so:\n\n| In your data | Drawn | Reported |\n|---|---|---|\n| `null`, or `''` | A gap | Nothing: this is how to say \"no data\" |\n| `NaN` in a `Float64Array` or `Float32Array` | A gap | Nothing |\n| The value field absent from a row (`undefined`) | A gap | Warning [AX102](diagnostics.md#ax102), and the reader's note |\n| The x or series field absent from a row | The row is not drawn | Warning [AX102](diagnostics.md#ax102), and the reader's note |\n| `NaN` or `Infinity` in rows | A gap | Warning [AX103](diagnostics.md#ax103), and the reader's note |\n| `0` | Zero | Nothing |\n\nA day with **no row at all** is different: the data says nothing about it. Axylo infers that a step is missing only from a series' own rows, when the x axis is dates, instants, wall-clock times or numbers and the series is regular: it has at least three rows, every interval between neighbouring rows is a whole multiple of the smallest one, and at least half of the intervals are the smallest one. A missing step it infers is drawn as a gap, as if the row held `null`, with hint [AX105](diagnostics.md#ax105). It infers nothing before the first row or after the last, in a series of one or two rows, in an irregular series, or when there would be more than twice as many missing steps as rows (and more than 1,000). Another series having a row at that x does not make the step missing in this one: a slot a series simply has no row for (a weekly series beside a daily one) is not a gap, its line is joined across it, and a bar chart draws no bar and no \"no data\" mark there. In a stack it is different, see below. So **when you know a day is missing, send it with `null`**: that is the instruction Axylo always follows.\n\nA value standing alone between two gaps is drawn as a point, so it does not vanish. On a bar chart a missing value gets a small \"no data\" mark (at the baseline, or for a stacked bar at the edge of its stack), distinct from a zero bar. Tooltip, table and announcements say \"No data\". When a warning means values were left out, the chart shows a short note to the reader (\"Values not shown: 3. See table.\") inside the figure, in every build.\n\n**In a stack** (stacked areas or bars), a series with no value at an x is a missing part, whatever the reason: a `null`, an inferred missing step, or no row there at all. The part has zero height, the series' line follows its band, and the total at that x is marked \"incomplete\" in the tooltip, the table and announcements, so a stack never shows a total made of values the data does not contain. A weekly series stacked with a daily one is incomplete on the days between its rows; see [the area chart's example](area.md#edge-case-a-missing-part-of-a-stack).\n\nFor counts, where a day without a row means nothing happened, declare it: `missing: 'zero'` turns null, absent and inferred-missing values of that field into zeros, and the note says the values are shown differently from the data.\n\n[example: missing](../examples/missing.ts)\n\nHere are the values an application sends by mistake, all at once. The note under the chart is what the reader sees; the console has one line per code.\n\n[example: line-dirty](../examples/line-dirty.ts)\n\n## Numbers sent as strings\n\nSome database drivers return counts and decimals as strings (Postgres `bigint` and `numeric`, BigQuery). Axylo looks at the whole field:\n\n- When every value is a plain decimal string (`'40'`, `'-1.5'`, and exponent notation such as `'1e3'`), the field is converted and drawn, and hint [AX104](diagnostics.md#ax104) asks you to say so with `parse: 'number'`. With that, there is no hint, and TypeScript accepts the string field on a value axis.\n- When the field also holds a number, or any string that is not a plain decimal (`'1,234'`, `'n/a'`), or another kind of value (`true`), every string in it is rejected, plain decimals included. They are not drawn, and they are warning [AX106](diagnostics.md#ax106).\n\nThe conversion is to JavaScript numbers. Integers are exact up to 9,007,199,254,740,991 (`Number.MAX_SAFE_INTEGER`); a larger one is rounded to the nearest number JavaScript can hold, without a diagnostic: `'9007199254740993'` reads 9,007,199,254,740,992. A string too large for a number (`'1e999'`) becomes infinite and is [AX103](diagnostics.md#ax103). When exact counts could exceed that limit, check them with `Number.isSafeInteger(Number(value))` before charting.\n\n[example: numeric-strings](../examples/numeric-strings.ts)\n\n## Order and duplicates\n\nRows can come in any order. Line, area and scatter charts are drawn in x order, and each value stays with its own row; categories keep the order in which they first appear.\n\n[example: unsorted](../examples/unsorted.ts)\n\nOn a line, area or bar chart one x has one value per series. Two rows with the same x in the same series are error [AX108](diagnostics.md#ax108): that series is not drawn, while the other series are; with no series left to draw, the chart shows its error state and keeps its table. Axylo does not know whether you meant the sum, the last or the average. Two donut slices with the same label are the same error, and the donut is not drawn. On a scatter chart repeated x values, and repeated points, are ordinary data.\n\n## Units, formats and percentages\n\n| Option on a value field | What it does |\n|---|---|\n| `label` | The axis title, and the series name in tooltip, table and announcements. Default: the field name. |\n| `unit` | Follows every value in tooltip, table and announcements, and is part of the axis title. |\n| `format` | How values are written in tooltip, table and announcements: `Intl.NumberFormat` options, or a function. Default: the locale's grouping, the full integer part and up to six significant fraction digits (`123,456.75`). |\n| `tickFormat` | How axis ticks are written. Default: the locale's grouping with the fraction digits the tick step needs (`50,000`); compact (`1.2M`) when the largest tick is at least a million; scientific from 10¹⁵. |\n| `scale: 'percent'` | The values are percentages from 0 to 100. |\n| `scale: 'ratio'` | The values are fractions from 0 to 1, shown as percentages. |\n\nA percent or ratio scale is declared, never guessed from a label. Its axis ends at full scale (100%) only when the largest value is at least half of full scale and not above it; otherwise it ends at the first tick at or above the data, so 4% is not drawn as a sliver of 100%. Numbers and dates are formatted for the `locale` option if given, else the document's language (`<html lang>`), else the browser's. A formatter that fails (a function that throws, or `Intl` options that `Intl` rejects) is warning [AX160](diagnostics.md#ax160), and the default format is used for that value.\n\n[example: units](../examples/units.ts)\n\nBar and area value axes always include zero, since a bar's length and an area's height are their values. A `domain` that leaves zero out is widened, with warning [AX110](diagnostics.md#ax110). Line and scatter axes fit the data.\n\nValue axes (y, and both axes of a scatter chart) end on a drawn tick at or beyond the data, the reference lines and bands, and stack totals; in a plot too narrow to label an end tick, the axis takes the next coarser step. A date, time or number x axis of a line, area or bar chart spans exactly its data instead (for bars, plus half a band at each end), so a time series is not padded to the next round tick.\n\n## What Axylo reads, keeps and copies\n\n- **Rows** are read when the chart is created or updated, and never changed. Their values are copied into Axylo's own typed arrays. Events hand back your own row object (`point.row`), and diagnostics name rows by their index in your data. A position no row of yours holds (an inferred missing day, a donut's \"Other\") has `row: null` and `index: -1`; check before you look a row up.\n- **Typed columns** of values (`Float64Array`, `Float32Array`) are read in place, without a copy, when Axylo can: the x values are already in order, no missing step is inferred, and no value has to change (no `Infinity`, no `missing: 'zero'` to apply). Otherwise Axylo copies what it needs; grouping long columns into series and scatter charts can need new storage too. Either way, do not change an array after passing it: to change the data, pass new arrays with `update({ data })`.\n- **Appended rows** are read once and added to the chart's own storage; `keep` limits how much is kept. See [Updating, streaming and zoom](updating.md#append-and-keep).\n\n## Checking data before you draw\n\n`validate(type, options)` runs the same reading and checking as a chart, without a page, and returns the diagnostics. Use it in Node, in a unit test, or in a coding agent's loop before rendering. See [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\n# Options reference\n\nAfter this page you can look up any option of any chart type, any field option, and every member of the chart handle, with its type, its default and what it does. The groups follow the declarations in `packages/axylo/src/public.ts`, which are the source of truth. Tests check that every key of those declarations is here with the type written here, and that each default written in `code` is what the chart does when the option is left out.\n\nTypes are written in TypeScript. `Row` is the type of one of your rows (for typed columns it is inferred from the columns), `Options` the options type of the chart, and `XValue` is `number | string | Date`, a value on an x axis.\n\n## Which options apply where\n\n| Group | line | area | bar | scatter | donut |\n|---|---|---|---|---|---|\n| [Common options](#common-options) | yes | yes | yes | yes | yes |\n| [Encoding](#encoding-line-area-bar) (`x`, `y`, `series`) | yes | yes | yes | – | – |\n| [Cartesian options](#cartesian-options) (`zoom`, `reference`) | yes | yes | yes | yes | – |\n| [`compact`](#compact) | yes | yes | yes | – | – |\n| [`stacked`](#area-options) | – | yes | – | – | – |\n| [`layout`, `horizontal`](#bar-options) | – | – | yes | – | – |\n| [Scatter encoding](#scatter-options) | – | – | – | yes | – |\n| [Donut encoding](#donut-options) (`label`, `value`) | – | – | – | – | yes |\n\nAn option that does not apply to a chart type does not compile, and at run time is ignored with [AX150](diagnostics.md#ax150).\n\n## Common options\n\nOn every chart type.\n\n<!-- options: CommonOptions -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `data` | `Data<Row>` | required | The rows (`readonly Row[]`), or `{ columns }` with one array or typed array per field, all of equal length. See [Your data](data.md). |\n| `title` | `string \\| Title` | none | Visible heading and accessible name. Without it (and without `labelledBy`) the name is generated, with AX140. In a compact chart it is the accessible name only. |\n| `labelledBy` | `string` | none | Id of an existing heading that names the chart, for cards that already show a title. |\n| `subtitle` | `string` | none | A line under the title. |\n| `description` | `string` | none | Added to the generated summary. The time zone and any omitted values are always stated. |\n| `state` | `'ready' \\| 'loading' \\| { error: string } \\| { empty: string }` | `'ready'` | Shows a loading, error or empty message inside the plot instead of the data. |\n| `legend` | `'auto' \\| false \\| 'top' \\| 'right' \\| 'bottom'` | `'auto'` | Where the legend goes, or `false` for none. `'auto'` places it under the plot. A chart with one series has no legend entries. |\n| `tooltip` | `boolean` | `true` | The pointer readout: the tooltip, or in a small plot the strip under it. With `false` nothing is pinned, and a click still selects. Keyboard reading is not affected. |\n| `table` | `boolean` | `true` | The \"View as table\" control. |\n| `colors` | `Readonly<Record<string, string>>` | none | A CSS colour per series key: the `series` value for long rows, the field name for wide rows, the slice label on a donut. |\n| `messages` | `Partial<Messages>` | built-in English | Replacements for text the reader sees. See [Messages](#messages). |\n| `locale` | `string` | the document's language | Locale for numbers and dates: this option, else `<html lang>`, else the browser's. |\n| `strict` | `boolean` | `false` | Throw on any error or warning found while checking a create, `update` or `append` call, from that call. |\n| `onDiagnostic` | `(diagnostic: Diagnostic) => void` | none | Called once for each diagnostic the chart newly finds, in every build. |\n\n### Title\n\nWhen `title` is an object:\n\n<!-- options: Title -->\n| Key | Type | Default | Meaning |\n|---|---|---|---|\n| `text` | `string` | required | The title. |\n| `visible` | `boolean` | `true` | `false` keeps it as the accessible name but hides it visually. |\n| `level` | `2 \\| 3 \\| 4 \\| 5 \\| 6` | `3` | The heading level, to fit the page's outline. |\n\n## Encoding (line, area, bar)\n\nLong rows name one `y` and a `series`; wide rows give `y` as a list and no `series`. The two forms are exclusive. One series needs only a single `y`.\n\n<!-- options: Encoding -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `x` | `XField<Row>` | required | The x field: a key, or an [x field object](#x-fields). |\n| `y` | `ValueField<Row> \\| readonly ValueField<Row>[]` | required | The value field, or one field per series. See [Value fields](#value-fields). The first field sets the shared value axis's domain and scale. |\n| `series` | `SeriesKey<Row>` | none | The field whose value names and keys each row's series (long rows only). |\n\n## Cartesian options\n\nOn line, area, bar and scatter charts.\n\n<!-- options: CartesianOptions -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `zoom` | `boolean \\| 'touch'` | `true` | Zoom and pan, on date, time and number x axes only: a category axis and a compact chart never zoom. `'touch'` also takes pinch and two-finger drag on touch screens. |\n| `reference` | `readonly Reference[]` | none | Reference lines and bands. See [Reference](#reference). Not on compact charts. |\n\n### Reference\n\n<!-- options: Reference -->\n| Key | Type | Default | Meaning |\n|---|---|---|---|\n| `x` | `XValue \\| readonly [XValue, XValue]` | none | A line at an x value, or a band between two. |\n| `y` | `number \\| readonly [number, number]` | none | A line at a value, or a band between two. On a horizontal bar chart it runs up and down the plot. |\n| `label` | `string` | required | Shown beside the line or band, and listed in the summary and the table caption. |\n\nA reference widens the automatic value domain to include it. An author `domain` that leaves it out keeps it out of the drawing; the summary still lists it.\n\n## Compact\n\n<!-- options: CompactOption -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `compact` | `boolean` | `false` | Line, area and bar only. Marks only, as an image with a text alternative. See [Compact](compact.md). |\n\n## Area options\n\n<!-- options: AreaOptions -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `stacked` | `boolean` | `false` | Stack the series; the tooltip adds the total, or both totals when signs are mixed. |\n\n## Bar options\n\n<!-- options: BarOptions -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `layout` | `'grouped' \\| 'stacked'` | `'grouped'` | Several series side by side, or stacked. |\n| `horizontal` | `boolean` | `false` | Bars from the left, categories down the side. |\n\n## Scatter options\n\nScatter takes one `y` (never a list) and an x that is a number, an instant or a date.\n\n<!-- options: ScatterOptions -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `x` | `ScatterXField<Row>` | required | The x field: like an [x field](#x-fields), with `type` limited to `'number'`, `'time'` or `'date'`, and no `ordered`. |\n| `y` | `ValueField<Row>` | required | The value field. |\n| `series` | `SeriesKey<Row>` | none | The field that groups points into series. |\n\n## Donut options\n\n<!-- options: DonutOptions -->\n| Option | Type | Default | Meaning |\n|---|---|---|---|\n| `label` | `SeriesKey<Row>` | required | The field that names, and keys, each slice. |\n| `value` | `ValueField<Row>` | required | The value of each slice. Not negative. |\n\n## Value fields\n\nA value field is a key of `Row` whose values are numbers (or `null`), or an object. A key whose values are strings is accepted only in the object form with `parse: 'number'`.\n\n<!-- options: ValueField -->\n| Key | Type | Default | Meaning |\n|---|---|---|---|\n| `field` | `NumberKey<Row> \\| StringKey<Row>` | required | The key of the row: a number field, or a string field with `parse`. |\n| `parse` | `'number'` | none | The field holds numbers as strings; convert them to JavaScript numbers (exact for integers up to 9,007,199,254,740,991). |\n| `label` | `string` | the field name | Axis title, and the series name in tooltip, table and announcements. |\n| `unit` | `string` | none | Follows values in tooltip, table and announcements: `'ms'`, `'USD'`. |\n| `scale` | `'percent' \\| 'ratio'` | none | Percentage data: `'percent'` is 0–100, `'ratio'` is 0–1. Never inferred. |\n| `format` | `Intl.NumberFormatOptions \\| ((value: number) => string)` | the locale's grouping, the full integer part and up to six significant fraction digits | How values are written in tooltip, table and announcements. |\n| `tickFormat` | `Intl.NumberFormatOptions \\| ((value: number) => string)` | the locale's grouping, with the step's fraction digits; compact from a largest tick of one million, scientific from 10¹⁵ | How axis ticks are written. |\n| `missing` | `'gap' \\| 'zero'` | `'gap'` | What a missing value means. `'zero'` is for counts where absence means none. |\n| `domain` | `readonly [number, number]` | from the data | Author bounds. On bar and area, widened to include zero (AX110). In a wide chart only the first field's applies. |\n\n## X fields\n\nAn x field is a key of `Row` whose values are numbers, strings or `Date`s, or an object.\n\n<!-- options: XField -->\n| Key | Type | Default | Meaning |\n|---|---|---|---|\n| `field` | `XKey<Row>` | required | The key of the row. |\n| `type` | `'number' \\| 'time' \\| 'date' \\| 'category'` | inferred | `'date'`: calendar dates; `'time'`: instants; numbers are never inferred to be instants. See [how Axylo decides](data.md#how-axylo-decides). |\n| `ordered` | `boolean` | `false` | Category axes: the categories have a natural order, so labels may be thinned when they do not fit. |\n| `timeZone` | `'local' \\| 'UTC' \\| (string & {})` | `'local'` | For instants: the zone they are shown in. `'local'` is the viewer's; otherwise `'UTC'` or an IANA zone name. |\n| `label` | `string` | the field name | Axis title of a number axis; a date, time or category axis is titled only when you give one. |\n| `unit` | `string` | none | Follows x values in tooltip, table and announcements. |\n| `format` | `Intl.DateTimeFormatOptions \\| Intl.NumberFormatOptions \\| ((value: XValue) => string)` | from the kind of x | How x values are written in tooltip, table and announcements. |\n| `tickFormat` | `Intl.DateTimeFormatOptions \\| Intl.NumberFormatOptions \\| ((value: XValue) => string)` | from the kind of x | How x ticks are written. |\n| `domain` | `readonly [XValue, XValue]` | from the data | Author bounds for x. |\n\nFor scatter charts the x field takes the same keys except `ordered`, and `type` without `'category'`:\n\n<!-- options: ScatterXField -->\n| Key | Type | Default | Meaning |\n|---|---|---|---|\n| `field` | `XKey<Row>` | required | As above. |\n| `type` | `'number' \\| 'time' \\| 'date'` | inferred | No `'category'`: a scatter relates two measures. |\n| `timeZone` | `'local' \\| 'UTC' \\| (string & {})` | `'local'` | As above. |\n| `label` | `string` | the field name | As above. |\n| `unit` | `string` | none | As above. |\n| `format` | `Intl.DateTimeFormatOptions \\| Intl.NumberFormatOptions \\| ((value: XValue) => string)` | from the kind of x | As above. |\n| `tickFormat` | `Intl.DateTimeFormatOptions \\| Intl.NumberFormatOptions \\| ((value: XValue) => string)` | from the kind of x | As above. |\n| `domain` | `readonly [XValue, XValue]` | from the data | As above. |\n\n## The chart handle\n\nEvery chart function returns a `Chart<Row, Options>`.\n\n<!-- options: Chart -->\n| Member | Type | Meaning |\n|---|---|---|\n| `update` | `(patch: Partial<Options>) => void` | Change options: a present key replaces, `undefined` restores the default, an absent key stays. See [Updating](updating.md#update-change-options). |\n| `append` | `(rows: readonly Row[], options?: { keep?: number }) => void` | Add rows at the end. |\n| `zoom` | `(domain: readonly [XValue, XValue] \\| null) => void` | Set the visible x range; `null` shows everything. Where the chart does not zoom (a category axis, a donut, a compact chart), it changes nothing and reports [AX150](diagnostics.md#ax150). |\n| `on` | `<E extends keyof ChartEvents<Row>>(event: E, listener: (payload: ChartEvents<Row>[E]) => void) => () => void` | Listen to `hover`, `select` or `zoom`; returns a function that removes the listener. |\n| `diagnostics` | `readonly Diagnostic[]` | Diagnostics for the current options and data, current as soon as a call returns. |\n| `destroy` | `() => void` | Remove the chart and everything it attached. Later calls do nothing. |\n\n### append options\n\n<!-- options: AppendOptions -->\n| Key | Type | Default | Meaning |\n|---|---|---|---|\n| `keep` | `number` | every row | The number of distinct x values to retain; older ones are dropped. |\n\n### Events\n\n<!-- options: ChartEvents -->\n| Event | Type | Meaning |\n|---|---|---|\n| `hover` | `Point<Row> \\| null` | The datum under the pointer or the keyboard's point; `null` when nothing is picked. |\n| `select` | `Point<Row>` | The reader clicked a point, or pressed Enter or Space on it. |\n| `zoom` | `readonly [XValue, XValue] \\| null` | A `zoom()` call or the reader changed the visible range; `null` for the whole range. Not sent when the view moves with appended data. |\n\n<!-- options: Point -->\n| Point key | Type | Meaning |\n|---|---|---|\n| `series` | `string` | The series key: the `series` value for long rows, the field name for wide rows, the slice label on a donut. |\n| `x` | `XValue` | In the form `zoom()` accepts: a `Date` for an instant, `'YYYY-MM-DD'` for a calendar date, an ISO date-time without offset for a wall-clock time, the category, otherwise the number. |\n| `y` | `number \\| null` | The value; `null` for no data. |\n| `row` | `Row \\| null` | Your row; with typed columns, an object built from the columns at that index; `null` for a position no row holds. |\n| `index` | `number` | The row's index in your data; `-1` when `row` is `null`. |\n\n### Diagnostic\n\n<!-- options: Diagnostic -->\n| Key | Type | Meaning |\n|---|---|---|\n| `code` | `` `AX${number}` `` | Stable code, with a page under [Diagnostics](diagnostics.md). |\n| `level` | `'error' \\| 'warning' \\| 'hint'` | See [levels](diagnostics.md#levels-and-who-is-told). |\n| `message` | `string` | What is wrong, where, and how to fix it. |\n| `chart` | `string` | The chart's title, else its element id. |\n| `field` | `string` | The field or option, when it is about one. |\n| `rows` | `readonly number[]` | The first offending rows in your data, at most ten, when it is about rows. |\n| `count` | `number` | How many values or rows in all, when it counts them. |\n\n## validate\n\n`validate(type, options)` takes `'line'`, `'area'`, `'bar'`, `'scatter'` or `'donut'` and that type's options, runs the checks a created chart runs from its call without a DOM, and returns `Diagnostic[]`. It cannot find what needs a page: contrast, sizes, label fitting, formatters, or whether a `labelledBy` id exists. See [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\n\n## Messages\n\nEvery message the chart shows the reader can be replaced through `messages`: the notes, states, controls, the table's labels, the generated name and summary. Diagnostics for developers keep the registry's English wording. Placeholders in braces are filled in by the chart; an override should keep the ones it needs. `{seeTable}` is filled with `seeTable` when the chart has a table and removed when it does not (`table: false`), so a translated note that keeps it reads right either way:\n\n[example: messages-translated](../examples/messages-translated.ts)\n\nEvery key, with its built-in English text, read from the library when this site is built, and where the chart shows it:\n\n[table: messages](../../../packages/axylo/src/messages/index.ts)\n\n## Options that do not exist\n\nThere is no `width`, `height`, `responsive`, `theme`, `palette` or `animation` option. Size comes from the container, colours from [CSS](theming.md), and motion from the reader's settings: the first render is not animated, and nothing moves under reduced motion. Each of these names, like any unknown key, is ignored with [AX150](diagnostics.md#ax150), which suggests the closest known option.\n# Diagnostics\n\nAfter this page you can read an Axylo diagnostic, collect diagnostics in your own code, make a chart throw on them, and check a chart's data in Node or in a test before anything is drawn. Every code has its own page, listed at the end.\n\n## Reading one\n\nWhen Axylo cannot draw something as given, it prints one line to the console:\n\n[output: AX103](../data/diagnostics.mjs)\n\n| Part | Here |\n|---|---|\n| Code | `AX103`. Stable across releases; each has a page. |\n| Chart | `\"Conversion\"`: the chart's title, or its element id when it has none. |\n| What and where | The field, how many values, and the first rows (up to ten), numbered in your own data as you passed it. A diagnostic about the chart as a whole (no name, too many series, low contrast) has no field and no rows. |\n| Fix | What to change. |\n| Outcome | What the chart did instead: here, gaps. |\n\n## Levels and who is told\n\n| Level | Means | Console |\n|---|---|---|\n| Error | Something cannot be drawn as given: the chart, a series, or the donut. | Every build, once per code per page, with `console.warn` |\n| Warning | Something is not drawn as given, or an option is ignored. | Every build, once per code per page, with `console.warn` |\n| Hint | Advice for you. | Development builds only, with `console.info` |\n\nThe level says who is told; it does not by itself say what stays on screen. That depends on the code, and each code's page says it, with a checked minimal input. For example: an error about one series ([AX108](diagnostics.md#ax108)) leaves the other series drawn; a warning can put the chart in its error state when the ignored option was needed to draw at all (a `y` list on a scatter chart, [AX150](diagnostics.md#ax150)); and some hints come with a visible change: an inferred missing step is drawn as a gap ([AX105](diagnostics.md#ax105)), a plot too small to draw is replaced by its summary ([AX142](diagnostics.md#ax142)), hidden labels get a note ([AX143](diagnostics.md#ax143)).\n\nWhen values were left out or changed, the chart shows the reader a note in the figure (\"Values not shown: 3. See table.\", or \"Values shown differently from the data\"), in every build, and in the accessibility tree.\n\n## Collecting them in your code\n\nEach diagnostic is an object:\n\n```ts\ninterface Diagnostic {\n  code: `AX${number}`;           // 'AX103'\n  level: 'error' | 'warning' | 'hint';\n  message: string;               // what is wrong, where, and how to fix it\n  chart: string;                 // the chart's title, else its element id\n  field?: string;                // when it is about a field\n  rows?: readonly number[];      // first rows, in your data, at most 10\n  count?: number;                // how many values or rows in all\n}\n```\n\n`chart.diagnostics` lists them for the current options and data, up to date as soon as a create, `update` or `append` returns. `onDiagnostic` is called once for each diagnostic the chart newly finds, in every build and at every level, so it is the place to send them to your error tracking. A listener that throws is reported once and otherwise ignored; it cannot break the chart.\n\n[example: diagnostics-listener](../examples/diagnostics-listener.html)\n\n## When they are found\n\nMost diagnostics are found while a call checks its input: the create, `update` or `append` call. Those are in `chart.diagnostics` when the call returns. A few can only be found later, while drawing: low contrast after the page's CSS changes ([AX141](diagnostics.md#ax141)), a plot too small ([AX142](diagnostics.md#ax142)), labels that stop fitting after a resize ([AX143](diagnostics.md#ax143)), more bars than pixels ([AX132](diagnostics.md#ax132)), a formatter that fails ([AX160](diagnostics.md#ax160)), a `labelledBy` that names no element when there is no `title` ([AX140](diagnostics.md#ax140)), and an internal failure ([AX199](diagnostics.md#ax199)). They are reported when found, through the same console line and `onDiagnostic`. A `zoom()` call that cannot apply (a category axis, a donut, a compact chart) is reported when it is made, through the console line and `onDiagnostic` only: it changes nothing, so `chart.diagnostics` does not list it ([AX150](diagnostics.md#ax150)).\n\n## Strict mode\n\n`strict: true` makes the chart throw on any error or warning found while checking a create, `update` or `append` call, synchronously from that call. The chart keeps its last valid state; a rejected create leaves nothing in the page. The error is named `AxyloStrictError`, and its `diagnostics` property has every diagnostic of the rejected call. Hints never throw, and neither do diagnostics found later while drawing. A failure while a call is being checked (such as a row getter that throws, [AX199](diagnostics.md#ax199)) rejects that call too, with AX199 after what it had found; a failure later, while drawing, is never thrown. Each code's page says whether a strict chart throws it. See the example in [Updating](updating.md#strict-mode).\n\n## validate() in Node and in tests\n\n`validate(type, options)` runs the same reading and checking as creating a chart (options, data, view, name) without a DOM, and returns the diagnostics a created chart would report from its call. It takes the same options as the chart type, so it type-checks the same way. Importing `axylo` in Node does not touch the DOM.\n\nUse it on a server, in a build step, or in a coding agent's loop:\n\n[source: examples/node/validate.ts](../examples/node/validate.ts)\n\nOr in a unit test, so that a change in the data a query returns fails the build instead of a dashboard:\n\n[source: examples/node/chart-data.test.ts](../examples/node/chart-data.test.ts)\n\nBoth files are type-checked and run by this documentation's own tests, against the packed package. The package's declarations refer to DOM types, so a TypeScript configuration for Node code needs `\"lib\": [\"ES2022\", \"DOM\"]` (or `skipLibCheck`). `validate()` cannot find what only a page can show: the diagnostics listed under \"When they are found\" need a browser. It can tell that a chart has neither `title` nor `labelledBy`, but not whether a `labelledBy` id exists.\n\n## Every code\n\n[table: diagnostic codes](../data/diagnostics.mjs)\n# Stability and releases\n\nAfter this page you know what Axylo promises between releases, which browsers and tools it supports, under what licence it ships, and what is not in 1.0.\n\n## Status\n\nThis documentation describes Axylo 1.0, which has not been released. The library in this repository is a pre-release (package version 0.0.0) and has not been published to npm. Until 1.0 is tagged, anything may change.\n\n## Versions\n\nAxylo follows semantic versioning:\n\n| Release | May contain |\n|---|---|\n| Patch (1.0.1) | Fixes that do not change documented behaviour, except to make it match the documentation. |\n| Minor (1.1.0) | New options, chart features and diagnostics, and deprecations. Nothing documented stops working. |\n| Major (2.0.0) | Removals and other breaking changes, at most one major version a year. |\n\n**Deprecation.** A deprecated API keeps working for at least one minor release and at least six months, and its documentation says what to use instead. The documented examples of the previous release must still compile and run against each release candidate.\n\n**What the promise covers.** The functions and types exported by `axylo` (declared in `packages/axylo/src/public.ts`), the diagnostic codes and their levels, the CSS custom properties documented on [Theming](theming.md), and the keys of `messages`. Match diagnostics on `code`; their messages are written for people.\n\n**What it does not cover.** The chart's internal DOM structure and class names, the custom properties listed as internal, the roles the plot uses to talk to assistive technology (chosen without screen-reader rehearsal, and changeable in a minor release if rehearsal shows a better pattern), and the exact pixels of the drawing.\n\n## Supported environments\n\nThese are the targets of 1.0 (spec section 2.3). What has been verified so far is listed after the table.\n\n| Dimension | 1.0 target |\n|---|---|\n| Browsers | The current and previous major versions of Chrome, Edge and Firefox, and of Safari on macOS and iOS. |\n| TypeScript | 5.4 and later. Plain JavaScript is fully supported; types are an aid, not a requirement. |\n| Frameworks | None needed. No adapter ships in 1.0; the library is called from any framework's mount and unmount hooks. |\n| Node | Importing `axylo` touches no DOM, and `validate()` runs there. Charts themselves need a browser. |\n| Text direction | Left-to-right pages. Right-to-left text renders, but the layout is not mirrored. |\n| Transformed ancestors | A chart inside a translated or scaled element (any positive scale, uniform or not) is exact. Inside a rotated, skewed or mirrored element it draws, but pointing and tooltip placement are wrong: not supported in 1.0. |\n| Built-in text | English. Reader-facing messages are replaceable through `messages`; diagnostics keep their English wording. |\n\nTested so far, on Linux: the library's acceptance tests in Chrome and in Playwright's builds of Firefox and WebKit (Playwright's WebKit, not Safari), and the distribution tests in Chrome (they install the packed package, also under a Content Security Policy). Safari itself, Edge, Windows, macOS and phones have not been tested. No screen-reader rehearsal was done for 1.0. What the acceptance checker recorded for this revision is on the [conformance page](conformance.md); see also [Accessibility](accessibility.md#what-has-and-has-not-been-verified).\n\n## Known limits\n\nThese are known in 1.0 and not fixed in it. Each says what you would see.\n\n- **Closed shadow roots.** In a chart inside a closed shadow root, Escape can be taken by another chart on the page instead of this one. When the chart sits behind a slot inside a closed root, the wrapper around that slot can cut off its tooltip.\n- **A dense ring of scatter points.** Thousands of points packed in a ring just outside the distance at which points count as being at the same place (half a pixel) can make hovering over that spot slow.\n- **A formatter that fails only sometimes.** A formatter that throws for a value on one call and returns text on another can leave [AX160](diagnostics.md#ax160) reported beside a label that reads normally.\n- **CSS aimed at the plot's own column.** The readout strip is measured outside the plot's column, so CSS that applies only inside that column (a container query on it, for example) is not taken into account. A small plot can then show no readout although the strip would fit.\n- **A hold that starts early.** When only the tooltip's size or position changes while the pointer rests on a datum, the rest already spent counts towards the new one, so the hold can begin before a quarter of a second has passed.\n- **One language for the focused point.** The plot's value text is marked with one language, even when the messages it is built from are not all in the same language (some translated, others built in).\n- **Patterns in compact bar charts.** Neighbouring series always differ by fill pattern, but series further apart can share one, since there are four, and then differ by colour only.\n- **Very small numbers.** On an axis of values around 1e-43 or smaller, ticks can be missing or not match their labels.\n- **The end labels of a scatter chart's x axis.** That axis ends on a drawn tick at each end (spec F7) and reserves no extra room for the labels there, so long tick labels are wrapped or rotated to fit rather than left out. On a narrow plot the axis can take a coarser, wider range so that its ends are ticks.\n\n## Size and memory\n\nThe size targets of 1.0, set by the owner after measuring the built library: 116 KiB gzipped for a page that uses everything, and 98 KiB for a page that uses only `line`, the stylesheet included. They are not a release gate yet. The last measurement (`npm run size`, which measures the packed files the way a bundler would):\n\n[table: sizes](../../../bench/size-latest.json)\n\nMemory: once a chart opened on typed columns has been appended to, Axylo keeps its own exact copy of x and y and one state byte per point, 17 bytes per point against the 16 of your two `Float64Array` columns. The memory budget of 1.0 is therefore 1.1 times the size of your two columns, for 1,000,000 points, with no upward trend over 1,000 cycles of create and destroy. This documentation shows no memory measurement. A chart that is never appended to reads typed columns in place where it can (see [what Axylo reads, keeps and copies](data.md#what-axylo-reads-keeps-and-copies)).\n\n## Licence\n\nMIT, for everything: zoom, accessibility and every chart type included. There is no commercial edition and no feature behind a licence key. The library has no runtime dependencies; third-party notices, if any, are checked at each release.\n\n## What is not in 1.0\n\nNot planned for 1.0, with the reason it can wait:\n\n| Not in 1.0 | Why it can wait |\n|---|---|\n| More chart types (histogram first, then heatmap, box plot, candlestick, radar, treemap, sankey, gauge, maps) | Each must pass the same acceptance criteria as the five types in 1.0. |\n| Log and other non-linear scales | They need their own rules for zero and negative values. |\n| A second y axis | Often misleading; it needs a design that keeps the zero baseline honest. |\n| Annotations beyond reference lines and bands | Placing free text interacts with label fitting. |\n| Linked charts (shared cursor, brush) | Needs a small coordination API. |\n| Export to PNG, SVG or CSV, and print styling | CSV from the table view comes first. |\n| Server-side rendering to SVG | The drawing model makes it possible later. |\n| Right-to-left layout mirroring | Stated as a limit in 1.0. |\n| Quarters and ISO weeks as calendar periods | Treat them as ordered categories in 1.0. |\n| Nested field paths (`'user.country'`) | Flatten rows before passing them. |\n| Framework adapters (React, Vue, Svelte, Angular) and a custom element | Thin wrappers over the same handle; until then a chart is created and destroyed from the framework's own hooks (see [Getting started](getting-started.md#using-axylo-in-a-framework)). |\n| A plugin or custom-mark API | Waits until two real uses show its shape. |\n| Translations of built-in text | `messages` makes reader-facing ones possible; only English ships. |\n| Workers, WebGL or WebGPU | Decided from measurements. |\n\nNot the audience for 1.0: analysts exploring data in notebooks, designers building bespoke graphics, and teams that need maps, financial charts or network diagrams.\n# Conformance table\n\nAfter this page you know which WCAG 2.2 success criteria the specification cites, what Axylo does for each, what evidence was recorded for them when this site was built, why no test covers the other level A and AA criteria, and what that evidence cannot show.\n\nThis page is generated each time the site is built, from the specification's criterion rows and from the report of the acceptance checker. It says only what they record; where they record nothing, it says \"not recorded\". It is not a claim that a page using Axylo conforms: conformance belongs to a whole page, and the page is yours.\n\n## What the evidence can and cannot show\n\n- **Automated checks only.** The acceptance tests check structure: names, roles, focus order, contrast, sizes and text. They do not show that a person using a screen reader understands a chart.\n- **No screen-reader rehearsal was done for 1.0.** No screen reader has been run against these charts, so nothing in this documentation says what a screen reader speaks.\n- **No usability testing with disabled people.** Axylo is built by one person with no access to study participants, and no claim of usability testing with disabled users is made.\n- **Engines, not browsers.** Browser results are recorded per engine: Chrome, and Firefox and WebKit as built by Playwright. WebKit results are Playwright's WebKit, not Safari. Nothing has been run on a phone.\n- **Right-to-left pages.** Right-to-left text renders, but the chart's layout is not mirrored.\n- **Transformed ancestors.** A chart inside a translated or scaled element is exact. Inside a rotated, skewed or mirrored element it draws, but pointing and tooltip placement are wrong; that is not supported in 1.0.\n\n## What you must supply\n\nAxylo can only describe what it is given. A chart needs a meaningful name (`title`, or `labelledBy` pointing at your heading), series names, units on value fields, and the page's own structure around it. A compact chart fed by `append` has no Pause control, since it has no toolbar: a page that streams into compact tiles must give the reader its own way to pause them (WCAG 2.2.2). [Accessibility](accessibility.md#what-you-must-supply) has the details.\n\n## The criteria the specification cites\n\n[table: conformance](../../../acceptance/check.mjs)\napps/docs/lib/site.mjs:7: * - The stylesheet, the script-tag file and `validate()` come from the installed tarball. Two inputs are read\napps/docs/lib/site.mjs:546: * `validate()`, so the page shows the message exactly as the library writes it; the others need a page\napps/docs/lib/site.mjs:579:    ? 'Checked with <code>validate()</code> from the packed package when this site was built; the message is its output.'\napps/docs/pages/stability.md:34:| Node | Importing `axylo` touches no DOM, and `validate()` runs there. Charts themselves need a browser. |\napps/docs/pages/data.md:164:`validate(type, options)` runs the same reading and checking as a chart, without a page, and returns the diagnostics. Use it in Node, in a unit test, or in a coding agent's loop before rendering. See [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\napps/docs/data/diagnostics.mjs:8://   expression calling `validate()`; the build runs it against the packed package (the page shows its output)\napps/docs/data/diagnostics.mjs:29:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:44:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:59:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:74:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:89:    input: `validate('bar', {\napps/docs/data/diagnostics.mjs:104:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:122:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:137:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:152:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:167:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:182:    input: `validate('bar', {\napps/docs/data/diagnostics.mjs:197:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:216:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:231:    input: `validate('donut', {\napps/docs/data/diagnostics.mjs:246:    input: `validate('donut', {\napps/docs/data/diagnostics.mjs:261:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:278:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:311:    input: `validate('scatter', {\napps/docs/data/diagnostics.mjs:326:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:340:    fix: 'Give a `title`, or, when the card around the chart already has a heading, its id: `labelledBy: \\'card-heading\\'`. A title can be hidden visually with `title: { text: \\'…\\', visible: false }`. `validate()` can only check that one of them is given; whether the id exists is checked in the page.',\napps/docs/data/diagnostics.mjs:342:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:371:    fix: 'Give the container more room, or use `compact: true` for a sparkline in a small tile. `validate()` cannot find this: it needs the page\\'s sizes.',\napps/docs/data/diagnostics.mjs:408:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:420:        input: `validate('line', {\napps/docs/data/diagnostics.mjs:431:        input: `validate('line', {\napps/docs/data/diagnostics.mjs:443:        input: `validate('donut', {\napps/docs/data/diagnostics.mjs:454:        input: `validate('line', {\napps/docs/data/diagnostics.mjs:465:        input: `validate('line', {\napps/docs/data/diagnostics.mjs:478:        input: `validate('line', {\napps/docs/data/diagnostics.mjs:490:        input: `validate('scatter', {\napps/docs/data/diagnostics.mjs:564:    input: `validate('line', {\napps/docs/data/diagnostics.mjs:609:    input: `validate('line', {\napps/docs/pages/diagnostics.md:59:## validate() in Node and in tests\napps/docs/pages/diagnostics.md:61:`validate(type, options)` runs the same reading and checking as creating a chart (options, data, view, name) without a DOM, and returns the diagnostics a created chart would report from its call. It takes the same options as the chart type, so it type-checks the same way. Importing `axylo` in Node does not touch the DOM.\napps/docs/pages/diagnostics.md:71:Both files are type-checked and run by this documentation's own tests, against the packed package. The package's declarations refer to DOM types, so a TypeScript configuration for Node code needs `\"lib\": [\"ES2022\", \"DOM\"]` (or `skipLibCheck`). `validate()` cannot find what only a page can show: the diagnostics listed under \"When they are found\" need a browser. It can tell that a chart has neither `title` nor `labelledBy`, but not whether a `labelledBy` id exists.\napps/docs/test/diagnostics.test.ts:10: * prints from); and each input that runs in Node, minimal or not, raises its code through validate(), with\napps/docs/pages/getting-started.md:17:TypeScript 5.4 or later gives you checked field names. The package's declarations refer to DOM types (`HTMLElement`), so a TypeScript project needs the `DOM` library in `lib`, also for code that only calls `validate()` in Node. Plain JavaScript works the same without types.\napps/docs/pages/getting-started.md:77:**3. Check the values without drawing.** `validate()` runs the same checks as creating the chart, in Node or in a test, with the same options as the chart:\napps/docs/pages/getting-started.md:82:const problems = validate('line', { title: 'Monthly visitors', data: rows, x: 'month', y: 'visitors' });\napps/docs/pages/options.md:230:`validate(type, options)` takes `'line'`, `'area'`, `'bar'`, `'scatter'` or `'donut'` and that type's options, runs the checks a created chart runs from its call without a DOM, and returns `Diagnostic[]`. It cannot find what needs a page: contrast, sizes, label fitting, formatters, or whether a `labelledBy` id exists. See [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\napps/docs/test/diagnostics.browser.test.ts:7: *   a chart with the packed script-tag file (an input written for `validate()` becomes the same call to the\napps/docs/test/markdown.test.ts:61:    expect(slug('validate() in Node and in tests')).toBe('validate-in-node-and-in-tests');\napps/docs/examples/node/validate.ts:1:// Runs in Node, on a server or in a build step: validate() needs no DOM.\napps/docs/examples/node/validate.ts:10:const problems = validate('bar', {\napps/docs/examples/node/chart-data.test.ts:15:    const problems = validate('line', options);\n","exit_code":0,"status":"completed"}}
