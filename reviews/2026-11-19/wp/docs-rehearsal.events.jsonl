{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { createRequire } from 'node:module';\nimport { pathToFileURL } from 'node:url';\nimport { resolve } from 'node:path';\n\nconst require = createRequire(resolve('apps/docs/.cache/consumer/package.json'));\nconst { validate } = await import(pathToFileURL(require.resolve('axylo')));\nconst script = /<script type=\\\"module\\\">([\\\\s\\\\S]*?)<\\\\/script>/.exec(readFileSync('apps/docs/examples/mixed-numbers.html', 'utf8'))[1];\nconst data = {};\nconst line = (selector, options) => {\n  assert.deepEqual(validate('line', options).map(({ code, level, count, rows }) => [code, level, count, rows]),\n    [['AX106', 'warning', 1, selector === '#raw' ? [1] : [3]]]);\n  data[selector] = options.data.map(row => row.revenue);\n};\nnew Function('line', script.replace(\\\"import { line } from 'axylo';\\\", ''))(line);\nassert.deepEqual(data, { '#raw': [1250, '1340.5', 980], '#normalized': [1250, 1340.5, 980, '0x10'] });\nconsole.log('Both mixed-number example inputs return one AX106 at the expected row in the packed library.');\nJS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
