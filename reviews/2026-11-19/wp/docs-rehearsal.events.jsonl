essages/index.ts',\napps/docs/lib/site.mjs:45:const SOURCE_ROOTS = ['examples/first-chart/', 'research/harness/src/libs/', 'apps/docs/examples/'];\napps/docs/lib/site.mjs:48:export async function importSource(relative) {\napps/docs/lib/site.mjs:59:function gitRevision() {\napps/docs/lib/site.mjs:70: * The installed files and the source the build also reads (the built-in messages and the registry's\napps/docs/lib/site.mjs:78:async function checkSameRevision(css, bundle, { unchecked = false, log = () => {} } = {}) {\napps/docs/lib/site.mjs:98:  return { messages: (await importSource('packages/axylo/src/messages/index.ts')).defaultMessages, problems };\napps/docs/lib/site.mjs:106:export async function stageSite(outDir, writeSite) {\napps/docs/lib/site.mjs:119: * someone else's rebuild is pending), to check the pages, links and generated tables. Such a build goes to\napps/docs/lib/site.mjs:122:export async function buildSite({ outDir, log = () => {}, uncheckedLibrary = false } = {}) {\napps/docs/lib/site.mjs:130:  const { messages, problems: unchecked } = await checkSameRevision(css, bundle, { unchecked: uncheckedLibrary, log });\napps/docs/lib/site.mjs:134:    for (const dir of ['assets', 'examples/js', 'diagnostics', 'source']) fs.mkdirSync(path.join(tmp, dir), { recursive: true });\napps/docs/lib/site.mjs:137:    for (const file of ['axylo.iife.js', 'axylo.iife.min.js', 'axylo.css']) fs.copyFileSync(path.join(lib, 'dist', file), path.join(tmp, 'examples', file));\napps/docs/lib/site.mjs:138:    const examples = await buildExamples(tmp);\napps/docs/lib/site.mjs:141:    const { messageUses } = await import(pathToFileURL(path.join(docsRoot, 'data/messages.mjs')).href + `?t=${Date.now()}`);\napps/docs/lib/site.mjs:147:      outDir: tmp, examples, diagnostics, seen, tokens, internalTokens, messages, messageUses, theme, warnings, version, revision,\napps/docs/lib/site.mjs:158:    // Example sources and helpers are linked from every example block; publish them all.\napps/do