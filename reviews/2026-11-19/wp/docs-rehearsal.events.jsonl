{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,120p' apps/docs/test/site.browser.test.ts\nsed -n '1,115p' apps/docs/test/examples.browser.test.ts\nsed -n '30,71p' apps/docs/lib/site.mjs\nsed -n '32,92p' apps/docs/lib/examples.mjs\nrg -n '\\\\.table-scroll|tbody|tr:|table.*(empty|child)' apps/docs/site/site.css apps/docs/site/*.js\"","aggregated_output":"/**\n * The built site itself, in system Chrome, served from its own directory (the deployment root, so a link that\n * leaves it fails): every page loads without console errors or failed requests, does not scroll sideways on a\n * phone, names its example frames, and has no axe-core violations of its own (the charts inside the frames are\n * the library's, and are checked by the library's own accessibility tests). Source pages are sampled.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { createRequire } from 'node:module';\nimport { chromium, type Browser } from 'playwright-core';\nimport { buildSite } from '../lib/site.mjs';\nimport { docsRoot, repoRoot } from '../lib/examples.mjs';\nimport { serve } from '../lib/serve.mjs';\nimport { pages } from '../data/nav.mjs';\nimport { diagnostics } from '../data/diagnostics.mjs';\n\nconst axe = fs.readFileSync(createRequire(path.join(repoRoot, 'package.json')).resolve('axe-core/axe.min.js'), 'utf8');\nlet server: Awaited<ReturnType<typeof serve>>;\nlet browser: Browser;\n\nbeforeAll(async () => {\n  await buildSite();\n  server = await serve(path.join(docsRoot, 'dist'));\n  browser = await chromium.launch({ channel: 'chrome', headless: true });\n}, 180_000);\n\nafterAll(async () => {\n  await browser?.close();\n  await server?.close();\n});\n\nconst all = [\n  ...pages.map(p => `${p.page}.html`),\n  ...diagnostics.map(d => `diagnostics/${d.code}.html`),\n  'source/docs/decisions/0003-default-palette.md.html',\n  'source/research/harness/src/libs/chartjs.js.html',\n];\n\ndescribe('site pages', () => {\n  it.each(all)('%s', async file => {\n    for (const [width, scheme] of [[390, 'dark'], [1280, 'light']] as const) {\n      const context = await browser.newContext({ viewport: { width, height: 900 }, colorScheme: scheme, locale: 'en-US' });\n      const page = await context.newPage();\n      const errors: string[] = [];\n      page.on('console', m => { if (m.type() === 'error') errors.push(m.text()); });\n      page.on('pageerror', e => errors.push(e.message));\n      page.on('response', r => { if (r.status() >= 400) errors.push(`HTTP ${r.status()} ${r.url()}`); });\n      await page.goto(server.url(file));\n      const frames = await page.evaluate(() => [...document.querySelectorAll('iframe')].map(f => f.title));\n      expect(frames.every(title => title.startsWith('Live example: ')), 'every frame has a title').toBe(true);\n      const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);\n      expect(overflow, `${file} at ${width} px scrolls sideways`).toBeLessThanOrEqual(0);\n      await page.addScriptTag({ content: axe });\n      const violations = await page.evaluate(async () => {\n        const axeGlobal = (window as unknown as { axe: { run(context: unknown, options: unknown): Promise<{ violations: { id: string; nodes: { target: string[] }[] }[] }> } }).axe;\n        const result = await axeGlobal.run({ exclude: [['iframe']] }, { iframes: false, resultTypes: ['violations'] });\n        return result.violations.map(v => `${v.id}: ${v.nodes.map(n => n.target.join(' ')).slice(0, 3).join(', ')}`);\n      });\n      expect(violations, `${file} at ${width} px, ${scheme}`).toEqual([]);\n      expect(errors, `${file} errors`).toEqual([]);\n      await context.close();\n    }\n  }, 60_000);\n});\n/**\n * Criterion DX10: every runnable example in the documentation is compiled and rendered from the packed\n * distribution. Run after `npm run build`:\n *\n *   AXYLO_BROWSER=1 npx vitest run --config apps/docs/vitest.config.ts apps/docs/test/examples.browser.test.ts\n *\n * 1. The site build packs both packages with `npm pack` and installs the tarballs into a clean consumer\n *    (apps/docs/lib/consumer.mjs, as tests/dist does), copies the examples into it, and bundles them from\n *    there with esbuild under the `development` condition; nothing may resolve outside the consumer.\n * 2. This test type-checks every example in the consumer, strictly, against the installed declarations with\n *    library checking on, and fails if TypeScript read any declaration from outside the consumer.\n * 3. It opens each example's page in system Chrome and checks: the expected number of charts; every chart has\n *    an accessible name, and draws marks unless the example says it draws none on purpose (then it must show\n *    a state message and no marks); no console error, warning or page error, and no failed request; the\n *    diagnostics printed are exactly the ones the example says it raises on purpose; and the example's own\n *    check (test/example-checks.ts): a value from its data, and the interaction it teaches.\n *\n * Examples run in America/Los_Angeles, where an instant at UTC midnight is the previous evening, at 760 px.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport { execFileSync } from 'node:child_process';\nimport path from 'node:path';\nimport { chromium, type Browser, type Page } from 'playwright-core';\nimport { buildSite } from '../lib/site.mjs';\nimport { docsRoot, listExamples, repoRoot } from '../lib/examples.mjs';\nimport { consumerDir, listFilesOutside, writeConsumerTsconfigs } from '../lib/consumer.mjs';\nimport { serve } from '../lib/serve.mjs';\nimport { checks, type Tools } from './example-checks';\n\nconst examples = listExamples();\nlet server: Awaited<ReturnType<typeof serve>>;\nlet browser: Browser;\n\n/** Runs tsc in the consumer; returns its errors and the files it read from outside the consumer. */\nfunction typecheck(config: string, allowed: string[] = []): { errors: string; outside: string[] } {\n  // Through node itself, so the same call works on Windows, where node_modules/.bin/tsc is a shell script.\n  const tsc = path.join(repoRoot, 'node_modules/typescript/bin/tsc');\n  try {\n    const listing = execFileSync(process.execPath, [tsc, '-p', config, '--listFiles'], { cwd: consumerDir, encoding: 'utf8', stdio: 'pipe' });\n    return { errors: '', outside: listFilesOutside(listing, allowed) };\n  } catch (error) {\n    const e = error as { stdout?: string; stderr?: string };\n    const out = `${e.stdout ?? ''}${e.stderr ?? ''}`;\n    return { errors: out.split('\\n').filter(l => /error TS/.test(l)).join('\\n') || out || String(error), outside: [] };\n  }\n}\n\nbeforeAll(async () => {\n  await buildSite();\n  server = await serve(path.join(docsRoot, 'dist'));\n  browser = await chromium.launch({ channel: 'chrome', headless: true });\n}, 180_000);\n\nafterAll(async () => {\n  await browser?.close();\n  await server?.close();\n});\n\ndescribe('examples type-check in the packed consumer', () => {\n  it('browser examples: .ts strict, .html scripts strict under checkJs, library checking on', () => {\n    const { browser: config } = writeConsumerTsconfigs();\n    const result = typecheck(config);\n    expect(result.errors).toBe('');\n    expect(result.outside, 'declarations read from outside the consumer').toEqual([]);\n  });\n  it('Node examples (DOM types in lib, as the Diagnostics page says)', () => {\n    const { node: config } = writeConsumerTsconfigs();\n    // The test example imports Vitest, a tool the consumer does not install.\n    const result = typecheck(config, ['vitest', '@vitest', 'chai', '@types/chai', '@types/deep-eql', 'expect-type', 'tinyrainbow', '@standard-schema', 'vite', 'tinybench', 'tinyexec', 'pathe', '@types/estree', 'rollup', 'esbuild', 'postcss', 'source-map-js', 'nanoid', 'picocolors', 'lightningcss', 'rolldown', '@rolldown', '@oxc-project', 'obug', 'std-env', 'magic-string', '@jridgewell', 'estree-walker', 'fdir', 'picomatch', 'tinyglobby', 'es-module-lexer', 'why-is-node-running', 'detect-libc', 'assertion-error', '@types/node', 'undici-types']);\n    expect(result.errors).toBe('');\n    expect(result.outside.filter(f => /[\\\\/]node_modules[\\\\/]axylo[\\\\/]/.test(f) || /packages[\\\\/]axylo[\\\\/]/.test(f))).toEqual([]);\n  });\n});\n\nfunction tools(page: Page): Tools {\n  const figure = (i: number) => page.locator('figure.axylo-figure').nth(i);\n  return {\n    page,\n    async value(i, keys) {\n      await figure(i).locator('.axylo-proxy').focus();\n      for (const key of keys) await page.keyboard.press(key);\n      await page.waitForTimeout(80);\n      return (await figure(i).locator('.axylo-proxy').getAttribute('aria-valuetext')) ?? '';\n    },\n    desc: i => figure(i).evaluate(f => (f.getAttribute('aria-describedby') ?? '').split(/\\s+/).map(id => document.getElementById(id)?.textContent ?? '').join(' ')),\n    name: i => figure(i).evaluate(f => f.getAttribute('aria-label') ?? (f.getAttribute('aria-labelledby') ?? '').split(/\\s+/).map(id => document.getElementById(id)?.textContent ?? '').join(' ').trim()),\n    note: i => figure(i).evaluate(f => [...f.querySelectorAll('.axylo-note')].filter(e => !(e as HTMLElement).hidden).map(e => e.textContent).join('')),\n    message: i => figure(i).evaluate(f => [...f.querySelectorAll('.axylo-message')].filter(e => !(e as HTMLElement).hidden).map(e => e.textContent).join('')),\n    legend: i => figure(i).evaluate(f => [...f.querySelectorAll('.axylo-legend-list li')].map(e => e.textContent ?? '')),\n    toolbar: i => figure(i).evaluate(f => [...f.querySelectorAll('.axylo-toolbar button')].map(e => e.textContent ?? '')),\n    async table(i) {\n      const open = figure(i).locator('.axylo-toolbar button', { hasText: /table|Tabelle/i }).first();\n      if ((await open.getAttribute('aria-expanded')) !== 'true') await open.click();\n      await page.waitForTimeout(100);\n      return figure(i).evaluate(f => [...f.querySelectorAll('.axylo-table tbody tr')].map(r => [...r.children].map(c => c.textContent).join(' | ')));\n    },\n    text: selector => page.locator(selector).first().evaluate(e => e.textContent ?? ''),\n    async click(selector) { await page.locator(selector).first().click(); },\n    stroke: (i, k) => figure(i).evaluate((f, k) => {\n      const paths = [...f.querySelectorAll('svg.axylo-svg path[style*=\"--axylo-series-color\"]')].filter(p => getComputedStyle(p).fill === 'none');\n      return paths[k] ? getComputedStyle(paths[k]!).stroke : '';\n    }, k),\n    async until(fn, timeout = 8000) { await page.waitForFunction(fn, null, { timeout }); },\n  };\n}\n\ndescribe('examples render in Chrome from the packed packages', () => {\n  it('every example has its own check, and every check an example', () => {\n    expect(examples.map(e => e.name).filter(name => !(name in checks))).toEqual([]);\n    expect(Object.keys(checks).filter(name => !examples.some(e => e.name === name))).toEqual([]);\n  });\n\n  it.each(examples.map(example => [example.repoFile, example] as const))('%s', async (_file, example) => {\n    const context = await browser.newContext({ viewport: { width: 760, height: 900 }, locale: 'en-US', timezoneId: 'America/Los_Angeles' });\n    const page = await context.newPage();\nconst pagesDir = path.join(docsRoot, 'pages');\nconst siteDir = path.join(docsRoot, 'site');\nconst HEX = /^#[0-9a-f]{3,8}$/i;\n\n/** Generated tables, and the one file each `[table: …](target)` directive must name. */\nconst TABLES = {\n  'diagnostic codes': 'apps/docs/data/diagnostics.mjs',\n  'theme tokens': 'apps/docs/data/tokens.mjs',\n  'internal tokens': 'apps/docs/data/tokens.mjs',\n  messages: 'packages/axylo/src/messages/index.ts',\n  palette: 'packages/axylo/src/theme/palette.ts',\n  conformance: 'acceptance/check.mjs',\n  sizes: 'bench/size-latest.json',\n};\n/** Where `[source: …]` may quote from. */\nconst SOURCE_ROOTS = ['examples/first-chart/', 'research/harness/src/libs/', 'apps/docs/examples/'];\n\n/** Bundles a TypeScript source of the library and imports it, to read data the built bundle does not export. */\nexport async function importSource(relative) {\n  const { DEVELOPMENT } = await import(pathToFileURL(path.join(repoRoot, 'scripts/build.mjs')).href);\n  const result = await build({\n    entryPoints: [path.join(repoRoot, relative)], bundle: true, format: 'esm', write: false, platform: 'neutral',\n    define: DEVELOPMENT, logLevel: 'silent',\n  });\n  return import('data:text/javascript;base64,' + Buffer.from(result.outputFiles[0].contents).toString('base64'));\n}\n\nexport { readThemeDefaults };\n\nfunction gitRevision() {\n  try {\n    const sha = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repoRoot, encoding: 'utf8' }).trim();\n    const dirty = execFileSync('git', ['status', '--porcelain'], { cwd: repoRoot, encoding: 'utf8' }).trim() !== '';\n    return { sha, short: sha.slice(0, 7), dirty };\n  } catch {\n    return { sha: 'unknown', short: 'unknown', dirty: true };\n  }\n}\n\n/**\n * The installed files and the source the build also reads (the built-in messages and the registry's\n * templates, which the bundle does not export) must be one revision. The check takes what it compares from\n/**\n * The first-chart snippets of the repository (examples/first-chart, maintained with the distribution tests)\n * also run on the site, under these names, so the Getting started page shows them live beside their source.\n */\nexport const EXTERNAL = [\n  { name: 'first-chart-npm', path: 'examples/first-chart/npm.ts' },\n  { name: 'first-chart-script', path: 'examples/first-chart/script.html' },\n];\n\nexport function listExamples() {\n  const own = fs.readdirSync(examplesDir)\n    .filter(file => /\\.(ts|html)$/.test(file) && !file.endsWith('.d.ts') && !file.startsWith('_'))\n    .sort()\n    .map(file => readExample(file));\n  const external = EXTERNAL.filter(e => fs.existsSync(path.join(repoRoot, e.path)))\n    .map(e => readExample(path.basename(e.path), path.join(repoRoot, path.dirname(e.path)), e.name));\n  return [...external, ...own];\n}\n\n/** Helper modules (`_name.ts`) the examples import. */\nexport function listHelpers() {\n  return fs.readdirSync(examplesDir).filter(file => /^_[\\w-]+\\.ts$/.test(file)).sort();\n}\n\nexport function readExample(file, dir = examplesDir, as = null) {\n  const ext = path.extname(file).slice(1);\n  const name = as ?? path.basename(file, path.extname(file));\n  const source = fs.readFileSync(path.join(dir, file), 'utf8');\n  const repoFile = path.relative(repoRoot, path.join(dir, file)).split(path.sep).join('/');\n  // The script-tag snippet is a whole document that loads the package from a CDN.\n  const documentPage = ext === 'html' && /^<!doctype html>/i.test(source.trimStart());\n  const raises = RAISES.exec(source)?.[1].split(/, | and /) ?? [];\n  const targets = ext === 'ts' ? [...new Set([...source.matchAll(CHART_CALL)].map(m => m[2] ?? m[4]))] : [];\n  if (ext === 'ts' && targets.length === 0) throw new Error(`${file}: no chart call with a '#id' target, and no getElementById('id')`);\n  const helpers = [...new Set([...source.matchAll(HELPER_IMPORT)].map(m => `${m[1]}.ts`))];\n  for (const helper of helpers) if (!fs.existsSync(path.join(examplesDir, helper))) throw new Error(`${file}: imports ${helper}, which does not exist`);\n  const scriptTag = ext === 'html' && /<script src=\"[^\"]*axylo\\.iife(?:\\.min)?\\.js\"><\\/script>/.test(source);\n  return { file, name, ext, source, repoFile, raises, noMarks: NO_MARKS.test(source), targets, helpers, scriptTag, documentPage };\n}\n\n/** The scripts of an .html example, in order, with the line each starts on. */\nexport function htmlScripts(example) {\n  const out = [];\n  let n = 0;\n  for (const m of example.source.matchAll(MODULE_SCRIPT)) {\n    out.push({ kind: 'module', file: `${example.name}.${++n}.js`, line: lineOf(example.source, m.index), code: m[1], match: m[0] });\n  }\n  for (const m of example.source.matchAll(CLASSIC_SCRIPT)) {\n    out.push({ kind: 'classic', file: `${example.name}.${++n}.classic.js`, line: lineOf(example.source, m.index), code: m[1], match: m[0] });\n  }\n  return out;\n}\n\nfunction lineOf(text, index) {\n  return text.slice(0, index).split('\\n').length;\n}\n\n/** What a reader must supply around an example to run it on their own page. */\nexport function hostOf(example) {\n  if (example.documentPage) {\n    return { markup: null, text: 'A whole page. Its two URLs point at jsDelivr, which serves published npm packages. Axylo is not published yet, so this site serves the page with those two files taken from the packed package, and adds its own stylesheet (for the font and colours of the frame) and the script that sizes the frame.' };\napps/docs/site/site.css:85:.table-scroll { overflow-x: auto; margin: 0 0 1.25em; }\napps/docs/site/site.css:88:table:has(thead th:nth-child(3)) { min-width: max(100%, 34rem); }\napps/docs/site/site.css:91:tbody th { font-weight: 400; }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"rg -n '<tbody>|<tr>|<th scope=\\\"row\\\">' apps/docs/test\nrg -n '\"'^### 1.3|''^### 1.6|''^### M7|''^### M8|''^DX12'\"' docs/03-plan-typescript-release.md\nsed -n '215,235p' docs/02-product-spec.md\nsed -n '350,371p' docs/03-plan-typescript-release.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"rg -n '<tbody>|<tr>|<th scope=\\\"row\\\">' apps/docs/test\nrg -n '\"'^### 1.3|''^### 1.6|''^### M7|''^### M8|''^DX12'\"' docs/03-plan-typescript-release.md\nsed -n '215,235p' docs/02-product-spec.md\nsed -n '350,371p' docs/03-plan-typescript-release.md\"","aggregated_output":"63:### 1.3 Fields\n130:### 1.6 Diagnostics\n350:### M7. Distribution and documentation (ceiling: 8 days)\n361:### M8. Release (ceiling: 10 days)\n### 3.8 What the evidence will and will not show\n\nAutomated checks establish structure: names, roles, focus order, contrast, text. They do not establish that a screen-reader user finds a chart understandable. 1.0 has no evidence for that: no screen reader was run against it, not even by the developer (the owner's decision, 2026-11-18; the rehearsal on five reader and browser pairs that earlier drafts of this section planned was not done). Axylo is built by one person with no access to study participants, so no claim of usability testing with disabled users is made, and the conformance table says both things in those words. Reviewers proposed participant testing as a release gate; it is recorded here as a known limit instead.\n\n## 4. Acceptance criteria: the developer's experience\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| DX1 | The first chart takes ten lines or fewer, including import, by npm and by script tag. No required option besides data and fields. | Two CI tests that render the documented snippet from the packed distribution | D1 |\n| DX2 | One logical table, three ways to pass it: long rows, wide rows, typed columns. The three forms of each fixture produce the same normalized data and the same diagnostics, with row indexes in the caller's own form. | Equivalence tests | D2 |\n| DX3 | With typed rows, a misspelled field, a text field on a value axis, wide `y` combined with `series`, and an option that does not apply to the chart type all fail to compile. At run time, for untyped rows, the same mistakes raise AX101, AX106 and AX150. | [docs/api/examples.ts](api/examples.ts) compiles and each marked mistake fails (already checked with TypeScript 7.0.2); runtime tests per code | D5 |\n| DX4 | Diagnostics follow the registry in section 3.5: stable code, chart name, field and rows where they apply, the fix, and a documentation page per code. | Message snapshots; link checker | R5, D5 |\n| DX5 | Three methods change a chart: `update` changes options, `append` adds rows, `zoom` sets the view. They apply in call order. Validation and diagnostics are synchronous; drawing is deferred to the next frame; marks, labels, hit testing and the accessibility layer always switch to a new state together. `destroy()` releases everything and cancels pending work. No `resize()` exists. | Sequence tests: replace then append then zoom in one turn; a rejected `strict` update leaves the last valid chart; destroy before the frame; 1,000 create–destroy cycles show no heap growth trend (P7) | D3, R16 |\n| DX6 | Colors, font and spacing are CSS custom properties with documented names; the chart inherits `font-family` and `color`. `colors` pins a color to a series name so the same series has the same color on every chart. There is no theme object and no positional palette option. | Theming tests, including a 24-tile page where series subsets differ | R10 |\n| DX7 | Zero runtime dependencies (reconsidered only with a measured comparison). Size targets for 1.0, set by the owner on 2026-11-18 after measurement: 116 KiB gzipped for everything and 98 KiB for a page that uses only `line`, CSS included. (History: the first targets, 40 and 25 KiB, were written before anything was built; 96 and 80 were set the same day from a first analysis, `reviews/2026-11-18/impl/wp/size.analysis.md`; the correctness passes that followed added about 11 KiB, and a second measured analysis, `reviews/2026-11-18/impl/wp/size2.analysis.md`, showed 96 and 80 can only be met by making streaming an opt-in import, a public API change the owner left for after 1.0. That change, worth about 15 KiB, is the first size item after 1.0.) | size-limit in CI on the packed distribution | D4 |\n| DX8 | Importing in Node without a DOM does not throw, and `validate()` runs there. Creating, destroying and creating again on the same element works and leaks nothing (the sequence a framework's strict or development mode produces). Works under a Content Security Policy without `unsafe-inline` or `unsafe-eval`, served with real headers. Labels and formatter output are inserted as text, never as HTML. A target that matches no element throws an error that names the selector. | CI tests | D1 |\n| DX9 | Semantic versioning. A deprecated API keeps working for at least one minor release and six months. At most one major version a year. The previous release's documented examples still compile and run against each release candidate. | Release policy; API report diff; upgrade test | D6 |\n| DX10 | Every runnable example in the documentation is compiled and rendered in CI from the packed distribution. | Docs build | D1 |\n| DX11 | MIT license for everything, including zoom and accessibility. Third-party notices are verified at release. | Repository; release check | D7 |\n| DX12 | A coding agent gets the first chart right. Given fixed prompts and trap fixtures (UTC-midnight ISO dates, numeric strings, unsorted rows, missing days, a misspelled field), an agent with only the published docs produces a chart with no error diagnostics that passes the reader criteria. Recorded as agent rehearsal, not as user evidence. | Scripted rehearsal at each release | D1, 1.2 |\n\n### M7. Distribution and documentation (ceiling: 8 days)\n\n- Script-tag builds; documentation site; migration notes from Chart.js and Recharts. (No framework adapter in 1.0.)\n\nOutcomes:\n- The packed tarball installed into two clean fixtures (npm with a bundler, script tag): the first chart works in ten lines or fewer in each (DX1).\n- Node import and `validate()` without a DOM; strict CSP with real headers (DX8).\n- Size measured on the packed distribution for line-only, full and script-tag cases, CSS included (DX7).\n- Every runnable docs example compiled and rendered from the packed distribution (DX10).\n- The agent rehearsal (DX12), recorded as rehearsal.\n\n### M8. Release (ceiling: 10 days)\n\n- Beta under a `next` tag; issues from real use fixed; API frozen through the API report.\n- The Phase 1 comparison regenerated with Axylo beside the ten libraries, with the same harness and the corrections from the review, and published with its limits.\n- Real Safari on macOS and iOS checked by hand.\n- Independent review of the acceptance evidence before 1.0 is tagged, by a reviewer who did not write the code under review.\n\nOutcomes: every acceptance-matrix row is pass or not applicable with a reason; changelog, upgrade policy and third-party notices published.\n\nPublishing to npm, tagging and pushing are separate, explicit decisions by the owner at this point; the plan does not assume them.\n\n","exit_code":0,"status":"completed"}}
