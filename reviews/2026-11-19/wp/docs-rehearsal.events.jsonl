{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'cat apps/docs/build.mjs apps/docs/lib/{site,markdown,examples,consumer}.mjs apps/docs/test/{options.test.ts,example-checks.ts,node.browser.test.ts} apps/docs/examples/{tsconfig.json,node/tsconfig.json,node/validate.ts,numeric-strings.ts}'","aggregated_output":"// Builds the documentation site into apps/docs/dist. Needs the library built first (`npm run build`).\n// Usage: node apps/docs/build.mjs [--unchecked-library]\n//\n// --unchecked-library builds even when packages/axylo/dist is not the build of its current source, into\n// apps/docs/.cache/unchecked-site, with every page saying so. It is for checking pages while a rebuild of the\n// library is pending; it never replaces apps/docs/dist.\nimport { buildSite } from './lib/site.mjs';\n\nconst args = process.argv.slice(2);\nconst unknown = args.filter(a => a !== '--unchecked-library');\nif (unknown.length) throw new Error(`unknown argument ${unknown[0]} (usage: node apps/docs/build.mjs [--unchecked-library])`);\nconst started = Date.now();\nconst result = await buildSite({ log: message => console.warn(message), uncheckedLibrary: args.includes('--unchecked-library') });\nconst words = result.pages.reduce((sum, p) => sum + p.words, 0);\nconsole.log(`built ${result.pages.length} pages (${words} words), ${result.diagnostics} diagnostic pages and ${result.examples.length} examples in ${Date.now() - started} ms, into ${result.outDir}`);\nfor (const p of result.pages) console.log(`  ${p.page.padEnd(18)} ${String(p.words).padStart(5)} words`);\nif (result.unchecked.length) console.log(`NOT FOR PUBLISHING: built against a packed library that is not the build of its source (${result.unchecked.length} differences).`);\n/**\n * Builds the documentation site from the Markdown pages, the runnable examples, the diagnostics data file\n * and the packed packages, installed into a consumer of their own (lib/consumer.mjs).\n *\n * - Every example is bundled from the consumer by esbuild under the `development` condition, as an\n *   application would bundle it, and runs in its own page (examples/<name>.html), framed beside its source.\n * - The stylesheet, the script-tag file and `validate()` come from the installed tarball. Two inputs are read\n *   from the library's source because the bundle does not export them (the built-in messages and the\n *   registry's message templates); the build checks that the installed files were built from that source.\n * - The conformance page is generated from the specification and the acceptance checker's report\n *   (lib/conformance.mjs), and the size table from scripts/size.mjs's last measurement, shown only when it\n *   measured the very tarball installed here.\n * - Every link stays inside the site: a link to a file of the repository publishes that file as a source page\n *   under source/, with one anchor per line, at the revision the site was built from.\n * - The site is built into a temporary directory, checked (links, anchors, unique ids), and only then\n *   replaces the previous output, so a failed build leaves the last good site in place.\n */\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { execFileSync } from 'node:child_process';\nimport { pathToFileURL } from 'node:url';\nimport { build } from 'esbuild';\nimport { checkHref, codeBlock, escapeHtml, markdownToHtml, renderInline, uniqueId, wordCount } from './markdown.mjs';\nimport { docsRoot, hostOf, htmlScripts, listExamples, listHelpers, repoRoot, writeConsumerSources } from './examples.mjs';\nimport { consumerDir, guard, installed, prepareConsumer } from './consumer.mjs';\nimport { readThemeDefaults } from './theme.mjs';\nimport { readConformance } from './conformance.mjs';\nimport { nav, pages } from '../data/nav.mjs';\n\nconst pagesDir = path.join(docsRoot, 'pages');\nconst siteDir = path.join(docsRoot, 'site');\nconst HEX = /^#[0-9a-f]{3,8}$/i;\n\n/** Generated tables, and the one file each `[table: …](target)` directive must name. */\nconst TABLES = {\n  'diagnostic codes': 'apps/docs/data/diagnostics.mjs',\n  'theme tokens': 'apps/docs/data/tokens.mjs',\n  'internal tokens': 'apps/docs/data/tokens.mjs',\n  messages: 'packages/axylo/src/messages/index.ts',\n  palette: 'packages/axylo/src/theme/palette.ts',\n  conformance: 'acceptance/check.mjs',\n  sizes: 'bench/size-latest.json',\n};\n/** Where `[source: …]` may quote from. */\nconst SOURCE_ROOTS = ['examples/first-chart/', 'research/harness/src/libs/', 'apps/docs/examples/'];\n\n/** Bundles a TypeScript source of the library and imports it, to read data the built bundle does not export. */\nexport async function importSource(relative) {\n  const { DEVELOPMENT } = await import(pathToFileURL(path.join(repoRoot, 'scripts/build.mjs')).href);\n  const result = await build({\n    entryPoints: [path.join(repoRoot, relative)], bundle: true, format: 'esm', write: false, platform: 'neutral',\n    define: DEVELOPMENT, logLevel: 'silent',\n  });\n  return import('data:text/javascript;base64,' + Buffer.from(result.outputFiles[0].contents).toString('base64'));\n}\n\nexport { readThemeDefaults };\n\nfunction gitRevision() {\n  try {\n    const sha = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repoRoot, encoding: 'utf8' }).trim();\n    const dirty = execFileSync('git', ['status', '--porcelain'], { cwd: repoRoot, encoding: 'utf8' }).trim() !== '';\n    return { sha, short: sha.slice(0, 7), dirty };\n  } catch {\n    return { sha: 'unknown', short: 'unknown', dirty: true };\n  }\n}\n\n/**\n * The installed files and the source the build also reads (the built-in messages and the registry's\n * templates, which the bundle does not export) must be one revision. The check takes what it compares from\n * scripts/build.mjs itself, so it follows the library's build by construction: the stylesheet must equal\n * `stylesheets().minified` (dist/axylo.css is that text), and the development bundle, rebuilt from\n * packages/axylo/src in memory with the build's DEVELOPMENT constants and the options it uses for\n * axylo.dev.js, must equal the installed file byte for byte. Anything else means packages/axylo/dist is older\n * or newer than its source.\n */\nasync function checkSameRevision(css, bundle, { unchecked = false, log = () => {} } = {}) {\n  const problems = [];\n  const { stylesheets, DEVELOPMENT } = await import(pathToFileURL(path.join(repoRoot, 'scripts/build.mjs')).href);\n  const { minified } = await stylesheets();\n  if (minified !== css) problems.push('the installed axylo.css differs from the minified packages/axylo/src/theme/css.ts');\n  const rebuilt = await build({\n    entryPoints: [path.join(repoRoot, 'packages/axylo/src/index.ts')], bundle: true, target: 'es2022', legalComments: 'none',\n    logLevel: 'silent', format: 'esm', define: DEVELOPMENT, write: false, outfile: path.join(repoRoot, 'packages/axylo/dist/axylo.dev.js'),\n    absWorkingDir: repoRoot,\n  });\n  if (Buffer.from(rebuilt.outputFiles[0].contents).toString('utf8') !== bundle) {\n    problems.push('the installed axylo.dev.js differs from what packages/axylo/src builds to now');\n  }\n  const source = JSON.parse(fs.readFileSync(path.join(repoRoot, 'packages/axylo/package.json'), 'utf8')).version;\n  const shipped = JSON.parse(fs.readFileSync(path.join(installed('axylo'), 'package.json'), 'utf8')).version;\n  if (source !== shipped) problems.push(`version ${shipped} installed, ${source} in source`);\n  if (problems.length && !unchecked) {\n    throw new Error(`The packed library and its source differ (run \\`npm run build\\`, then build the site again):\\n  ${problems.join('\\n  ')}`);\n  }\n  for (const p of problems) log(`unchecked library: ${p}`);\n  return { messages: (await importSource('packages/axylo/src/messages/index.ts')).defaultMessages, problems };\n}\n\nconst DIST = path.join(docsRoot, 'dist');\n/** Where a build that skipped the revision check goes: never the site's own output. */\nexport const UNCHECKED_DIR = path.join(docsRoot, '.cache/unchecked-site');\n\n/** Keeps staging on the output filesystem so the finished site can be renamed into place. */\nexport async function stageSite(outDir, writeSite) {\n  const staging = `${outDir}.tmp-${process.pid}`;\n  fs.rmSync(staging, { recursive: true, force: true });\n  try {\n    // Git ignores dist/ directories, so these files cannot invalidate the results the site reads.\n    return await writeSite(path.join(staging, 'dist'));\n  } finally {\n    fs.rmSync(staging, { recursive: true, force: true });\n  }\n}\n\n/**\n * `uncheckedLibrary`: build even when the packed library is not the build of its current source (while\n * someone else's rebuild is pending), to check the pages, links and generated tables. Such a build goes to\n * UNCHECKED_DIR only, and every page says what it was built against, so it cannot be published by mistake.\n */\nexport async function buildSite({ outDir, log = () => {}, uncheckedLibrary = false } = {}) {\n  outDir ??= uncheckedLibrary ? UNCHECKED_DIR : DIST;\n  if (uncheckedLibrary && path.resolve(outDir) === DIST) throw new Error('An unchecked build never replaces apps/docs/dist');\n  const revision = gitRevision();\n  const packed = prepareConsumer({ log });\n  const lib = installed('axylo');\n  const css = fs.readFileSync(path.join(lib, 'dist/axylo.css'), 'utf8');\n  const bundle = fs.readFileSync(path.join(lib, 'dist/axylo.dev.js'), 'utf8');\n  const { messages, problems: unchecked } = await checkSameRevision(css, bundle, { unchecked: uncheckedLibrary, log });\n  const theme = readThemeDefaults(css);\n\n  return stageSite(outDir, async tmp => {\n    for (const dir of ['assets', 'examples/js', 'diagnostics', 'source']) fs.mkdirSync(path.join(tmp, dir), { recursive: true });\n    const warnings = [];\n    writeAssets(tmp, theme);\n    for (const file of ['axylo.iife.js', 'axylo.iife.min.js', 'axylo.css']) fs.copyFileSync(path.join(lib, 'dist', file), path.join(tmp, 'examples', file));\n    const examples = await buildExamples(tmp);\n    const { diagnostics } = await import(pathToFileURL(path.join(docsRoot, 'data/diagnostics.mjs')).href + `?t=${Date.now()}`);\n    const { tokens, internalTokens } = await import(pathToFileURL(path.join(docsRoot, 'data/tokens.mjs')).href + `?t=${Date.now()}`);\n    const { messageUses } = await import(pathToFileURL(path.join(docsRoot, 'data/messages.mjs')).href + `?t=${Date.now()}`);\n    const seen = await diagnosticOutput(diagnostics);\n    const version = packed.axylo.version;\n    const conformance = await readConformance({ root: repoRoot, revision });\n    const sizes = readSizes(packed.axylo.integrity);\n    const ctx = {\n      outDir: tmp, examples, diagnostics, seen, tokens, internalTokens, messages, messageUses, theme, warnings, version, revision,\n      unchecked, conformance, sizes, published: new Set(),\n    };\n\n    const report = [];\n    for (const [index, entry] of pages.entries()) {\n      const source = fs.readFileSync(path.join(pagesDir, `${entry.page}.md`), 'utf8');\n      fs.writeFileSync(path.join(tmp, `${entry.page}.html`), renderPage(entry, source, index, ctx));\n      report.push({ page: entry.page, words: wordCount(source) });\n    }\n    for (const d of diagnostics) fs.writeFileSync(path.join(tmp, 'diagnostics', `${d.code}.html`), renderDiagnosticPage(d, ctx));\n    // Example sources and helpers are linked from every example block; publish them all.\n    for (const e of examples) ctx.published.add(e.repoFile);\n    for (const helper of listHelpers()) ctx.published.add(`apps/docs/examples/${helper}`);\n    for (const file of ctx.published) writeSourcePage(tmp, file, ctx);\n\n    const problems = checkSite(tmp);\n    if (problems.length) throw new Error('The site has broken links or duplicate ids:\\n' + problems.join('\\n'));\n    fs.writeFileSync(path.join(tmp, 'build.json'), JSON.stringify({ revision, unchecked, packed: Object.fromEntries(Object.entries(packed).map(([n, p]) => [n, { tarball: p.tarball, integrity: p.integrity }])), examples }, null, 1));\n\n    // Replace the previous site only now.\n    const old = `${outDir}.old-${process.pid}`;\n    if (fs.existsSync(outDir)) fs.renameSync(outDir, old);\n    fs.renameSync(tmp, outDir);\n    fs.rmSync(old, { recursive: true, force: true });\n    for (const w of warnings) log('warning: ' + w);\n    return { pages: report, examples, warnings, diagnostics: diagnostics.length, published: ctx.published.size, revision, unchecked, outDir };\n  });\n}\n\n// ---------- assets ----------\n\nfunction writeAssets(outDir, theme) {\n  const pick = (scheme, name) => {\n    const value = theme[scheme][`--axylo-default-${name}`];\n    if (!value || !HEX.test(value)) throw new Error(`axylo.css: no colour for --axylo-default-${name} (${scheme})`);\n    return value;\n  };\n  // The site's surfaces use the chart's own default tokens, so the pages and the charts match.\n  const vars = scheme => ['background', 'axis', 'grid', 'muted', 'focus', 'reference']\n    .map(name => `  --site-${name}: ${pick(scheme, name)};`).join('\\n');\n  const tokens = `/* Generated from the packed axylo.css by apps/docs/lib/site.mjs. */\n:root {\n${vars('light')}\n}\n@media (prefers-color-scheme: dark) {\n  :root {\n${vars('dark')}\n  }\n}\n`;\n  fs.writeFileSync(path.join(outDir, 'assets/site.css'), tokens + fs.readFileSync(path.join(siteDir, 'site.css'), 'utf8'));\n  for (const file of ['page.js', 'frame.js']) fs.copyFileSync(path.join(siteDir, file), path.join(outDir, 'assets', file));\n}\n\n// ---------- examples ----------\n\n/**\n * Bundles every example from the consumer, resolving the installed tarball under the `development`\n * condition, with shared chunks, and writes one page\n * per example. Nothing may resolve outside the consumer.\n */\nasync function buildExamples(outDir) {\n  const examples = listExamples();\n  const { src } = writeConsumerSources(consumerDir);\n  const entries = [];\n  for (const e of examples) {\n    if (e.ext !== 'html') entries.push(path.join(src, `${e.name}.${e.ext}`));\n    else for (const s of htmlScripts(e).filter(s => s.kind === 'module')) entries.push(path.join(src, s.file));\n  }\n  await build({\n    entryPoints: entries, bundle: true, format: 'esm', splitting: true, target: 'es2022', outdir: path.join(outDir, 'examples/js'),\n    conditions: ['development'], logLevel: 'warning',\n    absWorkingDir: consumerDir, plugins: [guard()], entryNames: '[name]', chunkNames: 'chunk-[hash]',\n  });\n  const manifest = [];\n  for (const e of examples) {\n    fs.writeFileSync(path.join(outDir, 'examples', `${e.name}.html`), examplePage(e));\n    manifest.push({ name: e.name, file: e.file, repoFile: e.repoFile, ext: e.ext, raises: e.raises, noMarks: e.noMarks, targets: e.targets });\n  }\n  fs.writeFileSync(path.join(outDir, 'examples/manifest.json'), JSON.stringify(manifest, null, 2));\n  return manifest;\n}\n\nfunction examplePage(e) {\n  let body;\n  let styles = '';\n  if (e.documentPage) {\n    // The snippet's own page, with the CDN files answered by the same files from the packed package.\n    const page = e.source\n      .replace(/https:\\/\\/cdn\\.jsdelivr\\.net\\/npm\\/axylo\\/dist\\/(axylo\\.(?:css|iife\\.min\\.js|iife\\.js))/g, '$1')\n      .replace(/<link rel=\"stylesheet\"/, '<link rel=\"icon\" href=\"data:,\">\\n<link rel=\"stylesheet\" href=\"../assets/site.css\">\\n<link rel=\"stylesheet\"');\n    if (/https?:\\/\\//.test(page)) throw new Error(`${e.repoFile}: a URL this site cannot serve remains in the page`);\n    return `${page.replace(/\\n?$/, '\\n')}<script src=\"../assets/frame.js\" defer></script>\\n`;\n  }\n  if (e.ext === 'html') {\n    // The example's own <style> goes to the head, where it belongs; each module script becomes its bundle.\n    styles = [...e.source.matchAll(/<style>[\\s\\S]*?<\\/style>\\n?/g)].map(m => m[0]).join('');\n    body = e.source.replace(/<style>[\\s\\S]*?<\\/style>\\n?/g, '');\n    for (const s of htmlScripts(e).filter(s => s.kind === 'module')) {\n      body = body.replace(s.match, `<script type=\"module\" src=\"js/${escapeHtml(s.file)}\"></script>`);\n    }\n  } else {\n    body = e.targets.map(id => `<div id=\"${escapeHtml(id)}\" class=\"example-target\"></div>`).join('\\n') +\n      `\\n<script type=\"module\" src=\"js/${e.name}.js\"></script>`;\n  }\n  return `<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>Example: ${escapeHtml(e.name)}</title>\n<link rel=\"icon\" href=\"data:,\">\n<link rel=\"stylesheet\" href=\"../assets/site.css\">\n<script src=\"../assets/frame.js\" defer></script>\n${styles}</head>\n<body class=\"example-page\">\n${body}\n</body>\n</html>\n`;\n}\n\n// ---------- pages ----------\n\nfunction renderPage(entry, source, index, ctx) {\n  const headings = [];\n  const ids = reservedIds();\n  const where = path.join(pagesDir, `${entry.page}.md`);\n  const body = markdownToHtml(source, {\n    headings, ids,\n    link: url => pageLink(url, where, '', ctx),\n    directive: d => directive(d, where, ctx, ids),\n  });\n  const title = headings.find(h => h.level === 1)?.text ?? entry.label;\n  const prev = pages[index - 1];\n  const next = pages[index + 1];\n  const pager = `<nav class=\"pager\" aria-label=\"Previous and next page\">${prev ? `<a rel=\"prev\" href=\"${prev.page}.html\">← ${escapeHtml(prev.label)}</a>` : '<span></span>'}${next ? `<a rel=\"next\" href=\"${next.page}.html\">${escapeHtml(next.label)} →</a>` : ''}</nav>`;\n  return layout({ title, body: body + pager, current: entry.page, base: '', ctx, sourceFile: `apps/docs/pages/${entry.page}.md` });\n}\n\n/** Ids the layout itself uses, reserved before a page's headings get theirs. */\nconst reservedIds = () => new Set(['main']);\n\nconst PAGE_NAMES = new Set(pages.map(p => p.page));\n\n/**\n * Rewrites a link written for the Markdown sources (readable on a code host) to its place in the site.\n * `from` is the file the link is written in; `base` is the path from the page being built to the site root.\n * A link to any other file of the repository publishes that file as a source page.\n */\nexport function pageLink(url, from, base, ctx) {\n  checkHref(url);\n  if (/^(https|mailto):/i.test(url) || url.startsWith('#')) return url;\n  const [file, hash] = url.split('#');\n  if (file === 'diagnostics.md' && hash && /^ax\\d{3}$/i.test(hash)) return `${base}diagnostics/${hash.toUpperCase()}.html`;\n  const name = file.endsWith('.md') && !file.includes('/') ? file.slice(0, -3) : null;\n  if (name !== null && PAGE_NAMES.has(name)) return `${base}${name}.html${hash ? '#' + hash : ''}`;\n  const absolute = path.resolve(path.dirname(from), file);\n  const relative = path.relative(repoRoot, absolute).split(path.sep).join('/');\n  if (relative.startsWith('..') || path.isAbsolute(relative)) throw new Error(`${path.relative(repoRoot, from)}: link ${url} leaves the repository`);\n  if (!fs.existsSync(absolute) || fs.statSync(absolute).isDirectory()) throw new Error(`${path.relative(repoRoot, from)}: link ${url} names no file`);\n  ctx.published.add(relative);\n  const line = hash && /^L(\\d+)(?:-L\\d+)?$/.exec(hash);\n  if (hash && !line) throw new Error(`${path.relative(repoRoot, from)}: link ${url}: only line anchors (#L12, #L12-L20) are kept on source pages`);\n  return `${base}${sourcePath(relative)}${line ? `#L${line[1]}` : ''}`;\n}\n\nconst sourcePath = relative => `source/${relative}.html`;\n\nfunction directive({ kind, name, target }, where, ctx, ids) {\n  if (kind === 'example') return exampleBlock(name, target, where, ctx, ids);\n  if (kind === 'source') return sourceBlock(name, target, where, ctx);\n  if (kind === 'table') return generatedTable(name, target, where, ctx);\n  if (kind === 'output') return diagnosticOutputBlock(name, target, where, ctx);\n  throw new Error(`Unknown directive ${kind}`);\n}\n\n/** `[output: AX103](../data/diagnostics.mjs)`: what that code's minimal input printed when the site was built. */\nfunction diagnosticOutputBlock(code, target, where, ctx) {\n  const relative = repoPath(where, target);\n  if (relative !== 'apps/docs/data/diagnostics.mjs') throw new Error(`${path.relative(repoRoot, where)}: [output:] names apps/docs/data/diagnostics.mjs, not ${relative}`);\n  const printed = ctx.seen.get(code);\n  if (!printed) throw new Error(`${path.relative(repoRoot, where)}: no diagnostic ${code}`);\n  return `${codeBlock(printed[0].join('\\n'), 'text')}<p class=\"small\">Printed by <a href=\"diagnostics/${escapeHtml(code)}.html\">${escapeHtml(code)}</a>'s minimal input when this site was built.</p>`;\n}\n\nfunction repoPath(where, target) {\n  return path.relative(repoRoot, path.resolve(path.dirname(where), target)).split(path.sep).join('/');\n}\n\nfunction listText(items) {\n  return items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;\n}\n\nfunction exampleBlock(name, target, where, ctx, ids) {\n  const relative = repoPath(where, target);\n  const example = ctx.examples.find(e => e.repoFile === relative);\n  if (!example) throw new Error(`${path.relative(repoRoot, where)}: example ${target} does not exist`);\n  if (example.name !== name) throw new Error(`${path.relative(repoRoot, where)}: example link text \"${name}\" does not match ${example.file}`);\n  const full = listExamples().find(e => e.name === example.name);\n  const raises = example.raises.length\n    ? `<p class=\"example-note\">This example raises ${listText(example.raises.map(c => `<a href=\"diagnostics/${c}.html\">${c}</a>`))} on purpose.</p>`\n    : '';\n  const host = hostOf(full);\n  const helpers = full.helpers.map(h => `<a href=\"${sourcePath(`apps/docs/examples/${h}`)}\">examples/${escapeHtml(h)}</a>`);\n  const hostBlock = `<div class=\"example-host\"><p><strong>To run it yourself:</strong> ${renderInline(host.text)}${helpers.length ? ` It also imports ${listText(helpers)}, the shared fixture, which must sit beside it.` : ''}</p>${host.markup ? codeBlock(host.markup, 'html') : ''}</div>`;\n  const id = uniqueId(`example-${example.name}`, ids);\n  const height = example.ext === 'ts' ? example.targets.length * 470 : 470;\n  return `<figure class=\"example\" id=\"${escapeHtml(id)}\">\n<div class=\"example-live\"><iframe src=\"examples/${escapeHtml(example.name)}.html\" title=\"Live example: ${escapeHtml(example.name)}\" loading=\"lazy\" style=\"height: ${height}px\"></iframe></div>\n${raises}<figcaption><span>Source</span> <a href=\"${sourcePath(relative)}\">${escapeHtml(relative.replace(/^apps\\/docs\\//, ''))}</a> · <a href=\"examples/${escapeHtml(example.name)}.html\">open on its own</a></figcaption>\n${codeBlock(full.source, example.ext)}\n${hostBlock}\n</figure>`;\n}\n\nfunction sourceBlock(label, target, where, ctx) {\n  const [file, range] = target.split('#');\n  const relative = repoPath(where, file);\n  if (!SOURCE_ROOTS.some(root => relative.startsWith(root))) throw new Error(`${path.relative(repoRoot, where)}: [source:] may only quote ${SOURCE_ROOTS.join(', ')}; not ${relative}`);\n  const absolute = path.join(repoRoot, relative);\n  if (!fs.existsSync(absolute)) throw new Error(`${path.relative(repoRoot, where)}: quoted file ${relative} does not exist`);\n  let text = fs.readFileSync(absolute, 'utf8').replace(/\\n$/, '');\n  const lines = range && /^L(\\d+)-L(\\d+)$/.exec(range);\n  if (range && !lines) throw new Error(`${path.relative(repoRoot, where)}: bad line range ${range}`);\n  if (lines) {\n    const all = text.split('\\n');\n    const [from, to] = [Number(lines[1]), Number(lines[2])];\n    if (from < 1 || to > all.length || from > to) throw new Error(`${path.relative(repoRoot, where)}: ${relative} has no lines ${from}–${to}`);\n    text = all.slice(from - 1, to).join('\\n');\n  }\n  ctx.published.add(relative);\n  const ext = path.extname(file).slice(1);\n  const named = label === relative || label === file ? '' : `${escapeHtml(label)} · `;\n  return `<figure class=\"source\"><figcaption>${named}<a href=\"${sourcePath(relative)}${lines ? `#L${lines[1]}` : ''}\">${escapeHtml(relative)}${lines ? `, lines ${lines[1]}–${lines[2]}` : ''}</a></figcaption>${codeBlock(text, ext)}</figure>`;\n}\n\nfunction generatedTable(name, target, where, ctx) {\n  const expected = TABLES[name];\n  if (!expected) throw new Error(`${path.relative(repoRoot, where)}: unknown generated table \"${name}\"`);\n  const relative = repoPath(where, target);\n  if (relative !== expected) throw new Error(`${path.relative(repoRoot, where)}: table \"${name}\" is generated from ${expected}, not ${relative}`);\n  ctx.published.add(relative);\n  const link = url => pageLink(url, where, '', ctx);\n  if (name === 'conformance') return conformanceTables(ctx, link);\n  if (name === 'sizes') return sizesTable(ctx);\n  const table = name === 'diagnostic codes' ? diagnosticsTable(ctx, link)\n    : name === 'theme tokens' ? tokensTable(ctx)\n      : name === 'internal tokens' ? internalTokensTable(ctx)\n        : name === 'messages' ? messagesTable(ctx, link)\n          : paletteTable(ctx);\n  const from = name === 'palette' || name === 'theme tokens'\n    ? ` Colours read from the packed <code>axylo/axylo.css</code>.` : '';\n  const also = name === 'messages' ? ` and, for where each is shown, <a href=\"${sourcePath('apps/docs/data/messages.mjs')}\">apps/docs/data/messages.mjs</a>` : '';\n  if (also) ctx.published.add('apps/docs/data/messages.mjs');\n  return `${table}<p class=\"small\">Generated from <a href=\"${sourcePath(relative)}\">${escapeHtml(relative)}</a>${also}.${from}</p>`;\n}\n\n/**\n * The conformance page's tables (lib/conformance.mjs): each WCAG criterion the specification cites, the\n * specification's text for the rows that cite it, and what the acceptance checker recorded for them at this\n * revision; then the result files the checker was given, and the criteria the specification does not cite.\n */\nfunction conformanceTables(ctx) {\n  const { criteria, checker, uncited } = ctx.conformance;\n  const spec = path.join(repoRoot, 'docs/02-product-spec.md');\n  const specLink = url => pageLink(url, spec, '', ctx);\n  const specPage = sourcePath('docs/02-product-spec.md');\n  ctx.published.add('docs/02-product-spec.md');\n  const checkerPage = sourcePath('acceptance/check.mjs');\n  const engines = ['chromium', 'firefox', 'webkit', null];\n  const engineName = engine => engine === null ? 'Unit tests (Node)' : checker.label(engine);\n  const state = checker.refused\n    ? `<p><strong>Nothing is counted on this page.</strong> When this site was built, <a href=\"${checkerPage}\">the acceptance checker</a> refused its matrix (${checker.refused.length} ${checker.refused.length === 1 ? 'problem' : 'problems'}), so every result below reads “not recorded” and no cited test is listed. The first problem it gave: <code>${escapeHtml(checker.refused[0])}</code></p>`\n    : `<p>Each entry is <a href=\"${checkerPage}\">the acceptance checker</a>’s, run in release mode when this site was built: a result counts only when its recorded provenance matches the revision the site was built from.</p>`;\n  const warned = checker.warnings.length ? `<details><summary>The checker's warnings: ${checker.warnings.length}</summary><ul>${checker.warnings.map(w => `<li>${escapeHtml(w)}</li>`).join('')}</ul></details>` : '';\n  const tests = c => c.tests.length ? `<details><summary>Tests the matrix cites: ${c.tests.length}</summary><ul>${c.tests.map(t =>\n    `<li>${escapeHtml(t.kind)}${t.engine ? `, ${escapeHtml(checker.label(t.engine))}` : ''}: <code>${escapeHtml(t.file)}</code>${t.test ? `, “${escapeHtml(t.test)}”` : ''}</li>`).join('')}</ul></details>` : '';\n  const rows = criteria.map(c => [\n    `<th scope=\"row\">${escapeHtml(c.sc)} ${escapeHtml(c.name)} <span class=\"small\">(level ${escapeHtml(c.level)})</span></th>`,\n    `<td>${c.rows.map(r => `<p><a href=\"${specPage}\">${escapeHtml(r.id)}</a>: ${renderInline(r.criterion, specLink)}</p>`).join('')}</td>`,\n    `<td><ul class=\"evidence\">${c.verdict.map(v => `<li>Checker, ${escapeHtml(v.id)}: ${escapeHtml(v.text)}</li>`).join('')}${engines.map(engine =>\n      `<li>${escapeHtml(engineName(engine))}: ${escapeHtml(c.engines[String(engine)])}</li>`).join('')}</ul>${tests(c)}</td>`,\n  ]);\n  const table = `<p>Evidence is recorded per row of the specification, not per criterion: the results and the tests listed under a criterion are those of the specification rows that cite it, and not every one of them bears on that criterion.</p>${htmlTable(['Success criterion', 'What Axylo does (the specification\\'s rows that cite it)', 'Evidence at this revision'], rows, 'WCAG criteria the specification cites')}`;\n  const files = checker.files.length\n    ? htmlTable(['Result file', 'Engine', 'Recorded at commit', 'Counted'], checker.files.map(f => [\n      `<th scope=\"row\"><code>${escapeHtml(f.file)}</code></th>`, `<td>${escapeHtml(engineName(f.engine))}</td>`,\n      `<td>${f.provenance?.commit ? `<code>${escapeHtml(f.provenance.commit.slice(0, 7))}</code>${f.provenance.dirty ? ', with uncommitted changes' : ''}` : 'not recorded'}</td>`,\n      `<td>${checker.refused ? 'No: the checker refused its matrix' : f.counted ? 'Yes' : `No: ${escapeHtml(f.why ?? 'not read by the checker')}`}</td>`,\n    ]), 'Result files')\n    : '<p>No result files were present in <code>acceptance/results/</code> when this site was built (they are not kept in the repository).</p>';\n  const rest = `<p>The specification cites ${criteria.length} of the ${criteria.length + uncited.length} level A and AA success criteria of WCAG 2.2. No test covers the others; why, criterion by criterion, is this documentation's own reading of what a chart renders, and “not assessed” where a criterion can apply and nothing checks it.</p>${htmlTable(['Success criterion', 'Not covered by a test', 'Why'], uncited.map(c => [\n    `<th scope=\"row\">${escapeHtml(c.sc)} ${escapeHtml(c.name)} <span class=\"small\">(level ${escapeHtml(c.level)})</span></th>`,\n    `<td>${escapeHtml(c.kind[0].toUpperCase() + c.kind.slice(1))}</td>`, `<td>${escapeHtml(c.why)}</td>`,\n  ]), 'Criteria the specification does not cite')}`;\n  ctx.published.add('apps/docs/data/wcag.mjs');\n  return `${state}${warned}${table}<h3>Result files</h3>${files}<h3>Criteria the specification does not cite</h3>${rest}<p class=\"small\">Generated from <a href=\"${specPage}\">docs/02-product-spec.md</a>, <a href=\"${checkerPage}\">acceptance/check.mjs</a> and, for the criteria no row cites, <a href=\"${sourcePath('apps/docs/data/wcag.mjs')}\">apps/docs/data/wcag.mjs</a>.</p>`;\n}\n\n/**\n * scripts/size.mjs's last measurement (bench/size-latest.json). Its numbers are shown only when it measured\n * the very tarball this site installed (the same npm integrity); otherwise only the targets are.\n */\nfunction readSizes(integrity) {\n  const file = path.join(repoRoot, 'bench/size-latest.json');\n  if (!fs.existsSync(file)) return { measured: false, date: null, rows: [] };\n  const data = JSON.parse(fs.readFileSync(file, 'utf8'));\n  if (!Array.isArray(data.rows)) throw new Error('bench/size-latest.json: no rows');\n  return { measured: data.packed?.axylo === integrity, date: data.date ?? null, method: data.method ?? '', rows: data.rows };\n}\n\nfunction sizesTable(ctx) {\n  const { measured, date, method, rows } = ctx.sizes;\n  const note = `<p class=\"small\">From <a href=\"${sourcePath('bench/size-latest.json')}\">bench/size-latest.json</a>, written by <code>scripts/size.mjs</code>${date ? ` on ${escapeHtml(date.slice(0, 10))}` : ''}.</p>`;\n  if (!measured) {\n    const targets = rows.filter(r => r.targetKiB !== null);\n    return `<p>No size measurement of the packed files this site was built from: the last one measured a different build, so no measured size is shown here. The targets:</p>${htmlTable(['What a page loads', 'Target, gzipped'],\n      targets.map(r => [`<th scope=\"row\">${escapeHtml(r.entry)}</th>`, `<td>${escapeHtml(String(r.targetKiB))} KiB</td>`]), 'Size targets')}${note}`;\n  }\n  const status = r => r.targetKiB === null ? 'No target' : r.over ? 'Not met' : 'Met';\n  return `${htmlTable(['What a page loads', 'Gzipped, measured', 'Target', 'Target met'], rows.map(r => [\n    `<th scope=\"row\">${escapeHtml(r.entry)}</th>`, `<td>${escapeHtml(r.totalKiB.toFixed(2))} KiB</td>`,\n    `<td>${r.targetKiB === null ? '–' : `${escapeHtml(String(r.targetKiB))} KiB`}</td>`, `<td>${status(r)}</td>`,\n  ]), 'Measured sizes')}<p class=\"small\">Measured from the same packed tarball this site installed (${escapeHtml(method)}).</p>${note}`;\n}\n\nfunction htmlTable(head, rows, caption) {\n  const th = head.map(h => `<th scope=\"col\">${escapeHtml(h)}</th>`).join('');\n  return `<div class=\"table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"${escapeHtml(caption)}\"><table><thead><tr>${th}</tr></thead><tbody>${rows.map(r => `<tr>${r.join('')}</tr>`).join('')}</tbody></table></div>`;\n}\n\nfunction diagnosticsTable(ctx, link) {\n  const rows = ctx.diagnostics.map(d => [\n    `<th scope=\"row\"><a href=\"diagnostics/${d.code}.html\">${d.code}</a></th>`,\n    `<td><span class=\"level level-${d.level}\">${escapeHtml(d.level)}</span></td>`,\n    `<td>${renderInline(d.condition, link)}</td>`,\n    `<td>${renderInline(d.drawn, link)}</td>`,\n  ]);\n  return htmlTable(['Code', 'Level', 'When', 'What is drawn'], rows, 'Diagnostic codes');\n}\n\nfunction swatch(value) {\n  // Only a colour read from the library's own stylesheet reaches a style attribute, and only as a hex value.\n  if (!HEX.test(value)) throw new Error(`not a hex colour: ${value}`);\n  return `<span class=\"swatch\" style=\"background: ${value}\" aria-hidden=\"true\"></span><code>${escapeHtml(value)}</code>`;\n}\n\nfunction tokensTable(ctx) {\n  const rows = ctx.tokens.map(t => {\n    const cell = scheme => t.default\n      ? `<td>${swatch(ctx.theme[scheme][t.default] ?? missing(t.default, scheme))}</td>`\n      : `<td>${renderInline(t.unset)}</td>`;\n    // What it affects comes before the defaults, so a phone shows it without scrolling the table.\n    return [`<th scope=\"row\"><code>${escapeHtml(t.name)}</code></th>`, `<td class=\"wide\">${renderInline(t.affects)}</td>`, cell('light'), cell('dark')];\n  });\n  return htmlTable(['Property', 'What it affects', 'Light default', 'Dark default'], rows, 'Theme custom properties');\n}\n\nfunction missing(name, scheme) {\n  throw new Error(`axylo.css has no ${name} in the ${scheme} scheme`);\n}\n\nfunction internalTokensTable(ctx) {\n  const rows = ctx.internalTokens.map(t => [`<th scope=\"row\"><code>${escapeHtml(t.name)}</code></th>`, `<td>${renderInline(t.why)}</td>`]);\n  return htmlTable(['Property', 'Why it exists'], rows, 'Internal custom properties');\n}\n\n/** Keys and text from the library's defaultMessages; where each is shown from data/messages.mjs, key for key. */\nfunction messagesTable(ctx, link) {\n  const keys = Object.keys(ctx.messages);\n  const unknown = Object.keys(ctx.messageUses).filter(key => !keys.includes(key));\n  const undescribed = keys.filter(key => !Object.hasOwn(ctx.messageUses, key));\n  if (unknown.length || undescribed.length) {\n    throw new Error(`apps/docs/data/messages.mjs and defaultMessages differ: ${[...undescribed.map(k => `no entry for ${k}`), ...unknown.map(k => `${k} is not a message key`)].join(', ')}`);\n  }\n  const rows = Object.entries(ctx.messages).map(([key, text]) => [\n    `<th scope=\"row\"><code>${escapeHtml(key)}</code></th>`, `<td>${escapeHtml(text)}</td>`, `<td>${renderInline(ctx.messageUses[key], link)}</td>`,\n  ]);\n  return htmlTable(['Key', 'Built-in English text', 'Where it is shown'], rows, 'Built-in messages');\n}\n\nfunction paletteTable(ctx) {\n  const rows = [];\n  for (let slot = 1; ; slot++) {\n    const name = `--axylo-default-series-${slot}`;\n    if (!(name in ctx.theme.light)) break;\n    rows.push([`<th scope=\"row\">${slot}</th>`, `<td>${swatch(ctx.theme.light[name])}</td>`, `<td>${swatch(ctx.theme.dark[name])}</td>`]);\n  }\n  if (rows.length === 0) throw new Error('axylo.css: no series colours');\n  return htmlTable(['Slot', 'Light', 'Dark'], rows, 'Default palette');\n}\n\n// ---------- diagnostics ----------\n\n/**\n * What each code's minimal input prints. Inputs that run in Node go through the installed package's\n * `validate()`, so the page shows the message exactly as the library writes it; the others need a page\n * (contrast, size, labels, formatters, appends) and show the registry's message for the sample details in\n * the data file, which the browser test compares with what the page prints.\n */\nasync function diagnosticOutput(diagnostics) {\n  const lib = await import(pathToFileURL(path.join(installed('axylo'), 'dist/axylo.js')).href);\n  const registry = await importSource('packages/axylo/src/diagnostics/registry.ts');\n  const out = new Map();\n  for (const d of diagnostics) {\n    // The minimal input first, then each further case: one list of printed lines per input.\n    out.set(d.code, [d, ...(d.cases ?? [])].map((input, i) => {\n      const which = i === 0 ? 'the minimal input' : `case \"${input.label}\"`;\n      if (input.run === 'node') {\n        const found = new Function('validate', `return ${input.input}`)(lib.validate);\n        const mine = found.filter(x => x.code === d.code && (i === 0 || x.field === input.outcome.field));\n        if (mine.length === 0) throw new Error(`${d.code}: ${which} does not raise it (got ${found.map(x => `${x.code} ${x.field ?? ''}`).join(', ') || 'nothing'})`);\n        return mine.map(x => `[axylo ${x.code}] ${JSON.stringify(x.chart)}: ${x.message}`);\n      }\n      if (!input.sample) throw new Error(`${d.code}: ${which} runs in a browser and needs a sample`);\n      const made = registry.createDiagnostic(d.code, input.sample.effect ?? 'none', input.sample.details ?? {});\n      return [`[axylo ${d.code}] ${JSON.stringify(input.sample.chart ?? 'Chart title')}: ${made.message}`];\n    }));\n  }\n  return out;\n}\n\nfunction renderDiagnosticPage(d, ctx) {\n  const ids = reservedIds();\n  const md = s => markdownToHtml(s, { ids, link: url => pageLink(url, path.join(pagesDir, 'x.md'), '../', ctx) });\n  const index = ctx.diagnostics.indexOf(d);\n  const prev = ctx.diagnostics[index - 1];\n  const next = ctx.diagnostics[index + 1];\n  const how = input => input.run === 'node'\n    ? 'Checked with <code>validate()</code> from the packed package when this site was built; the message is its output.'\n    : 'This needs a page to arise. The documentation\\'s browser test runs this input and checks the code, the field, what the reader sees and that the message printed is the one shown here, which the build made from the registry with the details of this input.';\n  const printed = ctx.seen.get(d.code);\n  const cases = d.cases ?? [];\n  for (const id of ['top', 'what-you-see', 'why', 'how-to-fix', 'minimal-input', 'other-cases', ...cases.map((_, i) => `case-${i + 1}`)]) ids.add(id);\n  // Each printed block has an id, so the browser test can compare it with what the library prints.\n  const output = i => `<div id=\"output-${i}\">${codeBlock(printed[i].join('\\n'), 'text')}</div>`;\n  const other = cases.length ? `<h2 id=\"other-cases\">Other inputs that raise it</h2>\n${cases.map((c, i) => `<h3 id=\"case-${i + 1}\">${escapeHtml(c.label)}</h3>\n${codeBlock(c.input, 'js')}\n${output(i + 1)}\n${outcomeTable(d.code, c, `What this input does: ${c.label}`)}\n<p class=\"small\">${how(c)}</p>`).join('\\n')}` : '';\n  const body = `<p class=\"crumb\"><a href=\"../diagnostics.html\">Diagnostics</a> › ${d.code}</p>\n<h1 id=\"top\">${d.code}: ${escapeHtml(d.title)}</h1>\n<p><span class=\"level level-${d.level}\">${escapeHtml(d.level)}</span> ${renderInline(levelText(d.level))}</p>\n<h2 id=\"what-you-see\">What you see</h2>\n${md(d.see)}\n${output(0)}\n<h2 id=\"why\">Why</h2>\n${md(d.why)}\n<h2 id=\"how-to-fix\">How to fix it</h2>\n${md(d.fix)}\n<h2 id=\"minimal-input\">A minimal input that raises it</h2>\n${codeBlock(d.input, 'js')}\n${outcomeTable(d.code, d, 'What the minimal input does')}\n<p class=\"small\">${how(d)}</p>\n${other}\n<nav class=\"pager\" aria-label=\"Previous and next code\">${prev ? `<a rel=\"prev\" href=\"${prev.code}.html\">← ${prev.code}</a>` : '<span></span>'}${next ? `<a rel=\"next\" href=\"${next.code}.html\">${next.code} →</a>` : ''}</nav>`;\n  return layout({ title: `${d.code}: ${d.title}`, body, current: 'diagnostics', base: '../', ctx, sourceFile: 'apps/docs/data/diagnostics.mjs' });\n}\n\n/** The checked facts of one input: the same ones the tests assert. */\nfunction outcomeTable(code, input, name) {\n  const o = input.outcome;\n  const reader = o.reader === 'nothing' ? 'No note and no message: the chart as drawn.'\n    : o.reader === 'fallback' ? 'The title, a short summary and the table control, in place of the plot.'\n      : o.reader.startsWith('note: ') ? `The note “${escapeHtml(o.reader.slice(6))}” in the figure.`\n        : o.reader.startsWith('message: ') ? `“${escapeHtml(o.reader.slice(9))}” in place of the plot.`\n          : missingReader(code);\n  const rows = [\n    ['Why it raises the code', renderInline(o.because)],\n    ['Field', o.field === null ? 'None: it is about the chart as a whole.' : `<code>${escapeHtml(o.field)}</code>`],\n    ...(o.rows ? [['Rows', o.rows.join(', ')]] : []),\n    ['Reader sees', reader],\n    ['In <code>chart.diagnostics</code>', o.listed === false ? 'No: printed and passed to <code>onDiagnostic</code> when the call is made, since it changes nothing.' : 'Yes.'],\n    ['A strict chart', o.strict ? 'Throws, from the call that gave this input.' : 'Does not throw.'],\n  ];\n  return `<div class=\"table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"${escapeHtml(name)}\"><table><tbody>${rows.map(([k, v]) => `<tr><th scope=\"row\">${k}</th><td>${v}</td></tr>`).join('')}</tbody></table></div>`;\n}\n\nfunction missingReader(code) {\n  throw new Error(`${code}: outcome.reader must be nothing, fallback, note: … or message: …`);\n}\n\nfunction levelText(level) {\n  if (level === 'error') return 'Something cannot be drawn as given: the chart, a series, or the donut. Printed in every build.';\n  if (level === 'warning') return 'Something is not drawn as given, or an option is ignored. Printed in every build.';\n  return 'Advice for the author; the chart is drawn as given unless this page says otherwise. Printed in development builds only.';\n}\n\n// ---------- source pages ----------\n\nfunction writeSourcePage(outDir, relative, ctx) {\n  const text = fs.readFileSync(path.join(repoRoot, relative), 'utf8').replace(/\\n$/, '');\n  const depth = relative.split('/').length; // source/<relative>.html\n  const base = '../'.repeat(depth);\n  const numbered = text.split('\\n').map((line, i) => `<span class=\"line\" id=\"L${i + 1}\">${escapeHtml(line)}\\n</span>`).join('');\n  const at = ctx.revision.dirty ? `revision ${ctx.revision.short} with uncommitted changes` : `revision ${ctx.revision.short}`;\n  const body = `<p class=\"crumb\">Repository file, as it was at ${escapeHtml(at)} when this site was built</p>\n<h1 id=\"top\" class=\"source-title\"><code>${escapeHtml(relative)}</code></h1>\n<pre class=\"source-file\" tabindex=\"0\"><code>${numbered}</code></pre>`;\n  const file = path.join(outDir, sourcePath(relative));\n  fs.mkdirSync(path.dirname(file), { recursive: true });\n  fs.writeFileSync(file, layout({ title: relative, body, current: null, base, ctx, sourceFile: relative }));\n}\n\n// ---------- layout ----------\n\nfunction layout({ title, body, current, base, ctx, sourceFile }) {\n  const links = () => nav.map(group => `<li><span class=\"nav-section\">${escapeHtml(group.section)}</span><ul>${group.pages.map(p =>\n    `<li><a href=\"${base}${p.page}.html\"${p.page === current ? ' aria-current=\"page\"' : ''}>${escapeHtml(p.label)}</a></li>`).join('')}</ul></li>`).join('');\n  const at = ctx.revision.dirty ? `${ctx.revision.short} with uncommitted changes` : ctx.revision.short;\n  return `<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>${escapeHtml(title)} · Axylo</title>\n<link rel=\"icon\" href=\"data:,\">\n<link rel=\"stylesheet\" href=\"${base}assets/site.css\">\n<script src=\"${base}assets/page.js\" defer></script>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<header class=\"site-header\">\n<a class=\"brand\" href=\"${base}index.html\">Axylo</a><span class=\"tagline\">Documentation for 1.0</span>\n</header>\n<details class=\"nav-mobile\"><summary>Pages</summary><nav aria-label=\"Documentation\"><ul class=\"nav-list\">${links()}</ul></nav></details>\n<div class=\"layout\">\n<nav class=\"nav-side\" aria-label=\"Documentation\"><ul class=\"nav-list\">${links()}</ul></nav>\n<main id=\"main\">\n<article>\n${body}\n</article>\n<footer class=\"page-footer\"><p>Source of this page: <code>${escapeHtml(sourceFile)}</code>. Built from revision ${escapeHtml(at)}. The live examples run the packed packages (version ${escapeHtml(ctx.version)}, development condition), installed into a clean consumer.</p>${ctx.unchecked.length ? `<p><strong>Not for publishing:</strong> this site was built against a packed library that is not the build of its source (${escapeHtml(ctx.unchecked.join('; '))}).</p>` : ''}</footer>\n</main>\n</div>\n</body>\n</html>\n`;\n}\n\n// ---------- checks ----------\n\n/**\n * Every link in the built site resolves inside it (the deployment root): pages, their anchors (line anchors\n * of source pages included), assets and example pages. No page has two elements with the same id.\n */\nexport function checkSite(outDir) {\n  const problems = [];\n  const files = [];\n  const walk = dir => {\n    for (const f of fs.readdirSync(dir)) {\n      const p = path.join(dir, f);\n      if (fs.statSync(p).isDirectory()) walk(p);\n      else if (f.endsWith('.html')) files.push(p);\n    }\n  };\n  walk(outDir);\n  const idsCache = new Map();\n  const idsOf = file => {\n    if (!idsCache.has(file)) idsCache.set(file, [...fs.readFileSync(file, 'utf8').matchAll(/\\sid=\"([^\"]+)\"/g)].map(m => m[1]));\n    return idsCache.get(file);\n  };\n  for (const file of files) {\n    const ids = idsOf(file);\n    const dup = ids.filter((id, i) => ids.indexOf(id) !== i);\n    if (dup.length) problems.push(`${path.relative(outDir, file)}: duplicate ids ${[...new Set(dup)].join(', ')}`);\n    const html = fs.readFileSync(file, 'utf8');\n    for (const m of html.matchAll(/\\s(?:href|src)=\"([^\"]+)\"/g)) {\n      const url = m[1].replace(/&amp;/g, '&');\n      if (/^(https:|mailto:|data:)/i.test(url)) continue;\n      if (/^[a-z][a-z0-9+.-]*:/i.test(url) || url.startsWith('//')) { problems.push(`${path.relative(outDir, file)} → ${url} (scheme not allowed)`); continue; }\n      const [target, hash] = url.split('#');\n      const resolved = target === '' ? file : path.resolve(path.dirname(file), decodeURIComponent(target));\n      if (!resolved.startsWith(outDir + path.sep)) { problems.push(`${path.relative(outDir, file)} → ${url} (outside the site)`); continue; }\n      if (!fs.existsSync(resolved)) { problems.push(`${path.relative(outDir, file)} → ${url}`); continue; }\n      if (hash && resolved.endsWith('.html') && !idsOf(resolved).includes(hash)) problems.push(`${path.relative(outDir, file)} → ${url} (no such anchor)`);\n    }\n  }\n  return problems;\n}\n/**\n * The Markdown subset the documentation pages use, and nothing more: ATX headings (# to ####), paragraphs,\n * fenced code blocks, pipe tables, flat bulleted and numbered lists, block quotes, whole-line HTML comments\n * (dropped), and the inline forms `code`, **strong**, *emphasis*, [links](url) and backslash escapes.\n *\n * Raw HTML is never passed through: every character of text is escaped, so a page cannot inject markup. Link\n * destinations are limited to site-relative paths, fragments, `https:` and `mailto:`; anything else throws.\n * A line that is only a link whose text starts with `example:`, `source:`, `table:` or `output:` is a directive, always\n * a block of its own; the caller decides what it becomes.\n */\n\nconst ESCAPES = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' };\n\n/** Escapes text for HTML element content and quoted attribute values. */\nexport function escapeHtml(text) {\n  return String(text).replace(/[&<>\"']/g, c => ESCAPES[c]);\n}\n\n/**\n * A link destination the site may emit: a relative path (no scheme, not protocol-relative), a fragment, an\n * `https:` URL or a `mailto:` address. Throws otherwise, naming the destination.\n */\nexport function checkHref(url) {\n  const value = String(url);\n  if (/[\\s<>\"'`\\\\]/.test(value) || value === '') throw new Error(`Link destination ${JSON.stringify(value)} is not allowed: it contains a space, quote or angle bracket, or is empty`);\n  if (value.startsWith('#')) return value;\n  if (/^https:\\/\\/[^/]/i.test(value) || /^mailto:[^:/]+@[^:/]+$/i.test(value)) return value;\n  if (value.startsWith('//') || /^[a-z][a-z0-9+.-]*:/i.test(value)) {\n    throw new Error(`Link destination ${JSON.stringify(value)} is not allowed: only relative paths, fragments, https: and mailto: are`);\n  }\n  return value;\n}\n\n/**\n * A heading's id, made the way GitHub makes it, so that a link to `data.md#three-kinds-of-time` works on a\n * code host and on the site alike: lower case, punctuation dropped, each space a hyphen.\n */\nexport function slug(text) {\n  return plainText(text).trim().toLowerCase().replace(/[^\\p{L}\\p{N}\\s_-]/gu, '').replace(/\\s/g, '-') || 'section';\n}\n\n/** The text a reader sees in inline Markdown: markers and link targets removed. */\nexport function plainText(text) {\n  return text\n    .replace(/\\\\([\\\\`*_[\\]()|#<>!-])/g, '$1')\n    .replace(/`([^`]*)`/g, '$1')\n    .replace(/\\[([^\\]]*)\\]\\((?:[^()]|\\([^()]*\\))*\\)/g, '$1')\n    .replace(/\\*\\*([^*]+)\\*\\*/g, '$1')\n    .replace(/\\*([^*]+)\\*/g, '$1');\n}\n\nexport const DIRECTIVE = /^\\[(example|source|table|output):\\s*([^\\]]+)\\]\\(([^)\\s]+)\\)$/;\nconst FENCE = /^(`{3,})\\s*([\\w-]*)\\s*$/;\nconst HEADING = /^(#{1,4})\\s+(.+?)\\s*#*\\s*$/;\nconst BULLET = /^[-*]\\s+(.*)$/;\nconst NUMBERED = /^(\\d+)\\.\\s+(.*)$/;\nconst TABLE_RULE = /^\\|?\\s*:?-{3,}:?\\s*(\\|\\s*:?-{3,}:?\\s*)*\\|?\\s*$/;\nconst COMMENT = /^<!--.*-->$/;\n\n/**\n * Converts `source` to HTML.\n * - `link(url)` rewrites a link destination (for example `data.md#gaps` to `data.html#gaps`); its result is\n *   checked with `checkHref`.\n * - `directive({ kind, name, target })` returns the HTML for a directive line.\n * - `headings` receives each heading as { level, text, id } in order.\n * - `ids` is the set of ids already used on the page; headings get ids not in it, block quotes included.\n */\nexport function markdownToHtml(source, { link = url => url, directive, headings = [], ids = new Set() } = {}) {\n  const lines = source.replace(/\\r\\n?/g, '\\n').split('\\n');\n  const out = [];\n  const inline = text => renderInline(text, link);\n  // Each table's scroll region is named after the heading it sits under, so that no two share a name.\n  let section = null;\n  const tableNames = new Map();\n  const tableName = () => {\n    const n = (tableNames.get(section) ?? 0) + 1;\n    tableNames.set(section, n);\n    const table = n === 1 ? 'Table' : `Table ${n}`;\n    return section === null ? table : `${table}: ${section}`;\n  };\n\n  let i = 0;\n  while (i < lines.length) {\n    const line = lines[i];\n    const trimmed = line.trim();\n    if (trimmed === '' || COMMENT.test(trimmed)) { i++; continue; }\n\n    const fence = FENCE.exec(line);\n    if (fence) {\n      const body = [];\n      i++;\n      while (i < lines.length && !lines[i].startsWith(fence[1])) body.push(lines[i++]);\n      if (i < lines.length) i++;\n      out.push(codeBlock(body.join('\\n'), fence[2]));\n      continue;\n    }\n\n    const d = DIRECTIVE.exec(trimmed);\n    if (d) {\n      if (!directive) throw new Error(`A directive is not allowed here: ${trimmed}`);\n      out.push(directive({ kind: d[1], name: d[2].trim(), target: d[3] }));\n      i++;\n      continue;\n    }\n\n    const heading = HEADING.exec(line);\n    if (heading) {\n      const level = heading[1].length;\n      const id = uniqueId(slug(heading[2]), ids);\n      headings.push({ level, text: plainText(heading[2]), id });\n      section = plainText(heading[2]);\n      out.push(`<h${level} id=\"${escapeHtml(id)}\">${inline(heading[2])}</h${level}>`);\n      i++;\n      continue;\n    }\n\n    if (line.startsWith('|') && i + 1 < lines.length && TABLE_RULE.test(lines[i + 1])) {\n      const rows = [];\n      const align = splitRow(lines[i + 1]).map(cell => cell.endsWith(':') ? (cell.startsWith(':') ? 'center' : 'right') : null);\n      const header = splitRow(line);\n      i += 2;\n      while (i < lines.length && lines[i].startsWith('|')) rows.push(splitRow(lines[i++]));\n      out.push(table(header, rows, align, inline, tableName()));\n      continue;\n    }\n\n    if (line.startsWith('>')) {\n      const body = [];\n      while (i < lines.length && lines[i].startsWith('>')) body.push(lines[i++].replace(/^>\\s?/, ''));\n      out.push(`<blockquote>${markdownToHtml(body.join('\\n'), { link, directive: undefined, headings, ids })}</blockquote>`);\n      continue;\n    }\n\n    const bullet = BULLET.exec(line);\n    const numbered = NUMBERED.exec(line);\n    if (bullet || numbered) {\n      const ordered = !bullet;\n      const marker = ordered ? NUMBERED : BULLET;\n      const items = [];\n      const start = ordered ? Number(numbered[1]) : 1;\n      while (i < lines.length) {\n        const m = marker.exec(lines[i]);\n        if (m) { items.push(ordered ? m[2] : m[1]); i++; continue; }\n        // A continuation line is indented; a blank line or anything else ends the list.\n        if (/^\\s{2,}\\S/.test(lines[i]) && items.length) { items[items.length - 1] += ' ' + lines[i].trim(); i++; continue; }\n        break;\n      }\n      const tag = ordered ? 'ol' : 'ul';\n      const startAttr = ordered && start !== 1 ? ` start=\"${start}\"` : '';\n      out.push(`<${tag}${startAttr}>${items.map(item => `<li>${inline(item)}</li>`).join('')}</${tag}>`);\n      continue;\n    }\n\n    const paragraph = [];\n    while (i < lines.length && lines[i].trim() !== '' && (paragraph.length === 0 || !startsBlock(lines, i))) paragraph.push(lines[i++].trim());\n    out.push(`<p>${inline(paragraph.join(' '))}</p>`);\n  }\n  return out.join('\\n');\n}\n\n/** `base`, or `base-2`, `base-3` … : the first not yet used on the page. Reserves it. */\nexport function uniqueId(base, ids) {\n  let id = base;\n  for (let n = 2; ids.has(id); n++) id = `${base}-${n}`;\n  ids.add(id);\n  return id;\n}\n\nfunction startsBlock(lines, i) {\n  const line = lines[i];\n  return FENCE.test(line) || HEADING.test(line) || line.startsWith('>') || BULLET.test(line) || NUMBERED.test(line) ||\n    COMMENT.test(line.trim()) || DIRECTIVE.test(line.trim()) ||\n    (line.startsWith('|') && i + 1 < lines.length && TABLE_RULE.test(lines[i + 1]));\n}\n\n/** Splits a table row on pipes that are not escaped; `\\|` stays in the cell as a literal pipe. */\nexport function splitRow(line) {\n  const cells = [];\n  let cell = '';\n  const body = line.trim().replace(/^\\|/, '').replace(/(?<!\\\\)\\|$/, '');\n  for (let i = 0; i < body.length; i++) {\n    const c = body[i];\n    if (c === '\\\\' && body[i + 1] === '|') { cell += '\\\\|'; i++; continue; }\n    if (c === '|') { cells.push(cell.trim()); cell = ''; continue; }\n    cell += c;\n  }\n  cells.push(cell.trim());\n  return cells;\n}\n\nfunction table(header, rows, align, inline, name = 'Table') {\n  const style = index => align[index] ? ` style=\"text-align: ${align[index]}\"` : '';\n  const head = header.map((cell, index) => `<th scope=\"col\"${style(index)}>${inline(cell)}</th>`).join('');\n  const body = rows.map(row => `<tr>${header.map((_, index) => `<td${style(index)}>${inline(row[index] ?? '')}</td>`).join('')}</tr>`).join('');\n  // The wrapper scrolls a wide table on a narrow screen, so the page itself never scrolls sideways.\n  return `<div class=\"table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"${escapeHtml(name)}\"><table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>`;\n}\n\nexport function codeBlock(code, language = '') {\n  const cls = language ? ` class=\"language-${escapeHtml(language)}\"` : '';\n  return `<pre tabindex=\"0\"><code${cls}>${escapeHtml(code)}</code></pre>`;\n}\n\n/**\n * The end of a link destination that starts at `open` (the index of its `(`): balanced parentheses, so\n * `guide(v2).md` is one destination. -1 when it does not close.\n */\nfunction destinationEnd(text, open) {\n  let depth = 0;\n  for (let i = open; i < text.length; i++) {\n    if (text[i] === '\\\\') { i++; continue; }\n    if (text[i] === '(') depth++;\n    else if (text[i] === ')' && --depth === 0) return i;\n    else if (/\\s/.test(text[i])) return -1;\n  }\n  return -1;\n}\n\n/** Inline Markdown to HTML. Unmatched markers are kept as text. */\nexport function renderInline(text, link = url => url) {\n  let out = '';\n  let i = 0;\n  while (i < text.length) {\n    const c = text[i];\n    if (c === '\\\\' && i + 1 < text.length && /[\\\\`*_[\\]()|#<>!-]/.test(text[i + 1])) {\n      out += escapeHtml(text[i + 1]);\n      i += 2;\n      continue;\n    }\n    if (c === '`') {\n      let run = 1;\n      while (text[i + run] === '`') run++;\n      const fence = '`'.repeat(run);\n      const end = text.indexOf(fence, i + run);\n      if (end !== -1) {\n        // Inside a table cell a literal pipe is written `\\|`; the backslash is not part of the code.\n        const code = text.slice(i + run, end).replace(/\\\\\\|/g, '|');\n        out += `<code>${escapeHtml(run > 1 ? code.trim() : code)}</code>`;\n        i = end + run;\n        continue;\n      }\n    }\n    if (c === '[') {\n      const close = matchBracket(text, i);\n      if (close !== -1 && text[close + 1] === '(') {\n        const end = destinationEnd(text, close + 1);\n        if (end !== -1) {\n          const label = text.slice(i + 1, close);\n          const url = text.slice(close + 2, end).trim();\n          out += `<a href=\"${escapeHtml(checkHref(link(url)))}\">${renderInline(label, link)}</a>`;\n          i = end + 1;\n          continue;\n        }\n      }\n    }\n    if (c === '*' && text[i + 1] === '*') {\n      const end = text.indexOf('**', i + 2);\n      if (end > i + 2) {\n        out += `<strong>${renderInline(text.slice(i + 2, end), link)}</strong>`;\n        i = end + 2;\n        continue;\n      }\n    }\n    if (c === '*' && text[i + 1] !== ' ' && text[i + 1] !== '*') {\n      const end = text.indexOf('*', i + 1);\n      if (end > i + 1 && text[end - 1] !== ' ') {\n        out += `<em>${renderInline(text.slice(i + 1, end), link)}</em>`;\n        i = end + 1;\n        continue;\n      }\n    }\n    out += escapeHtml(c);\n    i++;\n  }\n  return out;\n}\n\nfunction matchBracket(text, open) {\n  let depth = 0;\n  for (let i = open; i < text.length; i++) {\n    if (text[i] === '\\\\') { i++; continue; }\n    if (text[i] === '`') {\n      const end = text.indexOf('`', i + 1);\n      if (end !== -1) { i = end; continue; }\n    }\n    if (text[i] === '[') depth++;\n    if (text[i] === ']' && --depth === 0) return i;\n  }\n  return -1;\n}\n\n/** Words of prose in a page, for the report: code blocks, comments and table rules are not counted. */\nexport function wordCount(source) {\n  let inCode = false;\n  let words = 0;\n  for (const line of source.split('\\n')) {\n    if (FENCE.test(line)) { inCode = !inCode; continue; }\n    if (inCode || COMMENT.test(line.trim()) || TABLE_RULE.test(line) || DIRECTIVE.test(line.trim())) continue;\n    words += plainText(line.replace(/\\|/g, ' ')).split(/\\s+/).filter(w => /[\\p{L}\\p{N}]/u.test(w)).length;\n  }\n  return words;\n}\n/**\n * Runnable examples: files in apps/docs/examples, each one a complete program a reader can copy.\n *\n * - `name.ts`: a module that imports from 'axylo' and draws into elements it names by id, as in\n *   `line('#chart', …)`. Its host is a page with one empty <div> per id, and a bundler (or an import map)\n *   that resolves `axylo`.\n * - `name.html`: the body of a page: markup and scripts. A module script imports `axylo` by name, so its\n *   page needs a bundler or an import map; a classic script uses the `Axylo` global of the script-tag file.\n * - `_name.ts`: a helper module shared by examples (the Phase 1 fixtures), not an example.\n *\n * What an example promises is written in its own comments, in words the reader sees too:\n * - \"Raises AX111 on purpose\" (or \"Raises AX102, AX103 and AX106 on purpose\") lists the diagnostics it\n *   demonstrates; the browser test fails on any other code, and on a listed code that does not appear.\n * - \"Draws no marks on purpose\" marks an example whose charts show a state (loading, empty, error) instead.\n */\nimport fs from 'node:fs';\nimport path from 'node:path';\n\nexport const docsRoot = path.resolve(import.meta.dirname, '..');\nexport const repoRoot = path.resolve(docsRoot, '../..');\nexport const examplesDir = path.join(docsRoot, 'examples');\n/** Generated inputs that are not the site: the packed consumer and compiler probes. Git-ignored. */\nexport const cacheDir = path.join(docsRoot, '.cache');\n\nconst CHART_CALL = /\\b(?:line|area|bar|scatter|donut)\\(\\s*(['\"])#([\\w-]+)\\1|getElementById\\(\\s*(['\"])([\\w-]+)\\3\\s*\\)/g;\nconst RAISES = /Raises ((?:AX\\d{3})(?:(?:, | and )AX\\d{3})*) on purpose/;\nconst NO_MARKS = /Draws no marks on purpose/;\nexport const MODULE_SCRIPT = /<script type=\"module\">([\\s\\S]*?)<\\/script>/g;\nexport const CLASSIC_SCRIPT = /<script>([\\s\\S]*?)<\\/script>/g;\nconst HELPER_IMPORT = /from '\\.\\/(_[\\w-]+)'/g;\n\n/**\n * The first-chart snippets of the repository (examples/first-chart, maintained with the distribution tests)\n * also run on the site, under these names, so the Getting started page shows them live beside their source.\n */\nexport const EXTERNAL = [\n  { name: 'first-chart-npm', path: 'examples/first-chart/npm.ts' },\n  { name: 'first-chart-script', path: 'examples/first-chart/script.html' },\n];\n\nexport function listExamples() {\n  const own = fs.readdirSync(examplesDir)\n    .filter(file => /\\.(ts|html)$/.test(file) && !file.endsWith('.d.ts') && !file.startsWith('_'))\n    .sort()\n    .map(file => readExample(file));\n  const external = EXTERNAL.filter(e => fs.existsSync(path.join(repoRoot, e.path)))\n    .map(e => readExample(path.basename(e.path), path.join(repoRoot, path.dirname(e.path)), e.name));\n  return [...external, ...own];\n}\n\n/** Helper modules (`_name.ts`) the examples import. */\nexport function listHelpers() {\n  return fs.readdirSync(examplesDir).filter(file => /^_[\\w-]+\\.ts$/.test(file)).sort();\n}\n\nexport function readExample(file, dir = examplesDir, as = null) {\n  const ext = path.extname(file).slice(1);\n  const name = as ?? path.basename(file, path.extname(file));\n  const source = fs.readFileSync(path.join(dir, file), 'utf8');\n  const repoFile = path.relative(repoRoot, path.join(dir, file)).split(path.sep).join('/');\n  // The script-tag snippet is a whole document that loads the package from a CDN.\n  const documentPage = ext === 'html' && /^<!doctype html>/i.test(source.trimStart());\n  const raises = RAISES.exec(source)?.[1].split(/, | and /) ?? [];\n  const targets = ext === 'ts' ? [...new Set([...source.matchAll(CHART_CALL)].map(m => m[2] ?? m[4]))] : [];\n  if (ext === 'ts' && targets.length === 0) throw new Error(`${file}: no chart call with a '#id' target, and no getElementById('id')`);\n  const helpers = [...new Set([...source.matchAll(HELPER_IMPORT)].map(m => `${m[1]}.ts`))];\n  for (const helper of helpers) if (!fs.existsSync(path.join(examplesDir, helper))) throw new Error(`${file}: imports ${helper}, which does not exist`);\n  const scriptTag = ext === 'html' && /<script src=\"[^\"]*axylo\\.iife(?:\\.min)?\\.js\"><\\/script>/.test(source);\n  return { file, name, ext, source, repoFile, raises, noMarks: NO_MARKS.test(source), targets, helpers, scriptTag, documentPage };\n}\n\n/** The scripts of an .html example, in order, with the line each starts on. */\nexport function htmlScripts(example) {\n  const out = [];\n  let n = 0;\n  for (const m of example.source.matchAll(MODULE_SCRIPT)) {\n    out.push({ kind: 'module', file: `${example.name}.${++n}.js`, line: lineOf(example.source, m.index), code: m[1], match: m[0] });\n  }\n  for (const m of example.source.matchAll(CLASSIC_SCRIPT)) {\n    out.push({ kind: 'classic', file: `${example.name}.${++n}.classic.js`, line: lineOf(example.source, m.index), code: m[1], match: m[0] });\n  }\n  return out;\n}\n\nfunction lineOf(text, index) {\n  return text.slice(0, index).split('\\n').length;\n}\n\n/** What a reader must supply around an example to run it on their own page. */\nexport function hostOf(example) {\n  if (example.documentPage) {\n    return { markup: null, text: 'A whole page. Its two URLs point at jsDelivr, which serves published npm packages. Axylo is not published yet, so this site serves the page with those two files taken from the packed package, and adds its own stylesheet (for the font and colours of the frame) and the script that sizes the frame.' };\n  }\n  if (example.ext === 'ts') {\n    return {\n      markup: example.targets.map(id => `<div id=\"${id}\"></div>`).join('\\n'),\n      text: `The page needs ${example.targets.length === 1 ? 'an element' : 'elements'} with ${example.targets.map(id => `id \"${id}\"`).join(', ')}, and a bundler (or an import map) that resolves the \\`axylo\\` package.`,\n    };\n  }\n  if (example.scriptTag) {\n    return { markup: null, text: 'This is the body of a page. It loads `axylo.iife.js` from the same folder: copy that file from `node_modules/axylo/dist/`.' };\n  }\n  return { markup: null, text: 'This is the body of a page. Its module script imports `axylo` by name, so the page needs a bundler or an import map that resolves it.' };\n}\n\n/**\n * Copies the examples into the packed consumer's `src`, so that they resolve `axylo` from the installed\n * tarball: .ts files and helpers as they are; each script of an .html example as\n * a .js file (classic scripts get `export {}` for a scope of their own, and a declaration of the `Axylo`\n * global from the package's own types); the Node examples under `src/node`.\n */\nexport function writeConsumerSources(consumerDir) {\n  const src = path.join(consumerDir, 'src');\n  fs.rmSync(src, { recursive: true, force: true });\n  fs.mkdirSync(path.join(src, 'node'), { recursive: true });\n  for (const e of listExamples().filter(e => e.ext !== 'html')) {\n    fs.writeFileSync(path.join(src, `${e.name}.${e.ext}`), e.source);\n  }\n  for (const file of listHelpers()) fs.copyFileSync(path.join(examplesDir, file), path.join(src, file));\n  fs.writeFileSync(path.join(src, 'globals.d.ts'), \"declare const Axylo: typeof import('axylo');\\n\");\n  const scripts = {};\n  for (const example of listExamples().filter(e => e.ext === 'html')) {\n    for (const script of htmlScripts(example)) {\n      fs.writeFileSync(path.join(src, script.file), script.kind === 'classic' ? script.code + '\\nexport {};\\n' : script.code);\n      scripts[script.file] = { example: example.file, line: script.line, kind: script.kind };\n    }\n  }\n  for (const file of fs.readdirSync(path.join(examplesDir, 'node')).filter(f => f.endsWith('.ts'))) {\n    fs.copyFileSync(path.join(examplesDir, 'node', file), path.join(src, 'node', file));\n  }\n  return { src, scripts };\n}\n/**\n * A clean consumer of the packed packages, for the documentation's examples (spec DX10), set up the way\n * tests/dist does it (tests/dist/README.md, scripts/pack.mjs): `npm pack` each package as npm would publish\n * it, then `npm install --offline` the tarballs through `file:` specifiers into a project of its own, so\n * nothing is linked to the workspace. The consumer lives under apps/docs/.cache (git-ignored):\n *\n *   .cache/packed/<name>-<version>.tgz     the tarballs\n *   .cache/consumer/package.json           axylo\n *   .cache/consumer/node_modules           npm's install of those, offline\n *   .cache/consumer/src/…                  copies of the examples, so they resolve from the consumer\n *\n * The consumer sits under the repository, whose root node_modules links the workspace packages; anything it\n * did not install could be found there by walking up. `guard()` (esbuild) and `listFilesOutside()`\n * (TypeScript) turn such a fallback into an error.\n */\nimport { execFileSync } from 'node:child_process';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { cacheDir, repoRoot } from './examples.mjs';\n\nexport const PACKAGES = { axylo: 'packages/axylo' };\nexport const packedDir = path.join(cacheDir, 'packed');\nexport const consumerDir = path.join(cacheDir, 'consumer');\nconst windows = process.platform === 'win32';\n\n// npm started through npm run or Vitest passes its own settings down as npm_config_* variables; the consumer\n// installs with defaults, as tests/dist does.\nconst env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !/^npm_/i.test(k)));\nconst npm = (args, options) =>\n  execFileSync(windows ? 'npm.cmd' : 'npm', args, { encoding: 'utf8', shell: windows, env, stdio: 'pipe', ...options });\n\nexport const inside = (parent, child) => {\n  const relative = path.relative(parent, child);\n  return relative !== '' && !relative.startsWith('..') && !path.isAbsolute(relative);\n};\n\nfunction walk(dir, base = dir) {\n  return fs.readdirSync(dir, { withFileTypes: true }).flatMap(e =>\n    e.isDirectory() ? walk(path.join(dir, e.name), base) : [path.relative(base, path.join(dir, e.name)).split(path.sep).join('/')]);\n}\n\n/**\n * Packs both packages from their current dist and installs them into the consumer. The install is skipped\n * when the consumer already holds exactly these tarballs (same integrity). Returns what npm pack reported.\n */\nexport function prepareConsumer({ log = () => {} } = {}) {\n  fs.rmSync(packedDir, { recursive: true, force: true });\n  fs.mkdirSync(packedDir, { recursive: true });\n  const packed = {};\n  for (const [name, dir] of Object.entries(PACKAGES)) {\n    const [report] = JSON.parse(npm(['pack', '--json', '--ignore-scripts', '--pack-destination', packedDir], { cwd: path.join(repoRoot, dir) }));\n    packed[name] = { tarball: report.filename, integrity: report.integrity, version: report.version, files: report.files.map(f => f.path).sort() };\n  }\n  fs.mkdirSync(consumerDir, { recursive: true });\n  const manifest = {\n    name: 'axylo-docs-consumer',\n    private: true,\n    type: 'module',\n    description: 'Installs the packed tarballs for the documentation examples (apps/docs/lib/consumer.mjs). Generated.',\n    dependencies: { axylo: `file:../packed/${packed.axylo.tarball}` },\n  };\n  fs.writeFileSync(path.join(consumerDir, 'package.json'), JSON.stringify(manifest, null, 2) + '\\n');\n  const record = path.join(consumerDir, '.installed.json');\n  const wanted = JSON.stringify(Object.fromEntries(Object.entries(packed).map(([n, p]) => [n, p.integrity])));\n  const current = fs.existsSync(record) ? fs.readFileSync(record, 'utf8') : '';\n  if (current !== wanted || !fs.existsSync(path.join(consumerDir, 'node_modules/axylo'))) {\n    fs.rmSync(path.join(consumerDir, 'node_modules'), { recursive: true, force: true });\n    const install = mode => npm(['install', mode, '--ignore-scripts', '--no-audit', '--no-fund', '--no-package-lock', '--loglevel=error'], { cwd: consumerDir });\n    // Only the local tarball is installed, so nothing comes from a registry or the npm cache.\n    install('--offline');\n    fs.writeFileSync(record, wanted);\n    log(`docs consumer: installed ${Object.values(packed).map(p => p.tarball).join(', ')}`);\n  }\n  for (const [name, p] of Object.entries(packed)) {\n    const at = path.join(consumerDir, 'node_modules', name);\n    if (fs.lstatSync(at).isSymbolicLink()) throw new Error(`docs consumer: npm linked ${name} instead of installing the tarball`);\n    if (walk(at).sort().join('\\n') !== p.files.join('\\n')) throw new Error(`docs consumer: installed ${name} differs from npm pack's file list`);\n  }\n  return packed;\n}\n\n/** The installed package's directory in the consumer. */\nexport const installed = name => path.join(consumerDir, 'node_modules', name);\n\n/** An esbuild plugin that fails the build when an import resolves outside the consumer. */\nexport function guard(roots = [consumerDir]) {\n  return {\n    name: 'docs-consumer-guard',\n    setup(build) {\n      build.onResolve({ filter: /.*/ }, async args => {\n        if (args.pluginData?.guarded || args.kind === 'entry-point') return undefined;\n        const result = await build.resolve(args.path, {\n          kind: args.kind, importer: args.importer, resolveDir: args.resolveDir, namespace: args.namespace, pluginData: { guarded: true },\n        });\n        if (result.errors.length > 0 || result.external || result.namespace !== 'file') return result;\n        if (!roots.some(r => inside(r, result.path))) {\n          return { errors: [{ text: `[docs consumer guard] ${JSON.stringify(args.path)} from ${args.importer} resolved outside the consumer, to ${result.path}` }] };\n        }\n        return result;\n      });\n    },\n  };\n}\n\n/**\n * Files TypeScript read (`--listFiles` output) that are neither in the consumer nor the compiler's own\n * libraries: a declaration found by walking up into the workspace.\n */\nexport function listFilesOutside(listing, allowed = []) {\n  const typescript = path.dirname(fs.realpathSync(path.join(repoRoot, 'node_modules/typescript/package.json')));\n  return listing.split(/\\r?\\n/).map(l => l.trim()).filter(Boolean).filter(file => {\n    const at = path.resolve(file);\n    if (inside(consumerDir, at) || inside(typescript, at) || /[\\\\/]@typescript[\\\\/]/.test(at) || /[\\\\/]lib\\.[\\w.]*\\.d\\.ts$/.test(at)) return false;\n    return !allowed.some(dir => inside(path.join(repoRoot, 'node_modules', dir), at));\n  });\n}\n\nconst STRICT = {\n  target: 'ES2022', module: 'ESNext', moduleResolution: 'Bundler', strict: true, noUncheckedIndexedAccess: true,\n  noImplicitOverride: true, noFallthroughCasesInSwitch: true, isolatedModules: true, noEmit: true, skipLibCheck: false,\n  types: [],\n};\n\n/**\n * The consumer's TypeScript configurations: one for the browser examples (the .ts files, and the\n * scripts of the .html examples as JavaScript under checkJs, all strict), one for the Node examples. Library\n * checking is on, so the packed declarations are checked as a consumer's compiler reads them.\n */\nexport function writeConsumerTsconfigs() {\n  const browser = {\n    compilerOptions: { ...STRICT, lib: ['ES2022', 'DOM', 'DOM.Iterable'], allowJs: true, checkJs: true },\n    include: ['src/*.ts', 'src/*.js'],\n  };\n  const node = { compilerOptions: { ...STRICT, lib: ['ES2022', 'DOM'] }, include: ['src/node/*.ts'] };\n  fs.writeFileSync(path.join(consumerDir, 'tsconfig.json'), JSON.stringify(browser, null, 2));\n  fs.writeFileSync(path.join(consumerDir, 'tsconfig.node.json'), JSON.stringify(node, null, 2));\n  return { browser: path.join(consumerDir, 'tsconfig.json'), node: path.join(consumerDir, 'tsconfig.node.json') };\n}\n/**\n * The options reference (apps/docs/pages/options.md) against the public types, read with the TypeScript\n * compiler API (typescript/unstable/sync, TypeScript 7) from the source declarations, so it needs no build:\n *\n * - keys: every key of every option type, field type, handle and event in packages/axylo/src/public.ts (and\n *   in the reference, and nothing else is;\n * - types: each documented type is the declared type of that key, both ways assignable (`Options` in the\n *   reference stands for the chart's options type, checked as LineOptions<Row>);\n * - required: a key documented with default \"required\" is required in the type, and every other key is\n *   optional. Defaults written in `code` are checked against the running chart by defaults.browser.test.ts.\n *\n * Each table in the reference is marked `<!-- options: Group -->`; its first column holds the key, its second\n * the type, and for option tables the third the default. GROUPS says which type each group documents.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { API } from 'typescript/unstable/sync';\nimport { cacheDir, docsRoot, repoRoot } from '../lib/examples.mjs';\nimport { defaultMessages } from '../../../packages/axylo/src/messages/index';\nimport { messageUses } from '../data/messages.mjs';\n\nconst L = 'LineOptions<Row>';\n/** The type a group documents, and the keys of that type the group stands for. */\nconst GROUPS: Record<string, { type: string; keys: string }> = {\n  CommonOptions: { type: 'CommonOptions<Row>', keys: 'Keys<CommonOptions<Row>>' },\n  Title: { type: 'Title', keys: 'Keys<Title>' },\n  Encoding: { type: 'Encoding<Row>', keys: 'Keys<Encoding<Row>>' },\n  CartesianOptions: { type: 'CartesianOptions', keys: 'Keys<CartesianOptions>' },\n  Reference: { type: 'Reference', keys: 'Keys<Reference>' },\n  CompactOption: { type: 'CompactOption', keys: 'Keys<CompactOption>' },\n  AreaOptions: { type: 'AreaOptions<Row>', keys: `Exclude<Keys<AreaOptions<Row>>, Keys<${L}>>` },\n  BarOptions: { type: 'BarOptions<Row>', keys: `Exclude<Keys<BarOptions<Row>>, Keys<${L}>>` },\n  ScatterOptions: { type: 'ScatterOptions<Row>', keys: 'Exclude<Keys<ScatterOptions<Row>>, Keys<CommonOptions<Row>> | Keys<CartesianOptions>>' },\n  DonutOptions: { type: 'DonutOptions<Row>', keys: 'Exclude<Keys<DonutOptions<Row>>, Keys<CommonOptions<Row>>>' },\n  ValueField: { type: 'Exclude<ValueField<Row>, string>', keys: 'Keys<Exclude<ValueField<Row>, string>>' },\n  XField: { type: 'Exclude<XField<Row>, string>', keys: 'Keys<Exclude<XField<Row>, string>>' },\n  ScatterXField: { type: 'Exclude<ScatterXField<Row>, string>', keys: 'Keys<Exclude<ScatterXField<Row>, string>>' },\n  Chart: { type: `Chart<Row, ${L}>`, keys: `Keys<Chart<Row, ${L}>>` },\n  AppendOptions: { type: `NonNullable<Parameters<Chart<Row, ${L}>['append']>[1]>`, keys: `Keys<NonNullable<Parameters<Chart<Row, ${L}>['append']>[1]>>` },\n  ChartEvents: { type: 'ChartEvents<Row>', keys: 'Keys<ChartEvents<Row>>' },\n  Point: { type: 'Point<Row>', keys: 'Keys<Point<Row>>' },\n  Diagnostic: { type: 'Diagnostic', keys: 'Keys<Diagnostic>' },\n};\n// Checks on the types themselves, so a key added to a composite type directly is not missed.\nconst EXTRA: Record<string, string> = {\n  LineOptions: `Keys<${L}>`,\n  Messages: 'Keys<Messages>',\n};\n\ninterface Row { key: string; type: string; def: string | null }\n\n/** Rows per marked table of options.md: the key(s) in the first cell, the type, the default if there is one. */\nfunction documented(): Record<string, Row[]> {\n  const source = fs.readFileSync(path.join(docsRoot, 'pages/options.md'), 'utf8').split('\\n');\n  const out: Record<string, Row[]> = {};\n  const cells = (line: string) => line.trim().replace(/^\\|/, '').replace(/\\|$/, '').split(/(?<!\\\\)\\|/).map(c => c.trim().replace(/\\\\\\|/g, '|'));\n  const code = (cell: string) => /^``\\s(.+)\\s``$/.exec(cell)?.[1] ?? /^`([^`]+)`$/.exec(cell)?.[1] ?? null;\n  for (let i = 0; i < source.length; i++) {\n    const marker = /^<!-- options: (\\w+) -->$/.exec(source[i]!.trim());\n    if (!marker) continue;\n    const header = cells(source[i + 1]!);\n    const hasDefault = header[2] === 'Default';\n    const rows: Row[] = [];\n    for (let j = i + 3; j < source.length && source[j]!.startsWith('|'); j++) {\n      const [key, type, def] = cells(source[j]!);\n      const name = code(key!);\n      const typeText = code(type!);\n      if (name === null || typeText === null) throw new Error(`options.md, ${marker[1]}: row ${j + 1} needs a key and a type in code: ${source[j]}`);\n      rows.push({ key: name.replace(/^data-\\*$/, 'data-*'), type: typeText, def: hasDefault ? def! : null });\n    }\n    out[marker[1]!] = rows;\n  }\n  return out;\n}\n\nconst docs = documented();\nconst dir = path.join(cacheDir, 'types');\nconst probe = path.join(dir, 'probe.ts');\nlet api: API;\nconst results: Record<string, string> = {};\n\n/** `\"a\" | \"b\" | \\`data-${string}\\`` → ['a', 'b', 'data-*']. */\nfunction parseUnion(text: string): string[] {\n  if (text === 'never') return [];\n  return text.split(' | ').map(part => part.startsWith('\"') ? JSON.parse(part) as string : part.replace(/^`(.*)\\$\\{string\\}`$/, '$1*')).sort();\n}\n\nconst keyType = (key: string) => key === 'data-*' ? '`data-${string}`' : JSON.stringify(key);\nconst documentedType = (text: string) => text.replace(/\\bOptions\\b/g, L);\n\nbeforeAll(() => {\n  fs.mkdirSync(dir, { recursive: true });\n  const rel = (p: string) => path.relative(dir, path.join(repoRoot, p)).split(path.sep).join('/');\n  fs.writeFileSync(path.join(dir, 'tsconfig.json'), JSON.stringify({\n    extends: rel('tsconfig.base.json'),\n    compilerOptions: {\n      noEmit: true, types: [],\n      paths: { axylo: [rel('packages/axylo/src/index.ts')] },\n    },\n    files: ['probe.ts', rel('packages/axylo/src/core/globals.d.ts')],\n  }, null, 2));\n  const lines = [\n    \"import type { AreaOptions, BarOptions, CartesianOptions, Chart, ChartEvents, CommonOptions, CompactOption, Data, Diagnostic, DonutOptions, Encoding, LineOptions, Messages, NumberKey, Point, Reference, ScatterOptions, ScatterXField, SeriesKey, StringKey, Title, ValueField, XField, XKey, XValue } from 'axylo';\",\n    'interface Row { day: string; v: number; s: string }',\n    'type Keys<T> = T extends unknown ? { [K in keyof T]-?: [Exclude<T[K], undefined>] extends [never] ? never : K }[keyof T] : never;',\n    'type Prop<T, K extends PropertyKey> = T extends unknown ? (K extends keyof T ? Exclude<T[K], undefined> : never) : never;',\n    \"type Need<T, K extends PropertyKey> = T extends unknown ? (K extends keyof T ? ({} extends Pick<T, K> ? 'optional' : 'required') : never) : never;\",\n    \"type Same<A, B> = [A] extends [B] ? ([B] extends [A] ? 'same' : 'documented is wider') : ([B] extends [A] ? 'documented is narrower' : 'different');\",\n  ];\n  const probes: string[] = [];\n  for (const [group, { keys }] of Object.entries(GROUPS)) probes.push(`keys_${group}`) && lines.push(`export declare const keys_${group}: ${keys};`);\n  for (const [name, keys] of Object.entries(EXTRA)) probes.push(`keys_${name}`) && lines.push(`export declare const keys_${name}: ${keys};`);\n  for (const [group, rows] of Object.entries(docs)) {\n    const target = GROUPS[group]?.type;\n    if (!target) continue;\n    rows.forEach((row, i) => {\n      lines.push(`export declare const type_${group}_${i}: Same<Prop<${target}, ${keyType(row.key)}>, ${documentedType(row.type)}>;`);\n      lines.push(`export declare const need_${group}_${i}: Need<${target}, ${keyType(row.key)}>;`);\n      probes.push(`type_${group}_${i}`, `need_${group}_${i}`);\n    });\n  }\n  fs.writeFileSync(probe, lines.join('\\n') + '\\n');\n  api = new API({ cwd: dir });\n  const snapshot = api.updateSnapshot({ openProjects: [path.join(dir, 'tsconfig.json')] });\n  const project = snapshot.getProjects()[0]!;\n  const errors = project.program.getSemanticDiagnostics(probe).concat(project.program.getSyntacticDiagnostics(probe));\n  if (errors.length) throw new Error('The probe of documented types does not compile; a documented type is not valid TypeScript:\\n' + errors.map(e => JSON.stringify((e as { messageText?: unknown }).messageText ?? e)).join('\\n'));\n  const text = project.program.getSourceFile(probe)!.text;\n  for (const name of probes) {\n    const type = project.checker.getTypeAtPosition(probe, text.indexOf(`${name}:`));\n    // 1 = TypeFormatFlags.NoTruncation: the whole union, however long.\n    results[name] = project.checker.typeToString(type!, undefined, 1);\n  }\n}, 120_000);\n\nafterAll(() => api?.close());\n\ndescribe('options reference against the public types', () => {\n  it('every marked table is a known group, and every group has a table', () => {\n    expect(Object.keys(docs).sort()).toEqual(Object.keys(GROUPS).sort());\n  });\n\n  it.each(Object.keys(GROUPS))('%s: documented keys equal the type\\'s keys', group => {\n    const types = parseUnion(results[`keys_${group}`]!);\n    const listed = (docs[group] ?? []).map(r => r.key).sort();\n    expect(types.length, `${group} has keys`).toBeGreaterThan(0);\n    expect({ missingFromReference: types.filter(k => !listed.includes(k)), notInTypes: listed.filter(k => !types.includes(k)) })\n      .toEqual({ missingFromReference: [], notInTypes: [] });\n  });\n\n  it.each(Object.keys(GROUPS))('%s: each documented type is the declared type', group => {\n    const wrong = (docs[group] ?? []).map((row, i) => ({ key: row.key, documented: row.type, result: results[`type_${group}_${i}`] }))\n      .filter(r => r.result !== '\"same\"');\n    expect(wrong).toEqual([]);\n  });\n\n  it.each(Object.keys(GROUPS).filter(g => docs[g]?.some(r => r.def !== null)))('%s: \"required\" exactly where the type requires the key', group => {\n    const wrong = (docs[group] ?? []).map((row, i) => ({ key: row.key, documented: row.def, type: results[`need_${group}_${i}`] }))\n      .filter(r => (r.documented === 'required') !== (r.type === '\"required\"'));\n    expect(wrong).toEqual([]);\n  });\n\n  it('LineOptions is exactly the common, encoding, cartesian and compact groups', () => {\n    const groups = ['CommonOptions', 'Encoding', 'CartesianOptions', 'CompactOption'].flatMap(g => parseUnion(results[`keys_${g}`]!));\n    expect(parseUnion(results.keys_LineOptions!)).toEqual([...new Set(groups)].sort());\n  });\n\n  it('the generated Messages table lists every key of Messages', () => {\n    // The table is generated from defaultMessages; this checks that defaultMessages has exactly the type's keys.\n    expect(Object.keys(defaultMessages).sort()).toEqual(parseUnion(results.keys_Messages!));\n  });\n\n  it('the table says where each message is shown, for exactly those keys', () => {\n    expect(Object.keys(messageUses).sort()).toEqual(parseUnion(results.keys_Messages!));\n    expect(Object.entries(messageUses).filter(([, where]) => typeof where !== 'string' || where.trim() === '')).toEqual([]);\n  });\n});\n/**\n * What each runnable example must show, beyond \"it renders\": how many charts it has, a value that comes from\n * its own data (read back from the chart's value text, summary, legend or table), and the interaction the\n * example teaches. Expected values are derived from the example's data by hand or from the Phase 1 fixture\n * (research/harness/src/data.js), never from the library's output.\n */\nimport { expect } from 'vitest';\nimport type { Page } from 'playwright-core';\nimport { trend, bars } from '../../../research/harness/src/data.js';\n\nexport interface Tools {\n  page: Page;\n  /** Focuses chart `index`'s plot, presses `keys`, returns its value text. */\n  value(index: number, keys: string[]): Promise<string>;\n  /** The figure's description: its generated summary. */\n  desc(index: number): Promise<string>;\n  /** The figure's accessible name. */\n  name(index: number): Promise<string>;\n  note(index: number): Promise<string>;\n  message(index: number): Promise<string>;\n  legend(index: number): Promise<string[]>;\n  toolbar(index: number): Promise<string[]>;\n  /** Opens the table of chart `index` and returns its rows, cells joined by ' | '. */\n  table(index: number): Promise<string[]>;\n  text(selector: string): Promise<string>;\n  click(selector: string): Promise<void>;\n  /** The computed stroke of the `n`th series line of chart `index`. */\n  stroke(index: number, n: number): Promise<string>;\n  /** Waits until `fn` (evaluated in the page) is truthy. */\n  until(fn: string, timeout?: number): Promise<void>;\n}\n\ninterface Check { charts: number; run: (t: Tools) => Promise<void> }\n\nconst n = (value: number) => value.toLocaleString('en-US');\nconst has = (text: string, ...parts: string[]) => { for (const part of parts) expect(text).toContain(part); };\n\nconst valueText = async (t: Tools, index: number, keys: string[], ...parts: string[]) => has(await t.value(index, keys), ...parts);\n\nexport const checks: Record<string, Check> = {\n  'first-chart-npm': { charts: 1, run: t => valueText(t, 0, ['Home'], n(4210), 'Point 1 of 4') },\n  'first-chart-script': { charts: 1, run: t => valueText(t, 0, ['End'], n(5127), 'Point 4 of 4') },\n  'a11y-card': { charts: 1, run: async t => {\n    expect(await t.name(0)).toBe('Checkout latency by region');\n    has(await t.desc(0), 'payment provider outage');\n    await valueText(t, 0, ['Home'], 'Europe 310 ms', 'North America 405 ms');\n  } },\n  'area-incomplete': { charts: 1, run: t => valueText(t, 0, ['Home', 'ArrowRight', 'ArrowRight'], 'Mobile No data', 'incomplete') },\n  // Spec F10: a series with no row at an x is a missing part of the stack there. 2 March has both rows\n  // (120 + 300); 3 March has only the web row (120 + 5), so its total is incomplete.\n  'area-uneven': { charts: 1, run: async t => {\n    const first = await t.value(0, ['Home']);\n    has(first, 'Mar 2, 2026', 'Web 120', 'Call centre 300', 'Total 420');\n    expect(first).not.toContain('incomplete');\n    await valueText(t, 0, ['Home', 'ArrowRight'], 'Mar 3, 2026', 'Web 125', 'Total 125 (incomplete)');\n  } },\n  'area-mixed': { charts: 1, run: t => valueText(t, 0, ['Home', 'ArrowRight'], 'Mar 9, 2026', 'Total 12 k USD and -7 k USD') },\n  'area-stacked': { charts: 1, run: t => valueText(t, 0, ['Home'], `Direct ${n(45000)}`, `Organic search ${n(28621)}`, `Referral ${n(4752)}`, `Total ${n(78373)}`) },\n  'bar-horizontal': { charts: 1, run: async t => {\n    await valueText(t, 0, ['Home'], 'Account settings and profile', '2025 42', '2026 51');\n    await valueText(t, 0, ['Home', 'ArrowRight', 'ArrowRight'], 'Partner integrations', '2026 No data');\n  } },\n  'bar-stacked': { charts: 1, run: async t => {\n    await valueText(t, 0, ['Home'], '2025 Q1', 'Total 165 k USD and -60 k USD');\n    expect(await t.name(0)).toBe('Revenue gains and losses by quarter');\n  } },\n  'bar-target': { charts: 1, run: async t => {\n    await valueText(t, 0, ['Home'], 'Billing', '94%');\n    has(await t.desc(0), 'Target');\n  } },\n  'compact-dirty': { charts: 1, run: async t => {\n    has(await t.desc(0), 'maximum 1.8', 'Values not shown: 1');\n    expect(await t.name(0)).toBe('Error rate, last 14 days');\n  } },\n  'compact-tiles': { charts: 3, run: async t => {\n    // 30 days of the tile formula: the sum of sessions and revenue, and the errors on day 30.\n    expect(await t.text('#sessions-total')).toBe(n(50781));\n    expect(await t.text('#revenue-total')).toBe('$' + n(184909));\n    expect(await t.text('#errors-latest')).toBe('30');\n    expect(await t.name(2)).toBe('Errors on the latest day');\n    has(await t.desc(2), 'last 30');\n  } },\n  'daily-sessions': { charts: 1, run: async t => {\n    // Run in Los Angeles: with type 'date', 24 February stays 24 February.\n    await valueText(t, 0, ['Home'], 'Feb 24, 2026', n(3120), 'Point 1 of 5');\n    const rows = await t.table(0);\n    expect(rows).toContain('Feb 26, 2026 | No data');\n  } },\n  'data-columns': { charts: 1, run: t => valueText(t, 0, ['Home'], `Direct ${n(3120)}`, 'Referral 410', 'Point 1 of 4') },\n  'data-long': { charts: 1, run: t => valueText(t, 0, ['Home'], `Direct ${n(3120)}`, 'Referral 410', 'Point 1 of 4') },\n  'data-wide': { charts: 1, run: t => valueText(t, 0, ['Home'], `Direct ${n(3120)}`, 'Referral 410', 'Point 1 of 4') },\n  dates: { charts: 2, run: async t => {\n    // Los Angeles: midnight UTC on 24 February is 4 PM on the 23rd; the date string is the 24th.\n    await valueText(t, 0, ['Home'], 'Feb 23, 2026', 'PST', 'sessions 120');\n    await valueText(t, 1, ['Home'], 'Feb 24, 2026', 'sessions 120');\n  } },\n  'diagnostics-listener': { charts: 1, run: async t => {\n    const log = await t.text('#log');\n    has(log, 'AX103 (warning), field value, rows 3', 'AX106 (warning), field value, rows 4', 'AX102 (warning), field value, rows 5');\n    expect(await t.note(0)).toBe('Values not shown: 3. See table.');\n  } },\n  'donut-basic': { charts: 1, run: async t => {\n    has((await t.legend(0)).join(' / '), 'Chrome', '46.2%', 'Other');\n    await valueText(t, 0, ['Home'], 'Chrome', '46.2%');\n  } },\n  'donut-many': { charts: 1, run: async t => {\n    const legend = (await t.legend(0)).join(' / ');\n    has(legend, 'Other (2)', 'Iceland', 'Malta', 'No data', 'United States');\n    expect(legend).not.toContain('Spain');\n    const table = (await t.table(0)).join(' / ');\n    has(table, 'Spain', 'Norway', 'Iceland', 'Malta');\n  } },\n  lifecycle: { charts: 1, run: async t => {\n    // Mounted, unmounted and mounted again on one element: one chart, showing the data of the last refresh.\n    expect(await t.page.evaluate(() => document.querySelectorAll('#chart figure').length)).toBe(1);\n    await valueText(t, 0, ['Home'], 'Mar 9, 2026', `sessions ${n(3400)}`, 'Point 1 of 7');\n  } },\n  'line-dense': { charts: 1, run: async t => {\n    await valueText(t, 0, ['End'], 'Point 100,000 of 100,000');\n    has(await t.desc(0), 'maximum 97 %');\n  } },\n  'line-dirty': { charts: 1, run: async t => {\n    expect(await t.note(0)).toBe('Values not shown: 3. See table.');\n    await valueText(t, 0, ['Home'], 'Mon', 'value 10');\n  } },\n  'line-many-series': { charts: 1, run: async t => {\n    expect((await t.legend(0)).length + (await t.toolbar(0)).filter(b => /^(North|South|East|West|Central|Coast|Hills|Plains|Lakes|Islands|Valley|Delta)$/.test(b)).length).toBeGreaterThanOrEqual(12);\n    await valueText(t, 0, ['Home'], 'North 100');\n  } },\n  'line-time': { charts: 1, run: async t => {\n    await valueText(t, 0, ['Home'], 'Mar 10, 2026, 12:00 AM UTC', 'checkout 320 ms', 'search 230 ms');\n    has(await t.desc(0), 'Times are shown in UTC', 'Reference band Incident', 'Reference line Objective');\n  } },\n  'messages-translated': { charts: 2, run: async t => {\n    expect(await t.note(0)).toBe('Werte nicht angezeigt: 1. Siehe Tabelle.');\n    expect(await t.note(1)).toBe('Werte nicht angezeigt: 1.');\n    has((await t.toolbar(0)).join(), 'Als Tabelle anzeigen');\n  } },\n  'migrate-stream': { charts: 1, run: async t => {\n    await t.until(`[...document.querySelectorAll('.axylo-toolbar button')].some(b => b.textContent === 'Pause')`);\n    await valueText(t, 0, ['End'], 'Point 600 of 600');\n  } },\n  'migrate-target': { charts: 1, run: t => valueText(t, 0, ['Home'], bars.categories[0]!, `${bars.values[0]}%`) },\n  'migrate-trend': { charts: 1, run: t => valueText(t, 0, ['Home'], `Direct ${n(trend.series[0]!.values[0]!)}`, `Referral ${n(trend.series[2]!.values[0]!)}`) },\n  missing: { charts: 2, run: async t => {\n    const gaps = await t.table(0);\n    expect(gaps).toEqual(expect.arrayContaining(['Mar 2, 2026 | 0', 'Mar 3, 2026 | No data', 'Mar 4, 2026 | No data']));\n    const zeros = await t.table(1);\n    expect(zeros).toEqual(expect.arrayContaining(['Mar 3, 2026 | 0', 'Mar 4, 2026 | 0']));\n  } },\n  'numeric-strings': { charts: 1, run: async t => {\n    await valueText(t, 0, ['Home'], 'Orders 182');\n    has(await t.desc(0), 'maximum 231');\n  } },\n  // The first point by x, then y: rows 0 and 95 both have size 5; row 95 (ap-south) has the lower latency.\n  'scatter-basic': { charts: 1, run: t => valueText(t, 0, ['Home'], 'ap-south, 5 KB, 22 ms') },\n  'scatter-missing-y': { charts: 1, run: async t => {\n    // Three points; the fourth row has no latency and is listed in the table only.\n    await valueText(t, 0, ['End'], 'Point 3 of 3');\n    const rows = (await t.table(0)).join(' / ');\n    has(rows, '48 KB', 'No data');\n  } },\n  'scatter-ties': { charts: 1, run: t => valueText(t, 0, ['End'], 'Point 16 of 16') },\n  'script-tag': { charts: 1, run: t => valueText(t, 0, ['Home'], n(3120), 'Point 1 of 5') },\n  states: { charts: 4, run: async t => {\n    expect(await t.message(0)).toBe('Loading chart.');\n    expect(await t.message(1)).toBe('No data to show.');\n    expect(await t.message(2)).toBe('No refunds yet.');\n    expect(await t.message(3)).toBe('The query timed out.');\n  } },\n  stream: { charts: 1, run: async t => {\n    expect(await t.toolbar(0)).not.toContain('Pause');\n    await t.until(`[...document.querySelectorAll('.axylo-toolbar button')].some(b => b.textContent === 'Pause')`);\n    await valueText(t, 0, ['End'], 'Point 60 of 60');\n  } },\n  strict: { charts: 1, run: async t => {\n    await t.click('#bad');\n    has(await t.text('#result'), 'Rejected: [axylo AX106]', '\"n/a\"');\n    await valueText(t, 0, ['End'], `sessions ${n(3290)}`, 'Point 3 of 3');\n  } },\n  'theme-colors': { charts: 2, run: async t => {\n    // Referral is the third series of the first chart and the first of the second: one colour on both.\n    expect(await t.stroke(0, 2)).toBe(await t.stroke(1, 0));\n    expect(await t.stroke(0, 2)).not.toBe(await t.stroke(0, 0));\n  } },\n  'theme-tokens': { charts: 1, run: async t => {\n    expect(await t.stroke(0, 0)).toBe('rgb(11, 110, 79)');\n    const font = await t.page.evaluate(() => getComputedStyle(document.querySelector('.axylo-text')!).fontFamily);\n    expect(font).toContain('Georgia');\n    await valueText(t, 0, ['Home'], 'Signups 820', 'Churned 360');\n  } },\n  'theme-toggle': { charts: 1, run: async t => {\n    const axis = () => t.page.evaluate(() => getComputedStyle(document.querySelector('.axylo-svg line[style*=\"--axylo-axis\"]')!).stroke);\n    const before = await axis();\n    await t.click('#theme');\n    await t.until(`document.documentElement.dataset.theme === 'dark'`);\n    await t.page.waitForTimeout(150);\n    expect(await axis()).not.toBe(before);\n  } },\n  unsorted: { charts: 1, run: t => valueText(t, 0, ['Home'], 'Mar 2, 2026', 'tickets 51') },\n  units: { charts: 2, run: async t => {\n    await valueText(t, 0, ['Home'], '3.1%');\n    await valueText(t, 1, ['End'], n(1210) + ' ms');\n  } },\n  update: { charts: 1, run: async t => {\n    await t.click('#next');\n    await t.click('#subtitle');\n    await t.page.waitForTimeout(150);\n    has(await t.text('.axylo-subtitle'), 'Week of 9 March');\n    await valueText(t, 0, ['Home'], 'Mar 9, 2026', 'orders 190');\n    await t.click('#metric');\n    await t.page.waitForTimeout(150);\n    await valueText(t, 0, ['Home'], `Revenue ${n(7724)} USD`);\n  } },\n  'wide-keys': { charts: 1, run: async t => {\n    await t.value(0, ['Home', 'Enter']);\n    expect(await t.text('#picked')).toBe('Direct on 2026-03-02: 3120 (row 0)');\n    expect(await t.stroke(0, 0)).toBe('rgb(31, 111, 178)');\n  } },\n  zoom: { charts: 1, run: async t => {\n    await t.click('#last-week');\n    await t.until(`document.querySelector('#range').textContent !== 'Showing everything.'`);\n    expect(await t.text('#range')).toBe('Showing 2026-03-25 to 2026-03-31.');\n    // The event is sent from the call; the zoomed view is drawn in the next frame.\n    await t.page.waitForTimeout(150);\n    await t.value(0, ['Home', 'Enter']);\n    expect(await t.text('#picked')).toBe(`Selected sessions on 2026-03-25: ${3569} (row 24).`);\n    // Select range (spec I4, the toggle the page documents): two clicks on the plot set the two ends, here the\n    // later one first, and the toggle releases itself. Between 35% and 75% of the plot's width lie fewer than the\n    // 31 days of March, so the zoomed view has fewer points, whatever the width; the clicks select nothing.\n    await t.click('#all');\n    await t.until(`document.querySelector('#range').textContent === 'Showing everything.'`);\n    await t.page.waitForTimeout(150);\n    const toggle = t.page.locator('#chart').getByRole('button', { name: 'Select range' });\n    await toggle.click();\n    expect(await toggle.getAttribute('aria-pressed')).toBe('true');\n    const plot = (await t.page.locator('#chart .axylo-plot').boundingBox())!;\n    await t.page.mouse.click(plot.x + plot.width * 0.75, plot.y + plot.height / 2);\n    await t.page.mouse.click(plot.x + plot.width * 0.35, plot.y + plot.height / 2);\n    await t.until(`document.querySelector('#range').textContent !== 'Showing everything.'`);\n    expect(await t.text('#range')).toMatch(/^Showing \\S+( \\(between two days\\))? to \\S+( \\(between two days\\))?\\.$/);\n    expect(await toggle.getAttribute('aria-pressed')).toBe('false');\n    expect(await t.text('#picked')).toBe(`Selected sessions on 2026-03-25: ${3569} (row 24).`);\n    await t.page.waitForTimeout(150);\n    const count = Number(/Point \\d+ of (\\d+)/.exec(await t.value(0, ['Home']))?.[1]);\n    expect(count > 1 && count < 31, `${count} points in view`).toBe(true);\n  } },\n  'zoom-linked': { charts: 2, run: async t => {\n    has(await t.desc(1), 'Mar 10, 2026, 6:00 AM UTC', 'Mar 10, 2026, 12:00 PM UTC');\n  } },\n};\n/**\n * Runs in Node, after `npm run build`, with the browser suite (it needs the packed packages, not a browser).\n * The Node examples quoted on the Diagnostics page (apps/docs/examples/node, copied into the packed consumer)\n * run against the installed tarball: validate.ts as a script, chart-data.test.ts as a Vitest test in a run of\n * its own rooted in the consumer.\n */\nimport { beforeAll, describe, expect, it } from 'vitest';\nimport { execFileSync } from 'node:child_process';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { createRequire } from 'node:module';\nimport { buildSite } from '../lib/site.mjs';\nimport { repoRoot } from '../lib/examples.mjs';\nimport { consumerDir, installed } from '../lib/consumer.mjs';\n\nbeforeAll(async () => { await buildSite(); }, 180_000);\n\ndescribe('Node examples, against the packed package', () => {\n  it('validate.ts runs and finds nothing blocking', () => {\n    const out = execFileSync(process.execPath, ['--experimental-strip-types', '--no-warnings', path.join(consumerDir, 'src/node/validate.ts')], { cwd: consumerDir, encoding: 'utf8' });\n    expect(out.trim()).toBe('Checked \"Orders per day\": 0 diagnostics, none blocking.');\n  });\n\n  it('chart-data.test.ts passes as a test', () => {\n    fs.writeFileSync(path.join(consumerDir, 'vitest.config.mjs'), \"export default { test: { include: ['src/node/*.test.ts'] } };\\n\");\n    const vitest = path.join(repoRoot, 'node_modules/vitest/vitest.mjs');\n    const out = execFileSync(process.execPath, [vitest, 'run', '--root', consumerDir, '--config', path.join(consumerDir, 'vitest.config.mjs')], { cwd: consumerDir, encoding: 'utf8', env: { ...process.env, AXYLO_BROWSER: '' } });\n    expect(out).toMatch(/Tests\\s+1 passed \\(1\\)/);\n  });\n\n  it('the example resolves the installed tarball, not the workspace', () => {\n    const require = createRequire(path.join(consumerDir, 'src/node/validate.ts'));\n    const resolved = fs.realpathSync(require.resolve('axylo'));\n    expect(path.dirname(path.dirname(resolved))).toBe(fs.realpathSync(installed('axylo')));\n  });\n});\n{\n  // For editors only. The examples are type-checked by the tests in a clean consumer of the packed\n  // packages (apps/docs/lib/consumer.mjs, consumerTsconfig), not against the workspace.\n  \"extends\": \"../../../tsconfig.base.json\",\n  \"compilerOptions\": { \"noEmit\": true, \"types\": [], \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"] },\n  \"include\": [\"*.ts\"]\n}\n{\n  // The package's declarations refer to DOM types (HTMLElement), so Node code that imports them needs the\n  // DOM library too.\n  \"extends\": \"../../../../tsconfig.base.json\",\n  \"compilerOptions\": { \"noEmit\": true, \"types\": [\"node\"], \"lib\": [\"ES2022\", \"DOM\"] },\n  \"include\": [\"*.ts\"]\n}\n// Runs in Node, on a server or in a build step: validate() needs no DOM.\nimport { validate } from 'axylo';\n\nconst rows = [\n  { day: '2026-03-02', orders: '182' },\n  { day: '2026-03-03', orders: '205' },\n  { day: '2026-03-04', orders: null },\n];\n\nconst problems = validate('bar', {\n  title: 'Orders per day',\n  data: rows,\n  x: 'day',\n  y: { field: 'orders', parse: 'number' },\n});\n\n// Errors and warnings mean something will not be drawn as given; hints are advice.\nconst blocking = problems.filter(d => d.level !== 'hint');\nif (blocking.length > 0) {\n  throw new Error(blocking.map(d => `${d.code} ${d.chart}: ${d.message}`).join('\\n'));\n}\nconsole.log(`Checked \"Orders per day\": ${problems.length} diagnostics, none blocking.`);\nimport { bar } from 'axylo';\n\n// Postgres returns `count(*)` as a string (bigint). Declaring the parse says that is expected.\nconst rows = [\n  { day: '2026-03-02', orders: '182' },\n  { day: '2026-03-03', orders: '205' },\n  { day: '2026-03-04', orders: '199' },\n  { day: '2026-03-05', orders: '231' },\n];\n\nbar('#chart', {\n  title: 'Orders per day',\n  data: rows,\n  x: 'day',\n  y: { field: 'orders', parse: 'number', label: 'Orders' },\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '76,235p' docs/02-product-spec.md && sed -n '38,106p;130,148p;350,387p' docs/03-plan-typescript-release.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '76,235p' docs/02-product-spec.md && sed -n '38,106p;130,148p;350,387p' docs/03-plan-typescript-release.md\"","aggregated_output":"### 2.3 Supported environments\n\n| Dimension | 1.0 |\n|---|---|\n| Browsers | The current and previous major versions of Chrome, Edge, Firefox and Safari (macOS and iOS). |\n| TypeScript | 5.4 and later. Plain JavaScript is fully supported; types are an aid, not a requirement. |\n| Frameworks | None needed. No adapter ships in 1.0; the library is called from any framework's mount and unmount hooks. |\n| Text direction | Left-to-right pages. Right-to-left text renders, but the layout is not mirrored; this is stated in the conformance table. |\n| Transformed ancestors | A chart inside a translated or scaled ancestor (any positive scale, uniform or not) is exact. Inside a rotated, skewed or mirrored ancestor it draws, but pointer picking and tooltip placement are wrong; this is not supported in 1.0 and the documentation says so (decision 0004, rule 10). |\n| Built-in text | English, overridable (A10). |\n\n## 3. Acceptance criteria: the reader's experience\n\nEvery criterion maps to at least one test in the acceptance matrix kept in the repository (criterion → test → chart types it applies to → result). \"Property test\" means the statement is checked over at least 1,000 generated datasets. Expected values come from the fixture data and this specification, never from the implementation's output.\n\n### 3.1 Faithful representation\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| F1 | Bar and area value axes always include zero. An author `domain` that excludes zero is widened and raises AX110. | Property test on domains, including all-negative and mixed-sign data; `bars` fixture (values 82–97) starts at 0 | R1 |\n| F2 | Missing values are never drawn as zero and never bridged unless the author asks. An explicit `null` is a gap, silently. An isolated value between two gaps is a visible point. A missing bar shows a \"no data\" mark at the baseline, distinct from a zero bar; a slot a series merely has no row for gets no bar and no mark. On a time or date axis with a regular step, an absent step is a gap and raises AX105; `missing: 'zero'` on the field turns absent and null values into zeros for counts. Tooltip, table and announcements say \"No data\". | `trend` with nulls and `trend` with the same 7 rows deleted render the same gap; `dirty` fixtures; property test that no segment connects across a missing index | R5 |\n| F3 | Input that cannot be plotted as given is reported, never guessed. The diagnostic registry (section 3.5) fixes each case's level, what is drawn and what the reader sees. | One test per code; the combined `dirty` fixture and the four one-bad-value fixtures yield exactly the codes listed in section 3.5 | R5, D5 |\n| F4 | Three temporal types, never mixed silently. **Calendar dates** (`2026-02-24`, `2026-02`, `2026`) read the same in every viewer time zone. **Instants** (epoch milliseconds declared `type: 'time'`, `Date` objects, ISO strings with an offset) are shown in `timeZone` (default: the viewer's), with the zone named in the tooltip heading and the description. **Wall-clock times** (date-time strings without an offset) are shown as written, with hint AX112. Instants that all fall on the same time of day, whole days apart, raise hint AX111 (\"these look like calendar dates\"). A bare number is never assumed to be an instant. | Four fixture variants in UTC, America/Los_Angeles and Asia/Kolkata: (a) date strings: identical text in all three; (b) ISO strings with `Z`, (c) epoch ms with `type: 'time'`, (d) `Date` objects: each zone's correct local text, zone visible, AX111 raised; with `timeZone: 'UTC'` or `type: 'date'`: identical. Plus: both DST transitions, a leap day, an unparseable date | R3 |\n| F5 | No smoothing. When a line is denser than the screen, the drawing is simplified with this guarantee: for every device-pixel column, and every contiguous run of valid samples inside it, the drawn stroke covers exactly that run's minimum and maximum. A break between two runs is always kept, even when both fall in one pixel column; a slot a series merely has no row for (weekly data beside daily) does not break its line, except inside a stack (F10). Stacked areas are simplified on their cumulative sums. Exact values always come from the data, not the drawing. | Assertions on which source samples the drawing kept, for: one outlier in 1,000,000; two peaks and a gap in one column; alternating valid and missing samples; tied extremes; device pixel ratio 1 and 2; several zoom levels. A sample that the drawing dropped is still reachable by keyboard and in the table | D8, D9 |\n| F6 | Numbers and dates are formatted for the page locale. Ticks and readouts are formatted separately: ticks may be compact (`50K`); tooltip, table and announcements show the full integer part, and the fraction with up to six significant digits not counting the fraction's leading zeros (`123,456.75`; `0.000123456`; `0.1 + 0.2` reads `0.3`), with the unit. A custom formatter that throws falls back to the default and raises a diagnostic. | Expected strings for chosen values (large integers, small decimals, percentages, zoned times) in `en-US`, `de-DE` and `en-IN` | R4 |\n| F7 | Domains follow one order of precedence: the zoomed view is inside the author's `domain` if given, otherwise inside the automatic domain. This rule is for value axes: the y axis of line, area and bar, and both axes of scatter. A continuous x axis of line, area or bar spans exactly its data and any x reference the chart draws (plus half a band for bars), so a time series is not padded to the next tick; so does a date or time x axis of a scatter, whose numeric x alone follows the tick rule below. After a zoom on x, a y axis with no author domain is fitted again to the values in view, by the same rules. The automatic domain contains all data, the reference lines and bands the chart draws (a compact chart draws none, so `reference` has no effect there and is reported as an option that does not apply) and stack totals, and ends at the first tick at or beyond each extreme (a compact chart draws no ticks, so its domain is the same one without being shown to end on a tick). A field declared `scale: 'percent'` (0–100) or `'ratio'` (0–1) ends at full scale only when its maximum is at least half of full scale and not above it. Nothing is inferred from a label. | Property tests; `bars` ends at 100 when declared `percent`; a 4% maximum ends at the first tick at or above 4% | R1 |\n| F8 | Donut: slices keep the given order, start at 12 o'clock and run clockwise. The legend shows every slice's value and percentage as text, in slice order. A zero slice is listed without an arc; a `null` slice is listed as \"No data\". A negative value is AX120 and the chart shows its error state. With more than eight slices that have an arc (a positive value), the seven largest are drawn and the rest of those are grouped as \"Other (n)\", with AX121; zero and `null` slices never count toward the limit and are never grouped, so each stays listed on its own; the table lists every category. Shares are shown with at most one fraction digit. An all-zero donut shows the empty state. | `parts` fixture; one test per case | R7, landscape scoreboard 3.1, WCAG 1.4.1 |\n| F9 | Up to eight series, no two share a color. Beyond eight, each series still has a unique combination of color and dash or marker (for bars, full and compact alike: color and fill pattern; for every chart type at least 32 distinct combinations, after which combinations repeat), and AX130 is raised. | Tests with 6, 8 and 12 series | R7 |\n| F10 | Stacks place positive and negative values on their own sides of zero, and the axis covers both totals. The readout's total is the sum when every component has the same sign; when signs are mixed it gives the positive total and the negative total, the two ends the reader sees, not their net. A missing component is drawn with zero height and the stack is marked \"incomplete\" in tooltip, table and announcements. A component is missing whenever its series has no value at that x, whatever the reason: a null, an absent step, or a series that simply has no row there (a weekly series stacked with a daily one is incomplete on the days between its rows; the owner's decision, 2026-11-18: a stack must never show a total made of values the data does not contain). A stacked series' line follows its band, so inside a stack it is not joined across such a slot. | Property test on stacked geometry; mixed-sign and incomplete fixtures | R5 |\n| F11 | Line, area and scatter are drawn in x order whatever the input order. On line, area and bar, two rows with the same x in one series are AX108 and that series is not drawn. On scatter, points sharing an x (or both coordinates) are ordinary data. | Shuffled `trend` renders identically; duplicate fixture | R5 |\n| F12 | When a warning means values were left out or changed, the chart says so to the reader: a short note (\"Values not shown: 2. See table.\", worded so it reads correctly for any count) inside the figure and in the accessibility tree, in every build. | Production build given `dirty` shows the note | R5, R6 |\n\n### 3.2 Legibility\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| L1 | No visible text overlaps other text or is clipped, and no label disappears without the reader being told. Remedies, in order: thin (time, date, numeric and `ordered` category axes only); wrap to at most three lines; rotate up to 45°; truncate in the middle, keeping every label distinct, with the full text in tooltip and table. If labels still do not fit, a visible note (\"Some labels hidden. See table.\") appears and AX143 suggests horizontal bars. Axylo never changes a chart's orientation on its own. | In a browser, as painted text and not in a model (in the engines of section 2.3 where results are recorded), after fonts load: for widths 240–1,920 px and generated label sets, zero intersecting text boxes (1 px tolerance), zero text outside the figure, truncated labels pairwise distinct. Repeated with the WCAG 1.4.12 text-spacing overrides, 200% text-only zoom, and a font that loads late | R2, WCAG 1.4.12, 1.4.4 |\n| L2 | Text is at least 12 CSS px and at least 4.5:1 against what is behind it, including text drawn inside a mark and legend entries for hidden series. Marks, axis lines and focus indicators are at least 3:1. Gridlines are exempt: they are not needed to read a value while the tooltip and table exist. Holds in light and dark. | Computed-style and rendered-pixel checks in both schemes | R7, R10, WCAG 1.4.3, 1.4.11 |\n| L3 | The chart follows its container with no call from the page, in both directions. With no definite height, the plot is 16:9, clamped between 160 and 480 CSS px tall, and the title, controls and table flow above and below it. A container that starts hidden or zero-sized draws when it gets a size. | Resize 720 → 360 → 720 px; hidden-then-shown test; `height: auto` container is stable over 10 frames | R16, D1 |\n| L4 | Light or dark is taken from the chart element's computed `color-scheme`; if that is not set, from the luminance of the inherited text color. `--axylo-background` overrides both. Marks repaint within one frame when the scheme, forced colors, contrast preference, or the `class`, `style` or `data-theme` of `<html>` or `<body>` changes. Forced-colors mode uses system colors. | A page that sets `color-scheme`; a class-toggled dark theme without it; a light-only page on a dark device (must stay light); a runtime toggle; forced-colors emulation | R10 |\n| L5 | A marker on every point appears only when adjacent points are at least 12 px apart (provisional value), and always for isolated points. | `trend` at 720 px has no marker on every point (A5's sparse shape markers remain); a 12-point line has them | R8 |\n| L6 | Title, subtitle and axis titles with units are part of the chart. A value axis is titled with its label (the field name when none is given) and unit. An x axis that is a measure (number) is titled the same way; a time, date or category x axis is titled only when the author gives a `label`, since its ticks already say what it is. A reference line or band shows its label next to it. Axis titles never overlap tick labels. | Layout tests; `trend` fixture | R9, WCAG 2.4.6 |\n| L7 | Empty data shows a message inside the plot area; so do loading, error and Axylo's own internal failures. No invented axis ranges, no blank box. A change of state is announced once, politely. | `empty` fixture: message visible and in the accessibility tree, no tick labels; forced internal error shows the error state | R6, WCAG 4.1.3 |\n| L8 | When the figure cannot hold a readable plot (less than 120×80 CSS px for the plot), it shows the title, a short summary (the first sentence of the generated summary, on at most two lines, cut with an ellipsis beyond that; the full summary remains the figure's description) and the table control instead, and raises AX142. | Narrow and short container tests | R2 |\n\n### 3.3 Interaction\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| I1 | Pointing anywhere in the plot shows what is there, by the picking rule for the chart type (section 3.6), within one frame at the 95th percentile. On line, area and bar the tooltip lists every visible series at the nearest x; a series with no row at that x reads \"No observation\", distinct from \"No data\". The tooltip stays inside the viewport, does not cover the active mark or any control, can itself be hovered, and lists at most eight rows plus \"+N more\". In a plot too small for it (decision 0004: narrower than 240 px or shorter than 140 px) the same content appears as text in a strip reserved under the plot; where even the strip would leave the plot under the minimum of L8, pointing highlights the datum without a readout and the values are in the keyboard reading and the table. Escape closes it until the pointer reaches a different datum. | Hover at 20 positions including all four edges; sparse-series fixture; narrow tile with eight series; Escape test | R15, WCAG 1.4.13, 2.4.11 |\n| I2 | Legend entries that show and hide a series are toggle buttons with a pressed state, operable by click, Enter and Space. A donut's legend lists its slices (F8) and has nothing to hide, so its entries are not toggles and this row does not apply to it. | Keyboard and accessibility-tree tests | R12, WCAG 2.5.3, 4.1.2, 2.1.1 |\n| I3 | Zoom on time, date and numeric x axes is reachable four ways: visible Zoom in, Zoom out and Reset buttons that work with single clicks; drag to select a range; `+`, `-`, `0` and Shift+arrows; and pinch when `zoom: 'touch'` is set. The wheel zooms only while the plot has focus, and never when Ctrl or Meta is held, so browser zoom and page scrolling are not intercepted. | Reach a given range by clicks only; by keyboard only; by drag; page scrolls normally with the pointer over an unfocused chart | D7, R12, WCAG 2.5.1, 2.1.1 |\n| I4 | Every interaction works with a single pointer without dragging, and by touch. Every control is at least 24×24 CSS px. A one-finger drag on a chart scrolls the page (on a compact chart too: it takes no pointer input at all, C1). | Touch emulation; size checks | WCAG 2.5.7, 2.5.8, 2.5.1, 2.5.3, 4.1.2, 2.1.1 |\n| I5 | First render is not animated. An update may transition for at most 200 ms. Under `prefers-reduced-motion: reduce` nothing transitions, on first render or on update. | After `document.fonts.ready`: first frame equals the frame at 2.5 s within a 0.1% pixel tolerance, in both settings; an update under reduced motion reaches its final frame in one step; a 24-chart filter change settles within 200 ms | R14 |\n| I6 | A chart fed by `append` shows a Pause/Resume control. While paused, new rows are buffered and the view does not move. | Stream test | WCAG 2.2.2 |\n\n### 3.4 Accessibility\n\nTarget: every WCAG 2.2 level AA success criterion that applies to what Axylo renders, as component-level evidence. Conformance of a page is a property of the page and remains the author's.\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| A1 | Every chart has an accessible name: its `title`, or the heading named by `labelledBy`, or else a generated name (\"Line chart of Sessions by Day\") with AX140 raised in every build. The title's heading level is the author's (`level`), and it can be hidden visually. Every chart has a generated summary: type, series, x range with time zone, y range, each series' minimum, maximum and last value, and any omissions. `description` adds to the summary and never removes the zone or omission statements. Element ids are unique per chart. | Accessibility-tree snapshot for every fixture; a 24-chart page has no duplicate ids; axe `heading-order` | R11, R13, WCAG 1.1.1, 1.3.1, 2.4.6 |\n| A2 | Keyboard: at most two tab stops while the table is closed, the plot and one toolbar with roving focus that holds legend toggles, zoom, pause and the table control. Every point is reachable in order; the series can be switched; the ends can be reached directly; focus can leave the chart. The focus indicator is at least 2 px and 3:1 and is not hidden by the tooltip. The exact keys and roles are fixed after the pattern spike in M1 (section 8). | Forward and reverse traversal in collapsed, zoomed, streaming and table-open states; focus after hiding the focused series; indicator contrast | R12, WCAG 2.1.1, 2.1.2, 2.4.3, 2.4.7, 2.4.11, 1.4.11 |\n| A3 | Moving focus to a point conveys its text (series, x, value with unit, position) through the focused element's value text: the plot is a native range control whose `aria-valuetext` describes the focused point (decision 0001; earlier drafts said \"accessible name or a polite live region\", which the chosen pattern does not use, and A7 forbids announcements for navigation other than this). On touch screen readers, every point is reachable by swiping, or the table is reachable within two gestures. | Accessibility-tree snapshot after each key. No screen-reader rehearsal is part of 1.0 (the owner's decision, 2026-11-18): what a reader actually speaks on NVDA, VoiceOver or TalkBack has not been checked, and the conformance table says so. The script for such a rehearsal is kept in decision 0001 for when one is done. | R12, R13, WCAG 4.1.2 |\n| A4 | \"View as table\" shows the data as an HTML table built from the normalized data when opened: the title as caption, field labels with units as column headers, x values as row headers, values formatted as in F6. It covers the current x range, 100 rows per page, with every row reachable by paging or by jumping to an x value. It sits in a focusable scroll region no taller than the plot, and opening it does not move other charts. | Table content compared with fixture data, including a value near row 900,000 of 1,000,000; a 24-chart page layout test | R13, WCAG 1.3.1, 1.3.2, 3.3.1 |\n| A5 | Series are never distinguished by color alone, in any mode. Each line and area carries a shape marker at its last point and at sparse intervals, repeated in the legend and tooltip; under `prefers-contrast: more` or forced colors, lines also differ by dash. Adjacent filled marks (slices, stacked segments) are separated by at least 1 px of background. Bars are told apart by position and order, and by the legend and tooltip that name them; a compact chart has neither, so there neighbouring bar series also differ by fill pattern (series further apart may share a pattern: four patterns exist). The default palette has eight colors, each at least 3:1 on the default light and dark backgrounds, with a minimum pairwise OKLab difference of 0.10 (provisional) under normal vision and simulated protanopia, deuteranopia and tritanopia. On any other background, Axylo measures the palette against the resolved background and raises AX141 below 3:1. | Palette script scoring the rendered marks of an eight-series chart in both schemes, repeats included; rendered-pixel checks of separators; a grayscale screenshot in which three crossing lines can be told apart by marker | R7, WCAG 1.4.1, 1.4.11 |\n| A6 | Content reflows at 320 CSS px and 400% zoom without two-dimensional scrolling. User text-spacing overrides do not clip text. | Viewport and style-override tests in three engines | WCAG 1.4.10, 1.4.12 |\n| A7 | Data arriving does not speak. Announcements happen only for the reader's own navigation, and for a change of state (L7). While data streams, keyboard focus stays on the same datum until it leaves the window. | Stream test counting live-region changes with and without focus; 24 concurrent streams | R12 |\n| A8 | axe-core reports no violations on any fixture in any state, including `heading-order` and `scrollable-region-focusable`. | CI | R11 |\n| A9 | A conformance table lists every applicable WCAG 2.2 AA success criterion, the test that covers it, and what the author must supply (a meaningful title or `labelledBy`, series names, units, the page's own structure). It also states the limits in section 3.8. The criteria are the ones cited as \"WCAG x.y.z\" in the last column of this document's criterion rows; a criterion of WCAG 2.2 A or AA that no row cites is listed in the table as not covered by a test, with a word on why: not applicable to a chart component, the page's responsibility, or not assessed (it can apply to a chart, and no test is cited for it; the table claims nothing about it). | Published with each release; a CI check that every listed test exists | R11 |\n| A10 | Every built-in string can be replaced through `messages`. Built-in English text is marked `lang=\"en\"` when the document language is not English. | Test on a `lang=\"de\"` page | WCAG 3.1.2 |\n\n### 3.5 Diagnostic registry\n\nLevel decides delivery. **Error**: the chart or a series cannot be drawn; the chart shows its error state. **Warning**: something is not as the author gave it; where that means values were left out or changed (F12), the reader sees the note, and the registry's rows say which codes those are (a warning about an option, a name, a colour or a tick label shows none). **Hint**: advice for the author. Errors and warnings print once per code per page in every build; hints print in development builds only. `strict: true` throws on errors and warnings found while validating a create, `update` or `append` call, synchronously from that call. A diagnostic that can only arise later (a contrast check after the page's CSS changes, a custom formatter that throws when a table page is built, a label that stops fitting after a resize) is reported when it is found and is never thrown. Every diagnostic names the chart; those about data name the field and the first row indexes in the caller's own data.\n\n| Code | Level | Condition | What is drawn |\n|---|---|---|---|\n| AX100 | Error | Typed columns have different lengths | Error state; the message names the columns and their lengths |\n| AX101 | Error | A named field is not a key of any row | Error state; the message lists the keys that exist and the closest match |\n| AX102 | Warning | A field is absent (`undefined`) in some rows | Gaps |\n| AX103 | Warning | A value is `NaN` or infinite | Gap |\n| AX104 | Hint | Every non-missing value of a value field is a plain decimal string (`'40'`, `'-1.5'`) | Parsed and drawn; the message suggests `parse: 'number'`. An empty string counts as missing |\n| AX105 | Hint | Steps are absent on a regular time, date, wall-clock or number axis | Gaps. When a series would need more absent steps than twice its observations (and more than 1,000), it is treated as irregular instead: no gaps are created and the hint says so |\n| AX106 | Warning | A value field mixes numbers with strings, or holds strings that are not plain decimals (`'1,234'`, `'n/a'`) | The strings are not drawn |\n| AX107 | Warning | A date or time cannot be parsed | That row is not drawn |\n| AX108 | Error | Duplicate x within a series, or duplicate donut labels | That series, or the donut, is not drawn |\n| AX109 | Hint | Numbers on an axis declared `time` look like seconds, or a numeric x looks like epoch milliseconds without `type: 'time'` | As declared |\n| AX110 | Warning | An author domain on bar or area excluded zero | Domain widened to zero |\n| AX111 | Hint | Instants look like calendar dates | As instants, zone shown |\n| AX112 | Hint | Date-time strings have no offset | As written |\n| AX120 | Error | Negative donut value | Error state |\n| AX121 | Warning | More than eight donut slices | Seven largest plus \"Other (n)\" |\n| AX130 | Warning | More than eight series | All series, with dash or marker differences |\n| AX140 | Warning | No `title` and no `labelledBy` | Generated name |\n| AX141 | Warning | Palette below 3:1 on the resolved background | As themed |\n| AX142 | Hint | Plot too small to draw | Summary and table control |\n| AX143 | Hint | Labels hidden after every remedy | Note shown to the reader |\n| AX150 | Warning | Unknown option key | Ignored; the message suggests the closest known key |\n| AX151 | Warning | `append` rows out of order | Accepted through the slower full update |\n| AX131 | Hint | A compact chart has more than one series | Drawn, with dash differences |\n| AX132 | Hint | More bars than pixels along the category axis | Drawn; the message suggests aggregating |\n| AX133 | Hint | A scatter chart has more than 50,000 points | Drawn; the message says drawing may be slow |\n| AX134 | Error | Series × x positions exceeds 20,000,000 (long rows with many series and little shared x) | Error state; the message gives both counts and suggests fewer series or a scatter chart |\n| AX152 | Warning | `timeZone` is not a zone the browser knows | The viewer's zone is used |\n| AX160 | Warning | A custom formatter threw | The default format is used for that value. A value formatter that throws changes how a value reads, so the reader's note (F12) is shown; a tick formatter that throws only changes an axis label, which is not a value left out or changed, so it is reported without a note (and so the note can never change which ticks fit) |\n| AX199 | Error | An error was thrown while Axylo was building the chart: by Axylo itself, or by code the author supplied that Axylo was running (a row getter, a callback; a formatter that throws is AX160, and the default format is used) | Error state with a generic message; the error is passed to `onDiagnostic` and printed |\n\nExpected results for the Phase 1 fixtures: the combined `dirty` fixture (`[10, 20, null, NaN, '40', undefined, 70]`) yields AX102, AX103 and AX106 once each, draws Mon–Tue as a segment and Sun as a point, and shows the F12 note. `dirty-string` (one `'40'` among numbers) yields AX106. A column made only of numeric strings yields AX104 and is drawn in full. `dirty-null` yields nothing.\n\nThe split between AX104 and AX106 answers a reviewer's objection that common back ends return counts as strings (Postgres `bigint` and `numeric`, BigQuery): a whole column of plain decimal strings is unambiguous and is parsed; a stray string among numbers is a bug and is not.\n\n### 3.6 Type matrix\n\n| | Line | Area | Bar | Donut | Scatter |\n|---|---|---|---|---|---|\n| Picking by pointer | Nearest x | Nearest x | The band under the pointer | The slice under the pointer | Nearest point within 24 px; ties go to the later row |\n| Tooltip content | Every visible series at that x | Same, plus the stack total | Every series in that category | Label, value, percentage | The point's series, x and y; coincident points listed, up to eight |\n| Keyboard order | By x, then series | By x, then series | By category, then series | By slice order | By x, then y |\n| Zoom | On time, date and numeric x only | On time, date and numeric x only | On time, date and numeric x only | No | Yes, both axes later; x only in 1.0 |\n| Simplified drawing when dense | F5 | F5 on cumulative sums | No; more bars than pixels raises a hint | No | No in 1.0; above 50,000 points a hint says drawing may be slow |\n| Limit that raises a diagnostic | Eight series | Eight series | Eight series | Eight slices | Eight series |\n| Reference lines and bands | Yes; included in the domain; listed in the summary and table caption | Yes | Yes | No | Yes |\n\n### 3.7 Compact variant\n\n`compact: true` on line, area and bar draws the marks and nothing else: no axes, gridlines, legend, toolbar, table control, zoom or tooltip. It is for a small tile where the page already shows the number and the label.\n\n| ID | Criterion | Verified by |\n|---|---|---|\n| C1 | A compact chart is a static image with a full text alternative: `role=\"img\"`, an accessible name (as in A1, including AX140 when none is given) and the generated summary as its description (series, x range, minimum, maximum, last value, omissions). It has no tab stop and no pointer-only behavior, so nothing is available to a mouse that is not available to a keyboard. | Accessibility-tree snapshot; a page of 40 has zero added tab stops, WCAG 1.1.1 |\n| C2 | The fidelity rules still hold: zero baseline for bar and area (F1), gaps (F2), diagnostics (F3), simplified drawing (F5), sorting (F11), no motion (I5), scheme from the page (L4). | The same fixtures as the full charts |\n| C3 | It fills its container at any size from 24×16 CSS px up; with no definite height it is 32 px tall. | Size tests |\n| C4 | With more than one series, lines differ by dash as well as color, and bars by fill pattern between neighbours (A5), since there is no legend; AX131 suggests one series per compact chart. | Two-series fixture, WCAG 1.4.1 |\n| C5 | When values were left out (F12), the description says so and a small marker with a text equivalent appears in the corner. | `dirty` fixture in compact mode, WCAG 1.1.1 |\n\nA compact chart does not give access to every value; the summary is its alternative. An author who needs every value reachable uses the full chart.\n\n### 3.8 What the evidence will and will not show\n\nAutomated checks establish structure: names, roles, focus order, contrast, text. They do not establish that a screen-reader user finds a chart understandable. 1.0 has no evidence for that: no screen reader was run against it, not even by the developer (the owner's decision, 2026-11-18; the rehearsal on five reader and browser pairs that earlier drafts of this section planned was not done). Axylo is built by one person with no access to study participants, so no claim of usability testing with disabled users is made, and the conformance table says both things in those words. Reviewers proposed participant testing as a release gate; it is recorded here as a known limit instead.\n\n## 4. Acceptance criteria: the developer's experience\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| DX1 | The first chart takes ten lines or fewer, including import, by npm and by script tag. No required option besides data and fields. | Two CI tests that render the documented snippet from the packed distribution | D1 |\n| DX2 | One logical table, three ways to pass it: long rows, wide rows, typed columns. The three forms of each fixture produce the same normalized data and the same diagnostics, with row indexes in the caller's own form. | Equivalence tests | D2 |\n| DX3 | With typed rows, a misspelled field, a text field on a value axis, wide `y` combined with `series`, and an option that does not apply to the chart type all fail to compile. At run time, for untyped rows, the same mistakes raise AX101, AX106 and AX150. | [docs/api/examples.ts](api/examples.ts) compiles and each marked mistake fails (already checked with TypeScript 7.0.2); runtime tests per code | D5 |\n| DX4 | Diagnostics follow the registry in section 3.5: stable code, chart name, field and rows where they apply, the fix, and a documentation page per code. | Message snapshots; link checker | R5, D5 |\n| DX5 | Three methods change a chart: `update` changes options, `append` adds rows, `zoom` sets the view. They apply in call order. Validation and diagnostics are synchronous; drawing is deferred to the next frame; marks, labels, hit testing and the accessibility layer always switch to a new state together. `destroy()` releases everything and cancels pending work. No `resize()` exists. | Sequence tests: replace then append then zoom in one turn; a rejected `strict` update leaves the last valid chart; destroy before the frame; 1,000 create–destroy cycles show no heap growth trend (P7) | D3, R16 |\n| DX6 | Colors, font and spacing are CSS custom properties with documented names; the chart inherits `font-family` and `color`. `colors` pins a color to a series name so the same series has the same color on every chart. There is no theme object and no positional palette option. | Theming tests, including a 24-tile page where series subsets differ | R10 |\n| DX7 | Zero runtime dependencies (reconsidered only with a measured comparison). Size targets for 1.0, set by the owner on 2026-11-18 after measurement: 116 KiB gzipped for everything and 98 KiB for a page that uses only `line`, CSS included. (History: the first targets, 40 and 25 KiB, were written before anything was built; 96 and 80 were set the same day from a first analysis, `reviews/2026-11-18/impl/wp/size.analysis.md`; the correctness passes that followed added about 11 KiB, and a second measured analysis, `reviews/2026-11-18/impl/wp/size2.analysis.md`, showed 96 and 80 can only be met by making streaming an opt-in import, a public API change the owner left for after 1.0. That change, worth about 15 KiB, is the first size item after 1.0.) | size-limit in CI on the packed distribution | D4 |\n| DX8 | Importing in Node without a DOM does not throw, and `validate()` runs there. Creating, destroying and creating again on the same element works and leaks nothing (the sequence a framework's strict or development mode produces). Works under a Content Security Policy without `unsafe-inline` or `unsafe-eval`, served with real headers. Labels and formatter output are inserted as text, never as HTML. A target that matches no element throws an error that names the selector. | CI tests | D1 |\n| DX9 | Semantic versioning. A deprecated API keeps working for at least one minor release and six months. At most one major version a year. The previous release's documented examples still compile and run against each release candidate. | Release policy; API report diff; upgrade test | D6 |\n| DX10 | Every runnable example in the documentation is compiled and rendered in CI from the packed distribution. | Docs build | D1 |\n| DX11 | MIT license for everything, including zoom and accessibility. Third-party notices are verified at release. | Repository; release check | D7 |\n| DX12 | A coding agent gets the first chart right. Given fixed prompts and trap fixtures (UTC-midnight ISO dates, numeric strings, unsorted rows, missing days, a misspelled field), an agent with only the published docs produces a chart with no error diagnostics that passes the reader criteria. Recorded as agent rehearsal, not as user evidence. | Scripted rehearsal at each release | D1, 1.2 |\n\n### 1.2 Data: one logical table, three forms\n\n```ts\n// long rows: one row per (x, series)\nline(el, { data: rows, x: 'day', y: 'sessions', series: 'channel' });\n\n// wide rows: one column per series\nline(el, { data: wide, x: 'day', y: ['direct', 'organic', { field: 'referral', label: 'Referral' }] });\n\n// typed columns for large data; the row type is inferred from the columns\nline(el, { data: { columns: { t: new Float64Array(n), v: new Float32Array(n) } }, x: { field: 't', type: 'time' }, y: 'v' });\n```\n\nLong and wide are mutually exclusive in the types: `series` cannot be combined with an array of `y`.\n\nRules the three forms share:\n\n| Rule | Detail |\n|---|---|\n| Ownership | Row arrays are read once and never mutated. Typed columns are borrowed, not copied; the caller must not change them in place, and replaces them through `update`. |\n| Column lengths | All columns must have the same length; otherwise AX100. |\n| Missing values | Rows: `null`, or an absent key. Typed columns: `NaN` means missing and does not raise AX103. |\n| Order | Line, area and scatter are sorted by x internally (F11). `append` expects rows at or after the last x. |\n| Provenance | Every normalized sample keeps the index of the row it came from, so diagnostics, the table and events point at the caller's own data. |\n\n### 1.3 Fields\n\nA field is a key of the row, or an object when it needs more. The key is checked against the row type by role: a value axis accepts number fields; text fields are accepted there only with `parse: 'number'`.\n\n```ts\nline(el, {\n  data: samples,\n  x: { field: 'ts', type: 'time', timeZone: 'UTC' },\n  y: { field: 'sessions', label: 'Sessions', unit: 'sessions', tickFormat: { notation: 'compact' } },\n});\n\n// counts that a database driver returns as strings\nbar(el, { data: pgRows, x: 'day', y: { field: 'count', parse: 'number', missing: 'zero' } });\n```\n\n| Option | Meaning |\n|---|---|\n| `field` | Key of the row. |\n| `label`, `unit` | Axis title; name and unit in tooltip, table and announcements. |\n| `type` (x) | `'date'`, `'time'`, `'number'`, `'category'`. Inferred when omitted, except that a number is never inferred to be an instant (F4). |\n| `timeZone` (x) | For instants: `'local'` (default), `'UTC'`, or an IANA zone. |\n| `format`, `tickFormat` | Readouts and ticks are formatted separately (F6). |\n| `scale` (value) | `'percent'` (0–100) or `'ratio'` (0–1). Declared, never inferred (F7). |\n| `missing` (value) | `'gap'` (default) or `'zero'` (F2). |\n| `parse` (value) | `'number'`, for a text field holding numbers (AX104, AX106). |\n| `domain` | Author bounds. Widened to zero on bar and area (F1). |\n\n### 1.4 Common options\n\nSummarized; the declarations are the reference.\n\n| Option | Purpose |\n|---|---|\n| `title`, `labelledBy`, `subtitle`, `description` | The chart's visible heading and accessible name (A1). `title` may carry a heading `level` and `visible: false`; `labelledBy` points at a heading the page already has. |\n| `state` | `'ready'`, `'loading'`, `{ error }`, `{ empty }` (L7). |\n| `legend`, `tooltip`, `table` | On by default; each can be turned off. |\n| `zoom`, `reference` | Cartesian charts only. |\n| `compact` | Line, area and bar: marks only, as a static image with a text alternative (spec 3.7). |\n| `colors` | A fixed color per series name (DX6). |\n| `messages`, `locale` | Built-in text and formatting locale (A10, F6). |\n| `strict`, `onDiagnostic` | Diagnostics delivery (section 3.5 of the spec). |\n\nThere is no `width`, `height`, `responsive`, `theme`, `palette` or `animation` option. Size comes from the container, colors from CSS, motion from the spec (I5). An unknown key raises AX150 with the closest known name.\n\n### 1.6 Diagnostics\n\nThe registry, with each code's level and outcome, is in the spec (section 3.5). Example for the Phase 1 combined dirty fixture (`[10, 20, null, NaN, '40', undefined, 70]`):\n\n```\n[axylo AX103] \"Dirty input\": y field \"value\" has 1 value that is not a finite number (NaN at row 3). Shown as a gap.\n  Check the calculation that produced it, or send null for \"no data\".\n[axylo AX106] \"Dirty input\": y field \"value\" mixes numbers with 1 string (\"40\" at row 4). The string is not plotted.\n  Convert it to a number where the data is produced.\n[axylo AX102] \"Dirty input\": y field \"value\" is absent in 1 row (row 5). Shown as a gap.\n  Send null if the value is known to be missing.\n```\n\nThe reader of that chart sees \"Values not shown: 3. See table.\" (F12).\n\n`validate(type, options)` runs the same normalization without a DOM and returns the diagnostics, so a server, a test or a coding agent can check a chart before rendering it.\n\nDevelopment and production flavours are selected through package `exports` conditions. The script-tag distribution ships `axylo.js` (development) and `axylo.min.js` (production). Errors and warnings print once per code per page in both; hints only in development.\n\n### M7. Distribution and documentation (ceiling: 8 days)\n\n- Script-tag builds; documentation site; migration notes from Chart.js and Recharts. (No framework adapter in 1.0.)\n\nOutcomes:\n- The packed tarball installed into two clean fixtures (npm with a bundler, script tag): the first chart works in ten lines or fewer in each (DX1).\n- Node import and `validate()` without a DOM; strict CSP with real headers (DX8).\n- Size measured on the packed distribution for line-only, full and script-tag cases, CSS included (DX7).\n- Every runnable docs example compiled and rendered from the packed distribution (DX10).\n- The agent rehearsal (DX12), recorded as rehearsal.\n\n### M8. Release (ceiling: 10 days)\n\n- Beta under a `next` tag; issues from real use fixed; API frozen through the API report.\n- The Phase 1 comparison regenerated with Axylo beside the ten libraries, with the same harness and the corrections from the review, and published with its limits.\n- Real Safari on macOS and iOS checked by hand.\n- Independent review of the acceptance evidence before 1.0 is tagged, by a reviewer who did not write the code under review.\n\nOutcomes: every acceptance-matrix row is pass or not applicable with a reason; changelog, upgrade policy and third-party notices published.\n\nPublishing to npm, tagging and pushing are separate, explicit decisions by the owner at this point; the plan does not assume them.\n\n## 4. Test strategy\n\n| Layer | Tool | What it proves |\n|---|---|---|\n| Unit | Vitest | Scales, ticks, formatting, parsing, simplification. |\n| Property | fast-check | Invariants that must hold for any data: F1, F2, F5, F7, F11, L1. |\n| Scene snapshot | Vitest, injected text metrics | Geometry and text for each fixture and width, without a browser. |\n| Browser | Playwright on three engines | Real text boxes, resize, pointer, touch, keyboard, time zones, color schemes, reduced motion, fonts loading late. |\n| Accessibility | axe-core, accessibility-tree snapshots, keyboard scripts, recorded rehearsal | A1–A10. |\n| Visual | Screenshots per operating system | What the scene cannot see: antialiasing, state leaks. |\n| Types | `docs/api/examples.ts` pattern | The listed mistakes fail to compile (DX3). |\n| Packed distribution | Clean install fixtures | What users actually get (DX1, DX7, DX8, DX10). |\n| Acceptance matrix | Data file plus a checker | Every criterion has a test that exists and a current result; stale criterion IDs fail CI. |\n\nExpected values are derived from the spec and the fixture data, never from the implementation's output. A failing test is fixed in the code or escalated as a spec question, never by editing the expected value to match.\n\n","exit_code":0,"status":"completed"}}
