t const DIRECTIVE = /^\\[(example|source|table|output):\\s*([^\\]]+)\\]\\(([^)\\s]+)\\)$/;\nconst FENCE = /^(`{3,})\\s*([\\w-]*)\\s*$/;\nconst HEADING = /^(#{1,4})\\s+(.+?)\\s*#*\\s*$/;\nconst BULLET = /^[-*]\\s+(.*)$/;\nconst NUMBERED = /^(\\d+)\\.\\s+(.*)$/;\nconst TABLE_RULE = /^\\|?\\s*:?-{3,}:?\\s*(\\|\\s*:?-{3,}:?\\s*)*\\|?\\s*$/;\nconst COMMENT = /^<!--.*-->$/;\n\n/**\n * Converts `source` to HTML.\n * - `link(url)` rewrites a link destination (for example `data.md#gaps` to `data.html#gaps`); its result is\n *   checked with `checkHref`.\n * - `directive({ kind, name, target })` returns the HTML for a directive line.\n * - `headings` receives each heading as { level, text, id } in order.\n * - `ids` is the set of ids already used on the page; headings get ids not in it, block quotes included.\n */\nexport function markdownToHtml(source, { link = url => url, directive, headings = [], ids = new Set() } = {}) {\n  const lines = source.replace(/\\r\\n?/g, '\\n').split('\\n');\n  const out = [];\n  const inline = text => renderInline(text, link);\n  // Each table's scroll region is named after the heading it sits under, so that no two share a name.\n  let section = null;\n  const tableNames = new Map();\n  const tableName = () => {\n    const n = (tableNames.get(section) ?? 0) + 1;\n    tableNames.set(section, n);\n    const table = n === 1 ? 'Table' : `Table ${n}`;\n    return section === null ? table : `${table}: ${section}`;\n  };\n\n  let i = 0;\n  while (i < lines.length) {\n    const line = lines[i];\n    const trimmed = line.trim();\n    if (trimmed === '' || COMMENT.test(trimmed)) { i++; continue; }\n\n    const fence = FENCE.exec(line);\n    if (fence) {\n      const body = [];\n      i++;\n      while (i < lines.length && !lines[i].startsWith(fence[1])) body.push(lines[i++]);\n      if (i < lines.length) i++;\n      out.push(codeBlock(body.join('\\n'), fence[2]));\n      continue;\n    }\n\n    const d = DIRECTIVE.exec(trimmed);\n    if (d) {\n      if (!directive) throw new Error(`A directive is not allowed here: ${trimmed}`);\n      out.push(directive({ kind: d[1], name: d[2].trim(), target: d[3] }));\n      i++;\n      continue;\n    }\n\n    const heading = HEADING.exec(line);\n    if (heading) {\n      const level = heading[1].length;\n      const id = uniqueId(slug(heading[2]), ids);\n      headings.push({ level, text: plainText(heading[2]), id });\n      section = plainText(heading[2]);\n      out.push(`<h${level} id=\"${escapeHtml(id)}\">${inline(heading[2])}</h${level}>`);\n      i++;\n      continue;\n    }\n\n    if (line.startsWith('|') && i + 1 < lines.length && TABLE_RULE.test(lines[i + 1])) {\n      const rows = [];\n      const align = splitRow(lines[i + 1]).map(cell => cell.endsWith(':') ? (cell.startsWith(':') ? 'center' : 'right') : null);\n      const header = splitRow(line);\n      i += 2;\n      while (i < lines.length && lines[i].startsWith('|')) rows.push(splitRow(lines[i++]));\n      out.push(table(header, rows, align, inline, tableName()));\n      continue;\n    }\n\n    if (line.startsWith('>')) {\n      const body = [];\n      while (i < lines.length && lines[i].startsWith('>')) body.push(lines[i++].replace(/^>\\s?/, ''));\n      out.push(`<blockquote>${markdownToHtml(body.join('\\n'), { link, directive: undefined, headings, ids })}</blockquote>`);\n      continue;\n    }\n\n    const bullet = BULLET.exec(line);\n    const numbered = NUMBERED.exec(line);\n    if (bullet || numbered) {\n      const ordered = !bullet;\n      const marker = ordered ? NUMBERED : BULLET;\n      const items = [];\n      const start = ordered ? Number(numbered[1]) : 1;\n      while (i < lines.length) {\n        const m = marker.exec(lines[i]);\n        if (m) { items.push(ordered ? m[2] : m[1]); i++; continue; }\n        // A continuation line is indented; a blank line or anything else ends the list.\n        if (/^\\s{2,}\\S/.test(lines[i]) && items.length) { items[items.length - 1] += ' ' + lines[i].trim(); i++; continue; }\n        break;\n      }\n      const tag = ordered ? 'ol' : 'ul';\n      const startAttr = ordered && start !== 1 ? ` start=\"${start}\"` : '';\n      out.push(`<${tag}${startAttr}>${items.map(item => `<li>${inline(item)}</li>`).join('')}</${tag}>`);\n      continue;\n    }\n\n    const paragraph = [];\n    while (i < lines.length && lines[i].trim() !== '' && (paragraph.length === 0 || !startsBlock(lines, i))) paragraph.push(lines[i++].trim());\n    out.push(`<p>${inline(paragraph.join(' '))}</p>`);\n  }\n  return out.join('\\n');\n}\n\n/** `base`, or `base-2`, `base-3` … : the first not yet used on the page. Reserves it. */\nexport function uniqueId(base, ids) {\n  let id = base;\n  for (let n = 2; ids.has(id); n++) id = `${base}-${n}`;\n  ids.add(id);\n  return id;\n}\n\nfunction startsBlock(lines, i) {\n  const line = lines[i];\n  return FENCE.test(line) || HEADING.test(line) || line.startsWith('>') || BULLET.test(line) || NUMBERED.test(line) ||\n    COMMENT.test(line.trim()) || DIRECTIVE.test(line.trim()) ||\n    (line.startsWith('|') && i + 1 < lines.length && TABLE_RULE.test(lines[i + 1]));\n}\n\n/** Splits a table row on pipes that are not escaped; `\\|` stays in the cell as a literal pipe. */\nexport function splitRow(line) {\n  const cells = [];\n  let cell = '';\n  const body = line.trim().replace(/^\\|/, '').replace(/(?<!\\\\)\\|$/, '');\n  for (let i = 0; i < body.length; i++) {\n    const c = body[i];\n    if (c === '\\\\' && body[i + 1] === '|') { cell += '\\\\|'; i++; continue; }\n    if (c === '|') { cells.push(cell.trim()); cell = ''; continue; }\n    cell += c;\n  }\n  cells.push(cell.trim());\n  return cells;\n}\n\nfunction table(header, rows, align, inline, name = 'Table') {\n  const style = index => align[index] ? ` style=\"text-align: ${align[index]}\"` : '';\n  const head = header.map((cell, index) => `<th scope=\"col\"${style(index)}>${inline(cell)}</th>`).join('');\n  const body = rows.map(row => `<tr>${header.map((_, index) => `<td${style(index)}>${inline(row[index] ?? '')}</td>`).join('')}</tr>`).join('');\n  // The wrapper scrolls a wide table on a narrow screen, so the page itself never scrolls sideways.\n  return `<div class=\"table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"${escapeHtml(name)}\"><table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>`;\n}\n\nexport function codeBlock(code, language = '') {\n  const cls = language ? ` class=\"language-${escapeHtml(language)}\"` : '';\n  return `<pre tabindex=\"0\"><code${cls}>${escapeHtml(code)}</code></pre>`;\n}\n\n/**\n * The end of a link destination that starts at `open` (the index of its `(`): balanced parentheses, so\n * `guide(v2).md` is one destination. -1 when it does not close.\n */\nfunction destinationEnd(text, open) {\n  let depth = 0;\n  for (let i = open; i < text.length; i++) {\n    if (text[i] === '\\\\') { i++; continue; }\n    if (text[i] === '(') depth++;\n    else if (text[i] === ')' && --depth === 0) return i;\n    else if (/\\s/.test(text[i])) return -1;\n  }\n  return -1;\n}\n\n/** Inline Markdown to HTML. Unmatched markers are kept as text. */\nexport function renderInline(text, link = url => url) {\n  let out = '';\n  let i = 0;\n  while (i < text.length) {\n    const c = text[i];\n    if (c === '\\\\' && i + 1 < text.length && /[\\\\`*_[\\]()|#<>!-]/.test(text[i + 1])) {\n      out += escapeHtml(text[i + 1]);\n      i += 2;\n      continue;\n    }\n    if (c === '`') {\n      let run = 1;\n      while (text[i + run] === '`') run++;\n      const fence = '`'.repeat(run);\n      const end = text.indexOf(fence, i + run);\n      if (end !== -1) {\n        // Inside a table cell a literal pipe is written `\\|`; the backslash is not part of the code.\n        const code = text.slice(i + run, end).replace(/\\\\\\|/g, '|');\n        out += `<code>${escapeHtml(run > 1 ? code.trim() : code)}</code>`;\n        i = end + run;\n        continue;\n      }\n    }\n    if (c === '[') {\n      const close = matchBracket(text, i);\n      if (close !== -1 && text[close + 1] === '(') {\n        const end = destinationEnd(text, close + 1);\n        if (end !== -1) {\n          const label = text.slice(i + 1, close);\n          const url = text.slice(close + 2, end).trim();\n          out += `<a href=\"${escapeHtml(checkHref(link(url)))}\">${renderInline(label, link)}</a>`;\n          i = end + 1;\n          continue;\n        }\n      }\n    }\n    if (c === '*' && text[i + 1] === '*') {\n      const end = text.indexOf('**', i + 2);\n      if (end > i + 2) {\n        out += `<strong>${renderInline(text.slice(i + 2, end), link)}</strong>`;\n        i = end + 2;\n        continue;\n      }\n    }\n    if (c === '*' && text[i + 1] !== ' ' && text[i + 1] !== '*') {\n      const end = text.indexOf('*', i + 1);\n      if (end > i + 1 && text[end - 1] !== ' ') {\n        out += `<em>${renderInline(text.slice(i + 1, end), link)}</em>`;\n        i = end + 1;\n        continue;\n      }\n    }\n    out += escapeHtml(c);\n    i++;\n  }\n  return out;\n}\n\nfunction matchBracket(text, open) {\n  let depth = 0;\n  for (let i = open; i < text.length; i++) {\n    if (text[i] === '\\\\') { i++; continue; }\n    if (text[i] === '`') {\n      const end = text.indexOf('`', i + 1);\n      if (end !== -1) { i = end; continue; }\n    }\n    if (text[i] === '[') depth++;\n    if (text[i] === ']' && --depth === 0) return i;\n  }\n  return -1;\n}\n\n/** Words of prose in a page, for the report: code blocks, comments and table rules are not counted. */\nexport function wordCount(source) {\n  let inCode = false;\n  let words = 0;\n  for (const line of source.split('\\n')) {\n    if (FENCE.test(line)) { inCode = !inCode; continue; }\n    if (inCode || COMMENT.test(line.trim()) || TABLE_RULE.test(line) || DIRECTIVE.test(line.trim())) continue;\n    words += plainText(line.replace(/\\|/g, ' ')).split(/\\s+/).filter(w => /[\\p{L}\\p{N}]/u.test(w)).length;\n  }\n  return words;\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,122p' apps/docs/pages/conformance.md && sed -n '28,130p' apps/docs/pages/stability.md && sed -n '35,106p' apps/docs/pages/getting-started.md\"","aggregated_output":"# Conformance table\n\nAfter this page you know which WCAG 2.2 success criteria the specification cites, what Axylo does for each, what evidence was recorded for them when this site was built, why no test covers the other level A and AA criteria, and what that evidence cannot show.\n\nThis page is generated each time the site is built, from the specification's criterion rows and from the report of the acceptance checker. It says only what they record; where they record nothing, it says \"not recorded\". It is not a claim that a page using Axylo conforms: conformance belongs to a whole page, and the page is yours.\n\n## What the evidence can and cannot show\n\n- **Automated checks only.** The acceptance tests check structure: names, roles, focus order, contrast, sizes and text. They do not show that a person using a screen reader understands a chart.\n- **No screen-reader rehearsal was done for 1.0.** No screen reader has been run against these charts, so nothing in this documentation says what a screen reader speaks.\n- **No usability testing with disabled people.** Axylo is built by one person with no access to study participants, and no claim of usability testing with disabled users is made.\n- **Engines, not browsers.** Browser results are recorded per engine: Chrome, and Firefox and WebKit as built by Playwright. WebKit results are Playwright's WebKit, not Safari. Nothing has been run on a phone.\n- **Right-to-left pages.** Right-to-left text renders, but the chart's layout is not mirrored.\n- **Transformed ancestors.** A chart inside a translated or scaled element is exact. Inside a rotated, skewed or mirrored element it draws, but pointing and tooltip placement are wrong; that is not supported in 1.0.\n\n## What you must supply\n\nAxylo can only describe what it is given. A chart needs a meaningful name (`title`, or `labelledBy` pointing at your heading), series names, units on value fields, and the page's own structure around it. A compact chart fed by `append` has no Pause control, since it has no toolbar: a page that streams into compact tiles must give the reader its own way to pause them (WCAG 2.2.2). [Accessibility](accessibility.md#what-you-must-supply) has the details.\n\n## The criteria the specification cites\n\n[table: conformance](../../../acceptance/check.mjs)\n\n| Dimension | 1.0 target |\n|---|---|\n| Browsers | The current and previous major versions of Chrome, Edge and Firefox, and of Safari on macOS and iOS. |\n| TypeScript | 5.4 and later. Plain JavaScript is fully supported; types are an aid, not a requirement. |\n| Frameworks | None needed. No adapter ships in 1.0; the library is called from any framework's mount and unmount hooks. |\n| Node | Importing `axylo` touches no DOM, and `validate()` runs there. Charts themselves need a browser. |\n| Text direction | Left-to-right pages. Right-to-left text renders, but the layout is not mirrored. |\n| Transformed ancestors | A chart inside a translated or scaled element (any positive scale, uniform or not) is exact. Inside a rotated, skewed or mirrored element it draws, but pointing and tooltip placement are wrong: not supported in 1.0. |\n| Built-in text | English. Reader-facing messages are replaceable through `messages`; diagnostics keep their English wording. |\n\nTested so far, on Linux: the library's acceptance tests in Chrome and in Playwright's builds of Firefox and WebKit (Playwright's WebKit, not Safari), and the distribution tests in Chrome (they install the packed package, also under a Content Security Policy). Safari itself, Edge, Windows, macOS and phones have not been tested. No screen-reader rehearsal was done for 1.0. What the acceptance checker recorded for this revision is on the [conformance page](conformance.md); see also [Accessibility](accessibility.md#what-has-and-has-not-been-verified).\n\n## Known limits\n\nThese are known in 1.0 and not fixed in it. Each says what you would see.\n\n- **Closed shadow roots.** In a chart inside a closed shadow root, Escape can be taken by another chart on the page instead of this one. When the chart sits behind a slot inside a closed root, the wrapper around that slot can cut off its tooltip.\n- **A dense ring of scatter points.** Thousands of points packed in a ring just outside the distance at which points count as being at the same place (half a pixel) can make hovering over that spot slow.\n- **A formatter that fails only sometimes.** A formatter that throws for a value on one call and returns text on another can leave [AX160](diagnostics.md#ax160) reported beside a label that reads normally.\n- **CSS aimed at the plot's own column.** The readout strip is measured outside the plot's column, so CSS that applies only inside that column (a container query on it, for example) is not taken into account. A small plot can then show no readout although the strip would fit.\n- **A hold that starts early.** When only the tooltip's size or position changes while the pointer rests on a datum, the rest already spent counts towards the new one, so the hold can begin before a quarter of a second has passed.\n- **One language for the focused point.** The plot's value text is marked with one language, even when the messages it is built from are not all in the same language (some translated, others built in).\n- **Patterns in compact bar charts.** Neighbouring series always differ by fill pattern, but series further apart can share one, since there are four, and then differ by colour only.\n- **Very small numbers.** On an axis of values around 1e-43 or smaller, ticks can be missing or not match their labels.\n- **The end labels of a scatter chart's x axis.** That axis ends on a drawn tick at each end (spec F7) and reserves no extra room for the labels there, so long tick labels are wrapped or rotated to fit rather than left out. On a narrow plot the axis can take a coarser, wider range so that its ends are ticks.\n\n## Size and memory\n\nThe size targets of 1.0, set by the owner after measuring the built library: 116 KiB gzipped for a page that uses everything, and 98 KiB for a page that uses only `line`, the stylesheet included. They are not a release gate yet. The last measurement (`npm run size`, which measures the packed files the way a bundler would):\n\n[table: sizes](../../../bench/size-latest.json)\n\nMemory: once a chart opened on typed columns has been appended to, Axylo keeps its own exact copy of x and y and one state byte per point, 17 bytes per point against the 16 of your two `Float64Array` columns. The memory budget of 1.0 is therefore 1.1 times the size of your two columns, for 1,000,000 points, with no upward trend over 1,000 cycles of create and destroy. This documentation shows no memory measurement. A chart that is never appended to reads typed columns in place where it can (see [what Axylo reads, keeps and copies](data.md#what-axylo-reads-keeps-and-copies)).\n\n## Licence\n\nMIT, for everything: zoom, accessibility and every chart type included. There is no commercial edition and no feature behind a licence key. The library has no runtime dependencies; third-party notices, if any, are checked at each release.\n\n## What is not in 1.0\n\nNot planned for 1.0, with the reason it can wait:\n\n| Not in 1.0 | Why it can wait |\n|---|---|\n| More chart types (histogram first, then heatmap, box plot, candlestick, radar, treemap, sankey, gauge, maps) | Each must pass the same acceptance criteria as the five types in 1.0. |\n| Log and other non-linear scales | They need their own rules for zero and negative values. |\n| A second y axis | Often misleading; it needs a design that keeps the zero baseline honest. |\n| Annotations beyond reference lines and bands | Placing free text interacts with label fitting. |\n| Linked charts (shared cursor, brush) | Needs a small coordination API. |\n| Export to PNG, SVG or CSV, and print styling | CSV from the table view comes first. |\n| Server-side rendering to SVG | The drawing model makes it possible later. |\n| Right-to-left layout mirroring | Stated as a limit in 1.0. |\n| Quarters and ISO weeks as calendar periods | Treat them as ordered categories in 1.0. |\n| Nested field paths (`'user.country'`) | Flatten rows before passing them. |\n| Framework adapters (React, Vue, Svelte, Angular) and a custom element | Thin wrappers over the same handle; until then a chart is created and destroyed from the framework's own hooks (see [Getting started](getting-started.md#using-axylo-in-a-framework)). |\n| A plugin or custom-mark API | Waits until two real uses show its shape. |\n| Translations of built-in text | `messages` makes reader-facing ones possible; only English ships. |\n| Workers, WebGL or WebGPU | Decided from measurements. |\n\nNot the audience for 1.0: analysts exploring data in notebooks, designers building bespoke graphics, and teams that need maps, financial charts or network diagrams.\nNo framework adapter ships in 1.0; adapters for React, Vue, Svelte and others are planned after 1.0. Axylo is called from any framework's own hooks: create the chart when its element exists, call `update()` when your data or options change, and call `destroy()` when the element goes away. Creating, destroying and creating again on the same element is supported; it is the sequence a framework's development mode produces.\n\nThe lifecycle as three plain functions:\n\n[example: lifecycle](../examples/lifecycle.ts)\n\n## Daily data: five things to get right\n\nThe first chart above has months as calendar dates and numbers as numbers. Data from an API is often less tidy. Here is a daily metric as many back ends send it, and the chart that reads it correctly:\n\n[example: daily-sessions](../examples/daily-sessions.ts)\n\n1. **Days sent as UTC midnights.** For daily totals sent as `'2026-02-24T00:00:00Z'` (or as epoch milliseconds of a UTC midnight), use `x: { field: 'day', type: 'date' }`. Without it they are instants, shown in the viewer's time zone, so west of UTC each value appears on the day before, with only hint [AX111](diagnostics.md#ax111). Strings such as `'2026-02-24'` need no `type`. See [the three kinds of time](data.md#three-kinds-of-time).\n2. **Numbers sent as strings.** For decimal strings, use `y: { field: 'sessions', parse: 'number' }`. They are converted to JavaScript numbers, which are exact for integers up to 9,007,199,254,740,991; a larger count is rounded without a warning, so check exact counts with `Number.isSafeInteger` first. A field that mixes numbers and strings is not converted at all. See [numbers sent as strings](data.md#numbers-sent-as-strings).\n3. **Row order.** Pass rows in any order. Axylo sorts dated rows by x and keeps each value with its own row; categories keep the order in which they first appear.\n4. **A day with no data.** When you know a day is missing, send it, with `sessions: null`. Axylo can infer a missing day only between two rows of a series that has at least three rows at a regular step, and never before the first row or after the last; with two rows, or an irregular series, the line runs straight across the missing day. See [missing values](data.md#missing-values).\n5. **A misspelled field.** On error [AX101](diagnostics.md#ax101), compare the field you named with the keys the message lists, which come from your rows, and use the suggested spelling when one is offered. With no rows at all the keys cannot be checked, so the error appears once data arrives. With typed rows in TypeScript the typo does not compile.\n\n## What you get without asking\n\n| Feature | What it does |\n|---|---|\n| Name and summary | `title` is the visible heading and the chart's accessible name. In a card that already has a heading, `labelledBy` names the chart with it. The chart's description is a generated summary: chart type, series, the x range with its time zone, the value range, each series' minimum, maximum and last value, and anything left out. `description` adds to it. |\n| Table view | \"View as table\" shows the data as an HTML table, 100 rows per page; above 100 rows a pager and a \"Jump to\" field appear. |\n| Keyboard | Up to two tab stops while the table is closed: the plot, where the arrow keys move through the points and its value text describes the point in focus, and the toolbar, when the chart has controls. A compact chart has none. See [the keyboard map](accessibility.md#the-keyboard-map). |\n| Reading values | Pointing in the plot shows what is there, by the chart type's rule (nearest x for line and area, the band for bars, the nearest point within 24 px for scatter, the slice for a donut). The tooltip sits against the marks it describes, not at the pointer, and lets the pointer through; rest on a point to move onto its tooltip, click to pin it. In a small plot the same text goes in a strip under the plot. Escape closes it. See [reading values with a pointer](accessibility.md#reading-values-with-a-pointer). |\n| Colour and more than colour | Eight default colours that work in light and dark pages. Lines and areas also carry marker shapes, repeated in the legend and tooltip; bars take fill patterns past the eighth series. |\n| Page theme | Font, text colour and light or dark come from the page. The chart repaints when the page switches scheme. |\n| Size | The chart fills its container's width. With no height set, the plot is 16:9 of the width, between 160 and 480 px tall. It follows the container as it resizes, with no call from you. |\n| States | No rows shows \"No data to show.\" inside the plot, never an empty frame or an invented axis. `state` sets loading, empty and error messages of your own. |\n| Diagnostics | Anything that cannot be drawn as given is reported with a code, the field and rows where they apply, and the fix. When values were left out or changed, the reader is told too. |\n\nThe four states, each a chart with no rows:\n\n[example: states](../examples/states.ts)\n\n## When it looks wrong: three things to check\n\n**1. Read the diagnostics.** Open the browser console. Every problem Axylo found is printed once per code per page as `[axylo AX…] \"Chart title\": what is wrong, where, and how to fix it`. The same list is on the chart as `chart.diagnostics`, current as soon as the call returns. Each code has a page under [Diagnostics](diagnostics.md). Hints, which are advice rather than problems, print in the development build only.\n\n**2. Check which kind of x Axylo read.** A date off by one day almost always means instants where calendar dates were meant (item 1 above). If the tooltip heading names a time zone, Axylo read instants. If the x labels are your strings in input order, it read categories.\n\n**3. Check the values without drawing.** `validate()` runs the same checks as creating the chart, in Node or in a test, with the same options as the chart:\n\n```ts\nimport { validate } from 'axylo';\n\nconst problems = validate('line', { title: 'Monthly visitors', data: rows, x: 'month', y: 'visitors' });\nfor (const d of problems) console.log(d.code, d.level, d.message);\n```\n\nNumbers that arrive as strings, a missing day, two rows for the same day and a misspelled field each have their own code; [Your data](data.md) covers each case.\n\n## Next\n\nRead [Your data](data.md) next: it explains the three shapes rows can take, how dates are read, and what happens to missing values.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '30,96p' apps/docs/pages/stability.md\nsed -n '36,100p' apps/docs/pages/getting-started.md\nsed -n '360,406p;468,520p' apps/docs/lib/site.mjs\nsed -n '124,154p' apps/docs/lib/examples.mjs\nsed -n '1,85p' apps/docs/test/options.test.ts\nrg -n 'NumberKey|StringKey|parse\\\\??:' packages/axylo/src/public.ts\nrg -n 'valuesNotShown|strokeBreaks' rehearsal/grade.mjs\nls -ld apps/docs/dist apps/docs/.cache/unchecked-site packages/axylo/dist\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"sed -n '30,96p' apps/docs/pages/stability.md\nsed -n '36,100p' apps/docs/pages/getting-started.md\nsed -n '360,406p;468,520p' apps/docs/lib/site.mjs\nsed -n '124,154p' apps/docs/lib/examples.mjs\nsed -n '1,85p' apps/docs/test/options.test.ts\nrg -n 'NumberKey|StringKey|parse\\\\??:' packages/axylo/src/public.ts\nrg -n 'valuesNotShown|strokeBreaks' rehearsal/grade.mjs\nls -ld apps/docs/dist apps/docs/.cache/unchecked-site packages/axylo/dist\"","aggregated_output":"|---|---|\n| Browsers | The current and previous major versions of Chrome, Edge and Firefox, and of Safari on macOS and iOS. |\n| TypeScript | 5.4 and later. Plain JavaScript is fully supported; types are an aid, not a requirement. |\n| Frameworks | None needed. No adapter ships in 1.0; the library is called from any framework's mount and unmount hooks. |\n| Node | Importing `axylo` touches no DOM, and `validate()` runs there. Charts themselves need a browser. |\n| Text direction | Left-to-right pages. Right-to-left text renders, but the layout is not mirrored. |\n| Transformed ancestors | A chart inside a translated or scaled element (any positive scale, uniform or not) is exact. Inside a rotated, skewed or mirrored element it draws, but pointing and tooltip placement are wrong: not supported in 1.0. |\n| Built-in text | English. Reader-facing messages are replaceable through `messages`; diagnostics keep their English wording. |\n\nTested so far, on Linux: the library's acceptance tests in Chrome and in Playwright's builds of Firefox and WebKit (Playwright's WebKit, not Safari), and the distribution tests in Chrome (they install the packed package, also under a Content Security Policy). Safari itself, Edge, Windows, macOS and phones have not been tested. No screen-reader rehearsal was done for 1.0. What the acceptance checker recorded for this revision is on the [conformance page](conformance.md); see also [Accessibility](accessibility.md#what-has-and-has-not-been-verified).\n\n## Known limits\n\nThese are known in 1.0 and not fixed in it. Each says what you would see.\n\n- **Closed shadow roots.** In a chart inside a closed shadow root, Escape can be taken by another chart on the page instead of this one. When the chart sits behind a slot inside a closed root, the wrapper around that slot can cut off its tooltip.\n- **A dense ring of scatter points.** Thousands of points packed in a ring just outside the distance at which points count as being at the same place (half a pixel) can make hovering over that spot slow.\n- **A formatter that fails only sometimes.** A formatter that throws for a value on one call and returns text on another can leave [AX160](diagnostics.md#ax160) reported beside a label that reads normally.\n- **CSS aimed at the plot's own column.** The readout strip is measured outside the plot's column, so CSS that applies only inside that column (a container query on it, for example) is not taken into account. A small plot can then show no readout although the strip would fit.\n- **A hold that starts early.** When only the tooltip's size or position changes while the pointer rests on a datum, the rest already spent counts towards the new one, so the hold can begin before a quarter of a second has passed.\n- **One language for the focused point.** The plot's value text is marked with one language, even when the messages it is built from are not all in the same language (some translated, others built in).\n- **Patterns in compact bar charts.** Neighbouring series always differ by fill pattern, but series further apart can share one, since there are four, and then differ by colour only.\n- **Very small numbers.** On an axis of values around 1e-43 or smaller, ticks can be missing or not match their labels.\n- **The end labels of a scatter chart's x axis.** That axis ends on a drawn tick at each end (spec F7) and reserves no extra room for the labels there, so long tick labels are wrapped or rotated to fit rather than left out. On a narrow plot the axis can take a coarser, wider range so that its ends are ticks.\n\n## Size and memory\n\nThe size targets of 1.0, set by the owner after measuring the built library: 116 KiB gzipped for a page that uses everything, and 98 KiB for a page that uses only `line`, the stylesheet included. They are not a release gate yet. The last measurement (`npm run size`, which measures the packed files the way a bundler would):\n\n[table: sizes](../../../bench/size-latest.json)\n\nMemory: once a chart opened on typed columns has been appended to, Axylo keeps its own exact copy of x and y and one state byte per point, 17 bytes per point against the 16 of your two `Float64Array` columns. The memory budget of 1.0 is therefore 1.1 times the size of your two columns, for 1,000,000 points, with no upward trend over 1,000 cycles of create and destroy. This documentation shows no memory measurement. A chart that is never appended to reads typed columns in place where it can (see [what Axylo reads, keeps and copies](data.md#what-axylo-reads-keeps-and-copies)).\n\n## Licence\n\nMIT, for everything: zoom, accessibility and every chart type included. There is no commercial edition and no feature behind a licence key. The library has no runtime dependencies; third-party notices, if any, are checked at each release.\n\n## What is not in 1.0\n\nNot planned for 1.0, with the reason it can wait:\n\n| Not in 1.0 | Why it can wait |\n|---|---|\n| More chart types (histogram first, then heatmap, box plot, candlestick, radar, treemap, sankey, gauge, maps) | Each must pass the same acceptance criteria as the five types in 1.0. |\n| Log and other non-linear scales | They need their own rules for zero and negative values. |\n| A second y axis | Often misleading; it needs a design that keeps the zero baseline honest. |\n| Annotations beyond reference lines and bands | Placing free text interacts with label fitting. |\n| Linked charts (shared cursor, brush) | Needs a small coordination API. |\n| Export to PNG, SVG or CSV, and print styling | CSV from the table view comes first. |\n| Server-side rendering to SVG | The drawing model makes it possible later. |\n| Right-to-left layout mirroring | Stated as a limit in 1.0. |\n| Quarters and ISO weeks as calendar periods | Treat them as ordered categories in 1.0. |\n| Nested field paths (`'user.country'`) | Flatten rows before passing them. |\n| Framework adapters (React, Vue, Svelte, Angular) and a custom element | Thin wrappers over the same handle; until then a chart is created and destroyed from the framework's own hooks (see [Getting started](getting-started.md#using-axylo-in-a-framework)). |\n| A plugin or custom-mark API | Waits until two real uses show its shape. |\n| Translations of built-in text | `messages` makes reader-facing ones possible; only English ships. |\n| Workers, WebGL or WebGPU | Decided from measurements. |\n\nNot the audience for 1.0: analysts exploring data in notebooks, designers building bespoke graphics, and teams that need maps, financial charts or network diagrams.\n\nThe lifecycle as three plain functions:\n\n[example: lifecycle](../examples/lifecycle.ts)\n\n## Daily data: five things to get right\n\nThe first chart above has months as calendar dates and numbers as numbers. Data from an API is often less tidy. Here is a daily metric as many back ends send it, and the chart that reads it correctly:\n\n[example: daily-sessions](../examples/daily-sessions.ts)\n\n1. **Days sent as UTC midnights.** For daily totals sent as `'2026-02-24T00:00:00Z'` (or as epoch milliseconds of a UTC midnight), use `x: { field: 'day', type: 'date' }`. Without it they are instants, shown in the viewer's time zone, so west of UTC each value appears on the day before, with only hint [AX111](diagnostics.md#ax111). Strings such as `'2026-02-24'` need no `type`. See [the three kinds of time](data.md#three-kinds-of-time).\n2. **Numbers sent as strings.** For decimal strings, use `y: { field: 'sessions', parse: 'number' }`. They are converted to JavaScript numbers, which are exact for integers up to 9,007,199,254,740,991; a larger count is rounded without a warning, so check exact counts with `Number.isSafeInteger` first. A field that mixes numbers and strings is not converted at all. See [numbers sent as strings](data.md#numbers-sent-as-strings).\n3. **Row order.** Pass rows in any order. Axylo sorts dated rows by x and keeps each value with its own row; categories keep the order in which they first appear.\n4. **A day with no data.** When you know a day is missing, send it, with `sessions: null`. Axylo can infer a missing day only between two rows of a series that has at least three rows at a regular step, and never before the first row or after the last; with two rows, or an irregular series, the line runs straight across the missing day. See [missing values](data.md#missing-values).\n5. **A misspelled field.** On error [AX101](diagnostics.md#ax101), compare the field you named with the keys the message lists, which come from your rows, and use the suggested spelling when one is offered. With no rows at all the keys cannot be checked, so the error appears once data arrives. With typed rows in TypeScript the typo does not compile.\n\n## What you get without asking\n\n| Feature | What it does |\n|---|---|\n| Name and summary | `title` is the visible heading and the chart's accessible name. In a card that already has a heading, `labelledBy` names the chart with it. The chart's description is a generated summary: chart type, series, the x range with its time zone, the value range, each series' minimum, maximum and last value, and anything left out. `description` adds to it. |\n| Table view | \"View as table\" shows the data as an HTML table, 100 rows per page; above 100 rows a pager and a \"Jump to\" field appear. |\n| Keyboard | Up to two tab stops while the table is closed: the plot, where the arrow keys move through the points and its value text describes the point in focus, and the toolbar, when the chart has controls. A compact chart has none. See [the keyboard map](accessibility.md#the-keyboard-map). |\n| Reading values | Pointing in the plot shows what is there, by the chart type's rule (nearest x for line and area, the band for bars, the nearest point within 24 px for scatter, the slice for a donut). The tooltip sits against the marks it describes, not at the pointer, and lets the pointer through; rest on a point to move onto its tooltip, click to pin it. In a small plot the same text goes in a strip under the plot. Escape closes it. See [reading values with a pointer](accessibility.md#reading-values-with-a-pointer). |\n| Colour and more than colour | Eight default colours that work in light and dark pages. Lines and areas also carry marker shapes, repeated in the legend and tooltip; bars take fill patterns past the eighth series. |\n| Page theme | Font, text colour and light or dark come from the page. The chart repaints when the page switches scheme. |\n| Size | The chart fills its container's width. With no height set, the plot is 16:9 of the width, between 160 and 480 px tall. It follows the container as it resizes, with no call from you. |\n| States | No rows shows \"No data to show.\" inside the plot, never an empty frame or an invented axis. `state` sets loading, empty and error messages of your own. |\n| Diagnostics | Anything that cannot be drawn as given is reported with a code, the field and rows where they apply, and the fix. When values were left out or changed, the reader is told too. |\n\nThe four states, each a chart with no rows:\n\n[example: states](../examples/states.ts)\n\n## When it looks wrong: three things to check\n\n**1. Read the diagnostics.** Open the browser console. Every problem Axylo found is printed once per code per page as `[axylo AX…] \"Chart title\": what is wrong, where, and how to fix it`. The same list is on the chart as `chart.diagnostics`, current as soon as the call returns. Each code has a page under [Diagnostics](diagnostics.md). Hints, which are advice rather than problems, print in the development build only.\n\n**2. Check which kind of x Axylo read.** A date off by one day almost always means instants where calendar dates were meant (item 1 above). If the tooltip heading names a time zone, Axylo read instants. If the x labels are your strings in input order, it read categories.\n\n**3. Check the values without drawing.** `validate()` runs the same checks as creating the chart, in Node or in a test, with the same options as the chart:\n\n```ts\nimport { validate } from 'axylo';\n\nconst problems = validate('line', { title: 'Monthly visitors', data: rows, x: 'month', y: 'visitors' });\nfor (const d of problems) console.log(d.code, d.level, d.message);\n```\n\nNumbers that arrive as strings, a missing day, two rows for the same day and a misspelled field each have their own code; [Your data](data.md) covers each case.\n\n## Next\n\nRead [Your data](data.md) next: it explains the three shapes rows can take, how dates are read, and what happens to missing values.\n${codeBlock(full.source, example.ext)}\n${hostBlock}\n</figure>`;\n}\n\nfunction sourceBlock(label, target, where, ctx) {\n  const [file, range] = target.split('#');\n  const relative = repoPath(where, file);\n  if (!SOURCE_ROOTS.some(root => relative.startsWith(root))) throw new Error(`${path.relative(repoRoot, where)}: [source:] may only quote ${SOURCE_ROOTS.join(', ')}; not ${relative}`);\n  const absolute = path.join(repoRoot, relative);\n  if (!fs.existsSync(absolute)) throw new Error(`${path.relative(repoRoot, where)}: quoted file ${relative} does not exist`);\n  let text = fs.readFileSync(absolute, 'utf8').replace(/\\n$/, '');\n  const lines = range && /^L(\\d+)-L(\\d+)$/.exec(range);\n  if (range && !lines) throw new Error(`${path.relative(repoRoot, where)}: bad line range ${range}`);\n  if (lines) {\n    const all = text.split('\\n');\n    const [from, to] = [Number(lines[1]), Number(lines[2])];\n    if (from < 1 || to > all.length || from > to) throw new Error(`${path.relative(repoRoot, where)}: ${relative} has no lines ${from}–${to}`);\n    text = all.slice(from - 1, to).join('\\n');\n  }\n  ctx.published.add(relative);\n  const ext = path.extname(file).slice(1);\n  const named = label === relative || label === file ? '' : `${escapeHtml(label)} · `;\n  return `<figure class=\"source\"><figcaption>${named}<a href=\"${sourcePath(relative)}${lines ? `#L${lines[1]}` : ''}\">${escapeHtml(relative)}${lines ? `, lines ${lines[1]}–${lines[2]}` : ''}</a></figcaption>${codeBlock(text, ext)}</figure>`;\n}\n\nfunction generatedTable(name, target, where, ctx) {\n  const expected = TABLES[name];\n  if (!expected) throw new Error(`${path.relative(repoRoot, where)}: unknown generated table \"${name}\"`);\n  const relative = repoPath(where, target);\n  if (relative !== expected) throw new Error(`${path.relative(repoRoot, where)}: table \"${name}\" is generated from ${expected}, not ${relative}`);\n  ctx.published.add(relative);\n  const link = url => pageLink(url, where, '', ctx);\n  if (name === 'conformance') return conformanceTables(ctx, link);\n  if (name === 'sizes') return sizesTable(ctx);\n  const table = name === 'diagnostic codes' ? diagnosticsTable(ctx, link)\n    : name === 'theme tokens' ? tokensTable(ctx)\n      : name === 'internal tokens' ? internalTokensTable(ctx)\n        : name === 'messages' ? messagesTable(ctx, link)\n          : paletteTable(ctx);\n  const from = name === 'palette' || name === 'theme tokens'\n    ? ` Colours read from the packed <code>axylo/axylo.css</code>.` : '';\n  const also = name === 'messages' ? ` and, for where each is shown, <a href=\"${sourcePath('apps/docs/data/messages.mjs')}\">apps/docs/data/messages.mjs</a>` : '';\n  if (also) ctx.published.add('apps/docs/data/messages.mjs');\n  return `${table}<p class=\"small\">Generated from <a href=\"${sourcePath(relative)}\">${escapeHtml(relative)}</a>${also}.${from}</p>`;\n}\n\n  }\n  const status = r => r.targetKiB === null ? 'No target' : r.over ? 'Not met' : 'Met';\n  return `${htmlTable(['What a page loads', 'Gzipped, measured', 'Target', 'Target met'], rows.map(r => [\n    `<th scope=\"row\">${escapeHtml(r.entry)}</th>`, `<td>${escapeHtml(r.totalKiB.toFixed(2))} KiB</td>`,\n    `<td>${r.targetKiB === null ? '–' : `${escapeHtml(String(r.targetKiB))} KiB`}</td>`, `<td>${status(r)}</td>`,\n  ]), 'Measured sizes')}<p class=\"small\">Measured from the same packed tarball this site installed (${escapeHtml(method)}).</p>${note}`;\n}\n\nfunction htmlTable(head, rows, caption) {\n  const th = head.map(h => `<th scope=\"col\">${escapeHtml(h)}</th>`).join('');\n  return `<div class=\"table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"${escapeHtml(caption)}\"><table><thead><tr>${th}</tr></thead><tbody>${rows.map(r => `<tr>${r.join('')}</tr>`).join('')}</tbody></table></div>`;\n}\n\nfunction diagnosticsTable(ctx, link) {\n  const rows = ctx.diagnostics.map(d => [\n    `<th scope=\"row\"><a href=\"diagnostics/${d.code}.html\">${d.code}</a></th>`,\n    `<td><span class=\"level level-${d.level}\">${escapeHtml(d.level)}</span></td>`,\n    `<td>${renderInline(d.condition, link)}</td>`,\n    `<td>${renderInline(d.drawn, link)}</td>`,\n  ]);\n  return htmlTable(['Code', 'Level', 'When', 'What is drawn'], rows, 'Diagnostic codes');\n}\n\nfunction swatch(value) {\n  // Only a colour read from the library's own stylesheet reaches a style attribute, and only as a hex value.\n  if (!HEX.test(value)) throw new Error(`not a hex colour: ${value}`);\n  return `<span class=\"swatch\" style=\"background: ${value}\" aria-hidden=\"true\"></span><code>${escapeHtml(value)}</code>`;\n}\n\nfunction tokensTable(ctx) {\n  const rows = ctx.tokens.map(t => {\n    const cell = scheme => t.default\n      ? `<td>${swatch(ctx.theme[scheme][t.default] ?? missing(t.default, scheme))}</td>`\n      : `<td>${renderInline(t.unset)}</td>`;\n    // What it affects comes before the defaults, so a phone shows it without scrolling the table.\n    return [`<th scope=\"row\"><code>${escapeHtml(t.name)}</code></th>`, `<td class=\"wide\">${renderInline(t.affects)}</td>`, cell('light'), cell('dark')];\n  });\n  return htmlTable(['Property', 'What it affects', 'Light default', 'Dark default'], rows, 'Theme custom properties');\n}\n\nfunction missing(name, scheme) {\n  throw new Error(`axylo.css has no ${name} in the ${scheme} scheme`);\n}\n\nfunction internalTokensTable(ctx) {\n  const rows = ctx.internalTokens.map(t => [`<th scope=\"row\"><code>${escapeHtml(t.name)}</code></th>`, `<td>${renderInline(t.why)}</td>`]);\n  return htmlTable(['Property', 'Why it exists'], rows, 'Internal custom properties');\n}\n\n/** Keys and text from the library's defaultMessages; where each is shown from data/messages.mjs, key for key. */\nfunction messagesTable(ctx, link) {\n  const keys = Object.keys(ctx.messages);\n  const unknown = Object.keys(ctx.messageUses).filter(key => !keys.includes(key));\n      fs.writeFileSync(path.join(src, script.file), script.kind === 'classic' ? script.code + '\\nexport {};\\n' : script.code);\n      scripts[script.file] = { example: example.file, line: script.line, kind: script.kind };\n    }\n  }\n  for (const file of fs.readdirSync(path.join(examplesDir, 'node')).filter(f => f.endsWith('.ts'))) {\n    fs.copyFileSync(path.join(examplesDir, 'node', file), path.join(src, 'node', file));\n  }\n  return { src, scripts };\n}\n/**\n * The options reference (apps/docs/pages/options.md) against the public types, read with the TypeScript\n * compiler API (typescript/unstable/sync, TypeScript 7) from the source declarations, so it needs no build:\n *\n * - keys: every key of every option type, field type, handle and event in packages/axylo/src/public.ts (and\n *   in the reference, and nothing else is;\n * - types: each documented type is the declared type of that key, both ways assignable (`Options` in the\n *   reference stands for the chart's options type, checked as LineOptions<Row>);\n * - required: a key documented with default \"required\" is required in the type, and every other key is\n *   optional. Defaults written in `code` are checked against the running chart by defaults.browser.test.ts.\n *\n * Each table in the reference is marked `<!-- options: Group -->`; its first column holds the key, its second\n * the type, and for option tables the third the default. GROUPS says which type each group documents.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { API } from 'typescript/unstable/sync';\nimport { cacheDir, docsRoot, repoRoot } from '../lib/examples.mjs';\nimport { defaultMessages } from '../../../packages/axylo/src/messages/index';\nimport { messageUses } from '../data/messages.mjs';\n\nconst L = 'LineOptions<Row>';\n/** The type a group documents, and the keys of that type the group stands for. */\nconst GROUPS: Record<string, { type: string; keys: string }> = {\n  CommonOptions: { type: 'CommonOptions<Row>', keys: 'Keys<CommonOptions<Row>>' },\n  Title: { type: 'Title', keys: 'Keys<Title>' },\n  Encoding: { type: 'Encoding<Row>', keys: 'Keys<Encoding<Row>>' },\n  CartesianOptions: { type: 'CartesianOptions', keys: 'Keys<CartesianOptions>' },\n  Reference: { type: 'Reference', keys: 'Keys<Reference>' },\n  CompactOption: { type: 'CompactOption', keys: 'Keys<CompactOption>' },\n  AreaOptions: { type: 'AreaOptions<Row>', keys: `Exclude<Keys<AreaOptions<Row>>, Keys<${L}>>` },\n  BarOptions: { type: 'BarOptions<Row>', keys: `Exclude<Keys<BarOptions<Row>>, Keys<${L}>>` },\n  ScatterOptions: { type: 'ScatterOptions<Row>', keys: 'Exclude<Keys<ScatterOptions<Row>>, Keys<CommonOptions<Row>> | Keys<CartesianOptions>>' },\n  DonutOptions: { type: 'DonutOptions<Row>', keys: 'Exclude<Keys<DonutOptions<Row>>, Keys<CommonOptions<Row>>>' },\n  ValueField: { type: 'Exclude<ValueField<Row>, string>', keys: 'Keys<Exclude<ValueField<Row>, string>>' },\n  XField: { type: 'Exclude<XField<Row>, string>', keys: 'Keys<Exclude<XField<Row>, string>>' },\n  ScatterXField: { type: 'Exclude<ScatterXField<Row>, string>', keys: 'Keys<Exclude<ScatterXField<Row>, string>>' },\n  Chart: { type: `Chart<Row, ${L}>`, keys: `Keys<Chart<Row, ${L}>>` },\n  AppendOptions: { type: `NonNullable<Parameters<Chart<Row, ${L}>['append']>[1]>`, keys: `Keys<NonNullable<Parameters<Chart<Row, ${L}>['append']>[1]>>` },\n  ChartEvents: { type: 'ChartEvents<Row>', keys: 'Keys<ChartEvents<Row>>' },\n  Point: { type: 'Point<Row>', keys: 'Keys<Point<Row>>' },\n  Diagnostic: { type: 'Diagnostic', keys: 'Keys<Diagnostic>' },\n};\n// Checks on the types themselves, so a key added to a composite type directly is not missed.\nconst EXTRA: Record<string, string> = {\n  LineOptions: `Keys<${L}>`,\n  Messages: 'Keys<Messages>',\n};\n\ninterface Row { key: string; type: string; def: string | null }\n\n/** Rows per marked table of options.md: the key(s) in the first cell, the type, the default if there is one. */\nfunction documented(): Record<string, Row[]> {\n  const source = fs.readFileSync(path.join(docsRoot, 'pages/options.md'), 'utf8').split('\\n');\n  const out: Record<string, Row[]> = {};\n  const cells = (line: string) => line.trim().replace(/^\\|/, '').replace(/\\|$/, '').split(/(?<!\\\\)\\|/).map(c => c.trim().replace(/\\\\\\|/g, '|'));\n  const code = (cell: string) => /^``\\s(.+)\\s``$/.exec(cell)?.[1] ?? /^`([^`]+)`$/.exec(cell)?.[1] ?? null;\n  for (let i = 0; i < source.length; i++) {\n    const marker = /^<!-- options: (\\w+) -->$/.exec(source[i]!.trim());\n    if (!marker) continue;\n    const header = cells(source[i + 1]!);\n    const hasDefault = header[2] === 'Default';\n    const rows: Row[] = [];\n    for (let j = i + 3; j < source.length && source[j]!.startsWith('|'); j++) {\n      const [key, type, 