{"type":"item.completed","item":{"id":"item_50","type":"command_execution","command":"/bin/bash -lc \"sed -n '111,173p' apps/docs/test/examples.browser.test.ts\ngit diff -- apps/docs/pages/{data,options,diagnostics,getting-started,stability,conformance}.md\nrg -n 'function noteCheck|function dateCheck' rehearsal/reader.mjs\nrg -n 'equalHashes|hashes|alternate' rehearsal/{summary,reaudit}.mjs\"","aggregated_output":"  });\n\n  it.each(examples.map(example => [example.repoFile, example] as const))('%s', async (_file, example) => {\n    const context = await browser.newContext({ viewport: { width: 760, height: 900 }, locale: 'en-US', timezoneId: 'America/Los_Angeles' });\n    const page = await context.newPage();\n    const problems: string[] = [];\n    const codes = new Set<string>();\n    page.on('pageerror', error => problems.push(`page error: ${error.message}`));\n    page.on('console', message => {\n      const text = message.text();\n      for (const m of text.matchAll(/^\\[axylo (AX\\d{3})\\]/g)) codes.add(m[1]!);\n      if (message.type() === 'error') problems.push(`console.error: ${text}`);\n      if (message.type() === 'warning' && !text.startsWith('[axylo ')) problems.push(`console.warn: ${text}`);\n    });\n    page.on('requestfailed', request => problems.push(`request failed: ${request.url()}`));\n    page.on('response', response => { if (response.status() >= 400) problems.push(`HTTP ${response.status()}: ${response.url()}`); });\n    await page.goto(server.url(`examples/${example.name}.html`));\n\n    const check = checks[example.name]!;\n    // Ready when the expected charts exist and each has drawn marks or shows a state message.\n    await page.waitForFunction(count => {\n      const figures = [...document.querySelectorAll('figure.axylo-figure')];\n      return figures.length === count && figures.every(f =>\n        f.querySelector('svg [style*=\"--axylo-series-color\"]') !== null ||\n        [...f.querySelectorAll('.axylo-message')].some(m => !(m as HTMLElement).hidden && m.textContent));\n    }, check.charts, { timeout: 15_000 });\n    await page.evaluate(() => new Promise(resolve => { let n = 0; const tick = () => (++n < 3 ? requestAnimationFrame(tick) : resolve(null)); requestAnimationFrame(tick); }));\n\n    const charts = await page.evaluate(() => [...document.querySelectorAll('figure.axylo-figure')].map(f => {\n      const labelled = f.getAttribute('aria-labelledby');\n      const name = (f.getAttribute('aria-label') ?? '') ||\n        (labelled ?? '').split(/\\s+/).map(id => document.getElementById(id)?.textContent ?? '').join(' ').trim();\n      const marks = [...f.querySelectorAll('svg [style*=\"--axylo-series-color\"]')].filter(el => {\n        const box = (el as SVGGraphicsElement).getBBox();\n        return box.width > 0 || box.height > 0;\n      }).length;\n      const message = [...f.querySelectorAll('.axylo-message')].find(m => !(m as HTMLElement).hidden)?.textContent ?? '';\n      return { role: f.getAttribute('role'), name, marks, message };\n    }));\n\n    expect(charts.length, `${example.repoFile}: charts`).toBe(check.charts);\n    for (const chart of charts) {\n      expect(['group', 'img'], `${example.repoFile}: role`).toContain(chart.role);\n      expect(chart.name, `${example.repoFile}: accessible name`).not.toBe('');\n      if (example.noMarks) {\n        expect(chart.message, `${example.repoFile}: a state message`).not.toBe('');\n        expect(chart.marks, `${example.repoFile}: no marks`).toBe(0);\n      } else {\n        expect(chart.marks, `${example.repoFile}: \"${chart.name}\" draws marks (message: \"${chart.message}\")`).toBeGreaterThan(0);\n      }\n    }\n    await check.run(tools(page));\n    expect(problems, `${example.repoFile}: errors`).toEqual([]);\n    expect([...codes].sort(), `${example.repoFile}: diagnostics printed`).toEqual([...example.raises].sort());\n    await context.close();\n  }, 60_000);\n});\ndiff --git a/apps/docs/pages/conformance.md b/apps/docs/pages/conformance.md\nindex 26c5b65..544426e 100644\n--- a/apps/docs/pages/conformance.md\n+++ b/apps/docs/pages/conformance.md\n@@ -6,6 +6,8 @@ This page is generated each time the site is built, from the specification's cri\n \n ## What the evidence can and cannot show\n \n+On release candidate `1e93128`, Codex CLI `gpt-6.2-sol` and Claude Code `claude-opus-5-5` each passed three uncoached attempts on each of four fixed line and bar tasks. All 24 attempts passed after the transcript re-audit. In Chrome 158, each saved answer passed the reader checks without error diagnostics on both inputs in the Los Angeles and Tokyo time zones. This agent rehearsal gives no estimate of general success and provides no evidence of human or screen-reader usability or WCAG conformance. The prompt restricted agents to the published docs for guidance, and the audit checked recorded access. The filesystem did not enforce docs-only access.\n+\n - **Automated checks only.** The acceptance tests check structure: names, roles, focus order, contrast, sizes and text. They do not show that a person using a screen reader understands a chart.\n - **No screen-reader rehearsal was done for 1.0.** No screen reader has been run against these charts, so nothing in this documentation says what a screen reader speaks.\n - **No usability testing with disabled people.** Axylo is built by one person with no access to study participants, and no claim of usability testing with disabled users is made.\ndiff --git a/apps/docs/pages/data.md b/apps/docs/pages/data.md\nindex 5d8d1ec..395f1c1 100644\n--- a/apps/docs/pages/data.md\n+++ b/apps/docs/pages/data.md\n@@ -117,15 +117,25 @@ Here are the values an application sends by mistake, all at once. The note under\n \n ## Numbers sent as strings\n \n-Some database drivers return counts and decimals as strings (Postgres `bigint` and `numeric`, BigQuery). Axylo looks at the whole field:\n+Some database drivers return counts and decimals as strings (Postgres `bigint` and `numeric`, BigQuery). Axylo checks the whole value field and skips missing values such as `null` and `\"\"` when deciding whether to convert it.\n \n-- When every value is a plain decimal string (`'40'`, `'-1.5'`, and exponent notation such as `'1e3'`), the field is converted and drawn, and hint [AX104](diagnostics.md#ax104) asks you to say so with `parse: 'number'`. With that, there is no hint, and TypeScript accepts the string field on a value axis.\n-- When the field also holds a number, or any string that is not a plain decimal (`'1,234'`, `'n/a'`), or another kind of value (`true`), every string in it is rejected, plain decimals included. They are not drawn, and they are warning [AX106](diagnostics.md#ax106).\n+A decimal string has an optional `+` or `-`, then one or more digits from `0` to `9`. A decimal point is optional and must be followed by one or more digits. An optional exponent starts with `e` or `E`, followed by an optional sign and one or more digits. The whole string must fit this grammar, with no whitespace. Axylo accepts `\"40\"`, `\"-1.5\"`, `\"+2\"`, `\"1e3\"` and `\"2.5E-2\"`. It rejects `\".5\"`, `\"5.\"`, `\"0x10\"`, `\"1,234\"`, `\" 40 \"` and `\"1e\"`.\n \n-The conversion is to JavaScript numbers. Integers are exact up to 9,007,199,254,740,991 (`Number.MAX_SAFE_INTEGER`); a larger one is rounded to the nearest number JavaScript can hold, without a diagnostic: `'9007199254740993'` reads 9,007,199,254,740,992. A string too large for a number (`'1e999'`) becomes infinite and is [AX103](diagnostics.md#ax103). When exact counts could exceed that limit, check them with `Number.isSafeInteger(Number(value))` before charting.\n+- When every non-missing value matches, Axylo converts the strings to JavaScript numbers. Hint [AX104](diagnostics.md#ax104) asks you to declare `parse: 'number'`. The declaration suppresses that hint and lets TypeScript accept the string field on a value axis.\n+- A number, a string outside the grammar, or another kind of value such as `true` prevents string conversion for the whole field, even with `parse: 'number'`. Axylo draws the finite numbers and reports the non-missing strings it leaves out with warning [AX106](diagnostics.md#ax106).\n+\n+JavaScript represents integers exactly up to 9,007,199,254,740,991 (`Number.MAX_SAFE_INTEGER`). Larger integers can round without a diagnostic. For example, `\"9007199254740993\"` reads as 9,007,199,254,740,992. When a matching string such as `\"1e999\"` converts to infinity, Axylo leaves it out with warning [AX103](diagnostics.md#ax103). When exact counts could exceed the safe integer limit, check accepted strings with `Number.isSafeInteger(Number(value))` before charting.\n \n [example: numeric-strings](../examples/numeric-strings.ts)\n \n+### A field that mixes numbers and strings\n+\n+With `[1250, \"1340.5\", 980]` as given, the middle value leaves a break in the line. Its table cell reads “No data”. Axylo reports AX106 and the chart shows “Values not shown: 1. See table.” in the figure and in the accessibility tree.\n+\n+Before charting, convert only strings that match the grammar. Leave other values as they came in so Axylo can report them. The second chart draws all three valid values and adds a fourth row with `\"0x10\"` to show how AX106 and the reader's note still report the omission.\n+\n+[example: mixed-numbers](../examples/mixed-numbers.html)\n+\n ## Order and duplicates\n \n Rows can come in any order. Line, area and scatter charts are drawn in x order, and each value stays with its own row; categories keep the order in which they first appear.\n@@ -161,4 +171,4 @@ Value axes (y, and both axes of a scatter chart) end on a drawn tick at or beyon\n \n ## Checking data before you draw\n \n-`validate(type, options)` runs the same reading and checking as a chart, without a page, and returns the diagnostics. Use it in Node, in a unit test, or in a coding agent's loop before rendering. See [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\n+`validate(type, options)` runs the chart's input checks without a page. It returns every finding from those checks, including hints, in every build. For a check you can run with `node check.mjs`, see [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\ndiff --git a/apps/docs/pages/diagnostics.md b/apps/docs/pages/diagnostics.md\nindex b6bb967..3c55a3e 100644\n--- a/apps/docs/pages/diagnostics.md\n+++ b/apps/docs/pages/diagnostics.md\n@@ -58,9 +58,13 @@ Most diagnostics are found while a call checks its input: the create, `update` o\n \n ## validate() in Node and in tests\n \n-`validate(type, options)` runs the same reading and checking as creating a chart (options, data, view, name) without a DOM, and returns the diagnostics a created chart would report from its call. It takes the same options as the chart type, so it type-checks the same way. Importing `axylo` in Node does not touch the DOM.\n+`validate(type, options)` runs the same input checks as creating a chart (options, data, view, name) without a DOM. It returns every finding from those checks, including hints, in every build. It takes the same options as the chart type, so it type-checks the same way. Importing `axylo` in Node does not touch the DOM.\n \n-Use it on a server, in a build step, or in a coding agent's loop:\n+In a project with `axylo` installed, save this plain JavaScript as `check.mjs` and run `node check.mjs`. It prints hint AX105 for the missing day.\n+\n+[source: examples/node/check.mjs](../examples/node/check.mjs)\n+\n+Here is a TypeScript check for a build step or server.\n \n [source: examples/node/validate.ts](../examples/node/validate.ts)\n \n@@ -68,7 +72,7 @@ Or in a unit test, so that a change in the data a query returns fails the build\n \n [source: examples/node/chart-data.test.ts](../examples/node/chart-data.test.ts)\n \n-Both files are type-checked and run by this documentation's own tests, against the packed package. The package's declarations refer to DOM types, so a TypeScript configuration for Node code needs `\"lib\": [\"ES2022\", \"DOM\"]` (or `skipLibCheck`). `validate()` cannot find what only a page can show: the diagnostics listed under \"When they are found\" need a browser. It can tell that a chart has neither `title` nor `labelledBy`, but not whether a `labelledBy` id exists.\n+The documentation tests type-check and run these examples against the packed package. The package's declarations refer to DOM types, so a TypeScript configuration for Node code needs `\"lib\": [\"ES2022\", \"DOM\"]` (or `skipLibCheck`). Findings that depend on drawing require a browser. `validate()` can check whether you supplied a `title` or `labelledBy`. Checking whether the id exists requires a page.\n \n ## Every code\n \ndiff --git a/apps/docs/pages/getting-started.md b/apps/docs/pages/getting-started.md\nindex e75da17..3a4e691 100644\n--- a/apps/docs/pages/getting-started.md\n+++ b/apps/docs/pages/getting-started.md\n@@ -74,7 +74,11 @@ The four states, each a chart with no rows:\n \n **2. Check which kind of x Axylo read.** A date off by one day almost always means instants where calendar dates were meant (item 1 above). If the tooltip heading names a time zone, Axylo read instants. If the x labels are your strings in input order, it read categories.\n \n-**3. Check the values without drawing.** `validate()` runs the same checks as creating the chart, in Node or in a test, with the same options as the chart:\n+**3. Check the values without drawing.** `validate()` runs the chart's input checks in Node or in a test, with the same options as the chart. It returns every finding from those checks, including hints, in every build. In a project with `axylo` installed, save this plain JavaScript as `check.mjs` and run `node check.mjs`.\n+\n+[source: examples/node/check.mjs](../examples/node/check.mjs)\n+\n+To check the monthly visitors chart above in TypeScript, pass its rows and options to `validate()`.\n \n ```ts\n import { validate } from 'axylo';\ndiff --git a/apps/docs/pages/options.md b/apps/docs/pages/options.md\nindex e18a106..ab69378 100644\n--- a/apps/docs/pages/options.md\n+++ b/apps/docs/pages/options.md\n@@ -133,7 +133,7 @@ A value field is a key of `Row` whose values are numbers (or `null`), or an obje\n | Key | Type | Default | Meaning |\n |---|---|---|---|\n | `field` | `NumberKey<Row> \\| StringKey<Row>` | required | The key of the row: a number field, or a string field with `parse`. |\n-| `parse` | `'number'` | none | The field holds numbers as strings; convert them to JavaScript numbers (exact for integers up to 9,007,199,254,740,991). |\n+| `parse` | `'number'` | none | Declares a field of decimal strings and suppresses hint AX104. Axylo converts strings only when every non-missing value matches the [decimal grammar](data.md#numbers-sent-as-strings). |\n | `label` | `string` | the field name | Axis title, and the series name in tooltip, table and announcements. |\n | `unit` | `string` | none | Follows values in tooltip, table and announcements: `'ms'`, `'USD'`. |\n | `scale` | `'percent' \\| 'ratio'` | none | Percentage data: `'percent'` is 0–100, `'ratio'` is 0–1. Never inferred. |\n@@ -142,6 +142,10 @@ A value field is a key of `Row` whose values are numbers (or `null`), or an obje\n | `missing` | `'gap' \\| 'zero'` | `'gap'` | What a missing value means. `'zero'` is for counts where absence means none. |\n | `domain` | `readonly [number, number]` | from the data | Author bounds. On bar and area, widened to include zero (AX110). In a wide chart only the first field's applies. |\n \n+A decimal string starts with an optional `+` or `-` and one or more digits from `0` to `9`. It may then have a decimal point followed by one or more digits, and an exponent (`e` or `E`, an optional sign and one or more digits). The whole string must match, with no whitespace. Examples that match are `\"40\"`, `\"-1.5\"`, `\"+2\"` and `\"1e3\"`. Examples that fail are `\".5\"`, `\"5.\"`, `\"0x10\"` and `\"1,234\"`. A matching string that converts to infinity is omitted with [AX103](diagnostics.md#ax103).\n+\n+In `[1250, \"1340.5\", 980]`, the middle value is left out with [AX106](diagnostics.md#ax106) even with `parse: 'number'`. It makes a gap and the reader sees an omission note. The [runnable normalization example](data.md#a-field-that-mixes-numbers-and-strings) converts the valid strings before passing the rows to Axylo and keeps invalid values so they are reported.\n+\n ## X fields\n \n An x field is a key of `Row` whose values are numbers, strings or `Date`s, or an object.\n@@ -227,7 +231,7 @@ Every chart function returns a `Chart<Row, Options>`.\n \n ## validate\n \n-`validate(type, options)` takes `'line'`, `'area'`, `'bar'`, `'scatter'` or `'donut'` and that type's options, runs the checks a created chart runs from its call without a DOM, and returns `Diagnostic[]`. It cannot find what needs a page: contrast, sizes, label fitting, formatters, or whether a `labelledBy` id exists. See [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\n+`validate(type, options)` takes `'line'`, `'area'`, `'bar'`, `'scatter'` or `'donut'` and that type's options. It runs the chart's input checks without a DOM and returns every finding in a `Diagnostic[]`, including hints, in every build. Checks for contrast, sizes, label fitting, formatters and matching a `labelledBy` id need a page. For a check you can run with `node check.mjs`, see [Diagnostics](diagnostics.md#validate-in-node-and-in-tests).\n \n ## Messages\n \ndiff --git a/apps/docs/pages/stability.md b/apps/docs/pages/stability.md\nindex c7a31f1..de986bd 100644\n--- a/apps/docs/pages/stability.md\n+++ b/apps/docs/pages/stability.md\n@@ -31,7 +31,7 @@ These are the targets of 1.0 (spec section 2.3). What has been verified so far i\n | Browsers | The current and previous major versions of Chrome, Edge and Firefox, and of Safari on macOS and iOS. |\n | TypeScript | 5.4 and later. Plain JavaScript is fully supported; types are an aid, not a requirement. |\n | Frameworks | None needed. No adapter ships in 1.0; the library is called from any framework's mount and unmount hooks. |\n-| Node | Importing `axylo` touches no DOM, and `validate()` runs there. Charts themselves need a browser. |\n+| Node | Importing `axylo` touches no DOM. `validate()` returns every finding from the input checks, including hints, in every build. For a check you can run with `node check.mjs`, see [Diagnostics](diagnostics.md#validate-in-node-and-in-tests). Charts themselves need a browser. |\n | Text direction | Left-to-right pages. Right-to-left text renders, but the layout is not mirrored. |\n | Transformed ancestors | A chart inside a translated or scaled element (any positive scale, uniform or not) is exact. Inside a rotated, skewed or mirrored element it draws, but pointing and tooltip placement are wrong: not supported in 1.0. |\n | Built-in text | English. Reader-facing messages are replaceable through `messages`; diagnostics keep their English wording. |\n@@ -52,6 +52,10 @@ These are known in 1.0 and not fixed in it. Each says what you would see.\n - **Very small numbers.** On an axis of values around 1e-43 or smaller, ticks can be missing or not match their labels.\n - **The end labels of a scatter chart's x axis.** That axis ends on a drawn tick at each end (spec F7) and reserves no extra room for the labels there, so long tick labels are wrapped or rotated to fit rather than left out. On a narrow plot the axis can take a coarser, wider range so that its ends are ticks.\n \n+## Agent rehearsal\n+\n+On release candidate `1e93128`, Codex CLI `gpt-6.2-sol` and Claude Code `claude-opus-5-5` each passed three uncoached attempts on each of four fixed line and bar tasks. All 24 attempts passed after the transcript re-audit. In Chrome 158, each saved answer passed the reader checks without error diagnostics on both inputs in the Los Angeles and Tokyo time zones. This agent rehearsal gives no estimate of general success and provides no evidence of human or screen-reader usability or WCAG conformance. The prompt restricted agents to the published docs for guidance, and the audit checked recorded access. The filesystem did not enforce docs-only access.\n+\n ## Size and memory\n \n The size targets of 1.0, set by the owner after measuring the built library: 116 KiB gzipped for a page that uses everything, and 98 KiB for a page that uses only `line`, the stylesheet included. They are not a release gate yet. The last measurement (`npm run size`, which measures the packed files the way a bundler would):\n79:export async function noteCheck(page, figure, count = 0) {\n90:export async function dateCheck(figure, expected) {\nrehearsal/reaudit.mjs:32:  const { workspace, runDirectory, hashes } = await prepareWorkspace(workdir, task, {\nrehearsal/reaudit.mjs:36:    const keys = new Set([...Object.keys(hashes), ...Object.keys(record.hashes ?? {})]);\nrehearsal/reaudit.mjs:37:    const changed = [...keys].filter(key => hashes[key] !== record.hashes?.[key]);\nrehearsal/reaudit.mjs:38:    if (changed.length) throw new Error('Saved hashes do not match prepared inputs: ' + changed.join(', '));\n","exit_code":0,"status":"completed"}}
