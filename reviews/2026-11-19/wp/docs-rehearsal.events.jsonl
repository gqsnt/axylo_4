\n  });\n  const manifest = [];\n  for (const e of examples) {\n    fs.writeFileSync(path.join(outDir, 'examples', `${e.name}.html`), examplePage(e));\n    manifest.push({ name: e.name, file: e.file, repoFile: e.repoFile, ext: e.ext, raises: e.raises, noMarks: e.noMarks, targets: e.targets });\n  }\n  fs.writeFileSync(path.join(outDir, 'examples/manifest.json'), JSON.stringify(manifest, null, 2));\n  return manifest;\n}\n\nfunction examplePage(e) {\n  let body;\n  let styles = '';\n  if (e.documentPage) {\n    // The snippet's own page, with the CDN files answered by the same files from the packed package.\n    const page = e.source\n      .replace(/https:\\/\\/cdn\\.jsdelivr\\.net\\/npm\\/axylo\\/dist\\/(axylo\\.(?:css|iife\\.min\\.js|iife\\.js))/g, '$1')\n      .replace(/<link rel=\"stylesheet\"/, '<link rel=\"icon\" href=\"data:,\">\\n<link rel=\"stylesheet\" href=\"../assets/site.css\">\\n<link rel=\"stylesheet\"');\n    if (/https?:\\/\\//.test(page)) throw new Error(`${e.repoFile}: a URL this site cannot serve remains in the page`);\n    return `${page.replace(/\\n?$/, '\\n')}<script src=\"../assets/frame.js\" defer></script>\\n`;\n  }\n  if (e.ext === 'html') {\n    // The example's own <style> goes to the head, where it belongs; each module script becomes its bundle.\n    styles = [...e.source.matchAll(/<style>[\\s\\S]*?<\\/style>\\n?/g)].map(m => m[0]).join('');\n    body = e.source.replace(/<style>[\\s\\S]*?<\\/style>\\n?/g, '');\n    for (const s of htmlScripts(e).filter(s => s.kind === 'module')) {\n      body = body.replace(s.match, `<script type=\"module\" src=\"js/${escapeHtml(s.file)}\"></script>`);\n    }\n  } else {\n    body = e.targets.map(id => `<div id=\"${escapeHtml(id)}\" class=\"example-target\"></div>`).join('\\n') +\n      `\\n<script type=\"module\" src=\"js/${e.name}.js\"></script>`;\n  }\n  return `<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n  const ids = reservedIds();\n  const where = path.join(pagesDir, `${entry.page}.md`);\n  const body = markdownToHtml(source, {\n    headings, ids,\n    link: url => pageLink(url, where, '', ctx),\n    directive: d => directive(d, where, ctx, ids),\n  });\n  const title = headings.find(h => h.level === 1)?.text ?? entry.label;\n  const prev = pages[index - 1];\n  const next = pages[index + 1];\n  const pager = `<nav class=\"pager\" aria-label=\"Previous and next page\">${prev ? `<a rel=\"prev\" href=\"${prev.page}.html\">← ${escapeHtml(prev.label)}</a>` : '<span></span>'}${next ? `<a rel=\"next\" href=\"${next.page}.html\">${escapeHtml(next.label)} →</a>` : ''}</nav>`;\n  return layout({ title, body: body + pager, current: entry.page, base: '', ctx, sourceFile: `apps/docs/pages/${entry.page}.md` });\n}\n\n/** Ids the layout itself uses, reserved before a page's headings get theirs. */\nconst reservedIds = () => new Set(['main']);\n\nconst PAGE_NAMES = new Set(pages.map(p => p.page));\n\n/**\n * Rewrites a link written for the Markdown sources (readable on a code host) to its place in the site.\n * `from` is the file the link is written in; `base` is the path from the page being built to the site root.\n * A link to any other file of the repository publishes that file as a source page.\n */\nexport function pageLink(url, from, base, ctx) {\n  checkHref(url);\n  if (/^(https|mailto):/i.test(url) || url.startsWith('#')) return url;\n  const [file, hash] = url.split('#');\n  if (file === 'diagnostics.md' && hash && /^ax\\d{3}$/i.test(hash)) return `${base}diagnostics/${hash.toUpperCase()}.html`;\n  const name = file.endsWith('.md') && !file.includes('/') ? file.slice(0, -3) : null;\n  if (name !== null && PAGE_NAMES.has(name)) return `${base}${name}.html${hash ? '#' + hash : ''}`;\n  const absolute = path.resolve(path.dirname(from), file);\n  const relative = path.relative(repoRoot, absolute).split(path.sep).join('/');\n  if (relative.startsWith('..') || path.isAbsolute(relative)) throw new Error(`${path.relative(repoRoot, from)}: link ${url} leaves the repository`);\n  if (!fs.existsSync(absolute) || fs.statSync(absolute).isDirectory()) throw new Error(`${path.relative(repoRoot, from)}: link ${url} names no file`);\n  ctx.published.add(relative);\n// ---------- source pages ----------\n\nfunction writeSourcePage(outDir, relative, ctx) {\n  const text = fs.readFileSync(path.join(repoRoot, relative), 'utf8').replace(/\\n$/, '');\n  const depth = relative.split('/').length; // source/<relative>.html\n  const base = '../'.repeat(depth);\n  const numbered = text.split('\\n').map((line, i) => `<span class=\"line\" id=\"L${i + 1}\">${escapeHtml(line)}\\n</span>`).join('');\n  const at = ctx.revision.dirty ? `revision ${ctx.revision.short} with uncommitted changes` : `revision ${ctx.revision.short}`;\n  const body = `<p class=\"crumb\">Repository file, as it was at ${escapeHtml(at)} when this site was built</p>\n<h1 id=\"top\" class=\"source-title\"><code>${escapeHtml(relative)}</code></h1>\n<pre class=\"source-file\" tabindex=\"0\"><code>${numbered}</code></pre>`;\n  const file = path.join(outDir, sourcePath(relative));\n  fs.mkdirSync(path.dirname(file), { recursive: true });\n  fs.writeFileSync(file, layout({ title: relative, body, current: null, base, ctx, sourceFile: relative }));\n}\n\n// ---------- layout ----------\n\nfunction layout({ title, body, current, base, ctx, sourceFile }) {\n  return text.split(' | ').map(part => part.startsWith('\"') ? JSON.parse(part) as string : part.replace(/^`(.*)\\$\\{string\\}`$/, '$1*')).sort();\n}\n\nconst keyType = (key: string) => key === 'data-*' ? '`data-${string}`' : JSON.stringify(key);\nconst documentedType = (text: string) => text.replace(/\\bOptions\\b/g, L);\n\nbeforeAll(() => {\n  fs.mkdirSync(dir, { recursive: true });\n  const rel = (p: string) => path.relative(dir, path.join(repoRoot, p)).split(path.sep).join('/');\n  fs.writeFileSync(path.join(dir, 'tsconfig.json'), JSON.stringify({\n    extends: rel('tsconfig.base.json'),\n    compilerOptions: {\n      noEmit: true, types: [],\n      paths: { axylo: [rel('packages/axylo/src/index.ts')] },\n    },\n    files: ['probe.ts', rel('packages/axylo/src/core/globals.d.ts')],\n  }, null, 2));\n  const lines = [\n    \"import type { AreaOptions, BarOptions, CartesianOptions, Chart, ChartEvents, CommonOptions, CompactOption, Data, Diagnostic, DonutOptions, Encoding, LineOptions, Messages, NumberKey, Point, Reference, ScatterOptions, ScatterXField, SeriesKey, StringKey, Title, ValueField, XField, XKey, XValue } from 'axylo';\",\n    'interface Row { day: string; v: number; s: string }',\n    'type Keys<T> = T extends unknown ? { [K in keyof T]-?: [Exclude<T[K], undefined>] extends [never] ? never : K }[keyof T] : never;',\n    'type Prop<T, K extends PropertyKey> = T extends unknown ? (K extends keyof T ? Exclude<T[K], undefined> : never) : never;',\n    \"type Need<T, K extends PropertyKey> = T extends unknown ? (K extends keyof T ? ({} extends Pick<T, K> ? 'optional' : 'required') : never) : never;\",\n    \"type Same<A, B> = [A] extends [B] ? ([B] extends [A] ? 'same' : 'documented is wider') : ([B] extends [A] ? 'documented is narrower' : 'different');\",\n  ];\n  const probes: string[] = [];\n  for (const [group, { keys }] of Object.entries(GROUPS)) probes.push(`keys_${group}`) && lines.push(`export declare const keys_${group}: ${keys};`);\n  for (const [name, keys] of Object.entries(EXTRA)) probes.push(`keys_${name}`) && lines.push(`export declare const keys_${name}: ${keys};`);\n  for (const [group, rows] of Object.entries(docs)) {\n    const target = GROUPS[group]?.type;\n    if (!target) continue;\n    rows.forEach((row, i) => {\n      lines.push(`export declare const type_${group}_${i}: Same<Prop<${target}, ${keyType(row.key)}>, ${documentedType(row.type)}>;`);\n      lines.push(`export declare const need_${group}_${i}: Need<${target}, ${keyType(row.key)}>;`);\n      probes.push(`type_${group}_${i}`, `need_${group}_${i}`);\n    });\n  }\n  fs.writeFileSync(probe, lines.join('\\n') + '\\n');\n  api = new API({ cwd: dir });\n  const snapshot = api.updateSnapshot({ openProjects: [path.join(dir, 'tsconfig.json')] });\n  const project = snapshot.getProjects()[0]!;\n  const errors = project.program.getSemanticDiagnostics(probe).concat(project.program.getSyntacticDiagnostics(probe));\n100:  const [wanted] = expected.rows.find(([, ...values]) => values.some(value => value !== null));\n104:export async function plotCheck(figure, expected) {\n120:    const groups = ticks.map(() => 0);\n124:      if (nearest >= 0) groups[nearest]++;\n129:        ticks.every(({ label }, i) => label === quarters[i] && groups[i] === expected.series.length),\n130:      detail: `Plotted quarters: ${ticks.map(({ label }, i) => `${label} (${groups[i]} bars)`).join(', ') || 'none'}.` },\n147:  const present = expected.rows.flatMap(([day, value], index) => value === null ? [] : [{ day, index }]);\n151:  const gaps = expected.rows.flatMap(([day, value]) => value === null ? [day] : []);\n78:async function checkSameRevision(css, bundle, { unchecked = false, log = () => {} } = {}) {\n130:  const { messages, problems: unchecked } = await checkSameRevision(css, bundle, { unchecked: uncheckedLibrary, log });\napps/docs/pages/getting-started.md:75:**2. Check which kind of x Axylo read.** A date off by one day almost always means instants where calendar dates were meant (item 1 above). If the tooltip heading names a time zone, Axylo read instants. If the x labels are your strings in input order, it read categories.\napps/docs/pages/getting-started.md:77:**3. Check the values without drawing.** `validate()` runs the same checks as creating the chart, in Node or in a test, with the same options as the chart:\napps/docs/pages/options.md:141:| `tickFormat` | `Intl.NumberFormatOptions \\| ((value: number) => string)` | the locale's grouping, with the step's fraction digits; compact from a largest tick of one million, scientific from 10¹⁵ | How axis ticks are written. |\napps/docs/pages/options.md:153:| `type` | `'number' \\| 'time' \\| 'date' \\| 'category'` | inferred | `'date'`: calendar dates; `'time'`: instants; numbers are never inferred to be instants. See [how Axylo decides](data.md#how-axylo-decides). |\napps/docs/pages/stability.md:37:| Built-in text | English. Reader-facing messages are replaceable through `messages`; diagnostics keep their English wording. |\napps/docs/pages/stability.md:65:MIT, for everything: zoom, accessibility and every chart type included. There is no commercial edition and no feature behind a licence key. The library has no runtime dependencies; third-party notices, if any, are checked at each release.\napps/docs/pages/stability.md:76:| Annotations beyond reference lines and bands | Placing free text interacts with label fitting. |\napps/docs/pages/stability.md:85:| Translations of built-in text | `messages` makes reader-facing ones possible; only English ships. |\napps/docs/pages/stability.md:86:| Workers, WebGL or WebGPU | Decided from measurements. |\napps/docs/pages/stability.md:88:Not the audience for 1.0: analysts exploring data in notebooks, designers building bespoke graphics, and teams that need maps, financial charts or network diagrams.\napps/docs/pages/data.md:51:Dates are where charts most often go wrong without anyone noticing. Axylo keeps three kinds apart and never mixes them silently.\napps/docs/pages/data.md:63:The example below has the same five values sent both ways. Your browser's time zone decides how the first chart reads: west of UTC, its first point is on the 23rd.\napps/docs/pages/data.md:73:### How Axylo decides\napps/docs/pages/data.md:120:Some database drivers return counts and decimals as strings (Postgres `bigint` and `numeric`, BigQuery). Axylo looks at the whole field:\napps/docs/pages/data.md:122:- When every value is a plain decimal string (`'40'`, `'-1.5'`, and exponent notation such as `'1e3'`), the field is converted and drawn, and hint [AX104](diagnostics.md#ax104) asks you to say so with `parse: 'number'`. With that, there is no hint, and TypeScript accepts the string field on a value axis.\napps/docs/pages/data.md:123:- When the field also holds a number, or any string that is not a plain decimal (`'1,234'`, `'n/a'`), or another kind of value (`true`), every string in it is rejected, plain decimals included. They are not drawn, and they are warning [AX106](diagnostics.md#ax106).\napps/docs/pages/data.md:144:| `tickFormat` | How axis ticks are written. Default: the locale's grouping with the fraction digits the tick step needs (`50,000`); compact (`1.2M`) when the largest tick is at least a million; scientific from 10¹⁵. |\napps/docs/pages/data.md:162:## Checking data before you draw\nv24.21.0\n","exit_code":0,"status":"completed"}}
