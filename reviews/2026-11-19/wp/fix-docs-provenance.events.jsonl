fs) if (kinds.has(kind)) files.add(file);\n    66\t      }\n    67\t    }\n    68\t  }\n    69\t  return [...files].sort();\n    70\t}\n    71\t\n    72\texport function snapshot(root, files) {\n    73\t  const git = (...args) => execFileSync('git', args, { cwd: root, encoding: 'utf8', stdio: ['ignore', 'pipe', 'inherit'], maxBuffer: 64 * 1024 * 1024 });\n    74\t  const commit = git('rev-parse', 'HEAD').trim();\n    75\t  const status = git('status', '--porcelain=v1', '-z', '--untracked-files=all', '--', '.', ':(exclude)acceptance/report.md');\n    76\t  const tree = createHash('sha256').update(status);\n    77\t  // A dirty flag alone cannot distinguish two edits to the same library file.\n    78\t  const changed = new Set(git('ls-files', '-m', '-o', '--exclude-standard', '-z').split('\\0'));\n    79\t  for (const file of [...changed].sort()) {\n    80\t    if (!file || file === 'acceptance/report.md') continue;\n    81\t    const path = resolve(root, file);\n    82\t    const stat = lstatSync(path, { throwIfNoEntry: false });\n    83\t    const content = stat?.isSymbolicLink() ? readlinkSync(path) : stat?.isFile() ? readFileSync(path) : '';\n    84\t    tree.update(JSON.stringify([file, stat?.mode, sha(content)]));\n    85\t  }\n    86\t  // Include edits staged against HEAD even when the index matches the working file.\n    87\t  tree.update(git('diff', '--cached', '--binary', 'HEAD', '--', '.', ':(exclude)acceptance/report.md'));\n    88\t  // A cited file that is gone is the matrix's structural error, which the checker reports; the run still records.\n    89\t  const hashes = Object.fromEntries(files.map(file => [file, lstatSync(resolve(root, file), { throwIfNoEntry: false })?.isFile() ? hashFile(resolve(root, file)) : null]));\n    90\t  return { commit, dirty: status.length > 0, tree: tree.digest('hex'), hashes };\n    91\t}\n    92\t\n    93\t/**\n    94\t * The integrity of the tarball the current tree packs, per package of scripts/pack.mjs: `npm pack` wit