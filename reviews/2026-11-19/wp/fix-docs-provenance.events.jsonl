{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"rg -n 'buildSite\\\\(' --glob '\"'!package-lock.json'\"' && sed -n '535,590p;680,740p' apps/docs/lib/site.mjs && sed -n '1,75p' acceptance/test/check.test.mjs && rg -n 'specIds\\\\(' acceptance/check.mjs\"","aggregated_output":"reviews/2026-11-19/wp/fix-docs-provenance.events.jsonl:12:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_4\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'cat apps/docs/build.mjs apps/docs/lib/consumer.mjs apps/docs/vitest.config.ts apps/docs/test/conformance.test.ts'\",\"aggregated_output\":\"// Builds the documentation site into apps/docs/dist. Needs the library built first (`npm run build`).\\n// Usage: node apps/docs/build.mjs [--unchecked-library]\\n//\\n// --unchecked-library builds even when packages/axylo/dist is not the build of its current source, into\\n// apps/docs/.cache/unchecked-site, with every page saying so. It is for checking pages while a rebuild of the\\n// library is pending; it never replaces apps/docs/dist.\\nimport { buildSite } from './lib/site.mjs';\\n\\nconst args = process.argv.slice(2);\\nconst unknown = args.filter(a => a !== '--unchecked-library');\\nif (unknown.length) throw new Error(`unknown argument ${unknown[0]} (usage: node apps/docs/build.mjs [--unchecked-library])`);\\nconst started = Date.now();\\nconst result = await buildSite({ log: message => console.warn(message), uncheckedLibrary: args.includes('--unchecked-library') });\\nconst words = result.pages.reduce((sum, p) => sum + p.words, 0);\\nconsole.log(`built ${result.pages.length} pages (${words} words), ${result.diagnostics} diagnostic pages and ${result.examples.length} examples in ${Date.now() - started} ms, into ${result.outDir}`);\\nfor (const p of result.pages) console.log(`  ${p.page.padEnd(18)} ${String(p.words).padStart(5)} words`);\\nif (result.unchecked.length) console.log(`NOT FOR PUBLISHING: built against a packed library that is not the build of its source (${result.unchecked.length} differences).`);\\n/**\\n * A clean consumer of the packed packages, for the documentation's examples (spec DX10), set up the way\\n * tests/dist does it (tests/dist/README.md, scripts/pack.mjs): `npm pack` each package as npm would publish\\n * it, then `npm install --offline` the tarballs through `file:` specifiers into a project of its own, so\\n * nothing is linked to the workspace. The consumer lives under apps/docs/.cache (git-ignored):\\n *\\n *   .cache/packed/<name>-<version>.tgz     the tarballs\\n *   .cache/consumer/package.json           axylo\\n *   .cache/consumer/node_modules           npm's install of those, offline\\n *   .cache/consumer/src/…                  copies of the examples, so they resolve from the consumer\\n *\\n * The consumer sits under the repository, whose root node_modules links the workspace packages; anything it\\n * did not install could be found there by walking up. `guard()` (esbuild) and `listFilesOutside()`\\n * (TypeScript) turn such a fallback into an error.\\n */\\nimport { execFileSync } from 'node:child_process';\\nimport fs from 'node:fs';\\nimport path from 'node:path';\\nimport { cacheDir, repoRoot } from './examples.mjs';\\n\\nexport const PACKAGES = { axylo: 'packages/axylo' };\\nexport const packedDir = path.join(cacheDir, 'packed');\\nexport const consumerDir = path.join(cacheDir, 'consumer');\\nconst windows = process.platform === 'win32';\\n\\n// npm started through npm run or Vitest passes its own settings down as npm_config_* variables; the consumer\\n// installs with defaults, as tests/dist does.\\nconst env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !/^npm_/i.test(k)));\\nconst npm = (args, options) =>\\n  execFileSync(windows ? 'npm.cmd' : 'npm', args, { encoding: 'utf8', shell: windows, env, stdio: 'pipe', ...options });\\n\\nexport const inside = (parent, child) => {\\n  const relative = path.relative(parent, child);\\n  return relative !== '' && !relative.startsWith('..') && !path.isAbsolute(relative);\\n};\\n\\nfunction walk(dir, base = dir) {\\n  return fs.readdirSync(dir, { withFileTypes: true }).flatMap(e =>\\n    e.isDirectory() ? walk(path.join(dir, e.name), base) : [path.relative(base, path.join(dir, e.name)).split(path.sep).join('/')]);\\n}\\n\\n/**\\n * Packs both packages from their current dist and installs them into the consumer. The install is skipped\\n * when the consumer already holds exactly these tarballs (same integrity). Returns what npm pack reported.\\n */\\nexport function prepareConsumer({ log = () => {} } = {}) {\\n  fs.rmSync(packedDir, { recursive: true, force: true });\\n  fs.mkdirSync(packedDir, { recursive: true });\\n  const packed = {};\\n  for (const [name, dir] of Object.entries(PACKAGES)) {\\n    const [report] = JSON.parse(npm(['pack', '--json', '--ignore-scripts', '--pack-destination', packedDir], { cwd: path.join(repoRoot, dir) }));\\n    packed[name] = { tarball: report.filename, integrity: report.integrity, version: report.version, files: report.files.map(f => f.path).sort() };\\n  }\\n  fs.mkdirSync(consumerDir, { recursive: true });\\n  const manifest = {\\n    name: 'axylo-docs-consumer',\\n    private: true,\\n    type: 'module',\\n    description: 'Installs the packed tarballs for the documentation examples (apps/docs/lib/consumer.mjs). Generated.',\\n    dependencies: { axylo: `file:../packed/${packed.axylo.tarball}` },\\n  };\\n  fs.writeFileSync(path.join(consumerDir, 'package.json'), JSON.stringify(manifest, null, 2) + '\\\\n');\\n  const record = path.join(consumerDir, '.installed.json');\\n  const wanted = JSON.stringify(Object.fromEntries(Object.entries(packed).map(([n, p]) => [n, p.integrity])));\\n  const current = fs.existsSync(record) ? fs.readFileSync(record, 'utf8') : '';\\n  if (current !== wanted || !fs.existsSync(path.join(consumerDir, 'node_modules/axylo'))) {\\n    fs.rmSync(path.join(consumerDir, 'node_modules'), { recursive: true, force: true });\\n    const install = mode => npm(['install', mode, '--ignore-scripts', '--no-audit', '--no-fund', '--no-package-lock', '--loglevel=error'], { cwd: consumerDir });\\n    // Only the local tarball is installed, so nothing comes from a registry or the npm cache.\\n    install('--offline');\\n    fs.writeFileSync(record, wanted);\\n    log(`docs consumer: installed ${Object.values(packed).map(p => p.tarball).join(', ')}`);\\n  }\\n  for (const [name, p] of Object.entries(packed)) {\\n    const at = path.join(consumerDir, 'node_modules', name);\\n    if (fs.lstatSync(at).isSymbolicLink()) throw new Error(`docs consumer: npm linked ${name} instead of installing the tarball`);\\n    if (walk(at).sort().join('\\\\n') !== p.files.join('\\\\n')) throw new Error(`docs consumer: installed ${name} differs from npm pack's file list`);\\n  }\\n  return packed;\\n}\\n\\n/** The installed package's directory in the consumer. */\\nexport const installed = name => path.join(consumerDir, 'node_modules', name);\\n\\n/** An esbuild plugin that fails the build when an import resolves outside the consumer. */\\nexport function guard(roots = [consumerDir]) {\\n  return {\\n    name: 'docs-consumer-guard',\\n    setup(build) {\\n      build.onResolve({ filter: /.*/ }, async args => {\\n        if (args.pluginData?.guarded || args.kind === 'entry-point') return undefined;\\n        const result = await build.resolve(args.path, {\\n          kind: args.kind, importer: args.importer, resolveDir: args.resolveDir, namespace: args.namespace, pluginData: { guarded: true },\\n        });\\n        if (result.errors.length > 0 || result.external || result.namespace !== 'file') return result;\\n        if (!roots.some(r => inside(r, result.path))) {\\n          return { errors: [{ text: `[docs consumer guard] ${JSON.stringify(args.path)} from ${args.importer} resolved outside the consumer, to ${result.path}` }] };\\n        }\\n        return result;\\n      });\\n    },\\n  };\\n}\\n\\n/**\\n * Files TypeScript read (`--listFiles` output) that are neither in the consumer nor the compiler's own\\n * libraries: a declaration found by walking up into the workspace.\\n */\\nexport function listFilesOutside(listing, allowed = []) {\\n  const typescript = path.dirname(fs.realpathSync(path.join(repoRoot, 'node_modules/typescript/package.json')));\\n  return listing.split(/\\\\r?\\\\n/).map(l => l.trim()).filter(Boolean).filter(file => {\\n    const at = path.resolve(file);\\n    if (inside(consumerDir, at) || inside(typescript, at) || /[\\\\\\\\/]@typescript[\\\\\\\\/]/.test(at) || /[\\\\\\\\/]lib\\\\.[\\\\w.]*\\\\.d\\\\.ts$/.test(at)) return false;\\n    return !allowed.some(dir => inside(path.join(repoRoot, 'node_modules', dir), at));\\n  });\\n}\\n\\nconst STRICT = {\\n  target: 'ES2022', module: 'ESNext', moduleResolution: 'Bundler', strict: true, noUncheckedIndexedAccess: true,\\n  noImplicitOverride: true, noFallthroughCasesInSwitch: true, isolatedModules: true, noEmit: true, skipLibCheck: false,\\n  types: [],\\n};\\n\\n/**\\n * The consumer's TypeScript configurations: one for the browser examples (the .ts files, and the\\n * scripts of the .html examples as JavaScript under checkJs, all strict), one for the Node examples. Library\\n * checking is on, so the packed declarations are checked as a consumer's compiler reads them.\\n */\\nexport function writeConsumerTsconfigs() {\\n  const browser = {\\n    compilerOptions: { ...STRICT, lib: ['ES2022', 'DOM', 'DOM.Iterable'], allowJs: true, checkJs: true },\\n    include: ['src/*.ts', 'src/*.js'],\\n  };\\n  const node = { compilerOptions: { ...STRICT, lib: ['ES2022', 'DOM'] }, include: ['src/node/*.ts'] };\\n  fs.writeFileSync(path.join(consumerDir, 'tsconfig.json'), JSON.stringify(browser, null, 2));\\n  fs.writeFileSync(path.join(consumerDir, 'tsconfig.node.json'), JSON.stringify(node, null, 2));\\n  return { browser: path.join(consumerDir, 'tsconfig.json'), node: path.join(consumerDir, 'tsconfig.node.json') };\\n}\\nimport { fileURLToPath } from 'node:url';\\nimport { defineConfig } from 'vitest/config';\\n\\n// The documentation's tests alone, with the same split as the root vitest.config.ts (which includes them\\n// too): unit tests in Node, and browser tests (*.browser.test.ts) against the packed library and the built\\n// site when AXYLO_BROWSER is set.\\nexport default defineConfig({\\n  define: { __DEV__: 'true' },\\n  test: {\\n    root: fileURLToPath(new URL('../..', import.meta.url)),\\n    // The Node examples run against the packed package, from node.browser.test.ts, after the build.\\n    include: process.env.AXYLO_BROWSER ? ['apps/docs/test/**/*.browser.test.ts'] : ['apps/docs/test/**/*.test.ts'],\\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 30000,\\n    hookTimeout: 120000,\\n    fileParallelism: false,\\n  },\\n});\\n/**\\n * The conformance page's data (lib/conformance.mjs): it may say only what the specification and the\\n * acceptance checker record.\\n *\\n * - The criteria come from the specification: every \\\"WCAG x.y.z\\\" in the last column of a criterion row (spec\\n *   A9), and only those; every criterion no row cites has a reason in data/wcag.mjs.\\n * - The checker's structured rows are read as its README documents them, and output outside that shape stops\\n *   the build.\\n * - Against the checker's own fixtures (acceptance/test/fixtures, whose expected cells its own tests state):\\n *   a result without recorded provenance, and a size record of another pack, are \\\"not recorded for this\\n *   revision\\\" (the checker's status, with 'not recorded' as the report's result), and a refused matrix\\n *   leaves every criterion \\\"not recorded\\\".\\n */\\nimport { describe, expect, it } from 'vitest';\\nimport fs from 'node:fs';\\nimport path from 'node:path';\\nimport { citedCriteria, evidenceFor, readChecker, readRows, uncited } from '../lib/conformance.mjs';\\nimport { wcag } from '../data/wcag.mjs';\\nimport { cacheDir, repoRoot } from '../lib/examples.mjs';\\nimport { check } from '../../../acceptance/check.mjs';\\n\\nconst fixtures = path.join(repoRoot, 'acceptance/test/fixtures');\\nconst spec = fs.readFileSync(path.join(repoRoot, 'docs/02-product-spec.md'), 'utf8');\\n\\ndescribe('the criteria the specification cites', () => {\\n  it('reads citations from the last column of a criterion row, and nothing else', () => {\\n    const text = [\\n      '| ID | Criterion | Verified by | Driven by |',\\n      '|---|---|---|---|',\\n      '| I3 | Zoom four ways. | Clicks only | D7, R12, WCAG 2.5.1, 2.5.7, 1.4.4 |',\\n      '| L1 | Labels never overlap. | Repeated with the WCAG 1.4.12 text-spacing overrides | R2 |',\\n      '| A9 | Lists every applicable WCAG 2.2 AA success criterion. | CI | R11 |',\\n      '| Picking by pointer | WCAG 1.4.13 | x | x |',\\n      'Prose that names WCAG 2.4.7 outside a table.',\\n    ].join('\\\\n');\\n    const cited = citedCriteria(text);\\n    expect([...cited.keys()]).toEqual(['1.4.4', '2.5.1', '2.5.7']);\\n    expect(cited.get('2.5.7')).toEqual([{ id: 'I3', criterion: 'Zoom four ways.' }]);\\n  });\\n\\n  it('a criterion that is not level A or AA of WCAG 2.2 stops the build', () => {\\n    expect(() => citedCriteria('| X1 | Something. | x | WCAG 1.4.6 |')).toThrow(/1\\\\.4\\\\.6/);\\n  });\\n\\n  it('on the specification: every number a \\\"WCAG\\\" in a criterion row\\\\'s last column names is listed', () => {\\n    const cited = citedCriteria(spec);\\n    const named = new Set<string>();\\n    for (const line of spec.split('\\\\n')) {\\n      if (!/^\\\\| [A-Z]+\\\\d+ \\\\|/.test(line)) continue;\\n      const last = line.replace(/\\\\|\\\\s*$/, '').split('|').at(-1)!;\\n      for (const m of last.matchAll(/WCAG ((?:\\\\d\\\\.\\\\d+\\\\.\\\\d+(?:, )?)+)/g)) for (const n of m[1]!.split(', ')) named.add(n);\\n    }\\n    expect(named.size).toBeGreaterThan(0);\\n    expect([...cited.keys()].sort()).toEqual([...named].sort());\\n  });\\n\\n  it('every criterion no row cites has a reason: one of the two A9 names, or \\\"not assessed\\\"', () => {\\n    const kinds = ['not applicable to a chart component', 'the page\\\\'s responsibility', 'not assessed'];\\n    const missing = uncited(citedCriteria(spec)).filter(sc => !kinds.includes(wcag[sc]![2]!) || !wcag[sc]![3]);\\n    expect(missing).toEqual([]);\\n  });\\n});\\n\\ndescribe('reading the checker', () => {\\n  const fixtureRun = () => check({ root: fixtures, matrixFile: path.join(fixtures, 'matrix.json'), resultFiles: [path.join(fixtures, 'results.json')] });\\n\\n  it('reads the checker\\\\'s rows on its fixtures as its own tests state them', () => {\\n    const rows = readRows(fixtureRun().rows);\\n    const f1 = rows.get('F1')!.cells;\\n    expect(Object.keys(f1)).toEqual(['line', 'area', 'bar', 'scatter', 'donut', 'compact']);\\n    expect(f1.line).toEqual({ status: 'pass', reports: [{ file: 'results.json', source: 'run', results: ['pass'], engine: null, counted: true, why: null, commit: null }] });\\n    expect(f1.area!.status).toBe('weak');\\n    expect(f1.area!.reports.map(r => r.results)).toEqual([['skipped']]);\\n    expect(f1.scatter).toEqual({ status: 'not applicable', reports: [] });\\n    expect(rows.get('F2')!.cells.line!.status).toBe('cannot be verified here');\\n  });\\n\\n  it('names the engine of a report that has none from its default result file', () => {\\n    const rows = readRows(fixtureRun().rows, { engineOf: file => file === 'results.json' ? 'chromium' : null, commitOf: () => 'abc1234' });\\n    expect(rows.get('F1')!.cells.line!.reports[0]).toMatchObject({ engine: 'chromium', commit: 'abc1234' });\\n  });\\n\\n  it('stops on output outside the documented shape', () => {\\n    const good = fixtureRun().rows;\\n    const change = (edit: (row: Record<string, any>) => void) => {\\n      const rows = structuredClone(good) as Record<string, any>[];\\n      edit(rows[0]!);\\n      return () => readRows(rows);\\n    };\\n    expect(change(row => { row.cells.line.status = 'passed'; })).toThrow(/cannot read/);\\n    expect(change(row => { delete row.cells.compact; })).toThrow(/cannot read/);\\n    expect(change(row => { row.cells.line.reports = [{ file: 'x.json', source: 'run', results: ['green'], engine: null, provenanceError: null }]; })).toThrow(/cannot read/);\\n    expect(change(row => { row.cells.line.reports = [{ file: 'x.json', source: 'run', results: ['pass'], engine: 'safari', provenanceError: null }]; })).toThrow(/cannot read/);\\n    expect(() => readRows(undefined)).toThrow(/cannot read/);\\n    // 'not recorded' is a result only with the provenance error that explains it.\\n    expect(change(row => { row.cells.line.reports = [{ file: 'x.json', source: 'run', results: ['not recorded'], engine: null, provenanceError: null }]; })).toThrow(/cannot read/);\\n    expect(change(row => { row.cells.line.reports = [{ file: 'x.json', source: 'run', results: ['not recorded'], engine: null, provenanceError: 'provenance does not match the working tree' }]; })).not.toThrow();\\n    expect(change(row => { row.cells.line.status = 'not recorded for this revision'; })).not.toThrow();\\n  });\\n\\n  it('a result without recorded provenance is not counted for this revision', async () => {\\n    const checker = await readChecker({ root: fixtures, matrixFile: path.join(fixtures, 'matrix.json'), resultFiles: [path.join(fixtures, 'results.json')] });\\n    expect(checker.refused).toBeNull();\\n    const { verdict, engines } = evidenceFor([{ id: 'F1', criterion: '' }], checker);\\n    expect(verdict).toEqual([{ id: 'F1', text: 'not recorded for this revision' }]);\\n    expect(engines.null).toBe('not recorded for this revision (results from unknown)');\\n    expect(engines.chromium).toBe('not recorded');\\n  });\\n\\n  it('the checker\\\\'s own \\\"not recorded for this revision\\\": a run without provenance in a release', async () => {\\n    const checker = await readChecker({ root: fixtures, matrixFile: path.join(fixtures, 'matrix.json'), resultFiles: [path.join(fixtures, 'results.json')] });\\n    const line = checker.rows.get('F1')!.cells.line!;\\n    expect(line.status).toBe('not recorded for this revision');\\n    expect(line.reports).toEqual([{ file: 'results.json', source: 'run', results: ['not recorded'], engine: null, counted: false, why: 'release requires recorded provenance', commit: null }]);\\n    expect(checker.files).toEqual([expect.objectContaining({ file: 'results.json', counted: false, why: 'release requires recorded provenance' })]);\\n  });\\n\\n  it('a size record of another pack is not recorded for this revision, and no engine\\\\'s', async () => {\\n    // As the checker's own test of size records builds it (acceptance/test/check.test.mjs, defect 5).\\n    const dir = fs.mkdtempSync(path.join(cacheDir, 'conformance-'));\\n    try {\\n      fs.mkdirSync(path.join(dir, 'docs'));\\n      fs.copyFileSync(path.join(fixtures, 'docs/02-product-spec.md'), path.join(dir, 'docs/02-product-spec.md'));\\n      const matrix = JSON.parse(fs.readFileSync(path.join(fixtures, 'matrix.json'), 'utf8')).map((row: object) => ({ ...row, evidence: {}, weak: {} }));\\n      matrix[0].evidence = { line: [{ kind: 'size', file: 'size.json', entries: ['line only'] }] };\\n      fs.writeFileSync(path.join(dir, 'matrix.json'), JSON.stringify(matrix));\\n      fs.writeFileSync(path.join(dir, 'size.json'), JSON.stringify({ packed: { axylo: 'sha512-measured' }, rows: [{ entry: 'line only', minBytes: 2000, totalGzipBytes: 1000, targetKiB: 1 }] }));\\n      const options = { root: dir, matrixFile: path.join(dir, 'matrix.json'), resultFiles: [], sizeTargets: { 'line only': 1 } };\\n      const same = await readChecker({ ...options, packIntegrity: 'sha512-measured' });\\n      expect(same.rows.get('F1')!.cells.line!.status).toBe('pass');\\n      const other = await readChecker({ ...options, packIntegrity: 'sha512-current' });\\n      const line = other.rows.get('F1')!.cells.line!;\\n      expect(line.status).toBe('not recorded for this revision');\\n      expect(line.reports).toEqual([{ file: 'size.json', source: 'size', results: ['not recorded'], engine: null, counted: false, why: 'the size record measured another pack (sha512-measured)', commit: null }]);\\n      expect(evidenceFor([{ id: 'F1', criterion: '' }], other)).toEqual({\\n        verdict: [{ id: 'F1', text: 'not recorded for this revision' }],\\n        engines: { chromium: 'not recorded', firefox: 'not recorded', webkit: 'not recorded', null: 'not recorded' },\\n      });\\n    } finally {\\n      fs.rmSync(dir, { recursive: true, force: true });\\n    }\\n  });\\n\\n  it('a refused matrix leaves every criterion not recorded', async () => {\\n    const checker = await readChecker({ root: fixtures, matrixFile: path.join(fixtures, 'stale.json'), resultFiles: [path.join(fixtures, 'results.json')] });\\n    expect(checker.refused!.join('\\\\n')).toMatch(/stale criterion ID: F88/);\\n    expect(evidenceFor([{ id: 'F1', criterion: '' }], checker)).toEqual({\\n      verdict: [{ id: 'F1', text: 'not recorded' }],\\n      engines: { chromium: 'not recorded', firefox: 'not recorded', webkit: 'not recorded', null: 'not recorded' },\\n    });\\n  });\\n});\\n\\ndescribe('what is counted', () => {\\n  // A checker report as readChecker returns it, written out: one row, two engines, one stale run.\\n  const report = (file: string, engine: string, results: string[], counted = true, commit = 'aaaaaaa1') => ({ file, source: 'run', results, engine, counted, commit });\\n  const checker = {\\n    refused: null,\\n    rows: new Map([['I4', { statement: '', cells: {\\n      line: { status: 'pass', reports: [report('browser.json', 'chromium', ['pass']), report('browser-webkit.json', 'webkit', ['fail', 'pass'])] },\\n      donut: { status: 'not applicable', reports: [] },\\n    } }]]),\\n  };\\n\\n  it('each engine says what its own results said, and the verdict lists the chart types', () => {\\n    expect(evidenceFor([{ id: 'I4', criterion: '' }], checker)).toEqual({\\n      verdict: [{ id: 'I4', text: 'pass (line); not applicable (donut)' }],\\n      engines: { chromium: 'pass', firefox: 'not recorded', webkit: 'fail/pass', null: 'not recorded' },\\n    });\\n  });\\n\\n  it('a row with a result from another revision has no verdict for this one', () => {\\n    const stale = { ...checker, rows: new Map([['I4', { statement: '', cells: { line: { status: 'pass', reports: [report('browser-firefox.json', 'firefox', ['pass'], false, 'bbbbbbb2')] } } }]]) };\\n    expect(evidenceFor([{ id: 'I4', criterion: '' }], stale)).toEqual({\\n      verdict: [{ id: 'I4', text: 'not recorded for this revision' }],\\n      engines: { chromium: 'not recorded', firefox: 'not recorded for this revision (results from bbbbbbb)', webkit: 'not recorded', null: 'not recorded' },\\n    });\\n  });\\n\\n  it('a row the checker does not have is not recorded', () => {\\n    expect(evidenceFor([{ id: 'A99', criterion: '' }], checker).verdict).toEqual([{ id: 'A99', text: 'not recorded' }]);\\n  });\\n});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nreviews/2026-11-19/wp/fix-docs-provenance.events.jsonl:18:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_7\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"nl -ba apps/docs/lib/site.mjs | sed -n '1,222p'; rg -n 'fixtureWith|provenance|snapshot|git' acceptance/test/check.test.mjs; cat .gitignore; cat package.json; sed -n '309,325p' docs/03-plan-typescript-release.md; rg -n 'git\\\\\\\\(' apps/docs/lib\\\"\",\"aggregated_output\":\"     1\\t/**\\n     2\\t * Builds the documentation site from the Markdown pages, the runnable examples, the diagnostics data file\\n     3\\t * and the packed packages, installed into a consumer of their own (lib/consumer.mjs).\\n     4\\t *\\n     5\\t * - Every example is bundled from the consumer by esbuild under the `development` condition, as an\\n     6\\t *   application would bundle it, and runs in its own page (examples/<name>.html), framed beside its source.\\n     7\\t * - The stylesheet, the script-tag file and `validate()` come from the installed tarball. Two inputs are read\\n     8\\t *   from the library's source because the bundle does not export them (the built-in messages and the\\n     9\\t *   registry's message templates); the build checks that the installed files were built from that source.\\n    10\\t * - The conformance page is generated from the specification and the acceptance checker's report\\n    11\\t *   (lib/conformance.mjs), and the size table from scripts/size.mjs's last measurement, shown only when it\\n    12\\t *   measured the very tarball installed here.\\n    13\\t * - Every link stays inside the site: a link to a file of the repository publishes that file as a source page\\n    14\\t *   under source/, with one anchor per line, at the revision the site was built from.\\n    15\\t * - The site is built into a temporary directory, checked (links, anchors, unique ids), and only then\\n    16\\t *   replaces the previous output, so a failed build leaves the last good site in place.\\n    17\\t */\\n    18\\timport fs from 'node:fs';\\n    19\\timport path from 'node:path';\\n    20\\timport { execFileSync } from 'node:child_process';\\n    21\\timport { pathToFileURL } from 'node:url';\\n    22\\timport { build } from 'esbuild';\\n    23\\timport { checkHref, codeBlock, escapeHtml, markdownToHtml, renderInline, uniqueId, wordCount } from './markdown.mjs';\\n    24\\timport { docsRoot, hostOf, htmlScripts, listExamples, listHelpers, repoRoot, writeConsumerSources } from './examples.mjs';\\n    25\\timport { consumerDir, guard, installed, prepareConsumer } from './consumer.mjs';\\n    26\\timport { readThemeDefaults } from './theme.mjs';\\n    27\\timport { readConformance } from './conformance.mjs';\\n    28\\timport { nav, pages } from '../data/nav.mjs';\\n    29\\t\\n    30\\tconst pagesDir = path.join(docsRoot, 'pages');\\n    31\\tconst siteDir = path.join(docsRoot, 'site');\\n    32\\tconst HEX = /^#[0-9a-f]{3,8}$/i;\\n    33\\t\\n    34\\t/** Generated tables, and the one file each `[table: …](target)` directive must name. */\\n    35\\tconst TABLES = {\\n    36\\t  'diagnostic codes': 'apps/docs/data/diagnostics.mjs',\\n    37\\t  'theme tokens': 'apps/docs/data/tokens.mjs',\\n    38\\t  'internal tokens': 'apps/docs/data/tokens.mjs',\\n    39\\t  messages: 'packages/axylo/src/messages/index.ts',\\n    40\\t  palette: 'packages/axylo/src/theme/palette.ts',\\n    41\\t  conformance: 'acceptance/check.mjs',\\n    42\\t  sizes: 'bench/size-latest.json',\\n    43\\t};\\n    44\\t/** Where `[source: …]` may quote from. */\\n    45\\tconst SOURCE_ROOTS = ['examples/first-chart/', 'research/harness/src/libs/', 'apps/docs/examples/'];\\n    46\\t\\n    47\\t/** Bundles a TypeScript source of the library and imports it, to read data the built bundle does not export. */\\n    48\\texport async function importSource(relative) {\\n    49\\t  const { DEVELOPMENT } = await import(pathToFileURL(path.join(repoRoot, 'scripts/build.mjs')).href);\\n    50\\t  const result = await build({\\n    51\\t    entryPoints: [path.join(repoRoot, relative)], bundle: true, format: 'esm', write: false, platform: 'neutral',\\n    52\\t    define: DEVELOPMENT, logLevel: 'silent',\\n    53\\t  });\\n    54\\t  return import('data:text/javascript;base64,' + Buffer.from(result.outputFiles[0].contents).toString('base64'));\\n    55\\t}\\n    56\\t\\n    57\\texport { readThemeDefaults };\\n    58\\t\\n    59\\tfunction gitRevision() {\\n    60\\t  try {\\n    61\\t    const sha = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: repoRoot, encoding: 'utf8' }).trim();\\n    62\\t    const dirty = execFileSync('git', ['status', '--porcelain'], { cwd: repoRoot, encoding: 'utf8' }).trim() !== '';\\n    63\\t    return { sha, short: sha.slice(0, 7), dirty };\\n    64\\t  } catch {\\n    65\\t    return { sha: 'unknown', short: 'unknown', dirty: true };\\n    66\\t  }\\n    67\\t}\\n    68\\t\\n    69\\t/**\\n    70\\t * The installed files and the source the build also reads (the built-in messages and the registry's\\n    71\\t * templates, which the bundle does not export) must be one revision. The check takes what it compares from\\n    72\\t * scripts/build.mjs itself, so it follows the library's build by construction: the stylesheet must equal\\n    73\\t * `stylesheets().minified` (dist/axylo.css is that text), and the development bundle, rebuilt from\\n    74\\t * packages/axylo/src in memory with the build's DEVELOPMENT constants and the options it uses for\\n    75\\t * axylo.dev.js, must equal the installed file byte for byte. Anything else means packages/axylo/dist is older\\n    76\\t * or newer than its source.\\n    77\\t */\\n    78\\tasync function checkSameRevision(css, bundle, { unchecked = false, log = () => {} } = {}) {\\n    79\\t  const problems = [];\\n    80\\t  const { stylesheets, DEVELOPMENT } = await import(pathToFileURL(path.join(repoRoot, 'scripts/build.mjs')).href);\\n    81\\t  const { minified } = await stylesheets();\\n    82\\t  if (minified !== css) problems.push('the installed axylo.css differs from the minified packages/axylo/src/theme/css.ts');\\n    83\\t  const rebuilt = await build({\\n    84\\t    entryPoints: [path.join(repoRoot, 'packages/axylo/src/index.ts')], bundle: true, target: 'es2022', legalComments: 'none',\\n    85\\t    logLevel: 'silent', format: 'esm', define: DEVELOPMENT, write: false, outfile: path.join(repoRoot, 'packages/axylo/dist/axylo.dev.js'),\\n    86\\t    absWorkingDir: repoRoot,\\n    87\\t  });\\n    88\\t  if (Buffer.from(rebuilt.outputFiles[0].contents).toString('utf8') !== bundle) {\\n    89\\t    problems.push('the installed axylo.dev.js differs from what packages/axylo/src 