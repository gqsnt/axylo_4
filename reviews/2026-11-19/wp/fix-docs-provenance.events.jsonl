okens, internalTokens, messages, messageUses, theme, warnings, version, revision,\n   138\t      unchecked, conformance, sizes, published: new Set(),\n   139\t    };\n   140\t\n   141\t    const report = [];\n   142\t    for (const [index, entry] of pages.entries()) {\n   143\t      const source = fs.readFileSync(path.join(pagesDir, `${entry.page}.md`), 'utf8');\n   144\t      fs.writeFileSync(path.join(tmp, `${entry.page}.html`), renderPage(entry, source, index, ctx));\n   145\t      report.push({ page: entry.page, words: wordCount(source) });\n   146\t    }\n   147\t    for (const d of diagnostics) fs.writeFileSync(path.join(tmp, 'diagnostics', `${d.code}.html`), renderDiagnosticPage(d, ctx));\n   148\t    // Example sources and helpers are linked from every example block; publish them all.\n   149\t    for (const e of examples) ctx.published.add(e.repoFile);\n   150\t    for (const helper of listHelpers()) ctx.published.add(`apps/docs/examples/${helper}`);\n   151\t    for (const file of ctx.published) writeSourcePage(tmp, file, ctx);\n   152\t\n   153\t    const problems = checkSite(tmp);\n   154\t    if (problems.length) throw new Error('The site has broken links or duplicate ids:\\n' + problems.join('\\n'));\n   155\t    fs.writeFileSync(path.join(tmp, 'build.json'), JSON.stringify({ revision, unchecked, packed: Object.fromEntries(Object.entries(packed).map(([n, p]) => [n, { tarball: p.tarball, integrity: p.integrity }])), examples }, null, 1));\n   156\t\n   157\t    // Replace the previous site only now.\n   158\t    const old = `${outDir}.old-${process.pid}`;\n   159\t    if (fs.existsSync(outDir)) fs.renameSync(outDir, old);\n   160\t    fs.renameSync(tmp, outDir);\n   161\t    fs.rmSync(old, { recursive: true, force: true });\n   162\t    for (const w of warnings) log('warning: ' + w);\n   163\t    return { pages: report, examples, warnings, diagnostics: diagnostics.length, published: ctx.published.size, revision, unchecked, outDir };\n   164\t  } catch (error) {\n   165\t    fs.rmSync(tmp, { recursive: true, force: true });\n   166\t    throw error;\n   167\t  }\n   168\t}\n   169\t\n   170\t// ---------- assets ----------\n   171\t\n   172\tfunction writeAssets(outDir, theme) {\n   173\t  const pick = (scheme, name) => {\n   174\t    const value = theme[scheme][`--axylo-default-${name}`];\n   175\t    if (!value || !HEX.test(value)) throw new Error(`axylo.css: no colour for --axylo-default-${name} (${scheme})`);\n   176\t    return value;\n   177\t  };\n   178\t  // The site's surfaces use the chart's own default tokens, so the pages and the charts match.\n   179\t  const vars = scheme => ['background', 'axis', 'grid', 'muted', 'focus', 'reference']\n   180\t    .map(name => `  --site-${name}: ${pick(scheme, name)};`).join('\\n');\n   181\t  const tokens = `/* Generated from the packed axylo.css by apps/docs/lib/site.mjs. */\n   182\t:root {\n   183\t${vars('light')}\n   184\t}\n   185\t@media (prefers-color-scheme: dark) {\n   186\t  :root {\n   187\t${vars('dark')}\n   188\t  }\n   189\t}\n   190\t`;\n   191\t  fs.writeFileSync(path.join(outDir, 'assets/site.css'), tokens + fs.readFileSync(path.join(siteDir, 'site.css'), 'utf8'));\n   192\t  for (const file of ['page.js', 'frame.js']) fs.copyFileSync(path.join(siteDir, file), path.join(outDir, 'assets', file));\n   193\t}\n   194\t\n   195\t// ---------- examples ----------\n   196\t\n   197\t/**\n   198\t * Bundles every example from the consumer, resolving the installed tarball under the `development`\n   199\t * condition, with shared chunks, and writes one page\n   200\t * per example. Nothing may resolve outside the consumer.\n   201\t */\n   202\tasync function buildExamples(outDir) {\n   203\t  const examples = listExamples();\n   204\t  const { src } = writeConsumerSources(consumerDir);\n   205\t  const entries = [];\n   206\t  for (const e of examples) {\n   207\t    if (e.ext !== 'html') entries.push(path.join(src, `${e.name}.${e.ext}`));\n   208\t    