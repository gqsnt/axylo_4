n on every fixture and state (A8).\\n- A 24-chart page: unique ids, no layout shift when one table opens, total tab stops recorded.\\n- The rehearsal script run and recorded on the five pairs, separating what was heard from what was inferred.\\n- The first conformance table (A9), with every listed test existing.\\n\\nExample: \\\"Exploring a chart with the keyboard\\\". Docs: Accessibility: what is automatic, what the author supplies, the rehearsal record and its limits.\\n\\n### M5. Bar, area, donut, scatter and the compact variant (ceiling: 18 days)\\n\\n\",\"exit_code\":1,\"status\":\"failed\"}}\nreviews/2026-11-19/wp/fix-docs-provenance.events.jsonl:20:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_8\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '230,255p;292,335p;507,525p;545,576p' acceptance/test/check.test.mjs; cat acceptance/test/fixtures/docs/02-product-spec.md; cat acceptance/test/fixtures/matrix.json; sed -n '136,151p' docs/02-product-spec.md; rg -n 'vi\\\\\\\\.mock|buildSite\\\\\\\\(|readConformance|cacheDir|\\\\\\\\.tmp-' apps/docs/test apps/docs/lib\\\"\",\"aggregated_output\":\"});\\n\\ntest('a skipped twin blocks passing across reports and a hidden registration under a prefix can fail it', t => {\\n  const write = workspace(t);\\n  const report = read(passed);\\n  const assertions = report.testResults[0].assertionResults;\\n  assertions.push({ ...assertions[0], status: 'skipped' });\\n  assertions.push({ title: 'registered through a helper', status: 'failed', ancestorTitles: ['render examples'] });\\n  const result = run({ resultFiles: [passed, write('negative.json', report)] });\\n  assert.match(result.table, /^\\\\| F1 \\\\| [^|]+\\\\| not run \\\\(.*pass\\\\/skipped/m);\\n  assert.match(result.table, /^\\\\| T-pointer-line \\\\| [^|]+\\\\| fail /m);\\n});\\n\\nfunction fixtureWith(t, specTransform = spec => spec, sourceTransform = source => source) {\\n  const write = workspace(t);\\n  const specFile = 'docs/02-product-spec.md';\\n  const spec = specTransform(readFileSync(resolve(root, specFile), 'utf8'));\\n  const fixtureRoot = resolve(write(specFile, Buffer.from(spec)), '../..');\\n  write('chart.test.ts', Buffer.from(sourceTransform(readFileSync(resolve(root, 'chart.test.ts'), 'utf8'))));\\n  write('cases.ts', readFileSync(resolve(root, 'cases.ts')));\\n  return { write, root: fixtureRoot };\\n}\\n\\ntest('fatal source modifiers cannot be cited even if Vitest would report a pass', t => {\\n  const matrix = read(matrixFile);\\n  const name = matrix[0].evidence.line[0].title;\\n});\\n\\ntest('report content is independent of report argument order', () => {\\n  assert.equal(run({ resultFiles: [passed, failed] }).report, run({ resultFiles: [failed, passed] }).report);\\n});\\n\\ntest('release verifies the commit, dirty source, cited test hashes, and result bytes', t => {\\n  const { write, root } = fixtureWith(t);\\n  const git = (...args) => execFileSync('git', args, { cwd: root, stdio: ['ignore', 'pipe', 'inherit'] });\\n  git('init', '-q');\\n  git('add', '.');\\n  git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.test', 'commit', '-qm', 'Fixture');\\n  const matrix = read(matrixFile);\\n  const outputs = mkdtempSync(resolve(tmpdir(), 'axylo-results-'));\\n  t.after(() => rmSync(outputs, { recursive: true }));\\n  const report = resolve(outputs, 'run.json');\\n  const sidecar = resolve(outputs, 'run.provenance.json');\\n  writeFileSync(report, readFileSync(passed));\\n  const options = { root, matrixFile: write('matrix.json', matrix), resultFiles: [report], release: true };\\n  assert.match(check(options).report, /Provenance: missing · release requires recorded provenance/);\\n  const prior = snapshot(root, citedTestFiles(matrix));\\n  const recorded = { ...prior, resultSha256: hashFile(report) };\\n  const record = data => writeFileSync(sidecar, JSON.stringify(data));\\n  record(recorded);\\n  assert.deepEqual(check(options).runs.map(run => run.provenanceError), [undefined]);\\n  for (const bad of [{ commit: 'old' }, { dirty: !prior.dirty }, { hashes: {} }]) {\\n    record({ ...recorded, ...bad });\\n    assert.match(check(options).report, /provenance does not match the working tree/);\\n  }\\n  record({ ...recorded, changedDuringRun: true });\\n  assert.match(check(options).report, /release requires an unchanged working tree during the run/);\\n  record(recorded);\\n  writeFileSync(report, readFileSync(failed));\\n  assert.match(check(options).report, /provenance does not match the working tree/);\\n  writeFileSync(report, readFileSync(passed));\\n  // This second workspace change leaves the existing dirty status unchanged.\\n  write('matrix.json', [...matrix].reverse());\\n  assert.match(check(options).report, /provenance does not match the working tree/);\\n});\\n\\n// ── engines (AXYLO_ENGINE) ──────────────────────────────────────────────────────────────────────────\\n\\n/** F1's line cell cites `line renders` as browser evidence, optionally for named engines. */\\nfunction browserMatrix(...engines) {\\n/** A fixture tree under Git, so provenance can be recorded and compared. */\\nfunction gitFixture(t, sourceTransform) {\\n  const fixture = fixtureWith(t, undefined, sourceTransform);\\n  const git = (...args) => execFileSync('git', args, { cwd: fixture.root, stdio: ['ignore', 'pipe', 'inherit'] });\\n  git('init', '-q');\\n  git('add', '.');\\n  git('-c', 'user.name=Fixture', '-c', 'user.email=fixture@example.test', 'commit', '-qm', 'Fixture');\\n  return fixture;\\n}\\n\\ntest('defect 5: a size record counts only for the pack this tree makes, against the targets of scripts/size.mjs', t => {\\n  const write = workspace(t);\\n  const matrix = read(matrixFile).map(row => ({ ...row, evidence: {}, weak: {} }));\\n  matrix[0].evidence = { line: [{ kind: 'size', file: 'size.json', entries: ['line only'] }] };\\n  const spec = write('docs/02-product-spec.md', readFileSync(resolve(root, 'docs/02-product-spec.md')));\\n  const options = { root: resolve(spec, '../..'), matrixFile: write('matrix.json', matrix), sizeTargets: { 'line only': 1 } };\\n  // The record's own targetKiB (1000) is not read: 1025 bytes is over the 1 KiB target.\\n  const record = totalGzipBytes => ({ packed: { axylo: 'sha512-measured', commit: 'abc1234' }, rows: [{ entry: 'line only', minBytes: 2000, totalGzipBytes, targetKiB: 1000 }] });\\n  write('size.json', record(1025));\\n});\\n\\ntest('defect 8: a run whose provenance is another tree answers nothing, in every mode, and is still listed with its error', t => {\\n  const { write, root: fixtureRoot } = gitFixture(t);\\n  const outputs = mkdtempSync(resolve(tmpdir(), 'axylo-stale-'));\\n  t.after(() => rmSync(outputs, { recursive: true }));\\n  const report = resolve(outputs, 'run.json');\\n  writeFileSync(report, readFileSync(failed));\\n  const matrix = read(matrixFile);\\n  const options = { root: fixtureRoot, matrixFile: write('matrix.json', matrix), resultFiles: [report] };\\n  const recorded = { ...snapshot(fixtureRoot, citedTestFiles(matrix)), resultSha256: hashFile(report) };\\n  writeFileSync(resolve(outputs, 'run.provenance.json'), JSON.stringify(recorded));\\n  // Matching provenance: the failure counts.\\n  assert.match(check(options).table, /^\\\\| F1 \\\\| [^|]+\\\\| fail \\\\(run\\\\.json fail\\\\) \\\\|/m);\\n  // Another tree: neither its failure nor its pass sets a status.\\n  writeFileSync(resolve(outputs, 'run.provenance.json'), JSON.stringify({ ...recorded, commit: 'old' }));\\n  for (const release of [false, true]) {\\n    const result = check({ ...options, release });\\n    assert.match(result.table, /^\\\\| F1 \\\\| [^|]+\\\\| not recorded for this revision \\\\(run\\\\.json not recorded\\\\) \\\\| weak \\\\(run\\\\.json not recorded\\\\) \\\\|/m);\\n    assert.equal(result.counts.fail, 0);\\n    assert.equal(result.counts.pass, 0);\\n    assert.match(result.report, /run\\\\.json` · 1 passed assertions, 1 reported failures\\\\n {2}- Provenance: commit old, .* · provenance does not match the working tree/);\\n    assert.match(result.report, /### Not recorded for this revision\\\\n\\\\n- \\\\*\\\\*F1\\\\*\\\\* · line · run\\\\.json: not recorded for this revision \\\\(provenance does not match the working tree\\\\)\\\\./);\\n    assert.equal(result.rows[0].cells.line.reports[0].provenanceError, 'provenance does not match the working tree');\\n    assert.deepEqual(result.rows[0].cells.line.reports[0].results, ['not recorded']);\\n  }\\n  // Without a record only a release refuses the run.\\n  rmSync(resolve(outputs, 'run.provenance.json'));\\n  assert.match(check(options).table, /^\\\\| F1 \\\\| [^|]+\\\\| fail \\\\(run\\\\.json fail\\\\) \\\\|/m);\\n  assert.match(check({ ...options, release: true }).table, /^\\\\| F1 \\\\| [^|]+\\\\| not recorded for this revision /m);\\n});\\n\\n## 3. Acceptance criteria\\n\\n### 3.1 Faithful representation\\n\\n| ID | Criterion |\\n|---|---|\\n| F1 | Show the fixture faithfully. |\\n| F2 | Keep breaks visible. |\\n\\n### 3.6 Type matrix\\n\\n| | Line | Bar |\\n|---|---|---|\\n| Picking by pointer | Nearest x, including `x | 0` | Under the pointer |\\n\\n## 6. Other sections\\n\\n| ID | Non-criterion |\\n|---|---|\\n| F999 | Out of scope. |\\n[\\n  {\\n    \\\"id\\\": \\\"F1\\\",\\n    \\\"statement\\\": \\\"Show the fixture faithfully.\\\",\\n    \\\"appliesTo\\\": [\\\"line\\\", \\\"area\\\", \\\"bar\\\"],\\n    \\\"notApplicable\\\": {\\n      \\\"scatter\\\": \\\"No scatter fixture.\\\",\\n      \\\"donut\\\": \\\"No donut fixture.\\\",\\n      \\\"compact\\\": \\\"Only full figures are scoped.\\\"\\n    },\\n    \\\"evidence\\\": {\\n      \\\"line\\\": [{\\\"file\\\": \\\"chart.test.ts\\\", \\\"kind\\\": \\\"unit\\\", \\\"title\\\": \\\"line renders\\\"}],\\n      \\\"bar\\\": [{\\\"file\\\": \\\"chart.test.ts\\\", \\\"kind\\\": \\\"unit\\\", \\\"title\\\": \\\"bar has a baseline\\\"}]\\n    },\\n    \\\"weak\\\": {\\n      \\\"area\\\": [{\\n        \\\"file\\\": \\\"chart.test.ts\\\", \\\"kind\\\": \\\"unit\\\", \\\"title\\\": \\\"area renders\\\",\\n        \\\"reason\\\": \\\"The smoke test does not check the geometry.\\\"\\n      }]\\n    }\\n  },\\n  {\\n    \\\"id\\\": \\\"F2\\\",\\n    \\\"statement\\\": \\\"Keep breaks visible.\\\",\\n    \\\"appliesTo\\\": [\\\"line\\\"],\\n    \\\"notApplicable\\\": {\\n      \\\"area\\\": \\\"Out of scope.\\\",\\n      \\\"bar\\\": \\\"Out of scope.\\\",\\n      \\\"scatter\\\": \\\"Out of scope.\\\",\\n      \\\"donut\\\": \\\"Out of scope.\\\",\\n      \\\"compact\\\": \\\"Out of scope.\\\"\\n    },\\n    \\\"cannotVerify\\\": {\\\"line\\\": \\\"A real phone is required.\\\"}\\n  },\\n  {\\n    \\\"id\\\": \\\"T-pointer-line\\\",\\n    \\\"statement\\\": \\\"Nearest x.\\\",\\n    \\\"appliesTo\\\": [\\\"line\\\"],\\n    \\\"notApplicable\\\": {\\n      \\\"area\\\": \\\"Line cell.\\\",\\n      \\\"bar\\\": \\\"Line cell.\\\",\\n      \\\"scatter\\\": \\\"Line cell.\\\",\\n      \\\"donut\\\": \\\"Line cell.\\\",\\n      \\\"compact\\\": \\\"Line cell.\\\"\\n    },\\n    \\\"evidence\\\": {\\n      \\\"line\\\": [{\\\"file\\\": \\\"chart.test.ts\\\", \\\"kind\\\": \\\"unit\\\", \\\"prefix\\\": \\\"render examp\\\"}]\\n    }\\n  },\\n  {\\n    \\\"id\\\": \\\"T-pointer-bar\\\",\\n    \\\"statement\\\": \\\"Under the pointer.\\\",\\n    \\\"appliesTo\\\": [\\\"bar\\\"],\\n    \\\"notApplicable\\\": {\\n      \\\"line\\\": \\\"Bar cell.\\\",\\n      \\\"area\\\": \\\"Bar cell.\\\",\\n      \\\"scatter\\\": \\\"Bar cell.\\\",\\n      \\\"donut\\\": \\\"Bar cell.\\\",\\n      \\\"compact\\\": \\\"Bar cell.\\\"\\n    },\\n    \\\"evidence\\\": {\\n      \\\"bar\\\": [{\\\"file\\\": \\\"chart.test.ts\\\", \\\"kind\\\": \\\"unit\\\", \\\"prefix\\\": \\\"render examples\\\"}]\\n    }\\n  }\\n]\\n| ID | Criterion | Verified by | Driven by |\\n|---|---|---|---|\\n| A1 | Every chart has an accessible name: its `title`, or the heading named by `labelledBy`, or else a generated name (\\\"Line chart of Sessions by Day\\\") with AX140 raised in every build. The title's heading level is the author's (`level`), and it can be hidden visually. Every chart has a generated summary: type, series, x range with time zone, y range, each series' minimum, maximum and last value, and any omissions. `description` adds to the summary and never removes the zone or omission statements. Element ids are unique per chart. | Accessibility-tree snapshot for every fixture; a 24-chart page has no duplicate ids; axe `heading-order` | R11, R13, WCAG 1.1.1, 1.3.1, 2.4.6 |\\n| A2 | Keyboard: at most two tab stops while the table is closed, the plot and one toolbar with roving focus that holds legend toggles, zoom, pause and the table control. Every point is reachable in order; the series can be switched; the ends can be reached directly; focus can leave the chart. The focus indicator is at least 2 px and 3:1 and is not hidden by the tooltip. The exact keys and roles are fixed after the pattern spike in M1 (section 8). | Forward and reverse traversal in collapsed, zoomed, streaming and table-open states; focus after hiding the focused series; indicator contrast | R12, WCAG 2.1.1, 2.1.2, 2.4.3, 2.4.7, 2.4.11, 1.4.11 |\\n| A3 | Moving focus to a point conveys its text (series, x, value with unit, position) through the focused element's value text: the plot is a native range control whose `aria-valuetext` describes the focused point (decision 0001; earlier drafts said \\\"accessible name or a polite live region\\\", which the chosen pattern does not use, and A7 forbids announcements for navigation other than this). On touch screen readers, every point is reachable by swiping, or the table is reachable within two gestures. | Accessibility-tree snapshot after each key. No screen-reader rehearsal is part of 1.0 (the owner's decision, 2026-11-18): what a reader actually speaks on NVDA, VoiceOver or TalkBack has not been checked, and the conformance table says so. The script for such a rehearsal is kept in decision 0001 for when one is done. | R12, R13, WCAG 4.1.2 |\\n| A4 | \\\"View as table\\\" shows the data as an HTML table built from the normalized data when opened: the title as caption, field labels with units as column headers, x values as row headers, values formatted as in F6. It covers the current x range, 100 rows per page, with every row reachable by paging or by jumping to an x value. It sits in a focusable scroll region no taller than the plot, and opening it does not move other charts. | Table content compared with fixture data, including a value near row 900,000 of 1,000,000; a 24-chart page layout test | R13, WCAG 1.3.1, 1.3.2, 3.3.1 |\\n| A5 | Series are never distinguished by color alone, in any mode. Each line and area carries a shape marker at its last point and at sparse intervals, repeated in the legend and tooltip; under `prefers-contrast: more` or forced colors, lines also differ by dash. Adjacent filled marks (slices, stacked segments) are separated by at least 1 px of background. Bars are told apart by position and order, and by the legend and tooltip that name them; a compact chart has neither, so there neighbouring bar series also differ by fill pattern (series further apart may share a pattern: four patterns exist). The default palette has eight colors, each at least 3:1 on the default light and dark backgrounds, with a minimum pairwise OKLab difference of 0.10 (provisional) under normal vision and simulated protanopia, deuteranopia and tritanopia. On any other background, Axylo measures the palette against the resolved background and raises AX141 below 3:1. | Palette script scoring the rendered marks of an eight-series chart in both schemes, repeats included; rendered-pixel checks of separators; a grayscale screenshot in which three crossing lines can be told apart by marker | R7, WCAG 1.4.1, 1.4.11 |\\n| A6 | Content reflows at 320 CSS px and 400% zoom without two-dimensional scrolling. User text-spacing overrides do not clip text. | Viewport and style-override tests in three engines | WCAG 1.4.10, 1.4.12 |\\n| A7 | Data arriving does not speak. Announcements happen only for the reader's own navigation, and for a change of state (L7). While data streams, keyboard focus stays on the same datum until it leaves the window. | Stream test counting live-region changes with and without focus; 24 concurrent streams | R12 |\\n| A8 | axe-core reports no violations on any fixture in any state, including `heading-order` and `scrollable-region-focusable`. | CI | R11 |\\n| A9 | A conformance table lists every applicable WCAG 2.2 AA success criterion, the test that covers it, and what the author must supply (a meaningful title or `labelledBy`, series names, units, the page's own structure). It also states the limits in section 3.8. The criteria are the ones cited as \\\"WCAG x.y.z\\\" in the last column of this document's criterion rows; a criterion of WCAG 2.2 A or AA that no row cites is listed in the table as not covered by a test, with a word on why: not applicable to a chart component, the page's responsibility, or not assessed (it can apply to a chart, and no test is cited for it; the table claims nothing about it). | Published with each release; a CI check that every listed test exists | R11 |\\n| A10 | Every built-in string can be replaced through `messages`. Built-in English text is marked `lang=\\\"en\\\"` when the document language is not English. | Test on a `lang=\\\"de\\\"` page | WCAG 3.1.2 |\\n\\n### 3.5 Diagnostic registry\\n\\nLevel decides delivery. **Error**: the chart or a series cannot be drawn; the chart shows its error state. **Warning**: something is not as the author gave it; where that means values were left out or changed (F12), the reader sees the note, and the registry's rows say which codes those are (a warning about an option, a name, a colour or a tick label shows none). **Hint**: advice for the author. Errors and warnings print once per code per page in every build; hints print in development builds only. `strict: true` throws on errors and warnings found while validating a create, `update` or `append` call, synchronously from that call. A diagnostic that can only arise later (a contrast check after the page's CSS changes, a custom formatter that throws when a table page is built, a label that stops fitting after a resize) is reported when it is found and is never thrown. Every diagnostic names the chart; those about data name the field and the first row indexes in the caller's own data.\\napps/docs/lib/consumer.mjs:19:import { cacheDir, repoRoot } from './examples.mjs';\\napps/docs/lib/consumer.mjs:22:export const packedDir = path.join(cacheDir, 'packed');\\napps/docs/lib/consumer.mjs:23:export const consumerDir = path.join(cacheDir, 'consumer');\\napps/docs/lib/examples.mjs:23:export const cacheDir = path.join(docsRoot, '.cache');\\napps/docs/lib/conformance.mjs:198:export async function readConformance({ root }) {\\napps/docs/test/conformance.test.ts:19:import { cacheDir, repoRoot } from '../lib/examples.mjs';\\napps/docs/test/conformance.test.ts:120:    const dir = fs.mkdtempSync(path.join(cacheDir, 'conformance-'));\\napps/docs/test/examples.browser.test.ts:49:  await buildSite();\\napps/docs/test/site.browser.test.ts:23:  await buildSite();\\napps/docs/test/node.browser.test.ts:16:beforeAll(async () => { await buildSite(); }, 180_000);\\napps/docs/test/defaults.browser.test.ts:114:  await buildSite();\\napps/docs/test/theme.browser.test.ts:23:  await buildSite();\\napps/docs/test/options.test.ts:19:import { cacheDir, docsRoot, repoRoot } from '../lib/examples.mjs';\\napps/docs/test/options.test.ts:78:const dir = path.join(cacheDir, 'types');\\napps/docs/test/diagnostics.browser.test.ts:33:  await buildSite();\\napps/docs/lib/site.mjs:27:import { readConformance } from './conformance.mjs';\\napps/docs/lib/site.mjs:110:export async function buildSite({ outDir, log = () => {}, uncheckedLibrary = false } = {}) {\\napps/docs/lib/site.mjs:121:  const tmp = `${outDir}.tmp-${process.pid}`;\\napps/docs/lib/site.mjs:134:    const conformance = await readConformance({ root: repoRoot, revision });\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nreviews/2026-11-18/impl/wp/layout-fix-2.events.jsonl:6:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_1\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '1,240p' apps/docs/examples/dates.ts && sed -n '1,220p' apps/docs/examples/line-time.ts && sed -n '1,250p' apps/docs/test/examples.browser.test.ts\\\"\",\"aggregated_output\":\"import { line } from 'axylo';\\n\\n// Raises AX111 on purpose: the first chart is given instants where calendar dates were meant.\\nconst values = [120, 135, 128, 150, 162];\\n\\n// UTC midnights, as `new Date('2026-02-24').toISOString()` or many APIs produce them. These are\\n// instants: shown in the viewer's time zone, and west of UTC each one falls on the evening before.\\nconst instants = values.map((sessions, i) => ({ day: `2026-02-${24 + i}T00:00:00Z`, sessions }));\\nline('#instants', { title: 'Sent as instants', data: instants, x: 'day', y: 'sessions' });\\n\\n// The same days as calendar dates: read the same in every time zone.\\nconst dates = values.map((sessions, i) => ({ day: `2026-02-${24 + i}`, sessions }));\\nline('#dates', { title: 'Sent as dates', data: dates, x: 'day', y: 'sessions' });\\nimport { line } from 'axylo';\\n\\n// Instants: epoch milliseconds, one per 10 minutes over a day, declared `type: 'time'`.\\nconst start = Date.UTC(2026, 2, 10, 0, 0);\\nconst services = ['checkout', 'search'];\\nconst rows = Array.from({ length: 144 }, (_, i) => services.map((service, s) => ({\\n  at: start + i * 600_000,\\n  service,\\n  p95: Math.round((s ? 180 : 320) + 60 * Math.sin(i / 12 + s) + (i >= 84 && i < 96 ? 400 : 0)),\\n}))).flat();\\n\\nline('#chart', {\\n  title: 'Response time, 10 March',\\n  subtitle: 'p95 per 10 minutes',\\n  data: rows,\\n  // Shown in UTC for every viewer; the tooltip heading and the summary name the zone.\\n  x: { field: 'at', type: 'time', timeZone: 'UTC' },\\n  y: { field: 'p95', label: 'Response time', unit: 'ms' },\\n  series: 'service',\\n  reference: [\\n    { y: 500, label: 'Objective' },\\n    { x: [start + 84 * 600_000, start + 96 * 600_000], label: 'Incident' },\\n  ],\\n});\\n/**\\n * Criterion DX10: every runnable example in the documentation is compiled and rendered from the built\\n * library. Run after `npm run build`:\\n *\\n *   AXYLO_BROWSER=1 npx vitest run apps/docs/test/examples.browser.test.ts\\n *\\n * 1. Type-checks every example against the package's declarations (packages/axylo/dist/index.d.ts and\\n *    packages/react/dist/index.d.ts, reached through the workspace packages `axylo` and `@axylo/react`).\\n * 2. Builds the site, which compiles the examples with esbuild and copies the library's built files.\\n * 3. Opens each example's page in system Chrome and checks: every chart has an accessible name; every\\n *    chart draws marks unless the example says it draws none on purpose; no console errors or page errors;\\n *    the diagnostics printed are exactly the ones the example says it raises on purpose.\\n *\\n * Examples run in America/Los_Angeles, where an instant at UTC midnight is the previous evening, so the\\n * date examples are exercised where they matter, and at 760 px, about the width an example has on a\\n * documentation page on a desktop screen.\\n */\\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\\nimport { execFileSync } from 'node:child_process';\\nimport path from 'node:path';\\nimport { chromium, type Browser } from 'playwright-core';\\nimport { buildSite } from '../lib/site.mjs';\\nimport { docsRoot, listExamples, repoRoot, writeTypecheckInputs } from '../lib/examples.mjs';\\nimport { serve } from '../lib/serve.mjs';\\n\\ninterface Example { name: string; file: string; ext: string; raises: string[]; noMarks: boolean }\\n\\n// Through node itself, so the same call works on Windows, where node_modules/.bin/tsc is a shell script.\\nconst tsc = path.join(repoRoot, 'node_modules/typescript/bin/tsc');\\n// Read from the sources at collection time, so each example is its own test.\\nconst examples: Example[] = listExamples();\\nlet server: Awaited<ReturnType<typeof serve>>;\\nlet browser: Browser;\\n\\nfunction typecheck(config: string): string {\\n  try {\\n    execFileSync(process.execPath, [tsc, '-p', path.join(docsRoot, 'examples', config)], { cwd: repoRoot, encoding: 'utf8', stdio: 'pipe' });\\n    return '';\\n  } catch (error) {\\n    const e = error as { stdout?: string; stderr?: string };\\n    return `${e.stdout ?? ''}${e.stderr ?? ''}` || String(error);\\n  }\\n}\\n\\nbeforeAll(async () => {\\n  writeTypecheckInputs();\\n  await buildSite();\\n  server = await serve();\\n  browser = await chromium.launch({ channel: 'chrome', headless: true });\\n}, 120_000);\\n\\nafterAll(async () => {\\n  await browser?.close();\\n  await server?.close();\\n});\\n\\ndescribe('examples type-check against the package declarations', () => {\\n  it('TypeScript and React examples (strict)', () => {\\n    expect(typecheck('tsconfig.json')).toBe('');\\n  });\\n  it('scripts of the HTML examples (checkJs)', () => {\\n    expect(typecheck('tsconfig.html.json')).toBe('');\\n  });\\n});\\n\\ndescribe('examples render in Chrome from the built library', () => {\\n  it('there are examples', () => {\\n    expect(examples.length).toBeGreaterThan(20);\\n  });\\n\\n  it.each(examples.map(example => [example.file, example] as const))('%s', async (_file, example) => {\\n    const context = await browser.newContext({\\n      viewport: { width: 760, height: 900 }, locale: 'en-US', timezoneId: 'America/Los_Angeles',\\n    });\\n    const page = await context.newPage();\\n    const errors: string[] = [];\\n    const codes = new Set<string>();\\n    page.on('pageerror', error => errors.push(`page error: ${error.message}`));\\n    page.on('console', message => {\\n      const text = message.text();\\n      if (message.type() === 'error') errors.push(`console.error: ${text}`);\\n      for (const m of text.matchAll(/^\\\\[axylo (AX\\\\d{3})\\\\]/g)) codes.add(m[1]!);\\n      if (message.type() === 'warning' && !text.startsWith('[axylo ')) errors.push(`console.warn: ${text}`);\\n    });\\n    page.on('requestfailed', request => errors.push(`request failed: ${request.url()}`));\\n    page.on('response', response => { if (response.status() >= 400) errors.push(`HTTP ${response.status()}: ${response.url()}`); });\\n    await page.goto(server.url(`apps/docs/dist/examples/${example.name}.html`));\\n\\n    // Ready when every chart has drawn marks or shows a state message, and nothing changes for 3 frames.\\n    await page.waitForFunction(() => {\\n      const figures = [...document.querySelectorAll('figure.axylo-figure')];\\n      return figures.length > 0 && figures.every(f =>\\n        f.querySelector('svg [style*=\\\"--axylo-series-color\\\"], canvas') !== null ||\\n        [...f.querySelectorAll('.axylo-message')].some(m => !(m as HTMLElement).hidden && m.textContent));\\n    }, null, { timeout: 15_000 });\\n    await page.evaluate(() => new Promise(resolve => {\\n      let n = 0;\\n      const tick = () => (++n < 3 ? requestAnimationFrame(tick) : resolve(null));\\n      requestAnimationFrame(tick);\\n    }));\\n\\n    const charts = await page.evaluate(() => [...document.querySelectorAll('figure.axylo-figure')].map(f => {\\n      const labelled = f.getAttribute('aria-labelledby');\\n      const name = (f.getAttribute('aria-label') ?? '') ||\\n        (labelled ?? '').split(/\\\\s+/).map(id => document.getElementById(id)?.textContent ?? '').join(' ').trim();\\n      const marks = [...f.querySelectorAll('svg [style*=\\\"--axylo-series-color\\\"]')].filter(el => {\\n        const box = (el as SVGGraphicsElement).getBBox();\\n        return box.width > 0 || box.height > 0;\\n      }).length;\\n      const message = [...f.querySelectorAll('.axylo-message')].find(m => !(m as HTMLElement).hidden)?.textContent ?? '';\\n      return { role: f.getAttribute('role'), name, marks, message };\\n    }));\\n\\n    expect(charts.length, `${example.file}: charts`).toBeGreaterThan(0);\\n    for (const chart of charts) {\\n      expect(['group', 'img'], `${example.file}: role`).toContain(chart.role);\\n      expect(chart.name, `${example.file}: accessible name`).not.toBe('');\\n      if (example.noMarks) expect(chart.message, `${example.file}: a state message`).not.toBe('');\\n      else expect(chart.marks, `${example.file}: \\\"${chart.name}\\\" draws marks (message: \\\"${chart.message}\\\")`).toBeGreaterThan(0);\\n    }\\n    expect(errors, `${example.file}: errors`).toEqual([]);\\n    expect([...codes].sort(), `${example.file}: diagnostics printed`).toEqual([...example.raises].sort());\\n    await context.close();\\n  }, 60_000);\\n});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\napps/docs/build.mjs:13:const result = await buildSite({ log: message => console.warn(message), uncheckedLibrary: args.includes('--unchecked-library') });\nreviews/2026-11-18/impl/wp/docs5.report.md:68:- **The whole docs browser suite** (172 tests with the new example) waits on your rebuild: every file calls the default `buildSite()`, which refuses while `dist` is not the build of the source. Then run `AXYLO_BROWSER=1 npx vitest run --config apps/docs/vitest.config.ts`, and `node apps/docs/build.mjs` to replace `apps/docs/dist`.\nreviews/2026-11-18/impl/wp/docs3.report.md:55:All six docs browser test files (170 tests at my last run): examples and their checks including Select range, diagnostics outcomes and printed lines, site axe and overflow, defaults, theme, and Node examples. Each calls the default `buildSite()`, so they refuse until `dist` is the build of the source. After the rebuild, run `AXYLO_BROWSER=1 npx vitest run --config apps/docs/vitest.config.ts`, then `node apps/docs/build.mjs` to re