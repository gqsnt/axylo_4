{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"rg -n 'function diagnosticOutput|function checkSite|function readSizes|function writeSourcePage' apps/docs/lib/site.mjs; sed -n '250,340p;405,475p' apps/docs/lib/site.mjs; sed -n '1,125p' apps/docs/lib/examples.mjs; sed -n '1,120p' apps/docs/data/wcag.mjs\"","aggregated_output":"320:function diagnosticOutputBlock(code, target, where, ctx) {\n446:function readSizes(integrity) {\n543:async function diagnosticOutput(diagnostics) {\n635:function writeSourcePage(outDir, relative, ctx) {\n692:export function checkSite(outDir) {\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"color-scheme\" content=\"light dark\">\n<title>Example: ${escapeHtml(e.name)}</title>\n<link rel=\"icon\" href=\"data:,\">\n<link rel=\"stylesheet\" href=\"../assets/site.css\">\n<script src=\"../assets/frame.js\" defer></script>\n${styles}</head>\n<body class=\"example-page\">\n${body}\n</body>\n</html>\n`;\n}\n\n// ---------- pages ----------\n\nfunction renderPage(entry, source, index, ctx) {\n  const headings = [];\n  const ids = reservedIds();\n  const where = path.join(pagesDir, `${entry.page}.md`);\n  const body = markdownToHtml(source, {\n    headings, ids,\n    link: url => pageLink(url, where, '', ctx),\n    directive: d => directive(d, where, ctx, ids),\n  });\n  const title = headings.find(h => h.level === 1)?.text ?? entry.label;\n  const prev = pages[index - 1];\n  const next = pages[index + 1];\n  const pager = `<nav class=\"pager\" aria-label=\"Previous and next page\">${prev ? `<a rel=\"prev\" href=\"${prev.page}.html\">← ${escapeHtml(prev.label)}</a>` : '<span></span>'}${next ? `<a rel=\"next\" href=\"${next.page}.html\">${escapeHtml(next.label)} →</a>` : ''}</nav>`;\n  return layout({ title, body: body + pager, current: entry.page, base: '', ctx, sourceFile: `apps/docs/pages/${entry.page}.md` });\n}\n\n/** Ids the layout itself uses, reserved before a page's headings get theirs. */\nconst reservedIds = () => new Set(['main']);\n\nconst PAGE_NAMES = new Set(pages.map(p => p.page));\n\n/**\n * Rewrites a link written for the Markdown sources (readable on a code host) to its place in the site.\n * `from` is the file the link is written in; `base` is the path from the page being built to the site root.\n * A link to any other file of the repository publishes that file as a source page.\n */\nexport function pageLink(url, from, base, ctx) {\n  checkHref(url);\n  if (/^(https|mailto):/i.test(url) || url.startsWith('#')) return url;\n  const [file, hash] = url.split('#');\n  if (file === 'diagnostics.md' && hash && /^ax\\d{3}$/i.test(hash)) return `${base}diagnostics/${hash.toUpperCase()}.html`;\n  const name = file.endsWith('.md') && !file.includes('/') ? file.slice(0, -3) : null;\n  if (name !== null && PAGE_NAMES.has(name)) return `${base}${name}.html${hash ? '#' + hash : ''}`;\n  const absolute = path.resolve(path.dirname(from), file);\n  const relative = path.relative(repoRoot, absolute).split(path.sep).join('/');\n  if (relative.startsWith('..') || path.isAbsolute(relative)) throw new Error(`${path.relative(repoRoot, from)}: link ${url} leaves the repository`);\n  if (!fs.existsSync(absolute) || fs.statSync(absolute).isDirectory()) throw new Error(`${path.relative(repoRoot, from)}: link ${url} names no file`);\n  ctx.published.add(relative);\n  const line = hash && /^L(\\d+)(?:-L\\d+)?$/.exec(hash);\n  if (hash && !line) throw new Error(`${path.relative(repoRoot, from)}: link ${url}: only line anchors (#L12, #L12-L20) are kept on source pages`);\n  return `${base}${sourcePath(relative)}${line ? `#L${line[1]}` : ''}`;\n}\n\nconst sourcePath = relative => `source/${relative}.html`;\n\nfunction directive({ kind, name, target }, where, ctx, ids) {\n  if (kind === 'example') return exampleBlock(name, target, where, ctx, ids);\n  if (kind === 'source') return sourceBlock(name, target, where, ctx);\n  if (kind === 'table') return generatedTable(name, target, where, ctx);\n  if (kind === 'output') return diagnosticOutputBlock(name, target, where, ctx);\n  throw new Error(`Unknown directive ${kind}`);\n}\n\n/** `[output: AX103](../data/diagnostics.mjs)`: what that code's minimal input printed when the site was built. */\nfunction diagnosticOutputBlock(code, target, where, ctx) {\n  const relative = repoPath(where, target);\n  if (relative !== 'apps/docs/data/diagnostics.mjs') throw new Error(`${path.relative(repoRoot, where)}: [output:] names apps/docs/data/diagnostics.mjs, not ${relative}`);\n  const printed = ctx.seen.get(code);\n  if (!printed) throw new Error(`${path.relative(repoRoot, where)}: no diagnostic ${code}`);\n  return `${codeBlock(printed[0].join('\\n'), 'text')}<p class=\"small\">Printed by <a href=\"diagnostics/${escapeHtml(code)}.html\">${escapeHtml(code)}</a>'s minimal input when this site was built.</p>`;\n}\n\nfunction repoPath(where, target) {\n  return path.relative(repoRoot, path.resolve(path.dirname(where), target)).split(path.sep).join('/');\n}\n\nfunction listText(items) {\n  return items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;\n}\n\nfunction exampleBlock(name, target, where, ctx, ids) {\n  const relative = repoPath(where, target);\n  const example = ctx.examples.find(e => e.repoFile === relative);\n  if (!example) throw new Error(`${path.relative(repoRoot, where)}: example ${target} does not exist`);\n  if (example.name !== name) throw new Error(`${path.relative(repoRoot, where)}: example link text \"${name}\" does not match ${example.file}`);\nfunction conformanceTables(ctx) {\n  const { criteria, checker, uncited } = ctx.conformance;\n  const spec = path.join(repoRoot, 'docs/02-product-spec.md');\n  const specLink = url => pageLink(url, spec, '', ctx);\n  const specPage = sourcePath('docs/02-product-spec.md');\n  ctx.published.add('docs/02-product-spec.md');\n  const checkerPage = sourcePath('acceptance/check.mjs');\n  const engines = ['chromium', 'firefox', 'webkit', null];\n  const engineName = engine => engine === null ? 'Unit tests (Node)' : checker.label(engine);\n  const state = checker.refused\n    ? `<p><strong>Nothing is counted on this page.</strong> When this site was built, <a href=\"${checkerPage}\">the acceptance checker</a> refused its matrix (${checker.refused.length} ${checker.refused.length === 1 ? 'problem' : 'problems'}), so every result below reads “not recorded” and no cited test is listed. The first problem it gave: <code>${escapeHtml(checker.refused[0])}</code></p>`\n    : `<p>Each entry is <a href=\"${checkerPage}\">the acceptance checker</a>’s, run in release mode when this site was built: a result counts only when its recorded provenance matches the revision the site was built from.</p>`;\n  const warned = checker.warnings.length ? `<details><summary>The checker's warnings: ${checker.warnings.length}</summary><ul>${checker.warnings.map(w => `<li>${escapeHtml(w)}</li>`).join('')}</ul></details>` : '';\n  const tests = c => c.tests.length ? `<details><summary>Tests the matrix cites: ${c.tests.length}</summary><ul>${c.tests.map(t =>\n    `<li>${escapeHtml(t.kind)}${t.engine ? `, ${escapeHtml(checker.label(t.engine))}` : ''}: <code>${escapeHtml(t.file)}</code>${t.test ? `, “${escapeHtml(t.test)}”` : ''}</li>`).join('')}</ul></details>` : '';\n  const rows = criteria.map(c => [\n    `<th scope=\"row\">${escapeHtml(c.sc)} ${escapeHtml(c.name)} <span class=\"small\">(level ${escapeHtml(c.level)})</span></th>`,\n    `<td>${c.rows.map(r => `<p><a href=\"${specPage}\">${escapeHtml(r.id)}</a>: ${renderInline(r.criterion, specLink)}</p>`).join('')}</td>`,\n    `<td><ul class=\"evidence\">${c.verdict.map(v => `<li>Checker, ${escapeHtml(v.id)}: ${escapeHtml(v.text)}</li>`).join('')}${engines.map(engine =>\n      `<li>${escapeHtml(engineName(engine))}: ${escapeHtml(c.engines[String(engine)])}</li>`).join('')}</ul>${tests(c)}</td>`,\n  ]);\n  const table = `<p>Evidence is recorded per row of the specification, not per criterion: the results and the tests listed under a criterion are those of the specification rows that cite it, and not every one of them bears on that criterion.</p>${htmlTable(['Success criterion', 'What Axylo does (the specification\\'s rows that cite it)', 'Evidence at this revision'], rows, 'WCAG criteria the specification cites')}`;\n  const files = checker.files.length\n    ? htmlTable(['Result file', 'Engine', 'Recorded at commit', 'Counted'], checker.files.map(f => [\n      `<th scope=\"row\"><code>${escapeHtml(f.file)}</code></th>`, `<td>${escapeHtml(engineName(f.engine))}</td>`,\n      `<td>${f.provenance?.commit ? `<code>${escapeHtml(f.provenance.commit.slice(0, 7))}</code>${f.provenance.dirty ? ', with uncommitted changes' : ''}` : 'not recorded'}</td>`,\n      `<td>${checker.refused ? 'No: the checker refused its matrix' : f.counted ? 'Yes' : `No: ${escapeHtml(f.why ?? 'not read by the checker')}`}</td>`,\n    ]), 'Result files')\n    : '<p>No result files were present in <code>acceptance/results/</code> when this site was built (they are not kept in the repository).</p>';\n  const rest = `<p>The specification cites ${criteria.length} of the ${criteria.length + uncited.length} level A and AA success criteria of WCAG 2.2. No test covers the others; why, criterion by criterion, is this documentation's own reading of what a chart renders, and “not assessed” where a criterion can apply and nothing checks it.</p>${htmlTable(['Success criterion', 'Not covered by a test', 'Why'], uncited.map(c => [\n    `<th scope=\"row\">${escapeHtml(c.sc)} ${escapeHtml(c.name)} <span class=\"small\">(level ${escapeHtml(c.level)})</span></th>`,\n    `<td>${escapeHtml(c.kind[0].toUpperCase() + c.kind.slice(1))}</td>`, `<td>${escapeHtml(c.why)}</td>`,\n  ]), 'Criteria the specification does not cite')}`;\n  ctx.published.add('apps/docs/data/wcag.mjs');\n  return `${state}${warned}${table}<h3>Result files</h3>${files}<h3>Criteria the specification does not cite</h3>${rest}<p class=\"small\">Generated from <a href=\"${specPage}\">docs/02-product-spec.md</a>, <a href=\"${checkerPage}\">acceptance/check.mjs</a> and, for the criteria no row cites, <a href=\"${sourcePath('apps/docs/data/wcag.mjs')}\">apps/docs/data/wcag.mjs</a>.</p>`;\n}\n\n/**\n * scripts/size.mjs's last measurement (bench/size-latest.json). Its numbers are shown only when it measured\n * the very tarball this site installed (the same npm integrity); otherwise only the targets are.\n */\nfunction readSizes(integrity) {\n  const file = path.join(repoRoot, 'bench/size-latest.json');\n  if (!fs.existsSync(file)) return { measured: false, date: null, rows: [] };\n  const data = JSON.parse(fs.readFileSync(file, 'utf8'));\n  if (!Array.isArray(data.rows)) throw new Error('bench/size-latest.json: no rows');\n  return { measured: data.packed?.axylo === integrity, date: data.date ?? null, method: data.method ?? '', rows: data.rows };\n}\n\nfunction sizesTable(ctx) {\n  const { measured, date, method, rows } = ctx.sizes;\n  const note = `<p class=\"small\">From <a href=\"${sourcePath('bench/size-latest.json')}\">bench/size-latest.json</a>, written by <code>scripts/size.mjs</code>${date ? ` on ${escapeHtml(date.slice(0, 10))}` : ''}.</p>`;\n  if (!measured) {\n    const targets = rows.filter(r => r.targetKiB !== null);\n    return `<p>No size measurement of the packed files this site was built from: the last one measured a different build, so no measured size is shown here. The targets:</p>${htmlTable(['What a page loads', 'Target, gzipped'],\n      targets.map(r => [`<th scope=\"row\">${escapeHtml(r.entry)}</th>`, `<td>${escapeHtml(String(r.targetKiB))} KiB</td>`]), 'Size targets')}${note}`;\n  }\n  const status = r => r.targetKiB === null ? 'No target' : r.over ? 'Not met' : 'Met';\n  return `${htmlTable(['What a page loads', 'Gzipped, measured', 'Target', 'Target met'], rows.map(r => [\n    `<th scope=\"row\">${escapeHtml(r.entry)}</th>`, `<td>${escapeHtml(r.totalKiB.toFixed(2))} KiB</td>`,\n    `<td>${r.targetKiB === null ? '–' : `${escapeHtml(String(r.targetKiB))} KiB`}</td>`, `<td>${status(r)}</td>`,\n  ]), 'Measured sizes')}<p class=\"small\">Measured from the same packed tarball this site installed (${escapeHtml(method)}).</p>${note}`;\n}\n\nfunction htmlTable(head, rows, caption) {\n  const th = head.map(h => `<th scope=\"col\">${escapeHtml(h)}</th>`).join('');\n  return `<div class=\"table-scroll\" tabindex=\"0\" role=\"region\" aria-label=\"${escapeHtml(caption)}\"><table><thead><tr>${th}</tr></thead><tbody>${rows.map(r => `<tr>${r.join('')}</tr>`).join('')}</tbody></table></div>`;\n}\n\nfunction diagnosticsTable(ctx, link) {\n  const rows = ctx.diagnostics.map(d => [\n/**\n * Runnable examples: files in apps/docs/examples, each one a complete program a reader can copy.\n *\n * - `name.ts`: a module that imports from 'axylo' and draws into elements it names by id, as in\n *   `line('#chart', …)`. Its host is a page with one empty <div> per id, and a bundler (or an import map)\n *   that resolves `axylo`.\n * - `name.html`: the body of a page: markup and scripts. A module script imports `axylo` by name, so its\n *   page needs a bundler or an import map; a classic script uses the `Axylo` global of the script-tag file.\n * - `_name.ts`: a helper module shared by examples (the Phase 1 fixtures), not an example.\n *\n * What an example promises is written in its own comments, in words the reader sees too:\n * - \"Raises AX111 on purpose\" (or \"Raises AX102, AX103 and AX106 on purpose\") lists the diagnostics it\n *   demonstrates; the browser test fails on any other code, and on a listed code that does not appear.\n * - \"Draws no marks on purpose\" marks an example whose charts show a state (loading, empty, error) instead.\n */\nimport fs from 'node:fs';\nimport path from 'node:path';\n\nexport const docsRoot = path.resolve(import.meta.dirname, '..');\nexport const repoRoot = path.resolve(docsRoot, '../..');\nexport const examplesDir = path.join(docsRoot, 'examples');\n/** Generated inputs that are not the site: the packed consumer and compiler probes. Git-ignored. */\nexport const cacheDir = path.join(docsRoot, '.cache');\n\nconst CHART_CALL = /\\b(?:line|area|bar|scatter|donut)\\(\\s*(['\"])#([\\w-]+)\\1|getElementById\\(\\s*(['\"])([\\w-]+)\\3\\s*\\)/g;\nconst RAISES = /Raises ((?:AX\\d{3})(?:(?:, | and )AX\\d{3})*) on purpose/;\nconst NO_MARKS = /Draws no marks on purpose/;\nexport const MODULE_SCRIPT = /<script type=\"module\">([\\s\\S]*?)<\\/script>/g;\nexport const CLASSIC_SCRIPT = /<script>([\\s\\S]*?)<\\/script>/g;\nconst HELPER_IMPORT = /from '\\.\\/(_[\\w-]+)'/g;\n\n/**\n * The first-chart snippets of the repository (examples/first-chart, maintained with the distribution tests)\n * also run on the site, under these names, so the Getting started page shows them live beside their source.\n */\nexport const EXTERNAL = [\n  { name: 'first-chart-npm', path: 'examples/first-chart/npm.ts' },\n  { name: 'first-chart-script', path: 'examples/first-chart/script.html' },\n];\n\nexport function listExamples() {\n  const own = fs.readdirSync(examplesDir)\n    .filter(file => /\\.(ts|html)$/.test(file) && !file.endsWith('.d.ts') && !file.startsWith('_'))\n    .sort()\n    .map(file => readExample(file));\n  const external = EXTERNAL.filter(e => fs.existsSync(path.join(repoRoot, e.path)))\n    .map(e => readExample(path.basename(e.path), path.join(repoRoot, path.dirname(e.path)), e.name));\n  return [...external, ...own];\n}\n\n/** Helper modules (`_name.ts`) the examples import. */\nexport function listHelpers() {\n  return fs.readdirSync(examplesDir).filter(file => /^_[\\w-]+\\.ts$/.test(file)).sort();\n}\n\nexport function readExample(file, dir = examplesDir, as = null) {\n  const ext = path.extname(file).slice(1);\n  const name = as ?? path.basename(file, path.extname(file));\n  const source = fs.readFileSync(path.join(dir, file), 'utf8');\n  const repoFile = path.relative(repoRoot, path.join(dir, file)).split(path.sep).join('/');\n  // The script-tag snippet is a whole document that loads the package from a CDN.\n  const documentPage = ext === 'html' && /^<!doctype html>/i.test(source.trimStart());\n  const raises = RAISES.exec(source)?.[1].split(/, | and /) ?? [];\n  const targets = ext === 'ts' ? [...new Set([...source.matchAll(CHART_CALL)].map(m => m[2] ?? m[4]))] : [];\n  if (ext === 'ts' && targets.length === 0) throw new Error(`${file}: no chart call with a '#id' target, and no getElementById('id')`);\n  const helpers = [...new Set([...source.matchAll(HELPER_IMPORT)].map(m => `${m[1]}.ts`))];\n  for (const helper of helpers) if (!fs.existsSync(path.join(examplesDir, helper))) throw new Error(`${file}: imports ${helper}, which does not exist`);\n  const scriptTag = ext === 'html' && /<script src=\"[^\"]*axylo\\.iife(?:\\.min)?\\.js\"><\\/script>/.test(source);\n  return { file, name, ext, source, repoFile, raises, noMarks: NO_MARKS.test(source), targets, helpers, scriptTag, documentPage };\n}\n\n/** The scripts of an .html example, in order, with the line each starts on. */\nexport function htmlScripts(example) {\n  const out = [];\n  let n = 0;\n  for (const m of example.source.matchAll(MODULE_SCRIPT)) {\n    out.push({ kind: 'module', file: `${example.name}.${++n}.js`, line: lineOf(example.source, m.index), code: m[1], match: m[0] });\n  }\n  for (const m of example.source.matchAll(CLASSIC_SCRIPT)) {\n    out.push({ kind: 'classic', file: `${example.name}.${++n}.classic.js`, line: lineOf(example.source, m.index), code: m[1], match: m[0] });\n  }\n  return out;\n}\n\nfunction lineOf(text, index) {\n  return text.slice(0, index).split('\\n').length;\n}\n\n/** What a reader must supply around an example to run it on their own page. */\nexport function hostOf(example) {\n  if (example.documentPage) {\n    return { markup: null, text: 'A whole page. Its two URLs point at jsDelivr, which serves published npm packages. Axylo is not published yet, so this site serves the page with those two files taken from the packed package, and adds its own stylesheet (for the font and colours of the frame) and the script that sizes the frame.' };\n  }\n  if (example.ext === 'ts') {\n    return {\n      markup: example.targets.map(id => `<div id=\"${id}\"></div>`).join('\\n'),\n      text: `The page needs ${example.targets.length === 1 ? 'an element' : 'elements'} with ${example.targets.map(id => `id \"${id}\"`).join(', ')}, and a bundler (or an import map) that resolves the \\`axylo\\` package.`,\n    };\n  }\n  if (example.scriptTag) {\n    return { markup: null, text: 'This is the body of a page. It loads `axylo.iife.js` from the same folder: copy that file from `node_modules/axylo/dist/`.' };\n  }\n  return { markup: null, text: 'This is the body of a page. Its module script imports `axylo` by name, so the page needs a bundler or an import map that resolves it.' };\n}\n\n/**\n * Copies the examples into the packed consumer's `src`, so that they resolve `axylo` from the installed\n * tarball: .ts files and helpers as they are; each script of an .html example as\n * a .js file (classic scripts get `export {}` for a scope of their own, and a declaration of the `Axylo`\n * global from the package's own types); the Node examples under `src/node`.\n */\nexport function writeConsumerSources(consumerDir) {\n  const src = path.join(consumerDir, 'src');\n  fs.rmSync(src, { recursive: true, force: true });\n  fs.mkdirSync(path.join(src, 'node'), { recursive: true });\n  for (const e of listExamples().filter(e => e.ext !== 'html')) {\n    fs.writeFileSync(path.join(src, `${e.name}.${e.ext}`), e.source);\n  }\n  for (const file of listHelpers()) fs.copyFileSync(path.join(examplesDir, file), path.join(src, file));\n  fs.writeFileSync(path.join(src, 'globals.d.ts'), \"declare const Axylo: typeof import('axylo');\\n\");\n  const scripts = {};\n  for (const example of listExamples().filter(e => e.ext === 'html')) {\n    for (const script of htmlScripts(example)) {\n      fs.writeFileSync(path.join(src, script.file), script.kind === 'classic' ? script.code + '\\nexport {};\\n' : script.code);\n      scripts[script.file] = { example: example.file, line: script.line, kind: script.kind };\n// The level A and AA success criteria of WCAG 2.2 (W3C Recommendation, 5 October 2023; 4.1.1 Parsing is\n// obsolete and removed there), by number: name, level and, for a criterion the specification does not cite,\n// why no test covers it (spec A9). Which criteria are cited, and the evidence for them, come from the\n// specification and the acceptance checker (lib/conformance.mjs), not from here; the build fails when an\n// uncited criterion has no reason.\n//\n// The reasons are the documentation's own judgement of what a chart component renders: NA (Axylo renders\n// nothing the criterion is about), PAGE (it is decided by the page or site around the charts), and NOT\n// ASSESSED (it can apply to a chart, and nothing checks it, so nothing is claimed).\n\nconst NA = 'not applicable to a chart component';\nconst PAGE = 'the page\\'s responsibility';\nconst ASSESSED = 'not assessed';\n\nexport const wcag = {\n  '1.1.1': ['Non-text Content', 'A'],\n  '1.2.1': ['Audio-only and Video-only (Prerecorded)', 'A', NA, 'A chart has no audio or video.'],\n  '1.2.2': ['Captions (Prerecorded)', 'A', NA, 'A chart has no audio or video.'],\n  '1.2.3': ['Audio Description or Media Alternative (Prerecorded)', 'A', NA, 'A chart has no audio or video.'],\n  '1.2.4': ['Captions (Live)', 'AA', NA, 'A chart has no audio or video.'],\n  '1.2.5': ['Audio Description (Prerecorded)', 'AA', NA, 'A chart has no audio or video.'],\n  '1.3.1': ['Info and Relationships', 'A'],\n  '1.3.2': ['Meaningful Sequence', 'A'],\n  '1.3.3': ['Sensory Characteristics', 'A', ASSESSED, 'It can apply to the plot\\'s instructions and the messages; no test is cited for it.'],\n  '1.3.4': ['Orientation', 'AA', ASSESSED, 'Responsive sizing is tested, but no test exercises a restriction to one orientation.'],\n  '1.3.5': ['Identify Input Purpose', 'AA', NA, 'The chart\\'s one text field (\"Jump to\") asks for an x value, nothing about the user.'],\n  '1.4.1': ['Use of Color', 'A'],\n  '1.4.2': ['Audio Control', 'A', NA, 'A chart plays no audio.'],\n  '1.4.3': ['Contrast (Minimum)', 'AA'],\n  '1.4.4': ['Resize Text', 'AA'],\n  '1.4.5': ['Images of Text', 'AA', ASSESSED, 'It can apply to the chart\\'s labels; no test is cited for it.'],\n  '1.4.10': ['Reflow', 'AA'],\n  '1.4.11': ['Non-text Contrast', 'AA'],\n  '1.4.12': ['Text Spacing', 'AA'],\n  '1.4.13': ['Content on Hover or Focus', 'AA'],\n  '2.1.1': ['Keyboard', 'A'],\n  '2.1.2': ['No Keyboard Trap', 'A'],\n  '2.1.4': ['Character Key Shortcuts', 'A', ASSESSED, 'The zoom keys (+, - and 0) act only while the plot has focus, but no test establishes that protection.'],\n  '2.2.1': ['Timing Adjustable', 'A', NA, 'A chart sets no time limit. Moving content, such as a stream, is 2.2.2.'],\n  '2.2.2': ['Pause, Stop, Hide', 'A'],\n  '2.3.1': ['Three Flashes or Below Threshold', 'A', ASSESSED, 'It can apply to drawing and to streamed updates; no test is cited for it.'],\n  '2.4.1': ['Bypass Blocks', 'A', PAGE, 'Skipping repeated blocks is done by the page around the charts.'],\n  '2.4.2': ['Page Titled', 'A', PAGE, 'A chart does not set the page\\'s title.'],\n  '2.4.3': ['Focus Order', 'A'],\n  '2.4.4': ['Link Purpose (In Context)', 'A', NA, 'A chart contains no links.'],\n  '2.4.5': ['Multiple Ways', 'AA', PAGE, 'How a set of pages can be reached is the site\\'s.'],\n  '2.4.6': ['Headings and Labels', 'AA'],\n  '2.4.7': ['Focus Visible', 'AA'],\n  '2.4.11': ['Focus Not Obscured (Minimum)', 'AA'],\n  '2.5.1': ['Pointer Gestures', 'A'],\n  '2.5.2': ['Pointer Cancellation', 'A', ASSESSED, 'One test cancels a drag in progress and checks that the view is unchanged after release; no test covers the other pointer actions.'],\n  '2.5.3': ['Label in Name', 'A'],\n  '2.5.4': ['Motion Actuation', 'A', NA, 'Nothing in a chart responds to moving the device.'],\n  '2.5.7': ['Dragging Movements', 'AA'],\n  '2.5.8': ['Target Size (Minimum)', 'AA'],\n  '3.1.1': ['Language of Page', 'A', PAGE, 'The page\\'s language is set by the page; the chart marks its own English text (3.1.2).'],\n  '3.1.2': ['Language of Parts', 'AA'],\n  '3.2.1': ['On Focus', 'A', ASSESSED, 'It can apply to focus in the plot and the toolbar; no test is cited for it.'],\n  '3.2.2': ['On Input', 'A', ASSESSED, 'It can apply to the table\\'s \"Jump to\" field and pager; no test is cited for it.'],\n  '3.2.3': ['Consistent Navigation', 'AA', PAGE, 'Navigation repeated across pages is the site\\'s.'],\n  '3.2.4': ['Consistent Identification', 'AA', PAGE, 'Consistency across a set of pages is the site\\'s.'],\n  '3.2.6': ['Consistent Help', 'A', PAGE, 'Help offered across a set of pages is the site\\'s.'],\n  '3.3.1': ['Error Identification', 'A'],\n  '3.3.2': ['Labels or Instructions', 'A', ASSESSED, 'The table\\'s \"Jump to\" field has a label, but no test asserts it.'],\n  '3.3.3': ['Error Suggestion', 'AA', ASSESSED, 'It can apply to the \"Jump to\" field\\'s error; no test is cited for it.'],\n  '3.3.4': ['Error Prevention (Legal, Financial, Data)', 'AA', NA, 'A chart submits nothing: no legal, financial or data commitments.'],\n  '3.3.7': ['Redundant Entry', 'A', NA, 'A chart has no multi-step process.'],\n  '3.3.8': ['Accessible Authentication (Minimum)', 'AA', NA, 'A chart has no sign-in.'],\n  '4.1.2': ['Name, Role, Value', 'A'],\n  '4.1.3': ['Status Messages', 'AA'],\n};\n","exit_code":0,"status":"completed"}}
