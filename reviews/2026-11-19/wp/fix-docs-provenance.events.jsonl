ly the ones the example says it raises on purpose; and the example's own\\n *    check (test/example-checks.ts): a value from its data, and the interaction it teaches.\\n *\\n * Examples run in America/Los_Angeles, where an instant at UTC midnight is the previous evening, at 760 px.\\n */\\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\\nimport { execFileSync } from 'node:child_process';\\nimport path from 'node:path';\\nimport { chromium, type Browser, type Page } from 'playwright-core';\\nimport { buildSite } from '../lib/site.mjs';\\nimport { docsRoot, listExamples, repoRoot } from '../lib/examples.mjs';\\nimport { consumerDir, listFilesOutside, writeConsumerTsconfigs } from '../lib/consumer.mjs';\\nimport { serve } from '../lib/serve.mjs';\\nimport { checks, type Tools } from './example-checks';\\n\\nconst examples = listExamples();\\nlet server: Awaited<ReturnType<typeof serve>>;\\nlet browser: Browser;\\n\\n/** Runs tsc in the consumer; returns its errors and the files it read from outside the consumer. */\\nfunction typecheck(config: string, allowed: string[] = []): { errors: string; outside: string[] } {\\n  // Through node itself, so the same call works on Windows, where node_modules/.bin/tsc is a shell script.\\n  const tsc = path.join(repoRoot, 'node_modules/typescript/bin/tsc');\\n  try {\\n    const listing = execFileSync(process.execPath, [tsc, '-p', config, '--listFiles'], { cwd: consumerDir, encoding: 'utf8', stdio: 'pipe' });\\n    return { errors: '', outside: listFilesOutside(listing, allowed) };\\n  } catch (error) {\\n    const e = error as { stdout?: string; stderr?: string };\\n    const out = `${e.stdout ?? ''}${e.stderr ?? ''}`;\\n    return { errors: out.split('\\\\n').filter(l => /error TS/.test(l)).join('\\\\n') || out || String(error), outside: [] };\\n  }\\n}\\n\\nbeforeAll(async () => {\\n  await buildSite();\\n  server = await serve(path.join(docsRoot, 'dist'));\\n  browser = await chromium.launch({ channel: 'chrome', headless: true });\\n}, 180_000);\\n\\nafterAll(async () => {\\n  await browser?.close();\\n  await server?.close();\\n});\\n\\ndescribe('examples type-check in the packed consumer', () => {\\n  it('browser examples: .ts strict, .html scripts strict under checkJs, library checking on', () => {\\n    const { browser: config } = writeConsumerTsconfigs();\\n    const result = typecheck(config);\\n    expect(result.errors).toBe('');\\n    expect(result.outside, 'declarations read from outside the consumer').toEqual([]);\\n  });\\n  it('Node examples (DOM types in lib, as the Diagnostics page says)', () => {\\n    const { node: config } = writeConsumerTsconfigs();\\n    // The test example imports Vitest, a tool the consumer does not install.\\n    const result = typecheck(config, ['vitest', '@vitest', 'chai', '@types/chai', '@types/deep-eql', 'expect-type', 'tinyrainbow', '@standard-schema', 'vite', 'tinybench', 'tinyexec', 'pathe', '@types/estree', 'rollup', 'esbuild', 'postcss', 'source-map-js', 'nanoid', 'picocolors', 'lightningcss', 'rolldown', '@rolldown', '@oxc-project', 'obug', 'std-env', 'magic-string', '@jridgewell', 'estree-walker', 'fdir', 'picomatch', 'tinyglobby', 'es-module-lexer', 'why-is-node-running', 'detect-libc', 'assertion-error', '@types/node', 'undici-types']);\\n    expect(result.errors).toBe('');\\n    expect(result.outside.filter(f => /[\\\\\\\\/]node_modules[\\\\\\\\/]axylo[\\\\\\\\/]/.test(f) || /packages[\\\\\\\\/]axylo[\\\\\\\\/]/.test(f))).toEqual([]);\\n  });\\n});\\n\\nfunction tools(page: Page): Tools {\\n  const figure = (i: number) => page.locator('figure.axylo-figure').nth(i);\\n  return {\\n    page,\\n    async value(i, keys) {\\n      await figure(i).locator('.axylo-proxy').focus();\\n      for (const key of keys) await page.keyboard.press(key);\\n      await page.waitForTimeout(80);\\n      return (await figure(i).locator('.axylo-proxy').getAttribute('aria-valuetext')) ?? '';\\n    },\\n    desc: i => figure(i).evaluate(f => (f.getAttribute('aria-describedby') ?? '').split(/\\\\s+/).map(id => document.getElementById(id)?.textContent ?? '').join(' ')),\\n    name: i => figure(i).evaluate(f => f.getAttribute('aria-label') ?? (f.getAttribute('aria-labelledby') ?? '').split(/\\\\s+/).map(id => document.getElementById(id)?.textContent ?? '').join(' ').trim()),\\n    note: i => figure(i).evaluate(f => [...f.querySelectorAll('.axylo-note')].filter(e => !(e as HTMLElement).hidden).map(e => e.textContent).join('')),\\n    message: i => figure(i).evaluate(f => [...f.querySelectorAll('.axylo-message')].filter(e => !(e as HTMLElement).hidden).map(e => e.textContent).join('')),\\n    legend: i => figure(i).evaluate(f => [...f.querySelectorAll('.axylo-legend-list li')].map(e => e.textContent ?? '')),\\n    toolbar: i => figure(i).evaluate(f => [...f.querySelectorAll('.axylo-toolbar button')].map(e => e.textContent ?? '')),\\n    async table(i) {\\n      const open = figure(i).locator('.axylo-toolbar button', { hasText: /table|Tabelle/i }).first();\\n      if ((await open.getAttribute('aria-expanded')) !== 'true') await open.click();\\n      await page.waitForTimeout(100);\\n      return figure(i).evaluate(f => [...f.querySelectorAll('.axylo-table tbody tr')].map(r => [...r.children].map(c => c.textContent).join(' | ')));\\n    },\\n    text: selector => page.locator(selector).first().evaluate(e => e.textContent ?? ''),\\n    async click(selector) { await page.locator(selector).first().click(); },\\n    stroke: (i, k) => figure(i).evaluate((f, k) => {\\n      const paths = [...f.querySelectorAll('svg.axylo-svg path[style*=\\\"--axylo-series-color\\\"]')].filter(p => getComputedStyle(p).fill === 'none');\\n      return paths[k] ? getComputedStyle(paths[k]!).stroke : '';\\n    }, k),\\n    async until(fn, timeout = 8000) { await page.waitForFunction(fn, null, { timeout }); },\\n  };\\n}\\n\\ndescribe('examples render in Chrome from the packed packages', () => {\\n  it('every example has its own check, and every check an example', () => {\\n    expect(examples.map(e => e.name).filter(name => !(name in checks))).toEqual([]);\\n    expect(Object.keys(checks).filter(name => !examples.some(e => e.name === name))).toEqual([]);\\n  });\\n\\n  it.each(examples.map(example => [example.repoFile, example] as const))('%s', async (_file, example) => {\\n    const context = await browser.newContext({ viewport: { width: 760, height: 900 }, locale: 'en-US', timezoneId: 'America/Los_Angeles' });\\n    const page = await context.newPage();\\n    const problems: string[] = [];\\n    const codes = new Set<string>();\\n    page.on('pageerror', error => problems.push(`page error: ${error.message}`));\\n    page.on('console', message => {\\n      const text = message.text();\\n      for (const m of text.matchAll(/^\\\\[axylo (AX\\\\d{3})\\\\]/g)) codes.add(m[1]!);\\n      if (message.type() === 'error') problems.push(`console.error: ${text}`);\\n      if (message.type() === 'warning' && !text.startsWith('[axylo ')) problems.push(`console.warn: ${text}`);\\n    });\\n    page.on('requestfailed', request => problems.push(`request failed: ${request.url()}`));\\n    page.on('response', response => { if (response.status() >= 400) problems.push(`HTTP ${response.status()}: ${response.url()}`); });\\n    await page.goto(server.url(`examples/${example.name}.html`));\\n\\n    const check = checks[example.name]!;\\n    // Ready when the expected charts exist and each has drawn marks or shows a state message.\\n    await page.waitForFunction(count => {\\n      const figures = [...document.querySelectorAll('figure.axylo-figure')];\\n      return figures.length === count && figures.every(f =>\\n        f.querySelector('svg [style*=\\\"--axylo-series-color\\\"]') !== null ||\\n        [...f.querySelectorAll('.axylo-message')].some(m => !(m as HTMLElement).hidden && m.textContent));\\n    }, check.charts, { timeout: 15_000 });\\n    await page.evaluate(() => new Promise(resolve => { let n = 0; const tick = () => (++n < 3 ? requestAnimationFrame(tick) : resolve(null)); requestAnimationFrame(tick); }));\\n\\n    const charts = await page.evaluate(() => [...document.querySelectorAll('figure.axylo-figure')].map(f => {\\n      const labelled = f.getAttribute('aria-labelledby');\\n      const name = (f.getAttribute('aria-label') ?? '') ||\\n        (labelled ?? '').split(/\\\\s+/).map(id => document.getElementById(id)?.textContent ?? '').join(' ').trim();\\n      const marks = [...f.querySelectorAll('svg [style*=\\\"--axylo-series-color\\\"]')].filter(el => {\\n        const box = (el as SVGGraphicsElement).getBBox();\\n        return box.width > 0 || box.height > 0;\\n      }).length;\\n      const message = [...f.querySelectorAll('.axylo-message')].find(m => !(m as HTMLElement).hidden)?.textContent ?? '';\\n      return { role: f.getAttribute('role'), name, marks, message };\\n    }));\\n\\n    expect(charts.length, `${example.repoFile}: charts`).toBe(check.charts);\\n    for (const chart of charts) {\\n      expect(['group', 'img'], `${example.repoFile}: role`).toContain(chart.role);\\n      expect(chart.name, `${example.repoFile}: accessible name`).not.toBe('');\\n      if (example.noMarks) {\\n        expect(chart.message, `${example.repoFile}: a state message`).not.toBe('');\\n        expect(chart.marks, `${example.repoFile}: no marks`).toBe(0);\\n      } else {\\n        expect(chart.marks, `${example.repoFile}: \\\"${chart.name}\\\" draws marks (message: \\\"${chart.message}\\\")`).toBeGreaterThan(0);\\n      }\\n    }\\n    await check.run(tools(page));\\n    expect(problems, `${example.repoFile}: errors`).toEqual([]);\\n    expect([...codes].sort(), `${example.repoFile}: diagnostics printed`).toEqual([...example.raises].sort());\\n    await context.close();\\n  }, 60_000);\\n});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nreviews/2026-11-18/impl/wp/matrix-review.review.events.jsonl:143:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_70\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'git show d9fa4b0:apps/docs/test/node.browser.test.ts'\",\"aggregated_output\":\"/**\\n * Runs in Node, after `npm run build`, with the browser suite (it needs the packed packages, not a browser).\\n * The Node examples quoted on the Diagnostics page (apps/docs/examples/node, copied into the packed consumer)\\n * run against the installed tarball: validate.ts as a script, chart-data.test.ts as a Vitest test in a run of\\n * its own rooted in the consumer.\\n */\\nimport { beforeAll, describe, expect, it } from 'vitest';\\nimport { execFileSync } from 'node:child_process';\\nimport fs from 'node:fs';\\nimport path from 'node:path';\\nimport { createRequire } from 'node:module';\\nimport { buildSite } from '../lib/site.mjs';\\nimport { repoRoot } from '../lib/examples.mjs';\\nimport { consumerDir, installed } from '../lib/consumer.mjs';\\n\\nbeforeAll(async () => { await buildSite(); }, 180_000);\\n\\ndescribe('Node examples, against the packed package', () => {\\n  it('validate.ts runs and finds nothing blocking', () => {\\n    const out = execFileSync(process.execPath, ['--experimental-strip-types', '--no-warnings', path.join(consumerDir, 'src/node/validate.ts')], { cwd: consumerDir, encoding: 'utf8' });\\n    expect(out.trim()).toBe('Checked \\\"Orders per day\\\": 0 diagnostics, none blocking.');\\n  });\\n\\n  it('chart-data.test.ts passes as a test', () => {\\n    fs.writeFileSync(path.join(consumerDir, 'vitest.config.mjs'), \\\"export default { test: { include: ['src/node/*.test.ts'] } };\\\\n\\\");\\n    const vitest = path.join(repoRoot, 'node_modules/vitest/vitest.mjs');\\n    const out = execFileSync(process.execPath, [vitest, 'run', '--root', consumerDir, '--config', path.join(consumerDir, 'vitest.config.mjs')], { cwd: consumerDir, encoding: 'utf8', env: { ...process.env, AXYLO_BROWSER: '' } });\\n    expect(out).toMatch(/Tests\\\\s+1 passed \\\\(1\\\\)/);\\n  });\\n\\n  it('the example resolves the installed tarball, not the workspace', () => {\\n    const require = createRequire(path.join(consumerDir, 'src/node/validate.ts'));\\n    const resolved = fs.realpathSync(require.resolve('axylo'));\\n    expect(path.dirname(path.dirname(resolved))).toBe(fs.realpathSync(installed('axylo')));\\n  });\\n});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nreviews/2026-11-18/impl/wp/docs.review.events.jsonl:32:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_14\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc 'for f in apps/docs/lib/{markdown,site,examples}.mjs apps/docs/build.mjs; do echo $f; nl -ba \\\"$f\\\"; done'\",\"aggregated_output\":\"apps/docs/lib/markdown.mjs\\n     1\\t/**\\n     2\\t * The Markdown subset the documentation pages use, and nothing more: ATX headings (# to ####), paragraphs,\\n     3\\t * fenced code blocks, pipe tables, flat bulleted and numbered lists, block quotes, whole-line HTML comments\\n     4\\t * (dropped), and the inline forms `code`, **strong**, *emphasis*, [links](url) and backslash escapes.\\n     5\\t *\\n     6\\t * Raw HTML is never passed through: every character of text is escaped, so a page cannot inject markup\\n     7\\t * (and neither can data quoted into a page). A line that is only a link whose text starts with `example:`,\\n     8\\t * `source:` or `table:` is a directive; the caller decides what it becomes.\\n     9\\t */\\n    10\\t\\n    11\\tconst ESCAPES = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\\\"': '&quot;', \\\"'\\\": '&#39;' };\\n    12\\t\\n    13\\t/** Escapes text for HTML element content and quoted attribute values. */\\n    14\\texport function escapeHtml(text) {\\n    15\\t  return String(text).replace(/[&<>\\\"']/g, c => ESCAPES[c]);\\n    16\\t}\\n    17\\t\\n    18\\t/**\\n    19\\t * A heading's id, made the way GitHub makes it, so that a link to `data.md#three-kinds-of-time` works on a\\n    20\\t * code host and on the site alike: lower case, punctuation dropped, each space a hyphen.\\n    21\\t */\\n    22\\texport function slug(text) {\\n    23\\t  return plainText(text).trim().toLowerCase().replace(/[^\\\\p{L}\\\\p{N}\\\\s_-]/gu, '').replace(/\\\\s/g, '-') || 'section';\\n    24\\t}\\n    25\\t\\n    26\\t/** The text a reader sees in inline Markdown: markers and link targets removed. */\\n    27\\texport function plainText(text) {\\n    28\\t  return text\\n    29\\t    .replace(/\\\\\\\\([\\\\\\\\`*_[\\\\]()|#<>!-])/g, '$1')\\n    30\\t    .replace(/`([^`]*)`/g, '$1')\\n    31\\t    .replace(/\\\\[([^\\\\]]*)\\\\]\\\\([^)]*\\\\)/g, '$1')\\n    32\\t    .replace(/\\\\*\\\\*([^*]+)\\\\*\\\\*/g, '$1')\\n    33\\t    .replace(/\\\\*([^*]+)\\\\*/g, '$1');\\n    34\\t}\\n    35\\t\\n    36\\tconst DIRECTIVE = /^\\\\[(example|source|table):\\\\s*([^\\\\]]+)\\\\]\\\\(([^)\\\\s]+)\\\\)$/;\\n    37\\tconst FENCE = /^(`{3,})\\\\s*([\\\\w-]*)\\\\s*$/;\\n    38\\tconst HEADING = /^(#{1,4})\\\\s+(.+?)\\\\s*#*\\\\s*$/;\\n    39\\tconst BULLET = /^[-*]\\\\s+(.*)$/;\\n    40\\tconst NUMBERED = /^(\\\\d+)\\\\.\\\\s+(.*)$/;\\n    41\\tconst TABLE_RULE = /^\\\\|?\\\\s*:?-{3,}:?\\\\s*(\\\\|\\\\s*:?-{3,}:?\\\\s*)*\\\\|?\\\\s*$/;\\n    42\\tconst COMMENT = /^<!--.*-->$/;\\n    43\\t\\n    44\\t/**\\n    45\\t * Converts `source` to HTML.\\n    46\\t * - `link(url)` rewrites a link target (for example `data.md#gaps` to `data.html#gaps`).\\n    47\\t * - `directive({ kind, name, target })` returns the HTML for a directive line.\\n    48\\t * - `headings` receives each heading as { level, text, id } in order.\\n    49\\t */\\n    50\\texport function markdownToHtml(source, { link = url => url, directive, headings = [] } = {}) {\\n    51\\t  const lines = source.replace(/\\\\r\\\\n?/g, '\\\\n').split('\\\\n');\\n    52\\t  const used = new Map();\\n    53\\t  const out = [];\\n    54\\t  const inline = text => renderInline(text, link);\\n    55\\t  // Each table's scroll region is named after the heading it sits under, so that no two share a name.\\n    56\\t  let section = null;\\n    57\\t  const tableNames = new Map();\\n    58\\t  const tableName = () => {\\n    59\\t    const n = (tableNames.get(section) ?? 0) + 1;\\n    60\\t    tableNames.set(section, n);\\n    61\\t    const table = n === 1 ? 'Table' : `Table ${n}`;\\n    62\\t    return section === null ? table : `${table}: ${section}`;\\n    63\\t  };\\n    64\\t\\n    65\\t  let i = 0;\\n    66\\t  while (i < lines.length) {\\n    67\\t    const line = lines[i];\\n    68\\t    if (line.trim() === '' || COMMENT.test(line.trim())) { i++; continue; }\\n    69\\t\\n    70\\t    const fence = FENCE.exec(line);\\n    71\\t    if (fence) {\\n    72\\t      const body = [];\\n    73\\t      i++;\\n    74\\t      while (i < lines.length && !lines[i].startsWith(fence[1])) body.push(lines[i++]);\\n    75\\t      if (i < lines.length) i++;\\n    76\\t      out.push(codeBlock(body.join('\\\\n'), fence[2]));\\n    77\\t      continue;\\n    78\\t    }\\n    79\\t\\n    80\\t    const heading = HEADING.exec(line);\\n    81\\t    if (heading) {\\n    82\\t      const level = heading[1].length;\\n    83\\t      const base = slug(heading[2]);\\n    84\\t      const n = (used.get(base) ?? 0) + 1;\\n    85\\t      used.set(base, n);\\n    86\\t      const id = n === 1 ? base : `${base}-${n}`;\\n    87\\t      headings.push({ level, text: plainText(heading[2]), id });\\n    88\\t      section = plainText(heading[2]);\\n    89\\t      out.push(`<h${level} id=\\\"${escapeHtml(id)}\\\">${inline(heading[2])}</h${level}>`);\\n    90\\t      i++;\\n    91\\t      continue;\\n    92\\t    }\\n    93\\t\\n    94\\t    if (line.startsWith('|') && i + 1 < lines.length && TABLE_RULE.test(lines[i + 1])) {\\n    95\\t      const rows = [];\\n    96\\t      const align = splitRow(lines[i + 1]).map(cell => cell.endsWith(':') ? (cell.startsWith(':') ? 'center' : 'right') : null);\\n    97\\t      const header = splitRow(line);\\n    98\\t      i += 2;\\n    99\\t      while (i < lines.length && lines[i].startsWith('|')) rows.push(splitRow(lines[i++]));\\n   100\\t      out.push(table(header, rows, align, inline, tableName()));\\n   101\\t      continue;\\n   102\\t    }\\n   103\\t\\n   104\\t    if (line.startsWith('>')) {\\n   105\\t      const body = [];\\n   106\\t      while (i < lines.length && lines[i].startsWith('>')) body.push(lines[i++].replace(/^>\\\\s?/, ''));\\n   107\\t      out.push(`<blockquote>${markdownToHtml(body.join('\\\\n'), { link, directive, headings: [] })}</blockquote>`);\\n   108\\t      continue;\\n   109\\t    }\\n   110\\t\\n   111\\t    const bullet = BULLET.exec(line);\\n   112\\t    const numbered = NUMBERED.exec(line);\\n   113\\t    if (bullet || numbered) {\\n   114\\t      const ordered = !bullet;\\n   115\\t      const marker = ordered ? NUMBERED : BULLET;\\n   116\\t      const items = [];\\n   117\\t      const start = ordered ? Number(numbered[1]) : 1;\\n   118\\t      while (i < lines.length) {\\n   119\\t        const m = marker.exec(lines[i]);\\n   120\\t        if (m) { items.push(ordered ? m[2] : m[1]); i++; continue; }\\n   121\\t        // A continuation line is indented; a blank line or anything else ends the list.\\n   122\\t        if (/^\\\\s{2,}\\\\S/.test(lines[i]) && items.length) { items[items.length - 1] += ' ' + lines[i].trim(); i++; continue; }\\n   123\\t        break;\\n   124\\t      }\\n   125\\t      const tag = ordered ? 'ol' : 'ul';\\n   126\\t      const startAttr = ordered && start !== 1 ? ` start=\\\"${start}\\\"` : '';\\n   127\\t      out.push(`<${tag}${startAttr}>${items.map(item => `<li>${inline(item)}</li>`).join('')}</${tag}>`);\\n   128\\t      continue;\\n   129\\t    }\\n   130\\t\\n   131\\t    const paragraph = [];\\n   132\\t    while (i < lines.length && lines[i].trim() !== '' && !startsBlock(lines, i)) paragraph.push(lines[i++].trim());\\n   133\\t    if (paragraph.length === 0) { paragraph.push(line.trim()); i++; }\\n   134\\t    const text = paragraph.join(' ');\\n   135\\t    const d = paragraph.length === 1 ? DIRECTIVE.exec(text) : null;\\n   136\\t    if (d && directive) {\\n   137\\t      out.push(directive({ kind: d[1], name: d[2].trim(), target: d[3] }));\\n   138\\t    } else {\\n   139\\t      out.push(`<p>${inline(text)}</p>`);\\n   140\\t    }\\n   141\\t  }\\n   142\\t  return out.join('\\\\n');\\n   143\\t}\\n   144\\t\\n   145\\tfunction startsBlock(lines, i) {\\n   146\\t  const line = lines[i];\\n   147\\t  return FENCE.test(line) || HEADING.test(line) || line.startsWith('>') || BULLET.test(line) || NUMBERED.test(line) ||\\n   148\\t    COMMENT.test(line.trim()) || (line.startsWith('|') && i + 1 < lines.length && TABLE_RULE.test(lines[i + 1]));\\n   149\\t}\\n   150\\t\\n   151\\t/** Splits a table row on pipes that are not escaped; `\\\\|` stays in the cell as a literal pipe. */\\n   152\\texport function splitRow(line) {\\n   153\\t  const cells = [];\\n   154\\t  let cell = '';\\n   155\\t  const body = line.trim().replace(/^\\\\|/, '').replace(/(?<!\\\\\\\\)\\\\|$/, '');\\n   156\\t  for (let i = 0; i < body.length; i++) {\\n   157\\t    const c = body[i];\\n   158\\t    if (c === '\\\\\\\\' && body[i + 1] === '|') { cell += '\\\\\\\\|'; i++; continue; }\\n   159\\t    if (c === '|') { cells.push(cell.trim()); cell = ''; continue; }\\n   160\\t    cell += c;\\n   161\\t  }\\n   162\\t  cells.push(cell.trim());\\n   163\\t  return cells;\\n   164\\t}\\n   165\\t\\n   166\\tfunction table(header, rows, align, inline, name = 'Table') {\\n   167\\t  const style = index => align[index] ? ` style=\\\"text-align: ${align[index]}\\\"` : '';\\n   168\\t  const head = header.map((cell, index) => `<th scope=\\\"col\\\"${style(index)}>${inline(cell)}</th>`).join('');\\n   169\\t  const body = rows.map(row => `<tr>${header.map((_, index) => `<td${style(index)}>${inline(row[index] ?? '')}</td>`).join('')}</tr>`).join('');\\n   170\\t  // The wrapper scrolls a wide table on a narrow screen, so the page itself never scrolls sideways.\\n   171\\t  return `<div class=\\\"table-scroll\\\" tabindex=\\\"0\\\" role=\\\"region\\\" aria-label=\\\"${escapeHtml(name)}\\\"><table><thead><tr>${head}</tr></thead><tbody>${body}</tbody></table></div>`;\\n   172\\t}\\n   173\\t\\n   174\\texport function codeBlock(code, language = '') {\\n   175\\t  const cls = language ? ` class=\\\"language-${escapeHtml(language)}\\\"` : '';\\n   176\\t  return `<pre tabindex=\\\"0\\\"><code${cls}>${escapeHtml(code)}</code></pre>`;\\n   177\\t}\\n   178\\t\\n   179\\t/** Inline Markdown to HTML. Unmatched markers are kept as text. */\\n   180\\texport function renderInline(text, link = url => url) {\\n   181\\t  let out = '';\\n   182\\t  let i = 0;\\n   183\\t  while (i < text.length) {\\n   184\\t    const c = text[i];\\n   185\\t    if (c === '\\\\\\\\' && i + 1 < text.length && /[\\\\\\\\`*_[\\\\]()|#<>!-]/.test(text[i + 1])) {\\n   186\\t      out += escapeHtml(text[i + 1]);\\n   187\\t      i += 2;\\n   188\\t      continue;\\n   189\\t    }\\n   190\\t    if (c === '`') {\\n   191\\t      let run = 1;\\n   192\\t      while (text[i + run] === '`') run++;\\n   193\\t      const fence = '`'.repeat(run);\\n   194\\t      const end = text.indexOf(fence, i + run);\\n   195\\t      if (end !== -1) {\\n   196\\t        // Inside a table cell a literal pipe is written `\\\\|`; the backslash is not part of the code.\\n   197\\t        const code = text.slice(i + run, end).replace(/\\\\\\\\\\\\|/g, '|');\\n   198\\t        out += `<code>${escapeHtml(run > 1 ? code.trim() : code)}</code>`;\\n   199\\t        i = end + run;\\n   200\\t        continue;\\n   201\\t      }\\n   202\\t    }\\n   203\\t    if (c === '[') {\\n   204\\t      const close = matchBracket(text, i);\\n   205\\t      if (close !== -1 && text[close + 1] === '(') {\\n   206\\t        const end = text.indexOf(')', close + 2);\\n   207\\t        if (end !== -1) {\\n   208\\t          const label = text.slice(i + 1, close);\\n   209\\t          const url = text.slice(close + 2, end).trim();\\n   210\\t          out += `<a href=\\\"${escapeHtml(link(url))}\\\">${renderInline(label, link)}</a>`;\\n   211\\t          i = end + 1;\\n   212\\t          continue;\\n   213\\t        }\\n   214\\t      }\\n   215\\t    }\\n   216\\t    if (c === '*' && text[i + 1] === '*') {\\n   217\\t      const end = text.indexOf('**', i + 2);\\n   218\\t      if (end > i + 2) {\\n   219\\t        out += `<strong>${renderInline(text.slice(i + 2, end), link)}</strong>`;\\n   220\\t        i = end + 2;\\n   221\\t        continue;\\n   222\\t      }\\n   223\\t    }\\n   224\\t    if (c === '*' && text[i + 1] !== ' ' && text[i + 1] !== '*') {\\n   225\\t      const end = text.indexOf('*', i + 1);\\n   226\\t      if (end > i + 1 && text[end - 1] !== ' ') {\\n   227\\t        out += `<em>${renderInline(text.slice(i + 1, end), link)}</em>`;\\n   228\\t        i = end + 1;\\n   229\\t        continue;\\n   230\\t      }\\n   231\\t    }\\n   232\\t    out += escapeHtml(c);\\n   233\\t    i++;\\n   234\\t  }\\n   235\\t  return out;\\n   236\\t}\\n   237\\t\\n   238\\tfunction matchBracket(text, open) {\\n   239\\t  let depth = 0;\\n   240\\t  for (let i = open; i < text.length; i++) {\\n   241\\t    if (text[i] === '\\\\\\\\') { i++; continue; }\\n   242\\t    if (text[i] === '`') {\\n   243\\t      const end = text.indexOf('`', i + 1);\\n   244\\t      if (end !== -1) { i = end; continue; }\\n   245\\t    }\\n   246\\t    if (text[i] === '[') depth++;\\n   247\\t    if (text[i] === ']' && --depth === 0) return i;\\n   248\\t  }\\n   249\\t  return -1;\\n   250\\t}\\n   251\\t\\n   252\\t/** Words of prose in a page, for the report: code blocks, comments and table rules are not counted. */\\n   253\\texport function wordCount(source) {\\n   254\\t  let inCode = false;\\n   255\\t  let words = 0;\\n   256\\t  for (const line of source.split('\\\\n')) {\\n   257\\t    if (FENCE.test(line)) { inCode = !inCode; continue; }\\n   258\\t    if (inCode || COMMENT.test(line.trim()) || TABLE_RULE.test(line) || DIRECTIVE.test(line.trim())) continue;\\n   259\\t    words += plainText(line.replace(/\\\\|/g, ' ')).split(/\\\\s+/).filter(w => /[\\\\p{L}\\\\p{N}]/u.test(w)).length;\\n   260\\t  }\\n   261\\t  return words;\\n   262\\t}\\napps/docs/lib/site.mjs\\n     1\\t/**\\n     2\\t * Builds the documentation site into apps/docs/dist from the Markdown pages, the runnable examples, the\\n     3\\t * diagnostics data file and the library's built files (packages/axylo/dist, packages/react/dist).\\n     4\\t *\\n     5\\t * Every example runs live in its own page (dist/examples/<name>.html) against the built library, loaded\\n     6\\t * through an import map, and is embedded in the documentation page beside its source. Each example page is\\n     7\\t * its own document so that its ids, its console and Axylo's once-per-page printing of diagnostics belong to\\n     8\\t * that example alone; the browser test opens the same pages.\\n     9\\t */\\n    10\\timport fs from 'node:fs';\\n    11\\timport path from 'node:path';\\n    12\\timport { createRequire } from 'node:module';\\n    13\\timport { pathToFileURL } from 'node:url';\\n    14\\timport { build } from 'esbuild';\\n    15\\timport { escapeHtml, markdownToHtml, codeBlock, renderInline, wordCount, slug } from './markdown.mjs';\\n    16\\timport { cacheDir, docsRoot, listExamples, repoRoot } from './examples.mjs';\\n    17\\timport { nav, pages } from '../data/nav.mjs';\\n    18\\t\\n    19\\tconst libDist = path.join(repoRoot, 'packages/axylo/dist');\\n    20\\tconst reactDist = path.join(repoRoot, 'packages/react/dist');\\n    21\\tconst pagesDir = path.join(docsRoot, 'pages');\\n    22\\tconst siteDir = path.join(docsRoot, 'site');\\n    23\\t\\n    24\\tconst REQUIRED = [\\n    25\\t  [libDist, ['axylo.js', 'axylo.dev.js', 'axylo.iife.js', 'axylo.iife.min.js', 'axylo.css', 'index.d.ts']],\\n    26\\t  [reactDist, ['index.js', 'index.dev.js', 'index.d.ts']],\\n    27\\t];\\n    28\\t\\n    29\\t/** Fails with the command to run when the library has not been built. */\\n    30\\texport function checkLibraryBuilt() {\\n    31\\t  const missing = REQUIRED.flatMap(([dir, files]) => files.map(f => path.join(dir, f)).filter(f => !fs.existsSync(f)));\\n    32\\t  if (missing.length) {\\n    33\\t    throw new Error(`The library is not built (missing ${missing.map(f => path.relative(repoRoot, f)).join(', ')}). Run \\\\`npm run build\\\\` first.`);\\n    34\\t  }\\n    35\\t}\\n    36\\t\\n    37\\t/** Bundles a TypeScript source of the library and imports it, to read data the built bundle does not export. */\\n    38\\texport async function importSource(relative) {\\n    39\\t  const result = await build({\\n    40\\t    entryPoints: [path.join(repoRoot, relative)], bundle: true, format: 'esm', write: false, platform: 'neutral',\\n    41\\t    define: { __DEV__: 'true' }, logLevel: 'silent',\\n    42\\t  });\\n    43\\t  return import('data:text/javascript;base64,' + Buffer.from(result.outputFiles[0].contents).toString('base64'));\\n    44\\t}\\n    45\\t\\n    46\\t/**\\n    47\\t * The default token values of the built stylesheet, per scheme: `--axylo-default-axis` → `#5f6470`. Read from\\n    48\\t * dist/axylo.css, so the site shows what ships.\\n    49\\t */\\n    50\\texport function readThemeDefaults(css = fs.readFileSync(path.join(libDist, 'axylo.css'), 'utf8')) {\\n    51\\t  const block = selector => {\\n    52\\t    const at = css.indexOf(selector + ' {');\\n    53\\t    if (at === -1) throw new Error(`axylo.css has no \\\"${selector}\\\" block`);\\n    54\\t    const body = css.slice(at + selector.length + 2, css.indexOf('}', at));\\n    55\\t    return Object.fromEntries([...body.matchAll(/(--axylo-default-[\\\\w-]+):\\\\s*([^;]+);/g)].map(m => [m[1], m[2].trim()]));\\n    56\\t  };\\n    57\\t  return { light: block('.axylo'), dark: block('.axylo[data-axylo-scheme=\\\"dark\\\"]') };\\n    58\\t}\\n    59\\t\\n    60\\tconst HEX = /^#[0-9a-f]{3,8}$/i;\\n    61\\t\\n    62\\texport async function buildSite({ outDir = path.join(docsRoot, 'dist'), log = () => {} } = {}) {\\n    63\\t  checkLibraryBuilt();\\n    64\\t  const warnings = [];\\n    65\\t  fs.rmSync(outDir, { recursive: true, force: true });\\n    66\\t  for (const dir of ['assets/vendor', 'examples', 'diagnostics']) fs.mkdirSync(path.join(outDir, dir), { recursive: true });\\n    67\\t\\n    68\\t  const theme = readThemeDefaults();\\n    69\\t  writeAssets(outDir, theme);\\n    70\\t  await buildVendor(outDir);\\n    71\\t  const examples = await buildExamples(outDir);\\n    72\\t  const { diagnostics } = await import(pathToFileURL(path.join(docsRoot, 'data/diagnostics.mjs')).href + `?t=${Date.now()}`);\\n    73\\t  const { tokens, internalTokens } = await import(pathToFileURL(path.join(docsRoot, 'data/tokens.mjs')).href + `?t=${Date.now()}`);\\n    74\\t  const messages = (await importSource('packages/axylo/src/messages/index.ts')).defaultMessages;\\n    75\\t  const seen = await diagnosticOutput(diagnostics);\\n    76\\t  const version = JSON.parse(fs.readFileSync(path.join(repoRoot, 'packages/axylo/package.json'), 'utf8')).version;\\n    77\\t\\n    78\\t  const context = { outDir, examples, diagnostics, seen, tokens, internalTokens, messages, theme, warnings, version };\\n    79\\t  const report = [];\\n    80\\t  for (const [index, entry] of pages.entries()) {\\n    81\\t    const file = path.join(pagesDir, `${entry.page}.md`);\\n    82\\t    const source = fs.readFileSync(file, 'utf8');\\n    83\\t    const html = renderPage(entry, source, index, context);\\n    84\\t    fs.writeFileSync(path.join(outDir, `${entry.page}.html`), html);\\n    85\\t    report.push({ page: entry.page, words: wordCount(source) });\\n    86\\t  }\\n    87\\t  for (const d of diagnostics) {\\n    88\\t    fs.writeFileSync(path.join(outDir, 'diagnostics', `${d.code}.html`), renderDiagnosticPage(d, context));\\n    89\\t  }\\n    90\\t  const broken = checkLinks(outDir);\\n    91\\t  if (broken.length) throw new Error('Broken links:\\\\n' + broken.join('\\\\n'));\\n    92\\t  for (const w of warnings) log('warning: ' + w);\\n    93\\t  return { pages: report, examples, warnings, diagnostics: diagnostics.length };\\n    94\\t}\\n    95\\t\\n    96\\t// ---------- assets ----------\\n    97\\t\\n    98\\tfunction writeAssets(outDir, theme) {\\n    99\\t  const pick = (scheme, name) => {\\n   100\\t    const value = theme[scheme][`--axylo-default-${name}`];\\n   101\\t    if (!value || !HEX.test(value)) throw new Error(`axylo.css: no colour for --axylo-default-${name} (${scheme})`);\\n   102\\t    return value;\\n   103\\t  };\\n   104\\t  // The site's surfaces use the chart's own default tokens, so the pages and the charts match.\\n   105\\t  const vars = scheme => ['background', 'axis', 'grid', 'muted', 'focus', 'reference']\\n   106\\t    .map(name => `  --site-${name}: ${pick(scheme, name)};`).join('\\\\n');\\n   107\\t  const tokens = `/* Generated from packages/axylo/dist/axylo.css by apps/docs/lib/site.mjs. */\\n   108\\t:root {\\n   109\\t${vars('light')}\\n   110\\t}\\n   111\\t@media (prefers-color-scheme: dark) {\\n   112\\t  :root {\\n   113\\t${vars('dark')}\\n   114\\t  }\\n   115\\t}\\n   116\\t`;\\n   117\\t  fs.writeFileSync(path.join(outDir, 'assets/site.css'), tokens + fs.readFileSync(path.join(siteDir, 'site.css'), 'utf8'));\\n   118\\t  for (const file of ['page.js', 'frame.js']) fs.copyFileSync(path.join(siteDir, file), path.join(outDir, 'assets', file));\\n   119\\t  // The development flavour, so example pages print hints as an application in development would.\\n   120\\t  fs.copyFileSync(path.join(libDist, 'axylo.dev.js'), path.join(outDir, 'assets/axylo.js'));\\n   121\\t  fs.copyFileSync(path.join(reactDist, 'index.dev.js'), path.join(outDir, 'assets/axylo-react.js'));\\n   122\\t  // Next to the example pages, so the script-tag example reads `<script src=\\\"axylo.iife.js\\\">` as a reader would write it.\\n   123\\t  fs.copyFileSync(path.join(libDist, 'axylo.iife.js'), path.join(outDir, 'examples/axylo.iife.js'));\\n   124\\t  fs.copyFileSync(path.join(libDist, 'axylo.css'), path.join(outDir, 'examples/axylo.css'));\\n   125\\t}\\n   126\\t\\n   127\\t/**\\n   128\\t * React and React DOM as ES modules for the import map. Both packages are CommonJS, so each entry is a small\\n   129\\t * module that re-exports the names the package has, read from the package itself.\\n   130\\t */\\n   131\\tasync function buildVendor(outDir) {\\n   132\\t  const require = createRequire(path.join(repoRoot, 'package.json'));\\n   133\\t  const dir = path.join(cacheDir, 'vendor');\\n   134\\t  fs.mkdirSync(dir, { recursive: true });\\n   135\\t  const entries = { react: 'react', 'jsx-runtime': 'react/jsx-runtime', 'react-dom-client': 'react-dom/client' };\\n   136\\t  const entryPoints = {};\\n   137\\t  for (const [out, specifier] of Object.entries(entries)) {\\n   138\\t    const names = Object.keys(require(specifier)).filter(n => /^[A-Za-z_$][\\\\w$]*$/.test(n) && n !== 'default');\\n   139\\t    const file = path.join(dir, `${out}.mjs`);\\n   140\\t    fs.writeFileSync(file, `import m from '${specifier}';\\\\nexport default m;\\\\n${names.map(n => `export const ${n} = m.${n};`).join('\\\\n')}\\\\n`);\\n   141\\t    entryPoints[out] = file;\\n   142\\t  }\\n   143\\t  await build({\\n   144\\t    entryPoints, bundle: true, format: 'esm', splitting: true, outdir: path.join(outDir, 'assets/vendor'), target: 'es2022',\\n   145\\t    define: { 'process.env.NODE_ENV': '\\\"development\\\"' }, logLevel: 'warning', nodePaths: [path.join(repoRoot, 'node_modules')],\\n   146\\t    absWorkingDir: repoRoot,\\n   147\\t  });\\n   148\\t}\\n   149\\t\\n   150\\t// ---------- examples ----------\\n   151\\t\\n   152\\tconst IMPORT_MAP = JSON.stringify({ imports: {\\n   153\\t  axylo: '../assets/axylo.js',\\n   154\\t  '@axylo/react': '../assets/axylo-react.js',\\n   155\\t  react: '../assets/vendor/react.js',\\n   156\\t  'react/jsx-runtime': '../assets/vendor/jsx-runtime.js',\\n   157\\t  'react-dom/client': '../assets/vendor/react-dom-client.js',\\n   158\\t} }, null, 2);\\n   159\\t\\n   160\\tasync function buildExamples(outDir) {\\n   161\\t  const examples = listExamples();\\n   162\\t  const compiled = examples.filter(e => e.ext !== 'html');\\n   163\\t  if (compiled.length) {\\n   164\\t    await build({\\n   165\\t      entryPoints: compiled.map(e => path.join(docsRoot, 'examples', e.file)), bundle: true, format: 'esm', target: 'es2022',\\n   166\\t      outdir: path.join(outDir, 'examples'), jsx: 'automatic', logLevel: 'warning',\\n   167\\t      external: ['axylo', '@axylo/react', 'react', 'react/jsx-runtime', 'react-dom', 'react-dom/client'],\\n   168\\t    });\\n   169\\t  }\\n   170\\t  const manifest = [];\\n   171\\t  for (const e of examples) {\\n   172\\t    fs.writeFileSync(path.join(outDir, 'examples', `${e.name}.html`), examplePage(e));\\n   173\\t    manifest.push({ name: e.name, file: e.file, ext: e.ext, raises: e.raises, noMarks: e.noMarks });\\n   174\\t  }\\n   175\\t  fs.writeFileSync(path.join(outDir, 'examples/manifest.json'), JSON.stringify(manifest, null, 2));\\n   176\\t  return manifest;\\n   177\\t}\\n   178\\t\\n   179\\tfunction examplePage(e) {\\n   180\\t  // An .html example's own <style> goes to the head, where it belongs; the reader sees it in the source as written.\\n   181\\t  const styles = e.ext === 'html' ? [...e.source.matchAll(/<style>[\\\\s\\\\S]*?<\\\\/style>\\\\n?/g)].map(m => m[0]).join('') : '';\\n   182\\t  const body = e.ext === 'html'\\n   183\\t    ? e.source.replace(/<style>[\\\\s\\\\S]*?<\\\\/style>\\\\n?/g, '')\\n   184\\t    : e.ext === 'tsx'\\n   185\\t      ? '<div id=\\\"root\\\"></div>\\\\n<script type=\\\"module\\\" src=\\\"' + e.name + '.js\\\"></script>'\\n   186\\t      : e.targets.map(id => `<div id=\\\"${escapeHtml(id)}\\\" class=\\\"example-target\\\"></div>`).join('\\\\n') +\\n   187\\t        `\\\\n<script type=\\\"module\\\" src=\\\"${e.name}.js\\\"></script>`;\\n   188\\t  return `<!doctype html>\\n   189\\t<html lang=\\\"en\\\">\\n   190\\t<head>\\n   191\\t<meta charset=\\\"utf-8\\\">\\n   192\\t<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n   193\\t<meta name=\\\"color-scheme\\\" content=\\\"light dark\\\">\\n   194\\t<title>Example: ${escapeHtml(e.name)}</title>\\n   195\\t<link rel=\\\"icon\\\" href=\\\"data:,\\\">\\n   196\\t<link rel=\\\"stylesheet\\\" href=\\\"../assets/site.css\\\">\\n   197\\t<script type=\\\"importmap\\\">\\n   198\\t${IMPORT_MAP}\\n   199\\t</script>\\n   200\\t<script src=\\\"../assets/frame.js\\\" defer></script>\\n   201\\t${styles}</head>\\n   202\\t<body class=\\\"example-page\\\">\\n   203\\t${body}\\n   204\\t</body>\\n   205\\t</html>\\n   206\\t`;\\n   207\\t}\\n   208\\t\\n   209\\t// ---------- pages ----------\\n   210\\t\\n   211\\tfunction renderPage(entry, source, index, ctx) {\\n   212\\t  const headings = [];\\n   213\\t  const where = path.join(pagesDir, `${entry.page}.md`);\\n   214\\t  const body = markdownToHtml(source, {\\n   215\\t    headings,\\n   216\\t    link: url => pageLink(url),\\n   217\\t    directive: d => directive(d, where, ctx),\\n   218\\t  });\\n   219\\t  const title = headings.find(h => h.level === 1)?.text ?? entry.label;\\n   220\\t  const prev = pages[index - 1];\\n   221\\t  const next = pages[index + 1];\\n   222\\t  const pager = `<nav class=\\\"pager\\\" aria-label=\\\"Previous and next page\\\">${prev ? `<a rel=\\\"prev\\\" href=\\\"${prev.page}.html\\\">← ${escapeHtml(prev.label)}</a>` : '<span></span>'}${next ? `<a rel=\\\"next\\\" href=\\\"${next.page}.html\\\">${escapeHtml(next.label)} →</a>` : ''}</nav>`;\\n   223\\t  return layout({\\n   224\\t    title, body: body + pager, current: entry.page, base: '', ctx,\\n   225\\t    sourcePath: `apps/docs/pages/${entry.page}.md`,\\n   226\\t  });\\n   227\\t}\\n   228\\t\\n   229\\tconst PAGE_NAMES = new Set(pages.map(p => p.page));\\n   230\\t\\n   231\\t/** Rewrites a link written for the Markdown sources (readable on a code host) to its place in the site. */\\n   232\\texport function pageLink(url, base = '') {\\n   233\\t  if (/^[a-z]+:/i.test(url) || url.startsWith('#')) return url;\\n   234\\t  const [file, hash] = url.split('#');\\n   235\\t  const code = file === 'diagnostics.md' && hash && /^ax\\\\d{3}$/i.test(hash) ? hash.toUpperCase() : null;\\n   236\\t  if (code) return `${base}diagnostics/${code}.html`;\\n   237\\t  const name = file.endsWith('.md') && !file.includes('/') ? file.slice(0, -3) : null;\\n   238\\t  if (name !== null && PAGE_NAMES.has(name)) return `${base}${name}.html${hash ? '#' + hash : ''}`;\\n   239\\t  // A path into the repository: pages/ and dist/ sit at the same depth, so it resolves the same from both\\n   240\\t  // when the site is served from the repository root.\\n   241\\t  return base + url;\\n   242\\t}\\n   243\\t\\n   244\\tfunction directive({ kind, name, target }, where, ctx) {\\n   245\\t  if (kind === 'example') return exampleBlock(name, target, where, ctx);\\n   246\\t  if (kind === 'source') return sourceBlock(name, target, where, ctx);\\n   247\\t  if (kind === 'table') return generatedTable(name, ctx);\\n   248\\t  throw new Error(`Unknown directive ${kind}`);\\n   249\\t}\\n   250\\t\\n   251\\tfunction exampleBlock(name, target, where, ctx) {\\n   252\\t  const file = path.resolve(path.dirname(where), target);\\n   253\\t  const example = ctx.examples.find(e => path.join(docsRoot, 'examples', e.file) === file);\\n   254\\t  if (!example) throw new Error(`${path.relative(repoRoot, where)}: example ${target} does not exist`);\\n   255\\t  if (example.name !== name) throw new Error(`${path.relative(repoRoot, where)}: example link text \\\"${name}\\\" does not match ${example.file}`);\\n   256\\t  const source = fs.readFileSync(file, 'utf8');\\n   257\\t  const targets = example.ext === 'ts' ? Math.max(1, (source.match(/\\\\b(?:line|area|bar|scatter|donut)\\\\(\\\\s*['\\\"]#/g) ?? []).length) : 1;\\n   258\\t  const raises = example.raises.length\\n   259\\t    ? `<p class=\\\"example-note\\\">This example raises ${listText(example.raises.map(c => `<a href=\\\"diagnostics/${c}.html\\\">${c}</a>`))} on purpose.</p>`\\n   260\\t    : '';\\n   261\\t  const height = example.ext === 'ts' ? targets * 470 : 470;\\n   262\\t  return `<figure class=\\\"example\\\" id=\\\"example-${escapeHtml(example.name)}\\\">\\n   263\\t<div class=\\\"example-live\\\"><iframe src=\\\"examples/${escapeHtml(example.name)}.html\\\" title=\\\"Live example: ${escapeHtml(example.name)}\\\" loading=\\\"lazy\\\" style=\\\"height: ${height}px\\\"></iframe></div>\\n   264\\t${raises}<figcaption><span>Source</span> <a href=\\\"../examples/${escapeHtml(example.file)}\\\">examples/${escapeHtml(example.file)}</a> · <a href=\\\"examples/${escapeHtml(example.name)}.html\\\">open on its own</a></figcaption>\\n   265\\t${codeBlock(source, example.ext)}\\n   266\\t</figure>`;\\n   267\\t}\\n   268\\t\\n   269\\t/** \\\"a\\\", \\\"a and b\\\", \\\"a, b and c\\\". */\\n   270\\tfunction listText(items) {\\n   271\\t  return items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;\\n   272\\t}\\n   273\\t\\n   274\\tfunction sourceBlock(label, target, where, ctx) {\\n   275\\t  const [file, range] = target.split('#');\\n   276\\t  const absolute = path.resolve(path.dirname(where), file);\\n   277\\t  const shown = path.relative(repoRoot, absolute);\\n   278\\t  if (!fs.existsSync(absolute)) {\\n   279\\t    ctx.warnings.push(`${path.relative(repoRoot, where)}: ${shown} does not exist yet; the page shows a placeholder`);\\n   280\\t    return `<figure class=\\\"source source-missing\\\"><figcaption>${escapeHtml(label)}</figcaption><p>This snippet is quoted from <code>${escapeHtml(shown)}</code>, which did not exist when this site was built.</p></figure>`;\\n   281\\t  }\\n   282\\t  let text = fs.readFileSync(absolute, 'utf8').replace(/\\\\n$/, '');\\n   283\\t  const lines = range && /^L(\\\\d+)-L(\\\\d+)$/.exec(range);\\n   284\\t  if (range && !lines) throw new Error(`${path.relative(repoRoot, where)}: bad line range ${range}`);\\n   285\\t  if (lines) {\\n   286\\t    const all = text.split('\\\\n');\\n   287\\t    const [from, to] = [Number(lines[1]), Number(lines[2])];\\n   288\\t    if (from < 1 || to > all.length || from > to) throw new Error(`${path.relative(repoRoot, where)}: ${shown} has no lines ${from}–${to}`);\\n   289\\t    text = all.slice(from - 1, to).join('\\\\n');\\n   290\\t  }\\n   291\\t  const ext = path.extname(file).slice(1);\\n   292\\t  const named = label === shown || label === file ? '' : `${escapeHtml(label)} · `;\\n   293\\t  return `<figure class=\\\"source\\\"><figcaption>${named}<a href=\\\"${escapeHtml(target)}\\\">${escapeHtml(shown)}${lines ? `, lines ${lines[1]}–${lines[2]}` : ''}</a></figcaption>${codeBlock(text, ext)}</figure>`;\\n   294\\t}\\n   295\\t\\n   296\\tfunction generatedTable(name, ctx) {\\n   297\\t  if (name === 'diagnostic codes') return diagnosticsTable(ctx);\\n   298\\t  if (name === 'theme tokens') return tokensTable(ctx);\\n   299\\t  if (name === 'internal tokens') return internalTokensTable(ctx);\\n   300\\t  if (name === 'messages') return messagesTable(ctx);\\n   301\\t  if (name === 'palette') return paletteTable(ctx);\\n   302\\t  throw new Error(`Unknown generated table \\\"${name}\\\"`);\\n   303\\t}\\n   304\\t\\n   305\\tfunction htmlTable(head, rows, caption) {\\n   306\\t  const th = head.map(h => `<th scope=\\\"col\\\">${escapeHtml(h)}</th>`).join('');\\n   307\\t  return `<div class=\\\"table-scroll\\\" tabindex=\\\"0\\\" role=\\\"region\\\" aria-label=\\\"${escapeHtml(caption)}\\\"><table><thead><tr>${th}</tr></thead><tbody>${rows.map(r => `<tr>${r.join('')}</tr>`).join('')}</tbody></table></div>`;\\n   308\\t}\\n   309\\t\\n   310\\tfunction diagnosticsTable(ctx) {\\n   311\\t  const rows = ctx.diagnostics.map(d => [\\n   312\\t    `<th scope=\\\"row\\\"><a href=\\\"diagnostics/${d.code}.html\\\">${d.code}</a></th>`,\\n   313\\t    `<td><span class=\\\"level level-${d.level}\\\">${escapeHtml(d.level)}</span></td>`,\\n   314\\t    `<td>${renderInline(d.condition)}</td>`,\\n   315\\t    `<td>${renderInline(d.drawn)}</td>`,\\n   316\\t  ]);\\n   317\\t  return htmlTable(['Code', 'Level', 'When', 'What is drawn'], rows, 'Diagnostic codes');\\n   318\\t}\\n   319\\t\\n   320\\tfunction swatch(value) {\\n   321\\t  // Only a colour read from the library's own stylesheet reaches a style attribute, and only as a hex value.\\n   322\\t  if (!HEX.test(value)) return `<code>${escapeHtml(value)}</code>`;\\n   323\\t  return `<span class=\\\"swatch\\\" style=\\\"background: ${value}\\\" aria-hidden=\\\"true\\\"></span><code>${escapeHtml(value)}</code>`;\\n   324\\t}\\n   325\\t\\n   326\\tfunction tokensTable(ctx) {\\n   327\\t  const rows = ctx.tokens.map(t => {\\n   328\\t    const cell = scheme => t.default\\n   329\\t      ? `<td>${swatch(ctx.theme[scheme][t.default] ?? missing(t.default, scheme))}</td>`\\n   330\\t      : `<td>${renderInline(t.unset)}</td>`;\\n   331\\t    // What it affects comes before the defaults, so a phone shows it without scrolling the table.\\n   332\\t    return [`<th scope=\\\"row\\\"><code>${escapeHtml(t.name)}</code></th>`, `<td class=\\\"wide\\\">${renderInline(t.affects)}</td>`, cell('light'), cell('dark')];\\n   333\\t  });\\n   334\\t  return htmlTable(['Property', 'What it affects', 'Light default', 'Dark default'], rows, 'Theme custom properties');\\n   335\\t}\\n   336\\t\\n   337\\tfunction missing(name, scheme) {\\n   338\\t  throw new Error(`axylo.css has no ${name} in the ${scheme} scheme`);\\n   339\\t}\\n   340\\t\\n   341\\tfunction internalTokensTable(ctx) {\\n   342\\t  const rows = ctx.internalTokens.map(t => [`<th scope=\\\"row\\\"><code>${escapeHtml(t.name)}</code></th>`, `<td>${renderInline(t.why)}</td>`]);\\n   343\\t  return htmlTable(['Property', 'Why it exists'], rows, 'Internal custom properties');\\n   344\\t}\\n   345\\t\\n   346\\tfunction messagesTable(ctx) {\\n   347\\t  const rows = Object.entries(ctx.messages).map(([key, text]) => [\\n   348\\t    `<th scope=\\\"row\\\"><code>${escapeHtml(key)}</code></th>`, `<td>${escapeHtml(text)}</td>`,\\n   349\\t  ]);\\n   350\\t  return htmlTable(['Key', 'Built-in English text'], rows, 'Built-in messages');\\n   351\\t}\\n   352\\t\\n   353\\tfunction paletteTable(ctx) {\\n   354\\t  const rows = [];\\n   355\\t  for (let slot = 1; ; slot++) {\\n   356\\t    const name = `--axylo-default-series-${slot}`;\\n   357\\t    if (!(name in ctx.theme.light)) break;\\n   358\\t    rows.push([`<th scope=\\\"row\\\">${slot}</th>`, `<td>${swatch(ctx.theme.light[name])}</td>`, `<td>${swatch(ctx.theme.dark[name])}</td>`]);\\n   359\\t  }\\n   360\\t  return htmlTable(['Slot', 'Light', 'Dark'], rows, 'Default palette');\\n   361\\t}\\n   362\\t\\n   363\\t// ---------- diagnostics ----------\\n   364\\t\\n   365\\t/**\\n   366\\t * What each code's minimal input prints. Inputs that run in Node go through the built library's `validate()`,\\n   367\\t * so the page shows the message exactly as the library writes it; the others need a browser (contrast, size,\\n   368\\t * labels, formatters, appends) and show the registry's message for the sample details in the data file.\\n   369\\t */\\n   370\\tasync function diagnosticOutput(diagnostics) {\\n   371\\t  const lib = await import(pathToFileURL(path.join(libDist, 'axylo.js')).href);\\n   372\\t  const registry = await importSource('packages/axylo/src/diagnostics/registry.ts');\\n   373\\t  const out = new Map();\\n   374\\t  for (const d of diagnostics) {\\n   375\\t    if (d.run === 'node') {\\n   376\\t      const found = new Function('validate', `return ${d.input}`)(lib.validate);\\n   377\\t      const mine = found.filter(x => x.code === d.code);\\n   378\\t      if (mine.length === 0) throw new Error(`${d.code}: the minimal input does not raise it (got ${found.map(x => x.code).join(', ') || 'nothing'})`);\\n   379\\t      out.set(d.code, mine.map(x => `[axylo ${x.code}] ${JSON.stringify(x.chart)}: ${x.message}`));\\n   380\\t    } else {\\n   381\\t      const made = registry.createDiagnostic(d.code, d.sample?.effect ?? 'none', d.sample?.details ?? {});\\n   382\\t      out.set(d.code, [`[axylo ${d.code}] ${JSON.stringify(d.sample?.chart ?? 'Chart title')}: ${made.message}`]);\\n   383\\t    }\\n   384\\t  }\\n   385\\t  return out;\\n   386\\t}\\n   387\\t\\n   388\\tfunction renderDiagnosticPage(d, ctx) {\\n   389\\t  const md = s => markdownToHtml(s, { link: url => pageLink(url, '../') });\\n   390\\t  const index = ctx.diagnostics.indexOf(d);\\n   391\\t  const prev = ctx.diagnostics[index - 1];\\n   392\\t  const next = ctx.diagnostics[index + 1];\\n   393\\t  const how = d.run === 'node'\\n   394\\t    ? 'Checked with <code>validate()</code> in Node when this site was built; the message above is its output.'\\n   395\\t    : 'This code needs a browser to arise. The browser test renders this input and checks that the code is reported; the message above is the registry text for sample details.';\\n   396\\t  const body = `<p class=\\\"crumb\\\"><a href=\\\"../diagnostics.html\\\">Diagnostics</a> › ${d.code}</p>\\n   397\\t<h1 id=\\\"top\\\">${d.code}: ${escapeHtml(d.title)}</h1>\\n   398\\t<p><span class=\\\"level level-${d.level}\\\">${escapeHtml(d.level)}</span> ${renderInline(levelText(d.level), url => pageLink(url, '../'))}</p>\\n   399\\t<h2 id=\\\"what-you-see\\\">What you see</h2>\\n   400\\t${md(d.see)}\\n   401\\t${codeBlock(ctx.seen.get(d.code).join('\\\\n'), 'text')}\\n   402\\t<h2 id=\\\"why\\\">Why</h2>\\n   403\\t${md(d.why)}\\n   404\\t<h2 id=\\\"how-to-fix\\\">How to fix it</h2>\\n   405\\t${md(d.fix)}\\n   406\\t<h2 id=\\\"minimal-input\\\">A minimal input that raises it</h2>\\n   407\\t${codeBlock(d.input, 'js')}\\n   408\\t<p class=\\\"small\\\">${how}</p>\\n   409\\t<nav class=\\\"pager\\\" aria-label=\\\"Previous and next code\\\">${prev ? `<a rel=\\\"prev\\\" href=\\\"${prev.code}.html\\\">← ${prev.code}</a>` : '<span></span>'}${next ? `<a rel=\\\"next\\\" href=\\\"${next.code}.html\\\">${next.code} →</a>` : ''}</nav>`;\\n   410\\t  return layout({ title: `${d.code}: ${d.title}`, body, current: 'diagnostics', base: '../', ctx, sourcePath: `apps/docs/data/diagnostics.mjs` });\\n   411\\t}\\n   412\\t\\n   413\\tfunction levelText(level) {\\n   414\\t  if (level === 'error') return 'The chart, or the affected series, cannot be drawn: the chart shows its error state. Printed in every build; thrown by a `strict` chart.';\\n   415\\t  if (level === 'warning') return 'Something is not drawn as given; when values were left out or changed, the reader sees a note. Printed in every build; thrown by a `strict` chart when it comes from a call.';\\n   416\\t  return 'Advice for the author. Printed in development builds only; never thrown.';\\n   417\\t}\\n   418\\t\\n   419\\t// ---------- layout ----------\\n   420\\t\\n   421\\tfunction layout({ title, body, current, base, ctx, sourcePath }) {\\n   422\\t  const links = mobile => nav.map(group => `<li><span class=\\\"nav-section\\\">${escapeHtml(group.section)}</span><ul>${group.pages.map(p =>\\n   423\\t    `<li><a href=\\\"${base}${p.page}.html\\\"${p.page === current ? ' aria-current=\\\"page\\\"' : ''}>${escapeHtml(p.label)}</a></li>`).join('')}</ul></li>`).join('');\\n   424\\t  return `<!doctype html>\\n   425\\t<html lang=\\\"en\\\">\\n   426\\t<head>\\n   427\\t<meta charset=\\\"utf-8\\\">\\n   428\\t<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n   429\\t<meta name=\\\"color-scheme\\\" content=\\\"light dark\\\">\\n   430\\t<title>${escapeHtml(title)} · Axylo</title>\\n   431\\t<link rel=\\\"icon\\\" href=\\\"data:,\\\">\\n   432\\t<link rel=\\\"stylesheet\\\" href=\\\"${base}assets/site.css\\\">\\n   433\\t<script src=\\\"${base}assets/page.js\\\" defer></script>\\n   434\\t</head>\\n   435\\t<body>\\n   436\\t<a class=\\\"skip\\\" href=\\\"#main\\\">Skip to content</a>\\n   437\\t<header class=\\\"site-header\\\">\\n   438\\t<a class=\\\"brand\\\" href=\\\"${base}index.html\\\">Axylo</a><span class=\\\"tagline\\\">Documentation for 1.0</span>\\n   439\\t</header>\\n   440\\t<details class=\\\"nav-mobile\\\"><summary>Pages</summary><nav aria-label=\\\"Documentation\\\"><ul class=\\\"nav-list\\\">${links(true)}</ul></nav></details>\\n   441\\t<div class=\\\"layout\\\">\\n   442\\t<nav class=\\\"nav-side\\\" aria-label=\\\"Documentation\\\"><ul class=\\\"nav-list\\\">${links(false)}</ul></nav>\\n   443\\t<main id=\\\"main\\\">\\n   444\\t<article>\\n   445\\t${body}\\n   446\\t</article>\\n   447\\t<footer class=\\\"page-footer\\\"><p>Source of this page: <code>${escapeHtml(sourcePath)}</code>. The live examples run the library's built files (package version ${escapeHtml(ctx.version)}, development flavour).</p></footer>\\n   448\\t</main>\\n   449\\t</div>\\n   450\\t</body>\\n   451\\t</html>\\n   452\\t`;\\n   453\\t}\\n   454\\t\\n   455\\t// ---------- links ----------\\n   456\\t\\n   457\\t/** Every link in the built site resolves: pages and their anchors in dist, other paths in the repository. */\\n   458\\texport function checkLinks(outDir) {\\n   459\\t  const broken = [];\\n   460\\t  const files = [];\\n   461\\t  const walk = dir => {\\n   462\\t    for (const f of fs.readdirSync(dir)) {\\n   463\\t      const p = path.join(dir, f);\\n   464\\t      if (fs.statSync(p).isDirectory()) walk(p);\\n   465\\t      else if (f.endsWith('.html')) files.push(p);\\n   466\\t    }\\n   467\\t  };\\n   468\\t  walk(outDir);\\n   469\\t  const ids = new Map();\\n   470\\t  const idsOf = file => {\\n   471\\t    if (!ids.has(file)) ids.set(file, new Set([...fs.readFileSync(file, 'utf8').matchAll(/\\\\sid=\\\"([^\\\"]+)\\\"/g)].map(m => m[1])));\\n   472\\t    return ids.get(file);\\n   473\\t  };\\n   474\\t  for (const file of files) {\\n   475\\t    const html = fs.readFileSync(file, 'utf8');\\n   476\\t    for (const m of html.matchAll(/\\\\s(?:href|src)=\\\"([^\\\"]+)\\\"/g)) {\\n   477\\t      const url = m[1].replace(/&amp;/g, '&');\\n   478\\t      if (/^[a-z]+:/i.test(url)) continue;\\n   479\\t      const [target, hash] = url.split('#');\\n   480\\t      const resolved = target === '' ? file : path.resolve(path.dirname(file), decodeURIComponent(target));\\n   481\\t      if (!fs.existsSync(resolved)) { broken.push(`${path.relative(outDir, file)} → ${url}`); continue; }\\n   482\\t      if (hash && resolved.endsWith('.html') && resolved.startsWith(outDir) && !/^L\\\\d+/.test(hash) && !idsOf(resolved).has(hash)) {\\n   483\\t        broken.push(`${path.relative(outDir, file)} → ${url} (no such anchor)`);\\n   484\\t      }\\n   485\\t    }\\n   486\\t  }\\n   487\\t  return broken;\\n   488\\t}\\n   489\\t\\n   490\\texport { slug };\\napps/docs/lib/examples.mjs\\n     1\\t/**\\n     2\\t * Runnable examples: files in apps/docs/examples, each one a complete program a reader can copy.\\n     3\\t *\\n     4\\t * - `name.ts`: a module that imports from 'axylo' and draws into elements it names by id, as in\\n     5\\t *   `line('#chart', …)`. The example page creates one empty <div> per id it finds in such a call.\\n     6\\t * - `name.tsx`: a React module that renders into `#root`.\\n     7\\t * - `name.html`: markup and scripts for the body of the page, for examples that need their own markup.\\n     8\\t *\\n     9\\t * What an example promises is written in its own comments, in words the reader sees too:\\n    10\\t * - \\\"Raises AX111 on purpose\\\" (or \\\"Raises AX102, AX103 and AX106 on purpose\\\") lists the diagnostics it\\n    11\\t *   demonstrates; the browser test fails on any other code, and on a listed code that does not appear.\\n    12\\t * - \\\"Draws no marks on purpose\\\" marks an example whose charts show a state (loading, empty, error) instead.\\n    13\\t */\\n    14\\timport fs from 'node:fs';\\n    15\\timport path from 'node:path';\\n    16\\t\\n    17\\texport const docsRoot = path.resolve(import.meta.dirname, '..');\\n    18\\texport const repoRoot = path.resolve(docsRoot, '../..');\\n    19\\texport const examplesDir = path.join(docsRoot, 'examples');\\n    20\\t/** Scratch output that is not the site: generated type-check inputs and the vendor shims. Git-ignored. */\\n    21\\texport const cacheDir = path.join(docsRoot, '.cache');\\n    22\\t\\n    23\\tconst CHART_CALL = /\\\\b(?:line|area|bar|scatter|donut)\\\\(\\\\s*(['\\\"])#([\\\\w-]+)\\\\1/g;\\n    24\\tconst RAISES = /Raises ((?:AX\\\\d{3})(?:(?:, | and )AX\\\\d{3})*) on purpose/;\\n    25\\tconst NO_MARKS = /Draws no marks on purpose/;\\n    26\\tconst MODULE_SCRIPT = /<script type=\\\"module\\\">([\\\\s\\\\S]*?)<\\\\/script>/g;\\n    27\\tconst CLASSIC_SCRIPT = /<script>([\\\\s\\\\S]*?)<\\\\/script>/g;\\n    28\\t\\n    29\\texport function listExamples() {\\n    30\\t  return fs.readdirSync(examplesDir)\\n    31\\t    // A file whose name starts with an underscore is a helper shared by examples, not an example.\\n    32\\t    .filter(file => /\\\\.(ts|tsx|html)$/.test(file) && !file.endsWith('.d.ts') && !file.startsWith('_'))\\n    33\\t    .sort()\\n    34\\t    .map(file => readExample(file));\\n    35\\t}\\n    36\\t\\n    37\\texport function readExample(file) {\\n    38\\t  const ext = path.extname(file).slice(1);\\n    39\\t  const name = path.basename(file, path.extname(file));\\n    40\\t  const source = fs.readFileSync(path.join(examplesDir, file), 'utf8');\\n    41\\t  const raises = RAISES.exec(source)?.[1].split(/, | and /) ?? [];\\n    42\\t  const targets = ext === 'ts' ? [...new Set([...source.matchAll(CHART_CALL)].map(m => m[2]))] : [];\\n    43\\t  if (ext === 'ts' && targets.length === 0) throw new Error(`${file}: no chart call with a '#id' target`);\\n    44\\t  return { file, name, ext, source, raises, noMarks: NO_MARKS.test(source), targets };\\n    45\\t}\\n    46\\t\\n    47\\t/**\\n    48\\t * The scripts of an .html example as JavaScript files, so `tsc` checks them against the package's\\n    49\\t * declarations like the .ts examples (with `checkJs`; see examples/tsconfig.html.json). A module script\\n    50\\t * imports 'axylo' itself; a classic script uses the `Axylo` global of the script-tag build, declared in\\n    51\\t * globals.d.ts from the same types.\\n    52\\t */\\n    53\\texport function htmlScripts(example) {\\n    54\\t  const out = [];\\n    55\\t  let n = 0;\\n    56\\t  for (const m of example.source.matchAll(MODULE_SCRIPT)) {\\n    57\\t    out.push({ file: `${example.name}.${++n}.js`, line: lineOf(example.source, m.index), code: m[1] });\\n    58\\t  }\\n    59\\t  for (const m of example.source.matchAll(CLASSIC_SCRIPT)) {\\n    60\\t    // `export {}` gives each classic script its own scope, as separate pages would.\\n    61\\t    out.push({ file: `${example.name}.${++n}.js`, line: lineOf(example.source, m.index), code: m[1] + '\\\\nexport {};\\\\n' });\\n    62\\t  }\\n    63\\t  return out;\\n    64\\t}\\n    65\\t\\n    66\\tfunction lineOf(text, index) {\\n    67\\t  return text.slice(0, index).split('\\\\n').length;\\n    68\\t}\\n    69\\t\\n    70\\t/** Writes the extracted scripts where apps/docs/examples/tsconfig.html.json includes them. */\\n    71\\texport function writeTypecheckInputs() {\\n    72\\t  const dir = path.join(cacheDir, 'html-scripts');\\n    73\\t  fs.rmSync(dir, { recursive: true, force: true });\\n    74\\t  fs.mkdirSync(dir, { recursive: true });\\n    75\\t  fs.writeFileSync(path.join(dir, 'globals.d.ts'), \\\"declare const Axylo: typeof import('axylo');\\\\n\\\");\\n    76\\t  const map = {};\\n    77\\t  for (const example of listExamples().filter(e => e.ext === 'html')) {\\n    78\\t    for (const script of htmlScripts(example)) {\\n    79\\t      fs.writeFileSync(path.join(dir, script.file), script.code);\\n    80\\t      map[script.file] = { example: example.file, line: script.line };\\n    81\\t    }\\n    82\\t  }\\n    83\\t  return map;\\n    84\\t}\\napps/docs/build.mjs\\n     1\\t// Builds the documentation site into apps/docs/dist. Needs the library built first (`npm run build`).\\n     2\\t// Usage: node apps/docs/build.mjs\\n     3\\timport { buildSite } from './lib/site.mjs';\\n     4\\t\\n     5\\tconst started = Date.now();\\n     6\\tconst result = await buildSite({ log: message => console.warn(message) });\\n     7\\tconst words = result.pages.reduce((sum, p) => sum + p.words, 0);\\n     8\\tconsole.log(`built ${result.pages.length} pages (${words} words), ${result.diagnostics} diagnostic pages and ${result.examples.length} examples in ${Date.now() - started} ms`);\\n     9\\tfor (const p of result.pages) console.log(`  ${p.page.padEnd(18)} ${String(p.words).padStart(5)} words`);\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nreviews/2026-11-18/impl/wp/docs.review.events.jsonl:34:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_15\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"nl -ba apps/docs/lib/site.mjs | sed -n '127,244p'\\nfor f in apps/docs/test/{options,theming,diagnostics,examples.browser,node.browser}.test.ts; do echo \\\\\\\"\\\"'$f\\\"; nl -ba \\\"$f\\\"; done'\",\"aggregated_output\":\"   127\\t/**\\n   128\\t * React and React DOM as ES modules for the import map. Both packages are CommonJS, so each entry is a small\\n   129\\t * module that re-exports the names the package has, read from the package itself.\\n   130\\t */\\n   131\\tasync function buildVendor(outDir) {\\n   132\\t  const require = createRequire(path.join(repoRoot, 'package.json'));\\n   133\\t  const dir = path.join(cacheDir, 'vendor');\\n   134\\t  fs.mkdirSync(dir, { recursive: true });\\n   135\\t  const entries = { react: 'react', 'jsx-runtime': 'react/jsx-runtime', 'react-dom-client': 'react-dom/client' };\\n   136\\t  const entryPoints = {};\\n   137\\t  for (const [out, specifier] of Object.entries(entries)) {\\n   138\\t    const names = Object.keys(require(specifier)).filter(n => /^[A-Za-z_$][\\\\w$]*$/.test(n) && n !== 'default');\\n   139\\t    const file = path.join(dir, `${out}.mjs`);\\n   140\\t    fs.writeFileSync(file, `import m from '${specifier}';\\\\nexport default m;\\\\n${names.map(n => `export const ${n} = m.${n};`).join('\\\\n')}\\\\n`);\\n   141\\t    entryPoints[out] = file;\\n   142\\t  }\\n   143\\t  await build({\\n   144\\t    entryPoints, bundle: true, format: 'esm', splitting: true, outdir: path.join(outDir, 'assets/vendor'), target: 'es2022',\\n   145\\t    define: { 'process.env.NODE_ENV': '\\\"development\\\"' }, logLevel: 'warning', nodePaths: [path.join(repoRoot, 'node_modules')],\\n   146\\t    absWorkingDir: repoRoot,\\n   147\\t  });\\n   148\\t}\\n   149\\t\\n   150\\t// ---------- examples ----------\\n   151\\t\\n   152\\tconst IMPORT_MAP = JSON.stringify({ imports: {\\n   153\\t  axylo: '../assets/axylo.js',\\n   154\\t  '@axylo/react': '../assets/axylo-react.js',\\n   155\\t  react: '../assets/vendor/react.js',\\n   156\\t  'react/jsx-runtime': '../assets/vendor/jsx-runtime.js',\\n   157\\t  'react-dom/client': '../assets/vendor/react-dom-client.js',\\n   158\\t} }, null, 2);\\n   159\\t\\n   160\\tasync function buildExamples(outDir) {\\n   161\\t  const examples = listExamples();\\n   162\\t  const compiled = examples.filter(e => e.ext !== 'html');\\n   163\\t  if (compiled.length) {\\n   164\\t    await build({\\n   165\\t      entryPoints: compiled.map(e => path.join(docsRoot, 'examples', e.file)), bundle: true, format: 'esm', target: 'es2022',\\n   166\\t      outdir: path.join(outDir, 'examples'), jsx: 'automatic', logLevel: 'warning',\\n   167\\t      external: ['axylo', '@axylo/react', 'react', 'react/jsx-runtime', 'react-dom', 'react-dom/client'],\\n   168\\t    });\\n   169\\t  }\\n   170\\t  const manifest = [];\\n   171\\t  for (const e of examples) {\\n   172\\t    fs.writeFileSync(path.join(outDir, 'examples', `${e.name}.html`), examplePage(e));\\n   173\\t    manifest.push({ name: e.name, file: e.file, ext: e.ext, raises: e.raises, noMarks: e.noMarks });\\n   174\\t  }\\n   175\\t  fs.writeFileSync(path.join(outDir, 'examples/manifest.json'), JSON.stringify(manifest, null, 2));\\n   176\\t  return manifest;\\n   177\\t}\\n   178\\t\\n   179\\tfunction examplePage(e) {\\n   180\\t  // An .html example's own <style> goes to the head, where it belongs; the reader sees it in the source as written.\\n   181\\t  const styles = e.ext === 'html' ? [...e.source.matchAll(/<style>[\\\\s\\\\S]*?<\\\\/style>\\\\n?/g)].map(m => m[0]).join('') : '';\\n   182\\t  const body = e.ext === 'html'\\n   183\\t    ? e.source.replace(/<style>[\\\\s\\\\S]*?<\\\\/style>\\\\n?/g, '')\\n   184\\t    : e.ext === 'tsx'\\n   185\\t      ? '<div id=\\\"root\\\"></div>\\\\n<script type=\\\"module\\\" src=\\\"' + e.name + '.js\\\"></script>'\\n   186\\t      : e.targets.map(id => `<div id=\\\"${escapeHtml(id)}\\\" class=\\\"example-target\\\"></div>`).join('\\\\n') +\\n   187\\t        `\\\\n<script type=\\\"module\\\" src=\\\"${e.name}.js\\\"></script>`;\\n   188\\t  return `<!doctype html>\\n   189\\t<html lang=\\\"en\\\">\\n   190\\t<head>\\n   191\\t<meta charset=\\\"utf-8\\\">\\n   192\\t<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1\\\">\\n   193\\t<meta name=\\\"color-scheme\\\" content=\\\"light dark\\\">\\n   194\\t<title>Example: ${escapeHtml(e.name)}</title>\\n   195\\t<link rel=\\\"icon\\\" href=\\\"data:,\\\">\\n   196\\t<link rel=\\\"stylesheet\\\" href=\\\"../assets/site.css\\\">\\n   197\\t<script type=\\\"importmap\\\">\\n   198\\t${IMPORT_MAP}\\n   199\\t</script>\\n   200\\t<script src=\\\"../assets/frame.js\\\" defer></script>\\n   201\\t${styles}</head>\\n   202\\t<body class=\\\"example-page\\\">\\n   203\\t${body}\\n   204\\t</body>\\n   205\\t</html>\\n   206\\t`;\\n   207\\t}\\n   208\\t\\n   209\\t// ---------- pages ----------\\n   210\\t\\n   211\\tfunction renderPage(entry, source, index, ctx) {\\n   212\\t  const headings = [];\\n   213\\t  const where = path.join(pagesDir, `${entry.page}.md`);\\n   214\\t  const body = markdownToHtml(source, {\\n   215\\t    headings,\\n   216\\t    link: url => pageLink(url),\\n   217\\t    directive: d => directive(d, where, ctx),\\n   218\\t  });\\n   219\\t  const title = headings.find(h => h.level === 1)?.text ?? entry.label;\\n   220\\t  const prev = pages[index - 1];\\n   221\\t  const next = pages[index + 1];\\n   222\\t  const pager = `<nav class=\\\"pager\\\" aria-label=\\\"Previous and next page\\\">${prev ? `<a rel=\\\"prev\\\" href=\\\"${prev.page}.html\\\">← ${escapeHtml(prev.label)}</a>` : '<span></span>'}${next ? `<a rel=\\\"next\\\" href=\\\"${next.page}.html\\\">${escapeHtml(next.label)} →</a>` : ''}</nav>`;\\n   223\\t  return layout({\\n   224\\t    title, body: body + pager, current: entry.page, base: '', ctx,\\n   225\\t    sourcePath: `apps/docs/pages/${entry.page}.md`,\\n   226\\t  });\\n   227\\t}\\n   228\\t\\n   229\\tconst PAGE_NAMES = new Set(pages.map(p => p.page));\\n   230\\t\\n   231\\t/** Rewrites a link written for the Markdown sources (readable on a code host) to its place in the site. */\\n   232\\texport function pageLink(url, base = '') {\\n   233\\t  if (/^[a-z]+:/i.test(url) || url.startsWith('#')) return url;\\n   234\\t  const [file, hash] = url.split('#');\\n   235\\t  const code = file === 'diagnostics.md' && hash && /^ax\\\\d{3}$/i.test(hash) ? hash.toUpperCase() : null;\\n   236\\t  if (code) return `${base}diagnostics/${code}.html`;\\n   237\\t  const name = file.endsWith('.md') && !file.includes('/') ? file.slice(0, -3) : null;\\n   238\\t  if (name !== null && PAGE_NAMES.has(name)) return `${base}${name}.html${hash ? '#' + hash : ''}`;\\n   239\\t  // A path into the repository: pages/ and dist/ sit at the same depth, so it resolves the same from both\\n   240\\t  // when the site is served from the repository root.\\n   241\\t  return base + url;\\n   242\\t}\\n   243\\t\\n   244\\tfunction directive({ kind, name, target }, where, ctx) {\\napps/docs/test/options.test.ts\\n     1\\t/**\\n     2\\t * The options reference (apps/docs/pages/options.md) documents exactly the keys of the public types: every\\n     3\\t * key of every option type, field type, handle and event in packages/axylo/src/public.ts (and the React\\n     4\\t * props in packages/react/src/index.ts) appears in the reference, and nothing in the reference is missing\\n     5\\t * from the types. The keys are read with the TypeScript compiler API (typescript/unstable/sync, TypeScript 7)\\n     6\\t * from the source declarations, so the test needs no build.\\n     7\\t *\\n     8\\t * Each table in the reference is marked `<!-- options: Group -->`; its first column lists the keys in\\n     9\\t * backticks. GROUPS says which keys of the types each group stands for.\\n    10\\t */\\n    11\\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\\n    12\\timport fs from 'node:fs';\\n    13\\timport path from 'node:path';\\n    14\\timport { API } from 'typescript/unstable/sync';\\n    15\\timport { cacheDir, docsRoot, repoRoot } from '../lib/examples.mjs';\\n    16\\timport { defaultMessages } from '../../../packages/axylo/src/messages/index';\\n    17\\t\\n    18\\tconst Keys = 'type Keys<T> = T extends unknown ? { [K in keyof T]-?: [Exclude<T[K], undefined>] extends [never] ? never : K }[keyof T] : never;';\\n    19\\tconst L = 'LineOptions<Row>';\\n    20\\tconst GROUPS: Record<string, string> = {\\n    21\\t  CommonOptions: 'Keys<CommonOptions<Row>>',\\n    22\\t  Title: 'Keys<Title>',\\n    23\\t  Encoding: 'Keys<Encoding<Row>>',\\n    24\\t  CartesianOptions: 'Keys<CartesianOptions>',\\n    25\\t  Reference: 'Keys<Reference>',\\n    26\\t  CompactOption: 'Keys<CompactOption>',\\n    27\\t  AreaOptions: `Exclude<Keys<AreaOptions<Row>>, Keys<${L}>>`,\\n    28\\t  BarOptions: `Exclude<Keys<BarOptions<Row>>, Keys<${L}>>`,\\n    29\\t  ScatterOptions: 'Exclude<Keys<ScatterOptions<Row>>, Keys<CommonOptions<Row>> | Keys<CartesianOptions>>',\\n    30\\t  DonutOptions: 'Exclude<Keys<DonutOptions<Row>>, Keys<CommonOptions<Row>>>',\\n    31\\t  ValueField: 'Keys<Exclude<ValueField<Row>, string>>',\\n    32\\t  XField: 'Keys<Exclude<XField<Row>, string>>',\\n    33\\t  ScatterXField: 'Keys<Exclude<ScatterXField<Row>, string>>',\\n    34\\t  Chart: `Keys<Chart<Row, ${L}>>`,\\n    35\\t  AppendOptions: `Keys<NonNullable<Parameters<Chart<Row, ${L}>['append']>[1]>>`,\\n    36\\t  ChartEvents: 'Keys<ChartEvents<Row>>',\\n    37\\t  Point: 'Keys<Point<Row>>',\\n    38\\t  Diagnostic: 'Keys<Diagnostic>',\\n    39\\t  ReactProps: `Exclude<Keys<LineProps<Row>>, Keys<${L}>>`,\\n    40\\t  ChartRef: `Keys<ChartRef<Row, ${L}>>`,\\n    41\\t};\\n    42\\t// Checks on the types themselves, so a key added to a composite type directly is not missed.\\n    43\\tconst EXTRA: Record<string, string> = {\\n    44\\t  LineOptions: `Keys<${L}>`,\\n    45\\t  Messages: 'Keys<Messages>',\\n    46\\t  DonutReactProps: 'Exclude<Keys<DonutProps<Row>>, Keys<DonutOptions<Row>>>',\\n    47\\t  AreaReactProps: 'Exclude<Keys<AreaProps<Row>>, Keys<AreaOptions<Row>>>',\\n    48\\t  BarReactProps: 'Exclude<Keys<BarProps<Row>>, Keys<BarOptions<Row>>>',\\n    49\\t  ScatterReactProps: 'Exclude<Keys<ScatterProps<Row>>, Keys<ScatterOptions<Row>>>',\\n    50\\t};\\n    51\\t\\n    52\\tconst dir = path.join(cacheDir, 'types');\\n    53\\tconst probe = path.join(dir, 'probe.ts');\\n    54\\tlet api: API;\\n    55\\tconst keys: Record<string, string[]> = {};\\n    56\\t\\n    57\\t/** `\\\"a\\\" | \\\"b\\\" | \\\\`data-${string}\\\\`` → ['a', 'b', 'data-*']. */\\n    58\\tfunction parseUnion(text: string): string[] {\\n    59\\t  if (text === 'never') return [];\\n    60\\t  return text.split(' | ').map(part => part.startsWith('\\\"') ? JSON.parse(part) as string : part.replace(/^`(.*)\\\\$\\\\{string\\\\}`$/, '$1*'));\\n    61\\t}\\n    62\\t\\n    63\\tbeforeAll(() => {\\n    64\\t  fs.mkdirSync(dir, { recursive: true });\\n    65\\t  const rel = (p: string) => path.relative(dir, path.join(repoRoot, p)).split(path.sep).join('/');\\n    66\\t  fs.writeFileSync(path.join(dir, 'tsconfig.json'), JSON.stringify({\\n    67\\t    extends: rel('tsconfig.base.json'),\\n    68\\t    compilerOptions: {\\n    69\\t      noEmit: true, types: [], jsx: 'react-jsx',\\n    70\\t      paths: { axylo: [rel('packages/axylo/src/index.ts')], '@axylo/react': [rel('packages/react/src/index.ts')] },\\n    71\\t    },\\n    72\\t    files: ['probe.ts', rel('packages/axylo/src/core/globals.d.ts')],\\n    73\\t  }, null, 2));\\n    74\\t  const all = { ...GROUPS, ...EXTRA };\\n    75\\t  fs.writeFileSync(probe, [\\n    76\\t    \\\"import type { AreaOptions, BarOptions, CartesianOptions, Chart, ChartEvents, CommonOptions, CompactOption, Diagnostic, DonutOptions, Encoding, LineOptions, Messages, Point, Reference, ScatterOptions, ScatterXField, Title, ValueField, XField } from 'axylo';\\\",\\n    77\\t    \\\"import type { AreaProps, BarProps, ChartRef, DonutProps, LineProps, ScatterProps } from '@axylo/react';\\\",\\n    78\\t    'interface Row { day: string; v: number; s: string }',\\n    79\\t    Keys,\\n    80\\t    ...Object.entries(all).map(([name, type]) => `export declare const k_${name}: ${type};`),\\n    81\\t  ].join('\\\\n'));\\n    82\\t  api = new API({ cwd: dir });\\n    83\\t  const snapshot = api.updateSnapshot({ openProjects: [path.join(dir, 'tsconfig.json')] });\\n    84\\t  const project = snapshot.getProjects()[0]!;\\n    85\\t  const text = project.program.getSourceFile(probe)!.text;\\n    86\\t  for (const name of Object.keys(all)) {\\n    87\\t    const type = project.checker.getTypeAtPosition(probe, text.indexOf(`k_${name}:`));\\n    88\\t    // 1 = TypeFormatFlags.NoTruncation: the whole union, however long.\\n    89\\t    keys[name] = parseUnion(project.checker.typeToString(type!, undefined, 1)).sort();\\n    90\\t  }\\n    91\\t}, 60_000);\\n    92\\t\\n    93\\tafterAll(() => api?.close());\\n    94\\t\\n    95\\t/** Keys per marked table of options.md. */\\n    96\\tfunction documented(): Record<string, string[]> {\\n    97\\t  const source = fs.readFileSync(path.join(docsRoot, 'pages/options.md'), 'utf8').split('\\\\n');\\n    98\\t  const out: Record<string, string[]> = {};\\n    99\\t  for (let i = 0; i < source.length; i++) {\\n   100\\t    const marker = /^<!-- options: (\\\\w+) -->$/.exec(source[i]!.trim());\\n   101\\t    if (!marker) continue;\\n   102\\t    const names: string[] = [];\\n   103\\t    // Skip the header and rule; read rows until the table ends.\\n   104\\t    for (let j = i + 3; j < source.length && source[j]!.startsWith('|'); j++) {\\n   105\\t      const first = source[j]!.split(/(?<!\\\\\\\\)\\\\|/)[1] ?? '';\\n   106\\t      names.push(...[...first.matchAll(/`([^`]+)`/g)].map(m => m[1]!));\\n   107\\t    }\\n   108\\t    out[marker[1]!] = names.sort();\\n   109\\t  }\\n   110\\t  return out;\\n   111\\t}\\n   112\\t\\n   113\\tdescribe('options reference against the public types', () => {\\n   114\\t  const docs = documented();\\n   115\\t\\n   116\\t  it('every marked table is a known group, and every group has a table', () => {\\n   117\\t    expect(Object.keys(docs).sort()).toEqual(Object.keys(GROUPS).sort());\\n   118\\t  });\\n   119\\t\\n   120\\t  it.each(Object.keys(GROUPS))('%s: documented keys equal the type\\\\'s keys', group => {\\n   121\\t    const types = keys[group]!;\\n   122\\t    expect(types.length, `${group} has keys`).toBeGreaterThan(0);\\n   123\\t    expect({ missingFromReference: types.filter(k => !docs[group]?.includes(k)), notInTypes: (docs[group] ?? []).filter(k => !types.includes(k)) })\\n   124\\t      .toEqual({ missingFromReference: [], notInTypes: [] });\\n   125\\t  });\\n   126\\t\\n   127\\t  it('LineOptions is exactly the common, encoding, cartesian and compact groups', () => {\\n   128\\t    const groups = [...keys.CommonOptions!, ...keys.Encoding!, ...keys.CartesianOptions!, ...keys.CompactOption!];\\n   129\\t    expect(keys.LineOptions).toEqual([...new Set(groups)].sort());\\n   130\\t  });\\n   131\\t\\n   132\\t  it('the React components take the same extra props, except onZoom on Donut', () => {\\n   133\\t    expect(keys.AreaReactProps).toEqual(keys.ReactProps);\\n   134\\t    expect(keys.BarReactProps).toEqual(keys.ReactProps);\\n   135\\t    expect(keys.ScatterReactProps).toEqual(keys.ReactProps);\\n   136\\t    expect(keys.DonutReactProps).toEqual(keys.ReactProps!.filter(k => k !== 'onZoom'));\\n   137\\t  });\\n   138\\t\\n   139\\t  it('the generated Messages table lists every key of Messages', () => {\\n   140\\t    // The table is generated from defaultMessages; this checks that defaultMessages has exactly the type's keys.\\n   141\\t    expect(Object.keys(defaultMessages).sort()).toEqual(keys.Messages);\\n   142\\t  });\\n   143\\t});\\napps/docs/test/theming.test.ts\\n     1\\t/**\\n     2\\t * The theming page documents exactly the CSS custom properties the library's stylesheet uses: a property in\\n     3\\t * packages/axylo/src/theme/css.ts that is not in apps/docs/data/tokens.mjs fails, and so does a documented one\\n     4\\t * that is not in the stylesheet. The private defaults (`--axylo-default-*`) are the values behind the public\\n     5\\t * names, not properties of their own; each documented default must exist in both schemes.\\n     6\\t */\\n     7\\timport { describe, expect, it } from 'vitest';\\n     8\\timport { AXYLO_CSS } from '../../../packages/axylo/src/theme/css';\\n     9\\timport { readThemeDefaults } from '../lib/site.mjs';\\n    10\\timport { internalTokens, tokens } from '../data/tokens.mjs';\\n    11\\t\\n    12\\tconst inStylesheet = [...new Set([...AXYLO_CSS.matchAll(/--axylo-[a-z0-9-]+/g)].map(m => m[0]))]\\n    13\\t  .filter(name => !name.startsWith('--axylo-default-'))\\n    14\\t  .sort();\\n    15\\tconst documented = [...tokens, ...internalTokens].map(t => t.name).sort();\\n    16\\t\\n    17\\tdescribe('theme custom properties', () => {\\n    18\\t  it('every custom property in the stylesheet is documented', () => {\\n    19\\t    expect(inStylesheet.filter(name => !documented.includes(name))).toEqual([]);\\n    20\\t  });\\n    21\\t  it('every documented custom property is in the stylesheet', () => {\\n    22\\t    expect(documented.filter(name => !inStylesheet.includes(name))).toEqual([]);\\n    23\\t  });\\n    24\\t  it('no property is documented twice', () => {\\n    25\\t    expect(documented.filter((name, i) => documented.indexOf(name) !== i)).toEqual([]);\\n    26\\t  });\\n    27\\t  it('every documented default exists in the light and the dark scheme', () => {\\n    28\\t    const { light, dark } = readThemeDefaults(AXYLO_CSS);\\n    29\\t    for (const t of tokens.filter(t => 'default' in t && t.default)) {\\n    30\\t      expect(light[t.default!], `${t.default} (light)`).toMatch(/^#[0-9a-f]{6}$/i);\\n    31\\t      expect(dark[t.default!], `${t.default} (dark)`).toMatch(/^#[0-9a-f]{6}$/i);\\n    32\\t    }\\n    33\\t  });\\n    34\\t  it('every private default in the stylesheet belongs to a documented property', () => {\\n    35\\t    const { light, dark } = readThemeDefaults(AXYLO_CSS);\\n    36\\t    const used = new Set(tokens.map(t => t.default).filter(Boolean));\\n    37\\t    expect([...new Set([...Object.keys(light), ...Object.keys(dark)])].filter(name => !used.has(name))).toEqual([]);\\n    38\\t  });\\n    39\\t  it('a property without a colour default says what happens when it is unset', () => {\\n    40\\t    for (const t of tokens.filter(t => !t.default)) expect(t.unset, t.name).toBeTruthy();\\n    41\\t  });\\n    42\\t});\\napps/docs/test/diagnostics.test.ts\\n     1\\t/**\\n     2\\t * Criterion DX4: every diagnostic code has a documentation page, and every documented code exists. The pages\\n     3\\t * are generated from apps/docs/data/diagnostics.mjs, one per entry, so the check is on that file against the\\n     4\\t * registry the library reports from (packages/axylo/src/diagnostics/registry.ts). The built pages themselves\\n     5\\t * are checked in diagnostics.browser.test.ts, after the site is built.\\n     6\\t *\\n     7\\t * Also: each entry's level is the registry's, its condition follows the spec table, and each minimal input\\n     8\\t * that runs in Node raises its code through validate().\\n     9\\t */\\n    10\\timport { describe, expect, it } from 'vitest';\\n    11\\timport { diagnosticRegistry, createDiagnostic } from '../../../packages/axylo/src/diagnostics/registry';\\n    12\\timport { validate } from '../../../packages/axylo/src/index';\\n    13\\timport { diagnostics } from '../data/diagnostics.mjs';\\n    14\\t\\n    15\\tconst registryCodes = Object.keys(diagnosticRegistry).sort();\\n    16\\tconst documented = diagnostics.map(d => d.code);\\n    17\\t\\n    18\\tdescribe('diagnostics documentation covers the registry', () => {\\n    19\\t  it('every code in the registry has a page', () => {\\n    20\\t    expect(registryCodes.filter(code => !documented.includes(code))).toEqual([]);\\n    21\\t  });\\n    22\\t  it('every page is for a code in the registry', () => {\\n    23\\t    expect(documented.filter(code => !registryCodes.includes(code))).toEqual([]);\\n    24\\t  });\\n    25\\t  it('no code has two pages', () => {\\n    26\\t    expect(documented.filter((code, i) => documented.indexOf(code) !== i)).toEqual([]);\\n    27\\t  });\\n    28\\t  it.each(diagnostics.map(d => [d.code, d] as const))('%s has the registry level and every section', (code, d) => {\\n    29\\t    expect(d.level).toBe(diagnosticRegistry[code as keyof typeof diagnosticRegistry].level);\\n    30\\t    for (const key of ['title', 'condition', 'drawn', 'see', 'why', 'fix', 'input'] as const) {\\n    31\\t      expect(typeof d[key] === 'string' && d[key].trim().length > 0, `${code}.${key}`).toBe(true);\\n    32\\t    }\\n    33\\t    expect(['node', 'browser']).toContain(d.run);\\n    34\\t  });\\n    35\\t});\\n    36\\t\\n    37\\tdescribe('minimal inputs that run in Node raise their code', () => {\\n    38\\t  const inNode = diagnostics.filter(d => d.run === 'node');\\n    39\\t  it.each(inNode.map(d => [d.code, d.input] as const))('%s', (code, input) => {\\n    40\\t    const found = new Function('validate', `return ${input}`)(validate) as { code: string }[];\\n    41\\t    expect(found.map(f => f.code)).toContain(code);\\n    42\\t  });\\n    43\\t});\\n    44\\t\\n    45\\tdescribe('documentation links in messages', () => {\\n    46\\t  // The registry's messages carry no URL today. If one is added, it must point at that code's own page,\\n    47\\t  // apps/docs/dist/diagnostics/<code>.html, under whatever base the site is published at.\\n    48\\t  it.each(registryCodes)('%s', code => {\\n    49\\t    const message = createDiagnostic(code as keyof typeof diagnosticRegistry, 'none', { field: 'f', rows: [1], count: 1 }).message;\\n    50\\t    for (const url of message.match(/https?:\\\\/\\\\/\\\\S+|\\\\S+\\\\.html\\\\b/g) ?? []) {\\n    51\\t      expect(url.replace(/[).,]+$/, '')).toMatch(new RegExp(`/diagnostics/${code}\\\\\\\\.html$`));\\n    52\\t    }\\n    53\\t  });\\n    54\\t});\\napps/docs/test/examples.browser.test.ts\\n     1\\t/**\\n     2\\t * Criterion DX10: every runnable example in the documentation is compiled and rendered from the built\\n     3\\t * library. Run after `npm run build`:\\n     4\\t *\\n     5\\t *   AXYLO_BROWSER=1 npx vitest run apps/docs/test/examples.browser.test.ts\\n     6\\t *\\n     7\\t * 1. Type-checks every example against the package's declarations (packages/axylo/dist/index.d.ts and\\n     8\\t *    packages/react/dist/index.d.ts, reached through the workspace packages `axylo` and `@axylo/react`).\\n     9\\t * 2. Builds the site, which compiles the examples with esbuild and copies the library's built files.\\n    10\\t * 3. Opens each example's page in system Chrome and checks: every chart has an accessible name; every\\n    11\\t *    chart draws marks unless the example says it draws none on purpose; no console errors or page errors;\\n    12\\t *    the diagnostics printed are exactly the ones the example says it raises on purpose.\\n    13\\t *\\n    14\\t * Examples run in America/Los_Angeles, where an instant at UTC midnight is the previous evening, so the\\n    15\\t * date examples are exercised where they matter, and at 760 px, about the width an example has on a\\n    16\\t * documentation page on a desktop screen.\\n    17\\t */\\n    18\\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\\n    19\\timport { execFileSync } from 'node:child_process';\\n    20\\timport path from 'node:path';\\n    21\\timport { chromium, type Browser } from 'playwright-core';\\n    22\\timport { buildSite } from '../lib/site.mjs';\\n    23\\timport { docsRoot, listExamples, repoRoot, writeTypecheckInputs } from '../lib/examples.mjs';\\n    24\\timport { serve } from '../lib/serve.mjs';\\n    25\\t\\n    26\\tinterface Example { name: string; file: string; ext: string; raises: string[]; noMarks: boolean }\\n    27\\t\\n    28\\t// Through node itself, so the same call works on Windows, where node_modules/.bin/tsc is a shell script.\\n    29\\tconst tsc = path.join(repoRoot, 'node_modules/typescript/bin/tsc');\\n    30\\t// Read from the sources at collection time, so each example is its own test.\\n    31\\tconst examples: Example[] = listExamples();\\n    32\\tlet server: Awaited<ReturnType<typeof serve>>;\\n    33\\tlet browser: Browser;\\n    34\\t\\n    35\\tfunction typecheck(config: string): string {\\n    36\\t  try {\\n    37\\t    execFileSync(process.execPath, [tsc, '-p', path.join(docsRoot, 'examples', config)], { cwd: repoRoot, encoding: 'utf8', stdio: 'pipe' });\\n    38\\t    return '';\\n    39\\t  } catch (error) {\\n    40\\t    const e = error as { stdout?: string; stderr?: string };\\n    41\\t    return `${e.stdout ?? ''}${e.stderr ?? ''}` || String(error);\\n    42\\t  }\\n    43\\t}\\n    44\\t\\n    45\\tbeforeAll(async () => {\\n    46\\t  writeTypecheckInputs();\\n    47\\t  await buildSite();\\n    48\\t  server = await serve();\\n    49\\t  browser = await chromium.launch({ channel: 'chrome', headless: true });\\n    50\\t}, 120_000);\\n    51\\t\\n    52\\tafterAll(async () => {\\n    53\\t  await browser?.close();\\n    54\\t  await server?.close();\\n    55\\t});\\n    56\\t\\n    57\\tdescribe('examples type-check against the package declarations', () => {\\n    58\\t  it('TypeScript and React examples (strict)', () => {\\n    59\\t    expect(typecheck('tsconfig.json')).toBe('');\\n    60\\t  });\\n    61\\t  it('scripts of the HTML examples (checkJs)', () => {\\n    62\\t    expect(typecheck('tsconfig.html.json')).toBe('');\\n    63\\t  });\\n    64\\t});\\n    65\\t\\n    66\\tdescribe('examples render in Chrome from the built library', () => {\\n    67\\t  it('there are examples', () => {\\n    68\\t    expect(examples.length).toBeGreaterThan(20);\\n    69\\t  });\\n    70\\t\\n    71\\t  it.each(examples.map(example => [example.file, example] as const))('%s', async (_file, example) => {\\n    72\\t    const context = await browser.newContext({\\n    73\\t      viewport: { width: 760, height: 900 }, locale: 'en-US', timezoneId: 'America/Los_Angeles',\\n    74\\t    });\\n    75\\t    const page = await context.newPage();\\n    76\\t    const errors: string[] = [];\\n    77\\t    const codes = new Set<string>();\\n    78\\t    page.on('pageerror', error => errors.push(`page error: ${error.message}`));\\n    79\\t    page.on('console', message => {\\n    80\\t      const text = message.text();\\n    81\\t      if (message.type() === 'error') errors.push(`console.error: ${text}`);\\n    82\\t      for (const m of text.matchAll(/^\\\\[axylo (AX\\\\d{3})\\\\]/g)) codes.add(m[1]!);\\n    83\\t      if (message.type() === 'warning' && !text.startsWith('[axylo ')) errors.push(`console.warn: ${text}`);\\n    84\\t    });\\n    85\\t    page.on('requestfailed', request => errors.push(`request failed: ${request.url()}`));\\n    86\\t    page.on('response', response => { if (response.status() >= 400) errors.push(`HTTP ${response.status()}: ${response.url()}`); });\\n    87\\t    await page.goto(server.url(`apps/docs/dist/examples/${example.name}.html`));\\n    88\\t\\n    89\\t    // Ready when every chart has drawn marks or shows a state message, and nothing changes for 3 frames.\\n    90\\t    await page.waitForFunction(() => {\\n    91\\t      const figures = [...document.querySelectorAll('figure.axylo-figure')];\\n    92\\t      return figures.length > 0 && figures.every(f =>\\n    93\\t        f.querySelector('svg [style*=\\\"--axylo-series-color\\\"], canvas') !== null ||\\n    94\\t        [...f.querySelectorAll('.axylo-message')].some(m => !(m as HTMLElement).hidden && m.textContent));\\n    95\\t    }, null, { timeout: 15_000 });\\n    96\\t    await page.evaluate(() => new Promise(resolve => {\\n    97\\t      let n = 0;\\n    98\\t      const tick = () => (++n < 3 ? requestAnimationFrame(tick) : resolve(null));\\n    99\\t      requestAnimationFrame(tick);\\n   100\\t    }));\\n   101\\t\\n   102\\t    const charts = await page.evaluate(() => [...document.querySelectorAll('figure.axylo-figure')].map(f => {\\n   103\\t      const labelled = f.getAttribute('aria-labelledby');\\n   104\\t      const name = (f.getAttribute('aria-label') ?? '') ||\\n   105\\t        (labelled ?? '').split(/\\\\s+/).map(id => document.getElementById(id)?.textContent ?? '').join(' ').trim();\\n   106\\t      const marks = [...f.querySelectorAll('svg [style*=\\\"--axylo-series-color\\\"]')].filter(el => {\\n   107\\t        const box = (el as SVGGraphicsElement).getBBox();\\n   108\\t        return box.width > 0 || box.height > 0;\\n   109\\t      }).length;\\n   110\\t      const message = [...f.querySelectorAll('.axylo-message')].find(m => !(m as HTMLElement).hidden)?.textContent ?? '';\\n   111\\t      return { role: f.getAttribute('role'), name, marks, message };\\n   112\\t    }));\\n   113\\t\\n   114\\t    expect(charts.length, `${example.file}: charts`).toBeGreaterThan(0);\\n   115\\t    for (const chart of charts) {\\n   116\\t      expect(['group', 'img'], `${example.file}: role`).toContain(chart.role);\\n   117\\t      expect(chart.name, `${example.file}: accessible name`).not.toBe('');\\n   118\\t      if (example.noMarks) expect(chart.message, `${example.file}: a state message`).not.toBe('');\\n   119\\t      else expect(chart.marks, `${example.file}: \\\"${chart.name}\\\" draws marks (message: \\\"${chart.message}\\\")`).toBeGreaterThan(0);\\n   120\\t    }\\n   121\\t    expect(errors, `${example.file}: errors`).toEqual([]);\\n   122\\t    expect([...codes].sort(), `${example.file}: diagnostics printed`).toEqual([...example.raises].sort());\\n   123\\t    await context.close();\\n   124\\t  }, 60_000);\\n   125\\t});\\napps/docs/test/node.browser.test.ts\\n     1\\t/**\\n     2\\t * Runs in Node, after `npm run build`, with the browser suite (it needs the built package, not a browser).\\n     3\\t * The Node examples quoted on the Diagnostics page (apps/docs/examples/node) type-check against the package's\\n     4\\t * declarations and run against its built files: chart-data.test.ts is itself a Vitest test and runs with this\\n     5\\t * suite; validate.ts is a script and is run here. Also checks the React page's statement about server\\n     6\\t * rendering, through the package as an application imports it.\\n     7\\t */\\n     8\\timport { describe, expect, it, vi } from 'vitest';\\n     9\\timport { execFile