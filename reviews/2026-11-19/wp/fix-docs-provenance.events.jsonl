row => ({\n   720\t    row,\n   721\t    cells: chartTypes.map(type => {\n   722\t      const cell = cellFor(row, type, root, sources, context);\n   723\t      counts[cell.status]++;\n   724\t      return cell;\n   725\t    }),\n   726\t  }));\n   727\t  const header = ['Criterion', 'Statement', ...chartTypes];\n   728\t  const printRow = cells => `| ${cells.map(escapeCell).join(' | ')} |`;\n   729\t  const describeCell = ({ status, reports }) => reports.size ? `${status} (${[...reports].map(([file, results]) =>\n   730\t    `${uniqueReportLabel(file, reportFiles, root)} ${[...results].sort().join('/')}`).join(', ')})` : status;\n   731\t  const table = [printRow(header), printRow(header.map(() => '---')),\n   732\t    ...rows.map(({ row, cells }) => printRow([row.id, row.statement, ...cells.map(describeCell)]))].join('\\n');\n   733\t  const summary = statuses.map(status => `- ${status} · ${counts[status]}`).join('\\n');\n   734\t  const from = resolve(root, 'acceptance');\n   735\t  const notesFile = resolve(from, 'review.json');\n   736\t  const notes = statSync(notesFile, { throwIfNoEntry: false }) ? json(notesFile) : null;\n   737\t  const review = notes && runs.length === 4 && runs.every(run => run.provenance?.commit === notes.commit) ? notes : null;\n   738\t  const report = ['# Acceptance report', '', ...describeRuns(runs, root), ...describeWarnings(warnings), ...describeSizes(rows, root, sources, from, sizeTargets, pack),\n   739\t    '', '## Status by chart type', '', summary, '',\n   740\t    'The matrix contains individual test citations and applicability reasons. ' + fileLink(from, root, relative(root, matrixFile)), '',\n   741\t    table, '', readerDetails(rows, root, from, review), ...describeReview(review, rows, counts)].join('\\n') + '\\n';\n   742\t  const blocked = rows.some(({ row, cells }) => cells.some(({ status }, i) =>\n   743\t    !['pass', 'not applicable'].includes(status)\n   744\t    && (!['not run', 'cannot be verified here'].includes(s