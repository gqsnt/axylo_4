);\\n    45\\t    expect(element, html).not.toBeNull();\\n    46\\t    const attributes = Object.fromEntries([...element![1]!.matchAll(/ ([\\\\w-]+)=\\\"([^\\\"]*)\\\"/g)].map(m => [m[1], m[2]]));\\n    47\\t    expect(attributes).toEqual({ id: 'sessions', class: 'axylo', 'data-card': 'kpi' });\\n    48\\t  });\\n    49\\t});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nreviews/2026-11-18/impl/wp/docs.review.events.jsonl:70:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_33\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"sed -n '934,999p' node_modules/vitest/dist/chunks/index.Di8au7q4.js\\nrg -n 'viteModuleRunner|moduleRunner.*transform|temporary.*file' node_modules/vitest/dist/chunks/index.Di8au7q4.js | head -40\\ncat apps/docs/test/diagnostics.browser.test.ts\\ncat apps/docs/test/markdown.test.ts\\\"\",\"aggregated_output\":\"\\t\\t\\t\\ttype: \\\"builtin\\\"\\n\\t\\t\\t};\\n\\t\\t}\\n\\t\\tif (url === \\\"/@vite/client\\\" || url === \\\"@vite/client\\\") {\\n\\t\\t\\ttrace.setAttribute(\\\"vitest.module.external\\\", url);\\n\\t\\t\\treturn {\\n\\t\\t\\t\\texternalize: \\\"/@vite/client\\\",\\n\\t\\t\\t\\ttype: \\\"module\\\"\\n\\t\\t\\t};\\n\\t\\t}\\n\\t\\tconst isFileUrl = url.startsWith(\\\"file://\\\");\\n\\t\\tif (isExternalUrl(url) && !isFileUrl) {\\n\\t\\t\\ttrace.setAttribute(\\\"vitest.module.external\\\", url);\\n\\t\\t\\treturn {\\n\\t\\t\\t\\texternalize: url,\\n\\t\\t\\t\\ttype: \\\"network\\\"\\n\\t\\t\\t};\\n\\t\\t}\\n\\t\\t// handle unresolved id of dynamic import skipped by Vite import analysis\\n\\t\\tif (url[0] !== \\\"/\\\") {\\n\\t\\t\\tconst resolved = await environment.pluginContainer.resolveId(url, importer);\\n\\t\\t\\tif (resolved) url = normalizeResolvedIdToUrl(environment, resolved.id);\\n\\t\\t}\\n\\t\\tconst moduleGraphModule = await environment.moduleGraph.ensureEntryFromUrl(unwrapId(url));\\n\\t\\tconst cached = !!moduleGraphModule.transformResult;\\n\\t\\tif (moduleGraphModule.file) trace.setAttribute(\\\"code.file.path\\\", moduleGraphModule.file);\\n\\t\\tif (options?.cached && cached) return { cache: true };\\n\\t\\tconst externalize = await this.resolver.shouldExternalize(moduleGraphModule.id);\\n\\t\\tif (externalize) return {\\n\\t\\t\\texternalize,\\n\\t\\t\\ttype: \\\"module\\\"\\n\\t\\t};\\n\\t\\tconst cachePath = await this.getCachePath(environment, moduleGraphModule);\\n\\t\\t// full fs caching is disabled, but we still want to keep tmp files if makeTmpCopies is enabled\\n\\t\\t// this is primarily used by the forks pool to avoid using process.send(bigBuffer)\\n\\t\\tif (cachePath == null) {\\n\\t\\t\\tconst result = await this.fetchAndProcess(environment, url, importer, moduleGraphModule, options);\\n\\t\\t\\tthis.recordResult(trace, result);\\n\\t\\t\\tif (!makeTmpCopies || !(\\\"code\\\" in result)) return result;\\n\\t\\t\\tconst transformResult = moduleGraphModule.transformResult;\\n\\t\\t\\tconst tmpPath = transformResult?.__vitestTmp;\\n\\t\\t\\tif (typeof tmpPath === \\\"string\\\") return getCachedResult(result, tmpPath);\\n\\t\\t\\tconst tmpDir = join(this.tmpProjectDir, environment.name);\\n\\t\\t\\tif (!this.tmpDirectories.has(tmpDir)) {\\n\\t\\t\\t\\tif (!existsSync(tmpDir)) mkdirSync(tmpDir, { recursive: true });\\n\\t\\t\\t\\tthis.tmpDirectories.add(tmpDir);\\n\\t\\t\\t}\\n\\t\\t\\tconst tmpFile = join(tmpDir, hash(\\\"sha1\\\", result.id, \\\"hex\\\"));\\n\\t\\t\\treturn this.cacheResult(result, tmpFile, transformResult).then((result) => {\\n\\t\\t\\t\\tif (transformResult) transformResult.__vitestTmp = tmpFile;\\n\\t\\t\\t\\treturn result;\\n\\t\\t\\t});\\n\\t\\t}\\n\\t\\tif (saveCachePromises.has(cachePath)) return saveCachePromises.get(cachePath).then((result) => {\\n\\t\\t\\tthis.recordResult(trace, result);\\n\\t\\t\\treturn result;\\n\\t\\t});\\n\\t\\tconst cachedModule = await this.getCachedModule(cachePath, environment, moduleGraphModule, importer);\\n\\t\\tif (cachedModule) {\\n\\t\\t\\tthis.recordResult(trace, cachedModule);\\n\\t\\t\\treturn cachedModule;\\n\\t\\t}\\n\\t\\tconst result = await this.fetchAndProcess(environment, url, importer, moduleGraphModule, options);\\n\\t\\tconst imports = this.getCachedImports(environment, moduleGraphModule);\\n\\t\\tconst map = moduleGraphModule.transformResult?.map;\\n\\t\\tconst mappings = map && !(\\\"version\\\" in map) && map.mappings === \\\"\\\";\\n4150:\\t\\t\\tviteModuleRunner: config.experimental.viteModuleRunner ?? true,\\n6518:\\t\\tthis.runner = this.config.experimental.viteModuleRunner === false ? new NativeModuleRunner(this.config.root) : new ServerModuleRunner(environment, this._transformService, this.config);\\n8930:\\tif (resolved.coverage.enabled && resolved.coverage.provider === \\\"istanbul\\\" && resolved.experimental?.viteModuleRunner === false) throw new Error(`\\\"Istanbul\\\" coverage provider is not compatible with \\\"experimental.viteModuleRunner: false\\\". Please, enable \\\"viteModuleRunner\\\" or switch to \\\"v8\\\" coverage provider.`);\\n/**\\n * Criterion DX4, on the built site: there is one page per code of the registry and no page for a code that\\n * does not exist. And the minimal inputs that can only raise their code in a page (contrast, size, labels,\\n * formatters, appends) do raise it, rendered with the built script-tag bundle in system Chrome.\\n *\\n *   npm run build && AXYLO_BROWSER=1 npx vitest run --config apps/docs/vitest.config.ts\\n */\\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\\nimport fs from 'node:fs';\\nimport path from 'node:path';\\nimport { chromium, type Browser } from 'playwright-core';\\nimport { buildSite } from '../lib/site.mjs';\\nimport { docsRoot } from '../lib/examples.mjs';\\nimport { serve } from '../lib/serve.mjs';\\nimport { diagnosticRegistry } from '../../../packages/axylo/src/diagnostics/registry';\\nimport { diagnostics } from '../data/diagnostics.mjs';\\n\\nlet server: Awaited<ReturnType<typeof serve>>;\\nlet browser: Browser;\\nconst dist = path.join(docsRoot, 'dist');\\n\\nbeforeAll(async () => {\\n  await buildSite();\\n  server = await serve();\\n  browser = await chromium.launch({ channel: 'chrome', headless: true });\\n}, 120_000);\\n\\nafterAll(async () => {\\n  await browser?.close();\\n  await server?.close();\\n});\\n\\ndescribe('one page per diagnostic code', () => {\\n  it('every code in the registry has a built page', () => {\\n    const missing = Object.keys(diagnosticRegistry).filter(code => !fs.existsSync(path.join(dist, 'diagnostics', `${code}.html`)));\\n    expect(missing).toEqual([]);\\n  });\\n  it('every built page is for a code in the registry', () => {\\n    const pages = fs.readdirSync(path.join(dist, 'diagnostics')).map(f => f.replace(/\\\\.html$/, ''));\\n    expect(pages.filter(code => !(code in diagnosticRegistry))).toEqual([]);\\n  });\\n  it('the diagnostics page links every code page', () => {\\n    const html = fs.readFileSync(path.join(dist, 'diagnostics.html'), 'utf8');\\n    expect(Object.keys(diagnosticRegistry).filter(code => !html.includes(`href=\\\"diagnostics/${code}.html\\\"`))).toEqual([]);\\n  });\\n});\\n\\ndescribe('minimal inputs that need a page raise their code', () => {\\n  const inPage = diagnostics.filter(d => d.run === 'browser');\\n  it.each(inPage.map(d => [d.code, d.input] as const))('%s', async (code, input) => {\\n    const context = await browser.newContext({ viewport: { width: 760, height: 700 }, locale: 'en-US', timezoneId: 'UTC' });\\n    const page = await context.newPage();\\n    const codes = new Set<string>();\\n    const errors: string[] = [];\\n    page.on('console', m => {\\n      if (m.type() === 'error') errors.push(m.text());\\n      for (const match of m.text().matchAll(/^\\\\[axylo (AX\\\\d{3})\\\\]/g)) codes.add(match[1]!);\\n    });\\n    page.on('pageerror', e => errors.push(e.message));\\n    await page.goto(server.url('apps/docs/dist/examples/script-tag.html'));\\n    await page.evaluate(source => {\\n      document.body.replaceChildren();\\n      const target = document.createElement('div');\\n      document.body.append(target);\\n      const { line, area, bar, scatter, donut } = (window as unknown as { Axylo: Record<string, unknown> }).Axylo;\\n      new Function('target', 'line', 'area', 'bar', 'scatter', 'donut', source)(target, line, area, bar, scatter, donut);\\n    }, input);\\n    await expect.poll(() => codes.has(code), { timeout: 5000 }).toBe(true);\\n    expect(errors).toEqual([]);\\n    await context.close();\\n  });\\n});\\n// The documentation's Markdown converter, on the subset the pages use. Expected HTML is written by hand.\\nimport { describe, expect, it } from 'vitest';\\nimport { escapeHtml, markdownToHtml, renderInline, slug, splitRow, wordCount } from '../lib/markdown.mjs';\\n\\ndescribe('inline', () => {\\n  it('escapes every special character in text', () => {\\n    expect(renderInline(`a < b & \\\"c\\\" > 'd'`)).toBe('a &lt; b &amp; &quot;c&quot; &gt; &#39;d&#39;');\\n  });\\n  it('never passes HTML through', () => {\\n    expect(renderInline('<script>alert(1)</script>')).toBe('&lt;script&gt;alert(1)&lt;/script&gt;');\\n    expect(renderInline('<img src=x onerror=alert(1)>')).not.toContain('<img');\\n  });\\n  it('renders code spans with their content escaped', () => {\\n    expect(renderInline('use `<div>` here')).toBe('use <code>&lt;div&gt;</code> here');\\n  });\\n  it('renders a code span that contains a backtick with a double fence', () => {\\n    expect(renderInline('`` `AX${number}` ``')).toBe('<code>`AX${number}`</code>');\\n  });\\n  it('renders strong and emphasis, and leaves a lone asterisk alone', () => {\\n    expect(renderInline('**bold** and *em*')).toBe('<strong>bold</strong> and <em>em</em>');\\n    expect(renderInline('2 * 3 = 6')).toBe('2 * 3 = 6');\\n  });\\n  it('renders links, rewrites their targets and escapes them', () => {\\n    const link = (url: string) => url.replace(/\\\\.md/, '.html');\\n    expect(renderInline('see [the data page](data.md#gaps)', link)).toBe('see <a href=\\\"data.html#gaps\\\">the data page</a>');\\n    expect(renderInline('[x](a\\\"b)')).toBe('<a href=\\\"a&quot;b\\\">x</a>');\\n  });\\n  it('allows code inside link text', () => {\\n    expect(renderInline('[`zoom`](updating.md)')).toBe('<a href=\\\"updating.md\\\"><code>zoom</code></a>');\\n  });\\n  it('honours backslash escapes', () => {\\n    expect(renderInline('\\\\\\\\*not em\\\\\\\\* and a \\\\\\\\| pipe')).toBe('*not em* and a | pipe');\\n  });\\n});\\n\\ndescribe('blocks', () => {\\n  it('turns headings into elements with GitHub-style ids, unique per page', () => {\\n    const headings: { level: number; text: string; id: string }[] = [];\\n    const html = markdownToHtml('# Title\\\\n\\\\n## What is not in 1.0\\\\n\\\\n## Notes\\\\n\\\\n## Notes', { headings });\\n    expect(html).toContain('<h1 id=\\\"title\\\">Title</h1>');\\n    expect(html).toContain('<h2 id=\\\"what-is-not-in-10\\\">What is not in 1.0</h2>');\\n    expect(headings.map(h => h.id)).toEqual(['title', 'what-is-not-in-10', 'notes', 'notes-2']);\\n  });\\n  it('slugs drop code markers and punctuation like GitHub', () => {\\n    expect(slug('validate() in Node and in tests')).toBe('validate-in-node-and-in-tests');\\n    expect(slug('update: change options')).toBe('update-change-options');\\n    expect(slug('`compact`')).toBe('compact');\\n  });\\n  it('joins paragraph lines and separates paragraphs', () => {\\n    expect(markdownToHtml('one\\\\ntwo\\\\n\\\\nthree')).toBe('<p>one two</p>\\\\n<p>three</p>');\\n  });\\n  it('keeps fenced code verbatim and escaped, with its language', () => {\\n    expect(markdownToHtml('```ts\\\\nconst a = 1 < 2;\\\\n  **not bold**\\\\n```'))\\n      .toBe('<pre tabindex=\\\"0\\\"><code class=\\\"language-ts\\\">const a = 1 &lt; 2;\\\\n  **not bold**</code></pre>');\\n  });\\n  it('renders bulleted and numbered lists, with indented continuation lines', () => {\\n    expect(markdownToHtml('- a\\\\n- b\\\\n  more')).toBe('<ul><li>a</li><li>b more</li></ul>');\\n    expect(markdownToHtml('1. first\\\\n2. second')).toBe('<ol><li>first</li><li>second</li></ol>');\\n    expect(markdownToHtml('3. third')).toBe('<ol start=\\\"3\\\"><li>third</li></ol>');\\n  });\\n  it('renders block quotes', () => {\\n    expect(markdownToHtml('> note\\\\n> more')).toBe('<blockquote><p>note more</p></blockquote>');\\n  });\\n  it('drops whole-line HTML comments', () => {\\n    expect(markdownToHtml('<!-- options: Title -->\\\\ntext')).toBe('<p>text</p>');\\n  });\\n  it('renders pipe tables with headers, alignment and escaped pipes', () => {\\n    const html = markdownToHtml('| Key | Type |\\\\n|---|---:|\\\\n| `a` | `1 \\\\\\\\| 2` |');\\n    expect(html).toContain('<th scope=\\\"col\\\">Key</th><th scope=\\\"col\\\" style=\\\"text-align: right\\\">Type</th>');\\n    expect(html).toContain('<td><code>a</code></td><td style=\\\"text-align: right\\\"><code>1 | 2</code></td>');\\n    expect(html).toMatch(/^<div class=\\\"table-scroll\\\" tabindex=\\\"0\\\" role=\\\"region\\\" aria-label=\\\"Table\\\"><table>/);\\n  });\\n  it('names each table region after its heading, uniquely', () => {\\n    const html = markdownToHtml('## Keys\\\\n\\\\n| a |\\\\n|---|\\\\n| 1 |\\\\n\\\\n| b |\\\\n|---|\\\\n| 2 |');\\n    expect(html).toContain('aria-label=\\\"Table: Keys\\\"');\\n    expect(html).toContain('aria-label=\\\"Table 2: Keys\\\"');\\n  });\\n  it('splits rows only on unescaped pipes', () => {\\n    expect(splitRow('| a | `b \\\\\\\\| c` | d |')).toEqual(['a', '`b \\\\\\\\| c`', 'd']);\\n  });\\n  it('hands directive lines to the caller and keeps other links inline', () => {\\n    const seen: unknown[] = [];\\n    const html = markdownToHtml('[example: first](../examples/first.ts)\\\\n\\\\n[a link](x.md)', {\\n      directive: d => { seen.push(d); return '<div>live</div>'; },\\n    });\\n    expect(seen).toEqual([{ kind: 'example', name: 'first', target: '../examples/first.ts' }]);\\n    expect(html).toBe('<div>live</div>\\\\n<p><a href=\\\"x.md\\\">a link</a></p>');\\n  });\\n});\\n\\ndescribe('helpers', () => {\\n  it('escapeHtml escapes quotes for attributes', () => {\\n    expect(escapeHtml(`\\\"'`)).toBe('&quot;&#39;');\\n  });\\n  it('wordCount counts prose, not code, comments or directives', () => {\\n    expect(wordCount('# Two words\\\\n\\\\n```\\\\nnot counted at all\\\\n```\\\\n<!-- skip -->\\\\n[example: x](y.ts)\\\\nthree more words')).toBe(5);\\n  });\\n});\\n\",\"exit_code\":0,\"status\":\"completed\"}}\nreviews/2026-11-18/impl/wp/docs.review.events.jsonl:162:{\"type\":\"item.completed\",\"item\":{\"id\":\"item_79\",\"type\":\"command_execution\",\"command\":\"/bin/bash -lc \\\"nl -ba apps/docs/data/diagnostics.mjs | rg 'code:|why:|AX[0-9]+:' && rg -n 'function |const .*=>' apps/docs/lib/site.mjs apps/docs/lib/markdown.mjs\\\"\",\"aggregated_output\":\"    13\\t    code: 'AX100', level: 'error', title: 'Columns of different lengths',\\n    16\\t    why: 'With typed columns, row *i* is element *i* of every column. When the lengths differ there is no way to tell which values belong together, so Axylo draws nothing rather than pair them wrongly.',\\n    27\\t    code: 'AX101', level: 'error', title: 'A field that is not in the data',\\n    30\\t    why: 'Usually a typo, or rows from an API whose field names changed. With typed rows in TypeScript the same mistake does not compile; with untyped rows this is how you find it.',\\n    41\\t    code: 'AX102', level: 'warning', title: 'A field absent from some rows',\\n    44\\t    why: 'An explicit `null` means \\\"no data\\\" and is drawn as a gap without comment. An absent key may mean the same thing, or a bug that dropped the field, so Axylo draws the gap and says so.',\\n    55\\t    code: 'AX103', level: 'warning', title: 'A value that is not a finite number',\\n    58\\t    why: '`NaN` and `Infinity` are almost always the result of a calculation (a division by zero, a parse that failed), not a measurement. Drawing them is impossible and treating them as zero would be wrong.',\\n    69\\t    code: 'AX104', level: 'hint', title: 'Numbers sent as strings',\\n    72\\t    why: 'Many database drivers return big integers and decimals as strings (Postgres `bigint` and `numeric`, BigQuery). A whole column of plain decimal strings is unambiguous, so Axylo parses it, and asks you to say so. An empty string counts as missing.',\\n    83\\t    code: 'AX105', level: 'hint', title: 'Steps missing on a regular axis',\\n    86\\t    why: 'Daily data with a missing day usually means that day had no data, not that the line should run straight from the day before to the day after. Axylo finds the step from the data and does not bridge an absent one.',\\n   100\\t    code: 'AX106', level: 'warning', title: 'Strings among numbers',\\n   103\\t    why: 'A stray string in a column of numbers is a bug somewhere upstream. Strings such as `\\\\'1,234\\\\'` or `\\\\'n/a\\\\'` depend on a locale or a convention Axylo cannot know, so it does not guess.',\\n   114\\t    code: 'AX107', level: 'warning', title: 'A date or time that cannot be read',\\n   117\\t    why: 'The x field was recognised as dates (most values are `YYYY-MM-DD`), and this value is not a valid one: a day that does not exist, or another format.',\\n   128\\t    code: 'AX108', level: 'error', title: 'Two rows for the same x',\\n   131\\t    why: 'On a line, area or bar chart one x has one value per series. Two rows for the same x would need a rule (sum, last, average) that only you know.',\\n   142\\t    code: 'AX109', level: 'hint', title: 'Numbers that look like timestamps, or like seconds',\\n   145\\t    why: 'Axylo never assumes a bare number is an instant (F4), because a wrong guess moves every point. It does notice when numbers look like epoch milliseconds or seconds, and tells you.',\\n   156\\t    code: 'AX110', level: 'warning', title: 'A bar or area domain without zero',\\n   159\\t    why: 'The length of a bar or the height of an area is its value. A baseline other than zero makes 82 look like a fraction of 97 (F1).',\\n   170\\t    code: 'AX111', level: 'hint', title: 'Instants that look like calendar dates',\\n   173\\t    why: 'A daily metric is usually a calendar date. Sent as `2026-02-24T00:00:00Z` (or epoch milliseconds of a UTC midnight) it is an instant, which is a different thing: the same moment is a different day in different places.',\\n   188\\t    code: 'AX112', level: 'hint', title: 'Date-times without an offset',\\n   191\\t    why: '`2026-02-24T09:30` without `Z` or `+01:00` is a wall-clock time: it says what a clock showed, not when. Axylo shows it as written rather than guess a zone.',\\n   202\\t    code: 'AX120', level: 'error', title: 'A negative donut value',\\n   205\\t    why: 'A slice is a share of a whole. A negative share cannot be drawn as an arc, and dropping it would change every other slice\\\\'s percentage.',\\n   216\\t    code: 'AX121', level: 'warning', title: 'More than eight donut slices',\\n   219\\t    why: 'Beyond about eight slices, small arcs cannot be told apart or labelled, and the palette has eight colours.',\\n   230\\t    code: 'AX130', level: 'warning', title: 'More than eight series',\\n   233\\t    why: 'Eight colours is about as many as a reader can keep apart, also with a colour-vision deficiency (F9).',\\n   246\\t    code: 'AX131', level: 'hint', title: 'Several series in a compact chart',\\n   249\\t    why: 'A compact chart has no legend, axes or tooltip, so nothing tells the reader which line is which.',\\n   261\\t    code: 'AX132', level: 'hint', title: 'More bars than pixels',\\n   264\\t    why: 'Bars narrower than a pixel blur into an area and cannot be picked or compared.',\\n   277\\t    code: 'AX133', level: 'hint', title: 'A very large scatter chart',\\n   280\\t    why: 'Scatter points are not simplified in 1.0, so every point is drawn on every frame.',\\n   291\\t    code: 'AX134', level: 'error', title: 'Too many series × x positions',\\n   294\\t    why: 'Line, area and bar charts align every series on every x. Long rows with many series that share few x values (for example one series per user) multiply into more slots than a chart can hold.',\\n   306\\t    code: 'AX140', level: 'warning', title: 'A chart without a name',\\n   309\\t    why: 'A screen-reader user moving through a dashboard hears each chart\\\\'s name first. A generated name says what is plotted, not what it means.',\\n   319\\t    code: 'AX141', level: 'warning', title: 'Series colours too close to the background',\\n   322\\t    why: 'Marks need 3:1 against what is behind them to be seen (WCAG 1.4.11). Axylo measures the colours the browser actually resolved against the colour actually behind the chart, so a dark card on a light page is measured as dark.',\\n   335\\t    code: 'AX142', level: 'hint', title: 'Not enough room for a plot',\\n   338\\t    why: 'A plot that small cannot hold readable axes (L8). Drawing it anyway would produce overlapping or clipped labels.',\\n   352\\t    code: 'AX143', level: 'hint', title: 'Labels hidden after every remedy',\\n   355\\t    why: 'Axylo tries, in order: thinning (ordered axes only), wrapping to three lines, rotating up to 45°, and truncating in the middle. It never overlaps labels and never hides one without telling the reader (L1).',\\n   368\\t    code: 'AX150', level: 'warning', title: 'An option Axylo does not know',\\n   371\\t    why: 'A misspelled option would otherwise be ignored in silence. In TypeScript the same mistake does not compile.',\\n   383\\t    code: 'AX151', level: 'warning', title: 'Appended rows out of order',\\n   386\\t    why: '`append` is the fast path for rows that extend the series. A row before the last x needs the whole frame rebuilt, which is correct but slower, and usually means the feed is not ordered.',\\n   399\\t    code: 'AX152', level: 'warning', title: 'An unknown time zone',\\n   402\\t    why: 'Time zones come from the browser\\\\'s `Intl` data. A misspelled or retired zone name cannot be resolved.',\\n   413\\t    code: 'AX160', level: 'warning', title: 'A custom formatter threw',\\n   416\\t    why: 'A formatter is your code running inside the chart. One that throws for an unexpected value (a `null`, a negative) must not take the chart down.',\\n   428\\t    code: 'AX199', level: 'error', title: 'Axylo failed',\\n   431\\t    why: 'Something inside Axylo threw. The chart catches it so that the rest of the page keeps working.',\\napps/docs/lib/markdown.mjs:14:export function escapeHtml(text) {\\napps/docs/lib/markdown.mjs:22:export function slug(text) {\\napps/docs/lib/markdown.mjs:27:export function plainText(text) {\\napps/docs/lib/markdown.mjs:50:export function markdownToHtml(source, { link = url => url, directive, headings = [] } = {}) {\\napps/docs/lib/markdown.mjs:54:  const inline = text => renderInline(text, link);\\napps/docs/lib/markdown.mjs:58:  const tableName = () => {\\napps/docs/lib/markdown.mjs:96:      const align = splitRow(lines[i + 1]).map(cell => cell.endsWith(':') ? (cell.startsWith(':') ? 'center' : 'right') : null);\\napps/docs/lib/markdown.mjs:145:function startsBlock(lines, i) {\\napps/docs/lib/markdown.mjs:152:export function splitRow(line) {\\napps/docs/lib/markdown.mjs:166:function table(header, rows, align, inline, name = 'Table') {\\napps/docs/lib/markdown.mjs:167:  const style = index => align[index] ? ` style=\\\"text-align: ${align[index]}\\\"` : '';\\napps/docs/lib/markdown.mjs:168:  const head = header.map((cell, index) => `<th scope=\\\"col\\\"${style(index)}>${inline(cell)}</th>`).join('');\\napps/docs/lib/markdown.mjs:169:  const body = rows.map(row => `<tr>${header.map((_, index) => `<td${style(index)}>${inline(row[index] ?? '')}</td>`).join('')}</tr>`).join('');\\napps/docs/lib/markdown.mjs:174:export function codeBlock(code, language = '') {\\napps/docs/lib/markdown.mjs:180:export function renderInline(text, link = url => url) {\\napps