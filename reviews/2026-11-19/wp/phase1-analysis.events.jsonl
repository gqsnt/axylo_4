{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc 'cat research/harness/src/libs/{highcharts.js,chartjs.js,d3.js,uplot.js,apexcharts.js}'","aggregated_output":"import Highcharts from 'highcharts';\nimport 'highcharts/modules/accessibility'; // separate module; Highcharts logs a console hint when it is missing\n\nexport const meta = { name: 'Highcharts', pkg: 'highcharts' };\n\nexport function trend(el, d) {\n  const chart = Highcharts.chart(el, {\n    title: { text: d.title },\n    xAxis: { type: 'datetime' },\n    yAxis: { title: { text: d.yTitle } },\n    series: d.series.map(s => ({ name: s.name, data: s.values.map((v, i) => [d.t[i], v]) })),\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport function bars(el, d) {\n  const chart = Highcharts.chart(el, {\n    chart: { type: 'column' },\n    title: { text: d.title },\n    xAxis: { categories: d.categories },\n    yAxis: { title: { text: d.yTitle } },\n    series: [{ name: d.name, data: d.values }],\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport function parts(el, d) {\n  const chart = Highcharts.chart(el, {\n    chart: { type: 'pie' },\n    title: { text: d.title },\n    series: [{ name: d.name, innerSize: '50%', data: d.labels.map((l, i) => [l, d.values[i]]) }],\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport function dirty(el, d) {\n  const chart = Highcharts.chart(el, {\n    title: { text: d.title },\n    xAxis: { categories: d.categories },\n    series: [{ name: d.name, data: d.values }],\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport function scale(el, d) {\n  const chart = Highcharts.chart(el, {\n    title: { text: d.title },\n    xAxis: { type: 'datetime' },\n    series: [{ name: d.name, data: d.t.map((t, i) => [t, d.y[i]]) }],\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport function stream(el, d) {\n  const h = scale(el, d);\n  h.push = (x, y) => h.chart.series[0].addPoint([x, y], true, true);\n  return h;\n}\n\nexport function dates(el, d) {\n  const chart = Highcharts.chart(el, { title: { text: d.title }, xAxis: { type: 'datetime' },\n    series: d.series.map(s => ({ name: s.name, data: s.values.map((v, i) => [d.days[i], v]) })) });\n  return { chart, destroy: () => chart.destroy() };\n}\nimport { Chart } from 'chart.js/auto';\nimport 'chartjs-adapter-date-fns'; // a date adapter is required before a time scale works\n\nexport const meta = { name: 'Chart.js', pkg: 'chart.js' };\nconst canvas = el => el.appendChild(document.createElement('canvas'));\n// maintainAspectRatio:false is needed for the chart to fill a fixed-height container\nconst base = d => ({ maintainAspectRatio: false, plugins: { title: { display: true, text: d.title } } });\n\nexport function trend(el, d) {\n  const chart = new Chart(canvas(el), {\n    type: 'line',\n    data: { labels: d.t, datasets: d.series.map(s => ({ label: s.name, data: s.values })) },\n    options: { ...base(d), scales: { x: { type: 'time' }, y: { title: { display: true, text: d.yTitle } } } },\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport function bars(el, d) {\n  const chart = new Chart(canvas(el), {\n    type: 'bar',\n    data: { labels: d.categories, datasets: [{ label: d.name, data: d.values }] },\n    options: { ...base(d), scales: { y: { title: { display: true, text: d.yTitle } } } },\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport function parts(el, d) {\n  const chart = new Chart(canvas(el), {\n    type: 'doughnut',\n    data: { labels: d.labels, datasets: [{ label: d.name, data: d.values }] },\n    options: base(d),\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport function dirty(el, d) {\n  const chart = new Chart(canvas(el), {\n    type: 'line',\n    data: { labels: d.categories, datasets: [{ label: d.name, data: d.values }] },\n    options: base(d),\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport function scale(el, d) {\n  const chart = new Chart(canvas(el), {\n    type: 'line',\n    data: { labels: d.t, datasets: [{ label: d.name, data: d.y }] },\n    options: { ...base(d), scales: { x: { type: 'time' } } },\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport function stream(el, d) {\n  const h = scale(el, d), { chart } = h;\n  h.push = (x, y) => {\n    chart.data.labels.push(x); chart.data.labels.shift();\n    chart.data.datasets[0].data.push(y); chart.data.datasets[0].data.shift();\n    chart.update();\n  };\n  return h;\n}\n\nexport function dates(el, d) {\n  const chart = new Chart(canvas(el), {\n    type: 'line',\n    data: { labels: d.days, datasets: d.series.map(s => ({ label: s.name, data: s.values })) },\n    options: { ...base(d), scales: { x: { type: 'time' } } },\n  });\n  return { chart, destroy: () => chart.destroy() };\n}\nimport * as d3 from 'd3';\n\n// D3 has no chart-level API. These follow the structure of the official gallery examples\n// (line chart, bar chart, donut chart); title, legend and readout are hand-built.\nexport const meta = { name: 'D3', pkg: 'd3' };\n\nfunction frame(el, d) {\n  const width = el.clientWidth, height = el.clientHeight;\n  const m = { top: 44, right: 24, bottom: 30, left: 56 };\n  const svg = d3.select(el).append('svg').attr('width', width).attr('height', height)\n    .attr('viewBox', [0, 0, width, height]).attr('style', 'max-width: 100%; height: auto; font: 10px sans-serif;');\n  svg.append('text').attr('x', m.left).attr('y', 16).attr('font-size', 14).attr('font-weight', 'bold').attr('fill', 'currentColor').text(d.title);\n  return { svg, width, height, m };\n}\n\nfunction yAxis(svg, y, { width, height, m }, label) {\n  svg.append('g').attr('transform', `translate(${m.left},0)`).call(d3.axisLeft(y).ticks(height / 40))\n    .call(g => g.select('.domain').remove())\n    .call(g => g.selectAll('.tick line').clone().attr('x2', width - m.left - m.right).attr('stroke-opacity', 0.1))\n    .call(g => label && g.append('text').attr('x', -m.left).attr('y', 34).attr('fill', 'currentColor').attr('text-anchor', 'start').text(`↑ ${label}`));\n}\n\nfunction lineChart(el, d, names, cols, t, fromZero = true) {\n  const f = frame(el, d), { svg, width, height, m } = f;\n  const x = d3.scaleUtc(d3.extent(t), [m.left, width - m.right]);\n  const lo = fromZero ? 0 : d3.min(cols, c => d3.min(c));\n  const y = d3.scaleLinear([lo, d3.max(cols, c => d3.max(c))], [height - m.bottom, m.top]).nice();\n  const color = d3.scaleOrdinal(names, d3.schemeTableau10);\n  const xAxisG = svg.append('g').attr('transform', `translate(0,${height - m.bottom})`);\n  const drawX = () => xAxisG.call(d3.axisBottom(x).ticks(width / 80).tickSizeOuter(0));\n  drawX();\n  yAxis(svg, y, f, d.yTitle);\n  const line = d3.line().defined(v => v != null).x((v, i) => x(t[i])).y(v => y(v));\n  const paths = svg.append('g').attr('fill', 'none').attr('stroke-width', 1.5)\n    .selectAll('path').data(cols).join('path').attr('stroke', (c, i) => color(names[i])).attr('d', c => line(c));\n  // legend\n  const lg = svg.append('g').attr('transform', `translate(${width - m.right - 330},8)`);\n  names.forEach((n, i) => {\n    const g = lg.append('g').attr('transform', `translate(${i * 110},0)`);\n    g.append('rect').attr('width', 12).attr('height', 12).attr('fill', color(n));\n    g.append('text').attr('x', 16).attr('y', 10).attr('fill', 'currentColor').text(n);\n  });\n  // readout on pointer move\n  const rule = svg.append('line').attr('stroke', 'currentColor').attr('stroke-opacity', 0.4).attr('y1', m.top).attr('y2', height - m.bottom).attr('display', 'none');\n  const tip = svg.append('text').attr('fill', 'currentColor').attr('y', m.top - 6).attr('display', 'none');\n  const fmt = d3.utcFormat('%b %-d, %Y'), num = d3.format(',');\n  svg.on('pointermove', e => {\n    const i = d3.bisectCenter(t, x.invert(d3.pointer(e)[0]));\n    rule.attr('display', null).attr('x1', x(t[i])).attr('x2', x(t[i]));\n    tip.attr('display', null).attr('x', Math.min(x(t[i]), width - 300))\n      .text(`${fmt(t[i])} — ` + names.map((n, k) => `${n}: ${cols[k][i] == null ? 'no data' : num(cols[k][i])}`).join(' · '));\n  }).on('pointerleave', () => { rule.attr('display', 'none'); tip.attr('display', 'none'); });\n  return { svg, x, y, line, paths, drawX, destroy: () => svg.remove() };\n}\n\nexport function trend(el, d) {\n  return lineChart(el, d, d.series.map(s => s.name), d.series.map(s => s.values), d.t);\n}\n\nexport function bars(el, d) {\n  const f = frame(el, d), { svg, width, height, m } = f;\n  const x = d3.scaleBand(d.categories, [m.left, width - m.right]).padding(0.1);\n  const y = d3.scaleLinear([0, d3.max(d.values)], [height - m.bottom, m.top]);\n  svg.append('g').attr('fill', 'steelblue').selectAll('rect').data(d.values).join('rect')\n    .attr('x', (v, i) => x(d.categories[i])).attr('y', v => y(v)).attr('height', v => y(0) - y(v)).attr('width', x.bandwidth())\n    .append('title').text((v, i) => `${d.categories[i]}: ${v}`);\n  svg.append('g').attr('transform', `translate(0,${height - m.bottom})`).call(d3.axisBottom(x).tickSizeOuter(0));\n  yAxis(svg, y, f, d.yTitle);\n  return { destroy: () => svg.remove() };\n}\n\nexport function parts(el, d) {\n  const { svg, width, height } = frame(el, d);\n  const radius = Math.min(width, height - 40) / 2;\n  const arc = d3.arc().innerRadius(radius * 0.5).outerRadius(radius - 1);\n  const pie = d3.pie().padAngle(1 / radius).sort(null);\n  const color = d3.scaleOrdinal(d.labels, d3.quantize(t => d3.interpolateSpectral(t * 0.8 + 0.1), d.labels.length).reverse());\n  const g = svg.append('g').attr('transform', `translate(${width / 2},${height / 2 + 16})`);\n  g.selectAll('path').data(pie(d.values)).join('path').attr('fill', (a, i) => color(d.labels[i])).attr('d', arc)\n    .append('title').text((a, i) => `${d.labels[i]}: ${a.data}`);\n  g.append('g').attr('font-size', 12).attr('text-anchor', 'middle').selectAll('text').data(pie(d.values)).join('text')\n    .attr('transform', a => `translate(${arc.centroid(a)})`)\n    .call(t => t.append('tspan').attr('y', '-0.4em').attr('font-weight', 'bold').text((a, i) => d.labels[i]))\n    .call(t => t.filter(a => a.endAngle - a.startAngle > 0.25).append('tspan').attr('x', 0).attr('y', '0.7em').attr('fill-opacity', 0.7).text(a => a.data));\n  return { destroy: () => svg.remove() };\n}\n\nexport function dirty(el, d) {\n  const f = frame(el, d), { svg, width, height, m } = f;\n  const x = d3.scalePoint(d.categories, [m.left, width - m.right]);\n  const y = d3.scaleLinear([0, d3.max(d.values)], [height - m.bottom, m.top]);\n  svg.append('g').attr('transform', `translate(0,${height - m.bottom})`).call(d3.axisBottom(x));\n  yAxis(svg, y, f);\n  const line = d3.line().x((v, i) => x(d.categories[i])).y(v => y(v)); // no .defined(): what you get if you forget it\n  svg.append('path').attr('fill', 'none').attr('stroke', 'steelblue').attr('stroke-width', 1.5).attr('d', line(d.values));\n  return { destroy: () => svg.remove() };\n}\n\nexport function scale(el, d) {\n  return lineChart(el, d, [d.name], [d.y.slice()], d.t.slice(), false);\n}\n\nexport function stream(el, d) {\n  const t = d.t.slice(), yv = d.y.slice();\n  const h = lineChart(el, d, [d.name], [yv], t, false);\n  // moves the x domain, redraws the x axis and re-paths; the y axis keeps its initial range\n  h.push = (x, y) => { t.push(x); t.shift(); yv.push(y); yv.shift(); h.x.domain([t[0], t[t.length - 1]]); h.drawX(); h.paths.attr('d', c => h.line(c)); };\n  return h;\n}\n\n// Authored code: parses the strings as UTC and uses scaleUtc, as the official examples do.\nexport function dates(el, d) {\n  return lineChart(el, d, d.series.map(s => s.name), d.series.map(s => s.values), d.days.map(s => Date.parse(s)));\n}\nimport uPlot from 'uplot';\nimport 'uplot/dist/uPlot.min.css';\n\nexport const meta = { name: 'uPlot', pkg: 'uplot' };\n// uPlot needs explicit pixel sizes (no auto-resize), explicit stroke colors (no palette), and x in seconds.\nconst size = el => ({ width: el.clientWidth, height: el.clientHeight - 80 }); // title and legend sit outside `height`\nconst colors = ['red', 'green', 'blue']; // the colors used in uPlot's README example\nconst secs = t => t.map(v => v / 1000);\n\nexport function trend(el, d) {\n  const u = new uPlot({\n    title: d.title, ...size(el),\n    series: [{}, ...d.series.map((s, i) => ({ label: s.name, stroke: colors[i] }))],\n    axes: [{}, { label: d.yTitle }],\n  }, [secs(d.t), ...d.series.map(s => s.values)], el);\n  return { u, destroy: () => u.destroy() };\n}\n\nexport function bars(el, d) {\n  const idx = d.categories.map((_, i) => i);\n  const u = new uPlot({\n    title: d.title, ...size(el),\n    scales: { x: { time: false, range: [-0.5, idx.length - 0.5] } },\n    axes: [{ splits: () => idx, values: (u, splits) => splits.map(i => d.categories[i]) }, { label: d.yTitle }],\n    series: [{}, { label: d.name, stroke: 'blue', fill: 'rgba(0,0,255,0.3)', paths: uPlot.paths.bars({ size: [0.6, 100] }) }],\n  }, [idx, d.values], el);\n  return { u, destroy: () => u.destroy() };\n}\n\nexport const parts = null; // no pie/donut in uPlot\n\nexport function dirty(el, d) {\n  const idx = d.categories.map((_, i) => i);\n  const u = new uPlot({\n    title: d.title, ...size(el),\n    scales: { x: { time: false } },\n    axes: [{ splits: () => idx, values: (u, splits) => splits.map(i => d.categories[i]) }, {}],\n    series: [{}, { label: d.name, stroke: 'blue' }],\n  }, [idx, d.values], el);\n  return { u, destroy: () => u.destroy() };\n}\n\nexport function scale(el, d) {\n  const data = [secs(d.t), d.y.slice()];\n  const u = new uPlot({ title: d.title, ...size(el), series: [{}, { label: d.name, stroke: 'blue' }] }, data, el);\n  return { u, data, destroy: () => u.destroy() };\n}\n\nexport function stream(el, d) {\n  const h = scale(el, d);\n  h.push = (x, y) => { h.data[0].push(x / 1000); h.data[0].shift(); h.data[1].push(y); h.data[1].shift(); h.u.setData(h.data); };\n  return h;\n}\n\n// uPlot takes numbers only, so the date strings go through Date.parse (UTC midnight for date-only strings).\nexport function dates(el, d) {\n  const u = new uPlot({ title: d.title, ...size(el), series: [{}, ...d.series.map((s, i) => ({ label: s.name, stroke: colors[i] }))] },\n    [d.days.map(s => Date.parse(s) / 1000), ...d.series.map(s => s.values)], el);\n  return { u, destroy: () => u.destroy() };\n}\nimport ApexCharts from 'apexcharts';\n\nexport const meta = { name: 'ApexCharts', pkg: 'apexcharts' };\n\nexport async function trend(el, d) {\n  const chart = new ApexCharts(el, {\n    chart: { type: 'line', height: el.clientHeight },\n    title: { text: d.title },\n    series: d.series.map(s => ({ name: s.name, data: s.values.map((v, i) => [d.t[i], v]) })),\n    xaxis: { type: 'datetime' },\n    yaxis: { title: { text: d.yTitle } },\n  });\n  await chart.render();\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport async function bars(el, d) {\n  const chart = new ApexCharts(el, {\n    chart: { type: 'bar', height: el.clientHeight },\n    title: { text: d.title },\n    series: [{ name: d.name, data: d.values }],\n    xaxis: { categories: d.categories },\n    yaxis: { title: { text: d.yTitle } },\n  });\n  await chart.render();\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport async function parts(el, d) {\n  const chart = new ApexCharts(el, {\n    chart: { type: 'donut', height: el.clientHeight },\n    title: { text: d.title },\n    series: d.values,\n    labels: d.labels,\n  });\n  await chart.render();\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport async function dirty(el, d) {\n  const chart = new ApexCharts(el, {\n    chart: { type: 'line', height: el.clientHeight },\n    title: { text: d.title },\n    series: [{ name: d.name, data: d.values }],\n    xaxis: { categories: d.categories },\n  });\n  await chart.render();\n  return { chart, destroy: () => chart.destroy() };\n}\n\nexport async function scale(el, d) {\n  const data = d.t.map((t, i) => [t, d.y[i]]);\n  const chart = new ApexCharts(el, {\n    chart: { type: 'line', height: el.clientHeight },\n    title: { text: d.title },\n    series: [{ name: d.name, data }],\n    xaxis: { type: 'datetime' },\n  });\n  await chart.render();\n  return { chart, data, destroy: () => chart.destroy() };\n}\n\nexport async function stream(el, d) {\n  const h = await scale(el, d);\n  h.push = (x, y) => { h.data.push([x, y]); h.data.shift(); h.chart.updateSeries([{ data: h.data }]); };\n  return h;\n}\n\nexport async function dates(el, d) {\n  const chart = new ApexCharts(el, { chart: { type: 'line', height: el.clientHeight }, title: { text: d.title },\n    series: d.series.map(s => ({ name: s.name, data: s.values.map((y, i) => ({ x: d.days[i], y })) })), xaxis: { type: 'datetime' } });\n  await chart.render();\n  return { chart, destroy: () => chart.destroy() };\n}\n","exit_code":0,"status":"completed"}}
