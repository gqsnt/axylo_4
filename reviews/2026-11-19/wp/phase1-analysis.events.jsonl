)\nmui dirty logs ('[\\'error: Error: <path> attribute d: Expected number, \"M65,NaNL170.833,NaNM…\".\\', \\'error: Error: <path> attribute d: Expected number, \"M65,NaNL170.833,NaNM…\".\\', \\'error: Error: <path> attribute d: Expected number, \"M65,NaNL170.833,NaNM…\".\\', \\'error: Error: <path> attribute d: Expected number, \"M65,NaNL170.833,NaNM…\".\\', \\'error: Error: <path> attribute d: Expected number, \"M65,NaNL170.833,NaNM…\".\\', \\'error: Error: <path> attribute d: Expected number, \"M', '[\\'error: Error: <path> attribute d: Expected number, \"M65,NaNL170.833,NaNM…\".\\', \\'error: Error: <path> attribute d: Expected number, \"M65,NaNL170.833,NaNM…\".\\', \\'error: Error: <path> attribute d: Expected number, \"M65,NaNL170.833,NaNM…\".\\', \\'error: Error: <path> attribute d: Expected number, \"M65,NaNL170.833,NaNM…\".\\', \\'error: Error: <path> attribute d: Expected number, \"M65,NaNL170.833,NaNM…\".\\', \\'error: Error: <path> attribute d: Expected number, \"M')\nrecharts stops: [('svg', '1/11/20261/26/20262/9/20262/', 'application'), ('g', '', None), ('g', '', None), ('g', '', None), ('g', '', None), ('g', '', None), ('g', '', None), ('g', '1/11/20261/26/20262/9/20262/', None)] []\nhighcharts stops: [('div', 'Created with Highcharts 13.1', None), ('button', 'Show Direct', None)] ['Sunday, Jan 4, 2026\\u200b● Direct: 33,458\\u200b']\nmui stops: [('div', '', 'none')] ['Fri Jan 02 2026 00:00:00 GMT+0000 (Coordinated Universal Time)', 'Direct\\t31,713', 'Organic search\\t20,724', 'Referral\\t4,716']\napexcharts stops: [('svg', 'Daily sessions by channel. l', 'application'), ('div', 'Direct, visible. Press Enter', 'button'), ('div', 'Organic search, visible. Pre', 'button'), ('div', 'Referral, visible. Press Ent', 'button'), ('button', 'Zoom In', None), ('button', 'Zoom Out', None), ('button', 'Selection Zoom', None), ('button', 'Panning', None), ('button', 'Reset Zoom', None), ('button', 'Menu', None)] ['03 Jan', 'Direct: 36072', 'Organic search: 21923', 'Referral: 4929']\nplotly stops: [('button', 'Download plot as a PNG', None), ('button', 'Share chart...', None), ('button', 'Zoom', None), ('button', 'Pan', None), ('button', 'Zoom in', None), ('button', 'Zoom out', None), ('button', 'Autoscale', None), ('button', 'Reset axes', None), ('a', 'plotly-logomark', None)] ['×', 'Preparing image - this may take a few seconds', '×', 'Image download succeeded - daily-sessions-by-channel.png']\nhighcharts-plain stops: [] []\necharts-aria stops: [] []\nimport { LineChart, Line, BarChart, Bar, PieChart, Pie, Cell, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer } from 'recharts';\nimport { mount } from './_react.jsx';\n\nexport const meta = { name: 'Recharts', pkg: 'recharts' };\n// Recharts has no default palette (every Line is #3182bd, every Pie sector #808080) and no title component.\n// Colors below are the ones used throughout the official examples.\nconst colors = ['#8884d8', '#82ca9d', '#ffc658'];\nconst pieColors = ['#0088FE', '#00C49F', '#FFBB28', '#FF8042'];\nconst day = t => new Date(t).toLocaleDateString(); // without a tickFormatter a time axis prints raw epoch numbers\n\nconst TimeLines = ({ rows, names, yTitle }) => (\n  <ResponsiveContainer width=\"100%\" height=\"100%\">\n    <LineChart data={rows}>\n      <CartesianGrid strokeDasharray=\"3 3\" />\n      <XAxis dataKey=\"t\" type=\"number\" scale=\"time\" domain={['dataMin', 'dataMax']} tickFormatter={day} />\n      <YAxis label={yTitle && { value: yTitle, angle: -90, position: 'insideLeft' }} />\n      <Tooltip labelFormatter={day} />\n      <Legend />\n      {names.map((n, i) => <Line key={n} dataKey={n} stroke={colors[i]} />)}\n    </LineChart>\n  </ResponsiveContainer>\n);\n\nexport function trend(el, d) {\n  const rows = d.t.map((t, i) => Object.fromEntries([['t', t], ...d.series.map(s => [s.name, s.values[i]])]));\n  const r = mount(el, p => <TimeLines {...p} />);\n  r.draw({ rows, names: d.series.map(s => s.name), yTitle: d.yTitle });\n  return r;\n}\n\nexport function bars(el, d) {\n  const rows = d.categories.map((name, i) => ({ name, [d.name]: d.values[i] }));\n  const r = mount(el, () => (\n    <ResponsiveContainer width=\"100%\" height=\"100%\">\n      <BarChart data={rows}>\n        <CartesianGrid strokeDasharray=\"3 3\" />\n        <XAxis dataKey=\"name\" />\n        <YAxis label={{ value: d.yTitle, angle: -90, position: 'insideLeft' }} />\n        <Tooltip />\n        <Bar dataKey={d.name} fill={colors[0]} />\n      </BarChart>\n    </ResponsiveContainer>\n  ));\n  r.draw();\n  return r;\n}\n\nexport function parts(el, d) {\n  const rows = d.labels.map((name, i) => ({ name, value: d.values[i] }));\n  const r = mount(el, () => (\n    <ResponsiveContainer width=\"100%\" height=\"100%\">\n      <PieChart>\n        <Pie data={rows} dataKey=\"value\" nameKey=\"name\" innerRadius=\"50%\" label>\n          {rows.map((row, i) => <Cell key={row.name} fill={pieColors[i % pieColors.length]} />)}\n        </Pie>\n        <Tooltip />\n        <Legend />\n      </PieChart>\n    </ResponsiveContainer>\n  ));\n  r.draw();\n  return r;\n}\n\nexport function dirty(el, d) {\n  const rows = d.categories.map((name, i) => ({ name, [d.name]: d.values[i] }));\n  const r = mount(el, () => (\n    <ResponsiveContainer width=\"100%\" height=\"100%\">\n      <LineChart data={rows}>\n        <XAxis dataKey=\"name\" />\n        <YAxis />\n        <Tooltip />\n        <Line dataKey={d.name} stroke={colors[0]} />\n      </LineChart>\n    </ResponsiveContainer>\n  ));\n  r.draw();\n  return r;\n}\n\nexport function scale(el, d) {\n  const rows = d.t.map((t, i) => ({ t, [d.name]: d.y[i] }));\n  const r = mount(el, p => <TimeLines {...p} />);\n  r.rows = rows; r.names = [d.name];\n  r.draw({ rows, names: r.names });\n  return r;\n}\n\nexport function stream(el, d) {\n  const r = scale(el, d);\n  r.push = (x, y) => { r.rows = [...r.rows.slice(1), { t: x, [d.name]: y }]; r.draw({ rows: r.rows, names: r.names }); };\n  return r;\n}\n\n// Recharts has no date parsing: date strings go on a category axis and are printed as written.\nexport function dates(el, d) {\n  const rows = d.days.map((day, i) => Object.fromEntries([['day', day], ...d.series.map(s => [s.name, s.values[i]])]));\n  const r = mount(el, () => (\n    <ResponsiveContainer width=\"100%\" height=\"100%\">\n      <LineChart data={rows}>\n        <XAxis dataKey=\"day\" />\n        <YAxis />\n        <Tooltip />\n        <Legend />\n        {d.series.map((s, i) => <Line key={s.name} dataKey={s.name} stroke={colors[i]} />)}\n      </LineChart>\n    </ResponsiveContainer>\n  ));\n  r.draw();\n  return r;\n}\n","exit_code":0,"status":"completed"}}
