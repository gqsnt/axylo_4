{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat research/harness/{sizes.mjs,palette.mjs,spot-checks.mjs,montage.mjs} research/tables.mjs'","aggregated_output":"// Bundle cost of each library for exactly the harness tasks (line + bar + donut): minified and gzipped.\n// React libraries are measured with react/react-dom external, since a React app already ships them.\nimport { build } from 'esbuild';\nimport { gzipSync, brotliCompressSync } from 'node:zlib';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { axyloDirectory, axyloEntry } from './packed-axylo.mjs';\nconst libs = { chartjs: 'js', recharts: 'jsx', d3: 'js', echarts: 'js', highcharts: 'js', apexcharts: 'js', plotly: 'js', nivo: 'jsx', mui: 'jsx', uplot: 'js', axylo: 'js' };\nconst out = {};\nfor (const [lib, ext] of Object.entries(libs)) {\n  const alias = lib === 'axylo' ? { axylo: axyloEntry } : undefined;\n  const r = await build({ entryPoints: [`src/libs/${lib}.${ext}`], bundle: true, minify: true, format: 'esm', write: false, jsx: 'automatic',\n    external: ['react', 'react-dom', 'react-dom/client', 'react/jsx-runtime'], loader: { '.css': 'text' }, define: { 'process.env.NODE_ENV': '\"production\"' }, logLevel: 'silent', alias });\n  const buf = Buffer.from(r.outputFiles[0].contents);\n  const src = fs.readFileSync(`src/libs/${lib}.${ext}`, 'utf8').split('\\n').filter(l => l.trim() && !l.trim().startsWith('//'));\n  out[lib] = { minKB: +(buf.length / 1024).toFixed(1), gzipKB: +(gzipSync(buf).length / 1024).toFixed(1), brotliKB: +(brotliCompressSync(buf).length / 1024).toFixed(1), harnessLoc: src.length };\n  if (lib === 'axylo') {\n    const { version, license } = JSON.parse(fs.readFileSync(path.join(axyloDirectory, 'package.json'), 'utf8'));\n    Object.assign(out[lib], { version, license });\n  }\n}\nfs.writeFileSync('sizes.json', JSON.stringify(out, null, 1));\nconsole.table(out);\n// Extracts the colors each library actually used for the 6-slice donut,\n// then scores them: contrast against white (WCAG 1.4.11 asks 3:1 for graphical objects) and\n// the smallest pairwise color difference under normal vision and simulated color-vision deficiencies.\nimport { chromium } from 'playwright-core';\nimport fs from 'node:fs';\nconst LIBS = ['chartjs', 'recharts', 'd3', 'echarts', 'highcharts', 'apexcharts', 'plotly', 'nivo', 'mui', 'uplot', 'axylo'];\nconst browser = await chromium.launch({ channel: 'chrome', headless: true });\nconst grab = async (lib, task) => {\n  const page = await browser.newPage({ viewport: { width: 800, height: 520 } });\n  await page.goto(`http://localhost:4173/?lib=${lib}&task=${task}`);\n  await page.waitForFunction(() => window.__result); await page.waitForTimeout(1800);\n  const colors = await page.evaluate(({ lib, task }) => {\n    const h = window.__handle, el = document.getElementById('chart');\n    const norm = c => { const x = document.createElement('canvas').getContext('2d'); x.fillStyle = c; return x.fillStyle; };\n    if (h?.chart?.data?.datasets) { const d = h.chart.data.datasets; return (task === 'parts' ? d[0].backgroundColor : d.map(s => s.borderColor)).map(norm); }\n    if (h?.chart?.getOption) return h.chart.getOption().color.slice(0, task === 'parts' ? 6 : 3).map(norm); // ECharts draws on canvas: its option palette, in slice order\n    if (h?.u) return h.u.series.slice(1).map(s => norm(s._stroke ?? s.stroke(h.u)));\n    // Read rendered slices in order, including any narrow slices the generic SVG size filter would skip.\n    if (lib === 'axylo' && task === 'parts') return [...el.querySelectorAll('.axylo-svg .axylo-scene path[d]:not([d=\"\"])')].map(p => norm(getComputedStyle(p).fill));\n    // SVG: big filled shapes for the donut, long stroked paths for lines; keep first-seen order\n    const seen = [];\n    for (const p of el.querySelectorAll('svg path, svg circle')) {\n      const cs = getComputedStyle(p), b = p.getBBox?.() ?? { width: 0, height: 0 };\n      if (p.closest('[class*=legend]')) continue;\n      const c = task === 'parts' ? cs.fill : cs.stroke;\n      if (!c || c === 'none' || c.includes('rgba(0, 0, 0, 0)')) continue;\n      if (/rgba\\(/.test(c) || c === 'rgb(255, 255, 255)') continue; // skip translucent overlays and white separators\n      if (task === 'parts' ? (p.tagName !== 'path' || b.width < 3 || b.height < 3) : (p.tagName !== 'path' || b.width < 200 || cs.fill !== 'none')) continue;\n      seen.push(norm(c)); // keep repeats: two slices with the same fill are a pair with zero difference\n    }\n    return seen;\n  }, { lib, task });\n  await page.close();\n  return colors;\n};\n// --- color math\nconst lin = v => { v /= 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; };\nconst rgb = h => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));\nconst lum = h => { const [r, g, b] = rgb(h).map(lin); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };\nconst contrast = (a, b) => { const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p); return (x + 0.05) / (y + 0.05); };\n// Machado et al. 2009, severity 1.0, applied in linear RGB\nconst CVD = { normal: [[1, 0, 0], [0, 1, 0], [0, 0, 1]],\n  protan: [[0.152286, 1.052583, -0.204868], [0.114503, 0.786281, 0.099216], [-0.003882, -0.048116, 1.051998]],\n  deutan: [[0.367322, 0.860646, -0.227968], [0.280085, 0.672501, 0.047413], [-0.011820, 0.042940, 0.968881]],\n  tritan: [[1.255528, -0.076749, -0.178779], [-0.078411, 0.930809, 0.147602], [0.004733, 0.691367, 0.303900]] };\nconst oklab = ([r, g, b]) => { const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b), m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b), s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);\n  return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s, 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s, 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s]; };\nconst sim = (h, M) => oklab(M.map(row 