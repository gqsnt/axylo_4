{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'cat research/harness/src/libs/axylo.js research/harness/src/data.js research/harness/src/main.js'","aggregated_output":"import { bar, donut, line } from 'axylo'; // The packed build supplies its own stylesheet.\n\nexport const meta = { name: 'Axylo', pkg: 'axylo' };\n\nfunction sessions(el, d, times, x) {\n  // Long rows keep each channel name and allow a shared Sessions axis title.\n  const data = d.series.flatMap(s => times.map((day, i) => ({ day, channel: s.name, sessions: s.values[i] })));\n  return line(el, { data, title: d.title, x, y: { field: 'sessions', label: d.yTitle }, series: 'channel' });\n}\n\nexport function trend(el, d) {\n  // Epoch milliseconds need an explicit instant axis. The empty task passes zero rows through this call.\n  return sessions(el, d, d.t, { field: 'day', type: 'time' });\n}\n\nexport function dates(el, d) {\n  // ISO calendar dates are inferred and kept in their original form.\n  return sessions(el, d, d.days, 'day');\n}\n\nexport function bars(el, d) {\n  // Supply the value-axis title. Zero baseline and label fitting are built in.\n  return bar(el, { data: { columns: { team: d.categories, satisfied: d.values } }, title: d.title,\n    x: 'team', y: { field: 'satisfied', label: d.yTitle } });\n}\n\nexport function parts(el, d) {\n  // Name the slice and value fields. The legend and palette are built in.\n  return donut(el, { data: { columns: { browser: d.labels, share: d.values } }, title: d.title,\n    label: 'browser', value: { field: 'share', label: d.name } });\n}\n\nexport function dirty(el, d) {\n  // Keep every sentinel as sent, including NaN, for both combined and individual cases.\n  const data = d.categories.map((day, i) => ({ day, value: d.values[i] }));\n  return line(el, { data, title: d.title, x: 'day', y: { field: 'value', label: d.name } });\n}\n\nexport function scale(el, d) {\n  // The existing columns need only field names and a declared instant axis. Dense lines simplify automatically.\n  return line(el, { data: { columns: { t: d.t, value: d.y } }, title: d.title,\n    x: { field: 't', type: 'time' }, y: { field: 'value', label: d.name } });\n}\n\nexport function stream(el, d) {\n  const chart = scale(el, d);\n  // Axylo owns the sliding window once told how many x positions to keep.\n  return { push: (t, value) => chart.append([{ t, value }], { keep: d.t.length }), destroy: () => chart.destroy() };\n}\n// Shared, deterministic datasets. Every library receives exactly these values.\nexport function rng(seed) {\n  let s = seed >>> 0;\n  return () => { s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };\n}\nconst DAY = 864e5;\nconst START = Date.UTC(2026, 0, 1);\n\n// Task \"trend\": 3 series x 120 daily points (UTC midnights). \"Referral\" has a 7-day outage (nulls).\nexport const trend = (() => {\n  const r = rng(7), n = 120;\n  const t = Array.from({ length: n }, (_, i) => START + i * DAY);\n  const mk = (base, growth, noise, season) => t.map((_, i) => Math.round(base + growth * i + season * Math.sin((i / 7) * 2 * Math.PI) + (r() - 0.5) * noise));\n  const series = [\n    { name: 'Direct', values: mk(31000, 120, 4000, 3000) },\n    { name: 'Organic search', values: mk(18000, 60, 3000, 2500) },\n    { name: 'Referral', values: mk(4200, -8, 1200, 400) },\n  ];\n  for (let i = 60; i < 67; i++) series[2].values[i] = null;\n  return { title: 'Daily sessions by channel', yTitle: 'Sessions', t, series };\n})();\n\n// Task \"bars\": one series, all values between 82 and 97 (tests zero baseline), one long label.\nexport const bars = {\n  title: 'Customer satisfaction by team', yTitle: 'Satisfied (%)', name: 'Satisfied (%)',\n  categories: ['Billing', 'Customer Success & Onboarding', 'Platform', 'Mobile', 'Data', 'Security', 'Sales Eng.'],\n  values: [94, 88, 97, 82, 91, 85, 90],\n};\n\n// Task \"parts\": six shares, two of them small.\nexport const parts = {\n  title: 'Sessions by browser', name: 'Share (%)',\n  labels: ['Chrome', 'Safari', 'Edge', 'Firefox', 'Samsung Internet', 'Other'],\n  values: [46.2, 27.5, 14.1, 8.9, 2.1, 1.2],\n};\n\n// Task \"dirty\": values a real app sends by mistake. Correct reading: Wed, Thu, Sat are missing; Fri is ambiguous (a string).\nexport const dirty = {\n  title: 'Dirty input', name: 'Value',\n  categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],\n  values: [10, 20, null, NaN, '40', undefined, 70],\n};\n\n// Task \"scale\": one series, n points, one per minute, random walk.\nexport function scale(n) {\n  const r = rng(1), t = new Array(n), y = new Array(n);\n  let v = 100;\n  for (let i = 0; i < n; i++) { v += (r() - 0.5) * 2; t[i] = START + i * 60000; y[i] = Math.round(v * 100) / 100; }\n  return { title: `${n.toLocaleString('en-US')} points`, name: 'Value', t, y };\n}\n\n// Task \"stream\": 600-point window; the harness then pushes one new point per frame.\nexport function stream() {\n  const d = scale(600);\n  const r = rng(2);\n  let v = d.y[d.y.length - 1], i = d.t.length;\n  return { ...d, title: 'Streaming window', next: () => { v += (r() - 0.5) * 2; return [START + i++ * 60000, Math.round(v * 100) / 100]; } };\n}\n\n// Task \"dates\": the trend series keyed by calendar-date strings (no time, no zone), to separate\n// \"this library shifts instants into the viewer's zone\" from \"this library cannot show a date as a date\".\nexport const dates = { ...trend, days: trend.t.map(t => new Date(t).toISOString().slice(0, 10)) };\n\n// Tasks \"dirty-null\", \"dirty-nan\", \"dirty-string\", \"dirty-undefined\": one bad value at a time, in a line of\n// seven otherwise valid points, so each outcome can be attributed to one kind of input.\nexport function dirtyOne(kind) {\n  const bad = { null: null, nan: NaN, string: '40', undefined: undefined }[kind];\n  return { ...dirty, title: `One bad value: ${kind}`, values: [10, 20, 30, bad, 50, 60, 70] };\n}\nimport * as data from './data.js';\nconst mods = import.meta.glob('./libs/*.{js,jsx}');\nconst q = new URLSearchParams(location.search);\nconst lib = q.get('lib'), task = q.get('task') ?? 'trend', n = Number(q.get('n') ?? 100000);\nconst el = document.getElementById('chart');\nif (q.get('w')) el.style.width = q.get('w') + 'px';\nif (q.get('scheme')) document.documentElement.style.colorScheme = q.get('scheme'); // e.g. a light-only page under a dark OS\nconst mark = name => window.__mark ? window.__mark(name) : null; // the probe records CDP main-thread metrics at these points\nconst raf = () => new Promise(r => requestAnimationFrame(() => r()));\nwindow.__result = null;\n(async () => {\n  const key = Object.keys(mods).find(k => k.startsWith(`./libs/${lib}.`));\n  if (!key) { el.textContent = 'Choose a library and task, for example ?lib=axylo&task=trend'; return; }\n  try {\n    const m = await mods[key]();\n    const one = task.startsWith('dirty-') ? task.slice(6) : null;\n    const fn = task === 'empty' ? m.trend : one ? m.dirty : m[task];\n    if (!fn) { window.__result = { unsupported: true }; el.textContent = `${lib}: ${task} not supported`; return; }\n    // \"empty\": the trend chart when the query returned no rows\n    const d = task === 'scale' ? data.scale(n) : task === 'stream' ? data.stream()\n      : task === 'empty' ? { ...data.trend, title: 'Daily sessions by channel', t: [], series: data.trend.series.map(s => ({ ...s, values: [] })) }\n      : one ? data.dirtyOne(one)\n      : data[task];\n    await raf();\n    await mark('create:start');\n    const t0 = performance.now();\n    const handle = await fn(el, d);\n    const t1 = performance.now();\n    await raf(); await raf();\n    const t2 = performance.now();\n    window.__handle = handle;\n    const res = { createMs: t1 - t0, toPaintMs: t2 - t0 };\n    if (window.__mark) { await new Promise(r => setTimeout(r, 1600)); await mark('create:end'); } // long enough for entry animations to finish\n    if (task === 'stream') {\n      // let entry animations settle, then push one point per frame\n      await new Promise(r => setTimeout(r, 1500));\n      const frames = Number(q.get('frames') ?? 300), push = [], gaps = [];\n      await mark('stream:start');\n      let last = performance.now();\n      for (let i = 0; i < frames; i++) {\n        const [x, y] = d.next();\n        const a = performance.now(); handle.push(x, y); push.push(performance.now() - a);\n        await raf(); const now = performance.now(); gaps.push(now - last); last = now;\n      }\n      await raf(); await mark('stream:end');\n      const pct = (arr, p) => [...arr].sort((a, b) => a - b)[Math.min(arr.length - 1, Math.floor(arr.length * p))];\n      Object.assign(res, { pushP50: pct(push, 0.5), pushP95: pct(push, 0.95), frameP50: pct(gaps, 0.5), frameP95: pct(gaps, 0.95), framesOver20ms: gaps.filter(g => g > 20).length, frames });\n    }\n    window.__result = res;\n  } catch (e) { console.error(e); window.__result = { error: String(e?.stack ?? e) }; }\n})();\n","exit_code":0,"status":"completed"}}
