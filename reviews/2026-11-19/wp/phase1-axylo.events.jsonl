{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc 'nl -ba research/harness/probe.mjs'","aggregated_output":"     1\t// Drives system Chrome through every library x task and records what a reader and a developer would observe.\n     2\t// Usage: node probe.mjs [phase ...]   phases: look, empty, a11y, env, perf, dates, sentinels, lightonly   (default: the first five)\n     3\t// LIBS=chartjs-tuned,echarts-tuned node probe.mjs perf   runs a subset\n     4\timport { chromium } from 'playwright-core';\n     5\timport { PNG } from 'pngjs';\n     6\timport fs from 'node:fs';\n     7\t\n     8\tconst BASE = 'http://localhost:4173/';\n     9\tconst LIBS = ['chartjs', 'recharts', 'd3', 'echarts', 'highcharts', 'apexcharts', 'plotly', 'nivo', 'mui', 'uplot'];\n    10\tconst only = process.env.LIBS?.split(',') ?? LIBS;\n    11\tconst phases = process.argv.slice(2).length ? process.argv.slice(2) : ['look', 'empty', 'a11y', 'env', 'perf'];\n    12\tfs.mkdirSync('shots', { recursive: true });\n    13\tconst resultsFile = 'results.json';\n    14\tconst results = fs.existsSync(resultsFile) ? JSON.parse(fs.readFileSync(resultsFile, 'utf8')) : {};\n    15\tconst save = () => fs.writeFileSync(resultsFile, JSON.stringify(results, null, 1));\n    16\tconst sleep = ms => new Promise(r => setTimeout(r, ms));\n    17\t\n    18\tconst browser = await chromium.launch({ channel: 'chrome', headless: true });\n    19\tresults._env = { chrome: browser.version(), date: new Date().toISOString(), headless: true };\n    20\t// every invocation is recorded, so a later partial run does not erase when earlier results were taken\n    21\t(results._runs ??= []).push({ date: results._env.date, chrome: results._env.chrome, phases, libs: only, settleMs: Number(process.env.SETTLE ?? 1800) });\n    22\t\n    23\tconst SETTLE = Number(process.env.SETTLE ?? 1800);\n    24\tasync function open(ctxOpts, lib, task, extra = '', settle = SETTLE, timeout = 60000, marks = null) {\n    25\t  const ctx = await browser.newContext({ viewport: { width: 800, height: 520 }, timezoneId: 'UTC', locale: 'en-US', ...ctxOpts });\n    26\t  const page = await ctx.newPage();\n    27\t  const logs = [];\n    28\t  page.on('console', m => { if (['warning', 'error'].includes(m.type())) logs.push(`${m.type()}: ${m.text().slice(0, 300)}`); });\n    29\t  page.on('pageerror', e => logs.push(`pageerror: ${String(e).slice(0, 300)}`));\n    30\t  if (marks) { // main-thread accounting from the browser itself, independent of how a library schedules its work\n    31\t    const cdp = await ctx.newCDPSession(page); await cdp.send('Performance.enable');\n    32\t    await page.exposeFunction('__mark', async name => { const { metrics } = await cdp.send('Performance.getMetrics'); marks[name] = Object.fromEntries(metrics.map(m => [m.name, m.value])); });\n    33\t  }\n    34\t  await page.goto(`${BASE}?lib=${lib}&task=${task}${extra}`);\n    35\t  let res;\n    36\t  try { res = await (await page.waitForFunction(() => window.__result, null, { timeout })).jsonValue(); }\n    37\t  catch { res = { noResultWithinMs: timeout }; }\n    38\t  if (settle) await sleep(settle);\n    39\t  return { ctx, page, logs, res };\n    40\t}\n    41\t\n    42\tconst domStats = () => {\n    43\t  const el = document.getElementById('chart');\n    44\t  const all = [...el.querySelectorAll('*')];\n    45\t  const attrs = ['role', 'aria-label', 'aria-labelledby', 'aria-describedby', 'aria-hidden', 'aria-live', 'tabindex', 'aria-roledescription'];\n    46\t  const marked = all.filter(n => attrs.some(a => n.hasAttribute(a))).slice(0, 40).map(n => {\n    47\t    const o = { tag: n.tagName.toLowerCase() };\n    48\t    for (const a of attrs) if (n.hasAttribute(a)) o[a] = n.getAttribute(a).slice(0, 160);\n    49\t    return o;\n    50\t  });\n    51\t  const texts = [...el.querySelectorAll('svg text')].filter(t => t.textContent.trim());\n    52\t  const sizes = {}, fills = {};\n    53\t  for (const t of texts) { const cs = getComputedStyle(t); sizes[cs.fontSize] = (sizes[cs.fontSize] ?? 0) + 1; fills[cs.fill] = (fills[cs.fill] ?? 0) + 1; }\n    54\t  const big = el.querySelector('svg, canvas');\n    55\t  return {\n    56\t    nodes: all.length, svg: el.querySelectorAll('svg').length, canvas: el.querySelectorAll('canvas').length,\n    57\t    svgTitle: el.querySelectorAll('svg title').length, svgDesc: el.querySelectorAll('svg desc').length,\n    58\t    tables: el.querySelectorAll('table').length, markedCount: all.filter(n => attrs.some(a => n.hasAttribute(a))).length, marked,\n    59\t    canvasFallback: [...el.querySelectorAll('canvas')].map(c => c.textContent.trim().slice(0, 120)),\n    60\t    svgTextSizes: sizes, svgTextFills: fills, mainWidth: big ? Math.round(big.getBoundingClientRect().width) : null,\n    61\t    mainHeight: big ? Math.round(big.getBoundingClientRect().height) : null,\n    62\t  };\n    63\t};\n    64\t\n    65\tconst shot = async (page, name) => { const p = `shots/${name}.png`; await page.locator('#chart').screenshot({ path: p }); return p; };\n    66\tconst diffRatio = (a, b) => {\n    67\t  const A = PNG.sync.read(a), B = PNG.sync.read(b);\n    68\t  if (A.width !== B.width || A.height !== B.height) return 1;\n    69\t  let n = 0;\n    70\t  for (let i = 0; i < A.data.length; i += 4) if (Math.abs(A.data[i] - B.data[i]) + Math.abs(A.data[i + 1] - B.data[i + 1]) + Math.abs(A.data[i + 2] - B.data[i + 2]) > 30) n++;\n    71\t  return n / (A.data.length / 4);\n    72\t};\n    73\tconst bodyLines = page => page.evaluate(() => document.body.innerText.split('\\n').map(s => s.trim()).filter(Boolean));\n    74\t\n    75\tfor (const lib of only) {\n    76\t  const R = (results[lib] ??= {});\n    77\t\n    78\t  if (phases.includes('look')) for (const task of ['trend', 'bars', 'parts', 'dirty']) {\n    79\t    const { ctx, page, logs, res } = await open({}, lib, task);\n    80\t    const out = { res, logs };\n    81\t    if (!res.unsupported) {\n    82\t      out.dom = await page.evaluate(domStats);\n    83\t      out.aria = (await page.locator('#chart').ariaSnapshot().catch(e => 'ERR ' + e)).slice(0, 2500);\n    84\t      await shot(page, `${task}-${lib}`);\n    85\t    }\n    86\t    R[task] = out; save(); await ctx.close();\n    87\t    console.log(lib, task, JSON.stringify(res).slice(0, 120), logs.length ? `logs:${logs.length}` : '');\n    88\t  }\n    89\t\n    90\t  if (phases.includes('empty')) {\n    91\t    // the query returned no rows: what does the reader see, and what does assistive technology get?\n    92\t    const { ctx, page, logs, res } = await open({}, lib, 'empty');\n    93\t    R.empty = { res, logs: logs.slice(0, 4), text: (await bodyLines(page)).filter(l => !['before', 'after'].includes(l)).slice(0, 12),\n    94\t      aria: (await page.locator('#chart').ariaSnapshot().catch(e => 'ERR ' + e)).slice(0, 600) };\n    95\t    await shot(page, `empty-${lib}`); await ctx.close(); save();\n    96\t    console.log(lib, 'empty', JSON.stringify(R.empty.text).slice(0, 160), logs.length ? `logs:${logs.length}` : '');\n    97\t  }\n    98\t\n    99\t  if (phases.includes('dates')) {\n   100\t    // the same daily series given as instants (task trend) and as calendar-date strings (task dates), read in three zones\n   101\t    R.dates = {};\n   102\t    for (const task of ['trend', 'dates']) for (const [tz, tag] of [['UTC', 'utc'], ['America/Los_Angeles', 'la'], ['Asia/Kolkata', 'kolkata']]) {\n   103\t      const o = await open({ timezoneId: tz }, lib, task);\n   104\t      const rec = { res: o.res.error ? { error: o.res.error.slice(0, 160) } : o.res.unsupported ? 'unsupported' : 'ok' };\n   105\t      if (rec.res === 'ok') {\n   106\t        const b0 = await bodyLines(o.page);\n   107\t        const box = await o.page.locator('#chart').boundingBox();\n   108\t        await o.page.mouse.move(box.x + box.width * 0.3, box.y + box.height * 0.5);\n   109\t        await o.page.mouse.move(box.x + box.width * 0.5, box.y + box.height * 0.45, { steps: 8 });\n   110\t        await sleep(500);\n   111\t        rec.hoverText = (await bodyLines(o.page)).filter(l => !b0.includes(l)).slice(0, 8);\n   112\t        // canvas tooltips are invisible to text capture: ask Chart.js for the tooltip it would show for one known datum (index 54 = 2026-02-24)\n   113\t        if (lib === 'chartjs') rec.tooltipForIndex54 = await o.page.evaluate(() => { const c = window.__handle.chart; c.tooltip.setActiveElements([{ datasetIndex: 0, index: 54 }], { x: 0, y: 0 }); c.update(); return { title: c.tooltip.title, body: c.tooltip.body.map(b => b.lines).flat() }; });\n   114\t        await shot(o.page, `${task === 'dates' ? 'datestr' : 'instant'}-${tag}-${lib}`);\n   115\t      }\n   116\t      (R.dates[task] ??= {})[tag] = rec; await o.ctx.close();\n   117\t    }\n   118\t    save(); console.log(lib, 'dates', JSON.stringify(R.dates).slice(0, 400));\n   119\t  }\n   120\t\n   121\t  if (phases.includes('sentinels')) {\n   122\t    R.sentinels = {};\n   123\t    for (const kind of ['null', 'nan', 'string', 'undefined']) {\n   124\t      const { ctx, page, logs, res } = await open({}, lib, `dirty-${kind}`);\n   125\t      R.sentinels[kind] = { error: res.error ? res.error.split('\\n')[0].slice(0, 160) : null, logCount: logs.length, firstLog: logs[0]?.slice(0, 140) ?? null };\n   126\t      await shot(page, `one-${kind}-${lib}`); await ctx.close();\n   127\t    }\n   128\t    save(); console.log(lib, 'sentinels', JSON.stringify(R.sentinels).slice(0, 300));\n   129\t  }\n   130\t\n   131\t  if (phases.includes('lightonly')) {\n   132\t    // a page that declares itself light-only, viewed on a device set to dark: the chart should stay light\n   133\t    const { ctx, page } = await open({ colorScheme: 'dark' }, lib, 'trend', '&scheme=light');\n   134\t    await shot(page, `lightonly-${lib}`); await ctx.close();\n   135\t  }\n   136\t\n   137\t  if (phases.includes('a11y')) {\n   138\t    const { ctx, page } = await open({}, lib, 'trend');\n   139\t    const k = { stops: [] };\n   140\t    await page.focus('#before');\n   141\t    for (let i = 0; i < 40; i++) {\n   142\t      await page.keyboard.press('Tab');\n   143\t      const a = await page.evaluate(() => {\n   144\t        const e = document.activeElement, c = document.getElementById('chart');\n   145\t        if (e.id === 'after') return 'AFTER';\n   146\t        if (!c.contains(e)) return 'OUTSIDE:' + e.tagName;\n   147\t        const r = e.getBoundingClientRect(), cs = getComputedStyle(e);\n   148\t        return { tag: e.tagName.toLowerCase(), role: e.getAttribute('role'), label: (e.getAttribute('aria-label') ?? e.textContent ?? '').trim().slice(0, 120), cls: String(e.className?.baseVal ?? e.className).slice(0, 60), box: [Math.round(r.width), Math.round(r.height)], outline: cs.outlineStyle + ' ' + cs.outlineWidth };\n   149\t      });\n   150\t      if (a === 'AFTER') break;\n   151\t      k.stops.push(a);\n   152\t    }\n   153\t    // arrow-key exploration from the first stop inside the chart\n   154\t    await page.focus('#before'); await page.keyboard.press('Tab');\n   155\t    const before = await bodyLines(page);\n   156\t    const describe = () => page.evaluate(() => {\n   157\t      const e = document.activeElement;\n   158\t      const live = [...document.querySelectorAll('[aria-live]')].map(n => n.textContent.trim().slice(0, 200)).filter(Boolean);\n   159\t      return { active: (e.getAttribute?.('aria-label') ?? e.textContent ?? '').trim().slice(0, 160), tag: e.tagName.toLowerCase(), live };\n   160\t    });\n   161\t    k.arrows = [];\n   162\t    for (const key of ['ArrowRight', 'ArrowRight', 'ArrowDown', 'Enter']) { await page.keyboard.press(key); await sleep(250); k.arrows.push({ key, ...(await describe()) }); }\n   163\t    const after = await bodyLines(page);\n   164\t    k.newTextAfterKeys = after.filter(l => !before.includes(l)).slice(0, 12);\n   165\t    await shot(page, `kbd-${lib}`);\n   166\t    R.keyboard = k; await ctx.close();\n   167\t\n   168\t    // pointer hover: what does the default tooltip say?\n   169\t    for (const [tz, tag] of [['UTC', 'utc'], ['America/Los_Angeles', 'la']]) {\n   170\t      const o = await open({ timezoneId: tz }, lib, 'trend');\n   171\t      const b0 = await bodyLines(o.page);\n   172\t      const box = await o.page.locator('#chart').boundingBox();\n   173\t      await o.page.mouse.move(box.x + box.width * 0.3, box.y + box.height * 0.5);\n   174\t      await o.page.mouse.move(box.x + box.width * 0.5, box.y + box.height * 0.45, { steps: 8 });\n   175\t      await sleep(500);\n   176\t      const b1 = await bodyLines(o.page);\n   177\t      R[`hover_${tag}`] = { newText: b1.filter(l => !b0.includes(l)).slice(0, 14) };\n   178\t      await shot(o.page, `hover-${tag}-${lib}`);\n   179\t      await o.ctx.close();\n   180\t    }\n   181\t    save(); console.log(lib, 'a11y', k.stops.length, 'tab stops');\n   182\t  }\n   183\t\n   184\t  if (phases.includes('env')) {\n   185\t    // container resize\n   186\t    { const { ctx, page } = await open({}, lib, 'trend');\n   187\t      await page.evaluate(() => { document.getElementById('chart').style.width = '360px'; });\n   188\t      await sleep(900);\n   189\t      R.resize = await page.evaluate(() => { const c = document.getElementById('chart'); return { widestGraphic: Math.max(...[...c.querySelectorAll('svg, canvas')].map(n => Math.round(n.getBoundingClientRect().width))), scrollWidth: c.scrollWidth }; });\n   190\t      await shot(page, `resize-${lib}`); await ctx.close(); }\n   191\t    // born narrow (phone width)\n   192\t    { const { ctx, page } = await open({}, lib, 'trend', '&w=340'); await shot(page, `narrow-${lib}`); await ctx.close(); }\n   193\t    // dark scheme\n   194\t    { const { ctx, page } = await open({ colorScheme: 'dark' }, lib, 'trend'); await shot(page, `dark-${lib}`); await ctx.close(); }\n   195\t    // motion: compare an early frame with the settled frame, with and without prefers-reduced-motion\n   196\t    for (const rm of ['no-preference', 'reduce']) {\n   197\t      const { ctx, page } = await open({ reducedMotion: rm }, lib, 'bars', '', 0);\n   198\t      const early = await page.locator('#chart').screenshot();\n   199\t      await sleep(2500);\n   200\t      const late = await page.locator('#chart').screenshot();\n   201\t      R[`motion_${rm}`] = { earlyVsSettledDiff: +diffRatio(early, late).toFixed(4) };\n   202\t      await ctx.close();\n   203\t    }\n   204\t    save(); console.log(lib, 'env', R.resize, R['motion_no-preference'], R.motion_reduce);\n   205\t  }\n   206\t\n   207\t  if (phases.includes('perf')) {\n   208\t    R.scale = {};\n   209\t    for (const n of [10000, 100000, 1000000]) {\n   210\t      const prev = R.scale[n / 10];\n   211\t      if (prev && (prev.noResultWithinMs || prev.error || prev.toPaintMs > 8000)) { R.scale[n] = { skipped: 'previous size too slow' }; continue; }\n   212\t      const runs = [];\n   213\t      for (let i = 0; i < 3; i++) { const marks = {}; const { ctx, res } = await open({}, lib, 'scale', `&n=${n}`, 0, 45000, marks); if (marks['create:end']) res.taskMs = 1000 * (marks['create:end'].TaskDuration - marks['create:start'].TaskDuration); runs.push(res); await ctx.close(); if (res.noResultWithinMs || res.error) break; }\n   214\t      const ok = runs.filter(r => r.toPaintMs).map(r => r.toPaintMs).sort((a, b) => a - b);\n   215\t      const task = runs.filter(r => r.taskMs).map(r => r.taskMs).sort((a, b) => a - b);\n   216\t      R.scale[n] = ok.length ? { toPaintMs: +ok[Math.floor(ok.length / 2)].toFixed(1), runs: ok.map(v => +v.toFixed(1)), taskMs: task.length ? +task[Math.floor(task.length / 2)].toFixed(1) : null, taskRuns: task.map(v => +v.toFixed(1)), failedRuns: runs.length - ok.length } : runs[runs.length - 1];\n   217\t      save(); console.log(lib, 'scale', n, JSON.stringify(R.scale[n]).slice(0, 160));\n   218\t    }\n   219\t    { const marks = {}; const { ctx, res, logs } = await open({}, lib, 'stream', '', 0, 90000, marks);\n   220\t      if (marks['stream:end']) { const d = k => 1000 * (marks['stream:end'][k] - marks['stream:start'][k]); res.taskMsPerUpdate = d('TaskDuration') / res.frames; res.scriptMsPerUpdate = d('ScriptDuration') / res.frames; res.layoutStyleMsPerUpdate = (d('LayoutDuration') + d('RecalcStyleDuration')) / res.frames; }\n   221\t      for (const key in res) if (typeof res[key] === 'number') res[key] = +res[key].toFixed(2);\n   222\t      R.stream = { ...res, logs: logs.slice(0, 3) }; await ctx.close(); save(); console.log(lib, 'stream', JSON.stringify(R.stream).slice(0, 200)); }\n   223\t  }\n   224\t}\n   225\tsave();\n   226\tawait browser.close();\n","exit_code":0,"status":"completed"}}
