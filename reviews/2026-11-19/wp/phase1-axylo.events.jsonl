{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'cat research/harness/{sizes,spot-checks,montage,palette}.mjs && cat research/tables.mjs'","aggregated_output":"// Bundle cost of each library for exactly the harness tasks (line + bar + donut): minified and gzipped.\n// React libraries are measured with react/react-dom external, since a React app already ships them.\nimport { build } from 'esbuild';\nimport { gzipSync, brotliCompressSync } from 'node:zlib';\nimport fs from 'node:fs';\nconst libs = { chartjs: 'js', recharts: 'jsx', d3: 'js', echarts: 'js', highcharts: 'js', apexcharts: 'js', plotly: 'js', nivo: 'jsx', mui: 'jsx', uplot: 'js' };\nconst out = {};\nfor (const [lib, ext] of Object.entries(libs)) {\n  const r = await build({ entryPoints: [`src/libs/${lib}.${ext}`], bundle: true, minify: true, format: 'esm', write: false, jsx: 'automatic',\n    external: ['react', 'react-dom', 'react-dom/client', 'react/jsx-runtime'], loader: { '.css': 'text' }, define: { 'process.env.NODE_ENV': '\"production\"' }, logLevel: 'silent' });\n  const buf = Buffer.from(r.outputFiles[0].contents);\n  const src = fs.readFileSync(`src/libs/${lib}.${ext}`, 'utf8').split('\\n').filter(l => l.trim() && !l.trim().startsWith('//'));\n  out[lib] = { minKB: +(buf.length / 1024).toFixed(1), gzipKB: +(gzipSync(buf).length / 1024).toFixed(1), brotliKB: +(brotliCompressSync(buf).length / 1024).toFixed(1), harnessLoc: src.length };\n}\nfs.writeFileSync('sizes.json', JSON.stringify(out, null, 1));\nconsole.table(out);\n// Small checks whose results the report quotes; kept so they can be rerun. Output: spot-checks.json\nimport { chromium } from 'playwright-core';\nimport { execSync } from 'node:child_process';\nimport fs from 'node:fs';\nconst out = { date: new Date().toISOString() };\nconst b = await chromium.launch({ channel: 'chrome', headless: true });\nout.chrome = b.version();\nconst open = async (q, ms = 1800) => { const p = await b.newPage({ viewport: { width: 800, height: 520 } }); await p.goto('http://localhost:4173/?' + q); await p.waitForFunction(() => window.__result); await p.waitForTimeout(ms); return p; };\n{ const p = await open('lib=d3&task=trend'); out.webglRenderer = await p.evaluate(() => { const g = document.createElement('canvas').getContext('webgl'); const e = g?.getExtension('WEBGL_debug_renderer_info'); return g ? g.getParameter(e ? e.UNMASKED_RENDERER_WEBGL : g.RENDERER) : 'no webgl'; }); await p.close(); }\n{ const p = await open('lib=echarts-aria&task=trend'); out.echartsAria = await p.evaluate(() => { const c = document.getElementById('chart'); const pick = n => ({ tag: n.tagName, role: n.getAttribute('role'), ariaLabel: n.getAttribute('aria-label')?.slice(0, 400) ?? null }); return [pick(c), ...[...c.querySelectorAll('[role],[aria-label]')].map(pick)]; }); await p.close(); }\n{ const p = await open('lib=mui&task=trend'); out.muiTitle = await p.evaluate(() => [...document.querySelectorAll('#chart [aria-label]')].map(n => ({ tag: n.tagName, role: n.getAttribute('role'), ariaLabel: n.getAttribute('aria-label') }))); await p.close(); }\n{ const p = await open('lib=recharts&task=trend'); out.rechartsFocusable = await p.evaluate(() => [...document.querySelectorAll('#chart [tabindex]')].map(n => ({ tag: n.tagName, tabindex: n.getAttribute('tabindex'), role: n.getAttribute('role') }))); await p.close(); }\n{ const p = await open('lib=recharts&task=parts', 4000); out.rechartsDonutTextAfter4s = await p.evaluate(() => [...document.querySelectorAll('#chart svg text')].map(t => t.textContent)); await p.close(); }\n// which packages mention the reduced-motion media query anywhere in what they ship\nout.reducedMotionMentions = {};\nfor (const pkg of ['chart.js', 'recharts', 'd3', 'echarts', 'highcharts', 'apexcharts', 'plotly.js-dist-min', '@nivo/core', '@nivo/line', '@react-spring/shared', '@mui/x-charts', 'uplot']) {\n  let n = 0; try { n = execSync(`grep -rl \"prefers-reduced-motion\" node_modules/${pkg} | wc -l`).toString().trim() | 0; } catch {}\n  out.reducedMotionMentions[pkg] = n;\n}\nawait b.close();\nfs.writeFileSync('spot-checks.json', JSON.stringify(out, null, 1));\nconsole.log(JSON.stringify(out, null, 1).slice(0, 2600));\n// Builds one side-by-side sheet per screenshot prefix: node montage.mjs trend bars ...\nimport { chromium } from 'playwright-core';\nimport fs from 'node:fs';\nconst LIBS = ['chartjs', 'recharts', 'd3', 'echarts', 'highcharts', 'apexcharts', 'plotly', 'nivo', 'mui', 'uplot'];\nconst browser = await chromium.launch({ channel: 'chrome', headless: true });\nconst cols = Number(process.env.COLS ?? 2), w = Number(process.env.W ?? 720);\nfor (const prefix of process.argv.slice(2)) {\n  const dark = prefix.startsWith('dark');\n  const cells = LIBS.filter(l => fs.existsSync(`shots/${prefix}-${l}.png`)).map(l =>\n    `<figure><figcaption>${l}</figcaption><img src=\"data:image/png;base64,${fs.readFileSync(`shots/${prefix}-${l}.png`).toString('base64')}\"></figure>`).join('');\n  const page = await browser.newPage({ viewport: { width: cols * (w + 16) + 16, height: 800 } });\n  await page.setContent(`<style>body{margin:8px;font:600 15px system-ui;background:${dark ? '#121212' : '#fff'};color:${dark ? '#fff' : '#000'}}main{display:grid;grid-template-columns:repeat(${cols},${w}px);gap:12px 16px}figure{margin:0;border:1px solid #8884}figcaption{padding:2px 6px;background:#8883}img{display:block;max-width:${w}px}</style><main>${cells}</main>`);\n  await page.screenshot({ path: `shots/_sheet-${prefix}.png`, fullPage: true });\n  await page.close();\n}\nawait browser.close();\n// Extracts the colors each library actually used for the 6-slice donut,\n// then scores them: contrast against white (WCAG 1.4.11 asks 3:1 for graphical objects) and\n// the smallest pairwise color difference under normal vision and simulated color-vision deficiencies.\nimport { chromium } from 'playwright-core';\nimport fs from 'node:fs';\nconst LIBS = ['chartjs'