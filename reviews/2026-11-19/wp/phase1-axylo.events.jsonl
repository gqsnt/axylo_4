{"type":"item.started","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -c \"python3 - <<'PY'\nfrom pathlib import Path\nfrom tempfile import TemporaryDirectory\nimport json\nimport shutil\nimport subprocess\n\nroot = Path.cwd() / 'research'\nwith TemporaryDirectory(prefix='axylo-harness-tables-', dir='/tmp') as work:\n    work = Path(work)\n    harness = work / 'harness'\n    harness.mkdir()\n    (work / 'adoption').symlink_to(root / 'adoption')\n    tables = work / 'tables.mjs'\n    shutil.copyfile(root / 'tables.mjs', tables)\n    for name in ['results', 'sizes', 'palette']:\n        shutil.copyfile(root / 'harness' / (name + '.json'), harness / (name + '.json'))\n\n    def modify(name, make_entry):\n        target = harness / (name + '.json')\n        fields = json.loads(target.read_text())\n        fields['axylo'] = make_entry(fields)\n        target.write_text(json.dumps(fields))\n\n    def dates(*titles):\n        return {zone: {'res': 'ok', 'readoutTitle': title} for zone, title in zip(['utc', 'la', 'kolkata'], titles)}\n\n    modify('results', lambda _: {\n        'fake': 'SYNTHETIC FIXTURE, DO NOT PUBLISH',\n        'scale': {'10000': {'taskMs': 4242}, '100000': {'taskMs': 424242}, '1000000': {'skipped': 'synthetic skip'}},\n        'stream': {'taskMsPerUpdate': 42.4, 'pushP95': 0.42, 'framesOver20ms': 42},\n        'dates': {\n            'trend': dates('Feb 24, 2026, 12:00 AM UTC', 'Feb 23, 2026, 4:00 PM PST', 'Feb 24, 2026, 5:30 AM GMT+5:30'),\n            'dates': dates('Feb 24, 2026', 'Feb 24, 2026', 'Feb 24, 2026'),\n        },\n        'keyboard': {'stops': [{}, {}]},\n        'resize': {'widestGraphic': 342},\n    })\n    output = subprocess.check_output(['node', str(tables)], text=True)\n    assert '| Axylo, defaults | 4.2 s | 424.2 s | not run | 42.4 ms | 0.42 ms | 42 |' in output\n    assert 'Feb 24, 2026, 5:30 AM GMT+5:30 | **no** |' in output\n    assert '| Axylo | Feb 24, 2026 | Feb 24, 2026 | Feb 24, 2026 | yes |' in output\n    assert 'Axylo undefined undefined widest graphic after resize 342 tab stops 2' in output\n\n    modify('sizes', lambda _: {'version': 'fake-version', 'license': 'fake-license', 'gzipKB': 4242, 'harnessLoc': 42})\n    modify('palette', lambda fields: fields['chartjs'])\n    output = subprocess.check_output(['node', str(tables)], text=True)\n    assert '| Axylo | fake-version | – | – | – | fake-license | 4242 kB | 42 |' in output\n    assert '| Axylo | \"'`#36a2eb`'\"' in output\n    assert 'Axylo protan' in output\nassert not work.exists()\nprint('Synthetic results, size and palette rows passed. Disposable copy removed.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
