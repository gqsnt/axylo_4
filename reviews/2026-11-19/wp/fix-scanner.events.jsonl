{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'NODE'\nimport { readTitles, matchesTemplate } from './acceptance/titles.mjs';\nimport { citedTestFiles } from './acceptance/provenance.mjs';\nimport { readFileSync, readdirSync } from 'node:fs';\nconst json = f => JSON.parse(readFileSync(f, 'utf8'));\nconst cited = citedTestFiles(json('acceptance/matrix.json'));\nconst scans = new Map(cited.map(f => [f, readTitles(readFileSync(f, 'utf8'), f)]));\nconst compared = new Set();\nconst mismatches = new Map();\nconst unresolved = new Map();\nlet assertions = 0;\nfor (const name of readdirSync('acceptance/results').filter(f => f.endsWith('.json') && \"'!f.endsWith('\"'.provenance.json'))) {\n  const suites = json('acceptance/results/' + name).testResults;\n  if (\"'!Array.isArray(suites)) continue;\n  let matched = 0;\n  for (const { name: path, assertionResults } of suites) {\n    const normalized = path.replaceAll('\"'\\\\\\\\', '/');\n    const file = cited.find(f => normalized === f || normalized.endsWith('/' + f));\n    if (\"'!file) continue;\n    matched++;\n    compared.add(file);\n    const {tests, templates} = scans.get(file);\n    for (const { title, ancestorTitles } of assertionResults) {\n      assertions++;\n      const candidates = [...tests.filter(t => t.title === title), ...templates.filter(t => matchesTemplate(title, t.template))];\n      if (candidates.some(t => t.ancestors.length === ancestorTitles.length && t.ancestors.every((s, i) => s === null || s === ancestorTitles[i]))) continue;\n      const list = candidates.length ? mismatches : unresolved;\n      if (!list.has(file)) list.set(file, { count: 0, runs: new Set(), examples: [] });\n      const entry = list.get(file);\n      entry.count++;\n      entry.runs.add(name);\n      if (entry.examples.length < 3 && !entry.examples.some(e => e.title === title)) entry.examples.push({title, reported: ancestorTitles, scan: candidates.map(t => t.ancestors)});\n    }\n  }\n  console.log(name, matched, '\"'cited files');\n}\nconsole.log({cited: cited.length, compared: compared.size, assertions, unreportedFiles: cited.filter(f => \"'!compared.has(f))});\nfor (const [label, results] of [['\"'Different ancestors', mismatches], ['Titles not resolved by scan', unresolved]]) {\n  console.log(label);\n  for (const [file, entry] of results) console.log(file, JSON.stringify({...entry, runs: [...entry.runs]}));\n}\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
