{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc 'nl -ba acceptance/titles.mjs'","aggregated_output":"     1\t// This is a source scanner, not a TypeScript interpreter. It recognizes conventional Vitest\n     2\t// calls, literal titles, scalar it.each lists with %s/%d/%i/%# titles, and simple template\n     3\t// substitutions from for-of literal lists (including named relative imports of such lists).\n     4\t// It does not resolve renamed test APIs, arbitrary expressions, shared registration functions,\n     5\t// tagged tables, complex template expressions, or generated files. Unexpanded test templates can\n     6\t// still anchor exact reported titles without evaluating the expression.\n     7\t//\n     8\t// What the scanner cannot know is recorded rather than guessed:\n     9\t// - a registration inside an `if`/`else` block or statement, or after `&&`, `||`, `?` or `:`, is\n    10\t//   `conditional` (it may never run for some or all of its expanded titles);\n    11\t// - a `describe.each` whose rows are not a literal list is a suite of unknown title: `null` in the\n    12\t//   ancestors of the tests inside it, standing for exactly one runtime suite title;\n    13\t// - a `describe.each` with literal rows puts each test in one row's suite at a time, never in all of them.\n    14\timport { readFileSync } from 'node:fs';\n    15\timport { dirname, resolve } from 'node:path';\n    16\t\n    17\tconst ordinary = /\\s+|\\/\\*[\\s\\S]*?\\*\\/|\\/\\/[^\\r\\n]*|'(?:\\\\[\\s\\S]|[^'\\\\])*'|\"(?:\\\\[\\s\\S]|[^\"\\\\])*\"|=>|[\\w$]+|[^\\s]/y;\n    18\tconst regexLiteral = /\\/(?:\\\\.|\\[(?:\\\\.|[^\\]\\\\\\r\\n])*\\]|[^/\\\\\\r\\n])+\\/[dgimsuvy]*/y;\n    19\tconst expressionStarts = new Set(['=', '(', '[', '{', ',', ':', '?', '!', '&', '|', ';', '=>', 'return']);\n    20\t\n    21\tfunction tokenAt(source, start, previous) {\n    22\t  if (source[start] === '`') return source.slice(start, scanTemplate(source, start).end);\n    23\t  if (source[start] === '/' && (!previous || expressionStarts.has(previous))\n    24\t    && source[start + 1] !== '/' && source[start + 1] !== '*') {\n    25\t    regexLiteral.lastIndex = start;\n    26\t    const regex = regexLiteral.exec(source);\n    27\t    if (regex) return regex[0];\n    28\t  }\n    29\t  ordinary.lastIndex = start;\n    30\t  return ordinary.exec(source)[0];\n    31\t}\n    32\t\n    33\tconst trivia = token => /^\\s|^\\/[/\\*]/.test(token);\n    34\t\n    35\tfunction scanTemplate(source, start) {\n    36\t  let end = start + 1;\n    37\t  const spans = [];\n    38\t  while (end < source.length) {\n    39\t    const char = source[end++];\n    40\t    if (char === '\\\\') end++;\n    41\t    else if (char === '`') break;\n    42\t    else if (char === '$' && source[end] === '{') {\n    43\t      const from = end - 1;\n    44\t      let braces = 1;\n    45\t      let previous = '{';\n    46\t      end++;\n    47\t      while (braces && end < source.length) {\n    48\t        const token = tokenAt(source, end, previous);\n    49\t        end += token.length;\n    50\t        if (trivia(token)) continue;\n    51\t        if (token === '{') braces++;\n    52\t        if (token === '}') braces--;\n    53\t        previous = token;\n    54\t      }\n    55\t      spans.push({ from, to: end });\n    56\t    }\n    57\t  }\n    58\t  return { end, spans };\n    59\t}\n    60\t\n    61\tfunction tokens(source) {\n    62\t  const parts = [];\n    63\t  for (let start = 0; start < source.length;) {\n    64\t    const token = tokenAt(source, start, parts.at(-1));\n    65\t    start += token.length;\n    66\t    if (!trivia(token)) parts.push(token);\n    67\t  }\n    68\t  return parts;\n    69\t}\n    70\t\n    71\tfunction unescape(text) {\n    72\t  return text.replace(/\\\\(?:u\\{([\\da-f]+)\\}|u([\\da-f]{4})|x([\\da-f]{2})|(\\r\\n|[\\s\\S]))/gi,\n    73\t    (_, codePoint, unicode, hex, char) => {\n    74\t      const code = codePoint ?? unicode ?? hex;\n    75\t      if (code !== undefined) return String.fromCodePoint(parseInt(code, 16));\n    76\t      return ({ n: '\\n', r: '\\r', t: '\\t', b: '\\b', f: '\\f', v: '\\v', '0': '\\0', '\\n': '', '\\r': '', '\\r\\n': '' })[char] ?? char;\n    77\t    });\n    78\t}\n    79\t\n    80\tconst closer = { '(': ')', '[': ']', '{': '}' };\n    81\tfunction closing(parts, start) {\n    82\t  const stack = [];\n    83\t  for (let index = start; index < parts.length; index++) {\n    84\t    const token = parts[index];\n    85\t    if (Object.hasOwn(closer, token)) stack.push(closer[token]);\n    86\t    else if (token === stack.at(-1)) stack.pop();\n    87\t    if (!stack.length) return index;\n    88\t  }\n    89\t  return parts.length;\n    90\t}\n    91\t\n    92\tfunction literalList(parts, start) {\n    93\t  if (parts[start] !== '[') return null;\n    94\t  const values = [];\n    95\t  let index = start + 1;\n    96\t  while (index < parts.length && parts[index] !== ']') {\n    97\t    const token = parts[index];\n    98\t    if (token === '[') {\n    99\t      const nested = literalList(parts, index);\n   100\t      if (!nested) return null;\n   101\t      values.push(nested);\n   102\t      index = closing(parts, index);\n   103\t    } else {\n   104\t      const value = token === '-' ? token + parts[++index] : token;\n   105\t      if (/^['\"]/.test(value)) values.push(unescape(value.slice(1, -1)));\n   106\t      else if (/^-?\\d+$|^(true|false|null|NaN|Infinity|-Infinity)$/.test(value)) values.push(value);\n   107\t      else return null;\n   108\t    }\n   109\t    index++;\n   110\t    if (parts[index] === ',') index++;\n   111\t    else if (parts[index] !== ']') return null;\n   112\t  }\n   113\t  return parts[index] === ']' ? values : null;\n   114\t}\n   115\t\n   116\tfunction listByName(source, file, name) {\n   117\t  if (!/^\\w+$/.test(name)) return null;\n   118\t  const declaration = new RegExp('\\\\bconst\\\\s+' + name + '\\\\s*(?::[^=;]+)?=\\\\s*(?=\\\\[)');\n   119\t  const list = content => {\n   120\t    const match = declaration.exec(content);\n   121\t    return match && literalList(tokens(content.slice(match.index + match[0].length)), 0);\n   122\t  };\n   123\t  const local = list(source);\n   124\t  if (local) return local;\n   125\t  const imports = source.matchAll(/^import\\s*\\{([^}]+)\\}\\s*from\\s*['\"](\\.[^'\"]+)['\"]/gm);\n   126\t  for (const [, names, specifier] of imports) {\n   127\t    if (!names.split(',').some(imported => imported.trim() === name)) continue;\n   128\t    const base = resolve(dirname(file), specifier);\n   129\t    for (const candidate of [base, base + '.ts', base + '.js', base + '.mjs']) {\n   130\t      try {\n   131\t        return list(readFileSync(candidate, 'utf8'));\n   132\t      } catch (error) {\n   133\t        if (error.code !== 'ENOENT' && error.code !== 'EISDIR') throw error;\n   134\t      }\n   135\t    }\n   136\t  }\n   137\t  return null;\n   138\t}\n   139\t\n   140\tfunction expandTitles(token, rows, loops) {\n   141\t  if (!token || !/^['\"`]/.test(token)) return [];\n   142\t  const raw = token.slice(1, -1);\n   143\t  let titles = [raw];\n   144\t  if (token.startsWith('`')) {\n   145\t    const spans = scanTemplate(token, 0).spans.map(({ from, to }) =>\n   146\t      ({ from, to, name: token.slice(from + 2, to - 1).trim() }));\n   147\t    let bindings = [new Map()];\n   148\t    for (const name of new Set(spans.map(span => span.name))) {\n   149\t      const loop = loops.findLast(item => item.name === name);\n   150\t      if (!loop || !loop.values || loop.values.some(Array.isArray)) return [];\n   151\t      bindings = bindings.flatMap(binding => loop.values.map(value => new Map([...binding, [name, value]])));\n   152\t    }\n   153\t    titles = bindings.map(binding => {\n   154\t      let start = 1;\n   155\t      const parts = [];\n   156\t      for (const { from, to, name } of spans) {\n   157\t        parts.push(token.slice(start, from), binding.get(name));\n   158\t        start = to;\n   159\t      }\n   160\t      return parts.join('') + token.slice(start, -1);\n   161\t    });\n   162\t  }\n   163\t  if (rows) {\n   164\t    titles = titles.flatMap(title => rows.map((row, index) => {\n   165\t      const values = Array.isArray(row) ? row : [row];\n   166\t      let column = 0;\n   167\t      return title.replace(/%[sdi#%]/g, match => {\n   168\t        if (match === '%#') return index;\n   169\t        if (match === '%%') return '%';\n   170\t        return values[column++] ?? match;\n   171\t      });\n   172\t    }));\n   173\t  }\n   174\t  return titles.map(unescape);\n   175\t}\n   176\t\n   177\texport function readTitles(source, file) {\n   178\t  const parts = tokens(source);\n   179\t  const suites = [];\n   180\t  const tests = [];\n   181\t  const templates = [];\n   182\t  const loops = [];\n   183\t  const conditions = [];\n   184\t  for (let index = 0; index < parts.length; index++) {\n   185\t    const token = parts[index];\n   186\t    if ((token === 'if' && parts[index + 1] === '(') || token === 'else') {\n   187\t      const body = token === 'if' ? closing(parts, index + 1) + 1 : index + 1;\n   188\t      if (parts[body] !== 'if') conditions.push({ start: body, end: parts[body] === '{' ? closing(parts, body) : statementEnd(parts, body) });\n   189\t    }\n   190\t    if (token === 'for' && parts[index + 1] === '(' && parts[index + 2] === 'const' && parts[index + 4] === 'of') {\n   191\t      const start = closing(parts, index + 1) + 1;\n   192\t      if (parts[start] === '{') {\n   193\t        const values = literalList(parts, index + 5) ?? listByName(source, file, parts[index + 5]);\n   194\t        loops.push({ name: parts[index + 3], start, end: closing(parts, start), values });\n   195\t      }\n   196\t    }\n   197\t    if (!['it', 'test', 'describe'].includes(token) || parts[index - 1] === '.') continue;\n   198\t    let call = index + 1;\n   199\t    let rows;\n   200\t    const modifiers = [];\n   201\t    while (parts[call] === '.') {\n   202\t      const modifier = parts[call + 1];\n   203\t      modifiers.push(modifier);\n   204\t      call += 2;\n   205\t      if (['each', 'skipIf', 'runIf'].includes(modifier) && parts[call] === '(') {\n   206\t        // A literal list, or a const declared as one (here or in a named relative import), as for-of loops.\n   207\t        if (modifier === 'each') rows = literalList(parts, call + 1) ?? (parts[call + 2] === ')' ? listByName(source, file, parts[call + 1]) : null) ?? [];\n   208\t        call = closing(parts, call) + 1;\n   209\t      }\n   210\t    }\n   211\t    if (parts[call] !== '(') continue;\n   212\t    const titles = [',', ')'].includes(parts[call + 2])\n   213\t      ? expandTitles(parts[call + 1], rows, loops.filter(loop => loop.start < index && index < loop.end))\n   214\t      : [];\n   215\t    const containing = suites.filter(suite => suite.start < index && index < suite.end);\n   216\t    const forbidden = [...new Set([...containing.flatMap(suite => suite.forbidden),\n   217\t      ...modifiers.filter(modifier => ['fails', 'todo', 'skip'].includes(modifier))])];\n   218\t    const conditional = ['&&', '||', '?', ':'].includes(parts[index - 1])\n   219\t      || conditions.some(range => range.start <= index && index <= range.end) || containing.some(suite => suite.conditional);\n   220\t    if (token === 'describe') {\n   221\t      const end = closing(parts, call);\n   222\t      // The callback's block ends just before the last argument or closing parenthesis.\n   223\t      const start = parts.indexOf('{', call + 3);\n   224\t      // A describe.each over rows the scanner cannot list is one suite whose runtime title is unknown.\n   225\t      const names = titles.length ? titles : modifiers.includes('each') ? [null] : [];\n   226\t      if (start !== -1 && start < end) for (const title of names) suites.push({ title, start, end: closing(parts, sta