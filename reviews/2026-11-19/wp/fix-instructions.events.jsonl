: ['line', 'area', 'bar', 'scatter'], referenceBand: ['line', 'area', 'bar', 'scatter'],\n  plotRole: ['line', 'area', 'bar', 'scatter', 'donut'], pointAll: ['line', 'area', 'bar'], seriesValue: ['line', 'area', 'bar'],\n  position: ['line', 'area', 'bar', 'donut'], total: ['area', 'bar'], panLeft: ['line', 'area', 'scatter'], panRight: ['line', 'area', 'scatter'],\n  // totalMixed: a mixed-sign stack's readout (spec F10). incompleteAt and incompleteCount are summary templates\n  // for charts that have no tooltip or table, the compact kinds (src/reader/index.ts uses them there); on full\n  // area and bar charts an incomplete stack is marked through incompleteStack in tooltip, table and value text.\n  // The compact scenario below exercises compact area and compact bar for them.\n  totalMixed: ['area', 'bar'], incompleteAt: ['compact'], incompleteCount: ['compact'],\n  // selectRange: the toolbar toggle for two-click range selection, shown wherever drag-to-zoom is (as Zoom in).\n  selectRange: ['line', 'area', 'scatter'],\n  jumpNotFound: ['line', 'area', 'bar', 'scatter', 'donut'], plotInstructions: ['line', 'area', 'bar', 'scatter', 'donut'], seeTable: ['line', 'area', 'bar', 'scatter', 'donut'],\n};\nconst KEYS = Object.keys(WHERE) as (keyof Messages)[];\n/** Each key's own sentinel, with every placeholder the templates use, so filled templates stay recognisable. */\nconst sentinel = (k: keyof Messages) => `[${k}]`;\nconst MESSAGES = Object.fromEntries(KEYS.map(k => [k, `${sentinel(k)} {count}{seeTable}{type}{x}{y}{series}{value}{index}{label}{from}{to}{zone}{min}{max}{last}{total}{xLabel}{xMin}{xMax}{yLabel}{yMin}{yMax}{seriesCount}{values}{position}{percent}{example}{page}{positive}{negative}{at}`])) as Record<keyof Messages, string>;\n\n/** Everything the reader gets from the chart now: AX names, descriptions, roles, static text, the value text (DOM attribute), visible text and title attributes. */\nasync function surfaces(page: Page): Promise<string> {\n  const parts: string[] = [];\n  for (const n of await axWithin(page, '#chart')) parts.push(n.name, n.description, String(n.props.roledescription ?? ''));\n  parts.push(await page.evaluate(() => [...document.querySelectorAll('#chart *')].map(e => `${e.getAttribute('aria-valuetext') ?? ''} ${e.getAttribute('title') ?? ''}`).join(' ')));\n  parts.push(await page.locator('#chart').innerText());\n  return parts.join(' | ');\n}\n\n/** Scenarios that between them bring every applicable built-in string of `type` onto a reader surface. */\nasync function exercise(page: Page, type: ChartType): Promise<string> {\n  const seen: string[] = [];\n  const fresh = async (fn: string, options: Record<string, unknown>) => {\n    await page.evaluate(() => { for (const c of (window as unknown as { charts: { destroy(): void }[] }).charts.splice(0)) c.destroy(); });\n    await createRaw(page, fn, { ...options, messages: MESSAGES });\n  };\n  const take = async () => { seen.push(await surfaces(page)); };\n  const aligned = type === 'line' || type === 'area' || type === 'bar';\n  const fn = type === 'compact' ? 'line' : type;\n  const compact = type === 'compact' ? { compact: true } : {};\n  const DAY = 864e5, T0 = Date.UTC(2026, 2, 2);\n  // 1. Instants with a null, a series with no row at one x, a series with no data, a duplicate x in a series, references; no title.\n  if (type === 'donut') {\n    await fresh('donut', { data: [{ l: 'A', v: 30 }, { l: 'B', v: null }, { l: 'C', v: '__NaN__' }, ...Array.from({ length: 8 }, (_, i) => ({ l: `S${i}`, v: 10 - i }))], label: 'l', value: 'v' });\n  } else if (type === 'scatter') {\n    await fresh('scatter', { data: [{ x: T0, y: 1, s: 'A' }, { x: T0 + DAY, y: null, s: 'A' }, { x: T0 + 2 * DAY, y: '__NaN__', s: 'A' }, { x: T0, y: 2, s: 'Z' }, { x: T0, y: null, s: 'E' }], x: { field: 'x', type: 'time', timeZone: 'UTC' }, y: 'y', series: 's', reference: [{ y: 1.5, label: 'Mid' }, { y: [0.5, 0.8], label: 'Low' }] });\n  } else {\n    const rows = [\n      { x: T0, s: 'A', y: 1 }, { x: T0 + DAY, s: 'A', y: null }, { x: T0 + 2 * DAY, s: 'A', y: 3 }, { x: T0 + 3 * DAY, s: 'A', y: '__NaN__' },\n      { x: T0, s: 'B', y: 2 }, { x: T0 + 2 * DAY, s: 'B', y: 4 }, { x: T0 + 3 * DAY, s: 'B', y: 5 },\n      { x: T0, s: 'E', y: null }, { x: T0, s: 'D', y: 1 }, { x: T0, s: 'D', y: 2 },\n      // A negative component, so a stacked readout has a positive and a negative total (totalMixed).\n      { x: T0 + 2 * DAY, s: 'C', y: -2 },\n    ];\n    await fresh(fn, { data: type === 'compact' ? rows.filter(r => r.s === 'A') : rows, x: { field: 'x', type: 'time', timeZone: 'UTC' }, y: 'y', ...(type === 'compact' ? {} : { series: 's' }), ...compact, ...(type === 'compact' ? {} : { reference: [{ y: 1.5, label: 'Mid' }, { x: [T0 + DAY, T0 + 2 * DAY], label: 'Window' }] }), ...((type === 'area' || type === 'bar') ? (type === 'area' ? { stacked: true } : { layout: 'stacked' }) : {}) });\n  }\n  await take();\n  if (type === 'compact') {\n    // Compact area and compact bar, stacked with a missing component: the summary says the stacks are incomplete.\n    // One incomplete stack is named by position (incompleteAt); many are counted (incompleteCount,\n    // src/reader/index.ts: more than MAX_STACK_POSITIONS).\n    for (const kind of ['area', 'bar'] as const) {\n      for (const incomplete of [1, 12]) {\n        const xs = Array.from({ length: 14 }, (_, k) => `c${k}`);\n        const data = xs.flatMap((x, k) => [{ x, s: 'P', y: 1 + k }, ...(k > 0 && k <= incomplete ? [] : [{ x, s: 'Q', y: 2 }])]);\n        await fresh(kind, { compact: true, data, x: 'x', y: 'y', series: 's', ...(kind === 'area' ? { stacked: true } : { layout: 'stacked' }) });\n        await take();\n      }\n    }\n  }\n  if (type !== 'compact') {\n    // 2. Keyboard over the null and the missing row, tooltip on them, the table with a failed jump.\n    await page.focus('#chart .axylo-proxy');\n    for (let i = 0; i < 3; i++) { await page.keyboard.press('ArrowRight'); await take(); }\n    await page.keyboard.press('ArrowDown');\n    await take();\n    const p = await box(page, '#chart .axylo-proxy');\n    for (const f of [0.02, 0.35, 0.65, 0.98]) { await page.mouse.move(p.x + f * p.width, p.y + p.height / 2); await settle(page); await take(); }\n    // Off the plot first: whether the readout may cover a control is I1's question (i1-pointer), not this one's.\n    await page.mouse.move(0, 0);\n    await page.focus('#before');\n    await settle(page);\n    await page.locator('#chart [role=\"toolbar\"] button').last().click();\n    await settle(page);\n    await take();\n    // 3. Paging (250 rows), zoom and pan, streaming and pause, more than eight rows in a tooltip.\n    const many = type === 'donut' ? { data: Array.from({ length: 250 }, (_, k) => ({ l: `c${k}`, v: k + 1 })), label: 'l', value: 'v' }\n      : type === 'scatter' ? { data: [...Array.from({ length: 250 }, (_, k) => ({ x: k, y: k % 7, s: 'S0' })), ...Array.from({ length: 10 }, (_, k) => ({ x: 100, y: 3, s: `S${k + 1}` }))], x: 'x', y: 'y', series: 's' }\n        : { data: Array.from({ length: 250 }, (_, k) => Array.from({ length: 10 }, (_, s) => ({ x: type === 'bar' ? `c${k}` : k, s: `S${s}`, y: k + s }))).flat(), x: 'x', y: 'y', series: 's' };\n    await fresh(fn, { title: 'Many', ...many });\n    await page.locator('#chart [role=\"toolbar\"] button').last().click();\n    await settle(page);\n    await page.locator('#chart .axylo-pager button').last().click();\n    await settle(page);\n    await take();\n    await page.locator('#chart .axylo-jump-field').click();\n    await page.keyboard.type('no such value');\n    await page.keyboard.press('Enter');\n    await settle(page);\n    await take();\n    // Close the table again, so the plot is back under the pointer.\n    await page.locator('#chart [role=\"toolbar\"] button').last().click();\n    await settle(page);\n    if (type === 'line' || type === 'area' || type === 'scatter') {\n      await page.mouse.move(0, 0);\n      for (const k of ['zoomIn', 'panLeft'] as const) {\n        const b = page.locator('#chart [role=\"toolbar\"] button', { hasText: sentinel(k) });\n        if (await b.count() !== 1) throw new Error(`no ${k} control`);\n        await b.click({ timeout: 10000 });\n        await settle(page);\n      }\n      await take();\n    }\n    const q = await box(page, '#chart .axylo-proxy');\n    // More than eight rows: the coincident scatter points (series S1…S10 at one place), or ten series at one x.\n    const at = type === 'scatter' ? center((await shapes(page, '#chart', 14))[2]![0]!.box) : { x: q.x + q.width * 0.4, y: q.y + q.height / 2 };\n    await page.mouse.move(at.x, at.y);\n    await settle(page);\n    await take();\n    await call(page, 'append', [type === 'donut' ? [{ l: 'new', v: 3 }] : type === 'scatter' ? [{ x: 300, y: 1, s: 'S0' }] : [{ x: type === 'bar' ? 'new' : 300, s: 'S0', y: 1 }]]);\n    await take();\n    await page.mouse.move(0, 0);\n    await settle(page);\n    await page.locator('#chart [role=\"toolbar\"] button', { hasText: sentinel('pause') }).click();\n    await settle(page);\n    await take();\n  }\n  // 4. States: loading, empty, author error, internal failure.\n  for (const state of ['loading', 'empty', 'error'] as const) {\n    await call(page, 'update', [state === 'loading' ? { state: 'loading' } : state === 'empty' ? { state: 'ready', data: [] } : { state: { error: 'Query failed' } }]);\n    await take();\n  }\n  // A chart error of Axylo's own (AX101: the value field is not in the rows) shows the built-in error text.\n  await call(page, 'update', [type === 'donut' ? { state: 'ready', data: [{ l: 'A', v: 1 }], value: 'nosuch' } : { state: 'ready', data: [{ x: 1, y: 1 }], x: 'x', y: 'nosuch' }]);\n  await take();\n  await call(page, 'update', [type === 'donut' ? { data: [{ l: 'A', v: 1 }], value: 'v' } : { data: [{ x: 1, y: 1 }], x: 'x', y: 'y' }]);\n  await page.evaluate(() => (window as unknown as { charts: { __dev: { fail(s: string | null): void } }[] }).charts[0]!.__dev.fail('reader'));\n  await call(page, 'update', [{ title: 'Again' }]);\n  await take();\n  void aligned;\n  return seen.join(' || ');\n}\n\ndescribe('A10 built-in text', () => {\n  for (const type of TYPES) {\n    it(`A10 ${type}: every built-in string that a ${type} chart shows is replaced through messages: each applicable key's own sentinel reaches a reader surface, and no built-in English is left`, async () => {\n      // Room enough that the sentinel texts (each a key plus every placeholder) leave a plot to read.\n      const page = await devPage({ viewport: { width: 1200, height: 1100 }, css: '#chart { width: 1100px; height: 900px; }' });\n      const text = await exercise(page, type);\n      const missing = KEYS.filter(k => Array.isArray(WHERE[k]) && (WHERE[k] as readonly ChartType[]).includes(type) && !text.includes(sentinel(k)));\n      expect(missing, 'keys whose replacement never reached a surface').toEqual([]);\n      // Sentinels are taken out first: \"[moreRows]\" must not count as the English word.\n      const plain = text.replace(/\\[[A-Za-z]+\\]/g, '');\n      const ENGLISH = ['View as table', 'Hide table', 'Chart plot', 'Chart controls', 'Zoom in', 'Zoom out', 'Reset zoom', 'No data', 'No observation', 'not shown', 'shown differently', 'Previous page', 'Next page', 'Jump to', 'Percentage', 'minimum', 'maximum', 'Point ', ' chart with', 'Pause', 'Resume', 'Times are shown', 'See table', 'Loading chart', 'No data to show', 'could not be drawn', 'went wrong', 'Pan left', 'Pan right', 'Arrow keys', 'Reference line', 'Reference band', 'Total', 'incomplete'];\n      expect([...ENGLISH.filter(e => plain.includes(e)), ...(/\\+\\d+ more/.test(plain) ? ['+N more'] : [])], 'built-in English still shown').toEqual([]);\n      expect(await closePage(page)).toEqual([]);\n    });\n/**\n * Shared setup for the chart tests: the test page with the built script-tag bundle (`window.Axylo`, the\n * development flavour), and the Phase 1 fixtures (research/harness/src/data.js) installed as `window.fx`.\n */\nimport type { BrowserContextOptions, Page } from 'playwright-core';\nimport { expect } from 'vitest';\nimport { openPage } from '../harness';\nimport { decodePng, type Image } from '../render/png';\n\nexport type { Image };\n\ndeclare global {\n  interface Window {\n    // The bundle's global and the fixtures, typed loosely: the tests drive the public API as a page would.\n    Axylo: Record<string, (...args: unknown[]) => ChartLike>;\n    fx: Fixtures;\n    charts: ChartLike[];\n    nextFrames(n?: number): Promise<void>;\n  }\n}\n\nexport interface ChartLike {\n  update(patch: Record<string, unknown>): void;\n  append(rows: readonly unknown[], options?: { keep?: number }): void;\n  zoom(domain: readonly unknown[] | null): void;\n  on(event: string, listener: (payload: unknown) => void): () => void;\n  readonly diagnostics: readonly { code: string; level: string; message: string; field?: string; chart: string }[];\n  destroy(): void;\n  __bench: { revision: number; ready(): Promise<void>; describe(): { xDomain: number[] | null; yDomain: number[] | null; series: { key: string; points: number; oldestX: number; newestX: number; missing: number }[] } };\n  __dev: { stages(): Stages; fail(stage: string | null): void; renderer: string };\n}\n\n/** Counters per pipeline stage (src/core/chart.ts, STAGES). */\nexport type Stages = Record<'options' | 'normalize' | 'append' | 'view' | 'frame' | 'theme' | 'formatters' | 'layout' | 'scene' | 'lookup' | 'reader' | 'draw' | 'text' | 'figure', number>;\n\nexport interface Fixtures {\n  trend: { title: string; yTitle: string; t: number[]; series: { name: string; values: (number | null)[] }[] };\n  trendRows(): Record<string, unknown>[];\n  datesRows(): Record<string, unknown>[];\n  bars: { title: string; yTitle: string; name: string; categories: string[]; values: number[] };\n  parts: { title: string; name: string; labels: string[]; values: number[] };\n  dirtyRows(): Record<string, unknown>[];\n  scale(n: number): { title: string; t: number[]; y: number[] };\n  rng(seed: number): () => number;\n}\n\n/** Runs in the page: the Phase 1 fixtures, reproduced from research/harness/src/data.js. */\nfunction installFixtures(): void {\n  function rng(seed: number) {\n    let s = seed >>> 0;\n    return () => { s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };\n  }\n  const DAY = 864e5;\n  const START = Date.UTC(2026, 0, 1);\n  const trend = (() => {\n    const r = rng(7), n = 120;\n    const t = Array.from({ length: n }, (_, i) => START + i * DAY);\n    const mk = (base: number, growth: number, noise: number, season: number) => t.map((_, i) => Math.round(base + growth * i + season * Math.sin((i / 7) * 2 * Math.PI) + (r() - 0.5) * noise));\n    const series: { name: string; values: (number | null)[] }[] = [\n      { name: 'Direct', values: mk(31000, 120, 4000, 3000) },\n      { name: 'Organic search', values: mk(18000, 60, 3000, 2500) },\n      { name: 'Referral', values: mk(4200, -8, 1200, 400) },\n    ];\n    for (let i = 60; i < 67; i++) series[2]!.values[i] = null;\n    return { title: 'Daily sessions by channel', yTitle: 'Sessions', t, series };\n  })();\n  const days = trend.t.map(t => new Date(t).toISOString().slice(0, 10));\n  const dirty = { categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'], values: [10, 20, null, NaN, '40', undefined, 70] };\n  const fx = {\n    rng,\n    trend,\n    trendRows: () => trend.series.flatMap(s => s.values.map((v, i) => ({ day: trend.t[i], channel: s.name, sessions: v }))),\n    datesRows: () => trend.series.flatMap(s => s.values.map((v, i) => ({ day: days[i], channel: s.name, sessions: v }))),\n    bars: {\n      title: 'Customer satisfaction by team', yTitle: 'Satisfied (%)', name: 'Satisfied (%)',\n      categories: ['Billing', 'Customer Success & Onboarding', 'Platform', 'Mobile', 'Data', 'Security', 'Sales Eng.'],\n      values: [94, 88, 97, 82, 91, 85, 90],\n    },\n    parts: {\n      title: 'Sessions by browser', name: 'Share (%)',\n      labels: ['Chrome', 'Safari', 'Edge', 'Firefox', 'Samsung Internet', 'Other'],\n      values: [46.2, 27.5, 14.1, 8.9, 2.1, 1.2],\n    },\n    dirtyRows: () => dirty.categories.map((day, i) => (dirty.values[i] === undefined ? { day } : { day, value: dirty.values[i] })),\n    scale(n: number) {\n      const r = rng(1), t = new Array<number>(n), y = new Array<number>(n);\n      let v = 100;\n      for (let i = 0; i < n; i++) { v += (r() - 0.5) * 2; t[i] = START + i * 60000; y[i] = Math.round(v * 100) / 100; }\n      return { title: `${n.toLocaleString('en-US')} points`, t, y };\n    },\n  };\n  (window as unknown as { fx: unknown }).fx = fx;\n  (window as unknown as { charts: unknown[] }).charts = [];\n  (window as unknown as { nextFrames: (n?: number) => Promise<void> }).nextFrames = (n = 1) => new Promise(resolve => {\n    let left = n;\n    const step = () => { if (--left <= 0) resolve(); else requestAnimationFrame(step); };\n    requestAnimationFrame(step);\n  });\n}\n\n/**\n * The mark renderer the suite runs with: `AXYLO_RENDERER=canvas npm run test:browser` runs every chart test\n * with the canvas renderer; unset, charts use the library's default (SVG, decision 0002). A test that passes\n * `__renderer` itself keeps its choice.\n */\nexport const RENDERER = process.env.AXYLO_RENDERER === 'canvas' || process.env.AXYLO_RENDERER === 'svg' ? process.env.AXYLO_RENDERER : null;\n\n/** A directory holding another build's axylo.iife.js and axylo.css (see chartPage). */\nconst BUNDLE = process.env.AXYLO_BUNDLE ?? null;\n\n/** Whether the running test file is one of the chart core's own browser suites (chart/, a11y/). */\nfunction ownSuite(): boolean {\n  const path = (expect.getState().testPath ?? '').replace(/\\\\/g, '/');\n  return /\\/test\\/browser\\/(?:chart|a11y)\\//.test(path);\n}\n\n/** Suites that may run another build through AXYLO_BUNDLE without taking the renderer switch (render/). */\nfunction bundleSuite(): boolean {\n  const path = (expect.getState().testPath ?? '').replace(/\\\\/g, '/');\n  return /\\/test\\/browser\\/render\\//.test(path);\n}\n\n/** Runs in the page: makes the chart functions pass `__renderer` unless the call gives one. */\nfunction selectRenderer(renderer: string): void {\n  const original = (window as unknown as { Axylo: Record<string, unknown> }).Axylo;\n  const wrapped: Record<string, unknown> = { ...original };\n  for (const name of ['line', 'area', 'bar', 'scatter', 'donut']) {\n    const make = original[name] as (target: unknown, options: Record<string, unknown>) => unknown;\n    wrapped[name] = (target: unknown, options: Record<string, unknown>) =>\n      make(target, options !== null && typeof options === 'object' && !('__renderer' in options) ? { ...options, __renderer: renderer } : options);\n  }\n  (window as unknown as { Axylo: unknown }).Axylo = wrapped;\n}\n\nexport async function chartPage(options: BrowserContextOptions & { query?: string; css?: string; standaloneCss?: boolean } = {}): Promise<Page> {\n  const { css, standaloneCss = true, ...rest } = options;\n  const page = await openPage(rest);\n  // AXYLO_BUNDLE=<dir> (this directory's suites only): the page runs the bundle built in <dir> instead of the\n  // shared dist, so a test can be shown to fail on an older revision without touching what other suites load.\n  if (BUNDLE && (ownSuite() || bundleSuite())) {\n    await page.evaluate(() => {\n      document.querySelector('link[rel=\"stylesheet\"]')?.remove();\n      delete (window as unknown as { Axylo?: unknown }).Axylo;\n    });\n    await page.addScriptTag({ path: `${BUNDLE}/axylo.iife.js` });\n    await page.addStyleTag({ path: `${BUNDLE}/axylo.css` });\n  }\n  // Only for this directory's and a11y's tests: other suites (acceptance) read the SVG DOM and choose for themselves.\n  if (RENDERER && ownSuite()) await page.evaluate(selectRenderer, RENDERER);\n  await page.evaluate(installFixtures);\n  // The test page links dist/axylo.css; without it the library applies the same sheet through ensureStyles.\n  if (!standaloneCss) await page.evaluate(() => document.querySelector('link[rel=\"stylesheet\"]')?.remove());\n  await page.addStyleTag({ content: `#before, #after { display: none; } ${css ?? ''}` });\n  return page;\n}\n\nexport async function closePage(page: Page): Promise<string[]> {\n  const errors = (page as Page & { errors: string[] }).errors;\n  await page.context().close();\n  return errors;\n}\n\nexport async function shot(page: Page, selector: string): Promise<{ img: Image; box: { x: number; y: number; width: number; height: number } }> {\n  const box = (await page.locator(selector).boundingBox())!;\n  const img = decodePng(await page.screenshot({ clip: box, animations: 'disabled', caret: 'hide' }));\n  return { img, box };\n}\n\nexport type RGB = readonly [number, number, number];\n\nexport function at(img: Image, x: number, y: number): RGB {\n  const o = (Math.floor(y) * img.width + Math.floor(x)) * 4;\n  return [img.data[o]!, img.data[o + 1]!, img.data[o + 2]!];\n}\n\nexport const diff = (a: RGB, b: RGB): number => Math.max(Math.abs(a[0] - b[0]), Math.abs(a[1] - b[1]), Math.abs(a[2] - b[2]));\n\nexport function hex(color: string): RGB {\n  const m = /^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(color);\n  if (!m) throw new Error(`not a hex color: ${color}`);\n  return [parseInt(m[1]!, 16), parseInt(m[2]!, 16), parseInt(m[3]!, 16)];\n}\n\n/** Pixels of `img` within `tolerance` of `color`. */\nexport function count(img: Image, color: RGB, tolerance = 24, region?: { x0: number; y0: number; x1: number; y1: number }): number {\n  const { x0 = 0, y0 = 0, x1 = img.width, y1 = img.height } = region ?? {};\n  let n = 0;\n  for (let y = y0; y < y1; y++) for (let x = x0; x < x1; x++) if (diff(at(img, x, y), color) <= tolerance) n++;\n  return n;\n}\n\n/** Columns of `img` (within the rows given) that contain `color`. */\nexport function columnsWith(img: Image, color: RGB, y0: number, y1: number, tolerance = 24): boolean[] {\n  const out: boolean[] = [];\n  for (let x = 0; x < img.width; x++) {\n    let hit = false;\n    for (let y = y0; y < y1 && !hit; y++) if (diff(at(img, x, y), color) <= tolerance) hit = true;\n    out.push(hit);\n  }\n  return out;\n}\n\n/** The accessibility tree of the chart target as Playwright's ARIA snapshot (YAML text). */\nexport const aria = (page: Page, selector = '#chart'): Promise<string> => page.locator(selector).ariaSnapshot();\n/**\n * Helpers for the tests of the final interaction review (reviews/2026-11-18/impl/wp/core-final.interaction.review.md)\n * against decision 0004 revision 3.\n */\nimport type { Page } from 'playwright-core';\nimport { requireEngineFeature } from '../harness';\n\nexport type Box = { x: number; y: number; width: number; height: number };\nexport type Pt = { x: number; y: number };\n\nexport const frames = (page: Page, n = 1) => page.evaluate(k => window.nextFrames(k), n);\nexport const settle = (page: Page) => page.evaluate(async () => { for (const c of window.charts) await c.__bench.ready(); await window.nextFrames(2); });\n\nexport async function create(page: Page, kind: string, options: Record<string, unknown>, target = '#chart'): Promise<void> {\n  await page.evaluate(async ({ kind, options, target }) => {\n    const chart = window.Axylo[kind]!(target, options);\n    window.charts.push(chart);\n    await chart.__bench.ready();\n    await window.nextFrames(1);\n  }, { kind, options, target });\n}\n\n/** Records every `select` and `hover` of chart `i` on `window.selected` / `window.hovered`. */\nexport async function recordEvents(page: Page, i = 0): Promise<void> {\n  await page.evaluate(i => {\n    const w = window as unknown as { selected: unknown[]; hovered: unknown[] };\n    w.selected = [];\n    w.hovered = [];\n    window.charts[i]!.on('select', p => w.selected.push(p));\n    window.charts[i]!.on('hover', p => w.hovered.push(p));\n  }, i);\n}\n\nexport const selected = (page: Page) => page.evaluate(() => (window as unknown as { selected: { series: string; x: unknown; y: number | null; row: unknown; index: number }[] }).selected);\nexport const lastHover = (page: Page) => page.evaluate(() => (window as unknown as { hovered: unknown[] }).hovered.at(-1) ?? null);\n\n/** The floating tooltip: its title, row texts, rectangle, and whether it is pinned. */\nexport async function tip(page: Page): Promise<{ title: string | null; rows: string[]; box: Box | null; pinned: boolean }> {\n  return page.evaluate(() => {\n    const t = document.querySelector('#chart .axylo-tooltip') as HTMLElement;\n    if (t.hidden) return { title: null, rows: [], box: null, pinned: false };\n    const b = t.getBoundingClientRect();\n    return {\n      title: t.querySelector('.axylo-tooltip-title')?.textContent ?? null,\n      rows: [...t.querySelectorAll('.axylo-tooltip-row')].map(r => r.textContent ?? ''),\n      box: { x: b.x, y: b.y, width: b.width, height: b.height }, pinned: t.classList.contains('axylo-tooltip-pinned'),\n    };\n  });\n}\n\n/** The readout strip's text, or null when it shows nothing. */\nexport async function strip(page: Page): Promise<{ text: string | null; box: Box }> {\n  return page.evaluate(() => {\n    const r = document.querySelector('#chart .axylo-readout') as HTMLElement;\n    const b = r.getBoundingClientRect();\n    return { text: r.hidden ? null : r.textContent, box: { x: b.x, y: b.y, width: b.width, height: b.height } };\n  });\n}\n\nexport const plotBox = async (page: Page): Promise<Box> => (await page.locator('#chart .axylo-proxy').boundingBox())!;\n\n/** A point 2 px inside `box`, nearest to `from`. */\nexport const nearestInside = (box: Box, from: Pt): Pt => ({\n  x: Math.min(box.x + box.width - 2, Math.max(box.x + 2, from.x)), y: Math.min(box.y + box.height - 2, Math.max(box.y + 2, from.y)),\n});\n\n/** Moves straight from `from` to `to` in `steps` moves, one frame each; returns what was shown after each. */\nexport async function walk<T>(page: Page, from: Pt, to: Pt, steps: number, read: () => Promise<T>): Promise<T[]> {\n  const seen: T[] = [];\n  for (let k = 1; k <= steps; k++) {\n    await page.mouse.move(from.x + (to.x - from.x) * k / steps, from.y + (to.y - from.y) * k / steps);\n    await frames(page);\n    seen.push(await read());\n  }\n  return seen;\n}\n\nexport const overlaps = (a: Box, b: Box) => Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x) > 0.5 && Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y) > 0.5;\nexport const inside = (p: Pt, b: Box) => p.x >= b.x && p.x <= b.x + b.width && p.y >= b.y && p.y <= b.y + b.height;\n\n/** Six full-height bars, so a bar's tooltip has no room above or below and goes beside it (into the next band). */\nexport const TALL = ['Q1', 'Q2', 'Q3', 'Q4', 'Q5', 'Q6'].map((x, i) => ({ x, y: [96, 100, 97, 99, 98, 95][i]! }));\n\n/** Chrome's accessibility nodes (role and name) under the first element matching `selector`. */\nexport async function axButtons(page: Page, selector: string): Promise<string[]> {\n  requireEngineFeature(['chromium'], 'the computed accessibility tree is read through the Chrome DevTools protocol');\n  const client = await page.context().newCDPSession(page);\n  try {\n    const { root } = await client.send('DOM.getDocument', { depth: 0 });\n    const { nodeId } = await client.send('DOM.querySelector', { nodeId: root.nodeId, selector });\n    if (!nodeId) return [];\n    const { node } = await client.send('DOM.describeNode', { nodeId });\n    const { nodes } = await client.send('Accessibility.getPartialAXTree', { backendNodeId: node.backendNodeId, fetchRelatives: false });\n    const { nodes: all } = await client.send('Accessibility.getFullAXTree', {});\n    const within = new Set<string>([nodes[0]!.nodeId]);\n    // Descendants of the element's node in the full tree.\n    for (let grew = true; grew;) {\n      grew = false;\n      for (const n of all) if (n.parentId && within.has(n.parentId) && !within.has(n.nodeId)) { within.add(n.nodeId); grew = true; }\n    }\n    return all.filter(n => within.has(n.nodeId) && !n.ignored && n.role?.value === 'button').map(n => String(n.name?.value ?? ''));\n  } finally {\n    await client.detach();\n  }\n}\n\n/** A drawn shape (SVG renderer): its viewport box and its own path data ('rect' for a rect). */\nexport interface DrawnShape { box: Box; sub: string }\n\n/** Per series colour slot (1-based), the small closed shapes drawn in that colour (markers, points, bars). */\nexport async function drawnShapes(page: Page, maxSize = 20): Promise<Record<number, DrawnShape[]>> {\n  return page.evaluate(maxSize => {\n    const svg = document.querySelector('#chart svg.axylo-svg') as SVGSVGElement | null;\n    const out: Record<number, { box: { x: number; y: number; width: number; height: number }; sub: string }[]> = {};\n    if (!svg) return out;\n    const m = svg.getScreenCTM()!;\n    const toPage = (x: number, y: number) => new DOMPoint(x, y).matrixTransform(m);\n    const slotOf = (el: Element | null): number | null => {\n      for (let e = el; e && e !== svg; e = e.parentElement) {\n        const s = /--axylo-series-color-(\\d+)/.exec((e as SVGElement).style?.getPropertyValue('color') ?? '');\n        if (s) return Number(s[1]);\n      }\n      return null;\n    };\n    for (const el of svg.querySelectorAll('.axylo-scene path, .axylo-scene rect')) {\n      const slot = slotOf(el);\n      if (slot === null) continue;\n      const list = (out[slot] ??= []);\n      if (el.tagName.toLowerCase() === 'rect') {\n        const r = el as SVGRectElement;\n        const a = toPage(r.x.baseVal.value, r.y.baseVal.value);\n        const b = toPage(r.x.baseVal.value + r.width.baseVal.value, r.y.baseVal.value + r.height.baseVal.value);\n        if (!list.some(o => Math.abs(o.box.x - a.x) < 0.01 && Math.abs(o.box.y - a.y) < 0.01)) list.push({ box: { x: a.x, y: a.y, width: b.x - a.x, height: b.y - a.y }, sub: 'rect' });\n        continue;\n      }\n      for (const sub of (el.getAttribute('d') ?? '').split(/(?=M)/)) {\n        const nums = (sub.match(/-?\\d*\\.?\\d+(?:e-?\\d+)?/gi) ?? []).map(Number);\n        if (nums.length < 2 || /A/i.test(sub)) {\n          if (/A/i.test(sub) && nums.length >= 2) {\n            const a = toPage(nums[0]!, nums[1]!);\n            list.push({ box: { x: a.x, y: a.y, width: 0, height: 0 }, sub });\n          }\n          continue;\n        }\n        const xs = nums.filter((_, i) => i % 2 === 0), ys = nums.filter((_, i) => i % 2 === 1);\n        const a = toPage(Math.min(...xs), Math.min(...ys)), b = toPage(Math.max(...xs), Math.max(...ys));\n        if (b.x - a.x > maxSize || b.y - a.y > maxSize) continue;\n        list.push({ box: { x: a.x, y: a.y, width: b.x - a.x, height: b.y - a.y }, sub });\n      }\n    }\n    return out;\n  }, maxSize);\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '46,65p;121,148p;189,201p' docs/02-product-spec.md && cat docs/decisions/0001-plot-interaction-pattern.md && sed -n '44,120p' docs/decisions/0004-tooltip-and-focused-text.md && sed -n '56,64p' docs/05-comparison.md && rg -n '3\\\\.3|3\\\\.4|messages|interaction|A[236]|I3' docs/03-plan-typescript-release.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '46,65p;121,148p;189,201p' docs/02-product-spec.md && cat docs/decisions/0001-plot-interaction-pattern.md && sed -n '44,120p' docs/decisions/0004-tooltip-and-focused-text.md && sed -n '56,64p' docs/05-comparison.md && rg -n '3\\\\.3|3\\\\.4|messages|interaction|A[236]|I3' docs/03-plan-typescript-release.md\"","aggregated_output":"## 2. Scope of the first release\n\n### 2.1 Chart types\n\n| Type | Variants | Typical question | Status |\n|---|---|---|---|\n| Line | Multi-series, gaps; time, date, numeric or category x | How did it change? | 1.0 |\n| Bar | Vertical, horizontal, grouped, stacked | How do categories compare? | 1.0 |\n| Area | Single, stacked | How did the total and its parts change? | 1.0 |\n| Donut | Up to eight slices | What share does each part have? | 1.0 |\n| Scatter | Optional series | How are two measures related? | 1.0 (owner's decision) |\n| Compact variant | Of line, area and bar: marks only, for KPI tiles and sparklines | Which way is it going? | 1.0 (owner's decision) |\n\nPlus, on every cartesian chart: reference lines and bands (a target, an incident window).\n\nThe Phase 1 harness exercised line, bar and donut in all ten libraries (donut in nine; uPlot has none). Area and scatter are added on judgment; Phase 1 found no usage data by chart type. Two reviewers argued for fewer types and one for a compact variant; the owner decided on all five types plus the compact variant. Scatter alone needs two-dimensional hit testing and its own navigation model, so it is built last and carries the most schedule risk.\n\nEach type has its own rules for picking, navigation and limits. They are in the type matrix in section 3.6, and a type does not ship until its row is fully tested.\n\n### 2.2 Workflows\n### 3.3 Interaction\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| I1 | Pointing anywhere in the plot shows what is there, by the picking rule for the chart type (section 3.6), within one frame at the 95th percentile. On line, area and bar the tooltip lists every visible series at the nearest x; a series with no row at that x reads \"No observation\", distinct from \"No data\". The tooltip stays inside the viewport, does not cover the active mark or any control, can itself be hovered, and lists at most eight rows plus \"+N more\". In a plot too small for it (decision 0004: narrower than 240 px or shorter than 140 px) the same content appears as text in a strip reserved under the plot; where even the strip would leave the plot under the minimum of L8, pointing highlights the datum without a readout and the values are in the keyboard reading and the table. Escape closes it until the pointer reaches a different datum. | Hover at 20 positions including all four edges; sparse-series fixture; narrow tile with eight series; Escape test | R15, WCAG 1.4.13, 2.4.11 |\n| I2 | Legend entries that show and hide a series are toggle buttons with a pressed state, operable by click, Enter and Space. A donut's legend lists its slices (F8) and has nothing to hide, so its entries are not toggles and this row does not apply to it. | Keyboard and accessibility-tree tests | R12, WCAG 2.5.3, 4.1.2, 2.1.1 |\n| I3 | Zoom on time, date and numeric x axes is reachable four ways: visible Zoom in, Zoom out and Reset buttons that work with single clicks; drag to select a range; `+`, `-`, `0` and Shift+arrows; and pinch when `zoom: 'touch'` is set. The wheel zooms only while the plot has focus, and never when Ctrl or Meta is held, so browser zoom and page scrolling are not intercepted. | Reach a given range by clicks only; by keyboard only; by drag; page scrolls normally with the pointer over an unfocused chart | D7, R12, WCAG 2.5.1, 2.1.1 |\n| I4 | Every interaction works with a single pointer without dragging, and by touch. Every control is at least 24×24 CSS px. A one-finger drag on a chart scrolls the page (on a compact chart too: it takes no pointer input at all, C1). | Touch emulation; size checks | WCAG 2.5.7, 2.5.8, 2.5.1, 2.5.3, 4.1.2, 2.1.1 |\n| I5 | First render is not animated. An update may transition for at most 200 ms. Under `prefers-reduced-motion: reduce` nothing transitions, on first render or on update. | After `document.fonts.ready`: first frame equals the frame at 2.5 s within a 0.1% pixel tolerance, in both settings; an update under reduced motion reaches its final frame in one step; a 24-chart filter change settles within 200 ms | R14 |\n| I6 | A chart fed by `append` shows a Pause/Resume control. While paused, new rows are buffered and the view does not move. | Stream test | WCAG 2.2.2 |\n\n### 3.4 Accessibility\n\nTarget: every WCAG 2.2 level AA success criterion that applies to what Axylo renders, as component-level evidence. Conformance of a page is a property of the page and remains the author's.\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| A1 | Every chart has an accessible name: its `title`, or the heading named by `labelledBy`, or else a generated name (\"Line chart of Sessions by Day\") with AX140 raised in every build. The title's heading level is the author's (`level`), and it can be hidden visually. Every chart has a generated summary: type, series, x range with time zone, y range, each series' minimum, maximum and last value, and any omissions. `description` adds to the summary and never removes the zone or omission statements. Element ids are unique per chart. | Accessibility-tree snapshot for every fixture; a 24-chart page has no duplicate ids; axe `heading-order` | R11, R13, WCAG 1.1.1, 1.3.1, 2.4.6 |\n| A2 | Keyboard: at most two tab stops while the table is closed, the plot and one toolbar with roving focus that holds legend toggles, zoom, pause and the table control. Every point is reachable in order; the series can be switched; the ends can be reached directly; focus can leave the chart. The focus indicator is at least 2 px and 3:1 and is not hidden by the tooltip. The exact keys and roles are fixed after the pattern spike in M1 (section 8). | Forward and reverse traversal in collapsed, zoomed, streaming and table-open states; focus after hiding the focused series; indicator contrast | R12, WCAG 2.1.1, 2.1.2, 2.4.3, 2.4.7, 2.4.11, 1.4.11 |\n| A3 | Moving focus to a point conveys its text (series, x, value with unit, position) through the focused element's value text: the plot is a native range control whose `aria-valuetext` describes the focused point (decision 0001; earlier drafts said \"accessible name or a polite live region\", which the chosen pattern does not use, and A7 forbids announcements for navigation other than this). On touch screen readers, every point is reachable by swiping, or the table is reachable within two gestures. | Accessibility-tree snapshot after each key. No screen-reader rehearsal is part of 1.0 (the owner's decision, 2026-11-18): what a reader actually speaks on NVDA, VoiceOver or TalkBack has not been checked, and the conformance table says so. The script for such a rehearsal is kept in decision 0001 for when one is done. | R12, R13, WCAG 4.1.2 |\n| A4 | \"View as table\" shows the data as an HTML table built from the normalized data when opened: the title as caption, field labels with units as column headers, x values as row headers, values formatted as in F6. It covers the current x range, 100 rows per page, with every row reachable by paging or by jumping to an x value. It sits in a focusable scroll region no taller than the plot, and opening it does not move other charts. | Table content compared with fixture data, including a value near row 900,000 of 1,000,000; a 24-chart page layout test | R13, WCAG 1.3.1, 1.3.2, 3.3.1 |\n| A5 | Series are never distinguished by color alone, in any mode. Each line and area carries a shape marker at its last point and at sparse intervals, repeated in the legend and tooltip; under `prefers-contrast: more` or forced colors, lines also differ by dash. Adjacent filled marks (slices, stacked segments) are separated by at least 1 px of background. Bars are told apart by position and order, and by the legend and tooltip that name them; a compact chart has neither, so there neighbouring bar series also differ by fill pattern (series further apart may share a pattern: four patterns exist). The default palette has eight colors, each at least 3:1 on the default light and dark backgrounds, with a minimum pairwise OKLab difference of 0.10 (provisional) under normal vision and simulated protanopia, deuteranopia and tritanopia. On any other background, Axylo measures the palette against the resolved background and raises AX141 below 3:1. | Palette script scoring the rendered marks of an eight-series chart in both schemes, repeats included; rendered-pixel checks of separators; a grayscale screenshot in which three crossing lines can be told apart by marker | R7, WCAG 1.4.1, 1.4.11 |\n| A6 | Content reflows at 320 CSS px and 400% zoom without two-dimensional scrolling. User text-spacing overrides do not clip text. | Viewport and style-override tests in three engines | WCAG 1.4.10, 1.4.12 |\n| A7 | Data arriving does not speak. Announcements happen only for the reader's own navigation, and for a change of state (L7). While data streams, keyboard focus stays on the same datum until it leaves the window. | Stream test counting live-region changes with and without focus; 24 concurrent streams | R12 |\n| A8 | axe-core reports no violations on any fixture in any state, including `heading-order` and `scrollable-region-focusable`. | CI | R11 |\n| A9 | A conformance table lists every applicable WCAG 2.2 AA success criterion, the test that covers it, and what the author must supply (a meaningful title or `labelledBy`, series names, units, the page's own structure). It also states the limits in section 3.8. The criteria are the ones cited as \"WCAG x.y.z\" in the last column of this document's criterion rows; a criterion of WCAG 2.2 A or AA that no row cites is listed in the table as not covered by a test, with a word on why: not applicable to a chart component, the page's responsibility, or not assessed (it can apply to a chart, and no test is cited for it; the table claims nothing about it). | Published with each release; a CI check that every listed test exists | R11 |\n| A10 | Every built-in string can be replaced through `messages`. Built-in English text is marked `lang=\"en\"` when the document language is not English. | Test on a `lang=\"de\"` page | WCAG 3.1.2 |\n\n### 3.6 Type matrix\n\n| | Line | Area | Bar | Donut | Scatter |\n|---|---|---|---|---|---|\n| Picking by pointer | Nearest x | Nearest x | The band under the pointer | The slice under the pointer | Nearest point within 24 px; ties go to the later row |\n| Tooltip content | Every visible series at that x | Same, plus the stack total | Every series in that category | Label, value, percentage | The point's series, x and y; coincident points listed, up to eight |\n| Keyboard order | By x, then series | By x, then series | By category, then series | By slice order | By x, then y |\n| Zoom | On time, date and numeric x only | On time, date and numeric x only | On time, date and numeric x only | No | Yes, both axes later; x only in 1.0 |\n| Simplified drawing when dense | F5 | F5 on cumulative sums | No; more bars than pixels raises a hint | No | No in 1.0; above 50,000 points a hint says drawing may be slow |\n| Limit that raises a diagnostic | Eight series | Eight series | Eight series | Eight slices | Eight series |\n| Reference lines and bands | Yes; included in the domain; listed in the summary and table caption | Yes | Yes | No | Yes |\n\n### 3.7 Compact variant\n# Decision 0001: how the plot is exposed to keyboards and screen readers\n\nStatus: working choice, **not rehearsed with any screen reader**. The plan (M1) called for three candidate patterns to be rehearsed on five screen-reader and browser pairs before choosing. No screen reader can be run in the environment this was built in, so the choice below was made by reasoning and by inspecting Chrome's accessibility tree, and it must be rehearsed by the owner before it is relied on. If rehearsal contradicts it, the plot's roles are internal and can change without touching the public API.\n\n## Candidates\n\n| Pattern | For | Against |\n|---|---|---|\n| A. `role=\"application\"` on the plot, arrow keys handled in script, point text sent to a live region | Used by Recharts and ApexCharts. Full control of keys. | Screen-reader authors discourage `application`; a live region is a second, slower channel; touch screen readers have no arrow keys, so points cannot be reached by swiping. |\n| B. A roving focusable proxy element per point (or one moved around), each with its own label | Each point is a real element with a name. | One element per point does not scale to 100,000 points; a single moved proxy re-announces its role on every move in some readers (from memory, not verified). |\n| C. One native `<input type=\"range\">` laid over the plot, its value the position along x, its `aria-valuetext` the point's text | A native control: desktop readers enter focus mode on it by themselves, arrow keys, Home, End and Page keys work without script, and a change of value text is read without a live region. Touch screen readers expose a native range as an adjustable element, so swiping up and down moves through points (from memory for VoiceOver on iOS and TalkBack; not verified here). One element whatever the number of points. | It is announced as a slider, which is not what a chart is; mitigated by `aria-roledescription` and a label that says what moving it does. Up and Down natively do the same as Right and Left. |\n\n## Choice: C\n\nOne visually transparent native range input covers the plot. It is the plot's single tab stop.\n\n- **Value**: the ordinal of the current x among the visible x positions (for scatter: among visible points in x then y order; for donut: slice order), from `Lookup.ordinal` and `Lookup.count`.\n- **Value text**: by default everything at that x, like the pointer tooltip: the x, then each visible series with its value, then \"point 4 of 120\". After the reader narrows to one series (Up or Down on a keyboard), only that series is read. Escape returns to all series.\n- **Keys**: Left and Right move along x (native). Home, End, Page Up and Page Down native. Up and Down are intercepted to change the series in focus. `+`, `-`, `0` and Shift+arrows zoom and pan. Enter or Space selects (fires `select`). Escape: closes the tooltip first, then leaves single-series mode; otherwise it is not consumed, so a chart inside a dialog does not swallow it.\n- **Touch screen readers**: swiping up or down on the adjustable element moves along x and reads every series at that x; the table is one control away in the toolbar.\n- **Everything else** (legend toggles, zoom buttons, pause, table) is ordinary buttons in one toolbar with roving focus: the chart's second and last tab stop while the table is closed.\n\n## What has to be checked by rehearsal\n\n1. NVDA with Chrome and with Firefox: focus mode is entered on the range without a keystroke; each arrow press reads the new value text once; Up and Down are passed through and the series change is read.\n2. VoiceOver with Safari on macOS: the same, and the role description is read sensibly.\n3. VoiceOver on iOS and TalkBack with Chrome: the element is reachable by touch exploration at the plot's position; swipe up and down move by one point and read it; the toolbar and table are reachable by swiping right.\n4. That a long value text (eight series) is not cut off, and that streaming data does not make the reader speak unless the reader moves.\n## 2. The focused point's text changes only for a reason the reader would name\n\n**Problem.** The plot's keyboard proxy is a native range whose value text describes the focused point, ending with its position (\"Point 4 of 120\"). While data streams in, the count changes on every append, so the text of a focused control changes without the reader acting. Spec A7 forbids unrequested announcements; whether a given screen reader speaks such a change cannot be tested here.\n\n**Rule.** The range's bounds and numeric value are always kept true to the displayed frame, silently. Its value text is rewritten only when:\n\n1. the reader moves (a key, an assistive adjustment, a pointer or touch selection that takes focus),\n2. the focused datum's own values change (the same x and series now read differently),\n3. the focused datum leaves the frame (the text must then say where focus went), or\n4. the plot regains focus.\n\nAn append that only changes the count or the ordinal of an unchanged datum does not rewrite the text. The position in the text can therefore be out of date until the next of the four events; it is recomputed then.\n\nTo check with a screen reader when one is available (added to decision 0001's list): idle appends with the plot focused are silent; an eviction of the focused point is spoken once; an increment immediately after an append lands on the expected neighbour and reads the current count.\n\n## Data, color and a discrepancy with the spec\n\n- **Bad input.** Axylo’s combined fixture drew Mon–Tue and the isolated Sunday point. It named field `value` and zero-based rows 3, 4 and 5 for `NaN` (AX103), `'40'` (AX106) and `undefined` (AX102), with a fix for each. The figure and accessibility tree both said “Values not shown: 3. See table.” Each individual bad value left a gap with valid data on both sides. Explicit `null` left a silent gap. This matches F2, F3 and F12. Nine peers plotted `'40'` as 40; Highcharts silently omitted it. None gave a field-and-row diagnosis. [Dirty comparison](../research/harness/shots/_sheet-dirty.png) · [Single-string capture](../research/harness/shots/one-string-axylo.png) · [`dirty.logs`, `dirty.aria` and `sentinels`](../research/harness/results.json)\n- **Dates and instants.** Axylo showed the calendar date **Feb 22, 2026** in UTC, Los Angeles and Kolkata, matching seven peers on preserving the day. Given the instant, it displayed **Feb 22, 12:00 AM UTC**, **Feb 21, 4:00 PM PST** and **Feb 22, 5:30 AM GMT+5:30** for the same values. This confirms those two cases of F4. The production probe did not collect the development hint AX111. For Recharts, the table printer mistakes three missing extracted headings for a same-day result. Its screenshot shows the author-formatted local date, as Phase 1 reported. [`dates.*.readoutTitle`](../research/harness/results.json) · [Axylo instant in Los Angeles](../research/harness/shots/instant-la-axylo.png) · [Recharts instant in Los Angeles](../research/harness/shots/instant-la-recharts.png) · [Table printer](../research/tables.mjs)\n- **Palette and page theme.** Axylo’s six donut fills were distinct. Their lowest contrast on white was 3.10:1, the minimum of `contrastOnWhite`. Closest-pair OKLab distances were 0.1185 for normal vision, 0.1063 for protanopia, 0.1022 for deuteranopia and 0.1024 for tritanopia. Only Axylo cleared both 3:1 and the spec’s provisional 0.10 separation in every simulation on this fixture. ApexCharts cleared contrast but repeated blue. Plotly scored better for normal-vision separation at 0.1418. This tests six light-background colors of A5’s eight-color, two-scheme claim. On the separate trend task Axylo changed its marks and text on a dark page and stayed light on a light-only page under a dark device setting. Highcharts stayed dark in the latter case. [Palette scores](../research/harness/palette.json) · [Dark page](../research/harness/shots/_sheet-dark.png) · [Light-only page](../research/harness/shots/_sheet-lightonly.png)\n- **Incorrect keyboard help.** Axylo’s donut and categorical bar both told readers “Plus and minus zoom; 0 resets.” The spec excludes zoom for both configurations, and their recorded toolbars offered only “View as table.” The discrepancy is in the instructions exposed to readers. The probe did not press the zoom keys on either chart. [`axylo.parts.aria` and `axylo.bars.aria`](../research/harness/results.json) · [Spec I3 and type matrix](02-product-spec.md#36-type-matrix)\n\n## What authors supplied and what shipped\n5:This plan builds the product defined in [02-product-spec.md](02-product-spec.md). Criterion IDs (F1, L1, A2, DX4, P1 …) refer to that spec; finding IDs (R5, D2 …) refer to [01-landscape.md](01-landscape.md).\n102:| `messages`, `locale` | Built-in text and formatting locale (A10, F6). |\n208:**Working assumption: Canvas 2D for marks, HTML for all text.** Text stays in the DOM so that it inherits the page font and color, honors user text spacing and zoom (A6), adapts in forced-colors mode, and can be selected and translated.\n281:- Two written decision records, each with its measurements: the renderer, and the plot's interaction pattern. Each says what was observed and what was inferred.\n313:- The pattern chosen in M1, built fully: names and summary (A1), keyboard (A2), point text (A3), table with paging (A4), non-color cues (A5), reflow (A6), streaming behavior (A7), messages and language (A10); single-pointer zoom controls (I3, I4); reduced motion on update (I5).\n392:| The interaction pattern that works in one screen reader fails in another. | Three candidates rehearsed on five pairs in M1, before any of the surrounding DOM is built. Plot roles are internal and can change in a minor release. |\n393:| DOM text costs too much with many charts on a page. | P5 is measured in M1. A fallback to canvas-drawn tick labels would give up user text spacing and forced-colors adaptation for those labels, so it must pass the same L1 and A6 tests before it is allowed. |\n416:| Translations of built-in messages | `messages` makes them possible in 1.0; only English ships. |\n","exit_code":0,"status":"completed"}}
