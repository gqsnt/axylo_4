{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"rg -n 'plotInstructions|instructions|zoomEnabled|canZoom|Arrow(Up|Down|Left|Right)|frame\\\\.series|syncProxy|function (draw|update)' packages/axylo/src/dom/interaction.ts && rg -n '\"'^#{1,6} |interaction|messages'\"' docs/03-plan-typescript-release.md\"","aggregated_output":"36:  overlayWith, OUTLINE_REACH, RING_REACH, RING_STROKE, alignedRows, canZoomIn, datumReading, minimumWidth, panWindow,\n202:  ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1, Home: 'first', End: 'last',\n294:  ArrowRight: 'next', ArrowLeft: 'previous', Home: 'first', End: 'last', PageUp: 'page-next', PageDown: 'page-previous',\n476:  let instructions: HTMLElement | null = null;\n519:    instructions = make(doc, 'span', 'axylo-visually-hidden');\n520:    instructions.id = `${figure.id}-i`;\n524:    plot.append(proxy, ring, selection, instructions);\n594:    instructions?.remove();\n595:    instructions = null;\n1047:      else if (event.shiftKey && (key === 'ArrowLeft' || key === 'ArrowRight')) { consume(); pan(key === 'ArrowRight' ? PAN_SHARE : -PAN_SHARE); }\n1048:      else if (key in NAVIGATION || key === 'ArrowUp' || key === 'ArrowDown') event.preventDefault();\n1056:    if (event.shiftKey && (key === 'ArrowLeft' || key === 'ArrowRight')) {\n1058:      if (d.zoom) pan(key === 'ArrowRight' ? PAN_SHARE : -PAN_SHARE);\n1063:      if (key in NAVIGATION || key === 'ArrowUp' || key === 'ArrowDown' || key === 'Enter' || key === ' ') event.preventDefault();\n1066:    if ((key === 'ArrowUp' || key === 'ArrowDown') && d.view.kind !== 'donut') {\n1068:      moveSeries(key === 'ArrowDown' ? 1 : -1);\n1090:    const direction = NAVIGATION[key] ?? (d.view.kind === 'donut' ? ({ ArrowUp: 'next', ArrowDown: 'previous' } as Record<string, StepDirection>)[key] : undefined);\n1316:  function drawSelection(from: Point, to: Point): void {\n1731:    const series = view.frame.series;\n1755:      if (d.ready) items.push(button('zoomIn', () => zoomBy(1 / ZOOM_FACTOR), !canZoomIn(d.view, window)));\n1866:    // How to move in the plot, as its description (the plotInstructions message).\n1867:    if (instructions) {\n1868:      if (instructions.textContent !== d.messages.plotInstructions) instructions.textContent = d.messages.plotInstructions;\n1869:      setAttr(instructions, 'lang', d.english('plotInstructions') ?? (proxyLang ? d.pageLang : null));\n1870:      setAttr(proxy, 'aria-describedby', instructions.id);\n1:# Phase 2 plan: Axylo 1.0 in TypeScript\n9:## 1. Public API\n13:### 1.1 Shape\n38:### 1.2 Data: one logical table, three forms\n63:### 1.3 Fields\n90:### 1.4 Common options\n102:| `messages`, `locale` | Built-in text and formatting locale (A10, F6). |\n107:### 1.5 Handle and commit contract\n130:### 1.6 Diagnostics\n149:### 1.7 React adapter (not in 1.0)\n169:## 2. Architecture\n171:### 2.1 Pipeline\n192:### 2.2 Invalidation\n206:### 2.3 Rendering\n218:### 2.4 Document structure\n241:### 2.5 Repository\n257:## 3. Milestones\n261:### M0. Foundations (ceiling: 5 days)\n270:### M1. A vertical slice, and the two open decisions (ceiling: 12 days)\n281:- Two written decision records, each with its measurements: the renderer, and the plot's interaction pattern. Each says what was observed and what was inferred.\n286:### M2. Faithful data, on the line chart (ceiling: 8 days)\n298:### M3. Reading the chart (ceiling: 10 days)\n311:### M4. Accessibility, complete on the line chart (ceiling: 10 days)\n313:- The pattern chosen in M1, built fully: names and summary (A1), keyboard (A2), point text (A3), table with paging (A4), non-color cues (A5), reflow (A6), streaming behavior (A7), messages and language (A10); single-pointer zoom controls (I3, I4); reduced motion on update (I5).\n324:### M5. Bar, area, donut, scatter and the compact variant (ceiling: 18 days)\n338:### M6. Updates and scale (ceiling: 10 days)\n350:### M7. Distribution and documentation (ceiling: 8 days)\n361:### M8. Release (ceiling: 10 days)\n372:## 4. Test strategy\n388:## 5. Risks\n392:| The interaction pattern that works in one screen reader fails in another. | Three candidates rehearsed on five pairs in M1, before any of the surrounding DOM is built. Plot roles are internal and can change in a minor release. |\n400:## 6. What waits until after 1.0\n416:| Translations of built-in messages | `messages` makes them possible in 1.0; only English ships. |\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '175,225p' packages/axylo/src/public.ts && sed -n '1,200p' packages/axylo/src/messages/index.ts && cat packages/axylo/test/messages/index.test.ts\"","aggregated_output":"  message: string;\n  /** The chart it came from: its title, else its element id. */\n  chart: string;\n  /** Where applicable. A diagnostic about the chart as a whole (no title, low contrast) has neither. */\n  field?: string;\n  /** First offending row indexes in the caller's own data, capped at 10. */\n  rows?: readonly number[];\n  count?: number;\n}\n\n/** Runs normalization and validation only. Works without a DOM, so a server or an agent can check options before rendering. */\n\n/** Built-in text. Templates use {name} placeholders. Every entry can be replaced through `messages` (spec A10). */\nexport interface Messages {\n  viewAsTable: string; hideTable: string;\n  noData: string; noObservation: string; incompleteStack: string;\n  moreRows: string; otherSlices: string;\n  valuesNotShown: string; valuesChanged: string; labelsHidden: string;\n  loading: string; empty: string; error: string; internalError: string;\n  chartName: string; chartSummary: string; seriesSummary: string; timeZoneNote: string;\n  plotLabel: string; controlsLabel: string; pointOf: string;\n  zoomIn: string; zoomOut: string; resetZoom: string; pause: string; resume: string;\n  previousPage: string; nextPage: string; pageOf: string; jumpToX: string;\n  /** Column headers and nouns. */\n  category: string; percentage: string; series: string; value: string;\n  /** Chart type names used in generated names and summaries. */\n  typeLine: string; typeArea: string; typeBar: string; typeScatter: string; typeDonut: string;\n  /** Summary sentences that have no cartesian form. */\n  donutSummary: string; seriesNoData: string; seriesNotDrawn: string; referenceLine: string; referenceBand: string;\n  /** What the keyboard proxy says it is (\"{type} chart\") and how it reads a position. */\n  plotRole: string; pointAll: string; seriesValue: string; position: string;\n  /** Label of the stack total in tooltips. */\n  total: string;\n  /** Single-click panning (WCAG 2.5.7), the table's \"Jump to\" when nothing matches, and how to move in the plot. */\n  panLeft: string; panRight: string; jumpNotFound: string; plotInstructions: string;\n  /** Toolbar toggle: while it is on, two clicks in the plot set the two ends of the zoom range (the non-dragging way to select a range, WCAG 2.5.7). */\n  selectRange: string;\n  /** A stack whose components have mixed signs: both ends, in place of one total ('{positive} and {negative}'). */\n  totalMixed: string;\n  /** Incomplete stacks in a summary: named when few ('{label}: incomplete at {positions}.'), counted when many ('{label}: {count} incomplete stacks.'). */\n  incompleteAt: string; incompleteCount: string;\n  /** Fills `{seeTable}` in `valuesNotShown`, `valuesChanged`, `labelsHidden` and `seriesNotDrawn` when the chart has a table; without one the placeholder is removed. An override without the placeholder is used as written. */\n  seeTable: string;\n}\nimport type { DatumRef, Formatters, Lookup } from '../core/contracts';\nimport type { Messages } from '../public';\n\nconst chartSummary = '{type} chart with {seriesCount} series. {xLabel} from {xMin} to {xMax}.';\n// chartSummary and the range, written out: no work at import time.\nconst fullChartSummary = '{type} chart with {seriesCount} series. {xLabel} from {xMin} to {xMax}. {yLabel} from {yMin} to {yMax}.';\nconst donutSlice = '{label}: {value} ({percent}).';\n\nexport const defaultMessages: Messages = {\n  viewAsTable: 'View as table',\n  hideTable: 'Hide table',\n  noData: 'No data',\n  noObservation: 'No observation',\n  incompleteStack: 'incomplete',\n  moreRows: '+{count} more',\n  otherSlices: 'Other ({count})',\n  valuesNotShown: 'Values not shown: {count}. {seeTable}',\n  valuesChanged: 'Values shown differently from the data: {count}. {seeTable}',\n  labelsHidden: 'Some labels hidden. {seeTable}',\n  loading: 'Loading chart.',\n  empty: 'No data to show.',\n  error: 'The chart could not be drawn.',\n  internalError: 'Something went wrong while drawing the chart.',\n  chartName: '{type} chart of {y} by {x}',\n  chartSummary: fullChartSummary,\n  seriesSummary: '{series}: minimum {min}, maximum {max}, last {last}.',\n  timeZoneNote: 'Times are shown in {zone}.',\n  plotLabel: 'Chart plot',\n  controlsLabel: 'Chart controls',\n  pointOf: '{series}, {x}, {value}. Point {index} of {count}.',\n  zoomIn: 'Zoom in',\n  zoomOut: 'Zoom out',\n  resetZoom: 'Reset zoom',\n  pause: 'Pause',\n  resume: 'Resume',\n  previousPage: 'Previous page',\n  nextPage: 'Next page',\n  pageOf: 'Page {page} of {count}',\n  jumpToX: 'Jump to {x}',\n  category: 'Category',\n  percentage: 'Percentage',\n  series: 'Series',\n  value: 'Value',\n  typeLine: 'Line',\n  typeArea: 'Area',\n  typeBar: 'Bar',\n  typeScatter: 'Scatter',\n  typeDonut: 'Donut',\n  donutSummary: '{type} chart with {count} slices. Total {total}.',\n  seriesNoData: '{series}: no data.',\n  seriesNotDrawn: '{series} could not be drawn. {seeTable}',\n  referenceLine: 'Reference line {label} at {from}.',\n  referenceBand: 'Reference band {label} from {from} to {to}.',\n  plotRole: '{type} chart',\n  pointAll: '{x}. {values}. {position}',\n  seriesValue: '{series} {value}',\n  position: 'Point {index} of {count}',\n  total: 'Total',\n  panLeft: 'Pan left',\n  panRight: 'Pan right',\n  jumpNotFound: 'No row matches {x}. Example: {example}',\n  plotInstructions: 'Left and right arrows move between points, up and down between series, and Enter selects. Plus and minus zoom; 0 resets.',\n  selectRange: 'Select range',\n  seeTable: 'See table.',\n  totalMixed: '{positive} and {negative}',\n  incompleteAt: '{label}: incomplete at {positions}.',\n  incompleteCount: '{label}: {count} incomplete stacks.',\n};\n\nexport function fill(template: string, values: Readonly<Record<string, string | number>>): string {\n  return template.replace(/\\{(\\w+)\\}/g, (placeholder: string, name: string) =>\n    Object.hasOwn(values, name) ? String(values[name]) : placeholder,\n  );\n}\n\nconst authoredMessages = new WeakMap<Messages, ReadonlySet<keyof Messages>>();\n\nexport function resolveMessages(overrides?: Partial<Messages> | null): Messages {\n  const messages = { ...defaultMessages };\n  const authored = new Set<keyof Messages>();\n  for (const key of Object.keys(messages) as (keyof Messages)[]) {\n    const value = overrides?.[key];\n    if (value == null) continue;\n    messages[key] = value;\n    authored.add(key);\n  }\n  authoredMessages.set(messages, authored);\n  return messages;\n}\n\nexport function messageLanguage(messages: Messages, key: keyof Messages): 'en' | null {\n  return messages[key] === defaultMessages[key] && !authoredMessages.get(messages)?.has(key) ? 'en' : null;\n}\n\nexport function fillChartSummary(\n  template: string, values: Readonly<Record<string, string>>, range: { readonly yMin: string; readonly yMax: string } | null,\n): string {\n  if (range) return fill(template, { ...values, ...range });\n  // When a translation uses the same placeholders, omit the sentence that would describe the missing range.\n  const withoutRange = template === fullChartSummary ? chartSummary\n    : template.match(/[^.!?。！？]+[.!?。！？]*|[.!?。！？]+/gu)?.filter(part => !/\\{y(?:Min|Max)\\}/.test(part)).join('').trim();\n  return fill(withoutRange || chartSummary, values);\n}\n\nexport function fillDonutSlice(label: string, value: string, percent: string): string {\n  return fill(donutSlice, { label, value, percent });\n}\n\nexport function pointOf(lookup: Lookup, ref: DatumRef, formatters: Formatters, messages: Messages): string | null {\n  const ordinal = lookup.ordinal(ref);\n  if (ordinal < 0) return null;\n  const datum = lookup.datum(ref);\n  if (!datum) return null;\n  return fill(messages.pointOf, {\n    series: datum.seriesLabel, x: datum.x, value: datum.value,\n    index: formatters.count(ordinal + 1), count: formatters.count(lookup.count),\n  });\n}\nimport { expect, it } from 'vitest';\nimport type { Messages } from '../../src/public';\nimport { defaultMessages, fill, resolveMessages } from '../../src/messages';\n\nit('gives every public message a non-empty default', () => {\n  const keys: Record<keyof Messages, true> = {\n    viewAsTable: true, hideTable: true, noData: true, noObservation: true, incompleteStack: true,\n    moreRows: true, otherSlices: true, valuesNotShown: true, valuesChanged: true, labelsHidden: true,\n    loading: true, empty: true, error: true, internalError: true,\n    chartName: true, chartSummary: true, seriesSummary: true, timeZoneNote: true,\n    plotLabel: true, controlsLabel: true, pointOf: true,\n    zoomIn: true, zoomOut: true, resetZoom: true, pause: true, resume: true,\n    category: true, percentage: true, series: true, value: true,\n    typeLine: true, typeArea: true, typeBar: true, typeScatter: true, typeDonut: true,\n    plotRole: true, pointAll: true, seriesValue: true, position: true, total: true,\n    panLeft: true, panRight: true, jumpNotFound: true, plotInstructions: true, selectRange: true, seeTable: true, totalMixed: true, incompleteAt: true, incompleteCount: true,\n    donutSummary: true, seriesNoData: true, seriesNotDrawn: true, referenceLine: true, referenceBand: true,\n    previousPage: true, nextPage: true, pageOf: true, jumpToX: true,\n  };\n  expect(Object.keys(defaultMessages).sort()).toEqual(Object.keys(keys).sort());\n  for (const text of Object.values(defaultMessages)) expect(text.trim()).not.toBe('');\n});\n\nit('fills templates once, preserving unknown names and literal braces and dollar signs in values', () => {\n  expect(fill('{series} at {index} ({series}) {missing} {toString}', { series: '{index} $&', index: 2 }))\n    .toBe('{index} $& at 2 ({index} $&) {missing} {toString}');\n});\n\nit('includes the table guidance placeholder in all four default templates', () => {\n  expect(defaultMessages).toMatchObject({\n    valuesNotShown: 'Values not shown: {count}. {seeTable}',\n    valuesChanged: 'Values shown differently from the data: {count}. {seeTable}',\n    labelsHidden: 'Some labels hidden. {seeTable}',\n    seriesNotDrawn: '{series} could not be drawn. {seeTable}',\n    seeTable: 'See table.',\n  });\n});\n\nit('replaces individual messages without changing defaults or copying undefined', () => {\n  const messages = resolveMessages({ noData: 'Keine Daten', loading: undefined });\n  expect(messages).toEqual({ ...defaultMessages, noData: 'Keine Daten' });\n  expect(defaultMessages.noData).toBe('No data');\n  expect(fill(messages.moreRows, { count: 3 })).toBe('+3 more');\n});\n","exit_code":0,"status":"completed"}}
