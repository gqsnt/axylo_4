next);\n    if (!plotReady(next)) {\n      if (shown.kind !== 'keyboard') shown = pointer ? NO_HOVER : idle();\n      pinPage = 0;\n      return;\n    }\n    switch (shown.kind) {\n      case 'pinned': {\n        const kept = presentation === 'none' ? null : stillPinned(next, shown.ref, shown.target);\n        if (kept) shown = { kind: 'pinned', ref: kept.ref, target: kept.target };\n        else {\n          endPin();\n          // endPin picked with the old frame's lookup; the new frame's is the one on screen.\n          const after = shown as Shown;\n          if (after.kind === 'hover' && pointer) pointTo(pick(next, pointer));\n        }\n        break;\n      }\n      case 'held': {\n        // The hold belongs to one datum, one geometry and one presentation (rule 3b).\n        const anchor = anchorOf(next, shown.target);\n        if (presentation !== shown.presentation || !sameRect(anchor, shown.anchor) || !next.lookup.tooltip(shown.target).rows.length) {\n          rest = null;\n        const signature = JSON.stringify([item.label, item.swatch, item.struck, item.symbol]);\n        if (signature !== entry.signature) {\n          fill(button, item);\n          entry.signature = signature;\n        }\n        if (button.className !== item.className) button.className = item.className;\n        button.classList.toggle('axylo-struck', item.struck === true);\n        setAttr(button, 'aria-pressed', item.pressed === undefined ? null : String(item.pressed));\n        setAttr(button, 'aria-expanded', item.expanded === undefined ? null : String(item.expanded));\n        setAttr(button, 'aria-controls', item.expanded ? item.controls ?? null : null);\n        setAttr(button, 'lang', item.lang);\n        setAttr(button, 'aria-disabled', item.disabled ? 'true' : null);\n        const place: ChildNode | null = previous ? previous.nextSibling : element.firstChild;\n        if (place !== button) element.insertBefore(button, place);\n        previous = button;\n      }\n      order = keys;\n      const keep = heir ?? (current !== null && keys.includes(current) ? current : keys[0] ?? null);\n      setCurrent(keep);\n      if (heir !== null) buttons.get(heir)!.button.focus();\n      // A reorder moves the focused button, which can drop focus: it is given back (review 2, finding 17).\n      else if (focusedKey !== null && activeElementOf(doc) !== buttons.get(focusedKey)?.button) buttons.get(focusedKey)?.button.focus();\n    },\n    focus(key) {\n      const entry = buttons.get(key);\n      if (!entry) return false;\n      entry.button.focus();\n      return activeElementOf(doc) === entry.button;\n    },\n    destroy() {\n      listening.abort();\n      element.remove();\n      buttons.clear();\n    },\n  };\n}\n  const seek = (from: number, delta: 1 | -1, lo = start, hi = end): number => {\n    for (let i = from; i >= lo && i < hi; i += delta) if (occupied(view, series, i)) return i;\n    return -1;\n  };\n  let at = x === null ? -1 : lowerBound(positions, x, start, end);\n  if (at >= 0 && (at >= end || positions[at] !== x)) at = -1;\n  let to = -1;\n  if (at < 0) {\n    to = direction === 'last' ? seek(end - 1, -1) : seek(start, 1);\n  } else {\n    const page = pageDistance(end - start);\n    switch (direction) {\n      case 'next': to = seek(at + 1, 1); break;\n      case 'previous': to = seek(at - 1, -1); break;\n      case 'first': to = seek(start, 1); break;\n      case 'last': to = seek(end - 1, -1); break;\n      case 'page-next': {\n        const target = Math.min(end - 1, at + page);\n        to = seek(target, 1);\n        if (to < 0) to = seek(target - 1, -1, at + 1);\n        break;\n      }\n      case 'page-previous': {\n        const target = Math.max(start, at - page);\n        to = seek(target, -1);\n        if (to < 0) to = seek(target + 1, 1, start, at);\n        break;\n      }\n      default: return null;\n    }\n    if (to === at) return null;\n  }\n  return to < 0 ? null : positions[to]!;\n}\n\n/** The refs of every readable series at x, in series order. */\nimport { defineConfig } from 'vitest/config';\n\n// Unit and property tests run in Node. Browser tests (*.browser.test.ts) drive system Chrome through\n// Playwright against the built bundle: run `npm run build` first, then `npm run test:browser`.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    include: process.env.AXYLO_BROWSER\n      ? ['packages/*/test/**/*.browser.test.ts', 'apps/docs/test/**/*.browser.test.ts']\n      : ['packages/*/test/**/*.test.ts', 'apps/docs/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    // Forked processes with --expose-gc: the store's tests force a collection to check that dropped rows are\n    // released, and fail loudly when they cannot.\n    pool: 'forks',\n    execArgv: ['--expose-gc'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 10000,\n    fileParallelism: !process.env.AXYLO_BROWSER,\n  },\n});\n","exit_code":0,"status":"completed"}}
