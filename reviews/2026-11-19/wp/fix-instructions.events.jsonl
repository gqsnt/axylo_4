{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,75p' packages/axylo/test/browser/chart/review2.browser.test.ts && sed -n '1,50p' packages/axylo/test/browser/acceptance/util.ts && cat packages/axylo/src/dom/toolbar.ts | head -155 && rg -n 'id=\\\"|ax[Oo]f' packages/axylo/test/browser/chart -g '*.ts' | head -25\"","aggregated_output":"/**\n * The findings of the interaction and accessibility review (reviews/2026-11-18/impl/wp/core2.review.md), in\n * real Chrome against the built bundle, plus the defects other agents reported against the first fix pass.\n * Accessibility outcomes are read from Chrome's own accessibility tree (CDP) where Chrome exposes them; Chrome\n * does not report `aria-valuetext` there (its \"valuetext\" property is the number), so value text is read\n * from the attribute the tree is built from and says so.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport type { Page } from 'playwright-core';\nimport { ENGINE, requireEngineFeature, start, stop } from '../harness';\nimport { chartPage, closePage } from './util';\n\nbeforeAll(start);\nafterAll(stop);\n\ninterface Ax { role: string; name: string; value: string; min: number | null; max: number | null; roledescription: string | null; focused: boolean }\n\n/** Chrome's accessibility node for the first element matching `selector`. */\nasync function ax(page: Page, selector: string): Promise<Ax> {\n  requireEngineFeature(['chromium'], 'the computed accessibility tree is read through the Chrome DevTools protocol');\n  const client = await page.context().newCDPSession(page);\n  try {\n    const { root } = await client.send('DOM.getDocument', { depth: 0 });\n    const { nodeId } = await client.send('DOM.querySelector', { nodeId: root.nodeId, selector });\n    const { node } = await client.send('DOM.describeNode', { nodeId });\n    const { nodes } = await client.send('Accessibility.getPartialAXTree', { backendNodeId: node.backendNodeId, fetchRelatives: false });\n    const n = nodes[0]!;\n    const prop = (name: string) => n.properties?.find(p => p.name === name)?.value?.value as unknown;\n    const num = (v: unknown) => typeof v === 'number' ? v : null;\n    return {\n      role: String(n.role?.value ?? ''), name: String(n.name?.value ?? ''), value: String(n.value?.value ?? ''),\n      min: num(prop('valuemin')), max: num(prop('valuemax')),\n      roledescription: prop('roledescription') === undefined ? null : String(prop('roledescription')), focused: prop('focused') === true,\n    };\n  } finally {\n    await client.detach();\n  }\n}\n\nconst valueText = (page: Page) => page.locator('#chart .axylo-proxy').getAttribute('aria-valuetext');\nconst settle = (page: Page) => page.evaluate(async () => { for (const c of window.charts) await c.__bench.ready(); await window.nextFrames(2); });\nconst focusedClass = (page: Page) => page.evaluate(() => (document.activeElement as HTMLElement | null)?.className ?? '');\nconst button = (page: Page, text: string) => page.locator('#chart button', { hasText: text });\n\nasync function create(page: Page, kind: string, options: Record<string, unknown>): Promise<void> {\n  await page.evaluate(async ({ kind, options }) => {\n    const chart = window.Axylo[kind]!('#chart', options);\n    window.charts.push(chart);\n    await chart.__bench.ready();\n    await window.nextFrames(1);\n  }, { kind, options });\n}\n\ndescribe('finding 1: paused charts validate every call at once and apply them in call order', () => {\n  it('rows appended while paused do not come back after update({ data }); resume shows the replacement and what came after it', async () => {\n    const page = await chartPage();\n    await create(page, 'scatter', { title: 'P', data: [{ x: 1, y: 1 }], x: 'x', y: 'y' });\n    await page.evaluate(() => window.charts[0]!.append([{ x: 2, y: 2 }]));\n    await settle(page);\n    await button(page, 'Pause').click();\n    const result = await page.evaluate(async () => {\n      const chart = window.charts[0]!;\n      chart.append([{ x: 3, y: 3 }]);\n      chart.update({ data: [{ x: 10, y: 1 }, { x: 11, y: 2 }] });\n      chart.append([{ x: 12, y: 3 }]);\n      chart.zoom([10, 12]);\n      await chart.__bench.ready();\n      return chart.__bench.describe().series[0];\n    });\n    await button(page, 'Resume').click();\n    await settle(page);\n    const after = await page.evaluate(() => window.charts[0]!.__bench.describe().series[0]);\n    expect(result).toBeTruthy();\n    expect(after).toMatchObject({ points: 3, oldestX: 10, newestX: 12 });\n    expect(await closePage(page)).toEqual([]);\n/**\n * Shared setup for the browser acceptance suite. Pages come from the existing harness (development\n * bundle, `chartPage`) or from `prod.html` in this directory (the minified production bundle). Charts are\n * created through the public API with the hand-written fixtures in `fixtures.ts`; the accessibility tree is\n * read from Chrome itself through the DevTools protocol (roles, names, descriptions, states), never from the\n * attributes the code sets, except where a comment says Chrome cannot report the property.\n *\n * THIS SUITE IS EVIDENCE FOR THE SVG RENDERER ONLY. It locates marks by reading the SVG DOM (paths, rects,\n * their colour slots) before sampling their pixels, so it says nothing about the canvas renderer, and it\n * refuses to run when `AXYLO_RENDERER=canvas` is set rather than report SVG results under a canvas run.\n *\n * Every checker the suite leans on (separators, painted colour, text overlap, table comparison, the focused\n * range, tooltip occlusion, motion, reference marks, dense columns) has a negative control in\n * `negative-controls.browser.test.ts` that breaks the behaviour from the test side and requires the\n * checker to report it.\n */\nimport type { Locator, Page } from 'playwright-core';\nimport { ENGINE, openPage, requireEngineFeature, url } from '../harness';\n\nexport { ENGINE, requireEngineFeature };\n\n/** Why a test that reads Chrome's computed accessibility tree is not run on another engine. */\nexport const AX_TREE_REASON = \"the browser's own computed accessibility tree (roles, names, descriptions, states) is read through the Chrome DevTools protocol; Playwright offers no engine-neutral equivalent (its aria snapshot is its own computation and carries no descriptions)\";\nimport { chartPage, RENDERER } from '../chart/util';\n\nif (RENDERER === 'canvas') {\n  throw new Error('The browser acceptance suite reads the SVG DOM and is evidence for the SVG renderer only; it does not run with AXYLO_RENDERER=canvas.');\n}\nimport { decodePng, type Image } from '../render/png';\nimport { type ChartType, type Kind, optionsFor, optionsForKind, type Variant } from './fixtures';\n\nexport { closePage, at, diff, shot } from '../chart/util';\nexport type { Image };\n\n/** The two elements around every chart, so the tab order can be walked from and to the page. */\n/** Why a test that drives the screen with more than one touch point, or drags a finger, is not run off Chromium. */\nexport const TOUCH_INPUT_REASON = \"multi-point and moving touch input is dispatched through the Chrome DevTools protocol (Input.dispatchTouchEvent); Playwright's engine-neutral touchscreen only taps\";\nexport const SHOW_BUTTONS = '#before, #after { display: inline-block !important; }';\n\nexport interface Built {\n  diagnostics: { code: string; level: string; message: string }[];\n}\n\n/** Development bundle page (`window.Axylo` from dist/axylo.iife.js), with `#before`, `#chart`, `#after`. */\nexport async function devPage(options: Parameters<typeof chartPage>[0] = {}): Promise<Page> {\n  return chartPage({ ...options, css: `${SHOW_BUTTONS} ${options.css ?? ''}` });\n}\n\n/** Runs in the page: the same renderer switch chart/util.ts applies, for the production page. */\nfunction selectRenderer(renderer: string): void {\n/**\n * The chart's one toolbar (spec A2, I2, I3, I4, I6): legend toggles, zoom, pause and the table control, as\n * ordinary buttons with roving focus, so the whole toolbar is a single tab stop. Arrow keys move between\n * controls, Home and End jump to the ends.\n *\n * Buttons are kept by key and updated in place, so a control the reader is on keeps focus across commits.\n * When the control that has focus goes away (Reset after resetting, Pause before any append), focus moves to\n * its neighbour instead of falling back to the page.\n */\nimport { createSwatch, type SwatchSpec } from './swatch';\nimport { activeElementOf, setAttr, make, hideFromAT } from './attributes';\n\nexport interface ToolbarItem {\n  readonly key: string;\n  readonly label: string;\n  /** Toggle buttons (legend entries): aria-pressed. */\n  readonly pressed?: boolean;\n  /** Disclosure buttons (the table control): aria-expanded and, while expanded, aria-controls. */\n  readonly expanded?: boolean;\n  readonly controls?: string | null;\n  readonly swatch?: SwatchSpec;\n  /** A hidden series: struck-through name, outline swatch (never dimmed text, spec L2). */\n  readonly struck?: boolean;\n  /** `lang` of the button ('en' for built-in text on a page in another language), or null. */\n  readonly lang: string | null;\n  readonly className: string;\n  /**\n   * Drawn as a 24 × 24 symbol, named by `label` (also its `title`): a toggle added to a toolbar that must not\n   * gain a row for it (Select range).\n   */\n  readonly symbol?: 'range';\n  /** The control can do nothing now (Zoom in at the smallest window): aria-disabled, activation ignored. */\n  readonly disabled?: boolean;\n  activate(): void;\n}\n\nexport interface Toolbar {\n  readonly element: HTMLElement;\n  render(items: readonly ToolbarItem[], label: string, lang: string | null): void;\n  /** Moves focus to the control with this key; false when there is none. */\n  focus(key: string): boolean;\n  destroy(): void;\n}\n\nconst SVG = 'http://www.w3.org/2000/svg';\n\nexport function createToolbar(doc: Document): Toolbar {\n  const element = make(doc, 'div', 'axylo-toolbar');\n  element.setAttribute('role', 'toolbar');\n  // Every listener of the toolbar and its buttons goes with destroy (review 2: none left on removed elements).\n  const listening = new AbortController();\n  const signal = listening.signal;\n  const buttons = new Map<string, { button: HTMLButtonElement; item: ToolbarItem; signature: string }>();\n  let current: string | null = null;\n  let order: string[] = [];\n\n  function setCurrent(key: string | null): void {\n    current = key;\n    for (const [k, { button }] of buttons) button.tabIndex = k === current ? 0 : -1;\n  }\n\n  function move(to: number): void {\n    if (!order.length) return;\n    const key = order[(to + order.length) % order.length]!;\n    setCurrent(key);\n    buttons.get(key)!.button.focus();\n  }\n\n  element.addEventListener('keydown', (event: KeyboardEvent) => {\n    if (event.altKey || event.ctrlKey || event.metaKey) return;\n    const at = current === null ? -1 : order.indexOf(current);\n    switch (event.key) {\n      case 'ArrowRight': case 'ArrowDown': move(at + 1); break;\n      case 'ArrowLeft': case 'ArrowUp': move(at - 1); break;\n      case 'Home': move(0); break;\n      case 'End': move(order.length - 1); break;\n      default: return;\n    }\n    event.preventDefault();\n  }, { signal });\n  element.addEventListener('focusin', (event: FocusEvent) => {\n    for (const [key, { button }] of buttons) if (button === event.target) setCurrent(key);\n  }, { signal });\n\n  function fill(button: HTMLButtonElement, item: ToolbarItem): void {\n    const children: Node[] = [];\n    if (item.swatch) children.push(createSwatch(doc, item.swatch));\n    if (item.symbol) children.push(rangeSymbol());\n    const text = doc.createElement('span');\n    // A symbol button keeps its text as its accessible name, visually hidden.\n    text.className = item.symbol ? 'axylo-control-label axylo-visually-hidden' : 'axylo-control-label';\n    text.textContent = item.label;\n    children.push(text);\n    button.replaceChildren(...children);\n    setAttr(button, 'title', item.symbol ? item.label : null);\n  }\n\n  /** Two bounds and a double arrow between them, in the text colour (so forced colours restyle it). */\n  function rangeSymbol(): SVGSVGElement {\n    const svg = doc.createElementNS(SVG, 'svg');\n    svg.setAttribute('viewBox', '0 0 16 16');\n    svg.setAttribute('width', '16');\n    svg.setAttribute('height', '16');\n    hideFromAT(svg);\n    svg.setAttribute('class', 'axylo-symbol');\n    const path = doc.createElementNS(SVG, 'path');\n    path.setAttribute('d', 'M2 2v12M14 2v12M4.5 8h7M4.5 8l2.5-2.5M4.5 8l2.5 2.5M11.5 8l-2.5-2.5M11.5 8l-2.5 2.5');\n    svg.append(path);\n    return svg;\n  }\n\n  return {\n    element,\n    render(items, label, lang) {\n      setAttr(element, 'aria-label', label);\n      setAttr(element, 'lang', lang);\n      const focused = activeElementOf(doc);\n      let focusedKey: string | null = null;\n      for (const [key, { button }] of buttons) if (button === focused) focusedKey = key;\n      const keys = items.map(i => i.key);\n      // Where a focused control that is going away hands focus: the control now at its place, or the last.\n      let heir: string | null = null;\n      if (focusedKey !== null && !keys.includes(focusedKey)) {\n        const was = order.indexOf(focusedKey);\n        const after = order.slice(was + 1).find(k => keys.includes(k));\n        const before = order.slice(0, was).reverse().find(k => keys.includes(k));\n        heir = after ?? before ?? keys[0] ?? null;\n      }\n      for (const [key, entry] of buttons) {\n        if (!keys.includes(key)) {\n          entry.button.remove();\n          buttons.delete(key);\n        }\n      }\n      let previous: HTMLButtonElement | null = null;\n      for (const item of items) {\n        let entry = buttons.get(item.key);\n        if (!entry) {\n          const button = doc.createElement('button');\n          button.type = 'button';\n          button.addEventListener('click', () => {\n            const current = buttons.get(item.key)?.item;\n            if (current && !current.disabled) current.activate();\n          }, { signal });\n          entry = { button, item, signature: '' };\n          buttons.set(item.key, entry);\n        }\n        entry.item = item;\n        const { button } = entry;\n        const signature = JSON.stringify([item.label, item.swatch, item.struck, item.symbol]);\n        if (signature !== entry.signature) {\n          fill(button, item);\n          entry.signature = signature;\n        }\n        if (button.className !== item.className) button.className = item.className;\npackages/axylo/test/browser/chart/final-round3.browser.test.ts:278:      root.innerHTML = '<div id=\"wrap\" style=\"width: 360px; height: 140px; overflow: hidden;\"><slot></slot></div>';\n","exit_code":0,"status":"completed"}}
