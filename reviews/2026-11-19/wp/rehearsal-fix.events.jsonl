{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'cat rehearsal/{grade.mjs,table.mjs,test/grade.browser.test.mjs,test/fixtures.test.mjs,test/runner.test.mjs,vitest.config.mjs}'","aggregated_output":"import { lstat, readFile, realpath } from 'node:fs/promises';\nimport { basename, join, resolve } from 'node:path';\nimport { parseArgs } from 'node:util';\nimport { build } from 'esbuild';\nimport { chromium } from 'playwright-core';\nimport { inside, isMain, readJson, repository, taskFiles, writeJson } from './files.mjs';\nimport { compareRows } from './table.mjs';\n\nconst zones = ['America/Los_Angeles', 'Asia/Tokyo'];\nconst timeout = 5000;\nconst origin = 'https://axylo-rehearsal.invalid';\nconst criteriaNames = ['render', 'no error diagnostics', 'accessible name', 'table rows', 'reader note', 'chart type'];\nconst criterion = (name, pass, detail) => ({ name, pass, detail });\n\nasync function registryLevels() {\n  const registry = await readFile(join(repository, 'packages/axylo/src/diagnostics/registry.ts'), 'utf8');\n  const levels = new Map([...registry.matchAll(/^\\s*(AX\\d+): \\{ level: '(error|warning|hint)'/gm)]\n    .map(([, code, level]) => [code, level]));\n  if (levels.get('AX101') !== 'error' || levels.get('AX140') !== 'warning') {\n    throw new Error('Could not read diagnostic levels from the Axylo registry.');\n  }\n  return levels;\n}\n\nasync function bundle(workspace, data) {\n  const result = await build({\n    absWorkingDir: workspace,\n    stdin: {\n      resolveDir: workspace,\n      contents: `\n        import * as answer from './chart.js';\n        try {\n          const render = Reflect.get(answer, 'default');\n          if (typeof render !== 'function') throw new Error('chart.js must default-export a render function.');\n          const handle = render(document.getElementById('chart'), ${JSON.stringify(data)});\n          if (!handle || typeof handle.update !== 'function' || typeof handle.destroy !== 'function' ||\n              !Array.isArray(handle.diagnostics)) {\n            throw new Error('render must return the Axylo chart handle.');\n          }\n          window.rehearsalRender = { handle };\n        } catch (error) {\n          window.rehearsalRender = { error: String(error), diagnostics: error?.diagnostics };\n        }\n      `,\n    },\n    bundle: true,\n    format: 'iife',\n    platform: 'browser',\n    conditions: ['browser'],\n    write: false,\n    outfile: 'chart-bundle.js',\n    logLevel: 'silent',\n    plugins: [{\n      name: 'workspace-files',\n      setup(builder) {\n        builder.onLoad({ filter: /.*/, namespace: 'file' }, async args => {\n          if (!inside(workspace, await realpath(args.path))) {\n            return { errors: [{ text: 'Import outside the rehearsal workspace: ' + args.path }] };\n          }\n        });\n      },\n    }],\n  });\n  return new Map(result.outputFiles.map(file => ['/' + basename(file.path), file.text]));\n}\n\nconst html = `<!doctype html><html lang=\"en-US\"><meta charset=\"utf-8\">\n<title>Axylo rehearsal</title><link rel=\"stylesheet\" href=\"/chart-bundle.css\">\n<div id=\"chart\" style=\"width:720px;height:400px\"></div><script src=\"/chart-bundle.js\"></script></html>`;\n\nasync function inspect(browser, files, expected, levels, timezoneId) {\n  const context = await browser.newContext({ timezoneId, locale: 'en-US', serviceWorkers: 'block' });\n  const criteria = [];\n  const diagnostics = new Map();\n  const errors = [];\n  let table;\n  const addDiagnostic = (code, diagnostic, source) => {\n    const previous = diagnostics.get(code);\n    diagnostics.set(code, {\n      ...previous, ...diagnostic, code, level: levels.get(code) ?? diagnostic.level ?? 'unknown', timezoneId,\n      sources: [...new Set([...(previous?.sources ?? []), source])],\n    });\n  };\n\n  try {\n    await context.route('**/*', route => {\n      const url = new URL(route.request().url());\n      if (url.origin !== origin) return route.abort();\n      if (url.pathname === '/') {\n        return route.fulfill({\n          contentType: 'text/html',\n          body: html,\n          headers: {\n            'Content-Security-Policy': \"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\",\n          },\n        });\n      }\n      if (url.pathname.endsWith('.css')) {\n        return route.fulfill({ contentType: 'text/css', body: files.get(url.pathname) ?? '' });\n      }\n      const script = files.get(url.pathname);\n      return script === undefined ? route.abort() : route.fulfill({ contentType: 'text/javascript', body: script });\n    });\n\n    const page = await context.newPage();\n    page.setDefaultTimeout(timeout);\n    page.on('pageerror', error => errors.push(String(error)));\n    page.on('console', message => {\n      const text = message.text();\n      const code = /\\[axylo (AX\\d+)\\]/.exec(text)?.[1];\n      if (code) addDiagnostic(code, { console: text }, 'console');\n    });\n    await page.goto(origin, { waitUntil: 'load', timeout });\n    const problem = await page.evaluate(() => window.rehearsalRender?.error ?? null);\n    const figure = page.locator('#chart figure');\n    let state = '';\n    if (!problem && errors.length === 0) {\n      await page.waitForFunction(() => new Promise(done => {\n        requestAnimationFrame(() => requestAnimationFrame(() => done(true)));\n      }));\n\n      if (await figure.count() === 1) {\n        const byName = page.getByRole('group', { name: expected.title, exact: true })\n          .or(page.getByRole('figure', { name: expected.title, exact: true }))\n          .or(page.getByRole('img', { name: expected.title, exact: true }));\n        const titlePass = await figure.and(byName).count() === 1;\n        const name = titlePass ? expected.title : (await figure.ariaSnapshot()).split('\\n')[0];\n        criteria.push(criterion('accessible name', titlePass, name || 'No accessible figure name.'));\n        state = (await figure.locator('.axylo-message:visible').allTextContents()).join(' ');\n        const description = (await figure.locator('.axylo-description').allTextContents())[0] ?? '';\n        const types = await figure.locator('[aria-roledescription]').evaluateAll(nodes =>\n          nodes.map(node => node.getAttribute('aria-roledescription')));\n        const observedType = (types.find(type => /^(?:line|area|bar|scatter|donut) chart$/i.test(type)) ?? description)\n          .match(/^(line|area|bar|scatter|donut) chart\\b/i)?.[1].toLowerCase();\n        criteria.push(criterion('chart type', observedType === expected.type,\n          `Expected ${expected.type}, saw ${observedType ?? 'no chart type'}.`));\n\n        const note = (await figure.locator('.axylo-note:visible').allTextContents()).join(' ');\n        const omission = /\\bValues not shown\\b/i.test(note);\n        const notePass = omission === (expected.valuesNotShown ?? false);\n        criteria.push(criterion('reader note', notePass, note || 'No values-omitted note.'));\n        try {\n          const button = figure.getByRole('button', { name: 'View as table', exact: true });\n          if (await button.count() === 1) {\n            await button.click();\n            const view = figure.getByRole('table');\n            if (await view.count() === 1 && await view.isVisible()) {\n              table = await view.evaluate(element => ({\n                headers: Array.from(element.tHead?.rows[0]?.cells ?? [], cell => cell.textContent.trim()),\n                rows: Array.from(element.tBodies[0]?.rows ?? [], row =>\n                  Array.from(row.cells, cell => cell.textContent.trim())),\n              }));\n            }\n          }\n          if (!table) {\n            criteria.push(criterion('table rows', false, 'Could not open one visible table with “View as table”.'));\n          } else if (await figure.getByRole('button', { name: 'Next page', exact: true }).count()) {\n            criteria.push(criterion('table rows', false, 'Unexpected additional table pages.'));\n          } else {\n            const compared = compareRows(expected, table.headers, table.rows);\n            criteria.push(criterion('table rows', compared.pass, compared.detail));\n          }\n        } catch (error) {\n          criteria.push(criterion('table rows', false, String(error)));\n        }\n      }\n    }\n\n    const handleDiagnostics = await page.evaluate(() => {\n      const result = window.rehearsalRender;\n      return result?.handle?.diagnostics ?? result?.diagnostics ?? [];\n    });\n    for (const { code, level, message } of handleDiagnostics) addDiagnostic(code, { level, message }, 'handle');\n    const errorCodes = [...diagnostics.values()].filter(d => d.level === 'error').map(d => d.code);\n    const errorState = ['Loading chart.', 'No data to show.'].includes(state) ? '' : state;\n    criteria.push(criterion('no error diagnostics', !errorState && errorCodes.length === 0,\n      [...errorCodes, errorState].filter(Boolean).join(' | ') || 'No error diagnostics or error state.'));\n    const title = criteria.find(item => item.name === 'accessible name');\n    if (title && diagnostics.has('AX140')) {\n      title.pass = false;\n      title.detail += ' (AX140)';\n    }\n\n    const reason = problem || errors.join(' | ') || (await figure.count() !== 1 && 'Expected one Axylo figure in #chart.');\n    criteria.push(criterion('render', !reason, reason || 'Rendered a chart and returned its handle.'));\n  } catch (error) {\n    criteria.push(criterion('render', false, String(error)));\n  } finally {\n    await context.close();\n  }\n\n  return {\n    timezoneId,\n    criteria: criteriaNames.map(name => criteria.find(item => item.name === name) ??\n      criterion(name, false, 'Unavailable after render failure.')),\n    diagnostics: [...diagnostics.values()],\n    ...(table ? { table } : {}),\n  };\n}\n\nexport async function grade(workspace, task, { launch = () => chromium.launch({ channel: 'chrome', headless: true, timeout: 15000 }) } = {}) {\n  workspace = await realpath(workspace);\n  const taskPaths = taskFiles(task);\n  const expected = await readJson(taskPaths.expected);\n  const save = async result => {\n    await writeJson(join(workspace, 'grade.json'), result);\n    return result;\n  };\n  const fail = (name, detail) => save({ pass: false, criteria: [criterion(name, false, detail)], diagnostics: [], timezones: [] });\n\n  let files;\n  try {\n    if (!(await lstat(join(workspace, 'chart.js'))).isFile()) {\n      return fail('render', 'chart.js must be a regular file.');\n    }\n    // Grade the original fixture even if the agent changed its local copy while experimenting.\n    const data = await readJson(taskPaths.fixture);\n    files = await bundle(workspace, data);\n  } catch (error) {\n    return fail('render', error.code === 'ENOENT' ? 'chart.js is missing.' : String(error));\n  }\n\n  const levels = await registryLevels();\n  let browser;\n  try {\n    browser = await launch();\n  } catch (error) {\n    return fail('browser', String(error));\n  }\n  try {\n    const timezones = [];\n    for (const timezoneId of zones) timezones.push(await inspect(browser, files, expected, levels, timezoneId));\n    const criteria = criteriaNames.map(name => {\n      const results = timezones.map(zone => zone.criteria.find(item => item.name === name));\n      return criterion(name, results.every(item => item.pass),\n        results.map((item, index) => `${zones[index]}: ${item.detail}`).join(' | '));\n    });\n    return await save({\n      pass: criteria.every(item => item.pass),\n      criteria,\n      diagnostics: timezones.flatMap(zone => zone.diagnostics),\n      timezones,\n    });\n  } finally {\n    await browser.close();\n  }\n}\n\nif (isMain(import.meta.url)) {\n  try {\n    const { values } = parseArgs({ options: { task: { type: 'string' }, workdir: { type: 'string' } } });\n    if (!values.task || !values.workdir) throw new Error('Usage: node rehearsal/grade.mjs --task <id> --workdir <workspace>');\n    const result = await grade(resolve(values.workdir), values.task);\n    console.log(JSON.stringify(result, null, 2));\n    process.exitCode = result.pass ? 0 : result.criteria.some(item => item.name === 'browser') ? 2 : 1;\n  } catch (error) {\n    console.error(String(error));\n    process.exitCode = 2;\n  }\n}\nconst months = ['january', 'february', 'march', 'april', 'may', 'june',\n  'july', 'august', 'september', 'october', 'november', 'december'];\n\nfunction calendarDate(text) {\n  const suffix = '(?=$|[T,\\\\s])';\n  const iso = new RegExp('^(\\\\d{4})-(\\\\d{2})-(\\\\d{2})' + suffix).exec(text);\n  if (iso) return iso[0];\n  const numeric = new RegExp('^(\\\\d{1,2})/(\\\\d{1,2})/(\\\\d{4})' + suffix).exec(text);\n  const words = new RegExp('^([a-z]+)\\\\.? (\\\\d{1,2}),? (\\\\d{4})' + suffix, 'i').exec(text);\n  const month = words?.[1].toLowerCase();\n  const number = numeric?.[1] ?? (months.findIndex(name => name === month || name.slice(0, 3) === month) + 1);\n  const [day, year] = (numeric ?? words ?? []).slice(2);\n  if (!number || !year) return null;\n  // Reading the visible calendar day must not convert the printed time back to UTC.\n  return `${year}-${String(number).padStart(2, '0')}-${day.padStart(2, '0')}`;\n}\n\nfunction cellValue(text, unit) {\n  if (unit && text.endsWith(' ' + unit)) text = text.slice(0, -(unit.length + 1)).trim();\n  if (text === 'No data') return null;\n  const number = text.replace(/^−/, '-').replace(/^([+-]?)\\p{Sc}\\s*/u, '$1');\n  if (/^[+-]?(?:(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?$/i.test(number)) {\n    return Number(number.replaceAll(',', ''));\n  }\n  return undefined;\n}\n\nexport function compareRows(expected, headers, rows) {\n  const columns = expected.series.length + 1;\n  if (headers.length !== columns) {\n    return { pass: false, detail: `Expected ${columns} columns, saw ${headers.length}.` };\n  }\n  const order = columns === 2 ? [1] : expected.series.map(name =>\n    headers.findIndex((label, index) => index > 0 && label.toLowerCase().replace(/ \\([^)]+\\)$/, '') === name));\n  if (order.includes(-1)) {\n    return { pass: false, detail: `Expected columns for ${expected.series.join(', ')}, saw ${JSON.stringify(headers.slice(1))}.` };\n  }\n  const units = order.map(column => / \\(([^)]+)\\)$/.exec(headers[column])?.[1]);\n  let index = 0;\n  for (const [x, ...values] of expected.rows) {\n    const row = rows[index];\n    const displayedX = row?.length && (expected.x === 'date' ? calendarDate(row[0]) : row[0]);\n    if (displayedX !== x && values.every(value => value === null)) continue;\n    if (!row || row.length !== columns || displayedX !== x ||\n        values.some((value, i) => value !== cellValue(row[order[i]], units[i]))) {\n      return { pass: false, detail: `Row ${index + 1} expected ${JSON.stringify([x, ...values])}, saw ${JSON.stringify(row ?? null)}.` };\n    }\n    index++;\n  }\n  if (index < rows.length) {\n    return { pass: false, detail: `Unexpected row ${index + 1} ${JSON.stringify(rows[index])}.` };\n  }\n  return { pass: true, detail: `${rows.length} rows match.` };\n}\nimport { mkdtemp, rm, writeFile } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { chromium } from 'playwright-core';\nimport { afterAll, beforeAll, expect, it } from 'vitest';\nimport { grade } from '../grade.mjs';\nimport { prepareWorkspace } from '../workspace.mjs';\n\nconst visits = `import { line } from 'axylo';\nexport default function render(element, data) {\n  return line(element, { data, x: { field: 'day', type: 'date' }, y: 'visits', title: 'Daily visits' });\n}`;\n\nconst sales = `import { bar } from 'axylo';\nexport default function render(element, data) {\n  return bar(element, {\n    data, x: 'quarter', y: [\n      { field: 'north', parse: 'number' },\n      { field: 'central', parse: 'number' },\n      { field: 'west', parse: 'number' },\n    ], title: 'Quarterly sales by region',\n  });\n}`;\n\nconst signups = `import { line } from 'axylo';\nexport default function render(element, data) {\n  return line(element, { data, x: 'day', y: 'signpus', title: 'Daily signups' });\n}`;\n\nconst revenue = `import { line } from 'axylo';\nexport default function render(element, data) {\n  const rows = data.map(row => ({ ...row, revenue: Number(row.revenue) }));\n  return line(element, { data: rows, x: { field: 'day', type: 'date' }, y: 'revenue', title: 'Daily store revenue' });\n}`;\n\nconst LA = 'America/Los_Angeles';\nconst Tokyo = 'Asia/Tokyo';\nlet scratch;\nlet browser;\nbeforeAll(async () => {\n  scratch = await mkdtemp(join(tmpdir(), 'axylo-rehearsal-browser-'));\n  browser = await chromium.launch({ channel: 'chrome', headless: true, timeout: 15000 });\n});\nafterAll(async () => {\n  await browser?.close();\n  if (scratch) await rm(scratch, { recursive: true, force: true });\n});\n\nasync function answer(task, source) {\n  const { workspace } = await prepareWorkspace(scratch, task);\n  await writeFile(join(workspace, 'chart.js'), source);\n  // The tests reuse a Chrome process, while each grade still creates two clean contexts.\n  return grade(workspace, task, { launch: async () => ({ newContext: options => browser.newContext(options), close: async () => {} }) });\n}\n\nfunction criterion(result, name) {\n  return result.criteria.find(item => item.name === name);\n}\n\nit.each([\n  ['daily-visits', visits],\n  ['regional-sales', sales],\n  ['signups', signups],\n  ['daily-revenue', revenue],\n])('passes a hand-written %s answer in both time zones', async (task, source) => {\n  const result = await answer(task, source);\n  expect(result.criteria.filter(item => !item.pass)).toEqual([]);\n  expect(result.pass).toBe(true);\n  expect(result.timezones.map(zone => zone.timezoneId)).toEqual([LA, Tokyo]);\n});\n\nit('fails the calendar-day check in Los Angeles when midnight is treated as an instant', async () => {\n  const result = await answer('daily-visits', visits.replace(\"{ field: 'day', type: 'date' }\", \"'day'\"));\n  expect(result.pass).toBe(false);\n  expect(criterion(result.timezones[0], 'table rows')).toMatchObject({ pass: false, detail: expect.stringContaining('Feb 28, 2026') });\n  expect(criterion(result.timezones[1], 'table rows').pass).toBe(true);\n  expect(criterion(result, 'no error diagnostics').pass).toBe(true);\n  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX111', level: 'hint', sources: ['handle'] }));\n});\n\nit('accepts the documented automatic conversion of an all-decimal-string field', async () => {\n  const result = await answer('regional-sales', sales.replaceAll(\", parse: 'number'\", ''));\n  expect(result.criteria.filter(item => !item.pass)).toEqual([]);\n  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX104', level: 'hint', sources: ['handle'] }));\n});\n\nit('fails the rows and reader note when mixed numeric strings are left unparsed', async () => {\n  const result = await answer('daily-revenue', revenue.replace('data: rows', 'data'));\n  expect(criterion(result, 'table rows').pass).toBe(false);\n  expect(criterion(result, 'reader note').pass).toBe(false);\n  expect(criterion(result, 'no error diagnostics').pass).toBe(true);\n  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX106', level: 'warning' }));\n});\n\nit('fails the rows when absent days are filled with zero', async () => {\n  const result = await answer('daily-visits', visits.replace(\"y: 'visits'\", \"y: { field: 'visits', missing: 'zero' }\"));\n  expect(criterion(result, 'table rows')).toMatchObject({ pass: false, detail: expect.stringContaining('2026-03-06') });\n  expect(criterion(result, 'no error diagnostics').pass).toBe(true);\n});\n\nit('fails the diagnostics check when the missing field raises AX101', async () => {\n  const result = await answer('signups', signups.replace(\"y: 'signpus'\", \"y: 'signups'\"));\n  expect(criterion(result, 'no error diagnostics')).toMatchObject({ pass: false, detail: expect.stringContaining('AX101') });\n  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX101', level: 'error', sources: ['console', 'handle'] }));\n});\n\nit('fails an explicit chart error state even when Axylo emits no error code', async () => {\n  const result = await answer('signups', signups.replace(\"title: 'Daily signups'\",\n    \"title: 'Daily signups', state: { error: 'Signups could not load.' }\"));\n  expect(criterion(result, 'no error diagnostics')).toMatchObject({\n    pass: false, detail: expect.stringContaining('Signups could not load.'),\n  });\n  expect(result.diagnostics.filter(item => item.level === 'error')).toEqual([]);\n});\n\nit('fails the accessible name when Axylo uses a fallback', async () => {\n  const result = await answer('signups', signups.replace(\", title: 'Daily signups'\", ''));\n  expect(result.criteria.filter(item => !item.pass).map(item => item.name)).toEqual(['accessible name']);\n  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX140', level: 'warning' }));\n});\n\nit('fails the chart type when a bar is used for the signups line', async () => {\n  const result = await answer('signups', signups.replaceAll(/\\bline\\b/g, 'bar'));\n  expect(result.criteria.filter(item => !item.pass).map(item => item.name)).toEqual(['chart type']);\n});\n\nit.each([\n  ['export function render() {}', 'must default-export'],\n  ['export default function render() { throw new Error(\"render failed\"); }', 'render failed'],\n  ['export default function render() {}', 'must return the Axylo chart handle'],\n])('fails an invalid delivery (%s)', async (source, reason) => {\n  const result = await answer('daily-visits', source);\n  expect(criterion(result, 'render')).toMatchObject({ pass: false, detail: expect.stringContaining(reason) });\n});\nimport { describe, expect, it } from 'vitest';\nimport fc from 'fast-check';\nimport { readJson, taskFiles } from '../files.mjs';\nimport { compareRows } from '../table.mjs';\n\nconst specs = [\n  ['daily-visits', [2026, 3, 1, 30], ['visits'], [6, 12, 26]],\n  ['signups', [2026, 4, 6, 7], ['signpus'], []],\n  ['daily-revenue', [2026, 5, 1, 8], ['revenue'], [4]],\n  ['regional-sales', null, ['north', 'central', 'west'], []],\n];\n\ndescribe('fixture expectations', () => {\n  it.each(specs)('%s follows the calendar or categories and preserves the source values', async (task, period, keys, missing) => {\n    const files = taskFiles(task);\n    const [data, expected] = await Promise.all([readJson(files.fixture), readJson(files.expected)]);\n    if (!period) {\n      expect(data.every(row => keys.every(key => typeof row[key] === 'string'))).toBe(true);\n      const rows = data.map(row => [row.quarter, ...keys.map(key => Number(row[key]))]);\n      expect(expected.rows).toEqual(rows);\n      return;\n    }\n\n    const [year, month, start, count] = period;\n    const days = Array.from({ length: count }, (_, index) =>\n      new Date(Date.UTC(year, month - 1, start + index)).toISOString().split('T')[0]);\n    const observations = new Map(data.map(row => [row.day.split('T')[0], row]));\n    expect(observations.size).toBe(data.length);\n    expect(data.length).toBe(days.length - missing.length);\n    expect(days.filter(day => !observations.has(day)).map(day => Number(day.slice(-2)))).toEqual(missing);\n    expect(expected.rows).toEqual(days.map(day => {\n      const row = observations.get(day);\n      return [day, ...keys.map(key => row ? Number(row[key]) : null)];\n    }));\n    if (missing.length) {\n      expect(data.map(row => row.day)).not.toEqual(data.map(row => row.day).sort());\n      expect(data.every(row => row.day.endsWith('T00:00:00Z'))).toBe(true);\n    }\n  });\n\n  it('accepts formatted numbers and omitted gaps, and rejects a zero substituted for any gap', () => {\n    fc.assert(fc.property(fc.array(fc.integer({ min: -1000000, max: 1000000 }), { minLength: 1, maxLength: 12 }), values => {\n      const expected = {\n        x: 'category', series: ['sales'],\n        rows: [['Missing', null], ...values.map((value, i) => [String(i), value])],\n      };\n      const headers = ['Quarter', 'Sales'];\n      const format = new Intl.NumberFormat('en-US');\n      const displayed = values.map((value, i) => [String(i), format.format(value)]);\n      expect(compareRows(expected, headers, displayed).pass).toBe(true);\n      expect(compareRows(expected, headers, [['Missing', 'No data'], ...displayed]).pass).toBe(true);\n      expect(compareRows(expected, headers, [['Missing', '0'], ...displayed]).pass).toBe(false);\n    }));\n  });\n\n  it('compares the printed day without moving an instant back to UTC', () => {\n    const expected = { x: 'date', series: ['sales'], rows: [['2026-03-01', 1250.5]] };\n    const headers = ['Day', 'Sales'];\n    expect(compareRows(expected, headers, [['Mar 1, 2026, 9:00 AM GMT+9', '1,250.50']]).pass).toBe(true);\n    expect(compareRows(expected, headers, [['Feb 28, 2026, 4:00 PM PST', '1,250.5']])).toEqual({\n      pass: false, detail: 'Row 1 expected [\"2026-03-01\",1250.5], saw [\"Feb 28, 2026, 4:00 PM PST\",\"1,250.5\"].',\n    });\n  });\n});\nimport { access, mkdir, mkdtemp, readFile, readdir, rm, symlink, writeFile } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { afterEach, beforeEach, expect, it, vi } from 'vitest';\nimport { agentArgs, observeAgent, runAgent } from '../agent.mjs';\nimport { auditTranscript } from '../audit.mjs';\nimport { repository } from '../files.mjs';\nimport { grade } from '../grade.mjs';\nimport { prepareWorkspace } from '../workspace.mjs';\n\nconst jsonl = (...events) => events.map(event => JSON.stringify(event)).join('\\n');\nconst command = (text, cwd) => ({ type: 'item.completed', item: { type: 'command_execution', command: text, cwd } });\nconst claude = (name, input, model) => ({\n  type: 'assistant', message: { model, content: [{ type: 'tool_use', name, input }] },\n});\n\nlet scratch;\nbeforeEach(async () => { scratch = await mkdtemp(join(tmpdir(), 'axylo-rehearsal-test-')); });\nafterEach(async () => {\n  vi.unstubAllEnvs();\n  await rm(scratch, { recursive: true, force: true });\n});\n\nit('audits actual Codex commands and Claude tool calls while allowing the published docs and system tools', async () => {\n  const transcript = jsonl(\n    { type: 'thread.started', thread_id: 'rehearsal-test' },\n    command('/bin/bash -lc \\'cat docs/getting-started.html; node ./chart.js\\'', scratch),\n    claude('Read', { file_path: join(scratch, 'data.json') }, 'claude-test-model'),\n    { type: 'item.completed', item: { type: 'agent_message', text: 'I did not read /home/user/notes.txt.' } },\n  );\n  expect(await auditTranscript(transcript, scratch)).toEqual({ void: false, paths: [], malformedLines: 0 });\n});\n\nit('voids a transcript that reads Axylo source', async () => {\n  const source = '/home/canarit/projects/axylo/packages/axylo/src/index.ts';\n  const transcript = jsonl(\n    command(`/bin/bash -lc 'cat \"${source}\"'`, scratch),\n    claude('Read', { file_path: source }, 'claude-test-model'),\n  );\n  expect(await auditTranscript(transcript, scratch)).toEqual({ void: true, paths: [source], malformedLines: 0 });\n});\n\nit('follows recorded relative paths and symlinks out of the workspace', async () => {\n  const workspace = join(scratch, 'workspace');\n  const outside = join(scratch, 'other.txt');\n  await mkdir(workspace);\n  await writeFile(outside, '');\n  await symlink(outside, join(workspace, 'linked.txt'));\n  const transcript = jsonl(command('cat linked.txt', workspace), claude('Read', { file_path: '../other.txt' }));\n  expect(await auditTranscript(transcript, workspace)).toEqual({ void: true, paths: [outside], malformedLines: 0 });\n});\n\nit('preserves literal paths with spaces and ignores paths mentioned in tool output', async () => {\n  const workspace = join(scratch, 'workspace with spaces');\n  await mkdir(workspace);\n  const event = command(`/bin/bash -lc 'cat \"${join(workspace, 'data.json')}\"'`, workspace);\n  event.item.aggregated_output = '/another/path';\n  expect(await auditTranscript(jsonl(event), workspace)).toEqual({ void: false, paths: [], malformedLines: 0 });\n});\n\nit('reads observed metadata without substituting requested values', async () => {\n  const sessionDirectory = join(scratch, '2026', '11', '19');\n  const events = jsonl({ type: 'thread.started', thread_id: 'thread-id' });\n  await mkdir(sessionDirectory, { recursive: true });\n  await writeFile(join(sessionDirectory, 'rollout-day-thread-id.jsonl'), jsonl(\n    { type: 'turn_context', payload: { model: 'codex-observed', effort: 'high' } },\n  ));\n  expect(await observeAgent('codex', events, scratch)).toEqual({ model: 'codex-observed', effort: 'high', threadId: 'thread-id' });\n  expect(await observeAgent('claude', jsonl(claude('Read', { file_path: 'data.json' }, 'claude-observed'))))\n    .toEqual({ model: 'claude-observed', effort: null });\n});\n\nit('passes the non-interactive flags without shell interpolation', () => {\n  expect(agentArgs('codex', { workspace: scratch, model: 'requested-codex', effort: 'high' })).toEqual([\n    'exec', '-m', 'requested-codex', '-c', 'model_reasoning_effort=\"high\"', '-s', 'workspace-write',\n    '--skip-git-repo-check', '-C', scratch, '--json', '-',\n  ]);\n  expect(agentArgs('claude', { workspace: scratch, model: 'requested-claude' })).toEqual([\n    '-p', '--model', 'requested-claude', '--output-format', 'stream-json', '--verbose', '--allowedTools',\n    'Read,Write,Edit,Glob,Grep,Bash(node:*),Bash(ls:*),Bash(cat:*)',\n  ]);\n});\n\nit('captures stdout and stderr from a local fixture executable and stops it on timeout', async () => {\n  const bin = join(scratch, 'bin');\n  const workspace = join(scratch, 'workspace');\n  const timedRun = join(scratch, 'timed');\n  await Promise.all([mkdir(bin), mkdir(workspace), mkdir(timedRun)]);\n  await writeFile(join(workspace, 'PROMPT.md'), 'Prompt from stdin\\n');\n  const executable = join(bin, 'codex');\n  await writeFile(executable, '#!/bin/sh\\nIFS= read -r prompt\\nprintf \"%s\" \"$prompt\"\\nprintf \"%s\" \"stderr\" >&2\\n', { mode: 0o700 });\n  vi.stubEnv('PATH', bin);\n  const options = { workspace, runDirectory: scratch, model: 'fixture-executable', timeoutMs: 5000 };\n  const finished = await runAgent('codex', options);\n  expect(finished.exit).toEqual({ code: 0, signal: null, timedOut: false, error: null });\n  expect(await readFile(finished.transcript, 'utf8')).toBe('Prompt from stdin');\n  expect(await readFile(finished.stderr, 'utf8')).toBe('stderr');\n\n  await writeFile(executable, '#!/bin/sh\\nexec /bin/sleep 10\\n');\n  const stopped = await runAgent('codex', { ...options, runDirectory: timedRun, timeoutMs: 100 });\n  expect(stopped.exit).toEqual({ code: null, signal: 'SIGTERM', timedOut: true, error: null });\n});\n\nit('prepares a clean workspace from the packed package and the published docs', async () => {\n  await expect(prepareWorkspace(join(repository, 'rehearsal', 'would-create'), 'daily-visits'))\n    .rejects.toThrow('--workdir must be outside the repository.');\n  const { workspace } = await prepareWorkspace(scratch, 'daily-visits');\n  expect((await readdir(workspace)).sort()).toEqual(['PROMPT.md', 'data.json', 'docs', 'node_modules', 'package.json']);\n  expect(JSON.parse(await readFile(join(workspace, 'package.json'), 'utf8'))).toEqual({ type: 'module' });\n  await access(join(workspace, 'node_modules/axylo/dist/axylo.js'));\n  await access(join(workspace, 'docs/getting-started.html'));\n  await access(join(workspace, 'docs/source/apps/docs/examples/daily-sessions.ts.html'));\n  await expect(access(join(workspace, 'docs/source/packages'))).rejects.toHaveProperty('code', 'ENOENT');\n});\n\nit('records a missing chart without opening Chrome', async () => {\n  const result = await grade(scratch, 'daily-visits', {\n    launch: () => { throw new Error('Chrome should only be opened for a bundle.'); },\n  });\n  expect(result.criteria).toEqual([{ name: 'render', pass: false, detail: 'chart.js is missing.' }]);\n  expect(JSON.parse(await readFile(join(scratch, 'grade.json'), 'utf8'))).toEqual(result);\n});\n\nit('bundles the packed browser entry before reporting a Chrome launch failure', async () => {\n  const { workspace } = await prepareWorkspace(scratch, 'signups');\n  await writeFile(join(workspace, 'chart.js'), `\n    import { line } from 'axylo';\n    export default function render(element, data) {\n      return line(element, { data, x: 'day', y: 'signpus', title: 'Daily signups' });\n    }\n  `);\n  const result = await grade(workspace, 'signups', {\n    launch: () => { throw new Error('Chrome unavailable in this test.'); },\n  });\n  expect(result.criteria).toEqual([{ name: 'browser', pass: false, detail: 'Error: Chrome unavailable in this test.' }]);\n});\nimport { fileURLToPath } from 'node:url';\nimport { defineConfig } from 'vitest/config';\n\nexport default defineConfig({\n  root: fileURLToPath(new URL('.', import.meta.url)),\n  cacheDir: '.vite',\n  test: {\n    include: ['test/**/*.test.mjs'],\n    hookTimeout: 30000,\n    testTimeout: 30000,\n  },\n});\n","exit_code":0,"status":"completed"}}
