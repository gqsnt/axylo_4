{"type":"item.started","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"python - <<'PY'\nimport json\nfrom pathlib import Path\nroot = Path('rehearsal/fixtures')\ntasks = {\n    'daily-visits': [('visits', 'Visits')],\n    'regional-sales': [('north', 'North'), ('central', 'Central'), ('west', 'West')],\n    'signups': [('signpus', 'Signups')],\n    'daily-revenue': [('revenue', 'Revenue')],\n}\ndef save(name, suffix, value):\n    if isinstance(value, list):\n        lines = [json.dumps(row) for row in value]\n        content = '[\\\\n  ' + ',\\\\n  '.join(lines) + '\\\\n]'\n    else:\n        rows = value.pop('rows')\n        content = json.dumps(value, indent=2)[:-2] + ',\\\\n  \\\"rows\\\": [\\\\n    '\n        content += ',\\\\n    '.join(json.dumps(row) for row in rows) + '\\\\n  ]\\\\n}'\n    (root / f'{name}.{suffix}json').write_text(content + '\\\\n')\nfor task, columns in tasks.items():\n    data = json.loads((root / f'{task}.json').read_text())\n    expected = json.loads((root / f'{task}.expected.json').read_text())\n    expected['series'] = [{'label': label} for _, label in columns]\n    if task == 'regional-sales':\n        data = [data[i] for i in (2, 0, 3, 1)]\n        save(task, '', data)\n    rows = expected['rows']\n    save(task, 'expected.', dict(expected))\n    alt = []\n    changes = {}\n    for i, row in enumerate(reversed(data)):\n        row = dict(row)\n        x = row.get('quarter', row.get('day', '').split('T')[0])\n        values = []\n        for j, (key, _) in enumerate(columns):\n            if task == 'signups' and x == '2026-04-09':\n                row.pop(key)\n                values.append(None)\n            else:\n                delta = 35 + (i * 113 + j * 79) % 251\n                original = row[key]\n                next_value = float(original) + delta\n                if next_value.is_integer():\n                    next_value = int(next_value)\n                row[key] = str(next_value) if isinst