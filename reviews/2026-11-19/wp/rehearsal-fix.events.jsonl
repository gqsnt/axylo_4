"2026-03-22\", 1094],\n    [\"2026-03-23\", 1691],\n    [\"2026-03-24\", 1775],\n    [\"2026-03-25\", 1834],\n    [\"2026-03-26\", null],\n    [\"2026-03-27\", 1623],\n    [\"2026-03-28\", 1072],\n    [\"2026-03-29\", 997],\n    [\"2026-03-30\", 1740]\n  ]\n}\nrehearsal/fixtures/daily-visits.json\n[\n  { \"day\": \"2026-03-15T00:00:00Z\", \"visits\": 943 },\n  { \"day\": \"2026-03-01T00:00:00Z\", \"visits\": 1234 },\n  { \"day\": \"2026-03-27T00:00:00Z\", \"visits\": 1623 },\n  { \"day\": \"2026-03-07T00:00:00Z\", \"visits\": 1045 },\n  { \"day\": \"2026-03-10T00:00:00Z\", \"visits\": 1762 },\n  { \"day\": \"2026-03-22T00:00:00Z\", \"visits\": 1094 },\n  { \"day\": \"2026-03-03T00:00:00Z\", \"visits\": 1593 },\n  { \"day\": \"2026-03-19T00:00:00Z\", \"visits\": 1896 },\n  { \"day\": \"2026-03-30T00:00:00Z\", \"visits\": 1740 },\n  { \"day\": \"2026-03-05T00:00:00Z\", \"visits\": 1658 },\n  { \"day\": \"2026-03-21T00:00:00Z\", \"visits\": 1112 },\n  { \"day\": \"2026-03-09T00:00:00Z\", \"visits\": 1550 },\n  { \"day\": \"2026-03-13T00:00:00Z\", \"visits\": 1589 },\n  { \"day\": \"2026-03-24T00:00:00Z\", \"visits\": 1775 },\n  { \"day\": \"2026-03-02T00:00:00Z\", \"visits\": 1461 },\n  { \"day\": \"2026-03-29T00:00:00Z\", \"visits\": 997 },\n  { \"day\": \"2026-03-11T00:00:00Z\", \"visits\": 1811 },\n  { \"day\": \"2026-03-17T00:00:00Z\", \"visits\": 1683 },\n  { \"day\": \"2026-03-04T00:00:00Z\", \"visits\": 1487 },\n  { \"day\": \"2026-03-25T00:00:00Z\", \"visits\": 1834 },\n  { \"day\": \"2026-03-08T00:00:00Z\", \"visits\": 1017 },\n  { \"day\": \"2026-03-20T00:00:00Z\", \"visits\": 1710 },\n  { \"day\": \"2026-03-28T00:00:00Z\", \"visits\": 1072 },\n  { \"day\": \"2026-03-14T00:00:00Z\", \"visits\": 1159 },\n  { \"day\": \"2026-03-23T00:00:00Z\", \"visits\": 1691 },\n  { \"day\": \"2026-03-16T00:00:00Z\", \"visits\": 1635 },\n  { \"day\": \"2026-03-18T00:00:00Z\", \"visits\": 1848 }\n]\nrehearsal/fixtures/regional-sales.expected.json\n{\n  \"title\": \"Quarterly sales by region\",\n  \"type\": \"bar\",\n  \"x\": \"category\",\n  \"series\": [\"north\", \"central\", \"west\"],\n  \"rows\": [\n    [\"2025 Q1\", 1250.5, 975.25, 1220.75],\n    [\"2025 Q2\", 1499.25, 1102.5, 1365.5],\n    [\"2025 Q3\", 1580.75, 1010.5, 1745.25],\n    [\"2025 Q4\", 1832.5, 1464.75, 1680.25]\n  ]\n}\nrehearsal/fixtures/regional-sales.json\n[\n  { \"quarter\": \"2025 Q1\", \"north\": \"1250.5\", \"central\": \"975.25\", \"west\": \"1220.75\" },\n  { \"quarter\": \"2025 Q2\", \"north\": \"1499.25\", \"central\": \"1102.5\", \"west\": \"1365.5\" },\n  { \"quarter\": \"2025 Q3\", \"north\": \"1580.75\", \"central\": \"1010.5\", \"west\": \"1745.25\" },\n  { \"quarter\": \"2025 Q4\", \"north\": \"1832.5\", \"central\": \"1464.75\", \"west\": \"1680.25\" }\n]\nrehearsal/fixtures/signups.expected.json\n{\n  \"title\": \"Daily signups\",\n  \"type\": \"line\",\n  \"x\": \"date\",\n  \"series\": [\"signups\"],\n  \"rows\": [\n    [\"2026-04-06\", 207],\n    [\"2026-04-07\", 234],\n    [\"2026-04-08\", 219],\n    [\"2026-04-09\", 288],\n    [\"2026-04-10\", 263],\n    [\"2026-04-11\", 102],\n    [\"2026-04-12\", 119]\n  ]\n}\nrehearsal/fixtures/signups.json\n[\n  { \"day\": \"2026-04-06\", \"signpus\": 207 },\n  { \"day\": \"2026-04-07\", \"signpus\": 234 },\n  { \"day\": \"2026-04-08\", \"signpus\": 219 },\n  { \"day\": \"2026-04-09\", \"signpus\": 288 },\n  { \"day\": \"2026-04-10\", \"signpus\": 263 },\n  { \"day\": \"2026-04-11\", \"signpus\": 102 },\n  { \"day\": \"2026-04-12\", \"signpus\": 119 }\n]\n### 3.8 What the evidence will and will not show\n\nAutomated checks establish structure: names, roles, focus order, contrast, text. They do not establish that a screen-reader user finds a chart understandable. 1.0 has no evidence for that: no screen reader was run against it, not even by the developer (the owner's decision, 2026-11-18; the rehearsal on five reader and browser pairs that earlier drafts of this section planned was not done). Axylo is built by one person with no access to study participants, so no claim of usability testing with disabled users is made, and the conformance table says both things in those words. Reviewers proposed participant testing as a release gate; it is recorded here as a known limit instead.\n\n## 4. Acceptance criteria: the developer's experience\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| DX1 | The first chart takes ten lines or fewer, including import, by npm and by script tag. No required option besides data and fields. | Two CI tests that render the documented snippet from the packed distribution | D1 |\n| DX2 | One logical table, three ways to pass it: long rows, wide rows, typed columns. The three forms of each fixture produce the same normalized data and the same diagnostics, with row indexes in the caller's own form. | Equivalence tests | D2 |\n| DX3 | With typed rows, a misspelled field, a text field on a value axis, wide `y` combined with `series`, and an option that does not apply to the chart type all fail to compile. At run time, for untyped rows, the same mistakes raise AX101, AX106 and AX150. | [docs/api/examples.ts](api/examples.ts) compiles and each marked mistake fails (already checked with TypeScript 7.0.2); runtime tests per code | D5 |\n| DX4 | Diagnostics follow the registry in section 3.5: stable code, chart name, field and rows where they apply, the fix, and a documentation page per code. | Message snapshots; link checker | R5, D5 |\n| DX5 | Three methods change a chart: `update` changes options, `append` adds rows, `zoom` sets the view. They apply in call order. Validation and diagnostics are synchronous; drawing is deferred to the next frame; marks, labels, hit testing and the accessibility layer always switch to a new state together. `destroy()` releases everything and cancels pending work. No `resize()` exists. | Sequence tests: replace then append then zoom in one turn; a rejected `strict` update leaves the last valid chart; destroy before the frame; 1,000 create–destroy cycles show no heap growth trend (P7) | D3, R16 |\n| DX6 | Colors, font and spacing are CSS custom properties with documented names; the chart inherits `font-family` and `color`. `colors` pins a color to a series name so the same series has the same color on every chart. There is no theme object and no positional palette option. | Theming tests, including a 24-tile page where series subsets differ | R10 |\n| DX7 | Zero runtime dependencies (reconsidered only with a measured comparison). Size targets for 1.0, set by the owner on 2026-11-18 after measurement: 116 KiB gzipped for everything and 98 KiB for a page that uses only `line`, CSS included. (History: the first targets, 40 and 25 KiB, were written before anything was built; 96 and 80 were set the same day from a first analysis, `reviews/2026-11-18/impl/wp/size.analysis.md`; the correctness passes that followed added about 11 KiB, and a second measured analysis, `reviews/2026-11-18/impl/wp/size2.analysis.md`, showed 96 and 80 can only be met by making streaming an opt-in import, a public API change the owner left for after 1.0. That change, worth about 15 KiB, is the first size item after 1.0.) | size-limit in CI on the packed distribution | D4 |\n| DX8 | Importing in Node without a DOM does not throw, and `validate()` runs there. Creating, destroying and creating again on the same element works and leaks nothing (the sequence a framework's strict or development mode produces). Works under a Content Security Policy without `unsafe-inline` or `unsafe-eval`, served with real headers. Labels and formatter output are inserted as text, never as HTML. A target that matches no element throws an error that names the selector. | CI tests | D1 |\n| DX9 | Semantic versioning. A deprecated API keeps working for at least one minor release and six months. At most one major version a year. The previous release's documented examples still compile and run against each release candidate. | Release policy; API report diff; upgrade test | D6 |\n| DX10 | Every runnable example in the documentation is compiled and rendered in CI from the packed distribution. | Docs build | D1 |\n| DX11 | MIT license for everything, including zoom and accessibility. Third-party notices are verified at release. | Repository; release check | D7 |\n| DX12 | A coding agent gets the first chart right. Given fixed prompts and trap fixtures (UTC-midnight ISO dates, numeric strings, unsorted rows, missing days, a misspelled field), an agent with only the published docs produces a chart with no error diagnostics that passes the reader criteria. Recorded as agent rehearsal, not as user evidence. | Scripted rehearsal at each release | D1, 1.2 |\n\n## 5. Performance budgets\n\nThese numbers are provisional. They are design targets taken from Phase 1's order-of-magnitude measurements, and they become release gates only after the benchmark harness built in M0 has measured a working Axylo slice in M1 and the limits have been recalibrated and frozen (plan, M1 and M6). Each budget names its workload, metric and statistic so that two people measuring the same build get the same verdict.\n\n### M7. Distribution and documentation (ceiling: 8 days)\n\n- Script-tag builds; documentation site; migration notes from Chart.js and Recharts. (No framework adapter in 1.0.)\n\nOutcomes:\n- The packed tarball installed into two clean fixtures (npm with a bundler, script tag): the first chart works in ten lines or fewer in each (DX1).\n- Node import and `validate()` without a DOM; strict CSP with real headers (DX8).\n- Size measured on the packed distribution for line-only, full and script-tag cases, CSS included (DX7).\n- Every runnable docs example compiled and rendered from the packed distribution (DX10).\n- The agent rehearsal (DX12), recorded as rehearsal.\n\n### M8. Release (ceiling: 10 days)\n\n- Beta under a `next` tag; issues from real use fixed; API frozen through the API report.\n- The Phase 1 comparison regenerated with Axylo beside the ten libraries, with the same harness and the corrections from the review, and published with its limits.\n- Real Safari on macOS and iOS checked by hand.\n- Independent review of the acceptance evidence before 1.0 is tagged, by a reviewer who did not write the code under review.\n\nOutcomes: every acceptance-matrix row is pass or not applicable with a reason; changelog, upgrade policy and third-party notices published.\n","exit_code":1,"status":"failed"}}
