l(/(?<![\\w./:-])[\\w.-]+(?:\\/[\\w.-]+)*(?![\\w./:-])/g)) yield match[0];\n    41\t}\n    42\t\n    43\tfunction * commandPaths(command) {\n    44\t  if (typeof command !== 'string') return;\n    45\t  let offset = 0;\n    46\t  // Keep spaces in literal paths, and inspect commands quoted for a shell or Node's -e.\n    47\t  for (const match of command.matchAll(/\"([^\"\\n]+)\"|'([^'\\n]+)'/g)) {\n    48\t    yield * unquotedPaths(command.slice(offset, match.index));\n    49\t    const quoted = match[1] ?? match[2];\n    50\t    if (/^(?:file:\\/\\/|[~/]|\\.\\.?\\/)[^;&|<>()[\\]{}\"'\\n]*$/.test(quoted) && !/\\s[-/]/.test(quoted)) {\n    51\t      yield quoted;\n    52\t    } else {\n    53\t      yield * commandPaths(quoted);\n    54\t    }\n    55\t    offset = match.index + match[0].length;\n    56\t  }\n    57\t  yield * unquotedPaths(command.slice(offset));\n    58\t}\n    59\t\n    60\tfunction localPath(text, base) {\n    61\t  if (text.startsWith('file://')) {\n    62\t    try { return fileURLToPath(text); } catch { return undefined; }\n    63\t  }\n    64\t  if (/^[\\w+.-]+:\\/\\//.test(text)) return undefined;\n    65\t  return resolve(base, text.replace(/^(?:~|\\$HOME|\\$\\{HOME\\})(?=\\/|$)/, homedir()));\n    66\t}\n    67\t\n    68\tasync function resolveLinks(file) {\n    69\t  try {\n    70\t    return await realpath(file);\n    71\t  } catch (error) {\n    72\t    if (error.code !== 'ENOENT' && error.code !== 'ENOTDIR') throw error;\n    73\t    const parent = dirname(file);\n    74\t    return parent === file ? file : resolve(await resolveLinks(parent), file.slice(parent === '/' ? 1 : parent.length + 1));\n    75\t  }\n    76\t}\n    77\t\n    78\tasync function systemTool(file) {\n    79\t  if (file === '/dev/null') return true;\n    80\t  if (!/^\\/(?:usr\\/(?:local\\/)?)?(?:bin|sbin)\\/[^/]+$/.test(file)) return false;\n    81\t  try {\n    82\t    await access(file, constants.X_OK);\n    83\t    return true;\n    84\t  } catch {\n    85\t    return false;\n    86\t  }\n    87\t}\n    88\t\n    89\tconst pathKeys = /^(?:(?:file|target|source|destination|absolute|relative)[_-]?)?(?:path|paths|file|files|uri|uris)$|^(?:dir|directory|cwd|workdir|working_directory)$/i;\n    90\tconst commandKeys = /^(?:cmd|command|command_line|argv)$/i;\n    91\t\n    92\texport async function auditTranscript(transcript, workspace) {\n    93\t  workspace = await realpath(workspace);\n    94\t  const paths = new Set();\n    95\t  const checked = new Set();\n    96\t  const { events, malformedLines } = transcriptEvents(transcript);\n    97\t\n    98\t  async function check(text, base) {\n    99\t    if (!text || text === '-') return;\n   100\t    const path = localPath(text, base);\n   101\t    if (!path || checked.has(path)) return;\n   102\t    checked.add(path);\n   103\t    if (await systemTool(path)) return;\n   104\t    if (!inside(workspace, path)) {\n   105\t      paths.add(path);\n   106\t      return;\n   107\t    }\n   108\t    const actual = await resolveLinks(path);\n   109\t    if (!inside(workspace, actual) && !await systemTool(actual)) paths.add(actual);\n   110\t  }\n   111\t\n   112\t  async function scan(value, base, key = '') {\n   113\t    if (typeof value === 'string') {\n   114\t      if (commandKeys.test(key)) {\n   115\t        for (const path of commandPaths(value)) await check(path, base);\n   116\t      } else if (pathKeys.test(key)) {\n   117\t        await check(value, base);\n   118\t      } else if (key === 'arguments') {\n   119\t        try { value = JSON.parse(value); } catch { return; }\n   120\t        await scan(value, base);\n   121\t      }\n   122\t      return;\n   123\t    }\n   124\t    if (Array.isArray(value)) {\n   125\t      for (const part of value) await scan(part, base, key);\n   126\t      return;\n   127\t    }\n   128\t    if (!value || typeof value !== 'object') return;\n   129\t    const cwd = value.cwd ?? value.workdir ?? value.working_directory;\n   130\t    if (typeof c