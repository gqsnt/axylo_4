{"type":"item.completed","item":{"id":"item_42","type":"command_execution","command":"/bin/bash -lc \"nl -ba rehearsal/summary.mjs | head -50 && rg -n 'caption|xHeader|seriesHeaders' packages/axylo/src/reader/index.ts\"","aggregated_output":"     1\timport { readdir } from 'node:fs/promises';\n     2\timport { join } from 'node:path';\n     3\timport { readJson, rehearsal } from './files.mjs';\n     4\t\n     5\tconst root = join(rehearsal, 'records');\n     6\tconst entries = await readdir(root, { withFileTypes: true }).catch(error => {\n     7\t  if (error.code === 'ENOENT') return [];\n     8\t  throw error;\n     9\t});\n    10\tconst rows = [];\n    11\tfor (const entry of entries.filter(entry => entry.isDirectory()).sort((a, b) => a.name.localeCompare(b.name))) {\n    12\t  const directory = join(root, entry.name);\n    13\t  try {\n    14\t    const run = await readJson(join(directory, 'run.json'));\n    15\t    const grade = await readJson(join(directory, 'grade.json'));\n    16\t    const agentFailed = run.exit.code !== 0 || run.exit.timedOut || run.exit.error !== null;\n    17\t    const failed = grade.criteria.filter(item => !item.pass).map(item => item.name);\n    18\t    if (agentFailed) failed.unshift(run.exit.timedOut ? 'agent timeout' : 'agent exit');\n    19\t    if (run.void) failed.unshift('outside workspace');\n    20\t    rows.push([\n    21\t      entry.name, run.agent, run.observed.model ?? `${run.requested.model} (requested)`, run.task,\n    22\t      run.void ? 'void' : grade.pass && !agentFailed ? 'yes' : 'no', failed.join(', ') || '—',\n    23\t    ]);\n    24\t  } catch (error) {\n    25\t    rows.push([entry.name, '—', '—', '—', 'incomplete', String(error)]);\n    26\t  }\n    27\t}\n    28\t\n    29\tconsole.log('DX12 agent rehearsal');\n    30\tconst headings = ['Record', 'Agent', 'Model', 'Task', 'Pass', 'Failed criteria'];\n    31\tconst widths = headings.map((heading, i) => Math.max(heading.length, ...rows.map(row => row[i].length)));\n    32\tfor (const row of [headings, ...rows]) {\n    33\t  console.log(row.map((value, i) => value.padEnd(widths[i])).join('  ').trimEnd());\n    34\t}\n17:  readonly caption?: string;\n276:  const caption = [input.caption, name, generated, messages.plotLabel].find(text => text?.trim()) ?? defaultMessages.plotLabel;\n278:    view, [caption, ...referencesForView()].join(' '), formatters, messages, labels, input.locale,\n","exit_code":0,"status":"completed"}}
