nscript(transcript, scratch)).toEqual({ void: false, paths: [], malformedLines: 0 });\n    32\t});\n    33\t\n    34\tit('voids a transcript that reads Axylo source', async () => {\n    35\t  const source = '/home/canarit/projects/axylo/packages/axylo/src/index.ts';\n    36\t  const transcript = jsonl(\n    37\t    command(`/bin/bash -lc 'cat \"${source}\"'`, scratch),\n    38\t    claude('Read', { file_path: source }, 'claude-test-model'),\n    39\t  );\n    40\t  expect(await auditTranscript(transcript, scratch)).toEqual({ void: true, paths: [source], malformedLines: 0 });\n    41\t});\n    42\t\n    43\tit('follows recorded relative paths and symlinks out of the workspace', async () => {\n    44\t  const workspace = join(scratch, 'workspace');\n    45\t  const outside = join(scratch, 'other.txt');\n    46\t  await mkdir(workspace);\n    47\t  await writeFile(outside, '');\n    48\t  await symlink(outside, join(workspace, 'linked.txt'));\n    49\t  const transcript = jsonl(command('cat linked.txt', workspace), claude('Read', { file_path: '../other.txt' }));\n    50\t  expect(await auditTranscript(transcript, workspace)).toEqual({ void: true, paths: [outside], malformedLines: 0 });\n    51\t});\n    52\t\n    53\tit('preserves literal paths with spaces and ignores paths mentioned in tool output', async () => {\n    54\t  const workspace = join(scratch, 'workspace with spaces');\n    55\t  await mkdir(workspace);\n    56\t  const event = command(`/bin/bash -lc 'cat \"${join(workspace, 'data.json')}\"'`, workspace);\n    57\t  event.item.aggregated_output = '/another/path';\n    58\t  expect(await auditTranscript(jsonl(event), workspace)).toEqual({ void: false, paths: [], malformedLines: 0 });\n    59\t});\n    60\t\n    61\tit('reads observed metadata without substituting requested values', async () => {\n    62\t  const sessionDirectory = join(scratch, '2026', '11', '19');\n    63\t  const events = jsonl({ type: 'thread.started', thread_id: 'thread-id' });\n    64\t  await mkdir(sessionDirectory, { recursive: true });\n    65\t  await writeFile(join(sessionDirectory, 'rollout-day-thread-id.jsonl'), jsonl(\n    66\t    { type: 'turn_context', payload: { model: 'codex-observed', effort: 'high' } },\n    67\t  ));\n    68\t  expect(await observeAgent('codex', events, scratch)).toEqual({ model: 'codex-observed', effort: 'high', threadId: 'thread-id' });\n    69\t  expect(await observeAgent('claude', jsonl(claude('Read', { file_path: 'data.json' }, 'claude-observed'))))\n    70\t    .toEqual({ model: 'claude-observed', effort: null });\n    71\t});\n    72\t\n    73\tit('passes the non-interactive flags without shell interpolation', () => {\n    74\t  expect(agentArgs('codex', { workspace: scratch, model: 'requested-codex', effort: 'high' })).toEqual([\n    75\t    'exec', '-m', 'requested-codex', '-c', 'model_reasoning_effort=\"high\"', '-s', 'workspace-write',\n    76\t    '--skip-git-repo-check', '-C', scratch, '--json', '-',\n    77\t  ]);\n    78\t  expect(agentArgs('claude', { workspace: scratch, model: 'requested-claude' })).toEqual([\n    79\t    '-p', '--model', 'requested-claude', '--output-format', 'stream-json', '--verbose', '--allowedTools',\n    80\t    'Read,Write,Edit,Glob,Grep,Bash(node:*),Bash(ls:*),Bash(cat:*)',\n    81\t  ]);\n    82\t});\n    83\t\n    84\tit('captures stdout and stderr from a local fixture executable and stops it on timeout', async () => {\n    85\t  const bin = join(scratch, 'bin');\n    86\t  const workspace = join(scratch, 'workspace');\n    87\t  const timedRun = join(scratch, 'timed');\n    88\t  await Promise.all([mkdir(bin), mkdir(workspace), mkdir(timedRun)]);\n    89\t  await writeFile(join(workspace, 'PROMPT.md'), 'Prompt from stdin\\n');\n    90\t  const executable = join(bin, 'codex');\n    91\t  await writeFile(executable, '#!/bin/sh\\nIFS= read -r prompt\\nprintf \"%s\" \"$prompt\"\\nprintf \"%s\" \"stderr\" >&2\\n', { mode: 0o700 });\n    92\t  vi.stubEnv('PATH', bin);\n    93\t  const options = { workspace, runDirectory: scratch, model: 'fixture-executable', timeoutMs: 5000 };\n    94\t  const finished = await runAgent('codex', options);\n    95\t  expect(finished.exit).toEqual({ code: 0, signal: null, timedOut: false, error: null });\n    96\t  expect(await readFile(finished.transcript, 'utf8')).toBe('Prompt from stdin');\n    97\t  expect(await readFile(finished.stderr, 'utf8')).toBe('stderr');\n    98\t\n    99\t  await writeFile(executable, '#!/bin/sh\\nexec /bin/sleep 10\\n');\n   100\t  const stopped = await runAgent('codex', { ...options, runDirectory: timedRun, timeoutMs: 100 });\n   101\t  expect(stopped.exit).toEqual({ code: null, signal: 'SIGTERM', timedOut: true, error: null });\n   102\t});\n   103\t\n   104\tit('prepares a clean workspace from the packed package and the published docs', async () => {\n   105\t  await expect(prepareWorkspace(join(repository, 'rehearsal', 'would-create'), 'daily-visits'))\n   106\t    .rejects.toThrow('--workdir must be outside the repository.');\n   107\t  const { workspace } = await prepareWorkspace(scratch, 'daily-visits');\n   108\t  expect((await readdir(workspace)).sort()).toEqual(['PROMPT.md', 'data.json', 'docs', 'node_modules', 'package.json']);\n   109\t  expect(JSON.parse(await readFile(join(workspace, 'package.json'), 'utf8'))).toEqual({ type: 'module' });\n   110\t  await access(join(workspace, 'node_modules/axylo/dist/axylo.js'));\n   111\t  await access(join(workspace, 'docs/getting-started.html'));\n   112\t  await access(join(workspace, 'docs/source/apps/docs/examples/daily-sessions.ts.html'));\n   113\t  await expect(access(join(workspace, 'docs/source/packages'))).rejects.toHaveProperty('code', 'ENOENT');\n   114\t});\n   115\t\n   116\tit('records a missing chart without opening Chrome', async () => {\n   117\t  const result = await grade(scratch, 'daily-visits', {\n   118\t    launch: () => { throw new Error('Chrome should only be opened for a bundle.'); },\n   119\t  });\n   120\t  expect(result.criteria).toEqual([{ name: 'render', pass: false, detail: 'chart.js is missing.' }]);\n   121\t  expect(JSON.parse(await readFile(join(scratch, 'grade.json'), 'utf8'))).toEqual(result);\n   122\t});\n   123\t\n   124\tit('bundles the packed browser entry before reporting a Chrome launch failure', async () => {\n   125\t  const { workspace } = await prepareWorkspace(scratch, 'signups');\n   126\t  await writeFile(join(workspace, 'chart.js'), `\n   127\t    import { line } from 'axylo';\n   128\t    export default function render(element, data) {\n   129\t      return line(element, { data, x: 'day', y: 'signpus', title: 'Daily signups' });\n   130\t    }\n   131\t  `);\n   132\t  const result = await grade(workspace, 'signups', {\n   133\t    launch: () => { throw new Error('Chrome unavailable in this test.'); },\n   134\t  });\n   135\t  expect(result.criteria).toEqual([{ name: 'browser', pass: false, detail: 'Error: Chrome unavailable in this test.' }]);\n   136\t});\n","exit_code":0,"status":"completed"}}
