\n    75\t  const errors = [];\n    76\t  let table;\n    77\t  const addDiagnostic = (code, diagnostic, source) => {\n    78\t    const previous = diagnostics.get(code);\n    79\t    diagnostics.set(code, {\n    80\t      ...previous, ...diagnostic, code, level: levels.get(code) ?? diagnostic.level ?? 'unknown', timezoneId,\n    81\t      sources: [...new Set([...(previous?.sources ?? []), source])],\n    82\t    });\n    83\t  };\n    84\t\n    85\t  try {\n    86\t    await context.route('**/*', route => {\n    87\t      const url = new URL(route.request().url());\n    88\t      if (url.origin !== origin) return route.abort();\n    89\t      if (url.pathname === '/') {\n    90\t        return route.fulfill({\n    91\t          contentType: 'text/html',\n    92\t          body: html,\n    93\t          headers: {\n    94\t            'Content-Security-Policy': \"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\",\n    95\t          },\n    96\t        });\n    97\t      }\n    98\t      if (url.pathname.endsWith('.css')) {\n    99\t        return route.fulfill({ contentType: 'text/css', body: files.get(url.pathname) ?? '' });\n   100\t      }\n   101\t      const script = files.get(url.pathname);\n   102\t      return script === undefined ? route.abort() : route.fulfill({ contentType: 'text/javascript', body: script });\n   103\t    });\n   104\t\n   105\t    const page = await context.newPage();\n   106\t    page.setDefaultTimeout(timeout);\n   107\t    page.on('pageerror', error => errors.push(String(error)));\n   108\t    page.on('console', message => {\n   109\t      const text = message.text();\n   110\t      const code = /\\[axylo (AX\\d+)\\]/.exec(text)?.[1];\n   111\t      if (code) addDiagnostic(code, { console: text }, 'console');\n   112\t    });\n   113\t    await page.goto(origin, { waitUntil: 'load', timeout });\n   114\t    const problem = await page.evaluate(() => window.rehearsalRender?.error ?? null);\n   115\t    const figure = page.locator('#chart figure');\n   116\t    let state = '';\n   117\t    if (!problem && errors.length === 0) {\n   118\t      await page.waitForFunction(() => new Promise(done => {\n   119\t        requestAnimationFrame(() => requestAnimationFrame(() => done(true)));\n   120\t      }));\n   121\t\n   122\t      if (await figure.count() === 1) {\n   123\t        const byName = page.getByRole('group', { name: expected.title, exact: true })\n   124\t          .or(page.getByRole('figure', { name: expected.title, exact: true }))\n   125\t          .or(page.getByRole('img', { name: expected.title, exact: true }));\n   126\t        const titlePass = await figure.and(byName).count() === 1;\n   127\t        const name = titlePass ? expected.title : (await figure.ariaSnapshot()).split('\\n')[0];\n   128\t        criteria.push(criterion('accessible name', titlePass, name || 'No accessible figure name.'));\n   129\t        state = (await figure.locator('.axylo-message:visible').allTextContents()).join(' ');\n   130\t        const description = (await figure.locator('.axylo-description').allTextContents())[0] ?? '';\n   131\t        const types = await figure.locator('[aria-roledescription]').evaluateAll(nodes =>\n   132\t          nodes.map(node => node.getAttribute('aria-roledescription')));\n   133\t        const observedType = (types.find(type => /^(?:line|area|bar|scatter|donut) chart$/i.test(type)) ?? description)\n   134\t          .match(/^(line|area|bar|scatter|donut) chart\\b/i)?.[1].toLowerCase();\n   135\t        criteria.push(criterion('chart type', observedType === expected.type,\n   136\t          `Expected ${expected.type}, saw ${observedType ?? 'no chart type'}.`));\n   137\t\n   138\t        const note = (await figure.locator('.axylo-note:visible').allTextContents()).join(' ');\n   139\t        const omission = /\\bValues not shown\\b/i.test(note);\n   140\t        const notePass = omission === (expected.valuesNotShown ?? false);\n   141\t        criteria.push(criterion('reader note', notePass, note || 'No values-omitted note.'));\n   142\t        try {\n   143\t          const button = figure.getByRole('button', { name: 'View as table', exact: true });\n   144\t          if (await button.count() === 1) {\n   145\t            await button.click();\n   146\t            const view = figure.getByRole('table');\n   147\t            if (await view.count() === 1 && await view.isVisible()) {\n   148\t              table = await view.evaluate(element => ({\n   149\t                headers: Array.from(element.tHead?.rows[0]?.cells ?? [], cell => cell.textContent.trim()),\n   150\t                rows: Array.from(element.tBodies[0]?.rows ?? [], row =>\n   151\t                  Array.from(row.cells, cell => cell.textContent.trim())),\n   152\t              }));\n   153\t            }\n   154\t          }\n   155\t          if (!table) {\n   156\t            criteria.push(criterion('table rows', false, 'Could not open one visible table with “View as table”.'));\n   157\t          } else if (await figure.getByRole('button', { name: 'Next page', exact: true }).count()) {\n   158\t            criteria.push(criterion('table rows', false, 'Unexpected additional table pages.'));\n   159\t          } else {\n   160\t            const compared = compareRows(expected, table.headers, table.rows);\n   161\t            criteria.push(criterion('table rows', compared.pass, compared.detail));\n   162\t          }\n   163\t        } catch (error) {\n   164\t          criteria.push(criterion('table rows', false, String(error)));\n   165\t        }\n   166\t      }\n   167\t    }\n   168\t\n   169\t    const handleDiagnostics = await page.evaluate(() => {\n   170\t      const result = window.rehearsalRender;\n   171\t      return result?.handle?.diagnostics ?? result?.diagnostics ?? [];\n   172\t    });\n   173\t    for (const { code, level, message } of handleDiagnostics) addDiagnostic(code,