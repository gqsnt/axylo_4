{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'cat -n rehearsal/test/grade.browser.test.mjs'","aggregated_output":"     1\timport { mkdtemp, rm, writeFile } from 'node:fs/promises';\n     2\timport { tmpdir } from 'node:os';\n     3\timport { join } from 'node:path';\n     4\timport { chromium } from 'playwright-core';\n     5\timport { afterAll, beforeAll, expect, it } from 'vitest';\n     6\timport { grade } from '../grade.mjs';\n     7\timport { prepareWorkspace } from '../workspace.mjs';\n     8\t\n     9\tconst visits = `import { line } from 'axylo';\n    10\texport default function render(element, data) {\n    11\t  return line(element, { data, x: { field: 'day', type: 'date' }, y: 'visits', title: 'Daily visits' });\n    12\t}`;\n    13\t\n    14\tconst sales = `import { bar } from 'axylo';\n    15\texport default function render(element, data) {\n    16\t  return bar(element, {\n    17\t    data, x: 'quarter', y: [\n    18\t      { field: 'north', parse: 'number' },\n    19\t      { field: 'central', parse: 'number' },\n    20\t      { field: 'west', parse: 'number' },\n    21\t    ], title: 'Quarterly sales by region',\n    22\t  });\n    23\t}`;\n    24\t\n    25\tconst signups = `import { line } from 'axylo';\n    26\texport default function render(element, data) {\n    27\t  return line(element, { data, x: 'day', y: 'signpus', title: 'Daily signups' });\n    28\t}`;\n    29\t\n    30\tconst revenue = `import { line } from 'axylo';\n    31\texport default function render(element, data) {\n    32\t  const rows = data.map(row => ({ ...row, revenue: Number(row.revenue) }));\n    33\t  return line(element, { data: rows, x: { field: 'day', type: 'date' }, y: 'revenue', title: 'Daily store revenue' });\n    34\t}`;\n    35\t\n    36\tconst LA = 'America/Los_Angeles';\n    37\tconst Tokyo = 'Asia/Tokyo';\n    38\tlet scratch;\n    39\tlet browser;\n    40\tbeforeAll(async () => {\n    41\t  scratch = await mkdtemp(join(tmpdir(), 'axylo-rehearsal-browser-'));\n    42\t  browser = await chromium.launch({ channel: 'chrome', headless: true, timeout: 15000 });\n    43\t});\n    44\tafterAll(async () => {\n    45\t  await browser?.close();\n    46\t  if (scratch) await rm(scratch, { recursive: true, force: true });\n    47\t});\n    48\t\n    49\tasync function answer(task, source) {\n    50\t  const { workspace } = await prepareWorkspace(scratch, task);\n    51\t  await writeFile(join(workspace, 'chart.js'), source);\n    52\t  // The tests reuse a Chrome process, while each grade still creates two clean contexts.\n    53\t  return grade(workspace, task, { launch: async () => ({ newContext: options => browser.newContext(options), close: async () => {} }) });\n    54\t}\n    55\t\n    56\tfunction criterion(result, name) {\n    57\t  return result.criteria.find(item => item.name === name);\n    58\t}\n    59\t\n    60\tit.each([\n    61\t  ['daily-visits', visits],\n    62\t  ['regional-sales', sales],\n    63\t  ['signups', signups],\n    64\t  ['daily-revenue', revenue],\n    65\t])('passes a hand-written %s answer in both time zones', async (task, source) => {\n    66\t  const result = await answer(task, source);\n    67\t  expect(result.criteria.filter(item => !item.pass)).toEqual([]);\n    68\t  expect(result.pass).toBe(true);\n    69\t  expect(result.timezones.map(zone => zone.timezoneId)).toEqual([LA, Tokyo]);\n    70\t});\n    71\t\n    72\tit('fails the calendar-day check in Los Angeles when midnight is treated as an instant', async () => {\n    73\t  const result = await answer('daily-visits', visits.replace(\"{ field: 'day', type: 'date' }\", \"'day'\"));\n    74\t  expect(result.pass).toBe(false);\n    75\t  expect(criterion(result.timezones[0], 'table rows')).toMatchObject({ pass: false, detail: expect.stringContaining('Feb 28, 2026') });\n    76\t  expect(criterion(result.timezones[1], 'table rows').pass).toBe(true);\n    77\t  expect(criterion(result, 'no error diagnostics').pass).toBe(true);\n    78\t  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX111', level: 'hint', sources: ['handle'] }));\n    79\t});\n    80\t\n    81\tit('accepts the documented automatic conversion of an all-decimal-string field', async () => {\n    82\t  const result = await answer('regional-sales', sales.replaceAll(\", parse: 'number'\", ''));\n    83\t  expect(result.criteria.filter(item => !item.pass)).toEqual([]);\n    84\t  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX104', level: 'hint', sources: ['handle'] }));\n    85\t});\n    86\t\n    87\tit('fails the rows and reader note when mixed numeric strings are left unparsed', async () => {\n    88\t  const result = await answer('daily-revenue', revenue.replace('data: rows', 'data'));\n    89\t  expect(criterion(result, 'table rows').pass).toBe(false);\n    90\t  expect(criterion(result, 'reader note').pass).toBe(false);\n    91\t  expect(criterion(result, 'no error diagnostics').pass).toBe(true);\n    92\t  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX106', level: 'warning' }));\n    93\t});\n    94\t\n    95\tit('fails the rows when absent days are filled with zero', async () => {\n    96\t  const result = await answer('daily-visits', visits.replace(\"y: 'visits'\", \"y: { field: 'visits', missing: 'zero' }\"));\n    97\t  expect(criterion(result, 'table rows')).toMatchObject({ pass: false, detail: expect.stringContaining('2026-03-06') });\n    98\t  expect(criterion(result, 'no error diagnostics').pass).toBe(true);\n    99\t});\n   100\t\n   101\tit('fails the diagnostics check when the missing field raises AX101', async () => {\n   102\t  const result = await answer('signups', signups.replace(\"y: 'signpus'\", \"y: 'signups'\"));\n   103\t  expect(criterion(result, 'no error diagnostics')).toMatchObject({ pass: false, detail: expect.stringContaining('AX101') });\n   104\t  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX101', level: 'error', sources: ['console', 'handle'] }));\n   105\t});\n   106\t\n   107\tit('fails an explicit chart error state even when Axylo emits no error code', async () => {\n   108\t  const result = await answer('signups', signups.replace(\"title: 'Daily signups'\",\n   109\t    \"title: 'Daily signups', state: { error: 'Signups could not load.' }\"));\n   110\t  expect(criterion(result, 'no error diagnostics')).toMatchObject({\n   111\t    pass: false, detail: expect.stringContaining('Signups could not load.'),\n   112\t  });\n   113\t  expect(result.diagnostics.filter(item => item.level === 'error')).toEqual([]);\n   114\t});\n   115\t\n   116\tit('fails the accessible name when Axylo uses a fallback', async () => {\n   117\t  const result = await answer('signups', signups.replace(\", title: 'Daily signups'\", ''));\n   118\t  expect(result.criteria.filter(item => !item.pass).map(item => item.name)).toEqual(['accessible name']);\n   119\t  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX140', level: 'warning' }));\n   120\t});\n   121\t\n   122\tit('fails the chart type when a bar is used for the signups line', async () => {\n   123\t  const result = await answer('signups', signups.replaceAll(/\\bline\\b/g, 'bar'));\n   124\t  expect(result.criteria.filter(item => !item.pass).map(item => item.name)).toEqual(['chart type']);\n   125\t});\n   126\t\n   127\tit.each([\n   128\t  ['export function render() {}', 'must default-export'],\n   129\t  ['export default function render() { throw new Error(\"render failed\"); }', 'render failed'],\n   130\t  ['export default function render() {}', 'must return the Axylo chart handle'],\n   131\t])('fails an invalid delivery (%s)', async (source, reason) => {\n   132\t  const result = await answer('daily-visits', source);\n   133\t  expect(criterion(result, 'render')).toMatchObject({ pass: false, detail: expect.stringContaining(reason) });\n   134\t});\n","exit_code":0,"status":"completed"}}
