nst row = observations.get(day);\n    33\t      return [day, ...keys.map(key => row ? Number(row[key]) : null)];\n    34\t    }));\n    35\t    if (missing.length) {\n    36\t      expect(data.map(row => row.day)).not.toEqual(data.map(row => row.day).sort());\n    37\t      expect(data.every(row => row.day.endsWith('T00:00:00Z'))).toBe(true);\n    38\t    }\n    39\t  });\n    40\t\n    41\t  it('accepts formatted numbers and omitted gaps, and rejects a zero substituted for any gap', () => {\n    42\t    fc.assert(fc.property(fc.array(fc.integer({ min: -1000000, max: 1000000 }), { minLength: 1, maxLength: 12 }), values => {\n    43\t      const expected = {\n    44\t        x: 'category', series: ['sales'],\n    45\t        rows: [['Missing', null], ...values.map((value, i) => [String(i), value])],\n    46\t      };\n    47\t      const headers = ['Quarter', 'Sales'];\n    48\t      const format = new Intl.NumberFormat('en-US');\n    49\t      const displayed = values.map((value, i) => [String(i), format.format(value)]);\n    50\t      expect(compareRows(expected, headers, displayed).pass).toBe(true);\n    51\t      expect(compareRows(expected, headers, [['Missing', 'No data'], ...displayed]).pass).toBe(true);\n    52\t      expect(compareRows(expected, headers, [['Missing', '0'], ...displayed]).pass).toBe(false);\n    53\t    }));\n    54\t  });\n    55\t\n    56\t  it('compares the printed day without moving an instant back to UTC', () => {\n    57\t    const expected = { x: 'date', series: ['sales'], rows: [['2026-03-01', 1250.5]] };\n    58\t    const headers = ['Day', 'Sales'];\n    59\t    expect(compareRows(expected, headers, [['Mar 1, 2026, 9:00 AM GMT+9', '1,250.50']]).pass).toBe(true);\n    60\t    expect(compareRows(expected, headers, [['Feb 28, 2026, 4:00 PM PST', '1,250.5']])).toEqual({\n    61\t      pass: false, detail: 'Row 1 expected [\"2026-03-01\",1250.5], saw [\"Feb 28, 2026, 4:00 PM PST\",\"1,250.5\"].',\n    62\t    });\n    63\t  });\n    64\t});\n","exit_code":0,"status":"completed"}}
