{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'cat -n rehearsal/table.mjs'","aggregated_output":"     1\tconst months = ['january', 'february', 'march', 'april', 'may', 'june',\n     2\t  'july', 'august', 'september', 'october', 'november', 'december'];\n     3\t\n     4\tfunction calendarDate(text) {\n     5\t  const suffix = '(?=$|[T,\\\\s])';\n     6\t  const iso = new RegExp('^(\\\\d{4})-(\\\\d{2})-(\\\\d{2})' + suffix).exec(text);\n     7\t  if (iso) return iso[0];\n     8\t  const numeric = new RegExp('^(\\\\d{1,2})/(\\\\d{1,2})/(\\\\d{4})' + suffix).exec(text);\n     9\t  const words = new RegExp('^([a-z]+)\\\\.? (\\\\d{1,2}),? (\\\\d{4})' + suffix, 'i').exec(text);\n    10\t  const month = words?.[1].toLowerCase();\n    11\t  const number = numeric?.[1] ?? (months.findIndex(name => name === month || name.slice(0, 3) === month) + 1);\n    12\t  const [day, year] = (numeric ?? words ?? []).slice(2);\n    13\t  if (!number || !year) return null;\n    14\t  // Reading the visible calendar day must not convert the printed time back to UTC.\n    15\t  return `${year}-${String(number).padStart(2, '0')}-${day.padStart(2, '0')}`;\n    16\t}\n    17\t\n    18\tfunction cellValue(text, unit) {\n    19\t  if (unit && text.endsWith(' ' + unit)) text = text.slice(0, -(unit.length + 1)).trim();\n    20\t  if (text === 'No data') return null;\n    21\t  const number = text.replace(/^−/, '-').replace(/^([+-]?)\\p{Sc}\\s*/u, '$1');\n    22\t  if (/^[+-]?(?:(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?$/i.test(number)) {\n    23\t    return Number(number.replaceAll(',', ''));\n    24\t  }\n    25\t  return undefined;\n    26\t}\n    27\t\n    28\texport function compareRows(expected, headers, rows) {\n    29\t  const columns = expected.series.length + 1;\n    30\t  if (headers.length !== columns) {\n    31\t    return { pass: false, detail: `Expected ${columns} columns, saw ${headers.length}.` };\n    32\t  }\n    33\t  const order = columns === 2 ? [1] : expected.series.map(name =>\n    34\t    headers.findIndex((label, index) => index > 0 && label.toLowerCase().replace(/ \\([^)]+\\)$/, '') === name));\n    35\t  if (order.includes(-1)) {\n    36\t    return { pass: false, detail: `Expected columns for ${expected.series.join(', ')}, saw ${JSON.stringify(headers.slice(1))}.` };\n    37\t  }\n    38\t  const units = order.map(column => / \\(([^)]+)\\)$/.exec(headers[column])?.[1]);\n    39\t  let index = 0;\n    40\t  for (const [x, ...values] of expected.rows) {\n    41\t    const row = rows[index];\n    42\t    const displayedX = row?.length && (expected.x === 'date' ? calendarDate(row[0]) : row[0]);\n    43\t    if (displayedX !== x && values.every(value => value === null)) continue;\n    44\t    if (!row || row.length !== columns || displayedX !== x ||\n    45\t        values.some((value, i) => value !== cellValue(row[order[i]], units[i]))) {\n    46\t      return { pass: false, detail: `Row ${index + 1} expected ${JSON.stringify([x, ...values])}, saw ${JSON.stringify(row ?? null)}.` };\n    47\t    }\n    48\t    index++;\n    49\t  }\n    50\t  if (index < rows.length) {\n    51\t    return { pass: false, detail: `Unexpected row ${index + 1} ${JSON.stringify(rows[index])}.` };\n    52\t  }\n    53\t  return { pass: true, detail: `${rows.length} rows match.` };\n    54\t}\n","exit_code":0,"status":"completed"}}
