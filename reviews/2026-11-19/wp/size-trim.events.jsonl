full and script-tag cases, CSS included (DX7).\n383:| Packed distribution | Clean install fixtures | What users actually get (DX1, DX7, DX8, DX10). |\nAGENTS.md\nacceptance/test/fixtures/chart.browser.test.ts\ntests/dist/text.browser.test.ts\ntests/dist/flavours.browser.test.ts\napps/docs/vitest.config.ts\ntests/dist/first-chart.browser.test.ts\ntests/dist/csp.browser.test.ts\ntests/dist/vitest.config.ts\ntests/dist/lifecycle.browser.test.ts\napps/docs/test/examples.browser.test.ts\napps/docs/test/site.browser.test.ts\napps/docs/test/node.browser.test.ts\napps/docs/test/diagnostics.browser.test.ts\napps/docs/test/theme.browser.test.ts\napps/docs/test/defaults.browser.test.ts\npackages/axylo/test/browser/a11y/keyboard.browser.test.ts\npackages/axylo/test/browser/a11y/axe.browser.test.ts\nvitest.config.ts\npackages/axylo/test/browser/chart/final-closing.browser.test.ts\npackages/axylo/test/browser/chart/plot-description.browser.test.ts\npackages/axylo/test/browser/chart/interaction.browser.test.ts\npackages/axylo/test/browser/chart/final-round3.browser.test.ts\npackages/axylo/test/browser/chart/final-range.browser.test.ts\npackages/axylo/test/browser/chart/review4.browser.test.ts\npackages/axylo/test/browser/chart/final-hold.browser.test.ts\npackages/axylo/test/browser/chart/scale.browser.test.ts\npackages/axylo/test/browser/chart/review5.browser.test.ts\npackages/axylo/test/browser/chart/late-font.browser.test.ts\npackages/axylo/test/browser/chart/loadingdone.browser.test.ts\npackages/axylo/test/browser/chart/node.browser.test.ts\npackages/axylo/test/browser/chart/review2.browser.test.ts\npackages/axylo/test/browser/chart/final-pin.browser.test.ts\npackages/axylo/test/browser/chart/reattach.browser.test.ts\npackages/axylo/test/browser/chart/review.browser.test.ts\npackages/axylo/test/browser/chart/review3.browser.test.ts\npackages/axylo/test/browser/chart/final-verify.browser.test.ts\npackages/axylo/test/browser/chart/review6.browser.test.ts\npackages/axylo/test/browser/chart/lifecycle.browser.test.ts\npackages/axylo/test/browser/chart/final-partials.browser.test.ts\npackages/axylo/test/browser/chart/theme.browser.test.ts\npackages/axylo/test/browser/chart/data.browser.test.ts\npackages/axylo/test/browser/chart/render.browser.test.ts\npackages/axylo/test/browser/acceptance/a6-a10.browser.test.ts\npackages/axylo/test/browser/acceptance/compact.browser.test.ts\npackages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts\npackages/axylo/test/browser/acceptance/a4-table.browser.test.ts\npackages/axylo/test/browser/acceptance/f12-note.browser.test.ts\npackages/axylo/test/browser/acceptance/a1-names.browser.test.ts\npackages/axylo/test/browser/acceptance/f8-donut.browser.test.ts\npackages/axylo/test/browser/acceptance/type-matrix.browser.test.ts\npackages/axylo/test/browser/acceptance/negative-controls.browser.test.ts\npackages/axylo/test/browser/acceptance/f2-gaps.browser.test.ts\npackages/axylo/test/browser/acceptance/a2-keyboard.browser.test.ts\npackages/axylo/test/browser/acceptance/a5-not-colour-alone.browser.test.ts\npackages/axylo/test/browser/acceptance/l-legibility.browser.test.ts\npackages/axylo/test/browser/render/render.browser.test.ts\npackages/axylo/test/browser/render/theme.browser.test.ts\npackages/axylo/test/browser/render/timing.browser.test.ts\npackages/axylo/test/browser/render/text.browser.test.ts\npackages/axylo/test/browser/render/review.browser.test.ts\npackages/axylo/test/browser/render/pending-css.browser.test.ts\npackages/axylo/test/browser/render/scheme.browser.test.ts\n15:// from a fixture could fall back to them for anything it did not install. `fixtureGuard` (esbuild) and\n54:export function fixtureGuard(roots) {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '85,206p' reviews/2026-11-18/impl/wp/size2.analysis.md && sed -n '252,310p' reviews/2026-11-18/impl/wp/size2.analysis.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '85,206p' reviews/2026-11-18/impl/wp/size2.analysis.md && sed -n '252,310p' reviews/2026-11-18/impl/wp/size2.analysis.md\"","aggregated_output":"### 2. Instrumentation- and test-only members out of production (class a)\n\n**What.** esbuild keeps every member of a class it keeps, so methods that only `core/instrument.ts` or tests call still ship. Found with the TypeScript language service (references that are not in instrument.ts) and confirmed by grep:\n\n- **The P7 byte counting:**\n  - `count(bytes: ByteCount…)` in `data/store.ts:146`, `data/store-buffers.ts:208`, `data/store-window.ts:141`, `data/store-rows.ts:156,341,437,479` and `data/store-unaligned.ts:39,209,246`\n  - `ownedBytes` in `data/store.ts:530` and `data/store-unaligned.ts:351`\n  - the `CallerBuffers` field and its `add` calls in `data/store.ts:473,484` and `data/store-unaligned.ts:313,324,462`\n  - the `lazyColumns.set` registry in `data/store-buffers.ts:257`\n\n  With these gone, `data/store-bytes.ts` leaves the bundle. The `caller.add` bookkeeping also runs at run time in production today.\n- **The stores' test conveniences:** `append`, `replace`, `prepareReplace` and `reencode`, and the `diagnostics` getter, in `data/store.ts:518,594,604,610,981` and `data/store-unaligned.ts:342,368,443,453,459`. The controller uses `prepareAppend`, `prepareReencode`, `resolveEncoding`, `retire`, `frame` and `retainedRowCount`; nothing in production calls the listed ones.\n- **`Delivery.deliver`**, `core/delivery.ts:50`, which only `test/core/delivery.test.ts` calls.\n\n**Measured.** All of these deleted in a scratch copy: −1,132 / −890 B (`store-bytes` 1,123 min B, store classes about 1,700 min B, delivery 163).\n\n**How to ship it.** Do not delete these members. Gate them with `__DEV__ || __BENCH__`: define the methods on the prototype inside such a block, or move them into instrument.ts as functions that read the stores. The tests and the bench `memory()` probe keep working, and production folds the block away.\n\nSmaller items of the same kind were not measured and amount to tens of bytes:\n\n- `TableView.showRow` and `get page` (`dom/table.ts:203,220`)\n- `TooltipView.where` (`dom/tooltip.ts:342`)\n- scatter's `lastPick*` and `comparisons` getters (`lookup/scatter.ts:23,213`)\n\n### 3. Module order (class a, fragile)\n\n**What.** The order of modules inside `axylo.js` follows import order. Consumer bundlers keep the order of a prebundled file. Because no module does work at import time (`tests/dist/tree-shaking.test.ts` checks this), reordering imports changes bytes, not behaviour.\n\n**Measured.** Over 20 seeded orders of the import blocks in `index.ts`, `core/chart.ts`, `core/controller.ts`, `dom/interaction.ts`, `kinds/line.ts` and `core/stages.ts`:\n\n| Build | Everything | Line |\n|---|---|---|\n| Base | 116,802–118,323 B (median 117,618; current 117,748) | 98,136–99,275 B (median 98,614; current 99,167) |\n| Class (a) | 113,034–114,338 B (current 113,963) | 94,974–96,014 B (current 96,013) |\n\nThe best order saved about −0.93 / −1.0 KB in both builds.\n\n**Cost.** The best order changes after any code change, so the saving is not durable unless the release build searches for it each time, for example by trying N orders with an `onLoad` plugin that sorts hub imports by a recorded seed. Ranked last among the class (a) items for that reason.\n\n### 4. Exact duplicates (class a)\n\nMerged in a scratch copy:\n\n- `once`: `format/time.ts:73` and `format/number.ts:140`\n- `sameRemainder`: `data/store-rows.ts:5` and `data/store.ts:160`\n- `pageDistance`: `core/focus.ts:42` and `lookup/search.ts:19`\n- `setText`: `dom/figure.ts:81` and `dom/tooltip.ts:104`, moved to `dom/attributes.ts`\n- `object`: `core/stages.ts:17` and `data/options.ts:112`\n- `lowerBound`: `data/store-unaligned.ts:18` and `lookup/search.ts:1`. This one needs a neutral module, because `test/data/review.test.ts` forbids data importing lookup.\n- `sameStyle` in `core/controller.ts:1973`, which is `sameTextStyle` in `core/environment.ts:144` without the null check\n\nMeasured −104 / −54 B. Gzip already finds most repeated code. Worth doing for maintenance, not for size.\n\n### 5. CSS minifier (class a)\n\n`theme/minify.ts` keeps the space after `:` and after selector commas. esbuild's CSS minifier removes them and merges the duplicate rules:\n\n- `.axylo-legend-choice` at `theme/css.ts:206,209`\n- `.axylo-jump` at `theme/css.ts:314,320`\n\n14,280 → 13,774 B as text, 2,970 → 2,922 B gzip as a file. In the JavaScript: −64 / −60 B. `test/theme/minify.test.ts` compares rule trees, so merged rules would fail it, and the docs guard compares `axylo.css` to `minifyCss(AXYLO_CSS)`. Small. The duplicate rules could simply be removed from `css.ts` by hand.\n\n### 6–8. Per-kind composition of the remaining inline branches (class b)\n\n**Why line is still 84% of everything.** \"Everything\" adds 18.6 KB gzip of code that only other kinds use:\n\n| Module | Minified bytes |\n|---|---:|\n| point and donut stores (`store-unaligned`) | 9.5 K |\n| scatter grid, lookup and point order | 10.5 K |\n| donut lookup, view, geometry and the slice list in `interaction` | 6.7 K |\n| area and bar scenes | 5.0 K |\n| other kinds' mark painters in `svg.ts` and `canvas.ts` | 6.7 K |\n| point and donut normalization | 2.6 K |\n| other table builders | 2.0 K |\n\nThe rest of line's 282 KB minified is code that a line chart can reach. By area: streaming storage 14.8%, controller 10.8%, interaction 10.7%, other DOM (tooltip, table, toolbar, placement, figure) 9.3%, data 8.3%, core helpers 6.9%, layout and axes 6.6%, scales and formatting 6.3%, stylesheet 5.1%.\n\nWhat line carries but cannot reach at run time was measured by removing it:\n\n- inline kind and shape branches: −3,948 to −4,080 B\n- other kinds' tables: −345 B\n- canvas, which only the private `__renderer` reaches: −1,414 to −1,676 B\n- instrumentation and test-only members: −871 to −925 B\n\nTogether that is about 6.6–7.0 KB.\n\n**#6, what and measured upper bound.** The previous restructuring left these as inline tests on `view.kind`, `frame.shape`, the datum and target kind (`'point'`, `'slice'`) and the projection (`'bands'`, `'ring'`). A codemod folded all 249 of them to what a line chart can be. In minified bytes, per module:\n\n| Module | Minified B | What line cannot reach |\n|---|---:|---|\n| `core/controller.ts` | 3,209 | `positionValue`, `zoomable`, `isWall`, `latestX` (203–247), `freeze` (821), `followLatest` (860), `themeKeys` (1053), `formatSpec` and `pointDateUnit` (1112, 1945), `pointFor` (1705), `renamed` (1927), `pointIndex` (1983), `hasData` (2016) |\n| `dom/interaction.ts` | 2,410 | `categoriesOf` and `xKindOf` (352–357), donut and scatter keys, swatches and steps (642–700, 925–1061), `horizontalBars` (1277–1301), table-jump columns (1606–1613) |\n| `core/axes.ts` | 1,749 | |\n| `core/focus.ts` | 1,391 | |\n| `lookup/aligned.ts` | 973 | the bands projection |\n| `view/stack.ts` | 703 | stacks |\n| `stages`, `layout`, `view`, `reader`, `pointer`, `scene`, `options` | about 200–400 each | |\n\nMeasured on line: −3,948 B, from 99,167 to 95,219. This is an upper bound: it also folds the bar-only tests inside code that all aligned kinds share.\n\n**#7, calibration, done for real.** `core/axes.ts` was split: the scatter axis parts, extent, titles and layout-key tail went into `SCATTER_AXES`, the rest into `ALIGNED_AXES`, and `AxisContext.axes` was filled from the composition.\n\n- Line: −273 B, against −440 for an oracle that folds only `axes.ts`, so 62% of the oracle.\n- Everything: +46 B (paired +25…+143), the cost of indirection.\n- By-product: donut −4,725 B, because donut stops carrying the cartesian axis builder and tick generation that `layoutInput` statically reached. Confirmed per module: `scale/time` 5,080, `core/axes` 4,494, `scale/linear` 1,145, `format/number` 867 and `scale/nice` 703 min B leave the donut bundle. Scatter −559 B.\n\nScaled to the whole oracle, about 55–65% captured, the *estimate* for #6 is −2,100…−2,500 B on line. With six to ten such module splits, the *estimate* for everything is +300…+600 B.\n\n**#8.** Other kinds' tables in line:\n\n- the option lists of area, bar, scatter and donut (`data/options.ts:46–57`)\n- the registry entries AX120, AX121, AX132 and AX133 (`diagnostics/registry.ts:106–123`)\n- the default texts line never shows (`messages/index.ts`: `otherSlices`, `type*`, `donutSummary`, `incomplete*`, `totalMixed`, `percentage`, `category`)\n\nMeasured −345 B on line. The keys of `Messages` must stay, because `messages` options are validated against `Object.keys(defaultMessages)`.\n\n**#9 (donut, not a target row).** The donut table's `pageForX` (`reader/table.ts:115`) and the interaction's `jumpTarget` (`dom/interaction.ts:1615`) call `readPosition` (`reader/x.ts:9`). It parses a typed value by normalizing a one-row *line* chart, so the donut bundle carries `normalizeAligned`, the x parser, steps and store diagnostics, though a donut only ever needs the category branch. Fix: a `categoryPosition` for the donut table, and `readPosition` passed through `InteractionParts` (null for donut). Measured donut −6,182 B, from 86,539 to 80,357. No effect on everything or line: +16 / +15 B paired median. The −419 / −494 B seen at the current order was module-order noise.\n\n### 10–17. Class (c) options: what the user would lose\n\n**#10, streaming opt-in (−15,834 / −12,918; on top of (a) −13,917 / −11,361).**\n## What I looked at and found not worth doing (measured)\n\n- **Development-only code in the production file.** Nothing behind `__DEV__` or `__BENCH__` survives: no `__dev`, `__bench`, `__AXYLO_BENCH__`, `StageCounter` or bench strings in the built output. What does survive is the unguarded instrumentation in #2.\n- **Minifier settings:**\n  - `target: 'esnext'` makes no difference.\n  - `es2020` adds 241 / 241 B.\n  - `drop: ['console', 'debugger']` saves 0 B: there is no direct `console.*`, and the console is injected for diagnostics on purpose.\n  - Only 14 `\\u` escapes in the output, so `charset: 'utf8'` would gain nothing, and the consumer's bundler re-escapes anyway.\n- **Option-name lists** as `/* @__PURE__ */ 'a b c'.split(' ')`: −3 / −6 B. The lists cost 173 B in total, because their repeats compress.\n- **Registry entry keys** shortened to one letter (what a tuple encoding would save): −21 / −22 B. Mangling already shortens `text` and `outcome`.\n- **Classes and closures.** The two giant closures (`controllerFor`, `createInteraction`) minify well: their inner names are renamed. The classes' cost is in their property names, which #1 addresses. Converting TypeScript `private` to `#private` would only duplicate #1.\n- **Near-duplicates** in `dom/`, `core/`, `lookup/` and `data/` beyond #4 are different functions: `sameRect` with tolerance, `withUnit` in format against the reader one with scale handling, the two `rule` helpers.\n\n## Method and reproduction\n\n**The pipeline.**\n\n1. Copy `packages/axylo/src` into the project. This used `.scratch-size/<variant>`, now removed.\n2. Build `<variant>/index.ts` with esbuild 0.28.2 as `scripts/build.mjs` builds `dist/axylo.js`:\n   - `bundle`, `esm`, `es2022`, `minify`, `legalComments: 'none'`\n   - `define: { __DEV__: 'false', __BENCH__: 'false' }`\n   - an `onLoad` plugin that replaces the variant's `theme/css.ts` with `minifyCss(AXYLO_CSS)` as a literal, both evaluated from the variant, as `stylesheetPlugin` does.\n3. Build each consumer row from that file as `scripts/size.mjs` does: stdin `export * from 'axylo'`, the fixture's `example/npm.ts` for line, `export { <kind> } from 'axylo'` for the others. Settings: `bundle`, `minify`, `esm`, `es2022`, `conditions: ['production']`, with a resolve plugin that maps `axylo` to the built file.\n4. Gzip with `zlib` at level 9.\n\nThe unmodified copy built byte-identical to `packages/axylo/dist/axylo.js` and gave exactly the brief's rows. `scripts/size.mjs` itself was not run, because it writes `bench/size-latest.json`. Per-module minified bytes come from a one-step metafile build of the consumer against the source.\n\n**Edits per variant**, all asserted to match. Rebuild them in a copy to reproduce:\n\n| Variant | Edits |\n|---|---|\n| mangling | `mangleProps` built from the classification in #1 |\n| dead members | the members in #2 deleted |\n| duplicates | the seven merges in #4 |\n| CSS | `transformSync(css, { loader: 'css', minify: true })` |\n| oracle | every `X.kind`, `kind` or `type` compared with `'donut'`, `'scatter'`, `'bar'` or `'area'`, and `X.shape` with `'points'` or `'donut'`, `X.kind` with `'point'`, `'slice'`, `'bands'` or `'ring'`, replaced by the constant a line chart gives. Positive tests on `'line'`, `'aligned'` and `'xy'` too, unless the receiver uses `?.` |\n| no canvas | `core/chart.ts:66,69` guarded by `__DEV__ \\|\\| __BENCH__`, and each `kinds/*.ts` `canvas:` table replaced by `{}` outside those builds |\n| no streaming | `append` body emptied, `openStore` removed from the compositions |\n| no table | reader `table` parts null, table call short-circuited, interaction `jumpTarget`, `openTable`, `closeTable`, `renderTable` and `cellRuns` stubbed |\n| no zoom | interaction's zoom functions stubbed, `d.zoom` and `d.zoomed` folded to false, controller `zoom()` emptied, `zoomOn` false |\n| text | the literals inside `diagnosticRegistry` (levels kept) or `defaultMessages` blanked |\n\n**Paired order deltas.** The import declarations of the six hub modules were sorted by an FNV hash of seed and specifier, the same way in both variants, for seeds 0–5. Seed 0 is the current order.\n\nThe measurement scripts are in `/tmp/claude-1000/-home-canarit-projects-axylo/23402a37-81bb-469c-a14a-8bf7f048d066/scratchpad/size2-scripts/`. That directory is wiped at the next restart; everything needed to redo the work is described above.\n\n**What I did not run or verify:**\n\n- No browser test, no `npm run build`, no unit test. No source was changed, so none was needed.\n- The mangled builds were checked only by `validate()` in Node.\n- No variant was type-checked except base and the class (a) combination. Its one error is the expected one: instrument.ts still names the removed `ownedBytes`, which the real change would gate instead of deleting.\n- The class (c) ablations remove code paths to price a feature. They are not designs, and an opt-in module needs some registration code of its own that was not measured.\n- 91adfe7 and the uncommitted work in `packages/axylo/src` at the end of the run are newer than the anchor. Only the class (a) combination, streaming, canvas, table, the CSS file, the line oracle and the axes split were re-measured on 91adfe7. The uncommitted state measured 119,500 / 99,803 B and was not analysed.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/test/browser/chart/plot-description.browser.test.ts && sed -n '1,200p' packages/axylo/src/messages/index.ts && rg -n 'plotInstructions|donutInstructions|seriesInstructions|zoomInstructions|Shift and arrow|Shift\\\\+Arrow|Shift\\\\+arrows' packages/axylo/test tests/dist docs/decisions docs/api packages/axylo/src/public.ts && sed -n '350,368p' docs/03-plan-typescript-release.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/test/browser/chart/plot-description.browser.test.ts && sed -n '1,200p' packages/axylo/src/messages/index.ts && rg -n 'plotInstructions|donutInstructions|seriesInstructions|zoomInstructions|Shift and arrow|Shift\\\\+Arrow|Shift\\\\+arrows' packages/axylo/test tests/dist docs/decisions docs/api packages/axylo/src/public.ts && sed -n '350,368p' docs/03-plan-typescript-release.md\"","aggregated_output":"import { afterAll, beforeAll, expect, it } from 'vitest';\nimport type { Page } from 'playwright-core';\nimport { start, stop } from '../harness';\nimport { create, settle } from './final-util';\nimport { chartPage, closePage } from './util';\n\nbeforeAll(start);\nafterAll(stop);\n\nconst POINTS = 'Left and right arrows move between points along x. Enter selects.';\nconst SLICES = 'Arrow keys move between slices. Enter selects.';\nconst SERIES = 'Up and down arrows move between series.';\nconst ZOOM = 'Plus and minus zoom. Press 0 to reset. Hold Shift with left or right to pan the zoomed view.';\nconst line = { title: 'Trend', x: 'x', y: 'y', data: [1, 2, 3, 4].map(x => ({ x, y: 2 * x })) };\nconst twoSeries = { ...line, series: 's', data: line.data.flatMap(row => [{ ...row, s: 'A' }, { ...row, s: 'B', y: row.y + 1 }]) };\nconst bar = { ...line, title: 'By quarter', data: line.data.map(row => ({ ...row, x: `Q${row.x}` })) };\nconst donut = { title: 'Slices', label: 'label', value: 'y', data: [{ label: 'A', y: 2 }, { label: 'B', y: 4 }] };\n\nconst plot = (page: Page) => page.locator('#chart .axylo-proxy');\nconst zoomIn = (page: Page) => page.getByRole('button', { name: 'Zoom in', exact: true });\nconst description = (page: Page) => plot(page).evaluate(el => document.getElementById(el.getAttribute('aria-describedby') ?? '')?.textContent);\n\nit.each([\n  ['line with two series', 'line', twoSeries, `${POINTS} ${SERIES} ${ZOOM}`, true],\n  ['line with one series', 'line', line, `${POINTS} ${ZOOM}`, true],\n  ['category bar', 'bar', bar, POINTS, false],\n  ['donut', 'donut', donut, SLICES, false],\n] as const)('%s describes the keys its plot offers (A2, I3)', async (_name, kind, options, expected, zoom) => {\n  const page = await chartPage();\n  await create(page, kind, options);\n  expect(await description(page)).toBe(expected);\n  expect(await zoomIn(page).count()).toBe(zoom ? 1 : 0);\n  expect(await closePage(page)).toEqual([]);\n});\n\nit('updates zoom help in both directions without rewriting the focused datum’s value text', async () => {\n  const page = await chartPage();\n  await create(page, 'line', twoSeries);\n  await plot(page).focus();\n  expect(await description(page)).toBe(`${POINTS} ${SERIES} ${ZOOM}`);\n\n  for (const zoom of [false, true]) {\n    const valueTextWrites = await plot(page).evaluate(async (el, zoom) => {\n      const changes: MutationRecord[] = [];\n      const observer = new MutationObserver(records => changes.push(...records));\n      observer.observe(el, { attributes: true, attributeFilter: ['aria-valuetext'] });\n      window.charts[0]!.update({ zoom });\n      await window.charts[0]!.__bench.ready();\n      await window.nextFrames(2);\n      changes.push(...observer.takeRecords());\n      observer.disconnect();\n      return changes.length;\n    }, zoom);\n    expect(await description(page)).toBe(zoom ? `${POINTS} ${SERIES} ${ZOOM}` : `${POINTS} ${SERIES}`);\n    expect(await zoomIn(page).count()).toBe(zoom ? 1 : 0);\n    expect(await plot(page).evaluate(el => el === document.activeElement)).toBe(true);\n    expect(valueTextWrites).toBe(0);\n  }\n  expect(await closePage(page)).toEqual([]);\n});\n\nit('removes and restores the series instructions as the legend hides and shows a series', async () => {\n  const page = await chartPage();\n  await create(page, 'line', twoSeries);\n  const series = page.getByRole('button', { name: 'B', exact: true });\n  expect(await description(page)).toBe(`${POINTS} ${SERIES} ${ZOOM}`);\n  await series.press('Space');\n  await settle(page);\n  expect(await series.getAttribute('aria-pressed')).toBe('false');\n  expect(await description(page)).toBe(`${POINTS} ${ZOOM}`);\n  await series.press('Space');\n  await settle(page);\n  expect(await series.getAttribute('aria-pressed')).toBe('true');\n  expect(await description(page)).toBe(`${POINTS} ${SERIES} ${ZOOM}`);\n  expect(await closePage(page)).toEqual([]);\n});\n\nit('preserves a legacy translation and marks built-in instruction sentences as English (A10)', async () => {\n  const page = await chartPage();\n  await page.evaluate(() => { document.documentElement.lang = 'de'; });\n  await create(page, 'line', { ...twoSeries, messages: { plotInstructions: 'Eigene Tastaturhilfe.' } });\n  expect(await description(page)).toBe('Eigene Tastaturhilfe.');\n  await page.evaluate(() => window.charts[0]!.update({ messages: { seriesInstructions: 'Mit den Pfeiltasten die Reihe wechseln.' } }));\n  await settle(page);\n  expect(await description(page)).toBe(`${POINTS} Mit den Pfeiltasten die Reihe wechseln. ${ZOOM}`);\n  const languages = await plot(page).evaluate(el => {\n    const instructions = document.getElementById(el.getAttribute('aria-describedby') ?? '');\n    return Array.from(instructions?.children ?? [], part => part.closest('[lang]')?.getAttribute('lang'));\n  });\n  expect(languages).toEqual(['en', 'de', 'en']);\n  expect(await closePage(page)).toEqual([]);\n});\nimport type { DatumRef, Formatters, Lookup } from '../core/contracts';\nimport type { Messages } from '../public';\n\nconst chartSummary = '{type} chart with {seriesCount} series. {xLabel} from {xMin} to {xMax}.';\n// chartSummary and the range, written out: no work at import time.\nconst fullChartSummary = '{type} chart with {seriesCount} series. {xLabel} from {xMin} to {xMax}. {yLabel} from {yMin} to {yMax}.';\nconst donutSlice = '{label}: {value} ({percent}).';\n\nexport const defaultMessages: Required<Messages> = {\n  viewAsTable: 'View as table',\n  hideTable: 'Hide table',\n  noData: 'No data',\n  noObservation: 'No observation',\n  incompleteStack: 'incomplete',\n  moreRows: '+{count} more',\n  otherSlices: 'Other ({count})',\n  valuesNotShown: 'Values not shown: {count}. {seeTable}',\n  valuesChanged: 'Values shown differently from the data: {count}. {seeTable}',\n  labelsHidden: 'Some labels hidden. {seeTable}',\n  loading: 'Loading chart.',\n  empty: 'No data to show.',\n  error: 'The chart could not be drawn.',\n  internalError: 'Something went wrong while drawing the chart.',\n  chartName: '{type} chart of {y} by {x}',\n  chartSummary: fullChartSummary,\n  seriesSummary: '{series}: minimum {min}, maximum {max}, last {last}.',\n  timeZoneNote: 'Times are shown in {zone}.',\n  plotLabel: 'Chart plot',\n  controlsLabel: 'Chart controls',\n  pointOf: '{series}, {x}, {value}. Point {index} of {count}.',\n  zoomIn: 'Zoom in',\n  zoomOut: 'Zoom out',\n  resetZoom: 'Reset zoom',\n  pause: 'Pause',\n  resume: 'Resume',\n  previousPage: 'Previous page',\n  nextPage: 'Next page',\n  pageOf: 'Page {page} of {count}',\n  jumpToX: 'Jump to {x}',\n  category: 'Category',\n  percentage: 'Percentage',\n  series: 'Series',\n  value: 'Value',\n  typeLine: 'Line',\n  typeArea: 'Area',\n  typeBar: 'Bar',\n  typeScatter: 'Scatter',\n  typeDonut: 'Donut',\n  donutSummary: '{type} chart with {count} slices. Total {total}.',\n  seriesNoData: '{series}: no data.',\n  seriesNotDrawn: '{series} could not be drawn. {seeTable}',\n  referenceLine: 'Reference line {label} at {from}.',\n  referenceBand: 'Reference band {label} from {from} to {to}.',\n  plotRole: '{type} chart',\n  pointAll: '{x}. {values}. {position}',\n  seriesValue: '{series} {value}',\n  position: 'Point {index} of {count}',\n  total: 'Total',\n  panLeft: 'Pan left',\n  panRight: 'Pan right',\n  jumpNotFound: 'No row matches {x}. Example: {example}',\n  plotInstructions: 'Left and right arrows move between points along x. Enter selects.',\n  donutInstructions: 'Arrow keys move between slices. Enter selects.',\n  seriesInstructions: 'Up and down arrows move between series.',\n  zoomInstructions: 'Plus and minus zoom. Press 0 to reset. Hold Shift with left or right to pan the zoomed view.',\n  selectRange: 'Select range',\n  seeTable: 'See table.',\n  totalMixed: '{positive} and {negative}',\n  incompleteAt: '{label}: incomplete at {positions}.',\n  incompleteCount: '{label}: {count} incomplete stacks.',\n};\n\nexport function fill(template: string, values: Readonly<Record<string, string | number>>): string {\n  return template.replace(/\\{(\\w+)\\}/g, (placeholder: string, name: string) =>\n    Object.hasOwn(values, name) ? String(values[name]) : placeholder,\n  );\n}\n\nconst authoredMessages = new WeakMap<Messages, ReadonlySet<keyof Messages>>();\n\nexport function resolveMessages(overrides?: Partial<Messages> | null): Messages {\n  const messages = { ...defaultMessages };\n  const authored = new Set<keyof Messages>();\n  for (const key of Object.keys(messages) as (keyof Messages)[]) {\n    const value = overrides?.[key];\n    if (value == null) continue;\n    messages[key] = value;\n    authored.add(key);\n  }\n  authoredMessages.set(messages, authored);\n  return messages;\n}\n\nexport function messageLanguage(messages: Messages, key: keyof Messages): 'en' | null {\n  return (messages[key] ?? defaultMessages[key]) === defaultMessages[key] && !authoredMessages.get(messages)?.has(key) ? 'en' : null;\n}\n\nexport function fillChartSummary(\n  template: string, values: Readonly<Record<string, string>>, range: { readonly yMin: string; readonly yMax: string } | null,\n): string {\n  if (range) return fill(template, { ...values, ...range });\n  // When a translation uses the same placeholders, omit the sentence that would describe the missing range.\n  const withoutRange = template === fullChartSummary ? chartSummary\n    : template.match(/[^.!?。！？]+[.!?。！？]*|[.!?。！？]+/gu)?.filter(part => !/\\{y(?:Min|Max)\\}/.test(part)).join('').trim();\n  return fill(withoutRange || chartSummary, values);\n}\n\nexport function fillDonutSlice(label: string, value: string, percent: string): string {\n  return fill(donutSlice, { label, value, percent });\n}\n\nexport function pointOf(lookup: Lookup, ref: DatumRef, formatters: Formatters, messages: Messages): string | null {\n  const ordinal = lookup.ordinal(ref);\n  if (ordinal < 0) return null;\n  const datum = lookup.datum(ref);\n  if (!datum) return null;\n  return fill(messages.pointOf, {\n    series: datum.seriesLabel, x: datum.x, value: datum.value,\n    index: formatters.count(ordinal + 1), count: formatters.count(lookup.count),\n  });\n}\npackages/axylo/src/public.ts:211:  plotInstructions: string;\npackages/axylo/src/public.ts:212:  /** Slice navigation and selection, in place of `plotInstructions` on a donut. */\npackages/axylo/src/public.ts:213:  donutInstructions?: string;\npackages/axylo/src/public.ts:215:  seriesInstructions?: string;\npackages/axylo/src/public.ts:217:  zoomInstructions?: string;\ndocs/decisions/0001-plot-interaction-pattern.md:19:- **Keys**: Left and Right move along x (native). Home, End, Page Up and Page Down native. Up and Down are intercepted to change the series in focus. `+`, `-`, `0` and Shift+arrows zoom and pan. Enter or Space selects (fires `select`). Escape: closes the tooltip first, then leaves single-series mode; otherwise it is not consumed, so a chart inside a dialog does not swallow it.\ntests/dist/text.browser.test.ts:289:      plotLabel: toolbar, plotRole: toolbar, plotInstructions: toolbar, // the plot's keyboard proxy\ntests/dist/pages/sentinels.ts:85:  'seriesValue', 'position', 'total', 'panLeft', 'panRight', 'jumpNotFound', 'plotInstructions', 'seeTable',\npackages/axylo/test/messages/index.test.ts:16:    panLeft: true, panRight: true, jumpNotFound: true, plotInstructions: true,\npackages/axylo/test/messages/index.test.ts:17:    donutInstructions: true, seriesInstructions: true, zoomInstructions: true,\npackages/axylo/test/browser/chart/plot-description.browser.test.ts:81:  await create(page, 'line', { ...twoSeries, messages: { plotInstructions: 'Eigene Tastaturhilfe.' } });\npackages/axylo/test/browser/chart/plot-description.browser.test.ts:83:  await page.evaluate(() => window.charts[0]!.update({ messages: { seriesInstructions: 'Mit den Pfeiltasten die Reihe wechseln.' } }));\npackages/axylo/test/browser/chart/interaction.browser.test.ts:332:  it('keyboard: + and - zoom, Shift+arrows pan, 0 resets', async () => {\npackages/axylo/test/browser/chart/interaction.browser.test.ts:341:    await page.keyboard.press('Shift+ArrowRight');\npackages/axylo/test/browser/chart/interaction.browser.test.ts:345:    await page.keyboard.press('Shift+ArrowLeft');\npackages/axylo/test/core/plot-description.test.ts:50:  const messages = { plotInstructions: 'Eigene Tastaturhilfe.' };\npackages/axylo/test/core/plot-description.test.ts:54:  const translated = { ...messages, donutInstructions: 'Mit den Pfeiltasten zwischen Segmenten wechseln.', zoomInstructions: 'Mit Plus vergrößern.' };\npackages/axylo/test/core/plot-description.test.ts:59:  expect(description(record('line', { ...twoSeries, messages: { plotInstructions: POINTS } }))).toBe(POINTS);\npackages/axylo/test/browser/acceptance/a6-a10.browser.test.ts:383:  plotInstructions: ['line', 'area', 'bar', 'scatter'], donutInstructions: ['donut'],\npackages/axylo/test/browser/acceptance/a6-a10.browser.test.ts:384:  seriesInstructions: ['line', 'area', 'bar', 'scatter'],\npackages/axylo/test/browser/acceptance/a6-a10.browser.test.ts:385:  zoomInstructions: ['line', 'area', 'bar', 'scatter'], // The first bar scenario has a time axis.\npackages/axylo/test/browser/acceptance/type-matrix.browser.test.ts:328:    for (const key of ['Shift+ArrowUp', 'Shift+ArrowDown']) {\npackages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts:675:      await page.keyboard.press('Shift+ArrowRight');\npackages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts:680:      await page.keyboard.press('Shift+ArrowLeft');\n### M7. Distribution and documentation (ceiling: 8 days)\n\n- Script-tag builds; documentation site; migration notes from Chart.js and Recharts. (No framework adapter in 1.0.)\n\nOutcomes:\n- The packed tarball installed into two clean fixtures (npm with a bundler, script tag): the first chart works in ten lines or fewer in each (DX1).\n- Node import and `validate()` without a DOM; strict CSP with real headers (DX8).\n- Size measured on the packed distribution for line-only, full and script-tag cases, CSS included (DX7).\n- Every runnable docs example compiled and rendered from the packed distribution (DX10).\n- The agent rehearsal (DX12), recorded as rehearsal.\n\n### M8. Release (ceiling: 10 days)\n\n- Beta under a `next` tag; issues from real use fixed; API frozen through the API report.\n- The Phase 1 comparison regenerated with Axylo beside the ten libraries, with the same harness and the corrections from the review, and published with its limits.\n- Real Safari on macOS and iOS checked by hand.\n- Independent review of the acceptance evidence before 1.0 is tagged, by a reviewer who did not write the code under review.\n\nOutcomes: every acceptance-matrix row is pass or not applicable with a reason; changelog, upgrade policy and third-party notices published.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"rg --files | rg 'examples/first-chart/npm.ts\"'$'\"' && sed -n '1,125p' scripts/pack.mjs && git status --short -- packages/axylo/src scripts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"rg --files | rg 'examples/first-chart/npm.ts\"'$'\"' && sed -n '1,125p' scripts/pack.mjs && git status --short -- packages/axylo/src scripts\"","aggregated_output":"examples/first-chart/npm.ts\n// Packs the published package as npm would publish it and installs the tarball into the fixtures under\n// tests/dist/fixtures with npm itself, offline (plan M7; spec DX1, DX7, DX8, DX10).\n//\n//   node scripts/pack.mjs             runs the root build first (npm run build)\n//   node scripts/pack.mjs --no-build  packs whatever packages/*/dist holds now\n//\n// Output (all git-ignored):\n//   tests/dist/.packed/<name>-<version>.tgz   the tarball, exactly what `npm publish` would upload\n//   tests/dist/.packed/manifest.json          what npm pack reported (file list, integrity) per package\n//   tests/dist/fixtures/<fixture>/node_modules  `npm install --offline` of the fixture's own package.json: the\n//                                               packed tarball through its `file:` specifier. No links.\n//   tests/dist/fixtures/<fixture>/example/    copies of examples/first-chart, so they resolve from the fixture\n//\n// Every fixture sits under the repository, whose root node_modules links the workspace packages; resolution\n// from a fixture could fall back to them for anything it did not install. `fixtureGuard` (esbuild) and\n// tests/dist/guard/node-guard.mjs (Node) fail any resolution that leaves the fixture, so such a fallback is an\n// error rather than a silent pass. The fixtures depend on nothing but the tarball, so the install is --offline\n// and never asks a registry.\nimport { execFileSync } from 'node:child_process';\nimport fs from 'node:fs';\nimport path from 'node:path';\n\nconst root = path.resolve(import.meta.dirname, '..');\nconst distTests = path.join(root, 'tests/dist');\nconst packed = path.join(distTests, '.packed');\nconst windows = process.platform === 'win32';\n\nexport const PACKAGES = { axylo: 'packages/axylo' };\n\n/** The fixtures and the first-chart examples each one carries. What each installs is its own package.json. */\nexport const FIXTURES = { npm: ['npm.ts'], script: ['script.html'] };\n\n// npm run, npx and Vitest started through them pass their own settings down as npm_config_* variables\n// (one of them, allow-scripts, makes a project install refuse to run); the fixtures install with defaults.\nconst env = Object.fromEntries(Object.entries(process.env).filter(([k]) => !/^npm_/i.test(k)));\nconst run = (command, args, options = {}) =>\n  execFileSync(windows ? `${command}.cmd` : command, args, { cwd: root, encoding: 'utf8', shell: windows, env, ...options });\n\nconst inside = (parent, child) => {\n  const relative = path.relative(parent, child);\n  return relative !== '' && !relative.startsWith('..') && !path.isAbsolute(relative);\n};\n\n/** Files under `dir`, as forward-slash paths relative to it. */\nfunction walk(dir, base = dir) {\n  return fs.readdirSync(dir, { withFileTypes: true }).flatMap(e =>\n    e.isDirectory() ? walk(path.join(dir, e.name), base) : [path.relative(base, path.join(dir, e.name)).split(path.sep).join('/')]);\n}\n\n/**\n * An esbuild plugin that fails the build when any import resolves outside `roots` (absolute directories):\n * what esbuild would otherwise find by walking up from a fixture into the repository's node_modules.\n */\nexport function fixtureGuard(roots) {\n  return {\n    name: 'fixture-guard',\n    setup(build) {\n      build.onResolve({ filter: /.*/ }, async args => {\n        if (args.pluginData?.guarded || args.kind === 'entry-point') return undefined;\n        const result = await build.resolve(args.path, {\n          kind: args.kind, importer: args.importer, resolveDir: args.resolveDir, namespace: args.namespace, pluginData: { guarded: true },\n        });\n        if (result.errors.length > 0 || result.external || result.namespace !== 'file') return result;\n        if (!roots.some(r => inside(r, result.path))) {\n          return { errors: [{ text: `[fixture guard] ${JSON.stringify(args.path)} imported from ${args.importer || '(stdin)'} resolved outside the fixture, to ${result.path}` }] };\n        }\n        return result;\n      });\n    },\n  };\n}\n\nexport function pack({ build = true, log = console.log } = {}) {\n  if (build) run('npm', ['run', 'build'], { stdio: 'inherit' });\n  fs.rmSync(packed, { recursive: true, force: true });\n  fs.mkdirSync(packed, { recursive: true });\n\n  const manifest = { packedAt: new Date().toISOString(), packages: {} };\n  for (const [name, dir] of Object.entries(PACKAGES)) {\n    const out = run('npm', ['pack', '--json', '--ignore-scripts', '--pack-destination', packed], { cwd: path.join(root, dir) });\n    const [report] = JSON.parse(out);\n    manifest.packages[name] = {\n      directory: dir,\n      tarball: report.filename,\n      integrity: report.integrity,\n      size: report.size,\n      unpackedSize: report.unpackedSize,\n      files: report.files.map(f => f.path).sort(),\n    };\n    log(`packed ${report.filename}: ${report.files.length} files, ${report.size} bytes`);\n  }\n\n  for (const [fixture, examples] of Object.entries(FIXTURES)) {\n    const dir = path.join(distTests, 'fixtures', fixture);\n    for (const generated of ['node_modules', 'example', '.out']) fs.rmSync(path.join(dir, generated), { recursive: true, force: true });\n    run('npm', ['install', '--offline', '--ignore-scripts', '--no-audit', '--no-fund', '--no-package-lock', '--loglevel=error'], { cwd: dir, stdio: 'pipe' });\n    const declared = JSON.parse(fs.readFileSync(path.join(dir, 'package.json'), 'utf8'));\n    for (const name of Object.keys(declared.dependencies ?? {}).filter(n => n in PACKAGES)) {\n      const at = path.join(dir, 'node_modules', name);\n      if (fs.lstatSync(at).isSymbolicLink()) throw new Error(`${fixture}: npm linked ${name} instead of installing the tarball`);\n      const files = walk(at).sort();\n      if (files.join('\\n') !== manifest.packages[name].files.join('\\n')) throw new Error(`${fixture}: installed ${name} differs from npm pack's file list`);\n    }\n    fs.mkdirSync(path.join(dir, 'example'), { recursive: true });\n    for (const file of examples) fs.copyFileSync(path.join(root, 'examples/first-chart', file), path.join(dir, 'example', file));\n  }\n  fs.writeFileSync(path.join(packed, 'manifest.json'), JSON.stringify(manifest, null, 1));\n  log(`fixtures installed: ${Object.keys(FIXTURES).join(', ')}`);\n  return manifest;\n}\n\nif (path.resolve(process.argv[1] ?? '') === import.meta.filename) {\n  pack({ build: !process.argv.includes('--no-build') });\n}\n","exit_code":0,"status":"completed"}}
