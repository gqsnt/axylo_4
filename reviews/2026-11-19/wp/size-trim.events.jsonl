ns: ['production'], write: false, logLevel: 'silent', plugins: [fixtureGuard([cwd])], ...extra })).outputFiles[0].text;\n}\nassert.equal((await bundle(\\\"import 'axylo';\\\", { ignoreAnnotations: true })).trim(), '');\nconst markers = {\n  line: [/kind:\\\"line\\\",normalize:/],\n  area: [/kind:\\\"area\\\",normalize:/, /\\\\.upper\\\\b/],\n  bar: [/kind:\\\"bar\\\",normalize:/, /axylo-pattern-/],\n  scatter: [/kind:\\\"scatter\\\",normalize:/, /\\\\.minX\\\\b/],\n  donut: [/kind:\\\"donut\\\",normalize:/, /__other__/],\n};\nfor (const [kind, own] of Object.entries(markers)) {\n  const bundleText = await bundle(\"'`export { ${kind} } from '\"'axylo';\"'`);\n  for (const marker of own) assert.match(bundleText, marker);\n  for (const [other, foreign] of Object.entries(markers)) {\n    if (other !== kind) for (const marker of foreign) assert.doesNotMatch(bundleText, marker);\n  }\n  assert.equal(/adoptNormalized/.test(bundleText), ['\"'line', 'area', 'bar'].includes(kind));\n}\nconsole.log('Production import for effects bundles to nothing and each chart retains only its expected tree-shaking markers.');\nEOF\nnode .size-trim.LYRSSy/check-release.mjs\"","aggregated_output":"Counter markers absent in production and present in development and benchmark builds.\nProduction ESM imports and validates data in Node.\nProduction import for effects bundles to nothing and each chart retains only its expected tree-shaking markers.\n","exit_code":0,"status":"completed"}}
