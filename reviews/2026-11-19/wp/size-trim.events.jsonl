bel}: {value} ({percent}).';\n \n-export const defaultMessages: Messages = {\n+export const defaultMessages: Required<Messages> = {\n   viewAsTable: 'View as table',\n   hideTable: 'Hide table',\n   noData: 'No data',\n@@ -59,7 +59,10 @@ export const defaultMessages: Messages = {\n   panLeft: 'Pan left',\n   panRight: 'Pan right',\n   jumpNotFound: 'No row matches {x}. Example: {example}',\n-  plotInstructions: 'Left and right arrows move between points, up and down between series, and Enter selects. Plus and minus zoom; 0 resets.',\n+  plotInstructions: 'Left and right arrows move between points along x. Enter selects.',\n+  donutInstructions: 'Arrow keys move between slices. Enter selects.',\n+  seriesInstructions: 'Up and down arrows move between series.',\n+  zoomInstructions: 'Plus and minus zoom. Press 0 to reset. Hold Shift with left or right to pan the zoomed view.',\n   selectRange: 'Select range',\n   seeTable: 'See table.',\n   totalMixed: '{positive} and {negative}',\n@@ -89,7 +92,7 @@ export function resolveMessages(overrides?: Partial<Messages> | null): Messages\n }\n \n export function messageLanguage(messages: Messages, key: keyof Messages): 'en' | null {\n-  return messages[key] === defaultMessages[key] && !authoredMessages.get(messages)?.has(key) ? 'en' : null;\n+  return (messages[key] ?? defaultMessages[key]) === defaultMessages[key] && !authoredMessages.get(messages)?.has(key) ? 'en' : null;\n }\n \n export function fillChartSummary(\ndiff --git a/packages/axylo/src/public.ts b/packages/axylo/src/public.ts\nindex 36a2a53..f34097d 100644\n--- a/packages/axylo/src/public.ts\n+++ b/packages/axylo/src/public.ts\n@@ -205,8 +205,16 @@ export interface Messages {\n   plotRole: string; pointAll: string; seriesValue: string; position: string;\n   /** Label of the stack total in tooltips. */\n   total: string;\n-  /** Single-click panning (WCAG 2.5.7), the table's \"Jump to\" when nothing matches, and how to move in the plot. */\n-  panLeft: string; panRight: string; jumpNotFound: string; plotInstructions: string;\n+  /** Single-click panning (WCAG 2.5.7) and the table's \"Jump to\" when nothing matches. */\n+  panLeft: string; panRight: string; jumpNotFound: string;\n+  /** Point navigation and selection. An override is also the fallback for donuts and receives only explicitly overridden additions. */\n+  plotInstructions: string;\n+  /** Slice navigation and selection, in place of `plotInstructions` on a donut. */\n+  donutInstructions?: string;\n+  /** Added when the arrow keys can move between visible series. */\n+  seriesInstructions?: string;\n+  /** Added when the plot offers Zoom in. */\n+  zoomInstructions?: string;\n   /** Toolbar toggle: while it is on, two clicks in the plot set the two ends of the zoom range (the non-dragging way to select a range, WCAG 2.5.7). */\n   selectRange: string;\n   /** A stack whose components have mixed signs: both ends, in place of one total ('{positive} and {negative}'). */\ndocs/03-plan-typescript-release.md:7:**The release is done when every row of the acceptance matrix passes.** The matrix lives in the repository as data: one row per spec criterion and chart type, naming the test that covers it, with a result of pass, fail or not applicable (with the reason). The Phase 1 comparison is rerun with Axylo included and published, but it is comparison evidence, not the gate: several of its columns are descriptive, and it cannot run the performance budgets.\ndocs/03-plan-typescript-release.md:200:| layout | View model; container size; resolved font and text spacing; `document.fonts` finishing a load; locale; any label text. A data-only update reruns layout when the tick labels would change, and skips it otherwise. |\ndocs/03-plan-typescript-release.md:253:Tooling: TypeScript strict; ESM output with `.d.ts`, plus IIFE files for `<script>` use; Vitest; fast-check for property tests; Playwright on Chromium, Firefox and WebKit; axe-core; size-limit on the packed distribution; API Extractor so that public API changes fail CI until reviewed; Changesets.\ndocs/03-plan-typescript-release.md:259:Each milestone ends with outcomes checked by a command, an example that runs in the docs site, and the documentation page for what was built. Durations are ceilings for one owner working with coding agents, not targets. Every milestone from M1 on re-runs the acceptance matrix, the size report and the benchmark smoke set, and records the results.\ndocs/03-plan-typescript-release.md:272:- `line()` from rows and from typed columns: normalization with provenance, linear, time and date scales, DOM tick labels, resize, light and dark, `destroy`.\ndocs/03-plan-typescript-release.md:279:- `trend` renders in three engines at 720 and 340 px; scene snapshot; resize in both directions with no call from the page.\ndocs/03-plan-typescript-release.md:282:- Provisional budgets P1, P2, P5 and the size targets are recalibrated from the slice and recorded.\ndocs/03-plan-typescript-release.md:313:- The pattern chosen in M1, built fully: names and summary (A1), keyboard (A2), point text (A3), table with paging (A4), non-color cues (A5), reflow (A6), streaming behavior (A7), messages and language (A10); single-pointer zoom controls (I3, I4); reduced motion on update (I5).\ndocs/03-plan-typescript-release.md:357:- Size measured on the packed distribution for line-only, full and script-tag cases, CSS included (DX7).\ndocs/03-plan-typescript-release.md:379:| Browser | Playwright on three engines | Real text boxes, resize, pointer, touch, keyboard, time zones, color schemes, reduced motion, fonts loading late. |\ndocs/03-plan-typescript-release.md:383:| Packed distribution | Clean install fixtures | What users actually get (DX1, DX7, DX8, DX10). |\ndocs/03-plan-typescript-release.md:395:| The million-point budget cannot be met with exact lookup and gap-preserving simplification. | The headline claim is already limited to measured workloads (spec, section 1). If P2 fails after tuning, the budget is changed in the spec with the measurements, not hidden. |\ndocs/02-product-spec.md:13:Speed is a constraint, not the headline: Axylo must stay within the budgets in section 5 with default options. Whether it can do that at a million points with its accessibility layer on is something the first milestone measures, not something this document can promise.\ndocs/02-product-spec.md:25:| uPlot | The speed reference | Automatic sizing, a palette, bars and donuts without path builders, and an accessibility layer, at a speed the budgets in section 5 keep honest |\ndocs/02-product-spec.md:70:| W2 | Fill a dashboard | Dozens of charts per page; container-sized; themed by the page; loading, empty and error states; a chart can take its name from the card's own heading. |\ndocs/02-product-spec.md:114:| L3 | The chart follows its container with no call from the page, in both directions. With no definite height, the plot is 16:9, clamped between 160 and 480 CSS px tall, and the title, controls and table flow above and below it. A container that starts hidden or zero-sized draws when it gets a size. | Resize 720 → 360 → 720 px; hidden-then-shown test; `height: auto` container is stable over 10 frames | R16, D1 |\ndocs/02-product-spec.md:127:| I3 | Zoom on time, date and numeric x axes is reachable four ways: visible Zoom in, Zoom out and Reset buttons that work with single clicks; drag to select a range; `+`, `-`, `0` and Shift+arrows; and pinch when `zoom: 'touch'` is set. The wheel zooms only while the plot has focus, and never when Ctrl or Meta is held, so browser zoom and page scrolling are not intercepted. | Reach a given range by clicks only; by keyboard only; by drag; page scrolls normally with the pointer over an unfocused chart | D7, R12, WCAG 2.5.1, 2.1.1 |\ndocs/02-product-spec.md:128:| I4 | Every interaction works with a single pointer without dragging, and by touch. Every control is at least 24×24 CSS px. A one-finger drag on a chart scrolls the page (on a compact chart too: it takes no pointer input at all, C1). | Touch emulation; size checks | WCAG 2.5.7, 2.5.8, 2.5.1, 2.5.3, 4.1.2, 2.1.1 |\ndocs/02-product-spec.md:151:Level decides delivery. **Error**: the chart or a series cannot be drawn; the chart shows its error state. **Warning**: something is not as the author gave it; where that means values were left out or changed (F12), the reader sees the note, and the registry's rows say which codes those are (a warning about an option, a name, a colour or a tick label shows none). **Hint**: advice for the author. Errors and warnings print once per code per page in every build; hints print in development builds only. `strict: true` throws on errors and warnings found while validating a create, `update` or `append` call, synchronously from that call. A diagnostic that can only arise later (a contrast check after the page's CSS changes, a custom formatter that throws when a table page is built, a label that stops fitting after a resize) is reported when it is found and is never thrown. Every diagnostic names the chart; those about data name the field and the first row indexes in the caller's own data.\ndocs/02-product-spec.md:209:| C3 | It fills its container at any size from 24×16 CSS px up; with no definite height it is 32 px tall. | Size tests |\ndocs/02-product-spec.md:227:| DX5 | Three methods change a chart: `update` changes options, `append` adds rows, `zoom` sets the view. They apply in call order. Validation and diagnostics are synchronous; drawing is deferred to the next frame; marks, labels, hit testing and the accessibility layer always switch to a new state together. `destroy()` releases everything and cancels pending work. No `resize()` exists. | Sequence tests: replace then append then zoom in one turn; a rejected `strict` update leaves the last valid chart; destroy before the frame; 1,000 create–destroy cycles show no heap growth trend (P7) | D3, R16 |\ndocs/02-product-spec.md:229:| DX7 | Zero runtime dependencies (reconsidered only with a measured comparison). Size targets for 1.0, set by the owner on 2026-11-18 after measurement: 116 KiB gzipped for everything and 98 KiB for a page that uses only `line`, CSS included. (History: the first targets, 40 and 25 KiB, were written before anything was built; 96 and 80 were set the same day from a first analysis, `reviews/2026-11-18/impl/wp/size.analysis.md`; the correctness passes that followed added about 11 KiB, and a second measured analysis, `reviews/2026-11-18/impl/wp/size2.analysis.md`, showed 96 and 80 can only be met by making streaming an opt-in import, a public API change the owner left for after 1.0. That change, worth about 15 KiB, is the first size item after 1.0.) | size-limit in CI on the packed distribution | D4 |\ndocs/02-product-spec.md:236:## 5. Performance budgets\ndocs/02-product-spec.md:238:These numbers are provisional. They are design targets taken from Phase 1's order-of-magnitude measurements, and they become release gates only after the benchmark harness built in M0 has measured a working Axylo slice in M1 and the limits have been recalibrated and frozen (plan, M1 and M6). Each budget names its workload, metric and statistic so that two people measuring the same build get the same verdict.\ndocs/02-product-spec.md:247:| P6 | Download | Minified and gzipped bytes, CSS included | Exact | DX7 | 01, section 1.4 |\ndocs/02-product-spec.md:249:| P7 | Memory | Bytes owned by Axylo beyond the caller's columns for 1,000,000 points; heap trend over 1,000 create–destroy cycles | Measured after forced collection | At most 1.1× the size of the caller's two columns; no upward slope. (1.1× since 2026-11-18, the owner's decision: once a chart opened on typed columns is appended to, exact x, exact y and one state byte per point are 17 bytes per point against the caller's 16, measured 17,069,760 bytes for 1,000,000 points. Staying under 1× would need segmented columns, a contract change that was not judged worth it for 1.0.) | Not measured in Phase 1 |\ndocs/02-product-spec.md:287:| Collect chart sizes and device profiles from beta deployments | A chart library should not phone home. Workload sizes come from the spec and from issue reports. |\n","exit_code":0,"status":"completed"}}
