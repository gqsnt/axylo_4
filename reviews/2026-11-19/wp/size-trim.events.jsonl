{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/test/core/plot-description.test.ts && sed -n '195,223p' packages/axylo/src/public.ts && rg -n 'comparisons|lastPick' packages/axylo/src packages/axylo/test | head -80 && cat vitest.config.ts\"","aggregated_output":"import { expect, it } from 'vitest';\nimport { plotDescription } from '../../src/dom/interaction';\nimport { record, type Recording } from './host';\n\nconst POINTS = 'Left and right arrows move between points along x. Enter selects.';\nconst SLICES = 'Arrow keys move between slices. Enter selects.';\nconst SERIES = 'Up and down arrows move between series.';\nconst ZOOM = 'Plus and minus zoom. Press 0 to reset. Hold Shift with left or right to pan the zoomed view.';\nconst line = { title: 'Trend', x: 'x', y: 'y', data: [{ x: 1, y: 2 }, { x: 2, y: 4 }] };\nconst twoSeries = { ...line, series: 's', data: line.data.flatMap(row => [{ ...row, s: 'A' }, { ...row, s: 'B', y: row.y + 1 }]) };\nconst donut = { title: 'Slices', label: 'label', value: 'y', data: [{ label: 'A', y: 2 }, { label: 'B', y: 4 }] };\n\nfunction description(chart: Recording): string {\n  chart.frames();\n  return plotDescription(chart.committed!).map(part => part.text).join(' ');\n}\n\nit('describes the navigation and zoom that apply to the chart type (A2, I3)', () => {\n  expect(description(record('line', twoSeries))).toBe(`${POINTS} ${SERIES} ${ZOOM}`);\n  expect(description(record('line', line))).toBe(`${POINTS} ${ZOOM}`);\n  expect(description(record('bar', line))).toBe(`${POINTS} ${ZOOM}`);\n  expect(description(record('bar', { ...line, data: line.data.map(row => ({ ...row, x: `Q${row.x}` })) }))).toBe(POINTS);\n  expect(description(record('donut', donut))).toBe(SLICES);\n});\n\nit('follows committed zoom and visibility changes', () => {\n  const chart = record('line', twoSeries);\n  expect(description(chart)).toBe(`${POINTS} ${SERIES} ${ZOOM}`);\n  chart.controller.handle.update({ zoom: false });\n  expect(description(chart)).toBe(`${POINTS} ${SERIES}`);\n  chart.controller.actions.toggle('B');\n  expect(description(chart)).toBe(POINTS);\n  chart.controller.actions.toggle('A');\n  expect(description(chart)).toBe('');\n  chart.controller.actions.toggle('B');\n  chart.controller.actions.toggle('A');\n  expect(description(chart)).toBe(`${POINTS} ${SERIES}`);\n  chart.controller.handle.update({ zoom: true });\n  expect(description(chart)).toBe(`${POINTS} ${SERIES} ${ZOOM}`);\n});\n\nit('describes switching scatter series only while both have points in the window', () => {\n  const chart = record('scatter', { ...twoSeries, data: twoSeries.data.map(r => ({ ...r, x: r.s === 'A' ? r.x : r.x + 10 })) });\n  expect(description(chart)).toBe(`${POINTS} ${SERIES} ${ZOOM}`);\n  chart.controller.handle.zoom([1, 3]);\n  expect(description(chart)).toBe(`${POINTS} ${ZOOM}`);\n});\n\nit('keeps a legacy override whole, with explicit new overrides available on the charts they describe (A10)', () => {\n  const messages = { plotInstructions: 'Eigene Tastaturhilfe.' };\n  expect(description(record('line', { ...twoSeries, messages }))).toBe('Eigene Tastaturhilfe.');\n  expect(description(record('donut', { ...donut, messages }))).toBe('Eigene Tastaturhilfe.');\n\n  const translated = { ...messages, donutInstructions: 'Mit den Pfeiltasten zwischen Segmenten wechseln.', zoomInstructions: 'Mit Plus vergrößern.' };\n  expect(description(record('line', { ...twoSeries, messages: translated }))).toBe('Eigene Tastaturhilfe. Mit Plus vergrößern.');\n  expect(description(record('donut', { ...donut, messages: translated }))).toBe('Mit den Pfeiltasten zwischen Segmenten wechseln.');\n\n  // Authorship still counts if the supplied base text happens to match the new English default.\n  expect(description(record('line', { ...twoSeries, messages: { plotInstructions: POINTS } }))).toBe(POINTS);\n});\n  plotLabel: string; controlsLabel: string; pointOf: string;\n  zoomIn: string; zoomOut: string; resetZoom: string; pause: string; resume: string;\n  previousPage: string; nextPage: string; pageOf: string; jumpToX: string;\n  /** Column headers and nouns. */\n  category: string; percentage: string; series: string; value: string;\n  /** Chart type names used in generated names and summaries. */\n  typeLine: string; typeArea: string; typeBar: string; typeScatter: string; typeDonut: string;\n  /** Summary sentences that have no cartesian form. */\n  donutSummary: string; seriesNoData: string; seriesNotDrawn: string; referenceLine: string; referenceBand: string;\n  /** What the keyboard proxy says it is (\"{type} chart\") and how it reads a position. */\n  plotRole: string; pointAll: string; seriesValue: string; position: string;\n  /** Label of the stack total in tooltips. */\n  total: string;\n  /** Single-click panning (WCAG 2.5.7) and the table's \"Jump to\" when nothing matches. */\n  panLeft: string; panRight: string; jumpNotFound: string;\n  /** Point navigation and selection. An override is also the fallback for donuts and receives only explicitly overridden additions. */\n  plotInstructions: string;\n  /** Slice navigation and selection, in place of `plotInstructions` on a donut. */\n  donutInstructions?: string;\n  /** Added when the arrow keys can move between visible series. */\n  seriesInstructions?: string;\n  /** Added when the plot offers Zoom in. */\n  zoomInstructions?: string;\n  /** Toolbar toggle: while it is on, two clicks in the plot set the two ends of the zoom range (the non-dragging way to select a range, WCAG 2.5.7). */\n  selectRange: string;\n  /** A stack whose components have mixed signs: both ends, in place of one total ('{positive} and {negative}'). */\n  totalMixed: string;\n  /** Incomplete stacks in a summary: named when few ('{label}: incomplete at {positions}.'), counted when many ('{label}: {count} incomplete stacks.'). */\n  incompleteAt: string; incompleteCount: string;\npackages/axylo/test/reader/index.test.ts:401:  const work = { seeks: 0, steps: 0, comparisons: 0 };\npackages/axylo/test/reader/index.test.ts:403:  expect(work).toEqual({ seeks: 0, steps: 0, comparisons: 0 });\npackages/axylo/test/reader/index.test.ts:411:  expect(work.comparisons).toBeGreaterThan(0);\npackages/axylo/test/reader/index.test.ts:412:  expect(work.comparisons).toBeLessThan(60_000);\npackages/axylo/test/lookup/scatter.test.ts:290:  expect(model.lastPickCandidates).toBeGreaterThan(0);\npackages/axylo/test/lookup/scatter.test.ts:291:  expect(model.lastPickCandidates).toBeLessThan(5_000);\npackages/axylo/test/lookup/scatter.test.ts:323:  expect(model.lastPickCandidates).toBeLessThan(3_000);\npackages/axylo/test/lookup/scatter.test.ts:351:    expect(model.lastPickCandidates).toBeLessThanOrEqual(12);\npackages/axylo/test/lookup/scatter.test.ts:428:    expect(model.lastPickCells).toBeLessThanOrEqual(16);\npackages/axylo/test/lookup/scatter.test.ts:429:    expect(model.lastPickCandidates).toBeLessThan(3_000);\npackages/axylo/test/lookup/scatter.test.ts:513:      expect(model.lastPickLattice).toBe(true);\npackages/axylo/test/lookup/scatter.test.ts:531:    expect(model.lastPickLattice).toBe(true);\npackages/axylo/test/lookup/scatter.test.ts:532:    expect(model.lastPickCandidates).toBeLessThanOrEqual(bound(ratio));\npackages/axylo/test/lookup/scatter.test.ts:535:    const visits = model.lastPickCandidates;\npackages/axylo/test/lookup/scatter.test.ts:537:    expect(model.lastPickCandidates).toBe(visits);\npackages/axylo/test/lookup/scatter.test.ts:549:      expect(model.lastPickCandidates).toBeLessThanOrEqual(exactBudget === 0 ? bound(ratio) / 2 : bound(ratio));\npackages/axylo/test/lookup/scatter.test.ts:550:      if (model.lastPickLattice) expectLattice(target, latticeOracle(drawn, 100.3, 100.2, ratio));\npackages/axylo/test/lookup/scatter.test.ts:642:    expect(model.lastPickLattice).toBe(true);\npackages/axylo/test/lookup/scatter.test.ts:686:        expect(target.rule ?? 'exact').toBe(