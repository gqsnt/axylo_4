return index;\n}\n\nexport function scatterLookup(\n  view: ScatterView, layout: PlotLayout | null, formatters: Formatters, work?: ScatterWork, devicePixelRatio = 1,\n  gridOptions?: GridOptions,\n): Lookup & {\n  readonly lastPickCandidates: number; readonly lastPickCells?: number; readonly lastPickLattice: boolean; readonly lastMembersRead: number;\n} {\n  const { series } = view.frame;\n  const keys = new Map(series.map((entry, i) => [entry.key, i]));\n  const locations = new WeakMap<DatumRef, PointIndex>();\n  const ranges = view.visiblePoints.map((range, s) => view.visible[s] && series[s]!.drawable ? range : { start: 0, end: 0 });\n  const order = pointOrder(series, ranges, work && {\n    get comparisons() { return work.orderComparisons; },\n    set comparisons(value) { work.orderComparisons = value; },\n  });\n  const active = ranges.flatMap((range, s) => range.end > range.start ? [s] : []);\n  const projection = layout?.projection.kind === 'xy' ? layout.projection : null;\n  const grid = layout && projection ? scatterGrid(view, { ...layout, projection }, order.count, devicePixelRatio, gridOptions) : null;\n\n  function ref(s: number, i: number): DatumRef {\n    const entry = series[s]!;\n    const datum = { kind: 'point', seriesKey: entry.key, row: entry.row?.[i] ?? i, x: entry.x[i]! } as const;\n    // A pick already knows the point's position. A ref rebuilt by the caller still resolves by source row.\n    locations.set(datum, { series: s, index: i });\n    return datum;\n  }\n\n  const byRow = series.map(rowIndex);\n\n  function locate(datum: DatumRef): PointIndex | null {\n    if (datum.kind !== 'point') return null;\n    const known = locations.get(datum);\n    if (known) return known;\n    const s = keys.get(datum.seriesKey);\n    if (s === undefined) return null;\n    const { x, row } = series[s]!;\n    const rows = byRow[s];\n    if (!row || rows) {\n      const direct = rows ? rows.get(datum.row) : datum.row;\n      if (direct === undefined || x[direct] !== datum.x) return null;\n      const point = { series: s, index: direct };\n      locations.set(datum, point);\n      return point;\n    }\n    for (let i = lowerBound(x, datum.x); x[i] === datum.x; i++) {\n      if (work) work.locations++;\n      if ((row?.[i] ?? i) !== datum.row) continue;\n      const point = { series: s, index: i };\n      locations.set(datum, point);\n      return point;\n    }\n    return null;\n  }\n\n  function resolve(datum: DatumRef): DatumRef | null {\n    if (datum.kind !== 'point') return null;\n    const s = keys.get(datum.seriesKey);\n    if (s === undefined) return null;\n    const { start, end } = ranges[s]!;\n    if (!view.visible[s]) {\n      let primary: PointIndex | null = null;\n      let y = Infinity;\n      for (const t of active) {\n        const { start, end } = ranges[t]!;\n        const entry = series[t]!;\n        const i = lowerBound(entry.x, datum.x, start, end);\n        if (i < end && entry.x[i] === datum.x && entry.y[i]! < y) {\n          primary = { series: t, index: i };\n          y = entry.y[i]!;\n        }\n      }\n      return primary ? ref(primary.series, primary.index) : null;\n    }\n    if (start === end) return null;\n    const point = locate(datum);\n    if (point && point.index >= start && point.index < end) return datum;\n    const x = series[s]!.x;\n    const right = upperBound(x, datum.x, start, end);\n/**\n * Axylo's public entry points. Importing this module touches no DOM, so it loads in Node, where `validate`\n * runs; the chart functions need a document and are only called in a browser.\n */\nimport type {\n  AreaOptions, BarOptions, Chart, Diagnostic, DonutOptions, LineOptions, ScatterOptions, Target,\n} from './public.js';\nimport { createChart } from './core/chart';\nimport { AREA } from './kinds/area';\nimport { BAR } from './kinds/bar';\nimport { DONUT } from './kinds/donut';\nimport { LINE } from './kinds/line';\nimport { SCATTER } from './kinds/scatter';\nimport { staticDiagnostics } from './core/stages';\nimport { viewerTimeZone } from './core/environment';\n\nexport type * from './public.js';\n\nexport function line<Row>(target: Target, options: LineOptions<Row>): Chart<Row, LineOptions<Row>> {\n  return createChart(LINE, target, options) as unknown as Chart<Row, LineOptions<Row>>;\n}\n\nexport function area<Row>(target: Target, options: AreaOptions<Row>): Chart<Row, AreaOptions<Row>> {\n  return createChart(AREA, target, options) as unknown as Chart<Row, AreaOptions<Row>>;\n}\n\nexport function bar<Row>(target: Target, options: BarOptions<Row>): Chart<Row, BarOptions<Row>> {\n  return createChart(BAR, target, options) as unknown as Chart<Row, BarOptions<Row>>;\n}\n\nexport function scatter<Row>(target: Target, options: ScatterOptions<Row>): Chart<Row, ScatterOptions<Row>> {\n  return createChart(SCATTER, target, options) as unknown as Chart<Row, ScatterOptions<Row>>;\n}\n\nexport function donut<Row>(target: Target, options: DonutOptions<Row>): Chart<Row, DonutOptions<Row>> {\n  return createChart(DONUT, target, options) as unknown as Chart<Row, DonutOptions<Row>>;\n}\n\n/**\n * Runs the synchronous stages of a create call without a DOM (option resolution, normalization, the view's\n * domain and series checks, naming) and returns the same call-origin diagnostics a created chart reports\n * (plan 1.6). Each chart type takes its own options, so an option that does not apply does not compile.\n */\nexport function validate<Row>(type: 'line', options: LineOptions<Row>): Diagnostic[];\nexport function validate<Row>(type: 'area', options: AreaOptions<Row>): Diagnostic[];\nexport function validate<Row>(type: 'bar', options: BarOptions<Row>): Diagnostic[];\nexport function validate<Row>(type: 'scatter', options: ScatterOptions<Row>): Diagnostic[];\nexport function validate<Row>(type: 'donut', options: DonutOptions<Row>): Diagnostic[];\nexport function validate(type: 'line' | 'area' | 'bar' | 'scatter' | 'donut', options: unknown): Diagnostic[] {\n  return staticDiagnostics(type, options, viewerTimeZone());\n}\n/**\n * `createChart`: the browser host of the controller (controller.ts). It resolves the target, builds the\n * figure, the mark and text renderers and the interaction layer, and connects the page's observers to the\n * controller. Every setup step registers its own cleanup as soon as it succeeded, so a failure part-way\n * through creation, or `destroy()`, leaves the target as it was (including the custom properties the theme\n * wrote on it).\n *\n * Document-level listeners (theme and environment watchers, the interaction layer's keyboard and pointer\n * listeners on the document) are released when the target leaves the document without `destroy()`, so a\n * forgotten chart does not stay reachable from the page, and are attached again if the target comes back.\n * Detachment is noticed by the observers the chart already has (the resize observer reports a zero box),\n * not by polling.\n */\nimport type { MarkRenderer, Scene } from './contracts';\nimport { canvasRendererWith } from '../render/canvas';\nimport { svgRendererWith } from '../render/svg';\nimport { createTextLayer, type TextLayer } from '../render/text';\nimport { ensureStyles, resolveTheme, watchTheme } from '../theme';\nimport { createFigure, type Figure } from '../dom/figure';\nimport { createInteraction, type Interaction } from '../dom/interaction';\nimport { mappingOf } from '../dom/mapping';\nimport type { DeliveryConsole } from './delivery';\nimport { createMeasurer, noteFontLoad, readTextStyle, resolveLocale, viewerTimeZone, watchEnvironment, watchLanguage } from './environment';\nimport { controllerFor, type ChartHandle, type Controller, type ControllerActions } from './controller';\nimport type { Composition } from './composition';\nimport { object } from './stages';\n\nexport type { BenchHook, ChartHandle, ChartKind, DevHook, Stage } from './controller';\n\nexport interface ChartEnvironmentOverrides {\n  readonly console?: DeliveryConsole | null;\n}\n\n/** Suffixes of the ids a chart gives its elements (figure, interaction, table). */\nconst ID_SUFFIXES = ['', '-t', '-st', '-s', '-m', '-n', '-i', '-proxy', '-table', '-table-caption', '-table-jump', '-table-jump-error'];\nlet instances = 0;\n\n/** An id prefix none of whose element ids exist in the page yet (spec A1: ids unique per chart). */\nfunction allocateId(doc: Document): string {\n  for (;;) {\n    const id = `axylo-${++instances}`;\n    if (ID_SUFFIXES.every(suffix => doc.getElementById(id + suffix) === null)) return id;\n  }\n}\n\nexport function createChart(composition: Composition, target: unknown, input: unknown, overrides: ChartEnvironmentOverrides = {}): ChartHandle {\n  const root = resolveTarget(target);\n  const doc = root.ownerDocument;\n  const win = doc.defaultView;\n  if (win === null) throw new Error('Axylo: the target element is not in a document with a window.');\n\n  // Cleanup in reverse order of setup; each step adds its own once it succeeded.\n  const cleanup: (() => void)[] = [];\n  const release = (): void => {\n    for (let fn = cleanup.pop(); fn; fn = cleanup.pop()) {\n      try {\n        fn();\n      } catch {\n        // Keep releasing the rest.\n      }\n    }\n  };\n\n  let controller: Controller | null = null;\n  try {\n    const requested = object(input).__renderer === 'canvas' ? 'canvas' : 'svg';\n    const id = allocateId(doc);\n\n    const renderer: MarkRenderer = requested === 'canvas' ? canvasRendererWith(composition.canvas, doc) : svgRendererWith(composition.svg, doc);\n    cleanup.push(() => renderer.destroy());\n    const textLayer: TextLayer = createTextLayer(doc);\n    cleanup.push(() => textLayer.destroy());\n    const figure: Figure = createFigure(root, id, { marks: renderer.element, text: textLayer.element });\n    cleanup.push(() => figure.destroy());\n\n    // The interaction layer is built before the controller that answers it, so its actions forward late.\n    const actions: ControllerActions = {\n      zoom: w => controller?.actions.zoom(w),\n      toggle: k => controller?.actions.toggle(k),\n      pause: p => controller?.actions.pause(p),\n      select: r => controller?.actions.select(r),\n      hover: r => controller?.actions.hover(r),\n    };\n    const interaction: Interaction = createInteraction(composition.interaction, figure, renderer, actions);\n    cleanup.push(() => interaction.destroy());\n    const measurer = createMeasurer(doc);\n    ensureStyles(doc);\n\n    // Watchers that the document holds; released while the target is out of the document.\n    let watching: (() => void) | null = null;\n    let watchedBefore = false;\n    const watch = (): void => {\n      if (watching || controller === null) return;\n      const c = controller;\n      if (watchedBefore) {\n        // Back in the document: fonts may have changed while it was out, and measurements made with the old\n        // ones must not be reused (final review, finding 14).\n        noteFontLoad(doc);\n        c.invalidate.page();\n      }\n      watchedBefore = true;\n      // Each watcher's release is registered as soon as it exists, so one that fails part-way leaves no\n      // other behind (final review, finding 14).\n      const stops: (() => void)[] = [];\n      watching = () => {\n        for (let stop = stops.pop(); stop; stop = stops.pop()) {\n          try { stop(); } catch { /* keep releasing */ }\n        }\n      };\n      try {\n        stops.push(watchTheme(root, () => c.invalidate.theme()));\n        stops.push(watchEnvironment(win, {\n          pixelRatio: () => c.invalidate.pixelRatio(),\n          motion() {\n            // Nothing is animated yet (spec I5), so there is nothing to change.\n          },\n          fonts() {\n            noteFontLoad(doc);\n            c.invalidate.fonts();\n          },\n        }));\n        stops.push(watchLanguage(root, () => c.invalidate.language()));\n        interaction.attach();\n        stops.push(() => interaction.detach());\n      } catch (error) {\n        // This attempt's subscriptions are released and the chart is not watching: the next resize\n        // notification tries again, instead of finding `watching` set and skipping setup (verification,\n        // defect 11).\n        unwatch();\n        throw error;\n/**\n * The chart controller: one implementation behind `line`, `area`, `bar`, `scatter` and `donut`, written\n * against a `Host` that supplies everything the page provides (animation frames, the figure, the mark and\n * text renderers, the interaction layer, measurement, theme resolution). The browser host is built in\n * chart.ts; Node tests supply recording substitutes and a manual frame queue.\n *\n * Two phases (plan 1.5). A call (create, update, append, zoom) resolves options, normalizes or prepares\n * what changed and builds the view synchronously, so `diagnostics` is current when it returns and a `strict`\n * chart throws from it before anything is accepted: data changes are prepared in the store and committed\n * only after the candidate view validated. Everything that needs the page runs in the next animation frame,\n * from the accepted state only, and switches together: no frame mixes two revisions. A revision's rows are\n * retired only after the frame that replaced it has been drawn, so hover, tooltip, events and `Point.row`\n * always come from the displayed revision.\n *\n * Each frame stage is cached and reruns only when its inputs change (plan 2.2). In development builds the\n * handle exposes a counter per stage (`__dev.stages()`) so tests can assert what reran.\n */\nimport {\n  SLOT_NO_ROW, SLOT_VALUE,\n  type DatumRef, type DiagnosticInput, type Formatters, type Frame, type Layout, type Lookup, type MarkRenderer,\n  type PlacedText, type ReaderModel, type ResolvedTheme, type PaintBindings, type Scene, type TextMeasurer,\n  type TextStyle, type View,\n} from './contracts';\nimport type { ChartEvents, Diagnostic, Messages, Point, Title, XValue } from '../public';\nimport type { PreparedFrame } from '../data';\nimport { resolveOptions, withoutTable, type ChartType, type ResolvedOptions } from '../data/options';\nimport { createDiagnostic, DiagnosticCollector, readerDisclosure, type DiagnosticCode } from '../diagnostics';\nimport { createFormatters, type FormatSpec } from '../format';\nimport { dateUnitOf } from '../data/x';\nimport { rowsTable, type Table } from '../data/table';\nimport { computeLayout } from '../layout';\nimport { readerWith, seriesNotDrawnSentence } from '../reader';\nimport { fill, resolveMessages } from '../messages';\nimport { lowContrastSeries, type ThemeResolution } from '../theme';\nimport { OptionsStore, sameValue, type OptionRecord } from './options';\nimport { Delivery, diagnosticKey, StrictError, strictViolations, type DeliveryConsole } from './delivery';\nimport { layoutInput, layoutKey, prepareTicks, sameKey, tickFormatFailures, type AxisContext } from './axes';\nimport { zoomApplies } from './focus';\nimport {\n  completeViewDiagnostics, dedupe, encodingChanged, isCompact, namesOnlyChanged, namingDiagnostics, object, publicOptions, stringOption,\n  titleOf, toPublic, viewKeyFor, viewStateFor, type Span,\n} from './stages';\nimport type { FigureModel } from '../dom/figure';\nimport type { Committed, ControlsState } from '../dom/interaction';\nimport type { Composition, Store } from './composition';\nimport { sameTextStyle } from './environment';\nimport { attachHooks, StageCounter, type ChartHandle, type Stage } from './instrument';\nimport { COMPOSITIONS } from '../kinds';\n\nexport type ChartKind = ChartType;\n\n/** Thrown inside a frame to stop it before anything was written (see `frame`). */\nconst ABORT = Symbol('axylo frame superseded');\n\nexport type { BenchHook, ChartHandle, DevHook, Stage } from './instrument';\n\nconst KIND_NAMES: Record<ChartKind, string> = { line: 'Line', area: 'Area', bar: 'Bar', scatter: 'Scatter', donut: 'Donut' };\nconst KIND_MESSAGES = { line: 'typeLine', area: 'typeArea', bar: 'typeBar', scatter: 'typeScatter', donut: 'typeDonut' } as const;\n/** Option resolution reports these about the data; they belong to the call that set the data. */\nconst DATA_CODES = new Set(['AX100', 'AX101']);\n/** Rows a store may hold beyond twice what was on screen before the frames that pin it copy their rows. */\nconst RETENTION_SLACK = 8;\n/**\n * Positions of the reader's inputs the summary does not read: the title, the labelledBy id and the caption\n * name the chart, and the count of hidden labels is said by the note only (reader/index.ts).\n */\nconst NAMING_INPUTS = new Set([3, 4, 9, 13]);\n\nexport interface Size {\n  readonly width: number;\n  readonly height: number;\n  /**\n   * The plot's column (the plot and, in readout mode, the strip under it): the same in both modes, so the\n   * mode decided from it does not flip with its own strip. Absent: the plot's size.\n   */\n  readonly room?: { readonly width: number; readonly height: number };\n}\n\n/** Decision 0004 revision 2, rule 5: a plot narrower or shorter than this is in readout mode. */\nconst READOUT_WIDTH = 240;\nconst READOUT_HEIGHT = 140;\n/** Where a pointed datum's values go: a floating tooltip, the reserved strip, or nowhere (rule 5). */\ntype ReadoutMode = 'floating' | 'strip' | 'none';\n/** Spec L8: the smallest plot height drawn. */\nconst MIN_PLOT_HEIGHT = 80;\n\n/** Everything the controller needs from the page. */\nexport interface Host {\n  /** Allocated, for the DOM relationships (aria-describedby, the table's id). */\n  readonly id: string;\n  /** The target element's own `id`, when it has one: an untitled chart is named by it in diagnostics. */\n  readonly targetId?: string | null;\n  readonly console: DeliveryConsole | null;\n  /** The page the once-per-code printing rule applies to. */\n  readonly page: object;\n  readonly timeZone: string;\n  readonly renderer: Pick<MarkRenderer, 'kind' | 'draw'>;\n  readonly text: { render(texts: readonly PlacedText[]): void };\n  readonly figure: { update(model: FigureModel): boolean; announce(text: string, lang?: string | null): void };\n  readonly interaction: { prepare(state: ControlsState): boolean; commit(state: Committed | null): void; clear(): void };\n  readonly measurer: TextMeasurer;\n  /** The callback gets the animation frame's time when the host has one. */\n  requestFrame(callback: (time?: number) => void): number;\n  cancelFrame(handle: number): void;\n  locale(option: unknown): string;\n  pageLang(): string | null;\n  /** Text of the page element with this id, or null when there is none. */\n  labelText(id: string): string | null;\n  textStyle(): TextStyle;\n  /**\n   * The plot container's size as the figure lays it out, with what the rest of the figure overflows by\n   * subtracted from its height (so it can be negative); null when the figure is not laid out at all (hidden\n   * or detached), which is not the same as a visible figure whose caption left no room.\n   */\n  measure(): Size | null;\n  /**\n   * The readout strip's height as it would be reserved: two line heights of the strip's own text, measured\n   * in the page (decision 0004 rule 5). Absent: estimated from the chart's text style.\n   */\n  stripHeight?(): number;\n  devicePixelRatio(): number;\n  theme(seriesKeys: readonly string[], colors: Record<string, string>): ThemeResolution;\n  /** Shows or hides the mark and text surfaces without drawing (the error revision hides them). */\n  surfaces?(visible: boolean): void;\n  /** Called once by destroy, after the controller released its own state. */\n  dispose(): void;\n}\n\n/** What the page tells the controller (observers, watchers). */\nexport interface Invalidate {\n  resize(): void;\n  /** The chart came back into the document: anything about the page may have changed meanwhile. */\n  page(): void;\n  theme(): void;\n  /** The page's language changed: locale and English marking are read again in the next frame. */\n  language(): void;\n  fonts(): void;\n  pixelRatio(): void;\n}\n\n/** What the interaction layer may ask for; everything goes through the public paths. */\nexport interface ControllerActions {\n  zoom(window: Span | null): void;\n  toggle(seriesKey: string): void;\n  pause(paused: boolean): void;\n  select(ref: DatumRef): void;\n  hover(ref: DatumRef | null): void;\n}\n\nexport interface Controller {\n/**\n * The DOM-free stages a call runs before anything is drawn (plan 1.5, 1.6): option resolution, the parts of\n * the options that decide what normalization reads, the view state, and the call-origin diagnostics the\n * view and the naming rule add. The chart controller and `validate()` both use these, so a server, a test or\n * a coding agent sees the same findings as a created chart (spec 3.5, DX8).\n */\nimport type { DiagnosticInput, Frame, View } from './contracts';\nimport type { Diagnostic, Messages, Title, XValue } from '../public';\nimport { normalize, resolveOptions, type ChartType, type ResolvedOptions } from '../data';\nimport { object } from '../data/options';\n\nexport { object };\nimport { createDiagnostic, DiagnosticCollector, report } from '../diagnostics';\nimport { buildView, type ViewState } from '../view';\nimport { fill, resolveMessages } from '../messages';\nimport { sameValue, INTERNAL_KEYS, type OptionRecord } from './options';\n\nexport type Span<T = number> = readonly [T, T];\n\nexport function titleOf(options: OptionRecord): { text: string; level: number; visible: boolean } | null {\n  const raw = options.title;\n  if (typeof raw === 'string') return raw ? { text: raw, level: 3, visible: true } : null;\n  const t = object(raw) as Partial<Title>;\n  if (typeof t.text !== 'string' || t.text === '') return null;\n  const level = typeof t.level === 'number' && t.level >= 2 && t.level <= 6 ? Math.floor(t.level) : 3;\n  return { text: t.text, level, visible: t.visible !== false };\n}\n\nexport function stringOption(options: OptionRecord, key: string): string | null {\n  const v = options[key];\n  return typeof v === 'string' && v !== '' ? v : null;\n}\n\nexport function isCompact(kind: ChartType, options: OptionRecord): boolean {\n  return (kind === 'line' || kind === 'area' || kind === 'bar') && options.compact === true;\n}\n\n/** Options without the controller's own keys (the renderer switch). */\nexport function publicOptions(input: unknown): OptionRecord {\n  if (input === null || typeof input !== 'object') return {};\n  const out: Record<string, unknown> = {};\n  for (const key of Object.keys(input)) {\n    const value = (input as Record<string, unknown>)[key];\n    // A key set to undefined is a default, as the patch rule reads it on create (finding 14: one path).\n    if (!INTERNAL_KEYS.includes(key) && value !== undefined) out[key] = value;\n  }\n  return out;\n}\n\n/** Option keys whose content normalization reads. */\nconst ENCODING_KEYS = ['x', 'y', 'series', 'label', 'value'] as const;\n/** Parts of a field spec that only the view, layout or formatting read: changing them never renormalizes. */\nconst PRESENTATION_PARTS = new Set(['domain', 'format', 'tickFormat']);\n\nfunction fieldEncoding(spec: unknown, ignore: ReadonlySet<string> = PRESENTATION_PARTS): unknown {\n  if (Array.isArray(spec)) return spec.map(item => fieldEncoding(item, ignore));\n  // 'day' and { field: 'day' } read the same field.\n  if (typeof spec === 'string') return { field: spec };\n  if (spec === null || typeof spec !== 'object') return spec;\n  const out: Record<string, unknown> = {};\n  for (const key of Object.keys(spec)) if (!ignore.has(key)) out[key] = (spec as Record<string, unknown>)[key];\n  return out;\n}\n\n/** True when the field specs differ in something normalization reads (plan 2.2: author domains belong to the view). */\nexport function encodingChanged(before: OptionRecord, after: OptionRecord): boolean {\n  return ENCODING_KEYS.some(key => !sameValue(fieldEncoding(before[key]), fieldEncoding(after[key])));\n}\n\n/** PRESENTATION_PARTS with the names (a literal: no work at import time). */\nconst NAMING_PARTS = new Set(['domain', 'format', 'tickFormat', 'label', 'unit']);\n\n/**\n * True when the field specs differ only in labels and units: the values read are the same, so the frame's\n * names can be updated without reading the data again (review 3, finding 12).\n */\nexport function namesOnlyChanged(before: OptionRecord, after: OptionRecord): boolean {\n  return ENCODING_KEYS.every(key => sameValue(fieldEncoding(before[key], NAMING_PARTS), fieldEncoding(after[key], NAMING_PARTS)));\n}\n\nexport function viewStateFor(\n  kind: ChartType, options: OptionRecord, resolved: ResolvedOptions, zoom: Span<XValue> | null,\n  previous: View | null, hidden: ReadonlySet<string>, messages: Messages,\n): ViewState {\n  if (kind === 'donut') return { kind, otherLabel: count => fill(messages.otherSlices, { count }), previous };\n  const value = resolved.values[0];\n  const common = {\n    hidden, zoom, xField: resolved.x, xDomain: resolved.x.domain, valueDomain: value?.domain ?? null,\n    valueField: value?.field, references: Array.isArray(options.reference) ? options.reference as never : [], previous,\n  };\n  // Scatter has no frame-level value scale to infer from: the declared one reaches the domain (F7).\n  if (kind === 'scatter') return { ...common, kind, valueScale: value?.scale ?? null };\n  return {\n    ...common, kind,\n    stacked: kind === 'area' ? options.stacked === true : kind === 'bar' ? options.layout === 'stacked' : false,\n    horizontal: kind === 'bar' && options.horizontal === true,\n    compact: isCompact(kind, options),\n  };\n}\n\n/** What the view depends on; equal keys mean the previous view is still right. */\nexport function viewKeyFor(\n  kind: ChartType, options: OptionRecord, resolved: ResolvedOptions, frame: Frame, zoom: Span<XValue> | null,\n  hidden: ReadonlySet<string>, messages: Messages,\n): readonly unknown[] {\n  return [frame, zoom, [...hidden].sort().join('\\u0000'), resolved.x.domain, resolved.values[0]?.domain, options.reference,\n    options.stacked, options.layout, options.horizontal, options.compact, kind === 'donut' ? messages.otherSlices : null];\n}\n\n/**\n * The view reports AX110, AX130 and AX131 only when they are new against the previous view it reuses. The\n * chart keeps the complete set: a finding the previous view had is kept while its condition still holds.\n */\nexport function completeViewDiagnostics(\n  kind: ChartType, found: readonly DiagnosticInput[], before: readonly DiagnosticInput[], view: View, state: ViewState,\n): DiagnosticInput[] {\n  const out = [...found];\n  if (view.kind === 'donut') return out;\n  const has = (code: string) => out.some(d => d.code === code);\n  const series = view.frame.series.length;\n  const domain = 'valueDomain' in state ? state.valueDomain : null;\n  const stillHolds: Record<string, boolean> = {\n    AX130: series > 8,\n    AX131: view.compact && series > 1,\n    AX110: (kind === 'bar' || kind === 'area') && domain !== null && domain !== undefined &&\n/** The line chart's stages (core/composition.ts): aligned data, line and point marks, x cursor. */\nimport type { Composition } from '../core/composition';\nimport { alignedTargetMarks } from '../core/focus';\nimport { normalizeAligned } from '../data/normalize';\nimport { openAlignedStore } from '../data/store';\nimport { buildAlignedView } from '../view';\nimport { lineScene } from '../scene';\nimport { alignedLookupFor } from '../lookup';\nimport { alignedReader } from '../reader';\nimport { lineSwatch } from '../dom/interaction';\nimport { svgBand, svgPath, svgPoints, svgRule } from '../render/svg';\nimport { canvasBand, canvasPath, canvasPoints, canvasRule } from '../render/canvas';\n\nexport const LINE: Composition = {\n  kind: 'line',\n  normalize: normalizeAligned as Composition['normalize'],\n  openStore: openAlignedStore as Composition['openStore'],\n  view: buildAlignedView as Composition['view'],\n  scene: lineScene,\n  lookup: alignedLookupFor,\n  reader: alignedReader,\n  interaction: { overlay: alignedTargetMarks, swatch: lineSwatch, stepInSeries: null, sliceList: null },\n  // Lines and markers, references (bands and rules), axes and the cursor (rules), focus points.\n  svg: { path: svgPath, points: svgPoints, rule: svgRule, band: svgBand },\n  canvas: { path: canvasPath, points: canvasPoints, rule: canvasRule, band: canvasBand },\n};\n","exit_code":0,"status":"completed"}}
