ser+browser+browser,bar=browser+browser+browser+browser+browser+browser+browser,scatter=browser+browser+browser+browser+browser+browser+browser,donut=browser+browser+browser+browser+browser+browser+browser,compact=browser+browser+browser+browser+browser+browser+browser gaps:line,area,bar,scatter,donut,compact\nDX11 evidence:line=unit+unit+unit+unit+unit+unit,area=unit+unit+unit+unit+unit+unit,bar=unit+unit+unit+unit+unit+unit,scatter=unit+unit+unit+unit+unit+unit,donut=unit+unit+unit+unit+unit+unit,compact=unit+unit+unit+unit+unit+unit gaps:line,area,bar,scatter,donut,compact\nDX12 pending:line,area,bar,scatter,donut,compact\nP1 pending:line\nP2 pending:line\nP3 pending:line,area,bar,scatter,donut,compact\nP4 pending:line,area,bar,scatter\nP5 pending:line\nP7 weak:line=unit+browser+browser pending:line,area,bar,scatter,donut,compact\nP8 pending:compact\n{\n  \"id\": \"DX12\",\n  \"statement\": \"Given fixed prompts and trap fixtures (UTC-midnight ISO dates, numeric strings, unsorted rows, missing days, a misspelled field), a coding agent with only the published docs makes a first chart with no error diagnostics that passes the reader criteria; recorded as agent rehearsal, not as user evidence.\",\n  \"appliesTo\": [\n    \"line\",\n    \"area\",\n    \"bar\",\n    \"scatter\",\n    \"donut\",\n    \"compact\"\n  ],\n  \"notApplicable\": {},\n  \"pending\": {\n    \"line\": \"Not done yet: the scripted agent rehearsal has not been run (STATUS.md, next actions, 2026-11-18), and the repository holds no rehearsal script, prompt set or trap fixtures for the rehearsal (the documentation's examples cover dates, missing data, numeric strings and unsorted input, but they are not the rehearsal's traps). When it is run, it is recorded as agent rehearsal, not as user evidence.\",\n    \"area\": \"Not done yet: the scripted agent rehearsal has not been run (STATUS.md, next actions, 2026-11-18), and the repository holds no rehearsal script, prompt set or trap fixtures for the rehearsal (the documentation's examples cover dates, missing data, numeric strings and unsorted input, but they are not the rehearsal's traps). When it is run, it is recorded as agent rehearsal, not as user evidence.\",\n    \"bar\": \"Not done yet: the scripted agent rehearsal has not been run (STATUS.md, next actions, 2026-11-18), and the repository holds no rehearsal script, prompt set or trap fixtures for the rehearsal (the documentation's examples cover dates, missing data, numeric strings and unsorted input, but they are not the rehearsal's traps). When it is run, it is recorded as agent rehearsal, not as user evidence.\",\n    \"scatter\": \"Not done yet: the scripted agent rehearsal has not been run (STATUS.md, next actions, 2026-11-18), and the repository holds no rehearsal script, prompt set or trap fixtures for the rehearsal (the documentation's examples cover dates, missing data, numeric strings and unsorted input, but they are not the rehearsal's traps). When it is run, it is recorded as agent rehearsal, not as user evidence.\",\n    \"donut\": \"Not done yet: the scripted agent rehearsal has not been run (STATUS.md, next actions, 2026-11-18), and the repository holds no rehearsal script, prompt set or trap fixtures for the rehearsal (the documentation's examples cover dates, missing data, numeric strings and unsorted input, but they are not the rehearsal's traps). When it is run, it is recorded as agent rehearsal, not as user evidence.\",\n    \"compact\": \"Not done yet: the scripted agent rehearsal has not been run (STATUS.md, next actions, 2026-11-18), and the repository holds no rehearsal script, prompt set or trap fixtures for the rehearsal (the documentation's examples cover dates, missing data, numeric strings and unsorted input, but they are not the rehearsal's traps). When it is run, it is recorded as agent rehearsal, not as user evidence.\"\n  }\n}\nimport { fileURLToPath } from 'node:url';\nimport { defineConfig } from 'vitest/config';\n\n// The documentation's tests alone, with the same split as the root vitest.config.ts (which includes them\n// too): unit tests in Node, and browser tests (*.browser.test.ts) against the packed library and the built\n// site when AXYLO_BROWSER is set.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    root: fileURLToPath(new URL('../..', import.meta.url)),\n    // The Node examples run against the packed package, from node.browser.test.ts, after the build.\n    include: process.env.AXYLO_BROWSER ? ['apps/docs/test/**/*.browser.test.ts'] : ['apps/docs/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 30000,\n    hookTimeout: 120000,\n    fileParallelism: false,\n  },\n});\nimport { execFileSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport { lstatSync, readFileSync, readlinkSync } from 'node:fs';\nimport { resolve } from 'node:path';\nimport { PACKAGES } from '../scripts/pack.mjs';\n\nconst kinds = new Set(['unit', 'property', 'browser']);\nconst sha = value => createHash('sha256').update(value).digest('hex');\n\nexport const hashFile = file => sha(readFileSync(file));\n\n/** The browser engines the browser harness can run (AXYLO_ENGINE), and how a report names each one. */\nexport const ENGINES = ['chromium', 'firefox', 'webkit'];\nconst ENGINE_LABELS = { chromium: 'Chrome', firefox: 'Firefox (Playwright)', webkit: 'WebKit (Playwright), not Safari' };\nexport const engineLabel = (engine, version) => `${ENGINE_LABELS[engine] ?? engine}${version ? ' ' + version : ''}`;\n\n/**\n * The engines a Vitest JSON report declares: the harness writes `meta.engine` and `meta.engineVersion` on\n * every test it runs. A test without them was not run through that harness.\n */\nexport function declaredEngines(results) {\n  const engines = new Set();\n  const versions = new Set();\n  for (const suite of results?.testResults ?? []) for (const test of suite?.assertionResults ?? []) {\n    const engine = test?.meta?.engine;\n    if (engine === undefined) continue;\n    if (!ENGINES.includes(engine)) throw new Error(`unknown engine ${JSON.stringify(engine)} in ${suite.name}: ${test.title}`);\n    engines.add(engine);\n    if (typeof test.meta.engineVersion === 'string' && test.meta.engineVersion !== '') versions.add(`${engine} ${test.meta.engineVersion}`);\n  }\n  return { engines: [...engines].sort(), versions: [...versions].sort() };\n}\n\n/**\n * The Vitest configurations acceptance/run.mjs records, each with its Vitest arguments. `browser` runs on the\n * engine AXYLO_ENGINE names; `dist-browser` launches system Chrome itself; `unit` and `dist` run in Node.\n */\nexport const CONFIGURATIONS = Object.freeze({\n  unit: Object.freeze([]),\n  browser: Object.freeze([]),\n  dist: Object.freeze(['--config', 'tests/dist/vitest.config.ts']),\n  'dist-browser': Object.freeze(['--config', 'tests/dist/vitest.config.ts']),\n});\nexport const CONFIGS = Object.freeze(Object.keys(CONFIGURATIONS));\n\n/** Where a configuration's results go by default: the browser configuration gets one file per engine. */\nexport const defaultResultFile = (name, engine = 'chromium') =>\n  `acceptance/results/${name === 'browser' && engine !== 'chromium' ? `${name}-${engine}` : name}.json`;\n\n/**\n * Every default result file run.mjs can write, repository-relative, with its configuration and the engine\n * its tests run on (null: Node).\n */\nexport function resultFiles() {\n  return CONFIGS.flatMap(config => config === 'browser'\n    ? ENGINES.map(engine => ({ config, engine, file: defaultResultFile(config, engine) }))\n    : [{ config, engine: config === 'dist-browser' ? 'chromium' : null, file: defaultResultFile(config) }]);\n}\n\nexport function citedTestFiles(matrix) {\n  const files = new Set();\n  for (const row of matrix) {\n    for (const citations of [row.evidence, row.weak]) {\n      for (const refs of Object.values(citations ?? {})) {\n        for (const { kind, file } of refs) if (kinds.has(kind)) files.add(file);\n      }\n    }\n  }\n  return [...files].sort();\n}\n\nexport function snapshot(root, files) {\n  const git = (...args) => execFileSync('git', args, { cwd: root, encoding: 'utf8', stdio: ['ignore', 'pipe', 'inherit'], maxBuffer: 64 * 1024 * 1024 });\n  const commit = git('rev-parse', 'HEAD').trim();\n  const status = git('status', '--porcelain=v1', '-z', '--untracked-files=all', '--', '.', ':(exclude)acceptance/report.md');\n  const tree = createHash('sha256').update(status);\n  // A dirty flag alone cannot distinguish two edits to the same library file.\n  const changed = new Set(git('ls-files', '-m', '-o', '--exclude-standard', '-z').split('\\0'));\n  for (const file of [...changed].sort()) {\n    if (!file || file === 'acceptance/report.md') continue;\n    const path = resolve(root, file);\n    const stat = lstatSync(path, { throwIfNoEntry: false });\n    const content = stat?.isSymbolicLink() ? readlinkSync(path) : stat?.isFile() ? readFileSync(path) : '';\n    tree.update(JSON.stringify([file, stat?.mode, sha(content)]));\n  }\n  // Include edits staged against HEAD even when the index matches the working file.\n  tree.update(git('diff', '--cached', '--binary', 'HEAD', '--', '.', ':(exclude)acceptance/report.md'));\n  // A cited file that is gone is the matrix's structural error, which the checker reports; the run still records.\n  const hashes = Object.fromEntries(files.map(file => [file, lstatSync(resolve(root, file), { throwIfNoEntry: false })?.isFile() ? hashFile(resolve(root, file)) : null]));\n  return { commit, dirty: status.length > 0, tree: tree.digest('hex'), hashes };\n}\n\n/**\n * The integrity of the tarball the current tree packs, per package of scripts/pack.mjs: `npm pack` with the\n * same flags as pack(), as a dry run (npm computes the same tarball and integrity without writing it). A size\n * record counts only when it measured this tarball.\n */\nexport function packIntegrity(root, name = 'axylo') {\n  const out = execFileSync('npm', ['pack', '--dry-run', '--json', '--ignore-scripts'], {\n    cwd: resolve(root, PACKAGES[name]), encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'],\n  });\n  return JSON.parse(out)[0].integrity;\n}\n","exit_code":0,"status":"completed"}}
