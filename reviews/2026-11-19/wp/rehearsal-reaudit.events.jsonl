{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'cat rehearsal/summary.mjs rehearsal/protocol.mjs rehearsal/files.mjs rehearsal/grade.mjs && cat rehearsal/vitest.config.mjs'","aggregated_output":"import { resolve } from 'node:path';\nimport { parseArgs } from 'node:util';\nimport { isMain } from './files.mjs';\nimport { defaultRecords, models, readRecords, summarize } from './protocol.mjs';\n\nexport function formatSummary(records) {\n  const summary = summarize(records);\n  const lines = ['agent rehearsal: these prompts, these models, Chrome; not user evidence'];\n  const headings = ['Agent', 'Task', 'Pass', 'Counted', 'Fail', 'Timeout', 'Void', 'Infrastructure', 'Rule met'];\n  const countKeys = ['pass', 'attempts', 'fail', 'timeout', 'void', 'infrastructure'];\n  const totals = countKeys.map(key => summary.rows.reduce((total, row) => total + row[key], 0));\n  const rows = [\n    ...summary.rows.map(row => [row.agent, row.task, ...countKeys.map(key => row[key]), row.meetsRule ? 'yes' : 'no']),\n    ['Total', '', ...totals, ''],\n  ].map(row => row.map(String));\n  const widths = headings.map((heading, i) => Math.max(heading.length, ...rows.map(row => row[i].length)));\n  for (const row of [headings, ...rows]) lines.push(row.map((value, i) => value.padEnd(widths[i])).join('  ').trimEnd());\n  for (const [agent, requested] of Object.entries(models)) {\n    const observed = [...new Set(records.filter(run => run.agent === agent).map(run => run.observed?.model).filter(Boolean))];\n    lines.push(`${agent} requested ${requested}; observed ${observed.join(', ') || 'none'}.`);\n  }\n  for (const run of records.filter(run => run.reason || (run.status && run.status !== 'pass'))) {\n    const reason = run.reason ? ' — ' + run.reason : '';\n    const replacement = run.replaces ? ' (replaces ' + run.replaces + ')' : '';\n    lines.push(`${run.name}: ${run.status ?? 'incomplete'}${reason}${replacement}`);\n  }\n  if (!summary.comparable) lines.push('The records are incomplete, legacy, or mix rehearsal inputs, graders, CLI or browser versions, or observed models.');\n  lines.push(summary.pass ? 'rehearsal rule met' : 'rehearsal rule not met');\n  return lines.join('\\n');\n}\n\nif (isMain(import.meta.url)) {\n  const { values } = parseArgs({ options: { records: { type: 'string', default: defaultRecords } } });\n  console.log(formatSummary(await readRecords(resolve(values.records))));\n}\nimport { createHash } from 'node:crypto';\nimport { lstat, readFile, readdir } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport { agentErrors } from './agent.mjs';\nimport { readJson, rehearsal, repository, taskFiles, tasks } from './files.mjs';\nimport { packedPackage } from './workspace.mjs';\n\nexport const protocol = 1;\nexport const models = { codex: 'gpt-6.2-sol', claude: 'claude-opus-5-5' };\nexport const effort = 'xhigh';\nexport const timeoutMs = 20 * 60 * 1000;\nexport const target = 3;\nexport const defaultRecords = join(rehearsal, 'records');\nexport const cells = Object.keys(models).flatMap(agent => tasks.map(task => ({ agent, task })));\nexport const counted = ['pass', 'fail', 'timeout'];\n\nconst digest = data => createHash('sha256').update(data).digest('hex');\nconst fileHash = async file => digest(await readFile(file));\n\nasync function treeHash(directory) {\n  if (!(await lstat(directory)).isDirectory()) throw new Error('Expected an input directory: ' + directory);\n  const tree = await readdir(directory, { recursive: true, withFileTypes: true });\n  if (tree.some(entry => !entry.isDirectory() && !entry.isFile())) throw new Error('Unexpected entry in input tree: ' + directory);\n  const files = tree.filter(entry => entry.isFile()).map(entry => join(entry.parentPath, entry.name).slice(directory.length + 1)).sort();\n  const entries = await Promise.all(files.map(async file => [file, await fileHash(join(directory, file))]));\n  return digest(JSON.stringify(entries));\n}\n\nconst stagedFiles = { prompt: 'PROMPT.md', input: 'data.json', manifest: 'package.json' };\n\nasync function stagedHashes(workspace) {\n  const files = Object.entries(stagedFiles).map(async ([key, name]) => {\n    const file = join(workspace, name);\n    if (!(await lstat(file)).isFile()) throw new Error('Expected a regular input file: ' + file);\n    return [key, await fileHash(file)];\n  });\n  const entries = await Promise.all([\n    treeHash(join(workspace, 'docs')).then(hash => ['docs', hash]),\n    treeHash(join(workspace, 'node_modules')).then(hash => ['installedPackage', hash]),\n    ...files,\n  ]);\n  return Object.fromEntries(entries);\n}\n\nexport async function inputChanges(workspace, original) {\n  try {\n    const current = await stagedHashes(workspace);\n    return Object.keys(current).filter(key => current[key] !== original[key]).join(', ');\n  } catch (error) {\n    return error.message;\n  }\n}\n\nexport async function inputHashes(workspace, task) {\n  const { alternate, expected, alternateExpected } = taskFiles(task);\n  const sources = {\n    package: fileHash(packedPackage),\n    alternate: fileHash(alternate),\n    expected: fileHash(expected),\n    alternateExpected: fileHash(alternateExpected),\n    grader: Promise.all([\n      ...['grade.mjs', 'reader.mjs', 'table.mjs', 'files.mjs'].map(file => fileHash(join(rehearsal, file))),\n      fileHash(join(repository, 'packages/axylo/src/diagnostics/registry.ts')),\n    ]).then(hashes => digest(JSON.stringify(hashes))),\n  };\n  const [staged, entries] = await Promise.all([\n    stagedHashes(workspace),\n    Promise.all(Object.entries(sources).map(async ([key, hash]) => [key, await hash])),\n  ]);\n  return { ...staged, ...Object.fromEntries(entries) };\n}\n\nexport async function readRecords(root) {\n  const entries = await readdir(root, { withFileTypes: true }).catch(error => {\n    if (error.code === 'ENOENT') return [];\n    throw error;\n  });\n  const records = await Promise.all(entries.filter(entry => entry.isDirectory()).map(async ({ name }) => {\n    try {\n      const directory = join(root, name);\n      const record = { ...await readJson(join(directory, 'run.json')), name };\n      if (record.protocol === protocol && record.status === 'fail' && record.exit && Object.hasOwn(models, record.agent)) {\n        // Reopen older slots when the saved CLI evidence identifies an infrastructure failure.\n        const transcript = await readFile(join(directory, 'transcript.jsonl'), 'utf8').catch(error => {\n          if (error.code === 'ENOENT') return null;\n          throw error;\n        });\n        if (transcript !== null) {\n          const { infrastructure } = agentErrors(record.agent, transcript, record.exit);\n          if (infrastructure) return { ...record, status: 'infrastructure', reason: infrastructure };\n        }\n      }\n      return record;\n    } catch (error) {\n      return { name, reason: String(error) };\n    }\n  }));\n  return records.sort((a, b) => (a.startedAt ?? '').localeCompare(b.startedAt ?? '') || a.name.localeCompare(b.name));\n}\n\nexport function cellRecords(records, agent, task) {\n  return records.filter(record => record.protocol === protocol && record.agent === agent && record.task === task);\n}\n\nexport function nextAttempts(records, cell, attempts) {\n  const previous = cellRecords(records, cell.agent, cell.task);\n  return Array.from({ length: attempts }, (_, index) => index + 1).flatMap(slot => {\n    const entries = previous.filter(record => record.slot === slot);\n    if (entries.some(record => counted.includes(record.status))) return [];\n    return [{ ...cell, slot, replaces: entries.at(-1)?.name ?? null }];\n  });\n}\n\nexport function observedMatches(agent, observed = {}) {\n  const { model, models: seen, effort: observedEffort } = observed;\n  if (agent === 'codex') return model === models.codex && observedEffort === effort;\n  return seen?.length === 1 && (model === models.claude || /^claude-opus-5-5-\\d{8}$/.test(model));\n}\n\nfunction incompleteOrMixed(records, results) {\n  if (records.some(record => record.protocol !== protocol || !Object.hasOwn(models, record.agent) ||\n      !tasks.includes(record.task) || ![...counted, 'void', 'infrastructure'].includes(record.status))) return true;\n  const distinct = (runs, lookup) => new Set(runs.map(lookup)).size;\n  if (results.some(record => !record.hashes || !record.cli?.version ||\n      record.requested?.model !== models[record.agent] || record.requested?.effort !== effort ||\n      record.timeoutMs !== timeoutMs || (record.status === 'pass' &&\n        (!record.browserVersion || !observedMatches(record.agent, record.observed))))) return true;\n  if (distinct(results, run => JSON.stringify([run.hashes.grader, run.hashes.docs, run.hashes.package, run.hashes.installedPackage])) > 1) return true;\n  if (distinct(results.filter(run => run.browserVersion), run => run.browserVersion) > 1) return true;\n  for (const agent of Object.keys(models)) {\n    const runs = results.filter(run => run.agent === agent);\n    if (distinct(runs, run => run.cli.version) > 1 ||\n        distinct(runs.filter(run => run.observed?.model), run => run.observed.model) > 1) return true;\n  }\n  return tasks.some(task => distinct(results.filter(run => run.task === task), run => JSON.stringify(run.hashes)) > 1);\n}\n\nexport function summarize(records) {\n  const results = records.filter(record => record.protocol === protocol && counted.includes(record.status));\n  const rows = cells.map(({ agent, task }) => {\n    const all = cellRecords(records, agent, task);\n    const attempts = all.filter(record => counted.includes(record.status));\n    const counts = Object.fromEntries([...counted, 'void', 'infrastructure'].map(status =>\n      [status, all.filter(record => record.status === status).length]));\n    return { agent, task, attempts: attempts.length, ...counts,\n      meetsRule: counts.pass >= 2 && attempts.length === target &&\n        [1, 2, 3].every(slot => attempts.some(run => run.slot === slot)) };\n  });\n  const comparable = !incompleteOrMixed(records, results);\n  return { rows, comparable, pass: comparable && rows.every(row => row.meetsRule) };\n}\nimport { readFile, rename, rm, writeFile } from 'node:fs/promises';\nimport { randomUUID } from 'node:crypto';\nimport { isAbsolute, join, relative, sep } from 'node:path';\nimport { fileURLToPath, pathToFileURL } from 'node:url';\n\nexport const rehearsal = fileURLToPath(new URL('.', import.meta.url));\nexport const repository = fileURLToPath(new URL('..', import.meta.url));\nexport const tasks = ['daily-visits', 'regional-sales', 'signups', 'daily-revenue'];\n\nexport function inside(root, file) {\n  const path = relative(root, file);\n  return path !== '..' && !path.startsWith('..' + sep) && !isAbsolute(path);\n}\n\nexport function taskFiles(task) {\n  if (!task || !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(task)) throw new Error('Supply a task ID from rehearsal/prompts.');\n  return {\n    prompt: join(rehearsal, 'prompts', task + '.md'),\n    fixture: join(rehearsal, 'fixtures', task + '.json'),\n    expected: join(rehearsal, 'fixtures', task + '.expected.json'),\n    alternate: join(rehearsal, 'fixtures', task + '.alternate.json'),\n    alternateExpected: join(rehearsal, 'fixtures', task + '.alternate.expected.json'),\n  };\n}\n\nexport async function readJson(file) {\n  return JSON.parse(await readFile(file, 'utf8'));\n}\n\nexport async function writeJson(file, value) {\n  const temporary = file + '.' + randomUUID() + '.tmp';\n  try {\n    await writeFile(temporary, JSON.stringify(value, null, 2) + '\\n', { flag: 'wx' });\n    await rename(temporary, file);\n  } finally {\n    await rm(temporary, { force: true });\n  }\n}\n\nexport function isMain(url) {\n  return !!process.argv[1] && pathToFileURL(process.argv[1]).href === url;\n}\nimport { lstat, readFile, realpath } from 'node:fs/promises';\nimport { basename, join, resolve } from 'node:path';\nimport { parseArgs } from 'node:util';\nimport { build } from 'esbuild';\nimport { chromium } from 'playwright-core';\nimport { inside, isMain, readJson, repository, taskFiles, writeJson } from './files.mjs';\nimport { dateCheck, noteCheck, plotCheck, titleCheck } from './reader.mjs';\nimport { compareHeaders, compareRows, normalizedText } from './table.mjs';\n\nconst zones = ['America/Los_Angeles', 'Asia/Tokyo'];\nconst timeout = 5000;\nconst origin = 'https://axylo-rehearsal.invalid';\nconst criteriaNames = ['render', 'no error diagnostics', 'accessible name', 'visible title', 'table caption',\n  'table headers', 'table rows', 'plotted x order', 'drawn gaps', 'reader date', 'reader note', 'chart type'];\nconst criterion = (name, pass, detail) => ({ name, pass, detail });\n\nasync function registryLevels() {\n  const registry = await readFile(join(repository, 'packages/axylo/src/diagnostics/registry.ts'), 'utf8');\n  const levels = new Map([...registry.matchAll(/^\\s*(AX\\d+): \\{ level: '(error|warning|hint)'/gm)]\n    .map(([, code, level]) => [code, level]));\n  if (levels.get('AX101') !== 'error' || levels.get('AX140') !== 'warning') {\n    throw new Error('Could not read diagnostic levels from the Axylo registry.');\n  }\n  return levels;\n}\n\nasync function bundle(workspace, data) {\n  const result = await build({\n    absWorkingDir: workspace,\n    stdin: {\n      resolveDir: workspace,\n      contents: `\n        import * as answer from './chart.js';\n        try {\n          const render = Reflect.get(answer, 'default');\n          if (typeof render !== 'function') throw new Error('chart.js must default-export a render function.');\n          const handle = render(document.getElementById('chart'), ${JSON.stringify(data)});\n          if (!handle || typeof handle.update !== 'function' || typeof handle.destroy !== 'function' ||\n              !Array.isArray(handle.diagnostics)) {\n            throw new Error('render must return the Axylo chart handle.');\n          }\n          window.rehearsalRender = { handle };\n        } catch (error) {\n          window.rehearsalRender = { error: String(error), diagnostics: error?.diagnostics };\n        }\n      `,\n    },\n    bundle: true,\n    format: 'iife',\n    platform: 'browser',\n    conditions: ['browser'],\n    write: false,\n    outfile: 'chart-bundle.js',\n    logLevel: 'silent',\n    plugins: [{\n      name: 'workspace-files',\n      setup(builder) {\n        builder.onLoad({ filter: /.*/, namespace: 'file' }, async args => {\n          if (!inside(workspace, await realpath(args.path))) {\n            return { errors: [{ text: 'Import outside the rehearsal workspace: ' + args.path }] };\n          }\n        });\n      },\n    }],\n  });\n  return new Map(result.outputFiles.map(file => ['/' + basename(file.path), file.text]));\n}\n\nconst html = `<!doctype html><html lang=\"en-US\"><meta charset=\"utf-8\">\n<title>Axylo rehearsal</title><link rel=\"stylesheet\" href=\"/chart-bundle.css\">\n<div id=\"chart\" style=\"width:720px;height:400px\"></div><script src=\"/chart-bundle.js\"></script></html>`;\n\nasync function inspect(browser, files, expected, levels, timezoneId, input) {\n  const context = await browser.newContext({ timezoneId, locale: 'en-US', serviceWorkers: 'block' });\n  const criteria = [];\n  const diagnostics = new Map();\n  const errors = [];\n  let table;\n  const addDiagnostic = (code, diagnostic, source) => {\n    const previous = diagnostics.get(code);\n    diagnostics.set(code, {\n      ...previous, ...diagnostic, code, level: levels.get(code) ?? diagnostic.level ?? 'unknown', timezoneId,\n      sources: [...new Set([...(previous?.sources ?? []), source])],\n    });\n  };\n\n  try {\n    await context.route('**/*', route => {\n      const url = new URL(route.request().url());\n      if (url.origin !== origin) return route.abort();\n      if (url.pathname === '/') {\n        return route.fulfill({\n          contentType: 'text/html',\n          body: html,\n          headers: {\n            'Content-Security-Policy': \"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\",\n          },\n        });\n      }\n      if (url.pathname.endsWith('.css')) {\n        return route.fulfill({ contentType: 'text/css', body: files.get(url.pathname) ?? '' });\n      }\n      const script = files.get(url.pathname);\n      return script === undefined ? route.abort() : route.fulfill({ contentType: 'text/javascript', body: script });\n    });\n\n    const page = await context.newPage();\n    page.setDefaultTimeout(timeout);\n    page.on('pageerror', error => errors.push(String(error)));\n    page.on('console', message => {\n      const text = message.text();\n      const code = /\\[axylo (AX\\d+)\\]/.exec(text)?.[1];\n      if (code) addDiagnostic(code, { console: text }, 'console');\n    });\n    await page.goto(origin, { waitUntil: 'load', timeout });\n    const problem = await page.evaluate(() => window.rehearsalRender?.error ?? null);\n    const figure = page.locator('#chart figure');\n    let state = '';\n    if (!problem && errors.length === 0) {\n      await page.waitForFunction(() => new Promise(done => {\n        requestAnimationFrame(() => requestAnimationFrame(() => done(true)));\n      }));\n\n      if (await figure.count() === 1) {\n        const byName = page.getByRole('group', { name: expected.title, exact: true })\n          .or(page.getByRole('figure', { name: expected.title, exact: true }))\n          .or(page.getByRole('img', { name: expected.title, exact: true }));\n        const titlePass = await figure.and(byName).count() === 1;\n        const name = titlePass ? expected.title : (await figure.ariaSnapshot()).split('\\n')[0];\n        criteria.push(criterion('accessible name', titlePass, name || 'No accessible figure name.'));\n        criteria.push({ name: 'visible title', ...await titleCheck(figure) });\n        state = (await figure.locator('.axylo-message:visible').allTextContents()).join(' ');\n        const description = (await figure.locator('.axylo-description').allTextContents())[0] ?? '';\n        const types = await figure.locator('[aria-roledescription]').evaluateAll(nodes =>\n          nodes.map(node => node.getAttribute('aria-roledescription')));\n        const observedType = (types.find(type => /^(?:line|area|bar|scatter|donut) chart$/i.test(type)) ?? description)\n          .match(/^(line|area|bar|scatter|donut) chart\\b/i)?.[1].toLowerCase();\n        criteria.push(criterion('chart type', observedType === expected.type,\n          `Expected ${expected.type}, saw ${observedType ?? 'no chart type'}.`));\n\n        const plot = await plotCheck(figure, expected);\n        criteria.push({ name: 'plotted x order', ...plot.order }, { name: 'drawn gaps', ...plot.gaps });\n        criteria.push({ name: 'reader date', ...await dateCheck(figure, expected) });\n        criteria.push({ name: 'reader note', ...await noteCheck(page, figure, expected.valuesNotShown) });\n        try {\n          const button = figure.getByRole('button', { name: 'View as table', exact: true });\n          if (await button.count() === 1) {\n            await button.click();\n            const view = figure.getByRole('table');\n            if (await view.count() === 1 && await view.isVisible()) {\n              table = await view.evaluate(element => ({\n                caption: element.caption?.textContent ?? '',\n                headers: Array.from(element.tHead?.rows[0]?.cells ?? [], cell => cell.textContent.trim()),\n                rows: Array.from(element.tBodies[0]?.rows ?? [], row =>\n                  Array.from(row.cells, cell => cell.textContent.trim())),\n              }));\n              const named = await view.and(figure.getByRole('table', { name: expected.title, exact: true })).count() === 1;\n              criteria.push(criterion('table caption', named && normalizedText(table.caption) === expected.title,\n                table.caption || 'No table caption.'));\n              const header = compareHeaders(expected, table.headers);\n              const semantic = await view.getByRole('columnheader').count() === table.headers.length &&\n                await view.getByRole('rowheader').count() === table.rows.length;\n              criteria.push(criterion('table headers', header.pass && semantic,\n                header.detail + (semantic ? '' : ' Missing semantic row or column headers.')));\n              table.order = header.pass ? header.order : undefined;\n            }\n          }\n          if (!table) {\n            criteria.push(criterion('table rows', false, 'Could not open one visible table with “View as table”.'));\n          } else if (await figure.getByRole('button', { name: 'Next page', exact: true }).count()) {\n            criteria.push(criterion('table rows', false, 'Unexpected additional table pages.'));\n          } else {\n            const compared = compareRows(expected, table.rows, table.order);\n            criteria.push(criterion('table rows', compared.pass, compared.detail));\n          }\n        } catch (error) {\n          criteria.push(criterion('table rows', false, String(error)));\n        }\n      }\n    }\n\n    const handleDiagnostics = await page.evaluate(() => {\n      const result = window.rehearsalRender;\n      return result?.handle?.diagnostics ?? result?.diagnostics ?? [];\n    });\n    for (const { code, level, message } of handleDiagnostics) addDiagnostic(code, { level, message }, 'handle');\n    const errorCodes = [...diagnostics.values()].filter(d => d.level === 'error').map(d => d.code);\n    const errorState = ['Loading chart.', 'No data to show.'].includes(state) ? '' : state;\n    criteria.push(criterion('no error diagnostics', !errorState && errorCodes.length === 0,\n      [...errorCodes, errorState].filter(Boolean).join(' | ') || 'No error diagnostics or error state.'));\n    const title = criteria.find(item => item.name === 'accessible name');\n    if (title && diagnostics.has('AX140')) {\n      title.pass = false;\n      title.detail += ' (AX140)';\n    }\n\n    const reason = problem || errors.join(' | ') || (await figure.count() !== 1 && 'Expected one Axylo figure in #chart.');\n    criteria.push(criterion('render', !reason, reason || 'Rendered a chart and returned its handle.'));\n  } catch (error) {\n    criteria.push(criterion('render', false, String(error)));\n  } finally {\n    await context.close();\n  }\n\n  return {\n    input,\n    timezoneId,\n    criteria: criteriaNames.map(name => criteria.find(item => item.name === name) ??\n      criterion(name, false, 'Unavailable after render failure.')),\n    diagnostics: [...diagnostics.values()],\n    ...(table ? { table } : {}),\n  };\n}\n\nexport async function grade(workspace, task, { launch = () => chromium.launch({ channel: 'chrome', headless: true, timeout: 15000 }) } = {}) {\n  workspace = await realpath(workspace);\n  const taskPaths = taskFiles(task);\n  const inputs = await Promise.all([\n    ['primary', taskPaths.fixture, taskPaths.expected],\n    ['alternate', taskPaths.alternate, taskPaths.alternateExpected],\n  ].map(async ([name, fixture, expected]) => ({ name, data: await readJson(fixture), expected: await readJson(expected) })));\n  const save = async result => {\n    await writeJson(join(workspace, 'grade.json'), result);\n    return result;\n  };\n  const fail = (name, detail) => save({ pass: false, criteria: [criterion(name, false, detail)], diagnostics: [], timezones: [] });\n\n  let bundles;\n  try {\n    if (!(await lstat(join(workspace, 'chart.js'))).isFile()) {\n      return fail('render', 'chart.js must be a regular file.');\n    }\n    // Grade the original fixture even if the agent changed its local copy while experimenting.\n    bundles = await Promise.all(inputs.map(async input => ({ ...input, files: await bundle(workspace, input.data) })));\n  } catch (error) {\n    return fail('render', error.code === 'ENOENT' ? 'chart.js is missing.' : String(error));\n  }\n\n  const levels = await registryLevels();\n  let browser;\n  try {\n    browser = await launch();\n  } catch (error) {\n    return fail('browser', String(error));\n  }\n  try {\n    const timezones = [];\n    for (const { name, files, expected } of bundles) {\n      for (const timezoneId of zones) timezones.push(await inspect(browser, files, expected, levels, timezoneId, name));\n    }\n    const criteria = criteriaNames.map(name => {\n      const results = timezones.map(zone => zone.criteria.find(item => item.name === name));\n      return criterion(name, results.every(item => item.pass),\n        results.map((item, index) => `${timezones[index].input} / ${timezones[index].timezoneId}: ${item.detail}`).join(' | '));\n    });\n    return await save({\n      pass: criteria.every(item => item.pass),\n      browserVersion: browser.version(),\n      criteria,\n      diagnostics: timezones.flatMap(zone => zone.diagnostics),\n      timezones,\n    });\n  } catch (error) {\n    if (!browser.isConnected()) return fail('browser', String(error));\n    throw error;\n  } finally {\n    await browser.close();\n  }\n}\n\nif (isMain(import.meta.url)) {\n  try {\n    const { values } = parseArgs({ options: { task: { type: 'string' }, workdir: { type: 'string' } } });\n    if (!values.task || !values.workdir) throw new Error('Usage: node rehearsal/grade.mjs --task <id> --workdir <workspace>');\n    const result = await grade(resolve(values.workdir), values.task);\n    console.log(JSON.stringify(result, null, 2));\n    process.exitCode = result.pass ? 0 : result.criteria.some(item => item.name === 'browser') ? 2 : 1;\n  } catch (error) {\n    console.error(String(error));\n    process.exitCode = 2;\n  }\n}\nimport { fileURLToPath } from 'node:url';\nimport { defineConfig } from 'vitest/config';\n\nexport default defineConfig({\n  root: fileURLToPath(new URL('.', import.meta.url)),\n  cacheDir: '.vite',\n  test: {\n    include: ['test/**/*.test.mjs'],\n    hookTimeout: 30000,\n    testTimeout: 30000,\n  },\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat rehearsal/audit.mjs rehearsal/run.mjs rehearsal/workspace.mjs rehearsal/agent.mjs'","aggregated_output":"import { constants } from 'node:fs';\nimport { access, readlink } from 'node:fs/promises';\nimport { homedir } from 'node:os';\nimport { dirname, isAbsolute, join, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { inside, repository } from './files.mjs';\n\nexport function transcriptEvents(transcript) {\n  const events = [];\n  let malformedLines = 0;\n  for (const line of transcript.split('\\n')) {\n    if (!line.trim()) continue;\n    try {\n      const event = JSON.parse(line);\n      if (event && typeof event.type === 'string') events.push(event);\n      else malformedLines++;\n    } catch {\n      malformedLines++;\n    }\n  }\n  return { events, malformedLines };\n}\n\nfunction * toolInputs(event) {\n  const item = event.item;\n  if (item?.type === 'command_execution') yield { command: item.command, cwd: item.cwd ?? item.workdir };\n  if (item?.type === 'file_change') yield { changes: item.changes };\n  if (item?.type === 'mcp_tool_call') yield item.arguments ?? item.input;\n  if (event.type === 'tool_use') yield event.input;\n  if (event.type === 'assistant' && Array.isArray(event.message?.content)) {\n    for (const part of event.message.content) {\n      if (part?.type === 'tool_use') yield part.input;\n    }\n  }\n}\n\nfunction * unquotedPaths(command) {\n  const paths = /(?<![\\w./:-])(?:file:\\/\\/\\/|~\\/|\\$(?:[A-Z_]+|\\{[A-Z_]+\\})\\/|\\.\\.?\\/|\\/)[^\\s\"'\\x60;&|<>()[\\]{}*,]*|(?<!\\S)(?:~|\\$(?:[A-Z_]+|\\{[A-Z_]+\\}))(?=$|[\\s;&|])/g;\n  for (const match of command.matchAll(paths)) yield match[0];\n  for (const match of command.matchAll(/(?<![\\w./:-])[\\w.-]+(?:\\/[\\w.-]+)*(?![\\w./:-])/g)) yield match[0];\n}\n\nfunction * commandPaths(command) {\n  if (typeof command !== 'string') return;\n  let offset = 0;\n  // Keep spaces in literal paths, and inspect commands quoted for a shell or Node's -e.\n  for (const match of command.matchAll(/\"([^\"\\n]+)\"|'([^'\\n]+)'/g)) {\n    yield * unquotedPaths(command.slice(offset, match.index));\n    const quoted = match[1] ?? match[2];\n    if (/^(?:file:\\/\\/|[~/]|\\.\\.?\\/|\\$(?:[A-Z_]+|\\{[A-Z_]+\\})(?=\\/|$))[^;&|<>()[\\]{}\"'\\n]*$/.test(quoted) && !/\\s[-/]/.test(quoted)) {\n      yield quoted;\n    } else {\n      yield * commandPaths(quoted);\n    }\n    offset = match.index + match[0].length;\n  }\n  yield * unquotedPaths(command.slice(offset));\n}\n\nfunction localPath(text, base, directories) {\n  if (text.startsWith('file://')) {\n    try { return fileURLToPath(text); } catch { return undefined; }\n  }\n  if (/^[\\w+.-]+:\\/\\//.test(text)) return undefined;\n  const path = text.replace(/^(?:~|\\$(?:\\{([A-Z_]+)\\}|([A-Z_]+)))(?=\\/|$)/,\n    (prefix, braced, bare) => directories[braced ?? bare ?? 'HOME'] ?? prefix);\n  return isAbsolute(path) ? path : `${base}/${path}`;\n}\n\nasync function resolveLinks(file, loginLink) {\n  const parts = file.split('/').reverse();\n  let path = '/';\n  let links = 0;\n  // Walk in filesystem order so a dangling link or a link followed by \"..\" still counts.\n  while (parts.length) {\n    const part = parts.pop();\n    if (!part || part === '.') continue;\n    if (part === '..') {\n      path = dirname(path);\n      continue;\n    }\n    const next = join(path, part);\n    if (next === loginLink) return { path: next, readLogin: true };\n    const target = await readlink(next).catch(error => {\n      if (!['EINVAL', 'ENOENT', 'ENOTDIR'].includes(error.code)) throw error;\n    });\n    if (target === undefined) {\n      path = next;\n    } else {\n      if (++links > 40) throw new Error('Too many symbolic links: ' + file);\n      if (isAbsolute(target)) path = '/';\n      parts.push(...target.split('/').reverse());\n    }\n  }\n  return { path, readLogin: false };\n}\n\nasync function