{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat rehearsal/agent.mjs && sed -n '1,100p' rehearsal/grade.mjs && cat rehearsal/vitest.config.mjs && ls -ld apps/docs/dist tests/dist/.packed/*\"","aggregated_output":"import { execFile, spawn } from 'node:child_process';\nimport { open, readdir, readFile } from 'node:fs/promises';\nimport { delimiter, isAbsolute, join } from 'node:path';\nimport { promisify } from 'node:util';\nimport { transcriptEvents } from './audit.mjs';\n\nconst exec = promisify(execFile);\nconst fileTools = ['Read', 'Write', 'Edit', 'Glob', 'Grep'];\n\nexport function agentArgs(agent, { model, effort, workspace, anthropicApiKey }) {\n  if (agent === 'codex') {\n    return ['-a', 'never', 'exec', '-m', model, '-c', 'model_reasoning_effort=' + JSON.stringify(effort),\n      '-s', 'workspace-write', '-c', 'sandbox_workspace_write.network_access=false',\n      '-c', 'web_search=\"disabled\"', '--disable', 'apps', '--disable', 'plugins', '--disable', 'memories',\n      '--disable', 'hooks', '--disable', 'multi_agent_v2', '--disable', 'skill_mcp_dependency_install',\n      '--enable', 'skip_host_skill_discovery', '--ignore-user-config', '--ignore-rules',\n      '--skip-git-repo-check', '-C', workspace, '--json', '-'];\n  }\n  return ['-p', '--model', model, '--effort', effort, '--output-format', 'stream-json', '--verbose',\n    ...(anthropicApiKey ? ['--bare'] : []), '--restricted', '--safe-mode', '--no-chrome', '--disable-slash-commands',\n    '--strict-mcp-config', '--mcp-config', '{\"mcpServers\":{}}', '--no-session-persistence',\n    '--tools', [...fileTools, 'Bash'].join(','), '--allowedTools', [...fileTools, 'Bash(node *)'].join(','),\n    '--permission-mode', 'dontAsk', '--permission-prompts', 'none'];\n}\n\nfunction agentEnvironment(agent, { home, codexHome, claudeConfigDir, temporary, anthropicApiKey }) {\n  const path = process.env.PATH?.split(delimiter).filter(isAbsolute).join(delimiter);\n  const env = { PATH: path, LANG: process.env.LANG, HOME: home, TMPDIR: temporary };\n  if (agent === 'codex') env.CODEX_HOME = codexHome;\n  if (agent === 'claude') {\n    env.CLAUDE_CONFIG_DIR = claudeConfigDir;\n    if (anthropicApiKey) env.ANTHROPIC_API_KEY = anthropicApiKey;\n    else env.CLAUDE_CODE_DISABLE_AUTO_MEMORY = '1';\n  }\n  return env;\n}\n\nexport async function agentVersion(agent, options) {\n  const { stdout } = await exec(agent, ['--version'], {\n    cwd: options.workspace, env: agentEnvironment(agent, options), timeout: 5000,\n  });\n  const version = stdout.trim();\n  if (!version) throw new Error(`${agent} --version returned no version.`);\n  return version;\n}\n\nexport async function runAgent(agent, options) {\n  const { workspace, runDirectory, timeoutMs } = options;\n  const transcript = join(runDirectory, 'transcript.jsonl');\n  const stderr = join(runDirectory, 'stderr.log');\n  const args = agentArgs(agent, options);\n  const handles = [];\n  let exit;\n  try {\n    for (const [name, flags] of [[join(workspace, 'PROMPT.md'), 'r'], [transcript, 'wx'], [stderr, 'wx']]) {\n      handles.push(await open(name, flags));\n    }\n    exit = await new Promise(resolve => {\n      const grouped = process.platform !== 'win32';\n      const child = spawn(agent, args, {\n        cwd: workspace,\n        env: agentEnvironment(agent, options),\n        stdio: handles.map(handle => handle.fd),\n        detached: grouped,\n      });\n      let timedOut = false;\n      let spawnError = null;\n      let force;\n      const stop = signal => {\n        if (!child.pid) return;\n        try {\n          if (grouped) process.kill(-child.pid, signal);\n          else child.kill(signal);\n        } catch (error) {\n          if (error.code !== 'ESRCH') spawnError ??= String(error);\n        }\n      };\n      const timer = setTimeout(() => {\n        timedOut = true;\n        stop('SIGTERM');\n        force = setTimeout(() => stop('SIGKILL'), 2000);\n      }, timeoutMs);\n      child.on('error', error => { spawnError = String(error); });\n      child.on('close', (code, signal) => {\n        clearTimeout(timer);\n        clearTimeout(force);\n        // A command left running in this group could keep mutating the delivered files.\n        stop('SIGKILL');\n        resolve({ code, signal, timedOut, error: spawnError });\n      });\n    });\n  } finally {\n    await Promise.all(handles.map(handle => handle.close()));\n  }\n  return { transcript, stderr, exit, args };\n}\n\nconst authenticationError = /\\b(?:authenticat\\w*|auth[ _-](?:error|failed)|unauthori[sz]ed|sign[ -]in|not logged in|api[ _-]key|invalid token|token (?:has )?expired|(?:http|status(?: code)?)[: ]+(?:401|403))\\b/i;\nconst providerError = /\\b(?:network(?:_error)?|dns|econnrefused|econnreset|etimedout|enotfound|connection (?:refused|reset|timed out)|stream disconnected|(?:failed|unable) to connect|error sending request|rate[ _-]limit|overloaded_error|service unavailable)\\b/i;\n\nexport function agentErrors(agent, transcript, exit) {\n  let started = false;\n  let cliError = null;\n  let infrastructure = null;\n  for (const event of transcriptEvents(transcript).events) {\n    if (agent === 'claude') {\n      if (event.type === 'assistant' && event.message && event.message.model !== '<synthetic>') started = true;\n      if (event.type === 'result' && event.is_error) {\n        cliError = (Array.isArray(event.errors) && event.errors.join(' | ')) ||\n          event.result || event.subtype || 'Claude reported a failed turn.';\n      }\n      continue;\n    }\n    if (event.type === 'turn.started' || event.type.startsWith('item.')) started = true;\n    if (event.type === 'turn.completed') {\n      // A successful retry can follow an error in the stream.\n      cliError = infrastructure = null;\n    }\n    if (event.type !== 'error' && event.type !== 'turn.failed') continue;\n    cliError = event.error?.message || event.message || 'Codex reported a failed turn.';\n    if (!started || authenticationError.test(cliError) || providerError.test(cliError)) infrastructure = cliError;\n  }\n  if (infrastructure || exit.error) return { infrastructure: infrastructure ?? exit.error };\n  const exitStatus = exit.signal ?? `code ${exit.code}`;\n  if (!started && (!exit.timedOut || cliError)) {\n    return { infrastructure: cliError ?? `Agent exited with ${exitStatus} before a model turn.` };\n  }\n  if (exit.timedOut) return {};\n  if (exit.signal || exit.code !== 0) cliError ??= `Agent exited with ${exitStatus}.`;\n  return { cliError };\n}\n\nexport async function observeAgent(agent, transcript, codexHome) {\n  const { events } = transcriptEvents(transcript);\n  const observed = { model: null, effort: null };\n  if (agent === 'claude') {\n    const models = [...new Set(events.filter(event => event.type === 'assistant').map(event => event.message?.model)\n      .filter(model => typeof model === 'string' && model !== '<synthetic>'))];\n    return { ...observed, model: models.at(-1) ?? null, models };\n  }\n\n  const threadId = events[0]?.type === 'thread.started' ? events[0].thread_id : null;\n  if (!threadId || !/^[\\w-]+$/.test(threadId)) return observed;\n  observed.threadId = threadId;\n  try {\n    const entries = await readdir(join(codexHome, 'sessions'), { recursive: true, withFileTypes: true });\n    const rollout = entries.find(entry => entry.isFile() && entry.name.startsWith('rollout-') &&\n      entry.name.endsWith('-' + threadId + '.jsonl'));\n    if (!rollout) return { ...observed, detail: 'No rollout found for this Codex thread.' };\n    const { events: session, malformedLines } = transcriptEvents(await readFile(join(rollout.parentPath, rollout.name), 'utf8'));\n    const contexts = session.filter(event => event.type === 'turn_context').map(event => event.payload);\n    const settings = contexts.map(turn => [turn?.model ?? null, turn?.effort ?? turn?.reasoning_effort ?? turn?.model_reasoning_effort ?? null]);\n    if (malformedLines || new Set(settings.map(setting => JSON.stringify(setting))).size !== 1) {\n      return { ...observed, detail: 'Could not verify consistent turn_context settings in the Codex rollout.' };\n    }\n    [observed.model, observed.effort] = settings.at(-1);\n  } catch (error) {\n    observed.detail = 'Could not read Codex rollout metadata: ' + (error.code ?? error.message);\n  }\n  return observed;\n}\nimport { lstat, readFile, realpath } from 'node:fs/promises';\nimport { basename, join, resolve } from 'node:path';\nimport { parseArgs } from 'node:util';\nimport { build } from 'esbuild';\nimport { chromium } from 'playwright-core';\nimport { inside, isMain, readJson, repository, taskFiles, writeJson } from './files.mjs';\nimport { dateCheck, noteCheck, plotCheck, titleCheck } from './reader.mjs';\nimport { compareHeaders, compareRows, normalizedText } from './table.mjs';\n\nconst zones = ['America/Los_Angeles', 'Asia/Tokyo'];\nconst timeout = 5000;\nconst origin = 'https://axylo-rehearsal.invalid';\nconst criteriaNames = ['render', 'no error diagnostics', 'accessible name', 'visible title', 'table caption',\n  'table headers', 'table rows', 'plotted x order', 'drawn gaps', 'reader date', 'reader note', 'chart type'];\nconst criterion = (name, pass, detail) => ({ name, pass, detail });\n\nasync function registryLevels() {\n  const registry = await readFile(join(repository, 'packages/axylo/src/diagnostics/registry.ts'), 'utf8');\n  const levels = new Map([...registry.matchAll(/^\\s*(AX\\d+): \\{ level: '(error|warning|hint)'/gm)]\n    .map(([, code, level]) => [code, level]));\n  if (levels.get('AX101') !== 'error' || levels.get('AX140') !== 'warning') {\n    throw new Error('Could not read diagnostic levels from the Axylo registry.');\n  }\n  return levels;\n}\n\nasync function bundle(workspace, data) {\n  const result = await build({\n    absWorkingDir: workspace,\n    stdin: {\n      resolveDir: workspace,\n      contents: `\n        import * as answer from './chart.js';\n        try {\n          const render = Reflect.get(answer, 'default');\n          if (typeof render !== 'function') throw new Error('chart.js must default-export a render function.');\n          const handle = render(document.getElementById('chart'), ${JSON.stringify(data)});\n          if (!handle || typeof handle.update !== 'function' || typeof handle.destroy !== 'function' ||\n              !Array.isArray(handle.diagnostics)) {\n            throw new Error('render must return the Axylo chart handle.');\n          }\n          window.rehearsalRender = { handle };\n        } catch (error) {\n          window.rehearsalRender = { error: String(error), diagnostics: error?.diagnostics };\n        }\n      `,\n    },\n    bundle: true,\n    format: 'iife',\n    platform: 'browser',\n    conditions: ['browser'],\n    write: false,\n    outfile: 'chart-bundle.js',\n    logLevel: 'silent',\n    plugins: [{\n      name: 'workspace-files',\n      setup(builder) {\n        builder.onLoad({ filter: /.*/, namespace: 'file' }, async args => {\n          if (!inside(workspace, await realpath(args.path))) {\n            return { errors: [{ text: 'Import outside the rehearsal workspace: ' + args.path }] };\n          }\n        });\n      },\n    }],\n  });\n  return new Map(result.outputFiles.map(file => ['/' + basename(file.path), file.text]));\n}\n\nconst html = `<!doctype html><html lang=\"en-US\"><meta charset=\"utf-8\">\n<title>Axylo rehearsal</title><link rel=\"stylesheet\" href=\"/chart-bundle.css\">\n<div id=\"chart\" style=\"width:720px;height:400px\"></div><script src=\"/chart-bundle.js\"></script></html>`;\n\nasync function inspect(browser, files, expected, levels, timezoneId, input) {\n  const context = await browser.newContext({ timezoneId, locale: 'en-US', serviceWorkers: 'block' });\n  const criteria = [];\n  const diagnostics = new Map();\n  const errors = [];\n  let table;\n  const addDiagnostic = (code, diagnostic, source) => {\n    const previous = diagnostics.get(code);\n    diagnostics.set(code, {\n      ...previous, ...diagnostic, code, level: levels.get(code) ?? diagnostic.level ?? 'unknown', timezoneId,\n      sources: [...new Set([...(previous?.sources ?? []), source])],\n    });\n  };\n\n  try {\n    await context.route('**/*', route => {\n      const url = new URL(route.request().url());\n      if (url.origin !== origin) return route.abort();\n      if (url.pathname === '/') {\n        return route.fulfill({\n          contentType: 'text/html',\n          body: html,\n          headers: {\n            'Content-Security-Policy': \"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\",\n          },\n        });\n      }\n      if (url.pathname.endsWith('.css')) {\nimport { fileURLToPath } from 'node:url';\nimport { defineConfig } from 'vitest/config';\n\nexport default defineConfig({\n  root: fileURLToPath(new URL('.', import.meta.url)),\n  cacheDir: '.vite',\n  test: {\n    include: ['test/**/*.test.mjs'],\n    hookTimeout: 30000,\n    testTimeout: 30000,\n  },\n});\ndrwxrwxr-x 6 canarit canarit   4096 Nov 19 09:19 apps/docs/dist\n-rw-rw-r-- 1 canarit canarit 581897 Nov 19 09:19 tests/dist/.packed/axylo-0.0.0.tgz\n-rw-rw-r-- 1 canarit canarit    549 Nov 19 09:19 tests/dist/.packed/manifest.json\n","exit_code":0,"status":"completed"}}
