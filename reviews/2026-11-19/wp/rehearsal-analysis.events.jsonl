ce, data) {\n    28\t  const result = await build({\n    29\t    absWorkingDir: workspace,\n    30\t    stdin: {\n    31\t      resolveDir: workspace,\n    32\t      contents: `\n    33\t        import * as answer from './chart.js';\n    34\t        try {\n    35\t          const render = Reflect.get(answer, 'default');\n    36\t          if (typeof render !== 'function') throw new Error('chart.js must default-export a render function.');\n    37\t          const handle = render(document.getElementById('chart'), ${JSON.stringify(data)});\n    38\t          if (!handle || typeof handle.update !== 'function' || typeof handle.destroy !== 'function' ||\n    39\t              !Array.isArray(handle.diagnostics)) {\n    40\t            throw new Error('render must return the Axylo chart handle.');\n    41\t          }\n    42\t          window.rehearsalRender = { handle };\n    43\t        } catch (error) {\n    44\t          window.rehearsalRender = { error: String(error), diagnostics: error?.diagnostics };\n    45\t        }\n    46\t      `,\n    47\t    },\n    48\t    bundle: true,\n    49\t    format: 'iife',\n    50\t    platform: 'browser',\n    51\t    conditions: ['browser'],\n    52\t    write: false,\n    53\t    outfile: 'chart-bundle.js',\n    54\t    logLevel: 'silent',\n    55\t    plugins: [{\n    56\t      name: 'workspace-files',\n    57\t      setup(builder) {\n    58\t        builder.onLoad({ filter: /.*/, namespace: 'file' }, async args => {\n    59\t          if (!inside(workspace, await realpath(args.path))) {\n    60\t            return { errors: [{ text: 'Import outside the rehearsal workspace: ' + args.path }] };\n    61\t          }\n    62\t        });\n    63\t      },\n    64\t    }],\n    65\t  });\n    66\t  return new Map(result.outputFiles.map(file => ['/' + basename(file.path), file.text]));\n    67\t}\n    68\t\n    69\tconst html = `<!doctype html><html lang=\"en-US\"><meta charset=\"utf-8\">\n    70\t<title>Axylo rehearsal</title><link rel=\"stylesheet\" href=\"/chart-bundle.css\">\n    71\t<div id=\"chart\" style=\"width:720px;height:400px\"></div><script src=\"/chart-bundle.js\"></script></html>`;\n    72\t\n    73\tasync function inspect(browser, files, expected, levels, timezoneId, input) {\n    74\t  const context = await browser.newContext({ timezoneId, locale: 'en-US', serviceWorkers: 'block' });\n    75\t  const criteria = [];\n    76\t  const diagnostics = new Map();\n    77\t  const errors = [];\n    78\t  let table;\n    79\t  const addDiagnostic = (code, diagnostic, source) => {\n    80\t    const previous = diagnostics.get(code);\n    81\t    diagnostics.set(code, {\n    82\t      ...previous, ...diagnostic, code, level: levels.get(code) ?? diagnostic.level ?? 'unknown', timezoneId,\n    83\t      sources: [...new Set([...(previous?.sources ?? []), source])],\n    84\t    });\n    85\t  };\n    86\t\n    87\t  try {\n    88\t    await context.route('**/*', route => {\n    89\t      const url = new URL(route.request().url());\n    90\t      if (url.origin !== origin) return route.abort();\n    91\t      if (url.pathname === '/') {\n    92\t        return route.fulfill({\n    93\t          contentType: 'text/html',\n    94\t          body: html,\n    95\t          headers: {\n    96\t            'Content-Security-Policy': \"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\",\n    97\t          },\n    98\t        });\n    99\t      }\n   100\t      if (url.pathname.endsWith('.css')) {\n   101\t        return route.fulfill({ contentType: 'text/css', body: files.get(url.pathname) ?? '' });\n   102\t      }\n   103\t      const script = files.get(url.pathname);\n   104\t      return script === undefined ? route.abort() : route.fulfill({ contentType: 'text/javascript', body: script });\n   105\t    });\n   106\t\n   107\t    const page = await context.newPage();\n   108\t    page.setDefaultTimeout(timeout);\n   109\t    page.on('pageerror', error => errors.push(String(error)));\n   110\t    page.on('console', message => {\n   111\t      const text = message.text();\n   112\t      const code = /\\[axylo (AX\\d+)\\]/.exec(text)?.[1];\n   113\t      if (code) addDiagnostic(code, { console: text }, 'console');\n   114\t    });\n   115\t    await page.goto(origin, { waitUntil: 'load', timeout });\n   116\t    const problem = await page.evaluate(() => window.rehearsalRender?.error ?? null);\n   117\t    const figure = page.locator('#chart figure');\n   118\t    let state = '';\n   119\t    if (!problem && errors.length === 0) {\n   120\t      await page.waitForFunction(() => new Promise(done => {\n   121\t        requestAnimationFrame(() => requestAnimationFrame(() => done(true)));\n   122\t      }));\n   123\t\n   124\t      if (await figure.count() === 1) {\n   125\t        const byName = page.getByRole('group', { name: expected.title, exact: true })\n   126\t          .or(page.getByRole('figure', { name: expected.title, exact: true }))\n   127\t          .or(page.getByRole('img', { name: expected.title, exact: true }));\n   128\t        const titlePass = await figure.and(byName).count() === 1;\n   129\t        const name = titlePass ? expected.title : (await figure.ariaSnapshot()).split('\\n')[0];\n   130\t        criteria.push(criterion('accessible name', titlePass, name || 'No accessible figure name.'));\n   131\t        criteria.push({ name: 'visible title', ...await titleCheck(figure) });\n   132\t        state = (await figure.locator('.axylo-message:visible').allTextContents()).join(' ');\n   133\t        const description = (await figure.locator('.axylo-description').allTextContents())[0] ?? '';\n   134\t        const types = await figure.locator('[aria-roledescription]').evaluateAll(nodes =>\n   135\t          nodes.map(node => node.getAttribute('aria-roledescription')));\n   136\t        const observedType = (types.find(type => /^(?:line|area|bar|scatter|donut) chart$/i.test(type)) ?? description)\n   137\t          .match(/^(line|area|bar|scatter|donut) chart\\b/i)?.[1].toLowerCase();\n   138\t        criteria.push(criterion('chart type', observedType === expected.type,\n   139\t          `Expected ${expected.type}, saw ${observedType ?? 'no chart type'}.`));\n   140\t\n   141\t        const plot = await plotCheck(figure, expected);\n   142\t        criteria.push({ name: 'plotted x order', ...plot.order }, { name: 'drawn gaps', ...plot.gaps });\n   143\t        criteria.push({ name: 'reader date', ...await dateCheck(figure, expected) });\n   144\t        criteria.push({ name: 'reader note', ...await noteCheck(page, figure, expected.valuesNotShown) });\n   145\t        try {\n   146\t          const button = figure.getByRole('button', { name: 'View as table', exact: true });\n   147\t          if (await button.count() === 1) {\n   148\t            await button.click();\n   149\t            const view = figure.getByRole('table');\n   150\t            if (await view.count() === 1 && await view.isVisible()) {\n   151\t              table = await view.evaluate(element => ({\n   152\t                caption: element.caption?.textContent ?? '',\n   153\t                headers: Array.from(element.tHead?.rows[0]?.cells ?? [], cell => cell.textContent.trim()),\n   154\t                rows: Array.from(element.tBodies[0]?.rows ?? [], row =>\n   155\t                  Array.from(row.cells, cell => cell.textContent.trim())),\n   156\t              }));\n   157\t              const named = await view.and(figure.getByRole('table', { name: expected.title, exact: true })).count() === 1;\n   158\t              criteria.push(criterion('table caption', named && normalizedText(table.caption) === expected.title,\n   159\t                table.caption || 'No table caption.'));\n   160\t              const header = compareHeaders(expected, table.headers);\n   161\t              const semantic = await view.getByRole('columnheader').count() === table.headers.length &&\n   162\t                await view.getByRole('rowheader').count() === table.rows.length;\n   163\t              criteria.push(criterion('table headers', header.pass && semantic,\n   164\t                header.detail + (semantic ? '' : ' Missing semantic row or column headers.')));\n   165\t              table.order = header.pass ? header.order : undefined;\n   166\t            }\n   167\t          }\n   168\t          if (!table) {\n   169\t            criteria.push(criterion('table rows', false, 'Could not open one visible table with “View as table”.'));\n   170\t          } else if (await figure.getByRole('button', { name: 'Next page', exact: true }).count()) {\n   171\t            criteria.push(criterion('table rows', false, 'Unexpected additional table pages.'));\n   172\t          } else {\n   173\t            const compared = compareRows(expected, table.rows, table.order);\n   174\t            criteria.push(criterion('table rows', compared.pass, compared.detail));\n   175\t          }\n   176\t        } catch (error) {\n   177\t          criteria.push(criterion('table rows', false, String(error)));\nrehearsal/fixtures/daily-revenue.json\n[\n  { \"day\": \"2026-05-06T00:00:00Z\", \"revenue\": \"1438.75\" },\n  { \"day\": \"2026-05-02T00:00:00Z\", \"revenue\": \"984.5\" },\n  { \"day\": \"2026-05-08T00:00:00Z\", \"revenue\": 1705.25 },\n  { \"day\": \"2026-05-01T00:00:00Z\", \"revenue\": \"1302.25\" },\n  { \"day\": \"2026-05-05T00:00:00Z\", \"revenue\": 1576.5 },\n  { \"day\": \"2026-05-03T00:00:00Z\", \"revenue\": \"899.75\" },\n  { \"day\": \"2026-05-07T00:00:00Z\", \"revenue\": \"1693.5\" }\n]\nrehearsal/fixtures/daily-revenue.alternate.json\n[\n  {\"day\": \"2026-05-07T00:00:00Z\", \"revenue\": \"1728.5\"},\n  {\"day\": \"2026-05-03T00:00:00Z\", \"revenue\": \"1047.75\"},\n  {\"day\": \"2026-05-05T00:00:00Z\", \"revenue\": 1837.5},\n  {\"day\": \"2026-05-01T00:00:00Z\", \"revenue\": \"1425.25\"},\n  {\"day\": \"2026-05-08T00:00:00Z\", \"revenue\": 1941.25},\n  {\"day\": \"2026-05-02T00:00:00Z\", \"revenue\": \"1082.5\"},\n  {\"day\": \"2026-05-06T00:00:00Z\", \"revenue\": \"1649.75\"}\n]\nrehearsal/fixtures/regional-sales.json\n[\n  {\"quarter\": \"2025 Q3\", \"north\": \"1580.75\", \"central\": \"1010.5\", \"west\": \"1745.25\"},\n  {\"quarter\": \"2025 Q1\", \"north\": \"1250.5\", \"central\": \"975.25\", \"west\": \"1220.75\"},\n  {\"quarter\": \"2025 Q4\", \"north\": \"1832.5\", \"central\": \"1464.75\", \"west\": \"1680.25\"},\n  {\"quarter\": \"2025 Q2\", \"north\": \"1499.25\", \"central\": \"1102.5\", \"west\": \"1365.5\"}\n]\nrehearsal/fixtures/regional-sales.alternate.json\n[\n  {\"quarter\": \"2025 Q2\", \"north\": \"1534.25\", \"central\": \"1216.5\", \"west\": \"1558.5\"},\n  {\"quarter\": \"2025 Q4\", \"north\": \"1980.5\", \"central\": \"1691.75\", \"west\": \"1735.25\"},\n  {\"quarter\": \"2025 Q1\", \"north\": \"1511.5\", \"central\": \"1064.25\", \"west\": \"1388.75\"},\n  {\"quarter\": \"2025 Q3\", \"north\": \"1703.75\", \"central\": \"1212.5\", \"west\": \"2026.25\"}\n]\nrehearsal/fixtures/signups.json\n[\n  { \"day\": \"2026-04-06\", \"signpus\": 207 },\n  { \"day\": \"2026-04-07\", \"signpus\": 234 },\n  { \"day\": \"2026-04-08\", \"signpus\": 219 },\n  { \"day\": \"2026-04-09\", \"signpus\": 288 },\n  { \"day\": \"2026-04-10\", \"signpus\": 263 },\n  { \"day\": \"2026-04-11\", \"signpus\": 102 },\n  { \"day\": \"2026-04-12\", \"signpus\": 119 }\n]\nrehearsal/fixtures/signups.alternate.json\n[\n  {\"day\": \"2026-04-12\", \"signpus\": 154},\n  {\"day\": \"2026-04-11\", \"signpus\": 250},\n  {\"day\": \"2026-04-10\", \"signpus\": 524},\n  {\"day\": \"2026-04-09\"},\n  {\"day\": \"2026-04-08\", \"signpus\": 455},\n  {\"day\": \"2026-04-07\", \"signpus\": 332},\n  {\"day\": \"2026-04-06\", \"signpus\": 418}\n]\nagent rehearsal: these prompts, these models, Chrome; not user evidence\nAgent   Task            Pass  Counted  Fail  Timeout  Void  Infrastructure  Rule met\ncodex   daily-v