{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'nl -ba rehearsal/grade.mjs && nl -ba rehearsal/reader.mjs && nl -ba rehearsal/table.mjs'","aggregated_output":"     1\timport { lstat, readFile, realpath } from 'node:fs/promises';\n     2\timport { basename, join, resolve } from 'node:path';\n     3\timport { parseArgs } from 'node:util';\n     4\timport { build } from 'esbuild';\n     5\timport { chromium } from 'playwright-core';\n     6\timport { inside, isMain, readJson, repository, taskFiles, writeJson } from './files.mjs';\n     7\timport { dateCheck, noteCheck, plotCheck, titleCheck } from './reader.mjs';\n     8\timport { compareHeaders, compareRows, normalizedText } from './table.mjs';\n     9\t\n    10\tconst zones = ['America/Los_Angeles', 'Asia/Tokyo'];\n    11\tconst timeout = 5000;\n    12\tconst origin = 'https://axylo-rehearsal.invalid';\n    13\tconst criteriaNames = ['render', 'no error diagnostics', 'accessible name', 'visible title', 'table caption',\n    14\t  'table headers', 'table rows', 'plotted x order', 'drawn gaps', 'reader date', 'reader note', 'chart type'];\n    15\tconst criterion = (name, pass, detail) => ({ name, pass, detail });\n    16\t\n    17\tasync function registryLevels() {\n    18\t  const registry = await readFile(join(repository, 'packages/axylo/src/diagnostics/registry.ts'), 'utf8');\n    19\t  const levels = new Map([...registry.matchAll(/^\\s*(AX\\d+): \\{ level: '(error|warning|hint)'/gm)]\n    20\t    .map(([, code, level]) => [code, level]));\n    21\t  if (levels.get('AX101') !== 'error' || levels.get('AX140') !== 'warning') {\n    22\t    throw new Error('Could not read diagnostic levels from the Axylo registry.');\n    23\t  }\n    24\t  return levels;\n    25\t}\n    26\t\n    27\tasync function bundle(workspace, data) {\n    28\t  const result = await build({\n    29\t    absWorkingDir: workspace,\n    30\t    stdin: {\n    31\t      resolveDir: workspace,\n    32\t      contents: `\n    33\t        import * as answer from './chart.js';\n    34\t        try {\n    35\t          const render = Reflect.get(answer, 'default');\n    36\t          if (typeof render !== 'function') throw new Error('chart.js must default-export a render function.');\n    37\t          const handle = render(document.getElementById('chart'), ${JSON.stringify(data)});\n    38\t          if (!handle || typeof handle.update !== 'function' || typeof handle.destroy !== 'function' ||\n    39\t              !Array.isArray(handle.diagnostics)) {\n    40\t            throw new Error('render must return the Axylo chart handle.');\n    41\t          }\n    42\t          window.rehearsalRender = { handle };\n    43\t        } catch (error) {\n    44\t          window.rehearsalRender = { error: String(error), diagnostics: error?.diagnostics };\n    45\t        }\n    46\t      `,\n    47\t    },\n    48\t    bundle: true,\n    49\t    format: 'iife',\n    50\t    platform: 'browser',\n    51\t    conditions: ['browser'],\n    52\t    write: false,\n    53\t    outfile: 'chart-bundle.js',\n    54\t    logLevel: 'silent',\n    55\t    plugins: [{\n    56\t      name: 'workspace-files',\n    57\t      setup(builder) {\n    58\t        builder.onLoad({ filter: /.*/, namespace: 'file' }, async args => {\n    59\t          if (!inside(workspace, await realpath(args.path))) {\n    60\t            return { errors: [{ text: 'Import outside the rehearsal workspace: ' + args.path }] };\n    61\t          }\n    62\t        });\n    63\t      },\n    64\t    }],\n    65\t  });\n    66\t  return new Map(result.outputFiles.map(file => ['/' + basename(file.path), file.text]));\n    67\t}\n    68\t\n    69\tconst html = `<!doctype html><html lang=\"en-US\"><meta charset=\"utf-8\">\n    70\t<title>Axylo rehearsal</title><link rel=\"stylesheet\" href=\"/chart-bundle.css\">\n    71\t<div id=\"chart\" style=\"width:720px;height:400px\"></div><script src=\"/chart-bundle.js\"></script></html>`;\n    72\t\n    73\tasync function inspect(browser, files, expected, levels, timezoneId, input) {\n    74\t  const context = await browser.newContext({ timezoneId, locale: 'en-US', serviceWorkers: 'block' });\n    75\t  const criteria = [];\n    76\t  const diagnostics = new Map();\n    77\t  const errors = [];\n    78\t  let table;\n    79\t  const addDiagnostic = (code, diagnostic, source) => {\n    80\t    const previous = diagnostics.get(code);\n    81\t    diagnostics.set(code, {\n    82\t      ...previous, ...diagnostic, code, level: levels.get(code) ?? diagnostic.level ?? 'unknown', timezoneId,\n    83\t      sources: [...new Set([...(previous?.sources ?? []), source])],\n    84\t    });\n    85\t  };\n    86\t\n    87\t  try {\n    88\t    await context.route('**/*', route => {\n    89\t      const url = new URL(route.request().url());\n    90\t      if (url.origin !== origin) return route.abort();\n    91\t      if (url.pathname === '/') {\n    92\t        return route.fulfill({\n    93\t          contentType: 'text/html',\n    94\t          body: html,\n    95\t          headers: {\n    96\t            'Content-Security-Policy': \"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\",\n    97\t          },\n    98\t        });\n    99\t      }\n   100\t      if (url.pathname.endsWith('.css')) {\n   101\t        return route.fulfill({ contentType: 'text/css', body: files.get(url.pathname) ?? '' });\n   102\t      }\n   103\t      const script = files.get(url.pathname);\n   104\t      return script === undefined ? route.abort() : route.fulfill({ contentType: 'text/javascript', body: script });\n   105\t    });\n   106\t\n   107\t    const page = await context.newPage();\n   108\t    page.setDefaultTimeout(timeout);\n   109\t    page.on('pageerror', error => errors.push(String(error)));\n   110\t    page.on('console', message => {\n   111\t      const text = message.text();\n   112\t      const code = /\\[axylo (AX\\d+)\\]/.exec(text)?.[1];\n   113\t      if (code) addDiagnostic(code, { console: text }, 'console');\n   114\t    });\n   115\t    await page.goto(origin, { waitUntil: 'load', timeout });\n   116\t    const problem = await page.evaluate(() => window.rehearsalRender?.error ?? null);\n   117\t    const figure = page.locator('#chart figure');\n   118\t    let state = '';\n   119\t    if (!problem && errors.length === 0) {\n   120\t      await page.waitForFunction(() => new Promise(done => {\n   121\t        requestAnimationFrame(() => requestAnimationFrame(() => done(true)));\n   122\t      }));\n   123\t\n   124\t      if (await figure.count() === 1) {\n   125\t        const byName = page.getByRole('group', { name: expected.title, exact: true })\n   126\t          .or(page.getByRole('figure', { name: expected.title, exact: true }))\n   127\t          .or(page.getByRole('img', { name: expected.title, exact: true }));\n   128\t        const titlePass = await figure.and(byName).count() === 1;\n   129\t        const name = titlePass ? expected.title : (await figure.ariaSnapshot()).split('\\n')[0];\n   130\t        criteria.push(criterion('accessible name', titlePass, name || 'No accessible figure name.'));\n   131\t        criteria.push({ name: 'visible title', ...await titleCheck(figure) });\n   132\t        state = (await figure.locator('.axylo-message:visible').allTextContents()).join(' ');\n   133\t        const description = (await figure.locator('.axylo-description').allTextContents())[0] ?? '';\n   134\t        const types = await figure.locator('[aria-roledescription]').evaluateAll(nodes =>\n   135\t          nodes.map(node => node.getAttribute('aria-roledescription')));\n   136\t        const observedType = (types.find(type => /^(?:line|area|bar|scatter|donut) chart$/i.test(type)) ?? description)\n   137\t          .match(/^(line|area|bar|scatter|donut) chart\\b/i)?.[1].toLowerCase();\n   138\t        criteria.push(criterion('chart type', observedType === expected.type,\n   139\t          `Expected ${expected.type}, saw ${observedType ?? 'no chart type'}.`));\n   140\t\n   141\t        const plot = await plotCheck(figure, expected);\n   142\t        criteria.push({ name: 'plotted x order', ...plot.order }, { name: 'drawn gaps', ...plot.gaps });\n   143\t        criteria.push({ name: 'reader date', ...await dateCheck(figure, expected) });\n   144\t        criteria.push({ name: 'reader note', ...await noteCheck(page, figure, expected.valuesNotShown) });\n   145\t        try {\n   146\t          const button = figure.getByRole('button', { name: 'View as table', exact: true });\n   147\t          if (await button.count() === 1) {\n   148\t            await button.click();\n   149\t            const view = figure.getByRole('table');\n   150\t            if (await view.count() === 1 && await view.isVisible()) {\n   151\t              table = await view.evaluate(element => ({\n   152\t                caption: element.caption?.textContent ?? '',\n   153\t                headers: Array.from(element.tHead?.rows[0]?.cells ?? [], cell => cell.textContent.trim()),\n   154\t                rows: Array.from(element.tBodies[0]?.rows ?? [], row =>\n   155\t                  Array.from(row.cells, cell => cell.textContent.trim())),\n   156\t              }));\n   157\t              const named = await view.and(figure.getByRole('table', { name: expected.title, exact: true })).count() === 1;\n   158\t              criteria.push(criterion('table caption', named && normalizedText(table.caption) === expected.title,\n   159\t                table.caption || 'No table caption.'));\n   160\t              const header = compareHeaders(expected, table.headers);\n   161\t              const semantic = await view.getByRole('columnheader').count() === table.headers.length &&\n   162\t                await view.getByRole('rowheader').count() === table.rows.length;\n   163\t              criteria.push(criterion('table headers', header.pass && semantic,\n   164\t                header.detail + (semantic ? '' : ' Missing semantic row or column headers.')));\n   165\t              table.order = header.pass ? header.order : undefined;\n   166\t            }\n   167\t          }\n   168\t          if (!table) {\n   169\t            criteria.push(criterion('table rows', false, 'Could not open one visible table with “View as table”.'));\n   170\t          } else if (await figure.getByRole('button', { name: 'Next page', exact: true }).count()) {\n   171\t            criteria.push(criterion('table rows', false, 'Unexpected additional table pages.'));\n   172\t          } else {\n   173\t            const compared = compareRows(expected, table.rows, table.order);\n   174\t            criteria.push(criterion('table rows', compared.pass, compared.detail));\n   175\t          }\n   176\t        } catch (error) {\n   177\t          criteria.push(criterion('table rows', false, String(error)));\n   178\t        }\n   179\t      }\n   180\t    }\n   181\t\n   182\t    const handleDiagnostics = await page.evaluate(() => {\n   183\t      const result = window.rehearsalRender;\n   184\t      return result?.handle?.diagnostics ?? result?.diagnostics ?? [];\n   185\t    });\n   186\t    for (const { code, level, message } of handleDiagnostics) addDiagnostic(code, { level, message }, 'handle');\n   187\t    const errorCodes = [...diagnostics.values()].filter(d => d.level === 'error').map(d => d.code);\n   188\t    const errorState = ['Loading chart.', 'No data to show.'].includes(state) ? '' : state;\n   189\t    criteria.push(criterion('no error diagnostics', !errorState && errorCodes.length === 0,\n   190\t      [...errorCodes, errorState].filter(Boolean).join(' | ') || 'No error diagnostics or error state.'));\n   191\t    const title = criteria.find(item => item.name === 'accessible name');\n   192\t    if (title && diagnostics.has('AX140')) {\n   193\t      title.pass = false;\n   194\t      title.detail += ' (AX140)';\n   195\t    }\n   196\t\n   197\t    const reason = problem || errors.join(' | ') || (await figure.count() !== 1 && 'Expected one Axylo figure in #chart.');\n   198\t    criteria.push(criterion('render', !reason, reason || 'Rendered a chart and returned its handle.'));\n   199\t  } catch (error) {\n   200\t    criteria.push(criterion('render', false, String(error)));\n   201\t  } finally {\n   202\t    await context.close();\n   203\t  }\n   204\t\n   205\t  return {\n   206\t    input,\n   207\t    timezoneId,\n   208\t    criteria: criteriaNames.map(name => criteria.find(item => item.name === name) ??\n   209\t      criterion(name, false, 'Unavailable after render failure.')),\n   210\t    diagnostics: [...diagnostics.values()],\n   211\t    ...(table ? { table } : {}),\n   212\t  };\n   213\t}\n   214\t\n   215\texport async function grade(workspace, task, { launch = () => chromium.launch({ channel: 'chrome', headless: true, timeout: 15000 }) } = {}) {\n   216\t  workspace = await realpath(workspace);\n   217\t  const taskPaths = taskFiles(task);\n   218\t  const inputs = await Promise.all([\n   219\t    ['primary', taskPaths.fixture, taskPaths.expected],\n   220\t    ['alternate', taskPaths.alternate, taskPaths.alternateExpected],\n   221\t  ].map(async ([name, fixture, expected]) => ({ name, data: await readJson(fixture), expected: await readJson(expected) })));\n   222\t  const save = async result => {\n   223\t    await writeJson(join(workspace, 'grade.json'), result);\n   224\t    return result;\n   225\t  };\n   226\t  const fail = (name, detail) => save({ pass: false, criteria: [criterion(name, false, detail)], diagnostics: [], timezones: [] });\n   227\t\n   228\t  let bundles;\n   229\t  try {\n   230\t    if (!(await lstat(join(workspace, 'chart.js'))).isFile()) {\n   231\t      return fail('render', 'chart.js must be a regular file.');\n   232\t    }\n   233\t    // Grade the original fixture even if the agent changed its local copy while experimenting.\n   234\t    bundles = await Promise.all(inputs.map(async input => ({ ...input, files: await bundle(workspace, input.data) })));\n   235\t  } catch (error) {\n   236\t    return fail('render', error.code === 'ENOENT' ? 'chart.js is missing.' : String(error));\n   237\t  }\n   238\t\n   239\t  const levels = await registryLevels();\n   240\t  let browser;\n   241\t  try {\n   242\t    browser = await launch();\n   243\t  } catch (error) {\n   244\t    return fail('browser', String(error));\n   245\t  }\n   246\t  try {\n   247\t    const timezones = [];\n   248\t    for (const { name, files, expected } of bundles) {\n   249\t      for (const timezoneId of zones) timezones.push(await inspect(browser, files, expected, levels, timezoneId, name));\n   250\t    }\n   251\t    const criteria = criteriaNames.map(name => {\n   252\t      const results = timezones.map(zone => zone.criteria.find(item => item.name === name));\n   253\t      return criterion(name, results.every(item => item.pass),\n   254\t        results.map((item, index) => `${timezones[index].input} / ${timezones[index].timezoneId}: ${item.detail}`).join(' | '));\n   255\t    });\n   256\t    return await save({\n   257\t      pass: criteria.every(item => item.pass),\n   258\t      browserVersion: browser.version(),\n   259\t      criteria,\n   260\t      diagnostics: timezones.flatMap(zone => zone.diagnostics),\n   261\t      timezones,\n   262\t    });\n   263\t  } catch (error) {\n   264\t    if (!browser.isConnected()) return fail('browser', String(error));\n   265\t    throw error;\n   266\t  } finally {\n   267\t    await browser.close();\n   268\t  }\n   269\t}\n   270\t\n   271\tif (isMain(import.meta.url)) {\n   272\t  try {\n   273\t    const { values } = parseArgs({ options: { task: { type: 'string' }, workdir: { type: 'string' } } });\n   274\t    if (!values.task || !values.workdir) throw new Error('Usage: node rehearsal/grade.mjs --task <id> --workdir <workspace>');\n   275\t    const result = await grade(resolve(values.workdir), values.task);\n   276\t    console.log(JSON.stringify(result, null, 2));\n   277\t    process.exitCode = result.pass ? 0 : result.criteria.some(item => item.name === 'browser') ? 2 : 1;\n   278\t  } catch (error) {\n   279\t    console.error(String(error));\n   280\t    process.exitCode = 2;\n   281\t  }\n   282\t}\n     1\timport { calendarDate, normalizedText } from './table.mjs';\n     2\t\n     3\t// Text can keep its accessible name even when a visually clipped ancestor hides the glyphs.\n     4\tasync function textFits(locator, figure, { allowHidden = false } = {}) {\n     5\t  const bounds = await figure.boundingBox();\n     6\t  if (!bounds) return false;\n     7\t  return locator.evaluate((element, { bounds, allowHidden }) => {\n     8\t    const style = getComputedStyle(element);\n     9\t    if (allowHidden && (element.hidden || element.classList.contains('axylo-visually-hidden') ||\n    10\t        style.display === 'none' || style.visibility === 'hidden')) return true;\n    11\t    if (style.display === 'none' || style.visibility !== 'visible') return false;\n    12\t    const clip = { left: Math.max(bounds.x, 0), top: Math.max(bounds.y, 0),\n    13\t      right: Math.min(bounds.x + bounds.width, innerWidth),\n    14\t      bottom: Math.min(bounds.y + bounds.height, innerHeight) };\n    15\t    for (let node = element; node instanceof HTMLElement; node = node.parentElement) {\n    16\t      const css = getComputedStyle(node);\n    17\t      if (css.opacity === '0' || css.clipPath !== 'none') return false;\n    18\t      const box = node.getBoundingClientRect();\n    19\t      if (css.overflowX !== 'visible') {\n    20\t        clip.left = Math.max(clip.left, box.left + node.clientLeft);\n    21\t        clip.right = Math.min(clip.right, box.left + node.clientLeft + node.clientWidth);\n    22\t      }\n    23\t      if (css.overflowY !== 'visible') {\n    24\t        clip.top = Math.max(clip.top, box.top + node.clientTop);\n    25\t        clip.bottom = Math.min(clip.bottom, box.top + node.clientTop + node.clientHeight);\n    26\t      }\n    27\t    }\n    28\t    const range = document.createRange();\n    29\t    range.selectNodeContents(element);\n    30\t    const glyphs = [...range.getClientRects()].filter(rect => rect.width > 0 && rect.height > 0);\n    31\t    return glyphs.length > 0 && glyphs.every(rect => rect.left >= clip.left - 1 && rect.right <= clip.right + 1 &&\n    32\t      rect.top >= clip.top - 1 && rect.bottom <= clip.bottom + 1);\n    33\t  }, { bounds, allowHidden });\n    34\t}\n    35\t\n    36\texport async function titleCheck(figure) {\n    37\t  const title = figure.locator('.axylo-title');\n    38\t  const drawn = await title.count();\n    39\t  const pass = drawn === 0 || (drawn === 1 && await textFits(title, figure, { allowHidden: true }));\n    40\t  return { pass, detail: pass ? 'Visible title fits inside the figure.' : 'Title text is clipped.' };\n    41\t}\n    42\t\n    43\tfunction omissionCount(text) {\n    44\t  const counts = [];\n    45\t  for (const pattern of [\n    46\t    /\\bvalues? (?:not shown|left out|omitted)\\s*:\\s*([\\d,]+)\\b/gi,\n    47\t    /\\b([\\d,]+) values? (?:were )?(?:not shown|left out|omitted)\\b/gi,\n    48\t    /\\b(?:omitted|left out)\\s+([\\d,]+) values?\\b/gi,\n    49\t  ]) {\n    50\t    for (const match of text.matchAll(pattern)) counts.push(Number(match[1].replaceAll(',', '')));\n    51\t  }\n    52\t  return counts;\n    53\t}\n    54\t\n    55\tasync function accessibleNote(page) {\n    56\t  const session = await page.context().newCDPSession(page);\n    57\t  try {\n    58\t    const { root } = await session.send('DOM.getDocument', { depth: 0 });\n    59\t    const { nodeId } = await session.send('DOM.querySelector', { nodeId: root.nodeId, selector: '#chart figure .axylo-note' });\n    60\t    if (!nodeId) return '';\n    61\t    const { node } = await session.send('DOM.describeNode', { nodeId });\n    62\t    const { nodes } = await session.send('Accessibility.getFullAXTree');\n    63\t    const indexed = new Map(nodes.map(item => [item.nodeId, item]));\n    64\t    const note = nodes.find(item => item.backendDOMNodeId === node.backendNodeId);\n    65\t    if (!note || note.ignored) return '';\n    66\t    function text(item) {\n    67\t      const children = (item.childIds ?? []).map(id => indexed.get(id)).filter(Boolean);\n    68\t      return [\n    69\t        ...(!item.ignored && ['status', 'StaticText'].includes(item.role?.value) ? [item.name?.value ?? ''] : []),\n    70\t        ...children.flatMap(text),\n    71\t      ];\n    72\t    }\n    73\t    return text(note).join(' ');\n    74\t  } finally {\n    75\t    await session.detach();\n    76\t  }\n    77\t}\n    78\t\n    79\texport async function noteCheck(page, figure, count = 0) {\n    80\t  const note = figure.locator('.axylo-note');\n    81\t  const visible = await note.count() === 1 && await note.isVisible();\n    82\t  const text = visible ? normalizedText(await note.innerText()) : '';\n    83\t  const onScreen = omissionCount(text);\n    84\t  const inTree = omissionCount(visible ? await accessibleNote(page) : '');\n    85\t  const matches = counts => count ? counts.length > 0 && counts.every(n => n === count) : counts.length === 0;\n    86\t  const pass = matches(onScreen) && matches(inTree) && (!count || await textFits(note, figure));\n    87\t  return { pass, detail: `Expected ${count} omission(s). Visible note: ${text || 'none'}. Accessible counts: ${inTree.join(', ') || 'none'}.` };\n    88\t}\n    89\t\n    90\texport async function dateCheck(figure, expected) {\n    91\t  if (expected.x !== 'date') return { pass: true, detail: 'Category axis.' };\n    92\t  const slider = figure.locator('.axylo-proxy');\n    93\t  if (await slider.count() !== 1) return { pass: false, detail: 'No keyboard plot control.' };\n    94\t  await slider.press('Home');\n    95\t  const tooltip = figure.locator('.axylo-tooltip-title:visible');\n    96\t  const reading = await slider.getAttribute('aria-valuetext') ?? '';\n    97\t  // The default keyboard text starts with the date, then reads the series and point number.\n    98\t  const firstPart = reading.match(/^(.+)\\. .+\\. Point \\d/)?.[1] ?? '';\n    99\t  const sample = await tooltip.count() === 1 ? await tooltip.innerText() : firstPart;\n   100\t  const [wanted] = expected.rows.find(([, ...values]) => values.some(value => value !== null));\n   101\t  return { pass: calendarDate(sample) === wanted, detail: `Expected ${wanted}, read ${JSON.stringify(sample)}.` };\n   102\t}\n   103\t\n   104\texport async function plotCheck(figure, expected) {\n   105\t  if (expected.type === 'bar') {\n   106\t    const ticks = await figure.locator('.axylo-text [data-role=\"tick-x\"]:visible').evaluateAll(labels => labels.map(label => {\n   107\t      const box = label.getBoundingClientRect();\n   108\t      return { label: label.textContent.trim(), x: box.x + box.width / 2, y: box.y + box.height / 2 };\n   109\t    }));\n   110\t    const spread = key => Math.max(...ticks.map(tick => tick[key])) - Math.min(...ticks.map(tick => tick[key]));\n   111\t    const axis = spread('x') >= spread('y') ? 'x' : 'y';\n   112\t    ticks.sort((a, b) => a[axis] - b[axis]);\n   113\t    const bars = await figure.locator('svg.axylo-svg .axylo-scene g > rect:visible').evaluateAll((rects, axis) =>\n   114\t      rects.flatMap(rect => {\n   115\t        if (!/--axylo-series-color-\\d+\\b/.test(rect.parentElement.style.getPropertyValue('color'))) return [];\n   116\t        const box = rect.getBoundingClientRect();\n   117\t        if (box.width <= 0 || box.height <= 0) return [];\n   118\t        return [axis === 'x' ? box.x + box.width / 2 : box.y + box.height / 2];\n   119\t      }), axis);\n   120\t    const groups = ticks.map(() => 0);\n   121\t    for (const center of bars) {\n   122\t      const distances = ticks.map(tick =>