ents, agent) {\n    82\t  const last = events.at(-1);\n    83\t  if (agent === 'claude') {\n    84\t    return last?.type === 'result' && typeof last.is_error === 'boolean' &&\n    85\t      events.slice(0, -1).some(event => event.type === 'system' && event.subtype === 'init');\n    86\t  }\n    87\t  if (events[0]?.type !== 'thread.started' || !events[0].thread_id ||\n    88\t      !events.some(event => event.type === 'turn.started') ||\n    89\t      !['turn.completed', 'turn.failed'].includes(last?.type)) return false;\n    90\t  const openItems = new Set();\n    91\t  for (const event of events) {\n    92\t    if (event.type === 'item.started') openItems.add(event.item?.id);\n    93\t    if (event.type === 'item.completed') openItems.delete(event.item?.id);\n    94\t  }\n    95\t  return openItems.size === 0;\n    96\t}\n    97\t\n    98\texport function auditHasPathViolation(audit) {\n    99\t  return Boolean(audit.linkedLogin ||\n   100\t    audit.paths.some(path => !audit.outsidePaths?.some(look => look.path === path && !look.exists)));\n   101\t}\n   102\t\n   103\texport function auditAllowsGrade(audit) {\n   104\t  return audit.status === 'no findings' || audit.status === 'looked outside the workspace';\n   105\t}\n   106\t\n   107\texport async function auditTranscript(transcript, { workspace, runDirectory, home = workspace, codexHome, claudeConfigDir,\n   108\t  temporary, loginLink, realHome = homedir(), repo = repository, pathEvidence = {} }, agent) {\n   109\t  const forbidden = new Set();\n   110\t  const looks = new Map();\n   111\t  const checked = new Set();\n   112\t  const { events, malformedLines } = transcriptEvents(transcript);\n   113\t  const completeTranscript = complete(events, agent);\n   114\t  const unavailable = events.length === 0 ? 'No transcript events.' : malformedLines\n   115\t    ? `${malformedLines} malformed transcript line(s).` : !completeTranscript ? 'Incomplete transcript lifecycle.' : null;\n   116\t  const denied = new Set(events.filter(event => event.type === 'system' && event.subtype === 'permission_denied')\n   117\t    .map(event => event.tool_use_id).filter(Boolean));\n   118\t  const finalDenials = events.at(-1)?.permission_denials;\n   119\t  for (const denial of Array.isArray(finalDenials) ? finalDenials : []) {\n   120\t    if (denial?.tool_use_id) denied.add(denial.tool_use_id);\n   121\t  }\n   122\t  const externalTools = new Set();\n   123\t  let unparseableInput = false;\n   124\t  let linkedLogin;\n   125\t\n   126\t  function toPath(text, base, bare) {\n   127\t    return localPath(text, base, { HOME: home, CODEX_HOME: codexHome, CLAUDE_CONFIG_DIR: claudeConfigDir,\n   128\t      TMPDIR: temporary, PWD: resolve(base) }, bare);\n   129\t  }\n   130\t\n   131\t  function forbiddenZone(path) {\n   132\t    return !inside(runDirectory, path) && (inside(repo, path) || inside(realHome, path) ||\n   133\t      /(?:^|\\/)axylo-rehearsal-[A-Za-z0-9]{6}(?:\\/|$)/.test(path));\n   134\t  }\n   135\t\n   136\t  async function check(path) {\n   137\t    if (!path || checked.has(path)) return;\n   138\t    checked.add(path);\n   139\t    const direct = resolve(path);\n   140\t    if (forbiddenZone(direct)) forbidden.add(direct);\n   141\t    // Saved observations let replay classify links from the removed workspace and preserve the outside existence check.\n   142\t    const info = pathEvidence[path] ??= await resolveLinks(path, loginLink);\n   143\t    if (info.readLogin) {\n   144\t      linkedLogin = info.path;\n   145\t    } else if (forbiddenZone(info.path)) {\n   146\t      forbidden.add(info.path);\n   147\t    } else if ((!inside(runDirectory, info.path) || !inside(runDirectory, direct)) && !forbidden.has(direct)) {\n   148\t      info.systemTool ??= await systemTool(direct) || await systemTool(info.path);\n   149\t      if (info.systemTool) return;\n   150\t      info.exists ??= await stat(info.path).then(() => true, error => {\n   151\t        if (['ENOENT', 'ENOTDIR'].includes(error.code)) return false;\n   152\t        throw error;\n   153\t      });\n   154\t      const outside = inside(runDirectory, direct) ? info.path : direct;\n   155\t      looks.set(outside, (looks.get(outside) ?? false) || info.exists);\n   156\t    }\n   157\t  }\n   158\t\n   159\t  async function shell(command, cwd) {\n   160\t    if (typeof command !== 'string') {\n   161\t      unparseableInput = true;\n   162\t      return;\n   163\t    }\n   164\t    const directory = toPath(cwd, workspace, true);\n   165\t    await check(directory);\n   166\t    try {\n   167\t      for (const path of commandPaths(command, directory ?? (cwd === '/' ? cwd : workspace), toPath)) await check(path);\n   168\t    } catch (error) {\n   169\t      if (error.message !== 'Unterminated shell word.') throw error;\n   170\t      unparseableInput = true;\n   171\t    }\n   172\t  }\n   173\t\n   174\t  for (const event of events) {\n   175\t    const item = event.item;\n   176\t    if (['web_search', 'mcp_tool_call'].includes(item?.type)) externalTools.add(item.type);\n   177\t    if (item?.type === 'command_execution') await shell(item.command, item.cwd ?? item.workdir);\n   178\t    if (item?.type === 'file_change') {\n   179\t      if (!Array.isArray(item.changes)) unparseableInput = true;\n   180\t      else for (const change of item.changes) await check(toPath(change?.path, workspace, true));\n   181\t    }\n   182\t    const content = event.type === 'assistant' ? event.message?.content : undefined;\n   183\t    if (content !== undefined && !Array.isArray(content)) unparseableInput = true;\n   184\t    const tools = event.type === 'tool_use' ? [event] : Array.isArray(content)\n   185\t      ? content.filter(part => part?.type === 'tool_use') : [];\n   186\t    for (const tool of tools) {\n   187\t      if (!Object.hasOwn(fileTools, tool.name) && tool.name !== 'Bash') {\n   188\t        externalTools.add(tool.name ?? '(unknown)');\n   189\t        continue;\n   190\t      