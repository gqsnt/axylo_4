  149\t  const ordered = step > 0 && vertices.length === present.length &&\n   150\t    vertices.every(({ x }, i) => Math.abs(x - (vertices[0].x + (present[i].index - present[0].index) * step)) <= 1);\n   151\t  const gaps = expected.rows.flatMap(([day, value]) => value === null ? [day] : []);\n   152\t  const broken = ordered && present.every(({ index }, i) => {\n   153\t    const startsRun = i === 0 || index - present[i - 1].index > 1;\n   154\t    return vertices[i].command === (startsRun ? 'M' : 'L');\n   155\t  });\n   156\t  return {\n   157\t    order: { pass: ordered, detail: `Expected ${present.length} left-to-right calendar slots, saw ${vertices.length} stroke vertices.` },\n   158\t    gaps: { pass: broken, detail: gaps.length ? `Expected stroke breaks at ${gaps.join(', ')}.` : 'Expected one continuous stroke.' },\n   159\t  };\n   160\t}\n     1\tconst months = ['january', 'february', 'march', 'april', 'may', 'june',\n     2\t  'july', 'august', 'september', 'october', 'november', 'december'];\n     3\t\n     4\texport const normalizedText = text => text.trim().replace(/\\s+/g, ' ');\n     5\t\n     6\texport function calendarDate(text) {\n     7\t  const value = normalizedText(text).replace(/^(?:mon(?:day)?|tue(?:sday)?|wed(?:nesday)?|thu(?:rsday)?|fri(?:day)?|sat(?:urday)?|sun(?:day)?)\\.?[,]? /i, '');\n     8\t  const iso = /^(\\d{4})([-/])(\\d{2})\\2(\\d{2})$/.exec(value);\n     9\t  const numeric = /^(\\d{1,2})\\/(\\d{1,2})\\/(\\d{4})$/.exec(value);\n    10\t  const monthFirst = /^([a-z]+)\\.? (\\d{1,2}),? (\\d{4})$/i.exec(value);\n    11\t  const dayFirst = /^(\\d{1,2}) ([a-z]+)\\.?,? (\\d{4})$/i.exec(value);\n    12\t  const word = (monthFirst?.[1] ?? dayFirst?.[2])?.toLowerCase();\n    13\t  const dayFirstNumeric = Number(numeric?.[1]) > 12;\n    14\t  const month = Number(iso?.[3] ?? numeric?.[dayFirstNumeric ? 2 : 1] ??\n    15\t    (months.findIndex(name => name === word || name.slice(0, 3) === word) + 1));\n    16\t  const day = Number(iso?.[4] ?? numeric?.[dayFirstNumeric ? 1 : 2] ?? monthFirst?.[2] ?? dayFirst?.[1]);\n    17\t  const year = Number(iso?.[1] ?? numeric?.[3] ?? monthFirst?.[3] ?? dayFirst?.[3]);\n    18\t  if (!month || !day || !year) return null;\n    19\t  const date = new Date(Date.UTC(year, month - 1, day));\n    20\t  return date.getUTCMonth() === month - 1 && date.getUTCDate() === day ? date.toISOString().slice(0, 10) : null;\n    21\t}\n    22\t\n    23\tfunction cellValue(text, unit) {\n    24\t  text = normalizedText(text);\n    25\t  if (text === 'No data') return null;\n    26\t  if (unit) {\n    27\t    if (!text.endsWith(' ' + unit)) return undefined;\n    28\t    text = text.slice(0, -(unit.length + 1));\n    29\t  }\n    30\t  const number = text.replace(/^−/, '-');\n    31\t  if (/^[+-]?(?:(?:\\d{1,3}(?:,\\d{3})+|\\d+)(?:\\.\\d*)?|\\.\\d+)(?:e[+-]?\\d+)?$/i.test(number)) {\n    32\t    return Number(number.replaceAll(',', ''));\n    33\t  }\n    34\t  return undefined;\n    35\t}\n    36\t\n    37\texport function seriesHeaders(expected) {\n    38\t  return expected.series.map(({ label, unit }) => unit ? `${label} (${unit})` : label);\n    39\t}\n    40\t\n    41\texport function compareHeaders(expected, headers) {\n    42\t  const wanted = seriesHeaders(expected);\n    43\t  const columns = wanted.length + 1;\n    44\t  const order = expected.series.map(({ label, unit }) => headers.findIndex((header, index) => {\n    45\t    if (index === 0) return false;\n    46\t    const rendered = normalizedText(header);\n    47\t    const suffix = unit ? ` (${unit})` : '';\n    48\t    return rendered.endsWith(suffix) &&\n    49\t      rendered.slice(0, rendered.length - suffix.length).toLowerCase() === normalizedText(label).toLowerCase();\n    50\t  }));\n    51\t  const pass = headers.length === columns && !order.includes(-1) && new Set(order).size === wanted.length;\n    52\t  return { pass, order, detail: `Expected series columns ${JSON.stringify(wanted)}, saw ${JSON.stringify(headers.slice(1))}.` };\n    53\t}\n    54\t\n    55\texport function compareRows(expected, rows, order = expected.series.map((_, i) => i + 1)) {\n    56\t  let index = 0;\n    57\t  for (const [x, ...values] of expected.rows) {\n    58\t    const row = rows[index];\n    59\t    const displayedX = row?.length && (expected.x === 'date' ? calendarDate(row[0]) : normalizedText(row[0]));\n    60\t    if (displayedX !== x && values.every(value => value === null)) continue;\n    61\t    if (!row || row.length !== order.length + 1 || displayedX !== x ||\n    62\t        values.some((value, i) => value !== cellValue(row[order[i]], expected.series[i].unit))) {\n    63\t      return { pass: false, detail: `Row ${index + 1} expected ${JSON.stringify([x, ...values])}, saw ${JSON.stringify(row ?? null)}.` };\n    64\t    }\n    65\t    index++;\n    66\t  }\n    67\t  if (index < rows.length) {\n    68\t    return { pass: false, detail: `Unexpected row ${index + 1} ${JSON.stringify(rows[index])}.` };\n    69\t  }\n    70\t  return { pass: true, detail: `${rows.length} rows match.` };\n    71\t}\n","exit_code":0,"status":"completed"}}
