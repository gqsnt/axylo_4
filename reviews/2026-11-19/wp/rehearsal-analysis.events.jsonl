=> digest(await readFile(file));\n    19\t\n    20\tasync function treeHash(directory) {\n    21\t  if (!(await lstat(directory)).isDirectory()) throw new Error('Expected an input directory: ' + directory);\n    22\t  const tree = await readdir(directory, { recursive: true, withFileTypes: true });\n    23\t  if (tree.some(entry => !entry.isDirectory() && !entry.isFile())) throw new Error('Unexpected entry in input tree: ' + directory);\n    24\t  const files = tree.filter(entry => entry.isFile()).map(entry => join(entry.parentPath, entry.name).slice(directory.length + 1)).sort();\n    25\t  const entries = await Promise.all(files.map(async file => [file, await fileHash(join(directory, file))]));\n    26\t  return digest(JSON.stringify(entries));\n    27\t}\n    28\t\n    29\tconst stagedFiles = { prompt: 'PROMPT.md', input: 'data.json', manifest: 'package.json' };\n    30\t\n    31\tasync function stagedHashes(workspace) {\n    32\t  const files = Object.entries(stagedFiles).map(async ([key, name]) => {\n    33\t    const file = join(workspace, name);\n    34\t    if (!(await lstat(file)).isFile()) throw new Error('Expected a regular input file: ' + file);\n    35\t    return [key, await fileHash(file)];\n    36\t  });\n    37\t  const entries = await Promise.all([\n    38\t    treeHash(join(workspace, 'docs')).then(hash => ['docs', hash]),\n    39\t    treeHash(join(workspace, 'node_modules')).then(hash => ['installedPackage', hash]),\n    40\t    ...files,\n    41\t  ]);\n    42\t  return Object.fromEntries(entries);\n    43\t}\n    44\t\n    45\texport async function inputChanges(workspace, original) {\n    46\t  try {\n    47\t    const current = await stagedHashes(workspace);\n    48\t    return Object.keys(current).filter(key => current[key] !== original[key]).join(', ');\n    49\t  } catch (error) {\n    50\t    return error.message;\n    51\t  }\n    52\t}\n    53\t\n    54\texport async function inputHashes(workspace, task) {\n    55\t  const { alternate, expected, alternateExpected } = taskFiles(task);\n    56\t  const sources = {\n    57\t    package: fileHash(packedPackage),\n    58\t    alternate: fileHash(alternate),\n    59\t    expected: fileHash(expected),\n    60\t    alternateExpected: fileHash(alternateExpected),\n    61\t    grader: Promise.all([\n    62\t      ...['grade.mjs', 'reader.mjs', 'table.mjs', 'files.mjs'].map(file => fileHash(join(rehearsal, file))),\n    63\t      fileHash(join(repository, 'packages/axylo/src/diagnostics/registry.ts')),\n    64\t    ]).then(hashes => digest(JSON.stringify(hashes))),\n    65\t  };\n    66\t  const [staged, entries] = await Promise.all([\n    67\t    stagedHashes(workspace),\n    68\t    Promise.all(Object.entries(sources).map(async ([key, hash]) => [key, await hash])),\n    69\t  ]);\n    70\t  return { ...staged, ...Object.fromEntries(entries) };\n    71\t}\n    72\t\n    73\texport async function readRecords(root) {\n    74\t  const entries = await readdir(root, { withFileTypes: true }).catch(error => {\n    75\t    if (error.code === 'ENOENT') return [];\n    76\t    throw error;\n    77\t  });\n    78\t  const records = await Promise.all(entries.filter(entry => entry.isDirectory()).map(async ({ name }) => {\n    79\t    try {\n    80\t      const directory = join(root, name);\n    81\t      const record = { ...await readJson(join(directory, 'run.json')), name };\n    82\t      if (!record.history?.length && record.protocol === protocol && record.status === 'fail' && record.exit &&\n    83\t          Object.hasOwn(models, record.agent)) {\n    84\t        // Reopen older slots when the saved CLI evidence identifies an infrastructure failure.\n    85\t        const transcript = await readFile(join(directory, 'transcript.jsonl'), 'utf8').catch(error => {\n    86\t          if (error.code === 'ENOENT') return null;\n    87\t          throw error;\n    88\t        });\n    89\t        if (transcript !== null) {\n    90\t          const { infrastructure } = agent