{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat rehearsal/run.mjs rehearsal/grade.mjs'","aggregated_output":"import { copyFile, cp, lstat, mkdir, mkdtemp, readFile } from 'node:fs/promises';\nimport { homedir, tmpdir } from 'node:os';\nimport { join, relative, resolve } from 'node:path';\nimport { parseArgs } from 'node:util';\nimport { agentArgs, agentErrors, agentVersion, observeAgent, runAgent } from './agent.mjs';\nimport { auditTranscript } from './audit.mjs';\nimport { isMain, tasks, writeJson } from './files.mjs';\nimport { grade } from './grade.mjs';\nimport { cells, defaultRecords, effort, inputChanges, inputHashes, models, nextAttempts, observedMatches,\n  protocol, readRecords, target, timeoutMs } from './protocol.mjs';\nimport { prepareWorkspace, removeWorkspace } from './workspace.mjs';\n\nconst inputs = new Set(['docs', 'node_modules', 'data.json', 'PROMPT.md', 'package.json', 'grade.json']);\n\nfunction classify({ agent, exit, audit, observed, result, infrastructure, cliError, changed }) {\n  if (infrastructure) return ['infrastructure', infrastructure];\n  // A timeout is a counted outcome even when killing the process interrupts the transcript.\n  if (exit?.timedOut) return ['timeout', 'Agent exceeded the 20-minute limit.'];\n  if (audit.status !== 'no findings') return ['void', audit.problems.join(' ')];\n  if (cliError) return ['fail', cliError];\n  if (!observedMatches(agent, observed)) {\n    return ['void', agent === 'claude' ? 'Could not verify the requested model.' : 'Could not verify the requested model and effort.'];\n  }\n  if (changed) return ['void', 'Staged inputs changed: ' + changed];\n  const browserError = result.criteria.find(item => item.name === 'browser');\n  if (browserError) return ['infrastructure', browserError.detail];\n  return result.pass ? ['pass', null] : ['fail', result.criteria.filter(item => !item.pass).map(item => item.name).join(', ')];\n}\n\nexport async function attempt(job, { records, workdir, login = join(homedir(), '.codex', 'auth.json'),\n  claudeLogin = join(homedir(), '.claude', '.credentials.json'),\n  prepare = prepareWorkspace, version = agentVersion, launch = runAgent, gradeAnswer = grade } = {}) {\n  const { agent, task, slot, replaces } = job;\n  const start = new Date();\n  const record = await mkdtemp(join(records, `${start.toISOString().slice(0, 10)}-${agent}-${task}-${slot}-`));\n  const requested = { model: models[agent], effort };\n  const anthropicApiKey = agent === 'claude' ? process.env.ANTHROPIC_API_KEY : undefined;\n  const claudeMode = agent === 'claude' ? (anthropicApiKey ? 'bare' : 'fresh-config') : undefined;\n  const cli = { version: null, versionArgs: ['--version'], args: null };\n  let prepared, exit, audit, observed, result, infrastructure, cliError, changed;\n  try {\n    prepared = await prepare(workdir, task, { agent, codexLogin: agent === 'codex' ? login : undefined,\n      claudeLogin: claudeMode === 'fresh-config' ? claudeLogin : undefined,\n      inputHashes: workspace => inputHashes(workspace, task) });\n    const { workspace, codexHome, home } = prepared;\n    const options = { ...prepared, ...requested, timeoutMs, anthropicApiKey };\n    cli.args = agentArgs(agent, options);\n    cli.version = await version(agent, options);\n    const { transcript, stderr, exit: agentExit } = await launch(agent, options);\n    exit = agentExit;\n    await Promise.all([\n      copyFile(transcript, join(record, 'transcript.jsonl')),\n      copyFile(stderr, join(record, 'stderr.log')),\n      cp(workspace, join(record, 'answer'), {\n        recursive: true,\n        async filter(path) {\n          if (inputs.has(relative(workspace, path).split('/')[0])) return false;\n          const info = await lstat(path);\n          return info.isDirectory() || info.isFile();\n        },\n      }),\n    ]);\n    const log = await readFile(transcript, 'utf8');\n    [audit, observed] = await Promise.all([auditTranscript(log, workspace, agent, home), observeAgent(agent, log, codexHome)]);\n    ({ infrastructure, cliError } = agentErrors(agent, log, exit));\n    if (!exit.timedOut && !infrastructure && !cliError &&\n        audit.status === 'no findings' && observedMatches(agent, observed)) {\n      changed = await inputChanges(workspace, prepared.hashes);\n      if (!changed) result = await gradeAnswer(workspace, task);\n    }\n  } catch (error) {\n    infrastructure = String(error);\n  }\n  const [status, reason] = classify({ agent, exit, audit, observed, result, infrastructure, cliError, changed });\n  const end = new Date();\n  try {\n    if (result) await writeJson(join(record, 'grade.json'), result);\n    await writeJson(join(record, 'run.json'), {\n      kind: 'agent rehearsal', protocol, agent, claudeMode, task, slot, replaces, status, reason, requested, observed, cli,\n      effectiveEffort: observed?.effort ?? null,\n      effortEvidence: agent === 'claude' ? '--effort flag; stream does not expose effective effort' : 'turn_context',\n      hashes: prepared?.hashes, browserVersion: result?.browserVersion,\n      startedAt: start.toISOString(), endedAt: end.toISOString(), durationMs: end - start,\n      timeoutMs, exit, audit,\n    });\n  } finally {\n    if (prepared) await removeWorkspace(prepared.runDirectory);\n  }\n  return { status, record, reason };\n}\n\nexport async function runBatch(jobs, workers, run) {\n  let next = 0;\n  const results = [];\n  await Promise.all(Array.from({ length: Math.min(workers, jobs.length) }, async () => {\n    while (next < jobs.length) {\n      const index = next++;\n      results[index] = await run(jobs[index]);\n    }\n  }));\n  return results;\n}\n\nasync function main() {\n  const { values } = parseArgs({ options: {\n    agent: { type: 'string' }, task: { type: 'string' }, workdir: { type: 'string', default: tmpdir() },\n    records: { type: 'string', default: defaultRecords }, attempts: { type: 'string', default: String(target) },\n    parallel: { type: 'string', default: '1' },\n  } });\n  const { agent, task, workdir } = values;\n  const attempts = Number(values.attempts);\n  const parallel = Number(values.parallel);\n  if ((agent && !Object.hasOwn(models, agent)) || (task && !tasks.includes(task)) ||\n      [attempts, parallel].some(n => !Number.isSafeInteger(n) || n < 1)) {\n    throw new Error('Usage: node rehearsal/run.mjs [--agent codex|claude] [--task <id>] [--attempts <n>] [--parallel <n>] [--workdir <dir>] [--records <dir>]');\n  }\n  const records = resolve(values.records);\n  await mkdir(records, { recursive: true });\n  const previous = await readRecords(records);\n  const jobs = cells.filter(cell => (!agent || cell.agent === agent) && (!task || cell.task === task))\n    .flatMap(cell => nextAttempts(previous, cell, attempts));\n  if (!jobs.length) console.log('No open attempt slots in the selected cells.');\n  const results = await runBatch(jobs, parallel, async job => {\n    const result = await attempt(job, { records, workdir });\n    console.log(`${job.agent} / ${job.task} / ${job.slot}: ${result.status}${result.reason ? ' — ' + result.reason : ''}. Record: ${result.record}`);\n    return result;\n  });\n  process.exitCode = results.some(result => result.status === 'infrastructure') ? 2\n    : results.some(result => result.status !== 'pass') ? 1 : 0;\n}\n\nif (isMain(import.meta.url)) {\n  try {\n    await main();\n  } catch (error) {\n    console.error(String(error));\n    process.exitCode = 2;\n  }\n}\nimport { lstat, readFile, realpath } from 'node:fs/promises';\nimport { basename, join, resolve } from 'node:path';\nimport { parseArgs } from 'node:util';\nimport { build } from 'esbuild';\nimport { chromium } from 'playwright-core';\nimport { inside, isMain, readJson, repository, taskFiles, writeJson } from './files.mjs';\nimport { dateCheck, noteCheck, plotCheck, titleCheck } from './reader.mjs';\nimport { compareHeaders, compareRows, normalizedText } from './table.mjs';\n\nconst zones = ['America/Los_Angeles', 'Asia/Tokyo'];\nconst timeout = 5000;\nconst origin = 'https://axylo-rehearsal.invalid';\nconst criteriaNames = ['render', 'no error diagnostics', 'accessible name', 'visible title', 'table caption',\n  'table headers', 'table rows', 'plotted x order', 'drawn gaps', 'reader date', 'reader note', 'chart type'];\nconst criterion = (name, pass, detail) => ({ name, pass, detail });\n\nasync function registryLevels() {\n  const registry = await readFile(join(repository, 'packages/axylo/src/diagnostics/registry.ts'), 'utf8');\n  const levels = new Map([...registry.matchAll(/^\\s*(AX\\d+): \\{ level: '(error|warning|hint)'/gm)]\n    .map(([, code, level]) => [code, level]));\n  if (levels.get('AX101') !== 'error' || levels.get('AX140') !== 'warning') {\n    throw new Error('Could not read diagnostic levels from the Axylo registry.');\n  }\n  return levels;\n}\n\nasync function bundle(workspace, data) {\n  const result = await build({\n    absWorkingDir: workspace,\n    stdin: {\n      resolveDir: workspace,\n      contents: `\n        import * as answer from './chart.js';\n        try {\n          const render = Reflect.get(answer, 'default');\n          if (typeof render !== 'function') throw new Error('chart.js must default-export a render function.');\n          const handle = render(document.getElementById('chart'), ${JSON.stringify(data)});\n          if (!handle || typeof handle.update !== 'function' || typeof handle.destroy !== 'function' ||\n              !Array.isArray(handle.diagnostics)) {\n            throw new Error('render must return the Axylo chart handle.');\n          }\n          window.rehearsalRender = { handle };\n        } catch (error) {\n          window.rehearsalRender = { error: String(error), diagnostics: error?.diagnostics };\n        }\n      `,\n    },\n    bundle: true,\n    format: 'iife',\n    platform: 'browser',\n    conditions: ['browser'],\n    write: false,\n    outfile: 'chart-bundle.js',\n    logLevel: 'silent',\n    plugins: [{\n      name: 'workspace-files',\n      setup(builder) {\n        builder.onLoad({ filter: /.*/, namespace: 'file' }, async args => {\n          if (!inside(workspace, await realpath(args.path))) {\n            return { errors: [{ text: 'Import outside the rehearsal workspace: ' + args.path }] };\n          }\n        });\n      },\n    }],\n  });\n  return new Map(result.outputFiles.map(file => ['/' + basename(file.path), file.text]));\n}\n\nconst html = `<!doctype html><html lang=\"en-US\"><meta charset=\"utf-8\">\n<title>Axylo rehearsal</title><link rel=\"stylesheet\" href=\"/chart-bundle.css\">\n<div id=\"chart\" style=\"width:720px;height:400px\"></div><script src=\"/chart-bundle.js\"></script></html>`;\n\nasync function inspect(browser, files, expected, levels, timezoneId, input) {\n  const context = await browser.newContext({ timezoneId, locale: 'en-US', serviceWorkers: 'block' });\n  const criteria = [];\n  const diagnostics = new Map();\n  const errors = [];\n  let table;\n  const addDiagnostic = (code, diagnostic, source) => {\n    const previous = diagnostics.get(code);\n    diagnostics.set(code, {\n      ...previous, ...diagnostic, code, level: levels.get(code) ?? diagnostic.level ?? 'unknown', timezoneId,\n      sources: [...new Set([...(previous?.sources ?? []), source])],\n    });\n  };\n\n  try {\n    await context.route('**/*', route => {\n      const url = new URL(route.request().url());\n      if (url.origin !== origin) return route.abort();\n      if (url.pathname === '/') {\n        return route.fulfill({\n          contentType: 'text/html',\n          body: html,\n          headers: {\n            'Content-Security-Policy': \"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'\",\n          },\n        });\n      }\n      if (url.pathname.endsWith('.css')) {\n        return route.fulfill({ contentType: 'text/css', body: files.get(url.pathname) ?? '' });\n      }\n      const script = files.get(url.pathname);\n      return script === undefined ? route.abort() : route.fulfill({ contentType: 'text/javascript', body: script });\n    });\n\n    const page = await context.newPage();\n    page.setDefaultTimeout(timeout);\n    page.on('pageerror', error => errors.push(String(error)));\n    page.on('console', message => {\n      const text = message.text();\n      const code = /\\[axylo (AX\\d+)\\]/.exec(text)?.[1];\n      if (code) addDiagnostic(code, { console: text }, 'console');\n    });\n    await page.goto(origin, { waitUntil: 'load', timeout });\n    const problem = await page.evaluate(() => window.rehearsalRender?.error ?? null);\n    const figure = page.locator('#chart figure');\n    let state = '';\n    if (!problem && errors.length === 0) {\n      await page.waitForFunction(() => new Promise(done => {\n        requestAnimationFrame(() => requestAnimationFrame(() => done(true)));\n      }));\n\n      if (await figure.count() === 1) {\n        const byName = page.getByRole('group', { name: expected.title, exact: true })\n          .or(page.getByRole('figure', { name: expected.title, exact: true }))\n          .or(page.getByRole('img', { name: expected.title, exact: true }));\n        const titlePass = await figure.and(byName).count() === 1;\n        const name = titlePass ? expected.title : (await figure.ariaSnapshot()).split('\\n')[0];\n        criteria.push(criterion('accessible name', titlePass, name || 'No accessible figure name.'));\n        criteria.push({ name: 'visible title', ...await titleCheck(figure) });\n        state = (await figure.locator('.axylo-message:visible').allTextContents()).join(' ');\n        const description = (await figure.locator('.axylo-description').allTextContents())[0] ?? '';\n        const types = await figure.locator('[aria-roledescription]').evaluateAll(nodes =>\n          nodes.map(node => node.getAttribute('aria-roledescription')));\n        const observedType = (types.find(type => /^(?:line|area|bar|scatter|donut) chart$/i.test(type)) ?? description)\n          .match(/^(line|area|bar|scatter|donut) chart\\b/i)?.[1].toLowerCase();\n        criteria.push(criterion('chart type', observedType === expected.type,\n          `Expected ${expected.type}, saw ${observedType ?? 'no chart type'}.`));\n\n        const plot = await plotCheck(figure, expected);\n        criteria.push({ name: 'plotted x order', ...plot.order }, { name: 'drawn gaps', ...plot.gaps });\n        criteria.push({ name: 'reader date', ...await dateCheck(figure, expected) });\n        criteria.push({ name: 'reader note', ...await noteCheck(page, figure, expected.valuesNotShown) });\n        try {\n          const button = figure.getByRole('button', { name: 'View as table', exact: true });\n          if (await button.count() === 1) {\n            await button.click();\n            const view = figure.getByRole('table');\n            if (await view.count() === 1 && await view.isVisible()) {\n              table = await view.evaluate(element => ({\n                caption: element.caption?.textContent ?? '',\n                headers: Array.from(element.tHead?.rows[0]?.cells ?? [], cell => cell.textContent.trim()),\n                rows: Array.from(element.tBodies[0]?.rows ?? [], row =>\n                  Array.from(row.cells, cell => cell.textContent.trim())),\n              }));\n              const named = await view.and(figure.getByRole('table', { name: expected.title, exact: true })).count() === 1;\n              criteria.push(criterion('table caption', named && normalizedText(table.caption) === expected.title,\n                table.caption || 'No table caption.'));\n              const header = compareHeaders(expected, table.headers);\n              const semantic = await view.getByRole('columnheader').count() === table.headers.length &&\n                await view.getByRole('rowheader').count() === table.rows.length;\n              criteria.push(criterion('table headers', header.pass && semantic,\n                header.detail + (semantic ? '' : ' Missing semantic row or column headers.')));\n              table.order = header.pass ? header.order : undefined;\n            }\n          }\n          if (!table) {\n            criteria.push(criterion('table rows', false, 'Could not open one visible table with “View as table”.'));\n          } else if (await figure.getByRole('button', { name: 'Next page', exact: true }).count()) {\n            criteria.push(criterion('table rows', false, 'Unexpected additional table pages.'));\n          } else {\n            const compared = compareRows(expected, table.rows, table.order);\n            criteria.push(criterion('table rows', compared.pass, compared.detail));\n          }\n        } catch (error) {\n          criteria.push(criterion('table rows', false, String(error)));\n        }\n      }\n    }\n\n    const handleDiagnostics = await page.evaluate(() => {\n      const result = window.rehearsalRender;\n      return result?.handle?.diagnostics ?? result?.diagnostics ?? [];\n    });\n    for (const { code, level, message } of handleDiagnostics) addDiagnostic(code, { level, message }, 'handle');\n    const errorCodes = [...diagnostics.values()].filter(d => d.level === 'error').map(d => d.code);\n    const errorState = ['Loading chart.', 'No data to show.'].includes(state) ? '' : state;\n    criteria.push(criterion('no error diagnostics', !errorState && errorCodes.length === 0,\n      [...errorCodes, errorState].filter(Boolean).join(' | ') || 'No error diagnostics or error state.'));\n    const title = criteria.find(item => item.name === 'accessible name');\n    if (title && diagnostics.has('AX140')) {\n      title.pass = false;\n      title.detail += ' (AX140)';\n    }\n\n    const reason = problem || errors.join(' | ') || (await figure.count() !== 1 && 'Expected one Axylo figure in #chart.');\n    criteria.push(criterion('render', !reason, reason || 'Rendered a chart and returned its handle.'));\n  } catch (error) {\n    criteria.push(criterion('render', false, String(error)));\n  } finally {\n    await context.close();\n  }\n\n  return {\n    input,\n    timezoneId,\n    criteria: criteriaNames.map(name => criteria.find(item => item.name === name) ??\n      criterion(name, false, 'Unavailable after render failure.')),\n    diagnostics: [...diagnostics.values()],\n    ...(table ? { table } : {}),\n  };\n}\n\nexport async function grade(workspace, task, { launch = () => chromium.launch({ channel: 'chrome', headless: true, timeout: 15000 }) } = {}) {\n  workspace = await realpath(workspace);\n  const taskPaths = taskFiles(task);\n  const inputs = await Promise.all([\n    ['primary', taskPaths.fixture, taskPaths.expected],\n    ['alternate', taskPaths.alternate, taskPaths.alternateExpected],\n  ].map(async ([name, fixture, expected]) => ({ name, data: await readJson(fixture), expected: await readJson(expected) })));\n  const save = async result => {\n    await writeJson(join(workspace, 'grade.json'), result);\n    return result;\n  };\n  const fail = (name, detail) => save({ pass: false, criteria: [criterion(name, false, detail)], diagnostics: [], timezones: [] });\n\n  let bundles;\n  try {\n    if (!(await lstat(join(workspace, 'chart.js'))).isFile()) {\n      return fail('render', 'chart.js must be a regular file.');\n    }\n    // Grade the original fixture even if the agent changed its local copy while experimenting.\n    bundles = await Promise.all(inputs.map(async input => ({ ...input, files: await bundle(workspace, input.data) })));\n  } catch (error) {\n    return fail('render', error.code === 'ENOENT' ? 'chart.js is missing.' : String(error));\n  }\n\n  const levels = await registryLevels();\n  let browser;\n  try {\n    browser = await launch();\n  } catch (error) {\n    return fail('browser', String(error));\n  }\n  try {\n    const timezones = [];\n    for (const { name, files, expected } of bundles) {\n      for (const timezoneId of zones) timezones.push(await inspect(browser, files, expected, levels, timezoneId, name));\n    }\n    const criteria = criteriaNames.map(name => {\n      const results = timezones.map(zone => zone.criteria.find(item => item.name === name));\n      return criterion(name, results.every(item => item.pass),\n        results.map((item, index) => `${timezones[index].input} / ${timezones[index].timezoneId}: ${item.detail}`).join(' | '));\n    });\n    return await save({\n      pass: criteria.every(item => item.pass),\n      browserVersion: browser.version(),\n      criteria,\n      diagnostics: timezones.flatMap(zone => zone.diagnostics),\n      timezones,\n    });\n  } catch (error) {\n    if (!browser.isConnected()) return fail('browser', String(error));\n    throw error;\n  } finally {\n    await browser.close();\n  }\n}\n\nif (isMain(import.meta.url)) {\n  try {\n    const { values } = parseArgs({ options: { task: { type: 'string' }, workdir: { type: 'string' } } });\n    if (!values.task || !values.workdir) throw new Error('Usage: node rehearsal/grade.mjs --task <id> --workdir <workspace>');\n    const result = await grade(resolve(values.workdir), values.task);\n    console.log(JSON.stringify(result, null, 2));\n    process.exitCode = result.pass ? 0 : result.criteria.some(item => item.name === 'browser') ? 2 : 1;\n  } catch (error) {\n    console.error(String(error));\n    process.exitCode = 2;\n  }\n}\n","exit_code":0,"status":"completed"}}
