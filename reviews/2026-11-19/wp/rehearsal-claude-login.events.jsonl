{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'cat rehearsal/agent.mjs rehearsal/audit.mjs rehearsal/run.mjs'","aggregated_output":"import { execFile, spawn } from 'node:child_process';\nimport { open, readdir, readFile } from 'node:fs/promises';\nimport { delimiter, isAbsolute, join } from 'node:path';\nimport { promisify } from 'node:util';\nimport { transcriptEvents } from './audit.mjs';\n\nconst exec = promisify(execFile);\nconst fileTools = ['Read', 'Write', 'Edit', 'Glob', 'Grep'];\n\nexport function agentArgs(agent, { model, effort, workspace }) {\n  if (agent === 'codex') {\n    return ['-a', 'never', 'exec', '-m', model, '-c', 'model_reasoning_effort=' + JSON.stringify(effort),\n      '-s', 'workspace-write', '-c', 'sandbox_workspace_write.network_access=false',\n      '-c', 'web_search=\"disabled\"', '--disable', 'apps', '--disable', 'plugins', '--disable', 'memories',\n      '--disable', 'hooks', '--disable', 'multi_agent_v2', '--disable', 'skill_mcp_dependency_install',\n      '--enable', 'skip_host_skill_discovery', '--ignore-user-config', '--ignore-rules',\n      '--skip-git-repo-check', '-C', workspace, '--json', '-'];\n  }\n  return ['-p', '--model', model, '--effort', effort, '--output-format', 'stream-json', '--verbose',\n    '--bare', '--restricted', '--safe-mode', '--no-chrome', '--disable-slash-commands',\n    '--strict-mcp-config', '--mcp-config', '{\"mcpServers\":{}}', '--no-session-persistence',\n    '--tools', [...fileTools, 'Bash'].join(','), '--allowedTools', [...fileTools, 'Bash(node *)'].join(','),\n    '--permission-mode', 'dontAsk', '--permission-prompts', 'none'];\n}\n\nfunction agentEnvironment(agent, { home, codexHome, temporary }) {\n  const path = process.env.PATH?.split(delimiter).filter(isAbsolute).join(delimiter);\n  const env = { PATH: path, LANG: process.env.LANG, HOME: home, TMPDIR: temporary };\n  if (agent === 'codex') env.CODEX_HOME = codexHome;\n  if (agent === 'claude') {\n    env.CLAUDE_CONFIG_DIR = join(home, '.claude');\n    if (process.env.ANTHROPIC_API_KEY) env.ANTHROPIC_API_KEY = process.env.ANTHROPIC_API_KEY;\n  }\n  return env;\n}\n\nexport async function agentVersion(agent, options) {\n  const { stdout } = await exec(agent, ['--version'], {\n    cwd: options.workspace, env: agentEnvironment(agent, options), timeout: 5000,\n  });\n  const version = stdout.trim();\n  if (!version) throw new Error(`${agent} --version returned no version.`);\n  return version;\n}\n\nexport async function runAgent(agent, options) {\n  const { workspace, runDirectory, timeoutMs } = options;\n  const transcript = join(runDirectory, 'transcript.jsonl');\n  const stderr = join(runDirectory, 'stderr.log');\n  const args = agentArgs(agent, options);\n  const handles = [];\n  let exit;\n  try {\n    for (const [name, flags] of [[join(workspace, 'PROMPT.md'), 'r'], [transcript, 'wx'], [stderr, 'wx']]) {\n      handles.push(await open(name, flags));\n    }\n    exit = await new Promise(resolve => {\n      const grouped = process.platform !== 'win32';\n      const child = spawn(agent, args, {\n        cwd: workspace,\n        env: agentEnvironment(agent, options),\n        stdio: handles.map(handle => handle.fd),\n        detached: grouped,\n      });\n      let timedOut = false;\n      let spawnError = null;\n      let force;\n      const stop = signal => {\n        if (!child.pid) return;\n        try {\n          if (grouped) process.kill(-child.pid, signal);\n          else child.kill(signal);\n        } catch (error) {\n          if (error.code !== 'ESRCH') spawnError ??= String(error);\n        }\n      };\n      const timer = setTimeout(() => {\n        timedOut = true;\n        stop('SIGTERM');\n        force = setTimeout(() => stop('SIGKILL'), 2000);\n      }, timeoutMs);\n      child.on('error', error => { spawnError = String(error); });\n      child.on('close', (code, signal) => {\n        clearTimeout(timer);\n        clearTimeout(force);\n        // A command left running in this group could keep mutating the delivered files.\n        stop('SIGKILL');\n        resolve({ code, signal, timedOut, error: spawnError });\n      });\n    });\n  } finally {\n    await Promise.all(handles.map(handle => handle.close()));\n  }\n  return { transcript, stderr, exit, args };\n}\n\nexport function reportedError(transcript) {\n  const last = transcriptEvents(transcript).events.at(-1);\n  if (last?.type === 'turn.failed') return last.error?.message ?? 'Codex reported a failed turn.';\n  if (last?.type === 'result' && last.is_error) {\n    return (Array.isArray(last.errors) ? last.errors.join(' | ') : last.result) || last.subtype || 'Claude reported a failed turn.';\n  }\n  return null;\n}\n\nexport async function observeAgent(agent, transcript, codexHome) {\n  const { events } = transcriptEvents(transcript);\n  const observed = { model: null, effort: null };\n  if (agent === 'claude') {\n    const models = [...new Set(events.filter(event => event.type === 'assistant').map(event => event.message?.model)\n      .filter(model => typeof model === 'string' && model !== '<synthetic>'))];\n    return { ...observed, model: models.at(-1) ?? null, models };\n  }\n\n  const threadId = events[0]?.type === 'thread.started' ? events[0].thread_id : null;\n  if (!threadId || !/^[\\w-]+$/.test(threadId)) return observed;\n  observed.threadId = threadId;\n  try {\n    const entries = await readdir(join(codexHome, 'sessions'), { recursive: true, withFileTypes: true });\n    const rollout = entries.find(entry => entry.isFile() && entry.name.startsWith('rollout-') &&\n      entry.name.endsWith('-' + threadId + '.jsonl'));\n    if (!rollout) return { ...observed, detail: 'No rollout found for this Codex thread.' };\n    const { events: session, malformedLines } = transcriptEvents(await readFile(join(rollout.parentPath, rollout.name), 'utf8'));\n    const contexts = session.filter(event => event.type === 'turn_context').map(event => event.payload);\n    const settings = contexts.map(turn => [turn?.model ?? null, turn?.effort ?? turn?.reasoning_effort ?? turn?.model_reasoning_effort ?? null]);\n    if (malformedLines || new Set(settings.map(setting => JSON.stringify(setting))).size !== 1) {\n      return { ...observed, detail: 'Could not verify consistent turn_context settings in the Codex rollout.' };\n    }\n    [observed.model, observed.effort] = settings.at(-1);\n  } catch (error) {\n    observed.detail = 'Could not read Codex rollout metadata: ' + (error.code ?? error.message);\n  }\n  return observed;\n}\nimport { constants } from 'node:fs';\nimport { access, realpath } from 'node:fs/promises';\nimport { dirname, resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { inside } from './files.mjs';\n\nexport function transcriptEvents(transcript) {\n  const events = [];\n  let malformedLines = 0;\n  for (const line of transcript.split('\\n')) {\n    if (!line.trim()) continue;\n    try {\n      const event = JSON.parse(line);\n      if (event && typeof event.type === 'string') events.push(event);\n      else malformedLines++;\n    } catch {\n      malformedLines++;\n    }\n  }\n  return { events, malformedLines };\n}\n\nfunction * toolInputs(event) {\n  const item = event.item;\n  if (item?.type === 'command_execution') yield { command: item.command, cwd: item.cwd ?? item.workdir };\n  if (item?.type === 'file_change') yield { changes: item.changes };\n  if (item?.type === 'mcp_tool_call') yield item.arguments ?? item.input;\n  if (event.type === 'tool_use') yield event.input;\n  if (event.type === 'assistant' && Array.isArray(event.message?.content)) {\n    for (const part of event.message.content) {\n      if (part?.type === 'tool_use') yield part.input;\n    }\n  }\n}\n\nfunction * unquotedPaths(command) {\n  const paths = /(?<![\\w./:-])(?:file:\\/\\/\\/|~\\/|\\$(?:HOME|\\{HOME\\})\\/|\\.\\.?\\/|\\/)[^\\s\"'\\x60;&|<>()[\\]{}*,]*|(?<!\\S)(?:~|\\$(?:HOME|\\{HOME\\}))(?=$|[\\s;&|])/g;\n  for (const match of command.matchAll(paths)) yield match[0];\n  for (const match of command.matchAll(/(?<![\\w./:-])[\\w.-]+(?:\\/[\\w.-]+)*(?![\\w./:-])/g)) yield match[0];\n}\n\nfunction * commandPaths(command) {\n  if (typeof command !== 'string') return;\n  let offset = 0;\n  // Keep spaces in literal paths, and inspect commands quoted for a shell or Node's -e.\n  for (const match of command.matchAll(/\"([^\"\\n]+)\"|'([^'\\n]+)'/g)) {\n    yield * unquotedPaths(command.slice(offset, match.index));\n    const quoted = match[1] ?? match[2];\n    if (/^(?:file:\\/\\/|[~/]|\\.\\.?\\/)[^;&|<>()[\\]{}\"'\\n]*$/.test(quoted) && !/\\s[-/]/.test(quoted)) {\n      yield quoted;\n    } else {\n      yield * commandPaths(quoted);\n    }\n    offset = match.index + match[0].length;\n  }\n  yield * unquotedPaths(command.slice(offset));\n}\n\nfunction localPath(text, base, home) {\n  if (text.startsWith('file://')) {\n    try { return fileURLToPath(text); } catch { return undefined; }\n  }\n  if (/^[\\w+.-]+:\\/\\//.test(text)) return undefined;\n  return resolve(base, text.replace(/^(?:~|\\$HOME|\\$\\{HOME\\})(?=\\/|$)/, () => home));\n}\n\nasync function resolveLinks(file) {\n  try {\n    return await realpath(file);\n  } catch (error) {\n    if (error.code !== 'ENOENT' && error.code !== 'ENOTDIR') throw error;\n    const parent = dirname(file);\n    return parent === file ? file : resolve(await resolveLinks(parent), file.slice(parent === '/' ? 1 : parent.length + 1));\n  }\n}\n\nasync function systemTool(file) {\n  if (file === '/dev/null') return true;\n  if (!/^\\/(?:usr\\/(?:local\\/)?)?(?:bin|sbin)\\/[^/]+$/.test(file)) return false;\n  try {\n    await access(file, constants.X_OK);\n    return true;\n  } catch {\n    return false;\n  }\n}\n\nconst pathKeys = /^(?:(?:file|target|source|destination|absolute|relative)[_-]?)?(?:path|paths|file|files|uri|uris)$|^(?:dir|directory|cwd|workdir|working_directory)$/i;\nconst commandKeys = /^(?:cmd|command|command_line|argv)$/i;\n\nfunction complete(events, agent) {\n  const last = events.at(-1);\n  if (agent === 'claude') {\n    return last?.type === 'result' && typeof last.is_error === 'boolean' &&\n      events.slice(0, -1).some(event => event.type === 'system' && event.subtype === 'init');\n  }\n  if (events[0]?.type !== 'thread.started' || !events[0].thread_id ||\n      !events.some(event => event.type === 'turn.started') ||\n      !['turn.completed', 'turn.failed'].includes(last?.type)) return false;\n  const openItems = new Set();\n  for (const event of events) {\n    if (event.type === 'item.started') openItems.add(event.item?.id);\n    if (event.type === 'item.completed') openItems.delete(event.item?.id);\n  }\n  return openItems.size === 0;\n}\n\nexport async function auditTranscript(transcript, workspace, agent, home = workspace) {\n  workspace = await realpath(workspace);\n  const paths = new Set();\n  const checked = new Set();\n  const { events, malformedLines } = transcriptEvents(transcript);\n  const completeTranscript = complete(events, agent);\n  const unavailable = events.length === 0 ? 'No transcript events.' : malformedLines\n    ? `${malformedLines} malformed transcript line(s).` : !completeTranscript ? 'Incomplete transcript lifecycle.' : null;\n  const externalTools = new Set();\n  let unparseableInput = false;\n\n  async function check(text, base) {\n    if (!text || text === '-') return;\n    const path = localPath(text, base, home);\n    if (!path || checked.has(path)) return;\n    checked.add(path);\n    if (await systemTool(path)) return;\n    if (!inside(workspace, path)) {\n      paths.add(path);\n      return;\n    }\n    const actual = await resolveLinks(path);\n    if (!inside(workspace, actual) && !await systemTool(actual)) paths.add(actual);\n  }\n\n  async function scan(value, base, key = '') {\n    if (typeof value === 'string') {\n      if (commandKeys.test(key)) {\n        for (const path of commandPaths(value)) await check(path, base);\n      } else if (pathKeys.test(key)) {\n        await check(value, base);\n      } else if (key === 'arguments') {\n        try { value = JSON.parse(value); } catch { unparseableInput = true; return; }\n        await scan(value, base);\n      }\n      return;\n    }\n    if (Array.isArray(value)) {\n      for (const part of value) await scan(part, base, key);\n      return;\n    }\n    if (!value || typeof value !== 'object') return;\n    const cwd = value.cwd ?? value.workdir ?? value.working_directory;\n    if (typeof cwd === 'string') await check(cwd, base);\n    const directory = typeof cwd === 'string' ? localPath(cwd, base, home) ?? base : base;\n    // One recorded external working directory is enough, without treating every shell word as a path there.\n    if (!inside(workspace, directory)) return;\n    for (const [name, part] of Object.entries(value)) {\n      if (part !== cwd || (name !== 'cwd' && name !== 'workdir' && name !== 'working_directory')) {\n        await scan(part, directory, name);\n      }\n    }\n  }\n\n  for (const event of events) {\n    if (['web_search', 'mcp_tool_call'].includes(event.item?.type)) externalTools.add(event.item.type);\n    const content = event.type === 'assistant' ? event.message?.content : undefined;\n    if (content !== undefined && !Array.isArray(content)) unparseableInput = true;\n    const tools = event.type === 'tool_use' ? [event] : Array.isArray(content)\n      ? content.filter(part => part?.type === 'tool_use') : [];\n    for (const tool of tools) {\n      if (!['Read', 'Write', 'Edit', 'Glob', 'Grep', 'Bash'].includes(tool.name)) externalTools.add(tool.name ?? '(unknown)');\n      if (!tool.input || typeof tool.input !== 'object' || Array.isArray(tool.input)) unparseableInput = true;\n    }\n    if (event.item?.type === 'command_execution' && typeof event.item.command !== 'string') unparseableInput = true;\n    for (const input of toolInputs(event)) {\n      if (typeof input === 'string') await scan(input, workspace, 'arguments');\n      else await scan(input, workspace);\n    }\n  }\n  const problems = [\n    unavailable ?? (unparseableInput ? 'Unparseable tool input.' : null),\n    paths.size && 'Recorded paths outside the workspace.',\n    externalTools.size && 'Recorded excluded tool use.',\n  ].filter(Boolean);\n  const status = unavailable || unparseableInput ? 'unverifiable' : problems.length ? 'outside policy' : 'no findings';\n  return { status, paths: [...paths].sort(), tools: [...externalTools].sort(), malformedLines, problems };\n}\nimport { copyFile, cp, lstat, mkdir, mkdtemp, readFile } from 'node:fs/promises';\nimport { homedir, tmpdir } from 'node:os';\nimport { join, relative, resolve } from 'node:path';\nimport { parseArgs } from 'node:util';\nimport { agentArgs, agentVersion, observeAgent, reportedError, runAgent } from './agent.mjs';\nimport { auditTranscript } from './audit.mjs';\nimport { isMain, tasks, writeJson } from './files.mjs';\nimport { grade } from './grade.mjs';\nimport { cells, defaultRecords, effort, inputChanges, inputHashes, models, nextAttempts, observedMatches,\n  protocol, readRecords, target, timeoutMs } from './protocol.mjs';\nimport { prepareWorkspace, removeWorkspace } from './workspace.mjs';\n\nconst inputs = new Set(['docs', 'node_modules', 'data.json', 'PROMPT.md', 'package.json', 'grade.json']);\n\nfunction classify({ agent, exit, audit, observed, result, infrastructure, cliError, changed }) {\n  // A timeout is a counted outcome even when killing the process interrupts the transcript.\n  if (exit?.timedOut) return ['timeout', 'Agent exceeded the 20-minute limit.'];\n  if (infrastructure) return ['infrastructure', infrastructure];\n  if (exit?.error) return ['infrastructure', exit.error];\n  if (audit.status !== 'no findings') return ['void', audit.problems.join(' ')];\n  if (cliError) return ['fail', cliError];\n  if (exit.code !== 0 || exit.signal) return ['fail', `Agent exited with ${exit.signal ?? exit.code}.`];\n  if (!observedMatches(agent, observed)) return ['void', 'Could not verify the requested model and effort.'];\n  if (changed) return ['void', 'Staged inputs changed: ' + changed];\n  const browserError = result.criteria.find(item => item.name === 'browser');\n  if (browserError) return ['infrastructure', browserError.detail];\n  return result.pass ? ['pass', null] : ['fail', result.criteria.filter(item => !item.pass).map(item => item.name).join(', ')];\n}\n\nexport async function attempt(job, { records, workdir, login = join(homedir(), '.codex', 'auth.json'),\n  prepare = prepareWorkspace, version = agentVersion, launch = runAgent, gradeAnswer = grade } = {}) {\n  const { agent, task, slot, replaces } = job;\n  const start = new Date();\n  const record = await mkdtemp(join(records, `${start.toISOString().slice(0, 10)}-${agent}-${task}-${slot}-`));\n  const requested = { model: models[agent], effort };\n  const cli = { version: null, versionArgs: ['--version'], args: null };\n  let prepared, exit, audit, observed, result, infrastructure, cliError, changed;\n  try {\n    prepared = await prepare(workdir, task, { codexLogin: agent === 'codex' ? login : undefined,\n      inputHashes: workspace => inputHashes(workspace, task) });\n    const { workspace, codexHome, home } = prepared;\n    const options = { ...prepared, ...requested, timeoutMs };\n    cli.args = agentArgs(agent, options);\n    cli.version = await version(agent, options);\n    const { transcript, stderr, exit: agentExit } = await launch(agent, options);\n    exit = agentExit;\n    await Promise.all([\n      copyFile(transcript, join(record, 'transcript.jsonl')),\n      copyFile(stderr, join(record, 'stderr.log')),\n      cp(workspace, join(record, 'answer'), {\n        recursive: true,\n        async filter(path) {\n          if (inputs.has(relative(workspace, path).split('/')[0])) return false;\n          const info = await lstat(path);\n          return info.isDirectory() || info.isFile();\n        },\n      }),\n    ]);\n    const log = await readFile(transcript, 'utf8');\n    [audit, observed] = await Promise.all([auditTranscript(log, workspace, agent, home), observeAgent(agent, log, codexHome)]);\n    cliError = reportedError(log);\n    if (cliError && !observed.model &&\n        /authentication failed|not logged in|api key is (?:missing|invalid)|rate.limit|connection refused|overloaded_error/i.test(cliError)) {\n      infrastructure = cliError;\n    }\n    if (!exit.timedOut && !exit.error && !cliError && exit.code === 0 && !exit.signal &&\n        audit.status === 'no findings' && observedMatches(agent, observed)) {\n      changed = await inputChanges(workspace, prepared.hashes);\n      if (!changed) result = await gradeAnswer(workspace, task);\n    }\n  } catch (error) {\n    infrastructure = String(error);\n  }\n  const [status, reason] = classify({ agent, exit, audit, observed, result, infrastructure, cliError, changed });\n  const end = new Date();\n  try {\n    if (result) await writeJson(join(record, 'grade.json'), result);\n    await writeJson(join(record, 'run.json'), {\n      kind: 'agent rehearsal', protocol, agent, task, slot, replaces, status, reason, requested, observed, cli,\n      effectiveEffort: observed?.effort ?? (agent === 'claude' && cli.version ? effort : null),\n      effortEvidence: agent === 'claude' ? '--effort flag; stream does not expose effective effort' : 'turn_context',\n      hashes: prepared?.hashes, browserVersion: result?.browserVersion,\n      startedAt: start.toISOString(), endedAt: end.toISOString(), durationMs: end - start,\n      timeoutMs, exit, audit,\n    });\n  } finally {\n    if (prepared) await removeWorkspace(prepared.runDirectory);\n  }\n  return { status, record, reason };\n}\n\nexport async function runBatch(jobs, workers, run) {\n  let next = 0;\n  const results = [];\n  await Promise.all(Array.from({ length: Math.min(workers, jobs.length) }, async () => {\n    while (next < jobs.length) {\n      const index = next++;\n      results[index] = await run(jobs[index]);\n    }\n  }));\n  return results;\n}\n\nasync function main() {\n  const { values } = parseArgs({ options: {\n    agent: { type: 'string' }, task: { type: 'string' }, workdir: { type: 'string', default: tmpdir() },\n    records: { type: 'string', default: defaultRecords }, attempts: { type: 'string', default: String(target) },\n    parallel: { type: 'string', default: '1' },\n  } });\n  const { agent, task, workdir } = values;\n  const attempts = Number(values.attempts);\n  const parallel = Number(values.parallel);\n  if ((agent && !Object.hasOwn(models, agent)) || (task && !tasks.includes(task)) ||\n      [attempts, parallel].some(n => !Number.isSafeInteger(n) || n < 1)) {\n    throw new Error('Usage: node rehearsal/run.mjs [--agent codex|claude] [--task <id>] [--attempts <n>] [--parallel <n>] [--workdir <dir>] [--records <dir>]');\n  }\n  const records = resolve(values.records);\n  await mkdir(records, { recursive: true });\n  const previous = await readRecords(records);\n  const jobs = cells.filter(cell => (!agent || cell.agent === agent) && (!task || cell.task === task))\n    .flatMap(cell => nextAttempts(previous, cell, attempts));\n  if (!jobs.length) console.log('No open attempt slots in the selected cells.');\n  const results = await runBatch(jobs, parallel, async job => {\n    const result = await attempt(job, { records, workdir });\n    console.log(`${job.agent} / ${job.task} / ${job.slot}: ${result.status}${result.reason ? ' — ' + result.reason : ''}. Record: ${result.record}`);\n    return result;\n  });\n  process.exitCode = results.some(result => result.status === 'infrastructure') ? 2\n    : results.some(result => result.status !== 'pass') ? 1 : 0;\n}\n\nif (isMain(import.meta.url)) {\n  try {\n    await main();\n  } catch (error) {\n    console.error(String(error));\n    process.exitCode = 2;\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'cat rehearsal/test/runner.test.mjs'","aggregated_output":"import { access, chmod, lstat, mkdir, mkdtemp, readFile, readdir, readlink, rm, stat, symlink, writeFile } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { afterEach, beforeEach, expect, it, vi } from 'vitest';\nimport { agentArgs, agentVersion, observeAgent, runAgent } from '../agent.mjs';\nimport { auditTranscript } from '../audit.mjs';\nimport { readJson, repository } from '../files.mjs';\nimport { grade } from '../grade.mjs';\nimport { cells, effort, models, nextAttempts, protocol, summarize, timeoutMs } from '../protocol.mjs';\nimport { attempt, runBatch } from '../run.mjs';\nimport { prepareWorkspace, removeWorkspace } from '../workspace.mjs';\n\nconst jsonl = (...events) => events.map(event => JSON.stringify(event)).join('\\n');\nconst codexStart = { type: 'thread.started', thread_id: 'thread-id' };\nconst codexLog = (...events) => jsonl(codexStart, { type: 'turn.started' }, ...events, { type: 'turn.completed' });\nconst claudeInit = { type: 'system', subtype: 'init' };\nconst claudeLog = (...events) => jsonl(claudeInit, ...events, { type: 'result', is_error: false });\nconst command = (text, cwd) => ({ type: 'item.completed', item: { type: 'command_execution', command: text, cwd } });\nconst claude = (name, input, model = models.claude) => ({\n  type: 'assistant', message: { model, content: [{ type: 'tool_use', name, input }] },\n});\n\nlet scratch;\nconst workspaces = [];\nbeforeEach(async () => { scratch = await mkdtemp(join(tmpdir(), 'axylo-rehearsal-test-')); });\nafterEach(async () => {\n  vi.unstubAllEnvs();\n  for (const directory of workspaces.splice(0)) await removeWorkspace(directory);\n  await rm(scratch, { recursive: true, force: true });\n});\n\nasync function workspaceFor(task, options) {\n  const prepared = await prepareWorkspace(scratch, task, options);\n  workspaces.push(prepared.runDirectory);\n  return prepared;\n}\n\nit('audits complete Codex and Claude logs while allowing the copied docs and system tools', async () => {\n  const codex = codexLog(command(\"/bin/bash -lc 'cat docs/getting-started.html; node ./chart.js'\", scratch),\n    { type: 'item.completed', item: { type: 'agent_message', text: 'I did not read /home/user/notes.txt.' } });\n  expect(await auditTranscript(codex, scratch, 'codex')).toEqual({\n    status: 'no findings', paths: [], tools: [], malformedLines: 0, problems: [],\n  });\n  const log = claudeLog(claude('Read', { file_path: join(scratch, 'data.json') }));\n  expect(await auditTranscript(log, scratch, 'claude')).toMatchObject({ status: 'no findings' });\n});\n\nit('voids recorded reads of Axylo source, even in otherwise complete transcripts', async () => {\n  const source = join(repository, 'packages/axylo/src/index.ts');\n  expect(await auditTranscript(codexLog(command(`/bin/bash -lc 'cat \"${source}\"'`, scratch)), scratch, 'codex'))\n    .toMatchObject({ status: 'outside policy', paths: [source] });\n  expect(await auditTranscript(claudeLog(claude('Read', { file_path: source })), scratch, 'claude'))\n    .toMatchObject({ status: 'outside policy', paths: [source] });\n});\n\nit('follows recorded relative paths and symlinks out of the workspace', async () => {\n  const workspace = join(scratch, 'workspace');\n  const outside = join(scratch, 'other.txt');\n  await mkdir(workspace);\n  await writeFile(outside, '');\n  await symlink(outside, join(workspace, 'linked.txt'));\n  expect(await auditTranscript(codexLog(command('cat linked.txt', workspace)), workspace, 'codex'))\n    .toMatchObject({ status: 'outside policy', paths: [outside] });\n  expect(await auditTranscript(claudeLog(claude('Read', { file_path: '../other.txt' })), workspace, 'claude'))\n    .toMatchObject({ status: 'outside policy', paths: [outside] });\n});\n\nit('preserves literal paths with spaces and ignores paths mentioned in tool output', async () => {\n  const workspace = join(scratch, 'workspace with spaces');\n  await mkdir(workspace);\n  const event = command(`/bin/bash -lc 'cat \"${join(workspace, 'data.json')}\"'`, workspace);\n  event.item.aggregated_output = '/another/path';\n  expect(await auditTranscript(codexLog(event), workspace, 'codex')).toMatchObject({ status: 'no findings' });\n});\n\nit.each([\n  ['codex', '', 0],\n  ['codex', codexLog() + '\\n{', 1],\n  ['codex', jsonl(codexStart, { type: 'turn.started' }), 0],\n  ['codex', codexLog({ type: 'item.started', item: { id: 'incomplete' } }), 0],\n  ['codex', '[]\\n{}\\nnull\\n', 3],\n  ['claude', jsonl(claudeInit, claude('Read', { file_path: 'data.json' })), 0],\n  ['claude', claudeLog({ type: 'assistant', message: { content: 'unexpected' } }), 0],\n])('marks %s transcript %j unverifiable', async (agent, log, malformedLines) => {\n  expect(await auditTranscript(log, scratch, agent)).toMatchObject({ status: 'unverifiable', malformedLines });\n});\n\nit('flags excluded web tools in either transcript', async () => {\n  const codex = codexLog({ type: 'item.completed', item: { type: 'web_search', query: 'Axylo' } });\n  const log = claudeLog(claude('WebFetch', { url: 'https://example.com' }));\n  expect(await auditTranscript(codex, scratch, 'codex')).toMatchObject({ status: 'outside policy', tools: ['web_search'] });\n  expect(await auditTranscript(log, scratch, 'claude')).toMatchObject({ status: 'outside policy', tools: ['WebFetch'] });\n});\n\nit('reads observed metadata from the isolated Codex rollout and the Claude stream', async () => {\n  const sessionDirectory = join(scratch, 'sessions', '2026', '11', '19');\n  await mkdir(sessionDirectory, { recursive: true });\n  await writeFile(join(sessionDirectory, 'rollout-day-thread-id.jsonl'), jsonl(\n    { type: 'turn_context', payload: { model: 'codex-observed', effort: 'high' } },\n  ));\n  expect(await observeAgent('codex', codexLog(), scratch)).toEqual({ model: 'codex-observed', effort: 'high', threadId: 'thread-id' });\n  expect(await observeAgent('codex', codexLog(), join(scratch, 'unused'))).toMatchObject({ model: null, effort: null });\n  const log = claudeLog(claude('Read', { file_path: 'data.json' }, 'claude-observed'));\n  expect(await observeAgent('claude', log)).toEqual({ model: 'claude-observed', effort: null, models: ['claude-observed'] });\n});\n\nit('uses the same effort, restricts tools, and disables workspace reuse and web access where the flags allow', () => {\n  const args = agent => agentArgs(agent, { workspace: scratch, model: models[agent], effort });\n  expect(args('codex')).toEqual(expect.arrayContaining(['-a', 'never', '-s', 'workspace-write',\n    'model_reasoning_effort=\"xhigh\"', 'sandbox_workspace_write.network_access=false', 'web_search=\"disabled\"',\n    '--disable', 'apps', 'memories', '--ignore-user-config', '--skip-git-repo-check', '-C', scratch, '--json']));\n  const flags = args('claude');\n  expect(flags).toEqual(expect.arrayContaining(['--bare', '--restricted', '--strict-mcp-config',\n    '--no-session-persistence', '--effort', 'xhigh', '--permission-mode', 'dontAsk', '--permission-prompts', 'none']));\n  expect(flags[flags.indexOf('--tools') + 1]).toBe('Read,Write,Edit,Glob,Grep,Bash');\n  expect(flags[flags.indexOf('--allowedTools') + 1]).toBe('Read,Write,Edit,Glob,Grep,Bash(node *)');\n});\n\nit('runs a local stub with fresh environment, captures both streams, and stops on timeout', async () => {\n  const bin = join(scratch, 'bin');\n  const { workspace, home, codexHome, ...prepared } = await workspaceFor('signups');\n  const timedRun = join(scratch, 'timed');\n  await Promise.all([mkdir(bin), mkdir(timedRun)]);\n  const executable = join(bin, 'codex');\n  await writeFile(executable, [\n    '#!/bin/sh', 'if [ \"$1\" = \"--version\" ]; then echo fixture-version; exit 0; fi',\n    'IFS= read -r prompt', 'printf \"%s\\\\n\" \"$prompt\" \"$HOME\" \"$CODEX_HOME\" \"${TEST_SECRET-unset}\"',\n    'printf \"%s\" \"stderr\" >&2',\n  ].join('\\n') + '\\n', { mode: 0o700 });\n  vi.stubEnv('PATH', bin);\n  vi.stubEnv('TEST_SECRET', 'parent value');\n  const options = { ...prepared, workspace, home, codexHome, model: models.codex, effort, timeoutMs: 5000 };\n  expect(await agentVersion('codex', options)).toBe('fixture-version');\n  const finished = await runAgent('codex', options);\n  expect(finished.exit).toEqual({ code: 0, signal: null, timedOut: false, error: null });\n  expect((await readFile(finished.transcript, 'utf8')).split('\\n').slice(1)).toEqual([home, codexHome, 'unset', '']);\n  expect(await readFile(finished.stderr, 'utf8')).toBe('stderr');\n\n  await writeFile(executable, '#!/bin/sh\\nexec /bin/sleep 10\\n');\n  const stopped = await runAgent('codex', { ...options, runDirectory: timedRun, timeoutMs: 100 });\n  expect(stopped.exit).toMatchObject({ code: null, signal: 'SIGTERM', timedOut: true, error: null });\n});\n\nit('prepares fresh read-only inputs, a writable answer area and a login symlink only', async () => {\n  await expect(prepareWorkspace(join(repository, 'rehearsal', 'would-create'), 'daily-visits'))\n    .rejects.toThrow('--workdir must be outside the repository.');\n  const login = join(scratch, 'auth.json');\n  await writeFile(login, 'fake login');\n  const first = await workspaceFor('daily-visits', { codexLogin: login });\n  const second = await workspaceFor('daily-visits', { codexLogin: login });\n  expect(first.home).not.toBe(second.home);\n  expect(await readdir(first.codexHome)).toEqual(['auth.json']);\n  const link = join(first.codexHome, 'auth.json');\n  expect((await lstat(link)).isSymbolicLink()).toBe(true);\n  expect(await readlink(link)).toBe(login);\n  expect((await readdir(first.workspace)).sort()).toEqual(['PROMPT.md', 'data.json', 'docs', 'node_modules', 'package.json']);\n  for (const path of ['docs', 'docs/getting-started.html', 'node_modules', 'node_modules/axylo/dist/axylo.js', 'data.json']) {\n    expect((await stat(join(first.workspace, path))).mode & 0o222).toBe(0);\n  }\n  await access(join(first.workspace, 'docs/source/apps/docs/examples/daily-sessions.ts.html'));\n  await expect(access(join(first.workspace, 'docs/source/packages'))).rejects.toHaveProperty('code', 'ENOENT');\n  await writeFile(join(first.workspace, 'chart.js'), '// answer');\n  await removeWorkspace(first.runDirectory);\n  expect(await readFile(login, 'utf8')).toBe('fake login');\n  await expect(access(first.runDirectory)).rejects.toHaveProperty('code', 'ENOENT');\n});\n\nit('records a missing chart without opening Chrome', async () => {\n  const result = await grade(scratch, 'daily-visits', {\n    launch: () => { throw new Error('Chrome should only be opened for a bundle.'); },\n  });\n  expect(result.criteria).toEqual([{ name: 'render', pass: false, detail: 'chart.js is missing.' }]);\n  expect(await readJson(join(scratch, 'grade.json'))).toEqual(result);\n});\n\nit('bundles the packed browser entry and reports a Chrome launch failure', async () => {\n  const { workspace } = await workspaceFor('signups');\n  await writeFile(join(workspace, 'chart.js'), `\n    import { line } from 'axylo';\n    export default function render(element, data) {\n      return line(element, { data, x: 'day', y: { field: 'signpus', label: 'Signups' }, title: 'Daily signups' });\n    }\n  `);\n  const result = await grade(workspace, 'signups', {\n    launch: () => { throw new Error('Chrome unavailable in this test.'); },\n  });\n  expect(result.criteria).toEqual([{ name: 'browser', pass: false, detail: 'Error: Chrome unavailable in this test.' }]);\n});\n\nit.each([\n  ['pass', claudeLog(claude('Write', { file_path: 'chart.js' })), false, { pass: true, criteria: [] }],\n  ['fail', claudeLog(claude('Write', { file_path: 'chart.js' })), false, { pass: false, criteria: [{ name: 'table rows' }] }],\n  ['timeout', jsonl(claudeInit), true],\n  ['void', jsonl(claudeInit), false],\n  ['void', claudeLog(claude('Write', { file_path: 'data.json' })), false, undefined, true],\n  ['infrastructure', claudeLog(claude('Write', { file_path: 'chart.js' })), false, { pass: false, criteria: [{ name: 'browser', detail: 'Chrome unavailable' }] }],\n])('saves a %s attempt before cleaning up the workspace and home', async (status, log, timedOut, gradeResult, tamper) => {\n  const records = join(scratch, 'records');\n  await mkdir(records);\n  let temporary;\n  const result = await attempt({ agent: 'claude', task: 'signups', slot: 1, replaces: null }, {\n    records, workdir: scratch, version: async () => 'fixture-version',\n    launch: async (_, { workspace, runDirectory }) => {\n      temporary = runDirectory;\n      const transcript = join(runDirectory, 'transcript.jsonl');\n      const stderr = join(runDirectory, 'stderr.log');\n      await Promise.all([writeFile(transcript, log), writeFile(stderr, ''), writeFile(join(workspace, 'chart.js'), '// answer')]);\n      if (tamper) {\n        await chmod(join(workspace, 'data.json'), 0o600);\n        await writeFile(join(workspace, 'data.json'), '[]');\n      }\n      return { transcript, stderr, exit: { code: timedOut ? null : 0, timedOut, error: null } };\n    },\n    gradeAnswer: async () => gradeResult,\n  });\n  const run = await readJson(join(result.record, 'run.json'));\n  expect(run).toMatchObject({\n    status, timeoutMs, cli: { version: 'fixture-version', args: expect.arrayContaining(['--effort', effort]) },\n    hashes: { input: expect.stringMatching(/^[a-f0-9]{64}$/), alternate: expect.stringMatching(/^[a-f0-9]{64}$/),\n      docs: expect.stringMatching(/^[a-f0-9]{64}$/), grader: expect.stringMatching(/^[a-f0-9]{64}$/) },\n  });\n  if (status === 'pass') expect(run.reason).toBeNull();\n  else expect(run.reason).toEqual(expect.any(String));\n  if (tamper) expect(run.reason).toBe('Staged inputs changed: input');\n  expect(await readFile(join(result.record, 'answer', 'chart.js'), 'utf8')).toBe('// answer');\n  expect(await readFile(join(result.record, 'transcript.jsonl'), 'utf8')).toBe(log);\n  await expect(access(temporary)).rejects.toHaveProperty('code', 'ENOENT');\n});\n\nit('fills only unused, void and infrastructure slots while keeping failed and timed-out attempts', () => {\n  const [cell] = cells;\n  const records = ['void', 'fail', 'infrastructure', 'timeout'].map((status, i) =>\n    ({ ...cell, protocol, status, name: status, slot: i + 1 }));\n  expect(nextAttempts(records, cell, 5)).toEqual([\n    { ...cell, slot: 1, replaces: 'void' },\n    { ...cell, slot: 3, replaces: 'infrastructure' },\n    { ...cell, slot: 5, replaces: null },\n  ]);\n});\n\nit('limits batch concurrency and preserves job order', async () => {\n  const jobs = [1, 2, 3, 4, 5];\n  let open = 0;\n  let highWater = 0;\n  const results = await runBatch(jobs, 2, async value => {\n    open++;\n    highWater = Math.max(highWater, open);\n    await new Promise(done => setImmediate(done));\n    open--;\n    return value * 2;\n  });\n  expect(results).toEqual([2, 4, 6, 8, 10]);\n  expect(highWater).toBe(2);\n});\n\nit('requires all eight cells to be exactly 3 of 3 on matching inputs, graders and observed models', () => {\n  const records = cells.flatMap(cell => [1, 2, 3].map(slot => ({\n    ...cell, protocol, slot, status: 'pass', timeoutMs, requested: { model: models[cell.agent], effort },\n    observed: { model: models[cell.agent], models: [models[cell.agent]], effort },\n    hashes: { docs: 'docs', grader: 'grader', package: 'package' }, cli: { version: cell.agent }, browserVersion: 'fixture Chrome',\n  })));\n  expect(summarize([]).pass).toBe(false);\n  expect(summarize(records).pass).toBe(true);\n  expect(summarize([...records, { ...records[0], status: 'void' }]).pass).toBe(true);\n  expect(summarize([...records, records[0]]).pass).toBe(false);\n  const timedOut = [{ ...records[0], status: 'timeout' }, ...records.slice(1)];\n  expect(summarize(timedOut).rows[0]).toMatchObject({ pass: 2, attempts: 3, timeout: 1, complete: false });\n  expect(summarize(timedOut).pass).toBe(false);\n  const changed = [{ ...records[0], hashes: { ...records[0].hashes, grader: 'different' } }, ...records.slice(1)];\n  expect(summarize(changed)).toMatchObject({ comparable: false, pass: false });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat rehearsal/README.md rehearsal/workspace.mjs rehearsal/protocol.mjs && rg --files --hidden -g AGENTS.md -g '\"'!node_modules'\"' -g '\"'!.git'\"' .\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat rehearsal/README.md rehearsal/workspace.mjs rehearsal/protocol.mjs && rg --files --hidden -g AGENTS.md -g '\"'!node_modules'\"' -g '\"'!.git'\"' .\"","aggregated_output":"# DX12 agent rehearsal\n\nUse one records directory per release rehearsal. Build the published docs and pack the release candidate before running. The harness reads `apps/docs/dist` and `tests/dist/.packed/axylo-0.0.0.tgz`. Installations of Codex CLI, Claude Code, system Chrome, and the repository development dependencies are required. Codex uses the file login at `~/.codex/auth.json`. Claude's `--bare` mode uses `ANTHROPIC_API_KEY` from the launch environment.\n\n```sh\nnode rehearsal/run.mjs --attempts 3 --parallel 2 --records /tmp/axylo-release-rehearsal\nnode rehearsal/summary.mjs --records /tmp/axylo-release-rehearsal\n```\n\n## Release protocol\n\n- Use the fixed prompts for `daily-visits`, `regional-sales`, `signups`, and `daily-revenue`. Run three fresh, uncoached attempts per task with each of Codex CLI `gpt-6.2-sol` and Claude Code `claude-opus-5-5`. Both request `xhigh` effort and have 20 minutes per attempt. Codex reports the observed model and effort through its rollout. Claude reports the observed model in the stream. Its effort is recorded from the invocation flag because the stream exposes no independent effort field. An observed Claude version suffix is retained and must agree across counted runs for that agent.\n- Give each agent the same prompt bytes, published docs, installed package and primary data. Allow reading inputs, writing the answer and running documented Node self-checks within the time limit. Grade after the CLI exits. Keep grading data, expected results and grader output out of the staged inputs and give the agent no feedback or follow-up.\n- An invocation fills open slots up to `--attempts` per selected cell. The default is three. `--parallel` caps concurrent attempts and defaults to one. Omit `--agent` and `--task` to run all eight cells. Use one runner invocation at a time for a records directory. `--workdir` selects the scratch parent outside the repository and defaults to the system temporary directory. Records default to `rehearsal/records/`.\n- Keep passes, failures and timeouts as counted outcomes. Only voids and infrastructure failures leave slots open. Rerun the same batch to fill those slots after inspecting the saved reason. The new record links to the record it replaces. A timed-out attempt still counts even if killing the process truncates its transcript. Its audit remains unverifiable.\n- The release rehearsal passes when every agent × task cell has three passes in its three counted slots, for 24 passes total. The summary also checks that counted records use matching docs, package, task inputs, grader, tool versions and observed model IDs. Keep the release candidate and CLI installations fixed while collecting a batch. An empty summary displays zero counts for all cells.\n- Report this as “agent rehearsal: these prompts, these models, Chrome; not user evidence”. With independent runs, three successes have a two-sided exact 95% interval of about 29% to 100% per cell. The counts apply to these line and bar tasks in Chrome and do not establish general success rates or human usability.\n\n## Isolation and audit\n\nEach attempt gets a newly created directory outside the repository with a fresh home, temporary storage and workspace. The workspace contains copies of the published docs, the unpacked package, primary data and prompt, and a writable location for `chart.js` and its helpers. The docs retain published examples and exclude internal source snapshots. The runner applies `chmod -R a-w` to `docs/` and `node_modules/` and removes write permission from the fixture, prompt and package manifest. These file modes protect against accidental writes. A sufficiently privileged or same-owner subprocess can still change modes or replace inputs. The runner verifies staged input hashes before grading, and the browser grader supplies canonical data from the harness.\n\n- **Codex CLI 0.170.0.** The runner assigns a fresh `CODEX_HOME` and symlinks only `auth.json` from the real login. It uses `--ignore-user-config` and `--ignore-rules`, disables apps, plugins, memory and hooks, skips host skill discovery, and disables web search. It uses `-s workspace-write`, `-a never`, and `sandbox_workspace_write.network_access=false`. The CLI help describes `--sandbox` as selecting the sandbox for “model-generated shell commands” and says `--ignore-user-config` still uses `CODEX_HOME` for auth. Workspace-write applies write and network restrictions to agent commands. It allows host reads, and Codex's shell can run more than Node. The prompt and audit constrain use of that wider surface.\n- **Claude Code 2.1.327.** The runner sets a fresh `HOME` and `CLAUDE_CONFIG_DIR`, and uses `--bare`, `--restricted`, `--safe-mode`, and `--no-session-persistence`. The help says `--bare` skips auto-memory and `CLAUDE.md` auto-discovery, `--restricted` ignores user, project and local settings and confines file tools to working directories, and `--strict-mcp-config` ignores other MCP configurations. The runner supplies an empty MCP configuration. The help describes `--tools` as the built-ins “to make available” and says permissions that would prompt “are denied automatically” with `--permission-prompts none`. The built-in allowlist exposes file tools and Bash, with `--allowedTools` limiting Bash permission to `node …` and `dontAsk` denying other calls. Web tools and Chrome are absent. Managed settings and managed plugin hooks may still apply. A Node subprocess can have host filesystem and network access through the operating system.\n- Both CLIs need their provider transport. These CLI controls give fresh session state and restrict configured tools. They do not provide a filesystem namespace or a transport-only network policy for Claude's Node subprocess. For strictly enforced docs-only reads and network isolation, use external isolation that enforces those boundaries for both CLIs. Keep host managed policies fixed and record them with the rehearsal if they apply.\n\nThe audit requires a parseable transcript with the CLI's start and terminal events. Empty, malformed, or truncated transcripts are **unverifiable**. Recorded out-of-workspace paths and excluded tool calls are a second check. Detection covers recorded tool inputs, literal command paths, and symlink targets that can be resolved when auditing. It cannot observe a subprocess's actual reads, dynamically constructed paths or fetches from Node code. “No findings” describes the transcript only.\n\nEach record stores `run.json` with the CLI version, arguments, requested and observed model metadata, elapsed time and status, and SHA-256 hashes of both inputs, their expected results, the prompt, copied docs, packed library and grader. It also stores the transcript, stderr, answer files if present, and the grade and Chrome version if the answer reached Chrome. The disposable workspace and home are removed after saving the record. An interrupted batch may leave an incomplete record or scratch directory.\n\n## Reader grading and verification\n\nThe grader uses clean headless Chrome contexts in Los Angeles and Tokyo with English (US) as the page locale. Each answer must handle the original and changed-value input. The alternate signups input has an absent value field that should produce an omission note. Dates are graded as calendar days, including unambiguous month-first and day-first forms. Series labels must match the requested fields. The fixtures declare no measurement unit or currency. The grader opens the standard table control, checks caption, semantic headers and rows, reads the plotted x order and SVG stroke breaks, samples the first calendar date through the plot control, and checks title clipping and omission counts in both the visible note and the accessibility tree.\n\nTo regrade, use a workspace with the same packed package installed and the saved answer files restored into it.\n\n```sh\nnode rehearsal/grade.mjs --task daily-visits --workdir /path/to/prepared/workspace\nnpx --no-install vitest run --root rehearsal --exclude '**/*.browser.test.mjs'\nnpx --no-install vitest run --root rehearsal\n```\n\nThe first Vitest command runs fixture, comparator, audit and local-runner tests without Chrome. The second also runs the browser references and negative controls. The runner exits 0 when all newly scheduled attempts pass or there are no open slots, 1 for any new failed, timed-out or void attempt, and 2 for setup or infrastructure errors. Use the summary to evaluate the whole release rehearsal.\nimport { execFile } from 'node:child_process';\nimport { copyFile, cp, lstat, mkdir, mkdtemp, realpath, rm, stat, symlink, writeFile } from 'node:fs/promises';\nimport { join, relative, resolve } from 'node:path';\nimport { promisify } from 'node:util';\nimport { inside, repository, taskFiles } from './files.mjs';\n\nconst exec = promisify(execFile);\nconst sealedTrees = ['docs', 'node_modules'];\nexport const packedPackage = join(repository, 'tests/dist/.packed/axylo-0.0.0.tgz');\n\nexport async function removeWorkspace(runDirectory) {\n  // Unseal only our copy so an ordinary user can remove its directories.\n  for (const name of sealedTrees) {\n    const path = join(runDirectory, 'workspace', name);\n    const info = await lstat(path).catch(error => {\n      if (error.code !== 'ENOENT') throw error;\n    });\n    if (info?.isDirectory()) await exec('chmod', ['-R', 'u+w', path]);\n  }\n  await rm(runDirectory, { recursive: true, force: true });\n}\n\nexport async function prepareWorkspace(directory, task, { codexLogin, inputHashes } = {}) {\n  const { prompt, fixture, expected } = taskFiles(task);\n  await stat(expected);\n\n  const scratch = resolve(directory);\n  const repo = await realpath(repository);\n  // Check the nearest existing ancestor before creating any directories through a symlink.\n  let ancestor = scratch;\n  while (true) {\n    try {\n      if (inside(repo, await realpath(ancestor))) throw new Error('--workdir must be outside the repository.');\n      break;\n    } catch (error) {\n      if (error.code !== 'ENOENT') throw error;\n      ancestor = resolve(ancestor, '..');\n    }\n  }\n  await mkdir(scratch, { recursive: true });\n  const runDirectory = await mkdtemp(join(await realpath(scratch), 'axylo-rehearsal-'));\n  const workspace = join(runDirectory, 'workspace');\n  const home = join(runDirectory, 'home');\n  const temporary = join(runDirectory, 'tmp');\n  const codexHome = join(home, '.codex');\n  const docs = join(repository, 'apps/docs/dist');\n  const installed = join(workspace, 'node_modules/axylo');\n  try {\n    await mkdir(installed, { recursive: true });\n    await mkdir(temporary);\n    await mkdir(codexHome, { recursive: true });\n    if (codexLogin) {\n      if (!(await stat(codexLogin)).isFile()) throw new Error('Codex login must be a file.');\n      await symlink(codexLogin, join(codexHome, 'auth.json'));\n    }\n    await cp(docs, join(workspace, 'docs'), {\n      recursive: true,\n      async filter(file) {\n        if ((await lstat(file)).isSymbolicLink()) return false;\n        const path = relative(docs, file);\n        // Linked public examples belong to the docs. Evidence links can point to internal source snapshots.\n        return !path.startsWith('source/') || path === 'source/apps' || path === 'source/apps/docs' ||\n          /^source\\/(?:apps\\/docs\\/)?examples(?:\\/|$)/.test(path);\n      },\n    });\n    await exec('tar', ['-xzf', packedPackage, '--strip-components=1', '-C', installed]);\n    await copyFile(fixture, join(workspace, 'data.json'));\n    await copyFile(prompt, join(workspace, 'PROMPT.md'));\n    await writeFile(join(workspace, 'package.json'), '{\"type\":\"module\"}\\n');\n    const hashes = await inputHashes?.(workspace);\n    await exec('chmod', ['-R', 'a-w', ...sealedTrees.map(name => join(workspace, name))]);\n    await exec('chmod', ['a-w', ...['data.json', 'PROMPT.md', 'package.json'].map(name => join(workspace, name))]);\n    return { workspace, runDirectory, home, codexHome, temporary, hashes };\n  } catch (error) {\n    await removeWorkspace(runDirectory);\n    throw error;\n  }\n}\nimport { createHash } from 'node:crypto';\nimport { lstat, readFile, readdir } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport { readJson, rehearsal, repository, taskFiles, tasks } from './files.mjs';\nimport { packedPackage } from './workspace.mjs';\n\nexport const protocol = 1;\nexport const models = { codex: 'gpt-6.2-sol', claude: 'claude-opus-5-5' };\nexport const effort = 'xhigh';\nexport const timeoutMs = 20 * 60 * 1000;\nexport const target = 3;\nexport const defaultRecords = join(rehearsal, 'records');\nexport const cells = Object.keys(models).flatMap(agent => tasks.map(task => ({ agent, task })));\nexport const counted = ['pass', 'fail', 'timeout'];\n\nconst digest = data => createHash('sha256').update(data).digest('hex');\nconst fileHash = async file => digest(await readFile(file));\n\nasync function treeHash(directory) {\n  if (!(await lstat(directory)).isDirectory()) throw new Error('Expected an input directory: ' + directory);\n  const tree = await readdir(directory, { recursive: true, withFileTypes: true });\n  if (tree.some(entry => !entry.isDirectory() && !entry.isFile())) throw new Error('Unexpected entry in input tree: ' + directory);\n  const files = tree.filter(entry => entry.isFile()).map(entry => join(entry.parentPath, entry.name).slice(directory.length + 1)).sort();\n  const entries = await Promise.all(files.map(async file => [file, await fileHash(join(directory, file))]));\n  return digest(JSON.stringify(entries));\n}\n\nconst stagedFiles = { prompt: 'PROMPT.md', input: 'data.json', manifest: 'package.json' };\n\nasync function stagedHashes(workspace) {\n  const files = Object.entries(stagedFiles).map(async ([key, name]) => {\n    const file = join(workspace, name);\n    if (!(await lstat(file)).isFile()) throw new Error('Expected a regular input file: ' + file);\n    return [key, await fileHash(file)];\n  });\n  const entries = await Promise.all([\n    treeHash(join(workspace, 'docs')).then(hash => ['docs', hash]),\n    treeHash(join(workspace, 'node_modules')).then(hash => ['installedPackage', hash]),\n    ...files,\n  ]);\n  return Object.fromEntries(entries);\n}\n\nexport async function inputChanges(workspace, original) {\n  try {\n    const current = await stagedHashes(workspace);\n    return Object.keys(current).filter(key => current[key] !== original[key]).join(', ');\n  } catch (error) {\n    return error.message;\n  }\n}\n\nexport async function inputHashes(workspace, task) {\n  const { alternate, expected, alternateExpected } = taskFiles(task);\n  const sources = {\n    package: fileHash(packedPackage),\n    alternate: fileHash(alternate),\n    expected: fileHash(expected),\n    alternateExpected: fileHash(alternateExpected),\n    grader: Promise.all([\n      ...['grade.mjs', 'reader.mjs', 'table.mjs', 'files.mjs'].map(file => fileHash(join(rehearsal, file))),\n      fileHash(join(repository, 'packages/axylo/src/diagnostics/registry.ts')),\n    ]).then(hashes => digest(JSON.stringify(hashes))),\n  };\n  const [staged, entries] = await Promise.all([\n    stagedHashes(workspace),\n    Promise.all(Object.entries(sources).map(async ([key, hash]) => [key, await hash])),\n  ]);\n  return { ...staged, ...Object.fromEntries(entries) };\n}\n\nexport async function readRecords(root) {\n  const entries = await readdir(root, { withFileTypes: true }).catch(error => {\n    if (error.code === 'ENOENT') return [];\n    throw error;\n  });\n  const records = await Promise.all(entries.filter(entry => entry.isDirectory()).map(async ({ name }) => {\n    try {\n      return { ...await readJson(join(root, name, 'run.json')), name };\n    } catch (error) {\n      return { name, reason: String(error) };\n    }\n  }));\n  return records.sort((a, b) => (a.startedAt ?? '').localeCompare(b.startedAt ?? '') || a.name.localeCompare(b.name));\n}\n\nexport function cellRecords(records, agent, task) {\n  return records.filter(record => record.protocol === protocol && record.agent === agent && record.task === task);\n}\n\nexport function nextAttempts(records, cell, attempts) {\n  const previous = cellRecords(records, cell.agent, cell.task);\n  return Array.from({ length: attempts }, (_, index) => index + 1).flatMap(slot => {\n    const entries = previous.filter(record => record.slot === slot);\n    if (entries.some(record => counted.includes(record.status))) return [];\n    return [{ ...cell, slot, replaces: entries.at(-1)?.name ?? null }];\n  });\n}\n\nexport function observedMatches(agent, observed = {}) {\n  const { model, models: seen, effort: observedEffort } = observed;\n  if (agent === 'codex') return model === models.codex && observedEffort === effort;\n  return seen?.length === 1 && (model === models.claude || /^claude-opus-5-5-\\d{8}$/.test(model));\n}\n\nfunction incompleteOrMixed(records, results) {\n  if (records.some(record => record.protocol !== protocol || !Object.hasOwn(models, record.agent) ||\n      !tasks.includes(record.task) || ![...counted, 'void', 'infrastructure'].includes(record.status))) return true;\n  const distinct = (runs, lookup) => new Set(runs.map(lookup)).size;\n  if (results.some(record => !record.hashes || !record.cli?.version ||\n      record.requested?.model !== models[record.agent] || record.requested?.effort !== effort ||\n      record.timeoutMs !== timeoutMs || (record.status === 'pass' &&\n        (!record.browserVersion || !observedMatches(record.agent, record.observed))))) return true;\n  if (distinct(results, run => JSON.stringify([run.hashes.grader, run.hashes.docs, run.hashes.package, run.hashes.installedPackage])) > 1) return true;\n  if (distinct(results.filter(run => run.browserVersion), run => run.browserVersion) > 1) return true;\n  for (const agent of Object.keys(models)) {\n    const runs = results.filter(run => run.agent === agent);\n    if (distinct(runs, run => run.cli.version) > 1 ||\n        distinct(runs.filter(run => run.observed?.model), run => run.observed.model) > 1) return true;\n  }\n  return tasks.some(task => distinct(results.filter(run => run.task === task), run => JSON.stringify(run.hashes)) > 1);\n}\n\nexport function summarize(records) {\n  const results = records.filter(record => record.protocol === protocol && counted.includes(record.status));\n  const rows = cells.map(({ agent, task }) => {\n    const all = cellRecords(records, agent, task);\n    const attempts = all.filter(record => counted.includes(record.status));\n    const counts = Object.fromEntries([...counted, 'void', 'infrastructure'].map(status =>\n      [status, all.filter(record => record.status === status).length]));\n    return { agent, task, attempts: attempts.length, ...counts,\n      complete: counts.pass === target && attempts.length === target &&\n        [1, 2, 3].every(slot => attempts.some(run => run.slot === slot)) };\n  });\n  const comparable = !incompleteOrMixed(records, results);\n  return { rows, comparable, pass: comparable && rows.every(row => row.complete) };\n}\n./AGENTS.md\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '222,239p' docs/02-product-spec.md && sed -n '344,364p' docs/03-plan-typescript-release.md && claude --version && command -v strace\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '222,239p' docs/02-product-spec.md && sed -n '344,364p' docs/03-plan-typescript-release.md && claude --version && command -v strace\"","aggregated_output":"|---|---|---|---|\n| DX1 | The first chart takes ten lines or fewer, including import, by npm and by script tag. No required option besides data and fields. | Two CI tests that render the documented snippet from the packed distribution | D1 |\n| DX2 | One logical table, three ways to pass it: long rows, wide rows, typed columns. The three forms of each fixture produce the same normalized data and the same diagnostics, with row indexes in the caller's own form. | Equivalence tests | D2 |\n| DX3 | With typed rows, a misspelled field, a text field on a value axis, wide `y` combined with `series`, and an option that does not apply to the chart type all fail to compile. At run time, for untyped rows, the same mistakes raise AX101, AX106 and AX150. | [docs/api/examples.ts](api/examples.ts) compiles and each marked mistake fails (already checked with TypeScript 7.0.2); runtime tests per code | D5 |\n| DX4 | Diagnostics follow the registry in section 3.5: stable code, chart name, field and rows where they apply, the fix, and a documentation page per code. | Message snapshots; link checker | R5, D5 |\n| DX5 | Three methods change a chart: `update` changes options, `append` adds rows, `zoom` sets the view. They apply in call order. Validation and diagnostics are synchronous; drawing is deferred to the next frame; marks, labels, hit testing and the accessibility layer always switch to a new state together. `destroy()` releases everything and cancels pending work. No `resize()` exists. | Sequence tests: replace then append then zoom in one turn; a rejected `strict` update leaves the last valid chart; destroy before the frame; 1,000 create–destroy cycles show no heap growth trend (P7) | D3, R16 |\n| DX6 | Colors, font and spacing are CSS custom properties with documented names; the chart inherits `font-family` and `color`. `colors` pins a color to a series name so the same series has the same color on every chart. There is no theme object and no positional palette option. | Theming tests, including a 24-tile page where series subsets differ | R10 |\n| DX7 | Zero runtime dependencies (reconsidered only with a measured comparison). Size targets for 1.0, set by the owner on 2026-11-18 after measurement: 116 KiB gzipped for everything and 98 KiB for a page that uses only `line`, CSS included. (History: the first targets, 40 and 25 KiB, were written before anything was built; 96 and 80 were set the same day from a first analysis, `reviews/2026-11-18/impl/wp/size.analysis.md`; the correctness passes that followed added about 11 KiB, and a second measured analysis, `reviews/2026-11-18/impl/wp/size2.analysis.md`, showed 96 and 80 can only be met by making streaming an opt-in import, a public API change the owner left for after 1.0. That change, worth about 15 KiB, is the first size item after 1.0.) | size-limit in CI on the packed distribution | D4 |\n| DX8 | Importing in Node without a DOM does not throw, and `validate()` runs there. Creating, destroying and creating again on the same element works and leaks nothing (the sequence a framework's strict or development mode produces). Works under a Content Security Policy without `unsafe-inline` or `unsafe-eval`, served with real headers. Labels and formatter output are inserted as text, never as HTML. A target that matches no element throws an error that names the selector. | CI tests | D1 |\n| DX9 | Semantic versioning. A deprecated API keeps working for at least one minor release and six months. At most one major version a year. The previous release's documented examples still compile and run against each release candidate. | Release policy; API report diff; upgrade test | D6 |\n| DX10 | Every runnable example in the documentation is compiled and rendered in CI from the packed distribution. | Docs build | D1 |\n| DX11 | MIT license for everything, including zoom and accessibility. Third-party notices are verified at release. | Repository; release check | D7 |\n| DX12 | A coding agent gets the first chart right. Given fixed prompts and trap fixtures (UTC-midnight ISO dates, numeric strings, unsorted rows, missing days, a misspelled field), an agent with only the published docs produces a chart with no error diagnostics that passes the reader criteria. Recorded as agent rehearsal, not as user evidence. | Scripted rehearsal at each release | D1, 1.2 |\n\n## 5. Performance budgets\n\nThese numbers are provisional. They are design targets taken from Phase 1's order-of-magnitude measurements, and they become release gates only after the benchmark harness built in M0 has measured a working Axylo slice in M1 and the limits have been recalibrated and frozen (plan, M1 and M6). Each budget names its workload, metric and statistic so that two people measuring the same build get the same verdict.\n\n- F5's assertions on kept samples, including the adversarial same-column cases.\n- A value near row 900,000 of 1,000,000 that the drawing dropped is reachable by keyboard, tooltip and table.\n- Budgets P1–P5 and P7 measured with the Phase 3 method, recalibrated once if M1's provisional values were wrong, then frozen with a written reason for each.\n\nExamples: \"Live metrics\", \"A million points\". Docs: Updating, Large data, Zoom.\n\n### M7. Distribution and documentation (ceiling: 8 days)\n\n- Script-tag builds; documentation site; migration notes from Chart.js and Recharts. (No framework adapter in 1.0.)\n\nOutcomes:\n- The packed tarball installed into two clean fixtures (npm with a bundler, script tag): the first chart works in ten lines or fewer in each (DX1).\n- Node import and `validate()` without a DOM; strict CSP with real headers (DX8).\n- Size measured on the packed distribution for line-only, full and script-tag cases, CSS included (DX7).\n- Every runnable docs example compiled and rendered from the packed distribution (DX10).\n- The agent rehearsal (DX12), recorded as rehearsal.\n\n### M8. Release (ceiling: 10 days)\n\n- Beta under a `next` tag; issues from real use fixed; API frozen through the API report.\n- The Phase 1 comparison regenerated with Axylo beside the ten libraries, with the same harness and the corrections from the review, and published with its limits.\n2.1.327 (Claude Code)\n/usr/bin/strace\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' rehearsal/run.mjs && sed -n '1,110p' rehearsal/README.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,230p' rehearsal/run.mjs && sed -n '1,110p' rehearsal/README.md\"","aggregated_output":"import { copyFile, cp, lstat, mkdir, mkdtemp, readFile } from 'node:fs/promises';\nimport { homedir, tmpdir } from 'node:os';\nimport { join, relative, resolve } from 'node:path';\nimport { parseArgs } from 'node:util';\nimport { agentArgs, agentVersion, observeAgent, reportedError, runAgent } from './agent.mjs';\nimport { auditTranscript } from './audit.mjs';\nimport { isMain, tasks, writeJson } from './files.mjs';\nimport { grade } from './grade.mjs';\nimport { cells, defaultRecords, effort, inputChanges, inputHashes, models, nextAttempts, observedMatches,\n  protocol, readRecords, target, timeoutMs } from './protocol.mjs';\nimport { prepareWorkspace, removeWorkspace } from './workspace.mjs';\n\nconst inputs = new Set(['docs', 'node_modules', 'data.json', 'PROMPT.md', 'package.json', 'grade.json']);\n\nfunction classify({ agent, exit, audit, observed, result, infrastructure, cliError, changed }) {\n  // A timeout is a counted outcome even when killing the process interrupts the transcript.\n  if (exit?.timedOut) return ['timeout', 'Agent exceeded the 20-minute limit.'];\n  if (infrastructure) return ['infrastructure', infrastructure];\n  if (exit?.error) return ['infrastructure', exit.error];\n  if (audit.status !== 'no findings') return ['void', audit.problems.join(' ')];\n  if (cliError) return ['fail', cliError];\n  if (exit.code !== 0 || exit.signal) return ['fail', `Agent exited with ${exit.signal ?? exit.code}.`];\n  if (!observedMatches(agent, observed)) return ['void', 'Could not verify the requested model and effort.'];\n  if (changed) return ['void', 'Staged inputs changed: ' + changed];\n  const browserError = result.criteria.find(item => item.name === 'browser');\n  if (browserError) return ['infrastructure', browserError.detail];\n  return result.pass ? ['pass', null] : ['fail', result.criteria.filter(item => !item.pass).map(item => item.name).join(', ')];\n}\n\nexport async function attempt(job, { records, workdir, login = join(homedir(), '.codex', 'auth.json'),\n  prepare = prepareWorkspace, version = agentVersion, launch = runAgent, gradeAnswer = grade } = {}) {\n  const { agent, task, slot, replaces } = job;\n  const start = new Date();\n  const record = await mkdtemp(join(records, `${start.toISOString().slice(0, 10)}-${agent}-${task}-${slot}-`));\n  const requested = { model: models[agent], effort };\n  const cli = { version: null, versionArgs: ['--version'], args: null };\n  let prepared, exit, audit, observed, result, infrastructure, cliError, changed;\n  try {\n    prepared = await prepare(workdir, task, { codexLogin: agent === 'codex' ? login : undefined,\n      inputHashes: workspace => inputHashes(workspace, task) });\n    const { workspace, codexHome, home } = prepared;\n    const options = { ...prepared, ...requested, timeoutMs };\n    cli.args = agentArgs(agent, options);\n    cli.version = await version(agent, options);\n    const { transcript, stderr, exit: agentExit } = await launch(agent, options);\n    exit = agentExit;\n    await Promise.all([\n      copyFile(transcript, join(record, 'transcript.jsonl')),\n      copyFile(stderr, join(record, 'stderr.log')),\n      cp(workspace, join(record, 'answer'), {\n        recursive: true,\n        async filter(path) {\n          if (inputs.has(relative(workspace, path).split('/')[0])) return false;\n          const info = await lstat(path);\n          return info.isDirectory() || info.isFile();\n        },\n      }),\n    ]);\n    const log = await readFile(transcript, 'utf8');\n    [audit, observed] = await Promise.all([auditTranscript(log, workspace, agent, home), observeAgent(agent, log, codexHome)]);\n    cliError = reportedError(log);\n    if (cliError && !observed.model &&\n        /authentication failed|not logged in|api key is (?:missing|invalid)|rate.limit|connection refused|overloaded_error/i.test(cliError)) {\n      infrastructure = cliError;\n    }\n    if (!exit.timedOut && !exit.error && !cliError && exit.code === 0 && !exit.signal &&\n        audit.status === 'no findings' && observedMatches(agent, observed)) {\n      changed = await inputChanges(workspace, prepared.hashes);\n      if (!changed) result = await gradeAnswer(workspace, task);\n    }\n  } catch (error) {\n    infrastructure = String(error);\n  }\n  const [status, reason] = classify({ agent, exit, audit, observed, result, infrastructure, cliError, changed });\n  const end = new Date();\n  try {\n    if (result) await writeJson(join(record, 'grade.json'), result);\n    await writeJson(join(record, 'run.json'), {\n      kind: 'agent rehearsal', protocol, agent, task, slot, replaces, status, reason, requested, observed, cli,\n      effectiveEffort: observed?.effort ?? (agent === 'claude' && cli.version ? effort : null),\n      effortEvidence: agent === 'claude' ? '--effort flag; stream does not expose effective effort' : 'turn_context',\n      hashes: prepared?.hashes, browserVersion: result?.browserVersion,\n      startedAt: start.toISOString(), endedAt: end.toISOString(), durationMs: end - start,\n      timeoutMs, exit, audit,\n    });\n  } finally {\n    if (prepared) await removeWorkspace(prepared.runDirectory);\n  }\n  return { status, record, reason };\n}\n\nexport async function runBatch(jobs, workers, run) {\n  let next = 0;\n  const results = [];\n  await Promise.all(Array.from({ length: Math.min(workers, jobs.length) }, async () => {\n    while (next < jobs.length) {\n      const index = next++;\n      results[index] = await run(jobs[index]);\n    }\n  }));\n  return results;\n}\n\nasync function main() {\n  const { values } = parseArgs({ options: {\n    agent: { type: 'string' }, task: { type: 'string' }, workdir: { type: 'string', default: tmpdir() },\n    records: { type: 'string', default: defaultRecords }, attempts: { type: 'string', default: String(target) },\n    parallel: { type: 'string', default: '1' },\n  } });\n  const { agent, task, workdir } = values;\n  const attempts = Number(values.attempts);\n  const parallel = Number(values.parallel);\n  if ((agent && !Object.hasOwn(models, agent)) || (task && !tasks.includes(task)) ||\n      [attempts, parallel].some(n => !Number.isSafeInteger(n) || n < 1)) {\n    throw new Error('Usage: node rehearsal/run.mjs [--agent codex|claude] [--task <id>] [--attempts <n>] [--parallel <n>] [--workdir <dir>] [--records <dir>]');\n  }\n  const records = resolve(values.records);\n  await mkdir(records, { recursive: true });\n  const previous = await readRecords(records);\n  const jobs = cells.filter(cell => (!agent || cell.agent === agent) && (!task || cell.task === task))\n    .flatMap(cell => nextAttempts(previous, cell, attempts));\n  if (!jobs.length) console.log('No open attempt slots in the selected cells.');\n  const results = await runBatch(jobs, parallel, async job => {\n    const result = await attempt(job, { records, workdir });\n    console.log(`${job.agent} / ${job.task} / ${job.slot}: ${result.status}${result.reason ? ' — ' + result.reason : ''}. Record: ${result.record}`);\n    return result;\n  });\n  process.exitCode = results.some(result => result.status === 'infrastructure') ? 2\n    : results.some(result => result.status !== 'pass') ? 1 : 0;\n}\n\nif (isMain(import.meta.url)) {\n  try {\n    await main();\n  } catch (error) {\n    console.error(String(error));\n    process.exitCode = 2;\n  }\n}\n# DX12 agent rehearsal\n\nUse one records directory per release rehearsal. Build the published docs and pack the release candidate before running. The harness reads `apps/docs/dist` and `tests/dist/.packed/axylo-0.0.0.tgz`. Installations of Codex CLI, Claude Code, system Chrome, and the repository development dependencies are required. Codex uses the file login at `~/.codex/auth.json`. Claude's `--bare` mode uses `ANTHROPIC_API_KEY` from the launch environment.\n\n```sh\nnode rehearsal/run.mjs --attempts 3 --parallel 2 --records /tmp/axylo-release-rehearsal\nnode rehearsal/summary.mjs --records /tmp/axylo-release-rehearsal\n```\n\n## Release protocol\n\n- Use the fixed prompts for `daily-visits`, `regional-sales`, `signups`, and `daily-revenue`. Run three fresh, uncoached attempts per task with each of Codex CLI `gpt-6.2-sol` and Claude Code `claude-opus-5-5`. Both request `xhigh` effort and have 20 minutes per attempt. Codex reports the observed model and effort through its rollout. Claude reports the observed model in the stream. Its effort is recorded from the invocation flag because the stream exposes no independent effort field. An observed Claude version suffix is retained and must agree across counted runs for that agent.\n- Give each agent the same prompt bytes, published docs, installed package and primary data. Allow reading inputs, writing the answer and running documented Node self-checks within the time limit. Grade after the CLI exits. Keep grading data, expected results and grader output out of the staged inputs and give the agent no feedback or follow-up.\n- An invocation fills open slots up to `--attempts` per selected cell. The default is three. `--parallel` caps concurrent attempts and defaults to one. Omit `--agent` and `--task` to run all eight cells. Use one runner invocation at a time for a records directory. `--workdir` selects the scratch parent outside the repository and defaults to the system temporary directory. Records default to `rehearsal/records/`.\n- Keep passes, failures and timeouts as counted outcomes. Only voids and infrastructure failures leave slots open. Rerun the same batch to fill those slots after inspecting the saved reason. The new record links to the record it replaces. A timed-out attempt still counts even if killing the process truncates its transcript. Its audit remains unverifiable.\n- The release rehearsal passes when every agent × task cell has three passes in its three counted slots, for 24 passes total. The summary also checks that counted records use matching docs, package, task inputs, grader, tool versions and observed model IDs. Keep the release candidate and CLI installations fixed while collecting a batch. An empty summary displays zero counts for all cells.\n- Report this as “agent rehearsal: these prompts, these models, Chrome; not user evidence”. With independent runs, three successes have a two-sided exact 95% interval of about 29% to 100% per cell. The counts apply to these line and bar tasks in Chrome and do not establish general success rates or human usability.\n\n## Isolation and audit\n\nEach attempt gets a newly created directory outside the repository with a fresh home, temporary storage and workspace. The workspace contains copies of the published docs, the unpacked package, primary data and prompt, and a writable location for `chart.js` and its helpers. The docs retain published examples and exclude internal source snapshots. The runner applies `chmod -R a-w` to `docs/` and `node_modules/` and removes write permission from the fixture, prompt and package manifest. These file modes protect against accidental writes. A sufficiently privileged or same-owner subprocess can still change modes or replace inputs. The runner verifies staged input hashes before grading, and the browser grader supplies canonical data from the harness.\n\n- **Codex CLI 0.170.0.** The runner assigns a fresh `CODEX_HOME` and symlinks only `auth.json` from the real login. It uses `--ignore-user-config` and `--ignore-rules`, disables apps, plugins, memory and hooks, skips host skill discovery, and disables web search. It uses `-s workspace-write`, `-a never`, and `sandbox_workspace_write.network_access=false`. The CLI help describes `--sandbox` as selecting the sandbox for “model-generated shell commands” and says `--ignore-user-config` still uses `CODEX_HOME` for auth. Workspace-write applies write and network restrictions to agent commands. It allows host reads, and Codex's shell can run more than Node. The prompt and audit constrain use of that wider surface.\n- **Claude Code 2.1.327.** The runner sets a fresh `HOME` and `CLAUDE_CONFIG_DIR`, and uses `--bare`, `--restricted`, `--safe-mode`, and `--no-session-persistence`. The help says `--bare` skips auto-memory and `CLAUDE.md` auto-discovery, `--restricted` ignores user, project and local settings and confines file tools to working directories, and `--strict-mcp-config` ignores other MCP configurations. The runner supplies an empty MCP configuration. The help describes `--tools` as the built-ins “to make available” and says permissions that would prompt “are denied automatically” with `--permission-prompts none`. The built-in allowlist exposes file tools and Bash, with `--allowedTools` limiting Bash permission to `node …` and `dontAsk` denying other calls. Web tools and Chrome are absent. Managed settings and managed plugin hooks may still apply. A Node subprocess can have host filesystem and network access through the operating system.\n- Both CLIs need their provider transport. These CLI controls give fresh session state and restrict configured tools. They do not provide a filesystem namespace or a transport-only network policy for Claude's Node subprocess. For strictly enforced docs-only reads and network isolation, use external isolation that enforces those boundaries for both CLIs. Keep host managed policies fixed and record them with the rehearsal if they apply.\n\nThe audit requires a parseable transcript with the CLI's start and terminal events. Empty, malformed, or truncated transcripts are **unverifiable**. Recorded out-of-workspace paths and excluded tool calls are a second check. Detection covers recorded tool inputs, literal command paths, and symlink targets that can be resolved when auditing. It cannot observe a subprocess's actual reads, dynamically constructed paths or fetches from Node code. “No findings” describes the transcript only.\n\nEach record stores `run.json` with the CLI version, arguments, requested and observed model metadata, elapsed time and status, and SHA-256 hashes of both inputs, their expected results, the prompt, copied docs, packed library and grader. It also stores the transcript, stderr, answer files if present, and the grade and Chrome version if the answer reached Chrome. The disposable workspace and home are removed after saving the record. An interrupted batch may leave an incomplete record or scratch directory.\n\n## Reader grading and verification\n\nThe grader uses clean headless Chrome contexts in Los Angeles and Tokyo with English (US) as the page locale. Each answer must handle the original and changed-value input. The alternate signups input has an absent value field that should produce an omission note. Dates are graded as calendar days, including unambiguous month-first and day-first forms. Series labels must match the requested fields. The fixtures declare no measurement unit or currency. The grader opens the standard table control, checks caption, semantic headers and rows, reads the plotted x order and SVG stroke breaks, samples the first calendar date through the plot control, and checks title clipping and omission counts in both the visible note and the accessibility tree.\n\nTo regrade, use a workspace with the same packed package installed and the saved answer files restored into it.\n\n```sh\nnode rehearsal/grade.mjs --task daily-visits --workdir /path/to/prepared/workspace\nnpx --no-install vitest run --root rehearsal --exclude '**/*.browser.test.mjs'\nnpx --no-install vitest run --root rehearsal\n```\n\nThe first Vitest command runs fixture, comparator, audit and local-runner tests without Chrome. The second also runs the browser references and negative controls. The runner exits 0 when all newly scheduled attempts pass or there are no open slots, 1 for any new failed, timed-out or void attempt, and 2 for setup or infrastructure errors. Use the summary to evaluate the whole release rehearsal.\n","exit_code":0,"status":"completed"}}
