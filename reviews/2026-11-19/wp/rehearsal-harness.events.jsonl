{"type":"item.started","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"cat > rehearsal/vitest.config.mjs <<'EOF'\nimport { fileURLToPath } from 'node:url';\nimport { defineConfig } from 'vitest/config';\n\nexport default defineConfig({\n  root: fileURLToPath(new URL('.', import.meta.url)),\n  cacheDir: '.vite',\n  test: {\n    include: ['test/**/*.test.mjs'],\n    hookTimeout: 30000,\n    testTimeout: 30000,\n  },\n});\nEOF\ncat > rehearsal/test/fixtures.test.mjs <<'EOF'\nimport { describe, expect, it } from 'vitest';\nimport fc from 'fast-check';\nimport { readJson, taskFiles } from '../files.mjs';\nimport { compareRows } from '../table.mjs';\n\nconst specs = [\n  ['daily-visits', [2026, 3, 1, 30], ['visits'], [6, 12, 26]],\n  ['signups', [2026, 4, 6, 7], ['signpus'], []],\n  ['daily-revenue', [2026, 5, 1, 8], ['revenue'], [4]],\n  ['regional-sales', null, ['north', 'central', 'west'], []],\n];\n\ndescribe('fixture expectations', () => {\n  it.each(specs)('%s follows the calendar or categories and preserves the source values', async (task, period, keys, missing) => {\n    const files = taskFiles(task);\n    const [data, expected] = await Promise.all([readJson(files.fixture), readJson(files.expected)]);\n    if (\"'!period) {\n      expect(data.every(row => keys.every(key => typeof row[key] === '\"'string'))).toBe(true);\n      const rows = data.map(row => [row.quarter, ...keys.map(key => Number(row[key]))]);\n      expect(expected.rows).toEqual(rows);\n      return;\n    }\n\n    const [year, month, start, count] = period;\n    const days = Array.from({ length: count }, (_, index) =>\n      new Date(Date.UTC(year, month - 1, start + index)).toISOString().split('T')[0]);\n    const observations = new Map(data.map(row => [row.day.split('T')[0], row]));\n    expect(observations.size).toBe(data.length);\n    expect(data.length).toBe(days.length - missing.length);\n    expect(days.filter(day => \"'!observations.has(day)).map(day => Number(day.slice(-2)))).toEqual(missing);\n    expect(expected.rows).toEqual(days.map(day => {\n      const row = observations.get(day);\n      return [day, ...keys.map(key => row ? Number(row[key]) : null)];\n    }));\n    if (missing.length) {\n      expect(data.map(row => row.day)).not.toEqual(data.map(row => row.day).sort());\n      expect(data.every(row => row.day.endsWith('\"'T00:00:00Z'))).toBe(true);\n    }\n  });\n\n  it('accepts formatted numbers and omitted gaps, and rejects a zero substituted for any gap', () => {\n    fc.assert(fc.property(fc.array(fc.integer({ min: -1000000, max: 1000000 }), { minLength: 1, maxLength: 12 }), values => {\n      const expected = {\n        x: 'category', series: ['sales'],\n        rows: [['Missing', null], ...values.map((value, i) => [String(i), value])],\n      };\n      const headers = ['Quarter', 'Sales'];\n      const format = new Intl.NumberFormat('en-US');\n      const displayed = values.map((value, i) => [String(i), format.format(value)]);\n      expect(compareRows(expected, headers, displayed).pass).toBe(true);\n      expect(compareRows(expected, headers, [['Missing', 'No data'], ...displayed]).pass).toBe(true);\n      expect(compareRows(expected, headers, [['Missing', '0'], ...displayed]).pass).toBe(false);\n    }));\n  });\n\n  it('compares the printed day without moving an instant back to UTC', () => {\n    const expected = { x: 'date', series: ['sales'], rows: [['2026-03-01', 1250.5]] };\n    const headers = ['Day', 'Sales'];\n    expect(compareRows(expected, headers, [['Mar 1, 2026, 9:00 AM GMT+9', '1,250.50']]).pass).toBe(true);\n    expect(compareRows(expected, headers, [['Feb 28, 2026, 4:00 PM PST', '1,250.5']])).toEqual({\n      pass: false, detail: 'Row 1 expected [\\\"2026-03-01\\\",1250.5], saw [\\\"Feb 28, 2026, 4:00 PM PST\\\",\\\"1,250.5\\\"].',\n    });\n  });\n});\nEOF\ncat > rehearsal/test/runner.test.mjs <<'EOF'\nimport { access, mkdir, mkdtemp, readFile, readdir, rm, symlink, writeFile } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { afterEach, beforeEach, expect, it } from 'vitest';\nimport { agentArgs, observeAgent } from '../agent.mjs';\nimport { auditTranscript } from '../audit.mjs';\nimport { repository } from '../files.mjs';\nimport { grade } from '../grade.mjs';\nimport { prepareWorkspace } from '../workspace.mjs';\n\nconst jsonl = (...events) => events.map(event => JSON.stringify(event)).join('\\\\n');\nconst command = (text, cwd) => ({ type: 'item.completed', item: { type: 'command_execution', command: text, cwd } });\nconst claude = (name, input, model) => ({\n  type: 'assistant', message: { model, content: [{ type: 'tool_use', name, input }] },\n});\n\nlet scratch;\nbeforeEach(async () => { scratch = await mkdtemp(join(tmpdir(), 'axylo-rehearsal-test-')); });\nafterEach(() => rm(scratch, { recursive: true, force: true }));\n\nit('audits actual Codex commands and Claude tool calls while allowing the published docs and system tools', async () => {\n  const transcript = jsonl(\n    { type: 'thread.started', thread_id: 'rehearsal-test' },\n    command('/bin/bash -lc \\\\'cat docs/getting-started.html; node ./chart.js\\\\'', scratch),\n    claude('Read', { file_path: join(scratch, 'data.json') }, 'claude-test-model'),\n    { type: 'item.completed', item: { type: 'agent_message', text: 'I did not read /home/user/notes.txt.' } },\n  );\n  expect(await auditTranscript(transcript, scratch)).toEqual({ void: false, paths: [], malformedLines: 0 });\n});\n\nit('voids a transcript that reads Axylo source', async () => {\n  const source = '/home/canarit/projects/axylo/packages/axylo/src/index.ts';\n  const transcript = jsonl(\n    command(\"'`/bin/bash -lc '\"'cat \\\"\"'${source}\"'\"'\"'`, scratch),\n    claude('\"'Read', { file_path: source }, 'claude-test-model'),\n  );\n  expect(await auditTranscript(transcript, scratch)).toEqual({ void: true, paths: [source], malformedLines: 0 });\n});\n\nit('follows recorded relative paths and symlinks out of the workspace', async () => {\n  const workspace = join(scratch, 'workspace');\n  const outside = join(scratch, 'other.txt');\n  await mkdir(workspace);\n  await writeFile(outside, '');\n  await symlink(outside, join(workspace, 'linked.txt'));\n  const transcript = jsonl(command('cat linked.txt', workspace), claude('Read', { file_path: '../other.txt' }));\n  expect(await auditTranscript(transcript, workspace)).toEqual({ void: true, paths: [outside], malformedLines: 0 });\n});\n\nit('reads observed metadata without substituting requested values', async () => {\n  const sessionDirectory = join(scratch, '2026', '11', '19');\n  const events = jsonl({ type: 'thread.started', thread_id: 'thread-id' });\n  await mkdir(sessionDirectory, { recursive: true });\n  await writeFile(join(sessionDirectory, 'rollout-day-thread-id.jsonl'), jsonl(\n    { type: 'turn_context', payload: { model: 'codex-observed', effort: 'high' } },\n  ));\n  expect(await observeAgent('codex', events, scratch)).toEqual({ model: 'codex-observed', effort: 'high', threadId: 'thread-id' });\n  expect(await observeAgent('claude', jsonl(claude('Read', { file_path: 'data.json' }, 'claude-observed'))))\n    .toEqual({ model: 'claude-observed', effort: null });\n});\n\nit('passes the non-interactive flags without shell interpolation', () => {\n  expect(agentArgs('codex', { workspace: scratch, model: 'requested-codex', effort: 'high' })).toEqual([\n    'exec', '-m', 'requested-codex', '-c', 'model_reasoning_effort=\\\"high\\\"', '-s', 'workspace-write',\n    '--skip-git-repo-check', '-C', scratch, '--json', '-',\n  ]);\n  expect(agentArgs('claude', { workspace: scratch, model: 'requested-claude' })).toEqual([\n    '-p', '--model', 'requested-claude', '--output-format', 'stream-json', '--verbose', '--allowedTools',\n    'Read,Write,Edit,Glob,Grep,Bash(node:*),Bash(ls:*),Bash(cat:*)',\n  ]);\n});\n\nit('prepares a clean workspace from the packed package and the published docs', async () => {\n  await expect(prepareWorkspace(join(repository, 'rehearsal', 'would-create'), 'daily-visits'))\n    .rejects.toThrow('--workdir must be outside the repository.');\n  const { workspace } = await prepareWorkspace(scratch, 'daily-visits');\n  expect((await readdir(workspace)).sort()).toEqual(['PROMPT.md', 'data.json', 'docs', 'node_modules', 'package.json']);\n  expect(JSON.parse(await readFile(join(workspace, 'package.json'), 'utf8'))).toEqual({ type: 'module' });\n  await access(join(workspace, 'node_modules/axylo/dist/axylo.js'));\n  await access(join(workspace, 'docs/getting-started.html'));\n  await access(join(workspace, 'docs/source/apps/docs/examples/daily-sessions.ts.html'));\n  await expect(access(join(workspace, 'docs/source/packages'))).rejects.toHaveProperty('code', 'ENOENT');\n});\n\nit('records a missing chart without opening Chrome', async () => {\n  const result = await grade(scratch, 'daily-visits', {\n    launch: () => { throw new Error('Chrome should only be opened for a bundle.'); },\n  });\n  expect(result.criteria).toEqual([{ name: 'render', pass: false, detail: 'chart.js is missing.' }]);\n  expect(JSON.parse(await readFile(join(scratch, 'grade.json'), 'utf8'))).toEqual(result);\n});\nEOF\ncat > rehearsal/test/grade.browser.test.mjs <<'EOF'\nimport { mkdtemp, rm, writeFile } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport { chromium } from 'playwright-core';\nimport { afterAll, beforeAll, expect, it } from 'vitest';\nimport { grade } from '../grade.mjs';\nimport { prepareWorkspace } from '../workspace.mjs';\n\nconst visits = \"'`import { line } from '\"'axylo';\nexport default function render(element, data) {\n  return line(element, { data, x: { field: 'day', type: 'date' }, y: 'visits', title: 'Daily visits' });\n}\"'`;\n\nconst sales = `import { bar } from '\"'axylo';\nexport default function render(element, data) {\n  return bar(element, {\n    data, x: 'quarter', y: [\n      { field: 'north', parse: 'number' },\n      { field: 'central', parse: 'number' },\n      { field: 'west', parse: 'number' },\n    ], title: 'Quarterly sales by region',\n  });\n}\"'`;\n\nconst signups = `import { line } from '\"'axylo';\nexport default function render(element, data) {\n  return line(element, { data, x: 'day', y: 'signpus', title: 'Daily signups' });\n}\"'`;\n\nconst revenue = `import { line } from '\"'axylo';\nexport default function render(element, data) {\n  const rows = data.map(row => ({ ...row, revenue: Number(row.revenue) }));\n  return line(element, { data: rows, x: { field: 'day', type: 'date' }, y: 'revenue', title: 'Daily store revenue' });\n}\"'`;\n\nconst LA = '\"'America/Los_Angeles';\nconst Tokyo = 'Asia/Tokyo';\nlet scratch;\nlet browser;\nbeforeAll(async () => {\n  scratch = await mkdtemp(join(tmpdir(), 'axylo-rehearsal-browser-'));\n  browser = await chromium.launch({ channel: 'chrome', headless: true, timeout: 15000 });\n});\nafterAll(async () => {\n  await browser?.close();\n  if (scratch) await rm(scratch, { recursive: true, force: true });\n});\n\nasync function answer(task, source) {\n  const { workspace } = await prepareWorkspace(scratch, task);\n  await writeFile(join(workspace, 'chart.js'), source);\n  // The tests reuse a Chrome process, while each grade still creates two clean contexts.\n  return grade(workspace, task, { launch: async () => ({ newContext: options => browser.newContext(options), close: async () => {} }) });\n}\n\nfunction criterion(result, name) {\n  return result.criteria.find(item => item.name === name);\n}\n\nit.each([\n  ['daily-visits', visits],\n  ['regional-sales', sales],\n  ['signups', signups],\n  ['daily-revenue', revenue],\n])('passes a hand-written %s answer in both time zones', async (task, source) => {\n  const result = await answer(task, source);\n  expect(result.criteria.filter(item => \"'!item.pass)).toEqual([]);\n  expect(result.pass).toBe(true);\n  expect(result.timezones.map(zone => zone.timezoneId)).toEqual([LA, Tokyo]);\n});\n\nit('\"'fails the calendar-day check in Los Angeles when midnight is treated as an instant', async () => {\n  const result = await answer('daily-visits', visits.replace(\\\"{ field: 'day', type: 'date' }\\\", \\\"'day'\\\"));\n  expect(result.pass).toBe(false);\n  expect(criterion(result.timezones[0], 'table rows')).toMatchObject({ pass: false, detail: expect.stringContaining('Feb 28, 2026') });\n  expect(criterion(result.timezones[1], 'table rows').pass).toBe(true);\n  expect(criterion(result, 'no error diagnostics').pass).toBe(true);\n  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX111', level: 'hint', sources: ['handle'] }));\n});\n\nit('accepts the documented automatic conversion of an all-decimal-string field', async () => {\n  const result = await answer('regional-sales', sales.replaceAll(\\\", parse: 'number'\\\", ''));\n  expect(result.criteria.filter(item => \"'!item.pass)).toEqual([]);\n  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: '\"'AX104', level: 'hint', sources: ['handle'] }));\n});\n\nit('fails the rows and reader note when mixed numeric strings are left unparsed', async () => {\n  const result = await answer('daily-revenue', revenue.replace('data: rows', 'data'));\n  expect(criterion(result, 'table rows').pass).toBe(false);\n  expect(criterion(result, 'reader note').pass).toBe(false);\n  expect(criterion(result, 'no error diagnostics').pass).toBe(true);\n  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX106', level: 'warning' }));\n});\n\nit('fails the rows when absent days are filled with zero', async () => {\n  const result = await answer('daily-visits', visits.replace(\\\"y: 'visits'\\\", \\\"y: { field: 'visits', missing: 'zero' }\\\"));\n  expect(criterion(result, 'table rows')).toMatchObject({ pass: false, detail: expect.stringContaining('2026-03-06') });\n  expect(criterion(result, 'no error diagnostics').pass).toBe(true);\n});\n\nit('fails the diagnostics check when the missing field raises AX101', async () => {\n  const result = await answer('signups', signups.replace(\\\"y: 'signpus'\\\", \\\"y: 'signups'\\\"));\n  expect(criterion(result, 'no error diagnostics')).toMatchObject({ pass: false, detail: expect.stringContaining('AX101') });\n  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX101', level: 'error', sources: ['console', 'handle'] }));\n});\n\nit('fails the accessible name when Axylo uses a fallback', async () => {\n  const result = await answer('signups', signups.replace(\\\", title: 'Daily signups'\\\", ''));\n  expect(result.criteria.filter(item => \"'!item.pass).map(item => item.name)).toEqual(['\"'accessible name']);\n  expect(result.diagnostics).toContainEqual(expect.objectContaining({ code: 'AX140', level: 'warning' }));\n});\n\nit('fails the chart type when a bar is used for the signups line', async () => {\n  const result = await answer('signups', signups.replaceAll(/\\\\bline\\\\b/g, 'bar'));\n  expect(result.criteria.filter(item => \"'!item.pass).map(item => item.name)).toEqual(['\"'chart type']);\n});\n\nit.each([\n  ['export function render() {}', 'must default-export'],\n  ['export default function render() { throw new Error(\\\"render failed\\\"); }', 'render failed'],\n  ['export default function render() {}', 'must return the Axylo chart handle'],\n])('fails an invalid delivery (%s)', async (source, reason) => {\n  const result = await answer('daily-visits', source);\n  expect(criterion(result, 'render')).toMatchObject({ pass: false, detail: expect.stringContaining(reason) });\n});\nEOF\nnode node_modules/vitest/vitest.mjs run --root rehearsal --config rehearsal/vitest.config.mjs --exclude '**/*.browser.test.mjs'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
