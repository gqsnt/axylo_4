rea, DX10/bar, DX10/scatter, DX10/donut, DX10/compact · [apps/docs/test/node.browser.test.ts](../apps/docs/test/node.browser.test.ts)\n- P7/line · [packages/axylo/test/data/streaming-storage.test.ts](../packages/axylo/test/data/streaming-storage.test.ts)\n\n{\n \"date\": \"2026-11-19T07:53:52.614Z\",\n \"method\": \"esbuild consumer bundles from tests/dist/fixtures (packed tarballs), minify, production condition; gzip level 9\",\n \"packed\": {\n  \"at\": \"2026-11-19T07:53:51.514Z\",\n  \"axylo\": \"sha512-H9mJWNoPledcdbM4W0w+2MTOlKZyutNq4J+KLr+StDZZRZWjdzrx8mWTX4fg3AFTUwopasNiuMdWGUSbPYXTOg==\",\n  \"commit\": \"91d12bf4ca57b8dd2343ca1c6bea123a0ec3a4ad\",\n  \"dirty\": true\n },\n \"cssFileBytes\": 14695,\n \"cssFileGzipBytes\": 3042,\n \"rows\": [\n  {\n   \"entry\": \"line only (examples/first-chart/npm.ts)\",\n   \"minBytes\": 281514,\n   \"jsGzipBytes\": 98627,\n   \"cssFileGzipBytes\": 0,\n   \"totalGzipBytes\": 98627,\n   \"totalKiB\": 96.32,\n   \"targetKiB\": 98,\n   \"targetBytes\": 100352,\n   \"over\": false\n  },\n  {\n   \"entry\": \"everything (export * from axylo)\",\n   \"minBytes\": 335598,\n   \"jsGzipBytes\": 118252,\n   \"cssFileGzipBytes\": 0,\n   \"totalGzipBytes\": 118252,\n   \"totalKiB\": 115.48,\n   \"targetKiB\": 116,\n   \"targetBytes\": 118784,\n   \"over\": false\n  },\n  {\n   \"entry\": \"area only (export { area } from axylo)\",\n   \"minBytes\": 287011,\n   \"jsGzipBytes\": 100634,\n   \"cssFileGzipBytes\": 0,\n   \"totalGzipBytes\": 100634,\n   \"totalKiB\": 98.28,\n   \"targetKiB\": null,\n   \"targetBytes\": null,\n   \"over\": false\n  },\n  {\n   \"entry\": \"bar only (export { bar } from axylo)\",\n   \"minBytes\": 282539,\n   \"jsGzipBytes\": 99061,\n   \"cssFileGzipBytes\": 0,\n   \"totalGzipBytes\": 99061,\n   \"totalKiB\": 96.74,\n   \"targetKiB\": null,\n   \"targetBytes\": null,\n   \"over\": false\n  },\n  {\n   \"entry\": \"scatter only (export { scatter } from axylo)\",\n   \"minBytes\": 268180,\n   \"jsGzipBytes\":