percent: string): string {\n  return fill(donutSlice, { label, value, percent });\n}\n\nexport function pointOf(lookup: Lookup, ref: DatumRef, formatters: Formatters, messages: Messages): string | null {\n  const ordinal = lookup.ordinal(ref);\n  if (ordinal < 0) return null;\n  const datum = lookup.datum(ref);\n  if (!datum) return null;\n  return fill(messages.pointOf, {\n    series: datum.seriesLabel, x: datum.x, value: datum.value,\n    index: formatters.count(ordinal + 1), count: formatters.count(lookup.count),\n  });\n}\n     1\timport { SLOT_VALUE, type DiagnosticSink, type Formatters, type IndexRange, type ReaderModel, type View } from '../core/contracts';\n     2\timport { report } from '../diagnostics';\n     3\timport { incomplete, sliceText } from '../lookup/text';\n     4\timport { defaultMessages, fill, fillChartSummary, fillDonutSlice } from '../messages';\n     5\timport type { Messages, Title } from '../public';\n     6\timport { buildTable, type ReaderLabels } from './table';\n     7\t\n     8\texport interface ReaderInput {\n     9\t  readonly view: View;\n    10\t  readonly formatters: Formatters;\n    11\t  readonly messages: Messages;\n    12\t  /** Retained for callers that previously supplied the chart type label. */\n    13\t  readonly type: string;\n    14\t  readonly title?: string | Title;\n    15\t  readonly labelledBy?: string;\n    16\t  /** Visible text of the external heading when the chart uses labelledBy. */\n    17\t  readonly caption?: string;\n    18\t  readonly subtitle?: string;\n    19\t  readonly description?: string;\n    20\t  readonly disclosure?: { readonly omitted: number; readonly changed: number };\n    21\t  readonly labelsHidden?: number;\n    22\t  readonly table?: boolean;\n    23\t  readonly compact?: boolean;\n    24\t  readonly locale?: string;\n    25\t  readonly labels?: Partial<ReaderLabels>;\n    26\t  readonly diagnostics?: DiagnosticSink;\n    27\t}\n    28\t\n    29\tconst TYPE_MESSAGE = {\n    30\t  line: 'typeLine', area: 'typeArea', bar: 'typeBar', scatter: 'typeScatter', donut: 'typeDonut',\n    31\t} as const;\n    32\tconst MAX_STACK_POSITIONS = 3;\n    33\t\n    34\tfunction statistics(y: Float64Array | Float32Array, { start, end }: IndexRange, slot?: Uint8Array) {\n    35\t  let min = Infinity;\n    36\t  let max = -Infinity;\n    37\t  let last = NaN;\n    38\t  for (let i = start; i < end; i++) {\n    39\t    if (slot && slot[i] !== SLOT_VALUE) continue;\n    40\t    const value = y[i]!;\n    41\t    if (!Number.isFinite(value)) continue;\n    42\t    last = value;\n    43\t    if (last < min) min = last;\n    44\t    if (last > max) max = last;\n    45\t  }\n    46\t  return { min, max, last };\n    47\t}\n    48\t\n    49\tfunction chartText(input: ReaderInput, type: string, xLabel: string, yLabel: string, tableSuffix: string): string[] {\n    50\t  const { view, formatters, messages } = input;\n    51\t  if (view.kind === 'donut') {\n    52\t    const drawn = view.slices.filter(slice => slice.angles && slice.angles[1] > slice.angles[0]);\n    53\t    if (!drawn.length) return [messages.empty];\n    54\t    return [\n    55\t      fill(messages.donutSummary, { type, count: formatters.count(drawn.length), total: formatters.value(0, view.total) }),\n    56\t      ...drawn.map(slice => {\n    57\t        const { label, value, percent } = sliceText(view, slice, formatters);\n    58\t        return fillDonutSlice(label, value, percent ?? '');\n    59\t      }),\n    60\t    ];\n    61\t  }\n    62\t\n    63\t  let xMin = Infinity;\n    64\t  let xMax = -Infinity;\n    65\t  let min = Infinity;\n    66\t  let max = -Infinity;\n    67\t  let minSeries = 0;\n    68\t  let maxSeries = 0;\n    69\t  let seriesCount = 0;\n    70\t  const entries: string[] = [];\n    71\t  const undrawn: string[] = [];\n    72\t  const { frame } = view;\n    73\t  const zone = view.kind === 'scatter'\n    74\t    ? view.frame.xKind === 'time' && view.frame.timeZone\n    75\t    : view.frame.x.kind === 'time' && view.frame.x.timeZone;\n    76\t\n    77\t  if (view.kind !== 'scatter') {\n    78\t    const { start, end } = view.visibleSlots;\n    79\t    if (start < end) {\n    80\t      xMin = view.frame.x.values[start]!;\n    81\t      xMax = view.frame.x.values[end - 1]!;\n    82\t    }\n    83\t  }\n    84\t  frame.series.forEach((series, s) => {\n    85\t    if (!series.drawable) {\n    86\t      undrawn.push(fill(messages.seriesNotDrawn, { series: series.label }) + tableSuffix);\n    87\t      return;\n    88\t    }\n    89\t    if (!view.visible[s]) return;\n    90\t    const range = view.kind === 'scatter' ? view.visiblePoints[s]! : view.visibleSlots;\n    91\t    if (range.start < range.end && 'x' in series) {\n    92\t      xMin = Math.min(xMin, series.x[range.start]!);\n    93\t      xMax = Math.max(xMax, series.x[range.end - 1]!);\n    94\t    }\n    95\t    const stats = statistics(series.y, range, 'slot' in series ? series.slot : undefined);\n    96\t    if (stats.min < min) { min = stats.min; minSeries = s; }\n    97\t    if (stats.max > max) { max = stats.max; maxSeries = s; }\n    98\t    seriesCount++;\n    99\t    entries.push(Number.isFinite(stats.last) ? fill(messages.seriesSummary, {\n   100\t      series: series.label, min: formatters.value(s, stats.min),\n   101\t      max: formatters.value(s, stats.max), last: formatters.value(s, stats.last),\n   102\t    }) : fill(messages.seriesNoData, { series: series.label }));\n   103\t  });\n   104\t\n   105\t  const zoneText = zone ? [fill(messages.timeZoneNote, { zone })] : [];\n   106\t  if (!seriesCount || !Number.isFinite(xMin) || !Number.isFinite(xMax)) return [...undrawn, messages.empty, ...zoneText];\n   107\t  const range = Number.isFinite(min) && Number.isFinite(max)\n   108\t    ? { yMin: formatters.value(minSeries, min), yMax: formatters.value(maxSeries, max) } : null;\n   109\t  return [\n   110\t    fillChartSummary(messages.chartSummary, {\n   111\t      type, seriesCount: formatters.count(seriesCount), xLabel, xMin: formatters.x(xMin), xMax: formatters.x(xMax), yLabel,\n   112\t    }, range),\n   113\t    ...zoneText, ...entries, ...undrawn,\n   114\t  ];\n   115\t}\n   116\t\n   117\tfunction stackText(view: View, formatters: Formatters, messages: Messages): string {\n   118\t  if (view.kind === 'donut' || view.kind === 'scatter') return '';\n   119\t  const flags = view.stack?.incomplete;\n   120\t  if (!flags) return '';\n   121\t  const positions: number[] = [];\n   122\t  let count = 0;\n   123\t  for (let i = view.visibleSlots.start; i < view.visibleSlots.end; i++) {\n   124\t    if (!flags[i]) continue;\n   125\t    if (count < MAX_STACK_POSITIONS) positions.push(view.frame.x.values[i]!);\n   126\t    count++;\n   127\t  }\n   128\t  if (!count) return '';\n   129\t  const details = count > MAX_STACK_POSITIONS\n   130\t    ? `${messages.total} ${formatters.count(count)}` : positions.map(position => formatters.x(position)).join(', ');\n   131\t  return `${incomplete(view.frame.xLabel, messages)}: ${details}.`;\n   132\t}\n   133\t\n   134\tfunction referenceText(view: View, formatters: Formatters, messages: Messages): string[] {\n   135\t  if (view.kind === 'donut') return [];\n   136\t  return view.references.map(({ axis, from, to, label }) => {\n   137\t    const write = axis === 'x' ? (x: number) => formatters.x(x) : (y: number) => formatters.value(0, y);\n   138\t    const values = { label, axis, from: write(from) };\n   139\t    return from === to ? fill(messages.referenceLine, values) : fill(messages.referenceBand, { ...values, to: write(to) });\n   140\t  });\n   141\t}\n   142\t\n   143\texport function buildReader(input: ReaderInput): ReaderModel {\n   144\t  const { view, title, labelledBy, subtitle, description, formatters, messages, disclosure } = input;\n   145\t  const labels = {\n   146\t    category: input.labels?.category ?? messages.category,\n   147\t    percentage: input.labels?.percentage ?? messages.percentage,\n   148\t    series: input.labels?.series ?? messages.series,\n   149\t    value: input.labels?.value ?? messages.value,\n   150\t    xUnit: input.labels?.xUnit,\n   151\t  };\n   152\t  const type = messages[TYPE_MESSAGE[view.kind]];\n   153\t  const xLabel = view.kind === 'donut' ? labels.category : view.frame.xLabel;\n   154\t  const yLabel = view.kind === 'donut' ? view.frame.valueLabel\n   155\t    : view.kind === 'scatter' ? view.frame.yLabel : view.frame.yLabel || view.frame.series[0]?.field || labels.value;\n   156\t  const titleText = typeof title === 'string' ? title : title?.text;\n   157\t  if (!labelledBy && !titleText && input.diagnostics) report(input.diagnostics, 'AX140', 'none');\n   158\t  const generated = fill(messages.chartName, { type, x: xLabel, y: yLabel });\n   159\t  const name = labelledBy ? '' : titleText || generated;\n   160\t  const compact = input.compact === true || (view.kind !== 'donut' && view.compact);\n   161\t  let references: string[] | undefined;\n   162\t  const referencesForView = () => references ??= referenceText(view, formatters, messages);\n   163\t  const caption = [input.caption, name, generated, messages.plotLabel].find(text => text?.trim()) ?? defaultMessages.plotLabel;\n   164\t  const table = input.table === false || compact ? null : buildTable(\n   165\t    view, [caption, ...referencesForView()].join(' '), formatters, messages, labels, input.locale,\n   166\t  );\n   167\t  const tableSuffix = table && messages.seeTable ? ` ${messages.seeTable}` : '';\n   168\t  const omitted = disclosure?.omitted ?? 0;\n   169\t  const changed = disclosure?.changed ?? 0;\n   170\t  const statements: string[] = [];\n   171\t  if (omitted > 0 || changed > 0) {\n   172\t    const counts = { omitted: formatters.count(omitted), changed: formatters.count(changed) };\n   173\t    if (omitted > 0) statements.push(fill(messages.valuesNotShown, { ...counts, count: counts.omitted }) + tableSuffix);\n   174\t    if (changed > 0) statements.push(fill(messages.valuesChanged, { ...counts, count: counts.changed }) + tableSuffix);\n   175\t  }\n   176\t  const omission = statements.join(' ');\n   177\t  const hidden = input.labelsHidden ?? 0;\n   178\t  const labelsHidden = hidden > 0 ? fill(messages.labelsHidden, { count: formatters.count(hidden) }) + tableSuffix : '';\n   179\t  const note = [omission, labelsHidden].filter(Boolean).join(' ') || null;\n   180\t  let summary: string | undefined;\n   181\t  return {\n   182\t    name, note, table,\n   183\t    get summary() {\n   184\t      // Opening the table should not scan the rest of the frame.\n   185\t      return summary ??= [\n   186\t        ...chartText(input, type, xLabel, yLabel, tableSuffix), compact ? stackText(view, formatters, messages) : '',\n   187\t        ...referencesForView(), subtitle, omission, description,\n   188\t      ].filter(Boolean).join(' ');\n   189\t    },\n   190\t  };\n   191\t}\n","exit_code":0,"status":"completed"}}
