{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/core/focus2.test.ts'","aggregated_output":"     1\t/**\n     2\t * Findings 7, 9 and 20 of the interaction review (reviews/2026-11-18/impl/wp/core2.review.md) in the pure\n     3\t * parts: keyboard order and value text against the lookup, zoom limits, and the layout key's axis titles.\n     4\t * Views come from the real controller (test/core/host.ts), so they are the views a chart draws.\n     5\t */\n     6\timport { describe, expect, it } from 'vitest';\n     7\timport type { AlignedView, DatumRef, ScatterView } from '../../src/core/contracts';\n     8\timport { canZoomIn, minimumWidth, scaleWindow, stepAcross, stepInSeries, valueText, zoomApplies } from '../../src/core/focus';\n     9\timport { layoutKey, type AxisContext } from '../../src/core/axes';\n    10\timport { resolveOptions } from '../../src/data';\n    11\timport { DiagnosticCollector } from '../../src/diagnostics';\n    12\timport { defaultMessages } from '../../src/messages';\n    13\timport { record } from './host';\n    14\t\n    15\tfunction drawn(kind: Parameters<typeof record>[0], options: Record<string, unknown>) {\n    16\t  const r = record(kind, { title: 'T', ...options });\n    17\t  r.frames();\n    18\t  const c = r.committed!;\n    19\t  return { r, view: c.view, lookup: c.lookup, formatters: c.formatters };\n    20\t}\n    21\t\n    22\tdescribe('finding 7: the keyboard reaches what the pointer reaches, and reads what the tooltip reads', () => {\n    23\t  it('an x observed only by a hidden series is a place of its own, read \"No observation\", as the lookup counts it', () => {\n    24\t    const data = [{ x: 0, s: 'A', y: 1 }, { x: 1, s: 'B', y: 5 }, { x: 2, s: 'A', y: 3 }];\n    25\t    const { r } = drawn('line', { data, x: 'x', y: 'y', series: 's' });\n    26\t    r.controller.actions.toggle('B');\n    27\t    r.frames();\n    28\t    const { view, lookup, formatters } = r.committed!;\n    29\t    expect(lookup.count).toBe(3);\n    30\t    expect(stepAcross(view as AlignedView, 0, 'next')).toBe(1);\n    31\t    const at1 = valueText(view, lookup, { kind: 'aligned', seriesKey: 'A', x: 1 }, 'all', formatters, defaultMessages);\n    32\t    expect(at1).toBe('1. A No observation. Point 2 of 3');\n    33\t  });\n    34\t\n    35\t  it('a stacked area reads its total; an incomplete stack says \"incomplete\" once, with the total', () => {\n    36\t    const complete = drawn('area', { stacked: true, data: [{ x: 0, s: 'a', y: 2 }, { x: 0, s: 'b', y: 3 }, { x: 1, s: 'a', y: 1 }, { x: 1, s: 'b', y: 1 }], x: 'x', y: 'y', series: 's' });\n    37\t    const ref: DatumRef = { kind: 'aligned', seriesKey: 'a', x: 0 };\n    38\t    expect(valueText(complete.view, complete.lookup, ref, 'all', complete.formatters, defaultMessages))\n    39\t      .toBe('0. a 2; b 3; Total 5. Point 1 of 2');\n    40\t    const gap = drawn('area', { stacked: true, data: [{ x: 0, s: 'a', y: 2 }, { x: 0, s: 'b', y: null }, { x: 1, s: 'a', y: 1 }, { x: 1, s: 'b', y: 1 }], x: 'x', y: 'y', series: 's' });\n    41\t    const text = valueText(gap.view, gap.lookup, ref, 'all', gap.formatters, defaultMessages)!;\n    42\t    expect(text.match(/incomplete/g)?.length).toBe(1);\n    43\t    expect(text).toContain('Total 2 (incomplete)');\n    44\t  });\n    45\t\n    46\t  it('on scatter, after switching series, Right stays in that series', () => {\n    47\t    const data = [{ x: 0, s: 'A', y: 0 }, { x: 1, s: 'B', y: 1 }, { x: 2, s: 'A', y: 2 }, { x: 3, s: 'B', y: 3 }, { x: 4, s: 'A', y: 4 }];\n    48\t    const { view, lookup } = drawn('scatter', { data, x: 'x', y: 'y', series: 's' });\n    49\t    const b1: DatumRef = { kind: 'point', seriesKey: 'B', row: 1, x: 1 };\n    50\t    expect(lookup.datum(b1)?.seriesLabel).toBe('B');\n    51\t    const next = stepInSeries(view as ScatterView, b1, 'next');\n    52\t    expect(next).toEqual({ kind: 'point', seriesKey: 'B', row: 3, x: 3 });\n    53\t    expect(stepInSeries(view as ScatterView, next!, 'next')).toBeNull();\n    54\t    expect(stepInSeries(view as ScatterView, b1, 'previous')).toBeNull();\n    55\t  });\n    56\t});\n    57\t\n    58\tdescribe('finding 9: one minimum window for every gesture, and no exhausted control that does nothing', () => {\n    59\t  it('two or three aligned positions cannot be zoomed in, so Zoom in is not offered as working', () => {\n    60\t    for (const xs of [[0, 100], [0, 50, 100]]) {\n    61\t      const { view } = drawn('line', { data: xs.map(x => ({ x, y: x })), x: 'x', y: 'y' });\n    62\t      expect(canZoomIn(view, view.kind === 'donut' ? [0, 0] : view.xDomain), String(xs)).toBe(false);\n    63\t    }\n    64\t    const { view } = drawn('line', { data: [0, 25, 50, 75, 100].map(x => ({ x, y: x })), x: 'x', y: 'y' });\n    65\t    expect(canZoomIn(view, [0, 100])).toBe(true);\n    66\t  });\n    67\t\n    68\t  it('a window is always strictly ordered and finite, even where doubles are coarse', () => {\n    69\t    const { view } = drawn('scatter', { data: [0, 1, 2, 3, 4].map(i => ({ x: 1e16 + i, y: i })), x: 'x', y: 'y' });\n    70\t    if (view.kind !== 'scatter') throw new Error('scatter');\n    71\t    let window: readonly [number, number] | null = view.xDomain;\n    72\t    for (let i = 0; i < 6 && window; i++) {\n    73\t      const next = scaleWindow(view.xFull, window, 0.5, (window[0] + window[1]) / 2, minimumWidth(view));\n    74\t      if (next === null || (next[0] === window[0] && next[1] === window[1])) break;\n    75\t      expect(next[1] > next[0]).toBe(true);\n    76\t      window = next;\n    77\t    }\n    78\t  });\n    79\t\n    80\t  it('category bars do not zoom (spec 3.6)', () => {\n    81\t    const rows = ['a', 'b', 'c', 'd'].map((k, i) => ({ k, v: i }));\n    82\t    expect(zoomApplies(drawn('bar', { data: rows, x: 'k', y: 'v' }).view, undefined)).toBe(false);\n    83\t  });\n    84\t});\n    85\t\n    86\tdescribe('finding 20: the layout key holds the axis titles it draws', () => {\n    87\t  it('changing only the second series unit changes the shared unit, so the key changes', () => {\n    88\t    const data = [{ d: 1, a: 1, b: 2 }, { d: 2, a: 3, b: 4 }];\n    89\t    const key = (units: [string, string]) => {\n    90\t      const options = { data, x: 'd', y: [{ field: 'a', unit: units[0] }, { field: 'b', unit: units[1] }] };\n    91\t      const { view } = drawn('line', options);\n    92\t      const ctx: AxisContext = {\n    93\t        resolved: resolveOptions('line', options, new DiagnosticCollector()), locale: 'en-US', compact: false,\n    94\t        onFormatterError: () => {}, xLabelGiven: false, valueTitle: 'Value',\n    95\t      };\n    96\t      return layoutKey(view, { width: 600, height: 300 }, { font: '12px a', letterSpacing: 0, wordSpacing: 0, lineHeight: 15 }, 0, ctx);\n    97\t    };\n    98\t    const before = key(['ms', 'ms']);\n    99\t    const after = key(['ms', 's']);\n   100\t    expect(before.includes('Value (ms)')).toBe(true);\n   101\t    expect(after.includes('Value')).toBe(true);\n   102\t    expect(after.includes('Value (ms)')).toBe(false);\n   103\t  });\n   104\t});\n","exit_code":0,"status":"completed"}}
