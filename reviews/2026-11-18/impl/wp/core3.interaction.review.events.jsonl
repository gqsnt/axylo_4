{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/tooltip.ts'","aggregated_output":"     1\t/**\n     2\t * Renders a tooltip model as text (spec I1, DX8: textContent only) in one of two places: floating beside the\n     3\t * active mark, or, when it cannot fit there, in a fixed readout under the plot. It does not decide what is\n     4\t * active; the interaction layer does, for pointer, touch and keyboard alike.\n     5\t *\n     6\t * Floating placement keeps clear of the active marks, of the pointer (so the next click reaches the plot,\n     7\t * not the tooltip) and of the focus ring, and stays inside every box that clips the chart: the viewport and\n     8\t * any ancestor with overflow other than visible (an `overflow: hidden` card). When no side fits, the readout\n     9\t * is used instead; nothing is ever drawn clamped over the mark (WCAG 1.4.13, 2.4.11; review 2, finding 12).\n    10\t *\n    11\t * Both elements are aria-hidden: the keyboard proxy carries the same text as its value text, so a screen\n    12\t * reader is not told twice and nothing here behaves as a live region (spec A7).\n    13\t */\n    14\timport type { DatumText, Rect, TooltipModel } from '../core/contracts';\n    15\timport { createSwatch, type SwatchSpec } from './swatch';\n    16\t\n    17\texport interface TooltipContent {\n    18\t  readonly model: TooltipModel;\n    19\t  readonly swatch: (row: DatumText) => SwatchSpec | null;\n    20\t  readonly moreRows: (count: number) => string;\n    21\t  /** Label of the stack total row (the `total` message). */\n    22\t  readonly totalLabel?: string;\n    23\t  /** A row was chosen with the pointer (a click or a tap on it). */\n    24\t  readonly select?: (row: DatumText) => void;\n    25\t}\n    26\t\n    27\texport interface TooltipView {\n    28\t  /**\n    29\t   * Floating: shows `content` beside `anchor` (viewport coordinates), clear of `pointer` and of `avoid`,\n    30\t   * inside the clipping bounds, flipping sides as needed. Returns false, showing nothing, when no side fits.\n    31\t   */\n    32\t  show(content: TooltipContent, anchor: Rect, pointer: { x: number; y: number } | null, avoid?: readonly Rect[]): boolean;\n    33\t  /**\n    34\t   * Fixed: the same content in the readout under the plot. `passive` lets pointer input through it, for a\n    35\t   * tooltip pinned by touch over the controls under the plot.\n    36\t   */\n    37\t  readout(content: TooltipContent, passive?: boolean): void;\n    38\t  hide(): void;\n    39\t  readonly visible: boolean;\n    40\t  /** Where the content is shown now. */\n    41\t  readonly where: 'floating' | 'readout' | null;\n    42\t  destroy(): void;\n    43\t}\n    44\t\n    45\tconst OFFSET = 12;\n    46\tconst MARGIN = 4;\n    47\t/** Room kept around the pointer, so a small movement or a click does not land on the tooltip. */\n    48\tconst POINTER_ROOM = 10;\n    49\t\n    50\tinterface Bounds { left: number; top: number; right: number; bottom: number }\n    51\t\n    52\tfunction overlaps(a: Bounds, b: Bounds): boolean {\n    53\t  return a.left < b.right && b.left < a.right && a.top < b.bottom && b.top < a.bottom;\n    54\t}\n    55\t\n    56\t/** The viewport, cut down by every ancestor that clips its content. */\n    57\tfunction clipBounds(from: Element): Bounds {\n    58\t  const doc = from.ownerDocument;\n    59\t  const win = doc.defaultView;\n    60\t  const view = doc.documentElement;\n    61\t  const bounds: Bounds = { left: 0, top: 0, right: view.clientWidth, bottom: view.clientHeight };\n    62\t  for (let el: Element | null = from.parentElement; el && el !== view && win; el = el.parentElement) {\n    63\t    const style = win.getComputedStyle(el);\n    64\t    if (style.overflowX === 'visible' && style.overflowY === 'visible') continue;\n    65\t    const box = el.getBoundingClientRect();\n    66\t    bounds.left = Math.max(bounds.left, box.left);\n    67\t    bounds.top = Math.max(bounds.top, box.top);\n    68\t    bounds.right = Math.min(bounds.right, box.right);\n    69\t    bounds.bottom = Math.min(bounds.bottom, box.bottom);\n    70\t  }\n    71\t  return bounds;\n    72\t}\n    73\t\n    74\texport function createTooltip(element: HTMLElement, readoutElement: HTMLElement, figure: HTMLElement, plot: HTMLElement): TooltipView {\n    75\t  const doc = element.ownerDocument;\n    76\t  let visible = false;\n    77\t  /** Row listeners belong to the rows of one fill; the next fill or hide removes them. */\n    78\t  let rows: AbortController | null = null;\n    79\t\n    80\t  function fill(target: HTMLElement, { model, swatch, moreRows, totalLabel, select }: TooltipContent): void {\n    81\t    rows?.abort();\n    82\t    rows = new AbortController();\n    83\t    const heading = doc.createElement('div');\n    84\t    heading.className = 'axylo-tooltip-title';\n    85\t    heading.textContent = model.title;\n    86\t    const children: HTMLElement[] = [heading];\n    87\t    for (const row of model.rows) {\n    88\t      const line = doc.createElement('div');\n    89\t      line.className = 'axylo-tooltip-row';\n    90\t      const name = doc.createElement('span');\n    91\t      name.className = 'axylo-tooltip-series';\n    92\t      const spec = swatch(row);\n    93\t      if (spec) name.appendChild(createSwatch(doc, spec));\n    94\t      name.appendChild(doc.createTextNode(row.seriesLabel));\n    95\t      const value = doc.createElement('span');\n    96\t      value.className = 'axylo-tooltip-value';\n    97\t      value.textContent = row.percent === null || row.percent === row.value ? row.value : `${row.value} (${row.percent})`;\n    98\t      line.append(name, value);\n    99\t      if (select) {\n   100\t        line.classList.add('axylo-tooltip-choice');\n   101\t        line.addEventListener('click', () => select(row), { signal: rows.signal });\n   102\t      }\n   103\t      children.push(line);\n   104\t    }\n   105\t    if (model.count > model.rows.length) {\n   106\t      const more = doc.createElement('div');\n   107\t      more.className = 'axylo-tooltip-more';\n   108\t      more.textContent = moreRows(model.count - model.rows.length);\n   109\t      children.push(more);\n   110\t    }\n   111\t    if (model.total !== null) {\n   112\t      const total = doc.createElement('div');\n   113\t      total.className = 'axylo-tooltip-row axylo-tooltip-total';\n   114\t      const name = doc.createElement('span');\n   115\t      name.className = 'axylo-tooltip-series';\n   116\t      name.textContent = totalLabel ?? '';\n   117\t      const value = doc.createElement('span');\n   118\t      value.className = 'axylo-tooltip-value';\n   119\t      value.textContent = model.total;\n   120\t      total.append(name, value);\n   121\t      children.push(total);\n   122\t    }\n   123\t    target.replaceChildren(...children);\n   124\t  }\n   125\t\n   126\t  function hideFloating(): void {\n   127\t    if (element.hidden) return;\n   128\t    element.hidden = true;\n   129\t    element.replaceChildren();\n   130\t  }\n   131\t\n   132\t  function hideReadout(): void {\n   133\t    if (readoutElement.hidden) return;\n   134\t    readoutElement.hidden = true;\n   135\t    readoutElement.classList.remove('axylo-passive');\n   136\t    readoutElement.replaceChildren();\n   137\t  }\n   138\t\n   139\t  return {\n   140\t    get visible() {\n   141\t      return visible;\n   142\t    },\n   143\t    get where() {\n   144\t      return !visible ? null : readoutElement.hidden ? 'floating' : 'readout';\n   145\t    },\n   146\t    show(content, anchor, pointer, avoid = []) {\n   147\t      fill(element, content);\n   148\t      element.hidden = false;\n   149\t      element.style.transform = 'translate(0px, 0px)';\n   150\t      const width = element.offsetWidth;\n   151\t      const height = element.offsetHeight;\n   152\t      const outer = figure.getBoundingClientRect();\n   153\t      // Everything the tooltip must not cover: the marks, the pointer with some room, the focus ring.\n   154\t      const keep: Bounds[] = [{ left: anchor.x, top: anchor.y, right: anchor.x + anchor.width, bottom: anchor.y + anchor.height }];\n   155\t      if (pointer) keep.push({ left: pointer.x - POINTER_ROOM, top: pointer.y - POINTER_ROOM, right: pointer.x + POINTER_ROOM, bottom: pointer.y + POINTER_ROOM });\n   156\t      for (const r of avoid) keep.push({ left: r.x, top: r.y, right: r.x + r.width, bottom: r.y + r.height });\n   157\t      const clear: Bounds = {\n   158\t        left: Math.min(...keep.map(k => k.left)), top: Math.min(...keep.map(k => k.top)),\n   159\t        right: Math.max(...keep.map(k => k.right)), bottom: Math.max(...keep.map(k => k.bottom)),\n   160\t      };\n   161\t      const clip = clipBounds(figure);\n   162\t      const limits: Bounds = { left: clip.left + MARGIN, top: clip.top + MARGIN, right: clip.right - MARGIN, bottom: clip.bottom - MARGIN };\n   163\t      // A tile too narrow for a tooltip on either side uses the readout throughout, so it does not jump\n   164\t      // between two places as the pointer moves.\n   165\t      if (outer.width < 2 * (width + OFFSET)) {\n   166\t        hideFloating();\n   167\t        visible = false;\n   168\t        return false;\n   169\t      }\n   170\t      const clampY = (y: number) => Math.max(limits.top, Math.min(y, limits.bottom - height));\n   171\t      const clampX = (x: number) => Math.max(limits.left, Math.min(x, limits.right - width));\n   172\t      const cy = (pointer?.y ?? anchor.y + anchor.height / 2) - height / 2;\n   173\t      const cx = anchor.x + anchor.width / 2 - width / 2;\n   174\t      const candidates: [number, number][] = [\n   175\t        [clear.right + OFFSET, clampY(cy)],\n   176\t        [clear.left - OFFSET - width, clampY(cy)],\n   177\t        [clampX(cx), clear.bottom + OFFSET],\n   178\t        [clampX(cx), clear.top - OFFSET - height]