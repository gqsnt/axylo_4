after = await page.evaluate(() => window.charts[0]!.__bench.describe());\n   467\t    expect(after.series[0]!.newestX).toBe(START + 124 * DAY);\n   468\t    expect(after.series[0]!.oldestX).toBe(START + 5 * DAY);\n   469\t    expect(await closePage(page)).toEqual([]);\n   470\t  });\n   471\t\n   472\t  it('keyboard focus stays on its datum until it leaves the window, then resolves forward', async () => {\n   473\t    const page = await fixturePage();\n   474\t    await make(page, 'trend');\n   475\t    await page.focus('#chart .axylo-proxy');\n   476\t    for (let i = 0; i < 3; i++) await page.keyboard.press('ArrowRight');\n   477\t    const text = () => page.locator('#chart .axylo-proxy').getAttribute('aria-valuetext');\n   478\t    expect((await text())!.startsWith(date(START + 3 * DAY))).toBe(true);\n   479\t    for (let d = 120; d < 123; d++) await page.evaluate(async rows => { window.charts[0]!.append(rows, { keep: 120 }); }, rowsFor(d));\n   480\t    await settle(page);\n   481\t    // Days 0–2 left the window; day 3 is still there, so nothing changed for the reader.\n   482\t    expect((await text())!.startsWith(date(START + 3 * DAY))).toBe(true);\n   483\t    await page.evaluate(async rows => { window.charts[0]!.append(rows, { keep: 120 }); }, rowsFor(123));\n   484\t    await settle(page);\n   485\t    expect((await text())!.startsWith(date(START + 4 * DAY))).toBe(true);\n   486\t    // The position message ('Point {index} of {count}') ends the all-series value text.\n   487\t    expect((await text())!.endsWith('Point 1 of 120')).toBe(true);\n   488\t    // The next move starts from there.\n   489\t    await page.keyboard.press('ArrowRight');\n   490\t    expect((await text())!.startsWith(date(START + 5 * DAY))).toBe(true);\n   491\t    expect(await closePage(page)).toEqual([]);\n   492\t  });\n   493\t\n   494\t  it('24 charts appending for two seconds change no live region', async () => {\n   495\t    const page = await fixturePage({ css: '.tile { width: 220px; height: 160px; display: inline-block; }' });\n   496\t    const changes = await page.evaluate(async () => {\n   497\t      const charts = Array.from({ length: 24 }, () => {\n   498\t        const el = document.body.appendChild(Object.assign(document.createElement('div'), { className: 'tile' }));\n   499\t        return window.make('trend', el);\n   500\t      });\n   501\t      await Promise.all(charts.map(c => c.__bench.ready()));\n   502\t      let mutations = 0;\n   503\t      const observer = new MutationObserver(records => { mutations += records.length; });\n   504\t      // Every live region: aria-live other than off, or a live role without aria-live=\"off\".\n   505\t      const live = '[aria-live]:not([aria-live=\"off\"]), [role=\"status\"]:not([aria-live=\"off\"]), [role=\"alert\"], [role=\"log\"]';\n   506\t      for (const region of document.querySelectorAll(live)) {\n   507\t        observer.observe(region, { subtree: true, childList: true, characterData: true, attributes: true });\n   508\t      }\n   509\t      const start = performance.now();\n   510\t      let day = 120;\n   511\t      while (performance.now() - start < 2000) {\n   512\t        const t = Date.UTC(2026, 0, 1) + day * 864e5;\n   513\t        for (const c of charts) c.append(['Direct', 'Organic search', 'Referral'].map(channel => ({ day: t, channel, sessions: 1000 + day })), { keep: 120 });\n   514\t        day++;\n   515\t        await new Promise(r => setTimeout(r, 50));\n   516\t      }\n   517\t      await Promise.all(charts.map(c => c.__bench.ready()));\n   518\t      observer.disconnect();\n   519\t      return { mutations, regions: document.querySelectorAll(live).length, days: day - 120 };\n   520\t    });\n   521\t    expect(changes.regions).toBeGreaterThanOrEqual(24);\n   522\t    expect(changes.days).toBeGreaterThan(10);\n   523\t    expect(changes.mutations).toBe(0);\n   524\t    expect(await closePage(page)).toEqual([]);\n   525\t  });\n   526\t});\n   527\t\n   528\