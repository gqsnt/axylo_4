ntent ?? ''); });\n   511\t      observer.observe(status, { childList: true, characterData: true, subtree: true });\n   512\t      window.charts[0]!.append([{ x: 200, y: 200 }]);\n   513\t      await window.charts[0]!.__bench.ready();\n   514\t      await window.nextFrames(2);\n   515\t      observer.disconnect();\n   516\t      return { heard, text: status.textContent };\n   517\t    });\n   518\t    expect(spoken).toEqual({ heard: [], text: 'Page 1 of 3' });\n   519\t    expect(await closePage(page)).toEqual([]);\n   520\t  });\n   521\t});\n   522\t\n   523\tdescribe('focus survives a render (finding 17)', () => {\n   524\t  it('a focused legend entry keeps focus when the series order changes', async () => {\n   525\t    const page = await chartPage();\n   526\t    await create(page, 'line', { title: 'W', data: [1, 2].map(x => ({ x, a: x, b: -x })), x: 'x', y: ['a', 'b'] });\n   527\t    await page.locator('#chart .axylo-legend-entry', { hasText: 'b' }).focus();\n   528\t    await page.evaluate(async () => { window.charts[0]!.update({ y: ['b', 'a'] }); await window.charts[0]!.__bench.ready(); await window.nextFrames(1); });\n   529\t    expect(await page.evaluate(() => document.activeElement?.textContent)).toBe('b');\n   530\t    expect(await closePage(page)).toEqual([]);\n   531\t  });\n   532\t\n   533\t  it('turning the table off while the jump field has focus hands focus to the chart, not the page', async () => {\n   534\t    const page = await chartPage();\n   535\t    await create(page, 'line', { title: 'T', data: Array.from({ length: 250 }, (_, i) => ({ x: i, y: i })), x: 'x', y: 'y' });\n   536\t    await button(page, 'View as table').click();\n   537\t    await settle(page);\n   538\t    await page.locator('#chart .axylo-jump-field').focus();\n   539\t    await page.evaluate(async () => { window.charts[0]!.update({ table: false }); await window.charts[0]!.__bench.ready(); await window.nextFrames(1); });\n   540\t    expect(await page.evaluate(() => !!document.activeElement?.closest('#chart'))).toBe(true);\n   541\t    expect(await closePage(page)).toEqual([]);\n   542\t  });\n   543\t});\n   544\t\n   545\tdescribe('\"Jump to\" accepts what the table shows (finding 18)', () => {\n   546\t  it('a grouped number (\"200,000\") and a displayed date (\"May 31, 2026\") find their page', async () => {\n   547\t    const page = await chartPage();\n   548\t    await create(page, 'line', { title: 'N', data: Array.from({ length: 300 }, (_, i) => ({ x: i * 1000, y: i })), x: 'x', y: 'y' });\n   549\t    await button(page, 'View as table').click();\n   550\t    await page.locator('#chart .axylo-jump-field').fill('200,000');\n   551\t    await page.keyboard.press('Enter');\n   552\t    expect(await page.locator('#chart .axylo-page').textContent()).toBe('Page 3 of 3');\n   553\t    expect(await page.locator('#chart .axylo-jump-field').getAttribute('aria-invalid')).toBeNull();\n   554\t    await page.locator('#chart .axylo-jump-field').fill('1 2');\n   555\t    await page.keyboard.press('Enter');\n   556\t    expect(await page.locator('#chart .axylo-jump-field').getAttribute('aria-invalid')).toBe('true');\n   557\t    await page.evaluate(() => window.charts.pop()!.destroy());\n   558\t    const days = Array.from({ length: 200 }, (_, i) => ({ d: new Date(Date.UTC(2026, 0, 1) + i * 864e5).toISOString().slice(0, 10), y: i }));\n   559\t    await create(page, 'line', { title: 'D', data: days, x: 'd', y: 'y' });\n   560\t    await button(page, 'View as table').click();\n   561\t    await page.locator('#chart .axylo-jump-field').fill('May 31, 2026');\n   562\t    await page.keyboard.press('Enter');\n   563\t    // 2026-05-31 is day 150 of the series: row 151, on page 2 of 2.\n   564\t    expect(await page.locator('#chart .axylo-page').textContent()).toBe('Page 2 of 2');\n   565\t    expect(await closePage(page)).toEqual([]);\n   566\t  });\n   567\t});\n   568\t\n   569\tdescribe('language of the plot (finding 19)', () => {\n   570\t  it('on a lang=\"de\" page the plot\\'s built-in label and role description are marked English; a state change too', async () => {\n   571\t    const page = await chartPage();\n   572\t    await page.evaluate(() => { document.documentElement.lang = 'de'; });\n   573\t    await create(page, 'line', { title: 'L', data: [{ x: 1, y: 1 }, { x: 2, y: 2 }], x: 'x', y: 'y' });\n   574\t    expect(await page.locator('#chart .axylo-proxy').getAttribute('lang')).toBe('en');\n   575\t    await page.evaluate(async () => { window.charts[0]!.update({ state: 'loading' }); await window.charts[0]!.__bench.ready(); await window.nextFrames(1); });\n   576\t    expect(await page.locator('#chart .axylo-live').getAttribute('lang')).toBe('en');\n   577\t    expect(await closePage(page)).toEqual([]);\n   578\t  });\n   579\t});\n   580\t\n   581\tdescribe('swatches repeat the contrast dash (finding 22)', () => {\n   582\t  it('under prefers-contrast: more a line swatch uses the dash its line uses', async () => {\n   583\t    const page = await chartPage();\n   584\t    await page.emulateMedia({ contrast: 'more' } as never);\n   585\t    const data = [1, 2].flatMap(x => ['a', 'b'].map(s => ({ x, s, y: x })));\n   586\t    await create(page, 'line', { title: 'C', data, x: 'x', y: 'y', series: 's' });\n   587\t    const dashes = await page.evaluate(() => [...document.querySelectorAll('#chart .axylo-legend-entry .axylo-swatch-line')].map(l => getComputedStyle(l).strokeDasharray));\n   588\t    expect(dashes[0]).toBe('none');\n   589\t    // The second series' contrast dash is [12, 5] (view cues); the swatch draws it halved.\n   590\t    expect(dashes[1]).toBe('6px, 2.5px');\n   591\t    // Against the plotted line itself (SVG marks): the swatch is the same pattern at half length.\n   592\t    const plotted = await page.evaluate(() => [...document.querySelectorAll('#chart svg.axylo-svg path')]\n   593\t      .map(p => getComputedStyle(p).strokeDasharray).filter(d => d !== 'none'));\n   594\t    if (plotted.length) expect(plotted[0]!.split(',').map(v => parseFloat(v) / 2)).toEqual(dashes[1]!.split(',').map(v => parseFloat(v)));\n   595\t    expect(await closePage(page)).toEqual([]);\n   596\t  });\n   597\t});\n   598\t\n   599\tdescribe('a pinned tooltip belongs to the displayed revision (finding 11)', () => {\n   600\t  it('a tapped scatter point zoomed out of view takes its tooltip with it', async () => {\n   601\t    const page = await chartPage({ hasTouch: true });\n   602\t    await create(page, 'scatter', { title: 'Pin', data: Array.from({ length: 11 }, (_, i) => ({ x: i * 10, y: i })), x: 'x', y: 'y' });\n   603\t    const box = (await page.locator('#chart .axylo-proxy').boundingBox())!;\n   604\t    const g = await page.evaluate(() => window.charts[0]!.__bench.describe());\n   605\t    // The point at x = 80, y = 8.\n   606\t    const px = box.x + (80 - g.xDomain![0]!) / (g.xDomain![1]! - g.xDomain![0]!) * box.width;\n   607\t    const py = box.y + box.height - (8 - g.yDomain![0]!) / (g.yDomain![1]! - g.yDomain![0]!) * box.height;\n   608\t    await page.touchscreen.tap(px, py);\n   609\t    const tip = page.locator('#chart .axylo-tooltip, #chart .axylo-readout').filter({ hasText: '80' });\n   610\t    expect(await tip.count()).toBe(1);\n   611\t    await page.evaluate(() => window.charts[0]!.zoom([0, 40]));\n   612\t    await settle(page);\n   613\t    expect(await page.evaluate(() => [...document.querySelectorAll('#chart .axylo-tooltip, #chart .axylo-readout')].filter(e => !(e as HTMLElement).hidden).length)).toBe(0);\n   614\t    expect(await closePage(page)).toEqual([]);\n   615\t  });\n   616\t});\n   617\t\n   618\tdescribe('the pointer readout follows every move (spec I1; the benchmark\\'s hover workload)', () => {\n   619\t  it('one series of 10,000 points, 40 evenly spaced real moves, one per frame: each names the datum nearest the pointer\\'s x', async () => {\n   620\t    const page = await chartPage();\n   621\t    const n = 10_000;\n   622\t    await page.evaluate(async n => {\n   623\t      const x = Float64Array.from({ length: n }, (_, i) => i);\n   624\t      const y = Float64Array.from({ length: n }, (_, i) => Math.sin(i / 50) * 100);\n   625\t      const chart = window.Axylo.line!('#chart', { title: 'Hover', data: { columns: { x, y } }, x: 'x', y: 'y' });\n   626\t      window.charts.push(chart);\n   627\t      (window as unknown as { hovered: number }).hovered = NaN;\n   628\t      chart.on('hover', p => { (window as unknown as { hovered: number }).hovered = p ? (p as { index: number }).index : NaN; });\n   629\t      await chart.__bench.ready();\n   630\t    }, n);\n   631\t    const box = (await page.locator('#chart .axylo-proxy').boundingBox())!;\n   632\t    const { xDomain } = await page.evaluate(() => window.charts[0]!.__bench.describe());\n   633\t    const y = box.y + box.height / 2;\n   634\t    const picked: number[] = [];\n   635\t    const expected: number[] = [];\n   636\t    for (let k = 0; k < 40; k++) {\n   637\t      const px = box.x + box.width * (0.1 + 0.8 * k / 39);\n   638\t      await page.mouse.move(px, y);\n   639\t      await page.evaluate(() => new Promise(r => requestAnimationFrame(() => r(null))));\n   640\t      picked.push(await page.evaluate(() => (window as unknown as { hovered: number }).hovered));\n   641\t      // The x scale maps the domain onto the plot's width; the nearest datum to the pointer's position.\n   642\t      const at = xDomain![0]! + (px - box.x) / box.width * (xDomain![1]! - xDomain![0]!);\n   643\t      expected.push(Math.max(0, Math.min(n - 1, Math.round(at))));\n   644\t    }\n   645\t    // Pixel positions are fractional; a datum one index away is the same pixel at this density.\n   646\t    const off = picked.map((p, k) => Math.abs(p - expected[k]!));\n   647\t    expect(Math.max(...off), JSON.stringify({ picked, expected })).toBeLessThanOrEqual(Math.ceil(n / box.width));\n   648\t    expect(new Set(picked).size).toBe(40);\n   649\t    expect(await closePage(page)).toEqual([]);\n   650\t  });\n   651\t});\n   652\t\n   653\tdescribe('spec A5 in the swatches (palette review)', () => {\n   654\t  const eight = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];\n   655\t  const rows = [0, 1, 2].flatMap(x => eight.map((s, i) => ({ x, s, y: 1 + i + x })));\n   656\t\n   657\t  it('eight area series: each legend and tooltip swatch carries that series\\' marker, and the eight are distinct', async () => {\n   658\t    const page = await chartPage({ css: '#chart { width: 900px; }' });\n   659\t    // The markers a line chart's swatches draw are the plotted markers (both come from the view's cues).\n   660\t    await create(page, 'line', { title: 'Lines', data: rows, x: 'x', y: 'y', series: 's' });\n   661\t    const markers = await page.evaluate(() => [...document.querySelectorAll('#chart .axylo-legend-entry svg.axylo-swatch')].map(svg => [...svg.querySelectorAll('path')].at(-1)!.getAttribute('d')));\n   662\t    await page.evaluate(() => window.charts.pop()!.destroy());\n   663\t    await create(page, 'area', { title: 'Areas', data: rows, x: 'x', y: 'y', series: 's' });\n   664\t    const shapes = await page.evaluate(() => [...document.querySelectorAll('#chart .axylo-legend-entry svg.axylo-swatch')].map(svg => ({\n   665\t      chip: !!svg.querySelector('path.axylo-swatch-chip'), marker: svg.querySelector('path.axylo-swatch-marker')?.getAttribute('d') ?? null,\n   666\t    })));\n   667\t    expect(shapes.map(s => s.chip)).toEqual(eight.map(() => true));\n   668\t    expect(shapes.map(s => s.marker)).toEqual(markers);\n   669\t    expect(new Set(markers).size).toBe(8);\n   670\t    const box = (await page.locator('#chart .axylo-proxy').boundingBox())!;\n   671\t    await page.mouse.move(box.x + 2, box.y + box.height / 2);\n   672\t    const tip = await page.evaluate(() => [...document.querySelectorAll('#chart .axylo-tooltip svg.axylo-swatch, #chart .axylo-readout svg.axylo-swatch')].map(svg => svg.querySelector('path.axylo-swatch-marker')?.getAttribute('d') ?? null));\n   673\t    expect(tip).toEqual(markers);\n   674\t    expect(await closePage(page)).toEqual([]);\n   675\t  });\n   676\t\n   677\t  it('bar swatches past the eighth series carry the bar pattern; the first eight do not', async () => {\n   678\t    const page = await chartPage({ css: '#chart { width: 900px; }' });\n   679\t    const nine = [...eight, 'i'];\n   680\t    await create(page, 'bar', { title: 'Bars', data: ['p', 'q'].flatMap(x => nine.map((s, i) => ({ x, s, y: i + 1 }))), x: 'x', y: 'y', series: 's' });\n   681\t    const patterns = await page.evaluate(() => [...document.querySelectorAll('#chart .axylo-legend-entry svg.axylo-swatch')].map(svg => !!svg.querySelector('.axylo-swatch-pattern')));\n   682\t    expect(patterns).toEqual([false, false, false, false, false, false, false, false, true]);\n   683\t    expect(await closePage(page)).toEqual([]);\n   684\t  });\n   685\t});\n   686\t\n   687\tdescribe('adjacent filled marks are separated by background (spec A5), on rendered pixels', () => {\n   688\t  it('two stacked bar segments have at least 1 px of the background between them', async () => {\n   689\t    const page = await chartPage({ css: 'body { background: rgb(255, 255, 255); }' });\n   690\t    await create(page, 'bar', { title: 'S', layout: 'stacked', data: ['p', 'q', 'r'].flatMap(x => [{ x, s: 'a', y: 5 }, { x, s: 'b', y: 5 }]), x: 'x', y: 'y', series: 's' });\n   691\t    const proxy = (await page.locator('#chart .axylo-proxy').boundingBox())!;\n   692\t    const plot = (await page.locator('#chart .axylo-plot').boundingBox())!;\n   693\t    const shot = await page.screenshot({ clip: plot });\n   694\t    const { decodePng } = await import('../render/png');\n   695\t    const img = decodePng(shot);\n   696\t    // The middle bar's centre column, from the plot's bottom edge upwards: segment a, the seam, segment b.\n   697\t    const cx = Math.round(proxy.x - plot.x + proxy.width / 2);\n   698\t    const column: [number, number, number][] = [];\n   699\t    for (let y = Math.floor(proxy.y - plot.y + proxy.height) - 2; y > proxy.y - plot.y; y--) {\n   700\t      const o = (y * img.width + cx) * 4;\n   701\t      column.push([img.data[o]!, img.data[o + 1]!, img.data[o + 2]!]);\n   702\t    }\n   703\t    const white = (c: [number, number, number]) => c.every(v => v > 245);\n   704\t    // Runs of colored / white pixels along the column.\n   705\t    const runs: { white: boolean; length: number }[] = [];\n   706\t    for (const c of column) {\n   707\t      const w = white(c);\n   708\t      if (runs.length && runs.at(-1)!.white === w) runs.at(-1)!.length++;\n   709\t      else runs.push({ white: w, length: 1 });\n   710\t    }\n   711\t    const colored = runs.map((r, i) => ({ ...r, i })).filter(r => !r.white && r.length > 3);\n   712\t    expect(colored.length, JSON.stringify(column.filter((_, i) => i % 1 === 0).map(c => c.join('.')).filter((c, i, all) => c !== all[i - 1]))).toBeGreaterThanOrEqual(2);\n   713\t    const between = runs.slice(colored[0]!.i + 1, colored[1]!.i);\n   714\t    expect(between.some(r => r.white && r.length >= 1)).toBe(true);\n   715\t    expect(await closePage(page)).toEqual([]);\n   716\t  });\n   717\t});\n   718\t\n","exit_code":0,"status":"completed"}}
