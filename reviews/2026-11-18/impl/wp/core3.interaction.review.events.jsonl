{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/swatch.ts'","aggregated_output":"     1\t/**\n     2\t * The legend and tooltip swatch: a small SVG that repeats how a series is drawn (spec A5): a filled square\n     3\t * for bars and areas (with the bar's pattern past the eighth series, spec F9), the line with its dash and\n     4\t * marker for lines, the marker for scatter. The color is the series' custom property on the chart root\n     5\t * (`--axylo-series-color-N`), so a theme change or forced colors restyle it with no call.\n     6\t *\n     7\t * A hidden series is drawn as an outline of the same shape (spec I2: marked by shape, not by dimming).\n     8\t */\n     9\timport type { MarkerShape, SeriesCue } from '../core/contracts';\n    10\timport { MARKER_POLYGONS } from '../render/geometry';\n    11\t\n    12\tconst NS = 'http://www.w3.org/2000/svg';\n    13\t\n    14\texport interface SwatchSpec {\n    15\t  /** Palette index of the series (or slice), null for a muted entry such as a donut's \"Other\". */\n    16\t  readonly color: number | null;\n    17\t  readonly cue: SeriesCue | null;\n    18\t  /** Draw the short dashed stroke of a line behind the marker. */\n    19\t  readonly line: boolean;\n    20\t  /** Outline only: the series is hidden. */\n    21\t  readonly hollow: boolean;\n    22\t  /** A filled square: bars and areas fill a region. */\n    23\t  readonly fill?: boolean;\n    24\t  /**\n    25\t   * Areas: the series' marker drawn on the square, as the marks carry it at their last point and at sparse\n    26\t   * intervals (spec A5). Bars have none; they are told apart by pattern past eight series (spec F9).\n    27\t   */\n    28\t  readonly marker?: boolean;\n    29\t  /** The bar pattern drawn over the fill in the background color, or null. */\n    30\t  readonly pattern?: 'diagonal' | 'cross' | 'dots' | null;\n    31\t}\n    32\t\n    33\tconst BACKGROUND = 'var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background)))';\n    34\t\n    35\t/** The pattern inside the 10 × 10 chip at (5, 1), as path data: lines x + y = c (and x − y = c), or dots. */\n    36\tfunction patternPath(kind: 'diagonal' | 'cross' | 'dots'): string {\n    37\t  const x0 = 5, y0 = 1, size = 10;\n    38\t  if (kind === 'dots') {\n    39\t    let d = '';\n    40\t    for (const [cx, cy] of [[7.5, 3.5], [12.5, 3.5], [10, 6], [7.5, 8.5], [12.5, 8.5]] as const) {\n    41\t      d += `M${cx + 1} ${cy}a1 1 0 1 0 -2 0a1 1 0 1 0 2 0Z`;\n    42\t    }\n    43\t    return d;\n    44\t  }\n    45\t  let d = '';\n    46\t  // Diagonals every 4 px, clipped to the chip by hand (no <clipPath>, so no ids to keep unique).\n    47\t  for (let c = 4; c < 2 * size; c += 4) {\n    48\t    const a = Math.max(0, c - size);\n    49\t    const b = Math.min(size, c);\n    50\t    d += `M${x0 + a} ${y0 + size - (c - a)}L${x0 + b} ${y0 + size - (c - b)}`;\n    51\t    if (kind === 'cross') d += `M${x0 + a} ${y0 + (c - a)}L${x0 + b} ${y0 + (c - b)}`;\n    52\t  }\n    53\t  return d;\n    54\t}\n    55\t\n    56\tfunction colorOf(index: number | null): string {\n    57\t  return index === null ? 'var(--axylo-muted, var(--axylo-default-muted))' : `var(--axylo-series-color-${index + 1})`;\n    58\t}\n    59\t\n    60\tfunction markerPath(shape: MarkerShape, cx: number, cy: number, size: number): string {\n    61\t  if (shape === 'circle') {\n    62\t    const r = size / 2;\n    63\t    return `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0Z`;\n    64\t  }\n    65\t  const poly = MARKER_POLYGONS[shape];\n    66\t  let d = '';\n    67\t  for (let k = 0; k < poly.length; k += 2) {\n    68\t    d += `${k === 0 ? 'M' : 'L'}${(cx + poly[k]! * size).toFixed(2)} ${(cy + poly[k + 1]! * size).toFixed(2)}`;\n    69\t  }\n    70\t  return d + 'Z';\n    71\t}\n    72\t\n    73\t/** A 20 × 12 swatch (CSS px). aria-hidden: the series name beside it is the text. */\n    74\texport function createSwatch(doc: Document, spec: SwatchSpec): SVGSVGElement {\n    75\t  const svg = doc.createElementNS(NS, 'svg');\n    76\t  svg.setAttribute('class', 'axylo-swatch');\n    77\t  svg.setAttribute('viewBox', '0 0 20 12');\n    78\t  svg.setAttribute('width', '20');\n    79\t  svg.setAttribute('height', '12');\n    80\t  svg.setAttribute('aria-hidden', 'true');\n    81\t  svg.setAttribute('focusable', 'false');\n    82\t  const color = colorOf(spec.color);\n    83\t  svg.style.color = color;\n    84\t  if (spec.line) {\n    85\t    const line = doc.createElementNS(NS, 'line');\n    86\t    line.setAttribute('x1', '0');\n    87\t    line.setAttribute('x2', '20');\n    88\t    line.setAttribute('y1', '6');\n    89\t    line.setAttribute('y2', '6');\n    90\t    line.setAttribute('stroke', 'currentColor');\n    91\t    line.setAttribute('stroke-width', '2');\n    92\t    // Both patterns, so the stylesheet can switch to the contrast one exactly where the marks do (prefers-\n    93\t    // contrast: more, forced colors; review 2, finding 22). Halved: the swatch is a short sample.\n    94\t    const pattern = (dash: readonly number[] | null | undefined) => dash && dash.length ? dash.map(v => Math.max(1, v / 2)).join(' ') : 'none';\n    95\t    line.setAttribute('class', 'axylo-swatch-line');\n    96\t    line.style.setProperty('--axylo-swatch-dash', pattern(spec.cue?.dash.normal));\n    97\t    line.style.setProperty('--axylo-swatch-dash-contrast', pattern(spec.cue?.dash.contrast));\n    98\t    svg.appendChild(line);\n    99\t  }\n   100\t  const shape = doc.createElementNS(NS, 'path');\n   101\t  // Bars, areas and donut slices are filled regions: a square chip. Otherwise the series' marker.\n   102\t  const chip = spec.fill === true || !spec.cue;\n   103\t  const marked = chip && spec.marker === true && spec.cue !== null;\n   104\t  shape.setAttribute('class', chip ? 'axylo-swatch-chip' : 'axylo-swatch-marker');\n   105\t  shape.setAttribute('d', chip ? 'M5 1H15V11H5Z' : markerPath(spec.cue!.marker, 10, 6, 10));\n   106\t  // Under a marker the chip is lighter, as an area's fill is, so the marker in full color shows on it.\n   107\t  if (marked && !spec.hollow) shape.setAttribute('fill-opacity', '0.4');\n   108\t  if (spec.hollow) {\n   109\t    // Under the line a hollow marker needs the background inside it, or the line shows through.\n   110\t    shape.setAttribute('fill', BACKGROUND);\n   111\t    shape.setAttribute('stroke', 'currentColor');\n   112\t    shape.setAttribute('stroke-width', '1.5');\n   113\t  } else {\n   114\t    shape.setAttribute('fill', 'currentColor');\n   115\t  }\n   116\t  svg.appendChild(shape);\n   117\t  if (marked) {\n   118\t    const marker = doc.createElementNS(NS, 'path');\n   119\t    marker.setAttribute('class', 'axylo-swatch-marker');\n   120\t    marker.setAttribute('d', markerPath(spec.cue!.marker, 10, 6, 10));\n   121\t    if (spec.hollow) {\n   122\t      marker.setAttribute('fill', BACKGROUND);\n   123\t      marker.setAttribute('stroke', 'currentColor');\n   124\t      marker.setAttribute('stroke-width', '1.5');\n   125\t    } else {\n   126\t      marker.setAttribute('fill', 'currentColor');\n   127\t      // A thin edge of the background keeps the marker's outline readable on its own color (spec A5).\n   128\t      marker.setAttribute('stroke', BACKGROUND);\n   129\t      marker.setAttribute('stroke-width', '1');\n   130\t    }\n   131\t    svg.appendChild(marker);\n   132\t  }\n   133\t  if (chip && spec.pattern && !spec.hollow) {\n   134\t    const pattern = doc.createElementNS(NS, 'path');\n   135\t    pattern.setAttribute('class', 'axylo-swatch-pattern');\n   136\t    pattern.setAttribute('d', patternPath(spec.pattern));\n   137\t    if (spec.pattern === 'dots') pattern.setAttribute('fill', BACKGROUND);\n   138\t    else {\n   139\t      pattern.setAttribute('fill', 'none');\n   140\t      pattern.setAttribute('stroke', BACKGROUND);\n   141\t      pattern.setAttribute('stroke-width', '1.5');\n   142\t    }\n   143\t    svg.appendChild(pattern);\n   144\t  }\n   145\t  return svg;\n   146\t}\n","exit_code":0,"status":"completed"}}
