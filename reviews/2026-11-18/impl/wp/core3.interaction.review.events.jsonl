er('abort', () => live.set(this, (live.get(this) ?? 1) - 1));\n   254\t        }\n   255\t        return add.call(this, type, fn, o);\n   256\t      } as typeof EventTarget.prototype.addEventListener;\n   257\t      EventTarget.prototype.removeEventListener = function (this: EventTarget, type: string, fn: EventListenerOrEventListenerObject | null, o?: boolean | EventListenerOptions) {\n   258\t        if (fn && this instanceof Element && live.has(this)) live.set(this, live.get(this)! - 1);\n   259\t        return remove.call(this, type, fn, o);\n   260\t      } as typeof EventTarget.prototype.removeEventListener;\n   261\t      const data = [1, 2].flatMap(x => [{ x, s: 'a', y: 1 }, { x, s: 'b', y: 2 }]);\n   262\t      const chart = window.Axylo.line!('#chart', { title: 'L', data, x: 'x', y: 'y', series: 's' });\n   263\t      await chart.__bench.ready();\n   264\t      chart.append([{ x: 3, s: 'a', y: 3 }]);\n   265\t      await chart.__bench.ready();\n   266\t      (document.querySelector('#chart .axylo-toolbar button') as HTMLElement).click();\n   267\t      await chart.__bench.ready();\n   268\t      chart.destroy();\n   269\t      return [...live].filter(([, n]) => n > 0).map(([el]) => (el as Element).className || (el as Element).nodeName);\n   270\t    });\n   271\t    expect(left).toEqual([]);\n   272\t    expect(await closePage(page)).toEqual([]);\n   273\t  });\n   274\t});\n   275\t\n   276\tdescribe('the tooltip stays clear of the pointer and the click meant for the plot (I1, WCAG 1.4.13)', () => {\n   277\t  it('between two points the floating tooltip does not contain the pointer, and a click there selects', async () => {\n   278\t    const page = await chartPage();\n   279\t    await create(page, 'line', { title: 'E', data: Array.from({ length: 20 }, (_, i) => ({ x: i, y: i })), x: 'x', y: 'y' });\n   280\t    await page.evaluate(() => { (window as unknown as { selected: unknown[] }).selected = []; window.charts[0]!.on('select', p => (window as unknown 