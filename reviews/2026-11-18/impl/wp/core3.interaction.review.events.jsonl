179\t}\n   180\t\n   181\tfunction seriesIndex(view: View, ref: DatumRef): number {\n   182\t  if (view.kind === 'donut') return -1;\n   183\t  if (ref.kind === 'slice') return -1;\n   184\t  return view.frame.series.findIndex(s => s.key === ref.seriesKey);\n   185\t}\n   186\t\n   187\t/** Cursor rule, highlighted points or bar and slice outlines, and the keyboard focus ring (contracts: Overlay). */\n   188\texport function buildOverlay(input: OverlayInput): Overlay | null {\n   189\t  const { view, layout, lookup, target, ring, only } = input;\n   190\t  if (layout.kind !== 'plot' || (target === null && ring === null)) return null;\n   191\t  const plot = layout.plot;\n   192\t  const clipped: Mark[] = [];\n   193\t  const unclipped: Mark[] = [];\n   194\t  const projection = layout.projection;\n   195\t\n   196\t  if (target?.kind === 'x' && view.kind !== 'donut' && view.kind !== 'scatter') {\n   197\t    const refs = only ? [only] : refsAt(view, target.x);\n   198\t    const scale = projection.kind === 'xy' ? projection.x : projection.kind === 'bands' ? projection.band : null;\n   199\t    if (scale) {\n   200\t      const at = scale.type === 'band' ? scale.center(target.x) : scale.map(target.x);\n   201\t      const across = projection.kind === 'bands' && projection.horizontal;\n   202\t      if (Number.isFinite(at)) {\n   203\t        clipped.push(across ? rule(plot.x, at, plot.x + plot.width, at, 'axis', 1) : rule(at, plot.y, at, plot.y + plot.height, 'axis', 1));\n   204\t      }\n   205\t    }\n   206\t    for (const ref of refs) {\n   207\t      const box = lookup.anchor(ref);\n   208\t      if (!box) continue;\n   209\t      if (projection.kind === 'bands') {\n   210\t        unclipped.push(...outline(box, 1, 'text', 2));\n   211\t      } else {\n   212\t        const s = seriesIndex(view, ref);\n   213\t        const cue = view.cues[s];\n   214\t        const xy = Float32Array.of(box.x + box.width / 2, box.y + box.height / 2);\n   215\t        const shap