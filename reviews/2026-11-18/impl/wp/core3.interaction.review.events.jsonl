{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/test/browser/chart/review2.browser.test.ts | sed -n '1,370p'\"","aggregated_output":"     1\t/**\n     2\t * The findings of the interaction and accessibility review (reviews/2026-11-18/impl/wp/core2.review.md), in\n     3\t * real Chrome against the built bundle, plus the defects other agents reported against the first fix pass.\n     4\t * Accessibility outcomes are read from Chrome's own accessibility tree (CDP) where Chrome exposes them; Chrome\n     5\t * does not report `aria-valuetext` there (its \"valuetext\" property is the number), so value text is read\n     6\t * from the attribute the tree is built from and says so.\n     7\t */\n     8\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     9\timport type { Page } from 'playwright-core';\n    10\timport { start, stop } from '../harness';\n    11\timport { chartPage, closePage } from './util';\n    12\t\n    13\tbeforeAll(start);\n    14\tafterAll(stop);\n    15\t\n    16\tinterface Ax { role: string; name: string; value: string; min: number | null; max: number | null; roledescription: string | null; focused: boolean }\n    17\t\n    18\t/** Chrome's accessibility node for the first element matching `selector`. */\n    19\tasync function ax(page: Page, selector: string): Promise<Ax> {\n    20\t  const client = await page.context().newCDPSession(page);\n    21\t  try {\n    22\t    const { root } = await client.send('DOM.getDocument', { depth: 0 });\n    23\t    const { nodeId } = await client.send('DOM.querySelector', { nodeId: root.nodeId, selector });\n    24\t    const { node } = await client.send('DOM.describeNode', { nodeId });\n    25\t    const { nodes } = await client.send('Accessibility.getPartialAXTree', { backendNodeId: node.backendNodeId, fetchRelatives: false });\n    26\t    const n = nodes[0]!;\n    27\t    const prop = (name: string) => n.properties?.find(p => p.name === name)?.value?.value as unknown;\n    28\t    const num = (v: unknown) => typeof v === 'number' ? v : null;\n    29\t    return {\n    30\t      role: String(n.role?.value ?? ''), name: String(n.name?.value ?? ''), value: String(n.value?.value ?? ''),\n    31\t      min: num(prop('valuemin')), max: num(prop('valuemax')),\n    32\t      roledescription: prop('roledescription') === undefined ? null : String(prop('roledescription')), focused: prop('focused') === true,\n    33\t    };\n    34\t  } finally {\n    35\t    await client.detach();\n    36\t  }\n    37\t}\n    38\t\n    39\tconst valueText = (page: Page) => page.locator('#chart .axylo-proxy').getAttribute('aria-valuetext');\n    40\tconst settle = (page: Page) => page.evaluate(async () => { for (const c of window.charts) await c.__bench.ready(); await window.nextFrames(2); });\n    41\tconst focusedClass = (page: Page) => page.evaluate(() => (document.activeElement as HTMLElement | null)?.className ?? '');\n    42\tconst button = (page: Page, text: string) => page.locator('#chart button', { hasText: text });\n    43\t\n    44\tasync function create(page: Page, kind: string, options: Record<string, unknown>): Promise<void> {\n    45\t  await page.evaluate(async ({ kind, options }) => {\n    46\t    const chart = window.Axylo[kind]!('#chart', options);\n    47\t    window.charts.push(chart);\n    48\t    await chart.__bench.ready();\n    49\t    await window.nextFrames(1);\n    50\t  }, { kind, options });\n    51\t}\n    52\t\n    53\tdescribe('finding 1: paused charts validate every call at once and apply them in call order', () => {\n    54\t  it('rows appended while paused do not come back after update({ data }); resume shows the replacement and what came after it', async () => {\n    55\t    const page = await chartPage();\n    56\t    await create(page, 'scatter', { title: 'P', data: [{ x: 1, y: 1 }], x: 'x', y: 'y' });\n    57\t    await page.evaluate(() => window.charts[0]!.append([{ x: 2, y: 2 }]));\n    58\t    await settle(page);\n    59\t    await button(page, 'Pause').click();\n    60\t    const result = await page.evaluate(async () => {\n    61\t      const chart = window.charts[0]!;\n    62\t      chart.append([{ x: 3, y: 3 }]);\n    63\t      chart.update({ data: [{ x: 10, y: 1 }, { x: 11, y: 2 }] });\n    64\t      chart.append([{ x: 12, y: 3 }]);\n    65\t      chart.zoom([10, 12]);\n    66\t      await chart.__bench.ready();\n    67\t      return chart.__bench.describe().series[0];\n    68\t    });\n    69\t    await button(page, 'Resume').click();\n    70\t    await settle(page);\n    71\t    const after = await page.evaluate(() => window.charts[0]!.__bench.describe().series[0]);\n    72\t    expect(result).toBeTruthy();\n    73\t    expect(after).toMatchObject({ points: 3, oldestX: 10, newestX: 12 });\n    74\t    expect(await closePage(page)).toEqual([]);\n    75\t  });\n    76\t\n    77\t  it('a strict chart rejects an invalid paused append at the call; valid batches before and after it survive resume', async () => {\n    78\t    const page = await chartPage();\n    79\t    await create(page, 'scatter', { title: 'P', strict: true, data: [{ x: 1, y: 1 }], x: 'x', y: 'y' });\n    80\t    await page.evaluate(() => window.charts[0]!.append([{ x: 2, y: 2 }]));\n    81\t    await settle(page);\n    82\t    await button(page, 'Pause').click();\n    83\t    const thrown = await page.evaluate(() => {\n    84\t      const chart = window.charts[0]!;\n    85\t      chart.append([{ x: 3, y: 3 }]);\n    86\t      let error = '';\n    87\t      try { chart.append([{ x: 4, y: NaN }]); } catch (e) { error = String(e); }\n    88\t      chart.append([{ x: 5, y: 5 }]);\n    89\t      return error;\n    90\t    });\n    91\t    await button(page, 'Resume').click();\n    92\t    await settle(page);\n    93\t    const s = await page.evaluate(() => window.charts[0]!.__bench.describe().series[0]!);\n    94\t    expect(thrown).toMatch(/AX103/);\n    95\t    expect([s.points, s.oldestX, s.newestX]).toEqual([4, 1, 5]);\n    96\t    expect(await closePage(page)).toEqual([]);\n    97\t  });\n    98\t\n    99\t  it('a rejected strict update({ data }) while paused keeps the rows held back', async () => {\n   100\t    const page = await chartPage();\n   101\t    await create(page, 'line', { title: 'P', strict: true, data: [{ x: 1, y: 1 }], x: 'x', y: 'y' });\n   102\t    await page.evaluate(() => window.charts[0]!.append([{ x: 2, y: 2 }]));\n   103\t    await settle(page);\n   104\t    await button(page, 'Pause').click();\n   105\t    await page.evaluate(() => {\n   106\t      const chart = window.charts[0]!;\n   107\t      chart.append([{ x: 3, y: 3 }]);\n   108\t      try { chart.update({ data: [{ x: 1, y: 'bad' }] }); } catch { /* rejected */ }\n   109\t    });\n   110\t    await button(page, 'Resume').click();\n   111\t    await settle(page);\n   112\t    const s = await page.evaluate(() => window.charts[0]!.__bench.describe().series[0]!);\n   113\t    expect([s.points, s.newestX]).toEqual([3, 3]);\n   114\t    expect(await closePage(page)).toEqual([]);\n   115\t  });\n   116\t});\n   117\t\n   118\tdescribe('finding 2: focus follows its datum on a sliding category window', () => {\n   119\t  const rows = ['A', 'B', 'C'].map((c, i) => ({ c, v: i }));\n   120\t\n   121\t  it('focused on B, appending D with keep 3: the control still says B and Enter selects B', async () => {\n   122\t    const page = await chartPage();\n   123\t    await create(page, 'line', { title: 'Cats', data: rows, x: 'c', y: 'v' });\n   124\t    await page.evaluate(() => { (window as unknown as { selected: unknown[] }).selected = []; window.charts[0]!.on('select', p => (window as unknown as { selected: unknown[] }).selected.push((p as { x: unknown }).x)); });\n   125\t    await page.focus('#chart .axylo-proxy');\n   126\t    await page.keyboard.press('ArrowRight');\n   127\t    expect(await valueText(page)).toMatch(/^B\\./);\n   128\t    await page.evaluate(() => window.charts[0]!.append([{ c: 'D', v: 3 }], { keep: 3 }));\n   129\t    await settle(page);\n   130\t    expect(await valueText(page)).toMatch(/^B\\./);\n   131\t    await page.keyboard.press('Enter');\n   132\t    expect(await page.evaluate(() => (window as unknown as { selected: unknown[] }).selected)).toEqual(['B']);\n   133\t    expect(await closePage(page)).toEqual([]);\n   134\t  });\n   135\t\n   136\t  it('focused on A, which the window evicts: the control moves to B by the lookup rule and says so', async () => {\n   137\t    const page = await chartPage();\n   138\t    await create(page, 'line', { title: 'Cats', data: rows, x: 'c', y: 'v' });\n   139\t    await page.focus('#chart .axylo-proxy');\n   140\t    expect(await valueText(page)).toMatch(/^A\\./);\n   141\t    await page.evaluate(() => window.charts[0]!.append([{ c: 'D', v: 3 }], { keep: 3 }));\n   142\t    await settle(page);\n   143\t    expect(await valueText(page)).toMatch(/^B\\. .*Point 1 of 3$/);\n   144\t    expect(await closePage(page)).toEqual([]);\n   145\t  });\n   146\t});\n   147\t\n   148\tdescribe('finding 3: a zoom into an empty stretch keeps its way back', () => {\n   149\t  const xs = [0, 1, 3, 4, 96, 98, 99, 100];\n   150\t  const options = { title: 'Gap', data: xs.map(x => ({ x, y: x })), x: 'x', y: 'y' };\n   151\t\n   152\t  it('a zoom into [25, 75] shows the empty state, keeps focus on the plot, and \"0\" returns to everything', async () => {\n   153\t    const page = await chartPage();\n   154\t    await create(page, 'line', options);\n   155\t    await page.focus('#chart .axylo-proxy');\n   156\t    // The reviewer's window: one centred halving of [0, 100] (the toolbar's Zoom in with no datum chosen).\n   157\t    await page.evaluate(() => window.charts[0]!.zoom([25, 75]));\n   158\t    await settle(page);\n   159\t    expect(await page.evaluate(() => window.charts[0]!.__bench.describe().xDomain)).toEqual([25, 75]);\n   160\t    expect(await page.locator('#chart .axylo-message').textContent()).toBe('No data to show.');\n   161\t    expect(await focusedClass(page)).toContain('axylo-proxy');\n   162\t    expect(await button(page, 'Reset zoom').count()).toBe(1);\n   163\t    expect(await button(page, 'Zoom out').count()).toBe(1);\n   164\t    expect(await valueText(page)).toBe('No data to show.');\n   165\t    await page.keyboard.press('0');\n   166\t    await settle(page);\n   167\t    expect(await page.evaluate(() => window.charts[0]!.__bench.describe().xDomain)).toEqual([0, 100]);\n   168\t    expect(await focusedClass(page)).toContain('axylo-proxy');\n   169\t    expect(await closePage(page)).toEqual([]);\n   170\t  });\n   171\t\n   172\t  it('the Reset control returns to everything from the empty window', async () => {\n   173\t    const page = await chartPage();\n   174\t    await create(page, 'line', options);\n   175\t    await button(page, 'Zoom in').click();\n   176\t    await settle(page);\n   177\t    await button(page, 'Reset zoom').click();\n   178\t    await settle(page);\n   179\t    expect(await page.evaluate(() => window.charts[0]!.__bench.describe().xDomain)).toEqual([0, 100]);\n   180\t    expect(await page.locator('#chart .axylo-message').isHidden()).toBe(true);\n   181\t    expect(await closePage(page)).toEqual([]);\n   182\t  });\n   183\t\n   184\t  it('an all-zero donut keeps its legend and the table control; a paused stream that is empty keeps Resume', async () => {\n   185\t    const page = await chartPage();\n   186\t    await create(page, 'donut', { title: 'Zero', data: [{ l: 'a', v: 0 }, { l: 'b', v: 0 }], label: 'l', value: 'v' });\n   187\t    const legend = await page.locator('#chart ul.axylo-legend-list > li').allTextContents();\n   188\t    expect(legend.length).toBe(2);\n   189\t    expect(await button(page, 'View as table').count()).toBe(1);\n   190\t    await page.evaluate(async () => { window.charts.pop()!.destroy(); });\n   191\t    await create(page, 'line', { title: 'S', data: [{ x: 1, y: 1 }], x: 'x', y: 'y' });\n   192\t    await page.evaluate(() => window.charts[0]!.append([{ x: 2, y: 2 }]));\n   193\t    await settle(page);\n   194\t    await button(page, 'Pause').click();\n   195\t    await page.evaluate(() => window.charts[0]!.update({ data: [] }));\n   196\t    await settle(page);\n   197\t    expect(await button(page, 'Resume').count()).toBe(1);\n   198\t    expect(await closePage(page)).toEqual([]);\n   199\t  });\n   200\t});\n   201\t\n   202\tdescribe('finding 4: the focused range matches each displayed revision', () => {\n   203\t  it('focused on a one-point chart, an append raises the maximum and updates the position text', async () => {\n   204\t    const page = await chartPage();\n   205\t    await create(page, 'line', { title: 'One', data: [{ x: 1, y: 1 }], x: 'x', y: 'y' });\n   206\t    await page.focus('#chart .axylo-proxy');\n   207\t    expect((await ax(page, '#chart .axylo-proxy')).max).toBe(0);\n   208\t    await page.evaluate(() => window.charts[0]!.append([{ x: 2, y: 2 }]));\n   209\t    await settle(page);\n   210\t    const node = await ax(page, '#chart .axylo-proxy');\n   211\t    expect([node.min, node.max, node.value, node.focused]).toEqual([0, 1, '0', true]);\n   212\t    expect(await valueText(page)).toMatch(/Point 1 of 2$/);\n   213\t    expect(await closePage(page)).toEqual([]);\n   214\t  });\n   215\t\n   216\t  it('a locale or unit change under the focused range rewrites its text', async () => {\n   217\t    const page = await chartPage();\n   218\t    await create(page, 'line', { title: 'U', data: [{ x: 1, y: 1500 }, { x: 2, y: 2 }], x: 'x', y: { field: 'y', unit: 'ms' } });\n   219\t    await page.focus('#chart .axylo-proxy');\n   220\t    expect(await valueText(page)).toContain('1,500 ms');\n   221\t    await page.evaluate(() => window.charts[0]!.update({ y: { field: 'y', unit: 's' }, locale: 'de-DE' }));\n   222\t    await settle(page);\n   223\t    expect(await valueText(page)).toContain('1.500