{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/table.ts && nl -ba packages/axylo/src/dom/toolbar.ts'","aggregated_output":"     1\t/**\n     2\t * \"View as table\" (spec A4): built only when opened, from the reader model's lazy table, and destroyed when\n     3\t * closed. A real table (caption, column headers with units, x values as row headers) inside a focusable,\n     4\t * labelled scroll region no taller than the plot, 100 rows per page, with a pager and a \"go to\" field that\n     5\t * jumps to the page holding an x value. Text only, never HTML.\n     6\t */\n     7\timport type { TableModel, XValue } from '../core/contracts';\n     8\t\n     9\texport interface TableTexts {\n    10\t  readonly previousPage: string;\n    11\t  readonly nextPage: string;\n    12\t  /** \"Page {page} of {count}\" filled. */\n    13\t  pageOf(page: number, count: number): string;\n    14\t  /** Label of the \"go to\" field. */\n    15\t  readonly jump: string;\n    16\t  /** `lang` for each built-in string, or null. */\n    17\t  readonly lang: (key: 'previousPage' | 'nextPage' | 'pageOf' | 'jumpToX') => string | null;\n    18\t}\n    19\t\n    20\texport interface TableView {\n    21\t  readonly element: HTMLElement;\n    22\t  /** A new model (the data or the view changed): the current page is shown again from it. */\n    23\t  update(model: TableModel, texts: TableTexts, maxHeight: number): void;\n    24\t  /** Shows the page holding row `ordinal`. */\n    25\t  showRow(ordinal: number): void;\n    26\t  readonly page: number;\n    27\t  destroy(): void;\n    28\t}\n    29\t\n    30\tfunction setAttr(el: Element, name: string, value: string | null): void {\n    31\t  if (value === null) el.removeAttribute(name);\n    32\t  else if (el.getAttribute(name) !== value) el.setAttribute(name, value);\n    33\t}\n    34\t\n    35\t/**\n    36\t * `toValue` turns what the reader typed into an x value the model understands (a number on a number axis,\n    37\t * the text otherwise).\n    38\t */\n    39\texport function createTableView(doc: Document, id: string, toValue: (text: string) => XValue | null): TableView {\n    40\t  const element = doc.createElement('div');\n    41\t  element.className = 'axylo-table';\n    42\t  const listening = new AbortController();\n    43\t  const signal = listening.signal;\n    44\t  element.id = `${id}-table`;\n    45\t  const scroll = doc.createElement('div');\n    46\t  scroll.className = 'axylo-table-scroll';\n    47\t  scroll.setAttribute('role', 'region');\n    48\t  scroll.tabIndex = 0;\n    49\t  const table = doc.createElement('table');\n    50\t  const caption = doc.createElement('caption');\n    51\t  caption.id = `${id}-table-caption`;\n    52\t  scroll.setAttribute('aria-labelledby', caption.id);\n    53\t  const head = doc.createElement('thead');\n    54\t  const body = doc.createElement('tbody');\n    55\t  table.append(caption, head, body);\n    56\t  scroll.appendChild(table);\n    57\t\n    58\t  const pager = doc.createElement('div');\n    59\t  pager.className = 'axylo-pager';\n    60\t  const previous = doc.createElement('button');\n    61\t  previous.type = 'button';\n    62\t  previous.className = 'axylo-control';\n    63\t  const status = doc.createElement('span');\n    64\t  status.className = 'axylo-page';\n    65\t  // The reader moved: saying the new page is an answer to their own action (spec A7).\n    66\t  status.setAttribute('aria-live', 'polite');\n    67\t  const next = doc.createElement('button');\n    68\t  next.type = 'button';\n    69\t  next.className = 'axylo-control';\n    70\t  const form = doc.createElement('form');\n    71\t  form.className = 'axylo-jump';\n    72\t  const label = doc.createElement('label');\n    73\t  const labelText = doc.createElement('span');\n    74\t  const field = doc.createElement('input');\n    75\t  field.type = 'text';\n    76\t  field.id = `${id}-table-jump`;\n    77\t  field.className = 'axylo-jump-field';\n    78\t  field.autocomplete = 'off';\n    79\t  label.htmlFor = field.id;\n    80\t  label.appendChild(labelText);\n    81\t  form.append(label, field);\n    82\t  pager.append(previous, status, next, form);\n    83\t  element.append(scroll, pager);\n    84\t\n    85\t  let model: TableModel | null = null;\n    86\t  let texts: TableTexts | null = null;\n    87\t  let page = 0;\n    88\t  let shownSignature = '';\n    89\t\n    90\t  const pages = () => model ? Math.max(1, Math.ceil(model.rowCount / model.pageSize)) : 1;\n    91\t\n    92\t  /**\n    93\t   * `reader`: the reader paged or jumped, so the new page is spoken. A render for new data keeps the status\n    94\t   * region quiet while its count changes (spec A7; review 2, finding 16).\n    95\t   */\n    96\t  function render(reader = false): void {\n    97\t    if (!model || !texts) return;\n    98\t    const count = pages();\n    99\t    page = Math.max(0, Math.min(page, count - 1));\n   100\t    const headers = model.headers.join('\\u0000');\n   101\t    if (caption.textContent !== model.caption) caption.textContent = model.caption;\n   102\t    if (head.dataset.headers !== headers) {\n   103\t      const row = doc.createElement('tr');\n   104\t      for (const text of model.headers) {\n   105\t        const th = doc.createElement('th');\n   106\t        th.scope = 'col';\n   107\t        th.textContent = text;\n   108\t        row.appendChild(th);\n   109\t      }\n   110\t      head.replaceChildren(row);\n   111\t      head.dataset.headers = headers;\n   112\t    }\n   113\t    const first = page * model.pageSize;\n   114\t    const last = Math.min(model.rowCount, first + model.pageSize);\n   115\t    const rows: HTMLTableRowElement[] = [];\n   116\t    for (let i = first; i < last; i++) {\n   117\t      const cells = model.row(i);\n   118\t      if (!cells) continue;\n   119\t      const tr = doc.createElement('tr');\n   120\t      cells.forEach((text, k) => {\n   121\t        const cell = doc.createElement(k === 0 ? 'th' : 'td');\n   122\t        if (k === 0) (cell as HTMLTableCellElement).scope = 'row';\n   123\t        cell.textContent = text;\n   124\t        tr.appendChild(cell);\n   125\t      });\n   126\t      rows.push(tr);\n   127\t    }\n   128\t    body.replaceChildren(...rows);\n   129\t    // A pager the reader is on does not vanish under them: focus goes to the table first (finding 17).\n   130\t    if (count <= 1 && pager.contains(doc.activeElement)) scroll.focus({ preventScroll: true });\n   131\t    pager.hidden = count <= 1;\n   132\t    previous.textContent = texts.previousPage;\n   133\t    next.textContent = texts.nextPage;\n   134\t    setAttr(previous, 'lang', texts.lang('previousPage'));\n   135\t    setAttr(next, 'lang', texts.lang('nextPage'));\n   136\t    setAttr(status, 'lang', texts.lang('pageOf'));\n   137\t    setAttr(label, 'lang', texts.lang('jumpToX'));\n   138\t    setAttr(previous, 'aria-disabled', page === 0 ? 'true' : null);\n   139\t    setAttr(next, 'aria-disabled', page >= count - 1 ? 'true' : null);\n   140\t    const pageText = texts.pageOf(page + 1, count);\n   141\t    if (status.textContent !== pageText) {\n   142\t      setAttr(status, 'aria-live', reader ? 'polite' : 'off');\n   143\t      status.textContent = pageText;\n   144\t    }\n   145\t    labelText.textContent = texts.jump;\n   146\t  }\n   147\t\n   148\t  previous.addEventListener('click', () => {\n   149\t    if (page > 0) { page--; render(true); scroll.scrollTop = 0; }\n   150\t  }, { signal });\n   151\t  next.addEventListener('click', () => {\n   152\t    if (page < pages() - 1) { page++; render(true); scroll.scrollTop = 0; }\n   153\t  }, { signal });\n   154\t  form.addEventListener('submit', event => {\n   155\t    event.preventDefault();\n   156\t    const value = toValue(field.value.trim());\n   157\t    const target = value === null || !model ? null : model.pageForX(value);\n   158\t    if (target === null) {\n   159\t      field.setAttribute('aria-invalid', 'true');\n   160\t      return;\n   161\t    }\n   162\t    field.removeAttribute('aria-invalid');\n   163\t    page = target;\n   164\t    render(true);\n   165\t    scroll.scrollTop = 0;\n   166\t  }, { signal });\n   167\t\n   168\t  return {\n   169\t    element,\n   170\t    get page() {\n   171\t      return page;\n   172\t    },\n   173\t    update(nextModel, nextTexts, maxHeight) {\n   174\t      const signature = `${maxHeight}`;\n   175\t      model = nextModel;\n   176\t      texts = nextTexts;\n   177\t      // The table fills the plot's place (its stylesheet); the height is only a ceiling for the scroll region.\n   178\t      if (signature !== shownSignature) {\n   179\t        scroll.style.maxHeight = maxHeight > 0 ? `${Math.floor(maxHeight)}px` : '';\n   180\t        shownSignature = signature;\n   181\t      }\n   182\t      render();\n   183\t    },\n   184\t    showRow(ordinal) {\n   185\t      if (!model) return;\n   186\t      page = Math.floor(ordinal / model.pageSize);\n   187\t      render();\n   188\t    },\n   189\t    destroy() {\n   190\t      listening.abort();\n   191\t      element.remove();\n   192\t      model = null;\n   193\t    },\n   194\t  };\n   195\t}\n     1\t/**\n     2\t * The chart's one toolbar (spec A2, I2, I3, I4, I6): legend toggles, zoom, pause and the table control, as\n     3\t * ordinary buttons with roving focus, so the whole toolbar is a single tab stop. Arrow keys move between\n     4\t * controls, Home and End jump to the ends.\n     5\t *\n     6\t * Buttons are kept by key and updated in place, so a control the reader is on keeps focus across commits.\n     7\t * When the control that has focus goes away (Reset after resetting, Pause before any append), focus moves to\n     8\t * its neighbour instead of falling back to the page.\n     9\t */\n    10\timport { createSwatch, type SwatchSpec } from './swatch';\n    11\t\n    12\texport interface ToolbarItem {\n    13\t  readonly key: string;\n    14\t  readonly label: string;\n    15\t  /** Toggle buttons (legend entries): aria-pressed. */\n    16\t  readonly pressed?: boolean;\n    17\t  /** Disclosure buttons (the table control): aria-expanded and, while expanded, aria-controls. */\n    18\t  readonly expanded?: boolean;\n    19\t  readonly controls?: string | null;\n    20\t  readonly swatch?: SwatchSpec;\n    21\t  /** A hidden series: struck-through name, outline swatch (never dimmed text, spec L2). */\n    22\t  readonly struck?: boolean;\n    23\t  /** `lang` of the button ('en' for built-in text on a page in another language), or null. */\n    24\t  readonly lang: string | null;\n    25\t  readonly className: string;\n    26\t  /** The control can do nothing now (Zoom in at the smallest window): aria-disabled, activation ignored. */\n    27\t  readonly disabled?: boolean;\n    28\t  activate(): void;\n    29\t}\n    30\t\n    31\texport interface Toolbar {\n    32\t  readonly element: HTMLElement;\n    33\t  render(items: readonly ToolbarItem[], label: string, lang: string | null): void;\n    34\t  /** Moves focus to the control with this key; false when there is none. */\n    35\t  focus(key: string): boolean;\n    36\t  destroy(): void;\n    37\t}\n    38\t\n    39\tfunction setAttr(el: Element, name: string, value: string | null): void {\n    40\t  if (value === null) {\n    41\t    if (el.hasAttribute(name)) el.removeAttribute(name);\n    42\t  } else if (el.getAttribute(name) !== value) {\n    43\t    el.setAttribute(name, value);\n    44\t  }\n    45\t}\n    46\t\n    47\texport function createToolbar(doc: Document): Toolbar {\n    48\t  const element = doc.createElement('div');\n    49\t  element.className = 'axylo-toolbar';\n    50\t  element.setAttribute('role', 'toolbar');\n    51\t  // Every listener of the toolbar and its buttons goes with destroy (review 2: none left on removed elements).\n    52\t  const listening = new AbortController();\n    53\t  const signal = listening.signal;\n    54\t  const buttons = new Map<string, { button: HTMLButtonElement; item: ToolbarItem; signature: string }>();\n    55\t  let current: string | null = null;\n    56\t  let order: string[] = [];\n    57\t\n    58\t  function setCurrent(key: string | null): void {\n    59\t    current = key;\n    60\t    for (const [k, { button }] of buttons) button.tabIndex = k === current ? 0 : -1;\n    61\t  }\n    62\t\n    63\t  function move(to: number): void {\n    64\t    if (!order.length) return;\n    65\t    const key = order[(to + order.length) % order.length]!;\n    66\t    setCurrent(key);\n    67\t    buttons.get(key)!.button.focus();\n    68\t  }\n    69\t\n    70\t  element.addEventListener('keydown', (event: KeyboardEvent) => {\n    71\t    if (event.altKey || event.ctrlKey || event.metaKey) return;\n    72\t    const at = current === null ? -1 : order.indexOf(current);\n    73\t    switch (event.key) {\n    74\t      case 'ArrowRight': case 'ArrowDown': move(at + 1); break;\n    75\t      case 'ArrowLeft': case 'ArrowUp': move(at - 1); break;\n    76\t      case 'Home': move(0); break;\n    77\t      case 'End': move(order.length - 1); break;\n    78\t      default: return;\n    79\t    }\n    80\t    event.preventDefault();\n    81\t  }, { signal });\n    82\t  element.addEventListener('focusin', (event: FocusEvent) => {\n    83\t    for (const [key, { button }] of buttons) if (button === event.target) setCurrent(key);\n    84\t  }, { signal });\n    85\t\n    86\t  function fill(button: HTMLButtonElement, item: ToolbarItem): void {\n    87\t    const children: Node[] = [];\n    88\t    if (item.swatch) children.push(createSwatch(doc, item.swatch));\n    89\t    const text = doc.createElement('span');\n    90\t    text.className = 'axylo-control-label';\n    91\t    text.textContent = item.label;\n    92\t    children.push(text);\n    93\t    button.replaceChildren(...children);\n    94\t  }\n    95\t\n    96\t  return {\n    97\t    element,\n    98\t    render(items, label, lang) {\n    99\t      setAttr(element, 'aria-label', label);\n   100\t      setAttr(element, 'lang', lang);\n   101\t      const focused = doc.activeElement;\n   102\t      let focusedKey: string | null = null;\n   103\t      for (const [key, { button }] of buttons) if (button === focused) focusedKey = key;\n   104\t      const keys = items.map(i => i.key);\n   105\t      // Where a focused control that is going away hands focus: the control now at its place, or the last.\n   106\t      let heir: string | null = null;\n   107\t      if (focusedKey !== null && !keys.includes(focusedKey)) {\n   108\t        const was = order.indexOf(focusedKey);\n   109\t        const after = order.slice(was + 1).find(k => keys.includes(k));\n   110\t        const before = order.slice(0, was).reverse().find(k => keys.includes(k));\n   111\t        heir = after ?? before ?? keys[0] ?? null;\n   112\t      }\n   113\t      for (const [key, entry] of buttons) {\n   114\t        if (!keys.includes(key)) {\n   115\t          entry.button.remove();\n   116\t          buttons.delete(key);\n   117\t        }\n   118\t      }\n   119\t      let previous: HTMLButtonElement | null = null;\n   120\t      for (const item of items) {\n   121\t        let entry = buttons.get(item.key);\n   122\t        if (!entry) {\n   123\t          const button = doc.createElement('button');\n   124\t          button.type = 'button';\n   125\t          button.addEventListener('click', () => {\n   126\t            const current = buttons.get(item.key)?.item;\n   127\t            if (current && !current.disabled) current.activate();\n   128\t          }, { signal });\n   129\t          entry = { button, item, signature: '' };\n   130\t          buttons.set(item.key, entry);\n   131\t        }\n   132\t        entry.item = item;\n   133\t        const { button } = entry;\n   134\t        const signature = JSON.stringify([item.label, item.swatch, item.struck]);\n   135\t        if (signature !== entry.signature) {\n   136\t          fill(button, item);\n   137\t          entry.signature = signature;\n   138\t        }\n   139\t        if (button.className !== item.className) button.className = item.className;\n   140\t        button.classList.toggle('axylo-struck', item.struck === true);\n   141\t        setAttr(button, 'aria-pressed', item.pressed === undefined ? null : String(item.pressed));\n   142\t        setAttr(button, 'aria-expanded', item.expanded === undefined ? null : String(item.expanded));\n   143\t        setAttr(button, 'aria-controls', item.expanded ? item.controls ?? null : null);\n   144\t        setAttr(button, 'lang', item.lang);\n   145\t        setAttr(button, 'aria-disabled', item.disabled ? 'true' : null);\n   146\t        const place: ChildNode | null = previous ? previous.nextSibling : element.firstChild;\n   147\t        if (place !== button) element.insertBefore(button, place);\n   148\t        previous = button;\n   149\t      }\n   150\t      order = keys;\n   151\t      const keep = heir ?? (current !== null && keys.includes(current) ? current : keys[0] ?? null);\n   152\t      setCurrent(keep);\n   153\t      if (heir !== null) buttons.get(heir)!.button.focus();\n   154\t      // A reorder moves the focused button, which can drop focus: it is given back (review 2, finding 17).\n   155\t      else if (focusedKey !== null && doc.activeElement !== buttons.get(focusedKey)?.button) buttons.get(focusedKey)?.button.focus();\n   156\t    },\n   157\t    focus(key) {\n   158\t      const entry = buttons.get(key);\n   159\t      if (!entry) return false;\n   160\t      entry.button.focus();\n   161\t      return doc.activeElement === entry.button;\n   162\t    },\n   163\t    destroy() {\n   164\t      listening.abort();\n   165\t      element.remove();\n   166\t      buttons.clear();\n   167\t    },\n   168\t  };\n   169\t}\n","exit_code":0,"status":"completed"}}
