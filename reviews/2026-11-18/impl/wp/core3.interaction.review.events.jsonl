{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/a11y/util.ts'","aggregated_output":"     1\t/**\n     2\t * Shared setup for the accessibility and interaction tests: the fixture charts by name, Chrome's own\n     3\t * accessibility node for an element (through the DevTools protocol, so value text and role description are\n     4\t * what Chrome exposes, not a re-computation), axe-core, and the tab order.\n     5\t */\n     6\timport type { Page } from 'playwright-core';\n     7\timport path from 'node:path';\n     8\timport fs from 'node:fs';\n     9\timport { chartPage } from '../chart/util';\n    10\t\n    11\texport type FixtureName = 'trend' | 'bars' | 'parts' | 'scatter' | 'stacked' | 'dirty' | 'empty' | 'loading' | 'error' | 'compact';\n    12\texport const FIXTURES: readonly FixtureName[] = ['trend', 'bars', 'parts', 'scatter', 'stacked', 'dirty', 'empty', 'loading', 'error', 'compact'];\n    13\t\n    14\tdeclare global {\n    15\t  interface Window {\n    16\t    make(name: FixtureName, target: string | HTMLElement, extra?: Record<string, unknown>): import('../chart/util').ChartLike;\n    17\t  }\n    18\t}\n    19\t\n    20\t/** Runs in the page: builds a fixture chart. The trend fixture's x is UTC instants, as the Phase 1 harness has it. */\n    21\tfunction installMakers(): void {\n    22\t  const fx = window.fx;\n    23\t  const A = window.Axylo;\n    24\t  const trend = (extra: Record<string, unknown>) => ({\n    25\t    title: fx.trend.title, data: fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' },\n    26\t    y: { field: 'sessions', label: fx.trend.yTitle }, series: 'channel', ...extra,\n    27\t  });\n    28\t  window.make = (name, target, extra = {}) => {\n    29\t    switch (name) {\n    30\t      case 'trend': return A.line!(target, trend(extra));\n    31\t      case 'stacked': return A.area!(target, { ...trend(extra), title: 'Sessions, stacked', stacked: true });\n    32\t      case 'bars': return A.bar!(target, {\n    33\t        title: fx.bars.title, data: fx.bars.categories.map((team, i) => ({ team, satisfied: fx.bars.values[i] })),\n    34\t        x: 'team', y: { field: 'satisfied', label: 'Satisfied', scale: 'percent' }, reference: [{ y: 90, label: 'Target' }], ...extra,\n    35\t      });\n    36\t      case 'parts': return A.donut!(target, {\n    37\t        title: fx.parts.title, data: fx.parts.labels.map((browser, i) => ({ browser, share: fx.parts.values[i] })),\n    38\t        label: 'browser', value: { field: 'share', label: 'Share', scale: 'percent' }, ...extra,\n    39\t      });\n    40\t      case 'scatter': {\n    41\t        const r = fx.rng(3);\n    42\t        const data = Array.from({ length: 300 }, (_, i) => {\n    43\t          const size = 10 + r() * 990;\n    44\t          return { size: Math.round(size), latency: Math.round(20 + size * 0.08 + (r() - 0.5) * 40), region: ['EU', 'US', 'APAC'][i % 3] };\n    45\t        });\n    46\t        return A.scatter!(target, { title: 'Latency by payload size', data, x: { field: 'size', label: 'Payload', unit: 'kB' }, y: { field: 'latency', label: 'Latency', unit: 'ms' }, series: 'region', ...extra });\n    47\t      }\n    48\t      case 'dirty': return A.line!(target, { title: 'Dirty input', data: fx.dirtyRows(), x: 'day', y: 'value', ...extra });\n    49\t      case 'empty': return A.line!(target, { title: 'No rows returned', data: [], x: 'day', y: 'sessions', ...extra });\n    50\t      case 'loading': return A.line!(target, { title: 'Loading', state: 'loading', data: [], x: 'day', y: 'sessions', ...extra });\n    51\t      case 'error': return A.line!(target, { title: 'Failed', state: { error: 'The query failed.' }, data: [], x: 'day', y: 'sessions', ...extra });\n    52\t      case 'compact': return A.line!(target, { compact: true, title: 'Direct sessions', data: fx.trendRows().filter(r => r.channel === 'Direct'), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', ...extra });\n    53\t    }\n    54\t  };\n    55\t}\n    56\t\n    57\texport async function fixturePage(options: Parameters<typeof chartPage>[0] = {}): Promise<Page> {\n    58\t  const page = await chartPage(options);\n    59\t  await page.evaluate(installMakers);\n    60\t  return page;\n    61\t}\n    62\t\n    63\t/** Builds a fixture in #chart (or `target`) and waits for its first frame. */\n    64\texport async function make(page: Page, name: FixtureName, extra: Record<string, unknown> = {}, target = '#chart'): Promise<void> {\n    65\t  await page.evaluate(async ({ name, extra, target }) => {\n    66\t    const chart = window.make(name, target, extra);\n    67\t    window.charts.push(chart);\n    68\t    await chart.__bench.ready();\n    69\t    await window.nextFrames(1);\n    70\t  }, { name, extra, target });\n    71\t}\n    72\t\n    73\texport interface AxNode {\n    74\t  role: string;\n    75\t  name: string;\n    76\t  /** The range's value as Chrome exposes it (the ordinal). */\n    77\t  value: string;\n    78\t  max: number | null;\n    79\t  roledescription: string | null;\n    80\t  focused: boolean;\n    81\t  /**\n    82\t   * The value text. Chrome's DevTools accessibility view does not report `aria-valuetext` (its \"valuetext\"\n    83\t   * property shows the number, even for an ARIA slider), so this is the attribute the platform tree is built\n    84\t   * from; whether a screen reader speaks it can only be confirmed by rehearsal (decision 0001).\n    85\t   */\n    86\t  text: string;\n    87\t}\n    88\t\n    89\t/** Chrome's accessibility node for the first element matching `selector`. */\n    90\texport async function axNode(page: Page, selector: string): Promise<AxNode> {\n    91\t  const client = await page.context().newCDPSession(page);\n    92\t  try {\n    93\t    const { root } = await client.send('DOM.getDocument', { depth: 0 });\n    94\t    const { nodeId } = await client.send('DOM.querySelector', { nodeId: root.nodeId, selector });\n    95\t    if (!nodeId) throw new Error(`no element for ${selector}`);\n    96\t    const { node } = await client.send('DOM.describeNode', { nodeId });\n    97\t    const { nodes } = await client.send('Accessibility.getPartialAXTree', { backendNodeId: node.backendNodeId, fetchRelatives: false });\n    98\t    const ax = nodes[0]!;\n    99\t    const prop = (name: string) => ax.properties?.find(p => p.name === name)?.value?.value as unknown;\n   100\t    const roledescription = prop('roledescription');\n   101\t    const max = prop('valuemax');\n   102\t    return {\n   103\t      role: String(ax.role?.value ?? ''), name: String(ax.name?.value ?? ''), value: String(ax.value?.value ?? ''),\n   104\t      max: typeof max === 'number' ? max : null,\n   105\t      roledescription: roledescription === undefined ? null : String(roledescription), focused: prop('focused') === true,\n   106\t      text: (await page.locator(selector).first().getAttribute('aria-valuetext')) ?? '',\n   107\t    };\n   108\t  } finally {\n   109\t    await client.detach();\n   110\t  }\n   111\t}\n   112\t\n   113\tconst axeSource = fs.readFileSync(path.resolve(import.meta.dirname, '../../../../../node_modules/axe-core/axe.min.js'), 'utf8');\n   114\t\n   115\texport interface AxeViolation { id: string; impact: string | null; nodes: string[]; help: string }\n   116\t\n   117\t/** axe-core over `selector` (every rule axe enables by default, best practices such as heading-order included). */\n   118\texport async function axe(page: Page, selector = 'body'): Promise<{ violations: AxeViolation[]; ran: string[]; incomplete: string[] }> {\n   119\t  if (!(await page.evaluate(() => 'axe' in window))) await page.addScriptTag({ content: axeSource });\n   120\t  return page.evaluate(async selector => {\n   121\t    type Rule = { id: string; impact: string | null; help: string; nodes: { target: string[] }[] };\n   122\t    const run = (window as unknown as { axe: { run(context: unknown, options: unknown): Promise<{ violations: Rule[]; passes: Rule[]; incomplete: Rule[] }> } }).axe;\n   123\t    const result = await run.run(selector, { resultTypes: ['violations', 'passes', 'incomplete'] });\n   124\t    return {\n   125\t      violations: result.violations.map(v => ({ id: v.id, impact: v.impact, help: v.help, nodes: v.nodes.map(n => n.target.join(' ')) })),\n   126\t      // A rule axe could not decide is not a rule that ran (review 2, finding 21): it is reported apart.\n   127\t      ran: [...result.passes, ...result.violations].map(r => r.id),\n   128\t      incomplete: result.incomplete.map(r => r.id),\n   129\t    };\n   130\t  }, selector);\n   131\t}\n   132\t\n   133\t/** What has focus, as a short description: the chart part's class or the element's id. */\n   134\texport async function focused(page: Page): Promise<string> {\n   135\t  return page.evaluate(() => {\n   136\t    const el = document.activeElement as HTMLElement | null;\n   137\t    if (!el || el === document.body) return 'body';\n   138\t    if (el.id === 'before' || el.id === 'after') return el.id;\n   139\t    if (el.classList.contains('axylo-proxy')) return 'proxy';\n   140\t    if (el.closest('.axylo-toolbar')) return 'toolbar:' + (el.textContent ?? '');\n   141\t    if (el.classList.contains('axylo-table-scroll')) return 'table';\n   142\t    return el.tagName.toLowerCase() + '.' + el.className;\n   143\t  });\n   144\t}\n   145\t\n   146\t/** Presses Tab (or Shift+Tab) from `start` until focus leaves the chart, and lists the stops. */\n   147\texport async function tabStops(page: Page, backwards = false): Promise<string[]> {\n   148\t  await page.focus(backwards ? '#after' : '#before');\n   149\t  const stops: string[] = [];\n   150\t  for (let i = 0; i < 12; i++) {\n   151\t    await page.keyboard.press(backwards ? 'Shift+Tab' : 'Tab');\n   152\t    const at = await focused(page);\n   153\t    if (at === 'before' || at === 'after' || at === 'body') return [...stops, at];\n   154\t    stops.push(at);\n   155\t  }\n   156\t  return stops;\n   157\t}\n   158\t\n   159\t/** Text contrast per WCAG 2.x from two CSS colors resolved by the page. */\n   160\texport async function contrastOf(page: Page, selector: string): Promise<number> {\n   161\t  return page.evaluate(selector => {\n   162\t    const el = document.querySelector(selector) as HTMLElement;\n   163\t    const parse = (c: string) => {\n   164\t      const probe = document.createElement('canvas').getContext('2d')!;\n   165\t      probe.fillStyle = c;\n   166\t      probe.fillRect(0, 0, 1, 1);\n   167\t      const [r, g, b] = probe.getImageData(0, 0, 1, 1).data;\n   168\t      return [r!, g!, b!];\n   169\t    };\n   170\t    const lum = ([r, g, b]: number[]) => {\n   171\t      const f = (v: number) => { const s = v / 255; return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4; };\n   172\t      return 0.2126 * f(r!) + 0.7152 * f(g!) + 0.0722 * f(b!);\n   173\t    };\n   174\t    let bgEl: HTMLElement | null = el;\n   175\t    let bg = 'rgb(255, 255, 255)';\n   176\t    while (bgEl) {\n   177\t      const c = getComputedStyle(bgEl).backgroundColor;\n   178\t      if (c && c !== 'rgba(0, 0, 0, 0)' && c !== 'transparent') { bg = c; break; }\n   179\t      bgEl = bgEl.parentElement;\n   180\t    }\n   181\t    const fg = lum(parse(getComputedStyle(el).color));\n   182\t    const back = lum(parse(bg));\n   183\t    return (Math.max(fg, back) + 0.05) / (Math.min(fg, back) + 0.05);\n   184\t  }, selector);\n   185\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/a11y/axe.browser.test.ts'","aggregated_output":"     1\t/**\n     2\t * Automated accessibility checks (spec A8, L2, A10, I5, L4): axe-core on every fixture in every state,\n     3\t * forced colors and reduced motion emulation, and built-in English marked on a page in another language.\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport type { Page } from 'playwright-core';\n     7\timport { start, stop } from '../harness';\n     8\timport { closePage } from '../chart/util';\n     9\timport { axe, FIXTURES, fixturePage, make, type FixtureName } from './util';\n    10\t\n    11\tbeforeAll(start);\n    12\tafterAll(stop);\n    13\t\n    14\t/** The chart inside a page with its own structure, as a dashboard would have it. */\n    15\tasync function structuredPage(options: Parameters<typeof fixturePage>[0] = {}): Promise<Page> {\n    16\t  const page = await fixturePage(options);\n    17\t  await page.evaluate(() => {\n    18\t    const main = document.createElement('main');\n    19\t    const h1 = Object.assign(document.createElement('h1'), { textContent: 'Dashboard' });\n    20\t    const h2 = Object.assign(document.createElement('h2'), { textContent: 'Traffic' });\n    21\t    const chart = document.getElementById('chart')!;\n    22\t    chart.replaceWith(main);\n    23\t    main.append(h1, h2, chart);\n    24\t  });\n    25\t  return page;\n    26\t}\n    27\t\n    28\tconst settle = (page: Page) => page.evaluate(async () => { for (const c of window.charts) await c.__bench.ready(); await window.nextFrames(1); });\n    29\t\n    30\ttype State = 'default' | 'table open' | 'tooltip shown' | 'series hidden';\n    31\t\n    32\tasync function enter(page: Page, state: State): Promise<boolean> {\n    33\t  if (state === 'default') return true;\n    34\t  if (state === 'table open') {\n    35\t    const toggle = page.locator('#chart .axylo-toolbar button', { hasText: 'View as table' });\n    36\t    if (!(await toggle.count())) return false;\n    37\t    await toggle.click();\n    38\t    return true;\n    39\t  }\n    40\t  if (state === 'tooltip shown') {\n    41\t    const proxy = page.locator('#chart .axylo-proxy');\n    42\t    if (!(await proxy.count()) || !(await proxy.isVisible())) return false;\n    43\t    // The keyboard shows the tooltip at a datum on every chart type, wherever its marks are.\n    44\t    await proxy.focus();\n    45\t    await page.keyboard.press('ArrowRight');\n    46\t    return page.locator('#chart .axylo-tooltip').first().isVisible();\n    47\t  }\n    48\t  const entry = page.locator('#chart .axylo-legend-entry').first();\n    49\t  if (!(await entry.count())) return false;\n    50\t  await entry.click();\n    51\t  await settle(page);\n    52\t  return true;\n    53\t}\n    54\t\n    55\tdescribe('axe-core reports no violations (spec A8)', () => {\n    56\t  for (const fixture of FIXTURES) {\n    57\t    it(`${fixture}: default, table open, tooltip shown, series hidden`, async () => {\n    58\t      const page = await structuredPage();\n    59\t      await make(page, fixture as FixtureName);\n    60\t      const report: Record<string, string[]> = {};\n    61\t      const applied: State[] = [];\n    62\t      for (const state of ['default', 'tooltip shown', 'series hidden', 'table open'] as const) {\n    63\t        if (!(await enter(page, state))) continue;\n    64\t        applied.push(state);\n    65\t        const { violations, ran } = await axe(page);\n    66\t        report[state] = violations.map(v => `${v.id}: ${v.help} (${v.nodes.join(', ')})`);\n    67\t        expect(ran).toContain('heading-order');\n    68\t        // The rule applies only where the region scrolls: the trend table's 120 rows do.\n    69\t        if (state === 'table open' && fixture === 'trend') expect(ran).toContain('scrollable-region-focusable');\n    70\t      }\n    71\t      expect(report).toEqual(Object.fromEntries(applied.map(s => [s, []])));\n    72\t      // Which states apply follows from the fixture (spec C1, L7, 3.6).\n    73\t      const interactive = ['trend', 'bars', 'parts', 'scatter', 'stacked', 'dirty'].includes(fixture);\n    74\t      expect(applied.includes('table open')).toBe(interactive);\n    75\t      expect(applied.includes('tooltip shown')).toBe(interactive);\n    76\t      expect(applied.includes('series hidden')).toBe(['trend', 'scatter', 'stacked'].includes(fixture));\n    77\t      expect(await closePage(page)).toEqual([]);\n    78\t    });\n    79\t  }\n    80\t});\n    81\t\n    82\tdescribe('axe-core in the states the fixture loop does not reach (review 2, finding 21)', () => {\n    83\t  it('trend paused, zoomed, in the narrow readout and in the internal-error state: no violations; undecided rules listed apart', async () => {\n    84\t    const page = await structuredPage({ css: '#narrow { width: 260px; height: 300px; }' });\n    85\t    await make(page, 'trend');\n    86\t    const results: Record<string, { violations: string[]; incomplete: string[] }> = {};\n    87\t    const check = async (state: string) => {\n    88\t      const { violations, ran, incomplete } = await axe(page);\n    89\t      results[state] = { violations: violations.map(v => v.id), incomplete };\n    90\t      expect(ran, state).toContain('heading-order');\n    91\t    };\n    92\t    await page.evaluate(async () => { window.charts[0]!.append([{ day: Date.UTC(2026, 4, 1), channel: 'Direct', sessions: 1 }]); await window.charts[0]!.__bench.ready(); });\n    93\t    await page.locator('#chart .axylo-toolbar button', { hasText: 'Pause' }).click();\n    94\t    await settle(page);\n    95\t    await check('paused');\n    96\t    await page.locator('#chart .axylo-toolbar button', { hasText: 'Zoom in' }).click();\n    97\t    await settle(page);\n    98\t    await check('zoomed');\n    99\t    await page.evaluate(async () => {\n   100\t      const el = document.querySelector('main')!.appendChild(Object.assign(document.createElement('div'), { id: 'narrow' }));\n   101\t      const c = window.make('trend', el);\n   102\t      window.charts.push(c);\n   103\t      await c.__bench.ready();\n   104\t    });\n   105\t    const box = (await page.locator('#narrow .axylo-proxy').boundingBox())!;\n   106\t    await page.mouse.move(box.x + box.width / 2, box.y + box.height / 2);\n   107\t    expect(await page.locator('#narrow .axylo-readout').isVisible()).toBe(true);\n   108\t    await check('narrow readout');\n   109\t    await page.evaluate(async () => { const c = window.charts[0]!; c.__dev.fail('reader'); c.update({ subtitle: 'x' }); await c.__bench.ready(); });\n   110\t    expect(await page.locator('#chart .axylo-message').textContent()).toBe('Something went wrong while drawing the chart.');\n   111\t    await check('internal error');\n   112\t    for (const [state, r] of Object.entries(results)) expect(r.violations, state).toEqual([]);\n   113\t    expect(await closePage(page)).toEqual([]);\n   114\t  });\n   115\t});\n   116\t\n   117\tdescribe('forced colors and reduced motion (spec L4, I5, A2)', () => {\n   118\t  it('every control and the focus indicator are visible in forced colors; nothing animates under reduced motion', async () => {\n   119\t    const page = await structuredPage({ forcedColors: 'active', reducedMotion: 'reduce' });\n   120\t    await make(page, 'trend');\n   121\t    await page.evaluate(async () => { window.charts[0]!.append([{ day: Date.UTC(2026, 4, 1), channel: 'Direct', sessions: 40000 }]); await window.charts[0]!.__bench.ready(); });\n   122\t    await page.locator('#chart .axylo-toolbar button', { hasText: 'Zoom in' }).click();\n   123\t    await settle(page);\n   124\t    const controls = await page.evaluate(() => [...document.querySelectorAll<HTMLElement>('#chart .axylo-toolbar button')].map(b => {\n   125\t      const s = getComputedStyle(b);\n   126\t      const r = b.getBoundingClientRect();\n   127\t      const swatch = b.querySelector('svg');\n   128\t      return {\n   129\t        text: b.textContent, width: r.width, height: r.height, color: s.color, background: s.backgroundColor,\n   130\t        swatch: swatch ? getComputedStyle(swatch).color : null,\n   131\t      };\n   132\t    }));\n   133\t    expect(controls.map(c => c.text)).toEqual(['Direct', 'Organic search', 'Referral', 'Zoom in', 'Zoom out', 'Reset zoom', 'Pause', 'View as table']);\n   134\t    for (const c of controls) {\n   135\t      expect(c.width).toBeGreaterThanOrEqual(24);\n   136\t      expect(c.height).toBeGreaterThanOrEqual(24);\n   137\t      expect(c.color).not.toBe(c.background);\n   138\t      if (c.swatch !== null) expect(c.swatch).not.toBe(c.background);\n   139\t    }\n   140\t    await page.focus('#chart .axylo-proxy');\n   141\t    await page.keyboard.press('ArrowRight');\n   142\t    const ring = await page.locator('#chart .axylo-focus-ring').evaluate(el => {\n   143\t      const s = getComputedStyle(el);\n   144\t      return { display: s.display, width: parseFloat(s.outlineWidth), style: s.outlineStyle, color: s.outlineColor, page: getComputedStyle(document.body).backgroundColor };\n   145\t    });\n   146\t    expect(ring).toMatchObject({ display: 'block', style: 'solid' });\n   147\t    expect(ring.width).toBeGreaterThanOrEqual(2);\n   148\t    expect(ring.color).not.toBe(ring.page);\n   149\t    await page.keyboard.press('Tab');\n   150\t    const button = await page.evaluate(() => {\n   151\t      const s = getComputedStyle(document.activeElement!);\n   152\t      return { style: s.outlineStyle, width: parseFloat(s.outlineWidth) };\n   153\t    });\n   154\t    expect(button.style).not.toBe('none');\n   155\t    expect(button.width).toBeGreaterThanOrEqual(2);\n   156\t    const motion = await page.evaluate(() => ({\n   157\t      animations: document.getAnimations().length,\n   158\t      transitions: [...document.querySelectorAll('#chart *')].filter(el => {\n   159\t        const s = getComputedStyle(el);\n   160\t        return s.transitionDuration.split(',').some(d => parseFloat(d) > 0) || s.animationName !== 'none';\n   161\t      }).length,\n   162\t    }));\n   163\t    expect(motion).toEqual({ animations: 0, transitions: 0 });\n   164\t    expect(await closePage(page)).toEqual([]);\n   165\t  });\n   166\t});\n   167\t\n   168\tdescribe('language (spec A10)', () => {\n   169\t  it('on a lang=\"de\" page built-in strings carry lang=\"en\"; an overridden string and the series names are in the page language', async () => {\n   170\t    const page = await fixturePage();\n   171\t    await page.evaluate(() => { document.documentElement.lang = 'de'; });\n   172\t    await make(page, 'trend', { messages: { zoomIn: 'Vergrößern' } });\n   173\t    const langs = await page.evaluate(() => {\n   174\t      const lang = (el: Element | null) => el?.closest('[lang]')?.getAttribute('lang') ?? null;\n   175\t      const button = (text: string) => [...document.querySelectorAll('#chart .axylo-toolbar button')].find(b => b.textContent === text) ?? null;\n   176\t      return {\n   177\t        toolbar: document.querySelector('#chart .axylo-toolbar')!.getAttribute('lang'),\n   178\t        zoomIn: button('Vergrößern')?.getAttribute('lang') ?? null, zoomInEffective: lang(button('Vergrößern')),\n   179\t        zoomOut: button('Zoom out')?.getAttribute('lang') ?? null,\n   180\t        table: button('View as table')?.getAttribute('lang') ?? null,\n   181\t        legend: lang(button('Direct')),\n   182\t      };\n   183\t    });\n   184\t    expect(langs).toEqual({ toolbar: 'en', zoomIn: 'de', zoomInEffective: 'de', zoomOut: 'en', table: 'en', legend: 'de' });\n   185\t    expect(await closePage(page)).toEqual([]);\n   186\t  });\n   187\t\n   188\t  it('an overridden string is not marked English, even inherited, when it is the only text', async () => {\n   189\t    co