{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/figure.ts && nl -ba packages/axylo/src/dom/pointer.ts'","aggregated_output":"     1\t/**\n     2\t * The chart's document structure (plan 2.4; spec A1, C1, F12, L7). The author's target is the root; inside\n     3\t * it the figure holds the caption (title, subtitle, summary), the plot container (marks, text layer, state\n     4\t * message), the reader's note, a polite live region and the tooltip. Only text is ever set, never HTML.\n     5\t *\n     6\t * The interaction layer (dom/interaction.ts) adds the keyboard proxy inside the plot and fills the control\n     7\t * slots (`top` above the plot, `side` beside it, `controls` under it: legend, toolbar, table) and `readout`;\n     8\t * the figure only provides those slots. The plot and `side` share the `body` row.\n     9\t */\n    10\t\n    11\texport interface TitleModel {\n    12\t  readonly text: string;\n    13\t  readonly level: number;\n    14\t  readonly visible: boolean;\n    15\t}\n    16\t\n    17\texport interface FigureModel {\n    18\t  readonly compact: boolean;\n    19\t  /** The heading, or null when there is none (only `labelledBy`, or no title at all). */\n    20\t  readonly title: TitleModel | null;\n    21\t  /** Id of a heading the page already has. */\n    22\t  readonly labelledBy: string | null;\n    23\t  /** Accessible name when neither a title nor `labelledBy` names the chart (generated, AX140). */\n    24\t  readonly name: string;\n    25\t  readonly subtitle: string | null;\n    26\t  readonly summary: string;\n    27\t  /** The plot is too small to draw (spec L8): the summary is shown instead. */\n    28\t  readonly summaryVisible: boolean;\n    29\t  readonly note: string | null;\n    30\t  /** Loading, empty, error or internal-error text shown inside the plot (spec L7); null when marks are shown. */\n    31\t  readonly message: string | null;\n    32\t  /**\n    33\t   * `lang` for the message and the note: 'en' when they show built-in English on a page in another\n    34\t   * language (spec A10), else null.\n    35\t   */\n    36\t  readonly messageLang?: string | null;\n    37\t  readonly noteLang?: string | null;\n    38\t}\n    39\t\n    40\texport interface Figure {\n    41\t  readonly figure: HTMLElement;\n    42\t  readonly plot: HTMLElement;\n    43\t  readonly tooltip: HTMLElement;\n    44\t  /** Fixed readout under the plot, used instead of the tooltip when it cannot fit beside the mark. */\n    45\t  readonly readout: HTMLElement;\n    46\t  /** Legend, toolbar and table, in that order, between the plot and the note. */\n    47\t  readonly controls: HTMLElement;\n    48\t  /** Between the caption and the plot (`legend: 'top'`). */\n    49\t  readonly top: HTMLElement;\n    50\t  /** Beside the plot, in the same row (`legend: 'right'`). */\n    51\t  readonly side: HTMLElement;\n    52\t  /** The row holding the plot and `side`; it takes the height the caption and controls leave. */\n    53\t  readonly body: HTMLElement;\n    54\t  readonly id: string;\n    55\t  /** Returns true when something that can change the figure's layout was written. */\n    56\t  update(model: FigureModel): boolean;\n    57\t  /** Puts text in the polite live region (state changes only, spec L7, A7). */\n    58\t  /** `lang` marks built-in English on a page in another language (spec A10). */\n    59\t  announce(text: string, lang?: string | null): void;\n    60\t  /** Removes everything the figure added to the root, and the root's added class. */\n    61\t  destroy(): void;\n    62\t}\n    63\t\n    64\tconst HIDDEN = 'axylo-visually-hidden';\n    65\t\n    66\tfunction setText(el: HTMLElement, text: string): void {\n    67\t  if (el.textContent !== text) el.textContent = text;\n    68\t}\n    69\t\n    70\tfunction setAttr(el: Element, name: string, value: string | null): void {\n    71\t  if (value === null) {\n    72\t    if (el.hasAttribute(name)) el.removeAttribute(name);\n    73\t  } else if (el.getAttribute(name) !== value) {\n    74\t    el.setAttribute(name, value);\n    75\t  }\n    76\t}\n    77\t\n    78\tfunction show(el: HTMLElement, visible: boolean): void {\n    79\t  if (el.hidden === visible) el.hidden = !visible;\n    80\t}\n    81\t\n    82\texport function createFigure(root: HTMLElement, id: string, parts: { marks: Element; text: Element }): Figure {\n    83\t  const doc = root.ownerDocument;\n    84\t  const addedClass = !root.classList.contains('axylo');\n    85\t  const hadClassAttribute = root.hasAttribute('class');\n    86\t  if (addedClass) root.classList.add('axylo');\n    87\t\n    88\t  const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string): HTMLElementTagNameMap[K] => {\n    89\t    const el = doc.createElement(tag);\n    90\t    el.className = className;\n    91\t    return el;\n    92\t  };\n    93\t  const figure = make('figure', 'axylo-figure');\n    94\t  figure.id = id;\n    95\t  // A div, not figcaption: a figure with a figcaption may not take the group or img role (ARIA in HTML), and\n    96\t  // the figure is named and described through aria-labelledby and aria-describedby anyway.\n    97\t  const caption = make('div', 'axylo-caption');\n    98\t  const title = make('div', 'axylo-title');\n    99\t  title.id = `${id}-t`;\n   100\t  title.setAttribute('role', 'heading');\n   101\t  const subtitle = make('p', 'axylo-subtitle');\n   102\t  subtitle.id = `${id}-st`;\n   103\t  // Hidden until the first update says otherwise, so nothing is measured with an empty caption.\n   104\t  title.hidden = true;\n   105\t  subtitle.hidden = true;\n   106\t  const summary = make('p', `axylo-summary ${HIDDEN}`);\n   107\t  summary.id = `${id}-s`;\n   108\t  const plot = make('div', 'axylo-plot');\n   109\t  const message = make('p', 'axylo-message');\n   110\t  message.id = `${id}-m`;\n   111\t  message.hidden = true;\n   112\t  const corner = make('span', 'axylo-corner');\n   113\t  corner.setAttribute('aria-hidden', 'true');\n   114\t  corner.textContent = '*';\n   115\t  corner.hidden = true;\n   116\t  plot.append(parts.marks, parts.text, message, corner);\n   117\t  const note = make('p', 'axylo-note');\n   118\t  note.id = `${id}-n`;\n   119\t  note.setAttribute('role', 'status');\n   120\t  // A status that is not live: the note can change as streamed data arrives (labels thinned, values left\n   121\t  // out), and data arriving must not speak (spec A7). The summary carries the same statements.\n   122\t  note.setAttribute('aria-live', 'off');\n   123\t  note.hidden = true;\n   124\t  const live = make('div', `axylo-live ${HIDDEN}`);\n   125\t  live.setAttribute('aria-live', 'polite');\n   126\t  const tooltip = make('div', 'axylo-tooltip');\n   127\t  tooltip.hidden = true;\n   128\t  tooltip.setAttribute('aria-hidden', 'true');\n   129\t  const readout = make('div', 'axylo-readout');\n   130\t  readout.hidden = true;\n   131\t  readout.setAttribute('aria-hidden', 'true');\n   132\t  const controls = make('div', 'axylo-controls');\n   133\t  controls.hidden = true;\n   134\t  const top = make('div', 'axylo-controls-top');\n   135\t  top.hidden = true;\n   136\t  const side = make('div', 'axylo-controls-side');\n   137\t  side.hidden = true;\n   138\t  const body = make('div', 'axylo-body');\n   139\t  body.append(plot, side);\n   140\t  caption.append(title, subtitle, summary);\n   141\t  figure.append(caption, top, body, controls, note, live, tooltip, readout);\n   142\t  root.appendChild(figure);\n   143\t\n   144\t  let last: FigureModel | null = null;\n   145\t\n   146\t  return {\n   147\t    figure,\n   148\t    plot,\n   149\t    tooltip,\n   150\t    readout,\n   151\t    controls,\n   152\t    top,\n   153\t    side,\n   154\t    body,\n   155\t    id,\n   156\t    update(model: FigureModel): boolean {\n   157\t      if (last !== null && same(last, model)) return false;\n   158\t      const moved = last === null || movesLayout(last, model);\n   159\t      last = model;\n   160\t      const { compact } = model;\n   161\t      figure.classList.toggle('axylo-compact', compact);\n   162\t      setAttr(figure, 'role', compact ? 'img' : 'group');\n   163\t\n   164\t      // Name: the title, else the page's own heading, else the generated name.\n   165\t      const heading = !compact && model.title !== null;\n   166\t      if (heading) {\n   167\t        setText(title, model.title!.text);\n   168\t        setAttr(title, 'aria-level', String(model.title!.level));\n   169\t        title.classList.toggle(HIDDEN, !model.title!.visible);\n   170\t      }\n   171\t      show(title, heading);\n   172\t      if (model.labelledBy) {\n   173\t        setAttr(figure, 'aria-labelledby', model.labelledBy);\n   174\t        setAttr(figure, 'aria-label', null);\n   175\t      } else if (heading) {\n   176\t        setAttr(figure, 'aria-labelledby', title.id);\n   177\t        setAttr(figure, 'aria-label', null);\n   178\t      } else {\n   179\t        setAttr(figure, 'aria-labelledby', null);\n   180\t        setAttr(figure, 'aria-label', model.name);\n   181\t      }\n   182\t\n   183\t      setText(subtitle, model.subtitle ?? '');\n   184\t      show(subtitle, !compact && !!model.subtitle);\n   185\t      setText(summary, model.summary);\n   186\t      summary.classList.toggle(HIDDEN, compact || !model.summaryVisible);\n   187\t      setAttr(figure, 'aria-describedby', summary.id);\n   188\t\n   189\t      // The compact variant has no note element: the summary says what was left out, and a corner marker\n   190\t      // shows it (spec C5); the marker's text equivalent is that description.\n   191\t      setText(note, compact ? '' : model.note ?? '');\n   192\t      setAttr(note, 'lang', model.noteLang ?? null);\n   193\t      setAttr(message, 'lang', model.messageLang ?? null);\n   194\t      show(note, !compact && model.note !== null);\n   195\t      show(corner, compact && model.note !== null);\n   196\t      setAttr(corner, 'title', compact ? model.note : null);\n   197\t\n   198\t      setText(message, model.message ?? '');\n   199\t      show(message, model.message !== null);\n   200\t      return moved;\n   201\t    },\n   202\t    announce(text: string, lang: string | null = null): void {\n   203\t      setAttr(live, 'lang', lang);\n   204\t      setText(live, text);\n   205\t    },\n   206\t    destroy(): void {\n   207\t      figure.remove();\n   208\t      if (addedClass) root.classList.remove('axylo');\n   209\t      if (!hadClassAttribute && root.classList.length === 0) root.removeAttribute('class');\n   210\t    },\n   211\t  };\n   212\t}\n   213\t\n   214\t/** Whether going from `a` to `b` can change the size of anything around the plot (the caption or the note). */\n   215\tfunction movesLayout(a: FigureModel, b: FigureModel): boolean {\n   216\t  const heading = (m: FigureModel) => m.compact || m.title === null ? '' : `${m.title.visible}\\u0000${m.title.level}\\u0000${m.title.text}`;\n   217\t  return a.compact !== b.compact || heading(a) !== heading(b) || (a.compact ? '' : a.subtitle) !== (b.compact ? '' : b.subtitle) ||\n   218\t    a.summaryVisible !== b.summaryVisible || (b.summaryVisible && a.summary !== b.summary) ||\n   219\t    (a.compact ? null : a.note) !== (b.compact ? null : b.note);\n   220\t}\n   221\t\n   222\tfunction same(a: FigureModel, b: FigureModel): boolean {\n   223\t  return a.compact === b.compact && a.messageLang === b.messageLang && a.noteLang === b.noteLang && a.labelledBy === b.labelledBy && a.name === b.name && a.subtitle === b.subtitle &&\n   224\t    a.summary === b.summary && a.summaryVisible === b.summaryVisible && a.note === b.note && a.message === b.message &&\n   225\t    (a.title === b.title || (a.title !== null && b.title !== null && a.title.text === b.title.text &&\n   226\t      a.title.level === b.title.level && a.title.visible === b.title.visible));\n   227\t}\n     1\t/**\n     2\t * Comparing pick targets. Pointer, touch and drag input are handled by the interaction layer\n     3\t * (dom/interaction.ts); this only says whether two targets name the same thing.\n     4\t */\n     5\timport type { PickTarget } from '../core/contracts';\n     6\t\n     7\t/** Two pick results name the same thing, so the tooltip need not be rebuilt. */\n     8\texport function sameTarget(a: PickTarget | null, b: PickTarget | null): boolean {\n     9\t  if (a === null || b === null) return a === b;\n    10\t  if (a.kind === 'x' && b.kind === 'x') return a.x === b.x;\n    11\t  if (a.kind === 'slice' && b.kind === 'slice') return a.sliceKey === b.sliceKey;\n    12\t  if (a.kind === 'point' && b.kind === 'point') {\n    13\t    return a.count === b.count && a.refs.length === b.refs.length && a.refs.every((r, i) => {\n    14\t      const o = b.refs[i]!;\n    15\t      return r.kind === 'point' && o.kind === 'point' && r.seriesKey === o.seriesKey && r.row === o.row && r.x === o.x;\n    16\t    });\n    17\t  }\n    18\t  return false;\n    19\t}\n","exit_code":0,"status":"completed"}}
