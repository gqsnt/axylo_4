ath; without it the chart leaves pinch to the page\", async () => {\n   410\t    const page = await fixturePage({ hasTouch: true });\n   411\t    await make(page, 'trend', { zoom: 'touch' });\n   412\t    expect(await page.locator('#chart .axylo-plot').evaluate(el => getComputedStyle(el).touchAction)).toBe('pan-x pan-y');\n   413\t    await page.evaluate(() => {\n   414\t      (window as unknown as { zooms: number }).zooms = 0;\n   415\t      window.charts[0]!.on('zoom', () => { (window as unknown as { zooms: number }).zooms++; });\n   416\t    });\n   417\t    const full = await domain(page);\n   418\t    const g = await geometry(page);\n   419\t    const cx = g.plot.x + g.plot.width / 2;\n   420\t    const cy = g.plot.y + g.plot.height / 2;\n   421\t    const client = await page.context().newCDPSession(page);\n   422\t    const points = (d: number) => [{ x: cx - d, y: cy, id: 1 }, { x: cx + d, y: cy, id: 2 }];\n   423\t    await client.send('Input.dispatchTouchEvent', { type: 'touchStart', touchPoints: points(40) });\n   424\t    for (let d = 50; d <= 160; d += 10) {\n   425\t      await client.send('Input.dispatchTouchEvent', { type: 'touchMove', touchPoints: points(d) });\n   426\t      await page.evaluate(() => window.nextFrames(1));\n   427\t    }\n   428\t    await client.send('Input.dispatchTouchEvent', { type: 'touchEnd', touchPoints: [] });\n   429\t    await settle(page);\n   430\t    const zoomed = await domain(page);\n   431\t    // Fingers 80 px apart moved to 320 px: a quarter of the width, around the same centre.\n   432\t    const ratio = (zoomed[1]! - zoomed[0]!) / (full[1]! - full[0]!);\n   433\t    expect(ratio).toBeGreaterThan(0.2);\n   434\t    expect(ratio).toBeLessThan(0.3);\n   435\t    expect(Math.abs((zoomed[0]! + zoomed[1]!) / 2 - (full[0]! + full[1]!) / 2)).toBeLessThan(0.02 * (full[1]! - full[0]!));\n   436\t    expect(await page.evaluate(() => (window as unknown as { zooms: number }).zooms)).toBeGreaterThan(0);\n   437\t    expect(awai