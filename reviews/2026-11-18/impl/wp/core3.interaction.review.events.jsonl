ntrolsLabel') ? d.pageLang : null;\n  1043\t    return series.map((s, i) => {\n  1044\t      const shown = view.visible[i] === true;\n  1045\t      return {\n  1046\t        key: `series:${s.key}`, label: s.label, pressed: shown, lang: hiddenLang, className: 'axylo-control axylo-legend-entry',\n  1047\t        struck: !shown, swatch: seriesSwatch(view.kind, i, view.cues[i] ?? null, !shown),\n  1048\t        activate: () => actions.toggle(s.key),\n  1049\t      };\n  1050\t    });\n  1051\t  }\n  1052\t\n  1053\t  /** Each control is offered for the action it can perform, whatever the display state (review 2, finding 3). */\n  1054\t  function controlItems(d: ControlsState): ToolbarItem[] {\n  1055\t    const m = d.messages;\n  1056\t    const items: ToolbarItem[] = [];\n  1057\t    if (d.ready) items.push(...legendItems(d));\n  1058\t    // Inside a toolbar marked English, a replaced label is marked with the page's language again.\n  1059\t    const inherited = d.english('controlsLabel') ? d.pageLang : null;\n  1060\t    const button = (key: keyof Messages, activate: () => void, disabled = false): ToolbarItem =>\n  1061\t      ({ key, label: m[key], lang: d.english(key) ?? inherited, className: 'axylo-control', activate, disabled });\n  1062\t    if (d.zoom && !d.tooSmall && d.view.kind !== 'donut') {\n  1063\t      const window = d.zoomed ? d.view.xDomain : d.view.xFull;\n  1064\t      if (d.ready) items.push(button('zoomIn', () => zoomBy(1 / ZOOM_FACTOR), !canZoomIn(d.view, window)));\n  1065\t      // Zoom out stays in place at full view, marked as unable to act, so the toolbar does not reflow.\n  1066\t      if (d.ready || d.zoomed) items.push(button('zoomOut', () => zoomBy(ZOOM_FACTOR), !d.zoomed));\n  1067\t      if (d.zoomed) items.push(button('resetZoom', () => requestZoom(null)));\n  1068\t    }\n  1069\t    if (d.streaming) {\n  1070\t      const key = d.paused ? 'resume' : 'pause';\n  1071\t      items.push({ ...button(key, () => actions.pause(!d.paused))