h.max(i, start), 1);\n    81\t    const replacement = next >= 0 ? next : seek(s, Math.min(i - 1, end - 1), -1);\n    82\t    return replacement < 0 ? null : ref(s, replacement);\n    83\t  }\n    84\t\n    85\t  function nearestSlot(pixel: number): number {\n    86\t    if (!xScale || start === end) return -1;\n    87\t    const x = xScale.invert(pixel);\n    88\t    if (xScale.type === 'band') return x >= start && x < end ? x : -1;\n    89\t    const right = lowerBound(positions, x, start, end);\n    90\t    if (right === start) return start;\n    91\t    if (right === end) return end - 1;\n    92\t    // Use screen distances for the final comparison because inversion can round at a midpoint.\n    93\t    const leftPixel = xScale.map(positions[right - 1]!);\n    94\t    const rightPixel = xScale.map(positions[right]!);\n    95\t    const midpoint = leftPixel / 2 + rightPixel / 2;\n    96\t    return (leftPixel <= rightPixel ? pixel >= midpoint : pixel <= midpoint) ? right : right - 1;\n    97\t  }\n    98\t\n    99\t  return {\n   100\t    pick(px, py) {\n   101\t      if (!layout || !visible.length || !contains(layout.plot, px, py)) return null;\n   102\t      const i = nearestSlot(projection?.kind === 'bands' && projection.horizontal ? py : px);\n   103\t      return i < 0 ? null : { kind: 'x', x: positions[i]! };\n   104\t    },\n   105\t    tooltip(target) {\n   106\t      const i = target.kind === 'x' ? index(target.x) : -1;\n   107\t      if (i < start || i >= end) return { title: '', rows: [], count: 0, total: null };\n   108\t      let total: string | null = null;\n   109\t      if (stack && stack.order.length) {\n   110\t        let sum = 0;\n   111\t        let hasValue = false;\n   112\t        for (const s of stack.order) {\n   113\t          if (!isValue(s, i)) continue;\n   114\t          sum += frame.series[s]!.y[i]!;\n   115\t          hasValue = true;\n   116\t        }\n   117\t        total = hasValue ? formatters.value(stack.order[0]!, sum) : fo