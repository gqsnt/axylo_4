w as unknown as { selected: unknown[] }).selected = []; window.charts[0]!.on('select', p => (window as unknown as { selected: unknown[] }).selected.push((p as { x: unknown }).x)); });\n   341\t    const box = (await page.locator('#chart .axylo-proxy').boundingBox())!;\n   342\t    await page.touchscreen.tap(box.x + 0.5 * box.width, box.y + box.height / 2);\n   343\t    expect(await page.evaluate(() => (window as unknown as { selected: unknown[] }).selected)).toEqual([5]);\n   344\t    expect(await closePage(page)).toEqual([]);\n   345\t  });\n   346\t});\n   347\t\n   348\tdescribe('the range follows assistive value changes exactly (finding 6)', () => {\n   349\t  it('Home at the first datum leaves nothing behind: an assistive set to 1 lands on the second datum', async () => {\n   350\t    const page = await chartPage();\n   351\t    await create(page, 'line', { title: 'K', data: [0, 1, 2, 3].map(x => ({ x, y: x })), x: 'x', y: 'y' });\n   352\t    await page.focus('#chart .axylo-proxy');\n   353\t    await page.keyboard.press('Home');\n   354\t    await page.evaluate(() => {\n   355\t      const proxy = document.querySelector('#chart .axylo-proxy') as HTMLInputElement;\n   356\t      proxy.value = '1';\n   357\t      proxy.dispatchEvent(new Event('input', { bubbles: true }));\n   358\t    });\n   359\t    expect(await valueText(page)).toMatch(/^1\\. .*Point 2 of 4$/);\n   360\t    // A direct jump from 1 to 3 goes to 3, not \"one page\".\n   361\t    await page.evaluate(() => {\n   362\t      const proxy = document.querySelector('#chart .axylo-proxy') as HTMLInputElement;\n   363\t      proxy.value = '3';\n   364\t      proxy.dispatchEvent(new Event('change', { bubbles: true }));\n   365\t    });\n   366\t    expect(await valueText(page)).toMatch(/^3\\. .*Point 4 of 4$/);\n   367\t    expect(await closePage(page)).toEqual([]);\n   368\t  });\n   369\t});\n   370\t\n","exit_code":0,"status":"completed"}}
