{"type":"item.completed","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -lc \"git show d9fa4b0:packages/axylo/test/browser/acceptance/l-legibility.browser.test.ts | nl -ba | sed -n '93,149p;235,332p'\"","aggregated_output":"    93\t  categories.forEach((c, i) => {\n    94\t    const t = shown[i]!;\n    95\t    if (t === c) return;\n    96\t    const [head, tail] = t.split('…');\n    97\t    // Truncated in the middle: what is left is the category's own start and end.\n    98\t    if (tail === undefined || !c.startsWith(head!.trim()) || !c.endsWith(tail.trim())) problems.push(`label ${i + 1} \"${t}\" is not \"${c}\" nor its middle truncation`);\n    99\t  });\n   100\t  return problems;\n   101\t}\n   102\t\n   103\tasync function setWidth(page: Page, width: number): Promise<void> {\n   104\t  await page.evaluate(w => { (document.querySelector('#chart') as HTMLElement).style.width = `${w}px`; }, width);\n   105\t  await settle(page);\n   106\t  await settle(page);\n   107\t}\n   108\t\n   109\tdescribe('L1 labels fit', () => {\n   110\t  for (const type of FULL as Full[]) {\n   111\t    for (const [condition, css] of Object.entries(CONDITIONS)) {\n   112\t      it(`L1 ${type}: at widths ${WIDTHS.join(', ')} px (${condition}) no painted text overlaps other text (1 px), none is clipped, ellipsised or outside the figure, tick labels are distinct, wrapped to at most three lines and rotated at most 45°, and no category label is lost without the note`, async () => {\n   113\t        const page = await devPage({ viewport: { width: 2000, height: 900 }, css: `#chart { height: 360px; } ${css}` });\n   114\t        const d = busy(type);\n   115\t        await createRaw(page, d.fn, d.options);\n   116\t        await page.evaluate(() => document.fonts.ready);\n   117\t        const problems: string[] = [];\n   118\t        for (const width of WIDTHS) {\n   119\t          await setWidth(page, width);\n   120\t          problems.push(...(await textProblems(page, d.categories)).map(p => `${width} px: ${p}`));\n   121\t          if (type === 'bar') {\n   122\t            // Axylo never changes the orientation on its own: the bars stay vertical (one value axis on the left).\n   123\t            const rects = ((await shapes(page, '#chart', 100000))[1] ?? []).map(r => r.box);\n   124\t            if (rects.length && !rects.every(r => Math.abs(r.width - rects[0]!.width) < 0.5)) problems.push(`${width} px: the bars changed orientation`);\n   125\t          }\n   126\t        }\n   127\t        expect(problems).toEqual([]);\n   128\t        expect(await closePage(page)).toEqual([]);\n   129\t      });\n   130\t    }\n   131\t\n   132\t    it(`L1 ${type}: after a font that loads late, the relaid-out text still neither overlaps nor is cut off nor leaves the figure (480 and 1280 px)`, async () => {\n   133\t      const page = await devPage({ viewport: { width: 2000, height: 900 }, css: '#chart { height: 360px; font-family: \"Late Sans\", sans-serif; }' });\n   134\t      const d = busy(type);\n   135\t      await createRaw(page, d.fn, d.options);\n   136\t      const before = await textBoxes(page);\n   137\t      const font = fs.readFileSync('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf').toString('base64');\n   138\t      await page.evaluate(async f => {\n   139\t        const bytes = Uint8Array.from(atob(f), c => c.charCodeAt(0));\n   140\t        const face = new FontFace('Late Sans', bytes);\n   141\t        await face.load();\n   142\t        document.fonts.add(face);\n   143\t      }, font);\n   144\t      await settle(page);\n   145\t      await settle(page);\n   146\t      const after = await textBoxes(page);\n   147\t      // The font did change the text's size (the check below is then about a real relayout).\n   148\t      expect(after.reduce((a, b) => a + b.w, 0)).not.toBeCloseTo(before.reduce((a, b) => a + b.w, 0), 0);\n   149\t      const problems: string[] = [];\n   235\t  }\n   236\t  return { problems, checked };\n   237\t}\n   238\t\n   239\tdescribe('L2 text size and contrast', () => {\n   240\t  for (const type of TYPES) {\n   241\t    for (const scheme of ['light', 'dark'] as const) {\n   242\t      it(`L2 ${type}: in the ${scheme} scheme every text is at least 12 CSS px and 4.5:1 on what is painted behind it (legend entries of hidden series included); marks${type === 'compact' ? '' : ', axis lines and the focus indicator'} are painted at least 3:1`, async () => {\n   243\t        const page = await devPage({ deviceScaleFactor: 2, css: scheme === 'dark' ? DARK_PAGE : '' });\n   244\t        await create(page, type, { subtitle: 'All sites' });\n   245\t        if (type !== 'compact' && type !== 'donut') {\n   246\t          await page.locator('#chart .axylo-legend-entry').first().click();\n   247\t          await settle(page);\n   248\t          await page.mouse.move(0, 0);\n   249\t        }\n   250\t        const texts = await textContrast(page);\n   251\t        if (type !== 'compact') expect(texts.length).toBeGreaterThan(3);\n   252\t        expect(texts.filter(t => t.size < 12 || t.ratio < 4.5).map(t => `\"${t.text}\" ${t.size}px ${t.ratio.toFixed(2)}:1`)).toEqual([]);\n   253\t        const marks = await markContrast(page, type);\n   254\t        expect(marks.problems).toEqual([]);\n   255\t        expect(marks.checked).toBeGreaterThan(0);\n   256\t        if (type !== 'donut' && type !== 'compact') {\n   257\t          // The axis lines, as painted: each rule painted with the axis colour, sampled along its length.\n   258\t          const axes = await page.evaluate(() => [...document.querySelectorAll<SVGLineElement>('#chart svg.axylo-svg .axylo-scene line')].filter(l => /--axylo-axis/.test(l.style.getPropertyValue('color'))).map(l => l.getBoundingClientRect().toJSON() as { x: number; y: number; width: number; height: number }));\n   259\t          expect(axes.length).toBeGreaterThan(0);\n   260\t          const { img, box: view } = await screenshot(page, '#chart .axylo-plot');\n   261\t          const backdrop = modeColor(img, { x0: 0, y0: 0, x1: img.width, y1: img.height }).color;\n   262\t          const long = axes.filter(a => Math.max(a.width, a.height) > 40);\n   263\t          expect(long.length).toBeGreaterThan(0);\n   264\t          for (const a of long) {\n   265\t            const b: Box = a.width > a.height ? { x: a.x + a.width * 0.3, y: a.y - 1, width: a.width * 0.4, height: 2 } : { x: a.x - 1, y: a.y + a.height * 0.3, width: 2, height: a.height * 0.4 };\n   266\t            const ink = inkColor(img, view, b, backdrop);\n   267\t            expect(ink, `axis line at ${JSON.stringify(a)} painted`).not.toBeNull();\n   268\t            expect(contrast(ink!, backdrop)).toBeGreaterThanOrEqual(3);\n   269\t          }\n   270\t        }\n   271\t        if (type !== 'compact') {\n   272\t          await page.focus('#before');\n   273\t          await page.keyboard.press('Tab');\n   274\t          await settle(page);\n   275\t          const { img, box: view } = await screenshot(page, '#chart figure');\n   276\t          const backdrop = modeColor(img, { x0: 0, y0: 0, x1: img.width, y1: img.height }).color;\n   277\t          const o = await box(page, '#chart .axylo-focus-ring');\n   278\t          const ink = inkColor(img, view, { x: o.x + o.width * 0.4, y: o.y + 1, width: o.width * 0.2, height: 2 }, backdrop);\n   279\t          expect(ink, 'focus outline painted').not.toBeNull();\n   280\t          expect(contrast(ink!, backdrop), 'focus indicator').toBeGreaterThanOrEqual(3);\n   281\t        }\n   282\t        expect(await closePage(page)).toEqual([]);\n   283\t      });\n   284\t    }\n   285\t  }\n   286\t});\n   287\t\n   288\t// ── L3 ────────────────────────────────────────────────────────────────────────────────────────────\n   289\t\n   290\t/** The drawn position of the fixture's third datum (the same in every type): a mark's centre, in viewport px. */\n   291\tasync function thirdDatum(page: Page, type: Full): Promise<{ x: number; y: number }> {\n   292\t  // Donut: the middle of the first slice (Travel, 15 %, so 27° clockwise from 12 o'clock).\n   293\t  if (type === 'donut') { const g = await ring(page); const a = (0.15 * Math.PI); return { x: g.cx + g.outer * 0.85 * Math.sin(a), y: g.cy - g.outer * 0.85 * Math.cos(a) }; }\n   294\t  const marks = ((await shapes(page, '#chart', type === 'bar' ? 100000 : 14))[1] ?? []).map(s => center(s.box)).sort((a, b) => a.x - b.x);\n   295\t  return marks[2]!;\n   296\t}\n   297\t\n   298\tdescribe('L3 the chart follows its container', () => {\n   299\t  for (const type of FULL as Full[]) {\n   300\t    it(`L3 ${type}: resized 720 → 360 → 720 px with no call from the page, the marks are redrawn for each width: a known datum sits at the same share of the plot, and pointing at it there shows it`, async () => {\n   301\t      const page = await devPage();\n   302\t      await create(page, type);\n   303\t      const shares: number[][] = [];\n   304\t      for (const w of [720, 360, 720]) {\n   305\t        await setWidth(page, w);\n   306\t        expect((await box(page, '#chart svg.axylo-svg')).width).toBeLessThanOrEqual(w + 0.5);\n   307\t        const p = await box(page, '#chart .axylo-proxy');\n   308\t        const d = await thirdDatum(page, type);\n   309\t        shares.push([(d.x - p.x) / p.width, (d.y - p.y) / p.height]);\n   310\t        await page.mouse.move(d.x, d.y + (type === 'donut' ? 4 : 0));\n   311\t        await settle(page);\n   312\t        const tip = (await page.locator('#chart .axylo-tooltip, #chart .axylo-readout').allTextContents()).join(' ');\n   313\t        // The third mark by x: Mar 4 (line, area), Q3 (bar), EU's third point at 30 kB (scatter), the first slice (donut).\n   314\t        const want = { line: 'Mar 4, 2026', area: 'Mar 4, 2026', bar: 'Q3', scatter: '30 kB', donut: 'Travel' }[type];\n   315\t        expect(tip, `${w} px`).toContain(want);\n   316\t        await page.mouse.move(0, 0);\n   317\t      }\n   318\t      // The datum keeps its place (for a donut, its angle on a ring that is re-centred, so the share of\n   319\t      // the plot's width moves with the ring's size and only the return to 720 px is compared).\n   320\t      if (type !== 'donut') expect(Math.abs(shares[1]![0]! - shares[0]![0]!)).toBeLessThan(0.03);\n   321\t      expect(shares[2]).toEqual(shares[0]);\n   322\t      expect(await closePage(page)).toEqual([]);\n   323\t    });\n   324\t\n   325\t    it(`L3 ${type}: with no definite height the plot is 16:9 of its width, clamped to 160–480 px, stable over 10 frames; an opened table flows in the figure and pushes nothing over the next element`, async () => {\n   326\t      const page = await devPage({ viewport: { width: 1300, height: 1400 }, css: '#chart { height: auto; }' });\n   327\t      await create(page, type);\n   328\t      for (const w of [240, 720, 1200]) {\n   329\t        await setWidth(page, w);\n   330\t        const heights: number[] = [];\n   331\t        for (let i = 0; i < 10; i++) { heights.push((await box(page, '#chart .axylo-plot')).height); await frames(page, 1); }\n   332\t        const plot = await box(page, '#chart .axylo-plot');\n","exit_code":0,"status":"completed"}}
