{"type":"item.completed","item":{"id":"item_102","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/src/scene/lines.ts | nl -ba | head -83; git show d9fa4b0:packages/axylo/test/acceptance/f-donut.test.ts | nl -ba | tail -62; git show d9fa4b0:packages/axylo/test/browser/acceptance/compact.browser.test.ts | nl -ba | head -95'","aggregated_output":"     1\timport {\n     2\t  SLOT_VALUE, type AlignedView, type IndexRange, type PathMark, type PointMark, type Projection,\n     3\t  type Rect, type ScatterView, type SeriesCue,\n     4\t} from '../core/contracts';\n     5\timport { buildPath, buildPoints, simplifyLine, type JoinedRuns, type LineInput } from '../simplify';\n     6\timport { position, seriesPaint } from './geometry';\n     7\t\n     8\texport type XY = Extract<Projection, { kind: 'xy' }>;\n     9\texport type Drawing = Omit<LineInput, 'y' | 'slot' | 'range'> & {\n    10\t  readonly mapX: (x: number) => number;\n    11\t  readonly mapY: (y: number) => number;\n    12\t};\n    13\t\n    14\texport function drawing(x: Float64Array, xy: XY, plot: Rect, devicePixelRatio: number): Drawing {\n    15\t  return {\n    16\t    x, mapX: value => position(xy.x, value), mapY: value => position(xy.y, value),\n    17\t    left: plot.x, width: plot.width, devicePixelRatio,\n    18\t  };\n    19\t}\n    20\t\n    21\tfunction markerIndexes(\n    22\t  input: LineInput & Drawing, range: IndexRange, isolated: Uint32Array, compact: boolean,\n    23\t): Uint32Array {\n    24\t  if (compact) return isolated;\n    25\t  const { slot, x, mapX } = input;\n    26\t  let count = 0;\n    27\t  let first = range.end;\n    28\t  let last = range.start;\n    29\t  let previousPixel = 0;\n    30\t  let showAll = true;\n    31\t  for (let i = range.start; i < range.end; i++) {\n    32\t    if (slot[i] !== SLOT_VALUE) continue;\n    33\t    if (count++ === 0) first = i;\n    34\t    if (showAll) {\n    35\t      const pixel = mapX(x[i]!);\n    36\t      showAll = i === first || Math.abs(pixel - previousPixel) >= 12;\n    37\t      previousPixel = pixel;\n    38\t    }\n    39\t    last = i;\n    40\t  }\n    41\t  if (!count) return isolated;\n    42\t  const span = Math.abs(mapX(x[last]!) - mapX(x[first]!));\n    43\t  const capacity = showAll ? count : Math.min(count, Math.floor(span / 80) + 1 + isolated.length);\n    44\t  const indexes = new Uint32Array(capacity);\n    45\t  let write = capacity;\n    46\t  let previous = Infinity;\n    47\t  let single = isolated.length - 1;\n    48\t  // Walk back from the last observed value so the series always has its identity at that end.\n    49\t  for (let i = last; i >= first; i--) {\n    50\t    if (slot[i] !== SLOT_VALUE) continue;\n    51\t    const pixel = mapX(x[i]!);\n    52\t    const required = isolated[single] === i;\n    53\t    if (required) single--;\n    54\t    if (showAll || required || Math.abs(previous - pixel) >= 80) {\n    55\t      indexes[--write] = i;\n    56\t      previous = pixel;\n    57\t    }\n    58\t  }\n    59\t  return indexes.subarray(write);\n    60\t}\n    61\t\n    62\tfunction pointMark(series: number, cue: SeriesCue, xy: Float32Array): PointMark {\n    63\t  return { type: 'points', series, xy, shape: cue.marker, size: 6, fill: seriesPaint(series) };\n    64\t}\n    65\t\n    66\texport function addLine(\n    67\t  input: LineInput & Drawing, view: AlignedView, series: number, visible: IndexRange, compact: boolean,\n    68\t  paths: PathMark[], points: PointMark[], selection: JoinedRuns = simplifyLine(input),\n    69\t): void {\n    70\t  const cue = view.cues[series]!;\n    71\t  // A single slot in an author domain can have joined neighbours outside the drawing.\n    72\t  const singlePoint = input.range.end - input.range.start === 1 && selection.indexes.length === 1;\n    73\t  if (selection.indexes.length && !singlePoint) {\n    74\t    paths.push({\n    75\t      type: 'path', series, xy: buildPath(selection.indexes, selection.breaks, input), stroke: seriesPaint(series),\n    76\t      strokeWidth: 2, dash: cue.dash,\n    77\t    });\n    78\t  }\n    79\t  const markers = markerIndexes(input, visible, singlePoint ? selection.indexes : selection.isolated, compact);\n    80\t  if (markers.length) points.push(pointMark(series, cue, buildPoints(markers, input)));\n    81\t}\n    82\t\n    83\texport function scatterPoints(view: ScatterView, projection: XY): PointMark[] {\n    51\t  expect(arc.fills.at(-1)).toEqual({ kind: 'token', name: 'muted' });\n    52\t  expect(rows(r).map(row => row.slice(0, 2))).toEqual(data.map(row => [row.x, String(row.y)]));\n    53\t  expect(reading(r, walk(r).at(-1)!)).toContain('Other (3)');\n    54\t  expect(lastModel(r).summary).toContain('Other (3): 6');\n    55\t});\n    56\t\n    57\tit('F8 donut: a negative value shows the error state and clears all arcs', () => {\n    58\t  const r = chart('donut', [{ x: 'A', y: 2 }, { x: 'B', y: 1 }]);\n    59\t  r.frames();\n    60\t  r.controller.handle.update({ data: [{ x: 'A', y: 2 }, { x: 'B', y: -1 }] });\n    61\t  r.frames();\n    62\t  expect(codes(r)).toEqual(['AX120']);\n    63\t  expect(marks(r, 'arcs')).toEqual([]);\n    64\t  expect(lastModel(r).message).toBe(defaultMessages.error);\n    65\t  expect(r.announcements).toEqual([defaultMessages.error]);\n    66\t});\n    67\t\n    68\tit('F8 donut: all-zero values show the empty state while the table retains both zero values', () => {\n    69\t  const r = chart('donut', [{ x: 'A', y: 0 }, { x: 'B', y: 0 }]);\n    70\t  r.frames();\n    71\t  expect(codes(r)).toEqual([]);\n    72\t  expect(marks(r, 'arcs')).toEqual([]);\n    73\t  expect(lastModel(r).message).toBe(defaultMessages.empty);\n    74\t  expect(lastModel(r).summary).toContain(defaultMessages.empty);\n    75\t  expect(rows(r).map(row => row.slice(0, 2))).toEqual([['A', '0'], ['B', '0']]);\n    76\t});\n    77\t\n    78\tit('F8 donut: exactly eight slices including zero and null keep both arcless categories readable', () => {\n    79\t  const r = chart('donut', [\n    80\t    ...Array.from({ length: 6 }, (_, i) => ({ x: 'Positive ' + i, y: i + 1 })),\n    81\t    { x: 'Zero', y: 0 }, { x: 'Missing', y: null },\n    82\t  ]);\n    83\t  r.frames();\n    84\t  expect(codes(r)).toEqual([]);\n    85\t  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(12);\n    86\t  expect(rows(r).slice(-2).map(row => row.slice(0, 2))).toEqual([['Zero', '0'], ['Missing', 'No data']]);\n    87\t  expect(walk(r).slice(-2).map(ref => committed(r).lookup.datum(ref)?.seriesLabel)).toEqual(['Zero', 'Missing']);\n    88\t});\n    89\t\n    90\t// F8 was amended so only slices with an arc count toward the limit.\n    91\tit('F8 donut: zero and null slices stay separate and only positive slices count toward the limit', () => {\n    92\t  const positives = Array.from({ length: 9 }, (_, i) => ({ x: 'Slice ' + i, y: i + 1 }));\n    93\t  const zero = { x: 'Zero', y: 0 };\n    94\t  const missing = { x: 'Unknown', y: null };\n    95\t  const r = chart('donut', [...positives.slice(0, 7), zero, missing]);\n    96\t  r.frames();\n    97\t  expect(codes(r)).toEqual([]);\n    98\t  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(14);\n    99\t  expect(rows(r)).toHaveLength(9);\n   100\t  expect(rows(r).slice(-2).map(row => row.slice(0, 2))).toEqual([['Zero', '0'], ['Unknown', 'No data']]);\n   101\t  expect(walk(r).slice(-2).map(ref => committed(r).lookup.datum(ref)?.seriesLabel)).toEqual(['Zero', 'Unknown']);\n   102\t\n   103\t  const grouped = chart('donut', [...positives, zero]);\n   104\t  grouped.frames();\n   105\t  expect(codes(grouped)).toEqual(['AX121']);\n   106\t  expect(grouped.controller.handle.diagnostics[0]?.count).toBe(2);\n   107\t  // Seven individual arcs and the grouped arc are drawn. Zero remains an individual legend entry.\n   108\t  expect(marks(grouped, 'arcs')[0]?.angles).toHaveLength(16);\n   109\t  const labels = walk(grouped).map(ref => committed(grouped).lookup.datum(ref)?.seriesLabel);\n   110\t  expect(labels).toEqual([...positives.slice(2).map(row => row.x), 'Zero', message('otherSlices', { count: 2 })]);\n   111\t  expect(rows(grouped).map(row => row.slice(0, 2))).toEqual([...positives, zero].map(row => [row.x, String(row.y)]));\n   112\t});\n     1\t/**\n     2\t * The compact variant, C1–C5 (spec 3.7), and the rules it keeps from the full charts (C2: F1, F2, F3, F11,\n     3\t * I5, L4), each for all three compact kinds: line, area and bar, which are drawn by different code. Read\n     4\t * from Chrome's accessibility tree, from the drawn marks' positions and from painted pixels.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport { axOf, axWithin, box, closePage, createRaw, devPage, inside, modeColor, prodPage, screenshot, settle, shapes, tabStops, type Box } from './util';\n    10\timport { DIRTY, dirtyRows, missingClauses, withUnit, type Clause } from './fixtures';\n    11\timport { inkColor, strokeRuns, traceMotion } from './checks';\n    12\t\n    13\tbeforeAll(start);\n    14\tafterAll(stop);\n    15\t\n    16\tconst KINDS = ['line', 'area', 'bar'] as const;\n    17\ttype Kind = typeof KINDS[number];\n    18\t\n    19\t/** Five days of one series. */\n    20\tconst VALUES = [12, 15, 11, 18, 16];\n    21\tconst ROWS = VALUES.map((v, i) => ({ day: `2026-03-0${i + 2}`, v }));\n    22\tconst options = (kind: Kind, extra: Record<string, unknown> = {}) => ({ compact: true, title: 'Energy, North', data: ROWS, x: { field: 'day', type: 'date' }, y: { field: 'v', label: 'Energy', unit: 'kWh' }, ...extra, kind });\n    23\t\n    24\tasync function make(page: Page, kind: Kind, extra: Record<string, unknown> = {}, target = '#chart') {\n    25\t  const { kind: fn, ...rest } = options(kind, extra);\n    26\t  return createRaw(page, fn, rest, target);\n    27\t}\n    28\t\n    29\t/** Where each datum is drawn: the bars' tops and centres, or the stroke's vertices (line, and area's upper edge). */\n    30\tasync function datumPoints(page: Page, kind: Kind, selector = '#chart'): Promise<{ x: number; y: number }[]> {\n    31\t  if (kind === 'bar') return ((await shapes(page, selector, 100000))[1] ?? []).map(s => ({ x: s.box.x + s.box.width / 2, y: s.box.y })).sort((a, b) => a.x - b.x);\n    32\t  return (await strokeRuns(page, 1, selector)).flat().sort((a, b) => a.x - b.x);\n    33\t}\n    34\t\n    35\tconst CLAUSES: Clause[] = [\n    36\t  { name: 'x range', fragments: ['day', 'Mar 2, 2026', 'Mar 6, 2026'] },\n    37\t  { name: 'y range', fragments: ['Energy', withUnit(11, 'kWh'), withUnit(18, 'kWh')] },\n    38\t  { name: 'series: minimum, maximum, last', fragments: ['Energy', withUnit(11, 'kWh'), withUnit(18, 'kWh'), withUnit(16, 'kWh')] },\n    39\t];\n    40\t\n    41\tdescribe('C1 a static image with a text alternative', () => {\n    42\t  for (const kind of KINDS) {\n    43\t    it(`C1 compact ${kind}: role img, named by its title, described by the generated summary (each named statement: x range, y range, the series' minimum, maximum and last value), with nothing inside exposed on its own`, async () => {\n    44\t      const page = await devPage({ css: '#chart { width: 200px; height: 48px; }' });\n    45\t      await make(page, kind);\n    46\t      const fig = await axOf(page, '#chart figure');\n    47\t      expect(fig.role).toBe('image');\n    48\t      expect(fig.name).toBe('Energy, North');\n    49\t      expect(missingClauses(fig.description, [{ name: 'type', fragments: [{ line: 'Line', area: 'Area', bar: 'Bar' }[kind]] }, ...CLAUSES]), fig.description).toEqual([]);\n    50\t      expect((await axWithin(page, '#chart figure')).filter(n => !['image', 'StaticText', 'generic', 'paragraph', 'InlineTextBox', 'none'].includes(n.role)).map(n => n.role)).toEqual([]);\n    51\t      expect(await closePage(page)).toEqual([]);\n    52\t    });\n    53\t\n    54\t    for (const build of ['development', 'production'] as const) {\n    55\t      it(`C1 compact ${kind}: without a title the name is generated and AX140 is raised (${build} build)`, async () => {\n    56\t        const page = build === 'development' ? await devPage() : await prodPage();\n    57\t        const built = await make(page, kind, { title: undefined, x: { field: 'day', type: 'date', label: 'Day' } });\n    58\t        expect(built.diagnostics.filter(d => d.code === 'AX140').map(d => d.level)).toEqual(['warning']);\n    59\t        expect((await axOf(page, '#chart figure')).name).toBe(`${{ line: 'Line', area: 'Area', bar: 'Bar' }[kind]} chart of Energy by Day`);\n    60\t        expect(await closePage(page)).toEqual([]);\n    61\t      });\n    62\t    }\n    63\t\n    64\t    it(`C1 compact ${kind}: a page of 40 compact charts adds no tab stop, and pointing at one changes nothing on the page: no element appears, no text changes, no pixel changes`, async () => {\n    65\t      const page = await devPage({ css: '.tile { width: 160px; height: 48px; }' });\n    66\t      await page.evaluate(() => {\n    67\t        const after = document.querySelector('#after')!;\n    68\t        for (let i = 0; i < 40; i++) { const el = document.createElement('div'); el.id = `tile-${i}`; el.className = 'tile'; after.before(el); }\n    69\t      });\n    70\t      for (let i = 0; i < 40; i++) await make(page, kind, { title: `Tile ${i}` }, `#tile-${i}`);\n    71\t      expect(await tabStops(page)).toEqual(['after']);\n    72\t      // Leave nothing focused, so a focus ring on the page's own button does not count as a change.\n    73\t      await page.evaluate(() => (document.activeElement as HTMLElement | null)?.blur());\n    74\t      await settle(page);\n    75\t      const state = () => page.evaluate(() => [...document.querySelectorAll('body *')].filter(e => (e as HTMLElement).offsetParent !== null || e.tagName === 'svg').map(e => `${e.tagName}:${e.getAttribute('class') ?? ''}:${e.children.length ? '' : e.textContent}`).join('\\n'));\n    76\t      const before = { dom: await state(), img: (await screenshot(page, 'body', { x: 0, y: 0, width: 900, height: 700 })).img };\n    77\t      for (const i of [0, 3, 39]) {\n    78\t        const b = await box(page, `#tile-${i}`);\n    79\t        await page.mouse.move(b.x + b.width / 2, b.y + b.height / 2);\n    80\t        await settle(page);\n    81\t        await page.mouse.down();\n    82\t        await page.mouse.up();\n    83\t        await settle(page);\n    84\t      }\n    85\t      expect(await state()).toBe(before.dom);\n    86\t      const after = (await screenshot(page, 'body', { x: 0, y: 0, width: 900, height: 700 })).img;\n    87\t      let differing = 0, x0 = Infinity, y0 = Infinity, x1 = -1, y1 = -1;\n    88\t      for (let k = 0; k < after.data.length; k += 4) if (after.data[k] !== before.img.data[k] || after.data[k + 1] !== before.img.data[k + 1] || after.data[k + 2] !== before.img.data[k + 2]) { differing++; const x = (k / 4) % after.width, y = Math.floor(k / 4 / after.width); x0 = Math.min(x0, x); y0 = Math.min(y0, y); x1 = Math.max(x1, x); y1 = Math.max(y1, y); }\n    89\t      expect(differing, `pixels changed in ${x0},${y0}–${x1},${y1}`).toBe(0);\n    90\t      expect(await closePage(page)).toEqual([]);\n    91\t    });\n    92\t  }\n    93\t});\n    94\t\n    95\tdescribe('C2 the fidelity rules hold', () => {\n","exit_code":0,"status":"completed"}}
