del.primary(target)).toEqual(point('S9', 9, 24.1));\n  expect(model.tooltip(target).rows).toHaveLength(8);\n  expect(model.tooltip(target).count).toBe(10);\n  expect(model.tooltip(target).rows.some(row => row.seriesLabel === 'Different')).toBe(false);\n});\n\nit('keeps the earliest of ten coincident rows addressable when a pointer pick omits it', () => {\n  const data = frame('scatter', { x: 'x', y: 'y', series: 's',\n    data: Array.from({ length: 10 }, (_, i) => ({ x: 20, y: 40, s: `S${i}` })),\n  });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const earliest = point('S0', 0, 20);\n  expect(model.step(null, 'first')).toEqual(earliest);\n  expect(model.resolve(earliest)).toBe(earliest);\n  expect(model.ordinal(earliest)).toBe(0);\n  expect(model.datum(earliest)).toMatchObject({ ref: earliest, seriesLabel: 'S0', x: '20', value: '40', row: 0 });\n  expect(model.anchor(earliest)).toEqual({ x: 20, y: 40, width: 0, height: 0 });\n  const picked = model.pick(20, 40);\n  if (picked?.kind !== 'point') throw new Error('Expected scatter target');\n  expect(picked.count).toBe(10);\n  expect(picked.refs).toHaveLength(8);\n  expect(picked.refs).not.toContainEqual(earliest);\n  expect(model.tooltip(picked)).toMatchObject({ count: 10 });\n});\n\nit('uses screen distance when moving to the neighbouring visible series', () => {\n  const data = frame('scatter', { x: 'x', y: 'y', series: 'series', data: [\n    { x: 10, y: 30, series: 'A' }, { x: 11, y: 31, series: 'Hidden' },\n    { x: 10, y: 80, series: 'B' }, { x: 12, y: 31, series: 'B' },\n  ] });\n  const model = buildLookup(scatter(data, { visible: [true, false, true] }), layout, formatter(data), defaultMessages);\n  expect(model.count).toBe(3);\n  expect(model.step(point('A', 0, 10), 'next')).toEqual(point('B', 2, 10));\n  expect(model.step(point('A', 0, 10), 'series-next')).toEqual(point('B', 3, 12));\n  expect(model.step(point('B', 3, 12), 'series-previous')).toEqual(point('A', 0, 10));\n});\n\nit('examines only nearby cells on a 200,000-point pick', () => {\n  const size = 200_000;\n  const x = Float64Array.from({ length: size }, (_, i) => i);\n  const y = Float64Array.from(x, i => i % 521);\n  const data = frame('scatter', { data: { columns: { x, y } }, x: 'x', y: 'y' });\n  const projection = { kind: 'xy', x: linearScale([0, size - 1], [0, 1200]), y: linearScale([0, 520], [520, 0]) } as const;\n  const model = scatterLookup(scatter(data), plot(projection, 1200, 520), formatter(data));\n  const i = 98_765;\n  expect(model.primary(model.pick(projection.x.map(i), 520 - (i % 521))!)).toEqual(point('y', i, i));\n  expect(model.lastPickCandidates).toBeGreaterThan(0);\n  expect(model.lastPickCandidates).toBeLessThan(5_000);\n});\n\nit('resolves hidden and zoomed-out scatter refs and steps from the replacement', () => {\n  const data = points([[[0, 5], [2, 3], [4, 8], [6, 1]], [[2, 99]], [[2, 4], [4, 1]]]);\n  const view = scatter(data, {\n    visible: [true, false, true], xDomain: [2, 4],\n    visiblePoints: [{ start: 1, end: 3 }, { start: 0, end: 1 }, { start: 0, end: 2 }],\n  });\n  const model = buildLookup(view, layout, formatter(data), defaultMessages);\n  expect(model.resolve(point('S1', 4, 2))).toEqual(point('S0', 1, 2));\n  expect(model.step(point('S1', 4, 2), 'next')).toEqual(point('S2', 5, 2));\n  expect(model.resolve(point('S0', 0, 0))).toEqual(point('S0', 1, 2));\n  expect(model.resolve(point('S0', 3, 6))).toEqual(point('S0', 2, 4));\n  expect(model.resolve(point('S0', 99, 2))).toEqual(point('S0', 2, 4));\n  expect(model.step(point('S0', 0, 0), 'next')).toEqual(point('S2', 5, 2));\n  expect(model.step(point('S0', 3, 6), 'previous')).toEqual(point('S2', 6, 4));\n  expect(model.step(point('S0', 2, 4), 'page-next')).toBeNull();\n  expect(model.step(point('S0', 1, 2), 'page-previous')).toBeNull();\n});\n\nit('bounds a pick in a cell of 200,000 coincident points and reports the full count', () => {\n  const size = 200_000;\n  const base = points([[]]);\n  const data = { ...base, series: [{\n    ...base.series[0]!, x: new Float64Array(size).fill(23.9), y: new Float64Array(size).fill(50), row: null,\n  }] };\n  const model = scatterLookup(scatter(data), layout, formatter(data));\n  const target = model.pick(24.1, 50);\n  expect(target).toMatchObject({ kind: 'point', count: size });\n  expect(model.primary(target!)).toEqual(point('S0', size - 1, 23.9));\n  expect(model.tooltip(target!).rows).toHaveLength(8);\n  expect(model.lastPickCandidates).toBeLessThan(3_000);\n});\n\nit('bounds the points visited for 10,000 identical marks mixed with 190,000 other points in one cell', () => {\n  const size = 200_000;\n  const copies = 10_000;\n  const base = points([[]]);\n  const data = { ...base, series: [{\n    ...base.series[0]!,\n    x: new Float64Array(size).fill(50, 0, copies),\n    y: new Float64Array(size).fill(50, 0, copies + 1),\n    row: null,\n  }] };\n  const { x: xs, y: ys } = data.series[0]!;\n  // The boundary point is exactly 0.5 px away and the rest fill the same cell beyond its own radius.\n  xs[copies] = 50.5;\n  for (let i = copies + 1; i < size; i++) {\n    const j = i - copies - 1;\n    xs[i] = 51.01 + Math.floor(j / 400) / 1000;\n    ys[i] = 50.01 + (j % 400) / 1000;\n  }\n  const axis = linearScale([0, 128], [0, 128]);\n  const model = scatterLookup(scatter(data), plot({ kind: 'xy', x: axis, y: axis }, 128, 128), formatter(data));\n  for (const [x, row] of [[50, copies - 1], [50.5, copies]] as const) {\n    const target = model.pick(x, 50);\n    expect(target).toMatchObject({ kind: 'point', count: copies + 1 });\n    expect(model.primary(target!)).toEqual(point('S0', row, x));\n    expect(model.tooltip(target!).rows).toHaveLength(8);\n    expect(model.lastPickCandidates).toBeLessThanOrEqual(12);\n  }\n});\n\nit('visits the binary-search window when switching series and locates recreated refs by x', () => {\n  const n = 80_000;\n  const data = points([Array.from({ length: n }, (_, x) => [n - x, 20] as const),\n    Array.from({ length: n }, (_, x) => [x, 20] as const)]);\n  const work = { locations: 0, seriesCandidates: 0, orderComparisons: 0 };\n  const scale = linearScale([0, n], [0, 100]);\n  let maps = 0;\n  const projection = { kind: 'xy' as const, x: { ...scale, map(x: number) { maps++; return scale.map(x); } }, y: scale };\n  const model = scatterLookup(scatter(data), plot(projection), formatter(data), work);\n  maps = 0;\n  expect(model.step(point('S0', 40_000, 40_000), 'series-next')).toEqual(point('S1', 120_000, 40_000));\n  expect(maps).toBeLessThan(20);\n  expect(work.locations).toBeGreaterThan(0);\n  expect(work.locations).toBeLessThan(20);\n  expect(work.seriesCandidates).toBeGreaterThan(0);\n  expect(work.seriesCandidates).toBeLessThan(20);\n});\n\nit('walks partial ranges with hidden series and duplicate x and y in fixture order', () => {\n  const pair = fc.tuple(fc.nat(5), fc.nat(4));\n  fc.assert(fc.property(fc.array(fc.array(pair, { minLength: 2, maxLength: 17 }),\n    { minLength: 3, maxLength: 6 }), fc.boolean(), (lists, trim) => {\n    const data = points(lists);\n    const visible = lists.map((_, s) => s !== 1);\n    const visiblePoints = data.series.map(({ x }) => ({ start: trim ? 1 : 0, end: x.length }));\n    const model = buildLookup(scatter(data, { visible, visiblePoints }), layout, formatter(data), defaultMessages);\n    const expected = data.series.flatMap((series, s) => visible[s] ? Array.from(series.x).flatMap((x, i) => i >= visiblePoints[s]!.start\n      ? [{ x, y: series.y[i]!, row: series.row![i]!, s, i }] : []) : [])\n      .sort((a, b) => a.x - b.x || a.y - b.y || a.s - b.s || a.i - b.i);\n    expect(model.count).toBe(expected.length);\n    let next = model.step(null, 'next');\n    for (const [i, row] of expected.entries()) {\n      expect(next).toEqual(point(`S${row.s}`, row.row, row.x));\n      expect(model.ordinal(next!)).toBe(i);\n      expect(model.datum(next!)?.value).toBe(String(row.y));\n      expect(model.step(next, 'previous')).toEqual(i === 0 ? null\n        : point(`S${expected[i - 1]!.s}`, expected[i - 1]!.row, expected[i - 1]!.x));\n      const distance = Math.max(1, Math.floor(expected.length / 10));\n      const page = expected[Math.min(expected.length - 1, i + distance)]!;\n      expect(model.step(next, 'page-next')).toEqual(i === expected.length - 1 ? null : point(`S${page.s}`, page.row, page.x));\n      next = model.step(next, 'next');\n    }\n    expect(next).toBeNull();\n  }), { numRuns: 60 });\n});\n\nit('uses one set of grid cells for a dense noncoincident pick and its neighbours', () => {\n  const width = 500;\n  const size = width * 400;\n  const base = points([[]]);\n  const data = { ...base, series: [{\n    ...base.series[0]!,\n    x: Float64Array.from({ length: size }, (_, i) => 20 + Math.floor(i / 400) / 100),\n    y: Float64Array.from({ length: size }, (_, i) => 48 + (i % 400) / 100),\n    row: null,\n  }] };\n  const scale = linearScale([0, 128], [0, 128]);\n  const layout = plot({ kind: 'xy', x: scale, y: scale });\n  const x = 24, y = 50;\n  const { x: xs, y: ys } = data.series[0]!;\n  let latestTie = 400 * 400 + 200;\n  for (let i = 0; i < size; i++) {\n    if (Math.hypot(xs[i]! - x, ys[i]! - y) < 0.5) latestTie = i;\n  }\n  for (const [ratio, row] of [[exactRatio, 400 * 400 + 200], [1, latestTie]] as const) {\n    const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio);\n    let expected = 0;\n    for (let i = 0; i < size; i++) {\n      if ((xs[i]! - xs[row]!) ** 2 + (ys[i]! - ys[row]!) ** 2 <= 0.5 ** 2) expected++;\n    }\n    const target = model.pick(x, y);\n    expect(target).toMatchObject({ kind: 'point', count: expected });\n    expect(model.primary(target!)).toEqual(point('S0', row, xs[row]!));\n    expect(model.lastPickCells).toBeLessThanOrEqual(16);\n    expect(model.lastPickCandidates).toBeLessThan(3_000);\n  }\n});\n\nit('finds next and previous by one binary successor search per series', () => {\n  const seriesCount = 500;\n  const rows = 400;\n  const base = points([[]]);\n  const data = { ...base, series: Array.from({ length: seriesCount }, (_, s) => ({\n    key: `S${s}`, label: `S${s}`, drawable: true,\n    x: Float64Array.from({ length: rows }, (_, i) => i), y: new Float64Array(rows).fill(s), row: null,\n  })) };\n  const work = { locations: 0, seriesCandidates: 0, orderComparisons: 0 };\n  const model = scatterLookup(scatter(data), null, formatter(data), work);\n  const from = point('S250', 398, 398);\n  expect(model.step(from, 'next')).toEqual(point('S251', 398, 398));\n  expect(work.orderComparisons).toBeGreaterThan(0);\n  expect(work.orderComparisons).toBeLessThanOrEqual(seriesCount * 10);\n  work.orderComparisons = 0;\n  expect(model.step(from, 'previous')).toEqual(point('S249', 398, 398));\n  expect(work.orderComparisons).toBeGreaterThan(0);\n  expect(work.orderComparisons).toBeLessThanOrEqual(seriesCount * 10);\n});\n\n// The lattice rule of `Lookup.pick`: every drawn point is compared at its position rounded to the nearest\n// device pixel; the closest within 24 px wins, compared points within half a device pixel of that distance\n// tie and the latest source row wins, and the count is every point whose rounded position is within 0.5 px\n// of the winner's.\ninterface Drawn { readonly x: number; readonly y: number; readonly ref: Extract<DatumRef, { kind: 'point' }> }\nfunction latticeOracle(drawn: readonly Drawn[], px: number, py: number, ratio: number) {\n  const snapped = drawn.map(d => ({ ...d, x: Math.round(d.x * ratio) / ratio, y: Math.round(d.y * ratio) / ratio }))\n    .map(d => ({ ...d, distance: (d.x - px) ** 2 + (d.y - py) ** 2 }));\n  let nearest = snapped[0]!;\n  for (const d of snapped) if (d.distance < nearest.distance) nearest = d;\n  if (nearest.distance > 24 ** 2) return null;\n  let winner = nearest;\n  for (const d of snapped) {\n    const tied = d.distance <= 24 ** 2 && Math.sqrt(d.distance) - Math.sqrt(nearest.distance) < 0.5 / ratio;\n    if (tied && d.ref.row > winner.ref.row) winner = d;\n  }\n  const coincident = snapped.filter(d => (d.x - winner.x) ** 2 + (d.y - winner.y) ** 2 <= 0.5 ** 2);\n  return { winner: winner.ref, coincident: coincident.map(d => d.ref) };\n}\n\nfunction cloud(positions: readonly (readonly [number, number])[], sourceRows?: readonly number[]): { data: PointFrame; drawn: Drawn[] } {\n  const data = points([positions], sourceRows);\n  const s = data.series[0]!;\n  const drawn = Array.from(s.x, (x, i) => ({ x, y: s.y[i]!, ref: point('S0', s.row![i]!, x) }));\n  return { data, drawn };\n}\n\nfunction expectLattice(target: ReturnType<ReturnType<typeof scatterLookup>['pick']>, expected: ReturnType<typeof latticeOracle>) {\n  if (!expected) return expect(target).toBeNull();\n  if (target?.kind !== 'point') throw new Error('Expected a scatter target');\n  expect(target.refs[0]).toEqual(expected.winner);\n  expect(target.count).toBe(expected.coincident.length);\n  expect(target.refs).toHaveLength(Math.min(8, expected.coincident.length));\n  expect(new Set(target.refs.map(ref => ref.kind === 'point' && ref.row)).size).toBe(target.refs.length);\n  expect(expected.coincident).toEqual(expect.arrayContaining([...target.refs]));\n}\n\nit('agrees with a brute-force pick under the device-pixel lattice rule', () => {\n  const axis = linearScale([0, 64], [0, 64]);\n  const layout = plot({ kind: 'xy', x: axis, y: axis }, 64, 64);\n  // Positions on a 1/16 px grid in a 12 px square crowd several points into each device pixel.\n  const position = fc.tuple(fc.integer({ min: 0, max: 192 }), fc.integer({ min: 0, max: 192 }))\n    .map(([x, y]) => [26 + x / 16, 26 + y / 16] as const);\n  fc.assert(fc.property(\n    fc.array(position, { minLength: 1, maxLength: 120 }), fc.nat(), fc.constantFrom(1, 1.25, 1.5, 2, 3),\n    fc.tuple(fc.integer({ min: -400, max: 400 }), fc.integer({ min: -400, max: 400 })),\n    (positions, seed, ratio, [dx, dy]) => {\n      const rows = Array.from(positions, (_, i) => i);\n      let random = seed;\n      for (let i = rows.length - 1; i > 0; i--) {\n        random = (Math.imul(1664525, random) + 1013904223) >>> 0;\n        const j = random % (i + 1);\n        [rows[i], rows[j]] = [rows[j]!, rows[i]!];\n      }\n      const { data, drawn } = cloud(positions, rows);\n      const witness = drawn[seed % drawn.length]!;\n      const px = clamp(witness.x + dx / 16, 0, 64);\n      const py = clamp(witness.y + dy / 16, 0, 64);\n      const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio, { exactBudget: 0 });\n      expectLattice(model.pick(px, py), latticeOracle(drawn, px, py, ratio));\n      expect(model.lastPickLattice).toBe(true);\n    },\n  ), { numRuns: 1_500 });\n});\n\ndescribe('a pick visits a number of index entries bounded by the radius and the pixel ratio', () => {\n  const axis = linearScale([0, 200], [0, 200]);\n  const layout = plot({ kind: 'xy', x: axis, y: axis }, 200, 200);\n  // The exact attempt may spend the lattice points of the 49 px pick square; the lattice pick visits at most\n  // the occupied lattice points near the pointer.\n  const bound = (ratio: number) => 2 * (Math.ceil(49 * ratio) + 1) ** 2;\n\n  it.each([[32_000, 1], [32_000, 2], [200_000, 1], [200_000, 2]])('%i points on a 20 px ring around the pointer at ratio %i', (size, ratio) => {\n    const positions = Array.from({ length: size }, (_, i) =>\n      [100 + 20 * Math.cos(2 * Math.PI * i / size), 100 + 20 * Math.sin(2 * Math.PI * i / size)] as const);\n    const { data, drawn } = cloud(positions);\n    const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio);\n    const target = model.pick(100, 100);\n    expect(model.lastPickLattice).toBe(true);\n    expect(model.lastPickCandidates).toBeLessThanOrEqual(bound(ratio));\n    expectLattice(target, latticeOracle(drawn, 100, 100, ratio));\n    // A second pick reuses the lattice index and does the same bounded work.\n    const visits = model.lastPickCandidates;\n    model.pick(100, 100);\n    expect(model.lastPickCandidates).toBe(visits);\n  });\n\n  it.each([1, 2, 3])('200,000 points in a dense 40 px cluster at ratio %i, exact and on the lattice', ratio => {\n    let random = 7;\n    const next = () => (random = (Math.imul(1664525, random) + 1013904223) >>> 0) / 2 ** 32;\n    const positions = Array.from({ length: 200_000 }, () => [80 + 40 * next(), 80 + 40 * next()] as const);\n    const { data, drawn } = cloud(positions);\n    for (const exactBudget of [undefined, 0]) {\n      const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio, { exactBudget });\n      const target = model.pick(100.3, 100.2);\n      expect(target).not.toBeNull();\n      expect(model.lastPickCandidates).toBeLessThanOrEqual(exactBudget === 0 ? bound(ratio) / 2 : bound(ratio));\n      if (model.lastPickLattice) expectLattice(target, latticeOracle(drawn, 100.3, 100.2, ratio));\n    }\n  });\n});\n\ndescribe('a pointer up to 1 CSS px outside the plot picks as on its edge (decision 0004, clarifications)', () => {\n  // The type-matrix case: a point drawn on the top edge at y 82.267, the pointer reported at y 82.\n  const rect = { x: 65.6, y: 82.267, width: 300.4, height: 150.3 };\n  const right = rect.x + rect.width;\n  const bottom = rect.y + rect.height;\n  const layout = scatterLayout(rect, [0, 10], [0, 10]);\n  const onEdges = [[0, 0], [10, 0], [0, 10], [10, 10], [5, 0], [5, 10], [0, 5], [10, 5]] as const;\n  const data = points([onEdges]);\n  const { x: px, y: py } = layout.projection;\n  // Outward direction of each edge point (corners go out diagonally).\n  const outward = onEdges.map(([x, y]) => [x === 0 ? -1 : x === 10 ? 1 : 0, y === 0 ? 1 : y === 10 ? -1 : 0] as const);\n  const settings = [[1, undefined], [2, undefined], [1, 0], [2, 0], [exactRatio, undefined]] as const;\n  const clamp2 = (x: number, y: number) => [clamp(x, rect.x, right), clamp(y, rect.y, bottom)] as const;\n\n  it.each(settings)('at ratio %s (exact budget %s): 0.27, 0.99 and 1 px outside pick what the edge picks; 1.01 px nothing', (ratio, exactBudget) => {\n    const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio, { exactBudget });\n    onEdges.forEach(([x, y], i) => {\n      const ex = px.map(x);\n      const ey = py.map(y);\n      const [dx, dy] = outward[i]!;\n      const edge = model.pick(ex, ey);\n      expect(edge).toMatchObject({ kind: 'point', refs: [point('S0', i, x)] });\n      for (const distance of [0.27, 0.99, 1]) {\n        // Along one axis, and (for a corner) along both.\n        if (dx) expect(model.pick(ex + dx * distance, ey)).toEqual(edge);\n        if (dy) expect(model.pick(ex, ey + dy * distance)).toEqual(edge);\n        expect(model.pick(ex + dx * distance, ey + dy * distance)).toEqual(edge);\n      }\n      if (dx) expect(model.pick(ex + dx * 1.01, ey)).toBeNull();\n      if (dy) expect(model.pick(ex, ey + dy * 1.01)).toBeNull();\n    });\n  });\n\n  it('for any data and any position within 1 px outside, the pick is the pick at the position moved onto the rectangle', () => {\n    const coordinate = fc.oneof(fc.constant(0), fc.constant(10), fc.integer({ min: 0, max: 1000 }).map(n => n / 100));\n    const unit = fc.oneof(fc.double({ min: 0, max: 1, noNaN: true }), fc.constantFrom(0, 1));\n    fc.assert(fc.property(fc.array(fc.tuple(coordinate, coordinate), { minLength: 1, maxLength: 40 }), unit, unit,\n      fc.constantFrom(...settings), (list, u, v, [ratio, exactBudget]) => {\n        const cloud = points([list]);\n        const model = scatterLookup(scatter(cloud), layout, formatter(cloud), undefined, ratio, { exactBudget });\n        const x = rect.x - 1 + u * (rect.width + 2);\n        const y = rect.y - 1 + v * (rect.height + 2);\n        expect(model.pick(x, y)).toEqual(model.pick(...clamp2(x, y)));\n      }), { numRuns: 1_000 });\n  });\n});\n\ndescribe('a pointer move does no data-sized work (final review, finding 8; verification, finding 7)', () => {\n  // Typed-array bytes allocated while `action` runs: an index built for the data would show here.\n  function allocated(action: () => void): number {\n    let bytes = 0;\n    const restore: (() => void)[] = [];\n    for (const name of ['Float64Array', 'Float32Array', 'Int32Array', 'Uint32Array', 'Uint8Array'] as const) {\n      const original = globalThis[name];\n      const counted = new Proxy(original, {\n        construct(target, args, newTarget) {\n          const result = Reflect.construct(target, args, newTarget) as InstanceType<typeof original>;\n          if (!(args[0] instanceof ArrayBuffer)) bytes += result.byteLength;\n          return result;\n        },\n      });\n      Object.defineProperty(globalThis, name, { value: counted });\n      Object.defineProperty(original.prototype, 'constructor', { value: counted });\n      restore.push(() => {\n        Object.defineProperty(original.prototype, 'constructor', { value: original });\n        Object.defineProperty(globalThis, name, { value: original });\n      });\n    }\n    try {\n      action();\n    } finally {\n      restore.forEach(undo => undo());\n    }\n    return bytes;\n  }\n\n  it.each([1, 2])('the first pick at the centre of a 32,000-point ring at ratio %i', ratio => {\n    const size = 32_000;\n    const axis = linearScale([0, 200], [0, 200]);\n    const layout = plot({ kind: 'xy', x: axis, y: axis }, 200, 200);\n    const data = points([Array.from({ length: size }, (_, i) =>\n      [100 + 20 * Math.cos(2 * Math.PI * i / size), 100 + 20 * Math.sin(2 * Math.PI * i / size)] as const)]);\n    const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio);\n    let target: ReturnType<typeof model.pick> = null;\n    // One position per point would be 256,000 bytes; the pick may allocate only what is near the pointer.\n    expect(allocated(() => { target = model.pick(100, 100); })).toBeLessThan(16 * 1_024);\n    expect(target).not.toBeNull();\n    expect(model.lastPickLattice).toBe(true);\n  });\n});\n\ndescribe('the lookup answers what a point group is: members, has and slot (round 3)', () => {\n  const settings = [[1, undefined], [2, undefined], [1, 0], [2, 0], [exactRatio, undefined]] as const;\n  type Model = ReturnType<typeof scatterLookup>;\n  const key = (ref: DatumRef) => JSON.stringify(ref);\n\n  function checkGroup(model: Model, target: Extract<PickTarget, { kind: 'point' }>, candidates: readonly DatumRef[]) {\n    const all = model.members(target, 0, target.count);\n    // Every member once, the first ref first, `count` of them; the tooltip's eight are the first eight.\n    expect(all).toHaveLength(target.count);\n    expect(new Set(all.map(key)).size).toBe(all.length);\n    expect(all[0]).toEqual(target.refs[0]);\n    expect(model.members(target, 0, 8)).toEqual(target.refs);\n    expect(model.tooltip(target).rows.map(row => row.ref)).toEqual(model.members(target, 0, 8));\n    // Paging in threes gives the same list; past the end gives nothing.\n    const paged = Array.from({ length: Math.ceil(target.count / 3) }, (_, page) => model.members(target, 3 * page, 3)).flat();\n    expect(paged).toEqual(all);\n    expect(model.members(target, target.count, 8)).toEqual([]);\n    // has agrees with members for every ref, a member rebuilt by the caller included.\n    const members = new Set(all.map(key));\n    for (const ref of candidates) expect(model.has(target, ref), key(ref)).toBe(members.has(key(ref)));\n    for (const ref of all) expect(model.has(target, { ...ref })).toBe(true);\n  }\n\n  it('for interleaved near-coincident points of two series, exact and on the lattice', () => {\n    const near = fc.tuple(fc.integer({ min: 0, max: 12 }), fc.integer({ min: 0, max: 12 })).map(([x, y]) => [40 + x / 16, 40 + y / 16] as const);\n    fc.assert(fc.property(fc.array(near, { minLength: 1, maxLength: 30 }), fc.array(near, { maxLength: 30 }), fc.nat(),\n      fc.constantFrom(...settings), fc.tuple(fc.integer({ min: -8, max: 8 }), fc.integer({ min: -8, max: 8 })),\n      (a, b, seed, [ratio, exactBudget], [dx, dy]) => {\n        const length = a.length + b.length;\n        const rows = Array.from({ length }, (_, i) => i);\n        let random = seed;\n        for (let i = length - 1; i > 0; i--) {\n          random = (Math.imul(1664525, random) + 1013904223) >>> 0;\n          const j = random % (i + 1);\n          [rows[i], rows[j]] = [rows[j]!, rows[i]!];\n        }\n        const data = points([a, b], rows);\n        const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio, { exactBudget });\n        const target = model.pick(40.4 + dx / 16, 40.4 + dy / 16);\n        if (target?.kind !== 'point') throw new Error('Expected a point target');\n        expect(target.rule ?? 'exact').toBe(model.lastPickLattice ? 'lattice' : 'exact');\n        const candidates = data.series.flatMap(series => Array.from(series.x, (x, i) => point(series.key, series.row![i]!, x)));\n        checkGroup(model, target, candidates);\n        for (const ref of candidates) {\n          const s = data.series.findIndex(series => series.key === (ref as { seriesKey: string }).seriesKey);\n          expect(model.slot(ref)).toBe(Array.from(data.series[s]!.row!).indexOf((ref as { row: number }).row));\n        }\n      }), { numRuns: 800 });\n  });\n\n  it('a point clipped by the y domain beside drawn ones is not a member (I8)', () => {\n    // y 100 is drawn on the plot's edge at 100 px; y 100.004 is outside the domain, a fraction of a pixel past it.\n    const data = points([[[50, 100], [50, 100.004]], [[50, 100]]]);\n    for (const [ratio, exactBudget] of settings) {\n      const model = scatterLookup(scatter(data, { yDomain: [0, 100] }), layout, formatter(data), undefined, ratio, { exactBudget });\n      const target = model.pick(50, 100);\n      if (target?.kind !== 'point') throw new Error('Expected a point target');\n      expect(target.count).toBe(2);\n      const clipped = point('S0', 1, 50);\n      expect(model.has(target, clipped)).toBe(false);\n      expect(model.members(target, 0, 8)).not.toContainEqual(clipped);\n      checkGroup(model, target, [point('S0', 0, 50), clipped, point('S1', 2, 50)]);\n      expect(model.slot(clipped)).toBe(1);\n    }\n  });\n\n  it('the 32,000-point ring at ratio 1: the winning lattice group\\'s page two is its other members (R3)', () => {\n    const size = 32_000;\n    const axis = linearScale([0, 200], [0, 200]);\n    const ring = points([Array.from({ length: size }, (_, i) =>\n      [100 + 20 * Math.cos(2 * Math.PI * i / size), 100 + 20 * Math.sin(2 * Math.PI * i / size)] as const)]);\n    const model = scatterLookup(scatter(ring), plot({ kind: 'xy', x: axis, y: axis }, 200, 200), formatter(ring), undefined, 1);\n    const target = model.pick(100, 100);\n    if (target?.kind !== 'point') throw new Error('Expected a point target');\n    expect(target.rule).toBe('lattice');\n    expect(target.count).toBe(14);\n    const two = model.members(target, 8, 8);\n    expect(two).toHaveLength(6);\n    const one = new Set(target.refs.map(key));\n    expect(two.some(ref => one.has(key(ref)))).toBe(false);\n    for (const ref of two) expect(model.has(target, ref)).toBe(true);\n    checkGroup(model, target, model.members(target, 0, 14));\n  });\n\n  it('has does not walk a group of 50,000 coincident points; a second page reads about 16 entries (R5)', () => {\n    const size = 50_000;\n    const base = points([[]]);\n    const data = { ...base, series: [{\n      ...base.series[0]!, x: new Float64Array(size).fill(30), y: new Float64Array(size).fill(30),\n      row: Int32Array.from({ length: size }, (_, i) => size - 1 - i),\n    }] };\n    const work = { locations: 0, seriesCandidates: 0, orderComparisons: 0 };\n    const model = scatterLookup(scatter(data), layout, formatter(data), work);\n    const target = model.pick(30, 30);\n    if (target?.kind !== 'point') throw new Error('Expected a point target');\n    expect(target.count).toBe(size);\n    work.locations = 0;\n    // Refs rebuilt by the caller, as a held selection would be.\n    expect(model.has(target, point('S0', 12_345, 30))).toBe(true);\n    expect(model.has(target, point('S0', size, 30))).toBe(false);\n    expect(model.has({ ...target, refs: [point('S0', 7, 30)] }, point('S0', 49_000, 30))).toBe(true);\n    expect(work.locations).toBe(0);\n    const page = model.members(target, 8, 8);\n    expect(page).toHaveLength(8);\n    expect(model.lastMembersRead).toBeLessThanOrEqual(2 * 16);\n    expect(model.members(target, 49_992, 8)).toHaveLength(8);\n  });\n});\n\nit('aligned and donut lookups answer members, has and slot from the tooltip\\'s own rows', async () => {\n  const { aligned: alignedView, donut: donutView, frame: frameOf } = await import('./fixtures');\n  const data = frameOf('line', { data: [0, 1, 2].map(x => ({ x, a: x, b: x + 1, c: null })), x: 'x', y: ['a', 'b', 'c'] });\n  const view = alignedView(data, { visible: [true, false, true] });\n  const model = buildLookup(view, plot({ kind: 'xy', x: linearScale([0, 2], [0, 100]), y: linearScale([0, 3], [100, 0]) }), formatter(data), defaultMessages);\n  const target = { kind: 'x', x: 1 } as const;\n  expect(model.members(target, 0, 8)).toEqual(model.tooltip(target).rows.map(row => row.ref));\n  expect(model.members(target, 0, 8)).toEqual([{ kind: 'aligned', seriesKey: 'a', x: 1 }, { kind: 'aligned', seriesKey: 'c', x: 1 }]);\n  expect(model.members(target, 1, 8)).toEqual([{ kind: 'aligned', seriesKey: 'c', x: 1 }]);\n  expect(model.has(target, { kind: 'aligned', seriesKey: 'a', x: 1 })).toBe(true);\n  expect(model.has(target, { kind: 'aligned', seriesKey: 'b', x: 1 })).toBe(false);\n  expect(model.has(target, { kind: 'aligned', seriesKey: 'a', x: 2 })).toBe(false);\n  expect(model.slot({ kind: 'aligned', seriesKey: 'b', x: 2 })).toBe(2);\n  expect(model.slot({ kind: 'aligned', seriesKey: 'b', x: 7 })).toBe(-1);\n  expect(model.slot({ kind: 'aligned', seriesKey: 'z', x: 2 })).toBe(-1);\n\n  const slices = frameOf('donut', { data: [{ k: 'A', v: 2 }, { k: 'B', v: 3 }], label: 'k', value: 'v' });\n  const ring = buildLookup(donutView(slices), plot({ kind: 'ring', cx: 50, cy: 50, r0: 20, r1: 40 }), formatter(slices), defaultMessages);\n  const slice = { kind: 'slice', sliceKey: 'B' } as const;\n  expect(ring.members(slice, 0, 8)).toEqual(ring.tooltip(slice).rows.map(row => row.ref));\n  expect(ring.members(slice, 1, 8)).toEqual([]);\n  expect(ring.has(slice, slice)).toBe(true);\n  expect(ring.has(slice, { kind: 'slice', sliceKey: 'A' })).toBe(false);\n  expect(ring.slot(slice)).toBe(1);\n  expect(ring.slot({ kind: 'slice', sliceKey: 'Z' })).toBe(-1);\n});\n\ndescribe('a narrow view of a large scatter frame builds its lookup from what it shows (final check, item 6)', () => {\n  // A multi-month frame: 1,000 dates with 50 measurements each, explicit source rows; the view shows one date.\n  const dates = 1_000;\n  const perDate = 50;\n  const size = dates * perDate;\n  const base = points([[]]);\n  const data = { ...base, series: [{\n    ...base.series[0]!,\n    x: Float64Array.from({ length: size }, (_, i) => Math.floor(i / perDate)),\n    y: Float64Array.from({ length: size }, (_, i) => i % perDate),\n    row: Int32Array.from({ length: size }, (_, i) => i),\n  }] };\n  const layoutFor = (day: number) => plot({ kind: 'xy', x: linearScale([day - 0.5, day + 0.5], [0, 100]), y: linearScale([0, perDate], [100, 0]) });\n  const viewOf = (day: number) => scatter(data, { xDomain: [day - 0.5, day + 0.5], visiblePoints: [{ start: day * perDate, end: (day + 1) * perDate }] });\n\n  // Typed-array bytes and Map entries made while `action` runs.\n  function work(action: () => void): { bytes: number; entries: number } {\n    let bytes = 0;\n    const restore: (() => void)[] = [];\n    for (const name of ['Float64Array', 'Int32Array', 'Uint32Array', 'Uint8Array'] as const) {\n      const original = globalThis[name];\n      const counted = new Proxy(original, {\n        construct(target, args, newTarget) {\n          const result = Reflect.construct(target, args, newTarget) as InstanceType<typeof original>;\n          if (!(args[0] instanceof ArrayBuffer)) bytes += result.byteLength;\n          return result;\n        },\n      });\n      Object.defineProperty(globalThis, name, { value: counted });\n      Object.defineProperty(original.prototype, 'constructor', { value: counted });\n      restore.push(() => {\n        Object.defineProperty(original.prototype, 'constructor', { value: original });\n        Object.defineProperty(globalThis, name, { value: original });\n      });\n    }\n    let entries = 0;\n    const set = Map.prototype.set;\n    Map.prototype.set = function (this: Map<unknown, unknown>, key: unknown, value: unknown) {\n      entries++;\n      return set.call(this, key, value);\n    };\n    try {\n      action();\n    } finally {\n      Map.prototype.set = set;\n      restore.forEach(undo => undo());\n    }\n    return { bytes, entries };\n  }\n\n  it('zooming and panning to one date: the work does not grow with the 49,950 points outside the view', () => {\n    // The first view of the frame may index its source rows once; every later view reuses that.\n    scatterLookup(viewOf(10), layoutFor(10), formatter(data));\n    for (const day of [500, 501, 999]) {\n      let model: ReturnType<typeof scatterLookup> | null = null;\n      const spent = work(() => { model = scatterLookup(viewOf(day), layoutFor(day), formatter(data)); });\n      // One shown date is 50 points: about 50 × 8-byte entries per column, never 50,000.\n      expect(spent.bytes).toBeLessThan(64 * perDate * 8);\n      expect(spent.entries).toBeLessThan(10 * perDate);\n      // A ref rebuilt by the caller is still found without walking the 50 points at its date.\n      const ref = point('S0', day * perDate + 37, day);\n      expect(model!.slot({ ...ref })).toBe(day * perDate + 37);\n      expect(model!.has(model!.pick(50, 100 - 37 * 2)! as Extract<PickTarget, { kind: 'point' }>, ref)).toBe(true);\n    }\n  });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_49","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/scene/scene.test.ts'","aggregated_output":"import fc from 'fast-check';\nimport { describe, expect, it } from 'vitest';\nimport { SLOT_GAP, SLOT_NO_ROW, SLOT_VALUE } from '../../src/core/contracts';\nimport type { Layout, Mark, Projection, Rect, Tick, View } from '../../src/core/contracts';\nimport { missingBox } from '../../src/render/geometry';\nimport { buildView } from '../../src/view';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { computeLayout } from '../../src/layout';\nimport { buildScene } from '../../src/scene';\nimport { bandScale, linearScale } from '../../src/scale';\nimport { aligned, donut, scatter } from '../view/fixtures';\n\nconst clip: Rect = { x: 10, y: 20, width: 140, height: 100 };\nconst tick = (value: number): Tick => ({ value, label: String(value) });\nconst fit = { remedies: [], hidden: 0 };\nconst dpr = 1;\n\nfunction layout(view: View, plot = clip, compact = false, padding = 0): Layout {\n  const across = [plot.x, plot.x + plot.width] as const;\n  const up = [plot.y + plot.height, plot.y] as const;\n  let projection: Projection;\n  if (view.kind === 'donut') {\n    projection = {\n      kind: 'ring', cx: plot.x + plot.width / 2, cy: plot.y + plot.height / 2,\n      r0: Math.min(plot.width, plot.height) * 0.3, r1: Math.min(plot.width, plot.height) / 2,\n    };\n  } else if (view.kind === 'bar') {\n    const range = view.horizontal ? up : across;\n    const categoryRange = view.horizontal ? [plot.y, plot.y + plot.height] as const : across;\n    projection = {\n      kind: 'bands', horizontal: view.horizontal,\n      band: view.frame.x.kind === 'category' ? bandScale(view.frame.length, categoryRange, padding) : linearScale(view.xDomain, range),\n      value: linearScale(view.yDomain, view.horizontal ? across : up),\n    };\n  } else {\n    projection = {\n      kind: 'xy',\n      x: view.kind !== 'scatter' && view.frame.x.kind === 'category'\n        ? bandScale(view.frame.length, across, padding) : linearScale(view.xDomain, across),\n      y: linearScale(view.yDomain, up),\n    };\n  }\n\n  const size = { width: plot.x + plot.width + 10, height: plot.y + plot.height + 10, plot, projection };\n  if (compact) return { ...size, kind: 'compact' };\n  return {\n    ...size, kind: 'plot', xTicks: view.kind === 'donut' ? [] : view.xDomain.map(tick),\n    yTicks: view.kind === 'donut' ? [] : view.yDomain.map(tick), texts: [], fit: { x: fit, y: fit },\n  };\n}\n\nfunction marksOf<T extends Mark['type']>(marks: readonly Mark[], type: T): Extract<Mark, { type: T }>[] {\n  return marks.filter((mark): mark is Extract<Mark, { type: T }> => mark.type === type);\n}\n\nfunction line(values: readonly (number | null)[], compact = false) {\n  return aligned({ x: 'x', y: 'y', data: values.map((y, x) => ({ x, y })) },\n    { kind: 'line', compact, valueDomain: [0, 10] }).view;\n}\n\ndescribe('line and area geometry', () => {\n  it('packs the exact projected vertices and a pen lift, and shows the isolated value', () => {\n    const view = line([1, 2, null, 3, null, 4, 5, 6]);\n    const scene = buildScene(view, layout(view), dpr);\n    const [path] = marksOf(scene.marks, 'path');\n    expect(path).toEqual({\n      type: 'path', series: 0, xy: Float32Array.of(10, 110, 30, 100, NaN, NaN, 110, 80, 130, 70, 150, 60),\n      stroke: { kind: 'series', index: 0 }, strokeWidth: 2, dash: view.cues[0]!.dash,\n    });\n    expect(marksOf(scene.marks, 'points')).toEqual([{\n      type: 'points', series: 0, xy: Float32Array.of(10, 110, 30, 100, 70, 90, 110, 80, 130, 70, 150, 60),\n      shape: 'circle', size: 6, fill: { kind: 'series', index: 0 },\n    }]);\n    expect(scene.clip).toBe(clip);\n  });\n\n  it('keeps the joined neighbours past the zoom edges and puts identity markers inside the view', () => {\n    const { view } = aligned({ x: 'x', y: 'y', data: [0, 1, 2, 3, 4, 5].map(x => ({ x, y: x + 1 })) },\n      { kind: 'line', zoom: [1.5, 3.5], valueDomain: [0, 10] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    expect(marksOf(marks, 'path')[0]!.xy).toEqual(Float32Array.of(-25, 100, 45, 90, 115, 80, 185, 70));\n    expect(marksOf(marks, 'points')[0]!.xy).toEqual(Float32Array.of(45, 90, 115, 80));\n  });\n\n  it('uses a zero baseline for an unstacked area backed by a borrowed Float32 column', () => {\n    const x = Float64Array.of(0, 1, 2);\n    const y = Float32Array.of(2, -4, 6);\n    const { view } = aligned({ data: { columns: { x, y } }, x: 'x', y: 'y' },\n      { kind: 'area', valueDomain: [-5, 5] });\n    expect(view.frame.series[0]!.y).toBe(y);\n    const { marks } = buildScene(view, layout(view), dpr);\n    const [area] = marksOf(marks, 'area');\n    expect(area).toMatchObject({\n      opacity: 0.25, upper: Float32Array.of(10, 50, 80, 110, 150, 10),\n      lower: Float32Array.of(10, 70, 80, 70, 150, 70), runs: Uint32Array.of(0, 3, 0, 3),\n    });\n    expect(marksOf(marks, 'path')[0]!.strokeWidth).toBe(2);\n  });\n\n  it('shares exact packed boundaries between adjacent stacked areas on both sides of zero', () => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'b', 'c'], data: [\n        { x: 0, a: 2, b: 3, c: -2 }, { x: 1, a: -4, b: -1, c: 3 }, { x: 2, a: 2, b: null, c: 5 },\n      ],\n    }, { kind: 'area', stacked: true, valueDomain: [-10, 10] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const areas = marksOf(marks, 'area');\n    expect(areas).toHaveLength(3);\n    expect(areas[0]!.upper).toBe(areas[1]!.lower);\n    expect(areas[1]!.upper).toBe(areas[2]!.lower);\n    expect(areas[1]!.opacity).toBe(0.8);\n    expect(areas[1]!.upper).toEqual(Float32Array.of(10, 45, 80, 70, 150, 60, 10, 70, 80, 95, 150, 70));\n    expect(areas[1]!.runs).toEqual(Uint32Array.of(0, 3, 0, 3, 3, 3, 3, 3));\n    const paths = marksOf(marks, 'path').filter(mark => mark.stroke.kind === 'series');\n    expect(paths[1]!.xy).toEqual(Float32Array.of(10, 45, 80, 95));\n  });\n\n  it.each([1, 2])('retains the actual extrema in sampled columns of 100,000 points at DPR %s', ratio => {\n    const count = 100_000;\n    const x = Float64Array.from({ length: count }, (_, i) => i + 0.5);\n    const y = Float64Array.from({ length: count }, (_, i) => i % 101 - 50);\n    const { view } = aligned({ x: 'x', y: 'y', data: { columns: { x, y } } },\n      { kind: 'line', xDomain: [0, count], valueDomain: [-50, 50] });\n    const scene = buildScene(view, layout(view, { x: 0, y: 0, width: 200, height: 100 }), ratio);\n    const path = marksOf(scene.marks, 'path')[0]!;\n    expect(path.xy.length / 2).toBeLessThanOrEqual(4 * 200 * ratio);\n\n    const samplesPerColumn = count / (200 * ratio);\n    for (const column of [0, 1, 83, 137, 200 * ratio - 1]) {\n      const source = y.subarray(column * samplesPerColumn, (column + 1) * samplesPerColumn);\n      const drawn: number[] = [];\n      for (let i = 0; i < path.xy.length; i += 2) {\n        if (Math.floor(path.xy[i]! * ratio) === column) drawn.push(path.xy[i + 1]!);\n      }\n      expect(Math.min(...drawn)).toBe(50 - Math.max(...source));\n      expect(Math.max(...drawn)).toBe(50 - Math.min(...source));\n    }\n    const markers = marksOf(scene.marks, 'points')[0]!;\n    expect(markers.xy.length / 2).toBe(3);\n    expect(markers.xy.at(-2)).toBeCloseTo(199.999, 4);\n    expect(markers.xy.at(-1)).toBe(50 - y[count - 1]!);\n    for (let i = 0; i < markers.xy.length; i += 2) {\n      const index = Math.round(markers.xy[i]! * 500 - 0.5);\n      expect(markers.xy[i + 1]).toBe(50 - y[index]!);\n    }\n  });\n\n  it('draws compact paths without axes, references, or regular markers but keeps isolated points', () => {\n    const view = line([2, 4, 6], true);\n    const { marks } = buildScene({\n      ...view, references: [{ axis: 'y', from: 2, to: 2, label: 'Reference' }],\n    }, layout(view, clip, true), dpr);\n    expect(marks.map(mark => mark.type)).toEqual(['path']);\n    const isolated = line([null, 4, null], true);\n    const isolatedScene = buildScene(isolated, layout(isolated, clip, true), dpr);\n    expect(marksOf(isolatedScene.marks, 'points')[0]!.xy).toEqual(Float32Array.of(80, 80));\n  });\n\n  it('builds an empty clipped scene for an all-null compact line in a 1 × 1 px plot', () => {\n    const plot = { x: 12.25, y: 16.5, width: 1, height: 1 };\n    const data = Array.from({ length: 8 }, (_, x) => ({ x, a: null, b: null }));\n    const { view } = aligned({ x: 'x', y: ['a', 'b'], data }, {\n      kind: 'line', compact: true, references: [{ x: [-2, 8], label: 'Period' }, { y: 17, label: 'Goal' }],\n    });\n    const scene = buildScene(view, layout(view, plot, true), dpr);\n    expect(view.xFull).toEqual([0, 7]);\n    expect(view.yDomain.every(Number.isFinite)).toBe(true);\n    expect(scene.clip).toBe(plot);\n    expect(scene.marks).toEqual([]);\n  });\n});\n\ndescribe('bar geometry', () => {\n  it('draws horizontal category bars from top to bottom at their layout labels', () => {\n    const categories = ['First', 'Middle', 'Last'];\n    const { view } = aligned({ x: 'x', y: 'y', data: categories.map((x, i) => ({ x, y: i + 1 })) },\n      { kind: 'bar', horizontal: true, valueDomain: [0, 4], references: [{ x: 'Middle', label: 'Category' }, { y: 3, label: 'Target' }] });\n    const result = computeLayout({\n      kind: 'bands', horizontal: true, width: 320, height: 240,\n      scales: { linear: linearScale, time: linearScale, band: bandScale },\n      style: { font: '16px sans-serif', letterSpacing: 0, wordSpacing: 0, lineHeight: 16 },\n      measurer: { width: text => text.length * 7 },\n      x: { type: 'band', count: categories.length, padding: 0, mayThin: false,\n        candidates: [categories.map((label, value) => ({ label, value }))] },\n      y: { domain: view.yDomain, candidates: [[tick(0), tick(2), tick(4)]], mayThin: true },\n      references: view.references,\n    });\n    if (result.kind !== 'plot' || result.projection.kind !== 'bands' || result.projection.band.type !== 'band') {\n      throw new Error('Expected a band scale');\n    }\n    const { plot, projection } = result;\n    expect(projection.band.range).toEqual([plot.y, plot.y + plot.height]);\n    const { marks } = buildScene(view, result, dpr);\n    const [bars] = marksOf(marks, 'rects');\n    const labels = result.texts.filter(text => text.role === 'tick-x');\n    expect(labels.map(label => label.full)).toEqual(categories);\n    for (const [i, label] of labels.entries()) {\n      const center = plot.y + (i + 0.5) * plot.height / categories.length;\n      expect(label.y).toBeCloseTo(center);\n      expect(bars!.xywh[4 * i + 1]! + bars!.xywh[4 * i + 3]! / 2).toBeCloseTo(center);\n    }\n    const [category, target] = result.texts.filter(text => text.role === 'reference');\n    const [categoryRule, targetRule] = marksOf(marks, 'rule').filter(mark => mark.role === 'reference');\n    expect(category!.box.y + category!.box.height).toBeCloseTo(categoryRule!.y1 - 4);\n    expect(target!.box.x).toBeCloseTo(targetRule!.x1 + 4);\n  });\n\n  it('uses projected zero as the baseline and represents missing and zero bars separately', () => {\n    const { view } = aligned({\n      x: 'x', y: 'y', data: [{ x: 'A', y: 4 }, { x: 'B', y: null }, { x: 'C', y: 0 }],\n    }, { kind: 'bar', valueDomain: [0, 10] });\n    const scene = buildScene(view, layout(view, { ...clip, width: 120 }), dpr);\n    expect(marksOf(scene.marks, 'rects')).toEqual([\n      { type: 'rects', variant: 'bar', series: 0, xywh: Float32Array.of(10, 80, 40, 40, 90, 120, 40, 0),\n        fill: { kind: 'series', index: 0 } },\n      { type: 'rects', variant: 'missing', series: 0, xywh: Float32Array.of(50, 120, 40, 0),\n        fill: { kind: 'token', name: 'muted' } },\n    ]);\n  });\n\n  it.each([false, true])('keeps both grouped bars in their band without overlap, horizontal %s', horizontal => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'b'], data: [{ x: 'A', a: 2, b: 3 }, { x: 'B', a: 4, b: 5 }],\n    }, { kind: 'bar', horizontal, valueDomain: [0, 10] });\n    const scene = buildScene(view, layout(view, clip, false, 0.25), dpr);\n    const [a, b] = marksOf(scene.marks, 'rects');\n    const dimension = horizontal ? clip.height : clip.width;\n    const step = dimension / 2.25;\n    const band = 0.75 * step;\n    const axis = horizontal ? 1 : 0;\n    // Each bar is 1 px narrower than its half of the band, centred on it: 1 px of background between the two\n    // (spec A5, adjacent filled marks).\n    for (let i = 0; i < 2; i++) {\n      const start = (horizontal ? clip.y : clip.x) + (i + 0.25) * step;\n      expect(a!.xywh[4 * i + axis]).toBeCloseTo(start + 0.5, 4);\n      expect(a!.xywh[4 * i + axis + 2]).toBeCloseTo(band / 2 - 1, 4);\n      expect(b!.xywh[4 * i + axis]).toBeCloseTo(start + band / 2 + 0.5, 4);\n      expect(b!.xywh[4 * i + axis + 2]).toBeCloseTo(band / 2 - 1, 4);\n      const gap = b!.xywh[4 * i + axis]! - (a!.xywh[4 * i + axis]! + a!.xywh[4 * i + axis + 2]!);\n      expect(gap).toBeCloseTo(1, 4);\n    }\n  });\n\n  it('places mixed-sign stacks on their own sides with separation between filled segments', () => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'b', 'c', 'd'], data: [{ x: 'A', a: 3, b: -2, c: 4, d: -5 }],\n    }, { kind: 'bar', stacked: true, valueDomain: [-10, 10] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const bars = marksOf(marks, 'rects');\n    expect(bars.map(bar => Array.from(bar.xywh))).toEqual([\n      [10, 55, 140, 15], [10, 71, 140, 9], [10, 35, 140, 19], [10, 81, 140, 24],\n    ]);\n  });\n\n  it('draws every subpixel band with at least a CSS pixel of width', () => {\n    const { view } = aligned({\n      x: 'x', y: 'y', data: Array.from({ length: 250 }, (_, i) => ({ x: 'Category ' + i, y: 4 })),\n    }, { kind: 'bar' });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const [bar] = marksOf(marks, 'rects');\n    expect(bar!.xywh).toHaveLength(1000);\n    expect(bar!.xywh.every((value, i) => i % 4 !== 2 || value >= 1)).toBe(true);\n  });\n});\n\ndescribe('chart decorations and other projections', () => {\n  it.each(['bar', 'area'] as const)('draws a 1.5 px dashed reference rule over %s marks', kind => {\n    const { view } = aligned({ x: 'x', y: 'y', data: [{ x: 'A', y: 8 }, { x: 'B', y: 7 }] },\n      { kind, valueDomain: [0, 10], references: [{ y: 5, label: 'Goal' }] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const fill = marks.findIndex(mark => mark.type === (kind === 'bar' ? 'rects' : 'area'));\n    const reference = marks.findIndex(mark => mark.type === 'rule' && mark.role === 'reference');\n    expect(fill).toBeGreaterThanOrEqual(0);\n    expect(reference).toBeGreaterThan(fill);\n    expect(marks[reference]).toMatchObject({\n      x1: 10, y1: 70, x2: 150, y2: 70, strokeWidth: 1.5, dash: [4, 3],\n    });\n  });\n\n  it('orders clipped reference bands, the value grid, data, axes, and reference rules', () => {\n    const view = line([2, 4, 6]);\n    const augmented = { ...view, references: [\n      { axis: 'x' as const, from: -1, to: 1, label: 'Range' },\n      { axis: 'y' as const, from: 5, to: 5, label: 'Goal' },\n      { axis: 'x' as const, from: 3, to: 3, label: 'Outside' },\n    ] };\n    const { marks } = buildScene(augmented, layout(augmented), dpr);\n    expect(marks.map(mark => mark.type === 'rule' ? mark.role : mark.type)).toEqual([\n      'band', 'grid', 'grid', 'path', 'points', 'axis', 'axis', 'tick', 'tick', 'tick', 'tick', 'reference',\n    ]);\n    expect(marks[0]).toEqual({\n      type: 'band', box: { ...clip, width: 70 }, fill: { kind: 'token', name: 'reference' }, opacity: 0.12,\n    });\n    expect(marks[1]).toMatchObject({ stroke: { kind: 'token', name: 'grid' }, x1: 10, y1: 120, x2: 150, y2: 120 });\n    expect(marks.at(-1)).toMatchObject({ stroke: { kind: 'token', name: 'reference' }, x1: 10, y1: 70, x2: 150, y2: 70 });\n  });\n\n  it('swaps the grid and reference axes for horizontal bars', () => {\n    const { view } = aligned({ x: 'x', y: 'y', data: [{ x: 'A', y: 4 }, { x: 'B', y: 7 }] }, {\n      kind: 'bar', horizontal: true, valueDomain: [0, 10], references: [{ x: 'B', label: 'Category' }, { y: 5, label: 'Target' }],\n    });\n    const rules = marksOf(buildScene(view, layout(view), dpr).marks, 'rule');\n    expect(rules.filter(mark => mark.role === 'grid')).toMatchObject([\n      { x1: 10, y1: 20, x2: 10, y2: 120 }, { x1: 150, y1: 20, x2: 150, y2: 120 },\n    ]);\n    expect(rules.filter(mark => mark.role === 'reference')).toMatchObject([\n      { x1: 10, y1: 95, x2: 150, y2: 95 }, { x1: 80, y1: 20, x2: 80, y2: 120 },\n    ]);\n  });\n\n  it('draws scatter points in series shapes, excluding hidden and out-of-zoom points', () => {\n    const { view } = scatter({ x: 'x', y: 'y', series: 's', data: [\n      { x: 0, y: 7, s: 'a' }, { x: 2, y: 3, s: 'a' }, { x: 3, y: 6, s: 'b' },\n      { x: 4, y: 5, s: 'b' }, { x: 2, y: 2, s: 'hidden' },\n    ] }, { zoom: [1, 3], valueDomain: [0, 10], hidden: new Set(['hidden']) });\n    const { marks } = buildScene(view, layout(view), dpr);\n    expect(marksOf(marks, 'points')).toEqual([\n      { type: 'points', series: 0, xy: Float32Array.of(80, 90), shape: 'circle', size: 6, fill: { kind: 'series', index: 0 } },\n      { type: 'points', series: 1, xy: Float32Array.of(150, 60), shape: 'square', size: 6, fill: { kind: 'series', index: 1 } },\n    ]);\n  });\n\n  it('uses the slice palette slots and a muted Other with a one-pixel gap', () => {\n    const { view } = donut(Array.from({ length: 10 }, (_, i) => ({ label: 'Part ' + i, value: i })));\n    const { marks } = buildScene(view, layout(view), dpr);\n    expect(marks).toHaveLength(1);\n    const [ring] = marksOf(marks, 'arcs');\n    expect(ring).toMatchObject({\n      cx: 80, cy: 70, r0: 30, r1: 50, gap: 1,\n      fills: [\n        ...Array.from({ length: 7 }, (_, i) => ({ kind: 'series', index: i })),\n        { kind: 'token', name: 'muted' },\n      ],\n    });\n    expect(ring!.angles).toHaveLength(16);\n    expect(ring!.angles[0]).toBe(0);\n    expect(ring!.angles.at(-1)).toBeCloseTo(2 * Math.PI, 6);\n  });\n\n  it('returns correctly sized empty scenes for non-drawing layouts and empty rings', () => {\n    const view = line([2, 4]);\n    for (const kind of ['too-small', 'unmeasured'] as const) {\n      expect(buildScene(view, { kind, width: 48, height: 24 }, dpr)).toEqual({\n        width: 48, height: 24, clip: { x: 0, y: 0, width: 48, height: 24 }, marks: [],\n      });\n    }\n    const empty = donut([{ label: 'Zero', value: 0 }]).view;\n    expect(buildScene(empty, layout(empty), dpr).marks).toEqual([]);\n  });\n});\n\nfunction expectPoint(x: number, y: number, plot: Rect, stroke = 0): void {\n  const margin = stroke + 0.0001;\n  expect(Number.isFinite(x) && Number.isFinite(y)).toBe(true);\n  expect(x).toBeGreaterThanOrEqual(plot.x - margin);\n  expect(x).toBeLessThanOrEqual(plot.x + plot.width + margin);\n  expect(y).toBeGreaterThanOrEqual(plot.y - margin);\n  expect(y).toBeLessThanOrEqual(plot.y + plot.height + margin);\n}\n\nfunction expectBox(x: number, y: number, width: number, height: number, plot: Rect): void {\n  expect(width).toBeGreaterThanOrEqual(0);\n  expect(height).toBeGreaterThanOrEqual(0);\n  expectPoint(x, y, plot);\n  expectPoint(x + width, y + height, plot);\n}\n\nfunction expectWithinClip(mark: Mark, plot: Rect, view: View, authorX: boolean, authorY: boolean): void {\n  // Joined segments and partial bar bands keep their original geometry until the renderer clips them.\n  let xOverflow = false;\n  if ('series' in mark && view.kind !== 'donut' && view.kind !== 'scatter') {\n    // Stack seams can use the union of the visible components' draw ranges.\n    const draws = mark.type === 'path' && mark.stroke.kind === 'token' ? view.drawSlots : [view.drawSlots[mark.series]!];\n    xOverflow = draws.some(draw => draw.start < view.visibleSlots.start || draw.end > view.visibleSlots.end);\n  }\n  const expectBoundary = (xy: Float32Array, allowLifts = false, allowOutsideX = xOverflow) => {\n    const margin = (allowLifts && mark.type === 'path' ? mark.strokeWidth : 0) + 0.0001;\n    const right = plot.x + plot.width;\n    const bottom = plot.y + plot.height;\n    for (let i = 0; i < xy.length; i += 2) {\n      const x = xy[i]!;\n      const y = xy[i + 1]!;\n      if (allowLifts && Number.isNaN(x)) {\n        expect(Number.isNaN(y)).toBe(true);\n        continue;\n      }\n      expect(Number.isFinite(x) && Number.isFinite(y)).toBe(true);\n      if (!allowOutsideX) expect(x >= plot.x - margin && x <= right + margin).toBe(true);\n      const insideX = x >= plot.x - 0.0001 && x <= right + 0.0001;\n      if (insideX && !authorY) expect(y >= plot.y - margin && y <= bottom + margin).toBe(true);\n      if (allowOutsideX && !authorY && i >= 2) {\n        const previousX = xy[i - 2]!;\n        const previousY = xy[i - 1]!;\n        for (const edge of [plot.x, right]) {\n          if (previousX < edge && edge < x) {\n            const atEdge = previousY + (y - previousY) * ((edge - previousX) / (x - previousX));\n            expect(atEdge >= plot.y - margin && atEdge <= bottom + margin).toBe(true);\n          }\n        }\n      }\n    }\n  };\n  switch (mark.type) {\n    case 'rule':\n      if (mark.role === 'axis' || mark.role === 'tick') {\n        expect([mark.x1, mark.y1, mark.x2, mark.y2].every(Number.isFinite)).toBe(true);\n      } else {\n        expectPoint(mark.x1, mark.y1, plot, mark.strokeWidth);\n        expectPoint(mark.x2, mark.y2, plot, mark.strokeWidth);\n      }\n      break;\n    case 'path': expectBoundary(mark.xy, true); break;\n    case 'points': expectBoundary(mark.xy, false, false); break;\n    case 'area':\n      expect(mark.upper.every(Number.isFinite) && mark.lower.every(Number.isFinite)).toBe(true);\n      for (let i = 0; i < mark.runs.length; i += 4) {\n        const upperStart = mark.runs[i]! * 2;\n        const lowerStart = mark.runs[i + 2]! * 2;\n        const upperEnd = upperStart + mark.runs[i + 1]! * 2;\n        const lowerEnd = lowerStart + mark.runs[i + 3]! * 2;\n        expect(upperEnd).toBeLessThanOrEqual(mark.upper.length);\n        expect(lowerEnd).toBeLessThanOrEqual(mark.lower.length);\n        expectBoundary(mark.upper.subarray(upperStart, upperEnd));\n        expectBoundary(mark.lower.subarray(lowerStart, lowerEnd));\n      }\n      break;\n    case 'rects':\n      for (let i = 0; i < mark.xywh.length; i += 4) {\n        const [x, y, w, h] = mark.xywh.subarray(i, i + 4);\n        expect([x, y, w, h].every(Number.isFinite) && w! >= 0 && h! >= 0).toBe(true);\n        if (view.kind === 'bar' && view.frame.x.kind !== 'category') {\n          const partialBands = authorX || view.xDomain !== view.xFull;\n          if (view.horizontal) {\n            expect(x! >= plot.x - 0.0001 && x! + w! <= plot.x + plot.width + 0.0001).toBe(true);\n            if (!partialBands) expect(y! >= plot.y - 0.5001 && y! + h! <= plot.y + plot.height + 0.5001).toBe(true);\n          } else {\n            expect(y! >= plot.y - 0.0001 && y! + h! <= plot.y + plot.height + 0.0001).toBe(true);\n            if (!partialBands) expect(x! >= plot.x - 0.5001 && x! + w! <= plot.x + plot.width + 0.5001).toBe(true);\n          }\n        } else {\n          expectBox(x!, y!, w!, h!, plot);\n        }\n      }\n      break;\n    case 'band': expectBox(mark.box.x, mark.box.y, mark.box.width, mark.box.height, plot); break;\n    case 'arcs':\n      expectPoint(mark.cx - mark.r1, mark.cy - mark.r1, plot);\n      expectPoint(mark.cx + mark.r1, mark.cy + mark.r1, plot);\n      expect(Number.isFinite(mark.r0) && mark.angles.every(Number.isFinite)).toBe(true);\n      break;\n  }\n}\n\nit('keeps generated geometry finite and clipped across independent chart states', () => {\n  const value = fc.option(fc.integer({ min: -500, max: 500 }), { nil: null });\n  const configuration = fc.record({\n    kind: fc.constantFrom('line', 'area', 'bar', 'scatter', 'donut'),\n    rows: fc.array(fc.tuple(value, value), { minLength: 8, maxLength: 32 }),\n    width: fc.integer({ min: 1, max: 40 }),\n    height: fc.integer({ min: 1, max: 120 }),\n    dpr: fc.constantFrom(1, 1.5, 2),\n    stacked: fc.boolean(), horizontal: fc.boolean(), compact: fc.boolean(),\n    dense: fc.boolean(), long: fc.boolean(), category: fc.boolean(), author: fc.boolean(),\n    authorY: fc.boolean(), zoom: fc.boolean(), hide: fc.boolean(),\n  });\n  const exercised = new Set<string>();\n  fc.assert(fc.property(configuration, config => {\n    const { kind, width, height, stacked, horizontal, compact, authorY } = config;\n    const plot = { x: 12.25, y: 16.5, width, height };\n    const rows = config.dense && (kind === 'line' || kind === 'area')\n      ? Array.from({ length: 480 }, (_, i) => config.rows[i % config.rows.length]!) : config.rows;\n    const last = rows.length - 1;\n    const category = config.category && kind === 'bar';\n    const references = [\n      { y: [-15, 15] as const, label: 'Range' }, { y: 17, label: 'Goal' },\n      { x: category ? 'Band 4' : [-2, last + 1] as const, label: 'Period' },\n    ];\n    const xDomain = config.author && !category ? [1.25, last - 0.25] as const : undefined;\n    const zoom = config.zoom ? [last / 4 + 0.1, last * 0.75 + 0.2] as const : null;\n    const state = {\n      zoom: category ? null : zoom, xDomain, references,\n      valueDomain: authorY ? [-200, 200] as const : undefined,\n      hidden: config.hide ? new Set(['b']) : undefined,\n    };\n    let view: View;\n    if (kind === 'donut') {\n      view = donut(rows.map(([y], i) => ({ label: 'Part ' + i, value: y === null ? null : Math.abs(y) }))).view;\n    } else if (kind === 'scatter') {\n      const data = rows.flatMap(([a, b], x) => [{ x, y: a, s: 'a' }, { x, y: b, s: 'b' }]);\n      view = scatter({ x: 'x', y: 'y', series: 's', data }, state).view;\n    } else {\n      const xAt = (i: number) => category ? 'Band ' + i : i;\n      const a = rows.flatMap(([y], i) => i === 3 ? [] : [{ x: xAt(i), y: config.dense ? y ?? 0 : y, s: 'a' }]);\n      const b = rows.flatMap(([, y], i) => i % 2 ? [] : [{ x: xAt(i), y, s: 'b' }]);\n      const data = config.long ? [...a, ...b] : rows.map(([a, b], i) => ({ x: xAt(i), a: config.dense ? a ?? 0 : a, b }));\n      const viewState = { ...state, kind, stacked, horizontal, compact };\n      const generated = aligned(\n        config.long ? { x: 'x', y: 'y', series: 's', data } : { x: 'x', y: ['a', 'b'], data }, viewState,\n      );\n      view = generated.view;\n      if (view.compact) {\n        // Product spec F7 says `reference` has no effect in compact charts, which draw only data marks (§3.7).\n        const withoutReferences = buildView(generated.frame, { ...viewState, references: [] }, new DiagnosticCollector());\n        expect(view.xFull).toEqual(withoutReferences.xFull);\n        expect(view.yDomain).toEqual(withoutReferences.yDomain);\n      }\n      if (config.long && !category) {\n        expect(view.frame.series[0]!.slot.includes(SLOT_GAP)).toBe(true);\n        expect(view.frame.series[1]!.slot.includes(SLOT_NO_ROW)).toBe(true);\n        exercised.add('long-form states');\n      }\n      if (kind === 'bar' && !compact) exercised.add('bar ' + [stacked, horizontal, config.dpr].join('/'));\n    }\n    const scene = buildScene(view, layout(view, plot, view.kind !== 'donut' && view.compact, 0.2), config.dpr);\n    expect(scene.clip).toBe(plot);\n    if (view.kind !== 'donut') {\n      if (xDomain) {\n        expect(view.xFull).toEqual(xDomain);\n        exercised.add('author x domain');\n      } else if (!category && !view.compact) {\n        expect(view.xFull[0]).toBeLessThanOrEqual(-2);\n        expect(view.xFull[1]).toBeGreaterThanOrEqual(last + 1);\n        exercised.add('automatic x references');\n      }\n      if (zoom && !view.compact && !category) {\n        expect(view.xDomain[0]).toBeGreaterThanOrEqual(view.xFull[0]);\n        expect(view.xDomain[1]).toBeLessThanOrEqual(view.xFull[1]);\n        expect(view.xDomain[1] - view.xDomain[0]).toBeCloseTo(zoom[1] - zoom[0], 10);\n        exercised.add('zoom');\n      }\n      if (config.hide) {\n        const hidden = view.frame.series.findIndex(series => series.key === 'b');\n        if (hidden >= 0) {\n          expect(view.visible[hidden]).toBe(false);\n          expect(scene.marks.some(mark => 'series' in mark && mark.series === hidden)).toBe(false);\n          exercised.add('hidden series');\n        }\n      }\n    }\n    if (view.kind === 'line' && config.dense && !config.long) {\n      const slots = view.frame.series[0]!.slot.subarray(view.visibleSlots.start, view.visibleSlots.end);\n      const columns = Math.ceil((plot.x + width) * config.dpr) - Math.floor(plot.x * config.dpr);\n      const path = marksOf(scene.marks, 'path').find(mark => mark.series === 0);\n      if (slots.length > 4 * columns && slots.every(slot => slot === SLOT_VALUE) && path && path.xy.length / 2 < slots.length) {\n        exercised.add('simplified path');\n      }\n    }\n    for (const mark of scene.marks) expectWithinClip(mark, plot, view, xDomain !== undefined, authorY);\n  }), { numRuns: 1000, seed: 536 });\n  expect(exercised).toEqual(new Set([\n    'long-form states', 'automatic x references', 'author x domain', 'hidden series', 'zoom', 'simplified path',\n    ...[false, true].flatMap(stacked => [false, true].flatMap(horizontal =>\n      [1, 1.5, 2].map(dpr => 'bar ' + [stacked, horizontal, dpr].join('/')))),\n  ]));\n});\n\nit('keeps a joined line visible from edge to edge when its zoom contains no samples', () => {\n  const { view } = aligned({ x: 'x', y: 'y', data: [50, 60, 70, 80].map((y, x) => ({ x, y })) },\n    { kind: 'line', zoom: [1.2, 1.8] });\n  const path = marksOf(buildScene(view, layout(view), dpr).marks, 'path')[0]!;\n  const [x1, y1, x2, y2] = path.xy;\n  const heightAt = (x: number) => y1! + (y2! - y1!) * (x - x1!) / (x2! - x1!);\n  expect(heightAt(clip.x)).toBeCloseTo(clip.y + clip.height, 3);\n  expect(heightAt(clip.x + clip.width)).toBeCloseTo(clip.y, 3);\n});\n\nit.each([false, true])('keeps the missing mark at the far baseline and visible through the clip (horizontal %s)', horizontal => {\n  const { view } = aligned({ x: 'x', y: 'y', data: [{ x: 'A', y: -4 }, { x: 'B', y: null }] },\n    { kind: 'bar', horizontal });\n  const scene = buildScene(view, layout(view), dpr);\n  const rect = marksOf(scene.marks, 'rects').find(mark => mark.variant === 'missing')!;\n  const [x, y, w, h] = rect.xywh;\n  if (horizontal) expect([x, w]).toEqual([clip.x + clip.width, 0]);\n  else expect([y, h]).toEqual([clip.y, 0]);\n  const outline = new Float64Array(4);\n  missingBox(x!, y!, w!, h!, outline, scene.clip);\n  expect(outline[2]).toBeGreaterThan(0);\n  expect(outline[3]).toBeGreaterThan(0);\n  expectBox(outline[0]!, outline[1]!, outline[2]!, outline[3]!, clip);\n});\n\nit('uses each donut palette slot once when eight arcs surround arcless entries', () => {\n  const values = [5, 5, 5, 5, 0, null, 5, 5, 5, 5];\n  const { view } = donut(values.map((value, i) => ({ label: 'Part ' + i, value })));\n  const drawn = view.slices.filter(slice => slice.angles);\n  expect(drawn.map(slice => slice.colorIndex)).toEqual([0, 1, 2, 3, 4, 5, 6, 7]);\n  const [ring] = marksOf(buildScene(view, layout(view), dpr).marks, 'arcs');\n  expect(ring!.fills).toEqual(drawn.map(slice => ({ kind: 'series', index: slice.colorIndex })));\n});\n\nit('offsets scatter marker shapes every eight series', () => {\n  const { view } = scatter({ x: 'x', y: 'y', series: 's',\n    data: Array.from({ length: 17 }, (_, i) => ({ x: i, y: i, s: 'series ' + i })) });\n  const points = marksOf(buildScene(view, layout(view), dpr).marks, 'points');\n  expect([points[0]!.shape, points[8]!.shape, points[16]!.shape]).toEqual(['circle', 'square', 'triangle']);\n});\n\nit.each([false, true])('assigns each palette cycle its own bar pattern (stacked %s)', stacked => {\n  const y = Array.from({ length: 32 }, (_, i) => 'value' + i);\n  const { view } = aligned({ x: 'x', y, data: [{ x: 'A', ...Object.fromEntries(y.map(name => [name, 1])) }] },\n    { kind: 'bar', stacked });\n  const bars = marksOf(buildScene(view, layout(view), dpr).marks, 'rects');\n  expect(bars.slice(0, 8).every(bar => bar.pattern === undefined || bar.pattern === 'none')).toBe(true);\n  expect(bars.slice(8).map(bar => bar.pattern)).toEqual(\n    ['diagonal', 'cross', 'dots'].flatMap(pattern => Array.from({ length: 8 }, () => pattern)),\n  );\n});\n\nit.each([false, true])('centers whole continuous bars and retains bands crossing both zoom edges (horizontal %s)', horizontal => {\n  const { frame, view } = aligned({\n    x: 'x', y: ['a', 'b'], data: [0, 1, 2, 3].map(x => ({ x, a: x === 0 ? 50 : 3, b: 2 })),\n  }, { kind: 'bar', horizontal });\n  expect(view.xFull).toEqual([-0.5, 3.5]);\n  const whole = layout(view);\n  const [a, b] = marksOf(buildScene(view, whole, dpr).marks, 'rects');\n  const axis = horizontal ? 1 : 0;\n  const part = (horizontal ? clip.height : clip.width) / 10;\n  for (let i = 0; i < 4; i++) {\n    const offset = 4 * i + axis;\n    const fraction = (i + 0.5) / 4;\n    const center = horizontal ? clip.y + clip.height * (1 - fraction) : clip.x + clip.width * fraction;\n    // 1 px of background between the two bars of a group (spec A5): each 1 px narrower, centred on its slot.\n    expect(a!.xywh[offset]).toBeCloseTo(center - part + 0.5, 4);\n    expect(b!.xywh[offset]).toBeCloseTo(center + 0.5, 4);\n    expect(a!.xywh[offset + 2]).toBeCloseTo(part - 1, 4);\n    expect(b!.xywh[offset + 2]).toBeCloseTo(part - 1, 4);\n  }\n  const zoomed = buildView(frame, { kind: 'bar', horizontal, zoom: [0.2, 0.8], previous: view }, new DiagnosticCollector());\n  expect(zoomed.visibleSlots).toEqual({ start: 1, end: 1 });\n  expect(zoomed.yDomain[1]).toBeGreaterThanOrEqual(50);\n  const [left, right] = marksOf(buildScene(zoomed, layout(zoomed), dpr).marks, 'rects');\n  expect(left!.xywh).toHaveLength(8);\n  expect(right!.xywh).toHaveLength(8);\n  const lo = horizontal ? clip.y : clip.x;\n  const hi = lo + (horizontal ? clip.height : clip.width);\n  const lowSlot = horizontal ? 4 : 0;\n  const highSlot = horizontal ? 0 : 4;\n  expect(left!.xywh[lowSlot + axis]).toBeLessThan(lo);\n  expect(right!.xywh[highSlot + axis]! + right!.xywh[highSlot + axis + 2]!).toBeGreaterThan(hi);\n});\n\nit('draws x references beyond the data extent and renders equal bounds as rules', () => {\n  const { view, diagnostics } = aligned({ x: 'x', y: 'y', data: [{ x: 0, y: 1 }, { x: 5, y: 3 }] }, {\n    kind: 'line', references: [{ x: [8, 8], label: 'Future' }, { y: [2, 2], label: 'Target' }],\n  });\n  const marks = buildScene(view, layout(view), dpr).marks;\n  expect(marksOf(marks, 'band')).toEqual([]);\n  expect(marksOf(marks, 'rule').filter(rule => rule.role === 'reference')).toMatchObject([\n    { x1: 150, x2: 150, y1: 20, y2: 120 }, { x1: 10, x2: 150, y1: 70, y2: 70 },\n  ]);\n  expect(diagnostics.inputs()).toEqual([]);\n});\n\nit('uses the minimum spacing for markers and always keeps the last joined point', () => {\n  const { view } = aligned({\n    x: 'x', y: 'y', data: [0, 0.01, 0.02, 0.03, 10].map((x, y) => ({ x, y })),\n  }, { kind: 'line', valueDomain: [0, 4] });\n  const [markers] = marksOf(buildScene(view, layout(view), dpr).marks, 'points');\n  expect(markers!.xy).toEqual(Float32Array.of(10 + 0.03 * 14, 45, 150, 20));\n});\n\nit.each([1, -1])('anchors a missing stack component at the outer end for sign %s', sign => {\n  const { view } = aligned({\n    x: 'x', y: ['a', 'b', 'c'], data: [{ x: 'A', a: sign * 4, b: null, c: sign * 2 }],\n  }, { kind: 'bar', stacked: true, valueDomain: [-10, 10] });\n  const rects = marksOf(buildScene(view, layout(view), dpr).marks, 'rects');\n  expect(rects.find(mark => mark.variant === 'missing')!.xywh).toEqual(Float32Array.of(10, 70 - sign * 30, 140, 0));\n});\n\nit('excludes marks and references for categories outside an author domain', () => {\n  const { view } = aligned({\n    x: 'x', y: 'y', data: ['A', 'B', 'C', 'D'].map((x, i) => ({ x, y: i + 1 })),\n  }, {\n    kind: 'line', xDomain: ['B', 'C'], valueDomain: [0, 5],\n    references: [{ x: 'A', label: 'Outside' }, { x: 'B', label: 'Inside' }],\n  });\n  expect(view.xFull).toEqual([1, 2]);\n  const { marks } = buildScene(view, layout(view), dpr);\n  expect(marksOf(marks, 'path')[0]!.xy).toEqual(Float32Array.of(62.5, 80, 97.5, 60));\n  expect(marksOf(marks, 'rule').filter(mark => mark.role === 'reference').map(mark => mark.x1)).toEqual([62.5]);\n});\n\nit('draws only the value at a single-position author domain', () => {\n  const { view } = aligned({ x: 'x', y: 'y', data: [1, 2, 3].map((y, x) => ({ x, y })) },\n    { kind: 'line', compact: true, xDomain: [1, 1], valueDomain: [0, 5] });\n  const { marks } = buildScene(view, layout(view, clip, true), dpr);\n  expect(marksOf(marks, 'path')).toEqual([]);\n  expect(marksOf(marks, 'points')[0]!.xy).toEqual(Float32Array.of(80, 80));\n});\n\nit('pads irregular bar endpoints by their own neighbour spacing and skips non-overlapping bands', () => {\n  const { frame, view } = aligned({\n    x: 'x', y: 'y', data: [0, 2, 7, 10].map(x => ({ x, y: 2 })),\n  }, { kind: 'bar' });\n  expect(view.xFull).toEqual([-1, 11.5]);\n  const zoomed = buildView(frame, { kind: 'bar', zoom: [3.5, 4.5], previous: view }, new DiagnosticCollector());\n  expect(zoomed.visibleSlots).toEqual({ start: 2, end: 2 });\n  expect(zoomed.drawSlots[0]).toEqual({ start: 2, end: 2 });\n  expect(marksOf(buildScene(zoomed, layout(zoomed), dpr).marks, 'rects')[0]!.xywh).toHaveLength(0);\n});\n\ndescribe('spec F9: at least 32 distinct combinations of colour and a non-colour cue before any repeats', () => {\n  const count = 32;\n  const keys = Array.from({ length: count }, (_, s) => `S${String(s).padStart(2, '0')}`);\n  // Every series has values at three x positions (one category for bars), so each draws every mark it has.\n  function rows(xs: readonly unknown[]) {\n    return keys.flatMap((s, i) => xs.map((x, j) => ({ x, y: 1 + ((i + j) % 5), s })));\n  }\n\n  // What tells one series from another in the scene: its palette colour (eight, spec A5) and whatever else\n  // its marks carry: a dash, a marker shape, a fill pattern.\n  function cueOf(marks: readonly Mark[], series: number): string {\n    const own = marks.filter(mark => 'series' in mark && mark.series === series && !(mark.type === 'rects' && mark.variant === 'missing'));\n    const colours = new Set<number>();\n    const parts: string[] = [];\n    for (const mark of own) {\n      const paint = mark.type === 'path' ? mark.stroke : 'fill' in mark ? mark.fill : null;\n      if (paint && typeof paint === 'object' && 'kind' in paint && paint.kind === 'series') colours.add(paint.index % 8);\n      if (mark.type === 'path') parts.push(`dash ${JSON.stringify(mark.dash.normal)}`);\n      if (mark.type === 'points') parts.push(`marker ${mark.shape}`);\n      if (mark.type === 'rects') parts.push(`pattern ${mark.pattern ?? 'none'}`);\n    }\n    expect(colours.size, `series ${series} has one colour`).toBe(1);\n    expect(parts.length, `series ${series} has marks`).toBeGreaterThan(0);\n    return [...colours, ...new Set(parts)].join(' ');\n  }\n\n  const cases = [\n    ['line', false], ['area', false], ['bar', false], ['line', true], ['area', true], ['bar', true],\n  ] as const;\n  it.each(cases)('%s (compact: %s)', (kind, compact) => {\n    const xs = kind === 'bar' ? ['only'] : [0, 1, 2];\n    const { view } = aligned({ x: 'x', y: 'y', series: 's', data: rows(xs) }, { kind, compact, valueDomain: [0, 10] });\n    const { marks } = buildScene(view, layout(view, clip, compact), dpr);\n    const cues = keys.map((_, s) => cueOf(marks, s));\n    expect(new Set(cues).size).toBe(count);\n  });\n\n  it('scatter', () => {\n    const { view } = scatter({ x: 'x', y: 'y', series: 's', data: rows([0, 1, 2]) }, { valueDomain: [0, 10] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const cues = keys.map((_, s) => cueOf(marks, s));\n    expect(new Set(cues).size).toBe(count);\n  });\n});\n\ndescribe('spec A5: neighbouring compact bars differ by more than colour (verification, finding 13)', () => {\n  function patterns(count: number) {\n    const keys = Array.from({ length: count }, (_, s) => `S${String(s).padStart(2, '0')}`);\n    const data = keys.map(s => ({ x: 'only', y: 3, s }));\n    const { view } = aligned({ x: 'x', y: 'y', series: 's', data }, { kind: 'bar', compact: true, valueDomain: [0, 10] });\n    const { marks } = buildScene(view, layout(view, clip, true), dpr);\n    return keys.map((_, s) => marksOf(marks, 'rects').find(mark => mark.series === s && mark.variant === 'bar')!.pattern ?? 'none');\n  }\n\n  it('three equal-height series in one category: each pattern differs from its neighbour\\'s', () => {\n    const [a, b, c] = patterns(3);\n    expect(a).not.toBe(b);\n    expect(b).not.toBe(c);\n  });\n\n  it.each([2, 5, 8, 9, 16, 17, 31, 32])('%i series: every neighbouring pair has different patterns', count => {\n    const fills = patterns(count);\n    for (let s = 1; s < count; s++) expect(fills[s], `series ${s - 1} and ${s}`).not.toBe(fills[s - 1]);\n  });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/browser/acceptance/type-matrix.browser.test.ts'","aggregated_output":"/**\n * The type matrix (spec 3.6), every cell about rendered or interactive behaviour: picking by pointer,\n * tooltip content, keyboard order, zoom, dense drawing (the rendered half), the limit that raises a\n * diagnostic, and reference lines and bands. Marks are identified by where they are drawn and in what\n * colour, never by counting elements alone.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport type { Page } from 'playwright-core';\nimport { start, stop } from '../harness';\nimport {\n  axOf, box, center, closePage, create, createRaw, devPage, distance, inkColorAt, modeColor, plotGeometry, readRange, readTable, resolveColors, ring, screenshot, settle, shapes, signature, valueText, type Box, type RGB,\n} from './util';\nimport { calendar, ENERGY, inOrder, LATENCY_ORDER, share, SHIPPED, SPEND, withUnit } from './fixtures';\nimport { inkColor, referenceMarks, spikeColumn, strokeRuns } from './checks';\n\nbeforeAll(start);\nafterAll(stop);\n\nconst tip = async (page: Page) => ((await page.locator('#chart .axylo-tooltip').isVisible()) ? (await page.locator('#chart .axylo-tooltip').textContent()) ?? '' : '');\nconst xDomain = (page: Page) => page.evaluate(() => (window as unknown as { charts: { __bench: { describe(): { xDomain: number[] | null; yDomain: number[] | null } } }[] }).charts[0]!.__bench.describe());\nconst away = async (page: Page) => { await page.mouse.move(0, 0); await settle(page); };\n/** The angle (radians clockwise from 12 o'clock) of the middle of slice `i` of `values`. */\nconst midAngle = (values: readonly number[], i: number) => (2 * Math.PI * (values.slice(0, i).reduce((a, b) => a + b, 0) + values[i]! / 2)) / values.reduce((a, b) => a + b, 0);\n\n// ── picking ───────────────────────────────────────────────────────────────────────────────────────\n\ndescribe('T-pointer: picking by pointer', () => {\n  for (const type of ['line', 'area'] as const) {\n    it(`T-pointer-${type}: the pointer picks the nearest x: 30 % of the way from one day to the next shows the first, 70 % the second`, async () => {\n      const page = await devPage();\n      await create(page, type);\n      const xs = ((await shapes(page, '#chart', 14))[1] ?? []).map(s => center(s.box).x).sort((a, b) => a - b);\n      expect(xs).toHaveLength(5);\n      const p = await box(page, '#chart .axylo-proxy');\n      for (const [f, want] of [[0.3, 1], [0.7, 2]] as const) {\n        await away(page);\n        await page.mouse.move(xs[1]! + f * (xs[2]! - xs[1]!), p.y + 5);\n        await settle(page);\n        expect(await tip(page)).toContain(calendar(ENERGY.days[want]!));\n      }\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  for (const horizontal of [false, true]) {\n    it(`T-pointer-bar: the band under the pointer is picked, even at its edge and away from the bars${horizontal ? ' (horizontal bars: bands run along y)' : ''}`, async () => {\n      const page = await devPage();\n      await create(page, 'bar', horizontal ? { horizontal: true } : {});\n      const rects = await shapes(page, '#chart', 100000);\n      const along = (b: Box) => (horizontal ? b.y : b.x), size = (b: Box) => (horizontal ? b.height : b.width);\n      const plan = (rects[1] ?? []).map(s => s.box).sort((a, b) => along(a) - along(b));\n      const actual = (rects[2] ?? []).map(s => s.box).sort((a, b) => along(a) - along(b));\n      expect(plan).toHaveLength(4);\n      const p = await box(page, '#chart .axylo-proxy');\n      // The band of the second category runs from half-way between groups 1 and 2 to half-way between 2 and 3.\n      const end = (i: number) => Math.max(along(plan[i]!) + size(plan[i]!), along(actual[i]!) + size(actual[i]!));\n      const startOf = (i: number) => Math.min(along(plan[i]!), along(actual[i]!));\n      const lo = (end(0) + startOf(1)) / 2, hi = (end(1) + startOf(2)) / 2;\n      const labels = horizontal ? SHIPPED.quarters : SHIPPED.quarters;\n      for (const t of [lo + 2, hi - 2, startOf(1) + 1]) {\n        await away(page);\n        await page.mouse.move(horizontal ? p.x + p.width - 4 : t, horizontal ? t : p.y + 4);\n        await settle(page);\n        const text = await tip(page);\n        expect(text, `at ${t}`).toContain(labels[1]!);\n        expect(text).not.toContain(labels[0]!);\n        expect(text).not.toContain(labels[2]!);\n      }\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('T-pointer-donut: the slice under the pointer is picked; the hole and the outside pick nothing', async () => {\n    const page = await devPage();\n    await create(page, 'donut');\n    const g = await ring(page);\n    for (let i = 0; i < 4; i++) {\n      const a = midAngle(SPEND.values, i);\n      await away(page);\n      await page.mouse.move(g.cx + 0.85 * g.outer * Math.sin(a), g.cy - 0.85 * g.outer * Math.cos(a));\n      await settle(page);\n      expect(await tip(page)).toContain(SPEND.items[i]!);\n    }\n    await away(page);\n    await page.mouse.move(g.cx, g.cy);\n    await settle(page);\n    expect(await tip(page)).toBe('');\n    await page.mouse.move(g.cx + g.outer * 1.2, g.cy + g.outer * 0.9);\n    await settle(page);\n    expect(await tip(page)).toBe('');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-pointer-scatter: the nearest point within 24 px is picked: 23 px from a lone point it is, 25 px it is not', async () => {\n    const page = await devPage();\n    await createRaw(page, 'scatter', { title: 'Lone', data: [{ x: 0, y: 0, s: 'corner' }, { x: 20, y: 5, s: 'lone' }, { x: 40, y: 10, s: 'corner' }], x: 'x', y: 'y', series: 's' });\n    const lone = center((await shapes(page, '#chart', 14))[2]![0]!.box);\n    for (const [d, picked] of [[23, true], [25, false]] as const) {\n      for (const [dx, dy] of [[d, 0], [0, -d], [-d * Math.SQRT1_2, d * Math.SQRT1_2]]) {\n        await away(page);\n        await page.mouse.move(lone.x + dx!, lone.y + dy!);\n        await settle(page);\n        expect((await tip(page)).includes('lone'), `${d} px (${Math.round(dx!)}, ${Math.round(dy!)})`).toBe(picked);\n      }\n    }\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-pointer-scatter: two points equally near the pointer: the later row wins, whichever series it is (source order reversed, the other wins)', async () => {\n    for (const order of [['first', 'second'], ['second', 'first']] as const) {\n      const page = await devPage();\n      const rows = { first: { x: 20, y: 5, s: 'first' }, second: { x: 21, y: 5, s: 'second' } };\n      await createRaw(page, 'scatter', { title: 'Tie', data: [{ x: 0, y: 0, s: 'far' }, rows[order[0]], rows[order[1]], { x: 40, y: 9, s: 'far' }], x: 'x', y: 'y', series: 's' });\n      const drawn = await shapes(page, '#chart', 14);\n      const pts = [drawn[2]![0]!, drawn[3]![0]!].map(s => center(s.box));\n      await away(page);\n      await page.mouse.move((pts[0]!.x + pts[1]!.x) / 2, (pts[0]!.y + pts[1]!.y) / 2);\n      await settle(page);\n      const text = await tip(page);\n      expect(text, `rows ${order.join(', ')}`).toContain(order[1]);\n      expect(text).not.toContain(order[0]);\n      expect(await closePage(page)).toEqual([]);\n    }\n  });\n});\n\n// ── tooltip content ───────────────────────────────────────────────────────────────────────────────\n\ndescribe('T-tooltip: tooltip content', () => {\n  for (const type of ['line', 'area', 'bar'] as const) {\n    it(`T-tooltip-${type}: every visible series at that ${type === 'bar' ? 'category' : 'x'}${type === 'area' ? ' and, stacked, the stack total' : ''}, in series order; a hidden series is not listed`, async () => {\n      const page = await devPage();\n      await create(page, type, {}, '#chart', type === 'area' ? 'stacked' : 'default');\n      const p = await box(page, '#chart .axylo-proxy');\n      const drawn = await shapes(page, '#chart', type === 'bar' ? 100000 : 14);\n      const xs = (drawn[1] ?? []).map(s => center(s.box).x).sort((a, b) => a - b);\n      const [first, second] = type === 'bar' ? SHIPPED.series : ENERGY.series;\n      const unit = type === 'bar' ? 't' : 'kWh';\n      const label = type === 'bar' ? SHIPPED.quarters[2]! : calendar(ENERGY.days[2]!);\n      await page.mouse.move(type === 'bar' ? xs[2]! : xs[2]!, p.y + 5);\n      await settle(page);\n      const rows = () => page.locator('#chart .axylo-tooltip .axylo-tooltip-row').evaluateAll(els => els.map(e => e.textContent ?? ''));\n      const want = [`${first!.name}${withUnit(first!.values[2]!, unit)}`, `${second!.name}${withUnit(second!.values[2]!, unit)}`];\n      if (type === 'area') want.push(`Total${withUnit(first!.values[2]! + second!.values[2]!, unit)}`);\n      expect(await page.locator('#chart .axylo-tooltip .axylo-tooltip-title').textContent()).toBe(label);\n      expect(await rows()).toEqual(want);\n      await away(page);\n      await page.locator('#chart .axylo-legend-entry', { hasText: second!.name }).click();\n      await settle(page);\n      await away(page);\n      await page.mouse.move(xs[2]!, p.y + 6);\n      await settle(page);\n      const left = await rows();\n      expect(left[0]).toBe(want[0]);\n      expect(left.join(' ')).not.toContain(second!.name);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('T-tooltip-bar: on horizontal bars too, every series in the category under the pointer', async () => {\n    const page = await devPage();\n    await create(page, 'bar', { horizontal: true });\n    const p = await box(page, '#chart .axylo-proxy');\n    const ys = ((await shapes(page, '#chart', 100000))[1] ?? []).map(s => center(s.box).y).sort((a, b) => a - b);\n    await page.mouse.move(p.x + p.width - 4, ys[1]!);\n    await settle(page);\n    expect(inOrder(await tip(page), [SHIPPED.quarters[1]!, 'Plan', withUnit(45, 't'), 'Actual', withUnit(47, 't')])).toBe(true);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-tooltip-donut: label, value and percentage of the slice under the pointer', async () => {\n    const page = await devPage();\n    await create(page, 'donut');\n    const g = await ring(page);\n    const a = midAngle(SPEND.values, 3);\n    await page.mouse.move(g.cx + 0.85 * g.outer * Math.sin(a), g.cy - 0.85 * g.outer * Math.cos(a));\n    await settle(page);\n    expect(inOrder(await tip(page), [SPEND.items[3]!, withUnit(SPEND.values[3]!, 'EUR'), share(SPEND.values[3]!)])).toBe(true);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-tooltip-scatter: the point\\'s series, x and y; ten coincident points list eight distinct series of the ten and \"+2 more\"', async () => {\n    const page = await devPage();\n    await create(page, 'scatter');\n    const eu = ((await shapes(page, '#chart', 14))[1] ?? []).map(s => center(s.box)).sort((a, b) => a.x - b.x);\n    await page.mouse.move(eu[1]!.x, eu[1]!.y);\n    await settle(page);\n    for (const part of ['EU', withUnit(20, 'kB'), withUnit(140, 'ms')]) expect(await tip(page)).toContain(part);\n    await page.close();\n    const many = await devPage();\n    const names = Array.from({ length: 10 }, (_, i) => `S${i + 1}`);\n    await createRaw(many, 'scatter', { title: 'Same place', data: [...names.map(s => ({ x: 5, y: 5, s })), { x: 1, y: 1, s: 'S1' }, { x: 9, y: 9, s: 'S1' }], x: 'x', y: 'y', series: 's' });\n    const p = await box(many, '#chart .axylo-proxy');\n    await many.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n    await settle(many);\n    const listed = await many.locator('#chart .axylo-tooltip .axylo-tooltip-row .axylo-tooltip-series').allTextContents();\n    expect(listed).toHaveLength(8);\n    expect(new Set(listed).size).toBe(8);\n    expect(listed.every(n => names.includes(n))).toBe(true);\n    expect(await tip(many)).toContain('+2 more');\n    expect(await closePage(many)).toEqual([]);\n  });\n});\n\ndescribe('T-keyboard: keyboard order', () => {\n  const orders: Record<string, { type: 'line' | 'area' | 'bar' | 'scatter' | 'donut'; first: string[]; stops: string[][] }> = {\n    'T-keyboard-line': { type: 'line', first: [], stops: ENERGY.days.map(d => [calendar(d), 'North', 'South']) },\n    'T-keyboard-area': { type: 'area', first: [], stops: ENERGY.days.map(d => [calendar(d), 'North', 'South']) },\n    'T-keyboard-bar': { type: 'bar', first: [], stops: SHIPPED.quarters.map(q => [q, 'Plan', 'Actual']) },\n    'T-keyboard-scatter': { type: 'scatter', first: [], stops: LATENCY_ORDER.map(p => [p.region, withUnit(p.size, 'kB'), withUnit(p.latency, 'ms')]) },\n    'T-keyboard-donut': { type: 'donut', first: [], stops: SPEND.items.map(i => [i]) },\n  };\n  const rule = { line: 'by x, then series', area: 'by x, then series', bar: 'by category, then series', scatter: 'by x, then y (x = 20 kB: 100 ms before 140 ms)', donut: 'by slice order' };\n  for (const [id, o] of Object.entries(orders)) {\n    it(`${id}: Right walks ${rule[o.type]}; Left walks back in reverse`, async () => {\n      const page = await devPage();\n      await create(page, o.type);\n      await page.focus('#chart .axylo-proxy');\n      const forwards = [await valueText(page)];\n      expect((await readRange(page)).value).toBe(0);\n      for (let i = 1; i < o.stops.length; i++) {\n        await page.keyboard.press('ArrowRight');\n        forwards.push(await valueText(page));\n        // The range's own position (Chrome's computed value) moves with the text.\n        expect((await readRange(page)).value).toBe(i);\n      }\n      o.stops.forEach((s, i) => expect(inOrder(forwards[i]!, s), `${i}: ${forwards[i]}`).toBe(true));\n      const backwards = [await valueText(page)];\n      for (let i = 1; i < o.stops.length; i++) { await page.keyboard.press('ArrowLeft'); backwards.push(await valueText(page)); }\n      expect(backwards).toEqual([...forwards].reverse());\n      if (o.type === 'line' || o.type === 'area' || o.type === 'bar') {\n        // \"Then series\": from all series at the first x, Down goes to the first series, Down again to the second.\n        await page.keyboard.press('ArrowDown');\n        const one = await valueText(page);\n        await page.keyboard.press('ArrowDown');\n        const two = await valueText(page);\n        expect(one).toContain(o.stops[0]![1]!);\n        expect(one).not.toContain(o.stops[0]![2]!);\n        expect(two).toContain(o.stops[0]![2]!);\n      }\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\ndescribe('F10 mixed-sign stacks, rendered', () => {\n  for (const type of ['area', 'bar'] as const) {\n    it(`F10 ${type}: a stack with a positive and a negative part reads the positive total and the negative total in the tooltip, never their net, and the parts sit on their own sides of zero`, async () => {\n      const page = await devPage();\n      const data = [{ x: 'A', s: 'Up', y: 5 }, { x: 'A', s: 'Down', y: -3 }, { x: 'B', s: 'Up', y: 4 }, { x: 'B', s: 'Down', y: -2 }, { x: 'C', s: 'Up', y: 6 }, { x: 'C', s: 'Down', y: -1 }];\n      await createRaw(page, type, { title: 'Mixed', data, x: 'x', y: { field: 'y', unit: 'kg' }, series: 's', ...(type === 'area' ? { stacked: true } : { layout: 'stacked' }) });\n      const g = await plotGeometry(page);\n      const zero = g.plot.y + (1 - (0 - g.yDomain![0]!) / (g.yDomain![1]! - g.yDomain![0]!)) * g.plot.height;\n      if (type === 'bar') {\n        const drawn = await shapes(page, '#chart', 100000);\n        for (const r of (drawn[1] ?? []).map(s => s.box)) expect(r.y + r.height, 'Up above zero').toBeLessThanOrEqual(zero + 1);\n        for (const r of (drawn[2] ?? []).map(s => s.box)) expect(r.y, 'Down below zero').toBeGreaterThanOrEqual(zero - 1);\n      }\n      const xs = ((await shapes(page, '#chart', type === 'bar' ? 100000 : 14))[1] ?? []).map(s => center(s.box).x).sort((a, b) => a - b);\n      await page.mouse.move(xs[0]!, g.plot.y + 4);\n      await settle(page);\n      const total = (await page.locator('#chart .axylo-tooltip .axylo-tooltip-total').textContent()) ?? '';\n      expect(total).toContain(withUnit(5, 'kg'));\n      expect(total).toContain('-3 kg');\n      expect(total).not.toMatch(/(^|[^-\\d])2 kg/);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\n// ── zoom ──────────────────────────────────────────────────────────────────────────────────────────\n\ndescribe('T-zoom', () => {\n  for (const type of ['line', 'area', 'scatter'] as const) {\n    it(`T-zoom-${type}: ${type === 'scatter' ? 'x only in 1.0: + narrows the x range, controls are offered, and the y axis keeps the full data range though the visible y extremes change' : 'zoom applies: controls are offered and + narrows the x range'}`, async () => {\n      const page = await devPage();\n      await create(page, type);\n      expect(await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'Zoom in' }).count()).toBe(1);\n      const before = await xDomain(page);\n      if (type === 'scatter') await page.evaluate(() => (window as unknown as { charts: { zoom(d: unknown): void }[] }).charts[0]!.zoom([12, 22]));\n      else { await page.focus('#chart .axylo-proxy'); await page.keyboard.press('+'); }\n      await settle(page);\n      const after = await xDomain(page);\n      expect(after.xDomain![1]! - after.xDomain![0]!).toBeLessThan(before.xDomain![1]! - before.xDomain![0]!);\n      // Scatter (spec 3.6): x only. In [12, 22] the visible y values are 90–140 too… so the window [12, 22]\n      // holds only 90, 100, 140 (y 90–140 of 90–140 overall); the y axis must keep the full domain.\n      if (type === 'scatter') expect(after.yDomain).toEqual(before.yDomain);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('T-zoom-bar: a category bar chart has no zoom (no controls; +, wheel and drag each leave the range alone); date and number bar charts zoom', async () => {\n    const page = await devPage();\n    await create(page, 'bar');\n    expect(await page.locator('#chart button', { hasText: 'Zoom in' }).count()).toBe(0);\n    const before = await xDomain(page);\n    await page.focus('#chart .axylo-proxy');\n    await page.keyboard.press('+');\n    await settle(page);\n    expect(await xDomain(page), 'after +').toEqual(before);\n    const p = await box(page, '#chart .axylo-proxy');\n    await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n    await page.mouse.wheel(0, -300);\n    await settle(page);\n    expect(await xDomain(page), 'after the wheel').toEqual(before);\n    await page.mouse.move(p.x + 0.2 * p.width, p.y + p.height / 2);\n    await page.mouse.down();\n    await page.mouse.move(p.x + 0.6 * p.width, p.y + p.height / 2, { steps: 5 });\n    await page.mouse.up();\n    await settle(page);\n    expect(await xDomain(page), 'after a drag').toEqual(before);\n    await page.close();\n    for (const axis of ['date', 'number'] as const) {\n      const other = await devPage();\n      const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n      await createRaw(other, 'bar', { title: 'Zoomable', data: Array.from({ length: 30 }, (_, k) => ({ x: axis === 'date' ? day(k) : k, v: (k % 7) + 1 })), x: { field: 'x', type: axis }, y: 'v' });\n      expect(await other.locator('#chart button', { hasText: 'Zoom in' }).count(), axis).toBe(1);\n      const full = await xDomain(other);\n      await other.focus('#chart .axylo-proxy');\n      await other.keyboard.press('+');\n      await settle(other);\n      const z = await xDomain(other);\n      expect(z.xDomain![1]! - z.xDomain![0]!, axis).toBeLessThan(full.xDomain![1]! - full.xDomain![0]!);\n      expect(await closePage(other)).toEqual([]);\n    }\n  });\n\n  it('T-zoom-donut: a donut has no zoom: no controls, and +, - and the wheel each change nothing drawn', async () => {\n    const page = await devPage();\n    await create(page, 'donut');\n    expect(await page.locator('#chart button', { hasText: /Zoom/ }).count()).toBe(0);\n    const scene = () => page.evaluate(() => document.querySelector('#chart svg.axylo-svg .axylo-scene')!.innerHTML);\n    const before = await scene();\n    await page.focus('#chart .axylo-proxy');\n    await page.keyboard.press('+');\n    await settle(page);\n    expect(await scene(), 'after +').toBe(before);\n    await page.keyboard.press('-');\n    await settle(page);\n    expect(await scene(), 'after -').toBe(before);\n    const g = await ring(page);\n    await page.mouse.move(g.cx, g.cy);\n    await page.mouse.wheel(0, -300);\n    await settle(page);\n    expect(await scene(), 'after the wheel').toBe(before);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\n// ── dense drawing (rendered half) ─────────────────────────────────────────────────────────────────\n\n/** Viewport position of data (x, y) on a plot whose domains are fixed by the author. */\nconst project = (plot: Box, xd: readonly number[], yd: readonly number[]) => (x: number, y: number) => ({ x: plot.x + ((x - xd[0]!) / (xd[1]! - xd[0]!)) * plot.width, y: plot.y + (1 - (y - yd[0]!) / (yd[1]! - yd[0]!)) * plot.height });\n\ndescribe('T-dense', () => {\n  for (const type of ['line', 'area'] as const) {\n    for (const dpr of [1, 2]) {\n      it(`T-dense-${type}: 100,000 samples at device pixel ratio ${dpr} with fixed domains: a spike at sample 61,234 and a dip at 20,000 are each drawn in their own device-pixel column and nowhere else; a break inside one column is kept; a sample the drawing dropped is in the table`, async () => {\n        const page = await devPage({ deviceScaleFactor: dpr });\n        await page.evaluate(async type => {\n          const n = 100_000;\n          const x = new Float64Array(n), y = new Float64Array(n);\n          for (let i = 0; i < n; i++) { x[i] = i; y[i] = 40 + (i % 3); }\n          y[61_234] = 95;\n          y[20_000] = 5;\n          // A break: samples 80,000 and 80,001 missing, so one device column holds the end of a run and the start of the next.\n          y[80_000] = NaN;\n          y[80_001] = NaN;\n          const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => { __bench: { ready(): Promise<void> } }>; charts: unknown[] };\n          const chart = w.Axylo[type]!('#chart', { title: 'Dense', data: { columns: { x, y } }, x: { field: 'x', domain: [0, n - 1] }, y: { field: 'y', domain: [0, 100] } });\n          w.charts.push(chart);\n          await chart.__bench.ready();\n        }, type);\n        const plot = await box(page, '#chart .axylo-proxy');\n        const at = project(plot, [0, 99_999], [0, 100]);\n        const runs = await strokeRuns(page, 1);\n        const spike = spikeColumn(runs, at(61_234, 95), dpr);\n        expect(spike.reached, 'spike drawn in its column').toBe(true);\n        expect(spike.outside, 'spike height reached elsewhere').toEqual([]);\n        const dip = spikeColumn(runs, at(20_000, 5), dpr);\n        expect(dip.reached, 'dip drawn in its column').toBe(true);\n        expect(dip.outside).toEqual([]);\n        // The break: a run ends before x of 80,000 and the next starts after it, within a pixel column or two.\n        // The break: one run ends and the next begins within a device pixel or so of the missing samples.\n        const gapX = at(80_000.5, 0).x;\n        const lifts = runs.slice(1).map((r, k) => ({ end: runs[k]!.at(-1)!.x, start: r[0]!.x }));\n        expect(lifts.some(l => Math.abs(l.end - gapX) <= 1.5 && Math.abs(l.start - gapX) <= 1.5), `pen lift at x ${gapX.toFixed(1)}: ${JSON.stringify(lifts.map(l => [l.end.toFixed(1), l.start.toFixed(1)]))}`).toBe(true);\n        await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n        await settle(page);\n        await page.locator('#chart .axylo-jump-field').click();\n        await page.keyboard.type('50,001');\n        await page.keyboard.press('Enter');\n        await settle(page);\n        const row = (await readTable(page)).rows.find(r => r.header === '50,001');\n        expect(row?.cells).toEqual([String(40 + (50_001 % 3))]);\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n  }\n\n  it('T-dense-area: stacked, the upper boundary reaches the cumulative spike (series 1 at 61,234 plus series 2 there) in its own column, at device pixel ratio 2', async () => {\n    const page = await devPage({ deviceScaleFactor: 2 });\n    await page.evaluate(async () => {\n      const n = 100_000;\n      const rows = { x: new Float64Array(2 * n), y: new Float64Array(2 * n), s: new Array<string>(2 * n) };\n      for (let i = 0; i < n; i++) { rows.x[i] = i; rows.y[i] = 20; rows.s[i] = 'A'; rows.x[n + i] = i; rows.y[n + i] = 10 + (i % 2); rows.s[n + i] = 'B'; }\n      rows.y[61_234] = 70;\n      const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => { __bench: { ready(): Promise<void> } }>; charts: unknown[] };\n      const chart = w.Axylo.area!('#chart', { title: 'Stacked dense', data: { columns: rows }, x: { field: 'x', domain: [0, n - 1] }, y: { field: 'y', domain: [0, 100] }, series: 's', stacked: true });\n      w.charts.push(chart);\n      await chart.__bench.ready();\n    });\n    const plot = await box(page, '#chart .axylo-proxy');\n    const at = project(plot, [0, 99_999], [0, 100]);\n    // Series B sits on A: its stroke is the cumulative sum, 70 + (61,234 mod 2 = 0) + 10 = 80 at the spike.\n    const top = spikeColumn(await strokeRuns(page, 2), at(61_234, 80), 2);\n    expect(top.reached, 'cumulative spike drawn').toBe(true);\n    expect(top.outside).toEqual([]);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-dense-bar: more bars than pixels raises the AX132 hint and every bar is still drawn, each where its category is', async () => {\n    const page = await devPage({ css: '#chart { width: 300px; }' });\n    const built = await createRaw(page, 'bar', { title: 'Many', data: Array.from({ length: 2000 }, (_, k) => ({ c: `c${k}`, v: k === 1234 ? 50 : 1 + (k % 5) })), x: 'c', y: 'v' });\n    expect(built.diagnostics.filter(d => d.code === 'AX132').map(d => d.level)).toEqual(['hint']);\n    const rects = ((await shapes(page, '#chart', 100000))[1] ?? []).map(s => s.box);\n    expect(rects).toHaveLength(2000);\n    // The tall one (50) is the 1,235th band from the left.\n    const sorted = [...rects].sort((a, b) => a.x - b.x || a.y - b.y);\n    const tallest = rects.reduce((a, b) => (b.height > a.height ? b : a));\n    expect(sorted.indexOf(tallest)).toBe(1234);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-dense-donut: no simplified drawing: eight slices, the smallest under 0.2 %, are each drawn at their angle in their colour', async () => {\n    const page = await devPage();\n    const values = [600, 200, 100, 50, 30, 15, 4, 1];\n    await createRaw(page, 'donut', { title: 'Eight', data: values.map((v, i) => ({ l: `S${i + 1}`, v })), label: 'l', value: 'v' });\n    const { img, box: plot, scale } = await screenshot(page, '#chart .axylo-plot');\n    const g = await ring(page);\n    const colors = await resolveColors(page, await page.locator('#chart ul.axylo-legend-list > li svg.axylo-swatch').evaluateAll(els => els.map(e => getComputedStyle(e).color)));\n    const wrong: string[] = [];\n    // The slices' own paths, by colour, with the angle their outer arc starts at (clockwise from 12 o'clock).\n    const starts = await page.evaluate(({ cx, cy }) => [...document.querySelectorAll<SVGPathElement>('#chart svg.axylo-svg .axylo-scene path')].filter(p => /M\\s*-?[\\d.]+[ ,]-?[\\d.]+/.test(p.getAttribute('d') ?? '')).map(p => {\n      const m = p.getScreenCTM()!; const [x, y] = /M\\s*(-?[\\d.]+)[ ,](-?[\\d.]+)/.exec(p.getAttribute('d')!)!.slice(1).map(Number);\n      const q = new DOMPoint(x!, y!).matrixTransform(m);\n      return { color: getComputedStyle(p).color, angle: (Math.atan2(q.x - cx, cy - q.y) + 2 * Math.PI) % (2 * Math.PI) };\n    }), g);\n    const css = await page.locator('#chart ul.axylo-legend-list > li svg.axylo-swatch').evaluateAll(els => els.map(e => getComputedStyle(e).color));\n    values.forEach((v, i) => {\n      const a = midAngle(values, i);\n      const arc = ((2 * Math.PI * v) / 1000) * g.outer;\n      // A slice wider than 4 px of arc is checked on the screen; a thinner one is hidden by its 1 px\n      // separators (spec A5), so its own path is checked to start where its share puts it.\n      if (arc > 4) {\n        const c = inkColorAt(img, (g.cx - plot.x + 0.85 * g.outer * Math.sin(a)) * scale, (g.cy - plot.y - 0.85 * g.outer * Math.cos(a)) * scale);\n        if (distance(c, colors[i]!) > 30) wrong.push(`S${i + 1}: ${c} vs ${colors[i]}`);\n      } else {\n        const start = (2 * Math.PI * values.slice(0, i).reduce((x, y) => x + y, 0)) / 1000;\n        if (!starts.some(p => p.color === css[i] && Math.abs(p.angle - start) < 0.02)) wrong.push(`S${i + 1}: no path of its colour starts at ${((start * 180) / Math.PI).toFixed(1)}°`);\n      }\n    });\n    expect(wrong).toEqual([]);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-dense-scatter: above 50,000 points the AX133 hint says drawing may be slow, and every point is drawn: points chosen across the data are found at their own positions', async () => {\n    const page = await devPage();\n    const built = await page.evaluate(async () => {\n      const n = 50_001;\n      const rows = Array.from({ length: n }, (_, i) => ({ x: i % 1000, y: Math.floor(i / 1000) }));\n      const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => { diagnostics: { code: string; level: string; message: string }[]; __bench: { ready(): Promise<void> } }>; charts: unknown[] };\n      const chart = w.Axylo.scatter!('#chart', { title: 'Many', data: rows, x: { field: 'x', domain: [0, 999] }, y: { field: 'y', domain: [0, 50] } });\n      w.charts.push(chart);\n      await chart.__bench.ready();\n      return chart.diagnostics.filter(d => d.code === 'AX133').map(d => `${d.level} ${d.message}`);\n    });\n    expect(built).toHaveLength(1);\n    expect(built[0]).toMatch(/^hint .*slow/i);\n    const plot = await box(page, '#chart .axylo-proxy');\n    const at = project(plot, [0, 999], [0, 50]);\n    const found = await page.evaluate(points => {\n      const svg = document.querySelector('#chart svg.axylo-svg') as SVGSVGElement;\n      const m = svg.getScreenCTM()!;\n      const starts: { x: number; y: number }[] = [];\n      for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) {\n        if (!/--axylo-series-color-1\\b/.test(el.style.getPropertyValue('color'))) continue;\n        for (const sub of (el.getAttribute('d') ?? '').split('M').slice(1)) {\n          const [px, py] = sub.split(/[ A-Z]/).filter(Boolean).map(Number);\n          const p = new DOMPoint(px!, py!).matrixTransform(m);\n          starts.push({ x: p.x, y: p.y });\n        }\n      }\n      // A mark's path starts within its 6 px shape box of its point.\n      return { count: starts.length, hits: points.map(q => starts.some(s0 => Math.abs(s0.x - q.x) <= 5 && Math.abs(s0.y - q.y) <= 5)) };\n    // (x, y) = (i mod 1000, floor(i / 1000)) for i < 50,001: the last point is (0, 50).\n    }, [at(0, 0), at(0, 50), at(999, 49), at(500, 25), at(123, 45), at(876, 3)]);\n    expect(found.hits).toEqual([true, true, true, true, true, true]);\n    expect(found.count).toBe(50_001);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\n// ── limits ────────────────────────────────────────────────────────────────────────────────────────\n\n/** One painted identity per series, in series order: colour, dash, marker shape and bar pattern, from each series' own marks in DOM order. */\nasync function cues(page: Page, type: 'line' | 'area' | 'bar' | 'scatter'): Promise<string[]> {\n  const raw = await page.evaluate(type => {\n    const scene = document.querySelector('#chart svg.axylo-svg .axylo-scene')!;\n    const series = (el: Element) => /--axylo-series-color-/.test((el as SVGElement).style.getPropertyValue('color'));\n    const strokes = [...scene.querySelectorAll<SVGPathElement>('path')].filter(e => series(e) && e.style.getPropertyValue('stroke') === 'currentcolor');\n    const fills = [...scene.querySelectorAll<SVGPathElement>('path')].filter(e => series(e) && e.style.getPropertyValue('fill') === 'currentcolor' && !e.style.getPropertyValue('fill-opacity'));\n    const bars = [...scene.children].filter(e => e.tagName.toLowerCase() === 'g' && series(e));\n    const n = type === 'bar' ? bars.length : type === 'scatter' ? fills.length : strokes.length;\n    return Array.from({ length: n }, (_, i) => {\n      const line = strokes[i], marker = type === 'bar' ? null : fills[i], group = bars[i];\n      const color = getComputedStyle((line ?? marker ?? group)!).color;\n      const dash = line ? getComputedStyle(line).strokeDasharray : '';\n      const shape = marker ? (marker.getAttribute('d') ?? '').split(/(?=M)/)[0] ?? '' : '';\n      const pattern = group ? [...group.children].map(r => (r as SVGElement).style.getPropertyValue('fill')).filter(Boolean).join(',') : '';\n      return { color, dash, shape, pattern };\n    });\n  }, type);\n  return raw.map(r => `${r.color}|${r.dash}|${r.shape ? signature(r.shape) : ''}|${r.pattern}`);\n}\n\ndescribe('T-limit', () => {\n  for (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n    it(`T-limit-${type}: eight series raise no AX130; nine raise AX130 once, and each of the nine is painted with its own combination of colour and dash, marker or pattern`, async () => {\n      const make = (count: number) => {\n        const names = Array.from({ length: count }, (_, i) => `S${i + 1}`);\n        return type === 'scatter'\n          ? names.flatMap((s, i) => [1, 2, 3].map(x => ({ x: x + i / 10, y: i + x, s })))\n          : names.flatMap((s, i) => ['A', 'B', 'C'].map((x, k) => ({ x, s, y: 10 + i + k })));\n      };\n      const eight = await devPage();\n      const ok = await createRaw(eight, type, { title: 'Eight', data: make(8), x: 'x', y: 'y', series: 's' });\n      expect(ok.diagnostics.map(d => d.code)).not.toContain('AX130');\n      await closePage(eight);\n      const page = await devPage();\n      const built = await createRaw(page, type, { title: 'Nine', data: make(9), x: 'x', y: 'y', series: 's' });\n      expect(built.diagnostics.filter(d => d.code === 'AX130').map(d => d.level)).toEqual(['warning']);\n      const ids = await cues(page, type);\n      expect(ids, 'one painted identity per series').toHaveLength(9);\n      expect(new Set(ids).size, JSON.stringify(ids)).toBe(9);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('F9 bar: thirty-two series are each painted with their own combination of colour and fill pattern (spec F9 as settled: bar cues are distinct up to 32 series)', async () => {\n    const page = await devPage({ viewport: { width: 1400, height: 800 }, css: '#chart { width: 1300px; height: 600px; }' });\n    const names = Array.from({ length: 32 }, (_, i) => `S${i + 1}`);\n    await createRaw(page, 'bar', { title: 'Thirty-two', data: names.flatMap((s, i) => ['A', 'B'].map((x, k) => ({ x, s, y: 10 + i + k }))), x: 'x', y: 'y', series: 's' });\n    const ids = await cues(page, 'bar');\n    expect(ids).toHaveLength(32);\n    expect(new Set(ids).size, JSON.stringify(ids)).toBe(32);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-limit-donut: eight slices raise no AX121; nine raise it and draw the seven largest (here not the first seven) plus \"Other (2)\"', async () => {\n    const eight = await devPage();\n    const ok = await createRaw(eight, 'donut', { title: 'Eight', data: [5, 1, 4, 2, 8, 3, 7, 6].map((v, i) => ({ l: `S${i + 1}`, v })), label: 'l', value: 'v' });\n    expect(ok.diagnostics.map(d => d.code)).not.toContain('AX121');\n    await closePage(eight);\n    const page = await devPage();\n    // Smallest are S1 (2) and S4 (1): grouped. The rest keep their order.\n    const values = [2, 30, 20, 1, 15, 10, 8, 6, 5];\n    const built = await createRaw(page, 'donut', { title: 'Nine', data: values.map((v, i) => ({ l: `S${i + 1}`, v })), label: 'l', value: 'v' });\n    expect(built.diagnostics.filter(d => d.code === 'AX121').map(d => d.level)).toEqual(['warning']);\n    expect(await page.locator('#chart ul.axylo-legend-list > li .axylo-legend-name').allTextContents()).toEqual(['S2', 'S3', 'S5', 'S6', 'S7', 'S8', 'S9', 'Other (2)']);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\n// ── reference lines and bands ─────────────────────────────────────────────────────────────────────\n\ndescribe('T-reference', () => {\n  for (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n    for (const which of ['line', 'band'] as const) {\n      it(`T-reference-${type}: a reference ${which} outside the data is included in the domain, painted at its position in the reference colour, labelled next to its own mark, and listed in the summary and the table caption`, async () => {\n        const page = await devPage();\n        // Every fixture's values stay below 200 and its x within the data; each reference lies beyond.\n        // 187: above every value, and not on a tick (so not on a gridline).\n        const ref = which === 'line' ? { y: 187, label: 'Ceiling' }\n          : type === 'bar' ? { y: [150, 180], label: 'Normal range' }\n            : type === 'scatter' ? { x: [40, 50], label: 'Normal range' } : { x: ['2026-03-08', '2026-03-10'], label: 'Normal range' };\n        await create(page, type, { reference: [ref] });\n        const d = await xDomain(page);\n        const g = await plotGeometry(page);\n        if (which === 'line' || type === 'bar') expect(d.yDomain![1]).toBeGreaterThanOrEqual(which === 'line' ? 187 : 180);\n        const marks = (await referenceMarks(page)).filter(m => m.kind === which);\n        expect(marks.length, `a painted reference ${which}`).toBeGreaterThan(0);\n        const m = marks.sort((a, b) => b.box.width * b.box.height - a.box.width * a.box.height)[0]!;\n        const y = (v: number) => g.plot.y + (1 - (v - d.yDomain![0]!) / (d.yDomain![1]! - d.yDomain![0]!)) * g.plot.height;\n        if (which === 'line') {\n          expect(Math.abs(m.box.y + m.box.height / 2 - y(187)), 'line at y = 187').toBeLessThanOrEqual(1.5);\n          expect(m.box.width).toBeGreaterThan(g.plot.width * 0.9);\n        } else if (type === 'bar') {\n          expect(Math.abs(m.box.y - y(180))).toBeLessThanOrEqual(1.5);\n          expect(Math.abs(m.box.y + m.box.height - y(150))).toBeLessThanOrEqual(1.5);\n        } else {\n          // An x band beyond the data: inside the widened x domain, to the right of every mark.\n          expect(m.box.x).toBeGreaterThan(g.plot.x + g.plot.width / 2);\n        }\n        // Painted: a line shows the reference colour along its length (a dashed line has gaps, so the most\n        // frequent non-background colour along it); a band shows the reference colour composited at the\n        // band's computed opacity over the background.\n        const { img, box: view } = await screenshot(page, '#chart .axylo-plot');\n        const backdrop = modeColor(img, { x0: 0, y0: 0, x1: img.width, y1: img.height }).color;\n        const [want] = await resolveColors(page, [m.paint]);\n        if (which === 'line') {\n          const ink = inkColor(img, view, { x: m.box.x + 4, y: m.box.y + m.box.height / 2 - 1, width: m.box.width - 8, height: 2 }, backdrop);\n          expect(ink, 'the line is painted').not.toBeNull();\n          expect(distance(ink!, want!), `painted ${ink}, reference ${want}`).toBeLessThanOrEqual(24);\n        } else {\n          const alpha = await page.evaluate(() => { for (const el of document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene *')) if (/--axylo-reference/.test(el.style.getPropertyValue('color'))) { const c = getComputedStyle(el); const r = el.getBoundingClientRect(); if (r.width > 2.5 && r.height > 2.5) return Number(c.fillOpacity) * Number(c.opacity); } return 1; });\n          const expected = want!.map((v, i) => Math.round(alpha * v + (1 - alpha) * backdrop[i]!)) as unknown as RGB;\n          const painted = modeColor(img, { x0: (m.box.x - view.x + 2) * (img.width / view.width), y0: (m.box.y - view.y + 2) * (img.width / view.width), x1: (m.box.x + m.box.width - view.x - 2) * (img.width / view.width), y1: (m.box.y + m.box.height - view.y - 2) * (img.width / view.width) }).color;\n          expect(distance(painted, backdrop), 'the band is visibly painted').toBeGreaterThan(6);\n          expect(distance(painted, expected), `painted ${painted}, expected ${expected} (reference at opacity ${alpha})`).toBeLessThanOrEqual(8);\n        }\n        const label = await box(page, '#chart .axylo-label[data-role=\"reference\"]');\n        const gapY = Math.max(0, m.box.y - (label.y + label.height), label.y - (m.box.y + m.box.height));\n        const gapX = Math.max(0, m.box.x - (label.x + label.width), label.x - (m.box.x + m.box.width));\n        expect(Math.hypot(gapX, gapY), 'label next to its own mark').toBeLessThanOrEqual(16);\n        const summary = (await axOf(page, '#chart figure')).description;\n        expect(summary).toContain(ref.label);\n        await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n        await settle(page);\n        expect((await page.locator('#chart table caption').textContent()) ?? '').toContain(ref.label);\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n  }\n\n  it('T-reference-donut: a donut has no reference lines: an author reference is reported (AX150), and nothing is drawn, labelled or described for it', async () => {\n    const page = await devPage();\n    const built = await create(page, 'donut', { reference: [{ y: 200, label: 'Ceiling' }] });\n    expect(await referenceMarks(page)).toEqual([]);\n    expect(await page.locator('#chart .axylo-label[data-role=\"reference\"]').count()).toBe(0);\n    expect((await axOf(page, '#chart figure')).description).not.toContain('Ceiling');\n    expect(await page.locator('#chart').innerText()).not.toContain('Ceiling');\n    expect(built.diagnostics.map(d => d.code)).toContain('AX150');\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n","exit_code":0,"status":"completed"}}
