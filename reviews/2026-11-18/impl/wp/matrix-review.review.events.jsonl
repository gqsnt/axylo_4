n.description?.value ?? ''),\n   142\t    value: String(n.value?.value ?? ''), ignored: n.ignored, props, children: n.childIds ?? [], backend: n.backendDOMNodeId ?? null,\n   143\t  };\n   144\t}\n   145\t\n   146\tasync function backendOf(page: Page, selector: string): Promise<number> {\n   147\t  requireEngineFeature(['chromium'], AX_TREE_REASON);\n   148\t  const client = await page.context().newCDPSession(page);\n   149\t  try {\n   150\t    const { root } = await client.send('DOM.getDocument', { depth: 0 });\n   151\t    const { nodeId } = await client.send('DOM.querySelector', { nodeId: root.nodeId, selector });\n   152\t    if (!nodeId) throw new Error(`no element for ${selector}`);\n   153\t    const { node } = await client.send('DOM.describeNode', { nodeId });\n   154\t    return node.backendNodeId;\n   155\t  } finally {\n   156\t    await client.detach();\n   157\t  }\n   158\t}\n   159\t\n   160\t/** Chrome's accessibility node for the first element matching `selector`. */\n   161\texport async function axOf(page: Page, selector: string): Promise<AX> {\n   162\t  const backend = await backendOf(page, selector);\n   163\t  const client = await page.context().newCDPSession(page);\n   164\t  try {\n   165\t    const { nodes } = await client.send('Accessibility.getPartialAXTree', { backendNodeId: backend, fetchRelatives: false });\n   166\t    return toAX(nodes[0] as RawAX);\n   167\t  } finally {\n   168\t    await client.detach();\n   169\t  }\n   170\t}\n   171\t\n   172\t/**\n   173\t * The accessibility nodes inside the element matching `selector` (the element's own node first), in tree\n   174\t * order, without ignored nodes: what an assistive technology can reach there.\n   175\t */\n   176\texport async function axWithin(page: Page, selector = '#chart'): Promise<AX[]> {\n   177\t  const backend = await backendOf(page, selector);\n   178\t  const client = await page.context().newCDPSession(page);\n   179\t  try {\n   180\t    const { nodes } = await 