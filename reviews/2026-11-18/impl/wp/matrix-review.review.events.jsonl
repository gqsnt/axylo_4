{"type":"item.completed","item":{"id":"item_56","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/browser/acceptance/text.ts'","aggregated_output":"/**\n * Where the chart's visible text is, as oriented rectangles in viewport px, and whether two of them\n * overlap (separating-axis test with the spec's 1 px tolerance). A rotated tick label is measured as its\n * own rotated box, not as the axis-aligned box around it, so a 45° label that only seems to touch its\n * neighbour's bounding box is not counted.\n */\nimport type { Page } from 'playwright-core';\n\nexport interface TextBox {\n  text: string; owner: number; cx: number; cy: number; w: number; h: number; angle: number; role: string;\n  /**\n   * How much of it a reader sees: 'whole'; 'clipped' (an ancestor that hides overflow cuts it off);\n   * 'ellipsis' (cut off and ended with an ellipsis by CSS `text-overflow`). For a cut text the box is the\n   * part that is painted, not the underlying text.\n   */\n  seen: 'whole' | 'clipped' | 'ellipsis';\n}\n\nexport async function textBoxes(page: Page, selector = '#chart'): Promise<TextBox[]> {\n  return page.evaluate(selector => {\n    const root = document.querySelector(selector)!;\n    const out: { text: string; owner: number; cx: number; cy: number; w: number; h: number; angle: number; role: string; seen: 'whole' | 'clipped' | 'ellipsis' }[] = [];\n    const owners = new Map<Element, number>();\n    /** The rectangle the ancestors that hide overflow leave visible, and whether one of them ends text with an ellipsis. */\n    const clipOf = (el: Element) => {\n      let x0 = -Infinity, y0 = -Infinity, x1 = Infinity, y1 = Infinity, ellipsis = false;\n      for (let a: Element | null = el; a && a !== document.body; a = a.parentElement) {\n        const s = getComputedStyle(a);\n        if (s.textOverflow === 'ellipsis' && (a as HTMLElement).scrollWidth > (a as HTMLElement).clientWidth + 0.5) ellipsis = true;\n        if (s.overflowX !== 'visible' || s.overflowY !== 'visible' || s.clipPath !== 'none') {\n          const r = a.getBoundingClientRect();\n          if (s.overflowX !== 'visible') { x0 = Math.max(x0, r.left); x1 = Math.min(x1, r.right); }\n          if (s.overflowY !== 'visible') { y0 = Math.max(y0, r.top); y1 = Math.min(y1, r.bottom); }\n        }\n      }\n      return { x0, y0, x1, y1, ellipsis };\n    };\n    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);\n    for (let n = walker.nextNode(); n; n = walker.nextNode()) {\n      const el = n.parentElement!;\n      if (!n.textContent?.trim()) continue;\n      // The tooltip and readout float over the plot by design while the reader asks for them; they are\n      // checked by I1 (they must not cover the active mark or a control), not counted as overlapping text.\n      if (el.closest('[hidden], .axylo-visually-hidden, .axylo-tooltip, .axylo-readout, [aria-hidden=\"true\"] svg, script, style')) continue;\n      const style = getComputedStyle(el);\n      if (style.visibility === 'hidden' || style.display === 'none' || Number(style.opacity) === 0) continue;\n      // A transformed ancestor inside the chart (a placed label): measured as its own rotated box.\n      let moved: HTMLElement | null = null;\n      for (let a: HTMLElement | null = el; a && a !== root; a = a.parentElement) if (getComputedStyle(a).transform !== 'none') { moved = a; break; }\n      const owner = moved ?? el;\n      if (!owners.has(owner)) owners.set(owner, owners.size);\n      const role = owner.closest('[data-role]')?.getAttribute('data-role') ?? owner.className;\n      const clip = clipOf(owner);\n      if (moved) {\n        if (out.some(b => b.owner === owners.get(owner))) continue;\n        const m = new DOMMatrix(getComputedStyle(moved).transform);\n        const r = moved.getBoundingClientRect();\n        const cut = r.left < clip.x0 - 1 || r.right > clip.x1 + 1 || r.top < clip.y0 - 1 || r.bottom > clip.y1 + 1;\n        // A wrapped label holds one child per line: its text is the lines joined by a space.\n        const text = moved.children.length ? [...moved.children].map(c => c.textContent ?? '').join(' ') : moved.textContent ?? '';\n        out.push({ text, owner: owners.get(owner)!, cx: r.x + r.width / 2, cy: r.y + r.height / 2, w: moved.offsetWidth, h: moved.offsetHeight, angle: Math.atan2(m.b, m.a), role, seen: cut ? (clip.ellipsis ? 'ellipsis' : 'clipped') : 'whole' });\n        continue;\n      }\n      const range = document.createRange();\n      range.selectNodeContents(n);\n      // The line box, not the font's content area: a content area taller than the line height reaches\n      // above and below the line with no ink in it.\n      const line = parseFloat(style.lineHeight);\n      for (const r of range.getClientRects()) {\n        if (r.width < 0.5 || r.height < 0.5) continue;\n        const h0 = Number.isFinite(line) ? Math.min(r.height, line) : r.height;\n        const top = r.y + (r.height - h0) / 2;\n        // The painted part: the line box cut to the clipping rectangle.\n        const x0 = Math.max(r.left, clip.x0), x1 = Math.min(r.right, clip.x1), y0 = Math.max(top, clip.y0), y1 = Math.min(top + h0, clip.y1);\n        const cut = x0 > r.left + 1 || x1 < r.right - 1 || y0 > top + 1 || y1 < top + h0 - 1;\n        if (x1 <= x0 || y1 <= y0) { out.push({ text: n.textContent ?? '', owner: owners.get(owner)!, cx: r.x, cy: r.y, w: 0, h: 0, angle: 0, role, seen: clip.ellipsis ? 'ellipsis' : 'clipped' }); continue; }\n        out.push({ text: n.textContent ?? '', owner: owners.get(owner)!, cx: (x0 + x1) / 2, cy: (y0 + y1) / 2, w: x1 - x0, h: y1 - y0, angle: 0, role, seen: cut ? (clip.ellipsis ? 'ellipsis' : 'clipped') : 'whole' });\n      }\n    }\n    return out;\n  }, selector);\n}\n\nfunction corners(b: TextBox, shrink: number): [number, number][] {\n  const w = Math.max(0, b.w / 2 - shrink), h = Math.max(0, b.h / 2 - shrink);\n  const c = Math.cos(b.angle), s = Math.sin(b.angle);\n  return ([[-w, -h], [w, -h], [w, h], [-w, h]] as const).map(([x, y]) => [b.cx + x * c - y * s, b.cy + x * s + y * c] as [number, number]);\n}\n\n/** Whether two boxes overlap by more than `tolerance` px (each is shrunk by half of it on every side). */\nexport function overlap(a: TextBox, b: TextBox, tolerance = 1): boolean {\n  const pa = corners(a, tolerance / 2), pb = corners(b, tolerance / 2);\n  for (const poly of [pa, pb]) {\n    for (let i = 0; i < 4; i++) {\n      const [x1, y1] = poly[i]!, [x2, y2] = poly[(i + 1) % 4]!;\n      const nx = y2 - y1, ny = x1 - x2;\n      const project = (p: [number, number][]) => p.map(([x, y]) => x * nx + y * ny);\n      const A = project(pa), B = project(pb);\n      if (Math.max(...A) <= Math.min(...B) || Math.max(...B) <= Math.min(...A)) return false;\n    }\n  }\n  return true;\n}\n\n/** The axis-aligned extent of a box. */\nexport function extent(b: TextBox): { x0: number; y0: number; x1: number; y1: number } {\n  const p = corners(b, 0);\n  return { x0: Math.min(...p.map(q => q[0])), y0: Math.min(...p.map(q => q[1])), x1: Math.max(...p.map(q => q[0])), y1: Math.max(...p.map(q => q[1])) };\n}\n\n/** Every pair of painted boxes that overlap by more than `tolerance`, the lines of one element included. */\nexport function overlaps(boxes: readonly TextBox[], tolerance = 1): string[] {\n  const out: string[] = [];\n  for (let i = 0; i < boxes.length; i++) {\n    for (let j = i + 1; j < boxes.length; j++) {\n      if (!boxes[i]!.w || !boxes[j]!.w) continue;\n      if (overlap(boxes[i]!, boxes[j]!, tolerance)) out.push(`\"${boxes[i]!.text}\" × \"${boxes[j]!.text}\"`);\n    }\n  }\n  return out;\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_57","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/browser/acceptance/f8-donut.browser.test.ts'","aggregated_output":"/**\n * F8, rendered (spec 3.1): donut slices keep the given order, start at 12 o'clock and run clockwise (read\n * from the screenshot along the ring); the legend shows every slice's value and percentage as text, in\n * slice order; zero, null, negative, more than eight and all-zero slices each have their own outcome.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport { start, stop } from '../harness';\nimport { axWithin, closePage, create, devPage, distance, pixel, resolveColors, ring, screenshot, settle, type RGB } from './util';\nimport { share, SPEND, withUnit } from './fixtures';\n\nbeforeAll(start);\nafterAll(stop);\n\n/** The colour of each legend entry's swatch, resolved by the page. */\nasync function legendColors(page: import('playwright-core').Page): Promise<RGB[]> {\n  const css = await page.locator('#chart ul.axylo-legend-list > li svg.axylo-swatch').evaluateAll(els => els.map(e => getComputedStyle(e).color));\n  return resolveColors(page, css);\n}\n\nasync function sliceCount(page: import('playwright-core').Page): Promise<number> {\n  // Every path of a donut's scene is a slice (the \"Other\" slice has its own muted colour).\n  return page.evaluate(() => document.querySelectorAll('#chart svg.axylo-svg .axylo-scene path').length);\n}\n\n/** Each legend entry as \"name value\": its name and value parts joined by a space. */\nasync function legend(page: import('playwright-core').Page): Promise<string[]> {\n  return page.locator('#chart ul.axylo-legend-list > li').evaluateAll(lis => lis.map(li =>\n    [li.querySelector('.axylo-legend-name')?.textContent ?? '', li.querySelector('.axylo-legend-value')?.textContent ?? ''].join(' ').trim()));\n}\n\ndescribe('F8 donut geometry and legend', () => {\n  it('F8 donut: slices keep the given (unsorted) order, start at 12 o\\'clock and run clockwise: the ring at each slice\\'s middle angle shows that slice\\'s legend colour', async () => {\n    const page = await devPage();\n    await create(page, 'donut');\n    const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n    const g = await ring(page);\n    const colors = await legendColors(page);\n    expect(colors).toHaveLength(4);\n    const total = SPEND.values.reduce((a, b) => a + b, 0);\n    const at = (degrees: number) => {\n      const a = degrees * Math.PI / 180, r = g.outer * 0.85;\n      return pixel(img, g.cx - plot.x + r * Math.sin(a), g.cy - plot.y - r * Math.cos(a));\n    };\n    let before = 0;\n    SPEND.values.forEach((v, i) => {\n      const mid = 360 * (before + v / 2) / total;\n      before += v;\n      const seen = at(mid);\n      const nearest = colors.map(c => distance(c, seen)).indexOf(Math.min(...colors.map(c => distance(c, seen))));\n      expect(nearest, `${SPEND.items[i]} at ${mid}°: ${seen}`).toBe(i);\n      expect(distance(colors[i]!, seen), `${SPEND.items[i]} at ${mid}°`).toBeLessThanOrEqual(24);\n    });\n    // Just clockwise of 12 o'clock is the first slice; just anticlockwise of it, the last.\n    expect(distance(at(3), colors[0]!)).toBeLessThanOrEqual(24);\n    expect(distance(at(357), colors[3]!)).toBeLessThanOrEqual(24);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('F8 donut: the legend shows every slice\\'s value and percentage as text, in slice order, and is in the accessibility tree', async () => {\n    const page = await devPage();\n    await create(page, 'donut');\n    const entries = await legend(page);\n    expect(entries).toHaveLength(4);\n    SPEND.items.forEach((item, i) => {\n      const e = entries[i]!;\n      expect(e.startsWith(item), e).toBe(true);\n      expect(e).toContain(withUnit(SPEND.values[i]!, SPEND.unit));\n      expect(e).toContain(share(SPEND.values[i]!));\n    });\n    const text = (await axWithin(page, '#chart ul.axylo-legend-list')).filter(n => n.role === 'StaticText').map(n => n.name).join(' ');\n    for (const item of SPEND.items) expect(text).toContain(item);\n    expect(text).toContain(share(SPEND.values[0]!));\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('F8 donut: a zero slice is listed without an arc; a null slice is listed as \"No data\", without an arc', async () => {\n    const page = await devPage();\n    await create(page, 'donut', { data: [{ item: 'Rent', spend: 1200 }, { item: 'Gifts', spend: 0 }, { item: 'Food', spend: 600 }, { item: 'Pets', spend: null }] });\n    const entries = await legend(page);\n    expect(entries.map(e => e.split(/\\s/)[0])).toEqual(['Rent', 'Gifts', 'Food', 'Pets']);\n    expect(entries[1]).toContain(withUnit(0, SPEND.unit));\n    expect(entries[3]).toContain('No data');\n    expect(entries[3]).not.toMatch(/\\d/);\n    expect(await sliceCount(page)).toBe(2);\n    // The two drawn arcs are Rent (two thirds, from 12 o'clock) and Food (the last third), by colour.\n    const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n    const g = await ring(page);\n    const colors = await legendColors(page);\n    const at = (deg: number) => { const a = (deg * Math.PI) / 180; return pixel(img, g.cx - plot.x + 0.85 * g.outer * Math.sin(a), g.cy - plot.y - 0.85 * g.outer * Math.cos(a)); };\n    expect(distance(at(120), colors[0]!), 'Rent at 120°').toBeLessThanOrEqual(24);\n    expect(distance(at(300), colors[2]!), 'Food at 300°').toBeLessThanOrEqual(24);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('F8 donut: a negative value is AX120 and the chart shows its error state inside the plot, with no slices', async () => {\n    const page = await devPage();\n    const built = await create(page, 'donut', { data: [{ item: 'Rent', spend: 1200 }, { item: 'Refund', spend: -50 }], messages: { error: 'This donut cannot be drawn.' } });\n    expect(built.diagnostics.filter(d => d.code === 'AX120').map(d => d.level)).toEqual(['error']);\n    expect(await sliceCount(page)).toBe(0);\n    const message = page.locator('#chart .axylo-plot .axylo-message');\n    expect(await message.isVisible()).toBe(true);\n    expect(((await message.textContent()) ?? '').trim()).toBe('This donut cannot be drawn.');\n    const text = (await axWithin(page, '#chart')).filter(n => n.role === 'StaticText').map(n => n.name).join(' ');\n    expect(text).toContain(((await message.textContent()) ?? '').trim());\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('F8 donut: ten slices in scrambled order draw the seven largest, in their given order, then \"Other (3)\" holding the other three, with AX121; arcs and legend agree; the table lists all ten in the given order', async () => {\n    const page = await devPage();\n    // The seven largest are not the first seven: S2 30, S3 8, S5 20, S6 15, S8 10, S9 6, S10 5; Other = S1 3 + S4 2 + S7 4.\n    const values = [3, 30, 8, 2, 20, 15, 4, 10, 6, 5];\n    const built = await create(page, 'donut', { data: values.map((v, i) => ({ item: `S${i + 1}`, spend: v })) });\n    expect(built.diagnostics.filter(d => d.code === 'AX121').map(d => d.level)).toEqual(['warning']);\n    const drawn = [['S2', 30], ['S3', 8], ['S5', 20], ['S6', 15], ['S8', 10], ['S9', 6], ['S10', 5], ['Other (3)', 9]] as const;\n    const entries = await legend(page);\n    expect(entries.map(e => e.replace(/\\s+[\\d,.]+\\s*EUR.*$/, ''))).toEqual(drawn.map(d => d[0]));\n    drawn.forEach(([, v], i) => expect(entries[i]).toContain(withUnit(v, SPEND.unit)));\n    expect(await sliceCount(page)).toBe(8);\n    // Each arc sits where its share puts it, clockwise from 12 o'clock, in the legend's colour.\n    const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n    const g = await ring(page);\n    const colors = await legendColors(page);\n    const total = values.reduce((a, b) => a + b, 0);\n    let before = 0;\n    const wrong: string[] = [];\n    drawn.forEach(([name, v], i) => {\n      const a = (2 * Math.PI * (before + v / 2)) / total;\n      before += v;\n      const seen = pixel(img, g.cx - plot.x + 0.85 * g.outer * Math.sin(a), g.cy - plot.y - 0.85 * g.outer * Math.cos(a));\n      if (distance(seen, colors[i]!) > 24) wrong.push(`${name} at ${Math.round((a * 180) / Math.PI)}°: ${seen}, legend ${colors[i]}`);\n    });\n    expect(wrong).toEqual([]);\n    await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n    await settle(page);\n    const rows = await page.locator('#chart table tbody th[scope=\"row\"]').allTextContents();\n    expect(rows).toEqual(values.map((_, i) => `S${i + 1}`));\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('F8 donut: eight slices are all drawn and raise no AX121; the ninth is what groups', async () => {\n    const page = await devPage();\n    const built = await create(page, 'donut', { data: [5, 1, 4, 2, 8, 3, 7, 6].map((v, i) => ({ item: `S${i + 1}`, spend: v })) });\n    expect(built.diagnostics.map(d => d.code)).not.toContain('AX121');\n    expect(await sliceCount(page)).toBe(8);\n    expect((await legend(page)).map(e => e.split(' ')[0])).toEqual(['S1', 'S2', 'S3', 'S4', 'S5', 'S6', 'S7', 'S8']);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('F8 donut: zero and null slices do not count toward the eight-slice limit and are never grouped: eight drawn slices plus a zero and a null raise no AX121 and list all ten, the zero and the null by name', async () => {\n    const page = await devPage();\n    const data = [5, 0, 1, 4, 2, null, 8, 3, 7, 6].map((v, i) => ({ item: `S${i + 1}`, spend: v }));\n    const built = await create(page, 'donut', { data });\n    expect(built.diagnostics.map(d => d.code)).not.toContain('AX121');\n    expect(await sliceCount(page)).toBe(8);\n    const entries = await legend(page);\n    expect(entries.map(e => e.split(' ')[0])).toEqual(data.map(d => d.item));\n    expect(entries[1]).toContain(withUnit(0, SPEND.unit));\n    expect(entries[5]).toContain('No data');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('F8 donut: an all-zero donut shows the empty state inside the plot, with its exact message and no slices', async () => {\n    const page = await devPage();\n    await create(page, 'donut', { data: SPEND.items.map(item => ({ item, spend: 0 })), messages: { empty: 'Nothing spent this month.' } });\n    expect(await sliceCount(page)).toBe(0);\n    const message = page.locator('#chart .axylo-plot .axylo-message');\n    expect(await message.isVisible()).toBe(true);\n    expect(((await message.textContent()) ?? '').trim()).toBe('Nothing spent this month.');\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/acceptance/f-series.test.ts'","aggregated_output":"import fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { at, chart, codes, committed, compactKinds, expectCompact, lastModel, marks, seriesRows } from './model';\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F9 ${type}: six and eight series have distinct paint bindings; twelve retain distinct painted cues and raise AX130`, () => {\n    for (const kind of compactKinds(type)) {\n      for (const size of [6, 8, 12]) {\n        const r = chart(type, seriesRows(size), { series: 's' }, undefined, kind);\n        r.frames();\n        expect(codes(r).includes('AX130')).toBe(size > 8);\n        const cues = (type === 'bar' || type === 'compact' && kind === 'bar') ? marks(r, 'rects').filter(mark => mark.variant === 'bar').map(mark => [mark.fill, mark.pattern ?? 'none'])\n          : type === 'scatter' ? marks(r, 'points').map(mark => [mark.fill, mark.shape])\n            : marks(r, 'path').map(mark => [mark.stroke, mark.dash.normal]);\n        expect(cues).toHaveLength(size);\n        const firstEight = cues.slice(0, 8).map(([paint]) => JSON.stringify(paint));\n        expect(new Set(firstEight).size).toBe(Math.min(8, size));\n        expect(new Set(cues.map(cue => JSON.stringify(cue))).size).toBe(size);\n        for (let i = 8; i < size; i++) expect(cues[i]![1]).not.toEqual(cues[i - 8]![1]);\n        expect(lastModel(r).summary).toContain(size + ' series');\n        expect(lastModel(r).note).toBeNull();\n        if (type === 'compact') expectCompact(r);\n        else if (type !== 'scatter') {\n          expect(at(r, 1).count).toBe(size);\n          expect(at(r, 1).rows.map(row => row.seriesLabel)).toEqual(seriesRows(Math.min(size, 8)).filter(row => row.x === 1).map(row => row.s));\n          expect(committed(r).reader.table?.headers).toHaveLength(size + 1);\n        }\n      }\n    }\n  });\n}\n\nit('F9 line: generated series counts beyond eight retain distinguishable cues', () => {\n  fc.assert(fc.property(fc.integer({ min: 9, max: 24 }), count => {\n    const r = chart('line', seriesRows(count), { series: 's' }, { console: false });\n    r.frames();\n    expect(codes(r)).toEqual(['AX130']);\n    const cues = marks(r, 'path').map(mark => JSON.stringify([mark.stroke, mark.dash.normal]));\n    expect(cues).toHaveLength(count);\n    expect(new Set(cues).size).toBe(count);\n  }), { numRuns: 1_000 });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_58","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/acceptance/model.ts'","aggregated_output":"import { expect } from 'vitest';\nimport type { ChartKind } from '../../src/core/controller';\nimport type { DatumRef, Layout, Mark, TooltipModel, XScale } from '../../src/core/contracts';\nimport { defaultMessages } from '../../src/messages';\nimport { valueText } from '../../src/core/focus';\nimport { lastModel, record, type HostOptions, type Recording } from '../core/host';\n\nexport { lastModel, record, type Recording };\nexport const types = ['line', 'area', 'bar', 'scatter', 'donut', 'compact'] as const;\nexport const aligned = ['line', 'area', 'bar'] as const;\nexport const compactKinds = (type: Type) => type === 'compact' ? aligned : ['line'] as const;\nexport { defaultMessages };\nexport function message(key: keyof typeof defaultMessages, values: Record<string, string | number> = {}) {\n  let text = defaultMessages[key];\n  for (const [name, value] of Object.entries(values)) text = text.replaceAll(`{${name}}`, String(value));\n  return text.trim();\n}\nexport type Type = typeof types[number];\nexport const day = 86_400_000;\nexport const date = (offset: number) => Date.UTC(2024, 1, 24) + offset * day;\n\nexport function chart(type: Type, data: unknown, options: Record<string, unknown> = {}, host?: HostOptions, compactKind: typeof aligned[number] = 'line') {\n  const encoding = type === 'donut' ? { label: 'x', value: 'y' } : { x: 'x', y: 'y' };\n  const kind: ChartKind = type === 'compact' ? compactKind : type;\n  return record(kind, { title: 'Measurements', data, ...encoding, compact: type === 'compact' || undefined, ...options }, host);\n}\n\nexport function committed(r: Recording) {\n  expect(r.committed, 'frame handed to interaction').not.toBeNull();\n  return r.committed!;\n}\n\nexport function plot(r: Recording): Extract<Layout, { kind: 'plot' | 'compact' }> {\n  const layout = committed(r).layout;\n  if (layout.kind !== 'plot' && layout.kind !== 'compact') throw new Error('Expected a plot, got ' + layout.kind);\n  return layout;\n}\n\nexport function axes(r: Recording) {\n  const { projection } = plot(r);\n  if (projection.kind === 'ring') throw new Error('Expected Cartesian axes');\n  return projection.kind === 'xy' ? { x: projection.x, y: projection.y } : { x: projection.band, y: projection.value };\n}\n\nexport const pixel = (axis: XScale, x: number) => axis.type === 'band' ? axis.center(x) : axis.map(x);\nexport const codes = (r: Recording) => r.controller.handle.diagnostics.map(d => d.code);\nexport const scene = (r: Recording) => r.draws.at(-1)!;\nexport const marks = <Kind extends Mark['type']>(r: Recording, kind: Kind) =>\n  scene(r).marks.filter((mark): mark is Extract<Mark, { type: Kind }> => mark.type === kind);\nexport const rows = (r: Recording) => {\n  const table = committed(r).reader.table;\n  expect(table, 'table model handed to interaction').not.toBeNull();\n  return Array.from({ length: table!.rowCount }, (_, i) => table!.row(i)!);\n};\n\nexport function walk(r: Recording, limit = 100) {\n  const { lookup } = committed(r);\n  const result: DatumRef[] = [];\n  for (let ref = lookup.step(null, 'first'); ref !== null; ref = lookup.step(ref, 'next')) {\n    if (result.length === limit) throw new Error('Keyboard walk exceeded the expected fixture length');\n    result.push(ref);\n  }\n  return result;\n}\n\nexport function reading(r: Recording, ref: DatumRef, mode: 'all' | 'single' = 'all') {\n  const { view, lookup, formatters, messages } = committed(r);\n  return valueText(view, lookup, ref, mode, formatters, messages);\n}\n\nexport function at(r: Recording, x: number): TooltipModel {\n  return committed(r).lookup.tooltip({ kind: 'x', x });\n}\n\nexport function refAt(r: Recording, x: number): DatumRef {\n  const ref = committed(r).lookup.primary({ kind: 'x', x });\n  expect(ref, 'readable datum at the fixture x').not.toBeNull();\n  return ref!;\n}\n\nexport function expectValues(r: Recording, x: number, expected: readonly string[]) {\n  const tooltip = at(r, x);\n  expect(tooltip.rows.map(row => row.value)).toEqual(expected);\n  const ref = refAt(r, x);\n  for (const value of expected) expect(reading(r, ref)).toContain(value);\n}\n\nexport function points(xy: Float32Array): [number, number][] {\n  const result: [number, number][] = [];\n  for (let i = 0; i < xy.length; i += 2) result.push([xy[i]!, xy[i + 1]!]);\n  return result;\n}\n\nexport function pathRuns(xy: Float32Array): [number, number][][] {\n  const runs: [number, number][][] = [[]];\n  for (const pair of points(xy)) {\n    if (Number.isNaN(pair[0])) runs.push([]);\n    else runs.at(-1)!.push(pair);\n  }\n  return runs.filter(run => run.length > 0);\n}\n\nexport function expectGeometry(actual: readonly number[], expected: readonly number[]) {\n  expect(actual).toHaveLength(expected.length);\n  expected.forEach((number, i) => expect(actual[i]).toBeCloseTo(number, 3));\n}\n\nexport function expectCompact(r: Recording) {\n  expect(committed(r)).toMatchObject({ interactive: false, zoom: false, reader: { table: null } });\n  expect(r.texts.at(-1)).toEqual([]);\n  expect(r.announcements).toEqual([]);\n}\n\nexport function seriesRows(size: number) {\n  return Array.from({ length: size }, (_, n) => [\n    { s: 'Series ' + n, x: 1, y: n + 1 }, { s: 'Series ' + n, x: 2, y: n + 2 },\n  ]).flat();\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/acceptance/type-matrix.test.ts'","aggregated_output":"import { expect, it } from 'vitest';\nimport { stepAcross, targetOf } from '../../src/core/focus';\nimport { aligned, at, axes, chart, codes, committed, day, expectGeometry, lastModel, marks, pixel, plot, reading, refAt, rows, seriesRows, walk } from './model';\n\nconst xy = [{ x: 1, y: 6 }, { x: 2, y: 8 }, { x: 3, y: 4 }];\nconst donut = [{ x: 'First', y: 3 }, { x: 'Zero', y: 0 }, { x: 'Missing', y: null }, { x: 'Last', y: 1 }];\n\nfor (const kind of aligned) {\n  it(`T-keyboard-${kind} ${kind}: visits once per x then switches through series in declared order (reading: x and series use their own keys)`, () => {\n    const categories = kind === 'bar';\n    const values = categories ? ['West', 'East'] : [1, 2];\n    const r = chart(kind, [\n      { x: values[0], s: 'Website', y: 11 }, { x: values[1], s: 'Website', y: 22 },\n      { x: values[0], s: 'Phone', y: 33 }, { x: values[1], s: 'Phone', y: 44 },\n    ], { series: 's' });\n    r.frames();\n    const { view, lookup } = committed(r);\n    if (view.kind === 'donut' || view.kind === 'scatter') throw new Error('Expected aligned data');\n    const [first, second] = categories ? [0, 1] : [1, 2];\n    expect(stepAcross(view, null, 'first')).toBe(first);\n    expect(stepAcross(view, first, 'next')).toBe(second);\n    expect(stepAcross(view, second, 'next')).toBeNull();\n    expect(stepAcross(view, second, 'previous')).toBe(first);\n    for (const [x, expected] of [[first!, ['11', '33']], [second!, ['22', '44']]] as const) {\n      const selected = refAt(r, x);\n      const next = lookup.step(selected, 'series-next');\n      expect(lookup.datum(selected)?.seriesLabel).toBe('Website');\n      expect(lookup.datum(next!)?.seriesLabel).toBe('Phone');\n      expect(lookup.step(next, 'series-previous')).toEqual(selected);\n      expect([lookup.datum(selected)?.value, lookup.datum(next!)?.value]).toEqual(expected);\n    }\n  });\n\n  it(`T-pointer-${kind} ${kind}: picks ${kind === 'bar' ? 'the category band under the pointer at either edge' : 'the nearest x regardless of pointer height'}`, () => {\n    for (const horizontal of kind === 'bar' ? [false, true] : [false]) {\n      const r = chart(kind, kind === 'bar' ? [{ x: 'One', y: 10 }, { x: 'Two', y: 3 }, { x: 'Three', y: 8 }] : xy, horizontal ? { horizontal } : {});\n      r.frames();\n      const { x } = axes(r);\n      const { plot: box } = plot(r);\n      const projection = kind === 'bar' ? [0, 1, 2] : [1, 2, 3];\n      projection.forEach(position => {\n        const across = pixel(x, position);\n        const neighbor = kind === 'bar' ? 0 : position === 3 ? -1 : 1;\n        const near = neighbor ? across + (pixel(x, position + neighbor) - across) / 4 : across;\n        for (const side of [1, (horizontal ? box.width : box.height) - 1]) {\n          const [px, py] = horizontal ? [box.x + side, near] : [near, box.y + side];\n          expect(committed(r).lookup.pick(px, py)).toEqual({ kind: 'x', x: position });\n        }\n      });\n    }\n  });\n\n  it(`T-tooltip-${kind} ${kind}: lists visible series in order and distinguishes No observation from No data`, () => {\n    const data = [\n      { x: 1, y: 5, s: 'Alpha' }, { x: 2, y: 6, s: 'Alpha' }, { x: 3, y: 7, s: 'Alpha' },\n      { x: 1, y: 8, s: 'Beta' }, { x: 2, y: null, s: 'Beta' },\n      { x: 1, y: 9, s: 'Gamma' }, { x: 3, y: 11, s: 'Gamma' },\n    ];\n    const r = chart(kind, data, { series: 's', ...(kind === 'area' ? { stacked: true } : {}) });\n    r.frames();\n    const readout = at(r, 2);\n    expect(readout.rows.map(row => [row.seriesLabel, row.value])).toEqual([\n      ['Alpha', '6'], ['Beta', 'No data'], ['Gamma', 'No observation'],\n    ]);\n    expect(readout.total).toBe(kind === 'area' ? '6 (incomplete)' : null);\n    const beta = readout.rows[1]!.ref;\n    if (beta.kind !== 'aligned') throw new Error('Expected an aligned series');\n    r.controller.actions.toggle(beta.seriesKey);\n    r.frames();\n    expect(at(r, 2).rows.map(row => row.seriesLabel)).toEqual(['Alpha', 'Gamma']);\n    expect(reading(r, refAt(r, 2))).not.toContain('Beta');\n  });\n}\n\nit('T-keyboard-donut donut: steps through all slices in given order including zero and missing and returns in reverse', () => {\n  const r = chart('donut', donut);\n  r.frames();\n  const { lookup } = committed(r);\n  const refs = walk(r);\n  expect(refs.map(ref => lookup.datum(ref)?.seriesLabel)).toEqual(['First', 'Zero', 'Missing', 'Last']);\n  expect(refs.map(ref => lookup.datum(ref)?.value)).toEqual(['3', '0', 'No data', '1']);\n  expect(lookup.step(refs[0]!, 'previous')).toBeNull();\n  expect(refs.slice(1).map(ref => lookup.step(ref, 'previous'))).toEqual(refs.slice(0, -1));\n});\n\nit('T-keyboard-scatter scatter: moves by x then y across series and can traverse all points in reverse', () => {\n  const r = chart('scatter', [{ x: 2, y: 1, s: 'B' }, { x: 1, y: 4, s: 'A' }, { x: 1, y: 3, s: 'B' }, { x: 2, y: 2, s: 'A' }], { series: 's' });\n  r.frames();\n  const { lookup } = committed(r);\n  const refs = walk(r);\n  expect(refs.map(ref => lookup.datum(ref)?.row)).toEqual([2, 1, 0, 3]);\n  expect(lookup.step(refs[0]!, 'previous')).toBeNull();\n  expect(refs.slice(1).map(ref => lookup.step(ref, 'previous'))).toEqual(refs.slice(0, -1));\n});\n\nit('T-pointer-donut donut: picks clockwise by arc; the hole and outside of the ring yield no slice', () => {\n  const r = chart('donut', donut);\n  r.frames();\n  const { lookup } = committed(r);\n  const arc = marks(r, 'arcs')[0]!;\n  const radius = (arc.r0 + arc.r1) / 2;\n  expect(lookup.pick(arc.cx + radius, arc.cy)).toEqual({ kind: 'slice', sliceKey: 'First' });\n  expect(lookup.pick(arc.cx - radius / Math.sqrt(2), arc.cy - radius / Math.sqrt(2))).toEqual({ kind: 'slice', sliceKey: 'Last' });\n  expect(lookup.pick(arc.cx, arc.cy)).toBeNull();\n  expect(lookup.pick(arc.cx + arc.r1 + 1, arc.cy)).toBeNull();\n});\n\nit('T-pointer-scatter scatter: picks the nearest point within 24 CSS pixels and breaks a distance tie by later caller row', () => {\n  const r = chart('scatter', [{ x: 49, y: 5 }, { x: 51, y: 5 }], {\n    x: { field: 'x', domain: [0, 100] }, y: { field: 'y', domain: [0, 10] },\n  });\n  r.frames();\n  const { x, y } = axes(r);\n  const { lookup } = committed(r);\n  const px = pixel(x, 49);\n  const py = y.map(5);\n  expect(lookup.primary(lookup.pick(px, py + 23.5)!)?.kind).toBe('point');\n  expect(lookup.pick(px, py + 24.5)).toBeNull();\n  const tx = (px + pixel(x, 51)) / 2;\n  const tied = lookup.pick(tx, py)!;\n  expect(lookup.datum(lookup.primary(tied)!)?.row).toBe(1);\n});\n\nit('T-tooltip-donut donut: tooltip gives slice label, value and percentage independently', () => {\n  const r = chart('donut', donut);\n  r.frames();\n  const { lookup } = committed(r);\n  const tooltip = lookup.tooltip(targetOf(walk(r)[0]!));\n  expect(tooltip.title).toBe('First');\n  expect(tooltip.rows).toMatchObject([{ seriesLabel: 'First', value: '3', percent: '75%' }]);\n  expect(tooltip.total).toBeNull();\n});\n\nit('T-tooltip-scatter scatter: lists at most eight coincident points, reports the total and includes series, x and y', () => {\n  const r = chart('scatter', Array.from({ length: 10 }, (_, i) => ({ x: 3, y: 6, s: 'Point ' + i })), { series: 's' });\n  r.frames();\n  const { x, y } = axes(r);\n  const { lookup } = committed(r);\n  const tooltip = lookup.tooltip(lookup.pick(pixel(x, 3), y.map(6))!);\n  expect(tooltip.title).toBe('3');\n  expect(tooltip.count).toBe(10);\n  expect(tooltip.rows).toHaveLength(8);\n  expect(tooltip.rows[0]).toMatchObject({ seriesLabel: 'Point 9', x: '3', value: '6', row: 9 });\n  expect(tooltip.rows.every(row => row.x === '3' && row.value === '6')).toBe(true);\n  expect(new Set(tooltip.rows.map(row => row.seriesLabel)).size).toBe(8);\n});\n\nfor (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n  it(`T-zoom-${type} ${type}: numeric, time and calendar-date fields support zoom on x and Reset restores all observations`, () => {\n    const epoch = Date.UTC(2024, 1, 24);\n    for (const [kind, values] of [\n      ['number', [1, 2, 3]],\n      ['time', [epoch, epoch + day, epoch + 2 * day]],\n      ['date', ['2024-02-24', '2024-02-25', '2024-02-26']],\n    ] as const) {\n      const r = chart(type, xy.map((row, i) => ({ ...row, x: values[i]! })), { x: { field: 'x', type: kind }, y: { field: 'y', domain: [0, 10] } });\n      const handle = r.controller.handle;\n      r.frames();\n      expect(committed(r).zoom).toBe(true);\n      handle.zoom([values[1], values[2]]);\n      r.frames();\n      expect(committed(r).zoomed).toBe(true);\n      expect(committed(r).lookup.count).toBe(2);\n      expect(axes(r).y.domain).toEqual([0, 10]);\n      expect(committed(r).reader.table?.rowCount).toBe(2);\n      handle.zoom(null);\n      r.frames();\n      expect(committed(r).zoomed).toBe(false);\n      expect(committed(r).reader.table?.rowCount).toBe(3);\n    }\n  });\n\n  it(`T-limit-${type} ${type}: eight series are accepted without AX130; the ninth raises it with all nine still readable`, () => {\n    const r = chart(type, seriesRows(8), { series: 's' });\n    r.frames();\n    expect(codes(r)).toEqual([]);\n    r.controller.handle.update({ data: seriesRows(9) });\n    r.frames();\n    expect(codes(r)).toEqual(['AX130']);\n    expect(lastModel(r).summary).toContain('9 series');\n    const mark = type === 'bar' ? 'rects' : type === 'scatter' ? 'points' : 'path';\n    expect(marks(r, mark)).toHaveLength(9);\n    if (type === 'scatter') expect(committed(r).reader.table?.rowCount).toBe(18);\n    else expect(at(r, 1)).toMatchObject({ count: 9, rows: expect.arrayContaining([expect.objectContaining({ seriesLabel: 'Series 0' })]) });\n  });\n\n  it(`T-reference-${type} ${type}: a line and band extend the appropriate domains, bind to reference paint and are listed in summary and caption`, () => {\n    const r = chart(type, xy, { reference: [{ y: 20, label: 'Target' }, { x: [4, 6], label: 'Outage' }] });\n    r.frames();\n    const { x, y } = axes(r);\n    if (x.type === 'band') throw new Error('Expected continuous axis');\n    expect(x.domain[1]).toBeGreaterThanOrEqual(6);\n    expect(y.domain[1]).toBeGreaterThanOrEqual(20);\n    const rule = marks(r, 'rule').find(mark => mark.role === 'reference')!;\n    expect(rule.stroke).toEqual({ kind: 'token', name: 'reference' });\n    expectGeometry([rule.y1, rule.y2], [y.map(20), y.map(20)]);\n    const band = marks(r, 'band')[0]!;\n    expect(band.fill).toEqual({ kind: 'token', name: 'reference' });\n    expectGeometry([band.box.x, band.box.width], [x.map(4), x.map(6) - x.map(4)]);\n    expect(r.texts.at(-1)?.filter(text => text.role === 'reference').map(text => text.full)).toEqual(expect.arrayContaining(['Target', 'Outage']));\n    for (const text of [lastModel(r).summary, committed(r).reader.table?.caption]) {\n      expect(text).toMatch(/Target at 20/);\n      expect(text).toMatch(/Outage from 4 to 6/);\n    }\n  });\n}\n\nit('T-zoom-bar bar: a category band axis ignores public zoom and retains all rows', () => {\n  const r = chart('bar', [{ x: 'B', y: 6 }, { x: 'A', y: 8 }, { x: 'C', y: 2 }]);\n  r.frames();\n  r.controller.handle.zoom(['A', 'C']);\n  r.frames();\n  expect(committed(r)).toMatchObject({ zoom: false, zoomed: false });\n  expect(rows(r).map(row => row[0])).toEqual(['B', 'A', 'C']);\n});\n\nit('T-zoom-donut donut: even an explicit zoom call leaves arc angles and table rows in slice order', () => {\n  const r = chart('donut', donut);\n  r.frames();\n  r.controller.handle.zoom([0, 1]);\n  r.frames();\n  expect(committed(r)).toMatchObject({ zoom: false, zoomed: false });\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(4);\n  expect(rows(r).map(row => row[0])).toEqual(['First', 'Zero', 'Missing', 'Last']);\n});\n\nit('T-limit-donut donut: eight positive values draw eight arcs; adding a ninth groups only the smallest two', () => {\n  const data = Array.from({ length: 9 }, (_, i) => ({ x: 'Slice ' + i, y: i + 1 }));\n  const r = chart('donut', data.slice(0, 8));\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(16);\n  r.controller.handle.update({ data });\n  r.frames();\n  expect(codes(r)).toEqual(['AX121']);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(16);\n  expect(lastModel(r).summary).toContain('Other (2): 3');\n  expect(rows(r)).toHaveLength(9);\n});\n\nit('T-reference-donut donut: a Cartesian reference option is diagnosed and produces neither reference marks nor reader text', () => {\n  const r = chart('donut', donut, { reference: [{ y: 20, label: 'Target' }] });\n  r.frames();\n  expect(codes(r)).toEqual(['AX150']);\n  expect(marks(r, 'rule')).toEqual([]);\n  expect(marks(r, 'band')).toEqual([]);\n  expect(lastModel(r).summary).not.toContain('Target');\n  expect(committed(r).reader.table?.caption).not.toContain('Target');\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/browser/acceptance/util.ts'","aggregated_output":"/**\n * Shared setup for the browser acceptance suite. Pages come from the existing harness (development\n * bundle, `chartPage`) or from `prod.html` in this directory (the minified production bundle). Charts are\n * created through the public API with the hand-written fixtures in `fixtures.ts`; the accessibility tree is\n * read from Chrome itself through the DevTools protocol (roles, names, descriptions, states), never from the\n * attributes the code sets, except where a comment says Chrome cannot report the property.\n *\n * THIS SUITE IS EVIDENCE FOR THE SVG RENDERER ONLY. It locates marks by reading the SVG DOM (paths, rects,\n * their colour slots) before sampling their pixels, so it says nothing about the canvas renderer, and it\n * refuses to run when `AXYLO_RENDERER=canvas` is set rather than report SVG results under a canvas run.\n *\n * Every checker the suite leans on (separators, painted colour, text overlap, table comparison, the focused\n * range, tooltip occlusion, motion, reference marks, dense columns) has a negative control in\n * `negative-controls.browser.test.ts` that breaks the behaviour from the test side and requires the\n * checker to report it.\n */\nimport type { Locator, Page } from 'playwright-core';\nimport { ENGINE, openPage, requireEngineFeature, url } from '../harness';\n\nexport { ENGINE, requireEngineFeature };\n\n/** Why a test that reads Chrome's computed accessibility tree is not run on another engine. */\nexport const AX_TREE_REASON = \"the browser's own computed accessibility tree (roles, names, descriptions, states) is read through the Chrome DevTools protocol; Playwright offers no engine-neutral equivalent (its aria snapshot is its own computation and carries no descriptions)\";\nimport { chartPage, RENDERER } from '../chart/util';\n\nif (RENDERER === 'canvas') {\n  throw new Error('The browser acceptance suite reads the SVG DOM and is evidence for the SVG renderer only; it does not run with AXYLO_RENDERER=canvas.');\n}\nimport { decodePng, type Image } from '../render/png';\nimport { type ChartType, optionsFor, type Variant } from './fixtures';\n\nexport { closePage, at, diff, shot } from '../chart/util';\nexport type { Image };\n\n/** The two elements around every chart, so the tab order can be walked from and to the page. */\n/** Why a test that drives the screen with more than one touch point, or drags a finger, is not run off Chromium. */\nexport const TOUCH_INPUT_REASON = \"multi-point and moving touch input is dispatched through the Chrome DevTools protocol (Input.dispatchTouchEvent); Playwright's engine-neutral touchscreen only taps\";\nexport const SHOW_BUTTONS = '#before, #after { display: inline-block !important; }';\n\nexport interface Built {\n  diagnostics: { code: string; level: string; message: string }[];\n}\n\n/** Development bundle page (`window.Axylo` from dist/axylo.iife.js), with `#before`, `#chart`, `#after`. */\nexport async function devPage(options: Parameters<typeof chartPage>[0] = {}): Promise<Page> {\n  return chartPage({ ...options, css: `${SHOW_BUTTONS} ${options.css ?? ''}` });\n}\n\n/** Runs in the page: the same renderer switch chart/util.ts applies, for the production page. */\nfunction selectRenderer(renderer: string): void {\n  const original = (window as unknown as { Axylo: Record<string, unknown> }).Axylo;\n  const wrapped: Record<string, unknown> = { ...original };\n  for (const name of ['line', 'area', 'bar', 'scatter', 'donut']) {\n    const make = original[name] as (target: unknown, options: Record<string, unknown>) => unknown;\n    wrapped[name] = (target: unknown, options: Record<string, unknown>) => make(target, { __renderer: renderer, ...options });\n  }\n  (window as unknown as { Axylo: unknown }).Axylo = wrapped;\n}\n\n/** Production bundle page (dist/axylo.iife.min.js, `__DEV__` false): no test hooks on the handle. */\nexport async function prodPage(options: { css?: string; viewport?: { width: number; height: number } } = {}): Promise<Page> {\n  const page = await openPage(options.viewport ? { viewport: options.viewport } : {});\n  await page.goto(url('packages/axylo/test/browser/acceptance/prod.html'));\n  if (RENDERER) await page.evaluate(selectRenderer, RENDERER);\n  await page.evaluate(() => { (window as unknown as { nextFrames(n?: number): Promise<void> }).nextFrames = (n = 1) => new Promise(r => { let k = n; const f = () => (--k <= 0 ? r() : requestAnimationFrame(f)); requestAnimationFrame(f); }); });\n  await page.addStyleTag({ content: `${SHOW_BUTTONS} ${options.css ?? ''}` });\n  return page;\n}\n\n/**\n * Creates a chart from the fixture of `type` (with `extra` merged over its options) in `target` and waits\n * until it has drawn. Works on both pages: in production there is no `__bench.ready`, so it waits for\n * frames until the figure exists.\n */\nexport async function create(page: Page, type: ChartType, extra: Record<string, unknown> = {}, target = '#chart', variant: Variant = 'default'): Promise<Built> {\n  const { fn, options } = optionsFor(type, variant);\n  return createRaw(page, fn, { ...options, ...extra }, target);\n}\n\n/** Creates a chart with options given in full. */\nexport async function createRaw(page: Page, fn: string, options: Record<string, unknown>, target = '#chart'): Promise<Built> {\n  return page.evaluate(async ({ fn, options, target }) => {\n    const w = window as unknown as {\n      Axylo: Record<string, (t: unknown, o: unknown) => { diagnostics: Built['diagnostics']; __bench?: { ready(): Promise<void> } }>;\n      charts: unknown[];\n    };\n    w.charts ??= [];\n    // NaN does not survive the trip into the page as JSON; fixtures write it as '__NaN__'.\n    const rows = (options as { data?: unknown }).data;\n    if (Array.isArray(rows)) for (const row of rows) for (const k of Object.keys(row)) if (row[k] === '__NaN__') row[k] = NaN;\n    const chart = w.Axylo[fn]!(target, options);\n    w.charts.push(chart);\n    const frame = () => new Promise(r => requestAnimationFrame(r));\n    if (chart.__bench) await chart.__bench.ready();\n    for (let i = 0; i < 3; i++) await frame();\n    return { diagnostics: chart.diagnostics.map(d => ({ code: d.code, level: d.level, message: d.message })) };\n  }, { fn, options, target });\n}\n\n/** Waits for every chart on the page to draw what it was last given, then one more frame. */\nexport async function settle(page: Page): Promise<void> {\n  await page.evaluate(async () => {\n    const charts = (window as unknown as { charts: { __bench?: { ready(): Promise<void> } }[] }).charts ?? [];\n    for (const c of charts) if (c.__bench) await c.__bench.ready();\n    for (let i = 0; i < 2; i++) await new Promise(r => requestAnimationFrame(r));\n  });\n}\n\n/** Calls a method on chart `index` in the page (`update`, `zoom`, `append`) and waits for it to draw. */\nexport async function call(page: Page, method: 'update' | 'zoom' | 'append', args: unknown[], index = 0): Promise<void> {\n  await page.evaluate(({ method, args, index }) => {\n    const charts = (window as unknown as { charts: Record<string, (...a: unknown[]) => void>[] }).charts;\n    charts[index]![method]!(...args);\n  }, { method, args, index });\n  await settle(page);\n}\n\n// ── accessibility tree (Chrome's own, through the DevTools protocol) ───────────────────────────────\n\nexport interface AX {\n  id: string;\n  role: string;\n  name: string;\n  description: string;\n  value: string;\n  ignored: boolean;\n  props: Record<string, unknown>;\n  children: string[];\n  backend: number | null;\n}\n\ninterface RawAX {\n  nodeId: string; ignored: boolean; role?: { value?: unknown }; name?: { value?: unknown }; description?: { value?: unknown };\n  value?: { value?: unknown }; properties?: { name: string; value: { value?: unknown } }[]; childIds?: string[]; backendDOMNodeId?: number;\n}\n\nfunction toAX(n: RawAX): AX {\n  const props: Record<string, unknown> = {};\n  for (const p of n.properties ?? []) props[p.name] = p.value?.value;\n  return {\n    id: n.nodeId, role: String(n.role?.value ?? ''), name: String(n.name?.value ?? ''), description: String(n.description?.value ?? ''),\n    value: String(n.value?.value ?? ''), ignored: n.ignored, props, children: n.childIds ?? [], backend: n.backendDOMNodeId ?? null,\n  };\n}\n\nasync function backendOf(page: Page, selector: string): Promise<number> {\n  requireEngineFeature(['chromium'], AX_TREE_REASON);\n  const client = await page.context().newCDPSession(page);\n  try {\n    const { root } = await client.send('DOM.getDocument', { depth: 0 });\n    const { nodeId } = await client.send('DOM.querySelector', { nodeId: root.nodeId, selector });\n    if (!nodeId) throw new Error(`no element for ${selector}`);\n    const { node } = await client.send('DOM.describeNode', { nodeId });\n    return node.backendNodeId;\n  } finally {\n    await client.detach();\n  }\n}\n\n/** Chrome's accessibility node for the first element matching `selector`. */\nexport async function axOf(page: Page, selector: string): Promise<AX> {\n  const backend = await backendOf(page, selector);\n  const client = await page.context().newCDPSession(page);\n  try {\n    const { nodes } = await client.send('Accessibility.getPartialAXTree', { backendNodeId: backend, fetchRelatives: false });\n    return toAX(nodes[0] as RawAX);\n  } finally {\n    await client.detach();\n  }\n}\n\n/**\n * The accessibility nodes inside the element matching `selector` (the element's own node first), in tree\n * order, without ignored nodes: what an assistive technology can reach there.\n */\nexport async function axWithin(page: Page, selector = '#chart'): Promise<AX[]> {\n  const backend = await backendOf(page, selector);\n  const client = await page.context().newCDPSession(page);\n  try {\n    const { nodes } = await client.send('Accessibility.getFullAXTree');\n    const all = new Map((nodes as RawAX[]).map(n => [n.nodeId, toAX(n)]));\n    const start = [...all.values()].find(n => n.backend === backend);\n    if (!start) return [];\n    const out: AX[] = [];\n    const visit = (id: string) => {\n      const n = all.get(id);\n      if (!n) return;\n      if (!n.ignored) out.push(n);\n      for (const c of n.children) visit(c);\n    };\n    visit(start.id);\n    return out;\n  } finally {\n    await client.detach();\n  }\n}\n\n/** The text an assistive technology finds inside `selector`: names and static text of unignored nodes. */\nexport async function axText(page: Page, selector = '#chart'): Promise<string> {\n  const nodes = await axWithin(page, selector);\n  return nodes.filter(n => n.role === 'StaticText').map(n => n.name).join(' • ');\n}\n\n/** The plot's range as the reader meets it: focus, Chrome's computed role and numbers, and its value text. */\nexport interface FocusedRange {\n  /** The range is the document's active element. */\n  focused: boolean;\n  /** Chrome's computed role for it ('slider'), and whether Chrome exposes it at all. */\n  role: string;\n  ignored: boolean;\n  /** Chrome's computed numeric value and bounds. */\n  value: number;\n  max: number;\n  /**\n   * DOM ATTRIBUTE, not the computed tree: `aria-valuetext`. Chrome's DevTools tree reports the range's\n   * number as its value text (decision 0001), so the text is read from the attribute the platform tree is\n   * built from. What a screen reader speaks from it is established only by rehearsal (spec A3).\n   */\n  text: string;\n}\n\nexport async function readRange(page: Page, selector = '#chart'): Promise<FocusedRange> {\n  const proxy = `${selector} .axylo-proxy`;\n  const focused = await page.evaluate(sel => document.activeElement === document.querySelector(sel), proxy);\n  if (ENGINE !== 'chromium') {\n    // DOM, not a computed tree (other engines have no DevTools access to theirs): an <input type=\"range\">\n    // has the implicit role slider, it is exposed unless hidden or aria-hidden, and its value and bounds are\n    // the element's own.\n    const dom = await page.locator(proxy).evaluate(el => {\n      const input = el as HTMLInputElement;\n      const role = el.getAttribute('role') ?? (input.type === 'range' ? 'slider' : input.type === 'text' ? 'textbox' : input.type);\n      const ignored = !!el.closest('[aria-hidden=\"true\"], [hidden], [inert]') || getComputedStyle(el).display === 'none';\n      return { role, ignored, value: Number(input.value), max: Number(input.max) };\n    });\n    return { focused, ...dom, text: (await page.locator(proxy).getAttribute('aria-valuetext')) ?? '' };\n  }\n  const ax = await axOf(page, proxy);\n  return {\n    focused, role: ax.role, ignored: ax.ignored, value: Number(ax.value), max: Number(ax.props.valuemax),\n    text: (await page.locator(proxy).getAttribute('aria-valuetext')) ?? '',\n  };\n}\n\n/**\n * The value text of the plot's range, after checking that the range has focus and that Chrome exposes it\n * as a slider: a stale proxy that lost focus cannot stand in for what the reader is on. `{ focused: false }`\n * reads it without focus (after a legend click, say), and says so at the call.\n */\nexport async function valueText(page: Page, selector = '#chart', options: { focused?: boolean } = {}): Promise<string> {\n  const r = await readRange(page, selector);\n  if (options.focused !== false && !r.focused) throw new Error(`the plot's range does not have focus (text: \"${r.text}\")`);\n  if (r.ignored || r.role !== 'slider') throw new Error(`the plot's range is exposed as \"${r.role}\"${r.ignored ? ' (ignored)' : ''}, not a slider`);\n  return r.text;\n}\n\n// ── focus and tab order ────────────────────────────────────────────────────────────────────────────\n\n/** What has focus: 'proxy', 'toolbar:<label>', 'table', 'before', 'after', 'body' or tag.class. */\nexport async function focused(page: Page): Promise<string> {\n  return page.evaluate(() => {\n    const el = document.activeElement as HTMLElement | null;\n    if (!el || el === document.body) return 'body';\n    if (el.id === 'before' || el.id === 'after') return el.id;\n    if (el.classList.contains('axylo-proxy')) return 'proxy';\n    if (el.closest('.axylo-toolbar')) return 'toolbar:' + (el.textContent ?? '');\n    if (el.classList.contains('axylo-table-scroll')) return 'table';\n    return el.tagName.toLowerCase() + '.' + el.className;\n  });\n}\n\n/** Presses Tab (or Shift+Tab) from #before (or #after) until focus leaves the chart; lists every stop. */\nexport async function tabStops(page: Page, backwards = false): Promise<string[]> {\n  await page.focus(backwards ? '#after' : '#before');\n  const stops: string[] = [];\n  for (let i = 0; i < 16; i++) {\n    await page.keyboard.press(backwards ? 'Shift+Tab' : 'Tab');\n    const at = await focused(page);\n    stops.push(at);\n    if (at === 'before' || at === 'after' || at === 'body') break;\n  }\n  return stops;\n}\n\n// ── geometry ───────────────────────────────────────────────────────────────────────────────────────\n\nexport interface Box { x: number; y: number; width: number; height: number }\n\nexport async function box(page: Page, selector: string): Promise<Box> {\n  const b = await page.locator(selector).first().boundingBox();\n  if (!b) throw new Error(`no box for ${selector}`);\n  return b;\n}\n\n/**\n * A control's size as the engine lays it out: its own getBoundingClientRect() in the page, in CSS px, the\n * quantity spec I4 names. Not Playwright's boundingBox(): in Playwright's Firefox that returns 23.99999237\n * for an element whose own rectangle is exactly 24 (its quads lose precision), so a size check would fail\n * on the tool. No tolerance is added: 23.99 laid out in the page still fails.\n */\nexport async function cssSize(element: Locator): Promise<{ width: number; height: number }> {\n  return element.evaluate(e => { const r = e.getBoundingClientRect(); return { width: r.width, height: r.height }; });\n}\n\n/** The plot area in viewport px (the keyboard proxy covers exactly it) and the drawn domains (dev only). */\nexport async function plotGeometry(page: Page, index = 0, selector = '#chart'): Promise<{ plot: Box; xDomain: number[] | null; yDomain: number[] | null }> {\n  return page.evaluate(({ index, selector }) => {\n    const r = document.querySelector(`${selector} .axylo-proxy`)!.getBoundingClientRect();\n    const charts = (window as unknown as { charts: { __bench: { describe(): { xDomain: number[] | null; yDomain: number[] | null } } }[] }).charts;\n    const { xDomain, yDomain } = charts[index]!.__bench.describe();\n    return { plot: { x: r.x, y: r.y, width: r.width, height: r.height }, xDomain, yDomain };\n  }, { index, selector });\n}\n\nexport const intersects = (a: Box, b: Box, slack = 0): boolean =>\n  a.x < b.x + b.width - slack && b.x < a.x + a.width - slack && a.y < b.y + b.height - slack && b.y < a.y + a.height - slack;\n\nexport const inside = (inner: Box, outer: Box, slack = 1): boolean =>\n  inner.x >= outer.x - slack && inner.y >= outer.y - slack && inner.x + inner.width <= outer.x + outer.width + slack && inner.y + inner.height <= outer.y + outer.height + slack;\n\n// ── pixels and colour ──────────────────────────────────────────────────────────────────────────────\n\n/**\n * A screenshot of `selector`'s box as painted. Animations are left running (Playwright's default), so a\n * transition the library starts is captured as it is, never fast-forwarded to its end.\n */\nexport async function screenshot(page: Page, selector: string, clip?: Box): Promise<{ img: Image; box: Box; scale: number }> {\n  const b = clip ?? await box(page, selector);\n  const img = decodePng(await page.screenshot({ clip: b, animations: 'allow', caret: 'hide' }));\n  return { img, box: b, scale: img.width / b.width };\n}\n\nexport type RGB = readonly [number, number, number];\n\n/** Resolves any CSS colour the page understands to sRGB bytes, in the page. */\nexport async function resolveColors(page: Page, colors: readonly string[]): Promise<RGB[]> {\n  return page.evaluate(colors => colors.map(c => {\n    const ctx = document.createElement('canvas').getContext('2d')!;\n    ctx.fillStyle = '#000';\n    ctx.fillStyle = c;\n    ctx.fillRect(0, 0, 1, 1);\n    const d = ctx.getImageData(0, 0, 1, 1).data;\n    return [d[0]!, d[1]!, d[2]!] as const;\n  }), colors as string[]) as Promise<RGB[]>;\n}\n\n/** WCAG 2.x relative luminance and contrast. */\nexport function luminance([r, g, b]: RGB): number {\n  const f = (v: number) => { const s = v / 255; return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4; };\n  return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);\n}\nexport function contrast(a: RGB, b: RGB): number {\n  const [x, y] = [luminance(a), luminance(b)];\n  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);\n}\n\n/** The colour the marks are painted with, resolved in the page from the rendered SVG element's `color`. */\nexport async function seriesColors(page: Page, selector = '#chart'): Promise<RGB[]> {\n  const css = await page.evaluate(selector => {\n    const seen = new Map<number, string>();\n    for (const el of document.querySelectorAll<SVGElement>(`${selector} svg.axylo-svg .axylo-scene *`)) {\n      const m = /--axylo-series-color-(\\d+)/.exec(el.style.getPropertyValue('color'));\n      if (m && !seen.has(Number(m[1]))) seen.set(Number(m[1]), getComputedStyle(el).color);\n    }\n    return [...seen.entries()].sort((a, b) => a[0] - b[0]).map(e => e[1]);\n  }, selector);\n  return resolveColors(page, css);\n}\n\n/**\n * The colour painted behind the marks: the chart's own background rect when it is opaque (an author's\n * `--axylo-background`), else the nearest ancestor background, else the canvas white.\n */\nexport async function backgroundColor(page: Page, selector = '#chart'): Promise<RGB> {\n  const css = await page.evaluate(selector => {\n    const opaque = (c: string) => !!c && c !== 'transparent' && !/rgba\\(.*,\\s*0\\)$/.test(c);\n    const rect = document.querySelector(`${selector} svg.axylo-svg .axylo-background`) as SVGElement | null;\n    if (rect) {\n      // The background rect is painted through `color` and currentColor, like every mark (render/svg.ts).\n      const s = getComputedStyle(rect);\n      if (opaque(s.color)) return s.color;\n    }\n    let el: Element | null = document.querySelector(selector);\n    while (el) {\n      const c = getComputedStyle(el).backgroundColor;\n      if (opaque(c)) return c;\n      el = el.parentElement;\n    }\n    return 'rgb(255, 255, 255)';\n  }, selector);\n  return (await resolveColors(page, [css]))[0]!;\n}\n\n/**\n * The default background of the scheme the chart resolved: `--axylo-default-background` as the marks\n * inherit it (read on the mark layer, wherever the library puts the scheme switch).\n */\nexport async function defaultBackground(page: Page, selector = '#chart'): Promise<RGB> {\n  const css = await page.evaluate(selector => {\n    const at = document.querySelector(`${selector} figure`) ?? document.querySelector(selector)!;\n    // Resolved in place (the token may be a light-dark() pair that depends on the chart's scheme).\n    const probe = document.createElement('div');\n    probe.style.background = 'var(--axylo-default-background)';\n    at.appendChild(probe);\n    const c = getComputedStyle(probe).backgroundColor;\n    probe.remove();\n    return c;\n  }, selector);\n  return (await resolveColors(page, [css]))[0]!;\n}\n\nexport function pixel(img: Image, x: number, y: number): RGB {\n  const o = (Math.floor(y) * img.width + Math.floor(x)) * 4;\n  return [img.data[o]!, img.data[o + 1]!, img.data[o + 2]!];\n}\n\nexport const distance = (a: RGB, b: RGB): number => Math.max(Math.abs(a[0] - b[0]), Math.abs(a[1] - b[1]), Math.abs(a[2] - b[2]));\n\n/** Pixels within `tolerance` of `color` in a region of `img`. */\nexport function countColor(img: Image, color: RGB, tolerance = 30, region?: { x0: number; y0: number; x1: number; y1: number }): number {\n  const { x0 = 0, y0 = 0, x1 = img.width, y1 = img.height } = region ?? {};\n  let n = 0;\n  for (let y = Math.max(0, Math.floor(y0)); y < Math.min(img.height, y1); y++) {\n    for (let x = Math.max(0, Math.floor(x0)); x < Math.min(img.width, x1); x++) if (distance(pixel(img, x, y), color) <= tolerance) n++;\n  }\n  return n;\n}\n\n// ── marks as drawn (SVG renderer), to locate a datum on screen ─────────────────────────────────────\n\nexport interface Shape {\n  /** Viewport box of one closed subpath or rect. */\n  box: Box;\n  /** The command letters of the subpath (\"MAAZ\" for a circle, \"MLLLZ\" for a square). */\n  commands: string;\n  /** The subpath's own path data ('rect' for a rect), for `signature`. */\n  sub: string;\n}\n\n/**\n * A shape's identity independent of size and position: its commands and its vertices scaled to the larger\n * side of its box, rounded. A circle, a square, a diamond and a triangle each give a different signature.\n */\nexport function signature(sub: string): string {\n  if (sub === 'rect') return 'rect';\n  // Arcs: a round marker, whatever points its path happens to pass through.\n  if (/A/i.test(sub)) return 'round';\n  const tokens = sub.match(/[MLAZHV]|-?\\d*\\.?\\d+(?:e-?\\d+)?/gi) ?? [];\n  const pts: [number, number][] = [];\n  let cmds = '';\n  let cmd = '';\n  for (let i = 0; i < tokens.length;) {\n    const t = tokens[i]!;\n    if (/^[A-Za-z]$/.test(t)) { cmd = t.toUpperCase(); cmds += cmd; i++; continue; }\n    if (cmd === 'A') { pts.push([Number(tokens[i + 5]), Number(tokens[i + 6])]); i += 7; }\n    else if (cmd === 'M' || cmd === 'L') { pts.push([Number(tokens[i]), Number(tokens[i + 1])]); i += 2; }\n    else i++;\n  }\n  const x0 = Math.min(...pts.map(p => p[0])), y0 = Math.min(...pts.map(p => p[1]));\n  const size = Math.max(Math.max(...pts.map(p => p[0])) - x0, Math.max(...pts.map(p => p[1])) - y0) || 1;\n  // Sorted and unique, so where a shape's path starts does not matter.\n  const vertices = [...new Set(pts.map(([x, y]) => `${Math.round(4 * (x - x0) / size)},${Math.round(4 * (y - y0) / size)}`))].sort();\n  return cmds.replace(/Z/g, '').replace(/L+/g, 'L').replace(/A+/g, 'A') + ':' + vertices.join(' ');\n}\n\n/**\n * Per series colour slot (1-based, from `--axylo-series-color-N`), the small closed shapes drawn in that\n * colour: markers on lines and areas, scatter points, bar rects. Shapes larger than `maxSize` px (an area's\n * fill, a line's stroke) are left out.\n */\nexport async function shapes(page: Page, selector = '#chart', maxSize = 20): Promise<Record<number, Shape[]>> {\n  return page.evaluate(({ selector, maxSize }) => {\n    const svg = document.querySelector(`${selector} svg.axylo-svg`) as SVGSVGElement | null;\n    const out: Record<number, { box: { x: number; y: number; width: number; height: number }; commands: string; sub: string }[]> = {};\n    if (!svg) return out;\n    const origin = svg.getBoundingClientRect();\n    const matrix = svg.getScreenCTM();\n    const toPage = (x: number, y: number) => {\n      if (!matrix) return { x: origin.x + x, y: origin.y + y };\n      const p = new DOMPoint(x, y).matrixTransform(matrix);\n      return { x: p.x, y: p.y };\n    };\n    const slotOf = (el: Element | null): number | null => {\n      for (let e = el; e && e !== svg; e = e.parentElement) {\n        const m = /--axylo-series-color-(\\d+)/.exec((e as SVGElement).style?.getPropertyValue('color') ?? '');\n        if (m) return Number(m[1]);\n      }\n      return null;\n    };\n    for (const el of svg.querySelectorAll('.axylo-scene path, .axylo-scene rect')) {\n      const slot = slotOf(el);\n      if (slot === null) continue;\n      const list = (out[slot] ??= []);\n      if (el.tagName.toLowerCase() === 'rect') {\n        const r = el as SVGRectElement;\n        const a = toPage(r.x.baseVal.value, r.y.baseVal.value);\n        const b = toPage(r.x.baseVal.value + r.width.baseVal.value, r.y.baseVal.value + r.height.baseVal.value);\n        const rb = { x: a.x, y: a.y, width: b.x - a.x, height: b.y - a.y };\n        // A patterned bar is drawn twice (colour, then pattern on top): one mark.\n        if (!list.some(o => o.sub === 'rect' && Math.abs(o.box.x - rb.x) < 0.01 && Math.abs(o.box.y - rb.y) < 0.01 && Math.abs(o.box.width - rb.width) < 0.01 && Math.abs(o.box.height - rb.height) < 0.01)) list.push({ box: rb, commands: 'rect', sub: 'rect' });\n        continue;\n      }\n      const d = el.getAttribute('d') ?? '';\n      for (const sub of d.split(/(?=M)/)) {\n        const tokens = sub.match(/[MLAZHV]|-?\\d*\\.?\\d+(?:e-?\\d+)?/gi) ?? [];\n        let commands = '';\n        const xs: number[] = [];\n        const ys: number[] = [];\n        let cmd = '';\n        for (let i = 0; i < tokens.length;) {\n          const t = tokens[i]!;\n          if (/^[A-Za-z]$/.test(t)) { cmd = t.toUpperCase(); commands += cmd; i++; if (cmd === 'Z') continue; }\n          if (cmd === 'A') { xs.push(Number(tokens[i + 5])); ys.push(Number(tokens[i + 6])); i += 7; }\n          else if (cmd === 'M' || cmd === 'L') { xs.push(Number(tokens[i])); ys.push(Number(tokens[i + 1])); i += 2; }\n          else i++;\n        }\n        if (!xs.length) continue;\n        const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);\n        const a = toPage(x0, y0);\n        const b = toPage(x1, y1);\n        const w = b.x - a.x, h = b.y - a.y;\n        if (w > maxSize || h > maxSize) continue;\n        // A circle's subpath records only the two ends of a horizontal diameter: widen it to the disc.\n        const round = commands.includes('A') && h < w / 2;\n        list.push({ box: round ? { x: a.x, y: a.y - w / 2, width: w, height: w } : { x: a.x, y: a.y, width: w, height: h }, commands, sub });\n      }\n    }\n    return out;\n  }, { selector, maxSize });\n}\n\nexport const center = (b: Box): {