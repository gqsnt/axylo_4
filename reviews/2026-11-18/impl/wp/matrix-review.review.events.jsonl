543\t      if (b.width < 1 || b.height < 1) continue;\n   544\t      const a = new DOMPoint(b.x, b.y).matrixTransform(m), c = new DOMPoint(b.x + b.width, b.y + b.height).matrixTransform(m);\n   545\t      x0 = Math.min(x0, a.x); y0 = Math.min(y0, a.y); x1 = Math.max(x1, c.x); y1 = Math.max(y1, c.y);\n   546\t    }\n   547\t    return { cx: (x0 + x1) / 2, cy: (y0 + y1) / 2, outer: (x1 - x0) / 2 };\n   548\t  }, selector);\n   549\t}\n   550\t\n   551\t\n   552\t// ── painted colour ─────────────────────────────────────────────────────────────────────────────────\n   553\t\n   554\t/** The most frequent colour of the image pixels in a region (image px): the backdrop of a mostly empty area. */\n   555\texport function modeColor(img: Image, region: { x0: number; y0: number; x1: number; y1: number }): { color: RGB; share: number; pixels: number } {\n   556\t  const counts = new Map<number, number>();\n   557\t  let n = 0;\n   558\t  for (let y = Math.max(0, Math.floor(region.y0)); y < Math.min(img.height, Math.ceil(region.y1)); y++) {\n   559\t    for (let x = Math.max(0, Math.floor(region.x0)); x < Math.min(img.width, Math.ceil(region.x1)); x++) {\n   560\t      const [r, g, b] = pixel(img, x, y);\n   561\t      const key = (r << 16) | (g << 8) | b;\n   562\t      counts.set(key, (counts.get(key) ?? 0) + 1);\n   563\t      n++;\n   564\t    }\n   565\t  }\n   566\t  let best = 0, count = 0;\n   567\t  for (const [k, c] of counts) if (c > count) { best = k; count = c; }\n   568\t  return { color: [(best >> 16) & 255, (best >> 8) & 255, best & 255], share: n ? count / n : 0, pixels: n };\n   569\t}\n   570\t\n   571\t/**\n   572\t * The colour painted inside a mark: the most frequent colour of its interior (viewport box, inset by `inset`\n   573\t * CSS px so anti-aliased edges are left out). `share` says how uniform the interior is.\n   574\t */\n   575\texport function interiorColor(img: Image, view: Box, mark: Box, inset = 1): { color: RGB; share: number; pixels: number } {\n   576\t  const s = img.width / view.width;\n   577\t  return modeColor(img, { x0: (mark.x - view.x + inset) * s, y0: (mark.y - view.y + inset) * s, x1: (mark.x + mark.width - view.x - inset) * s, y1: (mark.y + mark.height - view.y - inset) * s });\n   578\t}\n   579\t\n   580\t// ── table comparison ─────────────────────────────────────────────────────────────────────────────────\n   581\t\n   582\texport interface TableRead { name: string; headers: string[]; rows: { header: string; cells: string[] }[] }\n   583\t\n   584\t/**\n   585\t * Differences between a table as read and the expected one: the column headers in order (each header must\n   586\t * contain its fragments in order, so a label and its unit stay together), then every row as its row header\n   587\t * followed by its cells, exactly and in order. Swapping two cells, or two headers, is a difference.\n   588\t */\n   589\texport function compareTable(actual: TableRead, expected: { headers: string[][]; rows: string[][] }): string[] {\n   590\t  const out: string[] = [];\n   591\t  if (actual.headers.length !== expected.headers.length) out.push(`headers: ${JSON.stringify(actual.headers)} has ${actual.headers.length}, expected ${expected.headers.length}`);\n   592\t  expected.headers.forEach((frag, i) => {\n   593\t    const h = actual.headers[i] ?? '';\n   594\t    let at = 0;\n   595\t    for (const f of frag) { const k = h.indexOf(f, at); if (k < 0) { out.push(`header ${i + 1} \"${h}\" lacks ${JSON.stringify(frag)}`); break; } at = k + f.length; }\n   596\t  });\n   597\t  if (actual.rows.length !== expected.rows.length) out.push(`rows: ${actual.rows.length}, expected ${expected.rows.length}`);\n   598\t  expected.rows.forEach((row, i) => {\n   599\t    const a = actual.rows[i];\n   600\t    const got = a ? [a.header, ...a.cells] : [];\n   601\t    if (JSON.stringify(got) !== JSON.stringify(row)) out.push(`row ${i + 1}: ${JSON.stringify(got)} expected ${JSON.stringify(row)}`);\n   602\t  });\n   603\t  return out;\n   604\t}\n   605\t\n   606\t/** The table inside `selector` as Chrome exposes it: its name (the caption), column headers, and rows. */\n   607\texport async function readTable(page: Page, selector = '#chart'): Promise<TableRead> {\n   608\t  if (ENGINE !== 'chromium') {\n   609\t    // DOM: the HTML table's own caption, header and body cells (another engine's computed table roles are\n   610\t    // not reachable; the table's content is what A4 compares).\n   611\t    return page.evaluate(sel => {\n   612\t      const t = document.querySelector(`${sel} table`);\n   613\t      if (!t) return { name: '', headers: [], rows: [] };\n   614\t      return {\n   615\t        name: t.querySelector('caption')?.textContent ?? '',\n   616\t        headers: [...t.querySelectorAll('thead th')].map(h => h.textContent ?? ''),\n   617\t        rows: [...t.querySelectorAll('tbody tr')].map(r => ({ header: r.querySelector('th')?.textContent ?? '', cells: [...r.querySelectorAll('td')].map(c => c.textContent ?? '') })),\n   618\t      };\n   619\t    }, selector);\n   620\t  }\n   621\t  const all = await axWithin(page, `${selector} table`).catch(() => [] as AX[]);\n   622\t  const table = all.find(n => n.role === 'table');\n   623\t  if (!table) return { name: '', headers: [], rows: [] };\n   624\t  const byId = new Map(all.map(n => [n.id, n]));\n   625\t  const kids = (n: AX): AX[] => n.children.map(c => byId.get(c)).filter((c): c is AX => !!c).flatMap(c => c.role === 'rowgroup' || c.role === 'generic' ? kids(c) : [c]);\n   626\t  const headers: string[] = [];\n   627\t  const rows: { header: string; cells: string[] }[] = [];\n   628\t  for (const row of all.filter(n => n.role === 'row')) {\n   629\t    const cells = kids(row);\n   630\t    const head = cells.filter(c => c.role === 'columnheader');\n   631\t    if (head.length) { headers.push(...head.map(c => c.name)); continue; }\n   632\t    rows.push({ header: cells.find(c => c.role === 'rowheader')?.name ?? '