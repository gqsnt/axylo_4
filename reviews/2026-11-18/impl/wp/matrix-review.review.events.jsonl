  199\t// ── a dense series' spike in its own column ─────────────────────────────────────────────────────────\n   200\t\n   201\t/** The stroked line vertices of colour slot `slot`, in viewport px, and where the pen lifts between runs. */\n   202\texport async function strokeRuns(page: Page, slot = 1, selector = '#chart'): Promise<{ x: number; y: number }[][]> {\n   203\t  return page.evaluate(({ slot, selector }) => {\n   204\t    const svg = document.querySelector(`${selector} svg.axylo-svg`) as SVGSVGElement;\n   205\t    const m = svg.getScreenCTM()!;\n   206\t    const runs: { x: number; y: number }[][] = [];\n   207\t    for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) {\n   208\t      if (!new RegExp(`--axylo-series-color-${slot}\\\\b`).test(el.style.getPropertyValue('color')) || el.style.getPropertyValue('stroke') !== 'currentcolor') continue;\n   209\t      for (const sub of (el.getAttribute('d') ?? '').split(/(?=M)/)) {\n   210\t        const nums = sub.match(/-?\\d*\\.?\\d+/g)?.map(Number) ?? [];\n   211\t        const run: { x: number; y: number }[] = [];\n   212\t        for (let i = 0; i + 1 < nums.length; i += 2) { const p = new DOMPoint(nums[i]!, nums[i + 1]!).matrixTransform(m); run.push({ x: p.x, y: p.y }); }\n   213\t        if (run.length) runs.push(run);\n   214\t      }\n   215\t    }\n   216\t    return runs;\n   217\t  }, { slot, selector });\n   218\t}\n   219\t\n   220\t/**\n     1\t/**\n     2\t * Author text for the text-insertion tests (spec DX8: labels and formatter output are inserted as text, never\n     3\t * as HTML). Each text source on each chart type gets its own sentinel: inert markup (`<u data-axs=\"id\">…</u>`)\n     4\t * that would become a `u` element carrying `data-axs` if anything parsed it, and whose literal text names its\n     5\t * source, so one surface cannot vouch for another.\n     6\t */\n     7\texport const S = (id: string, body: string = id): string => `<u data-axs=\"${id}\">${body}</u>`;\n     8\t\n     9\texport type Kind = 'line' | 'area' | 'bar' | 'scatter' | 'donut';\n    10\texport const KINDS: Kind[] = ['line', 'area', 'bar', 'scatter', 'donut'];\n    11\t\n    12\t/** The sources each chart type takes, by name; the value is the sentinel id. Formatters wrap the value. */\n    13\texport const SOURCES: Record<Kind, Record<string, string>> = {\n    14\t  line: { title: 'l-title', subtitle: 'l-sub', description: 'l-desc', series: 'l-ser', xLabel: 'l-xl', yLabel: 'l-yl', unit: 'l-u', xFormat: 'l-xf', yFormat: 'l-yf', yTick: 'l-yt' },\n    15\t  area: { title: 'a-title', subtitle: 'a-sub', description: 'a-desc', series: 'a-ser', xLabel: 'a-xl', yLabel: 'a-yl', unit: 'a-u', xFormat: 'a-xf', yFormat: 'a-yf', yTick: 'a-yt' },\n    16\t  bar: { title: 'b-title', subtitle: 'b-sub', description: 'b-desc', series: 'b-ser', category: 'b-cat', xLabel: 'b-xl', yLabel: 'b-yl', unit: 'b-u', yFormat: 'b-yf', yTick: 'b-yt' },\n    17\t  scatter: { title: 's-title', subtitle: 's-sub', description: 's-desc', series: 's-ser', xLabel: 's-xl', yLabel: 's-yl', unit: 's-u', xFormat: 's-xf', yFormat: 's-yf', xTick: 's-xt', yTick: 's-yt' },\n    18\t  donut: { title: 'd-title', subtitle: 'd-sub', description: 'd-desc', category: 'd-cat', yLabel: 'd-yl', unit: 'd-u', yFormat: 'd-yf' },\n    19\t};\n    20\t\n    21\ttype Make = (target: string, options: Record<string, unknown>) => unknown;\n    22\texport type Library = Record<Kind, Make>;\n    23\t\n    24\tconst days = ['2026-03-02', '2026-03-03', '2026-03-04', '2026-03-05', '2026-03-06'];\n    25\t\n    26\t/** The scatter's x for row `i` (why these values: see the scatter case of optionsFor). */\n    27\texport const scatterSize = (i: number): number => Math.round((100 * i) / 11);\n    28\t\n    29\t/** The options for one chart type, every source filled with its sentinel. */\n    30\texport function optionsFor(kind: Kind, extra: Record<string, unknown> = {}): Record<string, unknown> {\n    31\t  const s = SOURCES[kind];\n    32\t  const id = (k: string) => s[k]!;\n    33\t  const common = { title: S(id('title')), subtitle: S(id('subtitle')), description: S(id('description')) };\n    34\t  const y = (field: string) => ({\n    35\t    field, label: S(id('yLabel')), unit: S(id('unit')), format: (v: number) => S(id('yFormat'), String(v)),\n    36\t    ...(s.yTick ? { tickFormat: (v: number) => S(id('yTick'), String(v)) } : {}),\n    37\t  });\n    38\t  switch (kind) {\n    39\t    case 'line':\n    40\t    case 'area': {\n    41\t      const data = days.flatMap((day, i) => [S(id('series')), 'Plain'].map((channel, c) => ({ day, channel, visits: 100 + 10 * i + 50 * c })));\n    42\t      return { ...common, data, series: 'channel', x: { field: 'day', label: S(id('xLabel')), format: (v: unknown) => S(id('xFormat'), String(v instanceof Date ? v.toISOString().slice(0, 10) : v)) }, y: y('visits'), ...(kind === 'area' ? { stacked: true } : {}), ...extra };\n    43\t    }\n    44\t    case 'bar': {\n    45\t      const data = [S(id('category')), 'North', 'South'].flatMap((region, i) => [S(id('series')), 'Plain'].map((year, c) => ({ region, year, revenue: 300 + 40 * i + 25 * c })));\n    46\t      return { ...common, data, series: 'year', x: { field: 'region', label: S(id('xLabel')) }, y: y('revenue'), ...extra };\n    47\t    }\n    48\t    case 'scatter': {\n    49\t      // x runs from 0 to 100 exactly. An automatic numeric x domain ends on drawn ticks (spec F7), so the\n    50\t      // tick sets offered are those whose steps divide [0, 100]; the coarsest, step 50, gives three ticks\n    51\t      // (0, 50, 100). Each tick label is a whole sentinel of about 26 characters, and three of them fit side\n    52\t      // by side in the 760 px chart (page.css, .chart.tall), so L1's first remedy (thinning) is enough and\n    53\t      // no label is wrapped, rotated or truncated. The earlier range, 10 to 65, made the domain [0, 80] with\n    54\t      // steps 10 and 20 only: five or more labels 134 to 219 px apart, which L1 rotates and then truncates\n    55\t      // in the middle, cutting the sentinels this test reads whole (read in the built library, d33df71).\n    56\t      const data = Array.from({ length: 12 }, (_, i) => ({ size: scatterSize(i), latency: 40 + ((i * 7) % 11) * 3, kind: i % 2 ? S(id('series')) : 'Plain' }));\n    57\t      return {\n    58\t        ...common, data, series: 'kind',\n    59\t        x: { field: 'size', label: S(id('xLabel')), format: (v: unknown) => S(id('xFormat'), String(v)), tickFormat: (v: unknown) => S(id('xTick'), String(v)) },\n    60\t        y: y('latency'), ...extra,\n    61\t      };\n    62\t    }\n    63\t    case 'donut': {\n    64\t      const data = [{ browser: S(id('category')), share: 45 }, { browser: 'Firefox', share: 30 }, { browser: 'Safari', share: 25 }];\n    65\t      return { ...common, data, label: 'browser', value: { field: 'share', label: S(id('yLabel')), unit: S(id('unit')), format: (v: number) => S(id('yFormat'), String(v)) }, ...extra };\n    66\t    }\n    67\t  }\n    68\t}\n    69\t\n    70\texport function makeSentinelCharts(A: Library): void {\n    71\t  const w = window as unknown as Record<string, unknown>;\n    72\t  const charts: unknown[] = KINDS.map(kind => A[kind](`#${kind}`, optionsFor(kind)));\n    73\t  // The compact variant: its name and description are its only text (spec 3.7, C1).\n    74\t  charts.push(A.line('#compact', { title: S('c-title'), description: S('c-desc'), data: days.map((day, i) => ({ day, v: 3 + i })), x: 'day', y: 'v', compact: true }));\n    75\t  w.__charts = charts;\n    76\t}\n    77\t\n    78\t/** Every built-in message key (public Messages): each replaced by its own sentinel on the messages page. */\n    79\texport const MESSAGE_KEYS = [\n    80\t  'viewAsTable', 'hideTable', 'noData', 'noObservation', 'incompleteStack', 'moreRows', 'otherSlices', 'valuesNotShown', 'valuesChanged',\n    81\t  'labelsHidden', 'loading', 'empty', 'error', 'internalError', 'chartName', 'chartSummary', 'seriesSummary', 'referenceSummary',\n    82\t  'timeZoneNote', 'plotLabel', 'controlsLabel', 'pointOf', 'zoomIn', 'zoomOut', 'resetZoom', 'pause', 'resume', 'previousPage', 'nextPage',\n    83\t  'pageOf', 'jumpToX', 'showSeries', 'hideSeries', 'category', 'percentage', 'series', 'value', 'typeLine', 'typeArea', 'typeBar',\n    84\t  'typeScatter', 'typeDonut', 'donutSummary', 'seriesNoData', 'seriesNotDrawn', 'referenceLine', 'referenceBand', 'plotRole', 'pointAll',\n    85\t  'seriesValue', 'position', 'total', 'panLeft', 'panRight', 'jumpNotFound', 'plotInstructions', 'seeTable',\n    86\t] as const;\n    87\texport const messages = (): Record<string, string> => Object.fromEntries(MESSAGE_KEYS.map(k => [k, S(`m-${k}`)]));\n    88\t\n    89\t/** Mon–Sun with a NaN, a stray string and an absent value: the Phase 1 dirty fixture, so the reader note shows. */\n    90\tconst dirty = ['2026-03-02', '2026-03-03', '2026-03-04', '2026-03-05', '2026-03-06', '2026-03-07', '2026-03-08']\n    91\t  .map((day, i) => { const v = [10, 20, null, NaN, '40', undefined, 70][i]; return v === undefined ? { day } : { day, value: v }; });\n    92\t\n    93\t/** The charts of the messages page, by element id: each puts a different set of built-in strings on screen. */\n    94\texport const MESSAGE_CHARTS = ['line', 'area', 'bar', 'scatter', 'donut', 'untitled', 'loading', 'failed', 'nothing', 'many', 'slices', 'sparse', 'note'] as const;\n    95\t\n    96\texport function makeMessageCharts(A: Library): void {\n    97\t  const w = window as unknown as Record<string, unknown>;\n    98\t  const m = messages();\n    99\t  const hours = days.map((d, i) => ({ t: Date.parse(`${d}T12:00:00Z`), v: i % 2 ? 5 + i : null }));\n   100\t  const ten = Array.from({ length: 10 }, (_, s) => days.map((day, i) => ({ day, name: `S${s}`, v: s === 9 ? null : 10 + s + i }))).flat();\n   101\t  const charts: Record<string, unknown> = {\n   102\t    line: A.line('#line', { title: 'Dirty', data: dirty, x: 'day', y: 'value', messages: m }),\n   103\t    area: A.area('#area', optionsFor('area', { messages: m })),\n   104\t    bar: A.bar('#bar', optionsFor('bar', { messages: m })),\n   105\t    scatter: A.scatter('#scatter', optionsFor('scatter', { messages: m })),\n   106\t    donut: A.donut('#donut', optionsFor('donut', { messages: m })),\n   107\t    // No title (chartName), instants (timeZoneNote), references (line, band), absent values drawn as zero.\n   108\t    untitled: A.line('#untitled', {\n   109\t      data: hours, x: { field: 't', type: 'time', timeZone: 'UTC' }, y: { field: 'v', missing: 'zero' }, messages: m,\n   110\t      reference: [{ y: 8, label: 'Target' }, { y: [6, 7], label: 'Band' }],\n   111\t    }),\n   112\t    loading: A.line('#loading', { title: 'Loading', data: [], x: 'day', y: 'v', state: 'loading', messages: m }),\n   113\t    failed: A.line('#failed', { title: 'Failed', data: [], x: 'day', y: 'v', state: { error: S('src-error') }, messages: m }),\n   114\t    nothing: A.line('#nothing', { title: 'Nothing', data: [], x: 'day', y: 'v', messages: m }),\n   115\t    // Ten series, one of them all missing (seriesNoData; more rows than a tooltip lists).\n","exit_code":0,"status":"completed"}}
