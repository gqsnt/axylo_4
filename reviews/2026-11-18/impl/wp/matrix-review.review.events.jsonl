er\",\n          \"file\": \"packages/axylo/test/browser/acceptance/f2-gaps.browser.test.ts\",\n          \"title\": \"F2 area: on a regular date axis, explicit nulls and the same rows deleted render the same gap, and the deleted rows raise AX105\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/f2-gaps.browser.test.ts\",\n          \"title\": \"F2 area: with missing: 'zero' on the field, an explicit null and an absent step are drawn at zero, on the zero baseline\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/f2-gaps.browser.test.ts\",\n          \"title\": \"F2 area: the tooltip, the table and the keyboard read \\\"No data\\\" at the missing value, and the zero next to it as 0\"\n        }\n      ],\n      \"bar\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 bar: bar distinguishes null, absent field, absent date and zero in geometry and reader text\",\n          \"registration\": \"F2 ${type}: ${kind} distinguishes null, absent field, absent date and zero in geometry and reader text\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 bar: bar missing zero makes the requested count gaps ordinary zero values\",\n          \"registration\": \"F2 ${type}: ${kind} missing zero makes the requested count gaps ordinary zero values\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 bar: horizontal missing marks sit at zero and real zero is a zero-width bar\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/f2-gaps.browser.test.ts\",\n          \"title\": \"F2 bar: a missing bar shows a \\\"no data\\\" mark at the baseline, distinct from a zero bar and from an empty band\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/f2-gaps.browser.test.ts\",\n          \"title\": \"F2 bar: with missing: 'zero' on the field, an explicit null and an absent step are drawn at zero, on the zero baseline\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/f2-gaps.browser.test.ts\",\n          \"title\": \"F2 bar: the tooltip, the table and the keyboard read \\\"No data\\\" at the missing value, and the zero next to it as 0\"\n        }\n      ],\n      \"scatter\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 scatter: gaps are unplotted, zero is readable and the table says No data (reading: the table keeps omitted observations)\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 scatter: missing zero draws two imputed zero points and exposes all four observations\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 scatter: appending unplottable values retains their table rows and missing zero only imputes missing values\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/f2-gaps.browser.test.ts\",\n          \"title\": \"F2 scatter: a point with a missing y is not drawn (never at zero): the two drawn points are the ones at (1, 5) and (3, 7); the table lists the missing row as \\\"No data\\\"; the keyboard skips it\"\n        }\n      ],\n      \"donut\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 donut: null and absent slices have no arc and read No data; a real zero reads 0\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 donut: missing zero makes null and absent counts readable as zero without drawing their arcs\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/f2-gaps.browser.test.ts\",\n          \"title\": \"F2 donut: a null slice is not drawn (A fills three quarters from 12 o'clock, C the last quarter) and the table reads \\\"No data\\\" for it\"\n        }\n      ],\n      \"compact\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 compact: line distinguishes null, absent field, absent date and zero in geometry and reader text\",\n          \"registration\": \"F2 ${type}: ${kind} distinguishes null, absent field, absent date and zero in geometry and reader text\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 compact: area distinguishes null, absent field, absent date and zero in geometry and reader text\",\n          \"registration\": \"F2 ${type}: ${kind} distinguishes null, absent field, absent date and zero in geometry and reader text\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/f-missing-values.test.ts\",\n          \"title\": \"F2 compact: bar distinguishes null, absent field, absent date and zero in geometry and reader text\",\n          \"registration\": \"F2 ${type}: ${kind} distinguishes null, absent field, absent date and zero in geometry and reader t