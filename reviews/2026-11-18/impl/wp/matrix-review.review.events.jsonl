{"type":"item.completed","item":{"id":"item_127","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:.github/workflows/ci.yml'","aggregated_output":"# Not yet run: the repository has no remote. Written against the commands that\n# pass locally on Linux with system Chrome; Windows and macOS results are\n# unknown until this runs there.\nname: ci\n\non:\n  push:\n    branches: [main]\n  pull_request:\n\npermissions:\n  contents: read\n\njobs:\n  check:\n    strategy:\n      fail-fast: false\n      matrix:\n        os: [ubuntu-latest, windows-latest, macos-latest]\n    runs-on: ${{ matrix.os }}\n    timeout-minutes: 20\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: 24\n          cache: npm\n      - run: npm ci\n      - run: npm run typecheck\n      # Build first: the React adapter's distribution test needs the core's declarations.\n      - run: npm run build\n      - run: npm test\n      # The browser tests launch the runner's installed Chrome\n      # (playwright-core, channel \"chrome\"); no browser download.\n      # Called directly, not through the npm script: that script sets the\n      # variable with POSIX syntax, which npm on Windows runs through cmd.exe.\n      - run: npx vitest run\n        env:\n          AXYLO_BROWSER: 1\n      # The packed tarballs, unpacked into clean fixtures.\n      - run: npx vitest run --config tests/dist/vitest.config.ts\n      - run: npx vitest run --config tests/dist/vitest.config.ts\n        env:\n          AXYLO_BROWSER: 1\n      # Reports sizes of the packed files. Add \"-- --check\" once the size targets gate CI.\n      - run: npm run size\n      - run: node --test bench/test/*.test.mjs\n        shell: bash\n      - run: node --test --test-concurrency=1 bench/test/browser/*.test.mjs\n        shell: bash\n      - run: node --test acceptance/test/*.test.mjs\n        shell: bash\n      - run: node acceptance/check.mjs\n","exit_code":0,"status":"completed"}}
