ts\": {\n      \"bar\": \"Browser evidence: system Chrome, SVG renderer (the default); no Firefox or WebKit result is recorded yet. Two-series grouped fixture, vertical and horizontal; a series hidden from the legend is left out, as I1 asks (every visible series).\"\n    }\n  },\n  {\n    \"id\": \"T-tooltip-donut\",\n    \"statement\": \"Tooltip content · Label, value, percentage\",\n    \"appliesTo\": [\n      \"donut\"\n    ],\n    \"notApplicable\": {\n      \"line\": \"This is the donut cell of section 3.6.\",\n      \"area\": \"This is the donut cell of section 3.6.\",\n      \"bar\": \"This is the donut cell of section 3.6.\",\n      \"scatter\": \"This is the donut cell of section 3.6.\",\n      \"compact\": \"Section 3.7: a compact chart has no tooltip.\"\n    },\n    \"evidence\": {\n      \"donut\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/type-matrix.test.ts\",\n          \"title\": \"T-tooltip-donut donut: tooltip gives slice label, value and percentage independently\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/type-matrix.browser.test.ts\",\n          \"title\": \"T-tooltip-donut: label, value and percentage of the slice under the pointer\"\n        }\n      ]\n    },\n    \"limits\": {\n      \"donut\": \"Browser evidence: system Chrome, SVG renderer (the default); no Firefox or WebKit result is recorded yet.\"\n    }\n  },\n  {\n    \"id\": \"T-tooltip-scatter\",\n    \"statement\": \"Tooltip content · The point's series, x and y; coincident points listed, up to eight\",\n    \"appliesTo\": [\n      \"scatter\"\n    ],\n    \"notApplicable\": {\n      \"line\": \"This is the scatter cell of section 3.6.\",\n      \"area\": \"This is the scatter cell of section 3.6.\",\n      \"bar\": \"This is the scatter cell of section 3.6.\",\n      \"donut\": \"This is the scatter cell of section 3.6.\",\n      \"compact\": \"Section 3.7: a compact chart has no tooltip.\"\n    },\n    \"evidence\": {\n      \"scatter\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/type-matrix.test.ts\",\n          \"title\": \"T-tooltip-scatter scatter: lists at most eight coincident points, reports the total and includes series, x and y\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/type-matrix.browser.test.ts\",\n          \"title\": \"T-tooltip-scatter: the point's series, x and y; ten coincident points list eight distinct series of the ten and \\\"+2 more\\\"\"\n        }\n      ]\n    },\n    \"weak\": {\n      \"scatter\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/lookup/scatter.test.ts\",\n          \"title\": \"finds coincident points across a cell boundary and retains the full count after truncation\",\n          \"reason\": \"Unit test of the scatter lookup: ten points within 0.2 px of each other, on both sides of a cell boundary of its index, are picked as one group that gives eight rows and a count of ten. Nothing is rendered.\"\n        }\n      ]\n    },\n    \"limits\": {\n      \"scatter\": \"Browser evidence: system Chrome, SVG renderer (the default); no Firefox or WebKit result is recorded yet. Ten coincident points of ten series; the browser checks eight distinct series and \\\"+2 more\\\".\"\n    }\n  },\n  {\n    \"id\": \"I2\",\n    \"statement\": \"Legend entries are toggle buttons with a pressed state, operable by click, Enter and Space.\",\n    \"appliesTo\": [\n      \"line\",\n      \"area\",\n      \"bar\",\n      \"scatter\"\n    ],\n    \"notApplicable\": {\n      \"donut\": \"A donut has one series, so there is no series to toggle. Its legend is the slice list of F8, whose entries are buttons that select a slice, with no pressed state, outside the tab order while the plot can be focused. The spec does not say whether I2 reaches that list; the notes raise it.\",\n      \"compact\": \"Section 3.7: a compact chart has no legend.\"\n    },\n    \"evidence\": {\n      \"line\": [\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts\",\n          \"title\": \"I2 line: legend entries are toggle buttons with a pressed state, operable by click, Enter and Space; after each, the marks follow\"\n        }\n      ],\n      \"area\": [\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts\",\n          \"title\": \"I2 area: legend entries are toggle buttons with a pressed state, operable by click, Enter and Space; after each, the marks follow\"\n        }\n      ],\n      \"bar\": [\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts\",\n          \"title\": \"I2 bar: legend entries are toggle buttons with a pressed state, operable by click, Enter and Space; after each, the marks follow\"\n        }\n      ],\n      \"scatter\": [\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts\",\n          \"title\": \"I2 scatter: legend entries are toggle buttons with a pressed state, operable by click, Enter and Space; after each, the marks follow\"\n        }\n      ]\n    },\n    \"limits\": {\n      \"line\": \"Browser evidence: system Chrome, SVG renderer (the default); no Firefox or WebKit result is recorded yet. The role and pressed state are read from Chrome's accessibility tree; a click, then Enter and Space on the focused entry, each toggle the first series and its marks are counted after each.\",\n      \"area\": \"Browser evidence: system Chrome, SVG renderer (the default); no Firefox or WebKit result is recorded yet. The role and pressed state are read from Chrome