onst TOOLBAR: Record<Full, string[]> = {\n    53\t  line: ['North', 'South', 'Zoom in', 'Select range', 'Zoom out', 'View as table'],\n    54\t  area: ['North', 'South', 'Zoom in', 'Select range', 'Zoom out', 'View as table'],\n    55\t  // Category x: no zoom (spec 3.6), so no range to select either.\n    56\t  bar: ['Plan', 'Actual', 'View as table'],\n    57\t  scatter: ['EU', 'US', 'Zoom in', 'Select range', 'Zoom out', 'View as table'],\n    58\t  // No legend toggles (the slice list is not a set of buttons) and no zoom (spec 3.6).\n    59\t  donut: ['View as table'],\n    60\t};\n    61\t\n    62\tasync function zoomIn(page: Page, type: Full): Promise<void> {\n    63\t  const range = type === 'scatter' ? [12, 30] : ['2026-03-03', '2026-03-05'];\n    64\t  await call(page, 'zoom', [range]);\n    65\t}\n    66\t\n    67\tdescribe('A2 tab stops', () => {\n    68\t  for (const type of FULL as Full[]) {\n    69\t    const states: [string, ((page: Page) => Promise<void>) | null][] = [\n    70\t      ['collapsed', async () => {}],\n    71\t      ['zoomed', type === 'line' || type === 'area' || type === 'scatter' ? page => zoomIn(page, type) : null],\n    72\t      ['streaming', async page => call(page, 'append', [MORE[type]])],\n    73\t    ];\n    74\t    for (const [state, enter] of states) {\n    75\t      if (!enter) continue;\n    76\t      it(`A2 ${type}: two tab stops with the table closed (${state}): the plot, then the toolbar; Shift+Tab reverses; Tab leaves the chart`, async () => {\n    77\t        const page = await devPage();\n    78\t        await create(page, type);\n    79\t        await enter(page);\n    80\t        const forwards = await tabStops(page);\n    81\t        expect(forwards).toHaveLength(3);\n    82\t        expect(forwards[0]).toBe('proxy');\n    83\t        expect(forwards[1]).toMatch(/^toolbar:/);\n    84\t        expect(forwards[2]).toBe('after');\n    85\t        const backwards = await tabStops(page, true);\n    86\t        expect(backwards[0]).toMatch(/^toolbar:/);\n    87\t        expect(backwards.slice(1)).toEqual(['proxy', 'before']);\n    88\t        if (state === 'streaming') expect(await page.locator('#chart [role=\"toolbar\"]').textContent()).toContain('Pause');\n    89\t        expect(await closePage(page)).toEqual([]);\n    90\t      });\n    91\t    }\n    92\t\n    93\t    it(`A2 ${type}: with the table open, Tab reaches the table's scroll region and the toolbar, and still leaves the chart both ways`, async () => {\n    94\t      const page = await devPage();\n    95\t      await create(page, type);\n    96\t      await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n    97\t      await settle(page);\n    98\t      const forwards = await tabStops(page);\n    99\t      expect(forwards).toContain('table');\n   100\t      expect(forwards.some(s => s.startsWith('toolbar:'))).toBe(true);\n   101\t      expect(forwards.at(-1)).toBe('after');\n   102\t      const backwards = await tabStops(page, true);\n   103\t      expect(backwards).toContain('table');\n   104\t      expect(backwards.at(-1)).toBe('before');\n   105\t      expect(await closePage(page)).toEqual([]);\n   106\t    });\n   107\t\n   108\t    it(`A2 ${type}: the toolbar holds ${TOOLBAR[type].join(', ')} with roving focus: one tab stop, arrows, Home and End move within it`, async () => {\n   109\t      const page = await devPage();\n   110\t      await create(page, type);\n   111\t      await page.focus('#before');\n   112\t      await page.keyboard.press('Tab');\n   113\t      await page.keyboard.press('Tab');\n   114\t      const label = () => page.evaluate(() => document.activeElement?.textContent ?? '');\n   115\t      const visited = [await label()];\n   116\t      for (let i = 1; i < TOOLBAR[type].length; i++) {\n   117\t        await page.keyboard.press('ArrowRight');\n   118\t        visited.push(await label());\n   119\t      }\n   120\t      expect(visited).toEqual(TOOLBAR[type]);\n   121\t      await page.keyboard.press('Home');\n   122\t      expect(await label()).toBe(TOOLBAR[type][0]);\n   123\t      await page.keyboard.press('End');\n   124\t      expect(await label()).toBe(TOOLBAR[type].at(-1));\n   125\t      expect(await page.locator('#chart [role=\"toolbar\"] [tabindex=\"0\"]').count()).toBe(1);\n   126\t      expect(await closePage(page)).toEqual([]);\n   127\t    });\n   128\t  }\n   129\t});\n   130\t\n   131\tdescribe('A2 and T-keyboard: every point in order, the ends, the series', () => {\n   132\t  for (const type of FULL as Full[]) {\n   133\t    const order = { line: 'by x, then series', area: 'by x, then series', bar: 'by category, then series', scatter: 'by x, then y', donut: 'by slice order' }[type];\n   134\t    it(`A2 ${type}: Right visits every datum ${order}, each read with its text; End and Home reach the ends; Tab leaves the chart`, async () => {\n   135\t      const page = await devPage();\n   136\t      await create(page, type);\n   137\t      await page.focus('#before');\n   138\t      await page.keyboard.press('Tab');\n   139\t      expect(await focused(page)).toBe('proxy');\n   140\t      const expected = walk(type);\n   141\t      const heard: string[] = [await valueText(page)];\n   142\t      for (let i = 1; i < expected.length; i++) {\n   143\t        await page.keyboard.press('ArrowRight');\n   144\t        heard.push(await valueText(page));\n   145\t      }\n   146\t      expected.forEach((group, i) => expect(inOrder(heard[i]!, group), `stop ${i + 1}: ${JSON.stringify(group)} in \"${heard[i]}\"`).toBe(true));\n   147\t      // Past the end Right stays on the last datum.\n   148\t      await page.keyboard.press('ArrowRight');\n   149\t      expect(inOrder(await valueText(page), expected.at(-1)!)).toBe(true);\n   150\t      await page.keyboard.press('Home');\n   151\t      expect(inOrder(await valueText(page), expected[0]!)).toBe(true);\n   152\t      await page.keyboard.press('End');\n   153\t      expect(inOrder(await valueText(page), expected.at(-1)!)).toBe(true);\n   154\t      await page.keyboard.press('Tab');\n   155\t      expect(await focused(page)).toMatch(/^toolbar:/);\n   156\t      await page.keyboard.press('Tab');\n   157\t      expect(await focused(page)).toBe('after');\n   158\t      expect(await closePage(page)).toEqual([]);\n   159\t    });\n   160\t  }\n   161\t\n   162\t  for (const type of ['line', 'area', 'bar'] as const) {\n   163\t    it(`A2 ${type}: Down narrows to the first series, Right stays in it, Down and Up switch series at the same ${type === 'bar' ? 'category' : 'x'}, Escape reads every series again`, async () => {\n   164\t      const page = await devPage();\n   165\t      await create(page, type);\n   166\t      const [first, second] = type === 'bar' ? SHIPPED.series : ENERGY.series;\n   167\t      const unit = type === 'bar' ? 't' : 'kWh';\n   168\t      const xs = type === 'bar' ? SHIPPED.quarters : ENERGY.days.map(calendar);\n   169\t      await page.focus('#chart .axylo-proxy');\n   170\t      await page.keyboard.press('ArrowDown');\n   171\t      let text = await valueText(page);\n   172\t      expect(inOrder(text, [first!.name, xs[0]!, withUnit(first!.values[0]!, unit)]), text).toBe(true);\n   250\t      const r = e.getBoundingClientRect(), w = parseFloat(getComputedStyle(e).strokeWidth) || 0;\n   251\t      const box = { x: r.x, y: r.y, width: r.width, height: r.height };\n   252\t      if (box.width < w) { box.x -= (w - box.width) / 2; box.width = w; }\n   253\t      if (box.height < w) { box.y -= (w - box.height) / 2; box.height = w; }\n   254\t      return { box, strokeWidth: w };\n   255\t    }));\n   256\t}\n   257\t\n   258\tdescribe('A2 focus indicator', () => {\n   259\t  for (const type of FULL as Full[]) {\n   260\t    it(`A2 ${type}: at every datum the keyboard reaches, the focus indicators (the plot's outline and the ring around the datum) are painted at least 2 px wide and 3:1 against their painted backdrop, and the tooltip covers neither them nor the focused datum (reading: no part of either indicator is covered)`, async () => {\n   261\t      const page = await devPage();\n   262\t      await create(page, type);\n   263\t      await page.focus('#before');\n   264\t      await page.keyboard.press('Tab');\n   265\t      expect((await readRange(page)).focused).toBe(true);\n   266\t      const outline = page.locator('#chart .axylo-focus-ring');\n   267\t      expect(await outline.isVisible()).toBe(true);\n   268\t      // Computed style: the outline's width (its painted pixels are checked below).\n   269\t      const width = await outline.evaluate(el => parseFloat(getComputedStyle(el).outlineWidth));\n   270\t      expect(width).toBeGreaterThanOrEqual(2);\n   271\t      const steps = walk(type).length;\n   272\t      const problems: string[] = [];\n   273\t      for (let i = 0; i < steps; i++) {\n   274\t        if (i > 0) await page.keyboard.press('ArrowRight');\n   275\t        await settle(page);\n   276\t        const range = await readRange(page);\n   277\t        if (!range.focused || range.role !== 'slider') problems.push(`datum ${i}: the range lost focus or role`);\n   278\t        const { img, box: view } = await screenshot(page, '#chart figure');\n   279\t        // The plot's outline: a strip on each side, inside its box (outline-offset is negative).\n   280\t        const o = await box(page, '#chart .axylo-focus-ring');\n   281\t        const strips: Box[] = [\n   282\t          { x: o.x + o.width * 0.4, y: o.y + 1, width: o.width * 0.2, height: 2 }, { x: o.x + o.width * 0.4, y: o.y + o.height - 3, width: o.width * 0.2, height: 2 },\n   283\t          { x: o.x + 1, y: o.y + o.height * 0.4, width: 2, height: o.height * 0.2 }, { x: o.x + o.width - 3, y: o.y + o.height * 0.4, width: 2, height: o.height * 0.2 },\n   284\t        ];\n   285\t        const rings = await datumRing(page);\n   286\t        if (!rings.length) problems.push(`datum ${i}: no ring around the focused datum`);\n   287\t        for (const r of rings) if (r.strokeWidth < 2) problems.push(`datum ${i}: datum ring ${r.strokeWidth} px wide`);\n   288\t        // Against the chart's painted background (the figure's most frequent colour), as L2 measures it.\n   289\t        const backdrop = modeColor(img, { x0: 0, y0: 0, x1: img.width, y1: img.height }).color;\n   290\t        for (const [k, b] of [...strips, ...rings.map(r => r.box)].entries()) {\n   291\t          const ink = inkColor(img, view, b, backdrop);\n   292\t          if (!ink) { problems.push(`datum ${i}: indicator ${k} at ${JSON.stringify(b)} not painted`); continue; }\n   293\t          if (contrast(ink, backdrop) < 3) problems.push(`datum ${i}: indicator ${k} ${ink} is ${contrast(ink, backdrop).toFixed(2)}:1 on ${backdrop}`);\n   294\t        }\n   295\t        const tip = page.locator('#chart .axylo-tooltip');\n   296\t        if (!(await tip.isVisible())) { problems.push(`datum ${i}: no tooltip`); continue; }\n   297\t        const tipBox = await box(page, '#chart .axylo-tooltip');\n   298\t        const drawn = await shapes(page, '#chart', type === 'donut' ? 10000 : type === 'bar' ? 10000 : 20);\n   299\t        const marks = datumMarks(type, drawn, i, type === 'donut' ? await ring(page) : null);\n   300\t        if (!marks.length) problems.push(`datum ${i}: no mark found for the focused datum`);\n   301\t        for (const m of covered(tipBox, [...marks, ...strips, ...rings.map(r => r.box)])) problems.push(`datum ${i}: tooltip ${JSON.stringify(tipBox)} covers ${JSON.stringify(m)}`);\n   302\t      }\n   303\t      expect(problems).toEqual([]);\n   304\t      expect(await closePage(page)).toEqual([]);\n   305\t    });\n   306\t  }\n   307\t});\n   308\t\n   309\t/** The drawn mark(s) of the i-th datum in keyboard order, from the SVG shapes grouped by colour slot. */\n   310\tfunction datumMarks(type: Full, drawn: Record<number, { box: { x: number; y: number; width: number; height: number }; commands: string }[]>, i: number, donut: { cx: number; cy: number; outer: number } | null) {\n   311\t  const bySlot = (slot: number) => (drawn[slot] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n   312\t  if (type === 'line' || type === 'area' || type === 'bar') return [bySlot(1)[i], bySlot(2)[i]].filter(b => b !== undefined);\n   313\t  if (type === 'donut') {\n   314\t    // A small box at the slice's middle angle, clockwise from 12 o'clock (spec F8), at 80 % of the outer radius.\n   315\t    if (!donut) return [];\n   316\t    const { cx, cy } = donut;\n   317\t    const r = 0.8 * donut.outer;\n   318\t    const before = SPEND.values.slice(0, i).reduce((a, b) => a + b, 0);\n   319\t    const angle = 2 * Math.PI * (before + SPEND.values[i]! / 2) / SPEND.values.reduce((a, b) => a + b, 0);\n   320\t    return [{ x: cx + r * Math.sin(angle) - 4, y: cy - r * Math.cos(angle) - 4, width: 8, height: 8 }];\n   321\t  }\n","exit_code":0,"status":"completed"}}
