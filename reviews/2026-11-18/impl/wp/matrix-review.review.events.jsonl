wn record when it has one. Without one, Chrome only in a run that is\n * Chrome or predates the switch: every browser launcher in this repository that does not read AXYLO_ENGINE\n * (apps/docs/test, tests/dist/browser.ts) launches system Chrome. In a run on another engine such a test is\n * \"engine not recorded\" (null) and stands for no engine.\n */\nfunction testEngine(test, runEngine) {\n  if (test.meta?.engine !== undefined) return test.meta.engine;\n  return runEngine === null || runEngine === 'chromium' ? 'chromium' : null;\n}\n\nconst testKey = (ancestors, title) => JSON.stringify([ancestors, title]);\nconst inSuite = (ancestors, prefix) => ancestors.some(suite => suite.startsWith(prefix));\n\nfunction resultFor(source, ref, results, suiteFailures) {\n  if (ref.kind === 'size') {\n    const exceeded = ref.entries.some(name => {\n      const { totalGzipBytes, targetKiB } = source.size.get(name);\n      return totalGzipBytes > targetKiB * 1024;\n    });\n    const status = exceeded ? 'fail' : 'pass';\n    return { status, reports: new Map([[source.path, new Set([status])]]), reasons: new Set() };\n  }\n  const reports = new Map();\n  const reasons = new Set();\n  if (!testKinds.includes(ref.kind)) return { status: 'not run', reports, reasons };\n  // A browser citation is answered only by results of its own engine: a pass elsewhere is no evidence here.\n  const engine = ref.kind === 'browser' ? ref.engine ?? 'chromium' : null;\n  const sameEngine = test => engine === null || test.engine === engine;\n  const expected = ref.ancestors ? [testKey(ref.ancestors, ref.title)] : ref.registration\n    ? source.titles.templates.filter(test => test.template === ref.registration)\n      .map(test => testKey(test.ancestors, ref.title))\n    : source.titles.tests.filter(({ title, ancestors }) => ref.title\n      ? title === ref.title : inSuite(ancestors, ref.prefix) && (!ref.casePrefix || title?.startsWith(ref.casePrefix)))\n      .map(({ ancestors, title }) => testKey(ancestors, title));\n  const keys = new Set(expected);\n  const templates = ref.casePrefix ? source.titles.templates.filter(test => inSuite(test.ancestors, ref.prefix)) : [];\n  for (const [file, runEngine] of suiteFailures.get(source.path) ?? []) {\n    if (engine === null || runEngine === engine || (runEngine === null && engine === 'chromium')) reports.set(file, new Set(['fail']));\n  }\n  const passed = new Set();\n  for (const test of results.get(source.path) ?? []) {\n    const key = testKey(test.ancestorTitles, test.title);\n    const matches = ref.prefix ? inSuite(test.ancestorTitles, ref.prefix) && (!ref.casePrefix || test.title.startsWith(ref.casePrefix))\n      : ref.ancestors ? keys.has(key) : test.title === ref.title;\n    if (!matches) continue;\n    if (!sameEngine(test)) {\n      if (test.engine === null) reasons.add(`${basename(test.file)}: engine not recorded in a ${engineLabel(test.runEngine)} run`);\n      continue;\n    }\n    if (test.status !== 'passed' && test.status !== 'failed' && isText(test.meta?.notRun)) reasons.add(`Not run on ${test.meta.notRun}`);\n    // Historical failures remain visible even when a suite has since replaced the assertion.\n    if (test.status === 'passed' && (!ref.casePrefix || keys.has(key)\n      || templates.some(candidate => testKey(candidate.ancestors, test.title) === key && matchesTemplate(test.title, candidate.template)))) {\n      passed.add(key);\n    }\n    if (!reports.has(test.file)) reports.set(test.file, new Set());\n    reports.get(test.file).add(test.status === 'failed' ? 'fail' : test.status === 'passed' ? 'pass' : 'skipped');\n  }\n  const status = [...reports.values()].some(values => values.has('fail')) ? 'fail'\n    : passed.size && (!ref.cases || passed.size === ref.cases) && expected.every(key => passed.has(key))\n      && [...reports.values()].every(values => !values.has('skipped')) ? 'pass' : 'not run';\n  if (status === 'not run' && engine !== null && !reports.size && !reasons.size) reasons.add(`No ${engineLabel(engine)} result`);\n  return { status, reports, reasons };\n}\n\nfunction cellFor(row, type, root, sources, results, suiteFailures) {\n  if (!row.appliesTo.includes(type)) return { status: 'not applicable', reports: new Map(), unrun: [], reasons: new Set() };\n  const required = row.evidence?.[type] ?? [];\n  const weak = row.weak?.[type] ?? [];\n  const outcome = ref => resultFor(sources.get(resolve(root, ref.file)), ref, results, suiteFailures);\n  const outcomes = required.map(outcome);\n  const supporting = weak.map(outcome);\n  let status;\n  if ([...outcomes, ...supporting].some(result => result.status === 'fail')) status = 'fail';\n  else if (row.cannotVerify?.[type]) status = 'cannot be verified here';\n  else if (row.pending?.[type]) status = 'not run';\n  else if (row.gaps?.[type] || (!required.length && weak.length)) status = 'weak';\n  else if (!required.length) status = 'no evidence';\n  else status = [...outcomes, ...supporting].every(result => result.status === 'pass') ? 'pass' : 'not run';\n\n  const reports = new Map();\n  for (const { reports: matches } of [...outcomes, ...supporting]) for (const [file, values] of matches) {\n    if (!reports.has(file)) reports.set(file, new Set());\n    for (const value of values) reports.get(file).add(value);\n  }\n  const unrun = [...required.filter((ref, i) => testKinds.includes(ref.kind) && outcomes[i].status === 'not run'),\n    ...weak.filter((_, i) => testKinds.includes(weak[i].kind) && supporting[i].status === 'not run')];\n  const reasons = new Set([...outcomes, ...supporting].filter(result => result.status === 'not run').flatMap(result => [...result.reasons]));\n  return { status, reports, unrun, reasons };\n}\n\nconst escapeCell = value => value.replaceAll('|', '\\\\|').replace(/\\r?\\n/g, ' ');\nconst label = value => value.replace(/[\\\\\\[\\]]/g, '\\\\$&');\nconst fileLink = (from, root, file) => `[${label(file)}](${relative(from, resolve(root, file)).split(sep).map(encodeURIComponent).join('/')})`;\n\nfunction groupTypes(entries) {\n  const groups = new Map();\n  for (const [type, value] of entries) {\n    if (!groups.has(value)) groups.set(value, []);\n    groups.get(value).push(type);\n  }\n  return [...groups].map(([value, types]) => `${types.join(', ')} · ${value}`);\n}\n\nfunction readerDetails(rows, root, from, review) {\n  const failures = new Map();\n  const weak = [];\n  const missing = [];\n  const pending = [];\n  const environment = [];\n  const limits = new Map();\n  const waivers = [];\n  const unrun = new Map();\n  for (const { row, cells } of rows) {\n    const cellsOf = status => chartTypes.filter((_, i) => cells[i].status === status);\n    const failed = cellsOf('fail');\n    if (failed.length) failures.set(row.id, new Set(failed));\n    const gaps = cellsOf('weak').flatMap(type => row.gaps?.[type]\n      ? [[type, row.gaps[type]]] : (row.weak?.[type] ?? []).map(ref => [type, ref.reason]));\n    if (gaps.length) weak.push(`- **${row.id}** · ${groupTypes(gaps).map(note => `Weak · ${note}`).join('\\n  - ')}`);\n    const absent = cellsOf('no evidence');\n    if (absent.length) missing.push(`- **${row.id}** · ${absent.join(', ')} · ${row.statement}`);\n    const waiting = groupTypes(cellsOf('not run').map(type => {\n      const reasons = [...cells[chartTypes.indexOf(type)].reasons].sort();\n      return [type, row.pending?.[type] ?? `Required assertions have no matching passing result.${reasons.length ? ' ' + reasons.map(reason => label(reason) + '.').join(' ') : ''}`];\n    }));\n    if (waiting.length) pending.push(`- **${row.id}** · ${waiting.join('\\n  - ')}`);\n    for (const [type, waiver] of Object.entries(row.waivers ?? {})) {\n      waivers.push(`- **${row.id}/${type}** · Waiver granted by ${waiver.grantedBy} · ${waiver.reason}`);\n    }\n    const unavailable = groupTypes(Object.entries(row.cannotVerify ?? {}));\n    if (unavailable.length) environment.push(`- **${row.id}** · ${unavailable.join('\\n  - ')}`);\n    for (const [type, note] of Object.entries(row.limits ?? {})) {\n      if (!limits.has(note)) limits.set(note, new Map());\n      const criteria = limits.get(note);\n      if (!criteria.has(row.id)) criteria.set(row.id, []);\n      criteria.get(row.id).push(type);\n    }\n    for (const [i, cell] of cells.entries()) {\n      for (const ref of cell.unrun) {\n        if (!unrun.has(ref.file)) unrun.set(ref.file, new Set());\n        unrun.get(ref.file).add(`${row.id}/${chartTypes[i]}`);\n      }\n    }\n  }\n  if (rows.some(({ row }) => row.id === 'P1')) {\n    environment.push(`- **GPU** · Hardware rasterization needs a headed, GPU-backed run. ${fileLink(from, root, 'docs/decisions/0002-mark-renderer.md')}`);\n  }\n  const failedGroups = [];\n  for (const { label, cells, detail, sources = [] } of review?.failureGroups ?? []) {\n    const affected = [];\n    for (const [id, types] of Object.entries(cells)) {\n      const found = types.filter(type => failures.get(id)?.delete(type));\n      if (found.length) affected.push(`${id} (${found.join(', ')})`);\n    }\n    if (affected.length) {\n      const links = sources.map(file => fileLink(from, root, file));\n      failedGroups.push(`- **${label}** · ${affected.join(' · ')}. ${detail}${links.length ? ' ' + links.join(' · ') : ''}`);\n    }\n  }\n  for (const [id, types] of failures) {\n    if (types.size) failedGroups.push(`- **${id}** · ${[...types].join(', ')}`);\n  }\n  return [\n    '## What stands between this tree and a release', '',\n    '### Failing cells', '', ...(failedGroups.length ? failedGroups : ['No failing cells recorded.']), '',\n    '### Weak cells', '', ...(weak.length ? weak : ['No weak cells recorded.']), '',\n    '### No evidence', '', ...(missing.length ? missing : ['No cells without evidence.']), '',\n    '### Not run', '',\n    ...(rows.some(({ row }) => row.id === 'P1') && pending.length\n      ? [`P1–P8 have a harness in \\`bench/\\`. Acceptance measurements await a quiet machine. ${fileLink(from, root, 'bench/README.md')}`, ''] : []),\n    ...(pending.length ? pending : ['No cells awaiting a run.']), '',\n    '### Cannot be verified here', '', ...(environment.length ? environment : ['No environment limits recorded.']), '',\n    ...(waivers.length ? ['### Waivers', '', ...waivers, ''] : []),\n    ...(limits.size ? ['## Evidence limits by cell', '', ...[...limits].map(([note, criteria]) =>\n      `- ${note} **${[...criteria].map(([id, types]) => `${id} (${types.join(', ')})`).join(' · ')}**`), ''] : []),\n    '## Evidence that exists but was not run for this report', '',\n    ...(unrun.size ? ['These files have citations with required assertions missing or skipped in the supplied results.', ''] : []),\n    ...(unrun.size ? [...unrun].map(([file, cells]) => `- ${[...cells].join(', ')} · ${fileLink(from, root, file)}`)\n      : ['Every required executable citation has a matching result. Unmeasured workloads appear under Not run.']), '',\n  ].join('\\n');\n}\n\nfunction describeReview(review, rows, counts) {\n  if (!review) return [];\n  const { scope, negativeControls, baseline, changeReasons } = review;\n  const previous = Object.fromEntries(statuses.map(status => [status, 0]));\n  const groups = new Map();\n  for (const { row, cells } of rows) {\n    const before = baseline[row.id];\n    if (!before) continue;\n    for (const [i, { status }] of cells.entries()) {\n      previous[before[i]]++;\n      if (before[i] === status) continue;\n      const transition = `${before[i]} → ${status}`;\n      if (!groups.has(transition)) groups.set(transition, new Map());\n      const group = groups.get(transition);\n      if (!group.has(row.id)) group.set(row.id, []);\n      group.get(row.id).push(chartTypes[i]);\n    }\n  }\n  return [\n    '## Scope of this evidence review', '',\n    ...scope.flatMap(paragraph => [paragraph, '']),\n    '## Status changes from the previous report', '',\n    'The baseline is the checked-in report before the re-merge. The separate coordinator checker log stopped at structural citation errors.', '',\n    '| Status | Before | After |', '| --- | ---: | ---: |',\n    ...statuses.map(status => `| ${status} | ${previous[status]} | ${counts[status]} |`), '',\n    ...[...groups].map(([transition, group]) => {\n      const count = [...group.values()].reduce((total, types) => total + types.length, 0);\n      const cells = [...group].map(([id, types]) => `${id} (${types.join(', ')})`).join(' · ');\n      return `- **${transition} (${count})** · ${changeReasons[transition] ?? 'See the evidence and blocker notes for these cells.'}\\n  - ${cells}`;\n    }), '',\n    '## Negative controls', '',\n    negativeControls.intro, '',\n    ...negativeControls.checks.map(([helper, mutation]) => `- **${helper}** · ${mutation}`), '',\n  ];\n}\n\nfunction describeProvenance(provenance) {\n  if (!provenance) return 'missing';\n  const changed = provenance.changedDuringRun ? ', working tree changed during run' : '';\n  return `commit ${provenance.commit}, dirty ${provenance.dirty}, tree SHA-256 ${provenance.tree}, result SHA-256 ${provenance.resultSha256}, ${Object.keys(provenance.hashes ?? {}).length} cited test hashes in the sidecar${changed}`;\n}\n\nfunction describeRuns(runs, root) {\n  if (!runs.length) return ['Static coverage only. No Vitest reports supplied.'];\n  return ['## Supplied Vitest runs', '', 'Suite counts include assertions outside the matrix. Each cell lists the reports with matching assertions, including partial evidence in weak cells.', '',\n    ...runs.flatMap(({ file, passed, skipped, failures, provenance, provenanceError, engine, engineVersion }) => [\n      `- \\`${relative(root, file)}\\` · ${engine ? `${engineLabel(engine, engineVersion)} · ` : ''}${passed} passed assertions, ${failures.length} reported failures${skipped ? `, ${skipped} skipped or pending` : ''}`,\n      `  - Provenance: ${describeProvenance(provenance)}${provenanceError ? ' · ' + provenanceError : ''}`,\n      ...failures.map(({ source, test, message, assertionFailed }) => `  - \\`${source}\\` · ${test ? label(test)\n        : (assertionFailed ? 'Suite failed in addition to its failing assertions' : 'Suite failed without a failing assertion result')\n          + (message ? ' (' + label(message) + ')' : '')}`),\n    ]), ''];\n}\n\nfunction describeSizes(rows, root, sources, from) {\n  const measurements = new Map();\n  for (const { row } of rows) for (const refs of Object.values(row.evidence ?? {})) for (const ref of refs) {\n    if (ref.kind === 'size') measurements.set(ref.file, sources.get(resolve(root, ref.file)).size);\n  }\n  return [...measurements].flatMap(([file, entries]) => [\n    '## Packed size measurement', '',\n    ...[...entries].map(([name, { minBytes, totalGzipBytes, targetKiB }]) =>\n      `- ${name} · ${minBytes.toLocaleString('en-US')} minified JS bytes, ${(totalGzipBytes / 1024).toFixed(2)} KiB gzipped${targetKiB === null ? ''\n        : `, ${targetKiB} KiB target`} · ${fileLink(from, root, file)}`), '',\n  ]);\n}\n\nfunction uniqueReportLabel(file, files, root) {\n  const name = file.split(sep).at(-1);\n  return files.filter(candidate => candidate.split(sep).at(-1) === name).length === 1 ? name : relative(root, file);\n}\n\nexport function check({ root, matrixFile = resolve(root, 'acceptance/matrix.json'), resultFiles = [], resultRoots = [], release = false }) {\n  root = resolve(root);\n  const expected = specIds(readFileSync(resolve(root, 'docs/02-product-spec.md'), 'utf8'));\n  const { matrix, sources } = readMatrix(root, matrixFile, expected);\n  const roots = resultRoots.map(path => resolve(root, path));\n  const reports = [...new Set(resultFiles.map(file => resolve(file)))].sort();\n  const { index, runs, suiteFailures } = readResults(root, roots, reports, sources);\n  if (release && runs.length) {\n    const current = runs.some(run => run.provenance) ? snapshot(root, citedTestFiles(matrix)) : null;\n    for (const run of runs) {\n      const recorded = run.provenance;\n      if (!recorded) run.provenanceError = 'release requires recorded provenance';\n      else if (recorded.changedDuringRun) run.provenanceError = 'release requires an unchanged working tree during the run';\n      else if (recorded.commit !== current.commit || recorded.dirty !== current.dirty || recorded.tree !== current.tree\n        || recorded.resultSha256 !== hashFile(run.file)\n        || Object.keys(recorded.hashes ?? {}).length !== Object.keys(current.hashes).length\n        || Object.entries(current.hashes).some(([file, hash]) => recorded.hashes?.[file] !== hash)) {\n        run.provenanceError = 'provenance does not match the working tree';\n      }\n    }\n  }\n  const reportFiles = [...runs.map(run => run.file), ...[...sources.values()].filter(source => source.size).map(source => source.path)];\n  const counts = Object.fromEntries(statuses.map(status => [status, 0]));\n  const rows = matrix.map(row => ({\n    row,\n    cells: chartTypes.map(type => {\n      const cell = cellFor(row, type, root, sources, index, suiteFailures);\n      counts[cell.status]++;\n      return cell;\n    }),\n  }));\n  const header = ['Criterion', 'Statement', ...chartTypes];\n  const printRow = cells => `| ${cells.map(escapeCell).join(' | ')} |`;\n  const describeCell = ({ status, reports }) => reports.size ? `${status} (${[...reports].map(([file, results]) =>\n    `${uniqueReportLabel(file, reportFiles, root)} ${[...results].sort().join('/')}`).join(', ')})` : status;\n  const table = [printRow(header), printRow(header.map(() => '---')),\n    ...rows.map(({ row, cells }) => printRow([row.id, row.statement, ...cells.map(describeCell)]))].join('\\n');\n  const summary = statuses.map(status => `- ${status} · ${counts[status]}`).join('\\n');\n  const from = resolve(root, 'acceptance');\n  const notesFile = resolve(from, 'review.json');\n  const notes = statSync(notesFile, { throwIfNoEntry: false }) ? json(notesFile) : null;\n  const review = notes && runs.length === 4 && runs.every(run => run.provenance?.commit === notes.commit) ? notes : null;\n  const report = ['# Acceptance report', '', ...describeRuns(runs, root), ...describeSizes(rows, root, sources, from),\n    '', '## Status by chart type', '', summary, '',\n    'The matrix contains individual test citations and applicability reasons. ' + fileLink(from, root, relative(root, matrixFile)), '',\n    table, '', readerDetails(rows, root, from, review), ...describeReview(review, rows, counts)].join('\\n') + '\\n';\n  const blocked = rows.some(({ row, cells }) => cells.some(({ status }, i) =>\n    !['pass', 'not applicable'].includes(status)\n    && (!['not run', 'cannot be verified here'].includes(status) || !row.waivers?.[chartTypes[i]])));\n  return {\n    table, summary, report, counts, runs, rows: structuredRows(rows, runs, reportFiles, root),\n    exitCode: release && (blocked || runs.some(run => run.provenanceError)) ? 1 : 0,\n  };\n}\n\n/**\n * The table's content as data, for readers that must not parse the Markdown (the docs' conformance page).\n * Per cell: its status, why it was not run, and each report that answered it, named as the table names it,\n * with what it recorded: the run's engine (null for Node runs and for results that predate the engine record)\n * and the provenance error that keeps a release from counting it (null when none).\n */\nfunction structuredRows(rows, runs, reportFiles, root) {\n  const byFile = new Map(runs.map(run => [run.file, run]));\n  return rows.map(({ row, cells }) => ({\n    id: row.id,\n    statement: row.statement,\n    cells: Object.fromEntries(chartTypes.map((type, i) => [type, {\n      status: cells[i].status,\n      reasons: [...cells[i].reasons].sort(),\n      reports: [...cells[i].reports].map(([file, results]) => {\n        const run = byFile.get(file);\n        return {\n          file: relative(root, file).split(sep).join('/'),\n          label: uniqueReportLabel(file, reportFiles, root),\n          source: run ? 'run' : 'size',\n          results: [...results].sort(),\n          engine: run?.engine ?? null,\n          engineVersion: run?.engineVersion ?? null,\n          provenanceError: run?.provenanceError ?? null,\n        };\n      }),\n    }])),\n  }));\n}\n\nfunction main(args) {\n  const root = fileURLToPath(new URL('..', import.meta.url));\n  const resultFiles = [];\n  const resultRoots = [];\n  let release = false;\n  let write = false;\n  for (let i = 0; i < args.length; i++) {\n    if (args[i] === '--release') {\n      release = true;\n    } else if (args[i] === '--write') {\n      write = true;\n    } else if (args[i] === '--results' || args[i] === '--roots') {\n      const option = args[i];\n      const paths = option === '--results' ? resultFiles : resultRoots;\n      const before = paths.length;\n      while (args[i + 1] && !args[i + 1].startsWith('--')) paths.push(resolve(args[++i]));\n      if (before === paths.length) throw new Error(option + ' needs at least one path');\n    } else {\n      throw new Error(`unknown argument ${args[i]} (usage: node acceptance/check.mjs [--results <file>…] [--roots <directory>…] [--release] [--write])`);\n    }\n  }\n  let result;\n  try {\n    result = check({ root, resultFiles, resultRoots, release });\n  } catch (error) {\n    for (const file of [...new Set(resultFiles)].sort()) {\n      let provenance;\n      try {\n        provenance = describeProvenance(readProvenance(file));\n      } catch (error) {\n        provenance = `unreadable (${error.message})`;\n      }\n      console.log(`${relative(root, file)} · Provenance: ${provenance}`);\n    }\n    throw error;\n  }\n  if (write) writeFileSync(resolve(root, 'acceptance/report.md'), result.report);\n  if (result.runs.length) console.log(describeRuns(result.runs, root).join('\\n'));\n  console.log(`${result.table}\\n\\n${result.summary}`);\n  return result.exitCode;\n}\n\nif (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  try {\n    process.exitCode = main(process.argv.slice(2));\n  } catch (error) {\n    console.error(error.message);\n    process.exitCode = 1;\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:STATUS.md'","aggregated_output":"# Implementation status\n\nCheckpoint file for the Axylo 1.0 build. Updated at every commit so work can resume after a restart. Plan: `docs/03-plan-typescript-release.md`.\n\n## Model assignment (owner)\n\nFirst assignment, 2026-11-18: code by Claude Opus 5.5 (effort high) or Codex `gpt-6.2-sol` (xhigh); design, review and other reasoning-heavy work by Claude Fable 5.2 (medium, the coordinator), Claude Opus 5.5 (xhigh), Codex `gpt-6.2-astra` (xhigh), Codex `gpt-6.2-sol` (max).\n\nChanged later the same day, in the owner's words: \"try to use more antropic model than openai , use openai model for another providier review\". From that point: building and fixing, in every module including those Codex wrote (data, layout, simplify, view, scene, lookup, reader, messages, diagnostics, the Node acceptance suite, the acceptance matrix and checker), goes to Anthropic models (Opus 5.5 high for code; Opus 5.5 xhigh or Fable 5.2 for harder reasoning). Codex models are used read-only, as the other-provider reviewer of that work. Work done before the change keeps its recorded authors.\n\n## Milestones\n\nThe plan's milestones were built in parallel by module, not strictly in order, because every stage had a fixed contract. State by plan milestone:\n\n| Milestone | State |\n|---|---|\n| M0 Foundations | Done: workspace, toolchain, contracts, benchmark harness (first version), build and size scripts. Not done: the acceptance matrix as data, CI workflows (no remote exists) |\n| M1 Vertical slice | Charts render end to end with both mark renderers. Renderer comparison: running (`bench/results/m1-renderer-comparison.md` when done). Interaction pattern: decided without a screen reader, `docs/decisions/0001-plot-interaction-pattern.md` |\n| M2 Faithful data | Data layer, diagnostics, temporal kinds, formatting, domains: built and cross-reviewed |\n| M3 Reading the chart | Title, states, pointer tooltip, label fitting: built. Legend, full tooltip, reference labels: in progress (chart core part 2, design pass 1) |\n| M4 Accessibility | In progress (chart core part 2). Screen-reader rehearsal cannot be done here |\n| M5 Bar, area, donut, compact, scatter | All render through the shared pipeline. Type-specific acceptance tests, the palette, and donut legend: in progress or not started |\n| M6 Updates and scale | update, append, zoom, simplification: built. Not started: performance tuning against budgets (first indication: about 84 ms for 100,000 points in the development build against about 12 ms for uPlot), the deferred stack rebuild, the scatter worst-case pick |\n| M7 Distribution and documentation | Not started: React adapter, documentation site, packed-distribution tests, size check against targets |\n| M8 Release | Not started |\n\n## Work packages\n\nObserved model and effort are read from harness metadata (Codex session rollouts, Claude subagent transcripts). Briefs, reports, reviews and fix briefs are in `reviews/2026-11-18/impl/wp/`.\n\nFinished and committed, each written by one provider and reviewed by the other: scales and formatting; layout and simplification; data layer, diagnostics and stores; renderers, text layer and theme; view and scene; lookup, reader and messages; chart core part 1 (review findings not yet fixed, see below); chart core part 2 (review running); benchmark harness and the M1 renderer measurements (not reviewed).\n\n| Running now (2026-11-18 night, after commit 71f2a02) | Who | Files |\n|---|---|---|\n| The text test's scatter fixture (premise out of date since 6ebdb6f), agent a61d95e46b3f0f3aa | Claude Opus 5.5 high | `tests/dist/pages`, `tests/dist/text.browser.test.ts` |\n| Docs: the AX160 page (tick case has no note), known limits, long tooltip values, new WCAG citations with a reason for each uncited criterion, agent a04bfe28413f07034 | Claude Opus 5.5 | `apps/docs/**` |\n| Small size cuts in `src/dom` and the stylesheet (duplicates, dead code), agent aa0e6fca8e4a6224b | Claude Opus 5.5 high | `src/dom`, `src/core/focus.ts`, `src/theme/css.ts` |\n| Matrix re-merge against the current spec and tests, writes `wp/matrix-merge.report.md`, agent a7e48ddd0321b1b1e | Claude Opus 5.5 xhigh | `acceptance/matrix.json` |\n\nCoordinator's verification of d33df71 on the shared build built from it (logs `acceptance/results/verify-d33df71/`): core browser suites on SVG 962 passed, 1 skipped (963); `chart` + `a11y` on canvas 312 passed, 4 skipped; `tests/dist` Node 90 of 90; `tests/dist` browser 22 of 26 (the four text tests, fixture out of date); docs browser 169 of 170 (the AX160 page expects a note that the tick-only rule removed). Whole Node suite 1752 passed. Spec rows now cite the WCAG criteria they cover (71f2a02), the coordinator's mapping, to be reviewed with the matrix.\n\nClosing pass commits: lookup (0d9532f), controller (68b3d6c), interaction (d33df71); reports `wp/closing.*.report.md`. The check they answer: `wp/final-check.review.md` (Codex gpt-6.2-sol max, of 9f9eeef). By the owner's stop rule no review follows; the evidence is each fix's own test (written first, failing on the old code) and the coordinator's runs. Verification of 9f9eeef (before the closing pass): SVG 948 passed, 1 skipped; canvas 298 passed, 4 skipped.\n\nFound by the distribution tests (not run since before the interaction rewrite) and fixed in d33df71: a value text too long for one line hid the whole tooltip. Still expected to fail in `tests/dist/text.browser.test.ts`: the scatter fixture's premise that no sentinel x label is truncated is out of date since 6ebdb6f (a scatter's x domain ends on drawn ticks; `wp/closing.layout-labels.report.md`): the acceptance author adjusts the fixture after this run.\n\nSizes at d33df71, packed files: everything 116.00 KiB (118,780 B against 118,784: 4 bytes under the 116 KiB target), line only 97.02 (target 98). No margin left for \"everything\": remaining behaviour-neutral cuts are the duplicates in `src/dom` (`pageDistance`, `setText`, three small ones), two duplicate CSS rules, and property mangling (about −2.4 kB, needs the browser suites on the production bundle).\n\nTo be written into the docs as limits (final check section 4 and remainders): closed shadow roots (Escape may go to another chart; a closed-root slot wrapper can cut off the tooltip); a dense ring of points just beyond the coincidence radius can stall hover; a stateful formatter that throws on one call and succeeds on another can report AX160 beside a formatted label; responsive CSS scoped to the plot column can leave the readout absent; a tooltip rectangle change alone can inherit elapsed rest (I6); mixed languages on the plot's proxy; non-neighbouring compact bars may share a pattern; extreme magnitudes around 1e-43; value x axes reserve no room for the last tick label, so long labels rotate.\n\nRound 3 commits: lookup `members` / `has` / `slot` (91adfe7), acceptance toolbar and Select range tests with checker exports (7f9965e), docs on the checker's rows (c4689bb), controller (c29e566), stores `retainedRows` (03ff5b1), interaction (9f9eeef); reports `wp/round3.*.report.md`. Sizes at 9f9eeef: everything 116.95 KiB (target 116: over), line only 97.71 (target 98: ok).\n\nCoordinator's verification of e90d8db on the shared build (logs `acceptance/results/verify-e90d8db/`): SVG 920 passed, 4 failed, 1 skipped (925); canvas `chart` + `a11y` 280 passed, 3 skipped. The failures: three A2 toolbar tests (new button), one I1 donut hold test (real, settled by the rewritten Escape clarification). Narrow re-check, Codex gpt-6.2-sol max (observed), `wp/blockers-recheck.review.md`: hold; blocking C2, I4, I5, R1, R2; fourteen regressions R1 to R14. Round 3 answers it; common brief `wp/round3.common.md` records the coordinator's decisions (groups come from the lookup; C13 and mixed proxy languages accepted as they are; pointer tolerance in viewport pixels).\n\nThe shared `packages/axylo/dist` is built from d33df71. Only the coordinator rebuilds it; agents use private builds through `AXYLO_BUNDLE`.\n\nIdle agents that can be resumed with SendMessage: controller a1d73b9f46c46814f; interaction aa0e6fca8e4a6224b; data, lookup, scene, layout a5e106319fe97c022; engines and acceptance suite a61d95e46b3f0f3aa; palette abc842fd0288bc675.\n\nReviews of the fix passes (both of commit bbd7564, both \"not ready\"): interaction, Codex gpt-6.2-astra xhigh (observed), `wp/fixes-verify.interaction.review.md`, five new blocking and eight major; controller and data, Codex gpt-6.2-sol max (observed; second attempt, the first was stopped by the provider's content filter), `wp/fixes-verify.controller.review.md`, fourteen new defects, three blocking. All assigned findings were fixed by their Anthropic authors with a failing test written first (reports `wp/*-verify.fix.report.md`, `wp/layout-x-coarser.report.md`); the narrow re-check above is the independent confirmation, not yet received. Decision 0004 has a section \"Clarifications after the verification\".\n\nEngines: `AXYLO_ENGINE=chromium|firefox|webkit` (e18c149); the runner and checker name the engine of every result (efa67d8). Author's acceptance runs on an isolated build of 7208470: Chrome 157 555 passed; Firefox 159 (Playwright) 385 passed, 9 failed, 161 not run; WebKit 27.2 (Playwright, not Safari) 384 passed, 10 failed, 161 not run (results in `acceptance/results/engines-7208470/`). The causes of those failures are fixed since (plot-edge slack, corridor slack, late-font measurement, size measured in the page), but the full suite has not been rerun on Firefox or WebKit at the current commit. The chart, a11y and render suites are not yet ported to the other engines (CDP uses listed in `wp/engines2.report.md`).\n\nOwner decisions on 2026-11-18: palette candidate B adopted (9861f54); size targets 96 KiB everything and 80 KiB line only (spec DX7); licence stays MIT with holder \"The Axylo authors\"; Playwright browser downloads allowed; no screen-reader rehearsal for 1.0 (state it as not done, do not block on it); the React adapter is removed from 1.0 (bf93e1a); Anthropic models build and fix, Codex reviews; memory budget P7 is 1.1× the caller's two columns (4a1db68); review rounds on the controller and interaction layers stop after round 3 with one last narrow check, leftovers become documented limits. Size targets for 1.0 raised to 116 KiB everything and 98 KiB line only (63c5b65, \"Raise targets\"); streaming as an opt-in import, worth about 15 KiB, is the first size item after 1.0.\n\nState (coordinator runs; not recorded runs):\n- e90d8db: type check clean; whole Node suite 1701 passed (before the restart). Browser verification running.\n- Sizes at e90d8db, packed files: everything 114.99 KiB (target 96), line only 96.84 (target 80), donut only 84.51, validate only 20.60, script tag 117.98. The fix passes of the day added about 10.7 KiB to \"everything\" (104.24 before them).\n- Performance, early and weak (one loaded session at 709fcbf): first render against uPlot about 2× slower at 3×120, 3× at 10,000 points, 7× at 100,000. Not re-measured. The scatter lookup build got slower in its author's measurement when the lattice moved into it (200,000 points: 44.8 to 78.1 ms): weigh in the performance pass (alternative: build at idle).\n\nCommitted since c0a339c: engine switch (e18c149); late-font measurer (a96835e); controller and data verification review and fix briefs (9c49487); data and lookup fixes with the plot-edge slack (315cd9e); runner and checker engines (efa67d8); controller verification fixes (d9dd81e); layout x coarser domain (2bbef28); interaction toggle and verification fixes with the decision's clarifications (e90d8db).\n\nKnown open items carried forward:\n- Size: targets are now 116 / 98 KiB. Before round 3: 114.96 / 96.81; round 3 adds about 1.5 KiB, so the behaviour-neutral cuts of `wp/size2.analysis.md` are needed for margin. The data author is applying them outside `src/dom` (dead test-only members, duplicate helpers, CSS minifier). Property mangling (−2.4 KiB) is not decided: it needs the whole browser suite on the production bundle.\n- View/scene review finding 10 (stack rebuilt over the whole frame per revision) is deferred to performance work.\n- Extreme magnitudes (values around 1e-43 and smaller): domain and ticks can disagree by rounding, or the tick set is empty (`wp/layout-x-coarser.report.md`). Recorded, not scheduled.\n- The acceptance matrix is stale: React rows, new and renamed tests, engines, DX1/DX7/DX8, the P7 bound, A3 rehearsal not done by the owner's decision.\n- Not tested: the control focus-outline margin in tooltip placement; the 0.01 px held-geometry comparison (interaction author's \"not done\").\n- `bench/history/20261118T03503*` (two files) are left uncommitted on purpose.\n\n## Next action\n\n1. Read `acceptance/results/verify-d33df71/*.txt` (rerun any configuration that was interrupted; commands are in the row above and in `AGENTS.md`). Triage: the text-test fixture to the acceptance author (a61d95e46b3f0f3aa); anything else to its author.\n2. Size margin: the small remaining cuts in `src/dom` and the stylesheet (interaction author aa0e6fca8e4a6224b); decide on property mangling with a full browser run on the production bundle.\n3. Docs (a04bfe28413f07034): the limits listed above; the AX160 tick rule; then `AXYLO_BROWSER=1 npx vitest run --config apps/docs/vitest.config.ts`.\n4. Spec A9: cite the applicable WCAG 2.2 AA criteria on the spec rows that cover them (only 10 are cited; I1 lacks 1.4.13), so the generated conformance page lists them.\n5. Port the `chart`, `a11y` and `render` suites to Firefox and WebKit (CDP uses listed in `wp/engines2.report.md`), then the full acceptance suite on both engines at the current commit.\n6. Record every configuration with provenance (`node acceptance/run.mjs unit|dist|dist-browser|browser`, plus `AXYLO_ENGINE=firefox|webkit … browser`), re-merge the matrix (Anthropic model; React rows gone, new and renamed tests, engines, DX1/DX7/DX8, P7, A3 not rehearsed), Codex reviews the merge, run the checker in release mode.\n7. On a quiet machine with no agents: `node bench/decision.mjs plan` (software family about 3.2 h, gpu family about 2.2 h); then budgets P1 to P8 and the large-series path.\n8. Agent rehearsal (DX12); Phase 1 comparison rerun with Axylo included.\n\n## Known limits that no agent can close\n\nCorrected on 2026-11-18 after checking the machine (Ubuntu, NVIDIA RTX 2060 SUPER, Wayland session, Chrome 157, Firefox 160 as a snap with geckodriver):\n\n- **GPU rendering can be tested here.** Headless Chrome uses software rendering by default, which is all the earlier runs used. With `--enable-gpu --use-angle=gl --ignore-gpu-blocklist`, or run headed on the desktop, Chrome reports the NVIDIA GPU. The benchmark's GPU-dependent workloads (resize, pixel ratio 2, process memory) are therefore open work, not a limit.\n- **Firefox can be driven through geckodriver** (WebDriver over HTTP, no download). Playwright cannot launch the installed Firefox (it needs its own patched build: a download, which needs the owner's permission and network). A WebDriver smoke suite covers rendering, layout, keyboard and pointer in real Firefox; Chrome-only tooling (the accessibility tree through CDP, media emulation) has no equivalent there.\n- **Firefox and WebKit through Playwright** are installed and launch headless (allowed and completed by the owner on 2026-11-18). WebKit on Linux is the engine, not Safari.\n- **Still outside this machine:** Safari on macOS and iOS, a real phone, Windows. No screen-reader rehearsal will be done for 1.0 (owner's decision); the docs and the conformance table say so.\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/browser/acceptance/checks.ts'","aggregated_output":"/**\n * The checkers the suite's verdicts rest on, kept apart so each has a negative control\n * (negative-controls.browser.test.ts): separators against a calibrated 1 px control, marker shape class on\n * a grayscale image, motion tracked frame by frame with the page's own clock, reference marks as painted,\n * and a dense series' spike in its own column.\n */\nimport type { Page } from 'playwright-core';\nimport { box, center, contrast, distance, interiorColor, modeColor, pixel, ring, screenshot, settle, shapes, type Box, type Image, type RGB } from './util';\nimport type { ChartType } from './fixtures';\nimport { gray, minimumDistance, VISIONS } from './vision';\n\n// ── separators ─────────────────────────────────────────────────────────────────────────────────────\n\nexport interface Seam { from: number; to: number; coverage: number; at: { x: number; y: number } }\n\n/** Image pixels along a line through `origin` (image px) in direction `dir`, `half` px each way, without repeats. */\nexport function scanLine(origin: { x: number; y: number }, dir: { x: number; y: number }, half: number): { x: number; y: number }[] {\n  const len = Math.hypot(dir.x, dir.y) || 1;\n  const ux = dir.x / len, uy = dir.y / len;\n  const out: { x: number; y: number }[] = [];\n  let prev = '';\n  for (let t = -half; t <= half; t += 0.125) {\n    const x = Math.floor(origin.x + ux * t), y = Math.floor(origin.y + uy * t);\n    const key = `${x},${y}`;\n    if (key !== prev) { out.push({ x, y }); prev = key; }\n  }\n  return out;\n}\n\n/**\n * Walks `points` and, at every change from one mark colour to another, sums the background the pixels in\n * between show: each pixel's projection on the line from the nearer mark colour to the background (1 for\n * pure background, 0 for pure mark). A pixel within `tolerance` of a mark colour belongs to that mark.\n */\nexport function seams(img: Image, points: readonly { x: number; y: number }[], colors: readonly RGB[], bg: RGB, tolerance = 24): Seam[] {\n  const out: Seam[] = [];\n  let last = -1, coverage = 0;\n  let mid: { x: number; y: number } = { x: 0, y: 0 };\n  for (const p of points) {\n    if (p.x < 0 || p.y < 0 || p.x >= img.width || p.y >= img.height) continue;\n    const c = pixel(img, p.x, p.y);\n    let k = -1, d = Infinity;\n    colors.forEach((m, i) => { const e = distance(c, m); if (e < d) { d = e; k = i; } });\n    if (d <= tolerance) {\n      if (last >= 0 && k !== last) out.push({ from: last, to: k, coverage, at: mid });\n      last = k;\n      coverage = 0;\n      continue;\n    }\n    const m = colors[k]!;\n    const w = [bg[0] - m[0], bg[1] - m[1], bg[2] - m[2]] as const;\n    const len = w[0] * w[0] + w[1] * w[1] + w[2] * w[2] || 1;\n    coverage += Math.min(1, Math.max(0, ((c[0] - m[0]) * w[0] + (c[1] - m[1]) * w[1] + (c[2] - m[2]) * w[2]) / len));\n    mid = p;\n  }\n  return out;\n}\n\n/**\n * Calibration: in the same page (same rasteriser, same device pixel ratio), two rects in `colors` with a\n * gap of `gap` CSS px between them, rotated so the gap runs at `angle` (radians, 0 = a horizontal seam),\n * at the four quarter-pixel offsets. Returns the smallest seam coverage measured across the gap, scanned\n * the same way as the chart's seams. A 1 px control gives the floor a real 1 px separator must reach.\n */\nexport async function controlCoverage(page: Page, colors: readonly [RGB, RGB], bg: RGB, gap: number, angle = 0): Promise<number> {\n  let worst = Infinity;\n  for (const offset of [0, 0.25, 0.5, 0.75]) {\n    await page.evaluate(({ colors, bg, gap, angle, offset }) => {\n      document.getElementById('seam-control')?.remove();\n      const NS = 'http://www.w3.org/2000/svg';\n      const svg = document.createElementNS(NS, 'svg');\n      svg.id = 'seam-control';\n      svg.setAttribute('width', '80');\n      svg.setAttribute('height', '80');\n      svg.style.cssText = `position: fixed; left: 0; top: 0; z-index: 99999; background: rgb(${bg.join(',')});`;\n      const g = document.createElementNS(NS, 'g');\n      g.setAttribute('transform', `rotate(${(angle * 180) / Math.PI} 40 40)`);\n      const y = 40 + offset - gap / 2;\n      for (const [i, [y0, h]] of ([[0, y], [y + gap, 80 - y - gap]] as const).entries()) {\n        const r = document.createElementNS(NS, 'rect');\n        r.setAttribute('x', '-40'); r.setAttribute('width', '160');\n        r.setAttribute('y', String(y0)); r.setAttribute('height', String(h));\n        r.setAttribute('fill', `rgb(${colors[i]!.join(',')})`);\n        g.appendChild(r);\n      }\n      svg.appendChild(g);\n      document.body.appendChild(svg);\n    }, { colors: colors as unknown as number[][], bg: bg as unknown as number[], gap, angle, offset });\n    const { img, scale } = await screenshot(page, '#seam-control', { x: 0, y: 0, width: 80, height: 80 });\n    const normal = { x: -Math.sin(angle), y: Math.cos(angle) };\n    const found = seams(img, scanLine({ x: 40 * scale, y: (40 + offset) * scale }, normal, 20 * scale), colors, bg);\n    worst = Math.min(worst, found.length ? Math.min(...found.map(f => f.coverage)) : 0);\n  }\n  await page.evaluate(() => document.getElementById('seam-control')?.remove());\n  return worst;\n}\n\n// ── marker shape class on a grayscale image ─────────────────────────────────────────────────────────\n\n/**\n * The shape class of the ink blob around `center` (image px) in a grayscale conversion of `img`: ink is a\n * pixel whose luma differs from the backdrop's by more than half the blob's own contrast. Classes come\n * from two measures that do not depend on size: how much of its bounding box the blob fills, and whether\n * its ink sits evenly above and below its middle.\n */\nexport function shapeClass(img: Image, center: { x: number; y: number }, radius: number, backdrop: RGB): string {\n  const bgLuma = gray(backdrop);\n  let peak = 0;\n  for (let y = -radius; y <= radius; y++) for (let x = -radius; x <= radius; x++) peak = Math.max(peak, Math.abs(gray(pixel(img, center.x + x, center.y + y)) - bgLuma));\n  const ink = (x: number, y: number) => Math.abs(gray(pixel(img, center.x + x, center.y + y)) - bgLuma) > peak / 2;\n  let x0 = Infinity, x1 = -Infinity, y0 = Infinity, y1 = -Infinity, n = 0;\n  for (let y = -radius; y <= radius; y++) for (let x = -radius; x <= radius; x++) if (ink(x, y)) { n++; x0 = Math.min(x0, x); x1 = Math.max(x1, x); y0 = Math.min(y0, y); y1 = Math.max(y1, y); }\n  if (!n) return 'none';\n  const fill = n / ((x1 - x0 + 1) * (y1 - y0 + 1));\n  const midY = (y0 + y1) / 2;\n  let top = 0, bottom = 0;\n  for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) if (ink(x, y)) { if (y < midY) top++; else if (y > midY) bottom++; }\n  const tilt = (top - bottom) / Math.max(1, top + bottom);\n  if (fill >= 0.9) return 'square';\n  if (fill >= 0.68) return 'round';\n  if (Math.abs(tilt) > 0.2) return tilt < 0 ? 'triangle-up' : 'triangle-down';\n  if (fill >= 0.4) return 'diamond';\n  return 'thin';\n}\n\n// ── motion, frame by frame, on the page's clock ─────────────────────────────────────────────────────\n\nexport interface MotionTrace {\n  /** Page-clock ms from the action to each frame, the frame's visual signature, and running animations. */\n  frames: { t: number; signature: string; animations: number }[];\n  /** Page-clock ms from the action to the first frame whose signature equals the final one, held after. */\n  settledAt: number;\n  /** Animations or transitions on the chart's elements seen at any frame. */\n  animated: boolean;\n}\n\n/**\n * Runs `action` in the page (create, update…) and records every following frame for `watch` ms: a\n * signature of what the marks paint (markup plus computed opacity, transform, fill, stroke and path data of\n * each mark) and the number of running animations on the chart's elements. `performance.now()` is read\n * inside the page around the frames, never across the test harness.\n */\nexport async function traceMotion(page: Page, action: string, watch = 1500, selector = '#chart'): Promise<MotionTrace> {\n  return page.evaluate(async ({ action, watch, selector }) => {\n    const root = () => document.querySelector(selector);\n    const signature = () => {\n      const scene = document.querySelector(`${selector} svg.axylo-svg .axylo-scene`);\n      if (!scene) return '';\n      let s = scene.innerHTML.replace(/axylo-clip-\\d+/g, 'clip');\n      for (const el of [scene, ...scene.querySelectorAll('*')]) {\n        const c = getComputedStyle(el);\n        s += `|${c.opacity},${c.transform},${c.fill},${c.stroke},${(c as unknown as { d?: string }).d ?? ''}`;\n      }\n      return s;\n    };\n    const running = () => document.getAnimations().filter(a => {\n      const t = (a.effect as KeyframeEffect | null)?.target;\n      return t instanceof Element && root()?.contains(t) && a.playState === 'running';\n    }).length;\n    const frames: { t: number; signature: string; animations: number }[] = [];\n    const t0 = performance.now();\n    // eslint-disable-next-line no-new-func\n    new Function(action)();\n    await new Promise<void>(resolve => {\n      const step = () => {\n        const t = performance.now() - t0;\n        frames.push({ t, signature: signature(), animations: running() });\n        if (t >= watch) resolve(); else requestAnimationFrame(step);\n      };\n      requestAnimationFrame(step);\n    });\n    // Settled: from the first frame after which the picture never changes again and no animation runs.\n    const final = frames.at(-1)!.signature;\n    let settled = frames.length - 1;\n    while (settled > 0 && frames[settled - 1]!.signature === final && frames[settled - 1]!.animations === 0) settled--;\n    if (frames[settled]!.animations > 0) settled = frames.length - 1;\n    return { frames: frames.map(f => ({ ...f, signature: f.signature.length > 200 ? String(f.signature.length) + ':' + f.signature.slice(-120) : f.signature })), settledAt: frames[settled]!.t, animated: frames.some(f => f.animations > 0) };\n  }, { action, watch, selector });\n}\n\n// ── reference marks as painted ──────────────────────────────────────────────────────────────────────\n\nexport interface ReferenceMark { kind: 'line' | 'band'; box: Box; paint: string }\n\n/** The scene elements painted with the reference colour (`--axylo-reference`), as viewport boxes. */\nexport async function referenceMarks(page: Page, selector = '#chart'): Promise<ReferenceMark[]> {\n  return page.evaluate(selector => {\n    const out: { kind: 'line' | 'band'; box: { x: number; y: number; width: number; height: number }; paint: string }[] = [];\n    for (const el of document.querySelectorAll<SVGGraphicsElement>(`${selector} svg.axylo-svg .axylo-scene *`)) {\n      if (!/--axylo-reference/.test(el.style.getPropertyValue('color'))) continue;\n      const r = el.getBoundingClientRect();\n      const kind = r.width > 2.5 && r.height > 2.5 ? 'band' : 'line';\n      out.push({ kind, box: { x: r.x, y: r.y, width: r.width, height: r.height }, paint: getComputedStyle(el).color });\n    }\n    return out;\n  }, selector);\n}\n\n// ── a dense series' spike in its own column ─────────────────────────────────────────────────────────\n\n/** The stroked line vertices of colour slot `slot`, in viewport px, and where the pen lifts between runs. */\nexport async function strokeRuns(page: Page, slot = 1, selector = '#chart'): Promise<{ x: number; y: number }[][]> {\n  return page.evaluate(({ slot, selector }) => {\n    const svg = document.querySelector(`${selector} svg.axylo-svg`) as SVGSVGElement;\n    const m = svg.getScreenCTM()!;\n    const runs: { x: number; y: number }[][] = [];\n    for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) {\n      if (!new RegExp(`--axylo-series-color-${slot}\\\\b`).test(el.style.getPropertyValue('color')) || el.style.getPropertyValue('stroke') !== 'currentcolor') continue;\n      for (const sub of (el.getAttribute('d') ?? '').split(/(?=M)/)) {\n        const nums = sub.match(/-?\\d*\\.?\\d+/g)?.map(Number) ?? [];\n        const run: { x: number; y: number }[] = [];\n        for (let i = 0; i + 1 < nums.length; i += 2) { const p = new DOMPoint(nums[i]!, nums[i + 1]!).matrixTransform(m); run.push({ x: p.x, y: p.y }); }\n        if (run.length) runs.push(run);\n      }\n    }\n    return runs;\n  }, { slot, selector });\n}\n\n/**\n * Where the drawing reaches a spike: the vertices within `tolerance` px of the spike's projected height,\n * and whether every one of them lies in the device-pixel column of the spike's projected x.\n */\nexport function spikeColumn(runs: readonly { x: number; y: number }[][], spike: { x: number; y: number }, dpr: number, tolerance = 0.75): { reached: boolean; outside: { x: number; y: number }[] } {\n  const near = runs.flat().filter(p => Math.abs(p.y - spike.y) <= tolerance);\n  const column = Math.floor(spike.x * dpr);\n  const outside = near.filter(p => Math.abs(Math.floor(p.x * dpr) - column) > 1);\n  return { reached: near.some(p => Math.abs(Math.floor(p.x * dpr) - column) <= 1), outside };\n}\n\n// ── painted palette ───────────────────────────────────────────────────────────────────────────────\n\n/**\n * Eight series (or slices) of the type, drawn so each colour has a uniform painted interior to sample:\n * flat lines (their 2 px stroke at device pixel ratio 2), grouped bars, scatter points, donut slices.\n */\nexport function eight(type: ChartType): { fn: string; options: Record<string, unknown> } {\n  const names = ['S1', 'S2', 'S3', 'S4', 'S5', 'S6', 'S7', 'S8'];\n  if (type === 'donut') return { fn: 'donut', options: { title: 'Eight', data: names.map((n, i) => ({ n, v: 10 + i })), label: 'n', value: 'v' } };\n  if (type === 'scatter') return { fn: 'scatter', options: { title: 'Eight', data: [...names.map((s, i) => ({ x: i + 1, y: i + 1, s })), { x: 0, y: 0, s: 'S1' }, { x: 9, y: 9, s: 'S1' }], x: 'x', y: 'y', series: 's' } };\n  if (type === 'bar') return { fn: 'bar', options: { title: 'Eight', data: names.map((s, i) => ({ x: 'A', s, y: 10 + i })), x: 'x', y: 'y', series: 's' } };\n  // Levels 15…85 keep every line inside the plot, never on a clipped edge.\n  const data = names.flatMap((s, i) => [0, 1, 2, 3].map(x => ({ x, s, y: 15 + 10 * i })));\n  return { fn: type === 'compact' ? 'line' : type, options: { title: 'Eight', data, x: 'x', y: 'y', series: 's', ...(type === 'compact' ? { compact: true } : {}) } };\n}\n\n/** The painted colour of each series, sampled from a uniform part of its own marks, in series order. */\nexport async function paintedSeries(page: Page, type: ChartType): Promise<{ colors: RGB[]; backdrop: RGB; problems: string[] }> {\n  const { img, box: view, scale } = await screenshot(page, '#chart .axylo-plot');\n  const backdrop = modeColor(img, { x0: 0, y0: 0, x1: img.width, y1: img.height }).color;\n  const colors: RGB[] = [];\n  const problems: string[] = [];\n  const sample = (b: Box, slot: number) => {\n    const m = interiorColor(img, view, b, 0);\n    if (m.pixels === 0 || m.share < 0.5) problems.push(`series ${slot}: no uniform paint in ${JSON.stringify(b)} (share ${m.share.toFixed(2)})`);\n    colors.push(m.color);\n  };\n  if (type === 'donut') {\n    const g = await ring(page);\n    const total = 10 * 8 + 28;\n    let before = 0;\n    for (let i = 0; i < 8; i++) {\n      const v = 10 + i, a = (2 * Math.PI * (before + v / 2)) / total;\n      before += v;\n      sample({ x: g.cx + 0.85 * g.outer * Math.sin(a) - 1.5, y: g.cy - 0.85 * g.outer * Math.cos(a) - 1.5, width: 3, height: 3 }, i + 1);\n    }\n  } else if (type === 'bar') {\n    const drawn = await shapes(page, '#chart', 100000);\n    for (let slot = 1; slot <= 8; slot++) { const b = drawn[slot]?.[0]?.box; if (!b) problems.push(`series ${slot}: no bar`); else sample({ x: b.x + 2, y: b.y + b.height / 2, width: Math.max(1, b.width - 4), height: 4 }, slot); }\n  } else if (type === 'scatter') {\n    const drawn = await shapes(page, '#chart', 14);\n    // A point's shape may be thin (plus, cross, star): its most frequent colour other than the backdrop. The\n    // point nearest the plot's middle is used, away from any clipped edge.\n    const plotBox = await box(page, '#chart .axylo-proxy');\n    const mid = { x: plotBox.x + plotBox.width / 2, y: plotBox.y + plotBox.height / 2 };\n    for (let slot = 1; slot <= 8; slot++) {\n      const b = (drawn[slot] ?? []).map(s => s.box).sort((p, q) => Math.hypot(center(p).x - mid.x, center(p).y - mid.y) - Math.hypot(center(q).x - mid.x, center(q).y - mid.y))[0];\n      if (!b) { problems.push(`series ${slot}: no point`); continue; }\n      const ink = inkColor(img, view, b, backdrop);\n      if (!ink) { problems.push(`series ${slot}: no uniform paint in its point`); continue; }\n      colors.push(ink);\n    }\n  } else {\n    // Flat lines: the middle of the first segment, away from any marker.\n    for (let slot = 1; slot <= 8; slot++) {\n      const run = (await strokeRuns(page, slot)).flat().sort((a, b) => a.x - b.x);\n      if (run.length < 2) { problems.push(`series ${slot}: no line`); continue; }\n      // Along the whole first segment (a dashed line has gaps), the most frequent non-backdrop colour.\n      const ink = inkColor(img, view, { x: run[0]!.x + 4, y: run[0]!.y - 0.5, width: run[1]!.x - run[0]!.x - 8, height: 1 }, backdrop);\n      if (!ink) { problems.push(`series ${slot}: no uniform paint on its line`); continue; }\n      colors.push(ink);\n    }\n  }\n  return { colors, backdrop, problems };\n}\n\n/**\n * The most frequent colour in a box that differs from the backdrop by more than 40 per channel, when it\n * is at least 30 % of those pixels (a mark's own paint, not its anti-aliased edge); null otherwise.\n */\nexport function inkColor(img: Image, view: Box, b: Box, backdrop: RGB): RGB | null {\n  const s = img.width / view.width;\n  const counts = new Map<string, number>();\n  let inked = 0;\n  for (let y = Math.floor((b.y - view.y) * s); y < (b.y + b.height - view.y) * s; y++) {\n    for (let x = Math.floor((b.x - view.x) * s); x < (b.x + b.width - view.x) * s; x++) {\n      const p = pixel(img, x, y);\n      if (distance(p, backdrop) <= 40) continue;\n      inked++;\n      counts.set(p.join(','), (counts.get(p.join(',')) ?? 0) + 1);\n    }\n  }\n  const best = [...counts.entries()].sort((a, c2) => c2[1] - a[1])[0];\n  return best && best[1] / inked >= 0.3 ? best[0].split(',').map(Number) as unknown as RGB : null;\n}\n\n/** Contrast and distance problems of eight painted colours on their painted backdrop (empty when none). */\nexport function paletteProblems(colors: readonly RGB[], backdrop: RGB): string[] {\n  const out: string[] = [];\n  colors.forEach((c, i) => { const r = contrast(c, backdrop); if (r < 3) out.push(`series ${i + 1} ${c} is ${r.toFixed(2)}:1 on ${backdrop}`); });\n  for (const vision of VISIONS) {\n    for (const raster of [false, true]) {\n      const m = minimumDistance(colors, vision, raster);\n      if (m.distance < 0.1) out.push(`${vision}${raster ? ' (8-bit simulated image)' : ''}: series ${m.pair[0] + 1} and ${m.pair[1] + 1} are ${m.distance.toFixed(3)} apart`);\n    }\n  }\n  return out;\n}\n\n\n// ── marker classes ────────────────────────────────────────────────────────────────────────────────\n\n/**\n * The shape class of each crossing trace's last-point marker and of its legend marker, on a grayscale\n * conversion of a screenshot at device pixel ratio 4. The line strokes are made transparent for the\n * measurement only, so a marker is not merged with the line through it.\n */\nexport async function markerClasses(page: Page): Promise<{ plot: string[]; legend: string[] }> {\n  await page.addStyleTag({ content: '#chart .axylo-scene path[stroke-width] { stroke: transparent !important; } #chart .axylo-swatch-line { stroke: transparent !important; }' });\n  await settle(page);\n  const drawn = await shapes(page, '#chart', 14);\n  const { img, box: view, scale } = await screenshot(page, '#chart figure');\n  const backdrop = modeColor(img, { x0: 0, y0: 0, x1: img.width, y1: img.height }).color;\n  const plot: string[] = [];\n  for (const slot of [1, 2, 3]) {\n    const last = (drawn[slot] ?? []).map(s => center(s.box)).sort((a, b) => b.x - a.x)[0];\n    plot.push(last ? shapeClass(img, { x: Math.round((last.x - view.x) * scale), y: Math.round((last.y - view.y) * scale) }, Math.round(6 * scale), backdrop) : 'none');\n  }\n  const legend: string[] = [];\n  for (const el of await page.locator('#chart .axylo-legend-entry .axylo-swatch-marker').all()) {\n    const b = (await el.boundingBox())!;\n    legend.push(shapeClass(img, { x: Math.round((b.x + b.width / 2 - view.x) * scale), y: Math.round((b.y + b.height / 2 - view.y) * scale) }, Math.round(6 * scale), backdrop));\n  }\n  return { plot, legend };\n}\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_48","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/lookup/scatter.test.ts'","aggregated_output":"import fc from 'fast-check';\nimport { describe, expect, it } from 'vitest';\nimport type { DatumRef, PickTarget, PointFrame, Rect } from '../../src/core/contracts';\nimport { buildLookup } from '../../src/lookup';\nimport { scatterLookup } from '../../src/lookup/scatter';\nimport { defaultMessages } from '../../src/messages';\nimport { linearScale } from '../../src/scale';\nimport { LATENCY } from '../browser/acceptance/fixtures';\nimport { formatter, frame, plot, scatter } from './fixtures';\n\nconst point = (seriesKey: string, row: number, x: number): Extract<DatumRef, { kind: 'point' }> =>\n  ({ kind: 'point', seriesKey, row, x });\n\nfunction points(lists: readonly (readonly (readonly [number, number])[])[], sourceRows?: readonly number[]): PointFrame {\n  let row = 0;\n  return {\n    shape: 'points', epoch: 1, revision: 1, source: { rowAt: () => null },\n    xKind: 'number', timeZone: null, xLabel: 'x', yLabel: 'y', xUnit: null, yUnit: null,\n    series: lists.map((list, s) => {\n      const sorted = list.map(([x, y]) => {\n        const i = row++;\n        return { x, y, row: sourceRows?.[i] ?? i };\n      }).sort((a, b) => a.x - b.x || a.y - b.y || a.row - b.row);\n      return {\n        key: `S${s}`, label: `S${s}`, drawable: true, x: Float64Array.from(sorted, p => p.x),\n        y: Float64Array.from(sorted, p => p.y), row: Int32Array.from(sorted, p => p.row),\n      };\n    }),\n  };\n}\nconst layout = plot({ kind: 'xy', x: linearScale([0, 100], [0, 100]), y: linearScale([0, 100], [0, 100]) });\n// For these fixtures, half a device pixel at this ratio is below the smallest nonzero distance difference.\nconst exactRatio = 2 ** 52;\n\nfunction scatterLayout(rect: Rect, xDomain: readonly [number, number], yDomain: readonly [number, number]) {\n  const projection = {\n    kind: 'xy', x: linearScale(xDomain, [rect.x, rect.x + rect.width]),\n    y: linearScale(yDomain, [rect.y + rect.height, rect.y]),\n  } as const;\n  return { ...plot(projection, rect.x + rect.width + 4, rect.y + rect.height + 4), plot: rect, projection };\n}\n\nfunction clamp(value: number, low: number, high: number): number {\n  return Math.max(low, Math.min(high, value));\n}\n\nit('picks the nearest point within 24 px and breaks a tie by later source row', () => {\n  const data = frame('scatter', { data: [{ x: 60, y: 50 }, { x: 40, y: 50 }], x: 'x', y: 'y' });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const tie = model.pick(50, 50)!;\n  expect(tie).toEqual({ kind: 'point', refs: [point('y', 1, 40)], count: 1 });\n  expect(model.primary(tie)).toEqual(point('y', 1, 40));\n  expect(model.tooltip(tie)).toMatchObject({ title: '40', count: 1, total: null, rows: [{ seriesLabel: 'y', x: '40', value: '50', row: 1 }] });\n  expect(model.anchor(point('y', 1, 40))).toEqual({ x: 40, y: 50, width: 0, height: 0 });\n  expect(model.pick(16, 50)).toEqual({ kind: 'point', refs: [point('y', 1, 40)], count: 1 });\n  expect(model.pick(15.99, 50)).toBeNull();\n  expect(model.pick(58, 50)).toEqual({ kind: 'point', refs: [point('y', 0, 60)], count: 1 });\n});\n\nit('breaks the rounded SVG midpoint tie in both orders of the browser long-form fixture', () => {\n  // Node layout of the 720 × 400 host with the caption, toolbar and axis lanes reserved.\n  const rect = { x: 46.814453125, y: 11.5, width: 669.185546875, height: 278.53125 };\n  const layout = scatterLayout(rect, [0, 40], [0, 10]);\n  const { x, y } = layout.projection;\n  const svg = (pixel: number) => Math.round(Math.fround(pixel) * 100) / 100;\n  const px = (svg(x.map(20)) + svg(x.map(21))) / 2;\n  const py = svg(y.map(5));\n  const first = { x: 20, y: 5, s: 'first' };\n  const second = { x: 21, y: 5, s: 'second' };\n  expect(Math.abs(x.map(21) - px)).toBeLessThan(Math.abs(x.map(20) - px));\n  for (const [a, b] of [[first, second], [second, first]] as const) {\n    const data = frame('scatter', {\n      data: [{ x: 0, y: 0, s: 'far' }, a, b, { x: 40, y: 9, s: 'far' }], x: 'x', y: 'y', series: 's',\n    });\n    expect(data.series.find(s => s.key === a.s)?.row).toEqual(Int32Array.of(1));\n    expect(data.series.find(s => s.key === b.s)?.row).toEqual(Int32Array.of(2));\n    const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n    for (const at of [px, Math.round(px)]) {\n      expect(model.pick(at, py)).toEqual({ kind: 'point', refs: [point(b.s, 2, b.x)], count: 1 });\n    }\n  }\n});\n\nit('limits scatter ties to half a device pixel from the closest point and to the pick radius', () => {\n  const data = points([[[10, 50]], [[30.375, 50]], [[30.75, 50]], [[30.5, 50]]]);\n  const view = scatter(data);\n  for (const [ratio, winner] of [[1, point('S1', 1, 30.375)], [2, point('S0', 0, 10)]] as const) {\n    const model = buildLookup(view, layout, formatter(data), defaultMessages, undefined, ratio);\n    expect(model.primary(model.pick(20, 50)!)).toEqual(winner);\n  }\n\n  const edge = points([[[23.875, 50]], [[24, 50]], [[24.125, 50]]]);\n  const model = buildLookup(scatter(edge), layout, formatter(edge), defaultMessages);\n  expect(model.primary(model.pick(0, 50)!)).toEqual(point('S1', 1, 24));\n});\n\nit.each([\n  { x: 68.4, y: 12.4, width: 827.6, height: 674.35 },\n  { x: 68.375, y: 12.375, width: 647.625, height: 340 },\n])('picks the latency fixture on each edge and corner of a $width × $height plot', rect => {\n  const corners = [\n    { size: 10, latency: 140, region: 'NW' }, { size: 35, latency: 140, region: 'NE' },\n    { size: 10, latency: 90, region: 'SW' }, { size: 35, latency: 90, region: 'SE' },\n  ];\n  const data = frame('scatter', { data: [...LATENCY.points, ...corners], x: 'size', y: 'latency', series: 'region' });\n  const view = scatter(data, { xDomain: [10, 35], yDomain: [90, 140] });\n  const model = buildLookup(view, scatterLayout(rect, view.xDomain, view.yDomain), formatter(data), defaultMessages);\n  const { x: left, y: top, width, height } = rect;\n  const right = left + width;\n  const bottom = top + height;\n  const probes = [\n    [point('EU', 1, 20), left + (10 / 25) * width, top],\n    [point('US', 3, 15), left + (5 / 25) * width, bottom],\n    [point('EU', 0, 10), left, top + (20 / 50) * height],\n    [point('US', 5, 35), right, top + (45 / 50) * height],\n    [point('NW', 6, 10), left, top], [point('NE', 7, 35), right, top],\n    [point('SW', 8, 10), left, bottom], [point('SE', 9, 35), right, bottom],\n  ] as const;\n  for (const [ref, x, y] of probes) {\n    for (const [dx, dy] of [[0, 0], [10, 0], [-10, 0], [0, 12], [0, -12], [10, 12], [-10, -12]] as const) {\n      const target = model.pick(clamp(x + dx, left, right), clamp(y + dy, top, bottom));\n      expect(target, JSON.stringify({ ref, dx, dy })).toEqual({ kind: 'point', refs: [ref], count: 1 });\n    }\n    expect(model.anchor(ref)).toMatchObject({ x: expect.closeTo(x, 10), y: expect.closeTo(y, 10) });\n  }\n  // Decision 0004 (clarifications): up to 1 CSS px outside picks as on the edge; further out, nothing.\n  expect(model.pick(left - 1, top)).toEqual(model.pick(left, top));\n  expect(model.pick(left - 1.01, top)).toBeNull();\n});\n\nit('indexes the rounded right and bottom edges in the same cells it searches', () => {\n  const extent = 192 - 2 ** -45;\n  const rect = { x: 72, y: 72, width: extent, height: extent };\n  const data = points([[[0, 0], [1, 0.5], [0.5, 0.5], [0.5, 0]]]);\n  const model = buildLookup(scatter(data), scatterLayout(rect, [0, 1], [0, 1]), formatter(data), defaultMessages);\n  const right = rect.x + rect.width;\n  const bottom = rect.y + rect.height;\n  for (const [x, y, ref] of [\n    [right, rect.y + 96, point('S0', 1, 1)],\n    [rect.x + 96, bottom, point('S0', 3, 0.5)],\n    [right - 10, rect.y + 96, point('S0', 1, 1)],\n    [rect.x + 96, bottom - 10, point('S0', 3, 0.5)],\n  ] as const) {\n    expect(model.pick(x, y)).toEqual({ kind: 'point', refs: [ref], count: 1 });\n  }\n});\n\nit('agrees with a brute-force scatter pick anywhere within radius of a drawn point', () => {\n  const fraction = fc.oneof(fc.constant(0), fc.constant(1), fc.integer({ min: 0, max: 1024 }).map(n => n / 1024));\n  const fractions = fc.array(fc.tuple(fraction, fraction), { minLength: 1, maxLength: 42 });\n  const extent = fc.oneof(fc.constant(192 - 2 ** -45), fc.integer({ min: 80, max: 1200 }).map(n => n / 2));\n  const offset = fc.tuple(fc.integer({ min: -24, max: 24 }), fc.integer({ min: -24, max: 24 }))\n    .filter(([x, y]) => x * x + y * y <= 24 ** 2);\n  fc.assert(fc.property(\n    fc.tuple(fc.integer({ min: -120, max: 128 }), fc.integer({ min: -120, max: 128 }), extent, extent),\n    fractions, fractions, fc.nat(), offset, fc.constantFrom(1, 1.25, 2, 3),\n    ([left, top, width, height], a, b, seed, [dx, dy], ratio) => {\n      const right = left + width;\n      const bottom = top + height;\n      const rect = { x: left, y: top, width, height };\n      const layout = scatterLayout(rect, [-2, 2], [-2, 2]);\n      const project = ([x, y]: readonly [number, number]) => [x * 4 - 2, 2 - y * 4] as const;\n      const shared = a[0]!;\n      const inputs = [a.map(project), [shared, ...b].map(project)];\n      const length = inputs[0]!.length + inputs[1]!.length;\n      const sourceRows = Array.from({ length }, (_, i) => i);\n      let random = seed;\n      for (let i = length - 1; i > 0; i--) {\n        random = (Math.imul(1664525, random) + 1013904223) >>> 0;\n        const j = random % (i + 1);\n        [sourceRows[i], sourceRows[j]] = [sourceRows[j]!, sourceRows[i]!];\n      }\n      let row = 0;\n      const drawn = inputs.flatMap((list, s) => list.map(([x, y]) => ({\n        x: clamp(layout.projection.x.map(x), left, right), y: clamp(layout.projection.y.map(y), top, bottom),\n        ref: point(`S${s}`, sourceRows[row++]!, x),\n      })));\n      const data = points(inputs, sourceRows);\n      const witness = drawn[seed % drawn.length]!;\n      const px = clamp(witness.x + dx, left, right);\n      const py = clamp(witness.y + dy, top, bottom);\n      const ranked = drawn.map(d => ({ ...d, distance: (d.x - px) ** 2 + (d.y - py) ** 2 }))\n        .sort((a, b) => a.distance - b.distance || b.ref.row - a.ref.row);\n      const nearest = ranked[0]!;\n      fc.pre(nearest.distance <= 24 ** 2);\n      const tied = ranked.filter(d => d.distance <= 24 ** 2 && Math.sqrt(d.distance) - Math.sqrt(nearest.distance) < 0.5 / ratio)\n        .reduce((latest, d) => d.ref.row > latest.ref.row ? d : latest, nearest);\n      for (const [dpr, winner] of [[exactRatio, nearest], [ratio, tied]] as const) {\n        const coincident = drawn.filter(d => (d.x - winner.x) ** 2 + (d.y - winner.y) ** 2 <= 0.5 ** 2);\n        const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages, undefined, dpr);\n        const target = model.pick(px, py);\n        if (target?.kind !== 'point') throw new Error('Expected scatter target within 24 px');\n        expect(target.refs[0]).toEqual(winner.ref);\n        expect(target.count).toBe(coincident.length);\n        expect(target.refs).toHaveLength(Math.min(8, coincident.length));\n        expect(new Set(target.refs.map(ref => ref.kind === 'point' && ref.row)).size).toBe(target.refs.length);\n        expect(coincident.map(d => d.ref)).toEqual(expect.arrayContaining([...target.refs]));\n      }\n    },\n  ), { numRuns: 1_500 });\n});\n\nit.each([10, 8])('picks the later row from the first series when the second series is at x=%s', x => {\n  const data = points([[[10, 10]], [[x, 10]]], [5, 2]);\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const refs = x === 10 ? [point('S0', 5, 10), point('S1', 2, x)] : [point('S0', 5, 10)];\n  expect(model.pick((10 + x) / 2, 10)).toEqual({ kind: 'point', refs, count: refs.length });\n});\n\nit('cannot