/\\s+/g, ' '));\n   394\t    await field.fill(arabic);\n   395\t    await page.keyboard.press('Enter');\n   396\t    expect(await field.getAttribute('aria-invalid'), arabic).toBeNull();\n   397\t    await page.evaluate(() => window.charts.pop()!.destroy());\n   398\t    const days = Array.from({ length: 200 }, (_, i) => ({ d: new Date(Date.UTC(2026, 0, 1) + i * 864e5).toISOString().slice(0, 10), y: i }));\n   399\t    await create(page, 'line', { title: 'D', locale: 'de-DE', data: days, x: 'd', y: 'y' });\n   400\t    await page.locator('#chart button', { hasText: 'View as table' }).click();\n   401\t    const german = await page.evaluate(() => new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, 4, 31))));\n   402\t    const dates = await page.locator('#chart .axylo-table tbody th').allTextContents();\n   403\t    await page.locator('#chart .axylo-pager button', { hasText: 'Next page' }).click();\n   404\t    dates.push(...await page.locator('#chart .axylo-table tbody th').allTextContents());\n   405\t    expect(dates, `the chart writes ${german}`).toContain(german);\n   406\t    await page.locator('#chart .axylo-pager button', { hasText: 'Previous page' }).click();\n   407\t    await page.locator('#chart .axylo-jump-field').fill(german);\n   408\t    await page.keyboard.press('Enter');\n   409\t    expect(await page.locator('#chart .axylo-jump-field').getAttribute('aria-invalid'), german).toBeNull();\n   410\t    expect(await page.locator('#chart .axylo-page').textContent()).toMatch(/2/);\n   411\t    expect(await closePage(page)).toEqual([]);\n   412\t  });\n   413\t\n   414\t  it('on a German page with pointAll translated, single mode\\'s built-in pointOf is marked English as soon as it is read; a jump error carries its template\\'s language', async () => {\n   415\t    const page = await chartPage();\n   416\t    await page.evaluate(() => document.documentElement.setAttribute('lang', 'de'));\n   417\t    // 150 x positions, so the table has a pager and its jump field.\n   418\t    const data = Array.from({ length: 150 }, (_, x) => ['a', 'b'].map((s, i) => ({ x, s, y: x + i }))).flat();\n   419\t    await create(page, 'line', { title: 'T', messages: { pointAll: '{x}: {values}. {position}' }, data, x: 'x', y: 'y', series: 's' });\n   420\t    await page.locator(proxy).focus();\n   421\t    await page.keyboard.press('ArrowRight');\n   422\t    expect(await page.locator(proxy).getAttribute('lang')).toBeNull();\n   423\t    // No frame in between: the language goes with the reading.\n   424\t    const lang = await page.evaluate(() => {\n   425\t      const el = document.querySelector('#chart .axylo-proxy') as HTMLElement;\n   426\t      el.dispatchEvent(new KeyboardEvent('keydown', { key: 'ArrowDown', bubbles: true, cancelable: true }));\n   427\t      return el.getAttribute('lang');\n   428\t    });\n   429\t    expect(lang).toBe('en');\n   430\t    await page.locator('#chart button', { hasText: 'View as table' }).click();\n   431\t    await page.locator('#chart .axylo-jump-field').fill('nichts');\n   432\t    await page.keyboard.press('Enter');\n   433\t    expect(await page.locator('#chart .axylo-jump-error').getAttribute('lang')).toBe('en');\n   434\t    expect(await closePage(page)).toEqual([]);\n   435\t  });\n   436\t});\n   437\t\n   438\tdescribe('epoch replacement (the DOM half of C3-5)', () => {\n   439\t  it('a full data replacement while the plot is focused: the text, the ring and Enter agree on the new first datum', async () => {\n   440\t    const page = await chartPage();\n   441\t    await create(page, 'line', { title: 'E', data: [0, 1, 2].map(x => ({ x, y: x })), x: 'x', y: 'y' });\n   442\t    await recordEvents(page);\n   443\t    await page.locator(proxy).focus();\n   444\t    await page.keyboard.press('End');\n   445\t    await settle(page);\n   446\t    await page.evaluate(() => window.charts[0]!.update({ data: [10, 11, 12, 13].map(x => ({ x, y: x * 2 })) }));\n   447\t    await settle(page);\n   448\t    expect(await valueText(page)).toMatch(/^10\\. y 20\\. Point 1 of 4/);\n   449\t    expect((await tip(page)).title).toBe('10');\n   450\t    if (RENDERER !== 'canvas') {\n   605\t    expect(await table.locator('tbody th').allTextContents()).toContain('550');\n   606\t\n   607\t    await hideToggle.click();\n   608\t    expect(await page.locator('#chart table').count()).toBe(0);\n   609\t    expect(await page.locator('#chart .axylo-table').count()).toBe(0);\n   610\t    expect(await closePage(page)).toEqual([]);\n   611\t  });\n   612\t\n   613\t  it('a value near row 900,000 of a 1,000,000-point typed-column chart is reachable; opening takes under 100 ms', async () => {\n   614\t    const page = await fixturePage();\n   615\t    const result = await page.evaluate(async () => {\n   616\t      const n = 1_000_000;\n   617\t      const x = new Float64Array(n);\n   618\t      const y = new Float64Array(n);\n   619\t      for (let i = 0; i < n; i++) { x[i] = i; y[i] = (i % 1000) / 4; }\n   620\t      const chart = window.Axylo.line!('#chart', { title: 'Million', data: { columns: { x, y } }, x: 'x', y: 'y' });\n   621\t      window.charts.push(chart);\n   622\t      await chart.__bench.ready();\n   623\t      const button = [...document.querySelectorAll<HTMLButtonElement>('#chart .axylo-toolbar button')].find(b => b.textContent === 'View as table')!;\n   624\t      const t0 = performance.now();\n   625\t      button.click();\n   626\t      const opened = performance.now() - t0;\n   627\t      const field = document.querySelector<HTMLInputElement>('#chart .axylo-jump-field')!;\n   628\t      field.value = '900000';\n   629\t      field.form!.requestSubmit();\n   630\t      const row = [...document.querySelectorAll('#chart tbody tr')].find(tr => tr.querySelector('th')!.textContent === '900,000');\n   631\t      return { opened, row: row?.textContent ?? null, page: document.querySelector('#chart .axylo-page')!.textContent };\n   632\t    });\n   633\t    expect(result.opened).toBeLessThan(100);\n   634\t    expect(result.page).toBe('Page 9,001 of 10,000');\n   635\t    // y[900000] = (900000 % 1000) / 4 = 0.\n   636\t    expect(result.row).toBe('900,0000');\n   637\t    expect(await closePage(page)).toEqual([]);\n   638\t  });\n   639\t\n   640\t  it('opening one table on a 24-chart page leaves every other chart where it was', async () => {\n   641\t    const page = await fixturePage({ css: '.tile { width: 280px; height: 220px; display: inline-block; vertical-align: top; }' });\n   642\t    const moved = await page.evaluate(async () => {\n   643\t      const tiles = Array.from({ length: 24 }, () => document.body.appendChild(Object.assign(document.createElement('div'), { className: 'tile' })));\n   644\t      const charts = tiles.map(el => window.make('trend', el));\n   645\t      await Promise.all(charts.map(c => c.__bench.ready()));\n   646\t      const boxes = () => tiles.map(t => JSON.stringify(t.getBoundingClientRect()));\n   647\t      const before = boxes();\nd9fa4b0:acceptance/matrix.json:4902:    \"statement\": \"\\\"View as table\\\" shows, when opened, an HTML table built from the normalized data: the title as caption, field labels with units as column headers, x values as row headers, values formatted as in F6. It covers the current x range, 100 rows per page, with every row reachable by paging or by jumping to an x value. It sits in a focusable scroll region no taller than the plot, and opening it does not move other charts.\",\n","exit_code":0,"status":"completed"}}
