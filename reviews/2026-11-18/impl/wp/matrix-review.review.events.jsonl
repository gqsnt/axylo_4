{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:tests/dist/csp.browser.test.ts'","aggregated_output":"/**\n * Spec DX8, the browser half: the packed files under a strict Content Security Policy sent as a real\n * response header, with no 'unsafe-inline' and no 'unsafe-eval' for scripts or styles (browser.ts, cspPolicy):\n *\n *   default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; report-uri /csp-report/<page>\n *\n * `script-src 'self'` is all that both the script-tag files and a bundled module need; `style-src 'self'`\n * admits the linked axylo.css and the page's own stylesheet. Every page draws all five chart types and the\n * compact variant, opens a tooltip and each table, and must produce no `securitypolicyviolation` event, no\n * report and no console error. Each page reports to a URL of its own, and the last test checks every page's\n * reports again after the others ran, so a late report is still caught and attributed. Both ways of getting\n * the stylesheet are run, the library applying it at run time and the page linking axylo.css, and each must\n * take effect: rules of the stylesheet show in computed styles, and the series colour it declares is what is\n * painted (so an adopted but empty sheet fails). A target matching nothing throws naming the selector.\n * Text insertion is tested per source and per surface in text.browser.test.ts.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport path from 'node:path';\nimport fs from 'node:fs';\nimport { bundle, closeBrowser, cspPolicy, drawn, figureName, launch, open, startServer, type Server } from './browser';\nimport { countNear, decodePng, hexRgb } from './png';\nimport { fixture, here } from './paths';\n\nconst IMG = '<img src=x onerror=\"window.__xss=(window.__xss||0)+1\">';\nconst SCRIPT = '<script>window.__xss=(window.__xss||0)+1</script>';\nconst CHARTS = ['line', 'area', 'bar', 'scatter', 'donut', 'compact'] as const;\nconst TITLES: Record<(typeof CHARTS)[number], string> = {\n  line: `Sessions ${IMG}`, area: `Stacked ${SCRIPT}`, bar: `Revenue ${IMG}`, scatter: `Latency ${SCRIPT}`, donut: `Browsers ${IMG}`, compact: `Compact ${IMG}`,\n};\n\nlet server: Server;\nconst scripts: Record<string, string> = {};\nconst pages = path.join(here, 'pages');\n\nbeforeAll(async () => {\n  server = await startServer();\n  await launch();\n  scripts.classic = (await bundle({ name: 'csp-charts-classic', cwd: pages, contents: `import { makeCharts, type Library } from './charts';\\nmakeCharts((window as unknown as { Axylo: Library }).Axylo);` })).url;\n  for (const condition of ['production', 'development']) {\n    scripts[`module-${condition}`] = (await bundle({\n      name: `csp-charts-module-${condition}`, cwd: fixture('npm'), format: 'esm', conditions: [condition], allow: [pages],\n      contents: `import * as A from 'axylo';\\nimport { makeCharts } from ${JSON.stringify(path.join(pages, 'charts'))};\\nmakeCharts(A);`,\n    })).url;\n  }\n});\nafterAll(async () => { await closeBrowser(); await server?.close(); });\n\n/**\n * The light-scheme default for the first series, as the packed stylesheet declares it. Read whatever form the\n * sheet uses (readable or minified): a fixed `[data-axylo-scheme=\"light\"]` block if there is one, otherwise the\n * `.axylo` defaults, where the value is a plain colour or the first argument of `light-dark(light, dark)`.\n * Every form the sheet gives must agree.\n */\nconst declaredSeries1 = (): string => {\n  const css = fs.readFileSync(fixture('npm', 'node_modules/axylo/dist/axylo.css'), 'utf8');\n  const blocks = [\n    ...[...css.matchAll(/\\[data-axylo-scheme=\"light\"\\]\\s*\\{([^}]*)\\}/g)].map(m => m[1]!),\n    ...[...css.matchAll(/(?:^|[}\\s,{])\\.axylo\\s*\\{([^}]*)\\}/g)].map(m => m[1]!),\n  ];\n  const values = blocks.flatMap(b => {\n    const v = /--axylo-default-series-1\\s*:\\s*([^;}]+)/.exec(b)?.[1]?.trim();\n    if (!v) return [];\n    const pair = /^light-dark\\(\\s*(#[0-9a-fA-F]{6})\\s*,/.exec(v);\n    return [pair ? pair[1]! : v];\n  });\n  const hexes = [...new Set(values.map(v => v.toLowerCase()))];\n  if (hexes.length !== 1 || !/^#[0-9a-f]{6}$/.test(hexes[0]!)) throw new Error(`axylo.css: no single light --axylo-default-series-1 (found ${JSON.stringify(values)})`);\n  return hexes[0]!;\n};\nconst PAGES: string[] = [];\n\nconst LOADERS = {\n  'script tag, production (axylo.iife.min.js)': () => `<script src=\"/script/node_modules/axylo/dist/axylo.iife.min.js\"></script><script src=\"${scripts.classic}\"></script>`,\n  'script tag, development (axylo.iife.js)': () => `<script src=\"/script/node_modules/axylo/dist/axylo.iife.js\"></script><script src=\"${scripts.classic}\"></script>`,\n  'bundled module, production condition': () => `<script type=\"module\" src=\"${scripts['module-production']}\"></script>`,\n  'bundled module, development condition': () => `<script type=\"module\" src=\"${scripts['module-development']}\"></script>`,\n};\n\nfunction html(loader: string, linked: boolean): string {\n  return `<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>Axylo under a strict policy</title>\n<link rel=\"stylesheet\" href=\"/pages/page.css\">\n${linked ? '<link rel=\"stylesheet\" href=\"/npm/node_modules/axylo/dist/axylo.css\">' : ''}\n<script src=\"/pages/observe.js\"></script>\n</head><body>\n<h1>Charts under a strict policy</h1>\n${CHARTS.map(id => `<div class=\"${id === 'compact' ? 'tile' : 'chart'}\" id=\"${id}\"></div>`).join('\\n')}\n${loader}\n</body></html>`;\n}\n\ninterface Seen {\n  violations: unknown[];\n  created: string[];\n  xss: unknown;\n  missing: string | null;\n  diagnostics: { chart: number; code: string; level: string }[];\n  adopted: number;\n  styleElements: number;\n  linkedActive: boolean;\n}\n\nlet counter = 0;\ndescribe.each(Object.entries(LOADERS))('%s', (_label, loader) => {\n  describe.each([['applied at run time', false], ['linked by the page', true]] as const)('stylesheet %s', (_how, linked) => {\n    it('draws every chart type, opens a tooltip and the tables, with no violation, no console error and no markup created', async () => {\n      const id = `page-${++counter}`;\n      const at = `/csp/${id}.html`;\n      PAGES.push(id);\n      server.pages.set(at, { html: html(loader(), linked), headers: { 'content-security-policy': cspPolicy(id) } });\n      const w = await open(server);\n      const response = await w.page.goto(`${server.origin}${at}`);\n      expect(response?.headers()['content-security-policy']).toBe(cspPolicy(id));\n\n      for (const id of CHARTS) {\n        const state = await drawn(w.page, `#${id}`);\n        expect(state.figures, `#${id} figures`).toBe(1);\n        expect(state.marks, `#${id} marks`).toBeGreaterThan(0);\n        expect(state.errorState, `#${id} error state`).toBe(false);\n        // The title is the accessible name, character for character: inserted as text.\n        expect(await figureName(w.page, `#${id}`), `#${id} name`).toContain(TITLES[id].slice(0, 20));\n        // A compact chart has no visible heading (spec 3.7); its name is its text alternative.\n        if (id !== 'compact') expect(await w.page.locator(`#${id} .axylo-title`).first().textContent()).toBe(TITLES[id]);\n      }\n\n      // The stylesheet took effect: its rules are in the computed styles, its series colour is the one painted.\n      // Checked before any table opens, since an open table takes the plot's place.\n      const hex = declaredSeries1();\n      const style = await w.page.evaluate(() => {\n        const figure = document.querySelector('#line figure')!;\n        // The renderer paints through `color` on the shape or its group (render/svg.ts).\n        const painted = (el: Element | null): string => { for (let e = el; e && !e.classList.contains('axylo-scene'); e = e.parentElement) { const c = (e as SVGElement).style?.getPropertyValue('color') ?? ''; if (c) return c; } return ''; };\n        const mark = Array.from(document.querySelectorAll<SVGElement>('#line .axylo-scene path')).find(p => /--axylo-series(-color)?-1\\b/.test(painted(p)));\n        return {\n          display: getComputedStyle(figure).display, titleWeight: getComputedStyle(document.querySelector('#line .axylo-title')!).fontWeight,\n          series1: getComputedStyle(figure).getPropertyValue('--axylo-default-series-1').trim(), mark: mark ? getComputedStyle(mark).color : null,\n        };\n      });\n      expect(style.display, '.axylo-figure { display: flex }').toBe('flex');\n      expect(style.titleWeight, '.axylo-title { font-weight: 600 }').toBe('600');\n      // A custom property computes to its declared text: the fixed light value, or the light-dark() pair led by it.\n      expect(style.series1.toLowerCase()).toMatch(new RegExp(`^(${hex}|light-dark\\\\(\\\\s*${hex}\\\\s*,.*\\\\))$`));\n      const [r, g, b] = hexRgb(hex);\n      expect(style.mark).toBe(`rgb(${r}, ${g}, ${b})`);\n      await w.page.locator('#line .axylo-plot').scrollIntoViewIfNeeded();\n      await w.page.mouse.move(2, 2);\n      const painted = countNear(decodePng(await w.page.locator('#line .axylo-plot').screenshot({ animations: 'allow' })), [r, g, b]);\n      console.info(`#line pixels painted in ${hex}: ${painted}`);\n      expect(painted, `pixels of the first series in ${hex}`).toBeGreaterThan(50);\n\n      // Tooltips: the series or category name and the formatter output are shown as text. The pointer\n      // sweeps the plot left to right until the tooltip shows the datum carrying the payload.\n      for (const [id, expected] of [['line', IMG], ['bar', SCRIPT]] as const) {\n        await w.page.locator(`#${id} .axylo-plot`).scrollIntoViewIfNeeded();\n        const plot = (await w.page.locator(`#${id} .axylo-plot`).boundingBox())!;\n        // Spec I1: content too wide for a floating tooltip goes to the fixed readout under the plot instead,\n        // which these long payloads cause.\n        const tip = w.page.locator(`#${id} .axylo-tooltip, #${id} .axylo-readout`).filter({ visible: true });\n        let text = '';\n        for (let f = 0.3; f < 0.99 && !text.includes(expected); f += 0.05) {\n          await w.page.mouse.move(plot.x + plot.width * f, plot.y + plot.height * 0.5);\n          await w.page.waitForTimeout(50);\n          if (await tip.count() === 1) text = (await tip.textContent()) ?? '';\n        }\n        expect(text, `#${id} tooltip`).toContain(expected);\n        expect(text, `#${id} tooltip formatter output`).toContain('<img src=x onerror=');\n        await w.page.mouse.move(2, 2);\n      }\n\n      // Tables.\n      for (const id of ['line', 'area', 'bar', 'scatter', 'donut'] as const) {\n        await w.page.locator(`#${id} [role=\"toolbar\"] button`, { hasText: 'View as table' }).click();\n        const table = w.page.locator(`#${id} table`);\n        await expect.poll(() => table.count(), { timeout: 5000 }).toBeGreaterThan(0);\n        expect(await table.first().locator('tr').count(), `#${id} table rows`).toBeGreaterThan(1);\n        const text = (await table.first().textContent()) ?? '';\n        if (id !== 'area') expect(text, `#${id} table text`).toMatch(/<img src=x onerror=|<script>/);\n      }\n\n      await w.page.waitForTimeout(300); // reports are sent asynchronously; the last test looks again\n      const seen: Seen = await w.page.evaluate(() => {\n        const g = window as unknown as Record<string, unknown>;\n        const charts = (g.__charts as { diagnostics: { code: string; level: string }[] }[] | undefined) ?? [];\n        const link = Array.from(document.styleSheets).find(s => s.href?.endsWith('/axylo.css'));\n        return {\n          violations: g.__violations as unknown[], created: g.__created as string[], xss: g.__xss ?? null, missing: g.__missing as string | null,\n          diagnostics: charts.flatMap((c, chart) => c.diagnostics.map(d => ({ chart, code: d.code, level: d.level }))),\n          adopted: document.adoptedStyleSheets.length, styleElements: document.querySelectorAll('style').length,\n          linkedActive: !!link && !link.disabled,\n        };\n      });\n      const errors = [...w.errors, ...w.console.filter(m => m.type === 'error').map(m => m.text)];\n      const warnings = w.console.filter(m => m.type === 'warning').map(m => m.text);\n      if (warnings.length) console.info(`console warnings: ${JSON.stringify(warnings)}`);\n      console.info(`stylesheets: adopted ${seen.adopted}, <style> ${seen.styleElements}, linked axylo.css active ${seen.linkedActive}`);\n\n      expect(seen.violations, 'securitypolicyviolation events').toEqual([]);\n      expect(server.reports.get(id) ?? [], 'reports sent to this page\\'s report URI').toEqual([]);\n      expect(errors, 'console errors and page errors').toEqual([]);\n      expect(seen.created, 'elements created from markup in text').toEqual([]);\n      expect(seen.xss, 'payload ran').toBeNull();\n      expect(seen.diagnostics.filter(d => d.level === 'error')).toEqual([]);\n      expect(seen.missing, 'error for a selector that matches nothing').toContain('#no-such-chart');\n      expect(seen.styleElements, 'the library creates no <style> element').toBe(0);\n      if (linked) {\n        expect(seen.linkedActive).toBe(true);\n        expect(seen.adopted, 'nothing adopted when the page links axylo.css').toBe(0);\n      } else {\n        expect(seen.adopted, 'the stylesheet adopted at run time').toBe(1);\n      }\n      // The computed rules came from that sheet: without it they are gone.\n      const without = await w.page.evaluate(linkedPage => {\n        if (linkedPage) Array.from(document.styleSheets).find(x => x.href?.endsWith('/axylo.css'))!.disabled = true;\n        else document.adoptedStyleSheets = [];\n        return getComputedStyle(document.querySelector('#line figure')!).display;\n      }, linked);\n      expect(without).not.toBe('flex');\n      expect(w.external).toEqual([]);\n      await w.context.close();\n    });\n  });\n});\n\ndescribe('the instruments themselves', () => {\n  it('catch text inserted as HTML: the observer records the element, and each report names its directive and page', async () => {\n    const id = 'negative-control';\n    const at = `/csp/${id}.html`;\n    server.pages.set(at, {\n      html: '<!doctype html>\\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>control</title><script src=\"/pages/observe.js\"></script></head><body><script src=\"/pages/inject.js\"></script></body></html>',\n      headers: { 'content-security-policy': cspPolicy(id) },\n    });\n    const w = await open(server);\n    await w.page.goto(`${server.origin}${at}`);\n    await expect.poll(() => (server.reports.get(id) ?? []).length, { timeout: 5000 }).toBe(2);\n    const seen = await w.page.evaluate(() => {\n      const g = window as unknown as Record<string, unknown>;\n      return { created: g.__created as string[], violations: (g.__violations as { effective: string }[]).map(v => v.effective).sort(), xss: g.__xss ?? null };\n    });\n    const reports = (server.reports.get(id) as { 'csp-report': Record<string, string> }[]).map(r => r['csp-report']);\n    expect(reports.map(r => r['effective-directive'] ?? r['violated-directive']).sort()).toEqual(['script-src-attr', 'style-src-attr']);\n    for (const r of reports) expect(r['document-uri']).toBe(`${server.origin}${at}`);\n    expect(seen.violations).toEqual(['script-src-attr', 'style-src-attr']);\n    expect(seen.created.some(e => e.startsWith('<img'))).toBe(true);\n    expect(seen.xss).toBeNull();\n    await w.context.close();\n  });\n\n  it('no page has received a report since its test ended', async () => {\n    await new Promise(r => setTimeout(r, 1000));\n    expect(PAGES.length).toBe(8);\n    expect(Object.fromEntries(PAGES.map(p => [p, server.reports.get(p) ?? []]))).toEqual(Object.fromEntries(PAGES.map(p => [p, []])));\n    expect([...server.reports.keys()].filter(k => !PAGES.includes(k) && k !== 'negative-control')).toEqual([]);\n  });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/browser/acceptance/a4-table.browser.test.ts'","aggregated_output":"/**\n * A4: \"View as table\" (spec 3.4). The table is read from Chrome's accessibility tree (table, caption,\n * column and row headers, cells) and compared with the fixture data; paging and the jump field are driven\n * with real clicks and typing.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport type { Page } from 'playwright-core';\nimport { start, stop } from '../harness';\nimport { axOf, axWithin, box, call, closePage, compareTable, create, createRaw, devPage, readTable, settle } from './util';\nimport { calendar, ENERGY, FULL, LATENCY_ORDER, tableOf, withUnit, type ChartType } from './fixtures';\n\nbeforeAll(start);\nafterAll(stop);\n\ntype Full = Exclude<ChartType, 'compact'>;\n\nasync function openTable(page: Page, selector = '#chart'): Promise<void> {\n  await page.locator(`${selector} [role=\"toolbar\"] button`, { hasText: 'View as table' }).click();\n  await settle(page);\n}\n\ndescribe('A4 table content', () => {\n  for (const type of FULL as Full[]) {\n    it(`A4 ${type}: View as table opens an HTML table built from the data: title as caption, field labels with units as column headers, x values as row headers, values formatted as in F6`, async () => {\n      const page = await devPage();\n      await create(page, type);\n      expect(await page.locator('#chart table').count()).toBe(0);\n      await openTable(page);\n      const t = await readTable(page);\n      const want = tableOf(type);\n      expect(t.name).toBe(want.caption);\n      // Ordered headers, then every row exactly and in order: a value under the wrong header is a failure.\n      expect(compareTable(t, want)).toEqual([]);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    it(`A4 ${type}: the table sits in a focusable scroll region named by its caption, no taller than the plot, and opening it does not move another chart on the page`, async () => {\n      const page = await devPage({ css: '#second { width: 720px; height: 400px; }' });\n      await page.evaluate(() => {\n        const el = document.createElement('div');\n        el.id = 'second';\n        document.querySelector('#after')!.after(el);\n      });\n      await create(page, type);\n      await create(page, type, {}, '#second');\n      const plotHeight = (await box(page, '#chart .axylo-plot')).height;\n      const before = await box(page, '#second figure');\n      await openTable(page);\n      const after = await box(page, '#second figure');\n      expect(after).toEqual(before);\n      const region = (await axWithin(page, '#chart')).find(n => n.role === 'region');\n      expect(region?.name).toBe(tableOf(type).caption);\n      expect(region?.props.focusable).toBe(true);\n      const scroll = await box(page, '#chart .axylo-table-scroll');\n      expect(scroll.height).toBeLessThanOrEqual(plotHeight + 0.5);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\n/** 250 rows per type, so the table has three pages of at most 100. Row k (0-based) has x as `rowHeader(k)`. */\nfunction longData(type: Full): { fn: string; options: Record<string, unknown>; rowHeader(k: number): string; jumpText(k: number): string } {\n  const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n  const cat = (k: number) => `C${String(k + 1).padStart(3, '0')}`;\n  switch (type) {\n    case 'line':\n    case 'area':\n      return {\n        fn: type, options: { title: 'Long', data: Array.from({ length: 250 }, (_, k) => ({ day: day(k), v: k })), x: { field: 'day', type: 'date' }, y: 'v' },\n        rowHeader: k => calendar(day(k)), jumpText: k => calendar(day(k)),\n      };\n    case 'bar':\n      return {\n        fn: 'bar', options: { title: 'Long', data: Array.from({ length: 250 }, (_, k) => ({ c: cat(k), v: k + 1 })), x: 'c', y: 'v' },\n        rowHeader: cat, jumpText: cat,\n      };\n    case 'scatter':\n      return {\n        fn: 'scatter', options: { title: 'Long', data: Array.from({ length: 250 }, (_, k) => ({ x: k + 1, y: (k * 7) % 50 })), x: 'x', y: 'y' },\n        rowHeader: k => String(k + 1), jumpText: k => String(k + 1),\n      };\n    case 'donut':\n      return {\n        fn: 'donut', options: { title: 'Long', data: Array.from({ length: 250 }, (_, k) => ({ c: cat(k), v: 250 - k })), label: 'c', value: 'v' },\n        rowHeader: cat, jumpText: cat,\n      };\n  }\n}\n\ndescribe('A4 table on a 24-chart page', () => {\n  for (const type of FULL as Full[]) {\n    it(`A4 ${type}: on a page of 24 charts, opening one chart's table moves none of the other 23`, async () => {\n      const page = await devPage({ viewport: { width: 1400, height: 1000 }, css: '.tile { width: 340px; height: 200px; display: inline-block; vertical-align: top; }' });\n      await page.evaluate(() => {\n        for (let i = 0; i < 24; i++) { const el = document.createElement('div'); el.id = `tile-${i}`; el.className = 'tile'; document.body.appendChild(el); }\n      });\n      for (let i = 0; i < 24; i++) await create(page, type, { title: `Chart ${i + 1}` }, `#tile-${i}`);\n      const where = () => page.evaluate(() => Array.from({ length: 24 }, (_, i) => document.querySelector(`#tile-${i} figure`)!.getBoundingClientRect().toJSON()));\n      const before = await where();\n      await page.locator('#tile-5 [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n      await settle(page);\n      expect(await page.locator('#tile-5 table').count()).toBe(1);\n      const after = await where();\n      expect(after.filter((_, i) => i !== 5)).toEqual(before.filter((_, i) => i !== 5));\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\ndescribe('A4 paging and jumping', () => {\n  for (const type of FULL as Full[]) {\n    it(`A4 ${type}: 250 rows are shown 100 per page; Next and Previous page reach every row; jumping to an x value shows the page that holds it`, async () => {\n      const page = await devPage();\n      const d = longData(type);\n      await createRaw(page, d.fn, d.options);\n      await openTable(page);\n      let t = await readTable(page);\n      expect(t.rows.map(r => r.header)).toEqual(Array.from({ length: 100 }, (_, k) => d.rowHeader(k)));\n      const next = page.locator('#chart .axylo-pager button', { hasText: 'Next page' });\n      const previous = page.locator('#chart .axylo-pager button', { hasText: 'Previous page' });\n      await next.click();\n      t = await readTable(page);\n      expect(t.rows.map(r => r.header)).toEqual(Array.from({ length: 100 }, (_, k) => d.rowHeader(100 + k)));\n      await next.click();\n      t = await readTable(page);\n      expect(t.rows.map(r => r.header)).toEqual(Array.from({ length: 50 }, (_, k) => d.rowHeader(200 + k)));\n      await previous.click();\n      await previous.click();\n      t = await readTable(page);\n      expect(t.rows[0]!.header).toBe(d.rowHeader(0));\n      // Jump to row 230 by typing its x as the table shows it.\n      const field = page.locator('#chart .axylo-jump-field');\n      await field.click();\n      await page.keyboard.type(d.jumpText(229));\n      await page.keyboard.press('Enter');\n      await settle(page);\n      t = await readTable(page);\n      expect(t.rows.map(r => r.header)).toContain(d.rowHeader(229));\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    it(`A4 ${type}: a \"Jump to\" value that matches no row is identified, described in visible text and associated with the field (reading: WCAG 3.3.1 applies to the jump field)`, async () => {\n      const page = await devPage();\n      const d = longData(type);\n      await createRaw(page, d.fn, d.options);\n      await openTable(page);\n      const field = page.locator('#chart .axylo-jump-field');\n      await field.click();\n      await page.keyboard.type('no such value');\n      await page.keyboard.press('Enter');\n      await settle(page);\n      expect((await axWithin(page, '#chart')).find(n => n.role === 'textbox')?.props.invalid).toBe('true');\n      // The error is programmatically associated with the field: Chrome's computed description of the\n      // textbox (aria-describedby or aria-errormessage) carries it, and that text is visible on the page.\n      const field2 = await axOf(page, '#chart .axylo-jump-field');\n      expect(field2.description, 'computed description of the jump field').toMatch(/no such value|no row/i);\n      const visible = await page.evaluate(() => {\n        const f = document.querySelector('#chart .axylo-jump-field') as HTMLInputElement;\n        const ids = `${f.getAttribute('aria-describedby') ?? ''} ${f.getAttribute('aria-errormessage') ?? ''}`.split(/\\s+/).filter(Boolean);\n        return ids.map(id => document.getElementById(id)).filter((e): e is HTMLElement => !!e && e.offsetParent !== null && e.getBoundingClientRect().width > 0).map(e => e.textContent ?? '').join(' ');\n      });\n      expect(visible, 'visible error text').toMatch(/no such value|no row/i);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\ndescribe('A4 current range', () => {\n  for (const type of ['line', 'area', 'scatter'] as const) {\n    it(`A4 ${type}: zoomed in, the table covers the current x range only, row by row`, async () => {\n      const page = await devPage();\n      await create(page, type);\n      const range = type === 'scatter' ? [12, 30] : ['2026-03-03', '2026-03-05'];\n      await call(page, 'zoom', [range]);\n      await openTable(page);\n      const all = tableOf(type);\n      const want = type === 'scatter' ? all.rows.filter((_, i) => LATENCY_ORDER[i]!.size >= 12 && LATENCY_ORDER[i]!.size <= 30) : all.rows.slice(1, 4);\n      expect(compareTable(await readTable(page), { headers: all.headers, rows: want })).toEqual([]);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  for (const axis of ['date', 'number'] as const) {\n    it(`A4 bar: on a ${axis} x axis, zoomed in, the table covers the current x range only, row by row`, async () => {\n      const page = await devPage();\n      const xs = axis === 'date' ? ['2026-03-01', '2026-03-02', '2026-03-03', '2026-03-04', '2026-03-05', '2026-03-06'] : [1, 2, 3, 4, 5, 6];\n      const values = [11, 22, 33, 44, 55, 66];\n      await createRaw(page, 'bar', { title: 'Zoomable bars', data: xs.map((x, i) => ({ x, v: values[i] })), x: axis === 'date' ? { field: 'x', type: 'date' } : { field: 'x', type: 'number' }, y: 'v' });\n      await call(page, 'zoom', [axis === 'date' ? ['2026-03-02', '2026-03-04'] : [2, 4]]);\n      await openTable(page);\n      const label = (i: number) => (axis === 'date' ? calendar(xs[i] as string) : String(xs[i]));\n      expect(compareTable(await readTable(page), { headers: [['x'], ['v']], rows: [1, 2, 3].map(i => [label(i), String(values[i])]) })).toEqual([]);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('A4 line: a value near row 900,000 of a 1,000,000-row typed-column chart is reachable by jumping to its x', async () => {\n    const page = await devPage();\n    await page.evaluate(async () => {\n      const n = 1_000_000;\n      const x = new Float64Array(n);\n      const y = new Float64Array(n);\n      for (let i = 0; i < n; i++) { x[i] = i; y[i] = (i % 1000) + 0.25; }\n      const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => { __bench: { ready(): Promise<void> } }>; charts: unknown[] };\n      const chart = w.Axylo.line!('#chart', { title: 'A million', data: { columns: { x, y } }, x: 'x', y: 'y' });\n      w.charts.push(chart);\n      await chart.__bench.ready();\n    });\n    await openTable(page);\n    const field = page.locator('#chart .axylo-jump-field');\n    await field.click();\n    await page.keyboard.type('900,123');\n    await page.keyboard.press('Enter');\n    await settle(page);\n    const t = await readTable(page);\n    const row = t.rows.find(r => r.header === '900,123');\n    expect(row?.cells).toEqual(['123.25']);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/acceptance/reader-model.test.ts'","aggregated_output":"import { expect, it } from 'vitest';\nimport { stepAcross, targetOf } from '../../src/core/focus';\nimport { at, axes, chart, codes, committed, compactKinds, defaultMessages, message, lastModel, marks, pixel, plot, points, reading, refAt, rows, scene, seriesRows, types, walk, type Type } from './model';\n\nconst fixture = (type: Type) => type === 'donut' ? [{ x: 'A', y: 2 }, { x: 'B', y: 6 }] : [{ x: 1, y: 2 }, { x: 2, y: 6 }];\nconst full = ['line', 'area', 'bar', 'scatter', 'donut'] as const;\n\nfor (const type of types) {\n  it(`A1 ${type}: model preserves the author’s heading, uses an existing label when given and adds the description to the data summary`, () => {\n    for (const kind of compactKinds(type)) {\n      const r = chart(type, fixture(type), { title: { text: 'Sales', level: 4, visible: false }, description: 'From the ledger.' }, undefined, kind);\n      r.frames();\n      expect(lastModel(r)).toMatchObject({ name: 'Sales', title: { text: 'Sales', level: 4, visible: false } });\n      expect(lastModel(r).summary).toContain(type === 'donut' ? message('donutSummary', { type: defaultMessages.typeDonut, count: 2, total: 8 }) : message('seriesSummary', { series: 'y', min: 2, max: 6, last: 6 }));\n      expect(lastModel(r).summary).toContain('From the ledger.');\n      r.ids['card-heading'] = 'Card heading';\n      r.controller.handle.update({ labelledBy: 'card-heading' });\n      r.frames();\n      expect(lastModel(r)).toMatchObject({ labelledBy: 'card-heading', title: null });\n      expect(codes(r)).toEqual([]);\n    }\n  });\n\n  it(`L7 ${type}: loading, empty and error draw no data marks and each state change is announced once`, () => {\n    for (const kind of compactKinds(type)) {\n      const data = fixture(type);\n      const r = chart(type, data, {}, undefined, kind);\n      r.frames();\n      const handle = r.controller.handle;\n      for (const [patch, message] of [\n        [{ state: 'loading' }, defaultMessages.loading],\n        [{ state: 'ready', data: [] }, defaultMessages.empty],\n        [{ state: { error: 'Query failed.' } }, 'Query failed.'],\n      ] as const) {\n        handle.update(patch);\n        r.frames();\n        expect(lastModel(r).message).toBe(message);\n        expect(scene(r).marks).toEqual([]);\n        expect(r.texts.at(-1)).toEqual([]);\n        handle.update({ description: 'State stays the same.' });\n        r.frames();\n        expect(r.announcements.filter(text => text === message)).toEqual([message]);\n      }\n      handle.update({ state: 'ready', data });\n      r.frames();\n      expect(lastModel(r).message).toBeNull();\n      expect(r.announcements).toEqual([defaultMessages.loading, defaultMessages.empty, 'Query failed.', 'Measurements']);\n    }\n  });\n\n  it(`L4 ${type}: a new scheme from the host repaints the committed scene within one frame`, () => {\n    for (const kind of compactKinds(type)) {\n      const r = chart(type, fixture(type), {}, undefined, kind);\n      const resolve = r.host.theme;\n      let scheme: 'light' | 'dark' = 'light';\n      r.host.theme = (keys, colors) => {\n        const result = resolve(keys, colors);\n        return { ...result, theme: { ...result.theme, scheme } };\n      };\n      r.frames();\n      expect(committed(r).theme.scheme).toBe('light');\n      const first = scene(r);\n      const draws = r.draws.length;\n      scheme = 'dark';\n      r.controller.invalidate.theme();\n      expect(r.frames()).toBeLessThanOrEqual(1);\n      expect(committed(r).theme.scheme).toBe('dark');\n      expect(r.draws).toHaveLength(draws + 1);\n      expect(scene(r)).toEqual(first);\n    }\n  });\n\n  it(`I5 ${type}: the first model frame has final geometry and an update commits without intervening model frames`, () => {\n    for (const kind of compactKinds(type)) {\n      const r = chart(type, fixture(type), {}, undefined, kind);\n      expect(r.draws).toEqual([]);\n      expect(r.frames()).toBe(1);\n      expect(r.draws).toHaveLength(1);\n      const first = scene(r);\n      r.controller.handle.update({ data: fixture(type).map(row => ({ ...row, y: row.y + 3 })) });\n      expect(scene(r)).toBe(first);\n      expect(r.frames()).toBe(1);\n      expect(r.draws).toHaveLength(2);\n      expect(lastModel(r).summary).toContain(type === 'donut' ? message('donutSummary', { type: defaultMessages.typeDonut, count: 2, total: 14 }) : message('seriesSummary', { series: 'y', min: 5, max: 9, last: 9 }));\n      expect(r.frames()).toBe(0);\n      expect(r.draws).toHaveLength(2);\n    }\n  });\n\n  it(`A10 ${type}: author messages replace the model’s generated name and warning and keep built-in state text tagged English`, () => {\n    for (const kind of compactKinds(type)) {\n      const r = chart(type, [{ x: type === 'donut' ? 'A' : 1, y: 5 }, { x: type === 'donut' ? 'B' : 2, y: Infinity }], {\n        title: undefined, messages: { chartName: 'Diagramm {x}', valuesNotShown: 'Ausgelassen: {count}.' },\n      }, undefined, kind);\n      r.host.pageLang = () => 'de';\n      r.frames();\n      expect(lastModel(r).name).toBe(type === 'donut' ? 'Diagramm Category' : 'Diagramm x');\n      expect(lastModel(r).note).toBe('Ausgelassen: 1.');\n      expect(lastModel(r).noteLang).toBeNull();\n      expect(lastModel(r).summary).toContain('Ausgelassen: 1.');\n      r.controller.handle.update({ state: 'loading' });\n      r.frames();\n      expect(lastModel(r)).toMatchObject({ message: defaultMessages.loading, messageLang: 'en' });\n    }\n  });\n}\n\nfor (const type of full) {\n  it(`A2 ${type}: the interaction model reaches every fixture datum and can go directly to either end`, () => {\n    const r = chart(type, fixture(type));\n    r.frames();\n    const refs = walk(r);\n    const { lookup } = committed(r);\n    expect(refs).toHaveLength(2);\n    expect(refs.map(ref => lookup.ordinal(ref))).toEqual([0, 1]);\n    expect(lookup.step(refs[0]!, 'last')).toEqual(refs[1]);\n    expect(lookup.step(refs[1]!, 'first')).toEqual(refs[0]);\n    expect(lookup.step(refs[0]!, 'previous')).toBeNull();\n    expect(lookup.step(refs[1]!, 'next')).toBeNull();\n  });\n\n  it(`A3 ${type}: the pure keyboard value text conveys identity, value with unit and position`, () => {\n    const key = type === 'donut' ? 'value' : 'y';\n    const r = chart(type, fixture(type), { [key]: { field: 'y', label: 'Mass', unit: 'kg' } });\n    r.frames();\n    const text = reading(r, walk(r)[1]!);\n    expect(text).toContain(type === 'donut' ? 'B' : '2');\n    if (type !== 'donut') expect(text).toContain('Mass');\n    expect(text).toContain('6 kg');\n    expect(text).toContain('Point 2 of 2');\n  });\n\n  it(`A4 ${type}: the lazy table uses the heading and units and reaches rows on the current range’s second page`, () => {\n    const data = Array.from({ length: type === 'donut' ? 120 : 141 }, (_, i) => ({ x: type === 'donut' ? 'Label ' + i : i, y: i + 1 }));\n    const opts = type === 'donut' ? { value: { field: 'y', label: 'Mass', unit: 'kg' } } : {\n      x: { field: 'x', label: 'Distance', unit: 'm' }, y: { field: 'y', label: 'Mass', unit: 'kg' },\n    };\n    const r = chart(type, data, opts);\n    if (type !== 'donut') r.controller.handle.zoom([20, 139]);\n    r.frames();\n    const table = committed(r).reader.table!;\n    expect(table.caption).toBe('Measurements');\n    expect(table.pageSize).toBe(100);\n    expect(table.rowCount).toBe(120);\n    expect(table.headers).toContain('Mass (kg)');\n    expect(table.pageForX(type === 'donut' ? 'Label 101' : 121)).toBe(1);\n    expect(table.row(101)?.[type === 'scatter' ? 2 : 1]).toBe(type === 'donut' ? '102 kg' : '122 kg');\n    expect(table.row(120)).toBeNull();\n    if (type !== 'donut') expect(table.headers[0]).toBe('Distance (m)');\n  });\n\n  it(`A7 ${type}: appended data is quiet and the lookup resolves a reader’s datum until it leaves the window`, () => {\n    const r = chart(type, fixture(type));\n    r.frames();\n    const first = walk(r)[0]!;\n    const donut = type === 'donut';\n    r.controller.handle.append([{ x: donut ? 'C' : 3, y: 9 }], { keep: 3 });\n    r.frames();\n    expect(committed(r).lookup.resolve(first)).toEqual(first);\n    expect(r.announcements).toEqual([]);\n    r.controller.handle.append([{ x: donut ? 'D' : 4, y: 11 }], { keep: 3 });\n    r.frames();\n    expect(committed(r).lookup.resolve(first)).not.toEqual(first);\n    expect(rows(r).map(row => row[0])).toEqual(donut ? ['B', 'C', 'D'] : ['2', '3', '4']);\n    expect(r.announcements).toEqual([]);\n  });\n\n  it(`I6 ${type}: the streaming model offers pause, buffers appends while paused, and commits them on resume`, () => {\n    const r = chart(type, fixture(type));\n    r.frames();\n    expect(committed(r).streaming).toBe(false);\n    const handle = r.controller.handle;\n    handle.append([{ x: type === 'donut' ? 'C' : 3, y: 9 }]);\n    r.frames();\n    expect(committed(r)).toMatchObject({ streaming: true, paused: false });\n    r.controller.actions.pause(true);\n    r.frames();\n    expect(committed(r).paused).toBe(true);\n    handle.append([{ x: type === 'donut' ? 'D' : 4, y: 11 }]);\n    r.frames();\n    expect(rows(r)).toHaveLength(3);\n    r.controller.actions.pause(false);\n    r.frames();\n    expect(committed(r).paused).toBe(false);\n    expect(rows(r)).toHaveLength(4);\n    expect(r.announcements).toEqual([]);\n  });\n\n  it(`L3 ${type}: a zero-sized plot draws when the host acquires room and follows measured resizes both ways`, () => {\n    const r = chart(type, fixture(type), {}, { container: { width: 0, height: 0 } });\n    r.frames();\n    expect(r.draws).toEqual([]);\n    for (const width of [720, 360, 720]) {\n      r.container = { width, height: 400 };\n      r.controller.invalidate.resize();\n      r.frames();\n      expect(plot(r).width).toBe(width);\n      expect(scene(r).width).toBe(width);\n      expect(lastModel(r).message).toBeNull();\n    }\n  });\n\n  it(`L8 ${type}: the undersized model keeps its title, summary and table while omitting marks`, () => {\n    for (const [width, height, captionLineHeight] of [[110, 400, 15], [600, 145, 30]] as const) {\n      const r = chart(type, fixture(type), {}, { container: { width, height }, captionLineHeight });\n      r.frames();\n      expect(codes(r)).toEqual(['AX142']);\n      expect(lastModel(r)).toMatchObject({ title: { text: 'Measurements' }, summaryVisible: true });\n      expect(lastModel(r).summary).toContain(type === 'donut' ? message('donutSummary', { type: defaultMessages.typeDonut, count: 2, total: 8 }) : message('seriesSummary', { series: 'y', min: 2, max: 6, last: 6 }));\n      expect(committed(r)).toMatchObject({ tooSmall: true, interactive: true });\n      expect(rows(r)).toHaveLength(2);\n      expect(scene(r).marks).toEqual([]);\n      expect(r.texts.at(-1)).toEqual([]);\n    }\n  });\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n  it(`L6 ${type}: numeric axis titles use labels and units, with title, subtitle and reference label in the model`, () => {\n    const r = chart(type, fixture(type), {\n      title: 'Measurements', subtitle: 'Field readings', x: { field: 'x', label: 'Distance', unit: 'm' }, y: { field: 'y', label: 'Mass', unit: 'kg' },\n      reference: [{ y: 5, label: 'Target' }],\n    });\n    r.frames();\n    const titles = r.texts.at(-1)?.filter(text => ['title-x', 'title-y', 'reference'].includes(text.role)).map(text => text.full);\n    expect(titles).toEqual(expect.arrayContaining(['Distance (m)', 'Mass (kg)', 'Target']));\n    expect(lastModel(r)).toMatchObject({ title: { text: 'Measurements' }, subtitle: 'Field readings' });\n  });\n\n  it(`I3 ${type}: touch is opt-in and disabling zoom hides controls (reading: the author can still call zoom explicitly)`, () => {\n    const r = chart(type, fixture(type), { zoom: 'touch' });\n    r.frames();\n    expect(committed(r).zoom).toBe('touch');\n    r.controller.handle.update({ zoom: false });\n    r.frames();\n    expect(committed(r)).toMatchObject({ zoom: false, zoomed: false });\n    expect(rows(r)).toHaveLength(2);\n    r.controller.handle.zoom([1, 1.5]);\n    r.frames();\n    expect(committed(r)).toMatchObject({ zoom: false, zoomed: true });\n    expect(rows(r)).toHaveLength(1);\n  });\n\n  it(`I2 ${type}: toggling a legend key removes that series from marks and picking and leaves its table column or rows`, () => {\n    const r = chart(type, seriesRows(2), { series: 's' });\n    r.frames();\n    const { lookup } = committed(r);\n    const first = walk(r)[0]!;\n    if (first.kind === 'slice') throw new Error('Expected a Cartesian series');\n    const label = lookup.datum(first)?.seriesLabel;\n    r.controller.actions.toggle(first.seriesKey);\n    r.frames();\n    const mark = type === 'bar' ? 'rects' : type === 'scatter' ? 'points' : 'path';\n    expect(marks(r, mark)).toHaveLength(1);\n    const next = committed(r).lookup;\n    if (type === 'scatter') {\n      expect(walk(r).map(ref => next.datum(ref)?.seriesLabel)).toEqual(['Series 1', 'Series 1']);\n      expect(rows(r).map(row => row[1])).toContain(label);\n    } else {\n      expect(at(r, 1).rows.map(row => row.seriesLabel)).toEqual(['Series 1']);\n      expect(committed(r).reader.table?.headers).toContain(label);\n    }\n  });\n}\n\nfor (const type of ['line', 'area', 'bar'] as const) {\n  it(`I1 ${type}: a pointer readout has eight rows, a remaining count and distinct missing text`, () => {\n    const r = chart(type, seriesRows(10).map(row => row.x === 1 && row.s === 'Series 2' ? { ...row, y: null } : row), { series: 's' });\n    r.frames();\n    const { x } = axes(r);\n    const { plot: box } = plot(r);\n    const { lookup } = committed(r);\n    const tooltip = lookup.tooltip(lookup.pick(pixel(x, 1), box.y + box.height / 2)!);\n    expect(tooltip.rows).toHaveLength(8);\n    expect(tooltip.count - tooltip.rows.length).toBe(2);\n    expect(tooltip.rows[2]?.value).toBe('No data');\n    const view = committed(r).view;\n    if (view.kind === 'scatter' || view.kind === 'donut') throw new Error('Expected an aligned view');\n    expect(stepAcross(view, null, 'first')).toBe(1);\n    expect(reading(r, refAt(r, 1))).toContain('Series 9 10');\n  });\n}\n\nfor (const type of ['scatter', 'donut'] as const) {\n  it(`I1 ${type}: picking a visible mark provides the same value as the keyboard tooltip model`, () => {\n    const r = chart(type, fixture(type));\n    r.frames();\n    const { lookup } = committed(r);\n    const first = walk(r)[0]!;\n    const mark = lookup.anchor(first)!;\n    const hit = lookup.pick(mark.x + mark.width / 2, mark.y + mark.height / 2)!;\n    expect(lookup.tooltip(hit).rows[0]?.value).toBe('2');\n    expect(lookup.tooltip(targetOf(first)).rows[0]?.value).toBe('2');\n  });\n}\n\nfor (const type of ['line', 'area'] as const) {\n  it(`L5 ${type}: sparse points all have markers and a dense stroke retains sparse marker cues (reading: A5 still requires sparse cues)`, () => {\n    const nearby = Array.from({ length: 8 }, (_, i) => {\n      const count = 53 + i;\n      const r = chart(type, Array.from({ length: count }, (_, x) => ({ x, y: 2 + x % 5 })));\n      r.frames();\n      return { r, count, spacing: pixel(axes(r).x, 1) - pixel(axes(r).x, 0) };\n    });\n    const above = nearby.filter(({ spacing }) => spacing >= 12).at(-1)!;\n    const below = nearby.find(({ spacing }) => spacing < 12)!;\n    expect(above.spacing).toBeLessThan(12.3);\n    expect(below.spacing).toBeGreaterThan(11.7);\n    expect(marks(above.r, 'points')[0]?.xy).toHaveLength(above.count * 2);\n    const markers = points(marks(below.r, 'points')[0]!.xy);\n    expect(markers.length).toBeGreaterThan(0);\n    expect(markers.at(-1)?.[0]).toBeCloseTo(pixel(axes(below.r).x, below.count - 1), 3);\n    for (let i = 1; i < markers.length; i++) expect(markers[i]![0] - markers[i - 1]![0]).toBeGreaterThan(12);\n  });\n}\n\nfor (const type of ['line', 'area'] as const) {\n  it(`A5 ${type}: two drawn series have different marker shapes and contrast dashes with their series bindings`, () => {\n    const r = chart(type, seriesRows(2), { series: 's' });\n    r.frames();\n    const [a, b] = marks(r, 'points');\n    expect(a?.shape).not.toBe(b?.shape);\n    expect(a?.fill).toEqual({ kind: 'series', index: 0 });\n    expect(b?.fill).toEqual({ kind: 'series', index: 1 });\n    const [first, second] = marks(r, 'path');\n    expect(first?.dash.contrast).not.toEqual(second?.dash.contrast);\n  });\n}\n\nit('A5 bar: adjacent stacked bars leave one pixel for the background while preserving the outer total', () => {\n  const r = chart('bar', [{ x: 'A', a: 3, b: 4 }], { y: ['a', 'b'], layout: 'stacked' });\n  r.frames();\n  const { y } = axes(r);\n  const [a, b] = marks(r, 'rects');\n  const innerEdge = b!.xywh[1]! + b!.xywh[3]!;\n  expect(a!.xywh[1]! - innerEdge).toBeCloseTo(1, 3);\n  expect(b!.xywh[1]).toBeCloseTo(y.map(7), 3);\n});\n\nit('A5 donut: adjacent slices carry a background separator in the scene handed to the renderer', () => {\n  const r = chart('donut', fixture('donut'));\n  r.frames();\n  const arc = marks(r, 'arcs')[0]!;\n  expect(arc.angles).toHaveLength(4);\n  expect(arc.gap).toBeGreaterThanOrEqual(1);\n});\n\nit('A5 scatter: separate series have distinct marker shapes as well as paint bindings', () => {\n  const r = chart('scatter', seriesRows(2), { series: 's' });\n  r.frames();\n  const [a, b] = marks(r, 'points');\n  expect(a?.shape).not.toBe(b?.shape);\n  expect(a?.fill).toEqual({ kind: 'series', index: 0 });\n  expect(b?.fill).toEqual({ kind: 'series', index: 1 });\n});\n\nit('A5 compact: when there is no legend two series remain distinguishable by dash with their paint bindings', () => {\n  const r = chart('compact', seriesRows(2), { series: 's' });\n  r.frames();\n  const [a, b] = marks(r, 'path');\n  expect(a?.dash.normal).not.toEqual(b?.dash.normal);\n  expect(a?.stroke).toEqual({ kind: 'series', index: 0 });\n  expect(b?.stroke).toEqual({ kind: 'series', index: 1 });\n});\n\nit('L6 donut: title and subtitle are part of the figure model without Cartesian axis titles', () => {\n  const r = chart('donut', fixture('donut'), { title: 'Parts', subtitle: 'Field readings' });\n  r.frames();\n  expect(lastModel(r)).toMatchObject({ title: { text: 'Parts' }, subtitle: 'Field readings' });\n  expect(r.texts.at(-1)?.filter(text => text.role === 'title-x' || text.role === 'title-y')).toEqual([]);\n});\n\nfor (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n  it(`L1 ${type}: measured plot labels fit inside the modeled canvas without intersecting at three widths`, () => {\n    const data = [{ x: 1, y: 24 }, { x: 2, y: 32 }, { x: 3, y: 48 }];\n    for (const width of [240, 720, 1920]) {\n      const r = chart(type, data, {}, { container: { width, height: 400 } });\n      r.frames();\n      const layout = plot(r);\n      if (layout.kind !== 'plot') throw new Error('Expected labeled plot');\n      const labels = r.texts.at(-1)!;\n      expect(labels.some(label => label.role === 'tick-x')).toBe(true);\n      expect(labels.some(label => label.role === 'tick-y')).toBe(true);\n      for (const [i, { box }] of labels.entries()) {\n        expect(box.x).toBeGreaterThanOrEqual(-1);\n        expect(box.y).toBeGreaterThanOrEqual(-1);\n        expect(box.x + box.width).toBeLessThanOrEqual(layout.width + 1);\n        expect(box.y + box.height).toBeLessThanOrEqual(layout.height + 1);\n        for (const { box: next } of labels.slice(i + 1)) {\n          const width = Math.min(box.x + box.width, next.x + next.width) - Math.max(box.x, next.x);\n          const height = Math.min(box.y + box.height, next.y + next.height) - Math.max(box.y, next.y);\n          expect(width <= 1 || height <= 1).toBe(true);\n        }\n      }\n    }\n  });\n}\n\nit('A7 compact: appends update the static summary quietly in line, area and bar', () => {\n  for (const kind of compactKinds('compact')) {\n    const r = chart('compact', fixture('compact'), {}, undefined, kind);\n    r.frames();\n    r.controller.handle.append([{ x: 3, y: 17 }]);\n    r.frames();\n    expect(lastModel(r).summary).toContain(message('seriesSummary', { series: 'y', min: 2, max: 17, last: 17 }));\n    expect(r.announcements).toEqual([]);\n  }\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_43","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/acceptance/f-dense.test.ts'","aggregated_output":"import fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { at, axes, chart, codes, committed, date, expectCompact, lastModel, marks, message, plot, pathRuns, points, reading, refAt, rows } from './model';\n\ntype Sample = number | null;\n\nfunction observedRuns(values: readonly Sample[]) {\n  const result: number[][] = [];\n  let run: number[] = [];\n  values.forEach((value, index) => {\n    if (value !== null) run.push(index);\n    else if (run.length) {\n      result.push(run);\n      run = [];\n    }\n  });\n  if (run.length) result.push(run);\n  return result;\n}\n\nfunction extrema(indexes: readonly number[], column: (i: number) => number, values: readonly Sample[]) {\n  const result = new Map<number, [number, number]>();\n  for (const i of indexes) {\n    const key = column(i);\n    const value = values[i]!;\n    const bounds = result.get(key);\n    result.set(key, bounds ? [Math.min(bounds[0], value), Math.max(bounds[1], value)] : [value, value]);\n  }\n  return [...result];\n}\n\nfunction checkExtrema(r: ReturnType<typeof chart>, xy: readonly [number, number][][], values: readonly Sample[], ratio: number, from = 0, to = values.length - 1) {\n  const { x, y } = axes(r);\n  if (x.type === 'band') throw new Error('Expected a numeric projection');\n  const column = (i: number) => Math.floor(x.map(i) * ratio);\n  const expectedRuns = observedRuns(values.slice(from, to + 1)).filter(run => run.length > 1).map(run => run.map(i => i + from));\n  expect(xy).toHaveLength(expectedRuns.length);\n  let largestError = 0;\n  xy.forEach((run, i) => {\n    const actual = run.map(([px, py]) => {\n      const index = Math.round(x.invert(px));\n      largestError = Math.max(largestError, Math.abs(py - y.map(values[index]!)));\n      return index;\n    }).filter(index => index >= from && index <= to);\n    expect(extrema(actual, column, values)).toEqual(extrema(expectedRuns[i]!, column, values));\n  });\n  expect(largestError).toBeLessThan(0.001);\n}\n\nconst denseSize = 6_001;\nconst denseHost = { container: { width: 200, height: 220 }, console: false };\ntype DensePattern = { background: number[]; start: number; shift: number; peak: number; dip: number };\nconst densePattern: fc.Arbitrary<DensePattern> = fc.record({\n  background: fc.array(fc.integer({ min: 4, max: 25 }), { minLength: 3, maxLength: 12 }),\n  start: fc.integer({ min: 1_000, max: 3_600 }),\n  shift: fc.integer({ min: 0, max: 8 }),\n  peak: fc.integer({ min: 51, max: 100 }),\n  dip: fc.integer({ min: 1, max: 3 }),\n});\n\nfunction denseValues({ background, start, shift, peak, dip }: DensePattern) {\n  const values: Sample[] = Array.from({ length: denseSize }, (_, i) => background[i % background.length]!);\n  const base = Float64Array.from({ length: denseSize }, (_, i) => 35 - values[i]!);\n  const clusters = Array.from({ length: 24 }, (_, i) => start + shift + i * 11 + i % 5);\n  for (const at of clusters) {\n    values[at] = dip;\n    values[at + 1] = peak;\n    values[at + 3] = null;\n    values[at + 4] = peak + 1;\n    values[at + 5] = dip;\n  }\n  return { values, base, clusters };\n}\n\nfunction checkDense(type: 'line' | 'area' | 'compact', kind: 'line' | 'area', pattern: DensePattern,\n  ratio: number, window: readonly [number, number], verifyReadout = false) {\n  const { values, base, clusters } = denseValues(pattern);\n  const stacked = kind === 'area';\n  const [from, to] = window;\n  const r = chart(type, { columns: {\n    x: Float64Array.from({ length: denseSize }, (_, i) => i),\n    y: Float64Array.from(values, value => value ?? NaN),\n    base,\n  } }, { x: { field: 'x', domain: type === 'compact' ? window : [0, denseSize - 1] }, y: stacked ? ['base', 'y'] : 'y', stacked: stacked || undefined }, denseHost, kind);\n  r.host.devicePixelRatio = () => ratio;\n  r.controller.invalidate.pixelRatio();\n  if (type !== 'compact') r.controller.handle.zoom(window);\n  r.frames();\n  expect(committed(r).pixelRatio).toBe(ratio);\n  const { x } = axes(r);\n  if (x.type === 'band') throw new Error('Expected continuous x');\n  const columns = Math.ceil((plot(r).plot.x + plot(r).plot.width) * ratio) - Math.floor(plot(r).plot.x * ratio);\n  const supplied = values.slice(from, to + 1).filter(value => value !== null).length;\n  expect(supplied).toBeGreaterThanOrEqual(10 * columns);\n  const stroke = marks(r, 'path').find(mark => mark.series === Number(stacked) && mark.stroke.kind === 'series')!;\n  const runs = pathRuns(stroke.xy);\n  expect(runs.reduce((count, run) => count + run.length, 0), 'the drawing must actually simplify').toBeLessThan(supplied);\n  const column = (slot: number) => Math.floor(x.map(slot) * ratio);\n  expect(clusters.some(i => column(i - 1) === column(i + 6))).toBe(true);\n  const upper = values.map((value, i) => (value ?? 0) + base[i]!);\n  checkExtrema(r, runs, stacked ? upper.map((value, i) => values[i] === null ? null : value) : values, ratio, from, to);\n  if (stacked) {\n    const band = marks(r, 'area').find(mark => mark.series === 1)!;\n    checkExtrema(r, [points(band.upper)], upper, ratio, from, to);\n    checkExtrema(r, [points(band.lower)], Array.from(base), ratio, from, to);\n  }\n  if (type === 'compact') expectCompact(r);\n  else {\n    expect(at(r, clusters[0]! + 3).rows.at(-1)?.value).toBe('No data');\n    expect(at(r, clusters[0]! + 1).rows.at(-1)?.value).toBe(String(pattern.peak));\n    if (verifyReadout) {\n      const kept = new Set(runs.flatMap(run => run.map(([px]) => Math.round(x.invert(px)))));\n      let dropped = from + 1;\n      while (kept.has(dropped)) dropped++;\n      expect(dropped).toBeLessThan(clusters[0]!);\n      const ref = { ...refAt(r, dropped), seriesKey: 'y' };\n      const previous = { ...refAt(r, dropped - 1), seriesKey: 'y' };\n      const { lookup } = committed(r);\n      expect(lookup.step(previous, 'next')).toEqual(ref);\n      expect(committed(r).reader.table?.row(dropped - from)?.at(-1)).toBe(String(values[dropped]));\n      expect(reading(r, ref, 'single')).toContain(String(values[dropped]));\n    }\n  }\n}\n\nconst windows = [[0, 6_000], [400, 5_800], [800, 6_000]] as const;\nfor (const [type, kind] of [['line', 'line'], ['area', 'area'], ['compact', 'line'], ['compact', 'area']] as const) {\n  it(`F5 ${type}: for every generated dense ${kind} dataset the drawing keeps each run’s column extrema and its breaks`, () => {\n    fc.assert(fc.property(densePattern, fc.constantFrom(1, 2), fc.constantFrom(...windows), (pattern, ratio, window) => {\n      checkDense(type, kind, pattern, ratio, window);\n    }), { numRuns: 1_000 });\n  }, 40_000);\n}\n\nfunction expectValuesAt(r: ReturnType<typeof chart>, index: number, expected: string, total: string | null) {\n  const tooltip = at(r, index);\n  expect(tooltip.rows.at(-1)?.value).toBe(expected);\n  expect(tooltip.total).toBe(total);\n  expect(committed(r).reader.table?.row(index)?.at(-1)).toBe(expected);\n  expect(reading(r, refAt(r, index))).toContain(expected);\n}\n\nit('F5 line: one outlier in one million stays drawn at DPR 1 and 2 and a dropped sample stays reachable by keyboard and table', () => {\n  const count = 1_000_000;\n  const outlier = 500_123;\n  const dip = 500_124;\n  const r = chart('line', { columns: {\n    x: Float64Array.from({ length: count }, (_, i) => i),\n    y: Float64Array.from({ length: count }, (_, i) => i === outlier ? 999 : i === dip ? -999 : 5),\n  } });\n  let ratio = 1;\n  r.host.devicePixelRatio = () => ratio;\n  r.frames();\n  for (const next of [1, 2]) {\n    ratio = next;\n    r.controller.invalidate.pixelRatio();\n    r.frames();\n    expect(committed(r).pixelRatio).toBe(next);\n    const { x, y } = axes(r);\n    if (x.type === 'band') throw new Error('Expected continuous x');\n    const vertices = points(marks(r, 'path')[0]!.xy);\n    const kept = new Set(vertices.map(([px]) => Math.round(x.invert(px))));\n    expect(vertices.length).toBeLessThan(4_000);\n    expect(kept.has(outlier)).toBe(true);\n    expect(kept.has(dip)).toBe(true);\n    expect(Math.min(...vertices.map(p => p[1]))).toBeCloseTo(y.map(999), 3);\n    expect(Math.max(...vertices.map(p => p[1]))).toBeCloseTo(y.map(-999), 3);\n    let dropped = 1;\n    while (kept.has(dropped)) dropped++;\n    const { lookup } = committed(r);\n    expect(lookup.step(refAt(r, dropped - 1), 'next')).toEqual(refAt(r, dropped));\n    expectValuesAt(r, dropped, '5', null);\n  }\n  expect(lastModel(r).summary).toContain(message('seriesSummary', { series: 'y', min: '-999', max: '999', last: '5' }));\n});\n\nit('F5 line: alternating null and valid slots produce isolated markers and no false segments', () => {\n  const r = chart('line', Array.from({ length: 800 }, (_, x) => ({ x, y: x % 2 === 0 ? 1 : null })));\n  r.frames();\n  expect(marks(r, 'path')).toEqual([]);\n  expect(marks(r, 'points')[0]?.xy).toHaveLength(800);\n  expect(at(r, 41).rows[0]?.value).toBe('No data');\n  expect(committed(r).reader.table?.row(41)?.[1]).toBe('No data');\n});\n\nit('F5 line: weekly observations connect across daily observations without inventing weekly rows', () => {\n  const data = Array.from({ length: 15 }, (_, i) => ({ x: date(i), y: 10, s: 'Daily' }));\n  data.push({ x: date(0), y: 2, s: 'Weekly' }, { x: date(7), y: 4, s: 'Weekly' }, { x: date(14), y: 3, s: 'Weekly' });\n  const r = chart('line', data, { x: { field: 'x', type: 'time' }, series: 's' });\n  r.frames();\n  const weekly = marks(r, 'path').find(mark => mark.series === 1)!;\n  expect(pathRuns(weekly.xy).map(run => run.length)).toEqual([3]);\n  expect(at(r, date(3)).rows.map(row => row.value)).toEqual(['10', 'No observation']);\n  expect(rows(r)[3]?.[2]).toBe('No observation');\n});\n\nfor (const type of ['line', 'area'] as const) {\n  it(`T-dense-${type} ${type}: two peaks and their gap survive at two zoom levels and two device-pixel ratios`, () => {\n    for (const window of windows) for (const ratio of [1, 2]) {\n      checkDense(type, type, { background: [18, 20, 18, 18], start: 1_300, shift: 3, peak: 67, dip: 2 }, ratio, window, true);\n    }\n  });\n}\n\nit('T-dense-bar bar: more bars than pixels raises AX132 and every rectangle is still drawn', () => {\n  const r = chart('bar', Array.from({ length: 375 }, (_, i) => ({ x: 'Band ' + i, y: 1 })), {}, { container: { width: 240, height: 240 } });\n  r.frames();\n  expect(codes(r)).toContain('AX132');\n  expect(marks(r, 'rects')[0]?.xywh).toHaveLength(375 * 4);\n  expect(committed(r).reader.table?.rowCount).toBe(375);\n});\n\nit('T-dense-donut donut: eight small positive slices retain all eight arcs', () => {\n  const r = chart('donut', Array.from({ length: 8 }, (_, i) => ({ x: 'Band ' + i, y: i === 0 ? 100_000 : 1 })));\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(16);\n  expect(committed(r).reader.table?.rowCount).toBe(8);\n});\n\nit('T-dense-scatter scatter: the hint starts above 50,000 points and none are simplified away', () => {\n  for (const length of [50_000, 50_001]) {\n    const r = chart('scatter', { columns: { x: Float64Array.from({ length }, (_, i) => i), y: new Float32Array(length).fill(4) } });\n    r.frames();\n    expect(codes(r)).toEqual(length > 50_000 ? ['AX133'] : []);\n    expect(marks(r, 'points')[0]?.xy).toHaveLength(length * 2);\n    expect(committed(r).reader.table?.rowCount).toBe(length);\n  }\n});\n\nit('F5 line: two peaks separated by a null in one device column remain in separate drawn runs', () => {\n  checkDense('line', 'line', { background: [5, 5, 5], start: 1_100, shift: 2, peak: 67, dip: 1 }, 1, windows[0]);\n});\n","exit_code":0,"status":"completed"}}
