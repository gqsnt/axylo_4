{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/browser/chart/data.browser.test.ts'","aggregated_output":"/**\n * Data the chart cannot draw as given (spec F3, F12, 3.5), states (L7) and calendar dates in three viewer\n * zones (F4). Expected codes come from the registry's statement for the combined dirty fixture.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport { start, stop, url } from '../harness';\nimport { aria, chartPage, closePage } from './util';\n\nbeforeAll(start);\nafterAll(stop);\n\ndescribe('dirty input (spec 3.5, F12)', () => {\n  for (const flavour of ['development', 'production'] as const) {\n    it(`the combined fixture yields AX102, AX103 and AX106 once each and shows the reader's note (${flavour} build)`, async () => {\n      const page = await chartPage();\n      if (flavour === 'production') await page.addScriptTag({ url: url('packages/axylo/dist/axylo.iife.min.js') });\n      const result = await page.evaluate(async () => {\n        const chart = window.Axylo.line!('#chart', { title: 'Dirty input', data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n        await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));\n        const note = document.querySelector('#chart .axylo-note') as HTMLElement;\n        return { codes: chart.diagnostics.map(d => d.code), note: note.hidden ? null : note.textContent, role: note.getAttribute('role') };\n      });\n      const warnings = result.codes.filter(c => ['AX102', 'AX103', 'AX106'].includes(c)).sort();\n      expect(warnings).toEqual(['AX102', 'AX103', 'AX106']);\n      expect(result.note).toBe('Values not shown: 3. See table.');\n      expect(result.role).toBe('status');\n      expect(await aria(page)).toMatch(/status: \"?Values not shown: 3\\. See table\\.\"?/);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('prints each warning once with console.warn', async () => {\n    const page = await chartPage();\n    const warned: string[] = [];\n    page.on('console', m => { if (m.type() === 'warning') warned.push(m.text().slice(0, 13)); });\n    await page.evaluate(async () => {\n      for (let i = 0; i < 3; i++) window.Axylo.line!(Object.assign(document.body.appendChild(document.createElement('div')), { style: 'width:300px' }), { title: `Dirty ${i}`, data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n      await window.nextFrames(2);\n    });\n    expect(warned.sort()).toEqual(['[axylo AX102]', '[axylo AX103]', '[axylo AX106]']);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('with strict: true the create call throws and leaves nothing in the target', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const target = document.getElementById('chart')!;\n      let error: { name: string; message: string; codes: string[] } | null = null;\n      try {\n        window.Axylo.line!(target, { title: 'Dirty input', strict: true, data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n      } catch (e) {\n        const err = e as Error & { diagnostics: { code: string }[] };\n        error = { name: err.name, message: err.message, codes: err.diagnostics.map(d => d.code) };\n      }\n      await window.nextFrames(2);\n      return { error, children: target.childElementCount, className: target.className, scheme: target.getAttribute('data-axylo-scheme') };\n    });\n    expect(result.error?.message).toMatch(/AX10[236]/);\n    expect(result.error?.codes.sort()).toEqual(['AX102', 'AX103', 'AX106']);\n    expect(result.children).toBe(0);\n    expect(result.className).toBe('');\n    expect(result.scheme).toBeNull();\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('formatters (spec F6, 3.5)', () => {\n  it('a custom formatter that throws falls back to the default, raises AX160 when found, and is never thrown', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', {\n        title: 'Formatter', strict: true, data: [{ d: 1, v: 10 }, { d: 2, v: 20 }, { d: 3, v: 30 }], x: 'd',\n        y: { field: 'v', tickFormat: () => { throw new Error('author bug'); } },\n      });\n      await chart.__bench.ready();\n      return { codes: chart.diagnostics.map(d => d.code), ticks: [...document.querySelectorAll('#chart .axylo-label[data-role=\"tick-y\"]')].map(e => e.textContent) };\n    });\n    expect(result.codes).toContain('AX160');\n    expect(result.ticks).toContain('20');\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('states (spec L7)', () => {\n  it('empty data shows the empty message inside the plot and no tick labels', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'Nothing yet', data: [], x: 'day', y: 'value' });\n      await chart.__bench.ready();\n      const message = document.querySelector('#chart .axylo-plot .axylo-message') as HTMLElement;\n      return { message: message.hidden ? null : message.textContent, labels: document.querySelectorAll('#chart .axylo-label').length, errors: chart.diagnostics.filter(d => d.level === 'error').length };\n    });\n    expect(result.message).toBe('No data to show.');\n    expect(result.labels).toBe(0);\n    expect(result.errors).toBe(0);\n    expect(await aria(page)).toContain('No data to show.');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it(\"state: 'loading' then update({ state: 'ready' }) is announced once\", async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'Sessions', state: 'loading', data: [], x: 'day', y: 'sessions', series: 'channel' });\n      await chart.__bench.ready();\n      const live = document.querySelector('#chart [aria-live=\"polite\"]')!;\n      const message = document.querySelector('#chart .axylo-message') as HTMLElement;\n      const loading = message.hidden ? null : message.textContent;\n      const said: string[] = [];\n      new MutationObserver(() => said.push(live.textContent ?? '')).observe(live, { childList: true, characterData: true, subtree: true });\n      chart.update({ state: 'ready', data: window.fx.trendRows() });\n      await chart.__bench.ready();\n      await window.nextFrames(3);\n      return { loading, said, after: message.hidden };\n    });\n    expect(result.loading).toBe('Loading chart.');\n    expect(result.said).toEqual(['Sessions']);\n    expect(result.after).toBe(true);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('an author error state and an internal failure both show their message inside the plot, in the accessibility tree', async () => {\n    const page = await chartPage({ css: '#other { width: 400px; }' });\n    const consoleErrors: string[] = [];\n    page.on('console', m => { if (m.type() === 'error') consoleErrors.push(m.text()); });\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'Sessions', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n      await chart.__bench.ready();\n      chart.__dev.fail('reader');\n      chart.update({ title: 'Sessions, renamed' });\n      await window.nextFrames(2);\n      const message = document.querySelector('#chart .axylo-message') as HTMLElement;\n      const internal = message.hidden ? null : message.textContent;\n      const labels = document.querySelectorAll('#chart .axylo-label').length;\n      const el = Object.assign(document.body.appendChild(document.createElement('div')), { id: 'other' });\n      const other = window.Axylo.line!(el, { title: 'Other', state: { error: 'The query failed.' }, data: [], x: 'day', y: 'v' });\n      await other.__bench.ready();\n      return { internal, labels, authored: el.querySelector('.axylo-message')!.textContent };\n    });\n    expect(result.internal).toBe('Something went wrong while drawing the chart.');\n    expect(result.labels).toBe(0);\n    expect(result.authored).toBe('The query failed.');\n    expect(await aria(page)).toContain('Something went wrong while drawing the chart.');\n    expect(await aria(page, '#other')).toContain('The query failed.');\n    expect(consoleErrors.some(t => t.includes('internal error'))).toBe(true);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('calendar dates in three viewer zones (spec F4 a)', () => {\n  it('the dates fixture as date strings gives identical tick text in UTC, America/Los_Angeles and Asia/Kolkata', async () => {\n    const texts: string[][] = [];\n    for (const timezoneId of ['UTC', 'America/Los_Angeles', 'Asia/Kolkata']) {\n      const page = await chartPage({ timezoneId });\n      texts.push(await page.evaluate(async () => {\n        const chart = window.Axylo.line!('#chart', { title: 'Daily sessions by channel', data: window.fx.datesRows(), x: 'day', y: 'sessions', series: 'channel' });\n        await chart.__bench.ready();\n        return [...document.querySelectorAll('#chart .axylo-label[data-role=\"tick-x\"]')].map(e => e.textContent ?? '');\n      }));\n      expect(await closePage(page)).toEqual([]);\n    }\n    expect(texts[0]!.length).toBeGreaterThan(2);\n    expect(texts[0]![0]).toMatch(/Jan/);\n    expect(texts[1]).toEqual(texts[0]);\n    expect(texts[2]).toEqual(texts[0]);\n  });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/acceptance/f-time.test.ts'","aggregated_output":"import fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { at, axes, chart, codes, committed, compactKinds, message, expectCompact, lastModel, marks, pixel, points, reading, rows, walk, type Type } from './model';\n\nconst zones = ['UTC', 'America/Los_Angeles', 'Asia/Kolkata'] as const;\nconst instant = Date.UTC(2024, 1, 29);\nconst following = Date.UTC(2024, 2, 1);\nconst dates = ['2024-02-29', '2024-03-01'];\nconst instants = [\n  ['Feb 29, 2024, 12:00 AM UTC', 'Mar 1, 2024, 12:00 AM UTC'],\n  ['Feb 28, 2024, 4:00 PM PST', 'Feb 29, 2024, 4:00 PM PST'],\n  ['Feb 29, 2024, 5:30 AM GMT+5:30', 'Mar 1, 2024, 5:30 AM GMT+5:30'],\n] as const;\n\nfunction check(r: ReturnType<typeof chart>, type: Type, kind: 'line' | 'area' | 'bar', positions: readonly number[], text: readonly string[]) {\n  const x = axes(r).x;\n  expect(x.type).toBe('time');\n  const pixels = positions.map(value => pixel(x, value));\n  const actual = (type === 'compact' ? kind : type) === 'bar'\n    ? [0, 4].map(i => marks(r, 'rects')[0]!.xywh[i]! + marks(r, 'rects')[0]!.xywh[i + 2]! / 2)\n    : points(type === 'scatter' ? marks(r, 'points')[0]!.xy : marks(r, 'path')[0]!.xy).map(p => p[0]);\n  expect(actual).toHaveLength(pixels.length);\n  pixels.forEach((expected, i) => expect(actual[i]).toBeCloseTo(expected, 3));\n  text.forEach(heading => expect(lastModel(r).summary).toContain(heading));\n  expect(lastModel(r).note).toBeNull();\n  if (type === 'compact') expectCompact(r);\n  else {\n    expect(rows(r).map(row => row[0]?.replaceAll('\\u202f', ' '))).toEqual(text);\n    const { lookup } = committed(r);\n    walk(r).forEach((ref, i) => {\n      const heading = type === 'scatter'\n        ? lookup.tooltip({ kind: 'point', refs: [ref], count: 1 }).title\n        : at(r, positions[i]!).title;\n      expect(heading.replaceAll('\\u202f', ' ')).toBe(text[i]);\n      expect(reading(r, ref)?.replaceAll('\\u202f', ' ')).toContain(text[i]);\n    });\n  }\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F4 ${type}: calendar days, months and years keep their input precision across time zones (reading: month and year inputs keep their granularity)`, () => {\n    for (const kind of compactKinds(type)) {\n      for (const timeZone of zones) {\n        for (const [values, expected, positions] of [\n          [dates, ['Feb 29, 2024', 'Mar 1, 2024'], [instant, following]],\n          [['2024-02', '2024-03'], ['Feb 2024', 'Mar 2024'], [Date.UTC(2024, 1, 1), Date.UTC(2024, 2, 1)]],\n          [['2024', '2025'], ['2024', '2025'], [Date.UTC(2024, 0, 1), Date.UTC(2025, 0, 1)]],\n        ] as const) {\n          const r = chart(type, values.map((x, i) => ({ x, y: i + 2 })), {}, { timeZone }, kind);\n          r.frames();\n          check(r, type, kind, positions, expected);\n          expect(codes(r)).toEqual([]);\n          expect(lastModel(r).summary).not.toContain(timeZone);\n        }\n      }\n    }\n  });\n\n  for (const form of ['ISO with offset', 'Date objects', 'declared epoch milliseconds'] as const) {\n    it(`F4 ${type}: ${form} read in three local times, name the zone and raise AX111 for whole days (reading: Intl zone aliases name the same zone)`, () => {\n      for (const kind of compactKinds(type)) {\n        const values = form === 'ISO with offset' ? ['2024-02-29T05:30:00+05:30', '2024-03-01T00:00:00Z']\n          : form === 'Date objects' ? [new Date(instant), new Date(following)] : [instant, following];\n        zones.forEach((timeZone, i) => {\n          for (const explicit of [false, true]) {\n            const r = chart(type, values.map((x, i) => ({ x, y: i + 2 })), {\n              x: { field: 'x', timeZone: explicit ? 'UTC' : undefined, type: form === 'declared epoch milliseconds' ? 'time' : undefined },\n            }, { container: { width: 1600, height: 400 }, timeZone }, kind);\n            r.frames();\n            expect(codes(r)).toEqual(['AX111']);\n            check(r, type, kind, [instant, following], instants[explicit ? 0 : i]!);\n            const zone = explicit ? 'UTC' : new Intl.DateTimeFormat('en-US', { timeZone }).resolvedOptions().timeZone;\n            expect(lastModel(r).summary).toContain(message('timeZoneNote', { zone }));\n          }\n        });\n      }\n    });\n  }\n\n  it(`F4 ${type}: DST spring skips an hour and fall repeats it with distinct zone abbreviations`, () => {\n    for (const kind of compactKinds(type)) {\n      for (const [a, b, expected] of [\n        [Date.UTC(2024, 2, 10, 9, 30), Date.UTC(2024, 2, 10, 10, 30), ['Mar 10, 2024, 1:30 AM PST', 'Mar 10, 2024, 3:30 AM PDT']],\n        [Date.UTC(2024, 10, 3, 8, 30), Date.UTC(2024, 10, 3, 9, 30), ['Nov 3, 2024, 1:30 AM PDT', 'Nov 3, 2024, 1:30 AM PST']],\n      ] as const) {\n        const r = chart(type, [{ x: a, y: 3 }, { x: b, y: 4 }], { x: { field: 'x', type: 'time', timeZone: zones[1] } }, undefined, kind);\n        r.frames();\n        check(r, type, kind, [a, b], expected);\n      }\n    }\n  });\n\n  it(`F4 ${type}: wall-clock input stays as written through a DST transition and raises AX112`, () => {\n    for (const kind of compactKinds(type)) {\n      const a = Date.UTC(2024, 2, 10, 2, 30);\n      const b = Date.UTC(2024, 2, 10, 3, 30);\n      const r = chart(type, [{ x: '2024-03-10T02:30', y: 3 }, { x: '2024-03-10T03:30', y: 4 }], { x: { field: 'x', timeZone: zones[1] } }, undefined, kind);\n      r.frames();\n      expect(codes(r)).toEqual(['AX112']);\n      check(r, type, kind, [a, b], ['Mar 10, 2024, 2:30 AM', 'Mar 10, 2024, 3:30 AM']);\n      expect(lastModel(r).summary).not.toContain(zones[1]);\n    }\n  });\n\n  it(`F4 ${type}: an impossible date is omitted, and bare epoch-like numbers remain numbers`, () => {\n    for (const kind of compactKinds(type)) {\n      const bad = chart(type, [{ x: dates[0], y: 3 }, { x: '2024-02-30', y: 99 }, { x: dates[1], y: 4 }], { x: { field: 'x', type: 'date' } }, undefined, kind);\n      bad.frames();\n      expect(codes(bad)).toEqual(['AX107']);\n      expect(lastModel(bad).summary).toContain(message('seriesSummary', { series: 'y', min: 3, max: 4, last: 4 }));\n      expect(lastModel(bad).summary).toContain('Values not shown: 1.');\n      if (type !== 'compact') expect(rows(bad).map(row => row[0])).toEqual(['Feb 29, 2024', 'Mar 1, 2024']);\n      const bare = chart(type, [{ x: instant, y: 3 }, { x: following, y: 4 }], {}, undefined, kind);\n      bare.frames();\n      expect(codes(bare)).toEqual(['AX109']);\n      expect(axes(bare).x.type).toBe('linear');\n      expect(lastModel(bare).summary).toContain('1,709,164,800,000');\n      if (type !== 'compact') expect(rows(bare)[0]?.[0]).toBe('1,709,164,800,000');\n    }\n  });\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F4 ${type}: declaring an instant column as date keeps its UTC calendar dates in every zone`, () => {\n    for (const kind of compactKinds(type)) {\n      for (const timeZone of zones) {\n        const r = chart(type, [\n          { x: new Date(instant), y: 3 }, { x: following, y: 4 },\n        ], { x: { field: 'x', type: 'date' } }, { timeZone }, kind);\n        r.frames();\n        expect(codes(r)).toEqual([]);\n        check(r, type, kind, [instant, following], ['Feb 29, 2024', 'Mar 1, 2024']);\n      }\n    }\n  });\n\n  it(`F4 ${type}: mixing calendar dates with a wall time and an instant reports both incompatible rows (reading: a clear majority fixes the axis type)`, () => {\n    for (const kind of compactKinds(type)) {\n      const r = chart(type, [\n        { x: '2024-02-29', y: 3 }, { x: '2024-03-01T02:30', y: 40 },\n        { x: '2024-02-29T16:00Z', y: 50 }, { x: '2024-03-01', y: 4 }, { x: '2024-03-02', y: 4 },\n      ], {}, undefined, kind);\n      r.frames();\n      expect(r.controller.handle.diagnostics).toMatchObject([{ code: 'AX107', field: 'x', rows: [1, 2] }]);\n      expect(lastModel(r).summary).toContain(message('seriesSummary', { series: 'y', min: 3, max: 4, last: 4 }));\n      expect(lastModel(r).summary).toContain('Values not shown: 2.');\n      if (type !== 'compact') expect(rows(r).map(row => row[0])).toEqual(['Feb 29, 2024', 'Mar 1, 2024', 'Mar 2, 2024']);\n    }\n  });\n}\n\nit('F4 line: generated instants around DST and the year boundary preserve elapsed time and local readouts', () => {\n  const boundaries = [\n    { at: Date.UTC(2024, 2, 10, 10), before: 'Mar 10, 2024, 1', after: 'Mar 10, 2024, 3', firstZone: 'PST', lastZone: 'PDT', meridiem: 'AM' },\n    { at: Date.UTC(2024, 10, 3, 9), before: 'Nov 3, 2024, 1', after: 'Nov 3, 2024, 1', firstZone: 'PDT', lastZone: 'PST', meridiem: 'AM' },\n    { at: Date.UTC(2025, 0, 1, 8), before: 'Dec 31, 2024, 11', after: 'Jan 1, 2025, 12', firstZone: 'PST', lastZone: 'PST', meridiem: 'PM' },\n  ] as const;\n  fc.assert(fc.property(fc.constantFrom(...boundaries), fc.integer({ min: 1, max: 59 }), fc.integer({ min: 0, max: 59 }), (boundary, earlier, later) => {\n    const a = boundary.at - earlier * 60_000;\n    const b = boundary.at + later * 60_000;\n    const r = chart('line', [{ x: new Date(b), y: 4 }, { x: new Date(a), y: 3 }], {}, { timeZone: zones[1] });\n    r.frames();\n    const min = (minutes: number) => String(minutes).padStart(2, '0');\n    check(r, 'line', 'line', [a, b], [\n      `${boundary.before}:${min(60 - earlier)} ${boundary.meridiem} ${boundary.firstZone}`,\n      `${boundary.after}:${min(later)} AM ${boundary.lastZone}`,\n    ]);\n  }), { numRuns: 1_000 });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc 'git show d9fa4b0:packages/axylo/test/browser/acceptance/a1-names.browser.test.ts'","aggregated_output":"/**\n * A1: every chart has an accessible name and a generated summary; ids are unique per chart (spec 3.4).\n * Read from Chrome's accessibility tree: the figure's computed role, name and description.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport { start, stop } from '../harness';\nimport { axe } from '../a11y/util';\nimport { axOf, axWithin, closePage, create, devPage, prodPage } from './util';\nimport { missingClauses, sentences, summaryClauses, TYPES, TYPE_WORD, withUnit, ZONE_NAMES, type ChartType, type Clause } from './fixtures';\n\nbeforeAll(start);\nafterAll(stop);\n\nconst FIGURE = '#chart figure';\n/** The x label the generated-name test gives, and the measure each fixture plots. */\nconst X_LABEL: Record<ChartType, string | null> = { line: 'Day', area: 'Day', compact: 'Day', bar: 'Quarter', scatter: 'Payload', donut: null };\nconst MEASURE: Record<ChartType, string> = { line: 'Energy', area: 'Energy', compact: 'Energy', bar: 'Shipped', scatter: 'Latency', donut: 'Spend' };\n\nfunction untitled(type: ChartType): Record<string, unknown> {\n  // `title: undefined` returns the option to its default (no title); the x field gets a label to name.\n  const x = X_LABEL[type];\n  const extra: Record<string, unknown> = { title: undefined };\n  if (x && type === 'bar') extra.x = { field: 'quarter', label: x };\n  else if (x && type === 'scatter') extra.x = { field: 'size', label: x, unit: 'kB' };\n  else if (x) extra.x = { field: 'day', type: 'date', label: x };\n  return extra;\n}\n\ndescribe('A1 accessible name and summary', () => {\n  for (const type of TYPES) {\n    it(`A1 ${type}: the title is the accessible name and the description is the generated summary: type, series, x and y range, each series' minimum, maximum and last value`, async () => {\n      const page = await devPage();\n      await create(page, type);\n      const fig = await axOf(page, FIGURE);\n      expect(fig.role).toBe(type === 'compact' ? 'image' : 'group');\n      expect(fig.name).toBe(type === 'donut' ? 'Monthly spend' : type === 'bar' ? 'Shipments per quarter' : type === 'scatter' ? 'Latency by payload size' : 'Energy use by site');\n      // Each named statement in a sentence of its own (removing the range statement, say, fails).\n      expect(missingClauses(fig.description, summaryClauses(type)), fig.description).toEqual([]);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    for (const build of ['development', 'production'] as const) {\n      it(`A1 ${type}: with no title and no labelledBy the name is generated from type and measure (\"${TYPE_WORD[type]} chart of ${MEASURE[type]}…\") and AX140 is raised (${build} build)`, async () => {\n        const page = build === 'development' ? await devPage() : await prodPage();\n        const warnings: string[] = [];\n        page.on('console', m => { if (m.type() === 'warning') warnings.push(m.text()); });\n        const built = await create(page, type, untitled(type));\n        const fig = await axOf(page, FIGURE);\n        const x = X_LABEL[type];\n        if (x) expect(fig.name).toBe(`${TYPE_WORD[type]} chart of ${MEASURE[type]} by ${x}`);\n        else expect(fig.name.startsWith(`${TYPE_WORD[type]} chart of ${MEASURE[type]}`), fig.name).toBe(true);\n        expect(built.diagnostics.filter(d => d.code === 'AX140').map(d => d.level)).toEqual(['warning']);\n        // Spec 3.5: warnings print once per code per page in every build.\n        expect(warnings.filter(w => w.includes('AX140'))).toHaveLength(1);\n        // The summary is still there with the generated name.\n        expect(fig.description).toContain(TYPE_WORD[type]);\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n\n    it(`A1 ${type}: labelledBy names the chart from the page's own heading, without a heading of its own and without AX140`, async () => {\n      const page = await devPage();\n      await page.evaluate(() => {\n        const h = document.createElement('h2');\n        h.id = 'card-heading';\n        h.textContent = 'Card heading';\n        document.querySelector('#chart')!.before(h);\n      });\n      const built = await create(page, type, { title: undefined, labelledBy: 'card-heading' });\n      const fig = await axOf(page, FIGURE);\n      expect(fig.name).toBe('Card heading');\n      expect(built.diagnostics.map(d => d.code)).not.toContain('AX140');\n      const headings = (await axWithin(page, '#chart')).filter(n => n.role === 'heading');\n      expect(headings).toEqual([]);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    if (type !== 'compact') {\n      it(`A1 ${type}: the title's heading level is the author's, and a visually hidden title still names the chart`, async () => {\n        const page = await devPage();\n        await create(page, type, { title: { text: 'Level two', level: 2 } });\n        let heading = (await axWithin(page, '#chart')).find(n => n.role === 'heading');\n        expect(heading?.name).toBe('Level two');\n        expect(heading?.props.level).toBe(2);\n        await page.evaluate(() => {\n          const c = (window as unknown as { charts: { update(p: unknown): void }[] }).charts[0]!;\n          c.update({ title: { text: 'Hidden five', level: 5, visible: false } });\n        });\n        await page.evaluate(async () => { for (let i = 0; i < 3; i++) await new Promise(r => requestAnimationFrame(r)); });\n        heading = (await axWithin(page, '#chart')).find(n => n.role === 'heading');\n        expect(heading?.name).toBe('Hidden five');\n        expect(heading?.props.level).toBe(5);\n        expect((await axOf(page, FIGURE)).name).toBe('Hidden five');\n        // Visually hidden: no visible area on the page.\n        const size = await page.locator('#chart .axylo-title').evaluate(el => {\n          const r = el.getBoundingClientRect();\n          const s = getComputedStyle(el);\n          return { area: r.width * r.height, clipped: s.clipPath !== 'none' || s.clip !== 'auto' };\n        });\n        expect(size.area <= 1 || size.clipped).toBe(true);\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n\n    it(`A1 ${type}: an author description is added to the summary and never removes the zone or the omission statement`, async () => {\n      const page = await devPage();\n      // Instants in a named zone (not for a donut, which has no x) with one value that cannot be drawn.\n      const options: Record<string, unknown> = type === 'donut'\n        ? { data: [{ item: 'Rent', spend: 1200 }, { item: 'Food', spend: '__NaN__' }, { item: 'Travel', spend: 360 }] }\n        : type === 'scatter'\n          ? { data: [{ size: Date.UTC(2026, 2, 2), latency: 1 }, { size: Date.UTC(2026, 2, 3), latency: '__NaN__' }, { size: Date.UTC(2026, 2, 4), latency: 3 }], x: { field: 'size', type: 'time', timeZone: 'Asia/Kolkata' }, series: undefined }\n          : type === 'bar'\n            ? { data: [{ quarter: Date.UTC(2026, 2, 2), shipped: 1 }, { quarter: Date.UTC(2026, 2, 3), shipped: '__NaN__' }, { quarter: Date.UTC(2026, 2, 4), shipped: 3 }], x: { field: 'quarter', type: 'time', timeZone: 'Asia/Kolkata' }, series: undefined }\n            : { data: [{ day: Date.UTC(2026, 2, 2), energy: 1 }, { day: Date.UTC(2026, 2, 3), energy: '__NaN__' }, { day: Date.UTC(2026, 2, 4), energy: 3 }], x: { field: 'day', type: 'time', timeZone: 'Asia/Kolkata' }, series: undefined };\n      await create(page, type, { ...options, description: 'Readings from the main meter.' });\n      const fig = await axOf(page, FIGURE);\n      expect(sentences(fig.description)).toContain('Readings from the main meter.');\n      // The generated statements all stay beside the author's: ranges, the zone, the omission.\n      const unit = { line: 'kWh', area: 'kWh', bar: 't', scatter: 'ms', donut: 'EUR', compact: 'kWh' }[type];\n      const label = { line: 'Energy', area: 'Energy', bar: 'Shipped', scatter: 'Latency', donut: 'Spend', compact: 'Energy' }[type];\n      const clauses: Clause[] = type === 'donut'\n        ? [{ name: 'Rent', fragments: ['Rent', withUnit(1200, unit)] }, { name: 'Travel', fragments: ['Travel', withUnit(360, unit)] }]\n        : [\n          { name: 'x range', fragments: [type === 'bar' ? 'quarter' : type === 'scatter' ? 'size' : 'day', 'Mar 2, 2026', 'Mar 4, 2026'] },\n          { name: 'y range', fragments: [label, withUnit(1, unit), withUnit(3, unit)] },\n        ];\n      // One value left out (NaN, AX103), said with its count (spec A1 \"any omissions\", F12).\n      clauses.push({ name: 'omission', fragments: ['not shown', '1'] });\n      expect(missingClauses(fig.description, clauses), fig.description).toEqual([]);\n      if (type !== 'donut') expect(sentences(fig.description).some(t => ZONE_NAMES.some(z => t.includes(z))), fig.description).toBe(true);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    if (type !== 'donut') {\n      it(`A1 ${type}: the summary of instants states the time zone they are shown in`, async () => {\n        const page = await devPage();\n        await create(page, type, {}, '#chart', 'instants');\n        const fig = await axOf(page, FIGURE);\n        expect(ZONE_NAMES.some(z => fig.description.includes(z)), fig.description).toBe(true);\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n\n    it(`A1 ${type}: 24 charts on one page have no duplicate ids, each its own name, and axe heading-order passes`, async () => {\n      const page = await devPage({ css: '.tile { width: 340px; height: 200px; }' });\n      await page.evaluate(() => {\n        for (let i = 0; i < 24; i++) {\n          const el = document.createElement('div');\n          el.id = `tile-${i}`;\n          el.className = 'tile';\n          document.body.appendChild(el);\n        }\n      });\n      for (let i = 0; i < 24; i++) await create(page, type, { title: `Chart ${i + 1}` }, `#tile-${i}`);\n      const ids = await page.evaluate(() => [...document.querySelectorAll('[id]')].map(e => e.id));\n      expect(ids.filter((id, i) => ids.indexOf(id) !== i)).toEqual([]);\n      const names = [];\n      for (let i = 0; i < 24; i++) names.push((await axOf(page, `#tile-${i} figure`)).name);\n      expect(names).toEqual(Array.from({ length: 24 }, (_, i) => `Chart ${i + 1}`));\n      const result = await axe(page, 'body');\n      expect(result.violations.filter(v => v.id === 'heading-order' || v.id === 'duplicate-id' || v.id === 'duplicate-id-aria')).toEqual([]);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\n","exit_code":0,"status":"completed"}}
