\"packages/axylo/test/browser/acceptance/a5-not-colour-alone.browser.test.ts\",\n          \"title\": \"A5 bar: on a background the palette does not suit (the first series' painted colour itself), AX141 is raised\"\n        }\n      ],\n      \"scatter\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/reader-model.test.ts\",\n          \"title\": \"A5 scatter: separate series have distinct marker shapes as well as paint bindings\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/a5-not-colour-alone.browser.test.ts\",\n          \"title\": \"A5 scatter: each series is drawn with its own point shape, repeated in the legend and in the tooltip of each point\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/a5-not-colour-alone.browser.test.ts\",\n          \"title\": \"A5 scatter: the eight painted colours (light scheme) are each at least 3:1 on their painted backdrop and at least 0.10 apart in OKLab under normal vision and simulated protanopia, deuteranopia and tritanopia, analytic and as an 8-bit image\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/a5-not-colour-alone.browser.test.ts\",\n          \"title\": \"A5 scatter: the eight painted colours (dark scheme) are each at least 3:1 on their painted backdrop and at least 0.10 apart in OKLab under normal vision and simulated protanopia, deuteranopia and tritanopia, analytic and as an 8-bit image\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/a5-not-colour-alone.browser.test.ts\",\n          \"title\": \"A5 scatter: on a background the palette does not suit (the first series' painted colour itself), AX141 is raised\"\n        }\n      ],\n      \"donut\": [\n        {\n          \"kind\"