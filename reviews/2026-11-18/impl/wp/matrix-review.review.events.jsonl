n          \"file\": \"packages/axylo/test/browser/acceptance/type-matrix.browser.test.ts\",\n          \"title\": \"T-pointer-scatter: the nearest point within 24 px is picked: 23 px from a lone point it is, 25 px it is not\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/type-matrix.browser.test.ts\",\n          \"title\": \"T-pointer-scatter: two points equally near the pointer: the later row wins, whichever series it is (source order reversed, the other wins)\"\n        }\n      ]\n    },\n    \"limits\": {\n      \"scatter\": \"Browser evidence: system Chrome, SVG renderer (the default); no Firefox or WebKit result is recorded yet. The radius is checked at 23 and 25 px in three directions from a lone point (Node: 23.5 and 24.5 px straight down); the tie with two points, in both row orders.\"\n    }\n  },\n  {\n    \"id\": \"T-tooltip-line\",\n    \"statement\": \"Tooltip content · Every visible series at that x\",\n    \"appliesTo\": [\n      \"line\"\n    ],\n    \"notApplicable\": {\n      \"area\": \"This is the line cell of section 3.6.\",\n      \"bar\": \"This is the line cell of section 3.6.\",\n      \"scatter\": \"This is the line cell of section 3.6.\",\n      \"donut\": \"This is the line cell of section 3.6.\",\n      \"compact\": \"Section 3.7: a compact chart has no tooltip.\"\n    },\n    \"evidence\": {\n      \"line\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/acceptance/type-matrix.test.ts\",\n          \"title\": \"T-tooltip-line line: lists visible series in order and distinguishes No observation from No data\"\n        },\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/acceptance/type-matrix.browser.test.ts\",\n          \"title\": \"T-tooltip-line: every visible series at that x, in series order; a hidden series is not listed\",\n          \"registration\": \"T-tooltip-${type}: