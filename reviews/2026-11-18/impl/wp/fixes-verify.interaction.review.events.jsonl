core.indexOf(marks[0]!) === 2 ? marks[0]! : '.';\n   359\t  const groupSample = [...count(1234567)].filter(ch => !isDigit(ch))[0] ?? '';\n   360\t  let body = text.trim();\n   361\t  if (prefix && body.startsWith(prefix)) body = body.slice(prefix.length).trim();\n   362\t  if (suffix && body.endsWith(suffix)) body = body.slice(0, -suffix.length).trim();\n   363\t  const minus = /^[-−‒–]/u.exec(body);\n   364\t  if (minus) body = body.slice(minus[0].length);\n   365\t  const [intPart = '', fracPart, extra] = body.split(decimal);\n   366\t  if (extra !== undefined || intPart === '') return null;\n   367\t  const groupClass = groupSample && /^[\\s  ]$/u.test(groupSample) ? '[\\\\s\\\\u00a0\\\\u202f]' : escape(groupSample || '\\u0000');\n   368\t  const intDigits = intPart.replace(new RegExp(groupClass, 'gu'), '');\n   369\t  if (![...intDigits].every(isDigit) || (fracPart !== undefined && (fracPart === '' || ![...fracPart].every(isDigit)))) return null;\n   370\t  const integer = Number(toAscii(intDigits));\n   371\t  // Grouping marks are accepted only where the column's own formatter puts them for that integer.\n   372\t  if (intDigits !== intPart && normalized(toAscii(intPart)) !== normalized(toAscii(count(integer)))) return null;\n   373\t  const value = Number(`${minus ? '-' : ''}${toAscii(intDigits)}${fracPart !== undefined ? `.${toAscii(fracPart)}` : ''}`);\n   374\t  return Number.isFinite(value) ? value : null;\n   375\t}\n   376\t\n   377\texport function createInteraction(parts: InteractionParts, figure: Figure, renderer: MarkRenderer, actions: Actions): Interaction {\n   378\t  const doc = figure.figure.ownerDocument;\n   379\t  const plot = figure.plot;\n   380\t  const tooltip = createTooltip(figure.tooltip, figure.readout, figure.figure);\n   381\t\n   382\t  let c: Committed | null = null;\n   383\t  /** The newest controls state (prepared or committed), for the toolbar's actions. */\n   384\t  let cs: ControlsState | null = null;\n   385\t  /** The key