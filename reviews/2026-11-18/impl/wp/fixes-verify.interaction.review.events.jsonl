\t      return primary ? ref(primary.series, primary.index) : null;\n    73\t    }\n    74\t    if (start === end) return null;\n    75\t    const point = locate(datum);\n    76\t    if (point && point.index >= start && point.index < end) return datum;\n    77\t    const x = series[s]!.x;\n    78\t    const right = upperBound(x, datum.x, start, end);\n    79\t    if (right < end) return ref(s, right);\n    80\t    const left = lowerBound(x, datum.x, start, end) - 1;\n    81\t    return left >= start ? ref(s, left) : null;\n    82\t  }\n    83\t\n    84\t  function write(datum: DatumRef): DatumText | null {\n    85\t    const at = locate(datum);\n    86\t    if (!at || datum.kind !== 'point') return null;\n    87\t    const { series: s, index: i } = at;\n    88\t    const entry = series[s]!;\n    89\t    return {\n    90\t      ref: datum, seriesIndex: s, seriesLabel: entry.label, x: formatters.x(entry.x[i]!),\n    91\t      value: formatters.value(s, entry.y[i]!), percent: null, state: SLOT_VALUE, row: datum.row,\n    92\t    };\n    93\t  }\n    94\t\n    95\t  function nearest(from: PointIndex, s: number): DatumRef {\n    96\t    const { start, end } = ranges[s]!;\n    97\t    const entry = series[s]!;\n    98\t    const fromX = series[from.series]!.x[from.index]!;\n    99\t    const fromY = series[from.series]!.y[from.index]!;\n   100\t    const x = projection?.x.map(fromX) ?? fromX;\n   101\t    const y = projection?.y.map(fromY) ?? fromY;\n   102\t    let nearest = start;\n   103\t    let best = Infinity;\n   104\t\n   105\t    function consider(i: number, dx: number): void {\n   106\t      if (work) work.seriesCandidates++;\n   107\t      const py = projection?.y.map(entry.y[i]!) ?? entry.y[i]!;\n   108\t      const distance = Math.hypot(dx, py - y);\n   109\t      if (distance < best || distance === best && i < nearest) {\n   110\t        nearest = i;\n   111\t        best = distance;\n   112\t      }\n   113\t    }\n   114\t\n   115\t    const dx = (i: number) => Math.abs((projection?.x.map(entry.x[i]!) ?? entry.x[i]!) - x);\n   116\t    const flatY = projection && (projection.y.range[0] === projection.y.range[1] || projection.y.domain[0] === projection.y.domain[1]);\n   117\t    // Starting at x, only runs whose horizontal distance can still win need a y search.\n   118\t    let right = lowerBound(entry.x, fromX, start, end);\n   119\t    let left = right - 1;\n   120\t    while (left >= start || right < end) {\n   121\t      const leftDistance = left >= start ? dx(left) : Infinity;\n   122\t      const rightDistance = right < end ? dx(right) : Infinity;\n   123\t      const distance = Math.min(leftDistance, rightDistance);\n   124\t      if (distance > best) break;\n   125\t      let lo: number;\n   126\t      let hi: number;\n   127\t      if (leftDistance <= rightDistance && left >= start) {\n   128\t        hi = left + 1;\n   129\t        lo = left > start && entry.x[left] === entry.x[left - 1]\n   130\t          ? lowerBound(entry.x, entry.x[left]!, start, hi) : left;\n   131\t        left = lo - 1;\n   132\t      } else {\n   133\t        lo = right;\n   134\t        hi = right + 1 < end && entry.x[right] === entry.x[right + 1]\n   135\t          ? upperBound(entry.x, entry.x[right]!, right, end) : right + 1;\n   136\t        right = hi;\n   137\t      }\n   138\t      if (lo + 1 === hi || flatY) {\n   139\t        consider(lo, distance);\n   140\t      } else {\n   141\t        const middle = lowerBound(entry.y, fromY, lo, hi);\n   142\t        if (middle < hi) consider(middle, distance);\n   143\t        if (middle > lo) consider(lowerBound(entry.y, entry.y[middle - 1]!, lo, middle), distance);\n   144\t      }\n   145\t    }\n   146\t    return ref(s, nearest);\n   147\t  }\n   148\t\n   149\t  function toRef(point: PointIndex | null): DatumRef | null {\n   150\t    return point ? ref(point.series, point.index) : null;\n   151\t  }\n   152\t\n   153\t  return {\n   154\t    pick(px, py) {\n   155\t      const picked = grid?.pick(px, py);\n   156\t      return grid && picked ? {\n   157\t        kind: 'point', refs: picked.hits.map(i => ref(grid.series[i]!, grid.points[i]!)), count: picked.count,\n   158\t      } : null;\n   159\t    },\n   160\t    tooltip(target) {\n   161\t      if (target.kind !== 'point') return { title: '', rows: [], count: 0, total: null };\n   162\t      const rows = target.refs.slice(0, POINT_LIMIT).flatMap(datum => {\n   163\t        const text = write(datum);\n   164\t        return text ? [text] : [];\n   165\t      });\n   166\t      return { title: rows[0]?.x ?? '', rows, count: target.count, total: null };\n   167\t    },\n   168\t    primary(target) { return target.kind === 'point' ? target.refs[0] ?? null : null; },\n   169\t    datum: write,\n   170\t    anchor(datum) {\n   171\t      const point = locate(datum);\n   172\t      if (!point || !layout || !projection) return null;\n   173\t      const { start, end } = ranges[point.series]!;\n   174\t      if (point.index < start || point.index >= end) return null;\n   175\t      const entry = series[point.series]!;\n   176\t      const x = scatterPosition(projection.x, entry.x[point.index]!);\n   177\t      const y = scatterPosition(projection.y, entry.y[point.index]!);\n   178\t      return contains(layout.plot, x, y) ? pointBox(x, y) : null;\n   179\t    },\n   180\t    count: order.count,\n   181\t    ordinal(datum) {\n   182\t      const point = locate(datum);\n   183\t      return point ? order.ordinal(point.series, point.index) : -1;\n   184\t    },\n   185\t    step(from, direction) {\n   186\t      if (!from) return toRef(order.edge(1));\n   187\t      const resolved = resolve(from);\n   188\t      const point = resolved && locate(resolved);\n   189\t      if (!point) return null;\n   190\t      switch (direction) {\n   191\t        case 'next': return toRef(order.edge(1, point));\n   192\t        case 'previous': return toRef(order.edge(-1, point));\n   193\t        case 'first':\n   194\t        case 'last': {\n   195\t          const edge = order.edge(direction === 'first' ? 1 : -1);\n   196\t          return edge?.series === point.series && edge.index === point.index ? null : toRef(edge);\n   197\t        }\n   198\t        case 'page-next':\n   199\t        case 'page-previous': {\n   200\t          const ordinal = order.ordinal(point.series, point.index);\n   201\t          const to = direction === 'page-next' ? Math.min(order.count - 1, ordinal + pageDistance(order.count))\n   202\t            : Math.max(0, ordinal - pageDistance(order.count));\n   203\t          return to === ordinal ? null : toRef(order.at(to));\n   204\t        }\n   205\t        case 'series-next':\n   206\t        case 'series-previous': {\n   207\t          const neighbor = active[active.indexOf(point.series) + (direction === 'series-next' ? 1 : -1)];\n   208\t          return neighbor === undefined ? null : nearest(point, neighbor);\n   209\t        }\n   210\t      }\n   211\t    },\n   212\t    resolve,\n   213\t    get lastPickCandidates() { return grid?.examined ?? 0; },\n   214\t    get lastPickCells() { return grid?.cellsExamined ?? 0; },\n   215\t    get lastPickLattice() { return grid?.usedLattice ?? false; },\n   216\t  };\n   217\t}\n","exit_code":0,"status":"completed"}}
