   60\tinterface RowEntry {\n    61\t  readonly element: HTMLElement;\n    62\t  readonly name: HTMLElement;\n    63\t  readonly value: HTMLElement;\n    64\t  /** The strip's \"; \" before the entry. */\n    65\t  readonly separator: Text | null;\n    66\t  row: DatumText;\n    67\t  swatch: string;\n    68\t  readonly listening: AbortController | null;\n    69\t}\n    70\t\n    71\t/** A row's identity across redraws: its series and its datum, not its place. */\n    72\tfunction rowKey(r: DatumText, title: string): string {\n    73\t  const ref = r.ref;\n    74\t  switch (ref.kind) {\n    75\t    case 'aligned': return `a\\u0000${ref.seriesKey}\\u0000${title}`;\n    76\t    case 'point': return `p\\u0000${ref.seriesKey}\\u0000${ref.row}\\u0000${ref.x}`;\n    77\t    case 'slice': return `s\\u0000${ref.sliceKey}`;\n    78\t  }\n    79\t}\n    80\t\n    81\t/** Puts exactly `wanted`, in order, into `host`, moving a node only when it is out of place. */\n    82\tfunction place(host: HTMLElement, wanted: readonly Node[]): void {\n    83\t  let at: ChildNode | null = host.firstChild;\n    84\t  for (const node of wanted) {\n    85\t    if (at !== node) host.insertBefore(node, at);\n    86\t    at = (node as ChildNode).nextSibling;\n    87\t  }\n    88\t  while (at) {\n    89\t    const next: ChildNode | null = at.nextSibling;\n    90\t    at.remove();\n    91\t    at = next;\n    92\t  }\n    93\t}\n    94\t\n    95\tfunction setText(node: Node, text: string): void {\n    96\t  if (node.textContent !== text) node.textContent = text;\n    97\t}\n    98\t\n    99\tfunction setLang(el: HTMLElement, lang: string | null | undefined): void {\n   100\t  if (lang) {\n   101\t    if (el.getAttribute('lang') !== lang) el.setAttribute('lang', lang);\n   102\t  } else if (el.hasAttribute('lang')) el.removeAttribute('lang');\n   103\t}\n   104\t\n   105\texport function createTooltip(element: HTMLElement, readoutElement: HTMLElement, figure: HTMLElement): TooltipView {\n   106\t  c