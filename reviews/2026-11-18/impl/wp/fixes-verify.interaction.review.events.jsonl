ting highlights the datum; its values are in the keyboard reading and the\n  1322\t      // table). Never floating below the limit (final review, finding 9).\n  1323\t      const small = without.kind === 'plot' && (without.plot.width < READOUT_WIDTH || without.plot.height < READOUT_HEIGHT);\n  1324\t      const next: ReadoutMode = a.options.tooltip === false || !small ? 'floating'\n  1325\t        : without.kind === 'plot' && without.plot.height - stripHeight >= MIN_PLOT_HEIGHT ? 'strip' : 'none';\n  1326\t      if (next !== readoutKind) {\n  1327\t        readoutKind = next;\n  1328\t        const wantStrip = next === 'strip';\n  1329\t        if (wantStrip !== readoutMode) {\n  1330\t          readoutMode = wantStrip;\n  1331\t          if (arrange(tooSmall)) size = host.measure() ?? size;\n  1332\t        } else {\n  1333\t          arranged = null;\n  1334\t          arrange(tooSmall);\n  1335\t        }\n  1336\t      }\n  1337\t    }\n  1338\t    if (size === null || size.width <= 0) {\n  1339\t      layout = { kind: 'unmeasured', width: size?.width ?? 0, height: size?.height ?? 0 };\n  1340\t    } else if (shown.kind !== 'ready') {\n  1341\t      const h = Math.max(0, size.height);\n  1342\t      layout = { kind: 'unmeasured', width: size.width, height: h };\n  1343\t      lKey = ['message', size.width, h];\n  1344\t    } else {\n  1345\t      /*\n  1346\t       * Spec L8, decided on the room a normal plot gets, which the fallback cannot change: in the fallback\n  1347\t       * the plot's size is read back as it would be without the fallback's own DOM (`fallback` is what that\n  1348\t       * DOM adds, measured when it was entered). Within the frame the figure is settled first: a plot whose\n  1349\t       * layout hides labels gets the note under it, and is measured again with it, so the size a mode is\n  1350\t       * judged on is the size that mode really has. Each mode is then self-consistent, and stepping the\n  1351\t       * container through the boundary switches once, at the same size in both directions.\n  1352\t       */\n  1353\t      const strip = readoutMode && size.room ? Math.max(0, size.room.height - size.height) : 0;\n  1354\t      let result = plotLayout(fallback ? { width: size.width - fallback.width, height: size.height - fallback.height } : size, strip);\n  1355\t      for (let pass = 0; pass < 4; pass++) {\n  1356\t        const small = result.layout.kind === 'too-small';\n  1357\t        if (small && !tooSmall) {\n  1358\t          const normal = size;\n  1359\t          tooSmall = true;\n  1360\t          ({ reader, inputs: readerInputs } = settleReader(0));\n  1361\t          arrange(true);\n  1362\t          size = host.measure() ?? normal;\n  1363\t          fallback = { width: size.width - normal.width, height: size.height - normal.height };\n  1364\t          break;\n  1365\t        }\n  1366\t        if (!small && tooSmall) {\n  1367\t          tooSmall = false;\n  1368\t          fallback = null;\n  1369\t        }\n  1370\t        if (tooSmall) break;\n  1371\t        // Normal: the note says what this layout hides; if that moves the figure, judge the new size.\n  1372\t        ({ reader, inputs: readerInputs } = settleReader(hiddenIn(result.layout)));\n  1373\t        if (!arrange(false)) break;\n  1374\t        const now = host.measure();\n  1375\t        if (now === null || (now.width === size.width && now.height === size.height)) break;\n  1376\t        size = now;\n  1377\t        result = plotLayout(size, readoutMode && size.room ? Math.max(0, size.room.height - size.height) : 0);\n  1378\t      }\n  1379\t      layout = result.layout;\n  1380\t      lKey = result.key;\n  1381\t      if (destroyed) throw ABORT;\n  1382\t    }\n  1383\t\n  1384\t    // Findings that follow from the layout shown, recomputed every frame (cheap): L8, L1, the bar hint.\n  1385\t    const fit: DiagnosticInput[] = [];\n  1386\t    if (tooSmall || layout.kind === 'too-small') fit.push(createDiagnostic('