{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'git show bbd7564:packages/axylo/src/dom/interaction.ts | nl -ba | sed -n \"1,450p\"'","aggregated_output":"     1\t/**\n     2\t * Everything a reader uses to explore a full chart (decision 0001; spec I1–I6, A2–A4, A7): what is shown,\n     3\t * driven by pointer, touch and keyboard alike, and what is derived from it: the tooltip, the overlay (drawn\n     4\t * with `renderer.drawOverlay`, never by redrawing the scene), the keyboard proxy's range and value text and\n     5\t * the `hover` event. Plus the toolbar (legend, zoom, pause, table), the table view and the zoom gestures.\n     6\t *\n     7\t * What is shown is one small state machine (decision 0004 revision 3), `shown`:\n     8\t *\n     9\t *   none ── nothing (the pointer is away and the keyboard does not lead)\n    10\t *   hover ── the datum the pointer picks now (or nothing, over empty plot)\n    11\t *   held ── rule 3b: after a rest of 250 ms on a datum whose content is on show, that datum, while the\n    12\t *           pointer stays in the corridor from the resting point to the content's rectangle; it carries the\n    13\t *           geometry (anchor, rectangle) and presentation it was taken in\n    14\t *   pinned ── one datum (`ref`, the one the reader chose) and the rows shown with it\n    15\t *   keyboard ── the keyboard's datum (`focus`)\n    16\t *\n    17\t * `commit` reconciles it against the new displayed frame before anything is presented: a pin follows its\n    18\t * datum and ends with it; a hold ends when its datum's anchor, its content's rectangle or the presentation\n    19\t * changes, and picking is then from the pointer at once; a hover is picked again. Activation (click, tap,\n    20\t * Enter) never reads this state: a click or a tap picks afresh, Enter uses the keyboard's datum.\n    21\t *\n    22\t * The controller calls `commit` after every frame it draws, with the state that frame shows; this module\n    23\t * never reads a newer state than the marks show. It changes the chart only through `actions`, which go\n    24\t * through the public paths (zoom, the view's hidden set, pause), so every change follows the commit contract.\n    25\t *\n    26\t * Every listener on the chart's own elements is registered with one abort signal per build, so clearing the\n    27\t * layer or destroying the chart removes them all.\n    28\t */\n    29\timport type {\n    30\t  DatumRef, DatumText, Formatters, Layout, Lookup, MarkRenderer, Overlay, PaintBindings, PickTarget, ReaderModel,\n    31\t  Rect, ResolvedTheme, StepDirection, TooltipModel, View, XValue,\n    32\t} from '../core/contracts';\n    33\timport type { Messages } from '../public';\n    34\timport { fill } from '../messages';\n    35\timport {\n    36\t  overlayWith, OUTLINE_REACH, RING_REACH, RING_STROKE, alignedRows, canZoomIn, datumReading, groupRefs, minimumWidth, panWindow,\n    37\t  pinchWidth, positionAt, refsAt, ringRect, sameRef, stepAcross, zoomStep, targetBox, targetOf, valueText, PAN_SHARE, ZOOM_FACTOR,\n    38\t  type Mode, type TargetMarks,\n    39\t} from '../core/focus';\n    40\timport type { Figure } from './figure';\n    41\timport { createTableView, type TableView } from './table';\n    42\timport { createToolbar, type Toolbar, type ToolbarItem } from './toolbar';\n    43\timport { createTooltip, type Presentation, type TooltipContent } from './tooltip';\n    44\timport { createSwatch, swatchPattern, type SwatchPattern, type SwatchSpec } from './swatch';\n    45\timport { sliceText } from '../lookup/text';\n    46\timport { barPattern } from '../scene/bars';\n    47\timport { readPosition } from '../reader/x';\n    48\timport { setAttr } from './attributes';\n    49\timport { mappingOf, rectToViewport, toLocal, toViewport, visibleRegion, type Point } from './mapping';\n    50\timport { insideCorridor, intersect, type PlacementInput } from './placement';\n    51\timport { identityOf, matchesIdentity, sameTarget, type Identity } from './pointer';\n    52\t\n    53\ttype Span = readonly [number, number];\n    54\t\n    55\t/**\n    56\t * Readout mode (decision 0004 rule 5), decided by the controller's layout: a floating tooltip, the strip\n    57\t * reserved under the plot, or no readout at all (a plot the strip would make smaller than L8 allows).\n    58\t */\n    59\texport type ReadoutMode = 'floating' | 'strip' | 'none';\n    60\t\n    61\t/**\n    62\t * What the controls under the plot need. Known before layout, so they are in place when the plot is\n    63\t * measured and their arrival never makes the plot relayout.\n    64\t */\n    65\texport interface ControlsState {\n    66\t  readonly kind: 'line' | 'area' | 'bar' | 'scatter' | 'donut';\n    67\t  readonly view: View;\n    68\t  readonly formatters: Formatters;\n    69\t  readonly messages: Messages;\n    70\t  readonly reader: ReaderModel;\n    71\t  /** The last layout was too small for a plot (spec L8): only the table control is offered. */\n    72\t  readonly tooSmall: boolean;\n    73\t  /** The chart shows data (not loading, empty or error). */\n    74\t  readonly ready: boolean;\n    75\t  /**\n    76\t   * The data can be inspected although nothing is drawn (an empty window, an all-zero donut): the table and\n    77\t   * the donut's slice list stay (spec F8, A4, L7).\n    78\t   */\n    79\t  readonly inspectable?: boolean;\n    80\t  /** The chart shows its empty state (not loading or error): a zoomed window with nothing in it can recover. */\n    81\t  readonly empty?: boolean;\n    82\t  /** The state's message while not ready (\"Loading chart.\"), which the plot reads instead of data. */\n    83\t  readonly message?: string | null;\n    84\t  /** A full chart; false for the compact variant, which is a static image (spec C1). */\n    85\t  readonly interactive: boolean;\n    86\t  readonly tooltip: boolean;\n    87\t  /** Where the legend part of the toolbar goes (plan 1.4, `legend`), or false for none. */\n    88\t  readonly legend: false | 'top' | 'right' | 'bottom';\n    89\t  /** Zoom applies to this chart (spec 3.6) and is not switched off; 'touch' also captures pinch. */\n    90\t  readonly zoom: false | true | 'touch';\n    91\t  readonly zoomed: boolean;\n    92\t  /** `append` has been called at least once (spec I6). */\n    93\t  readonly streaming: boolean;\n    94\t  readonly paused: boolean;\n    95\t  readonly epoch: number;\n    96\t  /** `lang` for an element that shows the built-in text of `key`: 'en' on a page in another language. */\n    97\t  english(key: keyof Messages): string | null;\n    98\t  /** The page's own language, for author text inside an element marked 'en'. */\n    99\t  readonly pageLang: string | null;\n   100\t  /**\n   101\t   * Readout mode (decision 0004 rule 5), decided by the controller's layout. Read only through `readoutOf`.\n   102\t   * A boolean is the controller's earlier form: true for the strip, false for floating.\n   103\t   */\n   104\t  readonly readout?: boolean | ReadoutMode;\n   105\t  /** Readout mode as the controller's layout decided it (the controller's three-state field; preferred). */\n   106\t  readonly readoutMode?: ReadoutMode;\n   107\t}\n   108\t\n   109\t/** What one drawn frame shows, as the interaction layer needs it. */\n   110\texport interface Committed extends ControlsState {\n   111\t  readonly layout: Layout;\n   112\t  readonly lookup: Lookup;\n   113\t  readonly bindings: PaintBindings;\n   114\t  readonly theme: ResolvedTheme;\n   115\t  readonly pixelRatio: number;\n   116\t}\n   117\t\n   118\texport interface Actions {\n   119\t  /** A window in x positions, or null for everything. Goes through the public `zoom` path. */\n   120\t  zoom(window: Span | null): void;\n   121\t  toggle(seriesKey: string): void;\n   122\t  pause(paused: boolean): void;\n   123\t  select(ref: DatumRef): void;\n   124\t  hover(ref: DatumRef | null): void;\n   125\t}\n   126\t\n   127\texport interface Interaction {\n   128\t  /**\n   129\t   * Before the plot is measured: the legend, toolbar and table for the state about to be drawn. Returns\n   130\t   * true when that changed what sits under the plot, so the plot's size must be read again.\n   131\t   */\n   132\t  prepare(state: ControlsState): boolean;\n   133\t  commit(state: Committed | null): void;\n   134\t  /** Internal failure or destroy: everything goes, nothing is left focusable. */\n   135\t  clear(): void;\n   136\t  /**\n   137\t   * The chart is in the document: listeners on the document itself (Escape, a tap outside a pinned\n   138\t   * tooltip, scrolling) may be held. `detach` lets go of them while the chart is out of the document.\n   139\t   */\n   140\t  attach(): void;\n   141\t  detach(): void;\n   142\t  destroy(): void;\n   143\t}\n   144\t\n   145\t/**\n   146\t * The one place readout mode is read from the controller's state (decision 0004 rule 5; review finding 12\n   147\t * is the controller's). Until the controller says 'none' itself, its boolean means strip or floating.\n   148\t */\n   149\texport function readoutOf(state: ControlsState): ReadoutMode {\n   150\t  const r = state.readoutMode ?? state.readout;\n   151\t  if (r === 'floating' || r === 'strip' || r === 'none') return r;\n   152\t  return r === true ? 'strip' : 'floating';\n   153\t}\n   154\t\n   155\t/** How the content is presented for this state: never, by `tooltip: false`, in the too-small state or without a readout. */\n   156\tfunction presentationFor(state: ControlsState): Presentation | 'none' {\n   157\t  if (!state.interactive || !state.tooltip || state.tooSmall) return 'none';\n   158\t  const mode = readoutOf(state);\n   159\t  return mode === 'strip' ? 'strip' : mode === 'none' ? 'none' : 'floating';\n   160\t}\n   161\t\n   162\t/**\n   163\t * A bar series' pattern (spec F9), from the scene's own rule, so a swatch never disagrees with the marks.\n   