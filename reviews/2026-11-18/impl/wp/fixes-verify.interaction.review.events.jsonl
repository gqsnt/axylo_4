{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc 'git show bbd7564:packages/axylo/test/browser/chart/final-pin.browser.test.ts | nl -ba | sed -n \"1,358p\"'","aggregated_output":"     1\t/**\n     2\t * Pins, keyboard recovery, placement in the page and coordinates (decision 0004 revision 3, rules 1, 2, 4, 6,\n     3\t * 8, 9 and 10; part 2), against the final interaction review's findings 2, 3, 4, 6, 7, 9, 10, 13 and 14 and\n     4\t * the mutations 2, 3, 4, 6, 8, 9 and 10 of its last table (reviews/2026-11-18/impl/wp/core-final.interaction.review.md).\n     5\t * Accessibility outcomes are read from Chrome's accessibility tree where Chrome exposes them.\n     6\t */\n     7\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     8\timport type { Page } from 'playwright-core';\n     9\timport { start, stop } from '../harness';\n    10\timport { RENDERER, chartPage, closePage } from './util';\n    11\timport { axButtons, create, drawnShapes, frames, inside, overlaps, plotBox, recordEvents, selected, settle, strip, tip, type Box, type DrawnShape, type Pt } from './final-util';\n    12\t\n    13\tbeforeAll(start);\n    14\tafterAll(stop);\n    15\t\n    16\tconst proxy = '#chart .axylo-proxy';\n    17\tconst valueText = (page: Page) => page.locator(proxy).getAttribute('aria-valuetext');\n    18\tconst active = (page: Page) => page.evaluate(() => (document.activeElement as HTMLElement | null)?.className ?? '');\n    19\t/** Strokes in the focus colour in the SVG overlay: the datum ring (null on the canvas renderer). */\n    20\tconst ringStrokes = (page: Page) => page.evaluate(() => {\n    21\t  const overlay = document.querySelector('#chart .axylo-overlay');\n    22\t  return overlay ? [...overlay.querySelectorAll('*')].filter(e => /--axylo(?:-default)?-focus/.test((e as SVGElement).getAttribute('style') ?? '')).length : null;\n    23\t});\n    24\t\n    25\tdescribe('finding 2 and mutation 3: one effective focus after recovering from an empty window', () => {\n    26\t  it('focus the first point of x 0, 1, 99, 100, zoom to [25, 75], press 0: focus, reading, ring, tooltip and Enter agree on x 0', async () => {\n    27\t    const page = await chartPage();\n    28\t    await create(page, 'line', { title: 'Gap', data: [0, 1, 99, 100].map(x => ({ x, y: x % 7 })), x: 'x', y: 'y' });\n    29\t    await recordEvents(page);\n    30\t    await page.locator(proxy).focus();\n    31\t    await page.keyboard.press('Home');\n    32\t    await settle(page);\n    33\t    expect(await valueText(page)).toMatch(/^0\\. /);\n    34\t    await page.evaluate(() => window.charts[0]!.zoom([25, 75]));\n    35\t    await settle(page);\n    36\t    expect(await valueText(page)).toBe('No data to show.');\n    37\t    await page.keyboard.press('0');\n    38\t    await settle(page);\n    39\t    // Before any other reader action: every derived thing names the same datum.\n    40\t    expect(await active(page)).toContain('axylo-proxy');\n    41\t    expect(await valueText(page)).toMatch(/^0\\. y 0\\. Point 1 of /);\n    42\t    expect((await tip(page)).title).toBe('0');\n    43\t    if (RENDERER !== 'canvas') expect(await ringStrokes(page)).toBeGreaterThan(0);\n    44\t    await page.keyboard.press('Enter');\n    45\t    await settle(page);\n    46\t    const s = await selected(page);\n    47\t    expect(s.at(-1)).toMatchObject({ x: 0, index: 0 });\n    48\t    expect(await closePage(page)).toEqual([]);\n    49\t  });\n    50\t});\n    51\t\n    52\tdescribe('finding 3 and mutation 2: an all-zero donut\\'s slices are reachable by keyboard', () => {\n    53\t  it('with table: false, Tab reaches the slice list (one stop), arrows move, Enter selects that slice; two stops at most', async () => {\n    54\t    const page = await chartPage({ css: '#before, #after { display: inline-block !important; }' });\n    55\t    await create(page, 'donut', { title: 'Zero', table: false, data: [{ k: 'a', v: 0 }, { k: 'b', v: 0 }], label: 'k', value: 'v' });\n    56\t    await recordEvents(page);\n    57\t    await page.focus('#before');\n    58\t    const stops: string[] = [];\n    59\t    for (let i = 0; i < 4; i++) {\n    60\t      await page.keyboard.press('Tab');\n    61\t      const now = await page.evaluate(() => document.activeElement?.id || (document.activeElement?.textContent ?? '').trim());\n    62\t      if (now === 'after') break;\n    63\t      stops.push(now);\n    64\t    }\n    65\t    expect(stops.length).toBeGreaterThan(0);\n    66\t    expect(stops.length).toBeLessThanOrEqual(2);\n    67\t    await page.focus('#before');\n    68\t    await page.keyboard.press('Tab');\n    69\t    expect(await page.evaluate(() => document.activeElement?.className)).toBe('axylo-legend-choice');\n    70\t    await page.keyboard.press('Enter');\n    71\t    await page.keyboard.press('ArrowDown');\n    72\t    await page.keyboard.press('Enter');\n    73\t    await settle(page);\n    74\t    const s = await selected(page);\n    75\t    expect(s.map(e => e.x)).toEqual(['a', 'b']);\n    76\t    expect(await closePage(page)).toEqual([]);\n    77\t  });\n    78\t});\n    79\t\n    80\tdescribe('finding 14: an idle append does not rewrite the focused reading under a translated template', () => {\n    81\t  it('pointOf \"{series} {x} {value} [{index}/{count}]\", first scatter point focused, one point appended: the value text stays', async () => {\n    82\t    const page = await chartPage();\n    83\t    await create(page, 'scatter', { title: 'T', messages: { pointOf: '{series} {x} {value} [{index}/{count}]' }, data: [{ x: 0, y: 2 }], x: 'x', y: 'y' });\n    84\t    await page.locator(proxy).focus();\n    85\t    await settle(page);\n    86\t    const before = await valueText(page);\n    87\t    expect(before).toBe('y 0 2 [1/1]');\n    88\t    await page.evaluate(() => window.charts[0]!.append([{ x: 5, y: 3 }]));\n    89\t    await settle(page);\n    90\t    expect(await page.locator(proxy).getAttribute('max')).toBe('1');\n    91\t    expect(await valueText(page)).toBe(before);\n    92\t    // The reader's next move reads the current count (decision 0004 part 2).\n    93\t    await page.keyboard.press('ArrowRight');\n    94\t    await page.keyboard.press('ArrowLeft');\n    95\t    await settle(page);\n    96\t    expect(await valueText(page)).toBe('y 0 2 [1/2]');\n    97\t    expect(await closePage(page)).toEqual([]);\n    98\t  });\n    99\t});\n   100\t\n   101\t/** Two line series, pinned at x = 2 (the plot's middle) by a click. */\n   102\tasync function pinnedTwo(page: Page): Promise<void> {\n   103\t  const data = [0, 1, 2].flatMap(x => ['North', 'South'].map((s, i) => ({ x, s, y: x + i * 3 })));\n   104\t  // Fixed domains: an append at x = 3 moves nothing that is drawn at x = 2, where the pin is.\n   105\t  await create(page, 'line', { title: 'Two', data, x: { field: 'x', domain: [0, 4] }, y: { field: 'y', domain: [0, 10] }, series: 's' });\n   106\t  const p = await plotBox(page);\n   107\t  await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   108\t  await page.mouse.down();\n   109\t  await page.mouse.up();\n   110\t  await settle(page);\n   111\t  expect((await tip(page)).pinned).toBe(true);\n   112\t}\n   113\t\n   114\tdescribe('findings 6 and 7, mutation 6: pinned content is real and stable', () => {\n   115\t  it('a pinned tooltip\\'s rows are buttons named by their text in Chrome\\'s tree; hovered, none', async () => {\n   116\t    const page = await chartPage();\n   117\t    const data = [0, 1, 2].flatMap(x => ['North', 'South'].map((s, i) => ({ x, s, y: x + i * 3 })));\n   118\t    await create(page, 'line', { title: 'Two', data, x: 'x', y: 'y', series: 's' });\n   119\t    const p = await plotBox(page);\n   120\t    await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   121\t    await settle(page);\n   122\t    expect(await axButtons(page, '#chart .axylo-tooltip')).toEqual([]);\n   123\t    await page.mouse.down();\n   124\t    await page.mouse.up();\n   125\t    await settle(page);\n   126\t    const buttons = await axButtons(page, '#chart .axylo-tooltip');\n   127\t    expect(buttons).toHaveLength(2);\n   128\t    expect(buttons[0]).toMatch(/^North\\s*\\S+/);\n   129\t    expect(buttons[1]).toMatch(/^South\\s*\\S+/);\n   130\t    expect(await closePage(page)).toEqual([]);\n   131\t  });\n   132\t\n   133\t  it('a press on the secondary row held across an append that commits still selects that row, once', async () => {\n   134\t    const page = await chartPage();\n   135\t    await pinnedTwo(page);\n   136\t    await recordEvents(page);\n   137\t    const row = page.locator('#chart .axylo-tooltip button', { hasText: 'South' });\n   138\t    const b = (await row.boundingBox())!;\n   139\t    const before = await row.elementHandle();\n   140\t    await page.mouse.move(b.x + b.width / 2, b.y + b.height / 2);\n   141\t    await page.mouse.down();\n   142\t    await page.evaluate(() => window.charts[0]!.append([{ x: 3, s: 'North', y: 1 }]));\n   143\t    await settle(page);\n   144\t    expect(await page.evaluate(([a]) => (a as Element).isConnected, [before])).toBe(true);\n   145\t    await page.mouse.up();\n   146\t    await settle(page);\n   147\t    const s = await selected(page);\n   148\t    expect(s).toHaveLength(1);\n   149\t    expect(s[0]).toMatchObject({ series: 'South', x: 2 });\n   150\t    expect(await closePage(page)).toEqual([]);\n   151\t  });\n   152\t\n   153\t  it('ten coincident points of one series pinned: \"+2 more\" is a button that shows the other two, and each can be selected', async () => {\n   154\t    const page = await chartPage();\n   155\t    const data = [...Array.from({ length: 10 }, (_, i) => ({ x: 5, y: 5, s: 'A', id: i })), { x: 1, y: 1, s: 'A', id: 10 }, { x: 9, y: 9, s: 'A', id: 11 }];\n   156\t    await create(page, 'scatter', { title: 'Same', data, x: 'x', y: 'y', series: 's' });\n   157\t    await recordEvents(page);\n   158\t    const p = await plotBox(page);\n   159\t    await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   160\t    await page.mouse.down();\n   161\t    await page.mouse.up();\n   162\t    await settle(page);\n   163\t    const ids = new Set<number>();\n   164\t    for (const e of await selected(page)) ids.add((e.row as { id: number }).id);\n   165\t    const more = page.locator('#chart .axylo-tooltip button.axylo-tooltip-more');\n   166\t    expect(await more.textContent()).toBe('+2 more');\n   167\t    await more.click();\n   168\t    await settle(page);\n   169\t    const rows = page.locator('#chart .axylo-tooltip button.axylo-tooltip-row');\n   170\t    expect(await rows.count()).toBe(2);\n   171\t    for (let i = 0; i < 2; i++) {\n   172\t      await rows.nth(i).click();\n   173\t      await settle(page);\n   174\t    }\n   175\t    for (const e of await selected(page)) ids.add((e.row as { id: number }).id);\n   176\t    // The pick's first, and the two that were past the eight.\n   177\t    expect(ids.size).toBe(3);\n   178\t    for (const id of ids) expect(id).toBeLessThan(10);\n   179\t    expect(await closePage(page)).toEqual([]);\n   180\t  });\n   181\t\n   182\t  it('mutation 8: on a touch page, a tap on the second entry of a pinned strip selects exactly that series, x and row', async () => {\n   183\t    const page = await chartPage({ hasTouch: true, css: '#chart { width: 220px; height: 420px; }' });\n   184\t    const data = [0, 1, 2].flatMap(x => ['Na', 'So'].map((s, i) => ({ x, s, y: x + i * 3, id: `${s}${x}` })));\n   185\t    await create(page, 'line', { title: 'Narrow', data, x: 'x', y: 'y', series: 's' });\n   186\t    await recordEvents(page);\n   187\t    const p = await plotBox(page);\n   188\t    await page.touchscreen.tap(p.x + p.width / 2, p.y + p.height / 2);\n   189\t    await settle(page);\n   190\t    const entries = page.locator('#chart .axylo-readout button.axylo-readout-entry');\n   191\t    expect(await entries.count()).toBe(2);\n   192\t    const b = (await entries.nth(1).boundingBox())!;\n   193\t    expect(b.height).toBeGreaterThanOrEqual(24);\n   194\t    await page.touchscreen.tap(b.x + b.width / 2, b.y + b.height / 2);\n   195\t    await settle(page);\n   196\t    const s = await selected(page);\n   197\t    expect(s.at(-1)).toMatchObject({ series: 'So', x: 1, row: { id: 'So1' } });\n   198\t    expect(await closePage(page)).toEqual([]);\n   199\t  });\n   200\t\n   201\t  it('a narrow strip always keeps the x and one row', async () => {\n   202\t    const page = await chartPage({ css: '#chart { width: 200px; height: 420px; }' });\n   203\t    const names = ['A very long series name indeed', 'Another very long series name', 'Third long name'];\n   204\t    await create(page, 'line', { title: 'N', data: [0, 1].flatMap(x => names.map((s, i) => ({ x, s, y: i + x }))), x: 'x', y: 'y', series: 's' });\n   205\t    const p = await plotBox(page);\n   206\t    await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   207\t    await settle(page);\n   208\t    const text = (await strip(page)).text ?? '';\n   209\t    expect(text).toMatch(/^\\d: /);\n   210\t    expect(await page.locator('#chart .axylo-readout .axylo-readout-entry').count()).toBeGreaterThanOrEqual(1);\n   211\t    expect(await closePage(page)).toEqual([]);\n   212\t  });\n   213\t});\n   214\t\n   215\tdescribe('finding 9: a pin and a dismissal belong to the datum the reader chose', () => {\n   216\t  async function single(page: Page): Promise<Pt> {\n   217\t    await create(page, 'scatter', { title: 'P', data: [{ x: 5, y: 5, s: 'A' }, { x: 1, y: 1, s: 'B' }, { x: 9, y: 9, s: 'B' }], x: { field: 'x', domain: [0, 10] }, y: { field: 'y', domain: [0, 10] }, series: 's' });\n   218\t    const p = await plotBox(page);\n   219\t    return { x: p.x + p.width / 2, y: p.y + p.height / 2 };\n   220\t  }\n   221\t\n   222\t  it('pin A alone, append coincident B, hide A from the keyboard legend: the pin ends', async () => {\n   223\t    const page = await chartPage();\n   224\t    const at = await single(page);\n   225\t    await page.mouse.move(at.x, at.y);\n   226\t    await page.mouse.down();\n   227\t    await page.mouse.up();\n   228\t    await settle(page);\n   229\t    expect(await tip(page)).toMatchObject({ pinned: true });\n   230\t    await page.evaluate(() => window.charts[0]!.append([{ x: 5, y: 5, s: 'B' }]));\n   231\t    await settle(page);\n   232\t    expect((await tip(page)).rows.length).toBe(2);\n   233\t    const a = page.locator('#chart .axylo-legend-entry', { hasText: 'A' });\n   234\t    await a.focus();\n   235\t    await page.keyboard.press('Enter');\n   236\t    await settle(page);\n   237\t    expect((await tip(page)).pinned).toBe(false);\n   238\t    expect(await closePage(page)).toEqual([]);\n   239\t  });\n   240\t\n   241\t  it('dismiss A with Escape, append coincident B under the still pointer: it stays closed', async () => {\n   242\t    const page = await chartPage();\n   243\t    const at = await single(page);\n   244\t    await page.mouse.move(at.x, at.y);\n   245\t    await frames(page, 2);\n   246\t    expect((await tip(page)).title).not.toBeNull();\n   247\t    await page.keyboard.press('Escape');\n   248\t    await settle(page);\n   249\t    expect((await tip(page)).title).toBeNull();\n   250\t    await page.evaluate(() => window.charts[0]!.append([{ x: 5, y: 5, s: 'B' }]));\n   251\t    await settle(page);\n   252\t    expect((await tip(page)).title).toBeNull();\n   253\t    expect(await closePage(page)).toEqual([]);\n   254\t  });\n   255\t});\n   256\t\n   257\tdescribe('finding 10: the box is every displayed series at x, also in single-series mode', () => {\n   258\t  it('narrowed to the lower series by the keyboard, the tooltip covers neither series\\' point at that x', async () => {\n   259\t    const page = await chartPage({ css: '#chart { width: 640px; height: 400px; }' });\n   260\t    const data = [0, 5, 10].flatMap(x => [{ x, s: 'a', y: 40 }, { x, s: 'b', y: 52 }]);\n   261\t    await create(page, 'line', { title: 'Close', data, x: { field: 'x', domain: [0, 10] }, y: { field: 'y', domain: [0, 100] }, series: 's' });\n   262\t    await page.locator(proxy).focus();\n   263\t    await page.keyboard.press('ArrowRight');\n   264\t    await page.keyboard.press('ArrowDown');\n   265\t    await settle(page);\n   266\t    expect(await valueText(page)).toMatch(/^a, 5/);\n   267\t    const p = await plotBox(page);\n   268\t    const screen = (y: number): Pt => ({ x: p.x + p.width / 2, y: p.y + p.height * (1 - y / 100) });\n   269\t    const t = (await tip(page)).box!;\n   270\t    for (const y of [40, 52]) {\n   271\t      const c = screen(y);\n   272\t      expect(overlaps(t, { x: c.x - 6, y: c.y - 6, width: 12, height: 12 }), `the tooltip ${JSON.stringify(t)} covers the point at y ${y}`).toBe(false);\n   273\t    }\n   274\t    expect(await closePage(page)).toEqual([]);\n   275\t  });\n   276\t});\n   277\t\n   278\tdescribe('finding 4 and mutation 4: placement inside the part of the plot that is visible', () => {\n   279\t  it('in a card that clips the chart, the floating tooltip stays inside the card, and the pinned rows are the topmost element at their centres', async () => {\n   280\t    const page = await chartPage({ css: '#card { width: 360px; height: 220px; overflow: hidden; margin-top: 40px; } #card #chart { width: 360px; height: 320px; }' });\n   281\t    await page.evaluate(() => {\n   282\t      const card = Object.assign(document.createElement('div'), { id: 'card' });\n   283\t      const chart = document.getElementById('chart')!;\n   284\t      chart.replaceWith(card);\n   285\t      card.appendChild(chart);\n   286\t    });\n   287\t    const data = ['A', 'B', 'C', 'D'].flatMap(s => [0, 1, 2, 3].map(x => ({ x, s, y: x + s.charCodeAt(0) })));\n   288\t    await create(page, 'line', { title: 'Clipped', data, x: 'x', y: 'y', series: 's' });\n   289\t    const card = (await page.locator('#card').boundingBox())!;\n   290\t    const p = await plotBox(page);\n   291\t    const failures: string[] = [];\n   292\t    for (const share of [0.1, 0.5, 0.9]) {\n   293\t      const at = { x: p.x + p.width * share, y: Math.min(card.y + card.height - 10, p.y + p.height / 2) };\n   294\t      await page.mouse.move(at.x, at.y);\n   295\t      await settle(page);\n   296\t      const t = (await tip(page)).box;\n   297\t      if (!t) { failures.push(`share ${share}: no tooltip`); continue; }\n   298\t      if (t.x < card.x - 0.5 || t.y < card.y - 0.5 || t.x + t.width > card.x + card.width + 0.5 || t.y + t.height > card.y + card.height + 0.5) failures.push(`share ${share}: ${JSON.stringify(t)} outside the card ${JSON.stringify(card)}`);\n   299\t      await page.mouse.down();\n   300\t      await page.mouse.up();\n   301\t      await settle(page);\n   302\t      for (const b of await page.locator('#chart .axylo-tooltip button').all()) {\n   303\t        const r = (await b.boundingBox())!;\n   304\t        const top = await page.evaluate(({ x, y }) => document.elementFromPoint(x, y)?.closest('button')?.textContent ?? null, { x: r.x + r.width / 2, y: r.y + r.height / 2 });\n   305\t        if (top !== (await b.textContent())) failures.push(`share ${share}: the row \"${await b.textContent()}\" is not hittable (${top})`);\n   306\t      }\n   307\t      await page.keyboard.press('Escape');\n   308\t    }\n   309\t    expect(failures).toEqual([]);\n   310\t    expect(await closePage(page)).toEqual([]);\n   311\t  });\n   312\t});\n   313\t\n   314\tdescribe('finding 13: one mapping from fractional sizes under a transformed ancestor', () => {\n   315\t  for (const transform of ['scale(1.015)', 'translate(13.3px, 7.7px) scale(1.25, 0.8)']) {\n   316\t    it(`under ${transform}, pointing at each of the last bars' painted centres shows that bar`, async () => {\n   317\t      if (RENDERER === 'canvas') return; // the painted centres are read from the SVG marks\n   318\t      const page = await chartPage({ css: `#wrap { transform: ${transform}; transform-origin: 0 0; width: 640px; } #chart { width: 620px; height: 360px; }` });\n   319\t      await page.evaluate(() => {\n   320\t        const wrap = Object.assign(document.createElement('div'), { id: 'wrap' });\n   321\t        const chart = document.getElementById('chart')!;\n   322\t        chart.replaceWith(wrap);\n   323\t        wrap.appendChild(chart);\n   324\t      });\n   325\t      const names = Array.from({ length: 40 }, (_, i) => `C${i}`);\n   326\t      await create(page, 'bar', { title: 'Many', data: names.map((x, i) => ({ x, y: 10 + (i % 5) })), x: 'x', y: 'y' });\n   327\t      const bars: DrawnShape[] = ((await drawnShapes(page, 100000))[1] ?? []).filter(b => b.sub === 'rect').sort((a, b) => a.box.x - b.box.x);\n   328\t      const p = await plotBox(page);\n   329\t      const failures: string[] = [];\n   330\t      const view = await page.evaluate(() => ({ x: 0, y: 0, width: document.documentElement.clientWidth, height: document.documentElement.clientHeight }));\n   331\t      const shown = bars.filter(b => inside({ x: b.box.x + b.box.width / 2, y: b.box.y + b.box.height / 2 }, p) && inside({ x: b.box.x + b.box.width / 2, y: b.box.y + b.box.height / 2 }, view));\n   332\t      for (const bar of shown.slice(-6)) {\n   333\t        const k = bars.indexOf(bar);\n   334\t        await page.mouse.move(bar.box.x + bar.box.width / 2, bar.box.y + bar.box.height / 2);\n   335\t        await frames(page, 2);\n   336\t        const title = (await tip(page)).title;\n   337\t        if (title !== names[k]) failures.push(`bar ${names[k]} shows ${title}`);\n   338\t      }\n   339\t      expect(shown.length).toBeGreaterThan(6);\n   340\t      expect(failures).toEqual([]);\n   341\t      expect(await closePage(page)).toEqual([]);\n   342\t    });\n   343\t  }\n   344\t});\n   345\t\n   346\tdescribe('mutation 9: narrowed scatter driven by input and by change alone, then after an append', () => {\n   347\t  for (const form of ['input', 'change'] as const) {\n   348\t    it(`A0 B1 A2 B3 A4, narrowed to B, set to 2 by ${form} only: A2 and every series; append A5, Right: B3`, async () => {\n   349\t      const page = await chartPage();\n   350\t      const data = [0, 1, 2, 3, 4].map(x => ({ x, y: x, s: x % 2 ? 'B' : 'A' }));\n   351\t      await create(page, 'scatter', { title: 'N', data, x: 'x', y: 'y', series: 's' });\n   352\t      await page.locator(proxy).focus();\n   353\t      await page.keyboard.press('ArrowDown');\n   354\t      await settle(page);\n   355\t      expect(await valueText(page)).toMatch(/^B, /);\n   356\t      await page.evaluate(form => {\n   357\t        const el = document.querySelector('#chart .axylo-proxy') as HTMLInputElement;\n   358\t        el.value = '2';\n","exit_code":0,"status":"completed"}}
