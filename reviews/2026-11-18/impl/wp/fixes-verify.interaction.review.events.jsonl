and tooltip swatch', () => {\n   376\t  it('eight area series: the shape drawn for each series is the shape in its legend entry and its tooltip row', async () => {\n   377\t    if (RENDERER === 'canvas') return; // plotted shapes are read from the SVG marks\n   378\t    const page = await chartPage({ css: '#chart { width: 900px; height: 480px; }' });\n   379\t    const eight = ['a', 'b', 'c', 'd', 'e', 'f', 'g', 'h'];\n   380\t    const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n   381\t    await create(page, 'area', { title: 'Areas', data: Array.from({ length: 60 }, (_, k) => eight.map((s, i) => ({ day: day(k), s, v: 10 * i + (k % 5) }))).flat(), x: { field: 'day', type: 'date' }, y: 'v', series: 's' });\n   382\t    const drawn = await drawnShapes(page, 14);\n   383\t    const common = (list: DrawnShape[]) => {\n   384\t      const n = new Map<string, number>();\n   385\t      for (const d of list) n.set(signature(d.sub), (n.get(signature(d.sub)) ?? 0) + 1);\n   386\t      return [...n.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] ?? '';\n   387\t    };\n   388\t    const plotted = eight.map((_, i) => common(drawn[i + 1] ?? []));\n   389\t    const swatches = async (where: string) => (await page.locator(`#chart ${where}`).evaluateAll(els => els.map(e => e.querySelector('.axylo-swatch-marker')?.getAttribute('d') ?? '')))\n   390\t      .map(d => d ? signature(d.split(/(?=M)/)[0]!) : '');\n   391\t    expect(plotted.every(s => s !== ''), JSON.stringify(plotted)).toBe(true);\n   392\t    expect(await swatches('.axylo-legend-entry')).toEqual(plotted);\n   393\t    const p = await plotBox(page);\n   394\t    await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   395\t    await settle(page);\n   396\t    expect(await swatches('.axylo-tooltip-row')).toEqual(plotted);\n   397\t    expect(new Set(plotted).size).toBeGreaterThanOrEqual(4);\n   398\t    expect(await closePage(page)).toEqual([]);\n   399\t  });\n   400\t});\n   401\t\n   402\tvoid (null as unknown as Box);\n   403\t\n   404\t/** A marker's identity whatever its size and place: its commands and its vertices scaled to its box, rounded. */\n   405\tfunction signature(sub: string): string {\n   406\t  if (/A/i.test(sub)) return 'round';\n   407\t  const nums = (sub.match(/-?\\d*\\.?\\d+(?:e-?\\d+)?/gi) ?? []).map(Number);\n   408\t  const pts: [number, number][] = [];\n   409\t  for (let i = 0; i + 1 < nums.length; i += 2) pts.push([nums[i]!, nums[i + 1]!]);\n   410\t  if (!pts.length) return '';\n   411\t  const x0 = Math.min(...pts.map(p => p[0])), y0 = Math.min(...pts.map(p => p[1]));\n   412\t  const size = Math.max(Math.max(...pts.map(p => p[0])) - x0, Math.max(...pts.map(p => p[1])) - y0) || 1;\n   413\t  return [...new Set(pts.map(([x, y]) => `${Math.round(4 * (x - x0) / size)},${Math.round(4 * (y - y0) / size)}`))].sort().join(' ');\n   414\t}\n","exit_code":0,"status":"completed"}}
