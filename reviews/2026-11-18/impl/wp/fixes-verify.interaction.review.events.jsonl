{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc 'git show bbd7564:packages/axylo/test/browser/chart/final-hold.browser.test.ts | nl -ba'","aggregated_output":"     1\t/**\n     2\t * What is shown, as one state machine (decision 0004 revision 3, rules 3, 3b, 4, 7 and 8), against the final\n     3\t * interaction review's findings 1, 5, 8, 15 and 16 and earlier C3-3 and C3-6, each with the reviewer's\n     4\t * sequence (reviews/2026-11-18/impl/wp/core-final.interaction.review.md).\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport { chartPage, closePage } from './util';\n    10\timport {\n    11\t  TALL, create, frames, inside, nearestInside, plotBox, recordEvents, selected, settle, strip, tip, walk, type Box, type Pt,\n    12\t} from './final-util';\n    13\t\n    14\tbeforeAll(start);\n    15\tafterAll(stop);\n    16\t\n    17\t/** The tall bars at 640 × 360; the resting point on Q3 and the plot box. */\n    18\tasync function tallBars(page: Page): Promise<{ at: Pt; p: Box }> {\n    19\t  await create(page, 'bar', { title: 'Tall', data: TALL, x: 'x', y: 'y' });\n    20\t  const p = await plotBox(page);\n    21\t  return { at: { x: p.x + p.width * (2.5 / 6), y: p.y + p.height * 0.6 }, p };\n    22\t}\n    23\t\n    24\t/** Rest on Q3, then go into the corridor to its tooltip (beside it, over Q4's band) and stop there, Q3 still shown. */\n    25\tasync function intoCorridor(page: Page): Promise<{ at: Pt; p: Box; over: Pt; start: Box }> {\n    26\t  const { at, p } = await tallBars(page);\n    27\t  await page.mouse.move(at.x, at.y);\n    28\t  await frames(page, 2);\n    29\t  const first = await tip(page);\n    30\t  expect(first.title).toBe('Q3');\n    31\t  await page.waitForTimeout(320);\n    32\t  // A point of the tooltip's rectangle past the band edge between Q3 and Q4.\n    33\t  const edge = p.x + p.width * (3 / 6);\n    34\t  const target = nearestInside(first.box!, at);\n    35\t  const over = { x: Math.max(target.x, edge + 4), y: target.y };\n    36\t  expect(inside(over, first.box!), 'the tooltip reaches over Q4\\'s band').toBe(true);\n    37\t  const seen = await walk(page, at, over, 12, async () => (await tip(page)).title);\n    38\t  expect(seen.every(t => t === 'Q3'), `held along the corridor: ${seen.join(', ')}`).toBe(true);\n    39\t  return { at, p, over, start: first.box! };\n    40\t}\n    41\t\n    42\tdescribe('finding 1 and mutation 1: activation picks afresh, never from the hold', () => {\n    43\t  it('rest on Q3, cross into Q4 along the corridor with Q3 still shown, click: Q4\\'s exact datum and row are selected and pinned', async () => {\n    44\t    const page = await chartPage({ css: '#chart { width: 640px; height: 360px; }' });\n    45\t    const { over } = await intoCorridor(page);\n    46\t    await recordEvents(page);\n    47\t    expect((await tip(page)).title).toBe('Q3');\n    48\t    await page.mouse.down();\n    49\t    await page.mouse.up();\n    50\t    await settle(page);\n    51\t    const s = await selected(page);\n    52\t    expect(s).toHaveLength(1);\n    53\t    expect(s[0]).toMatchObject({ x: 'Q4', y: 99, index: 3, row: { x: 'Q4', y: 99 } });\n    54\t    const after = await tip(page);\n    55\t    expect(after.title).toBe('Q4');\n    56\t    expect(after.pinned).toBe(true);\n    57\t    void over;\n    58\t    expect(await closePage(page)).toEqual([]);\n    59\t  });\n    60\t\n    61\t  it('scatter: B under A\\'s tooltip, reached along A\\'s corridor after a rest: a click selects B', async () => {\n    62\t    const page = await chartPage({ css: '#chart { width: 640px; height: 400px; }' });\n    63\t    const axes = { x: { field: 'x', domain: [0, 100] }, y: { field: 'y', domain: [0, 100] } };\n    64\t    // First where A's tooltip goes, then B put under its centre.\n    65\t    await create(page, 'scatter', { title: 'S', data: [{ x: 50, y: 30, s: 'A' }], ...axes, series: 's' });\n    66\t    const p = await plotBox(page);\n    67\t    const screen = (x: number, y: number): Pt => ({ x: p.x + (x / 100) * p.width, y: p.y + p.height * (1 - y / 100) });\n    68\t    const a = screen(50, 30);\n    69\t    await page.mouse.move(a.x, a.y);\n    70\t    await frames(page, 2);\n    71\t    const t = (await tip(page)).box!;\n    72\t    const c = { x: t.x + t.width / 2, y: t.y + t.height / 2 };\n    73\t    const b = { x: ((c.x - p.x) / p.width) * 100, y: (1 - (c.y - p.y) / p.height) * 100 };\n    74\t    await page.mouse.move(5, 5);\n    75\t    await page.evaluate(b => window.charts[0]!.update({ data: [{ x: 50, y: 30, s: 'A' }, { x: b.x, y: b.y, s: 'B' }] }), b);\n    76\t    await settle(page);\n    77\t    await recordEvents(page);\n    78\t    await page.mouse.move(a.x, a.y);\n    79\t    await frames(page, 2);\n    80\t    expect((await tip(page)).rows.join(' ')).toMatch(/^A/);\n    81\t    await page.waitForTimeout(320);\n    82\t    const seen = await walk(page, a, c, 12, async () => (await tip(page)).rows.join(' '));\n    83\t    expect(seen.every(r => /^A/.test(r)), `A held on the way: ${seen.join(' | ')}`).toBe(true);\n    84\t    await page.mouse.down();\n    85\t    await page.mouse.up();\n    86\t    await settle(page);\n    87\t    const s = await selected(page);\n    88\t    expect(s).toHaveLength(1);\n    89\t    expect(s[0]!.series).toBe('B');\n    90\t    expect(await closePage(page)).toEqual([]);\n    91\t  });\n    92\t\n    93\t  it('donut: a click on the empty hole selects nothing and ends a pin', async () => {\n    94\t    const page = await chartPage({ css: '#chart { width: 640px; height: 400px; }' });\n    95\t    await create(page, 'donut', { title: 'D', data: [{ k: 'a', v: 3 }, { k: 'b', v: 2 }, { k: 'c', v: 1 }], label: 'k', value: 'v' });\n    96\t    await recordEvents(page);\n    97\t    const p = await plotBox(page);\n    98\t    const centre = { x: p.x + p.width / 2, y: p.y + p.height / 2 };\n    99\t    // A slice: on the ring, straight above the centre (the first slice starts at 12 o'clock).\n   100\t    const r = Math.min(p.width, p.height) * 0.4;\n   101\t    await page.mouse.move(centre.x + 10, centre.y - r);\n   102\t    await frames(page, 2);\n   103\t    await page.mouse.down();\n   104\t    await page.mouse.up();\n   105\t    await settle(page);\n   106\t    expect(await selected(page)).toHaveLength(1);\n   107\t    expect((await tip(page)).pinned).toBe(true);\n   108\t    await page.mouse.move(centre.x, centre.y + 3);\n   109\t    await page.mouse.down();\n   110\t    await page.mouse.up();\n   111\t    await settle(page);\n   112\t    expect(await selected(page)).toHaveLength(1);\n   113\t    expect((await tip(page)).pinned).toBe(false);\n   114\t    expect(await closePage(page)).toEqual([]);\n   115\t  });\n   116\t});\n   117\t\n   118\tdescribe('finding 5: every placement has a route after a rest', () => {\n   119\t  it('a dense line with points at the plot\\'s left edge and 2 px in: after a rest on the first, the straight way onto its tooltip keeps it', async () => {\n   120\t    const page = await chartPage({ css: '#chart { width: 640px; height: 360px; }' });\n   121\t    // 300 x positions over the plot's width: about 2 px apart.\n   122\t    await create(page, 'line', { title: 'Dense', data: Array.from({ length: 300 }, (_, i) => ({ x: i, y: Math.sin(i / 9) * 10 + 50 })), x: 'x', y: 'y' });\n   123\t    const p = await plotBox(page);\n   124\t    const at = { x: p.x + 0.4, y: p.y + p.height / 2 };\n   125\t    await page.mouse.move(at.x, at.y);\n   126\t    await frames(page, 2);\n   127\t    const first = await tip(page);\n   128\t    expect(first.title).toBe('0');\n   129\t    await page.waitForTimeout(320);\n   130\t    const target = nearestInside(first.box!, at);\n   131\t    const seen = await walk(page, at, { x: target.x + 20, y: target.y }, 24, async () => {\n   132\t      const t = await tip(page);\n   133\t      return `${t.title}@${t.box ? Math.round(t.box.x) : '-'}`;\n   134\t    });\n   135\t    expect(new Set(seen), seen.join(', ')).toEqual(new Set([`0@${Math.round(first.box!.x)}`]));\n   136\t    expect(await closePage(page)).toEqual([]);\n   137\t  });\n   138\t\n   139\t  it('readout mode, horizontal bars: from an upper category, after a rest, the way down to the strip keeps it and ends on the strip', async () => {\n   140\t    const page = await chartPage({ css: '#chart { width: 220px; height: 420px; }' });\n   141\t    await create(page, 'bar', { title: 'H', horizontal: true, data: ['Alpha', 'Bravo', 'Charlie', 'Delta', 'Echo'].map((x, i) => ({ x, y: i + 2 })), x: 'x', y: 'y' });\n   142\t    const p = await plotBox(page);\n   143\t    const at = { x: p.x + p.width * 0.3, y: p.y + p.height * 0.1 };\n   144\t    await page.mouse.move(at.x, at.y);\n   145\t    await frames(page, 2);\n   146\t    const before = (await strip(page)).text;\n   147\t    expect(before).toMatch(/Alpha|Echo/);\n   148\t    await page.waitForTimeout(320);\n   149\t    const s = (await strip(page)).box;\n   150\t    const target = nearestInside(s, at);\n   151\t    const seen = await walk(page, at, target, 30, async () => (await strip(page)).text);\n   152\t    expect(seen.every(t => t === before), seen.join(' | ')).toBe(true);\n   153\t    expect(await closePage(page)).toEqual([]);\n   154\t  });\n   155\t\n   156\t  it('readout mode, an isolated scatter point: after a rest, the way to the strip across empty plot keeps the reading', async () => {\n   157\t    const page = await chartPage({ css: '#chart { width: 220px; height: 420px; }' });\n   158\t    await create(page, 'scatter', { title: 'S', data: [{ x: 1, y: 9 }, { x: 9, y: 1 }], x: { field: 'x', domain: [0, 10] }, y: { field: 'y', domain: [0, 10] } });\n   159\t    const p = await plotBox(page);\n   160\t    const at = { x: p.x + p.width * 0.1, y: p.y + p.height * 0.1 };\n   161\t    await page.mouse.move(at.x, at.y);\n   162\t    await frames(page, 2);\n   163\t    const before = (await strip(page)).text;\n   164\t    expect(before).toMatch(/1/);\n   165\t    await page.waitForTimeout(320);\n   166\t    const target = nearestInside((await strip(page)).box, at);\n   167\t    const seen = await walk(page, at, target, 30, async () => (await strip(page)).text);\n   168\t    expect(seen.every(t => t === before), seen.join(' | ')).toBe(true);\n   169\t    expect(await closePage(page)).toEqual([]);\n   170\t  });\n   171\t\n   172\t  it('without a rest the same way to the strip is never held (rule 3b: a sweep never stalls)', async () => {\n   173\t    const page = await chartPage({ css: '#chart { width: 220px; height: 420px; }' });\n   174\t    await create(page, 'scatter', { title: 'S', data: [{ x: 1, y: 9 }, { x: 9, y: 1 }], x: { field: 'x', domain: [0, 10] }, y: { field: 'y', domain: [0, 10] } });\n   175\t    const p = await plotBox(page);\n   176\t    const at = { x: p.x + p.width * 0.1, y: p.y + p.height * 0.1 };\n   177\t    await page.mouse.move(at.x, at.y);\n   178\t    await frames(page, 2);\n   179\t    const target = nearestInside((await strip(page)).box, at);\n   180\t    const seen = await walk(page, at, target, 30, async () => (await strip(page)).text);\n   181\t    expect(seen.at(-1)).toBeNull();\n   182\t    expect(await closePage(page)).toEqual([]);\n   183\t  });\n   184\t});\n   185\t\n   186\tdescribe('finding 8 and mutation 5: a hold belongs to one datum, one geometry and one presentation', () => {\n   187\t  it('a stream commit that moves the bands while the pointer rests in the corridor: Q4 at once, without a move, and the next move in the old hull does not bring Q3 back', async () => {\n   188\t    const page = await chartPage({ css: '#chart { width: 640px; height: 360px; }' });\n   189\t    const { over } = await intoCorridor(page);\n   190\t    // A seventh category: every band narrows, so Q3's anchor and its tooltip's place change.\n   191\t    await page.evaluate(() => window.charts[0]!.append([{ x: 'Q7', y: 50 }]));\n   192\t    await settle(page);\n   193\t    const now = await tip(page);\n   194\t    const under = await page.evaluate(({ x }) => {\n   195\t      const p = document.querySelector('#chart .axylo-proxy')!.getBoundingClientRect();\n   196\t      return Math.floor(((x - p.x) / p.width) * 7);\n   197\t    }, over);\n   198\t    expect(now.title).toBe(`Q${under + 1}`);\n   199\t    expect(now.title).not.toBe('Q3');\n   200\t    await page.mouse.move(over.x - 1, over.y);\n   201\t    await frames(page, 2);\n   202\t    expect((await tip(page)).title).not.toBe('Q3');\n   203\t    expect(await closePage(page)).toEqual([]);\n   204\t  });\n   205\t\n   206\t  it('a resize into readout mode while the pointer is in the corridor: the hold ends, the strip shows the datum under the pointer', async () => {\n   207\t    const page = await chartPage({ css: '#chart { width: 640px; height: 360px; }' });\n   208\t    const { over } = await intoCorridor(page);\n   209\t    await page.evaluate(() => { document.getElementById('chart')!.style.width = '230px'; });\n   210\t    await settle(page);\n   211\t    await frames(page, 3);\n   212\t    expect((await tip(page)).title).toBeNull();\n   213\t    const shown = (await strip(page)).text;\n   214\t    // The pointer is now where the narrower plot has some other band, or nothing: never the held Q3.\n   215\t    const p = await plotBox(page);\n   216\t    const expected = inside(over, p) ? `Q${Math.floor(((over.y - p.y) / p.height) * 6) + 1}` : null;\n   217\t    void expected;\n   218\t    expect(shown === null || !/^Q3:/.test(shown)).toBe(true);\n   219\t    expect(await closePage(page)).toEqual([]);\n   220\t  });\n   221\t\n   222\t  it('the same commit with a pin keeps the pin on its datum; with the keyboard the reading stays on its datum', async () => {\n   223\t    const page = await chartPage({ css: '#chart { width: 640px; height: 360px; }' });\n   224\t    const { at } = await tallBars(page);\n   225\t    await page.mouse.move(at.x, at.y);\n   226\t    await page.mouse.down();\n   227\t    await page.mouse.up();\n   228\t    await settle(page);\n   229\t    expect(await tip(page)).toMatchObject({ title: 'Q3', pinned: true });\n   230\t    await page.evaluate(() => window.charts[0]!.append([{ x: 'Q7', y: 50 }]));\n   231\t    await settle(page);\n   232\t    expect(await tip(page)).toMatchObject({ title: 'Q3', pinned: true });\n   233\t    await page.mouse.move(5, 5);\n   234\t    await page.keyboard.press('Escape');\n   235\t    await page.locator('#chart .axylo-proxy').focus();\n   236\t    await page.keyboard.press('End');\n   237\t    await settle(page);\n   238\t    const text = await page.locator('#chart .axylo-proxy').getAttribute('aria-valuetext');\n   239\t    expect(text).toMatch(/^Q7/);\n   240\t    await page.evaluate(() => window.charts[0]!.append([{ x: 'Q8', y: 40 }]));\n   241\t    await settle(page);\n   242\t    expect(await page.locator('#chart .axylo-proxy').getAttribute('aria-valuetext')).toBe(text);\n   243\t    expect((await tip(page)).title).toBe('Q7');\n   244\t    expect(await closePage(page)).toEqual([]);\n   245\t  });\n   246\t\n   247\t  it('review C3-6: switching to compact and back while held starts from no hold: the first move picks', async () => {\n   248\t    const page = await chartPage({ css: '#chart { width: 640px; height: 360px; }' });\n   249\t    const { over } = await intoCorridor(page);\n   250\t    await page.evaluate(() => window.charts[0]!.update({ compact: true }));\n   251\t    await settle(page);\n   252\t    await page.evaluate(() => window.charts[0]!.update({ compact: false }));\n   253\t    await settle(page);\n   254\t    await page.mouse.move(over.x + 1, over.y);\n   255\t    await frames(page, 2);\n   256\t    const p = await plotBox(page);\n   257\t    const band = Math.floor(((over.x + 1 - p.x) / p.width) * 6);\n   258\t    expect((await tip(page)).title).toBe(`Q${band + 1}`);\n   259\t    expect(await closePage(page)).toEqual([]);\n   260\t  });\n   261\t});\n   262\t\n   263\tdescribe('finding 15: one Escape does one thing', () => {\n   264\t  it('in a modal dialog with a pin and single-series mode: the first Escape closes the pin only, the second leaves single mode, the third closes the dialog', async () => {\n   265\t    const page = await chartPage({ css: 'dialog { width: 700px; } #chart { width: 640px; height: 360px; }' });\n   266\t    await page.evaluate(() => {\n   267\t      const dialog = document.createElement('dialog');\n   268\t      document.body.appendChild(dialog);\n   269\t      dialog.appendChild(document.getElementById('chart')!);\n   270\t      dialog.showModal();\n   271\t    });\n   272\t    const data = [0, 1, 2, 3].flatMap(x => ['a', 'b'].map((s, i) => ({ x, s, y: x + i * 5 })));\n   273\t    await create(page, 'line', { title: 'Dialog', data, x: 'x', y: 'y', series: 's' });\n   274\t    await page.locator('#chart .axylo-proxy').focus();\n   275\t    await page.keyboard.press('ArrowDown');\n   276\t    await settle(page);\n   277\t    expect(await page.locator('#chart .axylo-proxy').getAttribute('aria-valuetext')).toMatch(/^a, /);\n   278\t    const p = await plotBox(page);\n   279\t    await page.mouse.move(p.x + p.width * 0.66, p.y + p.height / 2);\n   280\t    await page.mouse.down();\n   281\t    await page.mouse.up();\n   282\t    await settle(page);\n   283\t    expect((await tip(page)).pinned).toBe(true);\n   284\t    const open = () => page.evaluate(() => document.querySelector('dialog')!.open);\n   285\t    await page.keyboard.press('Escape');\n   286\t    await settle(page);\n   287\t    expect((await tip(page)).title).toBeNull();\n   288\t    expect(await open()).toBe(true);\n   289\t    // Still narrowed to one series: the reading names one series.\n   290\t    expect(await page.locator('#chart .axylo-proxy').getAttribute('aria-valuetext')).toM