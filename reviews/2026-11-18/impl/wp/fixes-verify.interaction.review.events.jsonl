{"type":"item.completed","item":{"id":"item_109","type":"command_execution","command":"/bin/bash -lc \"git show bbd7564:packages/axylo/test/browser/chart/final-util.ts | nl -ba | sed -n '10,33p'\"","aggregated_output":"    10\texport const frames = (page: Page, n = 1) => page.evaluate(k => window.nextFrames(k), n);\n    11\texport const settle = (page: Page) => page.evaluate(async () => { for (const c of window.charts) await c.__bench.ready(); await window.nextFrames(2); });\n    12\t\n    13\texport async function create(page: Page, kind: string, options: Record<string, unknown>, target = '#chart'): Promise<void> {\n    14\t  await page.evaluate(async ({ kind, options, target }) => {\n    15\t    const chart = window.Axylo[kind]!(target, options);\n    16\t    window.charts.push(chart);\n    17\t    await chart.__bench.ready();\n    18\t    await window.nextFrames(1);\n    19\t  }, { kind, options, target });\n    20\t}\n    21\t\n    22\t/** Records every `select` and `hover` of chart `i` on `window.selected` / `window.hovered`. */\n    23\texport async function recordEvents(page: Page, i = 0): Promise<void> {\n    24\t  await page.evaluate(i => {\n    25\t    const w = window as unknown as { selected: unknown[]; hovered: unknown[] };\n    26\t    w.selected = [];\n    27\t    w.hovered = [];\n    28\t    window.charts[i]!.on('select', p => w.selected.push(p));\n    29\t    window.charts[i]!.on('hover', p => w.hovered.push(p));\n    30\t  }, i);\n    31\t}\n    32\t\n    33\texport const selected = (page: Page) => page.evaluate(() => (window as unknown as { selected: { series: string; x: unknown; y: number | null; row: unknown; index: number }[] }).selected);\n","exit_code":0,"status":"completed"}}
