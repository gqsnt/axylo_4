{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'git show bbd7564:packages/axylo/src/dom/placement.ts | nl -ba'","aggregated_output":"     1\t/**\n     2\t * Where a floating tooltip goes (decision 0004 revision 3, rules 1, 2 and 6), as pure arithmetic over\n     3\t * rectangles in viewport pixels, so it runs and is tested in Node. The DOM side (tooltip.ts) measures the\n     4\t * tooltip and the obstacles and applies the result.\n     5\t *\n     6\t * - Candidates in order: above, below, right, left of the datum's box (horizontal bars: right, left, above,\n     7\t *   below); a donut tries its hole first.\n     8\t * - Along the free axis a candidate is centred on the box and shifted only as far as needed to be valid.\n     9\t * - Valid: wholly inside the visible part of the plot, and overlapping neither the box, nor any control, nor\n    10\t *   any focus ring. The hole is the one exception to the box: there the tooltip's four corners must lie\n    11\t *   inside the hole (the inner radius less the slice outline's clearance), and only the focus rings' strokes\n    12\t *   are kept clear, not their filled rectangles.\n    13\t * - Rule 6's last resort (`fallback`): each candidate pushed into the visible part, shifted along its free\n    14\t *   axis clear of every control and focus ring; the one that overlaps the box least. Controls and focus\n    15\t *   rings are never covered; when no such position exists the answer is null and nothing floats.\n    16\t */\n    17\timport type { Rect } from '../core/contracts';\n    18\t\n    19\t/** Gap between the datum's box and the tooltip. */\n    20\texport const OFFSET = 8;\n    21\tconst EPSILON = 1e-6;\n    22\t\n    23\texport interface Hole {\n    24\t  /** Centre and radii (an ellipse under a non-uniform scale) inside which the tooltip's corners must lie. */\n    25\t  readonly cx: number;\n    26\t  readonly cy: number;\n    27\t  readonly rx: number;\n    28\t  readonly ry: number;\n    29\t}\n    30\t\n    31\texport interface PlacementInput {\n    32\t  /** The datum's active marks enlarged by the focus ring's reach: never covered (except by rule 6). */\n    33\t  readonly box: Rect;\n    34\t  /** The visible part of the plot: the plot rectangle cut by the viewport and every clipping ancestor. */\n    35\t  readonly visible: Rect;\n    36\t  readonly order: 'vertical' | 'horizontal';\n    37\t  readonly hole: Hole | null;\n    38\t  readonly controls: readonly Rect[];\n    39\t  /** Outer rectangles of every focus ring on show (the keyboard's datum ring, wherever that datum is). */\n    40\t  readonly rings: readonly Rect[];\n    41\t  /** Width of a ring's stroke, surround included, for the hole's stroke test. */\n    42\t  readonly ringStroke: number;\n    43\t}\n    44\t\n    45\texport interface Spot {\n    46\t  readonly x: number;\n    47\t  readonly y: number;\n    48\t  readonly side: 'hole' | 'above' | 'below' | 'right' | 'left';\n    49\t}\n    50\t\n    51\ttype Side = Exclude<Spot['side'], 'hole'>;\n    52\t\n    53\t/** The area two rectangles share (touching edges share none). */\n    54\texport function overlapArea(a: Rect, b: Rect): number {\n    55\t  const w = Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x);\n    56\t  const h = Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y);\n    57\t  return w > EPSILON && h > EPSILON ? w * h : 0;\n    58\t}\n    59\t\n    60\tfunction insideRect(r: Rect, outer: Rect): boolean {\n    61\t  return r.x >= outer.x - EPSILON && r.y >= outer.y - EPSILON &&\n    62\t    r.x + r.width <= outer.x + outer.width + EPSILON && r.y + r.height <= outer.y + outer.height + EPSILON;\n    63\t}\n    64\t\n    65\t/** A ring's four strokes, `stroke` wide, inside its outer rectangle. */\n    66\tfunction strokes(ring: Rect, stroke: number): Rect[] {\n    67\t  const s = Math.min(stroke, ring.width / 2, ring.height / 2);\n    68\t  return [\n    69\t    { x: ring.x, y: ring.y, width: ring.width, height: s },\n    70\t    { x: ring.x, y: ring.y + ring.height - s, width: ring.width, height: s },\n    71\t    { x: ring.x, y: ring.y, width: s, height: ring.height },\n    72\t    { x: ring.x + ring.width - s, y: ring.y, width: s, height: ring.height },\n    73\t  ];\n    74\t}\n    75\t\n    76\t/**\n    77\t * The position along one axis nearest `preferred`, in [lo, hi], outside every open interval in `blocked`;\n    78\t * null when there is none.\n    79\t */\n    80\tfunction nearestFree(preferred: number, lo: number, hi: number, blocked: readonly (readonly [number, number])[]): number | null {\n    81\t  if (hi < lo - EPSILON) return null;\n    82\t  const clamp = (v: number) => Math.max(lo, Math.min(hi, v));\n    83\t  const free = (v: number) => v >= lo - EPSILON && v <= hi + EPSILON && blocked.every(([a, b]) => v <= a + EPSILON || v >= b - EPSILON);\n    84\t  const options = [clamp(preferred)];\n    85\t  for (const [a, b] of blocked) options.push(a, b);\n    86\t  let best: number | null = null;\n    87\t  for (const v of options) {\n    88\t    if (!free(v)) continue;\n    89\t    if (best === null || Math.abs(v - preferred) < Math.abs(best - preferred) - EPSILON) best = v;\n    90\t  }\n    91\t  return best === null ? null : clamp(best);\n    92\t}\n    93\t\n    94\t/**\n    95\t * The tooltip on one side of the box, with its fixed coordinate `fixed`, shifted along the free axis clear\n    96\t * of `obstacles` and inside `visible`; null when no shift is clear.\n    97\t */\n    98\tfunction along(side: Side, fixed: number, preferred: number, width: number, height: number, visible: Rect, obstacles: readonly Rect[]): Spot | null {\n    99\t  const vertical = side === 'above' || side === 'below';\n   100\t  // Obstacles that meet the band the tooltip occupies across the free axis block an interval of it.\n   101\t  const blocked: [number, number][] = [];\n   102\t  for (const o of obstacles) {\n   103\t    if (vertical) {\n   104\t      if (Math.min(fixed + height, o.y + o.height) - Math.max(fixed, o.y) > EPSILON) blocked.push([o.x - width, o.x + o.width]);\n   105\t    } else if (Math.min(fixed + width, o.x + o.width) - Math.max(fixed, o.x) > EPSILON) {\n   106\t      blocked.push([o.y - height, o.y + o.height]);\n   107\t    }\n   108\t  }\n   109\t  const at = vertical\n   110\t    ? nearestFree(preferred, visible.x, visible.x + visible.width - width, blocked)\n   111\t    : nearestFree(preferred, visible.y, visible.y + visible.height - height, blocked);\n   112\t  if (at === null) return null;\n   113\t  return vertical ? { x: at, y: fixed, side } : { x: fixed, y: at, side };\n   114\t}\n   115\t\n   116\tfunction sides(order: PlacementInput['order']): Side[] {\n   117\t  return order === 'horizontal' ? ['right', 'left', 'above', 'below'] : ['above', 'below', 'right', 'left'];\n   118\t}\n   119\t\n   120\t/** The fixed coordinate of a side, and the centred preferred position along the free axis. */\n   121\tfunction anchorOf(side: Side, box: Rect, width: number, height: number): { fixed: number; preferred: number } {\n   122\t  switch (side) {\n   123\t    case 'above': return { fixed: box.y - OFFSET - height, preferred: box.x + box.width / 2 - width / 2 };\n   124\t    case 'below': return { fixed: box.y + box.height + OFFSET, preferred: box.x + box.width / 2 - width / 2 };\n   125\t    case 'right': return { fixed: box.x + box.width + OFFSET, preferred: box.y + box.height / 2 - height / 2 };\n   126\t    case 'left': return { fixed: box.x - OFFSET - width, preferred: box.y + box.height / 2 - height / 2 };\n   127\t  }\n   128\t}\n   129\t\n   130\t/** The hole candidate: centred, every corner inside the hole, no ring stroke or control under it. */\n   131\tfunction holeSpot(p: PlacementInput, width: number, height: number): Spot | null {\n   132\t  const hole = p.hole;\n   133\t  if (!hole || hole.rx <= 0 || hole.ry <= 0) return null;\n   134\t  const spot = { x: hole.cx - width / 2, y: hole.cy - height / 2, width, height };\n   135\t  // The corners are the farthest points of the rectangle from the centre.\n   136\t  const reach = (width / 2 / hole.rx) ** 2 + (height / 2 / hole.ry) ** 2;\n   137\t  if (reach > 1 + EPSILON || !insideRect(spot, p.visible)) return null;\n   138\t  if (p.controls.some(c => overlapArea(spot, c) > 0)) return null;\n   139\t  if (p.rings.some(r => strokes(r, p.ringStroke).some(s => overlapArea(spot, s) > 0))) return null;\n   140\t  return { x: spot.x, y: spot.y, side: 'hole' };\n   141\t}\n   142\t\n   143\t/** Rule 2: the first valid candidate for a tooltip of this size, or null. */\n   144\texport function placeTooltip(p: PlacementInput, width: number, height: number): Spot | null {\n   145\t  if (width > p.visible.width + EPSILON || height > p.visible.height + EPSILON) return null;\n   146\t  const hole = holeSpot(p, width, height);\n   147\t  if (hole) return hole;\n   148\t  const obstacles = [p.box, ...p.controls, ...p.rings];\n   149\t  for (const side of sides(p.order)) {\n   150\t    const { fixed, preferred } = anchorOf(side, p.box, width, height);\n   151\t    // The fixed coordinate must already be inside the visible part; only the free axis may shift.\n   152\t    const vertical = side === 'above' || side === 'below';\n   153\t    const inside = vertical\n   154\t      ? fixed >= p.visible.y - EPSILON && fixed + height <= p.visible.y + p.visible.height + EPSILON\n   155\t      : fixed >= p.visible.x - EPSILON && fixed + width <= p.visible.x + p.visible.width + EPSILON;\n   156\t    if (!inside) continue;\n   157\t    const spot = along(side, fixed, preferred, width, height, p.visible, obstacles);\n   158\t    if (spot) return spot;\n   159\t  }\n   160\t  return null;\n   161\t}\n   162\t\n   163\t/**\n   164\t * Rule 6's last resort, for one row that fits nowhere: each side pushed into the visible part and shifted\n   165\t * along its free axis clear of every control and focus ring; the one covering the box least. Null when no\n   166\t * such position exists (the tooltip is then not shown floating; the values are in the keyboard reading and\n   167\t * the table).\n   168\t */\n   169\texport function fallbackPlacement(p: PlacementInput, width: number, height: number): Spot | null {\n   170\t  if (width > p.visible.width + EPSILON || height > p.visible.height + EPSILON) return null;\n   171\t  const obstacles = [...p.controls, ...p.rings];\n   172\t  let best: { spot: Spot; cost: number } | null = null;\n   173\t  for (const side of sides(p.order)) {\n   174\t    const { fixed, preferred } = anchorOf(side, p.box, width, height);\n   175\t    const vertical = side === 'above' || side === 'below';\n   176\t    const pushed = vertical\n   177\t      ? Math.max(p.visible.y, Math.min(fixed, p.visible.y + p.visible.height - height))\n   178\t      : Math.max(p.visible.x, Math.min(fixed, p.visible.x + p.visible.width - width));\n   179\t    const spot = along(side, pushed, preferred, width, height, p.visible, obstacles);\n   180\t    if (!spot) continue;\n   181\t    const cost = overlapArea({ x: spot.x, y: spot.y, width, height }, p.box);\n   182\t    if (!best || cost < best.cost - EPSILON) best = { spot, cost };\n   183\t  }\n   184\t  return best?.spot ?? null;\n   185\t}\n   186\t\n   187\t/** Whether a tooltip at `spot` would be valid by rule 2 (for tests and for the caller's own checks). */\n   188\texport function validSpot(p: PlacementInput, spot: { x: number; y: number }, width: number, height: number): boolean {\n   189\t  const r = { x: spot.x, y: spot.y, width, height };\n   190\t  if (!insideRect(r, p.visible)) return false;\n   191\t  if (p.controls.some(c => overlapArea(r, c) > 0) || p.rings.some(c => overlapArea(r, c) > 0)) return false;\n   192\t  return overlapArea(r, p.box) === 0;\n   193\t}\n   194\t\n   195\t/** The rectangle two rectangles share, or an empty one at the first's corner. */\n   196\texport function intersect(a: Rect, b: Rect): Rect {\n   197\t  const x = Math.max(a.x, b.x);\n   198\t  const y = Math.max(a.y, b.y);\n   199\t  const right = Math.min(a.x + a.width, b.x + b.width);\n   200\t  const bottom = Math.min(a.y + a.height, b.y + b.height);\n   201\t  return { x, y, width: Math.max(0, right - x), height: Math.max(0, bottom - y) };\n   202\t}\n   203\t\n   204\t// ── the hold (rule 3b) ─────────────────────────────────────────────────────────────────────────────\n   205\t\n   206\texport interface Point { readonly x: number; readonly y: number }\n   207\t\n   208\t/**\n   209\t * Whether `p` is inside the corridor of rule 3b: the convex hull of the resting position `from` and the\n   210\t * rectangle `r`, the rectangle itself included (all in viewport pixels).\n   211\t */\n   212\texport function insideCorridor(from: Point, r: Rect, p: Point): boolean {\n   213\t  if (p.x >= r.x - EPSILON && p.x <= r.x + r.width + EPSILON && p.y >= r.y - EPSILON && p.y <= r.y + r.height + EPSILON) return true;\n   214\t  const points: Point[] = [from, { x: r.x, y: r.y }, { x: r.x + r.width, y: r.y }, { x: r.x + r.width, y: r.y + r.height }, { x: r.x, y: r.y + r.height }]\n   215\t    .sort((a, b) => a.x - b.x || a.y - b.y);\n   216\t  const cross = (o: Point, a: Point, b: Point) => (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);\n   217\t  // Andrew's monotone chain: the hull, counter-clockwise.\n   218\t  const lower: Point[] = [];\n   219\t  for (const q of points) {\n   220\t    while (lower.length >= 2 && cross(lower[lower.length - 2]!, lower[lower.length - 1]!, q) <= 0) lower.pop();\n   221\t    lower.push(q);\n   222\t  }\n   223\t  const upper: Point[] = [];\n   224\t  for (const q of [...points].reverse()) {\n   225\t    while (upper.length >= 2 && cross(upper[upper.length - 2]!, upper[upper.length - 1]!, q) <= 0) upper.pop();\n   226\t    upper.push(q);\n   227\t  }\n   228\t  const hull = [...lower.slice(0, -1), ...upper.slice(0, -1)];\n   229\t  if (hull.length < 