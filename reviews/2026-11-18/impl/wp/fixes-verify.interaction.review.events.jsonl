{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc 'git show bbd7564:packages/axylo/src/lookup/donut.ts | nl -ba'","aggregated_output":"     1\timport type { DatumRef, DonutView, Formatters, Lookup, Rect } from '../core/contracts';\n     2\timport { donutGeometry } from '../view/donut-geometry';\n     3\timport { contains, type PlotLayout } from './geometry';\n     4\timport { pageDistance } from './search';\n     5\timport { sliceText } from './text';\n     6\t\n     7\tconst TURN = 6.283185307179586; // 2π, a literal so the module does no work at import time\n     8\t\n     9\tfunction sectorBox(cx: number, cy: number, inner: number, outer: number, start: number, end: number): Rect {\n    10\t  let left = Infinity;\n    11\t  let right = -Infinity;\n    12\t  let top = Infinity;\n    13\t  let bottom = -Infinity;\n    14\t  function include(angle: number, radius: number) {\n    15\t    const x = cx + Math.sin(angle) * radius;\n    16\t    const y = cy - Math.cos(angle) * radius;\n    17\t    left = Math.min(left, x);\n    18\t    right = Math.max(right, x);\n    19\t    top = Math.min(top, y);\n    20\t    bottom = Math.max(bottom, y);\n    21\t  }\n    22\t  for (const radius of [inner, outer]) {\n    23\t    include(start, radius);\n    24\t    include(end, radius);\n    25\t    const quarter = Math.PI / 2;\n    26\t    for (let angle = Math.ceil(start / quarter) * quarter; angle < end; angle += quarter) include(angle, radius);\n    27\t  }\n    28\t  return { x: left, y: top, width: right - left, height: bottom - top };\n    29\t}\n    30\t\n    31\texport function donutLookup(view: DonutView, layout: PlotLayout | null, formatters: Formatters, locale?: string): Lookup {\n    32\t  const { slices } = view;\n    33\t  const keys = new Map(slices.map((slice, i) => [slice.key, i]));\n    34\t  const ring = layout?.projection.kind === 'ring' ? layout.projection : null;\n    35\t  const geometry = ring && donutGeometry(slices, ring);\n    36\t  const index = (datum: DatumRef) => datum.kind === 'slice' ? keys.get(datum.sliceKey) ?? -1 : -1;\n    37\t\n    38\t  function ref(i: number): DatumRef | null {\n    39\t    const slice = slices[i];\n    40\t    return slice ? { kind: 'slice', sliceKey: slice.key } : null;\n    41\t  }\n    42\t\n    43\t  function resolve(datum: DatumRef): DatumRef | null {\n    44\t    if (datum.kind !== 'slice') return null;\n    45\t    if (keys.has(datum.sliceKey)) return datum;\n    46\t    const folded = slices.find(slice => slice.members.length > 1 && slice.members.some(i => {\n    47\t      const label = view.frame.labels[i];\n    48\t      // The view prefixes author labels that would collide with the reserved Other key.\n    49\t      return label !== undefined && datum.sliceKey === (label.startsWith('__other__') ? '__other__' + label : label);\n    50\t    }));\n    51\t    return folded ? { kind: 'slice', sliceKey: folded.key } : null;\n    52\t  }\n    53\t\n    54\t  const lookup: Lookup = {\n    55\t    pick(px, py) {\n    56\t      if (!geometry || !ring || !layout || !contains(layout.plot, px, py) || !(ring.r1 > ring.r0)) return null;\n    57\t      const dx = px - ring.cx;\n    58\t      const dy = py - ring.cy;\n    59\t      const radius = Math.hypot(dx, dy);\n    60\t      if (radius < ring.r0 || radius > ring.r1) return null;\n    61\t      const raw = Math.atan2(dx, -dy);\n    62\t      const angle = raw < 0 ? raw + TURN : raw;\n    63\t      // Assign the narrow separators to their adjoining slices just as for proportional angles.\n    64\t      const slice = geometry.drawn.find((_, i) => angle >= geometry.angles[2 * i]! &&\n    65\t        (i + 1 === geometry.drawn.length || angle < geometry.angles[2 * i + 1]!));\n    66\t      return slice ? { kind: 'slice', sliceKey: slice.key } : null;\n    67\t    },\n    68\t    tooltip(target) {\n    69\t      const datum = target.kind === 'slice' ? lookup.datum(target) : null;\n    70\t      return { title: datum?.seriesLabel ?? '', rows: datum ? [datum] : [], count: datum ? 1 : 0, total: null };\n    71\t    },\n    72\t    primary(target) { return target.kind === 'slice' && keys.has(target.sliceKey) ? target : null; },\n    73\t    datum(datum) {\n    74\t      const i = index(datum);\n    75\t      if (i < 0) return null;\n    76\t      const { label, value, percent, state, row } = sliceText(view, slices[i]!, formatters, locale);\n    77\t      return { ref: datum, seriesIndex: i, seriesLabel: label, x: label, value, percent, state, row };\n    78\t    },\n    79\t    anchor(datum) {\n    80\t      if (datum.kind !== 'slice' || !geometry || !ring || !(ring.r1 > ring.r0)) return null;\n    81\t      const i = geometry.drawn.findIndex(slice => slice.key === datum.sliceKey);\n    82\t      return i < 0 ? null : sectorBox(ring.cx, ring.cy, ring.r0, ring.r1, geometry.angles[2 * i]!, geometry.angles[2 * i + 1]!);\n    83\t    },\n    84\t    count: slices.length,\n    85\t    ordinal: index,\n    86\t    step(from, direction) {\n    87\t      if (!from) return ref(0);\n    88\t      const resolved = resolve(from);\n    89\t      if (!resolved) return null;\n    90\t      const i = index(resolved);\n    91\t      let to: number;\n    92\t      switch (direction) {\n    93\t        case 'next': to = i + 1; break;\n    94\t        case 'previous': to = i - 1; break;\n    95\t        case 'first': to = 0; break;\n    96\t        case 'last': to = slices.length - 1; break;\n    97\t        case 'page-next': to = Math.min(slices.length - 1, i + pageDistance(slices.length)); break;\n    98\t        case 'page-previous': to = Math.max(0, i - pageDistance(slices.length)); break;\n    99\t        case 'series-next':\n   100\t        case 'series-previous': return null;\n   101\t      }\n   102\t      return to === i ? null : ref(to);\n   103\t    },\n   104\t    resolve,\n   105\t  };\n   106\t  return lookup;\n   107\t}\n","exit_code":0,"status":"completed"}}
