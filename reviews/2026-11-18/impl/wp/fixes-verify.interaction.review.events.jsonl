n   292\t      const hits = [nearest];\n   293\t      let count = 0;\n   294\t      function sample(head: number): void {\n   295\t        for (let at = head; at >= 0 && hits.length < POINT_LIMIT; at = next[at]!) {\n   296\t          examined++;\n   297\t          if (at !== nearest) hits.push(at);\n   298\t        }\n   299\t      }\n   300\t      function collect(bucket: Bucket): void {\n   301\t        if (distanceTo(bucket, cx, cy) > COINCIDENT2) return;\n   302\t        if (distanceAcross(bucket, cx, cy) <= COINCIDENT2) {\n   303\t          count += bucket.count;\n   304\t          for (let i = bucket.start; i < bucket.end && hits.length < POINT_LIMIT; i++) sample(order[i]!);\n   305\t        } else if (bucket.left && bucket.right) {\n   306\t          collect(bucket.left);\n   307\t          collect(bucket.right);\n   308\t        } else {\n   309\t          for (let i = bucket.start; i < bucket.end; i++) {\n   310\t            const at = order[i]!;\n   311\t            visit();\n   312\t            if ((px[at]! - cx) ** 2 + (py[at]! - cy) ** 2 <= COINCIDENT2) {\n   313\t              count += multiplicity[at]!;\n   314\t              sample(at);\n   315\t            }\n   316\t          }\n   317\t        }\n   318\t      }\n   319\t      // The same cell set covers every possible 0.5 px neighbourhood of the nearest point.\n   320\t      for (const bucket of nearby) collect(bucket);\n   321\t      return { hits, count };\n   322\t    };\n   323\t  }\n   324\t\n   325\t  const exact = budget > 0 ? index(xs, ys) : null;\n   326\t  let lattice: Index | null = null;\n","exit_code":0,"status":"completed"}}
