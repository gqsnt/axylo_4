76\t\n   177\t  function dropEntries(presentation: Presentation): void {\n   178\t    for (const entry of entries[presentation].values()) entry.listening?.abort();\n   179\t    entries[presentation].clear();\n   180\t  }\n   181\t\n   182\t  // The fixed parts of each presentation, made once.\n   183\t  const floatTitle = doc.createElement('div');\n   184\t  floatTitle.className = 'axylo-tooltip-title';\n   185\t  const floatTotal = doc.createElement('div');\n   186\t  floatTotal.className = 'axylo-tooltip-row axylo-tooltip-total';\n   187\t  const floatTotalName = doc.createElement('span');\n   188\t  floatTotalName.className = 'axylo-tooltip-series';\n   189\t  const floatTotalValue = doc.createElement('span');\n   190\t  floatTotalValue.className = 'axylo-tooltip-value';\n   191\t  floatTotal.append(floatTotalName, floatTotalValue);\n   192\t  const stripTitle = doc.createElement('span');\n   193\t  stripTitle.className = 'axylo-tooltip-title';\n   194\t  const stripTotal = doc.createElement('span');\n   195\t  stripTotal.className = 'axylo-readout-total';\n   196\t  const listening = new AbortController();\n   197\t  /** \"+N more\": text while hovered, a button that shows the next rows while pinned. */\n   198\t  function moreElement(presentation: Presentation, pinned: boolean): HTMLElement {\n   199\t    const button = pinned && current?.more !== undefined;\n   200\t    const key = `${presentation}\\u0000${button}`;\n   201\t    let el = mores.get(key);\n   202\t    if (!el) {\n   203\t      el = doc.createElement(button ? 'button' : presentation === 'strip' ? 'span' : 'div');\n   204\t      el.className = 'axylo-tooltip-more';\n   205\t      if (el instanceof HTMLButtonElement) {\n   206\t        el.type = 'button';\n   207\t        el.tabIndex = -1;\n   208\t        el.classList.add('axylo-tooltip-choice');\n   209\t        el.addEventListener('mousedown', event => event.preventDefault(), { signal: listening.signal });\n   210\t        el.addEventListener('c