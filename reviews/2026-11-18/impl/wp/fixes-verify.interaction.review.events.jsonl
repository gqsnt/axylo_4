{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc 'git show bbd7564:packages/axylo/src/core/focus.ts | nl -ba | sed -n \"322,408p\"'","aggregated_output":"   322\t};\n   323\t\n   324\tconst allTargetMarks: TargetMarks = (input, plot, clipped, unclipped) => {\n   325\t  const kind = input.view.kind;\n   326\t  (kind === 'donut' ? donutTargetMarks : kind === 'scatter' ? scatterTargetMarks : alignedTargetMarks)(input, plot, clipped, unclipped);\n   327\t};\n   328\t\n   329\t/** Cursor rule, highlighted points or bar and slice outlines, and the keyboard focus ring (contracts: Overlay). */\n   330\texport function buildOverlay(input: OverlayInput): Overlay | null {\n   331\t  return overlayWith(allTargetMarks, input);\n   332\t}\n   333\t\n   334\t/** The overlay with a chart kind's own target marks (a kind's composition holds only its own). */\n   335\texport function overlayWith(targetMarks: TargetMarks, input: OverlayInput): Overlay | null {\n   336\t  const { layout, lookup, target, ring } = input;\n   337\t  if (layout.kind !== 'plot' || (target === null && ring === null)) return null;\n   338\t  const plot = layout.plot;\n   339\t  const clipped: Mark[] = [];\n   340\t  const unclipped: Mark[] = [];\n   341\t  targetMarks(input, plot, clipped, unclipped);\n   342\t\n   343\t  if (ring) {\n   344\t    const ringBox = ringLine(layout, lookup, ring);\n   345\t    // Two tones: the focus colour on a surround of the background colour (WCAG 1.4.11 against whatever\n   346\t    // mark the ring crosses).\n   347\t    if (ringBox) unclipped.push(...outline(ringBox, 0, 'background', SURROUND_WIDTH), ...outline(ringBox, 0, 'focus', RING_WIDTH));\n   348\t  }\n   349\t  return clipped.length || unclipped.length ? { clip: plot, clipped, unclipped } : null;\n   350\t}\n   351\t\n   352\t/**\n   353\t * The centre line of the keyboard's datum ring, in plot pixels, or null when it is not drawn. Kept inside\n   354\t * the plot's box, so it is painted at the last point and at the top of a donut too (A2): the ring's lines,\n   355\t * surround included, stay inside the plot.\n   356\t */\n   357\tfunction ringLine(layout: Layout, lookup: Lookup, ref: DatumRef): Rect | null {\n   358\t  if (layout.kind !== 'plot') return null;\n   359\t  const box = lookup.anchor(ref);\n   360\t  if (!box) return null;\n   361\t  const plot = layout.plot;\n   362\t  const gap = box.width === 0 && box.height === 0 ? 8 : RING_GAP;\n   363\t  const inset = SURROUND_WIDTH / 2;\n   364\t  const x0 = Math.max(plot.x + inset, box.x - gap), y0 = Math.max(plot.y + inset, box.y - gap);\n   365\t  const x1 = Math.min(plot.x + plot.width - inset, box.x + box.width + gap), y1 = Math.min(plot.y + plot.height - inset, box.y + box.height + gap);\n   366\t  return x1 > x0 && y1 > y0 ? { x: x0, y: y0, width: x1 - x0, height: y1 - y0 } : null;\n   367\t}\n   368\t\n   369\t/** The keyboard ring's painted extent (surround included), in plot pixels: what a tooltip must not cover. */\n   370\texport function ringRect(layout: Layout, lookup: Lookup, ref: DatumRef): Rect | null {\n   371\t  const line = ringLine(layout, lookup, ref);\n   372\t  if (!line) return null;\n   373\t  const h = SURROUND_WIDTH / 2;\n   374\t  return { x: line.x - h, y: line.y - h, width: line.width + 2 * h, height: line.height + 2 * h };\n   375\t}\n   376\t\n   377\t/** Width of the ring's painted stroke, surround included. */\n   378\texport const RING_STROKE = SURROUND_WIDTH;\n   379\t\n   380\t/** The union of the anchors a tooltip must not cover, in plot coordinates; null when nothing is drawn. */\n   381\texport function targetBox(view: View, lookup: Lookup, target: PickTarget, only: DatumRef | null): Rect | null {\n   382\t  let refs: readonly DatumRef[];\n   383\t  if (target.kind === 'x') refs = view.kind === 'donut' || view.kind === 'scatter' ? [] : only ? [only] : refsAt(view, target.x);\n   384\t  else if (target.kind === 'point') refs = target