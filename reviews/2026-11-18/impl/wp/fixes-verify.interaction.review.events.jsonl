export function positionText(messages: Messages, formatters: Formatters, ordinal: number, count: number): string {\n   108\t  return fill(messages.position, { index: formatters.count(ordinal + 1), count: formatters.count(count) });\n   109\t}\n   110\t\n   111\t/**\n   112\t * Value text of the proxy (decision 0001): what the reader is on, ending with its place. \"All\" mode reads\n   113\t * every series at the x with `pointAll` and `seriesValue`; one series (single mode, scatter) uses `pointOf`.\n   114\t */\n   115\texport function valueText(\n   116\t  view: View, lookup: Lookup, focus: DatumRef, mode: Mode, formatters: Formatters, messages: Messages,\n   117\t): string | null {\n   118\t  const ordinal = lookup.ordinal(focus);\n   119\t  if (ordinal < 0) return null;\n   120\t  const position = positionText(messages, formatters, ordinal, lookup.count);\n   121\t  if (view.kind === 'donut') {\n   122\t    const datum = lookup.datum(focus);\n   123\t    if (!datum) return null;\n   124\t    const share = datum.percent === null || datum.percent === datum.value ? '' : ` (${datum.percent})`;\n   125\t    return fill(messages.pointAll, {\n   126\t      x: datum.seriesLabel, values: datum.value + share, position,\n   127\t    });\n   128\t  }\n   129\t  if (view.kind !== 'scatter' && mode === 'all' && focus.kind === 'aligned') {\n   130\t    // What the tooltip shows at this x, the stack total included, said once (spec I1, F10).\n   131\t    // Every series at x, the ones past the tooltip's eight included, as the tooltip writes its rows: an\n   132\t    // incomplete stack is said once, on the total, not again on each series (review C2-7).\n   133\t    const model = lookup.tooltip({ kind: 'x', x: focus.x });\n   134\t    const rows = alignedRows(view, formatters, focus.x, model).map(r => fill(messages.seriesValue, { series: r.seriesLabel, value: r.value }));\n   135\t    if (model.total !== null) rows.push(fill(messages.seriesValue, { series: messages.total, value: model.total }));\n   136\t    if (!rows.length) return null;\n   137\t    return fill(messages.pointAll, { x: formatters.x(focus.x), values: rows.join('; '), position });\n   138\t  }\n   139\t  return pointOf(lookup, focus, formatters, messages);\n   140\t}\n   141\t\n   142\t/**\n   143\t * Every readable series' row at x, in series order: the tooltip's own rows first (they are the first of\n   144\t * them), then the rest written the same way, unqualified, as the tooltip writes a row. Used where every\n   145\t * series is read (the keyboard's \"all\" reading, a pinned tooltip's further rows).\n   146\t */\n   147\texport function alignedRows(view: AlignedView, formatters: Formatters, x: number, model: TooltipModel): DatumText[] {\n   148\t  const rows: DatumText[] = [...model.rows];\n   149\t  const shown = new Set(model.rows.map(r => r.seriesIndex));\n   150\t  const positions = view.frame.x.values;\n   151\t  const i = lowerBound(positions, x);\n   152\t  if (i >= positions.length || positions[i] !== x) return rows;\n   153\t  const title = formatters.x(x);\n   154\t  for (const s of readableSeries(view)) {\n   155\t    if (shown.has(s)) continue;\n   156\t    const series = view.frame.series[s]!;\n   157\t    const state = series.slot[i] as SlotState;\n   158\t    rows.push({\n   159\t      ref: { kind: 'aligned', seriesKey: series.key, x }, seriesIndex: s, seriesLabel: series.label, x: title,\n   160\t      value: slotText(formatters, s, series.y[i]!, state), state, percent: null, row: series.row?.[i] ?? i,\n   161\t    });\n   162\t  }\n   163\t  return rows;\n   164\t}\n   165\t\n   166\t/**\n   167\t * Every point shown with a scatter target: its refs, then the rest of its coincident group (the pick lists\n   168\t * at most eight). The group's further members are its neighbours in the lookup's x-then-y order whose\n   169\t * anchors coincide with the first's; exactly coincident points are adjacent in that order.\n   170\t */\n   171\texport function groupRefs(lookup: Lookup, target: Extract<PickTarget, { kind: 'point' }>): DatumRef[] {\n   172\t  const refs = [...target.refs];\n   173\t  const first = refs[0];\n   174\t  const box = first ? lookup.anchor(first) : null;\n   175\t  if (!first || !box || target.count <= refs.length) return refs;\n   176\t  const same = (ref: DatumRef) => {\n   177\t    const b = lookup.anchor(ref);\n   178\t    return b !== null && Math.abs(b.x - box.x) < 0.5 && Math.abs(b.y - box.y) < 0.5;\n   179\t  };\n   180\t  for (const direction of ['next', 'previous'] as const) {\n   181\t    let at: DatumRef | null = first;\n   182\t    for (let k = 0; at && refs.length < target.count && k < target.count + 8; k++) {\n   183\t      at = lookup.step(at, direction);\n   184\t      if (!at || !same(at)) break;\n   185\t      if (!refs.some(r => sameRef(r, at))) refs.push(at);\n   186\t    }\n   187\t  }\n   188\t  return refs;\n   189\t}\n   190\t\n   191\t/**\n   192\t * What a reading says about the datum itself, for deciding whether the focused text must be rewritten\n   193\t * (decision 0004 part 2): its identity, its values and the templates that word them, never its place in\n   194\t * the range. Compared as data, not by taking one translated sentence out of another (review finding 14).\n   195\t */\n   196\texport function datumReading(view: View, lookup: Lookup, ref: DatumRef, mode: Mode, formatters: Formatters, messages: Messages): string | null {\n   197\t  if (lookup.ordinal(ref) < 0) return null;\n   198\t  const words = [messages.pointAll, messages.pointOf, messages.seriesValue, messages.total];\n   199\t  if (view.kind !== 'scatter' && view.kind !== 'donut' && mode === 'all' && ref.kind === 'aligned') {\n   200\t    const model = lookup.tooltip({ kind: 'x', x: ref.x });\n   201\t    const rows = alignedRows(view, formatters, ref.x, model).map(r => [r.seriesIndex, r.seriesLabel, r.value]);\n   202\t    return JSON.stringify(['all', ref.seriesKey, formatters.x(ref.x), rows, model.total, words]);\n   203\t  }\n   204\t  const datum = lookup.datum(ref);\n   205\t  if (!datum) return null;\n   206\t  return JSON.stringify(['one', ref, datum.seriesLabel, datum.x, datum.value, datum.percent, words]);\n   207\t}\n   208\t\n   209\t// ── overlay ─────────────────────────────────────────────────────────────────────────────────────────\n   210\t\n   211\texport interface OverlayInput {\n   212\t  readonly view: View;\n   213\t  readonly layout: Layout;\n   214\t  readonly lookup: Lookup;\n   215\t  /** What is shown (pointer or keyboard). */\n   216\t  readonly target: PickTarget | null;\n   217\t  /** The keyboard's datum, when the proxy has focus and is focus-visible: it gets the focus ring. */\n   218\t  readonly ring: DatumRef | null;\n   219\t  /** In single mode only the focused series is highlighted. */\n   220\t  readonly only: DatumRef | null;\n   221\t}\n   222\t\n   223\tconst HALO = 13;\n   224\tconst MARKER = 9;\n   225\tconst RING_GAP = 4;\n   226\t/**\n   227\t * How far the keyboard's datum ring reaches beyond the datum's box: the widest gap, then the ring's 2 px in\n   228\t * the focus colour between 1 px of background colour on each side (WCAG 1.4.11: the surround separates the\n   229\t * focus colour from any mark it crosses, so it needs 3:1 against the background only).\n   230\t */\n   231\texport const RING_REACH = 10;\n   232\t/** The ring in the focus colour, and the background-coloured surround it is drawn on. */\n   233\tconst RING_WIDTH = 2;\n   234\tconst SURROUND_WIDTH = 4; // RING_WIDTH + 2, written out: no work at import time\n   235\t/** How far inside the plot's rectangle its focus outline reaches (2 px at an offset of -3 px). */\n   236\texport const OUTLINE_REACH = 4;\n   237\t\n   238\tfunction rule(x1: number, y1: number, x2: number, y2: number, name: 'axis' | 'focus' | 'text' | 'background', width: number): RuleMark {\n   239\t  return { type: 'rule', x1, y1, x2, y2, stroke: { kind: 'token', name }, strokeWidth: width, dash: null, role: 'cursor' };\n   240\t}\n   241\t\n   242\tfunction outline(box: Rect, gap: number, name: 'focus' | 'text' | 'background', width: number): RuleMark[] {\n   243\t  const x0 = box.x - gap, y0 = box.y - gap, x1 = box.x + box.width + gap, y1 = box.y + box.height + gap;\n   244\t  // Each side runs on by half the width at both ends, so the corners are closed as with square caps.\n   245\t  const h = width / 2;\n   246\t  return [\n   247\t    rule(x0 - h, y0, x1 + h, y0, name, width), rule(x1, y0 - h, x1, y1 + h, name, width),\n   248\t    rule(x1 + h, y1, x0 - h, y1, name, width), rule(x0, y1 + h, x0, y0 - h, name, width),\n   249\t  ];\n   250\t}\n   251\t\n   252\tfunction seriesIndex(view: View, ref: DatumRef): number {\n   253\t  if (view.kind === 'donut') return -1;\n   254\t  if (ref.kind === 'slice') return -1;\n   255\t  return view.frame.series.findIndex(s => s.key === ref.seriesKey);\n   256\t}\n   257\t\n   258\t/** Adds what a chart kind draws over its marks for the shown target (cursor, points, outlines). */\n   259\texport type TargetMarks = (input: OverlayInput, plot: Rect, clipped: Mark[], unclipped: Mark[]) => void;\n   260\t\n   261\t/** Aligned charts: the cursor rule at the x, with the points (lines, areas) or outlines (bars) there. */\n   262\texport const alignedTargetMarks: TargetMarks = ({ view, layout, lookup, target, only }, plot, clipped, unclipped) => {\n   263\t  if (target?.kind !== 'x' || view.kind === 'donut' || view.kind === 'scatter' || layout.kind !== 'plot') return;\n   264\t  const projection = layout.projection;\n   265\t  const refs = only ? [only] : refsAt(view, target.x);\n   266\t  const scale = projection.kind === 'xy' ? projection.x : projection.kind === 'bands' ? projection.band : null;\n   267\t  if (scale) {\n   268\t    const at = scale.type === 'band' ? scale.center(target.x) : scale.map(target.x);\n   269\t    const across = projection.kind === 'bands' && projection.horizontal;\n   270\t    if (Number.isFinite(at)) {\n   271\t      clipped.push(across ? rule(plot.x, at, plot.x + plot.width, at, 'axis', 1) : rule(at, plot.y, at, plot.y + plot.height, 'axis', 1));\n   272\t    }\n   273\t  }\n   274\t  for (const ref of refs) {\n   275\t    const box = lookup.anchor(ref);\n   276\t    if (!box) continue;\n   277\t    if (projection.kind === 'bands') {\n   278\t      unclipped.push(...outline(box, 1, 'text', 2));\n   279\t    } else {\n   280\t      const s = seriesIndex(view, ref);\n   281\t      const cue = view.cues[s];\n   282\t      const xy = Float32Array.of(box.x + box.width / 2, box.y + box.height / 2);\n   283\t      const shape = cue?.marker ?? 'circle';\n   284\t      clipped.push({ type: 'points', series: s, xy, shape, size: HALO, fill: { kind: 'token', name: 'background' } });\n   285\t      clipped.push({ type: 'points', series: s, xy, shape, size: MARKER, fill: { kind: 'series', index: s } });\n   286\t    }\n   287\t  }\n   288\t};\n   289\t\n   290\t/** Scatter: the points under the pointer, highlighted. */\n   291\texport const scatterTargetMarks: TargetMarks = ({ view, lookup, target }, _plot, clipped) => {\n   292\t  if (target?.kind !== 'point' || view.kind !== 'scatter') return;\n   293\t  for (const ref of target.refs) {\n   294\t    const box = lookup.anchor(ref);\n   295\t    if (!box) continue;\n   296\t    const s = seriesIndex(view, ref);\n   297\t    const xy = Float32Array.of(box.x, box.y);\n   298\t    const shape = view.cues[s]?.marker ?? 'circle';\n   299\t    clipped.push({ type: 'points', series: s, xy, shape, size: HALO, fill: { kind: 'token', name: 'text' } });\n   300\t    clipped.push({ type: 'points', series: s, xy, shape, size: MARKER, fill: { kind: 'series', index: s } });\n   301\t  }\n   302\t};\n   303\t\n   304\t/** Donut: the slice outlined, outside the ring and inside the hole. */\n   305\texport const donutTargetMarks: TargetMarks = ({ view, layout, target }, _plot, _clipped, unclipped) => {\n   306\t  if (target?.kind !== 'slice' || view.kind !== 'donut' || layout.kind !== 'plot' || layout.projection.kind !== 'ring') return;\n   307\t  const projection = layout.projection;\n   308\t  // The outline follows the slice as drawn: a slice thinner than a pixel of arc is widened to stay visible.\n   309\t  const geometry = donutGeometry(view.slices, projection);\n   310\t  const at = geometry.drawn.findIndex(s => s.key === target.sliceKey);\n   311\t  const slice = at >= 0 ? geometry.drawn[at] : undefined;\n   312\t  const from = at >= 0 ? geometry.angles[2 * at]! : 0;\n   313\t  const to = at >= 0 ? geometry.angles[2 * at + 1]! : 0;\n   314\t  if (slice && to > from) {\n   315\t    const angles = Float32Array.of(from, to);\n   316\t    const fills = [{ kind: 'token', name: 'text' } as const];\n   317\t    unclipped.push({ type: 'arcs', cx: projection.cx, cy: projection.cy, r0: projection.r1 + 1, r1: projection.r1 + 4, angles, fills, gap: 0 });\n   318\t    if (projection.r0 > 5) {\n   319\t      unclipped.push({ type: 'arcs', cx: projection.cx, cy: projection.cy, r0: projection.r0 - 4, r1: projection.r0 - 1, angles, fills, gap: 0 });\n   320\t    }\n","exit_code":0,"status":"completed"}}
