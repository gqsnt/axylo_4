{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'git show bbd7564:packages/axylo/src/dom/pointer.ts | nl -ba'","aggregated_output":"     1\t/**\n     2\t * Comparing pick targets, and the identity a dismissal is remembered by. Pointer, touch and drag input are\n     3\t * handled by the interaction layer (dom/interaction.ts); this only says whether two targets name the same\n     4\t * thing.\n     5\t */\n     6\timport type { DatumRef, PickTarget } from '../core/contracts';\n     7\timport { sameRef } from '../core/focus';\n     8\t\n     9\t/** Two pick results name the same thing, so the tooltip need not be rebuilt. */\n    10\texport function sameTarget(a: PickTarget | null, b: PickTarget | null): boolean {\n    11\t  if (a === null || b === null) return a === b;\n    12\t  if (a.kind === 'x' && b.kind === 'x') return a.x === b.x;\n    13\t  if (a.kind === 'slice' && b.kind === 'slice') return a.sliceKey === b.sliceKey;\n    14\t  if (a.kind === 'point' && b.kind === 'point') {\n    15\t    return a.count === b.count && a.refs.length === b.refs.length && a.refs.every((r, i) => sameRef(r, b.refs[i]!));\n    16\t  }\n    17\t  return false;\n    18\t}\n    19\t\n    20\t/**\n    21\t * The datum a dismissal belongs to (decision 0004 rule 8): the x of an aligned target, the slice, or the\n    22\t * first point of a scatter group. Points that come to share that point's position do not make it another\n    23\t * datum, and the dismissal ends only when the datum shown no longer includes it.\n    24\t */\n    25\texport type Identity =\n    26\t  | { readonly kind: 'x'; readonly x: number }\n    27\t  | { readonly kind: 'point'; readonly ref: DatumRef }\n    28\t  | { readonly kind: 'slice'; readonly sliceKey: string };\n    29\t\n    30\texport function identityOf(target: PickTarget): Identity {\n    31\t  switch (target.kind) {\n    32\t    case 'x': return { kind: 'x', x: target.x };\n    33\t    case 'slice': return { kind: 'slice', sliceKey: target.sliceKey };\n    34\t    case 'point': return target.refs[0] ? { kind: 'point', ref: target.refs[0] } : { kind: 'x', x: NaN };\n    35\t  }\n    36\t}\n    37\t\n    38\texport function matchesIdentity(id: Identity, target: PickTarget): boolean {\n    39\t  if (id.kind === 'x') return target.kind === 'x' && target.x === id.x;\n    40\t  if (id.kind === 'slice') return target.kind === 'slice' && target.sliceKey === id.sliceKey;\n    41\t  return target.kind === 'point' && target.refs.some(r => sameRef(r, id.ref));\n    42\t}\n","exit_code":0,"status":"completed"}}
