=> HTMLUListElement | null;\n   191\t\n   192\t/** What differs between chart kinds in the interaction layer; a kind's composition holds only its own. */\n   193\texport interface InteractionParts {\n   194\t  readonly overlay: TargetMarks;\n   195\t  readonly swatch: SeriesSwatch;\n   196\t  /** Single mode's Right and Left within one series (scatter); null where single mode steps through the lookup. */\n   197\t  readonly stepInSeries: ((view: Extract<View, { kind: 'scatter' }>, ref: DatumRef, direction: StepDirection) => DatumRef | null) | null;\n   198\t  readonly sliceList: SliceList | null;\n   199\t}\n   200\t\n   201\tconst ROVING_KEYS: Readonly<Record<string, 1 | -1 | 'first' | 'last'>> = {\n   202\t  ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1, Home: 'first', End: 'last',\n   203\t};\n   204\t\n   205\texport const donutSliceList: SliceList = (doc, d, actions, list) => {\n   206\t  const view = d.view;\n   207\t  // The slice list is part of the full chart; the too-small state shows only title, summary and table (L8).\n   208\t  if (view.kind !== 'donut' || !d.legend || d.tooSmall || !(d.ready || d.inspectable || (view.slices.length > 0 && view.total === 0))) {\n   209\t    return null;\n   210\t  }\n   211\t  if (!list) {\n   212\t    list = doc.createElement('ul');\n   213\t    // While the plot cannot be focused (an all-zero donut), the list is how the keyboard reaches the\n   214\t    // slices: one tab stop, arrows between entries (review finding 3); otherwise the plot's proxy is.\n   215\t    const own = list;\n   216\t    own.addEventListener('keydown', event => {\n   217\t      if (own.dataset.roving !== 'true' || event.altKey || event.ctrlKey || event.metaKey) return;\n   218\t      const step = ROVING_KEYS[event.key];\n   219\t      if (step === undefined) return;\n   220\t      const buttons = [...own.querySelectorAll<HTMLButtonElement>('.axylo-legend-choice')];\n   221\t      if (!buttons.length) return;\n   222\t      const at = bu