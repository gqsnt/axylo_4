chart')!.style.height = `${h}px`; }, h);\n   388\t      await settle(page);\n   389\t      const p = await page.locator('#chart .axylo-proxy').boundingBox();\n   390\t      if (!p) continue;\n   391\t      await page.mouse.move(5, 5);\n   392\t      await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   393\t      await settle(page);\n   394\t      const t = await tip(page);\n   395\t      if (p.height < 140) {\n   396\t        below++;\n   397\t        if (t.title !== null) failures.push(`${h}: plot ${p.height.toFixed(1)} px high floats a tooltip`);\n   398\t        const hovered = await page.evaluate(() => (window as unknown as { hovered: unknown[] }).hovered.at(-1));\n   399\t        if (!hovered) failures.push(`${h}: nothing highlighted`);\n   400\t      } else if (t.title === null) failures.push(`${h}: plot ${p.height.toFixed(1)} px high shows no tooltip`);\n   401\t    }\n   402\t    expect(below).toBeGreaterThan(0);\n   403\t    expect(failures).toEqual([]);\n   404\t    expect(await closePage(page)).toEqual([]);\n   405\t  });\n   406\t});\n","exit_code":0,"status":"completed"}}
