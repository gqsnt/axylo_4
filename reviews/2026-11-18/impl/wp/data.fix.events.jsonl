nd));\n    this.x = x;\n    this.observed = observed;\n    for (const [key, previous] of this.series) {\n      const series = buffers(previous.description, capacity);\n      series.y.set(previous.y.subarray(start, end));\n      series.slot.set(previous.slot.subarray(start, end));\n      series.row.set(previous.row.subarray(start, end));\n      this.series.set(key, series);\n    }\n    this.start = 0;\n    this.end = count;\n    return true;\n  }\n\n  copySeries(series: SeriesBuffers): SeriesBuffers {\n    const copy = buffers(series.description, this.x.length);\n    const { start, end } = this;\n    copy.y.set(series.y.subarray(start, end), start);\n    copy.slot.set(series.slot.subarray(start, end), start);\n    copy.row.set(series.row.subarray(start, end), start);\n    this.series.set(series.description.key, copy);\n    return copy;\n  }\n\n  addSeries(description: SeriesDescription, zero: boolean): SeriesBuffers {\n    const series = buffers(description, this.x.length);\n    series.row.fill(-1, this.start, this.end);\n    if (!zero) {\n      series.y.fill(NaN, this.start, this.end);\n      series.slot.fill(SLOT_NO_ROW, this.start, this.end);\n    }\n    this.series.set(description.key, series);\n    return series;\n  }\n\n  trim(keep: number | undefined, evict: (x: number, observed: boolean) => void): void {\n    if (keep === undefined || keep >= this.distinct) return;\n    while (this.start < this.end && (this.distinct > keep || !this.observed[this.start])) {\n      const observed = this.observed[this.start] === 1;\n      if (observed) this.distinct--;\n      evict(this.x[this.start]!, observed);\n      this.start++;\n    }\n  }\n\n  frame(previous: AlignedFrame, axis: XColumn, source: RowSource): AlignedFrame {\n    const { start, end } = this;\n    return {\n      ...previous, source, revision: previous.revision, length: end - start,\n      x: {\n        values: this.x.subarray(start, end), kind: axis.kind, dateUnit: axis.dateUnit,\n        timeZone: axis.timeZone, ordered: axis.ordered,\n        get categories() { return axis.categories; },\n      },\n      series: Array.from(this.series.values(), ({ description, y, slot, row }) => ({\n        ...description, y: y.subarray(start, end), slot: slot.subarray(start, end), row: row.subarray(start, end),\n      })),\n    };\n  }\n}\nimport type { DiagnosticEffect, DiagnosticInput, DiagnosticSink } from '../core/contracts';\nimport { DiagnosticCollector, createDiagnostic, type DiagnosticCode } from '../diagnostics';\nimport { diagnosticContext } from '../diagnostics/registry';\n\nexport interface DiagnosticTrace extends DiagnosticSink {\n  traceRow?(code: DiagnosticCode, field: string, effect: DiagnosticEffect, row: number): void;\n  traceGaps?(field: string, effect: DiagnosticEffect, positions: Float64Array): void;\n}\n\nfunction keyOf(code: DiagnosticInput['code'], field: string | undefined, effect: DiagnosticEffect): string {\n  return JSON.stringify([code, field, effect]);\n}\n\ninterface Occurrences {\n  readonly coordinates: Map<number, number>;\n  readonly gaps: boolean;\n  count: number;\n}\n\nexport class StreamDiagnostics extends DiagnosticCollector implements DiagnosticTrace {\n  private readonly occurrences = new Map<string, Occurrences>();\n\n  private trace(key: string, coordinate: number, gaps: boolean, amount = 1): void {\n    let entry = this.occurrences.get(key);\n    if (!entry) this.occurrences.set(key, entry = { coordinates: new Map(), count: 0, gaps });\n    entry.coordinates.set(coordinate, (entry.coordinates.get(coordinate) ?? 0) + amount);\n    entry.count += amount;\n  }\n\n  traceRow(code: DiagnosticCode, field: string, effect: DiagnosticEffect, row: number): void {\n    this.trace(keyOf(code, field, effect), row, false);\n  }\n\n  traceGaps(field: string, effect: DiagnosticEffect, positions: Float64Array): void {\n    const key = keyOf('AX105', field, effect);\n    for (const position of positions) this.trace(key, position, true);\n  }\n\n  merge(batch: StreamDiagnostics): void {\n    for (const diagnostic of batch.inputs()) this.add(diagnostic);\n    for (const [key, { coordinates, gaps }] of batch.occurrences) {\n      for (const [coordinate, amount] of coordinates) this.trace(key, coordinate, gaps, amount);\n    }\n  }\n\n  evict(coordinate: number, gaps: boolean): void {\n    for (const occurrence of this.occurrences.values()) {\n      if (occurrence.gaps !== gaps) continue;\n      const amount = occurrence.coordinates.get(coordinate);\n      if (amount === undefined) continue;\n      occurrence.count -= amount;\n      occurrence.coordinates.delete(coordinate);\n    }\n  }\n\n  retained(): readonly DiagnosticInput[] {\n    const result: DiagnosticInput[] = [];\n    for (const diagnostic of this.inputs()) {\n      const { code, field, effect } = diagnostic;\n      const entry = this.occurrences.get(keyOf(code, field, effect));\n      if (!entry || entry.count === diagnostic.count) {\n        result.push(diagnostic);\n        continue;\n      }\n      if (entry.count === 0) continue;\n      const samples: number[] = [];\n      for (const [coordinate, amount] of entry.coordinates) {\n        for (let i = 0; i < amount && samples.length < 10; i++) samples.push(coordinate);\n        if (samples.length === 10) break;\n      }\n      result.push(createDiagnostic(code as DiagnosticCode, effect, {\n        ...diagnosticContext(diagnostic), field, count: entry.count,\n        rows: entry.gaps ? undefined : samples, examples: entry.gaps ? samples.map(String) : undefined,\n      }));\n    }\n    return result;\n  }\n}\nimport type { DiagnosticInput } from '../core/contracts';\nimport { createDiagnostic } from '../diagnostics';\nimport { dailyDelta, DAY, HOUR, sameDailyTime } from './x';\n\nfunction phase(position: number, shift: number): number {\n  return ((position % DAY + DAY) % DAY + shift) % DAY;\n}\n\nfunction daily(a: number, b: number): boolean {\n  const delta = dailyDelta(b - a);\n  return delta >= DAY && delta % DAY === 0;\n}\n\nclass PhaseExtreme {\n  private positions: number[] = [];\n  private start = 0;\n\n  constructor(private readonly shift: number, private readonly direction: 1 | -1) {}\n\n  add(position: number): void {\n    const target = this.direction * phase(position, this.shift);\n    while (this.positions.length > this.start &&\n      this.direction * phase(this.positions.at(-1)!, this.shift) >= target) {\n      this.positions.pop();\n    }\n    this.positions.push(position);\n  }\n\n  evict(position: number): void {\n    if (this.positions[this.start] === position) this.start++;\n    if (2 * this.start >= this.positions.length) {\n      this.positions = this.positions.slice(this.start);\n      this.start = 0;\n    }\n  }\n\n  value(): number {\n    return phase(this.positions[this.start]!, this.shift);\n  }\n}\n\nexport class CalendarWindow {\n  private readonly extremes = [0, DAY / 2].map(shift => ({\n    min: new PhaseExtreme(shift, 1), max: new PhaseExtreme(shift, -1),\n  }));\n\n  private readonly rows = new Set<number>();\n  private readonly breaks = new Set<number>();\n  private last = -Infinity;\n  private distinct = 0;\n\n  observe(position: number): void {\n    if (position === this.last) return;\n    if (this.distinct && !daily(this.last, position)) this.breaks.add(this.last);\n    for (const { min, max } of this.extremes) {\n      min.add(position);\n      max.add(position);\n    }\n    this.last = position;\n    this.distinct++;\n  }\n\n  record(row: number): void {\n    this.rows.add(row);\n  }\n\n  evictPosition(position: number): void {\n    this.breaks.delete(position);\n    for (const { min, max } of this.extremes) {\n      min.evict(position);\n      max.evict(position);\n    }\n    if (--this.distinct === 0) this.last = -Infinity;\n  }\n\n  evictRow(row: number): void {\n    this.rows.delete(row);\n  }\n\n  private matches(first: number): boolean {\n    if (this.breaks.size) return false;\n    if (this.distinct < 2) return true;\n    // Two origins let us compare clock times near midnight without displacing a value by a whole day.\n    const clock = phase(first, 0);\n    const shifted = clock < HOUR || clock > DAY - HOUR;\n    const mid = shifted ? phase(first, DAY / 2) : clock;\n    const { min, max } = this.extremes[Number(shifted)]!;\n    return mid - min.value() <= HOUR && max.value() - mid <= HOUR;\n  }\n\n  private firstRows(): number[] {\n    const rows: number[] = [];\n    for (const row of this.rows) {\n      if (rows.length === 10) break;\n      rows.push(row);\n    }\n    return rows;\n  }\n\n  diagnostic(field: string, first: number): DiagnosticInput | null {\n    return this.distinct >= 2 && this.matches(first)\n      ? createDiagnostic('AX111', 'none', { field, count: this.rows.size, rows: this.firstRows() })\n      : null;\n  }\n\n  preview(field: string, first: number, positions: Float64Array, nextRow: number): DiagnosticInput | null {\n    if (!this.matches(first)) return null;\n    let anchor = first;\n    let last = this.last;\n    let appended = 0;\n    const rows = this.firstRows();\n    for (let i = 0; i < positions.length; i++) {\n      const position = positions[i]!;\n      if (!Number.isFinite(position)) continue;\n      if (Number.isFinite(last) && last !== position && (!daily(last, position) || !sameDailyTime(anchor, position))) return null;\n      if (!Number.isFinite(last)) anchor = position;\n      last = position;\n      appended++;\n      if (rows.length < 10) rows.push(nextRow + i);\n    }\n    return appended && last !== anchor\n      ? createDiagnostic('AX111', 'none', { field, count: this.rows.size + appended, rows })\n      : null;\n  }\n}\nimport { SLOT_ABSENT_FIELD, SLOT_INVALID, SLOT_NULL, SLOT_VALUE, type DiagnosticSink, type SlotState } from '../core/contracts';\nimport type { ResolvedValueField } from './options';\nimport { Reports } from './reports';\nimport type { Table } from './table';\n\nconst decimal = /^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$/;\nexport type ValueMode = 'empty' | 'decimal' | 'other';\n\nexport function valueMode(value: unknown, column: boolean): ValueMode {\n  if (value == null || value === '' || (column && typeof value === 'number' && Number.isNaN(value))) return 'empty';\n  return typeof value === 'string' && decimal.test(value) ? 'decimal' : 'other';\n}\n\nexport function inspectValues(table: Table, field: string): ValueMode {\n  let mode: ValueMode = 'empty';\n  for (let i = 0; i < table.length; i++) {\n    const next = valueMode(table.read(i, field), table.isColumnRow(i));\n    if (next === 'other') return next;\n    if (next === 'decimal') mode = next;\n  }\n  return mode;\n}\n\nexport interface Values {\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n}\n\nexport function readValues(\n  table: Table,\n  field: ResolvedValueField,\n  sink: DiagnosticSink,\n  impute: boolean,\n  startRow = 0,\n  mode = inspectValues(table, field.field),\n): Values {\n  const column = table.columns?.[field.field];\n  const zero = impute && field.missing === 'zero';\n  const reports = new Reports(field.field, sink);\n  const slot = new Uint8Array(table.length);\n  let y = column instanceof Float64Array || column instanceof Float32Array ? column : new Float64Array(table.length);\n\n  for (let i = 0; i < table.length; i++) {\n    const raw = column === undefined ? table.read(i, field.field) : column[i];\n    let value = NaN;\n    let state: SlotState = SLOT_VALUE;\n    if (typeof raw === 'number') {\n      if (Number.isFinite(raw)) value = raw;\n      else if (Number.isNaN(raw) && (column || table.isColumnRow(i))) state = SLOT_NULL;\n      else {\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw);\n      }\n    } else if (raw === undefined) {\n      state = SLOT_ABSENT_FIELD;\n      reports.add('AX102', zero ? 'changed' : 'omitted', startRow + table.rowIndex(i));\n    } else if (raw === null || raw === '') {\n      state = SLOT_NULL;\n    } else if (mode === 'decimal') {\n      value = Number(raw);\n      if (!Number.isFinite(value)) {\n        value = NaN;\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw);\n      }\n      if (field.parse !== 'number') reports.add('AX104', 'none', startRow + table.rowIndex(i));\n    } else {\n      state = SLOT_INVALID;\n      reports.add('AX106', 'omitted', startRow + table.rowIndex(i), raw);\n    }\n    if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) value = 0;\n    if (y === column && !Object.is(y[i], value)) {\n      // Infinity and explicit zero imputation cannot be represented by an unchanged borrowed view.\n      y = y.slice();\n    }\n    if (y !== column) y[i] = value;\n    slot[i] = state;\n  }\n\n  reports.flush(sink);\n  return { y, slot };\n}\nimport type { DiagnosticEffect, DiagnosticSink } from '../core/contracts';\nimport { report, type DiagnosticCode } from '../diagnostics';\nimport type { DiagnosticTrace } from './store-diagnostics';\n\nexport class Reports {\n  private readonly entries = new Map<DiagnosticCode, {\n    effect: DiagnosticEffect;\n    count: number;\n    rows: number[];\n    examples: string[];\n    detail?: string;\n  }>();\n\n  constructor(private readonly field: string, private readonly sink?: DiagnosticTrace) {}\n\n  add(code: DiagnosticCode, effect: DiagnosticEffect, row: number, example?: unknown, detail?: string): void {\n    let entry = this.entries.get(code);\n    if (!entry) {\n      entry = { effect, count: 0, rows: [], examples: [], detail };\n      this.entries.set(code, entry);\n    }\n    this.sink?.traceRow?.(code, this.field, effect, row);\n    entry.count++;\n    if (entry.rows.length < 10) {\n      entry.rows.push(row);\n      if (example !== undefined) {\n        const text = typeof example === 'string' ? JSON.stringify(example)\n          : example !== null && typeof example === 'object' ? Object.prototype.toString.call(example) : String(example);\n        entry.examples.push(text);\n      }\n    }\n  }\n\n  flush(sink: DiagnosticSink): void {\n    for (const [code, { effect, count, rows, examples, detail }] of this.entries) {\n      report(sink, code, effect, { field: this.field, count, rows, examples, detail });\n    }\n  }\n}\nimport type { RowSource } from '../core/contracts';\n\nexport type Columns = Readonly<Record<string, ArrayLike<unknown>>>;\n\nexport interface Table extends RowSource {\n  readonly length: number;\n  readonly columns: Columns | null;\n  read(row: number, field: string): unknown;\n  isColumnRow(row: number): boolean;\n  rowIndex(row: number): number;\n  hasField(field: string): boolean;\n  keys(): readonly string[];\n}\n\nfunction record(row: unknown): Record<string, unknown> | null {\n  return row !== null && typeof row === 'object' ? row as Record<string, unknown> : null;\n}\n\nexport function rowValue(row: unknown, field: string): unknown {\n  const object = record(row);\n  return object && Object.hasOwn(object, field) ? object[field] : undefined;\n}\n\nexport function rowsTable(rows: readonly unknown[]): Table {\n  return {\n    length: rows.length,\n    columns: null,\n    read: (row, field) => rowValue(rows[row], field),\n    rowAt: row => row >= 0 && row < rows.length && Number.isInteger(row) ? rows[row] : null,\n    isColumnRow: () => false,\n    rowIndex: row => row,\n    hasField: field => rows.some(row => {\n      const object = record(row);\n      return object !== null && Object.hasOwn(object, field);\n    }),\n    keys: () => {\n      const keys = new Set<string>();\n      for (const row of rows) for (const key of Object.keys(record(row) ?? {})) keys.add(key);\n      return [...keys];\n    },\n  };\n}\n\nexport function columnsTable(columns: Columns, length: number): Table {\n  const keys = Object.keys(columns);\n  return {\n    length,\n    columns,\n    read: (row, field) => Object.hasOwn(columns, field) ? columns[field]?.[row] : undefined,\n    rowAt: row => row >= 0 && row < length && Number.isInteger(row)\n      ? Object.fromEntries(keys.map(key => [key, columns[key]?.[row]]))\n      : null,\n    hasField: field => Object.hasOwn(columns, field),\n    isColumnRow: () => true,\n    rowIndex: row => row,\n    keys: () => keys,\n  };\n}\nimport { DiagnosticCollector } from '../diagnostics';\nimport type { Diagnostic } from '../public';\nimport { normalize, type DataEnvironment } from './normalize';\nimport { resolveOptions, type ChartType } from './options';\n\nexport function validateOptions(\n  type: ChartType, options: unknown, environment: DataEnvironment = { timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone },\n): readonly Diagnostic[] {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions(type, options, diagnostics);\n  normalize(type, resolved, environment, diagnostics, { epoch: 0, revision: 0 });\n  return diagnostics.list(resolved.name);\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/diagnostics/{collector,registry}.ts; cat packages/axylo/test/data/{helpers,store.test}.ts; sed -n '107,150p' docs/03-plan-typescript-release.md; sed -n '22,168p' packages/axylo/src/core/contracts.ts; sed -n '10,64p;181,230p' packages/axylo/src/public.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/diagnostics/{collector,registry}.ts; cat packages/axylo/test/data/{helpers,store.test}.ts; sed -n '107,150p' docs/03-plan-typescript-release.md; sed -n '22,168p' packages/axylo/src/core/contracts.ts; sed -n '10,64p;181,230p' packages/axylo/src/public.ts\"","aggregated_output":"import type { DiagnosticInput, DiagnosticSink } from '../core/contracts';\nimport type { Diagnostic } from '../public';\nimport { createDiagnostic, diagnosticContext, type DiagnosticCode } from './registry';\n\nexport class DiagnosticCollector implements DiagnosticSink {\n  private readonly entries = new Map<string, DiagnosticInput>();\n\n  add(diagnostic: DiagnosticInput): void {\n    const { code, field, effect, rows, count } = diagnostic;\n    const key = JSON.stringify([code, field, effect]);\n    const first = this.entries.get(key);\n    if (!first) {\n      const copy = rows && rows.length > 10\n        ? { ...diagnostic, rows: rows.slice(0, 10), count: count ?? rows.length }\n        : diagnostic;\n      this.entries.set(key, copy);\n      return;\n    }\n\n    const mergedRows = first.rows || rows\n      ? [...(first.rows ?? []), ...(rows?.slice(0, 10) ?? [])].slice(0, 10)\n      : undefined;\n    const mergedCount = (first.count ?? first.rows?.length ?? 1) + (count ?? rows?.length ?? 1);\n    const origin = diagnostic.origin === 'call' ? 'call' : first.origin;\n    const context = diagnosticContext(first);\n    if (context) {\n      const later = diagnosticContext(diagnostic);\n      const examples = [...(context.examples ?? []), ...(later?.examples ?? [])].slice(0, 10);\n      this.entries.set(key, createDiagnostic(code as DiagnosticCode, effect, {\n        ...context, examples, field, rows: mergedRows, count: mergedCount,\n      }, origin));\n    } else {\n      this.entries.set(key, { ...first, rows: mergedRows, count: mergedCount, origin });\n    }\n  }\n\n  inputs(): readonly DiagnosticInput[] {\n    return Array.from(this.entries.values());\n  }\n\n  list(chart: string): readonly Diagnostic[] {\n    return this.inputs().map(({ effect: _effect, origin: _origin, ...diagnostic }) => ({ ...diagnostic, chart }));\n  }\n}\n\nexport function readerDisclosure(diagnostics: readonly DiagnosticInput[]): { omitted: number; changed: number } {\n  const disclosure = { omitted: 0, changed: 0 };\n  for (const { effect, count, rows } of diagnostics) {\n    if (effect === 'omitted' || effect === 'changed') disclosure[effect] += count ?? rows?.length ?? 1;\n  }\n  return disclosure;\n}\nimport type { DiagnosticEffect, DiagnosticInput, DiagnosticSink } from '../core/contracts';\nimport type { Diagnostic } from '../public';\n\nexport interface DiagnosticDetails {\n  readonly field?: string;\n  readonly rows?: readonly number[];\n  readonly count?: number;\n  readonly examples?: readonly string[];\n  readonly keys?: readonly string[];\n  readonly suggestion?: string;\n  readonly detail?: string;\n}\n\nconst quote = (name: string) => JSON.stringify(name);\nconst field = (d: DiagnosticDetails) => d.field === undefined ? 'The chart' : 'Field ' + quote(d.field);\nconst rows = (d: DiagnosticDetails) => d.rows?.length ? ' at ' + (d.rows.length === 1 ? 'row ' : 'rows ') + d.rows.join(', ') : '';\nconst samples = (d: DiagnosticDetails) => d.examples?.length ? ' (' + d.examples.join(', ') + ')' : '';\nconst count = (d: DiagnosticDetails, word: string, plural = word + 's') =>\n  (d.count ?? 1) + ' ' + ((d.count ?? 1) === 1 ? word : plural);\nconst suggestion = (d: DiagnosticDetails) => d.suggestion === undefined ? '' : ' Did you mean ' + quote(d.suggestion) + '?';\n\ntype Entry = { readonly level: Diagnostic['level']; readonly message: (details: DiagnosticDetails) => string };\n\nexport const diagnosticRegistry = {\n  AX100: { level: 'error', message: d =>\n    field(d) + ' belongs to columns with different lengths' + samples(d) + '. Supply equally long columns.' },\n  AX101: { level: 'error', message: d =>\n    field(d) + ' is missing from the data. Available fields: ' +\n    (d.keys?.length ? d.keys.map(quote).join(', ') : '(none)') + '.' + suggestion(d) + ' Use an available field or add the field to the data.' },\n  AX102: { level: 'warning', message: d =>\n    field(d) + ' is absent in ' + count(d, 'record') + rows(d) + '. Supply the field and send null if the value is known to be missing.' },\n  AX103: { level: 'warning', message: d =>\n    field(d) + ' has ' + count(d, 'non-finite value') + rows(d) + samples(d) + '. Check the calculation that produced it or send null for no data.' },\n  AX104: { level: 'hint', message: d =>\n    field(d) + ' has ' + count(d, 'decimal string') + rows(d) + ' and is drawn as numbers. Set parse: \\'number\\' to make conversion explicit.' },\n  AX105: { level: 'hint', message: d =>\n    field(d) + ' is missing ' + count(d, 'expected step') + samples(d) + '. Supply observations for those positions or explicit nulls to mark gaps.' },\n  AX106: { level: 'warning', message: d =>\n    field(d) + ' has ' + count(d, 'value that cannot be plotted as a number', 'values that cannot be plotted as numbers') +\n    rows(d) + samples(d) + '. Convert values to numbers where the data is produced.' },\n  AX107: { level: 'warning', message: d =>\n    field(d) + ' has ' + count(d, 'unusable value') + rows(d) + samples(d) + '. ' +\n    (d.detail ?? 'Supply an x value in the declared or inferred format for each row.') },\n  AX108: { level: 'error', message: d =>\n    field(d) + ' has ' + count(d, 'duplicate') + rows(d) + samples(d) + '. Provide one row per x and series, or one row per donut label.' },\n  AX109: { level: 'hint', message: d =>\n    field(d) + ' has ' + count(d, 'numeric timestamp') + rows(d) + '. ' +\n    (d.detail ?? 'Set type: \\'time\\' for instants and supply epoch milliseconds.') },\n  AX110: { level: 'warning', message: d =>\n    field(d) + ' has a domain that excludes zero. The domain was widened. Include zero in the domain.' },\n  AX111: { level: 'hint', message: d =>\n    field(d) + ' contains instants that look like calendar dates' + rows(d) + '. Use date strings such as YYYY-MM-DD for calendar dates.' },\n  AX112: { level: 'hint', message: d =>\n    field(d) + ' has ' + count(d, 'date-time without an offset', 'date-times without an offset') + rows(d) +\n    '. Values are shown as written. Include a UTC offset or Z if these are instants.' },\n  AX120: { level: 'error', message: d =>\n    field(d) + ' has ' + count(d, 'negative donut value') + rows(d) + samples(d) + '. Supply non-negative values or choose a chart that shows negatives.' },\n  AX121: { level: 'warning', message: d =>\n    field(d) + ' produces more than eight donut slices. Smaller slices are grouped as Other. Aggregate the data or choose a bar chart to show every category.' },\n  AX130: { level: 'warning', message: d =>\n    field(d) + ' produces more than eight series. The chart uses dashes or markers to distinguish them. Filter or group series to reduce the number.' },\n  AX131: { level: 'hint', message: d =>\n    field(d) + ' produces multiple series in a compact chart. Use one series or turn off compact mode for more room.' },\n  AX132: { level: 'hint', message: d =>\n    field(d) + ' produces more bars than pixels along the category axis. Aggregate categories to make the bars readable.' },\n  AX133: { level: 'hint', message: d =>\n    field(d) + ' produces more than 50,000 scatter points. Drawing may be slow. Filter or aggregate points to reduce drawing time.' },\n  AX140: { level: 'warning', message: () =>\n    'The chart uses a generated name. Set title or labelledBy to give it a descriptive name.' },\n  AX141: { level: 'warning', message: () =>\n    'The chart palette has less than 3:1 contrast against the background. Adjust the colors or background to reach 3:1.' },\n  AX142: { level: 'hint', message: () =>\n    'The plot is too small to draw and shows the summary and table control. Give the plot more room.' },\n  AX143: { level: 'hint', message: d =>\n    field(d) + ' has ' + count(d, 'label') + ' that could not fit. Give the plot more room or shorten the labels.' },\n  AX150: { level: 'warning', message: d =>\n    'Option ' + quote(d.field ?? '') + ' is ignored. ' + (d.detail ?? 'Use an option supported by this chart.') + suggestion(d) },\n  AX151: { level: 'warning', message: d =>\n    field(d) + ' has out-of-order append values' + rows(d) + '. A full update was used. Append rows in x order at or after the last x.' },\n  AX160: { level: 'warning', message: d =>\n    field(d) + ' has a custom formatter that threw' + rows(d) + '. The default format was used. Make the formatter handle every value of this field.' },\n} as const satisfies Record<Diagnostic['code'], Entry>;\n\nexport type DiagnosticCode = keyof typeof diagnosticRegistry;\n\ntype MessageContext = Pick<DiagnosticDetails, 'examples' | 'keys' | 'suggestion' | 'detail'>;\nconst contexts = new WeakMap<DiagnosticInput, MessageContext>();\n\nexport function diagnosticContext(diagnostic: DiagnosticInput): MessageContext | undefined {\n  return contexts.get(diagnostic);\n}\n\nexport function createDiagnostic(\n  code: DiagnosticCode,\n  effect: DiagnosticEffect,\n  details: DiagnosticDetails = {},\n  origin: DiagnosticInput['origin'] = 'call',\n): DiagnosticInput {\n  const { field, rows, count, ...context } = details;\n  const firstRows = rows?.slice(0, 10);\n  const entry = diagnosticRegistry[code];\n  const diagnostic: DiagnosticInput = {\n    code, level: entry.level, effect, origin,\n    message: entry.message({ field, rows: firstRows, count, ...context }),\n    ...(field === undefined ? {} : { field }),\n    ...(firstRows === undefined ? {} : { rows: firstRows }),\n    ...(count === undefined ? {} : { count }),\n  };\n  contexts.set(diagnostic, context);\n  return diagnostic;\n}\n\nexport function report(sink: DiagnosticSink, code: DiagnosticCode, effect: DiagnosticEffect, details?: DiagnosticDetails): void {\n  sink.add(createDiagnostic(code, effect, details));\n}\nimport type { AlignedFrame, Frame } from '../../src/core/contracts';\nimport { normalize, resolveOptions, type ChartType } from '../../src/data';\nimport { DiagnosticCollector } from '../../src/diagnostics';\n\nexport const version = { epoch: 4, revision: 8 };\nexport const utc = { timeZone: 'UTC' };\n\nexport function check(type: ChartType, options: unknown, environment = utc): { frame: Frame; diagnostics: DiagnosticCollector } {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions(type, options, diagnostics);\n  return { frame: normalize(type, resolved, environment, diagnostics, version), diagnostics };\n}\n\nexport function aligned(options: unknown, environment = utc) {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions('line', options, diagnostics);\n  return { frame: normalize('line', resolved, environment, diagnostics, version), diagnostics, resolved };\n}\n\nexport function contents(frame: AlignedFrame) {\n  return {\n    x: { ...frame.x, values: [...frame.x.values] },\n    length: frame.length, xLabel: frame.xLabel, yLabel: frame.yLabel,\n    series: frame.series.map(({ y, slot, row, ...description }) => ({\n      ...description, y: [...y], slot: [...slot], row: row ? [...row] : [...y.keys()],\n    })),\n  };\n}\nimport { describe, expect, it } from 'vitest';\nimport fc from 'fast-check';\nimport { SLOT_GAP, SLOT_NULL, SLOT_VALUE } from '../../src/core/contracts';\nimport { AlignedStore } from '../../src/data';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { aligned, contents, utc, version } from './helpers';\n\nfunction store(options: unknown, sink?: DiagnosticCollector): AlignedStore {\n  return new AlignedStore('line', aligned(options).resolved, utc, version, sink);\n}\n\ndescribe('streaming', () => {\n  it('extends owned buffers with views and preserves older revisions', () => {\n    const data = [{ x: 0, y: 100 }, { x: 1, y: 101 }, { x: 2, y: 102 }];\n    const stream = store({ data, x: 'x', y: 'y' });\n    const before = stream.frame;\n    const appended = { x: 3, y: 103 };\n    const after = stream.append([appended]);\n    expect(after.x.values.buffer).toBe(before.x.values.buffer);\n    expect(after.series[0]!.y.buffer).toBe(before.series[0]!.y.buffer);\n    expect(after.series[0]!.slot.buffer).toBe(before.series[0]!.slot.buffer);\n    expect(after.series[0]!.row?.buffer).toBe(before.series[0]!.row?.buffer);\n    expect([...before.x.values]).toEqual([0, 1, 2]);\n    expect([...before.series[0]!.y]).toEqual([100, 101, 102]);\n    expect([...after.x.values]).toEqual([0, 1, 2, 3]);\n    expect([...after.series[0]!.y]).toEqual([100, 101, 102, 103]);\n    expect([...after.series[0]!.row!]).toEqual([0, 1, 2, 3]);\n    expect(after.epoch).toBe(before.epoch);\n    expect(after.revision).toBe(before.revision + 1);\n    expect(before.source.rowAt(3)).toBeNull();\n    expect(after.source.rowAt(3)).toBe(appended);\n  });\n\n  it('streams from borrowed columns and uses the row meaning of NaN for appends', () => {\n    const data = { columns: { x: Float64Array.of(0, 1, 2), y: Float32Array.of(6, NaN, 8) } };\n    const stream = store({ data, x: 'x', y: 'y' });\n    const added = { x: 3, y: NaN };\n    const next = stream.append([added]);\n    expect([...next.series[0]!.y]).toEqual([6, NaN, 8, NaN]);\n    expect(next.series[0]!.slot[1]).toBe(SLOT_NULL);\n    expect(next.source.rowAt(1)).toEqual({ x: 1, y: NaN });\n    expect(next.source.rowAt(3)).toBe(added);\n    expect(stream.diagnostics).toMatchObject([{ code: 'AX103', rows: [3], count: 1 }]);\n    const earlier = { x: -1, y: 5 };\n    const fallback = stream.append([earlier]);\n    expect([...fallback.x.values]).toEqual([-1, 0, 1, 2, 3]);\n    expect([...fallback.series[0]!.row!]).toEqual([4, 0, 1, 2, 3]);\n    expect(fallback.series[0]!.slot[2]).toBe(SLOT_NULL);\n    expect(fallback.source.rowAt(4)).toBe(earlier);\n    expect(stream.diagnostics).toMatchObject([{ code: 'AX103', rows: [3] }, { code: 'AX151', rows: [4] }]);\n    expect([...data.columns.y]).toEqual([6, NaN, 8]);\n  });\n\n  it('streams multiple wide fields and a growing long series set', () => {\n    const prior = [{ x: 1, a: 1, b: null }, { x: 2, a: 2, b: 20 }];\n    const wide = store({ data: prior, x: 'x', y: ['a', 'b'] });\n    const more = [{ x: 3, a: 3, b: 30 }];\n    const wideNext = wide.append(more);\n    expect(wideNext.series.map(s => [...s.y])).toEqual([[1, 2, 3], [NaN, 20, 30]]);\n    expect(contents(wideNext)).toEqual(contents(aligned({ data: [...prior, ...more], x: 'x', y: ['a', 'b'] }).frame));\n\n    const initial = [{ x: 1, y: 1, name: 'A' }];\n    const additions = [{ x: 1, y: 7, name: 'B' }, { x: 2, y: 2, name: 'A' }, { x: 3, y: 5, name: 'C' }];\n    const long = store({ data: initial, x: 'x', y: 'y', series: 'name' });\n    const before = long.frame;\n    for (const row of additions) long.append([row]);\n    expect(contents(long.frame)).toEqual(contents(aligned({\n      data: [...initial, ...additions], x: 'x', y: 'y', series: 'name',\n    }).frame));\n    expect(before.series).toHaveLength(1);\n    expect([...before.series[0]!.y]).toEqual([1]);\n    expect(long.diagnostics).toEqual([]);\n  });\n\n  it('extends an established grid with a new gap without copying previous slots', () => {\n    const data = [0, 1, 2].map(x => ({ x, y: x }));\n    const stream = store({ data, x: 'x', y: 'y' });\n    const before = stream.frame;\n    const after = stream.append([{ x: 4, y: 4 }]);\n    expect(after.x.values.buffer).toBe(before.x.values.buffer);\n    expect([...after.x.values]).toEqual([0, 1, 2, 3, 4]);\n    expect([...after.series[0]!.slot]).toEqual([SLOT_VALUE, SLOT_VALUE, SLOT_VALUE, SLOT_GAP, SLOT_VALUE]);\n    expect([...after.series[0]!.row!]).toEqual([0, 1, 2, -1, 3]);\n    expect(stream.diagnostics).toMatchObject([{ code: 'AX105', count: 1 }]);\n  });\n\n  it('removes inferred gaps when more observations invalidate the old cadence', () => {\n    const data = [0, 1, 2, 4].map(x => ({ x, y: x }));\n    const stream = store({ data, x: 'x', y: 'y' });\n    const before = stream.frame;\n    const after = stream.append([{ x: 4.5, y: 10 }]);\n    expect([...before.x.values]).toEqual([0, 1, 2, 3, 4]);\n    expect([...after.x.values]).toEqual([0, 1, 2, 4, 4.5]);\n    expect(stream.diagnostics).toEqual([]);\n  });\n\n  it('retains the latest observed positions along with interior gaps and evicts original source rows', () => {\n    const data = [0, 1, 2, 4].map(x => ({ x, y: x }));\n    const stream = store({ data, x: 'x', y: 'y' });\n    const newest = { x: 5, y: 5 };\n    const frame = stream.append([newest], { keep: 3 });\n    expect([...frame.x.values]).toEqual([2, 3, 4, 5]);\n    expect([...frame.series[0]!.row!]).toEqual([2, -1, 3, 4]);\n    expect(frame.source.rowAt(0)).toBeNull();\n    expect(frame.source.rowAt(1)).toBeNull();\n    expect(frame.source.rowAt(2)).toBe(data[2]);\n    expect(frame.source.rowAt(4)).toBe(newest);\n    const older = { x: 1, y: 20 };\n    const outOfOrder = stream.append([older], { keep: 2 });\n    expect([...outOfOrder.x.values]).toEqual([4, 5]);\n    expect([...outOfOrder.series[0]!.row!]).toEqual([3, 4]);\n    expect(outOfOrder.source.rowAt(5)).toBeNull();\n  });\n\n  it('keeps category identities stable across eviction and keeps old category views immutable', () => {\n    const data = [{ x: 'Monday', y: 1 }, { x: 'Tuesday', y: 2 }];\n    const stream = store({ data, x: 'x', y: 'y' });\n    const before = stream.frame;\n    const after = stream.append([{ x: 'Wednesday', y: 3 }], { keep: 2 });\n    expect(before.x.categories).toEqual(['Monday', 'Tuesday']);\n    expect(after.x.categories).toEqual(['Monday', 'Tuesday', 'Wednesday']);\n    expect([...after.x.values]).toEqual([1, 2]);\n    expect([...after.series[0]!.row!]).toEqual([1, 2]);\n  });\n\n  it('leaves the frame and category state untouched if a diagnostic sink rejects an append', () => {\n    const stream = store({ data: [{ x: 'Mon', y: 1 }], x: 'x', y: 'y' });\n    const initial = stream.frame;\n    expect(() => stream.append([{ x: 'Tue', y: Infinity }], {}, {\n      add(diagnostic) { if (diagnostic.level === 'warning') throw new Error(diagnostic.code); },\n    })).toThrow('AX103');\n    expect(stream.frame).toBe(initial);\n    const next = stream.append([{ x: 'Wed', y: 3 }]);\n    expect(next.x.categories).toEqual(['Mon', 'Wed']);\n    expect([...next.series[0]!.row!]).toEqual([0, 1]);\n  });\n\n  it('revalidates earlier decimal strings when a later row makes the column mixed', () => {\n    const stream = store({ data: [{ x: 0, y: '1' }], x: 'x', y: 'y' });\n    expect(stream.frame.series[0]!.y[0]).toBe(1);\n    const frame = stream.append([{ x: 1, y: 2 }]);\n    expect([...frame.series[0]!.y]).toEqual([NaN, 2]);\n    expect(stream.diagnostics).toMatchObject([{ code: 'AX106', rows: [0], count: 1 }]);\n  });\n});\n\ndescribe('streaming invariants', () => {\n  const data = fc.array(fc.record({\n    x: fc.integer({ min: -24, max: 24 }),\n    y: fc.oneof(fc.integer(), fc.constant(null), fc.constant(undefined), fc.constant(NaN), fc.constant('5')),\n  }), { maxLength: 35 });\n\n  it('matches full normalization when adding the same rows one by one', () => {\n    fc.assert(fc.property(data, fc.boolean(), (rows, shuffle) => {\n      const input = shuffle ? rows : [...rows].sort((a, b) => a.x - b.x);\n      const options = { data: input, x: 'x', y: 'y' };\n      const stream = store({ ...options, data: [] });\n      for (const row of input) stream.append([row]);\n      const whole = aligned(options).frame;\n      expect(contents(stream.frame)).toEqual(contents(whole));\n    }), { numRuns: 150 });\n  });\n\n  it('never keeps more than k distinct observed positions and always keeps the latest ones', () => {\n    fc.assert(fc.property(data, fc.integer({ min: 0, max: 10 }), (rows, keep) => {\n      const stream = store({ data: [], x: 'x', y: 'y' });\n      const seen = new Set<number>();\n      for (const row of rows) {\n        const frame = stream.append([row], { keep });\n        seen.add(row.x);\n        const expected = keep === 0 ? [] : [...seen].sort((a, b) => a - b).slice(-keep);\n        const observed = [...frame.x.values].filter((_, i) => frame.series.some(series => series.row![i]! >= 0));\n        expect(observed).toEqual(expected);\n        expect(observed.length).toBeLessThanOrEqual(keep);\n      }\n    }), { numRuns: 150 });\n  });\n});\n\ndescribe('diagnostics in a retained window', () => {\n  it('discards diagnostics with their rows and lets a series draw after its duplicate x leaves', () => {\n    const data = [{ x: 0, y: 1 }, { x: 1, y: NaN }];\n    const stream = store({ data, x: 'x', y: 'y' });\n    const first = stream.frame;\n    const duplicate = stream.append([{ x: 1, y: 9 }]);\n    expect(duplicate.x.values.buffer).toBe(first.x.values.buffer);\n    expect(duplicate.series[0]!.y.buffer).toBe(first.series[0]!.y.buffer);\n    expect(first.series[0]!.drawable).toBe(true);\n    expect(duplicate.series[0]!.drawable).toBe(false);\n    expect(stream.diagnostics.map(d => [d.code, d.rows])).toEqual([['AX103', [1]], ['AX108', [2]]]);\n    const latest = stream.append([{ x: 2, y: 2 }, { x: 3, y: 3 }], { keep: 2 });\n    expect(latest.series[0]!.drawable).toBe(true);\n    expect(stream.diagnostics).toEqual([]);\n    expect(latest.source.rowAt(1)).toBeNull();\n    expect(latest.source.rowAt(2)).toBeNull();\n  });\n\n  it('retains only examples and counts within the active window after the original examples are evicted', () => {\n    const data = Array.from({ length: 15 }, (_, i) => ({ x: i, y: NaN }));\n    const stream = store({ data, x: 'x', y: 'y' });\n    stream.append([{ x: 15, y: NaN }], { keep: 4 });\n    expect(stream.diagnostics).toMatchObject([{ code: 'AX103', count: 4, rows: [12, 13, 14, 15] }]);\n  });\n\n  it('recovers the daily-calendar hint when eviction removes a non-daily interval', () => {\n    const x = { field: 'x', type: 'time' };\n    const days = [Date.UTC(2026, 2, 7), Date.UTC(2026, 2, 8), Date.UTC(2026, 2, 9), Date.UTC(2026, 2, 10)];\n    const data = [{ x: days[0]! - 3600_000, y: 4 }, ...days.slice(0, 3).map(x => ({ x, y: 5 }))];\n    const stream = store({ data, x, y: 'y' });\n    expect(stream.diagnostics.map(d => d.code)).not.toContain('AX111');\n    stream.append([{ x: days[3], y: 6 }], { keep: 3 });\n    expect(stream.diagnostics).toMatchObject([{ code: 'AX111', count: 3, rows: [2, 3, 4] }]);\n    stream.append([], { keep: 1 });\n    expect(stream.diagnostics).toEqual([]);\n  });\n});\n\nit('matches full long-form normalization when series arrive one row at a time at shared x positions', () => {\n  fc.assert(fc.property(fc.array(fc.record({\n    x: fc.integer({ min: 0, max: 20 }),\n    y: fc.oneof(fc.integer(), fc.constant(null)),\n    series: fc.constantFrom('a', 'b', 'c'),\n  }), { maxLength: 40 }), rows => {\n    const data = [...rows].sort((a, b) => a.x - b.x);\n    const options = { data, x: 'x', y: 'y', series: 'series' };\n    const stream = store({ ...options, data: [] });\n    for (const row of data) stream.append([row]);\n    expect(contents(stream.frame)).toEqual(contents(aligned(options).frame));\n  }));\n});\n### 1.5 Handle and commit contract\n\n```ts\nchart.update({ title: 'Sessions' });                 // options\nchart.append([{ day: '2026-05-01', channel: 'Direct', sessions: 41210 }], { keep: 120 });   // rows\nchart.zoom(['2026-03-01', '2026-03-31']);            // view\nconst off = chart.on('hover', point => { … });\nchart.diagnostics;                                   // current, as soon as any call returns\nchart.destroy();\n```\n\nFinding D3: the ten libraries have seven update idioms. Axylo has three methods, one per kind of change, with one contract.\n\n| Rule | Detail |\n|---|---|\n| Order | Calls are applied in the order made. `update({ data })` followed by `append` appends to the new data. |\n| Two phases | Each call validates and normalizes synchronously: diagnostics are current when it returns, and a `strict` chart throws from that call. Drawing is deferred to the next animation frame, and calls made before that frame are drawn once. |\n| Atomic switch | Marks, labels, hit testing and the accessibility layer move to a new data revision together. No frame mixes two revisions. |\n| Patches | A key present in an `update` replaces the old value whole; a key set to `undefined` returns to its default; absent keys stay. No deep merging. |\n| Rejected changes | A call that throws under `strict` leaves the chart on its last valid state. |\n| Streaming | `keep` is the number of distinct x values retained. Rows before the last x are accepted through the slower full update and raise AX151. While zoomed to the latest edge the view follows new data; zoomed elsewhere, it stays put. Paused charts buffer (I6). Keyboard focus stays on its datum until that datum leaves the window (A7). |\n| Teardown | `destroy()` cancels the pending frame, disconnects observers and listeners, and makes later calls no-ops. |\n\n### 1.6 Diagnostics\n\nThe registry, with each code's level and outcome, is in the spec (section 3.5). Example for the Phase 1 combined dirty fixture (`[10, 20, null, NaN, '40', undefined, 70]`):\n\n```\n[axylo AX103] \"Dirty input\": y field \"value\" has 1 value that is not a finite number (NaN at row 3). Shown as a gap.\n  Check the calculation that produced it, or send null for \"no data\".\n[axylo AX106] \"Dirty input\": y field \"value\" mixes numbers with 1 string (\"40\" at row 4). The string is not plotted.\n  Convert it to a number where the data is produced.\n[axylo AX102] \"Dirty input\": y field \"value\" is absent in 1 row (row 5). Shown as a gap.\n  Send null if the value is known to be missing.\n```\n\nThe reader of that chart sees \"3 values not shown. See table.\" (F12).\n\n`validate(type, options)` runs the same normalization without a DOM and returns the diagnostics, so a server, a test or a coding agent can check a chart before rendering it.\n\nDevelopment and production flavours are selected through package `exports` conditions. The script-tag distribution ships `axylo.js` (development) and `axylo.min.js` (production). Errors and warnings print once per code per page in both; hints only in development.\n\n### 1.7 React adapter\n\n * count towards \"N values not shown\"; a warning about contrast or an unknown option does not.\n */\nexport type DiagnosticEffect = 'none' | 'omitted' | 'changed' | 'series-disabled' | 'chart-error';\n\n/** A diagnostic before the chart adds its own name. */\nexport type DiagnosticInput = Omit<Diagnostic, 'chart'> & {\n  readonly effect: DiagnosticEffect;\n  /**\n   * 'call': found while validating a create, update or append call; a `strict` chart throws from that call.\n   * 'presentation': found later (a contrast check after a CSS change, a formatter that throws on a lazily\n   * built table cell, a label that no longer fits after a resize); reported when found, never thrown.\n   */\n  readonly origin: 'call' | 'presentation';\n};\n\nexport interface DiagnosticSink {\n  /** Adds one diagnostic. The sink merges by code, field and effect: counts are added, example rows capped at 10. */\n  add(d: DiagnosticInput): void;\n}\n\n// ───────────────────────────── frame ─────────────────────────────\n\n/**\n * What an x value is.\n *  number   – a plain measure.\n *  time     – an instant. Position = epoch milliseconds (UTC). Shown in `XColumn.timeZone`.\n *  date     – a calendar date, month or year. Position = epoch milliseconds of that date at 00:00 UTC;\n *             always formatted in UTC, so it reads the same in every viewer zone.\n *  wall     – a date-time written without an offset. Position = the written fields read as if UTC;\n *             always formatted in UTC (\"shown as written\").\n *  category – a name. Position = index in first-seen order (bar, line) or given order (donut).\n */\nexport type XKind = 'number' | 'time' | 'date' | 'wall' | 'category';\n\n/** State of one slot of an aligned series. */\nexport const SLOT_VALUE = 0;         // a finite number\nexport const SLOT_NULL = 1;          // explicit null (or NaN in a typed column, or an empty string): \"no data\", silent\nexport const SLOT_INVALID = 2;       // present but not plottable (NaN or infinity in a row, a stray string): reported\nexport const SLOT_NO_ROW = 3;        // this series has no observation at this x and none was expected; neighbours may be joined across it\nexport const SLOT_GAP = 4;           // an expected step of this series is absent (AX105): never joined across\nexport const SLOT_ABSENT_FIELD = 5;  // the row exists but the field's key is absent or undefined (AX102)\nexport type SlotState = 0 | 1 | 2 | 3 | 4 | 5;\n/**\n * `missing: 'zero'` on a value field is applied by normalization: slots that would be SLOT_NULL, SLOT_NO_ROW,\n * SLOT_GAP or SLOT_ABSENT_FIELD become SLOT_VALUE with y = 0 and row = -1. SLOT_INVALID is never turned into zero.\n */\n\n/** Half-open range of indexes. */\nexport interface IndexRange { readonly start: number; readonly end: number }\n\nexport interface XColumn {\n  readonly kind: XKind;\n  /** Strictly ascending positions, one per slot. For 'category': 0, 1, 2, … */\n  readonly values: Float64Array;\n  /** For 'category': the name of each position. Otherwise null. */\n  readonly categories: readonly string[] | null;\n  /** For 'time': the resolved IANA zone ('UTC', 'America/Los_Angeles', …; 'local' is resolved before it gets here). Otherwise null. */\n  readonly timeZone: string | null;\n  /** For 'date': the precision the values were written in ('2026-02' is a month); the finest one if they are mixed. Otherwise null. */\n  readonly dateUnit: 'day' | 'month' | 'year' | null;\n  /** For 'category': true when the author declared the categories ordered, so the axis may be thinned (spec L1). */\n  readonly ordered: boolean;\n}\n\n/** The caller's data behind a frame, for events and for the table's provenance. */\nexport interface RowSource {\n  /** The caller's row at a source index (materialized on demand for typed columns), or null if it is no longer retained. */\n  rowAt(sourceIndex: number): unknown;\n}\n\n/** One series of an aligned frame: a y value and a state for every x slot. */\nexport interface Series {\n  /** Stable identity: the series value (long form) or the field name (wide form). Used for colors and toggling. */\n  readonly key: string;\n  /** Name shown to the reader. */\n  readonly label: string;\n  /** The value field this series was read from, for diagnostics. */\n  readonly field: string;\n  readonly unit: string | null;\n  readonly valueScale: 'percent' | 'ratio' | null;\n  /** False when the series cannot be drawn (duplicate x, AX108). It stays in the frame so the table and summary can say so. */\n  readonly drawable: boolean;\n  /** y per slot. NaN wherever `slot` is not SLOT_VALUE. May be a view on the caller's typed column. */\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n  /** Index of the caller's row each slot came from, -1 where there is none. null means \"slot i came from row i\" (typed columns). */\n  readonly row: Int32Array | null;\n}\n\n/** One series of a point frame (scatter): its own x and y, sorted by x then y. */\nexport interface PointSeries {\n  readonly key: string;\n  readonly label: string;\n  readonly drawable: boolean;\n  readonly x: Float64Array;\n  readonly y: Float64Array;\n  readonly row: Int32Array | null;\n}\n\n/**\n * The normalized, lossless data. Immutable: an update or append produces a new frame with a higher revision.\n * Buffers may be shared between revisions; a streaming store appends into spare capacity and hands out\n * subarray views, so an append does not copy what is already there.\n */\ninterface FrameBase {\n  readonly revision: number;\n  /** Changes when the data is replaced or the encoding changes; survives append and eviction. A DatumRef is only meaningful within one epoch. */\n  readonly epoch: number;\n  readonly source: RowSource;\n}\n\nexport interface AlignedFrame extends FrameBase {\n  readonly shape: 'aligned';\n  readonly x: XColumn;\n  readonly series: readonly Series[];\n  /** Number of x slots. */\n  readonly length: number;\n  readonly xLabel: string;\n  readonly yLabel: string | null;\n}\n\nexport interface PointFrame extends FrameBase {\n  readonly shape: 'points';\n  readonly xKind: Exclude<XKind, 'category'>;\n  readonly timeZone: string | null;\n  readonly series: readonly PointSeries[];\n  readonly xLabel: string;\n  readonly yLabel: string;\n  readonly xUnit: string | null;\n  readonly yUnit: string | null;\n}\n\n/** Donut data: every category the caller gave, in the given order, before any grouping into \"Other\". */\nexport interface DonutFrame extends FrameBase {\n  readonly shape: 'donut';\n  readonly labels: readonly string[];\n  /** NaN where `slot` is not SLOT_VALUE. */\n  readonly values: Float64Array;\n  readonly slot: Uint8Array;\n  readonly row: Int32Array | null;\n  readonly valueLabel: string;\n  readonly unit: string | null;\n  readonly valueScale: 'percent' | 'ratio' | null;\n}\n\nexport type Frame = AlignedFrame | PointFrame | DonutFrame;\n\n\ntype Key<Row> = Extract<keyof Row, string>;\ntype KeysWhere<Row, V> = { [K in Key<Row>]: [Row[K]] extends [V] ? K : never }[Key<Row>];\n\n/** A field that can sit on a value axis as it is. */\nexport type NumberKey<Row> = KeysWhere<Row, number | null | undefined>;\n/** A field of numeric strings (Postgres bigint and numeric, BigQuery): allowed only with `parse: 'number'`. */\nexport type StringKey<Row> = KeysWhere<Row, string | null | undefined>;\n/** A field that can sit on an x axis: numbers, instants, calendar dates or categories. */\nexport type XKey<Row> = KeysWhere<Row, number | string | Date | null | undefined>;\n/** A field that names a series. */\nexport type SeriesKey<Row> = KeysWhere<Row, string | number | boolean>;\n\nexport type XValue = number | string | Date;\n\n// ---------- fields ----------\n\ninterface FieldCommon {\n  /** Axis title and the name used in tooltip, table and announcements. */\n  label?: string;\n  /** Unit appended to values in tooltip, table and announcements: 'ms', 'USD', … */\n  unit?: string;\n}\n\nexport interface ValueFieldOptions extends FieldCommon {\n  /** Declares percentage data and its convention: 'percent' = 0–100, 'ratio' = 0–1. Never inferred from the label. */\n  scale?: 'percent' | 'ratio';\n  /** How values are written in tooltip, table and announcements. Default: locale grouping, up to 6 significant fraction digits. */\n  format?: Intl.NumberFormatOptions | ((value: number) => string);\n  /** How axis ticks are written. Default: compact when it saves space. */\n  tickFormat?: Intl.NumberFormatOptions | ((value: number) => string);\n  /** What a missing value means. 'gap' (default) draws nothing; 'zero' is for counts where absence means none. */\n  missing?: 'gap' | 'zero';\n  /** Author bounds. On bar and area the domain is widened to include zero and AX110 is raised if it did not. */\n  domain?: readonly [number, number];\n}\n\nexport type ValueField<Row> =\n  | NumberKey<Row>\n  | ({ field: NumberKey<Row>; parse?: never } & ValueFieldOptions)\n  | ({ field: StringKey<Row>; parse: 'number' } & ValueFieldOptions);\n\nexport interface XFieldOptions extends FieldCommon {\n  /**\n   * 'date': calendar dates ('2026-02-24'); read the same in every time zone.\n   * 'time': instants (epoch milliseconds, Date objects, ISO strings with an offset); shown in `timeZone`.\n   * 'number' and 'category' as named. Inferred when omitted, except that numbers are never inferred to be instants.\n   */\n  type?: 'number' | 'time' | 'date' | 'category';\n  /** Category axes only: the categories have a natural order (months, age bands), so labels may be thinned when they do not fit. */\n  ordered?: boolean;\n  /** For instants only. Default 'local' (the viewer's zone). */\n  timeZone?: 'local' | 'UTC' | (string & {});\n  format?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n  tickFormat?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\nexport interface Messages {\n  viewAsTable: string; hideTable: string;\n  noData: string; noObservation: string; incompleteStack: string;\n  moreRows: string; otherSlices: string;\n  valuesNotShown: string; valuesChanged: string; labelsHidden: string;\n  loading: string; empty: string; error: string; internalError: string;\n  chartName: string; chartSummary: string; seriesSummary: string; referenceSummary: string; timeZoneNote: string;\n  plotLabel: string; controlsLabel: string; pointOf: string;\n  zoomIn: string; zoomOut: string; resetZoom: string; pause: string; resume: string;\n  previousPage: string; nextPage: string; pageOf: string; jumpToX: string;\n  showSeries: string; hideSeries: string;\n}\n","exit_code":0,"status":"completed"}}
