{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/{data/{x,steps,options,values,reports,validate,table},diagnostics/{collector,registry}}.ts'","aggregated_output":"import type { Environment, XColumn, XKind } from '../core/contracts';\nimport type { ResolvedXField } from './options';\nimport { Reports } from './reports';\nimport type { Table } from './table';\n\nconst calendar = /^(\\d{4})(?:-(\\d{2})(?:-(\\d{2}))?)?$/;\nconst dateTime = /^(\\d{4})-(\\d{2})-(\\d{2})[Tt](\\d{2}):(\\d{2})(?::(\\d{2})(?:\\.(\\d+))?)?([Zz]|[+-]\\d{2}:?\\d{2})?$/;\nconst daysInMonth = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\nconst maxInstant = 8_640_000_000_000_000;\nexport const DAY = 86_400_000;\nexport const HOUR = 3_600_000;\nexport type DateUnit = NonNullable<XColumn['dateUnit']>;\n\nfunction validDate(year: string, month = '01', day = '01'): boolean {\n  const m = Number(month);\n  const y = Number(year);\n  const leap = y % 4 === 0 && (y % 100 !== 0 || y % 400 === 0);\n  const max = (daysInMonth[m - 1] ?? 0) + (m === 2 && leap ? 1 : 0);\n  return Number(day) >= 1 && Number(day) <= max;\n}\n\nexport function kindOf(value: unknown): XKind | null {\n  if (typeof value === 'number') return Number.isFinite(value) ? 'number' : null;\n  if (value instanceof Date) return 'time';\n  if (typeof value !== 'string') return null;\n  if (calendar.test(value)) return 'date';\n  const parts = dateTime.exec(value);\n  if (parts) return parts[8] ? 'time' : 'wall';\n  // An invalid ISO-looking value should be reported rather than establishing a category axis.\n  if (/^\\d{4}-\\d{2}-\\d{2}[Tt]/.test(value)) return 'wall';\n  return 'category';\n}\n\nfunction instant(value: string, kind: 'time' | 'wall'): number {\n  const parts = dateTime.exec(value);\n  if (!parts || !validDate(parts[1]!, parts[2], parts[3]) || (kind === 'time') !== Boolean(parts[8])) return NaN;\n  return Date.parse(kind === 'wall' ? value + 'Z' : value);\n}\n\nexport function inferKind(table: Table, field: string, series: string | null = null): XKind | null {\n  let candidate: XKind | null = null;\n  for (let i = 0; i < table.length; i++) {\n    if (series !== null && nameOf(table.read(i, series)) === null) continue;\n    const value = table.read(i, field);\n    const kind = kindOf(value);\n    candidate ??= kind;\n    if (kind === 'number' || kind === 'category') return kind;\n    if (kind === 'date' && typeof value === 'string') {\n      const parts = calendar.exec(value)!;\n      if (validDate(parts[1]!, parts[2], parts[3])) return kind;\n    } else if (value instanceof Date && Number.isFinite(value.getTime())) {\n      return 'time';\n    } else if ((kind === 'time' || kind === 'wall') && typeof value === 'string' && Number.isFinite(instant(value, kind))) {\n      return kind;\n    }\n  }\n  return candidate;\n}\n\nexport function nameOf(value: unknown): string | null {\n  if (typeof value === 'string') return value;\n  if (typeof value === 'boolean' || typeof value === 'number' && Number.isFinite(value)) return String(value);\n  return null;\n}\n\nexport class XParser {\n  readonly timeZone: string | null;\n  readonly categories: string[] | null;\n  private readonly indexes: Map<string, number> | null;\n  dateUnit: DateUnit | null = null;\n\n  constructor(\n    readonly field: ResolvedXField,\n    readonly kind: XKind,\n    env: Pick<Environment, 'timeZone'>,\n    private readonly scatter = false,\n    categories?: readonly string[],\n  ) {\n    this.timeZone = kind === 'time' ? (field.timeZone === 'local' ? env.timeZone : field.timeZone) : null;\n    this.categories = kind === 'category' ? [...(categories ?? [])] : null;\n    this.indexes = this.categories ? new Map(this.categories.map((name, index) => [name, index])) : null;\n  }\n\n  private parse(raw: unknown, row: number, reports: Reports): number {\n    const kind = this.kind;\n    if (typeof raw === 'number' && Number.isFinite(raw)) {\n      if (kind === 'number' && !this.field.type && Math.abs(raw) >= 1e11 && Math.abs(raw) < 1e14) {\n        reports.add('AX109', 'none', row, undefined, 'Set type: \\'time\\' if these values are epoch milliseconds.');\n      }\n      if (kind === 'time' && this.field.type === 'time' && Math.abs(raw) >= 1e9 && Math.abs(raw) < 1e10) {\n        reports.add('AX109', 'none', row, undefined, 'These values look like seconds. Multiply them by 1,000 to supply epoch milliseconds.');\n      }\n      if (kind === 'number' || kind === 'time' && this.field.type === 'time' && Math.abs(raw) <= maxInstant) return raw;\n    }\n    if (kind === 'time' && raw instanceof Date) return raw.getTime();\n    if (kind === 'category' && !this.scatter) {\n      const name = this.field.type === 'category' ? nameOf(raw) : typeof raw === 'string' && kindOf(raw) === 'category' ? raw : null;\n      if (name === null) return NaN;\n      const known = this.indexes!.get(name);\n      if (known !== undefined) return known;\n      const index = this.categories!.length;\n      this.categories!.push(name);\n      this.indexes!.set(name, index);\n      return index;\n    }\n    if (typeof raw !== 'string') return NaN;\n    if (kind === 'date') {\n      const parts = calendar.exec(raw);\n      if (!parts || !validDate(parts[1]!, parts[2], parts[3])) return NaN;\n      const unit = parts[3] !== undefined ? 'day' : parts[2] !== undefined ? 'month' : 'year';\n      if (this.dateUnit === null || unit === 'day' || unit === 'month' && this.dateUnit === 'year') this.dateUnit = unit;\n      return Date.parse(parts[1] + '-' + (parts[2] ?? '01') + '-' + (parts[3] ?? '01') + 'T00:00:00Z');\n    }\n    if (kind === 'wall' || kind === 'time') {\n      const position = instant(raw, kind);\n      if (kind === 'wall' && Number.isFinite(position)) reports.add('AX112', 'none', row);\n      return position;\n    }\n    return NaN;\n  }\n\n  read(raw: unknown, row: number, reports: Reports): number {\n    if (raw === undefined) {\n      reports.add('AX102', 'omitted', row);\n      return NaN;\n    }\n    const result = this.parse(raw, row, reports);\n    if (!Number.isFinite(result)) {\n      const fix = this.scatter && this.kind === 'category'\n        ? 'Use a numeric, calendar date or time field for scatter x values.'\n        : undefined;\n      reports.add('AX107', 'omitted', row, raw, fix);\n    }\n    return result;\n  }\n\n  restore(categoryCount: number, dateUnit: DateUnit | null): void {\n    this.dateUnit = dateUnit;\n    if (!this.categories) return;\n    while (this.categories.length > categoryCount) this.indexes!.delete(this.categories.pop()!);\n  }\n\n  column(values: Float64Array, snapshotCategories = false): XColumn {\n    const names = this.categories;\n    const length = names?.length;\n    let snapshot: readonly string[] | undefined;\n    return {\n      kind: this.kind, values,\n      get categories() {\n        return names === null || !snapshotCategories ? names : (snapshot ??= names.slice(0, length));\n      },\n      timeZone: this.timeZone, dateUnit: this.kind === 'date' ? this.dateUnit ?? 'day' : null,\n      ordered: this.kind === 'category' && this.field.ordered,\n    };\n  }\n}\n\nexport function dailyDelta(delta: number): number {\n  const days = Math.round(delta / DAY);\n  return days > 0 && Math.abs(delta - days * DAY) <= HOUR ? days * DAY : delta;\n}\n\nexport function sameDailyTime(first: number, position: number): boolean {\n  const delta = position - first;\n  return Math.abs(delta - Math.round(delta / DAY) * DAY) <= HOUR;\n}\nimport type { XColumn } from '../core/contracts';\nimport { instantToWall, utcFields, wallToInstant } from '../scale/zone';\nimport { DAY, dailyDelta } from './x';\n\ntype Axis = Pick<XColumn, 'kind' | 'dateUnit' | 'timeZone'>;\n\nexport function stepDelta(axis: Axis, a: number, b: number): number {\n  if (axis.kind === 'time') return dailyDelta(b - a);\n  if (axis.kind !== 'date') return b - a;\n  if (axis.dateUnit === 'day') return (b - a) / DAY;\n  const from = new Date(a);\n  const to = new Date(b);\n  const years = to.getUTCFullYear() - from.getUTCFullYear();\n  return axis.dateUnit === 'year' ? years : 12 * years + to.getUTCMonth() - from.getUTCMonth();\n}\n\nexport function supportsSteps(axis: Axis): boolean {\n  return axis.kind === 'number' || axis.kind === 'date' || axis.kind === 'time';\n}\n\nexport function stepMultiple(delta: number, step: number): number {\n  const ratio = delta / step;\n  const whole = Math.round(ratio);\n  return whole >= 1 && Number.isSafeInteger(whole) && Math.abs(ratio - whole) < 1e-9 ? whole : 0;\n}\n\nexport function gapPosition(axis: Axis, a: number, b: number, step: number, steps: number, span: number): number {\n  if (axis.kind === 'number') return a + (b - a) * (steps / span);\n  if (axis.kind === 'date') {\n    if (axis.dateUnit === 'day') return a + steps * step * DAY;\n    const from = new Date(a);\n    return axis.dateUnit === 'year'\n      ? utcFields(from.getUTCFullYear() + steps * step, 0, 1)\n      : utcFields(from.getUTCFullYear(), from.getUTCMonth() + steps * step, 1);\n  }\n  if (axis.kind === 'time' && axis.timeZone !== null && step % DAY === 0 && axis.timeZone !== 'UTC') {\n    const wall = instantToWall(axis.timeZone, a);\n    if (instantToWall(axis.timeZone, b) - wall === dailyDelta(b - a)) {\n      return wallToInstant(axis.timeZone, wall + steps * step);\n    }\n  }\n  return a + steps * step;\n}\n\nexport function snapGap(\n  gap: number, a: number, b: number, step: number, count: number, at: (index: number) => number,\n): number {\n  let lo = 0;\n  let hi = count;\n  while (lo < hi) {\n    const mid = lo + Math.floor((hi - lo) / 2);\n    if (at(mid) < gap) lo = mid + 1;\n    else hi = mid;\n  }\n  const before = lo ? at(lo - 1) : -Infinity;\n  const after = lo < count ? at(lo) : Infinity;\n  const nearest = gap - before < after - gap ? before : after;\n  const roundingError = 4 * Number.EPSILON * Math.max(Math.abs(a), Math.abs(b));\n  return Math.abs(gap - nearest) <= Math.min(roundingError, step / 4) ? nearest : gap;\n}\n\nexport function inferGaps(\n  axis: Axis, count: number, xAt: (i: number) => number,\n  snap: (gap: number, a: number, b: number, step: number) => number,\n): Float64Array | null {\n  if (!supportsSteps(axis) || count < 3) return null;\n  let a = xAt(0);\n  let min = Infinity;\n  let max = 0;\n  for (let i = 1; i < count; i++) {\n    const b = xAt(i);\n    const delta = stepDelta(axis, a, b);\n    if (delta < min) min = delta;\n    if (delta > max) max = delta;\n    a = b;\n  }\n  if (stepMultiple(max, min) === 1 || !(min > 0)) return null;\n  let gaps = 0;\n  let consecutive = 0;\n  a = xAt(0);\n  for (let i = 1; i < count; i++) {\n    const b = xAt(i);\n    const multiple = stepMultiple(stepDelta(axis, a, b), min);\n    if (!multiple) return null;\n    if (multiple === 1) consecutive++;\n    gaps += multiple - 1;\n    a = b;\n  }\n  if (consecutive * 2 < count - 1 || !gaps) return null;\n\n  const positions = new Float64Array(gaps);\n  let next = 0;\n  a = xAt(0);\n  for (let i = 1; i < count; i++) {\n    const b = xAt(i);\n    const multiple = stepMultiple(stepDelta(axis, a, b), min);\n    for (let j = 1; j < multiple; j++) {\n      const gap = gapPosition(axis, a, b, min, j, multiple);\n      positions[next++] = axis.kind === 'number' ? snap(gap, a, b, min) : gap;\n    }\n    a = b;\n  }\n  return positions;\n}\nimport type { DiagnosticSink } from '../core/contracts';\nimport type { ValueFieldOptions, XFieldOptions } from '../public';\nimport { report } from '../diagnostics';\nimport { columnsTable, rowsTable, type Columns, type Table } from './table';\n\nexport type AlignedChartType = 'line' | 'area' | 'bar';\nexport type ChartType = AlignedChartType | 'scatter' | 'donut';\n\nexport interface ResolvedXField {\n  readonly field: string;\n  readonly label: string;\n  readonly unit: string | null;\n  readonly type: NonNullable<XFieldOptions['type']> | null;\n  readonly timeZone: string;\n  readonly ordered: boolean;\n  readonly format: NonNullable<XFieldOptions['format']> | null;\n  readonly tickFormat: NonNullable<XFieldOptions['tickFormat']> | null;\n  readonly domain: NonNullable<XFieldOptions['domain']> | null;\n}\n\nexport interface ResolvedValueField {\n  readonly field: string;\n  readonly label: string;\n  readonly unit: string | null;\n  readonly scale: NonNullable<ValueFieldOptions['scale']> | null;\n  readonly missing: NonNullable<ValueFieldOptions['missing']>;\n  readonly parse: 'number' | null;\n  readonly format: NonNullable<ValueFieldOptions['format']> | null;\n  readonly tickFormat: NonNullable<ValueFieldOptions['tickFormat']> | null;\n  readonly domain: NonNullable<ValueFieldOptions['domain']> | null;\n}\n\nexport interface ResolvedOptions {\n  readonly table: Table;\n  readonly x: ResolvedXField;\n  readonly values: readonly ResolvedValueField[];\n  readonly form: 'long' | 'wide';\n  readonly series: string | null;\n  readonly valid: boolean;\n  readonly name: string;\n}\n\nconst common = ['data', 'title', 'labelledBy', 'subtitle', 'description', 'state', 'legend', 'tooltip',\n  'table', 'colors', 'messages', 'locale', 'strict', 'onDiagnostic'];\nconst cartesian = [...common, 'x', 'y', 'series', 'zoom', 'reference'];\nconst aligned = [...cartesian, 'compact'];\nconst keysForChart: Record<ChartType, readonly string[]> = {\n  line: aligned, area: [...aligned, 'stacked'], bar: [...aligned, 'layout', 'horizontal'],\n  scatter: cartesian, donut: [...common, 'label', 'value'],\n};\nconst fieldKeys = ['field', 'label', 'unit', 'format', 'tickFormat', 'domain'];\nconst scatterXKeys = [...fieldKeys, 'type', 'timeZone'];\nconst xKeys = [...scatterXKeys, 'ordered'];\nconst valueKeys = [...fieldKeys, 'scale', 'missing', 'parse'];\nconst messageKeys = ['viewAsTable', 'hideTable', 'noData', 'noObservation', 'incompleteStack', 'moreRows', 'otherSlices',\n  'valuesNotShown', 'valuesChanged', 'labelsHidden', 'loading', 'empty', 'error', 'internalError', 'chartName',\n  'chartSummary', 'seriesSummary', 'referenceSummary', 'timeZoneNote', 'plotLabel', 'controlsLabel', 'pointOf',\n  'zoomIn', 'zoomOut', 'resetZoom', 'pause', 'resume', 'previousPage', 'nextPage', 'pageOf', 'jumpToX'];\n\nfunction distance(a: string, b: string): number {\n  const costs = Array.from({ length: b.length + 1 }, (_, i) => i);\n  for (let i = 1; i <= a.length; i++) {\n    let diagonal = costs[0]!;\n    costs[0] = i;\n    for (let j = 1; j <= b.length; j++) {\n      const above = costs[j]!;\n      costs[j] = Math.min(above + 1, costs[j - 1]! + 1, diagonal + (a[i - 1] === b[j - 1] ? 0 : 1));\n      diagonal = above;\n    }\n  }\n  return costs[b.length]!;\n}\n\nfunction closest(name: string, keys: readonly string[]): string | undefined {\n  let suggestion: string | undefined;\n  let best = Infinity;\n  for (const key of keys) {\n    const score = distance(name.toLowerCase(), key.toLowerCase());\n    if (score < best) {\n      suggestion = key;\n      best = score;\n    }\n  }\n  return suggestion;\n}\n\nfunction object(value: unknown): Record<string, unknown> {\n  return value !== null && typeof value === 'object' ? value as Record<string, unknown> : {};\n}\n\nfunction unknownKeys(options: Record<string, unknown>, keys: readonly string[], sink: DiagnosticSink, path = ''): void {\n  for (const key of Object.keys(options)) {\n    if (!keys.includes(key)) {\n      const suggestion = closest(key, keys);\n      report(sink, 'AX150', 'none', { field: path + key, suggestion: suggestion && path + suggestion, count: 1 });\n    }\n  }\n}\n\nfunction resolveTable(data: unknown, sink: DiagnosticSink): { table: Table; valid: boolean } {\n  if (Array.isArray(data)) return { table: rowsTable(data), valid: true };\n  const columns = object(object(data).columns) as Columns;\n  const keys = Object.keys(columns);\n  const length = columns[keys[0] ?? '']?.length ?? 0;\n  const differing = keys.find(key => columns[key]?.length !== length);\n  if (differing !== undefined) {\n    report(sink, 'AX100', 'chart-error', {\n      field: differing, count: 1, examples: keys.map(key => JSON.stringify(key) + ': ' + columns[key]?.length),\n    });\n  }\n  return { table: columnsTable(columns, length), valid: differing === undefined };\n}\n\nfunction fieldName(input: unknown): string | null {\n  const field = typeof input === 'string' ? input : object(input).field;\n  return typeof field === 'string' ? field : null;\n}\n\nfunction resolveX(input: unknown, type: ChartType, sink: DiagnosticSink): ResolvedXField {\n  const options = object(input) as XFieldOptions;\n  if (type !== 'donut') unknownKeys(object(input), type === 'scatter' ? scatterXKeys : xKeys, sink, 'x.');\n  const field = fieldName(input) ?? '';\n  return {\n    field, label: options.label ?? field, unit: options.unit ?? null,\n    type: type === 'donut' ? 'category' : options.type ?? null,\n    timeZone: options.timeZone ?? 'local', ordered: type !== 'scatter' && (options.ordered ?? false),\n    format: options.format ?? null, tickFormat: options.tickFormat ?? null, domain: options.domain ?? null,\n  };\n}\n\nfunction resolveValue(input: unknown, path: string, sink: DiagnosticSink): ResolvedValueField {\n  const options = object(input) as ValueFieldOptions & { parse?: 'number' };\n  unknownKeys(object(input), valueKeys, sink, path);\n  const field = fieldName(input) ?? '';\n  return {\n    field, label: options.label ?? field, unit: options.unit ?? null, scale: options.scale ?? null,\n    missing: options.missing ?? 'gap', parse: options.parse ?? null, format: options.format ?? null,\n    tickFormat: options.tickFormat ?? null, domain: options.domain ?? null,\n  };\n}\n\nexport function resolveOptions(type: ChartType, input: unknown, sink: DiagnosticSink): ResolvedOptions {\n  const options = object(input);\n  unknownKeys(options, keysForChart[type], sink);\n  unknownKeys(object(options.title), ['text', 'visible', 'level'], sink, 'title.');\n  unknownKeys(object(options.state), ['error', 'empty'], sink, 'state.');\n  unknownKeys(object(options.messages), messageKeys, sink, 'messages.');\n  if (type !== 'donut' && Array.isArray(options.reference)) {\n    options.reference.forEach((reference, row) => {\n      unknownKeys(object(reference), ['x', 'y', 'label'], sink, 'reference[' + row + '].');\n    });\n  }\n\n  const { table, valid: validTable } = resolveTable(options.data, sink);\n  const donut = type === 'donut';\n  const xInput = donut ? options.label : options.x;\n  const x = resolveX(xInput, type, sink);\n  const wide = !donut && Array.isArray(options.y);\n  const supportsWide = type !== 'scatter' && !donut;\n  const valueInputs = wide ? options.y as readonly unknown[] : [donut ? options.value : options.y];\n  const values = valueInputs.map((field, index) =>\n    resolveValue(field, wide ? 'y[' + index + '].' : donut ? 'value.' : 'y.', sink));\n  const series = !wide && !donut && typeof options.series === 'string' ? options.series : null;\n  if (wide && options.series !== undefined) {\n    report(sink, 'AX150', 'none', { field: 'series', count: 1, detail: 'Use a single y field when naming a series field.' });\n  }\n  if (wide && !supportsWide) {\n    report(sink, 'AX150', 'chart-error', { field: 'y', count: 1, detail: 'Use a single y field for scatter charts.' });\n  }\n\n  let valid = validTable && (!wide || supportsWide);\n  const fields: [string | null, string][] = [[fieldName(xInput), donut ? 'label' : 'x']];\n  for (const input of valueInputs) fields.push([fieldName(input), donut ? 'value' : 'y']);\n  if (values.length === 0) fields.push([null, 'y']);\n  if (series !== null) fields.push([series, 'series']);\n  const reported = new Set<string>();\n  for (const [field, role] of fields) {\n    if (field !== null && (table.columns === null && table.length === 0 || table.hasField(field))) continue;\n    const name = field ?? role;\n    if (reported.has(name)) continue;\n    reported.add(name);\n    const keys = table.keys();\n    report(sink, 'AX101', 'chart-error', { field: name, keys, suggestion: closest(name, keys), count: 1 });\n    valid = false;\n  }\n\n  const title = typeof options.title === 'string' ? options.title : object(options.title).text;\n  const name = typeof title === 'string' && title ? title\n    : typeof options.labelledBy === 'string' && options.labelledBy ? options.labelledBy : type;\n  return { table, x, values, form: wide ? 'wide' : 'long', series, valid, name };\n}\nimport { SLOT_ABSENT_FIELD, SLOT_INVALID, SLOT_NULL, SLOT_VALUE, type DiagnosticSink, type SlotState } from '../core/contracts';\nimport type { ResolvedValueField } from './options';\nimport { Reports } from './reports';\nimport type { Table } from './table';\n\nconst decimal = /^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$/;\nexport type ValueMode = 'empty' | 'decimal' | 'other';\n\nexport function valueMode(value: unknown, column: boolean): ValueMode {\n  if (value == null || value === '' || (column && typeof value === 'number' && Number.isNaN(value))) return 'empty';\n  return typeof value === 'string' && decimal.test(value) ? 'decimal' : 'other';\n}\n\nexport function inspectValues(table: Table, field: string): ValueMode {\n  let mode: ValueMode = 'empty';\n  for (let i = 0; i < table.length; i++) {\n    const next = valueMode(table.read(i, field), table.isColumnRow(i));\n    if (next === 'other') return next;\n    if (next === 'decimal') mode = next;\n  }\n  return mode;\n}\n\nexport interface Values {\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n}\n\nexport function readValues(\n  table: Table,\n  field: ResolvedValueField,\n  sink: DiagnosticSink,\n  impute: boolean,\n  startRow = 0,\n  mode = inspectValues(table, field.field),\n): Values {\n  const column = table.columns?.[field.field];\n  const zero = impute && field.missing === 'zero';\n  const reports = new Reports(field.field, sink);\n  const slot = new Uint8Array(table.length);\n  let y = column instanceof Float64Array || column instanceof Float32Array ? column : new Float64Array(table.length);\n\n  for (let i = 0; i < table.length; i++) {\n    const raw = column === undefined ? table.read(i, field.field) : column[i];\n    let value = NaN;\n    let state: SlotState = SLOT_VALUE;\n    if (typeof raw === 'number') {\n      if (Number.isFinite(raw)) value = raw;\n      else if (Number.isNaN(raw) && (column || table.isColumnRow(i))) state = SLOT_NULL;\n      else {\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw);\n      }\n    } else if (raw === undefined) {\n      state = SLOT_ABSENT_FIELD;\n      reports.add('AX102', zero ? 'changed' : 'omitted', startRow + table.rowIndex(i));\n    } else if (raw === null || raw === '') {\n      state = SLOT_NULL;\n    } else if (mode === 'decimal') {\n      value = Number(raw);\n      if (!Number.isFinite(value)) {\n        value = NaN;\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw);\n      }\n      if (field.parse !== 'number') reports.add('AX104', 'none', startRow + table.rowIndex(i));\n    } else {\n      state = SLOT_INVALID;\n      reports.add('AX106', 'omitted', startRow + table.rowIndex(i), raw);\n    }\n    if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) value = 0;\n    if (y === column && !Object.is(y[i], value)) {\n      // Infinity and explicit zero imputation cannot be represented by an unchanged borrowed view.\n      y = y.slice();\n    }\n    if (y !== column) y[i] = value;\n    slot[i] = state;\n  }\n\n  reports.flush(sink);\n  return { y, slot };\n}\nimport type { DiagnosticEffect, DiagnosticSink } from '../core/contracts';\nimport { report, type DiagnosticCode } from '../diagnostics';\nimport type { DiagnosticTrace } from './store-diagnostics';\n\nexport class Reports {\n  private readonly entries = new Map<DiagnosticCode, {\n    effect: DiagnosticEffect;\n    count: number;\n    rows: number[];\n    examples: string[];\n    detail?: string;\n  }>();\n\n  constructor(private readonly field: string, private readonly sink?: DiagnosticTrace) {}\n\n  add(code: DiagnosticCode, effect: DiagnosticEffect, row: number, example?: unknown, detail?: string): void {\n    let entry = this.entries.get(code);\n    if (!entry) {\n      entry = { effect, count: 0, rows: [], examples: [], detail };\n      this.entries.set(code, entry);\n    }\n    this.sink?.traceRow?.(code, this.field, effect, row);\n    entry.count++;\n    if (entry.rows.length < 10) {\n      entry.rows.push(row);\n      if (example !== undefined) {\n        const text = typeof example === 'string' ? JSON.stringify(example)\n          : example !== null && typeof example === 'object' ? Object.prototype.toString.call(example) : String(example);\n        entry.examples.push(text);\n      }\n    }\n  }\n\n  flush(sink: DiagnosticSink): void {\n    for (const [code, { effect, count, rows, examples, detail }] of this.entries) {\n      report(sink, code, effect, { field: this.field, count, rows, examples, detail });\n    }\n  }\n}\nimport { DiagnosticCollector } from '../diagnostics';\nimport type { Diagnostic } from '../public';\nimport { normalize, type DataEnvironment } from './normalize';\nimport { resolveOptions, type ChartType } from './options';\n\nexport function validateOptions(\n  type: ChartType, options: unknown, environment: DataEnvironment = { timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone },\n): readonly Diagnostic[] {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions(type, options, diagnostics);\n  normalize(type, resolved, environment, diagnostics, { epoch: 0, revision: 0 });\n  return diagnostics.list(resolved.name);\n}\nimport type { RowSource } from '../core/contracts';\n\nexport type Columns = Readonly<Record<string, ArrayLike<unknown>>>;\n\nexport interface Table extends RowSource {\n  readonly length: number;\n  readonly columns: Columns | null;\n  read(row: number, field: string): unknown;\n  isColumnRow(row: number): boolean;\n  rowIndex(row: number): number;\n  hasField(field: string): boolean;\n  keys(): readonly string[];\n}\n\nfunction record(row: unknown): Record<string, unknown> | null {\n  return row !== null && typeof row === 'object' ? row as Record<string, unknown> : null;\n}\n\nexport function rowValue(row: unknown, field: string): unknown {\n  const object = record(row);\n  return object && Object.hasOwn(object, field) ? object[field] : undefined;\n}\n\nexport function rowsTable(rows: readonly unknown[]): Table {\n  return {\n    length: rows.length,\n    columns: null,\n    read: (row, field) => rowValue(rows[row], field),\n    rowAt: row => row >= 0 && row < rows.length && Number.isInteger(row) ? rows[row] : null,\n    isColumnRow: () => false,\n    rowIndex: row => row,\n    hasField: field => rows.some(row => {\n      const object = record(row);\n      return object !== null && Object.hasOwn(object, field);\n    }),\n    keys: () => {\n      const keys = new Set<string>();\n      for (const row of rows) for (const key of Object.keys(record(row) ?? {})) keys.add(key);\n      return [...keys];\n    },\n  };\n}\n\nexport function columnsTable(columns: Columns, length: number): Table {\n  const keys = Object.keys(columns);\n  return {\n    length,\n    columns,\n    read: (row, field) => Object.hasOwn(columns, field) ? columns[field]?.[row] : undefined,\n    rowAt: row => row >= 0 && row < length && Number.isInteger(row)\n      ? Object.fromEntries(keys.map(key => [key, columns[key]?.[row]]))\n      : null,\n    hasField: field => Object.hasOwn(columns, field),\n    isColumnRow: () => true,\n    rowIndex: row => row,\n    keys: () => keys,\n  };\n}\nimport type { DiagnosticInput, DiagnosticSink } from '../core/contracts';\nimport type { Diagnostic } from '../public';\nimport { createDiagnostic, diagnosticContext, type DiagnosticCode } from './registry';\n\nexport class DiagnosticCollector implements DiagnosticSink {\n  private readonly entries = new Map<string, DiagnosticInput>();\n\n  add(diagnostic: DiagnosticInput): void {\n    const { code, field, effect, rows, count } = diagnostic;\n    const key = JSON.stringify([code, field, effect]);\n    const first = this.entries.get(key);\n    if (!first) {\n      const copy = rows && rows.length > 10\n        ? { ...diagnostic, rows: rows.slice(0, 10), count: count ?? rows.length }\n        : diagnostic;\n      this.entries.set(key, copy);\n      return;\n    }\n\n    const mergedRows = first.rows || rows\n      ? [...(first.rows ?? []), ...(rows?.slice(0, 10) ?? [])].slice(0, 10)\n      : undefined;\n    const mergedCount = (first.count ?? first.rows?.length ?? 1) + (count ?? rows?.length ?? 1);\n    const origin = diagnostic.origin === 'call' ? 'call' : first.origin;\n    const context = diagnosticContext(first);\n    if (context) {\n      const later = diagnosticContext(diagnostic);\n      const examples = [...(context.examples ?? []), ...(later?.examples ?? [])].slice(0, 10);\n      this.entries.set(key, createDiagnostic(code as DiagnosticCode, effect, {\n        ...context, examples, field, rows: mergedRows, count: mergedCount,\n      }, origin));\n    } else {\n      this.entries.set(key, { ...first, rows: mergedRows, count: mergedCount, origin });\n    }\n  }\n\n  inputs(): readonly DiagnosticInput[] {\n    return Array.from(this.entries.values());\n  }\n\n  list(chart: string): readonly Diagnostic[] {\n    return this.inputs().map(({ effect: _effect, origin: _origin, ...diagnostic }) => ({ ...diagnostic, chart }));\n  }\n}\n\nexport function readerDisclosure(diagnostics: readonly DiagnosticInput[]): { omitted: number; changed: number } {\n  const disclosure = { omitted: 0, changed: 0 };\n  for (const { effect, count, rows } of diagnostics) {\n    if (effect === 'omitted' || effect === 'changed') disclosure[effect] += count ?? rows?.length ?? 1;\n  }\n  return disclosure;\n}\nimport type { DiagnosticEffect, DiagnosticInput, DiagnosticSink } from '../core/contracts';\nimport type { Diagnostic } from '../public';\n\nexport interface DiagnosticDetails {\n  readonly field?: string;\n  readonly rows?: readonly number[];\n  readonly count?: number;\n  readonly examples?: readonly string[];\n  readonly keys?: readonly string[];\n  readonly suggestion?: string;\n  readonly detail?: string;\n}\n\nconst quote = (name: string) => JSON.stringify(name);\nconst field = (d: DiagnosticDetails) => d.field === undefined ? 'The chart' : 'Field ' + quote(d.field);\nconst rows = (d: DiagnosticDetails) => d.rows?.length ? ' at ' + (d.rows.length === 1 ? 'row ' : 'rows ') + d.rows.join(', ') : '';\nconst samples = (d: DiagnosticDetails) => d.examples?.length ? ' (' + d.examples.join(', ') + ')' : '';\nconst count = (d: DiagnosticDetails, word: string, plural = word + 's') =>\n  (d.count ?? 1) + ' ' + ((d.count ?? 1) === 1 ? word : plural);\nconst suggestion = (d: DiagnosticDetails) => d.suggestion === undefined ? '' : ' Did you mean ' + quote(d.suggestion) + '?';\n\ntype Entry = { readonly level: Diagnostic['level']; readonly message: (details: DiagnosticDetails) => string };\n\nexport const diagnosticRegistry = {\n  AX100: { level: 'error', message: d =>\n    field(d) + ' belongs to columns with different lengths' + samples(d) + '. Supply equally long columns.' },\n  AX101: { level: 'error', message: d =>\n    field(d) + ' is missing from the data. Available fields: ' +\n    (d.keys?.length ? d.keys.map(quote).join(', ') : '(none)') + '.' + suggestion(d) + ' Use an available field or add the field to the data.' },\n  AX102: { level: 'warning', message: d =>\n    field(d) + ' is absent in ' + count(d, 'record') + rows(d) + '. Supply the field and send null if the value is known to be missing.' },\n  AX103: { level: 'warning', message: d =>\n    field(d) + ' has ' + count(d, 'non-finite value') + rows(d) + samples(d) + '. Check the calculation that produced it or send null for no data.' },\n  AX104: { level: 'hint', message: d =>\n    field(d) + ' has ' + count(d, 'decimal string') + rows(d) + ' and is drawn as numbers. Set parse: \\'number\\' to make conversion explicit.' },\n  AX105: { level: 'hint', message: d =>\n    field(d) + ' is missing ' + count(d, 'expected step') + samples(d) + '. Supply observations for those positions or explicit nulls to mark gaps.' },\n  AX106: { level: 'warning', message: d =>\n    field(d) + ' has ' + count(d, 'value that cannot be plotted as a number', 'values that cannot be plotted as numbers') +\n    rows(d) + samples(d) + '. Convert values to numbers where the data is produced.' },\n  AX107: { level: 'warning', message: d =>\n    field(d) + ' has ' + count(d, 'unusable value') + rows(d) + samples(d) + '. ' +\n    (d.detail ?? 'Supply an x value in the declared or inferred format for each row.') },\n  AX108: { level: 'error', message: d =>\n    field(d) + ' has ' + count(d, 'duplicate') + rows(d) + samples(d) + '. Provide one row per x and series, or one row per donut label.' },\n  AX109: { level: 'hint', message: d =>\n    field(d) + ' has ' + count(d, 'numeric timestamp') + rows(d) + '. ' +\n    (d.detail ?? 'Set type: \\'time\\' for instants and supply epoch milliseconds.') },\n  AX110: { level: 'warning', message: d =>\n    field(d) + ' has a domain that excludes zero. The domain was widened. Include zero in the domain.' },\n  AX111: { level: 'hint', message: d =>\n    field(d) + ' contains instants that look like calendar dates' + rows(d) + '. Use date strings such as YYYY-MM-DD for calendar dates.' },\n  AX112: { level: 'hint', message: d =>\n    field(d) + ' has ' + count(d, 'date-time without an offset', 'date-times without an offset') + rows(d) +\n    '. Values are shown as written. Include a UTC offset or Z if these are instants.' },\n  AX120: { level: 'error', message: d =>\n    field(d) + ' has ' + count(d, 'negative donut value') + rows(d) + samples(d) + '. Supply non-negative values or choose a chart that shows negatives.' },\n  AX121: { level: 'warning', message: d =>\n    field(d) + ' produces more than eight donut slices. Smaller slices are grouped as Other. Aggregate the data or choose a bar chart to show every category.' },\n  AX130: { level: 'warning', message: d =>\n    field(d) + ' produces more than eight series. The chart uses dashes or markers to distinguish them. Filter or group series to reduce the number.' },\n  AX131: { level: 'hint', message: d =>\n    field(d) + ' produces multiple series in a compact chart. Use one series or turn off compact mode for more room.' },\n  AX132: { level: 'hint', message: d =>\n    field(d) + ' produces more bars than pixels along the category axis. Aggregate categories to make the bars readable.' },\n  AX133: { level: 'hint', message: d =>\n    field(d) + ' produces more than 50,000 scatter points. Drawing may be slow. Filter or aggregate points to reduce drawing time.' },\n  AX140: { level: 'warning', message: () =>\n    'The chart uses a generated name. Set title or labelledBy to give it a descriptive name.' },\n  AX141: { level: 'warning', message: () =>\n    'The chart palette has less than 3:1 contrast against the background. Adjust the colors or background to reach 3:1.' },\n  AX142: { level: 'hint', message: () =>\n    'The plot is too small to draw and shows the summary and table control. Give the plot more room.' },\n  AX143: { level: 'hint', message: d =>\n    field(d) + ' has ' + count(d, 'label') + ' that could not fit. Give the plot more room or shorten the labels.' },\n  AX150: { level: 'warning', message: d =>\n    'Option ' + quote(d.field ?? '') + ' is ignored. ' + (d.detail ?? 'Use an option supported by this chart.') + suggestion(d) },\n  AX151: { level: 'warning', message: d =>\n    field(d) + ' has out-of-order append values' + rows(d) + '. A full update was used. Append rows in x order at or after the last x.' },\n  AX160: { level: 'warning', message: d =>\n    field(d) + '