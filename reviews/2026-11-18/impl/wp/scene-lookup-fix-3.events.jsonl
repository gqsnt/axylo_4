ng): Promise<{ img: Image; box: { x: number; y: number; width: number; height: number } }> {\n  const box = (await page.locator(selector).boundingBox())!;\n  const img = decodePng(await page.screenshot({ clip: box, animations: 'disabled', caret: 'hide' }));\n  return { img, box };\n}\n\nexport type RGB = readonly [number, number, number];\n\nexport function at(img: Image, x: number, y: number): RGB {\npackages/axylo/test/browser/page.html\npackages/axylo/test/browser/blank.html\npackages/axylo/test/browser/acceptance/prod.html\nreviews/2026-11-18/impl/wp/acceptance-browser.fix.report.md:185:**T-pointer-scatter: tie does not go to the later row**\nreviews/2026-11-18/impl/wp/acceptance-browser.fix.report.md:190:**T-dense-donut: thinnest slice not drawn**\n","exit_code":0,"status":"completed"}}
