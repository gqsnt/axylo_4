n  expect(lookup.datum(lookup.primary(tied)!)?.row).toBe(1);\n});\n\nit('T-tooltip-donut donut: tooltip gives slice label, value and percentage independently', () => {\n  const r = chart('donut', donut);\n  r.frames();\n  const { lookup } = committed(r);\n  const tooltip = lookup.tooltip(targetOf(walk(r)[0]!));\n  expect(tooltip.title).toBe('First');\n  expect(tooltip.rows).toMatchObject([{ seriesLabel: 'First', value: '3', percent: '75%' }]);\n  expect(tooltip.total).toBeNull();\n\n/** Two decimals: well below a device pixel at any realistic ratio, and keeps `d` short. */\nconst f = (v: number): number => Math.round(v * 100) / 100;\n\n/**\n * Builds path data in chunks: each chunk is a short string built by appending, and the chunks are joined\n * once, so neither a huge rope nor one array entry per vertex is created.\n */\nclass PathText {\n  private parts: string[] = [];\n  private chunk = '';\n  private n = 0;\n  add(s: string): void {\n    this.chunk += s;\n    if (++this.n === 1024) { this.parts.push(this.chunk); this.chunk = ''; this.n = 0; }\n  }\n  done(): string {\n    if (this.parts.length === 0) return this.chunk;\n    this.parts.push(this.chunk);\n    }\n    if (started) out.add('Z');\n  }\n  return out.done();\n}\n\nfunction pointData(mark: PointMark): string {\n  const { xy, size } = mark;\n  const out = new PathText();\n  if (!(size > 0)) return '';\n  const r = size / 2;\n  if (mark.shape === 'circle') {\n    const a = ` A${f(r)} ${f(r)} 0 1 1 `;\n    for (let i = 0; i + 1 < xy.length; i += 2) {\n      const x = xy[i]!, y = xy[i + 1]!;\n      if (lifted(x) || lifted(y)) continue;\n      // Two half circles, clockwise like the polygons, so overlapping markers union under nonzero.\n      out.add('M' + f(x + r) + ' ' + f(y) + a + f(x - r) + ' ' + f(y) + a + f(x + r) + ' ' + f(y) + 'Z');\n    }\n    return out.done();\n  }\n  const poly = MARKER_POLYGONS[mark.shape];\n  for (let i = 0; i + 1 < xy.length; i += 2) {\n    const x = xy[i]!, y = xy[i + 1]!;\n    if (lifted(x) || lifted(y)) continue;\n    let s = 'M' + f(x + poly[0]! * size) + ' ' + f(y + poly[1]! * size);\n    for (let k = 2; k < poly.length; k += 2) s += 'L' + f(x + poly[k]! * size) + ' ' + f(y + poly[k + 1]! * size);\n    out.add(s + 'Z');\n  }\n  return out.done();\n}\n\nfunction missingData(mark: RectMark, box: Float64Array, clip: Rect | null): string {\n  const q = mark.xywh;\n    const unit = event.deltaMode === 1 ? 16 : event.deltaMode === 2 ? 400 : 1;\n    const factor = Math.min(4, Math.max(0.25, Math.exp(event.deltaY * unit * 0.002)));\n    // The page keeps the wheel when the chart cannot zoom any further that way (review 2, finding 9).\n    if (zoomBy(factor, at ?? undefined)) event.preventDefault();\n  }\n\n  // ── pointer, touch, drag ───────────────────────────────────────────────────────────────────────\n\n  function local(event: MouseEvent): { x: number; y: number } {\n    // In the plot's layout pixels, which picking and the layout use, also under a CSS transform.\n    const box = plot.getBoundingClientRect();\n    const k = cssScale(plot);\n    return { x: (event.clientX - box.left) / k.x, y: (event.clientY - box.top) / k.y };\n  }\n\n  function pointAt(at: { x: number; y: number }): void {\n8:export function position(scale: XScale, value: number): number {\n","exit_code":0,"status":"completed"}}
