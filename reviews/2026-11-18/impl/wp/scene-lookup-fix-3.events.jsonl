{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,166p;406,484p' packages/axylo/test/browser/acceptance/type-matrix.browser.test.ts && sed -n '138,205p' reviews/2026-11-18/impl/wp/acceptance-browser.fix.report.md\"","aggregated_output":"/**\n * The type matrix (spec 3.6), every cell about rendered or interactive behaviour: picking by pointer,\n * tooltip content, keyboard order, zoom, dense drawing (the rendered half), the limit that raises a\n * diagnostic, and reference lines and bands. Marks are identified by where they are drawn and in what\n * colour, never by counting elements alone.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport type { Page } from 'playwright-core';\nimport { start, stop } from '../harness';\nimport {\n  axOf, box, center, closePage, create, createRaw, devPage, distance, inkColorAt, modeColor, plotGeometry, readRange, readTable, resolveColors, ring, screenshot, settle, shapes, signature, valueText, type Box, type RGB,\n} from './util';\nimport { calendar, ENERGY, inOrder, LATENCY_ORDER, share, SHIPPED, SPEND, withUnit } from './fixtures';\nimport { inkColor, referenceMarks, spikeColumn, strokeRuns } from './checks';\n\nbeforeAll(start);\nafterAll(stop);\n\nconst tip = async (page: Page) => ((await page.locator('#chart .axylo-tooltip').isVisible()) ? (await page.locator('#chart .axylo-tooltip').textContent()) ?? '' : '');\nconst xDomain = (page: Page) => page.evaluate(() => (window as unknown as { charts: { __bench: { describe(): { xDomain: number[] | null; yDomain: number[] | null } } }[] }).charts[0]!.__bench.describe());\nconst away = async (page: Page) => { await page.mouse.move(0, 0); await settle(page); };\n/** The angle (radians clockwise from 12 o'clock) of the middle of slice `i` of `values`. */\nconst midAngle = (values: readonly number[], i: number) => (2 * Math.PI * (values.slice(0, i).reduce((a, b) => a + b, 0) + values[i]! / 2)) / values.reduce((a, b) => a + b, 0);\n\n// ── picking ───────────────────────────────────────────────────────────────────────────────────────\n\ndescribe('T-pointer: picking by pointer', () => {\n  for (const type of ['line', 'area'] as const) {\n    it(`T-pointer-${type}: the pointer picks the nearest x: 30 % of the way from one day to the next shows the first, 70 % the second`, async () => {\n      const page = await devPage();\n      await create(page, type);\n      const xs = ((await shapes(page, '#chart', 14))[1] ?? []).map(s => center(s.box).x).sort((a, b) => a - b);\n      expect(xs).toHaveLength(5);\n      const p = await box(page, '#chart .axylo-proxy');\n      for (const [f, want] of [[0.3, 1], [0.7, 2]] as const) {\n        await away(page);\n        await page.mouse.move(xs[1]! + f * (xs[2]! - xs[1]!), p.y + 5);\n        await settle(page);\n        expect(await tip(page)).toContain(calendar(ENERGY.days[want]!));\n      }\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  for (const horizontal of [false, true]) {\n    it(`T-pointer-bar: the band under the pointer is picked, even at its edge and away from the bars${horizontal ? ' (horizontal bars: bands run along y)' : ''}`, async () => {\n      const page = await devPage();\n      await create(page, 'bar', horizontal ? { horizontal: true } : {});\n      const rects = await shapes(page, '#chart', 100000);\n      const along = (b: Box) => (horizontal ? b.y : b.x), size = (b: Box) => (horizontal ? b.height : b.width);\n      const plan = (rects[1] ?? []).map(s => s.box).sort((a, b) => along(a) - along(b));\n      const actual = (rects[2] ?? []).map(s => s.box).sort((a, b) => along(a) - along(b));\n      expect(plan).toHaveLength(4);\n      const p = await box(page, '#chart .axylo-proxy');\n      // The band of the second category runs from half-way between groups 1 and 2 to half-way between 2 and 3.\n      const end = (i: number) => Math.max(along(plan[i]!) + size(plan[i]!), along(actual[i]!) + size(actual[i]!));\n      const startOf = (i: number) => Math.min(along(plan[i]!), along(actual[i]!));\n      const lo = (end(0) + startOf(1)) / 2, hi = (end(1) + startOf(2)) / 2;\n      const labels = horizontal ? SHIPPED.quarters : SHIPPED.quarters;\n      for (const t of [lo + 2, hi - 2, startOf(1) + 1]) {\n        await away(page);\n        await page.mouse.move(horizontal ? p.x + p.width - 4 : t, horizontal ? t : p.y + 4);\n        await settle(page);\n        const text = await tip(page);\n        expect(text, `at ${t}`).toContain(labels[1]!);\n        expect(text).not.toContain(labels[0]!);\n        expect(text).not.toContain(labels[2]!);\n      }\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('T-pointer-donut: the slice under the pointer is picked; the hole and the outside pick nothing', async () => {\n    const page = await devPage();\n    await create(page, 'donut');\n    const g = await ring(page);\n    for (let i = 0; i < 4; i++) {\n      const a = midAngle(SPEND.values, i);\n      await away(page);\n      await page.mouse.move(g.cx + 0.85 * g.outer * Math.sin(a), g.cy - 0.85 * g.outer * Math.cos(a));\n      await settle(page);\n      expect(await tip(page)).toContain(SPEND.items[i]!);\n    }\n    await away(page);\n    await page.mouse.move(g.cx, g.cy);\n    await settle(page);\n    expect(await tip(page)).toBe('');\n    await page.mouse.move(g.cx + g.outer * 1.2, g.cy + g.outer * 0.9);\n    await settle(page);\n    expect(await tip(page)).toBe('');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-pointer-scatter: the nearest point within 24 px is picked: 23 px from a lone point it is, 25 px it is not', async () => {\n    const page = await devPage();\n    await createRaw(page, 'scatter', { title: 'Lone', data: [{ x: 0, y: 0, s: 'corner' }, { x: 20, y: 5, s: 'lone' }, { x: 40, y: 10, s: 'corner' }], x: 'x', y: 'y', series: 's' });\n    const lone = center((await shapes(page, '#chart', 14))[2]![0]!.box);\n    for (const [d, picked] of [[23, true], [25, false]] as const) {\n      for (const [dx, dy] of [[d, 0], [0, -d], [-d * Math.SQRT1_2, d * Math.SQRT1_2]]) {\n        await away(page);\n        await page.mouse.move(lone.x + dx!, lone.y + dy!);\n        await settle(page);\n        expect((await tip(page)).includes('lone'), `${d} px (${Math.round(dx!)}, ${Math.round(dy!)})`).toBe(picked);\n      }\n    }\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-pointer-scatter: two points equally near the pointer: the later row wins, whichever series it is (source order reversed, the other wins)', async () => {\n    for (const order of [['first', 'second'], ['second', 'first']] as const) {\n      const page = await devPage();\n      const rows = { first: { x: 20, y: 5, s: 'first' }, second: { x: 21, y: 5, s: 'second' } };\n      await createRaw(page, 'scatter', { title: 'Tie', data: [{ x: 0, y: 0, s: 'far' }, rows[order[0]], rows[order[1]], { x: 40, y: 9, s: 'far' }], x: 'x', y: 'y', series: 's' });\n      const drawn = await shapes(page, '#chart', 14);\n      const pts = [drawn[2]![0]!, drawn[3]![0]!].map(s => center(s.box));\n      await away(page);\n      await page.mouse.move((pts[0]!.x + pts[1]!.x) / 2, (pts[0]!.y + pts[1]!.y) / 2);\n      await settle(page);\n      const text = await tip(page);\n      expect(text, `rows ${order.join(', ')}`).toContain(order[1]);\n      expect(text).not.toContain(order[0]);\n      expect(await closePage(page)).toEqual([]);\n    }\n  });\n});\n\n// ── tooltip content ───────────────────────────────────────────────────────────────────────────────\n\ndescribe('T-tooltip: tooltip content', () => {\n  for (const type of ['line', 'area', 'bar'] as const) {\n    it(`T-tooltip-${type}: every visible series at that ${type === 'bar' ? 'category' : 'x'}${type === 'area' ? ' and, stacked, the stack total' : ''}, in series order; a hidden series is not listed`, async () => {\n      const page = await devPage();\n      await create(page, type, {}, '#chart', type === 'area' ? 'stacked' : 'default');\n      const p = await box(page, '#chart .axylo-proxy');\n      const drawn = await shapes(page, '#chart', type === 'bar' ? 100000 : 14);\n      const xs = (drawn[1] ?? []).map(s => center(s.box).x).sort((a, b) => a - b);\n      const [first, second] = type === 'bar' ? SHIPPED.series : ENERGY.series;\n      const unit = type === 'bar' ? 't' : 'kWh';\n      const label = type === 'bar' ? SHIPPED.quarters[2]! : calendar(ENERGY.days[2]!);\n      await page.mouse.move(type === 'bar' ? xs[2]! : xs[2]!, p.y + 5);\n      await settle(page);\n      const rows = () => page.locator('#chart .axylo-tooltip .axylo-tooltip-row').evaluateAll(els => els.map(e => e.textContent ?? ''));\n      const want = [`${first!.name}${withUnit(first!.values[2]!, unit)}`, `${second!.name}${withUnit(second!.values[2]!, unit)}`];\n      if (type === 'area') want.push(`Total${withUnit(first!.values[2]! + second!.values[2]!, unit)}`);\n      expect(await page.locator('#chart .axylo-tooltip .axylo-tooltip-title').textContent()).toBe(label);\n      expect(await rows()).toEqual(want);\n      await away(page);\n      await page.locator('#chart .axylo-legend-entry', { hasText: second!.name }).click();\n      await settle(page);\n      await away(page);\n      await page.mouse.move(xs[2]!, p.y + 6);\n      await settle(page);\n      const left = await rows();\n      expect(left[0]).toBe(want[0]);\n      expect(left.join(' ')).not.toContain(second!.name);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('T-tooltip-bar: on horizontal bars too, every series in the category under the pointer', async () => {\n    const page = await devPage();\n    await create(page, 'bar', { horizontal: true });\n    const p = await box(page, '#chart .axylo-proxy');\n    const ys = ((await shapes(page, '#chart', 100000))[1] ?? []).map(s => center(s.box).y).sort((a, b) => a - b);\n    await page.mouse.move(p.x + p.width - 4, ys[1]!);\n    await settle(page);\n      for (let i = 0; i < n; i++) { rows.x[i] = i; rows.y[i] = 20; rows.s[i] = 'A'; rows.x[n + i] = i; rows.y[n + i] = 10 + (i % 2); rows.s[n + i] = 'B'; }\n      rows.y[61_234] = 70;\n      const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => { __bench: { ready(): Promise<void> } }>; charts: unknown[] };\n      const chart = w.Axylo.area!('#chart', { title: 'Stacked dense', data: { columns: rows }, x: { field: 'x', domain: [0, n - 1] }, y: { field: 'y', domain: [0, 100] }, series: 's', stacked: true });\n      w.charts.push(chart);\n      await chart.__bench.ready();\n    });\n    const plot = await box(page, '#chart .axylo-proxy');\n    const at = project(plot, [0, 99_999], [0, 100]);\n    // Series B sits on A: its stroke is the cumulative sum, 70 + (61,234 mod 2 = 0) + 10 = 80 at the spike.\n    const top = spikeColumn(await strokeRuns(page, 2), at(61_234, 80), 2);\n    expect(top.reached, 'cumulative spike drawn').toBe(true);\n    expect(top.outside).toEqual([]);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-dense-bar: more bars than pixels raises the AX132 hint and every bar is still drawn, each where its category is', async () => {\n    const page = await devPage({ css: '#chart { width: 300px; }' });\n    const built = await createRaw(page, 'bar', { title: 'Many', data: Array.from({ length: 2000 }, (_, k) => ({ c: `c${k}`, v: k === 1234 ? 50 : 1 + (k % 5) })), x: 'c', y: 'v' });\n    expect(built.diagnostics.filter(d => d.code === 'AX132').map(d => d.level)).toEqual(['hint']);\n    const rects = ((await shapes(page, '#chart', 100000))[1] ?? []).map(s => s.box);\n    expect(rects).toHaveLength(2000);\n    // The tall one (50) is the 1,235th band from the left.\n    const sorted = [...rects].sort((a, b) => a.x - b.x || a.y - b.y);\n    const tallest = rects.reduce((a, b) => (b.height > a.height ? b : a));\n    expect(sorted.indexOf(tallest)).toBe(1234);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-dense-donut: no simplified drawing: eight slices, the smallest under 0.2 %, are each drawn at their angle in their colour', async () => {\n    const page = await devPage();\n    const values = [600, 200, 100, 50, 30, 15, 4, 1];\n    await createRaw(page, 'donut', { title: 'Eight', data: values.map((v, i) => ({ l: `S${i + 1}`, v })), label: 'l', value: 'v' });\n    const { img, box: plot, scale } = await screenshot(page, '#chart .axylo-plot');\n    const g = await ring(page);\n    const colors = await resolveColors(page, await page.locator('#chart ul.axylo-legend-list > li svg.axylo-swatch').evaluateAll(els => els.map(e => getComputedStyle(e).color)));\n    const wrong: string[] = [];\n    // The slices' own paths, by colour, with the angle their outer arc starts at (clockwise from 12 o'clock).\n    const starts = await page.evaluate(({ cx, cy }) => [...document.querySelectorAll<SVGPathElement>('#chart svg.axylo-svg .axylo-scene path')].filter(p => /M\\s*-?[\\d.]+[ ,]-?[\\d.]+/.test(p.getAttribute('d') ?? '')).map(p => {\n      const m = p.getScreenCTM()!; const [x, y] = /M\\s*(-?[\\d.]+)[ ,](-?[\\d.]+)/.exec(p.getAttribute('d')!)!.slice(1).map(Number);\n      const q = new DOMPoint(x!, y!).matrixTransform(m);\n      return { color: getComputedStyle(p).color, angle: (Math.atan2(q.x - cx, cy - q.y) + 2 * Math.PI) % (2 * Math.PI) };\n    }), g);\n    const css = await page.locator('#chart ul.axylo-legend-list > li svg.axylo-swatch').evaluateAll(els => els.map(e => getComputedStyle(e).color));\n    values.forEach((v, i) => {\n      const a = midAngle(values, i);\n      const arc = ((2 * Math.PI * v) / 1000) * g.outer;\n      // A slice wider than 4 px of arc is checked on the screen; a thinner one is hidden by its 1 px\n      // separators (spec A5), so its own path is checked to start where its share puts it.\n      if (arc > 4) {\n        const c = inkColorAt(img, (g.cx - plot.x + 0.85 * g.outer * Math.sin(a)) * scale, (g.cy - plot.y - 0.85 * g.outer * Math.cos(a)) * scale);\n        if (distance(c, colors[i]!) > 30) wrong.push(`S${i + 1}: ${c} vs ${colors[i]}`);\n      } else {\n        const start = (2 * Math.PI * values.slice(0, i).reduce((x, y) => x + y, 0)) / 1000;\n        if (!starts.some(p => p.color === css[i] && Math.abs(p.angle - start) < 0.02)) wrong.push(`S${i + 1}: no path of its colour starts at ${((start * 180) / Math.PI).toFixed(1)}°`);\n      }\n    });\n    expect(wrong).toEqual([]);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-dense-scatter: above 50,000 points the AX133 hint says drawing may be slow, and every point is drawn: points chosen across the data are found at their own positions', async () => {\n    const page = await devPage();\n    const built = await page.evaluate(async () => {\n      const n = 50_001;\n      const rows = Array.from({ length: n }, (_, i) => ({ x: i % 1000, y: Math.floor(i / 1000) }));\n      const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => { diagnostics: { code: string; level: string; message: string }[]; __bench: { ready(): Promise<void> } }>; charts: unknown[] };\n      const chart = w.Axylo.scatter!('#chart', { title: 'Many', data: rows, x: { field: 'x', domain: [0, 999] }, y: { field: 'y', domain: [0, 50] } });\n      w.charts.push(chart);\n      await chart.__bench.ready();\n      return chart.diagnostics.filter(d => d.code === 'AX133').map(d => `${d.level} ${d.message}`);\n    });\n    expect(built).toHaveLength(1);\n    expect(built[0]).toMatch(/^hint .*slow/i);\n    const plot = await box(page, '#chart .axylo-proxy');\n    const at = project(plot, [0, 999], [0, 50]);\n    const found = await page.evaluate(points => {\n      const svg = document.querySelector('#chart svg.axylo-svg') as SVGSVGElement;\n      const m = svg.getScreenCTM()!;\n### Tests that now fail (on the 08:15 build)\n\n**Pending, not a finding yet**\n- **A10 area, A10 bar:** `incompleteAt` and `incompleteCount` never reach a surface. The library does not use them yet; another agent is implementing them. `totalMixed` already reaches a surface.\n\n**A2, all five types: focus indicator covered or cut off**\n- **Spec:** \"The focus indicator is … not hidden by the tooltip\". Reading: no part of either indicator is covered.\n- **Observed:** on line, the tooltip covers the plot outline at the first datum. On line and area, the datum ring at the last point is drawn at x 739, outside the 736 px figure, so it is not painted. On bar, the tooltip covers the top line of the ring. On donut, the ring is clipped at 12 o'clock.\n- **Suspected cause:** `src/core/focus.ts` (the ring is placed outside the plot) and `src/dom/tooltip.ts` (the avoid-box does not include the ring).\n\n**A7 bar: value text rewritten on append**\n- **Expected (decision 0004):** the text is not rewritten while the datum is unchanged.\n- **Observed:** \"Q3 … Point 3 of 4\" becomes \"Point 1 of 4\" when the category window slides.\n- **Suspected cause:** `src/dom/interaction.ts`, the category `remapper` path in `commit`.\n\n**I1, all five types: tooltip not hoverable**\n- **Expected:** the tooltip can be reached by a slow, straight approach and stays put.\n- **Observed:** on line, area and bar it moves away (hit-test lands on the plot). On scatter and donut it closes on the way.\n- **Suspected cause:** `src/dom/tooltip.ts` and `pointAt` in `src/dom/interaction.ts`.\n\n**I1, all five types: tooltip or readout covers controls**\n- **Observed:** controls such as Pan left at the plot's left edge, legend and toolbar buttons are covered, in the default size and in a 300 × 260 tile. This breaks decision 0004 (\"never covers the controls\").\n- **Suspected cause:** `src/dom/tooltip.ts` placement and the readout's reserved space.\n\n**I1 bar: active bars covered at the top edge**\n- **Observed:** at the plot's top edge the tooltip goes below the pointer and covers the active bars.\n- **Suspected cause:** placement in `src/dom/tooltip.ts`.\n\n**I4, all five types: selectable tooltip rows too small**\n- **Spec:** \"Every control is at least 24×24 CSS px\".\n- **Observed:** the selectable tooltip rows are about 17 px tall.\n- **Suspected cause:** `src/theme/css.ts`, `.axylo-tooltip-choice`.\n\n**L1 line, area, scatter: late font**\n- **Observed:** after a late font, the y tick labels overlap the y-axis title, and on scatter \"1M\" is clipped.\n- **Suspected cause:** no relayout after the font loads (`src/core/controller.ts`, `src/layout/labels.ts`).\n\n**L4, all six types: one frame too late**\n- **Spec:** \"repaint within one frame\".\n- **Observed:** after a class change on `<html>` the marks keep their light colours in the first frame. They become dark later.\n- **Suspected cause:** `src/theme/watch.ts` (an asynchronous observer).\n\n**L8 scatter, L8 donut: summary wraps**\n- **Spec:** \"the one-line summary\".\n- **Observed:** \"Scatter chart with 2 series.\" and \"Donut chart with 4 slices.\" wrap to two lines. The core now wraps by design, so you may want to settle this reading.\n- **Suspected cause:** `src/theme/css.ts` and `src/dom/figure.ts`.\n\n**T-pointer-scatter: tie does not go to the later row**\n- **Spec:** \"ties go to the later row\".\n- **Observed:** with the row order reversed, the same point (\"second\") still wins.\n- **Suspected cause:** `consider`/`later` in `src/lookup/scatter-grid.ts`.\n\n**T-dense-donut: thinnest slice not drawn**\n- **Spec:** \"No\" simplified drawing for donuts.\n- **Observed:** the 0.1 % slice gets an empty path `d=\"\"`, so it is not drawn at all.\n- **Suspected cause:** `src/scene/index.ts` arcs, where the 1 px gap swallows the slice.\n\n### Still not established, and why\n- **Not verifiable here:** screen readers (A3), Firefox and Safari (A6, L1), a physical phone or touch screen reader (I4), GPU rasterisation.\n- **Canvas renderer:** nothing (the suite reads the SVG DOM).\n- **L1 browser text zoom:** emulated as twice the inherited font size; real browser text zoom is not available headless.\n- **Compact simplification** for dense data.\n- **F5 at several zoom levels.**\n- **Simulated colour vision:** scored on the sampled colours, not on a simulated screenshot.\n- **Real speech:** what a focused range's text change actually makes a screen reader say.\n\n### Last lines of the run (default SVG renderer)\n```\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/scene/{index,geometry}.ts packages/axylo/src/view/donut.ts packages/axylo/src/lookup/{donut,scatter,scatter-grid,point-order}.ts'","aggregated_output":"import type {\n  AreaMark, BandMark, DonutView, Layout, Mark, Paint, PathMark, PointMark, Projection, Rect, RuleMark, Scene, View,\n} from '../core/contracts';\nimport { addArea, addStackedAreas } from './areas';\nimport { barMarks } from './bars';\nimport { position, projectReference, rule, seriesPaint, token } from './geometry';\nimport { addLine, drawing, scatterPoints } from './lines';\n\ntype Plot = Extract<Layout, { kind: 'plot' }>;\ntype Cartesian = Exclude<Projection, { kind: 'ring' }>;\n\nconst TICK_LENGTH = 4;\nconst REFERENCE_DASH = [4, 3] as const;\n\nfunction axes(projection: Cartesian) {\n  return projection.kind === 'bands'\n    ? { x: projection.band, y: projection.value, horizontal: projection.horizontal }\n    : { x: projection.x, y: projection.y, horizontal: false };\n}\n\nfunction gridAndAxes(layout: Plot, projection: Cartesian): { grid: RuleMark[]; edges: RuleMark[] } {\n  const { x, y, horizontal } = axes(projection);\n  const { x: left, y: top, width, height } = layout.plot;\n  const right = left + width;\n  const bottom = top + height;\n  const axis = token('axis');\n  const gridPaint = token('grid');\n  const grid: RuleMark[] = [];\n  const edges = [rule('axis', axis, left, bottom, right, bottom), rule('axis', axis, left, top, left, bottom)];\n  const bottomScale = horizontal ? y : x;\n  const leftScale = horizontal ? x : y;\n  for (const tick of horizontal ? layout.yTicks : layout.xTicks) {\n    const pixel = position(bottomScale, tick.value);\n    if (pixel < left || pixel > right) continue;\n    edges.push(rule('tick', axis, pixel, bottom, pixel, bottom + TICK_LENGTH));\n  }\n  for (const tick of horizontal ? layout.xTicks : layout.yTicks) {\n    const pixel = position(leftScale, tick.value);\n    if (pixel < top || pixel > bottom) continue;\n    edges.push(rule('tick', axis, left - TICK_LENGTH, pixel, left, pixel));\n  }\n  for (const tick of layout.yTicks) {\n    const pixel = position(y, tick.value);\n    if (horizontal && pixel >= left && pixel <= right) grid.push(rule('grid', gridPaint, pixel, top, pixel, bottom));\n    if (!horizontal && pixel >= top && pixel <= bottom) grid.push(rule('grid', gridPaint, left, pixel, right, pixel));\n  }\n  return { grid, edges };\n}\n\nfunction references(view: Exclude<View, DonutView>, projection: Cartesian, plot: Rect): {\n  bands: BandMark[]; lines: RuleMark[];\n} {\n  const bands: BandMark[] = [];\n  const lines: RuleMark[] = [];\n  const paint = token('reference');\n  for (const reference of view.references) {\n    const projected = projectReference(reference, projection, plot, view.xDomain);\n    if (!projected) continue;\n    const { vertical, low, high } = projected;\n    if (low === high) {\n      const line = vertical ? rule('reference', paint, low, plot.y, low, plot.y + plot.height)\n        : rule('reference', paint, plot.x, low, plot.x + plot.width, low);\n      lines.push({ ...line, strokeWidth: 1.5, dash: REFERENCE_DASH });\n    } else {\n      const box = vertical ? { ...plot, x: low, width: high - low } : { ...plot, y: low, height: high - low };\n      bands.push({ type: 'band', box, fill: paint, opacity: 0.12 });\n    }\n  }\n  return { bands, lines };\n}\n\nfunction arcMarks(view: DonutView, projection: Extract<Projection, { kind: 'ring' }>): Mark[] {\n  const angles: number[] = [];\n  const fills: Paint[] = [];\n  for (const slice of view.slices) {\n    if (slice.angles === null) continue;\n    angles.push(...slice.angles);\n    fills.push(slice.colorIndex === null ? token('muted') : seriesPaint(slice.colorIndex));\n  }\n  if (!angles.length) return [];\n  const { cx, cy, r0, r1 } = projection;\n  return [{ type: 'arcs', cx, cy, r0, r1, angles: Float32Array.from(angles), fills, gap: 1 }];\n}\n\nexport function buildScene(view: View, layout: Layout, devicePixelRatio: number): Scene {\n  const { width, height } = layout;\n  if (layout.kind !== 'plot' && layout.kind !== 'compact') {\n    return { width, height, clip: { x: 0, y: 0, width, height }, marks: [] };\n  }\n  const { plot: clip, projection } = layout;\n  if (projection.kind === 'ring' || view.kind === 'donut') {\n    const marks = projection.kind === 'ring' && view.kind === 'donut' ? arcMarks(view, projection) : [];\n    return { width, height, clip, marks };\n  }\n\n  const compact = layout.kind === 'compact' || view.compact;\n  const { grid, edges } = layout.kind === 'plot' && !compact ? gridAndAxes(layout, projection) : { grid: [], edges: [] };\n  const { bands, lines } = compact ? { bands: [], lines: [] } : references(view, projection, clip);\n  const layers: (readonly Mark[])[] = [bands, grid];\n  if (view.kind === 'bar' && projection.kind === 'bands') {\n    layers.push(barMarks(view, projection, clip));\n  } else if (view.kind === 'scatter' && projection.kind === 'xy') {\n    layers.push(scatterPoints(view, projection));\n  } else if ((view.kind === 'line' || view.kind === 'area') && projection.kind === 'xy') {\n    const areas: AreaMark[] = [];\n    const seams: PathMark[] = [];\n    const paths: PathMark[] = [];\n    const points: PointMark[] = [];\n    const dpr = Number.isFinite(devicePixelRatio) && devicePixelRatio > 0 ? devicePixelRatio : 1;\n    const draw = drawing(view.frame.x.values, projection, clip, dpr);\n    if (view.kind === 'area' && view.stack) {\n      addStackedAreas(draw, view, view.stack, compact, areas, seams, paths, points);\n    } else {\n      for (let i = 0; i < view.frame.series.length; i++) {\n        if (!view.visible[i]) continue;\n        const { slot, y } = view.frame.series[i]!;\n        const input = { ...draw, range: view.drawSlots[i]!, slot, y };\n        if (view.kind === 'area') addArea(input, view, i, compact, areas, paths, points);\n        else addLine(input, view, i, view.visibleSlots, compact, paths, points);\n      }\n    }\n    layers.push(areas, seams, paths, points);\n  }\n  layers.push(edges, lines);\n  return { width, height, clip, marks: layers.flat() };\n}\nimport type { Paint, PaintToken, Projection, Rect, ResolvedReference, RuleMark, XScale } from '../core/contracts';\n\nexport const COORDINATE_LIMIT = 2 ** 120;\n\nexport const token = (name: PaintToken): Paint => ({ kind: 'token', name });\nexport const seriesPaint = (index: number): Paint => ({ kind: 'series', index });\n\nexport function position(scale: XScale, value: number): number {\n  if (scale.type === 'band') return scale.center(value);\n  const pixel = scale.map(value);\n  // Far outside an author domain, extrapolation can overflow the packed Float32 geometry.\n  if (Number.isNaN(pixel)) {\n    const [start, end] = scale.range;\n    if (start === end) return start;\n    return (value < scale.domain[0]) === (start < end) ? -COORDINATE_LIMIT : COORDINATE_LIMIT;\n  }\n  return clamp(pixel, -COORDINATE_LIMIT, COORDINATE_LIMIT);\n}\n\nexport function clamp(value: number, from: number, to: number): number {\n  return Math.max(from, Math.min(to, value));\n}\n\n/** Use the same visible edges for reference marks and their labels. */\nexport function projectReference(\n  reference: ResolvedReference, projection: Exclude<Projection, { kind: 'ring' }>, plot: Rect,\n  xDomain?: readonly [number, number],\n) {\n  const { axis, from, to } = reference;\n  const xAxis = axis === 'x';\n  const vertical = xAxis !== (projection.kind === 'bands' && projection.horizontal);\n  const scale = projection.kind === 'xy' ? projection[axis] : xAxis ? projection.band : projection.value;\n  const start = vertical ? plot.x : plot.y;\n  const end = start + (vertical ? plot.width : plot.height);\n  const domain: readonly [number, number] | undefined = xAxis\n    ? xDomain ?? (scale.type === 'band' ? [0, scale.count - 1] : scale.domain)\n    : undefined;\n  if (domain && (to < domain[0] || from > domain[1])) return null;\n  const a = position(scale, domain ? Math.max(from, domain[0]) : from);\n  if (from === to) return a >= start && a <= end ? { vertical, low: a, high: a } : null;\n\n  const b = position(scale, domain ? Math.min(to, domain[1]) : to);\n  const low = clamp(Math.min(a, b), start, end);\n  const high = clamp(Math.max(a, b), start, end);\n  return low < high ? { vertical, low, high } : null;\n}\n\nexport function rule(\n  role: RuleMark['role'], paint: Paint, x1: number, y1: number, x2: number, y2: number,\n): RuleMark {\n  return { type: 'rule', role, x1, y1, x2, y2, stroke: paint, strokeWidth: 1, dash: null };\n}\nimport { SLOT_VALUE, type DiagnosticSink, type DonutFrame, type DonutSlice, type DonutView } from '../core/contracts';\nimport { report } from '../diagnostics';\n\nconst TURN = 2 * Math.PI;\nconst OTHER = '__other__';\n\nexport function buildDonut(\n  frame: DonutFrame, otherLabel: (count: number) => string, previous: DonutView | undefined, sink: DiagnosticSink,\n): DonutView {\n  const result = { kind: 'donut' as const, frame, revision: frame.revision };\n  // Normalization has already reported chart errors. No partial ring should be drawn for either.\n  if (new Set(frame.labels).size !== frame.labels.length) return { ...result, slices: [], total: 0 };\n\n  let total = 0;\n  let max = 0;\n  let positive = 0;\n  const largest: number[] = [];\n  for (let i = 0; i < frame.labels.length; i++) {\n    if (frame.slot[i] !== SLOT_VALUE) continue;\n    const value = frame.values[i]!;\n    if (value < 0) return { ...result, slices: [], total: 0 };\n    if (value === 0) continue;\n    positive++;\n    total += value;\n    max = Math.max(max, value);\n    // Only the first seven ranks can affect grouping, even for a very large input.\n    const rank = largest.findIndex(index => frame.values[index]! < value);\n    if (rank >= 0) largest.splice(rank, 0, i);\n    else if (largest.length < 7) largest.push(i);\n    if (largest.length > 7) largest.pop();\n  }\n\n  const grouped = positive > 8;\n  const label = grouped ? otherLabel(positive - 7) : '';\n  if (grouped) report(sink, 'AX121', 'changed', { field: frame.valueLabel, count: positive - 7 });\n  const scaled = !Number.isFinite(total);\n  let denominator = total;\n  if (scaled) {\n    report(sink, 'AX103', 'changed', { field: frame.valueLabel });\n    denominator = 0;\n    for (let i = 0; i < frame.values.length; i++) {\n      if (frame.slot[i] === SLOT_VALUE) denominator += frame.values[i]! / max;\n    }\n  }\n  if (previous?.frame === frame && (!grouped || previous.slices.at(-1)?.label === label)) return previous;\n\n  const slices: DonutSlice[] = [];\n  let angle = 0;\n  let drawn = 0;\n  const drawnCount = grouped ? 8 : positive;\n  let arcless = grouped ? 7 : positive;\n  function add(key: string, label: string, members: readonly number[], value: number | null, weight: number): void {\n    const ratio = value === null ? null : weight === 0 ? 0 : weight / denominator;\n    let angles: DonutSlice['angles'] = null;\n    if (value !== null && value > 0) {\n      const end = ++drawn === drawnCount ? TURN : Math.min(TURN, angle + ratio! * TURN);\n      angles = [angle, end];\n      angle = end;\n    }\n    // Reserve the first palette slots for arcs so arcless entries cannot force the ring to wrap.\n    const colorIndex = key === OTHER ? null : angles ? drawn - 1 : arcless++;\n    slices.push({ key, label, members, value, ratio, angles, colorIndex });\n  }\n\n  const kept = grouped ? new Set(largest) : null;\n  const others: number[] = [];\n  let otherValue = 0;\n  let otherWeight = 0;\n  for (let i = 0; i < frame.labels.length; i++) {\n    const name = frame.labels[i]!;\n    const value = frame.slot[i] === SLOT_VALUE ? frame.values[i]! : null;\n    const weight = scaled ? (value ?? 0) / max : value ?? 0;\n    if (kept && value !== null && value > 0 && !kept.has(i)) {\n      others.push(i);\n      otherValue += value;\n      otherWeight += weight;\n    } else {\n      const key = name.startsWith(OTHER) ? OTHER + name : name;\n      add(key, name, [i], value, weight);\n    }\n  }\n  if (grouped) add(OTHER, label, others, otherValue, otherWeight);\n  return { ...result, slices, total };\n}\nimport type { DatumRef, DonutView, Formatters, Lookup, Rect } from '../core/contracts';\nimport { contains, type PlotLayout } from './geometry';\nimport { pageDistance } from './search';\nimport { sliceText } from './text';\n\nconst TURN = 2 * Math.PI;\n\nfunction sectorBox(cx: number, cy: number, inner: number, outer: number, start: number, end: number): Rect {\n  let left = Infinity;\n  let right = -Infinity;\n  let top = Infinity;\n  let bottom = -Infinity;\n  function include(angle: number, radius: number) {\n    const x = cx + Math.sin(angle) * radius;\n    const y = cy - Math.cos(angle) * radius;\n    left = Math.min(left, x);\n    right = Math.max(right, x);\n    top = Math.min(top, y);\n    bottom = Math.max(bottom, y);\n  }\n  for (const radius of [inner, outer]) {\n    include(start, radius);\n    include(end, radius);\n    const quarter = Math.PI / 2;\n    for (let angle = Math.ceil(start / quarter) * quarter; angle < end; angle += quarter) include(angle, radius);\n  }\n  return { x: left, y: top, width: right - left, height: bottom - top };\n}\n\nexport function donutLookup(view: DonutView, layout: PlotLayout | null, formatters: Formatters, locale?: string): Lookup {\n  const { slices } = view;\n  const keys = new Map(slices.map((slice, i) => [slice.key, i]));\n  const ring = layout?.projection.kind === 'ring' ? layout.projection : null;\n  const index = (datum: DatumRef) => datum.kind === 'slice' ? keys.get(datum.sliceKey) ?? -1 : -1;\n\n  function ref(i: number): DatumRef | null {\n    const slice = slices[i];\n    return slice ? { kind: 'slice', sliceKey: slice.key } : null;\n  }\n\n  function resolve(datum: DatumRef): DatumRef | null {\n    if (datum.kind !== 'slice') return