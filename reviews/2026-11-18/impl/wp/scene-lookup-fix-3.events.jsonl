x; gap: 0.375em; min-width: 24px; }\n202:  .axylo .axylo-plot { user-select: none; -webkit-user-select: none; touch-action: manipulation; }\n203:  .axylo .axylo-plot.axylo-touch-zoom { touch-action: pan-x pan-y; }\n204:  .axylo .axylo-plot.axylo-zoomable { cursor: crosshair; }\n218:  .axylo .axylo-legend-list > li.axylo-legend-current { outline: 2px solid var(--axylo-focus, var(--axylo-default-focus)); outline-offset: 1px; }\n226:  .axylo .axylo-controls { flex: none; display: flex; flex-direction: column; gap: 0.5em; margin: 0.5em 0 0; min-width: 0; }\n228:  .axylo .axylo-controls-top, .axylo .axylo-controls-side { flex: none; display: flex; flex-direction: column; gap: 0.5em; min-width: 0; }\n229:  .axylo .axylo-controls-top { margin: 0 0 0.5em; }\n230:  .axylo .axylo-controls-side { margin: 0 0 0 0.75em; max-width: 40%; overflow: auto; }\n231:  .axylo .axylo-controls-side .axylo-toolbar { flex-direction: column; align-items: stretch; flex-wrap: nowrap; }\n232:  .axylo .axylo-controls-side .axylo-legend-list { flex-direction: column; flex-wrap: nowrap; }\n233:  .axylo .axylo-controls-side .axylo-legend-entry + .axylo-control:not(.axylo-legend-entry) { margin-inline-start: 0; margin-block-start: 0.5em; }\n234:  .axylo .axylo-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; min-width: 0; }\n239:    font: inherit; font-size: max(12px, 0.875em); line-height: 1.25; text-align: start; cursor: pointer;\n242:  .axylo .axylo-legend-entry + .axylo-control:not(.axylo-legend-entry) { margin-inline-start: auto; }\n246:  .axylo .axylo-legend-entry { border-color: transparent; padding-inline: 4px; }\n247:  .axylo .axylo-legend-entry:hover { border-color: var(--axylo-axis, var(--axylo-default-axis)); }\n248:  .axylo .axylo-legend-entry.axylo-struck .axylo-control-label { text-decoration: line-through; text-decoration-thickness: 1px; }\n249:  .axylo .axylo-legend-list {\n252:  .axylo .axylo-legend-list > li { display: inline-flex; align-items: center; gap: 0.375em; min-width: 0; }\n253:  .axylo .axylo-legend-value { font-variant-numeric: tabular-nums; }\n273:    box-sizing: border-box; min-height: 24px; width: 12em; padding: 2px 4px; font: inherit;\n  expect(model.count).toBe(3);\n  expect(model.step(point('A', 0, 10), 'next')).toEqual(point('B', 2, 10));\n  expect(model.step(point('A', 0, 10), 'series-next')).toEqual(point('B', 3, 12));\n  expect(model.step(point('B', 3, 12), 'series-previous')).toEqual(point('A', 0, 10));\n});\n\nit('examines only nearby cells on a 200,000-point pick', () => {\n  const size = 200_000;\n  const x = Float64Array.from({ length: size }, (_, i) => i);\n  const y = Float64Array.from(x, i => i % 521);\n  const data = frame('scatter', { data: { columns: { x, y } }, x: 'x', y: 'y' });\n  const projection = { kind: 'xy', x: linearScale([0, size - 1], [0, 1200]), y: linearScale([0, 520], [520, 0]) } as const;\n  const model = scatterLookup(scatter(data), plot(projection, 1200, 520), formatter(data));\n  const i = 98_765;\n  expect(model.primary(model.pick(projection.x.map(i), 520 - (i % 521))!)).toEqual(point('y', i, i));\n  expect(model.lastPickCandidates).toBeGreaterThan(0);\n  expect(model.lastPickCandidates).toBeLessThan(5_000);\n});\n\nit('resolves hidden and zoomed-out scatter refs and steps from the replacement', () => {\n  const data = points([[[0, 5], [2, 3], [4, 8], [6, 1]], [[2, 99]], [[2, 4], [4, 1]]]);\n  const view = scatter(data, {\n    visible: [true, false, true], xDomain: [2, 4],\n    visiblePoints: [{ start: 1, end: 3 }, { start: 0, end: 1 }, { start: 0, end: 2 }],\n  });\n  const model = buildLookup(view, layout, formatter(data), defaultMessages);\n  expect(model.resolve(point('S1', 4, 2))).toEqual(point('S0', 1, 2));\n  expect(model.step(point('S1', 4, 2), 'next')).toEqual(point('S2', 5, 2));\n  expect(model.resolve(point('S0', 0, 0))).toEqual(point('S0', 1, 2));\n  expect(model.resolve(point('S0', 3, 6))).toEqual(point('S0', 2, 4));\n  expect(model.resolve(point('S0', 99, 2))).toEqual(point('S0', 2, 4));\n  expect(model.step(point('S0', 0, 0), 'next')).toEqual(point('S2', 5, 2));\n  expect(model.step(point('S0', 3, 6), 'previous')).toEqual(point('S2', 6, 4));\n  expect(model.step(point('S0', 2, 4), 'page-next')).toBeNull();\n  expect(model.step(point('S0', 1, 2), 'page-previous')).toBeNull();\n});\n\nit('bounds a pick in a cell of 200,000 coincident points and reports the full count', () => {\n  const size = 200_000;\n  const base = points([[]]);\n  const data = { ...base, series: [{\n    ...base.series[0]!, x: new Float64Array(size).fill(23.9), y: new Float64Array(size).fill(50), row: null,\n  }] };\n  const model = scatterLookup(scatter(data), layout, formatter(data));\n  const target = model.pick(24.1, 50);\n  expect(target).toMatchObject({ kind: 'point', count: size });\n  expect(model.primary(target!)).toEqual(point('S0', size - 1, 23.9));\n  expect(model.tooltip(target!).rows).toHaveLength(8);\n  expect(model.lastPickCandidates).toBeLessThan(3_000);\n});\n\nit('bounds the points visited for 10,000 identical marks mixed with 190,000 other points in one cell', () => {\n  const size = 200_000;\n  const copies = 10_000;\n  const base = points([[]]);\n  const data = { ...base, series: [{\n    ...base.series[0]!,\n    x: new Float64Array(size).fill(50, 0, copies),\n    y: new Float64Array(size).fill(50, 0, copies + 1),\n    row: null,\n  }] };\n  const { x: xs, y: ys } = data.series[0]!;\n  // The boundary point is exactly 0.5 px away and the rest fill the same cell beyond its own radius.\n  xs[copies] = 50.5;\n  for (let i = copies + 1; i < size; i++) {\n    const j = i - copies - 1;\n    xs[i] = 51.01 + Math.floor(j / 400) / 1000;\n    ys[i] = 50.01 + (j % 400) / 1000;\n  }\n  const axis = linearScale([0, 128], [0, 128]);\n  const model = scatterLookup(scatter(data), plot({ kind: 'xy', x: axis, y: axis }, 128, 128), formatter(data));\n  for (const [x, row] of [[50, copies - 1], [50.5, copies]] as const) {\n    const target = model.pick(x, 50);\n    expect(target).toMatchObject({ kind: 'point', count: copies + 1 });\n    expect(model.primary(target!)).toEqual(point('S0', row, x));\n    expect(model.tooltip(target!).rows).toHaveLength(8);\n    expect(model.lastPickCandidates).toBeLessThanOrEqual(12);\n  }\n});\n\nit('visits the binary-search window when switching series and locates recreated refs by x', () => {\n  const n = 80_000;\n  const data = points([Array.from({ length: n }, (_, x) => [n - x, 20] as const),\n    Array.from({ length: n }, (_, x) => [x, 20] as const)]);\n  const work = { locations: 0, seriesCandidates: 0, orderComparisons: 0 };\n/**\n * SVG mark renderer (plan 2.3). Paints with `bindings`, CSS expressions such as\n * `var(--axylo-series-color-1)`, through style properties, so the browser restyles the marks on a theme\n * change with no call. Dash patterns switch under `prefers-contrast: more` and forced colors through the\n * stylesheet (theme/css.ts).\n *\n * Every paint goes through the `color` property and is used as `currentColor` for fill or stroke. So a\n * series color is always a color, never an SVG paint server (`url(#…)`), exactly as for the canvas\n * renderer. The renderer opts out of forced-color adjustment (`forced-color-adjust: none`): in forced\n * colors the stylesheet maps every paint to a system color itself.\n *\n * One element per mark (a group for bars and slices), reused between draws when the mark at the same\n * position has the same kind; attributes are only written when their value changed, and a mark's path data\n * is not even rebuilt when its coordinate arrays are the same objects as last time. Scene arrays must\n * therefore never be mutated in place: a changed geometry is a new array.\n */\nimport type { AreaMark, ArcMark, Mark, MarkRenderer, Overlay, PaintBindings, PathMark, PointMark, Rect, RectMark, ResolvedTheme, RuleMark, Scene } from '../core/contracts';\nimport {\n  DOT_RADIUS, DOT_TILE, dashText, lifted, MARKER_POLYGONS, PATTERN_