{"type":"item.completed","item":{"id":"item_83","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/scale/band.ts | head -95; nl -ba packages/axylo/src/layout/index.ts | sed -n '80,98p;216,231p'\"","aggregated_output":"import type { BandScale, Tick, TickCandidates } from '../core/contracts';\n\n/**\n * Bands of equal width. `padding` is the fraction of a step left empty, the same between bands and at both\n * ends, so the outer gaps match the inner ones. The range may run backwards (a vertical category axis\n * drawn top to bottom from a bottom origin); `map` always returns the lower pixel edge of the band, so a\n * rectangle at map(i) with width `bandwidth` covers it either way.\n */\nexport function bandScale(count: number, range: readonly [number, number], padding: number): BandScale {\n  const n = Number.isFinite(count) ? Math.max(0, Math.floor(count)) : 0;\n  const p = Number.isFinite(padding) ? Math.min(Math.max(padding, 0), 0.95) : 0;\n  const r0 = range[0];\n  const r1 = range[1];\n  const extent = Math.abs(r1 - r0);\n  const forward = r1 >= r0;\n  const step = n === 0 ? 0 : extent / (n + p);\n  const bandwidth = step * (1 - p);\n  const outer = step * p;\n\n  // Offset of band i's leading edge from range[0], measured along the range direction.\n  const lead = (i: number): number => outer + i * step;\n  const map = (i: number): number => (forward ? r0 + lead(i) : r0 - lead(i) - bandwidth);\n\n  return {\n    type: 'band',\n    count: n,\n    range: [r0, r1],\n    step,\n    bandwidth,\n    map,\n    center: (i: number) => map(i) + bandwidth / 2,\n    invert(pixel: number): number {\n      if (n === 0) return -1;\n      if (step === 0 || !Number.isFinite(pixel)) return 0;\n      const along = forward ? pixel - r0 : r0 - pixel;\n      // Nearest band centre, so a pixel in the padding belongs to the closer band.\n      const i = Math.round((along - outer - bandwidth / 2) / step);\n      return Math.min(Math.max(i, 0), n - 1);\n    },\n  };\n}\n\n/**\n * Sets of category labels, densest first: every category, then every k-th, always keeping the first.\n *\n * Strides are 1 to 10, then 20, 50, 100, 200, 500, … (1, 2, 5 × 10^k), so there are about 3·log10(n) + 10\n * sets for n categories. Sets are built on first read and kept, so laying out 100,000 categories costs\n * only the sets layout actually looks at. The result is still a plain readonly array of arrays.\n */\nexport function bandTickCandidates(labels: readonly string[]): TickCandidates {\n  const n = labels.length;\n  if (n === 0) return [];\n  const strides: number[] = [];\n  let lastSize = Infinity;\n  for (const k of strideSequence(n)) {\n    const size = Math.ceil(n / k);\n    if (size < lastSize) {\n      strides.push(k);\n      lastSize = size;\n    }\n    if (size === 1) break;\n  }\n  const sets: Tick[][] = [];\n  strides.forEach((k, index) => {\n    let built: Tick[] | null = null;\n    Object.defineProperty(sets, index, {\n      enumerable: true,\n      get(): Tick[] {\n        if (built === null) {\n          const set: Tick[] = [];\n          for (let i = 0; i < n; i += k) set.push({ value: i, label: labels[i] as string });\n          built = set;\n        }\n        return built;\n      },\n    });\n  });\n  return sets;\n}\n\n/** 1, 2, …, 10, 20, 50, 100, 200, 500, … up to the first stride at or above n. */\nfunction strideSequence(n: number): number[] {\n  const out: number[] = [];\n  for (let k = 1; k <= 10; k++) out.push(k);\n  for (let base = 10; out[out.length - 1]! < n; base *= 10) out.push(2 * base, 5 * base, 10 * base);\n  return out;\n}\n    80\tfunction independentScale(axis: Axes['x'], range: Span, scales: ScaleConstructors): XScale {\n    81\t  return axis.type === 'band' ? scales.band(axis.count, range, axis.padding) : scales[axis.type](axis.domain, range);\n    82\t}\n    83\t\n    84\tfunction project(plot: Rect, axes: Cartesian): Exclude<Projection, { kind: 'ring' }> {\n    85\t  const across: Span = [plot.x, plot.x + plot.width];\n    86\t  const up: Span = [plot.y + plot.height, plot.y];\n    87\t  const horizontal = axes.kind === 'bands' && axes.horizontal;\n    88\t  const down: Span = [plot.y, plot.y + plot.height];\n    89\t  const x = independentScale(axes.x, horizontal ? (axes.x.type === 'band' ? down : up) : across, axes.scales);\n    90\t  const y = axes.scales.linear(axes.y.domain, horizontal ? across : up);\n    91\t  return axes.kind === 'xy' ? { kind: 'xy', x, y } : { kind: 'bands', horizontal, band: x, value: y };\n    92\t}\n    93\t\n    94\tfunction ring(plot: Rect): Projection {\n    95\t  const r1 = Math.min(plot.width, plot.height) / 2;\n    96\t  return { kind: 'ring', cx: plot.x + plot.width / 2, cy: plot.y + plot.height / 2, r0: r1 * 0.6, r1 };\n    97\t}\n    98\t\n   216\t    const lines = messageLines(input.message, width - 2 * INSET, maxLines, text);\n   217\t    return { ...size, kind: 'message', text: placeText(lines, input.message, width / 2, height / 2, 'middle', 'middle', 0, 'message', text) };\n   218\t  }\n   219\t  if (input.compact) {\n   220\t    const x = Math.min(2, width / 2);\n   221\t    const y = Math.min(2, height / 2);\n   222\t    const plot = { x, y, width: width - 2 * x, height: height - 2 * y };\n   223\t    return { ...size, kind: 'compact', plot, projection: input.kind === 'ring' ? ring(plot) : project(plot, input) };\n   224\t  }\n   225\t  if (input.kind === 'ring') {\n   226\t    if (width < MIN_WIDTH || height < MIN_HEIGHT) return tooSmall(size);\n   227\t    const plot = { x: 0, y: 0, width, height };\n   228\t    return { ...size, kind: 'plot', plot, projection: ring(plot), xTicks: [], yTicks: [], texts: [], fit: { x: UNCHANGED, y: UNCHANGED } };\n   229\t  }\n   230\t  if (width < MIN_WIDTH + 2 * INSET || height < MIN_HEIGHT + 2 * INSET) return tooSmall(size);\n   231\t  const text = metrics(input);\n","exit_code":0,"status":"completed"}}
