{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/pointer.ts'","aggregated_output":"     1\t/**\n     2\t * Comparing pick targets. Pointer, touch and drag input are handled by the interaction layer\n     3\t * (dom/interaction.ts); this only says whether two targets name the same thing.\n     4\t */\n     5\timport type { PickTarget } from '../core/contracts';\n     6\t\n     7\t/** Two pick results name the same thing, so the tooltip need not be rebuilt. */\n     8\texport function sameTarget(a: PickTarget | null, b: PickTarget | null): boolean {\n     9\t  if (a === null || b === null) return a === b;\n    10\t  if (a.kind === 'x' && b.kind === 'x') return a.x === b.x;\n    11\t  if (a.kind === 'slice' && b.kind === 'slice') return a.sliceKey === b.sliceKey;\n    12\t  if (a.kind === 'point' && b.kind === 'point') {\n    13\t    return a.count === b.count && a.refs.length === b.refs.length && a.refs.every((r, i) => {\n    14\t      const o = b.refs[i]!;\n    15\t      return r.kind === 'point' && o.kind === 'point' && r.seriesKey === o.seriesKey && r.row === o.row && r.x === o.x;\n    16\t    });\n    17\t  }\n    18\t  return false;\n    19\t}\n","exit_code":0,"status":"completed"}}
