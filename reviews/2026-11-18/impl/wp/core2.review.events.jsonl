{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/tooltip.ts'","aggregated_output":"     1\t/**\n     2\t * Renders a tooltip model as text (spec I1, DX8: textContent only) in one of two places: floating beside the\n     3\t * active mark, or, when it cannot fit beside it (a narrow tile), in a fixed readout under the plot. It does\n     4\t * not decide what is active; the interaction layer does, for pointer, touch and keyboard alike.\n     5\t *\n     6\t * Both elements are aria-hidden: the keyboard proxy carries the same text as its value text, so a screen\n     7\t * reader is not told twice and nothing here behaves as a live region (spec A7).\n     8\t */\n     9\timport type { DatumText, Rect, TooltipModel } from '../core/contracts';\n    10\timport { createSwatch, type SwatchSpec } from './swatch';\n    11\t\n    12\texport interface TooltipContent {\n    13\t  readonly model: TooltipModel;\n    14\t  readonly swatch: (row: DatumText) => SwatchSpec | null;\n    15\t  readonly moreRows: (count: number) => string;\n    16\t}\n    17\t\n    18\texport interface TooltipView {\n    19\t  /**\n    20\t   * Floating: shows `content` beside `anchor` (viewport coordinates) without covering it, inside the\n    21\t   * viewport, flipping sides as needed; `focusY` is where along the anchor it should sit (the pointer).\n    22\t   * Returns false, showing nothing, when it cannot fit beside the anchor within the figure's width.\n    23\t   */\n    24\t  show(content: TooltipContent, anchor: Rect, focusY: number | null): boolean;\n    25\t  /** Fixed: the same content in the readout under the plot. */\n    26\t  readout(content: TooltipContent): void;\n    27\t  hide(): void;\n    28\t  readonly visible: boolean;\n    29\t}\n    30\t\n    31\tconst OFFSET = 12;\n    32\tconst MARGIN = 4;\n    33\t\n    34\tfunction fill(element: HTMLElement, { model, swatch, moreRows }: TooltipContent): void {\n    35\t  const doc = element.ownerDocument;\n    36\t  const heading = doc.createElement('div');\n    37\t  heading.className = 'axylo-tooltip-title';\n    38\t  heading.textContent = model.title;\n    39\t  const rows: HTMLElement[] = [heading];\n    40\t  for (const row of model.rows) {\n    41\t    const line = doc.createElement('div');\n    42\t    line.className = 'axylo-tooltip-row';\n    43\t    const name = doc.createElement('span');\n    44\t    name.className = 'axylo-tooltip-series';\n    45\t    const spec = swatch(row);\n    46\t    if (spec) name.appendChild(createSwatch(doc, spec));\n    47\t    name.appendChild(doc.createTextNode(row.seriesLabel));\n    48\t    const value = doc.createElement('span');\n    49\t    value.className = 'axylo-tooltip-value';\n    50\t    value.textContent = row.percent === null || row.percent === row.value ? row.value : `${row.value} (${row.percent})`;\n    51\t    line.append(name, value);\n    52\t    rows.push(line);\n    53\t  }\n    54\t  if (model.count > model.rows.length) {\n    55\t    const more = doc.createElement('div');\n    56\t    more.className = 'axylo-tooltip-more';\n    57\t    more.textContent = moreRows(model.count - model.rows.length);\n    58\t    rows.push(more);\n    59\t  }\n    60\t  if (model.total !== null) {\n    61\t    const total = doc.createElement('div');\n    62\t    total.className = 'axylo-tooltip-total';\n    63\t    total.textContent = model.total;\n    64\t    rows.push(total);\n    65\t  }\n    66\t  element.replaceChildren(...rows);\n    67\t}\n    68\t\n    69\texport function createTooltip(element: HTMLElement, readoutElement: HTMLElement, figure: HTMLElement, plot: HTMLElement): TooltipView {\n    70\t  const doc = element.ownerDocument;\n    71\t  let visible = false;\n    72\t\n    73\t  function hideFloating(): void {\n    74\t    if (element.hidden) return;\n    75\t    element.hidden = true;\n    76\t    element.replaceChildren();\n    77\t  }\n    78\t\n    79\t  function hideReadout(): void {\n    80\t    if (readoutElement.hidden) return;\n    81\t    readoutElement.hidden = true;\n    82\t    readoutElement.replaceChildren();\n    83\t  }\n    84\t\n    85\t  return {\n    86\t    get visible() {\n    87\t      return visible;\n    88\t    },\n    89\t    show(content, anchor, focusY) {\n    90\t      fill(element, content);\n    91\t      element.hidden = false;\n    92\t      element.style.transform = 'translate(0px, 0px)';\n    93\t      const width = element.offsetWidth;\n    94\t      const height = element.offsetHeight;\n    95\t      const outer = figure.getBoundingClientRect();\n    96\t      // Beside the mark means within the figure's own width. A tile too narrow for that at every position\n    97\t      // uses the readout throughout, so the tooltip does not jump between two places as the pointer moves.\n    98\t      const roomRight = outer.right - (anchor.x + anchor.width + OFFSET);\n    99\t      const roomLeft = anchor.x - OFFSET - outer.left;\n   100\t      if (outer.width < 2 * (width + OFFSET) || (roomRight < width && roomLeft < width)) {\n   101\t        hideFloating();\n   102\t        visible = false;\n   103\t        return false;\n   104\t      }\n   105\t      hideReadout();\n   106\t      const view = doc.documentElement;\n   107\t      const vw = view.clientWidth;\n   108\t      const vh = view.clientHeight;\n   109\t      const clampY = (y: number) => Math.max(MARGIN, Math.min(y, vh - MARGIN - height));\n   110\t      const clampX = (x: number) => Math.max(MARGIN, Math.min(x, vw - MARGIN - width));\n   111\t      const cy = focusY ?? anchor.y + anchor.height / 2;\n   112\t      const cx = anchor.x + anchor.width / 2;\n   113\t      const candidates: [number, number][] = [\n   114\t        [anchor.x + anchor.width + OFFSET, clampY(cy - height / 2)],\n   115\t        [anchor.x - OFFSET - width, clampY(cy - height / 2)],\n   116\t        [clampX(cx - width / 2), anchor.y + anchor.height + OFFSET],\n   117\t        [clampX(cx - width / 2), anchor.y - OFFSET - height],\n   118\t      ];\n   119\t      const fits = ([x, y]: [number, number]) => x >= MARGIN && x + width <= vw - MARGIN && y >= MARGIN && y + height <= vh - MARGIN;\n   120\t      const [x, y] = candidates.find(fits) ?? [clampX(candidates[0]![0]), clampY(candidates[0]![1])];\n   121\t      element.style.transform = `translate(${Math.round(x - outer.left)}px, ${Math.round(y - outer.top)}px)`;\n   122\t      visible = true;\n   123\t      return true;\n   124\t    },\n   125\t    readout(content) {\n   126\t      hideFloating();\n   127\t      fill(readoutElement, content);\n   128\t      readoutElement.style.top = `${plot.offsetTop + plot.offsetHeight}px`;\n   129\t      readoutElement.hidden = false;\n   130\t      visible = true;\n   131\t    },\n   132\t    hide() {\n   133\t      hideFloating();\n   134\t      hideReadout();\n   135\t      visible = false;\n   136\t    },\n   137\t  };\n   138\t}\n","exit_code":0,"status":"completed"}}
