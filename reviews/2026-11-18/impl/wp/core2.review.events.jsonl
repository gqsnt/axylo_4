e = page.locator('#chart .axylo-toolbar button', { hasText: 'View as table' });\n   515\t    expect(await toggle.getAttribute('aria-expanded')).toBe('false');\n   516\t    await toggle.click();\n   517\t    const table = page.locator('#chart table');\n   518\t    expect(await table.locator('caption').textContent()).toBe('Counter');\n   519\t    expect(await table.locator('thead th').allTextContents()).toEqual(['i', 'Twice (pt)']);\n   520\t    expect(await table.locator('tbody th[scope=\"row\"]').count()).toBe(100);\n   521\t    expect(await table.locator('tbody tr').first().textContent()).toBe('00 pt');\n   522\t    const hideToggle = page.locator('#chart .axylo-toolbar button', { hasText: 'Hide table' });\n   523\t    expect(await hideToggle.getAttribute('aria-expanded')).toBe('true');\n   524\t    expect(await hideToggle.getAttribute('aria-controls')).toBe(await page.locator('#chart .axylo-table').getAttribute('id'));\n   525\t    const scroll = page.locator('#chart .axylo-table-scroll');\n   526\t    expect(await scroll.getAttribute('role')).toBe('region');\n   527\t    expect(await scroll.getAttribute('tabindex')).toBe('0');\n   528\t    const [scrollBox, plotBox] = [(await scroll.boundingBox())!, (await page.locator('#chart .axylo-plot').boundingBox())!];\n   529\t    expect(scrollBox.height).toBeLessThanOrEqual(plotBox.height + 1);\n   530\t\n   531\t    await page.locator('#chart .axylo-pager button', { hasText: 'Next page' }).click();\n   532\t    const headers = await table.locator('tbody th').allTextContents();\n   533\t    expect(headers[0]).toBe('100');\n   534\t    expect(headers.at(-1)).toBe('199');\n   535\t    expect(await page.locator('#chart .axylo-page').textContent()).toBe('Page 2 of 10');\n   536\t\n   537\t    await page.locator('#chart .axylo-jump-field').fill('550');\n   538\t    await page.keyboard.press('Enter');\n   539\t    expect(await page.locator('#chart .axylo-page').textContent()).toBe('Page 6 of 10');\n   540\t    expect(await tabl