{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/a11y/util.ts'","aggregated_output":"     1\t/**\n     2\t * Shared setup for the accessibility and interaction tests: the fixture charts by name, Chrome's own\n     3\t * accessibility node for an element (through the DevTools protocol, so value text and role description are\n     4\t * what Chrome exposes, not a re-computation), axe-core, and the tab order.\n     5\t */\n     6\timport type { Page } from 'playwright-core';\n     7\timport path from 'node:path';\n     8\timport fs from 'node:fs';\n     9\timport { chartPage } from '../chart/util';\n    10\t\n    11\texport type FixtureName = 'trend' | 'bars' | 'parts' | 'scatter' | 'stacked' | 'dirty' | 'empty' | 'loading' | 'error' | 'compact';\n    12\texport const FIXTURES: readonly FixtureName[] = ['trend', 'bars', 'parts', 'scatter', 'stacked', 'dirty', 'empty', 'loading', 'error', 'compact'];\n    13\t\n    14\tdeclare global {\n    15\t  interface Window {\n    16\t    make(name: FixtureName, target: string | HTMLElement, extra?: Record<string, unknown>): import('../chart/util').ChartLike;\n    17\t  }\n    18\t}\n    19\t\n    20\t/** Runs in the page: builds a fixture chart. The trend fixture's x is UTC instants, as the Phase 1 harness has it. */\n    21\tfunction installMakers(): void {\n    22\t  const fx = window.fx;\n    23\t  const A = window.Axylo;\n    24\t  const trend = (extra: Record<string, unknown>) => ({\n    25\t    title: fx.trend.title, data: fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' },\n    26\t    y: { field: 'sessions', label: fx.trend.yTitle }, series: 'channel', ...extra,\n    27\t  });\n    28\t  window.make = (name, target, extra = {}) => {\n    29\t    switch (name) {\n    30\t      case 'trend': return A.line!(target, trend(extra));\n    31\t      case 'stacked': return A.area!(target, { ...trend(extra), title: 'Sessions, stacked', stacked: true });\n    32\t      case 'bars': return A.bar!(target, {\n    33\t        title: fx.bars.title, data: fx.bars.categories.map((team, i) => ({ team, satisfied: fx.bars.values[i] })),\n    34\t        x: 'team', y: { field: 'satisfied', label: 'Satisfied', scale: 'percent' }, reference: [{ y: 90, label: 'Target' }], ...extra,\n    35\t      });\n    36\t      case 'parts': return A.donut!(target, {\n    37\t        title: fx.parts.title, data: fx.parts.labels.map((browser, i) => ({ browser, share: fx.parts.values[i] })),\n    38\t        label: 'browser', value: { field: 'share', label: 'Share', scale: 'percent' }, ...extra,\n    39\t      });\n    40\t      case 'scatter': {\n    41\t        const r = fx.rng(3);\n    42\t        const data = Array.from({ length: 300 }, (_, i) => {\n    43\t          const size = 10 + r() * 990;\n    44\t          return { size: Math.round(size), latency: Math.round(20 + size * 0.08 + (r() - 0.5) * 40), region: ['EU', 'US', 'APAC'][i % 3] };\n    45\t        });\n    46\t        return A.scatter!(target, { title: 'Latency by payload size', data, x: { field: 'size', label: 'Payload', unit: 'kB' }, y: { field: 'latency', label: 'Latency', unit: 'ms' }, series: 'region', ...extra });\n    47\t      }\n    48\t      case 'dirty': return A.line!(target, { title: 'Dirty input', data: fx.dirtyRows(), x: 'day', y: 'value', ...extra });\n    49\t      case 'empty': return A.line!(target, { title: 'No rows returned', data: [], x: 'day', y: 'sessions', ...extra });\n    50\t      case 'loading': return A.line!(target, { title: 'Loading', state: 'loading', data: [], x: 'day', y: 'sessions', ...extra });\n    51\t      case 'error': return A.line!(target, { title: 'Failed', state: { error: 'The query failed.' }, data: [], x: 'day', y: 'sessions', ...extra });\n    52\t      case 'compact': return A.line!(target, { compact: true, title: 'Direct sessions', data: fx.trendRows().filter(r => r.channel === 'Direct'), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', ...extra });\n    53\t    }\n    54\t  };\n    55\t}\n    56\t\n    57\texport async function fixturePage(options: Parameters<typeof chartPage>[0] = {}): Promise<Page> {\n    58\t  const page = await chartPage(options);\n    59\t  await page.evaluate(installMakers);\n    60\t  return page;\n    61\t}\n    62\t\n    63\t/** Builds a fixture in #chart (or `target`) and waits for its first frame. */\n    64\texport async function make(page: Page, name: FixtureName, extra: Record<string, unknown> = {}, target = '#chart'): Promise<void> {\n    65\t  await page.evaluate(async ({ name, extra, target }) => {\n    66\t    const chart = window.make(name, target, extra);\n    67\t    window.charts.push(chart);\n    68\t    await chart.__bench.ready();\n    69\t    await window.nextFrames(1);\n    70\t  }, { name, extra, target });\n    71\t}\n    72\t\n    73\texport interface AxNode {\n    74\t  role: string;\n    75\t  name: string;\n    76\t  /** The range's value as Chrome exposes it (the ordinal). */\n    77\t  value: string;\n    78\t  max: number | null;\n    79\t  roledescription: string | null;\n    80\t  focused: boolean;\n    81\t  /**\n    82\t   * The value text. Chrome's DevTools accessibility view does not report `aria-valuetext` (its \"valuetext\"\n    83\t   * property shows the number, even for an ARIA slider), so this is the attribute the platform tree is built\n    84\t   * from; whether a screen reader speaks it can only be confirmed by rehearsal (decision 0001).\n    85\t   */\n    86\t  text: string;\n    87\t}\n    88\t\n    89\t/** Chrome's accessibility node for the first element matching `selector`. */\n    90\texport async function axNode(page: Page, selector: string): Promise<AxNode> {\n    91\t  const client = await page.context().newCDPSession(page);\n    92\t  try {\n    93\t    const { root } = await client.send('DOM.getDocument', { depth: 0 });\n    94\t    const { nodeId } = await client.send('DOM.querySelector', { nodeId: root.nodeId, selector });\n    95\t    if (!nodeId) throw new Error(`no element for ${selector}`);\n    96\t    const { node } = await client.send('DOM.describeNode', { nodeId });\n    97\t    const { nodes } = await client.send('Accessibility.getPartialAXTree', { backendNodeId: node.backendNodeId, fetchRelatives: false });\n    98\t    const ax = nodes[0]!;\n    99\t    const prop = (name: string) => ax.properties?.find(p => p.name === name)?.value?.value as unknown;\n   100\t    const roledescription = prop('roledescription');\n   101\t    const max = prop('valuemax');\n   102\t    return {\n   103\t      role: String(ax.role?.value ?? ''), name: String(ax.name?.value ?? ''), value: String(ax.value?.value ?? ''),\n   104\t      max: typeof max === 'number' ? max : null,\n   105\t      roledescription: roledescription === undefined ? null : String(roledescription), focused: prop('focused') === true,\n   106\t      text: (await page.locator(selector).first().getAttribute('aria-valuetext')) ?? '',\n   107\t    };\n   108\t  } finally {\n   109\t    await client.detach();\n   110\t  }\n   111\t}\n   112\t\n   113\tconst axeSource = fs.readFileSync(path.resolve(import.meta.dirname, '../../../../../node_modules/axe-core/axe.min.js'), 'utf8');\n   114\t\n   115\texport interface AxeViolation { id: string; impact: string | null; nodes: string[]; help: string }\n   116\t\n   117\t/** axe-core over `selector` (every rule axe enables by default, best practices such as heading-order included). */\n   118\texport async function axe(page: Page, selector = 'body'): Promise<{ violations: AxeViolation[]; ran: string[] }> {\n   119\t  if (!(await page.evaluate(() => 'axe' in window))) await page.addScriptTag({ content: axeSource });\n   120\t  return page.evaluate(async selector => {\n   121\t    type Rule = { id: string; impact: string | null; help: string; nodes: { target: string[] }[] };\n   122\t    const run = (window as unknown as { axe: { run(context: unknown, options: unknown): Promise<{ violations: Rule[]; passes: Rule[]; incomplete: Rule[] }> } }).axe;\n   123\t    const result = await run.run(selector, { resultTypes: ['violations', 'passes'] });\n   124\t    return {\n   125\t      violations: result.violations.map(v => ({ id: v.id, impact: v.impact, help: v.help, nodes: v.nodes.map(n => n.target.join(' ')) })),\n   126\t      ran: [...result.passes, ...result.violations, ...result.incomplete].map(r => r.id),\n   127\t    };\n   128\t  }, selector);\n   129\t}\n   130\t\n   131\t/** What has focus, as a short description: the chart part's class or the element's id. */\n   132\texport async function focused(page: Page): Promise<string> {\n   133\t  return page.evaluate(() => {\n   134\t    const el = document.activeElement as HTMLElement | null;\n   135\t    if (!el || el === document.body) return 'body';\n   136\t    if (el.id === 'before' || el.id === 'after') return el.id;\n   137\t    if (el.classList.contains('axylo-proxy')) return 'proxy';\n   138\t    if (el.closest('.axylo-toolbar')) return 'toolbar:' + (el.textContent ?? '');\n   139\t    if (el.classList.contains('axylo-table-scroll')) return 'table';\n   140\t    return el.tagName.toLowerCase() + '.' + el.className;\n   141\t  });\n   142\t}\n   143\t\n   144\t/** Presses Tab (or Shift+Tab) from `start` until focus leaves the chart, and lists the stops. */\n   145\texport async function tabStops(page: Page, backwards = false): Promise<string[]> {\n   146\t  await page.focus(backwards ? '#after' : '#before');\n   147\t  const stops: string[] = [];\n   148\t  for (let i = 0; i < 12; i++) {\n   149\t    await page.keyboard.press(backwards ? 'Shift+Tab' : 'Tab');\n   150\t    const at = await focused(page);\n   151\t    if (at === 'before' || at === 'after' || at === 'body') return [...stops, at];\n   152\t    stops.push(at);\n   153\t  }\n   154\t  return stops;\n   155\t}\n   156\t\n   157\t/** Text contrast per WCAG 2.x from two CSS colors resolved by the page. */\n   158\texport async function contrastOf(page: Page, selector: string): Promise<number> {\n   159\t  return page.evaluate(selector => {\n   160\t    const el = document.querySelector(selector) as HTMLElement;\n   161\t    const parse = (c: string) => {\n   162\t      const probe = document.createElement('canvas').getContext('2d')!;\n   163\t      probe.fillStyle = c;\n   164\t      probe.fillRect(0, 0, 1, 1);\n   165\t      const [r, g, b] = probe.getImageData(0, 0, 1, 1).data;\n   166\t      return [r!, g!, b!];\n   167\t    };\n   168\t    const lum = ([r, g, b]: number[]) => {\n   169\t      const f = (v: number) => { const s = v / 255; return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4; };\n   170\t      return 0.2126 * f(r!) + 0.7152 * f(g!) + 0.0722 * f(b!);\n   171\t    };\n   172\t    let bgEl: HTMLElement | null = el;\n   173\t    let bg = 'rgb(255, 255, 255)';\n   174\t    while (bgEl) {\n   175\t      const c = getComputedStyle(bgEl).backgroundColor;\n   176\t      if (c && c !== 'rgba(0, 0, 0, 0)' && c !== 'transparent') { bg = c; break; }\n   177\t      bgEl = bgEl.parentElement;\n   178\t    }\n   179\t    const fg = lum(parse(getComputedStyle(el).color));\n   180\t    const back = lum(parse(bg));\n   181\t    return (Math.max(fg, back) + 0.05) / (Math.min(fg, back) + 0.05);\n   182\t  }, selector);\n   183\t}\n","exit_code":0,"status":"completed"}}
