{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/figure.ts'","aggregated_output":"     1\t/**\n     2\t * The chart's document structure (plan 2.4; spec A1, C1, F12, L7). The author's target is the root; inside\n     3\t * it the figure holds the caption (title, subtitle, summary), the plot container (marks, text layer, state\n     4\t * message), the reader's note, a polite live region and the tooltip. Only text is ever set, never HTML.\n     5\t *\n     6\t * The interaction layer (dom/interaction.ts) adds the keyboard proxy inside the plot and fills `controls`\n     7\t * (legend, toolbar, table) and `readout`; the figure only provides those slots.\n     8\t */\n     9\t\n    10\texport interface TitleModel {\n    11\t  readonly text: string;\n    12\t  readonly level: number;\n    13\t  readonly visible: boolean;\n    14\t}\n    15\t\n    16\texport interface FigureModel {\n    17\t  readonly compact: boolean;\n    18\t  /** The heading, or null when there is none (only `labelledBy`, or no title at all). */\n    19\t  readonly title: TitleModel | null;\n    20\t  /** Id of a heading the page already has. */\n    21\t  readonly labelledBy: string | null;\n    22\t  /** Accessible name when neither a title nor `labelledBy` names the chart (generated, AX140). */\n    23\t  readonly name: string;\n    24\t  readonly subtitle: string | null;\n    25\t  readonly summary: string;\n    26\t  /** The plot is too small to draw (spec L8): the summary is shown instead. */\n    27\t  readonly summaryVisible: boolean;\n    28\t  readonly note: string | null;\n    29\t  /** Loading, empty, error or internal-error text shown inside the plot (spec L7); null when marks are shown. */\n    30\t  readonly message: string | null;\n    31\t  /**\n    32\t   * `lang` for the message and the note: 'en' when they show built-in English on a page in another\n    33\t   * language (spec A10), else null.\n    34\t   */\n    35\t  readonly messageLang?: string | null;\n    36\t  readonly noteLang?: string | null;\n    37\t}\n    38\t\n    39\texport interface Figure {\n    40\t  readonly figure: HTMLElement;\n    41\t  readonly plot: HTMLElement;\n    42\t  readonly tooltip: HTMLElement;\n    43\t  /** Fixed readout under the plot, used instead of the tooltip when it cannot fit beside the mark. */\n    44\t  readonly readout: HTMLElement;\n    45\t  /** Legend, toolbar and table, in that order, between the plot and the note. */\n    46\t  readonly controls: HTMLElement;\n    47\t  readonly id: string;\n    48\t  update(model: FigureModel): void;\n    49\t  /** Puts text in the polite live region (state changes only, spec L7, A7). */\n    50\t  announce(text: string): void;\n    51\t  /** Removes everything the figure added to the root, and the root's added class. */\n    52\t  destroy(): void;\n    53\t}\n    54\t\n    55\tconst HIDDEN = 'axylo-visually-hidden';\n    56\t\n    57\tfunction setText(el: HTMLElement, text: string): void {\n    58\t  if (el.textContent !== text) el.textContent = text;\n    59\t}\n    60\t\n    61\tfunction setAttr(el: Element, name: string, value: string | null): void {\n    62\t  if (value === null) {\n    63\t    if (el.hasAttribute(name)) el.removeAttribute(name);\n    64\t  } else if (el.getAttribute(name) !== value) {\n    65\t    el.setAttribute(name, value);\n    66\t  }\n    67\t}\n    68\t\n    69\tfunction show(el: HTMLElement, visible: boolean): void {\n    70\t  if (el.hidden === visible) el.hidden = !visible;\n    71\t}\n    72\t\n    73\texport function createFigure(root: HTMLElement, id: string, parts: { marks: Element; text: Element }): Figure {\n    74\t  const doc = root.ownerDocument;\n    75\t  const addedClass = !root.classList.contains('axylo');\n    76\t  const hadClassAttribute = root.hasAttribute('class');\n    77\t  if (addedClass) root.classList.add('axylo');\n    78\t\n    79\t  const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string): HTMLElementTagNameMap[K] => {\n    80\t    const el = doc.createElement(tag);\n    81\t    el.className = className;\n    82\t    return el;\n    83\t  };\n    84\t  const figure = make('figure', 'axylo-figure');\n    85\t  figure.id = id;\n    86\t  // A div, not figcaption: a figure with a figcaption may not take the group or img role (ARIA in HTML), and\n    87\t  // the figure is named and described through aria-labelledby and aria-describedby anyway.\n    88\t  const caption = make('div', 'axylo-caption');\n    89\t  const title = make('div', 'axylo-title');\n    90\t  title.id = `${id}-t`;\n    91\t  title.setAttribute('role', 'heading');\n    92\t  const subtitle = make('p', 'axylo-subtitle');\n    93\t  subtitle.id = `${id}-st`;\n    94\t  // Hidden until the first update says otherwise, so nothing is measured with an empty caption.\n    95\t  title.hidden = true;\n    96\t  subtitle.hidden = true;\n    97\t  const summary = make('p', `axylo-summary ${HIDDEN}`);\n    98\t  summary.id = `${id}-s`;\n    99\t  const plot = make('div', 'axylo-plot');\n   100\t  const message = make('p', 'axylo-message');\n   101\t  message.id = `${id}-m`;\n   102\t  message.hidden = true;\n   103\t  const corner = make('span', 'axylo-corner');\n   104\t  corner.setAttribute('aria-hidden', 'true');\n   105\t  corner.textContent = '*';\n   106\t  corner.hidden = true;\n   107\t  plot.append(parts.marks, parts.text, message, corner);\n   108\t  const note = make('p', 'axylo-note');\n   109\t  note.id = `${id}-n`;\n   110\t  note.setAttribute('role', 'status');\n   111\t  // A status that is not live: the note can change as streamed data arrives (labels thinned, values left\n   112\t  // out), and data arriving must not speak (spec A7). The summary carries the same statements.\n   113\t  note.setAttribute('aria-live', 'off');\n   114\t  note.hidden = true;\n   115\t  const live = make('div', `axylo-live ${HIDDEN}`);\n   116\t  live.setAttribute('aria-live', 'polite');\n   117\t  const tooltip = make('div', 'axylo-tooltip');\n   118\t  tooltip.hidden = true;\n   119\t  tooltip.setAttribute('aria-hidden', 'true');\n   120\t  const readout = make('div', 'axylo-readout');\n   121\t  readout.hidden = true;\n   122\t  readout.setAttribute('aria-hidden', 'true');\n   123\t  const controls = make('div', 'axylo-controls');\n   124\t  controls.hidden = true;\n   125\t  caption.append(title, subtitle, summary);\n   126\t  figure.append(caption, plot, controls, note, live, tooltip, readout);\n   127\t  root.appendChild(figure);\n   128\t\n   129\t  let last: FigureModel | null = null;\n   130\t\n   131\t  return {\n   132\t    figure,\n   133\t    plot,\n   134\t    tooltip,\n   135\t    readout,\n   136\t    controls,\n   137\t    id,\n   138\t    update(model: FigureModel): void {\n   139\t      if (last !== null && same(last, model)) return;\n   140\t      last = model;\n   141\t      const { compact } = model;\n   142\t      figure.classList.toggle('axylo-compact', compact);\n   143\t      setAttr(figure, 'role', compact ? 'img' : 'group');\n   144\t\n   145\t      // Name: the title, else the page's own heading, else the generated name.\n   146\t      const heading = !compact && model.title !== null;\n   147\t      if (heading) {\n   148\t        setText(title, model.title!.text);\n   149\t        setAttr(title, 'aria-level', String(model.title!.level));\n   150\t        title.classList.toggle(HIDDEN, !model.title!.visible);\n   151\t      }\n   152\t      show(title, heading);\n   153\t      if (model.labelledBy) {\n   154\t        setAttr(figure, 'aria-labelledby', model.labelledBy);\n   155\t        setAttr(figure, 'aria-label', null);\n   156\t      } else if (heading) {\n   157\t        setAttr(figure, 'aria-labelledby', title.id);\n   158\t        setAttr(figure, 'aria-label', null);\n   159\t      } else {\n   160\t        setAttr(figure, 'aria-labelledby', null);\n   161\t        setAttr(figure, 'aria-label', model.name);\n   162\t      }\n   163\t\n   164\t      setText(subtitle, model.subtitle ?? '');\n   165\t      show(subtitle, !compact && !!model.subtitle);\n   166\t      setText(summary, model.summary);\n   167\t      summary.classList.toggle(HIDDEN, compact || !model.summaryVisible);\n   168\t      setAttr(figure, 'aria-describedby', summary.id);\n   169\t\n   170\t      // The compact variant has no note element: the summary says what was left out, and a corner marker\n   171\t      // shows it (spec C5); the marker's text equivalent is that description.\n   172\t      setText(note, compact ? '' : model.note ?? '');\n   173\t      setAttr(note, 'lang', model.noteLang ?? null);\n   174\t      setAttr(message, 'lang', model.messageLang ?? null);\n   175\t      show(note, !compact && model.note !== null);\n   176\t      show(corner, compact && model.note !== null);\n   177\t      setAttr(corner, 'title', compact ? model.note : null);\n   178\t\n   179\t      setText(message, model.message ?? '');\n   180\t      show(message, model.message !== null);\n   181\t    },\n   182\t    announce(text: string): void {\n   183\t      setText(live, text);\n   184\t    },\n   185\t    destroy(): void {\n   186\t      figure.remove();\n   187\t      if (addedClass) root.classList.remove('axylo');\n   188\t      if (!hadClassAttribute && root.classList.length === 0) root.removeAttribute('class');\n   189\t    },\n   190\t  };\n   191\t}\n   192\t\n   193\tfunction same(a: FigureModel, b: FigureModel): boolean {\n   194\t  return a.compact === b.compact && a.messageLang === b.messageLang && a.noteLang === b.noteLang && a.labelledBy === b.labelledBy && a.name === b.name && a.subtitle === b.subtitle &&\n   195\t    a.summary === b.summary && a.summaryVisible === b.summaryVisible && a.note === b.note && a.message === b.message &&\n   196\t    (a.title === b.title || (a.title !== null && b.title !== null && a.title.text === b.title.text &&\n   197\t      a.title.level === b.title.level && a.title.visible === b.title.visible));\n   198\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/toolbar.ts'","aggregated_output":"     1\t/**\n     2\t * The chart's one toolbar (spec A2, I2, I3, I4, I6): legend toggles, zoom, pause and the table control, as\n     3\t * ordinary buttons with roving focus, so the whole toolbar is a single tab stop. Arrow keys move between\n     4\t * controls, Home and End jump to the ends.\n     5\t *\n     6\t * Buttons are kept by key and updated in place, so a control the reader is on keeps focus across commits.\n     7\t * When the control that has focus goes away (Reset after resetting, Pause before any append), focus moves to\n     8\t * its neighbour instead of falling back to the page.\n     9\t */\n    10\timport { createSwatch, type SwatchSpec } from './swatch';\n    11\t\n    12\texport interface ToolbarItem {\n    13\t  readonly key: string;\n    14\t  readonly label: string;\n    15\t  /** Toggle buttons (legend entries): aria-pressed. */\n    16\t  readonly pressed?: boolean;\n    17\t  /** Disclosure buttons (the table control): aria-expanded and, while expanded, aria-controls. */\n    18\t  readonly expanded?: boolean;\n    19\t  readonly controls?: string | null;\n    20\t  readonly swatch?: SwatchSpec;\n    21\t  /** A hidden series: struck-through name, outline swatch (never dimmed text, spec L2). */\n    22\t  readonly struck?: boolean;\n    23\t  /** `lang` of the button ('en' for built-in text on a page in another language), or null. */\n    24\t  readonly lang: string | null;\n    25\t  readonly className: string;\n    26\t  activate(): void;\n    27\t}\n    28\t\n    29\texport interface Toolbar {\n    30\t  readonly element: HTMLElement;\n    31\t  render(items: readonly ToolbarItem[], label: string, lang: string | null): void;\n    32\t  destroy(): void;\n    33\t}\n    34\t\n    35\tfunction setAttr(el: Element, name: string, value: string | null): void {\n    36\t  if (value === null) {\n    37\t    if (el.hasAttribute(name)) el.removeAttribute(name);\n    38\t  } else if (el.getAttribute(name) !== value) {\n    39\t    el.setAttribute(name, value);\n    40\t  }\n    41\t}\n    42\t\n    43\texport function createToolbar(doc: Document): Toolbar {\n    44\t  const element = doc.createElement('div');\n    45\t  element.className = 'axylo-toolbar';\n    46\t  element.setAttribute('role', 'toolbar');\n    47\t  const buttons = new Map<string, { button: HTMLButtonElement; item: ToolbarItem; signature: string }>();\n    48\t  let current: string | null = null;\n    49\t  let order: string[] = [];\n    50\t\n    51\t  function setCurrent(key: string | null): void {\n    52\t    current = key;\n    53\t    for (const [k, { button }] of buttons) button.tabIndex = k === current ? 0 : -1;\n    54\t  }\n    55\t\n    56\t  function move(to: number): void {\n    57\t    if (!order.length) return;\n    58\t    const key = order[(to + order.length) % order.length]!;\n    59\t    setCurrent(key);\n    60\t    buttons.get(key)!.button.focus();\n    61\t  }\n    62\t\n    63\t  element.addEventListener('keydown', (event: KeyboardEvent) => {\n    64\t    if (event.altKey || event.ctrlKey || event.metaKey) return;\n    65\t    const at = current === null ? -1 : order.indexOf(current);\n    66\t    switch (event.key) {\n    67\t      case 'ArrowRight': case 'ArrowDown': move(at + 1); break;\n    68\t      case 'ArrowLeft': case 'ArrowUp': move(at - 1); break;\n    69\t      case 'Home': move(0); break;\n    70\t      case 'End': move(order.length - 1); break;\n    71\t      default: return;\n    72\t    }\n    73\t    event.preventDefault();\n    74\t  });\n    75\t  element.addEventListener('focusin', (event: FocusEvent) => {\n    76\t    for (const [key, { button }] of buttons) if (button === event.target) setCurrent(key);\n    77\t  });\n    78\t\n    79\t  function fill(button: HTMLButtonElement, item: ToolbarItem): void {\n    80\t    const children: Node[] = [];\n    81\t    if (item.swatch) children.push(createSwatch(doc, item.swatch));\n    82\t    const text = doc.createElement('span');\n    83\t    text.className = 'axylo-control-label';\n    84\t    text.textContent = item.label;\n    85\t    children.push(text);\n    86\t    button.replaceChildren(...children);\n    87\t  }\n    88\t\n    89\t  return {\n    90\t    element,\n    91\t    render(items, label, lang) {\n    92\t      setAttr(element, 'aria-label', label);\n    93\t      setAttr(element, 'lang', lang);\n    94\t      const focused = doc.activeElement;\n    95\t      let focusedKey: string | null = null;\n    96\t      for (const [key, { button }] of buttons) if (button === focused) focusedKey = key;\n    97\t      const keys = items.map(i => i.key);\n    98\t      // Where a focused control that is going away hands focus: the control now at its place, or the last.\n    99\t      let heir: string | null = null;\n   100\t      if (focusedKey !== null && !keys.includes(focusedKey)) {\n   101\t        const was = order.indexOf(focusedKey);\n   102\t        const after = order.slice(was + 1).find(k => keys.includes(k));\n   103\t        const before = order.slice(0, was).reverse().find(k => keys.includes(k));\n   104\t        heir = after ?? before ?? keys[0] ?? null;\n   105\t      }\n   106\t      for (const [key, entry] of buttons) {\n   107\t        if (!keys.includes(key)) {\n   108\t          entry.button.remove();\n   109\t          buttons.delete(key);\n   110\t        }\n   111\t      }\n   112\t      let previous: HTMLButtonElement | null = null;\n   113\t      for (const item of items) {\n   114\t        let entry = buttons.get(item.key);\n   115\t        if (!entry) {\n   116\t          const button = doc.createElement('button');\n   117\t          button.type = 'button';\n   118\t          button.addEventListener('click', () => buttons.get(item.key)?.item.activate());\n   119\t          entry = { button, item, signature: '' };\n   120\t          buttons.set(item.key, entry);\n   121\t        }\n   122\t        entry.item = item;\n   123\t        const { button } = entry;\n   124\t        const signature = JSON.stringify([item.label, item.swatch, item.struck]);\n   125\t        if (signature !== entry.signature) {\n   126\t          fill(button, item);\n   127\t          entry.signature = signature;\n   128\t        }\n   129\t        if (button.className !== item.className) button.className = item.className;\n   130\t        button.classList.toggle('axylo-struck', item.struck === true);\n   131\t        setAttr(button, 'aria-pressed', item.pressed === undefined ? null : String(item.pressed));\n   132\t        setAttr(button, 'aria-expanded', item.expanded === undefined ? null : String(item.expanded));\n   133\t        setAttr(button, 'aria-controls', item.expanded ? item.controls ?? null : null);\n   134\t        setAttr(button, 'lang', item.lang);\n   135\t        const place: ChildNode | null = previous ? previous.nextSibling : element.firstChild;\n   136\t        if (place !== button) element.insertBefore(button, place);\n   137\t        previous = button;\n   138\t      }\n   139\t      order = keys;\n   140\t      const keep = heir ?? (current !== null && keys.includes(current) ? current : keys[0] ?? null);\n   141\t      setCurrent(keep);\n   142\t      if (heir !== null) buttons.get(heir)!.button.focus();\n   143\t    },\n   144\t    destroy() {\n   145\t      element.remove();\n   146\t      buttons.clear();\n   147\t    },\n   148\t  };\n   149\t}\n","exit_code":0,"status":"completed"}}
