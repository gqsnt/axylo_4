{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/test/browser/chart/interaction.browser.test.ts | sed -n '1,368p'\"","aggregated_output":"     1\t/**\n     2\t * Reading the chart with a pointer, touch and the toolbar (spec I1–I6, A4, A7, L6, F8): tooltip, legend\n     3\t * toggles, zoom, pause, the table view, events and the figure details of part 2. Expected values come from\n     4\t * the fixtures and the spec; positions are computed from the plot rectangle and the drawn domain.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport { LIGHT } from '../../../src/theme/palette';\n    10\timport { closePage, count, hex, shot } from './util';\n    11\timport { contrastOf, fixturePage, make } from '../a11y/util';\n    12\t\n    13\tbeforeAll(start);\n    14\tafterAll(stop);\n    15\t\n    16\tconst DAY = 864e5;\n    17\tconst START = Date.UTC(2026, 0, 1);\n    18\tconst date = (t: number) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(t);\n    19\tconst number = (v: number) => new Intl.NumberFormat('en-US').format(v);\n    20\t\n    21\tinterface Geometry { plot: { x: number; y: number; width: number; height: number }; xDomain: number[]; yDomain: number[] }\n    22\t\n    23\t/** The plot rectangle in viewport px (the keyboard proxy covers exactly it) and the drawn domains. */\n    24\tasync function geometry(page: Page, selector = '#chart', index = 0): Promise<Geometry> {\n    25\t  return page.evaluate(({ selector, index }) => {\n    26\t    const proxy = document.querySelector(`${selector} .axylo-proxy`)!.getBoundingClientRect();\n    27\t    const { xDomain, yDomain } = window.charts[index]!.__bench.describe();\n    28\t    return { plot: { x: proxy.x, y: proxy.y, width: proxy.width, height: proxy.height }, xDomain: xDomain!, yDomain: yDomain! };\n    29\t  }, { selector, index });\n    30\t}\n    31\t\n    32\tconst xPixel = (g: Geometry, x: number) => g.plot.x + (x - g.xDomain[0]!) / (g.xDomain[1]! - g.xDomain[0]!) * g.plot.width;\n    33\tconst settle = (page: Page) => page.evaluate(async () => { for (const c of window.charts) await c.__bench.ready(); await window.nextFrames(1); });\n    34\tconst domain = (page: Page) => page.evaluate(() => window.charts[0]!.__bench.describe().xDomain!);\n    35\tconst floating = (page: Page) => page.locator('#chart .axylo-tooltip');\n    36\t\n    37\tdescribe('tooltip (spec I1)', () => {\n    38\t  it('between two days shows every series at the nearer one, within one frame', async () => {\n    39\t    const page = await fixturePage();\n    40\t    await make(page, 'trend');\n    41\t    const g = await geometry(page);\n    42\t    const series = await page.evaluate(() => window.fx.trend.series);\n    43\t    // 30 % of the way from day 10 to day 11: day 10 is nearer.\n    44\t    const x = xPixel(g, START + 10.3 * DAY);\n    45\t    await page.mouse.move(x, g.plot.y + g.plot.height / 2);\n    46\t    const visibleNextFrame = await page.evaluate(async () => {\n    47\t      await new Promise(r => requestAnimationFrame(r));\n    48\t      return !(document.querySelector('#chart .axylo-tooltip') as HTMLElement).hidden;\n    49\t    });\n    50\t    expect(visibleNextFrame).toBe(true);\n    51\t    const text = (await floating(page).textContent())!;\n    52\t    expect(text).toContain(date(START + 10 * DAY));\n    53\t    for (const s of series) expect(text).toContain(`${s.name}${number(s.values[10]!)}`);\n    54\t    expect(await floating(page).locator('svg.axylo-swatch').count()).toBe(3);\n    55\t    expect(await closePage(page)).toEqual([]);\n    56\t  });\n    57\t\n    58\t  it('at each of the four plot edges it stays inside the viewport and beside the active x', async () => {\n    59\t    const page = await fixturePage({ css: 'body { margin: 0; } #chart { width: 100vw; height: 100vh; }' });\n    60\t    await make(page, 'trend');\n    61\t    const g = await geometry(page);\n    62\t    const viewport = page.viewportSize()!;\n    63\t    const cy = g.plot.y + g.plot.height / 2;\n    64\t    const cx = g.plot.x + g.plot.width / 2;\n    65\t    for (const [px, py] of [[g.plot.x + 1, cy], [g.plot.x + g.plot.width - 1, cy], [cx, g.plot.y + 1], [cx, g.plot.y + g.plot.height - 1]] as const) {\n    66\t      await page.mouse.move(px, py);\n    67\t      const box = (await floating(page).boundingBox())!;\n    68\t      expect(box.x).toBeGreaterThanOrEqual(0);\n    69\t      expect(box.y).toBeGreaterThanOrEqual(0);\n    70\t      expect(box.x + box.width).toBeLessThanOrEqual(viewport.width);\n    71\t      expect(box.y + box.height).toBeLessThanOrEqual(viewport.height);\n    72\t      // The active marks all sit on the rule at the picked x; the tooltip is beside it, not over it.\n    73\t      const at = await page.evaluate(() => window.charts[0]!.__bench.describe().xDomain);\n    74\t      expect(at).toBeTruthy();\n    75\t      expect(px < box.x || px > box.x + box.width).toBe(true);\n    76\t    }\n    77\t    expect(await closePage(page)).toEqual([]);\n    78\t  });\n    79\t\n    80\t  it('nine series show eight rows and \"+1 more\"', async () => {\n    81\t    const page = await fixturePage();\n    82\t    await page.evaluate(async () => {\n    83\t      const data = Array.from({ length: 20 }, (_, i) => Object.fromEntries([['i', i], ...Array.from({ length: 9 }, (_, s) => [`s${s + 1}`, (s + 1) * 10 + i])]));\n    84\t      const chart = window.Axylo.line!('#chart', { title: 'Nine', data, x: 'i', y: Array.from({ length: 9 }, (_, s) => `s${s + 1}`) });\n    85\t      window.charts.push(chart);\n    86\t      await chart.__bench.ready();\n    87\t    });\n    88\t    const g = await geometry(page);\n    89\t    await page.mouse.move(g.plot.x + g.plot.width / 2, g.plot.y + g.plot.height / 2);\n    90\t    expect(await floating(page).locator('.axylo-tooltip-row').count()).toBe(8);\n    91\t    expect(await floating(page).locator('.axylo-tooltip-more').textContent()).toBe('+1 more');\n    92\t    expect(await closePage(page)).toEqual([]);\n    93\t  });\n    94\t\n    95\t  it('can be hovered without closing, and Escape closes it until the pointer reaches another x', async () => {\n    96\t    const page = await fixturePage();\n    97\t    await make(page, 'trend');\n    98\t    const g = await geometry(page);\n    99\t    const x = xPixel(g, START + 30 * DAY);\n   100\t    await page.mouse.move(x, g.plot.y + 40);\n   101\t    const box = (await floating(page).boundingBox())!;\n   102\t    await page.mouse.move(box.x + box.width / 2, box.y + box.height / 2);\n   103\t    expect(await floating(page).isVisible()).toBe(true);\n   104\t    await page.mouse.move(x, g.plot.y + 40);\n   105\t    await page.keyboard.press('Escape');\n   106\t    expect(await floating(page).isVisible()).toBe(false);\n   107\t    await page.mouse.move(x, g.plot.y + 60);\n   108\t    expect(await floating(page).isVisible()).toBe(false);\n   109\t    await page.mouse.move(xPixel(g, START + 40 * DAY), g.plot.y + 60);\n   110\t    expect(await floating(page).isVisible()).toBe(true);\n   111\t    expect(await floating(page).textContent()).toContain(date(START + 40 * DAY));\n   112\t    expect(await closePage(page)).toEqual([]);\n   113\t  });\n   114\t\n   115\t  it('in a 260 px wide tile the same content is shown in the fixed readout under the plot', async () => {\n   116\t    const page = await fixturePage({ css: '#chart { width: 260px; height: 300px; }' });\n   117\t    await make(page, 'trend');\n   118\t    const g = await geometry(page);\n   119\t    await page.mouse.move(g.plot.x + g.plot.width / 2, g.plot.y + g.plot.height / 2);\n   120\t    const readout = page.locator('#chart .axylo-readout');\n   121\t    expect(await readout.isVisible()).toBe(true);\n   122\t    expect(await floating(page).isVisible()).toBe(false);\n   123\t    const text = (await readout.textContent())!;\n   124\t    for (const name of ['Direct', 'Organic search', 'Referral']) expect(text).toContain(name);\n   125\t    const [r, plot] = [(await readout.boundingBox())!, (await page.locator('#chart .axylo-plot').boundingBox())!];\n   126\t    expect(Math.abs(r.y - (plot.y + plot.height))).toBeLessThanOrEqual(1);\n   127\t    expect(await closePage(page)).toEqual([]);\n   128\t  });\n   129\t\n   130\t  it('a donut slice shows label, value and percentage; the overlay outlines it', async () => {\n   131\t    const page = await fixturePage();\n   132\t    await make(page, 'parts');\n   133\t    const plot = (await page.locator('#chart .axylo-proxy').boundingBox())!;\n   134\t    // Chrome (46.2 %) starts at 12 o'clock and runs clockwise: just right of the top, inside the ring.\n   135\t    const cx = plot.x + plot.width / 2;\n   136\t    const cy = plot.y + plot.height / 2;\n   137\t    const r = Math.min(plot.width, plot.height) / 2;\n   138\t    await page.mouse.move(cx + r * 0.3, cy - r * 0.8);\n   139\t    const text = (await floating(page).textContent())!;\n   140\t    expect(text).toContain('Chrome');\n   141\t    expect(text).toContain('46.2%');\n   142\t    expect(await closePage(page)).toEqual([]);\n   143\t  });\n   144\t});\n   145\t\n   146\tdescribe('legend (spec I2, A5, L2, F8)', () => {\n   147\t  it('toggles by click, Enter and Space; a hidden series leaves marks, tooltip and keyboard but stays in the table', async () => {\n   148\t    const page = await fixturePage();\n   149\t    await make(page, 'trend');\n   150\t    const referral = page.locator('#chart .axylo-legend-entry', { hasText: 'Referral' });\n   151\t    expect(await referral.getAttribute('aria-pressed')).toBe('true');\n   152\t    await referral.click();\n   153\t    await settle(page);\n   154\t    expect(await referral.getAttribute('aria-pressed')).toBe('false');\n   155\t    const { img } = await shot(page, '#chart .axylo-plot');\n   156\t    expect(count(img, hex(LIGHT.series[2]!), 40)).toBeLessThan(20);\n   157\t    expect(count(img, hex(LIGHT.series[0]!), 40)).toBeGreaterThan(200);\n   158\t    const g = await geometry(page);\n   159\t    await page.mouse.move(g.plot.x + g.plot.width / 2, g.plot.y + 30);\n   160\t    expect(await floating(page).textContent()).not.toContain('Referral');\n   161\t    expect(await page.locator('#chart .axylo-proxy').getAttribute('aria-valuetext')).not.toContain('Referral');\n   162\t    await page.locator('#chart button', { hasText: 'View as table' }).click();\n   163\t    expect(await page.locator('#chart table thead').textContent()).toContain('Referral');\n   164\t\n   165\t    await referral.focus();\n   166\t    await page.keyboard.press('Enter');\n   167\t    await settle(page);\n   168\t    expect(await referral.getAttribute('aria-pressed')).toBe('true');\n   169\t    await page.keyboard.press(' ');\n   170\t    await settle(page);\n   171\t    expect(await referral.getAttribute('aria-pressed')).toBe('false');\n   172\t    // Marked by an outline swatch and a struck-through name, never by dimmed text.\n   173\t    expect(await referral.locator('.axylo-control-label').evaluate(el => getComputedStyle(el).textDecorationLine)).toBe('line-through');\n   174\t    expect(await referral.locator('svg path').getAttribute('stroke')).toBe('currentColor');\n   175\t    expect(await contrastOf(page, '#chart .axylo-legend-entry.axylo-struck .axylo-control-label')).toBeGreaterThanOrEqual(4.5);\n   176\t    expect(await closePage(page)).toEqual([]);\n   177\t  });\n   178\t\n   179\t  it('a single-series chart has no legend', async () => {\n   180\t    const page = await fixturePage();\n   181\t    await make(page, 'bars');\n   182\t    expect(await page.locator('#chart .axylo-legend-entry').count()).toBe(0);\n   183\t    expect(await closePage(page)).toEqual([]);\n   184\t  });\n   185\t\n   186\t  it('the donut legend is a list of six entries with value and percentage, in slice order, not buttons', async () => {\n   187\t    const page = await fixturePage();\n   188\t    await make(page, 'parts');\n   189\t    const items = page.locator('#chart ul.axylo-legend-list > li');\n   190\t    expect(await items.count()).toBe(6);\n   191\t    const texts = await items.allTextContents();\n   192\t    const fx = await page.evaluate(() => window.fx.parts);\n   193\t    fx.labels.forEach((label, i) => {\n   194\t      expect(texts[i]).toContain(label);\n   195\t      expect(texts[i]).toContain(`${fx.values[i]}%`);\n   196\t    });\n   197\t    expect(await page.locator('#chart ul.axylo-legend-list button').count()).toBe(0);\n   198\t    expect(await page.locator('#chart .axylo-toolbar button').allTextContents()).toEqual(['View as table']);\n   199\t    expect(await closePage(page)).toEqual([]);\n   200\t  });\n   201\t\n   202\t  it('a donut with more than eight slices lists \"Other\" with its count, and a zero slice without an arc', async () => {\n   203\t    const page = await fixturePage();\n   204\t    await page.evaluate(async () => {\n   205\t      const labels = ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I', 'J'];\n   206\t      const values = [30, 20, 15, 10, 8, 6, 5, 0, 3, 3];\n   207\t      const chart = window.Axylo.donut!('#chart', { title: 'Ten', data: labels.map((l, i) => ({ l, v: values[i] })), label: 'l', value: 'v' });\n   208\t      window.charts.push(chart);\n   209\t      await chart.__bench.ready();\n   210\t    });\n   211\t    const texts = await page.locator('#chart ul.axylo-legend-list > li').allTextContents();\n   212\t    expect(texts.some(t => t.startsWith('Other ('))).toBe(true);\n   213\t    expect(await closePage(page)).toEqual([]);\n   214\t  });\n   215\t});\n   216\t\n   217\tdescribe('zoom (spec I3, I4)', () => {\n   218\t  it('Zoom in and out are single clicks around the centre; Reset appears only while zoomed; the zoom event carries the range', async () => {\n   219\t    const page = await fixturePage();\n   220\t    await make(page, 'trend');\n   221\t    await page.evaluate(() => {\n   222\t      (window as unknown as { zooms: unknown[] }).zooms = [];\n   223\t      window.charts[0]!.on('zoom', r => (window as unknown as { zooms: unknown[] }).zooms.push(r === null ? null : (r as Date[]).map(d => d.toISOString())));\n   224\t    });\n   225\t    const full = await domain(page);\n   226\t    const toolbar = page.locator('#chart .axylo-toolbar');\n   227\t    expect(await toolbar.locator('button', { hasText: 'Reset zoom' }).count()).toBe(0);\n   228\t    await toolbar.locator('button', { hasText: 'Zoom in' }).click();\n   229\t    await settle(page);\n   230\t    await toolbar.locator('button', { hasText: 'Zoom in' }).click();\n   231\t    await settle(page);\n   232\t    const zoomed = await domain(page);\n   233\t    const width = full[1]! - full[0]!;\n   234\t    expect(zoomed[1]! - zoomed[0]!).toBeCloseTo(width / 4, 0);\n   235\t    expect((zoomed[0]! + zoomed[1]!) / 2).toBeCloseTo((full[0]! + full[1]!) / 2, 0);\n   236\t    expect(await toolbar.locator('button', { hasText: 'Reset zoom' }).count()).toBe(1);\n   237\t    await toolbar.locator('button', { hasText: 'Zoom out' }).click();\n   238\t    await settle(page);\n   239\t    expect((await domain(page))[1]! - (await domain(page))[0]!).toBeCloseTo(width / 2, 0);\n   240\t    const reset = toolbar.locator('button', { hasText: 'Reset zoom' });\n   241\t    await reset.focus();\n   242\t    await page.keyboard.press('Enter');\n   243\t    await settle(page);\n   244\t    expect(await domain(page)).toEqual(full);\n   245\t    expect(await toolbar.locator('button', { hasText: 'Reset zoom' }).count()).toBe(0);\n   246\t    // Focus moved to a neighbouring control, not to the page.\n   247\t    expect(await page.evaluate(() => !!document.activeElement?.closest('.axylo-toolbar'))).toBe(true);\n   248\t    const zooms = await page.evaluate(() => (window as unknown as { zooms: unknown[] }).zooms);\n   249\t    expect(zooms).toHaveLength(4);\n   250\t    expect(zooms[3]).toBeNull();\n   251\t    expect(zooms[1]).toEqual([new Date(zoomed[0]!).toISOString(), new Date(zoomed[1]!).toISOString()]);\n   252\t    expect(await closePage(page)).toEqual([]);\n   253\t  });\n   254\t\n   255\t  it('dragging across the plot selects a range, shown while dragging; Escape cancels', async () => {\n   256\t    const page = await fixturePage();\n   257\t    await make(page, 'trend');\n   258\t    const g = await geometry(page);\n   259\t    const y = g.plot.y + g.plot.height / 2;\n   260\t    const a = g.plot.x + g.plot.width * 0.25;\n   261\t    const b = g.plot.x + g.plot.width * 0.5;\n   262\t    const expected = [g.xDomain[0]! + 0.25 * (g.xDomain[1]! - g.xDomain[0]!), g.xDomain[0]! + 0.5 * (g.xDomain[1]! - g.xDomain[0]!)];\n   263\t    await page.mouse.move(a, y);\n   264\t    await page.mouse.down();\n   265\t    await page.mouse.move(b, y, { steps: 5 });\n   266\t    expect(await page.locator('#chart .axylo-selection').isVisible()).toBe(true);\n   267\t    await page.keyboard.press('Escape');\n   268\t    await page.mouse.up();\n   269\t    await settle(page);\n   270\t    expect(await domain(page)).toEqual(g.xDomain);\n   271\t    await page.mouse.move(a, y);\n   272\t    await page.mouse.down();\n   273\t    await page.mouse.move(b, y, { steps: 5 });\n   274\t    await page.mouse.up();\n   275\t    await settle(page);\n   276\t    const after = await domain(page);\n   277\t    expect(Math.abs(after[0]! - expected[0]!)).toBeLessThan(DAY);\n   278\t    expect(Math.abs(after[1]! - expected[1]!)).toBeLessThan(DAY);\n   279\t    expect(await page.locator('#chart .axylo-selection').isVisible()).toBe(false);\n   280\t    expect(await closePage(page)).toEqual([]);\n   281\t  });\n   282\t\n   283\t  it('keyboard: + and - zoom, Shift+arrows pan, 0 resets', async () => {\n   284\t    const page = await fixturePage();\n   285\t    await make(page, 'trend');\n   286\t    const full = await domain(page);\n   287\t    await page.focus('#chart .axylo-proxy');\n   288\t    await page.keyboard.press('+');\n   289\t    await settle(page);\n   290\t    const half = await domain(page);\n   291\t    expect(half[1]! - half[0]!).toBeCloseTo((full[1]! - full[0]!) / 2, 0);\n   292\t    await page.keyboard.press('Shift+ArrowRight');\n   293\t    await settle(page);\n   294\t    const panned = await domain(page);\n   295\t    expect(panned[0]! - half[0]!).toBeCloseTo((half[1]! - half[0]!) * 0.1, 0);\n   296\t    await page.keyboard.press('Shift+ArrowLeft');\n   297\t    await settle(page);\n   298\t    expect((await domain(page))[0]).toBeCloseTo(half[0]!, 0);\n   299\t    await page.keyboard.press('-');\n   300\t    await settle(page);\n   301\t    expect(await domain(page)).toEqual(full);\n   302\t    await page.keyboard.press('+');\n   303\t    await page.keyboard.press('+');\n   304\t    await settle(page);\n   305\t    expect((await domain(page))[1]! - (await domain(page))[0]!).toBeCloseTo((full[1]! - full[0]!) / 4, 0);\n   306\t    await page.keyboard.press('0');\n   307\t    await settle(page);\n   308\t    expect(await domain(page)).toEqual(full);\n   309\t    expect(await closePage(page)).toEqual([]);\n   310\t  });\n   311\t\n   312\t  it('the wheel does nothing while the plot is not focused (the page scrolls), zooms when it is, and never with Ctrl', async () => {\n   313\t    const page = await fixturePage({ css: 'body { height: 3000px; }' });\n   314\t    await make(page, 'trend');\n   315\t    const full = await domain(page);\n   316\t    const g = await geometry(page);\n   317\t    await page.mouse.move(g.plot.x + g.plot.width / 2, g.plot.y + g.plot.height / 2);\n   318\t    await page.mouse.wheel(0, 200);\n   319\t    await page.waitForFunction(() => window.scrollY > 0);\n   320\t    await settle(page);\n   321\t    expect(await domain(page)).toEqual(full);\n   322\t    await page.evaluate(() => window.scrollTo(0, 0));\n   323\t    await page.focus('#chart .axylo-proxy');\n   324\t    const ctrl = await page.evaluate(() => {\n   325\t      const event = new WheelEvent('wheel', { deltaY: -100, ctrlKey: true, bubbles: true, cancelable: true, clientX: 300, clientY: 200 });\n   326\t      document.querySelector('#chart .axylo-plot')!.dispatchEvent(event);\n   327\t      return event.defaultPrevented;\n   328\t    });\n   329\t    expect(ctrl).toBe(false);\n   330\t    const meta = await page.evaluate(() => {\n   331\t      const event = new WheelEvent('wheel', { deltaY: -100, metaKey: true, bubbles: true, cancelable: true, clientX: 300, clientY: 200 });\n   332\t      document.querySelector('#chart .axylo-plot')!.dispatchEvent(event);\n   333\t      return event.defaultPrevented;\n   334\t    });\n   335\t    expect(meta).toBe(false);\n   336\t    await settle(page);\n   337\t    expect(await domain(page)).toEqual(full);\n   338\t    await page.mouse.move(g.plot.x + g.plot.width / 2, g.plot.y + g.plot.height / 2);\n   339\t    await page.mouse.wheel(0, -200);\n   340\t    await settle(page);\n   341\t    const zoomed = await domain(page);\n   342\t    expect(zoomed[1]! - zoomed[0]!).toBeLessThan(full[1]! - full[0]!);\n   343\t    expect(await page.evaluate(() => window.scrollY)).toBe(0);\n   344\t    expect(await closePage(page)).toEqual([]);\n   345\t  });\n   346\t\n   347\t  it('a category bar chart has no zoom controls; a donut has none', async () => {\n   348\t    const page = await fixturePage();\n   349\t    await make(page, 'bars');\n   350\t    expect(await page.locator('#chart button', { hasText: 'Zoom in' }).count()).toBe(0);\n   351\t    expect(await closePage(page)).toEqual([]);\n   352\t  });\n   353\t});\n   354\t\n   355\tdescribe('touch (spec I4)', () => {\n   356\t  it('a tap pins the tooltip and a tap elsewhere dismisses it; a one-finger vertical drag scrolls the page', async () => {\n   357\t    const page = await fixturePage({ hasTouch: true, css: 'body { height: 3000px; }' });\n   358\t    await make(page, 'trend');\n   359\t    const g = await geometry(page);\n   360\t    const x = g.plot.x + g.plot.width / 2;\n   361\t    await page.touchscreen.tap(x, g.plot.y + g.plot.height / 2);\n   362\t    await page.waitForTimeout(50);\n   363\t    expect(await floating(page).isVisible()).toBe(true);\n   364\t    await page.waitForTimeout(400);\n   365\t    expect(await floating(page).isVisible()).toBe(true);\n   366\t    await page.touchscreen.tap(450, 650);\n   367\t    await page.waitForTimeout(50);\n   368\t    expect(await floating(page).isVisible()).toBe(false);\n","exit_code":0,"status":"completed"}}
