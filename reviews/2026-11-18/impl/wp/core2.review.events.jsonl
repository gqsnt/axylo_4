{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/a11y/keyboard.browser.test.ts'","aggregated_output":"     1\t/**\n     2\t * Keyboard and screen-reader proxy (decision 0001; spec A2, A3, A7). Expected text comes from the trend\n     3\t * fixture (three series over 120 UTC days, Referral null on days 60–66) and the built-in messages; the\n     4\t * accessibility node is read from Chrome itself through the DevTools protocol after each step.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport { aria, closePage } from '../chart/util';\n    10\timport { axNode, fixturePage, make, tabStops } from './util';\n    11\t\n    12\tbeforeAll(start);\n    13\tafterAll(stop);\n    14\t\n    15\tconst SHOW_BUTTONS = '#before, #after { display: inline-block !important; }';\n    16\tconst DAY = 864e5;\n    17\tconst START = Date.UTC(2026, 0, 1);\n    18\tconst number = (v: number) => new Intl.NumberFormat('en-US').format(v);\n    19\tconst date = (i: number) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(START + i * DAY);\n    20\t\n    21\tasync function trendValues(page: Page): Promise<{ name: string; values: (number | null)[] }[]> {\n    22\t  return page.evaluate(() => window.fx.trend.series);\n    23\t}\n    24\t\n    25\tconst valueText = (page: Page) => page.locator('#chart .axylo-proxy').getAttribute('aria-valuetext');\n    26\t\n    27\tdescribe('tab order (spec A2): the plot, then the toolbar, then out', () => {\n    28\t  const states: [string, (page: Page) => Promise<void>][] = [\n    29\t    ['default', async () => {}],\n    30\t    ['zoomed', async page => {\n    31\t      await page.evaluate(async () => {\n    32\t        const c = window.charts[0]!;\n    33\t        c.zoom([Date.UTC(2026, 1, 1), Date.UTC(2026, 2, 1)]);\n    34\t        await c.__bench.ready();\n    35\t        await window.nextFrames(1);\n    36\t      });\n    37\t    }],\n    38\t    ['streaming', async page => {\n    39\t      await page.evaluate(async () => {\n    40\t        const c = window.charts[0]!;\n    41\t        c.append([{ day: Date.UTC(2026, 4, 1), channel: 'Direct', sessions: 41000 }], { keep: 120 });\n    42\t        await c.__bench.ready();\n    43\t        await window.nextFrames(1);\n    44\t      });\n    45\t    }],\n    46\t    ['hidden series', async page => {\n    47\t      await page.locator('#chart .axylo-legend-entry', { hasText: 'Referral' }).click();\n    48\t      await page.evaluate(async () => { await window.charts[0]!.__bench.ready(); await window.nextFrames(1); });\n    49\t    }],\n    50\t  ];\n    51\t  for (const [state, enter] of states) {\n    52\t    it(`exactly two stops in the ${state} state, forwards and backwards`, async () => {\n    53\t      const page = await fixturePage({ css: SHOW_BUTTONS });\n    54\t      await make(page, 'trend');\n    55\t      await enter(page);\n    56\t      const forwards = await tabStops(page);\n    57\t      expect(forwards[0]).toBe('proxy');\n    58\t      expect(forwards[1]).toMatch(/^toolbar:/);\n    59\t      expect(forwards.slice(2)).toEqual(['after']);\n    60\t      const backwards = await tabStops(page, true);\n    61\t      expect(backwards[0]).toMatch(/^toolbar:/);\n    62\t      expect(backwards[1]).toBe('proxy');\n    63\t      expect(backwards.slice(2)).toEqual(['before']);\n    64\t      if (state === 'streaming') expect(await page.locator('#chart .axylo-toolbar').textContent()).toContain('Pause');\n    65\t      if (state === 'zoomed') expect(await page.locator('#chart .axylo-toolbar').textContent()).toContain('Reset zoom');\n    66\t      expect(await closePage(page)).toEqual([]);\n    67\t    });\n    68\t  }\n    69\t\n    70\t  it('the toolbar has roving focus: arrows, Home and End move within it; one tab stop', async () => {\n    71\t    const page = await fixturePage({ css: SHOW_BUTTONS });\n    72\t    await make(page, 'trend');\n    73\t    await page.focus('#before');\n    74\t    await page.keyboard.press('Tab');\n    75\t    await page.keyboard.press('Tab');\n    76\t    const label = () => page.evaluate(() => document.activeElement?.textContent ?? '');\n    77\t    expect(await label()).toBe('Direct');\n    78\t    await page.keyboard.press('ArrowRight');\n    79\t    expect(await label()).toBe('Organic search');\n    80\t    await page.keyboard.press('End');\n    81\t    expect(await label()).toBe('View as table');\n    82\t    await page.keyboard.press('Home');\n    83\t    expect(await label()).toBe('Direct');\n    84\t    await page.keyboard.press('ArrowLeft');\n    85\t    expect(await label()).toBe('View as table');\n    86\t    // Leaving and coming back lands on the control last used.\n    87\t    await page.keyboard.press('Shift+Tab');\n    88\t    await page.keyboard.press('Tab');\n    89\t    expect(await label()).toBe('View as table');\n    90\t    expect(await page.locator('#chart [role=\"toolbar\"] [tabindex=\"0\"]').count()).toBe(1);\n    91\t    expect(await closePage(page)).toEqual([]);\n    92\t  });\n    93\t\n    94\t  it('the table, once open, adds its scroll region after the toolbar; focus still leaves the chart', async () => {\n    95\t    const page = await fixturePage({ css: SHOW_BUTTONS });\n    96\t    await make(page, 'trend');\n    97\t    await page.locator('#chart button', { hasText: 'View as table' }).click();\n    98\t    const stops = await tabStops(page);\n    99\t    expect(stops.slice(0, 3)).toEqual(['proxy', expect.stringMatching(/^toolbar:/), 'table']);\n   100\t    expect(stops.at(-1)).toBe('after');\n   101\t    expect(await closePage(page)).toEqual([]);\n   102\t  });\n   103\t\n   104\t  it('a compact chart adds no tab stop (spec C1)', async () => {\n   105\t    const page = await fixturePage({ css: SHOW_BUTTONS });\n   106\t    await make(page, 'compact');\n   107\t    expect(await tabStops(page)).toEqual(['after']);\n   108\t    expect(await page.locator('#chart input, #chart button').count()).toBe(0);\n   109\t    expect(await closePage(page)).toEqual([]);\n   110\t  });\n   111\t});\n   112\t\n   113\tdescribe('keyboard walk on the trend fixture (decision 0001)', () => {\n   114\t  it('reads every series at x, narrows to one with Down, reaches the ends, pages by a tenth, and selects', async () => {\n   115\t    const page = await fixturePage({ css: SHOW_BUTTONS });\n   116\t    await make(page, 'trend');\n   117\t    const series = await trendValues(page);\n   118\t    await page.evaluate(() => {\n   119\t      (window as unknown as { selected: unknown[] }).selected = [];\n   120\t      window.charts[0]!.on('select', p => {\n   121\t        const point = p as { series: string; x: Date; y: number | null; index: number };\n   122\t        (window as unknown as { selected: unknown[] }).selected.push({ series: point.series, x: point.x.toISOString(), y: point.y });\n   123\t      });\n   124\t    });\n   125\t    await page.focus('#before');\n   126\t    await page.keyboard.press('Tab');\n   127\t    let node = await axNode(page, '#chart .axylo-proxy');\n   128\t    expect(node).toMatchObject({ role: 'slider', name: 'Chart plot', roledescription: 'Line', focused: true, value: '0', max: 119 });\n   129\t    expect(node.text).toContain(date(0));\n   130\t    for (let i = 0; i < 3; i++) await page.keyboard.press('ArrowRight');\n   131\t\n   132\t    // Fourth x, all three series with their values, ending with the position.\n   133\t    node = await axNode(page, '#chart .axylo-proxy');\n   134\t    expect(node.role).toBe('slider');\n   135\t    expect(node.text.startsWith(date(3))).toBe(true);\n   136\t    for (const s of series) expect(node.text).toContain(`${s.name} ${number(s.values[3]!)}`);\n   137\t    expect(node.text.endsWith('Point 4 of 120.')).toBe(true);\n   138\t    expect(node).toMatchObject({ value: '3', max: 119, focused: true });\n   139\t    const tree = await aria(page);\n   140\t    expect(tree).toContain('slider \"Chart plot\"');\n   141\t    expect(tree).toContain('toolbar \"Chart controls\"');\n   142\t\n   143\t    // Down narrows to the first series, again to the second.\n   144\t    await page.keyboard.press('ArrowDown');\n   145\t    node = await axNode(page, '#chart .axylo-proxy');\n   146\t    expect(node.text.startsWith(`Direct, ${date(3)}`)).toBe(true);\n   147\t    expect(node.text.endsWith(`, ${number(series[0]!.values[3]!)}. Point 4 of 120.`)).toBe(true);\n   148\t    expect(node.text).not.toContain('Organic');\n   149\t    await page.keyboard.press('ArrowDown');\n   150\t    node = await axNode(page, '#chart .axylo-proxy');\n   151\t    expect(node.text.startsWith(`Organic search, ${date(3)}`)).toBe(true);\n   152\t    expect(node.text).toContain(number(series[1]!.values[3]!));\n   153\t\n   154\t    // Home and End reach the ends; Page Down moves back by a tenth (12 of 120).\n   155\t    await page.keyboard.press('Home');\n   156\t    node = await axNode(page, '#chart .axylo-proxy');\n   157\t    expect(node.text.startsWith(`Organic search, ${date(0)}`)).toBe(true);\n   158\t    expect(node.text.endsWith('Point 1 of 120.')).toBe(true);\n   159\t    await page.keyboard.press('End');\n   160\t    node = await axNode(page, '#chart .axylo-proxy');\n   161\t    expect(node.text.startsWith(`Organic search, ${date(119)}`)).toBe(true);\n   162\t    expect(node.text.endsWith('Point 120 of 120.')).toBe(true);\n   163\t    expect(node.value).toBe('119');\n   164\t    await page.keyboard.press('PageDown');\n   165\t    node = await axNode(page, '#chart .axylo-proxy');\n   166\t    expect(node.text.endsWith('Point 108 of 120.')).toBe(true);\n   167\t    expect(node.value).toBe('107');\n   168\t    await page.keyboard.press('PageUp');\n   169\t    expect((await axNode(page, '#chart .axylo-proxy')).text.endsWith('Point 120 of 120.')).toBe(true);\n   170\t    expect(await page.locator('#chart .axylo-proxy').inputValue()).toBe('119');\n   171\t\n   172\t    // Escape: first the tooltip, then single-series mode, then it is left to the page.\n   173\t    expect(await page.locator('#chart .axylo-tooltip').isVisible()).toBe(true);\n   174\t    await page.keyboard.press('Escape');\n   175\t    expect(await page.locator('#chart .axylo-tooltip').isVisible()).toBe(false);\n   176\t    expect((await axNode(page, '#chart .axylo-proxy')).text.startsWith('Organic search, ')).toBe(true);\n   177\t    await page.keyboard.press('Escape');\n   178\t    node = await axNode(page, '#chart .axylo-proxy');\n   179\t    expect(node.text.startsWith(date(119) + ', 12:00 AM UTC: Direct ')).toBe(true);\n   180\t    const escape = await page.evaluate(() => new Promise<boolean>(resolve => {\n   181\t      document.addEventListener('keydown', e => resolve(e.defaultPrevented), { once: true });\n   182\t      document.querySelector<HTMLElement>('#chart .axylo-proxy')!.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true }));\n   183\t    }));\n   184\t    expect(escape).toBe(false);\n   185\t\n   186\t    // Enter selects the datum the reader is on: the last day, the first series with a value.\n   187\t    await page.keyboard.press('Enter');\n   188\t    await page.keyboard.press('ArrowLeft');\n   189\t    await page.keyboard.press(' ');\n   190\t    const selected = await page.evaluate(() => (window as unknown as { selected: unknown[] }).selected);\n   191\t    expect(selected).toEqual([\n   192\t      { series: 'Direct', x: new Date(START + 119 * DAY).toISOString(), y: series[0]!.values[119] },\n   193\t      { series: 'Direct', x: new Date(START + 118 * DAY).toISOString(), y: series[0]!.values[118] },\n   194\t    ]);\n   195\t    expect(await closePage(page)).toEqual([]);\n   196\t  });\n   197\t\n   198\t  it('the focus ring is at least 2 px in the focus color and is drawn only for keyboard focus', async () => {\n   199\t    const page = await fixturePage({ css: SHOW_BUTTONS });\n   200\t    await make(page, 'trend');\n   201\t    const ring = page.locator('#chart .axylo-focus-ring');\n   202\t    expect(await ring.isVisible()).toBe(false);\n   203\t    await page.focus('#before');\n   204\t    await page.keyboard.press('Tab');\n   205\t    expect(await ring.isVisible()).toBe(true);\n   206\t    const style = await ring.evaluate(el => {\n   207\t      const s = getComputedStyle(el);\n   208\t      return { width: parseFloat(s.outlineWidth), style: s.outlineStyle, color: s.outlineColor };\n   209\t    });\n   210\t    expect(style.width).toBeGreaterThanOrEqual(2);\n   211\t    expect(style.style).toBe('solid');\n   212\t    // LIGHT.focus (#1f5fcc) is 6.0:1 on white (theme/palette.ts, spec L2 requires 3:1).\n   213\t    expect(style.color).toBe('rgb(31, 95, 204)');\n   214\t    // The tooltip sits beside the mark and never over the whole ring.\n   215\t    const [tip, box] = await Promise.all([page.locator('#chart .axylo-tooltip').first().boundingBox(), ring.boundingBox()]);\n   216\t    expect(tip!.width * tip!.height).toBeLessThan(box!.width * box!.height / 2);\n   217\t    expect(await closePage(page)).toEqual([]);\n   218\t  });\n   219\t});\n   220\t\n   221\tdescribe('missing data and hidden series', () => {\n   222\t  it('stepping onto the outage reads \"No data\" for Referral; a hidden series is skipped; hiding the focused series keeps the x', async () => {\n   223\t    const page = await fixturePage({ css: SHOW_BUTTONS });\n   224\t    await make(page, 'trend');\n   225\t    await page.focus('#before');\n   226\t    await page.keyboard.press('Tab');\n   227\t    for (let i = 0; i < 60; i++) await page.keyboard.press('ArrowRight');\n   228\t    let text = (await axNode(page, '#chart .axylo-proxy')).text;\n   229\t    expect(text.startsWith(date(60))).toBe(true);\n   230\t    expect(text).toContain('Referral No data');\n   231\t    expect(text.endsWith('Point 61 of 120.')).toBe(true);\n   232\t\n   233\t    // In single-series mode Referral skips its own outage (lookup.step): from day 59 Right lands on day 67.\n   234\t    await page.keyboard.press('ArrowLeft');\n   235\t    await page.keyboard.press('ArrowUp');\n   236\t    text = (await axNode(page, '#chart .axylo-proxy')).text;\n   237\t    expect(text.startsWith(`Referral, ${date(59)}`)).toBe(true);\n   238\t    await page.keyboard.press('ArrowRight');\n   239\t    text = (await axNode(page, '#chart .axylo-proxy')).text;\n   240\t    expect(text.startsWith(`Referral, ${date(67)}`)).toBe(true);\n   241\t    expect(text.endsWith('Point 68 of 120.')).toBe(true);\n   242\t    await page.keyboard.press('ArrowLeft');\n   243\t\n   244\t    // Hide the focused series with the legend: focus resolves to the same x.\n   245\t    await page.locator('#chart .axylo-legend-entry', { hasText: 'Referral' }).click();\n   246\t    await page.evaluate(async () => { await window.charts[0]!.__bench.ready(); await window.nextFrames(1); });\n   247\t    text = (await valueText(page))!;\n   248\t    expect(text).toContain(date(59));\n   249\t    expect(text.endsWith('Point 60 of 120.')).toBe(true);\n   250\t    expect(text).not.toContain('Referral');\n   251\t\n   252\t    // Back on the plot, Up and Down move over the visible series only.\n   253\t    await page.focus('#chart .axylo-proxy');\n   254\t    await page.keyboard.press('Escape');\n   255\t    text = (await axNode(page, '#chart .axylo-proxy')).text;\n   256\t    expect(text).not.toContain('Referral');\n   257\t    await page.keyboard.press('ArrowDown');\n   258\t    await page.keyboard.press('ArrowDown');\n   259\t    await page.keyboard.press('ArrowDown');\n   260\t    text = (await axNode(page, '#chart .axylo-proxy')).text;\n   261\t    expect(text.startsWith(`Organic search, ${date(59)}`)).toBe(true);\n   262\t    expect(await closePage(page)).toEqual([]);\n   263\t  });\n   264\t});\n","exit_code":0,"status":"completed"}}
