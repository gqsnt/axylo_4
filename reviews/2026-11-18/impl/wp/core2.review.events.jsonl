    expect((await text())!.startsWith(date(START + 3 * DAY))).toBe(true);\n   453\t    for (let d = 120; d < 123; d++) await page.evaluate(async rows => { window.charts[0]!.append(rows, { keep: 120 }); }, rowsFor(d));\n   454\t    await settle(page);\n   455\t    // Days 0–2 left the window; day 3 is still there, so nothing changed for the reader.\n   456\t    expect((await text())!.startsWith(date(START + 3 * DAY))).toBe(true);\n   457\t    await page.evaluate(async rows => { window.charts[0]!.append(rows, { keep: 120 }); }, rowsFor(123));\n   458\t    await settle(page);\n   459\t    expect((await text())!.startsWith(date(START + 4 * DAY))).toBe(true);\n   460\t    expect((await text())!.endsWith('Point 1 of 120.')).toBe(true);\n   461\t    // The next move starts from there.\n   462\t    await page.keyboard.press('ArrowRight');\n   463\t    expect((await text())!.startsWith(date(START + 5 * DAY))).toBe(true);\n   464\t    expect(await closePage(page)).toEqual([]);\n   465\t  });\n   466\t\n   467\t  it('24 charts appending for two seconds change no live region', async () => {\n   468\t    const page = await fixturePage({ css: '.tile { width: 220px; height: 160px; display: inline-block; }' });\n   469\t    const changes = await page.evaluate(async () => {\n   470\t      const charts = Array.from({ length: 24 }, () => {\n   471\t        const el = document.body.appendChild(Object.assign(document.createElement('div'), { className: 'tile' }));\n   472\t        return window.make('trend', el);\n   473\t      });\n   474\t      await Promise.all(charts.map(c => c.__bench.ready()));\n   475\t      let mutations = 0;\n   476\t      const observer = new MutationObserver(records => { mutations += records.length; });\n   477\t      // Every live region: aria-live other than off, or a live role without aria-live=\"off\".\n   478\t      const live = '[aria-live]:not([aria-live=\"off\"]), [role=\"status\"]:not([aria-live=\"off\"]), [role=\"alert\"], [role=\"log\"]';\n   479\t 