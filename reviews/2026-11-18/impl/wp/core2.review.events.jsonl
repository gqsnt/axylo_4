{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/swatch.ts'","aggregated_output":"     1\t/**\n     2\t * The legend and tooltip swatch: a small SVG that repeats how a series is drawn (spec A5): its color, its\n     3\t * marker shape, and for lines its dash. The color is the series' custom property on the chart root\n     4\t * (`--axylo-series-color-N`), so a theme change or forced colors restyle it with no call.\n     5\t *\n     6\t * A hidden series is drawn as an outline of the same shape (spec I2: marked by shape, not by dimming).\n     7\t */\n     8\timport type { MarkerShape, SeriesCue } from '../core/contracts';\n     9\timport { MARKER_POLYGONS } from '../render/geometry';\n    10\t\n    11\tconst NS = 'http://www.w3.org/2000/svg';\n    12\t\n    13\texport interface SwatchSpec {\n    14\t  /** Palette index of the series (or slice), null for a muted entry such as a donut's \"Other\". */\n    15\t  readonly color: number | null;\n    16\t  readonly cue: SeriesCue | null;\n    17\t  /** Draw the short dashed stroke of a line behind the marker. */\n    18\t  readonly line: boolean;\n    19\t  /** Outline only: the series is hidden. */\n    20\t  readonly hollow: boolean;\n    21\t}\n    22\t\n    23\tfunction colorOf(index: number | null): string {\n    24\t  return index === null ? 'var(--axylo-muted, var(--axylo-default-muted))' : `var(--axylo-series-color-${index + 1})`;\n    25\t}\n    26\t\n    27\tfunction markerPath(shape: MarkerShape, cx: number, cy: number, size: number): string {\n    28\t  if (shape === 'circle') {\n    29\t    const r = size / 2;\n    30\t    return `M${cx - r} ${cy}a${r} ${r} 0 1 0 ${2 * r} 0a${r} ${r} 0 1 0 ${-2 * r} 0Z`;\n    31\t  }\n    32\t  const poly = MARKER_POLYGONS[shape];\n    33\t  let d = '';\n    34\t  for (let k = 0; k < poly.length; k += 2) {\n    35\t    d += `${k === 0 ? 'M' : 'L'}${(cx + poly[k]! * size).toFixed(2)} ${(cy + poly[k + 1]! * size).toFixed(2)}`;\n    36\t  }\n    37\t  return d + 'Z';\n    38\t}\n    39\t\n    40\t/** A 20 × 12 swatch (CSS px). aria-hidden: the series name beside it is the text. */\n    41\texport function createSwatch(doc: Document, spec: SwatchSpec): SVGSVGElement {\n    42\t  const svg = doc.createElementNS(NS, 'svg');\n    43\t  svg.setAttribute('class', 'axylo-swatch');\n    44\t  svg.setAttribute('viewBox', '0 0 20 12');\n    45\t  svg.setAttribute('width', '20');\n    46\t  svg.setAttribute('height', '12');\n    47\t  svg.setAttribute('aria-hidden', 'true');\n    48\t  svg.setAttribute('focusable', 'false');\n    49\t  const color = colorOf(spec.color);\n    50\t  svg.style.color = color;\n    51\t  if (spec.line) {\n    52\t    const line = doc.createElementNS(NS, 'line');\n    53\t    line.setAttribute('x1', '0');\n    54\t    line.setAttribute('x2', '20');\n    55\t    line.setAttribute('y1', '6');\n    56\t    line.setAttribute('y2', '6');\n    57\t    line.setAttribute('stroke', 'currentColor');\n    58\t    line.setAttribute('stroke-width', '2');\n    59\t    const dash = spec.cue?.dash.normal;\n    60\t    if (dash && dash.length) line.setAttribute('stroke-dasharray', dash.map(v => Math.max(1, v / 2)).join(' '));\n    61\t    svg.appendChild(line);\n    62\t  }\n    63\t  const shape = doc.createElementNS(NS, 'path');\n    64\t  // Without a cue (a donut slice, a single bar series) the swatch is a square chip.\n    65\t  shape.setAttribute('d', markerPath(spec.cue?.marker ?? 'square', 10, 6, spec.cue ? 10 : 11));\n    66\t  if (spec.hollow) {\n    67\t    // Under the line a hollow marker needs the background inside it, or the line shows through.\n    68\t    shape.setAttribute('fill', 'var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background)))');\n    69\t    shape.setAttribute('stroke', 'currentColor');\n    70\t    shape.setAttribute('stroke-width', '1.5');\n    71\t  } else {\n    72\t    shape.setAttribute('fill', 'curr