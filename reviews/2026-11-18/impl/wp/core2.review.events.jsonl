\n    36\t        for (let i = 0; i < rowCount; i++) if (frame.slot[i] === SLOT_VALUE) scaled += frame.values[i]! / max;\n    37\t        weights = { max, total: scaled };\n    38\t      }\n    39\t      return formatters.percent(donutRatio(value / weights.max, weights.total));\n    40\t    }\n    41\t    return {\n    42\t      caption, headers: [labels.category, withUnit(frame.valueLabel, frame.unit), labels.percentage], rowCount, pageSize: PAGE_SIZE,\n    43\t      row(i) {\n    44\t        if (!Number.isInteger(i) || i < 0 || i >= rowCount) return null;\n    45\t        const state = frame.slot[i] as SlotState;\n    46\t        const value = frame.values[i]!;\n    47\t        return [frame.labels[i]!, slotText(formatters, 0, value, state), state === SLOT_VALUE && value >= 0\n    48\t          ? writePercent(value) : messages.noData];\n    49\t      },\n    50\t      pageForX(x) { return page(readPosition(x, 'category', null, frame.labels), rowCount); },\n    51\t    };\n    52\t  }\n    53\t  if (view.kind === 'scatter') {\n    54\t    const { frame, visiblePoints } = view;\n    55\t    const order = pointOrder(frame.series, visiblePoints, work);\n    56\t    let next: (() => PointIndex | null) | null = null;\n    57\t    let nextOrdinal = -1;\n    58\t    return {\n    59\t      caption, headers: [withUnit(frame.xLabel, frame.xUnit), labels.series, withUnit(frame.yLabel, frame.yUnit)],\n    60\t      rowCount: order.count, pageSize: PAGE_SIZE,\n    61\t      row(i) {\n    62\t        if (!Number.isInteger(i) || i < 0 || i >= order.count) return null;\n    63\t        if (i !== nextOrdinal) next = order.cursor(i);\n    64\t        const at = next?.();\n    65\t        nextOrdinal = i + 1;\n    66\t        if (!at) return null;\n    67\t        const series = frame.series[at.series]!;\n    68\t        return [formatters.x(series.x[at.index]!), series.label, formatters.value(at.series, series.y[at.index]!)];\n    69\t      },\n    70\t      pageForX(x) {\n    71\t