{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/core/focus.ts'","aggregated_output":"     1\t/**\n     2\t * The pure part of the interaction layer: what the reader is on, how it moves, how it reads, and what is\n     3\t * drawn over the marks for it. Everything here reads the frame through the view and the lookup (never the\n     4\t * scene), and touches no DOM, so it is tested in Node.\n     5\t *\n     6\t * Decision 0001: the plot is one range input. Its value is the place of the current x among the visible x\n     7\t * slots. By default it reads every visible series at that x (\"all\" mode); after Up or Down it reads one series\n     8\t * (\"single\" mode) and moves with `lookup.step`, which skips that series' missing values as the contract says.\n     9\t */\n    10\timport {\n    11\t  SLOT_NO_ROW,\n    12\t  type AlignedView, type DatumRef, type Formatters, type Layout, type Lookup, type Mark, type Overlay,\n    13\t  type PickTarget, type Rect, type RuleMark, type StepDirection, type View,\n    14\t} from './contracts';\n    15\timport type { Messages } from '../public';\n    16\timport { fill, pointOf } from '../messages';\n    17\t\n    18\texport type Mode = 'all' | 'single';\n    19\ttype Span = readonly [number, number];\n    20\ttype PlotLayout = Extract<Layout, { kind: 'plot' }>;\n    21\t\n    22\t/** The pointer target that shows the same thing as a focused datum. */\n    23\texport function targetOf(ref: DatumRef): PickTarget {\n    24\t  switch (ref.kind) {\n    25\t    case 'aligned': return { kind: 'x', x: ref.x };\n    26\t    case 'point': return { kind: 'point', refs: [ref], count: 1 };\n    27\t    case 'slice': return { kind: 'slice', sliceKey: ref.sliceKey };\n    28\t  }\n    29\t}\n    30\t\n    31\texport function sameRef(a: DatumRef | null, b: DatumRef | null): boolean {\n    32\t  if (a === null || b === null) return a === b;\n    33\t  if (a.kind === 'aligned' && b.kind === 'aligned') return a.seriesKey === b.seriesKey && a.x === b.x;\n    34\t  if (a.kind === 'point' && b.kind === 'point') return a.seriesKey === b.seriesKey && a.row === b.row && a.x === b.x;\n    35\t  if (a.kind === 'slice' && b.kind === 'slice') return a.sliceKey === b.sliceKey;\n    36\t  return false;\n    37\t}\n    38\t\n    39\tfunction lowerBound(values: ArrayLike<number>, value: number, start: number, end: number): number {\n    40\t  while (start < end) {\n    41\t    const mid = (start + end) >>> 1;\n    42\t    if (values[mid]! < value) start = mid + 1;\n    43\t    else end = mid;\n    44\t  }\n    45\t  return start;\n    46\t}\n    47\t\n    48\t/** Matches lookup's page size (spec A2 \"Page keys\"): a tenth of the visible positions, at least one. */\n    49\texport function pageDistance(count: number): number {\n    50\t  return Math.max(1, Math.floor(count / 10));\n    51\t}\n    52\t\n    53\t/** Series a reader can land on: visible and drawable. */\n    54\texport function readableSeries(view: AlignedView): number[] {\n    55\t  return view.frame.series.flatMap((s, i) => view.visible[i] && s.drawable ? [i] : []);\n    56\t}\n    57\t\n    58\t/**\n    59\t * In \"all\" mode the reader moves over x slots. A slot is skipped only when no readable series has an\n    60\t * observation there (the x exists for a hidden series alone); a slot where a series has no data has a place\n    61\t * and is read as \"No data\" (spec F2), so an outage can be reached.\n    62\t */\n    63\tfunction occupied(view: AlignedView, series: readonly number[], i: number): boolean {\n    64\t  for (const s of series) if (view.frame.series[s]!.slot[i] !== SLOT_NO_ROW) return true;\n    65\t  return false;\n    66\t}\n    67\t\n    68\t/** The x position \"all\" mode moves to, or null when there is nowhere to go in that direction. */\n    69\texport function stepAcross(view: AlignedView, x: number | null, direction: StepDirection): number | null {\n    70\t  const { start, end } = view.visibleSlots;\n    71\t  const positions = view.frame.x.values;\n    72\t  const series = readableSeries(view);\n    73\t  if (start >= end || series.length === 0) return null;\n    74\t  const seek = (from: number, delta: 1 | -1, lo = start, hi = end): number => {\n    75\t    for (let i = from; i >= lo && i < hi; i += delta) if (occupied(view, series, i)) return i;\n    76\t    return -1;\n    77\t  };\n    78\t  let at = x === null ? -1 : lowerBound(positions, x, start, end);\n    79\t  if (at >= 0 && (at >= end || positions[at] !== x)) at = -1;\n    80\t  let to = -1;\n    81\t  if (at < 0) {\n    82\t    to = direction === 'last' ? seek(end - 1, -1) : seek(start, 1);\n    83\t  } else {\n    84\t    const page = pageDistance(end - start);\n    85\t    switch (direction) {\n    86\t      case 'next': to = seek(at + 1, 1); break;\n    87\t      case 'previous': to = seek(at - 1, -1); break;\n    88\t      case 'first': to = seek(start, 1); break;\n    89\t      case 'last': to = seek(end - 1, -1); break;\n    90\t      case 'page-next': {\n    91\t        const target = Math.min(end - 1, at + page);\n    92\t        to = seek(target, 1);\n    93\t        if (to < 0) to = seek(target - 1, -1, at + 1);\n    94\t        break;\n    95\t      }\n    96\t      case 'page-previous': {\n    97\t        const target = Math.max(start, at - page);\n    98\t        to = seek(target, -1);\n    99\t        if (to < 0) to = seek(target + 1, 1, start, at);\n   100\t        break;\n   101\t      }\n   102\t      default: return null;\n   103\t    }\n   104\t    if (to === at) return null;\n   105\t  }\n   106\t  return to < 0 ? null : positions[to]!;\n   107\t}\n   108\t\n   109\t/** The refs of every readable series at x, in series order. */\n   110\texport function refsAt(view: AlignedView, x: number): DatumRef[] {\n   111\t  return readableSeries(view).map(s => ({ kind: 'aligned', seriesKey: view.frame.series[s]!.key, x }) as const);\n   112\t}\n   113\t\n   114\t/**\n   115\t * The position sentence of the `pointOf` message (\"Point {index} of {count}.\"), so \"all\" mode can end with\n   116\t * the same words a translation gives the single-series text. When the template has no separate sentence for\n   117\t * it, the whole template is used with empty series, x and value.\n   118\t */\n   119\texport function positionText(messages: Messages, formatters: Formatters, ordinal: number, count: number): string {\n   120\t  const values = { index: formatters.count(ordinal + 1), count: formatters.count(count), series: '', x: '', value: '' };\n   121\t  const sentences = messages.pointOf.match(/[^.!?。！？]+[.!?。！？]*|[.!?。！？]+/gu) ?? [];\n   122\t  const own = sentences.filter(part => /\\{(?:index|count)\\}/.test(part));\n   123\t  const rest = sentences.filter(part => !/\\{(?:index|count)\\}/.test(part));\n   124\t  if (own.length && rest.length) return fill(own.join('').trim(), values);\n   125\t  return fill(messages.pointOf, values).trim();\n   126\t}\n   127\t\n   128\t/** Value text of the proxy (decision 0001): what the reader is on, ending with its place. */\n   129\texport function valueText(\n   130\t  view: View, lookup: Lookup, focus: DatumRef, mode: Mode, formatters: Formatters, messages: Messages,\n   131\t): string | null {\n   132\t  const ordinal = lookup.ordinal(focus);\n   133\t  if (ordinal < 0) return null;\n   134\t  const position = positionText(messages, formatters, ordinal, lookup.count);\n   135\t  if (view.kind === 'donut') {\n   136\t    const datum = lookup.datum(focus);\n   137\t    if (!datum) return null;\n   138\t    const share = datum.percent === null || datum.percent === datum.value ? '' : ` (${datum.percent})`;\n   139\t    return `${datum.seriesLabel}: ${datum.value}${share}. ${position}`;\n   140\t  }\n   141\t  if (view.kind !== 'scatter' && mode === 'all' && focus.kind === 'aligned') {\n   142\t    const rows = refsAt(view, focus.x).flatMap(ref => {\n   143\t      const datum = lookup.datum(ref);\n   144\t      return datum ? [`${datum.seriesLabel} ${datum.value}`] : [];\n   145\t    });\n   146\t    if (!rows.length) return null;\n   147\t    return `${formatters.x(focus.x)}: ${rows.join('; ')}. ${position}`;\n   148\t  }\n   149\t  return pointOf(lookup, focus, formatters, messages);\n   150\t}\n   151\t\n   152\t// ── overlay ─────────────────────────────────────────────────────────────────────────────────────────\n   153\t\n   154\texport interface OverlayInput {\n   155\t  readonly view: View;\n   156\t  readonly layout: Layout;\n   157\t  readonly lookup: Lookup;\n   158\t  /** What is shown (pointer or keyboard). */\n   159\t  readonly target: PickTarget | null;\n   160\t  /** The keyboard's datum, when the proxy has focus and is focus-visible: it gets the focus ring. */\n   161\t  readonly ring: DatumRef | null;\n   162\t  /** In single mode only the focused series is highlighted. */\n   163\t  readonly only: DatumRef | null;\n   164\t}\n   165\t\n   166\tconst HALO = 13;\n   167\tconst MARKER = 9;\n   168\tconst RING_GAP = 4;\n   169\t\n   170\tfunction rule(x1: number, y1: number, x2: number, y2: number, name: 'axis' | 'focus' | 'text', width: number): RuleMark {\n   171\t  return { type: 'rule', x1, y1, x2, y2, stroke: { kind: 'token', name }, strokeWidth: width, dash: null, role: 'cursor' };\n   172\t}\n   173\t\n   174\tfunction outline(box: Rect, gap: number, name: 'focus' | 'text', width: number): RuleMark[] {\n   175\t  const x0 = box.x - gap, y0 = box.y - gap, x1 = box.x + box.width + gap, y1 = box.y + box.height + gap;\n   176\t  return [rule(x0, y0, x1, y0, name, width), rule(x1, y0, x1, y1, name, width), rule(x1, y1, x0, y1, name, width), rule(x0, y1, x0, y0, name, width)];\n   177\t}\n   178\t\n   179\tfunction seriesIndex(view: View, ref: DatumRef): number {\n   180\t  if (view.kind === 'donut') return -1;\n   181\t  if (ref.kind === 'slice') return -1;\n   182\t  return view.frame.series.findIndex(s => s.key === ref.seriesKey);\n   183\t}\n   184\t\n   185\t/** Cursor rule, highlighted points or bar and slice outlines, and the keyboard focus ring (contracts: Overlay). */\n   186\texport function buildOverlay(input: OverlayInput): Overlay | null {\n   187\t  const { view, layout, lookup, target, ring, only } = input;\n   188\t  if (layout.kind !== 'plot' || (target === null && ring === null)) return null;\n   189\t  const plot = layout.plot;\n   190\t  const clipped: Mark[] = [];\n   191\t  const unclipped: Mark[] = [];\n   192\t  const projection = layout.projection;\n   193\t\n   194\t  if (target?.kind === 'x' && view.kind !== 'donut' && view.kind !== 'scatter') {\n   195\t    const refs = only ? [only] : refsAt(view, target.x);\n   196\t    const scale = projection.kind === 'xy' ? projection.x : projection.kind === 'bands' ? projection.band : null;\n   197\t    if (scale) {\n   198\t      const at = scale.type === 'band' ? scale.center(target.x) : scale.map(target.x);\n   199\t      const across = projection.kind === 'bands' && projection.horizontal;\n   200\t      if (Number.isFinite(at)) {\n   201\t        clipped.push(across ? rule(plot.x, at, plot.x + plot.width, at, 'axis', 1) : rule(at, plot.y, at, plot.y + plot.height, 'axis', 1));\n   202\t      }\n   203\t    }\n   204\t    for (const ref of refs) {\n   205\t      const box = lookup.anchor(ref);\n   206\t      if (!box) continue;\n   207\t      if (projection.kind === 'bands') {\n   208\t        unclipped.push(...outline(box, 1, 'text', 2));\n   209\t      } else {\n   210\t        const s = seriesIndex(view, ref);\n   211\t        const cue = view.cues[s];\n   212\t        const xy = Float32Array.of(box.x + box.width / 2, box.y + box.height / 2);\n   213\t        const shape = cue?.marker ?? 'circle';\n   214\t        clipped.push({ type: 'points', series: s, xy, shape, size: HALO, fill: { kind: 'token', name: 'background' } });\n   215\t        clipped.push({ type: 'points', series: s, xy, shape, size: MARKE