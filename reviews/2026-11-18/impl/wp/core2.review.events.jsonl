 label.appendChild(labelText);\n    79\t  form.append(label, field);\n    80\t  pager.append(previous, status, next, form);\n    81\t  element.append(scroll, pager);\n    82\t\n    83\t  let model: TableModel | null = null;\n    84\t  let texts: TableTexts | null = null;\n    85\t  let page = 0;\n    86\t  let shownSignature = '';\n    87\t\n    88\t  const pages = () => model ? Math.max(1, Math.ceil(model.rowCount / model.pageSize)) : 1;\n    89\t\n    90\t  function render(): void {\n    91\t    if (!model || !texts) return;\n    92\t    const count = pages();\n    93\t    page = Math.max(0, Math.min(page, count - 1));\n    94\t    const headers = model.headers.join('\\u0000');\n    95\t    if (caption.textContent !== model.caption) caption.textContent = model.caption;\n    96\t    if (head.dataset.headers !== headers) {\n    97\t      const row = doc.createElement('tr');\n    98\t      for (const text of model.headers) {\n    99\t        const th = doc.createElement('th');\n   100\t        th.scope = 'col';\n   101\t        th.textContent = text;\n   102\t        row.appendChild(th);\n   103\t      }\n   104\t      head.replaceChildren(row);\n   105\t      head.dataset.headers = headers;\n   106\t    }\n   107\t    const first = page * model.pageSize;\n   108\t    const last = Math.min(model.rowCount, first + model.pageSize);\n   109\t    const rows: HTMLTableRowElement[] = [];\n   110\t    for (let i = first; i < last; i++) {\n   111\t      const cells = model.row(i);\n   112\t      if (!cells) continue;\n   113\t      const tr = doc.createElement('tr');\n   114\t      cells.forEach((text, k) => {\n   115\t        const cell = doc.createElement(k === 0 ? 'th' : 'td');\n   116\t        if (k === 0) (cell as HTMLTableCellElement).scope = 'row';\n   117\t        cell.textContent = text;\n   118\t        tr.appendChild(cell);\n   119\t      });\n   120\t      rows.push(tr);\n   121\t    }\n   122\t    body.replaceChildren(...rows);\n   123\t    pager.hidden = count 