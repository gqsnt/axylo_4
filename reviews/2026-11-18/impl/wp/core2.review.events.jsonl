ncation. */\n609-  readonly count: number;\n610-  /** Stack total with \"incomplete\" where it applies, already formatted; null when the chart does not stack. */\n611-  readonly total: string | null;\n612-}\n613-\n614-export type StepDirection = 'next' | 'previous' | 'first' | 'last' | 'series-next' | 'series-previous' | 'page-next' | 'page-previous';\n615-\n616-/**\n617- * Exact answers from the frame for one view and projection, independent of how the scene was simplified.\n618- * Built once per (view, layout); cheap to build: binary search over x for aligned frames, a grid index for scatter.\n619- */\n620:export interface Lookup {\n621-  /** What is under a pixel of the plot container, or null. */\n622-  pick(px: number, py: number): PickTarget | null;\n623-  tooltip(target: PickTarget): TooltipModel;\n624-  /** The datum to focus when the keyboard takes over from a pointer target. */\n625-  primary(target: PickTarget): DatumRef | null;\n626-  datum(ref: DatumRef): DatumText | null;\n627-  /** Where the datum is drawn, for the cursor and focus ring; null if it is not visible. */\n628-  anchor(ref: DatumRef): Rect | null;\n629-  /**\n630-   * Position for \"point 4 of 120\" (spec A3). Aligned charts: `count` is the number of visible x slots and\n631-   * `ordinal` the zero-based place of the datum's x among them, whatever its series and whether or not it\n632-   * holds a value (a \"No data\" slot has a place too). Scatter: place among all visible points in x then y\n633-   * order. Donut: slice order. -1 only when the datum is not in the current view.\n634-   */\n635-  readonly count: number;\n636-  ordinal(ref: DatumRef): number;\n637-  /** Keyboard order per chart type (spec 3.6). `from` null starts at the first datum. Skips hidden series. */\n638-  step(from: DatumRef | null, direction: StepDirection): DatumRef | null;\n639-  /**\n640-   * Where focus should be after the data or the view changed. A datum is \"there\" only if its series is\n641-   * visible and