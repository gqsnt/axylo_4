{"type":"item.completed","item":{"id":"item_64","type":"command_execution","command":"/bin/bash -lc \"git show 9f9eeef:packages/axylo/src/core/focus.ts | nl -ba | sed -n '1,260p'\"","aggregated_output":"     1\t/**\n     2\t * The pure part of the interaction layer: what the reader is on, how it moves, how it reads, and what is\n     3\t * drawn over the marks for it. Everything here reads the frame through the view and the lookup (never the\n     4\t * scene), and touches no DOM, so it is tested in Node.\n     5\t *\n     6\t * Decision 0001: the plot is one range input. Its value is the place of the current x among the visible x\n     7\t * slots. By default it reads every visible series at that x (\"all\" mode); after Up or Down it reads one series\n     8\t * (\"single\" mode) and moves with `lookup.step`, which skips that series' missing values as the contract says.\n     9\t */\n    10\timport {\n    11\t  type AlignedView, type DatumRef, type DatumText, type Formatters, type Layout, type Lookup, type Mark, type Overlay,\n    12\t  type PickTarget, type Rect, type RuleMark, type ScatterView, type SlotState, type StepDirection, type TooltipModel, type View,\n    13\t} from './contracts';\n    14\timport { donutGeometry } from '../view/donut-geometry';\n    15\timport type { Messages } from '../public';\n    16\timport { fill, pointOf } from '../messages';\n    17\timport { lowerBound } from '../lookup/search';\n    18\timport { slotText } from '../lookup/text';\n    19\t\n    20\texport type Mode = 'all' | 'single';\n    21\ttype Span = readonly [number, number];\n    22\ttype PlotLayout = Extract<Layout, { kind: 'plot' }>;\n    23\t\n    24\t/** The pointer target that shows the same thing as a focused datum. */\n    25\texport function targetOf(ref: DatumRef): PickTarget {\n    26\t  switch (ref.kind) {\n    27\t    case 'aligned': return { kind: 'x', x: ref.x };\n    28\t    case 'point': return { kind: 'point', refs: [ref], count: 1 };\n    29\t    case 'slice': return { kind: 'slice', sliceKey: ref.sliceKey };\n    30\t  }\n    31\t}\n    32\t\n    33\texport function sameRef(a: DatumRef | null, b: DatumRef | null): boolean {\n    34\t  if (a === null || b === null) return a === b;\n    35\t  if (a.kind === 'aligned' && b.kind === 'aligned') return a.seriesKey === b.seriesKey && a.x === b.x;\n    36\t  if (a.kind === 'point' && b.kind === 'point') return a.seriesKey === b.seriesKey && a.row === b.row && a.x === b.x;\n    37\t  if (a.kind === 'slice' && b.kind === 'slice') return a.sliceKey === b.sliceKey;\n    38\t  return false;\n    39\t}\n    40\t\n    41\t/** Matches lookup's page size (spec A2 \"Page keys\"): a tenth of the visible positions, at least one. */\n    42\texport function pageDistance(count: number): number {\n    43\t  return Math.max(1, Math.floor(count / 10));\n    44\t}\n    45\t\n    46\t/** Series a reader can land on: visible and drawable. */\n    47\texport function readableSeries(view: AlignedView): number[] {\n    48\t  return view.frame.series.flatMap((s, i) => view.visible[i] && s.drawable ? [i] : []);\n    49\t}\n    50\t\n    51\t/**\n    52\t * In \"all\" mode the reader moves over x slots, every visible slot a place of its own, as the lookup counts\n    53\t * them (\"point 2 of 3\") and as the pointer reaches them: a slot where a series has no data reads \"No data\"\n    54\t * (spec F2), one only a hidden series observes reads \"No observation\" (review 2, finding 7).\n    55\t */\n    56\tfunction occupied(_view: AlignedView, _series: readonly number[], _i: number): boolean {\n    57\t  return true;\n    58\t}\n    59\t\n    60\t/** The x position \"all\" mode moves to, or null when there is nowhere to go in that direction. */\n    61\texport function stepAcross(view: AlignedView, x: number | null, direction: StepDirection): number | null {\n    62\t  const { start, end } = view.visibleSlots;\n    63\t  const positions = view.frame.x.values;\n    64\t  const series = readableSeries(view);\n    65\t  if (start >= end || series.length === 0) return null;\n    66\t  const seek = (from: number, delta: 1 | -1, lo = start, hi = end): number => {\n    67\t    for (let i = from; i >= lo && i < hi; i += delta) if (occupied(view, series, i)) return i;\n    68\t    return -1;\n    69\t  };\n    70\t  let at = x === null ? -1 : lowerBound(positions, x, start, end);\n    71\t  if (at >= 0 && (at >= end || positions[at] !== x)) at = -1;\n    72\t  let to = -1;\n    73\t  if (at < 0) {\n    74\t    to = direction === 'last' ? seek(end - 1, -1) : seek(start, 1);\n    75\t  } else {\n    76\t    const page = pageDistance(end - start);\n    77\t    switch (direction) {\n    78\t      case 'next': to = seek(at + 1, 1); break;\n    79\t      case 'previous': to = seek(at - 1, -1); break;\n    80\t      case 'first': to = seek(start, 1); break;\n    81\t      case 'last': to = seek(end - 1, -1); break;\n    82\t      case 'page-next': {\n    83\t        const target = Math.min(end - 1, at + page);\n    84\t        to = seek(target, 1);\n    85\t        if (to < 0) to = seek(target - 1, -1, at + 1);\n    86\t        break;\n    87\t      }\n    88\t      case 'page-previous': {\n    89\t        const target = Math.max(start, at - page);\n    90\t        to = seek(target, -1);\n    91\t        if (to < 0) to = seek(target + 1, 1, start, at);\n    92\t        break;\n    93\t      }\n    94\t      default: return null;\n    95\t    }\n    96\t    if (to === at) return null;\n    97\t  }\n    98\t  return to < 0 ? null : positions[to]!;\n    99\t}\n   100\t\n   101\t/** The refs of every readable series at x, in series order. */\n   102\texport function refsAt(view: AlignedView, x: number): DatumRef[] {\n   103\t  return readableSeries(view).map(s => ({ kind: 'aligned', seriesKey: view.frame.series[s]!.key, x }) as const);\n   104\t}\n   105\t\n   106\t/** The place of a datum among the visible ones, as the `position` message says it (\"Point 4 of 10\"). */\n   107\texport function positionText(messages: Messages, formatters: Formatters, ordinal: number, count: number): string {\n   108\t  return fill(messages.position, { index: formatters.count(ordinal + 1), count: formatters.count(count) });\n   109\t}\n   110\t\n   111\t/**\n   112\t * Value text of the proxy (decision 0001): what the reader is on, ending with its place. \"All\" mode reads\n   113\t * every series at the x with `pointAll` and `seriesValue`; one series (single mode, scatter) uses `pointOf`.\n   114\t */\n   115\texport function valueText(\n   116\t  view: View, lookup: Lookup, focus: DatumRef, mode: Mode, formatters: Formatters, messages: Messages,\n   117\t): string | null {\n   118\t  const ordinal = lookup.ordinal(focus);\n   119\t  if (ordinal < 0) return null;\n   120\t  const position = positionText(messages, formatters, ordinal, lookup.count);\n   121\t  if (view.kind === 'donut') {\n   122\t    const datum = lookup.datum(focus);\n   123\t    if (!datum) return null;\n   124\t    const share = datum.percent === null || datum.percent === datum.value ? '' : ` (${datum.percent})`;\n   125\t    return fill(messages.pointAll, {\n   126\t      x: datum.seriesLabel, values: datum.value + share, position,\n   127\t    });\n   128\t  }\n   129\t  if (view.kind !== 'scatter' && mode === 'all' && focus.kind === 'aligned') {\n   130\t    // What the tooltip shows at this x, the stack total included, said once (spec I1, F10).\n   131\t    // Every series at x, the ones past the tooltip's eight included, as the tooltip writes its rows: an\n   132\t    // incomplete stack is said once, on the total, not again on each series (review C2-7).\n   133\t    const model = lookup.tooltip({ kind: 'x', x: focus.x });\n   134\t    const rows = alignedRows(view, formatters, focus.x, model).map(r => fill(messages.seriesValue, { series: r.seriesLabel, value: r.value }));\n   135\t    if (model.total !== null) rows.push(fill(messages.seriesValue, { series: messages.total, value: model.total }));\n   136\t    if (!rows.length) return null;\n   137\t    return fill(messages.pointAll, { x: formatters.x(focus.x), values: rows.join('; '), position });\n   138\t  }\n   139\t  return pointOf(lookup, focus, formatters, messages);\n   140\t}\n   141\t\n   142\t/**\n   143\t * Every readable series' row at x, in series order: the tooltip's own rows first (they are the first of\n   144\t * them), then the rest written the same way, unqualified, as the tooltip writes a row. Used where every\n   145\t * series is read (the keyboard's \"all\" reading, a pinned tooltip's further rows).\n   146\t */\n   147\texport function alignedRows(view: AlignedView, formatters: Formatters, x: number, model: TooltipModel): DatumText[] {\n   148\t  const rows: DatumText[] = [...model.rows];\n   149\t  const shown = new Set(model.rows.map(r => r.seriesIndex));\n   150\t  const positions = view.frame.x.values;\n   151\t  const i = lowerBound(positions, x);\n   152\t  if (i >= positions.length || positions[i] !== x) return rows;\n   153\t  const title = formatters.x(x);\n   154\t  for (const s of readableSeries(view)) {\n   155\t    if (shown.has(s)) continue;\n   156\t    const series = view.frame.series[s]!;\n   157\t    const state = series.slot[i] as SlotState;\n   158\t    rows.push({\n   159\t      ref: { kind: 'aligned', seriesKey: series.key, x }, seriesIndex: s, seriesLabel: series.label, x: title,\n   160\t      value: slotText(formatters, s, series.y[i]!, state), state, percent: null, row: series.row?.[i] ?? i,\n   161\t    });\n   162\t  }\n   163\t  return rows;\n   164\t}\n   165\t\n   166\t/**\n   167\t * What a reading says about the datum itself, for deciding whether the focused text must be rewritten\n   168\t * (decision 0004 part 2): its identity, its values and the templates that word them, never its place in\n   169\t * the range. Compared as data, not by taking one translated sentence out of another (review finding 14).\n   170\t */\n   171\texport function datumReading(view: View, lookup: Lookup, ref: DatumRef, mode: Mode, formatters: Formatters, messages: Messages): string | null {\n   172\t  if (lookup.ordinal(ref) < 0) return null;\n   173\t  const words = [messages.pointAll, messages.pointOf, messages.seriesValue, messages.total];\n   174\t  // An aligned datum's x by its raw key: a category's name (not its index, which a sliding window renumbers;\n   175\t  // review finding 10), and not its formatted text, which two categories can share (review R10).\n   176\t  const x = ref.kind === 'aligned' && view.kind !== 'scatter' && view.kind !== 'donut'\n   177\t    ? view.frame.x.categories?.[ref.x] ?? ref.x : null;\n   178\t  if (view.kind !== 'scatter' && view.kind !== 'donut' && mode === 'all' && ref.kind === 'aligned') {\n   179\t    const model = lookup.tooltip({ kind: 'x', x: ref.x });\n   180\t    const rows = alignedRows(view, formatters, ref.x, model).map(r => [r.seriesIndex, r.seriesLabel, r.value]);\n   181\t    return JSON.stringify(['all', ref.seriesKey, x, rows, model.total, words]);\n   182\t  }\n   183\t  const datum = lookup.datum(ref);\n   184\t  if (!datum) return null;\n   185\t  // The datum's identity without its place: an aligned datum by series and raw x, a point by series and\n   186\t  // source row.\n   187\t  const id = ref.kind === 'point' ? [ref.seriesKey, ref.row] : ref.kind === 'aligned' ? [ref.seriesKey, x] : [ref.sliceKey];\n   188\t  return JSON.stringify(['one', ref.kind, id, datum.seriesLabel, datum.x, datum.value, datum.percent, words]);\n   189\t}\n   190\t\n   191\t// ── overlay ─────────────────────────────────────────────────────────────────────────────────────────\n   192\t\n   193\texport interface OverlayInput {\n   194\t  readonly view: View;\n   195\t  readonly layout: Layout;\n   196\t  readonly lookup: Lookup;\n   197\t  /** What is shown (pointer or keyboard). */\n   198\t  readonly target: PickTarget | null;\n   199\t  /** The keyboard's datum, when the proxy has 