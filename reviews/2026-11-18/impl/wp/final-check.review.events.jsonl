blockIndex(row));\n    97\t    if (block && (block.present === null ? row % blockSize < block.table.length : (block.present & rowBit(row)) !== 0n)) return block;\n    98\t    return undefined;\n    99\t  }\n   100\t\n   101\t  private reference(field: string, row: number, value: object): void {\n   102\t    let entries = this.references.get(field);\n   103\t    if (!entries) this.references.set(field, entries = new StoreMap());\n   104\t    entries.set(row, value);\n   105\t  }\n   106\t\n   107\t  append(start: number, rows: readonly unknown[]): void {\n   108\t    for (let i = 0; i < rows.length; i++) this.objects.set(start + i, rows[i]);\n   109\t  }\n   110\t\n   111\t  copy(row: number, target: RawRows): boolean {\n   112\t    const block = this.column(row);\n   113\t    if (block) {\n   114\t      const index = blockIndex(row);\n   115\t      const archived = target.columns.get(index);\n   116\t      target.columns.set(index, { ...(archived ?? this.own(block)), present: (archived?.present ?? 0n) | rowBit(row) });\n   117\t      target.columnCount++;\n   118\t      for (const [field, entries] of this.references) {\n   119\t        const value = entries.get(row);\n   120\t        if (value !== undefined) target.reference(field, row, value);\n   121\t      }\n   122\t    } else if (this.objects.has(row)) target.objects.set(row, this.objects.get(row));\n   123\t    else return false;\n   124\t    return true;\n   125\t  }\n   126\t\n   127\t  forget(row: number): void {\n   128\t    this.objects.delete(row);\n   129\t    const block = this.column(row);\n   130\t    if (block) {\n   131\t      const index = blockIndex(row);\n   132\t      const present = (block.present ?? fullBlock(block.table.length)) & ~rowBit(row);\n   133\t      if (present) this.columns.set(index, { ...block, present });\n   134\t      else this.columns.delete(index);\n   135\t      this.columnCount--;\n   136\t      for (const entries of this.references.values()) entries.delete(row);\n   137\