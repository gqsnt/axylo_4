annot be read is reported and ignored; zoom never throws (spec 3.5).\n   946\t      // A hint (AX112: a wall-clock window on a wall-clock axis) does not make the window unreadable.\n   947\t      const bad = viewed.found.filter(d => d.field === 'zoom' && d.level !== 'hint');\n   948\t      if (bad.length) {\n   949\t        deliverRejected(bad, previous.name, previous.options.onDiagnostic);\n   950\t        return;\n   951\t      }\n   952\t      accept(c, viewed, followsLatest(viewed.view, pair), null);\n   953\t      const now = accepted;\n   954\t      if (destroyed || now === null) return;\n   955\t      const view = now.view;\n   956\t      const before = previous.view;\n   957\t      if (view.kind !== 'donut' && before.kind !== 'donut' &&\n   958\t        (view.xDomain[0] !== before.xDomain[0] || view.xDomain[1] !== before.xDomain[1] || (previous.zoom === null) !== (pair === null))) {\n   959\t        emit('zoom', zoomPayload(now));\n   960\t      }\n   961\t    });\n   962\t  }\n   963\t\n   964\t  /** The window shown, in the form `zoom()` reads (positionValue); null when the whole range is shown. */\n   965\t  function zoomPayload(a: Accepted): readonly [XValue, XValue] | null {\n   966\t    const view = a.view;\n   967\t    if (a.zoom === null || view.kind === 'donut') return null;\n   968\t    return [positionValue(a.frame, view.xDomain[0]), positionValue(a.frame, view.xDomain[1])];\n   969\t  }\n   970\t\n   971\t  /** A legend toggle: the series joins or leaves the view's hidden set (spec I2). */\n   972\t  function toggleSeries(key: string): void {\n   973\t    guarded(() => {\n   974\t      const previous = accepted;\n   975\t      if (!previous) return;\n   976\t      const hidden = new Set(previous.hidden);\n   977\t      if (!hidden.delete(key)) hidden.add(key);\n   978\t      const c = viewCandidate(previous, { hidden });\n   979\t      accept(c, viewFor(c, previous), previous.follow, null);\n   980\t    });\n   981\t  }\n   982\t\n   983\t  /** Pause and resume (spec I6). Resume shows the newest held frame. */\n   984\t  function setPaused(next: boolean): void {\n   985\t    if (destroyed || next === paused) return;\n   986\t    paused = next;\n   987\t    if (!next && held) {\n   988\t      const frame = held;\n   989\t      guarded(() => {\n   990\t        const previous = accepted;\n   991\t        if (!previous) return;\n   992\t        let zoomed = previous.zoom;\n   993\t        if (previous.follow && zoomed) zoomed = followLatest(frame.frame, previous.view) ?? zoomed;\n   994\t        let c = viewCandidate(previous, { frame: frame.frame, dataDiagnostics: frame.dataDiagnostics, zoom: zoomed });\n   995\t        let commit: (() => void) | null = null;\n   996\t        const store = previous.store;\n   997\t        if (store && previous.dataOptions.some(d => d.code === 'AX101') && previous.options.strict !== true) {\n   998\t          // A field the earlier data did not have, which the held arrivals bring: the frame is read again with\n   999\t          // the fields as given, and AX101 goes, as for a running append (final review, finding 6).\n  1000\t          const check = new DiagnosticCollector();\n  1001\t          const resolved = store.resolveEncoding(publicOptions(previous.options), check);\n  1002\t          if (!check.inputs().some(d => d.code === 'AX101')) {\n  1003\t            const again: PreparedFrame<Frame> = store.prepareReencode(resolved, nextVersion());\n  1004\t            ends(again.frame, store.frame);\n  1005\t            commit = again.commit;\n  1006\t            c = {\n  1007\t              ...c, resolved, source: resolved, frame: again.frame, dataDiagnostics: again.diagnostics, dataOptions: [],\n  1008\t              optionDiagnostics: previous.optionDiagnostics.filter(d => !DATA_CODES.has(d.code)),\n  1009\t            };\n  1010\t          }\n  1011\t        }\n  1012\t        const viewed = viewFor(c, previous);\n  1320\t      // The summary runs author formatters lazily: i