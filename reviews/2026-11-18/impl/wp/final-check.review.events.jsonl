kFormat?: NumberFormatOption | null;\n    33\t  readonly onError?: ((error: unknown) => void) | null;\n    34\t}\n    35\t\n    36\tconst SIGNIFICANT_FRACTION_DIGITS = 6;\n    37\t/** Intl's limit for fraction digits (ES2023). Smaller values need scientific notation. */\n    38\tconst MAX_INTL_FRACTION_DIGITS = 100;\n    39\t\n    40\t// ───────────────────────────── exact decimals ─────────────────────────────\n    41\t\n    42\t/** A finite non-zero double as the shortest decimal that reads back as it: d.ddd × 10^exponent. */\n    43\tinterface Decimal {\n    44\t  readonly negative: boolean;\n    45\t  /** Significant digits, first one non-zero. */\n    46\t  readonly digits: string;\n    47\t  /** Power of ten of the first digit. */\n    48\t  readonly exponent: number;\n    49\t}\n    50\t\n    51\tfunction toDecimal(v: number): Decimal {\n    52\t  // toExponential() without an argument gives the shortest round-trip digits.\n    53\t  const [mantissa = '0', exp = '0'] = Math.abs(v).toExponential().split('e');\n    54\t  return { negative: v < 0, digits: mantissa.replace('.', ''), exponent: Number(exp) };\n    55\t}\n    56\t\n    57\t/** The decimal × 10^shift as a string Intl formats exactly. */\n    58\tfunction decimalString(d: Decimal, shift = 0): string {\n    59\t  const rest = d.digits.slice(1);\n    60\t  return `${d.negative ? '-' : ''}${d.digits[0]}${rest ? '.' + rest : ''}e${d.exponent + shift}`;\n    61\t}\n    62\t\n    63\t/** Intl.NumberFormat#format for an exact decimal string (typed for numbers only in the ES2022 lib). */\n    64\tfunction formatExact(nf: Intl.NumberFormat, value: string): string {\n    65\t  return (nf.format as unknown as (v: string) => string)(value);\n    66\t}\n    67\t\n    68\t/** Power of ten by which the shown number differs from the stored one: a ratio is shown ×100. */\n    69\tfunction shownShift(scale: ValueScale): number {\n    70\t  return scale === 'ratio' ? 2 : 0;\n    71\t}\n    72\t\n    73\t/** Power of ten