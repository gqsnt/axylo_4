{"type":"item.completed","item":{"id":"item_100","type":"command_execution","command":"/bin/bash -lc \"git show 9f9eeef:packages/axylo/src/data/store-map.ts | nl -ba | sed -n '1,240p'\"","aggregated_output":"     1\t// A preparation only edits its delta. Publishing applies it in insertion order so a\n     2\t// retained-window scan can still stop as soon as it reaches rows it should keep.\n     3\texport class StoreMap<K, V> {\n     4\t  private changes: Map<K, V> | null = null;\n     5\t  private removed: Set<K> | null = null;\n     6\t  private count = 0;\n     7\t\n     8\t  constructor(private readonly data = new Map<K, V>()) {}\n     9\t\n    10\t  fork(): StoreMap<K, V> {\n    11\t    const draft = new StoreMap(this.data);\n    12\t    draft.changes = new Map();\n    13\t    draft.removed = new Set();\n    14\t    draft.count = this.data.size;\n    15\t    return draft;\n    16\t  }\n    17\t\n    18\t  commit(): void {\n    19\t    if (!this.changes) return;\n    20\t    for (const key of this.removed!) this.data.delete(key);\n    21\t    for (const [key, value] of this.changes) this.data.set(key, value);\n    22\t    this.changes = this.removed = null;\n    23\t  }\n    24\t\n    25\t  get size(): number { return this.changes ? this.count : this.data.size; }\n    26\t\n    27\t  get(key: K): V | undefined {\n    28\t    const value = this.changes?.get(key);\n    29\t    if (value !== undefined || this.changes?.has(key) || this.removed?.has(key)) return value;\n    30\t    return this.data.get(key);\n    31\t  }\n    32\t\n    33\t  has(key: K): boolean {\n    34\t    return Boolean(this.changes?.has(key) || !this.removed?.has(key) && this.data.has(key));\n    35\t  }\n    36\t\n    37\t  set(key: K, value: V): void {\n    38\t    if (!this.changes) {\n    39\t      this.data.set(key, value);\n    40\t      return;\n    41\t    }\n    42\t    if (!this.has(key)) this.count++;\n    43\t    this.changes.set(key, value);\n    44\t  }\n    45\t\n    46\t  delete(key: K): void {\n    47\t    if (!this.changes) {\n    48\t      this.data.delete(key);\n    49\t      return;\n    50\t    }\n    51\t    if (!this.has(key)) return;\n    52\t    this.count--;\n    53\t    this.changes.delete(key);\n    54\t    if (this.data.has(key)) this.removed!.add(key);\n    55\t  }\n    56\t\n    57\t  *[Symbol.iterator](): IterableIterator<[K, V]> {\n    58\t    if (!this.changes) {\n    59\t      yield* this.data;\n    60\t      return;\n    61\t    }\n    62\t    for (const [key, value] of this.data) {\n    63\t      if (this.removed!.has(key)) continue;\n    64\t      yield [key, this.changes.has(key) ? this.changes.get(key)! : value];\n    65\t    }\n    66\t    for (const [key, value] of this.changes) {\n    67\t      if (!this.data.has(key) || this.removed!.has(key)) yield [key, value];\n    68\t    }\n    69\t  }\n    70\t\n    71\t  *keys(): IterableIterator<K> {\n    72\t    if (!this.changes) yield* this.data.keys();\n    73\t    else for (const [key] of this) yield key;\n    74\t  }\n    75\t}\n","exit_code":0,"status":"completed"}}
