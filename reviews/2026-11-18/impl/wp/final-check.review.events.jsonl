, result.positions, keep, firstPosition(result, keep), retained);\n   412\t        if (removed.length === 0) break;\n   413\t        for (const row of removed) evicted.push(row);\n   414\t        current = new DiagnosticCollector();\n   415\t        table = retained.table();\n   416\t        const encoded = retargetOptions(this.encoding, table, current);\n   417\t        result = this.build(encoded, this.environment, current, version);\n   418\t      }\n   419\t    }\n   420\t    retained.compactColumns();\n   421\t    const ordered = ordering.inputs();\n   422\t    const diagnostics = [...current.inputs(), ...ordered];\n   423\t    retained.resetPositions(table, result.positions);\n   424\t    return this.prepare(base, result.frame, retained, diagnostics.length ? null : this.open(result),\n   425\t      diagnostics, [...call.inputs(), ...ordered], evicted);\n   426\t  }\n   427\t\n   428\t  private extendAppend(base: F, rows: readonly unknown[], version: FrameVersion, keep: number | undefined): PreparedFrame<F> | null {\n   429\t    // Implicit string parsing and diagnostics can change when old rows leave. Reuse old values only when\n   430\t    // both partitions have unambiguous clean values and the same x interpretation.\n   431\t    if (!this.storage || this.encoding.values[0]?.parse || this.encoding.series !== null) return null;\n   432\t    const table = { ...rowsTable(rows), rowIndex: (row: number) => this.rows.next + row };\n   433\t    const diagnostics = new DiagnosticCollector();\n   434\t    const resolved = retargetOptions(this.encoding, table, diagnostics);\n   435\t    if (!resolved.valid) return null;\n   436\t    const result = this.build(resolved, this.environment, diagnostics, version);\n   437\t    if (diagnostics.inputs().length) return null;\n   438\t    const retained = this.rows.fork();\n   439\t    const evicted: number[] = [];\n   440\t    retained.onForget = row => evicted.push(row);\n   441\t    retained.append(rows);\n   442\t    const extension = this.storage.extend(result, retained, this.rows.next, keep);\n   443\t    retained.onForget = undefined;\n   444\t    if (!extension) return null;\n   445\t    retained.compactColumns();\n   446\t    return this.prepare(base, result.frame, retained, extension, [], [], evicted);\n   447\t  }\n   448\t\n   449\t  reencode(options: ResolvedOptions, version: FrameVersion): F {\n   450\t    const prepared = this.prepareReencode(options, version);\n   451\t    prepared.commit();\n   452\t    return prepared.frame;\n   453\t  }\n   454\t\n   455\t  prepareReencode(options: ResolvedOptions, version: FrameVersion): PreparedFrame<F> {\n   456\t    return this.prepareEncoding(this.rows.fork(), options, version, new DiagnosticCollector());\n   457\t  }\n   458\t\n   459\t  replace(data: unknown, options: ResolvedOptions, version: FrameVersion): F {\n   460\t    const prepared = this.prepareReplace(data, options, version);\n   461\t    prepared.commit();\n   462\t    return prepared.frame;\n   463\t  }\n   464\t\n   465\t  prepareReplace(data: unknown, options: ResolvedOptions, version: FrameVersion): PreparedFrame<F> {\n   466\t    const call = new DiagnosticCollector();\n   467\t    const replacement = resolveTable(data, call);\n   468\t    this.caller.add(replacement.table);\n   469\t    return this.prepareEncoding(new StreamRows(replacement.table), options, version, call, replacement);\n   470\t  }\n   471\t\n","exit_code":0,"status":"completed"}}
