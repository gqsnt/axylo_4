t h = containerFor(112);\n   792\t    const unstripped = plotHeightAt(h);\n   793\t    const keep = run(h, unstripped - 80);\n   794\t    expect(keep.mode).toBe('strip');\n   795\t    expect(keep.layout.kind).toBe('plot');\n   796\t    if (keep.layout.kind === 'plot') expect(keep.layout.plot.height).toBeCloseTo(80, 6);\n   797\t    const drop = run(h, unstripped - 79.9);\n   798\t    expect(drop.mode).toBe('none');\n   799\t    expect(drop.layout.kind).toBe('plot');\n   800\t  });\n   801\t\n   802\t  it('an estimate that is too low (no measured height): the strip that made the plot too small is retried as \"none\"', () => {\n   803\t    // 135 px unstripped: the estimate (two 24 px lines) would leave 87 px, the real strip of 98 px leaves 37.\n   804\t    const h = containerFor(135);\n   805\t    const r = record('line', { title: 'S', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' }, { container: { width: 600, height: h }, strip: 98, stripUnknown: true });\n   806\t    r.frames();\n   807\t    expect(r.layout!.kind).toBe('plot');\n   808\t    expect((r.prepared.at(-1) as unknown as { readoutMode?: string }).readoutMode).toBe('none');\n   809\t    // And it stays there on later frames.\n   810\t    r.controller.invalidate.resize();\n   811\t    r.frames();\n   812\t    expect(r.layout!.kind).toBe('plot');\n","exit_code":0,"status":"completed"}}
