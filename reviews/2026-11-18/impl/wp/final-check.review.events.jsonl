{"type":"item.completed","item":{"id":"item_121","type":"command_execution","command":"/bin/bash -lc \"git show 9f9eeef:packages/axylo/test/core/host.ts | nl -ba | sed -n '1,320p'\"","aggregated_output":"     1\t/**\n     2\t * A recording host for driving the chart controller in Node (the method of the core review): a manual\n     3\t * animation-frame queue, and substitutes for the figure, the renderers and the interaction layer that keep\n     4\t * what they were given. Sizes come from a small model of the figure's CSS: the plot gets what the caption\n     5\t * and the controls leave of the container.\n     6\t */\n     7\timport type { Layout, PlacedText, Scene, TextStyle } from '../../src/core/contracts';\n     8\timport { createController, type ChartKind, type Controller, type Host, type Size } from '../../src/core/controller';\n     9\timport type { FigureModel } from '../../src/dom/figure';\n    10\timport type { Committed, ControlsState } from '../../src/dom/interaction';\n    11\timport { TOKEN_BINDINGS } from '../../src/theme';\n    12\t\n    13\texport interface Recording {\n    14\t  readonly host: Host;\n    15\t  readonly controller: Controller;\n    16\t  /** Runs every queued animation frame (and those they queue), at most `limit` rounds. */\n    17\t  frames(limit?: number): number;\n    18\t  readonly pending: number;\n    19\t  draws: Scene[];\n    20\t  texts: (readonly PlacedText[])[];\n    21\t  models: FigureModel[];\n    22\t  announcements: string[];\n    23\t  prepared: ControlsState[];\n    24\t  committed: Committed | null;\n    25\t  commits: number;\n    26\t  clears: number;\n    27\t  themeCalls: { keys: readonly string[]; colors: Record<string, string> }[];\n    28\t  printed: string[];\n    29\t  disposed: number;\n    30\t  /** Host writes (figure, renderer, text, interaction) made after `dispose`. */\n    31\t  writesAfterDispose: number;\n    32\t  /** The last surfaces(visible) call: false while the error revision hides marks and text. */\n    33\t  surfaces: boolean;\n    34\t  /** The container (CSS px). The plot's height is what the caption and the controls leave. */\n    35\t  container: { width: number; height: number } | null;\n    36\t  /** Height of one caption line and of the controls row in the model of the figure. */\n    37\t  readonly lineHeight: number;\n    38\t  ids: Record<string, string>;\n    39\t  readonly layout: Layout | null;\n    40\t}\n    41\t\n    42\texport interface HostOptions {\n    43\t  readonly container?: { width: number; height: number } | null;\n    44\t  readonly console?: boolean;\n    45\t  readonly timeZone?: string;\n    46\t  readonly locale?: string;\n    47\t  readonly textWidth?: Host['measurer']['width'];\n    48\t  readonly captionLineHeight?: number;\n    49\t  /** The page's `lang` (A10); 'en' when not given. */\n    50\t  readonly pageLang?: string;\n    51\t  /** The target element's own id (an untitled chart's name in diagnostics). */\n    52\t  readonly targetId?: string;\n    53\t  /**\n    54\t   * The readout strip's real height (two line heights of its own font). When given, a reserved strip takes\n    55\t   * that much from the plot's column, as the DOM does, and the host reports the strip's height to the chart.\n    56\t   * A function: the height the page's CSS gives it now (responsive CSS can change it with the size).\n    57\t   */\n    58\t  readonly strip?: number | (() => number);\n    59\t  /** The host does not report the strip's height: the chart estimates it from its text style. */\n    60\t  readonly stripUnknown?: boolean;\n    61\t  /** Called inside the interaction layer's commit, as the DOM layer calls hover while it presents. */\n    62\t  readonly onCommit?: (state: Committed, controller: Controller) => void;\n    63\t}\n    64\t\n    65\texport function record(kind: ChartKind, options: Record<string, unknown>, settings: HostOptions = {}): Recording {\n    66\t  const queue = new Map<number, (time?: number) => void>();\n    67\t  /** Animation frame time: one value per batch of callbacks, as a browser gives it. */\n    68\t  let clock = 0;\n    69\t  let handles = 0;\n    70\t  const rec = {\n    71\t    draws: [] as Scene[], texts: [] as (readonly PlacedText[])[], models: [] as FigureModel[], announcements: [] as string[],\n    72\t    prepared: [] as ControlsState[], committed: null as Committed | null, commits: 0, clears: 0,\n    73\t    themeCalls: [] as { keys: readonly string[]; colors: Record<string, string> }[], printed: [] as string[], disposed: 0,\n    74\t    writesAfterDispose: 0, surfaces: true,\n    75\t    container: settings.container === undefined ? { width: 720, height: 400 } : settings.container,\n    76\t    lineHeight: settings.captionLineHeight ?? 20, ids: {} as Record<string, string>,\n    77\t  };\n    78\t  let model: FigureModel | null = null;\n    79\t  let controls: ControlsState | null = null;\n    80\t  const stripNow = (): number => typeof settings.strip === 'function' ? settings.strip() : settings.strip ?? 0;\n    81\t  const style: TextStyle = { font: '400 12px sans-serif', letterSpacing: 0, wordSpacing: 0, lineHeight: 15 };\n    82\t\n    83\t  /** The plot size the model figure gives: container minus caption (title, subtitle, visible summary) and controls. */\n    84\t  function plotSize(): Size | null {\n    85\t    const box = rec.container;\n    86\t    if (box === null) return null;\n    87\t    let used = 0;\n    88\t    if (model && !model.compact) {\n    89\t      if (model.title?.visible) used += rec.lineHeight;\n    90\t      if (model.subtitle) used += rec.lineHeight;\n    91\t      if (model.summaryVisible) used += 2 * rec.lineHeight;\n    92\t      if (model.note) used += rec.lineHeight;\n    93\t    }\n    94\t    if (controls && controls.interactive) {\n    95\t      // The legend and toolbar take a row; the fallback offers only the table control, which is a row too\n    96\t      // but shorter (no legend).\n    97\t      used += controls.tooSmall ? rec.lineHeight : 1.5 * rec.lineHeight;\n    98\t    }\n    99\t    const column = { width: box.width, height: box.height - used };\n   100\t    if (settings.strip === undefined) return column;\n   101\t    // The strip is in the plot's column: the column (room) stays, the plot gets what the strip leaves.\n   102\t    const reserved = controls && (controls as { readout?: boolean }).readout === true ? stripNow() : 0;\n   103\t    return { width: column.width, height: column.height - reserved, room: column };\n   104\t  }\n   105\t\n   106\t  const host: Host = {\n   107\t    id: 'axylo-test',\n   108\t    targetId: settings.targetId ?? null,\n   109\t    console: settings.console === false ? null : {\n   110\t      warn: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n   111\t      info: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n   112\t      error: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n   113\t    },\n   114\t    page: {},\n   115\t    timeZone: settings.timeZone ?? 'UTC',\n   116\t    renderer: { kind: 'svg', draw: scene => { if (rec.disposed) rec.writesAfterDispose++; rec.draws.push(scene); } },\n   117\t    text: { render: texts => { if (rec.disposed) rec.writesAfterDispose++; rec.texts.push(texts); } },\n   118\t    surfaces(visible) {\n   119\t      rec.surfaces = visible;\n   120\t    },\n   121\t    figure: {\n   122\t      update(next) {\n   123\t        if (rec.disposed) rec.writesAfterDispose++;\n   124\t        const before = model;\n   125\t        model = next;\n   126\t        rec.models.push(next);\n   127\t        return before === null || before.summaryVisible !== next.summaryVisible || before.note !== next.note ||\n   128\t          before.title?.text !== next.title?.text || before.subtitle !== next.subtitle;\n   129\t      },\n   130\t      announce: text => { rec.announcements.push(text); },\n   131\t    },\n   132\t    interaction: {\n   133\t      prepare(state) {\n   134\t        const before = controls;\n   135\t        controls = state;\n   136\t        rec.prepared.push(state);\n   137\t        return before === null || before.tooSmall !== state.tooSmall || before.interactive !== state.interactive;\n   138\t      },\n   139\t      commit(state) {\n   140\t        if (rec.disposed) rec.writesAfterDispose++;\n   141\t        rec.committed = state;\n   142\t        rec.commits++;\n   143\t        if (state) settings.onCommit?.(state, controller);\n   144\t      },\n   145\t      clear() {\n   146\t        rec.committed = null;\n   147\t        rec.clears++;\n   148\t      },\n   149\t    },\n   150\t    measurer: { width: settings.textWidth ?? (text => text.length * 7) },\n   151\t    requestFrame(callback) {\n   152\t      const handle = ++handles;\n   153\t      queue.set(handle, callback);\n   154\t      return handle;\n   155\t    },\n   156\t    cancelFrame(handle) {\n   157\t      queue.delete(handle);\n   158\t    },\n   159\t    locale: option => typeof option === 'string' ? option : settings.locale ?? 'en-US',\n   160\t    pageLang: () => settings.pageLang ?? 'en',\n   161\t    labelText: id => Object.hasOwn(rec.ids, id) ? rec.ids[id]! : null,\n   162\t    textStyle: () => style,\n   163\t    measure: plotSize,\n   164\t    ...(settings.strip === undefined || settings.stripUnknown ? {} : { stripHeight: stripNow }),\n   165\t    devicePixelRatio: () => 1,\n   166\t    theme(keys, colors) {\n   167\t      rec.themeCalls.push({ keys: [...keys], colors });\n   168\t      const series = keys.map((_, i) => `var(--axylo-series-color-${i + 1})`);\n   169\t      const paints = { tokens: { ...TOKEN_BINDINGS }, series };\n   170\t      return {\n   171\t        bindings: { tokens: TOKEN_BINDINGS, series },\n   172\t        theme: { scheme: 'light', forcedColors: false, moreContrast: false, paints },\n   173\t        resolved: true, backdropKnown: false,\n   174\t      };\n   175\t    },\n   176\t    dispose() {\n   177\t      rec.disposed++;\n   178\t    },\n   179\t  };\n   180\t\n   181\t  const controller = createController(kind, options, host);\n   182\t  // Accessors stay accessors: `pending` and `layout` are read when asked (review 3, finding 20).\n   183\t  return Object.defineProperties(Object.assign(rec, {\n   184\t    host, controller,\n   185\t    frames(limit = 10): number {\n   186\t      let rounds = 0;\n   187\t      while (queue.size && rounds < limit) {\n   188\t        rounds++;\n   189\t        const callbacks = [...queue.values()];\n   190\t        queue.clear();\n   191\t        clock += 16;\n   192\t        for (const cb of callbacks) cb(clock);\n   193\t      }\n   194\t      return rounds;\n   195\t    },\n   196\t  }), {\n   197\t    pending: { get: () => queue.size, enumerable: true },\n   198\t    layout: { get: () => rec.committed?.layout ?? null, enumerable: true },\n   199\t  }) as unknown as Recording;\n   200\t}\n   201\t\n   202\texport const lastModel = (r: Recording): FigureModel => r.models[r.models.length - 1]!;\n","exit_code":0,"status":"completed"}}
