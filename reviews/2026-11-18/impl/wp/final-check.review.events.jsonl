ints at something that is gone; with the plot focused\n  1999\t    // and nothing to follow, the first datum is focus, stored, before anything is written (finding 2).\n  2000\t    if (focus) {\n  2001\t      const resolved = next.lookup.resolve(focus);\n  2002\t      focus = resolved;\n  2003\t      if (resolved === null) mode = 'all';\n  2004\t      else if (mode === 'all' && resolved.kind === 'aligned') focus = next.lookup.primary({ kind: 'x', x: resolved.x }) ?? resolved;\n  2005\t    }\n  2006\t    if (!focus && proxyFocused && plotReady(next) && readable(next)) focus = firstDatum(next);\n  2007\t\n  2008\t    const presentation = presentationFor(next);\n  2009\t    if (!plotReady(next)) {\n  2010\t      if (shown.kind !== 'keyboard') shown = pointer ? { kind: 'hover', target: null } : idle();\n  2011\t      pinPage = 0;\n  2012\t      return;\n  2013\t    }\n  2014\t    switch (shown.kind) {\n  2015\t      case 'pinned': {\n  2016\t        const kept = presentation === 'none' ? null : stillPinned(next, shown.ref, shown.target);\n  2017\t        if (kept) shown = { kind: 'pinned', ref: kept.ref, target: kept.target };\n  2018\t        else {\n  2019\t          endPin();\n  2020\t          // endPin picked with the old frame's lookup; the new frame's is the one on screen.\n  2021\t          const after = shown as Shown;\n  2022\t          if (after.kind === 'hover' && pointer) pointTo(pick(next, pointer));\n  2023\t        }\n  2024\t        break;\n  2025\t      }\n  2026\t      case 'held': {\n  2027\t        // The hold belongs to one datum, one geometry and one presentation (rule 3b).\n  2028\t        const anchor = anchorOf(next, shown.target);\n  2029\t        if (presentation !== shown.presentation || !sameRect(anchor, shown.anchor) || !next.lookup.tooltip(shown.target).rows.length) {\n  2030\t          rest = null;\n  2031\t          if (pointer && !down?.dragging) pointTo(pick(next, pointer));\n  2032\t          else shown = idle();\n  2033\t        }\n 