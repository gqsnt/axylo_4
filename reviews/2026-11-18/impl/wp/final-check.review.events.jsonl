{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"git show 9f9eeef:packages/axylo/test/browser/chart/final-round3.browser.test.ts | nl -ba | sed -n '11,212p'\"","aggregated_output":"    11\t\n    12\tbeforeAll(start);\n    13\tafterAll(stop);\n    14\t\n    15\tconst proxy = '#chart .axylo-proxy';\n    16\tconst valueText = (page: Page) => page.locator(proxy).getAttribute('aria-valuetext');\n    17\tconst clickAt = async (page: Page, at: Pt) => { await page.mouse.move(at.x, at.y); await page.mouse.down(); await page.mouse.up(); await settle(page); };\n    18\t\n    19\tdescribe('item 1: groups come from the lookup (C8, I8)', () => {\n    20\t  it('nine exactly coincident points with clipped points interleaved in x order: page two lists the ninth, not page one again', async () => {\n    21\t    const page = await chartPage();\n    22\t    // Members at x 5 + i·1e-9 (one pixel), y 5; between each two in x order a point at y 500, outside the y domain.\n    23\t    const data = Array.from({ length: 9 }, (_, i) => [{ x: 5 + i * 1e-9, y: 5, s: 'A', id: i }, { x: 5 + i * 1e-9 + 5e-10, y: 500, s: 'A', id: 100 + i }]).flat();\n    24\t    await create(page, 'scatter', { title: 'G', data, x: { field: 'x', domain: [0, 10] }, y: { field: 'y', domain: [0, 10] }, series: 's' });\n    25\t    await recordEvents(page);\n    26\t    const p = await plotBox(page);\n    27\t    await clickAt(page, { x: p.x + p.width / 2, y: p.y + p.height / 2 });\n    28\t    const more = page.locator('#chart .axylo-tooltip button.axylo-tooltip-more');\n    29\t    expect(await more.textContent()).toBe('+1 more');\n    30\t    const first = new Set<number>();\n    31\t    for (const b of await page.locator('#chart .axylo-tooltip button.axylo-tooltip-row').all()) { await b.click(); await settle(page); }\n    32\t    for (const e of await selected(page)) first.add((e.row as { id: number }).id);\n    33\t    await more.click();\n    34\t    await settle(page);\n    35\t    const rows = page.locator('#chart .axylo-tooltip button.axylo-tooltip-row');\n    36\t    expect(await rows.count()).toBe(1);\n    37\t    await rows.first().click();\n    38\t    await settle(page);\n    39\t    const ninth = ((await selected(page)).at(-1)!.row as { id: number }).id;\n    40\t    expect(first.has(ninth)).toBe(false);\n    41\t    expect(ninth).toBeLessThan(9);\n    42\t    expect(await closePage(page)).toEqual([]);\n    43\t  });\n    44\t\n    45\t  it('the 32,000-point ring around the pointer: every row of page two belongs to the winning group (within its device pixel)', async () => {\n    46\t    const page = await chartPage({ css: '#chart { width: 520px; height: 420px; }' });\n    47\t    await create(page, 'scatter', { title: 'Ring', data: [{ x: 0, y: 0 }], x: { field: 'x', domain: [0, 200] }, y: { field: 'y', domain: [0, 200] } });\n    48\t    const p = await plotBox(page);\n    49\t    // A 20 px ring around the plot's centre, in data units of this plot.\n    50\t    await page.evaluate(({ w, h }) => {\n    51\t      const n = 32_000;\n    52\t      window.charts[0]!.update({ data: Array.from({ length: n }, (_, i) => ({ x: 100 + (20 * 200 / w) * Math.cos(2 * Math.PI * i / n), y: 100 + (20 * 200 / h) * Math.sin(2 * Math.PI * i / n) })) });\n    53\t    }, { w: p.width, h: p.height });\n    54\t    await settle(page);\n    55\t    await recordEvents(page);\n    56\t    await clickAt(page, { x: p.x + p.width / 2, y: p.y + p.height / 2 });\n    57\t    const more = page.locator('#chart .axylo-tooltip button.axylo-tooltip-more');\n    58\t    // The reviewer's ring at DPR 1: the winning lattice group has more than eight members.\n    59\t    expect(await more.count()).toBe(1);\n    60\t    const pageOne: Pt[] = [];\n    61\t    const screen = (e: { x: unknown; y: number | null }) => ({ x: p.x + ((e.x as number) / 200) * p.width, y: p.y + p.height * (1 - (e.y as number) / 200) });\n    62\t    for (const b of await page.locator('#chart .axylo-tooltip button.axylo-tooltip-row').all()) { await b.click(); await settle(page); }\n    63\t    for (const e of await selected(page)) pageOne.push(screen(e));\n    64\t    const before = (await selected(page)).length;\n    65\t    await more.click();\n    66\t    await settle(page);\n    67\t    for (const b of await page.locator('#chart .axylo-tooltip button.axylo-tooltip-row').all()) { await b.click(); await settle(page); }\n    68\t    const pageTwo = (await selected(page)).slice(before).map(screen);\n    69\t    expect(pageTwo.length).toBeGreaterThan(0);\n    70\t    // A lattice group is one point of the device-pixel lattice (DPR 1: the plot's whole pixels): every member\n    71\t    // of page two rounds to the same plot pixel as page one's members.\n    72\t    const cell = (q: Pt) => `${Math.round(q.x - p.x)},${Math.round(q.y - p.y)}`;\n    73\t    const cells = new Set(pageOne.map(cell));\n    74\t    expect(cells.size, [...cells].join(' ')).toBe(1);\n    75\t    for (const q of pageTwo) expect(cell(q)).toBe(cell(pageOne[0]!));\n    76\t    expect(await closePage(page)).toEqual([]);\n    77\t  });\n    78\t});\n    79\t\n    80\tdescribe('item 2: Escape and dismissal by the rewritten clarification', () => {\n    81\t  // The acceptance fixture: four slices of spend, the probe at 45° (Travel) and the next slice's at 63° (Rent).\n    82\t  it.skipIf(RENDERER === 'canvas')('donut: after a rest and the corridor into the tooltip, Escape, back to the first slice (closed), then to another: it opens', async () => {\n    83\t    const page = await chartPage({ css: '#before, #after { display: inline-block !important; }' });\n    84\t    const items = ['Travel', 'Rent', 'Books', 'Food'], values = [360, 1200, 240, 600];\n    85\t    await create(page, 'donut', { title: 'Monthly spend', data: items.map((item, i) => ({ item, spend: values[i] })), label: 'item', value: { field: 'spend', label: 'Spend', unit: 'EUR' } });\n    86\t    const g = await page.evaluate(() => {\n    87\t      const svg = document.querySelector('#chart svg.axylo-svg') as SVGSVGElement;\n    88\t      const m = svg.getScreenCTM()!;\n    89\t      let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;\n    90\t      for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) {\n    91\t        if (!/A/.test(el.getAttribute('d') ?? '')) continue;\n    92\t        const b = el.getBBox();\n    93\t        if (b.width < 1 || b.height < 1) continue;\n    94\t        const a = new DOMPoint(b.x, b.y).matrixTransform(m), c = new DOMPoint(b.x + b.width, b.y + b.height).matrixTransform(m);\n    95\t        x0 = Math.min(x0, a.x); y0 = Math.min(y0, a.y); x1 = Math.max(x1, c.x); y1 = Math.max(y1, c.y);\n    96\t      }\n    97\t      return { cx: (x0 + x1) / 2, cy: (y0 + y1) / 2, outer: (x1 - x0) / 2 };\n    98\t    });\n    99\t    const at = (deg: number): Pt => ({ x: g.cx + g.outer * 0.85 * Math.sin(deg * Math.PI / 180), y: g.cy - g.outer * 0.85 * Math.cos(deg * Math.PI / 180) });\n   100\t    const first = at(45), other = at(63);\n   101\t    await page.mouse.move(first.x, first.y);\n   102\t    await settle(page);\n   103\t    const t = (await tip(page)).box!;\n   104\t    await page.waitForTimeout(300);\n   105\t    const target = { x: Math.min(t.x + t.width - 2, Math.max(t.x + 2, first.x)), y: Math.min(t.y + t.height - 2, Math.max(t.y + 2, first.y)) };\n   106\t    await walk(page, first, target, 24, async () => null);\n   107\t    expect((await tip(page)).title).toBe('Travel');\n   108\t    await page.keyboard.press('Escape');\n   109\t    await settle(page);\n   110\t    expect((await tip(page)).title).toBeNull();\n   111\t    await page.mouse.move(first.x, first.y);\n   112\t    await settle(page);\n   113\t    expect((await tip(page)).title).toBeNull();\n   114\t    await page.mouse.move(other.x, other.y);\n   115\t    await settle(page);\n   116\t    expect((await tip(page)).title).toBe('Rent');\n   117\t    expect(await closePage(page)).toEqual([]);\n   118\t  });\n   119\t\n   120\t  it('R4: pin A, move over B, Escape, move within B: B opens (only the pinned datum was dismissed)', async () => {\n   121\t    const page = await chartPage();\n   122\t    await create(page, 'line', { title: 'T', data: Array.from({ length: 5 }, (_, x) => ({ x, y: x })), x: { field: 'x', domain: [0, 4] }, y: 'y' });\n   123\t    const p = await plotBox(page);\n   124\t    const at = (x: number, dy = 0): Pt => ({ x: p.x + (x / 4) * p.width, y: p.y + p.height / 2 + dy });\n   125\t    await clickAt(page, at(1));\n   126\t    expect(await tip(page)).toMatchObject({ title: '1', pinned: true });\n   127\t    await page.mouse.move(at(3).x, at(3).y);\n   128\t    await settle(page);\n   129\t    await page.keyboard.press('Escape');\n   130\t    await settle(page);\n   131\t    expect((await tip(page)).title).toBeNull();\n   132\t    await page.mouse.move(at(3).x + 1, at(3).y + 1);\n   133\t    await settle(page);\n   134\t    expect(await tip(page)).toMatchObject({ title: '3', pinned: false });\n   135\t    expect(await closePage(page)).toEqual([]);\n   136\t  });\n   137\t});\n   138\t\n   139\tdescribe('item 3 (R1): a pressed row selects its own category; only the press\\'s own click is swallowed', () => {\n   140\t  it('pin Q3 in Q1–Q4, press its row, append Q5 with keep 4, release over the row: Q3 is selected', async () => {\n   141\t    const page = await chartPage();\n   142\t    await create(page, 'bar', { title: 'B', data: ['Q1', 'Q2', 'Q3', 'Q4'].map((x, i) => ({ x, y: i + 1 })), x: 'x', y: 'y' });\n   143\t    await recordEvents(page);\n   144\t    const p = await plotBox(page);\n   145\t    await clickAt(page, { x: p.x + p.width * (2.5 / 4), y: p.y + p.height * 0.9 });\n   146\t    expect(await tip(page)).toMatchObject({ title: 'Q3', pinned: true });\n   147\t    const before = (await selected(page)).length;\n   148\t    const row = (await page.locator('#chart .axylo-tooltip button.axylo-tooltip-row').first().boundingBox())!;\n   149\t    await page.mouse.move(row.x + row.width / 2, row.y + row.height / 2);\n   150\t    await page.mouse.down();\n   151\t    await page.evaluate(() => window.charts[0]!.append([{ x: 'Q5', y: 5 }], { keep: 4 }));\n   152\t    await settle(page);\n   153\t    expect((await tip(page)).title).toBe('Q3');\n   154\t    const now = (await page.locator('#chart .axylo-tooltip button.axylo-tooltip-row').first().boundingBox())!;\n   155\t    await page.mouse.move(now.x + now.width / 2, now.y + now.height / 2);\n   156\t    await page.mouse.up();\n   157\t    await settle(page);\n   158\t    const after = (await selected(page)).slice(before);\n   159\t    expect(after.map(e => e.x)).toEqual(['Q3']);\n   160\t    expect(await closePage(page)).toEqual([]);\n   161\t  });\n   162\t\n   163\t  it('a pointer press on one row, then Enter on another row at once: both are selected', async () => {\n   164\t    const page = await chartPage();\n   165\t    const data = [0, 1, 2].flatMap(x => ['North', 'South'].map((s, i) => ({ x, s, y: x + i * 3 })));\n   166\t    await create(page, 'line', { title: 'Two', data, x: { field: 'x', domain: [0, 2] }, y: 'y', series: 's' });\n   167\t    await recordEvents(page);\n   168\t    const p = await plotBox(page);\n   169\t    await clickAt(page, { x: p.x + p.width / 2, y: p.y + p.height / 2 });\n   170\t    const before = (await selected(page)).length;\n   171\t    await page.locator('#chart .axylo-tooltip button', { hasText: 'North' }).click();\n   172\t    await page.locator('#chart .axylo-tooltip button', { hasText: 'South' }).focus();\n   173\t    await page.keyboard.press('Enter');\n   174\t    await settle(page);\n   175\t    expect((await selected(page)).slice(before).map(e => e.series)).toEqual(['North', 'South']);\n   176\t    expect(await closePage(page)).toEqual([]);\n   177\t  });\n   178\t});\n   179\t\n   180\tdescribe('item 4 (R2): Escape belongs to the chart focus is in, through shadow roots', () => {\n   181\t  it('A in a shadow root, created first: pin A, hover B, Escape: A\\'s pin closes, B\\'s tooltip stays', async () => {\n   182\t    const page = await chartPage({ css: '#chart { width: 480px; height: 300px; }' });\n   183\t    await page.evaluate(async () => {\n   184\t      const host = document.createElement('div');\n   185\t      document.body.insertBefore(host, document.getElementById('chart'));\n   186\t      const root = host.attachShadow({ mode: 'open' });\n   187\t      for (const sheet of document.querySelectorAll('style, link[rel=\"stylesheet\"]')) root.appendChild(sheet.cloneNode(true));\n   188\t      const inner = document.createElement('div');\n   189\t      inner.style.cssText = 'width: 480px; height: 300px;';\n   190\t      root.appendChild(inner);\n   191\t      (window as unknown as { shadowChart: HTMLElement }).shadowChart = inner;\n   192\t      const data = Array.from({ length: 5 }, (_, x) => ({ x, y: x }));\n   193\t      const a = window.Axylo.line!(inner, { title: 'A', data, x: 'x', y: 'y' });\n   194\t      await a.__bench.ready();\n   195\t      const b = window.Axylo.line!('#chart', { title: 'B', data, x: 'x', y: 'y' });\n   196\t      await b.__bench.ready();\n   197\t      window.charts.push(a, b);\n   198\t      await window.nextFrames(2);\n   199\t    });\n   200\t    const aProxy = await page.evaluate(() => {\n   201\t      const r = (window as unknown as { shadowChart: HTMLElement }).shadowChart.querySelector('.axylo-proxy')!.getBoundingClientRect();\n   202\t      return { x: r.x, y: r.y, width: r.width, height: r.height };\n   203\t    });\n   204\t    const aPinned = () => page.evaluate(() => (window as unknown as { shadowChart: HTMLElement }).shadowChart.querySelector('.axylo-tooltip')!.classList.contains('axylo-tooltip-pinned'));\n   205\t    await clickAt(page, { x: aProxy.x + aProxy.width / 2, y: aProxy.y + aProxy.height / 2 });\n   206\t    expect(await aPinned()).toBe(true);\n   207\t    const b = await plotBox(page);\n   208\t    await page.mouse.move(b.x + b.width / 2, b.y + b.height / 2);\n   209\t    await settle(page);\n   210\t    expect((await tip(page)).title).not.toBeNull();\n   211\t    await page.keyboard.press('Escape');\n   212\t    await settle(page);\n","exit_code":0,"status":"completed"}}
