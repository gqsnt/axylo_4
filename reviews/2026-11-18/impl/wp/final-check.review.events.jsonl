 if (view.kind === 'line' && (layout.kind === 'plot' || layout.kind === 'compact') && layout.projection.kind === 'xy') {\n   132\t          // The same selection the scene made (scene/index.ts): the frame's x, the plot, the pixel ratio.\n   133\t          const draw = drawing(view.frame.x.values, layout.projection, layout.plot, d.pixelRatio > 0 ? d.pixelRatio : 1);\n   134\t          const window = view.visibleSlots.start;\n   135\t          out.series = out.series.map((s, i) => {\n   136\t            const series = view.frame.series[i]!;\n   137\t            if (!view.visible[i]) return { ...s, kept: [], breaks: [], isolatedMarkers: false, keptBasis: d.streaming ? 'window' : 'rows' };\n   138\t            const runs = simplifyLine({ ...draw, range: view.drawSlots[i]!, slot: series.slot, y: series.y });\n   139\t            // A streaming chart's row indexes keep growing: its kept samples are given within the window shown.\n   140\t            const kept = d.streaming\n   141\t              ? Array.from(runs.indexes, slot => slot - window)\n   142\t              : Array.from(runs.indexes, slot => series.row ? series.row[slot]! : slot);\n   143\t            return {\n   144\t              ...s, kept, breaks: Array.from(runs.breaks), isolatedMarkers: runs.isolated.length > 0,\n   145\t              keptBasis: d.streaming ? 'window' : 'rows',\n   146\t            };\n   147\t          });\n   148\t        }\n   149\t        return out;\n   150\t      },\n   151\t      memory() {\n   152\t        const d = probe.shown();\n   153\t        // The store counts the frames still held with its own buffers, in one deduplicated set: a displayed\n   154\t        // frame older than the store's head can hold buffers the head no longer has (verification, defect 12).\n   155\t        const frames = probe.frames();\n   156\t        const own = probe.store()?.ownedBytes?.(frames);\n   157\t        const caller = new CallerBuffers();\n   158\t        if (d) caller.add(d.table);\n   159\t        const count = new ByteCount(caller);\n   160\t        if (!own) for (const frame of frames) count.frame(frame);\n   161\t        if (d) d.scene.marks.forEach((m, i) => {\n   162\t          for (const [key, value] of Object.entries(m)) if (ArrayBuffer.isView(value)) count.add(`scene mark ${i} ${key}`, value);\n   163\t        });\n   164\t        const extra = count.result();\n   165\t        const buffers = [...(own?.buffers ?? []), ...extra.buffers].map(b => ({ name: b.name, bytes: b.bytes }));\n   166\t        return { bytes: (own?.total ?? 0) + extra.total, buffers };\n   167\t      },\n   168\t    };\n   169\t  }\n   170\t  if (__DEV__) {\n   171\t    handle.__dev = {\n   172\t      stages: () => ({ ...probe.stages.counts }),\n   173\t      fail(name) {\n   174\t        probe.stages.failing = name;\n   175\t      },\n   176\t      renderer: probe.renderer(),\n   177\t      retainedRows: () => probe.retainedRows(),\n   178\t    };\n   179\t  }\n   180\t}\n   181\t\n   182\tfunction describe(view: View): Omit<ReturnType<BenchHook['describe']>, 'renderer'> {\n   183\t  if (view.kind === 'donut') {\n   184\t    return { xDomain: null, yDomain: null, series: [] };\n   185\t  }\n   186\t  if (view.kind === 'scatter') {\n   187\t    return {\n   188\t      xDomain: view.xDomain, yDomain: view.yDomain,\n   189\t      series: view.frame.series.map(s => ({\n   190\t        key: s.key, points: s.x.length, oldestX: s.x[0] ?? NaN, newestX: s.x[s.x.length - 1] ?? NaN, missing: 0,\n   191\t      })),\n   192\t    };\n   193\t  }\n   194\t  const { frame } = view;\n   195\t  return {\n   196\t    xDomain: view.xDomain, yDomain: view.yDomain,\n   197\t    series: frame.series.map(s => {\n   198\t      let points = 0;\n   199\t      let missing = 0;\n   200\t      let first = -1;\n   201\t      let last = -1;\n   202\t      for (let i = 0; i < frame.length; i++) {\n   203\t        const state = s.slot[i];\n   204\t        if (state === SLOT_NO_ROW) continue;\n   205\t 