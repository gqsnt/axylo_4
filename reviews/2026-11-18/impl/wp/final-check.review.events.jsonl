{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"git show 9f9eeef:packages/axylo/src/dom/mapping.ts | nl -ba | sed -n '1,165p'\"","aggregated_output":"     1\t/**\n     2\t * One mapping between an element's layout pixels and viewport pixels (decision 0004 revision 3, rule 10),\n     3\t * used for picking, anchors, clipping and placement alike. It is taken from fractional sizes: the bounding\n     4\t * rectangle (viewport, after transforms) against the computed size (layout, before transforms), so a\n     5\t * translated or scaled ancestor, uniform or not and at any positive scale, maps exactly.\n     6\t *\n     7\t * Limit (1.0): a rotated, skewed or mirrored ancestor is not supported. Its bounding rectangle is the\n     8\t * rotated box's envelope and always has positive size, so no ratio of two sizes can undo it; picking and\n     9\t * placement are then wrong. The spec's limits section says so.\n    10\t *\n    11\t * Every function here touches the DOM only when called.\n    12\t */\n    13\timport type { Rect } from '../core/contracts';\n    14\t\n    15\texport interface Point { readonly x: number; readonly y: number }\n    16\t\n    17\t/** viewport = origin + layout × scale, per axis. The origin is the element's padding box corner. */\n    18\texport interface Mapping {\n    19\t  readonly left: number;\n    20\t  readonly top: number;\n    21\t  readonly kx: number;\n    22\t  readonly ky: number;\n    23\t}\n    24\t\n    25\tconst px = (v: string): number => {\n    26\t  const n = parseFloat(v);\n    27\t  return Number.isFinite(n) ? n : 0;\n    28\t};\n    29\t\n    30\t/** The border box's layout size, fractional, from the computed style. */\n    31\tfunction layoutSize(el: Element, style: CSSStyleDeclaration): { width: number; height: number } {\n    32\t  let width = parseFloat(style.width);\n    33\t  let height = parseFloat(style.height);\n    34\t  if (!Number.isFinite(width) || !Number.isFinite(height)) {\n    35\t    // An element without a computed size (display: inline, contents): its integer layout size is all there is.\n    36\t    const h = el as HTMLElement;\n    37\t    return { width: h.offsetWidth ?? 0, height: h.offsetHeight ?? 0 };\n    38\t  }\n    39\t  if (style.boxSizing !== 'border-box') {\n    40\t    width += px(style.paddingLeft) + px(style.paddingRight) + px(style.borderLeftWidth) + px(style.borderRightWidth);\n    41\t    height += px(style.paddingTop) + px(style.paddingBottom) + px(style.borderTopWidth) + px(style.borderBottomWidth);\n    42\t  }\n    43\t  return { width, height };\n    44\t}\n    45\t\n    46\t/** The mapping of `el`'s own layout pixels (origin at its padding box) to viewport pixels. */\n    47\texport function mappingOf(el: Element): Mapping {\n    48\t  const win = el.ownerDocument.defaultView;\n    49\t  const rect = el.getBoundingClientRect();\n    50\t  if (!win) return { left: rect.left, top: rect.top, kx: 1, ky: 1 };\n    51\t  const style = win.getComputedStyle(el);\n    52\t  const size = layoutSize(el, style);\n    53\t  // A computed size is serialized to six significant digits (\"341.531px\" for 341.53125): a ratio that close\n    54\t  // to 1 is that rounding, not a transform (a scale that small moves nothing by a hundredth of a pixel), and\n    55\t  // taking it as a scale would put a datum drawn exactly on the plot's edge just outside it.\n    56\t  const ratio = (visual: number, layout: number) => {\n    57\t    const k = layout > 0 && visual > 0 ? visual / layout : 1;\n    58\t    return Math.abs(k - 1) < 1e-5 ? 1 : k;\n    59\t  };\n    60\t  const kx = ratio(rect.width, size.width);\n    61\t  const ky = ratio(rect.height, size.height);\n    62\t  return { left: rect.left + px(style.borderLeftWidth) * kx, top: rect.top + px(style.borderTopWidth) * ky, kx, ky };\n    63\t}\n    64\t\n    65\texport function toViewport(m: Mapping, p: Point): Point {\n    66\t  return { x: m.left + p.x * m.kx, y: m.top + p.y * m.ky };\n    67\t}\n    68\t\n    69\texport function toLocal(m: Mapping, p: Point): Point {\n    70\t  return { x: (p.x - m.left) / m.kx, y: (p.y - m.top) / m.ky };\n    71\t}\n    72\t\n    73\texport function rectToViewport(m: Mapping, r: Rect): Rect {\n    74\t  return { x: m.left + r.x * m.kx, y: m.top + r.y * m.ky, width: r.width * m.kx, height: r.height * m.ky };\n    75\t}\n    76\t\n    77\t/**\n    78\t * The part of the viewport that content inside `from`'s parent can be seen in: the viewport cut by each\n    79\t * ancestor's real clipping edge (its padding box less any scrollbar), on each axis it clips, across shadow\n    80\t * roots. Without `viewport`, only the ancestors cut it: content in the page's flow (the strip) can be\n    81\t * scrolled into view, a floating tooltip cannot.\n    82\t */\n    83\texport function visibleRegion(from: Element, viewport = true): Rect {\n    84\t  const doc = from.ownerDocument;\n    85\t  const win = doc.defaultView;\n    86\t  const root = doc.documentElement;\n    87\t  // Far beyond any page, finite: x + width stays a number.\n    88\t  const FAR = 1e9;\n    89\t  let left = viewport ? 0 : -FAR;\n    90\t  let top = viewport ? 0 : -FAR;\n    91\t  let right = viewport ? root.clientWidth : FAR;\n    92\t  let bottom = viewport ? root.clientHeight : FAR;\n    93\t  // The composed chain: a slotted element's parent is its slot (whose shadow wrappers can clip it, review I5),\n    94\t  // and past a shadow root comes its host, whose ancestors clip what is inside it too.\n    95\t  const up = (el: Element): Element | null => el.assignedSlot ?? el.parentElement ?? ((el.getRootNode() as ShadowRoot).host ?? null);\n    96\t  for (let el: Element | null = up(from); el && el !== root && win; el = up(el)) {\n    97\t    const style = win.getComputedStyle(el);\n    98\t    const clipsX = style.overflowX !== 'visible';\n    99\t    const clipsY = style.overflowY !== 'visible';\n   100\t    if (!clipsX && !clipsY) continue;\n   101\t    const m = mappingOf(el);\n   102\t    const rect = el.getBoundingClientRect();\n   103\t    const h = el as HTMLElement;\n   104\t    const bl = px(style.borderLeftWidth);\n   105\t    const br = px(style.borderRightWidth);\n   106\t    const bt = px(style.borderTopWidth);\n   107\t    const bb = px(style.borderBottomWidth);\n   108\t    // Scrollbars take room inside the border: what is left of the integer sizes after the borders.\n   109\t    const scrollX = Math.max(0, (h.offsetWidth ?? 0) - (h.clientWidth ?? 0) - Math.round(bl + br));\n   110\t    const scrollY = Math.max(0, (h.offsetHeight ?? 0) - (h.clientHeight ?? 0) - Math.round(bt + bb));\n   111\t    if (clipsX) {\n   112\t      left = Math.max(left, m.left);\n   113\t      right = Math.min(right, rect.right - (br + scrollX) * m.kx);\n   114\t    }\n   115\t    if (clipsY) {\n   116\t      top = Math.max(top, m.top);\n   117\t      bottom = Math.min(bottom, rect.bottom - (bb + scrollY) * m.ky);\n   118\t    }\n   119\t  }\n   120\t  return { x: left, y: top, width: Math.max(0, right - left), height: Math.max(0, bottom - top) };\n   121\t}\n","exit_code":0,"status":"completed"}}
