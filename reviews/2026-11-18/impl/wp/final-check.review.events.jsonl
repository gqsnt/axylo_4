73\t  };\n    74\t\n    75\t  failed(at: number): void { this.positions.add(at); }\n    76\t\n    77\t  drawn(ticks: readonly { readonly value: number }[]): boolean {\n    78\t    return ticks.length > 0 && (this.always || ticks.some(t => this.positions.has(t.value)));\n    79\t  }\n    80\t}\n    81\t\n    82\tfunction numberTicks(domain: Span, locale: string, option: unknown, scale: 'percent' | 'ratio' | null, failures: TickFailures): TickCandidates {\n    83\t  const tickFormat = typeof option === 'function' || (option !== null && typeof option === 'object')\n    84\t    ? failures.author(option) as NumberFormatOption : null;\n    85\t  return linearTickCandidates(domain, failures.labeler(createNumberTickLabeler({ locale, scale, tickFormat, onError: failures.report })));\n    86\t}\n    87\t\n    88\tfunction temporalTicks(\n    89\t  domain: Span, kind: 'time' | 'date' | 'wall', timeZone: string | null, dateUnit: 'day' | 'month' | 'year' | null,\n    90\t  locale: string, option: unknown, failures: TickFailures,\n    91\t): TickCandidates {\n    92\t  const format = typeof option === 'function' || (option !== null && typeof option === 'object')\n    93\t    ? failures.author(option) as Parameters<typeof createTimeTickLabel>[0]['format'] : null;\n    94\t  const label = format ? createTimeTickLabel({ kind, timeZone, locale, dateUnit, format, onError: failures.report }) : null;\n    95\t  return timeTickCandidates(domain, { kind, timeZone, locale, dateUnit, label: label && failures.labeler(label) });\n    96\t}\n    97\t\n    98\tfunction categoryLabels(categories: readonly string[], option: unknown, failures: TickFailures): readonly string[] {\n    99\t  if (typeof option !== 'function') return categories;\n   100\t  return categories.map((name, i) => {\n   101\t    try {\n   102\t      return String((option as (value: XValue) => string)(name));\n   103\t    } catch {\n   104\t      // A band tick's value is its category's index.\n   105\t      failures.failed(i)