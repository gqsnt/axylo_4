issing-y scatter row can be jumped to', () => {\n   413\t  it('an all-zero donut\\'s focused entry keeps focus when the slices are reordered', async () => {\n   414\t    const page = await chartPage({ css: '#before, #after { display: inline-block !important; }' });\n   415\t    await create(page, 'donut', { title: 'Z', table: false, data: [{ k: 'a', v: 0 }, { k: 'b', v: 0 }, { k: 'c', v: 0 }], label: 'k', value: 'v' });\n   416\t    await page.focus('#before');\n   417\t    await page.keyboard.press('Tab');\n   418\t    await page.keyboard.press('ArrowDown');\n   419\t    expect(await page.evaluate(() => document.activeElement?.closest('li')?.dataset.key)).toBe('b');\n   420\t    await page.evaluate(() => window.charts[0]!.update({ data: [{ k: 'c', v: 0 }, { k: 'b', v: 0 }, { k: 'a', v: 0 }] }));\n   421\t    await settle(page);\n   422\t    expect(await page.evaluate(() => document.activeElement?.closest('li')?.dataset.key)).toBe('b');\n   423\t    expect(await closePage(page)).toEqual([]);\n   424\t  });\n   425\t\n   426\t  it('a scatter on a date x: the date the table prints for a row with no y finds its page', async () => {\n   427\t    const page = await chartPage();\n   428\t    const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n   429\t    const rows = Array.from({ length: 250 }, (_, k) => ({ d: day(k), y: k === 230 ? null : k }));\n   430\t    await create(page, 'scatter', { title: 'M', data: rows, x: { field: 'd', type: 'date' }, y: 'y' });\n   431\t    await page.locator('#chart button', { hasText: 'View as table' }).click();\n   432\t    // The printed date of the row with no y, as the table writes it (it lists every row, by x).\n   433\t    let printed: string | null = null;\n   434\t    for (let k = 0; k < 3 && printed === null; k++) {\n   435\t      printed = await page.evaluate(() => [...document.querySelectorAll('#chart .axylo-table tbody tr')].find(tr => tr.querySelectorAll('td')[1]?.textContent === 'No data')?.querySelector('th')?.textContent ?? null);\n   436\t      if (printed === null) await page.locator('#chart .axylo-pager button', { hasText: 'Next page' }).click();\n   437\t    }\n   438\t    expect(printed).not.toBeNull();\n   439\t    await page.locator('#chart .axylo-pager button', { hasText: 'Previous page' }).click();\n   440\t    await page.locator('#chart .axylo-pager button', { hasText: 'Previous page' }).click();\n   441\t    const field = page.locator('#chart .axylo-jump-field');\n   442\t    await field.fill(printed!);\n   443\t    await page.keyboard.press('Enter');\n   444\t    expect(await field.getAttribute('aria-invalid'), printed!).toBeNull();\n   445\t    expect(await closePage(page)).toEqual([]);\n   446\t  });\n   447\t});\n   448\t\n   449\tdescribe('item 13: tests the re-check found missing', () => {\n   450\t  it('I2: a narrowed secondary ref pinned survives a redraw and Resume', async () => {\n   451\t    const page = await chartPage();\n   452\t    const data = [0, 1, 2].flatMap(x => [{ x, s: 'A', y: x + 1 }, { x, s: 'B', y: x + 5 }]);\n   453\t    await create(page, 'line', { title: 'T', data, x: { field: 'x', domain: [0, 3] }, y: 'y', series: 's' });\n   454\t    await recordEvents(page);\n   455\t    await page.locator(proxy).focus();\n   456\t    await page.keyboard.press('ArrowRight');\n   457\t    await page.keyboard.press('ArrowDown');\n   458\t    await page.keyboard.press('ArrowDown');\n   459\t    await settle(page);\n   460\t    expect(await valueText(page)).toMatch(/^B, /);\n   461\t    const p = await plotBox(page);\n   462\t    await clickAt(page, { x: p.x + p.width / 3, y: p.y + p.height / 2 });\n   463\t    expect((await selected(page)).at(-1)).toMatchObject({ series: 'B', x: 1 });\n   464\t    expect((await tip(page)).pinned).toBe(true);\n   465\t    await page.evaluate(() => window.charts[0]!.append([{ x: 3, s: 'A', y: 1 }]));\n   466\t    await settle(page);\n   467\t    expect((await tip(page)).pinned).toBe(true);\n   468\t    // Pause and Resume from the keyboard: a press elsewhere would end the pin (rule 4).\n   469\t    await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'Pause' }).focus();\n   470\t    await page.keyboard.press('Enter');\n   471\t    await page.evaluate(() => window.charts[0]!.append([{ x: 3, s: 'B', y: 2 }]));\n   472\t    await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'Resume' }).focus();\n   473\t    await page.keyboard.press('Enter');\n   474\t    await settle(page);\n   475\t    expect(await tip(page)).toMatchObject({ title: '1', pinned: true });\n   476\t    await page.locator(proxy).focus();\n   477\t    await page.keyboard.press('Enter');\n   478\t    await settle(page);\n   479\t    expect((await selected(page)).at(-1)).toMatchObject({ series: 'B', x: 1 });\n   480\t    expect(await closePage(page)).toEqual([]);\n   481\t  });\n   482\t\n   483\t  it('I3: a pinch that commits no zoom ends the pin, and hover works after it', async () => {\n   484\t    requireEngineFeature(['chromium'], 'multi-point touch input is dispatched through the Chrome DevTools protocol');\n   485\t    const page = await chartPage({ hasTouch: true });\n   486\t    await create(page, 'line', { title: 'P', zoom: 'touch', data: Array.from({ length: 11 }, (_, x) => ({ x, y: x })), x: { field: 'x', domain: [0, 10] }, y: 'y' });\n   487\t    const p = await plotBox(page);\n   488\t    await page.touchscreen.tap(p.x + p.width * 0.3, p.y + p.height / 2);\n   489\t    await settle(page);\n   490\t    expect((await tip(page)).pinned).toBe(true);\n   491\t    const client = await page.context().newCDPSession(page);\n   492\t    const cx = p.x + p.width / 2, cy = p.y + p.height / 2;\n   493\t    // Two fingers down and up without moving: no zoom.\n   494\t    await client.send('Input.dispatchTouchEvent', { type: 'touchStart', touchPoints: [{ x: cx - 40, y: cy, id: 1 }, { x: cx + 40, y: cy, id: 2 }] });\n   495\t    await client.send('Input.dispatchT