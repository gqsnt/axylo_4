 const fixedTop = full !== null && hi >= full / 2 && hi <= full;\n    76\t  if (fixedTop) hi = full;\n    77\t  const domain = lo === hi ? aroundConstant(lo, fixedTop, input.includeZero) : niceExtent(lo, hi, fixedTop);\n    78\t  return { domain: usable(domain, lo, hi), widenedToZero: false };\n    79\t}\n    80\t\n    81\t/**\n    82\t * [lo, hi] rounded outwards to the first multiple of the domain step at or beyond each end. With `fixedTop`\n    83\t * the upper end is kept as it is.\n    84\t */\n    85\texport function niceExtent(lo: number, hi: number, fixedTop = false): [number, number] {\n    86\t  const step = domainStep(lo, hi);\n    87\t  if (!(step.value > 0 && Number.isFinite(step.value))) return [lo, hi];\n    88\t  const a = stepMultiple(lastIndexAtOrBelow(lo, step), step);\n    89\t  const b = fixedTop ? hi : stepMultiple(firstIndexAtOrAbove(hi, step), step);\n    90\t  return [a, b];\n    91\t}\n    92\t\n    93\t/**\n    94\t * A usable domain for a single value v (only reached without includeZero, or for zero itself). Zero gets\n    95\t * [0, 1] or [-1, 1]; any other value gets a nice range about 10% either side, or below it when v is the\n    96\t * fixed full-scale top.\n    97\t */\n    98\tfunction aroundConstant(v: number, fixedTop: boolean, includeZero: boolean): [number, number] {\n    99\t  // Zero on a bar or area axis starts at the baseline.\n   100\t  if (v === 0) return includeZero ? [0, 1] : [-1, 1];\n   101\t  // Below 1e-300 a tenth of the value is not representable; such a value is drawn as zero would be.\n   102\t  if (Math.abs(v) < 1e-300) return [-1, 1];\n   103\t  const h = Math.abs(v) * 0.1;\n   104\t  if (fixedTop || !Number.isFinite(v + h)) return niceExtent(v - 2 * h, v, true);\n   105\t  if (!Number.isFinite(v - h)) return [v, niceExtent(v, v + 2 * h)[1]];\n   106\t  return niceExtent(v - h, v + h);\n   107\t}\n   108\t\n   109\t/**\n   110\t * The rounded domain if it is finite, ordered and contains [lo, hi]; otherwise the finite input bounds,\n   111\t * so no rounding artefact (overflow, underflow, a step below the resolution of the values) reaches a scale.\n   112\t */\n   113\tfunction usable(domain: [number, number], lo: number, hi: number): [number, number] {\n   114\t  const [a, b] = domain;\n   115\t  if (Number.isFinite(a) && Number.isFinite(b) && a <= lo && b >= hi && a < b) return [a === 0 ? 0 : a, b === 0 ? 0 : b];\n   116\t  if (lo < hi) return [lo, hi];\n   117\t  // A single value whose rounded neighbourhood failed: any finite interval around it.\n   118\t  const h = Math.abs(lo) * 0.2;\n   119\t  if (Number.isFinite(lo - h) && lo - h < lo) return [lo - h, lo];\n   120\t  if (Number.isFinite(lo + h) && lo + h > lo) return [lo, lo + h];\n   121\t  return [lo - 1, lo + 1];\n   122\t}\n   123\t\n   124\t/**\n   125\t * Coarser automatic domains for [lo, hi] than `domain`, each on a larger nice step and ending at the first\n   126\t * multiple of that step at or beyond each extreme, sparsest last (one interval). A plot too short for the\n   127\t * ticks of `domain` takes one of these, so its axis still ends at drawn ticks (F7). With `fixedTop` the upper\n   128\t * end stays at `domain`'s and the lower end is a whole number of steps below it.\n   129\t */\n   130\texport function coarserDomains(lo: number, hi: number, domain: readonly [number, number], fixedTop = false): [number, number][] {\n   131\t  const out: [number, number][] = [];\n   132\t  if (!(lo < hi) || !Number.isFinite(lo) || !Number.isFinite(hi)) return out;\n   133\t  const b0 = domain[1];\n   134\t  // The automatic domain's own step, then each coarser one.\n   135\t  let step: NiceStep = nextNiceStep(domainStep(lo, hi));\n   136\t  let intervals = Infinity;\n   137\t  // Bounded: each step at least doubles, and the domain is reached in one interval within a few steps.\n   138\t  for (let n = 0; n < 12 && intervals > 1; n++, step = nextNiceStep(step)) {\n   139\t    const b = fixedTop ? b0 : stepMultiple(firstIndexAtOrAbove(hi, step), step);\n   140\t    const a = fixedTop ? b - stepMultiple(firstIndexAtOrAbove(b - lo, step), step) : stepMultiple(lastIndexAtOrBelow(lo, step), step);\n   141\t    if (!(Number.isFinite(a) && Number.isFinite(b) && a < b && a <= lo && b >= hi)) continue;\n   142\t    const count = Math.round((b - a) / step.value);\n   143\t    if (count >= intervals) continue;\n   144\t    intervals = count;\n   145\t    // A domain already offered keeps its ticks of every step: only a wider one is new.\n   146\t    if ((a === domain[0] && b === domain[1]) || out.some(d => d[0] === a && d[1] === b)) continue;\n   147\t    out.push([a === 0 ? 0 : a, b === 0 ? 0 : b]);\n   148\t  }\n   149\t  return out;\n   150\t}\n","exit_code":0,"status":"completed"}}
