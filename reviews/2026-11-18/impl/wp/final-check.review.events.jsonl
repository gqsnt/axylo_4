(reader review, finding 5); English is marked only on a\n  1348\t        // page in another language (A10).\n  1349\t        noteSegments: noteShown && reader.note !== null ? noteRuns(reader) : null,\n  1350\t        // The generated summary's sentences are the built-in templates; the names in them do not change that.\n  1351\t        summaryLang: message !== null && shown.kind !== 'ready' && shown.kind !== 'empty'\n  1352\t          ? (shown.message && english(shown.message) ? 'en' : null)\n  1353\t          : english('chartSummary') && english('seriesSummary') ? 'en' : null,\n  1354\t      };\n  1355\t    };\n  1356\t    const zoomOn = zoomApplies(view, a.options.zoom) ? (a.options.zoom === 'touch' ? 'touch' as const : true) : false;\n  1357\t    const zoomed = view.kind !== 'donut' && a.zoom !== null && (view.xDomain[0] > view.xFull[0] || view.xDomain[1] < view.xFull[1]);\n  1358\t    const legend = a.options.legend === false ? false : (['top', 'right', 'bottom'] as const).find(p => p === a.options.legend) ?? 'bottom';\n  1359\t    const controlsFor = (reader: ReaderModel, tooSmall: boolean): ControlsState => ({\n  1360\t      kind, view, formatters: formatters!, messages: a.messages, reader, tooSmall,\n  1361\t      ready: shown.kind === 'ready', interactive: !compact, tooltip: a.options.tooltip !== false, legend,\n  1362\t      // Series that could not be drawn are still rows: the table their sentence points to is offered.\n  1363\t      inspectable: (shown.kind === 'empty' || (shown.kind === 'error' && shown.message === 'seriesNotDrawn')) &&\n  1364\t        (reader.table?.rowCount ?? 0) > 0,\n  1365\t      empty: shown.kind === 'empty', message: shown.kind === 'ready' ? null : shown.text,\n  1366\t      zoom: zoomOn, zoomed, streaming, paused, epoch: a.frame.epoch, english, pageLang: lang, readout: readoutMode,\n  1367\t      // Decision 0004 revision 3, rule 5, for the interaction layer: 'floating', 'strip' or 'none'.\n  1368\t      readoutMode: readoutKind,