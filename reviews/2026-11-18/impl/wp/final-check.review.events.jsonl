s with it\n  1902\t   * (interaction review, part 1 item 2): the reader never pinned or dismissed the successor.\n  1903\t   */\n  1904\t  function remapper(before: View, after: View, exact = false): ((ref: DatumRef | null) => DatumRef | null) | null {\n  1905\t    const from = categoriesOf(before);\n  1906\t    const to = categoriesOf(after);\n  1907\t    if (!from || !to || (from.length === to.length && from.every((name, i) => to[i] === name))) return null;\n  1908\t    const index = new Map(to.map((name, i) => [name, i]));\n  1909\t    const move = (x: number): number | null => {\n  1910\t      for (let i = x; i < from.length; i++) {\n  1911\t        const at = index.get(from[i]!);\n  1912\t        if (at !== undefined) return at;\n  1913\t        if (exact) return null;\n  1914\t      }\n  1915\t      return null;\n  1916\t    };\n  1917\t    return ref => {\n  1918\t      if (ref === null || ref.kind !== 'aligned') return ref;\n  1919\t      const x = move(ref.x);\n  1920\t      return x === null ? null : { ...ref, x };\n  1921\t    };\n  1922\t  }\n  1923\t\n  1924\t  function remapTarget(target: PickTarget | null, map: (ref: DatumRef | null) => DatumRef | null): PickTarget | null {\n  1925\t    if (target === null || target.kind !== 'x') return target;\n  1926\t    const moved = map({ kind: 'aligned', seriesKey: '', x: target.x });\n  1927\t    return moved && moved.kind === 'aligned' ? { kind: 'x', x: moved.x } : null;\n  1928\t  }\n  1929\t\n  1930\t  function remapIdentity(id: Identity | null, map: (ref: DatumRef | null) => DatumRef | null): Identity | null {\n  1931\t    if (id === null || id.kind !== 'x') return id;\n  1932\t    const moved = map({ kind: 'aligned', seriesKey: '', x: id.x });\n  1933\t    return moved && moved.kind === 'aligned' ? { kind: 'x', x: moved.x } : null;\n  1934\t  }\n  1935\t\n  1936\t  /**\n  1937\t   * Rule 8: a pin is one datum. It is kept while that datum is displayed, with the rows that share its\n  1938\t   * position now