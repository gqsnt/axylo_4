{"type":"item.completed","item":{"id":"item_41","type":"command_execution","command":"/bin/bash -lc 'git show 9f9eeef:packages/axylo/test/core/round3.test.ts | nl -ba'","aggregated_output":"     1\t/**\n     2\t * Round 3: the narrow cross-provider re-check of the blocking defects (reviews/2026-11-18/impl/wp/blockers-recheck.review.md),\n     3\t * the controller's items, each as the reviewer's sequence. Expected values come from the spec, the fixture\n     4\t * rows and the retention policy's stated bound (twice what was on screen when the shown rows last changed,\n     5\t * plus 8).\n     6\t */\n     7\timport { describe, expect, it } from 'vitest';\n     8\timport type { AlignedView, DatumRef, ScatterView } from '../../src/core/contracts';\n     9\timport type { Diagnostic, Point } from '../../src/public';\n    10\timport { lastModel, record, type Recording } from './host';\n    11\t\n    12\tconst rowsOf = (values: readonly number[]) => values.map(x => ({ x, y: x * 10 }));\n    13\tconst ref = (x: number, seriesKey = 'y'): DatumRef => ({ kind: 'aligned', seriesKey, x });\n    14\tconst xsOf = (r: Recording) => Array.from((r.committed!.view as AlignedView).frame.x.values);\n    15\tconst codes = (r: Recording) => r.controller.handle.diagnostics.map(d => d.code);\n    16\t\n    17\tfunction hoverPoint(r: Recording, target: DatumRef): Point<unknown> | null | undefined {\n    18\t  let seen: Point<unknown> | null | undefined;\n    19\t  const off = r.controller.handle.on('hover', p => { seen = p; });\n    20\t  r.controller.actions.hover(null);\n    21\t  r.controller.actions.hover(target);\n    22\t  r.frames(1);\n    23\t  off();\n    24\t  return seen;\n    25\t}\n    26\t\n    27\tdescribe('C2: retention while paused across hide and show', () => {\n    28\t  it('x=2 drawn with keep 1, Pause, then 100 cycles of hide, append with keep 1, show: within the bound; Resume shows the newest row', () => {\n    29\t    const r = record('line', { title: 'K', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n    30\t    r.frames();\n    31\t    r.controller.handle.append([{ x: 2, y: 20 }], { keep: 1 });\n    32\t    r.frames();\n    33\t    const baseline = r.controller.handle.__dev!.retainedRows();\n    34\t    r.controller.actions.pause(true);\n    35\t    let most = 0;\n    36\t    for (let x = 3; x < 103; x++) {\n    37\t      r.container = null;\n    38\t      r.controller.invalidate.resize();\n    39\t      r.frames();\n    40\t      r.controller.handle.append([{ x, y: x * 10 }], { keep: 1 });\n    41\t      r.container = { width: 720, height: 400 };\n    42\t      r.controller.invalidate.resize();\n    43\t      r.frames();\n    44\t      expect(xsOf(r)).toEqual([2]);\n    45\t      most = Math.max(most, r.controller.handle.__dev!.retainedRows());\n    46\t    }\n    47\t    expect(most).toBeLessThanOrEqual(2 * baseline + 8);\n    48\t    expect(hoverPoint(r, ref(2))?.row).toEqual({ x: 2, y: 20 });\n    49\t    r.controller.actions.pause(false);\n    50\t    r.frames();\n    51\t    expect(xsOf(r)).toEqual([102]);\n    52\t    expect(hoverPoint(r, ref(102))?.row).toEqual({ x: 102, y: 1020 });\n    53\t  });\n    54\t});\n    55\t\n    56\tdescribe('C4 remainder: re-encoding while paused validates the displayed window too', () => {\n    57\t  it('strict: a field only the held rows have is rejected, and the plot on screen stays', () => {\n    58\t    const r = record('line', { title: 'S', strict: true, data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n    59\t    r.frames();\n    60\t    r.controller.handle.append([{ x: 3, y: 30 }]);\n    61\t    r.frames();\n    62\t    r.controller.actions.pause(true);\n    63\t    // Held with keep 1: the store's retained rows all have w, the rows on screen none.\n    64\t    r.controller.handle.append([{ x: 4, y: 40, w: 4 }], { keep: 1 });\n    65\t    // AX101 for the rows on screen: they have no field w (spec 3.5).\n    66\t    expect(() => r.controller.handle.update({ y: 'w' })).toThrow(/AX101/);\n    67\t    r.frames();\n    68\t    expect(xsOf(r)).toEqual([0, 1, 2, 3]);\n    69\t    expect(lastModel(r).message).toBeNull();\n    70\t  });\n    71\t\n    72\t  it('not strict: the same re-encoding reports AX101 for what is on screen', () => {\n    73\t    const r = record('line', { title: 'N', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n    74\t    r.frames();\n    75\t    r.controller.handle.append([{ x: 3, y: 30 }]);\n    76\t    r.frames();\n    77\t    r.controller.actions.pause(true);\n    78\t    r.controller.handle.append([{ x: 4, y: 40, w: 4 }], { keep: 1 });\n    79\t    r.controller.handle.update({ y: 'w' });\n    80\t    r.frames();\n    81\t    expect(codes(r)).toContain('AX101');\n    82\t  });\n    83\t\n    84\t  it('a retained imputed-zero row behind an evicted source index is re-read while paused', () => {\n    85\t    // missing: 'zero' makes y null a value of 0, and on a line such a slot refers to no source row. Keep 3\n    86\t    // after x 7 arrives keeps x 10 (index 0, y null), 5 (index 2) and 7 (index 3); x 1 at index 1 is evicted.\n    87\t    const data = [{ x: 10, y: null, u: 3 }, { x: 1, y: 1, u: 1 }, { x: 5, y: 1, u: 2 }];\n    88\t    const r = record('line', { title: 'Z', data, x: 'x', y: { field: 'y', missing: 'zero' } });\n    89\t    r.frames();\n    90\t    r.controller.handle.append([{ x: 7, y: 2, u: 2 }], { keep: 3 });\n    91\t    r.frames();\n    92\t    const shown = () => {\n    93\t      const view = r.committed!.view as AlignedView;\n    94\t      const s = view.frame.series[0]!;\n    95\t      return Array.from(view.frame.x.values, (x, i) => [x, s.y[i]]);\n    96\t    };\n    97\t    const before = shown();\n    98\t    expect(before.map(p => p[0])).toEqual([5, 7, 10]);\n    99\t    r.controller.actions.pause(true);\n   100\t    r.controller.handle.append([{ x: 12, y: 4, u: 4 }], { keep: 3 });\n   101\t    r.controller.handle.update({ y: { field: 'u', missing: 'zero' } });\n   102\t    r.frames();\n   103\t    // The same x on screen, each read with u.\n   104\t    expect(shown().map(p => p[0])).toEqual(before.map(p => p[0]));\n   105\t    expect(shown().find(p => p[0] === 10)?.[1]).toBe(3);\n   106\t  });\n   107\t\n   108\t  it('R7: x 10000 kept with the newest of 1,000 late arrivals (keep 2): re-encoding reads the two rows, not 1,002 indexes', () => {\n   109\t    const r = record('scatter', { title: 'L', data: [{ x: 10_000, y: 1 }], x: 'x', y: 'y' });\n   110\t    r.frames();\n   111\t    for (let i = 0; i < 1000; i++) r.controller.handle.append([{ x: i, y: 2 }], { keep: 2 });\n   112\t    r.frames();\n   113\t    const frame = (r.committed!.view as ScatterView).frame;\n   114\t    expect(frame.series.flatMap(s => Array.from(s.x)).sort((p, q) => p - q)).toEqual([999, 10_000]);\n   115\t    const source = frame.source as { rowAt(row: number): unknown };\n   116\t    const original = source.rowAt.bind(source);\n   117\t    let reads = 0;\n   118\t    source.rowAt = row => { reads++; return original(row); };\n   119\t    r.controller.actions.pause(true);\n   120\t    r.controller.handle.append([{ x: 1000, y: 3 }], { keep: 2 });\n   121\t    r.controller.handle.update({ y: { field: 'y', label: 'Renamed' } });\n   122\t    r.frames();\n   123\t    expect(reads).toBeLessThanOrEqual(10);\n   124\t  });\n   125\t});\n   126\t\n   127\tdescribe('C6 remainder: a throwing option getter under strict', () => {\n   128\t  it('strict: an update whose option getter throws is rejected, and the chart stays as it was', () => {\n   129\t    const r = record('line', { title: 'S', strict: true, data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   130\t    r.frames();\n   131\t    const patch = { get title(): string { throw new Error('option getter'); } };\n   132\t    expect(() => r.controller.handle.update(patch)).toThrow();\n   133\t    r.frames();\n   134\t    expect(codes(r)).not.toContain('AX199');\n   135\t    expect(lastModel(r).message).toBeNull();\n   136\t    expect(lastModel(r).title?.text).toBe('S');\n   137\t  });\n   138\t});\n   139\t\n   140\tdescribe('C7 remainder and R6: the hover payload reads the frame, not the caller\\'s rows', () => {\n   141\t  it('50,000 coincident points: hovering the latest reads a few row indexes', () => {\n   142\t    const n = 50_000;\n   143\t    const r = record('scatter', { title: 'C', data: Array.from({ length: n }, () => ({ x: 1, y: 1 })), x: 'x', y: 'y' });\n   144\t    r.frames();\n   145\t    const series = (r.committed!.view as ScatterView).frame.series[0]!;\n   146\t    const rows = series.row!;\n   147\t    // The pointer's pick, as the interaction layer hands it on: the latest source row wins a tie.\n   148\t    const layout = r.layout!;\n   149\t    if (layout.kind !== 'plot' || layout.projection.kind !== 'xy') throw new Error('expected a plot');\n   150\t    const pick = r.committed!.lookup.pick(layout.projection.x.map(1), layout.projection.y.map(1));\n   151\t    if (pick?.kind !== 'point') throw new Error('expected a point');\n   152\t    const target = pick.refs[0]!;\n   153\t    expect(target.kind === 'point' && target.row).toBe(n - 1);\n   154\t    let reads = 0;\n   155\t    const counted = new Proxy(rows, { get(t, key) { if (typeof key === 'string' && /^\\d+$/.test(key)) reads++; const v = Reflect.get(t, key, t); return typeof v === 'function' ? v.bind(t) : v; } });\n   156\t    Object.defineProperty(series, 'row', { value: counted, configurable: true });\n   157\t    const point = hoverPoint(r, target);\n   158\t    expect(point?.y).toBe(1);\n   159\t    expect(point?.index).toBe(n - 1);\n   160\t    expect(reads).toBeLessThanOrEqual(4);\n   161\t  });\n   162\t\n   163\t  it('a row getter that throws once drawn: hover still delivers the point, with its normalized x and y', () => {\n   164\t    let armed = false;\n   165\t    const row = { get x(): number { if (armed) throw new Error('later'); return 2; }, get y(): number { if (armed) throw new Error('later'); return 5; } };\n   166\t    const r = record('scatter', { title: 'G', data: [{ x: 1, y: 1 }, row], x: 'x', y: 'y' });\n   167\t    r.frames();\n   168\t    armed = true;\n   169\t    const series = (r.committed!.view as ScatterView).frame.series[0]!;\n   170\t    const errors: unknown[] = [];\n   171\t    let point: Point<unknown> | null | undefined;\n   172\t    r.controller.handle.on('hover', p => { point = p; });\n   173\t    try {\n   174\t      r.controller.actions.hover({ kind: 'point', seriesKey: series.key, row: 1, x: 2 });\n   175\t      r.frames(1);\n   176\t    } catch (error) {\n   177\t      errors.push(error);\n   178\t    }\n   179\t    expect(errors).toEqual([]);\n   180\t    expect(point?.x).toBe(2);\n   181\t    expect(point?.y).toBe(5);\n   182\t    expect(point?.index).toBe(1);\n   183\t  });\n   184\t});\n   185\t\n   186\tdescribe('R11: the strip\\'s height follows the page after a resize', () => {\n   187\t  // The plot's height without a strip, laid out at a container height (the caption and controls take theirs).\n   188\t  const plotHeightAt = (height: number) => {\n   189\t    const r = record('line', { title: 'S', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' }, { container: { width: 600, height } });\n   190\t    r.frames();\n   191\t    const l = r.layout!;\n   192\t    return l.kind === 'plot' ? l.plot.height : -1;\n   193\t  };\n   194\t  const containerFor = (plot: number) => {\n   195\t    for (let h = 120; h < 400; h += 0.5) if (plotHeightAt(h) >= plot) return h;\n   196\t    throw new Error('no container');\n   197\t  };\n   198\t  const mode = (r: Recording) => (r.prepared.at(-1) as unknown as { readoutMode?: string }).readoutMode;\n   199\t\n   200\t  it('a 135 px plot with a 98 px strip, then 134 px while responsive CSS makes the strip 48 px: the strip is reserved', () => {\n   201\t    let strip = 98;\n   202\t    const r = record('line', { title: 'S', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' }, { container: { width: 600, height: containerFor(135) }, strip: () => strip });\n   203\t    r.frames();\n   204\t    // 135 − 98 leaves less than 80 px: no strip and no tooltip (rule 5).\n   205\t    expect(mode(r)).toBe('none');\n   206\t    strip = 48;\n   207\t    r.container = { width: 600, height: containerFor(134) };\n   208\t    r.controller.invalidate.resize();\n   209\t    r.frames();\n   210\t    // 134 − 48 = 86 px, at least 80: the strip, as a fresh chart at that size has it.\n   211\t    const fresh = record('line', { title: 'S', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' }, { container: { width: 600, height: containerFor(134) }, strip: 48 });\n   212\t    fresh.frames();\n   213\t    expect(mode(fresh)).toBe('strip');\n   214\t    expect(mode(r)).toBe('strip');\n   215\t    expect(r.layout!.kind).toBe('plot');\n   216\t  });\n   217\t});\n   218\t\n   219\tdescribe('R12: AX160 comes from the tick sets drawn, not from unused coarser candidates', () => {\n   220\t  it('a wide scatter on x 1.1, 8.9, 10.7 with an x tick formatter that throws above 12: no AX160', () => {\n   221\t    const tickFormat = (v: number) => { if (v > 12) throw new Error('above 12'); return String(v); };\n   222\t    const seen: string[] = [];\n   223\t    const r = record('scatter', {\n   224\t      title: 'W', data: [{ x: 1.1, y: 1 }, { x: 8.9, y: 2 }, { x: 10.7, y: null }], x: { field: 'x', tickFormat }, y: 'y',\n   225\t      onDiagnostic: (d: Diagnostic) => seen.push(d.code),\n   226\t    });\n   227\t    r.frames();\n   228\t    const layout = r.layout!;\n   229\t    if (layout.kind !== 'plot') throw new Error('expected a plot');\n   230\t    // Every drawn tick is at most 12, so the formatter formatted each of them.\n   231\t    expect(layout.xTicks.every(t => t.value <= 12)).toBe(true);\n   232\t    expect(codes(r)).not.toContain('AX160');\n   233\t    expect(seen).not.toContain('AX160');\n   234\t  });\n   235\t\n   236\t  it('a formatter that throws for a drawn tick still reports AX160', () => {\n   237\t    const tickFormat = (v: number) => { if (v === 0) throw new Error('zero'); return String(v); };\n   238\t    const r = record('scatter', { title: 'W', data: [{ x: 1.1, y: 1 }, { x: 8.9, y: 2 }], x: { field: 'x', tickFormat }, y: 'y' });\n   239\t    r.frames();\n   240\t    const layout = r.layout!;\n   241\t    if (layout.kind !== 'plot') throw new Error('expected a plot');\n   242\t    expect(layout.xTicks.some(t => t.value === 0)).toBe(true);\n   243\t    expect(codes(r)).toContain('AX160');\n   244\t  });\n   245\t});\n   246\t\n   247\tdescribe('R8 (controller half): zoom() clamps to the x domain that is drawn', () => {\n   248\t  it('a 195 px scatter on x −3.3, 7.7, 1001.5 drawn on a coarser domain: zoom to −1000…1500 is a window of it', () => {\n   249\t    const r = record('scatter', { title: 'R', data: [{ x: -3.3, y: 1 }, { x: 7.7, y: 2 }, { x: 1001.5, y: null }], x: 'x', y: 'y' }, { container: { width: 195, height: 400 } });\n   250\t    r.frames();\n   251\t    const layout = r.layout!;\n   252\t    if (layout.kind !== 'plot' || layout.projection.kind !== 'xy' || layout.projection.x.type === 'band') throw new Error('expected a plot');\n   253\t    const drawn = layout.projection.x.domain;\n   254\t    // The layout widened the automatic domain to end at ticks a narrow plot can draw (F7).\n   255\t    expect(drawn).not.toEqual((r.committed!.view as ScatterView).xFull);\n   256\t    expect(drawn[0]).toBeLessThanOrEqual(-1000);\n   257\t    expect(drawn[1]).toBeGreaterThan(1500);\n   258\t    let event: unknown = 'none';\n   259\t    r.controller.handle.on('zoom', w => { event = w; });\n   260\t    r.controller.handle.zoom([-1000, 1500]);\n   261\t    r.frames();\n   262\t    const view = r.committed!.view as ScatterView;\n   263\t    expect(view.xDomain).toEqual([-1000, 1500]);\n   264\t    expect(event).toEqual([-1000, 1500]);\n   265\t    // The bounds gestures read are the drawn domain too.\n   266\t    expect(view.xFull).toEqual(drawn);\n   267\t  });\n   268\t});\n   269\t\n   270\tdescribe('R13: memory() leaves the caller\\'s columns out of every frame it counts', () => {\n   271\t  it('a line from two 10-entry Float64Array columns, before the first frame: only the 10 bytes of slot states', () => {\n   272\t    const columns = { x: Float64Array.from({ length: 10 }, (_, i) => i), y: Float64Array.from({ length: 10 }, (_, i) => i * 2) };\n   273\t    const r = record('line', { title: 'M', data: { columns }, x: 'x', y: 'y' });\n   274\t    const memory = r.controller.handle.__bench!.memory();\n   275\t    // The borrowed x and y (80 bytes each) are the caller's; one Uint8Array of 10 slot states is the chart's.\n   276\t    expect(memory.bytes).toBe(10);\n   277\t  });\n   278\t});\n","exit_code":0,"status":"completed"}}
