{"type":"item.completed","item":{"id":"item_114","type":"command_execution","command":"/bin/bash -lc \"git show 9f9eeef:packages/axylo/src/scale/nice.ts | nl -ba | sed -n '1,203p'\"","aggregated_output":"     1\t/**\n     2\t * Nice steps: 1, 2 or 5 times a power of ten. Multiples of a step are computed from integers so that\n     3\t * 3 × 0.1 comes out as 0.3, not 0.30000000000000004, and ticks compare exactly with domain ends.\n     4\t */\n     5\t\n     6\texport interface NiceStep {\n     7\t  /** 1, 2 or 5. */\n     8\t  readonly mantissa: 1 | 2 | 5;\n     9\t  readonly exponent: number;\n    10\t  /** mantissa × 10^exponent as a number. */\n    11\t  readonly value: number;\n    12\t}\n    13\t\n    14\tfunction make(mantissa: 1 | 2 | 5, exponent: number): NiceStep {\n    15\t  return { mantissa, exponent, value: multiple(1, mantissa, exponent) };\n    16\t}\n    17\t\n    18\tfunction multiple(i: number, mantissa: number, exponent: number): number {\n    19\t  const n = i * mantissa;\n    20\t  // Dividing an exact integer by an exact power of ten gives the double nearest the decimal value.\n    21\t  if (exponent >= 0) return n * 10 ** exponent;\n    22\t  if (exponent >= -300) return n / 10 ** -exponent;\n    23\t  return n * 10 ** exponent;\n    24\t}\n    25\t\n    26\t/** The smallest nice step at or above `x` (x > 0 and finite). */\n    27\texport function niceStepAtLeast(x: number): NiceStep {\n    28\t  const exponent = Math.floor(Math.log10(x));\n    29\t  const base = 10 ** exponent;\n    30\t  const r = x / base;\n    31\t  // Tolerance: log10 and the division are off by an ulp or two for values like 0.2 or 5e-7.\n    32\t  const tol = 1 + 1e-9;\n    33\t  if (r <= tol) return make(1, exponent);\n    34\t  if (r <= 2 * tol) return make(2, exponent);\n    35\t  if (r <= 5 * tol) return make(5, exponent);\n    36\t  return make(1, exponent + 1);\n    37\t}\n    38\t\n    39\t/** The next coarser nice step. */\n    40\texport function nextNiceStep(s: NiceStep): NiceStep {\n    41\t  if (s.mantissa === 1) return make(2, s.exponent);\n    42\t  if (s.mantissa === 2) return make(5, s.exponent);\n    43\t  return make(1, s.exponent + 1);\n    44\t}\n    45\t\n    46\t/** i × step, cleaned. */\n    47\texport function stepMultiple(i: number, s: NiceStep): number {\n    48\t  const v = multiple(i, s.mantissa, s.exponent);\n    49\t  return v === 0 ? 0 : v; // no -0\n    50\t}\n    51\t\n    52\t/**\n    53\t * Index of the first multiple of the step at or above x. The quotient is off by at most an index or two\n    54\t * from rounding, so the estimate starts at the plain quotient and is corrected by comparing the actual\n    55\t * multiples with x. (A relative tolerance on the quotient would move a large index by dozens of steps.)\n    56\t */\n    57\texport function firstIndexAtOrAbove(x: number, s: NiceStep): number {\n    58\t  let i = Math.ceil(x / s.value);\n    59\t  // Bounded: where the step is below the resolution of x, neighbouring multiples are the same double.\n    60\t  for (let n = 0; n < 8 && stepMultiple(i, s) < x; n++) i++;\n    61\t  for (let n = 0; n < 8 && stepMultiple(i - 1, s) >= x; n++) i--;\n    62\t  return i;\n    63\t}\n    64\t\n    65\t/** Index of the last multiple of the step at or below x. */\n    66\texport function lastIndexAtOrBelow(x: number, s: NiceStep): number {\n    67\t  let i = Math.floor(x / s.value);\n    68\t  for (let n = 0; n < 8 && stepMultiple(i, s) > x; n++) i--;\n    69\t  for (let n = 0; n < 8 && stepMultiple(i + 1, s) <= x; n++) i++;\n    70\t  return i;\n    71\t}\n    72\t\n    73\t/** Most ticks in the densest candidate set. Layout never fits more on a readable axis. */\n    74\texport const MAX_TICKS = 12;\n","exit_code":0,"status":"completed"}}
