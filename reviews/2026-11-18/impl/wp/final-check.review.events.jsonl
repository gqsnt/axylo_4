 (...args) {\n    store = this;\n    return original.apply(this, args);\n  };\n  try {\n    r.frames();\n    h.append([{ x: 101, y: 1 }], { keep: 1 });\n    r.frames();\n    r.controller.actions.pause(true);\n    for (let i = 0; i < 100; i++) {\n      hideCycle(r, () => h.append([{ x: 0, y: i }], { keep: 1 }));\n    }\n    const count = store.revisions.current.sources.size;\n    assert.equal(h.__dev.retainedRows(), 1);\n    assert.equal(count, 101);\n    r.controller.actions.pause(false);\n    r.frames();\n    assert.equal(store.revisions.current.sources.size, 1);\n    return \"1 retained row, \" + count + \" revision sources, back to 1 on Resume\";\n  } finally {\n    PointStore.prototype.prepareAppend = original;\n  }\n});\ncheck(\"Scatter zoom after append\", () => {\n  const r = record(\"scatter\", {\n    title: \"Test\", data: [{ x: -3.3, y: 1 }, { x: 7.7, y: 2 }, { x: 1001.5, y: null }], x: \"x\", y: \"y\",\n  }, { container: { width: 195, height: 400 } });\n  r.frames();\n  const initiallyDrawn = r.layout.projection.x.domain;\n  r.controller.handle.zoom([-1000, 1500]);\n  r.frames();\n  expectArray(r.committed.view.xDomain, [-1000, 1500]);\n  r.controller.handle.append([{ x: 1600, y: 3 }]);\n  r.frames();\n  expectArray(r.committed.view.xDomain, [-500, 2000]);\n  const series = r.committed.view.frame.series[0];\n  const { start, end } = r.committed.view.visiblePoints[0];\n  assert.ok(Array.from(series.x.subarray(start, end)).includes(1600));\n  return \"drawn \" + JSON.stringify(initiallyDrawn) + \", zoom [-1000,1500] then \" + JSON.stringify(r.committed.view.xDomain);\n});\ncheck(\"AX160 note and layout feedback with resize callbacks\", () => {\n  const trace = [];\n  const r = record(\"line\", {\n    title: \"Test\", data: [{ x: 0, y: 0 }, { x: 10, y: 10 }], x: \"x\", y: { field: \"y\", domain: [0, 10],\n      tickFormat: value => { if (value === 2) throw new Error(\"at 2\"); return String(value); },\n    }, tooltip: false, legend: false, table: false,\n  }, { container: { width: 720, height: 234 } });\n  for (let i = 0; i < 4; i++) {\n    r.frames();\n    trace.push({\n      plot: r.layout.plot.height, contains2: r.layout.yTicks.some(tick => tick.value === 2),\n      note: lastModel(r).note !== null, ax160: r.controller.handle.diagnostics.some(d => d.code === \"AX160\"),\n    });\n    r.controller.invalidate.resize();\n  }\n  expectArray(trace.map(p => p.contains2), [true, false, true, false]);\n  expectArray(trace.map(p => p.note), [true, false, true, false]);\n  expectArray(trace.map(p => p.ax160), [true, false, true, false]);\n  return JSON.stringify(trace);\n});\ncheck(\"Rebuilt scatter pin and page offsets\", () => {\n  const r = record(\"scatter\", {\n    title: \"Test\", data: [{ x: 30, y: 50 }], x: { field: \"x\", domain: [0, 100] },\n    y: { field: \"y\", domain: [0, 100] }, legend: false,\n  });\n  r.frames();\n  const plot = r.layout.plot;\n  const scale = r.layout.projection.x;\n  const [c, b, p] = [150, 150.4, 150.8].map(offset => scale.invert(plot.x + offset));\n  r.controller.handle.update({ data: [{ x: p, y: 50 }] });\n  r.frames();\n  const r0 = r.committed.lookup.pick(plot.x + 150.8, r.layout.projection.y.map(50)).refs[0];\n  r.controller.handle.append([...Array.from({ length: 8 }, () => ({ x: c, y: 50 })), { x: b, y: 50 }]);\n  r.frames();\n  const { lookup } = r.committed;\n  const anchor = lookup.anchor(r0);\n  const picked = lookup.pick(anchor.x, anchor.y);\n  assert.equal(picked.count, 10);\n  assert.equal(picked.refs[0].row, 9);\n  assert.ok(!picked.refs.some(ref => ref.row === 0));\n  const rebuilt = { ...picked, refs: [r0, ...picked.refs.slice(0, picked.refs.length - 1)] };\n  expectArray(lookup.members(rebuilt, 0, 8).map(ref => ref.row), [0, 9]);\n  assert.equal(lookup.members(rebuilt, 8, 8).length, 0);\n  assert.equal(lookup.members(picked, 8, 8).length, 2);\n  return \"pick count 10, rebuilt anchor has 2 members and an empty second page\";\n});\ncheck(\"Aligned all-series x formatter change\", () => {\n  const r = record(\"bar\", { title: \"Test\", data: [{ x: \"Q1\", y: 1 }, { x: \"Q2\", y: 2 }], x: \"x\", y: \"y\" });\n  r.frames();\n  const get = () => {\n    const { view, lookup, messages, formatters } = r.committed;\n    const ref = { kind: \"aligned\", x: 0, seriesKey: view.frame.series[0].key };\n    return [datumReading(view, lookup, ref, \"all\", formatters, messages), valueText(view, lookup, ref, \"all\", formatters, messages)];\n  };\n  const before = get();\n  r.controller.handle.update({ x: { field: \"x\", format: value => \"Quarter \" + value } });\n  r.frames();\n  const after = get();\n  assert.equal(before[0], after[0]);\n  assert.ok(!before[1].includes(\"Quarter\") && after[1].includes(\"Quarter Q1\"));\n  return '\"'\\\"'\\\"'same reading key for \\\"'\\\"'\\\"' + before[1] + '\\\"'\\\"'\\\" and \\\"'\\\"'\\\"' + after[1] + '\\\"'\\\"'\\\"'\\\"'\\\"';\n});\nconsole.log(checked + \\\" of 6 read-only Node probes matched expectations at \\\" + revision);\n'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
