tance && left >= start) {\n   152\t        hi = left + 1;\n   153\t        lo = left > start && entry.x[left] === entry.x[left - 1]\n   154\t          ? lowerBound(entry.x, entry.x[left]!, start, hi) : left;\n   155\t        left = lo - 1;\n   156\t      } else {\n   157\t        lo = right;\n   158\t        hi = right + 1 < end && entry.x[right] === entry.x[right + 1]\n   159\t          ? upperBound(entry.x, entry.x[right]!, right, end) : right + 1;\n   160\t        right = hi;\n   161\t      }\n   162\t      if (lo + 1 === hi || flatY) {\n   163\t        consider(lo, distance);\n   164\t      } else {\n   165\t        const middle = lowerBound(entry.y, fromY, lo, hi);\n   166\t        if (middle < hi) consider(middle, distance);\n   167\t        if (middle > lo) consider(lowerBound(entry.y, entry.y[middle - 1]!, lo, middle), distance);\n   168\t      }\n   169\t    }\n   170\t    return ref(s, nearest);\n   171\t  }\n   172\t\n   173\t  /** A datum's place in the pointer index, -1 when it is not drawn on the plot (hidden, outside the view). */\n   174\t  function gridAt(datum: DatumRef | undefined): number {\n   175\t    const point = datum && locate(datum);\n   176\t    if (!grid || !point) return -1;\n   177\t    const { start, end } = ranges[point.series]!;\n   178\t    return point.index >= start && point.index < end ? grid.at(point.series, point.index) : -1;\n   179\t  }\n   180\t\n   181\t  function toRef(point: PointIndex | null): DatumRef | null {\n   182\t    return point ? ref(point.series, point.index) : null;\n   183\t  }\n   184\t\n   185\t  return {\n   186\t    pick(px, py) {\n   187\t      const picked = grid?.pick(px, py);\n   188\t      return grid && picked ? {\n   189\t        kind: 'point', refs: picked.hits.map(i => ref(grid.series[i]!, grid.points[i]!)), count: picked.count,\n   190\t        // The contract's default when absent is the exact rule.\n   191\t        ...grid.usedLattice && { rule: 'lattice' as const },\n   192\t      } : null;\