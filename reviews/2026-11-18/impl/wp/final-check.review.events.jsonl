 cats.flatMap(x => names.map((s, i) => ({ x, s, y: i + 1 }))), x: 'x', y: 'y', series: 's' });\n   236\t    const p = await plotBox(page);\n   237\t    await clickAt(page, { x: p.x + p.width / 4, y: p.y + p.height - 4 });\n   238\t    const s = await stripParts(page);\n   239\t    if (!s.hidden) {\n   240\t      expect(s.parts.length).toBeGreaterThanOrEqual(2);\n   241\t      expect(s.parts.every(Boolean), JSON.stringify(s)).toBe(true);\n   242\t    }\n   243\t    expect(await closePage(page)).toEqual([]);\n   244\t  });\n   245\t\n   246\t  it('a strip of which a card leaves only a sliver visible is not shown', async () => {\n   247\t    const page = await chartPage({ css: '#card { width: 220px; overflow: hidden; } #card #chart { width: 220px; height: 400px; }' });\n   248\t    await page.evaluate(() => {\n   249\t      const card = Object.assign(document.createElement('div'), { id: 'card' });\n   250\t      const chart = document.getElementById('chart')!;\n   251\t      chart.replaceWith(card);\n   252\t      card.appendChild(chart);\n   253\t    });\n   254\t    await create(page, 'line', { title: 'S', legend: false, table: false, data: [0, 1, 2].map(x => ({ x, y: x })), x: 'x', y: 'y' });\n   255\t    const p = await plotBox(page);\n   256\t    const card = (await page.locator('#card').boundingBox())!;\n   257\t    // 5 px of the strip (under the plot and its axis) are inside the card.\n   258\t    const s0 = (await strip(page)).box;\n   259\t    await page.evaluate(h => { document.getElementById('card')!.style.height = `${h}px`; }, s0.y + 5 - card.y);\n   260\t    await settle(page);\n   261\t    await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   262\t    await settle(page);\n   263\t    expect((await strip(page)).text).toBeNull();\n   264\t    expect(await closePage(page)).toEqual([]);\n   265\t  });\n   266\t});\n   267\t\n   268\tdescribe('item 6 (I5): clipping through a slot', () => {\n   269\t  it('a chart slotted into a component whose shadow wrapper clips: the tooltip stays inside the wrapper', async () => {\n   270\t    const page = await chartPage({ css: '#chart { width: 360px; height: 360px; }' });\n   271\t    await page.evaluate(() => {\n   272\t      const host = document.createElement('div');\n   273\t      const chart = document.getElementById('chart')!;\n   274\t      chart.replaceWith(host);\n   275\t      host.appendChild(chart);\n   276\t      const root = host.attachShadow({ mode: 'open' });\n   277\t      // The wrapper clips 60 px below the plot's top.\n   278\t      root.innerHTML = '<div id=\"wrap\" style=\"width: 360px; height: 140px; overflow: hidden;\"><slot></slot></div>';\n   279\t    });\n   280\t    await create(page, 'line', { title: 'Slot', legend: false, data: [0, 1, 2, 3].map(x => ({ x, y: 10 })), x: 'x', y: { field: 'y', domain: [0, 10] } });\n   281\t    const wrapBox = () => page.evaluate(() => {\n   282\t      const r = (document.querySelector('#chart')!.parentElement!.shadowRoot!.getElementById('wrap'))!.getBoundingClientRect();\n   283\t      return { x: r.x, y: r.y, width: r.width, height: r.height };\n   284\t    });\n   285\t    const p = await plotBox(page);\n   286\t    // The wrapper ends 60 px below the plot's top: below the points on that edge there is no room.\n   287\t    await page.evaluate(h => { (document.querySelector('#chart')!.parentElement!.shadowRoot!.getElementById('wrap') as HTMLElement).style.height = `${h}px`; }, p.y + 60 - (await wrapBox()).y);\n   288\t    await settle(page);\n   289\t    const wrap = await wrapBox();\n   290\t    await page.mouse.move(p.x + p.width / 3, p.y + 4);\n   291\t    await settle(page);\n   292\t    const t = (await tip(page)).box;\n   293\t    if (t) expect(t.y + t.height).toBeLessThanOrEqual(wrap.y + wrap.height + 0.5);\n   294\t    expect(await closePage(page)).toEqual([]);\n   295\t  });\n   296\t});\n   297\t\n   298\tdescribe('item 7 (R8): range gestures clamp to the domain the plot is drawn with', () => {\n   299\t  it('a narrow scatter drawn wider than its data: Select range from −1000 to 1500 asks for that zoom', async () => {\n   300\t    const page = await chartPage({ css: '#chart { width: 195px; height: 360px; }' });\n   301\t    await create(page, 'scatter', { title: 'N', data: [{ x: -3.3, y: 1 }, { x: 7.7, y: 2 }, { x: 1001.5, y: 3 }], x: 'x', y: 'y' });\n   302\t    const domainOf = () => page.evaluate(() => window.charts[0]!.__bench.describe().xDomain);\n   303\t    const before = await domainOf();\n   304\t    const p = await plotBox(page);\n   305\t    // The domain the plot is drawn with spans its width; −1000 and 1500 at their places in it.\n   306\t    const [lo, hi] = before as [number, number];\n   307\t    const xAt = (v: number) => p.x + ((v - lo) / (hi - lo)) * p.width;\n   308\t    await page.evaluate(() => { const w = window as unknown as { zooms: unknown[] }; w.zooms = []; window.charts[0]!.on('zoom', z => w.zooms.push(z)); });\n   309\t    const toggle = page.locator('#chart [role=\"toolbar\"] button[title=\"Select range\"]');\n   310\t    await toggle.click();\n   311\t    await clickAt(page, { x: xAt(-1000), y: p.y + p.height / 2 });\n   312\t    await clickAt(page, { x: xAt(1500), y: p.y + p.height / 2 });\n   313\t    // This layer's half: the two ends ask for a zoom (the selection is not taken for the whole range). Which\n   314\t    // domain the controller then clamps that window to is the controller's half of R8.\n   315\t    const zooms = await page.evaluate(() => (window as unknown as { zooms: unknown[] }).zooms);\n   316\t    expect(zooms).toHaveLength(1);\n   317\t    expect(zooms[0]).not.toBeNull();\n   318\t    void domainOf;\n   319\t    expect(await closePage(page)).toEqual([]);\n   320\t  });\n   321\t});\n   322\t\n   323\tdescribe('item 7 (R8): every zoom gesture works in the same bounds', () => {\n   324\t  it('the reviewer\\'s 195 px scatter, unzoomed: a wheel over the plot zooms around the pointer within the domain the plot is drawn with', async () => {\n   325\t    const page = await chartPage({ css: '#chart { width: 195px; height: 360px; }' });\n   326\t    await create(page, 'scatter', { title: 'N', data: [{ x: -3.3, y: 1 }, { x: 7.7, y: 2 }, { x: 1001.5, y: 3 }], x: 'x', y: 'y' });\n   327\t    await page.evaluate(() => { const w = window as unknown as { zooms: unknown[] }; w.zooms = []; window.charts[0]!.on('zoom', z => w.zooms.push(z)); });\n   328\t    const [lo, hi] = (await page.evaluate(() => window.charts[0]!.__bench.describe().xDomain)) as [number, number];\n   329\t    const p = await plotBox(page);\n   330\t    await page.locator(proxy).focus();\n   331\t    // At four fifths of the drawn width; one wheel step of −200 px scales the window by e^(−0.4).\n   332\t    const share = 0.8;\n   333\t    await page.mouse.move(p.x + share * p.width, p.y + p.height / 2);\n   334\t    await page.mouse.wheel(0, -200);\n   335\t    await settle(page);\n   336\t    const zooms = await page.evaluate(() => (window as unknown as { zooms: number[][] }).zooms);\n   337\t    expect(zooms).toHaveLength(1);\n   338\t    const at = lo + share * (hi - lo), width = (hi - lo) * Math.exp(-0.4);\n   339\t    const start = Math.max(lo, Math.min(at - share * width, hi - width));\n   340\t    const tolerance = (hi - lo) / p.width;\n   341\t    expect(Math.abs(zooms[0]![0]! - start)).toBeLessThanOrEqual(tolerance);\n   342\t    expect(Math.abs(zooms[0]![1]! - (start + width))).toBeLessThanOrEqual(tolerance);\n   343\t    expect(await closePage(page)).toEqual([]);\n   344\t  });\n   345\t});\n   346\t\n   347\tdescribe('item 8 (R9): the one-pixel tolerance is in viewport pixels', () => {\n   348\t  it('a chart scaled to 0.5 horizontally: a pointer at the whole viewport pixel left of the plot\\'s edge (up to 1 px outside) picks the mark on that edge', async () => {\n   349\t    const page = await chartPage({ css: '#wrap { transform: scale(0.5, 1); transform-origin: 0 0; width: 720px; }' });\n   350\t    await page.evaluate(() => {\n   351\t      const wrap = Object.assign(document.createElement('div'), { id: 'wrap' });\n   352\t      const chart = document.getElementById('chart')!;\n   353\t      chart.replaceWith(wrap);\n   354\t      wrap.appendChild(chart);\n   355\t    });\n   356\t    await create(page, 'scatter', { title: 'E', data: [{ x: 0, y: 5 }, { x: 10, y: 5 }], x: { field: 'x', domain: [0, 10] }, y: { field: 'y', domain: [0, 10] } });\n   357\t    await recordEvents(page);\n   358\t    const p = await plotBox(page);\n   359\t    // A whole pixel, as Firefox and WebKit deliver it: 0 to 1 viewport px outside, 0 to 2 layout px at 0.5.\n   360\t    await page.mouse.move(Math.ceil(p.x) - 1, Math.round(p.y + p.height / 2));\n   361\t    await settle(page);\n   362\t    expect(await lastHover(page)).toMatchObject({ x: 0 });\n   363\t    expect(await closePage(page)).toEqual([]);\n   364\t  });\n   365\t});\n   366\t\n   367\tdescribe('item 10 (R14): a redraw during a drag keeps the drag\\'s rectangle', () => {\n   368\t  it('Select range with its first end set, a drag, an append before release: the selection is the drag\\'s, not the 2 px marker', async () => {\n   369\t    const page = await chartPage();\n   370\t    await create(page, 'line', { title: 'R', data: Array.from({ length: 101 }, (_, i) => ({ x: i, y: i % 7 })), x: 'x', y: 'y' });\n   371\t    const p = await plotBox(page);\n   372\t    await page.locator('#chart [role=\"toolbar\"] button[title=\"Select range\"]').click();\n   373\t    await clickAt(page, { x: p.x + p.width * 0.8, y: p.y + p.height / 2 });\n   374\t    await page.mouse.move(p.x + p.width * 0.1, p.y + p.height / 2);\n   375\t    await page.mouse.down();\n   376\t    await page.mouse.move(p.x + p.width * 0.4, p.y + p.height / 2, { steps: 6 });\n   377\t    await page.evaluate(() => window.charts[0]!.append([{ x: 101, y: 3 }]));\n   378\t    await settle(page);\n   379\t    const sel = (await page.locator('#chart .axylo-selection').boundin