{"type":"item.started","item":{"id":"item_125","type":"command_execution","command":"/bin/bash -lc 'if [[ -n \"$(git status --short packages/axylo/src)\" ]]; then\n  printf '\"'%s\\\\n' 'Skipped Node checks because packages/axylo/src has uncommitted edits.'\n  exit 0\nfi\nnode --input-type=module <<'NODE'\nimport assert from 'node:assert/strict';\nimport { execFileSync } from 'node:child_process';\nimport { posix as path } from 'node:path';\nimport { build } from 'esbuild';\n\nconst revision = '9f9eeef';\nconst paths = new Set(execFileSync('git', [\n  'ls-tree', '-r', '--name-only', revision, '--', 'packages/axylo/src', 'packages/axylo/test/core/host.ts',\n], { encoding: 'utf8' }).trim().split('\\\\n'));\nconst result = await build({\n  stdin: {\n    contents: [\n      \\\"export { record, lastModel } from './packages/axylo/test/core/host.ts';\\\",\n      \\\"export { PointStore } from './packages/axylo/src/data/store-unaligned.ts';\\\",\n      \\\"export { datumReading, valueText } from './packages/axylo/src/core/focus.ts';\\\",\n    ].join('\\\\n'),\n    resolveDir: '.',\n  },\n  bundle: true,\n  platform: 'node',\n  format: 'cjs',\n  write: false,\n  define: { __DEV__: 'true' },\n  plugins: [{\n    name: 'pinned-blobs',\n    setup(plugin) {\n      plugin.onResolve({ filter: /\"'^'\"\\\\./ }, args => {\n        const name = path.join(path.dirname(args.importer || 'entry'), args.path);\n        const source = [name, name + '.ts', name + '/index.ts'].find(candidate => paths.has(candidate));\n        if (\"'!source) throw new Error('\"'Unresolved pinned source ' + name);\n        return { path: source, namespace: 'pinned' };\n      });\n      plugin.onLoad({ filter: /.*/, namespace: 'pinned' }, args => ({\n        contents: execFileSync('git', ['show', revision + ':' + args.path], { encoding: 'utf8' }),\n        loader: 'ts',\n      }));\n    },\n  }],\n});\nconst bundled = { exports: {} };\nnew Function('module', 'exports', result.outputFiles[0].text)(bundled, bundled.exports);\nconst { record, lastModel, PointStore, datumReading, valueText } = bundled.exports;\n\nlet checked = 0;\nfunction check(name, run) {\n  try {\n    console.log(name + ' — ' + run());\n    checked++;\n  } catch (error) {\n    console.error(name, error);\n    process.exitCode = 1;\n  }\n}\nfunction hideCycle(r, append) {\n  r.container = null;\n  r.controller.invalidate.resize();\n  r.frames();\n  append();\n  r.container = { width: 720, height: 400 };\n  r.controller.invalidate.resize();\n  r.frames();\n}\ncheck('C2 increasing x', () => {\n  const r = record('line', { title: 'Test', data: [{ x: 0, y: 0 }, { x: 1, y: 10 }], x: 'x', y: 'y' });\n  const h = r.controller.handle;\n  r.frames();\n  h.append([{ x: 2, y: 20 }], { keep: 1 });\n  r.frames();\n  const baseline = h.__dev.retainedRows();\n  r.controller.actions.pause(true);\n  let maximum = 0;\n  for (let x = 3; x < 103; x++) {\n    hideCycle(r, () => h.append([{ x, y: x * 10 }], { keep: 1 }));\n    assert.deepEqual([...r.committed.view.frame.x.values], [2]);\n    maximum = Math.max(maximum, h.__dev.retainedRows());\n  }\n  assert.ok(maximum <= 2 * baseline + 8);\n  r.controller.actions.pause(false);\n  r.frames();\n  assert.deepEqual([...r.committed.view.frame.x.values], [102]);\n  return 'max ' + maximum + ' retained rows, resumed at x=102';\n});\ncheck('C2 late x outside keep window', () => {\n  const r = record('scatter', { title: 'Test', data: [{ x: 100, y: 0 }], x: 'x', y: 'y' });\n  const h = r.controller.handle;\n  const original = PointStore.prototype.prepareAppend;\n  let store;\n  PointStore.prototype.prepareAppend = function (...args) {\n    store = this;\n    return original.apply(this, args);\n  };\n  try {\n    r.frames();\n    h.append([{ x: 101, y: 1 }], { keep: 1 });\n    r.frames();\n    r.controller.actions.pause(true);\n    for (let i = 0; i < 100; i++) {\n      hideCycle(r, () => h.append([{ x: 0, y: i }], { keep: 1 }));\n    }\n    const count = store.revisions.current.sources.size;\n    assert.equal(h.__dev.retainedRows(), 1);\n    assert.equal(count, 101);\n    r.controller.actions.pause(false);\n    r.frames();\n    assert.equal(store.revisions.current.sources.size, 1);\n    return '1 retained row, ' + count + ' revision sources, back to 1 on Resume';\n  } finally {\n    PointStore.prototype.prepareAppend = original;\n  }\n});\ncheck('Scatter zoom after append', () => {\n  const r = record('scatter', {\n    title: 'Test', data: [{ x: -3.3, y: 1 }, { x: 7.7, y: 2 }, { x: 1001.5, y: null }], x: 'x', y: 'y',\n  }, { container: { width: 195, height: 400 } });\n  r.frames();\n  const initiallyDrawn = r.layout.projection.x.domain;\n  r.controller.handle.zoom([-1000, 1500]);\n  r.frames();\n  assert.deepEqual(r.committed.view.xDomain, [-1000, 1500]);\n  r.controller.handle.append([{ x: 1600, y: 3 }]);\n  r.frames();\n  assert.deepEqual(r.committed.view.xDomain, [-500, 2000]);\n  const series = r.committed.view.frame.series[0];\n  const { start, end } = r.committed.view.visiblePoints[0];\n  assert.ok(Array.from(series.x.subarray(start, end)).includes(1600));\n  return 'drawn ' + JSON.stringify(initiallyDrawn) + ', zoom [-1000,1500] then ' + JSON.stringify(r.committed.view.xDomain);\n});\ncheck('AX160 note and layout feedback with resize callbacks', () => {\n  const trace = [];\n  const r = record('line', {\n    title: 'Test', data: [{ x: 0, y: 0 }, { x: 10, y: 10 }], x: 'x', y: { field: 'y', domain: [0, 10],\n      tickFormat: value => { if (value === 2) throw new Error('at 2'); return String(value); },\n    }, tooltip: false, legend: false, table: false,\n  }, { container: { width: 720, height: 234 } });\n  for (let i = 0; i < 4; i++) {\n    r.frames();\n    trace.push({\n      plot: r.layout.plot.height, contains2: r.layout.yTicks.some(tick => tick.value === 2),\n      note: lastModel(r).note \"'!== null, ax160: r.controller.handle.diagnostics.some(d => d.code === '\"'AX160'),\n    });\n    r.controller.invalidate.resize();\n  }\n  assert.deepEqual(trace.map(p => p.contains2), [true, false, true, false]);\n  assert.deepEqual(trace.map(p => p.note), [true, false, true, false]);\n  assert.deepEqual(trace.map(p => p.ax160), [true, false, true, false]);\n  return JSON.stringify(trace);\n});\ncheck('Rebuilt scatter pin and page offsets', () => {\n  const r = record('scatter', {\n    title: 'Test', data: [{ x: 30, y: 50 }], x: { field: 'x', domain: [0, 100] },\n    y: { field: 'y', domain: [0, 100] }, legend: false,\n  });\n  r.frames();\n  const plot = r.layout.plot;\n  const scale = r.layout.projection.x;\n  const [c, b, p] = [150, 150.4, 150.8].map(offset => scale.invert(plot.x + offset));\n  r.controller.handle.update({ data: [{ x: p, y: 50 }] });\n  r.frames();\n  const r0 = r.committed.lookup.pick(plot.x + 150.8, r.layout.projection.y.map(50)).refs[0];\n  r.controller.handle.append([...Array.from({ length: 8 }, () => ({ x: c, y: 50 })), { x: b, y: 50 }]);\n  r.frames();\n  const { lookup } = r.committed;\n  const anchor = lookup.anchor(r0);\n  const picked = lookup.pick(anchor.x, anchor.y);\n  assert.equal(picked.count, 10);\n  assert.equal(picked.refs[0].row, 9);\n  assert.ok(\"'!picked.refs.some(ref => ref.row === 0));\n  const rebuilt = { ...picked, refs: [r0, ...picked.refs.slice(0, picked.refs.length - 1)] };\n  assert.deepEqual(lookup.members(rebuilt, 0, 8).map(ref => ref.row), [0, 9]);\n  assert.equal(lookup.members(rebuilt, 8, 8).length, 0);\n  assert.equal(lookup.members(picked, 8, 8).length, 2);\n  return '\"'pick count 10, rebuilt anchor has 2 members and an empty second page';\n});\ncheck('Aligned all-series x formatter change', () => {\n  const r = record('bar', { title: 'Test', data: [{ x: 'Q1', y: 1 }, { x: 'Q2', y: 2 }], x: 'x', y: 'y' });\n  r.frames();\n  const get = () => {\n    const { view, lookup, messages, formatters } = r.committed;\n    const ref = { kind: 'aligned', x: 0, seriesKey: view.frame.series[0].key };\n    return [datumReading(view, lookup, ref, 'all', formatters, messages), valueText(view, lookup, ref, 'all', formatters, messages)];\n  };\n  const before = get();\n  r.controller.handle.update({ x: { field: 'x', format: value => 'Quarter ' + value } });\n  r.frames();\n  const after = get();\n  assert.equal(before[0], after[0]);\n  assert.ok(\"'!before[1].includes('\"'Quarter') && after[1].includes('Quarter Q1'));\n  return 'same reading key for \\\"' + before[1] + '\\\" and \\\"' + after[1] + '\\\"';\n});\nconsole.log(checked + ' of 6 read-only Node probes matched expectations at ' + revision);\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
