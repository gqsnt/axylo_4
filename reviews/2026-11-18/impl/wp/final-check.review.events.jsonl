{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'git show 9f9eeef:vitest.config.ts | nl -ba | cat'","aggregated_output":"     1\timport { defineConfig } from 'vitest/config';\n     2\t\n     3\t// Unit and property tests run in Node. Browser tests (*.browser.test.ts) drive system Chrome through\n     4\t// Playwright against the built bundle: run `npm run build` first, then `npm run test:browser`.\n     5\texport default defineConfig({\n     6\t  define: { __DEV__: 'true' },\n     7\t  test: {\n     8\t    include: process.env.AXYLO_BROWSER\n     9\t      ? ['packages/*/test/**/*.browser.test.ts', 'apps/docs/test/**/*.browser.test.ts']\n    10\t      : ['packages/*/test/**/*.test.ts', 'apps/docs/test/**/*.test.ts'],\n    11\t    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    12\t    // Forked processes with --expose-gc: the store's tests force a collection to check that dropped rows are\n    13\t    // released, and fail loudly when they cannot.\n    14\t    pool: 'forks',\n    15\t    execArgv: ['--expose-gc'],\n    16\t    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 10000,\n    17\t    fileParallelism: !process.env.AXYLO_BROWSER,\n    18\t  },\n    19\t});\n","exit_code":0,"status":"completed"}}
