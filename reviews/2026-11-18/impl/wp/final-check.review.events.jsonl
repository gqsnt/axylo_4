{"type":"item.completed","item":{"id":"item_93","type":"command_execution","command":"/bin/bash -lc 'git show 9f9eeef:packages/axylo/src/lookup/geometry.ts | nl -ba'","aggregated_output":"     1\timport type { Layout, Rect, XScale } from '../core/contracts';\n     2\t\n     3\texport type PlotLayout = Extract<Layout, { kind: 'plot' | 'compact' }>;\n     4\t\n     5\texport function contains(rect: Rect, x: number, y: number): boolean {\n     6\t  return x >= rect.x && x <= rect.x + rect.width && y >= rect.y && y <= rect.y + rect.height;\n     7\t}\n     8\t\n     9\t/** How far outside the plot a pointer position still counts as on its edge (decision 0004, clarifications). */\n    10\texport const POINTER_SLACK = 1;\n    11\t\n    12\t/**\n    13\t * Where a pointer position lands on the plot, or null when it is off the plot. Engines report pointer\n    14\t * positions to one CSS pixel (Firefox and WebKit truncate to whole pixels) while the plot's edges are\n    15\t * fractional, so a position up to 1 CSS px outside is moved onto the edge and picked from there.\n    16\t */\n    17\texport function pointerOnPlot(rect: Rect, x: number, y: number): { x: number; y: number } | null {\n    18\t  const right = rect.x + rect.width;\n    19\t  const bottom = rect.y + rect.height;\n    20\t  if (!(x >= rect.x - POINTER_SLACK && x <= right + POINTER_SLACK && y >= rect.y - POINTER_SLACK && y <= bottom + POINTER_SLACK)) {\n    21\t    return null;\n    22\t  }\n    23\t  return { x: Math.min(right, Math.max(rect.x, x)), y: Math.min(bottom, Math.max(rect.y, y)) };\n    24\t}\n    25\t\n    26\texport function scatterPosition(scale: XScale, value: number): number {\n    27\t  const pixel = scale.map(value);\n    28\t  if (scale.type === 'band') return pixel;\n    29\t  const [d0, d1] = scale.domain;\n    30\t  if (value < Math.min(d0, d1) || value > Math.max(d0, d1)) return pixel;\n    31\t  // Only repair rounding at the range edges for a value inside the domain. Points\n    32\t  // excluded by an author's domain must still be clipped by the plot.\n    33\t  const [r0, r1] = scale.range;\n    34\t  const low = Math.min(r0, r1);\n    35\t  const high = Math.max(r0, r1);\n    36\t  const tolerance = (high - low) * 1e-9;\n    37\t  if (pixel < low && low - pixel <= tolerance) return low;\n    38\t  if (pixel > high && pixel - high <= tolerance) return high;\n    39\t  return pixel;\n    40\t}\n    41\t\n    42\texport function pointBox(x: number, y: number): Rect {\n    43\t  return { x, y, width: 0, height: 0 };\n    44\t}\n    45\t\n    46\texport function clipBox(box: Rect, plot: Rect): Rect | null {\n    47\t  const x = Math.max(box.x, plot.x);\n    48\t  const y = Math.max(box.y, plot.y);\n    49\t  const right = Math.min(box.x + box.width, plot.x + plot.width);\n    50\t  const bottom = Math.min(box.y + box.height, plot.y + plot.height);\n    51\t  return x <= right && y <= bottom ? { x, y, width: right - x, height: bottom - y } : null;\n    52\t}\n","exit_code":0,"status":"completed"}}
