s).toHaveLength(12);\n   104\t    const rows = new Set(refs.map(ref => ref.kind === 'point' ? ref.row : -1));\n   105\t    // Source rows of the A_i are the even ones (0, 2, …, 22).\n   106\t    expect([...rows].sort((a, b) => a - b)).toEqual(Array.from({ length: 12 }, (_, i) => 2 * i));\n   107\t  });\n   108\t});\n   109\t\n   110\tdescribe('review verification, item 10: a narrowed category that slides keeps its reading', () => {\n   111\t  it('narrowed to Q3 in Q1–Q4, Q5 appended with keep 4: the single-series reading of Q3 is the same', () => {\n   112\t    const r = record('bar', { title: 'T', data: ['Q1', 'Q2', 'Q3', 'Q4'].map((x, i) => ({ x, y: i + 1 })), x: 'x', y: 'y' });\n   113\t    r.frames();\n   114\t    const a = r.committed!;\n   115\t    const key = a.view.kind === 'bar' ? a.view.frame.series[0]!.key : '';\n   116\t    const before = datumReading(a.view, a.lookup, { kind: 'aligned', seriesKey: key, x: 2 }, 'single', a.formatters, defaultMessages);\n   117\t    r.controller.handle.append([{ x: 'Q5', y: 5 }], { keep: 4 });\n   118\t    r.frames();\n   119\t    const b = r.committed!;\n   120\t    // Q3 is now at index 1.\n   121\t    expect(datumReading(b.view, b.lookup, { kind: 'aligned', seriesKey: key, x: 1 }, 'single', b.formatters, defaultMessages)).toBe(before);\n   122\t  });\n   123\t});\n   124\t\n   125\tdescribe('round 3, R10: two categories that read alike are still two data', () => {\n   126\t  it('Q3 and Q4 formatted alike with equal values: their single-series readings differ, so an eviction from Q3 to Q4 rewrites the text', () => {\n   127\t    const format = (v: unknown) => (v === 'Q3' || v === 'Q4' ? 'Same' : String(v));\n   128\t    const r = record('bar', { title: 'T', data: ['Q1', 'Q2', 'Q3', 'Q4'].map((x, i) => ({ x, y: i < 2 ? i + 1 : 3 })), x: { field: 'x', format }, y: 'y' });\n   129\t    r.frames();\n   130\t    const a = r.committed!;\n   131\t    const key = a.view.kind === 'bar' ? a.view.frame.series[0]!.key : '';\n   132\t    const q3 = datumReading(a.view, a.lookup, { kind: 'aligned', seriesKey: key, x: 2 }, 'single', a.formatters, defaultMessages);\n   133\t    const q4 = datumReading(a.view, a.lookup, { kind: 'aligned', seriesKey: key, x: 3 }, 'single', a.formatters, defaultMessages);\n   134\t    expect(a.lookup.datum({ kind: 'aligned', seriesKey: key, x: 2 })?.x).toBe(a.lookup.datum({ kind: 'aligned', seriesKey: key, x: 3 })?.x);\n   135\t    expect(q3).not.toBe(q4);\n   136\t  });\n   137\t});\n","exit_code":0,"status":"completed"}}
