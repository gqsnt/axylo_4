vert: (p: number) => number;\n    34\t  if (span === 0) map = () => mid; // a zero-width domain (one value, one instant) is drawn in the middle\n    35\t  else if (overflow) map = (v: number) => r0 + ((v / 2 - d0 / 2) / halfSpan) * extent;\n    36\t  else map = (v: number) => r0 + ((v - d0) / span) * extent;\n    37\t  if (extent === 0) invert = () => d0;\n    38\t  else if (overflow) invert = (p: number) => {\n    39\t    const f = (p - r0) / extent;\n    40\t    return d0 * (1 - f) + d1 * f;\n    41\t  };\n    42\t  else invert = (p: number) => d0 + ((p - r0) / extent) * span;\n    43\t  return { type, domain: [d0, d1], range: [r0, r1], map, invert };\n    44\t}\n    45\t\n    46\tfunction sortedDomain(domain: readonly [number, number]): [number, number] {\n    47\t  return domain[0] <= domain[1] ? [domain[0], domain[1]] : [domain[1], domain[0]];\n    48\t}\n    49\t\n    50\t/**\n    51\t * Tick sets at nice steps (1, 2, 5 × 10^k), densest first, every tick inside the domain.\n    52\t * The densest set has at most MAX_TICKS ticks; the sparsest has one.\n    53\t */\n    54\texport function linearTickCandidates(domain: readonly [number, number], format: TickLabeler): TickCandidates {\n    55\t  const [lo, hi] = sortedDomain(domain);\n    56\t  if (!Number.isFinite(lo) || !Number.isFinite(hi)) return [];\n    57\t  // A width that no nice step can resolve (subnormal, or below the precision of the values) gets one tick.\n    58\t  // Divided before subtracting, so that [-1e308, 1e308] does not overflow.\n    59\t  const width = hi / (MAX_TICKS - 1) - lo / (MAX_TICKS - 1);\n    60\t  const tooNarrow = !(width > 1e-300) || hi - lo <= 4 * Number.EPSILON * Math.max(Math.abs(lo), Math.abs(hi));\n    61\t  if (lo === hi || tooNarrow) {\n    62\t    const v = lo === 0 ? 0 : lo;\n    63\t    return [[{ value: v, label: format(v, { step: 0, maxAbs: Math.abs(v) }) }]];\n    64\t  }\n    65\t  const sets: Tick[][] = [];\n    66\t  let step = niceStepAtLeast(width);\n    67\t  for (let guard = 0; guard < 40 && Number.isFinite(step.value); guard++) {\n    68\t    const i0 = firstIndexAtOrAbove(lo, step);\n    69\t    const i1 = lastIndexAtOrBelow(hi, step);\n    70\t    // Beyond 2^53 the index arithmetic is no longer exact (i + 1 === i), and a double cannot hold those\n    71\t    // multiples anyway: such a step is below the resolution of the values, so try a coarser one.\n    72\t    if (!(Math.max(Math.abs(i0), Math.abs(i1)) * step.mantissa <= Number.MAX_SAFE_INTEGER)) {\n    73\t      step = nextNiceStep(step);\n    74\t      continue;\n    75\t    }\n    76\t    const count = i1 - i0 + 1;\n    77\t    if (count >= 1 && count <= MAX_TICKS) {\n    78\t      const values: number[] = [];\n    79\t      // Counted, not `i <= i1`: the loop must end whatever the index arithmetic does.\n    80\t      for (let n = 0; n < count; n++) {\n    81\t        const v = stepMultiple(i0 + n, step);\n    82\t        // Where the step is below the resolution of the values, neighbours collapse to one double.\n    83\t        if (v >= lo && v <= hi && values[values.length - 1] !== v) values.push(v);\n    84\t      }\n    85\t      if (values.length > 0) {\n    86\t        const maxAbs = Math.max(Math.abs(values[0] as number), Math.abs(values[values.length - 1] as number));\n    87\t        const context: TickContext = { step: step.value, maxAbs };\n    88\t        const set = values.map(value => ({ value, label: format(value, context) }));\n    89\t        pushCandidate(sets, set);\n    90\t      }\n    91\t    }\n    92\t    if (count <= 1) break;\n    93\t    step = nextNiceStep(step);\n    94\t  }\n    95\t  // Every step was below the resolution of the values: one tick, as for a domain too narrow to divide.\n    96\t  if (sets.length === 0) {\n    97\t    const v = lo === 0 ? 0 : lo;\n    98\t    return [[{ value: v, label: format(v, { step: 0, maxAbs: Math.abs(v) }) }]];\n    99\t  }\n   100\t  // Near the largest doubles the next step overflows; the