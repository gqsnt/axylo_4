ay: flex; align-items: center; justify-content: center; text-align: center;\n   166\t    font-size: max(12px, 1em); color: var(--axylo-muted, var(--axylo-default-muted)); overflow-wrap: anywhere;\n   167\t  }\n   168\t  .axylo-corner {\n   169\t    position: absolute; top: 0; right: 0; padding: 0 2px; font-size: 12px; line-height: 1;\n   170\t    color: var(--axylo-text, currentColor); pointer-events: none;\n   171\t  }\n   172\t  .axylo-note { flex: none; margin: 0.5em 0 0; font-size: max(12px, 0.875em); }\n   173\t  /* Measures nothing on screen: it has the labels' font, and its size changes when that font arrives. */\n   174\t  .axylo .axylo-text > .axylo-font-probe { position: absolute; left: 0; top: 0; white-space: pre; visibility: hidden; pointer-events: none; }\n   175\t  .axylo .axylo-text > .axylo-font-probe::before { content: \"Mg 0123456789\"; }\n   176\t  /* Decision 0004 revision 3: a hovered tooltip is text that never takes the pointer (rule 3); a pinned one\n   177\t     takes events and its rows are buttons of at least 24 px (rule 4). */\n   178\t  .axylo .axylo-tooltip {\n   179\t    position: absolute; left: 0; top: 0; z-index: 3; box-sizing: border-box; pointer-events: none;\n   180\t    max-width: min(320px, 100%); padding: 4px 8px; border: 1px solid var(--axylo-axis, var(--axylo-default-axis)); border-radius: 4px;\n   181\t    background: var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background))); color: var(--axylo-text, currentColor);\n   182\t    font-size: max(12px, 0.875em); line-height: 1.4;\n   183\t    /* Never larger than the visible part of the plot (rule 6): the layer sets both maxima; content wraps. */\n   184\t    overflow: hidden; overflow-wrap: anywhere;\n   185\t  }\n   186\t  .axylo .axylo-tooltip.axylo-tooltip-pinned { pointer-events: auto; }\n   187\t  /* Readout mode (rule 5): a strip of two lines reserved under the plot, in the plot's column, as running\n   188\t     text. Outside readout mode it does not exist. */\n   189\t  .axylo .axylo-readout { display: none; }\n   190\t  .axylo .axylo-readout-mode .axylo-readout {\n   191\t    /* Two actual line heights of the strip's own font: em here is that font, whatever the page's size. */\n   192\t    display: block; flex: none; box-sizing: border-box; height: calc(2 * max(24px, 1.4em));\n   193\t    margin: 0; padding: 0 4px; overflow: hidden; font-size: max(12px, 0.875em); line-height: max(24px, 1.4em);\n   194\t    color: var(--axylo-text, currentColor); overflow-wrap: anywhere;\n   195\t  }\n   196\t  .axylo .axylo-readout-mode .axylo-readout[hidden] { display: block !important; visibility: hidden; }\n   197\t  /* The x on one line at most, cut with an ellipsis, so a long title never crowds out the first value. */\n   198\t  .axylo .axylo-readout .axylo-tooltip-title {\n   199\t    display: inline-block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; vertical-align: bottom;\n   200\t  }\n   201\t  .axylo .axylo-readout .axylo-readout-entry, .axylo .axylo-readout .axylo-tooltip-series { display: inline; }\n   202\t  .axylo .axylo-readout .axylo-swatch { vertical-align: middle; margin-inline-end: 0.25em; }\n   203\t  /* A pinned row or a slice-list entry can be chosen with a click or a tap (WCAG 2.5.1): real buttons, at\n   204\t     least 24 × 24 px (WCAG 2.5.8), that look like the text they hold. */\n   205\t  .axylo .axylo-tooltip-choice, .axylo .axylo-legend-choice {\n   206\t    cursor: pointer; box-sizing: border-box; margin: 0; padding: 0; border: 0; background: none;\n   207\t    font: inherit; color: inherit; text-align: inherit; align-items: center; min-height: 24px; min-width: 24px;\n   208\t  }\n   209\t  .axylo .axylo-legend-choice { display: inline-flex; gap: 0.375em; }\n   210\t  .axylo .axylo-tooltip .axylo-tooltip-choice { width: 100%; }\n   211\t  .axylo .axylo-readout .axylo-tooltip-choice { display: inline-flex; vertical-align: middle; }\n   212\t  .axylo .axylo-legend-choice { display: inline-flex; gap: 0.375em; min-width: 24px; }\n   213\t  .axylo .axylo-tooltip-title { font-weight: 600; }\n   214\t  .axylo .axylo-tooltip-row { display: flex; gap: 1em; justify-content: space-between; }\n   215\t  .axylo .axylo-tooltip-series { display: inline-flex; align-items: center; gap: 0.375em; min-width: 0; overflow-wrap: anywhere; }\n   216\t  .axylo .axylo-tooltip-value { font-variant-numeric: tabular-nums; white-space: nowrap; }\n   217\t  .axylo .axylo-tooltip-total {\n   218\t    margin-top: 2px; padding-top: 2px; border-top: 1px solid var(--axylo-axis, var(--axylo-default-axis));\n   219\t    text-align: end; font-weight: 600; font-variant-numeric: tabular-nums;\n   220\t  }\n   221\t  .axylo .axylo-swatch { flex: none; display: inline-block; overflow: visible; }\n   222\t  /* The swatch repeats the dash the marks use, normal or contrast (spec A5; review 2, finding 22). */\n   223\t  .axylo .axylo-swatch-line { stroke-dasharray: var(--axylo-swatch-dash, none); }\n   224\t  @media (prefers-contrast: more), (forced-colors: active) {\n   225\t    .axylo .axylo-swatch-line { stroke-dasharray: var(--axylo-swatch-dash-contrast, none); }\n   226\t  }\n   227\t  /* A reference label sits on a plate of the backdrop color, so it stays readable over marks (spec L6). */\n   228\t  .axylo .axylo-label[data-role=\"reference\"] {\n   229\t    background: var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background)));\n   230\t    box-shadow: 0 0 0 2px var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background)));\n   231\t  }\n   232\t\n   233\t  /*\n   234\t   * Interaction. The plot keeps a one-finger drag for the page (spec I4); with zoom: 'touch' pinch and\n   235\t   * two-finger pan come to the chart. Tick text is not selectable, so a drag selects a range, not text.\n   236\t   */\n   237\t  .axylo .axylo-plot { user-select: none; -webkit-user-select: none; touch-action: manipulation; }\n   238\t  .axylo .axylo-plot.axylo-touch-zoom { touch-action: pan-x pan-y; }\n   239\t  .axylo .axylo-plot.axylo-zoomable { cursor: crosshair; }\n   240\t  /* The keyboard proxy (decision 0001): a native range over the plot, transparent, never in the pointer's way. */\n   241\t  .axylo .axylo-proxy {\n   242\t    position: absolute; z-index: 2; margin: 0; padding: 0; border: 0; box-sizing: border-box;\n   243\t    opacity: 0; pointer-events: none; appearance: none; -webkit-appearance: none; background: transparent;\n   244\t  }\n   245\t  /* The plot's focus indicator (spec A2): 2 px in the focus token, at least 3:1 in both schemes. */\n   246\t  .axylo .axylo-focus-ring {\n   247\t    position: absolute; z-index: 2; display: none; box-sizing: border-box; pointer-events: none;\n   248\t    /* Inside the plot's box: the plot clips, and a ring outside it would not be seen (review 2, finding 14). */\n   249\t    outline: 2px solid var(--axylo-focus, var(--axylo-default-focus)); outline-offset: -3px;\n   250\t    /* Two tones (WCAG 1.4.11): 1 px of the background colour on each side of the 2 px outline, so the focus\n   251\t       colour is separated from any mark under it and needs 3:1 against the background only. */\n   252\t    box-shadow: inset 0 0 0 4px var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background)));\n   253\t    /* Kept in forced colours, where both tokens are system colours already (Highlight on Canvas). */\n   254\t    forced-color-adjust: none;\n   255\t  }\n   256\t  .axylo .axylo-proxy:focus-visible + .axylo-focus-ring, .axylo .axylo-proxy.axylo-keyed:focus + .axylo-focus-ring { display: block; }\n   257\t  /* The donut slice the keyboard is on, also when it has no arc. */\n   258\t  .axylo .axylo-legend-list > li.axylo-legend-current { outline: 2px solid var(--axylo-focus, var(--axylo-default-focus)); outline-offset: 1px; }\n   259\t  .axylo .axylo-selection {\n   260\t    position: absolute; z-index: 1; box-sizing: border-box; pointer-events: none;\n   261\t    border: 1px solid var(--axylo-focus, var(--axylo-default-focus));\n   262\t    background: color-mix(in srgb, var(--axylo-focus, var(--axylo-default-focus)) 16%, transparent);\n   263\t  }\n   264\t\n   265\t  /* Legend, toolbar and table, under the plot. */\n   266\t  .axylo .axylo-controls { flex: none; display: flex; flex-direction: column; gap: 0.5em; margin: 0.5em 0 0; min-width: 0; }\n   267\t  /* legend: 'top' puts the legend and its toolbar above the plot; 'right' beside it, entries stacked. */\n   268\t  .axylo .axylo-controls-top, .axylo .axylo-controls-side { flex: none; display: flex; flex-direction: column; gap: 0.5em; min-width: 0; }\n   269\t  .axylo .axylo-controls-top { margin: 0 0 0.5em; }\n   270\t  .axylo .axylo-controls-side { margin: 0 0 0 0.75em; max-width: 40%; overflow: auto; }\n   271\t  .axylo .axylo-controls-side .axylo-toolbar { flex-direction: column; align-items: stretch; flex-wrap: nowrap; }\n   272\t  .axylo .axylo-controls-side .axylo-legend-list { flex-direction: column; flex-wrap: nowrap; }\n   273\t  .axylo .axylo-controls-side .axylo-legend-entry + .axylo-control:not(.axylo-legend-entry) { margin-inline-start: 0; margin-block-start: 0.5em; }\n   274\t  /* Tight: the Select range toggle may not cost a wrapped toolbar a row (its 26 px are won back here). */\n   275\t  .axylo .axylo-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 2px; min-width: 0; }\n   276\t  .axylo .axylo-control {\n   277\t    display: inline-flex; align-items: center; gap: 0.375em; box-sizing: border-box; min-width: 24px; min-height: 24px;\n   278\t    margin: 0; padding: 2px 5px; border: 1px solid var(--axylo-axis, var(--axylo-default-axis)); border-radius: 4px;\n   279\t    background: var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background))); color: var(--axylo-text, currentColor);\n   280\t    font: inherit; font-size: max(12px, 0.875em); line-height: 1.25; text-align: start; cursor: pointer;\n   281\t  }\n   282\t  /* Legend entries first; the other controls start on the right. */\n   283\t  .axylo .axylo-legend-entry + .axylo-control:not(.axylo-legend-entry) { margin-inline-start: auto; }\n   284\t  .axylo .axylo-control:focus-visible { outline: 2px solid var(--axylo-focus, var(--axylo-default-focus)); outline-offset: 1px; }\n   285\t  .axylo .axylo-control[aria-disabled=\"true\"] { cursor: default; border-style: dashed; }\n   286\t  /* A symbol button (Select range): 24 × 24, so it adds no toolbar row; its name stays as hidden text. */\n   287\t  .axylo .axylo-control.axylo-control-symbol { width: 24px; height: 24px; padding: 0; justify-content: center; }\n   288\t  .axylo .axylo-symbol { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }\n   289\t  /* A pressed toggle (not a legend entry): a heavier border, which forced colours keep. */\n   290\t  .axylo .axylo-control[aria-pressed=\"true\"]:not(.axylo-legend-entry) { border-width: 2px; }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"git show 9f9eeef:packages/axylo/src/dom/tooltip.ts | nl -ba | sed -n '1,490p'\"","aggregated_output":"     1\t/**\n     2\t * Renders a tooltip model as text (spec I1, DX8: textContent only), in one of two presentations decided by\n     3\t * the controller's layout (decision 0004 revision 3, rule 5): floating, placed by `placement.ts`, or as\n     4\t * running text in the strip reserved under the plot.\n     5\t *\n     6\t * - A hovered tooltip is text, takes no pointer events and is hidden from assistive technology: the plot's\n     7\t *   keyboard proxy carries the same reading, so nothing is said twice and nothing here is a live region (A7).\n     8\t * - A pinned tooltip or strip takes events and is exposed (rule 9): its rows are buttons named by their text,\n     9\t *   at least 24 × 24 CSS px, outside the tab order (the closed chart keeps its two tab stops; the keyboard\n    10\t *   reaches the same series through the plot's own Up and Down). Its \"+N more\" is a button too, showing the\n    11\t *   next rows, so every row can be chosen by pointer.\n    12\t * - Rows keep their element across redraws while their identity (series, datum) is unchanged, and nodes\n    13\t *   are only moved when their order changes, so a press that spans a data update still completes.\n    14\t * - Floating: rows are dropped from the end into \"+N more\" until a candidate is valid (rule 6); the tooltip\n    15\t *   is never larger than the visible part of the plot; with one row and still nothing valid, the last resort\n    16\t *   of rule 6 is used, and when even that would cover a control or a focus ring nothing floats.\n    17\t * - Strip: at least the x and one row are always shown.\n    18\t */\n    19\timport { activeElementOf } from './attributes';\n    20\timport type { DatumText, Rect, TooltipModel } from '../core/contracts';\n    21\timport { createSwatch, type SwatchSpec } from './swatch';\n    22\timport { fallbackPlacement, placeTooltip, type PlacementInput } from './placement';\n    23\timport { mappingOf } from './mapping';\n    24\t\n    25\texport interface TooltipContent {\n    26\t  readonly model: TooltipModel;\n    27\t  readonly swatch: (row: DatumText) => SwatchSpec | null;\n    28\t  readonly moreRows: (count: number) => string;\n    29\t  /** Label of the stack total row (the `total` message). */\n    30\t  readonly totalLabel?: string;\n    31\t  /** `lang` for the built-in \"+N more\" and total label, or null. */\n    32\t  readonly moreLang?: string | null;\n    33\t  readonly totalLang?: string | null;\n    34\t  /** A row of a pinned tooltip was chosen (a click or a tap on it). */\n    35\t  readonly select?: (row: DatumText) => void;\n    36\t  /** `lang` of a row's value text (a built-in \"No data\" on a page in another language), or null. */\n    37\t  readonly valueLang?: (text: string) => string | null;\n    38\t  /** The pinned \"+N more\" was chosen: show the rows after the `shown` ones on show now. */\n    39\t  readonly more?: (shown: number) => void;\n    40\t}\n    41\t\n    42\texport type Presentation = 'floating' | 'strip';\n    43\t\n    44\texport interface TooltipView {\n    45\t  /**\n    46\t   * Floating, placed by rules 2 and 6 against `placement` (viewport pixels). `pinned`: it takes events and\n    47\t   * its rows are buttons. Returns false when nothing could be placed (nothing is shown then).\n    48\t   */\n    49\t  show(content: TooltipContent, placement: PlacementInput, pinned: boolean): boolean;\n    50\t  /**\n    51\t   * Readout mode: the content as running text in the strip under the plot, at most two lines. Returns false\n    52\t   * when nothing of the strip can be seen (`visible`, viewport pixels: what its clipping ancestors leave).\n    53\t   */\n    54\t  strip(content: TooltipContent, pinned: boolean, visible: Rect): boolean;\n    55\t  hide(): void;\n    56\t  readonly visible: boolean;\n    57\t  /** Where the content is shown now. */\n    58\t  readonly where: Presentation | null;\n    59\t  /** The content's rectangle in viewport pixels (the floating tooltip or the strip), or null. */\n    60\t  rect(): Rect | null;\n    61\t  /** Whether a node belongs to the shown content. */\n    62\t  contains(node: Node | null): boolean;\n    63\t  destroy(): void;\n    64\t}\n    65\t\n    66\tinterface RowEntry {\n    67\t  readonly element: HTMLElement;\n    68\t  readonly name: HTMLElement;\n    69\t  readonly value: HTMLElement;\n    70\t  /** The strip's \"; \" before the entry. */\n    71\t  readonly separator: Text | null;\n    72\t  row: DatumText;\n    73\t  swatch: string;\n    74\t  readonly listening: AbortController | null;\n    75\t}\n    76\t\n    77\t/**\n    78\t * A row's identity across redraws, from its datum, never its formatted text (review: a reformatted x title\n    79\t * replaced a pressed button): an aligned row by its series (every row of one tooltip shares its x), a point by\n    80\t * its series and source row, a slice by its key.\n    81\t */\n    82\tfunction rowKey(r: DatumText): string {\n    83\t  const ref = r.ref;\n    84\t  switch (ref.kind) {\n    85\t    case 'aligned': return `a\\u0000${ref.seriesKey}`;\n    86\t    case 'point': return `p\\u0000${ref.seriesKey}\\u0000${ref.row}`;\n    87\t    case 'slice': return `s\\u0000${ref.sliceKey}`;\n    88\t  }\n    89\t}\n    90\t\n    91\t/** Puts exactly `wanted`, in order, into `host`, moving a node only when it is out of place. */\n    92\tfunction place(host: HTMLElement, wanted: readonly Node[]): void {\n    93\t  let at: ChildNode | null = host.firstChild;\n    94\t  for (const node of wanted) {\n    95\t    if (at !== node) host.insertBefore(node, at);\n    96\t    at = (node as ChildNode).nextSibling;\n    97\t  }\n    98\t  while (at) {\n    99\t    const next: ChildNode | null = at.nextSibling;\n   100\t    at.remove();\n   101\t   