nst names = new Set(frame.labels);\n  const after = next.frame;\n  if (after.labels.some(label => names.has(label))) return null;\n  const count = frame.labels.length + after.labels.length;\n  const dropped = keep === undefined ? 0 : Math.max(0, count - keep);\n  const length = count - dropped;\n  const labels = new Array<string>(length);\n  const values = new Float64Array(length);\n  const slot = new Uint8Array(length);\n  const row = new Int32Array(length);\n  for (let i = 0; i < length; i++) {\n    const index = dropped + i;\n    const source = index < frame.labels.length ? frame : after;\n    const offset = source === frame ? index : index - frame.labels.length;\n    labels[i] = source.labels[offset]!;\n    values[i] = source.values[offset]!;\n    slot[i] = source.slot[offset]!;\n    row[i] = source.row?.[offset] ?? offset;\n  }\n  return {\n    frame: { ...after, labels, values, slot, row },\n    positions: Float64Array.from({ length }, (_, i) => i), dropped,\n  };\n}\n\nfunction removeRows(table: Table, positions: Float64Array, keep: number, first: number, rows: StreamRows): number[] {\n  let unplaced = 0;\n  for (let i = 0; i < table.length; i++) {\n    if (!Number.isFinite(positions[i])) unplaced++;\n  }\n  let excess = Math.max(0, unplaced - 2 * keep);\n  const removed: number[] = [];\n  for (let i = 0; i < table.length; i++) {\n    const position = positions[i]!;\n    if (Number.isFinite(position) ? position >= first : excess-- <= 0) continue;\n    const row = table.rowIndex(i);\n    rows.forget(row);\n    removed.push(row);\n  }\n  return removed;\n}\n\nclass UnalignedStore<F extends PointFrame | DonutFrame> {\n  private rows: StreamRows;\n  private readonly revisions: RowRevisions;\n  private encoding: ResolvedOptions;\n  private current: F;\n  private latest: readonly DiagnosticInput[];\n  private positions: Float64Array;\n\n  constructor(\n    private readonly type: 'scatter' | 'donut',\n    private readonly build: Build<F>,\n    private readonly extend: Extend<F>,\n    options: ResolvedOptions,\n    private readonly environment: DataEnvironment,\n    version: FrameVersion,\n    private readonly sink: DiagnosticSink,\n  ) {\n    this.rows = new StreamRows(options.table);\n    this.revisions = new RowRevisions(this.rows);\n    this.encoding = withoutTable(options);\n    const diagnostics = new DiagnosticCollector();\n    const { frame, positions } = build({ ...options, table: this.rows.table() }, environment, diagnostics, version);\n    this.positions = positions;\n    const source = new FrameSource(this.rows.next, this.rows);\n    this.current = { ...frame, source };\n    this.revisions.current.publish(frame.revision, source, this.rows);\n    this.latest = diagnostics.inputs();\n    for (const diagnostic of this.latest) sink.add(diagnostic);\n  }\n\n  get frame(): F { return this.current; }\n  get diagnostics(): readonly DiagnosticInput[] { return this.latest; }\n  get retainedRowCount(): number { return this.revisions.size; }\n\n  retire(revision: number): void { this.revisions.retire(revision); }\n\n  /** Validates encoding against the retained rows and returns options for re-encoding this store. */\n  resolveEncoding(input: unknown, sink: DiagnosticSink): ResolvedOptions {\n    return withoutTable(resolveOptions(this.type, input, sink, this.rows.table()));\n  }\n\n  append(rows: readonly unknown[], options: StoreAppendOptions = {}, sink = this.sink): F {\n    const prepared = this.prepareAppend(rows, options);\n    for (const diagnostic of prepared.callDiagnostics) sink.add(diagnostic);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareAppend(rows: readonly unknown[], options: StoreAppendOptions = {}): PreparedFrame<F> {\n    const base = this.current;\n    const version = { epoch: base.epoch, revision: base.revision + 1 };\n    const keep = retention(options);\n    const fast = this.extendAppend(base, rows, version, keep);\n    if (fast) return fast;\n    const retained = this.rows.fork();\n    retained.append(rows);\n    let table = retained.table();\n    const call = new DiagnosticCollector();\n    const resolved = retargetOptions(this.encoding, table, call);\n    let result = this.build(resolved, this.environment, call, version);\n    const ordering = new DiagnosticCollector();\n    if (this.type === 'scatter') {\n      const reports = new Reports(this.encoding.x.field, ordering);\n      let highest = -Infinity;\n      for (let i = 0; i < result.positions.length; i++) {\n        const position = result.positions[i]!;\n        if (!Number.isFinite(position)) continue;\n        const row = table.rowIndex(i);\n        if (row >= this.rows.next && position < highest) reports.add('AX151', 'none', row);\n        highest = Math.max(highest, position);\n      }\n      reports.flush(ordering);\n    }\n    let current = call;\n    const evicted: number[] = [];\n    if (keep !== undefined) {\n      // Removing rows can change the inferred kind and make formerly unplaceable x values usable.\n      while (true) {\n        const removed = removeRows(table, result.positions, keep, firstPosition(result, keep), retained);\n        if (removed.length === 0) break;\n        for (const row of removed) evicted.push(row);\n        current = new DiagnosticCollector();\n        table = retained.table();\n        const encoded = retargetOptions(this.encoding, table, current);\n        result = this.build(encoded, this.environment, current, version);\n      }\n    }\n    const ordered = ordering.inputs();\n    return this.prepare(base, result.frame, retained, result.positions, [...current.inputs(), ...ordered], [...call.inputs(), ...ordered], evicted);\n  }\n\n  private extendAppend(base: F, rows: readonly unknown[], version: FrameVersion, keep: number | undefined): PreparedFrame<F> | null {\n    // Implicit string parsing and diagnostics can change when old rows leave. Reuse old values only when\n    // both partitions have unambiguous clean values and the same x interpretation.\n    if (this.latest.length || this.encoding.values[0]?.parse || this.encoding.series !== null ||\n      this.positions.length !== this.rows.size) return null;\n    const table = { ...rowsTable(rows), rowIndex: (row: number) => this.rows.next + row };\n    const diagnostics = new DiagnosticCollector();\n    const resolved = retargetOptions(this.encoding, table, diagnostics);\n    if (!resolved.valid) return null;\n    const result = this.build(resolved, this.environment, diagnostics, version);\n    if (diagnostics.inputs().length) return null;\n    const extension = this.extend(base, this.positions, result, keep);\n    if (!extension) return null;\n    const retained = this.rows.fork();\n    retained.append(rows);\n    const evicted: number[] = [];\n    if (extension.dropped > 0) {\n      const combined = retained.table();\n      for (let i = 0; i < extension.dropped; i++) {\n        const row = combined.rowIndex(i);\n        retained.forget(row);\n        evicted.push(row);\n      }\n    }\n    return this.prepare(base, extension.frame, retained, extension.positions, [], [], evicted);\n  }\n\n  reencode(options: ResolvedOptions, version: FrameVersion): F {\n    const prepared = this.prepareReencode(options, version);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareReencode(options: ResolvedOptions, version: FrameVersion): PreparedFrame<F> {\n    return this.prepareEncoding(this.rows, options, version, new DiagnosticCollector());\n  }\n\n  replace(data: unknown, options: ResolvedOptions, version: FrameVersion): F {\n    const prepared = this.prepareReplace(data, options, version);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareReplace(data: unknown, options: ResolvedOptions, version: FrameVersion): PreparedFrame<F> {\n    const call = new DiagnosticCollector();\n    const replacement = resolveTable(data, call);\n    return this.prepareEncoding(new StreamRows(replacement.table), options, version, call, replacement);\n  }\n\n  private prepareEncoding(\n    rows: StreamRows, options: ResolvedOptions, version: FrameVersion, call: DiagnosticCollector,\n    replacement?: { table: Table; valid: boolean },\n  ): PreparedFrame<F> {\n    const base = this.current;\n    if (version.revision <= base.revision || version.epoch <= base.epoch) {\n      throw new Error('Encoding updates and replacements require a newer epoch and revision.');\n    }\n    const table = rows.table();\n    const resolved = retargetOptions(options, replacement?.table ?? table, call, replacement?.valid);\n    const { frame, positions } = this.build({ ...resolved, table }, this.environment, call, version);\n    const diagnostics = call.inputs();\n    return this.prepare(base, frame, rows, positions, diagnostics, diagnostics, [], options, replacement !== undefined);\n  }\n\n  private prepare(\n    base: F, frame: F, rows: StreamRows, positions: Float64Array,\n    diagnostics: readonly DiagnosticInput[], callDiagnostics: readonly DiagnosticInput[],\n    evicted: readonly number[], options = this.encoding, replacement = false,\n  ): PreparedFrame<F> {\n    const source = new FrameSource(rows.next, rows);\n    const candidate = { ...frame, source };\n    const commit = once(() => this.current, () => {\n      if (replacement) this.revisions.replace(rows);\n      for (const row of evicted) this.revisions.current.archive(row);\n      this.rows = rows;\n      this.current = candidate;\n      this.latest = diagnostics;\n      this.positions = positions;\n      if (options !== this.encoding) this.encoding = withoutTable(options);\n      this.revisions.current.publish(candidate.revision, source, rows);\n    }, base);\n    return { frame: candidate, diagnostics, callDiagnostics, commit };\n  }\n}\n\nexport class PointStore extends UnalignedStore<PointFrame> {\n  constructor(options: ResolvedOptions, environment: DataEnvironment, version: FrameVersion, sink: DiagnosticSink = quiet) {\n    super('scatter', buildPoints, extendPoints, options, environment, version, sink);\n  }\n}\n\nexport class DonutStore extends UnalignedStore<DonutFrame> {\n  constructor(options: ResolvedOptions, environment: DataEnvironment, version: FrameVersion, sink: DiagnosticSink = quiet) {\n    super('donut', buildDonut, extendDonut, options, environment, version, sink);\n  }\n}\nimport type { DiagnosticInput, Frame } from '../core/contracts';\n\nexport interface PreparedFrame<F extends Frame> {\n  readonly frame: F;\n  /** Findings for the resulting frame, including append ordering. */\n  readonly diagnostics: readonly DiagnosticInput[];\n  /** Findings for validation of this call, including incoming rows evicted by keep. */\n  readonly callDiagnostics: readonly DiagnosticInput[];\n  /** Idempotent after success. Throws if another data revision superseded this candidate. */\n  commit(): void;\n}\n\nexport interface StoreAppendOptions { keep?: number }\n\nexport function retention(options: StoreAppendOptions): number | undefined {\n  const { keep } = options;\n  return keep === undefined || !Number.isFinite(keep) ? undefined : Math.max(0, Math.floor(keep));\n}\n\nexport function once(current: () => Frame, apply: () => void, base = current()): () => void {\n  let pending: { base: Frame; current: () => Frame; apply: () => void } | undefined = { base, current, apply };\n  return () => {\n    if (!pending) return;\n    if (pending.base !== pending.current()) throw new Error('Cannot commit a superseded data revision.');\n    pending.apply();\n    pending = undefined;\n  };\n}\n35:export function readX(type: ChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, categories?: readonly string[]): XData {\n338:export function pointFrame(options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion): PointFrame {\n372:function donutFrame(options: ResolvedOptions, sink: DiagnosticSink, version: FrameVersion): DonutFrame {\n429:const alignedSeeds = new WeakMap<AlignedFrame, AlignedSeed>();\n431:export function alignedSeed(frame: AlignedFrame): AlignedSeed | undefined {\n432:  return alignedSeeds.get(frame);\n451:    alignedSeeds.set(frame, { options, type, x, counts, diagnostics });\n17:export interface XAxisMeta extends Pick<XColumn, 'kind' | 'categories' | 'timeZone'> {\n36:  const categories = new Map(axis.categories?.map((label, index) => [label, index]));\n42:        const index = name === null ? undefined : categories.get(name);\n151:    categories?: readonly string[],\n157:    this.names = kind === 'category' ? [...(categories ?? [])] : null;\n161:  get categories(): string[] | null {\n173:  fork(): XParser {\n174:    const draft = new XParser(this.field, this.kind, { timeZone: this.timeZone ?? 'UTC' }, this.scatter, this.categories ?? undefined);\n183:  evictCategories(count: number): void {\n255:  restore(categoryCount: number, dateUnit: DateUnit | null): void {\n268:      get categories() {\n289:export function positionName(axis: Pick<XColumn, 'kind' | 'dateUnit' | 'timeZone' | 'categories'>, position: number): string {\n290:  if (axis.kind === 'category') return JSON.stringify(axis.categories?.[position] ?? position);\n          ...series, row: series.row.map(row => row < 0 ? row : row + offset),\n        })),\n      });\n      expect(s.diagnostics.map(d => [d.code, d.count, d.rows])).toEqual(\n        full.diagnostics.inputs().map(d => [d.code, d.count, d.rows?.map(row => row + offset)]),\n      );\n      expect(after.epoch).toBe(before.epoch + 1);\n      for (const row of indexes(before)) expect(before.source.rowAt(row)).toBe(data[row]);\n      for (let i = 0; i < data.length; i++) expect(after.source.rowAt(i)).toBe(i < offset ? null : data[i]);\n    }));\n  });\n\n  it('revalidates a new field against appended rows and replaces the stream even with the initial data', () => {\n    const data = [{ x: 1, y: 5 }];\n    const s = stream(data);\n    const before = s.append([{ x: 2, y: 6, z: NaN }], { keep: 1 });\n    const newEncoding = resolve({ data, x: 'x', y: 'z' });\n    expect(newEncoding.valid).toBe(false);\n    const findings = new DiagnosticCollector();\n    expect(s.resolveEncoding({ data, x: 'x', y: 'z' }, findings).valid).toBe(true);\n    expect(findings.inputs()).toEqual([]);\n    const change = s.prepareReencode(newEncoding, revised(before));\n    expect(s.frame).toBe(before);\n    expect(change.diagnostics).toMatchObject([{ code: 'AX103', rows: [1] }]);\n    change.commit();\n    expect(s.frame.series[0]?.row?.[0]).toBe(1);\n    const replacement = s.replace(data, resolve({ data, ...numbers }), revised(s.frame));\n    expect([...replacement.x.values]).toEqual([1]);\n    expect(indexes(replacement)).toEqual([0]);\n    expect(replacement.source.rowAt(0)).toBe(data[0]);\n    expect(before.source.rowAt(1)).toEqual({ x: 2, y: 6, z: NaN });\n    expect(replacement.source.rowAt(1)).toBeNull();\n    s.retire(before.revision);\n    expect(before.source.rowAt(1)).toBeNull();\n    expect(replacement.source.rowAt(0)).toBe(data[0]);\n  });\n\n  it('keeps typed missingness and source indexes after retaining only a small column range', () => {\n    const x = Float64Array.from({ length: 512 }, (_, i) => i);\n    const z = Float32Array.from(x, i => i === 511 ? NaN : -i);\n    const data = { columns: { x, y: x, z } };\n    const s = new AlignedStore('line', resolve({ data, ...numbers }), utc, version);\n    const before = s.append([{ x: 512, y: 1, z: Infinity }], { keep: 3 });\n    s.retire(before.revision - 1);\n    const after = s.reencode(resolve({ data, x: 'x', y: 'z' }), revised(before));\n    expect(indexes(after)).toEqual([510, 511, 512]);\n    expect([...after.series[0]!.y]).toEqual([-510, NaN, NaN]);\n    expect(s.diagnostics).toMatchObject([{ code: 'AX103', rows: [512] }]);\n    expect(after.source.rowAt(511)).toEqual({ x: 511, y: 511, z: NaN });\n    expect(after.source.rowAt(509)).toBeNull();\n  });\n});\n\ndescribe('revision leases', () => {\n  it('keeps the previous frame readable through an eviction until it is retired', () => {\n    const data = [{ x: 0, y: 1 }, { x: 1, y: 2 }];\n    const s = stream(data);\n    const a = s.frame;\n    const last = { x: 2, y: 3 };\n    const b = s.append([last], { keep: 1 });\n    indexes(a).forEach(i => expect(a.source.rowAt(i)).toBe(data[i]));\n    expect(s.retainedRowCount).toBe(3);\n    s.retire(a.revision);\n    indexes(a).forEach(i => expect(a.source.rowAt(i)).toBeNull());\n    expect(s.retainedRowCount).toBe(1);\n    expect(b.source.rowAt(2)).toBe(last);\n  });\n\n  it('stores exactly the union of the live windows during random retirement', () => {\n    const operations = fc.array(fc.record({\n      x: fc.integer({ min: -15, max: 15 }), keep: fc.nat(7), retire: fc.nat(10), preview: fc.boolean(),\n    }), { maxLength: 45 });\n    fc.assert(fc.property(operations, ops => {\n      const s = stream();\n      const frames: { frame: AlignedFrame; window: Set<number> }[] = [];\n      const rows = ops.map(({ x }, y) => ({ x, y }));\n      let retained = new Set<number>();\n      let retired = version.revision - 1;\n      ops.forEach(({ keep, retire, preview }, i) => {\n        const seen = new Set(retained).add(i);\n        const xs = [...new Set([...seen].map(index => rows[index]!.x))].sort((a, b) => a - b);\n        const keys = new Set(keep === 0 ? [] : xs.slice(-keep));\n        retained = new Set([...seen].filter(index => keys.has(rows[index]!.x)));\n        const pending = preview ? s.prepareAppend([rows[i]!], { keep }) : null;\n        pending?.commit();\n        const frame = pending?.frame ?? s.append([rows[i]!], { keep });\n        frames.push({ frame, window: retained });\n        if (retire < 5) {\n          retired = Math.max(retired, frame.revision - retire - 1);\n          s.retire(retired);\n        }\n        const union = new Set<number>();\n        for (const old of frames) {\n          const active = old.frame.revision > retired;\n          for (let index = 0; index <= i; index++) {\n            const addressed = active && old.window.has(index);\n            if (addressed) union.add(index);\n            expect(old.frame.source.rowAt(index)).toBe(addressed ? rows[index] : null);\n          }\n        }\n        expect(s.retainedRowCount).toBe(union.size);\n      });\n    }));\n  });\n});\n\ndescribe('static handoff', () => {\n  it('borrows typed columns until it creates an aligned store', () => {\n    const x = Float64Array.of(1, 2);\n    const y = Float64Array.of(3, 4);\n    const data = { columns: { x, y } };\n    const initial = aligned({ data, ...numbers });\n    expect(initial.frame.x.values.buffer).toBe(x.buffer);\n    expect(initial.frame.series[0]!.y.buffer).toBe(y.buffer);\n    const s = AlignedStore.fromFrame(initial.frame, initial.resolved, data, utc);\n    expect(s.frame.x.values.buffer).not.toBe(x.buffer);\n    expect(s.frame.series[0]!.y.buffer).not.toBe(y.buffer);\n    expect(contents(s.frame)).toEqual(contents(initial.frame));\n    expect(reads).toBe(atStart);\n  });\n\n  it('keeps positions, reports out-of-order rows even if evicted, and keeps typed NaN silent', () => {\n    const data = { columns: { x: Float64Array.of(NaN, 10, 20), y: Float64Array.of(1, NaN, 2) } };\n    const s = new PointStore(resolveOptions('scatter', { data, ...scatterOptions }, quiet), utc, version);\n    expect(s.diagnostics).toEqual([]);\n    const prepare = s.prepareAppend([{ x: 5, y: 1 }, { x: 20, y: 3 }], { keep: 2 });\n    expect(prepare.diagnostics).toMatchObject([{ code: 'AX151', rows: [3] }]);\n    expect([...prepare.frame.series[0]!.x]).toEqual([20, 20]);\n    expect([...prepare.frame.series[0]!.row!]).toEqual([2, 4]);\n    expect(s.frame.source.rowAt(4)).toBeNull();\n    prepare.commit();\n    expect(s.frame.source.rowAt(1)).toEqual({ x: 10, y: NaN });\n    expect(s.frame.source.rowAt(3)).toBeNull();\n    expect(s.diagnostics.map(d => d.code)).toEqual(['AX151']);\n  });\n\n  it('still applies keep when removing rows changes the inferred scatter x kind', () => {\n    const options = resolveOptions('scatter', {\n      data: [1, 2, 3].map(x => ({ x, y: x })), x: 'x', y: 'y',\n    }, quiet);\n    const s = new PointStore(options, utc, version);\n    const next = s.append([{ x: '2026-01-01', y: 5 }, { x: '2026-01-02', y: 6 }], { keep: 1 });\n    expect(next.xKind).toBe('date');\n    expect([...next.series[0]!.x]).toEqual([Date.UTC(2026, 0, 2)]);\n    expect([...next.series[0]!.row!]).toEqual([4]);\n  });\n\n  it('validates duplicate labels before eviction and keeps typed NaN silent', () => {\n    const data = { columns: { label: ['A', 'B'], y: Float64Array.of(NaN, 2) } };\n    const s = new DonutStore(resolveOptions('donut', { data, ...donutOptions }, quiet), utc, version);\n    const first = s.frame;\n    const prepared = s.prepareAppend([{ label: 'A', y: 1 }, { label: 'C', y: 3 }], { keep: 2 });\n    expect(prepared.callDiagnostics).toMatchObject([{ code: 'AX108', rows: [2] }]);\n    expect(prepared.frame.labels).toEqual(['B', 'C']);\n    expect(prepared.diagnostics).toEqual([]);\n    prepared.commit();\n    expect(first.source.rowAt(0)).toEqual({ label: 'A', y: NaN });\n    s.retire(first.revision);\n    expect(first.source.rowAt(0)).toBeNull();\n    expect(s.frame.source.rowAt(1)).toEqual({ label: 'B', y: 2 });\n  });\n\n  it('agrees with one scatter normalization of the retained rows at every step', () => {\n    const points = fc.array(fc.record({ x: fc.integer({ min: -6, max: 6 }), y: fc.oneof(fc.integer(), fc.constant(null)) }), { maxLength: 28 });\n    fc.assert(fc.property(points, fc.nat(10), (input, keep) => {\n      const s = new PointStore(resolveOptions('scatter', { data: [], ...scatterOptions }, quiet), utc, version);\n      let retained: number[] = [];\n      input.forEach((row, i) => {\n        const f = s.append([row], { keep });\n        retained.push(i);\n        const xs = [...new Set(retained.map(i => input[i]!.x))].sort((a, b) => a - b);\n        const keys = new Set(keep === 0 ? [] : xs.slice(-keep));\n        retained = retained.filter(i => keys.has(input[i]!.x));\n        const normalized = check('scatter', { data: retained.map(i => input[i]), ...scatterOptions }).frame;\n        if (normalized.shape !== 'points') throw new Error('Expected a point frame');\n        expect(f.series).toEqual(normalized.series.map(s => ({\n          ...s, row: Int32Array.from(s.row ?? s.x.keys(), index => retained[index]!),\n        })));\n        for (const i of retained) expect(f.source.rowAt(i)).toBe(input[i]);\n      });\n    }));\n  });\n\n  it('agrees with one donut normalization of the retained labels at every step', () => {\n    const slices = fc.array(fc.record({ label: fc.constantFrom('A', 'B', 'C', 'D'), y: fc.oneof(fc.integer(), fc.constant(null)) }), { maxLength: 28 });\n    fc.assert(fc.property(slices, fc.nat(5), (input, keep) => {\n      const s = new DonutStore(resolveOptions('donut', { data: [], ...donutOptions }, quiet), utc, version);\n      let retained: number[] = [];\n      input.forEach((row, i) => {\n        const f = s.append([row], { keep });\n        retained.push(i);\n        const labels = [...new Set(retained.map(i => input[i]!.label))];\n        const keys = new Set(keep === 0 ? [] : labels.slice(-keep));\n        retained = retained.filter(i => keys.has(input[i]!.label));\n        const normalized = check('donut', { data: retained.map(i => input[i]), ...donutOptions }).frame;\n        if (normalized.shape !== 'donut') throw new Error('Expected a donut frame');\n        expect(f.labels).toEqual(normalized.labels);\n        expect(f.values).toEqual(normalized.values);\n        expect(f.slot).toEqual(normalized.slot);\n        expect(f.row).toEqual(Int32Array.from(normalized.row ?? normalized.values.keys(), index => retained[index]!));\n      });\n    }));\n  });\n\n  it('re-encodes and replaces point and donut data independently of old revisions', () => {\n    const data = [{ x: 1, y: 1, label: 'A', alternative: 3 }];\n    const row = { x: 2, y: 2, label: 'B', alternative: 4 };\n    const p = new PointStore(resolveOptions('scatter', { data, ...scatterOptions }, quiet), utc, version);\n    const d = new DonutStore(resolveOptions('donut', { data, ...donutOptions }, quiet), utc, version);\n    const pf = p.append([row], { keep: 1 });\n    const df = d.append([row], { keep: 1 });\n    const second = { epoch: 5, revision: 10 };\n    expect([...p.reencode(resolveOptions('scatter', { data, ...scatterOptions, y: 'alternative' }, quiet), second).series[0]!.y]).toEqual([4]);\n    expect([...d.reencode(resolveOptions('donut', { data, ...donutOptions, value: 'alternative' }, quiet), second).values]).toEqual([4]);\n    const third = { epoch: 6, revision: 11 };\n    expect([...p.replace(data, resolveOptions('scatter', { data, ...scatterOptions }, quiet), third).series[0]!.x]).toEqual([1]);\n    expect(d.replace(data, resolveOptions('donut', { data, ...donutOptions }, quiet), third).labels).toEqual(['A']);\n    expect(pf.source.rowAt(1)).toBe(row);\n    expect(df.source.rowAt(1)).toBe(row);\n    p.retire(second.revision);\n    d.retire(second.revision);\n    expect(pf.source.rowAt(1)).toBeNull();\n    expect(df.source.rowAt(1)).toBeNull();\n    expect(p.retainedRowCount).toBe(1);\n    expect(d.retainedRowCount).toBe(1);\n  });\n});\n\nit('parses numeric, category, calendar, instant and wall x values without normalizing a frame', () => {\n  const parser = (kind: 'number' | 'category' | 'date' | 'time' | 'wall', categories: readonly string[] | null = null) =>\n    createXParser({ kind, categories, timeZone: 'UTC' }, utc);\n  const numeric = parser('number');\n  expect(numeric.position(40)).toBe(40);\n  expect(numeric.position('40')).toBeNull();\n  expect(numeric.reports).toMatchObject([{ code: 'AX107', rows: [] }]);\n  const category = parser('category', ['one', '2']);\n  expect(category.position('one')).toBe(0);\n  expect(category.position('missing')).toBeNull();\n  expect(category.position(2)).toBe(1);\n  const date = parser('date');\n  expect(date.position('2024-02-29')).toBe(Date.UTC(2024, 1, 29));\n  expect(date.position('2025-02-29')).toBeNull();\n  expect(parser('time').position('2026-11-18T12:00:00+02:00')).toBe(Date.UTC(2026, 10, 18, 10));\n  const wall = parser('wall');\n","exit_code":0,"status":"completed"}}
