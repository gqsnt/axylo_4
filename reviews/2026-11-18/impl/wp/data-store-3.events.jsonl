{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/data/store-calendar.ts packages/axylo/src/data/store-diagnostics.ts\nsed -n '140,282p' packages/axylo/src/data/x.ts\nsed -n '210,342p;616,675p' packages/axylo/src/data/store.ts\nsed -n '330,460p' packages/axylo/src/data/normalize.ts\ncat packages/axylo/src/data/table.ts\"","aggregated_output":"import type { DiagnosticInput } from '../core/contracts';\nimport { createDiagnostic } from '../diagnostics';\nimport { calendarIntervals } from './steps';\n\nexport class CalendarWindow {\n  private readonly rows = new Set<number>();\n  private readonly utcBreaks = new Set<number>();\n  private readonly localBreaks = new Set<number>();\n  private last = -Infinity;\n  private distinct = 0;\n\n  constructor(private readonly zone: string = 'UTC') {}\n\n  fork(): CalendarWindow {\n    const draft = new CalendarWindow(this.zone);\n    for (const row of this.rows) draft.rows.add(row);\n    for (const position of this.utcBreaks) draft.utcBreaks.add(position);\n    for (const position of this.localBreaks) draft.localBreaks.add(position);\n    draft.last = this.last;\n    draft.distinct = this.distinct;\n    return draft;\n  }\n\n  observe(position: number): void {\n    if (position === this.last) return;\n    if (this.distinct) {\n      const interval = calendarIntervals(this.last, position, this.zone);\n      if (!(interval & 1)) this.utcBreaks.add(this.last);\n      if (!(interval & 2)) this.localBreaks.add(this.last);\n    }\n    this.last = position;\n    this.distinct++;\n  }\n\n  record(row: number): void {\n    this.rows.add(row);\n  }\n\n  evictPosition(position: number): void {\n    this.utcBreaks.delete(position);\n    this.localBreaks.delete(position);\n    if (--this.distinct === 0) this.last = -Infinity;\n  }\n\n  evictRow(row: number): void {\n    this.rows.delete(row);\n  }\n\n  private matches(): number {\n    return (this.utcBreaks.size ? 0 : 1) | (this.localBreaks.size ? 0 : 2);\n  }\n\n  private firstRows(): number[] {\n    const rows: number[] = [];\n    for (const row of this.rows) {\n      if (rows.length === 10) break;\n      rows.push(row);\n    }\n    return rows;\n  }\n\n  diagnostic(field: string, first: number): DiagnosticInput | null {\n    return Number.isFinite(first) && this.distinct >= 2 && this.matches()\n      ? createDiagnostic('AX111', 'none', { field, count: this.rows.size, rows: this.firstRows() })\n      : null;\n  }\n\n  preview(field: string, first: number, positions: Float64Array, nextRow: number): DiagnosticInput | null {\n    let matches = this.matches();\n    if (!matches || this.distinct > 0 && !Number.isFinite(first)) return null;\n    let last = this.last;\n    let distinct = this.distinct;\n    let appended = 0;\n    const rows = this.firstRows();\n    for (let i = 0; i < positions.length; i++) {\n      const position = positions[i]!;\n      if (!Number.isFinite(position)) continue;\n      if (position !== last) {\n        if (distinct) matches &= calendarIntervals(last, position, this.zone);\n        if (!matches) return null;\n        distinct++;\n        last = position;\n      }\n      appended++;\n      if (rows.length < 10) rows.push(nextRow + i);\n    }\n    return appended && distinct >= 2\n      ? createDiagnostic('AX111', 'none', { field, count: this.rows.size + appended, rows })\n      : null;\n  }\n}\nimport type { DiagnosticEffect, DiagnosticInput, DiagnosticSink, XColumn } from '../core/contracts';\nimport { DiagnosticCollector, createDiagnostic, report, type DiagnosticCode, type DiagnosticDetails } from '../diagnostics';\nimport { diagnosticContext } from '../diagnostics/registry';\nimport { positionName } from './x';\n\nexport interface DiagnosticTrace extends DiagnosticSink {\n  traceRow?(code: DiagnosticCode, field: string, effect: DiagnosticEffect, row: number, amount?: number, example?: string, series?: string): void;\n  traceGaps?(field: string, effect: DiagnosticEffect, positions: Float64Array, details?: DiagnosticDetails, axis?: XColumn): void;\n  traceSparseGaps?(details: DiagnosticDetails, seriesKey?: string): void;\n}\n\nexport function recordDiagnostics(sink: DiagnosticTrace, record: StreamDiagnostics): DiagnosticTrace {\n  return {\n    add(diagnostic) {\n      record.add(diagnostic);\n      sink.add(diagnostic);\n    },\n    traceRow(...args) {\n      record.traceRow(...args);\n      sink.traceRow?.(...args);\n    },\n    traceGaps(...args) {\n      record.traceGaps(...args);\n      sink.traceGaps?.(...args);\n    },\n    traceSparseGaps(details, seriesKey) {\n      record.traceSparseGaps(details, seriesKey);\n      if (sink.traceSparseGaps) sink.traceSparseGaps(details, seriesKey);\n      else report(sink, 'AX105', 'none', details);\n    },\n  };\n}\n\nfunction keyOf(code: DiagnosticInput['code'], field: string | undefined, effect: DiagnosticEffect): string {\n  return JSON.stringify([code, field, effect]);\n}\n\ninterface Sample {\n  count: number;\n  readonly examples: Set<string>;\n  readonly series: Set<string>;\n}\n\ninterface Occurrences {\n  readonly coordinates: Map<number, Sample>;\n  readonly gaps: boolean;\n  readonly axis?: XColumn;\n  count: number;\n}\n\nfunction addSamples(target: Set<string>, samples: Iterable<string>): void {\n  for (const sample of samples) {\n    if (target.size === 10) break;\n    target.add(sample);\n  }\n}\n\nexport class StreamDiagnostics extends DiagnosticCollector implements DiagnosticTrace {\n  private readonly occurrences = new Map<string, Occurrences>();\n  private readonly sparse = new Map<string, DiagnosticInput>();\n\n  fork(): StreamDiagnostics {\n    const draft = new StreamDiagnostics();\n    draft.merge(this);\n    return draft;\n  }\n\n  private trace(key: string, coordinate: number, gaps: boolean, amount: number,\n    examples: Iterable<string>, series: Iterable<string>, axis?: XColumn): void {\n    let entry = this.occurrences.get(key);\n    if (!entry) this.occurrences.set(key, entry = { coordinates: new Map(), count: 0, gaps, axis });\n    let sample = entry.coordinates.get(coordinate);\n    if (!sample) entry.coordinates.set(coordinate, sample = { count: 0, examples: new Set(), series: new Set() });\n    sample.count += amount;\n    addSamples(sample.examples, examples);\n    addSamples(sample.series, series);\n    entry.count += amount;\n  }\n\n  traceRow(code: DiagnosticCode, field: string, effect: DiagnosticEffect, row: number, amount = 1, example?: string, series?: string): void {\n    this.trace(keyOf(code, field, effect), row, false, amount, example === undefined ? [] : [example], series === undefined ? [] : [series]);\n  }\n\n  traceGaps(field: string, effect: DiagnosticEffect, positions: Float64Array, details?: DiagnosticDetails, axis?: XColumn): void {\n    const key = keyOf('AX105', field, effect);\n    for (const position of positions) this.trace(key, position, true, 1, [], details?.series ?? [], axis);\n  }\n\n  traceSparseGaps(details: DiagnosticDetails, seriesKey?: string): void {\n    this.sparse.set(seriesKey ?? details.sparseSeries?.[0] ?? '', createDiagnostic('AX105', 'none', details));\n  }\n\n  merge(batch: StreamDiagnostics): void {\n    for (const [name, diagnostic] of batch.sparse) this.sparse.set(name, diagnostic);\n    for (const diagnostic of batch.entries.values()) this.add(diagnostic);\n    for (const [key, { coordinates, gaps, axis }] of batch.occurrences) {\n      for (const [coordinate, sample] of coordinates) this.trace(key, coordinate, gaps, sample.count, sample.examples, sample.series, axis);\n    }\n  }\n\n  evict(coordinate: number, gaps: boolean): void {\n    for (const [key, occurrence] of this.occurrences) {\n      if (occurrence.gaps !== gaps) continue;\n      const sample = occurrence.coordinates.get(coordinate);\n      if (!sample) continue;\n      occurrence.count -= sample.count;\n      occurrence.coordinates.delete(coordinate);\n      if (occurrence.count === 0) {\n        this.entries.delete(key);\n        this.occurrences.delete(key);\n      }\n    }\n  }\n\n  evictSeries(key: string): void {\n    this.sparse.delete(key);\n  }\n\n  override inputs(): readonly DiagnosticInput[] {\n    return this.retained();\n  }\n\n  retained(): readonly DiagnosticInput[] {\n    const result = new DiagnosticCollector();\n    for (const diagnostic of this.entries.values()) {\n      const { code, field, effect, origin } = diagnostic;\n      const entry = this.occurrences.get(keyOf(code, field, effect));\n      if (!entry) {\n        result.add(diagnostic);\n        continue;\n      }\n      const rows: number[] = [];\n      const examples = new Set<string>();\n      const series = new Set<string>();\n      for (const [coordinate, sample] of entry.coordinates) {\n        if (entry.gaps) {\n          examples.add(entry.axis ? positionName(entry.axis, coordinate) : String(coordinate));\n        } else {\n          rows.push(coordinate);\n          addSamples(examples, sample.examples);\n        }\n        addSamples(series, sample.series);\n        if (rows.length === 10 || entry.gaps && examples.size === 10) break;\n      }\n      result.add(createDiagnostic(code as DiagnosticCode, effect, {\n        ...diagnosticContext(diagnostic), field, count: entry.count,\n        rows: entry.gaps ? undefined : rows, examples: [...examples], series: [...series],\n      }, origin));\n    }\n    for (const diagnostic of this.sparse.values()) result.add(diagnostic);\n    return result.inputs();\n  }\n}\n  private names: string[] | null;\n  private firstCategory = 0;\n  private firstIndex = 0;\n  private readonly indexes: Map<string, number> | null;\n  dateUnit: DateUnit | null = null;\n\n  constructor(\n    readonly field: ResolvedXField,\n    readonly kind: XKind,\n    env: Pick<Environment, 'timeZone'>,\n    private readonly scatter = false,\n    categories?: readonly string[],\n  ) {\n    this.timeZone = kind === 'time'\n      ? (field.timeZone === 'local' ? undefined : canonicalZone(field.timeZone)) ??\n        canonicalZone(env.timeZone) ?? Intl.DateTimeFormat().resolvedOptions().timeZone\n      : null;\n    this.names = kind === 'category' ? [...(categories ?? [])] : null;\n    this.indexes = this.names ? new Map(this.names.map((name, index) => [name, index])) : null;\n  }\n\n  get categories(): string[] | null {\n    return this.names && (this.firstCategory === 0 ? this.names : this.names.slice(this.firstCategory));\n  }\n\n  get categoryCount(): number {\n    return (this.names?.length ?? 0) - this.firstCategory;\n  }\n\n  categoryName(position: number): string | undefined {\n    return this.names?.[position - this.firstIndex + this.firstCategory];\n  }\n\n  fork(): XParser {\n    const draft = new XParser(this.field, this.kind, { timeZone: this.timeZone ?? 'UTC' }, this.scatter, this.categories ?? undefined);\n    draft.dateUnit = this.dateUnit;\n    draft.firstIndex = this.firstIndex;\n    if (draft.indexes && this.firstIndex !== 0) {\n      for (const [name, index] of draft.indexes) draft.indexes.set(name, index + this.firstIndex);\n    }\n    return draft;\n  }\n\n  evictCategories(count: number): void {\n    if (!this.names) return;\n    for (let i = 0; i < count; i++) {\n      this.indexes!.delete(this.names[this.firstCategory++]!);\n      this.firstIndex++;\n    }\n    if (2 * this.firstCategory >= this.names.length) {\n      this.names = this.names.slice(this.firstCategory);\n      this.firstCategory = 0;\n    }\n  }\n\n  private parse(raw: unknown, row: number, reports: Reports): number {\n    const kind = this.kind;\n    if (typeof raw === 'number' && Number.isFinite(raw)) {\n      if (kind === 'number' && !this.field.type && Math.abs(raw) >= 1e11 && Math.abs(raw) < 1e14) {\n        reports.add('AX109', 'none', row, undefined, 'Set type: \\'time\\' if these values are epoch milliseconds.');\n      }\n      if (kind === 'time' && this.field.type === 'time' && Math.abs(raw) >= 1e9 && Math.abs(raw) < 1e10) {\n        reports.add('AX109', 'none', row, undefined, 'These values look like seconds. Multiply them by 1,000 to supply epoch milliseconds.');\n      }\n      if (kind === 'number' || kind === 'time' && this.field.type === 'time' && Math.abs(raw) <= maxInstant) return raw;\n    }\n    if (kind === 'time' && raw instanceof Date) return raw.getTime();\n    if (kind === 'category' && !this.scatter) {\n      const name = this.field.type === 'category' ? nameOf(raw) : typeof raw === 'string' && kindOf(raw) === 'category' ? raw : null;\n      if (name === null) return NaN;\n      const known = this.indexes!.get(name);\n      if (known !== undefined) return known;\n      const index = this.firstIndex + this.categoryCount;\n      this.names!.push(name);\n      this.indexes!.set(name, index);\n      return index;\n    }\n    if (kind === 'date' && this.field.type === 'date' && (typeof raw === 'number' || raw instanceof Date ||\n      typeof raw === 'string' && kindOf(raw) === 'time')) {\n      const ms = typeof raw === 'number' ? new Date(raw).getTime() : raw instanceof Date ? raw.getTime() : instant(raw, 'time');\n      if (!Number.isFinite(ms)) return NaN;\n      this.dateUnit = 'day';\n      return Math.floor(ms / DAY) * DAY;\n    }\n    if (typeof raw !== 'string') return NaN;\n    if (kind === 'date') {\n      const parts = calendar.exec(raw);\n      if (!parts || !validDate(parts[1]!, parts[2], parts[3])) return NaN;\n      const unit: DateUnit = parts[3] !== undefined ? 'day' : parts[2] !== undefined ? 'month' : 'year';\n      if (this.dateUnit === null || unit === 'day' || unit === 'month' && this.dateUnit === 'year') this.dateUnit = unit;\n      return Date.parse(parts[1] + '-' + (parts[2] ?? '01') + '-' + (parts[3] ?? '01') + 'T00:00:00Z');\n    }\n    if (kind === 'wall' || kind === 'time') {\n      const position = instant(raw, kind);\n      if (kind === 'wall' && Number.isFinite(position)) reports.add('AX112', 'none', row);\n      return position;\n    }\n    return NaN;\n  }\n\n  read(raw: unknown, row: number, reports: Reports, omitted = 1): number {\n    if (raw === undefined) {\n      reports.add('AX102', 'omitted', row, undefined, undefined, { amount: omitted, outcome: 'The affected row is not drawn.' });\n      return NaN;\n    }\n    const result = this.parse(raw, row, reports);\n    if (!Number.isFinite(result)) {\n      const fix = this.scatter && this.kind === 'category'\n        ? 'Use a numeric, calendar date or time field for scatter x values.'\n        : undefined;\n      reports.add('AX107', 'omitted', row, raw, fix, { amount: omitted });\n    }\n    return result;\n  }\n\n  restore(categoryCount: number, dateUnit: DateUnit | null): void {\n    this.dateUnit = dateUnit;\n    if (!this.names) return;\n    while (this.categoryCount > categoryCount) this.indexes!.delete(this.names.pop()!);\n  }\n\n  column(values: Float64Array, snapshotCategories = false): XColumn {\n    const names = this.names;\n    const start = this.firstCategory;\n    const length = names?.length;\n    let snapshot: readonly string[] | undefined;\n    return {\n      kind: this.kind, values,\n      get categories() {\n        return names === null || !snapshotCategories && start === 0 ? names : (snapshot ??= names.slice(start, length));\n      },\n      timeZone: this.timeZone, dateUnit: this.kind === 'date' ? this.dateUnit ?? 'day' : null,\n      ordered: this.kind === 'category' && this.field.ordered,\n    };\n  }\n}\n\nexport function dailyDelta(delta: number): number {\n  const days = Math.round(delta / DAY);\n  return days > 0 && Math.abs(delta - days * DAY) <= HOUR ? days * DAY : delta;\n}\n\nexport function sameDailyTime(first: number, position: number): boolean {\ninterface State {\n  readonly axis: XColumn;\n  readonly parser: XData['parser'];\n  readonly buffers: FrameBuffers;\n  readonly history: Map<string, Cadence>;\n  readonly observations: Map<string, Observations>;\n  readonly duplicates: Map<string, Set<number>>;\n  readonly modes: Map<string, ValueCounts>;\n  readonly calendar: CalendarWindow | null;\n  readonly votes: KindVotes | null;\n  readonly dateUnits: Record<DateUnit, number> | null;\n  readonly overBudget: boolean;\n  readonly diagnostics: StreamDiagnostics;\n}\n\ninterface BatchSeries {\n  readonly key: string;\n  readonly value: ResolvedValueField;\n  readonly values: Values;\n  readonly rows: readonly number[];\n  readonly cadence: Cadence;\n  readonly duplicates: readonly number[];\n  readonly gaps: Float64Array | null;\n  readonly sparse: number;\n}\n\ninterface Batch {\n  readonly positions: Float64Array;\n  readonly axis: XColumn;\n  readonly series: readonly BatchSeries[];\n  readonly x: Float64Array;\n  readonly observed: Uint8Array;\n  readonly modes: State['modes'];\n  readonly diagnostics: StreamDiagnostics;\n}\n\nfunction tail(\n  positions: Float64Array, series: readonly BatchSeries[], lastX: number,\n): { x: Float64Array; observed: Uint8Array } {\n  const gapCount = series.reduce((sum, item) => sum + (item.gaps?.length ?? 0), 0);\n  const distinct = new Float64Array(positions.length + gapCount);\n  let length = 0;\n  for (const position of positions) {\n    if (position > lastX && Number.isFinite(position) && (!length || position !== distinct[length - 1])) distinct[length++] = position;\n  }\n  const seen = distinct.subarray(0, length);\n  if (!gapCount) return { x: seen, observed: new Uint8Array(length).fill(1) };\n  const union = distinct.slice(0, length + gapCount);\n  for (const { gaps } of series) {\n    if (!gaps) continue;\n    union.set(gaps, length);\n    length += gaps.length;\n  }\n  union.sort();\n  const observed = new Uint8Array(length);\n  let index = 0;\n  let count = 0;\n  for (const x of union) {\n    if (count && x === union[count - 1]) continue;\n    union[count] = x;\n    if (seen[index] === x) {\n      observed[count] = 1;\n      index++;\n    }\n    count++;\n  }\n  return { x: union.subarray(0, count), observed: observed.subarray(0, count) };\n}\n\nfunction extendSeries(\n  key: string, field: ResolvedValueField, values: Values, rows: readonly number[],\n  positions: Float64Array, state: State, axis: XColumn, lastX: number,\n  duplicates: Reports, firstRow: number, observedX: () => Float64Array, label: string = key,\n): BatchSeries | null {\n  const previous = state.history.get(key) ?? cadence();\n  const next = { ...previous };\n  const observed: number[] = [];\n  const repeated: number[] = [];\n  for (const row of rows) {\n    const position = positions[row]!;\n    if (position === next.last) {\n      repeated.push(position);\n      duplicates.add('AX108', 'series-disabled', firstRow + row, undefined, undefined, {\n        series: label, position: axis.kind === 'category' ? JSON.stringify(state.parser.categoryName(position)) : positionName(axis, position),\n      });\n    } else {\n      extend(next, axis, position);\n      observed.push(row);\n    }\n  }\n  if (next.multiple === null && next.differences >= 2 && 2 * next.matches >= next.differences) return null;\n  const oldStep = step(previous);\n  const newStep = step(next);\n  const oldAbsent = absent(previous, oldStep);\n  const nextAbsent = absent(next, newStep);\n  const oldSparse = tooSparse(oldAbsent, previous.differences + 1);\n  const newSparse = tooSparse(nextAbsent, next.differences + 1);\n  if (oldSparse !== newSparse || oldStep !== newStep && !newSparse &&\n    (oldAbsent > 0 || absent(previous, newStep) > 0)) return null;\n  if (newSparse) return { key, value: field, values, rows: observed, cadence: next, gaps: null, duplicates: repeated, sparse: nextAbsent };\n\n  let gapCount = 0;\n  if (newStep) {\n    let last = previous.last;\n    for (const row of observed) {\n      const position = positions[row]!;\n      if (last !== -Infinity) gapCount += stepMultiple(stepDelta(axis, last, position), newStep) - 1;\n      last = position;\n    }\n  }\n  const gaps = gapCount ? new Float64Array(gapCount) : null;\n  if (gaps) {\n    let index = 0;\n    let last = previous.last;\n    for (const row of observed) {\n      const position = positions[row]!;\n      const multiple = last === -Infinity ? 0 : stepMultiple(stepDelta(axis, last, position), newStep);\n      for (let j = 1; j < multiple; j++) {\n        let gap = gapPosition(axis, last, position, newStep, j, multiple);\n        if (axis.kind === 'number') {\n          const x = observedX();\n          const previous = Number.isFinite(lastX) ? 1 : 0;\n          gap = snapGap(gap, last, position, newStep, x.length + previous, i => previous && i === 0 ? lastX : x[i - previous]!);\n        }\n        if (gap <= lastX) return null;\n        gaps[index++] = gap;\n      }\n      last = position;\n    }\n  }\n  return { key, value: field, values, rows: observed, cadence: next, gaps, duplicates: repeated, sparse: 0 };\n}\n\n  private batch(table: Table, positions: Float64Array, axis: XColumn, lastX: number, diagnostics: StreamDiagnostics): Batch | null {\n    const { state, fields } = this;\n    const modes = new Map(state.modes);\n    const values = new Map<string, Values>();\n    const included = (i: number) => Number.isFinite(positions[i]);\n    for (const field of fields.values) {\n      const before = modes.get(field.field) ?? { decimal: 0, other: 0 };\n      const added = valueCounts(table, field.field, positions);\n      if (mode(before) === 'decimal' && added.other) return null;\n      const counts = { decimal: before.decimal + added.decimal, other: before.other + added.other };\n      modes.set(field.field, counts);\n      values.set(field.field, readValues(table, field, diagnostics, true, this.rows.next, mode(counts), included));\n    }\n\n    const memberships = new Map<string, number[]>();\n    const seriesReports = fields.series === null ? null : new Reports(fields.series, diagnostics);\n    const allRows: number[] = [];\n    for (let i = 0; i < table.length; i++) {\n      const position = positions[i]!;\n      if (Number.isFinite(position) && !seriesReports) allRows.push(i);\n      if (!seriesReports) continue;\n      const raw = table.read(i, fields.series!);\n      const key = nameOf(raw);\n      if (key === null) {\n        if (raw === undefined) seriesReports.add('AX102', 'omitted', this.rows.next + i, undefined, undefined, { outcome: 'The affected row is not drawn.' });\n        else seriesReports.add('AX107', 'omitted', this.rows.next + i, raw, 'Supply a name for the series in each row.');\n        continue;\n      }\n      if (!Number.isFinite(position)) continue;\n      let indexes = memberships.get(key);\n      if (!indexes) memberships.set(key, indexes = []);\n      indexes.push(i);\n    }\n    seriesReports?.flush(diagnostics);\n\n    const series: BatchSeries[] = [];\n    const duplicates = new Reports(fields.x.field, diagnostics);\n    let validX: Float64Array | undefined;\n    const observedX = () => validX ??= positions.every(Number.isFinite) ? positions : positions.filter(Number.isFinite);\n    if (fields.series !== null) {\n      for (const [key, rows] of memberships) {\n        const value = fields.values[0]!;\n        const item = extendSeries(key, value, values.get(value.field)!, rows, positions, state, axis, lastX, duplicates, this.rows.next, observedX);\n        if (!item) return null;\n        series.push(item);\n      }\n    } else {\n      for (const field of fields.values) {\n        const item = extendSeries(field.field, field, values.get(field.field)!, allRows, positions, state, axis, lastX, duplicates, this.rows.next, observedX, field.label);\n        if (!item) return null;\n        series.push(item);\n      }\n    }\n    duplicates.flush(diagnostics);\n    for (const item of series) {\n      reportGaps(diagnostics, fields.x.field, item.value.missing === 'zero', item.gaps, axis, this.label(item.key), item.sparse, item.key);\n    }\n    return { positions, axis, series, ...tail(positions, series, lastX), modes, diagnostics };\n  }\n\n    return alignedSeries(group, column, x, table, values);\n  });\n  for (const { group, gaps, sparse } of aligned) {\n    reportGaps(sink, options.x.field, group.value.missing === 'zero', gaps, axis, group.label, sparse, group.key);\n  }\n  return { ...frame, x: column, length: positions.length, series };\n}\n\nexport function pointFrame(options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion): PointFrame {\n  const { table } = options;\n  const value = options.values[0]!;\n  const included = x.order === null ? undefined : (row: number) => Number.isFinite(x.positions[row]);\n  const members = groups(options, x, sink);\n  const values = readValues(table, value, sink, false, 0, undefined, included, 'The affected points are not drawn.');\n  const series = members.map(group => {\n    const length = group.order?.length ?? x.positions.length;\n    if (!group.order && values.y instanceof Float64Array && values.slot.every(slot => slot === SLOT_VALUE)) {\n      return {\n        key: group.key, label: group.label, drawable: true, x: x.positions, y: values.y,\n        row: table.columns ? null : sourceRows(table),\n      };\n    }\n    const rows = new Int32Array(length);\n    let next = 0;\n    for (let i = 0; i < length; i++) {\n      const row = group.order?.[i] ?? i;\n      if (values.slot[row] === SLOT_VALUE) rows[next++] = row;\n    }\n    const kept = rows.subarray(0, next);\n    kept.sort((a, b) => x.positions[a]! - x.positions[b]! || values.y[a]! - values.y[b]!);\n    return {\n      key: group.key, label: group.label, drawable: true,\n      x: Float64Array.from(kept, row => x.positions[row]!), y: Float64Array.from(kept, row => values.y[row]!), row: Int32Array.from(kept, table.rowIndex),\n    };\n  });\n\n  return {\n    ...base(options.table, version), shape: 'points', xKind: x.parser.kind === 'category' ? 'number' : x.parser.kind,\n    timeZone: x.parser.timeZone, series, xLabel: options.x.label, yLabel: value.label, xUnit: options.x.unit, yUnit: value.unit,\n  };\n}\n\nfunction donutFrame(options: ResolvedOptions, sink: DiagnosticSink, version: FrameVersion): DonutFrame {\n  const { table, x } = options;\n  const field = options.values[0]!;\n  const labels: string[] = [];\n  const seen = new Set<string>();\n  const issues = new Reports(x.field, sink);\n  const negatives = new Reports(field.field, sink);\n  const rows = new Int32Array(table.length);\n  const included = new Uint8Array(table.length);\n  for (let i = 0; i < table.length; i++) {\n    const raw = table.read(i, x.field);\n    const name = nameOf(raw);\n    if (name === null) {\n      if (Number.isNaN(raw) && table.isColumnRow(i)) continue;\n      if (raw === undefined) issues.add('AX102', 'omitted', table.rowIndex(i), undefined, undefined, { outcome: 'The affected slice is not drawn.' });\n      else issues.add('AX107', 'omitted', table.rowIndex(i), raw, 'Supply a label for each donut value.');\n    } else {\n      if (seen.has(name)) issues.add('AX108', 'chart-error', table.rowIndex(i), name);\n      seen.add(name);\n      rows[labels.length] = i;\n      labels.push(name);\n      included[i] = 1;\n    }\n  }\n  issues.flush(sink);\n  const order = rows.subarray(0, labels.length);\n  const values = readValues(table, field, sink, true, 0, undefined, i => included[i] === 1);\n  const provenance = table.columns && order.length === table.length && field.missing !== 'zero'\n    ? null : Int32Array.from(order, table.rowIndex);\n  for (let i = 0; i < order.length; i++) {\n    const row = order[i]!;\n    const value = values.y[row]!;\n    if (value < 0) negatives.add('AX120', 'chart-error', table.rowIndex(row), value);\n    if (field.missing === 'zero' && (values.slot[row] === SLOT_NULL || values.slot[row] === SLOT_ABSENT_FIELD)) {\n      values.slot[row] = SLOT_VALUE;\n      provenance![i] = -1;\n    }\n  }\n  negatives.flush(sink);\n  const allRows = order.length === table.length;\n  return {\n    ...base(table, version), shape: 'donut', labels,\n    values: allRows && values.y instanceof Float64Array ? values.y : Float64Array.from(order, row => values.y[row]!),\n    slot: allRows ? values.slot : Uint8Array.from(order, row => values.slot[row]!),\n    row: provenance,\n    valueLabel: field.label, unit: field.unit, valueScale: field.scale,\n  };\n}\n\ninterface AlignedSeed {\n  readonly options: ResolvedOptions;\n  readonly type: AlignedChartType;\n  readonly x: XData;\n  readonly counts: Map<string, ValueCounts>;\n  readonly diagnostics: StreamDiagnostics;\n}\n\nconst alignedSeeds = new WeakMap<AlignedFrame, AlignedSeed>();\n\nexport function alignedSeed(frame: AlignedFrame): AlignedSeed | undefined {\n  return alignedSeeds.get(frame);\n}\n\nexport function normalize(type: AlignedChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): AlignedFrame;\nexport function normalize(type: 'scatter', options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): PointFrame;\nexport function normalize(type: 'donut', options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): DonutFrame;\nexport function normalize(type: ChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Frame;\nexport function normalize(type: ChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Frame {\n  const valid = options.valid ? options : { ...options, table: { ...options.table, columns: null, length: 0 } };\n  if (type === 'donut') return donutFrame(valid, sink, version);\n  const diagnostics = type !== 'scatter' && options.valid && options.series === null ? new StreamDiagnostics() : null;\n  const observe = diagnostics ? recordDiagnostics(sink, diagnostics) : sink;\n  const x = readX(type, valid, env, observe);\n  reportCalendarDates(x, valid.table, sink);\n  if (type === 'scatter') return pointFrame(valid, x, sink, version);\n  // Ascending wide axes can initialize the streaming indexes from normalized positions.\n  const counts = diagnostics && x.order === null ? new Map<string, ValueCounts>() : undefined;\n  const frame = alignedFrame(valid, x, observe, version, counts);\n  if (counts && diagnostics && frame.series.length === options.values.length) {\n    alignedSeeds.set(frame, { options, type, x, counts, diagnostics });\n  }\n  return frame;\n}\nimport type { RowSource } from '../core/contracts';\n\nexport type Columns = Readonly<Record<string, ArrayLike<unknown>>>;\n\nexport interface Table extends RowSource {\n  readonly length: number;\n  readonly columns: Columns | null;\n  read(row: number, field: string): unknown;\n  isColumnRow(row: number): boolean;\n  rowIndex(row: number): number;\n  hasField(field: string): boolean;\n  keys(): readonly string[];\n}\n\nconst origins = new WeakMap<Table, readonly unknown[] | Columns>();\n\nexport function sameTableData(a: Table, b: Table): boolean {\n  const origin = origins.get(a);\n  return a === b || (origin !== undefined && origin === origins.get(b) && a.length === b.length);\n}\n\nfunction record(row: unknown): Record<string, unknown> | null {\n  return row !== null && typeof row === 'object' ? row as Record<string, unknown> : null;\n}\n\nexport function rowValue(row: unknown, field: string): unknown {\n  const object = record(row);\n  return object && Object.hasOwn(object, field) ? object[field] : undefined;\n}\n\nexport function rowsTable(rows: readonly unknown[]): Table {\n  const table: Table = {\n    length: rows.length,\n    columns: null,\n    read: (row, field) => rowValue(rows[row], field),\n    rowAt: row => row >= 0 && row < rows.length && Number.isInteger(row) ? rows[row] : null,\n    isColumnRow: () => false,\n    rowIndex: row => row,\n    hasField: field => rows.some(row => {\n      const object = record(row);\n      return object !== null && Object.hasOwn(object, field);\n    }),\n    keys: () => {\n      const keys = new Set<string>();\n      for (const row of rows) for (const key of Object.keys(record(row) ?? {})) keys.add(key);\n      return [...keys];\n    },\n  };\n  origins.set(table, rows);\n  return table;\n}\n\nexport function columnsTable(columns: Columns, length: number): Table {\n  const keys = Object.keys(columns);\n  const table: Table = {\n    length,\n    columns,\n    read: (row, field) => Object.hasOwn(columns, field) ? columns[field]?.[row] : undefined,\n    rowAt: row => row >= 0 && row < length && Number.isInteger(row)\n      ? Object.fromEntries(keys.map(key => [key, columns[key]?.[row]]))\n      : null,\n    hasField: field => Object.hasOwn(columns, field),\n    isColumnRow: () => true,\n    rowIndex: row => row,\n    keys: () => keys,\n  };\n  origins.set(table, columns);\n  return table;\n}\n","exit_code":0,"status":"completed"}}
