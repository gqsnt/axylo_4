onst label = nameOf(options.table.read(i, options.x.field));\n    if (label === null) continue;\n    let index = labels.get(label);\n    if (index === undefined) labels.set(label, index = labels.size);\n    positions[i] = index;\n    order[length++] = i;\n  }\n  order.sort((a, b) => positions[a]! - positions[b]!);\n  return { frame, positions, order };\n}\n\nfunction firstPosition(result: Result<PointFrame | DonutFrame>, keep: number): number {\n  const { positions, order } = result;\n  let first = Infinity;\n  let distinct = 0;\n  for (let i = (order?.length ?? positions.length) - 1; i >= 0; i--) {\n    const position = positions[order?.[i] ?? i]!;\n    if (position === first) continue;\n    if (distinct === keep) return first;\n    first = position;\n    distinct++;\n  }\n  return -Infinity;\n}\n\nfunction firstAtOrAfter(positions: Float64Array, first: number): number {\n  let low = 0;\n  let high = positions.length;\n  while (low < high) {\n    const middle = low + Math.floor((high - low) / 2);\n    if (positions[middle]! < first) low = middle + 1;\n    else high = middle;\n  }\n  return low;\n}\n\nfunction ordered(positions: Float64Array, last: number = -Infinity): boolean {\n  for (const position of positions) {\n    if (!Number.isFinite(position) || position < last) return false;\n    last = position;\n  }\n  return true;\n}\n\nfunction extendPoints(frame: PointFrame, positions: Float64Array, next: Result<PointFrame>, keep: number | undefined): Extension<PointFrame> | null {\n  const before = frame.series[0];\n  const after = next.frame.series[0];\n  if (frame.xKind !== 'number' || next.frame.xKind !== 'number' || !before || !after ||\n    frame.series.length !== 1 || next.frame.series.length !== 1 || !ordered(positions) ||\n    !ordered(next.positions, positions.at(-1))) return null;\n\n  const all = new Float64Array(positions.length + next.positions.length);\n  all.set(positions);\n  all.set(next.positions, positions.length);\n  const first = keep === undefined ? -Infinity : firstPosition({ frame, positions: all, order: null }, keep);\n  const dropped = firstAtOrAfter(all, first);\n  let a = firstAtOrAfter(before.x, first);\n  let b = firstAtOrAfter(after.x, first);\n  const length = before.x.length + after.x.length - a - b;\n  const x = new Float64Array(length);\n  const y = new Float64Array(length);\n  const row = new Int32Array(length);\n  // The adjacent batches can share an x. Merge ties by y and preserve the source order of coincident points.\n  for (let i = 0; i < length; i++) {\n    const fromBefore = b === after.x.length || a < before.x.length &&\n      (before.x[a]! < after.x[b]! || before.x[a] === after.x[b] && before.y[a]! <= after.y[b]!);\n    const group = fromBefore ? before : after;\n    const index = fromBefore ? a++ : b++;\n    x[i] = group.x[index]!;\n    y[i] = group.y[index]!;\n    row[i] = group.row?.[index] ?? index;\n  }\n  return {\n    frame: { ...next.frame, series: [{ ...before, x, y, row }] },\n    positions: dropped ? all.slice(dropped) : all, dropped,\n  };\n}\n\nfunction extendDonut(frame: DonutFrame, positions: Float64Array, next: Result<DonutFrame>, keep: number | undefined): Extension<DonutFrame> | null {\n  if (frame.labels.length !== positions.length || next.frame.labels.length !== next.positions.length) return null;\n  const names = new Set(frame.labels);\n  const after = next.frame;\n  if (after.labels.some(label => names.has(label))) return null;\n  const count = frame.labels.length + after.labels.length;\n  const dropped = keep === undefined ? 0 : Math.max(0, count - keep);\n  const length = count - dropped;\n  const labels = new Array<string>(length);\n  const values = new Float64Array(length);\n  const slot = new Uint8Array(length);\n  const row = new Int32Array(length);\n  for (let i = 0; i < length; i++) {\n    const index = dropped + i;\n    const source = index < frame.labels.length ? frame : after;\n    const offset = source === frame ? index : index - frame.labels.length;\n    labels[i] = source.labels[offset]!;\n    values[i] = source.values[offset]!;\n    slot[i] = source.slot[offset]!;\n    row[i] = source.row?.[offset] ?? offset;\n  }\n  return {\n    frame: { ...after, labels, values, slot, row },\n    positions: Float64Array.from({ length }, (_, i) => i), dropped,\n  };\n}\n\nfunction removeRows(table: Table, positions: Float64Array, keep: number, first: number, rows: StreamRows): number[] {\n  let unplaced = 0;\n  for (let i = 0; i < table.length; i++) {\n    if (!Number.isFinite(positions[i])) unplaced++;\n  }\n  let excess = Math.max(0, unplaced - 2 * keep);\n  const removed: number[] = [];\n  for (let i = 0; i < table.length; i++) {\n    const position = positions[i]!;\n    if (Number.isFinite(position) ? position >= first : excess-- <= 0) continue;\n    const row = table.rowIndex(i);\n    rows.forget(row);\n    removed.push(row);\n  }\n  return removed;\n}\n\nclass UnalignedStore<F extends PointFrame | DonutFrame> {\n  private rows: StreamRows;\n  private readonly revisions: RowRevisions;\n  private encoding: ResolvedOptions;\n  private current: F;\n  private latest: readonly DiagnosticInput[];\n  private positions: Float64Array;\n\n  constructor(\n    private readonly type: 'scatter' | 'donut',\n    private readonly build: Build<F>,\n    private readonly extend: Extend<F>,\n    options: ResolvedOptions,\n    private readonly environment: DataEnvironment,\n    version: FrameVersion,\n    private readonly sink: DiagnosticSink,\n  ) {\n    this.rows = new StreamRows(options.table);\n    this.revisions = new RowRevisions(this.rows);\n    this.encoding = withoutTable(options);\n    const diagnostics = new DiagnosticCollector();\n    const { frame, positions } = build({ ...options, table: this.rows.table() }, environment, diagnostics, version);\n    this.positions = positions;\n    const source = new FrameSource(this.rows.next, this.rows);\n    this.current = { ...frame, source };\n    this.revisions.current.publish(frame.revision, source, this.rows);\n    this.latest = diagnostics.inputs();\n    for (const diagnostic of this.latest) sink.add(diagnostic);\n  }\n\n  get frame(): F { return this.current; }\n  get diagnostics(): readonly DiagnosticInput[] { return this.latest; }\n  get retainedRowCount(): number { return this.revisions.size; }\n\n  retire(revision: number): void { this.revisions.retire(revision); }\n\n  /** Validates encoding against the retained rows and returns options for re-encoding this store. */\n  resolveEncoding(input: unknown, sink: DiagnosticSink): ResolvedOptions {\n    return withoutTable(resolveOptions(this.type, input, sink, this.rows.table()));\n  }\n\n  append(rows: readonly unknown[], options: StoreAppendOptions = {}, sink = this.sink): F {\n    const prepared = this.prepareAppend(rows, options);\n    for (const diagnostic of prepared.callDiagnostics) sink.add(diagnostic);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareAppend(rows: readonly unknown[], options: StoreAppendOptions = {}): PreparedFrame<F> {\n    const base = this.current;\n    const version = { epoch: base.epoch, revision: base.revision + 1 };\n    const keep = retention(options);\n    const fast = this.extendAppend(base, rows, version, keep);\n    if (fast) return fast;\n    const retained = this.rows.fork();\n    retained.append(rows);\n    let table = retained.table();\n    const call = new DiagnosticCollector();\n    const resolved = retargetOptions(this.encoding, table, call);\n    let result = this.build(resolved, this.environment, call, version);\n    const ordering = new DiagnosticCollector();\n    if (this.type === 'scatter') {\n      const reports = new Reports(this.encoding.x.field, ordering);\n      let highest = -Infinity;\n      for (let i = 0; i < result.positions.length; i++) {\n        const position = result.positions[i]!;\n        if (!Number.isFinite(position)) continue;\n        const row = table.rowIndex(i);\n        if (row >= this.rows.next && position < highest) reports.add('AX151', 'none', row);\n        highest = Math.max(highest, position);\n      }\n      reports.flush(ordering);\n    }\n    let current = call;\n    const evicted: number[] = [];\n    if (keep !== undefined) {\n      // Removing rows can change the inferred kind and make formerly unplaceable x values usable.\n      while (true) {\n        const removed = removeRows(table, result.positions, keep, firstPosition(result, keep), retained);\n        if (removed.length === 0) break;\n        for (const row of removed) evicted.push(row);\n        current = new DiagnosticCollector();\n        table = retained.table();\n        const encoded = retargetOptions(this.encoding, table, current);\n        result = this.build(encoded, this.environment, current, version);\n      }\n    }\n    const ordered = ordering.inputs();\n    return this.prepare(base, result.frame, retained, result.positions, [...current.inputs(), ...ordered], [...call.inputs(), ...ordered], evicted);\n  }\n\n  private extendAppend(base: F, rows: readonly unknown[], version: FrameVersion, keep: number | undefined): PreparedFrame<F> | null {\n    // Implicit string parsing and diagnostics can change when old rows leave. Reuse old values only when\n    // both partitions have unambiguous clean values and the same x interpretation.\n    if (this.latest.length || this.encoding.values[0]?.parse || this.encoding.series !== null ||\n      this.positions.length !== this.rows.size) return null;\n    const table = { ...rowsTable(rows), rowIndex: (row: number) => this.rows.next + row };\n    const diagnostics = new DiagnosticCollector();\n    const resolved = retargetOptions(this.encoding, table, diagnostics);\n    if (!resolved.valid) return null;\n    const result = this.build(resolved, this.environment, diagnostics, version);\n    if (diagnostics.inputs().length) return null;\n    const extension = this.extend(base, this.positions, result, keep);\n    if (!extension) return null;\n    const retained = this.rows.fork();\n    retained.append(rows);\n    const evicted: number[] = [];\n    if (extension.dropped > 0) {\n      const combined = retained.table();\n      for (let i = 0; i < extension.dropped; i++) {\n        const row = combined.rowIndex(i);\n        retained.forget(row);\n        evicted.push(row);\n      }\n    }\n    return this.prepare(base, extension.frame, retained, extension.positions, [], [], evicted);\n  }\n\n  reencode(options: ResolvedOptions, version: FrameVersion): F {\n    const prepared = this.prepareReencode(options, version);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareReencode(options: ResolvedOptions, version: FrameVersion): PreparedFrame<F> {\n    return this.prepareEncoding(this.rows, options, version, new DiagnosticCollector());\n  }\n\n  replace(data: unknown, options: ResolvedOptions, version: FrameVersion): F {\n    const prepared = this.prepareReplace(data, options, version);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareReplace(data: unknown, options: ResolvedOptions, version: FrameVersion): PreparedFrame<F> {\n    const call = new DiagnosticCollector();\n    const replacement = resolveTable(data, call);\n    return this.prepareEncoding(new StreamRows(replacement.table), options, version, call, replacement);\n  }\n\n  private prepareEncoding(\n    rows: StreamRows, options: ResolvedOptions, version: FrameVersion, call: DiagnosticCollector,\n    replacement?: { table: Table; valid: boolean },\n  ): PreparedFrame<F> {\n    const base = this.current;\n    if (version.revision <= base.revision || version.epoch <= base.epoch) {\n      throw new Error('Encoding updates and replacements require a newer epoch and revision.');\n    }\n    const table = rows.table();\n    const resolved = retargetOptions(options, replacement?.table ?? table, call, replacement?.valid);\n    const { frame, positions } = this.build({ ...resolved, table }, this.environment, call, version);\n    const diagnostics = call.inputs();\n    return this.prepare(base, frame, rows, positions, diagnostics, diagnostics, [], options, replacement !== undefined);\n  }\n\n  private prepare(\n    base: F, frame: F, rows: StreamRows, positions: Float64Array,\n    diagnostics: readonly DiagnosticInput[], callDiagnostics: readonly DiagnosticInput[],\n    evicted: readonly number[], options = this.encoding, replacement = false,\n  ): PreparedFrame<F> {\n    const source = new FrameSource(rows.next, rows);\n    const candidate = { ...frame, source };\n    const commit = once(() => this.current, () => {\n      if (replacement) this.revisions.replace(rows);\n      for (const row of evicted) this.revisions.current.archive(row);\n      this.rows = rows;\n      this.current = candidate;\n      this.latest = diagnostics;\n      this.positions = positions;\n      if (options !== this.encoding) this.encoding = withoutTable(options);\n      this.revisions.current.publish(candidate.revision, source, rows);\n    }, base);\n    return { frame: candidate, diagnostics, callDiagnostics, commit };\n  }\n}\n\nexport class PointStore extends UnalignedStore<PointFrame> {\n  constructor(options: ResolvedOptions, environment: DataEnvironment, version: FrameVersion, sink: DiagnosticSink = quiet) {\n    super('scatter', buildPoints, extendPoints, options, environment, version, sink);\n  }\n}\n\nexport class DonutStore extends UnalignedStore<DonutFrame> {\n  constructor(options: ResolvedOptions, environment: DataEnvironment, version: FrameVersion, sink: DiagnosticSink = quiet) {\n    super('donut', buildDonut, extendDonut, options, environment, version, sink);\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,170p' packages/axylo/src/core/contracts.ts\nsed -n '107,130p;167,204p;336,348p' docs/03-plan-typescript-release.md\nsed -n '148,188p;218,255p' docs/02-product-spec.md\nsed -n '1,75p' reviews/2026-11-18/impl/wp/core3.controller.review.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,170p' packages/axylo/src/core/contracts.ts\nsed -n '107,130p;167,204p;336,348p' docs/03-plan-typescript-release.md\nsed -n '148,188p;218,255p' docs/02-product-spec.md\nsed -n '1,75p' reviews/2026-11-18/impl/wp/core3.controller.review.md\"","aggregated_output":"/**\n * Internal contracts of Axylo. Every module is written against these types and against nothing else in\n * another module. Changing this file is an architecture change: it needs a reason recorded in the commit.\n *\n * Pipeline (docs/03-plan-typescript-release.md, section 2):\n *\n *   options ─► normalize ─► Frame ─┬─► View ─► Layout ─► Scene ─► MarkRenderer / TextLayer\n *                │ diagnostics      ├─► lookup (exact values)\n *                                   ├─► summary, table\n *                                   └─► focus model\n *\n * Rule that must never be broken: exact values, the table, keyboard navigation, tooltips, summaries and\n * events read the Frame. The Scene is geometry for drawing and may be simplified. Nothing reads values\n * back from the Scene.\n */\nimport type { Diagnostic, XValue } from '../public';\n\n// ───────────────────────────── diagnostics ─────────────────────────────\n\n/**\n * What a diagnostic did to the chart. Drives the reader's note (spec F12): only 'omitted' and 'changed'\n * count towards \"N values not shown\"; a warning about contrast or an unknown option does not.\n */\nexport type DiagnosticEffect = 'none' | 'omitted' | 'changed' | 'series-disabled' | 'chart-error';\n\n/** A diagnostic before the chart adds its own name. */\nexport type DiagnosticInput = Omit<Diagnostic, 'chart'> & {\n  readonly effect: DiagnosticEffect;\n  /**\n   * 'call': found while validating a create, update or append call; a `strict` chart throws from that call.\n   * 'presentation': found later (a contrast check after a CSS change, a formatter that throws on a lazily\n   * built table cell, a label that no longer fits after a resize); reported when found, never thrown.\n   */\n  readonly origin: 'call' | 'presentation';\n};\n\nexport interface DiagnosticSink {\n  /** Adds one diagnostic. The sink merges by code, field and effect: counts are added, example rows capped at 10. */\n  add(d: DiagnosticInput): void;\n}\n\n// ───────────────────────────── frame ─────────────────────────────\n\n/**\n * What an x value is.\n *  number   – a plain measure.\n *  time     – an instant. Position = epoch milliseconds (UTC). Shown in `XColumn.timeZone`.\n *  date     – a calendar date, month or year. Position = epoch milliseconds of that date at 00:00 UTC;\n *             always formatted in UTC, so it reads the same in every viewer zone.\n *  wall     – a date-time written without an offset. Position = the written fields read as if UTC;\n *             always formatted in UTC (\"shown as written\").\n *  category – a name. Position = index in first-seen order (bar, line) or given order (donut).\n */\nexport type XKind = 'number' | 'time' | 'date' | 'wall' | 'category';\n\n/** State of one slot of an aligned series. */\nexport const SLOT_VALUE = 0;         // a finite number\nexport const SLOT_NULL = 1;          // explicit null (or NaN in a typed column, or an empty string): \"no data\", silent\nexport const SLOT_INVALID = 2;       // present but not plottable (NaN or infinity in a row, a stray string): reported\nexport const SLOT_NO_ROW = 3;        // this series has no observation at this x and none was expected; neighbours may be joined across it\nexport const SLOT_GAP = 4;           // an expected step of this series is absent (AX105): never joined across\nexport const SLOT_ABSENT_FIELD = 5;  // the row exists but the field's key is absent or undefined (AX102)\nexport type SlotState = 0 | 1 | 2 | 3 | 4 | 5;\n/**\n * `missing: 'zero'` on a value field is applied by normalization: slots that would be SLOT_NULL, SLOT_NO_ROW,\n * SLOT_GAP or SLOT_ABSENT_FIELD become SLOT_VALUE with y = 0 and row = -1. SLOT_INVALID is never turned into zero.\n */\n\n/** Half-open range of indexes. */\nexport interface IndexRange { readonly start: number; readonly end: number }\n\nexport interface XColumn {\n  readonly kind: XKind;\n  /** Strictly ascending positions, one per slot. For 'category': 0, 1, 2, … */\n  readonly values: Float64Array;\n  /** For 'category': the name of each position. Otherwise null. */\n  readonly categories: readonly string[] | null;\n  /** For 'time': the resolved IANA zone ('UTC', 'America/Los_Angeles', …; 'local' is resolved before it gets here). Otherwise null. */\n  readonly timeZone: string | null;\n  /** For 'date': the precision the values were written in ('2026-02' is a month); the finest one if they are mixed. Otherwise null. */\n  readonly dateUnit: 'day' | 'month' | 'year' | null;\n  /** For 'category': true when the author declared the categories ordered, so the axis may be thinned (spec L1). */\n  readonly ordered: boolean;\n}\n\n/** The caller's data behind a frame, for events and for the table's provenance. */\nexport interface RowSource {\n  /** The caller's row at a source index (materialized on demand for typed columns), or null if it is no longer retained. */\n  rowAt(sourceIndex: number): unknown;\n}\n\n/** One series of an aligned frame: a y value and a state for every x slot. */\nexport interface Series {\n  /** Stable identity: the series value (long form) or the field name (wide form). Used for colors and toggling. */\n  readonly key: string;\n  /** Name shown to the reader. */\n  readonly label: string;\n  /** The value field this series was read from, for diagnostics. */\n  readonly field: string;\n  readonly unit: string | null;\n  readonly valueScale: 'percent' | 'ratio' | null;\n  /** False when the series cannot be drawn (duplicate x, AX108). It stays in the frame so the table and summary can say so. */\n  readonly drawable: boolean;\n  /** y per slot. NaN wherever `slot` is not SLOT_VALUE. May be a view on the caller's typed column. */\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n  /** Index of the caller's row each slot came from, -1 where there is none. null means \"slot i came from row i\" (typed columns). */\n  readonly row: Int32Array | null;\n}\n\n/** One series of a point frame (scatter): its own x and y, sorted by x then y. */\nexport interface PointSeries {\n  readonly key: string;\n  readonly label: string;\n  readonly drawable: boolean;\n  readonly x: Float64Array;\n  readonly y: Float64Array;\n  readonly row: Int32Array | null;\n}\n\n/**\n * The normalized, lossless data. Immutable: an update or append produces a new frame with a higher revision.\n * Buffers may be shared between revisions; a streaming store appends into spare capacity and hands out\n * subarray views, so an append does not copy what is already there.\n */\ninterface FrameBase {\n  readonly revision: number;\n  /** Changes when the data is replaced or the encoding changes; survives append and eviction. A DatumRef is only meaningful within one epoch. */\n  readonly epoch: number;\n  readonly source: RowSource;\n}\n\nexport interface AlignedFrame extends FrameBase {\n  readonly shape: 'aligned';\n  readonly x: XColumn;\n  readonly series: readonly Series[];\n  /** Number of x slots. */\n  readonly length: number;\n  readonly xLabel: string;\n  readonly yLabel: string | null;\n}\n\nexport interface PointFrame extends FrameBase {\n  readonly shape: 'points';\n  readonly xKind: Exclude<XKind, 'category'>;\n  readonly timeZone: string | null;\n  readonly series: readonly PointSeries[];\n  readonly xLabel: string;\n  readonly yLabel: string;\n  readonly xUnit: string | null;\n  readonly yUnit: string | null;\n}\n\n/** Donut data: every category the caller gave, in the given order, before any grouping into \"Other\". */\nexport interface DonutFrame extends FrameBase {\n  readonly shape: 'donut';\n  readonly labels: readonly string[];\n  /** NaN where `slot` is not SLOT_VALUE. */\n  readonly values: Float64Array;\n  readonly slot: Uint8Array;\n  readonly row: Int32Array | null;\n  readonly valueLabel: string;\n  readonly unit: string | null;\n  readonly valueScale: 'percent' | 'ratio' | null;\n}\n\nexport type Frame = AlignedFrame | PointFrame | DonutFrame;\n\n/**\n * Join rule for lines and areas (spec F2). Two consecutive SLOT_VALUE slots i < j of one series are joined\n### 1.5 Handle and commit contract\n\n```ts\nchart.update({ title: 'Sessions' });                 // options\nchart.append([{ day: '2026-05-01', channel: 'Direct', sessions: 41210 }], { keep: 120 });   // rows\nchart.zoom(['2026-03-01', '2026-03-31']);            // view\nconst off = chart.on('hover', point => { … });\nchart.diagnostics;                                   // current, as soon as any call returns\nchart.destroy();\n```\n\nFinding D3: the ten libraries have seven update idioms. Axylo has three methods, one per kind of change, with one contract.\n\n| Rule | Detail |\n|---|---|\n| Order | Calls are applied in the order made. `update({ data })` followed by `append` appends to the new data. |\n| Two phases | Each call validates and normalizes synchronously: diagnostics are current when it returns, and a `strict` chart throws from that call. Drawing is deferred to the next animation frame, and calls made before that frame are drawn once. |\n| Atomic switch | Marks, labels, hit testing and the accessibility layer move to a new data revision together. No frame mixes two revisions. |\n| Patches | A key present in an `update` replaces the old value whole; a key set to `undefined` returns to its default; absent keys stay. No deep merging. |\n| Rejected changes | A call that throws under `strict` leaves the chart on its last valid state. |\n| Streaming | `keep` is the number of distinct x values retained. Rows before the last x are accepted through the slower full update and raise AX151. While zoomed to the latest edge the view follows new data; zoomed elsewhere, it stays put. Paused charts buffer (I6). Keyboard focus stays on its datum until that datum leaves the window (A7). |\n| Teardown | `destroy()` cancels the pending frame, disconnects observers and listeners, and makes later calls no-ops. |\n\n### 1.6 Diagnostics\n## 2. Architecture\n\n### 2.1 Pipeline\n\n```\noptions ─► normalize ─► frame ──┬─► view model ─► layout ─► scene ─► mark renderer\n            │ validate   (authoritative) │   scales, visible range         text renderer (DOM)\n            ▼ diagnostics                ├─► lookup: exact values by x, by point, by ordinal\n                                         ├─► summary and table\n                                         └─► focus model\n```\n\nThe **frame** is the normalized, lossless data: typed columns, a validity bitmap, dictionary-encoded categories, source-row indexes and a revision number. It is the only source for exact values. The table, the summary, keyboard navigation, tooltips and events read the frame. The **scene** is geometry for drawing and may be simplified (F5); nothing reads values back from it. The first draft derived accessibility from the scene, and two reviewers showed that a simplified drawing cannot return the samples it dropped.\n\n| Stage | Output | Notes |\n|---|---|---|\n| normalize | Frame, diagnostics | The only place raw input is read. Never coerces silently. |\n| view model | Scales, visible index ranges, series visibility | Domain rules implement F1 and F7. |\n| lookup | Nearest-x by binary search; nearest-point by a grid index (scatter) | Works on the frame within the visible range; cost bounded independently of the drawing. |\n| layout | Plot rectangle, tick sets, label boxes, legend and control placement | Implements L1, L3, L8. Takes a text-measurement interface as input. |\n| scene | Flat list of primitives (`path`, `rect`, `arc`, `rule`, `text`) | Plain data; testable in Node with injected text metrics. |\n| renderers | Marks; DOM text; accessibility DOM | See 2.3. |\n\n### 2.2 Invalidation\n\nStages are cached, and the cache keys are explicit. Caching on object identity alone, as the first draft said, would miss font loads, pixel-ratio changes and in-place mutation.\n\n| Stage | Reruns when |\n|---|---|\n| normalize | Data revision or field encoding changes. `append` extends the frame without renormalizing earlier rows. |\n| view model | Frame revision, zoom, series visibility, author domains. |\n| layout | View model; container size; resolved font and text spacing; `document.fonts` finishing a load; locale; any label text. A data-only update reruns layout when the tick labels would change, and skips it otherwise. |\n| scene | Layout or view model. |\n| mark raster | Scene; device pixel ratio; resolved colors (L4's triggers). |\n\nText is measured with the page's computed font, letter spacing and word spacing applied to the measuring context, and layout reruns when fonts finish loading. The measurement interface is a parameter, so Node tests inject fixed metrics and browser tests use the real one.\n\n### 2.3 Rendering\n### M6. Updates and scale (ceiling: 10 days)\n\n- `update`, `append` and `zoom` under the full commit contract; pause; simplified drawing complete; zoom by drag, buttons, keyboard and opt-in touch.\n\nOutcomes:\n- Sequence tests from DX5.\n- F5's assertions on kept samples, including the adversarial same-column cases.\n- A value near row 900,000 of 1,000,000 that the drawing dropped is reachable by keyboard, tooltip and table.\n- Budgets P1–P5 and P7 measured with the Phase 3 method, recalibrated once if M1's provisional values were wrong, then frozen with a written reason for each.\n\nExamples: \"Live metrics\", \"A million points\". Docs: Updating, Large data, Zoom.\n\n### M7. Distribution and documentation (ceiling: 8 days)\n### 3.5 Diagnostic registry\n\nLevel decides delivery. **Error**: the chart or a series cannot be drawn; the chart shows its error state. **Warning**: something is not drawn as given; the reader sees the note in F12. **Hint**: advice for the author. Errors and warnings print once per code per page in every build; hints print in development builds only. `strict: true` throws on errors and warnings found while validating a create, `update` or `append` call, synchronously from that call. A diagnostic that can only arise later (a contrast check after the page's CSS changes, a custom formatter that throws when a table page is built, a label that stops fitting after a resize) is reported when it is found and is never thrown. Every diagnostic names the chart; those about data name the field and the first row indexes in the caller's own data.\n\n| Code | Level | Condition | What is drawn |\n|---|---|---|---|\n| AX100 | Error | Typed columns have different lengths | Error state; the message names the columns and their lengths |\n| AX101 | Error | A named field is not a key of any row | Error state; the message lists the keys that exist and the closest match |\n| AX102 | Warning | A field is absent (`undefined`) in some rows | Gaps |\n| AX103 | Warning | A value is `NaN` or infinite | Gap |\n| AX104 | Hint | Every non-missing value of a value field is a plain decimal string (`'40'`, `'-1.5'`) | Parsed and drawn; the message suggests `parse: 'number'`. An empty string counts as missing |\n| AX105 | Hint | Steps are absent on a regular time, date, wall-clock or number axis | Gaps. When a series would need more absent steps than twice its observations (and more than 1,000), it is treated as irregular instead: no gaps are created and the hint says so |\n| AX106 | Warning | A value field mixes numbers with strings, or holds strings that are not plain decimals (`'1,234'`, `'n/a'`) | The strings are not drawn |\n| AX107 | Warning | A date or time cannot be parsed | That row is not drawn |\n| AX108 | Error | Duplicate x within a series, or duplicate donut labels | That series, or the donut, is not drawn |\n| AX109 | Hint | Numbers on an axis declared `time` look like seconds, or a numeric x looks like epoch milliseconds without `type: 'time'` | As declared |\n| AX110 | Warning | An author domain on bar or area excluded zero | Domain widened to zero |\n| AX111 | Hint | Instants look like calendar dates | As instants, zone shown |\n| AX112 | Hint | Date-time strings have no offset | As written |\n| AX120 | Error | Negative donut value | Error state |\n| AX121 | Warning | More than eight donut slices | Seven largest plus \"Other (n)\" |\n| AX130 | Warning | More than eight series | All series, with dash or marker differences |\n| AX140 | Warning | No `title` and no `labelledBy` | Generated name |\n| AX141 | Warning | Palette below 3:1 on the resolved background | As themed |\n| AX142 | Hint | Plot too small to draw | Summary and table control |\n| AX143 | Hint | Labels hidden after every remedy | Note shown to the reader |\n| AX150 | Warning | Unknown option key | Ignored; the message suggests the closest known key |\n| AX151 | Warning | `append` rows out of order | Accepted through the slower full update |\n| AX131 | Hint | A compact chart has more than one series | Drawn, with dash differences |\n| AX132 | Hint | More bars than pixels along the category axis | Drawn; the message suggests aggregating |\n| AX133 | Hint | A scatter chart has more than 50,000 points | Drawn; the message says drawing may be slow |\n| AX134 | Error | Series × x positions exceeds 20,000,000 (long rows with many series and little shared x) | Error state; the message gives both counts and suggests fewer series or a scatter chart |\n| AX152 | Warning | `timeZone` is not a zone the browser knows | The viewer's zone is used |\n| AX160 | Warning | A custom formatter threw | The default format is used for that value |\n| AX199 | Error | Axylo itself failed while building the chart | Error state with a generic message; the error is passed to `onDiagnostic` and printed |\n\nExpected results for the Phase 1 fixtures: the combined `dirty` fixture (`[10, 20, null, NaN, '40', undefined, 70]`) yields AX102, AX103 and AX106 once each, draws Mon–Tue as a segment and Sun as a point, and shows the F12 note. `dirty-string` (one `'40'` among numbers) yields AX106. A column made only of numeric strings yields AX104 and is drawn in full. `dirty-null` yields nothing.\n\nThe split between AX104 and AX106 answers a reviewer's objection that common back ends return counts as strings (Postgres `bigint` and `numeric`, BigQuery): a whole column of plain decimal strings is unambiguous and is parsed; a stray string among numbers is a bug and is not.\n\n### 3.6 Type matrix\n## 4. Acceptance criteria: the developer's experience\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| DX1 | The first chart takes ten lines or fewer, including import, by npm, by script tag and in React. No required option besides data and fields. | Three CI tests that render the documented snippet from the packed distribution | D1 |\n| DX2 | One logical table, three ways to pass it: long rows, wide rows, typed columns. The three forms of each fixture produce the same normalized data and the same diagnostics, with row indexes in the caller's own form. | Equivalence tests | D2 |\n| DX3 | With typed rows, a misspelled field, a text field on a value axis, wide `y` combined with `series`, and an option that does not apply to the chart type all fail to compile. At run time, for untyped rows, the same mistakes raise AX101, AX106 and AX150. | [docs/api/examples.ts](api/examples.ts) compiles and each marked mistake fails (already checked with TypeScript 7.0.2); runtime tests per code | D5 |\n| DX4 | Diagnostics follow the registry in section 3.5: stable code, chart name, field and rows where they apply, the fix, and a documentation page per code. | Message snapshots; link checker | R5, D5 |\n| DX5 | Three methods change a chart: `update` changes options, `append` adds rows, `zoom` sets the view. They apply in call order. Validation and diagnostics are synchronous; drawing is deferred to the next frame; marks, labels, hit testing and the accessibility layer always switch to a new state together. `destroy()` releases everything and cancels pending work. No `resize()` exists. | Sequence tests: replace then append then zoom in one turn; a rejected `strict` update leaves the last valid chart; destroy before the frame; 1,000 create–destroy cycles show no heap growth trend (P7) | D3, R16 |\n| DX6 | Colors, font and spacing are CSS custom properties with documented names; the chart inherits `font-family` and `color`. `colors` pins a color to a series name so the same series has the same color on every chart. There is no theme object and no positional palette option. | Theming tests, including a 24-tile page where series subsets differ | R10 |\n| DX7 | Zero runtime dependencies (reconsidered only with a measured comparison). Size targets, provisional until M1 measures a working slice: 40 KiB gzipped for everything, 25 KiB for a page that uses only `line`, 2 KiB for the React adapter, CSS included. | size-limit in CI on the packed distribution | D4 |\n| DX8 | Importing in Node without a DOM does not throw, and `validate()` runs there. Works under React StrictMode, including setup, cleanup and setup again. Works under a Content Security Policy without `unsafe-inline` or `unsafe-eval`, served with real headers. Labels and formatter output are inserted as text, never as HTML. A target that matches no element throws an error that names the selector. | CI tests | D1 |\n| DX9 | Semantic versioning. A deprecated API keeps working for at least one minor release and six months. At most one major version a year. The previous release's documented examples still compile and run against each release candidate. | Release policy; API report diff; upgrade test | D6 |\n| DX10 | Every runnable example in the documentation is compiled and rendered in CI from the packed distribution. | Docs build | D1 |\n| DX11 | MIT license for everything, including zoom and accessibility. Third-party notices are verified at release. | Repository; release check | D7 |\n| DX12 | A coding agent gets the first chart right. Given fixed prompts and trap fixtures (UTC-midnight ISO dates, numeric strings, unsorted rows, missing days, a misspelled field), an agent with only the published docs produces a chart with no error diagnostics that passes the reader criteria. Recorded as agent rehearsal, not as user evidence. | Scripted rehearsal at each release | D1, 1.2 |\n\n## 5. Performance budgets\n\nThese numbers are provisional. They are design targets taken from Phase 1's order-of-magnitude measurements, and they become release gates only after the benchmark harness built in M0 has measured a working Axylo slice in M1 and the limits have been recalibrated and frozen (plan, M1 and M6). Each budget names its workload, metric and statistic so that two people measuring the same build get the same verdict.\n\n| ID | Workload | Metric | Statistic | Provisional limit | Phase 1 reference |\n|---|---|---|---|---|---|\n| P1 | `trend` (3×120), default options, reference desktop | Main-thread task time from the call until the chart is complete | Median of 20 runs | 10 ms | Not comparable across libraries below about 35 ms with the Phase 1 method |\n| P2 | One series, 100,000 and 1,000,000 points, typed columns | Same | Median of 20 | 60 ms and 250 ms | See 01, section 5.3: uPlot and tuned Chart.js are the fastest measured |\n| P3 | 600-point window, one appended point per display frame at 60 Hz, driven by an independent clock | Main-thread task time per update (per run: task time in the window divided by the number of updates); and frames later than 25 ms | Median over runs; count per 300 frames | 2 ms; 0 | See 01, section 5.3 |\n| P4 | Pointer moved across a 100,000-point chart | Time from input to the frame showing the matching readout | 95th percentile | One frame (16.7 ms at 60 Hz) | Not measured in Phase 1 |\n| P5 | 24 `trend` charts created on one page, each tile 340 × 200 px | Total main-thread task time | Median of 20 | 200 ms | Not measured in Phase 1 |\n| P6 | Download | Minified and gzipped bytes, CSS included | Exact | DX7 | 01, section 1.4 |\n| P8 | 40 compact charts created on one page, each 160 × 48 px with one series | Total main-thread task time | Median of 20 | 80 ms | Not measured in Phase 1 |\n| P7 | Memory | Bytes owned by Axylo beyond the caller's columns for 1,000,000 points; heap trend over 1,000 create–destroy cycles | Measured after forced collection | At most 1× the size of the caller's two columns; no upward slope | Not measured in Phase 1 |\n\nThree rules hold whatever the numbers become:\n\n1. Budgets apply to default options. Finding D8 showed libraries that are fast only for authors who know which options to set.\n2. Budgets are absolute, on named hardware profiles. Comparison libraries, uPlot above all, are measured in the same runs and published beside Axylo, but a ratio to another library is not a gate: it would reward leaving out work that library does not do.\n3. The accessibility layer is on in every measured configuration.\n\n<!-- Reviewer: Codex gpt-6.2-sol, effort max (observed in the session rollout, thread 01a1ecf0-d286-7880-bb18-f201e69b367f), read-only, cross-provider. Reviewed commit 4809516. -->\n\n**Four defects block release at `4809516`.** A superseded frame can change the figure, Resume can remove the source rows of marks still on screen, a renderer exception can leave layers on different revisions, and a stream with `keep` can grow without bound when frames stop running.\n\n**Ran** means reproduced in Node with the manual frame host unless otherwise stated. **Reasoned** means traced through the source or tests.\n\n## Blocking\n\n1. **B · A superseded frame writes to the figure. Ran.** Draw data at x `[0,2]`, then update the title and data to `Intermediate` and `[5,7]`. Have a readout formatter call a second update for `[10,12]`. After one frame, the figure says `Intermediate` and the prepared controls use `[5,7]`, but the marks and committed lookup still use `[0,2]`. A formatter that calls `destroy()` also lets `figure.update()` run after host disposal. The lazy `reader.summary` runs author code inside the call to `figure.update()`, past the generation check. Plan §1.5 and DX5 require a single revision across the layers. Materialize formatter-dependent output before writing it, then check the generation before each host mutation that follows author code. [controller.ts](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:935)\n\n2. **B · Resume releases rows that the displayed lookup still needs. Ran on all five chart types.** Display a store-backed line window `[2,3]`, pause, and append `4` with `keep: 1`. Hovering `2` while paused returns its original row. Resume and hover again before the frame runs. The same mark and source index now return `row: null`. I also reproduced the loss when an append was pending at the time of Pause. The controller freezes `accepted.frame`, which can differ from the displayed frame, and discards the frozen rows in `accept()` before the replacement draws. This breaks plan §1.5, DX2 and DX5. Keep row ownership with the displayed snapshot until the replacement completes, including across Pause, Resume and re-encoding. [Freezing rows](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:550) · [Accepting the replacement](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:403)\n\n3. **B · An actual renderer exception can leave the marks, lookup and error message out of sync. Ran.** Draw `[0,2]`, then make the host text renderer throw and update to `[5,7]`. The new marks draw, the old interaction model remains, and the error message never appears. `showInternal()` retries the broken text renderer before clearing interaction or updating the figure. With a persistently throwing mark renderer, the error message appears over the old marks because clearing them calls the same renderer. Both recovered after restoring the host method and updating again. L7 and DX5 require a complete error revision. Disable interaction first, isolate each cleanup step, and let the host hide failed render surfaces independently of their draw methods. [Frame publication](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:1055) · [Error fallback](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:1117)\n\n4. **B · `keep` fails to bound a stream without successful frames. Ran.** Create a line with three rows and leave its first frame queued. After 1,000 one-row appends with `keep: 3`, the store reports **1,003 retained rows**. After 100 appends with `keep: 2` and a forced reader failure on every frame, it reports **102**. Retirement depends on the successful frame path. A zero-size flush has another problem. It commits new controls and retires the old source with the mark draw count unchanged. Plan §1.5 and P7 require bounded retention with correct provenance. Pin the displayed snapshot, release superseded pending revisions as calls arrive, and explicitly clear the display if an unmeasured or failed frame is going to release its source. [Draw and retirement](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:1034) · [Failed frames](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:1107)\n\n## Major\n\n5. **M · Re-encoding exposes paused arrivals, and a failed Resume loses the pending frame. Ran.** Pause a line displaying `[1,2,3]`, append `4` with `keep: 3`, then update `y` to another valid field. The chart shows `[2,3,4]` with Pause still active. In a second run, forcing the view stage to throw on Resume consumed the held frame. Removing the fault and making a valid title update recovered the chart without the buffered row. I6 and plan §1.5 require accepted arrivals to stay buffered until Resume. Re-encode the displayed and pending windows separately, and clear the pending frame only after its replacement is accepted. [Re-encoding](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:479) · [Resume](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:640)\n\n6. **M · Append validation writes to the wrong state. Ran.** A first strict append containing `NaN` throws AX103 but queues a frame and flips the chart’s streaming controls on. On a paused chart, adding series nine or donut slice nine leaves AX130 or AX121 out of `diagnostics` until Resume. `update({strict:true})` succeeds in between. In the other direction, a negative donut value buffered while paused adds AX120 immediately, then an unrelated resize applies that error to the previously healthy displayed ring. Plan §1.5, I6 and §3.5 require synchronous validation, rollback on strict rejection, and disclosure for the data being drawn. Set the streaming flag on acceptance and keep complete validation findings for the pending snapshot and display effects for the displayed snapshot. [Append transaction](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:523) · [Display state](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:721)\n\n7. **M · Re-entrant calls drop diagnostic and event deliveries. Ran.** On a strict chart, submit an update that raises AX103 and AX106. If the first `onDiagnostic` call makes a valid title update, the exception contains both codes but the callback and console receive only AX103. With two `zoom` subscribers, have the first respond to `[0.5,2]` by calling `zoom([1,2])`. The second subscriber receives only `[1,2]`. A title update from the first hover subscriber also suppresses the second. This breaks call-order delivery and §3.5 reporting. Drain each delivery snapshot in order, queue nested notifications behind it, and stop on destruction. Keep nested calls’ validation and state changes synchronous. [Diagnostic delivery](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:329) · [Event delivery](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:1174)\n\n8. **M · A valid append cannot clear a stale missing-field error. Ran on all five types.** Create a non-strict chart with one row missing the entire value field. Append a row with that field and `keep: 1`. AX101 and the error message remain. Scatter and donut already have a usable retained frame at that point. Line, area and bar still have an empty frame. The append carries the original option validation forward, and the aligned store can open with the invalid encoding. F3, DX5 and §3.5 require diagnostics for the current data. Revalidate field presence when the retained logical table changes, and let a now-valid table rebuild the invalid frame. [Static diagnostics retention](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:474) · [Opening and appending to the store](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:515)\n\n9. **M · Late setup failure and retained unsubscribe functions leave resources alive. Reasoned for browser setup. Ran for the watcher and unsubscribe paths.** If `ResizeObserver.observe()` throws after the controller is created, `createChart()` releases the host but skips `controller.handle.destroy()`. The first frame is already queued. In Node, a fake window throwing on the second `matchMedia()` call left the first listener registered. Separately, keeping one unsubscribe function after `destroy()` kept another subscriber’s captured object alive through forced collection. Releasing that function made the object collectible. DX5 and P7 require teardown of pending work and subscriptions. Destroy the controller on late setup failure, register watcher cleanup as each subscription succeeds, and clear or invalidate individual subscription records on destruction. [Browser setup](/home/canarit/projects/axylo/packages/axylo/src/core/chart.ts:109) · [Late catch](/home/canarit/projects/axylo/packages/axylo/src/core/chart.ts:193) · [Unsubscribe closure](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:1290)\n\n10. **M · Two charts on one target overwrite each other’s colors. Reasoned.** Create two SVG charts on the same element and pin their first series to red and blue respectively. Both bind slot one through the same custom property on the target, so the second chart changes the first chart’s paint. Destroying either chart can remove or restore properties still in use by the other. The cleanup also records only the presence of a pre-existing `data-axylo-scheme`, so it cannot restore its value after a scheme change. This breaks DX6 and DX5. Scope the chart-written theme properties and scheme attribute to the chart’s own figure. [Property cleanup](/home/canarit/projects/axylo/packages/axylo/src/core/chart.ts:77) · [Theme target](/home/canarit/projects/axylo/packages/axylo/src/core/chart.ts:190)\n\n11. **M · Ordinary stream operations copy, scan or retain old data. Ran.** A subsequent one-row append on a 50,001-row line replaced both numeric buffers despite spare capacity. A title-only update allocated a 50,001-entry row index synchronously with the normalization counter unchanged. The reader also rescans unchanged statistics when rebuilding the caption. In a forced-GC probe, the original caller columns survived both `keep: 2` and explicit data replacement. They became collectible when a locale change rebuilt the formatter cache. Plan §2.2, the frame ownership contract and AGENTS.md require incremental appends and cheap presentation changes. Prepare append deltas over shared storage, resolve presentation changes without walking retained rows, cache statistics by view, and keep cached formatter callbacks free of table-bearing state. [Presentation update](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:492) · [Append preparation](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:535) · [Buffer fork](/home/canarit/projects/axylo/packages/axylo/src/data/store-buffers.ts:52) · [Formatter closure](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:762)\n\n12. **M · Resubmitting edited options can leave the old output in place. Ran.** Change a reference’s position, a pinned color, a message and an axis label on objects previously supplied to the chart. Pass those objects back in `update()`. The reference, theme, message and axis title all stay stale. The previous options and cache keys hold the same mutable objects. With a fresh object, a label-only or unit-only edit instead reruns normalization and view construction. Plan §1.5 and §2.2 require present keys to take effect and presentation changes to invalidate the right stages. Snapshot small option inputs independently of borrowed data, then update field metadata without rebuilding the value columns. [Patch storage](/home/canarit/projects/axylo/packages/axylo/src/core/options.ts:19) · [Encoding comparison](/home/canarit/projects/axylo/packages/axylo/src/core/stages.ts:47) · [Theme key](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:831)\n\n13. **M · AX160 can disappear, duplicate or survive its cause. Ran.** A readout formatter that always throws reports AX160 on the first frame. Replacing the data with the same formatter clears the diagnostic and reader note even though fallback formatting continues. An invalid `Intl` option combination reports nothing because formatter construction raises AX160 immediately before the controller clears the bucket. Using the same throwing function for ticks and readouts produces two identical entries. Removing both formatters while switching to an error state leaves the tick warning and note behind. This violates F6, F12 and §3.5. Associate findings with the active formatter and layout outputs, clear a bucket before rebuilding its producer, and retire findings from inactive outputs. [Formatter cache](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:847) · [Layout cache](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:964) · [Once-only readout reporter](/home/canarit/projects/axylo/packages/axylo/src/format/number.ts:155)\n\n14. **M · A create-stage exception bypasses AX199 delivery and breaks `validate()` parity. Ran.** Create with a row whose x getter throws during normalization. The controller shows its generic error, but `onDiagnostic` receives nothing and `chart.diagnostics` is empty, even with strict enabled. `validate()` classifies the same exception as AX150. There is also a parity difference on all five types with `palete: undefined`: `validate()` reports AX150, while create discards the key during patch processing. Plan §1.5, §1.6 and spec §3.5 require shared call validation and error delivery. Use one preprocessing and classification path, and retain initial failure diagnostics independently of an accepted frame. Apply strict handling according to the phase where the finding arose. [Controller error handling](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:435) · [Diagnostic getter](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:291) · [Static validation](/home/canarit/projects/axylo/packages/axylo/src/core/stages.ts:140)\n\n15. **M · Scatter drops the declared percentage scale when computing the domain. Ran.** Create a scatter with y values `20` and `63` and `y.scale: 'percent'`. The upper bound is `70`, although F7 requires `100`. Tick formatting receives the scale, but the controller’s scatter view state omits it. Pass the resolved value scale into that branch and assert the domain for both `percent` and `ratio`. [Scatter view state](/home/canarit/projects/axylo/packages/axylo/src/core/stages.ts:67) · [Scatter domain calculation](/home/canarit/projects/axylo/packages/axylo/src/view/index.ts:329)\n\n16. **M · A zoom at the latest bar or scatter datum can stop following. Ran.** For scatter at x `0` and `9`, zoom to `[5,9]` and append `12`. The window stays `[5,9]`. For continuous bars at `0,5,10`, zoom to `[5,10]` and append `15`. That window also stays put. The controller tests the niced or padded `xFull` edge rather than the newest datum. Plan §1.5 requires the live window to follow the data edge. Determine whether the window follows from the latest data position, then clamp the shifted window to the author’s bounds. [Edge detection](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:205) · [Append follow logic](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:538)\n\n17. **M · Category zoom changes the visible rows without changing the axis. Ran for line and area.** Create categories A–D and call `zoom(['B','C'])`. The view limits picking and rows to B and C, but layout still emits four ticks on a four-band projection and the controller exposes no zoom controls. This leaves the chart’s geometry inconsistent with its visible range under plan §1.5 and the spec §3.6 type matrix. Use the same ordinal window and offset for the projection, ticks, marks and lookup, and enable controls for supported category charts. [Category layout](/home/canarit/projects/axylo/packages/axylo/src/core/axes.ts:103) · [Zoom controls](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:925)\n\n18. **M · An all-missing bar window suppresses the required missing marks. Ran.** Create bars `A: null` and `B: null`. The table contains both rows, but the controller shows “No data to show” and sends an empty scene. Its readiness check requires a finite value even though the bar scene can draw missing glyphs at the baseline. F2 requires those glyphs. Treat retained missing bar slots as drawable and reserve the empty state for a window with no drawable slots. [Display classification](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:721) · [Drawable-content check](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:1368)\n\n19. **M · Environment changes can be missed or cause two draws in one frame. Ran the callback sequences. Reasoned through browser wiring.** After drawing at DPR 1, change the host to DPR 3 and signal reattachment. The committed ratio stays 1 until a separate DPR notification. Reattachment also leaves the font epoch alone, so a font load missed while detached can leave cached widths in use. Changing only the document’s `lang` has no watcher. Conversely, executing the scheduled data update and then the theme watcher’s callback produces two draws in the same frame callback batch. Plan §2.2, F5, F6 and the renderer contract require fresh environment inputs and one mark draw per animation frame. Refresh inputs on reattachment, watch language changes, and feed theme invalidation into the same frame scheduler. [Controller invalidation](/home/canarit/projects/axylo/packages/axylo/src/core/controller.ts:1211) · [Reattachment](/home/canarit/projects/axylo/packages/axylo/src/core/chart.ts:109) · [Theme watcher](/home/canarit/projects/axylo/packages/axylo/src/theme/watch.ts:11)\n\n20. **m · Several regression tests can pass when the behavior named in the test is broken. Reasoned from assertions. Ran the host accessor check.** The Node re-entrancy test receives AX140 before its `chart` variable is assigned, so its nested update never runs. The dense-line test reads indices recomputed by `__bench.describe()`, so it can pass with a broken scene. The browser crossing test checks only that the message is hidden, and the `plotRole` test supplies no role override. The browser teardown test can pass with listeners still registered because the destroyed controller suppresses their effects. The setup-failure test throws before any frame is scheduled. The stand-in’s `Object.assign` also snapshots `pending` and `layout`, so those properties cannot verify frame timing. Assert actual output and listener registration, and exercise the missing sequences directly. Within the scoped files I found no test for a stream receiving appends with **zero** frame callbacks, Resume-to-first-frame row provenance, late setup failure, or two live charts on the same target. [Controller tests](/home/canarit/projects/axylo/packages/axylo/test/core/controller.test.ts:170) · [Dense-line test](/home/canarit/projects/axylo/packages/axylo/test/core/controller.test.ts:579) · [Host accessors](/home/canarit/projects/axylo/packages/axylo/test/core/host.ts:143) · [Browser review tests](/home/canarit/projects/axylo/packages/axylo/test/browser/chart/review.browser.test.ts:175) · [Setup failure test](/home/canarit/projects/axylo/packages/axylo/test/browser/chart/review.browser.test.ts:316) · [Plot role test](/home/canarit/projects/axylo/packages/axylo/test/browser/chart/review.browser.test.ts:493) · [Teardown test](/home/canarit/projects/axylo/packages/axylo/test/browser/chart/lifecycle.browser.test.ts:285)\n\n## Verification\n\nI reviewed the created, pending-first-frame, drawn, paused, failed and destroyed states across static and streaming instances of all five types. I checked call-time validation and diagnostics separately from frame-time marks, labels and lookup. The stage probes covered data and encoding, field presentation, domains and references, chart variants and visibility, caption and controls, locale and time zone, colors, resize, fonts and DPR. I exercised all 14 stage failure hooks, plus actual throwing host render methods and author callbacks.\n\nThe review was read-only. I loaded the exact commit into memory for the Node probes and ran the core Vitest suite in the thread pool with both caches disabled. The browser tests were inspected only. Browser rendering, native observer behavior and the full P7 heap budget remain unverified. I used the donut label as its `keep` key and read §3.6 as including category zoom for line and area. The proposed fixes fit the existing fixed contracts.\n\n```text\nTest Files  8 passed (8)\n     Tests  86 passed (86)\n  Start at  05:47:13\n  Duration  528ms (transform 63%, tests 19%, import 16%, worker 1%)\n```\n\n## Areas examined and found sound\n\n- **Ordinary call order, ran.** Data replacement, append and applicable zoom before the first frame produced one draw. A subsequent explicit data replacement discarded the stream.\n- **Fresh option patches, ran.** Whole-object replacement restored omitted nested defaults, explicit `undefined` restored the top-level default, and absent keys kept their values.\n- **Static ownership, ran.** Clean, ascending `Float64Array` x and y columns were borrowed for all four Cartesian types in the tested fixtures. Donut borrowed its value column. Appending left the caller’s values unchanged.\n- **Ordinary strict rejection, ran.** A rejected strict create disposed its host before drawing. The ninth-series test preserved the previous data through a later valid append. Invalid strict zoom reported AX107 without throwing or moving the window.\n- **Attached environment and layout caches, ran.** Explicit locale and time-zone changes reached the formatter, font notifications invalidated measurements, and data replacement with unchanged tick inputs reused layout.\n- **Ordinary destruction and callback exceptions, ran.** Repeated destroy disposed once, canceled the first frame, and made later calls inert. Throwing author handlers left the chart usable.\n- **Registry coverage, reasoned.** Every §3.5 code has an emission path, and I found no emitted AX code outside the registry.","exit_code":0,"status":"completed"}}
