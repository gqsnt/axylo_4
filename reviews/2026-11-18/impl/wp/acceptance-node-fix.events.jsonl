{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/data/{values,normalize,store-unaligned}.ts packages/axylo/src/reader/table.ts && rg -n 'missingX|noData' packages/axylo/src/{data,reader,core/contracts.ts}\"","aggregated_output":"import { SLOT_ABSENT_FIELD, SLOT_INVALID, SLOT_NULL, SLOT_VALUE, type DiagnosticSink, type SlotState } from '../core/contracts';\nimport type { ResolvedValueField } from './options';\nimport { Reports } from './reports';\nimport type { Table } from './table';\n\nconst decimal = /^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$/;\nexport type ValueMode = 'empty' | 'decimal' | 'other';\nexport type ValueCounts = Record<Exclude<ValueMode, 'empty'>, number>;\n\nexport function valueMode(value: unknown, column: boolean): ValueMode {\n  if (value == null || value === '' || (column && typeof value === 'number' && Number.isNaN(value))) return 'empty';\n  return typeof value === 'string' && decimal.test(value) ? 'decimal' : 'other';\n}\n\nexport function inspectValues(table: Table, field: string, included?: (row: number) => boolean): ValueMode {\n  let mode: ValueMode = 'empty';\n  for (let i = 0; i < table.length; i++) {\n    if (included && !included(i)) continue;\n    const next = valueMode(table.read(i, field), table.isColumnRow(i));\n    if (next === 'other') return next;\n    if (next === 'decimal') mode = next;\n  }\n  return mode;\n}\n\nexport interface Values {\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n}\n\nexport function readValues(\n  table: Table,\n  field: ResolvedValueField,\n  sink: DiagnosticSink,\n  impute: boolean,\n  startRow = 0,\n  mode?: ValueMode,\n  included?: (row: number) => boolean,\n  outcome?: string,\n  counts?: ValueCounts,\n): Values {\n  const column = table.columns?.[field.field];\n  const borrowed = column instanceof Float64Array || column instanceof Float32Array;\n  const zero = impute && field.missing === 'zero';\n  const slot = new Uint8Array(table.length);\n  let y = borrowed ? column : new Float64Array(table.length);\n  let i = 0;\n  if (borrowed && !included) {\n    // Values and typed NaNs can stay in the caller's storage without generic row validation.\n    let missing = 0;\n    for (; i < table.length; i++) {\n      const value = column[i]!;\n      if (Number.isFinite(value)) continue;\n      if (zero || !Number.isNaN(value)) break;\n      slot[i] = SLOT_NULL;\n      missing++;\n    }\n    if (counts) counts.other += i - missing;\n    if (i === table.length) return { y, slot };\n  }\n  const reports = new Reports(field.field, sink);\n  mode ??= borrowed ? 'other' : inspectValues(table, field.field, included);\n\n  for (; i < table.length; i++) {\n    if (included && !included(i)) continue;\n    const raw = column === undefined ? table.read(i, field.field) : column[i];\n    if (counts) {\n      const kind = valueMode(raw, table.isColumnRow(i));\n      if (kind !== 'empty') counts[kind]++;\n    }\n    let value = NaN;\n    let state: SlotState = SLOT_VALUE;\n    if (typeof raw === 'number') {\n      if (Number.isFinite(raw)) value = raw;\n      else if (Number.isNaN(raw) && (column || table.isColumnRow(i))) state = SLOT_NULL;\n      else {\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n      }\n    } else if (raw === undefined) {\n      state = SLOT_ABSENT_FIELD;\n      reports.add('AX102', zero ? 'changed' : 'omitted', startRow + table.rowIndex(i), undefined, undefined,\n        { outcome: zero ? undefined : outcome });\n    } else if (raw === null || raw === '') {\n      state = SLOT_NULL;\n    } else if (mode === 'decimal') {\n      value = Number(raw);\n      if (!Number.isFinite(value)) {\n        value = NaN;\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n      }\n      if (field.parse !== 'number') reports.add('AX104', 'none', startRow + table.rowIndex(i));\n    } else {\n      state = SLOT_INVALID;\n      reports.add('AX106', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n    }\n    if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) value = 0;\n    if (y === column && !Object.is(y[i], value)) {\n      // Infinity and explicit zero imputation cannot be represented by an unchanged borrowed view.\n      y = y.slice();\n    }\n    if (y !== column) y[i] = value;\n    slot[i] = state;\n  }\n\n  reports.flush(sink);\n  return { y, slot };\n}\nimport {\n  SLOT_ABSENT_FIELD, SLOT_GAP, SLOT_NO_ROW, SLOT_NULL, SLOT_VALUE,\n  type AlignedFrame, type DiagnosticSink, type DonutFrame, type Environment, type Frame, type PointFrame,\n  type RowSource, type Series, type XColumn,\n} from '../core/contracts';\nimport { report, type DiagnosticDetails } from '../diagnostics';\nimport type { AlignedChartType, ChartType, ResolvedOptions, ResolvedValueField } from './options';\nimport { Reports } from './reports';\nimport { calendarIntervals, inferGaps, snapGap } from './steps';\nimport { recordDiagnostics, StreamDiagnostics, type DiagnosticTrace } from './store-diagnostics';\nimport type { Table } from './table';\nimport { readValues, type ValueCounts, type Values } from './values';\nimport { dateUnitOf, inferKind, nameOf, positionName, XParser, type DateUnit } from './x';\n\nexport type DataEnvironment = Pick<Environment, 'timeZone'>;\nexport interface FrameVersion { readonly epoch: number; readonly revision: number }\n\nfunction base(source: RowSource, version: FrameVersion) {\n  return { epoch: version.epoch, revision: version.revision, source };\n}\n\nfunction sourceRows(table: Table): Int32Array {\n  const rows = new Int32Array(table.length);\n  for (let i = 0; i < rows.length; i++) rows[i] = table.rowIndex(i);\n  return rows;\n}\n\nexport interface XData {\n  readonly parser: XParser;\n  readonly positions: Float64Array;\n  readonly order: Int32Array | null;\n  readonly dateUnits: Record<DateUnit, number> | null;\n}\n\nexport function readX(type: ChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, categories?: readonly string[]): XData {\n  const { x, table } = options;\n  const kind = x.type ?? inferKind(table, x.field, options.series) ?? (categories ? 'category' : 'number');\n  const parser = new XParser(x, kind, env, type === 'scatter', categories);\n  const reports = new Reports(x.field, sink);\n  const dateUnits = kind === 'date' ? { day: 0, month: 0, year: 0 } : null;\n  const input = table.columns?.[x.field];\n  let positions = input instanceof Float64Array && (kind === 'number' || kind === 'time')\n    ? input : new Float64Array(table.length);\n  let ascending = true;\n  let last = -Infinity;\n  let i = 0;\n  if (options.series === null && input instanceof Float64Array && kind === 'number') {\n    // Skip parsing the strictly ascending numeric prefix, stopping before any row that can report a hint.\n    const inferred = x.type === null;\n    for (; i < table.length; i++) {\n      const value = input[i]!;\n      if (!(value > last && value < Infinity) || inferred && Math.abs(value) >= 1e11 && Math.abs(value) < 1e14) break;\n      last = value;\n    }\n  }\n  let valid = i;\n  for (; i < table.length; i++) {\n    const usableSeries = options.series === null || nameOf(table.read(i, options.series)) !== null;\n    const raw = usableSeries ? input === undefined ? table.read(i, x.field) : input[i] : undefined;\n    const value = usableSeries && !(Number.isNaN(raw) && table.isColumnRow(i))\n      ? parser.read(raw, table.rowIndex(i), reports, options.values.length) : NaN;\n    if (positions === input && !Object.is(positions[i], value)) positions = positions.slice();\n    if (positions !== input) positions[i] = value;\n    if (!Number.isFinite(value)) {\n      ascending = false;\n      continue;\n    }\n    if (!(value > last)) ascending = false;\n    if (dateUnits) dateUnits[dateUnitOf(raw)]++;\n    last = value;\n    valid++;\n  }\n  reports.flush(sink);\n  if (ascending) return { parser, positions, order: null, dateUnits };\n\n  const order = new Int32Array(valid);\n  let next = 0;\n  for (let i = 0; i < positions.length; i++) if (Number.isFinite(positions[i])) order[next++] = i;\n  order.sort((a, b) => positions[a]! - positions[b]!);\n  return { parser, positions, order, dateUnits };\n}\n\nexport function reportCalendarDates(x: XData, table: Table, sink: DiagnosticSink): void {\n  if (x.parser.kind !== 'time') return;\n  const length = x.order?.length ?? x.positions.length;\n  if (length < 2) return;\n  const first = x.positions[x.order?.[0] ?? 0]!;\n  let last = first;\n  const zone = x.parser.timeZone ?? 'UTC';\n  let matches = 3;\n  for (let i = 1; i < length; i++) {\n    const position = x.positions[x.order?.[i] ?? i]!;\n    if (position === last) continue;\n    matches &= calendarIntervals(last, position, zone);\n    if (!matches) return;\n    last = position;\n  }\n  if (last === first) return;\n  const rows: number[] = [];\n  for (let i = 0; i < x.positions.length && rows.length < 10; i++) {\n    if (Number.isFinite(x.positions[i])) rows.push(table.rowIndex(i));\n  }\n  report(sink, 'AX111', 'none', { field: x.parser.field.field, count: length, rows });\n}\n\ninterface Group {\n  readonly key: string;\n  readonly label: string;\n  readonly value: ResolvedValueField;\n  readonly order: Int32Array | null;\n}\n\nfunction groups(options: ResolvedOptions, x: XData, sink: DiagnosticSink): Group[] {\n  const { table, series } = options;\n  if (series === null) {\n    return options.values.map(value => ({\n      key: value.field, label: value.label, value, order: x.order,\n    }));\n  }\n\n  const indexes = new Map<string, number>();\n  const counts: number[] = [];\n  const membership = new Int32Array(table.length).fill(-1);\n  const reports = new Reports(series, sink);\n  for (let i = 0; i < table.length; i++) {\n    const raw = table.read(i, series);\n    const name = nameOf(raw);\n    if (name === null) {\n      if (Number.isNaN(raw) && table.isColumnRow(i)) continue;\n      if (raw === undefined) reports.add('AX102', 'omitted', table.rowIndex(i), undefined, undefined, { outcome: 'The affected row is not drawn.' });\n      else reports.add('AX107', 'omitted', table.rowIndex(i), raw, 'Supply a name for the series in each row.');\n      continue;\n    }\n    if (!Number.isFinite(x.positions[i])) continue;\n    let index = indexes.get(name);\n    if (index === undefined) {\n      index = indexes.size;\n      indexes.set(name, index);\n      counts.push(0);\n    }\n    membership[i] = index;\n    counts[index] = counts[index]! + 1;\n  }\n  reports.flush(sink);\n\n  const orders = counts.map(count => new Int32Array(count));\n  counts.fill(0);\n  for (let i = 0, n = x.order?.length ?? table.length; i < n; i++) {\n    const row = x.order?.[i] ?? i;\n    const index = membership[row]!;\n    if (index < 0) continue;\n    orders[index]![counts[index]!] = row;\n    counts[index] = counts[index]! + 1;\n  }\n  const value = options.values[0]!;\n  return Array.from(indexes, ([key, index]) => ({ key, label: key, value, order: orders[index]! }));\n}\n\ninterface AlignedGroup {\n  readonly group: Group;\n  readonly order: Int32Array | null;\n  readonly gaps: Float64Array | null;\n  readonly drawable: boolean;\n  readonly sparse?: number;\n}\n\nfunction alignGroup(group: Group, x: XData, axis: XColumn, field: string, table: Table, sink: DiagnosticSink, grid?: AlignedGroup): AlignedGroup {\n  const { positions } = x;\n  let order = group.order;\n  let drawable = true;\n  if (order) {\n    const duplicates = new Reports(field, sink);\n    let distinct = 0;\n    let kept = order;\n    let previous = -Infinity;\n    for (let i = 0; i < order.length; i++) {\n      const row = order[i]!;\n      const position = positions[row]!;\n      if (position === previous) {\n        duplicates.add('AX108', 'series-disabled', table.rowIndex(row), undefined, undefined, {\n          series: group.label, position: positionName(axis, position),\n        });\n        if (drawable) kept = order.slice();\n        drawable = false;\n      } else {\n        kept[distinct++] = row;\n        previous = position;\n      }\n    }\n    duplicates.flush(sink);\n    order = kept.subarray(0, distinct);\n  }\n  if (grid) return { group, order, drawable, gaps: grid.gaps, sparse: grid.sparse };\n  let sparse: number | undefined;\n  const gaps = inferGaps(axis, order?.length ?? positions.length, i => positions[order?.[i] ?? i]!,\n    (gap, a, b, step) => snapGap(gap, a, b, step, x.order?.length ?? positions.length, i => positions[x.order?.[i] ?? i]!),\n    count => { sparse = count; });\n  return { group, order, gaps, drawable, sparse };\n}\n\nfunction combinePositions(x: XData, groups: readonly AlignedGroup[]): Float64Array {\n  const gapSets = new Set(groups.flatMap(group => group.gaps ? [group.gaps] : []));\n  let gapCount = 0;\n  for (const gaps of gapSets) gapCount += gaps.length;\n  if (x.order === null && gapCount === 0) return x.positions;\n  const observed = x.order?.length ?? x.positions.length;\n  const positions = new Float64Array(observed + gapCount);\n  if (x.order) {\n    for (let i = 0; i < observed; i++) positions[i] = x.positions[x.order[i]!]!;\n  } else {\n    positions.set(x.positions);\n  }\n  let next = observed;\n  for (const gaps of gapSets) {\n    positions.set(gaps, next);\n    next += gaps.length;\n  }\n  if (gapCount) positions.sort();\n  let distinct = 0;\n  let last = -Infinity;\n  for (let i = 0; i < positions.length; i++) {\n    const position = positions[i]!;\n    if (position > last) {\n      positions[distinct++] = position;\n      last = position;\n    }\n  }\n  return positions.subarray(0, distinct);\n}\n\nexport function seriesDescription(key: string, label: string, value: ResolvedValueField) {\n  return { key, label, field: value.field, unit: value.unit, valueScale: value.scale };\n}\n\nexport function reportGaps(\n  sink: DiagnosticSink, field: string, changed: boolean, gaps: Float64Array | null,\n  axis?: XColumn, name?: string, sparse?: number, seriesKey?: string,\n): void {\n  if (!gaps?.length && !sparse) return;\n  const details: DiagnosticDetails = {\n    field, count: sparse ?? gaps?.length, series: name === undefined ? undefined : [name],\n    sparseSeries: sparse && name !== undefined ? [name] : undefined,\n    examples: gaps ? Array.from(gaps.subarray(0, 10), position => axis ? positionName(axis, position) : String(position)) : undefined,\n    zeroSeries: changed && !sparse ? name === undefined ? [] : [name] : undefined,\n  };\n  const trace = sink as DiagnosticTrace;\n  if (sparse && trace.traceSparseGaps) {\n    trace.traceSparseGaps(details, seriesKey);\n    return;\n  }\n  if (gaps) trace.traceGaps?.(field, 'none', gaps, details, axis);\n  report(sink, 'AX105', 'none', details);\n}\n\nfunction alignedSeries(aligned: AlignedGroup, axis: XColumn, x: XData, table: Table, values: Values): Series {\n  const { group, order, gaps, drawable } = aligned;\n  const { value } = group;\n  const zero = value.missing === 'zero';\n  const description = seriesDescription(group.key, group.label, value);\n\n  if (order === null && axis.values === x.positions) {\n    let row = table.columns ? null : sourceRows(table);\n    if (zero) {\n      for (let i = 0; i < values.slot.length; i++) {\n        if (values.slot[i] !== SLOT_NULL && values.slot[i] !== SLOT_ABSENT_FIELD) continue;\n        row ??= sourceRows(table);\n        row[i] = -1;\n        values.slot[i] = SLOT_VALUE;\n      }\n    }\n    return { ...description, drawable, y: values.y, slot: values.slot, row };\n  }\n  const length = axis.values.length;\n  const slot = new Uint8Array(length);\n  const row = new Int32Array(length).fill(-1);\n  const y = new Float64Array(length);\n  const observations = order?.length ?? table.length;\n  let observed = 0;\n  let gap = 0;\n  for (let i = 0; i < length; i++) {\n    const position = axis.values[i]!;\n    const source = order?.[observed] ?? observed;\n    if (observed < observations && x.positions[source] === position) {\n      const state = values.slot[source]!;\n      if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) {\n        y[i] = 0;\n      } else {\n        slot[i] = state;\n        row[i] = table.rowIndex(source);\n        y[i] = values.y[source]!;\n      }\n      observed++;\n    } else {\n      const state = gaps?.[gap] === position ? SLOT_GAP : SLOT_NO_ROW;\n      if (state === SLOT_GAP) gap++;\n      if (!zero) slot[i] = state;\n      y[i] = zero ? 0 : NaN;\n    }\n  }\n  return { ...description, drawable, y, slot, row };\n}\n\nconst maxAlignedSlots = 20_000_000;\n\nexport function alignmentFits(series: number, positions: number, sink: DiagnosticSink): boolean {\n  if (series * positions <= maxAlignedSlots) return true;\n  report(sink, 'AX134', 'chart-error', {\n    count: 1, detail: 'The aligned frame has ' + series + ' series and ' + positions + ' x positions, exceeding 20,000,000 slots.',\n  });\n  return false;\n}\n\nexport function alignedFrame(\n  options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion, counts?: Map<string, ValueCounts>,\n): AlignedFrame {\n  const axis = x.parser.column(x.positions);\n  const { table } = options;\n  const frame = {\n    ...base(table, version), shape: 'aligned' as const,\n    xLabel: options.x.label, yLabel: options.values.length === 1 ? options.values[0]!.label : null,\n  };\n  const empty = () => ({ ...frame, x: { ...axis, values: new Float64Array(), categories: axis.categories && [] }, length: 0, series: [] });\n  const observed = combinePositions(x, []);\n  const groupsBySeries = groups(options, x, sink);\n  if (!alignmentFits(groupsBySeries.length, observed.length, sink)) return empty();\n  const aligned: AlignedGroup[] = [];\n  for (const group of groupsBySeries) {\n    aligned.push(alignGroup(group, x, axis, options.x.field, table, sink, options.series === null ? aligned[0] : undefined));\n  }\n  const positions = aligned.some(group => group.gaps) ? combinePositions(x, aligned) : observed;\n  if (!alignmentFits(aligned.length, positions.length, sink)) return empty();\n  const column = { ...axis, values: positions };\n  const included = x.order === null ? undefined : (row: number) => Number.isFinite(x.positions[row]);\n  const shared = options.series === null ? undefined : readValues(table, options.values[0]!, sink, true, 0, undefined, included);\n  const series = aligned.map(group => {\n    const value = group.group.value;\n    const count = counts ? { decimal: 0, other: 0 } : undefined;\n    const values = shared ?? readValues(table, value, sink, true, 0, undefined, included, undefined, count);\n    if (count) counts!.set(value.field, count);\n    return alignedSeries(group, column, x, table, values);\n  });\n  for (const { group, gaps, sparse } of aligned) {\n    reportGaps(sink, options.x.field, group.value.missing === 'zero', gaps, axis, group.label, sparse, group.key);\n  }\n  return { ...frame, x: column, length: positions.length, series };\n}\n\nexport function pointFrame(options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion): PointFrame {\n  const { table } = options;\n  const value = options.values[0]!;\n  const included = x.order === null ? undefined : (row: number) => Number.isFinite(x.positions[row]);\n  const members = groups(options, x, sink);\n  const values = readValues(table, value, sink, true, 0, undefined, included, 'The affected points are not drawn.');\n  const isMissing = (row: number) => values.slot[row] === SLOT_NULL || values.slot[row] === SLOT_ABSENT_FIELD;\n  if (value.missing === 'zero') {\n    for (let row = 0; row < values.slot.length; row++) {\n      if (isMissing(row)) values.slot[row] = SLOT_VALUE;\n    }\n  }\n  const series = members.map(group => {\n    const length = group.order?.length ?? x.positions.length;\n    if (!group.order && values.y instanceof Float64Array && values.slot.every(slot => slot === SLOT_VALUE)) {\n      return {\n        key: group.key, label: group.label, drawable: true, x: x.positions, y: values.y,\n        row: table.columns ? null : sourceRows(table),\n      };\n    }\n    const rows = new Int32Array(length);\n    let next = 0;\n    let missing = 0;\n    for (let i = 0; i < length; i++) {\n      const row = group.order?.[i] ?? i;\n      if (values.slot[row] === SLOT_VALUE) rows[next++] = row;\n      else if (isMissing(row)) missing++;\n    }\n    const missingX = missing ? new Float64Array(missing) : undefined;\n    if (missingX) {\n      let index = 0;\n      for (let i = 0; i < length; i++) {\n        const row = group.order?.[i] ?? i;\n        if (isMissing(row)) missingX[index++] = x.positions[row]!;\n      }\n    }\n    const kept = rows.subarray(0, next);\n    kept.sort((a, b) => x.positions[a]! - x.positions[b]! || values.y[a]! - values.y[b]!);\n    return {\n      key: group.key, label: group.label, drawable: true, missingX,\n      x: Float64Array.from(kept, row => x.positions[row]!), y: Float64Array.from(kept, row => values.y[row]!), row: Int32Array.from(kept, table.rowIndex),\n    };\n  });\n\n  return {\n    ...base(options.table, version), shape: 'points', xKind: x.parser.kind === 'category' ? 'number' : x.parser.kind,\n    timeZone: x.parser.timeZone, series, xLabel: options.x.label, yLabel: value.label, xUnit: options.x.unit, yUnit: value.unit,\n  };\n}\n\nfunction donutFrame(options: ResolvedOptions, sink: DiagnosticSink, version: FrameVersion): DonutFrame {\n  const { table, x } = options;\n  const field = options.values[0]!;\n  const labels: string[] = [];\n  const seen = new Set<string>();\n  const issues = new Reports(x.field, sink);\n  const negatives = new Reports(field.field, sink);\n  const rows = new Int32Array(table.length);\n  const included = new Uint8Array(table.length);\n  for (let i = 0; i < table.length; i++) {\n    const raw = table.read(i, x.field);\n    const name = nameOf(raw);\n    if (name === null) {\n      if (Number.isNaN(raw) && table.isColumnRow(i)) continue;\n      if (raw === undefined) issues.add('AX102', 'omitted', table.rowIndex(i), undefined, undefined, { outcome: 'The affected slice is not drawn.' });\n      else issues.add('AX107', 'omitted', table.rowIndex(i), raw, 'Supply a label for each donut value.');\n    } else {\n      if (seen.has(name)) issues.add('AX108', 'chart-error', table.rowIndex(i), name);\n      seen.add(name);\n      rows[labels.length] = i;\n      labels.push(name);\n      included[i] = 1;\n    }\n  }\n  issues.flush(sink);\n  const order = rows.subarray(0, labels.length);\n  const values = readValues(table, field, sink, true, 0, undefined, i => included[i] === 1);\n  const provenance = table.columns && order.length === table.length && field.missing !== 'zero'\n    ? null : Int32Array.from(order, table.rowIndex);\n  for (let i = 0; i < order.length; i++) {\n    const row = order[i]!;\n    const value = values.y[row]!;\n    if (value < 0) negatives.add('AX120', 'chart-error', table.rowIndex(row), value);\n    if (field.missing === 'zero' && (values.slot[row] === SLOT_NULL || values.slot[row] === SLOT_ABSENT_FIELD)) {\n      values.slot[row] = SLOT_VALUE;\n      provenance![i] = -1;\n    }\n  }\n  negatives.flush(sink);\n  const allRows = order.length === table.length;\n  return {\n    ...base(table, version), shape: 'donut', labels,\n    values: allRows && values.y instanceof Float64Array ? values.y : Float64Array.from(order, row => values.y[row]!),\n    slot: allRows ? values.slot : Uint8Array.from(order, row => values.slot[row]!),\n    row: provenance,\n    valueLabel: field.label, unit: field.unit, valueScale: field.scale,\n  };\n}\n\ninterface AlignedSeed {\n  readonly options: ResolvedOptions;\n  readonly type: AlignedChartType;\n  readonly x: XData;\n  readonly counts: Map<string, ValueCounts>;\n  readonly diagnostics: StreamDiagnostics;\n}\n\nconst alignedSeeds = new WeakMap<AlignedFrame, AlignedSeed>();\n\nexport function alignedSeed(frame: AlignedFrame): AlignedSeed | undefined {\n  return alignedSeeds.get(frame);\n}\n\nexport function normalize(type: AlignedChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): AlignedFrame;\nexport function normalize(type: 'scatter', options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): PointFrame;\nexport function normalize(type: 'donut', options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): DonutFrame;\nexport function normalize(type: ChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Frame;\nexport function normalize(type: ChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Frame {\n  const valid = options.valid ? options : { ...options, table: { ...options.table, columns: null, length: 0 } };\n  if (type === 'donut') return donutFrame(valid, sink, version);\n  const diagnostics = type !== 'scatter' && options.valid && options.series === null ? new StreamDiagnostics() : null;\n  const observe = diagnostics ? recordDiagnostics(sink, diagnostics) : sink;\n  const x = readX(type, valid, env, observe);\n  reportCalendarDates(x, valid.table, sink);\n  if (type === 'scatter') return pointFrame(valid, x, sink, version);\n  // Ascending wide axes can initialize the streaming indexes from normalized positions.\n  const counts = diagnostics && x.order === null ? new Map<string, ValueCounts>() : undefined;\n  const frame = alignedFrame(valid, x, observe, version, counts);\n  if (counts && diagnostics && frame.series.length === options.values.length) {\n    alignedSeeds.set(frame, { options, type, x, counts, diagnostics });\n  }\n  return frame;\n}\nimport type { DiagnosticInput, DiagnosticSink, DonutFrame, PointFrame } from '../core/contracts';\nimport { DiagnosticCollector } from '../diagnostics';\nimport { lowerBound } from '../lookup/search';\nimport { normalize, pointFrame, readX, reportCalendarDates, type DataEnvironment, type FrameVersion } from './normalize';\nimport { resolveOptions, resolveTable, retargetOptions, withoutTable, type ResolvedOptions } from './options';\nimport { Reports } from './reports';\nimport { FrameSource, RowRevisions, StreamRows } from './store-rows';\nimport { CalendarWindow } from './store-calendar';\nimport { StoreMap } from './store-map';\nimport { Column, Labels } from './store-window';\nimport { rowsTable, type Table } from './table';\nimport { once, retention, type PreparedFrame, type StoreAppendOptions } from './transaction';\nimport { nameOf } from './x';\n\nconst quiet: DiagnosticSink = { add() {} };\n\ninterface Result<F> {\n  readonly frame: F;\n  readonly positions: Float64Array;\n  readonly order: Int32Array | null;\n}\n\ntype Build<F> = (options: ResolvedOptions, environment: DataEnvironment, sink: DiagnosticSink, version: FrameVersion) => Result<F>;\n\ninterface Storage<F> {\n  frame(frame: F): F;\n  extend(next: Result<F>, rows: StreamRows, firstRow: number, keep: number | undefined): Storage<F> | null;\n  commit(): void;\n}\n\ntype Open<F> = (result: Result<F>) => Storage<F> | null;\n\nconst doubles = (length: number) => new Float64Array(length);\nconst indexes = (length: number) => new Int32Array(length);\nconst states = (length: number) => new Uint8Array(length);\nconst empty = new Float64Array();\n\nfunction buildPoints(options: ResolvedOptions, environment: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Result<PointFrame> {\n  if (!options.valid) {\n    return { frame: normalize('scatter', options, environment, sink, version), positions: new Float64Array(), order: null };\n  }\n  const x = readX('scatter', options, environment, sink);\n  reportCalendarDates(x, options.table, sink);\n  return { ...x, frame: pointFrame(options, x, sink, version) };\n}\n\nfunction buildDonut(options: ResolvedOptions, environment: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Result<DonutFrame> {\n  const frame = normalize('donut', options, environment, sink, version);\n  const positions = new Float64Array(options.valid ? options.table.length : 0).fill(NaN);\n  const labels = new Map<string, number>();\n  const order = new Int32Array(frame.labels.length);\n  let length = 0;\n  for (let i = 0; i < positions.length; i++) {\n    const label = nameOf(options.table.read(i, options.x.field));\n    if (label === null) continue;\n    let index = labels.get(label);\n    if (index === undefined) labels.set(label, index = labels.size);\n    positions[i] = index;\n    order[length++] = i;\n  }\n  order.sort((a, b) => positions[a]! - positions[b]!);\n  return { frame, positions, order };\n}\n\nfunction firstPosition(result: Result<PointFrame | DonutFrame>, keep: number): number {\n  const { positions, order } = result;\n  let first = Infinity;\n  let distinct = 0;\n  for (let i = (order?.length ?? positions.length) - 1; i >= 0; i--) {\n    const position = positions[order?.[i] ?? i]!;\n    if (position === first) continue;\n    if (distinct === keep) return first;\n    first = position;\n    distinct++;\n  }\n  return -Infinity;\n}\n\nfunction ordered(positions: Float64Array, last: number = -Infinity): boolean {\n  for (const position of positions) {\n    if (!Number.isFinite(position) || position < last) return false;\n    last = position;\n  }\n  return true;\n}\n\nclass Points implements Storage<PointFrame> {\n  private constructor(\n    private readonly kind: PointFrame['xKind'],\n    private readonly positions: Column<Float64Array>, private distinct: number,\n    private readonly x: Column<Float64Array>, private readonly y: Column<Float64Array>, private readonly row: Column<Int32Array>,\n    private readonly missingX: Column<Float64Array>,\n    private readonly calendar: CalendarWindow | null,\n  ) {}\n\n  static open({ frame, positions }: Result<PointFrame>): Points | null {\n    const series = frame.series[0];\n    if (frame.series.length !== 1 || !series?.row || !ordered(positions)) return null;\n    const calendar = frame.xKind === 'time' ? new CalendarWindow(frame.timeZone ?? 'UTC') : null;\n    let distinct = 0;\n    let last = -Infinity;\n    for (const position of positions) {\n      if (position !== last) distinct++;\n      last = position;\n      calendar?.observe(position);\n    }\n    return new Points(frame.xKind, new Column(doubles, positions), distinct,\n      new Column(doubles, series.x), new Column(doubles, series.y), new Column(indexes, series.row),\n      new Column(doubles, series.missingX ?? empty), calendar);\n  }\n\n  extend(next: Result<PointFrame>, rows: StreamRows, firstRow: number, keep: number | undefined): Points | null {\n    const series = next.frame.series[0];\n    const last = this.positions.view().at(-1);\n    if (next.frame.xKind !== this.kind || !series?.row || !ordered(next.positions, last)) return null;\n    // A tie can append if its y also sorts after the old tail. Otherwise the old snapshot\n    // and the new sort order need different storage.\n    const lastX = this.x.view().at(-1);\n    const lastY = this.y.view().at(-1);\n    if (lastX !== undefined && lastY !== undefined && series.x[0] === lastX && series.y[0]! < lastY) return null;\n\n    const calendar = this.calendar?.fork() ?? null;\n    if (calendar) {\n      for (const position of next.positions) calendar.observe(position);\n      if (calendar.daily()) return null;\n    }\n    const draft = new Points(this.kind, this.positions.fork(), this.distinct,\n      this.x.fork(), this.y.fork(), this.row.fork(), this.missingX.fork(), calendar);\n    draft.positions.append(next.positions);\n    draft.x.append(series.x);\n    draft.y.append(series.y);\n    draft.row.append(series.row);\n    if (series.missingX) draft.missingX.append(series.missingX);\n    let previous = last;\n    for (let i = 0; i < next.positions.length; i++) {\n      const position = next.positions[i]!;\n      if (position !== previous) draft.distinct++;\n      previous = position;\n      rows.record(position, firstRow + i);\n    }\n\n    if (keep !== undefined && draft.distinct > keep) {\n      const positions = draft.positions.view();\n      let removed = 0;\n      while (draft.distinct > keep) {\n        const x = positions[removed]!;\n        rows.evictRead(x);\n        calendar?.evictPosition(x);\n        do removed++; while (positions[removed] === x);\n        draft.distinct--;\n      }\n      if (calendar?.daily()) return null;\n      const first = positions[removed] ?? Infinity;\n      const points = lowerBound(draft.x.view(), first);\n      draft.positions.drop(removed);\n      draft.x.drop(points);\n      draft.y.drop(points);\n      draft.row.drop(points);\n      draft.missingX.drop(lowerBound(draft.missingX.view(), first));\n    }\n\n    return draft;\n  }\n\n  commit(): void { this.calendar?.commit(); }\n\n  frame(frame: PointFrame): PointFrame {\n    const missingX = this.missingX.view();\n    return { ...frame, series: [{\n      ...frame.series[0]!, x: this.x.view(), y: this.y.view(), row: this.row.view(), missingX: missingX.length ? missingX : undefined,\n    }] };\n  }\n}\n\nclass Slices implements Storage<DonutFrame> {\n  private constructor(\n    private readonly labels: Labels, private readonly positions: StoreMap<string, number>, private next: number,\n    private readonly values: Column<Float64Array>, private readonly slot: Column<Uint8Array>, private readonly row: Column<Int32Array>,\n  ) {}\n\n  static open({ frame, positions }: Result<DonutFrame>): Slices | null {\n    if (frame.labels.length !== positions.length || !frame.row) return null;\n    const labels = new Map(frame.labels.map((label, index) => [label, index]));\n    if (labels.size !== frame.labels.length) return null;\n    return new Slices(new Labels(frame.labels), new StoreMap(labels), labels.size,\n      new Column(doubles, frame.values), new Column(states, frame.slot), new Column(indexes, frame.row));\n  }\n\n  commit(): void { this.positions.commit(); }\n\n  extend(next: Result<DonutFrame>, rows: StreamRows, firstRow: number, keep: number | undefined): Slices | null {\n    const frame = next.frame;\n    if (frame.labels.length !== next.positions.length || !frame.row || frame.labels.some(label => this.positions.has(label))) return null;\n    const draft = new Slices(this.labels.fork(), this.positions.fork(), this.next,\n      this.values.fork(), this.slot.fork(), this.row.fork());\n    for (let i = 0; i < frame.labels.length; i++) {\n      const label = frame.labels[i]!;\n      draft.labels.push(label);\n      const position = draft.next++;\n      draft.positions.set(label, position);\n      rows.record(position, firstRow + i);\n    }\n    draft.values.append(frame.values);\n    draft.slot.append(frame.slot);\n    draft.row.append(frame.row);\n\n    if (keep !== undefined && draft.labels.length > keep) {\n      const dropped = draft.labels.length - keep;\n      for (let i = 0; i < dropped; i++) {\n        const label = draft.labels.at(i);\n        rows.evictRead(draft.positions.get(label)!);\n        draft.positions.delete(label);\n      }\n      draft.labels.drop(dropped);\n      draft.values.drop(dropped);\n      draft.slot.drop(dropped);\n      draft.row.drop(dropped);\n    }\n\n    return draft;\n  }\n\n  frame(frame: DonutFrame): DonutFrame {\n    return { ...frame, labels: this.labels.view(), values: this.values.view(), slot: this.slot.view(), row: this.row.view() };\n  }\n}\n\nfunction removeRows(table: Table, positions: Float64Array, keep: number, first: number, rows: StreamRows): number[] {\n  let unplaced = 0;\n  for (let i = 0; i < table.length; i++) {\n    if (!Number.isFinite(positions[i])) unplaced++;\n  }\n  let excess = Math.max(0, unplaced - 2 * keep);\n  const removed: number[] = [];\n  for (let i = 0; i < table.length; i++) {\n    const position = positions[i]!;\n    if (Number.isFinite(position) ? position >= first : excess-- <= 0) continue;\n    const row = table.rowIndex(i);\n    rows.forget(row);\n    removed.push(row);\n  }\n  return removed;\n}\n\nclass UnalignedStore<F extends PointFrame | DonutFrame> {\n  private rows: StreamRows;\n  private readonly revisions: RowRevisions;\n  private encoding: ResolvedOptions;\n  private current: F;\n  private latest: readonly DiagnosticInput[];\n  private storage: Storage<F> | null;\n\n  constructor(\n    private readonly type: 'scatter' | 'donut',\n    private readonly build: Build<F>,\n    private readonly open: Open<F>,\n    options: ResolvedOptions,\n    private readonly environment: DataEnvironment,\n    version: FrameVersion,\n    private readonly sink: DiagnosticSink,\n  ) {\n    this.rows = new StreamRows(options.table);\n    this.revisions = new RowRevisions(this.rows);\n    this.encoding = withoutTable(options);\n    const diagnostics = new DiagnosticCollector();\n    const table = this.rows.table();\n    const result = build({ ...options, table }, environment, diagnostics, version);\n    const { frame, positions } = result;\n    this.rows.resetPositions(table, positions);\n    this.latest = diagnostics.inputs();\n    this.storage = this.latest.length ? null : this.open(result);\n    const source = new FrameSource(this.rows.next, this.rows);\n    this.current = { ...(this.storage?.frame(frame) ?? frame), source };\n    this.revisions.current.publish(frame.revision, source, this.rows);\n    for (const diagnostic of this.latest) sink.add(diagnostic);\n  }\n\n  get frame(): F { return this.current; }\n  get diagnostics(): readonly DiagnosticInput[] { return this.latest; }\n  get retainedRowCount(): number { return this.revisions.size; }\n\n  /** Releases source rows through this revision. Held frame views keep their normalized values. */\n  retire(revision: number): void { this.revisions.retire(revision); }\n\n  /** Validates encoding against the retained rows and returns options for re-encoding this store. */\n  resolveEncoding(input: unknown, sink: DiagnosticSink): ResolvedOptions {\n    return withoutTable(resolveOptions(this.type, input, sink, this.rows.table()));\n  }\n\n  append(rows: readonly unknown[], options: StoreAppendOptions = {}, sink = this.sink): F {\n    const prepared = this.prepareAppend(rows, options);\n    for (const diagnostic of prepared.callDiagnostics) sink.add(diagnostic);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareAppend(rows: readonly unknown[], options: StoreAppendOptions = {}): PreparedFrame<F> {\n    const base = this.current;\n    const version = { epoch: base.epoch, revision: base.revision + 1 };\n    const keep = retention(options);\n    const fast = this.extendAppend(base, rows, version, keep);\n    if (fast) return fast;\n    const retained = this.rows.fork();\n    retained.append(rows);\n    let table = retained.table();\n    const call = new DiagnosticCollector();\n    const resolved = retargetOptions(this.encoding, table, call);\n    let result = this.build(resolved, this.environment, call, version);\n    const ordering = new DiagnosticCollector();\n    if (this.type === 'scatter') {\n      const reports = new Reports(this.encoding.x.field, ordering);\n      let highest = -Infinity;\n      for (let i = 0; i < result.positions.length; i++) {\n        const position = result.positions[i]!;\n        if (!Number.isFinite(position)) continue;\n        const row = table.rowIndex(i);\n        if (row >= this.rows.next && position < highest) reports.add('AX151', 'none', row);\n        highest = Math.max(highest, position);\n      }\n      reports.flush(ordering);\n    }\n    let current = call;\n    const evicted: number[] = [];\n    if (keep !== undefined) {\n      // Removing rows can change the inferred kind and make formerly unplaceable x values usable.\n      while (true) {\n        const removed = removeRows(table, result.positions, keep, firstPosition(result, keep), retained);\n        if (removed.length === 0) break;\n        for (const row of removed) evicted.push(row);\n        current = new DiagnosticCollector();\n        table = retained.table();\n        const encoded = retargetOptions(this.encoding, table, current);\n        result = this.build(encoded, this.environment, current, version);\n      }\n    }\n    const ordered = ordering.inputs();\n    const diagnostics = [...current.inputs(), ...ordered];\n    retained.resetPositions(table, result.positions);\n    return this.prepare(base, result.frame, retained, diagnostics.length ? null : this.open(result),\n      diagnostics, [...call.inputs(), ...ordered], evicted);\n  }\n\n  private extendAppend(base: F, rows: readonly unknown[], version: FrameVersion, keep: number | undefined): PreparedFrame<F> | null {\n    // Implicit string parsing and diagnostics can change when old rows leave. Reuse old values only when\n    // both partitions have unambiguous clean values and the same x interpretation.\n    if (!this.storage || this.encoding.values[0]?.parse || this.encoding.series !== null) return null;\n    const table = { ...rowsTable(rows), rowIndex: (row: number) => this.rows.next + row };\n    const diagnostics = new DiagnosticCollector();\n    const resolved = retargetOptions(this.encoding, table, diagnostics);\n    if (!resolved.valid) return null;\n    const result = this.build(resolved, this.environment, diagnostics, version);\n    if (diagnostics.inputs().length) return null;\n    const retained = this.rows.fork();\n    const evicted: number[] = [];\n    retained.onForget = row => evicted.push(row);\n    retained.append(rows);\n    const extension = this.storage.extend(result, retained, this.rows.next, keep);\n    retained.onForget = undefined;\n    if (!extension) return null;\n    return this.prepare(base, result.frame, retained, extension, [], [], evicted);\n  }\n\n  reencode(options: ResolvedOptions, version: FrameVersion): F {\n    const prepared = this.prepareReencode(options, version);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareReencode(options: ResolvedOptions, version: FrameVersion): PreparedFrame<F> {\n    return this.prepareEncoding(this.rows.fork(), options, version, new DiagnosticCollector());\n  }\n\n  replace(data: unknown, options: ResolvedOptions, version: FrameVersion): F {\n    const prepared = this.prepareReplace(data, options, version);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareReplace(data: unknown, options: ResolvedOptions, version: FrameVersion): PreparedFrame<F> {\n    const call = new DiagnosticCollector();\n    const replacement = resolveTable(data, call);\n    return this.prepareEncoding(new StreamRows(replacement.table), options, version, call, replacement);\n  }\n\n  private prepareEncoding(\n    rows: StreamRows, options: ResolvedOptions, version: FrameVersion, call: DiagnosticCollector,\n    replacement?: { table: Table; valid: boolean },\n  ): PreparedFrame<F> {\n    const base = this.current;\n    if (version.revision <= base.revision || version.epoch <= base.epoch) {\n      throw new Error('Encoding updates and replacements require a newer epoch and revision.');\n    }\n    const table = rows.table();\n    const resolved = retargetOptions(options, replacement?.table ?? table, call, replacement?.valid);\n    const result = this.build({ ...resolved, table }, this.environment, call, version);\n    rows.resetPositions(table, result.positions);\n    const diagnostics = call.inputs();\n    return this.prepare(base, result.frame, rows, diagnostics.length ? null : this.open(result), diagnostics, diagnostics, [], options, replacement !== undefined);\n  }\n\n  private prepare(\n    base: F, frame: F, rows: StreamRows, storage: Storage<F> | null,\n    diagnostics: readonly DiagnosticInput[], callDiagnostics: readonly DiagnosticInput[],\n    evicted: readonly number[], options = this.encoding, replacement = false,\n  ): PreparedFrame<F> {\n    const source = new FrameSource(rows.next, rows, () => this.current === base);\n    const candidate = { ...(storage?.frame(frame) ?? frame), source };\n    const commit = once(() => this.current, () => {\n      if (replacement) this.revisions.replace(rows);\n      for (const row of evicted) this.revisions.current.archive(row);\n      rows.commit();\n      storage?.commit();\n      this.rows = rows;\n      this.current = candidate;\n      this.latest = diagnostics;\n      this.storage = storage;\n      if (options !== this.encoding) this.encoding = withoutTable(options);\n      this.revisions.current.publish(candidate.revision, source, rows);\n    }, base);\n    return { frame: candidate, diagnostics, callDiagnostics, commit };\n  }\n}\n\nexport class PointStore extends UnalignedStore<PointFrame> {\n  constructor(options: ResolvedOptions, environment: DataEnvironment, version: FrameVersion, sink: DiagnosticSink = quiet) {\n    super('scatter', buildPoints, Points.open, options, environment, version, sink);\n  }\n}\n\nexport class DonutStore extends UnalignedStore<DonutFrame> {\n  constructor(options: ResolvedOptions, environment: DataEnvironment, version: FrameVersion, sink: DiagnosticSink = quiet) {\n    super('donut', buildDonut, Slices.open, options, environment, version, sink);\n  }\n}\nimport { SLOT_VALUE, type Formatters, type IndexRange, type PointSeries, type ScatterView, type SlotState, type TableModel, type View } from '../core/contracts';\nimport { pointOrder, type PointIndex, type PointOrderWork } from '../lookup/point-order';\nimport { lowerBound, upperBound } from '../lookup/search';\nimport { donutRatio, incomplete, slotText } from '../lookup/text';\nimport type { Messages } from '../public';\nimport { readPosition } from './x';\n\nconst PAGE_SIZE = 100;\n\nexport function withUnit(label: string, unit: string | null): string {\n  return unit ? `${label} (${unit})` : label;\n}\n\nfunction page