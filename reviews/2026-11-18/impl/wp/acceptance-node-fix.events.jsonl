stringify([file, stat?.mode, sha(content)]));\n  }\n  // Include edits staged against HEAD even when the index matches the working file.\n  tree.update(git('diff', '--cached', '--binary', 'HEAD', '--', '.', ':(exclude)acceptance/report.md'));\n  const hashes = Object.fromEntries(files.map(file => [file, sha(readFileSync(resolve(root, file)))]));\n  return { commit, dirty: status.length > 0, tree: tree.digest('hex'), hashes };\n}\nEOF\ncat > acceptance/run.mjs <<'EOF'\nimport { spawnSync } from 'node:child_process';\nimport { mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';\nimport { resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { citedTestFiles, snapshot } from './provenance.mjs';\n\nconst root = fileURLToPath(new URL('..', import.meta.url));\nconst configs = {\n  unit: [],\n  browser: [],\n  dist: ['--config', 'tests/dist/vitest.config.ts'],\n  'dist-browser': ['--config', 'tests/dist/vitest.config.ts'],\n};\nconst [name, ...filters] = process.argv.slice(2);\nif (\"'!Object.hasOwn(configs, name)) {\n  console.error('\"'Usage: node acceptance/run.mjs <unit|browser|dist|dist-browser> [test file filters…]');\n  process.exitCode = 1;\n} else {\n  const matrix = JSON.parse(readFileSync(resolve(root, 'acceptance/matrix.json'), 'utf8'));\n  const files = citedTestFiles(matrix);\n  const before = snapshot(root, files);\n  const directory = resolve(root, 'acceptance/results');\n  const result = resolve(directory, name + '.json');\n  const provenance = resolve(directory, name + '.provenance.json');\n  mkdirSync(directory, { recursive: true });\n  rmSync(result, { force: true });\n  rmSync(provenance, { force: true });\n  const env = { ...process.env };\n  if (name.includes('browser')) env.AXYLO_BROWSER = '1';\n  else delete env.AXYLO_BROWSER;\n  const vitest = resolve(root, 'node_modules/vitest/vitest.mjs');\n  const run = spawnSync('timeout', ['--kill-after=5', '400', process.execPath, vitest, 'run', ...configs[name],\n    '-