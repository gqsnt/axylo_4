re pairwise distinct, and no category label is hidden without the note\n  - `packages/axylo/test/browser/acceptance/l-legibility.browser.test.ts` · L1 donut: at widths 240, 320, 480, 720, 1280, 1920 px (200 % text-only zoom) no text overlaps other text (1 px), none is outside the figure, tick labels are pairwise distinct, and no category label is hidden without the note\n- `acceptance/results/dist.json` · 83 passed assertions, 0 reported failures\n- `acceptance/results/dist-browser.json` · 18 passed assertions, 0 reported failures\n\n## Packed size measurement\n\n- line only (examples/first-chart/npm.ts) · 282,947 minified JS bytes, 97.61 KiB gzipped, 25 KiB target · [bench/size-latest.json](../bench/size-latest.json)\n- everything (export * from axylo) · 283,389 minified JS bytes, 97.75 KiB gzipped, 40 KiB target · [bench/size-latest.json](../bench/size-latest.json)\n- script tag (axylo.iife.min.js + axylo.css) · 283,869 minified JS bytes, 101.83 KiB gzipped · [bench/size-latest.json](../bench/size-latest.json)\n- React adapter alone (react, axylo external) · 2,375 minified JS bytes, 1.17 KiB gzipped, 2 KiB target · [bench/size-latest.json](../bench/size-latest.json)\n\n\n## Status by chart type\n\n- pass · 117\n- fail · 11\n- weak · 128\n- no evidence · 18\n- not run · 21\n- cannot be verified here · 15\n- not applicable · 266\n\nimport { expect, it } from 'vitest';\nimport { stepAcross, targetOf } from '../../src/core/focus';\nimport { at, axes, chart, codes, committed, lastModel, marks, pixel, plot, reading, refAt, rows, scene, seriesRows, types, walk, type Type } from './model';\n\nconst fixture = (type: Type) => type === 'donut' ? [{ x: 'A', y: 2 }, { x: 'B', y: 6 }] : [{ x: 1, y: 2 }, { x: 2, y: 6 }];\nconst full = ['line', 'area', 'bar', 'scatter', 'donut'] as const;\n\nfor (const type of types) {\n  it(`A1 ${type}: model preserves the author’s heading, uses an existing label when given and adds the description to the data summary`, () => {\n    const r = chart(type, fixture(type), { title: { text: 'Sales', level: 4, visible: false }, description: 'From the ledger.' });\n    r.frames();\n    expect(lastModel(r)).toMatchObject({ name: 'Sales', title: { text: 'Sales', level: 4, visible: false } });\n    expect(lastModel(r).summary).toContain(type === 'donut' ? '2 slices. Total 8.' : 'minimum 2, maximum 6, last 6.');\n    expect(lastModel(r).summary).toContain('From the ledger.');\n    r.ids['card-heading'] = 'Card heading';\n    r.controller.handle.update({ labelledBy: 'card-heading' });\n    r.frames();\n    expect(lastModel(r)).toMatchObject({ labelledBy: 'card-heading', title: null });\n    expect(codes(r)).toEqual([]);\n  });\n\n  it(`L7 ${type}: loading, empty and error draw no data marks and each state change is announced once`, () => {\n    const data = fixture(type);\n    const r = chart(type, data);\n    r.frames();\n    const handle = r.controller.handle;\n    for (const [patch, message] of [\n      [{ state: 'loading' }, 'Loading chart.'],\n      [{ state: 'ready', data: [] }, 'No data to show.'],\n      [{ state: { error: 'Query failed.' } }, 'Query failed.'],\n    ] as const) {\n      handle.update(patch);\n      r.frames();\n      expect(lastModel(r).message).toBe(message);\n      expect(scene(r).marks).toEqual([]);\n      expect(r.texts.at(-1)).toEqual([]);\n      handle.update({ description: 'State stays the same.' });\n      r.frames();\n      expect(r.announcements.filter(text => text === message)).toEqual([message]);\n    }\n    handle.update({ state: 'ready', data });\n    r.frames();\n    expect(lastModel(r).message).toBeNull();\n    expect(r.announcements).toEqual(['Loading chart.', 'No data to show.', 'Query failed.', 'Measurements']);\n  });\n\n  it(`L4 ${type}: a new scheme from the host repaints the committed scene within one frame`, () => {\n    const r = chart(type, fixture(type));\n    const resolve = r.host.theme;\n    let scheme: 'light' | 'dark' = 'light';\n    r.host.theme = (keys, colors) => {\n      const result = resolve(keys, colors);\n      return { ...result, theme: { ...result.theme, scheme } };\n    };\n    r.frames();\n    expect(committed(r).theme.scheme).toBe('light');\n    const first = scene(r);\n    const draws = r.draws.length;\n    scheme = 'dark';\n    r.controller.invalidate.theme();\n    expect(r.frames()).toBeLessThanOrEqual(1);\n    expect(committed(r).theme.scheme).toBe('dark');\n    expect(r.draws).toHaveLength(draws + 1);\n    expect(scene(r)).toEqual(first);\n  });\n\n  it(`I5 ${type}: the first model frame has final geometry and an update commits without intervening model frames`, () => {\n    const r = chart(type, fixture(type));\n    expect(r.draws).toEqual([]);\n    expect(r.frames()).toBe(1);\n    expect(r.draws).toHaveLength(1);\n    const first = scene(r);\n    r.controller.handle.update({ data: fixture(type).map(row => ({ ...row, y: row.y + 3 })) });\n    expect(scene(r)).toBe(first);\n    expect(r.frames()).toBe(1);\n    expect(r.draws).toHaveLength(2);\n    expect(lastModel(r).summary).toContain(type === 'donut' ? 'Total 14.' : 'minimum 5, maximum 9, last 9.');\n    expect(r.frames()).toBe(0);\n    expect(r.draws).toHaveLength(2);\n  });\n\n  it(`A10 ${type}: author messages replace the model’s generated name and warning and keep built-in state text tagged English`, () => {\n    const r = chart(type, [{ x: type === 'donut' ? 'A' : 1, y: 5 }, { x: type === 'donut' ? 'B' : 2, y: Infinity }], {\n      title: undefined, messages: { chartName: 'Diagramm {x}', valuesNotShown: 'Ausgelassen: {count}.' },\n    });\n    r.host.pageLang = () => 'de';\n    r.frames();\n    expect(lastModel(r).name).toBe(type === 'donut' ? 'Diagramm Category' : 'Diagramm x');\n    expect(lastModel(r).note).toBe('Ausgelassen: 1.');\n    expect(lastModel(r).noteLang).toBeNull();\n    expect(lastModel(r).summary).toContain('Ausgelassen: 1.');\n    r.controller.handle.update({ state: 'loading' });\n    r.frames();\n    expect(lastModel(r)).toMatchObject({ message: 'Loading chart.', messageLang: 'en' });\n  });\n}\n\nfor (const type of full) {\n  it(`A2 ${type}: the interaction model reaches every fixture datum and can go directly to either end`, () => {\n    const r = chart(type, fixture(type));\n    r.frames();\n    const refs = walk(r);\n    const { lookup } = committed(r);\n    expect(refs).toHaveLength(2);\n    expect(refs.map(ref => lookup.ordinal(ref))).toEqual([0, 1]);\n    expect(lookup.step(refs[0]!, 'last')).toEqual(refs[1]);\n    expect(lookup.step(refs[1]!, 'first')).toEqual(refs[0]);\n    expect(lookup.step(refs[0]!, 'previous')).toBeNull();\n    expect(lookup.step(refs[1]!, 'next')).toBeNull();\n  });\n\n  it(`A3 ${type}: the pure keyboard value text conveys identity, value with unit and position`, () => {\n    const key = type === 'donut' ? 'value' : 'y';\n    const r = chart(type, fixture(type), { [key]: { field: 'y', label: 'Mass', unit: 'kg' } });\n    r.frames();\nimport { expect, it } from 'vitest';\nimport { aligned, axes, chart, codes, committed, expectCompact, lastModel, marks, pathRuns, plot, scene } from './model';\n\nfor (const kind of aligned) {\n  it(`C1 compact: ${kind} has a name and full summary, and the committed model is static`, () => {\n    const r = chart('compact', [{ x: 1, y: 6 }, { x: 2, y: 4 }, { x: 3, y: 8 }], {\n      title: undefined, description: 'Collected outdoors.',\n    }, undefined, kind);\n    r.frames();\n    expect(codes(r)).toEqual(['AX140']);\n    const capitalized = kind[0]!.toUpperCase() + kind.slice(1);\n    expect(lastModel(r)).toMatchObject({ compact: true, name: capitalized + ' chart of y by x', summaryVisible: false });\n    expect(lastModel(r).summary).toContain('1 series');\n    expect(lastModel(r).summary).toContain('x from 1 to 3');\n    expect(lastModel(r).summary).toContain('minimum 4, maximum 8, last 8');\n    expect(lastModel(r).summary).toContain('Collected outdoors.');\n    expectCompact(r);\n  });\n\n  it(`C2 compact: ${kind} draws only data marks, commits the sorted final geometry in one frame, and ignores public zoom`, () => {\n    const r = chart('compact', [{ x: 3, y: 8 }, { x: 1, y: 6 }, { x: 2, y: 4 }], {\n      reference: [{ y: 10, label: 'Target' }],\n    }, undefined, kind);\n    r.frames();\n    const initial = scene(r);\n    expect(initial.marks.length).toBeGreaterThan(0);\n    expect(initial.marks.every(mark => ['rects', 'area', 'path', 'points'].includes(mark.type))).toBe(true);\n    expect(lastModel(r).summary).toContain('last 8');\n    r.controller.handle.zoom([1, 2]);\n    r.frames();\n    expect(scene(r)).toEqual(initial);\n    r.controller.handle.update({ data: [{ x: 3, y: 20 }, { x: 1, y: 5 }, { x: 2, y: 9 }] });\n    expect(scene(r)).toBe(initial);\n    expect(r.frames()).toBe(1);\n    expect(scene(r)).not.toEqual(initial);\n    expect(lastModel(r).summary).toContain('minimum 5, maximum 20, last 20');\n    expectCompact(r);\n  });\n\n  it(`C3 compact: ${kind} fills a 24 by 16 CSS-pixel container and expands when measured (reading: stroke clearance can sit inside the container)`, () => {\n    const r = chart('compact', [{ x: 1, y: 3 }, { x: 2, y: 8 }], {}, { container: { width: 24, height: 16 } }, kind);\n    r.frames();\n    const initial = plot(r);\n    expect(initial).toMatchObject({ kind: 'compact', width: 24, height: 16 });\n    expect(initial.plot.width).toBeGreaterThan(0);\n    expect(initial.plot.height).toBeGreaterThan(0);\n    expect(scene(r).marks.length).toBeGreaterThan(0);\n    r.container = { width: 137, height: 32 };\n    r.controller.invalidate.resize();\n    r.frames();\n    expect(plot(r)).toMatchObject({ kind: 'compact', width: 137, height: 32 });\n    expect(plot(r).plot.width).toBeGreaterThan(initial.plot.width);\n    expect(plot(r).plot.height).toBeGreaterThan(initial.plot.height);\n    expect(codes(r)).toEqual([]);\n  });\n\n  it(`C5 compact: ${kind} supplies omission text for the corner marker and summary (reading: neither refers to an unavailable table)`, () => {\n    const r = chart('compact', [{ x: 1, y: 4 }, { x: 2, y: Infinity }, { x: 3, y: 6 }], {}, undefined, kind);\n    r.frames();\n    expect(codes(r)).toEqual(['AX103']);\n    expect(lastModel(r).compact).toBe(true);\n    expect(lastModel(r).note).toContain('Values not shown: 1.');\n    expect(lastModel(r).summary).toContain('Values not shown: 1.');\n    expect(lastModel(r).summary).toContain('minimum 4, maximum 6, last 6');\n    expectCompact(r);\n    expect(committed(r).reader.table).toBeNull();\n    expect(lastModel(r).note).not.toContain('See table');\n    expect(lastModel(r).summary).not.toContain('See table');\n  });\n}\n\nfor (const kind of ['line', 'area'] as const) {\n  it(`C4 compact: two ${kind} strokes use distinct paint bindings and dashes and AX131 suggests one series`, () => {\n    const r = chart('compact', [{ x: 1, a: 3, b: 7 }, { x: 2, a: 4, b: 5 }], { y: ['a', 'b'] }, undefined, kind);\n    r.frames();\n    const [first, second] = marks(r, 'path');\n    expect(first?.stroke).toEqual({ kind: 'series', index: 0 });\n    expect(second?.stroke).toEqual({ kind: 'series', index: 1 });\n    expect(first?.dash.normal).not.toEqual(second?.dash.normal);\n    expect(pathRuns(first!.xy)[0]).toHaveLength(2);\n    expect(axes(r).y.domain[1]).toBeGreaterThanOrEqual(7);\n    expect(r.controller.handle.diagnostics).toMatchObject([{ code: 'AX131', message: expect.stringMatching(/one series/i) }]);\n    expectCompact(r);\n  });\n}\n[\n  {\"criterion\":\"C1\",\"type\":\"compact\",\"file\":\"packages/axylo/test/acceptance/compact.test.ts\",\"title\":\"C1 compact: area has a name and full summary, and the committed model is static\"},\n  {\"criterion\":\"C1\",\"type\":\"compact\",\"file\":\"packages/axylo/test/acceptance/compact.test.ts\",\"title\":\"C1 compact: bar has a name and full summary, and the committed model is static\"},\n  {\"criterion\":\"C1\",\"type\":\"compact\",\"file\":\"packages/axylo/test/acceptance/compact.test.ts\",\"title\":\"C1 compact: li