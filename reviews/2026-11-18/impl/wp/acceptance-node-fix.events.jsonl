{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '211,290p' packages/axylo/src/view/index.ts\ncat packages/axylo/test/acceptance/{f-disclosure,dx-controller,f-missing-values}.test.ts\ncat vitest.config.ts tests/dist/vitest.config.ts\ngit ls-files acceptance/results\nls acceptance/results\"","aggregated_output":"    const { start, end } = ranges[i]!;\n    for (let j = start; j < end; j++) {\n      min = Math.min(min, y[j]!);\n      max = Math.max(max, y[j]!);\n    }\n  }\n  return [min, max];\n}\n\nfunction scatterX(frame: PointFrame, sink: DiagnosticSink): Span {\n  let min = Infinity;\n  let max = -Infinity;\n  let count = 0;\n  for (const { x, drawable, missingX } of frame.series) {\n    if (x.length) {\n      min = Math.min(min, x[0]!);\n      max = Math.max(max, x[x.length - 1]!);\n      if (drawable) count += x.length;\n    }\n    // Observations with an x and no y belong to the default range too, so the table reaches them (F2).\n    if (missingX) for (let i = 0; i < missingX.length; i++) {\n      const v = missingX[i]!;\n      if (Number.isFinite(v)) { min = Math.min(min, v); max = Math.max(max, v); }\n    }\n  }\n  if (count > 50_000) report(sink, 'AX133', 'none');\n  return [min, max];\n}\n\nfunction fitZoom(full: Span, zoom: Span | null): Span {\n  if (!zoom) return full;\n  const [low, high] = full;\n  const [start, end] = zoom;\n  if (start >= low && end <= high) return zoom;\n  // Compare half-widths so even a window spanning the extremes of a numeric axis can be shifted.\n  const width = end - start;\n  const overflow = !Number.isFinite(width);\n  const halfWidth = end / 2 - start / 2;\n  if (overflow ? halfWidth >= high / 2 - low / 2 : width >= high - low) return full;\n  if (start < low) {\n    const shifted = overflow ? (low / 2 + halfWidth) * 2 : low + width;\n    return shifted > low ? [low, Math.min(high, shifted)] : full;\n  }\n  const shifted = overflow ? (high / 2 - halfWidth) * 2 : high - width;\n  return shifted < high ? [Math.max(low, shifted), high] : full;\n}\n\nfunction xExtents(\n  data: Span, kind: XKind, readX: ReturnType<typeof positionReader>, references: readonly ResolvedReference[],\n  state: AlignedViewState | ScatterViewState, compact: boolean, sink: DiagnosticSink,\n): { xFull: Span; xDomain: Span } {\n  const authorInput = state.xDomain === undefined ? state.xField?.domain : state.xDomain;\n  const author = readSpan(authorInput, readX, 'x.domain', sink);\n  let [min, max] = data;\n  for (const reference of references) {\n    if (reference.axis !== 'x') continue;\n    min = Math.min(min, reference.from);\n    max = Math.max(max, reference.to);\n  }\n  const xFull: Span = state.kind === 'scatter' && kind === 'number'\n    ? valueDomain({ min, max, authorDomain: author, includeZero: false }).domain\n    : author ?? (min <= max ? [min, max] : kind === 'category' ? [0, 0] : [0, 1]);\n  const zoom = compact || kind === 'category' && state.kind === 'bar' ? null : readSpan(state.zoom, readX, 'zoom', sink, true);\n  return { xFull, xDomain: fitZoom(xFull, zoom) };\n}\n\nfunction yExtent(\n  data: Span, references: readonly ResolvedReference[], state: AlignedViewState | ScatterViewState,\n  scale: CartesianState['valueScale'], sink: DiagnosticSink,\n): ReturnType<typeof valueDomain> {\n  const positions = references.flatMap(r => r.axis === 'y' ? [r.from, r.to] : []);\n  if (state.valueDomain && !state.valueDomain.every(Number.isFinite)) {\n    report(sink, 'AX103', 'none', { field: 'y.domain' });\n  }\n  return valueDomain({\n    min: data[0], max: data[1], includeZero: state.kind === 'bar' || state.kind === 'area',\n    authorDomain: state.valueDomain, valueScale: scale, references: positions,\n  });\n}\n\nimport { expect, it } from 'vitest';\nimport { at, chart, codes, committed, lastModel, marks, pathRuns, reading, rows, walk } from './model';\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'donut'] as const) {\n  it(`F12 ${type}: three bad values leave a three-value note and summary while the chart preserves the good observations`, () => {\n    // The Phase 1 dirty fixture specifies the codes and the number of omitted values.\n    const values = [10, 20, null, NaN, '40', undefined, 70];\n    const weekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];\n    const data = values.map((y, i) => ({ x: type === 'scatter' ? i + 1 : weekdays[i]!, y }));\n    const r = chart(type, data, { description: 'Collected every day.' });\n    r.frames();\n    expect(codes(r).sort()).toEqual(['AX102', 'AX103', 'AX106']);\n    const note = 'Values not shown: 3. See table.';\n    expect(lastModel(r).note).toBe(note);\n    expect(lastModel(r).summary).toContain(note);\n    expect(lastModel(r).summary).toContain('Collected every day.');\n    expect(committed(r).reader.note).toBe(note);\n    expect(r.announcements).toEqual([]);\n    if (type === 'line' || type === 'area') {\n      expect(pathRuns(marks(r, 'path')[0]!.xy).map(run => run.length)).toEqual([2]);\n      expect(marks(r, 'points').some(mark => mark.xy.length >= 2)).toBe(true);\n    } else if (type === 'bar') {\n      expect(marks(r, 'rects').find(mark => mark.variant === 'bar')?.xywh).toHaveLength(12);\n      expect(marks(r, 'rects').find(mark => mark.variant === 'missing')?.xywh).toHaveLength(16);\n    } else if (type === 'scatter') expect(marks(r, 'points')[0]?.xy).toHaveLength(6);\n    else expect(marks(r, 'arcs')[0]?.angles).toHaveLength(6);\n    if (type !== 'scatter') {\n      expect(rows(r).map(row => row[1])).toEqual(['10', '20', 'No data', 'No data', 'No data', 'No data', '70']);\n      if (type !== 'donut') expect(at(r, 4).rows[0]?.value).toBe('No data');\n      else expect(reading(r, walk(r)[4]!)).toContain('No data');\n    }\n    r.controller.handle.update({ data: [{ x: type === 'scatter' ? 1 : 'Mon', y: 10 }, { x: type === 'scatter' ? 2 : 'Tue', y: 20 }] });\n    r.frames();\n    expect(lastModel(r).note).toBeNull();\n    expect(lastModel(r).summary).not.toContain(note);\n  });\n\n  it(`F12 ${type}: a throwing formatter discloses changed presentation even though the value is still drawn`, () => {\n    const input = [{ x: type === 'donut' ? 'A' : 1, y: 1 }, { x: type === 'donut' ? 'B' : 2, y: 2 }];\n    const r = chart(type, input, {\n      [type === 'donut' ? 'value' : 'y']: { field: 'y', format: (value: number) => {\n        if (value === 2) throw new Error('fixture');\n        return String(value);\n      } },\n    });\n    r.frames();\n    expect(codes(r)).toEqual(['AX160']);\n    const note = 'Values shown differently from the data: 1. See table.';\n    expect(lastModel(r).note).toBe(note);\n    expect(lastModel(r).summary).toContain(note);\n    expect(rows(r).map(row => row[type === 'scatter' ? 2 : 1])).toEqual(['1', '2']);\n  });\n}\nimport { expect, it } from 'vitest';\nimport { validate } from '../../src/index';\nimport type { ChartKind } from '../../src/core/controller';\nimport type { Diagnostic } from '../../src/public';\nimport { at, chart, codes, committed, lastModel, marks, rows, scene, types, type Recording, type Type } from './model';\n\nconst validateOptions = validate as (type: ChartKind, options: unknown) => Diagnostic[];\nconst input = (type: Type) => type === 'donut' ? [{ x: 'A', y: 6 }, { x: 'B', y: 8 }] : [{ x: 1, y: 6 }, { x: 2, y: 8 }];\nconst kindFor = (type: Type) => type === 'compact' ? 'line' : type;\nconst encodingFor = (type: Type) => type === 'donut' ? 'value' : 'y';\nconst valueColumn = (type: Type) => type === 'scatter' ? 2 : 1;\n\nfunction checkValues(r: Recording, type: Type, expected: readonly string[]) {\n  if (type === 'compact') {\n    expect(lastModel(r).summary).toContain('last ' + expected.at(-1));\n  } else {\n    expect(rows(r).map(row => row[valueColumn(type)])).toEqual(expected);\n  }\n}\n\nfor (const type of types) {\n  it(`DX2 ${type}: supported row and column forms draw the same fixture and preserve caller row indexes in diagnostics`, () => {\n    const donut = type === 'donut';\n    const xs = donut ? ['A', 'B', 'C'] : [1, 2, 3];\n    const wide = [{ x: xs[0], y: 6 }, { x: xs[1], y: Infinity }, { x: xs[2], y: 8 }];\n    const columns = { columns: { x: donut ? xs : new Float64Array(xs as number[]), y: new Float32Array([6, Infinity, 8]) } };\n    const long = wide.map(row => ({ ...row, s: 'y' }));\n    const data = [chart(type, wide), chart(type, columns)];\n    if (!donut) data.push(chart(type, long, { series: 's' }));\n    if (!donut && type !== 'scatter') data.push(chart(type, wide, { y: ['y'] }));\n    for (const r of data) {\n      r.frames();\n      expect(r.controller.handle.diagnostics).toMatchObject([{ code: 'AX103', field: 'y', rows: [1] }]);\n      expect(lastModel(r).summary).toContain('Values not shown: 1.');\n      const expected = type === 'scatter' ? ['6', '8'] : ['6', 'No data', '8'];\n      checkValues(r, type, expected);\n    }\n    for (const r of data.slice(1)) expect(scene(r)).toEqual(scene(data[0]!));\n  });\n\n  it(`DX3 ${type}: untyped misspelled fields, strings mixed with numbers and inapplicable keys report their codes`, () => {\n    const encoding = encodingFor(type);\n    const data = input(type);\n    const misspelled = chart(type, data, { [encoding]: 'wrong' });\n    expect(codes(misspelled)).toEqual(['AX101']);\n    misspelled.frames();\n    expect(lastModel(misspelled).message).toBe('The chart could not be drawn.');\n    const mixed = chart(type, [data[0], { ...data[1], y: 'oops' }]);\n    expect(codes(mixed)).toEqual(['AX106']);\n    mixed.frames();\n    expect(lastModel(mixed).summary).toContain('Values not shown: 1.');\n    const unsupported = chart(type, data, type === 'bar' ? { stacked: true } : { horizontal: true });\n    expect(codes(unsupported)).toEqual(['AX150']);\n    unsupported.frames();\n    expect(lastModel(unsupported).message).toBeNull();\n    checkValues(unsupported, type, ['6', '8']);\n  });\n\n  it(`DX4 ${type}: reports one field, caller row index, chart name and a fix synchronously`, () => {\n    const received: Diagnostic[] = [];\n    const r = chart(type, [...input(type), { x: type === 'donut' ? 'C' : 3, y: Infinity }], {\n      onDiagnostic: (d: Diagnostic) => received.push(d),\n    });\n    expect(received).toMatchObject([{\n      code: 'AX103', level: 'warning', chart: 'Measurements', field: 'y', rows: [2],\n      message: expect.stringMatching(/y.*row 2.*check the calculation.*send null/i),\n    }]);\n    r.frames();\n    r.frames();\n    expect(received).toHaveLength(1);\n    expect(r.printed.filter(message => message.includes('AX103'))).toHaveLength(1);\n    expect(lastModel(r).summary).toContain('Values not shown: 1.');\n  });\n\n  it(`DX5 ${type}: replace then append then zoom in one turn switches marks, text and lookup together`, () => {\n    const donut = type === 'donut';\n    const r = chart(type, input(type));\n    r.frames();\n    const before = committed(r);\n    const oldScene = scene(r);\n    const oldText = r.texts.at(-1);\n    const count = r.commits;\n    const handle = r.controller.handle;\n    handle.update({ data: [{ x: donut ? 'C' : 10, y: 21 }, { x: donut ? 'D' : 20, y: 35 }] });\n    handle.append([{ x: donut ? 'E' : 30, y: 72 }]);\n    handle.zoom([20, 30]);\n    expect(r.committed).toBe(before);\n    expect(scene(r)).toBe(oldScene);\n    expect(r.texts.at(-1)).toBe(oldText);\n    expect(lastModel(r).summary).not.toContain('72');\n    expect(r.frames()).toBe(1);\n    expect(r.commits).toBe(count + 1);\n    expect(scene(r)).not.toEqual(oldScene);\n    expect(lastModel(r).summary).toContain('72');\n    checkValues(r, type, donut || type === 'compact' ? ['21', '35', '72'] : ['35', '72']);\n    if (type !== 'compact') expect(committed(r).lookup.count).toBe(donut ? 3 : 2);\n    if (!donut && type !== 'compact') expect(r.texts.at(-1)).not.toEqual(oldText);\n  });\n\n  it(`DX5 ${type}: a present patch key replaces the whole field, undefined restores the default, and absent keys stay`, () => {\n    const key = encodingFor(type);\n    const r = chart(type, input(type), { [key]: { field: 'y', unit: 'old unit' }, title: 'Retained', table: false });\n    r.frames();\n    expect(lastModel(r).summary).toContain('8 old unit');\n    expect(committed(r).reader.table).toBeNull();\n    r.controller.handle.update({ [key]: { field: 'y', label: 'Measure' }, table: undefined });\n    r.frames();\n    expect(lastModel(r).summary).not.toContain('old unit');\n    expect(lastModel(r).title?.text).toBe('Retained');\n    checkValues(r, type, ['6', '8']);\n    if (type !== 'compact') expect(committed(r).reader.table?.headers).toContain('Measure');\n  });\n\n  it(`DX5 ${type}: strict create, update and append reject warnings synchronously and keep the last valid chart`, () => {\n    const bad = { x: type === 'donut' ? 'C' : 3, y: Infinity };\n    expect(() => chart(type, [...input(type), bad], { strict: true }, { console: false })).toThrow(/AX103/);\n    const r = chart(type, input(type), { strict: true }, { console: false });\n    const handle = r.controller.handle;\n    r.frames();\n    const before = committed(r);\n    const drawn = scene(r);\n    expect(() => handle.update({ data: [...input(type), bad] })).toThrow(/AX103/);\n    expect(() => handle.append([bad])).toThrow(/AX103/);\n    expect(codes(r)).toEqual([]);\n    expect(r.committed).toBe(before);\n    r.frames();\n    expect(scene(r)).toBe(drawn);\n    handle.append([{ ...bad, y: 10 }]);\n    r.frames();\n    checkValues(r, type, ['6', '8', '10']);\n  });\n\n  it(`DX5 ${type}: destroy cancels the pending frame and later calls have no effect`, () => {\n    const r = chart(type, input(type));\n    const handle = r.controller.handle;\n    expect('resize' in handle).toBe(false);\n    handle.destroy();\n    handle.update({ title: 'Late' });\n    handle.append(input(type));\n    handle.zoom([1, 2]);\n    handle.destroy();\n    expect(r.disposed).toBe(1);\n    expect(r.frames()).toBe(0);\n    expect(r.draws).toEqual([]);\n    expect(r.texts).toEqual([]);\n    expect(r.models).toEqual([]);\n    expect(r.committed).toBeNull();\n  });\n\n  it(`DX8 ${type}: Node import and validate give the same call-time diagnostics as the controller`, () => {\n    expect(typeof document).toBe('undefined');\n    const end = [...input(type), { x: type === 'donut' ? 'C' : 3, y: NaN }];\n    const options = {\n      title: 'Measurements', data: end, ...(type === 'donut' ? { label: 'x', value: 'y' } : { x: 'x', y: 'y' }),\n      ...(type === 'compact' ? { compact: true } : {}),\n    };\n    const r = chart(type, end);\n    const found = validateOptions(kindFor(type), options);\n    expect(found).toMatchObject([{ code: 'AX103', field: 'y', rows: [2], chart: 'Measurements' }]);\n    expect(found).toEqual(r.controller.handle.diagnostics);\n    expect(r.draws).toEqual([]);\n  });\n\n  it(`DX6 ${type}: a named color reaches the theme by series key as other entries change`, () => {\n    const donut = type === 'donut';\n    const target = donut ? 'B' : 'North';\n    const colors = { [target]: 'rebeccapurple' };\n    const data = donut ? [{ x: 'A', y: 4 }, { x: 'B', y: 6 }] :\n      [{ x: 1, y: 4, s: 'South' }, { x: 1, y: 6, s: 'North' }, { x: 2, y: 7, s: 'North' }];\n    const r = chart(type, data, { colors, ...(donut ? {} : { series: 's' }) });\n    r.frames();\n    expect(r.themeCalls.at(-1)).toEqual({ keys: donut ? ['A', 'B'] : ['South', 'North'], colors });\n    r.controller.handle.update({ data: data.filter(row => 's' in row ? row.s === target : row.x === target) });\n    r.frames();\n    expect(r.themeCalls.at(-1)).toEqual({ keys: [target], colors });\n    const painted = donut ? marks(r, 'arcs')[0]?.fills[0] : type === 'bar' ? marks(r, 'rects')[0]?.fill :\n      type === 'scatter' ? marks(r, 'points')[0]?.fill : marks(r, 'path')[0]?.stroke;\n    expect(painted).toEqual({ kind: 'series', index: 0 });\n    if (!donut && type !== 'scatter' && type !== 'compact') expect(at(r, 1).rows[0]?.seriesLabel).toBe(target);\n  });\n}\n\nit('DX3 line: untyped wide y combined with series raises AX150 and still reads the wide field', () => {\n  const r = chart('line', [{ x: 1, y: 4, s: 'Named' }, { x: 2, y: 8, s: 'Named' }], { y: ['y'], series: 's' });\n  expect(codes(r)).toEqual(['AX150']);\n  r.frames();\n  expect(at(r, 1).rows.map(row => [row.seriesLabel, row.value])).toEqual([['y', '4']]);\n});\n\nfor (const type of types) {\n  it(`DX5 ${type}: a strict field error is synchronous and the accepted title, marks and reader survive it`, () => {\n    const r = chart(type, input(type), { strict: true });\n    r.frames();\n    const before = scene(r);\n    expect(() => r.controller.handle.update({ title: 'Rejected', [encodingFor(type)]: 'doesNotExist' })).toThrow(/AX101/);\n    expect(r.frames()).toBe(0);\n    expect(scene(r)).toBe(before);\n    expect(lastModel(r).title?.text).toBe('Measurements');\n    checkValues(r, type, ['6', '8']);\n  });\n}\nimport fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { aligned, at, axes, chart, codes, committed, date, expectCompact, expectGeometry, expectValues, lastModel, marks, pathRuns, pixel, points, reading, rows, walk } from './model';\n\nconst observations = [\n  { x: '2024-02-24', y: 6 },\n  { x: '2024-02-25', y: 8 },\n  { x: '2024-02-26', y: null },\n  { x: '2024-02-27', y: 5 },\n  { x: '2024-02-28' },\n  { x: '2024-03-01', y: 0 },\n  { x: '2024-03-02', y: 7 },\n];\n\nfor (const kind of aligned) {\n  for (const compact of [false, true]) {\n    const type = compact ? 'compact' : kind;\n    it(`F2 ${type}: ${kind} distinguishes null, absent field, absent date and zero in geometry and reader text`, () => {\n      const r = chart(type, observations, {}, undefined, kind);\n      r.frames();\n      expect(codes(r).sort()).toEqual(['AX102', 'AX105']);\n      const { x, y } = axes(r);\n      if (kind === 'bar') {\n        const [filled, missing] = marks(r, 'rects');\n        expect(filled?.variant).toBe('bar');\n        expect(missing?.variant).toBe('missing');\n        expect(filled?.xywh).toHaveLength(5 * 4);\n        expect(missing?.xywh).toHaveLength(3 * 4);\n        expectGeometry([filled!.xywh[13]!, filled!.xywh[15]!], [y.map(0), 0]);\n        const missingCenters = [0, 4, 8].map(i => missing!.xywh[i]! + missing!.xywh[i + 2]! / 2);\n        expectGeometry(missingCenters, [2, 4, 5].map(i => pixel(x, date(i))));\n        expectGeometry([1, 5, 9].map(i => missing!.xywh[i]!), [y.map(0), y.map(0), y.map(0)]);\n      } else {\n        const expectedRuns = [[0, 1], [6, 7]];\n        const stroke = marks(r, 'path')[0]!;\n        expect(pathRuns(stroke.xy)).toHaveLength(expectedRuns.length);\n        pathRuns(stroke.xy).forEach((run, i) => expectGeometry(run.map(p => p[0]), expectedRuns[i]!.map(j => pixel(x, date(j)))));\n        expect(marks(r, 'points').flatMap(mark => points(mark.xy)).some(p => Math.abs(p[0] - pixel(x, date(3))) < 0.001)).toBe(true);\n        if (kind === 'area') {\n          const area = marks(r, 'area')[0]!;\n          expect(Array.from(area.runs).filter((_, i) => i % 4 === 1)).toEqual([2, 2]);\n        }\n      }\n      expect(lastModel(r).summary).toContain('minimum 0, maximum 8, last 7');\n      expect(lastModel(r).summary).toContain('Values not shown: 1.');\n      if (compact) expectCompact(r);\n      else {\n        expect(lastModel(r).note).toBe('Values not shown: 1. See table.');\n        const values = ['6', '8', 'No data', '5', 'No data', 'No data', '0', '7'];\n        expect(rows(r).map(row => row[1])).toEqual(values);\n        values.forEach((value, i) => expectValues(r, date(i), [value]));\n      }\n    });\n\n    it(`F2 ${type}: ${kind} missing zero makes the requested count gaps ordinary zero values`, () => {\n      const r = chart(type, observations, { y: { field: 'y', missing: 'zero' } }, undefined, kind);\n      r.frames();\n      expect(lastModel(r).summary).toContain('minimum 0, maximum 8, last 7');\n      const { y } = axes(r);\n      if (kind === 'bar') {\n        const bars = marks(r, 'rects');\n        expect(bars).toHaveLength(1);\n        expect(bars[0]?.xywh).toHaveLength(32);\n        expectGeometry([2, 4, 5, 6].map(i => bars[0]!.xywh[4 * i + 3]!), [0, 0, 0, 0]);\n      } else {\n        const runs = pathRuns(marks(r, 'path')[0]!.xy);\n        expect(runs.map(run => run.length)).toEqual([8]);\n        expectGeometry([2, 4, 5, 6].map(i => runs[0]![i]![1]), [y.map(0), y.map(0), y.map(0), y.map(0)]);\n      }\n      expect(lastModel(r).summary).toContain('Values shown differently from the data: 1.');\n      if (compact) expectCompact(r);\n      else {\n        expect(lastModel(r).note).toBe('Values shown differently from the data: 1. See table.');\n        expect(rows(r).map(row => row[1])).toEqual(['6', '8', '0', '5', '0', '0', '0', '7']);\n        for (const i of [2, 4, 5, 6]) expectValues(r, date(i), ['0']);\n      }\n    });\n  }\n}\n\nfor (const type of ['line', 'area', 'compact'] as const) {\n  it(`F2 ${type}: for any generated missing index no stroke or fill run bridges it`, () => {\n    fc.assert(fc.property(fc.array(fc.option(fc.integer({ min: -8, max: 8 }), { nil: null }), { minLength: 3, maxLength: 14 }), values => {\n      const r = chart(type, values.map((y, x) => ({ x, y })), { x: { field: 'x', type: 'number' } }, undefined, type === 'compact' ? 'area' : 'line');\n      r.frames();\n      if (values.every(value => value === null)) {\n        expect(marks(r, 'path')).toEqual([]);\n        return;\n      }\n      const { x } = axes(r);\n      const indexes = (run: [number, number][]) => {\n        if (x.type === 'band') throw new Error('Expected a numeric x axis');\n        return run.map(([px]) => Math.round(x.invert(px)));\n      };\n      const strokes = marks(r, 'path').flatMap(mark => pathRuns(mark.xy));\n      const fills = marks(r, 'area').flatMap(mark => {\n        const vertices = points(mark.upper);\n        return Array.from({ length: mark.runs.length / 4 }, (_, run) => {\n          const start = mark.runs[run * 4]!;\n          return vertices.slice(start, start + mark.runs[run * 4 + 1]!);\n        });\n      });\n      for (const run of [...strokes, ...fills].map(indexes)) {\n        expect(values.slice(run[0]!, run.at(-1)! + 1)).not.toContain(null);\n      }\n    }), { numRuns: 1_000 });\n  });\n}\n\nit('F2 line: deleted daily rows and explicit nulls leave the same seven-day break', () => {\n  const data = Array.from({ length: 12 }, (_, i) => ({ x: new Date(date(i)).toISOString().slice(0, 10), y: i >= 2 && i <= 8 ? null : i }));\n  const explicit = chart('line', data);\n  const deleted = chart('line', data.filter(row => row.y !== null));\n  explicit.frames();\n  deleted.frames();\n  expect(codes(explicit)).toEqual([]);\n  expect(codes(deleted)).toContain('AX105');\n  expect(pathRuns(marks(deleted, 'path')[0]!.xy).map(run => run.length)).toEqual([2, 3]);\n  expect(marks(deleted, 'path')[0]?.xy).toEqual(marks(explicit, 'path')[0]?.xy);\n  expect(rows(deleted)).toEqual(rows(explicit));\n  expect(at(deleted, date(5)).rows[0]?.value).toBe('No data');\n});\n\nconst scatter = [{ x: 1, y: 4 }, { x: 2, y: null }, { x: 3 }, { x: 4, y: 0 }];\n\nit('F2 scatter: gaps are unplotted, zero is readable and the table says No data (reading: the table keeps omitted observations)', () => {\n  const r = chart('scatter', scatter);\n  r.frames();\n  expect(marks(r, 'points')[0]?.xy).toHaveLength(4);\n  const refs = walk(r);\n  const { lookup } = committed(r);\n  expect(refs.map(ref => lookup.datum(ref)?.value)).toEqual(['4', '0']);\n  expect(reading(r, refs[1]!)).toContain('0');\n  expect(lastModel(r).summary).toContain('minimum 0, maximum 4, last 0');\n  expect(rows(r).map(row => row[2])).toEqual(['4', 'No data', 'No data', '0']);\n});\n\nit('F2 scatter: missing zero draws two imputed zero points and exposes all four observations', () => {\n  const r = chart('scatter', scatter, { y: { field: 'y', missing: 'zero' } });\n  r.frames();\n  expect(marks(r, 'points')[0]?.xy).toHaveLength(8);\n  const refs = walk(r);\n  const { lookup } = committed(r);\n  expect(refs.map(ref => lookup.datum(ref)?.value)).toEqual(['4', '0', '0', '0']);\n  expect(rows(r).map(row => row[2])).toEqual(['4', '0', '0', '0']);\n  refs.slice(1).forEach(ref => expect(reading(r, ref)).toContain('0'));\n});\n\nit('F2 donut: null and absent slices have no arc and read No data; a real zero reads 0', () => {\n  const r = chart('donut', [{ x: 'A', y: 5 }, { x: 'B', y: null }, { x: 'C' }, { x: 'D', y: 0 }]);\n  r.frames();\n  expect(codes(r)).toEqual(['AX102']);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(2);\n  const refs = walk(r);\n  expect(refs).toHaveLength(4);\n  expect(rows(r).map(row => row[1])).toEqual(['5', 'No data', 'No data', '0']);\n  refs.forEach((ref, i) => expect(reading(r, ref)).toContain(['5', 'No data', 'No data', '0'][i]!));\n  expect(lastModel(r).summary).toContain('Total 5');\n  expect(lastModel(r).note).toBe('Values not shown: 1. See table.');\n});\n\nit('F2 bar: horizontal missing marks sit at zero and real zero is a zero-width bar', () => {\n  const r = chart('bar', [{ x: 'Valid', y: 8 }, { x: 'None', y: null }, { x: 'Zero', y: 0 }], { horizontal: true });\n  r.frames();\n  const { y } = axes(r);\n  const filled = marks(r, 'rects').find(mark => mark.variant === 'bar')!;\n  const missing = marks(r, 'rects').find(mark => mark.variant === 'missing')!;\n  expect(filled.xywh).toHaveLength(8);\n  expect(missing.xywh).toHaveLength(4);\n  expectGeometry([filled.xywh[4]!, filled.xywh[6]!, missing.xywh[0]!, missing.xywh[2]!], [y.map(0), 0, y.map(0), 0]);\n  expectValues(r, 1, ['No data']);\n  expectValues(r, 2, ['0']);\n  expect(rows(r)).toEqual([['Valid', '8'], ['None', 'No data'], ['Zero', '0']]);\n});\n\nit('F2 donut: missing zero makes null and absent counts readable as zero without drawing their arcs', () => {\n  const r = chart('donut', [{ x: 'A', y: 6 }, { x: 'B', y: null }, { x: 'C' }, { x: 'D', y: 0 }], {\n    value: { field: 'y', missing: 'zero' },\n  });\n  r.frames();\n  expect(codes(r)).toEqual(['AX102']);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(2);\n  const { lookup } = committed(r);\n  const zeros = walk(r).slice(1);\n  expect(zeros).toHaveLength(3);\n  for (const ref of zeros) {\n    if (ref.kind !== 'slice') throw new Error('Expected a slice');\n    expect(lookup.tooltip(ref).rows[0]).toMatchObject({ value: '0', percent: '0%' });\n    expect(reading(r, ref)).toContain('0 (0%)');\n  }\n  expect(rows(r).map(row => row[1])).toEqual(['6', '0', '0', '0']);\n  expect(lastModel(r).summary).toContain('Total 6');\n});\nimport { defineConfig } from 'vitest/config';\n\n// Unit and property tests run in Node. Browser tests (*.browser.test.ts) drive system Chrome through\n// Playwright against the built bundle: run `npm run build` first, then `npm run test:browser`.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    include: process.env.AXYLO_BROWSER\n      ? ['packages/*/test/**/*.browser.test.ts', 'apps/docs/test/**/*.browser.test.ts', 'apps/docs/examples/node/*.test.ts']\n      : ['packages/*/test/**/*.test.ts', 'apps/docs/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 10000,\n    fileParallelism: !process.env.AXYLO_BROWSER,\n  },\n});\nimport { defineConfig } from 'vitest/config';\nimport path from 'node:path';\n\n// Tests of the packed distribution (plan M7). They need a built packages/*/dist; the global setup packs it\n// (scripts/pack.mjs --no-build) and installs the tarballs into tests/dist/fixtures before any test runs, so\n// every run tests exactly what `npm pack` produces from the dist at that moment. Browser tests\n// (*.browser.test.ts) are selected with AXYLO_BROWSER=1, as in the root config.\nconst browser = !!process.env.AXYLO_BROWSER;\nexport default defineConfig({\n  root: path.resolve(import.meta.dirname, '../..'),\n  test: {\n    include: browser ? ['tests/dist/**/*.browser.test.ts'] : ['tests/dist/**/*.test.ts'],\n    exclude: ['**/node_modules/**', 'tests/dist/fixtures/**', 'tests/dist/.packed/**', ...(browser ? [] : ['**/*.browser.test.ts'])],\n    globalSetup: ['tests/dist/setup.ts'],\n    testTimeout: browser ? 60000 : 30000,\n    hookTimeout: 120000,\n    fileParallelism: !browser,\n  },\n});\nbrowser.json\ndist-browser.json\ndist.json\nunit.json\n","exit_code":0,"status":"completed"}}
