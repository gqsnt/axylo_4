  let state: SlotState = SLOT_VALUE;\n    if (typeof raw === 'number') {\n      if (Number.isFinite(raw)) value = raw;\n      else if (Number.isNaN(raw) && (column || table.isColumnRow(i))) state = SLOT_NULL;\n      else {\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n      }\n    } else if (raw === undefined) {\n      state = SLOT_ABSENT_FIELD;\n      reports.add('AX102', zero ? 'changed' : 'omitted', startRow + table.rowIndex(i), undefined, undefined,\n        { outcome: zero ? undefined : outcome });\n    } else if (raw === null || raw === '') {\n      state = SLOT_NULL;\n    } else if (mode === 'decimal') {\n      value = Number(raw);\n      if (!Number.isFinite(value)) {\n        value = NaN;\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n      }\n      if (field.parse !== 'number') reports.add('AX104', 'none', startRow + table.rowIndex(i));\n    } else {\n      state = SLOT_INVALID;\n      reports.add('AX106', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n    }\n    if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) value = 0;\n    if (y === column && !Object.is(y[i], value)) {\n      // Infinity and explicit zero imputation cannot be represented by an unchanged borrowed view.\n      y = y.slice();\n    }\n    if (y !== column) y[i] = value;\n    slot[i] = state;\n  }\n\n  reports.flush(sink);\n  return { y, slot };\n}\nimport { expect } from 'vitest';\nimport type { ChartKind } from '../../src/core/controller';\nimport type { DatumRef, Layout, Mark, TooltipModel, XScale } from '../../src/core/contracts';\nimport { valueText } from '../../src/core/focus';\nimport { lastModel, record, type HostOptions, type Recording } from '../core/host';\n\nexport { lastModel, record, type Recording };\nexport const types = ['line', 'area', 'bar', 'scatter', 'donut', 'compact'] as const;\nexport const aligned = ['line', 'area', 'bar'] as const;\nexport type Type = typeof types[number];\nexport const day = 86_400_000;\nexport const date = (offset: number) => Date.UTC(2024, 1, 24) + offset * day;\n\nexport function chart(type: Type, data: unknown, options: Record<string, unknown> = {}, host?: HostOptions, compactKind: typeof aligned[number] = 'line') {\n  const encoding = type === 'donut' ? { label: 'x', value: 'y' } : { x: 'x', y: 'y' };\n  const kind: ChartKind = type === 'compact' ? compactKind : type;\n  return record(kind, { title: 'Measurements', locale: 'en-US', data, ...encoding, compact: type === 'compact' || undefined, ...options }, host);\n}\n\nexport function committed(r: Recording) {\n  expect(r.committed, 'frame handed to interaction').not.toBeNull();\n  return r.committed!;\n}\n\nexport function plot(r: Recording): Extract<Layout, { kind: 'plot' | 'compact' }> {\n  const layout = committed(r).layout;\n  if (layout.kind !== 'plot' && layout.kind !== 'compact') throw new Error('Expected a plot, got ' + layout.kind);\n  return layout;\n}\n\nexport function axes(r: Recording) {\n  const { projection } = plot(r);\n  if (projection.kind === 'ring') throw new Error('Expected Cartesian axes');\n  return projection.kind === 'xy' ? { x: projection.x, y: projection.y } : { x: projection.band, y: projection.value };\n}\n\nexport const pixel = (axis: XScale, x: number) => axis.type === 'band' ? axis.center(x) : axis.map(x);\nexport const codes = (r: Recording) => r.controller.handle.diagnostics.map(d => d.code);\nexport const scene = (r: Recording) => r.draws.at(-1)!;\nexport const marks = <Kind extends Mark['type']>(r: Recording, kind: Kind) =>\n  scene(r).marks.filter((mark): mark is Extract<Mark, { type: Kind }> => mark.type === kind);\nexport const rows = (r: Recording) => {\n  const table = committed(r).reader.table;\n  expect(table, 'table model handed to interaction').not.toBeNull();\n  return Array.from({ length: table!.rowCount }, (_, i) => table!.row(i)!);\n};\n\nexport function walk(r: Recording, limit = 100) {\n  const { lookup } = committed(r);\n  const result: DatumRef[] = [];\n  for (let ref = lookup.step(null, 'first'); ref !== null; ref = lookup.step(ref, 'next')) {\n    if (result.length === limit) throw new Error('Keyboard walk exceeded the expected fixture length');\n    result.push(ref);\n  }\n  return result;\n}\n\nexport function reading(r: Recording, ref: DatumRef, mode: 'all' | 'single' = 'all') {\n  const { view, lookup, formatters, messages } = committed(r);\n  return valueText(view, lookup, ref, mode, formatters, messages);\n}\n\nexport function at(r: Recording, x: number): TooltipModel {\n  return committed(r).lookup.tooltip({ kind: 'x', x });\n}\n\nexport function refAt(r: Recording, x: number): DatumRef {\n  const ref = committed(r).lookup.primary({ kind: 'x', x });\n  expect(ref, 'readable datum at the fixture x').not.toBeNull();\n  return ref!;\n}\n\nexport function expectValues(r: Recording, x: number, expected: readonly string[]) {\n  const tooltip = at(r, x);\n  expect(tooltip.rows.map(row => row.value)).toEqual(expected);\n  const ref = refAt(r, x);\n  for (const value of expected) expect(reading(r, ref)).toContain(value);\n}\n\nexport function points(xy: Float32Array): [number, number][] {\n  const result: [number, number][] = [];\n  for (let i = 0; i < xy.length; i += 2) result.push([xy[i]!, xy[i + 1]!]);\n  return result;\n}\n\nexport function pathRuns(xy: Float32Array): [number, number][][] {\n  const runs: [number, number][][] = [[]];\n  for (const pair of points(xy)) {\n    if (Number.isNaN(pair[0])) runs.push([]);\n    else runs.at(-1)!.push(pair);\n  }\n  return runs.filter(run => run.length > 0);\n}\n\nexport function expectGeometry(actual: readonly number[], expected: readonly number[]) {\n  expect(actual).toHaveLength(expected.length);\n  expected.forEach((number, i) => expect(actual[i]).toBeCloseTo(number, 3));\n}\n\nexport function expectCompact(r: Recording) {\n  expect(committed(r)).toMatchObject({ interactive: false, zoom: false, reader: { table: null } });\n  expect(r.texts.at(-1)).toEqual([]);\n  expect(r.announcements).toEqual([]);\n}\n\nexport function seriesRows(size: number) {\n  return Array.from({ length: size }, (_, n) => [\n    { s: 'Series ' + n, x: 1, y: n + 1 }, { s: 'Series ' + n, x: 2, y: n + 2 },\n  ]).flat();\n}\n/**\n * A recording host for driving the chart controller in Node (the method of the core review): a manual\n * animation-frame queue, and substitutes for the figure, the renderers and the interaction layer that keep\n * what they were given. Sizes come from a small model of the figure's CSS: the plot gets what the caption\n * and the controls leave of the container.\n */\nimport type { Layout, PlacedText, Scene, TextStyle } from '../../src/core/contracts';\nimport { createController, type ChartKind, type Controller, type Host, type Size } from '../../src/core/controller';\nimport type { FigureModel } from '../../src/dom/figure';\nimport type { Committed, ControlsState } from '../../src/dom/interaction';\nimport { TOKEN_BINDINGS } from '../../src/theme';\n\nexport interface Recording {\n  readonly host: Host;\n  readonly controller: Controller;\n  /** Runs every queued animation frame (and those they queue), at most `limit` rounds. */\n  frames(limit?: number): number;\n  readonly pending: number;\n  draws: Scene[];\n  texts: (readonly PlacedText[])[];\n  models: FigureModel[];\n  announcements: string[];\n  prepared: ControlsState[];\n  committed: Committed | null;\n  commits: number;\n  clears: number;\n  themeCalls: { keys: readonly string[]; colors: Record<string, string> }[];\n  printed: string[];\n  disposed: number;\n  /** Host writes (figure, renderer, text, interaction) made after `dispose`. */\n  writesAfterDispose: number;\n  /** The last surfaces(visible) call: false while the error revision hides marks and text. */\n  surfaces: boolean;\n  /** The container (CSS px). The plot's height is what the caption and the controls leave. */\n  container: { width: number; height: number } | null;\n  /** Height of one caption line and of the controls row in the model of the figure. */\n  readonly lineHeight: number;\n  ids: Record<string, string>;\n  readonly layout: Layout | null;\n}\n\nexport interface HostOptions {\n  readonly container?: { width: number; height: number } | null;\n  readonly console?: boolean;\n}\n\nexport function record(kind: ChartKind, options: Record<string, unknown>, settings: HostOptions = {}): Recording {\n  const queue = new Map<number, (time?: number) => void>();\n  /** Animation frame time: one value per batch of callbacks, as a browser gives it. */\n  let clock = 0;\n  let handles = 0;\n  const rec = {\n    draws: [] as Scene[], texts: [] as (readonly PlacedText[])[], models: [] as FigureModel[], announcements: [] as string[],\n    prepared: [] as ControlsState[], committed: null as Committed | null, commits: 0, clears: 0,\n    themeCalls: [] as { keys: readonly string[]; colors: Record<string, string> }[], printed: [] as string[], disposed: 0,\n    writesAfterDispose: 0, surfaces: true,\n    container: settings.container === undefined ? { width: 720, height: 400 } : settings.container,\n    lineHeight: 20, ids: {} as Record<string, string>,\n  };\n  let model: FigureModel | null = null;\n  let controls: ControlsState | null = null;\n  const style: TextStyle = { font: '400 12px sans-serif', letterSpacing: 0, wordSpacing: 0, lineHeight: 15 };\n\n  /** The plot size the model figure gives: container minus caption (title, subtitle, visible summary) and controls. */\n  function plotSize(): Size | null {\n    const box = rec.container;\n    if (box === null) return null;\n    let used = 0;\n    if (model && !model.compact) {\n      if (model.title?.visible) used += rec.lineHeight;\n      if (model.subtitle) used += rec.lineHeight;\n      if (model.summaryVisible) used += 2 * rec.lineHeight;\n      if (model.note) used += rec.lineHeight;\n    }\n    if (controls && controls.interactive) {\n      // The legend and toolbar take a row; the fallback offers only the table control, which is a row too\n      // but shorter (no legend).\n      used += controls.tooSmall ? rec.lineHeight : 1.5 * rec.lineHeight;\n    }\n    return { width: box.width, height: box.height - used };\n  }\n\n  const host: Host = {\n    id: 'axylo-test',\n    console: settings.console === false ? null : {\n      warn: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n      info: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n      error: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n    },\n    page: {},\n    timeZone: 'UTC',\n    renderer: { kind: 'svg', draw: scene => { if (rec.disposed) rec.writesAfterDispose++; rec.draws.push(scene); } },\n    text: { render: texts => { if (rec.disposed) rec.writesAfterDispose++; rec.texts.push(texts); } },\n    surfaces(visible) {\n      rec.surfaces = visible;\n    },\n    figure: {\n      update(next) {\n        if (rec.disposed) rec.writesAfterDispose++;\n        const before = model;\n        model = next;\n        rec.models.push(next);\n        return before === null || before.summaryVisible !== next.summaryVisible || before.note !== next.note ||\n          before.title?.text !== next.title?.text || before.subtitle !== next.subtitle;\n      },\n      announce: text => { rec.announcements.push(text); },\n    },\n    interaction: {\n      prepare(state) {\n        const before = controls;\n        controls = state;\n        rec.prepared.push(state);\n        return before === null || before.tooSmall !== state.tooSmall || before.interactive !== state.interactive;\n      },\n      commit(state) {\n        if (rec.disposed) rec.writesAfterDispose++;\n        rec.committed = state;\n        rec.commits++;\n      },\n      clear() {\n        rec.committed = null;\n        rec.clears++;\n      },\n    },\n    measurer: { width: text => text.length * 7 },\n    requestFrame(callback) {\n      const handle = ++handles;\n      queue.set(handle, callback);\n      return handle;\n    },\n    cancelFrame(handle) {\n      queue.delete(handle);\n    },\n    locale: option => typeof option === 'string' ? option : 'en-US',\n    pageLang: () => 'en',\n    labelText: id => Object.hasOwn(rec.ids, id) ? rec.ids[id]! : null,\n    textStyle: () => style,\n    measure: plotSize,\n    devicePixelRatio: () => 1,\n    theme(keys, colors) {\n      rec.themeCalls.push({ keys: [...keys], colors });\n      const series = keys.map((_, i) => `var(--axylo-series-color-${i + 1})`);\n      const paints = { tokens: { ...TOKEN_BINDINGS }, series };\n      return {\n        bindings: { tokens: TOKEN_BINDINGS, series },\n        theme: { scheme: 'light', forcedColors: false, moreContrast: false, paints },\n        resolved: true, backdropKnown: false,\n      };\n    },\n    dispose() {\n      rec.disposed++;\n    },\n  };\n\n  const controller = createController(kind, options, host);\n  // Accessors stay accessors: `pending` and `layout` are read when asked (review 3, finding 20).\n  return Object.defineProperties(Object.assign(rec, {\n    host, controller,\n    frames(limit = 10): number {\n      let rounds = 0;\n      while (queue.size && rounds < limit) {\n        rounds++;\n        const callbacks = [...queue.values()];\n        queue.clear();\n        clock += 16;\n        for (const cb of callbacks) cb(clock);\n      }\n      return rounds;\n    },\n  }), {\n    pending: { get: () => queue.size, enumerable: true },\n    layout: { get: () => rec.committed?.layout ?? null, enumerable: true },\n  }) as unknown as Recording;\n}\n\nexport const lastModel = (r: Recording): FigureModel => r.models[r.models.length - 1]!;\nfunction describeSizes(rows, root, sources, from) {\n  const measurements = new Map();\n  for (const { row } of rows) for (const refs of Object.values(row.evidence ?? {})) for (const ref of refs) {\n    if (ref.kind === 'size') measurements.set(ref.file, sources.get(resolve(root, ref.file)).size);\n  }\n  return [...measurements].flatMap(([file, entries]) => [\n    '## Packed size measurement', '',\n    ...[...entries].map(([name, { minBytes, totalGzipBytes, targetKiB }]) =>\n      `- ${name} · ${minBytes.toLocaleString('en-US')} minified JS bytes, ${(totalGzipBytes / 1024).toFixed(2)} KiB gzipped${targetKiB === null ? ''\n        : `, ${targetKiB} KiB target`} · ${fileLink(from, root, file)}`), '',\n  ]);\n}\n\nfunction uniqueReportLabel(file, files, root) {\n  const name = file.split(sep).at(-1);\n  return files.filter(candidate => candidate.split(sep).at(-1) === name).length === 1 ? name : relative(root, file);\n}\n\nexport function check({ root, matrixFile = resolve(root, 'acceptance/matrix.json'), resultFiles = [], resultRoots = [], release = false }) {\n  root = resolve(root);\n  const expected = specIds(readFileSync(resolve(root, 'docs/02-product-spec.md'), 'utf8'));\n  const { matrix, sources } = readMatrix(root, matrixFile, expected);\n  const roots = resultRoots.map(path => resolve(root, path));\n  const reports = [...new Set(resultFiles.map(file => resolve(file)))];\n  const { index, runs } = readResults(root, roots, reports, sources);\n  const reportFiles = [...runs.map(run => run.file), ...[...sources.values()].filter(source => source.size).map(source => source.path)];\n  const counts = Object.fromEntries(statuses.map(status => [status, 0]));\n  const rows = matrix.map(row => ({\n    row,\n    cells: chartTypes.map(type => {\n      const cell = cellFor(row, type, root, sources, index);\n      counts[cell.status]++;\n      return cell;\n    }),\n  }));\n  const header = ['Criterion', 'Statement', ...chartTypes];\n  const printRow = cells => `| ${cells.map(escapeCell).join(' | ')} |`;\n  const describeCell = ({ status, reports }) => reports.size ? `${status} (${[...reports].map(([file, results]) =>\n    `${uniqueReportLabel(file, reportFiles, root)} ${[...results].sort().join('/')}`).join(', ')})` : status;\n  const table = [printRow(header), printRow(header.map(() => '---')),\n    ...rows.map(({ row, cells }) => printRow([row.id, row.statement, ...cells.map(describeCell)]))].join('\\n');\n  const summary = statuses.map(status => `- ${status} · ${counts[status]}`).join('\\n');\n  const from = resolve(root, 'acceptance');\n  const report = ['# Acceptance report', '', ...describeRuns(runs, root), ...describeSizes(rows, root, sources, from),\n    '', '## Status by chart type', '', summary, '',\n    'The matrix contains individual test citations and applicability reasons. ' + fileLink(from, root, relative(root, matrixFile)), '',\n    table, '', readerDetails(rows, root, from)].join('\\n') + '\\n';\n  return { table, summary, report, counts, exitCode: release && (counts.fail || counts.weak || counts['no evidence']) ? 1 : 0 };\n}\n\nfunction main(args) {\n  const root = fileURLToPath(new URL('..', import.meta.url));\n  const resultFiles = [];\n  const resultRoots = [];\n  let release = false;\n  for (let i = 0; i < args.length; i++) {\n    if (args[i] === '--release') {\n      release = true;\n    } else if (args[i] === '--results' || args[i] === '--roots') {\n      const option = args[i];\n      const paths = option === '--results' ? resultFiles : resultRoots;\n      const before = paths.length;\n      while (args[i + 1] && !args[i + 1].startsWith('--')) paths.push(resolve(args[++i]));\n      if (before === paths.length) throw new Error(option + ' needs at least one path');\n    } else {\n      throw new Error(`unknown argument ${args[i]} (usage: node acceptance/check.mjs [--results <file>…] [--roots <directory>…] [--release])`);\n    }\n  }\n  const result = check({ root, resultFiles, resultRoots, release });\n  writeFileSync(resolve(root, 'acceptance/report.md'), result.report);\n  console.log(`${result.table}\\n\\n${result.summary}`);\n  return result.exitCode;\n}\n\nif (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  try {\n    process.exitCode = main(process.argv.slice(2));\n  } catch (error) {\n    console.error(error.message);\n    process.exitCode = 1;\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/acceptance/{f-dense,f-time,f-format,f-stacks,f-domains}.test.ts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/acceptance/{f-dense,f-time,f-format,f-stacks,f-domains}.test.ts'","aggregated_output":"import fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { at, axes, chart, codes, committed, date, expectCompact, lastModel, marks, pathRuns, points, reading, refAt, rows } from './model';\n\ntype Sample = number | null;\n\nfunction observedRuns(values: readonly Sample[]) {\n  const result: number[][] = [];\n  let run: number[] = [];\n  values.forEach((value, index) => {\n    if (value !== null) run.push(index);\n    else if (run.length) {\n      result.push(run);\n      run = [];\n    }\n  });\n  if (run.length) result.push(run);\n  return result;\n}\n\nfunction extrema(indexes: readonly number[], column: (i: number) => number, values: readonly Sample[]) {\n  const result = new Map<number, [number, number]>();\n  for (const i of indexes) {\n    const key = column(i);\n    const value = values[i]!;\n    const bounds = result.get(key);\n    result.set(key, bounds ? [Math.min(bounds[0], value), Math.max(bounds[1], value)] : [value, value]);\n  }\n  return [...result];\n}\n\nfunction checkExtrema(r: ReturnType<typeof chart>, xy: readonly [number, number][][], values: readonly Sample[], ratio: number, from = 0, to = values.length - 1) {\n  const { x, y } = axes(r);\n  if (x.type === 'band') throw new Error('Expected a numeric projection');\n  const column = (i: number) => Math.floor(x.map(i) * ratio);\n  const expectedRuns = observedRuns(values.slice(from, to + 1)).filter(run => run.length > 1).map(run => run.map(i => i + from));\n  expect(xy).toHaveLength(expectedRuns.length);\n  xy.forEach((run, i) => {\n    const actual = run.map(([px, py]) => {\n      const index = Math.round(x.invert(px));\n      expect(py).toBeCloseTo(y.map(values[index]!), 3);\n      return index;\n    }).filter(index => index >= from && index <= to);\n    expect(extrema(actual, column, values)).toEqual(extrema(expectedRuns[i]!, column, values));\n  });\n}\n\nfor (const [type, kind] of [['line', 'line'], ['area', 'area'], ['compact', 'line'], ['compact', 'area']] as const) {\n  it(`F5 ${type}: for every generated dense ${kind} dataset the drawing keeps each run’s column extrema and its breaks`, () => {\n    const patterns = fc.array(fc.integer({ min: 1, max: 30 }), { minLength: 4, maxLength: 12 });\n    fc.assert(fc.property(patterns, fc.constantFrom(1, 2), (pattern, ratio) => {\n      const high = [9, 23, 29];\n      const values = Array.from({ length: 580 }, (_, i) => i === 262 ? null : high.includes(i) ? 67 : pattern[i % pattern.length]!);\n      const stacked = kind === 'area';\n      const base = 11;\n      const data = values.map((y, x) => ({ x, y, base }));\n      const r = chart(type, data, {\n        x: { field: 'x', domain: [0, 700] }, y: stacked ? ['base', 'y'] : 'y', stacked: stacked || undefined,\n      }, { container: { width: 245, height: 220 }, console: false }, kind);\n      r.host.devicePixelRatio = () => ratio;\n      r.frames();\n      if (stacked) {\n        const expected = values.map(value => base + (value ?? 0));\n        const band = marks(r, 'area').find(mark => mark.series === 1)!;\n        checkExtrema(r, [points(band.upper)], expected, ratio);\n      }\n      const boundary = stacked ? values.map(value => value === null ? null : base + value) : values;\n      const stroke = marks(r, 'path').find(mark => mark.series === Number(stacked) && mark.stroke.kind === 'series')!;\n      checkExtrema(r, pathRuns(stroke.xy), boundary, ratio);\n      if (type === 'compact') expectCompact(r);\n      else {\n        expectValuesAt(r, 23, '67', stacked ? '78' : null);\n        expect(lastModel(r).summary).toContain('maximum 67');\n      }\n    }), { numRuns: 1_000 });\n  });\n}\n\nfunction expectValuesAt(r: ReturnType<typeof chart>, index: number, expected: string, total: string | null) {\n  const tooltip = at(r, index);\n  expect(tooltip.rows.at(-1)?.value).toBe(expected);\n  expect(tooltip.total).toBe(total);\n  expect(committed(r).reader.table?.row(index)?.at(-1)).toBe(expected);\n  expect(reading(r, refAt(r, index))).toContain(expected);\n}\n\nit('F5 line: one outlier in one million stays drawn at DPR 1 and 2 and a dropped sample stays reachable by keyboard and table', () => {\n  const count = 1_000_000;\n  const outlier = 500_123;\n  const r = chart('line', { columns: {\n    x: Float64Array.from({ length: count }, (_, i) => i),\n    y: Float64Array.from({ length: count }, (_, i) => i === outlier ? 999 : 5),\n  } });\n  let ratio = 1;\n  r.host.devicePixelRatio = () => ratio;\n  r.frames();\n  for (const next of [1, 2]) {\n    ratio = next;\n    r.controller.invalidate.pixelRatio();\n    r.frames();\n    expect(committed(r).pixelRatio).toBe(next);\n    const { x, y } = axes(r);\n    if (x.type === 'band') throw new Error('Expected continuous x');\n    const vertices = points(marks(r, 'path')[0]!.xy);\n    const kept = new Set(vertices.map(([px]) => Math.round(x.invert(px))));\n    expect(vertices.length).toBeLessThan(4_000);\n    expect(kept.has(outlier)).toBe(true);\n    expect(Math.min(...vertices.map(p => p[1]))).toBeCloseTo(y.map(999), 3);\n    let dropped = 1;\n    while (kept.has(dropped)) dropped++;\n    const { lookup } = committed(r);\n    expect(lookup.step(refAt(r, dropped - 1), 'next')).toEqual(refAt(r, dropped));\n    expectValuesAt(r, dropped, '5', null);\n  }\n  expect(lastModel(r).summary).toContain('maximum 999');\n});\n\nit('F5 line: alternating null and valid slots produce isolated markers and no false segments', () => {\n  const r = chart('line', Array.from({ length: 800 }, (_, x) => ({ x, y: x % 2 === 0 ? 1 : null })));\n  r.frames();\n  expect(marks(r, 'path')).toEqual([]);\n  expect(marks(r, 'points')[0]?.xy).toHaveLength(800);\n  expect(at(r, 41).rows[0]?.value).toBe('No data');\n  expect(committed(r).reader.table?.row(41)?.[1]).toBe('No data');\n});\n\nit('F5 line: weekly observations connect across daily observations without inventing weekly rows', () => {\n  const data = Array.from({ length: 15 }, (_, i) => ({ x: date(i), y: 10, s: 'Daily' }));\n  data.push({ x: date(0), y: 2, s: 'Weekly' }, { x: date(7), y: 4, s: 'Weekly' }, { x: date(14), y: 3, s: 'Weekly' });\n  const r = chart('line', data, { x: { field: 'x', type: 'time' }, series: 's' });\n  r.frames();\n  const weekly = marks(r, 'path').find(mark => mark.series === 1)!;\n  expect(pathRuns(weekly.xy).map(run => run.length)).toEqual([3]);\n  expect(at(r, date(3)).rows.map(row => row.value)).toEqual(['10', 'No observation']);\n  expect(rows(r)[3]?.[2]).toBe('No observation');\n});\n\nfor (const type of ['line', 'area'] as const) {\n  it(`T-dense-${type} ${type}: two peaks and their gap survive at two zoom levels and two device-pixel ratios`, () => {\n    const values = Array.from({ length: 900 }, (_, i) => i === 250 ? null : i === 249 ? 29 : i === 251 ? 31 : 3);\n    const r = chart(type, values.map((y, x) => ({ x, y })), {}, { container: { width: 245, height: 220 } });\n    let ratio = 1;\n    r.host.devicePixelRatio = () => ratio;\n    r.frames();\n    for (const [from, to, dpr] of [[0, 899, 1], [110, 760, 2]] as const) {\n      ratio = dpr;\n      r.controller.invalidate.pixelRatio();\n      r.controller.handle.zoom([from, to]);\n      r.frames();\n      checkExtrema(r, pathRuns(marks(r, 'path')[0]!.xy), values, ratio, from, to);\n      expect(at(r, 250).rows[0]?.value).toBe('No data');\n      expect(at(r, 249).rows[0]?.value).toBe('29');\n      expect(at(r, 251).rows[0]?.value).toBe('31');\n    }\n  });\n}\n\nit('T-dense-bar bar: more bars than pixels raises AX132 and every rectangle is still drawn', () => {\n  const r = chart('bar', Array.from({ length: 375 }, (_, i) => ({ x: 'Band ' + i, y: 1 })), {}, { container: { width: 240, height: 240 } });\n  r.frames();\n  expect(codes(r)).toContain('AX132');\n  expect(marks(r, 'rects')[0]?.xywh).toHaveLength(375 * 4);\n  expect(committed(r).reader.table?.rowCount).toBe(375);\n});\n\nit('T-dense-donut donut: eight small positive slices retain all eight arcs', () => {\n  const r = chart('donut', Array.from({ length: 8 }, (_, i) => ({ x: 'Band ' + i, y: i === 0 ? 100_000 : 1 })));\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(16);\n  expect(committed(r).reader.table?.rowCount).toBe(8);\n});\n\nit('T-dense-scatter scatter: the hint starts above 50,000 points and none are simplified away', () => {\n  for (const length of [50_000, 50_001]) {\n    const r = chart('scatter', { columns: { x: Float64Array.from({ length }, (_, i) => i), y: new Float32Array(length).fill(4) } });\n    r.frames();\n    expect(codes(r)).toEqual(length > 50_000 ? ['AX133'] : []);\n    expect(marks(r, 'points')[0]?.xy).toHaveLength(length * 2);\n    expect(committed(r).reader.table?.rowCount).toBe(length);\n  }\n});\n\nit('F5 line: two peaks separated by a null in one device column remain in separate drawn runs', () => {\n  const values = Array.from({ length: 700 }, (_, i) => i === 250 ? null : i === 249 ? 29 : i === 251 ? 31 : 3);\n  const r = chart('line', values.map((y, x) => ({ x, y })), { x: { field: 'x', domain: [0, 500_000] } });\n  r.frames();\n  const { x } = axes(r);\n  if (x.type === 'band') throw new Error('Expected continuous x');\n  const columns = [249, 250, 251].map(sample => Math.floor(x.map(sample)));\n  expect(new Set(columns).size).toBe(1);\n  const runs = pathRuns(marks(r, 'path')[0]!.xy);\n  checkExtrema(r, runs, values, 1);\n  expect(runs.map(run => Math.round(x.invert(run[0]![0])))).toEqual([0, 251]);\n  expect(runs.map(run => Math.round(x.invert(run.at(-1)![0])))).toEqual([249, 699]);\n  expectValuesAt(r, 249, '29', null);\n  expectValuesAt(r, 251, '31', null);\n});\nimport { expect, it } from 'vitest';\nimport { at, axes, chart, codes, committed, expectCompact, lastModel, marks, pixel, points, reading, rows, walk, type Type } from './model';\n\nconst zones = ['UTC', 'America/Los_Angeles', 'Asia/Kolkata'] as const;\nconst instant = Date.UTC(2024, 1, 29);\nconst following = Date.UTC(2024, 2, 1);\nconst dates = ['2024-02-29', '2024-03-01'];\nconst instants = [\n  ['Feb 29, 2024, 12:00 AM UTC', 'Mar 1, 2024, 12:00 AM UTC'],\n  ['Feb 28, 2024, 4:00 PM PST', 'Feb 29, 2024, 4:00 PM PST'],\n  ['Feb 29, 2024, 5:30 AM GMT+5:30', 'Mar 1, 2024, 5:30 AM GMT+5:30'],\n] as const;\n\nfunction check(r: ReturnType<typeof chart>, type: Type, positions: readonly number[], text: readonly string[]) {\n  const x = axes(r).x;\n  expect(x.type).toBe('time');\n  const pixels = positions.map(value => pixel(x, value));\n  const actual = type === 'bar'\n    ? [0, 4].map(i => marks(r, 'rects')[0]!.xywh[i]! + marks(r, 'rects')[0]!.xywh[i + 2]! / 2)\n    : points(type === 'scatter' ? marks(r, 'points')[0]!.xy : marks(r, 'path')[0]!.xy).map(p => p[0]);\n  expect(actual).toHaveLength(pixels.length);\n  pixels.forEach((expected, i) => expect(actual[i]).toBeCloseTo(expected, 3));\n  text.forEach(heading => expect(lastModel(r).summary).toContain(heading));\n  expect(lastModel(r).note ?? '').not.toMatch(/values (not shown|shown differently)/i);\n  if (type === 'compact') expectCompact(r);\n  else {\n    expect(rows(r).map(row => row[0]?.replaceAll('\\u202f', ' '))).toEqual(text);\n    const { lookup } = committed(r);\n    walk(r).forEach((ref, i) => {\n      const heading = type === 'scatter'\n        ? lookup.tooltip({ kind: 'point', refs: [ref], count: 1 }).title\n        : at(r, positions[i]!).title;\n      expect(heading.replaceAll('\\u202f', ' ')).toBe(text[i]);\n      expect(reading(r, ref)?.replaceAll('\\u202f', ' ')).toContain(text[i]);\n    });\n  }\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F4 ${type}: calendar days, months and years keep their input precision across time zones (reading: month and year inputs keep their granularity)`, () => {\n    for (const timeZone of zones) {\n      const r = chart(type, dates.map((x, i) => ({ x, y: i + 2 })), { x: { field: 'x', timeZone } });\n      r.frames();\n      check(r, type, [instant, following], ['Feb 29, 2024', 'Mar 1, 2024']);\n      expect(codes(r)).toEqual([]);\n      expect(lastModel(r).summary).not.toContain(timeZone);\n    }\n    for (const [values, expected, positions] of [\n      [['2024-02', '2024-03'], ['Feb 2024', 'Mar 2024'], [Date.UTC(2024, 1, 1), Date.UTC(2024, 2, 1)]],\n      [['2024', '2025'], ['2024', '2025'], [Date.UTC(2024, 0, 1), Date.UTC(2025, 0, 1)]],\n    ] as const) {\n      const r = chart(type, values.map((x, i) => ({ x, y: i + 2 })), { x: { field: 'x', timeZone: zones[1] } });\n      r.frames();\n      check(r, type, positions, expected);\n    }\n  });\n\n  for (const form of ['ISO with offset', 'Date objects', 'declared epoch milliseconds'] as const) {\n    it(`F4 ${type}: ${form} read in three local times, name the zone and raise AX111 for whole days (reading: Intl zone aliases name the same zone)`, () => {\n      const values = form === 'ISO with offset' ? ['2024-02-29T05:30:00+05:30', '2024-03-01T00:00:00Z']\n        : form === 'Date objects' ? [new Date(instant), new Date(following)] : [instant, following];\n      zones.forEach((timeZone, i) => {\n        const r = chart(type, values.map((x, i) => ({ x, y: i + 2 })), {\n          x: { field: 'x', timeZone, type: form === 'declared epoch milliseconds' ? 'time' : undefined },\n        }, { container: { width: 1600, height: 400 } });\n        r.frames();\n        expect(codes(r).filter(code => code !== 'AX143')).toEqual(['AX111']);\n        check(r, type, [instant, following], instants[i]!);\n        expect(lastModel(r).summary).toContain('Times are shown in ' + new Intl.DateTimeFormat('en-US', { timeZone }).resolvedOptions().timeZone + '.');\n      });\n    });\n  }\n\n  it(`F4 ${type}: DST spring skips an hour and fall repeats it with distinct zone abbreviations`, () => {\n    for (const [a, b, expected] of [\n      [Date.UTC(2024, 2, 10, 9, 30), Date.UTC(2024, 2, 10, 10, 30), ['Mar 10, 2024, 1:30 AM PST', 'Mar 10, 2024, 3:30 AM PDT']],\n      [Date.UTC(2024, 10, 3, 8, 30), Date.UTC(2024, 10, 3, 9, 30), ['Nov 3, 2024, 1:30 AM PDT', 'Nov 3, 2024, 1:30 AM PST']],\n    ] as const) {\n      const r = chart(type, [{ x: a, y: 3 }, { x: b, y: 4 }], { x: { field: 'x', type: 'time', timeZone: zones[1] } });\n      r.frames();\n      check(r, type, [a, b], expected);\n    }\n  });\n\n  it(`F4 ${type}: wall-clock input stays as written through a DST transition and raises AX112`, () => {\n    const a = Date.UTC(2024, 2, 10, 2, 30);\n    const b = Date.UTC(2024, 2, 10, 3, 30);\n    const r = chart(type, [{ x: '2024-03-10T02:30', y: 3 }, { x: '2024-03-10T03:30', y: 4 }], { x: { field: 'x', timeZone: zones[1] } });\n    r.frames();\n    expect(codes(r)).toEqual(['AX112']);\n    check(r, type, [a, b], ['Mar 10, 2024, 2:30 AM', 'Mar 10, 2024, 3:30 AM']);\n    expect(lastModel(r).summary).not.toContain(zones[1]);\n  });\n\n  it(`F4 ${type}: an impossible date is omitted, and bare epoch-like numbers remain numbers`, () => {\n    const bad = chart(type, [{ x: dates[0], y: 3 }, { x: '2024-02-30', y: 99 }, { x: dates[1], y: 4 }], { x: { field: 'x', type: 'date' } });\n    bad.frames();\n    expect(codes(bad)).toEqual(['AX107']);\n    expect(lastModel(bad).summary).toContain('maximum 4');\n    expect(lastModel(bad).summary).toContain('Values not shown: 1.');\n    if (type !== 'compact') expect(rows(bad).map(row => row[0])).toEqual(['Feb 29, 2024', 'Mar 1, 2024']);\n    const bare = chart(type, [{ x: instant, y: 3 }, { x: following, y: 4 }]);\n    bare.frames();\n    expect(codes(bare)).toEqual(['AX109']);\n    expect(axes(bare).x.type).toBe('linear');\n    expect(lastModel(bare).summary).toContain('1,709,164,800,000');\n    if (type !== 'compact') expect(rows(bare)[0]?.[0]).toBe('1,709,164,800,000');\n  });\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F4 ${type}: declaring an instant column as date keeps its UTC calendar dates in every zone`, () => {\n    for (const timeZone of zones) {\n      const r = chart(type, [\n        { x: new Date(instant), y: 3 }, { x: following, y: 4 },\n      ], { x: { field: 'x', type: 'date', timeZone } });\n      r.frames();\n      expect(codes(r)).toEqual([]);\n      check(r, type, [instant, following], ['Feb 29, 2024', 'Mar 1, 2024']);\n    }\n  });\n\n  it(`F4 ${type}: mixing calendar dates with a wall time and an instant reports both incompatible rows (reading: a clear majority fixes the axis type)`, () => {\n    const r = chart(type, [\n      { x: '2024-02-29', y: 3 }, { x: '2024-03-01T02:30', y: 40 },\n      { x: '2024-02-29T16:00Z', y: 50 }, { x: '2024-03-01', y: 4 },\n    ]);\n    r.frames();\n    expect(r.controller.handle.diagnostics).toMatchObject([{ code: 'AX107', field: 'x', rows: [1, 2] }]);\n    expect(lastModel(r).summary).toContain('maximum 4');\n    expect(lastModel(r).summary).toContain('Values not shown: 2.');\n    if (type !== 'compact') expect(rows(r).map(row => row[0])).toEqual(['Feb 29, 2024', 'Mar 1, 2024']);\n  });\n}\nimport { expect, it } from 'vitest';\nimport { chart, codes, committed, expectCompact, lastModel, marks, reading, rows, types, walk } from './model';\n\nconst examples = [\n  ['en-US', '123,456.75', '0.000123456', '0.3'],\n  ['de-DE', '123.456,75', '0,000123456', '0,3'],\n  ['en-IN', '1,23,456.75', '0.000123456', '0.3'],\n] as const;\n\nfor (const type of types) {\n  it(`F6 ${type}: localized readouts keep the full integer and six significant fraction digits, with the unit`, () => {\n    for (const [locale, large, small, sum] of examples) {\n      const field = { field: 'y', unit: 'ms' };\n      const r = chart(type, [\n        { x: type === 'donut' ? 'A' : 1, y: 123456.75 },\n        { x: type === 'donut' ? 'B' : 2, y: 0.000123456321 },\n        { x: type === 'donut' ? 'C' : 3, y: 0.1 + 0.2 },\n      ], { locale, [type === 'donut' ? 'value' : 'y']: field });\n      r.frames();\n      const expected = [large, small, sum].map(value => value + ' ms');\n      expect(codes(r)).toEqual([]);\n      expect(lastModel(r).summary).toContain(expected[0]);\n      expect(lastModel(r).summary).toContain(expected[1]);\n      expect(lastModel(r).summary).toContain(expected[2]);\n      expect(lastModel(r).note).toBeNull();\n      if (type === 'compact') expectCompact(r);\n      else {\n        expect(rows(r).map(row => row[type === 'scatter' ? 2 : 1])).toEqual(expected);\n        const { lookup } = committed(r);\n        walk(r).forEach((ref, i) => {\n          const target = ref.kind === 'aligned' ? { kind: 'x' as const, x: ref.x }\n            : ref.kind === 'point' ? { kind: 'point' as const, refs: [ref], count: 1 } : ref;\n          expect(lookup.tooltip(target).rows[0]?.value).toBe(expected[i]);\n          expect(reading(r, ref)).toContain(expected[i]);\n        });\n      }\n      const mark = type === 'donut' ? 'arcs' : type === 'scatter' ? 'points' : type === 'bar' ? 'rects' : 'path';\n      expect(marks(r, mark)).toHaveLength(1);\n    }\n  });\n\n  it(`F6 ${type}: a throwing value formatter falls back for reader text and preserves drawn marks`, () => {\n    const r = chart(type, [{ x: type === 'donut' ? 'A' : 1, y: 123456.75 }, { x: type === 'donut' ? 'B' : 2, y: 20 }], {\n      [type === 'donut' ? 'value' : 'y']: { field: 'y', unit: 'ms', format() { throw new Error('formatter fixture'); } },\n    });\n    r.frames();\n    expect(lastModel(r).summary).toContain('123,456.75 ms');\n    if (type === 'compact') expectCompact(r);\n    else {\n      expect(rows(r)[0]?.[type === 'scatter' ? 2 : 1]).toBe('123,456.75 ms');\n      expect(reading(r, walk(r)[0]!)).toContain('123,456.75 ms');\n    }\n    expect(codes(r)).toEqual(['AX160']);\n    const mark = type === 'donut' ? 'arcs' : type === 'scatter' ? 'points' : type === 'bar' ? 'rects' : 'path';\n    expect(marks(r, mark)).toHaveLength(1);\n  });\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n  it(`F6 ${type}: compact ticks and full readouts use separate formatters`, () => {\n    const r = chart(type, [{ x: 1, y: 50_000 }, { x: 2, y: 100_000 }], {\n      y: { field: 'y', unit: 'ms', domain: [0, 100_000], tickFormat: { notation: 'compact' } },\n    });\n    r.frames();\n    const ticks = r.texts.at(-1)?.filter(text => text.role === 'tick-y').map(text => text.full);\n    expect(ticks).toContain('100K');\n    expect(rows(r).map(row => row[type === 'scatter' ? 2 : 1])).toEqual(['50,000 ms', '100,000 ms']);\n    expect(reading(r, walk(r).at(-1)!)).toContain('100,000 ms');\n  });\n}\n\nit('F6 donut: percentage text is independently localized in tooltip and table', () => {\n  const r = chart('donut', [{ x: 'A', y: 1 }, { x: 'B', y: 7 }], { locale: 'de-DE' });\n  r.frames();\n  const first = walk(r)[0]!;\n  if (first.kind !== 'slice') throw new Error('Expected a slice');\n  const percent = committed(r).lookup.tooltip(first).rows[0]?.percent;\n  expect(percent?.replaceAll('\\u00a0', ' ')).toBe('12,5 %');\n  expect(rows(r)[0]?.[2]?.replaceAll('\\u00a0', ' ')).toBe('12,5 %');\n  expect(reading(r, first)?.replaceAll('\\u00a0', ' ')).toContain('12,5 %');\n});\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F6 ${type}: dates in the summary, table and readouts follow the locale with the same calendar day`, () => {\n    for (const locale of ['en-US', 'de-DE', 'en-IN']) {\n      const r = chart(type, [{ x: '2024-02-29', y: 18 }, { x: '2024-03-01', y: 20 }], { locale, x: { field: 'x', timeZone: 'Asia/Kolkata' } });\n      r.frames();\n      const formatter = new Intl.DateTimeFormat(locale, { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });\n      const expected = formatter.format(Date.UTC(2024, 1, 29));\n      expect(lastModel(r).summary).toContain(expected);\n      if (type === 'compact') expectCompact(r);\n      else {\n        const ref = walk(r)[0]!;\n        const target = ref.kind === 'aligned' ? { kind: 'x' as const, x: ref.x } : { kind: 'point' as const, refs: [ref], count: 1 };\n        expect(committed(r).lookup.tooltip(target).title).toBe(expected);\n        expect(rows(r)[0]?.[0]).toBe(expected);\n        expect(reading(r, ref)).toContain(expected);\n      }\n    }\n  });\n}\nimport fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { at, axes, chart, expectCompact, expectGeometry, lastModel, marks, pixel, points, reading, refAt, rows } from './model';\n\nconst stacks = [['area', 'area'], ['bar', 'bar'], ['compact', 'area'], ['compact', 'bar']] as const;\nconst options = (kind: 'area' | 'bar') => ({ y: ['a', 'b', 'c', 'd'], ...(kind === 'area' ? { stacked: true } : { layout: 'stacked' }) });\n\nfor (const [type, kind] of stacks) {\n  it(`F10 ${type}: for any generated mixed-sign ${kind} stacks each drawn component uses its own side of zero and the axis covers both sums`, () => {\n    const value = fc.integer({ min: 2, max: 20 });\n    fc.assert(fc.property(value, value, value, value, (a, b, c, d) => {\n      const records = [{ x: 1, a, b: -b, c, d: -d }, { x: 2, a, b: -b, c, d: -d }];\n      const r = chart(type, records, options(kind), undefined, kind);\n      r.frames();\n      const { y } = axes(r);\n      const bases = [0, 0, a, -b];\n      const tips = [a, -b, a + c, -b - d];\n      expect(y.domain[0]).toBeLessThanOrEqual(-b - d);\n      expect(y.domain[1]).toBeGreaterThanOrEqual(a + c);\n      if (kind === 'bar') {\n        for (const mark of marks(r, 'rects')) {\n          expect(mark.variant).toBe('bar');\n          expect(mark.xywh).toHaveLength(8);\n          for (const offset of [0, 4]) {\n            const pixelTop = mark.xywh[offset + 1]!;\n            const pixelBottom = pixelTop + mark.xywh[offset + 3]!;\n            const positive = tips[mark.series]! > 0;\n            expect(positive ? pixelTop : pixelBottom).toBeCloseTo(y.map(tips[mark.series]!), 3);\n            const base = positive ? pixelBottom : pixelTop;\n            expect(Math.abs(base - y.map(bases[mark.series]!))).toBeLessThanOrEqual(1.001);\n            expect(Math.sign(y.invert((pixelTop + pixelBottom) / 2))).toBe(positive ? 1 : -1);\n          }\n        }\n      } else {\n        for (const mark of marks(r, 'area')) {\n          const [top, count, bottom, lowerCount] = mark.runs;\n          expect([count, lowerCount]).toEqual([2, 2]);\n          expectGeometry(points(mark.upper).slice(top!, top! + count!).map(p => p[1]), [y.map(tips[mark.series]!), y.map(tips[mark.series]!)]);\n          expectGeometry(points(mark.lower).slice(bottom!, bottom! + lowerCount!).map(p => p[1]), [y.map(bases[mark.series]!), y.map(bases[mark.series]!)]);\n        }\n      }\n    }), { numRuns: 1_000 });\n  });\n\n  it(`F10 ${type}: a missing ${kind} component has zero height and the reader is told which stack is incomplete${type === 'compact' ? ' (reading: the summary provides the incomplete warning)' : ''}`, () => {\n    const r = chart(type, [\n      { x: 1, a: 5, b: -3, c: 4, d: -2 },\n      { x: 2, a: 5, b: -3, c: null, d: -2 },\n      { x: 3, a: 5, b: -3, c: 4, d: -2 },\n    ], options(kind), undefined, kind);\n    r.frames();\n    const { x, y } = axes(r);\n    if (kind === 'bar') {\n      const missing = marks(r, 'rects').find(mark => mark.series === 2 && mark.variant === 'missing');\n      expect(missing?.xywh).toHaveLength(4);\n      expectGeometry([missing!.xywh[1]!, missing!.xywh[3]!], [y.map(5), 0]);\n    } else {\n      const mark = marks(r, 'area').find(mark => mark.series === 2)!;\n      const middle = pixel(x, 2);\n      const ordinate = (xy: Float32Array) => points(xy).filter(p => Math.abs(p[0] - middle) < 0.001);\n      expect(ordinate(mark.upper).some(p => Math.abs(p[1] - y.map(5)) < 0.001)).toBe(true);\n      expect(ordinate(mark.lower).some(p => Math.abs(p[1] - y.map(5)) < 0.001)).toBe(true);\n    }\n    if (type === 'compact') {\n      expectCompact(r);\n      expect(lastModel(r).summary).toContain('incomplete');\n    } else {\n      expect(at(r, 1).total).toBe('4');\n      expect(at(r, 2).total).toBe('0 (incomplete)');\n      expect(at(r, 2).rows.map(row => row.value)).toEqual(['5', '-3', 'No data', '-2']);\n      expect(rows(r)[1]).toEqual(['2 (incomplete)', '5', '-3', 'No data', '-2']);\n      expect(reading(r, refAt(r, 2))).toContain('Total 0 (incomplete)');\n      expect(lastModel(r).note).toBeNull();\n    }\n  });\n}\nimport fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { axes, chart, codes, committed, expectCompact, expectGeometry, expectValues, lastModel, marks, plot, points, rows } from './model';\n\nconst pair = (value: number) => [{ x: 1, y: value }, { x: 2, y: value }];\n\nfor (const [type, kind] of [['area', 'area'], ['bar', 'bar'], ['compact', 'area'], ['compact', 'bar']] as const) {\n  it(`F1 ${type}: for any generated signed ${kind} data the value domain and drawn baseline include zero, even with an excluding author domain`, () => {\n    const values = fc.integer({ min: -100, max: 100 });\n    fc.assert(fc.property(values, values, fc.boolean(), (a, b, authored) => {\n      const domain = authored ? (a < 0 && b < 0 ? [-120, -1] : [1, 120]) : undefined;\n      const r = chart(type, [{ x: 1, y: a }, { x: 2, y: b }], { y: { field: 'y', domain } }, undefined, kind);\n      r.frames();\n      const { y } = axes(r);\n      expect(y.domain[0]).toBeLessThanOrEqual(0);\n      expect(y.domain[1]).toBeGreaterThanOrEqual(0);\n      if (authored) {\n        expect(y.domain).toEqual(domain![0]! < 0 ? [-120, 0] : [0, 120]);\n        expect(codes(r)).toEqual(['AX110']);\n      } else {\n        expect(y.domain[0]).toBeLessThanOrEqual(Math.min(a, b));\n        expect(y.domain[1]).toBeGreaterThanOrEqual(Math.max(a, b));\n        expect(codes(r)).toEqual([]);\n      }\n      const baseline = y.map(0);\n      if (kind === 'area') {\n        const lower = points(marks(r, 'area')[0]!.lower);\n        expectGeometry(lower.map(p => p[1]), [baseline, baseline]);\n      } else {\n        const { xywh } = marks(r, 'rects')[0]!;\n        expect(xywh).toHaveLength(8);\n        for (const i of [0, 4]) expect(Math.min(Math.abs(xywh[i + 1]! - baseline), Math.abs(xywh[i + 1]! + xywh[i + 3]! - baseline))).toBeLessThan(0.001);\n      }\n    }), { numRuns: 1_000, seed: 4026 });\n  });\n\n  it(`F1 ${type}: ${kind} draws the 82 to 97 fixture from zero and reads the actual values`, () => {\n    const r = chart(type, [{ x: 'Floor', y: 82 }, { x: 'Ceiling', y: 97 }], { y: { field: 'y', domain: [80, 100] } }, undefined, kind);\n    r.frames();\n    expect(axes(r).y.domain).toEqual([0, 100]);\n    expect(codes(r)).toEqual(['AX110']);\n    expect(lastModel(r).summary).toContain('minimum 82, maximum 97, last 97');\n    expect(lastModel(r).note).toBeNull();\n    if (type === 'compact') expectCompact(r);\n    else {\n      expect(rows(r)).toEqual([['Floor', '82'], ['Ceiling', '97']]);\n      expectValues(r, 0, ['82']);\n      expectValues(r, 1, ['97']);\n    }\n  });\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F7 ${type}: for any generated extents the automatic domain includes data and references and the zoom stays inside its governing domain`, () => {\n    fc.assert(fc.property(fc.integer({ min: 6, max: 40 }), fc.integer({ min: 41, max: 70 }), fc.boolean(), (max, reference, authored) => {\n      const r = chart(type, [{ x: 2, y: -5 }, { x: 4, y: max }], {\n        x: { field: 'x', domain: authored ? [0, 10] : undefined }, reference: [{ x: 8, label: 'Deadline' }, { y: reference, label: 'Target' }],\n      });\n      r.frames();\n      const initial = axes(r);\n      expect(initial.y.domain[0]).toBeLessThanOrEqual(-5);\n      expect(initial.y.domain[1]).toBeGreaterThanOrEqual(reference);\n      if (initial.x.type === 'band') throw new Error('Expected a continuous x axis');\n      if (authored) expect(initial.x.domain).toEqual([0, 10]);\n      else expect(initial.x.domain[1]).toBeGreaterThanOrEqual(8);\n      r.controller.handle.zoom([-20, -17]);\n      r.frames();\n      const view = committed(r).view;\n      if (view.kind === 'donut') throw new Error('Expected Cartesian view');\n      if (type === 'compact') expect(view.xDomain).toEqual(initial.x.domain);\n      else {\n        expect(view.xDomain[0]).toBe(initial.x.domain[0]);\n        expect(view.xDomain[1]).toBe(initial.x.domain[0] + 3);\n        expect(view.xDomain[1]).toBeLessThanOrEqual(initial.x.domain[1]);\n      }\n    }), { numRuns: 1_000, seed: 4026 });\n  });\n\n  for (const [scale, small, half, full, above] of [['percent', 4, 50, 100, 110], ['ratio', 0.04, 0.5, 1, 1.1]] as const) {\n    it(`F7 ${type}: declared ${scale} reaches full scale at half scale while a small maximum uses the first tick`, () => {\n      for (const [maximum, relation] of [[small, 'below'], [half, 'full'], [full, 'full'], [above, 'above']] as const) {\n        const r = chart(type, pair(maximum), { y: { field: 'y', scale } });\n        r.frames();\n        const upper = axes(r).y.domain[1];\n        if (relation === 'below') expect(upper).toBeLessThan(full);\n        if (relation === 'full') expect(upper).toBe(full);\n        if (relation === 'above') expect(upper).toBeGreaterThan(full);\n        expect(upper).toBeGreaterThanOrEqual(maximum);\n      }\n      const labelOnly = chart(type, pair(half), { y: { field: 'y', label: 'Percent (%)' } });\n      labelOnly.frames();\n      expect(axes(labelOnly).y.domain[1]).toBeLessThan(full);\n    });\n  }\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n  it(`F7 ${type}: for any generated reference extreme the automatic value domain ends at the first drawn tick that reaches it (reading: the tick is the one the reader sees)`, () => {\n    fc.assert(fc.property(fc.integer({ min: 41, max: 70 }), reference => {\n      const r = chart(type, [{ x: 2, y: -5 }, { x: 4, y: 6 }], { reference: [{ y: reference, label: 'Target' }] });\n      r.frames();\n      const layout = plot(r);\n      if (layout.kind !== 'plot') throw new Error('Expected tick labels');\n      const { domain } = axes(r).y;\n      expect(layout.yTicks[0]?.value).toBe(domain[0]);\n      expect(domain[1]).toBe(layout.yTicks.find(tick => tick.value >= reference)?.value);\n    }), { numRuns: 1_000, seed: 4026 });\n  });\n}\n","exit_code":0,"status":"completed"}}
