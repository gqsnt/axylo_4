...cells.map(describeCell)]))].join('\\n');\n  const summary = statuses.map(status => `- ${status} · ${counts[status]}`).join('\\n');\n  const from = resolve(root, 'acceptance');\n  const report = ['# Acceptance report', '', ...describeRuns(runs, root), ...describeSizes(rows, root, sources, from),\n    '', '## Status by chart type', '', summary, '',\n    'The matrix contains individual test citations and applicability reasons. ' + fileLink(from, root, relative(root, matrixFile)), '',\n    table, '', readerDetails(rows, root, from)].join('\\n') + '\\n';\n  return { table, summary, report, counts, exitCode: release && (counts.fail || counts.weak || counts['no evidence']) ? 1 : 0 };\n}\n\nfunction main(args) {\n  const root = fileURLToPath(new URL('..', import.meta.url));\n  const resultFiles = [];\n  const resultRoots = [];\n  let release = false;\n  for (let i = 0; i < args.length; i++) {\n    if (args[i] === '--release') {\n      release = true;\n    } else if (args[i] === '--results' || args[i] === '--roots') {\n      const option = args[i];\n      const paths = option === '--results' ? resultFiles : resultRoots;\n      const before = paths.length;\n      while (args[i + 1] && !args[i + 1].startsWith('--')) paths.push(resolve(args[++i]));\n      if (before === paths.length) throw new Error(option + ' needs at least one path');\n    } else {\n      throw new Error(`unknown argument ${args[i]} (usage: node acceptance/check.mjs [--results <file>…] [--roots <directory>…] [--release])`);\n    }\n  }\n  const result = check({ root, resultFiles, resultRoots, release });\n  writeFileSync(resolve(root, 'acceptance/report.md'), result.report);\n  console.log(`${result.table}\\n\\n${result.summary}`);\n  return result.exitCode;\n}\n\nif (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n  try {\n    process.exitCode = main(process.argv.slice(2));\n  } catch (error) {\n    console.error(error.message);\n    process.exitCode = 1;\n  }\n}\n// This is a source scanner, not a TypeScript interpreter. It recognizes conventional Vitest\n// calls, literal titles, scalar it.each lists with %s/%d/%i/%# titles, and simple template\n// substitutions from for-of literal lists (including named relative imports of such lists).\n// It does not resolve renamed test APIs, arbitrary expressions, shared registration functions,\n// tagged tables, complex template expressions, or generated files. Unexpanded test templates can\n// still anchor exact reported titles without evaluating the expression.\nimport { readFileSync } from 'node:fs';\nimport { dirname, resolve } from 'node:path';\n\nconst tokens = source => [...source.matchAll(\n  /\\/\\*[\\s\\S]*?\\*\\/|\\/\\/[^\\r\\n]*|\\/(?:\\\\.|\\[(?:\\\\.|[^\\]\\\\\\r\\n])*\\]|[^/\\\\\\r\\n])+\\/[dgimsuvy]*|'(?:\\\\[\\s\\S]|[^'\\\\\\r\\n])*'|\"(?:\\\\[\\s\\S]|[^\"\\\\\\r\\n])*\"|`(?:\\\\[\\s\\S]|[^`\\\\])*`|[\\w$]+|[^\\s]/g,\n)].map(match => match[0]).filter(token => !token.startsWith('//') && !token.startsWith('/*'));\n\nfunction unescape(text) {\n  return text.replace(/\\\\(?:u\\{([\\da-f]+)\\}|u([\\da-f]{4})|x([\\da-f]{2})|(\\r\\n|[\\s\\S]))/gi,\n    (_, codePoint, unicode, hex, char) => {\n      const code = codePoint ?? unicode ?? hex;\n      if (code !== undefined) return String.fromCodePoint(parseInt(code, 16));\n      return ({ n: '\\n', r: '\\r', t: '\\t', b: '\\b', f: '\\f', v: '\\v', '0': '\\0', '\\n': '', '\\r': '', '\\r\\n': '' })[char] ?? char;\n    });\n}\n\nconst closer = { '(': ')', '[': ']', '{': '}' };\nfunction closing(parts, start) {\n  const stack = [];\n  for (let index = start; index < parts.length; index++) {\n    const token = parts[index];\n    if (Object.hasOwn(closer, token)) stack.push(closer[token]);\n    else if (token === stack.at(-1)) stack.pop();\n    if (!stack.length) return index;\n  }\n  return parts.length;\n}\n\nfunction literalList(parts, start) {\n  if (parts[start] !== '[') return null;\n  const values = [];\n  let index = start + 1;\n  while (index < parts.length && parts[index] !== ']') {\n    const token = parts[index];\n    if (token === '[') {\n      const nested = literalList(parts, index);\n      if (!nested) return null;\n      values.push(nested);\n      index = closing(parts, index);\n    } else {\n      const value = token === '-' ? token + parts[++index] : token;\n      if (/^['\"]/.test(value)) values.push(unescape(value.slice(1, -1)));\n      else if (/^-?\\d+$|^(true|false|null|NaN|Infinity|-Infinity)$/.test(value)) values.push(value);\n      else return null;\n    }\n    index++;\n    if (parts[index] === ',') index++;\n    else if (parts[index] !== ']') return null;\n  }\n  return parts[index] === ']' ? values : null;\n}\n\nfunction listByName(source, file, name) {\n  if (!/^\\w+$/.test(name)) return null;\n  const declaration = new RegExp('\\\\bconst\\\\s+' + name + '\\\\s*(?::[^=;]+)?=\\\\s*(?=\\\\[)');\n  const list = content => {\n    const match = declaration.exec(content);\n    return match && literalList(tokens(content.slice(match.index + match[0].length)), 0);\n  };\n  const local = list(source);\n  if (local) return local;\n  const imports = source.matchAll(/^import\\s*\\{([^}]+)\\}\\s*from\\s*['\"](\\.[^'\"]+)['\"]/gm);\n  for (const [, names, specifier] of imports) {\n    if (!names.split(',').some(imported => imported.trim() === name)) continue;\n    const base = resolve(dirname(file), specifier);\n    for (const candidate of [base, base + '.ts', base + '.js', base + '.mjs']) {\n      try {\n        return list(readFileSync(candidate, 'utf8'));\n      } catch (error) {\n        if (error.code !== 'ENOENT' && error.code !== 'EISDIR') throw error;\n      }\n    }\n  }\n  return null;\n}\n\nfunction expandTitles(token, rows, loops) {\n  if (!token || !/^['\"`]/.test(token)) return [];\n  const raw = token.slice(1, -1);\n  let titles = [raw];\n  if (token.startsWith('`')) {\n    for (const [expression, name] of raw.matchAll(/\\$\\{([^}]+)\\}/g)) {\n      const loop = loops.findLast(item => item.name === name.trim());\n      if (!loop || !loop.values || loop.values.some(Array.isArray)) return [];\n      titles = titles.flatMap(title => loop.values.map(value => title.replace(expression, () => value)));\n    }\n  }\n  if (rows) {\n    titles = titles.flatMap(title => rows.map((row, index) => {\n      const values = Array.isArray(row) ? row : [row];\n      let column = 0;\n      return title.replace(/%[sdi#%]/g, match => {\n        if (match === '%#') return index;\n        if (match === '%%') return '%';\n        return values[column++] ?? match;\n      });\n    }));\n  }\n  return titles.map(unescape);\n}\n\nexport function readTitles(source, file) {\n  const parts = tokens(source);\n  const suites = [];\n  const tests = [];\n  const templates = [];\n  const loops = [];\n  for (let index = 0; index < parts.length; index++) {\n    const token = parts[index];\n    if (token === 'for' && parts[index + 1] === '(' && parts[index + 2] === 'const' && parts[index + 4] === 'of') {\n      const start = closing(parts, index + 1) + 1;\n      if (parts[start] === '{') {\n        const values = literalList(parts, index + 5) ?? listByName(source, file, parts[index + 5]);\n        loops.push({ name: parts[index + 3], start, end: closing(parts, start), values });\n      }\n    }\n    if (!['it', 'test', 'describe'].includes(token) || parts[index - 1] === '.') continue;\n    let call = index + 1;\n    let rows;\n    while (parts[call] === '.') {\n      const modifier = parts[call + 1];\n      call += 2;\n      if (['each', 'skipIf', 'runIf'].includes(modifier) && parts[call] === '(') {\n        if (modifier === 'each') rows = literalList(parts, call + 1) ?? [];\n        call = closing(parts, call) + 1;\n      }\n    }\n    if (parts[call] !== '(') continue;\n    const titles = parts[call + 2] === ','\n      ? expandTitles(parts[call + 1], rows, loops.filter(loop => loop.start < index && index < loop.end))\n      : [];\n    if (token === 'describe') {\n      const end = closing(parts, call);\n      // The callback's block ends just before the last argument or closing parenthesis.\n      const start = parts.indexOf('{', call + 3);\n      if (start !== -1 && start < end) for (const title of titles) suites.push({ title, start, end: closing(parts, start) });\n    } else {\n      const ancestors = suites.filter(suite => suite.start < index && index < suite.end).map(suite => suite.title);\n      if (!titles.length && parts[call + 1]?.startsWith('`') && parts[call + 2] === ',') {\n        templates.push({ template: parts[call + 1].slice(1, -1), ancestors });\n      }\n      // An unresolved case must stop a partially reported suite from appearing to pass.\n      for (const title of titles.length ? titles : [null]) tests.push({ title, ancestors });\n    }\n  }\n  return { suites: suites.map(suite => suite.title), tests, templates };\n}\n\nexport function matchesTemplate(title, template) {\n  const literals = template.split(/\\$\\{[^}]+\\}/g).map(unescape);\n  if (literals.length < 2) return false;\n  const pattern = literals.map(s => s.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&')).join('.*?');\n  return new RegExp('^' + pattern + '$').test(title);\n}\n# Release acceptance\n\nFrom the repository root\n\n```sh\nnode --test acceptance/test/*.test.mjs\nmkdir -p acceptance/results\nenv -u AXYLO_BROWSER timeout 400 npx vitest run --reporter=json --outputFile=acceptance/results/unit.json\nnode acceptance/check.mjs --results acceptance/results/unit.json\n```\n\nAppend any available coordinator reports to `--results`. Omit reports that are absent. The checker prints the table with each cell's result sources and regenerates [report.md](report.md). With no arguments, it checks citations and reports static coverage plus any cited packed size measurement.\n\n| Result | Vitest configuration |\n|---|---|\n| `unit.json` | Root configuration in Node |\n| `browser.json` | Root configuration with `AXYLO_BROWSER=1` |\n| `dist.json` | `tests/dist/vitest.config.ts` in Node |\n| `dist-browser.json` | `tests/dist/vitest.config.ts` with `AXYLO_BROWSER=1` |\n\nUse `--roots <directory>…` when a report uses paths relative to a directory other than the repository root. For example, `--roots tests/dist packages/react` also resolves paths relative to those two directories. Paths that match more than one cited source are errors. Absolute paths from an archived checkout can use their full repository-relative suffix.\n\nStructural errors exit 1. With `--release`, any `fail`, `weak` or `no evidence` cell also exits 1. The report identifies pending workloads and verification that requires another environment.\n\n| Status | Meaning |\n|---|---|\n| pass | The required assertions passed and any measured targets were met. |\n| fail | A required assertion failed or a measured target was exceeded. A failure takes precedence when results differ. |\n| weak | Partial evidence exists and leaves a documented gap. A passing result for a cited test can coexist with a weak cell. |\n| no evidence | The criterion applies and has no relevant evidence. |\n| not run | Required assertions are missing or skipped, or the cell is waiting for a valid measurement. |\n| cannot be verified here | The criterion requires an environment or rehearsal outside the supplied runs. |\n| not applicable | The criterion does not apply to the chart type. The matrix records the reason. |\n\n## Review and cite evidence\n\nUse the spec ID and short wording. Section 3.6 cells use `T-<rule>-<chart type>`. Give every excluded chart type a `notApplicable` reason. Negative type-matrix rules such as donut zoom check absence. Compact covers line, area and bar variants where the rule applies.\n\nRead the assertion and its fixture before citing it. Use `evidence` for the checks needed for a cell, `gaps` for the specific unverified part when those checks are collectively partial, and `weak` for supporting citations with their own `reason`. Use `cannotVerify` for environmental limits and `pending` for work awaiting a valid run.\n\nEach citation specifies a repository-relative `file` and a `kind` of `unit`, `property`, `browser`, `size`, `benchmark`, `document` or `manual rehearsal`. For a test, give its exact Vitest `title` or a `prefix` of a `describe` title when all registered cases are required. For a generated title the source scanner cannot expand, include its source template as `registration`. Give the exact `ancestors` path when suite names are generated or a repeated title must be scoped to a particular suite. The checker verifies the source registration and joins only matching assertion identities.\n\nA `size` citation names the budgeted `entries` in the packed size artifact and compares exact gzip bytes to the recorded targets. Historical benchmarks carry a `workload` and optional `history`. Documents, manual rehearsals and provisional benchmark workloads need review outside the Vitest result join.\n{\n  \"name\": \"axylo-workspace\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"typecheck\": \"tsc -p packages/axylo --noEmit && tsc -p docs/api && tsc -p packages/react && tsc -p tests/dist\",\n    \"test\": \"vitest run\",\n    \"build\": \"node scripts/build.mjs\",\n    \"size\": \"node scripts/size.mjs\",\n    \"docs:build\": \"node apps/docs/build.mjs\",\n    \"docs:screenshots\": \"node apps/docs/screenshots.mjs\",\n    \"test:browser\": \"AXYLO_BROWSER=1 vitest run\",\n    \"test:dist\": \"vitest run --config tests/dist/vitest.config.ts\",\n    \"test:dist:browser\": \"AXYLO_BROWSER=1 vitest run --config tests/dist/vitest.config.ts\",\n    \"check\": \"npm run typecheck && npm test && npm run build && npm run test:browser && npm run test:dist && npm run test:dist:browser && npm run size\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^26.6.6\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"axe-core\": \"^