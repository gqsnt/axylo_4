lookup.step(ref, 'previous') : ref);\n      expect(committed(r).reader.table?.row(dropped - from)?.at(-1)).toBe(String(values[dropped]));\n      expect(reading(r, ref)).toContain(String(values[dropped]));\n    }\\\"\\\"\\\")\n# In a stack, navigation visits both series before advancing a slot.\ns=s.replace(\\\"\\\"\\\"      expect(committed(r).lookup.step(refAt(r, dropped - 1), 'next')).toEqual(stacked\n        ? committed(r).lookup.step(ref, 'previous') : ref);\\\"\\\"\\\", \\\"\\\"\\\"      const { lookup } = committed(r);\n      const next = lookup.step(refAt(r, dropped - 1), 'next');\n      expect(stacked ? lookup.step(next, 'next') : next).toEqual(ref);\\\"\\\"\\\")\ns=s.replace(\\\"ratio, window);\\\\n    }\\\", \\\"ratio, window, true);\\\\n    }\\\")\np.write_text(s)\np=Path('packages/axylo/test/acceptance/f-stacks.test.ts')\ns=p.read_text().replace(\\\"\\\"\\\"      expect(announced).toContain(defaultMessages.incompleteStack);\n      for\\\"\\\"\\\", \\\"\\\"\\\"      expect(announced).toContain(defaultMessages.incompleteStack);\n      const spokenTotals = announced?.split(defaultMessages.total)[1]?.split(defaultMessages.incompleteStack)[0];\n      expect.soft(spokenTotals?.match(/-?\\\\\\\\d+/g)?.map(Number)).toEqual(expect.arrayContaining([5, -5]));\n      for\\\"\\\"\\\")\np.write_text(s)\nPY\nnode acceptance/check.mjs >/tmp/axylo-check-structure.log 2>&1\nhead -6 /tmp/axylo-check-structure.log\ntimeout 400 npx vitest run packages/axylo/test/acceptance/f-dense.test.ts > /tmp/axylo-dense-4.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
