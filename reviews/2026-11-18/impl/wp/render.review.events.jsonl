   return;\n    26\t  }\n    27\t  // The constructor must come from the document's own window, or adopting the sheet throws.\n    28\t  const sheet = new win.CSSStyleSheet();\n    29\t  sheet.replaceSync(AXYLO_CSS);\n    30\t  adopted.set(doc, sheet);\n    31\t  doc.adoptedStyleSheets = [...doc.adoptedStyleSheets, sheet];\n    32\t}\n    50\t * baseline: its band extent along the category axis and its edge on the baseline. A side thinner than\n    51\t * MISSING_MIN is grown away from the baseline (upwards for a zero height, rightwards for a zero width),\n    52\t * so the marker sits on the baseline. The renderers draw it hollow, with a diagonal, inset by half the\n    53\t * outline so the outline stays inside the box. Writes x, y, width, height of the outline path into `out`.\n    54\t */\n    55\texport function missingBox(x: number, y: number, w: number, h: number, out: Float64Array): void {\n    56\t  const left = w < 0 ? x + w : x;\n    57\t  let top = h < 0 ? y + h : y;\n    58\t  const width = Math.max(Math.abs(w), MISSING_MIN);\n    59\t  let height = Math.abs(h);\n    60\t  if (height < MISSING_MIN) { top = top + height - MISSING_MIN; height = MISSING_MIN; }\n    61\t  const inset = MISSING_STROKE / 2;\n    62\t  out[0] = left + inset; out[1] = top + inset; out[2] = width - MISSING_STROKE; out[3] = height - MISSING_STROKE;\n    63\t}\n    64\t\n    65\t/** Result of `sector`. */\n    66\texport const SECTOR_NONE = 0;    // nothing to draw\n    67\texport const SECTOR_RING = 1;    // a full annulus (one slice that is the whole circle)\n    68\texport const SECTOR_ARCS = 2;    // outer arc, then inner arc back\n    69\texport const SECTOR_APEX = 3;    // outer arc, then one apex point (the gap closes before the inner radius)\n    70\t\n    71\t/**\n    72\t * Annular sector with `gap` CSS px of background between it and its neighbours: each side is moved\n    73\t * gap/2 into the slice, parallel to its radius, so the gap has constant width (spec A5) rathe