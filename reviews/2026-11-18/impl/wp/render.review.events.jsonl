{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/theme/palette.test.ts'","aggregated_output":"     1\timport { describe, expect, it } from 'vitest';\n     2\timport fs from 'node:fs';\n     3\timport path from 'node:path';\n     4\timport { contrastRatio, parseColor, type Rgba } from '../../src/theme/color';\n     5\timport { DARK, LIGHT } from '../../src/theme/palette';\n     6\timport { AXYLO_CSS } from '../../src/theme/css';\n     7\t\n     8\tconst c = (s: string): Rgba => parseColor(s)!;\n     9\tconst research = JSON.parse(fs.readFileSync(path.resolve(import.meta.dirname, '../../../../research/palette/feasibility.json'), 'utf8')) as\n    10\t  Record<string, { background: string; colors: string[]; contrast: number[] }>;\n    11\t\n    12\tdescribe('default palette (spec A5)', () => {\n    13\t  for (const [name, scheme, source] of [['light', LIGHT, 'usable-light-8'], ['dark', DARK, 'usable-dark-8']] as const) {\n    14\t    it(`${name}: the eight series colors are the provisional research set`, () => {\n    15\t      expect(scheme.series).toEqual(research[source]!.colors);\n    16\t      expect(scheme.background).toBe(research[source]!.background);\n    17\t    });\n    18\t\n    19\t    it(`${name}: every series color reaches 3:1 on the default background`, () => {\n    20\t      const bg = c(scheme.background);\n    21\t      expect(scheme.series).toHaveLength(8);\n    22\t      scheme.series.forEach((color, i) => {\n    23\t        const k = contrastRatio(c(color), bg);\n    24\t        expect(k, `${color}`).toBeGreaterThanOrEqual(3);\n    25\t        // Independent check of the contrast code against the ratios the palette search recorded.\n    26\t        expect(k).toBeCloseTo(research[source]!.contrast[i]!, 1);\n    27\t      });\n    28\t    });\n    29\t\n    30\t    it(`${name}: token colors meet spec L2 (axis and focus 3:1; muted and reference 4.5:1, they label text)`, () => {\n    31\t      const bg = c(scheme.background);\n    32\t      expect(contrastRatio(c(scheme.axis), bg)).toBeGreaterThanOrEqual(3);\n    33\t      expect(contrastRatio(c(scheme.focus), bg)).toBeGreaterThanOrEqual(3);\n    34\t      expect(contrastRatio(c(scheme.muted), bg)).toBeGreaterThanOrEqual(4.5);\n    35\t      expect(contrastRatio(c(scheme.reference), bg)).toBeGreaterThanOrEqual(4.5);\n    36\t    });\n    37\t  }\n    38\t});\n    39\t\n    40\tdescribe('default stylesheet', () => {\n    41\t  it('defines the light and dark token sets, forced colors and the dash switch', () => {\n    42\t    for (let i = 1; i <= 8; i++) {\n    43\t      expect(AXYLO_CSS).toContain(`--axylo-series-${i}: ${LIGHT.series[i - 1]};`);\n    44\t      expect(AXYLO_CSS).toContain(`--axylo-series-${i}: ${DARK.series[i - 1]};`);\n    45\t      expect(AXYLO_CSS).toContain(`--axylo-series-${i}: CanvasText !important;`);\n    46\t    }\n    47\t    expect(AXYLO_CSS).toContain('.axylo[data-axylo-scheme=\"dark\"]');\n    48\t    expect(AXYLO_CSS).toContain('@media (forced-colors: active)');\n    49\t    expect(AXYLO_CSS).toMatch(/@media \\(prefers-contrast: more\\), \\(forced-colors: active\\) \\{\\s*\\.axylo-svg \\.axylo-dashed \\{ stroke-dasharray: var\\(--axylo-dash-contrast/);\n    50\t    expect(AXYLO_CSS).toContain('--axylo-stylesheet: loaded');\n    51\t  });\n    52\t\n    53\t  it('never sets what scheme detection reads (color-scheme, color, --axylo-background) outside forced colors', () => {\n    54\t    const outsideForced = AXYLO_CSS.replace(/@media \\(forced-colors: active\\) \\{[\\s\\S]*?\\n {2}\\}\\n/, '');\n    55\t    expect(outsideForced).not.toMatch(/color-scheme\\s*:/);\n    56\t    expect(outsideForced).not.toMatch(/--axylo-background\\s*:/);\n    57\t    expect(outsideForced).not.toMatch(/\\.axylo\\s*\\{[^}]*[^-]color\\s*:/);\n    58\t  });\n    59\t\n    60\t  it('ends with the marker for the figure module', () => {\n    61\t    expect(AXYLO_CSS.trimEnd().endsWith('*/')).toBe(true);\n    62\t    expect(AXYLO_CSS).toContain('/* structure: added by the figure module');\n    63\t  });\n    64\t\n    65\t  it('balances its braces', () => {\n    66\t    expect(AXYLO_CSS.split('{').length).toBe(AXYLO_CSS.split('}').length);\n    67\t  });\n    68\t});\n","exit_code":0,"status":"completed"}}
