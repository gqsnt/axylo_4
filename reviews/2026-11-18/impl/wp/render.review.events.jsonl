{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/render/text.browser.test.ts'","aggregated_output":"     1\t/**\n     2\t * The DOM text layer: labels land where their `box` says (the boxes are computed in the entry from canvas\n     3\t * metrics of the layer's own font, as layout will), and they are real text that honours the WCAG 1.4.12\n     4\t * text-spacing overrides (spec A6).\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport type { TextProbe } from './entries/api';\n    10\timport { close, open } from './util';\n    11\t\n    12\tbeforeAll(start);\n    13\tafterAll(stop);\n    14\t\n    15\tdescribe('text layer', () => {\n    16\t  let page: Page;\n    17\t  let probes: TextProbe[];\n    18\t  beforeAll(async () => {\n    19\t    page = await open();\n    20\t    probes = await page.evaluate(() => window.axr.mountText(20, 60));\n    21\t  });\n    22\t  afterAll(async () => { await close(page); });\n    23\t\n    24\t  const names = ['rotated -45, end-anchored', 'two lines, middle, top', 'end-anchored', 'rotated -90'];\n    25\t\n    26\t  it('each label lands on its box within 1.5 px', () => {\n    27\t    expect(probes).toHaveLength(4);\n    28\t    probes.forEach((p, i) => {\n    29\t      for (const k of ['x', 'y', 'width', 'height'] as const) {\n    30\t        expect(Math.abs(p.rect[k] - p.box[k]), `${names[i]} ${k}: rect ${p.rect[k]} box ${p.box[k]}`).toBeLessThanOrEqual(1.5);\n    31\t      }\n    32\t    });\n    33\t  });\n    34\t\n    35\t  it('the anchors hold: end-anchored text ends on x, the two-line label is centred on x and starts at y', () => {\n    36\t    const end = probes[2]!.rect;\n    37\t    expect(Math.abs(end.x + end.width - 380)).toBeLessThanOrEqual(1.5);\n    38\t    const two = probes[1]!.rect;\n    39\t    expect(Math.abs(two.x + two.width / 2 - 100)).toBeLessThanOrEqual(1.5);\n    40\t    expect(Math.abs(two.y - 200)).toBeLessThanOrEqual(1.5);\n    41\t    expect(Math.abs(two.height - 36)).toBeLessThanOrEqual(1.5);\n    42\t  });\n    43\t\n    44\t  it('reuses its elements and inserts text as text, never as HTML', async () => {\n    45\t    expect(await page.evaluate(() => window.axr.textReuse())).toEqual({ sameNodes: true, markupInert: true });\n    46\t  });\n    47\t\n    48\t  it('honours the WCAG 1.4.12 text-spacing overrides from a user stylesheet', async () => {\n    49\t    const before = await page.evaluate(() => window.axr.measureText());\n    50\t    await page.addStyleTag({ content: '* { letter-spacing: 0.12em !important; word-spacing: 0.16em !important; line-height: 1.5 !important; }' });\n    51\t    const after = await page.evaluate(() => window.axr.measureText());\n    52\t    // \"1,250 kWh\": 9 characters and one space at 14 px, so about 9 × 1.68 + 2.24 = 17.4 px wider.\n    53\t    const grew = after[2]!.rect.width - before[2]!.rect.width;\n    54\t    expect(grew).toBeGreaterThan(14);\n    55\t    expect(grew).toBeLessThan(21);\n    56\t    // Still end-anchored with the new metrics.\n    57\t    expect(Math.abs(after[2]!.rect.x + after[2]!.rect.width - 380)).toBeLessThanOrEqual(1.5);\n    58\t    // Two lines at line-height 1.5 × 14 px.\n    59\t    expect(Math.abs(after[1]!.rect.height - 42)).toBeLessThanOrEqual(1.5);\n    60\t  });\n    61\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/render/geometry.test.ts'","aggregated_output":"     1\timport { describe, expect, it } from 'vitest';\n     2\timport fc from 'fast-check';\n     3\timport {\n     4\t  MARKER_POLYGONS, MISSING_MIN, MISSING_STROKE, missingBox, paintOf, sector, SECTOR_APEX, SECTOR_ARCS, SECTOR_NONE, SECTOR_RING, signedArea, snapRule,\n     5\t} from '../../src/render/geometry';\n     6\timport { areaData, pathData } from '../../src/render/svg';\n     7\timport type { PaintBindings } from '../../src/core/contracts';\n     8\t\n     9\tdescribe('snapRule', () => {\n    10\t  const out = new Float64Array(5);\n    11\t  it('puts a 1 px horizontal rule on whole device rows', () => {\n    12\t    fc.assert(fc.property(fc.double({ min: -1000, max: 1000, noNaN: true }), fc.constantFrom(1, 1.5, 2, 3), fc.constantFrom(0.5, 1, 2), (y, dpr, w) => {\n    13\t      snapRule(0, y, 100, y, w, dpr, out);\n    14\t      const lineWidth = out[4]! * dpr;\n    15\t      expect(Number.isInteger(Math.round(lineWidth * 1e9) / 1e9)).toBe(true);\n    16\t      const top = out[1]! * dpr - lineWidth / 2;\n    17\t      expect(Math.abs(top - Math.round(top))).toBeLessThan(1e-6);\n    18\t      // Within one device pixel of where it was asked for.\n    19\t      expect(Math.abs(out[1]! - y)).toBeLessThanOrEqual(1 / dpr);\n    20\t    }));\n    21\t  });\n    22\t\n    23\t  it('leaves a diagonal alone', () => {\n    24\t    snapRule(0.3, 0.4, 10.7, 20.1, 1, 2, out);\n    25\t    expect(Array.from(out)).toEqual([0.3, 0.4, 10.7, 20.1, 1]);\n    26\t  });\n    27\t});\n    28\t\n    29\tdescribe('sector (ring slices with a constant-width gap)', () => {\n    30\t  const s = new Float64Array(8);\n    31\t  it('moves each side gap/2 into the slice, parallel to its radius', () => {\n    32\t    fc.assert(fc.property(\n    33\t      fc.double({ min: 0, max: 5, noNaN: true }), fc.double({ min: 0.3, max: 3, noNaN: true }),\n    34\t      fc.double({ min: 10, max: 50, noNaN: true }), fc.double({ min: 60, max: 200, noNaN: true }), fc.double({ min: 0.5, max: 8, noNaN: true }),\n    35\t      (a0, span, r0, r1, gap) => {\n    36\t        const kind = sector(a0, a0 + span, r0, r1, gap, s);\n    37\t        if (kind === SECTOR_NONE) return;\n    38\t        // Distance of the outer start point from the start radius line is gap / 2.\n    39\t        const sideAngle = a0 - Math.PI / 2;\n    40\t        const distance = (r: number, a: number): number => Math.abs(r * Math.sin(a - sideAngle));\n    41\t        expect(distance(r1, s[0]!)).toBeCloseTo(gap / 2, 9);\n    42\t        if (kind === SECTOR_ARCS) expect(distance(r0, s[3]!)).toBeCloseTo(gap / 2, 9);\n    43\t        if (kind === SECTOR_APEX) expect(distance(s[4]!, s[5]!)).toBeCloseTo(gap / 2, 9);\n    44\t      }));\n    45\t  });\n    46\t\n    47\t  it('draws a single full slice as a ring and refuses empty ones', () => {\n    48\t    expect(sector(0, 2 * Math.PI, 10, 20, 2, s)).toBe(SECTOR_RING);\n    49\t    expect(sector(1, 1, 10, 20, 2, s)).toBe(SECTOR_NONE);\n    50\t    expect(sector(0, 0.01, 10, 20, 4, s)).toBe(SECTOR_NONE);\n    51\t  });\n    52\t\n    53\t  it('closes at an apex when the gap meets before the inner radius (a pie, r0 = 0)', () => {\n    54\t    expect(sector(0, Math.PI / 2, 0, 50, 4, s)).toBe(SECTOR_APEX);\n    55\t    expect(s[4]).toBeCloseTo(2 / Math.sin(Math.PI / 4), 9);\n    56\t    expect(sector(0, Math.PI / 2, 30, 50, 4, s)).toBe(SECTOR_ARCS);\n    57\t  });\n    58\t});\n    59\t\n    60\tdescribe('missingBox', () => {\n    61\t  const out = new Float64Array(4);\n    62\t  it('grows a zero-height slot upwards from the baseline to a visible box', () => {\n    63\t    missingBox(10, 200, 20, 0, out);\n    64\t    const [x, y, w, h] = Array.from(out);\n    65\t    expect(x).toBe(10 + MISSING_STROKE / 2);\n    66\t    expect(y! + h! + MISSING_STROKE / 2).toBe(200);\n    67\t    expect(h! + MISSING_STROKE).toBe(MISSING_MIN);\n    68\t    expect(w! + MISSING_STROKE).toBe(20);\n    69\t  });\n    70\t\n    71\t  it('keeps a box that is already large enough', () => {\n    72\t    missingBox(10, 190, 20, 10, out);\n    73\t    expect(Array.from(out)).toEqual([10.75, 190.75, 18.5, 8.5]);\n    74\t  });\n    75\t});\n    76\t\n    77\tdescribe('markers', () => {\n    78\t  it('every polygon is clockwise on screen and fits the unit box', () => {\n    79\t    for (const [shape, poly] of Object.entries(MARKER_POLYGONS)) {\n    80\t      expect(signedArea(poly), shape).toBeGreaterThan(0);\n    81\t      for (const v of poly) expect(Math.abs(v), shape).toBeLessThanOrEqual(0.5 + 1e-12);\n    82\t    }\n    83\t  });\n    84\t});\n    85\t\n    86\tdescribe('paintOf', () => {\n    87\t  const table: PaintBindings = { tokens: { axis: 'A', grid: 'G', reference: 'R', muted: 'M', focus: 'F', background: 'B', text: 'T' }, series: ['s0', 's1'] };\n    88\t  it('looks up series, tokens and none', () => {\n    89\t    expect(paintOf({ kind: 'series', index: 1 }, table)).toBe('s1');\n    90\t    expect(paintOf({ kind: 'series', index: 3 }, table)).toBe('s1');\n    91\t    expect(paintOf({ kind: 'token', name: 'grid' }, table)).toBe('G');\n    92\t    expect(paintOf({ kind: 'none' }, table)).toBeNull();\n    93\t  });\n    94\t});\n    95\t\n    96\tdescribe('SVG path data', () => {\n    97\t  it('a NaN pair lifts the pen', () => {\n    98\t    expect(pathData(Float32Array.of(0, 0, 10, 0, NaN, NaN, 20, 5, 30, 5))).toBe('M0 0L10 0M20 5L30 5');\n    99\t  });\n   100\t\n   101\t  it('has one M per run and one L per further vertex, for any input (property)', () => {\n   102\t    fc.assert(fc.property(fc.array(fc.oneof(fc.double({ min: -1e4, max: 1e4, noNaN: true }), fc.constant(NaN)), { maxLength: 400 }), values => {\n   103\t      const xy = Float32Array.from(values.length % 2 === 0 ? values : values.slice(1));\n   104\t      let runs = 0, vertices = 0, pen = false;\n   105\t      for (let i = 0; i < xy.length; i += 2) {\n   106\t        if (Number.isNaN(xy[i]!) || Number.isNaN(xy[i + 1]!)) { pen = false; continue; }\n   107\t        vertices++;\n   108\t        if (!pen) runs++;\n   109\t        pen = true;\n   110\t      }\n   111\t      const d = pathData(xy);\n   112\t      expect((d.match(/M/g) ?? []).length).toBe(runs);\n   113\t      expect((d.match(/L/g) ?? []).length).toBe(vertices - runs);\n   114\t    }));\n   115\t  });\n   116\t\n   117\t  it('is correct across chunk boundaries', () => {\n   118\t    const n = 5000;\n   119\t    const xy = new Float32Array(2 * n);\n   120\t    for (let i = 0; i < n; i++) { xy[2 * i] = i; xy[2 * i + 1] = i % 7; }\n   121\t    const d = pathData(xy);\n   122\t    expect(d.startsWith('M0 0L1 1L2 2')).toBe(true);\n   123\t    expect((d.match(/L/g) ?? []).length).toBe(n - 1);\n   124\t    expect(d.endsWith(`L${n - 1} ${(n - 1) % 7}`)).toBe(true);\n   125\t  });\n   126\t\n   127\t  it('an area run is its upper vertices forward, then its lower vertices in reverse', () => {\n   128\t    const d = areaData({\n   129\t      type: 'area', series: 0, fill: { kind: 'series', index: 0 }, opacity: 1,\n   130\t      upper: Float32Array.of(0, 1, 1, 1, 2, 1, 9, 9, 10, 2, 11, 2),\n   131\t      lower: Float32Array.of(0, 5, 1, 5, 2, 5, 10, 6, 11, 6),\n   132\t      runs: Uint32Array.of(0, 3, 0, 3, 4, 2, 3, 2),\n   133\t    });\n   134\t    expect(d).toBe('M0 1L1 1L2 1L2 5L1 5L0 5ZM10 2L11 2L11 6L10 6Z');\n   135\t  });\n   136\t});\n","exit_code":0,"status":"completed"}}
