{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'for f in packages/axylo/src/theme/*.ts; do echo \"$f\"; nl -ba \"$f\"; done'","aggregated_output":"packages/axylo/src/theme/color.ts\n     1\t/**\n     2\t * Color arithmetic for contrast checks (spec L2, A5). Pure: runs in Node. Input is what the browser hands\n     3\t * back from getComputedStyle (`rgb()`, `rgba()`, `color(srgb …)`) plus hex, which the default palette is\n     4\t * written in. Anything else returns null rather than a guess.\n     5\t */\n     6\timport type { ResolvedTheme } from '../core/contracts';\n     7\t\n     8\t/** sRGB channels and alpha, each 0–1. */\n     9\texport interface Rgba { readonly r: number; readonly g: number; readonly b: number; readonly a: number }\n    10\t\n    11\tconst clamp01 = (v: number): number => (v < 0 ? 0 : v > 1 ? 1 : v);\n    12\t\n    13\tfunction channel(token: string, scale: number): number {\n    14\t  if (token.endsWith('%')) return clamp01(parseFloat(token) / 100);\n    15\t  if (token === 'none') return 0;\n    16\t  return clamp01(parseFloat(token) / scale);\n    17\t}\n    18\t\n    19\tfunction alpha(token: string | undefined): number {\n    20\t  if (token === undefined) return 1;\n    21\t  return channel(token, 1);\n    22\t}\n    23\t\n    24\t/** Parses a computed color string. Returns null for anything that is not a plain sRGB color. */\n    25\texport function parseColor(input: string): Rgba | null {\n    26\t  const s = input.trim().toLowerCase();\n    27\t  if (s === 'transparent') return { r: 0, g: 0, b: 0, a: 0 };\n    28\t  if (s.startsWith('#')) return parseHex(s.slice(1));\n    29\t  const open = s.indexOf('(');\n    30\t  if (open < 0 || !s.endsWith(')')) return null;\n    31\t  const name = s.slice(0, open).trim();\n    32\t  // Both the legacy comma form and the space form with \"/ alpha\".\n    33\t  const body = s.slice(open + 1, -1).replace(/,/g, ' ').replace('/', ' / ');\n    34\t  const parts = body.split(/\\s+/).filter(p => p.length > 0);\n    35\t  const slash = parts.indexOf('/');\n    36\t  const main = slash >= 0 ? parts.slice(0, slash) : parts;\n    37\t  const alphaToken = slash >= 0 ? parts[slash + 1] : undefined;\n    38\t  let r: number, g: number, b: number, a: number;\n    39\t  if (name === 'rgb' || name === 'rgba') {\n    40\t    if (main.length < 3) return null;\n    41\t    const legacyAlpha = main.length === 4 ? main[3] : alphaToken;\n    42\t    r = channel(main[0]!, 255); g = channel(main[1]!, 255); b = channel(main[2]!, 255); a = alpha(legacyAlpha);\n    43\t  } else if (name === 'color') {\n    44\t    if (main[0] !== 'srgb' || main.length < 4) return null;\n    45\t    r = channel(main[1]!, 1); g = channel(main[2]!, 1); b = channel(main[3]!, 1); a = alpha(alphaToken);\n    46\t  } else {\n    47\t    return null;\n    48\t  }\n    49\t  if (!Number.isFinite(r) || !Number.isFinite(g) || !Number.isFinite(b) || !Number.isFinite(a)) return null;\n    50\t  return { r, g, b, a };\n    51\t}\n    52\t\n    53\tfunction parseHex(h: string): Rgba | null {\n    54\t  if (!/^[0-9a-f]+$/.test(h)) return null;\n    55\t  const full = h.length === 3 || h.length === 4 ? h.split('').map(c => c + c).join('') : h;\n    56\t  if (full.length !== 6 && full.length !== 8) return null;\n    57\t  const at = (i: number): number => parseInt(full.slice(i, i + 2), 16) / 255;\n    58\t  return { r: at(0), g: at(2), b: at(4), a: full.length === 8 ? at(6) : 1 };\n    59\t}\n    60\t\n    61\t/** A translucent color as it appears over an opaque background. */\n    62\texport function composite(top: Rgba, under: Rgba): Rgba {\n    63\t  const a = top.a;\n    64\t  return { r: top.r * a + under.r * (1 - a), g: top.g * a + under.g * (1 - a), b: top.b * a + under.b * (1 - a), a: 1 };\n    65\t}\n    66\t\n    67\tconst linear = (c: number): number => (c <= 0.04045 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4));\n    68\t\n    69\t/** WCAG 2 relative luminance of an opaque color. */\n    70\texport function relativeLuminance(c: Rgba): number {\n    71\t  return 0.2126 * linear(c.r) + 0.7152 * linear(c.g) + 0.0722 * linear(c.b);\n    72\t}\n    73\t\n    74\t/** WCAG 2 contrast ratio, 1–21. A translucent foreground is first composited over the background. */\n    75\texport function contrastRatio(foreground: Rgba, background: Rgba): number {\n    76\t  const fg = foreground.a < 1 ? composite(foreground, background) : foreground;\n    77\t  const l1 = relativeLuminance(fg);\n    78\t  const l2 = relativeLuminance(background);\n    79\t  return (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);\n    80\t}\n    81\t\n    82\t/**\n    83\t * True when a color reads as light: it contrasts more with black than with white. Used for the scheme\n    84\t * decision (spec L4): light text means a dark background, a light background means a light scheme.\n    85\t */\n    86\texport function isLightColor(c: Rgba): boolean {\n    87\t  return relativeLuminance(c) > Math.sqrt(1.05 * 0.05) - 0.05;\n    88\t}\n    89\t\n    90\t/** Indexes of series paints below 3:1 against the resolved background (the caller raises AX141). */\n    91\texport function lowContrastSeries(theme: ResolvedTheme): number[] {\n    92\t  const background = parseColor(theme.paints.tokens.background);\n    93\t  const low: number[] = [];\n    94\t  if (background === null || background.a === 0) return low;\n    95\t  const opaque = background.a < 1 ? composite(background, { r: 1, g: 1, b: 1, a: 1 }) : background;\n    96\t  theme.paints.series.forEach((paint, i) => {\n    97\t    const c = parseColor(paint);\n    98\t    if (c !== null && contrastRatio(c, opaque) < 3) low.push(i);\n    99\t  });\n   100\t  return low;\n   101\t}\npackages/axylo/src/theme/css.ts\n     1\t/**\n     2\t * The library's default stylesheet as a string. `ensureStyles` adopts it as a constructable stylesheet; the\n     3\t * build writes the same string to dist/axylo.css for pages that prefer to load it themselves.\n     4\t *\n     5\t * Everything sits in the `axylo` cascade layer so that any unlayered rule of the page wins over a default\n     6\t * without a specificity contest, whichever order the sheets arrive in.\n     7\t *\n     8\t * Two things this sheet must never do, because scheme detection (spec L4) reads them from the chart root:\n     9\t * set `color-scheme` or `color` on `.axylo`, or set `--axylo-background`. The default background therefore\n    10\t * lives in the private `--axylo-default-background`, and the background paint is\n    11\t * `var(--axylo-background, var(--axylo-default-background))`.\n    12\t */\n    13\timport { DARK, LIGHT, type SchemeColors } from './palette';\n    14\t\n    15\tfunction tokens(c: SchemeColors): string {\n    16\t  const series = c.series.map((v, i) => `    --axylo-series-${i + 1}: ${v};`).join('\\n');\n    17\t  return `${series}\n    18\t    --axylo-default-background: ${c.background};\n    19\t    --axylo-axis: ${c.axis};\n    20\t    --axylo-grid: ${c.grid};\n    21\t    --axylo-muted: ${c.muted};\n    22\t    --axylo-reference: ${c.reference};\n    23\t    --axylo-focus: ${c.focus};`;\n    24\t}\n    25\t\n    26\t// Forced colors: every paint becomes a system color. `!important` so an author's custom property on the\n    27\t// chart cannot leak a brand color into a mode where the user chose the colors.\n    28\tconst forced = [\n    29\t  ...LIGHT.series.map((_, i) => `    --axylo-series-${i + 1}: CanvasText !important;`),\n    30\t  '    --axylo-background: Canvas !important;',\n    31\t  '    --axylo-default-background: Canvas !important;',\n    32\t  '    --axylo-text: CanvasText !important;',\n    33\t  '    --axylo-axis: CanvasText !important;',\n    34\t  '    --axylo-grid: GrayText !important;',\n    35\t  '    --axylo-muted: GrayText !important;',\n    36\t  '    --axylo-reference: CanvasText !important;',\n    37\t  '    --axylo-focus: Highlight !important;',\n    38\t].join('\\n');\n    39\t\n    40\texport const AXYLO_CSS = `/* Axylo default stylesheet */\n    41\t@layer axylo {\n    42\t  /* Lets ensureStyles see that this sheet is already loaded. */\n    43\t  :root { --axylo-stylesheet: loaded; }\n    44\t\n    45\t  /* tokens: light set (default) */\n    46\t  .axylo {\n    47\t${tokens(LIGHT)}\n    48\t  }\n    49\t\n    50\t  /* tokens: dark set, selected by the scheme the chart resolved */\n    51\t  .axylo[data-axylo-scheme=\"dark\"] {\n    52\t${tokens(DARK)}\n    53\t  }\n    54\t\n    55\t  @media (forced-colors: active) {\n    56\t    .axylo {\n    57\t${forced}\n    58\t    }\n    59\t  }\n    60\t\n    61\t  /* marks */\n    62\t  .axylo-svg, .axylo-canvas { position: absolute; left: 0; top: 0; display: block; pointer-events: none; }\n    63\t  .axylo-svg { overflow: hidden; }\n    64\t  .axylo-canvas > canvas { position: absolute; left: 0; top: 0; display: block; }\n    65\t\n    66\t  /*\n    67\t   * Dash patterns of the SVG renderer. Each dashed element carries its normal pattern inline and both\n    68\t   * patterns as custom properties; this switch needs no redraw (spec A5).\n    69\t   */\n    70\t  @media (prefers-contrast: more), (forced-colors: active) {\n    71\t    .axylo-svg .axylo-dashed { stroke-dasharray: var(--axylo-dash-contrast, none) !important; }\n    72\t  }\n    73\t\n    74\t  /* text layer: real HTML text, so it inherits the page font, honours text spacing and forced colors */\n    75\t  .axylo-text {\n    76\t    position: absolute;\n    77\t    inset: 0;\n    78\t    pointer-events: none;\n    79\t    color: var(--axylo-text, currentColor);\n    80\t    font-size: max(12px, 1em);\n    81\t    white-space: nowrap;\n    82\t  }\n    83\t  .axylo-text > .axylo-label { position: absolute; left: 0; top: 0; transform-origin: 0 0; white-space: pre; }\n    84\t  .axylo-text > .axylo-label > div { display: block; }\n    85\t}\n    86\t\n    87\t/* structure: added by the figure module (inside \"@layer axylo { … }\") */\n    88\t`;\npackages/axylo/src/theme/index.ts\n     1\texport { AXYLO_CSS } from './css';\n     2\texport { ensureStyles } from './styles';\n     3\texport { resolveTheme, seriesBinding, TOKEN_BINDINGS, type ThemeResolution } from './resolve';\n     4\texport { watchTheme } from './watch';\n     5\texport { composite, contrastRatio, isLightColor, lowContrastSeries, parseColor, relativeLuminance, type Rgba } from './color';\n     6\texport { DARK, LIGHT, SERIES_COUNT, type SchemeColors } from './palette';\npackages/axylo/src/theme/palette.ts\n     1\t/**\n     2\t * Default colors. The series sets are the provisional \"usable-light-8\" and \"usable-dark-8\" results of the\n     3\t * palette search (research/palette/feasibility.json); a later milestone tunes them. Token colors meet spec\n     4\t * L2 on their scheme's background: axis and focus at least 3:1, muted and reference at least 4.5:1 because\n     5\t * they are also used for text (hidden legend entries, reference labels). Grid is exempt.\n     6\t *\n     7\t * Text has no default: the chart inherits the page's `color` (spec DX6).\n     8\t */\n     9\texport interface SchemeColors {\n    10\t  readonly background: string;\n    11\t  readonly axis: string;\n    12\t  readonly grid: string;\n    13\t  readonly muted: string;\n    14\t  readonly reference: string;\n    15\t  readonly focus: string;\n    16\t  readonly series: readonly string[];\n    17\t}\n    18\t\n    19\texport const LIGHT: SchemeColors = {\n    20\t  background: '#ffffff',\n    21\t  axis: '#5f6470',\n    22\t  grid: '#e2e4e9',\n    23\t  muted: '#62666f',\n    24\t  reference: '#474b55',\n    25\t  focus: '#1f5fcc',\n    26\t  series: ['#7d2960', '#9584f2', '#620ab4', '#ca7b9b', '#f3471b', '#9b578a', '#b12508', '#6a41f6'],\n    27\t};\n    28\t\n    29\texport const DARK: SchemeColors = {\n    30\t  background: '#16181d',\n    31\t  axis: '#8b909c',\n    32\t  grid: '#30343c',\n    33\t  muted: '#9da2ad',\n    34\t  reference: '#bcc0c9',\n    35\t  focus: '#79a8ff',\n    36\t  series: ['#674cf5', '#5af0e9', '#b2ac04', '#837b16', '#b73795', '#c4e61a', '#f166a0', '#06a6fa'],\n    37\t};\n    38\t\n    39\texport const SERIES_COUNT = 8;\npackages/axylo/src/theme/resolve.ts\n     1\t/**\n     2\t * Theme resolution (spec L4, DX6, A5): decides light or dark for a chart root, and turns paints into both\n     3\t * CSS expressions (for the SVG renderer, which stays live) and concrete colors (for canvas and contrast\n     4\t * checks). Concrete colors come from the browser itself through a probe element, never from parsing CSS.\n     5\t */\n     6\timport type { PaintBindings, PaintToken, ResolvedTheme } from '../core/contracts';\n     7\timport { isLightColor, parseColor } from './color';\n     8\timport { SERIES_COUNT } from './palette';\n     9\t\n    10\texport interface ThemeResolution {\n    11\t  readonly bindings: PaintBindings;\n    12\t  readonly theme: ResolvedTheme;\n    13\t}\n    14\t\n    15\tconst TOKENS: readonly PaintToken[] = ['axis', 'grid', 'reference', 'muted', 'focus', 'background', 'text'];\n    16\t\n    17\t/** CSS expressions for the token paints. The stylesheet defines every name used here. */\n    18\texport const TOKEN_BINDINGS: Readonly<Record<PaintToken, string>> = Object.freeze({\n    19\t  axis: 'var(--axylo-axis)',\n    20\t  grid: 'var(--axylo-grid)',\n    21\t  reference: 'var(--axylo-reference)',\n    22\t  muted: 'var(--axylo-muted)',\n    23\t  focus: 'var(--axylo-focus)',\n    24\t  // The author's --axylo-background, if any, is both the decision input and the paint.\n    25\t  background: 'var(--axylo-background, var(--axylo-default-background))',\n    26\t  // The chart inherits the page's text color unless the author sets --axylo-text (spec DX6).\n    27\t  text: 'var(--axylo-text, currentColor)',\n    28\t});\n    29\t\n    30\texport const seriesBinding = (index: number): string => `var(--axylo-series-${(index % SERIES_COUNT) + 1})`;\n    31\t\n    32\t/**\n    33\t * Resolves the theme for `element` (the chart root, normally `.axylo`) and sets `data-axylo-scheme` on it.\n    34\t * `colors` maps series keys to the author's CSS colors; they are kept as written so `var(--brand-1)` stays\n    35\t * live in SVG. Under forced colors the author's colors are set aside for the system colors the stylesheet\n    36\t * maps every palette slot to; the chart re-resolves when forced colors toggles (watchTheme reports it).\n    37\t */\n    38\texport function resolveTheme(\n    39\t  element: HTMLElement,\n    40\t  seriesKeys: readonly string[],\n    41\t  colors?: Readonly<Record<string, string>> | null,\n    42\t): ThemeResolution {\n    43\t  const doc = element.ownerDocument;\n    44\t  const win = doc.defaultView;\n    45\t  if (win === null) throw new Error('Axylo: the chart element is not in a document with a window.');\n    46\t  const forcedColors = win.matchMedia('(forced-colors: active)').matches;\n    47\t  const moreContrast = win.matchMedia('(prefers-contrast: more)').matches;\n    48\t\n    49\t  const series = seriesKeys.map((key, i) => {\n    50\t    const own = colors != null && Object.prototype.hasOwnProperty.call(colors, key) ? colors[key] : undefined;\n    51\t    return own !== undefined && own.trim() !== '' && !forcedColors ? own : seriesBinding(i);\n    52\t  });\n    53\t  const bindings: PaintBindings = { tokens: TOKEN_BINDINGS, series };\n    54\t\n    55\t  const scheme = decideScheme(element, win);\n    56\t  if (element.getAttribute('data-axylo-scheme') !== scheme) element.setAttribute('data-axylo-scheme', scheme);\n    57\t\n    58\t  const expressions = [...TOKENS.map(t => TOKEN_BINDINGS[t]), ...series];\n    59\t  const computed = probeColors(element, expressions);\n    60\t  const tokens = {} as Record<PaintToken, string>;\n    61\t  TOKENS.forEach((t, i) => { tokens[t] = computed[i]!; });\n    62\t  const paints: PaintBindings = { tokens, series: computed.slice(TOKENS.length) };\n    63\t\n    64\t  return { bindings, theme: { scheme, forcedColors, moreContrast, paints } };\n    65\t}\n    66\t\n    67\t/**\n    68\t * Spec L4: `--axylo-background` on the element decides if present; else a computed `color-scheme` that\n    69\t * names exactly one of light and dark; else the inherited text color (light text means a dark scheme).\n    70\t */\n    71\tfunction decideScheme(element: HTMLElement, win: Window): 'light' | 'dark' {\n    72\t  const style = win.getComputedStyle(element);\n    73\t  if (style.getPropertyValue('--axylo-background').trim() !== '') {\n    74\t    const [background] = probeColors(element, ['var(--axylo-background)']);\n    75\t    const c = parseColor(background!);\n    76\t    if (c !== null && c.a > 0) return isLightColor(c) ? 'light' : 'dark';\n    77\t  }\n    78\t  const words = style.colorScheme.split(/\\s+/);\n    79\t  const light = words.includes('light');\n    80\t  const dark = words.includes('dark');\n    81\t  if (light !== dark) return light ? 'light' : 'dark';\n    82\t  const text = parseColor(normalizeColor(style.color, element.ownerDocument));\n    83\t  return text !== null && isLightColor(text) ? 'dark' : 'light';\n    84\t}\n    85\t\n    86\t/**\n    87\t * Lets the browser resolve CSS color expressions in the element's context: one hidden child per expression,\n    88\t * all written before any is read so the style is computed once.\n    89\t */\n    90\tfunction probeColors(element: HTMLElement, expressions: readonly string[]): string[] {\n    91\t  const doc = element.ownerDocument;\n    92\t  const win = doc.defaultView!;\n    93\t  const box = doc.createElement('div');\n    94\t  box.style.setProperty('display', 'none');\n    95\t  const probes = expressions.map(expression => {\n    96\t    const probe = doc.createElement('span');\n    97\t    // Forced colors may replace an author `color` with CanvasText; the probe must read what was asked.\n    98\t    probe.style.setProperty('forced-color-adjust', 'none');\n    99\t    probe.style.setProperty('color', expression);\n   100\t    box.appendChild(probe);\n   101\t    return probe;\n   102\t  });\n   103\t  box.style.setProperty('forced-color-adjust', 'none');\n   104\t  element.appendChild(box);\n   105\t  const values = probes.map(p => win.getComputedStyle(p).color);\n   106\t  box.remove();\n   107\t  return values.map(v => normalizeColor(v, doc));\n   108\t}\n   109\t\n   110\t/**\n   111\t * Computed colors are rgb()/rgba() for most inputs but keep other spaces (oklch(), lab()) as written.\n   112\t * Those are converted by painting one pixel, so canvas and the contrast check always get sRGB.\n   113\t */\n   114\tfunction normalizeColor(value: string, doc: Document): string {\n   115\t  if (parseColor(value) !== null) return value;\n   116\t  const canvas = doc.createElement('canvas');\n   117\t  canvas.width = 1;\n   118\t  canvas.height = 1;\n   119\t  const ctx = canvas.getContext('2d', { willReadFrequently: true });\n   120\t  if (ctx === null) return value;\n   121\t  ctx.fillStyle = value;\n   122\t  ctx.fillRect(0, 0, 1, 1);\n   123\t  const [r, g, b, a] = ctx.getImageData(0, 0, 1, 1).data;\n   124\t  return `rgba(${r}, ${g}, ${b}, ${Math.round(((a ?? 255) / 255) * 1000) / 1000})`;\n   125\t}\npackages/axylo/src/theme/styles.ts\n     1\t/**\n     2\t * Applies the default stylesheet to a document without injecting a `<style>` element (plan 2.4): a\n     3\t * constructable stylesheet in `adoptedStyleSheets`. Pages that load dist/axylo.css themselves are detected\n     4\t * through the `--axylo-stylesheet` property that sheet sets on `:root`, and get nothing added.\n     5\t */\n     6\timport { AXYLO_CSS } from './css';\n     7\t\n     8\tconst adopted = new WeakMap<Document, CSSStyleSheet>();\n     9\t// Remembered so later calls do not force a style recalculation just to find the page's own sheet again.\n    10\tconst standalone = new WeakSet<Document>();\n    11\t\n    12\t/** Makes the default styles apply to `doc`. Safe to call any number of times. */\n    13\texport function ensureStyles(doc: Document): void {\n    14\t  if (standalone.has(doc)) return;\n    15\t  const existing = adopted.get(doc);\n    16\t  if (existing !== undefined) {\n    17\t    // Re-adopt if something replaced the document's list since.\n    18\t    if (!doc.adoptedStyleSheets.includes(existing)) doc.adoptedStyleSheets = [...doc.adoptedStyleSheets, existing];\n    19\t    return;\n    20\t  }\n    21\t  const win = doc.defaultView;\n    22\t  if (win === null) return;\n    23\t  if (win.getComputedStyle(doc.documentElement).getPropertyValue('--axylo-stylesheet').trim() !== '') {\n    24\t    standalone.add(doc);\n    25\t    return;\n    26\t  }\n    27\t  // The constructor must come from the document's own window, or adopting the sheet throws.\n    28\t  const sheet = new win.CSSStyleSheet();\n    29\t  sheet.replaceSync(AXYLO_CSS);\n    30\t  adopted.set(doc, sheet);\n    31\t  doc.adoptedStyleSheets = [...doc.adoptedStyleSheets, sheet];\n    32\t}\npackages/axylo/src/theme/watch.ts\n     1\t/**\n     2\t * Notices the page changes that can change a chart's theme (spec L4): the three media features, and the\n     3\t * `class`, `style` or `data-theme` attribute of `<html>` or `<body>`, which is how class-toggled dark\n     4\t * themes switch. Bursts are folded into one call per animation frame.\n     5\t */\n     6\t\n     7\tconst QUERIES = ['(prefers-color-scheme: dark)', '(forced-colors: active)', '(prefers-contrast: more)'];\n     8\tconst ATTRIBUTES = ['class', 'style', 'data-theme'];\n     9\t\n    10\t/** Calls `onChange` at most once per animation frame after a relevant change. Returns `stop`. */\n    11\texport function watchTheme(element: Element, onChange: () => void): () => void {\n    12\t  const doc = element.ownerDocument;\n    13\t  const win = doc.defaultView;\n    14\t  if (win === null) return () => {};\n    15\t  let frame = 0;\n    16\t  let stopped = false;\n    17\t\n    18\t  const schedule = (): void => {\n    19\t    if (stopped || frame !== 0) return;\n    20\t    frame = win.requestAnimationFrame(() => {\n    21\t      frame = 0;\n    22\t      if (!stopped) onChange();\n    23\t    });\n    24\t  };\n    25\t\n    26\t  const lists = QUERIES.map(q => win.matchMedia(q));\n    27\t  for (const list of lists) list.addEventListener('change', schedule);\n    28\t\n    29\t  const html = doc.documentElement;\n    30\t  let body: HTMLElement | null = doc.body;\n    31\t  const observer = new win.MutationObserver(records => {\n    32\t    let relevant = false;\n    33\t    for (const r of records) {\n    34\t      if (r.type === 'attributes') relevant = true;\n    35\t      else if (body === null && doc.body !== null) {\n    36\t        // The script ran in <head>: start watching <body> once it exists.\n    37\t        body = doc.body;\n    38\t        observer.observe(body, { attributes: true, attributeFilter: ATTRIBUTES });\n    39\t        relevant = true;\n    40\t      }\n    41\t    }\n    42\t    if (relevant) schedule();\n    43\t  });\n    44\t  observer.observe(html, { attributes: true, attributeFilter: ATTRIBUTES, childList: body === null });\n    45\t  if (body !== null) observer.observe(body, { attributes: true, attributeFilter: ATTRIBUTES });\n    46\t\n    47\t  return () => {\n    48\t    if (stopped) return;\n    49\t    stopped = true;\n    50\t    for (const list of lists) list.removeEventListener('change', schedule);\n    51\t    observer.disconnect();\n    52\t    if (frame !== 0) win.cancelAnimationFrame(frame);\n    53\t    frame = 0;\n    54\t  };\n    55\t}\n","exit_code":0,"status":"completed"}}
