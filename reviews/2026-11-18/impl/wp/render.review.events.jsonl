{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/render/text.ts'","aggregated_output":"     1\t/**\n     2\t * The DOM text layer (plan 2.3): tick labels, titles and messages as real HTML text, so they inherit the\n     3\t * page font and color, honour the reader's text spacing (spec A6) and adapt to forced colors. The layer is\n     4\t * aria-hidden; readers get the same information from the summary and table.\n     5\t *\n     6\t * Each label is one absolutely positioned element with one block child per line. Its transform puts the\n     7\t * anchor point of the text on (x, y) and rotates about that point. Elements are reused between renders,\n     8\t * text is only ever set through textContent (spec DX8), and render writes without reading layout.\n     9\t */\n    10\timport type { PlacedText } from '../core/contracts';\n    11\t\n    12\texport interface TextLayer {\n    13\t  readonly element: HTMLDivElement;\n    14\t  render(texts: readonly PlacedText[]): void;\n    15\t  destroy(): void;\n    16\t}\n    17\t\n    18\tinterface Label {\n    19\t  readonly el: HTMLDivElement;\n    20\t  css: string;\n    21\t  role: string;\n    22\t  readonly lines: HTMLDivElement[];\n    23\t  readonly text: string[];\n    24\t}\n    25\t\n    26\tconst ALIGN = { start: 'left', middle: 'center', end: 'right' } as const;\n    27\tconst SHIFT_X = { start: '0%', middle: '-50%', end: '-100%' } as const;\n    28\tconst SHIFT_Y = { top: '0%', middle: '-50%', bottom: '-100%' } as const;\n    29\t\n    30\t/** Rounded to 1/100 px so that equal positions produce equal strings and skip the write. */\n    31\tconst px = (v: number): string => `${Math.round(v * 100) / 100}px`;\n    32\t\n    33\texport function labelStyle(t: PlacedText): string {\n    34\t  // Transforms apply right to left: move the anchor point of the text to the origin, rotate about it,\n    35\t  // then move the origin to (x, y).\n    36\t  const rotate = t.rotate !== 0 ? ` rotate(${t.rotate}deg)` : '';\n    37\t  return `position:absolute;left:0;top:0;transform-origin:0 0;white-space:pre;text-align:${ALIGN[t.anchor]};` +\n    38\t    `transform:translate(${px(t.x)},${px(t.y)})${rotate} translate(${SHIFT_X[t.anchor]},${SHIFT_Y[t.baseline]})`;\n    39\t}\n    40\t\n    41\texport function createTextLayer(doc: Document = document): TextLayer {\n    42\t  const element = doc.createElement('div');\n    43\t  element.className = 'axylo-text';\n    44\t  element.setAttribute('aria-hidden', 'true');\n    45\t  let labels: Label[] = [];\n    46\t\n    47\t  return {\n    48\t    element,\n    49\t    render(texts: readonly PlacedText[]): void {\n    50\t      let fresh: DocumentFragment | null = null;\n    51\t      for (let i = 0; i < texts.length; i++) {\n    52\t        const t = texts[i]!;\n    53\t        let label = labels[i];\n    54\t        if (label === undefined) {\n    55\t          const el = doc.createElement('div');\n    56\t          el.className = 'axylo-label';\n    57\t          label = { el, css: '', role: '', lines: [], text: [] };\n    58\t          labels.push(label);\n    59\t          (fresh ??= doc.createDocumentFragment()).appendChild(el);\n    60\t        }\n    61\t        const css = labelStyle(t);\n    62\t        if (label.css !== css) { label.css = css; label.el.style.cssText = css; }\n    63\t        if (label.role !== t.role) { label.role = t.role; label.el.setAttribute('data-role', t.role); }\n    64\t        const lines = label.lines;\n    65\t        while (lines.length > t.lines.length) { lines.pop()!.remove(); label.text.pop(); }\n    66\t        while (lines.length < t.lines.length) {\n    67\t          const line = doc.createElement('div');\n    68\t          label.el.appendChild(line);\n    69\t          lines.push(line);\n    70\t          label.text.push('');\n    71\t        }\n    72\t        for (let k = 0; k < lines.length; k++) {\n    73\t          const s = t.lines[k]!;\n    74\t          if (label.text[k] !== s) { label.text[k] = s; lines[k]!.textContent = s; }\n    75\t        }\n    76\t      }\n    77\t      for (let i = texts.length; i < labels.length; i++) labels[i]!.el.remove();\n    78\t      if (labels.length > texts.length) labels = labels.slice(0, texts.length);\n    79\t      if (fresh !== null) element.appendChild(fresh);\n    80\t    },\n    81\t    destroy(): void {\n    82\t      element.remove();\n    83\t      labels = [];\n    84\t    },\n    85\t  };\n    86\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/render/canvas.ts'","aggregated_output":"     1\t/**\n     2\t * Canvas 2D mark renderer (plan 2.3). Paints with `theme.paints` (concrete colors), so the chart must call\n     3\t * `draw` again after a theme change. Two stacked canvases: the scene, and the overlay above it, so a cursor\n     4\t * or focus ring can move without repainting the marks.\n     5\t *\n     6\t * Coordinates in the scene are CSS px; each context is scaled by the device pixel ratio once per draw.\n     7\t * Nothing in the drawing loops allocates per vertex or per point.\n     8\t */\n     9\timport type { AreaMark, ArcMark, BandMark, Mark, MarkRenderer, Overlay, PaintBindings, PathMark, PointMark, Rect, RectMark, ResolvedTheme, RuleMark, Scene } from '../core/contracts';\n    10\timport {\n    11\t  lifted, MARKER_POLYGONS, MISSING_STROKE, missingBox, paintOf, sector, SECTOR_APEX, SECTOR_ARCS, SECTOR_RING, snapRule, unclippedRule,\n    12\t} from './geometry';\n    13\t\n    14\tconst SOLID: readonly number[] = [];\n    15\tconst TAU = Math.PI * 2;\n    16\t\n    17\ttype Ctx = CanvasRenderingContext2D;\n    18\t\n    19\texport function createCanvasRenderer(doc: Document = document): MarkRenderer {\n    20\t  const element = doc.createElement('div');\n    21\t  element.className = 'axylo-canvas';\n    22\t  element.setAttribute('aria-hidden', 'true');\n    23\t  setStyles(element, { position: 'absolute', left: '0', top: '0', 'pointer-events': 'none' });\n    24\t  const sceneCanvas = doc.createElement('canvas');\n    25\t  const overlayCanvas = doc.createElement('canvas');\n    26\t  for (const c of [sceneCanvas, overlayCanvas]) {\n    27\t    setStyles(c, { position: 'absolute', left: '0', top: '0', display: 'block' });\n    28\t    element.appendChild(c);\n    29\t  }\n    30\t  const sceneCtx = sceneCanvas.getContext('2d');\n    31\t  const overlayCtx = overlayCanvas.getContext('2d');\n    32\t  if (sceneCtx === null || overlayCtx === null) throw new Error('Axylo: this browser cannot create a 2D canvas context.');\n    33\t\n    34\t  const scratch = new Float64Array(8);\n    35\t  let cssWidth = 0;\n    36\t  let cssHeight = 0;\n    37\t  let overlay: Overlay | null = null;\n    38\t  let overlayTheme: ResolvedTheme | null = null;\n    39\t  let ratio = 1;\n    40\t\n    41\t  function fit(canvas: HTMLCanvasElement, width: number, height: number, dpr: number): boolean {\n    42\t    const bw = Math.max(0, Math.round(width * dpr));\n    43\t    const bh = Math.max(0, Math.round(height * dpr));\n    44\t    if (canvas.width === bw && canvas.height === bh) return false;\n    45\t    // Assigning width or height reallocates and clears the backing store, so only on a real change.\n    46\t    canvas.width = bw;\n    47\t    canvas.height = bh;\n    48\t    canvas.style.setProperty('width', `${width}px`);\n    49\t    canvas.style.setProperty('height', `${height}px`);\n    50\t    return true;\n    51\t  }\n    52\t\n    53\t  function begin(ctx: Ctx, canvas: HTMLCanvasElement, dpr: number): void {\n    54\t    ctx.setTransform(1, 0, 0, 1, 0, 0);\n    55\t    ctx.clearRect(0, 0, canvas.width, canvas.height);\n    56\t    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n    57\t  }\n    58\t\n    59\t  function paintOverlay(dpr: number): void {\n    60\t    begin(overlayCtx!, overlayCanvas, dpr);\n    61\t    if (overlay === null || overlayTheme === null) return;\n    62\t    const contrast = overlayTheme.moreContrast || overlayTheme.forcedColors;\n    63\t    paintMarks(overlayCtx!, overlay.clipped, overlay.clip, false, overlayTheme.paints, contrast, dpr, scratch);\n    64\t    paintMarks(overlayCtx!, overlay.unclipped, null, false, overlayTheme.paints, contrast, dpr, scratch);\n    65\t  }\n    66\t\n    67\t  return {\n    68\t    kind: 'canvas',\n    69\t    element,\n    70\t    draw(scene: Scene, _bindings: PaintBindings, theme: ResolvedTheme, devicePixelRatio: number): void {\n    71\t      const dpr = devicePixelRatio > 0 ? devicePixelRatio : 1;\n    72\t      if (scene.width !== cssWidth || scene.height !== cssHeight) {\n    73\t        cssWidth = scene.width;\n    74\t        cssHeight = scene.height;\n    75\t        element.style.setProperty('width', `${cssWidth}px`);\n    76\t        element.style.setProperty('height', `${cssHeight}px`);\n    77\t      }\n    78\t      fit(sceneCanvas, cssWidth, cssHeight, dpr);\n    79\t      begin(sceneCtx, sceneCanvas, dpr);\n    80\t      paintMarks(sceneCtx, scene.marks, scene.clip, true, theme.paints, theme.moreContrast || theme.forcedColors, dpr, scratch);\n    81\t      // A resize clears the overlay canvas; a theme change makes its colors stale. Either way repaint it.\n    82\t      const resized = fit(overlayCanvas, cssWidth, cssHeight, dpr);\n    83\t      if (overlay !== null && (resized || dpr !== ratio || overlayTheme !== theme)) {\n    84\t        overlayTheme = theme;\n    85\t        paintOverlay(dpr);\n    86\t      }\n    87\t      ratio = dpr;\n    88\t    },\n    89\t    drawOverlay(next: Overlay | null, _bindings: PaintBindings, theme: ResolvedTheme, devicePixelRatio: number): void {\n    90\t      const dpr = devicePixelRatio > 0 ? devicePixelRatio : 1;\n    91\t      overlay = next;\n    92\t      overlayTheme = theme;\n    93\t      fit(overlayCanvas, cssWidth, cssHeight, dpr);\n    94\t      paintOverlay(dpr);\n    95\t    },\n    96\t    destroy(): void {\n    97\t      element.remove();\n    98\t      // Releases the backing stores now rather than whenever the element is collected.\n    99\t      sceneCanvas.width = sceneCanvas.height = 0;\n   100\t      overlayCanvas.width = overlayCanvas.height = 0;\n   101\t      overlay = null;\n   102\t    },\n   103\t  };\n   104\t}\n   105\t\n   106\tfunction setStyles(el: HTMLElement, styles: Readonly<Record<string, string>>): void {\n   107\t  for (const name in styles) el.style.setProperty(name, styles[name]!);\n   108\t}\n   109\t\n   110\t/**\n   111\t * Paints marks back to front. With `byRole`, axis and tick rules escape the clip (scene contract); without\n   112\t * it, every mark is clipped to `clip` when one is given (overlay lists).\n   113\t */\n   114\tfunction paintMarks(ctx: Ctx, marks: readonly Mark[], clip: Rect | null, byRole: boolean, paints: PaintBindings, contrast: boolean, dpr: number, scratch: Float64Array): void {\n   115\t  let clipped = false;\n   116\t  for (const mark of marks) {\n   117\t    const want = clip !== null && !(byRole && mark.type === 'rule' && unclippedRule(mark.role));\n   118\t    if (want !== clipped) {\n   119\t      if (clipped) ctx.restore();\n   120\t      else {\n   121\t        ctx.save();\n   122\t        ctx.beginPath();\n   123\t        ctx.rect(clip!.x, clip!.y, clip!.width, clip!.height);\n   124\t        ctx.clip();\n   125\t      }\n   126\t      clipped = want;\n   127\t    }\n   128\t    ctx.globalAlpha = 1;\n   129\t    switch (mark.type) {\n   130\t      case 'path': paintPath(ctx, mark, paints, contrast); break;\n   131\t      case 'area': paintArea(ctx, mark, paints); break;\n   132\t      case 'rects': paintRects(ctx, mark, paints, scratch); break;\n   133\t      case 'points': paintPoints(ctx, mark, paints); break;\n   134\t      case 'arcs': paintArcs(ctx, mark, paints, scratch); break;\n   135\t      case 'rule': paintRule(ctx, mark, paints, dpr, scratch); break;\n   136\t      case 'band': paintBand(ctx, mark, paints); break;\n   137\t    }\n   138\t  }\n   139\t  if (clipped) ctx.restore();\n   140\t}\n   141\t\n   142\tfunction paintPath(ctx: Ctx, mark: PathMark, paints: PaintBindings, contrast: boolean): void {\n   143\t  const color = paintOf(mark.stroke, paints);\n   144\t  if (color === null || !(mark.strokeWidth > 0)) return;\n   145\t  const xy = mark.xy;\n   146\t  ctx.beginPath();\n   147\t  let pen = false;\n   148\t  for (let i = 0; i + 1 < xy.length; i += 2) {\n   149\t    const x = xy[i]!;\n   150\t    const y = xy[i + 1]!;\n   151\t    if (lifted(x) || lifted(y)) { pen = false; continue; }\n   152\t    if (pen) ctx.lineTo(x, y);\n   153\t    else { ctx.moveTo(x, y); pen = true; }\n   154\t  }\n   155\t  ctx.strokeStyle = color;\n   156\t  ctx.lineWidth = mark.strokeWidth;\n   157\t  ctx.lineJoin = 'round';\n   158\t  ctx.lineCap = 'butt';\n   159\t  ctx.setLineDash((contrast ? mark.dash.contrast : mark.dash.normal) ?? SOLID);\n   160\t  ctx.stroke();\n   161\t  ctx.setLineDash(SOLID);\n   162\t}\n   163\t\n   164\tfunction paintArea(ctx: Ctx, mark: AreaMark, paints: PaintBindings): void {\n   165\t  const color = paintOf(mark.fill, paints);\n   166\t  if (color === null) return;\n   167\t  const { upper, lower, runs } = mark;\n   168\t  const upperCount = upper.length >> 1;\n   169\t  const lowerCount = lower.length >> 1;\n   170\t  ctx.beginPath();\n   171\t  for (let r = 0; r + 3 < runs.length; r += 4) {\n   172\t    const us = runs[r]!;\n   173\t    const ue = Math.min(us + runs[r + 1]!, upperCount);\n   174\t    const ls = runs[r + 2]!;\n   175\t    const le = Math.min(ls + runs[r + 3]!, lowerCount);\n   176\t    let started = false;\n   177\t    for (let k = us; k < ue; k++) {\n   178\t      const x = upper[2 * k]!;\n   179\t      const y = upper[2 * k + 1]!;\n   180\t      if (lifted(x) || lifted(y)) continue;\n   181\t      if (started) ctx.lineTo(x, y); else { ctx.moveTo(x, y); started = true; }\n   182\t    }\n   183\t    for (let k = le - 1; k >= ls; k--) {\n   184\t      const x = lower[2 * k]!;\n   185\t      const y = lower[2 * k + 1]!;\n   186\t      if (lifted(x) || lifted(y)) continue;\n   187\t      if (started) ctx.lineTo(x, y); else { ctx.moveTo(x, y); started = true; }\n   188\t    }\n   189\t    if (started) ctx.closePath();\n   190\t  }\n   191\t  ctx.globalAlpha = mark.opacity;\n   192\t  ctx.fillStyle = color;\n   193\t  ctx.fill();\n   194\t  ctx.globalAlpha = 1;\n   195\t}\n   196\t\n   197\tfunction paintRects(ctx: Ctx, mark: RectMark, paints: PaintBindings, box: Float64Array): void {\n   198\t  const color = paintOf(mark.fill, paints);\n   199\t  if (color === null) return;\n   200\t  const q = mark.xywh;\n   201\t  ctx.beginPath();\n   202\t  if (mark.variant === 'bar') {\n   203\t    for (let i = 0; i + 3 < q.length; i += 4) {\n   204\t      const x = q[i]!, y = q[i + 1]!, w = q[i + 2]!, h = q[i + 3]!;\n   205\t      if (lifted(x) || lifted(y) || lifted(w) || lifted(h)) continue;\n   206\t      ctx.rect(x, y, w, h);\n   207\t    }\n   208\t    ctx.fillStyle = color;\n   209\t    ctx.fill();\n   210\t    return;\n   211\t  }\n   212\t  // \"No data\" (spec F2): a hollow box with a diagonal, standing on the baseline.\n   213\t  for (let i = 0; i + 3 < q.length; i += 4) {\n   214\t    const x = q[i]!, y = q[i + 1]!, w = q[i + 2]!, h = q[i + 3]!;\n   215\t    if (lifted(x) || lifted(y) || lifted(w) || lifted(h)) continue;\n   216\t    missingBox(x, y, w, h, box);\n   217\t    const bx = box[0]!, by = box[1]!, bw = box[2]!, bh = box[3]!;\n   218\t    ctx.rect(bx, by, bw, bh);\n   219\t    ctx.moveTo(bx, by + bh);\n   220\t    ctx.lineTo(bx + bw, by);\n   221\t  }\n   222\t  ctx.strokeStyle = color;\n   223\t  ctx.lineWidth = MISSING_STROKE;\n   224\t  ctx.lineJoin = 'miter';\n   225\t  ctx.lineCap = 'butt';\n   226\t  ctx.setLineDash(SOLID);\n   227\t  ctx.stroke();\n   228\t}\n   229\t\n   230\tfunction paintPoints(ctx: Ctx, mark: PointMark, paints: PaintBindings): void {\n   231\t  const color = paintOf(mark.fill, paints);\n   232\t  if (color === null || !(mark.size > 0)) return;\n   233\t  const xy = mark.xy;\n   234\t  const size = mark.size;\n   235\t  const r = size / 2;\n   236\t  ctx.beginPath();\n   237\t  if (mark.shape === 'circle') {\n   238\t    for (let i = 0; i + 1 < xy.length; i += 2) {\n   239\t      const x = xy[i]!, y = xy[i + 1]!;\n   240\t      if (lifted(x) || lifted(y)) continue;\n   241\t      ctx.moveTo(x + r, y);\n   242\t      ctx.