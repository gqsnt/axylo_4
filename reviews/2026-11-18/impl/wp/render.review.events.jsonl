{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/render/entries/axylo-render.entry.ts'","aggregated_output":"     1\t/**\n     2\t * Browser entry for the render and theme tests. Builds a fixed Scene by hand (no scene builder exists yet)\n     3\t * and exposes small operations on `window.axr`; the tests take screenshots and sample pixels.\n     4\t */\n     5\timport type { Mark, MarkRenderer, MarkerShape, Overlay, Paint, PlacedText, Scene } from '../../../../src/core/contracts';\n     6\timport { createCanvasRenderer } from '../../../../src/render/canvas';\n     7\timport { createSvgRenderer } from '../../../../src/render/svg';\n     8\timport { createTextLayer, type TextLayer } from '../../../../src/render/text';\n     9\timport { AXYLO_CSS } from '../../../../src/theme/css';\n    10\timport { resolveTheme } from '../../../../src/theme/resolve';\n    11\timport { ensureStyles } from '../../../../src/theme/styles';\n    12\timport { watchTheme } from '../../../../src/theme/watch';\n    13\timport type { AxrApi, MountOptions, RendererKind, TextProbe, WatchRecord } from './api';\n    14\t\n    15\tconst S = (index: number): Paint => ({ kind: 'series', index });\n    16\tconst T = (name: 'axis' | 'grid' | 'reference' | 'muted' | 'focus' | 'background' | 'text'): Paint => ({ kind: 'token', name });\n    17\tconst SHAPES: readonly MarkerShape[] = ['circle', 'square', 'triangle', 'diamond', 'cross', 'plus', 'triangle-down', 'star'];\n    18\t\n    19\t/** The fixed test scene, 400 × 300 CSS px. Every coordinate here is quoted by the tests. */\n    20\texport function fixedScene(pathShift = 0): Scene {\n    21\t  const marks: Mark[] = [\n    22\t    { type: 'band', box: { x: 60, y: 30, width: 40, height: 230 }, fill: T('reference'), opacity: 0.15 },\n    23\t    // Grid rule reaching outside the clip on both sides: only 40–380 may show.\n    24\t    { type: 'rule', x1: 10, y1: 110, x2: 390, y2: 110, stroke: T('grid'), strokeWidth: 1, dash: null, role: 'grid' },\n    25\t    {\n    26\t      type: 'area', series: 1, fill: S(1), opacity: 0.5,\n    27\t      upper: Float32Array.of(50, 150, 80, 140, 110, 150, 130, 150, 150, 145, 170, 150),\n    28\t      lower: Float32Array.of(50, 200, 110, 200, 130, 200, 170, 200),\n    29\t      runs: Uint32Array.of(0, 3, 0, 2, 3, 3, 2, 2),\n    30\t    },\n    31\t    {\n    32\t      // Three segments, one pen lift; the last segment runs past the clip's right edge (380).\n    33\t      type: 'path', series: 0, stroke: S(0), strokeWidth: 3, dash: { normal: null, contrast: [6, 4] },\n    34\t      xy: Float32Array.of(50, 50 + pathShift, 120, 50 + pathShift, 120, 100, NaN, NaN, 160, 120, 395, 120),\n    35\t    },\n    36\t    { type: 'rects', series: 2, fill: S(2), variant: 'bar', xywh: Float32Array.of(200, 180, 20, 80, 230, 140, 20, 120) },\n    37\t    // The third slot (260–280) has no data; the fourth (290–310) is left empty for comparison.\n    38\t    { type: 'rects', series: 2, fill: S(2), variant: 'missing', xywh: Float32Array.of(260, 252, 20, 8) },\n    39\t    ...SHAPES.map((shape, k): Mark => ({ type: 'points', series: 3, shape, size: 10, fill: S(3), xy: Float32Array.of(50 + 20 * k, 235) })),\n    40\t    {\n    41\t      type: 'arcs', cx: 300, cy: 60, r0: 25, r1: 40, gap: 4,\n    42\t      angles: Float32Array.of(0, Math.PI / 2, Math.PI / 2, Math.PI, Math.PI, 1.5 * Math.PI, 1.5 * Math.PI, 2 * Math.PI),\n    43\t      fills: [S(4), S(5), S(6), S(7)],\n    44\t    },\n    45\t    // The x axis lies on the clip's bottom edge (y 260), i.e. outside it, and must still be drawn.\n    46\t    { type: 'rule', x1: 40, y1: 260, x2: 380, y2: 260, stroke: T('axis'), strokeWidth: 1, dash: null, role: 'axis' },\n    47\t    { type: 'rule', x1: 40, y1: 20, x2: 40, y2: 260, stroke: T('axis'), strokeWidth: 1, dash: null, role: 'axis' },\n    48\t    { type: 'rule', x1: 200, y1: 260, x2: 200, y2: 268, stroke: T('axis'), strokeWidth: 1, dash: null, role: 'tick' },\n    49\t  ];\n    50\t  return { width: 400, height: 300, clip: { x: 40, y: 20, width: 340, height: 240 }, marks };\n    51\t}\n    52\t\n    53\tfunction lineScene(vertices: number): Scene {\n    54\t  const xy = new Float32Array(vertices * 2);\n    55\t  let y = 150;\n    56\t  let seed = 12345;\n    57\t  for (let i = 0; i < vertices; i++) {\n    58\t    seed = (seed * 1103515245 + 12345) >>> 0;\n    59\t    y = Math.min(290, Math.max(10, y + ((seed / 4294967296) - 0.5) * 6));\n    60\t    xy[2 * i] = (i / Math.max(1, vertices - 1)) * 400;\n    61\t    xy[2 * i + 1] = y;\n    62\t  }\n    63\t  return { width: 400, height: 300, clip: { x: 0, y: 0, width: 400, height: 300 }, marks: [{ type: 'path', series: 0, stroke: S(0), strokeWidth: 1.5, dash: { normal: null, contrast: null }, xy }] };\n    64\t}\n    65\t\n    66\tinterface Mounted {\n    67\t  readonly kind: RendererKind;\n    68\t  readonly root: HTMLDivElement;\n    69\t  readonly renderer: MarkRenderer;\n    70\t  readonly keys: readonly string[];\n    71\t  readonly colors: Readonly<Record<string, string>> | undefined;\n    72\t  scene: Scene;\n    73\t  draws: number;\n    74\t}\n    75\t\n    76\tconst mounts: Mounted[] = [];\n    77\tconst DEFAULT_KEYS = ['s0', 's1', 's2', 's3', 's4', 's5', 's6', 's7'];\n    78\t\n    79\tfunction makeRoot(left: number, top: number): HTMLDivElement {\n    80\t  const root = document.createElement('div');\n    81\t  root.className = 'axylo';\n    82\t  for (const [k, v] of [['position', 'absolute'], ['left', `${left}px`], ['top', `${top}px`], ['width', '400px'], ['height', '300px']]) root.style.setProperty(k!, v!);\n    83\t  document.body.appendChild(root);\n    84\t  return root;\n    85\t}\n    86\t\n    87\tfunction draw(m: Mounted): void {\n    88\t  const { bindings, theme } = resolveTheme(m.root, m.keys, m.colors);\n    89\t  m.renderer.draw(m.scene, bindings, theme, window.devicePixelRatio);\n    90\t  m.draws++;\n    91\t}\n    92\t\n    93\tfunction sceneCanvas(m: Mounted, layer: 'scene' | 'overlay' = 'scene'): HTMLCanvasElement {\n    94\t  return m.root.querySelectorAll('canvas')[layer === 'scene' ? 0 : 1]!;\n    95\t}\n    96\t\n    97\tfunction pixel(m: Mounted, x: number, y: number, layer: 'scene' | 'overlay' = 'scene'): number[] {\n    98\t  const ctx = sceneCanvas(m, layer).getContext('2d')!;\n    99\t  return Array.from(ctx.getImageData(x, y, 1, 1).data);\n   100\t}\n   101\t\n   102\tlet stopWatch: (() => void)[] = [];\n   103\tlet fired = 0;\n   104\tconst records: WatchRecord[] = [];\n   105\t\n   106\tlet text: { layer: TextLayer; root: HTMLDivElement; texts: PlacedText[] } | null = null;\n   107\t\n   108\t/** A label's box from canvas metrics of the layer's own font: the independent expectation layout would produce. */\n   109\tfunction placed(lines: string[], x: number, y: number, anchor: PlacedText['anchor'], baseline: PlacedText['baseline'], rotate: number, font: string, lineHeight: number): PlacedText {\n   110\t  const ctx = document.createElement('canvas').getContext('2d')!;\n   111\t  ctx.font = font;\n   112\t  const w = Math.max(...lines.map(l => ctx.measureText(l).width));\n   113\t  const h = lines.length * lineHeight;\n   114\t  const ax = anchor === 'start' ? 0 : anchor === 'middle' ? w / 2 : w;\n   115\t  const ay = baseline === 'top' ? 0 : baseline === 'middle' ? h / 2 : h;\n   116\t  const a = (rotate * Math.PI) / 180;\n   117\t  const xs: number[] = [], ys: number[] = [];\n   118\t  for (const [cx, cy] of [[-ax, -ay], [w - ax, -ay], [w - ax, h - ay], [-ax, h - ay]] as const) {\n   119\t    xs.push(x + cx * Math.cos(a) - cy * Math.sin(a));\n   120\t    ys.push(y + cx * Math.sin(a) + cy * Math.cos(a));\n   121\t  }\n   122\t  const box = { x: Math.min(...xs), y: Math.min(...ys), width: Math.max(...xs) - Math.min(...xs), height: Math.max(...ys) - Math.min(...ys) };\n   123\t  return { lines, full: lines.join(' '), x, y, anchor, baseline, rotate, role: 'tick-x', box };\n   124\t}\n   125\t\n   126\tfunction measure(): TextProbe[] {\n   127\t  const t = text!;\n   128\t  const origin = t.root.getBoundingClientRect();\n   129\t  return Array.from(t.layer.element.children).map((el, i) => {\n   130\t    const r = el.getBoundingClientRect();\n   131\t    return { box: t.texts[i]!.box, rect: { x: r.x - origin.x, y: r.y - origin.y, width: r.width, height: r.height } };\n   132\t  });\n   133\t}\n   134\t\n   135\tconst frames = (n: number): Promise<void> => new Promise(resolve => {\n   136\t  const step = (k: number): void => { if (k === 0) resolve(); else requestAnimationFrame(() => step(k - 1)); };\n   137\t  step(n);\n   138\t});\n   139\t\n   140\tconst api: AxrApi = {\n   141\t  css: AXYLO_CSS,\n   142\t  ensureStyles(): number {\n   143\t    ensureStyles(document);\n   144\t    return document.adoptedStyleSheets.length;\n   145\t  },\n   146\t  mount(kind: RendererKind, left: number, top: number, options: MountOptions = {}): number {\n   147\t    ensureStyles(document);\n   148\t    const root = makeRoot(left, top);\n   149\t    const renderer = kind === 'canvas' ? createCanvasRenderer() : createSvgRenderer();\n   150\t    root.appendChild(renderer.element);\n   151\t    const scene = options.scene === 'line' ? lineScene(options.vertices ?? 1000) : fixedScene();\n   152\t    const m: Mounted = { kind, root, renderer, keys: options.keys ?? DEFAULT_KEYS, colors: options.colors, scene, draws: 0 };\n   153\t    mounts.push(m);\n   154\t    draw(m);\n   155\t    return mounts.length - 1;\n   156\t  },\n   157\t  redraw(id: number): void { draw(mounts[id]!); },\n   158\t  draws: (id: number): number => mounts[id]!.draws,\n   159\t  theme(id: number) {\n   160\t    const m = mounts[id]!;\n   161\t    const r = resolveTheme(m.root, m.keys, m.colors);\n   162\t    return { theme: r.theme, bindings: r.bindings, attribute: m.root.getAttribute('data-axylo-scheme') };\n   163\t  },\n   164\t  canvasInfo(id: number) {\n   165\t    const c = sceneCanvas(mounts[id]!);\n   166\t    const r = c.getBoundingClientRect();\n   167\t    return { width: c.width, height: c.height, cssWidth: r.width, cssHeight: r.height };\n   168\t  },\n   169\t  canvasPixel: (id: number, x: number, y: number, layer: 'scene' | 'overlay' = 'scene'): number[] => pixel(mounts[id]!, x, y, layer),\n   170\t  svgDash(id: number): string {\n   171\t    const el = mounts[id]!.root.querySelector('.axylo-dashed');\n   172\t    return el === null ? 'missing' : getComputedStyle(el).strokeDasharray;\n   173\t  },\n   174\t  svgReuse(id: number) {\n   175\t    const m = mounts[id]!;\n   176\t    const group = m.root.querySelector('.axylo-scene')!;\n   177\t    const before = Array.from(group.children);\n   178\t    const pathBefore = group.querySelector('path.axylo-dashed')!.getAttribute('d');\n   179\t    m.scene = fixedScene(5);\n   180\t    draw(m);\n   181\t    const after = Array.from(group.children);\n   182\t    const pathAfter = group.querySelector('path.axylo-dashed')!.getAttribute('d');\n   183\t    m.scene = fixedScene();\n   184\t    draw(m);\n   185\t    return { sameNodes: before.length === after.length && before.every((el, i) => el === after[i]), dChanged: pathBefore !== pathAfter, count: after.length };\n   186\t  },\n   187\t  overlay(id: number, on: boolean): void {\n   188\t    const m = mounts[id]!;\n   189\t    const { bindings, theme } = resolveTheme(m.root, m.keys, m.colors);\n   190\t    const overlay: Overlay = {\n   191\t      clip: m.scene.clip,\n   192\t      // A cursor rule at x = 330 running past the clip (must stop at 260) and a focus square that is not clipped.\n   193\t      clipped: [{ type: 'rule', x1: 330, y1: 0, x2: 330, y2: 300, stroke: T('focus'), strokeWidth: 2, dash: null, role: 'cursor' }],\n   194\t      unclipped: [{ type: 'points', series: 0, shape: 'square', size: 8, fill: T('focus'), xy: Float32Array.of(20, 280) }],\n   195\t    };\n   196\t    m.renderer.drawOverlay(on ? overlay :