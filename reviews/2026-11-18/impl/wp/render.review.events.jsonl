{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/render/entries/api.ts'","aggregated_output":"     1\t/** What the render test entry exposes on `window.axr`. Shared by the entry and the tests (types only). */\n     2\timport type { PaintBindings, PlacedText, ResolvedTheme } from '../../../../src/core/contracts';\n     3\t\n     4\texport type RendererKind = 'canvas' | 'svg';\n     5\t\n     6\texport interface MountOptions {\n     7\t  readonly keys?: readonly string[];\n     8\t  readonly colors?: Readonly<Record<string, string>>;\n     9\t  /** 'fixed' (default): the hand-built test scene. 'line': one path of `vertices` vertices. */\n    10\t  readonly scene?: 'fixed' | 'line';\n    11\t  readonly vertices?: number;\n    12\t}\n    13\t\n    14\texport interface WatchRecord {\n    15\t  readonly id: number;\n    16\t  /** Canvas only: pixel at the probe point before and after the draw the callback made. */\n    17\t  readonly before: readonly number[] | null;\n    18\t  readonly after: readonly number[] | null;\n    19\t}\n    20\t\n    21\texport interface TextProbe {\n    22\t  readonly box: { x: number; y: number; width: number; height: number };\n    23\t  readonly rect: { x: number; y: number; width: number; height: number };\n    24\t}\n    25\t\n    26\texport interface AxrApi {\n    27\t  readonly css: string;\n    28\t  ensureStyles(): number;\n    29\t  mount(kind: RendererKind, left: number, top: number, options?: MountOptions): number;\n    30\t  redraw(id: number): void;\n    31\t  draws(id: number): number;\n    32\t  theme(id: number): { theme: ResolvedTheme; bindings: PaintBindings; attribute: string | null };\n    33\t  canvasInfo(id: number): { width: number; height: number; cssWidth: number; cssHeight: number };\n    34\t  /** RGBA of the scene canvas backing store at a device pixel. */\n    35\t  canvasPixel(id: number, x: number, y: number, layer?: 'scene' | 'overlay'): number[];\n    36\t  /** Computed stroke-dasharray of the SVG renderer's dashed path. */\n    37\t  svgDash(id: number): string;\n    38\t  /** Redraws with the path moved; reports whether every scene element was reused. */\n    39\t  svgReuse(id: number): { sameNodes: boolean; dChanged: boolean; count: number };\n    40\t  overlay(id: number, on: boolean): void;\n    41\t  svgOverlayCount(id: number): number;\n    42\t  /** watchTheme on every mount; the callback re-resolves all and redraws only canvas mounts. */\n    43\t  watch(probe: readonly [number, number]): void;\n    44\t  stopWatch(): void;\n    45\t  fired(): number;\n    46\t  records(): readonly WatchRecord[];\n    47\t  /** Text layer with three labels whose boxes are computed from canvas metrics of the layer's font. */\n    48\t  mountText(left: number, top: number): TextProbe[];\n    49\t  measureText(): TextProbe[];\n    50\t  textReuse(): { sameNodes: boolean; markupInert: boolean };\n    51\t  frames(n: number): Promise<void>;\n    52\t  time(kind: RendererKind, vertices: number, repeats: number): Promise<{ draw: number[]; painted: number[] }>;\n    53\t}\n    54\t\n    55\tdeclare global {\n    56\t  interface Window { axr: AxrApi }\n    57\t}\n    58\t\n    59\texport type { PlacedText };\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/render/timing.browser.test.ts'","aggregated_output":"     1\t/**\n     2\t * Rough timing of one path of 4,000 and of 400,000 vertices per renderer. Not a benchmark (bench/ owns\n     3\t * those) and not run by default, to keep the machine quiet: set AXYLO_RENDER_TIMING=1 to run it.\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport { start, stop } from '../harness';\n     7\timport type {} from './entries/api';\n     8\timport { close, open } from './util';\n     9\t\n    10\tconst enabled = process.env.AXYLO_RENDER_TIMING === '1';\n    11\t\n    12\tdescribe.runIf(enabled)('rough draw timing', () => {\n    13\t  beforeAll(start);\n    14\t  afterAll(stop);\n    15\t\n    16\t  it('reports draw() and draw-to-frame times', async () => {\n    17\t    const page = await open();\n    18\t    const median = (v: number[]): number => [...v].sort((a, b) => a - b)[v.length >> 1]!;\n    19\t    for (const vertices of [4000, 400000]) {\n    20\t      for (const kind of ['canvas', 'svg'] as const) {\n    21\t        const r = await page.evaluate(([k, n]) => window.axr.time(k, n, 5), [kind, vertices] as const);\n    22\t        console.log(`${kind} ${vertices} vertices: draw() median ${median(r.draw).toFixed(1)} ms (${r.draw.map(v => v.toFixed(1)).join(', ')}); to next frames median ${median(r.painted).toFixed(1)} ms`);\n    23\t        expect(r.draw).toHaveLength(5);\n    24\t      }\n    25\t    }\n    26\t    await close(page);\n    27\t  });\n    28\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/render/util.ts'","aggregated_output":"     1\timport type { BrowserContextOptions, Page } from 'playwright-core';\n     2\timport { openEntry } from '../harness';\n     3\timport { decodePng, type Image } from './png';\n     4\timport { parseColor } from '../../../src/theme/color';\n     5\t\n     6\texport const ENTRY = 'packages/axylo/test/browser/render/entries/axylo-render.entry.ts';\n     7\t\n     8\t/** Opens the blank page with the render entry loaded. The page's two buttons are hidden so nothing sits behind the marks. */\n     9\texport async function open(options: BrowserContextOptions = {}): Promise<Page> {\n    10\t  const page = await openEntry(ENTRY, options);\n    11\t  await page.addStyleTag({ content: '#before, #after { display: none; }' });\n    12\t  return page;\n    13\t}\n    14\t\n    15\texport async function close(page: Page): Promise<void> {\n    16\t  const errors = (page as Page & { errors: string[] }).errors;\n    17\t  await page.context().close();\n    18\t  if (errors.length > 0) throw new Error(`page errors: ${errors.join('; ')}`);\n    19\t}\n    20\t\n    21\t/** Screenshot of a page region, decoded. At device scale factor k the image is k times the CSS size. */\n    22\texport async function shot(page: Page, x: number, y: number, width: number, height: number): Promise<Image> {\n    23\t  return decodePng(await page.screenshot({ clip: { x, y, width, height }, animations: 'disabled', caret: 'hide' }));\n    24\t}\n    25\t\n    26\texport type RGB = readonly [number, number, number];\n    27\t\n    28\texport function at(img: Image, x: number, y: number): RGB {\n    29\t  const o = (Math.floor(y) * img.width + Math.floor(x)) * 4;\n    30\t  return [img.data[o]!, img.data[o + 1]!, img.data[o + 2]!];\n    31\t}\n    32\t\n    33\texport function rgb(color: string): RGB {\n    34\t  const c = parseColor(color);\n    35\t  if (c === null) throw new Error(`not a color: ${color}`);\n    36\t  return [Math.round(c.r * 255), Math.round(c.g * 255), Math.round(c.b * 255)];\n    37\t}\n    38\t\n    39\texport const WHITE: RGB = [255, 255, 255];\n    40\t\n    41\t/** Largest channel difference. */\n    42\texport const diff = (a: RGB | readonly number[], b: RGB | readonly number[]): number =>\n    43\t  Math.max(Math.abs(a[0]! - b[0]!), Math.abs(a[1]! - b[1]!), Math.abs(a[2]! - b[2]!));\n    44\t\n    45\t/** `color` at `alpha` over `under`. */\n    46\texport const blend = (color: RGB, alpha: number, under: RGB = WHITE): RGB =>\n    47\t  [0, 1, 2].map(i => color[i]! * alpha + under[i]! * (1 - alpha)) as unknown as RGB;\n    48\t\n    49\texport function ink(img: Image, x0: number, y0: number, x1: number, y1: number, background: RGB = WHITE, threshold = 40): number {\n    50\t  let n = 0;\n    51\t  for (let y = y0; y < y1; y++) for (let x = x0; x < x1; x++) if (diff(at(img, x, y), background) > threshold) n++;\n    52\t  return n;\n    53\t}\n    54\t\n    55\texport const frames = (page: Page, n = 2): Promise<void> => page.evaluate(k => window.axr.frames(k), n);\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/render/render.browser.test.ts'","aggregated_output":"     1\t/**\n     2\t * Both mark renderers draw the same hand-built scene (entries/axylo-render.entry.ts, `fixedScene`), checked\n     3\t * by sampling screenshot pixels at points chosen from the scene's coordinates. Expected colors are the\n     4\t * default light palette (theme/palette.ts) on the page's white background.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport { LIGHT } from '../../../src/theme/palette';\n    10\timport type {} from './entries/api';\n    11\timport { at, blend, close, diff, ink, open, rgb, shot, WHITE, type RGB } from './util';\n    12\timport type { Image } from './png';\n    13\t\n    14\tconst ORIGIN = { canvas: [20, 60], svg: [460, 60] } as const;\n    15\tconst series = (i: number): RGB => rgb(LIGHT.series[i]!);\n    16\t\n    17\tbeforeAll(start);\n    18\tafterAll(stop);\n    19\t\n    20\tdescribe('fixed scene, both renderers', () => {\n    21\t  let page: Page;\n    22\t  const images: Record<'canvas' | 'svg', Image> = {} as Record<'canvas' | 'svg', Image>;\n    23\t\n    24\t  beforeAll(async () => {\n    25\t    page = await open();\n    26\t    await page.evaluate(([c, s]) => {\n    27\t      window.axr.mount('canvas', c[0], c[1]);\n    28\t      window.axr.mount('svg', s[0], s[1]);\n    29\t    }, [ORIGIN.canvas, ORIGIN.svg] as const);\n    30\t    for (const kind of ['canvas', 'svg'] as const) images[kind] = await shot(page, ORIGIN[kind][0], ORIGIN[kind][1], 400, 300);\n    31\t  });\n    32\t  afterAll(async () => { await close(page); });\n    33\t\n    34\t  for (const kind of ['canvas', 'svg'] as const) {\n    35\t    describe(kind, () => {\n    36\t      const px = (x: number, y: number): RGB => at(images[kind], x, y);\n    37\t\n    38\t      it('path: stroke where it passes, background where the pen was lifted, nothing past the clip', () => {\n    39\t        expect(diff(px(85, 50), series(0))).toBeLessThanOrEqual(8);\n    40\t        expect(diff(px(120, 75), series(0))).toBeLessThanOrEqual(8);\n    41\t        expect(diff(px(300, 120), series(0))).toBeLessThanOrEqual(8);\n    42\t        // On the straight line between the last vertex before the lift (120,100) and the first after (160,120).\n    43\t        expect(diff(px(130, 105), WHITE)).toBeLessThanOrEqual(2);\n    44\t        expect(diff(px(140, 110), series(0))).toBeGreaterThan(60);\n    45\t        // x 388 is past the clip's right edge (380).\n    46\t        expect(diff(px(388, 120), WHITE)).toBeLessThanOrEqual(2);\n    47\t      });\n    48\t\n    49\t      it('path: solid in normal mode (the contrast dash is not used)', () => {\n    50\t        for (let x = 165; x < 375; x++) expect(diff(px(x, 120), series(0)), `x ${x}`).toBeLessThanOrEqual(30);\n    51\t      });\n    52\t\n    53\t      it('area: one translucent polygon per run, nothing between the runs', () => {\n    54\t        expect(diff(px(55, 180), blend(series(1), 0.5))).toBeLessThanOrEqual(6);\n    55\t        expect(diff(px(150, 180), blend(series(1), 0.5))).toBeLessThanOrEqual(6);\n    56\t        expect(diff(px(120, 180), WHITE)).toBeLessThanOrEqual(2);\n    57\t        // Above the upper boundary of run 1 (y 140 at x 80).\n    58\t        expect(diff(px(52, 138), WHITE)).toBeLessThanOrEqual(2);\n    59\t      });\n    60\t\n    61\t      it('bars are filled; the missing bar is a hollow mark at the baseline, unlike an empty slot', () => {\n    62\t        expect(diff(px(210, 220), series(2))).toBeLessThanOrEqual(4);\n    63\t        expect(diff(px(240, 150), series(2))).toBeLessThanOrEqual(4);\n    64\t        const img = images[kind];\n    65\t        const missing = ink(img, 256, 245, 284, 260);\n    66\t        const empty = ink(img, 288, 245, 312, 260);\n    67\t        expect(missing).toBeGreaterThanOrEqual(30);\n    68\t        expect(empty).toBe(0);\n    69\t        // Hollow: well inside the box but off the diagonal is background, so it cannot read as a short bar.\n    70\t        expect(diff(px(264, 254), WHITE)).toBeLessThanOrEqual(10);\n    71\t        // Its outline is the series color, and it stands on the baseline (nothing above y 245).\n    72\t        expect(diff(px(260, 256), series(2))).toBeLessThanOrEqual(30);\n    73\t        expect(ink(img, 256, 230, 284, 245)).toBe(0);\n    74\t      });\n    75\t\n    76\t      it('points: all eight marker shapes are drawn, filled, and differ', () => {\n    77\t        const counts: number[] = [];\n    78\t        for (let k = 0; k < 8; k++) {\n    79\t          const x = 50 + 20 * k;\n    80\t          expect(diff(px(x, 235), series(3)), `shape ${k}`).toBeLessThanOrEqual(8);\n    81\t          counts.push(ink(images[kind], x - 7, 228, x + 7, 242));\n    82\t        }\n    83\t        for (const n of counts) expect(n).toBeGreaterThan(15);\n    84\t        expect(new Set(counts).size).toBeGreaterThanOrEqual(5);\n    85\t      });\n    86\t\n    87\t      it('ring: four slices in their colors with background gaps between them', () => {\n    88\t        const mid = 32.5;\n    89\t        for (let k = 0; k < 4; k++) {\n    90\t          const a = Math.PI / 4 + (k * Math.PI) / 2;\n    91\t          expect(diff(px(300 + mid * Math.sin(a), 60 - mid * Math.cos(a)), series(4 + k)), `slice ${k}`).toBeLessThanOrEqual(8);\n    92\t        }\n    93\t        // Gap centres at 12, 3, 6 and 9 o'clock (4 px wide).\n    94\t        for (const [x, y] of [[299, 27], [300, 27], [332, 59], [332, 60], [299, 92], [300, 92], [267, 59], [267, 60]] as const) {\n    95\t          expect(diff(px(x, y), WHITE), `gap ${x},${y}`).toBeLessThanOrEqual(12);\n    96\t        }\n    97\t        // Inside the hole.\n    98\t        expect(diff(px(300, 60), WHITE)).toBeLessThanOrEqual(2);\n    99\t      });\n   100\t\n   101\t      it('clip: grid outside the clip is not drawn, axis and tick rules outside it are', () => {\n   102\t        expect(diff(px(25, 110), WHITE)).toBeLessThanOrEqual(2);\n   103\t        expect(diff(px(385, 110), WHITE)).toBeLessThanOrEqual(2);\n   104\t        expect(diff(px(370, 110), rgb(LIGHT.grid))).toBeLessThanOrEqual(3);\n   105\t        expect(diff(px(300, 260), rgb(LIGHT.axis))).toBeLessThanOrEqual(3);\n   106\t        expect(diff(px(200, 265), rgb(LIGHT.axis))).toBeLessThanOrEqual(3);\n   107\t        expect(diff(px(40, 200), rgb(LIGHT.axis))).toBeLessThanOrEqual(3);\n   108\t        // A crisp 1 px rule: the rows next to the x axis are background.\n   109\t        expect(diff(px(300, 259), WHITE)).toBeLessThanOrEqual(2);\n   110\t        expect(diff(px(300, 261), WHITE)).toBeLessThanOrEqual(2);\n   111\t      });\n   112\t\n   113\t      it('band: translucent fill', () => {\n   114\t        expect(diff(px(80, 90), blend(rgb(LIGHT.reference), 0.15))).toBeLessThanOrEqual(4);\n   115\t      });\n   116\t    });\n   117\t  }\n   118\t\n   119\t  it('the two renderers agree at a grid of points, within antialiasing tolerance', () => {\n   120\t    let total = 0, off = 0, sum = 0, worst = 0;\n   121\t    for (let y = 1; y < 300; y += 4) for (let x = 1; x < 400; x += 4) {\n   122\t      const d = diff(at(images.canvas, x, y), at(images.svg, x, y));\n   123\t      total++;\n   124\t      sum += d;\n   125\t      worst = Math.max(worst, d);\n   126\t      if (d > 40) off++;\n   127\t    }\n   128\t    console.log(`renderer agreement: ${total} points, ${off} differ by more than 40/255, mean difference ${(sum / total).toFixed(2)}, worst ${worst}`);\n   129\t    expect(off / total).toBeLessThanOrEqual(0.005);\n   130\t    expect(sum / total).toBeLessThan(1);\n   131\t  });\n   132\t\n   133\t  it('marker ink agrees between the renderers', () => {\n   134\t    for (let k = 0; k < 8; k++) {\n   135\t      const x = 50 + 20 * k;\n   136\t      const a = ink(images.canvas, x - 7, 228, x + 7, 242), b = ink(images.svg, x - 7, 228, x + 7, 242);\n   137\t      expect(Math.abs(a - b), `shape ${k}`).toBeLessThanOrEqual(Math.max(3, 0.12 * a));\n   138\t    }\n   139\t  });\n   140\t});\n   141\t\n   142\tdescribe('overlay and reuse', () => {\n   143\t  let page: Page;\n   144\t  beforeAll(async () => {\n   145\t    page = await open();\n   146\t    await page.evaluate(() => { window.axr.mount('canvas', 20, 60); window.axr.mount('svg', 460, 60); });\n   147\t  });\n   148\t  afterAll(async () => { await close(page); });\n   149\t\n   150\t  it('canvas: drawOverlay paints only the overlay canvas, clipped and unclipped lists honoured, null clears it', async () => {\n   151\t    await page.evaluate(() => window.axr.overlay(0, true));\n   152\t    const r = await page.evaluate(() => ({\n   153\t      cursor: window.axr.canvasPixel(0, 330, 100, 'overlay'),\n   154\t      cursorPastClip: window.axr.canvasPixel(0, 330, 280, 'overlay'),\n   155\t      focus: window.axr.canvasPixel(0, 20, 280, 'overlay'),\n   156\t      sceneAtCursor: window.axr.canvasPixel(0, 330, 100, 'scene'),\n   157\t      draws: window.axr.draws(0),\n   158\t    }));\n   159\t    expect(r.cursor[3]).toBe(255);\n   160\t    expect(r.cursorPastClip[3]).toBe(0);\n   161\t    expect(r.focus[3]).toBe(255);\n   162\t    expect(diff(r.focus, rgb(LIGHT.focus))).toBeLessThanOrEqual(2);\n   163\t    expect(r.sceneAtCursor[3]).toBe(0);\n   164\t    expect(r.draws).toBe(1);\n   165\t    await page.evaluate(() => window.axr.overlay(0, false));\n   166\t    expect((await page.evaluate(() => window.axr.canvasPixel(0, 330, 100, 'overlay')))[3]).toBe(0);\n   167\t  });\n   168\t\n   169\t  it('svg: drawOverlay replaces its own group and leaves the scene alone', async () => {\n   170\t    await page.evaluate(() => window.axr.overlay(1, true));\n   171\t    expect(await page.evaluate(() => window.axr.svgOverlayCount(1))).toBe(2);\n   172\t    const img = await shot(page, 460, 60, 400, 300);\n   173\t    expect(diff(at(img, 330, 100), rgb(LIGHT.focus))).toBeLessThanOrEqual(4);\n   174\t    expect(diff(at(img, 330, 280), WHITE)).toBeLessThanOrEqual(2);\n   175\t    expect(diff(at(img, 20, 280), rgb(LIGHT.focus))).toBeLessThanOrEqual(4);\n   176\t    expect(await page.evaluate(() => window.axr.draws(1))).toBe(1);\n   177\t    await page.evaluate(() => window.axr.overlay(1, false));\n   178\t    expect(await page.evaluate(() => window.axr.svgOverlayCount(1))).toBe(0);\n   179\t  });\n   180\t\n   181\t  it('svg: a draw with the same mark list reuses every element and only rewrites what changed', async () => {\n   182\t    const r = await page.evaluate(() => window.axr.svgReuse(1));\n   183\t    expect(r.count).toBe(18);\n   184\t    expect(r.sameNodes).toBe(true);\n   185\t    expect(r.dChanged).toBe(true);\n   186\t  });\n   187\t});\n   188\t\n   189\tdescribe('device pixel ratio 2', () => {\n   190\t  let page: Page;\n   191\t  beforeAll(async () => {\n   192\t    page = await open({ deviceScaleFactor: 2 });\n   193\t    await page.evaluate(() => { window.axr.mount('canvas', 20, 60); window.axr.mount('svg', 460, 60); });\n   194\t  });\n   195\t  afterAll(async () => { await close(page); });\n   196\t\n   197\t  /** Indexes of the inked entries of a strip of pixels; asserts they are one run of fully inked pixels. */\n   198\t  function crisp(values: readonly (readonly number[])[], inked: (v: readonly number[]) => boolean, full: (v: readonly number[]) => boolean): number {\n   199\t    const hits = values.map((v, i) => (inked(v) ? i : -1)).filter(i => i >= 0);\n   200\t    expect(hits.length).toBeGreaterThan(0);\n   201\t    expect(hits[hits.length - 1]! - hits[0]! + 1).toBe(hits.length);\n   202\t    for (const i of hits) expect(full(values[i]!), `entry ${i}: ${values[i]!.join(',')}`).toBe(true);\n   203\t    return hits.length;\n   204\t  }\n   205\t\n   206\t  it('canvas: backing store is twice the CSS size, and a 1 px rule covers exactly two whole device rows', async () => {\n   207\t    const info = await page.evaluate(() => window.axr.canvasInfo(0));\n   208\t    expect(info).toEqual({ width: 800, height: 600, cssWidth: 400, cssHeight: 300 });\n   209\t    const column = await page.evaluate(() => Array.from({ length: 21 }, (_, k) => window.axr.canvasPixel(0, 600, 510 + k)));\n   210\t    expect(crisp(column, v => v[3]! > 0, v => v[3] === 255 && diff(v, rgb(LIGHT.axis)) <= 1)).toBe(2);\n   211\t    const row = await page.evaluate(() => Array.from({ length: 21 }, (_, k) => window.axr.canvasPixel(0, 70 + k, 400)));\n   212\t    expect(crisp(row, v => v[3]! > 0, v => v[3] === 255 && diff(v, rgb(LIGHT.axis)) <= 1)).toBe(2);\n   213\t  });\n   214\t\n   215\t  it('svg: the same rule is two whole device rows on screen', async () => {\n   216\t    const img = await shot(page, 460, 60, 400, 300);\n   217\t    expect(img.width).toBe(800);\n   218\t    const column = Array.from({ length: 21 }, (_, k) => at(img, 600, 510 + k));\n   219\t    expect(crisp(column, v => diff(v, WHITE) > 2, v => diff(v, rgb(LIGHT.axis)) <= 2)).toBe(2);\n   220\t    const row = Array.from({ length: 21 }, (_, k) => at(img, 70 + k, 400));\n   221\t    expect(crisp(row, v => diff(v, WHITE) > 2, v => diff(v, rgb(LIGHT.axis)) <= 2)).toBe(2);\n   222\t  });\n   223\t});\n","exit_code":0,"status":"completed"}}
