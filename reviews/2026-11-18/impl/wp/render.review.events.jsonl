 i => neg.values[i] !== negative!.values[i]);\n   169\t    }\n   170\t    areas.push({ type: 'area', series, upper, lower, runs: Uint32Array.from(runs), fill: seriesPaint(series), opacity: 0.8 });\n   171\t    positive = pos;\n   172\t    negative = neg;\n   173\t    lower = upper;\n   174\t\n   175\t    const positiveLine = stack.positive[k]!;\n   176\t    const negativeLine = stack.negative[k]!;\n   177\t    const length = draw.end - draw.start;\n   178\t    let hasNegative = false;\n   179\t    let hasNonNegative = false;\n   180\t    for (let i = draw.start; i < draw.end && !(hasNegative && hasNonNegative); i++) {\n   181\t      if (y[i]! < 0) hasNegative = true;\n   182\t      else if (y[i]! >= 0) hasNonNegative = true;\n   183\t    }\n   184\t    const line = hasNegative && hasNonNegative\n   185\t      ? Float64Array.from(y.subarray(draw.start, draw.end), (value, i) =>\n   186\t        (value < 0 ? negativeLine : positiveLine)[draw.start + i]!)\n   187\t      : (hasNegative ? negativeLine : positiveLine).subarray(draw.start, draw.end);\n   188\t    addLine({\n   189\t      ...input, x: input.x.subarray(draw.start, draw.end), y: line, slot: slot.subarray(draw.start, draw.end),\n   190\t      range: { start: 0, end: length },\n   191\t    }, view, series, {\n   192\t      start: view.visibleSlots.start - draw.start, end: view.visibleSlots.end - draw.start,\n   193\t    }, compact, paths, points);\n   194\t  }\n   195\t}\n     1\timport type {\n     2\t  AreaMark, BandMark, DonutView, Layout, Mark, Paint, PathMark, PointMark, Projection, Rect, RuleMark, Scene, View,\n     3\t} from '../core/contracts';\n     4\timport { addArea, addStackedAreas } from './areas';\n     5\timport { barMarks } from './bars';\n     6\timport { clamp, position, rule, seriesPaint, token } from './geometry';\n     7\timport { addLine, drawing, scatterPoints } from './lines';\n     8\t\n     9\ttype Plot = Extract<Layout, { kind: 'plot' }>;\n    10\ttype Cartesian = Exclude<Projection, { kind: 'ring' }>;\n    11\t\n    12\tconst TICK_LENGTH = 4;\n    13\t\n    14\tfunction axes(projection: Cartesian) {\n    15\t  return projection.kind === 'bands'\n    16\t    ? { x: projection.band, y: projection.value, horizontal: projection.horizontal }\n    17\t    : { x: projection.x, y: projection.y, horizontal: false };\n    18\t}\n    19\t\n    20\tfunction gridAndAxes(layout: Plot, projection: Cartesian): { grid: RuleMark[]; edges: RuleMark[] } {\n    21\t  const { x, y, horizontal } = axes(projection);\n    22\t  const { x: left, y: top, width, height } = layout.plot;\n    23\t  const right = left + width;\n    24\t  const bottom = top + height;\n    25\t  const axis = token('axis');\n    26\t  const gridPaint = token('grid');\n    27\t  const grid: RuleMark[] = [];\n    28\t  const edges = [rule('axis', axis, left, bottom, right, bottom), rule('axis', axis, left, top, left, bottom)];\n    29\t  const bottomScale = horizontal ? y : x;\n    30\t  const leftScale = horizontal ? x : y;\n    31\t  for (const tick of horizontal ? layout.yTicks : layout.xTicks) {\n    32\t    const pixel = position(bottomScale, tick.value);\n    33\t    if (pixel < left || pixel > right) continue;\n    34\t    edges.push(rule('tick', axis, pixel, bottom, pixel, bottom + TICK_LENGTH));\n    35\t  }\n    36\t  for (const tick of horizontal ? layout.xTicks : layout.yTicks) {\n    37\t    const pixel = position(leftScale, tick.value);\n    38\t    if (pixel < top || pixel > bottom) continue;\n    39\t    edges.push(rule('tick', axis, left - TICK_LENGTH, pixel, left, pixel));\n    40\t  }\n    41\t  for (const tick of layout.yTicks) {\n    42\t    const pixel = position(y, tick.value);\n    43\t    if (horizontal && pixel >= left && pixel <= right) grid.push(rule('grid', gridPaint, pixel, top, pixel, bottom));\n    44\t    if (!horizontal && pixel >= top && pixel <= bottom) grid.push(rule('grid', gridPaint, left, pixel, right, pixel));\n    45\t  }\n    46\t  return { grid, edges };\n    47\t}\n    48\t\n    49\tfunction references(view: Exclude<View, DonutView>, projection: Cartesian, plot: Rect): {\n    50\t  bands: BandMark[]; lines: RuleMark[];\n    51\t} {\n    52\t  const { x, y, horizontal } = axes(projection);\n    53\t  const bands: BandMark[] = [];\n    54\t  const lines: RuleMark[] = [];\n    55\t  const paint = token('reference');\n    56\t  for (const { axis, from, to } of view.references) {\n    57\t    const scale = axis === 'x' ? x : y;\n    58\t    const across = (axis === 'x') !== horizontal;\n    59\t    const start = across ? plot.x : plot.y;\n    60\t    const end = start + (across ? plot.width : plot.height);\n    61\t    const a = position(scale, from);\n    62\t    const b = position(scale, to);\n    63\t    if (from === to) {\n    64\t      if (a < start || a > end) continue;\n    65\t      lines.push(across ? rule('reference', paint, a, plot.y, a, plot.y + plot.height)\n    66\t        : rule('reference', paint, plot.x, a, plot.x + plot.width, a));\n    67\t    } else {\n    68\t      const low = clamp(Math.min(a, b), start, end);\n    69\t      const high = clamp(Math.max(a, b), start, end);\n    70\t      if (low === high) continue;\n    71\t      const box = across ? { ...plot, x: low, width: high - low } : { ...plot, y: low, height: high - low };\n    72\t      bands.push({ type: 'band', box, fill: paint, opacity: 0.12 });\n    73\t    }\n    74\t  }\n    75\t  return { bands, lines };\n    76\t}\n    77\t\n    78\tfunction arcMarks(view: DonutView, projection: Extract<Projection, { kind: 'ring' }>): Mark[] {\n    79\t  const angles: number[] = [];\n    80\t  const fills: Paint[] = [];\n    81\t  for (let k = 0; k < view.slices.length; k++) {\n    82\t    const slice = view.slices[k]!;\n    83\t    if (slice.angles === null) continue;\n    84\t    angles.push(...slice.angles);\n    85\t    fills.push(slice.key === '__other__' && slice.members.length > 1 ? token('muted') : seriesPaint(k));\n    86\t  }\n    87\t  if (!angles.length) return [];\n    88\t  const { cx, cy, r0, r1 } = projection;\n    89\t  return [{ type: 'arcs', cx, cy, r0, r1, angles: Float32Array.from(angles), fills, gap: 1 }];\n    90\t}\n    91\t\n    92\texport function buildScene(view: View, layout: Layout, devicePixelRatio: number): Scene {\n    93\t  const { width, height } = layout;\n    94\t  if (layout.kind !== 'plot' && layout.kind !== 'compact') {\n    95\t    return { width, height, clip: { x: 0, y: 0, width, height }, marks: [] };\n    96\t  }\n    97\t  const { plot: clip, projection } = layout;\n    98\t  if (projection.kind === 'ring' || view.kind === 'donut') {\n    99\t    const marks = projection.kind === 'ring' && view.kind === 'donut' ? arcMarks(view, projection) : [];\n   100\t    return { width, height, clip, marks };\n   101\t  }\n   102\t\n   103\t  const compact = layout.kind === 'compact' || view.compact;\n   104\t  const { grid, edges } = layout.kind === 'plot' && !compact ? gridAndAxes(layout, projection) : { grid: [], edges: [] };\n   105\t  const { bands, lines } = compact ? { bands: [], lines: [] } : references(view, projection, clip);\n   106\t  const layers: (readonly Mark[])[] = [bands, grid];\n   107\t  if (view.kind === 'bar' && projection.kind === 'bands') {\n   108\t    layers.push(barMarks(view, projection, clip));\n   109\t  } else if (view.kind === 'scatter' && projection.kind === 'xy') {\n   110\t    layers.push(scatterPoints(view, projection));\n   111\t  } else if ((view.kind === 'line' || view.kind === 'area') && projection.kind === 'xy') {\n   112\t    const areas: AreaMark[] = [];\n   113\t    const seams: PathMark[] = [];\n   114\t    const paths: PathMark[] = [];\n   115\t    const points: PointMark[] = [];\n   116\t    const dpr = Number.isFinite(devicePixelRatio) && devicePixelRatio > 0 ? devicePixelRatio : 1;\n   117\t    const draw = drawing(view.frame.x.values, projection, clip, dpr);\n   118\t    if (view.kind === 'area' && view.stack) {\n   119\t      addStackedAreas(draw, view, view.stack, compact, areas, seams, paths, points);\n   120\t    } else {\n   121\t      for (let i = 0; i < view.frame.series.length; i++) {\n   122\t        if (!view.visible[i]) continue;\n   123\t        const { slot, y } = view.frame.series[i]!;\n   124\t        const input = { ...draw, range: view.drawSlots[i]!, slot, y };\n   125\t        if (view.kind === 'area') addArea(input, view, i, compact, areas, paths, points);\n   126\t        else addLine(input, view, i, view.visibleSlots, compact, paths, points);\n   127\t      }\n   128\t    }\n   129\t    layers.push(areas, seams, paths, points);\n   130\t  }\n   131\t  layers.push(edges, lines);\n   132\t  return { width, height, clip, marks: layers.flat() };\n   133\t}\n","exit_code":0,"status":"completed"}}
