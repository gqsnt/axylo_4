itive - 7) : '';\n    35\t  if (grouped) report(sink, 'AX121', 'changed', { field: frame.valueLabel, count: positive - 7 });\n    36\t  const scaled = !Number.isFinite(total);\n    37\t  let denominator = total;\n    38\t  if (scaled) {\n    39\t    report(sink, 'AX103', 'changed', { field: frame.valueLabel });\n    40\t    denominator = 0;\n    41\t    for (let i = 0; i < frame.values.length; i++) {\n    42\t      if (frame.slot[i] === SLOT_VALUE) denominator += frame.values[i]! / max;\n    43\t    }\n    44\t  }\n    45\t  if (previous?.frame === frame && (!grouped || previous.slices.at(-1)?.label === label)) return previous;\n    46\t\n    47\t  const slices: DonutSlice[] = [];\n    48\t  let angle = 0;\n    49\t  let drawn = 0;\n    50\t  const drawnCount = grouped ? 8 : positive;\n    51\t  function add(key: string, label: string, members: readonly number[], value: number | null, weight: number): void {\n    52\t    const ratio = value === null ? null : weight === 0 ? 0 : weight / denominator;\n    53\t    let angles: DonutSlice['angles'] = null;\n    54\t    if (value !== null && value > 0) {\n    55\t      const end = ++drawn === drawnCount ? TURN : Math.min(TURN, angle + ratio! * TURN);\n    56\t      angles = [angle, end];\n    57\t      angle = end;\n    58\t    }\n    59\t    slices.push({ key, label, members, value, ratio, angles });\n    60\t  }\n    61\t\n    62\t  const kept = grouped ? new Set(largest) : null;\n    63\t  const others: number[] = [];\n    64\t  let otherValue = 0;\n    65\t  let otherWeight = 0;\n    66\t  for (let i = 0; i < frame.labels.length; i++) {\n    67\t    const name = frame.labels[i]!;\n    68\t    const value = frame.slot[i] === SLOT_VALUE ? frame.values[i]! : null;\n    69\t    const weight = scaled ? (value ?? 0) / max : value ?? 0;\n    70\t    if (kept && value !== null && value > 0 && !kept.has(i)) {\n    71\t      others.push(i);\n    72\t      otherValue += value;\n    73\t      otherWeight += weight;\n    74\t    } else {\n    75\t      const key = name.startsWith(OTHER) ? OTHER + name : name;\n    76\t      add(key, name, [i], value, weight);\n    77\t    }\n    78\t  }\n    79\t  if (grouped) add(OTHER, label, others, otherValue, otherWeight);\n    80\t  return { ...result, slices, total };\n    81\t}\n     1\timport {\n     2\t  SLOT_VALUE, type AlignedView, type IndexRange, type PathMark, type PointMark, type Projection,\n     3\t  type Rect, type ScatterView, type SeriesCue,\n     4\t} from '../core/contracts';\n     5\timport { buildPath, buildPoints, simplifyLine, type JoinedRuns, type LineInput } from '../simplify';\n     6\timport { position, seriesPaint } from './geometry';\n     7\t\n     8\texport type XY = Extract<Projection, { kind: 'xy' }>;\n     9\texport type Drawing = Omit<LineInput, 'y' | 'slot' | 'range'> & {\n    10\t  readonly mapX: (x: number) => number;\n    11\t  readonly mapY: (y: number) => number;\n    12\t};\n    13\t\n    14\texport function drawing(x: Float64Array, xy: XY, plot: Rect, devicePixelRatio: number): Drawing {\n    15\t  return {\n    16\t    x, mapX: value => position(xy.x, value), mapY: value => position(xy.y, value),\n    17\t    left: plot.x, width: plot.width, devicePixelRatio,\n    18\t  };\n    19\t}\n    20\t\n    21\tfunction markerIndexes(\n    22\t  input: LineInput & Drawing, range: IndexRange, isolated: Uint32Array, compact: boolean,\n    23\t): Uint32Array {\n    24\t  if (compact) return isolated;\n    25\t  const { slot, x, mapX } = input;\n    26\t  let count = 0;\n    27\t  let first = range.end;\n    28\t  let last = range.start;\n    29\t  for (let i = range.start; i < range.end; i++) {\n    30\t    if (slot[i] !== SLOT_VALUE) continue;\n    31\t    if (count++ === 0) first = i;\n    32\t    last = i;\n    33\t  }\n    34\t  if (!count) return isolated;\n    35\t  const span = Math.abs(mapX(x[last]!) - mapX(x[first]!));\n    36\t  const showAll = count <= 1 || span >= 12 * (count - 1);\n    37\t  const capacity = showAll ? count : Math.min(count, Math.floor(span / 80) + 1 + isolated.length);\n    38\t  const indexes = new Uint32Array(capacity);\n    39\t  let write = capacity;\n    40\t  let previous = Infinity;\n    41\t  let single = isolated.length - 1;\n    42\t  // Walk back from the last observed value so the series always has its identity at that end.\n    43\t  for (let i = last; i >= first; i--) {\n    44\t    if (slot[i] !== SLOT_VALUE) continue;\n    45\t    const pixel = mapX(x[i]!);\n    46\t    const required = isolated[single] === i;\n    47\t    if (required) single--;\n    48\t    if (showAll || required || Math.abs(previous - pixel) >= 80) {\n    49\t      indexes[--write] = i;\n    50\t      previous = pixel;\n    51\t    }\n    52\t  }\n    53\t  return indexes.subarray(write);\n    54\t}\n    55\t\n    56\tfunction pointMark(series: number, cue: SeriesCue, xy: Float32Array): PointMark {\n    57\t  return { type: 'points', series, xy, shape: cue.marker, size: 6, fill: seriesPaint(series) };\n    58\t}\n    59\t\n    60\texport function addLine(\n    61\t  input: LineInput & Drawing, view: AlignedView, series: number, visible: IndexRange, compact: boolean,\n    62\t  paths: PathMark[], points: PointMark[], selection: JoinedRuns = simplifyLine(input),\n    63\t): void {\n    64\t  const cue = view.cues[series]!;\n    65\t  if (selection.indexes.length) {\n    66\t    paths.push({\n    67\t      type: 'path', series, xy: buildPath(selection.indexes, selection.breaks, input), stroke: seriesPaint(series),\n    68\t      strokeWidth: 2, dash: cue.dash,\n    69\t    });\n    70\t  }\n    71\t  const markers = markerIndexes(input, visible, selection.isolated, compact);\n    72\t  if (markers.length) points.push(pointMark(series, cue, buildPoints(markers, input)));\n    73\t}\n    74\t\n    75\texport function scatterPoints(view: ScatterView, projection: XY): PointMark[] {\n    76\t  const result: PointMark[] = [];\n    77\t  for (let i = 0; i < view.frame.series.length; i++) {\n    78\t    if (!view.visible[i]) continue;\n    79\t    const { x, y } = view.frame.series[i]!;\n    80\t    const { start, end } = view.visiblePoints[i]!;\n    81\t    const xy = new Float32Array(2 * (end - start));\n    82\t    for (let index = start, out = 0; index < end; index++) {\n    83\t      xy[out++] = position(projection.x, x[index]!);\n    84\t      xy[out++] = position(projection.y, y[index]!);\n    85\t    }\n    86\t    result.push(pointMark(i, view.cues[i]!, xy));\n    87\t  }\n    88\t  return result;\n    89\t}\n    90\t\n     1\timport type { AxisLabelFit, LabelRemedy, PlacedText, Tick, TickCandidates, XScale } from '../core/contracts';\n     2\t\n     3\ttype Role = PlacedText['role'];\n     4\ttype Side = 'bottom' | 'left';\n     5\t\n     6\texport interface Metrics {\n     7\t  readonly lineHeight: number;\n     8\t  width(text: string): number;\n     9\t}\n    10\t\n    11\tinterface Label {\n    12\t  readonly tick: Tick;\n    13\t  readonly text: PlacedText;\n    14\t}\n    15\t\n    16\texport interface FittedLabels {\n    17\t  readonly ticks: readonly Tick[];\n    18\t  readonly texts: readonly PlacedText[];\n    19\t  readonly depth: number;\n    20\t  readonly fit: AxisLabelFit;\n    21\t}\n    22\t\n    23\tconst EPSILON = 1e-7;\n    24\tconst DIAGONAL = Math.SQRT1_2;\n    25\tconst ELLIPSIS = '…';\n    26\tconst segmenter = new Intl.Segmenter(undefined, { granularity: 'grapheme' });\n    27\t\n    28\texport function placeText(\n    29\t  lines: readonly string[], full: string, x: number, y: number,\n    30\t  anchor: PlacedText['anchor'], baseline: PlacedText['baseline'], rotate: 0 | -45 | -90,\n    31\t  role: Role, metrics: Metrics,\n    32\t): PlacedText {\n    33\t  const width = widest(lines, metrics);\n    34\t  const height = lines.length * metrics.lineHeight;\n    35\t  const left = anchor === 'start' ? 0 : anchor === 'middle' ? -width / 2 : -width;\n    36\t  const top = baseline === 'top' ? 0 : baseline === 'middle' ? -height / 2 : -height;\n    37\t  const sine = rotate === 0 ? 0 : rotate === -45 ? DIAGONAL : 1;\n    38\t  const cosine = rotate === 0 ? 1 : rotate === -45 ? DIAGONAL : 0;\n    39\t  return {\n    40\t    lines, full, x, y, anchor, baseline, rotate, role,\n    41\t    box: {\n    42\t      x: x + left * cosine + top * sine,\n    43\t      y: y - (left + width) * sine + top * cosine,\n    44\t      width: width * cosine + height * sine,\n    45\t      height: width * sine + height * cosine,\n    46\t    },\n    47\t  };\n    48\t}\n    49\t\n    50\tfunction widest(lines: readonly string[], metrics: Metrics): number {\n    51\t  let width = 0;\n    52\t  for (const line of lines) width = Math.max(width, metrics.width(line));\n    53\t  return width;\n    54\t}\n    55\t\n    56\tfunction graphemes(text: string): string[] {\n    57\t  return Array.from(segmenter.segment(text), part => part.segment);\n    58\t}\n    59\t\n    60\texport function wrapText(text: string, limit: number, metrics: Metrics, lineLimit = Infinity): string[] {\n    61\t  if (metrics.width(text) <= limit && !text.includes('\\n')) return [text];\n    62\t  const lines: string[] = [];\n    63\t  for (const paragraph of text.split('\\n')) {\n    64\t    let line = '';\n    65\t    for (const word of paragraph.trim().split(/\\s+/u)) {\n    66\t      const joined = line ? line + ' ' + word : word;\n    67\t      if (metrics.width(joined) <= limit) {\n    68\t        line = joined;\n    69\t        continue;\n    70\t      }\n    71\t      if (line && lines.push(line) === lineLimit) return lines;\n    72\t      line = '';\n    73\t      if (metrics.width(word) <= limit) {\n    74\t        line = word;\n    75\t        continue;\n    76\t      }\n    77\t      for (const glyph of graphemes(word)) {\n    78\t        if (line && metrics.width(line + glyph) > limit) {\n    79\t          if (lines.push(line) === lineLimit) return lines;\n    80\t          line = '';\n    81\t        }\n    82\t