erica', 'and Europe'], 100, 200, 'middle', 'top', 0, font, lh),\n   232\t      placed(['1,250 kWh'], 380, 50, 'end', 'middle', 0, font, lh),\n   233\t      placed(['Sessions per day'], 20, 150, 'middle', 'bottom', -90, font, lh),\n   234\t    ];\n   235\t    layer.render(texts);\n   236\t    text = { layer, root, texts };\n   237\t    return measure();\n   238\t  },\n   239\t  measureText: (): TextProbe[] => measure(),\n   240\t  textReuse() {\n   241\t    const t = text!;\n   242\t    const before = Array.from(t.layer.element.querySelectorAll('div'));\n   243\t    t.layer.render(t.texts);\n   244\t    const after = Array.from(t.layer.element.querySelectorAll('div'));\n   245\t    const markup = createTextLayer();\n   246\t    markup.render([{ ...t.texts[2]!, lines: ['<b>bold</b> & <img src=x>'] }]);\n   247\t    const inert = markup.element.querySelector('b, img') === null && markup.element.textContent === '<b>bold</b> & <img src=x>';\n   248\t    return { sameNodes: before.length === after.length && before.every((el, i) => el === after[i]), markupInert: inert };\n   249\t  },\n   250\t  frames,\n   251\t  async time(kind: RendererKind, vertices: number, repeats: number) {\n   252\t    const root = makeRoot(0, 0);\n   253\t    ensureStyles(document);\n   254\t    const renderer = kind === 'canvas' ? createCanvasRenderer() : createSvgRenderer();\n   255\t    root.appendChild(renderer.element);\n   256\t    const scene = lineScene(vertices);\n   257\t    const m: Mounted = { kind, root, renderer, keys: DEFAULT_KEYS, colors: undefined, scene, draws: 0 };\n   258\t    const { bindings, theme } = resolveTheme(root, m.keys, undefined);\n   259\t    const drawTimes: number[] = [], painted: number[] = [];\n   260\t    for (let i = 0; i < repeats; i++) {\n   261\t      // A fresh array each time so the SVG renderer cannot skip the write because `d` is unchanged.\n   262\t      const xy = (scene.marks[0] as { xy: Float32Array }).xy.slice();\n   263\t      xy[1] = xy[1]! + (i % 2) * 0.5;\n   264\t      const s: Scene = { ...scene, marks: [{ ...(scene.marks[0] as Mark & { type: 'path' }), xy }] };\n   265\t      await frames(1);\n   266\t      const t0 = performance.now();\n   267\t      renderer.draw(s, bindings, theme, window.devicePixelRatio);\n   268\t      const t1 = performance.now();\n   269\t      // Force style and layout now, then wait for the frame to be produced.\n   270\t      void root.getBoundingClientRect();\n   271\t      await frames(2);\n   272\t      const t2 = performance.now();\n   273\t      drawTimes.push(t1 - t0);\n   274\t      painted.push(t2 - t0);\n   275\t    }\n   276\t    renderer.destroy();\n   277\t    root.remove();\n   278\t    return { draw: drawTimes, painted };\n   279\t  },\n   280\t};\n   281\t\n   282\twindow.axr = api;\n","exit_code":0,"status":"completed"}}
