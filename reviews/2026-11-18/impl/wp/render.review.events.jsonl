{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/render/png.ts'","aggregated_output":"     1\t/**\n     2\t * Minimal PNG decoder for Playwright screenshots (8-bit, non-interlaced, grayscale/RGB/RGBA), so pixels can\n     3\t * be sampled in Node without a dependency.\n     4\t */\n     5\timport zlib from 'node:zlib';\n     6\t\n     7\texport interface Image { readonly width: number; readonly height: number; readonly data: Uint8Array }\n     8\t\n     9\texport function decodePng(buf: Buffer): Image {\n    10\t  let pos = 8;\n    11\t  let width = 0, height = 0, depth = 0, type = 0, interlace = 0;\n    12\t  const idat: Buffer[] = [];\n    13\t  while (pos < buf.length) {\n    14\t    const len = buf.readUInt32BE(pos);\n    15\t    const name = buf.toString('ascii', pos + 4, pos + 8);\n    16\t    const data = buf.subarray(pos + 8, pos + 8 + len);\n    17\t    if (name === 'IHDR') { width = data.readUInt32BE(0); height = data.readUInt32BE(4); depth = data[8]!; type = data[9]!; interlace = data[12]!; }\n    18\t    else if (name === 'IDAT') idat.push(data);\n    19\t    else if (name === 'IEND') break;\n    20\t    pos += 12 + len;\n    21\t  }\n    22\t  const channels = ({ 0: 1, 2: 3, 4: 2, 6: 4 } as Record<number, number>)[type];\n    23\t  if (depth !== 8 || interlace !== 0 || channels === undefined) throw new Error(`unsupported PNG: depth ${depth}, type ${type}, interlace ${interlace}`);\n    24\t  const raw = zlib.inflateSync(Buffer.concat(idat));\n    25\t  const stride = width * channels;\n    26\t  const px = new Uint8Array(height * stride);\n    27\t  for (let y = 0; y < height; y++) {\n    28\t    const filter = raw[y * (stride + 1)]!;\n    29\t    const src = y * (stride + 1) + 1;\n    30\t    const row = y * stride;\n    31\t    for (let i = 0; i < stride; i++) {\n    32\t      const v = raw[src + i]!;\n    33\t      const a = i >= channels ? px[row + i - channels]! : 0;\n    34\t      const b = y > 0 ? px[row - stride + i]! : 0;\n    35\t      const c = y > 0 && i >= channels ? px[row - stride + i - channels]! : 0;\n    36\t      let out: number;\n    37\t      switch (filter) {\n    38\t        case 0: out = v; break;\n    39\t        case 1: out = v + a; break;\n    40\t        case 2: out = v + b; break;\n    41\t        case 3: out = v + ((a + b) >> 1); break;\n    42\t        case 4: {\n    43\t          const p = a + b - c, pa = Math.abs(p - a), pb = Math.abs(p - b), pc = Math.abs(p - c);\n    44\t          out = v + (pa <= pb && pa <= pc ? a : pb <= pc ? b : c);\n    45\t          break;\n    46\t        }\n    47\t        default: throw new Error(`bad PNG filter ${filter}`);\n    48\t      }\n    49\t      px[row + i] = out & 255;\n    50\t    }\n    51\t  }\n    52\t  const data = new Uint8Array(width * height * 4);\n    53\t  for (let i = 0, j = 0; i < width * height; i++, j += channels) {\n    54\t    const o = i * 4;\n    55\t    if (channels >= 3) { data[o] = px[j]!; data[o + 1] = px[j + 1]!; data[o + 2] = px[j + 2]!; data[o + 3] = channels === 4 ? px[j + 3]! : 255; }\n    56\t    else { data[o] = data[o + 1] = data[o + 2] = px[j]!; data[o + 3] = channels === 2 ? px[j + 1]! : 255; }\n    57\t  }\n    58\t  return { width, height, data };\n    59\t}\n","exit_code":0,"status":"completed"}}
