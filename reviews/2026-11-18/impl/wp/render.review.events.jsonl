{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/render/theme.browser.test.ts'","aggregated_output":"     1\t/**\n     2\t * Theme detection and live restyling (spec L4, A5, DX6) in system Chrome, with the hand-built scene of\n     3\t * entries/axylo-render.entry.ts. The path's stroke at (85, 50) is series 1 and is the probe point.\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport type { Page } from 'playwright-core';\n     7\timport { start, stop } from '../harness';\n     8\timport { DARK, LIGHT } from '../../../src/theme/palette';\n     9\timport { contrastRatio, parseColor } from '../../../src/theme/color';\n    10\timport type {} from './entries/api';\n    11\timport { at, close, diff, frames, ink, open, rgb, shot, type RGB } from './util';\n    12\t\n    13\tbeforeAll(start);\n    14\tafterAll(stop);\n    15\t\n    16\tconst scheme = (page: Page, id = 0): Promise<{ scheme: string; attribute: string | null }> =>\n    17\t  page.evaluate(i => { const t = window.axr.theme(i); return { scheme: t.theme.scheme, attribute: t.attribute }; }, id);\n    18\t\n    19\tconst contrast = (a: RGB, b: RGB): number =>\n    20\t  contrastRatio({ r: a[0] / 255, g: a[1] / 255, b: a[2] / 255, a: 1 }, { r: b[0] / 255, g: b[1] / 255, b: b[2] / 255, a: 1 });\n    21\t\n    22\tdescribe('scheme detection (spec L4)', () => {\n    23\t  it('a page that sets color-scheme: dark is dark', async () => {\n    24\t    const page = await open();\n    25\t    await page.addStyleTag({ content: ':root { color-scheme: dark; }' });\n    26\t    await page.evaluate(() => window.axr.mount('svg', 20, 60));\n    27\t    expect(await scheme(page)).toEqual({ scheme: 'dark', attribute: 'dark' });\n    28\t    const img = await shot(page, 20, 60, 400, 300);\n    29\t    expect(diff(at(img, 85, 50), rgb(DARK.series[0]!))).toBeLessThanOrEqual(8);\n    30\t    await close(page);\n    31\t  });\n    32\t\n    33\t  it('a class-toggled dark theme without color-scheme is dark, from the inherited text color', async () => {\n    34\t    const page = await open();\n    35\t    await page.addStyleTag({ content: 'html.dark body { background: #16181d; color: #e8eaee; }' });\n    36\t    await page.evaluate(() => { document.documentElement.classList.add('dark'); window.axr.mount('canvas', 20, 60); });\n    37\t    expect(await scheme(page)).toEqual({ scheme: 'dark', attribute: 'dark' });\n    38\t    await close(page);\n    39\t  });\n    40\t\n    41\t  it('a light-only page on a dark device stays light', async () => {\n    42\t    const page = await open({ colorScheme: 'dark' });\n    43\t    await page.addStyleTag({ content: ':root { color-scheme: light; }' });\n    44\t    await page.evaluate(() => window.axr.mount('svg', 20, 60));\n    45\t    expect(await scheme(page)).toEqual({ scheme: 'light', attribute: 'light' });\n    46\t    await close(page);\n    47\t  });\n    48\t\n    49\t  it('a computed color-scheme decides even when the text color says otherwise', async () => {\n    50\t    for (const [css, expected] of [\n    51\t      [':root { color-scheme: dark; color: #111111; }', 'dark'],\n    52\t      [':root { color-scheme: light; color: #eeeeee; background: #111111; }', 'light'],\n    53\t      [':root { color-scheme: only dark; color: #111111; }', 'dark'],\n    54\t    ] as const) {\n    55\t      const page = await open();\n    56\t      await page.addStyleTag({ content: css });\n    57\t      await page.evaluate(() => window.axr.mount('svg', 20, 60));\n    58\t      expect((await scheme(page)).scheme, css).toBe(expected);\n    59\t      await close(page);\n    60\t    }\n    61\t  });\n    62\t\n    63\t  it('color-scheme naming both falls back to the text color, which then follows the device', async () => {\n    64\t    const page = await open({ colorScheme: 'dark' });\n    65\t    await page.addStyleTag({ content: ':root { color-scheme: light dark; }' });\n    66\t    await page.evaluate(() => window.axr.mount('svg', 20, 60));\n    67\t    expect((await scheme(page)).scheme).toBe('dark');\n    68\t    await close(page);\n    69\t  });\n    70\t\n    71\t  it('--axylo-background overrides color-scheme', async () => {\n    72\t    const page = await open();\n    73\t    await page.addStyleTag({ content: ':root { color-scheme: light; --axylo-background: #101418; }' });\n    74\t    await page.evaluate(() => window.axr.mount('svg', 20, 60));\n    75\t    const t = await page.evaluate(() => window.axr.theme(0));\n    76\t    expect(t.theme.scheme).toBe('dark');\n    77\t    expect(t.theme.paints.tokens.background).toBe('rgb(16, 20, 24)');\n    78\t    await close(page);\n    79\t  });\n    80\t\n    81\t  it('theme.paints are concrete colors resolved by the browser; bindings stay CSS expressions', async () => {\n    82\t    const page = await open();\n    83\t    await page.evaluate(() => window.axr.mount('canvas', 20, 60));\n    84\t    const t = await page.evaluate(() => window.axr.theme(0));\n    85\t    expect(t.bindings.series[0]).toBe('var(--axylo-series-1)');\n    86\t    expect(t.bindings.series[7]).toBe('var(--axylo-series-8)');\n    87\t    expect(t.theme.paints.series.map(c => rgb(c))).toEqual(LIGHT.series.map(c => rgb(c)));\n    88\t    expect(rgb(t.theme.paints.tokens.axis)).toEqual(rgb(LIGHT.axis));\n    89\t    expect(rgb(t.theme.paints.tokens.background)).toEqual(rgb(LIGHT.background));\n    90\t    // Text is inherited from the page (blank.html sets none: black).\n    91\t    expect(rgb(t.theme.paints.tokens.text)).toEqual([0, 0, 0]);\n    92\t    expect(t.theme.forcedColors).toBe(false);\n    93\t    await close(page);\n    94\t  });\n    95\t});\n    96\t\n    97\tdescribe('runtime toggle', () => {\n    98\t  it('a class toggled on <html> fires watchTheme; SVG restyles with no draw call, canvas changes on the draw the callback makes', async () => {\n    99\t    const page = await open();\n   100\t    await page.addStyleTag({ content: 'html.dark body { background: #16181d; color: #e8eaee; }' });\n   101\t    await page.evaluate(() => { window.axr.mount('canvas', 20, 60); window.axr.mount('svg', 460, 60); });\n   102\t    const before = await shot(page, 460, 60, 400, 300);\n   103\t    expect(diff(at(before, 85, 50), rgb(LIGHT.series[0]!))).toBeLessThanOrEqual(8);\n   104\t    await page.evaluate(() => window.axr.watch([85, 50]));\n   105\t    await page.evaluate(() => document.documentElement.classList.add('dark'));\n   106\t    await page.waitForFunction(() => window.axr.fired() >= 1);\n   107\t    await frames(page, 2);\n   108\t    const r = await page.evaluate(() => ({ fired: window.axr.fired(), records: window.axr.records(), svgDraws: window.axr.draws(1), canvasDraws: window.axr.draws(0) }));\n   109\t    expect(r.fired).toBe(1);\n   110\t    expect(r.svgDraws).toBe(1);\n   111\t    expect(r.canvasDraws).toBe(2);\n   112\t    const canvas = r.records.find(x => x.id === 0)!;\n   113\t    // Before the draw the canvas still shows the light color; after it, the dark one.\n   114\t    expect(diff(canvas.before!, rgb(LIGHT.series[0]!))).toBeLessThanOrEqual(8);\n   115\t    expect(diff(canvas.after!, rgb(DARK.series[0]!))).toBeLessThanOrEqual(8);\n   116\t    const after = await shot(page, 460, 60, 400, 300);\n   117\t    expect(diff(at(after, 85, 50), rgb(DARK.series[0]!))).toBeLessThanOrEqual(8);\n   118\t    expect(diff(at(after, 300, 260), rgb(DARK.axis))).toBeLessThanOrEqual(4);\n   119\t    const canvasShot = await shot(page, 20, 60, 400, 300);\n   120\t    expect(diff(at(canvasShot, 85, 50), rgb(DARK.series[0]!))).toBeLessThanOrEqual(8);\n   121\t    await page.evaluate(() => window.axr.stopWatch());\n   122\t    await close(page);\n   123\t  });\n   124\t\n   125\t  it('folds a burst into one call per frame, reports media changes, and stop() leaves nothing firing', async () => {\n   126\t    const page = await open();\n   127\t    await page.evaluate(() => { window.axr.mount('svg', 20, 60); window.axr.watch([85, 50]); });\n   128\t    await page.emulateMedia({ colorScheme: 'dark' });\n   129\t    await page.waitForFunction(() => window.axr.fired() >= 1);\n   130\t    await page.emulateMedia({ forcedColors: 'active' });\n   131\t    await page.waitForFunction(() => window.axr.fired() >= 2);\n   132\t    await page.emulateMedia({ forcedColors: 'none', colorScheme: 'light' });\n   133\t    await frames(page, 3);\n   134\t    const settled = await page.evaluate(() => window.axr.fired());\n   135\t    await page.evaluate(() => {\n   136\t      for (let i = 0; i < 5; i++) document.documentElement.classList.toggle('x');\n   137\t      document.body.style.setProperty('color', 'rgb(1, 2, 3)');\n   138\t      document.body.setAttribute('data-theme', 'night');\n   139\t    });\n   140\t    await frames(page, 3);\n   141\t    expect(await page.evaluate(() => window.axr.fired())).toBe(settled + 1);\n   142\t    // An attribute outside the list does not count.\n   143\t    await page.evaluate(() => document.documentElement.setAttribute('lang', 'fr'));\n   144\t    await frames(page, 3);\n   145\t    expect(await page.evaluate(() => window.axr.fired())).toBe(settled + 1);\n   146\t\n   147\t    await page.evaluate(() => window.axr.stopWatch());\n   148\t    await page.evaluate(() => { document.documentElement.classList.toggle('y'); document.body.setAttribute('data-theme', 'day'); });\n   149\t    await page.emulateMedia({ colorScheme: 'dark', forcedColors: 'active', contrast: 'more' });\n   150\t    await frames(page, 4);\n   151\t    expect(await page.evaluate(() => window.axr.fired())).toBe(settled + 1);\n   152\t    await close(page);\n   153\t  });\n   154\t});\n   155\t\n   156\tdescribe('forced colors (emulated)', () => {\n   157\t  let page: Page;\n   158\t  beforeAll(async () => {\n   159\t    page = await open({ forcedColors: 'active' });\n   160\t    await page.evaluate(() => { window.axr.mount('canvas', 20, 60); window.axr.mount('svg', 460, 60); window.axr.mountText(20, 380); });\n   161\t  });\n   162\t  afterAll(async () => { await close(page); });\n   163\t\n   164\t  it('is detected, and every paint is a system color', async () => {\n   165\t    const t = await page.evaluate(() => window.axr.theme(0));\n   166\t    expect(t.theme.forcedColors).toBe(true);\n   167\t    expect(new Set(t.theme.paints.series).size).toBe(1);\n   168\t    expect(contrastRatio(parseColor(t.theme.paints.series[0]!)!, parseColor(t.theme.paints.tokens.background)!)).toBeGreaterThanOrEqual(4.5);\n   169\t    // An author color is set aside for the system colors.\n   170\t    const authored = await page.evaluate(() => window.axr.theme(window.axr.mount('svg', 460, 380, { keys: ['Direct'], colors: { Direct: 'rgb(200, 0, 0)' } })));\n   171\t    expect(authored.bindings.series).toEqual(['var(--axylo-series-1)']);\n   172\t    expect(authored.theme.paints.series[0]).toBe(t.theme.paints.series[0]);\n   173\t  });\n   174\t\n   175\t  for (const [kind, x] of [['canvas', 20], ['svg', 460]] as const) {\n   176\t    it(`${kind}: marks are visible against the background and lines use the contrast dash`, async () => {\n   177\t      const img = await shot(page, x, 60, 400, 300);\n   178\t      const background = at(img, 130, 105);\n   179\t      expect(contrast(at(img, 85, 50), background)).toBeGreaterThanOrEqual(3);\n   180\t      expect(contrast(at(img, 210, 220), background)).toBeGreaterThanOrEqual(3);\n   181\t      expect(contrast(at(img, 300, 260), background)).toBeGreaterThanOrEqual(3);\n   182\t      // Dashes [6, 4] along the solid-in-normal-mode segment at y 120: gaps of background appear.\n   183\t      let gaps = 0;\n   184\t      for (let px = 165; px < 375; px++) if (diff(at(img, px, 120), background) <= 10) gaps++;\n   185\t      expect(gaps).toBeGreaterThan(50);\n   186\t      expect(gaps).toBeLessThan(130);\n   187\t    });\n   188\t  }\n   189\t\n   190\t  it('svg: the contrast pattern comes from the stylesheet, not a redraw', async () => {\n   191\t    expect(await page.evaluate(() => window.axr.svgDash(1))).toBe('6px, 4px');\n   192\t    expect(await page.evaluate(() => window.axr.draws(1))).toBe(1);\n   193\t  });\n   194\t\n   195\t  it('text is visible against the background', async () => {\n   196\t    const img = await shot(page, 20, 380, 400, 300);\n   197\t    const background = at(img, 300, 250);\n   198\t    // \"1,250 kWh\", end-anchored at (380, 50).\n   199\t    expect(ink(img, 300, 40, 382, 60, background)).toBeGreaterThan(20);\n   200\t    let best = 1;\n   201\t    for (let y = 40; y < 60; y++) for (let x = 300; x < 382; x++) best = Math.max(best, contrast(at(img, x, y), background));\n   202\t    expect(best).toBeGreaterThanOrEqual(4.5);\n   203\t  });\n   204\t});\n   205\t\n   206\tdescribe('prefers-contrast: more (emulated)', () => {\n   207\t  it('both renderers switch to the contrast dash; canvas through the resolved theme, svg through CSS', async () => {\n   208\t    const page = await open({ contrast: 'more' });\n   209\t    await page.evaluate(() => { window.axr.mount('canvas', 20, 60); window.axr.mount('svg', 460, 60); });\n   210\t    expect((await page.evaluate(() => window.axr.theme(0))).theme.moreContrast).toBe(true);\n   211\t    expect(await page.evaluate(() => window.axr.svgDash(1))).toBe('6px, 4px');\n   212\t    for (const x of [20, 460]) {\n   213\t      const img = await shot(page, x, 60, 400, 300);\n   214\t      let gaps = 0;\n   215\t      for (let px = 165; px < 375; px++) if (diff(at(img, px, 120), [255, 255, 255]) <= 10) gaps++;\n   216\t      expect(gaps, `at ${x}`).toBeGreaterThan(50);\n   217\t    }\n   218\t    await close(page);\n   219\t  });\n   220\t});\n   221\t\n   222\tdescribe('author colors (spec DX6)', () => {\n   223\t  it('colors: { Direct: \"var(--brand)\" } stays live in SVG: changing --brand recolors with no draw call', async () => {\n   224\t    const page = await open();\n   225\t    await page.evaluate(() => {\n   226\t      document.documentElement.style.setProperty('--brand', 'rgb(200, 0, 0)');\n   227\t      window.axr.mount('svg', 20, 60, { keys: ['Direct'], colors: { Direct: 'var(--brand)' } });\n   228\t    });\n   229\t    const t = await page.evaluate(() => window.axr.theme(0));\n   230\t    expect(t.bindings.series).toEqual(['var(--brand)']);\n   231\t    expect(t.theme.paints.series).toEqual(['rgb(200, 0, 0)']);\n   232\t    expect(diff(at(await shot(page, 20, 60, 400, 300), 85, 50), [200, 0, 0])).toBeLessThanOrEqual(8);\n   233\t    await page.evaluate(() => document.documentElement.style.setProperty('--brand', 'rgb(0, 0, 200)'));\n   234\t    await frames(page, 2);\n   235\t    expect(diff(at(await shot(page, 20, 60, 400, 300), 85, 50), [0, 0, 200])).toBeLessThanOrEqual(8);\n   236\t    expect(await page.evaluate(() => window.axr.draws(0))).toBe(1);\n   237\t    await close(page);\n   238\t  });\n   239\t});\n   240\t\n   241\tdescribe('ensureStyles', () => {\n   242\t  it('adds one constructable stylesheet however often it is called, and no <style> element', async () => {\n   243\t    const page = await open();\n   244\t    const r = await page.evaluate(() => {\n   245\t      const styles = document.querySelectorAll('style').length;\n   246\t      const first = window.axr.ensureStyles();\n   247\t      const second = window.axr.ensureStyles();\n   248\t      return { first, second, styles, after: document.querySelectorAll('style').length };\n   249\t    });\n   250\t    expect(r).toEqual({ first: 1, second: 1, styles: r.styles, after: r.styles });\n   251\t    await close(page);\n   252\t  });\n   253\t\n   254\t  it('adds nothing when the page already loaded the standalone stylesheet', async () => {\n   255\t    const page = await open();\n   256\t    await page.evaluate(() => {\n   257\t      const s = document.createElement('style');\n   258\t      s.textContent = window.axr.css;\n   259\t      document.head.appendChild(s);\n   260\t    });\n   261\t    expect(await page.evaluate(() => window.axr.ensureStyles())).toBe(0);\n   262\t    await page.evaluate(() => window.axr.mount('svg', 20, 60));\n   263\t    expect(await page.evaluate(() => document.adoptedStyleSheets.length)).toBe(0);\n   264\t    const img = await shot(page, 20, 60, 400, 300);\n   265\t    expect(diff(at(img, 85, 50), rgb(LIGHT.series[0]!))).toBeLessThanOrEqual(8);\n   266\t    await close(page);\n   267\t  });\n   268\t});\n","exit_code":0,"status":"completed"}}
