dd(label);\n   128\t      seen.set(label, value);\n   129\t      shown.push(tick);\n   130\t    }\n   131\t    if (index === 0) for (const value of duplicates) hiddenAtFullDensity.add(value);\n   132\t    else for (const value of hiddenAtFullDensity) duplicates.add(value);\n   133\t    return { ticks: shown, hidden: duplicates.size };\n   134\t  });\n   135\t\n   136\t  let byEnding: Map<string, string[]> | undefined;\n   137\t  return {\n   138\t    sets,\n   139\t    competingLabel(full, prefix, suffix) {\n   140\t      if (originals.has(prefix + ELLIPSIS + suffix)) return true;\n   141\t      if (!byEnding && originals.size > 128) {\n   142\t        byEnding = new Map();\n   143\t        for (const original of originals) {\n   144\t          const key = original.slice(-2);\n   145\t          const bucket = byEnding.get(key);\n   146\t          if (bucket) bucket.push(original);\n   147\t          else byEnding.set(key, [original]);\n   148\t        }\n   149\t      }\n   150\t      for (const other of byEnding ? byEnding.get(suffix.slice(-2)) ?? [] : originals) {\n// Builds packages/axylo/dist: ESM (production and development flavours), script-tag files, CSS and type declarations.\nimport { build } from 'esbuild';\nimport { execFileSync } from 'node:child_process';\nimport fs from 'node:fs';\nconst pkg = 'packages/axylo';\nfs.rmSync(`${pkg}/dist`, { recursive: true, force: true });\nconst common = { entryPoints: [`${pkg}/src/index.ts`], bundle: true, target: 'es2022', legalComments: 'none', logLevel: 'warning' };\nawait Promise.all([\n  build({ ...common, format: 'esm', minify: true, define: { __DEV__: 'false' }, outfile: `${pkg}/dist/axylo.js` }),\n  build({ ...common, format: 'esm', define: { __DEV__: 'true' }, outfile: `${pkg}/dist/axylo.dev.js` }),\n  build({ ...common, format: 'iife', globalName: 'Axylo', define: { __DEV__: 'true' }, outfile: `${pkg}/dist/axylo.iife.js` }),\n  build({ ...common, format: 'iife', globalName: 'Axylo', minify: true, define: { __