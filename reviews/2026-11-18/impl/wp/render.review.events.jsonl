{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/render/svg.ts'","aggregated_output":"     1\t/**\n     2\t * SVG mark renderer (plan 2.3). Paints with `bindings`, CSS expressions such as `var(--axylo-series-1)`,\n     3\t * through style properties, so the browser restyles the marks on a theme change with no call. Dash\n     4\t * patterns switch under `prefers-contrast: more` and forced colors through the stylesheet (theme/css.ts).\n     5\t *\n     6\t * One element per mark (a group for bars and slices), reused between draws when the mark at the same\n     7\t * position has the same kind; attributes are only written when their value changed.\n     8\t */\n     9\timport type { AreaMark, ArcMark, Mark, MarkRenderer, Overlay, PaintBindings, PathMark, PointMark, Rect, RectMark, ResolvedTheme, RuleMark, Scene } from '../core/contracts';\n    10\timport {\n    11\t  dashText, lifted, MARKER_POLYGONS, MISSING_STROKE, missingBox, paintOf, sector, SECTOR_APEX, SECTOR_ARCS, SECTOR_NONE, SECTOR_RING, snapRule, unclippedRule,\n    12\t} from './geometry';\n    13\t\n    14\tconst NS = 'http://www.w3.org/2000/svg';\n    15\tlet ids = 0;\n    16\t\n    17\t/** An element plus what was last written to it, so unchanged values are not written again. */\n    18\tinterface Node {\n    19\t  readonly key: string;\n    20\t  readonly el: SVGElement;\n    21\t  readonly attrs: Map<string, string>;\n    22\t  readonly styles: Map<string, string>;\n    23\t  readonly kids: Node[];\n    24\t}\n    25\t\n    26\tfunction node(doc: Document, tag: string, key: string): Node {\n    27\t  return { key, el: doc.createElementNS(NS, tag) as SVGElement, attrs: new Map(), styles: new Map(), kids: [] };\n    28\t}\n    29\t\n    30\tfunction attr(n: Node, name: string, value: string | null): void {\n    31\t  if (value === null) {\n    32\t    if (n.attrs.has(name)) { n.attrs.delete(name); n.el.removeAttribute(name); }\