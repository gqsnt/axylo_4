{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/render/geometry.ts'","aggregated_output":"     1\t/**\n     2\t * Geometry shared by the canvas and SVG renderers, so both draw the same picture. Pure: runs in Node.\n     3\t * Every function writes into a caller-owned scratch array instead of returning objects, so drawing\n     4\t * allocates nothing per mark element.\n     5\t */\n     6\timport type { MarkerShape, Paint, PaintBindings, RuleMark } from '../core/contracts';\n     7\t\n     8\t/** True for NaN and ±Infinity: such a coordinate lifts the pen. */\n     9\texport const lifted = (v: number): boolean => v - v !== 0;\n    10\t\n    11\t/** The paint's entry in a binding table (CSS expressions or concrete colors), or null for 'none'. */\n    12\texport function paintOf(paint: Paint, table: PaintBindings): string | null {\n    13\t  if (paint.kind === 'none') return null;\n    14\t  if (paint.kind === 'token') return table.tokens[paint.name];\n    15\t  const s = table.series;\n    16\t  if (s.length === 0) return null;\n    17\t  return s[paint.index] ?? s[((paint.index % s.length) + s.length) % s.length]!;\n    18\t}\n    19\t\n    20\t/** Rules whose role is drawn outside the plot clip (the scene contract). */\n    21\texport const unclippedRule = (role: RuleMark['role']): boolean => role === 'axis' || role === 'tick';\n    22\t\n    23\t/**\n    24\t * Snaps a horizontal or vertical rule to device pixels so a 1 px rule covers whole pixel rows and stays\n    25\t * crisp. Writes x1, y1, x2, y2 and the line width, all in CSS px, into `out`. Other rules pass through.\n    26\t */\n    27\texport function snapRule(x1: number, y1: number, x2: number, y2: number, width: number, dpr: number, out: Float64Array): void {\n    28\t  const device = Math.max(1, Math.round(width * dpr));\n    29\t  const half = device / 2;\n    30\t  if (y1 === y2) {\n    31\t    const y = (Math.round(y1 * dpr - half) + half) / dpr;\n    32\t    out[0] = Math.round(x1 * dpr) / dpr; out[1] = y; out[2] = Math.round(x2 * dpr) / dpr; out[3] = y;\n    33\t    out[4] = device / dpr;\n    34\t  } else if (x1 === x2) {\n    35\t    const x = (Math.round(x1 * dpr - half) + half) / dpr;\n    36\t    out[0] = x; out[1] = Math.round(y1 * dpr) / dpr; out[2] = x; out[3] = Math.round(y2 * dpr) / dpr;\n    37\t    out[4] = device / dpr;\n    38\t  } else {\n    39\t    out[0] = x1; out[1] = y1; out[2] = x2; out[3] = y2; out[4] = width;\n    40\t  }\n    41\t}\n    42\t\n    43\t/** Smallest side of the \"no data\" marker, CSS px: large enough not to read as a hairline or a zero bar. */\n    44\texport const MISSING_MIN = 6;\n    45\t/** Outline width of the \"no data\" marker, CSS px. */\n    46\texport const MISSING_STROKE = 1.5;\n    47\t\n    48\t/**\n    49\t * Box of the \"no data\" marker of spec F2 for one 'missing' rect. The scene gives the empty slot at the\n    50\t * baseline: its band extent along the category axis and its edge on the baseline. A side thinner than\n    51\t * MISSING_MIN is grown away from the baseline (upwards for a zero height, rightwards for a zero width),\n    52\t * so the marker sits on the baseline. The renderers draw it hollow, with a diagonal, inset by half the\n    53\t * outline so the outline stays inside the box. Writes x, y, width, height of the outline path into `out`.\n    54\t */\n    55\texport function missingBox(x: number, y: number, w: number, h: number, out: Float64Array): void {\n    56\t  const left = w < 0 ? x + w : x;\n    57\t  let top = h < 0 ? y + h : y;\n    58\t  const width = Math.max(Math.abs(w), MISSING_MIN);\n    59\t  let height = Math.abs(h);\n    60\t  if (height < MISSING_MIN) { top = top + height - MISSING_MIN; height = MISSING_MIN; }\n    61\t  const inset = MISSING_STROKE / 2;\n    62\t  out[0] = left + inset; out[1] = top + inset; out[2] = width - MISSING_STROKE; out[3] = height - MISSING_STROKE;\n    63\t}\n    64\t\n    65\t/** Result of `sector`. */\n    66\texport const SECTOR_NONE = 0;    // nothing to draw\n    67\texport const SECTOR_RING = 1;    // a full annulus (one slice that is the whole circle)\n    68\texport const SECTOR_ARCS = 2;    // outer arc, then inner arc back\n    69\texport const SECTOR_APEX = 3;    // outer arc, then one apex point (the gap closes before the inner radius)\n    70\t\n    71\t/**\n    72\t * Annular sector with `gap` CSS px of background between it and its neighbours: each side is moved\n    73\t * gap/2 into the slice, parallel to its radius, so the gap has constant width (spec A5) rather than a\n    74\t * constant angle. Input angles are radians clockwise from 12 o'clock. Writes, in canvas angles (radians\n    75\t * clockwise from 3 o'clock): out[0], out[1] the outer arc; out[2], out[3] the inner arc (drawn from\n    76\t * out[2] back to out[3]); for SECTOR_APEX, out[4] the apex radius and out[5] its angle.\n    77\t */\n    78\texport function sector(a0: number, a1: number, r0: number, r1: number, gap: number, out: Float64Array): number {\n    79\t  const span = a1 - a0;\n    80\t  if (!(span > 0) || !(r1 > 0) || !(r1 > r0)) return SECTOR_NONE;\n    81\t  if (span >= 2 * Math.PI - 1e-9) return SECTOR_RING;\n    82\t  const quarter = Math.PI / 2;\n    83\t  const d = gap > 0 ? gap / 2 : 0;\n    84\t  if (d >= r1) return SECTOR_NONE;\n    85\t  const outer = Math.asin(d / r1);\n    86\t  if (span <= 2 * outer) return SECTOR_NONE;\n    87\t  out[0] = a0 + outer - quarter;\n    88\t  out[1] = a1 - outer - quarter;\n    89\t  // Radius at which the two moved sides meet, on the bisector.\n    90\t  const meet = d > 0 ? d / Math.sin(span / 2) : 0;\n    91\t  if (r0 > 0 && r0 > meet && r0 > d) {\n    92\t    const inner = Math.asin(d / r0);\n    93\t    out[2] = a1 - inner - quarter;\n    94\t    out[3] = a0 + inner - quarter;\n    95\t    return SECTOR_ARCS;\n    96\t  }\n    97\t  out[4] = meet;\n    98\t  out[5] = (a0 + a1) / 2 - quarter;\n    99\t  return SECTOR_APEX;\n   100\t}\n   101\t\n   102\t/**\n   103\t * Marker outlines in a unit box centred on the point, clockwise on screen (y down), so all of a mark's\n   104\t * markers can be filled as one path with the nonzero rule. 'circle' is drawn as an arc instead.\n   105\t */\n   106\texport type PolygonShape = Exclude<MarkerShape, 'circle'>;\n   107\t\n   108\tfunction plus(): number[] {\n   109\t  const t = 1 / 6; // half arm thickness: arms are a third of the box\n   110\t  return [-t, -0.5, t, -0.5, t, -t, 0.5, -t, 0.5, t, t, t, t, 0.5, -t, 0.5, -t, t, -0.5, t, -0.5, -t, -t, -t];\n   111\t}\n   112\t\n   113\tfunction rotate45(p: number[]): number[] {\n   114\t  const c = Math.SQRT1_2;\n   115\t  const out: number[] = [];\n   116\t  for (let i = 0; i < p.length; i += 2) out.push((p[i]! - p[i + 1]!) * c, (p[i]! + p[i + 1]!) * c);\n   117\t  return out;\n   118\t}\n   119\t\n   120\tfunction star(): number[] {\n   121\t  const out: number[] = [];\n   122\t  const inner = 0.5 * 0.382;\n   123\t  for (let k = 0; k < 10; k++) {\n   124\t    const a = -Math.PI / 2 + (k * Math.PI) / 5;\n   125\t    const r = k % 2 === 0 ? 0.5 : inner;\n   126\t    out.push(r * Math.cos(a), r * Math.sin(a));\n   127\t  }\n   128\t  return out;\n   129\t}\n   130\t\n   131\texport const MARKER_POLYGONS: Readonly<Record<PolygonShape, Float64Array>> = {\n   132\t  square: Float64Array.of(-0.5, -0.5, 0.5, -0.5, 0.5, 0.5, -0.5, 0.5),\n   133\t  triangle: Float64Array.of(0, -0.5, 0.5, 0.5, -0.5, 0.5),\n   134\t  'triangle-down': Float64Array.of(-0.5, -0.5, 0.5, -0.5, 0, 0.5),\n   135\t  diamond: Float64Array.of(0, -0.5, 0.5, 0, 0, 0.5, -0.5, 0),\n   136\t  plus: Float64Array.from(plus()),\n   137\t  cross: Float64Array.from(rotate45(plus())),\n   138\t  star: Float64Array.from(star()),\n   139\t};\n   140\t\n   141\t/** Signed area of a packed polygon; positive means clockwise on screen (y down). */\n   142\texport function signedArea(p: Float64Array): number {\n   143\t  let a = 0;\n   144\t  const n = p.length / 2;\n   145\t  for (let i = 0; i < n; i++) {\n   146\t    const j = (i + 1) % n;\n   147\t    a += p[2 * i]! * p[2 * j + 1]! - p[2 * j]! * p[2 * i + 1]!;\n   148\t  }\n   149\t  return a / 2;\n   150\t}\n   151\t\n   152\t/** Joins a dash pattern for CSS and SVG, or 'none' for solid. */\n   153\texport const dashText = (dash: readonly number[] | null): string => (dash === null || dash.length === 0 ? 'none' : dash.join(' '));\n","exit_code":0,"status":"completed"}}
