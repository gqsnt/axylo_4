 return this.parts.join('');\n    69\t  }\n    70\t}\n    71\t\n    72\texport function pathData(xy: Float32Array): string {\n    73\t  const out = new PathText();\n    74\t  let pen = false;\n    75\t  for (let i = 0; i + 1 < xy.length; i += 2) {\n    76\t    const x = xy[i]!;\n    77\t    const y = xy[i + 1]!;\n    78\t    if (lifted(x) || lifted(y)) { pen = false; continue; }\n    79\t    out.add((pen ? 'L' : 'M') + f(x) + ' ' + f(y));\n    80\t    pen = true;\n    81\t  }\n    82\t  return out.done();\n    83\t}\n    84\t\n    85\texport function areaData(mark: AreaMark): string {\n    86\t  const { upper, lower, runs } = mark;\n    87\t  const upperCount = upper.length >> 1;\n    88\t  const lowerCount = lower.length >> 1;\n    89\t  const out = new PathText();\n    90\t  for (let r = 0; r + 3 < runs.length; r += 4) {\n    91\t    const us = runs[r]!;\n    92\t    const ue = Math.min(us + runs[r + 1]!, upperCount);\n    93\t    const ls = runs[r + 2]!;\n    94\t    const le = Math.min(ls + runs[r + 3]!, lowerCount);\n    95\t    let started = false;\n    96\t    for (let k = us; k < ue; k++) {\n    97\t      const x = upper[2 * k]!, y = upper[2 * k + 1]!;\n    98\t      if (lifted(x) || lifted(y)) continue;\n    99\t      out.add((started ? 'L' : 'M') + f(x) + ' ' + f(y));\n   100\t      started = true;\n   101\t    }\n   102\t    for (let k = le - 1; k >= ls; k--) {\n   103\t      const x = lower[2 * k]!, y = lower[2 * k + 1]!;\n   104\t      if (lifted(x) || lifted(y)) continue;\n   105\t      out.add((started ? 'L' : 'M') + f(x) + ' ' + f(y));\n   106\t      started = true;\n   107\t    }\n   108\t    if (started) out.add('Z');\n   109\t  }\n   110\t  return out.done();\n   111\t}\n   112\t\n   113\tfunction pointData(mark: PointMark): string {\n   114\t  const { xy, size } = mark;\n   115\t  const out = new PathText();\n   116\t  if (!(size > 0)) return '';\n   117\t  const r = size / 2;\n   118\t  if (mark.shape === 'circle') {\n   119\t    const a = ` A${f(r)} ${f(r)} 0 1 1 `;\n   120\t    for (let i = 0; i + 1 < xy.length; i += 2) {\n   121\t      const x = xy[i]!, y = xy[i + 1]!;\n   122\t      if (lifted(x) || lifted(y)) continue;\n   123\t      // Two half circles, clockwise like the polygons, so overlapping markers union under nonzero.\n   124\t      out.add('M' + f(x + r) + ' ' + f(y) + a + f(x - r) + ' ' + f(y) + a + f(x + r) + ' ' + f(y) + 'Z');\n   125\t    }\n   126\t    return out.done();\n   127\t  }\n   128\t  const poly = MARKER_POLYGONS[mark.shape];\n   129\t  for (let i = 0; i + 1 < xy.length; i += 2) {\n   130\t    const x = xy[i]!, y = xy[i + 1]!;\n   131\t    if (lifted(x) || lifted(y)) continue;\n   132\t    let s = 'M' + f(x + poly[0]! * size) + ' ' + f(y + poly[1]! * size);\n   133\t    for (let k = 2; k < poly.length; k += 2) s += 'L' + f(x + poly[k]! * size) + ' ' + f(y + poly[k + 1]! * size);\n   134\t    out.add(s + 'Z');\n   135\t  }\n   136\t  return out.done();\n   137\t}\n   138\t\n   139\tfunction missingData(mark: RectMark, box: Float64Array): string {\n   140\t  const q = mark.xywh;\n   141\t  const out = new PathText();\n   142\t  for (let i = 0; i + 3 < q.length; i += 4) {\n   143\t    const x = q[i]!, y = q[i + 1]!, w = q[i + 2]!, h = q[i + 3]!;\n   144\t    if (lifted(x) || lifted(y) || lifted(w) || lifted(h)) continue;\n   145\t    missingBox(x, y, w, h, box);\n   146\t    const bx = f(box[0]!), by = f(box[1]!), bw = f(box[2]!), bh = f(box[3]!);\n   147\t    out.add(`M${bx} ${by}h${bw}v${bh}h${-bw}Z` + `M${bx} ${f(by + bh)}L${f(bx + bw)} ${by}`);\n   148\t  }\n   149\t  return out.done();\n   150\t}\n","exit_code":0,"status":"completed"}}
