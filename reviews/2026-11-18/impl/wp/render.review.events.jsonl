{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/theme/color.test.ts'","aggregated_output":"     1\timport { describe, expect, it } from 'vitest';\n     2\timport fc from 'fast-check';\n     3\timport { composite, contrastRatio, isLightColor, lowContrastSeries, parseColor, relativeLuminance, type Rgba } from '../../src/theme/color';\n     4\timport type { ResolvedTheme } from '../../src/core/contracts';\n     5\t\n     6\tconst c = (s: string): Rgba => {\n     7\t  const v = parseColor(s);\n     8\t  if (v === null) throw new Error(`unparsed ${s}`);\n     9\t  return v;\n    10\t};\n    11\t\n    12\tdescribe('parseColor', () => {\n    13\t  it('reads the forms getComputedStyle returns', () => {\n    14\t    expect(c('rgb(255, 0, 0)')).toEqual({ r: 1, g: 0, b: 0, a: 1 });\n    15\t    expect(c('rgba(0, 0, 255, 0.5)')).toEqual({ r: 0, g: 0, b: 1, a: 0.5 });\n    16\t    expect(c('rgb(0 128 0 / 25%)').a).toBeCloseTo(0.25, 9);\n    17\t    expect(c('rgb(0 128 0 / 25%)').g).toBeCloseTo(128 / 255, 9);\n    18\t    expect(c('color(srgb 0.5 0.25 1)')).toEqual({ r: 0.5, g: 0.25, b: 1, a: 1 });\n    19\t    expect(c('color(srgb 1 1 1 / 0.2)').a).toBeCloseTo(0.2, 9);\n    20\t    expect(c('#767676').r).toBeCloseTo(0x76 / 255, 9);\n    21\t    expect(c('#fff')).toEqual({ r: 1, g: 1, b: 1, a: 1 });\n    22\t    expect(c('transparent').a).toBe(0);\n    23\t  });\n    24\t\n    25\t  it('returns null rather than guessing', () => {\n    26\t    for (const s of ['oklch(0.5 0.1 200)', 'lab(50 10 10)', 'color(display-p3 1 0 0)', 'red', 'rgb(1, 2)', '#12', 'var(--x)', '']) {\n    27\t      expect(parseColor(s)).toBeNull();\n    28\t    }\n    29\t  });\n    30\t});\n    31\t\n    32\tdescribe('contrast (WCAG 2)', () => {\n    33\t  it('black on white is 21:1', () => {\n    34\t    expect(contrastRatio(c('#000'), c('#fff'))).toBeCloseTo(21, 9);\n    35\t    expect(contrastRatio(c('#fff'), c('#000'))).toBeCloseTo(21, 9);\n    36\t  });\n    37\t\n    38\t  it('#767676 on white is about 4.54:1, the smallest gray that passes AA', () => {\n    39\t    expect(contrastRatio(c('#767676'), c('#ffffff'))).toBeCloseTo(4.54, 2);\n    40\t    expect(contrastRatio(c('#777777'), c('#ffffff'))).toBeLessThan(4.5);\n    41\t  });\n    42\t\n    43\t  it('luminance endpoints', () => {\n    44\t    expect(relativeLuminance(c('#000'))).toBe(0);\n    45\t    expect(relativeLuminance(c('#fff'))).toBeCloseTo(1, 12);\n    46\t  });\n    47\t\n    48\t  it('a translucent color is measured as it appears on the background', () => {\n    49\t    const half = c('rgba(0, 0, 0, 0.5)');\n    50\t    expect(contrastRatio(half, c('#fff'))).toBeCloseTo(contrastRatio(composite(half, c('#fff')), c('#fff')), 12);\n    51\t    expect(contrastRatio(c('rgba(0, 0, 0, 0)'), c('#fff'))).toBeCloseTo(1, 12);\n    52\t  });\n    53\t\n    54\t  it('is symmetric and between 1 and 21 (property)', () => {\n    55\t    const color = fc.record({ r: fc.double({ min: 0, max: 1, noNaN: true }), g: fc.double({ min: 0, max: 1, noNaN: true }), b: fc.double({ min: 0, max: 1, noNaN: true }) })\n    56\t      .map(v => ({ ...v, a: 1 }));\n    57\t    fc.assert(fc.property(color, color, (x, y) => {\n    58\t      const k = contrastRatio(x, y);\n    59\t      expect(k).toBeGreaterThanOrEqual(1 - 1e-12);\n    60\t      expect(k).toBeLessThanOrEqual(21 + 1e-9);\n    61\t      expect(contrastRatio(y, x)).toBeCloseTo(k, 9);\n    62\t    }));\n    63\t  });\n    64\t});\n    65\t\n    66\tdescribe('isLightColor', () => {\n    67\t  it('splits where contrast with black equals contrast with white', () => {\n    68\t    expect(isLightColor(c('#fff'))).toBe(true);\n    69\t    expect(isLightColor(c('#000'))).toBe(false);\n    70\t    expect(isLightColor(c('#16181d'))).toBe(false);\n    71\t    expect(isLightColor(c('#e8eaee'))).toBe(true);\n    72\t    fc.assert(fc.property(fc.integer({ min: 0, max: 255 }), v => {\n    73\t      const gray = { r: v / 255, g: v / 255, b: v / 255, a: 1 };\n    74\t      const black = { r: 0, g: 0, b: 0, a: 1 };\n    75\t      const white = { r: 1, g: 1, b: 1, a: 1 };\n    76\t      expect(isLightColor(gray)).toBe(contrastRatio(gray, black) > contrastRatio(gray, white));\n    77\t    }));\n    78\t  });\n    79\t});\n    80\t\n    81\tdescribe('lowContrastSeries', () => {\n    82\t  const theme = (background: string, series: string[]): ResolvedTheme => ({\n    83\t    scheme: 'light', forcedColors: false, moreContrast: false,\n    84\t    paints: { tokens: { axis: '', grid: '', reference: '', muted: '', focus: '', background, text: '' }, series },\n    85\t  });\n    86\t\n    87\t  it('lists the series below 3:1 against the resolved background', () => {\n    88\t    // #949494 on white is 3.03:1, #959595 is 2.99:1 (computed by the WCAG formula by hand for the check).\n    89\t    const t = theme('rgb(255, 255, 255)', ['rgb(0, 0, 0)', 'rgb(149, 149, 149)', 'rgb(148, 148, 148)', 'rgb(255, 255, 0)']);\n    90\t    expect(lowContrastSeries(t)).toEqual([1, 3]);\n    91\t  });\n    92\t\n    93\t  it('skips colors it cannot read and an unreadable background', () => {\n    94\t    expect(lowContrastSeries(theme('rgb(255, 255, 255)', ['oklch(0.9 0 0)']))).toEqual([]);\n    95\t    expect(lowContrastSeries(theme('nonsense', ['rgb(255, 255, 255)']))).toEqual([]);\n    96\t  });\n    97\t});\n","exit_code":0,"status":"completed"}}
