length: indexes.length, columns: null, read,\n      rowIndex: i => indexes[i]!,\n      isColumnRow: i => this.isColumn(indexes[i]!),\n      rowAt: i => data(indexes[i]!),\n      hasField: field => indexes.some(row => Object.hasOwn(Object(data(row)), field)),\n      keys: () => [...new Set(indexes.flatMap(row => Object.keys(Object(data(row)))))],\n    };\n  }\n}\nimport { SLOT_NO_ROW, type AlignedFrame, type RowSource, type Series, type XColumn } from '../core/contracts';\n\ntype SeriesDescription = Omit<Series, 'y' | 'slot' | 'row'>;\nexport interface SeriesBuffers {\n  description: SeriesDescription;\n  y: Float64Array;\n  slot: Uint8Array;\n  row: Int32Array;\n}\n\nfunction buffers(description: SeriesDescription, capacity: number): SeriesBuffers {\n  return { description, y: new Float64Array(capacity), slot: new Uint8Array(capacity), row: new Int32Array(capacity) };\n}\n\nexport class FrameBuffers {\n  x: Float64Array;\n  observed: Uint8Array;\n  private categoryPositions = new Float64Array();\n  readonly series = new Map<string, SeriesBuffers>();\n  start = 0;\n  end: number;\n  distinct: number;\n\n  constructor(frame: AlignedFrame, positions: Float64Array, order: Int32Array | null) {\n    this.end = frame.length;\n    this.distinct = 0;\n    const capacity = Math.max(16, this.end * 2);\n    this.x = new Float64Array(capacity);\n    this.x.set(frame.x.values);\n    this.observed = new Uint8Array(capacity);\n    let slot = 0;\n    const length = order?.length ?? positions.length;\n    for (let i = 0; i < length; i++) {\n      const x = positions[order?.[i] ?? i]!;\n      while (slot < this.end && this.x[slot]! < x) slot++;\n      if (slot < this.end && this.x[slot] === x && !this.observed[slot]) {\n        this.observed[slot] = 1;\n        this.distinct++;\n      }\n    }\n    for (const { row, slot, y, ...description } of frame.series) {\n      const series = buffers(description, capacity);\n      series.y.set(y);\n      series.slot.set(slot);\n      if (row) series.row.set(row);\n      else for (let i = 0; i < this.end; i++) series.row[i] = i;\n      this.series.set(description.key, series);\n    }\n  }\n\n  reserve(extra: number): boolean {\n    if (this.end + extra <= this.x.length) return false;\n    this.resize(extra);\n    return true;\n  }\n\n  shrink(): void {\n    if (this.x.length > Math.max(32, 4 * (this.end - this.start))) this.resize(0);\n  }\n\n  private resize(extra: number): void {\n    const { start, end } = this;\n    const count = end - start;\n    const capacity = Math.max(16, 2 * (count + extra));\n    const x = new Float64Array(capacity);\n    const observed = new Uint8Array(capacity);\n    x.set(this.x.subarray(start, end));\n    observed.set(this.observed.subarray(start, end));\n    this.x = x;\n    this.observed = observed;\n    if (this.categoryPositions.length > capacity) this.categoryPositions = new Float64Array();\n    for (const [key, previous] of this.series) {\n      const series = buffers(previous.description, capacity);\n      series.y.set(previous.y.subarray(start, end));\n      series.slot.set(previous.slot.subarray(start, end));\n      series.row.set(previous.row.subarray(start, end));\n      this.series.set(key, series);\n    }\n    this.start = 0;\n    this.end = count;\n  }\n\n  copySeries(series: SeriesBuffers): SeriesBuffers {\n    const copy = buffers(series.description, this.x.length);\n    const { start, end } = this;\n    copy.y.set(series.y.subarray(start, end), start);\n    copy.slot.set(series.slot.subarray(start, end), start);\n    copy.row.set(series.row.subarray(start, end), start);\n    this.series.set(series.description.key, copy);\n    return copy;\n  }\n\n  addSeries(description: SeriesDescription, zero: boolean): SeriesBuffers {\n    const series = buffers(description, this.x.length);\n    series.row.fill(-1, this.start, this.end);\n    if (!zero) {\n      series.y.fill(NaN, this.start, this.end);\n      series.slot.fill(SLOT_NO_ROW, this.start, this.end);\n    }\n    this.series.set(description.key, series);\n    return series;\n  }\n\n  trim(keep: number | undefined, evict: (x: number, observed: boolean) => void): void {\n    if (keep === undefined || keep >= this.distinct) return;\n    while (this.start < this.end && (this.distinct > keep || !this.observed[this.start])) {\n      const observed = this.observed[this.start] === 1;\n      if (observed) this.distinct--;\n      evict(this.x[this.start]!, observed);\n      this.start++;\n    }\n  }\n\n  frame(previous: AlignedFrame, axis: XColumn, source: RowSource, open?: (key: string) => boolean): AlignedFrame {\n    const { start, end } = this;\n    let positions = this.x.subarray(start, end);\n    if (axis.kind === 'category' && positions[0]) {\n      if (this.categoryPositions.length < positions.length) {\n        const capacity = Math.max(16, positions.length * 2);\n        this.categoryPositions = Float64Array.from({ length: capacity }, (_, i) => i);\n      }\n      positions = this.categoryPositions.subarray(0, positions.length);\n    }\n    return {\n      ...previous, source, revision: previous.revision, length: end - start,\n      x: {\n        values: positions, kind: axis.kind, dateUnit: axis.dateUnit,\n        timeZone: axis.timeZone, ordered: axis.ordered,\n        get categories() { return axis.kind === 'category' && end === start ? [] : axis.categories; },\n      },\n      series: Array.from(this.series.values(), ({ description, y, slot, row }) => {\n        if (end === start || !open?.(description.key)) {\n          return { ...description, y: y.subarray(start, end), slot: slot.subarray(start, end), row: row.subarray(start, end) };\n        }\n        // The last x may still receive an observation. Copy its older view only if a reader asks for it.\n        const tailY = y[end - 1]!;\n        const tailSlot = slot[end - 1]!;\n        const tailRow = row[end - 1]!;\n        let values: Float64Array | undefined;\n        let states: Uint8Array | undefined;\n        let rows: Int32Array | undefined;\n        return {\n          ...description,\n          get y() {\n            if (!values) {\n              values = y.slice(start, end);\n              values[values.length - 1] = tailY;\n            }\n            return values;\n          },\n          get slot() {\n            if (!states) {\n              states = slot.slice(start, end);\n              states[states.length - 1] = tailSlot;\n            }\n            return states;\n          },\n          get row() {\n            if (!rows) {\n              rows = row.slice(start, end);\n              rows[rows.length - 1] = tailRow;\n            }\n            return rows;\n          },\n        };\n      }),\n    };\n  }\n}\nimport type { DiagnosticEffect, DiagnosticInput, DiagnosticSink, XColumn } from '../core/contracts';\nimport { DiagnosticCollector, createDiagnostic, type DiagnosticCode, type DiagnosticDetails } from '../diagnostics';\nimport { diagnosticContext } from '../diagnostics/registry';\nimport { positionName } from './x';\n\nexport interface DiagnosticTrace extends DiagnosticSink {\n  traceRow?(code: DiagnosticCode, field: string, effect: DiagnosticEffect, row: number, amount?: number, example?: string, series?: string): void;\n  traceGaps?(field: string, effect: DiagnosticEffect, positions: Float64Array, details?: DiagnosticDetails, axis?: XColumn): void;\n  traceSparseGaps?(details: DiagnosticDetails, seriesKey?: string): void;\n}\n\nfunction keyOf(code: DiagnosticInput['code'], field: string | undefined, effect: DiagnosticEffect): string {\n  return JSON.stringify([code, field, effect]);\n}\n\ninterface Sample {\n  count: number;\n  readonly examples: Set<string>;\n  readonly series: Set<string>;\n}\n\ninterface Occurrences {\n  readonly coordinates: Map<number, Sample>;\n  readonly gaps: boolean;\n  readonly axis?: XColumn;\n  count: number;\n}\n\nfunction addSamples(target: Set<string>, samples: Iterable<string>): void {\n  for (const sample of samples) {\n    if (target.size === 10) break;\n    target.add(sample);\n  }\n}\n\nexport class StreamDiagnostics extends DiagnosticCollector implements DiagnosticTrace {\n  private readonly occurrences = new Map<string, Occurrences>();\n  private readonly sparse = new Map<string, DiagnosticInput>();\n\n  private trace(key: string, coordinate: number, gaps: boolean, amount: number,\n    examples: Iterable<string>, series: Iterable<string>, axis?: XColumn): void {\n    let entry = this.occurrences.get(key);\n    if (!entry) this.occurrences.set(key, entry = { coordinates: new Map(), count: 0, gaps, axis });\n    let sample = entry.coordinates.get(coordinate);\n    if (!sample) entry.coordinates.set(coordinate, sample = { count: 0, examples: new Set(), series: new Set() });\n    sample.count += amount;\n    addSamples(sample.examples, examples);\n    addSamples(sample.series, series);\n    entry.count += amount;\n  }\n\n  traceRow(code: DiagnosticCode, field: string, effect: DiagnosticEffect, row: number, amount = 1, example?: string, series?: string): void {\n    this.trace(keyOf(code, field, effect), row, false, amount, example === undefined ? [] : [example], series === undefined ? [] : [series]);\n  }\n\n  traceGaps(field: string, effect: DiagnosticEffect, positions: Float64Array, details?: DiagnosticDetails, axis?: XColumn): void {\n    const key = keyOf('AX105', field, effect);\n    for (const position of positions) this.trace(key, position, true, 1, [], details?.series ?? [], axis);\n  }\n\n  traceSparseGaps(details: DiagnosticDetails, seriesKey?: string): void {\n    this.sparse.set(seriesKey ?? details.sparseSeries?.[0] ?? '', createDiagnostic('AX105', 'none', details));\n  }\n\n  merge(batch: StreamDiagnostics): void {\n    for (const [name, diagnostic] of batch.sparse) this.sparse.set(name, diagnostic);\n    for (const diagnostic of batch.entries.values()) this.add(diagnostic);\n    for (const [key, { coordinates, gaps, axis }] of batch.occurrences) {\n      for (const [coordinate, sample] of coordinates) this.trace(key, coordinate, gaps, sample.count, sample.examples, sample.series, axis);\n    }\n  }\n\n  evict(coordinate: number, gaps: boolean): void {\n    for (const [key, occurrence] of this.occurrences) {\n      if (occurrence.gaps !== gaps) continue;\n      const sample = occurrence.coordinates.get(coordinate);\n      if (!sample) continue;\n      occurrence.count -= sample.count;\n      occurrence.coordinates.delete(coordinate);\n      if (occurrence.count === 0) {\n        this.entries.delete(key);\n        this.occurrences.delete(key);\n      }\n    }\n  }\n\n  evictSeries(key: string): void {\n    this.sparse.delete(key);\n  }\n\n  override inputs(): readonly DiagnosticInput[] {\n    return this.retained();\n  }\n\n  retained(): readonly DiagnosticInput[] {\n    const result = new DiagnosticCollector();\n    for (const diagnostic of this.entries.values()) {\n      const { code, field, effect, origin } = diagnostic;\n      const entry = this.occurrences.get(keyOf(code, field, effect));\n      if (!entry) {\n        result.add(diagnostic);\n        continue;\n      }\n      const rows: number[] = [];\n      const examples = new Set<string>();\n      const series = new Set<string>();\n      for (const [coordinate, sample] of entry.coordinates) {\n        if (entry.gaps) {\n          examples.add(entry.axis ? positionName(entry.axis, coordinate) : String(coordinate));\n        } else {\n          rows.push(coordinate);\n          addSamples(examples, sample.examples);\n        }\n        addSamples(series, sample.series);\n        if (rows.length === 10 || entry.gaps && examples.size === 10) break;\n      }\n      result.add(createDiagnostic(code as DiagnosticCode, effect, {\n        ...diagnosticContext(diagnostic), field, count: entry.count,\n        rows: entry.gaps ? undefined : rows, examples: [...examples], series: [...series],\n      }, origin));\n    }\n    for (const diagnostic of this.sparse.values()) result.add