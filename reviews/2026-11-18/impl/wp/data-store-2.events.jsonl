{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/data/{normalize,table,values}.ts'","aggregated_output":"import {\n  SLOT_ABSENT_FIELD, SLOT_GAP, SLOT_NO_ROW, SLOT_NULL, SLOT_VALUE,\n  type AlignedFrame, type DiagnosticSink, type DonutFrame, type Environment, type Frame, type PointFrame,\n  type RowSource, type Series, type XColumn,\n} from '../core/contracts';\nimport { report, type DiagnosticDetails } from '../diagnostics';\nimport type { AlignedChartType, ChartType, ResolvedOptions, ResolvedValueField } from './options';\nimport { Reports } from './reports';\nimport { calendarIntervals, inferGaps, snapGap } from './steps';\nimport type { DiagnosticTrace } from './store-diagnostics';\nimport type { Table } from './table';\nimport { readValues, type Values } from './values';\nimport { inferKind, nameOf, positionName, XParser } from './x';\n\nexport type DataEnvironment = Pick<Environment, 'timeZone'>;\nexport interface FrameVersion { readonly epoch: number; readonly revision: number }\n\nfunction base(source: RowSource, version: FrameVersion) {\n  return { epoch: version.epoch, revision: version.revision, source };\n}\n\nfunction sourceRows(table: Table): Int32Array {\n  const rows = new Int32Array(table.length);\n  for (let i = 0; i < rows.length; i++) rows[i] = table.rowIndex(i);\n  return rows;\n}\n\nexport interface XData {\n  readonly parser: XParser;\n  readonly positions: Float64Array;\n  readonly order: Int32Array | null;\n}\n\nexport function readX(type: ChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, categories?: readonly string[]): XData {\n  const { x, table } = options;\n  const kind = x.type ?? inferKind(table, x.field, options.series) ?? (categories ? 'category' : 'number');\n  const parser = new XParser(x, kind, env, type === 'scatter', categories);\n  const reports = new Reports(x.field, sink);\n  const input = table.columns?.[x.field];\n  let positions = input instanceof Float64Array && (kind === 'number' || kind === 'time')\n    ? input : new Float64Array(table.length);\n  let ascending = true;\n  let last = -Infinity;\n  let valid = 0;\n  for (let i = 0; i < table.length; i++) {\n    const usableSeries = options.series === null || nameOf(table.read(i, options.series)) !== null;\n    const value = usableSeries\n      ? parser.read(input === undefined ? table.read(i, x.field) : input[i], table.rowIndex(i), reports, options.values.length)\n      : NaN;\n    if (positions === input && !Object.is(positions[i], value)) positions = positions.slice();\n    if (positions !== input) positions[i] = value;\n    if (!Number.isFinite(value)) {\n      ascending = false;\n      continue;\n    }\n    if (!(value > last)) ascending = false;\n    last = value;\n    valid++;\n  }\n  reports.flush(sink);\n  if (ascending) return { parser, positions, order: null };\n\n  const order = new Int32Array(valid);\n  let next = 0;\n  for (let i = 0; i < positions.length; i++) if (Number.isFinite(positions[i])) order[next++] = i;\n  order.sort((a, b) => positions[a]! - positions[b]!);\n  return { parser, positions, order };\n}\n\nfunction reportCalendarDates(x: XData, table: Table, sink: DiagnosticSink): void {\n  if (x.parser.kind !== 'time') return;\n  const length = x.order?.length ?? x.positions.length;\n  if (length < 2) return;\n  const first = x.positions[x.order?.[0] ?? 0]!;\n  let last = first;\n  const zone = x.parser.timeZone ?? 'UTC';\n  let matches = 3;\n  for (let i = 1; i < length; i++) {\n    const position = x.positions[x.order?.[i] ?? i]!;\n    if (position === last) continue;\n    matches &= calendarIntervals(last, position, zone);\n    if (!matches) return;\n    last = position;\n  }\n  if (last === first) return;\n  const rows: number[] = [];\n  for (let i = 0; i < x.positions.length && rows.length < 10; i++) {\n    if (Number.isFinite(x.positions[i])) rows.push(table.rowIndex(i));\n  }\n  report(sink, 'AX111', 'none', { field: x.parser.field.field, count: length, rows });\n}\n\ninterface Group {\n  readonly key: string;\n  readonly label: string;\n  readonly value: ResolvedValueField;\n  readonly order: Int32Array | null;\n}\n\nfunction groups(options: ResolvedOptions, x: XData, sink: DiagnosticSink): Group[] {\n  const { table, series } = options;\n  if (series === null) {\n    return options.values.map(value => ({\n      key: value.field, label: value.label, value, order: x.order,\n    }));\n  }\n\n  const indexes = new Map<string, number>();\n  const counts: number[] = [];\n  const membership = new Int32Array(table.length).fill(-1);\n  const reports = new Reports(series, sink);\n  for (let i = 0; i < table.length; i++) {\n    const raw = table.read(i, series);\n    const name = nameOf(raw);\n    if (name === null) {\n      if (raw === undefined) reports.add('AX102', 'omitted', table.rowIndex(i), undefined, undefined, { outcome: 'The affected row is not drawn.' });\n      else reports.add('AX107', 'omitted', table.rowIndex(i), raw, 'Supply a name for the series in each row.');\n      continue;\n    }\n    if (!Number.isFinite(x.positions[i])) continue;\n    let index = indexes.get(name);\n    if (index === undefined) {\n      index = indexes.size;\n      indexes.set(name, index);\n      counts.push(0);\n    }\n    membership[i] = index;\n    counts[index] = counts[index]! + 1;\n  }\n  reports.flush(sink);\n\n  const orders = counts.map(count => new Int32Array(count));\n  counts.fill(0);\n  for (let i = 0, n = x.order?.length ?? table.length; i < n; i++) {\n    const row = x.order?.[i] ?? i;\n    const index = membership[row]!;\n    if (index < 0) continue;\n    orders[index]![counts[index]!] = row;\n    counts[index] = counts[index]! + 1;\n  }\n  const value = options.values[0]!;\n  return Array.from(indexes, ([key, index]) => ({ key, label: key, value, order: orders[index]! }));\n}\n\ninterface AlignedGroup {\n  readonly group: Group;\n  readonly order: Int32Array | null;\n  readonly gaps: Float64Array | null;\n  readonly drawable: boolean;\n  readonly sparse?: number;\n}\n\nfunction alignGroup(group: Group, x: XData, axis: XColumn, field: string, table: Table, sink: DiagnosticSink, grid?: AlignedGroup): AlignedGroup {\n  const { positions } = x;\n  let order = group.order;\n  let drawable = true;\n  if (order) {\n    const duplicates = new Reports(field, sink);\n    let distinct = 0;\n    let kept = order;\n    let previous = -Infinity;\n    for (let i = 0; i < order.length; i++) {\n      const row = order[i]!;\n      const position = positions[row]!;\n      if (position === previous) {\n        duplicates.add('AX108', 'series-disabled', table.rowIndex(row), undefined, undefined, {\n          series: group.label, position: positionName(axis, position),\n        });\n        if (drawable) kept = order.slice();\n        drawable = false;\n      } else {\n        kept[distinct++] = row;\n        previous = position;\n      }\n    }\n    duplicates.flush(sink);\n    order = kept.subarray(0, distinct);\n  }\n  if (grid) return { group, order, drawable, gaps: grid.gaps, sparse: grid.sparse };\n  let sparse: number | undefined;\n  const gaps = inferGaps(axis, order?.length ?? positions.length, i => positions[order?.[i] ?? i]!,\n    (gap, a, b, step) => snapGap(gap, a, b, step, x.order?.length ?? positions.length, i => positions[x.order?.[i] ?? i]!),\n    count => { sparse = count; });\n  return { group, order, gaps, drawable, sparse };\n}\n\nfunction combinePositions(x: XData, groups: readonly AlignedGroup[]): Float64Array {\n  const gapSets = new Set(groups.flatMap(group => group.gaps ? [group.gaps] : []));\n  let gapCount = 0;\n  for (const gaps of gapSets) gapCount += gaps.length;\n  if (x.order === null && gapCount === 0) return x.positions;\n  const observed = x.order?.length ?? x.positions.length;\n  const positions = new Float64Array(observed + gapCount);\n  if (x.order) {\n    for (let i = 0; i < observed; i++) positions[i] = x.positions[x.order[i]!]!;\n  } else {\n    positions.set(x.positions);\n  }\n  let next = observed;\n  for (const gaps of gapSets) {\n    positions.set(gaps, next);\n    next += gaps.length;\n  }\n  if (gapCount) positions.sort();\n  let distinct = 0;\n  let last = -Infinity;\n  for (let i = 0; i < positions.length; i++) {\n    const position = positions[i]!;\n    if (position > last) {\n      positions[distinct++] = position;\n      last = position;\n    }\n  }\n  return positions.subarray(0, distinct);\n}\n\nexport function seriesDescription(key: string, label: string, value: ResolvedValueField) {\n  return { key, label, field: value.field, unit: value.unit, valueScale: value.scale };\n}\n\nexport function reportGaps(\n  sink: DiagnosticSink, field: string, changed: boolean, gaps: Float64Array | null,\n  axis?: XColumn, name?: string, sparse?: number, seriesKey?: string,\n): void {\n  if (!gaps?.length && !sparse) return;\n  const details: DiagnosticDetails = {\n    field, count: sparse ?? gaps?.length, series: name === undefined ? undefined : [name],\n    sparseSeries: sparse && name !== undefined ? [name] : undefined,\n    examples: gaps ? Array.from(gaps.subarray(0, 10), position => axis ? positionName(axis, position) : String(position)) : undefined,\n    zeroSeries: changed && !sparse ? name === undefined ? [] : [name] : undefined,\n  };\n  const trace = sink as DiagnosticTrace;\n  if (sparse && trace.traceSparseGaps) {\n    trace.traceSparseGaps(details, seriesKey);\n    return;\n  }\n  if (gaps) trace.traceGaps?.(field, 'none', gaps, details, axis);\n  report(sink, 'AX105', 'none', details);\n}\n\nfunction alignedSeries(aligned: AlignedGroup, axis: XColumn, x: XData, table: Table, values: Values): Series {\n  const { group, order, gaps, drawable } = aligned;\n  const { value } = group;\n  const zero = value.missing === 'zero';\n  const description = seriesDescription(group.key, group.label, value);\n\n  if (order === null && axis.values === x.positions) {\n    let row = table.columns ? null : sourceRows(table);\n    if (zero) {\n      for (let i = 0; i < values.slot.length; i++) {\n        if (values.slot[i] !== SLOT_NULL && values.slot[i] !== SLOT_ABSENT_FIELD) continue;\n        row ??= sourceRows(table);\n        row[i] = -1;\n        values.slot[i] = SLOT_VALUE;\n      }\n    }\n    return { ...description, drawable, y: values.y, slot: values.slot, row };\n  }\n  const length = axis.values.length;\n  const slot = new Uint8Array(length);\n  const row = new Int32Array(length).fill(-1);\n  const y = new Float64Array(length);\n  const observations = order?.length ?? table.length;\n  let observed = 0;\n  let gap = 0;\n  for (let i = 0; i < length; i++) {\n    const position = axis.values[i]!;\n    const source = order?.[observed] ?? observed;\n    if (observed < observations && x.positions[source] === position) {\n      const state = values.slot[source]!;\n      if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) {\n        y[i] = 0;\n      } else {\n        slot[i] = state;\n        row[i] = table.rowIndex(source);\n        y[i] = values.y[source]!;\n      }\n      observed++;\n    } else {\n      const state = gaps?.[gap] === position ? SLOT_GAP : SLOT_NO_ROW;\n      if (state === SLOT_GAP) gap++;\n      if (!zero) slot[i] = state;\n      y[i] = zero ? 0 : NaN;\n    }\n  }\n  return { ...description, drawable, y, slot, row };\n}\n\nconst maxAlignedSlots = 20_000_000;\n\nexport function alignmentFits(series: number, positions: number, sink: DiagnosticSink): boolean {\n  if (series * positions <= maxAlignedSlots) return true;\n  report(sink, 'AX134', 'chart-error', {\n    count: 1, detail: 'The aligned frame has ' + series + ' series and ' + positions + ' x positions, exceeding 20,000,000 slots.',\n  });\n  return false;\n}\n\nexport function alignedFrame(options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion): AlignedFrame {\n  const axis = x.parser.column(x.positions);\n  const { table } = options;\n  const frame = {\n    ...base(table, version), shape: 'aligned' as const,\n    xLabel: options.x.label, yLabel: options.values.length === 1 ? options.values[0]!.label : null,\n  };\n  const empty = () => ({ ...frame, x: { ...axis, values: new Float64Array(), categories: axis.categories && [] }, length: 0, series: [] });\n  const observed = combinePositions(x, []);\n  const groupsBySeries = groups(options, x, sink);\n  if (!alignmentFits(groupsBySeries.length, observed.length, sink)) return empty();\n  const aligned: AlignedGroup[] = [];\n  for (const group of groupsBySeries) {\n    aligned.push(alignGroup(group, x, axis, options.x.field, table, sink, options.series === null ? aligned[0] : undefined));\n  }\n  const positions = aligned.some(group => group.gaps) ? combinePositions(x, aligned) : observed;\n  if (!alignmentFits(aligned.length, positions.length, sink)) return empty();\n  const column = { ...axis, values: positions };\n  const included = x.order === null ? undefined : (row: number) => Number.isFinite(x.positions[row]);\n  const shared = options.series === null ? undefined : readValues(table, options.values[0]!, sink, true, 0, undefined, included);\n  const series = aligned.map(group => alignedSeries(group, column, x, table,\n    shared ?? readValues(table, group.group.value, sink, true, 0, undefined, included)));\n  for (const { group, gaps, sparse } of aligned) {\n    reportGaps(sink, options.x.field, group.value.missing === 'zero', gaps, axis, group.label, sparse, group.key);\n  }\n  return { ...frame, x: column, length: positions.length, series };\n}\n\nfunction pointFrame(options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion): PointFrame {\n  const { table } = options;\n  const value = options.values[0]!;\n  const included = x.order === null ? undefined : (row: number) => Number.isFinite(x.positions[row]);\n  const members = groups(options, x, sink);\n  const values = readValues(table, value, sink, false, 0, undefined, included, 'The affected points are not drawn.');\n  const series = members.map(group => {\n    const length = group.order?.length ?? x.positions.length;\n    if (!group.order && values.y instanceof Float64Array && values.slot.every(slot => slot === SLOT_VALUE)) {\n      return {\n        key: group.key, label: group.label, drawable: true, x: x.positions, y: values.y,\n        row: table.columns ? null : sourceRows(table),\n      };\n    }\n    const rows = new Int32Array(length);\n    let next = 0;\n    for (let i = 0; i < length; i++) {\n      const row = group.order?.[i] ?? i;\n      if (values.slot[row] === SLOT_VALUE) rows[next++] = row;\n    }\n    const kept = rows.subarray(0, next);\n    kept.sort((a, b) => x.positions[a]! - x.positions[b]! || values.y[a]! - values.y[b]!);\n    return {\n      key: group.key, label: group.label, drawable: true,\n      x: Float64Array.from(kept, row => x.positions[row]!), y: Float64Array.from(kept, row => values.y[row]!), row: Int32Array.from(kept, table.rowIndex),\n    };\n  });\n\n  return {\n    ...base(options.table, version), shape: 'points', xKind: x.parser.kind === 'category' ? 'number' : x.parser.kind,\n    timeZone: x.parser.timeZone, series, xLabel: options.x.label, yLabel: value.label, xUnit: options.x.unit, yUnit: value.unit,\n  };\n}\n\nfunction donutFrame(options: ResolvedOptions, sink: DiagnosticSink, version: FrameVersion): DonutFrame {\n  const { table, x } = options;\n  const field = options.values[0]!;\n  const labels: string[] = [];\n  const seen = new Set<string>();\n  const issues = new Reports(x.field, sink);\n  const negatives = new Reports(field.field, sink);\n  const rows = new Int32Array(table.length);\n  const included = new Uint8Array(table.length);\n  for (let i = 0; i < table.length; i++) {\n    const raw = table.read(i, x.field);\n    const name = nameOf(raw);\n    if (name === null) {\n      if (raw === undefined) issues.add('AX102', 'omitted', table.rowIndex(i), undefined, undefined, { outcome: 'The affected slice is not drawn.' });\n      else issues.add('AX107', 'omitted', table.rowIndex(i), raw, 'Supply a label for each donut value.');\n    } else {\n      if (seen.has(name)) issues.add('AX108', 'chart-error', table.rowIndex(i), name);\n      seen.add(name);\n      rows[labels.length] = i;\n      labels.push(name);\n      included[i] = 1;\n    }\n  }\n  issues.flush(sink);\n  const order = rows.subarray(0, labels.length);\n  const values = readValues(table, field, sink, true, 0, undefined, i => included[i] === 1);\n  const provenance = table.columns && order.length === table.length && field.missing !== 'zero'\n    ? null : Int32Array.from(order, table.rowIndex);\n  for (let i = 0; i < order.length; i++) {\n    const row = order[i]!;\n    const value = values.y[row]!;\n    if (value < 0) negatives.add('AX120', 'chart-error', table.rowIndex(row), value);\n    if (field.missing === 'zero' && (values.slot[row] === SLOT_NULL || values.slot[row] === SLOT_ABSENT_FIELD)) {\n      values.slot[row] = SLOT_VALUE;\n      provenance![i] = -1;\n    }\n  }\n  negatives.flush(sink);\n  const allRows = order.length === table.length;\n  return {\n    ...base(table, version), shape: 'donut', labels,\n    values: allRows && values.y instanceof Float64Array ? values.y : Float64Array.from(order, row => values.y[row]!),\n    slot: allRows ? values.slot : Uint8Array.from(order, row => values.slot[row]!),\n    row: provenance,\n    valueLabel: field.label, unit: field.unit, valueScale: field.scale,\n  };\n}\n\nexport function normalize(type: AlignedChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): AlignedFrame;\nexport function normalize(type: 'scatter', options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): PointFrame;\nexport function normalize(type: 'donut', options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): DonutFrame;\nexport function normalize(type: ChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Frame;\nexport function normalize(type: ChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Frame {\n  const valid = options.valid ? options : { ...options, table: { ...options.table, columns: null, length: 0 } };\n  if (type === 'donut') return donutFrame(valid, sink, version);\n  const x = readX(type, valid, env, sink);\n  reportCalendarDates(x, valid.table, sink);\n  return type === 'scatter' ? pointFrame(valid, x, sink, version) : alignedFrame(valid, x, sink, version);\n}\nimport type { RowSource } from '../core/contracts';\n\nexport type Columns = Readonly<Record<string, ArrayLike<unknown>>>;\n\nexport interface Table extends RowSource {\n  readonly length: number;\n  readonly columns: Columns | null;\n  read(row: number, field: string): unknown;\n  isColumnRow(row: number): boolean;\n  rowIndex(row: number): number;\n  hasField(field: string): boolean;\n  keys(): readonly string[];\n}\n\nfunction record(row: unknown): Record<string, unknown> | null {\n  return row !== null && typeof row === 'object' ? row as Record<string, unknown> : null;\n}\n\nexport function rowValue(row: unknown, field: string): unknown {\n  const object = record(row);\n  return object && Object.hasOwn(object, field) ? object[field] : undefined;\n}\n\nexport function rowsTable(rows: readonly unknown[]): Table {\n  return {\n    length: rows.length,\n    columns: null,\n    read: (row, field) => rowValue(rows[row], field),\n    rowAt: row => row >= 0 && row < rows.length && Number.isInteger(row) ? rows[row] : null,\n    isColumnRow: () => false,\n    rowIndex: row => row,\n    hasField: field => rows.some(row => {\n      const object = record(row);\n      return object !== null && Object.hasOwn(object, field);\n    }),\n    keys: () => {\n      const keys = new Set<string>();\n      for (const row of rows) for (const key of Object.keys(record(row) ?? {})) keys.add(key);\n      return [...keys];\n    },\n  };\n}\n\nexport function columnsTable(columns: Columns, length: number): Table {\n  const keys = Object.keys(columns);\n  return {\n    length,\n    columns,\n    read: (row, field) => Object.hasOwn(columns, field) ? columns[field]?.[row] : undefined,\n    rowAt: row => row >= 0 && row < length && Number.isInteger(row)\n      ? Object.fromEntries(keys.map(key => [key, columns[key]?.[row]]))\n      : null,\n    hasField: field => Object.hasOwn(columns, field),\n    isColumnRow: () => true,\n    rowIndex: row => row,\n    keys: () => keys,\n  };\n}\nimport { SLOT_ABSENT_FIELD, SLOT_INVALID, SLOT_NULL, SLOT_VALUE, type DiagnosticSink, type SlotState } from '../core/contracts';\nimport type { ResolvedValueField } from './options';\nimport { Reports } from './reports';\nimport type { Table } from './table';\n\nconst decimal = /^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$/;\nexport type ValueMode = 'empty' | 'decimal' | 'other';\n\nexport function valueMode(value: unknown, column: boolean): ValueMode {\n  if (value == null || value === '' || (column && typeof value === 'number' && Number.isNaN(value))) return 'empty';\n  return typeof value === 'string' && decimal.test(value) ? 'decimal' : 'other';\n}\n\nexport function inspectValues(table: Table, field: string, included?: (row: number) => boolean): ValueMode {\n  let mode: ValueMode = 'empty';\n  for (let i = 0; i < table.length; i++) {\n    if (included && !included(i)) continue;\n    const next = valueMode(table.read(i, field), table.isColumnRow(i));\n    if (next === 'other') return next;\n    if (next === 'decimal') mode = next;\n  }\n  return mode;\n}\n\nexport interface Values {\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n}\n\nexport function readValues(\n  table: Table,\n  field: ResolvedValueField,\n  sink: DiagnosticSink,\n  impute: boolean,\n  startRow = 0,\n  mode?: ValueMode,\n  included?: (row: number) => boolean,\n  outcome?: string,\n): Values {\n  mode ??= inspectValues(table, field.field, included);\n  const column = table.columns?.[field.field];\n  const zero = impute && field.missing === 'zero';\n  const reports = new Reports(field.field, sink);\n  const slot = new Uint8Array(table.length);\n  let y = column instanceof Float64Array || column instanceof Float32Array ? column : new Float64Array(table.length);\n\n  for (let i = 0; i < table.length; i++) {\n    if (included && !included(i)) continue;\n    const raw = column === undefined ? table.read(i, field.field) : column[i];\n    let value = NaN;\n    let state: SlotState = SLOT_VALUE;\n    if (typeof raw === 'number') {\n      if (Number.isFinite(raw)) value = raw;\n      else if (Number.isNaN(raw) && (column || table.isColumnRow(i))) state = SLOT_NULL;\n      else {\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n      }\n    } else if (raw === undefined) {\n      state = SLOT_ABSENT_FIELD;\n      reports.add('AX102', zero ? 'changed' : 'omitted', startRow + table.rowIndex(i), undefined, undefined, { outcome });\n    } else if (raw === null || raw === '') {\n      state = SLOT_NULL;\n    } else if (mode === 'decimal') {\n      value = Number(raw);\n      if (!Number.isFinite(value)) {\n        value = NaN;\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n      }\n      if (field.parse !== 'number') reports.add('AX104', 'none', startRow + table.rowIndex(i));\n    } else {\n      state = SLOT_INVALID;\n      reports.add('AX106', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n    }\n    if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) value = 0;\n    if (y === column && !Object.is(y[i], value)) {\n      // Infinity and explicit zero imputation cannot be represented by an unchanged borrowed view.\n      y = y.slice();\n    }\n    if (y !== column) y[i] = value;\n    slot[i] = state;\n  }\n\n  reports.flush(sink);\n  return { y, slot };\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/data/{index,store,store-rows,store-buffers,store-diagnostics,store-calendar}.ts'","aggregated_output":"export { normalize } from './normalize';\nexport type { DataEnvironment, FrameVersion } from './normalize';\nexport { resolveOptions } from './options';\nexport type { AlignedChartType, ChartType, ResolvedOptions, ResolvedValueField, ResolvedXField } from './options';\nexport { AlignedStore } from './store';\nexport { validateOptions } from './validate';\nimport {\n  SLOT_ABSENT_FIELD, SLOT_GAP, SLOT_NO_ROW, SLOT_NULL, SLOT_VALUE,\n  type AlignedFrame, type DiagnosticInput, type DiagnosticSink, type XColumn,\n} from '../core/contracts';\nimport { DiagnosticCollector } from '../diagnostics';\nimport {\n  alignedFrame, alignmentFits, normalize, readX, reportGaps, seriesDescription,\n  type DataEnvironment, type FrameVersion, type XData,\n} from './normalize';\nimport { checkFields, type AlignedChartType, type ResolvedOptions, type ResolvedValueField } from './options';\nimport { Reports } from './reports';\nimport { gapPosition, snapGap, stepDelta, stepMultiple, supportsSteps, tooSparse } from './steps';\nimport { FrameBuffers, type SeriesBuffers } from './store-buffers';\nimport { CalendarWindow } from './store-calendar';\nimport { StreamDiagnostics } from './store-diagnostics';\nimport { StreamRows } from './store-rows';\nimport { rowValue, rowsTable, type Table } from './table';\nimport { readValues, valueMode, type ValueMode, type Values } from './values';\nimport { countKinds, dateUnitOf, kindOf, nameOf, positionName, preferredKind, type DateUnit, type KindVotes } from './x';\n\nconst quiet: DiagnosticSink = { add: () => {} };\ntype Fields = Omit<ResolvedOptions, 'table'>;\n\ninterface Cadence {\n  last: number;\n  differences: number;\n  min: number;\n  span: number;\n  matches: number;\n  multiple: boolean | null;\n}\n\nfunction cadence(): Cadence {\n  return { last: -Infinity, differences: 0, min: Infinity, span: 0, matches: 0, multiple: true };\n}\n\nfunction step(c: Cadence): number {\n  return c.multiple && c.differences >= 2 && 2 * c.matches >= c.differences ? c.min : 0;\n}\n\nfunction extend(c: Cadence, axis: XColumn, x: number): void {\n  const previous = c.last;\n  c.last = x;\n  if (previous === -Infinity || !supportsSteps(axis)) return;\n  const delta = stepDelta(axis, previous, x);\n  if (delta < c.min && stepMultiple(delta, c.min) !== 1) {\n    // An irregular prefix only needs a second pass if the smaller step later becomes frequent enough.\n    c.multiple = c.differences === c.matches ? c.differences === 0 || stepMultiple(c.min, delta) > 0 : null;\n    c.min = delta;\n    c.matches = 1;\n  } else {\n    const multiple = stepMultiple(delta, c.min);\n    if (multiple === 1) c.matches++;\n    if (multiple === 0) c.multiple = false;\n  }\n  c.span += delta;\n  c.differences++;\n}\n\nfunction absent(c: Cadence, size: number): number {\n  return size ? Math.max(0, Math.round(c.span / size) - c.differences) : 0;\n}\n\nclass Observations {\n  private positions = new Float64Array();\n  private start = 0;\n  private end = 0;\n\n  get first(): number | undefined { return this.at(0); }\n\n  at(index: number): number | undefined {\n    return this.start + index < this.end ? this.positions[this.start + index] : undefined;\n  }\n\n  add(position: number): void {\n    if (this.end === this.positions.length) this.resize(1);\n    this.positions[this.end++] = position;\n  }\n\n  evict(): void {\n    this.start++;\n    if (this.positions.length > Math.max(8, 4 * (this.end - this.start))) this.resize(0);\n  }\n\n  private resize(extra: number): void {\n    const retained = this.positions.subarray(this.start, this.end);\n    this.positions = new Float64Array(Math.max(4, 2 * (retained.length + extra)));\n    this.positions.set(retained);\n    this.start = 0;\n    this.end = retained.length;\n  }\n}\n\nfunction readCadence(axis: XColumn, observations: Observations): Cadence {\n  const c = cadence();\n  for (let i = 0, position = observations.first; position !== undefined; position = observations.at(++i)) {\n    if (i && supportsSteps(axis)) {\n      const delta = stepDelta(axis, c.last, position);\n      c.min = Math.min(c.min, delta);\n      c.span += delta;\n      c.differences++;\n    }\n    c.last = position;\n  }\n  for (let i = 1, position = observations.at(1); position !== undefined; position = observations.at(++i)) {\n    if (!supportsSteps(axis)) break;\n    const multiple = stepMultiple(stepDelta(axis, observations.at(i - 1)!, position), c.min);\n    if (multiple === 1) c.matches++;\n    if (!multiple) c.multiple = false;\n  }\n  return c;\n}\n\nfunction seriesKeys(table: Table, field: string | null): (string | null)[] | null {\n  if (field === null) return null;\n  const keys = new Array<string | null>(table.length);\n  for (let row = 0; row < table.length; row++) keys[row] = nameOf(table.read(row, field));\n  return keys;\n}\n\nfunction eachObservation(\n  options: Fields, x: XData, keys: readonly (string | null)[] | null,\n  visit: (key: string, position: number) => void,\n): void {\n  const length = x.order?.length ?? x.positions.length;\n  for (let i = 0; i < length; i++) {\n    const row = x.order?.[i] ?? i;\n    const position = x.positions[row]!;\n    if (keys) {\n      const key = keys[row];\n      if (key != null) visit(key, position);\n    } else {\n      for (const field of options.values) visit(field.field, position);\n    }\n  }\n}\n\nfunction cadences(options: Fields, table: Table, x: XData, axis: XColumn) {\n  const keys = seriesKeys(table, options.series);\n  const observations = new Map<string, Observations>();\n  const duplicates = new Map<string, Set<number>>();\n  const last = new Map<string, number>();\n  eachObservation(options, x, keys, (key, position) => {\n    let window = observations.get(key);\n    if (!window) observations.set(key, window = new Observations());\n    if (position === last.get(key)) {\n      let positions = duplicates.get(key);\n      if (!positions) duplicates.set(key, positions = new Set());\n      positions.add(position);\n    } else {\n      window.add(position);\n      last.set(key, position);\n    }\n  });\n  const history = new Map(Array.from(observations, ([key, window]) => [key, readCadence(axis, window)]));\n  return { history, observations, duplicates };\n}\n\nfunction calendarFor(x: XData, table: Table): CalendarWindow | null {\n  if (x.parser.kind !== 'time') return null;\n  const history = new CalendarWindow(x.parser.timeZone ?? 'UTC');\n  for (let i = 0, n = x.order?.length ?? x.positions.length; i < n; i++) {\n    history.observe(x.positions[x.order?.[i] ?? i]!);\n  }\n  for (let i = 0; i < x.positions.length; i++) {\n    if (Number.isFinite(x.positions[i])) history.record(table.rowIndex(i));\n  }\n  return history;\n}\n\ninterface ValueCounts {\n  decimal: number;\n  other: number;\n}\n\nfunction mode(counts: ValueCounts): ValueMode {\n  return counts.other ? 'other' : counts.decimal ? 'decimal' : 'empty';\n}\n\nfunction valueCounts(table: Table, field: string, positions: Float64Array): ValueCounts {\n  const counts = { decimal: 0, other: 0 };\n  for (let i = 0; i < table.length; i++) {\n    if (!Number.isFinite(positions[i])) continue;\n    const kind = valueMode(table.read(i, field), table.isColumnRow(i));\n    if (kind !== 'empty') counts[kind]++;\n  }\n  return counts;\n}\n\ninterface State {\n  readonly axis: XColumn;\n  readonly parser: XData['parser'];\n  readonly buffers: FrameBuffers;\n  readonly history: Map<string, Cadence>;\n  readonly observations: Map<string, Observations>;\n  readonly duplicates: Map<string, Set<number>>;\n  readonly modes: Map<string, ValueCounts>;\n  readonly calendar: CalendarWindow | null;\n  readonly votes: KindVotes | null;\n  readonly dateUnits: Record<DateUnit, number> | null;\n  readonly overBudget: boolean;\n  readonly diagnostics: StreamDiagnostics;\n}\n\ninterface BatchSeries {\n  readonly key: string;\n  readonly value: ResolvedValueField;\n  readonly values: Values;\n  readonly rows: readonly number[];\n  readonly cadence: Cadence;\n  readonly duplicates: readonly number[];\n  readonly gaps: Float64Array | null;\n  readonly sparse: number;\n}\n\ninterface Batch {\n  readonly positions: Float64Array;\n  readonly axis: XColumn;\n  readonly series: readonly BatchSeries[];\n  readonly x: Float64Array;\n  readonly observed: Uint8Array;\n  readonly modes: State['modes'];\n  readonly diagnostics: StreamDiagnostics;\n}\n\nfunction tail(\n  positions: Float64Array, series: readonly BatchSeries[], lastX: number,\n): { x: Float64Array; observed: Uint8Array } {\n  const gapCount = series.reduce((sum, item) => sum + (item.gaps?.length ?? 0), 0);\n  const distinct = new Float64Array(positions.length + gapCount);\n  let length = 0;\n  for (const position of positions) {\n    if (position > lastX && Number.isFinite(position) && (!length || position !== distinct[length - 1])) distinct[length++] = position;\n  }\n  const seen = distinct.subarray(0, length);\n  if (!gapCount) return { x: seen, observed: new Uint8Array(length).fill(1) };\n  const union = distinct.slice(0, length + gapCount);\n  for (const { gaps } of series) {\n    if (!gaps) continue;\n    union.set(gaps, length);\n    length += gaps.length;\n  }\n  union.sort();\n  const observed = new Uint8Array(length);\n  let index = 0;\n  let count = 0;\n  for (const x of union) {\n    if (count && x === union[count - 1]) continue;\n    union[count] = x;\n    if (seen[index] === x) {\n      observed[count] = 1;\n      index++;\n    }\n    count++;\n  }\n  return { x: union.subarray(0, count), observed: observed.subarray(0, count) };\n}\n\nfunction extendSeries(\n  key: string, field: ResolvedValueField, values: Values, rows: readonly number[],\n  positions: Float64Array, state: State, axis: XColumn, lastX: number,\n  duplicates: Reports, firstRow: number, observedX: () => Float64Array, label: string = key,\n): BatchSeries | null {\n  const previous = state.history.get(key) ?? cadence();\n  const next = { ...previous };\n  const observed: number[] = [];\n  const repeated: number[] = [];\n  for (const row of rows) {\n    const position = positions[row]!;\n    if (position === next.last) {\n      repeated.push(position);\n      duplicates.add('AX108', 'series-disabled', firstRow + row, undefined, undefined, {\n        series: label, position: axis.kind === 'category' ? JSON.stringify(state.parser.categoryName(position)) : positionName(axis, position),\n      });\n    } else {\n      extend(next, axis, position);\n      observed.push(row);\n    }\n  }\n  if (next.multiple === null && next.differences >= 2 && 2 * next.matches >= next.differences) return null;\n  const oldStep = step(previous);\n  const newStep = step(next);\n  const oldAbsent = absent(previous, oldStep);\n  const nextAbsent = absent(next, newStep);\n  const oldSparse = tooSparse(oldAbsent, previous.differences + 1);\n  const newSparse = tooSparse(nextAbsent, next.differences + 1);\n  if (oldSparse !== newSparse || oldStep !== newStep && !newSparse &&\n    (oldAbsent > 0 || absent(previous, newStep) > 0)) return null;\n  if (newSparse) return { key, value: field, values, rows: observed, cadence: next, gaps: null, duplicates: repeated, sparse: nextAbsent };\n\n  let gapCount = 0;\n  if (newStep) {\n    let last = previous.last;\n    for (const row of observed) {\n      const position = positions[row]!;\n      if (last !== -Infinity) gapCount += stepMultiple(stepDelta(axis, last, position), newStep) - 1;\n      last = position;\n    }\n  }\n  const gaps = gapCount ? new Float64Array(gapCount) : null;\n  if (gaps) {\n    let index = 0;\n    let last = previous.last;\n    for (const row of observed) {\n      const position = positions[row]!;\n      const multiple = last === -Infinity ? 0 : stepMultiple(stepDelta(axis, last, position), newStep);\n      for (let j = 1; j < multiple; j++) {\n        let gap = gapPosition(axis, last, position, newStep, j, multiple);\n        if (axis.kind === 'number') {\n          const x = observedX();\n          const previous = Number.isFinite(lastX) ? 1 : 0;\n          gap = snapGap(gap, last, position, newStep, x.length + previous, i => previous && i === 0 ? lastX : x[i - previous]!);\n        }\n        if (gap <= lastX) return null;\n        gaps[index++] = gap;\n      }\n      last = position;\n    }\n  }\n  return { key, value: field, values, rows: observed, cadence: next, gaps, duplicates: repeated, sparse: 0 };\n}\n\nfunction keptTable(table: Table, x: XData, keep: number): {\n  table: Table; discarded: readonly number[]; categories: readonly string[] | null;\n} | null {\n  const { positions, order, parser } = x;\n  let first = Infinity;\n  let distinct = 0;\n  if (keep > 0) {\n    for (let i = (order?.length ?? positions.length) - 1; i >= 0; i--) {\n      const position = positions[order?.[i] ?? i]!;\n      if (position === first) continue;\n      if (distinct === keep) break;\n      first = position;\n      distinct++;\n    }\n    if (distinct < keep) return null;\n  }\n\n  const unplaced: number[] = [];\n  let latest = -Infinity;\n  for (let i = 0; i < table.length; i++) {\n    const position = positions[i]!;\n    if (Number.isFinite(position)) latest = Math.max(latest, position);\n    else if (latest >= first) unplaced.push(i);\n  }\n  const earliestUnplaced = unplaced[Math.max(0, unplaced.length - 2 * keep)] ?? Infinity;\n  const indexes: number[] = [];\n  const discarded: number[] = [];\n  for (let i = 0; i < table.length; i++) {\n    const position = positions[i]!;\n    if ((Number.isFinite(position) ? position >= first : i >= earliestUnplaced)) indexes.push(i);\n    else discarded.push(table.rowIndex(i));\n  }\n  if (discarded.length === 0) return null;\n  return {\n    table: {\n      ...table, length: indexes.length,\n      read: (i, field) => table.read(indexes[i]!, field),\n      isColumnRow: i => table.isColumnRow(indexes[i]!),\n      rowIndex: i => table.rowIndex(indexes[i]!),\n      rowAt: i => table.rowAt(indexes[i]!),\n    },\n    discarded, categories: parser.categories?.slice(first) ?? null,\n  };\n}\n\nfunction writeObservation(\n  series: SeriesBuffers, target: number, values: Values, row: number, base: number, zero: boolean,\n): void {\n  const state = values.slot[row]!;\n  const imputed = zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD);\n  series.y[target] = values.y[row]!;\n  series.slot[target] = imputed ? SLOT_VALUE : state;\n  series.row[target] = imputed ? -1 : base + row;\n}\n\nexport class AlignedStore {\n  private readonly rows: StreamRows;\n  private readonly fields: Fields;\n  private state: State;\n  private current: AlignedFrame;\n  private latest: readonly DiagnosticInput[];\n\n  constructor(\n    private readonly type: AlignedChartType,\n    options: ResolvedOptions,\n    private readonly environment: DataEnvironment,\n    version: FrameVersion,\n    private readonly sink: DiagnosticSink = quiet,\n  ) {\n    const { table, ...fields } = options;\n    this.rows = new StreamRows(table);\n    this.fields = fields;\n    const { frame, state, x } = this.build(table, version);\n    this.state = state;\n    this.rows.resetPositions(table, x.positions);\n    this.current = this.snapshot(frame);\n    this.latest = this.currentDiagnostics();\n    for (const diagnostic of this.latest) this.sink.add(diagnostic);\n  }\n\n  get frame(): AlignedFrame {\n    return this.current;\n  }\n\n  get diagnostics(): readonly DiagnosticInput[] {\n    return this.latest;\n  }\n\n  private build(table: Table, version: FrameVersion, categories: readonly string[] | null = this.state?.parser.categories ?? null) {\n    const options = { ...this.fields, table };\n    const diagnostics = new StreamDiagnostics();\n    const x = readX(this.type, this.fields.valid ? options : { ...options, table: rowsTable([]) },\n      this.environment, diagnostics, categories ?? undefined);\n    const frame = options.valid ? alignedFrame(options, x, diagnostics, version)\n      : normalize(this.type, options, this.environment, diagnostics, version);\n    const axis = x.parser.column(new Float64Array(), true);\n    const overBudget = diagnostics.inputs().some(diagnostic => diagnostic.code === 'AX134');\n    const dateUnits = axis.kind === 'date' ? { day: 0, month: 0, year: 0 } : null;\n    if (dateUnits && !overBudget) {\n      for (let i = 0; i < table.length; i++) {\n        if (Number.isFinite(x.positions[i])) dateUnits[dateUnitOf(table.read(i, options.x.field))]++;\n      }\n    }\n    const state: State = {\n      axis, parser: x.parser, buffers: new FrameBuffers(frame, x.positions, x.order),\n      ...(overBudget ? { history: new Map(), observations: new Map(), duplicates: new Map() } : cadences(options, table, x, frame.x)),\n      modes: overBudget ? new Map() : new Map(options.values.map(value => [value.field, valueCounts(table, value.field, x.positions)])),\n      calendar: overBudget ? null : calendarFor(x, table),\n      votes: options.x.type === null ? countKinds(table, options.x.field, options.series) : null,\n      overBudget, dateUnits, diagnostics,\n    };\n    return { frame, state, x };\n  }\n\n  private batch(table: Table, positions: Float64Array, axis: XColumn, lastX: number, diagnostics: StreamDiagnostics): Batch | null {\n    const { state, fields } = this;\n    const modes = new Map(state.modes);\n    const values = new Map<string, Values>();\n    const included = (i: number) => Number.isFinite(positions[i]);\n    for (const field of fields.values) {\n      const before = modes.get(field.field) ?? { decimal: 0, other: 0 };\n      const added = valueCounts(table, field.field, positions);\n      if (mode(before) === 'decimal' && added.other) return null;\n      const counts = { decimal: before.decimal + added.decimal, other: before.other + added.other };\n      modes.set(field.field, counts);\n      values.set(field.field, readValues(table, field, diagnostics, true, this.rows.next, mode(counts), included));\n    }\n\n    const memberships = new Map<string, number[]>();\n    const seriesReports = fields.series === null ? null : new Reports(fields.series, diagnostics);\n    const allRows: number[] = [];\n    for (let i = 0; i < table.length; i++) {\n      const position = positions[i]!;\n      if (Number.isFinite(position) && !seriesReports) allRows.push(i);\n      if (!seriesReports) continue;\n      const raw = table.read(i, fields.series!);\n      const key = nameOf(raw);\n      if (key === null) {\n        if (raw === undefined) seriesReports.add('AX102', 'omitted', this.rows.next + i, undefined, undefined, { outcome: 'The affected row is not drawn.' });\n        else seriesReports.add('AX107', 'omitted', this.rows.next + i, raw, 'Supply a name for the series in each row.');\n        continue;\n      }\n      if (!Number.isFinite(position)) continue;\n      let indexes = memberships.get(key);\n      if (!indexes) memberships.set(key, indexes = []);\n      indexes.push(i);\n    }\n    seriesReports?.flush(diagnostics);\n\n    const series: BatchSeries[] = [];\n    const duplicates = new Reports(fields.x.field, diagnostics);\n    let validX: Float64Array | undefined;\n    const observedX = () => validX ??= positions.every(Number.isFinite) ? positions : positions.filter(Number.isFinite);\n    if (fields.series !== null) {\n      for (const [key, rows] of memberships) {\n        const value = fields.values[0]!;\n        const item = extendSeries(key, value, values.get(value.field)!, rows, positions, state, axis, lastX, duplicates, this.rows.next, observedX);\n        if (!item) return null;\n        series.push(item);\n      }\n    } else {\n      for (const field of fields.values) {\n        const item = extendSeries(field.field, field, values.get(field.field)!, allRows, positions, state, axis, lastX, duplicates, this.rows.next, observedX, field.label);\n        if (!item) return null;\n        series.push(item);\n      }\n    }\n    duplicates.flush(diagnostics);\n    for (const item of series) {\n      reportGaps(diagnostics, fields.x.field, item.value.missing === 'zero', item.gaps, axis, this.label(item.key), item.sparse, item.key);\n    }\n    return { positions, axis, series, ...tail(positions, series, lastX), modes, diagnostics };\n  }\n\n  private commitBatch(batch: Batch, rows: readonly unknown[], version: FrameVersion): void {\n    const base = this.rows.next;\n    this.rows.append(rows);\n    for (let i = 0; i < batch.positions.length; i++) {\n      const position = batch.positions[i]!;\n      const row = base + i;\n      this.rows.record(position, row);\n      if (!Number.isFinite(position)) continue;\n      if (this.state.dateUnits) this.state.dateUnits[dateUnitOf(rowValue(rows[i], this.fields.x.field))]++;\n      this.state.calendar?.observe(position);\n      this.state.calendar?.record(row);\n    }\n\n    const { buffers } = this.state;\n    buffers.reserve(batch.x.length);\n    const { end } = buffers;\n    const lastX = buffers.x[end - 1];\n    buffers.x.set(batch.x, end);\n    buffers.observed.set(batch.observed, end);\n    for (const observed of batch.observed) buffers.distinct += observed;\n    const updates = new Map(batch.series.map(item => [item.key, item]));\n    const priorWrites = new Set<string>();\n    for (const item of batch.series) {\n      let series = buffers.series.get(item.key);\n      const zero = item.value.missing === 'zero';\n      const first = item.rows[0];\n      const replacingLast = first !== undefined && batch.positions[first] === lastX;\n      if (!series) {\n        series = buffers.addSeries({\n          ...seriesDescription(item.key, this.fields.series === null ? item.value.label : item.key, item.value),\n          drawable: true,\n        }, zero);\n      }\n      if (item.duplicates.length) {\n        let positions = this.state.duplicates.get