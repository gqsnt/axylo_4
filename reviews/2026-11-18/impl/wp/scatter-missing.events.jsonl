{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/data/store-unaligned.ts'","aggregated_output":"import type { DiagnosticInput, DiagnosticSink, DonutFrame, PointFrame } from '../core/contracts';\nimport { DiagnosticCollector } from '../diagnostics';\nimport { normalize, pointFrame, readX, reportCalendarDates, type DataEnvironment, type FrameVersion } from './normalize';\nimport { resolveOptions, resolveTable, retargetOptions, withoutTable, type ResolvedOptions } from './options';\nimport { Reports } from './reports';\nimport { FrameSource, RowRevisions, StreamRows } from './store-rows';\nimport { CalendarWindow } from './store-calendar';\nimport { StoreMap } from './store-map';\nimport { Column, Labels } from './store-window';\nimport { rowsTable, type Table } from './table';\nimport { once, retention, type PreparedFrame, type StoreAppendOptions } from './transaction';\nimport { nameOf } from './x';\n\nconst quiet: DiagnosticSink = { add() {} };\n\ninterface Result<F> {\n  readonly frame: F;\n  readonly positions: Float64Array;\n  readonly order: Int32Array | null;\n}\n\ntype Build<F> = (options: ResolvedOptions, environment: DataEnvironment, sink: DiagnosticSink, version: FrameVersion) => Result<F>;\n\ninterface Storage<F> {\n  frame(frame: F): F;\n  extend(next: Result<F>, rows: StreamRows, firstRow: number, keep: number | undefined): Storage<F> | null;\n  commit(): void;\n}\n\ntype Open<F> = (result: Result<F>) => Storage<F> | null;\n\nconst doubles = (length: number) => new Float64Array(length);\nconst indexes = (length: number) => new Int32Array(length);\nconst states = (length: number) => new Uint8Array(length);\n\nfunction buildPoints(options: ResolvedOptions, environment: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Result<PointFrame> {\n  if (!options.valid) {\n    return { frame: normalize('scatter', options, environment, sink, version), positions: new Float64Array(), order: null };\n  }\n  const x = readX('scatter', options, environment, sink);\n  reportCalendarDates(x, options.table, sink);\n  return { ...x, frame: pointFrame(options, x, sink, version) };\n}\n\nfunction buildDonut(options: ResolvedOptions, environment: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Result<DonutFrame> {\n  const frame = normalize('donut', options, environment, sink, version);\n  const positions = new Float64Array(options.valid ? options.table.length : 0).fill(NaN);\n  const labels = new Map<string, number>();\n  const order = new Int32Array(frame.labels.length);\n  let length = 0;\n  for (let i = 0; i < positions.length; i++) {\n    const label = nameOf(options.table.read(i, options.x.field));\n    if (label === null) continue;\n    let index = labels.get(label);\n    if (index === undefined) labels.set(label, index = labels.size);\n    positions[i] = index;\n    order[length++] = i;\n  }\n  order.sort((a, b) => positions[a]! - positions[b]!);\n  return { frame, positions, order };\n}\n\nfunction firstPosition(result: Result<PointFrame | DonutFrame>, keep: number): number {\n  const { positions, order } = result;\n  let first = Infinity;\n  let distinct = 0;\n  for (let i = (order?.length ?? positions.length) - 1; i >= 0; i--) {\n    const position = positions[order?.[i] ?? i]!;\n    if (position === first) continue;\n    if (distinct === keep) return first;\n    first = position;\n    distinct++;\n  }\n  return -Infinity;\n}\n\nfunction ordered(positions: Float64Array, last: number = -Infinity): boolean {\n  for (const position of positions) {\n    if (!Number.isFinite(position) || position < last) return false;\n    last = position;\n  }\n  return true;\n}\n\nclass Points implements Storage<PointFrame> {\n  private constructor(\n    private readonly kind: PointFrame['xKind'],\n    private readonly positions: Column<Float64Array>, private distinct: number,\n    private readonly x: Column<Float64Array>, private readonly y: Column<Float64Array>, private readonly row: Column<Int32Array>,\n    private readonly calendar: CalendarWindow | null,\n  ) {}\n\n  static open({ frame, positions }: Result<PointFrame>): Points | null {\n    const series = frame.series[0];\n    if (frame.series.length !== 1 || !series?.row || !ordered(positions)) return null;\n    const calendar = frame.xKind === 'time' ? new CalendarWindow(frame.timeZone ?? 'UTC') : null;\n    let distinct = 0;\n    let last = -Infinity;\n    for (const position of positions) {\n      if (position !== last) distinct++;\n      last = position;\n      calendar?.observe(position);\n    }\n    return new Points(frame.xKind, new Column(doubles, positions), distinct,\n      new Column(doubles, series.x), new Column(doubles, series.y), new Column(indexes, series.row), calendar);\n  }\n\n  extend(next: Result<PointFrame>, rows: StreamRows, firstRow: number, keep: number | undefined): Points | null {\n    const series = next.frame.series[0];\n    const last = this.positions.view().at(-1);\n    if (next.frame.xKind !== this.kind || !series?.row || !ordered(next.positions, last)) return null;\n    // A tie can append if its y also sorts after the old tail. Otherwise the old snapshot\n    // and the new sort order need different storage.\n    const lastX = this.x.view().at(-1);\n    const lastY = this.y.view().at(-1);\n    if (lastX !== undefined && lastY !== undefined && series.x[0] === lastX && series.y[0]! < lastY) return null;\n\n    const calendar = this.calendar?.fork() ?? null;\n    if (calendar) {\n      for (const position of next.positions) calendar.observe(position);\n      if (calendar.daily()) return null;\n    }\n    const draft = new Points(this.kind, this.positions.fork(), this.distinct,\n      this.x.fork(), this.y.fork(), this.row.fork(), calendar);\n    draft.positions.append(next.positions);\n    draft.x.append(series.x);\n    draft.y.append(series.y);\n    draft.row.append(series.row);\n    let previous = last;\n    for (let i = 0; i < next.positions.length; i++) {\n      const position = next.positions[i]!;\n      if (position !== previous) draft.distinct++;\n      previous = position;\n      rows.record(position, firstRow + i);\n    }\n\n    if (keep !== undefined && draft.distinct > keep) {\n      const positions = draft.positions.view();\n      let removed = 0;\n      while (draft.distinct > keep) {\n        const x = positions[removed]!;\n        rows.evictRead(x);\n        calendar?.evictPosition(x);\n        do removed++; while (positions[removed] === x);\n        draft.distinct--;\n      }\n      if (calendar?.daily()) return null;\n      const first = positions[removed] ?? Infinity;\n      const x = draft.x.view();\n      let points = 0;\n      while (points < x.length && x[points]! < first) points++;\n      draft.positions.drop(removed);\n      draft.x.drop(points);\n      draft.y.drop(points);\n      draft.row.drop(points);\n    }\n\n    return draft;\n  }\n\n  commit(): void { this.calendar?.commit(); }\n\n  frame(frame: PointFrame): PointFrame {\n    return { ...frame, series: [{ ...frame.series[0]!, x: this.x.view(), y: this.y.view(), row: this.row.view() }] };\n  }\n}\n\nclass Slices implements Storage<DonutFrame> {\n  private constructor(\n    private readonly labels: Labels, private readonly positions: StoreMap<string, number>, private next: number,\n    private readonly values: Column<Float64Array>, private readonly slot: Column<Uint8Array>, private readonly row: Column<Int32Array>,\n  ) {}\n\n  static open({ frame, positions }: Result<DonutFrame>): Slices | null {\n    if (frame.labels.length !== positions.length || !frame.row) return null;\n    const labels = new Map(frame.labels.map((label, index) => [label, index]));\n    if (labels.size !== frame.labels.length) return null;\n    return new Slices(new Labels(frame.labels), new StoreMap(labels), labels.size,\n      new Column(doubles, frame.values), new Column(states, frame.slot), new Column(indexes, frame.row));\n  }\n\n  commit(): void { this.positions.commit(); }\n\n  extend(next: Result<DonutFrame>, rows: StreamRows, firstRow: number, keep: number | undefined): Slices | null {\n    const frame = next.frame;\n    if (frame.labels.length !== next.positions.length || !frame.row || frame.labels.some(label => this.positions.has(label))) return null;\n    const draft = new Slices(this.labels.fork(), this.positions.fork(), this.next,\n      this.values.fork(), this.slot.fork(), this.row.fork());\n    for (let i = 0; i < frame.labels.length; i++) {\n      const label = frame.labels[i]!;\n      draft.labels.push(label);\n      const position = draft.next++;\n      draft.positions.set(label, position);\n      rows.record(position, firstRow + i);\n    }\n    draft.values.append(frame.values);\n    draft.slot.append(frame.slot);\n    draft.row.append(frame.row);\n\n    if (keep !== undefined && draft.labels.length > keep) {\n      const dropped = draft.labels.length - keep;\n      for (let i = 0; i < dropped; i++) {\n        const label = draft.labels.at(i);\n        rows.evictRead(draft.positions.get(label)!);\n        draft.positions.delete(label);\n      }\n      draft.labels.drop(dropped);\n      draft.values.drop(dropped);\n      draft.slot.drop(dropped);\n      draft.row.drop(dropped);\n    }\n\n    return draft;\n  }\n\n  frame(frame: DonutFrame): DonutFrame {\n    return { ...frame, labels: this.labels.view(), values: this.values.view(), slot: this.slot.view(), row: this.row.view() };\n  }\n}\n\nfunction removeRows(table: Table, positions: Float64Array, keep: number, first: number, rows: StreamRows): number[] {\n  let unplaced = 0;\n  for (let i = 0; i < table.length; i++) {\n    if (!Number.isFinite(positions[i])) unplaced++;\n  }\n  let excess = Math.max(0, unplaced - 2 * keep);\n  const removed: number[] = [];\n  for (let i = 0; i < table.length; i++) {\n    const position = positions[i]!;\n    if (Number.isFinite(position) ? position >= first : excess-- <= 0) continue;\n    const row = table.rowIndex(i);\n    rows.forget(row);\n    removed.push(row);\n  }\n  return removed;\n}\n\nclass UnalignedStore<F extends PointFrame | DonutFrame> {\n  private rows: StreamRows;\n  private readonly revisions: RowRevisions;\n  private encoding: ResolvedOptions;\n  private current: F;\n  private latest: readonly DiagnosticInput[];\n  private storage: Storage<F> | null;\n\n  constructor(\n    private readonly type: 'scatter' | 'donut',\n    private readonly build: Build<F>,\n    private readonly open: Open<F>,\n    options: ResolvedOptions,\n    private readonly environment: DataEnvironment,\n    version: FrameVersion,\n    private readonly sink: DiagnosticSink,\n  ) {\n    this.rows = new StreamRows(options.table);\n    this.revisions = new RowRevisions(this.rows);\n    this.encoding = withoutTable(options);\n    const diagnostics = new DiagnosticCollector();\n    const table = this.rows.table();\n    const result = build({ ...options, table }, environment, diagnostics, version);\n    const { frame, positions } = result;\n    this.rows.resetPositions(table, positions);\n    this.latest = diagnostics.inputs();\n    this.storage = this.latest.length ? null : this.open(result);\n    const source = new FrameSource(this.rows.next, this.rows);\n    this.current = { ...(this.storage?.frame(frame) ?? frame), source };\n    this.revisions.current.publish(frame.revision, source, this.rows);\n    for (const diagnostic of this.latest) sink.add(diagnostic);\n  }\n\n  get frame(): F { return this.current; }\n  get diagnostics(): readonly DiagnosticInput[] { return this.latest; }\n  get retainedRowCount(): number { return this.revisions.size; }\n\n  /** Releases source rows through this revision. Held frame views keep their normalized values. */\n  retire(revision: number): void { this.revisions.retire(revision); }\n\n  /** Validates encoding against the retained rows and returns options for re-encoding this store. */\n  resolveEncoding(input: unknown, sink: DiagnosticSink): ResolvedOptions {\n    return withoutTable(resolveOptions(this.type, input, sink, this.rows.table()));\n  }\n\n  append(rows: readonly unknown[], options: StoreAppendOptions = {}, sink = this.sink): F {\n    const prepared = this.prepareAppend(rows, options);\n    for (const diagnostic of prepared.callDiagnostics) sink.add(diagnostic);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareAppend(rows: readonly unknown[], options: StoreAppendOptions = {}): PreparedFrame<F> {\n    const base = this.current;\n    const version = { epoch: base.epoch, revision: base.revision + 1 };\n    const keep = retention(options);\n    const fast = this.extendAppend(base, rows, version, keep);\n    if (fast) return fast;\n    const retained = this.rows.fork();\n    retained.append(rows);\n    let table = retained.table();\n    const call = new DiagnosticCollector();\n    const resolved = retargetOptions(this.encoding, table, call);\n    let result = this.build(resolved, this.environment, call, version);\n    const ordering = new DiagnosticCollector();\n    if (this.type === 'scatter') {\n      const reports = new Reports(this.encoding.x.field, ordering);\n      let highest = -Infinity;\n      for (let i = 0; i < result.positions.length; i++) {\n        const position = result.positions[i]!;\n        if (!Number.isFinite(position)) continue;\n        const row = table.rowIndex(i);\n        if (row >= this.rows.next && position < highest) reports.add('AX151', 'none', row);\n        highest = Math.max(highest, position);\n      }\n      reports.flush(ordering);\n    }\n    let current = call;\n    const evicted: number[] = [];\n    if (keep !== undefined) {\n      // Removing rows can change the inferred kind and make formerly unplaceable x values usable.\n      while (true) {\n        const removed = removeRows(table, result.positions, keep, firstPosition(result, keep), retained);\n        if (removed.length === 0) break;\n        for (const row of removed) evicted.push(row);\n        current = new DiagnosticCollector();\n        table = retained.table();\n        const encoded = retargetOptions(this.encoding, table, current);\n        result = this.build(encoded, this.environment, current, version);\n      }\n    }\n    const ordered = ordering.inputs();\n    const diagnostics = [...current.inputs(), ...ordered];\n    retained.resetPositions(table, result.positions);\n    return this.prepare(base, result.frame, retained, diagnostics.length ? null : this.open(result),\n      diagnostics, [...call.inputs(), ...ordered], evicted);\n  }\n\n  private extendAppend(base: F, rows: readonly unknown[], version: FrameVersion, keep: number | undefined): PreparedFrame<F> | null {\n    // Implicit string parsing and diagnostics can change when old rows leave. Reuse old values only when\n    // both partitions have unambiguous clean values and the same x interpretation.\n    if (!this.storage || this.encoding.values[0]?.parse || this.encoding.series !== null) return null;\n    const table = { ...rowsTable(rows), rowIndex: (row: number) => this.rows.next + row };\n    const diagnostics = new DiagnosticCollector();\n    const resolved = retargetOptions(this.encoding, table, diagnostics);\n    if (!resolved.valid) return null;\n    const result = this.build(resolved, this.environment, diagnostics, version);\n    if (diagnostics.inputs().length) return null;\n    const retained = this.rows.fork();\n    const evicted: number[] = [];\n    retained.onForget = row => evicted.push(row);\n    retained.append(rows);\n    const extension = this.storage.extend(result, retained, this.rows.next, keep);\n    retained.onForget = undefined;\n    if (!extension) return null;\n    return this.prepare(base, result.frame, retained, extension, [], [], evicted);\n  }\n\n  reencode(options: ResolvedOptions, version: FrameVersion): F {\n    const prepared = this.prepareReencode(options, version);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareReencode(options: ResolvedOptions, version: FrameVersion): PreparedFrame<F> {\n    return this.prepareEncoding(this.rows.fork(), options, version, new DiagnosticCollector());\n  }\n\n  replace(data: unknown, options: ResolvedOptions, version: FrameVersion): F {\n    const prepared = this.prepareReplace(data, options, version);\n    prepared.commit();\n    return prepared.frame;\n  }\n\n  prepareReplace(data: unknown, options: ResolvedOptions, version: FrameVersion): PreparedFrame<F> {\n    const call = new DiagnosticCollector();\n    const replacement = resolveTable(data, call);\n    return this.prepareEncoding(new StreamRows(replacement.table), options, version, call, replacement);\n  }\n\n  private prepareEncoding(\n    rows: StreamRows, options: ResolvedOptions, version: FrameVersion, call: DiagnosticCollector,\n    replacement?: { table: Table; valid: boolean },\n  ): PreparedFrame<F> {\n    const base = this.current;\n    if (version.revision <= base.revision || version.epoch <= base.epoch) {\n      throw new Error('Encoding updates and replacements require a newer epoch and revision.');\n    }\n    const table = rows.table();\n    const resolved = retargetOptions(options, replacement?.table ?? table, call, replacement?.valid);\n    const result = this.build({ ...resolved, table }, this.environment, call, version);\n    rows.resetPositions(table, result.positions);\n    const diagnostics = call.inputs();\n    return this.prepare(base, result.frame, rows, diagnostics.length ? null : this.open(result), diagnostics, diagnostics, [], options, replacement !== undefined);\n  }\n\n  private prepare(\n    base: F, frame: F, rows: StreamRows, storage: Storage<F> | null,\n    diagnostics: readonly DiagnosticInput[], callDiagnostics: readonly DiagnosticInput[],\n    evicted: readonly number[], options = this.encoding, replacement = false,\n  ): PreparedFrame<F> {\n    const source = new FrameSource(rows.next, rows, () => this.current === base);\n    const candidate = { ...(storage?.frame(frame) ?? frame), source };\n    const commit = once(() => this.current, () => {\n      if (replacement) this.revisions.replace(rows);\n      for (const row of evicted) this.revisions.current.archive(row);\n      rows.commit();\n      storage?.commit();\n      this.rows = rows;\n      this.current = candidate;\n      this.latest = diagnostics;\n      this.storage = storage;\n      if (options !== this.encoding) this.encoding = withoutTable(options);\n      this.revisions.current.publish(candidate.revision, source, rows);\n    }, base);\n    return { frame: candidate, diagnostics, callDiagnostics, commit };\n  }\n}\n\nexport class PointStore extends UnalignedStore<PointFrame> {\n  constructor(options: ResolvedOptions, environment: DataEnvironment, version: FrameVersion, sink: DiagnosticSink = quiet) {\n    super('scatter', buildPoints, Points.open, options, environment, version, sink);\n  }\n}\n\nexport class DonutStore extends UnalignedStore<DonutFrame> {\n  constructor(options: ResolvedOptions, environment: DataEnvironment, version: FrameVersion, sink: DiagnosticSink = quiet) {\n    super('donut', buildDonut, Slices.open, options, environment, version, sink);\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '32,45p;91,110p;133,176p' docs/02-product-spec.md && sed -n '72,104p;126,146p;280,294p;306,320p;367,379p' docs/03-plan-typescript-release.md && sed -n '65,152p' packages/axylo/src/core/contracts.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '32,45p;91,110p;133,176p' docs/02-product-spec.md && sed -n '72,104p;126,146p;280,294p;306,320p;367,379p' docs/03-plan-typescript-release.md && sed -n '65,152p' packages/axylo/src/core/contracts.ts\"","aggregated_output":"\nNot the audience for 1.0: analysts exploring data in notebooks, designers building bespoke graphics, and teams that need maps, financial charts or network diagrams.\n\n### 1.3 Principles\n\n| Principle | In practice |\n|---|---|\n| Correct before configurable | A default that can mislead (truncated bars, interpolated gaps, a silently dropped label) is a bug, even if an option fixes it. |\n| Say it, do not guess | Anything Axylo cannot draw faithfully becomes a diagnostic with a code, a location and a fix. If values were left out, the reader is told too. |\n| The data is the authority | Exact values, the table, keyboard navigation and descriptions come from the normalized data. The drawing is derived from it and may be simplified; nothing else may be. |\n| Everything a reader needs is on; nothing else is | Title, units, legend, tooltip, keyboard, description and table are on. Entry animation, a marker on every point of a dense line, and decorative toolbars are not. |\n| One way to do each thing | One logical data model, one method per kind of change, one place for colors (CSS). |\n| The page is the theme | Font, text color and color scheme come from the page. |\n\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| F1 | Bar and area value axes always include zero. An author `domain` that excludes zero is widened and raises AX110. | Property test on domains, including all-negative and mixed-sign data; `bars` fixture (values 82–97) starts at 0 | R1 |\n| F2 | Missing values are never drawn as zero and never bridged unless the author asks. An explicit `null` is a gap, silently. An isolated value between two gaps is a visible point. A missing bar shows a \"no data\" mark at the baseline, distinct from a zero bar. On a time or date axis with a regular step, an absent step is a gap and raises AX105; `missing: 'zero'` on the field turns absent and null values into zeros for counts. Tooltip, table and announcements say \"No data\". | `trend` with nulls and `trend` with the same 7 rows deleted render the same gap; `dirty` fixtures; property test that no segment connects across a missing index | R5 |\n| F3 | Input that cannot be plotted as given is reported, never guessed. The diagnostic registry (section 3.5) fixes each case's level, what is drawn and what the reader sees. | One test per code; the combined `dirty` fixture and the four one-bad-value fixtures yield exactly the codes listed in section 3.5 | R5, D5 |\n| F4 | Three temporal types, never mixed silently. **Calendar dates** (`2026-02-24`, `2026-02`, `2026`) read the same in every viewer time zone. **Instants** (epoch milliseconds declared `type: 'time'`, `Date` objects, ISO strings with an offset) are shown in `timeZone` (default: the viewer's), with the zone named in the tooltip heading and the description. **Wall-clock times** (date-time strings without an offset) are shown as written, with hint AX112. Instants that all fall on the same time of day, whole days apart, raise hint AX111 (\"these look like calendar dates\"). A bare number is never assumed to be an instant. | Four fixture variants in UTC, America/Los_Angeles and Asia/Kolkata: (a) date strings: identical text in all three; (b) ISO strings with `Z`, (c) epoch ms with `type: 'time'`, (d) `Date` objects: each zone's correct local text, zone visible, AX111 raised; with `timeZone: 'UTC'` or `type: 'date'`: identical. Plus: both DST transitions, a leap day, an unparseable date | R3 |\n| F5 | No smoothing. When a line is denser than the screen, the drawing is simplified with this guarantee: for every device-pixel column, and every contiguous run of valid samples inside it, the drawn stroke covers exactly that run's minimum and maximum. A break between two runs is always kept, even when both fall in one pixel column; a slot a series merely has no row for (weekly data beside daily) does not break its line. Stacked areas are simplified on their cumulative sums. Exact values always come from the data, not the drawing. | Assertions on which source samples the drawing kept, for: one outlier in 1,000,000; two peaks and a gap in one column; alternating valid and missing samples; tied extremes; device pixel ratio 1 and 2; several zoom levels. A sample that the drawing dropped is still reachable by keyboard and in the table | D8, D9 |\n| F6 | Numbers and dates are formatted for the page locale. Ticks and readouts are formatted separately: ticks may be compact (`50K`); tooltip, table and announcements show the full integer part, and the fraction with up to six significant digits not counting the fraction's leading zeros (`123,456.75`; `0.000123456`; `0.1 + 0.2` reads `0.3`), with the unit. A custom formatter that throws falls back to the default and raises a diagnostic. | Expected strings for chosen values (large integers, small decimals, percentages, zoned times) in `en-US`, `de-DE` and `en-IN` | R4 |\n| F7 | Domains follow one order of precedence: the zoomed view is inside the author's `domain` if given, otherwise inside the automatic domain. The automatic domain contains all data, reference lines and stack totals, and ends at the first tick at or beyond each extreme. A field declared `scale: 'percent'` (0–100) or `'ratio'` (0–1) ends at full scale only when its maximum is at least half of full scale and not above it. Nothing is inferred from a label. | Property tests; `bars` ends at 100 when declared `percent`; a 4% maximum ends at the first tick at or above 4% | R1 |\n| F8 | Donut: slices keep the given order, start at 12 o'clock and run clockwise. The legend shows every slice's value and percentage as text, in slice order. A zero slice is listed without an arc; a `null` slice is listed as \"No data\". A negative value is AX120 and the chart shows its error state. With more than eight slices, the seven largest are drawn and the rest are grouped as \"Other (n)\", with AX121; the table lists every category. An all-zero donut shows the empty state. | `parts` fixture; one test per case | R7, landscape scoreboard 3.1 |\n| F9 | Up to eight series, no two share a color. Beyond eight, each series still has a unique combination of color and dash or marker, and AX130 is raised. | Tests with 6, 8 and 12 series | R7 |\n| F10 | Stacks place positive and negative values on their own sides of zero, and the axis covers both totals. A missing component is drawn with zero height and the stack is marked \"incomplete\" in tooltip, table and announcements. | Property test on stacked geometry; mixed-sign and incomplete fixtures | R5 |\n| F11 | Line, area and scatter are drawn in x order whatever the input order. On line, area and bar, two rows with the same x in one series are AX108 and that series is not drawn. On scatter, points sharing an x (or both coordinates) are ordinary data. | Shuffled `trend` renders identically; duplicate fixture | R5 |\n| F12 | When a warning means values were left out or changed, the chart says so to the reader: a short note (\"Values not shown: 2. See table.\", worded so it reads correctly for any count) inside the figure and in the accessibility tree, in every build. | Production build given `dirty` shows the note | R5, R6 |\n\n### 3.2 Legibility\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\nTarget: every WCAG 2.2 level AA success criterion that applies to what Axylo renders, as component-level evidence. Conformance of a page is a property of the page and remains the author's.\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| A1 | Every chart has an accessible name: its `title`, or the heading named by `labelledBy`, or else a generated name (\"Line chart of Sessions by Day\") with AX140 raised in every build. The title's heading level is the author's (`level`), and it can be hidden visually. Every chart has a generated summary: type, series, x range with time zone, y range, each series' minimum, maximum and last value, and any omissions. `description` adds to the summary and never removes the zone or omission statements. Element ids are unique per chart. | Accessibility-tree snapshot for every fixture; a 24-chart page has no duplicate ids; axe `heading-order` | R11, R13 |\n| A2 | Keyboard: at most two tab stops while the table is closed, the plot and one toolbar with roving focus that holds legend toggles, zoom, pause and the table control. Every point is reachable in order; the series can be switched; the ends can be reached directly; focus can leave the chart. The focus indicator is at least 2 px and 3:1 and is not hidden by the tooltip. The exact keys and roles are fixed after the pattern spike in M1 (section 8). | Forward and reverse traversal in collapsed, zoomed, streaming and table-open states; focus after hiding the focused series; indicator contrast | R12 |\n| A3 | Moving focus to a point conveys its text (series, x, value with unit, position) through the focused element's accessible name or a polite live region. On touch screen readers, every point is reachable by swiping, or the table is reachable within two gestures. | Accessibility-tree snapshot after each key; a recorded rehearsal on NVDA with Chrome, NVDA with Firefox, VoiceOver with Safari on macOS, VoiceOver on iOS, and TalkBack with Chrome | R12, R13 |\n| A4 | \"View as table\" shows the data as an HTML table built from the normalized data when opened: the title as caption, field labels with units as column headers, x values as row headers, values formatted as in F6. It covers the current x range, 100 rows per page, with every row reachable by paging or by jumping to an x value. It sits in a focusable scroll region no taller than the plot, and opening it does not move other charts. | Table content compared with fixture data, including a value near row 900,000 of 1,000,000; a 24-chart page layout test | R13 |\n| A5 | Series are never distinguished by color alone, in any mode. Each line and area carries a shape marker at its last point and at sparse intervals, repeated in the legend and tooltip; under `prefers-contrast: more` or forced colors, lines also differ by dash. Adjacent filled marks (slices, stacked segments) are separated by at least 1 px of background. The default palette has eight colors, each at least 3:1 on the default light and dark backgrounds, with a minimum pairwise OKLab difference of 0.10 (provisional) under normal vision and simulated protanopia, deuteranopia and tritanopia. On any other background, Axylo measures the palette against the resolved background and raises AX141 below 3:1. | Palette script scoring the rendered marks of an eight-series chart in both schemes, repeats included; rendered-pixel checks of separators; a grayscale screenshot in which three crossing lines can be told apart by marker | R7, WCAG 1.4.1, 1.4.11 |\n| A6 | Content reflows at 320 CSS px and 400% zoom without two-dimensional scrolling. User text-spacing overrides do not clip text. | Viewport and style-override tests in three engines | WCAG 1.4.10, 1.4.12 |\n| A7 | Data arriving does not speak. Announcements happen only for the reader's own navigation, and for a change of state (L7). While data streams, keyboard focus stays on the same datum until it leaves the window. | Stream test counting live-region changes with and without focus; 24 concurrent streams | R12 |\n| A8 | axe-core reports no violations on any fixture in any state, including `heading-order` and `scrollable-region-focusable`. | CI | R11 |\n| A9 | A conformance table lists every applicable WCAG 2.2 AA success criterion, the test that covers it, and what the author must supply (a meaningful title or `labelledBy`, series names, units, the page's own structure). It also states the limits in section 3.8. | Published with each release; a CI check that every listed test exists | R11 |\n| A10 | Every built-in string can be replaced through `messages`. Built-in English text is marked `lang=\"en\"` when the document language is not English. | Test on a `lang=\"de\"` page | WCAG 3.1.2 |\n\n### 3.5 Diagnostic registry\n\nLevel decides delivery. **Error**: the chart or a series cannot be drawn; the chart shows its error state. **Warning**: something is not drawn as given; the reader sees the note in F12. **Hint**: advice for the author. Errors and warnings print once per code per page in every build; hints print in development builds only. `strict: true` throws on errors and warnings found while validating a create, `update` or `append` call, synchronously from that call. A diagnostic that can only arise later (a contrast check after the page's CSS changes, a custom formatter that throws when a table page is built, a label that stops fitting after a resize) is reported when it is found and is never thrown. Every diagnostic names the chart; those about data name the field and the first row indexes in the caller's own data.\n\n| Code | Level | Condition | What is drawn |\n|---|---|---|---|\n| AX100 | Error | Typed columns have different lengths | Error state; the message names the columns and their lengths |\n| AX101 | Error | A named field is not a key of any row | Error state; the message lists the keys that exist and the closest match |\n| AX102 | Warning | A field is absent (`undefined`) in some rows | Gaps |\n| AX103 | Warning | A value is `NaN` or infinite | Gap |\n| AX104 | Hint | Every non-missing value of a value field is a plain decimal string (`'40'`, `'-1.5'`) | Parsed and drawn; the message suggests `parse: 'number'`. An empty string counts as missing |\n| AX105 | Hint | Steps are absent on a regular time, date, wall-clock or number axis | Gaps. When a series would need more absent steps than twice its observations (and more than 1,000), it is treated as irregular instead: no gaps are created and the hint says so |\n| AX106 | Warning | A value field mixes numbers with strings, or holds strings that are not plain decimals (`'1,234'`, `'n/a'`) | The strings are not drawn |\n| AX107 | Warning | A date or time cannot be parsed | That row is not drawn |\n| AX108 | Error | Duplicate x within a series, or duplicate donut labels | That series, or the donut, is not drawn |\n| AX109 | Hint | Numbers on an axis declared `time` look like seconds, or a numeric x looks like epoch milliseconds without `type: 'time'` | As declared |\n| AX110 | Warning | An author domain on bar or area excluded zero | Domain widened to zero |\n| AX111 | Hint | Instants look like calendar dates | As instants, zone shown |\n| AX112 | Hint | Date-time strings have no offset | As written |\n| AX120 | Error | Negative donut value | Error state |\n| AX121 | Warning | More than eight donut slices | Seven largest plus \"Other (n)\" |\n| AX130 | Warning | More than eight series | All series, with dash or marker differences |\n| AX140 | Warning | No `title` and no `labelledBy` | Generated name |\n| AX141 | Warning | Palette below 3:1 on the resolved background | As themed |\n| AX142 | Hint | Plot too small to draw | Summary and table control |\n| AX143 | Hint | Labels hidden after every remedy | Note shown to the reader |\n| AX150 | Warning | Unknown option key | Ignored; the message suggests the closest known key |\n| AX151 | Warning | `append` rows out of order | Accepted through the slower full update |\n| AX131 | Hint | A compact chart has more than one series | Drawn, with dash differences |\n});\n\n// counts that a database driver returns as strings\nbar(el, { data: pgRows, x: 'day', y: { field: 'count', parse: 'number', missing: 'zero' } });\n```\n\n| Option | Meaning |\n|---|---|\n| `field` | Key of the row. |\n| `label`, `unit` | Axis title; name and unit in tooltip, table and announcements. |\n| `type` (x) | `'date'`, `'time'`, `'number'`, `'category'`. Inferred when omitted, except that a number is never inferred to be an instant (F4). |\n| `timeZone` (x) | For instants: `'local'` (default), `'UTC'`, or an IANA zone. |\n| `format`, `tickFormat` | Readouts and ticks are formatted separately (F6). |\n| `scale` (value) | `'percent'` (0–100) or `'ratio'` (0–1). Declared, never inferred (F7). |\n| `missing` (value) | `'gap'` (default) or `'zero'` (F2). |\n| `parse` (value) | `'number'`, for a text field holding numbers (AX104, AX106). |\n| `domain` | Author bounds. Widened to zero on bar and area (F1). |\n\n### 1.4 Common options\n\nSummarized; the declarations are the reference.\n\n| Option | Purpose |\n|---|---|\n| `title`, `labelledBy`, `subtitle`, `description` | The chart's visible heading and accessible name (A1). `title` may carry a heading `level` and `visible: false`; `labelledBy` points at a heading the page already has. |\n| `state` | `'ready'`, `'loading'`, `{ error }`, `{ empty }` (L7). |\n| `legend`, `tooltip`, `table` | On by default; each can be turned off. |\n| `zoom`, `reference` | Cartesian charts only. |\n| `compact` | Line, area and bar: marks only, as a static image with a text alternative (spec 3.7). |\n| `colors` | A fixed color per series name (DX6). |\n| `messages`, `locale` | Built-in text and formatting locale (A10, F6). |\n| `strict`, `onDiagnostic` | Diagnostics delivery (section 3.5 of the spec). |\n\n| Rejected changes | A call that throws under `strict` leaves the chart on its last valid state. |\n| Streaming | `keep` is the number of distinct x values retained. Rows before the last x are accepted through the slower full update and raise AX151. While zoomed to the latest edge the view follows new data; zoomed elsewhere, it stays put. Paused charts buffer (I6). Keyboard focus stays on its datum until that datum leaves the window (A7). |\n| Teardown | `destroy()` cancels the pending frame, disconnects observers and listeners, and makes later calls no-ops. |\n\n### 1.6 Diagnostics\n\nThe registry, with each code's level and outcome, is in the spec (section 3.5). Example for the Phase 1 combined dirty fixture (`[10, 20, null, NaN, '40', undefined, 70]`):\n\n```\n[axylo AX103] \"Dirty input\": y field \"value\" has 1 value that is not a finite number (NaN at row 3). Shown as a gap.\n  Check the calculation that produced it, or send null for \"no data\".\n[axylo AX106] \"Dirty input\": y field \"value\" mixes numbers with 1 string (\"40\" at row 4). The string is not plotted.\n  Convert it to a number where the data is produced.\n[axylo AX102] \"Dirty input\": y field \"value\" is absent in 1 row (row 5). Shown as a gap.\n  Send null if the value is known to be missing.\n```\n\nThe reader of that chart sees \"Values not shown: 3. See table.\" (F12).\n\n`validate(type, options)` runs the same normalization without a DOM and returns the diagnostics, so a server, a test or a coding agent can check a chart before rendering it.\n\n- Provisional budgets P1, P2, P5 and the size targets are recalibrated from the slice and recorded.\n\nExample: \"Line chart from an API response\". Docs: Getting started, Data and fields.\n\n### M2. Faithful data, on the line chart (ceiling: 8 days)\n\n- The diagnostic registry (F3, F12); missing values and absent steps (F2); the three temporal types (F4); formatting (F6); domains (F7); sorting and duplicates (F11); `validate()`.\n\nOutcomes:\n- One test per diagnostic code; the combined and one-bad-value dirty fixtures yield exactly the codes in the spec.\n- F4's four fixture variants in three zones, plus DST and leap-day cases.\n- Property tests: no scene path contains a non-finite coordinate; no segment crosses a missing index; domains obey F7.\n- A production build given `dirty` shows the reader's note.\n\nExample: \"What Axylo tells you about your data\". Docs: Diagnostics reference, one page per code; Dates and time zones.\n\nExample: \"A dashboard tile with a target line and an empty state\". Docs: Titles and labels, Tooltip, Legend, States.\n\n### M4. Accessibility, complete on the line chart (ceiling: 10 days)\n\n- The pattern chosen in M1, built fully: names and summary (A1), keyboard (A2), point text (A3), table with paging (A4), non-color cues (A5), reflow (A6), streaming behavior (A7), messages and language (A10); single-pointer zoom controls (I3, I4); reduced motion on update (I5).\n\nOutcomes:\n- Tab-order tests in collapsed, zoomed and table-open states; accessibility-tree snapshot after each key.\n- axe-core clean on every fixture and state (A8).\n- A 24-chart page: unique ids, no layout shift when one table opens, total tab stops recorded.\n- The rehearsal script run and recorded on the five pairs, separating what was heard from what was inferred.\n- The first conformance table (A9), with every listed test existing.\n\nExample: \"Exploring a chart with the keyboard\". Docs: Accessibility: what is automatic, what the author supplies, the rehearsal record and its limits.\n\nPublishing to npm, tagging and pushing are separate, explicit decisions by the owner at this point; the plan does not assume them.\n\n## 4. Test strategy\n\n| Layer | Tool | What it proves |\n|---|---|---|\n| Unit | Vitest | Scales, ticks, formatting, parsing, simplification. |\n| Property | fast-check | Invariants that must hold for any data: F1, F2, F5, F7, F11, L1. |\n| Scene snapshot | Vitest, injected text metrics | Geometry and text for each fixture and width, without a browser. |\n| Browser | Playwright on three engines | Real text boxes, resize, pointer, touch, keyboard, time zones, color schemes, reduced motion, fonts loading late. |\n| Accessibility | axe-core, accessibility-tree snapshots, keyboard scripts, recorded rehearsal | A1–A10. |\n| Visual | Screenshots per operating system | What the scene cannot see: antialiasing, state leaks. |\n * `missing: 'zero'` on a value field is applied by normalization: slots that would be SLOT_NULL, SLOT_NO_ROW,\n * SLOT_GAP or SLOT_ABSENT_FIELD become SLOT_VALUE with y = 0 and row = -1. SLOT_INVALID is never turned into zero.\n */\n\n/** Half-open range of indexes. */\nexport interface IndexRange { readonly start: number; readonly end: number }\n\nexport interface XColumn {\n  readonly kind: XKind;\n  /** Strictly ascending positions, one per slot. For 'category': 0, 1, 2, … */\n  readonly values: Float64Array;\n  /** For 'category': the name of each position. Otherwise null. */\n  readonly categories: readonly string[] | null;\n  /** For 'time': the resolved IANA zone ('UTC', 'America/Los_Angeles', …; 'local' is resolved before it gets here). Otherwise null. */\n  readonly timeZone: string | null;\n  /** For 'date': the precision the values were written in ('2026-02' is a month); the finest one if they are mixed. Otherwise null. */\n  readonly dateUnit: 'day' | 'month' | 'year' | null;\n  /** For 'category': true when the author declared the categories ordered, so the axis may be thinned (spec L1). */\n  readonly ordered: boolean;\n}\n\n/** The caller's data behind a frame, for events and for the table's provenance. */\nexport interface RowSource {\n  /** The caller's row at a source index (materialized on demand for typed columns), or null if it is no longer retained. */\n  rowAt(sourceIndex: number): unknown;\n}\n\n/** One series of an aligned frame: a y value and a state for every x slot. */\nexport interface Series {\n  /** Stable identity: the series value (long form) or the field name (wide form). Used for colors and toggling. */\n  readonly key: string;\n  /** Name shown to the reader. */\n  readonly label: string;\n  /** The value field this series was read from, for diagnostics. */\n  readonly field: string;\n  readonly unit: string | null;\n  readonly valueScale: 'percent' | 'ratio' | null;\n  /** False when the series cannot be drawn (duplicate x, AX108). It stays in the frame so the table and summary can say so. */\n  readonly drawable: boolean;\n  /** y per slot. NaN wherever `slot` is not SLOT_VALUE. May be a view on the caller's typed column. */\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n  /** Index of the caller's row each slot came from, -1 where there is none. null means \"slot i came from row i\" (typed columns). */\n  readonly row: Int32Array | null;\n}\n\n/** One series of a point frame (scatter): its own x and y, sorted by x then y. */\nexport interface PointSeries {\n  readonly key: string;\n  readonly label: string;\n  readonly drawable: boolean;\n  readonly x: Float64Array;\n  readonly y: Float64Array;\n  readonly row: Int32Array | null;\n  /**\n   * Observations that have a valid x and no y (null or an absent field), sorted by x, duplicates kept. They are\n   * not points: nothing is drawn or picked for them. They exist so the table can list them as \"No data\" (spec F2:\n   * the note sends the reader to the table, so the table must show what was left out). Absent or empty when there\n   * are none. With `missing: 'zero'` on the y field such observations are points with y = 0 instead, and do not\n   * appear here.\n   */\n  readonly missingX?: Float64Array;\n}\n\n/**\n * The normalized, lossless data. Immutable: an update or append produces a new frame with a higher revision.\n * Buffers may be shared between revisions; a streaming store appends into spare capacity and hands out\n * subarray views, so an append does not copy what is already there.\n */\ninterface FrameBase {\n  readonly revision: number;\n  /** Changes when the data is replaced or the encoding changes; survives append and eviction. A DatumRef is only meaningful within one epoch. */\n  readonly epoch: number;\n  readonly source: RowSource;\n}\n\nexport interface AlignedFrame extends FrameBase {\n  readonly shape: 'aligned';\n  readonly x: XColumn;\n  readonly series: readonly Series[];\n  /** Number of x slots. */\n  readonly length: number;\n  readonly xLabel: string;\n  readonly yLabel: string | null;\n}\n\nexport interface PointFrame extends FrameBase {\n  readonly shape: 'points';\n","exit_code":0,"status":"completed"}}
