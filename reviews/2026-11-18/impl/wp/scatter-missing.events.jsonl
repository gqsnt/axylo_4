{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,26p;225,272p' packages/axylo/test/data/normalize.test.ts && sed -n '1,100p' packages/axylo/src/data/reports.ts && sed -n '39,63p;159,181p' packages/axylo/src/diagnostics/registry.ts && rg -n 'function retargetOptions|validateFields|AX101' packages/axylo/src/data/options.ts\"","aggregated_output":"import { describe, expect, it } from 'vitest';\nimport fc from 'fast-check';\nimport {\n  SLOT_ABSENT_FIELD, SLOT_GAP, SLOT_INVALID, SLOT_NO_ROW, SLOT_NULL, SLOT_VALUE, type Series,\n} from '../../src/core/contracts';\nimport { readerDisclosure } from '../../src/diagnostics';\nimport { aligned, check, contents } from './helpers';\n\nconst weekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];\nconst dirty = [10, 20, null, NaN, '40', undefined, 70];\nconst input = (values: readonly unknown[]) => ({\n  data: values.map((value, row) => ({ day: weekdays[row], value })), x: 'day', y: 'value',\n});\nconst day = 86_400_000;\n\nfunction runs(series: Series): number[][] {\n  const result: number[][] = [];\n  let previous = -1;\n  for (let index = 0; index < series.slot.length; index++) {\n    if (series.slot[index] === SLOT_VALUE) {\n      if (previous < 0) result.push([]);\n      result.at(-1)!.push(index);\n      previous = index;\n    } else if (series.slot[index] !== SLOT_NO_ROW) {\n      previous = -1;\n    }\n    const testTyped = aligned({ data: { columns: { x: [0, 1], a: Float32Array.of(1, Infinity), b: [2, 4] } }, x: 'x', y: ['a', 'b'] });\n    expect(testWide.diagnostics.inputs()).toMatchObject([{ code: 'AX103', field: 'a', rows: [1] }]);\n    expect(testLong.diagnostics.inputs()).toMatchObject([{ code: 'AX103', field: 'y', rows: [2] }]);\n    expect(testTyped.diagnostics.inputs()).toMatchObject([{ code: 'AX103', field: 'a', rows: [1] }]);\n    expect(testTyped.frame.source.rowAt(1)).toEqual({ x: 1, a: Infinity, b: 4 });\n    expect(testTyped.frame.series[0]!.y[1]).toBeNaN();\n  });\n\n  it('sorts scatter points by x then y and retains provenance while omitting invalid points', () => {\n    const data = [\n      { x: 2, y: 8, group: 'A' }, { x: 1, y: 5, group: 'A' }, { x: 1, y: 3, group: 'A' },\n      { x: 0, y: 7, group: 'B' }, { x: undefined, y: 3, group: 'B' }, { x: 4, y: null, group: 'B' },\n      { x: 5, y: NaN, group: 'B' },\n    ];\n    const { frame, diagnostics } = check('scatter', { data, x: { field: 'x', label: 'Hours', unit: 'h' }, y: { field: 'y', unit: 'kg' }, series: 'group' });\n    if (frame.shape !== 'points') throw new Error('Expected a point frame');\n    expect(frame).toMatchObject({ xLabel: 'Hours', xUnit: 'h', yUnit: 'kg', xKind: 'number' });\n    expect(frame.series.map(s => [[...s.x], [...s.y], [...s.row!], s.drawable])).toEqual([\n      [[1, 1, 2], [3, 5, 8], [2, 1, 0], true], [[0], [7], [3], true],\n    ]);\n    expect(frame.source.rowAt(2)).toBe(data[2]);\n    expect(diagnostics.inputs()).toMatchObject([\n      { code: 'AX102', field: 'x', rows: [4] }, { code: 'AX103', field: 'y', rows: [6] },\n    ]);\n  });\n\n  it('keeps donut labels, values, zeros and nulls in caller order', () => {\n    const data = [{ label: 'East', count: 0 }, { label: 'West', count: null }, { label: 'North', count: 15 }];\n    const { frame, diagnostics } = check('donut', { data, label: 'label', value: { field: 'count', label: 'Count', unit: 'people' } });\n    if (frame.shape !== 'donut') throw new Error('Expected a donut frame');\n    expect(frame.labels).toEqual(['East', 'West', 'North']);\n    expect([...frame.values]).toEqual([0, NaN, 15]);\n    expect([...frame.slot]).toEqual([SLOT_VALUE, SLOT_NULL, SLOT_VALUE]);\n    expect([...frame.row!]).toEqual([0, 1, 2]);\n    expect(frame.source.rowAt(1)).toBe(data[1]);\n    expect(frame).toMatchObject({ valueLabel: 'Count', unit: 'people', valueScale: null });\n    expect(diagnostics.inputs()).toEqual([]);\n  });\n\n  it('borrows one million ascending typed values with a warmed median under 100 ms', () => {\n    const length = 1_000_000;\n    const x = new Float64Array(length);\n    const y = new Float32Array(length);\n    for (let i = 0; i < length; i++) x[i] = i;\n    y[4] = NaN;\n    y[length - 1] = 123;\n    const options = { data: { columns: { x, y } }, x: 'x', y: 'y' };\n    for (let i = 0; i < 3; i++) aligned(options);\nimport type { DiagnosticEffect, DiagnosticSink } from '../core/contracts';\nimport { report, type DiagnosticCode } from '../diagnostics';\nimport type { DiagnosticTrace } from './store-diagnostics';\n\nexport class Reports {\n  private readonly entries = new Map<DiagnosticCode, {\n    effect: DiagnosticEffect;\n    count: number;\n    rows: number[];\n    examples: string[];\n    detail?: string;\n    outcome?: string;\n    series: Set<string>;\n  }>();\n\n  constructor(private readonly field: string, private readonly sink?: DiagnosticTrace) {}\n\n  add(code: DiagnosticCode, effect: DiagnosticEffect, row: number, example?: unknown, detail?: string, options?: {\n    amount?: number; series?: string; position?: string; outcome?: string;\n  }): void {\n    let entry = this.entries.get(code);\n    if (!entry) {\n      entry = { effect, count: 0, rows: [], examples: [], detail, outcome: options?.outcome, series: new Set() };\n      this.entries.set(code, entry);\n    }\n    const amount = options?.amount ?? 1;\n    const text = options?.position ?? (example === undefined ? undefined : typeof example === 'string' ? JSON.stringify(example)\n      : example !== null && typeof example === 'object' ? Object.prototype.toString.call(example) : String(example));\n    this.sink?.traceRow?.(code, this.field, effect, row, amount, text, options?.series);\n    entry.count += amount;\n    if (entry.rows.length < 10 && !entry.rows.includes(row)) entry.rows.push(row);\n    if (text !== undefined && entry.examples.length < 10 && !entry.examples.includes(text)) entry.examples.push(text);\n    if (options?.series !== undefined && entry.series.size < 10) entry.series.add(options.series);\n  }\n\n  flush(sink: DiagnosticSink): void {\n    for (const [code, { effect, count, rows, examples, detail, outcome, series }] of this.entries) {\n      report(sink, code, effect, { field: this.field, count, rows, examples, detail, outcome, series: [...series] });\n    }\n  }\n}\nexport const diagnosticRegistry = {\n  AX100: entry('error', d =>\n    field(d) + ' belongs to columns with different lengths' + samples(d) + '. Supply equally long columns.',\n  'The chart shows its error state.'),\n  AX101: entry('error', d =>\n    field(d) + ' is missing from the data. Available fields: ' +\n    (d.keys?.length ? d.keys.map(quote).join(', ') : '(none)') + '.' + suggestion(d) + ' Use an available field or add the field to the data.',\n  'The chart shows its error state.'),\n  AX102: entry('warning', d =>\n    (d.outcome === 'The affected row is not drawn.'\n      ? field(d) + ' is absent' + rows(d) + ', affecting ' + count(d, 'value')\n      : field(d) + ' is absent in ' + count(d, 'record') + rows(d)) +\n    '. Supply the field and send null if the value is known to be missing.',\n  'Shown as gaps.'),\n  AX103: entry('warning', d =>\n    field(d) + ' has ' + count(d, 'non-finite value') + rows(d) + samples(d) + '. Check the calculation that produced it or send null for no data.',\n  'Shown as gaps.'),\n  AX104: entry('hint', d =>\n    field(d) + ' has ' + count(d, 'decimal string') + rows(d) + '. Set parse: \\'number\\' to make conversion explicit.',\n  'The strings are parsed and drawn as numbers.'),\n  AX105: entry('hint', d =>\n    field(d) + ' is missing ' + count(d, 'expected step') + series(d.series) + samples(d) +\n    '. Supply observations for those positions or explicit nulls to mark gaps.',\n  d => {\n    const outcomes = [];\n\nexport function createDiagnostic(\n  code: DiagnosticCode,\n  effect: DiagnosticEffect,\n  details: DiagnosticDetails = {},\n  origin: DiagnosticInput['origin'] = 'call',\n): DiagnosticInput {\n  const { field, rows, count = rows?.length, ...context } = details;\n  const firstRows = rows === undefined ? undefined : [...new Set(rows)].slice(0, 10);\n  const outcome = context.outcome ?? (\n    code === 'AX102' && effect === 'changed' ? 'Shown as zeros.'\n      : code === 'AX108' && effect === 'chart-error' ? 'The donut is not drawn.'\n      : code === 'AX150' && effect === 'chart-error' ? 'The chart shows its error state.'\n      : undefined\n  );\n  const diagnostic: DiagnosticInput = {\n    code, level: diagnosticRegistry[code].level, effect: code === 'AX105' ? 'none' : effect, origin,\n    message: diagnosticRegistry[code].message({ field, rows: firstRows, count, ...context, outcome }),\n    ...(field === undefined ? {} : { field }),\n    ...(firstRows === undefined ? {} : { rows: firstRows }),\n    ...(count === undefined ? {} : { count }),\n  };\n  contexts.set(diagnostic, context);\n196:export function retargetOptions(options: ResolvedOptions, table: Table, sink: DiagnosticSink, validData = true): ResolvedOptions {\n261:    report(sink, 'AX101', 'chart-error', { field: name, keys, suggestion: field === null ? undefined : closest(name, keys), count: 1 });\n","exit_code":0,"status":"completed"}}
