:229:    if (frame.shape !== 'points') throw new Error('Expected scatter');\n      }\n    }), { numRuns: 1_000 });\n  });\n}\n\nit('F2 line: deleted daily rows and explicit nulls leave the same seven-day break', () => {\n  const data = Array.from({ length: 12 }, (_, i) => ({ x: new Date(date(i)).toISOString().slice(0, 10), y: i >= 2 && i <= 8 ? null : i }));\n  const explicit = chart('line', data);\n  const deleted = chart('line', data.filter(row => row.y !== null));\n  explicit.frames();\n  deleted.frames();\n  expect(codes(explicit)).toEqual([]);\n  expect(codes(deleted)).toContain('AX105');\n  expect(pathRuns(marks(deleted, 'path')[0]!.xy).map(run => run.length)).toEqual([2, 3]);\n  expect(marks(deleted, 'path')[0]?.xy).toEqual(marks(explicit, 'path')[0]?.xy);\n  expect(rows(deleted)).toEqual(rows(explicit));\n  expect(at(deleted, date(5)).rows[0]?.value).toBe('No data');\n});\n\nconst scatter = [{ x: 1, y: 4 }, { x: 2, y: null }, { x: 3 }, { x: 4, y: 0 }];\n\nit('F2 scatter: gaps are unplotted, zero is readable and the table says No data (reading: the table keeps omitted observations)', () => {\n  const r = chart('scatter', scatter);\n  r.frames();\n  expect(marks(r, 'points')[0]?.xy).toHaveLength(4);\n  const refs = walk(r);\n  const { lookup } = committed(r);\n  expect(refs.map(ref => lookup.datum(ref)?.value)).toEqual(['4', '0']);\n  expect(reading(r, refs[1]!)).toContain('0');\n  expect(lastModel(r).summary).toContain('minimum 0, maximum 4, last 0');\n  expect(rows(r).map(row => row[2])).toEqual(['4', 'No data', 'No data', '0']);\n});\n\nit('F2 scatter: missing zero draws two imputed zero points and exposes all four observations', () => {\n  const r = chart('scatter', scatter, { y: { field: 'y', missing: 'zero' } });\n  r.frames();\n  expect(marks(r, 'points')[0]?.xy).toHaveLength(8);\n  const refs = walk(r);\n  const { lookup } = committed(r);\n  expect(refs.map(ref => lookup.datum(ref)?.value)).toEqual(['4', '0', '0', '0']);\n  expect(rows(r).map(row => row[2])).toEqual(['4', '0', '0', '0']);\n  refs.slice(1).forEach(ref => expect(reading(r, ref)).toContain('0'));\n});\n\nit('F2 donut: null and absent slices have no arc and read No data; a real zero reads 0', () => {\n  const r = chart('donut', [{ x: 'A', y: 5 }, { x: 'B', y: null }, { x: 'C' }, { x: 'D', y: 0 }]);\n  r.frames();\n  expect(codes(r)).toEqual(['AX102']);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(2);\n  const refs = walk(r);\n  expect(refs).toHaveLength(4);\n### F2 scatter omissions and zero imputation\n\n> Missing values are never drawn as zero and never bridged unless the author asks. … Tooltip, table and announcements say \"No data\".\n\n> On a time or date axis with a regular step, an absent step is a gap and raises AX105; `missing: 'zero'` on the field turns absent and null values into zeros for counts.\n\n- **F2 scatter: gaps are unplotted, zero is readable and the table says No data (reading: the table keeps omitted observations)**  \n  Expected table values `4, No data, No data, 0`. The table returned `4, 0`. Two points were correctly drawn. [Point normalization](../../src/data/normalize.ts#L338) keeps only valid x/y pairs, and [the scatter table](../../src/reader/table.ts#L53) enumerates those points exclusively.\n- **F2 scatter: missing zero draws two imputed zero points and exposes all four observations**  \n  Expected four points, including two imputed zeros. The scene contained two points. [Point normalization](../../src/data/normalize.ts#L343) calls the value reader with zero imputation disabled and filters the null and absent values out.\n\n### F3 AX143 guidance\n\n> If labels still do not fit, a visible note (\"Some labels hidden. See table.\") appears and AX143 suggests horizontal bars.\n\n- **F3 bar: AX143 discloses hidden labels after fitting unordered categories**  \n  The 90 bars and the note were present. The diagnostic said “Give the plot more room or shorten the labels.” Expected the horizontal-bar remedy. The [AX143 registry message](../../src/diagnostics/registry.ts#L130) omits it.\n\n### F4 scatter month and year precision\n// An inspected preparation can outlive the next one. It owns the spare slots it\n// wrote, so a competing writer must open a new buffer before reusing those indexes.\nexport class BufferWindow {\n  private written: { end: number };\n\n  constructor(public start = 0, public end = 0, written = { end }) {\n    this.written = written;\n  }\n\n  fork(): BufferWindow {\n    return new BufferWindow(this.start, this.end, this.written);\n  }\n\n  reserve(extra: number, capacity: number): number {\n    if (this.end + extra > capacity || extra > 0 && this.end < this.written.end) {\n      return Math.max(16, 2 * (this.end - this.start + extra));\n    }\n    this.written.end = Math.max(this.written.end, this.end + extra);\n    return 0;\n  }\n\n  compact(capacity: number): number {\n    const length = this.end - this.start;\n    return capacity > Math.max(32, 4 * length) ? Math.max(16, 2 * length) : 0;\n  }\n\n  rebase(extra: number): void {\n    this.end -= this.start;\n    this.start = 0;\n    this.written = { end: this.end + extra };\n  }\n}\n\nexport class Labels {\n  private names: string[];\n  private range: BufferWindow;\n\n  constructor(names: readonly string[] = []) {\n    this.names = [...names];\n    this.range = new BufferWindow(0, names.length);\n  }\n\n  get length(): number { return this.range.end - this.range.start; }\n\n  at(index: number): string {\n    return this.names[this.range.start + index]!;\n  }\n\n  fork(): Labels {\n    return Object.assign(new Labels(), { names: this.names, range: this.range.fork() });\n  }\n\n  push(name: string): void {\n    if (this.range.reserve(1, Infinity)) this.copy(1);\n    this.names[this.range.end++] = name;\n  }\n\n  pop(): string {\n    // The cursor can move back, but an inspected category view may still read the slot.\n    return this.names[--this.range.end]!;\n  }\n\n  drop(count: number): void {\n    this.range.start += count;\n    if (this.range.compact(this.names.length)) this.copy(0);\n  }\n\n  private copy(extra: number): void {\n    this.names = this.snapshot();\n    this.range.rebase(extra);\n  }\n\n  snapshot(): string[] {\n    return this.names.slice(this.range.start, this.range.end);\n  }\n\n  view(): readonly string[] {\n    const names = this.names;\n    const { start, end } = this.range;\n    const length = end - start;\n    // An ordinary array snapshot would copy every retained label on every append.\n    const indexOf = (key: PropertyKey): number => {\n      if (typeof key !== 'string') return -1;\n      const index = Number(key);\n      return index >= 0 && index < length && Number.isInteger(index) && String(index) === key ? index : -1;\n    };\n    return new Proxy([] as string[], {\n      get(target, key, receiver) {\n        if (key === 'length') return length;\n        const index = indexOf(key);\n        return index < 0 ? Reflect.get(target, key, receiver) : names[start + index];\n      },\n      has(target, key) {\n        return indexOf(key) >= 0 || Reflect.has(target, key);\n      },\n      getOwnPropertyDescriptor(target, key) {\n        if (key === 'length') return { configurable: false, enumerable: false, writable: true, value: length };\n        const index = indexOf(key);\n        return index < 0 ? Reflect.getOwnPropertyDescriptor(target, key)\n          : { configurable: true, enumerable: true, writable: false, value: names[start + index] };\n      },\n      ownKeys() {\n        return [...Array.from({ length }, (_, i) => String(i)), 'length'];\n      },\n      set: () => false,\n      deleteProperty: () => false,\n      defineProperty: () => false,\n      preventExtensions: () => false,\n    });\n  }\n}\n\ntype NumericArray = Float64Array | Int32Array | Uint8Array;\n\nexport class Column<T extends NumericArray> {\n  private data: T;\n  private range: BufferWindow;\n\n  constructor(private readonly allocate: (size: number) => T, input: T) {\n    this.range = new BufferWindow(0, input.length);\n    this.data = allocate(Math.max(16, 2 * input.length));\n    this.data.set(input);\n  }\n\n  view(): T {\n    return this.data.subarray(this.range.start, this.range.end) as T;\n  }\n\n  fork(): Column<T> {\n    return Object.assign(Object.create(Column.prototype) as Column<T>, this, { range: this.range.fork() });\n  }\n\n  append(values: T): void {\n    const capacity = this.range.reserve(values.length, this.data.length);\n    if (capacity) this.resize(capacity, values.length);\n    this.data.set(values, this.range.end);\n    this.range.end += values.length;\n  }\n\n  drop(count: number): void {\n    this.range.start += count;\n    const capacity = this.range.compact(this.data.length);\n    if (capacity) this.resize(capacity, 0);\n  }\n\n  private resize(capacity: number, extra: number): void {\n    const next = this.allocate(capacity);\n    next.set(this.view());\n    this.data = next;\n    this.range.rebase(extra);\n  }\n}\npackages/axylo/src/diagnostics/registry.ts:47:  AX102: entry('warning', d =>\npackages/axylo/src/diagnostics/registry.ts:169:    code === 'AX102' && effect === 'changed' ? 'Shown as zeros.'\n","exit_code":0,"status":"completed"}}
