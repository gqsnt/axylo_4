port function columnsTable(columns: Columns, length: number): Table {\n  const keys = Object.keys(columns);\n  const table: Table = {\n    length,\n    columns,\n    read: (row, field) => Object.hasOwn(columns, field) ? columns[field]?.[row] : undefined,\n    rowAt: row => row >= 0 && row < length && Number.isInteger(row)\n      ? Object.fromEntries(keys.map(key => [key, columns[key]?.[row]]))\n      : null,\n    hasField: field => Object.hasOwn(columns, field),\n    isColumnRow: () => true,\n    rowIndex: row => row,\n    keys: () => keys,\n  };\n  origins.set(table, columns);\n  return table;\n}\n{\n  \"name\": \"axylo-workspace\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"typecheck\": \"tsc -p packages/axylo --noEmit && tsc -p docs/api && tsc -p packages/react\",\n    \"test\": \"vitest run\",\n    \"build\": \"node scripts/build.mjs\",\n    \"size\": \"node scripts/size.mjs\",\n    \"test:browser\": \"AXYLO_BROWSER=1 vitest run\",\n    \"check\": \"npm run typecheck && npm test && npm run build && npm run test:browser && npm run size\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^26.6.6\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"axe-core\": \"^4.14.1\",\n    \"esbuild\": \"^0.28.2\",\n    \"fast-check\": \"^4.10.2\",\n    \"playwright-core\": \"^1.65.1\",\n    \"react\": \"^19.3.1\",\n    \"react-dom\": \"^19.3.1\",\n    \"typescript\": \"^7.0.2\",\n    \"vitest\": \"^5.1.0\"\n  }\n}\n","exit_code":1,"status":"failed"}}
