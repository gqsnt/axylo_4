= Reflect.construct(target, args, newTarget) as InstanceType<typeof original>;\n        if (!(args[0] instanceof ArrayBuffer) && !(args[0] instanceof SharedArrayBuffer)) bytes += result.byteLength;\n        return result;\n      },\n    });\n    Object.defineProperty(globalThis, name, { value: counted });\n    Object.defineProperty(original.prototype, 'constructor', { value: counted });\n    restore.push(() => {\n      Object.defineProperty(original.prototype, 'constructor', { value: original });\n      Object.defineProperty(globalThis, name, { value: original });\n    });\n  }\n  try {\n    const result = action();\n    return { result, bytes };\n  } finally {\n    restore.forEach(undo => undo());\n  }\n}\n\nasync function expectCollected(...refs: WeakRef<object>[]) {\n  const collect = globalThis.gc;\n  if (!collect) return;\n  for (let attempt = 0; attempt < 5; attempt++) {\n    // WeakRef keeps a dereferenced value alive only until the end of the job.\n    await new Promise<void>(resolve => setImmediate(resolve));\n    collect();\n    if (refs.every(ref => ref.deref() === undefined)) return;\n  }\n  expect(refs.map(ref => ref.deref() === undefined)).toEqual(refs.map(() => true));\n}\n\nfor (const kind of types) {\n  it(`${kind} shares numeric buffers during preparation and commit when there is spare capacity`, () => {\n    const size = kind === 'donut' ? 500 : 50_000;\n    const s = store(kind, Array.from({ length: size }, (_, i) => row(i)));\n    const initial = numericBuffers(s.frame);\n    const first = s.prepareAppend([row(size)]);\n    const firstBuffers = numericBuffers(first.frame);\n    first.commit();\n    const before = s.frame;\n    const original = numericBuffers(before);\n    const measured = allocated(() => {\n      const candidate = s.prepareAppend([row(size + 1)]);\n      const during = numericBuffers(candidate.frame);\n      expect(s.frame).toBe(before);\n      candidate.commit();\n      return during.filter((buffer, i) => original[i] !== buffer).length;\n    });\n    console.info(`${kind}: ${measured.result} replaced numeric buffers, ${measured.bytes} typed-array bytes per appended row`);\n    expect(measured.result).toBe(0);\n    firstBuffers.forEach((buffer, index) => expect(buffer).toBe(initial[index]));\n    expect(measured.bytes).toBeLessThan(256);\n  });\n\n  it.each(['keep', 'replace'] as const)(`${kind} releases caller columns after %s and retirement`, async operation => {\n    function setup() {\n      const x = Float64Array.from({ length: 300 }, (_, i) => i);\n      const y = Float64Array.from(x, i => i + 1);\n      const label = Array.from(x, String);\n      const refs = [new WeakRef(x), new WeakRef(y), new WeakRef(label)];\n      const s = store(kind, { columns: { x, y, label } });\n      const old = s.frame;\n      if (operation === 'keep') s.prepareAppend([row(300)], { keep: 2 }).commit();\n      else {\n        const data = [row(300)];\n        s.prepareReplace(data, options(kind, data), { revision: old.revision + 1, epoch: old.epoch + 1 }).commit();\n      }\n      expect(old.source.rowAt(0)).toEqual({ x: 0, y: 1, label: '0' });\n      s.retire(old.revision);\n      return { refs, s, old };\n    }\n    const { refs, s, old } = setup();\n    await expectCollected(...refs);\n    expect(old.source.rowAt(0)).toBeNull();\n    expect(s.retainedRowCount).toBe(operation === 'keep' ? 2 : 1);\n  });\n}\n\nfor (const kind of types) {\n  it(`${kind} releases an object in a partly retained column block`, async () => {\n    function setup() {\n      const payload = [{ note: 'dropped' }, { note: 'retained' }];\n      const ref = new WeakRef(payload[0]!);\n      const data = { columns: { x: Float64Array.of(0, 1), y: Float64Array.of(1, 2), label: ['0', '1'], payload } };\n      const s = store(kind, data);\n      const before = s.frame;\n      s.prepareAppend([row(2)], { keep: 2 }).commit();\n      expect(before.source.rowAt(0)).toMatchObject({ payload: payload[0] });\n      expect(s.frame.source.rowAt(1)).toMatchObject({ payload: payload[1] });\n      s.retire(before.revision);\n      return { ref, s, before };\n    }\n    const { ref, s, before } = setup();\n    await expectCollected(ref);\n    expect(before.source.rowAt(0)).toBeNull();\n    expect(s.frame.source.rowAt(0)).toBeNull();\n    expect(s.frame.source.rowAt(1)).toMatchObject({ payload: { note: 'retained' } });\n  });\n}\n\nit('releases the original backing buffer of a sliced Uint8Array subclass', async () => {\n  function setup() {\n    const bytes = Buffer.alloc(300, 2);\n    const ref = new WeakRef(bytes.buffer);\n    const data = { columns: { x: Float64Array.from(bytes, (_, i) => i), y: bytes } };\n    const s = store('line', data);\n    const old = s.frame;\n    s.prepareAppend([row(300)], { keep: 2 }).commit();\n    s.retire(old.revision);\n    return { ref, s };\n  }\n  const { ref, s } = setup();\n  await expectCollected(ref);\n  expect(s.frame.source.rowAt(299)).toEqual({ x: 299, y: 2 });\n});\n\ntype Entry = { index: number; row: ReturnType<typeof row> };\ntype Snapshot = { frame: Frame; rows: readonly Entry[]; field: 'y' | 'z'; next: number };\n\nfunction checkFrame({ frame, rows, field, next }: Snapshot, live: boolean) {\n  const indexes = rows.map(entry => entry.index);\n  const xs = rows.map(entry => entry.row.x);\n  const values = rows.map(entry => entry.row[field]);\n  if (frame.shape === 'aligned') {\n    expect(frame.length).toBe(rows.length);\n    expect([...frame.x.values]).toEqual(xs);\n    if (rows.length) {\n      expect([...frame.series[0]!.y]).toEqual(values);\n      expect([...frame.series[0]!.slot]).toEqual(values.map(() => SLOT_VALUE));\n      expect([...frame.series[0]!.row!]).toEqual(indexes);\n    }\n  } else if (frame.shape === 'points') {\n    expect([...frame.series[0]!.x]).toEqual(xs);\n    expect([...frame.series[0]!.y]).toEqual(values);\n    expect([...frame.series[0]!.row!]).toEqual(indexes);\n  } else {\n    expect([...frame.labels]).toEqual(rows.map(entry => entry.row.label));\n    expect([...frame.values]).toEqual(values);\n    expect([...frame.slot]).toEqual(values.map(() => SLOT_VALUE));\n    expect([...frame.row!]).toEqual(indexes);\n  }\n\n  let cursor = 0;\n  for (let i = 0; i <= next; i++) {\n    const entry = rows[cursor];\n    expect(frame.source.rowAt(i)).toBe(live && entry?.index === i ? entry.row : null);\n    if (entry?.index === i) cursor++;\n  }\n}\n\nconst count = fc.integer({ min: 0, max: 7 });\nconst operations = fc.array(fc.oneof(\n  fc.record({ operation: fc.constant('append' as const), count, keep: fc.option(count, { nil: undefined }) }),\n  fc.record({ operation: fc.constant('replace' as const), count, start: fc.integer({ min: -50, max: 50 }) }),\n  fc.record({ operation: fc.constant('reencode' as const), field: fc.constantFrom('y' as const, 'z' as const) }),\n  fc.record({ operation: fc.constant('retire' as const), back: count }),\n), { minLength: 1, maxLength: 35 });\n\nfor (const kind of types) {\n  it(`${kind} matches a row model across live revisions and bounds append allocations`, () => {\n    fc.assert(fc.property(operations, ops => {\n      const s = store(kind, []);\n      let field: Snapshot['field'] = 'y';\n      let rows: Entry[] = [];\n      let next = 0;\n      let x = 0;\n      let retired = s.frame.revision - 1;\n      let appendBytes = 0;\n      let rowsAdded = 0;\n      let seededRows = 0;\n      let appends = 0;\n      const snapshots: Snapshot[] = [{ frame: s.frame, rows, field, next }];\n      for (const op of ops) {\n        const before = s.frame;\n        const revised = { revision: before.revision + 1, epoch: before.epoch + 1 };\n        if (op.operation === 'append') {\n          const incoming = Array.from({ length: op.count }, () => row(x++));\n          rows = [...rows, ...incoming.map(item => ({ index: next++, row: item }))];\n          if (op.keep !== undefined) rows = rows.slice(Math.max(0, rows.length - op.keep));\n          const { result: prepared, bytes } = allocated(() => s.prepareAppend(incoming, { keep: op.keep }));\n          appendBytes += bytes;\n          rowsAdded += incoming.length;\n          appends++;\n          expect(s.frame).toBe(before);\n          checkFrame({ frame: prepared.frame, rows, field, next }, true);\n          prepared.commit();\n        } else if (op.operation === 'replace') {\n          x = op.start;\n          next = 0;\n          const data = Array.from({ length: op.count }, () => row(x++));\n          rows = data.map(item => ({ index: next++, row: item }));\n          seededRows += rows.length;\n          s.prepareReplace(data, options(kind, data, field), revised).commit();\n        } else if (op.operation === 'reencode') {\n          field = op.field;\n          seededRows += rows.length;\n          s.prepareReencode(options(kind, rows.map(entry => entry.row), field), revised).commit();\n        } else {\n          retired = Math.max(retired, before.revision - op.back);\n          s.retire(retired);\n        }\n        if (s.frame !== before) snapshots.push({ frame: s.frame, rows, field, next });\n        const retained = new Set(rows.map(entry => entry.row));\n        for (const snapshot of snapshots) {\n          const live = snapshot.frame.revision > retired;\n          checkFrame(snapshot, live);\n          if (live) for (const entry of snapshot.rows) retained.add(entry.row);\n        }\n        expect(s.retainedRowCount).toBe(retained.size);\n      }\n\n      // Each append has fixed scratch space and per-row scratch columns. A doubling\n      // or a compaction pays for itself across the rows inserted, evicted, or seeded.\n      expect(appendBytes).toBeLessThanOrEqual(2_048 * appends + 384 * (rowsAdded + seededRows));\n    }), { numRuns: 1_000 });\n  });\n\n  it(`${kind} uses offset views while sliding a fixed window and bounds long-run allocations`, () => {\n    const size = 600;\n    const s = store(kind, Array.from({ length: size }, (_, i) => row(i)));\n    const first = s.frame;\n    const a = s.prepareAppend([row(size)], { keep: size });\n    numericBuffers(a.frame).forEach((buffer, i) => expect(buffer).toBe(numericBuffers(first)[i]));\n    a.commit();\n    s.retire(first.revision);\n    const updates = 2_000;\n    const { bytes } = allocated(() => {\n      for (let i = 1; i <= updates; i++) {\n        const previous = s.frame;\n        s.prepareAppend([row(size + i)], { keep: size }).commit();\n        s.retire(previous.revision);\n      }\n    });\n    expect(s.retainedRowCount).toBe(size);\n    expect(bytes).toBeLessThan(256 * updates);\n  });\n}\n\nfor (const kind of types) {\n  it(`${kind} keeps competing previews and captured views independent`, () => {\n    const data = [row(0), row(1)];\n    const s = store(kind, data);\n    const before = s.frame;\n    const accepted = s.prepareAppend([row(2)], { keep: 2 });\n    const rejected = s.prepareAppend([row(3)], { keep: 1 });\n    expect(rejected.frame.source.rowAt(2)).toEqual(row(3));\n    checkFrame({ frame: before, rows: data.map((row, index) => ({ row, index })), field: 'y', next: 2 }, true);\n    accepted.commit();\n    expect(() => rejected.commit()).toThrow('Cannot commit a superseded data revision.');\n    expect(rejected.frame.source.rowAt(2)).toBeNull();\n    const values = rejected.frame.shape === 'aligned' ? rejected.frame.series[0]!.y :\n      rejected.frame.shape === 'points' ? rejected.frame.series[0]!.y : rejected.frame.values;\n    expect([...values]).toEqual([4]);\n    expect(s.frame.source.rowAt(2)).toEqual(row(2));\n  });\n}\n\nit('preserves a captured series view when a later row fills its shared-x slot', () => {\n  const data = [{ x: 0, y: 2, group: 'a' }, { x: 0, y: 3, group: 'b' }, { x: 1, y: 4, group: 'a' }];\n  const encoded = resolveOptions('line', { data, x: 'x', y: 'y', series: 'group' }, quiet);\n  const s = new AlignedStore('line', encoded, utc, version);\n  const before = s.frame;\n  const values = before.series[1]!.y;\n  const observation = { x: 1, y: 5, group: 'b' };\n  const candidate = s.prepareAppend([observation]);\n  expect([...candidate.frame.series[1]!.y]).toEqual([3, 5]);\n  expect([...values]).toEqual([3, NaN]);\n  candidate.commit();\n  expect([...values]).toEqual([3, NaN]);\n  expect(before.source.rowAt(3)).toBeNull();\n  expect(s.frame.source.rowAt(3)).toBe(observation);\n});\n\nit('shares ordered time-point storage and revalidates a daily cadence exposed by keep', () => {\n  const day = 86_400_000;\n  const firstDay = Date.UTC(2026, 0, 1);\n  const data = [row(firstDay - 3_600_000), row(firstDay), row(firstDay + day)];\n  const resolved = resolveOptions('scatter', { data, x: { field: 'x', type: 'time' }, y: 'y' }, quiet);\n  const s = new PointStore(resolved, utc, version);\n  const first = s.frame;\n  const prepared = s.prepareAppend([row(firstDay + 2 * day)]);\n  numericBuffers(prepared.frame).forEach((buffer, i) => expect(buffer).toBe(numericBuffers(first)[i]));\n  expect(prepared.diagnostics).toEqual([]);\n  prepared.commit();\n  const daily = s.prepareAppend([row(firstDay + 3 * day)], { keep: 3 });\n  expect(daily.diagnostics).toMatchObject([{ code: 'AX111', count: 3, rows: [2, 3, 4] }]);\n  daily.commit();\n  expect([...s.frame.series[0]!.x]).toEqual([firstDay + day, firstDay + 2 * day, firstDay + 3 * day]);\n  expect([...first.series[0]!.x]).toEqual(data.map(item => item.x));\n});\nimport type { AlignedFrame, Frame } from '../../src/core/contracts';\nimport { normalize, resolveOptions, type ChartType } from '../../src/data';\nimport { DiagnosticCollector } from '../../src/diagnostics';\n\nexport const version = { epoch: 4, revision: 8 };\nexport const utc = { timeZone: 'UTC' };\n\nexport function check(type: ChartType, options: unknown, environment = utc): { frame: Frame; diagnostics: DiagnosticCollector } {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions(type, options, diagnostics);\n  return { frame: normalize(type, resolved, environment, diagnostics, version), diagnostics };\n}\n\nexport function aligned(options: unknown, environment = utc) {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions('line', options, diagnostics);\n  return { frame: normalize('line', resolved, environment, diagnostics, version), diagnostics, resolved };\n}\n\nexport function contents(frame: AlignedFrame) {\n  return {\n    x: { ...frame.x, values: [...frame.x.values] },\n    length: frame.length, xLabel: frame.xLabel, yLabel: frame.yLabel,\n    series: frame.series.map(({ y, slot, row, ...description }) => ({\n      ...description, y: [...y], slot: [...slot], row: row ? [...row] : [...y.keys()],\n    })),\n  };\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/reader/index.test.ts && cat packages/axylo/src/reader/index.ts'","aggregated_output":"import { expect, it, vi } from 'vitest';\nimport { buildTable } from '../../src/reader/table';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { defaultMessages, resolveMessages } from '../../src/messages';\nimport { buildReader, type ReaderInput } from '../../src/reader';\nimport { buildStack } from '../../src/view/stack';\nimport { aligned, donut, formatter, frame, scatter } from '../lookup/fixtures';\n\nfunction read(view: ReaderInput['view'], input: Partial<ReaderInput> = {}) {\n  return buildReader({ view, formatters: formatter(view.frame), messages: defaultMessages, type: 'Line', locale: 'en-US', ...input });\n}\n\nconst trend = aligned(frame('line', {\n  x: { field: 'day', label: 'Day' }, y: { field: 'sessions', label: 'Sessions' }, series: 'channel', data: [\n    { day: 0, sessions: 90, channel: 'Direct' }, { day: 0, sessions: 90, channel: 'Search' }, { day: 0, sessions: 90, channel: 'Referral' },\n    { day: 1, sessions: 10, channel: 'Direct' }, { day: 1, sessions: 20, channel: 'Search' }, { day: 1, sessions: 7, channel: 'Referral' },\n    { day: 2, sessions: 30, channel: 'Direct' }, { day: 2, sessions: 12, channel: 'Search' }, { day: 2, sessions: 5, channel: 'Referral' },\n    { day: 3, sessions: 20, channel: 'Direct' }, { day: 3, sessions: null, channel: 'Search' }, { day: 3, sessions: 8, channel: 'Referral' },\n  ],\n}), { visibleSlots: { start: 1, end: 4 }, references: [{ axis: 'y', from: 20, to: 20, label: 'Target' }] });\n\nit('summarizes three visible series within the shown range and includes the reference position in the summary and caption', () => {\n  const model = read(trend, { title: { text: 'Daily sessions', visible: false }, subtitle: 'Acquisition channels' });\n  expect(model.name).toBe('Daily sessions');\n  expect(model.summary).toBe('Line chart with 3 series. Day from 1 to 3. Sessions from 5 to 30. '\n    + 'Direct: minimum 10, maximum 30, last 20. Search: minimum 12, maximum 20, last 12. '\n    + 'Referral: minimum 5, maximum 8, last 8. Reference line Target at 20. Acquisition channels');\n  expect(model.note).toBeNull();\n  expect(model.table?.caption).toBe('Daily sessions Reference line Target at 20.');\n});\n\nit('adds the zone for instants and leaves it out for calendar dates', () => {\n  function byDay(start: string, end: string) {\n    return aligned(frame('line', { data: [{ day: start, value: 1 }, { day: end, value: 5 }],\n      x: { field: 'day', timeZone: 'America/Los_Angeles' }, y: 'value' }));\n  }\n  const time = read(byDay('2026-02-24T12:00:00Z', '2026-02-25T13:00:00Z'));\n  const dates = read(byDay('2026-02-24', '2026-02-25'));\n  expect(time.summary).toContain('Times are shown in America/Los_Angeles.');\n  expect(time.table?.pageForX(new Date('2026-02-25T12:00:00Z'))).toBe(0);\n  expect(dates.summary).not.toContain('Times are shown');\n  expect(dates.table?.pageForX('2026-02-25')).toBe(0);\n  expect(dates.table?.pageForX('2026-02-30')).toBeNull();\n});\n\nit('keeps disclosures before the author description and joins both visible notes', () => {\n  const input = { description: 'The reporting period was revised.', disclosure: { omitted: 2, changed: 1 }, labelsHidden: 4 };\n  const model = read(trend, input);\n  expect(model.summary).toMatch(/Values not shown: 2\\. See table\\. Values shown differently from the data: 1\\. See table\\. The reporting period was revised\\.$/);\n  expect(model.note).toBe('Values not shown: 2. See table. Values shown differently from the data: 1. See table. Some labels hidden. See table.');\n  const custom = read(trend, {\n    ...input,\n    formatters: { ...formatter(trend.frame), count: n => `count(${n})` },\n    messages: resolveMessages({ valuesNotShown: 'Omitted {count}.', valuesChanged: 'Changed {count}.' }),\n  });\n  expect(custom.note).toBe('Omitted count(2). Changed count(1). Some labels hidden. See table.');\n  expect(custom.summary).toContain('Line chart with count(3) series.');\n  expect(custom.summary).toMatch(/Omitted count\\(2\\)\\. Changed count\\(1\\)\\. The reporting period was revised\\.$/);\n});\n\nit.each([{ compact: true }, { table: false }])('keeps disclosure text without a table under %j', options => {\n  const model = read(trend, { ...options, disclosure: { omitted: 2, changed: 1 }, labelsHidden: 4 });\n  expect(model.table).toBeNull();\n  expect(model.note).toBe('Values not shown: 2. Values shown differently from the data: 1. Some labels hidden.');\n  expect(model.summary).toMatch(/Values not shown: 2\\. Values shown differently from the data: 1\\.$/);\n});\n\nit('fills explicit table guidance in authored disclosures and preserves overrides that omit it', () => {\n  const messages = resolveMessages({\n    valuesNotShown: 'Ausgelassen: {count}.', valuesChanged: 'Changed {count}. {seeTable}',\n    labelsHidden: 'Labels hidden: {count}. {seeTable}', seeTable: 'Check the rows.',\n  });\n  const input = { messages, disclosure: { omitted: 2, changed: 1 }, labelsHidden: 4 };\n  const model = read(trend, input);\n  expect(model.note).toBe('Ausgelassen: 2. Changed 1. Check the rows. Labels hidden: 4. Check the rows.');\n  expect(model.summary).toMatch(/Ausgelassen: 2\\. Changed 1\\. Check the rows\\.$/);\n  const compact = read({ ...trend, compact: true }, input);\n  expect(compact.note).toBe('Ausgelassen: 2. Changed 1. Labels hidden: 4.');\n  expect(compact.summary).toMatch(/Ausgelassen: 2\\. Changed 1\\.$/);\n});\n\nit('skips a disclosure that becomes empty and preserves whitespace in a template without the placeholder', () => {\n  const messages = resolveMessages({ valuesNotShown: ' {seeTable}\\t', valuesChanged: 'Changed {count}.  ' });\n  const model = read(trend, { messages, table: false, disclosure: { omitted: 2, changed: 1 } });\n  expect(model.note).toBe('Changed 1.  ');\n  expect(model.summary).toMatch(/Target at 20\\. Changed 1\\.  $/);\n});\n\nit('uses the external heading when supplied, otherwise generates and reports a missing name', () => {\n  const diagnostics = new DiagnosticCollector();\n  const labelled = read(trend, { labelledBy: 'heading', caption: 'Outside heading', diagnostics });\n  expect(labelled.name).toBe('');\n  expect(labelled.table?.caption).toBe('Outside heading Reference line Target at 20.');\n  expect(read(trend, { labelledBy: 'heading' }).table?.caption)\n    .toBe('Line chart of Sessions by Day Reference line Target at 20.');\n  expect(diagnostics.inputs()).toEqual([]);\n  expect(read(trend, { diagnostics }).name).toBe('Line chart of Sessions by Day');\n  expect(diagnostics.inputs()).toMatchObject([{ code: 'AX140', effect: 'none' }]);\n  expect(read(trend, { messages: resolveMessages({ chartName: '{x} and {y} ({type})' }) }).name).toBe('Day and Sessions (Line)');\n});\n\nit('formats one requested row of a million-row table and finds its page by x', () => {\n  const size = 1_000_000;\n  const x = Float64Array.from({ length: size }, (_, i) => i * 2);\n  const duration = Float64Array.from(x, v => v / 2 + 0.5);\n  const hidden = Float64Array.from(x, v => v / 2 + 2);\n  const data = frame('line', { data: { columns: { x, duration, hidden } }, x: { field: 'x', label: 'Index' },\n    y: [{ field: 'duration', label: 'Duration', unit: 'ms' }, { field: 'hidden', label: 'Bytes', unit: 'B' }] });\n  expect(data.x.values).toBe(x);\n  const formatters = formatter(data);\n  const formatX = vi.fn(formatters.x);\n  const formatValue = vi.fn(formatters.value);\n  const view = aligned(data, { visible: [true, false] });\n  const start = performance.now();\n  const model = read(view, { title: 'Timing', formatters: { ...formatters, x: formatX, value: formatValue } });\n  expect(formatX).not.toHaveBeenCalled();\n  expect(formatValue).not.toHaveBeenCalled();\n  const table = model.table!;\n  expect(table.headers).toEqual(['Index', 'Duration (ms)', 'Bytes (B)']);\n  expect(table.rowCount).toBe(size);\n  expect(table.pageSize).toBe(100);\n  expect(table.row(900_000)).toEqual(['1,800,000', '900,000.5 ms', '900,002 B']);\n  expect(table.pageForX(1_799_999)).toBe(9000);\n  expect(table.pageForX(1_800_000)).toBe(9000);\n  expect(table.pageForX(2_000_000)).toBeNull();\n  expect(table.row(size)).toBeNull();\n  expect(formatX).toHaveBeenCalledTimes(1);\n  expect(formatValue).toHaveBeenCalledTimes(2);\n  expect(performance.now() - start).toBeLessThan(500);\n});\n\nit('limits the table to the current x range and omits it when disabled or compact', () => {\n  const table = read(trend).table!;\n  expect(table.rowCount).toBe(3);\n  expect(table.row(2)).toEqual(['3', '20', 'No data', '8']);\n  expect(table.pageForX(0)).toBe(0);\n  expect(table.pageForX(4)).toBeNull();\n  expect(read(trend, { compact: true }).table).toBeNull();\n  expect(read({ ...trend, compact: true }).table).toBeNull();\n  expect(read(trend, { table: false }).table).toBeNull();\n});\n\nit('uses the declared x and y units in aligned table headers without formatting any rows', () => {\n  const data = frame('line', { data: [{ x: 1, y: 2 }], x: { field: 'x', label: 'Distance', unit: 'm' },\n    y: { field: 'y', label: 'Time', unit: 's' } });\n  const x = vi.fn(() => 'One metre');\n  const model = read(aligned(data), { labels: { xUnit: 'm' }, formatters: { ...formatter(data), x } });\n  expect(model.table?.headers).toEqual(['Distance (m)', 'Time (s)']);\n  expect(x).not.toHaveBeenCalled();\n});\n\nit('marks an incomplete stack in its row header without changing the series cells', () => {\n  const data = frame('area', { data: [{ x: 0, a: 2, b: null }, { x: 1, a: 3, b: -1 }], x: 'x', y: ['a', 'b'] });\n  const table = read(aligned(data, { kind: 'area', stack: {\n    order: [0, 1], incomplete: Uint8Array.of(1, 0),\n    positive: [Float64Array.of(2, 3), Float64Array.of(2, 3)],\n    negative: [Float64Array.of(0, 0), Float64Array.of(0, -1)],\n  } })).table!;\n  expect(table.row(0)).toEqual(['0 (incomplete)', '2', 'No data']);\n  expect(table.row(1)).toEqual(['1', '3', '-1']);\n});\n\nit('lists up to three shown incomplete stack positions with the x formatter and the incomplete message', () => {\n  const data = frame('area', { data: [10, 20, 30, 40, 50].map(x => ({ x, a: 2, b: x === 40 ? 1 : null })),\n    x: { field: 'x', label: 'Distance' }, y: ['a', 'b'] });\n  const view = aligned(data, { kind: 'area', compact: true, visibleSlots: { start: 1, end: 5 }, stack: buildStack(data, [true, true]) });\n  const model = read(view, { formatters: { ...formatter(data), x: x => `${x} m` },\n    messages: resolveMessages({ incompleteStack: 'partial' }) });\n  expect(model.summary).toContain('Distance (partial): 20 m, 30 m, 50 m.');\n});\n\nit('counts incomplete stacks when a compact summary would need more than three positions', () => {\n  const data = frame('bar', { data: [10, 20, 30, 40].map(x => ({ x, a: 2, b: null })),\n    x: { field: 'x', label: 'Distance' }, y: ['a', 'b'] });\n  const view = aligned(data, { kind: 'bar', stack: buildStack(data, [true, true]) });\n  const formatters = { ...formatter(data), count: (n: number) => `count(${n})` };\n  expect(read(view, { compact: true, formatters }).summary).toContain('Distance (incomplete): Total count(4).');\n  expect(read(view).summary).not.toContain('incomplete');\n});\n\nit('presents grouped donut categories separately in the table and together in the summary', () => {\n  const values = [1, 2, 3, 4, 5, 6, 7, 8, 64];\n  const data = frame('donut', { data: values.map((value, i) => ({ category: `C${i}`, value })), label: 'category',\n    value: { field: 'value', label: 'Count', unit: 'sessions' } });\n  const base = donut(data);\n  const model = read({ ...base, slices: [...base.slices.slice(2), {\n    key: 'other', label: 'Other (2)', colorIndex: 7, members: [0, 1], value: 3, ratio: 0.03, angles: [0.97 * 2 * Math.PI, 2 * Math.PI],\n  }] }, { type: 'Donut' });\n  const table = model.table!;\n  expect(table.headers).toEqual(['Category', 'Count (sessions)', 'Percentage']);\n  expect(table.rowCount).toBe(9);\n  expect(table.row(0)).toEqual(['C0', '1 sessions', '1%']);\n  expect(table.row(1)).toEqual(['C1', '2 sessions', '2%']);\n  expect(table.row(8)).toEqual(['C8', '64 sessions', '64%']);\n  expect(table.pageForX('C8')).toBe(0);\n  expect(model.summary).toBe('Donut chart with 8 slices. Total 100 sessions. '\n    + 'C2: 3 sessions (3%). C3: 4 sessions (4%). C4: 5 sessions (5%). C5: 6 sessions (6%). '\n    + 'C6: 7 sessions (7%). C7: 8 sessions (8%). C8: 64 sessions (64%). Other (2): 3 sessions (3%).');\n  expect(model.summary).not.toContain('C0:');\n});\n\nit('merges scatter rows in x then y order including hidden series', () => {\n  const data = frame('scatter', { x: { field: 'x', label: 'Distance', unit: 'km' }, y: { field: 'y', label: 'Speed', unit: 'km/h' }, series: 'group', data: [\n    { x: 3, y: 5, group: 'A' }, { x: 1, y: 3, group: 'B' }, { x: 0, y: 6, group: 'A' },\n    { x: 3, y: 2, group: 'B' }, { x: 9, y: 2, group: 'B' },\n  ] });\n  const view = scatter(data, { xDomain: [0, 3], visible: [true, false], visiblePoints: [{ start: 0, end: 2 }, { start: 0, end: 2 }] });\n  const model = read(view, { type: 'Scatter' });\n  const table = model.table!;\n  expect(table.headers).toEqual(['Distance (km)', 'Series', 'Speed (km/h)']);\n  expect(table.rowCount).toBe(4);\n  expect([0, 1, 2, 3].map(i => table.row(i))).toEqual([\n    ['0 km', 'A', '6 km/h'], ['1 km', 'B', '3 km/h'], ['3 km', 'B', '2 km/h'], ['3 km', 'A', '5 km/h'],\n  ]);\n  expect(table.pageForX(3)).toBe(0);\n  expect(table.pageForX(9)).toBeNull();\n  expect(model.summary).toContain('A: minimum 5 km/h, maximum 6 km/h, last 5 km/h.');\n  expect(model.summary).not.toContain('B:');\n});\n\nit('uses message overrides for chart types and table headers and uses a field name for the absent y label', () => {\n  const messages = resolveMessages({\n    category: 'Kategorie', percentage: 'Anteil', series: 'Reihe', value: 'Wert',\n    typeLine: 'Linie', typeDonut: 'Ring', typeScatter: 'Streuung',\n  });\n  const line = aligned(frame('line', { data: [{ x: 1, hits: 2 }], x: 'x', y: ['hits'] }));\n  const data = donut(frame('donut', { data: [{ cat: 'A', hits: 2 }], label: 'cat', value: 'hits' }));\n  const plot = scatter(frame('scatter', { data: [{ x: 1, y: 2 }], x: 'x', y: 'y' }));\n  expect(read(line, { messages }).name).toBe('Linie chart of hits by x');\n  expect(read(data, { messages }).table?.headers).toEqual(['Kategorie', 'hits', 'Anteil']);\n  expect(read(data, { messages }).name).toBe('Ring chart of hits by Kategorie');\n  expect(read(plot, { messages }).table?.headers).toEqual(['x', 'Reihe', 'y']);\n  expect(read(plot, { messages }).name).toBe('Streuung chart of y by x');\n});\n\nit('uses one no-data sentence per empty series, omits an unavailable value range, and stops at an empty view', () => {\n  const data = frame('line', { data: [{ x: 5, a: null, b: null }, { x: 6, a: 2, b: null }], x: 'x', y: ['a', 'b'] });\n  expect(read(aligned(data)).summary).toBe('Line chart with 2 series. x from 5 to 6. a from 2 to 2. '\n    + 'a: minimum 2, maximum 2, last 2. b: no data.');\n  expect(read(aligned(data, { visibleSlots: { start: 0, end: 1 } })).summary)\n    .toBe('Line chart with 2 series. x from 5 to 5. a: no data. b: no data.');\n  expect(read(aligned(data, { visibleSlots: { start: 1, end: 1 } })).summary).toBe('No data to show.');\n});\n\nit('identifies an undrawable duplicate-x series even when absent from the visibility mask', () => {\n  const data = frame('line', { data: [{ x: 0, y: 1, group: 'A' }, { x: 1, y: 2, group: 'A' },\n    { x: 0, y: 3, group: 'B' }, { x: 0, y: 4, group: 'B' }], x: 'x', y: 'y', series: 'group' });\n  expect(read(aligned(data)).summary).toContain('B could not be drawn. See table.');\n  const withGuidance = resolveMessages({ seriesNotDrawn: '{series} ({seeTable})!', seeTable: 'check the rows' });\n  expect(read(aligned(data), { messages: withGuidance }).summary).toMatch(/B \\(check the rows\\)!$/);\n  const messages = resolveMessages({ seriesNotDrawn: 'Skipped {series}!' });\n  expect(read(aligned(data), { messages }).summary).toMatch(/Skipped B!$/);\n  expect(read(aligned(data), { compact: true }).summary).toMatch(/B could not be drawn\\.$/);\n});\n\nit('formats reference lines and bands on their own axes and leaves the deprecated alias unused', () => {\n  const formatters = { ...formatter(trend.frame), x: (x: number) => `x=${x}`, value: (_s: number, y: number) => `y=${y}` };\n  const view = { ...trend, references: [{ axis: 'y', from: 20, to: 20, label: 'Goal' },\n    { axis: 'x', from: 1, to: 3, label: 'Period' }] } as const;\n  const messages = resolveMessages({ referenceSummary: 'Deprecated' });\n  const model = read(view, { title: 'Daily sessions', messages, formatters });\n  const references = 'Reference line Goal at y=20. Reference band Period from x=1 to x=3.';\n  expect(model.summary.endsWith(references)).toBe(true);\n  expect(model.table?.caption).toBe(`Daily sessions ${references}`);\n});\n\nit('reports only drawn donut slices and uses the supplied percent and count formatters', () => {\n  const data = donut(frame('donut', { data: [{ cat: 'A', hits: 2 }, { cat: 'Zero', hits: 0 }, { cat: 'Missing', hits: null }],\n    label: 'cat', value: 'hits' }));\n  const formatters = { ...formatter(data.frame), count: (n: number) => `count(${n})`, percent: (n: number) => `share(${n})` };\n  const model = read(data, { formatters });\n  expect(model.summary).toBe('Donut chart with count(1) slices. Total 2. A: 2 (share(1)).');\n  expect(model.table?.row(0)).toEqual(['A', '2', 'share(1)']);\n  expect(model.table?.row(1)).toEqual(['Zero', '0', 'share(0)']);\n});\n\nit('advances distant scatter table pages by one merge step per row', () => {\n  const seriesCount = 500;\n  const rows = 400;\n  const base = frame('scatter', { x: 'x', y: 'y', data: [] });\n  const data = { ...base, series: Array.from({ length: seriesCount }, (_, s) => ({\n    key: String(s), label: `S${s}`, drawable: true,\n    x: Float64Array.from({ length: rows }, (_, i) => i * 2), y: new Float64Array(rows).fill(s), row: null,\n  })) };\n  const work = { seeks: 0, steps: 0, comparisons: 0 };\n  const table = buildTable(scatter(data), 'Points', formatter(data), defaultMessages, defaultMessages, 'en-US', work);\n  expect(work).toEqual({ seeks: 0, steps: 0, comparisons: 0 });\n  const start = table.rowCount - 200;\n  expect(table.pageForX(798)).toBe(1995);\n  for (let i = 0; i < 100; i++) {\n    expect(table.row(start + i)).toEqual(['798', `S${300 + i}`, String(300 + i)]);\n  }\n  expect(work.seeks).toBe(1);\n  expect(work.steps).toBe(100);\n  expect(work.comparisons).toBeGreaterThan(0);\n  expect(work.comparisons).toBeLessThan(60_000);\n  expect(table.row(0)).toEqual(['0', 'S0', '0']);\n  expect(table.row(table.rowCount - 1)).toEqual(['798', 'S499', '499']);\n  expect(work.seeks).toBe(3);\n});\n\nit('jumps to wall-clock and calendar values using the data parser', () => {\n  const wall = frame('line', { x: 'x', y: 'y', data: [\n    { x: '2026-03-28T12:45:00', y: 1 }, { x: '2026-03-30T12:45:00', y: 2 },\n  ] });\n  const wallTable = read(aligned(wall)).table!;\n  expect(wallTable.pageForX('2026-03-30T12:45:00')).toBe(0);\n  expect(wallTable.pageForX('2026-03-30T12:45:00Z')).toBeNull();\n  expect(wallTable.pageForX('2026-03-30T12:45:01')).toBeNull();\n\n  const month = frame('line', { x: 'x', y: 'y', data: [{ x: '2026-02', y: 1 }, { x: '2026-03', y: 2 }] });\n  const dateTable = read(aligned(month)).table!;\n  expect(dateTable.pageForX('2026-02-28')).toBe(0);\n  expect(dateTable.pageForX('2026-02-29')).toBeNull();\n});\nimport { SLOT_VALUE, type DiagnosticSink, type Formatters, type IndexRange, type ReaderModel, type View } from '../core/contracts';\nimport { report } from '../diagnostics';\nimport { incomplete, sliceText } from '../lookup/text';\nimport { defaultMessages, fill, fillChartSummary, fillDonutSlice } from '../messages';\nimport type { Messages, Title } from '../public';\nimport { buildTable, type ReaderLabels } from './table';\n\nexport interface ReaderInput {\n  readonly view: View;\n  readonly formatters: Formatters;\n  readonly messages: Messages;\n  /** Retained for callers that previously supplied the chart type label. */\n  readonly type: string;\n  readonly title?: string | Title;\n  readonly labelledBy?: string;\n  /** Visible text of the external heading when the chart uses labelledBy. */\n  readonly caption?: string;\n  readonly subtitle?: string;\n  readonly description?: string;\n  readonly disclosure?: { readonly omitted: number; readonly changed: number };\n  readonly labelsHidden?: number;\n  readonly table?: boolean;\n  readonly compact?: boolean;\n  readonly locale?: string;\n  readonly labels?: Partial<ReaderLabels>;\n  readonly diagnostics?: DiagnosticSink;\n}\n\nconst TYPE_MESSAGE = {\n  line: 'typeLine', area: 'typeArea', bar: 'typeBar', scatter: 'typeScatter', donut: 'typeDonut',\n} as const;\nconst MAX_STACK_POSITIONS = 3;\n\nfunction statistics(y: Float64Array | Float32Array, { start, end }: IndexRange, slot?: Uint8Array) {\n  let min = Infinity;\n  let max = -Infinity;\n  let last = NaN;\n  for (let i = start; i < end; i++) {\n    if (slot && slot[i] !== SLOT_VALUE) continue;\n    const value = y[i]!;\n    if (!Number.isFinite(value)) continue;\n    last = value;\n    if (last < min) min = last;\n    if (last > max) max = last;\n  }\n  return { min, max, last };\n}\n\nfunction fillWithTable(template: string, values: Readonly<Record<string, string | number>>, seeTable: string): string {\n  const text = fill(template, { ...values, seeTable });\n  return seeTable === '' && template.includes('{seeTable}') ? text.trimEnd() : text;\n}\n\nfunction chartText(input: ReaderInput, type: string, xLabel: string, yLabel: string, seeTable: string): string[] {\n  const { view, formatters, messages } = input;\n  if (view.kind === 'donut') {\n    const drawn = view.slices.filter(slice => slice.angles && slice.angles[1] > slice.angles[0]);\n    if (!drawn.length) return [messages.empty];\n    return [\n      fill(messages.donutSummary, { type, count: formatters.count(drawn.length), total: formatters.value(0, view.total) }),\n      ...drawn.map(slice => {\n        const { label, value, percent } = sliceText(view, slice, formatters);\n        return fillDonutSlice(label, value, percent ?? '');\n      }),\n    ];\n  }\n\n  let xMin = Infinity;\n  let xMax = -Infinity;\n  let min = Infinity;\n  let max = -Infinity;\n  let minSeries = 0;\n  let maxSeries = 0;\n  let seriesCount = 0;\n  const entries: string[] = [];\n  const undrawn: string[] = [];\n  const { frame } = view;\n  const zone = view.kind === 'scatter'\n    ? view.frame.xKind === 'time' && view.frame.timeZone\n    : view.frame.x.kind === 'time' && view.frame.x.timeZone;\n\n  if (view.kind !== 'scatter') {\n    const { start, end } = view.visibleSlots;\n    if (start < end) {\n      xMin = view.frame.x.values[start]!;\n      xMax = view.frame.x.values[end - 1]!;\n    }\n  }\n  frame.series.forEach((series, s) => {\n    if (!series.drawable) {\n      undrawn.push(fillWithTable(messages.seriesNotDrawn, { series: series.label }, seeTable));\n      return;\n    }\n    if (!view.visible[s]) return;\n    const range = view.kind === 'scatter' ? view.visiblePoints[s]! : view.visibleSlots;\n    if (range.start < range.end && 'x' in series) {\n      xMin = Math.min(xMin, series.x[range.start]!);\n      xMax = Math.max(xMax, series.x[range.end - 1]!);\n    }\n    const stats = statistics(series.y, range, 'slot' in series ? series.slot : undefined);\n    if (stats.min < min) { min = stats.min; minSeries = s; }\n    if (stats.max > max) { max = stats.max; maxSeries = s; }\n    seriesCount++;\n    entries.push(Number.isFinite(stats.last) ? fill(messages.seriesSummary, {\n      series: series.label, min: formatters.value(s, stats.min),\n      max: formatters.value(s, stats.max), last: formatters.value(s, stats.last),\n    }) : fill(messages.seriesNoData, { series: series.label }));\n  });\n\n  const zoneText = zone ? [fill(messages.timeZoneNote, { zone })] : [];\n  if (!seriesCount || !Number.isFinite(xMin) || !Number.isFinite(xMax)) return [...undrawn, messages.empty, ...zoneText];\n  const range = Number.isFinite(min) && Number.isFinite(max)\n    ? { yMin: formatters.value(minSeries, min), yMax: formatters.value(maxSeries, max) } : null;\n  return [\n    fillChartSummary(messages.chartSummary, {\n      type, seriesCount: formatters.count(seriesCount), xLabel, xMin: formatters.x(xMin), xMax: formatters.x(xMax), yLabel,\n    }, range),\n    ...zoneText, ...entries, ...undrawn,\n  ];\n}\n\nfunction stackText(view: View, formatters: Formatters, messages: Messages): string {\n  if (view.kind === 'donut' || view.kind === 'scatter') return '';\n  const flags = view.stack?.incomplete;\n  if (!flags) return '';\n  const positions: number[] = [];\n  let count = 0;\n  for (let i = view.visibleSlots.start; i < view.visibleSlots.end; i++) {\n    if (!flags[i]) continue;\n    if (count < MAX_STACK_POSITIONS) positions.push(view.frame.x.values[i]!);\n    count++;\n  }\n  if (!count) return '';\n  const details = count > MAX_STACK_POSITIONS\n    ? `${messages.total} ${formatters.count(count)}` : positions.map(position => formatters.x(position)).join(', ');\n  return `${incomplete(view.frame.xLabel, messages)}: ${details}.`;\n}\n\nfunction referenceText(view: View, formatters: Formatters, messages: Messages): string[] {\n  if (view.kind === 'donut') return [];\n  return view.references.map(({ axis, from, to, label }) => {\n    const write = axis === 'x' ? (x: number) => formatters.x(x) : (y: number) => formatters.value(0, y);\n    const values = { label, axis, from: write(from) };\n    return from === to ? fill(messages.referenceLine, values) : fill(messages.referenceBand, { ...values, to: write(to) });\n  });\n}\n\nexport function buildReader(input: ReaderInput): ReaderModel {\n  const { view, title, labelledBy, subtitle, description, formatters, messages, disclosure } = input;\n  const labels = {\n    category: input.labels?.category ?? messages.category,\n    percentage: input.labels?.percentage ?? messages.percentage,\n    series: input.labels?.series ?? messages.series,\n    value: input.labels?.value ?? messages.value,\n    xUnit: input.labels?.xUnit,\n  };\n  const type = messages[TYPE_MESSAGE[view.kind]];\n  const xLabel = view.kind === 'donut' ? labels.category : view.frame.xLabel;\n  const yLabel = view.kind === 'donut' ? view.frame.valueLabel\n    : view.kind === 'scatter' ? view.frame.yLabel : view.frame.yLabel || view.frame.series[0]?.field || labels.value;\n  const titleText = typeof title === 'string' ? title : title?.text;\n  if (!labelledBy && !titleText && input.diagnostics) report(input.diagnostics, 'AX140', 'none');\n  const generated = fill(messages.chartName, { type, x: xLabel, y: yLabel });\n  const name = labelledBy ? '' : titleText || generated;\n  const compact = input.compact === true || (view.kind !== 'donut' && view.compact);\n  let references: string[] | undefined;\n  const referencesForView = () => references ??= referenceText(view, formatters, messages);\n  const caption = [input.caption, name, generated, messages.plotLabel].find(text => text?.trim()) ?? defaultMessages.plotLabel;\n  const table = input.table === false || compact ? null : buildTable(\n    view, [caption, ...referencesForView()].join(' '), formatters, messages, labels, input.locale,\n  );\n  const seeTable = table ? messages.seeTable : '';\n  const omitted = disclosure?.omitted ?? 0;\n  const changed = disclosure?.changed ?? 0;\n  const statements: string[] = [];\n  if (omitted > 0 || changed > 0) {\n    const counts = { omitted: formatters.count(omitted), changed: formatters.count(changed) };\n    if (omitted > 0) statements.push(fillWithTable(messages.valuesNotShown, { ...counts, count: counts.omitted }, seeTable));\n    if (changed > 0) statements.push(fillWithTable(messages.valuesChanged, { ...counts, count: counts.changed }, seeTable));\n  }\n  const omission = statements.filter(Boolean).join(' ');\n  const hidden = input.labelsHidden ?? 0;\n  const labelsHidden = hidden > 0 ? fillWithTable(messages.labelsHidden, { count: formatters.count(hidden) }, seeTable) : '';\n  const note = [omission, labelsHidden].filter(Boolean).join(' ') || null;\n  let summary: string | undefined;\n  return {\n    name, note, table,\n    get summary() {\n      // Opening the table should not scan the rest of the frame.\n      return summary ??= [\n        ...chartText(input, type, xLabel, yLabel, seeTable), compact ? stackText(view, formatters, messages) : '',\n        ...referencesForView(), subtitle, omission, description,\n      ].filter(Boolean).join(' ');\n    },\n  };\n}\n","exit_code":0,"status":"completed"}}
