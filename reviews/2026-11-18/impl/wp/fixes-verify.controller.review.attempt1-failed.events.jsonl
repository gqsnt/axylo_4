nk = { add: () => {} };\n    29\ttype Fields = Omit<ResolvedOptions, 'table'>;\n    30\t\n    31\tfunction sameNormalization(before: ResolvedOptions, after: ResolvedOptions): boolean {\n    32\t  const a = before.x;\n    33\t  const b = after.x;\n    34\t  return after.valid && sameTableData(before.table, after.table) && before.series === after.series &&\n    35\t    a.field === b.field && a.type === b.type && a.timeZone === b.timeZone && a.ordered === b.ordered &&\n    36\t    a.label === b.label && a.unit === b.unit && before.values.length === after.values.length &&\n    37\t    before.values.every((field, i) => {\n    38\t      const next = after.values[i]!;\n    39\t      return field.field === next.field && field.label === next.label && field.unit === next.unit &&\n    40\t        field.scale === next.scale && field.missing === next.missing && field.parse === next.parse;\n    41\t    });\n    42\t}\n    43\t\n    44\tinterface Cadence {\n    45\t  last: number;\n    46\t  differences: number;\n    47\t  min: number;\n    48\t  span: number;\n    49\t  matches: number;\n    50\t  multiple: boolean | null;\n    51\t}\n    52\t\n    53\tfunction cadence(): Cadence {\n    54\t  return { last: -Infinity, differences: 0, min: Infinity, span: 0, matches: 0, multiple: true };\n    55\t}\n    56\t\n    57\tfunction step(c: Cadence): number {\n    58\t  return c.multiple && c.differences >= 2 && 2 * c.matches >= c.differences ? c.min : 0;\n    59\t}\n    60\t\n    61\tfunction extend(c: Cadence, axis: XColumn, x: number): void {\n    62\t  const previous = c.last;\n    63\t  c.last = x;\n    64\t  if (previous === -Infinity || !supportsSteps(axis)) return;\n    65\t  const delta = stepDelta(axis, previous, x);\n    66\t  if (delta < c.min && stepMultiple(delta, c.min) !== 1) {\n    67\t    // An irregular prefix only needs a second pass if the smaller step later becomes frequent enough.\n    68\t    c.multiple = c.differences === c.matches ? c.differences === 0 || stepMu