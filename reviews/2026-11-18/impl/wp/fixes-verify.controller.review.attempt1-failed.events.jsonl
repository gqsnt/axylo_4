}\n   528\t\n   529\t  /** Runs a call. A strict rejection propagates; anything else that throws becomes the internal-error state. */\n   530\t  function guarded(run: () => void): void {\n   531\t    if (destroyed) return;\n   532\t    try {\n   533\t      run();\n   534\t      preparing = null;\n   535\t    } catch (error) {\n   536\t      const call = preparing;\n   537\t      preparing = null;\n   538\t      if (error instanceof StrictError) throw error;\n   539\t      // A failure while a call was prepared (a row getter that throws): what the call had found until then is\n   540\t      // kept, with AX199 after it, as validate() reports it; under strict that is a rejection, before the\n   541\t      // accepted chart changes (final review, finding 7).\n   542\t      const before = call?.sink.inputs() ?? [];\n   543\t      if (call?.strict) {\n   544\t        const found = [...before, createDiagnostic('AX199', 'chart-error', {}, 'presentation')];\n   545\t        deliverRejected(found, call.name, call.handler);\n   546\t        throw new StrictError(call.name, toPublic(found, call.name));\n   547\t      }\n   548\t      raiseInternal(error, before);\n   549\t      // A create that failed has nothing to draw from: show the error state now (never a blank box).\n   550\t      if (accepted === null) showInternal(resolveMessages(object(options.current.messages)), chartName(options.current), options.current);\n   551\t      schedule();\n   552\t    }\n   553\t  }\n   554\t\n   555\t  function nextVersion(): { epoch: number; revision: number } {\n   556\t    return { epoch: ++epochs, revision: ++frameRevision };\n   557\t  }\n   558\t\n   559\t  function update(patch: unknown): void {\n   560\t    guarded(() => {\n   561\t      stage('options');\n   562\t      const { next, changed } = options.preview(patch);\n   563\t      const previous = accepted;\n   564\t      const supplied = patch !== null && typeof patch === 'object' && Object.hasOwn(patch, 'data');\n   565\t   