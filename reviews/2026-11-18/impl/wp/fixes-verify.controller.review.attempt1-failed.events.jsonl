const dx = (i: number) => Math.abs((projection?.x.map(entry.x[i]!) ?? entry.x[i]!) - x);\n   116\t    const flatY = projection && (projection.y.range[0] === projection.y.range[1] || projection.y.domain[0] === projection.y.domain[1]);\n   117\t    // Starting at x, only runs whose horizontal distance can still win need a y search.\n   118\t    let right = lowerBound(entry.x, fromX, start, end);\n   119\t    let left = right - 1;\n   120\t    while (left >= start || right < end) {\n   121\t      const leftDistance = left >= start ? dx(left) : Infinity;\n   122\t      const rightDistance = right < end ? dx(right) : Infinity;\n   123\t      const distance = Math.min(leftDistance, rightDistance);\n   124\t      if (distance > best) break;\n   125\t      let lo: number;\n   126\t      let hi: number;\n   127\t      if (leftDistance <= rightDistance && left >= start) {\n   128\t        hi = left + 1;\n   129\t        lo = left > start && entry.x[left] === entry.x[left - 1]\n   130\t          ? lowerBound(entry.x, entry.x[left]!, start, hi) : left;\n   131\t        left = lo - 1;\n   132\t      } else {\n   133\t        lo = right;\n   134\t        hi = right + 1 < end && entry.x[right] === entry.x[right + 1]\n   135\t          ? upperBound(entry.x, entry.x[right]!, right, end) : right + 1;\n   136\t        right = hi;\n   137\t      }\n   138\t      if (lo + 1 === hi || flatY) {\n   139\t        consider(lo, distance);\n   140\t      } else {\n   141\t        const middle = lowerBound(entry.y, fromY, lo, hi);\n   142\t        if (middle < hi) consider(middle, distance);\n   143\t        if (middle > lo) consider(lowerBound(entry.y, entry.y[middle - 1]!, lo, middle), distance);\n   144\t      }\n   145\t    }\n   146\t    return ref(s, nearest);\n   147\t  }\n   148\t\n   149\t  function toRef(point: PointIndex | null): DatumRef | null {\n   150\t    return point ? ref(point.series, point.index) : null;\n   151\t  }\n   152\t\n   153\t  return {\n   154\t    pick(px, py) {\