3\t      const smaller = Math.min(mid - start, end - mid);\n   164\t      const skewed = smaller < (end - start) / 8;\n   165\t      // Keep spatially separated groups together. Consecutive skewed splits need a median to bound depth.\n   166\t      const useSkew = skewed && allowSkew && smaller > 0;\n   167\t      if (skewed && !useSkew) {\n   168\t        order.subarray(start, end).sort((a, b) => positions[a]! - positions[b]!);\n   169\t        mid = start + Math.floor((end - start) / 2);\n   170\t      }\n   171\t      const left = build(start, mid, !useSkew);\n   172\t      const right = build(mid, end, !useSkew);\n   173\t      return { ...bounds, left, right, latest: later(left.latest, right.latest) ? left.latest : right.latest };\n   174\t    }\n   175\t\n   176\t    let end = 0;\n   177\t    for (const [cell, head] of heads) {\n   178\t      const start = end;\n   179\t      let uniform = true;\n   180\t      for (let at = head; at >= 0; at = next[at]!) {\n   181\t        order[end++] = at;\n   182\t        uniform &&= px[at] === px[head] && py[at] === py[head];\n   183\t      }\n   184\t      if (!uniform) order.subarray(start, end).sort((a, b) => px[a]! - px[b]! || py[a]! - py[b]!);\n   185\t\n   186\t      // Group identical positions before splitting the cell, so a median cannot spread them across leaves.\n   187\t      // Keep the latest row as the representative and link the others for the capped tooltip.\n   188\t      let write = start;\n   189\t      for (let i = start; i < end;) {\n   190\t        const first = order[i]!;\n   191\t        const groupStart = i++;\n   192\t        let last = first;\n   193\t        let winner = first;\n   194\t        let beforeWinner = -1;\n   195\t        for (; i < end; i++) {\n   196\t          const at = order[i]!;\n   197\t          if (px[at] !== px[first] || py[at] !== py[first]) break;\n   198\t          next[last] = at;\n   199\t          if (later(at, winner)) {\n   200\t            winner = at;\n   201\t  