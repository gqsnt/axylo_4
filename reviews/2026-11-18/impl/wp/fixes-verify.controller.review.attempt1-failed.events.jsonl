{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"git show bbd7564:packages/axylo/test/core/final-review.test.ts | nl -ba | sed -n '1,360p'\"","aggregated_output":"     1\t/**\n     2\t * The final review of the controller (reviews/2026-11-18/impl/wp/core-final.controller.review.md): its Node\n     3\t * sequences, each as the reviewer ran it through this host stand-in.\n     4\t */\n     5\timport fc from 'fast-check';\n     6\timport { describe, expect, it } from 'vitest';\n     7\timport type { AlignedView, DatumRef } from '../../src/core/contracts';\n     8\timport type { Diagnostic, Point } from '../../src/public';\n     9\timport { lastModel, record, type Recording } from './host';\n    10\t\n    11\tconst rowsOf = (values: readonly number[]) => values.map(x => ({ x, y: x * 10 }));\n    12\tconst ref = (x: number, seriesKey = 'y'): DatumRef => ({ kind: 'aligned', seriesKey, x });\n    13\tconst xsOf = (r: Recording) => Array.from((r.committed!.view as AlignedView).frame.x.values);\n    14\t\n    15\tfunction hoverRow(r: Recording, x: number, seriesKey = 'y'): Point<unknown> | null | undefined {\n    16\t  let seen: Point<unknown> | null | undefined;\n    17\t  const off = r.controller.handle.on('hover', p => { seen = p; });\n    18\t  r.controller.actions.hover(null);\n    19\t  r.controller.actions.hover(ref(x, seriesKey));\n    20\t  r.frames(1);\n    21\t  off();\n    22\t  return seen;\n    23\t}\n    24\t\n    25\tdescribe('final review, finding 1: a frame keeps its source rows through publication', () => {\n    26\t  it('a tick formatter that appends during the frame: the frame draws 3 and hovering 3 gives its row', () => {\n    27\t    let chart: Recording['controller']['handle'] | null = null;\n    28\t    let armed = false;\n    29\t    const tickFormat = (v: number) => {\n    30\t      if (armed && chart) { armed = false; chart.append([{ x: 4, y: 40 }], { keep: 1 }); }\n    31\t      return String(v);\n    32\t    };\n    33\t    const r = record('line', { title: 'T', data: rowsOf([0, 1, 2]), x: 'x', y: { field: 'y', tickFormat } });\n    34\t    chart = r.controller.handle;\n    35\t    r.frames();\n    36\t    chart.append([{ x: 3, y: 30 }], { keep: 1 });\n    37\t    armed = true;\n    38\t    r.frames(1);\n    39\t    // What the first frame after the append drew, it can describe: its row is still there.\n    40\t    const shownXs = xsOf(r);\n    41\t    const x = shownXs[shownXs.length - 1]!;\n    42\t    const point = hoverRow(r, x);\n    43\t    expect(point?.row).toEqual({ x, y: x * 10 });\n    44\t    r.frames();\n    45\t    expect(xsOf(r)).toEqual([4]);\n    46\t  });\n    47\t\n    48\t  it('no author callback runs once a frame has started writing: tick and value formatters run before the first write', () => {\n    49\t    const calls: string[] = [];\n    50\t    let writes = 0;\n    51\t    const r = record('line', {\n    52\t      title: 'T', data: rowsOf([0, 1, 2]), x: 'x',\n    53\t      y: { field: 'y', tickFormat: (v: number) => { calls.push(`tick@${writes}`); return String(v); }, format: (v: number) => { calls.push(`value@${writes}`); return String(v); } },\n    54\t    });\n    55\t    const draws = () => r.models.length + r.draws.length + r.commits;\n    56\t    r.frames();\n    57\t    writes = draws();\n    58\t    calls.length = 0;\n    59\t    // A title update: everything the frame needs from the author is computed before the figure is written.\n    60\t    r.controller.handle.update({ title: 'U', data: rowsOf([5, 6, 7]) });\n    61\t    const before = draws();\n    62\t    let first: number | null = null;\n    63\t    const original = r.host.figure.update;\n    64\t    (r.host.figure as { update: typeof original }).update = model => { first ??= calls.length; return original(model); };\n    65\t    r.frames();\n    66\t    expect(draws()).toBeGreaterThan(before);\n    67\t    // Every formatter call came before the first host write of the frame.\n    68\t    expect(first).not.toBeNull();\n    69\t    expect(calls.length).toBe(first);\n    70\t  });\n    71\t\n    72\t  it('a stage failing after a callback changed the chart mid-publication does not put the newer update into AX199', () => {\n    73\t    let once = true;\n    74\t    const r = record('line', { title: 'A', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' }, {\n    75\t      onCommit: (_state, controller) => {\n    76\t        if (!once) return;\n    77\t        once = false;\n    78\t        controller.handle.update({ title: 'B' });\n    79\t        throw new Error('the interaction layer failed after the update');\n    80\t      },\n    81\t    });\n    82\t    r.frames();\n    83\t    expect(r.controller.handle.diagnostics.map(d => d.code)).not.toContain('AX199');\n    84\t    expect(lastModel(r).title?.text).toBe('B');\n    85\t    expect(lastModel(r).message).toBeNull();\n    86\t  });\n    87\t\n    88\t  it('destroy() from a hover listener while the frame commits: nothing is published after it, the data is let go', () => {\n    89\t    let destroyedAt = -1;\n    90\t    const r = record('line', { title: 'D', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' }, {\n    91\t      onCommit: (_state, controller) => controller.actions.hover(ref(1)),\n    92\t    });\n    93\t    r.controller.handle.on('hover', () => { destroyedAt = r.commits; r.controller.handle.destroy(); });\n    94\t    r.frames();\n    95\t    expect(destroyedAt).toBeGreaterThan(0);\n    96\t    expect(r.disposed).toBe(1);\n    97\t    expect(r.writesAfterDispose).toBe(0);\n    98\t    expect(r.controller.handle.__dev?.retainedRows()).toBe(0);\n    99\t  });\n   100\t});\n   101\t\n   102\tdescribe('final review, finding 2: keep bounds retention while paused', () => {\n   103\t  it('paused before the frame of an append, 500 more appends with keep 1 and no frames: a bounded store', () => {\n   104\t    const r = record('line', { title: 'K', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n   105\t    r.frames();\n   106\t    r.controller.handle.append([{ x: 2, y: 20 }], { keep: 1 });\n   107\t    r.controller.actions.pause(true);\n   108\t    for (let x = 3; x <= 503; x++) r.controller.handle.append([{ x, y: x }], { keep: 1 });\n   109\t    // Twice what was on screen (two rows) plus the slack of 8, at most: then the frames copy their rows.\n   110\t    expect(r.controller.handle.__dev?.retainedRows()).toBeLessThanOrEqual(12);\n   111\t  });\n   112\t\n   113\t  it('paused with 2 on screen, a frame after every append with keep 1: a bounded store', () => {\n   114\t    const r = record('line', { title: 'K', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n   115\t    r.frames();\n   116\t    r.controller.handle.append([{ x: 2, y: 20 }], { keep: 1 });\n   117\t    r.frames();\n   118\t    r.controller.actions.pause(true);\n   119\t    for (let x = 3; x <= 503; x++) {\n   120\t      r.controller.handle.append([{ x, y: x }], { keep: 1 });\n   121\t      r.frames();\n   122\t    }\n   123\t    // Twice what was on screen (two rows) plus the slack of 8, at most: then the frames copy their rows.\n   124\t    expect(r.controller.handle.__dev?.retainedRows()).toBeLessThanOrEqual(12);\n   125\t    // The paused screen still shows 2, with its row.\n   126\t    expect(xsOf(r)).toEqual([2]);\n   127\t    expect(hoverRow(r, 2)?.row).toEqual({ x: 2, y: 20 });\n   128\t  });\n   129\t});\n   130\t\n   131\tdescribe('final review, finding 3: an append after a failed Resume supersedes the held revision', () => {\n   132\t  it('display 2, pause, append 3, Resume fails, append 4, draw; a title update keeps 4 on screen with its row', () => {\n   133\t    const r = record('line', { title: 'R', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n   134\t    r.frames();\n   135\t    r.controller.handle.append([{ x: 2, y: 20 }], { keep: 1 });\n   136\t    r.frames();\n   137\t    r.controller.actions.pause(true);\n   138\t    r.controller.handle.append([{ x: 3, y: 30 }], { keep: 1 });\n   139\t    r.controller.handle.__dev!.fail('view');\n   140\t    r.controller.actions.pause(false);\n   141\t    r.controller.handle.__dev!.fail(null);\n   142\t    r.frames();\n   143\t    r.controller.handle.append([{ x: 4, y: 40 }], { keep: 1 });\n   144\t    r.frames();\n   145\t    expect(xsOf(r)).toEqual([4]);\n   146\t    r.controller.handle.update({ title: 'R2' });\n   147\t    r.frames();\n   148\t    expect(xsOf(r)).toEqual([4]);\n   149\t    expect(hoverRow(r, 4)?.row).toEqual({ x: 4, y: 40 });\n   150\t    const ax199 = r.controller.handle.diagnostics.filter((d: Diagnostic) => d.code === 'AX199');\n   151\t    expect(ax199).toEqual([]);\n   152\t  });\n   153\t});\n   154\t\n   155\tdescribe('final review, finding 11: a cached layout keeps its findings', () => {\n   156\t  it('a throwing y tick formatter: AX160 and the note survive a loading state and its end at the same size', () => {\n   157\t    const tickFormat = () => { throw new Error('tick'); };\n   158\t    const r = record('line', { title: 'C', data: rowsOf([0, 1, 2]), x: 'x', y: { field: 'y', tickFormat } });\n   159\t    r.frames();\n   160\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX160');\n   161\t    r.controller.handle.update({ state: 'loading' });\n   162\t    r.frames();\n   163\t    r.controller.handle.update({ state: undefined });\n   164\t    r.frames();\n   165\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX160');\n   166\t    expect(lastModel(r).note).toMatch(/shown differently|changed/i);\n   167\t  });\n   168\t});\n   169\t\n   170\tdescribe('final review, finding 12: temporal inputs are snapshots; emitted windows round-trip', () => {\n   171\t  const t = Date.UTC(2026, 0, 1);\n   172\t  const day = 86_400_000;\n   173\t  const data = [0, 1, 2, 3, 4].map(i => ({ x: new Date(t + i * day), y: i }));\n   174\t\n   175\t  it('a Date in x.domain mutated and resubmitted takes effect', () => {\n   176\t    const from = new Date(t);\n   177\t    const x = { field: 'x', domain: [from, new Date(t + 4 * day)] };\n   178\t    const r = record('line', { title: 'D', data, x, y: 'y' });\n   179\t    r.frames();\n   180\t    from.setTime(t + 2 * day);\n   181\t    r.controller.handle.update({ x });\n   182\t    r.frames();\n   183\t    expect((r.committed!.view as AlignedView).xDomain[0]).toBe(t + 2 * day);\n   184\t  });\n   185\t\n   186\t  it('a Date passed to zoom() and mutated later does not move the window', () => {\n   187\t    const r = record('line', { title: 'Z', data, x: 'x', y: 'y' });\n   188\t    r.frames();\n   189\t    const start = new Date(t + day);\n   190\t    r.controller.handle.zoom([start, new Date(t + 3 * day)]);\n   191\t    r.frames();\n   192\t    start.setTime(t);\n   193\t    r.controller.handle.update({ reference: [{ y: 1, label: 'R' }] });\n   194\t    r.frames();\n   195\t    expect((r.committed!.view as AlignedView).xDomain).toEqual([t + day, t + 3 * day]);\n   196\t  });\n   197\t\n   198\t  it('a window between milliseconds is emitted as numbers, which another chart reads as the same window', () => {\n   199\t    const r = record('line', { title: 'Z', data, x: 'x', y: 'y' });\n   200\t    r.frames();\n   201\t    let window: unknown = null;\n   202\t    r.controller.handle.on('zoom', w => { window = w; });\n   203\t    r.controller.actions.zoom([t + 0.25, t + 0.75]);\n   204\t    r.frames();\n   205\t    expect(window).toEqual([t + 0.25, t + 0.75]);\n   206\t    const other = record('line', { title: 'O', data, x: 'x', y: 'y' });\n   207\t    other.frames();\n   208\t    other.controller.handle.zoom(window as never);\n   209\t    other.frames();\n   210\t    expect((other.committed!.view as AlignedView).xDomain).toEqual([t + 0.25, t + 0.75]);\n   211\t  });\n   212\t});\n   213\t\n   214\tdescribe('final review, finding 13: zoom on a compact chart is a reported no-op', () => {\n   215\t  for (const kind of ['line', 'area', 'bar'] as const) {\n   216\t    it(`${kind}: no event, AX150, and nothing applied when compact is turned off`, () => {\n   217\t      const seen: string[] = [];\n   218\t      const r = record(kind, { title: 'C', compact: true, data: rowsOf([0, 1, 2, 3, 4]), x: 'x', y: 'y', onDiagnostic: (d: Diagnostic) => seen.push(d.code) });\n   219\t      r.frames();\n   220\t      let events = 0;\n   221\t      r.controller.handle.on('zoom', () => { events++; });\n   222\t      r.controller.handle.zoom([1, 3]);\n   223\t      r.frames();\n   224\t      expect(events).toBe(0);\n   225\t      expect(seen).toContain('AX150');\n   226\t      r.controller.handle.update({ compact: false });\n   227\t      r.frames();\n   228\t      const view = r.committed!.view as AlignedView;\n   229\t      expect(view.xDomain).toEqual(view.xFull);\n   230\t    });\n   231\t  }\n   232\t});\n   233\t\n   234\tdescribe('final review, finding 14: a watcher that fails part-way leaves nothing registered', () => {\n   235\t  it('the theme observer\\'s observe() throws after its three media listeners registered: all three are removed', async () => {\n   236\t    const { watchTheme } = await import('../../src/theme/watch');\n   237\t    const live = new Set<unknown>();\n   238\t    const list = () => ({\n   239\t      addEventListener: (_: string, fn: unknown) => { live.add(fn); },\n   240\t      removeEventListener: (_: string, fn: unknown) => { live.delete(fn); },\n   241\t    });\n   242\t    const win = {\n   243\t      matchMedia: () => list(),\n   244\t      MutationObserver: class { observe() { throw new Error('observe failed'); } disconnect() {} },\n   245\t    };\n   246\t    const doc = { defaultView: win, documentElement: {} };\n   247\t    const element = { ownerDocument: doc, getRootNode: () => doc };\n   248\t    expect(() => watchTheme(element as unknown as Element, () => {})).toThrow(/observe failed/);\n   249\t    expect(live.size).toBe(0);\n   250\t  });\n   251\t});\n   252\t\n   253\tdescribe('final review, finding 9 and decision 0004 revision 3, rule 5: three readout modes', () => {\n   254\t  const modeOf = (r: Recording) => (r.prepared.at(-1) as unknown as { readoutMode?: string }).readoutMode;\n   255\t  it('a 330 × 205 container: a 92 px plot cannot spare a strip and stay at 80 px, so no readout at all (not floating)', () => {\n   256\t    const r = record('line', { title: 'S', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' }, { container: { width: 330, height: 205 } });\n   257\t    r.frames();\n   258\t    const layout = r.layout!;\n   259\t    if (layout.kind !== 'plot') throw new Error('expected a plot');\n   260\t    expect(layout.plot.height).toBeLessThan(140);\n   261\t    expect(modeOf(r)).toBe('none');\n   262\t    expect(r.prepared.at(-1)!.readout).toBe(false);\n   263\t  });\n   264\t\n   265\t  it('a plot under 140 px that keeps 80 px beside the strip reserves the strip', () => {\n   266\t    const r = record('line', { title: 'S', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' }, { container: { width: 600, height: 250 } });\n   267\t    r.frames();\n   268\t    const layout = r.layout!;\n   269\t    if (layout.kind !== 'plot') throw new Error('expected a plot');\n   270\t    expect(layout.plot.height).toBeLessThan(140);\n   271\t    expect(layout.plot.height).toBeGreaterThanOrEqual(80 + 40);\n   272\t    expect(modeOf(r)).toBe('strip');\n   273\t    expect(r.prepared.at(-1)!.readout).toBe(true);\n   274\t  });\n   275\t\n   276\t  it('a large plot floats', () => {\n   277\t    const r = record('line', { title: 'S', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' }, { container: { width: 720, height: 400 } });\n   278\t    r.frames();\n   279\t    expect(modeOf(r)).toBe('floating');\n   280\t  });\n   281\t});\n   282\t\n   283\tdescribe('final review, finding 15 and amended F7: which axes follow the first-tick rule', () => {\n   284\t  it('a line on x 1.1 to 8.9 spans exactly its data (x is not a value axis)', () => {\n   285\t    const r = record('line', { title: 'L', data: [{ x: 1.1, y: 1 }, { x: 8.9, y: 2 }], x: 'x', y: 'y' });\n   286\t    r.frames();\n   287\t    expect((r.committed!.view as AlignedView).xDomain).toEqual([1.1, 8.9]);\n   288\t  });\n   289\t\n   290\t  it('a scatter on x 1.1 to 8.9: the x domain ends at its first and last drawn ticks, which reach the data', () => {\n   291\t    const r = record('scatter', { title: 'S', data: [{ x: 1.1, y: 1 }, { x: 8.9, y: 2 }], x: 'x', y: 'y' });\n   292\t    r.frames();\n   293\t    const layout = r.layout!;\n   294\t    if (layout.kind !== 'plot' || layout.projection.kind !== 'xy' || layout.projection.x.type === 'band') throw new Error('expected a plot');\n   295\t    const [a, b] = layout.projection.x.domain;\n   296\t    const ticks = layout.xTicks.map(t => t.value);\n   297\t    expect(a).toBeLessThanOrEqual(1.1);\n   298\t    expect(b).toBeGreaterThanOrEqual(8.9);\n   299\t    expect(ticks[0]).toBe(a);\n   300\t    expect(ticks.at(-1)).toBe(b);\n   301\t    // The lookup reads the same projection: the leftmost point is at the domain's place for 1.1.\n   302\t    expect(ticks.find(t => t >= 8.9)).toBe(b);\n   303\t    expect([...ticks].reverse().find(t => t <= 1.1)).toBe(a);\n   304\t  });\n   305\t});\n   306\t\n   307\tdescribe('eighth pass: what describe() reports is what was drawn', () => {\n   308\t  it('a short wide tile whose layout widens the automatic y domain: describe() gives the drawn domain', () => {\n   309\t    const data = Array.from({ length: 40 }, (_, i) => ({ x: i, y: 80 + (i * 37) % 100 }));\n   310\t    const r = record('line', { title: 'Tile', data, x: 'x', y: 'y' }, { container: { width: 1200, height: 180 } });\n   311\t    r.frames();\n   312\t    const layout = r.layout!;\n   313\t    if (layout.kind !== 'plot' || layout.projection.kind !== 'xy') throw new Error('expected a plot');\n   314\t    // The case the harness met: the drawn domain is not the view's (F7 widened it for the short plot).\n   315\t    expect(layout.projection.y.domain).not.toEqual((r.committed!.view as AlignedView).yDomain);\n   316\t    const d = r.controller.handle.__bench!.describe() as { yDomain: readonly number[] | null; plot?: { height: number } | null };\n   317\t    expect(d.yDomain).toEqual(layout.projection.y.domain);\n   318\t    expect(d.plot?.height).toBe(layout.plot.height);\n   319\t  });\n   320\t\n   321\t  it('describe() gives the drawn runs and the basis of kept indexes; memory() lists the chart\\'s own buffers', () => {\n   322\t    const data = [0, 1, 2, 3, 4, 5].map(x => ({ x, y: x === 3 ? null : x }));\n   323\t    const r = record('line', { title: 'Runs', data, x: 'x', y: 'y' });\n   324\t    r.frames();\n   325\t    const bench = r.controller.handle.__bench as unknown as {\n   326\t      describe(): { series: { kept?: number[]; breaks?: number[]; keptBasis?: string; isolatedMarkers?: boolean }[] };\n   327\t      memory(): { bytes: number; buffers: { name: string; bytes: number }[] };\n   328\t    };\n   329\t    const s = bench.describe().series[0]!;\n   330\t    expect(s.kept).toEqual([0, 1, 2, 4, 5]);\n   331\t    expect(s.breaks).toEqual([3]);\n   332\t    expect(s.keptBasis).toBe('rows');\n   333\t    const m = bench.memory();\n   334\t    expect(m.bytes).toBeGreaterThan(0);\n   335\t    expect(m.buffers.reduce((a, b) => a + b.bytes, 0)).toBe(m.bytes);\n   336\t  });\n   337\t});\n   338\t\n   339\tdescribe('final review, finding 7: a call that fails part-way agrees with validate() and with strict', () => {\n   340\t  const bad = () => [{ get x(): number { throw new Error('getter'); }, y: 1 }, { x: 2, y: 2 }];\n   341\t  for (const kind of ['line', 'area', 'bar', 'scatter'] as const) {\n   342\t    it(`${kind}: an unknown option and a throwing x getter: AX150 then AX199, as validate() says`, async () => {\n   343\t      const { staticDiagnostics } = await import('../../src/core/stages');\n   344\t      const options = { title: 'V', palete: 'x', data: bad(), x: 'x', y: 'y' };\n   345\t      const expected = staticDiagnostics(kind, options, 'UTC').map(d => d.code);\n   346\t      expect(expected).toEqual(['AX150', 'AX199']);\n   347\t      const r = record(kind, options);\n   348\t      r.frames();\n   349\t      expect(r.controller.handle.diagnostics.map(d => d.code)).toEqual(expected);\n   350\t    });\n   351\t  }\n   352\t\n   353\t  it('strict: create with them throws, and a strict update with a throwing getter keeps the last good chart', () => {\n   354\t    expect(() => record('line', { title: 'S', strict: true, palete: 'x', data: bad(), x: 'x', y: 'y' })).toThrow();\n   355\t    const r = record('line', { title: 'Good', strict: true, data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   356\t    r.frames();\n   357\t    expect(() => r.controller.handle.update({ title: 'Bad', data: bad() })).toThrow();\n   358\t    r.frames();\n   359\t    expect(lastModel(r).title?.text).toBe('Good');\n   360\t    expect(lastModel(r).message).toBeNull();\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"git show bbd7564:docs/02-product-spec.md | nl -ba | sed -n '148,213p;218,253p'\ngit show bbd7564:packages/axylo/src/core/contracts.ts | nl -ba | sed -n '55,195p;611,650p'\ngit show bbd7564:scripts/size.mjs | nl -ba | sed -n '1,160p'\"","aggregated_output":"   148\t### 3.5 Diagnostic registry\n   149\t\n   150\tLevel decides delivery. **Error**: the chart or a series cannot be drawn; the chart shows its error state. **Warning**: something is not drawn as given; the reader sees the note in F12. **Hint**: advice for the author. Errors and warnings print once per code per page in every build; hints print in development builds only. `strict: true` throws on errors and warnings found while validating a create, `update` or `append` call, synchronously from that call. A diagnostic that can only arise later (a contrast check after the page's CSS changes, a custom formatter that throws when a table page is built, a label that stops fitting after a resize) is reported when it is found and is never thrown. Every diagnostic names the chart; those about data name the field and the first row indexes in the caller's own data.\n   151\t\n   152\t| Code | Level | Condition | What is drawn |\n   153\t|---|---|---|---|\n   154\t| AX100 | Error | Typed columns have different lengths | Error state; the message names the columns and their lengths |\n   155\t| AX101 | Error | A named field is not a key of any row | Error state; the message lists the keys that exist and the closest match |\n   156\t| AX102 | Warning | A field is absent (`undefined`) in some rows | Gaps |\n   157\t| AX103 | Warning | A value is `NaN` or infinite | Gap |\n   158\t| AX104 | Hint | Every non-missing value of a value field is a plain decimal string (`'40'`, `'-1.5'`) | Parsed and drawn; the message suggests `parse: 'number'`. An empty string counts as missing |\n   159\t| AX105 | Hint | Steps are absent on a regular time, date, wall-clock or number axis | Gaps. When a series would need more absent steps than twice its observations (and more than 1,000), it is treated as irregular instead: no gaps are created and the hint says so |\n   160\t| AX106 | Warning | A value field mixes numbers with strings, or holds strings that are not plain decimals (`'1,234'`, `'n/a'`) | The strings are not drawn |\n   161\t| AX107 | Warning | A date or time cannot be parsed | That row is not drawn |\n   162\t| AX108 | Error | Duplicate x within a series, or duplicate donut labels | That series, or the donut, is not drawn |\n   163\t| AX109 | Hint | Numbers on an axis declared `time` look like seconds, or a numeric x looks like epoch milliseconds without `type: 'time'` | As declared |\n   164\t| AX110 | Warning | An author domain on bar or area excluded zero | Domain widened to zero |\n   165\t| AX111 | Hint | Instants look like calendar dates | As instants, zone shown |\n   166\t| AX112 | Hint | Date-time strings have no offset | As written |\n   167\t| AX120 | Error | Negative donut value | Error state |\n   168\t| AX121 | Warning | More than eight donut slices | Seven largest plus \"Other (n)\" |\n   169\t| AX130 | Warning | More than eight series | All series, with dash or marker differences |\n   170\t| AX140 | Warning | No `title` and no `labelledBy` | Generated name |\n   171\t| AX141 | Warning | Palette below 3:1 on the resolved background | As themed |\n   172\t| AX142 | Hint | Plot too small to draw | Summary and table control |\n   173\t| AX143 | Hint | Labels hidden after every remedy | Note shown to the reader |\n   174\t| AX150 | Warning | Unknown option key | Ignored; the message suggests the closest known key |\n   175\t| AX151 | Warning | `append` rows out of order | Accepted through the slower full update |\n   176\t| AX131 | Hint | A compact chart has more than one series | Drawn, with dash differences |\n   177\t| AX132 | Hint | More bars than pixels along the category axis | Drawn; the message suggests aggregating |\n   178\t| AX133 | Hint | A scatter chart has more than 50,000 points | Drawn; the message says drawing may be slow |\n   179\t| AX134 | Error | Series × x positions exceeds 20,000,000 (long rows with many series and little shared x) | Error state; the message gives both counts and suggests fewer series or a scatter chart |\n   180\t| AX152 | Warning | `timeZone` is not a zone the browser knows | The viewer's zone is used |\n   181\t| AX160 | Warning | A custom formatter threw | The default format is used for that value |\n   182\t| AX199 | Error | Axylo itself failed while building the chart | Error state with a generic message; the error is passed to `onDiagnostic` and printed |\n   183\t\n   184\tExpected results for the Phase 1 fixtures: the combined `dirty` fixture (`[10, 20, null, NaN, '40', undefined, 70]`) yields AX102, AX103 and AX106 once each, draws Mon–Tue as a segment and Sun as a point, and shows the F12 note. `dirty-string` (one `'40'` among numbers) yields AX106. A column made only of numeric strings yields AX104 and is drawn in full. `dirty-null` yields nothing.\n   185\t\n   186\tThe split between AX104 and AX106 answers a reviewer's objection that common back ends return counts as strings (Postgres `bigint` and `numeric`, BigQuery): a whole column of plain decimal strings is unambiguous and is parsed; a stray string among numbers is a bug and is not.\n   187\t\n   188\t### 3.6 Type matrix\n   189\t\n   190\t| | Line | Area | Bar | Donut | Scatter |\n   191\t|---|---|---|---|---|---|\n   192\t| Picking by pointer | Nearest x | Nearest x | The band under the pointer | The slice under the pointer | Nearest point within 24 px; ties go to the later row |\n   193\t| Tooltip content | Every visible series at that x | Same, plus the stack total | Every series in that category | Label, value, percentage | The point's series, x and y; coincident points listed, up to eight |\n   194\t| Keyboard order | By x, then series | By x, then series | By category, then series | By slice order | By x, then y |\n   195\t| Zoom | On time, date and numeric x only | On time, date and numeric x only | On time, date and numeric x only | No | Yes, both axes later; x only in 1.0 |\n   196\t| Simplified drawing when dense | F5 | F5 on cumulative sums | No; more bars than pixels raises a hint | No | No in 1.0; above 50,000 points a hint says drawing may be slow |\n   197\t| Limit that raises a diagnostic | Eight series | Eight series | Eight series | Eight slices | Eight series |\n   198\t| Reference lines and bands | Yes; included in the domain; listed in the summary and table caption | Yes | Yes | No | Yes |\n   199\t\n   200\t### 3.7 Compact variant\n   201\t\n   202\t`compact: true` on line, area and bar draws the marks and nothing else: no axes, gridlines, legend, toolbar, table control, zoom or tooltip. It is for a small tile where the page already shows the number and the label.\n   203\t\n   204\t| ID | Criterion | Verified by |\n   205\t|---|---|---|\n   206\t| C1 | A compact chart is a static image with a full text alternative: `role=\"img\"`, an accessible name (as in A1, including AX140 when none is given) and the generated summary as its description (series, x range, minimum, maximum, last value, omissions). It has no tab stop and no pointer-only behavior, so nothing is available to a mouse that is not available to a keyboard. | Accessibility-tree snapshot; a page of 40 has zero added tab stops |\n   207\t| C2 | The fidelity rules still hold: zero baseline for bar and area (F1), gaps (F2), diagnostics (F3), simplified drawing (F5), sorting (F11), no motion (I5), scheme from the page (L4). | The same fixtures as the full charts |\n   208\t| C3 | It fills its container at any size from 24×16 CSS px up; with no definite height it is 32 px tall. | Size tests |\n   209\t| C4 | With more than one series, lines differ by dash as well as color, since there is no legend; AX131 suggests one series per compact chart. | Two-series fixture |\n   210\t| C5 | When values were left out (F12), the description says so and a small marker with a text equivalent appears in the corner. | `dirty` fixture in compact mode |\n   211\t\n   212\tA compact chart does not give access to every value; the summary is its alternative. An author who needs every value reachable uses the full chart.\n   213\t\n   218\t## 4. Acceptance criteria: the developer's experience\n   219\t\n   220\t| ID | Criterion | Verified by | Driven by |\n   221\t|---|---|---|---|\n   222\t| DX1 | The first chart takes ten lines or fewer, including import, by npm and by script tag. No required option besides data and fields. | Two CI tests that render the documented snippet from the packed distribution | D1 |\n   223\t| DX2 | One logical table, three ways to pass it: long rows, wide rows, typed columns. The three forms of each fixture produce the same normalized data and the same diagnostics, with row indexes in the caller's own form. | Equivalence tests | D2 |\n   224\t| DX3 | With typed rows, a misspelled field, a text field on a value axis, wide `y` combined with `series`, and an option that does not apply to the chart type all fail to compile. At run time, for untyped rows, the same mistakes raise AX101, AX106 and AX150. | [docs/api/examples.ts](api/examples.ts) compiles and each marked mistake fails (already checked with TypeScript 7.0.2); runtime tests per code | D5 |\n   225\t| DX4 | Diagnostics follow the registry in section 3.5: stable code, chart name, field and rows where they apply, the fix, and a documentation page per code. | Message snapshots; link checker | R5, D5 |\n   226\t| DX5 | Three methods change a chart: `update` changes options, `append` adds rows, `zoom` sets the view. They apply in call order. Validation and diagnostics are synchronous; drawing is deferred to the next frame; marks, labels, hit testing and the accessibility layer always switch to a new state together. `destroy()` releases everything and cancels pending work. No `resize()` exists. | Sequence tests: replace then append then zoom in one turn; a rejected `strict` update leaves the last valid chart; destroy before the frame; 1,000 create–destroy cycles show no heap growth trend (P7) | D3, R16 |\n   227\t| DX6 | Colors, font and spacing are CSS custom properties with documented names; the chart inherits `font-family` and `color`. `colors` pins a color to a series name so the same series has the same color on every chart. There is no theme object and no positional palette option. | Theming tests, including a 24-tile page where series subsets differ | R10 |\n   228\t| DX7 | Zero runtime dependencies (reconsidered only with a measured comparison). Size targets, set by the owner on 2026-11-18 after measurement: 96 KiB gzipped for everything and 80 KiB for a page that uses only `line`, CSS included. (The first targets, 40 and 25 KiB, were written before anything was built; an analysis of the built library showed they cannot hold the accessibility layer, the table, diagnostics, three kinds of time and streaming: `reviews/2026-11-18/impl/wp/size.analysis.md`.) | size-limit in CI on the packed distribution | D4 |\n   229\t| DX8 | Importing in Node without a DOM does not throw, and `validate()` runs there. Creating, destroying and creating again on the same element works and leaks nothing (the sequence a framework's strict or development mode produces). Works under a Content Security Policy without `unsafe-inline` or `unsafe-eval`, served with real headers. Labels and formatter output are inserted as text, never as HTML. A target that matches no element throws an error that names the selector. | CI tests | D1 |\n   230\t| DX9 | Semantic versioning. A deprecated API keeps working for at least one minor release and six months. At most one major version a year. The previous release's documented examples still compile and run against each release candidate. | Release policy; API report diff; upgrade test | D6 |\n   231\t| DX10 | Every runnable example in the documentation is compiled and rendered in CI from the packed distribution. | Docs build | D1 |\n   232\t| DX11 | MIT license for everything, including zoom and accessibility. Third-party notices are verified at release. | Repository; release check | D7 |\n   233\t| DX12 | A coding agent gets the first chart right. Given fixed prompts and trap fixtures (UTC-midnight ISO dates, numeric strings, unsorted rows, missing days, a misspelled field), an agent with only the published docs produces a chart with no error diagnostics that passes the reader criteria. Recorded as agent rehearsal, not as user evidence. | Scripted rehearsal at each release | D1, 1.2 |\n   234\t\n   235\t## 5. Performance budgets\n   236\t\n   237\tThese numbers are provisional. They are design targets taken from Phase 1's order-of-magnitude measurements, and they become release gates only after the benchmark harness built in M0 has measured a working Axylo slice in M1 and the limits have been recalibrated and frozen (plan, M1 and M6). Each budget names its workload, metric and statistic so that two people measuring the same build get the same verdict.\n   238\t\n   239\t| ID | Workload | Metric | Statistic | Provisional limit | Phase 1 reference |\n   240\t|---|---|---|---|---|---|\n   241\t| P1 | `trend` (3×120), default options, reference desktop | Main-thread task time from the call until the chart is complete | Median of 20 runs | 10 ms | Not comparable across libraries below about 35 ms with the Phase 1 method |\n   242\t| P2 | One series, 100,000 and 1,000,000 points, typed columns | Same | Median of 20 | 60 ms and 250 ms | See 01, section 5.3: uPlot and tuned Chart.js are the fastest measured |\n   243\t| P3 | 600-point window, one appended point per display frame at 60 Hz, driven by an independent clock | Main-thread task time per update (per run: task time in the window divided by the number of updates); and frames later than 25 ms | Median over runs; count per 300 frames | 2 ms; 0 | See 01, section 5.3 |\n   244\t| P4 | Pointer moved across a 100,000-point chart | Time from input to the frame showing the matching readout | 95th percentile | One frame (16.7 ms at 60 Hz) | Not measured in Phase 1 |\n   245\t| P5 | 24 `trend` charts created on one page, each tile 340 × 200 px | Total main-thread task time | Median of 20 | 200 ms | Not measured in Phase 1 |\n   246\t| P6 | Download | Minified and gzipped bytes, CSS included | Exact | DX7 | 01, section 1.4 |\n   247\t| P8 | 40 compact charts created on one page, each 160 × 48 px with one series | Total main-thread task time | Median of 20 | 80 ms | Not measured in Phase 1 |\n   248\t| P7 | Memory | Bytes owned by Axylo beyond the caller's columns for 1,000,000 points; heap trend over 1,000 create–destroy cycles | Measured after forced collection | At most 1× the size of the caller's two columns; no upward slope | Not measured in Phase 1 |\n   249\t\n   250\tThree rules hold whatever the numbers become:\n   251\t\n   252\t1. Budgets apply to default options. Finding D8 showed libraries that are fast only for authors who know which options to set.\n   253\t2. Budgets are absolute, on named hardware profiles. Comparison libraries, uPlot above all, are measured in the same runs and published beside Axylo, but a ratio to another library is not a gate: it would reward leaving out work that library does not do.\n    55\t\n    56\t/** State of one slot of an aligned series. */\n    57\texport const SLOT_VALUE = 0;         // a finite number\n    58\texport const SLOT_NULL = 1;          // explicit null (or NaN in a typed column, or an empty string): \"no data\", silent\n    59\texport const SLOT_INVALID = 2;       // present but not plottable (NaN or infinity in a row, a stray string): reported\n    60\texport const SLOT_NO_ROW = 3;        // this series has no observation at this x and none was expected; neighbours may be joined across it\n    61\texport const SLOT_GAP = 4;           // an expected step of this series is absent (AX105): never joined across\n    62\texport const SLOT_ABSENT_FIELD = 5;  // the row exists but the field's key is absent or undefined (AX102)\n    63\texport type SlotState = 0 | 1 | 2 | 3 | 4 | 5;\n    64\t/**\n    65\t * `missing: 'zero'` on a value field is applied by normalization: slots that would be SLOT_NULL, SLOT_NO_ROW,\n    66\t * SLOT_GAP or SLOT_ABSENT_FIELD become SLOT_VALUE with y = 0 and row = -1. SLOT_INVALID is never turned into zero.\n    67\t */\n    68\t\n    69\t/** Half-open range of indexes. */\n    70\texport interface IndexRange { readonly start: number; readonly end: number }\n    71\t\n    72\texport interface XColumn {\n    73\t  readonly kind: XKind;\n    74\t  /** Strictly ascending positions, one per slot. For 'category': 0, 1, 2, … */\n    75\t  readonly values: Float64Array;\n    76\t  /** For 'category': the name of each position. Otherwise null. */\n    77\t  readonly categories: readonly string[] | null;\n    78\t  /** For 'time': the resolved IANA zone ('UTC', 'America/Los_Angeles', …; 'local' is resolved before it gets here). Otherwise null. */\n    79\t  readonly timeZone: string | null;\n    80\t  /** For 'date': the precision the values were written in ('2026-02' is a month); the finest one if they are mixed. Otherwise null. */\n    81\t  readonly dateUnit: 'day' | 'month' | 'year' | null;\n    82\t  /** For 'category': true when the author declared the categories ordered, so the axis may be thinned (spec L1). */\n    83\t  readonly ordered: boolean;\n    84\t}\n    85\t\n    86\t/** The caller's data behind a frame, for events and for the table's provenance. */\n    87\texport interface RowSource {\n    88\t  /** The caller's row at a source index (materialized on demand for typed columns), or null if it is no longer retained. */\n    89\t  rowAt(sourceIndex: number): unknown;\n    90\t}\n    91\t\n    92\t/** One series of an aligned frame: a y value and a state for every x slot. */\n    93\texport interface Series {\n    94\t  /** Stable identity: the series value (long form) or the field name (wide form). Used for colors and toggling. */\n    95\t  readonly key: string;\n    96\t  /** Name shown to the reader. */\n    97\t  readonly label: string;\n    98\t  /** The value field this series was read from, for diagnostics. */\n    99\t  readonly field: string;\n   100\t  readonly unit: string | null;\n   101\t  readonly valueScale: 'percent' | 'ratio' | null;\n   102\t  /** False when the series cannot be drawn (duplicate x, AX108). It stays in the frame so the table and summary can say so. */\n   103\t  readonly drawable: boolean;\n   104\t  /** y per slot. NaN wherever `slot` is not SLOT_VALUE. May be a view on the caller's typed column. */\n   105\t  readonly y: Float64Array | Float32Array;\n   106\t  readonly slot: Uint8Array;\n   107\t  /** Index of the caller's row each slot came from, -1 where there is none. null means \"slot i came from row i\" (typed columns). */\n   108\t  readonly row: Int32Array | null;\n   109\t}\n   110\t\n   111\t/** One series of a point frame (scatter): its own x and y, sorted by x then y. */\n   112\texport interface PointSeries {\n   113\t  readonly key: string;\n   114\t  readonly label: string;\n   115\t  readonly drawable: boolean;\n   116\t  readonly x: Float64Array;\n   117\t  readonly y: Float64Array;\n   118\t  readonly row: Int32Array | null;\n   119\t  /**\n   120\t   * Observations that have a valid x and no plottable y: null, an absent field, or a value that cannot be\n   121\t   * plotted (the rows AX103 and AX106 report). Sorted by x, duplicates kept. They are not points: nothing is\n   122\t   * drawn or picked for them. They exist so the table can list them as \"No data\" (spec F2 and F12: the note\n   123\t   * sends the reader to the table, so the table must show every row that was left out). Absent or empty when\n   124\t   * there are none. With `missing: 'zero'` on the y field, null and absent values are points with y = 0 instead\n   125\t   * and do not appear here; a value that cannot be plotted is never imputed.\n   126\t   */\n   127\t  readonly missingX?: Float64Array;\n   128\t  /** Source row index of each entry of `missingX`, in the same order; present whenever `missingX` and `row` are. */\n   129\t  readonly missingRow?: Int32Array;\n   130\t}\n   131\t\n   132\t/**\n   133\t * The normalized, lossless data. Immutable: an update or append produces a new frame with a higher revision.\n   134\t * Buffers may be shared between revisions; a streaming store appends into spare capacity and hands out\n   135\t * subarray views, so an append does not copy what is already there.\n   136\t */\n   137\tinterface FrameBase {\n   138\t  readonly revision: number;\n   139\t  /** Changes when the data is replaced or the encoding changes; survives append and eviction. A DatumRef is only meaningful within one epoch. */\n   140\t  readonly epoch: number;\n   141\t  readonly source: RowSource;\n   142\t}\n   143\t\n   144\texport interface AlignedFrame extends FrameBase {\n   145\t  readonly shape: 'aligned';\n   146\t  readonly x: XColumn;\n   147\t  readonly series: readonly Series[];\n   148\t  /** Number of x slots. */\n   149\t  readonly length: number;\n   150\t  readonly xLabel: string;\n   151\t  readonly yLabel: string | null;\n   152\t}\n   153\t\n   154\texport interface PointFrame extends FrameBase {\n   155\t  readonly shape: 'points';\n   156\t  readonly xKind: Exclude<XKind, 'category'>;\n   157\t  readonly timeZone: string | null;\n   158\t  readonly series: readonly PointSeries[];\n   159\t  readonly xLabel: string;\n   160\t  readonly yLabel: string;\n   161\t  readonly xUnit: string | null;\n   162\t  readonly yUnit: string | null;\n   163\t}\n   164\t\n   165\t/** Donut data: every category the caller gave, in the given order, before any grouping into \"Other\". */\n   166\texport interface DonutFrame extends FrameBase {\n   167\t  readonly shape: 'donut';\n   168\t  readonly labels: readonly string[];\n   169\t  /** NaN where `slot` is not SLOT_VALUE. */\n   170\t  readonly values: Float64Array;\n   171\t  readonly slot: Uint8Array;\n   172\t  readonly row: Int32Array | null;\n   173\t  readonly valueLabel: string;\n   174\t  readonly unit: string | null;\n   175\t  readonly valueScale: 'percent' | 'ratio' | null;\n   176\t}\n   177\t\n   178\texport type Frame = AlignedFrame | PointFrame | DonutFrame;\n   179\t\n   180\t/**\n   181\t * Join rule for lines and areas (spec F2). Two consecutive SLOT_VALUE slots i < j of one series are joined\n   182\t * if and only if every slot strictly between them is SLOT_NO_ROW. A value with no joined neighbour on either\n   183\t * side is an isolated point and must be drawn as a visible point.\n   184\t */\n   185\t\n   186\t// ───────────────────────────── formatting ─────────────────────────────\n   187\t\n   188\texport interface Formatters {\n   189\t  /** Value as readers see it in tooltip, table and announcements: full precision per spec F6, unit appended. */\n   190\t  value(seriesIndex: number, v: number): string;\n   191\t  /** x as readers see it in tooltip, table and announcements. For 'time' it includes the zone abbreviation. */\n   192\t  x(position: number): string;\n   193\t  /** Text for a slot that is not a value: \"No data\", \"No observation\". */\n   194\t  missing(state: SlotState): string;\n   195\t  /** A share of a whole (0–1) as a percentage in the chart's locale, for donut slices and stack shares. */\n   611\t  readonly row: number;\n   612\t}\n   613\t\n   614\texport interface TooltipModel {\n   615\t  /** Heading: the x value (with its time zone for instants), the category, or the slice label. */\n   616\t  readonly title: string;\n   617\t  /** At most eight rows (spec I1). */\n   618\t  readonly rows: readonly DatumText[];\n   619\t  /** Rows before truncation. */\n   620\t  readonly count: number;\n   621\t  /** Stack total with \"incomplete\" where it applies, already formatted; null when the chart does not stack. */\n   622\t  readonly total: string | null;\n   623\t}\n   624\t\n   625\texport type StepDirection = 'next' | 'previous' | 'first' | 'last' | 'series-next' | 'series-previous' | 'page-next' | 'page-previous';\n   626\t\n   627\t/**\n   628\t * Exact answers from the frame for one view and projection, independent of how the scene was simplified.\n   629\t * Built once per (view, layout); cheap to build: binary search over x for aligned frames, a grid index for scatter.\n   630\t */\n   631\texport interface Lookup {\n   632\t  /**\n   633\t   * What is under a pixel of the plot container, or null. Scatter: among the points within 24 CSS px of the\n   634\t   * pointer, the closest; points whose distance differs from the closest one's by less than half a device\n   635\t   * pixel are tied with it, and a tie goes to the latest source row. To keep a pick's cost independent of the\n   636\t   * number of points, positions may be compared after rounding to the device-pixel lattice (an error of at most\n   637\t   * 0.71 device px); the datum's reported values are always exact. A donut slice too thin to see is drawn,\n   638\t   * and picked, at a minimum of 1 CSS px of arc; its value and share are reported unchanged.\n   639\t   */\n   640\t  pick(px: number, py: number): PickTarget | null;\n   641\t  tooltip(target: PickTarget): TooltipModel;\n   642\t  /** The datum to focus when the keyboard takes over from a pointer target. */\n   643\t  primary(target: PickTarget): DatumRef | null;\n   644\t  datum(ref: DatumRef): DatumText | null;\n   645\t  /** Where the datum is drawn, for the cursor and focus ring; null if it is not visible. */\n   646\t  anchor(ref: DatumRef): Rect | null;\n   647\t  /**\n   648\t   * Position for \"point 4 of 120\" (spec A3). Aligned charts: `count` is the number of visible x slots and\n   649\t   * `ordinal` the zero-based place of the datum's x among them, whatever its series and whether or not it\n   650\t   * holds a value (a \"No data\" slot has a place too). Scatter: place among all visible points in x then y\n     1\t// What a consumer downloads, minified and gzipped, measured from the packed tarballs (spec DX7, P6; plan M7).\n     2\t//\n     3\t//   node scripts/size.mjs           pack packages/*/dist (scripts/pack.mjs --no-build), measure, print, write bench/size-latest.json\n     4\t//   node scripts/size.mjs --check   the same, and exit 1 when a row exceeds its target: total gzip bytes\n     5\t//                                   compared as integers against targetKiB * 1024 (96 KiB means 98,304 B)\n     6\t//   node scripts/size.mjs --no-pack measure the fixtures already in tests/dist/fixtures\n     7\t//\n     8\t// Every row is built the way a consumer's bundler would build it: esbuild, from inside a fixture that installed\n     9\t// the tarball, minified, with the `production` export condition, so only the packed files and their `exports`\n    10\t// are read. The script-tag row is the two files the documented snippet loads, as shipped.\n    11\t//\n    12\t// Stylesheet: the JavaScript carries the stylesheet as a string and applies it at run time, so a bundler page\n    13\t// downloads it inside its JavaScript and needs no axylo.css; the script-tag snippet also links axylo.css, so\n    14\t// that row adds the file. \"total\" is what each page downloads.\n    15\t//\n    16\t// Targets (spec DX7, set by the owner on 2026-11-18): 96 KiB everything, 80 KiB a page that uses only `line`.\n    17\t// CI runs this script without --check until the targets are met: the flag is correct,\n    18\t// but it is not a gate yet. The rows for each other chart kind alone and for `validate` alone have no target;\n    19\t// they show what tree-shaking leaves.\n    20\t//\n    21\t// The per-module breakdown cannot come from the packed files, which are one pre-bundled file each: it rebuilds\n    22\t// packages/axylo/src with the release build's production settings, imported from scripts/build.mjs (the\n    23\t// minified stylesheet, PRODUCTION constants), reads esbuild's metafile, and states how far that rebuild is from\n    24\t// the packed axylo.js.\n    25\timport { build } from 'esbuild';\n    26\timport fs from 'node:fs';\n    27\timport path from 'node:path';\n    28\timport { gzipSync } from 'node:zlib';\n    29\timport { PRODUCTION, stylesheetPlugin, stylesheets } from './build.mjs';\n    30\timport { fixtureGuard, pack } from './pack.mjs';\n    31\t\n    32\tconst root = path.resolve(import.meta.dirname, '..');\n    33\tconst fixtures = path.join(root, 'tests/dist/fixtures');\n    34\tconst LEVEL = 9;\n    35\tconst gzip = bytes => gzipSync(bytes, { level: LEVEL }).length;\n    36\tconst kib = bytes => +(bytes / 1024).toFixed(2);\n    37\t\n    38\t/** Whether `totalBytes` is over a target given in KiB: integer bytes against targetKiB * 1024, never rounded KiB. */\n    39\texport const exceeds = (totalBytes, targetKiB) => targetKiB !== null && totalBytes > targetKiB * 1024;\n    40\t\n    41\tasync function main() {\n    42\t  if (!process.argv.includes('--no-pack')) pack({ build: false, log: () => {} });\n    43\t  const manifest = JSON.parse(fs.readFileSync(path.join(root, 'tests/dist/.packed/manifest.json'), 'utf8'));\n    44\t\n    45\t  async function consumer({ cwd, contents, external = [], metafile = false }) {\n    46\t    const r = await build({\n    47\t      stdin: { contents, resolveDir: cwd, loader: 'ts', sourcefile: 'consumer.ts' }, absWorkingDir: cwd, bundle: true, minify: true,\n    48\t      format: 'esm', target: 'es2022', conditions: ['production'], external, write: false, metafile, logLevel: 'silent',\n    49\t      plugins: [fixtureGuard([cwd])],\n    50\t    });\n    51\t    const inputs = Object.keys(r.metafile?.inputs ?? {});\n    52\t    return { bytes: r.outputFiles[0].contents, inputs };\n    53\t  }\n    54\t\n    55\t  const npm = path.join(fixtures, 'npm');\n    56\t  const axyloFile = file => fs.readFileSync(path.join(npm, 'node_modules/axylo/dist', file));\n    57\t  const css = axyloFile('axylo.css');\n    58\t\n    59\t  const cases = [\n    60\t    {\n    61\t      entry: 'line only (examples/first-chart/npm.ts)', targetKiB: 80,\n    62\t      build: () => consumer({ cwd: npm, contents: fs.readFileSync(path.join(npm, 'example/npm.ts'), 'utf8') }), cssFile: false,\n    63\t    },\n    64\t    { entry: 'everything (export * from axylo)', targetKiB: 96, build: () => consumer({ cwd: npm, contents: \"export * from 'axylo';\" }), cssFile: false },\n    65\t    ...['area', 'bar', 'scatter', 'donut', 'validate'].map(name => ({\n    66\t      entry: `${name} only (export { ${name} } from axylo)`, targetKiB: null, cssFile: false,\n    67\t      build: () => consumer({ cwd: npm, contents: `export { ${name} } from 'axylo';` }),\n    68\t    })),\n    69\t    { entry: 'script tag (axylo.iife.min.js + axylo.css)', targetKiB: null, build: async () => ({ bytes: axyloFile('axylo.iife.min.js') }), cssFile: true },\n    70\t  ];\n    71\t\n    72\t  const rows = [];\n    73\t  for (const c of cases) {\n    74\t    const { bytes } = await c.build();\n    75\t    const jsGzip = gzip(bytes);\n    76\t    const cssGzip = c.cssFile ? gzip(css) : 0;\n    77\t    const total = jsGzip + cssGzip;\n    78\t    rows.push({\n    79\t      entry: c.entry, minBytes: bytes.length, jsGzipBytes: jsGzip, cssFileGzipBytes: cssGzip, totalGzipBytes: total,\n    80\t      totalKiB: kib(total), targetKiB: c.targetKiB, targetBytes: c.targetKiB === null ? null : c.targetKiB * 1024,\n    81\t      over: exceeds(total, c.targetKiB),\n    82\t    });\n    83\t  }\n    84\t\n    85\t  console.log(`Download size from the packed tarballs (${manifest.packages.axylo.tarball}, packed ${manifest.packedAt}); esbuild minify, gzip level ${LEVEL}`);\n    86\t  console.table(rows.map(r => ({\n    87\t    entry: r.entry, 'min B': r.minBytes, 'js gzip B': r.jsGzipBytes, 'css file gzip B': r.cssFileGzipBytes || '—',\n    88\t    'total KiB': r.totalKiB, 'target KiB': r.targetKiB ?? '—', status: r.targetKiB === null ? 'no target' : r.over ? 'OVER' : 'ok',\n    89\t  })));\n    90\t  console.log(`The stylesheet is ${css.length} B, ${gzip(css)} B gzipped as a file; the same text is inside every JavaScript row above.`);\n    91\t\n    92\t  // Where the bytes of \"everything\" are: the source rebuilt as scripts/build.mjs builds dist/axylo.js.\n    93\t  const src = path.join(root, 'packages/axylo/src');\n    94\t  const { minified } = await stylesheets();\n    95\t  const rebuilt = await build({\n    96\t    entryPoints: [path.join(src, 'index.ts')], bundle: true, target: 'es2022', legalComments: 'none', format: 'esm', minify: true,\n    97\t    define: PRODUCTION, plugins: [stylesheetPlugin(minified)], write: false, metafile: true, logLevel: 'silent', absWorkingDir: root,\n    98\t  });\n    99\t  const packedProd = axyloFile('axylo.js').length;\n   100\t  const out = Object.values(rebuilt.metafile.outputs)[0];\n   101\t  const modules = Object.entries(out.inputs).map(([file, v]) => ({ file: path.relative(src, path.resolve(root, file)), bytes: v.bytesInOutput }))\n   102\t    .sort((a, b) => b.bytes - a.bytes);\n   103\t  const sum = modules.reduce((n, m) => n + m.bytes, 0);\n   104\t  const byDir = new Map();\n   105\t  for (const m of modules) { const d = m.file.includes(path.sep) ? m.file.split(path.sep)[0] : '(root)'; byDir.set(d, (byDir.get(d) ?? 0) + m.bytes); }\n   106\t  const dirs = [...byDir].sort((a, b) => b[1] - a[1]).map(([dir, bytes]) => ({ directory: dir, 'min B': bytes, share: `${((100 * bytes) / sum).toFixed(1)}%` }));\n   107\t  console.log(`\\nPer-module breakdown of \"everything\" (source rebuilt with the release settings: ${rebuilt.outputFiles[0].contents.length} B minified; the packed axylo.js is ${packedProd} B, ${rebuilt.outputFiles[0].conten