.wordSpacing, style.lineHeight,\n   293\t    fontEpoch, ctx.locale, ctx.compact, view.kind];\n   294\t  if (view.kind === 'donut') return base;\n   295\t  const value = ctx.resolved.values[0];\n   296\t  base.push(view.xDomain[0], view.xDomain[1], view.yDomain[0], view.yDomain[1], ctx.resolved.x.tickFormat,\n   297\t    ctx.resolved.x.label, ctx.resolved.x.unit, value?.tickFormat, value?.label, value?.unit, value?.scale,\n   298\t    ctx.xLabelGiven, ctx.valueTitle, view.references);\n   299\t  // The extremes choose among the tick sets and wider domains of an automatic domain (F7).\n   300\t  const extent = value?.domain ? null : valueExtent(view);\n   301\t  base.push(extent?.[0], extent?.[1]);\n   302\t  base.push(...view.visible);\n   303\t  // The titles as drawn: a unit can change on one series only and change the shared unit (review 2, finding 20).\n   304\t  const titles = axisTitles(view, ctx);\n   305\t  base.push(titles.x, titles.y);\n   306\t  if (view.kind === 'scatter') {\n   307\t    base.push(view.frame.xKind, view.frame.timeZone, view.frame.xLabel, view.frame.yLabel);\n   308\t    return base;\n   309\t  }\n   310\t  const column = view.frame.x;\n   311\t  // No slot indexes: layout reads domains, categories and labels only, never which slots are visible.\n   312\t  base.push(column.kind, column.timeZone, column.dateUnit, column.ordered, view.frame.xLabel, view.frame.yLabel,\n   313\t    view.horizontal, column.categories);\n   314\t  for (const s of view.frame.series) base.push(s.valueScale);\n   315\t  return base;\n   316\t}\n   317\t\n   318\texport function sameKey(a: readonly unknown[] | null, b: readonly unknown[]): boolean {\n   319\t  if (a === null || a.length !== b.length) return false;\n   320\t  for (let i = 0; i < a.length; i++) {\n   321\t    const x = a[i];\n   322\t    const y = b[i];\n   323\t    if (Object.is(x, y)) continue;\n   324\t    // Categories are compared by content: a renormalized frame has a new array with the same nam