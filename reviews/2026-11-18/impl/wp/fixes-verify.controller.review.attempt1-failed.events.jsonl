e, watchEnvironment, watchLanguage } from './environment';\n    23\timport { controllerFor, type ChartHandle, type Controller, type ControllerActions } from './controller';\n    24\timport type { Composition } from './composition';\n    25\timport { object } from './stages';\n    26\t\n    27\texport type { BenchHook, ChartHandle, ChartKind, DevHook, Stage } from './controller';\n    28\t\n    29\texport interface ChartEnvironmentOverrides {\n    30\t  readonly console?: DeliveryConsole | null;\n    31\t}\n    32\t\n    33\t/** Suffixes of the ids a chart gives its elements (figure, interaction, table). */\n    34\tconst ID_SUFFIXES = ['', '-t', '-st', '-s', '-m', '-n', '-i', '-proxy', '-table', '-table-caption', '-table-jump', '-table-jump-error'];\n    35\tlet instances = 0;\n    36\t\n    37\t/** An id prefix none of whose element ids exist in the page yet (spec A1: ids unique per chart). */\n    38\tfunction allocateId(doc: Document): string {\n    39\t  for (;;) {\n    40\t    const id = `axylo-${++instances}`;\n    41\t    if (ID_SUFFIXES.every(suffix => doc.getElementById(id + suffix) === null)) return id;\n    42\t  }\n    43\t}\n    44\t\n    45\texport function createChart(composition: Composition, target: unknown, input: unknown, overrides: ChartEnvironmentOverrides = {}): ChartHandle {\n    46\t  const root = resolveTarget(target);\n    47\t  const doc = root.ownerDocument;\n    48\t  const win = doc.defaultView;\n    49\t  if (win === null) throw new Error('Axylo: the target element is not in a document with a window.');\n    50\t\n    51\t  // Cleanup in reverse order of setup; each step adds its own once it succeeded.\n    52\t  const cleanup: (() => void)[] = [];\n    53\t  const release = (): void => {\n    54\t    for (let fn = cleanup.pop(); fn; fn = cleanup.pop()) {\n    55\t      try {\n    56\t        fn();\n    57\t      } catch {\n    58\t        // Keep releasing the rest.\n    59\t      }\n    60\t    }\n    61\t  };\n    62\t\n    63\t  let controller: Controller | null = null;\n    64\t  try {\n    65\t    const requested = object(input).__renderer === 'canvas' ? 'canvas' : 'svg';\n    66\t    const id = allocateId(doc);\n    67\t\n    68\t    const renderer: MarkRenderer = requested === 'canvas' ? canvasRendererWith(composition.canvas, doc) : svgRendererWith(composition.svg, doc);\n    69\t    cleanup.push(() => renderer.destroy());\n    70\t    const textLayer: TextLayer = createTextLayer(doc);\n    71\t    cleanup.push(() => textLayer.destroy());\n    72\t    const figure: Figure = createFigure(root, id, { marks: renderer.element, text: textLayer.element });\n    73\t    cleanup.push(() => figure.destroy());\n    74\t\n    75\t    // The interaction layer is built before the controller that answers it, so its actions forward late.\n    76\t    const actions: ControllerActions = {\n    77\t      zoom: w => controller?.actions.zoom(w),\n    78\t      toggle: k => controller?.actions.toggle(k),\n    79\t      pause: p => controller?.actions.pause(p),\n    80\t      select: r => controller?.actions.select(r),\n    81\t      hover: r => controller?.actions.hover(r),\n    82\t    };\n    83\t    const interaction: Interaction = createInteraction(composition.interaction, figure, renderer, actions);\n    84\t    cleanup.push(() => interaction.destroy());\n    85\t    const measurer = createMeasurer(doc);\n    86\t    ensureStyles(doc);\n    87\t\n    88\t    // Watchers that the document holds; released while the target is out of the document.\n    89\t    let watching: (() => void) | null = null;\n    90\t    let watchedBefore = false;\n    91\t    const watch = (): void => {\n    92\t      if (watching || controller === null) return;\n    93\t      const c = controller;\n    94\t      if (watchedBefore) {\n    95\t        // Back in the document: fonts may have changed while it was out, and measurements made with the old\n    96\t        // ones must not be reused (final review, finding 14).\n    97\t        noteFontLoad(doc);\n    98\t        c.invalidate.page();\n    99\t      }\n   100\t      watchedBefore = true;\n   101\t      // Each watcher's release is registered as soon as it exists, so one that fails part-way leaves no\n   102\t      // other behind (final review, finding 14).\n   103\t      const stops: (() => void)[] = [];\n   104\t      watching = () => {\n   105\t        for (let stop = stops.pop(); stop; stop = stops.pop()) {\n   106\t          try { stop(); } catch { /* keep releasing */ }\n   107\t        }\n   108\t      };\n   109\t      stops.push(watchTheme(root, () => c.invalidate.theme()));\n   110\t      stops.push(watchEnvironment(win, {\n   111\t        pixelRatio: () => c.invalidate.pixelRatio(),\n   112\t        motion() {\n   113\t          // Nothing is animated yet (spec I5), so there is nothing to change.\n   114\t        },\n   115\t        fonts() {\n   116\t          noteFontLoad(doc);\n   117\t          c.invalidate.fonts();\n   118\t        },\n   119\t      }));\n   120\t      stops.push(watchLanguage(root, () => c.invalidate.language()));\n   121\t      interaction.attach();\n   122\t      stops.push(() => interaction.detach());\n   123\t    };\n   124\t    const unwatch = (): void => {\n   125\t      watching?.();\n   126\t      watching = null;\n   127\t    };\n   128\t    cleanup.push(unwatch);\n   129\t\n   130\t    // A font can arrive without a 'loadingdone' (a FontFace loaded first and then added to document.fonts):\n   131\t    // a probe set like the labels changes size whenever their font does, and that is a font load (L1).\n   132\t    const fontProbe = doc.createElement('div');\n   133\t    fontProbe.className = 'axylo-font-probe';\n   134\t    textLayer.element.appendChild(fontProbe);\n   135\t    let probeSize: string | null = null;\n   136\t    const fontObserver = new win.ResizeObserver(() => {\n   137\t      const box = fontProbe.getBoundingClientRect();\n   138\t      const size = `${box.width}x${box.height}`;\n   139\t      if (probeSize !== null && size !== probeSize && controller !== null && root.isConnected) {\n   140\t        noteFontLoad(doc);\n   141\t        controller.invalidate.fonts();\n   142\t      }\n   143\t      probeSize = size;\n   144\t    });\n   145\t    fontObserver.observe(fontProbe);\n   146\t    cleanup.push(() => fontObserver.disconnect());\n   147\t\n   148\t    const resizeObserver = new win.ResizeObserver(() => {\n   149\t      if (controller === null) return;\n   150\t      // A target taken out of the document reports a zero box: let go of the document until it returns.\n   151\t      if (!root.isConnected) {\n   152\t        unwatch();\n   153\t        return;\n   154\t      }\n   155\t      watch();\n   156\t      controller.invalidate.resize();\n   157\t    });\n   158\t    cleanup.push(() => resizeObserver.disconnect());\n   159\t\n   160\t    const timeZone = viewerTimeZone();\n   161\t    controller = controllerFor(composition, input, {\n   162\t      id,\n   163\t      // The author's own id names an untitled chart in diagnostics; the allocated one stays for the DOM.\n   164\t      targetId: root.id || null,\n   165\t      console: overrides.console === undefined ? (win.console as DeliveryConsole) : overrides.console,\n   166\t      page: doc,\n   167\t      timeZone,\n   168\t      renderer: {\n   169\t        kind: renderer.kind,\n   170\t        draw: (scene: Scene, bindings, theme, ratio) => renderer.draw(scene, bindings, theme, ratio),\n   171\t      },\n   172\t      text: textLayer,\n   173\t      figure,\n   174\t      interaction,\n   175\t      measurer,\n   176\t      requestFrame: callback => win.requestAnimationFrame(callback),\n   177\t      cancelFrame: handle => win.cancelAnimationFrame(handle),\n   178\t      locale: option => resolveLocale(option, doc),\n   179\t      pageLang() {\n   180\t        const lang = root.closest('[lang]')?.getAttribute('lang')?.trim();\n   181\t        return lang ? lang : null;\n   182\t      },\n   183\t      labelText(own) {\n   184\t        const el = doc.getElementById(own);\n   185\t        return el === null ? null : el.textContent ?? '';\n   186\t      },\n   187\t      textStyle: () => readTextStyle(textLayer.element),\n   188\t      measure() {\n   189\t        if (!root.isConnected) return null;\n   190\t        const box = figure.figure.getBoundingClientRect();\n   191\t        if (box.width <= 0 && box.height <= 0) return null;\n   192\t        const plot = figure.plot.getBoundingClientRect();\n   193\t        // Layout pixels, which the marks, the text and picking use: a CSS transform on an ancestor scales the\n   194\t        // bounding rect, not the layout (interaction review, part 1 item 12). Below 2% the ratio is the\n   195\t        // integer rounding of offsetWidth, and the fractional rect is kept.\n   196\t        const scaleOf = (rect: number, layout: number) => {\n   197\t          const k = layout > 0 && rect > 0 ? rect / layout : 1;\n   198\t          return Math.abs(k - 1) < 0.02 ? 1 : k;\n   199\t        };\n   200\t        const sx = scaleOf(plot.width, figure.plot.offsetWidth);\n   201\t        const sy = scaleOf(plot.height, figure.plot.offsetHeight);\n   202\t        // When the plot is squeezed to nothing, how far the rest overflows the figure is how much room is\n   203\t        // missing; that keeps the L8 decision continuous below zero.\n   204\t        const overflow = plot.height < 1 ? Math.max(0, figure.figure.scrollHeight - figure.figure.clientHeight) : 0;\n   205\t        const stage = figure.stage.getBoundingClientRect();\n   206\t        return { width: plot.width / sx, height: plot.height / sy - overflow, room: { width: stage.width / sx, height: stage.height / sy } };\n   207\t      },\n   208\t      devicePixelRatio: () => win.devicePixelRatio || 1,\n   209\t      // Scoped to this chart's own figure: properties and the scheme go with it (finding 10).\n   210\t      theme: (keys, colors) => resolveTheme(figure.figure, keys, colors),\n   211\t      surfaces(visible) {\n   212\t        // Hidden without drawing: the error revision does not depend on the methods that may have failed.\n   213\t        for (const el of [renderer.element, textLayer.element]) (el as HTMLElement).style.visibility = visible ? '' : 'hidden';\n   214\t      },\n   215\t      dispose: release,\n   216\t    });\n   217\t    resizeObserver.observe(figure.plot);\n   218\t    resizeObserver.observe(figure.figure);\n   219\t    if (root.isConnected) watch();\n   220\t    return controller.handle;\n   221\t  } catch (error) {\n   222\t    // A rejected strict create, or a failure part-way through: nothing stays behind, a controller that was\n   223\t    // already created (its first frame queued) included (review 3, finding 9).\n   224\t    const created = controller as Controller | null;\n   225\t    controller = null;\n   226\t    try { created?.handle.destroy(); } catch { /* releasing the rest matters more */ }\n   227\t    release();\n   228\t    throw error;\n   229\t  }\n   230\t}\n   231\t\n   232\tfunction resolveTarget(target: unknown): HTMLElement {\n   233\t  if (typeof target === 'string') {\n   234\t    const doc = (globalThis as { document?: Document }).document;\n   235\t    if (!doc) throw new Error(`Axylo: no document to find the target ${JSON.stringify(target)} in.`);\n   236\t    let found: Element | null = null;\n   237\t    try {\n   238\t      found = doc.querySelector(target);\n   239\t    } catch {\n   240\t      throw new Error(`Axylo: the target selector ${JSON.stringify(target)} is not a valid CSS selector.`);\n   241\t    }\n   242\t    if (!found) throw new Error(`Axylo: the target selector ${JSON.stringify(target)} matches no element.`);\n   243\t    return found as HTMLElement;\n   244\t  }\n   245\t  if (target !== null && typeof target === 'object' && (target as Node).nodeType === 1) return target as HTMLElement;\n   246\t  throw new Error('Axylo: the target must be a CSS selector or an element.');\n   247\t}\n     1\t/**\n     2\t * The browser inputs that output depends on besides options and data (contracts: Environment), and the\n     3\t * watchers that say when one of them changed: device pixel ratio, reduced motion, web fonts finishing a load.\n     4\t * Nothing here runs at import time; every function takes the window or element it reads.\n     5\t */\n     6\timport type { TextMeasurer, TextStyle } from './contracts';\n     7\t\n     8\texport function viewerTimeZone(): string {\n     9\t  try {\n    10\t    return Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';\n    11\t  } catch {\n    12\t    return 'UTC';\n    13\t  }\n    14\t}\n    15\t\n    16\t/** `options.locale`, else the document language, else the browser's, as a locale Intl accepts. */\n    17\texport function resolveLocale(option: unknown, doc: Document | null): string {\n    18\t  const candidates = [option, doc?.documentElement.lang, doc?.defaultView?.navigator.language];\n    19\t  for (const candidate of candidates) {\n    20\t    if (typeof candidate !== 'string' || candidate.trim() === '') continue;\n    21\t    try {\n    22\t      const [canonical] = Intl.getCanonicalLocales(candidate.trim());\n    23\t      if (canonical) return canonical;\n    24\t    } catch {\n    25\t      // Not a locale tag; try the next source.\n    26\t    }\n    27\t  }\n    28\t  return new Intl.NumberFormat().resolvedOptions().locale;\n    29\t}\n    30\t\n    31\tfunction pixels(value: string, fontSize: number): number {\n    32\t  if (value === '' || value === 'normal') return NaN;\n    33\t  const n = parseFloat(value);\n    34\t  if (!Number.isFinite(n)) return NaN;\n    35\t  return value.endsWith('px') ? n : n * fontSize;\n    36\t}\n    37\t\n    38\t/**\n    39\t * The text style of tick labels, read from the text layer's own computed style, so measurement agrees with\n    40\t * what the layer renders (it uses `font-size: max(12px, 1em)`), including the page's text spacing (spec A6).\n    41\t */\n    42\texport function readTextStyle(element: Element): TextStyle {\n    43\t  const win = element.ownerDocument.defaultView;\n    44\t  const style = win?.getComputedStyle(element);\n    45\t  const fontSize = style ? parseFloat(style.fontSize) || 12 : 12;\n    46\t  if (!style) return { font: `${fontSize}px sans-serif`, letterSpacing: 0, wordSpacing: 0, lineHeight: fontSize * 1.2 };\n    47\t  const family = style.fontFamily || 'sans-serif';\n    48\t  const font = `${style.fontStyle || 'normal'} ${style.fontWeight || '400'} ${fontSize}px ${family}`;\n    49\t  const letterSpacing = pixels(style.letterSpacing, fontSize);\n    50\t  const wordSpacing = pixels(style.wordSpacing, fontSize);\n    51\t  const lineHeight = pixels(style.lineHeight, fontSize);\n    52\t  return {\n    53\t    font,\n    54\t    letterSpacing: Number.isFinite(letterSpacing) ? letterSpacing : 0,\n    55\t    wordSpacing: Number.isFinite(wordSpacing) ? wordSpacing : 0,\n    56\t    // 'normal' depends on the font's metrics; 1.2 is the common value and errs on the side of room.\n    57\t    lineHeight: Number.isFinite(lineHeight) ? lineHeight : Math.ceil(fontSize * 1.2),\n    58\t  };\n    59\t}\n    60\t\n    61\tconst contexts = new WeakMap<Document, CanvasRenderingContext2D | null>();\n    62\t/** Measured widths per document, for every style together, so the bound holds for the whole page. */\n    63\tconst caches = new WeakMap<Document, Map<string, number>>();\n    64\tconst fontEpochs = new WeakMap<Document, number>();\n    65\texport const MEASUREMENT_CACHE_LIMIT = 8192;\n    66\t\n    67\t/**\n    68\t * Web fonts finished loading in `doc`: widths measured with a fallback font are wrong now. Every chart of\n    69\t * the document calls this on the same event; the first clears the cache and the epoch moves on.\n    70\t */\n    71\texport function noteFontLoad(doc: Document): void {\n    72\t  fontEpochs.set(doc, (fontEpochs.get(doc) ?? 0) + 1);\n    73\t  caches.get(doc)?.clear();\n    74\t}\n    75\t\n    76\t/** How many widths the document's cache holds (for tests of its bound). */\n    77\texport function measurementCacheSize(doc: Document): number {\n    78\t  return caches.get(doc)?.size ?? 0;\n    79\t}\n    80\t\n    81\ttype SpacingContext = CanvasRenderingContext2D & { letterSpacing?: string; wordSpacing?: string };\n    82\t\n    83\t/**\n    84\t * Canvas `measureText` with the computed font and the page's letter and word spacing (spec A6). Where the\n    85\t * context supports `letterSpacing` and `wordSpacing` they are set on it, so the browser adds them as it\n    86\t * does for the text layer; otherwise they are added the way CSS adds them (after every character, and\n    87\t * after every space). Cached per document, font epoch, style and string.\n    88\t */\n    89\texport function createMeasurer(doc: Document): TextMeasurer {\n    90\t  return {\n    91\t    width(text: string, style: TextStyle): number {\n    92\t      let ctx = contexts.get(doc);\n    93\t      if (ctx === undefined) {\n    94\t        ctx = doc.createElement('canvas').getContext('2d');\n    95\t        contexts.set(doc, ctx);\n    96\t      }\n    97\t      let cache = caches.get(doc);\n    98\t      if (!cache) caches.set(doc, cache = new Map());\n    99\t      const key = `${fontEpochs.get(doc) ?? 0}|${style.font}|${style.letterSpacing}|${style.wordSpacing}|${text}`;\n   100\t      const hit = cache.get(key);\n   101\t      if (hit !== undefined) return hit;\n   102\t      let width: number;\n   103\t      let spaced = false;\n   104\t      if (ctx) {\n   105\t        const c = ctx as SpacingContext;\n   106\t        if (c.font !== style.font) c.font = style.font;\n   107\t        if (typeof c.letterSpacing === 'string' && typeof c.wordSpacing === 'string') {\n   108\t          const letter = `${style.letterSpacing}px`;\n   109\t          const word = `${style.wordSpacing}px`;\n   110\t          if (c.letterSpacing !== letter) c.letterSpacing = letter;\n   111\t          if (c.wordSpacing !== word) c.wordSpacing = word;\n   112\t          spaced = true;\n   113\t        }\n   114\t        width = c.measureText(text).width;\n   115\t      } else {\n   116\t        width = text.length * parseFloat(/(\\d+(?:\\.\\d+)?)px/.exec(style.font)?.[1] ?? '12') * 0.6;\n   117\t      }\n   118\t      if (!spaced) {\n   119\t        if (style.letterSpacing !== 0) width += style.letterSpacing * [...text].length;\n   120\t        if (style.wordSpacing !== 0) {\n   121\t          let spaces = 0;\n   122\t          for (let i = 0; i < text.length; i++) if (text.charCodeAt(i) === 32) spaces++;\n   123\t          width += style.wordSpacing * spaces;\n   124\t        }\n   125\t      }\n   126\t      if (cache.size >= MEASUREMENT_CACHE_LIMIT) cache.clear();\n   127\t      cache.set(key, width);\n   128\t      return width;\n   129\t    },\n   130\t  };\n   131\t}\n   132\t\n   133\texport function sameTextStyle(a: TextStyle | null, b: TextStyle): boolean {\n   134\t  return a !== null && a.font === b.font && a.letterSpacing === b.letterSpacing &&\n   135\t    a.wordSpacing === b.wordSpacing && a.lineHeight === b.lineHeight;\n   136\t}\n   137\t\n   138\t/**\n   139\t * Calls `onChange` when the device pixel ratio changes (browser zoom, moving to another screen), when\n   140\t * reduced motion is toggled, and when web fonts finish loading. Returns `stop`.\n   141\t */\n   142\texport function watchEnvironment(win: Window, handlers: { pixelRatio(): void; motion(): void; fonts(): void }): () => void {\n   143\t  let stopped = false;\n   144\t  // Each subscription registers its removal as soon as it exists, so a failure part-way (a matchMedia that\n   145\t  // throws) leaves none behind (review 3, finding 9).\n   146\t  const undo: (() => void)[] = [];\n   147\t  const stop = (): void => {\n   148\t    stopped = true;\n   149\t    for (let fn = undo.pop(); fn; fn = undo.pop()) {\n   150\t      try { fn(); } catch { /* keep releasing */ }\n   151\t    }\n   152\t  };\n   153\t  try {\n   154\t    let ratioQuery: MediaQueryList | null = null;\n   155\t    const onRatio = (): void => {\n   156\t      if (stopped) return;\n   157\t      arm();\n   158\t      handlers.pixelRatio();\n   159\t    };\n   160\t    // A resolution query matches one ratio only, so it is re-armed for the new ratio after each change.\n   161\t    const arm = (): void => {\n   162\t      ratioQuery?.removeEventListener('change', onRatio);\n   163\t      ratioQuery = win.matchMedia(`(resolution: ${win.devicePixelRatio}dppx)`);\n   164\t      ratioQuery.addEventListener('change', onRatio);\n   165\t    };\n   166\t    arm();\n   167\t    undo.push(() => ratioQuery?.removeEventListener('change', onRatio));\n   168\t    const motion = win.matchMedia('(prefers-reduced-motion: reduce)');\n   169\t    const onMotion = (): void => { if (!stopped) handlers.motion(); };\n   170\t    motion.addEventListener('change', onMotion);\n   171\t    undo.push(() => motion.removeEventListener('change', onMotion));\n   172\t    const fonts = win.document.fonts as FontFaceSet | undefined;\n   173\t    const onFonts = (): void => { if (!stopped) handlers.fonts(); };\n   174\t    fonts?.addEventListener('loadingdone', onFonts);\n   175\t    undo.push(() => fonts?.removeEventListener('loadingdone', onFonts));\n   176\t  } catch (error) {\n   177\t    stop();\n   178\t    throw error;\n   179\t  }\n   180\t  return stop;\n   181\t}\n   182\t\n   183\t/**\n   184\t * Calls `onChange` when a `lang` attribute changes on `element` or an ancestor: the page's language decides\n   185\t * the formatting locale and which built-in text is marked English (spec A10, F6). An environment change,\n   186\t * kept apart from the theme watcher. Returns `stop`.\n   187\t */\n   188\texport function watchLanguage(element: Element, onChange: () => void): () => void {\n   189\t  const win = element.ownerDocument.defaultView;\n   190\t  if (win === null) return () => {};\n   191\t  const observer = new win.MutationObserver(records => {\n   192\t    for (const r of records) {\n   193\t      if (r.target instanceof win.Node && r.target.contains(element)) { onChange(); return; }\n   194\t    }\n   195\t  });\n   196\t  observer.observe(element.ownerDocument.documentElement, { attributes: true, attributeFilter: ['lang'], subtree: true });\n   197\t  return () => observer.disconnect();\n   198\t}\n     1\t/**\n     2\t * Notices the page changes that can change a chart's theme (spec L4): the three media features, and the\n     3\t * `class`, `style` or `data-theme` attribute of the chart or any of its ancestors (a class-toggled dark\n     4\t * theme may sit on `<html>`, `<body>` or a card in between). Bursts are folded into one call.\n     5\t *\n     6\t * One MutationObserver covers the whole document (`subtree`), and a record counts only when its target is\n     7\t * the chart or one of its ancestors at that moment, so the watch keeps working when the chart is moved to\n     8\t * another parent or `<body>` is replaced. Inside a shadow root, that root is observed as well.\n     9\t */\n    10\t\n    11\tconst QUERIES = ['(prefers-color-scheme: dark)', '(forced-colors: active)', '(prefers-contrast: more)'];\n    12\tconst ATTRIBUTES = ['class', 'style', 'data-theme'];\n    13\t\n    14\t/** Declarations resolveTheme itself writes on the chart root; changes to them alone are not theme changes. */\n    15\tconst OWN = /--axylo-(?:series-color-\\d+|backdrop)\\s*:[^;]*;?\\s*/g;\n    16\t\n    17\t/**\n    18\t * Calls `onChange` for a burst of relevant changes (once per observer batch), so the caller can feed it to its own\n    19\t * frame scheduler: the repaint lands in the next animation frame with any other pending work, drawn once\n    20\t * (review 3, finding 19). Returns `stop`.\n    21\t */\n    22\texport function watchTheme(element: Element, onChange: () => void): () => void {\n    23\t  const doc = element.ownerDocument;\n    24\t  const win = doc.defaultView;\n    25\t  if (win === null) return () => {};\n    26\t  let stopped = false;\n    27\t\n    28\t  // At once: the observer already delivers a burst as one batch, and the caller only marks itself dirty and\n    29\t  // schedules its frame, so the repaint is in the very next animation frame.\n    30\t  const schedule = (): void => {\n    31\t    if (!stopped) onChange();\n    32\t  };\n    33\t\n    34\t  // Every subscription's release is kept as it is made, so a failure part-way (an observe() that throws)\n    35\t  // leaves nothing registered (final review, finding 14).\n    36\t  const undo: (() => void)[] = [];\n    37\t  const release = (): void => {\n    38\t    stopped = true;\n    39\t    for (let fn = undo.pop(); fn; fn = undo.pop()) {\n    40\t      try { fn(); } catch { /* keep releasing */ }\n    41\t    }\n    42\t  };\n    43\t  try {\n    44\t    for (const q of QUERIES) {\n    45\t      const list = win.matchMedia(q);\n    46\t      list.addEventListener('change', schedule);\n    47\t      undo.push(() => list.removeEventListener('change', schedule));\n    48\t    }\n    49\t    const observer = new win.MutationObserver(records => {\n    50\t      for (const r of records) {\n    51\t        if (!holds(r.target, element)) continue;\n    52\t        if (r.target === element && r.attributeName === 'style') {\n    53\t          const before = (r.oldValue ?? '').replace(OWN, '').trim();\n    54\t          const after = (element.getAttribute('style') ?? '').replace(OWN, '').trim();\n    55\t          if (before === after) continue;\n    56\t        }\n    57\t        schedule();\n    58\t        return;\n    59\t      }\n    60\t    });\n    61\t    undo.push(() => observer.disconnect());\n    62\t    const options: MutationObserverInit = { attributes: true, attributeFilter: ATTRIBUTES, attributeOldValue: true, subtree: true };\n    63\t    observer.observe(doc.documentElement, options);\n    64\t    const root = element.getRootNode();\n    65\t    if (root !== doc && 'host' in root) observer.observe(root, options);\n    66\t  } catch (error) {\n    67\t    release();\n    68\t    throw error;\n    69\t  }\n    70\t\n    71\t  return () => {\n    72\t    if (stopped) return;\n    73\t    release();\n    74\t  };\n    75\t}\n    76\t\n    77\t/** True when `target` is `element` or one of its ancestors, crossing shadow roots to their hosts. */\n    78\tfunction holds(target: Node, element: Node): boolean {\n    79\t  for (let n: Node | null = element; n !== null; n = n.parentNode ?? ('host' in n ? (n as ShadowRoot).host : null)) {\n    80\t    if (n === target) return true;\n    81\t  }\n    82\t  return false;\n    83\t}\n","exit_code":0,"status":"completed"}}
