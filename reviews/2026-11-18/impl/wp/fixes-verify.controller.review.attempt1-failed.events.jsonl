 fc.record({ op: fc.constant('append' as const), n: fc.integer({ min: 1, max: 3 }), keep: fc.option(fc.integer({ min: 1, max: 6 }), { nil: null }) }),\n   387\t    fc.record({ op: fc.constant('zoom' as const), from: fc.integer({ min: 0, max: 30 }), width: fc.integer({ min: 2, max: 10 }) }),\n   388\t    fc.record({ op: fc.constant('fail' as const), stage: fc.constantFrom('view', 'layout', 'scene', 'lookup', 'reader', 'draw', 'figure') }),\n   389\t    ...(['title', 'data', 'reencode', 'pause', 'resume', 'unzoom', 'frame', 'frame', 'frame', 'heal', 'collapse', 'restore', 'reenter'] as const)\n   390\t      .map(op => fc.constant({ op })),\n   391\t  ) as fc.Arbitrary<Op>;\n   392\t\n   393\t  it('what is drawn after each frame is the model\\'s window, with its caption, its rows and bounded retention', () => {\n   394\t    fc.assert(fc.property(fc.array(ops, { maxLength: 30 }), fc.boolean(), (sequence, destroyAtEnd) => {\n   395\t      const rows = new Map<number, Record<string, unknown>>();\n   396\t      const add = (xs: number[]) => xs.map(x => { const row = { x, a: x % 7, b: -(x % 5) }; rows.set(x, row); return row; });\n   397\t      let reenterOnce = false;\n   398\t      let chart: Recording['controller']['handle'] | null = null;\n   399\t      const format = (v: number) => {\n   400\t        // A formatter calling back into the chart once: the frame stays coherent and the call is drawn next.\n   401\t        if (reenterOnce && chart) { reenterOnce = false; chart.update({ subtitle: `re${v}` }); }\n   402\t        return String(v);\n   403\t      };\n   404\t      const r = record('line', { title: 'M0', data: add([0, 1, 2]), x: 'x', y: { field: 'a', format } });\n   405\t      chart = r.controller.handle;\n   406\t      // The model: the stream's rows (oldest first), what the screen may show, the caption.\n   407\t      let data = [0, 1, 2];\n   408\t      let visible = [0, 1, 2];\n   409\t      let title = 'M0';\n   410\t      let field: 'a' | 'b' = 'a';\n   411\t      let paused = false;\n   412\t      let failing = false;\n   413\t      let failedSinceHeal = false;\n   414\t      let collapsed = false;\n   415\t      let next = 3;\n   416\t      let tick = 1;\n   417\t      let keepUsed = Infinity;\n   418\t      for (const step of sequence) {\n   419\t        switch (step.op) {\n   420\t          case 'append': {\n   421\t            const xs = Array.from({ length: step.n }, () => next++);\n   422\t            chart.append(add(xs), step.keep === null ? undefined : { keep: step.keep });\n   423\t            data = [...data, ...xs];\n   424\t            if (step.keep !== null) { data = data.slice(-step.keep); keepUsed = step.keep; }\n   425\t            if (!paused) visible = data;\n   426\t            break;\n   427\t          }\n   428\t          case 'title': title = `M${tick++}`; chart.update({ title }); break;\n   429\t          case 'data': data = [next, next + 1]; next += 2; add(data); chart.update({ data: data.map(x => rows.get(x)) }); visible = data; keepUsed = Infinity; break;\n   430\t          case 'reencode': field = field === 'a' ? 'b' : 'a'; chart.update({ y: { field, format } }); break;\n   431\t          case 'pause': chart && r.controller.actions.pause(true); paused = true; break;\n   432\t          case 'resume': r.controller.actions.pause(false); paused = false; if (!failing) visible = data; break;\n   433\t          case 'zoom': chart.zoom([step.from, step.from + step.width]); break;\n   434\t          case 'unzoom': chart.zoom(null); break;\n   435\t          case 'frame': r.frames(); break;\n   436\t          case 'fail': chart.__dev!.fail(step.stage); failing = true; failedSinceHeal = true; break;\n   437\t          case 'heal': chart.__dev!.fail(null); failing = false; break;\n   438\t          case 'collapse': r.container = { width: 0, height: 0 }; r.controller.invalidate.resize(); collapsed = true; break;\n   439\t          case 'restore': r.container = { width: 720, height: 400 }; r.controller.invalidate.resize(); collapsed = false; break;\n   440\t          case 'reenter': reenterOnce = true; chart.update({ description: `d${tick++}` }); break;\n   441\t        }\n   442\t        if (step.op !== 'frame' || failing || failedSinceHeal || collapsed) {\n   443\t          if (!failing && step.op === 'frame') failedSinceHeal = false;\n   444\t          continue;\n   445\t        }\n   446\t        // After a clean frame: the drawn window is the model's (marks, lookup and caption on one revision).\n   447\t        const committed = r.committed;\n   448\t        if (!committed) continue;\n   449\t        const view = committed.view as AlignedView;\n   450\t        const xs = Array.from(view.frame.x.values);\n   451\t        if (!paused) expect(xs).toEqual(visible);\n   452\t        else expect(visible.slice(-xs.length)).toEqual(xs);\n   453\t        expect(lastModel(r).title?.text).toBe(title);\n   454\t        // The drawn path has a vertex for each value in the window, at most (simplification only removes).\n   455\t        const path = r.draws.at(-1)!.marks.find(m => m.type === 'path');\n   456\t        if (path?.type === 'path') expect(path.xy.length / 2).toBeLessThanOrEqual(xs.length + 1);\n   457\t        // Every x on screen answers a hover with the caller's own row.\n   458\t        for (const x of xs) expect(hoverRow(r, x, view.frame.series[0]!.key)?.row).toBe(rows.get(x));\n   459\t        // Retention: what is on screen, twice, plus the slack, and what keep allows.\n   460\t        if (Number.isFinite(keepUsed)) {\n   461\t          expect(chart.__dev!.retainedRows()).toBeLessThanOrEqual(2 * Math.max(xs.length, keepUsed) + 8 + 3);\n   462\t        }\n   463\t      }\n   464\t      if (destroyAtEnd) {\n   465\t        chart.destroy();\n   466\t        expect(chart.__dev!.retainedRows()).toBe(0);\n   467\t        expect(r.writesAfterDispose).toBe(0);\n   468\t      }\n   469\t    }), { numRuns: 300 });\n   470\t  });\n   471\t});\n   472\t\n   473\tdescribe('data agent, item 1: the caller\\'s columns become collectible', () => {\n   474\t  const collect = async (): Promise<void> => {\n   475\t    const gc = (globalThis as { gc?: () => void }).gc;\n   476\t    if (!gc) throw new Error('needs --expose-gc');\n   477\t    for (let i = 0; i < 3; i++) { gc(); await new Promise(r => setTimeout(r, 0)); }\n   478\t  };\n   479\t  /** The recording host keeps every state it was given: only the current ones may hold anything. */\n   480\t  const forget = (r: Recording) => { r.prepared = r.prepared.slice(-1); r.models = r.models.slice(-1); r.draws = r.draws.slice(-1); r.texts = r.texts.slice(-1); };\n   481\t  const columns = (n: number) => ({ x: Float64Array.from({ length: n }, (_, i) => i), y: Float64Array.from({ length: n }, (_, i) => i % 7) });\n   482\t\n   483\t  it('after a replacement the first columns are let go, with no locale change', async () => {\n   484\t    let first: ReturnType<typeof columns> | null = columns(1000);\n   485\t    const ref = new WeakRef(first.x);\n     1\timport fc from 'fast-check';\n     2\timport { describe, expect, it } from 'vitest';\n     3\timport { SLOT_VALUE, type Frame } from '../../src/core/contracts';\n     4\timport { AlignedStore, DonutStore, PointStore, normalize, resolveOptions } from '../../src/data';\n     5\timport { contents, utc, version } from './helpers';\n     6\t\n     7\tconst quiet = { add() {} };\n     8\tconst types = ['line', 'scatter', 'donut'] as const;\n     9\ttype Kind = typeof types[number];\n    10\tfunction options(kind: Kind, data: unknown, y = 'y') {\n    11\t  return resolveOptions(kind, kind === 'donut' ? { data, label: 'label', value: y } :\n    12\t    { data, x: { field: 'x', type: 'number' }, y }, quiet);\n    13\t}\n    14\tfunction store(kind: Kind, data: unknown) {\n    15\t  const resolved = options(kind, data);\n    16\t  if (kind === 'scatter') return new PointStore(resolved, utc, version);\n    17\t  if (kind === 'donut') return new DonutStore(resolved, utc, version);\n    18\t  return AlignedStore.fromFrame(normalize('line', resolved, utc, quiet, version), resolved, data, utc);\n    19\t}\n    20\tfunction numericBuffers(frame: Frame): readonly ArrayBufferLike[] {\n    21\t  if (frame.shape === 'aligned') return [frame.x.values.buffer, frame.series[0]!.y.buffer];\n    22\t  if (frame.shape === 'points') return [frame.series[0]!.x.buffer, frame.series[0]!.y.buffer];\n    23\t  return [frame.values.buffer];\n    24\t}\n    25\tfunction row(x: number) {\n    26\t  return { x, label: String(x), y: x + 1, z: x + 2 };\n    27\t}\n    28\t\n    29\tfunction allocated<T>(action: () => T): { result: T; bytes: number } {\n    30\t  let bytes = 0;\n    31\t  const restore: (() => void)[] = [];\n    32\t  for (const name of ['Float64Array', 'Float32Array', 'Int32Array', 'Uint8Array'] as const) {\n    33\t    const original = globalThis[name];\n    34\t    // Species-based operations such as slice must go through the counter too.\n    35\t    const counted = new Proxy(original, {\n    36\t      construct(target, args, newTarget) {\n    37\t        const result = Reflect.construct(target, args, newTarget) as InstanceType<typeof original>;\n    38\t        if (!(args[0] instanceof ArrayBuffer) && !(args[0] instanceof SharedArrayBuffer)) bytes += result.byteLength;\n    39\t        return result;\n    40\t      },\n    41\t    });\n    42\t    Object.defineProperty(globalThis, name, { value: counted });\n    43\t    Object.defineProperty(original.prototype, 'constructor', { value: counted });\n    44\t    restore.push(() => {\n    45\t      Object.defineProperty(original.prototype, 'constructor', { value: original });\n    46\t      Object.defineProperty(globalThis, name, { value: original });\n    47\t    });\n    48\t  }\n    49\t  try {\n    50\t    const result = action();\n    51\t    return { result, bytes };\n    52\t  } finally {\n    53\t    restore.forEach(undo => undo());\n    54\t  }\n    55\t}\n    56\t\n    57\tfunction requireCollection() {\n    58\t  const collect = globalThis.gc;\n    59\t  if (!collect) throw new Error('Forced collection requires the Vitest fork execArgv option --expose-gc.');\n    60\t  return collect;\n    61\t}\n    62\t\n    63\tasync function expectCollected(...refs: WeakRef<object>[]) {\n    64\t  const collect = requireCollection();\n    65\t  for (let attempt = 0; attempt < 5; attempt++) {\n    66\t    // WeakRef keeps a dereferenced value alive only until the end of the job.\n    67\t    await new Promise<void>(resolve => setImmediate(resolve));\n    68\t    collect();\n    69\t    if (refs.every(ref => ref.deref() === undefined)) return;\n    70\t  }\n    71\t  expect(refs.map(ref => ref.deref() === undefined)).toEqual(refs.map(() => true));\n    72\t}\n    73\t\n    74\tit('does not copy a large series window when several fills are committed between draws', () => {\n    75\t  const size = 20_000;\n    76\t  const keys = ['a', 'b', 'c', 'd'];\n    77\t  const data = Array.from({ length: size }, (_, x) => keys.map(group => ({ x, y: x + 1, group }))).flat();\n    78\t  const s = new AlignedStore('line', resolveOptions('line', { data, x: 'x', y: 'y', series: 'group' }, quiet), utc, version);\n    79\t  for (const series of s.frame.series) expect(series.y.length).toBe(size);\n    80\t  const { bytes } = allocated(() => {\n    81\t    for (const [i, group] of keys.entries()) s.prepareAppend([{ x: size, y: i + 1, group }], { keep: size }).commit();\n    82\t  });\n    83\t  console.info(`shared-x prepare + commit: ${bytes} typed-array bytes per four-row tick`);\n    84\t  expect(s.frame.series.map(series => series.y.at(-1))).toEqual([1, 2, 3, 4]);\n    85\t  expect(bytes).toBeLessThanOrEqual(256 * keys.length);\n    86\t});\n    87\t\n    88\tit('bounds the retained typed-array backing after opening a million typed observations and appending', async () => {\n    89\t  const size = 1_000_000;\n    90\t  const data = { columns: { x: Float64Array.from({ length: size }, (_, i) => i), y: Float64Array.from({ length: size }, (_, i) => i / 3) } };\n    91\t  const collect = requireCollection();\n    92\t  async function arrayBuffers() {\n    93\t    await new Promise<void>(resolve => setImmediate(resolve));\n    94\t    collect();\n    95\t    collect();\n    96\t    return process.memoryUsage().arrayBuffers;\n    97\t  }\n    98\t  const baseline = await arrayBuffers();\n    99\t  const s = store('line', data);\n   100\t  s.prepareAppend([{ x: size, y: size / 3 }]).commit();\n   101\t  const frame = s.frame;\n   102\t  if (frame.shape !== 'aligned') throw new Error('Expected an aligned streaming frame.');\n   103\t  const bytes = await arrayBuffers() - baseline;\n   104\t  console.info(`million-point typed handoff: ${bytes} retained bytes beyond caller columns`);\n   105\t  expect(frame.x.values.at(-1)).toBe(size);\n   106\t  expect(frame.series[0]!.y.at(-1)).toBe(size / 3);\n   107\t  expect(frame.series[0]!.y.at(-2)).toBe((size - 1) / 3);\n   108\t  expect(frame.source.rowAt(size - 1)).toEqual({ x: size - 1, y: (size - 1) / 3 });\n   109\t  // P7 permits one extra copy of the caller’s two columns (2 × 8 × 1,000,000).\n   110\t  // A fully materialized post-append frame already needs 17 × 1,000,001 bytes for\n   111\t  // exact x, exact y and slot states before counting any spare capacity or row indexes.\n   112\t  expect(bytes).toBeLessThanOrEqual(data.columns.x.byteLength + data.columns.y.byteLength);\n   113\t});\n   114\t\n   115\tit('keeps typed-column rows implicit through in-order appends and gives exact rows once the window slides', () => {\n   116\t  const size = 1_000;\n   117\t  const data = { columns: { x: Float64Array.from({ length: size }, (_, i) => i), y: Float64Array.from({ length: size }, (_, i) => i / 3) } };\n   118\t  const s = store('line', data);\n   119\t  for (let i = 0; i < 3; i++) s.prepareAppend([{ x: size + i, y: i }]).commit();\n   120\t  const frame = s.frame;\n   121\t  if (frame.shape !== 'aligned') throw new Error('Expected an aligned frame.');\n   122\t  // The contract's null row index means \"slot i came from row i\" (spec P7: no dense identity index).\n   123\t  expect(frame.series[0]!.row).toBeNull();\n   124\t  expect(frame.source.rowAt(size + 2)).toEqual({ x: size + 2, y: 2 });\n   125\t  s.prepareAppend([{ x: size + 3, y: 3 }], { keep: 4 }).commit();\n   126\t  const slid = s.frame;\n   127\t  if (slid.shape !== 'aligned') throw new Error('Expected an aligned frame.');\n   128\t  expect([...slid.x.values]).toEqual([size, size + 1, size + 2, size + 3]);\n   129\t  expect([...slid.series[0]!.row!]).toEqual([size, size + 1, size + 2, size + 3]);\n   130\t  for (let i = 0; i < 4; i++) expect(slid.source.rowAt(slid.series[0]!.row![i]!)).toEqual({ x: size + i, y: i });\n   131\t});\n   132\t\n   133\tit('reports owned bytes that match the retained buffers and leave out the caller\\'s columns', async () => {\n   134\t  const size = 200_000;\n   135\t  const x = Float64Array.from({ length: size }, (_, i) => i);\n   136\t  const y = Float64Array.from({ length: size }, (_, i) => i / 3);\n   137\t  const collect = requireCollection();\n   138\t  async function arrayBuffers() {\n   139\t    await new Promise<void>(resolve => setImmediate(resolve));\n   140\t    collect();\n   141\t    collect();\n   142\t    return process.memoryUsage().arrayBuffers;\n   143\t  }\n   144\t  const baseline = await arrayBuffers();\n   145\t  for (const kind of types) {\n   146\t    const data = { columns: { x, y, label: Array.from(x, String) } };\n   147\t    const s = store(kind, data);\n   148\t    s.prepareAppend([row(size)]).commit();\n   149\t    const retained = await arrayBuffers() - baseline;\n   150\t    const owned = s.ownedBytes();\n   151\t    expect(owned.total).toBe(owned.buffers.reduce((sum, entry) => sum + entry.bytes, 0));\n   152\t    expect(owned.buffers.every(entry => entry.bytes > 0 && entry.buffers > 0 && entry.name.length > 0)).toBe(true);\n   153\t    // Everything the store keeps alive beyond the caller's columns is counted, and nothing else\n   154\t    // (the caller's x and y are 3.2 MB, so counting them would miss by far more than the slack).\n   155\t    expect(Math.abs(retained - owned.total)).toBeLessThan(64 * 1024);\n   156\t    void s.frame;\n   157\t  }\n   158\t});\n   159\t\n   160\tfor (const kind of types) {\n   660\t  expect(s.diagnostics).toMatchObject([{ code: 'AX106', effect: 'omitted', rows: [3], count: 1 }]);\n   661\t  expect(first.series[0]!.missingX).toEqual(Float64Array.of(2, 3, 4));\n   662\t});\n   663\t\n   664\tit('re-encodes a scatter row whose y was missing from the retained rows, as a point when the new field has a value', () => {\n   665\t  // Final controller review, finding 6: { x: 1, y: null, z: 11 } must survive a change of y to z.\n   666\t  const data = [{ x: 0, y: 5, z: 10 }, { x: 1, y: null, z: 11 }, { x: 2, y: 7, z: null }];\n   667\t  const s = new PointStore(options('scatter', data), utc, version);\n   668\t  s.prepareAppend([{ x: 3, y: null, z: 13 }], { keep: 3 }).commit();\n   669\t  const before = s.frame.series[0]!;\n   670\t  expect([...before.x]).toEqual([2]);\n   671\t  expect([...before.missingX!]).toEqual([1, 3]);\n   672\t  expect([...before.missingRow!]).toEqual([1, 3]);\n   673\t  // What the rows behind the missing observations are, through the frame's own source.\n   674\t  expect([...before.missingRow!].map(row => s.frame.source.rowAt(row))).toEqual([data[1], { x: 3, y: null, z: 13 }]);\n   675\t\n   676\t  const encoding = s.resolveEncoding({ x: { field: 'x', type: 'number' }, y: 'z' }, quiet);\n   677\t  const reencoded = s.prepareReencode(encoding, { revision: s.frame.revision + 1, epoch: s.frame.epoch + 1 });\n   678\t  reencoded.commit();\n   679\t  const after = s.frame.series[0]!;\n   680\t  expect([...after.x]).toEqual([1, 3]);\n   681\t  expect([...after.y]).toEqual([11, 13]);\n   682\t  expect([...after.row!]).toEqual([1, 3]);\n   683\t  expect([...after.missingX!]).toEqual([2]);\n   684\t  expect([...after.missingRow!]).toEqual([2]);\n   685\t  expect(s.frame.source.rowAt(1)).toBe(data[1]);\n   686\t});\n   687\t\n   688\tdescribe('owned bytes stay near what the contract needs for each retained window', () => {\n   689\t  const size = 200_000;\n   690\t  // A retained slot or point the frame hands out needs, under the contract: exact x and y (8 + 8 bytes); an\n   691\t  // aligned slot state (1); a row index (4) once the window has slid, since slot i no longer came from row i.\n   692\t  // The caller's row behind it is kept for events and the table once the caller's columns are released: its\n   693\t  // x and y (8 + 8). Buffers may keep one eighth spare (plus 16 slots), as the stores allocate.\n   694\t  const spare = (n: number) => n + Math.max(16, Math.ceil(n / 8));\n   695\t  const columns = () => ({ columns: { x: Float64Array.from({ length: size }, (_, i) => i), y: Float64Array.from({ length: size }, (_, i) => i / 3) } });\n   696\t  const xCopies = (owned: ReturnType<AlignedStore['ownedBytes']>) =>\n   697\t    owned.buffers.filter(entry => /x history|x positions/.test(entry.name)).reduce((sum, entry) => sum + entry.bytes, 0);\n   698\t\n   699\t  it.each([80_000, 150_000])('a line that keeps %i of its first rows holds one copy of x and lets the caller\\'s columns go', async keep => {\n   700\t    function setup() {\n   701\t      const data = columns();\n   702\t      const refs = [new WeakRef(data.columns.x), new WeakRef(data.columns.y)];\n   703\t      const s = store('line', data) as AlignedStore;\n   704\t      const old = s.frame.revision;\n   705\t      s.prepareAppend([row(size)], { keep }).commit();\n   706\t      s.retire(old);\n   707\t      return { s, refs };\n   708\t    }\n   709\t    const { s, refs } = setup();\n   710\t    await expectCollected(...refs);\n   711\t    const owned = s.ownedBytes();\n   712\t    const frame = s.frame;\n   713\t    if (frame.shape !== 'aligned') throw new Error('Expected an aligned frame.');\n   714\t    expect(frame.length).toBe(keep);\n   715\t    expect(frame.source.rowAt(size)).toEqual(row(size));\n   716\t    // History and the eviction seed read x from the window's own buffer.\n   717\t    expect(xCopies(owned)).toBeLessThanOrEqual(1_024);\n   718\t    expect(owned.total).toBeLessThanOrEqual(spare(keep) * (8 + 8 + 1 + 4) + keep * (8 + 8) + 64 * 1_024);\n   719\t  });\n   720\t\n   721\t  it('a scatter store over typed columns keeps no position or row index that repeats its points', () => {\n   722\t    const s = store('scatter', columns()) as PointStore;\n   723\t    s.prepareAppend([{ x: size, y: 1 }]).commit();\n   724\t    const owned = s.ownedBytes();\n   725\t    expect(owned.buffers.map(entry => entry.name).filter(name => /^(x positions|row)$/.test(name))).toEqual([]);\n   726\t    expect(s.frame.shape === 'points' && s.frame.series[0]!.row).toBeNull();\n   727\t    // Exact x and y of every point, with the stores' opening tail (at most 4,096 slots).\n   728\t    expect(owned.total).toBeLessThanOrEqual((size + 1 + 4_096 + 16) * (8 + 8) + 1_024);\n   729\t  });\n   730\t\n   731\t  it('a scatter store that keeps part of its points holds x and y, the row index, and the kept rows', () => {\n   732\t    const keep = 80_000;\n   733\t    const s = store('scatter', columns()) as PointStore;\n   734\t    const old = s.frame.revision;\n   735\t    s.prepareAppend([{ x: size, y: 1 }], { keep }).commit();\n   736\t    // Rows evicted while an earlier frame still showed them are kept for it until it retires.\n   737\t    expect(s.ownedBytes().buffers.some(entry => entry.name === 'rows kept for earlier frames')).toBe(true);\n   738\t    s.retire(old);\n   739\t    const frame = s.frame;\n   740\t    if (frame.shape !== 'points') throw new Error('Expected a point frame.');\n   741\t    expect(frame.series[0]!.x.length).toBe(keep);\n   742\t    expect(frame.series[0]!.row![0]).toBe(size + 1 - keep);\n   743\t    expect(frame.source.rowAt(frame.series[0]!.row![0]!)).toEqual({ x: size + 1 - keep, y: (size + 1 - keep) / 3 });\n   744\t    expect(s.ownedBytes().total).toBeLessThanOrEqual(spare(keep) * (8 + 8 + 4) + keep * (8 + 8) + 64 * 1_024);\n   745\t  });\n   746\t});\n     1\t/**\n     2\t * Public types of Axylo. The functions that use them are exported from index.ts.\n     3\t * Source of truth for the public API; docs/api/axylo.d.ts is the reviewed sketch this file started from.\n     4\t */\n     5\t\n     6\t// ---------- data ----------\n     7\t\n     8\t/** Rows as an API returns them, or typed columns for large data. Both describe the same logical table. */\n     9\texport type Data<Row> = readonly Row[] | { readonly columns: { readonly [K in keyof Row]: ArrayLike<Row[K]> } };\n    10\t\n    11\ttype Key<Row> = Extract<keyof Row, string>;\n    12\ttype KeysWhere<Row, V> = { [K in Key<Row>]: [Row[K]] extends [V] ? K : never }[Key<Row>];\n    13\t\n    14\t/** A field that can sit on a value axis as it is. */\n    15\texport type NumberKey<Row> = KeysWhere<Row, number | null | undefined>;\n    16\t/** A field of numeric strings (Postgres bigint and numeric, BigQuery): allowed only with `parse: 'number'`. */\n    17\texport type StringKey<Row> = KeysWhere<Row, string | null | undefined>;\n    18\t/** A field that can sit on an x axis: numbers, instants, calendar dates or categories. */\n    19\texport type XKey<Row> = KeysWhere<Row, number | string | Date | null | undefined>;\n    20\t/** A field that names a series. */\n    21\texport type SeriesKey<Row> = KeysWhere<Row, string | number | boolean>;\n    22\t\n    23\texport type XValue = number | string | Date;\n    24\t\n    25\t// ---------- fields ----------\n    26\t\n    27\tinterface FieldCommon {\n    28\t  /** Axis title and the name used in tooltip, table and announcements. */\n    29\t  label?: string;\n    30\t  /** Unit appended to values in tooltip, table and announcements: 'ms', 'USD', … */\n    31\t  unit?: string;\n    32\t}\n    33\t\n    34\texport interface ValueFieldOptions extends FieldCommon {\n    35\t  /** Declares percentage data and its convention: 'percent' = 0–100, 'ratio' = 0–1. Never inferred from the label. */\n    36\t  scale?: 'percent' | 'ratio';\n    37\t  /** How values are written in tooltip, table and announcements. Default: locale grouping, up to 6 significant fraction digits. */\n    38\t  format?: Intl.NumberFormatOptions | ((value: number) => string);\n    39\t  /** How axis ticks are written. Default: compact when it saves space. */\n    40\t  tickFormat?: Intl.NumberFormatOptions | ((value: number) => string);\n    41\t  /** What a missing value means. 'gap' (default) draws nothing; 'zero' is for counts where absence means none. */\n    42\t  missing?: 'gap' | 'zero';\n    43\t  /** Author bounds. On bar and area the domain is widened to include zero and AX110 is raised if it did not. */\n    44\t  domain?: readonly [number, number];\n    45\t}\n    46\t\n    47\texport type ValueField<Row> =\n    48\t  | NumberKey<Row>\n    49\t  | ({ field: NumberKey<Row>; parse?: never } & ValueFieldOptions)\n    50\t  | ({ field: StringKey<Row>; parse: 'number' } & ValueFieldOptions);\n    51\t\n    52\texport interface XFieldOptions extends FieldCommon {\n    53\t  /**\n    54\t   * 'date': calendar dates ('2026-02-24'); read the same in every time zone.\n    55\t   * 'time': instants (epoch milliseconds, Date objects, ISO strings with an offset); shown in `timeZone`.\n   120\texport type AreaOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { stacked?: boolean };\n   121\texport type BarOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { layout?: 'grouped' | 'stacked'; horizontal?: boolean };\n   122\t/** Scatter relates two measures: its x is a number, an instant or a date, never a category. */\n   123\texport type ScatterXField<Row> = XKey<Row> | ({ field: XKey<Row>; type?: 'number' | 'time' | 'date'; ordered?: never } & Omit<XFieldOptions, 'type' | 'ordered'>);\n   124\texport type ScatterOptions<Row> = CommonOptions<Row> & CartesianOptions & { x: ScatterXField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> };\n   125\texport type DonutOptions<Row> = CommonOptions<Row> & { label: SeriesKey<Row>; value: ValueField<Row> };\n   126\t\n   127\t// ---------- handle ----------\n   128\t\n   129\t/**\n   130\t * `x`, and the two ends of a `zoom` event, are in the form `zoom()` accepts for the axis: a Date for instants,\n   131\t * 'YYYY-MM-DD' for calendar dates, an ISO date-time without offset for wall-clock times, the category for a\n   132\t * category axis, otherwise the number. They can be passed to another chart's `zoom()` unchanged. A position that\n   133\t * a Date or a string cannot hold exactly (between milliseconds, or between days) is given as a number, which\n   134\t * `zoom()` reads as the same position.\n   135\t */\n   136\texport interface Point<Row> { series: string; x: XValue; y: number | null; row: Row | null; index: number }\n   137\t\n   138\texport interface ChartEvents<Row> {\n   139\t  hover: Point<Row> | null;\n   140\t  select: Point<Row>;\n   141\t  zoom: readonly [XValue, XValue] | null;\n   142\t}\n   143\t\n   144\texport interface Chart<Row, Options> {\n   145\t  /**\n   146\t   * Changes options. Keys present replace the old value; a key set to `undefined` returns to its default; absent keys stay.\n   147\t   * Validation and diagnostics are synchronous (a `strict` chart throws here and keeps its last valid state); drawing happens on the next frame.\n   148\t   */\n   149\t  update(patch: Partial<Options>): void;\n   150\t  /** Adds rows at the end. `keep` = number of distinct x values retained; older ones are dropped. */\n   151\t  append(rows: readonly Row[], options?: { keep?: number }): void;\n   152\t  /** Sets the visible x range; `null` shows everything. */\n   153\t  zoom(domain: readonly [XValue, XValue] | null): void;\n   154\t  on<E extends keyof ChartEvents<Row>>(event: E, listener: (payload: ChartEvents<Row>[E]) => void): () => void;\n   155\t  /** Diagnostics for the current options and data. Up to date as soon as create, update or append returns. */\n   156\t  readonly diagnostics: readonly Diagnostic[];\n   157\t  destroy(): void;\n   158\t}\n   159\t\n   160\texport type Target = string | HTMLElement;\n   161\t\n   162\t\n   163\t\n    60\tconst xKeys = ['field', 'label', 'unit', 'format', 'tickFormat', 'domain', 'type', 'timeZone', 'ordered'];\n    61\tconst valueKeys = ['field', 'label', 'unit', 'format', 'tickFormat', 'domain', 'scale', 'missing', 'parse'];\n    62\t\n    63\tfunction distance(a: string, b: string): number {\n    64\t  let previous = Array.from({ length: b.length + 1 }, (_, i) => i);\n    65\t  let earlier = previous;\n    66\t  for (let i = 1; i <= a.length; i++) {\n    67\t    const costs = [i];\n    68\t    for (let j = 1; j <= b.length; j++) {\n    69\t      let cost = Math.min(previous[j]! + 1, costs[j - 1]! + 1, previous[j - 1]! + (a[i - 1] === b[j - 1] ? 0 : 1));\n    70\t      if (i > 1 && j > 1 && a[i - 2] === b[j - 1] && a[i - 1] === b[j - 2]) {\n    71\t        cost = Math.min(cost, earlier[j - 2]! + 1);\n    72\t      }\n    73\t      costs.push(cost);\n    74\t    }\n    75\t    earlier = previous;\n    76\t    previous = costs;\n    77\t  }\n    78\t  return previous[b.length]!;\n    79\t}\n    80\t\n    81\tfunction closest<T extends string>(name: string, keys: readonly T[], limit = name.length / 3): T | undefined {\n    82\t  let suggestion: T | undefined;\n    83\t  let best = Infinity;\n    84\t  for (const key of keys) {\n    85\t    if (name === key || Math.abs(name.length - key.length) > limit) continue;\n    86\t    const score = distance(name.toLowerCase(), key.toLowerCase());\n    87\t    if (score <= limit && score < best) {\n    88\t      suggestion = key;\n    89\t      best = score;\n    90\t    }\n    91\t  }\n    92\t  return suggestion;\n    93\t}\n    94\t\n    95\tfunction literal<const T extends string>(value: unknown, keys: readonly T[], field: string, sink: DiagnosticSink): T | undefined {\n    96\t  if (value === undefined) return undefined;\n    97\t  if (typeof value === 'string' && keys.includes(value as T)) return value as T;\n    98\t  const suggestion = typeof value === 'string' ? closest(value, keys, Infinity) : keys[0];\n    99\t  report(sink, 'AX150', 'none', { field, suggestion, detail: 'Use a supported value for this option.' });\n   100\t  return undefined;\n   101\t}\n   102\t\n   103\texport function canonicalZone(zone: unknown): string | undefined {\n   104\t  if (typeof zone !== 'string') return undefined;\n   105\t  try {\n   106\t    return Intl.DateTimeFormat('en', { timeZone: zone }).resolvedOptions().timeZone;\n   107\t  } catch {\n   108\t    return undefined;\n   109\t  }\n   110\t}\n   111\t\n   112\tfunction object(value: unknown): Record<string, unknown> {\n   113\t  return value !== null && typeof value === 'object' ? value as Record<string, unknown> : {};\n   114\t}\n   115\t\n   116\tfunction unknownKeys(options: Record<string, unknown>, keys: readonly string[], sink: DiagnosticSink, path = ''): void {\n   117\t  for (const key of Object.keys(options)) {\n   118\t    if (!keys.includes(key)) {\n   119\t      const suggestion = closest(key, keys);\n   120\t      report(sink, 'AX150', 'none', { field: path + key, suggestion: suggestion && path + suggestion, count: 1 });\n   121\t    }\n   122\t  }\n   123\t}\n   124\t\n   125\texport function resolveTable(data: unknown, sink: DiagnosticSink): { table: Table; valid: boolean } {\n   126\t  if (Array.isArray(data)) return { table: rowsTable(data), valid: true };\n   127\t  const columns = object(object(data).columns) as Columns;\n   128\t  const keys = Object.keys(columns);\n   129\t  const length = columns[keys[0] ?? '']?.length ?? 0;\n   130\t  const dif