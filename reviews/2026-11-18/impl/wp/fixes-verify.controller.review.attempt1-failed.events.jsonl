104\texport function layoutInput(\n   105\t  view: View, size: { width: number; height: number }, text: { measurer: TextMeasurer; style: TextStyle }, ctx: AxisContext,\n   106\t): LayoutInput {\n   107\t  const { width, height } = size;\n   108\t  if (view.kind === 'donut') return { width, height, kind: 'ring' };\n   109\t  const common = { width, height, compact: ctx.compact, measurer: text.measurer, style: text.style, scales };\n   110\t  return { ...common, ...axisParts(view, ctx).parts } as unknown as LayoutInput;\n   111\t}\n   112\t\n   113\tfunction buildAxisParts(view: Exclude<View, { kind: 'donut' }>, ctx: AxisContext): AxisParts {\n   114\t  const value = ctx.resolved.values[0];\n   115\t  const yOption = value?.tickFormat ?? null;\n   116\t  const onYError = (e: unknown) => ctx.onFormatterError(value?.field ?? 'y', e);\n   117\t  const visibleSeries = view.frame.series.filter((_, i) => view.visible[i]);\n   118\t  const firstScale = 'valueScale' in (visibleSeries[0] ?? {}) ? (visibleSeries[0] as { valueScale: 'percent' | 'ratio' | null }).valueScale : null;\n   119\t  const valueScale = view.kind === 'scatter' ? value?.scale ?? null\n   120\t    : visibleSeries.every(s => (s as { valueScale: unknown }).valueScale === firstScale) ? firstScale : null;\n   121\t  const titles = axisTitles(view, ctx);\n   122\t  const all = numberTicks(view.yDomain, ctx.locale, yOption, valueScale, onYError);\n   123\t  const extent = value?.domain ? null : valueExtent(view);\n   124\t  const full = valueScale === 'percent' ? 100 : valueScale === 'ratio' ? 1 : null;\n   125\t  const y = {\n   126\t    domain: view.yDomain,\n   127\t    // An automatic domain ends at the first drawn tick at or beyond each extreme (F7): layout may only choose\n   128\t    // among the tick sets for which that holds, and a plot too short for all of them takes a wider domain on\n   129\t    // a coarser step, chosen with its ticks. An author's domain is drawn as given.\n   130\t    candidates: ex