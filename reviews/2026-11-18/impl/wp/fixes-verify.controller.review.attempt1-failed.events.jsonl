{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"git show bbd7564:packages/axylo/src/core/controller.ts | nl -ba | sed -n '350,840p'\"","aggregated_output":"   350\t\n   351\t  function currentDiagnostics(): Diagnostic[] {\n   352\t    // Before anything was accepted (a create that failed): what the failure raised (finding 14).\n   353\t    if (!accepted) return toPublic(presentationList(), chartName(options.current));\n   354\t    // While paused, `diagnostics` describes everything accepted, the held rows included (finding 6).\n   355\t    const a = held ? { ...accepted, dataDiagnostics: held.dataDiagnostics, viewDiagnostics: held.viewDiagnostics } : accepted;\n   356\t    return toPublic([...stateDiagnostics(a), ...presentationList()], accepted.name);\n   357\t  }\n   358\t\n   359\t  /** Replaces what a presentation stage found; outside a frame the change is delivered at once. */\n   360\t  function setPresentation(where: PresentationStage, list: readonly DiagnosticInput[]): void {\n   361\t    const before = presentation.get(where) ?? [];\n   362\t    if (before.length === 0 && list.length === 0) return;\n   363\t    if (before.length === list.length && before.every((d, i) => diagnosticKey(d) === diagnosticKey(list[i]!))) return;\n   364\t    if (list.length) presentation.set(where, list);\n   365\t    else presentation.delete(where);\n   366\t    if (!inFrame && !destroyed) {\n   367\t      deliverChanges();\n   368\t      // The reader's note may change with it (spec F12).\n   369\t      schedule();\n   370\t    }\n   371\t  }\n   372\t\n   373\t  function addPresentation(where: PresentationStage, d: DiagnosticInput): void {\n   374\t    const list = presentation.get(where) ?? [];\n   375\t    if (list.some(o => o.code === d.code && o.field === d.field)) return;\n   376\t    setPresentation(where, [...list, d]);\n   377\t  }\n   378\t\n   379\t  function formatterFailed(field: string): void {\n   380\t    addPresentation('format', createDiagnostic('AX160', 'changed', { field }, 'presentation'));\n   381\t  }\n   382\t\n   383\t  /**\n   384\t   * Notifications to author code (onDiagnostic, the console, event listeners) in call order: each delivery\n   385\t   * is a snapshot taken when it is made and is drained in full, and one made by author code during a drain\n   386\t   * waits behind it. Only destruction stops a drain (review 3, finding 7).\n   387\t   */\n   388\t  const notifications: (() => void)[] = [];\n   389\t  let draining = false;\n   390\t\n   391\t  function enqueue(work: () => void): void {\n   392\t    notifications.push(work);\n   393\t    // During a frame nothing reaches author code: hover, select and zoom that the interaction layer raises\n   394\t    // while it is being committed are delivered once the frame has finished publishing (final review, 1).\n   395\t    if (draining || inFrame) return;\n   396\t    drain();\n   397\t  }\n   398\t\n   399\t  function drain(): void {\n   400\t    if (draining || notifications.length === 0) return;\n   401\t    draining = true;\n   402\t    try {\n   403\t      while (notifications.length && !destroyed) notifications.shift()!();\n   404\t    } finally {\n   405\t      draining = false;\n   406\t      if (destroyed) notifications.length = 0;\n   407\t    }\n   408\t  }\n   409\t\n   410\t  /**\n   411\t   * Prints and hands to `onDiagnostic` what is new. The set to deliver is fixed and marked delivered when the\n   412\t   * delivery is made, so a handler that updates the chart cannot be given a finding twice.\n   413\t   */\n   414\t  function deliverChanges(): void {\n   415\t    if (destroyed) return;\n   416\t    const now = currentDiagnostics();\n   417\t    const keys = new Set(now.map(diagnosticKey));\n   418\t    for (const k of [...deliveredKeys]) if (!keys.has(k)) deliveredKeys.delete(k);\n   419\t    const fresh = now.filter(d => !deliveredKeys.has(diagnosticKey(d)));\n   420\t    if (!fresh.len