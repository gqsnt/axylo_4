siblePoints, sameRange,\n   356\t  );\n   357\t  const data = oldExtrema && old?.visiblePoints === visiblePoints ? oldExtrema : pointExtrema(frame, visible, visiblePoints);\n   358\t  const yDomain = keepSpan(yExtent(data, references, state, state.valueScale, sink).domain, old?.yDomain);\n   359\t  if (sameShared && old?.visiblePoints === visiblePoints && old.yDomain === yDomain) return old;\n   360\t  const view: ScatterView = { ...shared, kind: 'scatter', frame, visiblePoints, yDomain };\n   361\t  extrema.set(view, data);\n   362\t  return view;\n   363\t}\n   364\t\n   365\texport function buildAlignedView(frame: AlignedFrame, state: AlignedViewState, sink: DiagnosticSink): AlignedView {\n   366\t  const { prior, sameFrame, visible, references, category, continuousBars, xDomain, shared, sameShared, oldExtrema } = cartesianBase(frame, state, sink,\n   367\t    bars => bars ? barExtent(frame.x.values) : [frame.x.values[0] ?? Infinity, frame.x.values[frame.length - 1] ?? -Infinity]);\n   368\t  const old = prior?.kind === state.kind ? prior : undefined;\n   369\t  const horizontal = state.kind === 'bar' && (state.horizontal ?? false);\n   370\t  const visibleSlots = sameFrame && old?.xDomain === xDomain ? old.visibleSlots : rangeOf(frame.x.values, xDomain, old?.visibleSlots);\n   371\t  const singlePosition = xDomain[0] === xDomain[1];\n   372\t  const sameDrawWindow = sameFrame && old !== undefined && (continuousBars ? old.xDomain === xDomain\n   373\t    : old.visibleSlots === visibleSlots && (old.xDomain[0] === old.xDomain[1]) === singlePosition);\n   374\t  const barSlots = continuousBars ? barRange(frame.x.values, visibleSlots, xDomain) : visibleSlots;\n   375\t  const drawSlots = sameDrawWindow ? old.drawSlots : reuse(\n   376\t    frame.series.map(({ slot }) => state.kind === 'bar' || category || singlePosition ? barSlots : drawRange(slot, visibleSlots)),\n   377\t    old?.drawSlots, sameRange,\n   378\t  );\n   379\t  const stack = state.stacked && state.ki