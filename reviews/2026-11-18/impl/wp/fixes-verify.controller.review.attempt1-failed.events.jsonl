oat64Array, domain: Span, previous?: IndexRange): IndexRange {\n   102\t  const range = { start: positionIndex(values, domain[0], false), end: positionIndex(values, domain[1], true) };\n   103\t  return previous && sameRange(range, previous) ? previous : range;\n   104\t}\n   105\t\n   106\tfunction nextObservation(slot: Uint8Array, from: number, end: number, direction: -1 | 1): number {\n   236\t  if (count > 50_000) report(sink, 'AX133', 'none');\n   237\t  return [min, max];\n   238\t}\n   239\t\n   240\tfunction fitZoom(full: Span, zoom: Span | null): Span {\n   241\t  if (!zoom) return full;\n   242\t  const [low, high] = full;\n   243\t  const [start, end] = zoom;\n   244\t  if (start >= low && end <= high) return zoom;\n   245\t  // Compare half-widths so even a window spanning the extremes of a numeric axis can be shifted.\n   246\t  const width = end - start;\n   247\t  const overflow = !Number.isFinite(width);\n   248\t  const halfWidth = end / 2 - start / 2;\n   249\t  if (overflow ? halfWidth >= high / 2 - low / 2 : width >= high - low) return full;\n   250\t  if (start < low) {\n   251\t    const shifted = overflow ? (low / 2 + halfWidth) * 2 : low + width;\n   252\t    return shifted > low ? [low, Math.min(high, shifted)] : full;\n   253\t  }\n   254\t  const shifted = overflow ? (high / 2 - halfWidth) * 2 : high - width;\n   255\t  return shifted < high ? [Math.max(low, shifted), high] : full;\n   256\t}\n   257\t\n   258\tfunction xExtents(\n   259\t  data: Span, kind: XKind, readX: ReturnType<typeof positionReader>, references: readonly ResolvedReference[],\n   260\t  state: AlignedViewState | ScatterViewState, compact: boolean, sink: DiagnosticSink,\n   261\t): { xFull: Span; xDomain: Span } {\n   262\t  const authorInput = state.xDomain === undefined ? state.xField?.domain : state.xDomain;\n   263\t  const author = readSpan(authorInput, readX, 'x.domain', sink);\n   264\t  let [min, max] = data;\n   265\t  for (const reference of references) {\n  