st left = distanceTo(bucket.left, x, y);\n   250\t          const right = distanceTo(bucket.right, x, y);\n   251\t          if (left <= right) {\n   252\t            search(bucket.left, left);\n   253\t            search(bucket.right, right);\n   254\t          } else {\n   255\t            search(bucket.right, right);\n   256\t            search(bucket.left, left);\n   257\t          }\n   258\t        } else {\n   259\t          for (let i = bucket.start; i < bucket.end; i++) consider(order[i]!);\n   260\t        }\n   261\t      }\n   262\t\n   263\t      nearby.sort((a, b) => distanceTo(a, x, y) - distanceTo(b, x, y));\n   264\t      for (const bucket of nearby) search(bucket, distanceTo(bucket, x, y));\n   265\t      if (nearest < 0) return null;\n   266\t\n   267\t      // Measuring from the closest point keeps a chain of near ties from extending the tie window.\n   268\t      const closest = Math.sqrt(best);\n   269\t      function inTie(distance: number): boolean {\n   270\t        return distance <= RADIUS2 && Math.sqrt(distance) - closest < tieDistance;\n   271\t      }\n   272\t      function searchTies(bucket: Bucket): void {\n   273\t        if (!later(bucket.latest, nearest) || !inTie(distanceTo(bucket, x, y))) return;\n   274\t        if (inTie(distanceAcross(bucket, x, y))) {\n   275\t          nearest = bucket.latest;\n   276\t        } else if (bucket.left && bucket.right) {\n   277\t          searchTies(bucket.left);\n   278\t          searchTies(bucket.right);\n   279\t        } else {\n   280\t          for (let i = bucket.start; i < bucket.end; i++) {\n   281\t            const at = order[i]!;\n   282\t            if (!later(at, nearest)) continue;\n   283\t            visit();\n   284\t            if (inTie((px[at]! - x) ** 2 + (py[at]! - y) ** 2)) nearest = at;\n   285\t          }\n   286\t        }\n   287\t      }\n   288\t      for (const bucket of nearby) searchTies(bucket);\n   289\t\n   290\t      const cx = px[nearest]!;\n   291\t   