{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,290p' packages/axylo/test/layout/layout.test.ts\"","aggregated_output":"import fc from 'fast-check';\nimport { describe, expect, it } from 'vitest';\nimport type {\n  ContinuousScale, DiagnosticInput, LabelRemedy, Layout, PlacedText, Rect, ResolvedReference, TextStyle, TickCandidates,\n} from '../../src/core/contracts';\nimport { computeLayout } from '../../src/layout';\nimport type { BandAxis, LayoutInput, ScaleConstructors } from '../../src/layout';\n\ntype Span = readonly [number, number];\ntype Plot = Extract<Layout, { kind: 'plot' }>;\n\nconst style: TextStyle = { font: '16px sans-serif', letterSpacing: 0, wordSpacing: 0, lineHeight: 16 };\nconst measurer = {\n  width(text: string, style: TextStyle): number {\n    return [...text].length * (7 + style.letterSpacing) + (text.match(/ /gu)?.length ?? 0) * style.wordSpacing;\n  },\n};\n\nfunction continuous(type: ContinuousScale['type'], domain: Span, range: Span): ContinuousScale {\n  const [min, max] = domain;\n  const [start, end] = range;\n  return {\n    type, domain, range,\n    map: value => start + (end - start) * (value - min) / (max - min),\n    invert: pixel => min + (max - min) * (pixel - start) / (end - start),\n  };\n}\n\nconst scales: ScaleConstructors = {\n  linear: (domain, range) => continuous('linear', domain, range),\n  time: (domain, range) => continuous('time', domain, range),\n  band(count, range, padding) {\n    const [start, end] = range;\n    const direction = Math.sign(end - start);\n    const step = Math.abs(end - start) / (count + padding);\n    const bandwidth = step * (1 - padding);\n    const center = (index: number) => start + direction * ((index + padding) * step + bandwidth / 2);\n    return {\n      type: 'band', count, range, step, bandwidth, center,\n      map: index => center(index) - bandwidth / 2,\n      invert: pixel => Math.max(0, Math.min(count - 1, Math.round(((pixel - start) * direction - bandwidth / 2) / step - padding))),\n    };\n  },\n};\n\nconst valueCandidates: TickCandidates = [\n  Array.from({ length: 11 }, (_, i) => ({ value: i * 10, label: String(i * 10) })),\n  [0, 25, 50, 75, 100].map(value => ({ value, label: String(value) })),\n  [0, 50, 100].map(value => ({ value, label: String(value) })),\n  [{ value: 50, label: '50' }],\n];\n\nfunction axis(labels: readonly string[], mayThin: boolean, title?: string): BandAxis {\n  const dense = labels.map((label, value) => ({ label, value }));\n  return {\n    type: 'band', count: labels.length, padding: 0, mayThin, title,\n    candidates: [dense, dense.filter(tick => tick.value % 3 === 0), dense.slice(0, 1)],\n  };\n}\n\nfunction input(labels: readonly string[], width = 720, height = 320, mayThin = false, diagnostics: DiagnosticInput[] = []) {\n  return {\n    kind: 'xy', width, height, scales, style, measurer,\n    diagnostics: { add: (diagnostic: DiagnosticInput) => diagnostics.push(diagnostic) },\n    x: axis(labels, mayThin, 'Team'),\n    y: { domain: [0, 100] as const, candidates: valueCandidates, mayThin: true, title: 'Value (USD)' },\n  } satisfies LayoutInput;\n}\n\nfunction plot(result: Layout): Plot {\n  expect(result.kind).toBe('plot');\n  if (result.kind !== 'plot') throw new Error('Expected a plot');\n  return result;\n}\n\nfunction tickLabels(result: Plot, role: PlacedText['role'] = 'tick-x'): readonly PlacedText[] {\n  return result.texts.filter(text => text.role === role);\n}\n\nfunction intersection(a: Rect, b: Rect): boolean {\n  return Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x) > 1 &&\n    Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y) > 1;\n}\n\nfunction boxesFit(result: Plot): void {\n  for (const [i, { box }] of result.texts.entries()) {\n    expect(box.x).toBeGreaterThanOrEqual(-1e-6);\n    expect(box.y).toBeGreaterThanOrEqual(-1e-6);\n    expect(box.x + box.width).toBeLessThanOrEqual(result.width + 1e-6);\n    expect(box.y + box.height).toBeLessThanOrEqual(result.height + 1e-6);\n    for (const other of result.texts.slice(0, i)) expect(intersection(box, other.box)).toBe(false);\n  }\n}\n\nfunction distinct(texts: readonly PlacedText[]): void {\n  expect(new Set(texts.map(text => text.lines.join(' '))).size).toBe(texts.length);\n}\n\nfunction identifiable(texts: readonly PlacedText[], originals: readonly string[]): void {\n  const segmenter = new Intl.Segmenter(undefined, { granularity: 'grapheme' });\n  for (const text of texts) {\n    const shown = text.lines.join(' ');\n    if (shown === text.full) continue;\n    expect(text.lines).toHaveLength(1);\n    const parts = Array.from(shown.matchAll(/…/gu), match => match.index);\n    const splits = parts.map(i => [shown.slice(0, i), shown.slice(i + 1)] as const)\n      .filter(([prefix, suffix]) => text.full.startsWith(prefix) && text.full.endsWith(suffix));\n    expect(splits.some(([prefix, suffix]) => [...segmenter.segment(prefix)].length >= 2 &&\n      [...segmenter.segment(suffix)].length >= 2)).toBe(true);\n    const matches = [...new Set(originals)].filter(label => label === shown ||\n      splits.some(([prefix, suffix]) => label.startsWith(prefix) && label.endsWith(suffix)));\n    expect(matches).toEqual([text.full]);\n  }\n}\n\ndescribe('plot layout', () => {\n  const teams = ['North', 'South', 'East', 'Customer Success & Onboarding', 'West', 'Coast', 'Field', 'Ops'];\n\n  it('measures each string once and jumps straight to a spread of very dense categories', () => {\n    const settings = (count: number, width: number) => input(\n      Array.from({ length: count }, (_, i) => `Customer Success International Services ${i}`), width, 400,\n    );\n    const calls = new Map<string, number>();\n    const medium = plot(computeLayout({\n      ...settings(1000, 720),\n      measurer: { width(text, style) {\n        calls.set(text, (calls.get(text) ?? 0) + 1);\n        return measurer.width(text, style);\n      } },\n    }));\n    expect(Math.max(...calls.values())).toBe(1);\n    expect(calls.size).toBeLessThan(500);\n    expect(medium.fit.x.hidden).toBe(1000 - medium.xTicks.length);\n    console.info(`Measured ${calls.size} strings for 1,000 categories`);\n\n    const large = settings(100_000, 1200);\n    const before = performance.now();\n    const result = plot(computeLayout(large));\n    const ms = performance.now() - before;\n    console.info(`Laid out 100,000 categories in ${ms.toFixed(1)} ms`);\n    expect(ms).toBeLessThan(650);\n    expect(result.xTicks.length).toBeGreaterThan(2);\n    expect(result.xTicks[0]!.value).toBeLessThan(20_000);\n    expect(result.xTicks.at(-1)!.value).toBeGreaterThan(80_000);\n    expect(result.fit.x.hidden).toBe(100_000 - result.xTicks.length);\n    boxesFit(result);\n  });\n\n  it('hides categories when fewer than two characters would fit on either side', () => {\n    const labels = Array.from({ length: 200 }, (_, i) => `Category number ${i + 1}`);\n    const result = plot(computeLayout(input(labels, 240)));\n    expect(result.fit.x.hidden).toBe(labels.length - result.xTicks.length);\n    identifiable(tickLabels(result), labels);\n  });\n\n  it('shows the distinguishing part of a label or counts the label as hidden', () => {\n    const labels = ['Region North Total', 'Region South Total'];\n    const result = plot(computeLayout({ ...input(labels, 260), kind: 'bands', horizontal: true }));\n    expect(result.fit.x.hidden).toBe(labels.length - result.xTicks.length);\n    identifiable(tickLabels(result), labels);\n  });\n\n  it('finds a distinct truncation when both ends need more room than the minimum', () => {\n    const labels = ['abcdefghijklmnoPQR', 'abcdefghijklmZPQR', 'abcdefgZijklmnoPQR'];\n    const result = plot(computeLayout({ ...input(labels, 245), kind: 'bands', horizontal: true }));\n    expect(tickLabels(result).find(text => text.full === labels[0])?.lines).toEqual(['abcdefgh…oPQR']);\n    identifiable(tickLabels(result), labels);\n  });\n\n  it('reserves room for a 120 px plot before sizing horizontal category labels', () => {\n    const labels = ['Customer Success & Onboarding', 'Engineering Platform Services', 'Sales', 'Marketing Operations'];\n    const result = plot(computeLayout({ ...input(labels, 240, 300), kind: 'bands', horizontal: true }));\n    expect(result.plot.width).toBeGreaterThanOrEqual(120);\n    expect(result.xTicks).toHaveLength(labels.length);\n    boxesFit(result);\n  });\n\n  it.each([NaN, Infinity, -Infinity])('treats %s dimensions as unmeasured for every layout kind', invalid => {\n    const settings = input(teams);\n    const kinds: LayoutInput[] = [settings, { ...settings, compact: true },\n      { kind: 'ring', width: 720, height: 320, diagnostics: settings.diagnostics }, { ...settings, kind: 'bands', horizontal: true },\n      { kind: 'message', width: 720, height: 320, style, measurer, message: 'Loading' }];\n    for (const variant of kinds) {\n      expect(computeLayout({ ...variant, width: invalid }).kind).toBe('unmeasured');\n      expect(computeLayout({ ...variant, height: invalid }).kind).toBe('unmeasured');\n    }\n  });\n\n  it('keeps a rotated label at the last continuous tick', () => {\n    const ticks = Array.from({ length: 13 }, (_, value) => ({ value, label: `Week ${value} total` }));\n    const result = plot(computeLayout({ ...input([], 600), x: {\n      type: 'linear', domain: [0, 12], candidates: [ticks], mayThin: true,\n    } }));\n    expect(result.fit.x.remedies).toContain('rotated');\n    expect(result.xTicks.at(-1)?.value).toBe(12);\n    boxesFit(result);\n  });\n\n  it('counts blank and later duplicate labels as hidden without changing their neighbours', () => {\n    const labels = ['Same', 'Same', '', 'Other', ' '];\n    const result = plot(computeLayout(input(labels, 400, 200)));\n    expect(result.fit.x).toEqual({ remedies: [], hidden: 3 });\n    expect(result.xTicks.map(tick => tick.value)).toEqual([0, 3]);\n    expect(tickLabels(result).map(text => text.lines)).toEqual([['Same'], ['Other']]);\n\n    const settings = input(['Team A', 'Team B']);\n    const yTicks = [{ label: 'Zero', value: 0 }, { label: 'Zero', value: 40 },\n      { label: '', value: 50 }, { label: 'Hundred', value: 100 }];\n    const value = plot(computeLayout({ ...settings, y: { ...settings.y, candidates: [yTicks] } }));\n    expect(value.fit.y).toEqual({ remedies: [], hidden: 2 });\n    expect(value.yTicks.map(tick => tick.value)).toEqual([0, 100]);\n  });\n\n  it('returns layout diagnostics as data and leaves a reused legacy sink alone', () => {\n    const diagnostics: DiagnosticInput[] = [];\n    const small = input(teams, 100, 60, false, diagnostics);\n    const labels = Array.from({ length: 24 }, (_, i) => `Row ${i + 1}`);\n    const crowded = { ...input(labels, 410, 290, false, diagnostics), kind: 'bands', horizontal: true } as const;\n    for (let i = 0; i < 2; i++) {\n      expect(computeLayout(small).kind).toBe('too-small');\n      expect(plot(computeLayout(crowded)).fit.x.hidden).toBe(12);\n    }\n    expect(diagnostics).toEqual([]);\n  });\n\n  it('wraps a long label at 720 px and preserves distinct labels at 340 px', () => {\n    const large = plot(computeLayout(input(teams)));\n    const wrapped = tickLabels(large).find(text => text.full === teams[3]);\n    expect(wrapped?.lines).toEqual(['Customer Success', '& Onboarding']);\n    expect(large.fit.x).toEqual({ remedies: ['wrapped'], hidden: 0 });\n    expect(large.xTicks).toHaveLength(teams.length);\n    boxesFit(large);\n\n    const small = plot(computeLayout(input(teams, 340)));\n    expect(small.xTicks).toHaveLength(teams.length);\n    expect(small.fit.x).toEqual({ remedies: ['wrapped', 'rotated', 'truncated'], hidden: 0 });\n    distinct(tickLabels(small));\n    boxesFit(small);\n  });\n\n  it('wraps only the long category to three lines before rotating a seven-bar chart', () => {\n    const labels = ['North', 'South', 'Infrastructure', 'Customer Success & Onboarding', 'Administration', 'Field', 'Ops'];\n    const result = plot(computeLayout({ ...input(labels, 760), kind: 'bands', horizontal: false }));\n    expect(result.fit.x).toEqual({ remedies: ['wrapped'], hidden: 0 });\n    expect(tickLabels(result).map(text => text.lines)).toEqual(labels.map((label, i) =>\n      i === 3 ? ['Customer', 'Success &', 'Onboarding'] : [label]));\n    for (const text of tickLabels(result)) expect(text.rotate).toBe(0);\n    boxesFit(result);\n  });\n\n  it('uses up to 40% of the container for the bottom margin before truncating a rotated label', () => {\n    const long = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnop';\n    const labels = ['', '', '', long, 'Next', '', ''];\n    const tall = plot(computeLayout(input(labels, 910, 720)));\n    expect(tickLabels(tall).find(text => text.full === long)).toMatchObject({ lines: [long], rotate: -45 });\n    expect(tall.fit.x.remedies).toEqual(['rotated']);\n\n    const short = plot(computeLayout(input(labels, 910, 420)));\n    expect(short.fit.x.remedies).toEqual(['rotated', 'truncated']);\n    const label = tickLabels(short).find(text => text.full === long);\n    expect(label?.lines[0]).toMatch(/^ABC.*….*nop$/u);\n    expect(label?.rotate).toBe(-45);\n    for (const result of [tall, short]) {\n      expect(result.height - (result.plot.y + result.plot.height)).toBeLessThanOrEqual(result.height * 0.4 + 1e-6);\n      boxesFit(result);\n    }\n  });\n\n  it.each([false, true])('keeps tick label boxes at least 6 px from the axis lines (horizontal %s)', horizontal => {\n    const result = plot(computeLayout({ ...input(['A', 'B', 'C']), kind: 'bands', horizontal }));\n    const left = tickLabels(result, horizontal ? 'tick-x' : 'tick-y');\n    const bottom = tickLabels(result, horizontal ? 'tick-y' : 'tick-x');\n    expect(left.length).toBeGreaterThan(0);\n    expect(bottom.length).toBeGreaterThan(0);\n    for (const { box } of left) expect(result.plot.x - box.x - box.width).toBeGreaterThanOrEqual(6 - 1e-6);\n    for (const { box } of bottom) expect(box.y - result.plot.y - result.plot.height).toBeGreaterThanOrEqual(6 - 1e-6);\n    boxesFit(result);\n  });\n\n  it('places reference lines and bands beside their projected edges and flips at plot boundaries', () => {\n    const references: readonly ResolvedReference[] = [\n      { axis: 'y', from: 35, to: 35, label: 'Goal' },\n      { axis: 'y', from: 90, to: 100, label: 'High range' },\n      { axis: 'x', from: 1, to: 1, label: 'Milestone' },\n      { axis: 'x', from: 3, to: 4, label: 'Window' },\n    ];\n    const settings = {\n      ...input([], 440, 280), references,\n      x: { type: 'linear' as const, domain: [0, 4] as const, candidates: [], mayThin: true },\n    };\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/layout/index.ts && cat packages/axylo/src/layout/references.ts'","aggregated_output":"import type {\n  BandScale, ContinuousScale, DiagnosticSink, Layout, PlacedText, Projection, Rect, ResolvedReference,\n  TextMeasurer, TextStyle, TickCandidates, XScale,\n} from '../core/contracts';\nimport { fitBottom, fitLeftCategories, fitValue, messageLines, placeText, prepareLabels, wrapText } from './labels';\nimport type { FittedLabels, Metrics } from './labels';\nimport { placeReferences } from './references';\n\ntype Span = readonly [number, number];\n\ninterface Axis {\n  readonly candidates: TickCandidates;\n  readonly title?: string;\n  readonly mayThin: boolean;\n}\n\nexport interface ValueAxis extends Axis {\n  readonly domain: Span;\n}\n\nexport interface ContinuousAxis extends ValueAxis {\n  readonly type: 'linear' | 'time';\n}\n\nexport interface BandAxis extends Axis {\n  readonly type: 'band';\n  readonly count: number;\n  readonly padding: number;\n}\n\nexport interface ScaleConstructors {\n  linear(domain: Span, range: Span): ContinuousScale;\n  time(domain: Span, range: Span): ContinuousScale;\n  band(count: number, range: Span, padding: number): BandScale;\n}\n\ninterface Size {\n  readonly width: number;\n  readonly height: number;\n}\n\ninterface Axes {\n  /** Logical category or independent axis, including for horizontal bars. */\n  readonly x: ContinuousAxis | BandAxis;\n  readonly y: ValueAxis;\n  readonly scales: ScaleConstructors;\n  readonly references?: readonly ResolvedReference[];\n  /** View bounds when they differ from the scale's domain, such as on a padded bar axis. */\n  readonly referenceXDomain?: Span;\n}\n\ntype Cartesian = Axes & (\n  | { readonly kind: 'xy' }\n  | { readonly kind: 'bands'; readonly horizontal: boolean }\n);\n\ninterface TextInput {\n  readonly measurer: TextMeasurer;\n  readonly style: TextStyle;\n}\n\ntype PlotInput = Size & {\n  /** Ignored. Presentation derives AX142 and AX143 from the returned layout. */\n  readonly diagnostics?: DiagnosticSink;\n  readonly compact?: boolean;\n};\n\nexport type LayoutInput =\n  | (PlotInput & Cartesian & TextInput)\n  | (PlotInput & { readonly kind: 'ring' })\n  | (Size & TextInput & { readonly kind: 'message'; readonly message: string });\n\nconst INSET = 4;\nconst GAP = 4;\nconst TICK_GAP = 6;\nconst MIN_WIDTH = 120;\nconst MIN_HEIGHT = 80;\nconst UNCHANGED = { remedies: [], hidden: 0 } as const;\n\nfunction independentScale(axis: Axes['x'], range: Span, scales: ScaleConstructors): XScale {\n  return axis.type === 'band' ? scales.band(axis.count, range, axis.padding) : scales[axis.type](axis.domain, range);\n}\n\nfunction project(plot: Rect, axes: Cartesian): Exclude<Projection, { kind: 'ring' }> {\n  const across: Span = [plot.x, plot.x + plot.width];\n  const up: Span = [plot.y + plot.height, plot.y];\n  const horizontal = axes.kind === 'bands' && axes.horizontal;\n  const down: Span = [plot.y, plot.y + plot.height];\n  const x = independentScale(axes.x, horizontal ? (axes.x.type === 'band' ? down : up) : across, axes.scales);\n  const y = axes.scales.linear(axes.y.domain, horizontal ? across : up);\n  return axes.kind === 'xy' ? { kind: 'xy', x, y } : { kind: 'bands', horizontal, band: x, value: y };\n}\n\nfunction ring(plot: Rect): Projection {\n  const r1 = Math.min(plot.width, plot.height) / 2;\n  return { kind: 'ring', cx: plot.x + plot.width / 2, cy: plot.y + plot.height / 2, r0: r1 * 0.6, r1 };\n}\n\nfunction tooSmall(size: Size): Layout {\n  return { ...size, kind: 'too-small' };\n}\n\nfunction metrics(input: TextInput): Metrics {\n  const widths = new Map<string, number>();\n  return {\n    lineHeight: input.style.lineHeight,\n    width(text) {\n      const cached = widths.get(text);\n      if (cached !== undefined) return cached;\n      const width = input.measurer.width(text, input.style);\n      widths.set(text, width);\n      return width;\n    },\n  };\n}\n\nfunction moveText(text: PlacedText, dx: number, dy: number): PlacedText {\n  return { ...text, x: text.x + dx, y: text.y + dy, box: { ...text.box, x: text.box.x + dx, y: text.box.y + dy } };\n}\n\nfunction lane(fit: FittedLabels): number {\n  return fit.texts.length ? TICK_GAP + fit.depth : 0;\n}\n\nfunction hiddenTicks(candidates: TickCandidates): FittedLabels {\n  return { ticks: [], texts: [], depth: 0, fit: { remedies: [], hidden: candidates[0]?.length ?? 0 } };\n}\n\nfunction layoutAxes(input: PlotInput & Cartesian & TextInput, size: Size, text: Metrics, showTicks: boolean): Layout {\n  const { width, height } = size;\n  const horizontal = input.kind === 'bands' && input.horizontal;\n  const leftAxis = horizontal ? input.x : input.y;\n  const bottomAxis = horizontal ? input.y : input.x;\n  const leftCandidates = horizontal ? leftAxis.candidates.slice(0, 1) : leftAxis.candidates;\n  const bottomCandidates = !horizontal && !bottomAxis.mayThin ? bottomAxis.candidates.slice(0, 1) : bottomAxis.candidates;\n  const leftLabels = showTicks ? prepareLabels(leftCandidates) : undefined;\n  const bottomLabels = showTicks ? prepareLabels(bottomCandidates) : undefined;\n  const leftRole = horizontal ? 'tick-x' : 'tick-y';\n  const bottomRole = horizontal ? 'tick-y' : 'tick-x';\n  const clearance = leftLabels?.sets.some(set => set.ticks.length > 0) ? text.lineHeight / 2 : 0;\n  const top = INSET + clearance;\n  let left = INSET;\n  let bottom = INSET + clearance;\n  const visited = new Set<string>();\n  let growMargins = false;\n\n  for (;;) {\n    const plot = { x: left, y: top, width: width - left - INSET, height: height - top - bottom };\n    if (plot.width < MIN_WIDTH - 1e-7 || plot.height < MIN_HEIGHT - 1e-7) return tooSmall(size);\n\n    const projection = project(plot, input);\n    const xScale = projection.kind === 'xy' ? projection.x : projection.band;\n    const yScale = projection.kind === 'xy' ? projection.y : projection.value;\n    const leftTitle = leftAxis.title ? wrapText(leftAxis.title, plot.height, text) : [];\n    const bottomTitle = bottomAxis.title ? wrapText(bottomAxis.title, plot.width, text) : [];\n    if (leftTitle.some(line => text.width(line) > plot.height) ||\n        bottomTitle.some(line => text.width(line) > plot.width)) return tooSmall(size);\n    const leftTitleSize = leftTitle.length ? GAP + leftTitle.length * text.lineHeight : 0;\n    const bottomTitleSize = bottomTitle.length ? GAP + bottomTitle.length * text.lineHeight : 0;\n    const leftRoom = width - 2 * INSET - MIN_WIDTH - leftTitleSize - TICK_GAP;\n    const bottomFixed = INSET + clearance + bottomTitleSize + TICK_GAP;\n    const bottomRoom = height - top - MIN_HEIGHT - bottomFixed;\n    const rotatedRoom = Math.min(bottomRoom, height * 0.4 - bottomFixed);\n\n    const leftFit = !leftLabels ? hiddenTicks(leftCandidates) : horizontal\n      ? fitLeftCategories(leftCandidates[0] ?? [], xScale, width, height, leftRole, text, leftRoom, leftLabels)\n      : fitValue(leftCandidates, yScale, 'left', height, leftRoom, leftRole, text, leftLabels);\n    const bottomFit = !bottomLabels ? hiddenTicks(bottomCandidates) : horizontal\n      ? fitValue(bottomCandidates, yScale, 'bottom', width, bottomRoom, bottomRole, text, bottomLabels)\n      : fitBottom(bottomCandidates, bottomAxis.mayThin, xScale, width, bottomRoom, bottomRole, text, bottomLabels, rotatedRoom);\n\n    const nextLeft = INSET + lane(leftFit) + leftTitleSize;\n    const nextBottom = INSET + clearance + lane(bottomFit) + bottomTitleSize;\n    const key = left + '/' + bottom;\n    // A sparser tick set can free space for a denser set on the next pass. If that\n    // cycles, keep enough margin for either fit and use the labels at the final ranges.\n    if (visited.has(key) || visited.size === 16) growMargins = true;\n    if ((!growMargins && nextLeft === left && nextBottom === bottom) ||\n        (growMargins && nextLeft <= left && nextBottom <= bottom)) {\n      const base = plot.y + plot.height + clearance;\n      const texts = [\n        ...leftFit.texts.map(label => moveText(label, left - TICK_GAP, 0)),\n        ...bottomFit.texts.map(label => moveText(label, 0, base + TICK_GAP)),\n      ];\n      if (leftAxis.title && leftTitle.length) {\n        texts.push(placeText(leftTitle, leftAxis.title, left - lane(leftFit) - GAP - leftTitle.length * text.lineHeight / 2,\n          plot.y + plot.height / 2, 'middle', 'middle', -90, horizontal ? 'title-x' : 'title-y', text));\n      }\n      if (bottomAxis.title && bottomTitle.length) {\n        texts.push(placeText(bottomTitle, bottomAxis.title, left + plot.width / 2, base + lane(bottomFit) + GAP,\n          'middle', 'top', 0, horizontal ? 'title-y' : 'title-x', text));\n      }\n\n      const xFit = horizontal ? leftFit : bottomFit;\n      const yFit = horizontal ? bottomFit : leftFit;\n      const hidden = placeReferences(input.references ?? [], projection, plot, texts, text, input.referenceXDomain);\n      return {\n        ...size, kind: 'plot', plot, projection, xTicks: xFit.ticks, yTicks: yFit.ticks, texts,\n        fit: { x: { ...xFit.fit, hidden: xFit.fit.hidden + hidden.x }, y: { ...yFit.fit, hidden: yFit.fit.hidden + hidden.y } },\n      };\n    }\n    visited.add(key);\n    left = growMargins ? Math.max(left, nextLeft) : nextLeft;\n    bottom = growMargins ? Math.max(bottom, nextBottom) : nextBottom;\n  }\n}\n\nexport function computeLayout(input: LayoutInput): Layout {\n  const { width, height } = input;\n  const size = { width, height };\n  if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) return { ...size, kind: 'unmeasured' };\n\n  if (input.kind === 'message') {\n    const text = metrics(input);\n    const maxLines = Math.floor((height - 2 * INSET) / text.lineHeight);\n    const lines = messageLines(input.message, width - 2 * INSET, maxLines, text);\n    return { ...size, kind: 'message', text: placeText(lines, input.message, width / 2, height / 2, 'middle', 'middle', 0, 'message', text) };\n  }\n  if (input.compact) {\n    const x = Math.min(2, width / 2);\n    const y = Math.min(2, height / 2);\n    const plot = { x, y, width: width - 2 * x, height: height - 2 * y };\n    return { ...size, kind: 'compact', plot, projection: input.kind === 'ring' ? ring(plot) : project(plot, input) };\n  }\n  if (input.kind === 'ring') {\n    if (width < MIN_WIDTH || height < MIN_HEIGHT) return tooSmall(size);\n    const plot = { x: 0, y: 0, width, height };\n    return { ...size, kind: 'plot', plot, projection: ring(plot), xTicks: [], yTicks: [], texts: [], fit: { x: UNCHANGED, y: UNCHANGED } };\n  }\n  if (width < MIN_WIDTH + 2 * INSET || height < MIN_HEIGHT + 2 * INSET) return tooSmall(size);\n  const text = metrics(input);\n  const layout = layoutAxes(input, size, text, true);\n  // A title may need the space otherwise reserved for ticks at the ends of the left axis.\n  return layout.kind === 'too-small' ? layoutAxes(input, size, text, false) : layout;\n}\nimport type { PlacedText, Projection, Rect, ResolvedReference } from '../core/contracts';\nimport { projectReference } from '../scene/geometry';\nimport { middleText, placeText, prepareLabels, type Metrics } from './labels';\n\ntype Cartesian = Exclude<Projection, { kind: 'ring' }>;\ntype Span = readonly [number, number];\n\nconst GAP = 4;\n\ninterface Placement {\n  readonly anchor: 'start' | 'end';\n  readonly x: number;\n  readonly y: number;\n  readonly width: number;\n}\n\nfunction* placements(\n  reference: NonNullable<ReturnType<typeof projectReference>>, plot: Rect, texts: readonly PlacedText[], height: number,\n): Iterable<Placement> {\n  const { vertical, low, high } = reference;\n  const left = plot.x + GAP;\n  const right = plot.x + plot.width - GAP;\n  const bottom = plot.y + plot.height;\n  const boxes = texts.map(text => text.box);\n  const top = vertical ? plot.y + GAP : plot.y;\n  const rows = vertical\n    ? [top, ...boxes.map(box => box.y + box.height + GAP).sort((a, b) => a - b)]\n    : [low - GAP - height, high + GAP];\n  // A band that meets the plot edges may only have room on the inside.\n  if (!vertical && high - low >= height + 2 * GAP) rows.push(low + GAP, high - GAP - height);\n  for (const y of rows) {\n    if (y < top || y + height > bottom) continue;\n    const obstacles = boxes.filter(box => box.y < y + height && box.y + box.height > y);\n    const ends = vertical ? [low - GAP] : [right, ...obstacles.map(box => box.x - GAP).sort((a, b) => b - a)];\n    if (vertical) {\n      const x = high + GAP;\n      let edge = right;\n      for (const box of obstacles) {\n        if (box.x + box.width > x) edge = Math.min(edge, box.x - GAP);\n      }\n      if (edge > x) yield { anchor: 'start', x, y, width: edge - x };\n    }\n    for (const x of ends) {\n      let edge = left;\n      for (const box of obstacles) {\n        if (box.x < x) edge = Math.max(edge, box.x + box.width + GAP);\n      }\n      if (x > edge) yield { anchor: 'end', x, y, width: x - edge };\n    }\n    if (vertical && high - low > 2 * GAP) {\n      const x = low + GAP;\n      let edge = high - GAP;\n      for (const box of obstacles) {\n        if (box.x + box.width > x) edge = Math.min(edge, box.x - GAP);\n      }\n      if (edge > x) yield { anchor: 'start', x, y, width: edge - x };\n    }\n  }\n}\n\nexport function placeReferences(\n  references: readonly ResolvedReference[], projection: Cartesian, plot: Rect, texts: PlacedText[], metrics: Metrics,\n  xDomain?: Span,\n): { x: number; y: number } {\n  const hidden = { x: 0, y: 0 };\n  if (!references.length) return hidden;\n  const labels = prepareLabels([references.map(({ label }, value) => ({ label, value }))]);\n  for (const reference of references) {\n    const projected = projectReference(reference, projection, plot, xDomain);\n    if (!projected) continue;\n    const { label } = reference;\n    let best: Placement | undefined;\n    const width = metrics.width(label);\n    for (const candidate of placements(projected, plot, texts, metrics.lineHeight)) {\n      if (candidate.width >= width) {\n        best = candidate;\n        break;\n      }\n      if (!best || candidate.width > best.width) best = candidate;\n    }\n    const shown = best && middleText(label, best.width, labels, metrics);\n    if (best && shown?.trim()) {\n      texts.push(placeText([shown], label, best.x, best.y, best.anchor, 'top', 0, 'reference', metrics));\n    } else {\n      hidden[reference.axis]++;\n    }\n  }\n  return hidden;\n}\n","exit_code":0,"status":"completed"}}
