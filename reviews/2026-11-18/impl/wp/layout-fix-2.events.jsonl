< n; i += k) set.push({ value: i, label: labels[i] as string });\n          built = set;\n        }\n        return built;\n      },\n    });\n  });\n  return sets;\n}\n\n/** 1, 2, …, 10, 20, 50, 100, 200, 500, … up to the first stride at or above n. */\nfunction strideSequence(n: number): number[] {\n  const out: number[] = [];\n  for (let k = 1; k <= 10; k++) out.push(k);\n  for (let base = 10; out[out.length - 1]! < n; base *= 10) out.push(2 * base, 5 * base, 10 * base);\n  return out;\n}\n    fix: 'Send `\\'2026-02-24\\'` (a calendar date), or keep the instants and declare `x: { field: \\'day\\', type: \\'date\\' }`, which reads each instant as its UTC calendar day. See [the three kinds of time](data.md#three-kinds-of-time).',\n    run: 'node',\n    input: `validate('line', {\n  title: 'Sessions',\n  data: [\n    { day: '2026-02-24T00:00:00Z', sessions: 120 },\n    { day: '2026-02-25T00:00:00Z', sessions: 130 },\n    { day: '2026-02-26T00:00:00Z', sessions: 125 },\n  ],\n  x: 'day',\n  y: 'sessions',\n})`,\n  },\n  {\n    code: 'AX112', level: 'hint', title: 'Date-times without an offset',\n    condition: 'Date-time strings have no offset.', drawn: 'As written.',\n/**\n * The value-axis domain (spec F1 and F7).\n *\n * Precedence: an author domain is used as given (widened to zero on bar and area); otherwise the automatic\n * domain covers the data, stack totals and reference values, and each end is the first nice tick at or\n * beyond the extreme, so it never overshoots by a whole step.\n */\nimport { firstIndexAtOrAbove, lastIndexAtOrBelow, nextNiceStep, niceStepAtLeast, stepMultiple, type NiceStep } from './nice';\n\nexport interface ValueDomainInput {\n  /** Smallest and largest value, stack totals included. NaN (or min > max) when there is no data. */\n  readonly min: number;\n  readonly max: number;\n  /** True for bar and area. */\n  readonly includeZero: boolean;\n  /** The field's `domain` option. */\n  readonly authorDomain?: readonly [number, number] 