{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/src/public.ts | sed -n '1,265p'\"","aggregated_output":"     1\t/**\n     2\t * Public types of Axylo. The functions that use them are exported from index.ts.\n     3\t * Source of truth for the public API; docs/api/axylo.d.ts is the reviewed sketch this file started from.\n     4\t */\n     5\t\n     6\t// ---------- data ----------\n     7\t\n     8\t/** Rows as an API returns them, or typed columns for large data. Both describe the same logical table. */\n     9\texport type Data<Row> = readonly Row[] | { readonly columns: { readonly [K in keyof Row]: ArrayLike<Row[K]> } };\n    10\t\n    11\ttype Key<Row> = Extract<keyof Row, string>;\n    12\ttype KeysWhere<Row, V> = { [K in Key<Row>]: [Row[K]] extends [V] ? K : never }[Key<Row>];\n    13\t\n    14\t/** A field that can sit on a value axis as it is. */\n    15\texport type NumberKey<Row> = KeysWhere<Row, number | null | undefined>;\n    16\t/** A field of numeric strings (Postgres bigint and numeric, BigQuery): allowed only with `parse: 'number'`. */\n    17\texport type StringKey<Row> = KeysWhere<Row, string | null | undefined>;\n    18\t/** A field that can sit on an x axis: numbers, instants, calendar dates or categories. */\n    19\texport type XKey<Row> = KeysWhere<Row, number | string | Date | null | undefined>;\n    20\t/** A field that names a series. */\n    21\texport type SeriesKey<Row> = KeysWhere<Row, string | number | boolean>;\n    22\t\n    23\texport type XValue = number | string | Date;\n    24\t\n    25\t// ---------- fields ----------\n    26\t\n    27\tinterface FieldCommon {\n    28\t  /** Axis title and the name used in tooltip, table and announcements. */\n    29\t  label?: string;\n    30\t  /** Unit appended to values in tooltip, table and announcements: 'ms', 'USD', … */\n    31\t  unit?: string;\n    32\t}\n    33\t\n    34\texport interface ValueFieldOptions extends FieldCommon {\n    35\t  /** Declares percentage data and its convention: 'percent' = 0–100, 'ratio' = 0–1. Never inferred from the label. */\n    36\t  scale?: 'percent' | 'ratio';\n    37\t  /** How values are written in tooltip, table and announcements. Default: locale grouping, up to 6 significant fraction digits. */\n    38\t  format?: Intl.NumberFormatOptions | ((value: number) => string);\n    39\t  /** How axis ticks are written. Default: compact when it saves space. */\n    40\t  tickFormat?: Intl.NumberFormatOptions | ((value: number) => string);\n    41\t  /** What a missing value means. 'gap' (default) draws nothing; 'zero' is for counts where absence means none. */\n    42\t  missing?: 'gap' | 'zero';\n    43\t  /** Author bounds. On bar and area the domain is widened to include zero and AX110 is raised if it did not. */\n    44\t  domain?: readonly [number, number];\n    45\t}\n    46\t\n    47\texport type ValueField<Row> =\n    48\t  | NumberKey<Row>\n    49\t  | ({ field: NumberKey<Row>; parse?: never } & ValueFieldOptions)\n    50\t  | ({ field: StringKey<Row>; parse: 'number' } & ValueFieldOptions);\n    51\t\n    52\texport interface XFieldOptions extends FieldCommon {\n    53\t  /**\n    54\t   * 'date': calendar dates ('2026-02-24'); read the same in every time zone.\n    55\t   * 'time': instants (epoch milliseconds, Date objects, ISO strings with an offset); shown in `timeZone`.\n    56\t   * 'number' and 'category' as named. Inferred when omitted, except that numbers are never inferred to be instants.\n    57\t   */\n    58\t  type?: 'number' | 'time' | 'date' | 'category';\n    59\t  /** Category axes only: the categories have a natural order (months, age bands), so labels may be thinned when they do not fit. */\n    60\t  ordered?: boolean;\n    61\t  /** For instants only. Default 'local' (the viewer's zone). */\n    62\t  timeZone?: 'local' | 'UTC' | (string & {});\n    63\t  format?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n    64\t  tickFormat?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n    65\t  domain?: readonly [XValue, XValue];\n    66\t}\n    67\t\n    68\texport type XField<Row> = XKey<Row> | ({ field: XKey<Row> } & XFieldOptions);\n    69\t\n    70\t/** Long form: one row per (x, series). Wide form: one row per x, one column per series. Never both. */\n    71\texport type Encoding<Row> =\n    72\t  | { x: XField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> }\n    73\t  | { x: XField<Row>; y: readonly ValueField<Row>[]; series?: never };\n    74\t\n    75\t// ---------- options ----------\n    76\t\n    77\texport interface Title { text: string; visible?: boolean; level?: 2 | 3 | 4 | 5 | 6 }\n    78\t\n    79\texport interface CommonOptions<Row> {\n    80\t  data: Data<Row>;\n    81\t  /** Visible heading and accessible name. */\n    82\t  title?: string | Title;\n    83\t  /** Id of an existing heading that names the chart, for dashboard cards that already show a title. */\n    84\t  labelledBy?: string;\n    85\t  subtitle?: string;\n    86\t  /** Added to the generated summary. Mandatory disclosures (time zone, omitted values) are kept. */\n    87\t  description?: string;\n    88\t  state?: 'ready' | 'loading' | { error: string } | { empty: string };\n    89\t  legend?: 'auto' | false | 'top' | 'right' | 'bottom';\n    90\t  tooltip?: boolean;\n    91\t  /** \"View as table\" control. Default true. */\n    92\t  table?: boolean;\n    93\t  /** Fixed color per series name, so \"Direct\" is the same color on every chart: { Direct: 'var(--brand-1)' }. */\n    94\t  colors?: Readonly<Record<string, string>>;\n    95\t  /** Overrides for built-in text (\"View as table\", \"No data\", …). */\n    96\t  messages?: Partial<Messages>;\n    97\t  /** Default: the document language. */\n    98\t  locale?: string;\n    99\t  /** Throw on any warning or error diagnostic, synchronously from the call that caused it. */\n   100\t  strict?: boolean;\n   101\t  onDiagnostic?: (diagnostic: Diagnostic) => void;\n   102\t}\n   103\t\n   104\texport interface Reference {\n   105\t  x?: XValue | readonly [XValue, XValue];\n   106\t  y?: number | readonly [number, number];\n   107\t  label: string;\n   108\t}\n   109\t\n   110\texport interface CartesianOptions {\n   111\t  /** Default true on time, date and number x axes. 'touch' also captures pinch and two-finger drag on touch screens. */\n   112\t  zoom?: boolean | 'touch';\n   113\t  reference?: readonly Reference[];\n   114\t}\n   115\t\n   116\t/** Line, area and bar only. Marks only, as a static image with a text alternative: no axes, legend, toolbar, table, zoom or tooltip. */\n   117\texport interface CompactOption { compact?: boolean }\n   118\t\n   119\texport type LineOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row>;\n   120\texport type AreaOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { stacked?: boolean };\n   121\texport type BarOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { layout?: 'grouped' | 'stacked'; horizontal?: boolean };\n   122\t/** Scatter relates two measures: its x is a number, an instant or a date, never a category. */\n   123\texport type ScatterXField<Row> = XKey<Row> | ({ field: XKey<Row>; type?: 'number' | 'time' | 'date'; ordered?: never } & Omit<XFieldOptions, 'type' | 'ordered'>);\n   124\texport type ScatterOptions<Row> = CommonOptions<Row> & CartesianOptions & { x: ScatterXField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> };\n   125\texport type DonutOptions<Row> = CommonOptions<Row> & { label: SeriesKey<Row>; value: ValueField<Row> };\n   126\t\n   127\t// ---------- handle ----------\n   128\t\n   129\t/**\n   130\t * `x`, and the two ends of a `zoom` event, are in the form `zoom()` accepts for the axis: a Date for instants,\n   131\t * 'YYYY-MM-DD' for calendar dates, an ISO date-time without offset for wall-clock times, the category for a\n   132\t * category axis, otherwise the number. They can be passed to another chart's `zoom()` unchanged.\n   133\t */\n   134\texport interface Point<Row> { series: string; x: XValue; y: number | null; row: Row | null; index: number }\n   135\t\n   136\texport interface ChartEvents<Row> {\n   137\t  hover: Point<Row> | null;\n   138\t  select: Point<Row>;\n   139\t  zoom: readonly [XValue, XValue] | null;\n   140\t}\n   141\t\n   142\texport interface Chart<Row, Options> {\n   143\t  /**\n   144\t   * Changes options. Keys present replace the old value; a key set to `undefined` returns to its default; absent keys stay.\n   145\t   * Validation and diagnostics are synchronous (a `strict` chart throws here and keeps its last valid state); drawing happens on the next frame.\n   146\t   */\n   147\t  update(patch: Partial<Options>): void;\n   148\t  /** Adds rows at the end. `keep` = number of distinct x values retained; older ones are dropped. */\n   149\t  append(rows: readonly Row[], options?: { keep?: number }): void;\n   150\t  /** Sets the visible x range; `null` shows everything. */\n   151\t  zoom(domain: readonly [XValue, XValue] | null): void;\n   152\t  on<E extends keyof ChartEvents<Row>>(event: E, listener: (payload: ChartEvents<Row>[E]) => void): () => void;\n   153\t  /** Diagnostics for the current options and data. Up to date as soon as create, update or append returns. */\n   154\t  readonly diagnostics: readonly Diagnostic[];\n   155\t  destroy(): void;\n   156\t}\n   157\t\n   158\texport type Target = string | HTMLElement;\n   159\t\n   160\t\n   161\t\n   162\t\n   163\t\n   164\t\n   165\t\n   166\t// ---------- diagnostics ----------\n   167\t\n   168\texport interface Diagnostic {\n   169\t  /** Stable and documented, one page per code. */\n   170\t  code: `AX${number}`;\n   171\t  level: 'error' | 'warning' | 'hint';\n   172\t  /** What is wrong, where, and how to fix it. */\n   173\t  message: string;\n   174\t  /** The chart it came from: its title, else its element id. */\n   175\t  chart: string;\n   176\t  /** Where applicable. A diagnostic about the chart as a whole (no title, low contrast) has neither. */\n   177\t  field?: string;\n   178\t  /** First offending row indexes in the caller's own data, capped at 10. */\n   179\t  rows?: readonly number[];\n   180\t  count?: number;\n   181\t}\n   182\t\n   183\t/** Runs normalization and validation only. Works without a DOM, so a server or an agent can check options before rendering. */\n   184\t\n   185\t/** Built-in text. Templates use {name} placeholders. Every entry can be replaced through `messages` (spec A10). */\n   186\texport interface Messages {\n   187\t  viewAsTable: string; hideTable: string;\n   188\t  noData: string; noObservation: string; incompleteStack: string;\n   189\t  moreRows: string; otherSlices: string;\n   190\t  valuesNotShown: string; valuesChanged: string; labelsHidden: string;\n   191\t  loading: string; empty: string; error: string; internalError: string;\n   192\t  chartName: string; chartSummary: string; seriesSummary: string; referenceSummary: string; timeZoneNote: string;\n   193\t  plotLabel: string; controlsLabel: string; pointOf: string;\n   194\t  zoomIn: string; zoomOut: string; resetZoom: string; pause: string; resume: string;\n   195\t  previousPage: string; nextPage: string; pageOf: string; jumpToX: string;\n   196\t  showSeries: string; hideSeries: string;\n   197\t  /** Column headers and nouns. */\n   198\t  category: string; percentage: string; series: string; value: string;\n   199\t  /** Chart type names used in generated names and summaries. */\n   200\t  typeLine: string; typeArea: string; typeBar: string; typeScatter: string; typeDonut: string;\n   201\t  /** Summary sentences that have no cartesian form. */\n   202\t  donutSummary: string; seriesNoData: string; seriesNotDrawn: string; referenceLine: string; reference