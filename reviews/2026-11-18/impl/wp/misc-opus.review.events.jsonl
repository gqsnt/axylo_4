\texport const BENCH = path.dirname(fileURLToPath(import.meta.url));\n    24\texport const REPO = path.resolve(BENCH, '..');\n    25\texport const ARTIFACTS = path.join(BENCH, 'artifacts');\n    26\t\n    27\texport const sha256 = buf => crypto.createHash('sha256').update(buf).digest('hex');\n    28\tconst readJson = p => JSON.parse(fs.readFileSync(p, 'utf8'));\n    29\t\n    30\texport function libraryVersions(source = REPO) {\n    31\t  const v = {};\n    32\t  for (const name of ['uplot', 'chart.js', 'chartjs-adapter-date-fns', 'date-fns']) {\n    33\t    try { v[name] = readJson(path.join(BENCH, 'node_modules', name, 'package.json')).version; } catch { v[name] = 'not available: not installed'; }\n    34\t  }\n    35\t  try { v.axylo = readJson(path.join(source, 'packages/axylo/package.json')).version; } catch { v.axylo = 'not available'; }\n    36\t  return v;\n    37\t}\n    38\t\n    39\tfunction git(cwd, args) {\n    40\t  try { return execFileSync('git', args, { cwd, stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch { return null; }\n    41\t}\n    42\t\n    43\tfunction adapterSources() {\n    44\t  const list = [];\n    45\t  for (const [dir, test] of [['src/adapters', false], ['test/adapters', true]]) {\n    46\t    for (const f of fs.readdirSync(path.join(BENCH, dir))) {\n    47\t      if (!f.endsWith('.js') || f.endsWith('-common.js')) continue;\n    48\t      list.push({ id: f.slice(0, -3), file: path.join(BENCH, dir, f), test });\n    49\t    }\n    50\t  }\n    51\t  return list;\n    52\t}\n    53\t\n    54\tfunction listFiles(dir, base = dir) {\n    55\t  const out = [];\n    56\t  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {\n    57\t    const p = path.join(dir, e.name);\n    58\t    if (e.isDirectory()) out.push(...listFiles(p, base)); else out.push(path.relative(base, p).split(path.sep).join('/'));\n    59\t  }\n    60\t  return out.sort();\n    61\t}\n    62\t\n    63\t/** Reads every file under `dir` once; es