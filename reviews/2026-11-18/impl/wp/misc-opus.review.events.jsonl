sampled in the create workloads only, always outside the timed window.\n    26\tconst memoryWanted = (workload === 'first' || workload === 'page' || workload === 'compact' || workload === 'mem') && params.memory !== false;\n    27\t\n    28\t// The binding's reply arrives inside a DevTools command task, and code continuing after `await` would run inside it\n    29\t// (counted as DevToolsCommandDuration, not ScriptDuration). Measured work therefore starts inside the handler of a\n    30\t// fresh task. TaskDuration counts it either way; this only keeps the secondary script/devtools split honest.\n    31\tconst inTask = fn => new Promise((resolve, reject) => {\n    32\t  const c = new MessageChannel();\n    33\t  c.port1.onmessage = () => { try { resolve(fn()); } catch (e) { reject(e); } };\n    34\t  c.port2.postMessage(0);\n    35\t});\n    36\tconst metrics = label => (window.__benchMetrics ? window.__benchMetrics(label) : Promise.resolve());\n    37\tconst memory = label => (window.__benchMemory ? window.__benchMemory(label) : Promise.resolve());\n    38\tconst done = result => {\n    39\t  if (window.__benchDone) window.__benchDone(result);\n    40\t  else document.getElementById('status').textContent = JSON.stringify(result, (k, v) => (Array.isArray(v) && v.length > 20 ? `[${v.length} values]` : v), 1);\n    41\t};\n    42\tconst raf = () => new Promise(r => requestAnimationFrame(r));\n    43\tconst sleep = ms => new Promise(r => setTimeout(r, ms));\n    44\tconst r3 = v => Math.round(v * 1000) / 1000;\n    45\t\n    46\tfunction pageEnvironment() {\n    47\t  let webgl = 'not available: no WebGL context';\n    48\t  try {\n    49\t    const c = document.createElement('canvas');\n    50\t    const gl = c.getContext('webgl2') || c.getContext('webgl');\n    51\t    if (gl) {\n    52\t      const ext = gl.getExtension('WEBGL_debug_renderer_info');\n    53\t      webgl = ext ? gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) : `not available: WEBGL_debug_renderer_info missing (${gl.getParameter(gl.RENDERER)})`;\n    54\t      gl.getExtension('WEBGL_lose_context')?.loseContext();\n    55\t    }\n    56\t  } catch (e) { webgl = `not available: ${e}`; }\n    57\t  return { devicePixelRatio, userAgent: navigator.userAgent, webglRenderer: webgl, viewport: [innerWidth, innerHeight], hardwareConcurrency: navigator.hardwareConcurrency };\n    58\t}\n    59\t\n    60\t// The refresh rate the page observes: median interval of 60 idle animation frames.\n    61\tasync function observeRefresh() {\n    62\t  const ts = [];\n    63\t  await new Promise(res => { const f = t => { ts.push(t); if (ts.length < 61) requestAnimationFrame(f); else res(); }; requestAnimationFrame(f); });\n    64\t  const d = ts.slice(1).map((t, i) => t - ts[i]).sort((a, b) => a - b);\n    65\t  const median = d[d.length >> 1];\n    66\t  return { medianIntervalMs: r3(median), hz: r3(1000 / median), minMs: r3(d[0]), maxMs: r3(d[d.length - 1]) };\n    67\t}\n    68\t\n    69\tconst LAYOUT = {\n    70\t  page: { grid: 'grid', count: 24 },\n    71\t  compact: { grid: 'grid compact', count: 40 },\n    72\t};\n    73\tfunction containers(count, grid, resizable) {\n    74\t  const root = document.getElementById('root');\n    75\t  const parent = grid || resizable ? Object.assign(document.createElement('div'), { className: `${grid || ''} ${resizable ? 'resize-box' : ''}`.trim() }) : root;\n    76\t  if (parent !== root) root.appendChild(parent);\n    77\t  const els = Array.from({ length: count }, () => parent.appendChild(Object.assign(document.createElement('div'), { className: 'chart' })));\n    78\t  return { els, box: parent };\n    79\t}\n    80\t\n    81\t// Calculated, not measured: bytes a 4-byte-per-pixel backing store needs for every canvas on the page (canvas.width\n    82\t// and canvas.height are device pixels, so the pixel ratio is already in them). The browser may hold more (double\n    83\t// buffering, GPU copies) or less (canvases not yet drawn); the process figures are the measured ones.\n    84\tfunction canvasBacking() {\n    85\t  const root = document.getElementById('root');\n    86\t  let chart = 0, other = 0, count = 0;\n    87\t  for (const c of document.querySelectorAll('canvas')) {\n    88\t    const bytes = c.width * c.height * 4;\n    89\t    if (root.contains(c)) { chart += bytes; count++; } else other += bytes;\n    90\t  }\n    91\t  return { chartCanvasBytes: chart, chartCanvasCount: count, otherCanvasBytes: other, svgElements: root.querySelectorAll('svg').length, svgPaths: root.querySelectorAll('svg path').length, domNodes: root.getElementsByTagName('*').length };\n    92\t}\n    93\t\n    94\t// ── drawing capture (probe runs only) ────────────────────────────────────────────────────────────\n    95\t// Records, per canvas, the polylines each stroke() call drew (moveTo/lineTo between beginPath and stroke, in the\n    96\t// coordinates the library passed, which for a library that draws through setTransform are CSS px), its strokeStyle,\n    97\t// and the last rectangle used as a clip. A clear of the whole canvas starts a new frame's record. Path2D strokes\n    98\t// are recorded as strokes without vertices (uPlot draws that way; its drawn readback comes from its own state).\n    99\tfunction installCapture() {\n   100\t  const P = CanvasRenderingContext2D.prototype;\n   101\t  const by = new WeakMap();\n   102\t  const st = ctx => { let s = by.get(ctx.canvas); if (!s) by.set(ctx.canvas, s = { strokes: [], clip: null, path: [], open: null, rect: null }); return s; };\n   103\t  const orig = {};\n   104\t  const wrap = (name, fn) => { orig[name] = P[name]; P[name] = function (...a) { fn(this, a); return orig[name].apply(this, a); }; };\n   105\t  wrap('beginPath', ctx => { const s = st(ctx); s.path = []; s.open = null; s.rect = null; });\n   106\t  wrap('moveTo', (ctx, [x, y]) => { const s = st(ctx); s.open = [x, y]; s.path.push(s.open); });\n   107\t  wrap('lineTo', (ctx, [x, y]) => { const s = st(ctx)