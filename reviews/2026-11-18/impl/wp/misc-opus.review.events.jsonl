{"type":"item.completed","item":{"id":"item_104","type":"command_execution","command":"/bin/bash -lc \"nl -ba bench/profile.mjs | sed -n '28,73p'; nl -ba bench/README.md | sed -n '136,178p;335,398p'; nl -ba packages/axylo/src/core/chart.ts | sed -n '190,230p'; rg -n 'describe\\\\(|supports tag' bench/test/provenance.test.mjs\"","aggregated_output":"    28\tconst name = `${new Date().toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z')}-${a.workload}-${params.fixture ?? params.size}-${a.adapter.replace(/[^a-zA-Z0-9.-]+/g, '_')}`;\n    29\tconst file = path.join(out, `${name}.cpuprofile`);\n    30\t\n    31\tconst browser = await launchBrowser();\n    32\tconst server = await startServer({ A: artifact });\n    33\ttry {\n    34\t  const r = await runOnce(browser, server, { adapter: ref.id, adapterParams: ref.params, workload: a.workload, params, settleMs: Number(a.settle), timeoutMs: 120000, profile: { file } });\n    35\t  if (r.outcome !== 'ok') { console.error(`run outcome ${r.outcome}: ${r.reason ?? r.error}`); process.exitCode = 1; }\n    36\t  else {\n    37\t    const buildKind = r.result.adapter.params?.build === 'dev' ? 'dev' : 'prod';\n    38\t    const map = artifactMap(artifact.dir, buildKind);\n    39\t    const active = summarizeProfile(JSON.parse(fs.readFileSync(file, 'utf8')), { map, build: buildKind });\n    40\t    const settleFile = file.replace(/\\.cpuprofile$/, '.settle.cpuprofile');\n    41\t    const settle = fs.existsSync(settleFile) ? summarizeProfile(JSON.parse(fs.readFileSync(settleFile, 'utf8')), { map, build: buildKind }) : null;\n    42\t    const served = server.served().A;\n    43\t    const bundle = buildKind === 'dev' ? 'axylo/axylo.iife.js' : 'axylo/axylo.iife.min.js';\n    44\t    const record = {\n    45\t      name, adapter: a.adapter, config: r.result.adapter.config, workload: a.workload, params,\n    46\t      artifact: { id: artifact.id, dir: artifact.dir, source: artifact.source.head, axyloSourceHash: artifact.source.axyloSourceHash, bundle, bundleSha256: served[bundle] ?? 'not served', mapSha256: artifact.files[`${bundle}.map`]?.sha256 ?? 'not available' },\n    47\t      profileFiles: { active: path.relative(BENCH, file), settle: settle ? path.relative(BENCH, settleFile) : null },\n    48\t      environment: machineRecord(browser, { headed: false }), page: r.result.env,\n    49\t      note: 'profiled run: timings are slowed by the profiler and are not comparable with timed runs. \"active\" = create call to the first frame after ready; \"settle\" = the settle period after it.',\n    50\t      active, settle,\n    51\t    };\n    52\t    fs.writeFileSync(path.join(out, `${name}.summary.json`), JSON.stringify(record, null, 1));\n    53\t    for (const [label, s] of [['active', active], ['settle', settle]]) {\n    54\t      if (!s) continue;\n    55\t      console.log(`${name} ${label}: ${s.busyMs} ms busy of ${s.totalMs} ms (${s.mapping})`);\n    56\t      console.log('  self:'); for (const x of s.self.slice(0, 10)) console.log(`    ${String(x.ofBusy ?? '').padStart(5)}%  ${String(x.ms).padStart(8)} ms  ${x.k}`);\n    57\t      console.log('  inclusive:'); for (const x of s.inclusive.slice(0, 10)) console.log(`    ${String(x.ofBusy ?? '').padStart(5)}%  ${String(x.ms).padStart(8)} ms  ${x.k}`);\n    58\t    }\n    59\t  }\n    60\t} finally {\n    61\t  await browser.close();\n    62\t  await server.close();\n    63\t}\n   136\t## Workloads\n   137\t\n   138\t| Workload | Budget | What runs | Containers |\n   139\t|---|---|---|---|\n   140\t| `first` | P1 (`--fixture trend`), P2 (`--size 1x100000`, `1x1000000`) | Create one line chart; any `SxN` (`10x100000` for the renderer decision), `--gaps` | one 800×400 |\n   141\t| `page` | P5 (`--fixture trend`) | 24 charts at once (`trend` each, or `SxN` with its own seed) | 24 of 340×200, 4 columns |\n   142\t| `compact` | P8 | 40 `compact: true` charts, one `trend` series each (spec 3.7, AX131) | 40 of 160×48, 8 columns |\n   143\t| `scatter` | renderer decision | One scatter of 10,000 / 50,000 / 200,000 points (`--size 1xN`), `--clustered` | one 800×400 |\n   144\t| `stream` | P3 | A 600-point window; 300 samples from a producer on an independent 60 Hz clock | one 800×400 |\n   145\t| `hover` | P4 | 200 real pointer moves left to right across a 100,000-point chart (CDP Input) | one 800×400 |\n   146\t| `zoom` | renderer decision | 60 calls to the public zoom: 20 in, 20 out, 20 pan steps, ending on a known window | one 800×400 |\n   147\t| `theme` | – | 20 toggles of a class-based dark theme on `<html>` | one 800×400 |\n   148\t| `resize` | – | 1,200 → 400 → 1,200 px in a fixed sequence of 123 widths, one per frame | 1,200×400, or 24 in 4 columns of 200 px |\n   149\t| `mem` | P7 | Create one chart of 1,000,000 points; memory after forced collection | one 800×400 |\n   150\t| `lifecycle` | P7 | 1,000 create–destroy cycles of `trend` after 20 warm-up cycles | one 800×400 |\n   151\t\n   152\tThe named `trend` fixture (3 × 120 daily points, \"Direct\", \"Organic search\", \"Referral\", a 7-day outage in\n   153\t\"Referral\") is copied value for value from `research/harness/src/data.js`; a test compares the two. Its largest value\n   154\tis the extreme the check reads back (it has no injected one). The synthetic line fixtures are seeded random walks, a\n   155\tday apart up to 1,000 points and a minute apart above, with one extreme injected into series 0 at 37% of the range;\n   156\tgaps never touch the first or last point or the extreme.\n   157\t\n   158\tThe dashboard tiles were 230×115 before this revision. At that size Axylo's plot is below the 120×80 minimum of spec\n   159\tL8, so it shows its text summary instead of marks: the M1 dashboard records have `svgPaths: 0` in every SVG run. The\n   160\tdrawn-geometry admission now rejects such a run (\"the chart drew no line strokes\"); the tiles are 340×200.\n   161\t\n   162\t## Admission\n   163\t\n   164\tBefore an adapter is timed, the runner does one untimed **probe** run per side (`probe=geometry`) and compares the\n   165\treadback with facts derived in Node from the fixture (`src/admission.js`). Every timed run is checked again after its\n   166\tmeasurement window (the readback is never taken inside it). A run that fails is `not-admitted`; its timing is\n   167\tdiscarded and it is not paired. The checks:\n   168\t\n   169\t- **held**: the visible x range contains the expected range (the data's, or the final zoom window) and is not wider\n   170\t  than it plus 10% per side (25% for a scatter's number axis, which may round to nice ticks); the visible y range\n   171\t  contains the data's y extent in that window and the extreme, and is at most 4× the data's scale; per series the\n   172\t  points held, the oldest and newest x to the millisecond, and the number of missing values (**required** from every\n   173\t  adapter); the page built the same data as the runner (FNV-1a checksum).\n   174\t- **drawn**, index readback (uPlot, Chart.js): the source indices the library draws, as connected paths. Rejected:\n   175\t  two retained neighbours joined across a missing source value, a drawn point at a missing value, drawn indices that\n   176\t  do not cover the visible window, drawn extremes in the window that are not the data's extremes.\n   177\t- **drawn**, pixel readback (Axylo, probe runs only): the polylines the library stroked (SVG path data; Canvas 2D\n   178\t  moveTo/lineTo on the scene canvas, recorded only in the probe run), mapped through the plot clip rectangle and the\n   190\t        // missing; that keeps the L8 decision continuous below zero.\n   191\t        const overflow = plot.height < 1 ? Math.max(0, figure.figure.scrollHeight - figure.figure.clientHeight) : 0;\n   192\t        const stage = figure.stage.getBoundingClientRect();\n   193\t        return { width: plot.width / sx, height: plot.height / sy - overflow, room: { width: stage.width / sx, height: stage.height / sy } };\n   194\t      },\n   195\t      devicePixelRatio: () => win.devicePixelRatio || 1,\n   196\t      // Scoped to this chart's own figure: properties and the scheme go with it (finding 10).\n   197\t      theme: (keys, colors) => resolveTheme(figure.figure, keys, colors),\n   198\t      surfaces(visible) {\n   199\t        // Hidden without drawing: the error revision does not depend on the methods that may have failed.\n   200\t        for (const el of [renderer.element, textLayer.element]) (el as HTMLElement).style.visibility = visible ? '' : 'hidden';\n   201\t      },\n   202\t      dispose: release,\n   203\t    });\n   204\t    resizeObserver.observe(figure.plot);\n   205\t    resizeObserver.observe(figure.figure);\n   206\t    if (root.isConnected) watch();\n   207\t    return controller.handle;\n   208\t  } catch (error) {\n   209\t    // A rejected strict create, or a failure part-way through: nothing stays behind, a controller that was\n   210\t    // already created (its first frame queued) included (review 3, finding 9).\n   211\t    const created = controller as Controller | null;\n   212\t    controller = null;\n   213\t    try { created?.handle.destroy(); } catch { /* releasing the rest matters more */ }\n   214\t    release();\n   215\t    throw error;\n   216\t  }\n   217\t}\n   218\t\n   219\tfunction resolveTarget(target: unknown): HTMLElement {\n   220\t  if (typeof target === 'string') {\n   221\t    const doc = (globalThis as { document?: Document }).document;\n   222\t    if (!doc) throw new Error(`Axylo: no document to find the target ${JSON.stringify(target)} in.`);\n   223\t    let found: Element | null = null;\n   224\t    try {\n   225\t      found = doc.querySelector(target);\n   226\t    } catch {\n   227\t      throw new Error(`Axylo: the target selector ${JSON.stringify(target)} is not a valid CSS selector.`);\n   228\t    }\n   229\t    if (!found) throw new Error(`Axylo: the target selector ${JSON.stringify(target)} matches no element.`);\n   230\t    return found as HTMLElement;\n","exit_code":1,"status":"failed"}}
