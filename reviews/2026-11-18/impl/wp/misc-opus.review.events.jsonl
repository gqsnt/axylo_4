  |  176 +-\n .../configs/{fit-l.json => dark-n2-m4.json}        |  147 +-\n .../palette/configs/{fit-n.json => dark-n2.json}   |   69 +-\n research/palette/configs/even-a.json               |  447 ++++\n research/palette/configs/even-c.json               |  447 ++++\n research/palette/configs/fit-c.json                |  286 ---\n research/palette/configs/fit-final.json            |  391 +--\n research/palette/configs/fit-g.json                |  286 ---\n research/palette/configs/fit-k.json                |  286 ---\n research/palette/configs/fit-o.json                |  286 ---\n research/palette/configs/green-a.json              |  447 ++++\n research/palette/configs/green-b.json              |  447 ++++\n research/palette/configs/mag4-a.json               |  447 ++++\n research/palette/configs/red3-a.json               |  447 ++++\n research/palette/configs/tier-44-free.json         |  447 ++++\n research/palette/configs/tier-46-cr.json           |  447 ++++\n research/palette/configs/walk-b.json               |  447 ++++\n research/palette/explore.mjs                       |   36 +-\n research/palette/fit.mjs                           |   58 +-\n research/palette/palette.json                      | 2604 ++++++++++++++------\n research/palette/preview-dark.png                  |  Bin 295561 -> 299218 bytes\n research/palette/preview-light.png                 |  Bin 295829 -> 294079 bytes\n research/palette/preview.html                      |    6 +-\n research/palette/raster.json                       |  124 +\n research/palette/raster.mjs                        |   53 +\n research/palette/references.json                   |  289 +++\n research/palette/references.mjs                    |   33 +\n research/palette/score.mjs                         |   97 +-\n research/palette/strokes.json                      |  544 ++--\n reviews/2026-11-18/impl/wp/palette.fix.report.md   |   87 +\n reviews/2026-11-18/impl/wp/reader-fix-2.prompt.md  |   16 +\n 42 files changed, 9626 insertions(+), 2677 deletions(-)\ncommit a63bbeea30131a9c77783aa51528779492c596c0\nAuthor: canarit <gaqu1994@gmail.com>\nDate:   Wed Nov 18 04:48:27 2026 +0100\n\n    React adapter: review fixes (14 findings) and a real build\n    \n    Fixes by the adapter's author (Claude Opus 5.5 high) for the findings of\n    the Codex gpt-6.2-astra review: the package now builds dist (production,\n    development, declarations) with the 'use client' directive; creation and\n    updates run in the layout phase; own-key undefined restores defaults; the\n    comparator cannot overflow; host attributes go to the div; a Line-only\n    import keeps one chart type. Coordinator runs: 34 unit and 31 browser tests\n    pass; production file 1,436 B gzipped (gzip -9). React 18 and Fast Refresh\n    remain untested. The lockfile still lists the react-dom peer.\n    \n    Co-Authored-By: Claude Fable 5.2 <noreply@anthropic.com>\n\n packages/react/build.mjs                          |  39 +++\n packages/react/package.json                       |   2 +-\n packages/react/src/index.ts                       | 120 ++++----\n packages/react/src/patch.ts                       |  94 ++++--\n packages/react/test/browser/app.tsx               | 122 ++++++--\n packages/react/test/browser/probe.ts              |  14 +-\n packages/react/test/browser/react.browser.test.ts | 360 ++++++++++++++++++----\n packages/react/test/browser/spy-axylo.ts          |  42 ++-\n packages/react/test/consumer/consumer.tsx         |  25 ++\n packages/react/test/consumer/tsconfig.json        |   7 +\n packages/react/test/dist.test.ts                  | 117 +++++++\n packages/react/test/patch.test.ts                 | 110 ++++++-\n packages/react/test/server.test.ts                |  55 ----\n packages/react/test/size.test.ts                  |  29 --\n packages/react/test/types.check.tsx               |  21 +-\n packages/react/tsconfig.build.json                |   5 +\n packages/react/tsconfig.json                     