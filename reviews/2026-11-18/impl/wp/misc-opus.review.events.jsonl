ommit(page, [{ type: 'Line', data: 'single', callbackRef: true, props: { x: 'day', y: 'sessions', title: 'Early' } }]);\n   200\t    expect(seen).toEqual([\n   201\t      { index: 0, effect: 'callback ref', attached: true, chart: true },\n   202\t      { index: 0, effect: 'parent layout', chart: true, diagnostics: 0 },\n   203\t    ]);\n   204\t    expect(await closeApp(page)).toEqual([]);\n   205\t  });\n   206\t\n   207\t  it('a parent layout effect that appends after a data change appends to the new data', async () => {\n   208\t    const page = await open();\n   209\t    const props = { x: 'day', y: 'sessions', title: 'Order' };\n   210\t    await render(page, [{ type: 'Line', data: 'single', props }]);\n   211\t    const seen = await commit(page, [{ type: 'Line', data: 'single again', props, layout: { append: [next] } }]);\n   212\t    expect(seen).toEqual([{ index: 0, effect: 'parent layout', chart: true, diagnostics: 0 }, { index: 0, action: 'ok' }]);\n   213\t    await page.evaluate(() => window.app.ready());\n   214\t    expect(await points(page)).toBe(11);\n   215\t    expect(await closeApp(page)).toEqual([]);\n   216\t  });\n   217\t\n   218\t  it('diagnostics read in a parent layout effect describe the props of that commit', async () => {\n   219\t    const page = await open();\n   220\t    const props = { x: 'day', y: 'sessions', title: 'Current' };\n   221\t    await render(page, [{ type: 'Line', data: 'single', props }]);\n   222\t    const seen = await commit(page, [{ type: 'Line', data: 'bad', props }]);\n   223\t    const settled = await page.evaluate(() => window.app.chart(0)!.diagnostics.map(d => d.code));\n   224\t    expect(settled).toContain('AX106');\n   225\t    expect(seen).toEqual([{ index: 0, effect: 'parent layout', chart: true, diagnostics: settled.length }]);\n   226\t    expect(await closeApp(page)).toEqual([]);\n   227\t  });\n   228\t\n   229\t  it('after a Suspense fallback, the revealed chart is the same one and matches the revealing commit', async () => {\n   230\t    const page = await open();\n   231\t    const props = { x: 'day', y: 'sessions', title: 'Suspended' };\n   232\t    await render(page, [{ type: 'Line', data: 'single', props }]);\n   233\t    await commit(page, [{ type: 'Line', data: 'single', props }], { suspend: true });\n   234\t    expect(await page.locator('#chart .fallback').count()).toBe(1);\n   235\t    const seen = await commit(page, [{ type: 'Line', data: 'single again', props, layout: { append: [next] } }]);\n   236\t    expect(seen.at(-1)).toEqual({ index: 0, action: 'ok' });\n   237\t    await page.evaluate(() => window.app.ready());\n   238\t    expect(await points(page)).toBe(11);\n   239\t    expect(await spyState(page)).toEqual({ attempts: 1, charts: [{ kind: 'line', destroys: 0, updates: [['data']] }] });\n   240\t    expect(await closeApp(page)).toEqual([]);\n   241\t  });\n   242\t\n   243\t  it('onDiagnostic replaced, removed and reinstated takes effect within the commit', async () => {\n   244\t    const page = await open();\n   245\t    const props = { x: 'day', y: 'sessions', title: 'Diagnostics' };\n   246\t    // A zoom window that cannot be read is reported synchronously, every time (spec 3.5).\n   247\t    const zoomBadly = { zoom: ['not a day', 'nor this'] };\n   248\t    await render(page, [{ type: 'Line', data: 'single', props, on: { diagnostic: 'A' } }]);\n   478\t    expect(await closeApp(page)).toEqual([]);\n   479\t  });\n   480\t});\n   481\t\n   482\tdescribe('errors', () => {\n   483\t  it('a strict chart with bad data is caught by an error boundary and recovers when given good data', async () => {\n   484\t    const page = await open();\n   485\t    const props = { x: 'day', y: 'sessions', title: 'Strict data', strict: true };\n   486\t    const caught = () => page.evaluate(() => document.querySelector('#chart .caught')?.textContent ?? null);\n   487\t    const original = () => page.evaluate(() => window.app.caught.at(-1) === window.app.s