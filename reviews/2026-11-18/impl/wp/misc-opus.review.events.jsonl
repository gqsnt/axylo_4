 snapshot the build compiles, not the tree after it.\n   101\t  const status = git(source, ['status', '--short', '--', 'packages/axylo']);\n   102\t  const snapshot = fs.existsSync(srcDir) ? snapshotSources(srcDir) : new Map();\n   103\t  const versions = libraryVersions(source);\n   104\t  const common = {\n   105\t    bundle: true, format: 'esm', target: 'es2022', minify: true, legalComments: 'none', logLevel: 'warning',\n   106\t    loader: { '.css': 'text' },\n   107\t    // Production builds of every library (Chart.js and uPlot have no separate dev mode; this pins NODE_ENV anyway).\n   108\t    define: { __VERSIONS__: JSON.stringify(versions), 'process.env.NODE_ENV': '\"production\"' },\n   109\t  };\n   110\t  const adapters = adapterSources();\n   111\t  // Same options as scripts/build.mjs for the two script-tag files, plus an external source map, which leaves the\n   112\t  // JavaScript byte-identical (checked below).\n   113\t  const axyloCommon = { entryPoints: [path.join(srcDir, 'index.ts')], bundle: true, target: 'es2022', legalComments: 'none', logLevel: 'warning', format: 'iife', globalName: 'Axylo', absWorkingDir: source };\n   114\t  const used = new Map();\n   115\t  const axyloBuilds = snapshot.size ? [\n   116\t    esbuild({ ...axyloCommon, minify: true, define: { __DEV__: 'false' }, sourcemap: 'external', outfile: path.join(dir, 'axylo/axylo.iife.min.js'), plugins: [snapshotPlugin(snapshot, srcDir, used)] }),\n   117\t    esbuild({ ...axyloCommon, define: { __DEV__: 'true' }, sourcemap: 'external', outfile: path.join(dir, 'axylo/axylo.iife.js'), plugins: [snapshotPlugin(snapshot, srcDir, used)] }),\n   118\t  ] : [];\n   119\t  await Promise.all([\n   120\t    esbuild({ ...common, entryPoints: [path.join(BENCH, 'src/page.js')], outfile: path.join(dir, 'page.js') }),\n   121\t    ...adapters.map(a => esbuild({ ...common, entryPoints: [a.file], outfile: path.join(dir, 'adapters', `${a.id}.js`) })),\n   122\t    ...axyloBuilds,\n   123\t  ]);\n   124\t  fs.copyFileSync(path.join(BENCH, 'src/page.html'), path.join(dir, 'index.html'));\n   125\t\n   126\t  let shippedOptions = 'not available: no Axylo sources';\n   127\t  let distComparison = 'not available: no packages/axylo/dist/axylo.iife.min.js in the source checkout';\n   128\t  if (snapshot.size) {\n   129\t    const plain = await esbuild({ ...axyloCommon, minify: true, define: { __DEV__: 'false' }, write: false, outfile: path.join(dir, 'axylo/axylo.iife.min.js'), plugins: [snapshotPlugin(snapshot, srcDir, new Map())] });\n   130\t    const built = fs.readFileSync(path.join(dir, 'axylo/axylo.iife.min.js'));\n   131\t    shippedOptions = Buffer.compare(Buffer.from(plain.outputFiles[0].contents), built) === 0\n   132\t      ? 'identical: the measured bundle is byte-for-byte what scripts/build.mjs options produce from this snapshot'\n   133\t      : 'DIFFERENT: the source-mapped build differs from a plain build; the source map may not describe the measured bytes';\n   134\t    const dist = path.join(source, 'packages/axylo/dist/axylo.iife.min.js');\n   135\t    if (fs.existsSync(dist)) distComparison = Buffer.compare(fs.readFileSync(dist), built) === 0 ? 'identical to packages/axylo/dist/axylo.iife.min.js at build time' : 'differs from packages/axylo/dist/axylo.iife.min.js at build time (that file was built from another source state)';\n   136\t  }\n   137\t\n   138\t  const files = {};\n   139\t  for (const rel of listFiles(dir)) { const b = fs.readFileSync(path.join(dir, rel)); files[rel] = { sha256: sha256(b), bytes: b.length }; }\n   140\t  const inputs = Object.fromEntries([...used.entries()].sort());\n   141\t  const manifest = {\n   142\t    schema: 'axylo-bench-artifact/1',\n   143\t    id: path.basename(dir),\n   144\t    builtAt: new Date().toISOString(),\n   145\t    source: {\n   146\t      root: source,\n   147\t      head: head ?? 'not available: not a git checkout (or git failed)',\n   148\t      uncommitted: status === null ? 'not available' : status === '' ? 'clean' : status.split('\\n'),\n   149\t      axyloInputs: inputs,\n   150\t      axyloSourceHash: sha256(Object.entries(inputs).map(([p, h]) => `${p} ${h}\\n`).join('')),\n   151\t      shippedOptions, distComparison,\n   152\t    },\n   153\t    bench: { head: git(BENCH, ['rev-parse', 'HEAD']) ?? 'not available', uncommitted: (git(BENCH, ['status', '--short', '--', '.']) ?? 'not available') || 'clean' },\n   154\t    esbuild: esbuildVersion,\n   155\t    versions,\n   156\t    adapters: Object.fromEntries(adapters.map(a => [a.id, { file: `adapters/${a.id}.js`, test: a.test }])),\n   157\t    files,\n   158\t  };\n   159\t  fs.writeFileSync(path.join(dir, 'manifest.json'), JSON.stringify(manifest, null, 1));\n   160\t  seal(dir);\n   161\t  return { ...manifest, dir };\n   162\t}\n   163\t\n   164\tfunction seal(dir) {\n   165\t  for (const e of fs.readdirSync(dir, { withFileTypes: true })) {\n   166\t    const p = path.join(dir, e.name);\n   167\t    if (e.isDirectory()) seal(p); else fs.chmodSync(p, 0o444);\n   168\t  }\n   169\t  fs.chmodSync(dir, 0o555);\n   170\t}\n   171\t\n   172\t/** Makes an artifact writable again and removes it (tests and scratch use only). */\n   173\texport function removeArtifact(dir) {\n   174\t  if (!fs.existsSync(dir)) return;\n   175\t  const open = d => { fs.chmodSync(d, 0o755); for (const e of fs.readdirSync(d, { withFileTypes: true })) if (e.isDirectory()) open(path.join(d, e.name)); };\n   176\t  open(dir);\n   177\t  fs.rmSync(dir, { recursive: true, force: true });\n   178\t}\n   179\t\n   180\t/**\n   181\t * Loads an artifact's manifest and checks every file against it. Throws when a file is missing, extra, or differs:\n   182\t * a session never serves bytes other than the ones its record names.\n   183\t */\n   184\texport function readArtifact(dir) {\n   185\t  dir = path.resolve(dir);\n   186\t  const mf = path.join(dir, 'manifest.json');\n   187\t  if (!fs.existsSync(mf)) throw new Error(`${dir} is not a bench artifact (no manifest.json); build one with node bench/build.mjs`);\n   188\t  const manifest = readJson(mf);\n   189\t  const problems = [];\n   190\t  const present = new Set(listFiles(dir).filter(f => f !== 'manifest.json'));\n   191\t  for (const [rel, f] of Object.entries(manifest.files)) {\n   192\t    if (!present.has(rel)) { problems.push(`${rel} missing`); continue; }\n   193\t    present.delete(rel);\n   194\t    if (sha256(fs.readFileSync(path.join(dir, rel))) !== f.sha256) problems.push(`${rel} changed since the build`);\n   195\t  }\n   196\t  for (const rel of present) problems.push(`${rel} is not in the manifest`);\n   197\t  if (problems.length) throw new Error(`artifact ${dir} does not match its manifest: ${problems.join('; ')}`);\n   198\t  return { ...manifest, dir, manifestSha256: sha256(fs.readFileSync(mf)) };\n   199\t}\n   200\t\n   201\tif (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n   202\t  const { values } = parseArgs({ options: { source: { type: 'string' }, out: { type: 'string' } } });\n   203\t  const m = await build({ source: values.source, out: values.out });\n   204\t  console.log(`built artifact ${m.dir}\\n  Axylo sources: ${m.source.head} (${Array.isArray(m.source.uncommitted) ? `${m.source.uncommitted.length} uncommitted changes` : m.source.uncommitted}), source hash ${m.source.axyloSourceHash.slice(0, 16)}\\n  production bundle: ${m.source.shippedOptions}; ${m.source.distComparison}\\n  adapters: ${Object.keys(m.adapters).join(', ')}`);\n   205\t}\n     1\t# Not yet run: the repository has no remote. Written against the commands that\n     2\t# pass locally on Linux with system Chrome; Windows and macOS results are\n     3\t# unknown until this runs there.\n     4\tname: ci\n     5\t\n     6\ton:\n     7\t  push:\n     8\t    branches: [main]\n     9\t  pull_request:\n    10\t\n    11\tpermissions:\n    12\t  contents: read\n    13\t\n    14\tjobs:\n    15\t  check:\n    16\t    strategy:\n    17\t      fail-fast: false\n    18\t      matrix:\n    19\t        os: [ubuntu-latest, windows-latest, macos-latest]\n    20\t    runs-on: ${{ matrix.os }}\n    21\t    timeout-minutes: 20\n    22\t    steps:\n    23\t      - uses: actions/checkout@v4\n    24\t      - uses: actions/setup-node@v4\n    25\t        with:\n    26\t          node-version: 24\n    27\t          cache: npm\n    28\t      - run: npm ci\n    29\t      - run: npm run typecheck\n    30\t      - run: npm test\n    31\t      - run: npm run build\n    32\t      # The browser tests launch the runner's installed Chrome\n    33\t      # (playwright-core, channel \"chrome\"); no browser download.\n    34\t      # Called directly, not through the npm script: that script sets the\n    35\t      # variable with POSIX syntax, which npm on Windows runs through cmd.exe.\n    36\t      - run: npx vitest run\n    37\t        env:\n    38\t          AXYLO_BROWSER: 1\n    39\t      # The packed tarballs, unpacked into clean fixtures.\n    40\t      - run: npx vitest run --config tests/dist/vitest.config.ts\n    41\t      - run: npx vitest run --config tests/dist/vitest.config.ts\n    42\t        env:\n    43\t          AXYLO_BROWSER: 1\n    44\t      # Reports sizes of the packed files. Add \"-- --check\" once the size targets gate CI.\n    45\t      - run: npm run size\n    46\t      - run: node --test bench/test/*.test.mjs\n    47\t        shell: bash\n    48\t      - run: node --test --test-concurrency=1 bench/test/browser/*.test.mjs\n    49\t        shell: bash\n    50\t      - run: node --test acceptance/test/*.test.mjs\n    51\t        shell: bash\n    52\t      - run: node acceptance/check.mjs\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"nl -ba bench/lib/profile-summary.mjs; nl -ba bench/profile.mjs | sed -n '1,155p'; nl -ba bench/results/make-m1-report.mjs | sed -n '1,110p;185,240p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_69","type":"command_execution","command":"/bin/bash -lc \"nl -ba bench/lib/profile-summary.mjs; nl -ba bench/profile.mjs | sed -n '1,155p'; nl -ba bench/results/make-m1-report.mjs | sed -n '1,110p;185,240p'\"","aggregated_output":"     1\t// Attributes a Chrome CPU profile (CDP Profiler) of an Axylo run to the library's pipeline stages, two ways:\n     2\t//\n     3\t//   self       each sample goes to its leaf frame: the Axylo module of that function when the leaf is Axylo code,\n     4\t//              otherwise its category ((program): native main-thread work outside JavaScript such as style, layout\n     5\t//              and paint; (garbage collector); (idle); other JavaScript). A browser API called from Axylo that V8\n     6\t//              does not show as a frame of its own counts as self time of the calling Axylo function.\n     7\t//   inclusive  each sample counts once for every stage that has a frame anywhere on its stack, so a stage's\n     8\t//              inclusive share includes the work it called; shares do not add up to 100%.\n     9\t//\n    10\t// Positions are mapped to source modules through the source map bench/build.mjs wrote next to each bundle in the\n    11\t// sealed artifact the profiled run loaded, for the production and the development build alike; no rebuild is\n    12\t// involved, so the map describes the measured bytes (the build checks that the map does not change them).\n    13\t// What this cannot do: recover frames V8 inlined away (their time shows in the caller), attribute garbage\n    14\t// collection to the code that allocated, or see work on other threads (raster, GPU).\n    15\timport fs from 'node:fs';\n    16\timport path from 'node:path';\n    17\t\n    18\t/** Directory (or file) under packages/axylo/src -> the pipeline stage named in the M1 brief. */\n    19\texport const STAGE_OF = {\n    20\t  data: 'normalize',\n    21\t  view: 'view', scale: 'view',\n    22\t  layout: 'layout', format: 'layout',\n    23\t  scene: 'scene', simplify: 'scene',\n    24\t  lookup: 'lookup',\n    25\t  reader: 'reader',\n    26\t  render: 'draw',\n    27\t  dom: 'DOM',\n    28\t  theme: 'theme (not one of the eight)',\n    29\t  core: 'orchestration: core/ (chart.ts, options, delivery)',\n    30\t  diagnostics: 'orchestration: diagnostics/',\n    31\t  messages: 'orchestration: messages/',\n    32\t  'index.ts': 'orchestration: index.ts',\n    33\t};\n    34\texport const stageOf = mod => STAGE_OF[mod.split('/')[0]] ?? `other: ${mod}`;\n    35\t\n    36\tconst B64 = Object.fromEntries([...'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'].map((c, i) => [c, i]));\n    37\texport function decodeVlq(str) {\n    38\t  const out = [];\n    39\t  let shift = 0, value = 0;\n    40\t  for (const ch of str) {\n    41\t    const d = B64[ch];\n    42\t    value += (d & 31) << shift;\n    43\t    if (d & 32) shift += 5;\n    44\t    else { out.push(value & 1 ? -(value >>> 1) : value >>> 1); value = 0; shift = 0; }\n    45\t  }\n    46\t  return out;\n    47\t}\n    48\t\n    49\t/** A source map (v3) -> (line, column) => module path under packages/axylo/src, or null. */\n    50\texport function positionMap(map) {\n    51\t  const sources = map.sources.map(s => { const i = s.indexOf('packages/axylo/src/'); return i >= 0 ? s.slice(i + 'packages/axylo/src/'.length) : s; });\n    52\t  const lines = [];\n    53\t  let src = 0;\n    54\t  map.mappings.split(';').forEach(segs => {\n    55\t    const row = [];\n    56\t    let col = 0;\n    57\t    for (const seg of segs.split(',')) {\n    58\t      if (!seg) continue;\n    59\t      const v = decodeVlq(seg);\n    60\t      col += v[0];\n    61\t      if (v.length >= 4) { src += v[1]; row.push([col, src]); }\n    62\t    }\n    63\t    lines.push(row);\n    64\t  });\n    65\t  return (line, column) => {\n    66\t    const segs = lines[line];\n    67\t    if (!segs?.length) return null;\n    68\t    let lo = 0, hi = segs.length - 1, best = -1;\n    69\t    while (lo <= hi) { const mid = (lo + hi) >> 1; if (segs[mid][0] <= column) { best = mid; lo = mid + 1; } else hi = mid - 1; }\n    70\t    return best < 0 ? null : sources[segs[best][1]];\n    71\t  };\n    72\t}\n    73\t\n    74\tconst isAxylo = cf => /\\/axylo\\/axylo\\.iife(\\.min)?\\.js/.test(cf.url);\n    75\t\n    76\t/**\n    77\t * @param profile  a CDP Profiler profile\n    78\t * @param opts     { map: source map object of the bundle the run loaded, build: 'prod' | 'dev' }\n    79\t */\n    80\texport function summarizeProfile(profile, { map, build }) {\n    81\t  const locate = map ? positionMap(map) : null;\n    82\t  const nodes = new Map(profile.nodes.map(n => [n.id, n]));\n    83\t  const parent = new Map();\n    84\t  for (const n of profile.nodes) for (const c of n.children ?? []) parent.set(c, n.id);\n    85\t  const modOf = cf => (locate ? locate(cf.lineNumber, cf.columnNumber) : null);\n    86\t  const self = {}, selfModule = {}, selfFunction = {}, inclusive = {};\n    87\t  let total = 0, samples = 0;\n    88\t  const add = (o, k, t) => { o[k] = (o[k] ?? 0) + t; };\n    89\t  profile.samples.forEach((id, i) => {\n    90\t    const t = (profile.timeDeltas[i] ?? 0) / 1000; // ms\n    91\t    total += t; samples++;\n    92\t    const leaf = nodes.get(id).callFrame;\n    93\t    if (isAxylo(leaf)) {\n    94\t      const mod = modOf(leaf);\n    95\t      add(self, mod ? stageOf(mod) : 'axylo (unmapped)', t);\n    96\t      add(selfModule, mod ?? '(unmapped)', t);\n    97\t      add(selfFunction, `${leaf.functionName || '(anonymous)'} @ ${mod ?? '?'}:${leaf.lineNumber + 1}`, t);\n    98\t    } else if (leaf.functionName === '(idle)') add(self, '(idle)', t);\n    99\t    else if (leaf.functionName === '(program)') add(self, '(program): native main-thread work outside JS', t);\n   100\t    else if (leaf.functionName === '(garbage collector)') add(self, '(garbage collector)', t);\n   101\t    else add(self, 'other JavaScript (harness, page, comparison library)', t);\n   102\t    const seen = new Set();\n   103\t    for (let cur = id; cur !== undefined; cur = parent.get(cur)) {\n   104\t      const cf = nodes.get(cur).callFrame;\n   105\t      if (!isAxylo(cf)) continue;\n   106\t      const mod = modOf(cf);\n   107\t      seen.add(mod ? stageOf(mod) : 'axylo (unmapped)');\n   108\t    }\n   109\t    if (seen.size) seen.add('Axylo (any frame)');\n   110\t    for (const s of seen) add(inclusive, s, t);\n   111\t  });\n   112\t  const busy = total - (self['(idle)'] ?? 0);\n   113\t  const table = o => Object.entries(o).sort((a, b) => b[1] - a[1]).map(([k, ms]) => ({ k, ms: +ms.toFixed(2), ofBusy: busy && k !== '(idle)' ? +(100 * ms / busy).toFixed(1) : null }));\n   114\t  return {\n   115\t    build, mapping: locate ? 'source map from the sealed artifact (describes the measured bytes)' : 'not available: no source map in the artifact',\n   116\t    samples, totalMs: +total.toFixed(2), busyMs: +busy.toFixed(2),\n   117\t    self: table(self), inclusive: table(inclusive), selfModules: table(selfModule).slice(0, 25), selfFunctions: table(selfFunction).slice(0, 25),\n   118\t  };\n   119\t}\n   120\t\n   121\t/** The source map of the bundle a run loaded, from its artifact directory; null when absent. */\n   122\texport function artifactMap(artifactDir, build) {\n   123\t  const p = path.join(artifactDir, 'axylo', build === 'dev' ? 'axylo.iife.js.map' : 'axylo.iife.min.js.map');\n   124\t  return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf8')) : null;\n   125\t}\n     1\t#!/usr/bin/env node\n     2\t// Records Chrome CPU profiles (CDP Profiler, 100 us sampling) of one create run and attributes them to Axylo's\n     3\t// pipeline stages (lib/profile-summary.mjs), self and inclusive. The run is split at the first frame after the\n     4\t// chart reports ready: \"active\" is the create call up to that frame, \"settle\" the fixed settle period after it,\n     5\t// summarized separately. A profiled run is never used as a timing: the profiler slows the page down.\n     6\t//\n     7\t//   node bench/profile.mjs --adapter axylo-svg --size 1x100000 [--artifact <dir>] [--out bench/results/profiles]\n     8\timport fs from 'node:fs';\n     9\timport path from 'node:path';\n    10\timport { parseArgs } from 'node:util';\n    11\timport { build, readArtifact, BENCH } from './build.mjs';\n    12\timport { startServer, launchBrowser, runOnce, machineRecord } from './lib/driver.mjs';\n    13\timport { parseAdapterRef } from './lib/refs.mjs';\n    14\timport { summarizeProfile, artifactMap } from './lib/profile-summary.mjs';\n    15\timport { workloadParams } from './run.mjs';\n    16\t\n    17\tconst { values: a } = parseArgs({ options: {\n    18\t  adapter: { type: 'string' }, workload: { type: 'string', default: 'first' }, size: { type: 'string' }, fixture: { type: 'string' },\n    19\t  charts: { type: 'string' }, out: { type: 'string' }, settle: { type: 'string', default: '500' }, artifact: { type: 'string' },\n    20\t} });\n    21\tif (!a.adapter) { console.error('usage: node bench/profile.mjs --adapter <ref> [--workload first|page] [--size 1x100000 | --fixture trend] [--artifact <dir>]'); process.exit(2); }\n    22\tif (!['first', 'page', 'compact', 'scatter'].includes(a.workload)) { console.error('profile.mjs profiles create workloads only'); process.exit(2); }\n    23\tconst ref = parseAdapterRef(a.adapter);\n    24\tconst out = path.resolve(a.out ?? path.join(BENCH, 'results/profiles'));\n    25\tfs.mkdirSync(out, { recursive: true });\n    26\tconst params = workloadParams(a.workload, a);\n    27\tconst artifact = readArtifact(a.artifact ?? (await build()).dir);\n    28\tconst name = `${new Date().toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z')}-${a.workload}-${params.fixture ?? params.size}-${a.adapter.replace(/[^a-zA-Z0-9.-]+/g, '_')}`;\n    29\tconst file = path.join(out, `${name}.cpuprofile`);\n    30\t\n    31\tconst browser = await launchBrowser();\n    32\tconst server = await startServer({ A: artifact });\n    33\ttry {\n    34\t  const r = await runOnce(browser, server, { adapter: ref.id, adapterParams: ref.params, workload: a.workload, params, settleMs: Number(a.settle), timeoutMs: 120000, profile: { file } });\n    35\t  if (r.outcome !== 'ok') { console.error(`run outcome ${r.outcome}: ${r.reason ?? r.error}`); process.exitCode = 1; }\n    36\t  else {\n    37\t    const buildKind = r.result.adapter.params?.build === 'dev' ? 'dev' : 'prod';\n    38\t    const map = artifactMap(artifact.dir, buildKind);\n    39\t    const active = summarizeProfile(JSON.parse(fs.readFileSync(file, 'utf8')), { map, build: buildKind });\n    40\t    const settleFile = file.replace(/\\.cpuprofile$/, '.settle.cpuprofile');\n    41\t    const settle = fs.existsSync(settleFile) ? summarizeProfile(JSON.parse(fs.readFileSync(settleFile, 'utf8')), { map, build: buildKind }) : null;\n    42\t    const served = server.served().A;\n    43\t    const bundle = buildKind === 'dev' ? 'axylo/axylo.iife.js' : 'axylo/axylo.iife.min.js';\n    44\t    const record = {\n    45\t      name, adapter: a.adapter, config: r.result.adapter.config, workload: a.workload, params,\n    46\t      artifact: { id: artifact.id, dir: artifact.dir, source: artifact.source.head, axyloSourceHash: artifact.source.axyloSourceHash, bundle, bundleSha256: served[bundle] ?? 'not served', mapSha256: artifact.files[`${bundle}.map`]?.sha256 ?? 'not available' },\n    47\t      profileFiles: { active: path.relative(BENCH, file), settle: settle ? path.relative(BENCH, settleFile) : null },\n    48\t      environment: machineRecord(browser, { headed: false }), page: r.result.env,\n    49\t      note: 'profiled run: timings are slowed by the profiler and are not comparable with timed runs. \"active\" = create call to the first frame after ready; \"settle\" = the settle period after it.',\n    50\t      active, settle,\n    51\t    };\n    52\t    fs.writeFileSync(path.join(out, `${name}.summary.json`), JSON.stringify(record, null, 1));\n    53\t    for (const [label, s] of [['active', active], ['settle', settle]]) {\n    54\t      if (!s) continue;\n    55\t      console.log(`${name} ${label}: ${s.busyMs} ms busy of ${s.totalMs} ms (${s.mapping})`);\n    56\t      console.log('  self:'); for (const x of s.self.slice(0, 10)) console.log(`    ${String(x.ofBusy ?? '').padStart(5)}%  ${String(x.ms).padStart(8)} ms  ${x.k}`);\n    57\t      console.log('  inclusive:'); for (const x of s.inclusive.slice(0, 10)) console.log(`    ${String(x.ofBusy ?? '').padStart(5)}%  ${String(x.ms).padStart(8)} ms  ${x.k}`);\n    58\t    }\n    59\t  }\n    60\t} finally {\n    61\t  await browser.close();\n    62\t  await server.close();\n    63\t}\n     1\t#!/usr/bin/env node\n     2\t// Builds the M1 renderer comparison report from the history records listed in bench/results/m1-runs.tsv and the\n     3\t// profile summaries pinned in PROFILES below. Numbers and provenance come only from those files: nothing is read from\n     4\t// a build directory or the live checkout, so regenerating later cannot change what the report says about the session.\n     5\t//   node bench/results/make-m1-report.mjs --out <file>\n     6\t// The output path is explicit: bench/results/m1-renderer-comparison.md carries edits made after generation (the\n     7\t// provisional-decision warning), which a regeneration would overwrite.\n     8\timport fs from 'node:fs';\n     9\timport path from 'node:path';\n    10\timport { fileURLToPath } from 'node:url';\n    11\timport { parseArgs } from 'node:util';\n    12\t\n    13\tconst { values: cli } = parseArgs({ options: { out: { type: 'string' } } });\n    14\tif (!cli.out) { console.error('usage: node bench/results/make-m1-report.mjs --out <file>'); process.exit(2); }\n    15\tconst HERE = path.dirname(fileURLToPath(import.meta.url));\n    16\t// The profiles of the M1 session, by file name; each is checked against the session's bundle hashes below.\n    17\tconst PROFILES = [\n    18\t  '20261118T025413Z-first-3x120-axylo_renderer_canvas_build_prod', '20261118T025415Z-first-3x120-axylo_renderer_canvas_build_dev',\n    19\t  '20261118T025417Z-first-3x120-axylo_renderer_svg_build_prod', '20261118T025419Z-first-3x120-axylo_renderer_svg_build_dev',\n    20\t  '20261118T025421Z-first-1x100000-axylo_renderer_canvas_build_prod', '20261118T025423Z-first-1x100000-axylo_renderer_canvas_build_dev',\n    21\t  '20261118T025426Z-first-1x100000-axylo_renderer_svg_build_prod', '20261118T025428Z-first-1x100000-axylo_renderer_svg_build_dev',\n    22\t];\n    23\tconst BENCH = path.resolve(HERE, '..');\n    24\tconst list = fs.readFileSync(path.join(HERE, 'm1-runs.tsv'), 'utf8').trim().split('\\n').map(l => l.split('\\t'));\n    25\tconst runs = Object.fromEntries(list.map(([label, id]) => {\n    26\t  const f = path.join(BENCH, 'history', `${id}.json`);\n    27\t  return [label, fs.existsSync(f) ? JSON.parse(fs.readFileSync(f, 'utf8')) : null];\n    28\t}));\n    29\tconst ids = Object.fromEntries(list);\n    30\t\n    31\tconst num = (v, d = 2) => (typeof v !== 'number' || !Number.isFinite(v) ? 'n/a' : Math.abs(v) >= 1000 ? v.toFixed(0) : Math.abs(v) >= 100 ? v.toFixed(1) : v.toFixed(d));\n    32\tconst mib = v => (typeof v !== 'number' || !Number.isFinite(v) ? 'n/a' : `${(v / 2 ** 20).toFixed(2)}`);\n    33\tconst fmtFor = m => (m.unit === 'bytes' ? mib : v => num(v));\n    34\tconst pct = v => (v == null || !Number.isFinite(v) ? 'n/a' : `${v >= 0 ? '+' : ''}${(v * 100).toFixed(1)}%`);\n    35\tconst NAMES = { 'axylo-canvas': 'Canvas', 'axylo-svg': 'SVG', uplot: 'uPlot' };\n    36\t\n    37\tfunction row(label, metricKey) {\n    38\t  const r = runs[label];\n    39\t  if (!r) return `| ${label} | missing | | | | | | |`;\n    40\t  if (r.analysis?.notCompared) return `| ${NAMES[r.design.baseline]} (A) vs ${NAMES[r.design.candidate]} (B) | not compared: ${r.analysis.notCompared.join('; ').replace(/\\|/g, '\\\\|')} | | | | | | | |`;\n    41\t  const m = r.analysis?.metrics?.[metricKey];\n    42\t  if (!m) return `| ${NAMES[r.design.baseline]} → ${NAMES[r.design.candidate]} | ${metricKey}: not recorded | | | | | | |`;\n    43\t  if (m.na) return `| ${NAMES[r.design.baseline]} → ${NAMES[r.design.candidate]} | ${metricKey} | ${m.na} | | | | | |`;\n    44\t  const f = fmtFor(m);\n    45\t  const band = typeof m.noiseBand === 'object' ? `[${f(m.noiseBand.lo)}, ${f(m.noiseBand.hi)}]` : 'none';\n    46\t  return `| ${NAMES[r.design.baseline]} (A) vs ${NAMES[r.design.candidate]} (B) | ${metricKey}${m.unit === 'bytes' ? ' (MiB)' : m.unit === 'ms' ? ' (ms)' : ` (${m.unit})`} | ${m.pairs}/${r.design.blocks} | ${f(m.medianA)} | ${f(m.medianB)} | ${f(m.diff)} [${f(m.lo)}, ${f(m.hi)}] | ${pct(m.relative)} | **${m.outcome}**${m.outcomeNote ? ' (few pairs)' : ''} | ${band} |`;\n    47\t}\n    48\tconst HEAD = '| Comparison | Metric | Pairs/blocks | Median A | Median B | B − A [95% CI] | B/A − 1 | Outcome for B | Noise band |\\n|---|---|---|---|---|---|---|---|---|';\n    49\tconst table = (labels, metrics) => [HEAD, ...labels.flatMap(l => (runs[l]?.analysis?.notCompared ? [row(l, metrics[0])] : metrics.map(k => row(l, k))))].join('\\n');\n    50\t\n    51\tconst out = [];\n    52\tconst first = Object.values(runs).find(Boolean);\n    53\tconst env = first.environment;\n    54\tconst allRuns = Object.values(runs).filter(Boolean);\n    55\tconst loads = allRuns.flatMap(r => [r.environment.loadAverageAtStart?.[0], r.environment.loadAverageAtEnd?.[0]]).filter(Number.isFinite);\n    56\tconst pageEnv = env.page ?? {};\n    57\tconst starts = allRuns.map(r => r.startedAt).sort(), ends = allRuns.map(r => r.finishedAt).filter(Boolean).sort();\n    58\t// Provenance from the records themselves: every distinct value, with how many records carry it.\n    59\tconst tally = f => { const m = new Map(); for (const r of allRuns) { const k = f(r) ?? 'not recorded'; m.set(k, (m.get(k) ?? 0) + 1); } return [...m.entries()]; };\n    60\tconst commits = tally(r => r.environment.commit);\n    61\tconst prodHashes = tally(r => r.environment.axyloBundles?.['axylo.iife.min.js']?.sha256);\n    62\tconst devHashes = tally(r => r.environment.axyloBundles?.['axylo.iife.js']?.sha256);\n    63\tconst listTally = (t, f = v => v) => t.map(([k, n]) => `${f(k)} (${n} record${n === 1 ? '' : 's'})`).join('; ');\n    64\t\n    65\tout.push(`# M1 renderer comparison: Axylo Canvas 2D against SVG\n    66\t\n    67\tGenerated by \\`bench/results/make-m1-report.mjs\\` from the history records listed in \\`bench/results/m1-runs.tsv\\`\n    68\t(session script \\`bench/results/m1-session.sh\\`). Observations only; this file does not recommend a renderer.\n    69\t\n    70\tHow to read the tables: every comparison runs A and B in randomized balanced blocks (as many AB as BA), a fresh\n    71\tbrowser context per run. \"Median A / B\" are medians of per-run values; \"B − A\" is the difference of medians with a\n    72\tpaired bootstrap 95% interval over blocks. **Outcome is for B relative to A, and lower is better for every metric**:\n    73\tin \"Canvas (A) vs SVG (B)\", *better* means SVG measured lower, *worse* means SVG measured higher. *Inconclusive*\n    74\tmeans the interval includes zero (or the noise band); it never means \"no difference\". Where a noise band is shown,\n    75\tthe interval had to clear it as well as zero; the band is the union of the two A-versus-A intervals (Canvas and SVG)\n    76\tfor that workload, from this session. Workloads without an A-versus-A band are classified against zero only.\n    77\tMethod and metric definitions: \\`bench/README.md\\`.\n    78\t\n    79\t## Environment\n    80\t\n    81\t| | |\n    82\t|---|---|\n    83\t| Session | ${starts[0]} to ${ends[ends.length - 1]} (UTC) |\n    84\t| Browser | ${env.browser.name} ${env.browser.version}, ${env.browser.headless ? 'headless' : 'headed'}; Playwright ${env.playwright}; Node ${env.node} |\n    85\t| Machine | ${env.cpu.model}, ${env.cpu.logicalCores} logical cores, governor ${env.cpu.governor}, ${env.memoryGiB} GiB; ${env.os.name} (${env.os.type} ${env.os.release}) |\n    86\t| Load | 1-minute load average between ${Math.min(...loads).toFixed(1)} and ${Math.max(...loads).toFixed(1)} at run starts and ends; other agents were running tests on the machine |\n    87\t| Display | ${pageEnv.refresh ? `${pageEnv.refresh.hz} Hz observed by the page` : 'n/a'}; viewport 1,440×900; device pixel ratio 1 unless marked dpr 2 |\n    88\t| WebGL renderer | ${pageEnv.webglRenderer ?? 'n/a'} (software; not used by any configuration measured here) |\n    89\t| Axylo | production build \\`axylo.iife.min.js\\` sha256 ${listTally(prodHashes, h => `${String(h).slice(0, 16)}…`)}, with \\`__AXYLO_BENCH__\\` set; development build \\`axylo.iife.js\\` sha256 ${listTally(devHashes, h => `${String(h).slice(0, 16)}…`)} (profiles only). The bundles were a snapshot of \\`packages/axylo/dist\\`; the records do not say when that was built or from which source state, so neither is stated here. Library sources had uncommitted changes when the first record was written: ${String(env.axyloBundles?.gitStatusOfLibrarySources ?? 'n/a').replace(/\\n/g, ', ')} |\n    90\t| Commit | checkout HEAD when each run started, which is not necessarily the source of the bundle: ${listTally(commits, c => String(c).slice(0, 8))} |\n    91\t| Libraries | uPlot ${env.libraries.uplot}; Axylo ${env.libraries.axylo} |\n    92\t`);\n    93\t\n    94\t// Summary of every Canvas-vs-SVG metric, generated from the same records as the tables below.\n    95\t{\n    96\t  const cmp = [\n    97\t    ['W-first 3×120', 'first-3x120-canvas-vs-svg'], ['W-first 1×10,000', 'first-1x10000-canvas-vs-svg'],\n    98\t    ['W-first 1×100,000', 'first-1x100000-canvas-vs-svg'], ['W-first 1×100,000 gaps', 'first-1x100000gaps-canvas-vs-svg'],\n    99\t    ['W-first 1×1,000,000', 'first-1x1000000-canvas-vs-svg'], ['W-page', 'page-canvas-vs-svg'], ['W-stream', 'stream-canvas-vs-svg'],\n   100\t    ['Theme', 'theme-canvas-vs-svg'], ['Resize 1×100,000', 'resize-1x100000-canvas-vs-svg'], ['Resize 24 charts', 'resize-page-canvas-vs-svg'],\n   101\t    ['W-first 1×100,000 dpr 2', 'dpr2-first-1x100000-canvas-vs-svg'], ['W-page dpr 2', 'dpr2-page-canvas-vs-svg'],\n   102\t  ];\n   103\t  out.push(`## Canvas against SVG: every metric with a verdict\n   104\t\n   105\tGenerated list of the Canvas (A) vs SVG (B) comparisons. \"SVG lower\" = outcome *better* for SVG, \"SVG higher\" =\n   106\t*worse*. Metrics whose outcome was inconclusive are counted, not listed; the full tables follow.\n   107\t\n   108\t| Workload | SVG lower (better) | SVG higher (worse) | Inconclusive |\n   109\t|---|---|---|---|`);\n   110\t  for (const [name, label] of cmp) {\n   185\t  if (!fs.existsSync(f)) return null;\n   186\t  const p = JSON.parse(fs.readFileSync(f, 'utf8'));\n   187\t  const b = p.environment?.axyloBundles;\n   188\t  const used = p.adapter?.includes('build=dev') ? b?.['axylo.iife.js']?.sha256 : b?.['axylo.iife.min.js']?.sha256;\n   189\t  p.bundleMatches = !!used && sessionBundles.has(used);\n   190\t  return p;\n   191\t}).filter(Boolean);\n   192\tout.push(`## CPU profiles\n   193\t\n   194\tOne Chrome CPU profile per renderer and build (CDP \\`Profiler\\`, 100 µs sampling), from the create call to the end of\n   195\tthe 500 ms settle window, at the two sizes where the uPlot gap was examined (3×120 and 1×100,000). Profiled runs\n   196\tare slowed by the profiler and are not timings. Each sample is attributed to the deepest Axylo frame on its stack,\n   197\tand that frame's source module gives the stage (\\`bench/lib/profile-summary.mjs\\`: data/ → normalize; view/, scale/\n   198\t→ view; layout/, format/ → layout; scene/, simplify/ → scene; render/ → draw; dom/ → DOM; core/ etc. → orchestration).\n   199\tPercentages are of busy time (all samples except idle). Raw \\`.cpuprofile\\` files are next to the summaries in\n   200\t\\`bench/results/profiles/\\` and open in Chrome DevTools.\n   201\t`);\n   202\tfor (const size of ['3x120', '1x100000']) {\n   203\t  for (const renderer of ['canvas', 'svg']) {\n   204\t    for (const build of ['dev', 'prod']) {\n   205\t      const p = profs.find(x => x.params.size === size && x.adapter === `axylo:renderer=${renderer},build=${build}`);\n   206\t      if (!p) { out.push(`**${size}, ${renderer}, ${build}**: profile missing.\\n`); continue; }\n   207\t      const s = p.summary;\n   208\t      out.push(`**${size}, ${renderer}, ${build === 'dev' ? 'development build' : 'production build'}** — busy ${num(s.busyMs)} ms (${s.samples} samples); mapping: ${s.mapping}. File \\`${p.profileFile}\\`.${p.bundleMatches ? '' : ' **Its bundle hash is not one of the session records\\' bundles.**'}\\n`);\n   209\t      out.push('| Stage | ms | % of busy |\\n|---|---|---|');\n   210\t      for (const st of s.stages.filter(x => x.k !== '(idle)')) out.push(`| ${st.k} | ${num(st.ms)} | ${st.ofBusy}% |`);\n   211\t      if (build === 'dev') {\n   212\t        out.push('\\nTop functions (deepest Axylo frame; the line is in the bundle `axylo.iife.js`, not the source file):\\n\\n| Function @ module:bundle line | ms | % of busy |\\n|---|---|---|');\n   213\t        for (const fn of s.functions.slice(0, 8)) out.push(`| \\`${fn.k}\\` | ${num(fn.ms)} | ${fn.ofBusy}% |`);\n   214\t      }\n   215\t      out.push('');\n   216\t    }\n   217\t  }\n   218\t}\n   219\tout.push(`The development build runs \\`__DEV__\\` checks the production build does not, so its stage shares are a guide to\n   220\twhere time goes, not the production split. The production profiles could not be mapped to modules (see \"mapping\"),\n   221\tso for them only Axylo's total against garbage collection and native work is shown.\n   222\t`);\n   223\t\n   224\tout.push(`## Run ids\n   225\t\n   226\tAll in \\`bench/history/<run id>.json\\` (raw per-run samples, environment record, admission readback).\n   227\t\n   228\t| Label | Run id | Status |\n   229\t|---|---|---|\n   230\t${list.map(([l, id]) => `| ${l} | \\`${id}\\` | ${runs[l]?.status ?? 'missing'} |`).join('\\n')}\n   231\t\n   232\t## Limits\n   233\t\n   234\t- One browser (Chrome stable, headless) on one machine. No Firefox, Safari/WebKit, Edge, phone or throttled profile.\n   235\t- Headless Chrome here rasterizes WebGL with SwiftShader. No configuration measured here uses WebGL, but GPU raster of\n   236\t  Canvas 2D and SVG is not measured either: main-thread task time and process CPU times are what was recorded, and the\n   237\t  GPU process figures come from a headless browser whose raster path may differ from a headed browser with a GPU.\n   238\t- The machine was under load from other agents' tests during the whole session (load average above). The A-versus-A\n   239\t  bands are from the same session and show what that noise does to these workloads; they are one session, not three.\n   240\t- Process CPU times (\\`rendererCpuMs\\`, \\`gpuCpuMs\\`) come from \\`SystemInfo.getProcessInfo\\`, whose resolution here is\n","exit_code":0,"status":"completed"}}
