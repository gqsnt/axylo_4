rformance.md).\",\n  \"scripts\": {\n    \"build\": \"node build.mjs\",\n    \"test\": \"node --test test/*.test.mjs\",\n    \"test:browser\": \"node --test --test-concurrency=1 test/browser/*.test.mjs\",\n    \"bench\": \"node run.mjs\",\n    \"analyze\": \"node analyze.mjs\",\n    \"coverage\": \"node tools/coverage.mjs\"\n  },\n  \"dependencies\": {\n    \"chart.js\": \"^4.6.1\",\n    \"chartjs-adapter-date-fns\": \"^3.0.0\",\n    \"date-fns\": \"^4.4.0\",\n    \"uplot\": \"^1.6.32\"\n  }\n}\n{\n  \"name\": \"@axylo/react\",\n  \"version\": \"0.0.0\",\n  \"description\": \"React components for Axylo charts.\",\n  \"license\": \"MIT\",\n  \"type\": \"module\",\n  \"sideEffects\": false,\n  \"files\": [\"dist/index.js\", \"dist/index.dev.js\", \"dist/index.d.ts\"],\n  \"exports\": { \".\": { \"types\": \"./dist/index.d.ts\", \"development\": \"./dist/index.dev.js\", \"default\": \"./dist/index.js\" } },\n  \"peerDependencies\": { \"axylo\": \"0.0.0\", \"react\": \"^18.0.0 || ^19.0.0\" }\n}\nv24.21.0\n","exit_code":1,"status":"failed"}}
