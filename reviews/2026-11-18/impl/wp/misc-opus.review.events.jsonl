{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"nl -ba bench/run.mjs | sed -n '1,224p'\"","aggregated_output":"     1\t#!/usr/bin/env node\n     2\t// Benchmark runner: a baseline and a candidate, one workload, randomized balanced blocks, a fresh browser context per\n     3\t// run, raw samples written to bench/history/<run id>.json after every run.\n     4\t//\n     5\t//   node bench/run.mjs --baseline uplot --candidate chartjs-tuned --workload first --size 1x100000\n     6\t//   node bench/run.mjs --aa uplot --workload first --size 1x100000                     (A-versus-A noise band)\n     7\t//   node bench/run.mjs ... --noise <run id of an A-versus-A run>[,<another>]             (use that band; checked)\n     8\t//   node bench/run.mjs --baseline axylo-canvas --candidate axylo-svg ...                 (renderer comparison)\n     9\t//   node bench/run.mjs --adapter axylo-svg --base <artifact dir> --candidate <artifact dir> ...   (two builds)\n    10\t//\n    11\t// Every session serves one sealed artifact per side (bench/build.mjs). Without --artifact (or --base/--candidate\n    12\t// in two-build mode) the runner builds a fresh one for this session. See bench/README.md for what each metric means.\n    13\timport fs from 'node:fs';\n    14\timport path from 'node:path';\n    15\timport os from 'node:os';\n    16\timport crypto from 'node:crypto';\n    17\timport { parseArgs } from 'node:util';\n    18\timport { fileURLToPath } from 'node:url';\n    19\timport { build, readArtifact, BENCH } from './build.mjs';\n    20\timport { startServer, launchBrowser, runOnce, machineRecord, expectedFor } from './lib/driver.mjs';\n    21\timport { balancedOrder, summarizeRun, analyze, parseSeed, median, DEFAULT_BOOTSTRAP_SEED } from './src/stats.js';\n    22\timport { formatAnalysis } from './lib/report.mjs';\n    23\timport { parseAdapterRef, loadNoise, controlsOf, WORKLOADS } from './lib/refs.mjs';\n    24\t\n    25\t/** Workloads that a budget in spec section 5 names; they default to the plan's 20 runs per configuration. */\n    26\texport const DEFAULT_BLOCKS = 20;\n    27\t\n    28\t/** Parameters of a workload from the command line; keys that are not given are left out (never undefined). */\n    29\texport function workloadParams(workload, a) {\n    30\t  const def = (o) => Object.fromEntries(Object.entries(o).filter(([, v]) => v !== undefined));\n    31\t  const n = v => (v === undefined ? undefined : Number(v));\n    32\t  const lineOrTrend = fallback => (a.fixture === 'trend' ? { fixture: 'trend' } : { size: a.size ?? fallback, gaps: !!a.gaps });\n    33\t  switch (workload) {\n    34\t    case 'first': return def(lineOrTrend('3x120'));\n    35\t    case 'page': return def({ ...lineOrTrend('3x120'), charts: n(a.charts) ?? 24 });\n    36\t    case 'compact': return def({ fixture: 'trend', charts: n(a.charts) ?? 40 });\n    37\t    case 'scatter': return def({ size: a.size ?? '1x10000', clustered: !!a.clustered });\n    38\t    case 'theme': return def(a.fixture === 'trend' ? { fixture: 'trend', toggles: n(a.toggles) ?? 20 } : { size: a.size ?? '3x120', toggles: n(a.toggles) ?? 20 });\n    39\t    case 'resize': return def({ size: a.size ?? '1x100000', charts: n(a.charts) ?? 1 });\n    40\t    case 'stream': return def({ window: n(a.window) ?? 600, samples: n(a.samples) ?? 300 });\n    41\t    case 'hover': return def({ size: a.size ?? '1x100000', gaps: false, moves: n(a.moves) ?? 200 });\n    42\t    case 'zoom': return def({ size: a.size ?? '1x100000', gaps: false });\n    43\t    case 'mem': return def({ size: a.size ?? '1x1000000', gaps: false });\n    44\t    case 'lifecycle': return def({ fixture: 'trend', cycles: n(a.cycles) ?? 1000 });\n    45\t    default: throw new Error(`unknown workload ${workload}`);\n    46\t  }\n    47\t}\n    48\t\n    49\tconst tagOf = (workload, p) => workload === 'stream' ? `w${p.window}`\n    50\t  : `${p.fixture ?? p.size}${p.gaps ? '-gaps' : ''}${p.clustered ? '-clustered' : ''}${p.charts > 1 ? `-x${p.charts}` : ''}${p.cycles ? `-c${p.cycles}` : ''}`;\n    51\tconst slug = ref => ref.replace(/[^a-zA-Z0-9.-]+/g, '_');\n    52\tconst artifactSlot = m => ({ artifact: m.id, dir: m.dir, manifestSha256: m.manifestSha256, source: { head: m.source.head, uncommitted: m.source.uncommitted, axyloSourceHash: m.source.axyloSourceHash, shippedOptions: m.source.shippedOptions, distComparison: m.source.distComparison }, bench: m.bench, files: Object.fromEntries(Object.entries(m.files).map(([p, f]) => [p, f.sha256])), served: {} });\n    53\tconst HARNESS = rel => rel === 'index.html' || rel === 'page.js' || rel.startsWith('adapters/');\n    54\t\n    55\t/**\n    56\t * One balanced job. cfg: { mode: 'compare' | 'aa' | 'builds', A: { ref, slot }, B: { ref, slot }, artifacts: { A, B? },\n    57\t * workload, params, blocks, seed, bootstrapSeed, settleMs, timeoutMs, dpr, headed, noiseIds, historyDir, quiet,\n    58\t * command, label }. Returns the record (also written to history).\n    59\t */\n    60\texport async function runSession(cfg) {\n    61\t  const log = (...m) => { if (!cfg.quiet) console.log(...m); };\n    62\t  const order = balancedOrder(cfg.blocks, cfg.seed);\n    63\t  const stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z');\n    64\t  const who = cfg.mode === 'aa' ? `aa-${slug(cfg.A.ref)}` : cfg.mode === 'builds' ? `builds-${slug(cfg.A.ref)}` : `${slug(cfg.A.ref)}-vs-${slug(cfg.B.ref)}`;\n    65\t  const runId = `${stamp}-${cfg.workload}-${tagOf(cfg.workload, cfg.params)}${cfg.dpr !== 1 ? `-dpr${cfg.dpr}` : ''}-${who}-${crypto.randomBytes(2).toString('hex')}`;\n    66\t  fs.mkdirSync(cfg.historyDir, { recursive: true });\n    67\t  const file = path.join(cfg.historyDir, `${runId}.json`);\n    68\t  const refA = parseAdapterRef(cfg.A.ref), refB = parseAdapterRef(cfg.B.ref);\n    69\t  const record = {\n    70\t    schema: 'axylo-bench/2',\n    71\t    runId,\n    72\t    // Stays \"interrupted\" until the last run is analysed; a run cut short by a restart is never merged with another.\n    73\t    status: 'interrupted',\n    74\t    startedAt: new Date().toISOString(),\n    75\t    command: cfg.command ?? null,\n    76\t    design: {\n    77\t      mode: cfg.mode, baseline: cfg.A.ref, candidate: cfg.B.ref, labels: { A: cfg.A.ref, B: cfg.B.ref }, adapters: { A: refA, B: refB },\n    78\t      ...(cfg.mode === 'builds' ? { builds: { A: cfg.artifacts.A.dir, B: cfg.artifacts.B.dir } } : {}),\n    79\t      workload: cfg.workload, params: cfg.params, blocks: cfg.blocks, order, seed: cfg.seed, bootstrapSeed: cfg.bootstrapSeed,\n    80\t      settleMs: cfg.settleMs, timeoutMs: cfg.timeoutMs, dpr: cfg.dpr, viewport: [1440, 900],\n    81\t      warmup: 'one untimed admission run per side (A then B), then one untimed warm-up run per side in the opposite order (B then A), so each side has run twice in this browser before timing starts',\n    82\t      noiseFrom: null,\n    83\t    },\n    84\t    environment: null,\n    85\t    hashes: { fixtureChecksum: expectedFor(cfg.workload, cfg.params).checksum, slots: { A: artifactSlot(cfg.artifacts.A), B: artifactSlot(cfg.artifacts.B ?? cfg.artifacts.A) } },\n    86\t    admission: {},\n    87\t    probes: {},\n    88\t    runs: [],\n    89\t    analysis: null,\n    90\t  };\n    91\t  const save = () => { const tmp = `${file}.tmp`; fs.writeFileSync(tmp, JSON.stringify(record, null, 1)); fs.renameSync(tmp, file); };\n    92\t\n    93\t  let browser, server;\n    94\t  const stop = async (status, why) => {\n    95\t    record.status = status;\n    96\t    record.endedBecause = why;\n    97\t    record.finishedAt = new Date().toISOString();\n    98\t    if (server) {\n    99\t      const served = server.served();\n   100\t      for (const slot of ['A', 'B']) {\n   101\t        const s = cfg.mode === 'builds' ? slot : 'A';\n   102\t        record.hashes.slots[slot].served = served[s] ?? {};\n   103\t      }\n   104\t      record.integrity = { violations: server.violations() };\n   105\t    }\n   106\t    save();\n   107\t    await browser?.close().catch(() => {});\n   108\t    await server?.close().catch(() => {});\n   109\t  };\n   110\t  const onSignal = async sig => { await stop('interrupted', `signal ${sig}`); console.error(`\\ninterrupted; partial record kept in ${file}`); process.exit(130); };\n   111\t  const handlers = ['SIGINT', 'SIGTERM', 'SIGHUP'].map(sig => { const h = () => onSignal(sig); process.on(sig, h); return [sig, h]; });\n   112\t  try {\n   113\t    const slots = cfg.mode === 'builds' ? { A: cfg.artifacts.A, B: cfg.artifacts.B } : { A: cfg.artifacts.A };\n   114\t    for (const [side, ref] of [['A', refA], ['B', refB]]) {\n   115\t      const m = slots[cfg[side].slot];\n   116\t      if (!m.adapters[ref.id]) throw new Error(`no adapter \"${ref.id}\" in artifact ${m.id} (have: ${Object.keys(m.adapters).join(', ')})`);\n   117\t    }\n   118\t    browser = await launchBrowser({ headed: cfg.headed });\n   119\t    record.environment = { ...machineRecord(browser, { headed: cfg.headed }), libraries: cfg.artifacts.A.versions };\n   120\t    server = await startServer(slots);\n   121\t    if (cfg.noiseIds) {\n   122\t      const noise = loadNoise(cfg.noiseIds, cfg.historyDir, controlsOf(record));\n   123\t      record.design.noiseFrom = noise.sources;\n   124\t      record.design.noiseCalibration = noise.calibration;\n   125\t      cfg.noise = noise;\n   126\t    }\n   127\t    save();\n   128\t    log(`run ${runId}\\n  ${cfg.mode === 'aa' ? `A-versus-A: ${cfg.A.ref}` : cfg.mode === 'builds' ? `two builds of ${cfg.A.ref}: A=${cfg.artifacts.A.id} B=${cfg.artifacts.B.id}` : `A=${cfg.A.ref}  B=${cfg.B.ref}`}  ${cfg.workload} ${JSON.stringify(cfg.params)}  ${cfg.blocks} blocks  order seed ${cfg.seed}, bootstrap seed ${cfg.bootstrapSeed}`);\n   129\t    log(`  Chrome ${browser.version()} ${cfg.headed ? 'headed' : 'headless'}, history -> ${path.relative(process.cwd(), file)}`);\n   130\t\n   131\t    const spec = (side, extra = {}) => ({ adapter: (side === 'A' ? refA : refB).id, adapterParams: (side === 'A' ? refA : refB).params, slot: cfg[side].slot, workload: cfg.workload, params: cfg.params, settleMs: cfg.settleMs, timeoutMs: cfg.timeoutMs, dpr: cfg.dpr, ...extra });\n   132\t    const sides = cfg.mode === 'aa' ? ['A'] : ['A', 'B'];\n   133\t    const keyOf = side => `${cfg[side].slot}:${cfg[side].ref}`;\n   134\t\n   135\t    // Admission: one untimed probe run per side that captures what the chart drew. A side that does not show the\n   136\t    // fixture is not timed at all.\n   137\t    for (const side of sides) {\n   138\t      const r = await runOnce(browser, server, spec(side, { probe: 'geometry' }));\n   139\t      const adm = { outcome: r.outcome, reason: r.reason ?? r.error ?? null, admission: r.admission ?? null, describe: r.result?.describe ?? null, adapter: r.result?.adapter ?? null, themeCheck: r.result?.themeCheck, resizeCheck: r.result?.resizeCheck, hoverCheck: r.result?.hoverCheck, theme: r.result?.theme ? { framesToChange: r.result.theme.framesToChange, states: r.result.theme.states } : undefined, resize: r.result?.resize ? { intermediate: r.result.resize.intermediate } : undefined };\n   140\t      record.admission[keyOf(side)] = adm;\n   141\t      if (r.result?.env && !record.environment.page) record.environment.page = r.result.env;\n   142\t      record.runs.push({ index: record.runs.length, phase: 'admission', side, adapter: r.adapter, slot: cfg[side].slot, outcome: r.outcome, reason: adm.reason, limits: r.admission?.limits, durationMs: r.durationMs, logs: r.logs, pageErrors: r.pageErrors });\n   143\t      if (cfg.workload === 'theme' && r.outcome === 'ok') {\n   144\t        const ftc = r.result.theme.framesToChange;\n   145\t        record.probes[`${keyOf(side)}:colors`] = { kind: 'per-mark colors after every toggle; frames until new colors (4 untimed toggles)', outcome: 'ok', summary: { framesToNewColor: ftc.every(v => v !== null) ? Math.max(...ftc) : 'not available: a toggle took more than 10 frames' } };\n   146\t      }\n   147\t      save();\n   148\t      log(`  admission ${keyOf(side)}: ${r.outcome}${adm.reason ? ` (${adm.reason})` : ''}`);\n   149\t    }\n   150\t    if (cfg.workload === 'theme') {\n   151\t      // Drawing work per toggle, counted in its own untimed run (the counters add work, so never in a timed run).\n   152\t      for (const side of sides) {\n   153\t        if (record.admission[keyOf(side)].outcome !== 'ok') continue;\n   154\t        const r = await runOnce(browser, server, spec(side, { probe: 'counters' }));\n   155\t        const w = r.result?.theme?.work ?? [];\n   156\t        record.probes[`${keyOf(side)}:counters`] = { kind: 'Canvas 2D calls and DOM mutations per toggle', outcome: r.outcome, reason: r.reason ?? r.error, summary: w.length ? { canvasCallsPerToggle: median(w.map(x => x.canvasCalls)), mutationsPerToggle: median(w.map(x => x.mutations)) } : null };\n   157\t        record.runs.push({ index: record.runs.length, phase: 'probe', side, probe: 'counters', adapter: r.adapter, slot: cfg[side].slot, outcome: r.outcome, durationMs: r.durationMs, work: w });\n   158\t        save();\n   159\t      }\n   160\t    }\n   161\t    const blocked = sides.map(s => [keyOf(s), record.admission[keyOf(s)]]).filter(([, v]) => v.outcome !== 'ok');\n   162\t    if (blocked.length) {\n   163\t      record.analysis = { notCompared: blocked.map(([id, v]) => `${id}: ${v.outcome}${v.reason ? ` (${v.reason})` : ''}` ) };\n   164\t      await stop('complete', 'admission failed or adapter not available; nothing was timed');\n   165\t      log(`  not timed: ${record.analysis.notCompared.join('; ')}`);\n   166\t      return record;\n   167\t    }\n   168\t    // Symmetric warm-up: the admission runs went A then B; one more untimed run each, B then A.\n   169\t    for (const side of [...sides].reverse()) {\n   170\t      const r = await runOnce(browser, server, spec(side));\n   171\t      record.runs.push({ index: record.runs.length, phase: 'warmup', side, adapter: r.adapter, slot: cfg[side].slot, outcome: r.outcome, reason: r.reason ?? r.error ?? null, durationMs: r.durationMs });\n   172\t      save();\n   173\t    }\n   174\t\n   175\t    for (let b = 0; b < order.length; b++) {\n   176\t      for (let pos = 0; pos < 2; pos++) {\n   177\t        const side = order[b][pos];\n   178\t        const r = await runOnce(browser, server, spec(side));\n   179\t        const run = { index: record.runs.length, phase: 'timed', block: b, position: pos, config: side, startedAt: new Date(Date.now() - r.durationMs).toISOString(), ...r, ref: cfg[side].ref };\n   180\t        if (r.outcome === 'ok') run.summary = summarizeRun(cfg.workload, r);\n   181\t        record.runs.push(run);\n   182\t        save();\n   183\t        const primary = run.summary ? Object.entries(run.summary).find(([k]) => ['taskMs', 'taskMsPerUpdate', 'taskMsPerToggle', 'inputToReadoutP95Ms', 'taskMsPerStep', 'ownedBytes', 'heapSlopeBytesPerCycle'].includes(k)) : null;\n   184\t        log(`  block ${b + 1}/${order.length} ${order[b]} ${side}=${cfg[side].ref}${cfg.mode === 'builds' ? `@${cfg[side].slot}` : ''}: ${r.outcome}${primary && typeof primary[1] === 'number' ? ` ${primary[0]}=${primary[1].toFixed(3)}` : ''}${r.reason ? ` (${r.reason})` : ''}${r.error ? ` (${String(r.error).split('\\n')[0]})` : ''}`);\n   185\t      }\n   186\t    }\n   187\t    record.environment.loadAverageAtEnd = os.loadavg();\n   188\t    // The bytes on disk must still be the bytes the manifest names, and every served file must have matched.\n   189\t    for (const m of Object.values(slots)) readArtifact(m.dir);\n   190\t    if (server.violations().length) {\n   191\t      record.analysis = { notCompared: [`served files differed from the artifact manifest: ${server.violations().join('; ')}`] };\n   192\t      await stop('aborted', 'artifact integrity');\n   193\t      return record;\n   194\t    }\n   195\t    record.analysis = analyze(cfg.workload, record.runs, { noise: cfg.noise ?? null, bootstrapSeed: cfg.bootstrapSeed });\n   196\t    await stop('complete', 'all blocks run');\n   197\t    log(formatAnalysis(record));\n   198\t    return record;\n   199\t  } catch (e) {\n   200\t    record.error = String(e?.stack ?? e);\n   201\t    await stop('aborted', 'runner error');\n   202\t    throw e;\n   203\t  } finally {\n   204\t    for (const [sig, h] of handlers) process.off(sig, h);\n   205\t  }\n   206\t}\n   207\t\n   208\t/**\n   209\t * Plan 6, pull requests: a result worse than the workload's tolerance triggers one automatic rerun; two in a row\n   210\t * flag the change. \"Worse than the tolerance\" here: the primary metric's outcome is \"worse\" and the lower end of\n   211\t * its interval is above the declared tolerance (so the regression is larger than tolerated, not just non-zero).\n   212\t */\n   213\texport function screeningVerdict(record, tolerance) {\n   214\t  const m = Object.values(record.analysis?.metrics ?? {}).find(x => x.primary);\n   215\t  if (!m || m.na) return { exceeds: false, why: `primary metric not available${m?.na ? `: ${m.na}` : ''}` };\n   216\t  const exceeds = m.outcome === 'worse' && m.lo > tolerance;\n   217\t  return { exceeds, why: `${m.key}: ${m.outcome}, interval [${m.lo}, ${m.hi}] against tolerance ${tolerance}` };\n   218\t}\n   219\t\n   220\tasync function main() {\n   221\t  const die = msg => { console.error(`run.mjs: ${msg}`); process.exit(2); };\n   222\t  let a;\n   223\t  try {\n   224\t    ({ values: a } = parseArgs({\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc 'nl -ba bench/lib/refs.mjs && nl -ba bench/analyze.mjs && nl -ba bench/lib/report.mjs'","aggregated_output":"     1\t// Adapter references, workloads and noise bands for the runner and the analyzer.\n     2\timport fs from 'node:fs';\n     3\timport path from 'node:path';\n     4\timport { MIN_BAND_PAIRS, MIN_BAND_SESSIONS } from '../src/stats.js';\n     5\t\n     6\texport const WORKLOADS = ['first', 'page', 'compact', 'scatter', 'stream', 'theme', 'resize', 'hover', 'zoom', 'mem', 'lifecycle'];\n     7\t\n     8\t/**\n     9\t * \"axylo:renderer=svg,build=dev\" -> { id: 'axylo', params: { renderer: 'svg', build: 'dev' } }.\n    10\t * Values stay strings except true/false and plain numbers.\n    11\t */\n    12\texport function parseAdapterRef(ref) {\n    13\t  const [id, rest] = String(ref).split(/:(.*)/s);\n    14\t  if (!/^[a-z0-9-]+$/.test(id)) throw new Error(`adapter reference \"${ref}\": the id must be lowercase letters, digits and dashes`);\n    15\t  const params = {};\n    16\t  if (rest) for (const part of rest.split(',')) {\n    17\t    const m = /^([A-Za-z][\\w-]*)=(.*)$/.exec(part);\n    18\t    if (!m) throw new Error(`adapter reference \"${ref}\": parameter \"${part}\" is not key=value`);\n    19\t    params[m[1]] = m[2] === 'true' ? true : m[2] === 'false' ? false : /^-?\\d+(\\.\\d+)?$/.test(m[2]) ? Number(m[2]) : m[2];\n    20\t  }\n    21\t  return { id, params };\n    22\t}\n    23\t\n    24\t/** JSON with sorted keys, so two parameter objects compare equal whatever order they were written in. */\n    25\texport function stableJson(v) {\n    26\t  if (Array.isArray(v)) return `[${v.map(stableJson).join(',')}]`;\n    27\t  if (v && typeof v === 'object') return `{${Object.keys(v).filter(k => v[k] !== undefined).sort().map(k => `${JSON.stringify(k)}:${stableJson(v[k])}`).join(',')}}`;\n    28\t  return JSON.stringify(v);\n    29\t}\n    30\t\n    31\t/**\n    32\t * What a noise band must match to be used for a comparison: the measured thing (workload, parameters, settle, pixel\n    33\t * ratio), the bytes (every file the A-versus-A run loaded, by hash, must be byte-identical in the comparison's\n    34\t * artifact), the browser (Chrome version, headless or headed) and the machine (host name, CPU model, cores).\n    35\t * Taken from a history record, so the analyzer derives it from the record it replays.\n    36\t */\n    37\texport function controlsOf(record) {\n    38\t  const d = record.design ?? {}, env = record.environment ?? {};\n    39\t  return {\n    40\t    workload: d.workload, params: d.params, settleMs: d.settleMs, dpr: d.dpr ?? 1,\n    41\t    chrome: env.browser?.version, headless: env.browser?.headless,\n    42\t    host: env.host ?? null,\n    43\t    files: record.hashes?.files ?? null,\n    44\t    slots: record.hashes?.slots ?? null,\n    45\t  };\n    46\t}\n    47\t\n    48\tconst hostKey = h => (h ? `${h.hostname} / ${h.cpuModel} / ${h.logicalCores} cores` : 'not recorded');\n    49\t\n    50\t/** Every reason the A-versus-A record `n` cannot serve as a band for a comparison with controls `c`. */\n    51\texport function bandMismatches(n, c) {\n    52\t  const out = [];\n    53\t  const nc = controlsOf(n);\n    54\t  if (nc.workload !== c.workload) out.push(`workload ${nc.workload}, comparison ${c.workload}`);\n    55\t  if (stableJson(nc.params) !== stableJson(c.params)) out.push(`parameters ${stableJson(nc.params)}, comparison ${stableJson(c.params)}`);\n    56\t  if (nc.settleMs !== c.settleMs) out.push(`settle ${nc.settleMs} ms, comparison ${c.settleMs} ms`);\n    57\t  if (nc.dpr !== c.dpr) out.push(`device pixel ratio ${nc.dpr}, comparison ${c.dpr}`);\n    58\t  if (nc.chrome !== c.chrome) out.push(`Chrome ${nc.chrome}, comparison ${c.chrome}`);\n    59\t  if (nc.headless !== c.headless) out.push(`${nc.headless ? 'headless' : 'headed'}, comparison ${c.headless ? 'headless' : 'headed'}`);\n    60\t  if (!nc.host || !c.host || hostKey(nc.host) !== hostKey(c.host)) out.push(`host ${hostKey(nc.host)}, comparison ${hostKey(c.host)}`);\n    61\t  // Bytes: every file the band's run loaded must be the same file in one of the comparison's slots.\n    62\t  const served = n.hashes?.slots?.A?.served;\n    63\t  if (!served || !Object.keys(served).length) out.push('the band record does not say which files it served (older record)');\n    64\t  else if (!c.slots) out.push('the comparison does not record its artifact files');\n    65\t  else {\n    66\t    const fits = ['A', 'B'].some(slot => {\n    67\t      const files = c.slots[slot]?.files;\n    68\t      return files && Object.entries(served).every(([p, h]) => files[p] === h);\n    69\t    });\n    70\t    if (!fits) {\n    71\t      const diff = Object.entries(served).filter(([p, h]) => c.slots.A?.files?.[p] !== h && c.slots.B?.files?.[p] !== h).map(([p]) => p);\n    72\t      out.push(`built from different bytes: ${diff.slice(0, 4).join(', ')}${diff.length > 4 ? ', …' : ''} differ from both of the comparison's artifacts`);\n    73\t    }\n    74\t  }\n    75\t  return out;\n    76\t}\n    77\t\n    78\t/**\n    79\t * Loads one or more complete A-versus-A records and checks each against the comparison's controls. A record that\n    80\t * does not match is refused (an error, not a warning): a band from another pixel ratio, build or machine is not\n    81\t * this comparison's noise. With several, the band is their union per metric (lowest lo, highest hi). A metric's\n    82\t * band is used only from records with at least MIN_BAND_PAIRS complete pairs for it; fewer than\n    83\t * MIN_BAND_SESSIONS records (sessions) make the band exploratory, which the report says.\n    84\t */\n    85\texport function loadNoise(refs, historyDir, controls) {\n    86\t  if (!controls || !controls.workload) throw new Error('loadNoise needs the comparison\\'s controls (controlsOf(record))');\n    87\t  const sources = [], metrics = {}, problems = [];\n    88\t  for (const ref of refs) {\n    89\t    const p = fs.existsSync(ref) ? ref : path.join(historyDir, `${ref}.json`);\n    90\t    if (!fs.existsSync(p)) { problems.push(`noise run ${ref} not found`); continue; }\n    91\t    const n = JSON.parse(fs.readFileSync(p, 'utf8'));\n    92\t    if (n.design?.mode !== 'aa' || n.status !== 'complete' || !n.analysis?.metrics) { problems.push(`noise run ${ref} is not a complete, analysed A-versus-A run`); continue; }\n    93\t    const mism = bandMismatches(n, controls);\n    94\t    if (mism.length) { problems.push(`noise run ${ref} does not match this comparison: ${mism.join('; ')}`); continue; }\n    95\t    sources.push({ runId: n.runId, adapter: n.design.baseline, chrome: n.environment.browser.version, dpr: n.design.dpr, completePairs: n.analysis.completePairs });\n    96\t    for (const [k, m] of Object.entries(n.analysis.metrics)) {\n    97\t      if (!Number.isFinite(m.lo) || !Number.isFinite(m.hi) || !(m.pairs >= MIN_BAND_PAIRS)) continue;\n    98\t      const cur = metrics[k];\n    99\t      metrics[k] = cur ? { lo: Math.min(cur.lo, m.lo), hi: Math.max(cur.hi, m.hi), from: [...cur.from, n.runId] } : { lo: m.lo, hi: m.hi, from: [n.runId] };\n   100\t    }\n   101\t  }\n   102\t  if (problems.length) throw new Error(problems.join('\\n'));\n   103\t  const sessions = new Set(sources.map(s => s.runId)).size;\n   104\t  return {\n   105\t    sources, metrics, sessions,\n   106\t    calibration: sessions >= MIN_BAND_SESSIONS ? `band from ${sessions} sessions` : `exploratory: band from ${sessions} session${sessions === 1 ? '' : 's'}; plan 3.3 asks for at least ${MIN_BAND_SESSIONS}`,\n   107\t    minPairs: MIN_BAND_PAIRS,\n   108\t  };\n   109\t}\n     1\t#!/usr/bin/env node\n     2\t// Prints a history record's stored analysis, or re-analyses it. Never modifies the file.\n     3\t//\n     4\t//   node bench/analyze.mjs <run id | path>                               the analysis stored in the record\n     5\t//   node bench/analyze.mjs <run> --reanalyze                             recompute, with the record's own noise band\n     6\t//   node bench/analyze.mjs <run> --reanalyze --noise <aa id>[,<aa id>]   recompute against these bands (checked)\n     7\t//   node bench/analyze.mjs <run> --reanalyze --zero-only                 recompute against zero only, labelled so\n     8\t//\n     9\t// A re-analysis of a record that was classified against a noise band resolves that band again from its A-versus-A\n    10\t// records and checks that they still match (workload, parameters, build bytes, pixel ratio, Chrome, host). If they\n    11\t// cannot be resolved, it stops: dropping the band silently would turn \"inconclusive\" into \"better\".\n    12\timport fs from 'node:fs';\n    13\timport path from 'node:path';\n    14\timport { parseArgs } from 'node:util';\n    15\timport { BENCH } from './build.mjs';\n    16\timport { analyze, parseSeed, DEFAULT_BOOTSTRAP_SEED } from './src/stats.js';\n    17\timport { formatAnalysis } from './lib/report.mjs';\n    18\timport { loadNoise, controlsOf } from './lib/refs.mjs';\n    19\t\n    20\tconst die = msg => { console.error(`analyze.mjs: ${msg}`); process.exit(2); };\n    21\tlet values, positionals;\n    22\ttry {\n    23\t  ({ values, positionals } = parseArgs({ allowPositionals: true, options: {\n    24\t    noise: { type: 'string' }, reanalyze: { type: 'boolean', default: false }, 'zero-only': { type: 'boolean', default: false },\n    25\t    'bootstrap-seed': { type: 'string' }, 'history-dir': { type: 'string' }, json: { type: 'boolean', default: false },\n    26\t  } }));\n    27\t} catch (e) { die(e.message); }\n    28\tconst historyDir = path.resolve(values['history-dir'] ?? path.join(BENCH, 'history'));\n    29\tif (!positionals[0]) die('usage: node bench/analyze.mjs <run id | path> [--reanalyze [--noise <ids> | --zero-only] [--bootstrap-seed N]]');\n    30\tconst file = fs.existsSync(positionals[0]) ? positionals[0] : path.join(historyDir, `${positionals[0]}.json`);\n    31\tif (!fs.existsSync(file)) die(`no history record ${positionals[0]} (looked in ${historyDir})`);\n    32\tconst rec = JSON.parse(fs.readFileSync(file, 'utf8'));\n    33\tif (rec.status !== 'complete') console.log(`note: this record's status is \"${rec.status}\"${rec.endedBecause ? ` (${rec.endedBecause})` : ''}`);\n    34\t\n    35\tif (!values.reanalyze) {\n    36\t  if (values.noise || values['zero-only'] || values['bootstrap-seed']) die('--noise, --zero-only and --bootstrap-seed change the analysis; add --reanalyze');\n    37\t  if (!rec.analysis) die('the record holds no stored analysis (interrupted before the end); use --reanalyze to analyse the runs it holds');\n    38\t  console.log(values.json ? JSON.stringify(rec.analysis, null, 1) : formatAnalysis(rec, { source: 'stored' }));\n    39\t  process.exit(0);\n    40\t}\n    41\t\n    42\tif (values.noise && values['zero-only']) die('give either --noise or --zero-only, not both');\n    43\tif (!rec.runs?.some(r => r.phase === 'timed')) die('the record has no timed runs to analyse');\n    44\tlet noise = null;\n    45\tconst recorded = rec.design?.noiseFrom ? [].concat(rec.design.noiseFrom).map(n => n.runId) : null;\n    46\tif (values.noise || (recorded && !values['zero-only'])) {\n    47\t  const ids = values.noise ? values.noise.split(',') : recorded;\n    48\t  try { noise = loadNoise(ids, historyDir, controlsOf(rec)); }\n    49\t  catch (e) {\n    50\t    die(`${values.noise ? 'the given' : 'the record\\'s'} noise band cannot be used:\\n${e.message}\\n` +\n    51\t      'Re-analysis stops here rather than classify against zero. Use --zero-only to ask for a zero-only analysis explicitly; it is labelled as such.');\n    52\t  }\n    53\t  rec.design.noiseFrom = noise.sources;\n    54\t  rec.design.noiseCalibration = noise.calibration;\n    55\t}\n    56\tlet bootstrapSeed = rec.design?.bootstrapSeed ?? DEFAULT_BOOTSTRAP_SEED;\n    57\tif (values['bootstrap-seed']) { try { bootstrapSeed = parseSeed(values['bootstrap-seed'], '--bootstrap-seed'); } catch (e) { die(e.message); } }\n    58\trec.analysis = analyze(rec.design.workload, rec.runs, { noise, bootstrapSeed, zeroOnly: values['zero-only'] });\n    59\tconsole.log(values.json ? JSON.stringify(rec.analysis, null, 1) : formatAnalysis(rec, { source: 're-analysis' }));\n     1\t// Plain-text summary of a history record's analysis.\n     2\tconst fmtBytes = v => (typeof v !== 'number' || !Number.isFinite(v) ? 'n/a' : Math.abs(v) >= 2 ** 20 ? `${(v / 2 ** 20).toFixed(2)} MiB` : `${(v / 1024).toFixed(1)} KiB`);\n     3\tconst fmt = v => (typeof v !== 'number' || !Number.isFinite(v) ? 'n/a' : Math.abs(v) >= 100 ? v.toFixed(1) : Math.abs(v) >= 1 ? v.toFixed(2) : v.toFixed(3));\n     4\t\n     5\t/** The band a metric was classified against, as one cell. */\n     6\texport function bandCell(m, f = fmt) {\n     7\t  if (m.noiseBand && typeof m.noiseBand === 'object') return `[${f(m.noiseBand.lo)}, ${f(m.noiseBand.hi)}]`;\n     8\t  if (typeof m.noiseBand === 'string' && m.noiseBand.startsWith('zero-only')) return 'zero only (requested)';\n     9\t  return 'zero only (no band)';\n    10\t}\n    11\t\n    12\t/**\n    13\t * @param record  a history record\n    14\t * @param opts    { source: 'stored' | 're-analysis' } says where the analysis came from\n    15\t */\n    16\texport function formatAnalysis(record, { source = 'stored' } = {}) {\n    17\t  const { design, analysis } = record;\n    18\t  const lines = [];\n    19\t  if (!analysis) return 'no analysis (run incomplete)';\n    20\t  if (analysis.notCompared) return `not compared: ${analysis.notCompared.join('; ')}`;\n    21\t  const A = design.mode === 'aa' ? `${design.baseline} (A)` : design.baseline, B = design.mode === 'aa' ? `${design.candidate} (A')` : design.candidate;\n    22\t  lines.push(`\\n${record.runId}  [${record.status}]  analysis: ${source === 'stored' ? 'stored in the record' : 'RE-ANALYSIS (not the stored one)'}`);\n    23\t  lines.push(`${design.mode === 'aa' ? 'A-versus-A' : design.mode === 'builds' ? 'two builds' : 'comparison'}: A=${A}  B=${B}  workload ${design.workload} ${JSON.stringify(design.params)}`);\n    24\t  if (design.mode === 'builds') lines.push(`  builds: A=${design.builds?.A}  B=${design.builds?.B}`);\n    25\t  lines.push(`complete pairs ${analysis.completePairs}/${analysis.blocks}; run outcomes ${JSON.stringify(analysis.outcomes)}; order seed ${design.seed}, bootstrap seed ${analysis.bootstrapSeed ?? design.bootstrapSeed ?? 'not recorded (12345 in records before it was recorded)'}`);\n    26\t  const rel = analysis.reliability;\n    27\t  if (rel) {\n    28\t    lines.push(`reliability: failed runs A ${rel.failed.A}/${rel.timed.A}, B ${rel.failed.B}/${rel.timed.B}${rel.adverseKey ? `; runs with ${rel.adverseKey} > 0: A ${rel.adverse.A}, B ${rel.adverse.B}` : ''}`);\n    29\t    if (rel.conditional) lines.push('  TIMINGS ARE CONDITIONAL: survivor-only, the failed runs are not in them');\n    30\t    if (rel.betterBlocked) lines.push(`  no \"better\" verdict: ${rel.betterBlocked}`);\n    31\t  }\n    32\t  const noise = design.noiseFrom;\n    33\t  lines.push(`noise band: ${analysis.zeroOnly ? 'ZERO-ONLY ANALYSIS, explicitly requested: outcomes test against zero only' : noise ? `from ${[].concat(noise).map(n => n.runId).join(' + ')}${design.noiseCalibration ? ` (${design.noiseCalibration})` : ''}` : 'none given (outcomes test against zero only)'}`);\n    34\t  lines.push('');\n    35\t  const head = ['metric', 'median A', 'median B', 'B-A', '95% CI', 'AB | BA', 'B/A-1', 'band used', 'outcome'];\n    36\t  const rows = [head];\n    37\t  for (const [key, m] of Object.entries(analysis.metrics)) {\n    38\t    if (m.na) { rows.push([`${key}${m.primary ? ' *' : ''}`, m.na, '', '', '', '', '', '', '']); continue; }\n    39\t    const f = m.unit === 'bytes' ? fmtBytes : fmt;\n    40\t    const order = m.byOrder ? `${f(m.byOrder.AB?.diff)} | ${f(m.byOrder.BA?.diff)}` : 'n/a';\n    41\t    rows.push([`${key}${m.primary ? ' *' : ''}`, f(m.medianA), f(m.medianB), f(m.diff), `[${f(m.lo)}, ${f(m.hi)}]`, order, m.relative == null ? 'n/a' : `${(m.relative * 100).toFixed(1)}%`, bandCell(m, f),\n    42\t      m.outcome + (m.outcomeNote ? ' (rule)' : '') + (m.conditional ? ' (conditional)' : '')]);\n    43\t  }\n    44\t  const w = head.map((_, i) => Math.max(...rows.map(r => String(r[i]).length)));\n    45\t  for (const r of rows) lines.push(r.map((c, i) => String(c).padEnd(w[i])).join('  '));\n    46\t  const notes = [...new Set(Object.values(analysis.metrics).map(m => m.outcomeNote).filter(Boolean))];\n    47\t  for (const n of notes) lines.push(`(rule): ${n}`);\n    48\t  lines.push('* primary metric. Lower is better for every metric. Units: ms unless the metric counts something (samples, frames, calls, nodes) or is memory (KiB/MiB).');\n    49\t  lines.push('AB | BA: the difference of medians within blocks run in each order; a large gap between them is carry-over between the two configurations.');\n    50\t  if (design.mode === 'aa') lines.push('A-versus-A: the 95% CI column is this session\\'s noise band for each metric (one session; the plan asks for three).');\n    51\t  if (record.probes && Object.keys(record.probes).length) {\n    52\t    lines.push('');\n    53\t    lines.push('untimed probe runs (not timings):');\n    54\t    for (const [id, p] of Object.entries(record.probes)) lines.push(`  ${id}: ${p.kind} ${p.outcome}${p.summary ? ` ${JSON.stringify(p.summary)}` : ''}${p.reason ? ` (${p.reason})` : ''}`);\n    55\t  }\n    56\t  return lines.join('\\n');\n    57\t}\n","exit_code":0,"status":"completed"}}
