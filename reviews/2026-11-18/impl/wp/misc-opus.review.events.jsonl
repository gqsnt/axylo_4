{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc 'nl -ba bench/src/adapters/uplot.js; nl -ba bench/src/adapters/chartjs-common.js; nl -ba bench/src/adapters/chartjs-tuned.js'","aggregated_output":"     1\t// uPlot, default configuration.\n     2\t//\n     3\t// Options set, and why (none of them is a performance option):\n     4\t//   width, height   uPlot has no automatic sizing; the container's size, minus room for its legend row below the plot.\n     5\t//                   In the resize workload a ResizeObserver calls setSize (see below).\n     6\t//   ms: 1           the fixture's x is epoch milliseconds; uPlot's default unit is seconds. The documented\n     7\t//                   alternative to dividing every timestamp by 1,000.\n     8\t//   series[].stroke uPlot has no default palette; without a stroke a series is not drawn.\n     9\t//   series[].label  names in the legend, as every adapter shows them.\n    10\t// Everything else (axes, legend, cursor, scales, gaps) is uPlot's default.\n    11\t//\n    12\t// Input: typed columns go to uPlot as they are (it accepts typed arrays). uPlot marks a gap with null, which a\n    13\t// Float64Array cannot hold, so a column containing NaN is copied into a plain array with null in its place; that\n    14\t// copy is part of the timed work because it is what feeding uPlot this data costs.\n    15\t//\n    16\t// Not configured here: scatter (uPlot's default configuration draws lines) and a compact variant; those workloads\n    17\t// report \"not available\" for uPlot.\n    18\timport uPlot from 'uplot';\n    19\timport css from 'uplot/dist/uPlot.min.css';\n    20\timport { uplotDrawnPaths } from '../drawn.js';\n    21\t\n    22\texport { uplotDrawnPaths };\n    23\t\n    24\tconst COLORS = ['#1f77b4', '#d62728', '#2ca02c', '#9467bd', '#ff7f0e'];\n    25\tconst LEGEND_ROOM = 30;\n    26\t\n    27\tfunction column(col, mutable) {\n    28\t  let gap = false;\n    29\t  for (let i = 0; i < col.length; i++) if (col[i] !== col[i]) { gap = true; break; }\n    30\t  if (!gap && !mutable) return col;\n    31\t  const out = new Array(col.length);\n    32\t  for (let i = 0; i < col.length; i++) out[i] = col[i] === col[i] ? col[i] : null;\n    33\t  return out;\n    34\t}\n    35\t\n    36\t/** Shared by the default adapter and the deliberately broken test variants; `tweak` may change options or behaviour. */\n    37\texport function createUplot(el, fix, opts = {}, tweak = {}) {\n    38\t  const stream = !!opts.window;\n    39\t  // Streaming appends with push/shift on plain arrays, uPlot's own streaming pattern; typed arrays cannot grow.\n    40\t  const data = [stream ? Array.from(fix.x) : fix.x, ...fix.ys.map(c => column(c, stream))];\n    41\t  let drawnNewest = NaN, pending = true, waiters = [];\n    42\t  const options = {\n    43\t    width: el.clientWidth,\n    44\t    height: el.clientHeight - LEGEND_ROOM,\n    45\t    ms: 1,\n    46\t    series: [{}, ...fix.names.map((n, i) => ({ label: n, stroke: COLORS[i % COLORS.length] }))],\n    47\t    hooks: {\n    48\t      // Instrumentation, not configuration: record what the chart had when it last drew, and resolve readiness.\n    49\t      draw: [u => { const xs = u.data[0]; drawnNewest = xs[xs.length - 1]; pending = false; const w = waiters; waiters = []; for (const r of w) r(); }],\n    50\t    },\n    51\t  };\n    52\t  tweak.options?.(options);\n    53\t  // Resize workload only: uPlot does not follow its container; its demos use a resize listener and setSize. A\n    54\t  // ResizeObserver on the container is the same pattern for a container that changes without a window resize.\n    55\t  // It is registered before uPlot exists so it always runs first and marks the chart as having a draw pending.\n    56\t  let observer = null, u = null;\n    57\t  if (opts.resize) {\n    58\t    observer = new ResizeObserver(() => {\n    59\t      if (!u) return;\n    60\t      const w = el.clientWidth, h = el.clientHeight - LEGEND_ROOM;\n    61\t      if (w !== u.width || h !== u.height) { pending = true; u.setSize({ width: w, height: h }); }\n    62\t    });\n    63\t    observer.observe(el);\n    64\t  }\n    65\t  u = new uPlot(options, data, el);\n    66\t  // Readiness is re-evaluated: after a resize or zoom, a draw is pending until uPlot's draw hook runs again.\n    67\t  const readyNow = () => (pending ? new Promise(r => waiters.push(r)) : Promise.resolve());\n    68\t  return {\n    69\t    u,\n    70\t    get ready() { return readyNow(); },\n    71\t    append(x, ys) {\n    72\t      data[0].push(x);\n    73\t      for (let s = 0; s < ys.length; s++) data[s + 1].push(ys[s] === ys[s] ? ys[s] : null);\n    74\t      if (!tweak.noTrim) {\n    75\t        data[0].shift();\n    76\t        for (let s = 0; s < ys.length; s++) data[s + 1].shift();\n    77\t      }\n    78\t      pending = true;\n    79\t      u.setData(data);\n    80\t    },\n    81\t    drawnNewestX: () => drawnNewest,\n    82\t    zoom(lo, hi) { pending = true; u.setScale('x', { min: lo, max: hi }); },\n    83\t    hoverTarget: () => u.over,\n    84\t    hoveredIndex: () => (u.cursor.idx == null ? NaN : u.cursor.idx),\n    85\t    // The legend's live value for series 1 reads datum i in uPlot's own value format.\n    86\t    readoutShows(i) {\n    87\t      const v = u.root.querySelectorAll('.u-legend .u-series')[1]?.querySelector('.u-value');\n    88\t      if (!v) return false;\n    89\t      return v.textContent === String(u.series[1].value(u, u.data[1][i], 1, i));\n    90\t    },\n    91\t    // Reads uPlot's own state, not the fixture:\n    92\t    //   x range  u.scales.x.min / max   (milliseconds, because of ms: 1)\n    93\t    //   y range  u.scales.y.min / max   (the one value scale every series uses by default)\n    94\t    //   per series: u.data[0].length, u.data[0][0], u.data[0][last], the count of null in u.data[s], and the\n    95\t    //   drawn index paths (uplotDrawnPaths over series.idxs and series.spanGaps)\n    96\t    describe() {\n    97\t      const xs = u.data[0];\n    98\t      return {\n    99\t        reads: 'uPlot u.scales.x/y.{min,max}; u.data[0] length and ends; null count in u.data[s]; drawn paths from u.series[s].idxs and null breaks',\n   100\t        x: [u.scales.x.min, u.scales.x.max],\n   101\t        y: [u.scales.y.min, u.scales.y.max],\n   102\t        series: u.data.slice(1).map((col, i) => {\n   103\t          let missing = 0;\n   104\t          for (let k = 0; k < col.length; k++) if (col[k] == null) missing++;\n   105\t          const s = u.series[i + 1];\n   106\t          return { points: col.length, oldestX: xs[0], newestX: xs[xs.length - 1], missing, drawn: { kind: 'indices', paths: uplotDrawnPaths(col, s.idxs, !!s.spanGaps) } };\n   107\t        }),\n   108\t      };\n   109\t    },\n   110\t    destroy: () => { observer?.disconnect(); u.destroy(); },\n   111\t  };\n   112\t}\n   113\t\n   114\texport default {\n   115\t  id: 'uplot',\n   116\t  library: 'uPlot',\n   117\t  version: __VERSIONS__.uplot,\n   118\t  config: 'default',\n   119\t  available: workload => (workload === 'scatter' || workload === 'compact' ? { ok: false, reason: `no ${workload} configuration for uPlot in this harness` } : { ok: true }),\n   120\t  setup() {\n   121\t    const s = document.createElement('style');\n   122\t    s.textContent = css;\n   123\t    document.head.appendChild(s);\n   124\t  },\n   125\t  create: (el, fix, opts) => createUplot(el, fix, opts),\n   126\t};\n     1\t// Chart.js plumbing shared by the starter-default and tuned adapters: readiness, the draw record used by the\n     2\t// streaming workload, the readback for the admission check, zoom and hover.\n     3\timport { Chart, animator } from 'chart.js/auto';\n     4\timport 'chartjs-adapter-date-fns'; // a date adapter must be registered before a time scale works\n     5\timport { chartjsDrawnPaths } from '../drawn.js';\n     6\t\n     7\texport { Chart };\n     8\t\n     9\t/** Instrumentation plugin, identical in both configurations. It changes nothing that is drawn. */\n    10\texport function benchPlugin(state, newestOf) {\n    11\t  return {\n    12\t    id: 'axyloBench',\n    13\t    // Chart.js notifies afterRender once a render has finished, including its animation (onAnimationsComplete).\n    14\t    afterRender: chart => { if (!animator.running(chart)) state.settled(); },\n    15\t    afterDraw: chart => {\n    16\t      state.drawnNewest = newestOf(chart);\n    17\t      const t = chart.tooltip;\n    18\t      state.tooltipIndex = t && t.opacity > 0 && t.dataPoints?.length ? t.dataPoints[0].dataIndex : NaN;\n    19\t    },\n    20\t  };\n    21\t}\n    22\t\n    23\texport function handleFor(chart, state, append, heldData) {\n    24\t  return {\n    25\t    chart,\n    26\t    get ready() { return state.readyNow(); },\n    27\t    append(x, ys) { state.pending = true; append(x, ys); },\n    28\t    drawnNewestX: () => state.drawnNewest,\n    29\t    zoom(lo, hi) {\n    30\t      state.pending = true;\n    31\t      chart.options.scales.x.min = lo;\n    32\t      chart.options.scales.x.max = hi;\n    33\t      chart.update('none');\n    34\t    },\n    35\t    hoverTarget: () => chart.canvas,\n    36\t    hoveredIndex: () => { const a = chart.getActiveElements?.(); return a?.length ? a[0].index : NaN; },\n    37\t    readoutShows: i => state.tooltipIndex === i,\n    38\t    // Reads Chart.js's own objects, not the fixture:\n    39\t    //   x range  chart.scales.x.min / max  (time scale: epoch milliseconds)\n    40\t    //   y range  chart.scales.y.min / max\n    41\t    //   per series: the data the chart holds, from heldData(chart, i): the parsed points (meta._parsed) for the\n    42\t    //   starter config, and for the tuned config dataset._data when the decimation plugin has replaced\n    43\t    //   dataset.data with its decimated copy, else dataset.data. Points, first and last x, and the number of\n    44\t    //   points whose y is null or NaN (Chart.js skips both).\n    45\t    //   drawn: the points the line controller draws (the decimated dataset.data when decimation is active, else\n    46\t    //   the held points), as index paths (chartjsDrawnPaths).\n    47\t    describe() {\n    48\t      return {\n    49\t        reads: 'Chart.js chart.scales.x/y.{min,max}; held points per dataset; drawn points (decimated dataset.data when active) as index paths',\n    50\t        x: [chart.scales.x.min, chart.scales.x.max],\n    51\t        y: [chart.scales.y.min, chart.scales.y.max],\n    52\t        series: chart.data.datasets.map((ds, i) => {\n    53\t          const pts = heldData(chart, i);\n    54\t          let missing = 0;\n    55\t          for (let k = 0; k < pts.length; k++) { const y = pts[k].y; if (y == null || y !== y) missing++; }\n    56\t          const heldX = pts.map(p => p.x);\n    57\t          const drawnPoints = ds._decimated ? ds.data : pts;\n    58\t          const spanGaps = !!(ds.spanGaps ?? chart.options.spanGaps);\n    59\t          return { points: pts.length, oldestX: pts[0]?.x, newestX: pts[pts.length - 1]?.x, missing, drawnPoints: drawnPoints.length, drawn: { kind: 'indices', paths: chartjsDrawnPaths(drawnPoints, heldX, spanGaps), decimated: !!ds._decimated } };\n    60\t        }),\n    61\t      };\n    62\t    },\n    63\t    destroy: () => chart.destroy(),\n    64\t  };\n    65\t}\n    66\t\n    67\t/** Readiness that can be awaited again after an update: a render is pending until afterRender with no animation. */\n    68\texport function newState() {\n    69\t  const state = { drawnNewest: NaN, tooltipIndex: NaN, pending: true, waiters: [] };\n    70\t  state.settled = () => { state.pending = false; const w = state.waiters; state.waiters = []; for (const r of w) r(); };\n    71\t  state.readyNow = () => (state.pending ? new Promise(r => state.waiters.push(r)) : Promise.resolve());\n    72\t  return state;\n    73\t}\n    74\t\n    75\t/**\n    76\t * A canvas for the chart. In the resize workload a ResizeObserver, registered before Chart.js creates its own,\n    77\t * marks a render as pending whenever the container changes, so readiness waits for Chart.js's re-render.\n    78\t */\n    79\texport function canvasIn(el, state, opts = {}) {\n    80\t  if (opts.resize) {\n    81\t    let last = el.clientWidth;\n    82\t    new ResizeObserver(() => { if (el.clientWidth !== last) { last = el.clientWidth; state.pending = true; } }).observe(el);\n    83\t  }\n    84\t  const c = document.createElement('canvas');\n    85\t  el.appendChild(c);\n    86\t  return c;\n    87\t}\n    88\t\n    89\texport const chartjsAvailable = workload => (workload === 'scatter' || workload === 'compact' ? { ok: false, reason: `no ${workload} configuration for Chart.js in this harness` } : { ok: true });\n     1\t// Chart.js, tuned, keeping the same visible features as the starter default: time x axis, y axis, legend, tooltip.\n     2\t//\n     3\t// Every option that differs from chartjs.js, with the reason and the page that recommends it\n     4\t// (https://www.chartjs.org/docs/latest/general/performance.html unless noted):\n     5\t//   animation: false            \"Disable animations\": no entry or update animation, so a create or an update is\n     6\t//                               one render. Visible difference: the line appears without the entry animation.\n     7\t//   parsing: false, data as     \"Data structure and format\": skip parsing; data handed in Chart.js's internal\n     8\t//   {x, y} with numeric x       format. Required for the decimation plugin.\n     9\t//   normalized: true            \"Data normalization\": the fixture's x is unique, sorted and consistent across\n    10\t//                               datasets, so Chart.js may skip checking it.\n    11\t//   plugins.decimation:         \"Data decimation\" (docs/latest/configuration/decimation.html). min-max keeps each\n    12\t//     { enabled, 'min-max' }    pixel column's lowest and highest point, so spikes such as the injected extreme stay.\n    13\t//                               Active only above 4x the canvas width in points. Known fidelity risk: min-max skips\n    14\t//                               NaN values, so above that threshold a gap can be drawn across. The readback reports\n    15\t//                               the decimated copy Chart.js draws (chartjs-common.js, chartjsDrawnPaths), and the\n    16\t//                               admission check rejects a drawing that joins retained points across a missing value:\n    17\t//                               on gappy data above the threshold this configuration is not admitted.\n    18\t//   elements.point.radius: 0    \"Disable point drawing\" (elements.point.radius / pointRadius). Visible difference:\n    19\t//                               no point markers, which on 3x120 are visible dots and on 10k+ points a solid band.\n    20\t//   interaction: { mode:        keeps the tooltip reachable without markers: with the default intersect: true and\n    21\t//     'nearest', axis: 'x',     radius 0 the pointer must hit a 1 px target (docs/latest/configuration/interactions.html).\n    22\t//     intersect: false }\n    23\t// Not applied: fixed scale min/max and ticks.sampleSize / rotation limits (\"Specify min and max for scales\",\n    24\t// \"Disable ticks rotation\") because they need knowledge of the data or change the axis labels.\n    25\t//\n    26\t// Input: one {x, y} object per point is built from the typed columns inside the timed work; Chart.js has no typed\n    27\t// column input. Streaming pushes and shifts the same array and calls chart.update('none').\n    28\timport { Chart, benchPlugin, handleFor, newState, canvasIn, chartjsAvailable } from './chartjs-common.js';\n    29\t\n    30\tconst held = (chart, i) => { const d = chart.data.datasets[i]; return d._data ?? d.data; };\n    31\tconst newestHeld = chart => { const d = held(chart, 0); return d[d.length - 1]?.x; };\n    32\t\n    33\texport default {\n    34\t  id: 'chartjs-tuned',\n    35\t  library: 'Chart.js',\n    36\t  version: __VERSIONS__['chart.js'],\n    37\t  config: 'tuned, same visible features',\n    38\t  available: chartjsAvailable,\n    39\t  create(el, fix, opts = {}) {\n    40\t    const state = newState();\n    41\t    const n = fix.x.length;\n    42\t    const arrays = fix.ys.map(col => {\n    43\t      const pts = new Array(n);\n    44\t      for (let k = 0; k < n; k++) pts[k] = { x: fix.x[k], y: col[k] };\n    45\t      return pts;\n    46\t    });\n    47\t    const chart = new Chart(canvasIn(el, state, opts), {\n    48\t      type: 'line',\n    49\t      data: { datasets: arrays.map((data, i) => ({ label: fix.names[i], data })) },\n    50\t      options: {\n    51\t        animation: false,\n    52\t        parsing: false,\n    53\t        normalized: true,\n    54\t        elements: { point: { radius: 0 } },\n    55\t        interaction: { mode: 'nearest', axis: 'x', intersect: false },\n    56\t        plugins: { decimation: { enabled: true, algorithm: 'min-max' } },\n    57\t        scales: { x: { type: 'time' } },\n    58\t      },\n    59\t      plugins: [benchPlugin(state, newestHeld)],\n    60\t    });\n    61\t    const append = (x, ys) => {\n    62\t      for (let s = 0; s < ys.length; s++) { arrays[s].push({ x, y: ys[s] }); arrays[s].shift(); }\n    63\t      chart.update('none');\n    64\t    };\n    65\t    return handleFor(chart, state, append, held);\n    66\t  },\n    67\t};\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc 'nl -ba bench/src/admission.js; nl -ba bench/src/drawn.js'","aggregated_output":"     1\t// Admission check: compares what a chart reports it shows (adapter.describe()) with what the fixture says it must show.\n     2\t// Pure, runs in Node. A timing is accepted only for a run whose readback passes.\n     3\t//\n     4\t// Two kinds of readback are checked:\n     5\t//   held   what the chart's own state holds: visible ranges, per series the points, first and last x, and the\n     6\t//          number of missing values (required from every adapter);\n     7\t//   drawn  what the chart drew, which can differ from what it holds when the library decimates or simplifies:\n     8\t//            kind 'indices'  the source indices the library selected for drawing, as connected paths (Chart.js\n     9\t//                            after decimation, uPlot's data with its null breaks); index-exact checks;\n    10\t//            kind 'pixels'   the polylines the library actually stroked, captured in an untimed probe run (Axylo:\n    11\t//                            the SVG path data or the Canvas 2D moveTo/lineTo calls), mapped through the plot rectangle\n    12\t//                            and the committed domains; checks at pixel resolution.\n    13\t//          A drawn readback that retains two neighbouring points with a missing source value between them draws\n    14\t//          a line across a gap the data has; one whose extremes are not the data's extremes in the visible window\n    15\t//          lost the spike that a reader would look for. Both are rejected.\n    16\t\n    17\t// Loose enough for axis padding and nice-number rounding, tight enough to catch a pinned or runaway range.\n    18\tconst X_SLACK = 0.1;        // visible x range may exceed the expected x range by 10% of that range on each side\n    19\tconst Y_LOOSENESS = 4;      // visible y span may be at most 4x the larger of the data's y span and its largest |y|\n    20\tconst X_EXACT_MS = 1;       // oldest/newest x must match to the millisecond\n    21\tconst PX_TOLERANCE = 1.5;   // drawn vertex positions: within 1.5 CSS px of where the datum maps\n    22\tconst PX_GAP_MIN = 2;       // a gap narrower than 2 CSS px cannot be told from a pen-up at pixel resolution\n    23\t\n    24\tconst num = v => typeof v === 'number' && Number.isFinite(v);\n    25\t\n    26\t/** Prefix count of missing values: missingBetween(i, j) = number of NaN at indices i..j-1. */\n    27\tfunction missingIndex(col) {\n    28\t  const pre = new Int32Array(col.length + 1);\n    29\t  for (let i = 0; i < col.length; i++) pre[i + 1] = pre[i] + (col[i] !== col[i] ? 1 : 0);\n    30\t  return (i, j) => (j > i ? pre[j] - pre[i] : 0);\n    31\t}\n    32\t\n    33\tfunction finiteBounds(col, i0, i1) {\n    34\t  let first = -1, last = -1;\n    35\t  for (let i = i0; i <= i1; i++) if (col[i] === col[i]) { first = i; break; }\n    36\t  for (let i = i1; i >= i0; i--) if (col[i] === col[i]) { last = i; break; }\n    37\t  return [first, last];\n    38\t}\n    39\t\n    40\t/**\n    41\t * Index readback of one series: `paths` is a list of connected paths; each path is a flat list of inclusive index\n    42\t * ranges [start0, end0, start1, end1, ...] in drawing order. Inside a range every index is drawn and consecutive\n    43\t * indices are joined; between two ranges of one path the chart joins end_k to start_k+1 with one segment.\n    44\t */\n    45\texport function checkDrawnIndices(col, drawn, { window, seriesY, scatter }, label) {\n    46\t  const reasons = [];\n    47\t  const n = col.length;\n    48\t  const missing = missingIndex(col);\n    49\t  if (!Array.isArray(drawn.paths) || drawn.paths.length === 0) return [`${label}: drawn readback has no paths`];\n    50\t  let lo = Infinity, hi = -Infinity, minIdx = Infinity, maxIdx = -Infinity, bridges = 0, atMissing = 0;\n    51\t  const examples = [];\n    52\t  for (const path of drawn.paths) {\n    53\t    if (!Array.isArray(path) || path.length % 2) { reasons.push(`${label}: a drawn path is not a list of index ranges`); continue; }\n    54\t    let prevEnd = -1;\n    55\t    for (let k = 0; k < path.length; k += 2) {\n    56\t      const a = path[k], b = path[k + 1];\n    57\t      if (!Number.isInteger(a) || !Number.isInteger(b) || a < 0 || b >= n || b < a) { reasons.push(`${label}: drawn range [${a}, ${b}] is outside the ${n} held points`); prevEnd = -1; continue; }\n    58\t      if (prevEnd >= 0) {\n    59\t        if (a <= prevEnd) reasons.push(`${label}: drawn ranges out of order (${prevEnd} then ${a})`);\n    60\t        else if (!scatter && missing(prevEnd + 1, a) > 0) { bridges++; if (examples.length < 3) examples.push(`${prevEnd}->${a} across ${missing(prevEnd + 1, a)} missing`); }\n    61\t      }\n    62\t      if (missing(a, b + 1) > 0) atMissing += missing(a, b + 1);\n    63\t      // Extremes only over the visible window: points drawn outside it are clipped.\n    64\t      const from = Math.max(a, window[0]), to = Math.min(b, window[1]);\n    65\t      for (let i = from; i <= to; i++) { const v = col[i]; if (v === v) { if (v < lo) lo = v; if (v > hi) hi = v; } }\n    66\t      if (a < minIdx) minIdx = a;\n    67\t      if (b > maxIdx) maxIdx = b;\n    68\t      prevEnd = b;\n    69\t    }\n    70\t  }\n    71\t  if (bridges) reasons.push(`${label}: ${bridges} drawn segments join retained neighbours across missing source values (${examples.join('; ')}): the drawing bridges gaps the data has`);\n    72\t  if (atMissing) reasons.push(`${label}: ${atMissing} drawn points sit at missing source values`);\n    73\t  const [first, last] = finiteBounds(col, window[0], window[1]);\n    74\t  if (first >= 0) {\n    75\t    if (minIdx > first || maxIdx < last) reasons.push(`${label}: drawn indices [${minIdx}, ${maxIdx}] do not cover the visible data [${first}, ${last}]`);\n    76\t    if (lo !== seriesY[0] || hi !== seriesY[1]) reasons.push(`${label}: drawn extremes [${lo}, ${hi}] are not the data's extremes [${seriesY[0]}, ${seriesY[1]}] in the visible window`);\n    77\t  }\n    78\t  return reasons;\n    79\t}\n    80\t\n    81\t/**\n    82\t * Pixel readback (Axylo): `strokes` are the polylines one stroke operation drew (one SVG path element, or one\n    83\t * beginPath..stroke on the scene canvas), in CSS px of the plot container. The series is the stroke that passes\n    84\t * through the series' first and last visible data points. Its vertex extremes inside the plot must sit where the\n    85\t * data's extremes map, and no segment may run across a missing stretch at least PX_GAP_MIN wide.\n    86\t */\n    87\texport function checkDrawnPixels(x, col, pixels, xDomain, yDomain, { window, seriesY }, label) {\n    88\t  const reasons = [];\n    89\t  const { plot, strokes } = pixels;\n    90\t  if (Array.isArray(strokes) && strokes.length === 0) return [`${label}: the chart drew no line strokes${plot && plot.height < 20 ? ` (its plot area is ${plot.width}×${plot.height} px)` : ''}`];\n    91\t  if (!plot || !num(plot.x) || !num(plot.y) || !(plot.width > 0) || !(plot.height > 0)) return [`${label}: no plot rectangle in the drawn readback`];\n    92\t  if (!Array.isArray(strokes)) return [`${label}: no strokes in the drawn readback`];\n    93\t  const [X0, X1] = xDomain, [Y0, Y1] = yDomain;\n    94\t  const px = v => plot.x + ((v - X0) / (X1 - X0)) * plot.width;\n    95\t  const py = v => plot.y + ((Y1 - v) / (Y1 - Y0)) * plot.height;\n    96\t  const [first, last] = finiteBounds(col, window[0], window[1]);\n    97\t  if (first < 0) return reasons;\n    98\t  const near = (poly, tx, ty) => { for (let i = 0; i + 1 < poly.length; i += 2) if (Math.abs(poly[i] - tx) <= PX_TOLERANCE && Math.abs(poly[i + 1] - ty) <= PX_TOLERANCE) return true; return false; };\n    99\t  const hasNear = (s, tx, ty) => s.polylines.some(p => near(p, tx, ty));\n   100\t  const fx = px(x[first]), fy = py(col[first]), lx = px(x[last]), ly = py(col[last]);\n   101\t  const stroke = strokes.find(s => hasNear(s, fx, fy) && hasNear(s, lx, ly));\n   102\t  if (!stroke) return [`${label}: no drawn stroke passes through the first visible point (${fx.toFixed(1)}, ${fy.toFixed(1)}) px and the last (${lx.toFixed(1)}, ${ly.toFixed(1)}) px`];\n   103\t  let top = Infinity, bottom = -Infinity;\n   104\t  for (const p of stroke.polylines) for (let i = 0; i + 1 < p.length; i += 2) {\n   105\t    if (p[i] < plot.x - 0.5 || p[i] > plot.x + plot.width + 0.5) continue;\n   106\t    if (p[i + 1] < top) top = p[i + 1];\n   107\t    if (p[i + 1] > bottom) bottom = p[i + 1];\n   108\t  }\n   109\t  const wantTop = py(seriesY[1]), wantBottom = py(seriesY[0]);\n   110\t  if (!(Math.abs(top - wantTop) <= PX_TOLERANCE)) reasons.push(`${label}: highest drawn vertex at y=${top.toFixed(1)} px, the data's maximum ${seriesY[1]} maps to ${wantTop.toFixed(1)} px`);\n   111\t  if (!(Math.abs(bottom - wantBottom) <= PX_TOLERANCE)) reasons.push(`${label}: lowest drawn vertex at y=${bottom.toFixed(1)} px, the data's minimum ${seriesY[0]} maps to ${wantBottom.toFixed(1)} px`);\n   112\t  // Gaps wide enough to resolve: a missing stretch between finite neighbours a and b.\n   113\t  const gaps = [];\n   114\t  for (let i = window[0]; i <= window[1]; i++) {\n   115\t    if (col[i] === col[i]) continue;\n   116\t    let j = i; while (j + 1 <= window[1] && col[j + 1] !== col[j + 1]) j++;\n   117\t    const a = i - 1, b = j + 1;\n   118\t    if (a >= 0 && b < col.length && col[a] === col[a] && col[b] === col[b]) { const pa = px(x[a]), pb = px(x[b]); if (pb - pa >= PX_GAP_MIN) gaps.push([pa, pb, a, b]); }\n   119\t    i = j;\n   120\t  }\n   121\t  let bridged = 0;\n   122\t  const examples = [];\n   123\t  for (const [pa, pb, a, b] of gaps) {\n   124\t    let hit = false;\n   125\t    for (const p of stroke.polylines) {\n   126\t      for (let i = 0; i + 3 < p.length; i += 2) {\n   127\t        const sx0 = Math.min(p[i], p[i + 2]), sx1 = Math.max(p[i], p[i + 2]);\n   128\t        if (sx0 <= pa + 0.5 && sx1 >= pb - 0.5) { hit = true; break; }\n   129\t      }\n   130\t      if (hit) break;\n   131\t    }\n   132\t    if (hit) { bridged++; if (examples.length < 3) examples.push(`indices ${a}..${b}, ${(pb - pa).toFixed(1)} px`); }\n   133\t  }\n   134\t  if (bridged) reasons.push(`${label}: ${bridged} of ${gaps.length} resolvable gaps are crossed by one drawn segment (${examples.join('; ')})`);\n   135\t  return reasons;\n   136\t}\n   137\t\n   138\t/**\n   139\t * @param {object} expected  from fixtures.expectedView\n   140\t * @param {object|null} seen from adapter.describe(): { x: [min, max], y: [min, max], renderer?, drawnPixels?,\n   141\t *                           series: [{ points, oldestX, newestX, missing, drawn }] }\n   142\t * @param {object} [opts]    { columns: { x, ys } the held columns (heldColumns), requireDrawn: boolean,\n   143\t *                           expectRenderer: 'canvas' | 'svg' | undefined }\n   144\t * @returns {{ admitted: boolean, reasons: string[], limits: string[] }}\n   145\t */\n   146\texport function checkView(expected, seen, opts = {}) {\n   147\t  const reasons = [], limits = [];\n   148\t  if (!seen) return { admitted: false, reasons: ['describe() returned nothing'], limits };\n   149\t  const [x0, x1] = seen.x ?? [];\n   150\t  const [y0, y1] = seen.y ?? [];\n   151\t  if (!num(x0) || !num(x1)) reasons.push(`visible x range is not two finite numbers: ${JSON.stringify(seen.x)}`);\n   152\t  if (!num(y0) || !num(y1)) reasons.push(`visible y range is not two finite numbers: ${JSON.stringify(seen.y)}`);\n   153\t  if (reasons.length) return { admitted: false, reasons, limits };\n   154\t\n   155\t  if (opts.expectRenderer) {\n   156\t    const kind = seen.renderer?.kind;\n   157\t    if (kind !== opts.expectRenderer) reasons.push(`renderer: the committed chart has ${kind ? `${kind} marks (${seen.renderer.canvases} canvas, ${seen.renderer.svgs} svg)` : 'no renderer readback'}, the adapter was asked for ${opts.expectRenderer}`);\n   158\t  }\n   159\t\n   160\t  const [vx0, vx1] = expected.visibleX ?? [expected.oldestX, expected.newestX];\n   161\t  const xSpan = vx1 - vx0, xSlack = expected.xSlack ?? X_SLACK;\n   162\t  if (x0 > vx0 + X_EXACT_MS || x1 < vx1 - X_EXACT_MS)\n   163\t    reasons.push(`visible x [${x0}, ${x1}] does not contain the expected x range [${vx0}, ${vx1}]`);\n   164\t  if (x0 < vx0 - xSlack * xSpan || x1 > vx1 + xSlack * xSpan)\n   165\t    reasons.push(`visible x [${x0}, ${x1}] is wider than the expected x range plus ${xSlack * 100}% per side`);\n   166\t\n   167\t  if (y0 > expected.yMin || y1 < expected.yMax)\n   168\t    reasons.push(`visible y [${y0}, ${y1}] does not contain the data's y extent [${expected.yMin}, ${expected.yMax}]`);\n   169\t  const scale = Math.max(expected.yMax - expected.yMin, Math.abs(expected.yMin), Math.abs(expected.yMax));\n   170\t  if (y1 - y0 > Y_LOOSENESS * scale)\n   171\t    reasons.push(`visible y span ${y1 - y0} is more than ${Y_LOOSENESS}x the data's scale ${scale}`);\n   172\t  const ex = expected.extreme;\n   173\t  if (!(ex.y >= y0 && ex.y <= y1)) reasons.push(`${ex.injected === false ? 'extreme' : 'injected extreme'} y=${ex.y} at x=${ex.x} is outside visible y [${y0}, ${y1}]`);\n   174\t  if (!(ex.x >= x0 && ex.x <= x1)) reasons.push(`${ex.injected === false ? 'extreme' : 'injected extreme'} x=${ex.x} is outside visible x [${x0}, ${x1}]`);\n   175\t\n   176\t  const ss = seen.series ?? [];\n   177\t  if (ss.length !== expected.series) reasons.push(`chart holds ${ss.length} series, fixture has ${expected.series}`);\n   178\t  ss.slice(0, expected.series).forEach((s, i) => {\n   179\t    if (s.points !== expected.points) reasons.push(`series ${i}: chart holds ${s.points} points, fixture ${expected.points}`);\n   180\t    if (!(Math.abs(s.oldestX - expected.oldestX) <= X_EXACT_MS)) reasons.push(`series ${i}: oldest x ${s.oldestX}, fixture ${expected.oldestX}`);\n   181\t    if (!(Math.abs(s.newestX - expected.newestX) <= X_EXACT_MS)) reasons.push(`series ${i}: newest x ${s.newestX}, fixture ${expected.newestX}`);\n   182\t    if (s.missing === undefined) reasons.push(`series ${i}: no missing-value readback (required from every adapter)`);\n   183\t    else if (s.missing !== expected.missing[i]) reasons.push(`series ${i}: chart holds ${s.missing} missing values, fixture ${expected.missing[i]}`);\n   184\t    // Drawn readback.\n   185\t    const d = s.drawn;\n   186\t    const ctx = { window: expected.window ?? [0, expected.points - 1], seriesY: expected.seriesY?.[i] ?? [expected.yMin, expected.yMax], scatter: expected.scatter };\n   187\t    if (!d) { if (opts.requireDrawn !== false) reasons.push(`series ${i}: no drawn readback`); return; }\n   188\t    if (d.kind === 'not-captured') {\n   189\t      if (opts.requireDrawn) reasons.push(`series ${i}: drawn geometry not captured (${d.reason}) in a run that must capture it`);\n   190\t      else limits.push(`series ${i}: drawn geometry not captured in this run (${d.reason}); it was checked in the untimed probe run`);\n   191\t      return;\n   192\t    }\n   193\t    if (d.kind === 'not-applicable') { limits.push(`series ${i}: drawn geometry not checked: ${d.reason}`); return; }\n   194\t    if (!opts.columns) { limits.push(`series ${i}: drawn readback present but no columns given to check it against`); return; }\n   195\t    const col = opts.columns.ys[i];\n   196\t    if (d.kind === 'indices') for (const r of checkDrawnIndices(col, d, ctx, `series ${i}`)) reasons.push(r);\n   197\t    else if (d.kind === 'pixels') {\n   198\t      if (!seen.drawnPixels) reasons.push(`series ${i}: pixel readback announced but no captured strokes`);\n   199\t      else for (const r of checkDrawnPixels(opts.columns.x, col, seen.drawnPixels, [x0, x1], [y0, y1], ctx, `series ${i}`)) reasons.push(r);\n   200\t    } else reasons.push(`series ${i}: unknown drawn readback kind ${JSON.stringify(d.kind)}`);\n   201\t  });\n   202\t  return { admitted: reasons.length === 0, reasons, limits };\n   203\t}\n   204\t\n   205\t/** Several charts (W-page): every one must pass. */\n   206\texport function checkViews(expectedList, seenList, optsList = []) {\n   207\t  if (!Array.isArray(seenList) || seenList.length !== expectedList.length)\n   208\t    return { admitted: false, reasons: [`expected ${expectedList.length} chart readbacks, got ${Array.isArray(seenList) ? seenList.length : typeof seenList}`], limits: [] };\n   209\t  const reasons = [], limits = [];\n   210\t  expectedList.forEach((e, i) => {\n   211\t    const r = checkView(e, seenList[i], optsList[i] ?? {});\n   212\t    for (const m of r.reasons) reasons.push(`chart ${i}: ${m}`);\n   213\t    for (const m of r.limits) if (!limits.includes(m)) limits.push(m);\n   214\t  });\n   215\t  return { admitted: reasons.length === 0, reasons, limits };\n   216\t}\n     1\t// What a comparison library drew, as index paths into the points it holds (admission.js, kind 'indices'). Pure:\n     2\t// the adapters call these on the library's own state after the measured window, the tests call them in Node.\n     3\t// A path is a flat list of inclusive index ranges [start0, end0, start1, end1, ...]; inside a range consecutive\n     4\t// indices are joined, and the library joins end_k to start_k+1 with one segment.\n     5\t\n     6\t/**\n     7\t * uPlot: its line path builder visits every index in the series' drawn index window (series.idxs) and breaks the\n     8\t * line at null unless spanGaps is set (default false). So the paths are the runs of non-null values inside that\n     9\t * window. This is uPlot's documented gap model, read from its own state; uPlot clips gaps at whole device pixels,\n    10\t * so a gap narrower than a pixel is not visible as a break (a limit this readback does not see; README).\n    11\t */\n    12\texport function uplotDrawnPaths(col, idxs, spanGaps) {\n    13\t  const [i0, i1] = idxs ?? [0, col.length - 1];\n    14\t  const paths = [];\n    15\t  let start = -1;\n    16\t  const close = end => { if (start >= 0) { if (spanGaps && paths.length) paths[paths.length - 1].push(start, end); else paths.push([start, end]); } start = -1; };\n    17\t  for (let i = i0; i <= i1; i++) {\n    18\t    if (col[i] == null || col[i] !== col[i]) close(i - 1);\n    19\t    else if (start < 0) start = i;\n    20\t  }\n    21\t  close(i1);\n    22\t  return paths;\n    23\t}\n    24\t\n    25\t/** First index i with xs[i] >= v. */\n    26\tfunction lowerBound(xs, v) {\n    27\t  let lo = 0, hi = xs.length;\n    28\t  while (lo < hi) { const mid = (lo + hi) >>> 1; if (xs[mid] < v) lo = mid + 1; else hi = mid; }\n    29\t  return lo;\n    30\t}\n    31\t\n    32\t/**\n    33\t * Chart.js: the points the line controller draws, in order (with the decimation plugin active, the decimated copy\n    34\t * in dataset.data; its points are the original {x, y} objects, so each maps back to its held index by x). Chart.js\n    35\t * breaks the line at a point whose y is null or NaN unless spanGaps is set (default false).\n    36\t */\n    37\texport function chartjsDrawnPaths(drawnPoints, heldX, spanGaps) {\n    38\t  const paths = [];\n    39\t  let path = null, rs = -1, re = -1;\n    40\t  const flush = () => { if (rs >= 0) path.push(rs, re); rs = re = -1; };\n    41\t  for (const p of drawnPoints) {\n    42\t    const y = p?.y;\n    43\t    if (y == null || y !== y) { if (!spanGaps) { flush(); if (path?.length) paths.push(path); path = null; } continue; }\n    44\t    const i = lowerBound(heldX, p.x);\n    45\t    if (!path) path = [];\n    46\t    // min-max decimation can emit one point twice (a column's first point is also its minimum): a zero-length\n    47\t    // segment, not a new range.\n    48\t    if (rs >= 0 && i === re) continue;\n    49\t    if (rs >= 0 && i === re + 1) re = i;\n    50\t    else { flush(); rs = re = i; }\n    51\t  }\n    52\t  flush();\n    53\t  if (path?.length) paths.push(path);\n    54\t  return paths;\n    55\t}\n    56\t\n    57\t/**\n    58\t * Theme check of one state: every series mark shows the color the library assigns that series in the current\n    59\t * scheme. `state` = { expected: [color per series], marks: [color per series mark] }, colors already normalized.\n    60\t * Returns null when they agree, else what differs.\n    61\t */\n    62\texport function themeMismatch(state) {\n    63\t  if (state.marks.length !== state.expected.length) return `${state.marks.length} series marks for ${state.expected.length} series`;\n    64\t  const bad = state.marks.map((m, i) => (m !== state.expected[i] ? `series ${i} ${m}, expected ${state.expected[i]}` : null)).filter(Boolean);\n    65\t  return bad.length ? bad.join('; ') : null;\n    66\t}\n","exit_code":0,"status":"completed"}}
