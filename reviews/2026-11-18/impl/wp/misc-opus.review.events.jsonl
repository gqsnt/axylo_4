{"type":"item.completed","item":{"id":"item_61","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/test/theme/palette.test.ts | sed -n '1,306p'\"","aggregated_output":"     1\t/**\n     2\t * The default palette (spec A5, L2; decision 0003). Constraints 1–6 of the decision, measured here with code\n     3\t * of this file's own (WCAG 2 contrast; OKLab; Machado et al. 2009 color-vision simulation at severity 1.0 in\n     4\t * linear RGB, clamped, as research/harness/palette.mjs scored the ten libraries), each in two forms: analytic, on\n     5\t * unrounded values, and quantised, on the bytes an 8-bit image holds (simulated colors rounded to bytes; fills\n     6\t * through an 8-bit raster model, at the worst case within one byte per channel, and as Chrome drew them).\n     7\t * Then the record the research scorer wrote (research/palette/palette.json) is compared field by field at the\n     8\t * precision it was written in, and its browser-measured parts (strokes, Chrome fill pixels) are validated against\n     9\t * the shipped colors.\n    10\t */\n    11\timport { describe, expect, it } from 'vitest';\n    12\timport fs from 'node:fs';\n    13\timport path from 'node:path';\n    14\timport { contrastRatio, parseColor, type Rgba } from '../../src/theme/color';\n    15\timport { DARK, LIGHT } from '../../src/theme/palette';\n    16\timport { AXYLO_CSS } from '../../src/theme/css';\n    17\t\n    18\ttype Vec3 = readonly [number, number, number];\n    19\ttype Vision = 'normal' | 'protan' | 'deutan' | 'tritan';\n    20\t\n    21\tconst c = (s: string): Rgba => parseColor(s)!;\n    22\tconst lin = (v: number): number => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);\n    23\tconst enc = (v: number): number => (v <= 0.0031308 ? 12.92 * v : 1.055 * v ** (1 / 2.4) - 0.055);\n    24\tconst clamp01 = (v: number): number => Math.min(1, Math.max(0, v));\n    25\tconst srgb = (hex: string): Vec3 => { const p = c(hex); return [p.r, p.g, p.b]; };\n    26\tconst bytesOf = (hex: string): Vec3 => srgb(hex).map(v => Math.round(v * 255)) as unknown as Vec3;\n    27\tconst vec = (f: (i: 0 | 1 | 2) => number): Vec3 => [f(0), f(1), f(2)];\n    28\t\n    29\tfunction oklab([r, g, b]: Vec3): Vec3 {\n    30\t  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);\n    31\t  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);\n    32\t  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);\n    33\t  return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,\n    34\t    1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,\n    35\t    0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];\n    36\t}\n    37\t\n    38\tconst MACHADO: Record<Vision, readonly Vec3[]> = {\n    39\t  normal: [[1, 0, 0], [0, 1, 0], [0, 0, 1]],\n    40\t  protan: [[0.152286, 1.052583, -0.204868], [0.114503, 0.786281, 0.099216], [-0.003882, -0.048116, 1.051998]],\n    41\t  deutan: [[0.367322, 0.860646, -0.227968], [0.280085, 0.672501, 0.047413], [-0.011820, 0.042940, 0.968881]],\n    42\t  tritan: [[1.255528, -0.076749, -0.178779], [-0.078411, 0.930809, 0.147602], [0.004733, 0.691367, 0.303900]],\n    43\t};\n    44\tconst VISIONS = Object.keys(MACHADO) as Vision[];\n    45\t\n    46\t/** Linear RGB of a gamma-encoded sRGB color as seen with `vision`, clamped. */\n    47\tconst simulated = (rgb: Vec3, vision: Vision): Vec3 => {\n    48\t  const l = vec(i => lin(rgb[i]));\n    49\t  return vec(i => clamp01(MACHADO[vision][i]![0] * l[0] + MACHADO[vision][i]![1] * l[1] + MACHADO[vision][i]![2] * l[2]));\n    50\t};\n    51\t/** OKLab of a color as seen with `vision`, unrounded. */\n    52\tconst seen = (rgb: Vec3, vision: Vision): Vec3 => oklab(simulated(rgb, vision));\n    53\t/** OKLab of a byte color. */\n    54\tconst labOfBytes = (b: Vec3): Vec3 => oklab(vec(i => lin(b[i] / 255)));\n    55\t/** OKLab of the simulated color after encoding and rounding to bytes, as a simulated 8-bit image holds it. */\n    56\tconst seenBytes = (hex: string, vision: Vision): Vec3 => labOfBytes(vec(i => Math.round(255 * enc(simulated(srgb(hex), vision)[i]))));\n    57\tconst delta = (p: Vec3, q: Vec3): number => Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]);\n    58\tconst oklch = (hex: string): Vec3 => { const [L, a, b] = seen(srgb(hex), 'normal'); return [L, Math.hypot(a, b), (Math.atan2(b, a) * 180 / Math.PI + 360) % 360]; };\n    59\tconst hueDifference = (a: number, b: number): number => { const d = Math.abs(a - b) % 360; return d > 180 ? 360 - d : d; };\n    60\t/** Source-over at `alpha` in gamma-encoded sRGB, as the browser composites a translucent fill, unrounded. */\n    61\tconst over = (hex: string, alpha: number, bg: string): Vec3 => { const f = srgb(hex), b = srgb(bg); return vec(i => f[i] * alpha + b[i] * (1 - alpha)); };\n    62\t/** The same fill on an 8-bit raster: alpha quantised to round(alpha × 255) (or floor, as another rasterizer did), channels rounded. */\n    63\tconst raster = (hex: string, alpha: number, bg: string, quantise: (x: number) => number = Math.round): Vec3 => {\n    64\t  const k = quantise(alpha * 255), f = bytesOf(hex), b = bytesOf(bg);\n    65\t  return vec(i => Math.round((f[i] * k + b[i] * (255 - k)) / 255));\n    66\t};\n    67\t/** Smallest difference between any byte colors within one byte per channel of `a` and of `b`. */\n    68\tfunction worstWithinOneByte(a: Vec3, b: Vec3): number {\n    69\t  const box = (p: Vec3): Vec3[] => {\n    70\t    const out: Vec3[] = [];\n    71\t    for (const i of [-1, 0, 1]) for (const j of [-1, 0, 1]) for (const k of [-1, 0, 1]) out.push(labOfBytes(vec(n => Math.min(255, Math.max(0, p[n] + [i, j, k][n]!)))));\n    72\t    return out;\n    73\t  };\n    74\t  const pa = box(a), pb = box(b);\n    75\t  let m = Infinity;\n    76\t  for (const p of pa) for (const q of pb) m = Math.min(m, delta(p, q));\n    77\t  return m;\n    78\t}\n    79\tconst hexBytes = (hex: string): Vec3 => bytesOf(hex);\n    80\t\n    81\t/** Smallest pairwise difference among `colors` under `vision`, with the slots (1-based) of the pair. */\n    82\tfunction closest(colors: readonly string[], vision: Vision, labOf: (hex: string, v: Vision) => Vec3 = (h, v) => seen(srgb(h), v)): { d: number; pair: [number, number] } {\n    83\t  const labs = colors.map(h => labOf(h, vision));\n    84\t  let d = Infinity, pair: [number, number] = [0, 0];\n    85\t  for (let i = 0; i < labs.length; i++) for (let j = i + 1; j < labs.length; j++) {\n    86\t    const x = delta(labs[i]!, labs[j]!);\n    87\t    if (x < d) { d = x; pair = [i + 1, j + 1]; }\n    88\t  }\n    89\t  return { d, pair };\n    90\t}\n    91\t\n    92\t/** Equal at the precision the record was written in (rounded to `digits` decimals). */\n    93\tconst atPrecision = (measured: number, recorded: number, digits: number): boolean => Math.abs(measured - recorded) <= 0.5 * 10 ** -digits + 1e-9;\n    94\t\n    95\tinterface PairRecord { min: number; pair: number[] }\n    96\tinterface StrokeStats { core: { p10: number; median: number }; weighted: { p10: number; median: number } }\n    97\tinterface RecordScheme {\n    98\t  background: string;\n    99\t  series: { slot: number; hex: string; oklch: number[]; contrast: number; hueDiffToOtherScheme: number }[];\n   100\t  minDelta: Record<Vision, PairRecord>;\n   101\t  prefixes: Record<string, Record<Vision, PairRecord>>;\n   102\t  minDeltaBytes: Record<Vision, PairRecord>;\n   103\t  prefixesBytes: Record<string, Record<Vision, PairRecord>>;\n   104\t  tokenDistance: Record<string, { min: number; slot: number }>;\n   105\t  composites: Record<string, Record<Vision, { minNeighbour: number; pair: number[]; neighbours: number[] }>>;\n   106\t  raster: Record<string, { model: string[]; modelFloor: string[]; neighboursModel: number[]; neighboursWorstWithinOneByte: number[] }>;\n   107\t  chromeRaster: Record<string, Record<string, { pixels: string[]; neighbours: number[]; min: number }>>;\n   108\t}\n   109\tinterface StrokeRecord { schemes: Record<'light' | 'dark', { background: string; rows: ({ color: string; swatch: number } & Record<string, StrokeStats | string | number>)[] }> }\n   110\tconst record = JSON.parse(fs.readFileSync(path.resolve(import.meta.dirname, '../../../../research/palette/palette.json'), 'utf8')) as\n   111\t  { schemes: Record<'light' | 'dark', RecordScheme>; strokes: StrokeRecord; refused: string[] };\n   112\t\n   113\tconst SCHEMES = [['light', LIGHT, DARK], ['dark', DARK, LIGHT]] as const;\n   114\tconst ALPHAS = [0.25, 0.8] as const;\n   115\t\n   116\tdescribe('scoring code used below', () => {\n   117\t  it('reproduces known OKLab values and leaves grays alone under every simulation', () => {\n   118\t    const white = seen([1, 1, 1], 'normal');\n   119\t    expect(white[0]).toBeCloseTo(1, 4);\n   120\t    expect(Math.hypot(white[1], white[2])).toBeLessThan(1e-4);\n   121\t    // Ottosson's reference value for sRGB red.\n   122\t    const red = seen([1, 0, 0], 'normal');\n   123\t    expect(red[0]).toBeCloseTo(0.6279554, 4);\n   124\t    expect(red[1]).toBeCloseTo(0.2248631, 4);\n   125\t    expect(red[2]).toBeCloseTo(0.1258463, 4);\n   126\t    for (const v of VISIONS) {\n   127\t      expect(delta(seen(srgb('#777777'), v), seen(srgb('#777777'), 'normal')), v).toBeLessThan(0.002);\n   128\t      // A gray survives simulation and byte rounding within one byte.\n   129\t      expect(delta(seenBytes('#777777', v), labOfBytes(hexBytes('#777777'))), v).toBeLessThan(0.004);\n   130\t    }\n   131\t    // Deuteranopia collapses red and green toward the same hue: the classic confusion pair gets much closer.\n   132\t    expect(delta(seen(srgb('#d62728'), 'deutan'), seen(srgb('#2ca02c'), 'deutan'))).toBeLessThan(0.5 * delta(seen(srgb('#d62728'), 'normal'), seen(srgb('#2ca02c'), 'normal')));\n   133\t  });\n   134\t\n   135\t  it('models an 8-bit fill within one byte of the pixels two rasterizers produced', () => {\n   136\t    // A CPU Skia raster of the review of 51e1be5 drew #5f2083 and #ba5f50 at 25% over white as #d7c8e0 and #eed7d4.\n   137\t    for (const [color, drawn] of [['#5f2083', '#d7c8e0'], ['#ba5f50', '#eed7d4']] as const) {\n   138\t      const m = raster(color, 0.25, '#ffffff'), d = hexBytes(drawn);\n   139\t      for (const i of [0, 1, 2] as const) expect(Math.abs(m[i] - d[i]), `${color} channel ${i}`).toBeLessThanOrEqual(1);\n   140\t    }\n   141\t    expect(worstWithinOneByte([10, 20, 30], [10, 20, 30])).toBe(0);\n   142\t    expect(worstWithinOneByte([10, 20, 30], [10, 20, 33])).toBeGreaterThan(0);\n   143\t  });\n   144\t});\n   145\t\n   146\tdescribe('default palette (spec A5, decision 0003)', () => {\n   147\t  for (const [name, scheme, other] of SCHEMES) {\n   148\t    const series = scheme.series;\n   149\t    const r = record.schemes[name];\n   150\t\n   151\t    it(`${name}: eight distinct series colors`, () => {\n   152\t      expect(series).toHaveLength(8);\n   153\t      expect(new Set(series).size).toBe(8);\n   154\t      for (const color of series) expect(color).toMatch(/^#[0-9a-f]{6}$/);\n   155\t    });\n   156\t\n   157\t    it(`${name}: 1. every series color reaches 3:1 on the default background`, () => {\n   158\t      const bg = c(scheme.background);\n   159\t      for (const color of series) expect(contrastRatio(c(color), bg), color).toBeGreaterThanOrEqual(3);\n   160\t    });\n   161\t\n   162\t    it(`${name}: 2. the eight are at least 0.10 apart in OKLab under normal vision and simulated protanopia, deuteranopia, tritanopia`, () => {\n   163\t      for (const v of VISIONS) {\n   164\t        const { d, pair } = closest(series, v);\n   165\t        expect(d, `${v}: slots ${pair.join(' and ')}`).toBeGreaterThanOrEqual(0.10);\n   166\t      }\n   167\t    });\n   168\t\n   169\t    it(`${name}: 2. the same after the simulated colors are rounded to bytes`, () => {\n   170\t      for (const v of VISIONS) {\n   171\t        const { d, pair } = closest(series, v, seenBytes);\n   172\t        expect(d, `${v}: slots ${pair.join(' and ')}`).toBeGreaterThanOrEqual(0.10);\n   173\t      }\n   174\t    });\n   175\t\n   176\t    it(`${name}: 3. the first three, four, five and six are at least 0.10 apart, the first four at least 0.14 (analytic and in bytes)`, () => {\n   177\t      for (const n of [3, 4, 5, 6]) for (const v of VISIONS) for (const labOf of [undefined, seenBytes]) {\n   178\t        const { d, pair } = closest(series.slice(0, n), v, labOf);\n   179\t        expect(d, `first ${n}, ${v}${labOf ? ', bytes' : ''}: slots ${pair.join(' and ')}`).toBeGreaterThanOrEqual(n === 4 ? 0.14 : 0.10);\n   180\t      }\n   181\t    });\n   182\t\n   183\t    it(`${name}: 4. slot k is the same hue family in both schemes (OKLCH hue within 30°)`, () => {\n   184\t      series.forEach((color, k) => {\n   185\t        expect(hueDifference(oklch(color)[2], oklch(other.series[k]!)[2]), `slot ${k + 1}: ${color} / ${other.series[k]}`).toBeLessThanOrEqual(30);\n   186\t      });\n   187\t    });\n   188\t\n   189\t    it(`${name}: 5. no series color is within 0.10 of the focus or reference token (nor muted, the donut's \"Other\" slice)`, () => {\n   190\t      for (const token of ['focus', 'reference', 'muted'] as const) {\n   191\t        const t = seen(srgb(scheme[token]), 'normal');\n   192\t        for (const color of series) expect(delta(seen(srgb(color), 'normal'), t), `${color} vs ${token} ${scheme[token]}`).toBeGreaterThanOrEqual(0.10);\n   193\t      }\n   194\t    });\n   195\t\n   196\t    it(`${name}: 6. neighbours k and k+1 stay 0.06 apart as fills at 25% and 80% over the background`, () => {\n   197\t      for (const alpha of ALPHAS) {\n   198\t        const labs = series.map(color => seen(over(color, alpha, scheme.background), 'normal'));\n   199\t        for (let k = 0; k + 1 < labs.length; k++) {\n   200\t          expect(delta(labs[k]!, labs[k + 1]!), `${alpha * 100}%: slots ${k + 1} and ${k + 2}`).toBeGreaterThanOrEqual(0.06);\n   201\t        }\n   202\t      }\n   203\t    });\n   204\t\n   205\t    it(`${name}: 6. the same on an 8-bit raster, with alpha quantised by rounding and by flooring`, () => {\n   206\t      for (const alpha of ALPHAS) for (const quantise of [Math.round, Math.floor]) {\n   207\t        const px = series.map(color => raster(color, alpha, scheme.background, quantise));\n   208\t        for (let k = 0; k + 1 < px.length; k++) {\n   209\t          expect(delta(labOfBytes(px[k]!), labOfBytes(px[k + 1]!)), `${alpha * 100}%, ${quantise.name}: slots ${k + 1} and ${k + 2}`).toBeGreaterThanOrEqual(0.06);\n   210\t        }\n   211\t      }\n   212\t    });\n   213\t\n   214\t    it(`${name}: 6. the same on the pixels Chrome drew (research/palette/raster.json, canvas and SVG)`, () => {\n   215\t      expect(record.refused).toEqual([]);\n   216\t      expect(Object.keys(r.chromeRaster).sort()).toEqual(['canvas', 'svg']);\n   217\t      for (const [via, byAlpha] of Object.entries(r.chromeRaster)) {\n   218\t        expect(Object.keys(byAlpha).map(Number).sort()).toEqual([...ALPHAS]);\n   219\t        for (const alpha of ALPHAS) {\n   220\t          const drawn = byAlpha[String(alpha)]!.pixels;\n   221\t          expect(drawn).toHaveLength(8);\n   222\t          drawn.forEach((hex, k) => {\n   223\t            // The recorded pixel is a fill of this slot's color: within one byte of the model.\n   224\t            const m = raster(series[k]!, alpha, scheme.background), d = hexBytes(hex);\n   225\t            for (const i of [0, 1, 2] as const) expect(Math.abs(m[i] - d[i]), `${via} ${alpha} slot ${k + 1}`).toBeLessThanOrEqual(1);\n   226\t          });\n   227\t          for (let k = 0; k + 1 < drawn.length; k++) {\n   228\t            expect(delta(labOfBytes(hexBytes(drawn[k]!)), labOfBytes(hexBytes(drawn[k + 1]!))), `${via} ${alpha * 100}%: slots ${k + 1} and ${k + 2}`).toBeGreaterThanOrEqual(0.06);\n   229\t          }\n   230\t        }\n   231\t      }\n   232\t    });\n   233\t\n   234\t    it(`${name}: the research record holds these colors and every measured field at its written precision`, () => {\n   235\t      expect(r.background).toBe(scheme.background);\n   236\t      expect(r.series.map(s => s.hex)).toEqual([...series]);\n   237\t      series.forEach((color, k) => {\n   238\t        const s = r.series[k]!, [L, C, h] = oklch(color);\n   239\t        expect(s.slot).toBe(k + 1);\n   240\t        expect(atPrecision(L, s.oklch[0]!, 3) && atPrecision(C, s.oklch[1]!, 3) && atPrecision(h, s.oklch[2]!, 1), `${color} OKLCH ${s.oklch.join(' ')}`).toBe(true);\n   241\t        expect(atPrecision(contrastRatio(c(color), c(scheme.background)), s.contrast, 2), `${color} contrast ${s.contrast}`).toBe(true);\n   242\t        expect(atPrecision(hueDifference(h, oklch(other.series[k]!)[2]), s.hueDiffToOtherScheme, 1), `slot ${k + 1} hue shift`).toBe(true);\n   243\t      });\n   244\t      const pairs = (measured: { d: number; pair: number[] }, rec: PairRecord, label: string): void => {\n   245\t        expect(atPrecision(measured.d, rec.min, 3), `${label}: ${measured.d} vs ${rec.min}`).toBe(true);\n   246\t        expect(rec.pair, label).toEqual(measured.pair);\n   247\t      };\n   248\t      for (const v of VISIONS) {\n   249\t        pairs(closest(series, v), r.minDelta[v], `all 8, ${v}`);\n   250\t        pairs(closest(series, v, seenBytes), r.minDeltaBytes[v], `all 8, ${v}, bytes`);\n   251\t        for (const n of [3, 4, 5, 6]) {\n   252\t          pairs(closest(series.slice(0, n), v), r.prefixes[n]![v], `first ${n}, ${v}`);\n   253\t          pairs(closest(series.slice(0, n), v, seenBytes), r.prefixesBytes[n]![v], `first ${n}, ${v}, bytes`);\n   254\t        }\n   255\t      }\n   256\t      for (const token of ['focus', 'reference', 'muted'] as const) {\n   257\t        const t = seen(srgb(scheme[token]), 'normal'), ds = series.map(color => delta(seen(srgb(color), 'normal'), t));\n   258\t        const min = Math.min(...ds);\n   259\t        expect(atPrecision(min, r.tokenDistance[token]!.min, 3), token).toBe(true);\n   260\t        expect(r.tokenDistance[token]!.slot, token).toBe(ds.indexOf(min) + 1);\n   261\t      }\n   262\t      for (const alpha of ALPHAS) {\n   263\t        const key = String(alpha);\n   264\t        const labs = series.map(color => seen(over(color, alpha, scheme.background), 'normal'));\n   265\t        const nb = labs.slice(1).map((l, k) => delta(labs[k]!, l));\n   266\t        const rec = r.composites[key]!.normal;\n   267\t        nb.forEach((d, k) => expect(atPrecision(d, rec.neighbours[k]!, 3), `${alpha} neighbours ${k + 1}`).toBe(true));\n   268\t        expect(atPrecision(Math.min(...nb), rec.minNeighbour, 3)).toBe(true);\n   269\t        expect(rec.pair).toEqual([nb.indexOf(Math.min(...nb)) + 1, nb.indexOf(Math.min(...nb)) + 2]);\n   270\t        const px = series.map(color => raster(color, alpha, scheme.background));\n   271\t        const hex = (p: Vec3): string => '#' + p.map(v => v.toString(16).padStart(2, '0')).join('');\n   272\t        expect(r.raster[key]!.model).toEqual(px.map(hex));\n   273\t        expect(r.raster[key]!.modelFloor).toEqual(series.map(color => hex(raster(color, alpha, scheme.background, Math.floor))));\n   274\t        px.slice(1).forEach((p, k) => {\n   275\t          expect(atPrecision(delta(labOfBytes(px[k]!), labOfBytes(p)), r.raster[key]!.neighboursModel[k]!, 3), `${alpha} model ${k + 1}`).toBe(true);\n   276\t          expect(atPrecision(worstWithinOneByte(px[k]!, p), r.raster[key]!.neighboursWorstWithinOneByte[k]!, 3), `${alpha} worst ${k + 1}`).toBe(true);\n   277\t        });\n   278\t        for (const via of ['canvas', 'svg']) {\n   279\t          const x = r.chromeRaster[via]![key]!;\n   280\t          const d = x.pixels.slice(1).map((p, k) => delta(labOfBytes(hexBytes(x.pixels[k]!)), labOfBytes(hexBytes(p))));\n   281\t          d.forEach((v, k) => expect(atPrecision(v, x.neighbours[k]!, 3), `${via} ${alpha} ${k + 1}`).toBe(true));\n   282\t          expect(atPrecision(Math.min(...d), x.min, 3)).toBe(true);\n   283\t        }\n   284\t      }\n   285\t    });\n   286\t\n   287\t    it(`${name}: the 2 px stroke record describes these colors and is internally consistent`, () => {\n   288\t      const s = record.strokes.schemes[name];\n   289\t      expect(s.background).toBe(scheme.background);\n   290\t      expect(s.rows.map(row => row.color)).toEqual([...series]);\n   291\t      for (const row of s.rows) {\n   292\t        expect(atPrecision(contrastRatio(c(row.color), c(scheme.background)), row.swatch, 2), `${row.color} swatch`).toBe(true);\n   293\t        for (const key of ['canvas@1', 'svg@1', 'canvas@2', 'svg@2']) {\n   294\t          const st = row[key] as StrokeStats;\n   295\t          // Antialiasing only moves a pixel toward the background, so no statistic can exceed the swatch.\n   296\t          expect(st.core.p10, `${row.color} ${key}`).toBeLessThanOrEqual(st.core.median);\n   297\t          expect(st.core.median).toBeLessThanOrEqual(row.swatch + 0.005);\n   298\t          expect(st.weighted.p10).toBeLessThanOrEqual(st.weighted.median);\n   299\t          expect(st.weighted.median).toBeLessThanOrEqual(st.core.median + 0.005);\n   300\t          expect(st.weighted.p10).toBeGreaterThan(1);\n   301\t        }\n   302\t      }\n   303\t    });\n   304\t\n   305\t    it(`${name}: token colors meet spec L2 (axis and focus 3:1; muted and reference 4.5:1, they label text)`, () => {\n   306\t      const bg = c(scheme.background);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"nl -ba research/palette/explore.mjs; nl -ba research/palette/preview.mjs | sed -n '1,200p'; ls research/harness/node_modules/d3-scale-chromatic\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_62","type":"command_execution","command":"/bin/bash -lc \"nl -ba research/palette/explore.mjs; nl -ba research/palette/preview.mjs | sed -n '1,200p'; ls research/harness/node_modules/d3-scale-chromatic\"","aggregated_output":"     1\t// Which hue families, and which orders of them, can meet the hard constraints of decision 0003 at all?\n     2\t// Uses the grid and branch-and-bound search of fit.mjs on the light scheme, which is the tighter one.\n     3\t//\n     4\t//   node research/palette/explore.mjs sets [--part=0 --parts=1]\n     5\t//       Every set of eight families (blue plus seven of POOL) that has an orange, a purple, a green or teal and a\n     6\t//       red, pink or magenta: can the eight be placed at least 0.10 apart under all four visions, with 3:1 on white\n     7\t//       and clear of the tokens? (No order yet: no prefix or neighbour constraints.)\n     8\t//   node research/palette/explore.mjs orders --set=blue,orange,... [--part=0 --parts=1 --seconds=1]\n     9\t//       Every order of a set with blue first. Orders whose first four are proved unable to reach 0.14 are pruned\n    10\t//       (a timed-out first-four check prunes nothing); the others get the full search (prefixes and neighbour\n    11\t//       fills included) with a time limit.\n    12\t//\n    13\t// Prints one line per set or order, with one of three outcomes: OK with the cost and colors of the cheapest\n    14\t// palette found, \"no\" when the search proved that none exists on the grid, \"??\" when it ran out of time without\n    15\t// either. A summary of the three counts goes to stderr.\n    16\timport { candidates, compatible, search, SCHEME_TOKENS } from './fit.mjs';\n    17\timport { THRESHOLDS as T, dist } from './color.mjs';\n    18\t\n    19\tconst args = Object.fromEntries(process.argv.slice(3).map(a => a.replace(/^--/, '').split('=')).map(([k, v]) => [k, v ?? 'true']));\n    20\tconst mode = process.argv[2], part = +(args.part ?? 0), parts = +(args.parts ?? 1);\n    21\tconst tokens = SCHEME_TOKENS.light, LW = [0.38, 0.70];\n    22\t\n    23\t// Target and box per family, light scheme. Targets are where a designer would put the color if nothing else\n    24\t// mattered; the boxes are wide so that the search, not the target, decides what is possible.\n    25\texport const POOL = {\n    26\t  blue: { target: [0.63, 0.14, 252], L: [0.58, 0.70], C: [0.10, 0.17], hr: 10 },\n    27\t  orange: { target: [0.64, 0.15, 52], L: LW, C: [0.10, 0.18], hr: 10 },\n    28\t  green: { target: [0.50, 0.12, 145], L: LW, C: [0.08, 0.16], hr: 14 },\n    29\t  teal: { target: [0.55, 0.10, 185], L: LW, C: [0.07, 0.14], hr: 15 },\n    30\t  cyan: { target: [0.60, 0.11, 222], L: LW, C: [0.07, 0.15], hr: 12 },\n    31\t  red: { target: [0.55, 0.15, 25], L: LW, C: [0.10, 0.18], hr: 10 },\n    32\t  pink: { target: [0.60, 0.14, 0], L: LW, C: [0.09, 0.17], hr: 10 },\n    33\t  magenta: { target: [0.50, 0.15, 335], L: LW, C: [0.10, 0.18], hr: 12 },\n    34\t  purple: { target: [0.52, 0.15, 300], L: LW, C: [0.10, 0.18], hr: 12 },\n    35\t  gold: { target: [0.62, 0.12, 82], L: LW, C: [0.07, 0.15], hr: 12 },\n    36\t  brown: { target: [0.48, 0.09, 58], L: LW, C: [0.05, 0.12], hr: 14 },\n    37\t  slate: { target: [0.60, 0.03, 255], L: LW, C: [0.0, 0.045], hr: 35, neutral: true },\n    38\t};\n    39\tconst domain = name => candidates(0, { ...POOL[name], step: [0.01, 0.01, 3] }, tokens, null);\n    40\t// At least `limit` apart under all four visions, analytically and after rounding the simulation to bytes.\n    41\tconst apart = (a, b, limit) => { for (let v = 0; v < 4; v++) if (dist(a.labs[v], b.labs[v]) < limit || dist(a.labsBytes[v], b.labsBytes[v]) < limit) return false; return true; };\n    42\tconst line = (r, names) => console.log(r.best ? 'OK ' : (r.complete ? 'no ' : '?? '), r.best ? r.cost.toFixed(2).padStart(6) : '     -', names.join(','), r.best ? r.best.map(x => x.hex).join(' ') : '', r.best && !r.complete ? '(best within time limit)' : '');\n    43\t\n    44\tif (mode === 'sets') {\n    45\t  const doms = Object.fromEntries(Object.keys(POOL).map(k => [k, domain(k)]));\n    46\t  const uniform = (i, a, j, b) => apart(a, b, T.minDelta);\n    47\t  const others = Object.keys(POOL).filter(k => k !== 'blue'), combos = [];\n    48\t  const pick = (start, acc) => { if (acc.length === 7) { combos.push(acc.slice()); return; } for (let i = start; i < others.length; i++) { acc.push(others[i]); pick(i + 1, acc); acc.pop(); } };\n    49\t  pick(0, []);\n    50\t  const required = c => c.includes('orange') && c.includes('purple') && (c.includes('green') || c.includes('teal')) && (c.includes('red') || c.includes('pink') || c.includes('magenta'));\n    51\t  combos.filter(required).forEach((c, i) => {\n    52\t    if (i % parts !== part) return;\n    53\t    const fams = ['blue', ...c];\n    54\t    line(search(fams.map(f => doms[f]), +(args.seconds ?? 3), uniform), fams);\n    55\t  });\n    56\t} else if (mode === 'orders') {\n    57\t  const fams = args.set.split(','), doms = Object.fromEntries(fams.map(k => [k, domain(k)]));\n    58\t  const four = (i, a, j, b) => apart(a, b, T.prefix4);\n    59\t  // First-four outcome per set of four families: 'feasible', 'infeasible' (search completed without a palette) or\n    60\t  // 'unknown' (timed out without one). Only a completed proof prunes the orders that start with that set.\n    61\t  const firstFour = new Map(), perms = [], counts = { OK: 0, no: 0, '??': 0, pruned: 0 };\n    62\t  const permute = (a, k = 0) => { if (k === a.length) { perms.push(a.slice()); return; } for (let i = k; i < a.length; i++) { [a[k], a[i]] = [a[i], a[k]]; permute(a, k + 1); [a[k], a[i]] = [a[i], a[k]]; } };\n    63\t  permute(fams.slice(1));\n    64\t  for (let p = part; p < perms.length; p += parts) {\n    65\t    const order = [fams[0], ...perms[p]], key = order.slice(0, 4).sort().join();\n    66\t    if (!firstFour.has(key)) {\n    67\t      const r = search(order.slice(0, 4).map(f => doms[f]), +(args.fourSeconds ?? 2), four);\n    68\t      firstFour.set(key, r.best ? 'feasible' : r.complete ? 'infeasible' : 'unknown');\n    69\t    }\n    70\t    if (firstFour.get(key) === 'infeasible') { counts.no++; counts.pruned++; console.log('no      -', order.join(','), '(first four proved infeasible)'); continue; }\n    71\t    const r = search(order.map(f => doms[f]), +(args.seconds ?? 1), compatible);\n    72\t    counts[r.best ? 'OK' : r.complete ? 'no' : '??']++;\n    73\t    line(r, order);\n    74\t  }\n    75\t  const by = o => [...firstFour].filter(([, v]) => v === o).map(([k]) => k).join(' | ') || '(none)';\n    76\t  console.error(`orders: ${counts.OK} feasible, ${counts.no} proved infeasible (${counts.pruned} by their first four), ${counts['??']} timed out`);\n    77\t  console.error(`first four feasible: ${by('feasible')}`);\n    78\t  console.error(`first four proved infeasible: ${by('infeasible')}`);\n    79\t  console.error(`first four timed out: ${by('unknown')}`);\n    80\t} else {\n    81\t  console.error('usage: explore.mjs sets | orders --set=a,b,...');\n    82\t  process.exitCode = 2;\n    83\t}\n     1\t// Standalone preview of a light and a dark categorical palette: swatches with hex, contrast and nearest\n     2\t// neighbour, then mock charts (lines with 3, 5 and 8 series at 2 px, overlapping areas at 25%, stacked areas at\n     3\t// 80%, a donut with 1 px separators, grouped bars) under normal vision, simulated protanopia, deuteranopia,\n     4\t// tritanopia (Machado 2009, severity 1.0, as SVG color matrices in linear RGB) and grayscale (WCAG luminance).\n     5\t// No library build needed. Writes the HTML and, with --shot, a PNG per scheme via playwright-core and system Chrome.\n     6\t//\n     7\t//   node research/palette/preview.mjs [--palette=file.json] [--out=dir] [--name=preview] [--shot]\n     8\t//\n     9\t// The palette file is { light: [8 hex], dark: [8 hex] } (a solver candidate works); without one, the colors are\n    10\t// read from packages/axylo/src/theme/palette.ts.\n    11\timport fs from 'node:fs';\n    12\timport path from 'node:path';\n    13\timport { fileURLToPath } from 'node:url';\n    14\timport { CVD, VISIONS, contrast, labUnder, dist } from './color.mjs';\n    15\timport { readThemeFile } from './theme-file.mjs';\n    16\t\n    17\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    18\tconst args = Object.fromEntries(process.argv.slice(2).map(a => a.replace(/^--/, '').split('=')).map(([k, v]) => [k, v ?? 'true']));\n    19\t\n    20\tconst theme = readThemeFile();\n    21\tlet palette = { light: theme.light.series, dark: theme.dark.series };\n    22\tif (args.palette) { const p = JSON.parse(fs.readFileSync(args.palette, 'utf8')); palette = { light: p.light, dark: p.dark }; }\n    23\tconst outDir = path.resolve(args.out ?? here), name = args.name ?? 'preview';\n    24\t\n    25\tfunction stats(scheme) {\n    26\t  const t = theme[scheme], cols = palette[scheme];\n    27\t  return cols.map((c, i) => {\n    28\t    const near = Object.fromEntries(VISIONS.map(v => {\n    29\t      let m = Infinity, k = -1;\n    30\t      cols.forEach((o, j) => { if (j !== i) { const d = dist(labUnder(c, v), labUnder(o, v)); if (d < m) { m = d; k = j; } } });\n    31\t      return [v, { d: m, k }];\n    32\t    }));\n    33\t    return { hex: c, contrast: contrast(c, t.background), near };\n    34\t  });\n    35\t}\n    36\t\n    37\tfunction filterDefs() {\n    38\t  const row = M => `${M[0][0]} ${M[0][1]} ${M[0][2]} 0 0  ${M[1][0]} ${M[1][1]} ${M[1][2]} 0 0  ${M[2][0]} ${M[2][1]} ${M[2][2]} 0 0  0 0 0 1 0`;\n    39\t  const gray = '0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0';\n    40\t  return `<svg width=\"0\" height=\"0\" style=\"position:absolute\"><defs>\n    41\t${['protan', 'deutan', 'tritan'].map(v => `<filter id=\"f-${v}\" color-interpolation-filters=\"linearRGB\"><feColorMatrix type=\"matrix\" values=\"${row(CVD[v])}\"/></filter>`).join('\\n')}\n    42\t<filter id=\"f-gray\" color-interpolation-filters=\"linearRGB\"><feColorMatrix type=\"matrix\" values=\"${gray}\"/></filter>\n    43\t</defs></svg>`;\n    44\t}\n    45\t\n    46\tconst html = `<!doctype html>\n    47\t<html lang=\"en\"><head><meta charset=\"utf-8\"><title>Axylo palette preview</title>\n    48\t<style>\n    49\t  * { box-sizing: border-box; }\n    50\t  body { margin: 0; font: 12px/1.35 system-ui, -apple-system, \"Segoe UI\", sans-serif; background: #888; }\n    51\t  .scheme { padding: 14px 16px 10px; width: 1440px; }\n    52\t  .scheme h1 { font-size: 15px; margin: 0 0 8px; font-weight: 600; }\n    53\t  .swatches { display: grid; grid-template-columns: repeat(8, 1fr); gap: 8px; margin-bottom: 10px; }\n    54\t  .sw { display: flex; flex-direction: column; gap: 3px; }\n    55\t  .chip { height: 34px; border-radius: 4px; }\n    56\t  .sw code { font: 12px ui-monospace, Menlo, Consolas, monospace; }\n    57\t  .meta { font-size: 11px; opacity: 0.85; }\n    58\t  .row { display: grid; grid-template-columns: 88px repeat(7, 1fr); gap: 8px; align-items: center; margin-top: 6px; }\n    59\t  .row .label { font-weight: 600; font-size: 12px; }\n    60\t  .cell svg { display: block; width: 100%; height: auto; }\n    61\t  .heads { display: grid; grid-template-columns: 88px repeat(7, 1fr); gap: 8px; font-size: 11px; opacity: 0.8; }\n    62\t</style></head><body>\n    63\t${filterDefs()}\n    64\t<div id=\"root\"></div>\n    65\t<script>\n    66\tconst PALETTE = ${JSON.stringify(palette)};\n    67\tconst THEME = ${JSON.stringify(theme)};\n    68\tconst STATS = ${JSON.stringify({ light: stats('light'), dark: stats('dark') })};\n    69\tconst VISION_ROWS = [['normal', ''], ['protanopia', 'url(#f-protan)'], ['deuteranopia', 'url(#f-deutan)'], ['tritanopia', 'url(#f-tritan)'], ['grayscale', 'url(#f-gray)']];\n    70\tfunction rng(seed) { let s = seed >>> 0; return () => { s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n    71\tconst W = 190, H = 120, P = 8;\n    72\tconst svg = (body, t) => '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"' + W + '\" height=\"' + H + '\" xmlns=\"http://www.w3.org/2000/svg\">'\n    73\t  + '<rect width=\"' + W + '\" height=\"' + H + '\" fill=\"' + t.background + '\"/>'\n    74\t  + [0.25, 0.5, 0.75].map(f => '<line x1=\"' + P + '\" x2=\"' + (W - P) + '\" y1=\"' + (P + f * (H - 2 * P)) + '\" y2=\"' + (P + f * (H - 2 * P)) + '\" stroke=\"' + t.grid + '\" stroke-width=\"1\"/>').join('')\n    75\t  + '<line x1=\"' + P + '\" x2=\"' + (W - P) + '\" y1=\"' + (H - P + 0.5) + '\" y2=\"' + (H - P + 0.5) + '\" stroke=\"' + t.axis + '\" stroke-width=\"1\"/>'\n    76\t  + body + '</svg>';\n    77\tconst SHAPES = ['circle', 'square', 'triangle', 'diamond', 'cross', 'plus', 'triangle-down', 'star'];\n    78\tfunction marker(shape, x, y, c, bg) {\n    79\t  const r = 3.2, s = 'fill=\"' + c + '\" stroke=\"' + bg + '\" stroke-width=\"1\"';\n    80\t  switch (shape) {\n    81\t    case 'circle': return '<circle cx=\"' + x + '\" cy=\"' + y + '\" r=\"' + r + '\" ' + s + '/>';\n    82\t    case 'square': return '<rect x=\"' + (x - r) + '\" y=\"' + (y - r) + '\" width=\"' + 2 * r + '\" height=\"' + 2 * r + '\" ' + s + '/>';\n    83\t    case 'triangle': return '<path d=\"M' + x + ' ' + (y - r - 0.6) + 'L' + (x + r + 0.4) + ' ' + (y + r) + 'L' + (x - r - 0.4) + ' ' + (y + r) + 'Z\" ' + s + '/>';\n    84\t    case 'triangle-down': return '<path d=\"M' + x + ' ' + (y + r + 0.6) + 'L' + (x + r + 0.4) + ' ' + (y - r) + 'L' + (x - r - 0.4) + ' ' + (y - r) + 'Z\" ' + s + '/>';\n    85\t    case 'diamond': return '<path d=\"M' + x + ' ' + (y - r - 1) + 'L' + (x + r + 1) + ' ' + y + 'L' + x + ' ' + (y + r + 1) + 'L' + (x - r - 1) + ' ' + y + 'Z\" ' + s + '/>';\n    86\t    case 'cross': return '<path d=\"M' + (x - r) + ' ' + (y - r) + 'L' + (x + r) + ' ' + (y + r) + 'M' + (x + r) + ' ' + (y - r) + 'L' + (x - r) + ' ' + (y + r) + '\" stroke=\"' + c + '\" stroke-width=\"2\"/>';\n    87\t    case 'plus': return '<path d=\"M' + x + ' ' + (y - r - 0.5) + 'V' + (y + r + 0.5) + 'M' + (x - r - 0.5) + ' ' + y + 'H' + (x + r + 0.5) + '\" stroke=\"' + c + '\" stroke-width=\"2\"/>';\n    88\t    default: { let d = ''; for (let i = 0; i < 10; i++) { const a = -Math.PI / 2 + i * Math.PI / 5, rr = i % 2 ? r * 0.5 : r + 1; d += (i ? 'L' : 'M') + (x + rr * Math.cos(a)).toFixed(2) + ' ' + (y + rr * Math.sin(a)).toFixed(2); } return '<path d=\"' + d + 'Z\" ' + s + '/>'; }\n    89\t  }\n    90\t}\n    91\tfunction walks(n, len, seed) {\n    92\t  const r = rng(seed); const out = [];\n    93\t  for (let s = 0; s < n; s++) { let v = 0.2 + 0.6 * r(); const pts = []; for (let i = 0; i < len; i++) { v += (r() - 0.5) * 0.12; v = Math.min(0.95, Math.max(0.05, v)); pts.push(v); } out.push(pts); }\n    94\t  return out;\n    95\t}\n    96\tfunction lines(n, t, cols) {\n    97\t  const data = walks(n, 40, 11 + n), X = i => P + i * (W - 2 * P - 6) / 39, Y = v => P + (1 - v) * (H - 2 * P);\n    98\t  return svg(data.map((pts, s) => '<path d=\"' + pts.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + '\" fill=\"none\" stroke=\"' + cols[s] + '\" stroke-width=\"2\" stroke-linejoin=\"round\"/>'\n    99\t    + marker(SHAPES[s], X(39), Y(pts[39]), cols[s], t.background)).join(''), t);\n   100\t}\n   101\tfunction overlap(t, cols) {\n   102\t  const data = walks(3, 30, 5), X = i => P + i * (W - 2 * P) / 29, Y = v => P + (1 - v) * (H - 2 * P);\n   103\t  return svg(data.map((pts, s) => '<path d=\"M' + X(0) + ' ' + Y(0) + pts.map((v, i) => 'L' + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + 'L' + X(29) + ' ' + Y(0) + 'Z\" fill=\"' + cols[s] + '\" fill-opacity=\"0.25\"/>'\n   104\t    + '<path d=\"' + pts.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + '\" fill=\"none\" stroke=\"' + cols[s] + '\" stroke-width=\"2\"/>').join(''), t);\n   105\t}\n   106\tfunction stacked(t, cols) {\n   107\t  const n = 8, len = 30, r = rng(3), vals = [];\n   108\t  for (let s = 0; s < n; s++) { let v = 0.5 + r(); const a = []; for (let i = 0; i < len; i++) { v = Math.max(0.2, v + (r() - 0.5) * 0.3); a.push(v); } vals.push(a); }\n   109\t  const tot = Array.from({ length: len }, (_, i) => vals.reduce((a, s) => a + s[i], 0)), max = Math.max(...tot) * 1.05;\n   110\t  const X = i => P + i * (W - 2 * P) / (len - 1), Y = v => P + (1 - v / max) * (H - 2 * P);\n   111\t  let lower = Array(len).fill(0), out = '';\n   112\t  for (let s = 0; s < n; s++) {\n   113\t    const upper = lower.map((l, i) => l + vals[s][i]);\n   114\t    out += '<path d=\"' + upper.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + lower.map((v, i) => 'L' + X(len - 1 - i).toFixed(1) + ' ' + Y(lower[len - 1 - i]).toFixed(1)).join('') + 'Z\" fill=\"' + cols[s] + '\" fill-opacity=\"0.8\"/>';\n   115\t    out += '<path d=\"' + upper.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + '\" fill=\"none\" stroke=\"' + t.background + '\" stroke-width=\"1\"/>';\n   116\t    lower = upper;\n   117\t  }\n   118\t  return svg(out, t);\n   119\t}\n   120\tfunction donut(t, cols) {\n   121\t  const v = [30, 22, 16, 12, 9, 7, 6, 5], tot = v.reduce((a, b) => a + b, 0), cx = W / 2, cy = H / 2, R = 52, r0 = 31;\n   122\t  let a = -Math.PI / 2, out = '';\n   123\t  v.forEach((x, i) => {\n   124\t    const b = a + 2 * Math.PI * x / tot, large = b - a > Math.PI ? 1 : 0, p = (rr, t) => (cx + rr * Math.cos(t)).toFixed(2) + ' ' + (cy + rr * Math.sin(t)).toFixed(2);\n   125\t    out += '<path d=\"M' + p(R, a) + 'A' + R + ' ' + R + ' 0 ' + large + ' 1 ' + p(R, b) + 'L' + p(r0, b) + 'A' + r0 + ' ' + r0 + ' 0 ' + large + ' 0 ' + p(r0, a) + 'Z\" fill=\"' + cols[i] + '\" stroke=\"' + t.background + '\" stroke-width=\"1\"/>';\n   126\t    a = b;\n   127\t  });\n   128\t  return '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"' + W + '\" height=\"' + H + '\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"' + W + '\" height=\"' + H + '\" fill=\"' + t.background + '\"/>' + out + '</svg>';\n   129\t}\n   130\tfunction bars(t, cols) {\n   131\t  const r = rng(9), groups = 3, n = 6, gw = (W - 2 * P) / groups, bw = (gw - 10) / n;\n   132\t  let out = '';\n   133\t  for (let g = 0; g < groups; g++) for (let s = 0; s < n; s++) { const h = (0.3 + 0.65 * r()) * (H - 2 * P); out += '<rect x=\"' + (P + g * gw + 5 + s * bw).toFixed(1) + '\" y=\"' + (H - P - h).toFixed(1) + '\" width=\"' + (bw - 1).toFixed(1) + '\" height=\"' + h.toFixed(1) + '\" fill=\"' + cols[s] + '\"/>'; }\n   134\t  return svg(out, t);\n   135\t}\n   136\tconst fmt = x => x.toFixed(3);\n   137\tconst root = document.getElementById('root');\n   138\tfor (const scheme of (new URLSearchParams(location.search).get('scheme') || 'light,dark').split(',')) {\n   139\t  const t = THEME[scheme], cols = PALETTE[scheme], st = STATS[scheme];\n   140\t  const ink = scheme === 'light' ? '#1d2129' : '#e6e8ec';\n   141\t  const el = document.createElement('section'); el.className = 'scheme'; el.id = scheme;\n   142\t  el.style.background = t.background; el.style.color = ink;\n   143\t  el.innerHTML = '<h1>' + scheme + ' scheme, background ' + t.background + '</h1>'\n   144\t    + '<div class=\"swatches\">' + st.map((s, i) => '<div class=\"sw\"><div class=\"chip\" style=\"background:' + s.hex + '\"></div><code>' + (i + 1) + ' ' + s.hex + '</code>'\n   145\t      + '<span class=\"meta\">' + s.contrast.toFixed(2) + ':1 · nearest ' + fmt(s.near.normal.d) + ' (' + (s.near.normal.k + 1) + ')</span>'\n   146\t      + '<span class=\"meta\">worst CVD ' + fmt(Math.min(s.near.protan.d, s.near.deutan.d, s.near.tritan.d)) + '</span></div>').join('') + '</div>'\n   147\t    + '<div class=\"heads\"><span></span><span>3 lines, 2 px</span><span>5 lines</s