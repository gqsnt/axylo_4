    59\t  let runnerHead;\n    60\t  try { runnerHead = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: REPO, stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); } catch { runnerHead = 'not available'; }\n    61\t  return {\n    62\t    browser: { name: 'Google Chrome (system, via Playwright channel \"chrome\")', version: browser.version(), headless: !headed },\n    63\t    playwright: JSON.parse(fs.readFileSync(path.join(REPO, 'node_modules/playwright-core/package.json'), 'utf8')).version,\n    64\t    node: process.version,\n    65\t    host: { hostname: os.hostname(), cpuModel: cpus[0]?.model ?? 'not available', logicalCores: cpus.length },\n    66\t    cpu: { model: cpus[0]?.model ?? 'not available', logicalCores: cpus.length, governor: tryRead('/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor', 'not available: no cpufreq governor file') },\n    67\t    memoryGiB: +(os.totalmem() / 2 ** 30).toFixed(1),\n    68\t    os: { type: os.type(), release: os.release(), name: osRelease ?? 'not available', arch: os.arch() },\n    69\t    loadAverageAtStart: os.loadavg(),\n    70\t    hostIdle: 'not controlled: other processes (including other agents) may run on this machine during the session',\n    71\t    power: 'not available: power settings are not read by this harness',\n    72\t    // The source the measured bytes were built from is in each slot's artifact manifest (hashes.slots.*.source);\n    73\t    // this is only the checkout the runner itself was started from.\n    74\t    runnerCheckoutHead: runnerHead,\n    75\t    lockfiles: { 'bench/package-lock.json': fileHash(path.join(BENCH, 'package-lock.json')), 'package-lock.json': fileHash(path.join(REPO, 'package-lock.json')) },\n    76\t  };\n    77\t}\n    78\t\n    79\tconst expectations = new Map();\n    80\t/** Fixture facts the admission check compares against, computed in Node from the same generator as the page. */\n    81\texport function expectedFor(workload, params) {\n    82\t  const key = J