c && !c.ok) for (const r of c.reasons) extra.push(`${label}: ${r}`);\n   108\t  }\n   109\t  return { admitted: view.admitted && extra.length === 0, reasons: [...view.reasons, ...extra], limits: view.limits };\n   110\t}\n   111\t\n   112\tconst DURATIONS = ['TaskDuration', 'ScriptDuration', 'LayoutDuration', 'RecalcStyleDuration', 'DevToolsCommandDuration', 'V8CompileDuration', 'TaskOtherDuration', 'ThreadTime'];\n   113\tconst COUNTS = ['LayoutCount', 'RecalcStyleCount', 'Nodes', 'JSEventListeners', 'JSHeapUsedSize', 'JSHeapTotalSize'];\n   114\t\n   115\t/** Every \"<name>:start\" / \"<name>:end\" snapshot pair -> metric deltas, keyed \"<name>:start-><name>:end\". */\n   116\tfunction deltas(snaps, cpu, pagePid, gpuPid) {\n   117\t  const out = {};\n   118\t  for (const from of Object.keys(snaps)) {\n   119\t    if (!from.endsWith(':start')) continue;\n   120\t    const to = `${from.slice(0, -6)}:end`;\n   121\t    if (!snaps[to]) continue;\n   122\t    const d = {};\n   123\t    for (const k of [...DURATIONS, ...COUNTS]) if (k in snaps[from] && k in snaps[to]) d[k] = snaps[to][k] - snaps[from][k];\n   124\t    d.endNodes = snaps[to].Nodes;\n   125\t    d.endJSHeapUsedSize = snaps[to].JSHeapUsedSize;\n   126\t    // CPU time of whole processes (all threads), from the browser: the page's renderer and the GPU process.\n   127\t    const c0 = cpu[from], c1 = cpu[to];\n   128\t    if (c0 && c1) {\n   129\t      if (pagePid && pagePid in c0 && pagePid in c1) d.rendererCpu = c1[pagePid] - c0[pagePid];\n   130\t      if (gpuPid && gpuPid in c0 && gpuPid in c1) d.gpuCpu = c1[gpuPid] - c0[gpuPid];\n   131\t    }\n   132\t    out[`${from}->${to}`] = d;\n   133\t  }\n   134\t  return out;\n   135\t}\n   136\t\n   137\t/** Linux only: proportional set size and resident size of a process, in bytes, from /proc. */\n   138\tfunction procMemory(pid) {\n   139\t  try {\n   140\t    const t = fs.readFileSync(`/proc/${pid}/smaps_rollup`, 'utf8');\n   141\t    const kb = name => Number((new RegExp(`^${name}:\\\\s+(\\\\d+) kB`, 'm').exec(t) ?? [])[1]) * 1024;\n   142\t    return { pss: kb('Pss'), rss: kb('Rss') };\n   143\t  } catch (e) { return { na: `not available: ${e.code ?? e.message}` }; }\n   144\t}\n   145\t\n   146\t/**\n   147\t * One run in a fresh context. Returns { outcome, ... } where outcome is one of\n   148\t * ok | not-admitted | incomplete | not-available | error | timeout | crash.\n   149\t * spec: { adapter, adapterParams?, workload, params, settleMs, timeoutMs, dpr?, slot?, probe?: 'geometry' | 'counters',\n   150\t *         profile?: { file } }\n   151\t */\n   152\texport async function runOnce(browser, server, spec) {\n   153\t  const started = Date.now();\n   154\t  const ctx = await browser.newContext({ viewport: { width: 1440, height: 900 }, deviceScaleFactor: spec.dpr ?? 1, timezoneId: 'UTC', locale: 'en-US' });\n   155\t  const logs = [], pageErrors = [], snaps = {}, cpu = {}, mem = {}, profiles = {};\n   156\t  let settle;\n   157\t  const finished = new Promise(r => { settle = r; });\n   158\t  let timer, bcdp;\n   159\t  try {\n   160\t    const page = await ctx.newPage();\n   161\t    const cdp = await ctx.newCDPSession(page);\n   162\t    bcdp = await browser.newBrowserCDPSession();\n   163\t    await cdp.send('Performance.enable', { timeDomain: 'timeTicks' });\n   164\t    const processes = async () => (await bcdp.send('SystemInfo.getProcessInfo')).processInfo;\n   165\t    const cpuSample = async label => { cpu[label] = Object.fromEntries((await processes()).map(p => [p.id, p.cpuTime])); };\n   166\t    let profiling = null;\n   167\t    const startProfile = async name => {\n   168\t      await cdp.send('Profiler.enable');\n   169\t      await cdp.send('Profiler.setSamplingInterval', { interval: spec.profile.intervalUs ?? 100 });\n   170\t      await cdp.send('Profiler.start');\n   171\t      profiling = name;\n   172\t    };\n   173\t    const stopProfile = async () => {\n   174\t      const { profile } = await cdp.send('Profiler.stop');\n   175\t      profiles[profiling] = profile;\n   176\t      profiling = null;\n   177\t    };\n   178\t    await page.exposeBinding('__benchMetrics', async (_src, label) => {\n   179\t      // Order keeps the browser-side process sample outside the window: before the start, after the end.\n   180\t      if (label.endsWith(':start')) await cpuSample(label);\n   181\t      // Profiled runs split the create window at the ready frame: the active part, then the settle period.\n   182\t      if (spec.profile && profiling && (label === 'create:ready' || label === 'create:end')) await stopProfile();\n   183\t      const { metrics } = await cdp.send('Performance.getMetrics');\n   184\t      snaps[label] = Object.fromEntries(metrics.map(m => [m.name, m.value]));\n   185\t      if (label.endsWith(':end')) await cpuSample(label);\n   186\t      if (spec.profile && label === 'create:start') await startProfile('active');\n   187\t      if (spec.profile && label === 'create:ready') await startProfile('settle');\n   188\t    });\n   189\t    await page.exposeBinding('__benchMemory', async (_src, label) => {\n   190\t      await cdp.send('HeapProfiler.collectGarbage');\n   191\t      const heap = await cdp.send('Runtime.getHeapUsage');\n   192\t      const { metrics } = await cdp.send('Performance.getMetrics');\n   193\t      const pm = Object.fromEntries(metrics.map(m => [m.name, m.value]));\n   194\t      const procs = await processes();\n   195\t      mem[label] = {\n   196\t        heap, listeners: pm.JSEventListeners, nodes: pm.Nodes,\n   197\t        processes: procs.filter(p => p.type === 'renderer' || p.type === 'GPU').map(p => ({ pid: p.id, type: p.type, cpuTime: p.cpuTime, ...procMemory(p.id) })),\n   198\t      };\n   199\t    });\n   200\t    // W-hover: the page asks for a real pointer move (CDP Input.dispatchMouseEvent through Playwright), so the\n   201\t    // event goes through the browser's input pipeline like a user's.\n   202\t    await page.exposeBinding('__benchPointer', async (_src, x, y) => { await page.mouse.move(x, y); });\n   203\t    await page.exposeBinding('__benchDone', (_src, result) => settle({ kind: 'done', result }));\n   204\t    page.on('crash', () => settle({ kind: 'crash' }));\n   205\t    page.on('pageerror', e => pageErrors.push(String(e?.stack ?? e).slice(0, 600)));\n   206\t    page.on('console', m => { if (m.type() === 'error' || m.type() === 'warning') logs.push(`${m.type()}: ${m.text().slice(0, 300)}`); });\n   207\t    timer = setTimeout(() => settle({ kind: 'timeout' }), spec.timeoutMs);\n   208\t    const q = new URLSearchParams({ adapter: spec.adapter, workload: spec.workload, params: JSON.stringify(spec.params), settle: String(spec.settleMs), aparams: JSON.stringify(spec.adapterParams ?? {}), probe: spec.probe ?? '', profile: spec.profile ? '1' : '' });\n   209\t    page.goto(`${server.url(spec.slot ?? 'A')}index.html?${q}`).catch(e => settle({ kind: 'error', error: `navigation: ${e.message}` }));\n   210\t    // Test hook only (test/browser): crash the renderer to check that a crash is its own outcome.\n   211\t    if (spec.testCrashAfterMs) setTimeout(() => cdp.send('Page.crash').catch(() => {}), spec.testCrashAfterMs);\n   212\t    const end = await finished;\n   213\t    const rec = { adapter: spec.adapter, adapterParams: spec.adapterParams ?? {}, slot: spec.slot ?? 'A', probe: spec.probe ?? null, durationMs: Date.now() - started, logs: logs.slice(0, 20), pageErrors: pageErrors.slice(0, 10) };\n   214\t    if (end.kind === 'timeout') return { ...rec, outcome: 'timeout', reason: `no result within ${spec.timeoutMs} ms`, snapshots: Object.keys(snaps) };\n   215\t    if (end.kind === 'crash') return { ...rec, outcome: 'crash', reason: 'renderer process crashed' };\n   216\t    if (end.kind === 'error') return { ...rec, outcome: 'error', error: end.error };\n   217\t    const result = end.result;\n   218\t    if (result.outcome !== 'ok') return { ...rec, outcome: result.outcome, reason: result.reason, error: result.error, result: { env: result.env, adapter: result.adapter } };\n   219\t    if (pageErrors.length) return { ...rec, outcome: 'error', error: `uncaught page error(s): ${pageErrors[0]}`, result: { env: result.env, adapter: result.adapter } };\n   220\t    if (spec.profile) {\n   221\t      fs.writeFileSync(spec.profile.file, JSON.stringify(profiles.active ?? {}));\n   222\t      if (profiles.settle) fs.writeFileSync(spec.profile.file.replace(/\\.cpuprofile$/, '.settle.cpuprofile'), JSON.stringify(profiles.settle));\n   223\t    }\n   224\t\n   225\t    // The page's renderer is the renderer process that used the most CPU time over the run (the context may also\n   226\t    // hold Chrome's initial and spare renderers); the GPU process is the one process of that type.\n   227\t    const labels = Object.keys(cpu);\n   228\t    let pagePid = null;\n   229\t    const finalProcs = await processes();\n   230\t    const gpuPid = finalProcs.find(p => p.type === 'GPU')?.id ?? null;\n   231\t    if (labels.length >= 2) {\n   232\t      const first = cpu[labels[0]], last = cpu[labels[labels.length - 1]];\n   233\t      let best = -1;\n   234\t      for (const p of finalProcs) if (p.type === 'renderer' && p.id in first && p.id in last && last[p.id] - first[p.id] > best) { best = last[p.id] - first[p.id]; pagePid = p.id; }\n   235\t    }\n   236\t    const memory = Object.keys(mem).length ? {\n   237\t      pagePid, gpuPid,\n   238\t      samples: Object.fromEntries(Object.entries(mem).map(([label, m]) => [label, {\n   239\t        heapUsed: m.heap.usedSize, heapTotal: m.heap.totalSize, embedderHeapUsed: m.heap.embedderHeapUsedSize,\n   240\t        backingStorage: Number.isFinite(m.heap.backingStorageSize) ? m.heap.backingStorageSize : null,\n   241\t        listeners: m.listeners, nodes: m.nodes,\n   242\t        renderer: m.processes.find(p => p.pid === pagePid) ?? { na: 'not available: page renderer not identified' },\n   243\t        gpu: m.processes.find(p => p.pid === gpuPid) ?? { na: 'not available: no GPU process' },\n   244\t        otherRenderers: m.processes.filter(p => p.type === 'renderer' && p.pid !== pagePid).map(p => ({ pid: p.pid, pss: p.pss })),\n   245\t      }])),\n   246\t    } : { na: 'memory not sampled in this workload' };\n   247\t\n   248\t    // An unfinished stream is a failed run, whatever its readback says: the watchdog fired or sequences were never\n   249\t    // acknowledged, so its per-update cost covers less work than a finished one.\n   250\t    if (spec.workload === 'stream') {\n   251\t      const c = streamCompletion(result.stream);\n   252\t      if (!c.complete) return { ...rec, outcome: 'incomplete', reason: c.reasons.join('; '), result: { env: result.env, adapter: result.adapter, stream: { samples: result.stream?.samples, receivedCount: result.stream?.receivedCount, visibleCount: result.stream?.visibleCount, ended: result.stream?.ended } } };\n   253\t    }\n   254\t    const admission = admit(spec, result, result.adapter.floor, { requireDrawn: spec.probe === 'geometry' });\n   255\t    const run = { ...rec, outcome: admission.admitted ? 'ok' : 'not-admitted', admission, result, deltas: deltas(snaps, cpu, pagePid, gpuPid), memory };\n   256\t    if (!admission.admitted) {\n   257\t      // A timing that failed admission is not kept; only what the chart reported and why it was rejected.\n   258\t      run.reason = admission.reasons.slice(0, 5).join('; ');\n   259\t      delete run.deltas;\n   260\t      delete run.memory;\n   261\t      run.result = { env: result.env, adapter: result.adapter, checksum: result.checksum, describe: result.describe, themeCheck: result.themeCheck, resizeCheck: result.resizeCheck, hoverCheck: result.hoverCheck, hover: result.hover, zoomCheck: result.zoomCheck };\n   262\t    }\n   263\t    return run;\n   264\t  } catch (e) {\n   265\t    return { adapter: spec.adapter, outcome: 'error', error: String(e?.stack ?? e).slice(0, 1000), durationMs: Date.now() - started };\n   266\t  } finally {\n   267\t    clearTimeout(timer);\n   268\t    await bcdp?.detach().catch(() => {});\n   269\t    await ctx.close().catch(() => {});\n   270\t  }\n   271\t}\n","exit_code":0,"status":"completed"}}
