{"type":"item.completed","item":{"id":"item_39","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/react/build.mjs; nl -ba packages/react/test/dist.test.ts; nl -ba packages/react/package.json; nl -ba scripts/build.mjs | sed -n '1,110p'; nl -ba docs/03-plan-typescript-release.md | sed -n '103,169p'\"","aggregated_output":"     1\t// Builds packages/react/dist, as the core's build does for packages/axylo/dist (development and production\n     2\t// flavours, chosen through the `development` export condition):\n     3\t//   index.js      production: identifiers and syntax minified, the development hint removed\n     4\t//   index.dev.js  development: with the memoization hint\n     5\t//   index.d.ts    declarations (needs packages/axylo/dist/index.d.ts, so the core is built first)\n     6\t// Neither file contains a bare __DEV__, and both start with the 'use client' directive.\n     7\timport { build } from 'esbuild';\n     8\timport { execFileSync } from 'node:child_process';\n     9\timport fs from 'node:fs';\n    10\timport path from 'node:path';\n    11\t\n    12\tconst pkg = import.meta.dirname;\n    13\tconst dist = path.join(pkg, 'dist');\n    14\tfs.rmSync(dist, { recursive: true, force: true });\n    15\t\n    16\tconst common = {\n    17\t  entryPoints: [path.join(pkg, 'src/index.ts')], bundle: true, format: 'esm', target: 'es2022', legalComments: 'none',\n    18\t  logLevel: 'warning', tsconfig: path.join(pkg, 'tsconfig.json'), external: ['react', 'react/jsx-runtime', 'react-dom', 'axylo'],\n    19\t  // esbuild keeps the entry's directive; the banner is the fallback if a later version does not.\n    20\t  banner: { js: \"'use client';\" },\n    21\t};\n    22\tawait Promise.all([\n    23\t  // Whitespace is kept: minifying it drops the /* @__PURE__ */ marks on the five component definitions, and\n    24\t  // without them a consumer that imports only Line keeps all five chart types.\n    25\t  build({ ...common, minifyIdentifiers: true, minifySyntax: true, define: { __DEV__: 'false' }, outfile: path.join(dist, 'index.js') }),\n    26\t  build({ ...common, define: { __DEV__: 'true' }, outfile: path.join(dist, 'index.dev.js') }),\n    27\t]);\n    28\t\n    29\tfor (const file of ['index.js', 'index.dev.js']) {\n    30\t  const at = path.join(dist, file);\n    31\t  // One directive, first: the banner and the kept source directive must not both remain.\n    32\t  let code = fs.readFileSync(at, 'utf8').replace(/^(?:\\s*(['\"])use client\\1;?\\s*)+/, '');\n    33\t  code = `'use client';\\n${code}`;\n    34\t  if (/\\b__DEV__\\b/.test(code)) throw new Error(`${file} still refers to __DEV__`);\n    35\t  fs.writeFileSync(at, code);\n    36\t}\n    37\t\n    38\texecFileSync('npx', ['tsc', '-p', path.join(pkg, 'tsconfig.build.json')], { stdio: 'inherit', cwd: pkg });\n    39\tconsole.log('built', fs.readdirSync(dist).join(', '));\n     1\t/**\n     2\t * The shipped package (review findings 1 and 8): built by build.mjs, then used through its package name, as\n     3\t * an application would: the directive, no bare __DEV__, the size budget, server rendering in Node, a\n     4\t * consumer bundle that imports only Line, and the declarations.\n     5\t */\n     6\timport { beforeAll, describe, expect, it } from 'vitest';\n     7\timport { build, type Plugin } from 'esbuild';\n     8\timport { execFileSync } from 'node:child_process';\n     9\timport fs from 'node:fs';\n    10\timport path from 'node:path';\n    11\timport { gzipSync } from 'node:zlib';\n    12\timport { createElement, type ReactElement } from 'react';\n    13\timport { renderToString } from 'react-dom/server';\n    14\t\n    15\tconst pkg = path.resolve(import.meta.dirname, '..');\n    16\tconst repo = path.resolve(pkg, '../..');\n    17\tconst read = (file: string) => fs.readFileSync(path.join(pkg, 'dist', file), 'utf8');\n    18\t\n    19\tbeforeAll(() => {\n    20\t  execFileSync('node', [path.join(pkg, 'build.mjs')], { cwd: repo, stdio: 'pipe' });\n    21\t}, 120000);\n    22\t\n    23\tdescribe('shipped files', () => {\n    24\t  for (const file of ['index.js', 'index.dev.js']) {\n    25\t    it(`${file} starts with the 'use client' directive and has no bare __DEV__`, () => {\n    26\t      const code = read(file);\n    27\t      expect(code.startsWith(\"'use client';\\n\")).toBe(true);\n    28\t      expect(code.match(/use client/g)).toHaveLength(1);\n    29\t      expect(code).not.toMatch(/\\b__DEV__\\b/);\n    30\t      expect(code).not.toMatch(/axylo-figure|ResizeObserver/);\n    31\t    });\n    32\t  }\n    33\t\n    34\t  it('the production file drops the development hint, the development file keeps it', () => {\n    35\t    expect(read('index.js')).not.toContain('[axylo/react]');\n    36\t    expect(read('index.dev.js')).toContain('[axylo/react]');\n    37\t  });\n    38\t\n    39\t  it('the production file is at most 2 KiB gzipped', () => {\n    40\t    const code = fs.readFileSync(path.join(pkg, 'dist/index.js'));\n    41\t    const gzip = gzipSync(code, { level: 9 }).length;\n    42\t    console.info(`@axylo/react dist/index.js: ${code.length} B, ${gzip} B gzip (level 9)`);\n    43\t    expect(gzip).toBeLessThanOrEqual(2048);\n    44\t  });\n    45\t\n    46\t  it('the declarations are what a consumer type-checks against', () => {\n    47\t    expect(read('index.d.ts')).toContain('export declare const Line: <Row>(props: LineProps<Row>) => ReactElement | null;');\n    48\t    // test/consumer imports '@axylo/react' with no path mapping, so it reaches dist/index.d.ts.\n    49\t    execFileSync('npx', ['tsc', '-p', path.join(pkg, 'test/consumer')], { cwd: repo, stdio: 'pipe' });\n    50\t  });\n    51\t});\n    52\t\n    53\tdescribe('server rendering through the package name', () => {\n    54\t  // Types from source, so `tsc -p packages/react` does not need dist; the runtime import is the shipped one.\n    55\t  type Components = typeof import('../src/index');\n    56\t  const shipped = (specifier: string) => import(specifier) as Promise<Components>;\n    57\t  const rows = [{ day: '2026-01-01', channel: 'Direct', sessions: 10, visits: 4 }, { day: '2026-01-02', channel: 'Direct', sessions: 12, visits: 5 }];\n    58\t  type Row = (typeof rows)[number];\n    59\t\n    60\t  const elements = ({ Area, Bar, Donut, Line, Scatter }: Components): [string, ReactElement][] => [\n    61\t    ['Line', createElement(Line<Row>, { data: rows, x: 'day', y: 'sessions', series: 'channel', title: 'Sessions' })],\n    62\t    ['Area', createElement(Area<Row>, { data: rows, x: 'day', y: 'sessions', stacked: true })],\n    63\t    ['Bar', createElement(Bar<Row>, { data: rows, x: 'channel', y: 'sessions' })],\n    64\t    ['Scatter', createElement(Scatter<Row>, { data: rows, x: 'visits', y: 'sessions' })],\n    65\t    ['Donut', createElement(Donut<Row>, { data: rows, label: 'channel', value: 'sessions' })],\n    66\t  ];\n    67\t\n    68\t  it('runs without a DOM', () => {\n    69\t    expect(typeof (globalThis as { document?: unknown }).document).toBe('undefined');\n    70\t  });\n    71\t\n    72\t  for (const [label, load] of [\n    73\t    ['@axylo/react', () => shipped('@axylo/react')],\n    74\t    ['dist/index.js', () => shipped('../dist/index.js')],\n    75\t  ] as const) {\n    76\t    it(`${label}: each component renders its empty container`, async () => {\n    77\t      const components = await load();\n    78\t      for (const [, element] of elements(components)) expect(renderToString(element)).toBe('<div class=\"axylo\"></div>');\n    79\t    });\n    80\t\n    81\t    it(`${label}: id, className, style and data-* render on the container; aria-* and options do not`, async () => {\n    82\t      const { Line } = await load();\n    83\t      const html = renderToString(createElement(Line<Row>, {\n    84\t        data: rows, x: 'day', y: 'sessions', title: 'T', id: 'card', className: 'card wide', style: { height: 300 }, 'data-testid': 'chart',\n    85\t        ...{ 'aria-label': 'Not forwarded' },\n    86\t      }));\n    87\t      expect(html).toBe('<div class=\"axylo card wide\" id=\"card\" style=\"height:300px\" data-testid=\"chart\"></div>');\n    88\t    });\n    89\t  }\n    90\t});\n    91\t\n    92\tdescribe('a consumer that imports only Line (finding 8)', () => {\n    93\t  // Stand-ins for the core with one marker each, so what the consumer's bundler kept can be read off.\n    94\t  const core: Plugin = {\n    95\t    name: 'core-stand-in',\n    96\t    setup(b) {\n    97\t      b.onResolve({ filter: /^axylo$/ }, () => ({ path: 'axylo', namespace: 'stand-in' }));\n    98\t      b.onLoad({ filter: /.*/, namespace: 'stand-in' }, () => ({\n    99\t        contents: ['line', 'area', 'bar', 'scatter', 'donut'].map(k => `export function ${k}() { return 'core-${k}'; }`).join('\\n'),\n   100\t        loader: 'js',\n   101\t      }));\n   102\t    },\n   103\t  };\n   104\t\n   105\t  for (const conditions of [[], ['development']]) {\n   106\t    it(`keeps only the line chart (conditions: ${conditions.join(', ') || 'default'})`, async () => {\n   107\t      const result = await build({\n   108\t        stdin: { contents: \"import { Line } from '@axylo/react'; console.log(Line);\", resolveDir: repo, loader: 'js' },\n   109\t        bundle: true, format: 'esm', write: false, logLevel: 'silent', conditions, external: ['react', 'react/jsx-runtime'], plugins: [core],\n   110\t      });\n   111\t      const code = result.outputFiles[0]!.text;\n   112\t      expect(code).toContain('core-line');\n   113\t      for (const other of ['area', 'bar', 'scatter', 'donut']) expect(code).not.toContain(`core-${other}`);\n   114\t      for (const other of ['\"Area\"', '\"Bar\"', '\"Scatter\"', '\"Donut\"']) expect(code).not.toContain(other);\n   115\t    });\n   116\t  }\n   117\t});\n     1\t{\n     2\t  \"name\": \"@axylo/react\",\n     3\t  \"version\": \"0.0.0\",\n     4\t  \"description\": \"React components for Axylo charts.\",\n     5\t  \"license\": \"MIT\",\n     6\t  \"type\": \"module\",\n     7\t  \"sideEffects\": false,\n     8\t  \"files\": [\"dist/index.js\", \"dist/index.dev.js\", \"dist/index.d.ts\"],\n     9\t  \"exports\": { \".\": { \"types\": \"./dist/index.d.ts\", \"development\": \"./dist/index.dev.js\", \"default\": \"./dist/index.js\" } },\n    10\t  \"peerDependencies\": { \"axylo\": \"0.0.0\", \"react\": \"^18.0.0 || ^19.0.0\" }\n    11\t}\n     1\t// Builds packages/axylo/dist: ESM (production and development flavours), script-tag files, CSS and type declarations.\n     2\timport { build } from 'esbuild';\n     3\timport { execFileSync } from 'node:child_process';\n     4\timport fs from 'node:fs';\n     5\tconst pkg = 'packages/axylo';\n     6\tfs.rmSync(`${pkg}/dist`, { recursive: true, force: true });\n     7\tconst common = { entryPoints: [`${pkg}/src/index.ts`], bundle: true, target: 'es2022', legalComments: 'none', logLevel: 'warning' };\n     8\tawait Promise.all([\n     9\t  build({ ...common, format: 'esm', minify: true, define: { __DEV__: 'false' }, outfile: `${pkg}/dist/axylo.js` }),\n    10\t  build({ ...common, format: 'esm', define: { __DEV__: 'true' }, outfile: `${pkg}/dist/axylo.dev.js` }),\n    11\t  build({ ...common, format: 'iife', globalName: 'Axylo', define: { __DEV__: 'true' }, outfile: `${pkg}/dist/axylo.iife.js` }),\n    12\t  build({ ...common, format: 'iife', globalName: 'Axylo', minify: true, define: { __DEV__: 'false' }, outfile: `${pkg}/dist/axylo.iife.min.js` }),\n    13\t]);\n    14\t// The stylesheet's source of truth is a string in the library (it is also applied at run time without a <style> element);\n    15\t// the standalone file is for pages that prefer to load it themselves, for example under a strict Content Security Policy.\n    16\t{\n    17\t  const r = await build({ entryPoints: [`${pkg}/src/theme/css.ts`], bundle: true, format: 'esm', write: false, logLevel: 'silent' });\n    18\t  const mod = await import('data:text/javascript;base64,' + Buffer.from(r.outputFiles[0].contents).toString('base64'));\n    19\t  fs.writeFileSync(`${pkg}/dist/axylo.css`, mod.AXYLO_CSS);\n    20\t}\n    21\texecFileSync('npx', ['tsc', '-p', `${pkg}/tsconfig.build.json`], { stdio: 'inherit' });\n    22\t// The React adapter needs the declarations just written.\n    23\texecFileSync('node', ['packages/react/build.mjs'], { stdio: 'inherit' });\n    24\tconsole.log('built', fs.readdirSync(`${pkg}/dist`).filter(f => !fs.statSync(`${pkg}/dist/${f}`).isDirectory()).join(', '));\n   103\t| `strict`, `onDiagnostic` | Diagnostics delivery (section 3.5 of the spec). |\n   104\t\n   105\tThere is no `width`, `height`, `responsive`, `theme`, `palette` or `animation` option. Size comes from the container, colors from CSS, motion from the spec (I5). An unknown key raises AX150 with the closest known name.\n   106\t\n   107\t### 1.5 Handle and commit contract\n   108\t\n   109\t```ts\n   110\tchart.update({ title: 'Sessions' });                 // options\n   111\tchart.append([{ day: '2026-05-01', channel: 'Direct', sessions: 41210 }], { keep: 120 });   // rows\n   112\tchart.zoom(['2026-03-01', '2026-03-31']);            // view\n   113\tconst off = chart.on('hover', point => { … });\n   114\tchart.diagnostics;                                   // current, as soon as any call returns\n   115\tchart.destroy();\n   116\t```\n   117\t\n   118\tFinding D3: the ten libraries have seven update idioms. Axylo has three methods, one per kind of change, with one contract.\n   119\t\n   120\t| Rule | Detail |\n   121\t|---|---|\n   122\t| Order | Calls are applied in the order made. `update({ data })` followed by `append` appends to the new data. |\n   123\t| Two phases | Each call validates and normalizes synchronously: diagnostics are current when it returns, and a `strict` chart throws from that call. Drawing is deferred to the next animation frame, and calls made before that frame are drawn once. |\n   124\t| Atomic switch | Marks, labels, hit testing and the accessibility layer move to a new data revision together. No frame mixes two revisions. |\n   125\t| Patches | A key present in an `update` replaces the old value whole; a key set to `undefined` returns to its default; absent keys stay. No deep merging. |\n   126\t| Rejected changes | A call that throws under `strict` leaves the chart on its last valid state. |\n   127\t| Streaming | `keep` is the number of distinct x values retained. Rows before the last x are accepted through the slower full update and raise AX151. While zoomed to the latest edge the view follows new data; zoomed elsewhere, it stays put. Paused charts buffer (I6). Keyboard focus stays on its datum until that datum leaves the window (A7). |\n   128\t| Teardown | `destroy()` cancels the pending frame, disconnects observers and listeners, and makes later calls no-ops. |\n   129\t\n   130\t### 1.6 Diagnostics\n   131\t\n   132\tThe registry, with each code's level and outcome, is in the spec (section 3.5). Example for the Phase 1 combined dirty fixture (`[10, 20, null, NaN, '40', undefined, 70]`):\n   133\t\n   134\t```\n   135\t[axylo AX103] \"Dirty input\": y field \"value\" has 1 value that is not a finite number (NaN at row 3). Shown as a gap.\n   136\t  Check the calculation that produced it, or send null for \"no data\".\n   137\t[axylo AX106] \"Dirty input\": y field \"value\" mixes numbers with 1 string (\"40\" at row 4). The string is not plotted.\n   138\t  Convert it to a number where the data is produced.\n   139\t[axylo AX102] \"Dirty input\": y field \"value\" is absent in 1 row (row 5). Shown as a gap.\n   140\t  Send null if the value is known to be missing.\n   141\t```\n   142\t\n   143\tThe reader of that chart sees \"Values not shown: 3. See table.\" (F12).\n   144\t\n   145\t`validate(type, options)` runs the same normalization without a DOM and returns the diagnostics, so a server, a test or a coding agent can check a chart before rendering it.\n   146\t\n   147\tDevelopment and production flavours are selected through package `exports` conditions. The script-tag distribution ships `axylo.js` (development) and `axylo.min.js` (production). Errors and warnings print once per code per page in both; hints only in development.\n   148\t\n   149\t### 1.7 React adapter\n   150\t\n   151\t```tsx\n   152\timport { Line } from '@axylo/react';\n   153\t\n   154\t<Line data={rows} x=\"day\" y=\"sessions\" series=\"channel\" title=\"Daily sessions by channel\" />\n   155\t```\n   156\t\n   157\t| Behavior | Detail |\n   158\t|---|---|\n   159\t| Lifecycle | Create on mount, `destroy` on unmount; correct under StrictMode's setup, cleanup, setup. The file is marked `'use client'`. |\n   160\t| Props to options | Field specs are compared structurally, so an inline `x={{ field: 'ts' }}` does not renormalize on every render. `data` is compared by identity; in development, the same content arriving three times with a new identity raises a hint to memoize it. |\n   161\t| Removed props | A prop that disappears is sent as `undefined`, which restores the default. |\n   162\t| Handlers | Replaced without recreating the chart. |\n   163\t| Streaming | A ref exposes the handle, so `append`, `zoom` and `diagnostics` are reachable. When `data` is controlled, a new `data` prop replaces whatever was appended. |\n   164\t\n   165\tThe adapter is prototyped in M3, before the API freezes, because it is the cheapest way to find out whether the core contract survives a second consumer. It ships in 1.0 because finding 1.1 of the landscape shows where everyday charts are written; that is evidence of where charts are written, not of demand for Axylo.\n   166\t\n   167\t## 2. Architecture\n   168\t\n   169\t### 2.1 Pipeline\n","exit_code":0,"status":"completed"}}
