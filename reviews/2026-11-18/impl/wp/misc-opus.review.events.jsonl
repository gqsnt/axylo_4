oReadoutMaxMs = NA('no readout matched');\n   318\t    const t = ms(run.deltas, 'hover:start', 'hover:end', 'TaskDuration');\n   319\t    out.taskMsPerMove = Number.isFinite(t) ? t / h.moves : NA('TaskDuration missing');\n   320\t    return out;\n   321\t  }\n   322\t  if (workload === 'zoom') {\n   323\t    const z = run.result.zoom;\n   324\t    const t = ms(run.deltas, 'zoom:start', 'zoom:end', 'TaskDuration');\n   325\t    out.taskMsPerStep = Number.isFinite(t) ? t / z.steps : NA('TaskDuration missing');\n   326\t    const lat = z.stepToFrame.filter(Number.isFinite);\n   327\t    out.stepToFrameP95Ms = lat.length ? quantile(lat, 0.95) : NA('no step drawn');\n   328\t    frameStats(out, intervalsOverlapping(z.frames, z.startAt, z.endAt), refresh, 'zoom window');\n   329\t    return out;\n   330\t  }\n   331\t  if (workload === 'mem') {\n   332\t    const m = run.memory?.samples;\n   333\t    if (!m?.chart || !m?.data) { for (const k of ['ownedBytes', 'ownedRatio', 'heapChartBytes', 'rendererPssChartBytes']) out[k] = NA(run.memory?.na ?? 'memory not sampled'); }\n   334\t    else {\n   335\t      const total = s => (Number.isFinite(s.backingStorage) ? s.heapUsed + s.backingStorage : NaN);\n   336\t      const owned = total(m.chart) - total(m.data);\n   337\t      out.ownedBytes = Number.isFinite(owned) ? owned : NA('Runtime.getHeapUsage reports no backingStorageSize in this Chrome; ArrayBuffer memory cannot be separated');\n   338\t      out.ownedRatio = Number.isFinite(owned) && run.result.callerColumnBytes ? owned / run.result.callerColumnBytes : NA('owned bytes not available');\n   339\t      out.heapChartBytes = m.chart.heapUsed - m.data.heapUsed;\n   340\t      out.rendererPssChartBytes = Number.isFinite(m.chart.renderer?.pss) && Number.isFinite(m.data.renderer?.pss) ? m.chart.renderer.pss - m.data.renderer.pss : NA(m.chart.renderer?.na ?? 'renderer PSS missing');\n   341\t    }\n   342\t    const cb = run.result.canvasBacking;\n   343\t    out.canvasBackingBytes = cb ? cb.chartCanvasBytes : NA('not recorded');\n   344\t    return out;\n   345\t  }\n   346\t  if (workload === 'lifecycle') {\n   347\t    const pts = run.result.lifecycle.checkpoints.map(c => ({ c: c.cycles, mem: run.memory?.samples?.[c.label] }));\n   348\t    const ok = pts.filter(p => p.mem && Number.isFinite(p.mem.heapUsed));\n   349\t    const bytes = p => p.mem.heapUsed + (Number.isFinite(p.mem.backingStorage) ? p.mem.backingStorage : 0);\n   350\t    out.heapSlopeBytesPerCycle = ok.length >= 3 ? slope(ok.map(p => p.c), ok.map(bytes)) : NA('fewer than 3 memory checkpoints');\n   351\t    out.heapCheckpoints = ok.map(p => [p.c, bytes(p)]);\n   352\t    const first = ok[0]?.mem, last = ok[ok.length - 1]?.mem;\n   353\t    out.listenersAfter = Number.isFinite(first?.listeners) && Number.isFinite(last?.listeners) ? last.listeners - first.listeners : NA('listener count not read');\n   354\t    out.nodesAfter = Number.isFinite(first?.nodes) && Number.isFinite(last?.nodes) ? last.nodes - first.nodes : NA('node count not read');\n   355\t    return out;\n   356\t  }\n   357\t  // create workloads: first, page, compact, scatter\n   358\t  const g = name => ms(run.deltas, 'create:start', 'create:end', name);\n   359\t  const t = g('TaskDuration');\n   360\t  out.taskMs = Number.isFinite(t) ? t : NA('TaskDuration missing');\n   361\t  out.scriptMs = g('ScriptDuration');\n   362\t  out.layoutStyleMs = g('LayoutDuration') + g('RecalcStyleDuration');\n   363\t  out.devtoolsMs = g('DevToolsCommandDuration');\n   364\t  out.readyMs = run.result.timing.readyMs;\n   365\t  out.readyFrameMs = run.result.timing.readyFrameMs;\n   366\t  out.rendererCpuMs = cpuMs(run.deltas, 'create:start', 'create:end', 'rendererCpu');\n   367\t  out.gpuCpuMs = cpuMs(run.deltas, 'create:start', 'create:end', 'gpuCpu');\n   368\t  memorySummary(out, run);\n   369\t  return out;\n   370\t}\n   371\t\n   372\t/** Outcomes a timed run can have that are not a timing. \"ok\" is the only one that is paired. */\n   373\texport const FAILURE_OUTCOMES = ['not-admitted', 'incomplete', 'error', 'timeout', 'crash', 'not-available'];\n   374\t\n   375\t/**\n   376\t * Pair the summarized runs by block and compare B (candidate) with A (baseline) on every metric.\n   377\t * Only blocks in which both runs are \"ok\" and admitted are paired; the rest are counted, and they gate the speed\n   378\t * verdicts:\n   379\t *   - when any timed run failed, every timing is survivor-only and is labelled conditional;\n   380\t *   - when the candidate failed more runs than the baseline, no metric may be called \"better\" for it: a\n   381\t *     configuration that times out on most runs and is fast on the rest has not been shown to be faster;\n   382\t *   - when the candidate had more adverse runs (any frame over the threshold, `adverse` below) than the baseline,\n   383\t *     \"better\" is blocked as well: a median count of late frames hides runs that stalled.\n   384\t */\n   385\texport function analyze(workload, runs, { noise = null, bootstrapSeed = DEFAULT_BOOTSTRAP_SEED, zeroOnly = false } = {}) {\n   386\t  checkSeed(bootstrapSeed, 'bootstrap seed');\n   387\t  const blocks = new Map();\n   388\t  for (const r of runs) {\n   389\t    if (r.phase !== 'timed') continue;\n   390\t    if (!blocks.has(r.block)) blocks.set(r.block, {});\n   391\t    blocks.get(r.block)[r.config] = r;\n   392\t  }\n   393\t  const orderOf = b => (b.A && b.B ? (b.A.position === 0 ? 'AB' : 'BA') : null);\n   394\t  const complete = [...blocks.values()].filter(b => b.A?.outcome === 'ok' && b.B?.outcome === 'ok');\n   395\t  const outcomes = {};\n   396\t  const timed = { A: 0, B: 0 }, failed = { A: 0, B: 0 };\n   397\t  for (const r of runs) {\n   398\t    if (r.phase !== 'timed') continue;\n   399\t    outcomes[`${r.config}:${r.outcome}`] = (outcomes[`${r.config}:${r.outcome}`] ?? 0) + 1;\n   400\t    timed[r.config]++;\n   401\t    if (r.outcome !== 'ok') failed[r.config]++;\n   402\t  }\n   403\t  // Adverse runs: any late frame interval in the window (P3's second number is a count that must be 0).\n   404\t  const adverseKey = workload === 'stream' ? 'lateFrames' : (workload === 'resize' || workload === 'zoom') ? 'framesOverThreshold' : null;\n   405\t  const adverse = { A: 0, B: 0 };\n   406\t  if (adverseKey) for (const r of runs) if (r.phase === 'timed' && r.outcome === 'ok' && typeof r.summary?.[adverseKey] === 'number' && r.summary[adverseKey] > 0) adverse[r.config]++;\n   407\t  const reliability = {\n   408\t    timed, failed,\n   409\t    failureRate: { A: timed.A ? failed.A / timed.A : NaN, B: timed.B ? failed.B / timed.B : NaN },\n   410\t    adverseKey, adverse,\n   411\t    conditional: failed.A + failed.B > 0,\n   412\t    betterBlocked: failed.B > failed.A ? `the candidate failed ${failed.B} of ${timed.B} timed runs, the baseline ${failed.A} of ${timed.A}`\n   413\t      : adverse.B > adverse.A ? `the candidate had ${adverse.B} runs with ${adverseKey} > 0, the baseline ${adverse.A}` : null,\n   414\t  };\n   415\t  const metrics = {};\n   416\t  for (const m of METRICS[workload]) {\n   417\t    const pairs = complete.filter(b => typeof b.A.summary[m.key] === 'number' && typeof b.B.summary[m.key] === 'number' && Number.isFinite(b.A.summary[m.key]) && Number.isFinite(b.B.summary[m.key]));\n   418\t    const a = pairs.map(b => b.A.summary[m.key]), b = pairs.map(p => p.B.summary[m.key]);\n   419\t    if (!pairs.length) {\n   420\t      const reason = complete.map(p => p.A.summary[m.key]?.na ?? p.B.summary[m.key]?.na).find(Boolean) ?? 'no complete pair';\n   421\t      metrics[m.key] = { ...m, na: reason.startsWith('not available') ? reason : `not available: ${reason}` };\n   422\t      continue;\n   423\t    }\n   424\t    const strata = pairs.map(orderOf);\n   425\t    const ci = pairedBootstrap(a, b, { seed: bootstrapSeed, strata: strata.every(Boolean) ? strata : null });\n   426\t    const band = noise?.metrics?.[m.key];\n   427\t    const bandUsable = !zeroOnly && band && Number.isFinite(band.lo) && Number.isFinite(band.hi) ? { lo: band.lo, hi: band.hi } : null;\n   428\t    // Per-order estimates make differential carry-over visible: with no carry-over, AB and BA blocks estimate the\n   429\t    // same difference.\n   430\t    const byOrder = {};\n   431\t    for (const o of ['AB', 'BA']) {\n   432\t      const idx = strata.map((s, i) => (s === o ? i : -1)).filter(i => i >= 0);\n   433\t      byOrder[o] = idx.length ? { pairs: idx.length, diff: median(idx.map(i => b[i])) - median(idx.map(i => a[i])) } : { pairs: 0, diff: NaN };\n   434\t    }\n   435\t    let outcome = pairs.length >= MIN_PAIRS ? classify(ci, bandUsable) : 'inconclusive';\n   436\t    const notes = [];\n   437\t    if (pairs.length < MIN_PAIRS) notes.push(`inconclusive by rule: ${pairs.length} complete pairs, fewer than ${MIN_PAIRS}`);\n   438\t    if (outcome === 'better' && reliability.betterBlocked) { outcome = 'inconclusive'; notes.push(`\"better\" blocked: ${reliability.betterBlocked}`); }\n   439\t    metrics[m.key] = {\n   440\t      ...m, pairs: pairs.length,\n   441\t      medianA: median(a), medianB: median(b),\n   442\t      diff: ci.estimate, lo: ci.lo, hi: ci.hi, ...(ci.note ? { note: ci.note } : {}),\n   443\t      relative: median(a) ? ci.estimate / median(a) : null,\n   444\t      blockDiffs: pairs.map((p, i) => b[i] - a[i]),\n   445\t      byOrder,\n   446\t      noiseBand: zeroOnly ? 'zero-only analysis (explicitly requested): no noise band'\n   447\t        : bandUsable ?? (noise ? 'not available: metric missing in the noise run' : 'not available: no A-versus-A run given (--noise)'),\n   448\t      outcome,\n   449\t      ...(reliability.conditional ? { conditional: `survivor-only: ${failed.A} baseline and ${failed.B} candidate timed runs failed and are not in this timing` } : {}),\n   450\t      ...(notes.length ? { outcomeNote: notes.join('; ') } : {}),\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_24","type":"command_execution","command":"/bin/bash -lc \"nl -ba bench/src/stats.js | sed -n '1,205p'\"","aggregated_output":"     1\t// Statistics for the runner (plan 3.3). Pure, runs in Node.\n     2\t// Unit of analysis: the run. Every per-frame or per-sample series is reduced to one number per run first.\n     3\timport { rng } from './fixtures.js';\n     4\t\n     5\texport function quantile(values, p) {\n     6\t  const s = Float64Array.from(values).sort();\n     7\t  if (!s.length) return NaN;\n     8\t  const h = (s.length - 1) * p, lo = Math.floor(h), hi = Math.ceil(h);\n     9\t  return s[lo] + (s[hi] - s[lo]) * (h - lo);\n    10\t}\n    11\texport const median = v => quantile(v, 0.5);\n    12\t\n    13\t/**\n    14\t * Seeds are recorded so a run can be replayed exactly; a seed that the generator would silently coerce (a string,\n    15\t * a fraction, a negative number, NaN) would make the record lie about how it was produced, so it is an error.\n    16\t */\n    17\texport function checkSeed(seed, what = 'seed') {\n    18\t  if (!Number.isInteger(seed) || seed < 0 || seed > 0xffffffff) throw new Error(`${what} must be an integer from 0 to 4294967295, got ${JSON.stringify(seed)}`);\n    19\t  return seed;\n    20\t}\n    21\t/** Parses a seed given on the command line; \"12abc\", \"1.5\" and \"\" are errors, not 12, 1 and 0. */\n    22\texport function parseSeed(text, what = 'seed') {\n    23\t  if (typeof text !== 'string' || !/^\\d+$/.test(text)) throw new Error(`${what} must be an integer from 0 to 4294967295, got ${JSON.stringify(text)}`);\n    24\t  return checkSeed(Number(text), what);\n    25\t}\n    26\t\n    27\texport const DEFAULT_BOOTSTRAP_SEED = 12345;\n    28\t\n    29\t/** n blocks, half AB and half BA, in a seeded random order. */\n    30\texport function balancedOrder(blocks, seed) {\n    31\t  if (!Number.isInteger(blocks) || blocks < 2 || blocks % 2) throw new Error(`blocks must be an even number >= 2 (as many AB as BA), got ${blocks}`);\n    32\t  checkSeed(seed, 'order seed');\n    33\t  const order = [...Array(blocks / 2).fill('AB'), ...Array(blocks / 2).fill('BA')];\n    34\t  const r = rng(seed);\n    35\t  for (let i = order.length - 1; i > 0; i--) { const j = Math.floor(r() * (i + 1)); [order[i], order[j]] = [order[j], order[i]]; }\n    36\t  return order;\n    37\t}\n    38\t\n    39\t/**\n    40\t * Paired bootstrap over blocks: resample whole blocks (keeping each A with its B), and take\n    41\t * median(B) - median(A) of each resample. Percentile 95% interval.\n    42\t *\n    43\t * The estimand is the difference of the two configurations' medians (plan 3.3: \"median of per-run values with a\n    44\t * paired bootstrap interval for the difference\"), not the median of the paired differences; the two differ on\n    45\t * skewed data and the tests pin which one this is.\n    46\t *\n    47\t * With `strata` (one label per pair, here the block order AB or BA), each resample draws from every stratum as many\n    48\t * pairs as it has, so the balance the design fixed (as many AB as BA) is kept in every resample instead of being\n    49\t * left to chance.\n    50\t */\n    51\texport function pairedBootstrap(a, b, { iterations = 10000, seed = DEFAULT_BOOTSTRAP_SEED, strata = null } = {}) {\n    52\t  const n = a.length;\n    53\t  if (n !== b.length) throw new Error('paired samples must have equal length');\n    54\t  checkSeed(seed, 'bootstrap seed');\n    55\t  if (n < 2) return { n, estimate: n ? b[0] - a[0] : NaN, lo: NaN, hi: NaN, note: 'not available: fewer than 2 complete pairs' };\n    56\t  const groups = [];\n    57\t  if (strata) {\n    58\t    if (strata.length !== n) throw new Error('one stratum label per pair');\n    59\t    const by = new Map();\n    60\t    strata.forEach((s, i) => { if (!by.has(s)) by.set(s, []); by.get(s).push(i); });\n    61\t    for (const key of [...by.keys()].sort()) groups.push(by.get(key));\n    62\t  } else groups.push(Array.from({ length: n }, (_, i) => i));\n    63\t  const r = rng(seed);\n    64\t  const diffs = new Float64Array(iterations);\n    65\t  const ra = new Float64Array(n), rb = new Float64Array(n);\n    66\t  for (let it = 0; it < iterations; it++) {\n    67\t    let k = 0;\n    68\t    for (const g of groups) for (let j = 0; j < g.length; j++) { const i = g[Math.floor(r() * g.length)]; ra[k] = a[i]; rb[k] = b[i]; k++; }\n    69\t    diffs[it] = median(rb) - median(ra);\n    70\t  }\n    71\t  return { n, estimate: median(b) - median(a), lo: quantile(diffs, 0.025), hi: quantile(diffs, 0.975), stratified: !!strata };\n    72\t}\n    73\t\n    74\t/**\n    75\t * Three outcomes for \"lower is better\" metrics. With a noise band (the A-versus-A interval for the same workload),\n    76\t * the interval must clear the band as well as zero.\n    77\t */\n    78\texport function classify(ci, band) {\n    79\t  if (!Number.isFinite(ci.lo) || !Number.isFinite(ci.hi)) return 'inconclusive';\n    80\t  const lo = band ? Math.min(0, band.lo) : 0, hi = band ? Math.max(0, band.hi) : 0;\n    81\t  if (ci.hi < lo) return 'better';\n    82\t  if (ci.lo > hi) return 'worse';\n    83\t  return 'inconclusive';\n    84\t}\n    85\t\n    86\t/**\n    87\t * Below this many complete pairs an interval is still reported, but the outcome is always \"inconclusive\".\n    88\t * Plan 3.3: \"Sample sizes are set from a pilot in M0 ... Until then: 20 runs for full comparisons\", i.e. 20 runs of\n    89\t * each configuration, which in balanced blocks is 20 complete pairs. With six pairs the percentile bootstrap gave a\n    90\t * confident verdict in the wrong direction about one time in ten on a discrete metric (review finding 11;\n    91\t * `node bench/tools/coverage.mjs` measures it), so a verdict waits for the plan's sample size.\n    92\t */\n    93\texport const MIN_PAIRS = 20;\n    94\t/** An A-versus-A record gives a usable band only with at least this many complete pairs. */\n    95\texport const MIN_BAND_PAIRS = MIN_PAIRS;\n    96\t/** Plan 3.3: the noise band comes from repeated blocks across at least three sessions. */\n    97\texport const MIN_BAND_SESSIONS = 3;\n    98\t\n    99\tconst NA = reason => ({ na: `not available: ${reason}` });\n   100\t\n   101\t/** Metric definitions per workload. Every metric: lower is better. `primary` marks the workload's primary metric. */\n   102\tconst CREATE = [\n   103\t  { key: 'taskMs', unit: 'ms', primary: true, what: 'main-thread TaskDuration from the create call to settle window end' },\n   104\t  { key: 'scriptMs', unit: 'ms', what: 'ScriptDuration in the same window' },\n   105\t  { key: 'layoutStyleMs', unit: 'ms', what: 'LayoutDuration + RecalcStyleDuration in the same window' },\n   106\t  { key: 'readyMs', unit: 'ms', what: 'wall clock from create call to the adapter\\'s ready signal' },\n   107\t  { key: 'readyFrameMs', unit: 'ms', what: 'wall clock to the first animation frame after ready' },\n   108\t  { key: 'rendererCpuMs', unit: 'ms', what: 'CPU time of the page renderer process, all threads, same window (SystemInfo.getProcessInfo)' },\n   109\t  { key: 'gpuCpuMs', unit: 'ms', what: 'CPU time of the GPU process, same window' },\n   110\t  { key: 'heapChartBytes', unit: 'bytes', what: 'JS heap after forced GC with the chart, minus the same with only the input data' },\n   111\t  { key: 'heapUsedBytes', unit: 'bytes', what: 'JS heap after forced GC with the chart (absolute)' },\n   112\t  { key: 'rendererPssBytes', unit: 'bytes', what: 'page renderer process PSS with the chart (Linux /proc, after GC)' },\n   113\t  { key: 'rendererPssChartBytes', unit: 'bytes', what: 'page renderer PSS with the chart minus with only the input data' },\n   114\t  { key: 'gpuPssBytes', unit: 'bytes', what: 'GPU process PSS with the chart' },\n   115\t  { key: 'gpuPssChartBytes', unit: 'bytes', what: 'GPU process PSS with the chart minus with only the input data' },\n   116\t  { key: 'canvasBackingBytes', unit: 'bytes', what: 'CALCULATED: sum of canvas.width x canvas.height x 4 over the chart canvases' },\n   117\t  { key: 'domNodes', unit: 'nodes', what: 'elements inside the chart containers' },\n   118\t];\n   119\tconst FRAMES = [\n   120\t  { key: 'frameP95Ms', unit: 'ms', what: '95th percentile animation-frame interval in the window (boundary-spanning intervals included)' },\n   121\t  { key: 'frameP99Ms', unit: 'ms', what: '99th percentile animation-frame interval' },\n   122\t  { key: 'framesOverThreshold', unit: 'frames', what: 'frame intervals over 1.5x the observed refresh interval (25 ms at 60 Hz)' },\n   123\t  { key: 'frameMaxMs', unit: 'ms', what: 'largest frame interval' },\n   124\t];\n   125\texport const METRICS = {\n   126\t  first: CREATE,\n   127\t  page: CREATE,\n   128\t  compact: CREATE,\n   129\t  scatter: CREATE,\n   130\t  theme: [\n   131\t    { key: 'taskMsPerToggle', unit: 'ms', primary: true, what: 'median over toggles of TaskDuration from the class toggle to 3 frames + 50 ms later (no counters, no pixel reads in timed runs)' },\n   132\t    { key: 'taskMsToggleMax', unit: 'ms', what: 'largest per-toggle TaskDuration' },\n   133\t  ],\n   134\t  resize: [\n   135\t    { key: 'taskMs', unit: 'ms', primary: true, what: 'TaskDuration over the fixed width sequence and until the charts report ready' },\n   136\t    ...FRAMES,\n   137\t    { key: 'rendererCpuMs', unit: 'ms', what: 'page renderer process CPU time, all threads, same window' },\n   138\t    { key: 'gpuCpuMs', unit: 'ms', what: 'GPU process CPU time, same window' },\n   139\t  ],\n   140\t  stream: [\n   141\t    // P3, as plan 3.1 defines it: \"Main-thread task time divided by updates\", one number per run; the budget's\n   142\t    // \"median\" is then the median of those per-run numbers over runs. It is not the median of individual updates'\n   143\t    // costs, which TaskDuration cannot separate (see README, \"P3\").\n   144\t    { key: 'taskMsPerUpdate', unit: 'ms', primary: true, what: 'P3: main-thread TaskDuration from stream start to last sample visible, divided by samples (per run)' },\n   145\t    { key: 'lateFrames', unit: 'frames', what: 'P3: frame intervals over 25 ms (1.5x refresh) among the 300 intervals that start at the first sample\\'s due time' },\n   146\t    { key: 'delayP50Ms', unit: 'ms', what: 'median per-sample delay, scheduled time to the frame callback whose drawn state includes it' },\n   147\t    { key: 'delayP95Ms', unit: 'ms', what: '95th percentile of that delay' },\n   148\t    { key: 'delayMaxMs', unit: 'ms', what: 'largest delay' },\n   149\t    { key: 'maxBacklog', unit: 'samples', what: 'largest number of due samples not yet shown after a frame' },\n   150\t    { key: 'coalesced', unit: 'samples', what: 'samples first shown in the same frame as a later sample' },\n   151\t    { key: 'frameP95Ms', unit: 'ms', what: '95th percentile of the same 300 frame intervals' },\n   152\t    { key: 'frameP99Ms', unit: 'ms', what: '99th percentile of the same 300 frame intervals' },\n   153\t    { key: 'createTaskMs', unit: 'ms', what: 'TaskDuration to create the initial window and settle' },\n   154\t  ],\n   155\t  hover: [\n   156\t    { key: 'inputToReadoutP95Ms', unit: 'ms', primary: true, what: 'P4: 95th percentile over moves of pointermove event.timeStamp to the frame callback whose readout shows the hovered datum' },\n   157\t    { key: 'inputToReadoutP50Ms', unit: 'ms', what: 'median of the same' },\n   158\t    { key: 'inputToReadoutMaxMs', unit: 'ms', what: 'largest of the same' },\n   159\t    { key: 'taskMsPerMove', unit: 'ms', what: 'TaskDuration over the moves divided by moves' },\n   160\t  ],\n   161\t  zoom: [\n   162\t    { key: 'taskMsPerStep', unit: 'ms', primary: true, what: 'TaskDuration over the zoom/pan sequence divided by steps' },\n   163\t    { key: 'stepToFrameP95Ms', unit: 'ms', what: '95th percentile over steps of chart.zoom() call to the frame callback after the chart reports the step drawn' },\n   164\t    ...FRAMES,\n   165\t  ],\n   166\t  mem: [\n   167\t    { key: 'ownedBytes', unit: 'bytes', primary: true, what: 'P7: (JS heap used + ArrayBuffer backing storage) after forced GC with the chart, minus with only the caller\\'s columns' },\n   168\t    { key: 'ownedRatio', unit: 'x', what: 'P7: ownedBytes / bytes of the caller\\'s columns (budget: at most 1)' },\n   169\t    { key: 'heapChartBytes', unit: 'bytes', what: 'JS heap used only (no ArrayBuffer backing), chart minus data' },\n   170\t    { key: 'canvasBackingBytes', unit: 'bytes', what: 'CALCULATED canvas backing stores (not Axylo JS memory, reported separately)' },\n   171\t    { key: 'rendererPssChartBytes', unit: 'bytes', what: 'page renderer PSS, chart minus data' },\n   172\t  ],\n   173\t  lifecycle: [\n   174\t    { key: 'heapSlopeBytesPerCycle', unit: 'bytes', primary: true, what: 'P7: least-squares slope of (heap used + backing storage) after forced GC over the checkpoints, per create-destroy cycle' },\n   175\t    { key: 'listenersAfter', unit: 'listeners', what: 'JS event listeners on the page after the last cycle minus before the first' },\n   176\t    { key: 'nodesAfter', unit: 'nodes', what: 'DOM nodes after the last cycle minus before the first' },\n   177\t  ],\n   178\t};\n   179\t\n   180\tconst ms = (deltas, from, to, name) => {\n   181\t  const d = deltas?.[`${from}->${to}`];\n   182\t  return d && Number.isFinite(d[name]) ? d[name] * 1000 : NaN;\n   183\t};\n   184\t\n   185\tconst cpuMs = (deltas, from, to, name) => {\n   186\t  const d = deltas?.[`${from}->${to}`];\n   187\t  return d && Number.isFinite(d[name]) ? d[name] * 1000 : NA(`${name} not sampled (process not identified)`);\n   188\t};\n   189\t\n   190\t/**\n   191\t * Frame intervals that overlap a window [from, to]: every pair of consecutive frame timestamps (f[i], f[i+1]) with\n   192\t * f[i+1] > from and f[i] < to. An interval that starts before the window and ends inside it, or starts inside and\n   193\t * ends after it, is counted: a 150 ms stall that straddles the end of a resize is a stall during the resize.\n   194\t */\n   195\texport function intervalsOverlapping(frames, from, to) {\n   196\t  const out = [];\n   197\t  for (let i = 0; i + 1 < frames.length; i++) if (frames[i + 1] > from && frames[i] < to) out.push(frames[i + 1] - frames[i]);\n   198\t  return out;\n   199\t}\n   200\t\n   201\t/**\n   202\t * P3's lateness window: exactly `count` consecutive frame intervals, starting with the interval in which the first\n   203\t * sample falls due (the last frame at or before that time, to the next). 300 samples at 60 Hz give 300 intervals.\n   204\t * Returns null when the frame log does not reach that far (the run then fails; see streamCompletion).\n   205\t */\n","exit_code":0,"status":"completed"}}
