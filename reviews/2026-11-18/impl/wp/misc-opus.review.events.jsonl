t\":7.668589363601408,\"near\":{\"normal\":{\"d\":0.22121134818038482,\"k\":5},\"protan\":{\"d\":0.10288682967459656,\"k\":4},\"deutan\":{\"d\":0.10342484082944123,\"k\":6},\"tritan\":{\"d\":0.14070167514731943,\"k\":5}}},{\"hex\":\"#7314a2\",\"contrast\":8.933292941122394,\"near\":{\"normal\":{\"d\":0.15730464115949208,\"k\":6},\"protan\":{\"d\":0.11632247003431513,\"k\":6},\"deutan\":{\"d\":0.12378389102057039,\"k\":5},\"tritan\":{\"d\":0.14619810360201455,\"k\":6}}},{\"hex\":\"#bd585e\",\"contrast\":4.447943290218555,\"near\":{\"normal\":{\"d\":0.12403133773502072,\"k\":6},\"protan\":{\"d\":0.10288682967459656,\"k\":2},\"deutan\":{\"d\":0.10460325567476732,\"k\":7},\"tritan\":{\"d\":0.10226646510912671,\"k\":1}}},{\"hex\":\"#007baa\",\"contrast\":4.757978123328932,\"near\":{\"normal\":{\"d\":0.12427101693754324,\"k\":0},\"protan\":{\"d\":0.10318692406359829,\"k\":7},\"deutan\":{\"d\":0.10985653634711562,\"k\":6},\"tritan\":{\"d\":0.10258628313472082,\"k\":0}}},{\"hex\":\"#a52265\",\"contrast\":6.96149227436635,\"near\":{\"normal\":{\"d\":0.12403133773502072,\"k\":4},\"protan\":{\"d\":0.11632247003431513,\"k\":3},\"deutan\":{\"d\":0.10342484082944123,\"k\":2},\"tritan\":{\"d\":0.10240709294308144,\"k\":4}}},{\"hex\":\"#9293a5\",\"contrast\":3.0263690463654145,\"near\":{\"normal\":{\"d\":0.12748633199010334,\"k\":0},\"protan\":{\"d\":0.10318692406359829,\"k\":5},\"deutan\":{\"d\":0.10460325567476732,\"k\":4},\"tritan\":{\"d\":0.10439966740445608,\"k\":0}}}],\"dark\":[{\"hex\":\"#64acfa\",\"contrast\":7.461502200598849,\"near\":{\"normal\":{\"d\":0.12108340567292972,\"k\":5},\"protan\":{\"d\":0.10369787001201432,\"k\":6},\"deutan\":{\"d\":0.1203099294687363,\"k\":5},\"tritan\":{\"d\":0.10465528307544883,\"k\":5}}},{\"hex\":\"#de7b2e\",\"contrast\":5.901476250575865,\"near\":{\"normal\":{\"d\":0.11640297324086475,\"k\":4},\"protan\":{\"d\":0.12565853501024668,\"k\":4},\"deutan\":{\"d\":0.10851524227100656,\"k\":4},\"tritan\":{\"d\":0.10336581315002484,\"k\":4}}},{\"hex\":\"#b2e390\",\"contrast\":12.078844354691377,\"near\":{\"normal\":{\"d\":0.1684996483690385,\"k\":5},\"protan\":{\"d\":0.16173180855442817,\"k\":5},\"deutan\":{\"d\":0.1030613222217593,\"k\":6},\"tritan\":{\"d\":0.10423004146970927,\"k\":5}}},{\"hex\":\"#9149b9\",\"contrast\":3.262148117882509,\"near\":{\"normal\":{\"d\":0.16306592811125523,\"k\":7},\"protan\":{\"d\":0.1509038542684061,\"k\":7},\"deutan\":{\"d\":0.11578458186483272,\"k\":7},\"tritan\":{\"d\":0.10233015799351262,\"k\":7}}},{\"hex\":\"#c3513d\",\"contrast\":3.860243968237342,\"near\":{\"normal\":{\"d\":0.11640297324086475,\"k\":1},\"protan\":{\"d\":0.12565853501024668,\"k\":1},\"deutan\":{\"d\":0.10851524227100656,\"k\":1},\"tritan\":{\"d\":0.10336581315002484,\"k\":1}}},{\"hex\":\"#71d8ff\",\"contrast\":10.966917912201694,\"near\":{\"normal\":{\"d\":0.12108340567292972,\"k\":0},\"protan\":{\"d\":0.12391836134497318,\"k\":0},\"deutan\":{\"d\":0.1030060520570615,\"k\":6},\"tritan\":{\"d\":0.10423004146970927,\"k\":2}}},{\"hex\":\"#f898b5\",\"contrast\":8.583290186707812,\"near\":{\"normal\":{\"d\":0.16241613396995183,\"k\":1},\"protan\":{\"d\":0.10369787001201432,\"k\":0},\"deutan\":{\"d\":0.1030060520570615,\"k\":5},\"tritan\":{\"d\":0.10449570181113116,\"k\":1}}},{\"hex\":\"#7a7f93\",\"contrast\":4.468952581604853,\"near\":{\"normal\":{\"d\":0.16306592811125523,\"k\":3},\"protan\":{\"d\":0.13314373182545244,\"k\":4},\"deutan\":{\"d\":0.11578458186483272,\"k\":3},\"tritan\":{\"d\":0.10233015799351262,\"k\":3}}}]};\n    29\tconst VISION_ROWS = [['normal', ''], ['protanopia', 'url(#f-protan)'], ['deuteranopia', 'url(#f-deutan)'], ['tritanopia', 'url(#f-tritan)'], ['grayscale', 'url(#f-gray)']];\n    30\tfunction rng(seed) { let s = seed >>> 0; return () => { s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n    31\tconst W = 190, H = 120, P = 8;\n    32\tconst svg = (body, t) => '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"' + W + '\" height=\"' + H + '\" xmlns=\"http://www.w3.org/2000/svg\">'\n    33\t  + '<rect width=\"' + W + '\" height=\"' + H + '\" fill=\"' + t.background + '\"/>'\n    34\t  + [0.25, 0.5, 0.75].map(f => '<line x1=\"' + P + '\" x2=\"' + (W - P) + '\" y1=\"' + (P + f * (H - 2 * P)) + '\" y2=\"' + (P + f * (H - 2 * P)) + '\" stroke=\"' + t.grid + '\" stroke-width=\"1\"/>').join('')\n    35\t  + '<line x1=\"' + P + '\" x2=\"' + (W - P) + '\" y1=\"' + (H - P + 0.5) + '\" y2=\"' + (H - P + 0.5) + '\" stroke=\"' + t.axis + '\" stroke-width=\"1\"/>'\n    36\t  + body + '</svg>';\n    37\tconst SHAPES = ['circle', 'square', 'triangle', 'diamond', 'cross', 'plus', 'triangle-down', 'star'];\n    38\tfunction marker(shape, x, y, c, bg) {\n    39\t  const r = 3.2, s = 'fill=\"' + c + '\" stroke=\"' + bg + '\" stroke-width=\"1\"';\n    40\t  switch (shape) {\n    41\t    case 'circle': return '<circle cx=\"' + x + '\" cy=\"' + y + '\" r=\"' + r + '\" ' + s + '/>';\n    42\t    case 'square': return '<rect x=\"' + (x - r) + '\" y=\"' + (y - r) + '\" width=\"' + 2 * r + '\" height=\"' + 2 * r + '\" ' + s + '/>';\n    43\t    case 'triangle': return '<path d=\"M' + x + ' ' + (y - r - 0.6) + 'L' + (x + r + 0.4) + ' ' + (y + r) + 'L' + (x - r - 0.4) + ' ' + (y + r) + 'Z\" ' + s + '/>';\n    44\t    case 'triangle-down': return '<path d=\"M' + x + ' ' + (y + r + 0.6) + 'L' + (x + r + 0.4) + ' ' + (y - r) + 'L' + (x - r - 0.4) + ' ' + (y - r) + 'Z\" ' + s + '/>';\n    45\t    case 'diamond': return '<path d=\"M' + x + ' ' + (y - r - 1) + 'L' + (x + r + 1) + ' ' + y + 'L' + x + ' ' + (y + r + 1) + 'L' + (x - r - 1) + ' ' + y + 'Z\" ' + s + '/>';\n    46\t    case 'cross': return '<path d=\"M' + (x - r) + ' ' + (y - r) + 'L' + (x + r) + ' ' + (y + r) + 'M' + (x + r) + ' ' + (y - r) + 'L' + (x - r) + ' ' + (y + r) + '\" stroke=\"' + c + '\" stroke-width=\"2\"/>';\n    47\t    case 'plus': return '<path d=\"M' + x + ' ' + (y - r - 0.5) + 'V' + (y + r + 0.5) + 'M' + (x - r - 0.5) + ' ' + y + 'H' + (x + r + 0.5) + '\" stroke=\"' + c + '\" stroke-width=\"2\"/>';\n    48\t    default: { let d = ''; for (let i = 0; i < 10; i++) { const a = -Math.PI / 2 + i * Math.PI / 5, rr = i % 2 ? r * 0.5 : r + 1; d += (i ? 'L' : 'M') + (x + rr * Math.cos(a)).toFixed(2) + ' ' + (y + rr * Math.sin(a)).toFixed(2); } return '<path d=\"' + d + 'Z\" ' + s + '/>'; }\n    49\t  }\n    50\t}\n    51\tfunction walks(n, len, seed) {\n    52\t  const r = rng(seed); const out = [];\n    53\t  for (let s = 0; s < n; s++) { let v = 0.2 + 0.6 * r(); const pts = []; for (let i = 0; i < len; i++) { v += (r() - 0.5) * 0.12; v = Math.min(0.95, Math.max(0.05, v)); pts.push(v); } out.push(pts); }\n    54\t  return out;\n    55\t}\n    56\tfunction lines(n, t, cols) {\n    57\t  const data = walks(n, 40, 11 + n), X = i => P + i * (W - 2 * P - 6) / 39, Y = v => P + (1 - v) * (H - 2 * P);\n    58\t  return svg(data.map((pts, s) => '<path d=\"' + pts.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + '\" fill=\"none\" stroke=\"' + cols[s] + '\" stroke-width=\"2\" stroke-linejoin=\"round\"/>'\n    59\t    + marker(SHAPES[s], X(39), Y(pts[39]), cols[s], t.background)).join(''), t);\n    60\t}\n    61\tfunction overlap(t, cols) {\n    62\t  const data = walks(3, 30, 5), X = i => P + i * (W - 2 * P) / 29, Y = v => P + (1 - v) * (H - 2 * P);\n    63\t  return svg(data.map((pts, s) => '<path d=\"M' + X(0) + ' ' + Y(0) + pts.map((v, i) => 'L' + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + 'L' + X(29) + ' ' + Y(0) + 'Z\" fill=\"' + cols[s] + '\" fill-opacity=\"0.25\"/>'\n    64\t    + '<path d=\"' + pts.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + '\" fill=\"none\" stroke=\"' + cols[s] + '\" stroke-width=\"2\"/>').join(''), t);\n    65\t}\n    66\tfunction stacked(t, cols) {\n    67\t  const n = 8, len = 30, r = rng(3), vals = [];\n    68\t  for (let s = 0; s < n; s++) { let v = 0.5 + r(); const a = []; for (let i = 0; i < len; i++) { v = Math.max(0.2, v + (r() - 0.5) * 0.3); a.push(v); } vals.push(a); }\n    69\t  const tot = Array.from({ length: len }, (_, i) => vals.reduce((a, s) => a + s[i], 0)), max = Math.max(...tot) * 1.05;\n    70\t  const X = i => P + i * (W - 2 * P) / (len - 1), Y = v => P + (1 - v / max) * (H - 2 * P);\n    71\t  let lower = Array(len).fill(0), out = '';\n    72\t  for (let s = 0; s < n; s++) {\n    73\t    const upper = lower.map((l, i) => l + vals[s][i]);\n    74\t    out += '<path d=\"' + upper.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + lower.map((v, i) => 'L' + X(len - 1 - i).toFixed(1) + ' ' + Y(lower[len - 1 - i]).toFixed(1)).join('') + 'Z\" fill=\"' + cols[s] + '\" fill-opacity=\"0.8\"/>';\n    75\t    out += '<path d=\"' + upper.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + '\" fill=\"none\" stroke=\"' + t.background + '\" stroke-width=\"1\"/>';\n    76\t    lower = upper;\n    77\t  }\n    78\t  return svg(out, t);\n    79\t}\n    80\tfunction donut(t, cols) {\n    81\t  const v = [30, 22, 16, 12, 9, 7, 6, 5], tot = v.reduce((a, b) => a + b, 0), cx = W / 2, cy = H / 2, R = 52, r0 = 31;\n    82\t  let a = -Math.PI / 2, out = '';\n    83\t  v.forEach((x, i) => {\n    84\t    const b = a + 2 * Math.PI * x / tot, large = b - a > Math.PI ? 1 : 0, p = (rr, t) => (cx + rr * Math.cos(t)).toFixed(2) + ' ' + (cy + rr * Math.sin(t)).toFixed(2);\n    85\t    out += '<path d=\"M' + p(R, a) + 'A' + R + ' ' + R + ' 0 ' + large + ' 1 ' + p(R, b) + 'L' + p(r0, b) + 'A' + r0 + ' ' + r0 + ' 0 ' + large + ' 0 ' + p(r0, a) + 'Z\" fill=\"' + cols[i] + '\" stroke=\"' + t.background + '\" stroke-width=\"1\"/>';\n    86\t    a = b;\n    87\t  });\n    88\t  return '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"' + W + '\" height=\"' + H + '\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"' + W + '\" height=\"' + H + '\" fill=\"' + t.background + '\"/>' + out + '</svg>';\n    89\t}\n    90\tfunction bars(t, cols) {\n    91\t  const r = rng(9), groups = 3, n = 6, gw = (W - 2 * P) / groups, bw = (gw - 10) / n;\n    92\t  let out = '';\n    93\t  for (let g = 0; g < groups; g++) for (let s = 0; s < n; s++) { const h = (0.3 + 0.65 * r()) * (H - 2 * P); out += '<rect x=\"' + (P + g * gw + 5 + s * bw).toFixed(1) + '\" y=\"' + (H - P - h).toFixed(1) + '\" width=\"' + (bw - 1).toFixed(1) + '\" height=\"' + h.toFixed(1) + '\" fill=\"' + cols[s] + '\"/>'; }\n    94\t  return svg(out, t);\n    95\t}\n    96\tconst fmt = x => x.toFixed(3);\n    97\tconst root = document.getElementById('root');\n    98\tfor (const scheme of (new URLSearchParams(location.search).get('scheme') || 'light,dark').split(',')) {\n    99\t  const t = THEME[scheme], cols = PALETTE[scheme], st = STATS[scheme];\n   100\t  const ink = scheme === 'light' ? '#1d2129' : '#e6e8ec';\n   101\t  const el = document.createElement('section'); el.className = 'scheme'; el.id = scheme;\n   102\t  el.style.background = t.background; el.style.color = ink;\n   103\t  el.innerHTML = '<h1>' + scheme + ' scheme, background ' + t.background + '</h1>'\n   104\t    + '<div class=\"swatches\">' + st.map((s, i) => '<div class=\"sw\"><div class=\"chip\" style=\"background:' + s.hex + '\"></div><code>' + (i + 1) + ' ' + s.hex + '</code>'\n   105\t      + '<span class=\"meta\">' + s.contrast.toFixed(2) + ':1 · nearest ' + fmt(s.near.normal.d) + ' (' + (s.near.normal.k + 1) + ')</span>'\n   106\t      + '<span class=\"meta\">worst CVD ' + fmt(Math.min(s.near.protan.d, s.near.deutan.d, s.near.tritan.d)) + '</span></div>').join('') + '</div>'\n   107\t    + '<div class=\"heads\"><span></span><span>3 lines, 2 px</span><span>5 lines</span><span>8 lines</span><span>3 areas, 25%</span><span>8 stacked, 80%</span><span>donut, 8 slices</span><span>grouped bars, 6</span></div>';\n   108\t  for (const [label, filter] of VISION_ROWS) {\n   109\t    const row = document.createElement('div'); row.className = 'row';\n   110\t    row.innerHTML = '<span class=\"label\">' + label + '</span>' + [lines(3, t, cols), lines(5, t, cols), lines(8, t, cols), overlap(t, cols), stacked(t, cols), donut(t, cols), bars(t, cols)].map(s => '<div class=\"cell\" style=\"filter:' + (filter || 'none') + '\">' + s + '</div>').join('');\n   111\t    el.appendChild(row);\n   112\t  }\n   113\t  root.appendChild(el);\n   114\t}\n   115\t</script></body></html>\n   285\t    });\n   286\t\n   287\t    it(`${name}: the 2 px stroke record describes these colors and is internally consistent`, () => {\n   288\t      const s = record.strokes.schemes[name];\n   289\t      expect(s.background).toBe(scheme.background);\n   290\t      expect(s.rows.map(row => row.color)).toEqual([...series]);\n   291\t      for (const row of s.rows) {\n   292\t        expect(atPrecision(contrastRatio(c(row.color), c(scheme.background)), row.swatch, 2), `${row.color} swatch`).toBe(true);\n   293\t        for (const key of ['canvas@1', 'svg@1', 'canvas@2', 'svg@2']) {\n   294\t          const st = row[key] as StrokeStats;\n   295\t          // Antialiasing only moves a pixel toward the background, so no statistic can exceed the swatch.\n   296\t          expect(st.core.p10, `${row.color} ${key}`).toBeLessThanOrEqual(st.core.median);\n   297\t          expect(st.core.median).toBeLessThanOrEqual(row.swatch + 0.005);\n   298\t          expect(st.weighted.p10).toBeLessThanOrEqual(st.weighted.median);\n   299\t          expect(st.weighted.median).toBeLessThanOrEqual(st.core.median + 0.005);\n   300\t          expect(st.weighted.p10).toBeGreaterThan(1);\n   301\t        }\n   302\t      }\n   303\t    });\n   304\t\n   305\t    it(`${name}: token colors meet spec L2 (axis and focus 3:1; muted and reference 4.5:1, they label text)`, () => {\n   306\t      const bg = c(scheme.background);\n   307\t      expect(contrastRatio(c(scheme.axis), bg)).toBeGreaterThanOrEqual(3);\n   308\t      expect(contrastRatio(c