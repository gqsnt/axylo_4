value changed in place under the same reference is not seen.\n    40\t */\n    41\texport function diff(previous: Options, next: Options): Options | null {\n    42\t  let patch: Options | null = null;\n    43\t  for (const key of new Set([...Object.keys(previous), ...Object.keys(next)])) {\n    44\t    const a = has(previous, key) ? previous[key] : undefined;\n    45\t    const b = has(next, key) ? next[key] : undefined;\n    46\t    const same = has(previous, key) === has(next, key) && (key === 'data' ? a === b : equal(a, b));\n    47\t    if (!same) (patch ??= {})[key] = b;\n    48\t  }\n    49\t  return patch;\n    50\t}\n    51\t\n    52\t/**\n    53\t * Structural equality over plain objects (own keys, enumerable or not), arrays (holes count) and dates.\n    54\t * Functions, React elements, class instances and anything else by identity. Never throws: a cycle is\n    55\t * cut by the pairs already being compared, and a getter that throws makes the values unequal.\n    56\t */\n    57\texport function equal(a: unknown, b: unknown): boolean {\n    58\t  try {\n    59\t    return same(a, b, new Map());\n    60\t  } catch {\n    61\t    return false;\n    62\t  }\n    63\t}\n    64\t\n    65\tfunction same(a: unknown, b: unknown, open: Map<object, Set<object>>): boolean {\n    66\t  if (Object.is(a, b)) return true;\n    67\t  if (!isObject(a) || !isObject(b)) return false;\n    68\t  if (a instanceof Date || b instanceof Date) return a instanceof Date && b instanceof Date && Object.is(a.getTime(), b.getTime());\n    69\t  const arrays = Array.isArray(a);\n    70\t  if (arrays !== Array.isArray(b) || (!arrays && (!plain(a) || !plain(b)))) return false;\n    71\t  // A pair already under comparison further up: equal unless something else differs.\n    72\t  let seen = open.get(a);\n    73\t  if (seen?.has(b)) return true;\n    74\t  if (!seen) open.set(a, seen = new Set());\n    75\t  seen.add(b);\n    76\t  if (arrays) {\n    77\t    const x = a as unknown as unkn