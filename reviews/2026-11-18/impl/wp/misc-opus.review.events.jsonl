{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc \"AXYLO_REVIEW_MODE=fixed AXYLO_REVIEW_RESTARTS=48 node --input-type=module <<'NODE'\n\nimport {candidates, SCHEME_TOKENS} from './research/palette/fit.mjs';\nimport {lch, hueDiff} from './research/palette/color.mjs';\nconst shipped={light:'#4a94eb #e97200 #136102 #7314a2 #bd585e #007baa #a52265 #9293a5'.split(' '),dark:'#64acfa #de7b2e #b2e390 #9149b9 #c3513d #71d8ff #f898b5 #7a7f93'.split(' ')};\nconst mode=process.env.AXYLO_REVIEW_MODE||'fixed';\nconst floor=Number(process.env.AXYLO_REVIEW_FLOOR||.46);\nconst cap=Number(process.env.AXYLO_REVIEW_CAP||.21);\nconst count=Number(process.env.AXYLO_REVIEW_RESTARTS||36);\nconst scheme=process.env.AXYLO_REVIEW_SCHEME||'light';\nconst dark=scheme==='dark';\nconst focus=dark?'#e3e8f0':SCHEME_TOKENS.light.focus;\nconst tokens={...SCHEME_TOKENS[scheme],focus};\nconst match=(process.env.AXYLO_REVIEW_MATCH?.split(' '))??shipped[dark?'light':'dark'];\nconst chromaticRanges=mode==='fixed'?Array(8).fill(15):[28,27,30,25,30,40,39,90];\nchromaticRanges[7]=mode==='fixed'?28:90;\nconst targets=match.map(lch);\nconst grid=targets.map(([L,C,h],i)=> {\n  const target=lch(shipped[scheme][i]);\n  target[2]=h;\n  if(i===7) target[1]=.02;\n  const hr=chromaticRanges[i], neutral=i===7;\n  const lightRange=dark?[.50,.88]:[floor,.72];\n  const maxChroma=neutral?.043:cap;\n  const box={target,neutral,L:lightRange,C:[neutral?.011:.069,maxChroma],hr,step:[.004,.006,2]};\n  return candidates(i,box,tokens,{h,max:hr}).filter(c=>c.lch[0]>=lightRange[0]&&c.lch[1]<=maxChroma);\n});\nconsole.log('grid',scheme,mode,floor,cap,grid.map(d=>d.length).join(' '));\nlet seed=Number(process.env.AXYLO_REVIEW_SEED||11111)>>>0;\nfunction rng(){seed\"'^=seed<<13;seed''^=seed>>>17;seed''^=seed<<5;return (seed>>>0)*2.3283064365386963e-10;}\nconst distance2=(a,b)=>(a[0]-b[0])**2+(a[1]-b[1])**2+(a[2]-b[2])**2;\nfunction short(a,b,limit,limit2){\n  const d=distance2(a,b);\n  return d>=limit2?0:limit-Math.sqrt(d);\n}\nfunction conflict(i,x,j,y){\n  const hard=i<4&&j<4;\n  const limit=hard?.14:.102, limit2=limit*limit;\n  let max=0,sum=0;\n  for(let v=0;v<4;v++){\n    const a=short(x.labs[v],y.labs[v],limit,limit2),b=short(x.labsBytes[v],y.labsBytes[v],limit,limit2);\n    max=Math.max(max,a,b);sum+=a+b;\n  }\n  if(Math.abs(i-j)===1){\n    for(let k=0;k<2;k++){\n      const a=short(x.fills[k].ideal,y.fills[k].ideal,.063,.063**2),\n        b=short(x.fills[k].centre,y.fills[k].centre,.063,.063**2),\n        c=short(x.fills[k].floor,y.fills[k].floor,.063,.063**2);\n      max=Math.max(max,a,b,c);sum+=a+b+c;\n    }\n  }\n  return max+sum*.08;\n}\nconst pick=(i)=>grid[i][Math.floor(rng()*grid[i].length)];\nfunction total(arr){\n  let v=0;\n  for(let a=0;a<8;a++)for(let b=0;b<a;b++)v+=conflict(a,arr[a],b,arr[b]);\n  return v;\n}\nconst costs=(state,k,x)=> {\n  let score=0;\n  for(let j=0;j<8;j++)if(j!==k)score+=conflict(k,x,j,state[j]);\n  return score;\n};\nconst n=Number(process.env.AXYLO_REVIEW_STEPS||165000);\nlet best=[], min=Infinity, hit=0;\nfor(let restart=0;restart<count;restart++){\n  const state=restart%4===1&&best.length?best.map((x,i)=>rng()<.22?pick(i):x):grid.map((_,i)=>pick(i));\n  let sc=total(state);\n  for(let step=0;step<n;step++){\n    let k=Math.floor(rng()*8);\n    const before=costs(state,k,state[k]);\n    let x=pick(k), after=costs(state,k,x);\n    if(step%12===0){\n      for(let t=0;t<17;t++){\n        const c=pick(k), a=costs(state,k,c);\n        if(a<after){x=c;after=a;}\n      }\n    }\n    const t=(.010+restart%3*.004)*Math.exp(-5.6*step/n);\n    if(after<before||rng()<Math.exp((before-after)/t)){\n      state[k]=x;sc+=after-before;\n      if(sc<min){\n        min=total(state); best=state.slice();\n        if(min===0){hit++;console.log('\"'HIT',restart,step,state.map(c=>c.hex).join(' '));break;}\n      }\n    }\n  }\n  if((restart+1)%4===0||min===0)console.log('restart',restart+1,'best',min.toFixed(9),best.map(c=>c.hex).join(' '),'remaining',best.flatMap((c,i)=>best.slice(0,i).map((x,j)=>[i+1,j+1,+conflict(i,c,j,x).toFixed(7)]).filter(r=>r[2]>0)));\n  if(hit)break;\n}\n\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
