istsSync(f) ? JSON.parse(fs.readFileSync(f, 'utf8')) : null];\n    28\t}));\n    29\tconst ids = Object.fromEntries(list);\n    30\t\n    31\tconst num = (v, d = 2) => (typeof v !== 'number' || !Number.isFinite(v) ? 'n/a' : Math.abs(v) >= 1000 ? v.toFixed(0) : Math.abs(v) >= 100 ? v.toFixed(1) : v.toFixed(d));\n    32\tconst mib = v => (typeof v !== 'number' || !Number.isFinite(v) ? 'n/a' : `${(v / 2 ** 20).toFixed(2)}`);\n    33\tconst fmtFor = m => (m.unit === 'bytes' ? mib : v => num(v));\n    34\tconst pct = v => (v == null || !Number.isFinite(v) ? 'n/a' : `${v >= 0 ? '+' : ''}${(v * 100).toFixed(1)}%`);\n    35\tconst NAMES = { 'axylo-canvas': 'Canvas', 'axylo-svg': 'SVG', uplot: 'uPlot' };\n    36\t\n    37\tfunction row(label, metricKey) {\n    38\t  const r = runs[label];\n    39\t  if (!r) return `| ${label} | missing | | | | | | |`;\n    40\t  if (r.analysis?.notCompared) return `| ${NAMES[r.design.baseline]} (A) vs ${NAMES[r.design.candidate]} (B) | not compared: ${r.analysis.notCompared.join('; ').replace(/\\|/g, '\\\\|')} | | | | | | | |`;\n    41\t  const m = r.analysis?.metrics?.[metricKey];\n    42\t  if (!m) return `| ${NAMES[r.design.baseline]} → ${NAMES[r.design.candidate]} | ${metricKey}: not recorded | | | | | | |`;\n    43\t  if (m.na) return `| ${NAMES[r.design.baseline]} → ${NAMES[r.design.candidate]} | ${metricKey} | ${m.na} | | | | | |`;\n    44\t  const f = fmtFor(m);\n    45\t  const band = typeof m.noiseBand === 'object' ? `[${f(m.noiseBand.lo)}, ${f(m.noiseBand.hi)}]` : 'none';\n    46\t  return `| ${NAMES[r.design.baseline]} (A) vs ${NAMES[r.design.candidate]} (B) | ${metricKey}${m.unit === 'bytes' ? ' (MiB)' : m.unit === 'ms' ? ' (ms)' : ` (${m.unit})`} | ${m.pairs}/${r.design.blocks} | ${f(m.medianA)} | ${f(m.medianB)} | ${f(m.diff)} [${f(m.lo)}, ${f(m.hi)}] | ${pct(m.relative)} | **${m.outcome}**${m.outcomeNote ? ' (few pairs)' : ''} | ${band} |`;\n    47\t}\n    48\tconst HEAD = '| Comparison | Metric | Pairs/blocks | Median A | Median B | B − A [95% CI] | B/A − 1 | Outcome for B | Noise band |\\n|---|---|---|---|---|---|---|---|---|';\n    49\tconst table = (labels, metrics) => [HEAD, ...labels.flatMap(l => (runs[l]?.analysis?.notCompared ? [row(l, metrics[0])] : metrics.map(k => row(l, k))))].join('\\n');\n    50\t\n    51\tconst out = [];\n    52\tconst first = Object.values(runs).find(Boolean);\n    53\tconst env = first.environment;\n    54\tconst allRuns = Object.values(runs).filter(Boolean);\n    55\tconst loads = allRuns.flatMap(r => [r.environment.loadAverageAtStart?.[0], r.environment.loadAverageAtEnd?.[0]]).filter(Number.isFinite);\n    56\tconst pageEnv = env.page ?? {};\n    57\tconst starts = allRuns.map(r => r.startedAt).sort(), ends = allRuns.map(r => r.finishedAt).filter(Boolean).sort();\n    58\t// Provenance from the records themselves: every distinct value, with how many records carry it.\n    59\tconst tally = f => { const m = new Map(); for (const r of allRuns) { const k = f(r) ?? 'not recorded'; m.set(k, (m.get(k) ?? 0) + 1); } return [...m.entries()]; };\n    60\tconst commits = tally(r => r.environment.commit);\n    61\tconst prodHashes = tally(r => r.environment.axyloBundles?.['axylo.iife.min.js']?.sha256);\n    62\tconst devHashes = tally(r => r.environment.axyloBundles?.['axylo.iife.js']?.sha256);\n    63\tconst listTally = (t, f = v => v) => t.map(([k, n]) => `${f(k)} (${n} record${n === 1 ? '' : 's'})`).join('; ');\n    64\t\n    65\tout.push(`# M1 renderer comparison: Axylo Canvas 2D against SVG\n    66\t\n    67\tGenerated by \\`bench/results/make-m1-report.mjs\\` from the history records listed in \\`bench/results/m1-runs.tsv\\`\n    68\t(session script \\`bench/results/m1-session.sh\\`). Observations only; this file does not recommend a renderer.\n    69\t\n    70\tHow to read the tables: every comparison runs A and B in randomized balanced blocks (as many AB as BA), a fresh\n    71\tbrowser context per run. \"Median A / B\" are medians of per-run values; \"B − A\" is the difference of medians with a\n    72\tpaired bootstrap 95% interval over blocks. **Outcome is for B relative to A, and lower is better for every metric**:\n    73\tin \"Canvas (A) vs SVG (B)\", *better* means SVG measured lower, *worse* means SVG measured higher. *Inconclusive*\n    74\tmeans the interval includes zero (or the noise band); it never means \"no difference\". Where a noise band is shown,\n    75\tthe interval had to clear it as well as zero; the band is the union of the two A-versus-A intervals (Canvas and SVG)\n   178\tout.push(`Timing at dpr 2 (same runs):\\n\\n${table(['dpr2-first-1x100000-canvas-vs-svg', 'dpr2-first-1x100000-uplot-vs-canvas', 'dpr2-first-1x100000-uplot-vs-svg', 'dpr2-page-canvas-vs-svg', 'dpr2-page-uplot-vs-canvas', 'dpr2-page-uplot-vs-svg'], ['taskMs'])}\\n`);\n   179\t\n   180\t// Profiles\n   181\tconst profDir = path.join(HERE, 'profiles');\n   182\tconst sessionBundles = new Set([...prodHashes, ...devHashes].map(([h]) => h));\n   183\tconst profs = PROFILES.map(name => {\n   184\t  const f = path.join(profDir, `${name}.summary.json`);\n   185\t  if (!fs.existsSync(f)) return null;\n   186\t  const p = JSON.parse(fs.readFileSync(f, 'utf8'));\n   187\t  const b = p.environment?.axyloBundles;\n   188\t  const used = p.adapter?.includes('build=dev') ? b?.['axylo.iife.js']?.sha256 : b?.['axylo.iife.min.js']?.sha256;\n   189\t  p.bundleMatches = !!used && sessionBundles.has(used);\n   190\t  return p;\n   191\t}).filter(Boolean);\n   192\tout.push(`## CPU profiles\n   193\t\n   194\tOne Chrome CPU profile per renderer and build (CDP \\`Profiler\\`, 100 µs sampling), from the create call to the end of\n   195\tthe 500 ms settle window, at the two sizes where the uPlot gap was examined (3×120 and 1×100,000). Profiled runs\n   196\tare slowed by the profiler and are not timings. Each sample is attributed to the deepest Axylo frame on its stack,\n   197\tand that frame's source module gives the stage (\\`bench/lib/profile-summary.mjs\\`: data/ → normalize; view/, scale/\n   198\t→ view; layout/, format/ → layout; scene/, simplify/ → scene; render/ → draw; dom/ → DOM; core/ etc. → orchestration).\n   199\tPercentages are of busy time (all samples except idle). Raw \\`.cpuprofile\\` files are next to the summaries in\n   200\t\\`bench/results/profiles/\\` and open in Chrome DevTools.\n   201\t`);\n   202\tfor (const size of ['3x120', '1x100000']) {\n   203\t  for (const renderer of ['canvas', 'svg']) {\n   204\t    for (const build of ['dev', 'prod']) {\n   205\t      const p = profs.find(x => x.params.size === size && x.adapter === `axylo:renderer=${renderer},build=${build}`);\n   206\t      if (!p) { out.push(`**${size}, ${renderer}, ${build}**: profile missing.\\n`); continue; }\n   207\t      const s = p.summary;\n   208\t      out.push(`**${size}, ${renderer}, ${build === 'dev' ? 'development build' : 'production build'}** — busy ${num(s.busyMs)} ms (${s.samples} samples); mapping: ${s.mapping}. File \\`${p.profileFile}\\`.${p.bundleMatches ? '' : ' **Its bundle hash is not one of the session records\\' bundles.**'}\\n`);\n   209\t      out.push('| Stage | ms | % of busy |\\n|---|---|---|');\n   210\t      for (const st of s.stages.filter(x => x.k !== '(idle)')) out.push(`| ${st.k} | ${num(st.ms)} | ${st.ofBusy}% |`);\n   211\t      if (build === 'dev') {\n// Shared, deterministic datasets. Every library receives exactly these values.\nexport function rng(seed) {\n  let s = seed >>> 0;\n  return () => { s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };\n}\nconst DAY = 864e5;\nconst START = Date.UTC(2026, 0, 1);\n\n// Task \"trend\": 3 series x 120 daily points (UTC midnights). \"Referral\" has a 7-day outage (nulls).\nexport const trend = (() => {\n  const r = rng(7), n = 120;\n  const t = Array.from({ length: n }, (_, i) => START + i * DAY);\n  const mk = (base, growth, noise, season) => t.map((_, i) => Math.round(base + growth * i + season * Math.sin((i / 7) * 2 * Math.PI) + (r() - 0.5) * noise));\n  const series = [\n    { name: 'Direct', values: mk(31000, 120, 4000, 3000) },\n    { name: 'Organic search', values: mk(18000, 60, 3000, 2500) },\n    { name: 'Referral', values: mk(4200, -8, 1200, 400) },\n  ];\n  for (let i = 60; i < 67; i++) series[2].values[i] = null;\n  return { title: 'Daily sessions by channel', yTitle: 'Sessions', t, series };\n})();\n\n// Task \"bars\": one series, all values between 82 and 97 (tests zero baseline), one long label.\nexport const bars = {\n  title: 'Customer satisfaction by team', yTitle: 'Satisfied (%)', name: 'Satisfied (%)',\n  categories: ['Billing', 'Customer Success & Onboarding', 'Platform', 'Mobile', 'Data', 'Security', 'Sales Eng.'],\n  values: [94, 88, 97, 82, 91, 85, 90],\n};\n\n// Task \"parts\": six shares, two of them small.\nexport const parts = {\n  title: 'Sessions by browser', name: 'Share (%)',\n","exit_code":0,"status":"completed"}}
