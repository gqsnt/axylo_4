{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/react/src/index.ts; nl -ba packages/react/src/patch.ts'","aggregated_output":"     1\t'use client';\n     2\t/**\n     3\t * React components for Axylo (plan 1.7). Each renders one empty <div> and drives a core chart inside it from\n     4\t * effects, so server rendering produces the container only and never reaches the core's browser code.\n     5\t */\n     6\timport { createElement, forwardRef, useEffect, useImperativeHandle, useLayoutEffect, useRef } from 'react';\n     7\timport type { CSSProperties, ReactElement, Ref } from 'react';\n     8\timport { area, bar, donut, line, scatter } from 'axylo';\n     9\timport type {\n    10\t  AreaOptions, BarOptions, Chart, ChartEvents, Diagnostic, DonutOptions, LineOptions, ScatterOptions,\n    11\t} from 'axylo';\n    12\timport { diff, isHostProp, looksSame, optionsOf, type Options } from './patch';\n    13\t\n    14\t/** Replaced at build time: the development file keeps the memoization hint, the production file drops it. */\n    15\tdeclare const __DEV__: boolean;\n    16\t\n    17\t/** What a component's `ref` receives. `chart` is null before mount, after unmount and on the server. */\n    18\texport interface ChartRef<Row, ChartOptions> {\n    19\t  readonly chart: Chart<Row, ChartOptions> | null;\n    20\t}\n    21\t\n    22\t/** Attributes of the container <div>. `aria-*` is not one: the chart is named through `title` or `labelledBy`. */\n    23\texport interface ContainerProps {\n    24\t  id?: string;\n    25\t  className?: string;\n    26\t  style?: CSSProperties;\n    27\t  [attribute: `data-${string}`]: string | number | boolean | undefined;\n    28\t}\n    29\t\n    30\tinterface ComponentProps<Row, ChartOptions> extends ContainerProps {\n    31\t  ref?: Ref<ChartRef<Row, ChartOptions>>;\n    32\t  onHover?: (point: ChartEvents<Row>['hover']) => void;\n    33\t  onSelect?: (point: ChartEvents<Row>['select']) => void;\n    34\t}\n    35\t\n    36\tinterface ZoomEvent {\n    37\t  onZoom?: (domain: ChartEvents<unknown>['zoom']) => void;\n    38\t}\n    39\t\n    40\texport type LineProps<Row> = LineOptions<Row> & ComponentProps<Row, LineOptions<Row>> & ZoomEvent;\n    41\texport type AreaProps<Row> = AreaOptions<Row> & ComponentProps<Row, AreaOptions<Row>> & ZoomEvent;\n    42\texport type BarProps<Row> = BarOptions<Row> & ComponentProps<Row, BarOptions<Row>> & ZoomEvent;\n    43\texport type ScatterProps<Row> = ScatterOptions<Row> & ComponentProps<Row, ScatterOptions<Row>> & ZoomEvent;\n    44\texport type DonutProps<Row> = DonutOptions<Row> & ComponentProps<Row, DonutOptions<Row>>;\n    45\t\n    46\ttype AnyChart = Chart<unknown, Options>;\n    47\ttype Create = (target: HTMLElement, options: Options) => AnyChart;\n    48\ttype Listener = ((payload: unknown) => void) | undefined;\n    49\tinterface Live { chart: AnyChart; applied: Options; repeats: number; hinted: boolean }\n    50\t\n    51\tconst EVENTS = [['onHover', 'hover'], ['onSelect', 'select'], ['onZoom', 'zoom']] as const;\n    52\t\n    53\t/**\n    54\t * The layout phase on the client: the chart exists, has the committed options and calls the committed\n    55\t * handlers before a parent's layout effect or callback ref can reach it, so calls made there apply in the\n    56\t * order React committed them (plan 1.5). On the server neither kind runs; useEffect there avoids React 18's\n    57\t * useLayoutEffect warning.\n    58\t */\n    59\tconst useCommitEffect = typeof document === 'undefined' ? useEffect : useLayoutEffect;\n    60\t\n    61\tfunction component(create: Create, name: string): unknown {\n    62\t  const Axylo = forwardRef<ChartRef<unknown, Options>, Options>((props, ref) => {\n    63\t    const target = useRef<HTMLDivElement>(null);\n    64\t    const latest = useRef(props);\n    65\t    const live = useRef<Live | null>(null);\n    66\t    const forward = useRef((d: Diagnostic) => (latest.current.onDiagnostic as Listener)?.(d)).current;\n    67\t\n    68\t    // Errors thrown here (a `strict` chart rejecting its options) reach the nearest error boundary as they are.\n    69\t    useCommitEffect(() => {\n    70\t      latest.current = props;\n    71\t      const next = optionsOf(props, forward);\n    72\t      const state = live.current;\n    73\t      if (!state) {\n    74\t        const chart = create(target.current!, next);\n    75\t        try {\n    76\t          // Listeners go through `latest`, so a new handler is picked up without touching the chart.\n    77\t          for (const [prop, event] of EVENTS) chart.on(event, payload => (latest.current[prop] as Listener)?.(payload));\n    78\t        } catch (error) {\n    79\t          chart.destroy();\n    80\t          throw error;\n    81\t        }\n    82\t        live.current = { chart, applied: next, repeats: 0, hinted: false };\n    83\t        return;\n    84\t      }\n    85\t      if (__DEV__) hint(state, next.data, name);\n    86\t      const patch = diff(state.applied, next);\n    87\t      if (patch) state.chart.update(patch);\n    88\t      // Also on a no-op: the next render then compares against these identities and stops at the first check.\n    89\t      state.applied = next;\n    90\t    });\n    91\t\n    92\t    // Destroyed in the passive cleanup, which runs on unmount but not when Suspense hides the subtree: a\n    93\t    // revealed chart is the same chart, with its appended rows and zoom.\n    94\t    useEffect(() => () => {\n    95\t      const state = live.current;\n    96\t      live.current = null;\n    97\t      state?.chart.destroy();\n    98\t    }, []);\n    99\t\n   100\t    useImperativeHandle(ref, () => ({ get chart() { return live.current?.chart ?? null; } }), []);\n   101\t\n   102\t    // `axylo` is the class the core puts on its root; rendering it keeps React from removing it when\n   103\t    // `className` changes.\n   104\t    const host: Options = { ref: target, className: props.className ? `axylo ${props.className as string}` : 'axylo' };\n   105\t    for (const key of Object.keys(props)) if (isHostProp(key)) host[key] = props[key];\n   106\t    return createElement('div', host);\n   107\t  });\n   108\t  Axylo.displayName = name;\n   109\t  return Axylo;\n   110\t}\n   111\t\n   112\tfunction hint(state: Live, data: unknown, name: string): void {\n   113\t  if (state.hinted) return;\n   114\t  state.repeats = data !== state.applied.data && looksSame(state.applied.data, data) ? state.repeats + 1 : 0;\n   115\t  if (state.repeats < 3) return;\n   116\t  state.hinted = true;\n   117\t  console.warn(`[axylo/react] <${name}> was given \\`data\\` as a new object three renders running, each time with the same length and the same first and last rows (only those are compared). A new object is normalized again; if the content has not changed, memoize it (useMemo, or keep it in state).`);\n   118\t}\n   119\t\n   120\texport const Line = /* @__PURE__ */ component(line as unknown as Create, 'Line') as <Row>(props: LineProps<Row>) => ReactElement | null;\n   121\texport const Area = /* @__PURE__ */ component(area as unknown as Create, 'Area') as <Row>(props: AreaProps<Row>) => ReactElement | null;\n   122\texport const Bar = /* @__PURE__ */ component(bar as unknown as Create, 'Bar') as <Row>(props: BarProps<Row>) => ReactElement | null;\n   123\texport const Scatter = /* @__PURE__ */ component(scatter as unknown as Create, 'Scatter') as <Row>(props: ScatterProps<Row>) => ReactElement | null;\n   124\texport const Donut = /* @__PURE__ */ component(donut as unknown as Create, 'Donut') as <Row>(props: DonutProps<Row>) => ReactElement | null;\n     1\t/**\n     2\t * Props to options, and options to the patch `chart.update` receives (plan 1.7). Pure, so it runs in Node.\n     3\t */\n     4\timport type { Diagnostic } from 'axylo';\n     5\t\n     6\texport type Options = Record<string, unknown>;\n     7\t\n    