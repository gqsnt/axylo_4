{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'nl -ba research/palette/score.mjs; nl -ba research/palette/references.mjs; nl -ba research/palette/raster.mjs'","aggregated_output":"     1\t// Scores the palette that ships (packages/axylo/src/theme/palette.ts) against the hard constraints of decision\n     2\t// 0003 and writes the record the decision quotes, research/palette/palette.json. The unit test\n     3\t// (packages/axylo/test/theme/palette.test.ts) recomputes the measured fields with its own code and compares them at\n     4\t// the precision written here.\n     5\t//\n     6\t// Two browser measurements are folded in when they describe exactly the shipped colors and backgrounds, and are\n     7\t// refused otherwise: strokes.json (strokes.mjs, 2 px lines) and raster.json (raster.mjs, translucent fills).\n     8\t//\n     9\t//   node research/palette/score.mjs [--md]     (--md also prints the tables of the decision record)\n    10\timport fs from 'node:fs';\n    11\timport path from 'node:path';\n    12\timport { fileURLToPath } from 'node:url';\n    13\timport { THRESHOLDS as T, TOKEN_NAMES, VISIONS, bytes, bytesToHex, checkScheme, dist, labOfBytes, lch, neighbourPairs } from './color.mjs';\n    14\timport { readThemeFile } from './theme-file.mjs';\n    15\t\n    16\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    17\tconst md = process.argv.includes('--md');\n    18\tconst theme = readThemeFile();\n    19\tconst r3 = x => +x.toFixed(3);\n    20\tconst pair1 = p => p.map(i => i + 1);\n    21\t\n    22\t/** Why a browser record does not describe the shipped palette, or null when it does. */\n    23\tfunction mismatch(rec, name) {\n    24\t  if (!rec?.schemes) return `${name}: no schemes`;\n    25\t  for (const s of ['light', 'dark']) {\n    26\t    const r = rec.schemes[s], t = theme[s];\n    27\t    if (!r) return `${name}: no ${s} scheme`;\n    28\t    if (r.background !== t.background) return `${name}: ${s} background ${r.background} is not ${t.background}`;\n    29\t    const colors = r.series ?? r.rows?.map(x => x.color);\n    30\t    if (JSON.stringify(colors) !== JSON.stringify(t.series)) return `${name}: ${s} colors ${JSON.stringify(colors)} are not the shipped ${JSON.stringify(t.series)}`;\n    31\t  }\n    32\t  return null;\n    33\t}\n    34\tconst load = file => { const p = path.join(here, file); return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, 'utf8')) : null; };\n    35\tconst strokes = load('strokes.json'), raster = load('raster.json');\n    36\tconst refused = [];\n    37\tfor (const [rec, name] of [[strokes, 'strokes.json'], [raster, 'raster.json']]) {\n    38\t  const why = rec ? mismatch(rec, name) : `${name} missing`;\n    39\t  if (why) refused.push(why);\n    40\t}\n    41\t\n    42\tconst record = { thresholds: T, schemes: {} };\n    43\tfor (const [name, other] of [['light', 'dark'], ['dark', 'light']]) {\n    44\t  const s = theme[name], { checks, measured: m } = checkScheme(s, theme[other]);\n    45\t  const pairsOf = (map, n) => Object.fromEntries(VISIONS.map(v => [v, { min: r3(map[v].min), pair: pair1(map[v].pair) }]));\n    46\t  const scheme = {\n    47\t    background: s.background,\n    48\t    tokens: Object.fromEntries(['axis', 'grid', 'muted', 'reference', 'focus'].map(k => [k, s[k]])),\n    49\t    series: s.series.map((hex, k) => ({ slot: k + 1, hex, oklch: lch(hex).map((v, i) => +v.toFixed(i === 2 ? 1 : 3)), contrast: +m.contrast[k].toFixed(2), hueDiffToOtherScheme: +m.hue[k].toFixed(1) })),\n    50\t    minDelta: pairsOf(m.full),\n    51\t    prefixes: Object.fromEntries(T.prefixes.map(n => [n, pairsOf(m.prefixes[n])])),\n    52\t    minDeltaBytes: pairsOf(m.fullBytes),\n    53\t    prefixesBytes: Object.fromEntries(T.prefixes.map(n => [n, pairsOf(m.prefixesBytes[n])])),\n    54\t    tokenDistance: Object.fromEntries(TOKEN_NAMES.map(t => [t, { min: r3(m.tokens[t].min), slot: m.tokens[t].slot + 1 }])),\n    55\t    composites: Object.fromEntries(T.alphas.map(a => [a, Object.fromEntries(VISIONS.map(v => [v, {\n    56\t      minNeighbour: r3(m.composites[a][v].minNeighbour.d), pair: pair1(m.composites[a][v].minNeighbour.pair),\n    57\t      neighbours: m.composites[a][v].neighbours.map(x => r3(x.d)),\n    58\t      ringClosures: m.composites[a][v].ring.map(x => ({ slots: [x.pair[0] + 1, 1], d: r3(x.d) })),\n    59\t    }]))])),\n    60\t    raster: Object.fromEntries(T.alphas.map(a => [a, {\n    61\t      model: m.raster[a].pixels, modelFloor: m.raster[a].pixelsFloor,\n    62\t      neighboursModel: m.raster[a].neighbours.map(x => r3(x.model)),\n    63\t      neighboursWorstWithinOneByte: m.raster[a].neighbours.map(x => r3(x.worst)),\n    64\t      minModel: r3(m.raster[a].minModel), minWorstWithinOneByte: r3(m.raster[a].minWorst),\n    65\t    }])),\n    66\t    checks: checks.map(c => ({ constraint: c.id, check: c.label, value: r3(c.value), limit: c.limit, ok: c.ok })),\n    67\t  };\n    68\t  if (raster && !mismatch(raster, 'raster.json')) {\n    69\t    scheme.chromeRaster = Object.fromEntries(Object.entries(raster.schemes[name].pixels).map(([via, byAlpha]) => [via, Object.fromEntries(Object.entries(byAlpha).map(([a, px]) => {\n    70\t      const nb = neighbourPairs(px.length).map(([i, j]) => dist(labOfBytes(bytes(px[i])), labOfBytes(bytes(px[j]))));\n    71\t      return [a, { pixels: px, neighbours: nb.map(r3), min: r3(Math.min(...nb)) }];\n    72\t    }))]));\n    73\t    for (const [via, byAlpha] of Object.entries(scheme.chromeRaster)) for (const [a, x] of Object.entries(byAlpha)) {\n    74\t      scheme.checks.push({ constraint: '6b', check: `min neighbour ΔE at ${+a * 100}%, Chrome ${via} pixels`, value: x.min, limit: T.composite, ok: x.min >= T.composite });\n    75\t    }\n    76\t  }\n    77\t  // Evenness of weight: OKLab lightness range of the eight and of the first three, and the largest chroma.\n    78\t  const Ls = s.series.map(h => lch(h)[0]), Cs = s.series.map(h => lch(h)[1]);\n    79\t  scheme.lightness = { min: r3(Math.min(...Ls)), max: r3(Math.max(...Ls)), firstThreeSpread: r3(Math.max(...Ls.slice(0, 3)) - Math.min(...Ls.slice(0, 3))), maxChroma: r3(Math.max(...Cs)) };\n    80\t  // The pairs that bind: every measured value within 5% of its limit, with its margin.\n    81\t  scheme.tight = checks.filter(c => !c.upper && c.value < c.limit * 1.05).map(c => ({ check: c.label, value: r3(c.value), margin: r3(c.value - c.limit) }));\n    82\t  record.schemes[name] = scheme;\n    83\t}\n    84\t\n    85\t// Sensitivity to a hand edit: every one-byte change of one channel of one color, and whether the scheme still meets\n    86\t// every check above (analytic, byte-rounded and raster model). Measured, so the record says how fragile it is.\n    87\trecord.oneByteEdits = {};\n    88\tfor (const [name, other] of [['light', 'dark'], ['dark', 'light']]) {\n    89\t  let total = 0, pass = 0;\n    90\t  theme[name].series.forEach((hex, k) => {\n    91\t    for (let ch = 0; ch < 3; ch++) for (const d of [-1, 1]) {\n    92\t      const b = bytes(hex); b[ch] += d; if (b[ch] < 0 || b[ch] > 255) continue;\n    93\t      const series = theme[name].series.slice(); series[k] = bytesToHex(b);\n    94\t      const otherScheme = { ...theme[other] };\n    95\t      total++; if (checkScheme({ ...theme[name], series }, otherScheme).checks.every(c => c.ok)) pass++;\n    96\t    }\n    97\t  });\n    98\t  record.oneByteEdits[name] = { edits: total, stillMeetEveryCheck: pass };\n    99\t}\n   100\t\n   101\tif (strokes && !mismatch(strokes, 'strokes.json')) record.strokes = strokes;\n   102\trecord.refused = refused;\n   103\tfs.writeFileSync(path.join(here, 'palette.json'), JSON.stringify(record, null, 1) + '\\n');\n   104\t\n   105\tfor (const why of refused) console.log(`not folded in: ${why}`);\n   106\tconst failed = Object.values(record.schemes).flatMap(s => s.checks.filter(c => !c.ok));\n   107\tconsole.log(failed.length ? `FAILED: ${failed.map(c => c.check).join('; ')}` : 'all hard constraints met');\n   108\tif (md) {\n   109\t  const L = record.schemes.light, D = record.schemes.dark, f = x => x.toFixed(3);\n   110\t  const val = c => c.constraint === 1 ? c.value.toFixed(2) : c.constraint === 4 ? c.value.toFixed(1) : f(c.value);\n   111\t  console.log('\\n| Constraint | Check | Limit | Light | Dark |\\n|---|---|---|---|---|');\n   112\t  L.checks.forEach((c, i) => { const d = D.checks[i]; console.log(`| ${c.constraint} | ${c.check} | ${c.constraint === 4 ? '≤ ' : '≥ '}${c.limit} | ${val(c)} | ${val(d)} |`); });\n   113\t  for (const [label, key, keyB] of [['analytic', 'prefixes', 'minDelta'], ['bytes', 'prefixesBytes', 'minDeltaBytes']]) {\n   114\t    console.log(`\\n| Prefix (${label}) | Vision | Light (pair) | Dark (pair) |\\n|---|---|---|---|`);\n   115\t    for (const n of T.prefixes) for (const v of VISIONS) console.log(`| first ${n} | ${v} | ${f(L[key][n][v].min)} (${L[key][n][v].pair.join('–')}) | ${f(D[key][n][v].min)} (${D[key][n][v].pair.join('–')}) |`);\n   116\t    for (const v of VISIONS) console.log(`| all 8 | ${v} | ${f(L[keyB][v].min)} (${L[keyB][v].pair.join('–')}) | ${f(D[keyB][v].min)} (${D[keyB][v].pair.join('–')}) |`);\n   117\t  }\n   118\t  for (const s of ['light', 'dark']) { console.log(`\\n${s} tight:`); for (const t of record.schemes[s].tight) console.log(`- ${t.check}: ${t.value} (margin ${t.margin})`); }\n   119\t  console.log('\\none-byte edits:', JSON.stringify(record.oneByteEdits));\n   120\t  for (const s of ['light', 'dark']) console.log(s, 'lightness', JSON.stringify(record.schemes[s].lightness));\n   121\t}\n   122\tprocess.exitCode = failed.length ? 1 : 0;\n     1\t// Scores five categorical palettes that ship in d3-scale-chromatic as installed in this repository\n     2\t// (research/harness/node_modules), with the same measures as the decision: contrast on #ffffff and #16181d, and the\n     3\t// smallest pairwise OKLab difference of the first eight under normal vision and the three simulations. The arrays\n     4\t// are read from the installed file, not typed in. Writes research/palette/references.json.\n     5\t//\n     6\t//   node research/palette/references.mjs\n     7\timport fs from 'node:fs';\n     8\timport path from 'node:path';\n     9\timport { fileURLToPath } from 'node:url';\n    10\timport { VISIONS, contrast, minPair } from './color.mjs';\n    11\t\n    12\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    13\tconst pkg = path.resolve(here, '../harness/node_modules/d3-scale-chromatic');\n    14\tconst version = JSON.parse(fs.readFileSync(path.join(pkg, 'package.json'), 'utf8')).version;\n    15\tconst src = fs.readFileSync(path.join(pkg, 'dist/d3-scale-chromatic.mjs'), 'utf8');\n    16\tconst read = name => {\n    17\t  const m = src.match(new RegExp(`var ${name} = colors\\\\(\"([0-9a-f]+)\"\\\\);`));\n    18\t  if (!m) throw new Error(`${name} not found in d3-scale-chromatic ${version}`);\n    19\t  return m[1].match(/.{6}/g).map(h => '#' + h);\n    20\t};\n    21\tconst out = { source: `d3-scale-chromatic ${version}, dist/d3-scale-chromatic.mjs`, palettes: {} };\n    22\tfor (const [label, name] of [['schemeTableau10', 'Tableau10'], ['schemeObservable10', 'observable10'], ['schemeCategory10', 'category10'], ['schemeDark2', 'Dark2'], ['schemeSet1', 'Set1']]) {\n    23\t  const colors = read(name), first8 = colors.slice(0, 8);\n    24\t  out.palettes[label] = {\n    25\t    colors,\n    26\t    belowThreeToOneOnWhite: colors.filter(c => contrast(c, '#ffffff') < 3).length,\n    27\t    belowThreeToOneOnDark: colors.filter(c => contrast(c, '#16181d') < 3).length,\n    28\t    contrastOnWhite: colors.map(c => +contrast(c, '#ffffff').toFixed(2)),\n    29\t    first8MinDelta: Object.fromEntries(VISIONS.map(v => { const m = minPair(first8, v); return [v, { min: +m.min.toFixed(3), pair: m.pair.map(i => i + 1) }]; })),\n    30\t  };\n    31\t  console.log(label, JSON.stringify(out.palettes[label]));\n    32\t}\n    33\tfs.writeFileSync(path.join(here, 'references.json'), JSON.stringify(out, null, 1) + '\\n');\n     1\t// What a translucent fill becomes on an 8-bit raster in Chrome. For every series color of the shipped palette\n     2\t// (packages/axylo/src/theme/palette.ts), this fills a rectangle at 25% and at 80% opacity over the scheme's\n     3\t// background, the way Axylo's renderers do it (2D canvas: globalAlpha; SVG: fill-opacity, rasterized by drawing\n     4\t// the SVG into a canvas), reads one interior pixel back, and records the bytes. score.mjs folds the record into\n     5\t// palette.json; the unit test checks the recorded bytes against the palette and the 0.06 neighbour limit, and\n     6\t// checks that the byte model in color.mjs (rasterFill) predicts every recorded pixel.\n     7\t//\n     8\t//   node research/palette/raster.mjs [--out=research/palette/raster.json]\n     9\timport fs from 'node:fs';\n    10\timport path from 'node:path';\n    11\timport { fileURLToPath } from 'node:url';\n    12\timport { chromium } from 'playwright-core';\n    13\timport { readThemeFile } from './theme-file.mjs';\n    14\t\n    15\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    16\tconst args = Object.fromEntries(process.argv.slice(2).map(a => a.replace(/^--/, '').split('=')).map(([k, v]) => [k, v ?? 'true']));\n    17\tconst theme = readThemeFile();\n    18\tconst ALPHAS = [0.25, 0.8];\n    19\t\n    20\tconst browser = await chromium.launch({ channel: 'chrome', headless: true });\n    21\tconst page = await browser.newPage({ deviceScaleFactor: 1 });\n    22\tawait page.setContent('<!doctype html><html><body></body></html>');\n    23\tconst record = { chrome: browser.version(), method: 'one 40x40 rectangle per color and opacity over the scheme background; pixel (20, 20) read with getImageData', schemes: {} };\n    24\tfor (const scheme of ['light', 'dark']) {\n    25\t  const t = theme[scheme];\n    26\t  const pixels = await page.evaluate(async ({ colors, bg, alphas }) => {\n    27\t    const out = {};\n    28\t    for (const via of ['canvas', 'svg']) {\n    29\t      out[via] = {};\n    30\t      for (const a of alphas) {\n    31\t        out[via][a] = [];\n    32\t        for (const color of colors) {\n    33\t          const c = document.createElement('canvas'); c.width = 40; c.height = 40;\n    34\t          const g = c.getContext('2d');\n    35\t          g.fillStyle = bg; g.fillRect(0, 0, 40, 40);\n    36\t          if (via === 'canvas') { g.globalAlpha = a; g.fillStyle = color; g.fillRect(0, 0, 40, 40); g.globalAlpha = 1; }\n    37\t          else {\n    38\t            const svg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"40\" height=\"40\"><rect width=\"40\" height=\"40\" fill=\"' + color + '\" fill-opacity=\"' + a + '\"/></svg>';\n    39\t            const img = new Image(); img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg); await img.decode();\n    40\t            g.drawImage(img, 0, 0);\n    41\t          }\n    42\t          const d = g.getImageData(20, 20, 1, 1).data;\n    43\t          out[via][a].push('#' + [d[0], d[1], d[2]].map(v => v.toString(16).padStart(2, '0')).join(''));\n    44\t        }\n    45\t      }\n    46\t    }\n    47\t    return out;\n    48\t  }, { colors: t.series, bg: t.background, alphas: ALPHAS });\n    49\t  record.schemes[scheme] = { background: t.background, series: t.series, pixels };\n    50\t  console.log(scheme, JSON.stringify(pixels));\n    51\t}\n    52\tawait browser.close();\n    53\tfs.writeFileSync(args.out ?? path.join(here, 'raster.json'), JSON.stringify(record, null, 1) + '\\n');\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"nl -ba research/palette/fit.mjs | sed -n '1,270p'; sed -n '1,115p' research/palette/configs/fit-final.json\"","aggregated_output":"     1\t// Nearest feasible palette to a hand-designed target (decision 0003). Plain Node, no dependencies.\n     2\t//\n     3\t// The designer writes a target color per slot in OKLCH and a box around it (lightness, chroma, hue ranges) for\n     4\t// each scheme (configs/fit-*.json). This script lays a grid over each box (8-bit-rounded hex, so what is scored is\n     5\t// what ships), drops grid colors that fail on their own (contrast, gamut, distance to the focus, reference and\n     6\t// muted tokens), and then runs a branch-and-bound search over slots with forward checking on the pairwise\n     7\t// constraints (minimum OKLab difference under four visions, 0.14 inside the first four; neighbour composites at\n     8\t// 25% and 80%). The cost is the weighted squared distance from the target, so the result is the feasible palette\n     9\t// closest to what was asked for, on that grid. Pairwise differences are required both analytically and after the\n    10\t// simulated colors are rounded to bytes; fills both ideally and on an 8-bit raster, at the worst case within one\n    11\t// byte per channel. The light scheme is solved first; the dark scheme's hue boxes are then clipped to within\n    12\t// `hueClip` degrees of the light result per slot (default 28, under constraint 4's 30).\n    13\t//\n    14\t//   node research/palette/fit.mjs --config=research/palette/configs/fit-x.json [--seconds=60] [--out=file.json]\n    15\timport fs from 'node:fs';\n    16\timport path from 'node:path';\n    17\timport { fileURLToPath } from 'node:url';\n    18\timport { OPTIONS, THRESHOLDS as T, TOKEN_NAMES, VISIONS, byteBox, compositeLinear, contrast, dist, hueDiff, labOfBytes, labUnder, labUnderBytes, lch, lchToHex, oklab, rasterFill } from './color.mjs';\n    19\t\n    20\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    21\texport const SCHEME_TOKENS = {\n    22\t  light: { background: '#ffffff', focus: '#1f5fcc', reference: '#474b55', muted: '#62666f' },\n    23\t  dark: { background: '#16181d', focus: '#79a8ff', reference: '#bcc0c9', muted: '#9da2ad' },\n    24\t};\n    25\t\n    26\t// Solver-only margins, stricter than the tests: contrast at least 3.02:1, so a contrast computed with slightly\n    27\t// different rounding still passes; translucent fills checked at the worst case within one byte per channel of the\n    28\t// byte model when OPTIONS.box is 1 (--box=1), because rasterizers round alpha and channels differently; by default\n    29\t// both byte models (alpha rounded and floored) are required and the one-byte worst case is only recorded.\n    30\tconst CONTRAST_MARGIN = 0.02;\n    31\texport { OPTIONS };\n    32\t\n    33\texport function candidates(slot, box, tokens, hueClip, exactHex = null) {\n    34\t  const out = new Map();\n    35\t  const [tL, tC, tH] = box.target, [wL, wC, wH] = box.weights ?? [1, 1, 1];\n    36\t  const step = box.step ?? [0.01, 0.01, 2];\n    37\t  for (let L = box.L[0]; L <= box.L[1] + 1e-9; L += step[0])\n    38\t    for (let C = box.C[0]; C <= box.C[1] + 1e-9; C += step[1])\n    39\t      for (let dh = -box.hr; dh <= box.hr + 1e-9; dh += step[2]) {\n    40\t        const hex = exactHex ?? lchToHex([L, C, (tH + dh + 360) % 360]);   // exactHex: price one given color\n    41\t        if (!hex || out.has(hex)) continue;\n    42\t        if (contrast(hex, tokens.background) < T.contrast + CONTRAST_MARGIN) continue;\n    43\t        const labs = VISIONS.map(v => labUnder(hex, v));\n    44\t        if (TOKEN_NAMES.some(t => dist(labs[0], labUnder(tokens[t], 'normal')) < T.token)) continue;\n    45\t        const [l, c, h] = lch(hex);\n    46\t        if (hueClip && hueDiff(h, hueClip.h) > hueClip.max) continue;\n    47\t        const cost = wL * ((l - tL) / 0.05) ** 2 + wC * ((c - tC) / 0.03) ** 2 + (box.neutral ? 0 : wH * (hueDiff(h, tH) / 10) ** 2);\n    48\t        const labsBytes = VISIONS.map(v => labUnderBytes(hex, v));\n    49\t        // Fills: ideal composite, byte-model pixel, and the lattice within OPTIONS.box bytes of it with its radius.\n    50\t        const fills = T.alphas.map(a => {\n    51\t          const px = rasterFill(hex, a, tokens.background), centre = labOfBytes(px);\n    52\t          const floor = labOfBytes(rasterFill(hex, a, tokens.background, Math.floor));\n    53\t          const box = byteBox(px, OPTIONS.box).map(labOfBytes);\n    54\t          return { ideal: oklab(compositeLinear(hex, a, tokens.background)), centre, floor, box, radius: Math.max(...box.map(q => dist(q, centre))) };\n    55\t        });\n    56\t        out.set(hex, { hex, labs, labsBytes, fills, cost, lch: [l, c, h] });\n    57\t      }\n    58\t  return [...out.values()].sort((a, b) => a.cost - b.cost);\n    59\t}\n    60\t\n    61\t/** Worst-case distance between two fills' byte lattices: exact only when the cheap triangle bound is not enough. */\n    62\tfunction fillsApart(fa, fb) {\n    63\t  if (dist(fa.ideal, fb.ideal) < T.composite) return false;\n    64\t  const c = dist(fa.centre, fb.centre);\n    65\t  if (c < T.composite || dist(fa.floor, fb.floor) < T.composite) return false;   // both byte models\n    66\t  if (!OPTIONS.box) return true;\n    67\t  if (c - fa.radius - fb.radius >= T.composite) return true;\n    68\t  if (c < T.composite) return false;\n    69\t  for (const p of fa.box) for (const q of fb.box) if (dist(p, q) < T.composite) return false;\n    70\t  return true;\n    71\t}\n    72\t\n    73\texport function compatible(i, a, j, b) {\n    74\t  const limit = i < 4 && j < 4 ? T.prefix4 : T.minDelta;\n    75\t  for (let v = 0; v < VISIONS.length; v++) {\n    76\t    if (dist(a.labs[v], b.labs[v]) < limit) return false;               // analytic (constraint 2, 3)\n    77\t    if (dist(a.labsBytes[v], b.labsBytes[v]) < limit) return false;     // after rounding the simulation to bytes\n    78\t  }\n    79\t  if (Math.abs(i - j) === 1) for (let k = 0; k < T.alphas.length; k++) if (!fillsApart(a.fills[k], b.fills[k])) return false;\n    80\t  return true;\n    81\t}\n    82\t\n    83\t/**\n    84\t * Branch and bound with forward checking. Returns the cheapest assignment found within the time limit.\n    85\t * With restarts > 1, the first half of the time goes to the exact cost-ordered search and the rest is split\n    86\t * between restarts that try values in a jittered cost order (seeded, so runs repeat), sharing the best bound.\n    87\t * Only the first pass can prove that nothing exists; `complete` reports whether it finished.\n    88\t */\n    89\texport function search(domains, seconds, compat = compatible, restarts = 1) {\n    90\t  const n = domains.length, start = Date.now();\n    91\t  let best = null, bestCost = Infinity, nodes = 0, complete = true, deadline = 0;\n    92\t  const assigned = new Array(n).fill(null);\n    93\t  const minCost = d => { let m = Infinity; for (const x of d) if (x.cost < m) m = x.cost; return m; };\n    94\t  function recurse(doms, mins, cost, sorted) {\n    95\t    if (Date.now() > deadline) return false;\n    96\t    nodes++;\n    97\t    let pick = -1;   // most constrained unassigned slot first\n    98\t    for (let s = 0; s < n; s++) if (assigned[s] === null && (pick < 0 || doms[s].length < doms[pick].length)) pick = s;\n    99\t    if (pick < 0) { if (cost < bestCost) { bestCost = cost; best = assigned.slice(); } return true; }\n   100\t    let bound = cost;\n   101\t    for (let s = 0; s < n; s++) if (assigned[s] === null) bound += mins[s];\n   102\t    if (bound >= bestCost) return true;\n   103\t    for (const cand of doms[pick]) {\n   104\t      const rest = bound - mins[pick] + cand.cost;\n   105\t      if (rest >= bestCost) { if (sorted) break; continue; }\n   106\t      assigned[pick] = cand;\n   107\t      const next = doms.slice(), nextMins = mins.slice();\n   108\t      let ok = true, nb = cost + cand.cost;\n   109\t      for (let s = 0; s < n && ok; s++) {\n   110\t        if (assigned[s] !== null) continue;\n   111\t        const f = doms[s].filter(x => compat(pick, cand, s, x));\n   112\t        if (!f.length) ok = false; else { next[s] = f; nextMins[s] = sorted ? f[0].cost : minCost(f); nb += nextMins[s]; }\n   113\t      }\n   114\t      const finished = ok && nb < bestCost ? recurse(next, nextMins, cost + cand.cost, sorted) : true;\n   115\t      assigned[pick] = null;\n   116\t      if (!finished || Date.now() > deadline) return false;\n   117\t    }\n   118\t    return true;\n   119\t  }\n   120\t  const share = restarts > 1 ? 0.5 : 1;\n   121\t  deadline = start + seconds * 1000 * share;\n   122\t  complete = recurse(domains, domains.map(d => d[0]?.cost ?? Infinity), 0, true);\n   123\t  let seed = 1;\n   124\t  const rand = () => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; };\n   125\t  for (let r = 1; r < restarts; r++) {\n   126\t    deadline = start + seconds * 1000 * (share + (1 - share) * r / (restarts - 1));\n   127\t    const jittered = domains.map(d => d.map(x => ({ x, k: x.cost * (0.5 + rand()) + rand() })).sort((a, b) => a.k - b.k).map(e => e.x));\n   128\t    recurse(jittered, jittered.map(minCost), 0, false);\n   129\t  }\n   130\t  return { best, cost: bestCost, nodes, complete };\n   131\t}\n   132\t\n   133\texport function fitScheme(cfg, scheme, hueClips, seconds, step, restarts = 1) {\n   134\t  const tokens = { ...SCHEME_TOKENS[scheme], ...(cfg.tokens?.[scheme] ?? {}) };   // a config may try other token colors\n   135\t  // A neutral's hue is barely defined, so its dark box is centred on the light result's hue rather than its own target.\n   136\t  const centred = (s, k) => (s.neutral && hueClips?.[k] ? { target: [s[scheme].target[0], s[scheme].target[1], hueClips[k].h] } : {});\n   137\t  const domains = cfg.slots.map((s, k) => candidates(k, { ...s[scheme], neutral: !!s.neutral, ...centred(s, k), ...(step ? { step } : {}) }, tokens, hueClips?.[k]));\n   138\t  const sizes = domains.map(d => d.length);\n   139\t  if (sizes.some(x => x === 0)) return { scheme, sizes, best: null };\n   140\t  const r = search(domains, seconds, compatible, restarts);\n   141\t  return { scheme, sizes, ...r };\n   142\t}\n   143\t\n   144\tif (process.argv[1] === fileURLToPath(import.meta.url)) {\n   145\t  const args = Object.fromEntries(process.argv.slice(2).map(a => a.replace(/^--/, '').split('=')).map(([k, v]) => [k, v ?? 'true']));\n   146\t  const cfg = JSON.parse(fs.readFileSync(args.config, 'utf8'));\n   147\t  const seconds = +(args.seconds ?? 60);\n   148\t  // What-if runs only: --minDelta=, --prefix4=, --composite=, --token= override a threshold for this run.\n   149\t  // A config's solverLimits are margins the search keeps above the tested limits (fit-final.json); the command-line\n   150\t  // overrides --minDelta=, --prefix4=, --composite=, --token= are for what-if runs.\n   151\t  for (const [k, v] of Object.entries(cfg.solverLimits ?? {})) { T[k] = v; console.log(`solver limit ${k} = ${v}`); }\n   152\t  for (const k of ['minDelta', 'prefix4', 'composite', 'token']) if (args[k]) { T[k] = +args[k]; console.log(`override ${k} = ${T[k]}`); }\n   153\t  if (args.box !== undefined) { OPTIONS.box = +args.box; console.log(`fills checked within ${OPTIONS.box} byte(s)`); }\n   154\t  const hueClip = +(args.hueClip ?? cfg.hueClip ?? T.hueMatch - 2);   // largest light/dark hue shift the dark search may use\n   155\t  const step = args.step ? args.step.split(',').map(Number) : null;   // --step=L,C,h overrides every box's grid\n   156\t  const restarts = +(args.restarts ?? 1);                              // --restarts=N: see search()\n   157\t  // --light=#hex,... skips the light search and solves only the dark scheme against that light set.\n   158\t  const fixed = args.light ? args.light.split(',') : null;\n   159\t  const light = fixed\n   160\t    ? { sizes: fixed.map(() => 1), nodes: 0, complete: true, cost: 0, best: fixed.map(hex => ({ hex, lch: lch(hex) })) }\n   161\t    : fitScheme(cfg, 'light', null, seconds, step, restarts);\n   162\t  console.log('light domains', light.sizes.join(' '), 'nodes', light.nodes, light.complete ? 'complete' : 'timed out', 'cost', light.cost?.toFixed?.(3));\n   163\t  if (!light.best) { console.log('no light solution'); process.exit(1); }\n   164\t  console.log('light', light.best.map(c => c.hex).join(' '));\n   165\t  const clips = light.best.map((c, k) => ({ h: c.lch[2], max: cfg.slots[k].neutral ? T.hueMatch - 2 : hueClip })); // neutrals too: the test checks every slot\n   166\t  const dark = fitScheme(cfg, 'dark', clips, seconds, step, restarts);\n   167\t  console.log('dark domains', dark.sizes.join(' '), 'nodes', dark.nodes, dark.complete ? 'complete' : 'timed out', 'cost', dark.cost?.toFixed?.(3));\n   168\t  if (!dark.best) { console.log('no dark solution'); process.exit(1); }\n   169\t  console.log('dark', dark.best.map(c => c.hex).join(' '));\n   170\t  const out = { config: path.basename(args.config, '.json'), light: light.best.map(c => c.hex), dark: dark.best.map(c => c.hex),\n   171\t    lch: { light: light.best.map(c => c.lch.map(v => +v.toFixed(3))), dark: dark.best.map(c => c.lch.map(v => +v.toFixed(3))) },\n   172\t    cost: { light: +light.cost.toFixed(3), dark: +dark.cost.toFixed(3) }, complete: { light: light.complete, dark: dark.complete } };\n   173\t  fs.writeFileSync(args.out ?? path.join(here, 'candidates', `${out.config}.json`), JSON.stringify(out, null, 1) + '\\n');\n   174\t}\n{\n \"note\": \"Shipped palette (refit after the review of 51e1be5). Light: the best annealing result for configs/tier-44-free.json (anneal.mjs, seed 22); dark: the best annealing result for configs/dark-c.json against that light set (seed 601). Both are refitted here inside small boxes, with solver margins (fills 0.063, pairwise 0.102, both analytic and in bytes; contrast 3.02), so the exact search completes and the run is deterministic. In these boxes 0.065/0.103 and 0.066/0.102 are proved infeasible.\",\n \"hueClip\": 15,\n \"solverLimits\": {\n  \"composite\": 0.063,\n  \"minDelta\": 0.102\n },\n \"tokens\": {\n  \"dark\": {\n   \"focus\": \"#e3e8f0\"\n  }\n },\n \"slots\": [\n  {\n   \"name\": \"blue\",\n   \"neutral\": false,\n   \"light\": {\n    \"target\": [\n     0.6598,\n     0.1497,\n     254.09\n    ],\n    \"L\": [\n     0.6398,\n     0.6798\n    ],\n    \"C\": [\n     0.1297,\n     0.1697\n    ],\n    \"hr\": 5,\n    \"step\": [\n     0.005,\n     0.005,\n     1\n    ]\n   },\n   \"dark\": {\n    \"target\": [\n     0.7304,\n     0.1303,\n     251.82\n    ],\n    \"L\": [\n     0.7104,\n     0.7504\n    ],\n    \"C\": [\n     0.1103,\n     0.1503\n    ],\n    \"hr\": 5,\n    \"step\": [\n     0.005,\n     0.005,\n     1\n    ]\n   }\n  },\n  {\n   \"name\": \"orange\",\n   \"neutral\": false,\n   \"light\": {\n    \"target\": [\n     0.679,\n     0.1699,\n     52.89\n    ],\n    \"L\": [\n     0.659,\n     0.699\n    ],\n    \"C\": [\n     0.1499,\n     0.1899\n    ],\n    \"hr\": 5,\n    \"step\": [\n     0.005,\n     0.005,\n     1\n    ]\n   },\n   \"dark\": {\n    \"target\": [\n     0.6809,\n     0.1502,\n     53.98\n    ],\n    \"L\": [\n     0.6609,\n     0.7009\n    ],\n    \"C\": [\n     0.1302,\n     0.1702\n    ],\n    \"hr\": 5,\n    \"step\": [\n     0.005,\n     0.005,\n     1\n    ]\n   }\n  },\n  {\n   \"name\": \"green\",\n   \"neutral\": false,\n   \"light\": {\n    \"target\": [\n     0.4402,\n     0.1403,\n     141.08\n    ],\n    \"L\": [\n","exit_code":0,"status":"completed"}}
