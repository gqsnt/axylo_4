};\n   131\t  });\n   132\t  await Promise.all(handles.map(h => h.ready));\n   133\t  const tReady = performance.now();\n   134\t  await raf();\n   135\t  const tReadyFrame = performance.now();\n   136\t  if (profiled) await metrics('create:ready'); // profiled runs only: splits the profile into active and settle parts\n   137\t  await sleep(settleMs);\n   138\t  await metrics('create:end');\n   139\t  const tEnd = performance.now();\n   140\t  const backing = canvasBacking();\n   141\t  if (memoryWanted) await memory('chart');\n   142\t  return {\n   143\t    timing: { syncMs: r3(tSync - t0), readyMs: r3(tReady - t0), readyFrameMs: r3(tReadyFrame - t0), windowMs: r3(tEnd - t0), settleMs },\n   144\t    canvasBacking: backing,\n   145\t    callerColumnBytes: fixtures.reduce((s, f) => s + f.x.byteLength + f.ys.reduce((t, c) => t + c.byteLength, 0), 0),\n   146\t    describe: describeAll(handles),\n   147\t  };\n   148\t}\n   149\t\n   150\t// The producer: a worker with its own timers, so samples are due on a 60 Hz schedule whatever the page's main\n   151\t// thread and animation frames are doing. It sends the sequence number, the scheduled time and the send time, both\n   152\t// converted to the page's time base.\n   153\tconst PRODUCER = `\n   154\tonmessage = e => {\n   155\t  const { startAt, pageOrigin, period, count } = e.data;\n   156\t  const shift = pageOrigin - performance.timeOrigin; // page time = worker time - shift\n   157\t  const t0 = startAt + shift;\n   158\t  let k = 0;\n   159\t  const tick = () => {\n   160\t    const now = performance.now();\n   161\t    while (k < count && t0 + k * period <= now) { postMessage({ seq: k, due: t0 + k * period - shift, sent: now - shift }); k++; }\n   162\t    if (k < count) setTimeout(tick, Math.max(0, t0 + k * period - performance.now()));\n   163\t  };\n   164\t  setTimeout(tick, Math.max(0, t0 - performance.now()));\n   165\t};`;\n   166\t\n   167\t// W-stream: a window chart fed by the producer. Visibility is read from the chart's own draw record\n   168\t// (adapter.drawnNewestX), in an animation-frame callback registered after the append that needs it, so it runs\n   169\t// after any frame callback the library itself registered for that append. Frame pacing keeps recording after the\n   170\t// last sample until it covers P3's window of `samples` intervals from the first due time.\n   171\tasync function runStream(adapter, fix, el) {\n   172\t  const N = fix.samples, period = 1000 / 60;\n   173\t  await metrics('create:start');\n   174\t  const handle = await inTask(() => adapter.create(el, { x: fix.initial.x, ys: fix.initial.ys, names: fix.names }, { window: fix.window, params: adapterParams }));\n   175\t  await handle.ready;\n   176\t  await sleep(settleMs);\n   177\t  await metrics('create:end');\n   178\t\n   179\t  const due = new Float64Array(N).fill(NaN), sent = new Float64Array(N).fill(NaN), received = new Float64Array(N).fill(NaN);\n   180\t  const visible = new Float64Array(N).fill(NaN), visibleFrame = new Float64Array(N).fill(NaN), appendMs = new Float64Array(N).fill(NaN);\n   181\t  const x0 = fix.stream.x[0];\n   182\t  const frames = [];\n   183\t  let receivedCount = 0, visibleCount = 0, coalesced = 0, framesWithNew = 0, maxBacklog = 0, readerPending = false, pacing = true;\n   184\t  let prevFrameNow = NaN, startAt = NaN;\n   185\t  let finish;\n   186\t  const finished = new Promise(r => { finish = r; });\n   187\t  let framesDone;\n   188\t  const framesCovered = new Promise(r => { framesDone = r; });\n   189\t  const dueBy = t => Math.max(0, Math.min(N, Math.floor((t - startAt) / period) + 1));\n   190\t\n   191\t  // Frame pacing loop. Its callback runs first in each frame (registered earliest), so it accounts the previous\n   192\t  // frame: by then that frame's visibility has been read.\n   193\t  const pace = ts => {\n   194\t    if (!Number.isNaN(prevFrameNow)) maxBacklog = Math.max(maxBacklog, dueBy(prevFrameNow) - visibleCount);\n   195\