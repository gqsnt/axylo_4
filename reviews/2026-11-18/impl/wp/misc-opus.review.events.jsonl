/ (ink[ch] - back[ch]); if (v > 0.02) cov.push(Math.min(1, v)); }\n    62\t          cols.push(cov);\n    63\t        }\n    64\t        out[via + '@' + dpr] = cols;\n    65\t      }\n    66\t      return out;\n    67\t    }, { color, bg: t.background });\n    68\t    const ink = srgb(color), bg = srgb(t.background);\n    69\t    const at = k => contrast(toHex(ink.map((v, i) => bg[i] + k * (v - bg[i]))), t.background);\n    70\t    const stats = xs => { xs.sort((a, b) => a - b); return { p10: +xs[Math.floor(xs.length * 0.1)].toFixed(2), median: +xs[Math.floor(xs.length / 2)].toFixed(2) }; };\n    71\t    const row = { color, swatch: +contrast(color, t.background).toFixed(2) };\n    72\t    for (const [k, cols] of Object.entries(columns)) {\n    73\t      const used = cols.filter(cv => cv.length);\n    74\t      row[k] = {\n    75\t        core: stats(used.map(cv => at(Math.max(...cv)))),\n    76\t        weighted: stats(used.map(cv => at(cv.reduce((a, x) => a + x * x, 0) / cv.reduce((a, x) => a + x, 0)))),\n    77\t      };\n    78\t    }\n    79\t    rows.push(row);\n    80\t    console.log(scheme, color, JSON.stringify(row));\n    81\t  }\n    82\t  result.schemes[scheme] = { background: t.background, rows };\n    83\t}\n    84\tawait browser.close();\n    85\tfs.writeFileSync(args.out ?? path.join(here, 'strokes.json'), JSON.stringify(result, null, 1) + '\\n');\nrandom-walk polyline (120 points over 600 CSS px, steps up to ±9 px), stroke width 2, round joins; per pixel column, core = most covered pixel, weighted = coverage-weighted mean of touched pixels (coverage > 0.02); p10 and median over columns 157.0.8103.78\nlight [\n  [\n    '#4a94eb',\n    [ 3.12, 2.47, 2.57 ],\n    [ 3.12, 2.47, 2.57 ],\n    [ 3.12, 2.75, 2.84 ],\n    [ 3.12, 2.75, 2.84 ]\n  ],\n  [\n    '#e97200',\n    [ 3.06, 2.5, 2.59 ],\n    [ 3.06, 2.48, 2.59 ],\n    [ 3.06, 2.75, 2.81 ],\n    [ 3.06, 2.75, 2.81 ]\n  ],\n  [\n    '#136102',\n    [ 7.67, 4.89, 5.27 ],\n    [ 7.67, 4.88, 5.27 ],\n   