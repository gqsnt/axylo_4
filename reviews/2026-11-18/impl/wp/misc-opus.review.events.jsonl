{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"nl -ba research/palette/anneal.mjs && nl -ba research/palette/fit.mjs | sed -n '1,143p' && sed -n '1,32p' research/palette/configs/tier-46-cr.json && nl -ba research/palette/color.mjs | sed -n '1,117p'\"","aggregated_output":"     1\t// Feasibility search over wide boxes (decision 0003). fit.mjs's branch and bound is exact but finds nothing in\n     2\t// reasonable time when the feasible region is small and far from the targets; this script searches the same\n     3\t// grids (fit.mjs `candidates`) with simulated annealing on the amount of violation, so it can find palettes the\n     4\t// exact search cannot reach, but it proves nothing. Its output is meant to be polished: a small box around each\n     5\t// color, solved to completion by fit.mjs (see configs/fit-final.json).\n     6\t//\n     7\t// State: one grid color per slot. Score: 100 × total violation + target cost, where violation sums, over every pair\n     8\t// and vision, how far a difference falls short of its limit (analytic and after byte rounding), and over neighbours\n     9\t// how far the fills fall short (ideal, and worst case within one byte of the 8-bit model). Moves re-pick one slot.\n    10\t//\n    11\t//   node research/palette/anneal.mjs --config=configs/x.json [--scheme=light] [--light=#…,…] [--seed=1] [--seeds=4]\n    12\t//        [--steps=400000] [--out=file.json]\n    13\timport fs from 'node:fs';\n    14\timport path from 'node:path';\n    15\timport { fileURLToPath } from 'node:url';\n    16\timport { THRESHOLDS as T, VISIONS, dist, lch } from './color.mjs';\n    17\timport { OPTIONS, SCHEME_TOKENS, candidates } from './fit.mjs';\n    18\t\n    19\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    20\tconst args = Object.fromEntries(process.argv.slice(2).map(a => a.replace(/^--/, '').split('=')).map(([k, v]) => [k, v ?? 'true']));\n    21\tconst cfg = JSON.parse(fs.readFileSync(args.config, 'utf8'));\n    22\tconst scheme = args.scheme ?? 'light';\n    23\tif (args.box !== undefined) OPTIONS.box = +args.box;   // --box=0: fills on the byte model only (what-if)\n    24\tconst tokens = { ...SCHEME_TOKENS[scheme], ...(cfg.tokens?.[scheme] ?? {}) };\n    25\tconst hueClip = +(args.hueClip ?? cfg.hueClip ?? T.hueMatch - 2);\n    26\tconst lightSet = args.light ? args.light.split(',') : null;\n    27\tif (scheme === 'dark' && !lightSet) throw new Error('--light=#…,… is required for the dark scheme');\n    28\tconst clips = lightSet ? lightSet.map((h, k) => ({ h: lch(h)[2], max: cfg.slots[k].neutral ? T.hueMatch - 2 : hueClip })) : null;\n    29\t// A neutral's hue is barely defined, so its dark box is centred on the light result's hue rather than its own target.\n    30\tconst centred = (s, k) => (s.neutral && clips?.[k] ? { target: [s[scheme].target[0], s[scheme].target[1], clips[k].h] } : {});\n    31\tconst domains = cfg.slots.map((s, k) => candidates(k, { ...s[scheme], neutral: !!s.neutral, ...centred(s, k) }, tokens, clips?.[k]));\n    32\t// --start=#…,… begins from a given palette (each color is added to its slot's grid, priced by that slot's target);\n    33\t// with it, the walk keeps every accepted state feasible once it is, so it moves along the feasible region.\n    34\tconst start = args.start ? args.start.split(',') : null;\n    35\tconst startIndex = start ? start.map((hex, k) => {\n    36\t  const [l, c, h] = lch(hex), box = cfg.slots[k][scheme];\n    37\t  const one = candidates(k, { ...box, neutral: !!cfg.slots[k].neutral, L: [l, l], C: [c, c], hr: 0, target: box.target, step: [1, 1, 1], at: h }, tokens, null, hex);\n    38\t  if (!one.length) throw new Error(`start color ${hex} fails on its own (contrast or tokens)`);\n    39\t  domains[k].push(one[0]);\n    40\t  return domains[k].length - 1;\n    41\t}) : null;\n    42\tconsole.log(scheme, 'domains', domains.map(d => d.length).join(' '));\n    43\tconst n = domains.length;\n    44\t\n    45\tconst short = (d, limit) => (d < limit ? limit - d : 0);\n    46\tfunction fillShort(fa, fb) {\n    47\t  const c = dist(fa.centre, fb.centre);\n    48\t  let s = short(dist(fa.ideal, fb.ideal), T.composite) + short(c, T.composite) + short(dist(fa.floor, fb.floor), T.composite);\n    49\t  if (!OPTIONS.box || c - fa.radius - fb.radius >= T.composite) return s;\n    50\t  let m = Infinity;\n    51\t  for (const p of fa.box) for (const q of fb.box) { const d = dist(p, q); if (d < m) m = d; }\n    52\t  return s + short(m, T.composite);\n    53\t}\n    54\tfunction violation(i, a, j, b) {\n    55\t  const limit = i < 4 && j < 4 ? T.prefix4 : T.minDelta;\n    56\t  let s = 0;\n    57\t  for (let v = 0; v < VISIONS.length; v++) s += short(dist(a.labs[v], b.labs[v]), limit) + short(dist(a.labsBytes[v], b.labsBytes[v]), limit);\n    58\t  if (Math.abs(i - j) === 1) for (let k = 0; k < T.alphas.length; k++) s += fillShort(a.fills[k], b.fills[k]);\n    59\t  return s;\n    60\t}\n    61\tfunction rng(seed) { let s = seed >>> 0; return () => { s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\n    62\t\n    63\tfunction run(seed, steps) {\n    64\t  const r = rng(seed);\n    65\t  const pick = k => domains[k][Math.floor(r() * domains[k].length)];\n    66\t  let state = startIndex ? startIndex.map((i, k) => domains[k][i]) : domains.map((d, k) => pick(k));\n    67\t  const V = Array.from({ length: n }, () => new Array(n).fill(0));\n    68\t  for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) V[i][j] = V[j][i] = violation(i, state[i], j, state[j]);\n    69\t  let viol = 0; for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) viol += V[i][j];\n    70\t  let cost = state.reduce((a, x) => a + x.cost, 0);\n    71\t  let best = null;\n    72\t  for (let step = 0; step < steps; step++) {\n    73\t    const Tm = 2 * Math.pow(1e-3, step / steps);\n    74\t    const k = Math.floor(r() * n), x = pick(k);\n    75\t    let dv = 0; const row = new Array(n).fill(0);\n    76\t    for (let j = 0; j < n; j++) if (j !== k) { row[j] = violation(k, x, j, state[j]); dv += row[j] - V[k][j]; }\n    77\t    const dc = x.cost - state[k].cost, dScore = 100 * dv + dc;\n    78\t    if (startIndex && viol < 1e-12 && viol + dv > 1e-12) continue;   // stay feasible once feasible\n    79\t    if (dScore <= 0 || r() < Math.exp(-dScore / Tm)) {\n    80\t      state[k] = x; viol += dv; cost += dc;\n    81\t      for (let j = 0; j < n; j++) if (j !== k) V[k][j] = V[j][k] = row[j];\n    82\t      if (viol < 1e-12 && (!best || cost < best.cost)) best = { cost, hex: state.map(s => s.hex) };\n    83\t    }\n    84\t  }\n    85\t  const worst = [];\n    86\t  for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) if (V[i][j] > 0) worst.push(`${i + 1}-${j + 1}:${V[i][j].toFixed(4)}`);\n    87\t  return { best, finalViolation: viol, worst: worst.join(' '), final: state.map(s => s.hex) };\n    88\t}\n    89\t\n    90\tconst seeds = +(args.seeds ?? 4), steps = +(args.steps ?? 400000), first = +(args.seed ?? 1), results = [];\n    91\tfor (let s = first; s < first + seeds; s++) {\n    92\t  const { best, finalViolation, worst, final } = run(s * 7919 + 13, steps);\n    93\t  console.log('seed', s, best ? `feasible, cost ${best.cost.toFixed(2)}: ${best.hex.join(' ')}` : `no feasible palette (final violation ${finalViolation.toFixed(4)}; short pairs ${worst}; ${final.join(' ')})`);\n    94\t  if (best) results.push({ seed: s, ...best });\n    95\t}\n    96\tresults.sort((a, b) => a.cost - b.cost);\n    97\tconst out = { config: path.basename(args.config, '.json'), scheme, light: lightSet, results };\n    98\tfs.writeFileSync(args.out ?? path.join(here, 'candidates', `anneal-${out.config}-${scheme}.json`), JSON.stringify(out, null, 1) + '\\n');\n     1\t// Nearest feasible palette to a hand-designed target (decision 0003). Plain Node, no dependencies.\n     2\t//\n     3\t// The designer writes a target color per slot in OKLCH and a box around it (lightness, chroma, hue ranges) for\n     4\t// each scheme (configs/fit-*.json). This script lays a grid over each box (8-bit-rounded hex, so what is scored is\n     5\t// what ships), drops grid colors that fail on their own (contrast, gamut, distance to the focus, reference and\n     6\t// muted tokens), and then runs a branch-and-bound search over slots with forward checking on the pairwise\n     7\t// constraints (minimum OKLab difference under four visions, 0.14 inside the first four; neighbour composites at\n     8\t// 25% and 80%). The cost is the weighted squared distance from the target, so the result is the feasible palette\n     9\t// closest to what was asked for, on that grid. Pairwise differences are required both analytically and after the\n    10\t// simulated colors are rounded to bytes; fills both ideally and on an 8-bit raster, at the worst case within one\n    11\t// byte per channel. The light scheme is solved first; the dark scheme's hue boxes are then clipped to within\n    12\t// `hueClip` degrees of the light result per slot (default 28, under constraint 4's 30).\n    13\t//\n    14\t//   node research/palette/fit.mjs --config=research/palette/configs/fit-x.json [--seconds=60] [--out=file.json]\n    15\timport fs from 'node:fs';\n    16\timport path from 'node:path';\n    17\timport { fileURLToPath } from 'node:url';\n    18\timport { OPTIONS, THRESHOLDS as T, TOKEN_NAMES, VISIONS, byteBox, compositeLinear, contrast, dist, hueDiff, labOfBytes, labUnder, labUnderBytes, lch, lchToHex, oklab, rasterFill } from './color.mjs';\n    19\t\n    20\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    21\texport const SCHEME_TOKENS = {\n    22\t  light: { background: '#ffffff', focus: '#1f5fcc', reference: '#474b55', muted: '#62666f' },\n    23\t  dark: { background: '#16181d', focus: '#79a8ff', reference: '#bcc0c9', muted: '#9da2ad' },\n    24\t};\n    25\t\n    26\t// Solver-only margins, stricter than the tests: contrast at least 3.02:1, so a contrast computed with slightly\n    27\t// different rounding still passes; translucent fills checked at the worst case within one byte per channel of the\n    28\t// byte model when OPTIONS.box is 1 (--box=1), because rasterizers round alpha and channels differently; by default\n    29\t// both byte models (alpha rounded and floored) are required and the one-byte worst case is only recorded.\n    30\tconst CONTRAST_MARGIN = 0.02;\n    31\texport { OPTIONS };\n    32\t\n    33\texport function candidates(slot, box, tokens, hueClip, exactHex = null) {\n    34\t  const out = new Map();\n    35\t  const [tL, tC, tH] = box.target, [wL, wC, wH] = box.weights ?? [1, 1, 1];\n    36\t  const step = box.step ?? [0.01, 0.01, 2];\n    37\t  for (let L = box.L[0]; L <= box.L[1] + 1e-9; L += step[0])\n    38\t    for (let C = box.C[0]; C <= box.C[1] + 1e-9; C += step[1])\n    39\t      for (let dh = -box.hr; dh <= box.hr + 1e-9; dh += step[2]) {\n    40\t        const hex = exactHex ?? lchToHex([L, C, (tH + dh + 360) % 360]);   // exactHex: price one given color\n    41\t        if (!hex || out.has(hex)) continue;\n    42\t        if (contrast(hex, tokens.background) < T.contrast + CONTRAST_MARGIN) continue;\n    43\t        const labs = VISIONS.map(v => labUnder(hex, v));\n    44\t        if (TOKEN_NAMES.some(t => dist(labs[0], labUnder(tokens[t], 'normal')) < T.token)) continue;\n    45\t        const [l, c, h] = lch(hex);\n    46\t        if (hueClip && hueDiff(h, hueClip.h) > hueClip.max) continue;\n    47\t        const cost = wL * ((l - tL) / 0.05) ** 2 + wC * ((c - tC) / 0.03) ** 2 + (box.neutral ? 0 : wH * (hueDiff(h, tH) / 10) ** 2);\n    48\t        const labsBytes = VISIONS.map(v => labUnderBytes(hex, v));\n    49\t        // Fills: ideal composite, byte-model pixel, and the lattice within OPTIONS.box bytes of it with its radius.\n    50\t        const fills = T.alphas.map(a => {\n    51\t          const px = rasterFill(hex, a, tokens.background), centre = labOfBytes(px);\n    52\t          const floor = labOfBytes(rasterFill(hex, a, tokens.background, Math.floor));\n    53\t          const box = byteBox(px, OPTIONS.box).map(labOfBytes);\n    54\t          return { ideal: oklab(compositeLinear(hex, a, tokens.background)), centre, floor, box, radius: Math.max(...box.map(q => dist(q, centre))) };\n    55\t        });\n    56\t        out.set(hex, { hex, labs, labsBytes, fills, cost, lch: [l, c, h] });\n    57\t      }\n    58\t  return [...out.values()].sort((a, b) => a.cost - b.cost);\n    59\t}\n    60\t\n    61\t/** Worst-case distance between two fills' byte lattices: exact only when the cheap triangle bound is not enough. */\n    62\tfunction fillsApart(fa, fb) {\n    63\t  if (dist(fa.ideal, fb.ideal) < T.composite) return false;\n    64\t  const c = dist(fa.centre, fb.centre);\n    65\t  if (c < T.composite || dist(fa.floor, fb.floor) < T.composite) return false;   // both byte models\n    66\t  if (!OPTIONS.box) return true;\n    67\t  if (c - fa.radius - fb.radius >= T.composite) return true;\n    68\t  if (c < T.composite) return false;\n    69\t  for (const p of fa.box) for (const q of fb.box) if (dist(p, q) < T.composite) return false;\n    70\t  return true;\n    71\t}\n    72\t\n    73\texport function compatible(i, a, j, b) {\n    74\t  const limit = i < 4 && j < 4 ? T.prefix4 : T.minDelta;\n    75\t  for (let v = 0; v < VISIONS.length; v++) {\n    76\t    if (dist(a.labs[v], b.labs[v]) < limit) return false;               // analytic (constraint 2, 3)\n    77\t    if (dist(a.labsBytes[v], b.labsBytes[v]) < limit) return false;     // after rounding the simulation to bytes\n    78\t  }\n    79\t  if (Math.abs(i - j) === 1) for (let k = 0; k < T.alphas.length; k++) if (!fillsApart(a.fills[k], b.fills[k])) return false;\n    80\t  return true;\n    81\t}\n    82\t\n    83\t/**\n    84\t * Branch and bound with forward checking. Returns the cheapest assignment found within the time limit.\n    85\t * With restarts > 1, the first half of the time goes to the exact cost-ordered search and the rest is split\n    86\t * between restarts that try values in a jittered cost order (seeded, so runs repeat), sharing the best bound.\n    87\t * Only the first pass can prove that nothing exists; `complete` reports whether it finished.\n    88\t */\n    89\texport function search(domains, seconds, compat = compatible, restarts = 1) {\n    90\t  const n = domains.length, start = Date.now();\n    91\t  let best = null, bestCost = Infinity, nodes = 0, complete = true, deadline = 0;\n    92\t  const assigned = new Array(n).fill(null);\n    93\t  const minCost = d => { let m = Infinity; for (const x of d) if (x.cost < m) m = x.cost; return m; };\n    94\t  function recurse(doms, mins, cost, sorted) {\n    95\t    if (Date.now() > deadline) return false;\n    96\t    nodes++;\n    97\t    let pick = -1;   // most constrained unassigned slot first\n    98\t    for (let s = 0; s < n; s++) if (assigned[s] === null && (pick < 0 || doms[s].length < doms[pick].length)) pick = s;\n    99\t    if (pick < 0) { if (cost < bestCost) { bestCost = cost; best = assigned.slice(); } return true; }\n   100\t    let bound = cost;\n   101\t    for (let s = 0; s < n; s++) if (assigned[s] === null) bound += mins[s];\n   102\t    if (bound >= bestCost) return true;\n   103\t    for (const cand of doms[pick]) {\n   104\t      const rest = bound - mins[pick] + cand.cost;\n   105\t      if (rest >= bestCost) { if (sorted) break; continue; }\n   106\t      assigned[pick] = cand;\n   107\t      const next = doms.slice(), nextMins = mins.slice();\n   108\t      let ok = true, nb = cost + cand.cost;\n   109\t      for (let s = 0; s < n && ok; s++) {\n   110\t        if (assigned[s] !== null) continue;\n   111\t        const f = doms[s].filter(x => compat(pick, cand, s, x));\n   112\t        if (!f.length) ok = false; else { next[s] = f; nextMins[s] = sorted ? f[0].cost : minCost(f); nb += nextMins[s]; }\n   113\t      }\n   114\t      const finished = ok && nb < bestCost ? recurse(next, nextMins, cost + cand.cost, sorted) : true;\n   115\t      assigned[pick] = null;\n   116\t      if (!finished || Date.now() > deadline) return false;\n   117\t    }\n   118\t    return true;\n   119\t  }\n   120\t  const share = restarts > 1 ? 0.5 : 1;\n   121\t  deadline = start + seconds * 1000 * share;\n   122\t  complete = recurse(domains, domains.map(d => d[0]?.cost ?? Infinity), 0, true);\n   123\t  let seed = 1;\n   124\t  const rand = () => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; };\n   125\t  for (let r = 1; r < restarts; r++) {\n   126\t    deadline = start + seconds * 1000 * (share + (1 - share) * r / (restarts - 1));\n   127\t    const jittered = domains.map(d => d.map(x => ({ x, k: x.cost * (0.5 + rand()) + rand() })).sort((a, b) => a.k - b.k).map(e => e.x));\n   128\t    recurse(jittered, jittered.map(minCost), 0, false);\n   129\t  }\n   130\t  return { best, cost: bestCost, nodes, complete };\n   131\t}\n   132\t\n   133\texport function fitScheme(cfg, scheme, hueClips, seconds, step, restarts = 1) {\n   134\t  const tokens = { ...SCHEME_TOKENS[scheme], ...(cfg.tokens?.[scheme] ?? {}) };   // a config may try other token colors\n   135\t  // A neutral's hue is barely defined, so its dark box is centred on the light result's hue rather than its own target.\n   136\t  const centred = (s, k) => (s.neutral && hueClips?.[k] ? { target: [s[scheme].target[0], s[scheme].target[1], hueClips[k].h] } : {});\n   137\t  const domains = cfg.slots.map((s, k) => candidates(k, { ...s[scheme], neutral: !!s.neutral, ...centred(s, k), ...(step ? { step } : {}) }, tokens, hueClips?.[k]));\n   138\t  const sizes = domains.map(d => d.length);\n   139\t  if (sizes.some(x => x === 0)) return { scheme, sizes, best: null };\n   140\t  const r = search(domains, seconds, compatible, restarts);\n   141\t  return { scheme, sizes, ...r };\n   142\t}\n   143\t\n{\n \"note\": \"three tiers, restrained chroma, cyan before red, nothing below L 0.46\",\n \"hueClip\": 15,\n \"slots\": [\n  {\n   \"name\": \"blue\",\n   \"light\": {\n    \"target\": [\n     0.66,\n     0.15,\n     252\n    ],\n    \"L\": [\n     0.62,\n     0.7\n    ],\n    \"C\": [\n     0.11,\n     0.18\n    ],\n    \"hr\": 10,\n    \"weights\": [\n     2,\n     1,\n     1\n    ],\n    \"step\": [\n     0.01,\n     0.01,\n     3\n    ]\n   },\n     1\t// Pure color math and the palette constraints of decision 0003, shared by the solver, the scorer and the\n     2\t// preview. No dependencies, no I/O. The formulas match research/harness/palette.mjs, which scored the ten\n     3\t// libraries in finding R7: WCAG 2 relative luminance and contrast; OKLab (Ottosson 2020); color-vision\n     4\t// deficiency simulated with the Machado, Oliveira and Fernandes (2009) matrices at severity 1.0, applied in\n     5\t// linear RGB and clamped to [0, 1] before the OKLab conversion.\n     6\t\n     7\texport const lin = v => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);\n     8\texport const gam = v => (v <= 0.0031308 ? 12.92 * v : 1.055 * v ** (1 / 2.4) - 0.055);\n     9\tconst clamp01 = v => (v < 0 ? 0 : v > 1 ? 1 : v);\n    10\t\n    11\t/** '#rrggbb' -> gamma-encoded sRGB channels in [0, 1]. */\n    12\texport const srgb = hex => [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16) / 255);\n    13\t/** Gamma-encoded sRGB in [0, 1] -> '#rrggbb' (clamped, rounded). */\n    14\texport const toHex = rgb => '#' + rgb.map(v => Math.round(255 * clamp01(v)).toString(16).padStart(2, '0')).join('');\n    15\texport const linear = hex => srgb(hex).map(lin);\n    16\t\n    17\texport const luminance = hex => { const [r, g, b] = linear(hex); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };\n    18\texport const contrast = (a, b) => { const [x, y] = [luminance(a), luminance(b)].sort((p, q) => q - p); return (x + 0.05) / (y + 0.05); };\n    19\t\n    20\t/** Linear sRGB -> OKLab [L, a, b]. */\n    21\texport function oklab([r, g, b]) {\n    22\t  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);\n    23\t  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);\n    24\t  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);\n    25\t  return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,\n    26\t    1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,\n    27\t    0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];\n    28\t}\n    29\t\n    30\t/** OKLab -> linear sRGB (may be out of gamut). */\n    31\texport function oklabToLinear([L, a, b]) {\n    32\t  const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;\n    33\t  const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;\n    34\t  const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;\n    35\t  return [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,\n    36\t    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,\n    37\t    -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s];\n    38\t}\n    39\t\n    40\t/** OKLCH (hue in degrees) -> '#rrggbb', or null when outside the sRGB gamut. */\n    41\texport function lchToHex([L, C, h]) {\n    42\t  const rad = h * Math.PI / 180;\n    43\t  const rgb = oklabToLinear([L, C * Math.cos(rad), C * Math.sin(rad)]);\n    44\t  if (!rgb.every(v => v >= -1e-4 && v <= 1 + 1e-4)) return null;\n    45\t  return toHex(rgb.map(v => gam(clamp01(v))));\n    46\t}\n    47\t\n    48\t/** '#rrggbb' -> OKLCH [L, C, h°]. */\n    49\texport function lch(hex) {\n    50\t  const [L, a, b] = oklab(linear(hex));\n    51\t  const h = (Math.atan2(b, a) * 180 / Math.PI + 360) % 360;\n    52\t  return [L, Math.hypot(a, b), h];\n    53\t}\n    54\t\n    55\texport const hueDiff = (h1, h2) => { const d = Math.abs(h1 - h2) % 360; return d > 180 ? 360 - d : d; };\n    56\t\n    57\texport const CVD = {\n    58\t  normal: [[1, 0, 0], [0, 1, 0], [0, 0, 1]],\n    59\t  protan: [[0.152286, 1.052583, -0.204868], [0.114503, 0.786281, 0.099216], [-0.003882, -0.048116, 1.051998]],\n    60\t  deutan: [[0.367322, 0.860646, -0.227968], [0.280085, 0.672501, 0.047413], [-0.011820, 0.042940, 0.968881]],\n    61\t  tritan: [[1.255528, -0.076749, -0.178779], [-0.078411, 0.930809, 0.147602], [0.004733, 0.691367, 0.303900]],\n    62\t};\n    63\texport const VISIONS = Object.keys(CVD);\n    64\t\n    65\t/** Linear RGB as seen under a vision (clamped), for previews and grayscale. */\n    66\texport const simulateLinear = (rgbLin, vision) => CVD[vision].map(row => clamp01(row[0] * rgbLin[0] + row[1] * rgbLin[1] + row[2] * rgbLin[2]));\n    67\t/** OKLab of a hex color under a vision. */\n    68\texport const labUnder = (hex, vision) => oklab(simulateLinear(linear(hex), vision));\n    69\texport const dist = (p, q) => Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]);\n    70\texport const distUnder = (h1, h2, vision) => dist(labUnder(h1, vision), labUnder(h2, vision));\n    71\t\n    72\t/** Source-over compositing of `hex` at `alpha` over an opaque background, in gamma-encoded sRGB as browsers do. */\n    73\texport function compositeHex(hex, alpha, bgHex) {\n    74\t  const f = srgb(hex), b = srgb(bgHex);\n    75\t  return toHex(f.map((v, i) => v * alpha + b[i] * (1 - alpha)));\n    76\t}\n    77\t/** The same without rounding to 8 bits, so measurements do not depend on the rounding of the composite. */\n    78\texport function compositeLinear(hex, alpha, bgHex) {\n    79\t  const f = srgb(hex), b = srgb(bgHex);\n    80\t  return f.map((v, i) => lin(v * alpha + b[i] * (1 - alpha)));\n    81\t}\n    82\t\n    83\t// --- 8-bit output. The analytic measures above work on unrounded values; what a screen shows is bytes.\n    84\t\n    85\texport const bytes = hex => [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16));\n    86\texport const bytesToHex = b => '#' + b.map(v => v.toString(16).padStart(2, '0')).join('');\n    87\texport const labOfBytes = b => oklab(b.map(v => lin(v / 255)));\n    88\t\n    89\t/** A simulated color as an 8-bit image holds it: simulate in linear RGB, clamp, encode, round to the nearest byte. */\n    90\texport const simulateBytes = (hex, vision) => simulateLinear(linear(hex), vision).map(v => Math.round(255 * gam(v)));\n    91\t/** OKLab of the byte-rounded simulation. */\n    92\texport const labUnderBytes = (hex, vision) => labOfBytes(simulateBytes(hex, vision));\n    93\t\n    94\t/**\n    95\t * Byte model of a translucent fill on an 8-bit raster: alpha quantised to `quantise(alpha × 255)`, each channel\n    96\t * rounded. With Math.round it reproduces Chrome 157's canvas and SVG fills on white exactly and is within one byte\n    97\t * on #16181d (raster.mjs); the CPU Skia raster of the review of 51e1be5 quantised alpha down (63 at 25%), which\n    98\t * Math.floor models. The scoring uses both.\n    99\t */\n   100\texport function rasterFill(hex, alpha, bgHex, quantise = Math.round) {\n   101\t  const k = quantise(alpha * 255), f = bytes(hex), b = bytes(bgHex);\n   102\t  return f.map((v, i) => Math.round((v * k + b[i] * (255 - k)) / 255));\n   103\t}\n   104\t\n   105\t/** The lattice of byte colors within ±r of `b` per channel (clamped to 0–255). */\n   106\texport function byteBox(b, r = 1) {\n   107\t  const out = [];\n   108\t  for (let i = -r; i <= r; i++) for (let j = -r; j <= r; j++) for (let k = -r; k <= r; k++) {\n   109\t    out.push([b[0] + i, b[1] + j, b[2] + k].map(v => Math.min(255, Math.max(0, v))));\n   110\t  }\n   111\t  return out;\n   112\t}\n   113\t\n   114\t/** Smallest OKLab distance between any byte color within ±r of `a` and any within ±r of `b`: the worst case of rounding. */\n   115\texport function boxDistance(a, b, r = 1) {\n   116\t  const la = byteBox(a, r).map(labOfBytes), lb = byteBox(b, r).map(labOfBytes);\n   117\