{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"nl -ba bench/test/inference.test.mjs | sed -n '1,98p'; nl -ba bench/tools/coverage.mjs; sed -n '1,100p' bench/test/helpers.mjs\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"nl -ba bench/test/inference.test.mjs | sed -n '1,98p'; nl -ba bench/tools/coverage.mjs; sed -n '1,100p' bench/test/helpers.mjs\"","aggregated_output":"     1\t// Pure tests: seeds, the estimand, order strata, carry-over visibility, the verdict rule (review findings 11, 12, 18).\n     2\t// Expected values are worked out by hand from the definitions in the comments.\n     3\timport { test } from 'node:test';\n     4\timport assert from 'node:assert/strict';\n     5\timport { execFileSync } from 'node:child_process';\n     6\timport path from 'node:path';\n     7\timport { pairedBootstrap, analyze, balancedOrder, parseSeed, checkSeed, MIN_PAIRS } from '../src/stats.js';\n     8\timport { coverage } from '../tools/coverage.mjs';\n     9\timport { BENCH } from '../build.mjs';\n    10\t\n    11\ttest('seeds: a seed the generator would coerce is an error, not zero', () => {\n    12\t  assert.equal(parseSeed('42'), 42);\n    13\t  assert.equal(parseSeed('0'), 0);\n    14\t  for (const bad of ['12abc', '1.5', '', '-3', 'abc', '4294967296']) assert.throws(() => parseSeed(bad), /integer from 0 to 4294967295/, bad);\n    15\t  for (const bad of [NaN, 1.5, -1, '7', null]) assert.throws(() => checkSeed(bad), /integer/);\n    16\t  assert.throws(() => balancedOrder(4, 'x'), /order seed/);\n    17\t  assert.throws(() => pairedBootstrap([1, 2], [3, 4], { seed: 0.5 }), /bootstrap seed/);\n    18\t  assert.throws(() => analyze('first', [], { bootstrapSeed: -1 }), /bootstrap seed/);\n    19\t});\n    20\t\n    21\ttest('seeds: the runner refuses an invalid --seed or --bootstrap-seed before doing anything', () => {\n    22\t  for (const flag of ['--seed', '--bootstrap-seed']) {\n    23\t    let err;\n    24\t    try { execFileSync(process.execPath, [path.join(BENCH, 'run.mjs'), '--aa', 'noop', flag, 'abc'], { stdio: 'pipe' }); } catch (e) { err = e; }\n    25\t    assert.ok(err, `${flag} abc must fail`);\n    26\t    assert.equal(err.status, 2);\n    27\t    assert.match(String(err.stderr), new RegExp(`${flag} must be an integer`));\n    28\t  }\n    29\t});\n    30\t\n    31\ttest('the estimand is the difference of medians, not the median of paired differences', () => {\n    32\t  // median(B) = 100, median(A) = 101 -> -1. The paired differences are 99, -100, 1, whose median is +1.\n    33\t  const ci = pairedBootstrap([1, 101, 102], [100, 1, 103]);\n    34\t  assert.equal(ci.estimate, -1);\n    35\t});\n    36\t\n    37\ttest('stratified bootstrap keeps the AB/BA balance in every resample', () => {\n    38\t  // A is 0 everywhere. B is 10 in the two AB blocks and 0 in the two BA blocks. Keeping the strata, every resample\n    39\t  // has two 10s and two 0s for B, so median(B) = 5 and the interval is [5, 5]. Ignoring them, resamples can hold\n    40\t  // four 10s or four 0s, so the interval spreads from 0 to 10.\n    41\t  const a = [0, 0, 0, 0], b = [10, 10, 0, 0], strata = ['AB', 'AB', 'BA', 'BA'];\n    42\t  const s = pairedBootstrap(a, b, { strata });\n    43\t  assert.equal(s.lo, 5); assert.equal(s.hi, 5);\n    44\t  const u = pairedBootstrap(a, b);\n    45\t  assert.ok(u.lo < 5 && u.hi > 5, `unstratified [${u.lo}, ${u.hi}]`);\n    46\t});\n    47\t\n    48\tconst block = (b, order, a, bv) => [\n    49\t  { phase: 'timed', block: b, position: order === 'AB' ? 0 : 1, config: 'A', outcome: 'ok', summary: { taskMs: a } },\n    50\t  { phase: 'timed', block: b, position: order === 'AB' ? 1 : 0, config: 'B', outcome: 'ok', summary: { taskMs: bv } },\n    51\t];\n    52\t\n    53\ttest('differential carry-over shows in the per-order estimates', () => {\n    54\t  // The reviewer's case: every first run takes 10; a run after A takes 4, a run after B 12; no adapter effect.\n    55\t  // AB block: A = 10 (first), B = 4 (after A): B - A = -6. BA block: B = 10 (first), A = 12 (after B): B - A = -2.\n    56\t  const runs = [];\n    57\t  for (let b = 0; b < 8; b++) runs.push(...(b % 2 ? block(b, 'BA', 12, 10) : block(b, 'AB', 10, 4)));\n    58\t  const m = analyze('first', runs).metrics.taskMs;\n    59\t  assert.equal(m.byOrder.AB.diff, -6);\n    60\t  assert.equal(m.byOrder.BA.diff, -2);\n    61\t  assert.equal(m.byOrder.AB.pairs, 4);\n    62\t  assert.equal(m.outcome, 'inconclusive'); // 8 pairs: below the verdict rule\n    63\t});\n    64\t\n    65\ttest('the verdict rule follows the plan: 20 runs per configuration before a verdict', () => {\n    66\t  assert.equal(MIN_PAIRS, 20);\n    67\t  const runs = [];\n    68\t  for (let b = 0; b < MIN_PAIRS - 2; b++) runs.push(...block(b, b % 2 ? 'BA' : 'AB', 10, 5));\n    69\t  const few = analyze('first', runs).metrics.taskMs;\n    70\t  assert.equal(few.outcome, 'inconclusive');\n    71\t  assert.match(few.outcomeNote, /fewer than 20/);\n    72\t  for (let b = MIN_PAIRS - 2; b < MIN_PAIRS; b++) runs.push(...block(b, b % 2 ? 'BA' : 'AB', 10, 5));\n    73\t  assert.equal(analyze('first', runs).metrics.taskMs.outcome, 'better');\n    74\t});\n    75\t\n    76\ttest('coverage check: on the reviewer\\'s discrete distribution six pairs give wrong-direction verdicts, which the rule withholds', () => {\n    77\t  // A = 10; B = 5 with p = 0.49, else 11 (true difference +1, so \"better\" is wrong). With five or six 5s out of six\n    78\t  // (probability 10.03%) the unstratified bootstrap called B better; the rule makes six pairs inconclusive.\n    79\t  const res = coverage({ sizes: [6], trials: 400, iterations: 400, seed: 11 });\n    80\t  const row = res.rows[0];\n    81\t  assert.ok(row.falseVerdictRateUnguarded > 0.05, `unguarded false-verdict rate ${row.falseVerdictRateUnguarded}`);\n    82\t  assert.equal(row.falseVerdictRate, 0);\n    83\t  assert.equal(row.withRule.inconclusive, 1);\n    84\t});\n     1\t#!/usr/bin/env node\n     2\t// Coverage check of the comparison procedure (review finding 11): how often does it give a verdict in the wrong\n     3\t// direction on a discrete metric where the true answer is known?\n     4\t//\n     5\t// The reviewer's distribution: A is always 10 ms; B is 5 ms with probability 0.49 and 11 ms otherwise, so B's true\n     6\t// median is 11 ms and the true difference of medians is +1 ms (B is worse). Any \"better\" verdict is false.\n     7\t//\n     8\t// For each sample size, `trials` simulated sessions of n complete pairs in balanced blocks (n/2 AB, n/2 BA) go\n     9\t// through the harness's own pairedBootstrap (stratified by order, as analyze() calls it) and classify(). Reported:\n    10\t//   unguarded  the share of \"better\", \"worse\" and \"inconclusive\" from the interval alone;\n    11\t//   with rule  the same after analyze()'s minimum-pairs rule (MIN_PAIRS), which is what a session reports.\n    12\t//\n    13\t//   node bench/tools/coverage.mjs [--trials 2000] [--iterations 2000] [--sizes 6,10,20,40] [--seed 7]\n    14\timport { parseArgs } from 'node:util';\n    15\timport { fileURLToPath } from 'node:url';\n    16\timport path from 'node:path';\n    17\timport { rng } from '../src/fixtures.js';\n    18\timport { pairedBootstrap, classify, MIN_PAIRS, parseSeed } from '../src/stats.js';\n    19\t\n    20\texport const reviewerDistribution = { A: () => 10, B: r => (r() < 0.49 ? 5 : 11), trueDiff: 1, wrong: 'better' };\n    21\t\n    22\texport function coverage({ sizes = [6, 10, 20, 40], trials = 2000, iterations = 2000, seed = 7, dist = reviewerDistribution } = {}) {\n    23\t  const r = rng(seed);\n    24\t  const rows = [];\n    25\t  for (const n of sizes) {\n    26\t    if (n % 2) throw new Error('sizes must be even (balanced blocks)');\n    27\t    const count = { better: 0, worse: 0, inconclusive: 0 };\n    28\t    const strata = Array.from({ length: n }, (_, i) => (i < n / 2 ? 'AB' : 'BA'));\n    29\t    for (let t = 0; t < trials; t++) {\n    30\t      const a = Array.from({ length: n }, () => dist.A(r)), b = Array.from({ length: n }, () => dist.B(r));\n    31\t      const ci = pairedBootstrap(a, b, { iterations, seed: Math.floor(r() * 2 ** 31), strata });\n    32\t      count[classify(ci, null)]++;\n    33\t    }\n    34\t    const share = k => count[k] / trials;\n    35\t    const guarded = n >= MIN_PAIRS;\n    36\t    rows.push({\n    37\t      pairs: n, trials,\n    38\t      unguarded: { better: share('better'), worse: share('worse'), inconclusive: share('inconclusive') },\n    39\t      withRule: guarded ? { better: share('better'), worse: share('worse'), inconclusive: share('inconclusive') } : { better: 0, worse: 0, inconclusive: 1 },\n    40\t      falseVerdictRate: guarded ? share(dist.wrong) : 0,\n    41\t      falseVerdictRateUnguarded: share(dist.wrong),\n    42\t    });\n    43\t  }\n    44\t  return { distribution: 'A = 10; B = 5 (p = 0.49) or 11; true median(B) - median(A) = +1', minPairs: MIN_PAIRS, iterations, seed, rows };\n    45\t}\n    46\t\n    47\tif (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n    48\t  const { values } = parseArgs({ options: { trials: { type: 'string', default: '2000' }, iterations: { type: 'string', default: '2000' }, sizes: { type: 'string', default: '6,10,20,40' }, seed: { type: 'string', default: '7' } } });\n    49\t  const res = coverage({ trials: Number(values.trials), iterations: Number(values.iterations), sizes: values.sizes.split(',').map(Number), seed: parseSeed(values.seed, '--seed') });\n    50\t  const pct = v => `${(100 * v).toFixed(1)}%`;\n    51\t  console.log(`${res.distribution}\\nbootstrap iterations ${res.iterations}, seed ${res.seed}, verdict rule: at least ${res.minPairs} complete pairs\\n`);\n    52\t  console.log('pairs  trials  unguarded better / worse / inconclusive   reported (with rule) better / worse / inconclusive');\n    53\t  for (const row of res.rows) console.log(`${String(row.pairs).padStart(5)}  ${String(row.trials).padStart(6)}  ${pct(row.unguarded.better).padStart(6)} / ${pct(row.unguarded.worse).padStar