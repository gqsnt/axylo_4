{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc 'nl -ba bench/src/fixtures.js; nl -ba bench/src/page.html'","aggregated_output":"     1\t// Deterministic workload data. Pure: runs in Node (the runner derives the expected readback from it) and in the\n     2\t// page (the adapters receive it). Only integer and basic float arithmetic is used, so both produce identical bits;\n     3\t// the runner compares a checksum of every column the page built with its own.\n     4\t\n     5\texport const DAY = 86_400_000;\n     6\texport const MINUTE = 60_000;\n     7\texport const START = Date.UTC(2026, 0, 1);\n     8\t\n     9\texport function rng(seed) {\n    10\t  // mulberry32: small, fast, and identical in every engine\n    11\t  let s = seed >>> 0;\n    12\t  return () => {\n    13\t    s = (s + 0x6d2b79f5) | 0;\n    14\t    let t = Math.imul(s ^ (s >>> 15), 1 | s);\n    15\t    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    16\t    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    17\t  };\n    18\t}\n    19\t\n    20\t/** \"3x120\" -> { series: 3, points: 120 } */\n    21\texport function parseSize(size) {\n    22\t  const m = /^(\\d+)x(\\d+)$/.exec(String(size));\n    23\t  if (!m) throw new Error(`size must look like 3x120, got ${size}`);\n    24\t  return { series: Number(m[1]), points: Number(m[2]) };\n    25\t}\n    26\t\n    27\t// Small charts get daily points like a dashboard trend; large ones a point per minute like a metrics feed.\n    28\tconst stepFor = points => (points <= 1000 ? DAY : MINUTE);\n    29\t\n    30\tfunction walk(r, n, base) {\n    31\t  const y = new Float64Array(n);\n    32\t  let v = base;\n    33\t  for (let i = 0; i < n; i++) {\n    34\t    v += (r() - 0.5) * 2;\n    35\t    y[i] = Math.round(v * 100) / 100;\n    36\t  }\n    37\t  return y;\n    38\t}\n    39\t\n    40\tfunction extent(col, from = 0, to = col.length) {\n    41\t  let lo = Infinity, hi = -Infinity, missing = 0;\n    42\t  for (let i = from; i < to; i++) {\n    43\t    const v = col[i];\n    44\t    if (v !== v) { missing++; continue; }\n    45\t    if (v < lo) lo = v;\n    46\t    if (v > hi) hi = v;\n    47\t  }\n    48\t  return { lo, hi, missing };\n    49\t}\n    50\t\n    51\t/**\n    52\t * The named `trend` fixture of the specification (P1, P5): 3 series × 120 daily points at UTC midnights, with real\n    53\t * series names and a 7-day outage in \"Referral\". Copied value for value from research/harness/src/data.js (the\n    54\t * Phase 1 harness), which the bench must not import across packages; the test suite pins its checksum and a few\n    55\t * values so a drift from the original is caught. Missing values are NaN in the typed columns.\n    56\t * It has no injected extreme: its own largest value (the maximum of \"Direct\") is the extreme the check reads back.\n    57\t */\n    58\texport function trendFixture() {\n    59\t  const r = rng(7), n = 120;\n    60\t  const x = new Float64Array(n);\n    61\t  for (let i = 0; i < n; i++) x[i] = START + i * DAY;\n    62\t  const mk = (base, growth, noise, season) => {\n    63\t    const y = new Float64Array(n);\n    64\t    for (let i = 0; i < n; i++) y[i] = Math.round(base + growth * i + season * Math.sin((i / 7) * 2 * Math.PI) + (r() - 0.5) * noise);\n    65\t    return y;\n    66\t  };\n    67\t  const ys = [mk(31000, 120, 4000, 3000), mk(18000, 60, 3000, 2500), mk(4200, -8, 1200, 400)];\n    68\t  for (let i = 60; i < 67; i++) ys[2][i] = NaN;\n    69\t  let extremeIndex = 0;\n    70\t  for (let i = 1; i < n; i++) if (ys[0][i] > ys[0][extremeIndex]) extremeIndex = i;\n    71\t  return {\n    72\t    name: 'trend', x, ys, names: ['Direct', 'Organic search', 'Referral'], step: DAY,\n    73\t    extreme: { series: 0, index: extremeIndex, x: x[extremeIndex], y: ys[0][extremeIndex], injected: false },\n    74\t  };\n    75\t}\n    76\t\n    77\t/** One series of `trend`, for the compact page (spec 3.7, AX131: one series per compact chart). */\n    78\texport function trendSeries(i) {\n    79\t  const t = trendFixture();\n    80\t  const s = i % 3;\n    81\t  const y = t.ys[s];\n    82\t  let extremeIndex = 0;\n    83\t  for (let k = 1; k < y.length; k++) if (y[k] > y[extremeIndex]) extremeIndex = k;\n    84\t  return { name: `trend:${t.names[s]}`, x: t.x, ys: [y], names: [t.names[s]], step: DAY, extreme: { series: 0, index: extremeIndex, x: t.x[extremeIndex], y: y[extremeIndex], injected: false } };\n    85\t}\n    86\t\n    87\t/**\n    88\t * One line chart worth of typed columns.\n    89\t * x: Float64Array of epoch milliseconds, strictly increasing, regular step.\n    90\t * ys: one Float64Array per series; NaN marks a missing value.\n    91\t * One extreme value is injected into series 0 so a chart that clips or pins its y range is caught.\n    92\t * With gaps, 5% of each series is removed in runs (contiguous stretches), never at the first or last index or at the extreme.\n    93\t */\n    94\texport function lineFixture({ series, points, gaps = false, seed = 1 }) {\n    95\t  const r = rng(seed);\n    96\t  const step = stepFor(points);\n    97\t  const x = new Float64Array(points);\n    98\t  for (let i = 0; i < points; i++) x[i] = START + i * step;\n    99\t  const ys = [];\n   100\t  for (let s = 0; s < series; s++) ys.push(walk(r, points, 100 + 40 * s));\n   101\t  const extremeIndex = Math.floor(points * 0.37);\n   102\t  {\n   103\t    const { lo, hi } = extent(ys[0]);\n   104\t    ys[0][extremeIndex] = Math.round((hi + (hi - lo) + 1) * 100) / 100;\n   105\t  }\n   106\t  if (gaps) {\n   107\t    const target = Math.round(points * 0.05);\n   108\t    const maxRun = Math.min(50, Math.max(2, Math.round(Math.sqrt(points) / 4)));\n   109\t    for (let s = 0; s < series; s++) {\n   110\t      const col = ys[s];\n   111\t      let removed = 0, guard = 0;\n   112\t      while (removed < target && guard++ < points * 10) {\n   113\t        const len = Math.min(target - removed, 1 + Math.floor(r() * maxRun));\n   114\t        const at = 1 + Math.floor(r() * (points - len - 2));\n   115\t        let ok = true;\n   116\t        for (let i = at - 1; i <= at + len; i++) if (col[i] !== col[i] || (s === 0 && i === extremeIndex)) { ok = false; break; }\n   117\t        if (!ok) continue; // keep runs separate so the count of runs is what was drawn\n   118\t        for (let i = at; i < at + len; i++) col[i] = NaN;\n   119\t        removed += len;\n   120\t      }\n   121\t    }\n   122\t  }\n   123\t  return { x, ys, names: ys.map((_, s) => `s${s}`), step, extreme: { series: 0, index: extremeIndex, x: x[extremeIndex], y: ys[0][extremeIndex], injected: true } };\n   124\t}\n   125\t\n   126\t/**\n   127\t * Scatter (W-types, renderer decision): one series, x strictly increasing with random spacing (so the input order is\n   128\t * the x order and the first and last x are well defined), y uniform or clustered around five centres. One extreme\n   129\t * is injected as in lineFixture.\n   130\t */\n   131\texport function scatterFixture({ points, clustered = false, seed = 3 }) {\n   132\t  const r = rng(seed);\n   133\t  const x = new Float64Array(points), y = new Float64Array(points);\n   134\t  let t = 0;\n   135\t  const centres = [[0.15, 0.2], [0.35, 0.8], [0.5, 0.45], [0.7, 0.7], [0.9, 0.3]];\n   136\t  for (let i = 0; i < points; i++) {\n   137\t    t += 1 + Math.floor(r() * 9);\n   138\t    x[i] = t;\n   139\t    if (clustered) {\n   140\t      const c = centres[Math.floor(r() * centres.length)];\n   141\t      // sum of three uniforms: a cheap bell around the centre\n   142\t      y[i] = Math.round((c[1] * 1000 + (r() + r() + r() - 1.5) * 60) * 100) / 100;\n   143\t    } else y[i] = Math.round(r() * 100000) / 100;\n   144\t  }\n   145\t  const extremeIndex = Math.floor(points * 0.37);\n   146\t  const { lo, hi } = extent(y);\n   147\t  y[extremeIndex] = Math.round((hi + (hi - lo) + 1) * 100) / 100;\n   148\t  return { scatter: true, x, ys: [y], names: ['points'], step: null, extreme: { series: 0, index: extremeIndex, x: x[extremeIndex], y: y[extremeIndex], injected: true } };\n   149\t}\n   150\t\n   151\t/**\n   152\t * Streaming: an initial window, then `samples` appended points, one series.\n   153\t * The extreme is injected into a streamed sample that stays inside the final window.\n   154\t */\n   155\texport function streamFixture({ window = 600, samples = 300, seed = 2 }) {\n   156\t  const total = window + samples;\n   157\t  const r = rng(seed);\n   158\t  const x = new Float64Array(total);\n   159\t  for (let i = 0; i < total; i++) x[i] = START + i * MINUTE;\n   160\t  const y = walk(r, total, 100);\n   161\t  const extremeIndex = window + Math.floor(samples * 2 / 3);\n   162\t  {\n   163\t    const { lo, hi } = extent(y);\n   164\t    y[extremeIndex] = Math.round((hi + (hi - lo) + 1) * 100) / 100;\n   165\t  }\n   166\t  return {\n   167\t    window, samples, step: MINUTE, names: ['s0'],\n   168\t    initial: { x: x.subarray(0, window), ys: [y.subarray(0, window)] },\n   169\t    stream: { x: x.subarray(window), y: y.subarray(window) },\n   170\t    all: { x, ys: [y] },\n   171\t    extreme: { series: 0, index: extremeIndex, x: x[extremeIndex], y: y[extremeIndex], injected: true },\n   172\t  };\n   173\t}\n   174\t\n   175\t/**\n   176\t * W-zoom: the windows passed to chart.zoom(), in order. 20 steps in (each 0.85 of the last, centred on the injected\n   177\t * extreme), 20 steps out, then 20 pan steps at a tenth of the range that end centred on the extreme, so the final\n   178\t * view is known and contains the extreme. Pure, so the runner knows the final window.\n   179\t */\n   180\texport function zoomSteps(fix, { zoomIn = 20, zoomOut = 20, pan = 20 } = {}) {\n   181\t  const x0 = fix.x[0], x1 = fix.x[fix.x.length - 1], span = x1 - x0, c = fix.extreme.x;\n   182\t  const clampWin = (lo, hi) => { const w = hi - lo; if (lo < x0) return [x0, x0 + w]; if (hi > x1) return [x1 - w, x1]; return [lo, hi]; };\n   183\t  const out = [];\n   184\t  let w = span;\n   185\t  for (let i = 0; i < zoomIn; i++) { w *= 0.85; out.push(clampWin(Math.round(c - w / 2), Math.round(c + w / 2))); }\n   186\t  for (let i = 0; i < zoomOut; i++) { w = Math.min(span, w / 0.85); out.push(clampWin(Math.round(c - w / 2), Math.round(c + w / 2))); }\n   187\t  const pw = Math.round(span / 10), start = x0 + Math.round(span * 0.05);\n   188\t  for (let i = 1; i <= pan; i++) {\n   189\t    const centre = start + (c - start) * (i / pan);\n   190\t    out.push(clampWin(Math.round(centre - pw / 2), Math.round(centre - pw / 2) + pw));\n   191\t  }\n   192\t  return out;\n   193\t}\n   194\t\n   195\t/** The data a workload feeds to the chart(s), as a list of fixtures (one per chart). */\n   196\texport function workloadData(workload, params) {\n   197\t  const line = p => (p.fixture === 'trend' ? trendFixture() : lineFixture({ ...parseSize(p.size), gaps: !!p.gaps, seed: p.seed ?? 1 }));\n   198\t  if (workload === 'first' || workload === 'hover' || workload === 'zoom' || workload === 'mem') return [line({ size: '3x120', ...params })];\n   199\t  if (workload === 'page') {\n   200\t    const count = params.charts ?? 24;\n   201\t    if (params.fixture === 'trend') return Array.from({ length: count }, () => trendFixture());\n   202\t    const { series, points } = parseSize(params.size ?? '3x120');\n   203\t    return Array.from({ length: count }, (_, i) => lineFixture({ series, points, gaps: !!params.gaps, seed: (params.seed ?? 1) * 1000 + i }));\n   204\t  }\n   205\t  if (workload === 'compact') return Array.from({ length: params.charts ?? 40 }, (_, i) => trendSeries(i));\n   206\t  if (workload === 'lifecycle') return [trendFixture()];\n   207\t  if (workload === 'scatter') return [scatterFixture({ points: parseSize(params.size ?? '1x10000').points, clustered: !!params.clustered, seed: params.seed ?? 3 })];\n   208\t  if (workload === 'stream') return [streamFixture({ window: params.window ?? 600, samples: params.samples ?? 300, seed: params.seed ?? 2 })];\n   209\t  if (workload === 'theme') return [params.fixture === 'trend' ? trendFixture() : lineFixture({ ...parseSize(params.size ?? '3x120'), seed: params.seed ?? 1 })];\n   210\t  if (workload === 'resize') {\n   211\t    const { series, points } = parseSize(params.size ?? '1x100000');\n   212\t    const count = params.charts ?? 1;\n   213\t    return Array.from({ length: count }, (_, i) => lineFixture({ series, points, seed: count === 1 ? (params.seed ?? 1) : (params.seed ?? 1) * 1000 + i }));\n   214\t  }\n   215\t  throw new Error(`unknown workload ${workload}`);\n   216\t}\n   217\t\n   218\t/** The columns a correct chart holds at the end of the workload: the final window for a stream, else the input. */\n   219\texport function heldColumns(fix) {\n   220\t  if (fix.initial) {\n   221\t    const from = fix.all.x.length - fix.window;\n   222\t    return { x: fix.all.x.subarray(from), ys: fix.all.ys.map(c => c.subarray(from)) };\n   223\t  }\n   224\t  return { x: fix.x, ys: fix.ys };\n   225\t}\n   226\t\n   227\t/** First index i with x[i] >= v (x sorted ascending). */\n   228\texport function lowerBound(x, v) {\n   229\t  let lo = 0, hi = x.length;\n   230\t  while (lo < hi) { const mid = (lo + hi) >>> 1; if (x[mid] < v) lo = mid + 1; else hi = mid; }\n   231\t  return lo;\n   232\t}\n   233\t\n   234\t/**\n   235\t * What a correct chart must show, derived from the fixture alone. `visible` (optional) is the x window the\n   236\t * workload ends on (W-zoom); otherwise the whole held data is visible.\n   237\t *   visibleX     the x range the chart must show\n   238\t *   window       [first, last] index of the held columns inside visibleX\n   239\t *   yMin, yMax   the data's y extent inside that window, every series\n   240\t *   seriesY      the same per series ([min, max]), for the drawn-extreme check\n   241\t */\n   242\texport function expectedView(fix, visible = null) {\n   243\t  const { x, ys } = heldColumns(fix);\n   244\t  const visibleX = visible ? [visible[0], visible[1]] : [x[0], x[x.length - 1]];\n   245\t  const i0 = visible ? lowerBound(x, visible[0]) : 0;\n   246\t  const i1 = visible ? lowerBound(x, visible[1] + 1) - 1 : x.length - 1;\n   247\t  let lo = Infinity, hi = -Infinity;\n   248\t  const missing = [], seriesY = [];\n   249\t  for (const col of ys) {\n   250\t    const all = extent(col);\n   251\t    missing.push(all.missing);\n   252\t    const e = extent(col, i0, i1 + 1);\n   253\t    seriesY.push([e.lo, e.hi]);\n   254\t    lo = Math.min(lo, e.lo); hi = Math.max(hi, e.hi);\n   255\t  }\n   256\t  return {\n   257\t    series: ys.length, points: x.length, oldestX: x[0], newestX: x[x.length - 1],\n   258\t    visibleX, window: [i0, i1], yMin: lo, yMax: hi, seriesY, missing, extreme: fix.extreme, scatter: !!fix.scatter,\n   259\t    // A scatter's x is a number axis, which a library may round out to nice tick values (0 to 60,000 for data\n   260\t    // from 5 to 50,000): up to a quarter of the range per side; a time axis gets the default 10%.\n   261\t    ...(fix.scatter ? { xSlack: 0.25 } : {}),\n   262\t  };\n   263\t}\n   264\t\n   265\t/** FNV-1a over the bytes of every column, so the runner can confirm the page built the same data it expects. */\n   266\texport function checksum(fixtures) {\n   267\t  let h = 0x811c9dc5;\n   268\t  const feed = arr => {\n   269\t    const b = new Uint8Array(arr.buffer, arr.byteOffset, arr.byteLength);\n   270\t    for (let i = 0; i < b.length; i++) { h ^= b[i]; h = Math.imul(h, 0x01000193); }\n   271\t  };\n   272\t  for (const f of fixtures) {\n   273\t    const cols = f.all ? [f.all.x, ...f.all.ys] : [f.x, ...f.ys];\n   274\t    for (const c of cols) feed(c);\n   275\t  }\n   276\t  return (h >>> 0).toString(16).padStart(8, '0');\n   277\t}\n     1\t<!doctype html>\n     2\t<html lang=\"en\">\n     3\t<head>\n     4\t<meta charset=\"utf-8\">\n     5\t<title>Axylo bench</title>\n     6\t<link rel=\"icon\" href=\"data:,\">\n     7\t<style>\n     8\t  html, body { margin: 0; background: #fff; color: #111; font: 12px system-ui, sans-serif; }\n     9\t  #root { padding: 8px; }\n    10\t  /* 2:1 containers: Chart.js's default aspect ratio is 2:1, so every library fills the same area. */\n    11\t  .chart { width: 800px; height: 400px; overflow: hidden; position: relative; }\n    12\t  /* Dashboard tiles (W-page, P5): 4 columns of 340x200; the page scrolls. At the earlier 230x115 Axylo's plot was\n    13\t     below the 120x80 minimum of spec L8, so it showed its text summary instead of marks (the M1 dashboard records\n    14\t     have no SVG paths at all); a dashboard benchmark must draw charts. */\n    15\t  .grid { display: grid; grid-template-columns: repeat(4, 340px); gap: 6px; }\n    16\t  .grid .chart { width: 340px; height: 200px; }\n    17\t  /* compact workload (P8): 40 sparkline tiles, 8 x 5 */\n    18\t  .grid.compact { grid-template-columns: repeat(8, 160px); }\n    19\t  .grid.compact .chart { width: 160px; height: 48px; }\n    20\t  /* resize workload: the box's width is animated; charts fill it */\n    21\t  .resize-box { width: 1200px; }\n    22\t  .resize-box > .chart { width: 100%; height: 400px; }\n    23\t  .resize-box.grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }\n    24\t  .resize-box.grid > .chart { width: auto; height: 200px; }\n    25\t  /* theme workload: a class-toggled dark theme on <html>, as a page would ship it (spec L4) */\n    26\t  html.bench-dark, html.bench-dark body { color-scheme: dark; background: #111; color: #eee; }\n    27\t  #status { white-space: pre-wrap; font-family: monospace; }\n    28\t</style>\n    29\t</head>\n    30\t<body>\n    31\t<div id=\"root\"></div>\n    32\t<div id=\"status\"></div>\n    33\t<script type=\"module\" src=\"./page.js\"></script>\n    34\t</body>\n    35\t</html>\n","exit_code":0,"status":"completed"}}
