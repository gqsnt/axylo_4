2, finding 17).\npackages/axylo/src/dom/interaction.ts:1436:    if (active instanceof HTMLElement && active !== doc.activeElement && active.isConnected) active.focus({ preventScroll: true });\npackages/axylo/src/dom/interaction.ts:1456:    // How to move in the plot, as its description (the plotInstructions message).\npackages/axylo/src/dom/interaction.ts:1463:    setAttr(proxy, 'aria-roledescription', fill(d.messages.plotRole, { type: d.messages[type[d.kind]] }));\npackages/axylo/src/dom/interaction.ts:1476:   * Category positions across a change of categories. Keyboard focus moves on to the next surviving category\npackages/axylo/src/dom/interaction.ts:1532:      // A DatumRef means nothing across a data replacement: one effective focus for the new data is chosen\npackages/axylo/src/dom/interaction.ts:1542:      focus = proxyFocused && plotReady(next) ? initialFocusFor(next) : null;\npackages/axylo/src/dom/interaction.ts:1546:        focus = map(focus);\npackages/axylo/src/dom/interaction.ts:1550:        if (focus === null) mode = 'all';\npackages/axylo/src/dom/interaction.ts:1558:    if (focus) {\npackages/axylo/src/dom/interaction.ts:1559:      // Spec A7: focus follows its datum, and never points at something that is gone.\n","exit_code":0,"status":"completed"}}
