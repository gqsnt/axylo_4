{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc 'for f in app.tsx open.ts spy-axylo.ts probe.ts tree.ts; do echo \"$f\"; nl -ba \"packages/react/test/browser/$f\"; done'","aggregated_output":"app.tsx\n     1\t/**\n     2\t * Browser test app for @axylo/react. The test drives it through `window.app`: it describes the charts to\n     3\t * render as JSON specs, and the app turns them into elements. Data is named, so a spec that names the same\n     4\t * dataset passes the same array identity; every other prop arrives as a fresh object on each render, which\n     5\t * is the inline-prop case the adapter has to absorb.\n     6\t */\n     7\timport { nextFrames, probe } from './probe';\n     8\timport { Component, createRef, StrictMode, type ReactNode, type RefObject } from 'react';\n     9\timport { flushSync } from 'react-dom';\n    10\timport { createRoot, hydrateRoot, type Root } from 'react-dom/client';\n    11\timport { Area, Bar, Donut, Line, Scatter, type ChartRef } from '../../src/index';\n    12\timport { spy } from './spy-axylo';\n    13\timport { hydrationTree } from './tree';\n    14\t\n    15\tconst components = { Line, Area, Bar, Scatter, Donut } as unknown as Record<string, (props: Record<string, unknown>) => ReactNode>;\n    16\t\n    17\texport interface Spec {\n    18\t  type: keyof typeof components;\n    19\t  data: string;\n    20\t  props?: Record<string, unknown>;\n    21\t  /** Installs an onHover that records [tag, point index]. A new function is made on every render. */\n    22\t  hover?: string;\n    23\t}\n    24\t\n    25\tclass Boundary extends Component<{ reset: unknown; children: ReactNode }, { error: Error | null }> {\n    26\t  override state = { error: null as Error | null };\n    27\t  static getDerivedStateFromError(error: Error) { return { error }; }\n    28\t  override componentDidUpdate(previous: { reset: unknown }) {\n    29\t    if (this.state.error && previous.reset !== this.props.reset) this.setState({ error: null });\n    30\t  }\n    31\t  override render() {\n    32\t    return this.state.error ? <p className=\"caught\">{this.state.error.message}</p> : this.props.children;\n    33\t  }\n    34\t}\n    35\t\n    36\tinterface Bench { ready(): Promise<void>; describe(): { series: { key: string; points: number; newestX: number }[] } }\n    37\ttype Handle = { append(rows: unknown[]): void; __bench: Bench };\n    38\t\n    39\tconst datasets: Record<string, unknown[]> = {};\n    40\tconst refs: RefObject<ChartRef<unknown, unknown> | null>[] = [];\n    41\tconst events: [string, number | null][] = [];\n    42\tconst hydrationErrors: string[] = [];\n    43\tlet root: Root | null = null;\n    44\t\n    45\tconst settle = async () => { await new Promise(r => setTimeout(r, 0)); await nextFrames(2); };\n    46\t\n    47\tconst app = {\n    48\t  spy, probe, events, hydrationErrors, nextFrames,\n    49\t  setData(name: string, rows: unknown[]) { datasets[name] = rows; },\n    50\t  chart(i: number): Handle | null { return (refs[i]?.current?.chart ?? null) as Handle | null; },\n    51\t  async render(specs: Spec[], options: { strict?: boolean } = {}) {\n    52\t    root ??= createRoot(document.getElementById('chart')!);\n    53\t    const charts = specs.map((spec, i) => {\n    54\t      const ref = refs[i] ??= createRef();\n    55\t      const Chart = components[spec.type]!;\n    56\t      const onHover = spec.hover ? (p: { index: number } | null) => events.push([spec.hover!, p ? p.index : null]) : undefined;\n    57\t      return <Boundary key={i} reset={spec.data}><Chart ref={ref} data={datasets[spec.data]} onHover={onHover} {...spec.props} /></Boundary>;\n    58\t    });\n    59\t    flushSync(() => root!.render(options.strict ? <StrictMode>{charts}</StrictMode> : <>{charts}</>));\n    60\t    await settle();\n    61\t  },\n    62\t  /** Waits until every mounted chart has drawn its accepted state. */\n    63\t  async ready() {\n    64\t    await Promise.all(refs.map(r => (r.current?.chart as Handle | null)?.__bench.ready()));\n    65\t    await nextFrames(2);\n    66\t  },\n    67\t  async hydrate() {\n    68\t    hydrateRoot(document.getElementById('chart')!, hydrationTree(), { onRecoverableError: e => hydrationErrors.push(String(e)) });\n    69\t    await settle();\n    70\t  },\n    71\t};\n    72\t\n    73\t(window as unknown as { app: typeof app }).app = app;\nopen.ts\n     1\t/**\n     2\t * Opens the React test app through the shared harness. The app is bundled here first, with what the\n     3\t * harness's own esbuild call does not set: React's NODE_ENV and `axylo` redirected to the recording wrapper\n     4\t * (which bundles the core from source). The harness then loads the result as a plain script.\n     5\t */\n     6\timport { build, type BuildOptions, type Plugin } from 'esbuild';\n     7\timport path from 'node:path';\n     8\timport type { BrowserContextOptions, Page } from 'playwright-core';\n     9\timport { openEntry } from '../../../axylo/test/browser/harness';\n    10\t\n    11\tconst here = import.meta.dirname;\n    12\tconst root = path.resolve(here, '../../../..');\n    13\t\n    14\tconst spyCore: Plugin = {\n    15\t  name: 'axylo-spy',\n    16\t  setup(b) { b.onResolve({ filter: /^axylo$/ }, () => ({ path: path.join(here, 'spy-axylo.ts') })); },\n    17\t};\n    18\t\n    19\texport async function openApp(options: BrowserContextOptions & { query?: string; html?: string } = {}, esbuild: BuildOptions = {}): Promise<Page> {\n    20\t  const out = path.join(here, '.out', 'axylo-react-app.js');\n    21\t  await build({\n    22\t    entryPoints: [path.join(here, 'app.tsx')], bundle: true, format: 'iife', target: 'es2022', outfile: out, logLevel: 'silent',\n    23\t    jsx: 'automatic', define: { __DEV__: 'true', 'process.env.NODE_ENV': '\"development\"' }, plugins: [spyCore], ...esbuild,\n    24\t  });\n    25\t  const page = await openEntry(path.relative(root, out), options);\n    26\t  return page;\n    27\t}\n    28\t\n    29\texport async function closeApp(page: Page): Promise<string[]> {\n    30\t  const errors = (page as Page & { errors: string[] }).errors;\n    31\t  await page.context().close();\n    32\t  return errors;\n    33\t}\nspy-axylo.ts\n     1\t/**\n     2\t * Stands in for `axylo` in the browser test bundle (see open.ts): the real core, from source, with every\n     3\t * created chart recorded, so tests can count creates, `update` calls and destroys.\n     4\t */\n     5\timport * as core from '../../../axylo/src/index';\n     6\t\n     7\texport * from '../../../axylo/src/index';\n     8\t\n     9\texport interface Recorded {\n    10\t  kind: string;\n    11\t  element: HTMLElement;\n    12\t  updates: Record<string, unknown>[];\n    13\t  destroyed: boolean;\n    14\t}\n    15\t\n    16\texport const spy = { attempts: 0, charts: [] as Recorded[] };\n    17\t\n    18\ttype Handle = { update(patch: Record<string, unknown>): void; destroy(): void };\n    19\t\n    20\tfunction wrap<F>(kind: string, create: F): F {\n    21\t  return ((target: HTMLElement, options: unknown) => {\n    22\t    spy.attempts++;\n    23\t    const chart = (create as unknown as (t: HTMLElement, o: unknown) => Handle)(target, options);\n    24\t    const record: Recorded = { kind, element: target, updates: [], destroyed: false };\n    25\t    spy.charts.push(record);\n    26\t    const { update, destroy } = chart;\n    27\t    chart.update = patch => { record.updates.push(patch); update(patch); };\n    28\t    chart.destroy = () => { record.destroyed = true; destroy(); };\n    29\t    return chart;\n    30\t  }) as F;\n    31\t}\n    32\t\n    33\texport const line = wrap('line', core.line);\n    34\texport const area = wrap('area', core.area);\n    35\texport const bar = wrap('bar', core.bar);\n    36\texport const scatter = wrap('scatter', core.scatter);\n    37\texport const donut = wrap('donut', core.donut);\nprobe.ts\n     1\t/**\n     2\t * Leak probes, installed before React or the core run: ResizeObserver and MutationObserver instances still\n     3\t * observing, ResizeObserver callbacks delivered, event listeners still registered on live targets, and\n     4\t * animation frames still pending.\n     5\t */\n     6\tconst originalFrame = window.requestAnimationFrame.bind(window);\n     7\tconst originalCancel = window.cancelAnimationFrame.bind(window);\n     8\t\n     9\t/** Waits n frames without counting as a pending frame. */\n    10\texport const nextFrames = (n: number): Promise<void> =>\n    11\t  new Promise(resolve => { const step = (k: number): void => { if (k === 0) resolve(); else originalFrame(() => step(k - 1)); }; step(n); });\n    12\t\n    13\tconst pendingFrames = new Set<number>();\n    14\twindow.requestAnimationFrame = callback => {\n    15\t  const id = originalFrame(time => { pendingFrames.delete(id); callback(time); });\n    16\t  pendingFrames.add(id);\n    17\t  return id;\n    18\t};\n    19\twindow.cancelAnimationFrame = id => { pendingFrames.delete(id); originalCancel(id); };\n    20\t\n    21\tlet resizeCallbacks = 0;\n    22\tconst observing = new Set<object>();\n    23\tconst Resize = window.ResizeObserver;\n    24\twindow.ResizeObserver = class extends Resize {\n    25\t  constructor(callback: ResizeObserverCallback) {\n    26\t    super((entries, observer) => { resizeCallbacks++; callback(entries, observer); });\n    27\t  }\n    28\t  override observe(target: Element, options?: ResizeObserverOptions): void { observing.add(this); super.observe(target, options); }\n    29\t  override disconnect(): void { observing.delete(this); super.disconnect(); }\n    30\t};\n    31\tconst Mutation = window.MutationObserver;\n    32\twindow.MutationObserver = class extends Mutation {\n    33\t  override observe(target: Node, options?: MutationObserverInit): void { observing.add(this); super.observe(target, options); }\n    34\t  override disconnect(): void { observing.delete(this); super.disconnect(); }\n    35\t};\n    36\t\n    37\tinterface Entry { id: number; target: EventTarget; type: string; listener: unknown; capture: boolean }\n    38\tconst listeners: Entry[] = [];\n    39\tlet ids = 0;\n    40\tconst add = EventTarget.prototype.addEventListener;\n    41\tconst remove = EventTarget.prototype.removeEventListener;\n    42\tconst captureOf = (options: unknown): boolean => typeof options === 'boolean' ? options : !!(options as { capture?: boolean } | undefined)?.capture;\n    43\tconst drop = (target: EventTarget, type: string, listener: unknown, capture: boolean): void => {\n    44\t  const i = listeners.findIndex(e => e.target === target && e.type === type && e.listener === listener && e.capture === capture);\n    45\t  if (i >= 0) listeners.splice(i, 1);\n    46\t};\n    47\tEventTarget.prototype.addEventListener = function (this: EventTarget, type: string, listener: EventListenerOrEventListenerObject | null, options?: boolean | AddEventListenerOptions) {\n    48\t  const capture = captureOf(options);\n    49\t  // `once` listeners remove themselves when they fire; they are not what a teardown has to undo.\n    50\t  const once = typeof options === 'object' && options.once;\n    51\t  if (listener && !once && !listeners.some(e => e.target === this && e.type === type && e.listener === listener && e.capture === capture)) {\n    52\t    listeners.push({ id: ++ids, target: this, type, listener, capture });\n    53\t    const signal = typeof options === 'object' ? options.signal : undefined;\n    54\t    if (signal) add.call(signal, 'abort', () => drop(this, type, listener, capture));\n    55\t  }\n    56\t  add.call(this, type, listener, options);\n    57\t};\n    58\tEventTarget.prototype.removeEventListener = function (this: EventTarget, type: string, listener: EventListenerOrEventListenerObject | null, options?: boolean | EventListenerOptions) {\n    59\t  drop(this, type, listener, captureOf(options));\n    60\t  remove.call(this, type, listener, options);\n    61\t};\n    62\t\n    63\texport const probe = {\n    64\t  get resizeCallbacks() { return resizeCallbacks; },\n    65\t  get observers() { return observing.size; },\n    66\t  get pendingFrames() { return pendingFrames.size; },\n    67\t  mark: () => ids,\n    68\t  /** Listeners added after `mark` that are still registered on something that can still fire them. */\n    69\t  leakedSince: (mark: number): string[] => listeners\n    70\t    .filter(e => e.id > mark && (!(e.target instanceof Node) || e.target.isConnected))\n    71\t    .map(e => `${(e.target as { constructor: { name: string } }).constructor.name}:${e.type}`),\n    72\t};\ntree.ts\n     1\t/**\n     2\t * The tree the hydration test renders twice: to a string in Node, and with hydrateRoot in the browser.\n     3\t */\n     4\timport { createElement, StrictMode, type ReactElement } from 'react';\n     5\timport { Donut, Line } from '../../src/index';\n     6\t\n     7\tconst rows = [\n     8\t  { day: '2026-01-01', channel: 'Direct', sessions: 31 },\n     9\t  { day: '2026-01-02', channel: 'Direct', sessions: 35 },\n    10\t  { day: '2026-01-03', channel: 'Direct', sessions: 29 },\n    11\t];\n    12\tconst slices = [{ channel: 'Direct', sessions: 30 }, { channel: 'Organic', sessions: 20 }];\n    13\t\n    14\texport function hydrationTree(): ReactElement {\n    15\t  return createElement(StrictMode, null,\n    16\t    createElement('section', { className: 'cards' },\n    17\t      createElement('h2', null, 'Report'),\n    18\t      createElement(Line<(typeof rows)[number]>, { data: rows, x: 'day', y: 'sessions', title: 'Hydrated line', className: 'card', style: { height: 260 } }),\n    19\t      createElement(Donut<(typeof slices)[number]>, { data: slices, label: 'channel', value: 'sessions', title: 'Hydrated donut', style: { height: 260 } })));\n    20\t}\n","exit_code":0,"status":"completed"}}
