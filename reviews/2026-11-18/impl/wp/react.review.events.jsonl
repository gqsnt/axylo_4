{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'nl -ba scripts/build.mjs; nl -ba scripts/size.mjs; ls -la packages/react; node --version; ls -la node_modules/.bin; cat packages/axylo/tsconfig.json'","aggregated_output":"     1\t// Builds packages/axylo/dist: ESM (production and development flavours), script-tag files, CSS and type declarations.\n     2\timport { build } from 'esbuild';\n     3\timport { execFileSync } from 'node:child_process';\n     4\timport fs from 'node:fs';\n     5\tconst pkg = 'packages/axylo';\n     6\tfs.rmSync(`${pkg}/dist`, { recursive: true, force: true });\n     7\tconst common = { entryPoints: [`${pkg}/src/index.ts`], bundle: true, target: 'es2022', legalComments: 'none', logLevel: 'warning' };\n     8\tawait Promise.all([\n     9\t  build({ ...common, format: 'esm', minify: true, define: { __DEV__: 'false' }, outfile: `${pkg}/dist/axylo.js` }),\n    10\t  build({ ...common, format: 'esm', define: { __DEV__: 'true' }, outfile: `${pkg}/dist/axylo.dev.js` }),\n    11\t  build({ ...common, format: 'iife', globalName: 'Axylo', define: { __DEV__: 'true' }, outfile: `${pkg}/dist/axylo.iife.js` }),\n    12\t  build({ ...common, format: 'iife', globalName: 'Axylo', minify: true, define: { __DEV__: 'false' }, outfile: `${pkg}/dist/axylo.iife.min.js` }),\n    13\t]);\n    14\t// The stylesheet's source of truth is a string in the library (it is also applied at run time without a <style> element);\n    15\t// the standalone file is for pages that prefer to load it themselves, for example under a strict Content Security Policy.\n    16\t{\n    17\t  const r = await build({ entryPoints: [`${pkg}/src/theme/css.ts`], bundle: true, format: 'esm', write: false, logLevel: 'silent' });\n    18\t  const mod = await import('data:text/javascript;base64,' + Buffer.from(r.outputFiles[0].contents).toString('base64'));\n    19\t  fs.writeFileSync(`${pkg}/dist/axylo.css`, mod.AXYLO_CSS);\n    20\t}\n    21\texecFileSync('npx', ['tsc', '-p', `${pkg}/tsconfig.build.json`], { stdio: 'inherit' });\n    22\tconsole.log('built', fs.readdirSync(`${pkg}/dist`).filter(f => !fs.statSync(`${pkg}/dist/${f}`).isDirectory()).join(', '));\n     1\t// Reports minified + gzipped size of what a consumer downloads, against the provisional targets in the spec (DX7).\n     2\timport { build } from 'esbuild';\n     3\timport { gzipSync } from 'node:zlib';\n     4\timport fs from 'node:fs';\n     5\tconst pkg = 'packages/axylo';\n     6\tconst kib = b => +(b / 1024).toFixed(2);\n     7\tconst css = fs.existsSync(`${pkg}/dist/axylo.css`) ? gzipSync(fs.readFileSync(`${pkg}/dist/axylo.css`)).length : 0;\n     8\tconst bundle = async code => {\n     9\t  const r = await build({ stdin: { contents: code, resolveDir: process.cwd(), loader: 'ts' }, bundle: true, minify: true, format: 'esm', write: false, define: { __DEV__: 'false' }, logLevel: 'silent' });\n    10\t  return gzipSync(r.outputFiles[0].contents).length;\n    11\t};\n    12\tconst exported = fs.readFileSync(`${pkg}/src/index.ts`, 'utf8');\n    13\tconst has = name => new RegExp(`\\\\b${name}\\\\b`).test(exported);\n    14\tconst rows = [];\n    15\trows.push({ entry: 'everything', gzipKiB: kib(await bundle(`export * from './${pkg}/src/index.ts'`) + css), targetKiB: 40 });\n    16\tif (has('line')) rows.push({ entry: 'line only', gzipKiB: kib(await bundle(`import { line } from './${pkg}/src/index.ts'; (globalThis as any).x = line;`) + css), targetKiB: 25 });\n    17\tconsole.table(rows);\n    18\tfs.mkdirSync('bench/history', { recursive: true });\n    19\tfs.writeFileSync('bench/size-latest.json', JSON.stringify({ date: new Date().toISOString(), cssGzipBytes: css, rows }, null, 1));\n    20\tif (process.argv.includes('--check') && rows.some(r => r.gzipKiB > r.targetKiB)) { console.error('size target exceeded'); process.exit(1); }\ntotal 24\ndrwxrwxr-x 4 canarit canarit 4096 Nov 18 04:12 .\ndrwxrwxr-x 4 canarit canarit 4096 Nov 18 04:05 ..\n-rw-rw-r-- 1 canarit canarit  352 Nov 18 04:19 package.json\ndrwxrwxr-x 2 canarit canarit 4096 Nov 18 04:12 src\ndrwxrwxr-x 3 canarit canarit 4096 Nov 18 04:14 test\n-rw-rw-r-- 1 canarit canarit  232 Nov 18 04:12 tsconfig.json\nv24.21.0\ntotal 8\ndrwxrwxr-x  2 canarit canarit 4096 Nov 18 01:40 .\ndrwxrwxr-x 49 canarit canarit 4096 Nov 18 04:06 ..\nlrwxrwxrwx  1 canarit canarit   22 Nov 18 01:40 esbuild -> ../esbuild/bin/esbuild\nlrwxrwxrwx  1 canarit canarit   24 Nov 18 01:40 nanoid -> ../nanoid/bin/nanoid.cjs\nlrwxrwxrwx  1 canarit canarit   25 Nov 18 01:40 playwright-core -> ../playwright-core/cli.js\nlrwxrwxrwx  1 canarit canarit   23 Nov 18 01:40 rolldown -> ../rolldown/bin/cli.mjs\nlrwxrwxrwx  1 canarit canarit   21 Nov 18 01:40 tsc -> ../typescript/bin/tsc\nlrwxrwxrwx  1 canarit canarit   19 Nov 18 01:40 vite -> ../vite/bin/vite.js\nlrwxrwxrwx  1 canarit canarit   20 Nov 18 01:40 vitest -> ../vitest/vitest.mjs\nlrwxrwxrwx  1 canarit canarit   29 Nov 18 01:40 why-is-node-running -> ../why-is-node-running/cli.js\n{ \"extends\": \"../../tsconfig.base.json\", \"compilerOptions\": { \"rootDir\": \".\", \"outDir\": \"dist/types\" }, \"include\": [\"src\", \"test\"] }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/react/test/patch.test.ts; nl -ba packages/react/test/server.test.ts; nl -ba packages/react/test/size.test.ts; nl -ba packages/react/test/types.check.tsx'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/react/test/patch.test.ts; nl -ba packages/react/test/server.test.ts; nl -ba packages/react/test/size.test.ts; nl -ba packages/react/test/types.check.tsx'","aggregated_output":"     1\t/**\n     2\t * The props-to-patch rules of plan 1.7, as pure functions: present, changed, removed, structurally equal,\n     3\t * data by identity, and handler-only changes.\n     4\t */\n     5\timport { describe, expect, it } from 'vitest';\n     6\timport fc from 'fast-check';\n     7\timport { diff, equal, looksSame, optionsOf } from '../src/patch';\n     8\t\n     9\tconst forward = () => {};\n    10\tconst rows = [{ day: '2026-01-01', sessions: 1 }, { day: '2026-01-02', sessions: 2 }];\n    11\tconst patchOf = (a: Record<string, unknown>, b: Record<string, unknown>) => diff(optionsOf(a, forward), optionsOf(b, forward));\n    12\t\n    13\tdescribe('optionsOf', () => {\n    14\t  it('drops the component props and keeps every option', () => {\n    15\t    const style = { height: 300 };\n    16\t    const options = optionsOf({ data: rows, x: 'day', y: 'sessions', className: 'card', style, onHover() {}, onSelect() {}, onZoom() {}, strict: true }, forward);\n    17\t    expect(options).toEqual({ data: rows, x: 'day', y: 'sessions', strict: true });\n    18\t  });\n    19\t\n    20\t  it('replaces a given onDiagnostic with the forwarder and leaves an absent one absent', () => {\n    21\t    expect(optionsOf({ data: rows, onDiagnostic: () => 1 }, forward).onDiagnostic).toBe(forward);\n    22\t    expect('onDiagnostic' in optionsOf({ data: rows }, forward)).toBe(false);\n    23\t  });\n    24\t});\n    25\t\n    26\tdescribe('diff', () => {\n    27\t  it('is null when nothing changed', () => {\n    28\t    expect(patchOf({ data: rows, x: 'day', y: 'sessions' }, { data: rows, x: 'day', y: 'sessions' })).toBeNull();\n    29\t  });\n    30\t\n    31\t  it('sends a newly present prop', () => {\n    32\t    expect(patchOf({ data: rows }, { data: rows, title: 'Sessions' })).toEqual({ title: 'Sessions' });\n    33\t  });\n    34\t\n    35\t  it('sends a changed prop and only that prop', () => {\n    36\t    expect(patchOf({ data: rows, title: 'A', legend: 'top' }, { data: rows, title: 'B', legend: 'top' })).toEqual({ title: 'B' });\n    37\t  });\n    38\t\n    39\t  it('sends a removed prop as undefined, with the key present', () => {\n    40\t    const patch = patchOf({ data: rows, title: 'A', tooltip: false }, { data: rows });\n    41\t    expect(patch).toEqual({ title: undefined, tooltip: undefined });\n    42\t    expect(Object.keys(patch!).sort()).toEqual(['title', 'tooltip']);\n    43\t  });\n    44\t\n    45\t  it('treats an explicit undefined like an absent prop', () => {\n    46\t    expect(patchOf({ data: rows, title: undefined }, { data: rows })).toBeNull();\n    47\t    expect(patchOf({ data: rows }, { data: rows, title: undefined })).toBeNull();\n    48\t  });\n    49\t\n    50\t  it('compares field specs and other object options structurally', () => {\n    51\t    const make = () => ({\n    52\t      data: rows,\n    53\t      x: { field: 'day', type: 'date', domain: [new Date(Date.UTC(2026, 0, 1)), new Date(Date.UTC(2026, 0, 9))] },\n    54\t      y: ['sessions', { field: 'visits', label: 'Visits', tickFormat: { notation: 'compact' } }],\n    55\t      title: { text: 'T', level: 3 },\n    56\t      reference: [{ y: 10, label: 'Target' }],\n    57\t      colors: { Direct: 'red' },\n    58\t      messages: { noData: 'Nothing' },\n    59\t      state: { empty: 'None yet' },\n    60\t    });\n    61\t    expect(patchOf(make(), make())).toBeNull();\n    62\t  });\n    63\t\n    64\t  it('sees a change deep inside a field spec and sends the whole new value', () => {\n    65\t    const next = { field: 'visits', label: 'Visitors' };\n    66\t    expect(patchOf({ data: rows, y: { field: 'visits', label: 'Visits' } }, { data: rows, y: next })).toEqual({ y: next });\n    67\t    expect(patchOf({ data: rows, colors: { A: 'red' } }, { data: rows, colors: { A: 'red', B: 'blue' } })).toEqual({ colors: { A: 'red', B: 'blue' } });\n    68\t  });\n    69\t\n    70\t  it('compares data by identity only', () => {\n    71\t    const copy = rows.map(r => ({ ...r }));\n    72\t    expect(patchOf({ data: rows }, { data: copy })).toEqual({ data: copy });\n    73\t    expect(patchOf({ data: rows }, { data: rows })).toBeNull();\n    74\t  });\n    75\t\n    76\t  it('ignores handler-only changes', () => {\n    77\t    const a = { data: rows, onHover() {}, onSelect() {}, onZoom() {}, onDiagnostic() {} };\n    78\t    const b = { data: rows, onHover() {}, onSelect() {}, onZoom() {}, onDiagnostic() {} };\n    79\t    expect(patchOf(a, b)).toBeNull();\n    80\t  });\n    81\t\n    82\t  it('sends onDiagnostic when it appears or disappears', () => {\n    83\t    expect(patchOf({ data: rows }, { data: rows, onDiagnostic() {} })).toEqual({ onDiagnostic: forward });\n    84\t    expect(patchOf({ data: rows, onDiagnostic() {} }, { data: rows })).toEqual({ onDiagnostic: undefined });\n    85\t  });\n    86\t\n    87\t  it('compares a function inside a field spec by identity', () => {\n    88\t    const format = (v: number) => `${v}`;\n    89\t    expect(patchOf({ data: rows, y: { field: 'v', format } }, { data: rows, y: { field: 'v', format } })).toBeNull();\n    90\t    expect(patchOf({ data: rows, y: { field: 'v', format } }, { data: rows, y: { field: 'v', format: (v: number) => `${v}` } })).not.toBeNull();\n    91\t  });\n    92\t\n    93\t  it('for any options, the patch applied to the old options gives the new ones (property)', () => {\n    94\t    const value = fc.oneof(fc.string(), fc.integer(), fc.boolean(), fc.constant(undefined), fc.array(fc.integer(), { maxLength: 3 }), fc.dictionary(fc.string({ maxLength: 3 }), fc.integer(), { maxKeys: 3 }));\n    95\t    const options = fc.dictionary(fc.constantFrom('title', 'x', 'y', 'legend', 'colors', 'reference', 'locale'), value);\n    96\t    fc.assert(fc.property(options, options, (a, b) => {\n    97\t      const patch = diff(a, b) ?? {};\n    98\t      const applied: Record<string, unknown> = { ...a };\n    99\t      for (const [k, v] of Object.entries(patch)) applied[k] = v;\n   100\t      for (const k of new Set([...Object.keys(a), ...Object.keys(b)])) expect(equal(applied[k], b[k])).toBe(true);\n   101\t      expect(diff(b, b)).toBeNull();\n   102\t    }));\n   103\t  });\n   104\t});\n   105\t\n   106\tdescribe('equal', () => {\n   107\t  it('does not treat arrays, dates and plain objects as interchangeable', () => {\n   108\t    expect(equal([1], { 0: 1 })).toBe(false);\n   109\t    expect(equal(new Date(0), {})).toBe(false);\n   110\t    expect(equal(new Date(0), new Date(0))).toBe(true);\n   111\t    expect(equal({ a: undefined }, { b: undefined })).toBe(false);\n   112\t    expect(equal(new Map(), new Map())).toBe(false);\n   113\t  });\n   114\t});\n   115\t\n   116\tdescribe('looksSame', () => {\n   117\t  it('matches rebuilt rows and rewrapped columns, and nothing else', () => {\n   118\t    expect(looksSame(rows, rows.map(r => ({ ...r })))).toBe(true);\n   119\t    expect(looksSame(rows, [...rows, { day: '2026-01-03', sessions: 3 }])).toBe(false);\n   120\t    expect(looksSame(rows, [rows[0], { day: '2026-01-02', sessions: 9 }])).toBe(false);\n   121\t    const t = new Float64Array(3);\n   122\t    expect(looksSame({ columns: { t } }, { columns: { t } })).toBe(true);\n   123\t    expect(looksSame({ columns: { t } }, { columns: { t: new Float64Array(3) } })).toBe(false);\n   124\t  });\n   125\t});\n     1\t/**\n     2\t * Server rendering (plan 1.7, spec DX8): each component renders its empty container in Node, where there is\n     3\t * no DOM, and no chart is created.\n     4\t */\n     5\timport { describe, expect, it, vi } from 'vitest';\n     6\timport { createElement, type ReactElement } from 'react';\n     7\timport { renderToString } from 'react-dom/server';\n     8\t\n     9\tconst created: string[] = [];\n    10\t// Bundled from source: the core's dist is not part of this package's tests. The spy shows that the\n    11\t// server never calls a chart function.\n    12\tvi.mock('axylo', async () => {\n    13\t  const core = await import('../../axylo/src/index');\n    14\t  const wrap = <F extends (...args: never[]) => unknown>(name: string, f: F) => ((...args: Parameters<F>) => { created.push(name); return f(...args); }) as F;\n    15\t  return { ...core, line: wrap('line', core.line), area: wrap('area', core.area), bar: wrap('bar', core.bar), scatter: wrap('scatter', core.scatter), donut: wrap('donut', core.donut) };\n    16\t});\n    17\t\n    18\tconst { Area, Bar, Donut, Line, Scatter } = await import('../src/index');\n    19\t\n    20\ttype Row = (typeof rows)[number];\n    21\tconst rows = [{ day: '2026-01-01', channel: 'Direct', sessions: 10, visits: 4 }, { day: '2026-01-02', channel: 'Direct', sessions: 12, visits: 5 }];\n    22\t\n    23\tdescribe('server rendering', () => {\n    24\t  it('runs without a DOM', () => {\n    25\t    expect(typeof (globalThis as { document?: unknown }).document).toBe('undefined');\n    26\t    expect(typeof (globalThis as { window?: unknown }).window).toBe('undefined');\n    27\t  });\n    28\t\n    29\t  const cases: [string, ReactElement][] = [\n    30\t    ['Line', createElement(Line<Row>, { data: rows, x: 'day', y: 'sessions', series: 'channel', title: 'Sessions' })],\n    31\t    ['Area', createElement(Area<Row>, { data: rows, x: 'day', y: 'sessions', stacked: true })],\n    32\t    ['Bar', createElement(Bar<Row>, { data: rows, x: 'channel', y: 'sessions' })],\n    33\t    ['Scatter', createElement(Scatter<Row>, { data: rows, x: 'visits', y: 'sessions' })],\n    34\t    ['Donut', createElement(Donut<Row>, { data: rows, label: 'channel', value: 'sessions' })],\n    35\t  ];\n    36\t\n    37\t  for (const [name, element] of cases) {\n    38\t    it(`${name} renders the empty container and creates no chart`, () => {\n    39\t      created.length = 0;\n    40\t      expect(renderToString(element)).toBe('<div class=\"axylo\"></div>');\n    41\t      expect(created).toEqual([]);\n    42\t    });\n    43\t  }\n    44\t\n    45\t  it('passes className and style to the container', () => {\n    46\t    const html = renderToString(createElement(Line<Row>, { data: rows, x: 'day', y: 'sessions', className: 'card wide', style: { height: 300 } }));\n    47\t    expect(html).toBe('<div class=\"axylo card wide\" style=\"height:300px\"></div>');\n    48\t  });\n    49\t\n    50\t  it('marks the module as a client module', async () => {\n    51\t    const fs = await import('node:fs');\n    52\t    const source = fs.readFileSync(new URL('../src/index.ts', import.meta.url), 'utf8');\n    53\t    expect(source.startsWith(\"'use client';\")).toBe(true);\n    54\t  });\n    55\t});\n     1\t/**\n     2\t * Size budget (task brief): the adapter, minified and gzipped with react, react-dom and axylo external, is at\n     3\t * most 2 KiB. Measured on the production flavour (__DEV__ false) and, for information, the development one.\n     4\t */\n     5\timport { describe, expect, it } from 'vitest';\n     6\timport { build } from 'esbuild';\n     7\timport { gzipSync } from 'node:zlib';\n     8\timport path from 'node:path';\n     9\t\n    10\tconst entry = path.resolve(import.meta.dirname, '../src/index.ts');\n    11\t\n    12\tasync function gzipped(development: boolean): Promise<{ raw: number; gzip: number }> {\n    13\t  const result = await build({\n    14\t    entryPoints: [entry], bundle: true, minify: true, format: 'esm', target: 'es2022', write: false, logLevel: 'silent',\n    15\t    external: ['react', 'react-dom', 'react/jsx-runtime', 'axylo'], define: { __DEV__: String(development) },\n    16\t  });\n    17\t  const code = result.outputFiles[0]!.contents;\n    18\t  if (/axylo-figure|ResizeObserver/.test(new TextDecoder().decode(code))) throw new Error('the core was bundled into the adapter');\n    19\t  return { raw: code.length, gzip: gzipSync(code, { level: 9 }).length };\n    20\t}\n    21\t\n    22\tdescribe('size', () => {\n    23\t  it('production build is at most 2 KiB gzipped', async () => {\n    24\t    const production = await gzipped(false);\n    25\t    const development = await gzipped(true);\n    26\t    console.info(`@axylo/react: production ${production.raw} B min, ${production.gzip} B gzip; development ${development.raw} B min, ${development.gzip} B gzip`);\n    27\t    expect(production.gzip).toBeLessThanOrEqual(2048);\n    28\t  });\n    29\t});\n     1\t/**\n     2\t * Type tests, checked by `tsc -p packages/react` and never run. Each `@ts-expect-error` line must fail to\n     3\t * compile exactly as the matching core call does (plan 1.3, 1.2, 1.4).\n     4\t */\n     5\timport { useRef } from 'react';\n     6\timport { donut, line } from 'axylo';\n     7\timport type { DonutOptions, LineOptions } from 'axylo';\n     8\timport { Area, Bar, Donut, Line, Scatter, type ChartRef } from '../src/index';\n     9\t\n    10\tinterface Row { day: string; channel: string; sessions: number; visits: number; count: string }\n    11\tdeclare const rows: Row[];\n    12\t\n    13\texport function Valid() {\n    14\t  const ref = useRef<ChartRef<Row, LineOptions<Row>>>(null);\n    15\t  ref.current?.chart?.append([{ day: '2026-01-02', channel: 'Direct', sessions: 1, visits: 2, count: '3' }]);\n    16\t  ref.current?.chart?.zoom(null);\n    17\t  const donut = useRef<ChartRef<Row, DonutOptions<Row>>>(null);\n    18\t  return (\n    19\t    <>\n    20\t      <Line ref={ref} data={rows} x=\"day\" y=\"sessions\" series=\"channel\" title=\"Daily sessions\" className=\"card\" style={{ height: 300 }} />\n    21\t      <Line data={rows} x={{ field: 'day', type: 'date' }} y={['sessions', { field: 'visits', label: 'Visits' }]} onHover={p => p?.row?.sessions} onZoom={d => d?.[0]} />\n    22\t      <Line data={rows} x=\"day\" y={{ field: 'count', parse: 'number' }} onDiagnostic={d => d.code} />\n    23\t      <Line data={rows} x=\"day\" y={['sessions', 'visits']} />\n    24\t      <Area data={rows} x=\"day\" y=\"sessions\" series=\"channel\" stacked />\n    25\t      <Bar data={rows} x=\"channel\" y=\"sessions\" layout=\"stacked\" horizontal />\n    26\t      <Scatter data={rows} x=\"visits\" y=\"sessions\" series=\"channel\" />\n    27\t      <Donut ref={donut} data={rows} label=\"channel\" value=\"sessions\" onSelect={p => p.index} />\n    28\t    </>\n    29\t  );\n    30\t}\n    31\t\n    32\texport function Invalid() {\n    33\t  return (\n    34\t    <>\n    35\t      {/* @ts-expect-error misspelled field */}\n    36\t      <Line data={rows} x=\"day\" y=\"sesions\" />\n    37\t      {/* @ts-expect-error a text field on a value axis without parse: 'number' */}\n    38\t      <Line data={rows} x=\"day\" y=\"channel\" />\n    39\t      {/* @ts-expect-error series cannot be combined with wide y */}\n    40\t      <Line data={rows} x=\"day\" y={['sessions', 'visits']} series=\"channel\" />\n    41\t      {/* @ts-expect-error zoom does not apply to a donut */}\n    42\t      <Donut data={rows} label=\"channel\" value=\"sessions\" zoom />\n    43\t      {/* @ts-expect-error onZoom does not apply to a donut either */}\n    44\t      <Donut data={rows} label=\"channel\" value=\"sessions\" onZoom={() => {}} />\n    45\t      {/* @ts-expect-error the same misspelling on the other chart types */}\n    46\t      <Bar data={rows} x=\"day\" y=\"sesions\" />\n    47\t      {/* @ts-expect-error a category x on a scatter chart */}\n    48\t      <Scatter data={rows} x={{ field: 'channel', type: 'category' }} y=\"sessions\" />\n    49\t    </>\n    50\t  );\n    51\t}\n    52\t\n    53\t/** The same mistakes in core calls, so the components are seen to fail exactly where the core does. */\n    54\texport function core(el: HTMLElement) {\n    55\t  // @ts-expect-error misspelled field\n    56\t  line(el, { data: rows, x: 'day', y: 'sesions' });\n    57\t  // @ts-expect-error a text field on a value axis without parse: 'number'\n    58\t  line(el, { data: rows, x: 'day', y: 'channel' });\n    59\t  // @ts-expect-error series cannot be combined with wide y\n    60\t  line(el, { data: rows, x: 'day', y: ['sessions', 'visits'], series: 'channel' });\n    61\t  // @ts-expect-error zoom does not apply to a donut\n    62\t  donut(el, { data: rows, label: 'channel', value: 'sessions', zoom: true });\n    63\t}\n","exit_code":0,"status":"completed"}}
