{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/react/test/browser/react.browser.test.ts'","aggregated_output":"     1\t/**\n     2\t * @axylo/react in system Chrome (plan 1.7, spec DX8): lifecycle, StrictMode, props to patches, removed props,\n     3\t * handlers, the ref, error boundaries, independence and hydration. The app (app.tsx) is driven through\n     4\t * `window.app`; the core is wrapped (spy-axylo.ts) so creates, updates and destroys can be counted.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { renderToString } from 'react-dom/server';\n     9\timport { start, stop } from '../../../axylo/test/browser/harness';\n    10\timport { closeApp, openApp } from './open';\n    11\timport type { Spec } from './app';\n    12\t\n    13\t// The hydration test renders the tree in Node too, from source.\n    14\tvi.mock('axylo', () => import('../../../axylo/src/index'));\n    15\tconst { hydrationTree } = await import('./tree');\n    16\t\n    17\tbeforeAll(start);\n    18\tafterAll(stop);\n    19\t\n    20\ttype App = {\n    21\t  render(specs: Spec[], options?: { strict?: boolean }): Promise<void>;\n    22\t  ready(): Promise<void>;\n    23\t  setData(name: string, rows: unknown[]): void;\n    24\t  chart(i: number): { append(rows: unknown[]): void; diagnostics: unknown[]; __bench: { describe(): { series: { points: number; newestX: number }[] } } } | null;\n    25\t  spy: { attempts: number; charts: { kind: string; element: HTMLElement; updates: Record<string, unknown>[]; destroyed: boolean }[] };\n    26\t  probe: { resizeCallbacks: number; observers: number; pendingFrames: number; mark(): number; leakedSince(mark: number): string[] };\n    27\t  events: [string, number | null][];\n    28\t  hydrationErrors: string[];\n    29\t  nextFrames(n: number): Promise<void>;\n    30\t  hydrate(): Promise<void>;\n    31\t};\n    32\tdeclare const window: Window & { app: App; saved?: Element | null };\n    33\t\n    34\tconst day = (i: number) => `2026-01-${String(i + 1).padStart(2, '0')}`;\n    35\tconst trend = Array.from({ length: 10 }, (_, i) => [\n    36\t  { day: day(i), channel: 'Direct', sessions: 30 + (i % 4) * 3, visits: 10 + i },\n    37\t  { day: day(i), channel: 'Organic', sessions: 20 + (i % 3) * 2, visits: 5 + i },\n    38\t]).flat();\n    39\tconst single = Array.from({ length: 10 }, (_, i) => ({ day: day(i), sessions: 10 + i }));\n    40\tconst slices = [{ channel: 'Direct', sessions: 30 }, { channel: 'Organic', sessions: 20 }, { channel: 'Referral', sessions: 10 }];\n    41\t// AX106: a number field holding one string. A warning, so a strict chart throws.\n    42\tconst bad = single.map((r, i) => i === 4 ? { ...r, sessions: '14' } : r);\n    43\t\n    44\tasync function open(): Promise<Page> {\n    45\t  const page = await openApp();\n    46\t  await page.evaluate(([t, s, d, b]) => {\n    47\t    window.app.setData('trend', t);\n    48\t    window.app.setData('single', s);\n    49\t    window.app.setData('slices', d);\n    50\t    window.app.setData('bad', b);\n    51\t  }, [trend, single, slices, bad] as const);\n    52\t  return page;\n    53\t}\n    54\t\n    55\tconst render = (page: Page, specs: Spec[], options: { strict?: boolean } = {}) =>\n    56\t  page.evaluate(async ([s, o]) => { await window.app.render(s, o); await window.app.ready(); }, [specs, options] as const);\n    57\t\n    58\tconst named = (page: Page, name: string) => page.getByRole('group', { name, exact: true }).count();\n    59\t\n    60\tconst spyState = (page: Page) => page.evaluate(() => ({\n    61\t  attempts: window.app.spy.attempts,\n    62\t  charts: window.app.spy.charts.map(c => ({ kind: c.kind, destroyed: c.destroyed, updates: c.updates.map(p => Object.keys(p)) })),\n    63\t}));\n    64\t\n    65\tasync function hoverAt(page: Page, fraction: number):