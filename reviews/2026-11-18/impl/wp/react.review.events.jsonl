[0]!.destroyed).toBe(true);\n    98\t      expect(await page.evaluate(() => window.app.chart(0))).toBeNull();\n    99\t      expect(await closeApp(page)).toEqual([]);\n   100\t    });\n   101\t  }\n   102\t});\n   103\t\n   104\tdescribe('StrictMode', () => {\n   105\t  it('setup, cleanup, setup leaves one chart; unmount leaves nothing behind', async () => {\n   106\t    const page = await open();\n   107\t    await render(page, [], { strict: true });\n   108\t    const before = await page.evaluate(() => ({ mark: window.app.probe.mark(), observers: window.app.probe.observers }));\n   109\t\n   110\t    await render(page, [{ type: 'Line', data: 'trend', props: { x: 'day', y: 'sessions', series: 'channel', title: 'Strict' } }], { strict: true });\n   111\t    expect(await page.locator('#chart figure').count()).toBe(1);\n   112\t    expect(await named(page, 'Strict')).toBe(1);\n   113\t    const state = await spyState(page);\n   114\t    // StrictMode ran the create effect twice and its cleanup once.\n   115\t    expect(state.attempts).toBe(2);\n   116\t    expect(state.charts.map(c => c.destroyed)).toEqual([true, false]);\n   117\t    expect(await page.evaluate(() => window.app.probe.observers)).toBeGreaterThan(before.observers);\n   118\t\n   119\t    await render(page, [], { strict: true });\n   120\t    expect(await page.evaluate(() => document.getElementById('chart')!.innerHTML)).toBe('');\n   121\t    await page.evaluate(() => window.app.nextFrames(2));\n   122\t    const callbacks = await page.evaluate(() => window.app.probe.resizeCallbacks);\n   123\t    await page.evaluate(() => { document.getElementById('chart')!.style.width = '360px'; });\n   124\t    await page.setViewportSize({ width: 500, height: 600 });\n   125\t    await page.evaluate(() => window.app.nextFrames(4));\n   126\t    const after = await page.evaluate(m => ({\n   127\t      callbacks: window.app.probe.resizeCallbacks, observers: window.app.probe.observers,\n   128\t      leaked: window.app.probe.leakedSince(m), frames: window.app.probe.pendingFrames,\n   129\t    }), before.mark);\n   130\t    expect(after).toEqual({ callbacks, observers: before.observers, leaked: [], frames: 0 });\n   131\t    expect(await closeApp(page)).toEqual([]);\n   132\t  });\n   133\t});\n   134\t\n   135\tdescribe('props to options', () => {\n   136\t  it('an inline field object re-rendered ten times causes zero update calls', async () => {\n   137\t    const page = await open();\n   138\t    const spec = (label: string): Spec => ({\n   139\t      type: 'Line', data: 'trend', props: {\n   140\t        x: { field: 'day', type: 'date' }, y: { field: 'sessions', label, tickFormat: { notation: 'compact' } }, series: 'channel',\n   141\t        title: { text: 'Inline', level: 3 }, colors: { Direct: '#1f6feb' }, reference: [{ y: 30, label: 'Target' }],\n   142\t        messages: { noData: 'Nothing' }, style: { height: 300 },\n   143\t      },\n   144\t    });\n   145\t    await render(page, [spec('Sessions')]);\n   146\t    // Each evaluate deserializes the spec anew, so every render passes new objects.\n   147\t    for (let i = 0; i < 10; i++) await render(page, [spec('Sessions')]);\n   148\t    expect(await spyState(page)).toEqual({ attempts: 1, charts: [{ kind: 'line', destroyed: false, updates: [] }] });\n   149\t    // The spy does see a real change.\n   150\t    await render(page, [spec('Visits')]);\n   151\t    expect((await spyState(page)).charts[0]!.updates).toEqual([['y']]);\n   152\t    expect(await closeApp(page)).toEqual([]);\n   153\t  });\n   154\t\n   155\t  it('a removed title restores the generated name', async () => {\n   156\t    const page = await open();\n   157\t    const props = { x: 'day', y: 'sessions', series: 'channel' };\n   158\t    // The second chart never had a title: its name is the generated one.\n   159\t    await render(page, [{ type: 'Line', data: 'trend', props: { ...props, title: 'Sessions' } }, { type: 'Line', data: 'trend', props }]);\n   160\t    expect(await named(page, 'Sessions')).toBe(1);\n   161\t    const generated = await page.evaluate(() => document.querySelectorAll('#chart figure')[1]!.getAttribute('aria-label'));\n   162\t    expect(generated).toBeTruthy();\n   163\t\n   164\t    await render(page, [{ type: 'Line', data: 'trend', props }, { type: 'Line', data: 'trend', props }]);\n   165\t    const sent = await page.evaluate(() => window.app.spy.charts[0]!.updates.map(p => [Object.keys(p), 'title' in p && p.title === undefined]));\n   166\t    expect(sent).toEqual([[['title'], true]]);\n   167\t    expect(await named(page, 'Sessions')).toBe(0);\n   168\t    expect(await named(page, generated!)).toBe(2);\n   169\t    expect(await page.evaluate(() => document.querySelector('#chart figure')!.hasAttribute('aria-labelledby'))).toBe(false);\n   170\t    expect(await closeApp(page)).toEqual([]);\n   171\t  });\n   172\t\n   173\t  it('a removed tooltip={false} restores the tooltip', async () => {\n   174\t    const page = await open();\n   175\t    const props = { x: 'day', y: 'sessions', series: 'channel', title: 'Tips' };\n   176\t    const shown = () => page.evaluate(() => [...document.querySelectorAll<HTMLElement>('#chart .axylo-tooltip, #chart .axylo-readout')].some(e => !e.hidden));\n   177\t    await render(page, [{ type: 'Line', data: 'trend', hover: 'h', props: { ...props, tooltip: false } }]);\n   178\t    await hoverAt(page, 0.3);\n   179\t    expect((await page.evaluate(() => window.app.events.length))).toBeGreaterThan(0);\n   180\t    expect(await shown()).toBe(false);\n   181\t\n   182\t    await render(page, [{ type: 'Line', data: 'trend', hover: 'h', props }]);\n   183\t    expect((await spyState(page)).charts[0]!.updates).toEqual([['tooltip']]);\n   184\t    await hoverAt(page, 0.7);\n   185\t    expect(await shown()).toBe(true);\n   186\t    expect(await closeApp(page)).toEqual([]);\n   187\t  });\n   188\t\n   189\t  it('data with a new identity and the same content three renders in a row warns once', async () => {\n   190\t    const page = await open();\n   191\t    const warnings: string[] = [];\n   192\t    page.on('console', m => { if (m.type() === 'warning' && m.text().includes('[axylo/react]')) warnings.push(m.text()); });\n   193\t    const spec: Spec = { type: 'Line', data: 'copy', props: { x: 'day', y: 'sessions', title: 'Copies' } };\n   194\t    const again = async () => {\n   195\t      await page.evaluate(rows => window.app.setData('copy', rows), single);\n   196\t      await render(page, [spec]);\n   197\t    };\n   198\t    await again();\n   199\t    await again();\n   200\t    await again();\n   201\t    expect(warnings).toEqual([]);\n   202\t    await again();\n   203\t    await again();\n   204\t    await again();\n   205\t    expect(warnings).toHaveLength(1);\n   206\t    expect(warnings[0]).toContain('Memoize');\n   207\t    // Identity is all that counts for the update itself.\n   208\t    expect((await spyState(page)).charts[0]!.updates).toEqual(Array.from({ length: 5 }, () => ['data']));\n   209\t    expect(await closeApp(page)).toEqual([]);\n   210\t  });\n   211\t});\n   212\t\n   213\tdescribe('handlers', () => {\n   214\t  it('the latest onHover is called and the chart is not recreated', async () => {\n   215\t    const page = await open();\n   216\t    const props = { x: 'day', y: 'sessions', series: 'channel', title: 'Handlers' };\n   217\t    await render(page, [{ type: 'Line', data: 'trend', hover: 'first', props }]);\n   218\t    await page.evaluate(() => { window.saved = document.querySelector('#chart figure'); });\n   219\t    await hoverAt(page, 0.2);\n   220\t    const firstCount = await page.evaluate(() => window.app.events.length);\n   221\t    expect(firstCount).toBeGreaterThan(0);\n   222\t    expect(await page.evaluate(() => window.app.events.every(e => e[0] === 'first'))).toBe(true);\n   223\t\n   224\t    await render(page, [{ type: 'Line', data: 'trend', hover: 'second', props }]);\n   225\t    await hoverAt(page, 0.8);\n   226\t    const later = await page.evaluate(n => window.app.events.slice(n).map(e => e[0]), firstCount);\n   227\t    expect(later.length).toBeGreaterThan(0);\n   228\t    expect(new Set(later)).toEqual(new Set(['second']));\n   229\t    expect(await spyState(page)).toEqual({ attempts: 1, charts: [{ kind: 'line', destroyed: false, updates: [] }] });\n   230\t    expect(await page.evaluate(() => document.querySelector('#chart figure') === window.saved)).toBe(true);\n   231\t    expect(await closeApp(page)).toEqual([]);\n   232\t  });\n   233\t});\n   234\t\n   235\tdescribe('ref', () => {\n   236\t  it('ref.current.chart.append adds a point; a new data prop replaces the stream', async () => {\n   237\t    const page = await open();\n   238\t    const props = { x: 'day', y: 'sessions', title: 'Stream' };\n   239\t    await render(page, [{ type: 'Line', data: 'single', props }]);\n   240\t    const first = await page.evaluate(() => ({ s: window.app.chart(0)!.__bench.describe().series[0]!, diagnostics: Array.isArray(window.app.chart(0)!.diagnostics) }));\n   241\t    expect(first.s.points).toBe(10);\n   242\t    expect(first.diagnostics).toBe(true);\n   243\t\n   244\t    await page.evaluate(async () => { window.app.chart(0)!.append([{ day: '2026-01-11', sessions: 21 }]); await window.app.ready(); });\n   245\t    const appended = await page.evaluate(() => window.app.chart(0)!.__bench.describe().series[0]!);\n   246\t    expect(appended.points).toBe(11);\n   247\t    expect(appended.newestX).toBeGreaterThan(first.s.newestX);\n   248\t\n   249\t    await page.evaluate(rows => window.app.setData('single again', rows), single);\n   250\t    await render(page, [{ type: 'Line', data: 'single again', props }]);\n   251\t    expect((await spyState(page)).charts[0]!.updates).toEqual([['data']]);\n   252\t    const replaced = await page.evaluate(() => window.app.chart(0)!.__bench.describe().series[0]!);\n   253\t    expect(replaced).toEqual(first.s);