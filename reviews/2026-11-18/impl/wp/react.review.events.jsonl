{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/public.ts'","aggregated_output":"     1\t/**\n     2\t * Public types of Axylo. The functions that use them are exported from index.ts.\n     3\t * Source of truth for the public API; docs/api/axylo.d.ts is the reviewed sketch this file started from.\n     4\t */\n     5\t\n     6\t// ---------- data ----------\n     7\t\n     8\t/** Rows as an API returns them, or typed columns for large data. Both describe the same logical table. */\n     9\texport type Data<Row> = readonly Row[] | { readonly columns: { readonly [K in keyof Row]: ArrayLike<Row[K]> } };\n    10\t\n    11\ttype Key<Row> = Extract<keyof Row, string>;\n    12\ttype KeysWhere<Row, V> = { [K in Key<Row>]: [Row[K]] extends [V] ? K : never }[Key<Row>];\n    13\t\n    14\t/** A field that can sit on a value axis as it is. */\n    15\texport type NumberKey<Row> = KeysWhere<Row, number | null | undefined>;\n    16\t/** A field of numeric strings (Postgres bigint and numeric, BigQuery): allowed only with `parse: 'number'`. */\n    17\texport type StringKey<Row> = KeysWhere<Row, string | null | undefined>;\n    18\t/** A field that can sit on an x axis: numbers, instants, calendar dates or categories. */\n    19\texport type XKey<Row> = KeysWhere<Row, number | string | Date | null | undefined>;\n    20\t/** A field that names a series. */\n    21\texport type SeriesKey<Row> = KeysWhere<Row, string | number | boolean>;\n    22\t\n    23\texport type XValue = number | string | Date;\n    24\t\n    25\t// ---------- fields ----------\n    26\t\n    27\tinterface FieldCommon {\n    28\t  /** Axis title and the name used in tooltip, table and announcements. */\n    29\t  label?: string;\n    30\t  /** Unit appended to values in tooltip, table and announcements: 'ms', 'USD', … */\n    31\t  unit?: string;\n    32\t}\n    33\t\n    34\texport interface ValueFieldOptions extends FieldCommon {\n    35\t  /** Declares percentage data and its convention: 'percent' = 0–100, 'ratio' = 0–1. Never inferred from the label. */\n    36\t  scale?: 'percent' | 'ratio';\n    37\t  /** How values are written in tooltip, table and announcements. Default: locale grouping, up to 6 significant fraction digits. */\n    38\t  format?: Intl.NumberFormatOptions | ((value: number) => string);\n    39\t  /** How axis ticks are written. Default: compact when it saves space. */\n    40\t  tickFormat?: Intl.NumberFormatOptions | ((value: number) => string);\n    41\t  /** What a missing value means. 'gap' (default) draws nothing; 'zero' is for counts where absence means none. */\n    42\t  missing?: 'gap' | 'zero';\n    43\t  /** Author bounds. On bar and area the domain is widened to include zero and AX110 is raised if it did not. */\n    44\t  domain?: readonly [number, number];\n    45\t}\n    46\t\n    47\texport type ValueField<Row> =\n    48\t  | NumberKey<Row>\n    49\t  | ({ field: NumberKey<Row>; parse?: never } & ValueFieldOptions)\n    50\t  | ({ field: StringKey<Row>; parse: 'number' } & ValueFieldOptions);\n    51\t\n    52\texport interface XFieldOptions extends FieldCommon {\n    53\t  /**\n    54\t   * 'date': calendar dates ('2026-02-24'); read the same in every time zone.\n    55\t   * 'time': instants (epoch milliseconds, Date objects, ISO strings with an offset); shown in `timeZone`.\n    56\t   * 'number' and 'category' as named. Inferred when omitted, except that numbers are never inferred to be instants.\n    57\t   */\n    58\t  type?: 'number' | 'time' | 'date' | 'category';\n    59\t  /** Category axes only: the categories have a natural order (months, age bands), so labels may be thinned when they do not fit. */\n    60\t  ordered?: boolean;\n    61\t  /** For instants only. Default 'local' (the viewer's zone). */\n    62\t  timeZone?: 'local' | 'UTC' | (string & {});\n    63\t  format?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n    64\t  tickFormat?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n    65\t  domain?: readonly [XValue, XValue];\n    66\t}\n    67\t\n    68\texport type XField<Row> = XKey<Row> | ({ field: XKey<Row> } & XFieldOptions);\n    69\t\n    70\t/** Long form: one row per (x, series). Wide form: one row per x, one column per series. Never both. */\n    71\texport type Encoding<Row> =\n    72\t  | { x: XField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> }\n    73\t  | { x: XField<Row>; y: readonly ValueField<Row>[]; series?: never };\n    74\t\n    75\t// ---------- options ----------\n    76\t\n    77\texport interface Title { text: string; visible?: boolean; level?: 2 | 3 | 4 | 5 | 6 }\n    78\t\n    79\texport interface CommonOptions<Row> {\n    80\t  data: Data<Row>;\n    81\t  /** Visible heading and accessible name. */\n    82\t  title?: string | Title;\n    83\t  /** Id of an existing heading that names the chart, for dashboard cards that already show a title. */\n    84\t  labelledBy?: string;\n    85\t  subtitle?: string;\n    86\t  /** Added to the generated summary. Mandatory disclosures (time zone, omitted values) are kept. */\n    87\t  description?: string;\n    88\t  state?: 'ready' | 'loading' | { error: string } | { empty: string };\n    89\t  legend?: 'auto' | false | 'top' | 'right' | 'bottom';\n    90\t  tooltip?: boolean;\n    91\t  /** \"View as table\" control. Default true. */\n    92\t  table?: boolean;\n    93\t  /** Fixed color per series name, so \"Direct\" is the same color on every chart: { Direct: 'var(--brand-1)' }. */\n    94\t  colors?: Readonly<Record<string, string>>;\n    95\t  /** Overrides for built-in text (\"View as table\", \"No data\", …). */\n    96\t  messages?: Partial<Messages>;\n    97\t  /** Default: the document language. */\n    98\t  locale?: string;\n    99\t  /** Throw on any warning or error diagnostic, synchronously from the call that caused it. */\n   100\t  strict?: boolean;\n   101\t  onDiagnostic?: (diagnostic: Diagnostic) => void;\n   102\t}\n   103\t\n   104\texport interface Reference {\n   105\t  x?: XValue | readonly [XValue, XValue];\n   106\t  y?: number | readonly [number, number];\n   107\t  label: string;\n   108\t}\n   109\t\n   110\texport interface CartesianOptions {\n   111\t  /** Default true on time, date and number x axes. 'touch' also captures pinch and two-finger drag on touch screens. */\n   112\t  zoom?: boolean | 'touch';\n   113\t  reference?: readonly Reference[];\n   114\t}\n   115\t\n   116\t/** Line, area and bar only. Marks only, as a static image with a text alternative: no axes, legend, toolbar, table, zoom or tooltip. */\n   117\texport interface CompactOption { compact?: boolean }\n   118\t\n   119\texport type LineOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row>;\n   120\texport type AreaOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { stacked?: boolean };\n   121\texport type BarOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { layout?: 'grouped' | 'stacked'; horizontal?: boolean };\n   122\t/** Scatter relates two measures: its x is a number, an instant or a date, never a category. */\n   123\texport type ScatterXField<Row> = XKey<Row> | ({ field: XKey<Row>; type?: 'number' | 'time' | 'date'; ordered?: never } & Omit<XFieldOptions, 'type' | 'ordered'>);\n   124\texport type ScatterOptions<Row> = CommonOptions<Row> & CartesianOptions & { x: ScatterXField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> };\n   125\texport type DonutOptions<Row> = CommonOptions<Row> & { label: SeriesKey<Row>; value: ValueField<Row> };\n   126\t\n   127\t// ---------- handle ----------\n   128\t\n   129\texport interface Point<Row> { series: string; x: XValue; y: number | null; row: Row | null; index: number }\n   130\t\n   131\texport interface ChartEvents<Row> {\n   132\t  hover: Point<Row> | null;\n   133\t  select: Point<Row>;\n   134\t  zoom: readonly [XValue, XValue] | null;\n   135\t}\n   136\t\n   137\texport interface Chart<Row, Options> {\n   138\t  /**\n   139\t   * Changes options. Keys present replace the old value; a key set to `undefined` returns to its default; absent keys stay.\n   140\t   * Validation and diagnostics are synchronous (a `strict` chart throws here and keeps its last valid state); drawing happens on the next frame.\n   141\t   */\n   142\t  update(patch: Partial<Options>): void;\n   143\t  /** Adds rows at the end. `keep` = number of distinct x values retained; older ones are dropped. */\n   144\t  append(rows: readonly Row[], options?: { keep?: number }): void;\n   145\t  /** Sets the visible x range; `null` shows everything. */\n   146\t  zoom(domain: readonly [XValue, XValue] | null): void;\n   147\t  on<E extends keyof ChartEvents<Row>>(event: E, listener: (payload: ChartEvents<Row>[E]) => void): () => void;\n   148\t  /** Diagnostics for the current options and data. Up to date as soon as create, update or append returns. */\n   149\t  readonly diagnostics: readonly Diagnostic[];\n   150\t  destroy(): void;\n   151\t}\n   152\t\n   153\texport type Target = string | HTMLElement;\n   154\t\n   155\t\n   156\t\n   157\t\n   158\t\n   159\t\n   160\t\n   161\t// ---------- diagnostics ----------\n   162\t\n   163\texport interface Diagnostic {\n   164\t  /** Stable and documented, one page per code. */\n   165\t  code: `AX${number}`;\n   166\t  level: 'error' | 'warning' | 'hint';\n   167\t  /** What is wrong, where, and how to fix it. */\n   168\t  message: string;\n   169\t  /** The chart it came from: its title, else its element id. */\n   170\t  chart: string;\n   171\t  /** Where applicable. A diagnostic about the chart as a whole (no title, low contrast) has neither. */\n   172\t  field?: string;\n   173\t  /** First offending row indexes in the caller's own data, capped at 10. */\n   174\t  rows?: readonly number[];\n   175\t  count?: number;\n   176\t}\n   177\t\n   178\t/** Runs normalization and validation only. Works without a DOM, so a server or an agent can check options before rendering. */\n   179\t\n   180\t/** Built-in text. Templates use {name} placeholders. Every entry can be replaced through `messages` (spec A10). */\n   181\texport interface Messages {\n   182\t  viewAsTable: string; hideTable: string;\n   183\t  noData: string; noObservation: string; incompleteStack: string;\n   184\t  moreRows: string; otherSlices: string;\n   185\t  valuesNotShown: string; valuesChanged: string; labelsHidden: string;\n   186\t  loading: string; empty: string; error: string; internalError: string;\n   187\t  chartName: string; chartSummary: string; seriesSummary: string; referenceSummary: string; timeZoneNote: string;\n   188\t  plotLabel: string; controlsLabel: string; pointOf: string;\n   189\t  zoomIn: string; zoomOut: string; resetZoom: string; pause: string; resume: string;\n   190\t  previousPage: string; nextPage: string; pageOf: string; jumpToX: string;\n   191\t  showSeries: string; hideSeries: string;\n   192\t  /** Column headers and nouns. */\n   193\t  category: string; percentage: string; series: string; value: string;\n   194\t  /** Chart type names used in generated names and summaries. */\n   195\t  typeLine: string; typeArea: string; typeBar: string; typeScatter: string; typeDonut: string;\n   196\t  /** Summary sentences that have no cartesian form. */\n   197\t  donutSummary: string; seriesNoData: string; seriesNotDrawn: string; referenceLine: string; referenceBand: string;\n   198\t  /** What the keyboard proxy says it is (\"{type} chart\") and how it reads a position. */\n   199\t  plotRole: string; pointAll: string; seriesValue: string; position: string;\n   200\t  /** Label of the stack total in tooltips. */\n   201\t  total: string;\n   202\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/react/src/index.ts; nl -ba packages/react/src/patch.ts'","aggregated_output":"     1\t'use client';\n     2\t/**\n     3\t * React components for Axylo (plan 1.7). Each renders one empty <div> and drives a core chart inside it from\n     4\t * effects, so server rendering produces the container only and never reaches the core's browser code.\n     5\t */\n     6\timport { createElement, forwardRef, useEffect, useImperativeHandle, useRef, useState } from 'react';\n     7\timport type { CSSProperties, ReactElement, Ref } from 'react';\n     8\timport { area, bar, donut, line, scatter } from 'axylo';\n     9\timport type {\n    10\t  AreaOptions, BarOptions, Chart, ChartEvents, Diagnostic, DonutOptions, LineOptions, ScatterOptions,\n    11\t} from 'axylo';\n    12\timport { diff, looksSame, optionsOf, type Options } from './patch';\n    13\t\n    14\t/** What a component's `ref` receives. `chart` is null before mount, after unmount and on the server. */\n    15\texport interface ChartRef<Row, ChartOptions> {\n    16\t  readonly chart: Chart<Row, ChartOptions> | null;\n    17\t}\n    18\t\n    19\tinterface ComponentProps<Row, ChartOptions> {\n    20\t  className?: string;\n    21\t  style?: CSSProperties;\n    22\t  ref?: Ref<ChartRef<Row, ChartOptions>>;\n    23\t  onHover?: (point: ChartEvents<Row>['hover']) => void;\n    24\t  onSelect?: (point: ChartEvents<Row>['select']) => void;\n    25\t}\n    26\t\n    27\tinterface ZoomEvent {\n    28\t  onZoom?: (domain: ChartEvents<unknown>['zoom']) => void;\n    29\t}\n    30\t\n    31\texport type LineProps<Row> = LineOptions<Row> & ComponentProps<Row, LineOptions<Row>> & ZoomEvent;\n    32\texport type AreaProps<Row> = AreaOptions<Row> & ComponentProps<Row, AreaOptions<Row>> & ZoomEvent;\n    33\texport type BarProps<Row> = BarOptions<Row> & ComponentProps<Row, BarOptions<Row>> & ZoomEvent;\n    34\texport type ScatterProps<Row> = ScatterOptions<Row> & ComponentProps<Row, ScatterOptions<Row>> & ZoomEvent;\n    35\texport type DonutProps<Row> = DonutOptions<Row> & ComponentProps<Row, DonutOptions<Row>>;\n    36\t\n    37\ttype AnyChart = Chart<unknown, Options>;\n    38\ttype Create = (target: HTMLElement, options: Options) => AnyChart;\n    39\ttype Listener = ((payload: unknown) => void) | undefined;\n    40\t\n    41\tconst EVENTS = [['onHover', 'hover'], ['onSelect', 'select'], ['onZoom', 'zoom']] as const;\n    42\tlet hinted = false;\n    43\t\n    44\tfunction component(create: Create, name: string): unknown {\n    45\t  const Axylo = forwardRef<ChartRef<unknown, Options>, Options>((props, ref) => {\n    46\t    const target = useRef<HTMLDivElement>(null);\n    47\t    const latest = useRef(props);\n    48\t    const live = useRef<{ chart: AnyChart; applied: Options; repeats: number } | null>(null);\n    49\t    // A throw inside an effect never reaches an error boundary; kept here and thrown from render instead.\n    50\t    const [failure, setFailure] = useState<{ error: unknown } | null>(null);\n    51\t    const [onDiagnostic] = useState(() => (d: Diagnostic) => (latest.current.onDiagnostic as Listener)?.(d));\n    52\t\n    53\t    useImperativeHandle(ref, () => ({ get chart() { return live.current?.chart ?? null; } }), []);\n    54\t\n    55\t    useEffect(() => { latest.current = props; });\n    56\t\n    57\t    useEffect(() => {\n    58\t      const options = optionsOf(latest.current, onDiagnostic);\n    59\t      let chart: AnyChart;\n    60\t      try {\n    61\t        chart = create(target.current!, options);\n    62\t      } catch (error) {\n    63\t        setFailure({ error });\n    64\t        return;\n    65\t      }\n    66\t      // Listeners go through `latest`, so a new handler is picked up without touching the chart.\n    67\t      for (const [prop, event] of EVENTS) chart.on(event, payload => (latest.current[prop] as Listener)?.(payload));\n    68\t      live.current = { chart, applied: options, repeats: 0 };\n    69\t      return () => {\n    70\t        live.current = null;\n    71\t        chart.destroy();\n    72\t      };\n    73\t    }, []);\n    74\t\n    75\t    useEffect(() => {\n    76\t      const state = live.current;\n    77\t      if (!state) return;\n    78\t      const next = optionsOf(props, onDiagnostic);\n    79\t      if (__DEV__ && !hinted) {\n    80\t        const before = state.applied.data;\n    81\t        state.repeats = next.data !== before && looksSame(before, next.data) ? state.repeats + 1 : 0;\n    82\t        if (state.repeats >= 3) {\n    83\t          hinted = true;\n    84\t          console.warn(`[axylo/react] <${name}> received the same data as a new object three renders in a row, so the chart renormalizes it each time. Memoize \\`data\\` (useMemo, or keep it in state).`);\n    85\t        }\n    86\t      }\n    87\t      const patch = diff(state.applied, next);\n    88\t      if (!patch) return;\n    89\t      try {\n    90\t        state.chart.update(patch);\n    91\t        state.applied = next;\n    92\t      } catch (error) {\n    93\t        setFailure({ error });\n    94\t      }\n    95\t    });\n    96\t\n    97\t    if (failure) throw failure.error;\n    98\t    // `axylo` is the class the core puts on its root; rendering it keeps React from removing it when\n    99\t    // `className` changes.\n   100\t    return createElement('div', { ref: target, className: props.className ? `axylo ${props.className as string}` : 'axylo', style: props.style as CSSProperties });\n   101\t  });\n   102\t  Axylo.displayName = name;\n   103\t  return Axylo;\n   104\t}\n   105\t\n   106\texport const Line = component(line as unknown as Create, 'Line') as <Row>(props: LineProps<Row>) => ReactElement | null;\n   107\texport const Area = component(area as unknown as Create, 'Area') as <Row>(props: AreaProps<Row>) => ReactElement | null;\n   108\texport const Bar = component(bar as unknown as Create, 'Bar') as <Row>(props: BarProps<Row>) => ReactElement | null;\n   109\texport const Scatter = component(scatter as unknown as Create, 'Scatter') as <Row>(props: ScatterProps<Row>) => ReactElement | null;\n   110\texport const Donut = component(donut as unknown as Create, 'Donut') as <Row>(props: DonutProps<Row>) => ReactElement | null;\n     1\t/**\n     2\t * Props to options, and options to the patch `chart.update` receives (plan 1.7). Pure, so it runs in Node.\n     3\t */\n     4\timport type { Diagnostic } from 'axylo';\n     5\t\n     6\texport type Options = Record<string, unknown>;\n     7\t\n     8\t/** Props that belong to the component and never reach the core. */\n     9\tconst OWN = new Set(['className', 'style', 'onHover', 'onSelect', 'onZoom', 'children']);\n    10\t\n    11\t/**\n    12\t * The options a set of props stands for. A given `onDiagnostic` is replaced by the component's own stable\n    13\t * forwarder, so a new handler function is not a change the chart needs to hear about.\n    14\t */\n    15\texport function optionsOf(props: Options, onDiagnostic: (diagnostic: Diagnostic) => void): Options {\n    16\t  const options: Options = {};\n    17\t  for (const key in props) {\n    18\t    if (!OWN.has(key)) options[key] = key === 'onDiagnostic' && props[key] ? onDiagnostic : props[key];\n    19\t  }\n    20\t  return options;\n    21\t}\n    22\t\n    23\t/**\n    24\t * What changed from `previous` to `next`, or null. `data` is compared by identity (comparing rows would cost\n    25\t * as much as normalizing them); everything else structurally, so inline objects and arrays do not count as\n    26\t * changes. A key that is gone is sent as `undefined`, which the core reads as \"back to the default\".\n    27\t */\n    28\texport function diff(previous: Options, next: Options): Options | null {\n    29\t  let patch: Options | null = null;\n    30\t  for (const key of new Set([...Object.keys(previous), ...Object.keys(next)])) {\n    31\t    const a = previous[key];\n    32\t    const b = next[key];\n    33\t    if (key === 'data' ? a !== b : !equal(a, b)) (patch ??= {})[key] = b;\n    34\t  }\n    35\t  return patch;\n    36\t}\n    37\t\n    38\t/** Structural equality over plain objects, arrays and dates. Functions and other objects by identity. */\n    39\texport function equal(a: unknown, b: unknown): boolean {\n    40\t  if (Object.is(a, b)) return true;\n    41\t  if (!isObject(a) || !isObject(b)) return false;\n    42\t  if (a instanceof Date) return b instanceof Date && Object.is(a.getTime(), b.getTime());\n    43\t  if (Array.isArray(a)) return Array.isArray(b) && a.length === b.length && a.every((v, i) => equal(v, b[i]));\n    44\t  if (!plain(a) || !plain(b)) return false;\n    45\t  const keys = Object.keys(a);\n    46\t  return keys.length === Object.keys(b).length && keys.every(k => Object.hasOwn(b, k) && equal(a[k], b[k]));\n    47\t}\n    48\t\n    49\t/**\n    50\t * Whether new data is probably the old data rebuilt: same length and shallow-equal first and last rows, or\n    51\t * the same typed columns in a new wrapper. A cheap guess for a development hint, never for behavior.\n    52\t */\n    53\texport function looksSame(a: unknown, b: unknown): boolean {\n    54\t  if (Array.isArray(a) && Array.isArray(b)) {\n    55\t    return a.length === b.length && shallow(a[0], b[0]) && shallow(a[a.length - 1], b[b.length - 1]);\n    56\t  }\n    57\t  return isObject(a) && isObject(b) && isObject(a.columns) && shallow(a.columns, b.columns);\n    58\t}\n    59\t\n    60\tfunction shallow(a: unknown, b: unknown): boolean {\n    61\t  if (Object.is(a, b)) return true;\n    62\t  if (!isObject(a) || !isObject(b)) return false;\n    63\t  const keys = Object.keys(a);\n    64\t  return keys.length === Object.keys(b).length && keys.every(k => Object.hasOwn(b, k) && Object.is(a[k], b[k]));\n    65\t}\n    66\t\n    67\tfunction isObject(value: unknown): value is Options {\n    68\t  return typeof value === 'object' && value !== null;\n    69\t}\n    70\t\n    71\tfunction plain(value: object): boolean {\n    72\t  const proto: unknown = Object.getPrototypeOf(value);\n    73\t  return proto === Object.prototype || proto === null;\n    74\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/react/test/patch.test.ts; nl -ba packages/react/test/server.test.ts; nl -ba packages/react/test/size.test.ts; nl -ba packages/react/test/types.check.tsx'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/react/test/patch.test.ts; nl -ba packages/react/test/server.test.ts; nl -ba packages/react/test/size.test.ts; nl -ba packages/react/test/types.check.tsx'","aggregated_output":"     1\t/**\n     2\t * The props-to-patch rules of plan 1.7, as pure functions: present, changed, removed, structurally equal,\n     3\t * data by identity, and handler-only changes.\n     4\t */\n     5\timport { describe, expect, it } from 'vitest';\n     6\timport fc from 'fast-check';\n     7\timport { diff, equal, looksSame, optionsOf } from '../src/patch';\n     8\t\n     9\tconst forward = () => {};\n    10\tconst rows = [{ day: '2026-01-01', sessions: 1 }, { day: '2026-01-02', sessions: 2 }];\n    11\tconst patchOf = (a: Record<string, unknown>, b: Record<string, unknown>) => diff(optionsOf(a, forward), optionsOf(b, forward));\n    12\t\n    13\tdescribe('optionsOf', () => {\n    14\t  it('drops the component props and keeps every option', () => {\n    15\t    const style = { height: 300 };\n    16\t    const options = optionsOf({ data: rows, x: 'day', y: 'sessions', className: 'card', style, onHover() {}, onSelect() {}, onZoom() {}, strict: true }, forward);\n    17\t    expect(options).toEqual({ data: rows, x: 'day', y: 'sessions', strict: true });\n    18\t  });\n    19\t\n    20\t  it('replaces a given onDiagnostic with the forwarder and leaves an absent one absent', () => {\n    21\t    expect(optionsOf({ data: rows, onDiagnostic: () => 1 }, forward).onDiagnostic).toBe(forward);\n    22\t    expect('onDiagnostic' in optionsOf({ data: rows }, forward)).toBe(false);\n    23\t  });\n    24\t});\n    25\t\n    26\tdescribe('diff', () => {\n    27\t  it('is null when nothing changed', () => {\n    28\t    expect(patchOf({ data: rows, x: 'day', y: 'sessions' }, { data: rows, x: 'day', y: 'sessions' })).toBeNull();\n    29\t  });\n    30\t\n    31\t  it('sends a newly present prop', () => {\n    32\t    expect(patchOf({ data: rows }, { data: rows, title: 'Sessions' })).toEqual({ title: 'Sessions' });\n    33\t  });\n    34\t\n    35\t  it('sends a changed prop and only that prop', () => {\n    36\t    expect(patchOf({ data: rows, title: 'A', legend: 'top' }, { data: rows, title: 'B', legend: 'top' })).toEqual({ title: 'B' });\n    37\t  });\n    38\t\n    39\t  it('sends a removed prop as undefined, with the key present', () => {\n    40\t    const patch = patchOf({ data: rows, title: 'A', tooltip: false }, { data: rows });\n    41\t    expect(patch).toEqual({ title: undefined, tooltip: undefined });\n    42\t    expect(Object.keys(patch!).sort()).toEqual(['title', 'tooltip']);\n    43\t  });\n    44\t\n    45\t  it('treats an explicit undefined like an absent prop', () => {\n    46\t    expect(patchOf({ data: rows, title: undefined }, { data: rows })).toBeNull();\n    47\t    expect(patchOf({ data: rows }, { data: rows, title: undefined })).toBeNull();\n    48\t  });\n    49\t\n    50\t  it('compares field specs and other object options structurally', () => {\n    51\t    const make = () => ({\n    52\t      data: rows,\n    53\t      x: { field: 'day', type: 'date', domain: [new Date(Date.UTC(2026, 0, 1)), new Date(Date.UTC(2026, 0, 9))] },\n    54\t      y: ['sessions', { field: 'visits', label: 'Visits', tickFormat: { notation: 'compact' } }],\n    55\t      title: { text: 'T', level: 3 },\n    56\t      reference: [{ y: 10, label: 'Target' }],\n    57\t      colors: { Direct: 'red' },\n    58\t      messages: { noData: 'Nothing' },\n    59\t      state: { empty: 'None yet' },\n    60\t    });\n    61\t    expect(patchOf(make(), make())).toBeNull();\n    62\t  });\n    63\t\n    64\t  it('sees a change deep inside a field spec and sends the whole new value', () => {\n    65\t    const next = { field: 'visits', label: 'Visitors' };\n    66\t    expect(patchOf({ data: rows, y: { field: 'visits', label: 'Visits' } }, { data: rows, y: next })).toEqual({ y: next });\n    67\t    expect(patchOf({ data: rows, colors: { A: 'red' } }, { data: rows, colors: { A: 'red', B: 'blue' } })).toEqual({ colors: { A: 'red', B: 'blue' } });\n    68\t  });\n    69\t\n    70\t  it('compares data by identity only', () => {\n    71\t    const copy = rows.map(r => ({ ...r }));\n    72\t    expect(patchOf({ data: rows }, { data: copy })).toEqual({ data: copy });\n    73\t    expect(patchOf({ data: rows }, { data: rows })).toBeNull();\n    74\t  });\n    75\t\n    76\t  it('ignores handler-only changes', () => {\n    77\t    const a = { data: rows, onHover() {}, onSelect() {}, onZoom() {}, onDiagnostic() {} };\n    78\t    const b = { data: rows, onHover() {}, onSelect() {}, onZoom() {}, onDiagnostic() {} };\n    79\t    expect(patchOf(a, b)).toBeNull();\n    80\t  });\n    81\t\n    82\t  it('sends onDiagnostic when it appears or disappears', () => {\n    83\t    expect(patchOf({ data: rows }, { data: rows, onDiagnostic() {} })).toEqual({ onDiagnostic: forward });\n    84\t    expect(patchOf({ data: rows, onDiagnostic() {} }, { data: rows })).toEqual({ onDiagnostic: undefined });\n    85\t  });\n    86\t\n    87\t  it('compares a function inside a field spec by identity', () => {\n    88\t    const format = (v: number) => `${v}`;\n    89\t    expect(patchOf({ data: rows, y: { field: 'v', format } }, { data: rows, y: { field: 'v', format } })).toBeNull();\n    90\t    expect(patchOf({ data: rows, y: { field: 'v', format } }, { data: rows, y: { field: 'v', format: (v: number) => `${v}` } })).not.toBeNull();\n    91\t  });\n    92\t\n    93\t  it('for any options, the patch applied to the old options gives the new ones (property)', () => {\n    94\t    const value = fc.oneof(fc.string(), fc.integer(), fc.boolean(), fc.constant(undefined), fc.array(fc.integer(), { maxLength: 3 }), fc.dictionary(fc.string({ maxLength: 3 }), fc.integer(), { maxKeys: 3 }));\n    95\t    const options = fc.dictionary(fc.constantFrom('title', 'x', 'y', 'legend', 'colors', 'reference', 'locale'), value);\n    96\t    fc.assert(fc.property(options, options, (a, b) => {\n    97\t      const patch = diff(a, b) ?? {};\n    98\t      const applied: Record<string, unknown> = { ...a };\n    99\t      for (const [k, v] of Object.entries(patch)) applied[k] = v;\n   100\t      for (const k of new Set([...Object.keys(a), ...Object.keys(b)])) expect(equal(applied[k], b[k])).toBe(true);\n   101\t      expect(diff(b, b)).toBeNull();\n   102\t    }));\n   103\t  });\n   104\t});\n   105\t\n   106\tdescribe('equal', () => {\n   107\t  it('does not treat arrays, dates and plain objects as interchangeable', () => {\n   108\t    expect(equal([1], { 0: 1 })).toBe(false);\n   109\t    expect(equal(new Date(0), {})).toBe(false);\n   110\t    expect(equal(new Date(0), new Date(0))).toBe(true);\n   111\t    expect(equal({ a: undefined }, { b: undefined })).toBe(false);\n   112\t    expect(equal(new Map(), new Map())).toBe(false);\n   113\t  });\n   114\t});\n   115\t\n   116\tdescribe('looksSame', () => {\n   117\t  it('matches rebuilt rows and rewrapped columns, and nothing else', () => {\n   118\t    expect(looksSame(rows, rows.map(r => ({ ...r })))).toBe(true);\n   119\t    expect(looksSame(rows, [...rows, { day: '2026-01-03', sessions: 3 }])).toBe(false);\n   120\t    expect(looksSame(rows, [rows[0], { day: '2026-01-02', sessions: 9 }])).toBe(false);\n   121\t    const t = new Float64Array(3);\n   122\t    expect(looksSame({ columns: { t } }, { columns: { t } })).toBe(true);\n   123\t    expect(looksSame({ columns: { t } }, { columns: { t: new Float64Array(3) } })).toBe(false);\n   124\t  });\n   125\t});\n     1\t/**\n     2\t * Server rendering (plan 1.7, spec DX8): each component renders its empty container in Node, where there is\n     3\t * no DOM, and no chart is created.\n     4\t */\n     5\timport { describe, expect, it, vi } from 'vitest';\n     6\timport { createElement, type ReactElement } from 'react';\n     7\timport { renderToString } from 'react-dom/server';\n     8\t\n     9\tconst created: string[] = [];\n    10\t// Bundled from source: the core's dist is not part of this package's tests. The spy shows that the\n    11\t// server never calls a chart function.\n    12\tvi.mock('axylo', async () => {\n    13\t  const core = await import('../../axylo/src/index');\n    14\t  const wrap = <F extends (...args: never[]) => unknown>(name: string, f: F) => ((...args: Parameters<F>) => { created.push(name); return f(...args); }) as F;\n    15\t  return { ...core, line: wrap('line', core.line), area: wrap('area', core.area), bar: wrap('bar', core.bar), scatter: wrap('scatter', core.scatter), donut: wrap('donut', core.donut) };\n    16\t});\n    17\t\n    18\tconst { Area, Bar, Donut, Line, Scatter } = await import('../src/index');\n    19\t\n    20\ttype Row = (typeof rows)[number];\n    21\tconst rows = [{ day: '2026-01-01', channel: 'Direct', sessions: 10, visits: 4 }, { day: '2026-01-02', channel: 'Direct', sessions: 12, visits: 5 }];\n    22\t\n    23\tdescribe('server rendering', () => {\n    24\t  it('runs without a DOM', () => {\n    25\t    expect(typeof (globalThis as { document?: unknown }).document).toBe('undefined');\n    26\t    expect(typeof (globalThis as { window?: unknown }).window).toBe('undefined');\n    27\t  });\n    28\t\n    29\t  const cases: [string, ReactElement][] = [\n    30\t    ['Line', createElement(Line<Row>, { data: rows, x: 'day', y: 'sessions', series: 'channel', title: 'Sessions' })],\n    31\t    ['Area', createElement(Area<Row>, { data: rows, x: 'day', y: 'sessions', stacked: true })],\n    32\t    ['Bar', createElement(Bar<Row>, { data: rows, x: 'channel', y: 'sessions' })],\n    33\t    ['Scatter', createElement(Scatter<Row>, { data: rows, x: 'visits', y: 'sessions' })],\n    34\t    ['Donut', createElement(Donut<Row>, { data: rows, label: 'channel', value: 'sessions' })],\n    35\t  ];\n    36\t\n    37\t  for (const [name, element] of cases) {\n    38\t    it(`${name} renders the empty container and creates no chart`, () => {\n    39\t      created.length = 0;\n    40\t      expect(renderToString(element)).toBe('<div class=\"axylo\"></div>');\n    41\t      expect(created).toEqual([]);\n    42\t    });\n    43\t  }\n    44\t\n    45\t  it('passes className and style to the container', () => {\n    46\t    const html = renderToString(createElement(Line<Row>, { data: rows, x: 'day', y: 'sessions', className: 'card wide', style: { height: 300 } }));\n    47\t    expect(html).toBe('<div class=\"axylo card wide\" style=\"height:300px\"></div>');\n    48\t  });\n    49\t\n    50\t  it('marks the module as a client module', async () => {\n    51\t    const fs = await import('node:fs');\n    52\t    const source = fs.readFileSync(new URL('../src/index.ts', import.meta.url), 'utf8');\n    53\t    expect(source.startsWith(\"'use client';\")).toBe(true);\n    54\t  });\n    55\t});\n     1\t/**\n     2\t * Size budget (task brief): the adapter, minified and gzipped with react, react-dom and axylo external, is at\n     3\t * most 2 KiB. Measured on the production flavour (__DEV__ false) and, for information, the development one.\n     4\t */\n     5\timport { describe, expect, it } from 'vitest';\n     6\timport { build } from 'esbuild';\n     7\timport { gzipSync } from 'node:zlib';\n     8\timport path from 'node:path';\n     9\t\n    10\tconst entry = path.resolve(import.meta.dirname, '../src/index.ts');\n    11\t\n    12\tasync function gzipped(development: boolean): Promise<{ raw: number; gzip: number }> {\n    13\t  const result = await build({\n    14\t    entryPoints: [entry], bundle: true, minify: true, format: 'esm', target: 'es2022', write: false, logLevel: 'silent',\n    15\t    external: ['react', 'react-dom', 'react/jsx-runtime', 'axylo'], define: { __DEV__: String(development) },\n    16\t  });\n    17\t  const code = result.outputFiles[0]!.contents;\n    18\t  if (/axylo-figure|ResizeObserver/.test(new TextDecoder().decode(code))) throw new Error('the core was bundled into the adapter');\n    19\t  return { raw: code.length, gzip: gzipSync(code, { level: 9 }).length };\n    20\t}\n    21\t\n    22\tdescribe('size', () => {\n    23\t  it('production build is at most 2 KiB gzipped', async () => {\n    24\t    const production = await gzipped(false);\n    25\t    const development = await gzipped(true);\n    26\t    console.info(`@axylo/react: production ${production.raw} B min, ${production.gzip} B gzip; development ${development.raw} B min, ${development.gzip} B gzip`);\n    27\t    expect(production.gzip).toBeLessThanOrEqual(2048);\n    28\t  });\n    29\t});\n     1\t/**\n     2\t * Type tests, checked by `tsc -p packages/react` and never run. Each `@ts-expect-error` line must fail to\n     3\t * compile exactly as the matching core call does (plan 1.3, 1.2, 1.4).\n     4\t */\n     5\timport { useRef } from 'react';\n     6\timport { donut, line } from 'axylo';\n     7\timport type { DonutOptions, LineOptions } from 'axylo';\n     8\timport { Area, Bar, Donut, Line, Scatter, type ChartRef } from '../src/index';\n     9\t\n    10\tinterface Row { day: string; channel: string; sessions: number; visits: number; count: string }\n    11\tdeclare const rows: Row[];\n    12\t\n    13\texport function Valid() {\n    14\t  const ref = useRef<ChartRef<Row, LineOptions<Row>>>(null);\n    15\t  ref.current?.chart?.append([{ day: '2026-01-02', channel: 'Direct', sessions: 1, visits: 2, count: '3' }]);\n    16\t  ref.current?.chart?.zoom(null);\n    17\t  const donut = useRef<ChartRef<Row, DonutOptions<Row>>>(null);\n    18\t  return (\n    19\t    <>\n    20\t      <Line ref={ref} data={rows} x=\"day\" y=\"sessions\" series=\"channel\" title=\"Daily sessions\" className=\"card\" style={{ height: 300 }} />\n    21\t      <Line data={rows} x={{ field: 'day', type: 'date' }} y={['sessions', { field: 'visits', label: 'Visits' }]} onHover={p => p?.row?.sessions} onZoom={d => d?.[0]} />\n    22\t      <Line data={rows} x=\"day\" y={{ field: 'count', parse: 'number' }} onDiagnostic={d => d.code} />\n    23\t      <Line data={rows} x=\"day\" y={['sessions', 'visits']} />\n    24\t      <Area data={rows} x=\"day\" y=\"sessions\" series=\"channel\" stacked />\n    25\t      <Bar data={rows} x=\"channel\" y=\"sessions\" layout=\"stacked\" horizontal />\n    26\t      <Scatter data={rows} x=\"visits\" y=\"sessions\" series=\"channel\" />\n    27\t      <Donut ref={donut} data={rows} label=\"channel\" value=\"sessions\" onSelect={p => p.index} />\n    28\t    </>\n    29\t  );\n    30\t}\n    31\t\n    32\texport function Invalid() {\n    33\t  return (\n    34\t    <>\n    35\t      {/* @ts-expect-error misspelled field */}\n    36\t      <Line data={rows} x=\"day\" y=\"sesions\" />\n    37\t      {/* @ts-expect-error a text field on a value axis without parse: 'number' */}\n    38\t      <Line data={rows} x=\"day\" y=\"channel\" />\n    39\t      {/* @ts-expect-error series cannot be combined with wide y */}\n    40\t      <Line data={rows} x=\"day\" y={['sessions', 'visits']} series=\"channel\" />\n    41\t      {/* @ts-expect-error zoom does not apply to a donut */}\n    42\t      <Donut data={rows} label=\"channel\" value=\"sessions\" zoom />\n    43\t      {/* @ts-expect-error onZoom does not apply to a donut either */}\n    44\t      <Donut data={rows} label=\"channel\" value=\"sessions\" onZoom={() => {}} />\n    45\t      {/* @ts-expect-error the same misspelling on the other chart types */}\n    46\t      <Bar data={rows} x=\"day\" y=\"sesions\" />\n    47\t      {/* @ts-expect-error a category x on a scatter chart */}\n    48\t      <Scatter data={rows} x={{ field: 'channel', type: 'category' }} y=\"sessions\" />\n    49\t    </>\n    50\t  );\n    51\t}\n    52\t\n    53\t/** The same mistakes in core calls, so the components are seen to fail exactly where the core does. */\n    54\texport function core(el: HTMLElement) {\n    55\t  // @ts-expect-error misspelled field\n    56\t  line(el, { data: rows, x: 'day', y: 'sesions' });\n    57\t  // @ts-expect-error a text field on a value axis without parse: 'number'\n    58\t  line(el, { data: rows, x: 'day', y: 'channel' });\n    59\t  // @ts-expect-error series cannot be combined with wide y\n    60\t  line(el, { data: rows, x: 'day', y: ['sessions', 'visits'], series: 'channel' });\n    61\t  // @ts-expect-error zoom does not apply to a donut\n    62\t  donut(el, { data: rows, label: 'channel', value: 'sessions', zoom: true });\n    63\t}\n","exit_code":0,"status":"completed"}}
