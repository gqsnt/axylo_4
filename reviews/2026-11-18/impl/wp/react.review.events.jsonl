{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/react/test/browser/react.browser.test.ts'","aggregated_output":"     1\t/**\n     2\t * @axylo/react in system Chrome (plan 1.7, spec DX8): lifecycle, StrictMode, props to patches, removed props,\n     3\t * handlers, the ref, error boundaries, independence and hydration. The app (app.tsx) is driven through\n     4\t * `window.app`; the core is wrapped (spy-axylo.ts) so creates, updates and destroys can be counted.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it, vi } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { renderToString } from 'react-dom/server';\n     9\timport { start, stop } from '../../../axylo/test/browser/harness';\n    10\timport { closeApp, openApp } from './open';\n    11\timport type { Spec } from './app';\n    12\t\n    13\t// The hydration test renders the tree in Node too, from source.\n    14\tvi.mock('axylo', () => import('../../../axylo/src/index'));\n    15\tconst { hydrationTree } = await import('./tree');\n    16\t\n    17\tbeforeAll(start);\n    18\tafterAll(stop);\n    19\t\n    20\ttype App = {\n    21\t  render(specs: Spec[], options?: { strict?: boolean }): Promise<void>;\n    22\t  ready(): Promise<void>;\n    23\t  setData(name: string, rows: unknown[]): void;\n    24\t  chart(i: number): { append(rows: unknown[]): void; diagnostics: unknown[]; __bench: { describe(): { series: { points: number; newestX: number }[] } } } | null;\n    25\t  spy: { attempts: number; charts: { kind: string; element: HTMLElement; updates: Record<string, unknown>[]; destroyed: boolean }[] };\n    26\t  probe: { resizeCallbacks: number; observers: number; pendingFrames: number; mark(): number; leakedSince(mark: number): string[] };\n    27\t  events: [string, number | null][];\n    28\t  hydrationErrors: string[];\n    29\t  nextFrames(n: number): Promise<void>;\n    30\t  hydrate(): Promise<void>;\n    31\t};\n    32\tdeclare const window: Window & { app: App; saved?: Element | null };\n    33\t\n    34\tconst day = (i: number) => `2026-01-${String(i + 1).padStart(2, '0')}`;\n    35\tconst trend = Array.from({ length: 10 }, (_, i) => [\n    36\t  { day: day(i), channel: 'Direct', sessions: 30 + (i % 4) * 3, visits: 10 + i },\n    37\t  { day: day(i), channel: 'Organic', sessions: 20 + (i % 3) * 2, visits: 5 + i },\n    38\t]).flat();\n    39\tconst single = Array.from({ length: 10 }, (_, i) => ({ day: day(i), sessions: 10 + i }));\n    40\tconst slices = [{ channel: 'Direct', sessions: 30 }, { channel: 'Organic', sessions: 20 }, { channel: 'Referral', sessions: 10 }];\n    41\t// AX106: a number field holding one string. A warning, so a strict chart throws.\n    42\tconst bad = single.map((r, i) => i === 4 ? { ...r, sessions: '14' } : r);\n    43\t\n    44\tasync function open(): Promise<Page> {\n    45\t  const page = await openApp();\n    46\t  await page.evaluate(([t, s, d, b]) => {\n    47\t    window.app.setData('trend', t);\n    48\t    window.app.setData('single', s);\n    49\t    window.app.setData('slices', d);\n    50\t    window.app.setData('bad', b);\n    51\t  }, [trend, single, slices, bad] as const);\n    52\t  return page;\n    53\t}\n    54\t\n    55\tconst render = (page: Page, specs: Spec[], options: { strict?: boolean } = {}) =>\n    56\t  page.evaluate(async ([s, o]) => { await window.app.render(s, o); await window.app.ready(); }, [specs, options] as const);\n    57\t\n    58\tconst named = (page: Page, name: string) => page.getByRole('group', { name, exact: true }).count();\n    59\t\n    60\tconst spyState = (page: Page) => page.evaluate(() => ({\n    61\t  attempts: window.app.spy.attempts,\n    62\t  charts: window.app.spy.charts.map(c => ({ kind: c.kind, destroyed: c.destroyed, updates: c.updates.map(p => Object.keys(p)) })),\n    63\t}));\n    64\t\n    65\tasync function hoverAt(page: Page, fraction: number): Promise<void> {\n    66\t  const box = await page.evaluate(() => {\n    67\t    const r = document.querySelector('#chart .axylo-plot')!.getBoundingClientRect();\n    68\t    return { x: r.left, y: r.top, width: r.width, height: r.height };\n    69\t  });\n    70\t  await page.mouse.move(box.x + box.width * fraction, box.y + box.height / 2, { steps: 4 });\n    71\t  await page.evaluate(() => window.app.nextFrames(3));\n    72\t}\n    73\t\n    74\tconst cases: [Spec['type'], string, Record<string, unknown>][] = [\n    75\t  ['Line', 'trend', { x: 'day', y: 'sessions', series: 'channel' }],\n    76\t  ['Area', 'trend', { x: 'day', y: 'sessions', series: 'channel', stacked: true }],\n    77\t  ['Bar', 'trend', { x: 'day', y: 'sessions', series: 'channel' }],\n    78\t  ['Scatter', 'trend', { x: 'visits', y: 'sessions', series: 'channel' }],\n    79\t  ['Donut', 'slices', { label: 'channel', value: 'sessions' }],\n    80\t];\n    81\t\n    82\tdescribe('lifecycle', () => {\n    83\t  for (const [type, data, props] of cases) {\n    84\t    it(`${type}: mount, update, unmount`, async () => {\n    85\t      const page = await open();\n    86\t      await render(page, [{ type, data, props: { ...props, title: `${type} one` } }]);\n    87\t      expect(await page.locator('#chart > div.axylo > figure.axylo-figure').count()).toBe(1);\n    88\t      expect(await named(page, `${type} one`)).toBe(1);\n    89\t\n    90\t      await render(page, [{ type, data, props: { ...props, title: `${type} two` } }]);\n    91\t      expect(await spyState(page)).toEqual({ attempts: 1, charts: [{ kind: type.toLowerCase(), destroyed: false, updates: [['title']] }] });\n    92\t      expect(await named(page, `${type} two`)).toBe(1);\n    93\t      expect(await named(page, `${type} one`)).toBe(0);\n    94\t\n    95\t      await render(page, []);\n    96\t      expect(await page.evaluate(() => document.getElementById('chart')!.innerHTML)).toBe('');\n    97\t      expect((await spyState(page)).charts[0]!.destroyed).toBe(true);\n    98\t      expect(await page.evaluate(() => window.app.chart(0))).toBeNull();\n    99\t      expect(await closeApp(page)).toEqual([]);\n   100\t    });\n   101\t  }\n   102\t});\n   103\t\n   104\tdescribe('StrictMode', () => {\n   105\t  it('setup, cleanup, setup leaves one chart; unmount leaves nothing behind', async () => {\n   106\t    const page = await open();\n   107\t    await render(page, [], { strict: true });\n   108\t    const before = await page.evaluate(() => ({ mark: window.app.probe.mark(), observers: window.app.probe.observers }));\n   109\t\n   110\t    await render(page, [{ type: 'Line', data: 'trend', props: { x: 'day', y: 'sessions', series: 'channel', title: 'Strict' } }], { strict: true });\n   111\t    expect(await page.locator('#chart figure').count()).toBe(1);\n   112\t    expect(await named(page, 'Strict')).toBe(1);\n   113\t    const state = await spyState(page);\n   114\t    // StrictMode ran the create effect twice and its cleanup once.\n   115\t    expect(state.attempts).toBe(2);\n   116\t    expect(state.charts.map(c => c.destroyed)).toEqual([true, false]);\n   117\t    expect(await page.evaluate(() => window.app.probe.observers)).toBeGreaterThan(before.observers);\n   118\t\n   119\t    await render(page, [], { strict: true });\n   120\t    expect(await page.evaluate(() => document.getElementById('chart')!.innerHTML)).toBe('');\n   121\t    await page.evaluate(() => window.app.nextFrames(2));\n   122\t    const callbacks = await page.evaluate(() => window.app.probe.resizeCallbacks);\n   123\t    await page.evaluate(() => { document.getElementById('chart')!.style.width = '360px'; });\n   124\t    await page.setViewportSize({ width: 500, height: 600 });\n   125\t    await page.evaluate(() => window.app.nextFrames(4));\n   126\t    const after = await page.evaluate(m => ({\n   127\t      callbacks: window.app.probe.resizeCallbacks, observers: window.app.probe.observers,\n   128\t      leaked: window.app.probe.leakedSince(m), frames: window.app.probe.pendingFrames,\n   129\t    }), before.mark);\n   130\t    expect(after).toEqual({ callbacks, observers: before.observers, leaked: [], frames: 0 });\n   131\t    expect(await closeApp(page)).toEqual([]);\n   132\t  });\n   133\t});\n   134\t\n   135\tdescribe('props to options', () => {\n   136\t  it('an inline field object re-rendered ten times causes zero update calls', async () => {\n   137\t    const page = await open();\n   138\t    const spec = (label: string): Spec => ({\n   139\t      type: 'Line', data: 'trend', props: {\n   140\t        x: { field: 'day', type: 'date' }, y: { field: 'sessions', label, tickFormat: { notation: 'compact' } }, series: 'channel',\n   141\t        title: { text: 'Inline', level: 3 }, colors: { Direct: '#1f6feb' }, reference: [{ y: 30, label: 'Target' }],\n   142\t        messages: { noData: 'Nothing' }, style: { height: 300 },\n   143\t      },\n   144\t    });\n   145\t    await render(page, [spec('Sessions')]);\n   146\t    // Each evaluate deserializes the spec anew, so every render passes new objects.\n   147\t    for (let i = 0; i < 10; i++) await render(page, [spec('Sessions')]);\n   148\t    expect(await spyState(page)).toEqual({ attempts: 1, charts: [{ kind: 'line', destroyed: false, updates: [] }] });\n   149\t    // The spy does see a real change.\n   150\t    await render(page, [spec('Visits')]);\n   151\t    expect((await spyState(page)).charts[0]!.updates).toEqual([['y']]);\n   152\t    expect(await closeApp(page)).toEqual([]);\n   153\t  });\n   154\t\n   155\t  it('a removed title restores the generated name', async () => {\n   156\t    const page = await open();\n   157\t    const props = { x: 'day', y: 'sessions', series: 'channel' };\n   158\t    // The second chart never had a title: its name is the generated one.\n   159\t    await render(page, [{ type: 'Line', data: 'trend', props: { ...props, title: 'Sessions' } }, { type: 'Line', data: 'trend', props }]);\n   160\t    expect(await named(page, 'Sessions')).toBe(1);\n   161\t    const generated = await page.evaluate(() => document.querySelectorAll('#chart figure')[1]!.getAttribute('aria-label'));\n   162\t    expect(generated).toBeTruthy();\n   163\t\n   164\t    await render(page, [{ type: 'Line', data: 'trend', props }, { type: 'Line', data: 'trend', props }]);\n   165\t    const sent = await page.evaluate(() => window.app.spy.charts[0]!.updates.map(p => [Object.keys(p), 'title' in p && p.title === undefined]));\n   166\t    expect(sent).toEqual([[['title'], true]]);\n   167\t    expect(await named(page, 'Sessions')).toBe(0);\n   168\t    expect(await named(page, generated!)).toBe(2);\n   169\t    expect(await page.evaluate(() => document.querySelector('#chart figure')!.hasAttribute('aria-labelledby'))).toBe(false);\n   170\t    expect(await closeApp(page)).toEqual([]);\n   171\t  });\n   172\t\n   173\t  it('a removed tooltip={false} restores the tooltip', async () => {\n   174\t    const page = await open();\n   175\t    const props = { x: 'day', y: 'sessions', series: 'channel', title: 'Tips' };\n   176\t    const shown = () => page.evaluate(() => [...document.querySelectorAll<HTMLElement>('#chart .axylo-tooltip, #chart .axylo-readout')].some(e => !e.hidden));\n   177\t    await render(page, [{ type: 'Line', data: 'trend', hover: 'h', props: { ...props, tooltip: false } }]);\n   178\t    await hoverAt(page, 0.3);\n   179\t    expect((await page.evaluate(() => window.app.events.length))).toBeGreaterThan(0);\n   180\t    expect(await shown()).toBe(false);\n   181\t\n   182\t    await render(page, [{ type: 'Line', data: 'trend', hover: 'h', props }]);\n   183\t    expect((await spyState(page)).charts[0]!.updates).toEqual([['tooltip']]);\n   184\t    await hoverAt(page, 0.7);\n   185\t    expect(await shown()).toBe(true);\n   186\t    expect(await closeApp(page)).toEqual([]);\n   187\t  });\n   188\t\n   189\t  it('data with a new identity and the same content three renders in a row warns once', async () => {\n   190\t    const page = await open();\n   191\t    const warnings: string[] = [];\n   192\t    page.on('console', m => { if (m.type() === 'warning' && m.text().includes('[axylo/react]')) warnings.push(m.text()); });\n   193\t    const spec: Spec = { type: 'Line', data: 'copy', props: { x: 'day', y: 'sessions', title: 'Copies' } };\n   194\t    const again = async () => {\n   195\t      await page.evaluate(rows => window.app.setData('copy', rows), single);\n   196\t      await render(page, [spec]);\n   197\t    };\n   198\t    await again();\n   199\t    await again();\n   200\t    await again();\n   201\t    expect(warnings).toEqual([]);\n   202\t    await again();\n   203\t    await again();\n   204\t    await again();\n   205\t    expect(warnings).toHaveLength(1);\n   206\t    expect(warnings[0]).toContain('Memoize');\n   207\t    // Identity is all that counts for the update itself.\n   208\t    expect((await spyState(page)).charts[0]!.updates).toEqual(Array.from({ length: 5 }, () => ['data']));\n   209\t    expect(await closeApp(page)).toEqual([]);\n   210\t  });\n   211\t});\n   212\t\n   213\tdescribe('handlers', () => {\n   214\t  it('the latest onHover is called and the chart is not recreated', async () => {\n   215\t    const page = await open();\n   216\t    const props = { x: 'day', y: 'sessions', series: 'channel', title: 'Handlers' };\n   217\t    await render(page, [{ type: 'Line', data: 'trend', hover: 'first', props }]);\n   218\t    await page.evaluate(() => { window.saved = document.querySelector('#chart figure'); });\n   219\t    await hoverAt(page, 0.2);\n   220\t    const firstCount = await page.evaluate(() => window.app.events.length);\n   221\t    expect(firstCount).toBeGreaterThan(0);\n   222\t    expect(await page.evaluate(() => window.app.events.every(e => e[0] === 'first'))).toBe(true);\n   223\t\n   224\t    await render(page, [{ type: 'Line', data: 'trend', hover: 'second', props }]);\n   225\t    await hoverAt(page, 0.8);\n   226\t    const later = await page.evaluate(n => window.app.events.slice(n).map(e => e[0]), firstCount);\n   227\t    expect(later.length).toBeGreaterThan(0);\n   228\t    expect(new Set(later)).toEqual(new Set(['second']));\n   229\t    expect(await spyState(page)).toEqual({ attempts: 1, charts: [{ kind: 'line', destroyed: false, updates: [] }] });\n   230\t    expect(await page.evaluate(() => document.querySelector('#chart figure') === window.saved)).toBe(true);\n   231\t    expect(await closeApp(page)).toEqual([]);\n   232\t  });\n   233\t});\n   234\t\n   235\tdescribe('ref', () => {\n   236\t  it('ref.current.chart.append adds a point; a new data prop replaces the stream', async () => {\n   237\t    const page = await open();\n   238\t    const props = { x: 'day', y: 'sessions', title: 'Stream' };\n   239\t    await render(page, [{ type: 'Line', data: 'single', props }]);\n   240\t    const first = await page.evaluate(() => ({ s: window.app.chart(0)!.__bench.describe().series[0]!, diagnostics: Array.isArray(window.app.chart(0)!.diagnostics) }));\n   241\t    expect(first.s.points).toBe(10);\n   242\t    expect(first.diagnostics).toBe(true);\n   243\t\n   244\t    await page.evaluate(async () => { window.app.chart(0)!.append([{ day: '2026-01-11', sessions: 21 }]); await window.app.ready(); });\n   245\t    const appended = await page.evaluate(() => window.app.chart(0)!.__bench.describe().series[0]!);\n   246\t    expect(appended.points).toBe(11);\n   247\t    expect(appended.newestX).toBeGreaterThan(first.s.newestX);\n   248\t\n   249\t    await page.evaluate(rows => window.app.setData('single again', rows), single);\n   250\t    await render(page, [{ type: 'Line', data: 'single again', props }]);\n   251\t    expect((await spyState(page)).charts[0]!.updates).toEqual([['data']]);\n   252\t    const replaced = await page.evaluate(() => window.app.chart(0)!.__bench.describe().series[0]!);\n   253\t    expect(replaced).toEqual(first.s);\n   254\t    expect(await closeApp(page)).toEqual([]);\n   255\t  });\n   256\t});\n   257\t\n   258\tdescribe('errors', () => {\n   259\t  it('a strict chart with bad data is caught by an error boundary and recovers when given good data', async () => {\n   260\t    const page = await open();\n   261\t    const props = { x: 'day', y: 'sessions', title: 'Strict data', strict: true };\n   262\t    const caught = () => page.evaluate(() => document.querySelector('#chart .caught')?.textContent ?? null);\n   263\t\n   264\t    // Rejected at creation.\n   265\t    await render(page, [{ type: 'Line', data: 'bad', props }]);\n   266\t    expect(await caught()).toContain('AX106');\n   267\t    expect(await page.locator('#chart figure').count()).toBe(0);\n   268\t    expect(await spyState(page)).toEqual({ attempts: 1, charts: [] });\n   269\t\n   270\t    await render(page, [{ type: 'Line', data: 'single', props }]);\n   271\t    expect(await caught()).toBeNull();\n   272\t    expect(await named(page, 'Strict data')).toBe(1);\n   273\t\n   274\t    // Rejected by an update: the boundary takes over and the rejected chart is destroyed.\n   275\t    await render(page, [{ type: 'Line', data: 'bad', props }]);\n   276\t    expect(await caught()).toContain('AX106');\n   277\t    expect(await page.locator('#chart figure').count()).toBe(0);\n   278\t\n   279\t    await render(page, [{ type: 'Line', data: 'single', props }]);\n   280\t    expect(await caught()).toBeNull();\n   281\t    expect(await named(page, 'Strict data')).toBe(1);\n   282\t    expect(await spyState(page)).toEqual({\n   283\t      attempts: 3,\n   284\t      charts: [{ kind: 'line', destroyed: true, updates: [['data']] }, { kind: 'line', destroyed: false, updates: [] }],\n   285\t    });\n   286\t    expect(await closeApp(page)).toEqual([]);\n   287\t  });\n   288\t});\n   289\t\n   290\tdescribe('independence', () => {\n   291\t  it('two charts in one tree are independent', async () => {\n   292\t    const page = await open();\n   293\t    const a = { x: 'day', y: 'sessions', series: 'channel' };\n   294\t    const b = { x: 'day', y: 'sessions', series: 'channel', layout: 'stacked' };\n   295\t    await render(page, [{ type: 'Line', data: 'trend', props: { ...a, title: 'A' } }, { type: 'Bar', data: 'trend', props: { ...b, title: 'B' } }]);\n   296\t    expect(await page.evaluate(() => window.app.spy.charts[0]!.element !== window.app.spy.charts[1]!.element)).toBe(true);\n   297\t\n   298\t    await render(page, [{ type: 'Line', data: 'trend', props: { ...a, title: 'A2' } }, { type: 'Bar', data: 'trend', props: { ...b, title: 'B' } }]);\n   299\t    expect((await spyState(page)).charts.map(c => c.updates)).toEqual([[['title']], []]);\n   300\t    expect([await named(page, 'A2'), await named(page, 'B')]).toEqual([1, 1]);\n   301\t\n   302\t    await render(page, [{ type: 'Line', data: 'trend', props: { ...a, title: 'A2' } }]);\n   303\t    expect((await spyState(page)).charts.map(c => c.destroyed)).toEqual([false, true]);\n   304\t    expect(await page.locator('#chart figure').count()).toBe(1);\n   305\t    expect(await named(page, 'A2')).toBe(1);\n   306\t    await render(page, [{ type: 'Line', data: 'trend', props: { ...a, title: 'A3' } }]);\n   307\t    expect(await named(page, 'A3')).toBe(1);\n   308\t    expect(await closeApp(page)).toEqual([]);\n   309\t  });\n   310\t});\n   311\t\n   312\tdescribe('hydration', () => {\n   313\t  async function hydrate(markup: string): Promise<{ errors: string[]; recoverable: string[]; figures: number; page: Page }> {\n   314\t    const page = await openApp();\n   315\t    const errors: string[] = [];\n   316\t    page.on('console', m => { if (m.type() === 'error') errors.push(m.text()); });\n   317\t    await page.evaluate(m => { document.getElementById('chart')!.innerHTML = m; }, markup);\n   318\t    await page.evaluate(() => window.app.hydrate());\n   319\t    await page.waitForFunction(() => document.querySelectorAll('#chart figure').length === 2);\n   320\t    return { errors, recoverable: await page.evaluate(() => window.app.hydrationErrors), figures: 2, page };\n   321\t  }\n   322\t\n   323\t  it('server-rendered markup hydrates without a mismatch warning', async () => {\n   324\t    const markup = renderToString(hydrationTree());\n   325\t    expect(markup).toContain('<div class=\"axylo card\" style=\"height:260px\"></div>');\n   326\t    const { errors, recoverable, page } = await hydrate(markup);\n   327\t    expect(errors).toEqual([]);\n   328\t    expect(recoverable).toEqual([]);\n   329\t    expect(await named(page, 'Hydrated line')).toBe(1);\n   330\t    expect(await named(page, 'Hydrated donut')).toBe(1);\n   331\t    expect(await closeApp(page)).toEqual([]);\n   332\t  });\n   333\t\n   334\t  it('control: altered markup is reported, so the check above can fail', async () => {\n   335\t    const markup = renderToString(hydrationTree()).replace('class=\"axylo card\"', 'class=\"axylo other\"');\n   336\t    const { errors, recoverable, page } = await hydrate(markup);\n   337\t    expect([...errors, ...recoverable].join('\\n')).toMatch(/hydrat/i);\n   338\t    await closeApp(page);\n   339\t  });\n   340\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/react/package.json; nl -ba packages/react/tsconfig.json; cat tsconfig.base.json; cat AGENTS.md; cat packages/axylo/package.json; cat vitest.config.ts; cat docs/api/tsconfig.json'","aggregated_output":"     1\t{\n     2\t  \"name\": \"@axylo/react\",\n     3\t  \"version\": \"0.0.0\",\n     4\t  \"description\": \"React components for Axylo charts.\",\n     5\t  \"license\": \"MIT\",\n     6\t  \"type\": \"module\",\n     7\t  \"sideEffects\": false,\n     8\t  \"files\": [\"dist\"],\n     9\t  \"exports\": { \".\": { \"types\": \"./dist/index.d.ts\", \"default\": \"./dist/index.js\" } },\n    10\t  \"peerDependencies\": { \"axylo\": \"0.0.0\", \"react\": \"^18.0.0 || ^19.0.0\" }\n    11\t}\n     1\t{ \"extends\": \"../../tsconfig.base.json\", \"compilerOptions\": { \"rootDir\": \"../..\", \"noEmit\": true, \"jsx\": \"react-jsx\", \"paths\": { \"axylo\": [\"../axylo/src/index.ts\"] } }, \"include\": [\"src\", \"test\", \"../axylo/src/core/globals.d.ts\"] }\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"strict\": true,\n    \"noUncheckedIndexedAccess\": true,\n    \"exactOptionalPropertyTypes\": false,\n    \"noImplicitOverride\": true,\n    \"noFallthroughCasesInSwitch\": true,\n    \"isolatedModules\": true,\n    \"verbatimModuleSyntax\": true,\n    \"skipLibCheck\": true,\n    \"declaration\": true,\n    \"types\": [\n      \"node\"\n    ]\n  }\n}\n# Working in this repository\n\nAxylo is a browser charting library. The product is specified in `docs/02-product-spec.md`; the build plan is `docs/03-plan-typescript-release.md`. Read the sections your task names before writing code.\n\n## Rules for every change\n\n- **Contracts are fixed.** `packages/axylo/src/core/contracts.ts` and `packages/axylo/src/public.ts` are the interfaces between modules. Do not edit them. If your work needs a change there, stop that part, finish what you can, and describe the exact change you need in your report.\n- **Stay in your files.** Each task lists the directories it owns. Do not create, edit or delete anything else, including configuration and other modules. Several agents work in this checkout at the same time.\n- **No runtime dependencies.** Use the platform (`Intl`, typed arrays). Dev dependencies already installed: TypeScript, Vitest, fast-check, esbuild, Playwright (system Chrome), axe-core. The network is not available; do not try to install anything.\n- **No DOM at import time.** A module that needs the DOM takes it as a parameter or touches it inside a function. Pure stages (data, scales, formatting, layout, scene) must run in Node.\n- **Hot paths use typed arrays.** No object per data point, no array of arrays per data point, no copying of large columns that the contracts say are borrowed.\n- **Never guess silently.** Anything that cannot be drawn as given is reported through the `DiagnosticSink` with the code from spec section 3.5.\n- **Tests come from the spec.** Expected values are derived from the specification and the fixture data, never by running the implementation and pasting its output. Use fast-check property tests for invariants (\"for any data …\"). A test you cannot make pass is reported as failing; do not weaken it or change its expected value.\n- **TypeScript strict, no `any`** in exported signatures. `__DEV__` is a build-time boolean (true in tests).\n- **Comments say why**, not what. Names are plain words.\n- **Do not commit.** The coordinator commits.\n\n## Commands\n\n```bash\nnpm run typecheck      # tsc over the library, its tests, and the API examples in docs/api\nnpm test               # unit and property tests (Node)\nnpm run build          # packages/axylo/dist\nnpm run test:browser   # browser tests against the built bundle, in system Chrome\n```\n\n## Your report\n\nEnd with a short report: what you built (files), what you verified and how (paste the last lines of the test run), what is not done or not verified, any contract change you need, and any place where the spec was ambiguous and what you assumed. Keep \"ran and saw\" apart from \"expect\".\n{\n  \"name\": \"axylo\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Everyday charts that are faithful to the data, readable everywhere and accessible by default.\",\n  \"license\": \"MIT\",\n  \"type\": \"module\",\n  \"sideEffects\": false,\n  \"files\": [\"dist\"],\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"development\": \"./dist/axylo.dev.js\",\n      \"default\": \"./dist/axylo.js\"\n    },\n    \"./axylo.css\": \"./dist/axylo.css\"\n  }\n}\nimport { defineConfig } from 'vitest/config';\n\n// Unit and property tests run in Node. Browser tests (*.browser.test.ts) drive system Chrome through\n// Playwright against the built bundle: run `npm run build` first, then `npm run test:browser`.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    include: process.env.AXYLO_BROWSER ? ['packages/*/test/**/*.browser.test.ts'] : ['packages/*/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 10000,\n    fileParallelism: !process.env.AXYLO_BROWSER,\n  },\n});\n{ \"compilerOptions\": { \"strict\": true, \"noEmit\": true, \"target\": \"ES2022\", \"module\": \"ESNext\", \"moduleResolution\": \"Bundler\", \"lib\": [\"ES2022\", \"DOM\"], \"skipLibCheck\": false }, \"include\": [\"examples.ts\", \"axylo.d.ts\"] }\n","exit_code":0,"status":"completed"}}
