{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/layout/{index,labels}.ts'","aggregated_output":"import type {\n  BandScale, ContinuousScale, DiagnosticSink, Layout, PlacedText, Projection, Rect,\n  TextMeasurer, TextStyle, TickCandidates, XScale,\n} from '../core/contracts';\nimport { fitBottom, fitLeftCategories, fitValue, placeText, wrapText } from './labels';\nimport type { FittedLabels, Metrics } from './labels';\n\ntype Span = readonly [number, number];\n\ninterface Axis {\n  readonly candidates: TickCandidates;\n  readonly title?: string;\n  readonly mayThin: boolean;\n}\n\nexport interface ValueAxis extends Axis {\n  readonly domain: Span;\n}\n\nexport interface ContinuousAxis extends ValueAxis {\n  readonly type: 'linear' | 'time';\n}\n\nexport interface BandAxis extends Axis {\n  readonly type: 'band';\n  readonly count: number;\n  readonly padding: number;\n}\n\nexport interface ScaleConstructors {\n  linear(domain: Span, range: Span): ContinuousScale;\n  time(domain: Span, range: Span): ContinuousScale;\n  band(count: number, range: Span, padding: number): BandScale;\n}\n\ninterface Size {\n  readonly width: number;\n  readonly height: number;\n}\n\ninterface Axes {\n  /** Logical category or independent axis, including for horizontal bars. */\n  readonly x: ContinuousAxis | BandAxis;\n  readonly y: ValueAxis;\n  readonly scales: ScaleConstructors;\n}\n\ntype Cartesian = Axes & (\n  | { readonly kind: 'xy' }\n  | { readonly kind: 'bands'; readonly horizontal: boolean }\n);\n\ninterface TextInput {\n  readonly measurer: TextMeasurer;\n  readonly style: TextStyle;\n}\n\ntype PlotInput = Size & { readonly diagnostics: DiagnosticSink; readonly compact?: boolean };\n\nexport type LayoutInput =\n  | (PlotInput & Cartesian & TextInput)\n  | (PlotInput & { readonly kind: 'ring' })\n  | (Size & TextInput & { readonly kind: 'message'; readonly message: string });\n\nconst INSET = 4;\nconst GAP = 4;\nconst MIN_WIDTH = 120;\nconst MIN_HEIGHT = 80;\nconst UNCHANGED = { remedies: [], hidden: 0 } as const;\n\nfunction independentScale(axis: Axes['x'], range: Span, scales: ScaleConstructors): XScale {\n  return axis.type === 'band' ? scales.band(axis.count, range, axis.padding) : scales[axis.type](axis.domain, range);\n}\n\nfunction project(plot: Rect, axes: Cartesian): Exclude<Projection, { kind: 'ring' }> {\n  const across: Span = [plot.x, plot.x + plot.width];\n  const up: Span = [plot.y + plot.height, plot.y];\n  const horizontal = axes.kind === 'bands' && axes.horizontal;\n  const x = independentScale(axes.x, horizontal ? up : across, axes.scales);\n  const y = axes.scales.linear(axes.y.domain, horizontal ? across : up);\n  return axes.kind === 'xy' ? { kind: 'xy', x, y } : { kind: 'bands', horizontal, band: x, value: y };\n}\n\nfunction ring(plot: Rect): Projection {\n  const r1 = Math.min(plot.width, plot.height) / 2;\n  return { kind: 'ring', cx: plot.x + plot.width / 2, cy: plot.y + plot.height / 2, r0: r1 * 0.6, r1 };\n}\n\nfunction tooSmall(size: Size, diagnostics: DiagnosticSink): Layout {\n  diagnostics.add({\n    code: 'AX142', level: 'hint', message: 'The plot needs at least 120 × 80 CSS pixels.',\n    effect: 'none', origin: 'presentation',\n  });\n  return { ...size, kind: 'too-small' };\n}\n\nfunction metrics(input: TextInput): Metrics {\n  return { lineHeight: input.style.lineHeight, width: text => input.measurer.width(text, input.style) };\n}\n\nfunction moveText(text: PlacedText, dx: number, dy: number): PlacedText {\n  return { ...text, x: text.x + dx, y: text.y + dy, box: { ...text.box, x: text.box.x + dx, y: text.box.y + dy } };\n}\n\nfunction lane(fit: FittedLabels): number {\n  return fit.texts.length ? GAP + fit.depth : 0;\n}\n\nfunction layoutAxes(input: PlotInput & Cartesian & TextInput, size: Size): Layout {\n  const { width, height } = size;\n  const text = metrics(input);\n  const horizontal = input.kind === 'bands' && input.horizontal;\n  const leftAxis = horizontal ? input.x : input.y;\n  const bottomAxis = horizontal ? input.y : input.x;\n  const leftRole = horizontal ? 'tick-x' : 'tick-y';\n  const bottomRole = horizontal ? 'tick-y' : 'tick-x';\n  const clearance = leftAxis.candidates.some(set => set.length > 0) ? text.lineHeight / 2 : 0;\n  const top = INSET + clearance;\n  let left = INSET;\n  let bottom = INSET + clearance;\n  const visited = new Set<string>();\n  let growMargins = false;\n\n  for (;;) {\n    const plot = { x: left, y: top, width: width - left - INSET, height: height - top - bottom };\n    if (plot.width < MIN_WIDTH || plot.height < MIN_HEIGHT) return tooSmall(size, input.diagnostics);\n\n    const projection = project(plot, input);\n    const xScale = projection.kind === 'xy' ? projection.x : projection.band;\n    const yScale = projection.kind === 'xy' ? projection.y : projection.value;\n    const leftTitle = leftAxis.title ? wrapText(leftAxis.title, plot.height, text) : [];\n    const bottomTitle = bottomAxis.title ? wrapText(bottomAxis.title, plot.width, text) : [];\n    if (leftTitle.some(line => text.width(line) > plot.height) ||\n        bottomTitle.some(line => text.width(line) > plot.width)) return tooSmall(size, input.diagnostics);\n    const leftTitleSize = leftTitle.length ? GAP + leftTitle.length * text.lineHeight : 0;\n    const bottomTitleSize = bottomTitle.length ? GAP + bottomTitle.length * text.lineHeight : 0;\n    const bottomRoom = height - top - MIN_HEIGHT - INSET - clearance - bottomTitleSize - GAP;\n\n    const leftFit = horizontal\n      ? fitLeftCategories(leftAxis.candidates[0] ?? [], xScale, width, height, leftRole, text)\n      : fitValue(leftAxis.candidates, yScale, 'left', height, Infinity, leftRole, text);\n    const bottomFit = horizontal\n      ? fitValue(bottomAxis.candidates, yScale, 'bottom', width, bottomRoom, bottomRole, text)\n      : fitBottom(bottomAxis.candidates, bottomAxis.mayThin, xScale, width, bottomRoom, bottomRole, text);\n\n    const nextLeft = INSET + lane(leftFit) + leftTitleSize;\n    const nextBottom = INSET + clearance + lane(bottomFit) + bottomTitleSize;\n    const key = left + '/' + bottom;\n    // A sparser tick set can free space for a denser set on the next pass. If that\n    // cycles, keep enough margin for either fit and use the labels at the final ranges.\n    if (visited.has(key) || visited.size === 16) growMargins = true;\n    if ((!growMargins && nextLeft === left && nextBottom === bottom) ||\n        (growMargins && nextLeft <= left && nextBottom <= bottom)) {\n      const base = plot.y + plot.height + clearance;\n      const texts = [\n        ...leftFit.texts.map(label => moveText(label, left - GAP, 0)),\n        ...bottomFit.texts.map(label => moveText(label, 0, base + GAP)),\n      ];\n      if (leftAxis.title && leftTitle.length) {\n        texts.push(placeText(leftTitle, leftAxis.title, left - lane(leftFit) - GAP - leftTitle.length * text.lineHeight / 2,\n          plot.y + plot.height / 2, 'middle', 'middle', -90, horizontal ? 'title-x' : 'title-y', text));\n      }\n      if (bottomAxis.title && bottomTitle.length) {\n        texts.push(placeText(bottomTitle, bottomAxis.title, left + plot.width / 2, base + lane(bottomFit) + GAP,\n          'middle', 'top', 0, horizontal ? 'title-y' : 'title-x', text));\n      }\n\n      const xFit = horizontal ? leftFit : bottomFit;\n      const yFit = horizontal ? bottomFit : leftFit;\n      const hidden = xFit.fit.hidden + yFit.fit.hidden;\n      if (hidden) {\n        input.diagnostics.add({\n          code: 'AX143', level: 'hint', count: hidden, effect: 'none', origin: 'presentation',\n          message: horizontal ? 'Some labels are hidden. See the table.' : 'Some labels are hidden. Try horizontal bars or see the table.',\n        });\n      }\n      return { ...size, kind: 'plot', plot, projection, xTicks: xFit.ticks, yTicks: yFit.ticks, texts, fit: { x: xFit.fit, y: yFit.fit } };\n    }\n    visited.add(key);\n    left = growMargins ? Math.max(left, nextLeft) : nextLeft;\n    bottom = growMargins ? Math.max(bottom, nextBottom) : nextBottom;\n  }\n}\n\nexport function computeLayout(input: LayoutInput): Layout {\n  const { width, height } = input;\n  const size = { width, height };\n  if (width <= 0 || height <= 0) return { ...size, kind: 'unmeasured' };\n\n  if (input.kind === 'message') {\n    const text = metrics(input);\n    const lines = wrapText(input.message, width, text);\n    return { ...size, kind: 'message', text: placeText(lines, input.message, width / 2, height / 2, 'middle', 'middle', 0, 'message', text) };\n  }\n  if (input.compact) {\n    const x = Math.min(2, width / 2);\n    const y = Math.min(2, height / 2);\n    const plot = { x, y, width: width - 2 * x, height: height - 2 * y };\n    return { ...size, kind: 'compact', plot, projection: input.kind === 'ring' ? ring(plot) : project(plot, input) };\n  }\n  if (input.kind === 'ring') {\n    if (width < MIN_WIDTH || height < MIN_HEIGHT) return tooSmall(size, input.diagnostics);\n    const plot = { x: 0, y: 0, width, height };\n    return { ...size, kind: 'plot', plot, projection: ring(plot), xTicks: [], yTicks: [], texts: [], fit: { x: UNCHANGED, y: UNCHANGED } };\n  }\n  return layoutAxes(input, size);\n}\nimport type { AxisLabelFit, LabelRemedy, PlacedText, Tick, TickCandidates, XScale } from '../core/contracts';\n\ntype Role = PlacedText['role'];\ntype Side = 'bottom' | 'left';\n\nexport interface Metrics {\n  readonly lineHeight: number;\n  width(text: string): number;\n}\n\ninterface Label {\n  readonly tick: Tick;\n  readonly text: PlacedText;\n}\n\nexport interface FittedLabels {\n  readonly ticks: readonly Tick[];\n  readonly texts: readonly PlacedText[];\n  readonly depth: number;\n  readonly fit: AxisLabelFit;\n}\n\nconst EPSILON = 1e-7;\nconst DIAGONAL = Math.SQRT1_2;\nconst ellipsis = '…';\nconst segmenter = new Intl.Segmenter(undefined, { granularity: 'grapheme' });\n\nexport function placeText(\n  lines: readonly string[], full: string, x: number, y: number,\n  anchor: PlacedText['anchor'], baseline: PlacedText['baseline'], rotate: 0 | -45 | -90,\n  role: Role, metrics: Metrics,\n): PlacedText {\n  const width = widest(lines, metrics);\n  const height = lines.length * metrics.lineHeight;\n  const left = anchor === 'start' ? 0 : anchor === 'middle' ? -width / 2 : -width;\n  const top = baseline === 'top' ? 0 : baseline === 'middle' ? -height / 2 : -height;\n  const sine = rotate === 0 ? 0 : rotate === -45 ? DIAGONAL : 1;\n  const cosine = rotate === 0 ? 1 : rotate === -45 ? DIAGONAL : 0;\n  return {\n    lines, full, x, y, anchor, baseline, rotate, role,\n    box: {\n      x: x + left * cosine + top * sine,\n      y: y - (left + width) * sine + top * cosine,\n      width: width * cosine + height * sine,\n      height: width * sine + height * cosine,\n    },\n  };\n}\n\nfunction widest(lines: readonly string[], metrics: Metrics): number {\n  let width = 0;\n  for (const line of lines) width = Math.max(width, metrics.width(line));\n  return width;\n}\n\nfunction graphemes(text: string): string[] {\n  return Array.from(segmenter.segment(text), part => part.segment);\n}\n\nexport function wrapText(text: string, limit: number, metrics: Metrics): string[] {\n  if (metrics.width(text) <= limit && !text.includes('\\n')) return [text];\n  const lines: string[] = [];\n  for (const paragraph of text.split('\\n')) {\n    let line = '';\n    for (const word of paragraph.trim().split(/\\s+/u)) {\n      const joined = line ? line + ' ' + word : word;\n      if (metrics.width(joined) <= limit) {\n        line = joined;\n        continue;\n      }\n      if (line) lines.push(line);\n      line = '';\n      if (metrics.width(word) <= limit) {\n        line = word;\n        continue;\n      }\n      for (const glyph of graphemes(word)) {\n        if (line && metrics.width(line + glyph) > limit) {\n          lines.push(line);\n          line = '';\n        }\n        line += glyph;\n      }\n    }\n    if (line || !paragraph.trim()) lines.push(line);\n  }\n  return lines;\n}\n\nfunction wrapLabel(text: string, metrics: Metrics): readonly string[] {\n  let best: readonly string[] = [text];\n  let width = metrics.width(text);\n  for (const space of text.matchAll(/\\s+/gu)) {\n    const first = text.slice(0, space.index);\n    const last = text.slice(space.index + space[0].length);\n    if (!first || !last) continue;\n    const next = Math.max(metrics.width(first), metrics.width(last));\n    if (next < width) {\n      best = [first, last];\n      width = next;\n    }\n  }\n  return best;\n}\n\nfunction middleText(\n  full: string, limit: number, originals: ReadonlySet<string>, used: ReadonlySet<string>, metrics: Metrics,\n): string | undefined {\n  if (!used.has(full) && metrics.width(full) <= limit + EPSILON) return full;\n  if (metrics.width(ellipsis) > limit + EPSILON) return undefined;\n  const letters = graphemes(full);\n  const ends = [0];\n  for (const letter of letters) ends.push(ends[ends.length - 1]! + letter.length);\n  // Try fewer removals first. At a given length, prefer to preserve both ends equally.\n  for (let kept = letters.length - 1; kept >= 0; kept--) {\n    const minimum = kept >= 2 ? 1 : 0;\n    const maximum = kept - minimum;\n    for (let attempt = 0; attempt <= maximum - minimum; attempt++) {\n      const prefix = Math.ceil(kept / 2) + (attempt % 2 ? -Math.ceil(attempt / 2) : attempt / 2);\n      const suffix = kept - prefix;\n      const label = full.slice(0, ends[prefix]) + ellipsis + full.slice(ends[letters.length - suffix]);\n      if (!originals.has(label) && !used.has(label) && metrics.width(label) <= limit + EPSILON) return label;\n    }\n  }\n  return undefined;\n}\n\nfunction bottomLabel(\n  tick: Tick, pixel: number, width: number, lines: readonly string[], rotate: 0 | -45,\n  role: Role, metrics: Metrics,\n): Label {\n  const half = widest(lines, metrics) / 2;\n  const x = rotate === 0 && half * 2 <= width ? Math.max(half, Math.min(width - half, pixel)) : pixel;\n  const anchor = rotate === 0 ? 'middle' : 'end';\n  return { tick, text: placeText(lines, tick.label, x, 0, anchor, 'top', rotate, role, metrics) };\n}\n\nfunction leftLabel(tick: Tick, pixel: number, shown: string, role: Role, metrics: Metrics): Label {\n  return { tick, text: placeText([shown], tick.label, 0, pixel, 'end', 'middle', 0, role, metrics) };\n}\n\nfunction position(scale: XScale, tick: Tick): number {\n  return scale.type === 'band' ? scale.center(tick.value) : scale.map(tick.value);\n}\n\nfunction start(label: Label, side: Side): number {\n  return side === 'bottom' ? label.text.box.x : label.text.box.y;\n}\n\nfunction extent(label: Label, side: Side): number {\n  return side === 'bottom' ? label.text.box.width : label.text.box.height;\n}\n\nfunction depth(label: Label, side: Side): number {\n  return side === 'bottom' ? label.text.box.height : label.text.box.width;\n}\n\nfunction fits(label: Label, side: Side, span: number, room: number): boolean {\n  const first = start(label, side);\n  return first >= -EPSILON && first + extent(label, side) <= span + EPSILON && depth(label, side) <= room + EPSILON;\n}\n\nfunction conflicts(labels: readonly Label[], side: Side, span: number, room: number, gap = 0): Set<Label> {\n  const bad = new Set<Label>();\n  const names = new Map<string, Label>();\n  const sorted = [...labels].sort((a, b) => start(a, side) - start(b, side));\n  let farthest: Label | undefined;\n  let end = -Infinity;\n  for (const label of sorted) {\n    const first = start(label, side);\n    if (!fits(label, side, span, room)) bad.add(label);\n    if (farthest && first < end + gap - EPSILON) {\n      bad.add(farthest);\n      bad.add(label);\n    }\n    if (first + extent(label, side) > end) {\n      farthest = label;\n      end = first + extent(label, side);\n    }\n    const name = label.text.lines.join(' ');\n    const previous = names.get(name);\n    if (previous) {\n      bad.add(previous);\n      bad.add(label);\n    }\n    names.set(name, label);\n  }\n  return bad;\n}\n\nfunction result(labels: readonly Label[], side: Side, remedies: readonly LabelRemedy[], hidden = 0): FittedLabels {\n  let used = 0;\n  for (const label of labels) used = Math.max(used, depth(label, side));\n  return { ticks: labels.map(label => label.tick), texts: labels.map(label => label.text), depth: used, fit: { remedies, hidden } };\n}\n\nfunction inSourceOrder(ticks: readonly Tick[], labels: Map<Tick, Label>): Label[] {\n  return ticks.flatMap(tick => {\n    const label = labels.get(tick);\n    return label ? [label] : [];\n  });\n}\n\nfunction byPosition(ticks: readonly Tick[], scale: XScale) {\n  return ticks.map(tick => ({ tick, pixel: position(scale, tick) })).sort((a, b) => a.pixel - b.pixel);\n}\n\nexport function fitBottom(\n  candidates: TickCandidates, mayThin: boolean, scale: XScale, width: number, room: number,\n  role: Role, metrics: Metrics,\n): FittedLabels {\n  const remedies: LabelRemedy[] = [];\n  let ticks = candidates[0] ?? [];\n  let labels: Label[] = [];\n  const count = mayThin ? candidates.length : Math.min(candidates.length, 1);\n\n  for (let i = 0; i < count; i++) {\n    ticks = candidates[i]!;\n    labels = ticks.map(tick => bottomLabel(tick, position(scale, tick), width, [tick.label], 0, role, metrics));\n    if (i === 1) remedies.push('thinned');\n    if (conflicts(labels, 'bottom', width, room, mayThin ? 8 : 0).size === 0) {\n      return result(labels, 'bottom', remedies);\n    }\n  }\n\n  const bad = conflicts(labels, 'bottom', width, room);\n  if (bad.size === 0) return result(labels, 'bottom', remedies);\n  labels = labels.map(label => {\n    if (!bad.has(label)) return label;\n    const lines = wrapLabel(label.tick.label, metrics);\n    return lines.length === 1 ? label : bottomLabel(label.tick, position(scale, label.tick), width, lines, 0, role, metrics);\n  });\n  if (labels.some(label => label.text.lines.length > 1)) remedies.push('wrapped');\n  if (conflicts(labels, 'bottom', width, room).size === 0) return result(labels, 'bottom', remedies);\n\n  labels = labels.map(({ tick, text }) => bottomLabel(tick, position(scale, tick), width, text.lines, -45, role, metrics));\n  remedies.push('rotated');\n  if (conflicts(labels, 'bottom', width, room).size === 0) return result(labels, 'bottom', remedies);\n\n  const originals = new Set(ticks.map(tick => tick.label));\n  const used = new Set<string>();\n  const kept = new Map<Tick, Label>();\n  let edge = 0;\n  for (const { tick, pixel } of byPosition(ticks, scale)) {\n    // The rotated right edge depends only on line height. Keeping the earliest right edge\n    // leaves the most room for following labels, even when some anchors must be skipped.\n    const right = pixel + DIAGONAL * metrics.lineHeight;\n    if (right > width + EPSILON) continue;\n    const limit = Math.min((pixel - edge) / DIAGONAL, room / DIAGONAL - metrics.lineHeight);\n    const text = middleText(tick.label, limit, originals, used, metrics);\n    if (text === undefined) continue;\n    const label = bottomLabel(tick, pixel, width, [text], -45, role, metrics);\n    used.add(text);\n    kept.set(tick, label);\n    edge = right;\n  }\n  if ([...kept.values()].some(label => label.text.lines[0] !== label.tick.label)) remedies.push('truncated');\n  return result(inSourceOrder(ticks, kept), 'bottom', remedies, ticks.length - kept.size);\n}\n\nexport function fitLeftCategories(\n  ticks: readonly Tick[], scale: XScale, width: number, height: number, role: Role, metrics: Metrics,\n): FittedLabels {\n  const originals = new Set(ticks.map(tick => tick.label));\n  const used = new Set<string>();\n  const kept = new Map<Tick, Label>();\n  let edge = 0;\n  for (const { tick, pixel } of byPosition(ticks, scale)) {\n    const top = pixel - metrics.lineHeight / 2;\n    if (top < edge - EPSILON || top + metrics.lineHeight > height + EPSILON) continue;\n    const text = middleText(tick.label, width * 0.4, originals, used, metrics);\n    if (text === undefined) continue;\n    const label = leftLabel(tick, pixel, text, role, metrics);\n    kept.set(tick, label);\n    used.add(text);\n    edge = top + metrics.lineHeight;\n  }\n  const remedies: LabelRemedy[] = [...kept.values()].some(label => label.text.lines[0] !== label.tick.label) ? ['truncated'] : [];\n  return result(inSourceOrder(ticks, kept), 'left', remedies, ticks.length - kept.size);\n}\n\nexport function fitValue(\n  candidates: TickCandidates, scale: XScale, side: Side, span: number, room: number, role: Role, metrics: Metrics,\n): FittedLabels {\n  const gap = metrics.lineHeight / 2;\n  let labels: Label[] = [];\n  for (const [i, ticks] of candidates.entries()) {\n    labels = ticks.map(tick => {\n      const pixel = position(scale, tick);\n      return side === 'left'\n        ? leftLabel(tick, pixel, tick.label, role, metrics)\n        : bottomLabel(tick, pixel, span, [tick.label], 0, role, metrics);\n    });\n    if (conflicts(labels, side, span, room, gap).size === 0) return result(labels, side, i ? ['thinned'] : []);\n  }\n\n  const sorted = [...labels].sort((a, b) => start(a, side) + extent(a, side) - start(b, side) - extent(b, side));\n  const kept = new Set<Label>();\n  const used = new Set<string>();\n  let edge = -Infinity;\n  for (const label of sorted) {\n    const first = start(label, side);\n    if (first < edge + gap || used.has(label.tick.label) || !fits(label, side, span, room)) continue;\n    kept.add(label);\n    used.add(label.tick.label);\n    edge = first + extent(label, side);\n  }\n  return result(labels.filter(label => kept.has(label)), side, candidates.length > 1 ? ['thinned'] : [], labels.length - kept.size);\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"git status --short; rg --files packages/axylo/{src,test}/{layout,simplify}; rg -n 'F2|F5|L1|L3|L5|L6|L8|A6|C3|\"'^### 3'\"\\\\.[56]|Simplified drawing' docs/02-product-spec.md docs/03-plan-typescript-release.md; rg -n 'SLOT_|PathMark|AreaMark|PointMark|Projection|PlacedText|AxisLabelFit|TickCandidates|TextMeasurer|TextStyle|XScale|ContinuousScale|type Layout|interface Layout' packages/axylo/src/core/contracts.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"git status --short; rg --files packages/axylo/{src,test}/{layout,simplify}; rg -n 'F2|F5|L1|L3|L5|L6|L8|A6|C3|\"'^### 3'\"\\\\.[56]|Simplified drawing' docs/02-product-spec.md docs/03-plan-typescript-release.md; rg -n 'SLOT_|PathMark|AreaMark|PointMark|Projection|PlacedText|AxisLabelFit|TickCandidates|TextMeasurer|TextStyle|XScale|ContinuousScale|type Layout|interface Layout' packages/axylo/src/core/contracts.ts\"","aggregated_output":" M packages/axylo/src/lookup/aligned.ts\n M reviews/2026-11-18/impl/wp/layout.fix.prompt.md\n M reviews/2026-11-18/impl/wp/lookup-reader.events.jsonl\n?? reviews/2026-11-18/impl/wp/layout.fix.events.jsonl\n?? reviews/2026-11-18/impl/wp/layout.fix.report.md\npackages/axylo/test/simplify/simplify.test.ts\npackages/axylo/src/simplify/index.ts\npackages/axylo/test/layout/layout.test.ts\npackages/axylo/src/layout/index.ts\npackages/axylo/src/layout/labels.ts\ndocs/03-plan-typescript-release.md:5:This plan builds the product defined in [02-product-spec.md](02-product-spec.md). Criterion IDs (F1, L1, A2, DX4, P1 …) refer to that spec; finding IDs (R5, D2 …) refer to [01-landscape.md](01-landscape.md).\ndocs/03-plan-typescript-release.md:86:| `missing` (value) | `'gap'` (default) or `'zero'` (F2). |\ndocs/03-plan-typescript-release.md:179:The **frame** is the normalized, lossless data: typed columns, a validity bitmap, dictionary-encoded categories, source-row indexes and a revision number. It is the only source for exact values. The table, the summary, keyboard navigation, tooltips and events read the frame. The **scene** is geometry for drawing and may be simplified (F5); nothing reads values back from it. The first draft derived accessibility from the scene, and two reviewers showed that a simplified drawing cannot return the samples it dropped.\ndocs/03-plan-typescript-release.md:186:| layout | Plot rectangle, tick sets, label boxes, legend and control placement | Implements L1, L3, L8. Takes a text-measurement interface as input. |\ndocs/03-plan-typescript-release.md:206:**Working assumption: Canvas 2D for marks, HTML for all text.** Text stays in the DOM so that it inherits the page font and color, honors user text spacing and zoom (A6), adapts in forced-colors mode, and can be selected and translated.\ndocs/03-plan-typescript-release.md:208:**This is reopened and decided in M1 by measurement.** The first draft justified canvas by Phase 1's slow SVG libraries, but those create a node per point; the one-path-per-series SVG chart in the harness was fast. With drawing simplified to a few vertices per pixel column (F5), an SVG path per series is small. SVG follows CSS variables and class-toggled themes with no repaint code, adapts to forced colors, prints sharply, needs no pixel-ratio handling and allocates no backing store (a 1,920×1,080 canvas at pixel ratio 2 is about 33 MB). Canvas is likely cheaper for per-frame redraw when streaming and hovering.\ndocs/03-plan-typescript-release.md:212:**Simplified drawing.** Per device-pixel column and per contiguous run of valid samples, the stroke covers the run's minimum and maximum (F5). One rule for when it applies: more than four visible samples per device-pixel column on average. The pass over visible samples is O(visible) on typed columns and is measured separately from drawing; the vertex count is bounded by width times the number of runs, not by width alone.\ndocs/03-plan-typescript-release.md:286:- The diagnostic registry (F3, F12); missing values and absent steps (F2); the three temporal types (F4); formatting (F6); domains (F7); sorting and duplicates (F11); `validate()`.\ndocs/03-plan-typescript-release.md:298:- Title, `labelledBy`, subtitle, axis titles; toolbar with legend toggles; full tooltip and fixed readout (I1); label fitting (L1) and the too-small fallback (L8); states (L7); reference lines and bands.\ndocs/03-plan-typescript-release.md:302:- L1's property test in three engines, including text-spacing overrides and a late-loading font, on a category-axis line chart with long labels.\ndocs/03-plan-typescript-release.md:311:- The pattern chosen in M1, built fully: names and summary (A1), keyboard (A2), point text (A3), table with paging (A4), non-color cues (A5), reflow (A6), streaming behavior (A7), messages and language (A10); single-pointer zoom controls (I3, I4); reduced motion on update (I5).\ndocs/03-plan-typescript-release.md:327:- `bars` fixture: starts at zero, long label handled by L1's remedies, missing bar distinct from zero.\ndocs/03-plan-typescript-release.md:342:- F5's assertions on kept samples, including the adversarial same-column cases.\ndocs/03-plan-typescript-release.md:375:| Property | fast-check | Invariants that must hold for any data: F1, F2, F5, F7, F11, L1. |\ndocs/03-plan-typescript-release.md:391:| DOM text costs too much with many charts on a page. | P5 is measured in M1. A fallback to canvas-drawn tick labels would give up user text spacing and forced-colors adaptation for those labels, so it must pass the same L1 and A6 tests before it is allowed. |\ndocs/03-plan-typescript-release.md:394:| Layout promises collide in small tiles. | L8 defines the fallback; the property test covers down to 240 px. |\ndocs/03-plan-typescript-release.md:405:| Annotations beyond reference lines and bands | Text placement interacts with L1. |\ndocs/02-product-spec.md:95:| F2 | Missing values are never drawn as zero and never bridged unless the author asks. An explicit `null` is a gap, silently. An isolated value between two gaps is a visible point. A missing bar shows a \"no data\" mark at the baseline, distinct from a zero bar. On a time or date axis with a regular step, an absent step is a gap and raises AX105; `missing: 'zero'` on the field turns absent and null values into zeros for counts. Tooltip, table and announcements say \"No data\". | `trend` with nulls and `trend` with the same 7 rows deleted render the same gap; `dirty` fixtures; property test that no segment connects across a missing index | R5 |\ndocs/02-product-spec.md:98:| F5 | No smoothing. When a line is denser than the screen, the drawing is simplified with this guarantee: for every device-pixel column, and every contiguous run of valid samples inside it, the drawn stroke covers exactly that run's minimum and maximum. A break between two runs is always kept, even when both fall in one pixel column; a slot a series merely has no row for (weekly data beside daily) does not break its line. Stacked areas are simplified on their cumulative sums. Exact values always come from the data, not the drawing. | Assertions on which source samples the drawing kept, for: one outlier in 1,000,000; two peaks and a gap in one column; alternating valid and missing samples; tied extremes; device pixel ratio 1 and 2; several zoom levels. A sample that the drawing dropped is still reachable by keyboard and in the table | D8, D9 |\ndocs/02-product-spec.md:111:| L1 | No visible text overlaps other text or is clipped, and no label disappears without the reader being told. Remedies, in order: thin (time, date, numeric and `ordered` category axes only); wrap to two lines; rotate up to 45°; truncate in the middle, keeping every label distinct, with the full text in tooltip and table. If labels still do not fit, a visible note (\"Some labels hidden. See table.\") appears and AX143 suggests horizontal bars. Axylo never changes a chart's orientation on its own. | In real browsers, after fonts load: for widths 240–1,920 px and generated label sets, zero intersecting text boxes (1 px tolerance), zero text outside the figure, truncated labels pairwise distinct. Repeated with the WCAG 1.4.12 text-spacing overrides, 200% text-only zoom, and a font that loads late | R2 |\ndocs/02-product-spec.md:113:| L3 | The chart follows its container with no call from the page, in both directions. With no definite height, the plot is 16:9, clamped between 160 and 480 CSS px tall, and the title, controls and table flow above and below it. A container that starts hidden or zero-sized draws when it gets a size. | Resize 720 → 360 → 720 px; hidden-then-shown test; `height: auto` container is stable over 10 frames | R16, D1 |\ndocs/02-product-spec.md:115:| L5 | A marker on every point appears only when adjacent points are at least 12 px apart (provisional value), and always for isolated points. | `trend` at 720 px has none; a 12-point line has them | R8 |\ndocs/02-product-spec.md:116:| L6 | Title, subtitle and axis titles with units are part of the chart. Axis titles never overlap tick labels. | Layout tests; `trend` fixture | R9 |\ndocs/02-product-spec.md:118:| L8 | When the figure cannot hold a readable plot (less than 120×80 CSS px for the plot), it shows the title, the one-line summary and the table control instead, and raises AX142. | Narrow and short container tests | R2 |\ndocs/02-product-spec.md:142:| A6 | Content reflows at 320 CSS px and 400% zoom without two-dimensional scrolling. User text-spacing overrides do not clip text. | Viewport and style-override tests in three engines | WCAG 1.4.10, 1.4.12 |\ndocs/02-product-spec.md:148:### 3.5 Diagnostic registry\ndocs/02-product-spec.md:185:### 3.6 Type matrix\ndocs/02-product-spec.md:193:| Simplified drawing when dense | F5 | F5 on cumulative sums | No; more bars than pixels raises a hint | No | No in 1.0; above 50,000 points a hint says drawing may be slow |\ndocs/02-product-spec.md:204:| C2 | The fidelity rules still hold: zero baseline for bar and area (F1), gaps (F2), diagnostics (F3), simplified drawing (F5), sorting (F11), no motion (I5), scheme from the page (L4). | The same fixtures as the full charts |\ndocs/02-product-spec.md:205:| C3 | It fills its container at any size from 24×16 CSS px up; with no definite height it is 32 px tall. | Size tests |\ndocs/02-product-spec.md:268:| Simplified drawing that preserves extremes, on by default | D8. | Kept for lines and areas, with the guarantee restated per pixel column and per run of valid samples. \"Every spike survives\" was wrong as written. |\n57:export const SLOT_VALUE = 0;         // a finite number\n58:export const SLOT_NULL = 1;          // explicit null (or NaN in a typed column, or an empty string): \"no data\", silent\n59:export const SLOT_INVALID = 2;       // present but not plottable (NaN or infinity in a row, a stray string): reported\n60:export const SLOT_NO_ROW = 3;        // this series has no observation at this x and none was expected; neighbours may be joined across it\n61:export const SLOT_GAP = 4;           // an expected step of this series is absent (AX105): never joined across\n62:export const SLOT_ABSENT_FIELD = 5;  // the row exists but the field's key is absent or undefined (AX102)\n65: * `missing: 'zero'` on a value field is applied by normalization: slots that would be SLOT_NULL, SLOT_NO_ROW,\n66: * SLOT_GAP or SLOT_ABSENT_FIELD become SLOT_VALUE with y = 0 and row = -1. SLOT_INVALID is never turned into zero.\n104:  /** y per slot. NaN wherever `slot` is not SLOT_VALUE. May be a view on the caller's typed column. */\n158:  /** NaN where `slot` is not SLOT_VALUE. */\n170: * Join rule for lines and areas (spec F2). Two consecutive SLOT_VALUE slots i < j of one series are joined\n171: * if and only if every slot strictly between them is SLOT_NO_ROW. A value with no joined neighbour on either\n188:export interface ContinuousScale {\n212:export type XScale = ContinuousScale | BandScale;\n224:export type TickCandidates = readonly (readonly Tick[])[];\n246: * for k = 0) its lower boundary; likewise `negative`. A component that is not SLOT_VALUE contributes zero\n321:export interface TextStyle {\n331:export interface TextMeasurer {\n332:  width(text: string, style: TextStyle): number;\n341:export interface PlacedText {\n359:export type Projection =\n360:  | { readonly kind: 'xy'; readonly x: XScale; readonly y: ContinuousScale }\n362:  | { readonly kind: 'bands'; readonly horizontal: boolean; readonly band: XScale; readonly value: ContinuousScale }\n366:export interface AxisLabelFit {\n372:interface LayoutSize {\n382:export type Layout =\n387:      readonly projection: Projection;\n390:      readonly texts: readonly PlacedText[];\n391:      readonly fit: { readonly x: AxisLabelFit; readonly y: AxisLabelFit };\n394:  | (LayoutSize & { readonly kind: 'compact'; readonly plot: Rect; readonly projection: Projection })\n398:  | (LayoutSize & { readonly kind: 'message'; readonly text: PlacedText })\n422:export interface PathMark {\n437:export interface AreaMark {\n458:export interface PointMark {\n497:export type Mark = PathMark | AreaMark | RectMark | PointMark | ArcMark | RuleMark | BandMark;\n659:  readonly textStyle: TextStyle;\n","exit_code":0,"status":"completed"}}
