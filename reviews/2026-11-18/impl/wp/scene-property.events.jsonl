{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/test/scene/scene.test.ts | sed -n '350,590p' && git log --oneline ed230af..HEAD -- packages/axylo/test/scene/scene.test.ts && git log --format='%h %s' --ancestry-path ed230af..11fe315\"","aggregated_output":"   350\t  expect(height).toBeGreaterThanOrEqual(0);\n   351\t  expectPoint(x, y, plot);\n   352\t  expectPoint(x + width, y + height, plot);\n   353\t}\n   354\t\n   355\tfunction expectWithinClip(mark: Mark, plot: Rect, view: View, authorX: boolean, authorY: boolean): void {\n   356\t  // Joined segments and partial bar bands keep their original geometry until the renderer clips them.\n   357\t  let xOverflow = false;\n   358\t  if ('series' in mark && view.kind !== 'donut' && view.kind !== 'scatter') {\n   359\t    // Stack seams can use the union of the visible components' draw ranges.\n   360\t    const draws = mark.type === 'path' && mark.stroke.kind === 'token' ? view.drawSlots : [view.drawSlots[mark.series]!];\n   361\t    xOverflow = draws.some(draw => draw.start < view.visibleSlots.start || draw.end > view.visibleSlots.end);\n   362\t  }\n   363\t  const expectBoundary = (xy: Float32Array, allowLifts = false, allowOutsideX = xOverflow) => {\n   364\t    const margin = (allowLifts && mark.type === 'path' ? mark.strokeWidth : 0) + 0.0001;\n   365\t    const right = plot.x + plot.width;\n   366\t    const bottom = plot.y + plot.height;\n   367\t    for (let i = 0; i < xy.length; i += 2) {\n   368\t      const x = xy[i]!;\n   369\t      const y = xy[i + 1]!;\n   370\t      if (allowLifts && Number.isNaN(x)) {\n   371\t        expect(Number.isNaN(y)).toBe(true);\n   372\t        continue;\n   373\t      }\n   374\t      expect(Number.isFinite(x) && Number.isFinite(y)).toBe(true);\n   375\t      if (!allowOutsideX) expect(x >= plot.x - margin && x <= right + margin).toBe(true);\n   376\t      const insideX = x >= plot.x - 0.0001 && x <= right + 0.0001;\n   377\t      if (insideX && !authorY) expect(y >= plot.y - margin && y <= bottom + margin).toBe(true);\n   378\t      if (allowOutsideX && !authorY && i >= 2) {\n   379\t        const previousX = xy[i - 2]!;\n   380\t        const previousY = xy[i - 1]!;\n   381\t        for (const edge of [plot.x, right]) {\n   382\t          if (previousX < edge && edge < x) {\n   383\t            const atEdge = previousY + (y - previousY) * ((edge - previousX) / (x - previousX));\n   384\t            expect(atEdge >= plot.y - margin && atEdge <= bottom + margin).toBe(true);\n   385\t          }\n   386\t        }\n   387\t      }\n   388\t    }\n   389\t  };\n   390\t  switch (mark.type) {\n   391\t    case 'rule':\n   392\t      if (mark.role === 'axis' || mark.role === 'tick') {\n   393\t        expect([mark.x1, mark.y1, mark.x2, mark.y2].every(Number.isFinite)).toBe(true);\n   394\t      } else {\n   395\t        expectPoint(mark.x1, mark.y1, plot, mark.strokeWidth);\n   396\t        expectPoint(mark.x2, mark.y2, plot, mark.strokeWidth);\n   397\t      }\n   398\t      break;\n   399\t    case 'path': expectBoundary(mark.xy, true); break;\n   400\t    case 'points': expectBoundary(mark.xy, false, false); break;\n   401\t    case 'area':\n   402\t      expect(mark.upper.every(Number.isFinite) && mark.lower.every(Number.isFinite)).toBe(true);\n   403\t      for (let i = 0; i < mark.runs.length; i += 4) {\n   404\t        const upperStart = mark.runs[i]! * 2;\n   405\t        const lowerStart = mark.runs[i + 2]! * 2;\n   406\t        const upperEnd = upperStart + mark.runs[i + 1]! * 2;\n   407\t        const lowerEnd = lowerStart + mark.runs[i + 3]! * 2;\n   408\t        expect(upperEnd).toBeLessThanOrEqual(mark.upper.length);\n   409\t        expect(lowerEnd).toBeLessThanOrEqual(mark.lower.length);\n   410\t        expectBoundary(mark.upper.subarray(upperStart, upperEnd));\n   411\t        expectBoundary(mark.lower.subarray(lowerStart, lowerEnd));\n   412\t      }\n   413\t      break;\n   414\t    case 'rects':\n   415\t      for (let i = 0; i < mark.xywh.length; i += 4) {\n   416\t        const [x, y, w, h] = mark.xywh.subarray(i, i + 4);\n   417\t        expect([x, y, w, h].every(Number.isFinite) && w! >= 0 && h! >= 0).toBe(true);\n   418\t        if (view.kind === 'bar' && view.frame.x.kind !== 'category') {\n   419\t          const partialBands = authorX || view.xDomain !== view.xFull;\n   420\t          if (view.horizontal) {\n   421\t            expect(x! >= plot.x - 0.0001 && x! + w! <= plot.x + plot.width + 0.0001).toBe(true);\n   422\t            if (!partialBands) expect(y! >= plot.y - 0.5001 && y! + h! <= plot.y + plot.height + 0.5001).toBe(true);\n   423\t          } else {\n   424\t            expect(y! >= plot.y - 0.0001 && y! + h! <= plot.y + plot.height + 0.0001).toBe(true);\n   425\t            if (!partialBands) expect(x! >= plot.x - 0.5001 && x! + w! <= plot.x + plot.width + 0.5001).toBe(true);\n   426\t          }\n   427\t        } else {\n   428\t          expectBox(x!, y!, w!, h!, plot);\n   429\t        }\n   430\t      }\n   431\t      break;\n   432\t    case 'band': expectBox(mark.box.x, mark.box.y, mark.box.width, mark.box.height, plot); break;\n   433\t    case 'arcs':\n   434\t      expectPoint(mark.cx - mark.r1, mark.cy - mark.r1, plot);\n   435\t      expectPoint(mark.cx + mark.r1, mark.cy + mark.r1, plot);\n   436\t      expect(Number.isFinite(mark.r0) && mark.angles.every(Number.isFinite)).toBe(true);\n   437\t      break;\n   438\t  }\n   439\t}\n   440\t\n   441\tit('keeps generated geometry finite and clipped across independent chart states', () => {\n   442\t  const value = fc.option(fc.integer({ min: -500, max: 500 }), { nil: null });\n   443\t  const configuration = fc.record({\n   444\t    kind: fc.constantFrom('line', 'area', 'bar', 'scatter', 'donut'),\n   445\t    rows: fc.array(fc.tuple(value, value), { minLength: 8, maxLength: 32 }),\n   446\t    width: fc.integer({ min: 1, max: 40 }),\n   447\t    height: fc.integer({ min: 1, max: 120 }),\n   448\t    dpr: fc.constantFrom(1, 1.5, 2),\n   449\t    stacked: fc.boolean(), horizontal: fc.boolean(), compact: fc.boolean(),\n   450\t    dense: fc.boolean(), long: fc.boolean(), category: fc.boolean(), author: fc.boolean(),\n   451\t    authorY: fc.boolean(), zoom: fc.boolean(), hide: fc.boolean(),\n   452\t  });\n   453\t  const exercised = new Set<string>();\n   454\t  fc.assert(fc.property(configuration, config => {\n   455\t    const { kind, width, height, stacked, horizontal, compact, authorY } = config;\n   456\t    const plot = { x: 12.25, y: 16.5, width, height };\n   457\t    const rows = config.dense && (kind === 'line' || kind === 'area')\n   458\t      ? Array.from({ length: 480 }, (_, i) => config.rows[i % config.rows.length]!) : config.rows;\n   459\t    const last = rows.length - 1;\n   460\t    const category = config.category && kind === 'bar';\n   461\t    const references = [\n   462\t      { y: [-15, 15] as const, label: 'Range' }, { y: 17, label: 'Goal' },\n   463\t      { x: category ? 'Band 4' : [-2, last + 1] as const, label: 'Period' },\n   464\t    ];\n   465\t    const xDomain = config.author && !category ? [1.25, last - 0.25] as const : undefined;\n   466\t    const zoom = config.zoom ? [last / 4 + 0.1, last * 0.75 + 0.2] as const : null;\n   467\t    const state = {\n   468\t      zoom: category ? null : zoom, xDomain, references,\n   469\t      valueDomain: authorY ? [-200, 200] as const : undefined,\n   470\t      hidden: config.hide ? new Set(['b']) : undefined,\n   471\t    };\n   472\t    let view: View;\n   473\t    if (kind === 'donut') {\n   474\t      view = donut(rows.map(([y], i) => ({ label: 'Part ' + i, value: y === null ? null : Math.abs(y) }))).view;\n   475\t    } else if (kind === 'scatter') {\n   476\t      const data = rows.flatMap(([a, b], x) => [{ x, y: a, s: 'a' }, { x, y: b, s: 'b' }]);\n   477\t      view = scatter({ x: 'x', y: 'y', series: 's', data }, state).view;\n   478\t    } else {\n   479\t      const xAt = (i: number) => category ? 'Band ' + i : i;\n   480\t      const a = rows.flatMap(([y], i) => i === 3 ? [] : [{ x: xAt(i), y: config.dense ? y ?? 0 : y, s: 'a' }]);\n   481\t      const b = rows.flatMap(([, y], i) => i % 2 ? [] : [{ x: xAt(i), y, s: 'b' }]);\n   482\t      const data = config.long ? [...a, ...b] : rows.map(([a, b], i) => ({ x: xAt(i), a: config.dense ? a ?? 0 : a, b }));\n   483\t      view = aligned(config.long ? { x: 'x', y: 'y', series: 's', data } : { x: 'x', y: ['a', 'b'], data },\n   484\t        { ...state, kind, stacked, horizontal, compact }).view;\n   485\t      if (config.long && !category) {\n   486\t        expect(view.frame.series[0]!.slot.includes(SLOT_GAP)).toBe(true);\n   487\t        expect(view.frame.series[1]!.slot.includes(SLOT_NO_ROW)).toBe(true);\n   488\t        exercised.add('long-form states');\n   489\t      }\n   490\t      if (kind === 'bar' && !compact) exercised.add('bar ' + [stacked, horizontal, config.dpr].join('/'));\n   491\t    }\n   492\t    const scene = buildScene(view, layout(view, plot, view.kind !== 'donut' && view.compact, 0.2), config.dpr);\n   493\t    expect(scene.clip).toBe(plot);\n   494\t    if (view.kind !== 'donut') {\n   495\t      if (xDomain) {\n   496\t        expect(view.xFull).toEqual(xDomain);\n   497\t        exercised.add('author x domain');\n   498\t      } else if (!category) {\n   499\t        expect(view.xFull[0]).toBeLessThanOrEqual(-2);\n   500\t        expect(view.xFull[1]).toBeGreaterThanOrEqual(last + 1);\n   501\t        exercised.add('automatic x references');\n   502\t      }\n   503\t      if (zoom && !view.compact && !category) {\n   504\t        expect(view.xDomain[0]).toBeGreaterThanOrEqual(view.xFull[0]);\n   505\t        expect(view.xDomain[1]).toBeLessThanOrEqual(view.xFull[1]);\n   506\t        expect(view.xDomain[1] - view.xDomain[0]).toBeCloseTo(zoom[1] - zoom[0], 10);\n   507\t        exercised.add('zoom');\n   508\t      }\n   509\t      if (config.hide) {\n   510\t        const hidden = view.frame.series.findIndex(series => series.key === 'b');\n   511\t        if (hidden >= 0) {\n   512\t          expect(view.visible[hidden]).toBe(false);\n   513\t          expect(scene.marks.some(mark => 'series' in mark && mark.series === hidden)).toBe(false);\n   514\t          exercised.add('hidden series');\n   515\t        }\n   516\t      }\n   517\t    }\n   518\t    if (view.kind === 'line' && config.dense && !config.long) {\n   519\t      const slots = view.frame.series[0]!.slot.subarray(view.visibleSlots.start, view.visibleSlots.end);\n   520\t      const columns = Math.ceil((plot.x + width) * config.dpr) - Math.floor(plot.x * config.dpr);\n   521\t      const path = marksOf(scene.marks, 'path').find(mark => mark.series === 0);\n   522\t      if (slots.length > 4 * columns && slots.every(slot => slot === SLOT_VALUE) && path && path.xy.length / 2 < slots.length) {\n   523\t        exercised.add('simplified path');\n   524\t      }\n   525\t    }\n   526\t    for (const mark of scene.marks) expectWithinClip(mark, plot, view, xDomain !== undefined, authorY);\n   527\t  }), { numRuns: 1000, seed: 536 });\n   528\t  expect(exercised).toEqual(new Set([\n   529\t    'long-form states', 'automatic x references', 'author x domain', 'hidden series', 'zoom', 'simplified path',\n   530\t    ...[false, true].flatMap(stacked => [false, true].flatMap(horizontal =>\n   531\t      [1, 1.5, 2].map(dpr => 'bar ' + [stacked, horizontal, dpr].join('/')))),\n   532\t  ]));\n   533\t});\n   534\t\n   535\tit('keeps a joined line visible from edge to edge when its zoom contains no samples', () => {\n   536\t  const { view } = aligned({ x: 'x', y: 'y', data: [50, 60, 70, 80].map((y, x) => ({ x, y })) },\n   537\t    { kind: 'line', zoom: [1.2, 1.8] });\n   538\t  const path = marksOf(buildScene(view, layout(view), dpr).marks, 'path')[0]!;\n   539\t  const [x1, y1, x2, y2] = path.xy;\n 