 66\t      const box = vertical ? { ...plot, x: low, width: high - low } : { ...plot, y: low, height: high - low };\n    67\t      bands.push({ type: 'band', box, fill: paint, opacity: 0.12 });\n    68\t    }\n    69\t  }\n    70\t  return { bands, lines };\n    71\t}\n    72\t\n    73\tfunction arcMarks(view: DonutView, projection: Extract<Projection, { kind: 'ring' }>): Mark[] {\n    74\t  const { drawn, angles } = donutGeometry(view.slices, projection);\n    75\t  if (!drawn.length) return [];\n    76\t  const fills = drawn.map(slice => slice.colorIndex === null ? token('muted') : seriesPaint(slice.colorIndex));\n    77\t  const { cx, cy, r0, r1 } = projection;\n    78\t  return [{ type: 'arcs', cx, cy, r0, r1, angles, fills, gap: DONUT_GAP }];\n    79\t}\n    80\t\n    81\texport function buildScene(view: View, layout: Layout, devicePixelRatio: number): Scene {\n    82\t  const { width, height } = layout;\n    83\t  if (layout.kind !== 'plot' && layout.kind !== 'compact') {\n    84\t    return { width, height, clip: { x: 0, y: 0, width, height }, marks: [] };\n    85\t  }\n    86\t  const { plot: clip, projection } = layout;\n    87\t  if (projection.kind === 'ring' || view.kind === 'donut') {\n    88\t    const marks = projection.kind === 'ring' && view.kind === 'donut' ? arcMarks(view, projection) : [];\n    89\t    return { width, height, clip, marks };\n    90\t  }\n    91\t\n    92\t  const compact = layout.kind === 'compact' || view.compact;\n    93\t  const { grid, edges } = layout.kind === 'plot' && !compact ? gridAndAxes(layout, projection) : { grid: [], edges: [] };\n    94\t  const { bands, lines } = compact ? { bands: [], lines: [] } : references(view, projection, clip);\n    95\t  const layers: (readonly Mark[])[] = [bands, grid];\n    96\t  if (view.kind === 'bar' && projection.kind === 'bands') {\n    97\t    layers.push(barMarks(view, projection, clip));\n    98\t  } else if (view.kind === 'scatter' && projection.kind === 'xy') {\n    99\t    layers.push(scatterPoints(view, projection));\n   100\t  } else if ((view.kind === 'line' || view.kind === 'area') && projection.kind === 'xy') {\n   101\t    const areas: AreaMark[] = [];\n   102\t    const seams: PathMark[] = [];\n   103\t    const paths: PathMark[] = [];\n   104\t    const points: PointMark[] = [];\n   105\t    const dpr = Number.isFinite(devicePixelRatio) && devicePixelRatio > 0 ? devicePixelRatio : 1;\n   106\t    const draw = drawing(view.frame.x.values, projection, clip, dpr);\n   107\t    if (view.kind === 'area' && view.stack) {\n   108\t      addStackedAreas(draw, view, view.stack, compact, areas, seams, paths, points);\n   109\t    } else {\n   110\t      for (let i = 0; i < view.frame.series.length; i++) {\n   111\t        if (!view.visible[i]) continue;\n   112\t        const { slot, y } = view.frame.series[i]!;\n   113\t        const input = { ...draw, range: view.drawSlots[i]!, slot, y };\n   114\t        if (view.kind === 'area') addArea(input, view, i, compact, areas, paths, points);\n   115\t        else addLine(input, view, i, view.visibleSlots, compact, paths, points);\n   116\t      }\n   117\t    }\n   118\t    layers.push(areas, seams, paths, points);\n   119\t  }\n   120\t  layers.push(edges, lines);\n   121\t  return { width, height, clip, marks: layers.flat() };\n   122\t}\ncommit 11fe3151bd72ab00419622248a9e0a52a6e29abd\nAuthor: canarit <gaqu1994@gmail.com>\n\n    Compact charts ignore reference and tick formats, and say so (Codex gpt-6.2-sol xhigh)\n\ndiff --git a/docs/02-product-spec.md b/docs/02-product-spec.md\nindex 9d834fb..ffe753d 100644\n--- a/docs/02-product-spec.md\n+++ b/docs/02-product-spec.md\n@@ -97,7 +97,7 @@ Every criterion maps to at least one test in the acceptance matrix kept in the r\n | F4 | Three temporal types, never mixed silently. **Calendar dates** (`2026-02-24`, `2026-02`, `2026`) read the same in every viewer time zone. **Instants** (epoch milliseconds declared `type: 'time'`, `Date` objects, ISO strings with an offset) are shown in `timeZone` (default: the viewer's), with the zone named in the tooltip heading and the description. **Wall-clock times** (date-time strings without an offset) are shown as written, with hint AX112. Instants that all fall on the same time of day, whole days apart, raise hint AX111 (\"these look like calendar dates\"). A bare number is never assumed to be an instant. | Four fixture variants in UTC, America/Los_Angeles and Asia/Kolkata: (a) date strings: identical text in all three; (b) ISO strings with `Z`, (c) epoch ms with `type: 'time'`, (d) `Date` objects: each zone's correct local text, zone visible, AX111 raised; with `timeZone: 'UTC'` or `type: 'date'`: identical. Plus: both DST transitions, a leap day, an unparseable date | R3 |\n | F5 | No smoothing. When a line is denser than the screen, the drawing is simplified with this guarantee: for every device-pixel column, and every contiguous run of valid samples inside it, the drawn stroke covers exactly that run's minimum and maximum. A break between two runs is always kept, even when both fall in one pixel column; a slot a series merely has no row for (weekly data beside daily) does not break its line. Stacked areas are simplified on their cumulative sums. Exact values always come from the data, not the drawing. | Assertions on which source samples the drawing kept, for: one outlier in 1,000,000; two peaks and a gap in one column; alternating valid and missing samples; tied extremes; device pixel ratio 1 and 2; several zoom levels. A sample that the drawing dropped is still reachable by keyboard and in the table | D8, D9 |\n | F6 | Numbers and dates are formatted for the page locale. Ticks and readouts are formatted separately: ticks may be compact (`50K`); tooltip, table and announcements show the full integer part, and the fraction with up to six significant digits not counting the fraction's leading zeros (`123,456.75`; `0.000123456`; `0.1 + 0.2` reads `0.3`), with the unit. A custom formatter that throws falls back to the default and raises a diagnostic. | Expected strings for chosen values (large integers, small decimals, percentages, zoned times) in `en-US`, `de-DE` and `en-IN` | R4 |\n-| F7 | Domains follow one order of precedence: the zoomed view is inside the author's `domain` if given, otherwise inside the automatic domain. The automatic domain contains all data, reference lines and stack totals, and ends at the first tick at or beyond each extreme. A field declared `scale: 'percent'` (0–100) or `'ratio'` (0–1) ends at full scale only when its maximum is at least half of full scale and not above it. Nothing is inferred from a label. | Property tests; `bars` ends at 100 when declared `percent`; a 4% maximum ends at the first tick at or above 4% | R1 |\n+| F7 | Domains follow one order of precedence: the zoomed view is inside the author's `domain` if given, otherwise inside the automatic domain. The automatic domain contains all data, the reference lines and bands the chart draws (a compact chart draws none, so `reference` has no effect there and is reported as an option that does not apply) and stack totals, and ends at the first tick at or beyond each extreme. A field declared `scale: 'percent'` (0–100) or `'ratio'` (0–1) ends at full scale only when its maximum is at least half of full scale and not above it. Nothing is inferred from a label. | Property tests; `bars` ends at 100 when declared `percent`; a 4% maximum ends at the first tick at or above 4% | R1 |\n | F8 | Donut: slices keep the given order, start at 12 o'clock and run clockwise. The legend shows every slice's value and percentage as text, in slice order. A zero slice is listed without an arc; a `null` slice is listed as \"No data\". A negative value is AX120 and the chart shows its error state. With more than eight slices that have an arc (a positive value), the seven largest are drawn and the rest of those are grouped as \"Other (n)\", with AX121; zero and `null` slices never count toward the limit and are never grouped, so each stays listed on its own; the table lists every category. Shares are shown with at most one fraction digit. An all-zero donut shows the empty state. | `parts` fixture; one test per case | R7, landscape scoreboard 3.1 |\n | F9 | Up to eight series, no two share a color. Beyond eight, each series still has a unique combination of color and dash or marker (for bars: color and fill pattern, which gives 32 distinct combinations; beyond 32 bar series combinations repeat), and AX130 is raised. | Tests with 6, 8 and 12 series | R7 |\n | F10 | Stacks place positive and negative values on their own sides of zero, and the axis covers both totals. The readout's total is the sum when every component has the same sign; when signs are mixed it gives the positive total and the negative total, the two ends the reader sees, not their net. A missing component is drawn with zero height and the stack is marked \"incomplete\" in tooltip, table and announcements. | Property test on stacked geometry; mixed-sign and incomplete fixtures | R5 |\ndiff --git a/packages/axylo/test/view/view.test.ts b/packages/axylo/test/view/view.test.ts\nindex ff9cff9..8bb4b4d 100644\n--- a/packages/axylo/test/view/view.test.ts\n+++ b/packages/axylo/test/view/view.test.ts\n@@ -98,6 +98,21 @@ describe('view domains and visibility', () => {\n     expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX107', field: 'reference[2].x' })]);\n   });\n \n+  it.each(['line', 'area', 'bar'] as const)('keeps compact %s domains independent of references', kind => {\n+    const { frame, view } = aligned({ x: 'x', y: 'y', data: [{ x: 1, y: 2 }, { x: 2, y: 4 }] }, { kind });\n+    expect(view.yDomain).toEqual(kind === 'line' ? [2, 4] : [0, 4]);\n+    const value = fc.integer({ min: 100, max: 10_000 });\n+    fc.assert(fc.property(value, value, (x, y) => {\n+      const sink = new DiagnosticCollector();\n+      const references = [{ x: [x, x + 1] as const, y, label: 'Target' }, { y: Infinity, label: 'Invalid' }];\n+      const compact = buildView(frame, { kind, compact: true, references, previous: view }, sink);\n+      expect(compact.xDomain).toEqual(view.xDomain);\n+      expect(compact.yDomain).toEqual(view.yDomain);\n+      expect(compact.references).toEqual([]);\n+      expect(sink.inputs()).toEqual([]);\n+    }));\n+  });\n+\n   it('matches the normalization rules for instants, wall times and category names', () => {\n     const instant = aligned({\n       x: { field: 'x', type: 'time' }, y: 'y', data: [{ x: '2026-02-24T05:00:00-05:00', y: 3 }],\n","exit_code":0,"status":"completed"}}
