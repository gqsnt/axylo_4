e a single y field when naming a series field.' });\ndiff --git a/packages/axylo/src/reader/index.ts b/packages/axylo/src/reader/index.ts\nindex 362df12..0c59347 100644\n--- a/packages/axylo/src/reader/index.ts\n+++ b/packages/axylo/src/reader/index.ts\n@@ -218,7 +218,7 @@ export function buildReader(input: ReaderInput): ReaderModel & { readonly noteSe\n   const name = labelledBy ? '' : titleText || generated;\n   const compact = input.compact === true || (view.kind !== 'donut' && view.compact);\n   let references: string[] | undefined;\n-  const referencesForView = () => references ??= referenceText(view, formatters, messages);\n+  const referencesForView = () => references ??= compact ? [] : referenceText(view, formatters, messages);\n   const caption = [input.caption, name, generated, messages.plotLabel].find(text => text?.trim()) ?? defaultMessages.plotLabel;\n   const table = input.table === false || compact ? null : buildTable(\n     view, [caption, ...referencesForView()].join(' '), formatters, messages, labels, input.locale,\ndiff --git a/packages/axylo/src/view/index.ts b/packages/axylo/src/view/index.ts\nindex e7e9c81..2f6a723 100644\n--- a/packages/axylo/src/view/index.ts\n+++ b/packages/axylo/src/view/index.ts\n@@ -317,7 +317,7 @@ export function buildView(frame: Frame, state: ViewState, sink: DiagnosticSink):\n   const seriesCues = cues(frame.series.length, compact, prior, sink);\n   const column = frame.shape === 'aligned' ? frame.x : { kind: frame.xKind, timeZone: frame.timeZone, categories: null };\n   const readX = positionReader(column, state.xField);\n-  const references = reuse(resolveReferences(state.references ?? [], readX, column.kind, sink), prior?.references,\n+  const references = reuse(compact ? [] : resolveReferences(state.references ?? [], readX, column.kind, sink), prior?.references,\n     (a, b) => a.axis === b.axis && a.from === b.from && a.to === b.to && a.label === b.label);\n   const category = column.kind === 'category';\n   const