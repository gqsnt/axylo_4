{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'nl -ba research/palette/strokes.mjs && nl -ba research/palette/score.mjs'","aggregated_output":"     1\t// Effective contrast of a 2 px line as Chrome renders it. Antialiasing blends a thin stroke's edge pixels with\n     2\t// the background, so a line reads lighter (on white) or darker (on dark) than its swatch. For each series color\n     3\t// this draws a random-walk polyline like a real data line (every angle, sub-pixel positions) at 2 CSS px through\n     4\t// the 2D canvas and through SVG (rasterized by drawing the SVG into a canvas), at device pixel ratios 1 and 2,\n     5\t// and reads the pixels back. Per pixel column it derives each pixel's coverage (how far the pixel moved from the\n     6\t// background toward the stroke color) and reports two colors for the cross-section:\n     7\t//   core      the most covered pixel (the darkest one on white);\n     8\t//   weighted  the coverage-weighted mean of the pixels the stroke touches, bg + (Σc² / Σc)(ink − bg), which is\n     9\t//             what the eye averages when the line is too thin to resolve its edge.\n    10\t// For each, the 10th percentile and the median contrast over all columns.\n    11\t//\n    12\t//   node research/palette/strokes.mjs [--out=research/palette/strokes.json]\n    13\timport fs from 'node:fs';\n    14\timport path from 'node:path';\n    15\timport { fileURLToPath } from 'node:url';\n    16\timport { chromium } from 'playwright-core';\n    17\timport { contrast, srgb, toHex } from './color.mjs';\n    18\timport { readThemeFile } from './theme-file.mjs';\n    19\t\n    20\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    21\tconst args = Object.fromEntries(process.argv.slice(2).map(a => a.replace(/^--/, '').split('=')).map(([k, v]) => [k, v ?? 'true']));\n    22\tconst theme = readThemeFile();\n    23\t\n    24\tconst browser = await chromium.launch({ channel: 'chrome', headless: true });\n    25\tconst page = await browser.newPage();\n    26\tawait page.setContent('<!doctype html><html><body></body></html>');\n    27\tconst result = {\n    28\t  method: 'random-walk polyline (120 points over 600 CSS px, steps up to ±9 px), stroke width 2, round joins; per pixel column, '\n    29\t    + 'core = most covered pixel, weighted = coverage-weighted mean of touched pixels (coverage > 0.02); p10 and median over columns',\n    30\t  chrome: browser.version(), schemes: {},\n    31\t};\n    32\t\n    33\tfor (const scheme of ['light', 'dark']) {\n    34\t  const t = theme[scheme], rows = [];\n    35\t  for (const color of t.series) {\n    36\t    const columns = await page.evaluate(async ({ color, bg }) => {\n    37\t      const hex = h => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));\n    38\t      const ink = hex(color), back = hex(bg);\n    39\t      const ch = [0, 1, 2].reduce((m, i) => (Math.abs(ink[i] - back[i]) > Math.abs(ink[m] - back[m]) ? i : m), 0);\n    40\t      const Wd = 600, Ht = 140, N = 120;\n    41\t      let s = 12345; const r = () => { s = (s * 1103515245 + 12345) & 0x7fffffff; return s / 0x7fffffff; };\n    42\t      const pts = []; let y = 70.37;\n    43\t      for (let i = 0; i < N; i++) { y = Math.min(Ht - 12, Math.max(12, y + (r() - 0.5) * 18)); pts.push([10.21 + i * (Wd - 20) / (N - 1), y]); }\n    44\t      const d = pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(3) + ' ' + p[1].toFixed(3)).join('');\n    45\t      const out = {};\n    46\t      for (const dpr of [1, 2]) for (const via of ['canvas', 'svg']) {\n    47\t        const c = document.createElement('canvas'); c.width = Wd * dpr; c.height = Ht * dpr;\n    48\t        const g = c.getContext('2d');\n    49\t        g.fillStyle = bg; g.fillRect(0, 0, c.width, c.height);\n    50\t        if (via === 'canvas') {\n    51\t          g.scale(dpr, dpr); g.strokeStyle = color; g.lineWidth = 2; g.lineJoin = 'round';\n    52\t          g.beginPath(); pts.forEach((p, i) => (i ? g.lineTo(p[0], p[1]) : g.moveTo(p[0], p[1]))); g.stroke();\n    53\t        } else {\n    54\t          const svg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"' + Wd * dpr + '\" height=\"' + Ht * dpr + '\" viewBox=\"0 0 ' + Wd + ' ' + Ht + '\"><path d=\"' + d + '\" fill=\"none\" stroke=\"' + color + '\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg>';\n    55\t          const img = new Image(); img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg); await img.decode();\n    56\t          g.drawImage(img, 0, 0);\n    57\t        }\n    58\t        const px = g.getImageData(0, 0, c.width, c.height).data, cols = [];\n    59\t        for (let x = 12 * dpr; x < (Wd - 12) * dpr; x++) {\n    60\t          const cov = [];\n    61\t          for (let yy = 0; yy < c.height; yy++) { const v = (px[(yy * c.width + x) * 4 + ch] - back[ch]) / (ink[ch] - back[ch]); if (v > 0.02) cov.push(Math.min(1, v)); }\n    62\t          cols.push(cov);\n    63\t        }\n    64\t        out[via + '@' + dpr] = cols;\n    65\t      }\n    66\t      return out;\n    67\t    }, { color, bg: t.background });\n    68\t    const ink = srgb(color), bg = srgb(t.background);\n    69\t    const at = k => contrast(toHex(ink.map((v, i) => bg[i] + k * (v - bg[i]))), t.background);\n    70\t    const stats = xs => { xs.sort((a, b) => a - b); return { p10: +xs[Math.floor(xs.length * 0.1)].toFixed(2), median: +xs[Math.floor(xs.length / 2)].toFixed(2) }; };\n    71\t    const row = { color, swatch: +contrast(color, t.background).toFixed(2) };\n    72\t    for (const [k, cols] of Object.entries(columns)) {\n    73\t      const used = cols.filter(cv => cv.length);\n    74\t      row[k] = {\n    75\t        core: stats(used.map(cv => at(Math.max(...cv)))),\n    76\t        weighted: stats(used.map(cv => at(cv.reduce((a, x) => a + x * x, 0) / cv.reduce((a, x) => a + x, 0)))),\n    77\t      };\n    78\t    }\n    79\t    rows.push(row);\n    80\t    console.log(scheme, color, JSON.stringify(row));\n    81\t  }\n    82\t  result.schemes[scheme] = { background: t.background, rows };\n    83\t}\n    84\tawait browser.close();\n    85\tfs.writeFileSync(args.out ?? path.join(here, 'strokes.json'), JSON.stringify(result, null, 1) + '\\n');\n     1\t// Scores the palette that ships (packages/axylo/src/theme/palette.ts) against the hard constraints of decision\n     2\t// 0003 and writes the record the decision quotes, research/palette/palette.json. The unit test\n     3\t// (packages/axylo/test/theme/palette.test.ts) recomputes every value with its own code and compares.\n     4\t//\n     5\t//   node research/palette/score.mjs [--md]     (--md also prints the tables of the decision record)\n     6\timport fs from 'node:fs';\n     7\timport path from 'node:path';\n     8\timport { fileURLToPath } from 'node:url';\n     9\timport { THRESHOLDS as T, TOKEN_NAMES, VISIONS, checkScheme, lch } from './color.mjs';\n    10\timport { readThemeFile } from './theme-file.mjs';\n    11\t\n    12\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    13\tconst md = process.argv.includes('--md');\n    14\tconst theme = readThemeFile();\n    15\tconst r3 = x => +x.toFixed(3);\n    16\t\n    17\tconst record = { thresholds: T, schemes: {} };\n    18\tfor (const [name, other] of [['light', 'dark'], ['dark', 'light']]) {\n    19\t  const s = theme[name], { checks, measured: m } = checkScheme(s, theme[other]);\n    20\t  record.schemes[name] = {\n    21\t    background: s.background,\n    22\t    tokens: Object.fromEntries(['axis', 'grid', 'muted', 'reference', 'focus'].map(k => [k, s[k]])),\n    23\t    series: s.series.map((hex, k) => ({ slot: k + 1, hex, oklch: lch(hex).map((v, i) => +v.toFixed(i === 2 ? 1 : 3)), contrast: +m.contrast[k].toFixed(2), hueDiffToOtherScheme: +m.hue[k].toFixed(1) })),\n    24\t    minDelta: Object.fromEntries(VISIONS.map(v => [v, { min: r3(m.full[v].min), pair: m.full[v].pair.map(i => i + 1) }])),\n    25\t    prefixes: Object.fromEntries(T.prefixes.map(n => [n, Object.fromEntries(VISIONS.map(v => [v, { min: r3(m.prefixes[n][v].min), pair: m.prefixes[n][v].pair.map(i => i + 1) }]))])),\n    26\t    tokenDistance: Object.fromEntries(TOKEN_NAMES.map(t => [t, { min: r3(m.tokens[t].min), slot: m.tokens[t].slot + 1 }])),\n    27\t    composites: Object.fromEntries(T.alphas.map(a => [a, Object.fromEntries(VISIONS.map(v => [v, {\n    28\t      minNeighbour: r3(m.composites[a][v].minNeighbour.d), pair: m.composites[a][v].minNeighbour.pair.map(i => i + 1),\n    29\t      neighbours: m.composites[a][v].neighbours.map(x => r3(x.d)),\n    30\t      ringClosures: m.composites[a][v].ring.map(x => ({ slots: [x.pair[0] + 1, 1], d: r3(x.d) })),\n    31\t    }]))])),\n    32\t    checks: checks.map(c => ({ constraint: c.id, check: c.label, value: r3(c.value), limit: c.limit, ok: c.ok })),\n    33\t  };\n    34\t}\n    35\tconst strokes = path.join(here, 'strokes.json');\n    36\tif (fs.existsSync(strokes)) record.strokes = JSON.parse(fs.readFileSync(strokes, 'utf8'));\n    37\tfs.writeFileSync(path.join(here, 'palette.json'), JSON.stringify(record, null, 1) + '\\n');\n    38\t\n    39\tconst failed = Object.values(record.schemes).flatMap(s => s.checks.filter(c => !c.ok));\n    40\tconsole.log(failed.length ? `FAILED: ${failed.map(c => c.check).join('; ')}` : 'all hard constraints met');\n    41\tif (md) {\n    42\t  const L = record.schemes.light, D = record.schemes.dark, f = x => x.toFixed(3);\n    43\t  console.log('\\n| Constraint | Check | Limit | Light | Dark |\\n|---|---|---|---|---|');\n    44\t  L.checks.forEach((c, i) => { const d = D.checks[i]; console.log(`| ${c.constraint} | ${c.check} | ${c.constraint === 4 ? '≤ ' : '≥ '}${c.limit} | ${c.constraint === 1 ? c.value.toFixed(2) : c.constraint === 4 ? c.value.toFixed(1) : f(c.value)} | ${d.constraint === 1 ? d.value.toFixed(2) : d.constraint === 4 ? d.value.toFixed(1) : f(d.value)} |`); });\n    45\t  console.log('\\n| Prefix | Vision | Light (pair) | Dark (pair) |\\n|---|---|---|---|');\n    46\t  for (const n of T.prefixes) for (const v of VISIONS) console.log(`| first ${n} | ${v} | ${f(L.prefixes[n][v].min)} (${L.prefixes[n][v].pair.join('–')}) | ${f(D.prefixes[n][v].min)} (${D.prefixes[n][v].pair.join('–')}) |`);\n    47\t  for (const v of VISIONS) console.log(`| all 8 | ${v} | ${f(L.minDelta[v].min)} (${L.minDelta[v].pair.join('–')}) | ${f(D.minDelta[v].min)} (${D.minDelta[v].pair.join('–')}) |`);\n    48\t}\n    49\tprocess.exitCode = failed.length ? 1 : 0;\n","exit_code":0,"status":"completed"}}
