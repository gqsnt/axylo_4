{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'git show 51e1be5:research/palette/explore.mjs | nl -ba'","aggregated_output":"     1\t// Which hue families, and which orders of them, can meet the hard constraints of decision 0003 at all?\n     2\t// Uses the grid and branch-and-bound search of fit.mjs on the light scheme, which is the tighter one.\n     3\t//\n     4\t//   node research/palette/explore.mjs sets [--part=0 --parts=1]\n     5\t//       Every set of eight families (blue plus seven of POOL) that has an orange, a purple, a green or teal and a\n     6\t//       red, pink or magenta: can the eight be placed at least 0.10 apart under all four visions, with 3:1 on white\n     7\t//       and clear of the tokens? (No order yet: no prefix or neighbour constraints.)\n     8\t//   node research/palette/explore.mjs orders --set=blue,orange,... [--part=0 --parts=1 --seconds=1]\n     9\t//       Every order of a set with blue first. Orders whose first four cannot reach 0.14 are skipped; the others get\n    10\t//       the full search (prefixes and neighbour composites included) with a time limit.\n    11\t//\n    12\t// Prints one line per set or order: OK with the cost and colors of the cheapest palette found, \"no\" when the\n    13\t// search proved that none exists on the grid, \"??\" when it ran out of time without either.\n    14\timport { candidates, compatible, search, SCHEME_TOKENS } from './fit.mjs';\n    15\timport { THRESHOLDS as T, dist } from './color.mjs';\n    16\t\n    17\tconst args = Object.fromEntries(process.argv.slice(3).map(a => a.replace(/^--/, '').split('=')).map(([k, v]) => [k, v ?? 'true']));\n    18\tconst mode = process.argv[2], part = +(args.part ?? 0), parts = +(args.parts ?? 1);\n    19\tconst tokens = SCHEME_TOKENS.light, LW = [0.38, 0.70];\n    20\t\n    21\t// Target and box per family, light scheme. Targets are where a designer would put the color if nothing else\n    22\t// mattered; the boxes are wide so that the search, not the target, decides what is possible.\n    23\texport const POOL = {\n    24\t  blue: { target: [0.63, 0.14, 252], L: [0.58, 0.70], C: [0.10, 0.17], hr: 10 },\n    25\t  orange: { target: [0.64, 0.15, 52], L: LW, C: [0.10, 0.18], hr: 10 },\n    26\t  green: { target: [0.50, 0.12, 145], L: LW, C: [0.08, 0.16], hr: 14 },\n    27\t  teal: { target: [0.55, 0.10, 185], L: LW, C: [0.07, 0.14], hr: 15 },\n    28\t  cyan: { target: [0.60, 0.11, 222], L: LW, C: [0.07, 0.15], hr: 12 },\n    29\t  red: { target: [0.55, 0.15, 25], L: LW, C: [0.10, 0.18], hr: 10 },\n    30\t  pink: { target: [0.60, 0.14, 0], L: LW, C: [0.09, 0.17], hr: 10 },\n    31\t  magenta: { target: [0.50, 0.15, 335], L: LW, C: [0.10, 0.18], hr: 12 },\n    32\t  purple: { target: [0.52, 0.15, 300], L: LW, C: [0.10, 0.18], hr: 12 },\n    33\t  gold: { target: [0.62, 0.12, 82], L: LW, C: [0.07, 0.15], hr: 12 },\n    34\t  brown: { target: [0.48, 0.09, 58], L: LW, C: [0.05, 0.12], hr: 14 },\n    35\t  slate: { target: [0.60, 0.03, 255], L: LW, C: [0.0, 0.045], hr: 35, neutral: true },\n    36\t};\n    37\tconst domain = name => candidates(0, { ...POOL[name], step: [0.01, 0.01, 3] }, tokens, null);\n    38\tconst line = (r, names) => console.log(r.best ? 'OK ' : (r.complete ? 'no ' : '?? '), r.best ? r.cost.toFixed(2).padStart(6) : '     -', names.join(','), r.best ? r.best.map(x => x.hex).join(' ') : '', r.best && !r.complete ? '(best within time limit)' : '');\n    39\t\n    40\tif (mode === 'sets') {\n    41\t  const doms = Object.fromEntries(Object.keys(POOL).map(k => [k, domain(k)]));\n    42\t  const uniform = (i, a, j, b) => { for (let v = 0; v < 4; v++) if (dist(a.labs[v], b.labs[v]) < T.minDelta) return false; return true; };\n    43\t  const others = Object.keys(POOL).filter(k => k !== 'blue'), combos = [];\n    44\t  const pick = (start, acc) => { if (acc.length === 7) { combos.push(acc.slice()); return; } for (let i = start; i < others.length; i++) { acc.push(others[i]); pick(i + 1, acc); acc.pop(); } };\n    45\t  pick(0, []);\n    46\t  const required = c => c.includes('orange') && c.includes('purple') && (c.includes('green') || c.includes('teal')) && (c.includes('red') || c.includes('pink') || c.includes('magenta'));\n    47\t  combos.filter(required).forEach((c, i) => {\n    48\t    if (i % parts !== part) return;\n    49\t    const fams = ['blue', ...c];\n    50\t    line(search(fams.map(f => doms[f]), +(args.seconds ?? 3), uniform), fams);\n    51\t  });\n    52\t} else if (mode === 'orders') {\n    53\t  const fams = args.set.split(','), doms = Object.fromEntries(fams.map(k => [k, domain(k)]));\n    54\t  const four = (i, a, j, b) => { for (let v = 0; v < 4; v++) if (dist(a.labs[v], b.labs[v]) < T.prefix4) return false; return true; };\n    55\t  const firstFour = new Map(), perms = [];\n    56\t  const permute = (a, k = 0) => { if (k === a.length) { perms.push(a.slice()); return; } for (let i = k; i < a.length; i++) { [a[k], a[i]] = [a[i], a[k]]; permute(a, k + 1); [a[k], a[i]] = [a[i], a[k]]; } };\n    57\t  permute(fams.slice(1));\n    58\t  for (let p = part; p < perms.length; p += parts) {\n    59\t    const order = [fams[0], ...perms[p]], key = order.slice(0, 4).sort().join();\n    60\t    if (!firstFour.has(key)) firstFour.set(key, !!search(order.slice(0, 4).map(f => doms[f]), 2, four).best);\n    61\t    if (!firstFour.get(key)) continue;\n    62\t    const r = search(order.map(f => doms[f]), +(args.seconds ?? 1), compatible);\n    63\t    if (r.best) line(r, order);\n    64\t  }\n    65\t  console.error(`first-four sets that reach 0.14: ${[...firstFour].filter(([, v]) => v).map(([k]) => k).join(' | ')}`);\n    66\t} else {\n    67\t  console.error('usage: explore.mjs sets | orders --set=a,b,...');\n    68\t  process.exitCode = 2;\n    69\t}\n","exit_code":0,"status":"completed"}}
