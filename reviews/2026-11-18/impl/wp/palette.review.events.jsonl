{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc 'nl -ba research/palette/color.mjs'","aggregated_output":"     1\t// Pure color math and the palette constraints of decision 0003, shared by the solver, the scorer and the\n     2\t// preview. No dependencies, no I/O. The formulas match research/harness/palette.mjs, which scored the ten\n     3\t// libraries in finding R7: WCAG 2 relative luminance and contrast; OKLab (Ottosson 2020); color-vision\n     4\t// deficiency simulated with the Machado, Oliveira and Fernandes (2009) matrices at severity 1.0, applied in\n     5\t// linear RGB and clamped to [0, 1] before the OKLab conversion.\n     6\t\n     7\texport const lin = v => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);\n     8\texport const gam = v => (v <= 0.0031308 ? 12.92 * v : 1.055 * v ** (1 / 2.4) - 0.055);\n     9\tconst clamp01 = v => (v < 0 ? 0 : v > 1 ? 1 : v);\n    10\t\n    11\t/** '#rrggbb' -> gamma-encoded sRGB channels in [0, 1]. */\n    12\texport const srgb = hex => [1, 3, 5].map(i => parseInt(hex.slice(i, i + 2), 16) / 255);\n    13\t/** Gamma-encoded sRGB in [0, 1] -> '#rrggbb' (clamped, rounded). */\n    14\texport const toHex = rgb => '#' + rgb.map(v => Math.round(255 * clamp01(v)).toString(16).padStart(2, '0')).join('');\n    15\texport const linear = hex => srgb(hex).map(lin);\n    16\t\n    17\texport const luminance = hex => { const [r, g, b] = linear(hex); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };\n    18\texport const contrast = (a, b) => { const [x, y] = [luminance(a), luminance(b)].sort((p, q) => q - p); return (x + 0.05) / (y + 0.05); };\n    19\t\n    20\t/** Linear sRGB -> OKLab [L, a, b]. */\n    21\texport function oklab([r, g, b]) {\n    22\t  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);\n    23\t  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);\n    24\t  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);\n    25\t  return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,\n    26\t    1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,\n    27\t    0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];\n    28\t}\n    29\t\n    30\t/** OKLab -> linear sRGB (may be out of gamut). */\n    31\texport function oklabToLinear([L, a, b]) {\n    32\t  const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;\n    33\t  const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;\n    34\t  const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;\n    35\t  return [4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,\n    36\t    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,\n    37\t    -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s];\n    38\t}\n    39\t\n    40\t/** OKLCH (hue in degrees) -> '#rrggbb', or null when outside the sRGB gamut. */\n    41\texport function lchToHex([L, C, h]) {\n    42\t  const rad = h * Math.PI / 180;\n    43\t  const rgb = oklabToLinear([L, C * Math.cos(rad), C * Math.sin(rad)]);\n    44\t  if (!rgb.every(v => v >= -1e-4 && v <= 1 + 1e-4)) return null;\n    45\t  return toHex(rgb.map(v => gam(clamp01(v))));\n    46\t}\n    47\t\n    48\t/** '#rrggbb' -> OKLCH [L, C, h°]. */\n    49\texport function lch(hex) {\n    50\t  const [L, a, b] = oklab(linear(hex));\n    51\t  const h = (Math.atan2(b, a) * 180 / Math.PI + 360) % 360;\n    52\t  return [L, Math.hypot(a, b), h];\n    53\t}\n    54\t\n    55\texport const hueDiff = (h1, h2) => { const d = Math.abs(h1 - h2) % 360; return d > 180 ? 360 - d : d; };\n    56\t\n    57\texport const CVD = {\n    58\t  normal: [[1, 0, 0], [0, 1, 0], [0, 0, 1]],\n    59\t  protan: [[0.152286, 1.052583, -0.204868], [0.114503, 0.786281, 0.099216], [-0.003882, -0.048116, 1.051998]],\n    60\t  deutan: [[0.367322, 0.860646, -0.227968], [0.280085, 0.672501, 0.047413], [-0.011820, 0.042940, 0.968881]],\n    61\t  tritan: [[1.255528, -0.076749, -0.178779], [-0.078411, 0.930809, 0.147602], [0.004733, 0.691367, 0.303900]],\n    62\t};\n    63\texport const VISIONS = Object.keys(CVD);\n    64\t\n    65\t/** Linear RGB as seen under a vision (clamped), for previews and grayscale. */\n    66\texport const simulateLinear = (rgbLin, vision) => CVD[vision].map(row => clamp01(row[0] * rgbLin[0] + row[1] * rgbLin[1] + row[2] * rgbLin[2]));\n    67\t/** OKLab of a hex color under a vision. */\n    68\texport const labUnder = (hex, vision) => oklab(simulateLinear(linear(hex), vision));\n    69\texport const dist = (p, q) => Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]);\n    70\texport const distUnder = (h1, h2, vision) => dist(labUnder(h1, vision), labUnder(h2, vision));\n    71\t\n    72\t/** Source-over compositing of `hex` at `alpha` over an opaque background, in gamma-encoded sRGB as browsers do. */\n    73\texport function compositeHex(hex, alpha, bgHex) {\n    74\t  const f = srgb(hex), b = srgb(bgHex);\n    75\t  return toHex(f.map((v, i) => v * alpha + b[i] * (1 - alpha)));\n    76\t}\n    77\t/** The same without rounding to 8 bits, so measurements do not depend on the rounding of the composite. */\n    78\texport function compositeLinear(hex, alpha, bgHex) {\n    79\t  const f = srgb(hex), b = srgb(bgHex);\n    80\t  return f.map((v, i) => lin(v * alpha + b[i] * (1 - alpha)));\n    81\t}\n    82\t\n    83\t/** Smallest pairwise OKLab distance under one vision, with the pair. */\n    84\texport function minPair(colors, vision) {\n    85\t  const labs = colors.map(c => labUnder(c, vision));\n    86\t  let min = Infinity, pair = null;\n    87\t  for (let i = 0; i < labs.length; i++) for (let j = i + 1; j < labs.length; j++) {\n    88\t    const d = dist(labs[i], labs[j]);\n    89\t    if (d < min) { min = d; pair = [i, j]; }\n    90\t  }\n    91\t  return { min, pair };\n    92\t}\n    93\t\n    94\t/** Adjacent pairs of a stacked area or donut with `n` parts: k and k+1, and the closing pair (n, 1) of a ring. */\n    95\texport function neighbourPairs(n) {\n    96\t  const pairs = [];\n    97\t  for (let k = 0; k + 1 < n; k++) pairs.push([k, k + 1]);\n    98\t  return pairs;\n    99\t}\n   100\texport function ringClosures(n) {\n   101\t  const pairs = [];\n   102\t  for (let m = 3; m <= n; m++) pairs.push([m - 1, 0]);\n   103\t  return pairs;\n   104\t}\n   105\t\n   106\t// Tokens no series color may come within THRESHOLDS.token of: focus and reference (constraint 5) and muted,\n   107\t// which paints the donut's \"Other\" slice beside series slices.\n   108\texport const TOKEN_NAMES = ['focus', 'reference', 'muted'];\n   109\t\n   110\texport const THRESHOLDS = {\n   111\t  contrast: 3,\n   112\t  minDelta: 0.10,\n   113\t  prefix4: 0.14,\n   114\t  hueMatch: 30,\n   115\t  token: 0.10,\n   116\t  composite: 0.06,\n   117\t  alphas: [0.25, 0.8],\n   118\t  prefixes: [3, 4, 5, 6],\n   119\t};\n   120\t\n   121\t/**\n   122\t * Every measured quantity of constraints 1–6 for one scheme. `scheme` is { background, focus, reference, series }.\n   123\t * `other` is the other scheme, for the hue match (constraint 4), optional.\n   124\t */\n   125\texport function measureScheme(scheme, other) {\n   126\t  const { background: bg, series } = scheme;\n   127\t  const contrastBy = series.map(c => contrast(c, bg));\n   128\t  const full = Object.fromEntries(VISIONS.map(v => [v, minPair(series, v)]));\n   129\t  const prefixes = Object.fromEntries(THRESHOLDS.prefixes.map(n => [n, Object.fromEntries(VISIONS.map(v => [v, minPair(series.slice(0, n), v)]))]));\n   130\t  const tokens = {};\n   131\t  for (const t of TOKEN_NAMES) {\n   132\t    const d = series.map(c => distUnder(c, scheme[t], 'normal'));\n   133\t    const k = d.indexOf(Math.min(...d));\n   134\t    tokens[t] = { min: d[k], slot: k };\n   135\t  }\n   136\t  const composites = {};\n   137\t  for (const alpha of THRESHOLDS.alphas) {\n   138\t    const labs = Object.fromEntries(VISIONS.map(v => [v, series.map(c => oklab(simulateLinear(compositeLinear(c, alpha, bg), v)))]));\n   139\t    const at = (pairs, v) => pairs.map(([i, j]) => ({ pair: [i, j], d: dist(labs[v][i], labs[v][j]) }));\n   140\t    composites[alpha] = Object.fromEntries(VISIONS.map(v => {\n   141\t      const nb = at(neighbourPairs(series.length), v), ring = at(ringClosures(series.length), v);\n   142\t      const lo = list => list.reduce((m, x) => (x.d < m.d ? x : m), { d: Infinity, pair: null });\n   143\t      return [v, { neighbours: nb, ring, minNeighbour: lo(nb), minRing: lo(ring) }];\n   144\t    }));\n   145\t  }\n   146\t  const hue = other ? series.map((c, k) => hueDiff(lch(c)[2], lch(other.series[k])[2])) : null;\n   147\t  return { contrast: contrastBy, full, prefixes, tokens, composites, hue };\n   148\t}\n   149\t\n   150\t/** The hard constraints as a list of { id, ok, value, limit, label } for one scheme. */\n   151\texport function checkScheme(scheme, other) {\n   152\t  const m = measureScheme(scheme, other), T = THRESHOLDS, out = [];\n   153\t  out.push({ id: 1, label: 'lowest contrast on background', value: Math.min(...m.contrast), limit: T.contrast });\n   154\t  for (const v of VISIONS) out.push({ id: 2, label: `min pairwise ΔE (all 8), ${v}`, value: m.full[v].min, limit: T.minDelta });\n   155\t  for (const n of T.prefixes) for (const v of VISIONS) out.push({ id: 3, label: `min pairwise ΔE (first ${n}), ${v}`, value: m.prefixes[n][v].min, limit: n === 4 ? T.prefix4 : T.minDelta });\n   156\t  if (m.hue) out.push({ id: 4, label: 'largest light/dark hue difference per slot (°)', value: Math.max(...m.hue), limit: T.hueMatch, upper: true });\n   157\t  for (const t of TOKEN_NAMES) out.push({ id: 5, label: `nearest series to ${t} token`, value: m.tokens[t].min, limit: T.token });\n   158\t  for (const a of T.alphas) out.push({ id: 6, label: `min neighbour ΔE at ${a * 100}% opacity, normal`, value: m.composites[a].normal.minNeighbour.d, limit: T.composite });\n   159\t  for (const c of out) c.ok = c.upper ? c.value <= c.limit : c.value >= c.limit;\n   160\t  return { checks: out, measured: m };\n   161\t}\n","exit_code":0,"status":"completed"}}
