{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'git show 51e1be5:packages/axylo/test/theme/palette.test.ts | nl -ba'","aggregated_output":"     1\t/**\n     2\t * The default palette (spec A5, L2; decision 0003). Constraints 1–6 of the decision, measured here with code\n     3\t * of this file's own (WCAG 2 contrast; OKLab; Machado et al. 2009 color-vision simulation at severity 1.0 in\n     4\t * linear RGB, clamped, as research/harness/palette.mjs scored the ten libraries), then compared with the record\n     5\t * the research scorer wrote (research/palette/palette.json), so the two implementations check each other and the\n     6\t * numbers in the decision record cannot drift from what ships.\n     7\t */\n     8\timport { describe, expect, it } from 'vitest';\n     9\timport fs from 'node:fs';\n    10\timport path from 'node:path';\n    11\timport { contrastRatio, parseColor, type Rgba } from '../../src/theme/color';\n    12\timport { DARK, LIGHT } from '../../src/theme/palette';\n    13\timport { AXYLO_CSS } from '../../src/theme/css';\n    14\t\n    15\ttype Vec3 = readonly [number, number, number];\n    16\ttype Vision = 'normal' | 'protan' | 'deutan' | 'tritan';\n    17\t\n    18\tconst c = (s: string): Rgba => parseColor(s)!;\n    19\tconst lin = (v: number): number => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);\n    20\tconst clamp01 = (v: number): number => Math.min(1, Math.max(0, v));\n    21\tconst srgb = (hex: string): Vec3 => { const p = c(hex); return [p.r, p.g, p.b]; };\n    22\t\n    23\tfunction oklab([r, g, b]: Vec3): Vec3 {\n    24\t  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);\n    25\t  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);\n    26\t  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);\n    27\t  return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,\n    28\t    1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,\n    29\t    0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];\n    30\t}\n    31\t\n    32\tconst MACHADO: Record<Vision, readonly Vec3[]> = {\n    33\t  normal: [[1, 0, 0], [0, 1, 0], [0, 0, 1]],\n    34\t  protan: [[0.152286, 1.052583, -0.204868], [0.114503, 0.786281, 0.099216], [-0.003882, -0.048116, 1.051998]],\n    35\t  deutan: [[0.367322, 0.860646, -0.227968], [0.280085, 0.672501, 0.047413], [-0.011820, 0.042940, 0.968881]],\n    36\t  tritan: [[1.255528, -0.076749, -0.178779], [-0.078411, 0.930809, 0.147602], [0.004733, 0.691367, 0.303900]],\n    37\t};\n    38\tconst VISIONS = Object.keys(MACHADO) as Vision[];\n    39\t\n    40\t/** OKLab of a gamma-encoded sRGB color as seen with `vision`. */\n    41\tconst seen = (rgb: Vec3, vision: Vision): Vec3 => {\n    42\t  const l = rgb.map(lin) as unknown as Vec3;\n    43\t  return oklab(MACHADO[vision].map(row => clamp01(row[0] * l[0] + row[1] * l[1] + row[2] * l[2])) as unknown as Vec3);\n    44\t};\n    45\tconst delta = (p: Vec3, q: Vec3): number => Math.hypot(p[0] - q[0], p[1] - q[1], p[2] - q[2]);\n    46\tconst hue = (hex: string): number => { const [, a, b] = seen(srgb(hex), 'normal'); return (Math.atan2(b, a) * 180 / Math.PI + 360) % 360; };\n    47\tconst hueDifference = (a: number, b: number): number => { const d = Math.abs(a - b) % 360; return d > 180 ? 360 - d : d; };\n    48\t/** Source-over at `alpha` in gamma-encoded sRGB, as the browser composites a translucent fill. */\n    49\tconst over = (hex: string, alpha: number, bg: string): Vec3 => { const f = srgb(hex), b = srgb(bg); return [0, 1, 2].map(i => f[i]! * alpha + b[i]! * (1 - alpha)) as unknown as Vec3; };\n    50\t\n    51\t/** Smallest pairwise difference among `colors` under `vision`, with the slots (1-based) of the pair. */\n    52\tfunction closest(colors: readonly string[], vision: Vision): { d: number; pair: [number, number] } {\n    53\t  const labs = colors.map(h => seen(srgb(h), vision));\n    54\t  let d = Infinity, pair: [number, number] = [0, 0];\n    55\t  for (let i = 0; i < labs.length; i++) for (let j = i + 1; j < labs.length; j++) {\n    56\t    const x = delta(labs[i]!, labs[j]!);\n    57\t    if (x < d) { d = x; pair = [i + 1, j + 1]; }\n    58\t  }\n    59\t  return { d, pair };\n    60\t}\n    61\t\n    62\tinterface RecordScheme {\n    63\t  background: string;\n    64\t  series: { hex: string; contrast: number }[];\n    65\t  minDelta: Record<Vision, { min: number }>;\n    66\t  prefixes: Record<string, Record<Vision, { min: number }>>;\n    67\t  tokenDistance: Record<string, { min: number }>;\n    68\t  composites: Record<string, Record<Vision, { minNeighbour: number }>>;\n    69\t}\n    70\tconst record = JSON.parse(fs.readFileSync(path.resolve(import.meta.dirname, '../../../../research/palette/palette.json'), 'utf8')) as\n    71\t  { schemes: Record<'light' | 'dark', RecordScheme> };\n    72\t\n    73\tconst SCHEMES = [['light', LIGHT, DARK], ['dark', DARK, LIGHT]] as const;\n    74\t\n    75\tdescribe('scoring code used below', () => {\n    76\t  it('reproduces known OKLab values and leaves grays alone under every simulation', () => {\n    77\t    const white = seen([1, 1, 1], 'normal');\n    78\t    expect(white[0]).toBeCloseTo(1, 4);\n    79\t    expect(Math.hypot(white[1], white[2])).toBeLessThan(1e-4);\n    80\t    // Ottosson's reference value for sRGB red.\n    81\t    const red = seen([1, 0, 0], 'normal');\n    82\t    expect(red[0]).toBeCloseTo(0.6279554, 4);\n    83\t    expect(red[1]).toBeCloseTo(0.2248631, 4);\n    84\t    expect(red[2]).toBeCloseTo(0.1258463, 4);\n    85\t    for (const v of VISIONS) {\n    86\t      const g = seen(srgb('#777777'), v), n = seen(srgb('#777777'), 'normal');\n    87\t      expect(delta(g, n), v).toBeLessThan(0.002);\n    88\t    }\n    89\t    // Deuteranopia collapses red and green toward the same hue: the classic confusion pair gets much closer.\n    90\t    expect(delta(seen(srgb('#d62728'), 'deutan'), seen(srgb('#2ca02c'), 'deutan'))).toBeLessThan(0.5 * delta(seen(srgb('#d62728'), 'normal'), seen(srgb('#2ca02c'), 'normal')));\n    91\t  });\n    92\t});\n    93\t\n    94\tdescribe('default palette (spec A5, decision 0003)', () => {\n    95\t  for (const [name, scheme, other] of SCHEMES) {\n    96\t    const series = scheme.series;\n    97\t\n    98\t    it(`${name}: eight distinct series colors`, () => {\n    99\t      expect(series).toHaveLength(8);\n   100\t      expect(new Set(series).size).toBe(8);\n   101\t      for (const color of series) expect(color).toMatch(/^#[0-9a-f]{6}$/);\n   102\t    });\n   103\t\n   104\t    it(`${name}: 1. every series color reaches 3:1 on the default background`, () => {\n   105\t      const bg = c(scheme.background);\n   106\t      for (const color of series) expect(contrastRatio(c(color), bg), color).toBeGreaterThanOrEqual(3);\n   107\t    });\n   108\t\n   109\t    it(`${name}: 2. the eight are at least 0.10 apart in OKLab under normal vision and simulated protanopia, deuteranopia, tritanopia`, () => {\n   110\t      for (const v of VISIONS) {\n   111\t        const { d, pair } = closest(series, v);\n   112\t        expect(d, `${v}: slots ${pair.join(' and ')}`).toBeGreaterThanOrEqual(0.10);\n   113\t      }\n   114\t    });\n   115\t\n   116\t    it(`${name}: 3. the first three, four, five and six are at least 0.10 apart, the first four at least 0.14`, () => {\n   117\t      for (const n of [3, 4, 5, 6]) for (const v of VISIONS) {\n   118\t        const { d, pair } = closest(series.slice(0, n), v);\n   119\t        expect(d, `first ${n}, ${v}: slots ${pair.join(' and ')}`).toBeGreaterThanOrEqual(n === 4 ? 0.14 : 0.10);\n   120\t      }\n   121\t    });\n   122\t\n   123\t    it(`${name}: 4. slot k is the same hue family in both schemes (OKLCH hue within 30°)`, () => {\n   124\t      series.forEach((color, k) => {\n   125\t        expect(hueDifference(hue(color), hue(other.series[k]!)), `slot ${k + 1}: ${color} / ${other.series[k]}`).toBeLessThanOrEqual(30);\n   126\t      });\n   127\t    });\n   128\t\n   129\t    it(`${name}: 5. no series color is within 0.10 of the focus or reference token (nor muted, the donut's \"Other\" slice)`, () => {\n   130\t      for (const token of ['focus', 'reference', 'muted'] as const) {\n   131\t        const t = seen(srgb(scheme[token]), 'normal');\n   132\t        for (const color of series) expect(delta(seen(srgb(color), 'normal'), t), `${color} vs ${token} ${scheme[token]}`).toBeGreaterThanOrEqual(0.10);\n   133\t      }\n   134\t    });\n   135\t\n   136\t    it(`${name}: 6. neighbours k and k+1 stay 0.06 apart as fills at 25% and 80% over the background`, () => {\n   137\t      for (const alpha of [0.25, 0.8]) {\n   138\t        const labs = series.map(color => seen(over(color, alpha, scheme.background), 'normal'));\n   139\t        for (let k = 0; k + 1 < labs.length; k++) {\n   140\t          expect(delta(labs[k]!, labs[k + 1]!), `${alpha * 100}%: slots ${k + 1} and ${k + 2}`).toBeGreaterThanOrEqual(0.06);\n   141\t        }\n   142\t      }\n   143\t    });\n   144\t\n   145\t    it(`${name}: the research record (research/palette/palette.json) holds these colors and the same measurements`, () => {\n   146\t      const r = record.schemes[name];\n   147\t      expect(r.background).toBe(scheme.background);\n   148\t      expect(r.series.map(s => s.hex)).toEqual([...series]);\n   149\t      series.forEach((color, k) => expect(contrastRatio(c(color), c(scheme.background))).toBeCloseTo(r.series[k]!.contrast, 1));\n   150\t      for (const v of VISIONS) {\n   151\t        expect(closest(series, v).d).toBeCloseTo(r.minDelta[v].min, 3);\n   152\t        for (const n of [3, 4, 5, 6]) expect(closest(series.slice(0, n), v).d).toBeCloseTo(r.prefixes[n]![v].min, 3);\n   153\t      }\n   154\t      for (const token of ['focus', 'reference', 'muted'] as const) {\n   155\t        const t = seen(srgb(scheme[token]), 'normal');\n   156\t        expect(Math.min(...series.map(color => delta(seen(srgb(color), 'normal'), t)))).toBeCloseTo(r.tokenDistance[token]!.min, 3);\n   157\t      }\n   158\t      for (const alpha of [0.25, 0.8]) {\n   159\t        const labs = series.map(color => seen(over(color, alpha, scheme.background), 'normal'));\n   160\t        const min = Math.min(...labs.slice(1).map((l, k) => delta(labs[k]!, l)));\n   161\t        expect(min).toBeCloseTo(r.composites[String(alpha)]!.normal.minNeighbour, 3);\n   162\t      }\n   163\t    });\n   164\t\n   165\t    it(`${name}: token colors meet spec L2 (axis and focus 3:1; muted and reference 4.5:1, they label text)`, () => {\n   166\t      const bg = c(scheme.background);\n   167\t      expect(contrastRatio(c(scheme.axis), bg)).toBeGreaterThanOrEqual(3);\n   168\t      expect(contrastRatio(c(scheme.focus), bg)).toBeGreaterThanOrEqual(3);\n   169\t      expect(contrastRatio(c(scheme.muted), bg)).toBeGreaterThanOrEqual(4.5);\n   170\t      expect(contrastRatio(c(scheme.reference), bg)).toBeGreaterThanOrEqual(4.5);\n   171\t    });\n   172\t  }\n   173\t});\n   174\t\n   175\tdescribe('default stylesheet', () => {\n   176\t  it('defines the light and dark token sets, forced colors and the dash switch', () => {\n   177\t    for (let i = 1; i <= 8; i++) {\n   178\t      // Public names today, private defaults (--axylo-default-series-N) once the review's stylesheet change lands.\n   179\t      expect(AXYLO_CSS).toMatch(new RegExp(`--axylo-(default-)?series-${i}: ${LIGHT.series[i - 1]};`));\n   180\t      expect(AXYLO_CSS).toMatch(new RegExp(`--axylo-(default-)?series-${i}: ${DARK.series[i - 1]};`));\n   181\t      expect(AXYLO_CSS).toContain(`--axylo-series-${i}: CanvasText !important;`);\n   182\t    }\n   183\t    expect(AXYLO_CSS).toContain('.axylo[data-axylo-scheme=\"dark\"]');\n   184\t    expect(AXYLO_CSS).toContain('@media (forced-colors: active)');\n   185\t    expect(AXYLO_CSS).toMatch(/@media \\(prefers-contrast: more\\), \\(forced-colors: active\\) \\{\\s*(\\.axylo )?\\.axylo-svg \\.axylo-dashed \\{ stroke-dasharray: var\\(--axylo-dash-contrast/);\n   186\t    expect(AXYLO_CSS).toContain('--axylo-stylesheet: loaded');\n   187\t  });\n   188\t\n   189\t  it('never sets what scheme detection reads (color-scheme, color, --axylo-background) outside forced colors', () => {\n   190\t    const outsideForced = AXYLO_CSS.replace(/@media \\(forced-colors: active\\) \\{[\\s\\S]*?\\n {2}\\}\\n/, '');\n   191\t    expect(outsideForced).not.toMatch(/color-scheme\\s*:/);\n   192\t    expect(outsideForced).not.toMatch(/--axylo-background\\s*:/);\n   193\t    expect(outsideForced).not.toMatch(/\\.axylo\\s*\\{[^}]*[^-]color\\s*:/);\n   194\t  });\n   195\t\n   196\t  it('keeps the marker that separates the figure module\\'s structure rules from the token and mark part', () => {\n   197\t    const marker = AXYLO_CSS.indexOf('/* structure: added by the figure module');\n   198\t    expect(marker).toBeGreaterThan(AXYLO_CSS.indexOf('.axylo-text'));\n   199\t  });\n   200\t\n   201\t  it('balances its braces', () => {\n   202\t    expect(AXYLO_CSS.split('{').length).toBe(AXYLO_CSS.split('}').length);\n   203\t  });\n   204\t});\n   205\t\n","exit_code":0,"status":"completed"}}
