'/>';\n    85\t    case 'diamond': return '<path d=\"M' + x + ' ' + (y - r - 1) + 'L' + (x + r + 1) + ' ' + y + 'L' + x + ' ' + (y + r + 1) + 'L' + (x - r - 1) + ' ' + y + 'Z\" ' + s + '/>';\n    86\t    case 'cross': return '<path d=\"M' + (x - r) + ' ' + (y - r) + 'L' + (x + r) + ' ' + (y + r) + 'M' + (x + r) + ' ' + (y - r) + 'L' + (x - r) + ' ' + (y + r) + '\" stroke=\"' + c + '\" stroke-width=\"2\"/>';\n    87\t    case 'plus': return '<path d=\"M' + x + ' ' + (y - r - 0.5) + 'V' + (y + r + 0.5) + 'M' + (x - r - 0.5) + ' ' + y + 'H' + (x + r + 0.5) + '\" stroke=\"' + c + '\" stroke-width=\"2\"/>';\n    88\t    default: { let d = ''; for (let i = 0; i < 10; i++) { const a = -Math.PI / 2 + i * Math.PI / 5, rr = i % 2 ? r * 0.5 : r + 1; d += (i ? 'L' : 'M') + (x + rr * Math.cos(a)).toFixed(2) + ' ' + (y + rr * Math.sin(a)).toFixed(2); } return '<path d=\"' + d + 'Z\" ' + s + '/>'; }\n    89\t  }\n    90\t}\n    91\tfunction walks(n, len, seed) {\n    92\t  const r = rng(seed); const out = [];\n    93\t  for (let s = 0; s < n; s++) { let v = 0.2 + 0.6 * r(); const pts = []; for (let i = 0; i < len; i++) { v += (r() - 0.5) * 0.12; v = Math.min(0.95, Math.max(0.05, v)); pts.push(v); } out.push(pts); }\n    94\t  return out;\n    95\t}\n    96\tfunction lines(n, t, cols) {\n    97\t  const data = walks(n, 40, 11 + n), X = i => P + i * (W - 2 * P - 6) / 39, Y = v => P + (1 - v) * (H - 2 * P);\n    98\t  return svg(data.map((pts, s) => '<path d=\"' + pts.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + '\" fill=\"none\" stroke=\"' + cols[s] + '\" stroke-width=\"2\" stroke-linejoin=\"round\"/>'\n    99\t    + marker(SHAPES[s], X(39), Y(pts[39]), cols[s], t.background)).join(''), t);\n   100\t}\n   101\tfunction overlap(t, cols) {\n   102\t  const data = walks(3, 30, 5), X = i => P + i * (W - 2 * P) / 29, Y = v => P + (1 - v) * (H - 2 * P);\n   103\t  return svg(data.map((pts, s) => '<path d=\"M' + X(0) + ' ' + Y(0) + pts.map((v, i) => 'L' + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + 'L' + X(29) + ' ' + Y(0) + 'Z\" fill=\"' + cols[s] + '\" fill-opacity=\"0.25\"/>'\n   104\t    + '<path d=\"' + pts.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + '\" fill=\"none\" stroke=\"' + cols[s] + '\" stroke-width=\"2\"/>').join(''), t);\n   105\t}\n   106\tfunction stacked(t, cols) {\n   107\t  const n = 8, len = 30, r = rng(3), vals = [];\n   108\t  for (let s = 0; s < n; s++) { let v = 0.5 + r(); const a = []; for (let i = 0; i < len; i++) { v = Math.max(0.2, v + (r() - 0.5) * 0.3); a.push(v); } vals.push(a); }\n   109\t  const tot = Array.from({ length: len }, (_, i) => vals.reduce((a, s) => a + s[i], 0)), max = Math.max(...tot) * 1.05;\n   110\t  const X = i => P + i * (W - 2 * P) / (len - 1), Y = v => P + (1 - v / max) * (H - 2 * P);\n   111\t  let lower = Array(len).fill(0), out = '';\n   112\t  for (let s = 0; s < n; s++) {\n   113\t    const upper = lower.map((l, i) => l + vals[s][i]);\n   114\t    out += '<path d=\"' + upper.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + lower.map((v, i) => 'L' + X(len - 1 - i).toFixed(1) + ' ' + Y(lower[len - 1 - i]).toFixed(1)).join('') + 'Z\" fill=\"' + cols[s] + '\" fill-opacity=\"0.8\"/>';\n   115\t    out += '<path d=\"' + upper.map((v, i) => (i ? 'L' : 'M') + X(i).toFixed(1) + ' ' + Y(v).toFixed(1)).join('') + '\" fill=\"none\" stroke=\"' + t.background + '\" stroke-width=\"1\"/>';\n   116\t    lower = upper;\n   117\t  }\n   118\t  return svg(out, t);\n   119\t}\n   120\tfunction donut(t, cols) {\n   121\t  const v = [30, 22, 16, 12, 9, 7, 6, 5], tot = v.reduce((a, b) => a + b, 0), cx = W / 2, cy = H / 2, R = 52, r0 = 31;\n   122\t  let a = -Math.PI / 2, out = '';\n   123\t  v.forEach((x, i) => {\n   124\t    const b = a + 2 * Math.PI * x / tot, large = b - a > Math.PI ? 1 : 0, p = (rr, t) => (cx + rr * Math.cos(t)).toFixed(2) + ' ' + (cy + rr * Math.sin(t)).toFixed(2);\n   125\t    out += '<path d=\"M' + p(R, a) + 'A' + R + ' ' + R + ' 0 ' + large + ' 1 ' + p(R, b) + 'L' + p(r0, b) + 'A' + r0 + ' ' + r0 + ' 0 ' + large + ' 0 ' + p(r0, a) + 'Z\" fill=\"' + cols[i] + '\" stroke=\"' + t.background + '\" stroke-width=\"1\"/>';\n   126\t    a = b;\n   127\t  });\n   128\t  return '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"' + W + '\" height=\"' + H + '\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"' + W + '\" height=\"' + H + '\" fill=\"' + t.background + '\"/>' + out + '</svg>';\n   129\t}\n   130\tfunction bars(t, cols) {\n   131\t  const r = rng(9), groups = 3, n = 6, gw = (W - 2 * P) / groups, bw = (gw - 10) / n;\n   132\t  let out = '';\n   133\t  for (let g = 0; g < groups; g++) for (let s = 0; s < n; s++) { const h = (0.3 + 0.65 * r()) * (H - 2 * P); out += '<rect x=\"' + (P + g * gw + 5 + s * bw).toFixed(1) + '\" y=\"' + (H - P - h).toFixed(1) + '\" width=\"' + (bw - 1).toFixed(1) + '\" height=\"' + h.toFixed(1) + '\" fill=\"' + cols[s] + '\"/>'; }\n   134\t  return svg(out, t);\n   135\t}\n   136\tconst fmt = x => x.toFixed(3);\n   137\tconst root = document.getElementById('root');\n   138\tfor (const scheme of (new URLSearchParams(location.search).get('scheme') || 'light,dark').split(',')) {\n   139\t  const t = THEME[scheme], cols = PALETTE[scheme], st = STATS[scheme];\n   140\t  const ink = scheme === 'light' ? '#1d2129' : '#e6e8ec';\n   141\t  const el = document.createElement('section'); el.className = 'scheme'; el.id = scheme;\n   142\t  el.style.background = t.background; el.style.color = ink;\n   143\t  el.innerHTML = '<h1>' + scheme + ' scheme, background ' + t.background + '</h1>'\n   144\t    + '<div class=\"swatches\">' + st.map((s, i) => '<div class=\"sw\"><div class=\"chip\" style=\"background:' + s.hex + '\"></div><code>' + (i + 1) + ' ' + s.hex + '</code>'\n   145\t      + '<span class=\"meta\">' + s.contrast.toFixed(2) + ':1 · nearest ' + fmt(s.near.normal.d) + ' (' + (s.near.normal.k + 1) + ')</span>'\n 