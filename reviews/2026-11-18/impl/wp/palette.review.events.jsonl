const DARK: SchemeColors = {\n    36\t  background: '#16181d',\n    37\t  axis: '#8b909c',\n    38\t  grid: '#30343c',\n    39\t  muted: '#9da2ad',\n    40\t  reference: '#bcc0c9',\n    41\t  focus: '#79a8ff',\n    42\t  series: ['#1c73c5', '#d77939', '#b0e391', '#bf93f1', '#bc5145', '#71daff', '#fa93b5', '#82828f'],\n    43\t};\n    44\t\n    45\texport const SERIES_COUNT = 8;\n","exit_code":0,"status":"completed"}}
