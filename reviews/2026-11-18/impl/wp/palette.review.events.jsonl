{"type":"item.completed","item":{"id":"item_85","type":"command_execution","command":"/bin/bash -lc 'git show 51e1be5:packages/axylo/test/theme/review.test.ts | head -100 && git show 51e1be5:packages/axylo/test/theme/color.test.ts | head -90 && rg -n -w \"it|test\" packages/axylo/test/theme/*.test.ts | tail -30'","aggregated_output":"/** Regression tests for the render review (reviews/2026-11-18/impl/wp/render.review.md), color math. */\nimport { describe, expect, it } from 'vitest';\nimport { lowContrastSeries } from '../../src/theme/color';\nimport type { ResolvedTheme } from '../../src/core/contracts';\n\nconst theme = (background: string, series: string[]): ResolvedTheme => ({\n  scheme: 'dark', forcedColors: false, moreContrast: false,\n  paints: { tokens: { axis: '', grid: '', reference: '', muted: '', focus: '', background, text: '' }, series },\n});\nconst check = lowContrastSeries as (t: ResolvedTheme, backdrop?: string) => number[];\n\ndescribe('finding 9: contrast is measured over the real backdrop', () => {\n  it('a translucent background over a black panel is measured as composited over that panel', () => {\n    // rgba(0,0,0,0.1) over black is black: black ink on it is 1:1, not the 15:1 a white backdrop would give.\n    expect(check(theme('rgba(0, 0, 0, 0.1)', ['rgb(0, 0, 0)']), 'rgb(0, 0, 0)')).toEqual([0]);\n  });\n\n  it('a transparent background still checks every series against the backdrop', () => {\n    expect(check(theme('rgba(0, 0, 0, 0)', ['rgb(10, 10, 10)', 'rgb(255, 255, 255)']), 'rgb(0, 0, 0)')).toEqual([0]);\n  });\n\n  it('a translucent series color is composited over the background first', () => {\n    expect(lowContrastSeries(theme('rgb(0, 0, 0)', ['rgba(255, 255, 255, 0.1)', 'rgb(255, 255, 255)']))).toEqual([0]);\n  });\n\n  it('without a backdrop a translucent background is read over white (the initial page canvas)', () => {\n    expect(check(theme('rgba(0, 0, 0, 0)', ['rgb(250, 250, 250)', 'rgb(0, 0, 0)']))).toEqual([0]);\n  });\n});\nimport { describe, expect, it } from 'vitest';\nimport fc from 'fast-check';\nimport { composite, contrastRatio, isLightColor, lowContrastSeries, parseColor, relativeLuminance, type Rgba } from '../../src/theme/color';\nimport type { ResolvedTheme } from '../../src/core/contracts';\n\nconst c = (s: string): Rgba => {\n  const v = parseColor(s);\n  if (v === null) throw new Error(`unparsed ${s}`);\n  return v;\n};\n\ndescribe('parseColor', () => {\n  it('reads the forms getComputedStyle returns', () => {\n    expect(c('rgb(255, 0, 0)')).toEqual({ r: 1, g: 0, b: 0, a: 1 });\n    expect(c('rgba(0, 0, 255, 0.5)')).toEqual({ r: 0, g: 0, b: 1, a: 0.5 });\n    expect(c('rgb(0 128 0 / 25%)').a).toBeCloseTo(0.25, 9);\n    expect(c('rgb(0 128 0 / 25%)').g).toBeCloseTo(128 / 255, 9);\n    expect(c('color(srgb 0.5 0.25 1)')).toEqual({ r: 0.5, g: 0.25, b: 1, a: 1 });\n    expect(c('color(srgb 1 1 1 / 0.2)').a).toBeCloseTo(0.2, 9);\n    expect(c('#767676').r).toBeCloseTo(0x76 / 255, 9);\n    expect(c('#fff')).toEqual({ r: 1, g: 1, b: 1, a: 1 });\n    expect(c('transparent').a).toBe(0);\n  });\n\n  it('returns null rather than guessing', () => {\n    for (const s of ['oklch(0.5 0.1 200)', 'lab(50 10 10)', 'color(display-p3 1 0 0)', 'red', 'rgb(1, 2)', '#12', 'var(--x)', '']) {\n      expect(parseColor(s)).toBeNull();\n    }\n  });\n});\n\ndescribe('contrast (WCAG 2)', () => {\n  it('black on white is 21:1', () => {\n    expect(contrastRatio(c('#000'), c('#fff'))).toBeCloseTo(21, 9);\n    expect(contrastRatio(c('#fff'), c('#000'))).toBeCloseTo(21, 9);\n  });\n\n  it('#767676 on white is about 4.54:1, the smallest gray that passes AA', () => {\n    expect(contrastRatio(c('#767676'), c('#ffffff'))).toBeCloseTo(4.54, 2);\n    expect(contrastRatio(c('#777777'), c('#ffffff'))).toBeLessThan(4.5);\n  });\n\n  it('luminance endpoints', () => {\n    expect(relativeLuminance(c('#000'))).toBe(0);\n    expect(relativeLuminance(c('#fff'))).toBeCloseTo(1, 12);\n  });\n\n  it('a translucent color is measured as it appears on the background', () => {\n    const half = c('rgba(0, 0, 0, 0.5)');\n    expect(contrastRatio(half, c('#fff'))).toBeCloseTo(contrastRatio(composite(half, c('#fff')), c('#fff')), 12);\n    expect(contrastRatio(c('rgba(0, 0, 0, 0)'), c('#fff'))).toBeCloseTo(1, 12);\n  });\n\n  it('is symmetric and between 1 and 21 (property)', () => {\n    const color = fc.record({ r: fc.double({ min: 0, max: 1, noNaN: true }), g: fc.double({ min: 0, max: 1, noNaN: true }), b: fc.double({ min: 0, max: 1, noNaN: true }) })\n      .map(v => ({ ...v, a: 1 }));\n    fc.assert(fc.property(color, color, (x, y) => {\n      const k = contrastRatio(x, y);\n      expect(k).toBeGreaterThanOrEqual(1 - 1e-12);\n      expect(k).toBeLessThanOrEqual(21 + 1e-9);\n      expect(contrastRatio(y, x)).toBeCloseTo(k, 9);\n    }));\n  });\n});\n\ndescribe('isLightColor', () => {\n  it('splits where contrast with black equals contrast with white', () => {\n    expect(isLightColor(c('#fff'))).toBe(true);\n    expect(isLightColor(c('#000'))).toBe(false);\n    expect(isLightColor(c('#16181d'))).toBe(false);\n    expect(isLightColor(c('#e8eaee'))).toBe(true);\n    fc.assert(fc.property(fc.integer({ min: 0, max: 255 }), v => {\n      const gray = { r: v / 255, g: v / 255, b: v / 255, a: 1 };\n      const black = { r: 0, g: 0, b: 0, a: 1 };\n      const white = { r: 1, g: 1, b: 1, a: 1 };\n      expect(isLightColor(gray)).toBe(contrastRatio(gray, black) > contrastRatio(gray, white));\n    }));\n  });\n});\n\ndescribe('lowContrastSeries', () => {\n  const theme = (background: string, series: string[]): ResolvedTheme => ({\n    scheme: 'light', forcedColors: false, moreContrast: false,\n    paints: { tokens: { axis: '', grid: '', reference: '', muted: '', focus: '', background, text: '' }, series },\n  });\n\n  it('lists the series below 3:1 against the resolved background', () => {\n    // #949494 on white is 3.03:1, #959595 is 2.99:1 (computed by the WCAG formula by hand for the check).\n    const t = theme('rgb(255, 255, 255)', ['rgb(0, 0, 0)', 'rgb(149, 149, 149)', 'rgb(148, 148, 148)', 'rgb(255, 255, 0)']);\n    expect(lowContrastSeries(t)).toEqual([1, 3]);\npackages/axylo/test/theme/review.test.ts:14:    // rgba(0,0,0,0.1) over black is black: black ink on it is 1:1, not the 15:1 a white backdrop would give.\npackages/axylo/test/theme/review.test.ts:18:  it('a transparent background still checks every series against the backdrop', () => {\npackages/axylo/test/theme/review.test.ts:22:  it('a translucent series color is composited over the background first', () => {\npackages/axylo/test/theme/review.test.ts:26:  it('without a backdrop a translucent background is read over white (the initial page canvas)', () => {\npackages/axylo/test/theme/palette.test.ts:8:import { describe, expect, it } from 'vitest';\npackages/axylo/test/theme/palette.test.ts:76:  it('reproduces known OKLab values and leaves grays alone under every simulation', () => {\npackages/axylo/test/theme/palette.test.ts:98:    it(`${name}: eight distinct series colors`, () => {\npackages/axylo/test/theme/palette.test.ts:104:    it(`${name}: 1. every series color reaches 3:1 on the default background`, () => {\npackages/axylo/test/theme/palette.test.ts:109:    it(`${name}: 2. the eight are at least 0.10 apart in OKLab under normal vision and simulated protanopia, deuteranopia, tritanopia`, () => {\npackages/axylo/test/theme/palette.test.ts:116:    it(`${name}: 3. the first three, four, five and six are at least 0.10 apart, the first four at least 0.14`, () => {\npackages/axylo/test/theme/palette.test.ts:123:    it(`${name}: 4. slot k is the same hue family in both schemes (OKLCH hue within 30°)`, () => {\npackages/axylo/test/theme/palette.test.ts:129:    it(`${name}: 5. no series color is within 0.10 of the focus or reference token (nor muted, the donut's \"Other\" slice)`, () => {\npackages/axylo/test/theme/palette.test.ts:136:    it(`${name}: 6. neighbours k and k+1 stay 0.06 apart as fills at 25% and 80% over the background`, () => {\npackages/axylo/test/theme/palette.test.ts:145:    it(`${name}: the research record (research/palette/palette.json) holds these colors and the same measurements`, () => {\npackages/axylo/test/theme/palette.test.ts:165:    it(`${name}: token colors meet spec L2 (axis and focus 3:1; muted and reference 4.5:1, they label text)`, () => {\npackages/axylo/test/theme/palette.test.ts:176:  it('defines the light and dark token sets, forced colors and the dash switch', () => {\npackages/axylo/test/theme/palette.test.ts:189:  it('never sets what scheme detection reads (color-scheme, color, --axylo-background) outside forced colors', () => {\npackages/axylo/test/theme/palette.test.ts:196:  it('keeps the marker that separates the figure module\\'s structure rules from the token and mark part', () => {\npackages/axylo/test/theme/palette.test.ts:201:  it('balances its braces', () => {\npackages/axylo/test/theme/color.test.ts:1:import { describe, expect, it } from 'vitest';\npackages/axylo/test/theme/color.test.ts:13:  it('reads the forms getComputedStyle returns', () => {\npackages/axylo/test/theme/color.test.ts:25:  it('returns null rather than guessing', () => {\npackages/axylo/test/theme/color.test.ts:33:  it('black on white is 21:1', () => {\npackages/axylo/test/theme/color.test.ts:38:  it('#767676 on white is about 4.54:1, the smallest gray that passes AA', () => {\npackages/axylo/test/theme/color.test.ts:43:  it('luminance endpoints', () => {\npackages/axylo/test/theme/color.test.ts:48:  it('a translucent color is measured as it appears on the background', () => {\npackages/axylo/test/theme/color.test.ts:54:  it('is symmetric and between 1 and 21 (property)', () => {\npackages/axylo/test/theme/color.test.ts:67:  it('splits where contrast with black equals contrast with white', () => {\npackages/axylo/test/theme/color.test.ts:87:  it('lists the series below 3:1 against the resolved background', () => {\npackages/axylo/t