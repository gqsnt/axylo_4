{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'git show 51e1be5:research/palette/fit.mjs | nl -ba'","aggregated_output":"     1\t// Nearest feasible palette to a hand-designed target (decision 0003). Plain Node, no dependencies.\n     2\t//\n     3\t// The designer writes a target color per slot in OKLCH and a box around it (lightness, chroma, hue ranges) for\n     4\t// each scheme (configs/fit-*.json). This script lays a grid over each box (8-bit-rounded hex, so what is scored is\n     5\t// what ships), drops grid colors that fail on their own (contrast, gamut, distance to the focus, reference and\n     6\t// muted tokens), and then runs a branch-and-bound search over slots with forward checking on the pairwise\n     7\t// constraints (minimum OKLab difference under four visions, 0.14 inside the first four; neighbour composites at\n     8\t// 25% and 80%). The cost is the weighted squared distance from the target, so the result is the feasible palette\n     9\t// closest to what was asked for, on that grid. The light scheme is solved first; the dark scheme's hue boxes are\n    10\t// then clipped to within 30° of the light result per slot (constraint 4).\n    11\t//\n    12\t//   node research/palette/fit.mjs --config=research/palette/configs/fit-x.json [--seconds=60] [--out=file.json]\n    13\timport fs from 'node:fs';\n    14\timport path from 'node:path';\n    15\timport { fileURLToPath } from 'node:url';\n    16\timport { THRESHOLDS as T, TOKEN_NAMES, VISIONS, compositeLinear, contrast, dist, hueDiff, labUnder, lch, lchToHex, oklab } from './color.mjs';\n    17\t\n    18\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    19\texport const SCHEME_TOKENS = {\n    20\t  light: { background: '#ffffff', focus: '#1f5fcc', reference: '#474b55', muted: '#62666f' },\n    21\t  dark: { background: '#16181d', focus: '#79a8ff', reference: '#bcc0c9', muted: '#9da2ad' },\n    22\t};\n    23\t\n    24\t// Shipped colors keep a little room above 3:1, so a contrast computed with slightly different rounding still passes.\n    25\tconst CONTRAST_MARGIN = 0.02;\n    26\t\n    27\texport function candidates(slot, box, tokens, hueClip) {\n    28\t  const out = new Map();\n    29\t  const [tL, tC, tH] = box.target, [wL, wC, wH] = box.weights ?? [1, 1, 1];\n    30\t  const step = box.step ?? [0.01, 0.01, 2];\n    31\t  for (let L = box.L[0]; L <= box.L[1] + 1e-9; L += step[0])\n    32\t    for (let C = box.C[0]; C <= box.C[1] + 1e-9; C += step[1])\n    33\t      for (let dh = -box.hr; dh <= box.hr + 1e-9; dh += step[2]) {\n    34\t        const hex = lchToHex([L, C, (tH + dh + 360) % 360]);\n    35\t        if (!hex || out.has(hex)) continue;\n    36\t        if (contrast(hex, tokens.background) < T.contrast + CONTRAST_MARGIN) continue;\n    37\t        const labs = VISIONS.map(v => labUnder(hex, v));\n    38\t        if (TOKEN_NAMES.some(t => dist(labs[0], labUnder(tokens[t], 'normal')) < T.token)) continue;\n    39\t        const [l, c, h] = lch(hex);\n    40\t        if (hueClip && hueDiff(h, hueClip.h) > hueClip.max) continue;\n    41\t        const cost = wL * ((l - tL) / 0.05) ** 2 + wC * ((c - tC) / 0.03) ** 2 + (box.neutral ? 0 : wH * (hueDiff(h, tH) / 10) ** 2);\n    42\t        out.set(hex, { hex, labs, comp: T.alphas.map(a => oklab(compositeLinear(hex, a, tokens.background))), cost, lch: [l, c, h] });\n    43\t      }\n    44\t  return [...out.values()].sort((a, b) => a.cost - b.cost);\n    45\t}\n    46\t\n    47\texport function compatible(i, a, j, b) {\n    48\t  const limit = i < 4 && j < 4 ? T.prefix4 : T.minDelta;\n    49\t  for (let v = 0; v < VISIONS.length; v++) if (dist(a.labs[v], b.labs[v]) < limit) return false;\n    50\t  if (Math.abs(i - j) === 1) for (let k = 0; k < T.alphas.length; k++) if (dist(a.comp[k], b.comp[k]) < T.composite) return false;\n    51\t  return true;\n    52\t}\n    53\t\n    54\t/**\n    55\t * Branch and bound with forward checking. Returns the cheapest assignment found within the time limit.\n    56\t * With restarts > 1, the first half of the time goes to the exact cost-ordered search and the rest is split\n    57\t * between restarts that try values in a jittered cost order (seeded, so runs repeat), sharing the best bound.\n    58\t * Only the first pass can prove that nothing exists; `complete` reports whether it finished.\n    59\t */\n    60\texport function search(domains, seconds, compat = compatible, restarts = 1) {\n    61\t  const n = domains.length, start = Date.now();\n    62\t  let best = null, bestCost = Infinity, nodes = 0, complete = true, deadline = 0;\n    63\t  const assigned = new Array(n).fill(null);\n    64\t  const minCost = d => { let m = Infinity; for (const x of d) if (x.cost < m) m = x.cost; return m; };\n    65\t  function recurse(doms, mins, cost, sorted) {\n    66\t    if (Date.now() > deadline) return false;\n    67\t    nodes++;\n    68\t    let pick = -1;   // most constrained unassigned slot first\n    69\t    for (let s = 0; s < n; s++) if (assigned[s] === null && (pick < 0 || doms[s].length < doms[pick].length)) pick = s;\n    70\t    if (pick < 0) { if (cost < bestCost) { bestCost = cost; best = assigned.slice(); } return true; }\n    71\t    let bound = cost;\n    72\t    for (let s = 0; s < n; s++) if (assigned[s] === null) bound += mins[s];\n    73\t    if (bound >= bestCost) return true;\n    74\t    for (const cand of doms[pick]) {\n    75\t      const rest = bound - mins[pick] + cand.cost;\n    76\t      if (rest >= bestCost) { if (sorted) break; continue; }\n    77\t      assigned[pick] = cand;\n    78\t      const next = doms.slice(), nextMins = mins.slice();\n    79\t      let ok = true, nb = cost + cand.cost;\n    80\t      for (let s = 0; s < n && ok; s++) {\n    81\t        if (assigned[s] !== null) continue;\n    82\t        const f = doms[s].filter(x => compat(pick, cand, s, x));\n    83\t        if (!f.length) ok = false; else { next[s] = f; nextMins[s] = sorted ? f[0].cost : minCost(f); nb += nextMins[s]; }\n    84\t      }\n    85\t      const finished = ok && nb < bestCost ? recurse(next, nextMins, cost + cand.cost, sorted) : true;\n    86\t      assigned[pick] = null;\n    87\t      if (!finished || Date.now() > deadline) return false;\n    88\t    }\n    89\t    return true;\n    90\t  }\n    91\t  const share = restarts > 1 ? 0.5 : 1;\n    92\t  deadline = start + seconds * 1000 * share;\n    93\t  complete = recurse(domains, domains.map(d => d[0]?.cost ?? Infinity), 0, true);\n    94\t  let seed = 1;\n    95\t  const rand = () => { seed = (seed * 1103515245 + 12345) & 0x7fffffff; return seed / 0x7fffffff; };\n    96\t  for (let r = 1; r < restarts; r++) {\n    97\t    deadline = start + seconds * 1000 * (share + (1 - share) * r / (restarts - 1));\n    98\t    const jittered = domains.map(d => d.map(x => ({ x, k: x.cost * (0.5 + rand()) + rand() })).sort((a, b) => a.k - b.k).map(e => e.x));\n    99\t    recurse(jittered, jittered.map(minCost), 0, false);\n   100\t  }\n   101\t  return { best, cost: bestCost, nodes, complete };\n   102\t}\n   103\t\n   104\texport function fitScheme(cfg, scheme, hueClips, seconds, step, restarts = 1) {\n   105\t  const tokens = { ...SCHEME_TOKENS[scheme], ...(cfg.tokens?.[scheme] ?? {}) };   // a config may try other token colors\n   106\t  const domains = cfg.slots.map((s, k) => candidates(k, { ...s[scheme], neutral: !!s.neutral, ...(step ? { step } : {}) }, tokens, hueClips?.[k]));\n   107\t  const sizes = domains.map(d => d.length);\n   108\t  if (sizes.some(x => x === 0)) return { scheme, sizes, best: null };\n   109\t  const r = search(domains, seconds, compatible, restarts);\n   110\t  return { scheme, sizes, ...r };\n   111\t}\n   112\t\n   113\tif (process.argv[1] === fileURLToPath(import.meta.url)) {\n   114\t  const args = Object.fromEntries(process.argv.slice(2).map(a => a.replace(/^--/, '').split('=')).map(([k, v]) => [k, v ?? 'true']));\n   115\t  const cfg = JSON.parse(fs.readFileSync(args.config, 'utf8'));\n   116\t  const seconds = +(args.seconds ?? 60);\n   117\t  // What-if runs only: --minDelta=, --prefix4=, --composite=, --token= override a threshold for this run.\n   118\t  for (const k of ['minDelta', 'prefix4', 'composite', 'token']) if (args[k]) { T[k] = +args[k]; console.log(`override ${k} = ${T[k]}`); }\n   119\t  const step = args.step ? args.step.split(',').map(Number) : null;   // --step=L,C,h overrides every box's grid\n   120\t  const restarts = +(args.restarts ?? 1);                              // --restarts=N: see search()\n   121\t  // --light=#hex,... skips the light search and solves only the dark scheme against that light set.\n   122\t  const fixed = args.light ? args.light.split(',') : null;\n   123\t  const light = fixed\n   124\t    ? { sizes: fixed.map(() => 1), nodes: 0, complete: true, cost: 0, best: fixed.map(hex => ({ hex, lch: lch(hex) })) }\n   125\t    : fitScheme(cfg, 'light', null, seconds, step, restarts);\n   126\t  console.log('light domains', light.sizes.join(' '), 'nodes', light.nodes, light.complete ? 'complete' : 'timed out', 'cost', light.cost?.toFixed?.(3));\n   127\t  if (!light.best) { console.log('no light solution'); process.exit(1); }\n   128\t  console.log('light', light.best.map(c => c.hex).join(' '));\n   129\t  const clips = light.best.map(c => ({ h: c.lch[2], max: T.hueMatch - 2 })); // neutrals too: the test checks every slot\n   130\t  const dark = fitScheme(cfg, 'dark', clips, seconds, step, restarts);\n   131\t  console.log('dark domains', dark.sizes.join(' '), 'nodes', dark.nodes, dark.complete ? 'complete' : 'timed out', 'cost', dark.cost?.toFixed?.(3));\n   132\t  if (!dark.best) { console.log('no dark solution'); process.exit(1); }\n   133\t  console.log('dark', dark.best.map(c => c.hex).join(' '));\n   134\t  const out = { config: path.basename(args.config, '.json'), light: light.best.map(c => c.hex), dark: dark.best.map(c => c.hex),\n   135\t    lch: { light: light.best.map(c => c.lch.map(v => +v.toFixed(3))), dark: dark.best.map(c => c.lch.map(v => +v.toFixed(3))) },\n   136\t    cost: { light: +light.cost.toFixed(3), dark: +dark.cost.toFixed(3) }, complete: { light: light.complete, dark: dark.complete } };\n   137\t  fs.writeFileSync(args.out ?? path.join(here, 'candidates', `${out.config}.json`), JSON.stringify(out, null, 1) + '\\n');\n   138\t}\n","exit_code":0,"status":"completed"}}
