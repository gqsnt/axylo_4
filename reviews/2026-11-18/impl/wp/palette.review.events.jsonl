{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc 'nl -ba research/harness/palette.mjs | head -190 && rg --files research/harness | rg \"package|palette|vendor\" | head -120'","aggregated_output":"     1\t// Extracts the colors each library actually used for the 6-slice donut,\n     2\t// then scores them: contrast against white (WCAG 1.4.11 asks 3:1 for graphical objects) and\n     3\t// the smallest pairwise color difference under normal vision and simulated color-vision deficiencies.\n     4\timport { chromium } from 'playwright-core';\n     5\timport fs from 'node:fs';\n     6\tconst LIBS = ['chartjs', 'recharts', 'd3', 'echarts', 'highcharts', 'apexcharts', 'plotly', 'nivo', 'mui', 'uplot'];\n     7\tconst browser = await chromium.launch({ channel: 'chrome', headless: true });\n     8\tconst grab = async (lib, task) => {\n     9\t  const page = await browser.newPage({ viewport: { width: 800, height: 520 } });\n    10\t  await page.goto(`http://localhost:4173/?lib=${lib}&task=${task}`);\n    11\t  await page.waitForFunction(() => window.__result); await page.waitForTimeout(1800);\n    12\t  const colors = await page.evaluate(task => {\n    13\t    const h = window.__handle, el = document.getElementById('chart');\n    14\t    const norm = c => { const x = document.createElement('canvas').getContext('2d'); x.fillStyle = c; return x.fillStyle; };\n    15\t    if (h?.chart?.data?.datasets) { const d = h.chart.data.datasets; return (task === 'parts' ? d[0].backgroundColor : d.map(s => s.borderColor)).map(norm); }\n    16\t    if (h?.chart?.getOption) return h.chart.getOption().color.slice(0, task === 'parts' ? 6 : 3).map(norm); // ECharts draws on canvas: its option palette, in slice order\n    17\t    if (h?.u) return h.u.series.slice(1).map(s => norm(s._stroke ?? s.stroke(h.u)));\n    18\t    // SVG: big filled shapes for the donut, long stroked paths for lines; keep first-seen order\n    19\t    const seen = [];\n    20\t    for (const p of el.querySelectorAll('svg path, svg circle')) {\n    21\t      const cs = getComputedStyle(p), b = p.getBBox?.() ?? { width: 0, height: 0 };\n    22\t      if (p.closest('[class*=legend]')) continue;\n    23\t      const c = task === 'parts' ? cs.fill : cs.stroke;\n    24\t      if (!c || c === 'none' || c.includes('rgba(0, 0, 0, 0)')) continue;\n    25\t      if (/rgba\\(/.test(c) || c === 'rgb(255, 255, 255)') continue; // skip translucent overlays and white separators\n    26\t      if (task === 'parts' ? (p.tagName !== 'path' || b.width < 3 || b.height < 3) : (p.tagName !== 'path' || b.width < 200 || cs.fill !== 'none')) continue;\n    27\t      seen.push(norm(c)); // keep repeats: two slices with the same fill are a pair with zero difference\n    28\t    }\n    29\t    return seen;\n    30\t  }, task);\n    31\t  await page.close();\n    32\t  return colors;\n    33\t};\n    34\t// --- color math\n    35\tconst lin = v => { v /= 255; return v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4; };\n    36\tconst rgb = h => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));\n    37\tconst lum = h => { const [r, g, b] = rgb(h).map(lin); return 0.2126 * r + 0.7152 * g + 0.0722 * b; };\n    38\tconst contrast = (a, b) => { const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p); return (x + 0.05) / (y + 0.05); };\n    39\t// Machado et al. 2009, severity 1.0, applied in linear RGB\n    40\tconst CVD = { normal: [[1, 0, 0], [0, 1, 0], [0, 0, 1]],\n    41\t  protan: [[0.152286, 1.052583, -0.204868], [0.114503, 0.786281, 0.099216], [-0.003882, -0.048116, 1.051998]],\n    42\t  deutan: [[0.367322, 0.860646, -0.227968], [0.280085, 0.672501, 0.047413], [-0.011820, 0.042940, 0.968881]],\n    43\t  tritan: [[1.255528, -0.076749, -0.178779], [-0.078411, 0.930809, 0.147602], [0.004733, 0.691367, 0.303900]] };\n    44\tconst oklab = ([r, g, b]) => { const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b), m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b), s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);\n    45\t  return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s, 1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s, 0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s]; };\n    46\tconst sim = (h, M) => oklab(M.map(row => Math.min(1, Math.max(0, row.reduce((a, k, i) => a + k * rgb(h).map(lin)[i], 0)))));\n    47\tconst minDelta = (cols, M) => { let m = Infinity, pair = null; for (let i = 0; i < cols.length; i++) for (let j = i + 1; j < cols.length; j++) { const a = sim(cols[i], M), b = sim(cols[j], M), d = Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]); if (d < m) { m = d; pair = [cols[i], cols[j]]; } } return { min: +m.toFixed(4), pair }; };\n    48\tconst out = {};\n    49\tfor (const lib of LIBS) {\n    50\t  // the donut has six slices, so this is the library's first six categorical colors (fewer if it repeats)\n    51\t  const parts = lib === 'uplot' ? [] : (await grab(lib, 'parts')).slice(0, 6);\n    52\t  const score = cols => cols.length < 2 ? null : { slices: cols.length, distinct: new Set(cols).size, contrastOnWhite: cols.map(c => +contrast(c, '#ffffff').toFixed(2)), below3to1: cols.filter(c => contrast(c, '#ffffff') < 3).length,\n    53\t    minDeltaOK: Object.fromEntries(Object.entries(CVD).map(([k, M]) => [k, minDelta(cols, M)])) };\n    54\t  out[lib] = { donut6: parts, score: score(parts) };\n    55\t  console.log(lib, JSON.stringify(out[lib]));\n    56\t}\n    57\tfs.writeFileSync('palette.json', JSON.stringify(out, null, 1));\n    58\tawait browser.close();\nresearch/harness/palette.mjs\nresearch/harness/package-lock.json\nresearch/harness/palette.json\nresearch/harness/package.json\n","exit_code":0,"status":"completed"}}
