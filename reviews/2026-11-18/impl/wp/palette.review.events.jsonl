{"type":"item.started","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module - <<'AXYLO_JS'\nimport fs from 'node:fs';\nconst file=f=>JSON.parse(fs.readFileSync(f));\nconst record=file('research/palette/palette.json');\nconst schemes=Object.fromEntries(Object.entries(record.schemes).map(([s,x])=>[s,{bg:x.background,colors:x.series.map(t=>t.hex),tokens:x.tokens}]));\nconst decode=x=>x>0.04045?Math.pow((x+.055)/1.055,2.4):x/12.92,encode=x=>x>.0031308?1.055*x**(1/2.4)-.055:12.92*x;\nconst rgb=h=>Array.isArray(h)?h:[16,8,0].map(i=>((parseInt(h.slice(1),16)>>>i)&255)/255);\nconst xyz=[[506752/1228815,87881/245763,12673/70218],[87098/409605,175762/245763,12673/175545],[7918/409605,87881/737289,1001167/1053270]];\nconst cone=[[.8190224432164319,.3619062562801221,-.12887378261216414],[.0329836671980271,.9292868468965546,.03614466816999844],[.048177199566046255,.26423952494422764,.6335478258136937]];\nconst inverse=(mat)=>{let t=mat.map((row,i)=>[...row,...[0,1,2].map(j=>+(i===j))]);for(let i=0;i<3;i++){let v=t[i][i];t[i]=t[i].map(x=>x/v);for(let j=0;j<3;j++)if(i\"'!==j){let q=t[j][i];t[j]=t[j].map((x,k)=>x-q*t[i][k]);}}return t.map(r=>r.slice(3))};\nconst labForward=inverse([[1,.3963377774,.2158037573],[1,-.1055613458,-.0638541728],[1,-.0894841775,-1.291485548]]);\nconst dot=(p,q)=>p.reduce((s,x,i)=>s+x*q[i],0), times=(m,x)=>m.map(row=>dot(row,x)), clamp=v=>Math.max(0,Math.min(1,v));\nconst V=['\"'normal','protan','deutan','tritan'];\nconst projections=[[[1,0,0],[0,1,0],[0,0,1]],[[.152286,1.052583,-.204868],[.114503,.786281,.099216],[-.003882,-.048116,1.051998]],[[.367322,.860646,-.227968],[.280085,.672501,.047413],[-.011820,.042940,.968881]],[[1.255528,-.076749,-.178779],[-.078411,.930809,.147602],[.004733,.691367,.303900]]];\nconst labLin=x=>times(labForward,times(cone,times(xyz,x)).map(Math.cbrt));\nconst lab=(h,v=0)=>labLin(times(projections[v],rgb(h).map(decode)).map(clamp));\nconst Y=h=>dot(rgb(h).map(decode),[.2126,.7152,.0722]),ratio=(a,b)=>(Math.max(Y(a),Y(b))+.05)/(Math.min(Y(a),Y(b))+.05);\nconst polar=([L,a,b])=>[L,Math.sqrt(a*a+b*b),(Math.atan2(b,a)*180/Math.PI+360)%360];\nconst ang=(a,b)=>Math.abs(((a-b+540)%360)-180);\nconst distance=(x,y)=>Math.sqrt(x.reduce((a,c,i)=>a+(c-y[i])**2,0));\nconst blend=(a,b,k)=>rgb(a).map((c,i)=>rgb(b)[i]+k*(c-rgb(b)[i]));\nconst closest=(a,b)=>a.d<=b.d?a:b;\nconst pairs=(colors,n=8)=>{let arr=[];for(let v=0;v<4;v++)for(let j=1;j<n;j++)for(let i=0;i<j;i++)arr.push({d:distance(lab(colors[i],v),lab(colors[j],v)),i:i+1,j:j+1,v:V[v]});return arr};\nconst lo=a=>a.reduce(closest), fix=(x,k=6)=>Number(x.toFixed(k));\nconst metrics=(s,t)=>{let {bg,colors:c,tokens}=s,all=pairs(c);return {\ncontrast:Math.min(...c.map(x=>ratio(x,bg))),\nfull:V.map(v=>lo(all.filter(x=>x.v===v))),\nprefix:[3,4,5,6].map(n=>V.map(v=>lo(all.filter(x=>x.j<=n&&x.v===v)))),\nhue:Math.max(...c.map((h,i)=>ang(polar(lab(h))[2],polar(lab(t.colors[i]))[2]))),\ntokens:['focus','reference','muted'].map(n=>Math.min(...c.map(h=>distance(lab(h),lab(tokens[n]))))),\ncomp:[.25,.8].map(k=>Math.min(...c.slice(1).map((h,i)=>distance(lab(blend(h,bg,k)),lab(blend(c[i],bg,k))))))}};const diff=[];\nfor(const [s,o]of [['light','dark'],['dark','light']]){const R=record.schemes[s],{colors:c,bg,tokens}=schemes[s],m=metrics(schemes[s],schemes[o]),eq=(p,a,b)=>{if(JSON.stringify(a)\"'!==JSON.stringify(b))diff.push([s,p,a,b])};for(let k=0;k<8;k++){let h=c[k],p=polar(lab(h)),r=R.series[k];eq('\"'lch',p.map((x,i)=>fix(x,i===2?1:3)),r.oklch);eq('cr',fix(ratio(h,bg),2),r.contrast);eq('h',fix(ang(p[2],polar(lab(schemes[o].colors[k]))[2]),1),r.hueDiffToOtherScheme)}\nfor(let [i,v] of V.entries()){for(let [n,d]of [[8,m.full[i]],...[3,4,5,6].map((n,k)=>[n,m.prefix[k][i]])]){let r=n===8?R.minDelta[v]:R.prefixes[n][v];eq('prefix',[fix(d.d,3),[d.i,d.j]],[r.min,r.pair])}\nfor(let a of [.25,.8]){let r=R.composites[String(a)][v],cc=c.map(h=>lab(blend(h,bg,a),i)),delta=(j,k)=>distance(cc[j],cc[k]);eq('adj',r.neighbours,cc.slice(1).map((_,j)=>fix(delta(j+1,j),3)));eq('ring',r.ringClosures,cc.slice(2).map((_,j)=>({slots:[j+3,1],d:fix(delta(j+2,0),3)})));}}\nfor(let k of ['focus','reference','muted']){let a=c.map(h=>distance(lab(h),lab(tokens[k]))),v=Math.min(...a);eq('token',{min:fix(v,3),slot:a.indexOf(v)+1},R.tokenDistance[k]);}\nconsole.log('ring',s,R.composites['0.25'].normal.ringClosures.filter(x=>x.d<.06),'comp CVD',s,Object.entries(R.composites).map(([a,q])=>[a,V.slice(1).map(v=>q[v].minNeighbour)]));\n}console.log('Record diffs',diff);\nconst d3File=file('research/harness/palette.json');console.log('land',Object.entries(d3File).map(([k,x])=>[k,x.donut6.length,x.donut6.filter(c=>ratio(c,'#ffffff')<3).length]));\nAXYLO_JS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
