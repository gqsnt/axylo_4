2,.0722]),ratio=(a,b)=>(Math.max(Y(a),Y(b))+.05)/(Math.min(Y(a),Y(b))+.05);\nconst polar=([L,a,b])=>[L,Math.sqrt(a*a+b*b),(Math.atan2(b,a)*180/Math.PI+360)%360];\nconst ang=(a,b)=>Math.abs(((a-b+540)%360)-180);\nconst distance=(x,y)=>Math.sqrt(x.reduce((a,c,i)=>a+(c-y[i])**2,0));\nconst blend=(a,b,k)=>rgb(a).map((c,i)=>rgb(b)[i]+k*(c-rgb(b)[i]));\nconst closest=(a,b)=>a.d<=b.d?a:b;\nconst pairs=(colors,n=8)=>{let arr=[];for(let v=0;v<4;v++)for(let j=1;j<n;j++)for(let i=0;i<j;i++)arr.push({d:distance(lab(colors[i],v),lab(colors[j],v)),i:i+1,j:j+1,v:V[v]});return arr};\nconst lo=a=>a.reduce(closest), fix=(x,k=6)=>Number(x.toFixed(k));\nconst metrics=(s,t)=>{let {bg,colors:c,tokens}=s,all=pairs(c);return {\ncontrast:Math.min(...c.map(x=>ratio(x,bg))),\nfull:V.map(v=>lo(all.filter(x=>x.v===v))),\nprefix:[3,4,5,6].map(n=>V.map(v=>lo(all.filter(x=>x.j<=n&&x.v===v)))),\nhue:Math.max(...c.map((h,i)=>ang(polar(lab(h))[2],polar(lab(t.colors[i]))[2]))),\ntokens:['focus','reference','muted'].map(n=>Math.min(...c.map(h=>distance(lab(h),lab(tokens[n]))))),\ncomp:[.25,.8].map(k=>Math.min(...c.slice(1).map((h,i)=>distance(lab(blend(h,bg,k)),lab(blend(c[i],bg,k))))))}};let f=schemes.light.colors;let result;search:for(let r=0;r<18;r++)for(let g=118;g<=130;g++)for(let b=158;b<175;b++){let h='#'+[r,g,b].map(x=>x.toString(16).padStart(2,'0')).join(''),p=f.slice();p[5]=h;let a=pairs(p),v=lo(a);if(v.d<.1&&v.d>=.09994&&lo(a.filter(x=>x.v==='normal')).d>.11){result=[h,v,lo(a.filter(x=>x.v==='normal')).d];break search}}console.log('near boundary',result);\nimport {lchToHex} from './research/palette/color.mjs';let hs=[359,1].map(h=>lchToHex([.55,.12,h]));console.log(hs,hs.map(h=>polar(lab(h))[2]),ang(...hs.map(h=>polar(lab(h))[2])));\nAXYLO_JS\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
