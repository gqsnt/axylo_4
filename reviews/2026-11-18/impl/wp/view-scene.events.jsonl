{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/simplify/index.ts'","aggregated_output":"import { SLOT_GAP, SLOT_NO_ROW, SLOT_VALUE } from '../core/contracts';\nimport type { AreaMark, ContinuousScale, IndexRange, PathMark, PointMark, XScale } from '../core/contracts';\n\ntype Values = Float64Array | Float32Array;\ntype XMap = XScale | ((x: number) => number);\ntype YMap = ContinuousScale | ((y: number) => number);\n\nexport interface JoinedRuns {\n  /** Source slot indexes of runs with at least two values. */\n  readonly indexes: Uint32Array;\n  /** Offsets into indexes at which a new run starts, excluding the first run. */\n  readonly breaks: Uint32Array;\n  readonly isolated: Uint32Array;\n}\n\ninterface DrawingInput {\n  readonly x: Float64Array;\n  readonly slot: Uint8Array;\n  readonly range: IndexRange;\n  /** The x projection is monotone in source order, so each column is visited once per run. */\n  readonly mapX: XMap;\n  readonly left: number;\n  readonly width: number;\n  readonly devicePixelRatio: number;\n}\n\nexport interface LineInput extends DrawingInput {\n  readonly y: Values;\n}\n\nexport interface PathInput {\n  readonly x: Float64Array;\n  readonly y: Values | 0;\n  readonly mapX: XMap;\n  readonly mapY: YMap;\n}\n\ninterface Columns {\n  readonly x: Float64Array;\n  readonly y: Values | 0;\n  readonly map: (x: number) => number;\n  readonly ratio: number;\n}\n\nfunction xMapper(scale: XMap): (x: number) => number {\n  if (typeof scale === 'function') return scale;\n  return scale.type === 'band' ? x => scale.center(x) : x => scale.map(x);\n}\n\nfunction keepColumn(\n  indexes: Uint32Array | undefined, cursor: number, first: number, last: number, min: number, max: number,\n): number {\n  // An extreme may also be an endpoint. Emit each slot once and in source order.\n  const earlier = Math.min(min, max);\n  const later = Math.max(min, max);\n  if (indexes) indexes[cursor] = first;\n  cursor++;\n  if (earlier > first && earlier < last) {\n    if (indexes) indexes[cursor] = earlier;\n    cursor++;\n  }\n  if (later > earlier && later < last) {\n    if (indexes) indexes[cursor] = later;\n    cursor++;\n  }\n  if (last > first) {\n    if (indexes) indexes[cursor] = last;\n    cursor++;\n  }\n  return cursor;\n}\n\nfunction scan(slot: Uint8Array, range: IndexRange, columns?: Columns, output?: JoinedRuns) {\n  const indexes = output?.indexes;\n  const valueSlot = SLOT_VALUE;\n  const noRow = SLOT_NO_ROW;\n  const gap = SLOT_GAP;\n  let values = 0;\n  let vertices = 0;\n  let breaks = 0;\n  let isolated = 0;\n  let runStart = 0;\n  let runFirst = -1;\n  let runLast = -1;\n  let column = 0;\n  let first = -1;\n  let last = -1;\n  let min = -1;\n  let max = -1;\n  let low = 0;\n  let high = 0;\n  const { start, end } = range;\n\n  for (let i = start; i <= end; i++) {\n    const state = i < end ? slot[i] : gap;\n    if (state !== valueSlot) {\n      if (state === noRow || runFirst < 0) continue;\n      if (runFirst === runLast) {\n        if (output) output.isolated[isolated] = runFirst;\n        isolated++;\n      } else {\n        if (columns) vertices = keepColumn(indexes, vertices, first, last, min, max);\n        if (runStart > 0) {\n          if (output) output.breaks[breaks] = runStart;\n          breaks++;\n        }\n      }\n      runFirst = -1;\n      runLast = -1;\n      continue;\n    }\n\n    values++;\n    if (runFirst < 0) {\n      runFirst = i;\n      runStart = vertices;\n    }\n\n    if (columns) {\n      const pixel = Math.floor(columns.map(columns.x[i]!) * columns.ratio);\n      const value = columns.y === 0 ? 0 : columns.y[i]!;\n      if (runLast < 0 || pixel !== column) {\n        if (runLast >= 0) vertices = keepColumn(indexes, vertices, first, last, min, max);\n        column = pixel;\n        first = min = max = i;\n        low = high = value;\n      } else {\n        if (value < low) {\n          low = value;\n          min = i;\n        }\n        if (value > high) {\n          high = value;\n          max = i;\n        }\n      }\n      last = i;\n    } else if (runLast >= 0) {\n      if (runLast === runFirst) {\n        if (indexes) indexes[vertices] = runFirst;\n        vertices++;\n      }\n      if (indexes) indexes[vertices] = i;\n      vertices++;\n    }\n    runLast = i;\n  }\n  return { values, vertices, breaks, isolated };\n}\n\nfunction select(slot: Uint8Array, range: IndexRange, limit: number, columns?: Columns): JoinedRuns {\n  const size = scan(slot, range, columns);\n  const dense = size.values > limit;\n  const output: JoinedRuns = {\n    indexes: new Uint32Array(dense ? size.vertices : size.values - size.isolated),\n    breaks: new Uint32Array(size.breaks),\n    isolated: new Uint32Array(size.isolated),\n  };\n  scan(slot, range, dense ? columns : undefined, output);\n  return output;\n}\n\nexport function joinRuns(slot: Uint8Array, range: IndexRange): JoinedRuns {\n  return select(slot, range, Infinity);\n}\n\nfunction simplifyBoundary(input: DrawingInput, y: Values | 0): JoinedRuns {\n  const { left, width, devicePixelRatio: ratio, range } = input;\n  const columns = width > 0 ? Math.ceil((left + width) * ratio) - Math.floor(left * ratio) : 0;\n  const limit = 4 * columns;\n  if (range.end - range.start <= limit) return joinRuns(input.slot, range);\n  return select(input.slot, range, limit, { x: input.x, y, map: xMapper(input.mapX), ratio });\n}\n\nexport function simplifyLine(input: LineInput): JoinedRuns {\n  return simplifyBoundary(input, input.y);\n}\n\nfunction pack(indexes: Uint32Array, breaks: Uint32Array | null, input: PathInput): Float32Array {\n  const xy = new Float32Array(2 * (indexes.length + (breaks?.length ?? 0)));\n  const { x, y, mapY } = input;\n  const toX = xMapper(input.mapX);\n  const toY = typeof mapY === 'function' ? mapY : (value: number) => mapY.map(value);\n  let cursor = 0;\n  let nextBreak = 0;\n  for (let i = 0; i < indexes.length; i++) {\n    if (breaks && i === breaks[nextBreak]) {\n      xy[cursor++] = NaN;\n      xy[cursor++] = NaN;\n      nextBreak++;\n    }\n    const index = indexes[i]!;\n    xy[cursor++] = toX(x[index]!);\n    xy[cursor++] = toY(y === 0 ? 0 : y[index]!);\n  }\n  return xy;\n}\n\nexport function buildPath(indexes: Uint32Array, breaks: Uint32Array, input: PathInput): PathMark['xy'] {\n  return pack(indexes, breaks, input);\n}\n\nexport function buildPoints(indexes: Uint32Array, input: PathInput): PointMark['xy'] {\n  return pack(indexes, null, input);\n}\n\ninterface AreaSource extends DrawingInput {\n  readonly mapY: YMap;\n}\n\nexport interface AreaBoundary {\n  readonly xy: Float32Array;\n  readonly selection: JoinedRuns;\n  readonly values: Float64Array;\n  readonly source: AreaSource;\n}\n\nexport interface AreaInput extends AreaSource {\n  readonly upper: Float64Array;\n  /** Pass 0 for an unstacked baseline or the previous band's upperBoundary for a shared edge. */\n  readonly lower: Float64Array | 0 | AreaBoundary;\n}\n\nexport interface SimplifiedArea extends Pick<AreaMark, 'upper' | 'lower' | 'runs'> {\n  readonly upperBoundary: AreaBoundary;\n  /** These slots need point marks because a single x cannot enclose an area. */\n  readonly isolated: Uint32Array;\n}\n\nfunction prepareBoundary(input: AreaSource, values: Float64Array): AreaBoundary {\n  const selection = simplifyBoundary(input, values);\n  return { selection, values, source: input, xy: buildPoints(selection.indexes, { ...input, y: values }) };\n}\n\nfunction canShare(previous: AreaSource, next: AreaSource): boolean {\n  if (previous.x !== next.x || previous.mapX !== next.mapX || previous.mapY !== next.mapY ||\n      previous.range.start !== next.range.start || previous.range.end !== next.range.end ||\n      previous.left !== next.left || previous.width !== next.width ||\n      previous.devicePixelRatio !== next.devicePixelRatio) return false;\n  if (previous.slot === next.slot) return true;\n  for (let i = next.range.start; i < next.range.end; i++) {\n    const a = previous.slot[i];\n    const b = next.slot[i];\n    if (a !== b && (a === SLOT_VALUE || b === SLOT_VALUE || a === SLOT_NO_ROW || b === SLOT_NO_ROW)) return false;\n  }\n  return true;\n}\n\nexport function simplifyArea(input: AreaInput): SimplifiedArea {\n  const { upper, lower, ...source } = input;\n  const upperBoundary = prepareBoundary(source, upper);\n  const upperSelection = upperBoundary.selection;\n  let lowerSelection: JoinedRuns;\n  let lowerXY: Float32Array;\n  if (lower === 0 || lower instanceof Float64Array) {\n    lowerSelection = simplifyBoundary(source, lower);\n    lowerXY = buildPoints(lowerSelection.indexes, { ...source, y: lower });\n  } else {\n    const boundary = canShare(lower.source, source) ? lower : prepareBoundary(source, lower.values);\n    lowerSelection = boundary.selection;\n    lowerXY = boundary.xy;\n  }\n\n  const runs = new Uint32Array(upperSelection.indexes.length === 0 ? 0 : 4 * (upperSelection.breaks.length + 1));\n  let upperStart = 0;\n  let lowerStart = 0;\n  for (let run = 0; run * 4 < runs.length; run++) {\n    const upperEnd = upperSelection.breaks[run] ?? upperSelection.indexes.length;\n    const lowerEnd = lowerSelection.breaks[run] ?? lowerSelection.indexes.length;\n    runs[run * 4] = upperStart;\n    runs[run * 4 + 1] = upperEnd - upperStart;\n    runs[run * 4 + 2] = lowerStart;\n    runs[run * 4 + 3] = lowerEnd - lowerStart;\n    upperStart = upperEnd;\n    lowerStart = lowerEnd;\n  }\n\n  return { upper: upperBoundary.xy, lower: lowerXY, runs, upperBoundary, isolated: upperSelection.isolated };\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '148,208p' docs/02-product-spec.md && sed -n '166,215p' docs/03-plan-typescript-release.md && sed -n '1,130p' packages/axylo/src/layout/index.ts && cat packages/axylo/test/data/helpers.ts && cat package.json\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '148,208p' docs/02-product-spec.md && sed -n '166,215p' docs/03-plan-typescript-release.md && sed -n '1,130p' packages/axylo/src/layout/index.ts && cat packages/axylo/test/data/helpers.ts && cat package.json\"","aggregated_output":"### 3.5 Diagnostic registry\n\nLevel decides delivery. **Error**: the chart or a series cannot be drawn; the chart shows its error state. **Warning**: something is not drawn as given; the reader sees the note in F12. **Hint**: advice for the author. Errors and warnings print once per code per page in every build; hints print in development builds only. `strict: true` throws on errors and warnings found while validating a create, `update` or `append` call, synchronously from that call. A diagnostic that can only arise later (a contrast check after the page's CSS changes, a custom formatter that throws when a table page is built, a label that stops fitting after a resize) is reported when it is found and is never thrown. Every diagnostic names the chart; those about data name the field and the first row indexes in the caller's own data.\n\n| Code | Level | Condition | What is drawn |\n|---|---|---|---|\n| AX100 | Error | Typed columns have different lengths | Error state; the message names the columns and their lengths |\n| AX101 | Error | A named field is not a key of any row | Error state; the message lists the keys that exist and the closest match |\n| AX102 | Warning | A field is absent (`undefined`) in some rows | Gaps |\n| AX103 | Warning | A value is `NaN` or infinite | Gap |\n| AX104 | Hint | Every non-missing value of a value field is a plain decimal string (`'40'`, `'-1.5'`) | Parsed and drawn; the message suggests `parse: 'number'`. An empty string counts as missing |\n| AX105 | Hint | Steps are absent on a regular time or date axis | Gaps |\n| AX106 | Warning | A value field mixes numbers with strings, or holds strings that are not plain decimals (`'1,234'`, `'n/a'`) | The strings are not drawn |\n| AX107 | Warning | A date or time cannot be parsed | That row is not drawn |\n| AX108 | Error | Duplicate x within a series, or duplicate donut labels | That series, or the donut, is not drawn |\n| AX109 | Hint | Numbers on an axis declared `time` look like seconds, or a numeric x looks like epoch milliseconds without `type: 'time'` | As declared |\n| AX110 | Warning | An author domain on bar or area excluded zero | Domain widened to zero |\n| AX111 | Hint | Instants look like calendar dates | As instants, zone shown |\n| AX112 | Hint | Date-time strings have no offset | As written |\n| AX120 | Error | Negative donut value | Error state |\n| AX121 | Warning | More than eight donut slices | Seven largest plus \"Other (n)\" |\n| AX130 | Warning | More than eight series | All series, with dash or marker differences |\n| AX140 | Warning | No `title` and no `labelledBy` | Generated name |\n| AX141 | Warning | Palette below 3:1 on the resolved background | As themed |\n| AX142 | Hint | Plot too small to draw | Summary and table control |\n| AX143 | Hint | Labels hidden after every remedy | Note shown to the reader |\n| AX150 | Warning | Unknown option key | Ignored; the message suggests the closest known key |\n| AX151 | Warning | `append` rows out of order | Accepted through the slower full update |\n| AX131 | Hint | A compact chart has more than one series | Drawn, with dash differences |\n| AX132 | Hint | More bars than pixels along the category axis | Drawn; the message suggests aggregating |\n| AX133 | Hint | A scatter chart has more than 50,000 points | Drawn; the message says drawing may be slow |\n| AX160 | Warning | A custom formatter threw | The default format is used for that value |\n\nExpected results for the Phase 1 fixtures: the combined `dirty` fixture (`[10, 20, null, NaN, '40', undefined, 70]`) yields AX102, AX103 and AX106 once each, draws Mon–Tue as a segment and Sun as a point, and shows the F12 note. `dirty-string` (one `'40'` among numbers) yields AX106. A column made only of numeric strings yields AX104 and is drawn in full. `dirty-null` yields nothing.\n\nThe split between AX104 and AX106 answers a reviewer's objection that common back ends return counts as strings (Postgres `bigint` and `numeric`, BigQuery): a whole column of plain decimal strings is unambiguous and is parsed; a stray string among numbers is a bug and is not.\n\n### 3.6 Type matrix\n\n| | Line | Area | Bar | Donut | Scatter |\n|---|---|---|---|---|---|\n| Picking by pointer | Nearest x | Nearest x | The band under the pointer | The slice under the pointer | Nearest point within 24 px; ties go to the later row |\n| Tooltip content | Every visible series at that x | Same, plus the stack total | Every series in that category | Label, value, percentage | The point's series, x and y; coincident points listed, up to eight |\n| Keyboard order | By x, then series | By x, then series | By category, then series | By slice order | By x, then y |\n| Zoom | Yes | Yes | On time, date and numeric x only | No | Yes, both axes later; x only in 1.0 |\n| Simplified drawing when dense | F5 | F5 on cumulative sums | No; more bars than pixels raises a hint | No | No in 1.0; above 50,000 points a hint says drawing may be slow |\n| Limit that raises a diagnostic | Eight series | Eight series | Eight series | Eight slices | Eight series |\n| Reference lines and bands | Yes; included in the domain; listed in the summary and table caption | Yes | Yes | No | Yes |\n\n### 3.7 Compact variant\n\n`compact: true` on line, area and bar draws the marks and nothing else: no axes, gridlines, legend, toolbar, table control, zoom or tooltip. It is for a small tile where the page already shows the number and the label.\n\n| ID | Criterion | Verified by |\n|---|---|---|\n| C1 | A compact chart is a static image with a full text alternative: `role=\"img\"`, an accessible name (as in A1, including AX140 when none is given) and the generated summary as its description (series, x range, minimum, maximum, last value, omissions). It has no tab stop and no pointer-only behavior, so nothing is available to a mouse that is not available to a keyboard. | Accessibility-tree snapshot; a page of 40 has zero added tab stops |\n| C2 | The fidelity rules still hold: zero baseline for bar and area (F1), gaps (F2), diagnostics (F3), simplified drawing (F5), sorting (F11), no motion (I5), scheme from the page (L4). | The same fixtures as the full charts |\n| C3 | It fills its container at any size from 24×16 CSS px up; with no definite height it is 32 px tall. | Size tests |\n| C4 | With more than one series, lines differ by dash as well as color, since there is no legend; AX131 suggests one series per compact chart. | Two-series fixture |\n| C5 | When values were left out (F12), the description says so and a small marker with a text equivalent appears in the corner. | `dirty` fixture in compact mode |\n\n\n## 2. Architecture\n\n### 2.1 Pipeline\n\n```\noptions ─► normalize ─► frame ──┬─► view model ─► layout ─► scene ─► mark renderer\n            │ validate   (authoritative) │   scales, visible range         text renderer (DOM)\n            ▼ diagnostics                ├─► lookup: exact values by x, by point, by ordinal\n                                         ├─► summary and table\n                                         └─► focus model\n```\n\nThe **frame** is the normalized, lossless data: typed columns, a validity bitmap, dictionary-encoded categories, source-row indexes and a revision number. It is the only source for exact values. The table, the summary, keyboard navigation, tooltips and events read the frame. The **scene** is geometry for drawing and may be simplified (F5); nothing reads values back from it. The first draft derived accessibility from the scene, and two reviewers showed that a simplified drawing cannot return the samples it dropped.\n\n| Stage | Output | Notes |\n|---|---|---|\n| normalize | Frame, diagnostics | The only place raw input is read. Never coerces silently. |\n| view model | Scales, visible index ranges, series visibility | Domain rules implement F1 and F7. |\n| lookup | Nearest-x by binary search; nearest-point by a grid index (scatter) | Works on the frame within the visible range; cost bounded independently of the drawing. |\n| layout | Plot rectangle, tick sets, label boxes, legend and control placement | Implements L1, L3, L8. Takes a text-measurement interface as input. |\n| scene | Flat list of primitives (`path`, `rect`, `arc`, `rule`, `text`) | Plain data; testable in Node with injected text metrics. |\n| renderers | Marks; DOM text; accessibility DOM | See 2.3. |\n\n### 2.2 Invalidation\n\nStages are cached, and the cache keys are explicit. Caching on object identity alone, as the first draft said, would miss font loads, pixel-ratio changes and in-place mutation.\n\n| Stage | Reruns when |\n|---|---|\n| normalize | Data revision or field encoding changes. `append` extends the frame without renormalizing earlier rows. |\n| view model | Frame revision, zoom, series visibility, author domains. |\n| layout | View model; container size; resolved font and text spacing; `document.fonts` finishing a load; locale; any label text. A data-only update reruns layout when the tick labels would change, and skips it otherwise. |\n| scene | Layout or view model. |\n| mark raster | Scene; device pixel ratio; resolved colors (L4's triggers). |\n\nText is measured with the page's computed font, letter spacing and word spacing applied to the measuring context, and layout reruns when fonts finish loading. The measurement interface is a parameter, so Node tests inject fixed metrics and browser tests use the real one.\n\n### 2.3 Rendering\n\n**Working assumption: Canvas 2D for marks, HTML for all text.** Text stays in the DOM so that it inherits the page font and color, honors user text spacing and zoom (A6), adapts in forced-colors mode, and can be selected and translated.\n\n**This is reopened and decided in M1 by measurement.** The first draft justified canvas by Phase 1's slow SVG libraries, but those create a node per point; the one-path-per-series SVG chart in the harness was fast. With drawing simplified to a few vertices per pixel column (F5), an SVG path per series is small. SVG follows CSS variables and class-toggled themes with no repaint code, adapts to forced colors, prints sharply, needs no pixel-ratio handling and allocates no backing store (a 1,920×1,080 canvas at pixel ratio 2 is about 33 MB). Canvas is likely cheaper for per-frame redraw when streaming and hovering.\n\nM1 builds both mark renderers behind the same scene and compares them on: P1, P2, P3, P5, bytes, memory, a runtime theme toggle, forced colors, print, and browser zoom. The scene is renderer-neutral either way, so the choice is contained.\n\n**Simplified drawing.** Per device-pixel column and per contiguous run of valid samples, the stroke covers the run's minimum and maximum (F5). One rule for when it applies: more than four visible samples per device-pixel column on average. The pass over visible samples is O(visible) on typed columns and is measured separately from drawing; the vertex count is bounded by width times the number of runs, not by width alone.\n\n**No animation system.** First render is not animated (I5). Updates cut, or tween for at most 200 ms where the cost is negligible, and not at all under reduced motion.\n\nimport type {\n  BandScale, ContinuousScale, DiagnosticSink, Layout, PlacedText, Projection, Rect,\n  TextMeasurer, TextStyle, TickCandidates, XScale,\n} from '../core/contracts';\nimport { fitBottom, fitLeftCategories, fitValue, placeText, wrapText } from './labels';\nimport type { FittedLabels, Metrics } from './labels';\n\ntype Span = readonly [number, number];\n\ninterface Axis {\n  readonly candidates: TickCandidates;\n  readonly title?: string;\n  readonly mayThin: boolean;\n}\n\nexport interface ValueAxis extends Axis {\n  readonly domain: Span;\n}\n\nexport interface ContinuousAxis extends ValueAxis {\n  readonly type: 'linear' | 'time';\n}\n\nexport interface BandAxis extends Axis {\n  readonly type: 'band';\n  readonly count: number;\n  readonly padding: number;\n}\n\nexport interface ScaleConstructors {\n  linear(domain: Span, range: Span): ContinuousScale;\n  time(domain: Span, range: Span): ContinuousScale;\n  band(count: number, range: Span, padding: number): BandScale;\n}\n\ninterface Size {\n  readonly width: number;\n  readonly height: number;\n}\n\ninterface Axes {\n  /** Logical category or independent axis, including for horizontal bars. */\n  readonly x: ContinuousAxis | BandAxis;\n  readonly y: ValueAxis;\n  readonly scales: ScaleConstructors;\n}\n\ntype Cartesian = Axes & (\n  | { readonly kind: 'xy' }\n  | { readonly kind: 'bands'; readonly horizontal: boolean }\n);\n\ninterface TextInput {\n  readonly measurer: TextMeasurer;\n  readonly style: TextStyle;\n}\n\ntype PlotInput = Size & { readonly diagnostics: DiagnosticSink; readonly compact?: boolean };\n\nexport type LayoutInput =\n  | (PlotInput & Cartesian & TextInput)\n  | (PlotInput & { readonly kind: 'ring' })\n  | (Size & TextInput & { readonly kind: 'message'; readonly message: string });\n\nconst INSET = 4;\nconst GAP = 4;\nconst MIN_WIDTH = 120;\nconst MIN_HEIGHT = 80;\nconst UNCHANGED = { remedies: [], hidden: 0 } as const;\n\nfunction independentScale(axis: Axes['x'], range: Span, scales: ScaleConstructors): XScale {\n  return axis.type === 'band' ? scales.band(axis.count, range, axis.padding) : scales[axis.type](axis.domain, range);\n}\n\nfunction project(plot: Rect, axes: Cartesian): Exclude<Projection, { kind: 'ring' }> {\n  const across: Span = [plot.x, plot.x + plot.width];\n  const up: Span = [plot.y + plot.height, plot.y];\n  const horizontal = axes.kind === 'bands' && axes.horizontal;\n  const x = independentScale(axes.x, horizontal ? up : across, axes.scales);\n  const y = axes.scales.linear(axes.y.domain, horizontal ? across : up);\n  return axes.kind === 'xy' ? { kind: 'xy', x, y } : { kind: 'bands', horizontal, band: x, value: y };\n}\n\nfunction ring(plot: Rect): Projection {\n  const r1 = Math.min(plot.width, plot.height) / 2;\n  return { kind: 'ring', cx: plot.x + plot.width / 2, cy: plot.y + plot.height / 2, r0: r1 * 0.6, r1 };\n}\n\nfunction tooSmall(size: Size, diagnostics: DiagnosticSink): Layout {\n  diagnostics.add({\n    code: 'AX142', level: 'hint', message: 'The plot needs at least 120 × 80 CSS pixels.',\n    effect: 'none', origin: 'presentation',\n  });\n  return { ...size, kind: 'too-small' };\n}\n\nfunction metrics(input: TextInput): Metrics {\n  return { lineHeight: input.style.lineHeight, width: text => input.measurer.width(text, input.style) };\n}\n\nfunction moveText(text: PlacedText, dx: number, dy: number): PlacedText {\n  return { ...text, x: text.x + dx, y: text.y + dy, box: { ...text.box, x: text.box.x + dx, y: text.box.y + dy } };\n}\n\nfunction lane(fit: FittedLabels): number {\n  return fit.texts.length ? GAP + fit.depth : 0;\n}\n\nfunction layoutAxes(input: PlotInput & Cartesian & TextInput, size: Size): Layout {\n  const { width, height } = size;\n  const text = metrics(input);\n  const horizontal = input.kind === 'bands' && input.horizontal;\n  const leftAxis = horizontal ? input.x : input.y;\n  const bottomAxis = horizontal ? input.y : input.x;\n  const leftRole = horizontal ? 'tick-x' : 'tick-y';\n  const bottomRole = horizontal ? 'tick-y' : 'tick-x';\n  const clearance = leftAxis.candidates.some(set => set.length > 0) ? text.lineHeight / 2 : 0;\n  const top = INSET + clearance;\n  let left = INSET;\n  let bottom = INSET + clearance;\n  const visited = new Set<string>();\n  let growMargins = false;\n\n  for (;;) {\n    const plot = { x: left, y: top, width: width - left - INSET, height: height - top - bottom };\n    if (plot.width < MIN_WIDTH || plot.height < MIN_HEIGHT) return tooSmall(size, input.diagnostics);\n\n    const projection = project(plot, input);\n    const xScale = projection.kind === 'xy' ? projection.x : projection.band;\n    const yScale = projection.kind === 'xy' ? projection.y : projection.value;\nimport type { AlignedFrame, Frame } from '../../src/core/contracts';\nimport { normalize, resolveOptions, type ChartType } from '../../src/data';\nimport { DiagnosticCollector } from '../../src/diagnostics';\n\nexport const version = { epoch: 4, revision: 8 };\nexport const utc = { timeZone: 'UTC' };\n\nexport function check(type: ChartType, options: unknown, environment = utc): { frame: Frame; diagnostics: DiagnosticCollector } {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions(type, options, diagnostics);\n  return { frame: normalize(type, resolved, environment, diagnostics, version), diagnostics };\n}\n\nexport function aligned(options: unknown, environment = utc) {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions('line', options, diagnostics);\n  return { frame: normalize('line', resolved, environment, diagnostics, version), diagnostics, resolved };\n}\n\nexport function contents(frame: AlignedFrame) {\n  return {\n    x: { ...frame.x, values: [...frame.x.values] },\n    length: frame.length, xLabel: frame.xLabel, yLabel: frame.yLabel,\n    series: frame.series.map(({ y, slot, row, ...description }) => ({\n      ...description, y: [...y], slot: [...slot], row: row ? [...row] : [...y.keys()],\n    })),\n  };\n}\n{\n  \"name\": \"axylo-workspace\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"typecheck\": \"tsc -p packages/axylo --noEmit && tsc -p docs/api\",\n    \"test\": \"vitest run\",\n    \"build\": \"node scripts/build.mjs\",\n    \"size\": \"node scripts/size.mjs\",\n    \"test:browser\": \"AXYLO_BROWSER=1 vitest run\",\n    \"check\": \"npm run typecheck && npm test && npm run build && npm run test:browser && npm run size\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^26.6.6\",\n    \"axe-core\": \"^4.14.1\",\n    \"esbuild\": \"^0.28.2\",\n    \"fast-check\": \"^4.10.2\",\n    \"playwright-core\": \"^1.65.1\",\n    \"typescript\": \"^7.0.2\",\n    \"vitest\": \"^5.1.0\"\n  }\n}\n","exit_code":0,"status":"completed"}}
