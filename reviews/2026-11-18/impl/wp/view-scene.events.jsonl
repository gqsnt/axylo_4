{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/data/x.ts && cat packages/axylo/src/data/reports.ts && sed -n '1,113p' packages/axylo/src/data/options.ts\"","aggregated_output":"import type { Environment, XColumn, XKind } from '../core/contracts';\nimport type { ResolvedXField } from './options';\nimport { Reports } from './reports';\nimport type { Table } from './table';\n\nconst calendar = /^(\\d{4})(?:-(\\d{2})(?:-(\\d{2}))?)?$/;\nconst dateTime = /^(\\d{4})-(\\d{2})-(\\d{2})[Tt](\\d{2}):(\\d{2})(?::(\\d{2})(?:\\.(\\d+))?)?([Zz]|[+-]\\d{2}:?\\d{2})?$/;\nconst daysInMonth = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\nconst maxInstant = 8_640_000_000_000_000;\nexport const DAY = 86_400_000;\nexport const HOUR = 3_600_000;\nexport type DateUnit = NonNullable<XColumn['dateUnit']>;\n\nfunction validDate(year: string, month = '01', day = '01'): boolean {\n  const m = Number(month);\n  const y = Number(year);\n  const leap = y % 4 === 0 && (y % 100 !== 0 || y % 400 === 0);\n  const max = (daysInMonth[m - 1] ?? 0) + (m === 2 && leap ? 1 : 0);\n  return Number(day) >= 1 && Number(day) <= max;\n}\n\nexport function kindOf(value: unknown): XKind | null {\n  if (typeof value === 'number') return Number.isFinite(value) ? 'number' : null;\n  if (value instanceof Date) return 'time';\n  if (typeof value !== 'string') return null;\n  if (calendar.test(value)) return 'date';\n  const parts = dateTime.exec(value);\n  if (parts) return parts[8] ? 'time' : 'wall';\n  // An invalid ISO-looking value should be reported rather than establishing a category axis.\n  if (/^\\d{4}-\\d{2}-\\d{2}[Tt]/.test(value)) return 'wall';\n  return 'category';\n}\n\nfunction instant(value: string, kind: 'time' | 'wall'): number {\n  const parts = dateTime.exec(value);\n  if (!parts || !validDate(parts[1]!, parts[2], parts[3]) || (kind === 'time') !== Boolean(parts[8])) return NaN;\n  return Date.parse(kind === 'wall' ? value + 'Z' : value);\n}\n\nexport function inferKind(table: Table, field: string, series: string | null = null): XKind | null {\n  let candidate: XKind | null = null;\n  for (let i = 0; i < table.length; i++) {\n    if (series !== null && nameOf(table.read(i, series)) === null) continue;\n    const value = table.read(i, field);\n    const kind = kindOf(value);\n    candidate ??= kind;\n    if (kind === 'number' || kind === 'category') return kind;\n    if (kind === 'date' && typeof value === 'string') {\n      const parts = calendar.exec(value)!;\n      if (validDate(parts[1]!, parts[2], parts[3])) return kind;\n    } else if (value instanceof Date && Number.isFinite(value.getTime())) {\n      return 'time';\n    } else if ((kind === 'time' || kind === 'wall') && typeof value === 'string' && Number.isFinite(instant(value, kind))) {\n      return kind;\n    }\n  }\n  return candidate;\n}\n\nexport function nameOf(value: unknown): string | null {\n  if (typeof value === 'string') return value;\n  if (typeof value === 'boolean' || typeof value === 'number' && Number.isFinite(value)) return String(value);\n  return null;\n}\n\nexport class XParser {\n  readonly timeZone: string | null;\n  readonly categories: string[] | null;\n  private readonly indexes: Map<string, number> | null;\n  dateUnit: DateUnit | null = null;\n\n  constructor(\n    readonly field: ResolvedXField,\n    readonly kind: XKind,\n    env: Pick<Environment, 'timeZone'>,\n    private readonly scatter = false,\n    categories?: readonly string[],\n  ) {\n    this.timeZone = kind === 'time' ? (field.timeZone === 'local' ? env.timeZone : field.timeZone) : null;\n    this.categories = kind === 'category' ? [...(categories ?? [])] : null;\n    this.indexes = this.categories ? new Map(this.categories.map((name, index) => [name, index])) : null;\n  }\n\n  private parse(raw: unknown, row: number, reports: Reports): number {\n    const kind = this.kind;\n    if (typeof raw === 'number' && Number.isFinite(raw)) {\n      if (kind === 'number' && !this.field.type && Math.abs(raw) >= 1e11 && Math.abs(raw) < 1e14) {\n        reports.add('AX109', 'none', row, undefined, 'Set type: \\'time\\' if these values are epoch milliseconds.');\n      }\n      if (kind === 'time' && this.field.type === 'time' && Math.abs(raw) >= 1e9 && Math.abs(raw) < 1e10) {\n        reports.add('AX109', 'none', row, undefined, 'These values look like seconds. Multiply them by 1,000 to supply epoch milliseconds.');\n      }\n      if (kind === 'number' || kind === 'time' && this.field.type === 'time' && Math.abs(raw) <= maxInstant) return raw;\n    }\n    if (kind === 'time' && raw instanceof Date) return raw.getTime();\n    if (kind === 'category' && !this.scatter) {\n      const name = this.field.type === 'category' ? nameOf(raw) : typeof raw === 'string' && kindOf(raw) === 'category' ? raw : null;\n      if (name === null) return NaN;\n      const known = this.indexes!.get(name);\n      if (known !== undefined) return known;\n      const index = this.categories!.length;\n      this.categories!.push(name);\n      this.indexes!.set(name, index);\n      return index;\n    }\n    if (typeof raw !== 'string') return NaN;\n    if (kind === 'date') {\n      const parts = calendar.exec(raw);\n      if (!parts || !validDate(parts[1]!, parts[2], parts[3])) return NaN;\n      const unit = parts[3] !== undefined ? 'day' : parts[2] !== undefined ? 'month' : 'year';\n      if (this.dateUnit === null || unit === 'day' || unit === 'month' && this.dateUnit === 'year') this.dateUnit = unit;\n      return Date.parse(parts[1] + '-' + (parts[2] ?? '01') + '-' + (parts[3] ?? '01') + 'T00:00:00Z');\n    }\n    if (kind === 'wall' || kind === 'time') {\n      const position = instant(raw, kind);\n      if (kind === 'wall' && Number.isFinite(position)) reports.add('AX112', 'none', row);\n      return position;\n    }\n    return NaN;\n  }\n\n  read(raw: unknown, row: number, reports: Reports): number {\n    if (raw === undefined) {\n      reports.add('AX102', 'omitted', row);\n      return NaN;\n    }\n    const result = this.parse(raw, row, reports);\n    if (!Number.isFinite(result)) {\n      const fix = this.scatter && this.kind === 'category'\n        ? 'Use a numeric, calendar date or time field for scatter x values.'\n        : undefined;\n      reports.add('AX107', 'omitted', row, raw, fix);\n    }\n    return result;\n  }\n\n  restore(categoryCount: number, dateUnit: DateUnit | null): void {\n    this.dateUnit = dateUnit;\n    if (!this.categories) return;\n    while (this.categories.length > categoryCount) this.indexes!.delete(this.categories.pop()!);\n  }\n\n  column(values: Float64Array, snapshotCategories = false): XColumn {\n    const names = this.categories;\n    const length = names?.length;\n    let snapshot: readonly string[] | undefined;\n    return {\n      kind: this.kind, values,\n      get categories() {\n        return names === null || !snapshotCategories ? names : (snapshot ??= names.slice(0, length));\n      },\n      timeZone: this.timeZone, dateUnit: this.kind === 'date' ? this.dateUnit ?? 'day' : null,\n      ordered: this.kind === 'category' && this.field.ordered,\n    };\n  }\n}\n\nexport function dailyDelta(delta: number): number {\n  const days = Math.round(delta / DAY);\n  return days > 0 && Math.abs(delta - days * DAY) <= HOUR ? days * DAY : delta;\n}\n\nexport function sameDailyTime(first: number, position: number): boolean {\n  const delta = position - first;\n  return Math.abs(delta - Math.round(delta / DAY) * DAY) <= HOUR;\n}\nimport type { DiagnosticEffect, DiagnosticSink } from '../core/contracts';\nimport { report, type DiagnosticCode } from '../diagnostics';\nimport type { DiagnosticTrace } from './store-diagnostics';\n\nexport class Reports {\n  private readonly entries = new Map<DiagnosticCode, {\n    effect: DiagnosticEffect;\n    count: number;\n    rows: number[];\n    examples: string[];\n    detail?: string;\n  }>();\n\n  constructor(private readonly field: string, private readonly sink?: DiagnosticTrace) {}\n\n  add(code: DiagnosticCode, effect: DiagnosticEffect, row: number, example?: unknown, detail?: string): void {\n    let entry = this.entries.get(code);\n    if (!entry) {\n      entry = { effect, count: 0, rows: [], examples: [], detail };\n      this.entries.set(code, entry);\n    }\n    this.sink?.traceRow?.(code, this.field, effect, row);\n    entry.count++;\n    if (entry.rows.length < 10) {\n      entry.rows.push(row);\n      if (example !== undefined) {\n        const text = typeof example === 'string' ? JSON.stringify(example)\n          : example !== null && typeof example === 'object' ? Object.prototype.toString.call(example) : String(example);\n        entry.examples.push(text);\n      }\n    }\n  }\n\n  flush(sink: DiagnosticSink): void {\n    for (const [code, { effect, count, rows, examples, detail }] of this.entries) {\n      report(sink, code, effect, { field: this.field, count, rows, examples, detail });\n    }\n  }\n}\nimport type { DiagnosticSink } from '../core/contracts';\nimport type { ValueFieldOptions, XFieldOptions } from '../public';\nimport { report } from '../diagnostics';\nimport { columnsTable, rowsTable, type Columns, type Table } from './table';\n\nexport type AlignedChartType = 'line' | 'area' | 'bar';\nexport type ChartType = AlignedChartType | 'scatter' | 'donut';\n\nexport interface ResolvedXField {\n  readonly field: string;\n  readonly label: string;\n  readonly unit: string | null;\n  readonly type: NonNullable<XFieldOptions['type']> | null;\n  readonly timeZone: string;\n  readonly ordered: boolean;\n  readonly format: NonNullable<XFieldOptions['format']> | null;\n  readonly tickFormat: NonNullable<XFieldOptions['tickFormat']> | null;\n  readonly domain: NonNullable<XFieldOptions['domain']> | null;\n}\n\nexport interface ResolvedValueField {\n  readonly field: string;\n  readonly label: string;\n  readonly unit: string | null;\n  readonly scale: NonNullable<ValueFieldOptions['scale']> | null;\n  readonly missing: NonNullable<ValueFieldOptions['missing']>;\n  readonly parse: 'number' | null;\n  readonly format: NonNullable<ValueFieldOptions['format']> | null;\n  readonly tickFormat: NonNullable<ValueFieldOptions['tickFormat']> | null;\n  readonly domain: NonNullable<ValueFieldOptions['domain']> | null;\n}\n\nexport interface ResolvedOptions {\n  readonly table: Table;\n  readonly x: ResolvedXField;\n  readonly values: readonly ResolvedValueField[];\n  readonly form: 'long' | 'wide';\n  readonly series: string | null;\n  readonly valid: boolean;\n  readonly name: string;\n}\n\nconst common = ['data', 'title', 'labelledBy', 'subtitle', 'description', 'state', 'legend', 'tooltip',\n  'table', 'colors', 'messages', 'locale', 'strict', 'onDiagnostic'];\nconst cartesian = [...common, 'x', 'y', 'series', 'zoom', 'reference'];\nconst aligned = [...cartesian, 'compact'];\nconst keysForChart: Record<ChartType, readonly string[]> = {\n  line: aligned, area: [...aligned, 'stacked'], bar: [...aligned, 'layout', 'horizontal'],\n  scatter: cartesian, donut: [...common, 'label', 'value'],\n};\nconst fieldKeys = ['field', 'label', 'unit', 'format', 'tickFormat', 'domain'];\nconst scatterXKeys = [...fieldKeys, 'type', 'timeZone'];\nconst xKeys = [...scatterXKeys, 'ordered'];\nconst valueKeys = [...fieldKeys, 'scale', 'missing', 'parse'];\nconst messageKeys = ['viewAsTable', 'hideTable', 'noData', 'noObservation', 'incompleteStack', 'moreRows', 'otherSlices',\n  'valuesNotShown', 'valuesChanged', 'labelsHidden', 'loading', 'empty', 'error', 'internalError', 'chartName',\n  'chartSummary', 'seriesSummary', 'referenceSummary', 'timeZoneNote', 'plotLabel', 'controlsLabel', 'pointOf',\n  'zoomIn', 'zoomOut', 'resetZoom', 'pause', 'resume', 'previousPage', 'nextPage', 'pageOf', 'jumpToX'];\n\nfunction distance(a: string, b: string): number {\n  const costs = Array.from({ length: b.length + 1 }, (_, i) => i);\n  for (let i = 1; i <= a.length; i++) {\n    let diagonal = costs[0]!;\n    costs[0] = i;\n    for (let j = 1; j <= b.length; j++) {\n      const above = costs[j]!;\n      costs[j] = Math.min(above + 1, costs[j - 1]! + 1, diagonal + (a[i - 1] === b[j - 1] ? 0 : 1));\n      diagonal = above;\n    }\n  }\n  return costs[b.length]!;\n}\n\nfunction closest(name: string, keys: readonly string[]): string | undefined {\n  let suggestion: string | undefined;\n  let best = Infinity;\n  for (const key of keys) {\n    const score = distance(name.toLowerCase(), key.toLowerCase());\n    if (score < best) {\n      suggestion = key;\n      best = score;\n    }\n  }\n  return suggestion;\n}\n\nfunction object(value: unknown): Record<string, unknown> {\n  return value !== null && typeof value === 'object' ? value as Record<string, unknown> : {};\n}\n\nfunction unknownKeys(options: Record<string, unknown>, keys: readonly string[], sink: DiagnosticSink, path = ''): void {\n  for (const key of Object.keys(options)) {\n    if (!keys.includes(key)) {\n      const suggestion = closest(key, keys);\n      report(sink, 'AX150', 'none', { field: path + key, suggestion: suggestion && path + suggestion, count: 1 });\n    }\n  }\n}\n\nfunction resolveTable(data: unknown, sink: DiagnosticSink): { table: Table; valid: boolean } {\n  if (Array.isArray(data)) return { table: rowsTable(data), valid: true };\n  const columns = object(object(data).columns) as Columns;\n  const keys = Object.keys(columns);\n  const length = columns[keys[0] ?? '']?.length ?? 0;\n  const differing = keys.find(key => columns[key]?.length !== length);\n  if (differing !== undefined) {\n    report(sink, 'AX100', 'chart-error', {\n      field: differing, count: 1, examples: keys.map(key => JSON.stringify(key) + ': ' + columns[key]?.length),\n    });\n  }\n  return { table: columnsTable(columns, length), valid: differing === undefined };\n}\n\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"cat tsconfig.base.json && cat packages/axylo/test/simplify/simplify.test.ts && sed -n '90,116p' docs/02-product-spec.md && cat packages/axylo/src/theme/palette.ts | head -70 && rg -n 'stack|reference|domain' packages/axylo/src/index.ts\"","aggregated_output":"{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"strict\": true,\n    \"noUncheckedIndexedAccess\": true,\n    \"exactOptionalPropertyTypes\": false,\n    \"noImplicitOverride\": true,\n    \"noFallthroughCasesInSwitch\": true,\n    \"isolatedModules\": true,\n    \"verbatimModuleSyntax\": true,\n    \"skipLibCheck\": true,\n    \"declaration\": true,\n    \"types\": [\n      \"node\"\n    ]\n  }\n}\nimport fc from 'fast-check';\nimport { describe, expect, it } from 'vitest';\nimport {\n  SLOT_ABSENT_FIELD, SLOT_GAP, SLOT_INVALID, SLOT_NO_ROW, SLOT_NULL, SLOT_VALUE,\n} from '../../src/core/contracts';\nimport { buildPath, buildPoints, joinRuns, simplifyArea, simplifyLine } from '../../src/simplify';\nimport type { LineInput } from '../../src/simplify';\n\nconst identity = (value: number) => value;\nconst range = (end: number, start = 0) => ({ start, end });\nconst indexes = (start: number, end: number) => Array.from({ length: end - start }, (_, i) => start + i);\n\nfunction line(y: readonly number[], slot: readonly number[] = y.map(() => SLOT_VALUE)): LineInput {\n  return {\n    x: Float64Array.from(y, (_, i) => i / 32),\n    y: Float64Array.from(y),\n    slot: Uint8Array.from(slot),\n    range: range(y.length),\n    mapX: identity,\n    left: 0,\n    width: 1,\n    devicePixelRatio: 1,\n  };\n}\n\ndescribe('joining and drawing lines', () => {\n  it('bridges only no-row slots and reports isolated values in the draw range', () => {\n    const slot = Uint8Array.of(\n      SLOT_VALUE, SLOT_VALUE, SLOT_NO_ROW, SLOT_VALUE, SLOT_NULL, SLOT_VALUE,\n      SLOT_INVALID, SLOT_VALUE, SLOT_GAP, SLOT_VALUE, SLOT_ABSENT_FIELD, SLOT_VALUE,\n      SLOT_NO_ROW, SLOT_VALUE, SLOT_NULL, SLOT_VALUE, SLOT_NO_ROW, SLOT_VALUE, SLOT_VALUE,\n    );\n    const joined = joinRuns(slot, range(18, 1));\n    expect([...joined.indexes]).toEqual([1, 3, 11, 13, 15, 17]);\n    expect([...joined.breaks]).toEqual([2, 4]);\n    expect([...joined.isolated]).toEqual([5, 7, 9]);\n    expect(joinRuns(slot, range(4, 4))).toEqual({\n      indexes: new Uint32Array(), breaks: new Uint32Array(), isolated: new Uint32Array(),\n    });\n  });\n\n  it('keeps both peaks, breaks the path in the same column, and packs the isolated point', () => {\n    const input = line(\n      [0, 1, 12, 2, 2, 0, NaN, 0, 2, 20, 1, 0, NaN, 8],\n      [0, 0, 0, 0, 0, 0, SLOT_GAP, 0, 0, 0, 0, 0, SLOT_NULL, 0],\n    );\n    const kept = simplifyLine(input);\n    expect([...kept.indexes]).toEqual([0, 2, 5, 7, 9, 11]);\n    expect([...kept.breaks]).toEqual([3]);\n    expect([...kept.isolated]).toEqual([13]);\n\n    const projection = { ...input, mapX: (x: number) => x * 32, mapY: (y: number) => 100 - y };\n    expect(buildPath(kept.indexes, kept.breaks, projection)).toEqual(Float32Array.of(\n      0, 100, 2, 88, 5, 100, NaN, NaN, 7, 100, 9, 80, 11, 100,\n    ));\n    expect(buildPoints(kept.isolated, projection)).toEqual(Float32Array.of(13, 92));\n  });\n\n  it('keeps every alternating value as an isolated point in a single column', () => {\n    const input = line(indexes(0, 32), indexes(0, 32).map(i => i % 2 ? SLOT_NULL : SLOT_VALUE));\n    const kept = simplifyLine(input);\n    expect([...kept.indexes]).toEqual([]);\n    expect([...kept.breaks]).toEqual([]);\n    expect([...kept.isolated]).toEqual(indexes(0, 16).map(i => 2 * i));\n  });\n\n  it('keeps every value at the density threshold and simplifies just above it', () => {\n    const input = line(indexes(0, 9));\n    const highDpi = { ...input, y: Float32Array.from(input.y), devicePixelRatio: 2 };\n    expect([...simplifyLine({ ...highDpi, range: range(8) }).indexes]).toEqual(indexes(0, 8));\n    expect([...simplifyLine(highDpi).indexes]).toEqual([0, 8]);\n  });\n\n  it('counts value slots instead of no-row slots when deciding whether to simplify', () => {\n    const y = indexes(0, 25);\n    const input = line(y, y.map(i => i % 8 ? SLOT_NO_ROW : SLOT_VALUE));\n    const kept = simplifyLine(input);\n    expect([...kept.indexes]).toEqual([0, 8, 16, 24]);\n    expect([...kept.breaks]).toEqual([]);\n  });\n\n  it('counts the device columns touched by a fractional plot range', () => {\n    const input = line(indexes(0, 9));\n    const shifted = { ...input, left: 0.75, mapX: (x: number) => x + 0.75 };\n    expect([...simplifyLine({ ...shifted, range: range(8) }).indexes]).toEqual(indexes(0, 8));\n    expect([...simplifyLine(shifted).indexes]).toEqual([0, 7, 8]);\n  });\n\n  it('keeps the earlier extremes and both endpoints with irregular x and a partial draw range', () => {\n    const input = {\n      ...line([-100, 4, -2, -2, 8, 8, 3, 5, 9, 9, -1, -1, 2, 6, 100]),\n      x: Float64Array.of(-2, -0.99, -0.91, -0.9, -0.89, -0.85, -0.21, 0.01, 0.12, 0.25, 0.27, 0.43, 0.65, 0.99, 1.3),\n      range: range(14, 1),\n      left: -1,\n      width: 2,\n    };\n    expect([...simplifyLine(input).indexes]).toEqual([1, 2, 4, 6, 7, 8, 10, 13]);\n  });\n\n  it('keeps a million-slot outlier at multiple plot widths and device ratios', () => {\n    const count = 1_000_000;\n    const outlier = 701_337;\n    const x = Float64Array.from({ length: count }, (_, index) => index / count);\n    const y = new Float64Array(count).fill(3);\n    y[outlier] = 1000;\n    const slot = new Uint8Array(count);\n    for (const width of [97, 320, 877]) {\n      for (const devicePixelRatio of [1, 2]) {\n        const mapX = (sample: number) => sample * width;\n        const column = (index: number) => Math.floor(mapX(x[index]!) * devicePixelRatio);\n        expect(column(outlier - 1)).toBe(column(outlier + 1));\n\n        const before = performance.now();\n        const kept = simplifyLine({ x, y, slot, range: range(count), mapX, left: 0, width, devicePixelRatio });\n        const ms = performance.now() - before;\n        console.info(`Simplified ${count} slots at ${width}px and DPR ${devicePixelRatio} in ${ms.toFixed(1)} ms`);\n        expect(ms).toBeLessThan(200);\n        expect(kept.indexes).toContain(outlier);\n        expect(kept.indexes.length).toBe(2 * width * devicePixelRatio + 1);\n      }\n    }\n  });\n\n  it('preserves column extrema and endpoints, never crosses a break, and is idempotent', () => {\n    const state = fc.oneof(\n      { weight: 6, arbitrary: fc.constant(SLOT_VALUE) },\n      { weight: 2, arbitrary: fc.constant(SLOT_NO_ROW) },\n      { weight: 1, arbitrary: fc.constantFrom(SLOT_NULL, SLOT_INVALID, SLOT_GAP, SLOT_ABSENT_FIELD) },\n    );\n    const row = fc.record({ state, y: fc.integer({ min: -20, max: 20 }), dx: fc.integer({ min: 1, max: 10 }) });\n    fc.assert(fc.property(\n      fc.array(row, { maxLength: 180, size: 'large' }), fc.integer({ min: 1, max: 40 }), fc.constantFrom(0.75, 1, 1.5, 2),\n      fc.nat(10), fc.nat(10),\n      (rows, width, ratio, skipStart, skipEnd) => {\n        let current = 0;\n        const x = Float64Array.from(rows, row => current += row.dx);\n        const y = Float64Array.from(rows, row => row.y);\n        const slot = Uint8Array.from(rows, row => row.state);\n        const start = Math.min(skipStart, rows.length);\n        const end = Math.max(start, rows.length - skipEnd);\n        const left = -0.25;\n        const mapX = (p: number) => left + p * width / (current + 1);\n        const input = { x, y, slot, range: range(end, start), mapX, left, width, devicePixelRatio: ratio };\n        const kept = simplifyLine(input);\n\n        const values = indexes(start, end).filter(i => slot[i] === SLOT_VALUE);\n        const runs: number[][] = [];\n        for (const [offset, index] of values.entries()) {\n          const previous = values[offset - 1];\n          if (previous === undefined || !slot.slice(previous + 1, index).every(state => state === SLOT_NO_ROW)) {\n            runs.push([index]);\n          } else {\n            runs[runs.length - 1]!.push(index);\n          }\n        }\n        const dense = values.length > 4 * (Math.ceil((left + width) * ratio) - Math.floor(left * ratio));\n        const expected: number[] = [];\n        const breaks: number[] = [];\n        const isolated: number[] = [];\n        let columns = 0;\n        for (const run of runs) {\n          if (run.length === 1) {\n            isolated.push(run[0]!);\n            columns++;\n            continue;\n          }\n          if (expected.length) breaks.push(expected.length);\n          const byColumn = new Map<number, number[]>();\n          for (const index of run) {\n            const column = Math.floor(mapX(x[index]!) * ratio);\n            const group = byColumn.get(column);\n            if (group) group.push(index);\n            else byColumn.set(column, [index]);\n          }\n          columns += byColumn.size;\n          for (const group of byColumn.values()) {\n            const samples = group.map(i => y[i]!);\n            const targets = new Set([\n              group[0]!, group[group.length - 1]!,\n              group[samples.indexOf(Math.min(...samples))]!, group[samples.indexOf(Math.max(...samples))]!,\n            ]);\n            expected.push(...group.filter(i => !dense || targets.has(i)));\n          }\n        }\n\n        expect([...kept.indexes]).toEqual(expected);\n        expect([...kept.breaks]).toEqual(breaks);\n        expect([...kept.isolated]).toEqual(isolated);\n        expect(kept.indexes.every((index, i) => slot[index] === SLOT_VALUE && (i === 0 || index > kept.indexes[i - 1]!))).toBe(true);\n        if (dense) expect(kept.indexes.length + kept.isolated.length).toBeLessThanOrEqual(4 * columns);\n\n        const selection = new Set([...kept.indexes, ...kept.isolated]);\n        const thinned = Uint8Array.from(slot, (state, i) => state === SLOT_VALUE && !selection.has(i) ? SLOT_NO_ROW : state);\n        expect(simplifyLine({ ...input, slot: thinned })).toEqual(kept);\n      },\n    ), { numRuns: 300 });\n  });\n});\n\ndescribe('drawing areas', () => {\n  const upper = [3, 8, 1, 8, 2, 4, NaN, 4, 4, 4, 11, 4, 4, 2, NaN, 5];\n  const bottom = [0, 0, 0, -4, 0, 0, NaN, -1, -4, 0, -4, 0, 0, -1, NaN, 0];\n  const base = line(upper, upper.map(y => Number.isNaN(y) ? SLOT_GAP : SLOT_VALUE));\n  const input = { ...base, upper: Float64Array.from(upper), lower: Float64Array.from(bottom), mapY: identity };\n  const sourceIndexes = (xy: Float32Array) => Array.from(xy.filter((_, i) => i % 2 === 0), x => x * 32);\n\n  it('preserves each boundary’s own extremes and pairs matching endpoints across breaks', () => {\n    const area = simplifyArea(input);\n    expect(sourceIndexes(area.upper)).toEqual([0, 1, 2, 5, 7, 10, 13]);\n    expect(sourceIndexes(area.lower)).toEqual([0, 3, 5, 7, 8, 9, 13]);\n    expect([...area.runs]).toEqual([0, 4, 0, 3, 4, 3, 3, 4]);\n    expect([...area.isolated]).toEqual([15]);\n  });\n\n  it('shares an exact packed edge between adjacent bands and recalculates it for a new range', () => {\n    const area = simplifyArea(input);\n    const adjacent = { ...input, slot: input.slot.slice(), upper: Float64Array.from(input.upper, y => y + 10), lower: area.upperBoundary };\n    const next = simplifyArea(adjacent);\n    expect(next.lower).toBe(area.upper);\n    expect([...next.runs]).toEqual([0, 4, 0, 4, 4, 3, 4, 3]);\n    const zoomed = simplifyArea({ ...adjacent, range: range(14, 1) });\n    expect(zoomed.lower).not.toBe(area.upper);\n    expect(sourceIndexes(zoomed.lower)).toEqual([1, 2, 5, 7, 10, 13]);\n  });\n\n  it('recalculates a shared edge if the adjacent band has a different gap', () => {\n    const area = simplifyArea(input);\n    const slot = input.slot.slice();\n    slot[3] = SLOT_NULL;\n    const next = simplifyArea({ ...input, slot, lower: area.upperBoundary });\n    expect(next.lower).not.toBe(area.upper);\n    expect(sourceIndexes(next.lower)).toEqual([0, 1, 2, 4, 5, 7, 10, 13]);\n    expect([...next.runs]).toEqual([0, 3, 0, 3, 3, 2, 3, 2, 5, 3, 5, 3]);\n  });\n\n  it('supports an unstacked zero baseline without a full lower data column', () => {\n    const area = simplifyArea({ ...input, lower: 0, mapY: y => 100 - y });\n    expect(sourceIndexes(area.lower)).toEqual([0, 5, 7, 13]);\n    expect([...area.lower.filter((_, i) => i % 2 === 1)]).toEqual([100, 100, 100, 100]);\n    expect([...area.runs]).toEqual([0, 4, 0, 2, 4, 3, 2, 2]);\n  });\n});\n### 3.1 Faithful representation\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| F1 | Bar and area value axes always include zero. An author `domain` that excludes zero is widened and raises AX110. | Property test on domains, including all-negative and mixed-sign data; `bars` fixture (values 82–97) starts at 0 | R1 |\n| F2 | Missing values are never drawn as zero and never bridged unless the author asks. An explicit `null` is a gap, silently. An isolated value between two gaps is a visible point. A missing bar shows a \"no data\" mark at the baseline, distinct from a zero bar. On a time or date axis with a regular step, an absent step is a gap and raises AX105; `missing: 'zero'` on the field turns absent and null values into zeros for counts. Tooltip, table and announcements say \"No data\". | `trend` with nulls and `trend` with the same 7 rows deleted render the same gap; `dirty` fixtures; property test that no segment connects across a missing index | R5 |\n| F3 | Input that cannot be plotted as given is reported, never guessed. The diagnostic registry (section 3.5) fixes each case's level, what is drawn and what the reader sees. | One test per code; the combined `dirty` fixture and the four one-bad-value fixtures yield exactly the codes listed in section 3.5 | R5, D5 |\n| F4 | Three temporal types, never mixed silently. **Calendar dates** (`2026-02-24`, `2026-02`, `2026`) read the same in every viewer time zone. **Instants** (epoch milliseconds declared `type: 'time'`, `Date` objects, ISO strings with an offset) are shown in `timeZone` (default: the viewer's), with the zone named in the tooltip heading and the description. **Wall-clock times** (date-time strings without an offset) are shown as written, with hint AX112. Instants that all fall on the same time of day, whole days apart, raise hint AX111 (\"these look like calendar dates\"). A bare number is never assumed to be an instant. | Four fixture variants in UTC, America/Los_Angeles and Asia/Kolkata: (a) date strings: identical text in all three; (b) ISO strings with `Z`, (c) epoch ms with `type: 'time'`, (d) `Date` objects: each zone's correct local text, zone visible, AX111 raised; with `timeZone: 'UTC'` or `type: 'date'`: identical. Plus: both DST transitions, a leap day, an unparseable date | R3 |\n| F5 | No smoothing. When a line is denser than the screen, the drawing is simplified with this guarantee: for every device-pixel column, and every contiguous run of valid samples inside it, the drawn stroke covers exactly that run's minimum and maximum. A gap is drawn whenever at least one whole column contains no valid sample. Stacked areas are simplified on their cumulative sums. Exact values always come from the data, not the drawing. | Assertions on which source samples the drawing kept, for: one outlier in 1,000,000; two peaks and a gap in one column; alternating valid and missing samples; tied extremes; device pixel ratio 1 and 2; several zoom levels. A sample that the drawing dropped is still reachable by keyboard and in the table | D8, D9 |\n| F6 | Numbers and dates are formatted for the page locale. Ticks and readouts are formatted separately: ticks may be compact (`50K`); tooltip, table and announcements show the full integer part, and the fraction with up to six significant digits not counting the fraction's leading zeros (`123,456.75`; `0.000123456`; `0.1 + 0.2` reads `0.3`), with the unit. A custom formatter that throws falls back to the default and raises a diagnostic. | Expected strings for chosen values (large integers, small decimals, percentages, zoned times) in `en-US`, `de-DE` and `en-IN` | R4 |\n| F7 | Domains follow one order of precedence: the zoomed view is inside the author's `domain` if given, otherwise inside the automatic domain. The automatic domain contains all data, reference lines and stack totals, and ends at the first tick at or beyond each extreme. A field declared `scale: 'percent'` (0–100) or `'ratio'` (0–1) ends at full scale only when its maximum is at least half of full scale and not above it. Nothing is inferred from a label. | Property tests; `bars` ends at 100 when declared `percent`; a 4% maximum ends at the first tick at or above 4% | R1 |\n| F8 | Donut: slices keep the given order, start at 12 o'clock and run clockwise. The legend shows every slice's value and percentage as text, in slice order. A zero slice is listed without an arc; a `null` slice is listed as \"No data\". A negative value is AX120 and the chart shows its error state. With more than eight slices, the seven largest are drawn and the rest are grouped as \"Other (n)\", with AX121; the table lists every category. An all-zero donut shows the empty state. | `parts` fixture; one test per case | R7, landscape scoreboard 3.1 |\n| F9 | Up to eight series, no two share a color. Beyond eight, each series still has a unique combination of color and dash or marker, and AX130 is raised. | Tests with 6, 8 and 12 series | R7 |\n| F10 | Stacks place positive and negative values on their own sides of zero, and the axis covers both totals. A missing component is drawn with zero height and the stack is marked \"incomplete\" in tooltip, table and announcements. | Property test on stacked geometry; mixed-sign and incomplete fixtures | R5 |\n| F11 | Line, area and scatter are drawn in x order whatever the input order. On line, area and bar, two rows with the same x in one series are AX108 and that series is not drawn. On scatter, points sharing an x (or both coordinates) are ordinary data. | Shuffled `trend` renders identically; duplicate fixture | R5 |\n| F12 | When a warning means values were left out or changed, the chart says so to the reader: a short note (\"2 values not shown. See table.\") inside the figure and in the accessibility tree, in every build. | Production build given `dirty` shows the note | R5, R6 |\n\n### 3.2 Legibility\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| L1 | No visible text overlaps other text or is clipped, and no label disappears without the reader being told. Remedies, in order: thin (time, date, numeric and `ordered` category axes only); wrap to two lines; rotate up to 45°; truncate in the middle, keeping every label distinct, with the full text in tooltip and table. If labels still do not fit, a visible note (\"Some labels hidden. See table.\") appears and AX143 suggests horizontal bars. Axylo never changes a chart's orientation on its own. | In real browsers, after fonts load: for widths 240–1,920 px and generated label sets, zero intersecting text boxes (1 px tolerance), zero text outside the figure, truncated labels pairwise distinct. Repeated with the WCAG 1.4.12 text-spacing overrides, 200% text-only zoom, and a font that loads late | R2 |\n| L2 | Text is at least 12 CSS px and at least 4.5:1 against what is behind it, including text drawn inside a mark and legend entries for hidden series. Marks, axis lines and focus indicators are at least 3:1. Gridlines are exempt: they are not needed to read a value while the tooltip and table exist. Holds in light and dark. | Computed-style and rendered-pixel checks in both schemes | R7, R10 |\n| L3 | The chart follows its container with no call from the page, in both directions. With no definite height, the plot is 16:9, clamped between 160 and 480 CSS px tall, and the title, controls and table flow above and below it. A container that starts hidden or zero-sized draws when it gets a size. | Resize 720 → 360 → 720 px; hidden-then-shown test; `height: auto` container is stable over 10 frames | R16, D1 |\n| L4 | Light or dark is taken from the chart element's computed `color-scheme`; if that is not set, from the luminance of the inherited text color. `--axylo-background` overrides both. Marks repaint within one frame when the scheme, forced colors, contrast preference, or the `class`, `style` or `data-theme` of `<html>` or `<body>` changes. Forced-colors mode uses system colors. | A page that sets `color-scheme`; a class-toggled dark theme without it; a light-only page on a dark device (must stay light); a runtime toggle; forced-colors emulation | R10 |\n| L5 | A marker on every point appears only when adjacent points are at least 12 px apart (provisional value), and always for isolated points. | `trend` at 720 px has none; a 12-point line has them | R8 |\n| L6 | Title, subtitle and axis titles with units are part of the chart. Axis titles never overlap tick labels. | Layout tests; `trend` fixture | R9 |\n/**\n * Default colors. The series sets are the provisional \"usable-light-8\" and \"usable-dark-8\" results of the\n * palette search (research/palette/feasibility.json); a later milestone tunes them. Token colors meet spec\n * L2 on their scheme's background: axis and focus at least 3:1, muted and reference at least 4.5:1 because\n * they are also used for text (hidden legend entries, reference labels). Grid is exempt.\n *\n * Text has no default: the chart inherits the page's `color` (spec DX6).\n */\nexport interface SchemeColors {\n  readonly background: string;\n  readonly axis: string;\n  readonly grid: string;\n  readonly muted: string;\n  readonly reference: string;\n  readonly focus: string;\n  readonly series: read