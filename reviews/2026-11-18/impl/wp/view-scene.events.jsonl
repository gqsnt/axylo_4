{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '140,320p' packages/axylo/src/simplify/index.ts && cat packages/axylo/src/scale/{index,domain,linear,band}.ts && rg -n '\"'^export'\"' packages/axylo/src/scale/{nice,time}.ts\"","aggregated_output":"        if (indexes) indexes[vertices] = runFirst;\n        vertices++;\n      }\n      if (indexes) indexes[vertices] = i;\n      vertices++;\n    }\n    runLast = i;\n  }\n  return { values, vertices, breaks, isolated };\n}\n\nfunction select(slot: Uint8Array, range: IndexRange, limit: number, columns?: Columns): JoinedRuns {\n  const size = scan(slot, range, columns);\n  const dense = size.values > limit;\n  const output: JoinedRuns = {\n    indexes: new Uint32Array(dense ? size.vertices : size.values - size.isolated),\n    breaks: new Uint32Array(size.breaks),\n    isolated: new Uint32Array(size.isolated),\n  };\n  scan(slot, range, dense ? columns : undefined, output);\n  return output;\n}\n\nexport function joinRuns(slot: Uint8Array, range: IndexRange): JoinedRuns {\n  return select(slot, range, Infinity);\n}\n\nfunction simplifyBoundary(input: DrawingInput, y: Values | 0): JoinedRuns {\n  const { left, width, devicePixelRatio: ratio, range } = input;\n  const columns = width > 0 ? Math.ceil((left + width) * ratio) - Math.floor(left * ratio) : 0;\n  const limit = 4 * columns;\n  if (range.end - range.start <= limit) return joinRuns(input.slot, range);\n  return select(input.slot, range, limit, { x: input.x, y, map: xMapper(input.mapX), ratio });\n}\n\nexport function simplifyLine(input: LineInput): JoinedRuns {\n  return simplifyBoundary(input, input.y);\n}\n\nfunction pack(indexes: Uint32Array, breaks: Uint32Array | null, input: PathInput): Float32Array {\n  const xy = new Float32Array(2 * (indexes.length + (breaks?.length ?? 0)));\n  const { x, y, mapY } = input;\n  const toX = xMapper(input.mapX);\n  const toY = typeof mapY === 'function' ? mapY : (value: number) => mapY.map(value);\n  let cursor = 0;\n  let nextBreak = 0;\n  for (let i = 0; i < indexes.length; i++) {\n    if (breaks && i === breaks[nextBreak]) {\n      xy[cursor++] = NaN;\n      xy[cursor++] = NaN;\n      nextBreak++;\n    }\n    const index = indexes[i]!;\n    xy[cursor++] = toX(x[index]!);\n    xy[cursor++] = toY(y === 0 ? 0 : y[index]!);\n  }\n  return xy;\n}\n\nexport function buildPath(indexes: Uint32Array, breaks: Uint32Array, input: PathInput): PathMark['xy'] {\n  return pack(indexes, breaks, input);\n}\n\nexport function buildPoints(indexes: Uint32Array, input: PathInput): PointMark['xy'] {\n  return pack(indexes, null, input);\n}\n\ninterface AreaSource extends DrawingInput {\n  readonly mapY: YMap;\n}\n\nexport interface AreaBoundary {\n  readonly xy: Float32Array;\n  readonly selection: JoinedRuns;\n  readonly values: Float64Array;\n  readonly source: AreaSource;\n}\n\nexport interface AreaInput extends AreaSource {\n  readonly upper: Float64Array;\n  /** Pass 0 for an unstacked baseline or the previous band's upperBoundary for a shared edge. */\n  readonly lower: Float64Array | 0 | AreaBoundary;\n}\n\nexport interface SimplifiedArea extends Pick<AreaMark, 'upper' | 'lower' | 'runs'> {\n  readonly upperBoundary: AreaBoundary;\n  /** These slots need point marks because a single x cannot enclose an area. */\n  readonly isolated: Uint32Array;\n}\n\nfunction prepareBoundary(input: AreaSource, values: Float64Array): AreaBoundary {\n  const selection = simplifyBoundary(input, values);\n  return { selection, values, source: input, xy: buildPoints(selection.indexes, { ...input, y: values }) };\n}\n\nfunction canShare(previous: AreaSource, next: AreaSource): boolean {\n  if (previous.x !== next.x || previous.mapX !== next.mapX || previous.mapY !== next.mapY ||\n      previous.range.start !== next.range.start || previous.range.end !== next.range.end ||\n      previous.left !== next.left || previous.width !== next.width ||\n      previous.devicePixelRatio !== next.devicePixelRatio) return false;\n  if (previous.slot === next.slot) return true;\n  for (let i = next.range.start; i < next.range.end; i++) {\n    const a = previous.slot[i];\n    const b = next.slot[i];\n    if (a !== b && (a === SLOT_VALUE || b === SLOT_VALUE || a === SLOT_NO_ROW || b === SLOT_NO_ROW)) return false;\n  }\n  return true;\n}\n\nexport function simplifyArea(input: AreaInput): SimplifiedArea {\n  const { upper, lower, ...source } = input;\n  const upperBoundary = prepareBoundary(source, upper);\n  const upperSelection = upperBoundary.selection;\n  let lowerSelection: JoinedRuns;\n  let lowerXY: Float32Array;\n  if (lower === 0 || lower instanceof Float64Array) {\n    lowerSelection = simplifyBoundary(source, lower);\n    lowerXY = buildPoints(lowerSelection.indexes, { ...source, y: lower });\n  } else {\n    const boundary = canShare(lower.source, source) ? lower : prepareBoundary(source, lower.values);\n    lowerSelection = boundary.selection;\n    lowerXY = boundary.xy;\n  }\n\n  const runs = new Uint32Array(upperSelection.indexes.length === 0 ? 0 : 4 * (upperSelection.breaks.length + 1));\n  let upperStart = 0;\n  let lowerStart = 0;\n  for (let run = 0; run * 4 < runs.length; run++) {\n    const upperEnd = upperSelection.breaks[run] ?? upperSelection.indexes.length;\n    const lowerEnd = lowerSelection.breaks[run] ?? lowerSelection.indexes.length;\n    runs[run * 4] = upperStart;\n    runs[run * 4 + 1] = upperEnd - upperStart;\n    runs[run * 4 + 2] = lowerStart;\n    runs[run * 4 + 3] = lowerEnd - lowerStart;\n    upperStart = upperEnd;\n    lowerStart = lowerEnd;\n  }\n\n  return { upper: upperBoundary.xy, lower: lowerXY, runs, upperBoundary, isolated: upperSelection.isolated };\n}\nexport { linearScale, linearTickCandidates, type TickContext, type TickLabeler } from './linear';\nexport { valueDomain, type ValueDomain, type ValueDomainInput } from './domain';\nexport { bandScale, bandTickCandidates } from './band';\nexport { timeScale, timeTickCandidates, type TimeTickOptions } from './time';\nexport { instantToWall, wallToInstant, wallToInstants, zoneOffset, type Disambiguation } from './zone';\n/**\n * The value-axis domain (spec F1 and F7).\n *\n * Precedence: an author domain is used as given (widened to zero on bar and area); otherwise the automatic\n * domain covers the data, stack totals and reference values, and each end is the first nice tick at or\n * beyond the extreme, so it never overshoots by a whole step.\n */\nimport { firstIndexAtOrAbove, lastIndexAtOrBelow, niceStepAtLeast, stepMultiple, type NiceStep } from './nice';\n\nexport interface ValueDomainInput {\n  /** Smallest and largest value, stack totals included. NaN (or min > max) when there is no data. */\n  readonly min: number;\n  readonly max: number;\n  /** True for bar and area. */\n  readonly includeZero: boolean;\n  /** The field's `domain` option. */\n  readonly authorDomain?: readonly [number, number] | null;\n  /** The field's declared `scale`. */\n  readonly valueScale?: 'percent' | 'ratio' | null;\n  /** Reference values (lines and band ends) that must be visible. */\n  readonly references?: readonly number[];\n}\n\nexport interface ValueDomain {\n  readonly domain: [number, number];\n  /** True when an author domain excluded zero and was widened (the caller raises AX110). */\n  readonly widenedToZero: boolean;\n}\n\n/**\n * Number of intervals the automatic domain is rounded to. About five gives ends that are rarely more than\n * a fifth of the span beyond the data, on a step that is one of the tick candidate sets.\n */\nconst DOMAIN_INTERVALS = 5;\n\n/** The step the automatic domain of [lo, hi] is rounded to (lo < hi). Divided first so that a span wider than the largest double does not overflow. */\nexport function domainStep(lo: number, hi: number): NiceStep {\n  return niceStepAtLeast(hi / DOMAIN_INTERVALS - lo / DOMAIN_INTERVALS);\n}\n\nexport function valueDomain(input: ValueDomainInput): ValueDomain {\n  const author = input.authorDomain;\n  if (author != null && Number.isFinite(author[0]) && Number.isFinite(author[1])) {\n    // Author bounds take precedence (F7) and are used as given, a zero-width domain included (the scale\n    // draws it in the middle). Only the zero rule of F1 changes them.\n    let lo = Math.min(author[0], author[1]);\n    let hi = Math.max(author[0], author[1]);\n    let widenedToZero = false;\n    if (input.includeZero && (lo > 0 || hi < 0)) {\n      lo = Math.min(lo, 0);\n      hi = Math.max(hi, 0);\n      widenedToZero = true;\n    }\n    return { domain: [lo === 0 ? 0 : lo, hi === 0 ? 0 : hi], widenedToZero };\n  }\n\n  let lo = Infinity;\n  let hi = -Infinity;\n  if (Number.isFinite(input.min) && Number.isFinite(input.max) && input.min <= input.max) {\n    lo = input.min;\n    hi = input.max;\n  }\n  for (const r of input.references ?? []) {\n    if (!Number.isFinite(r)) continue;\n    if (r < lo) lo = r;\n    if (r > hi) hi = r;\n  }\n  if (lo > hi) return { domain: [0, 1], widenedToZero: false }; // nothing to show; the chart shows its empty state\n  if (input.includeZero) {\n    lo = Math.min(lo, 0);\n    hi = Math.max(hi, 0);\n  }\n  const full = input.valueScale === 'percent' ? 100 : input.valueScale === 'ratio' ? 1 : null;\n  // The full-scale end is fixed; only the other end is rounded.\n  const fixedTop = full !== null && hi >= full / 2 && hi <= full;\n  if (fixedTop) hi = full;\n  const domain = lo === hi ? aroundConstant(lo, fixedTop, input.includeZero) : niceExtent(lo, hi, fixedTop);\n  return { domain: usable(domain, lo, hi), widenedToZero: false };\n}\n\n/**\n * [lo, hi] rounded outwards to the first multiple of the domain step at or beyond each end. With `fixedTop`\n * the upper end is kept as it is.\n */\nexport function niceExtent(lo: number, hi: number, fixedTop = false): [number, number] {\n  const step = domainStep(lo, hi);\n  if (!(step.value > 0 && Number.isFinite(step.value))) return [lo, hi];\n  const a = stepMultiple(lastIndexAtOrBelow(lo, step), step);\n  const b = fixedTop ? hi : stepMultiple(firstIndexAtOrAbove(hi, step), step);\n  return [a, b];\n}\n\n/**\n * A usable domain for a single value v (only reached without includeZero, or for zero itself). Zero gets\n * [0, 1] or [-1, 1]; any other value gets a nice range about 10% either side, or below it when v is the\n * fixed full-scale top.\n */\nfunction aroundConstant(v: number, fixedTop: boolean, includeZero: boolean): [number, number] {\n  // Zero on a bar or area axis starts at the baseline.\n  if (v === 0) return includeZero ? [0, 1] : [-1, 1];\n  // Below 1e-300 a tenth of the value is not representable; such a value is drawn as zero would be.\n  if (Math.abs(v) < 1e-300) return [-1, 1];\n  const h = Math.abs(v) * 0.1;\n  if (fixedTop || !Number.isFinite(v + h)) return niceExtent(v - 2 * h, v, true);\n  if (!Number.isFinite(v - h)) return [v, niceExtent(v, v + 2 * h)[1]];\n  return niceExtent(v - h, v + h);\n}\n\n/**\n * The rounded domain if it is finite, ordered and contains [lo, hi]; otherwise the finite input bounds,\n * so no rounding artefact (overflow, underflow, a step below the resolution of the values) reaches a scale.\n */\nfunction usable(domain: [number, number], lo: number, hi: number): [number, number] {\n  const [a, b] = domain;\n  if (Number.isFinite(a) && Number.isFinite(b) && a <= lo && b >= hi && a < b) return [a === 0 ? 0 : a, b === 0 ? 0 : b];\n  if (lo < hi) return [lo, hi];\n  // A single value whose rounded neighbourhood failed: any finite interval around it.\n  const h = Math.abs(lo) * 0.2;\n  if (Number.isFinite(lo - h) && lo - h < lo) return [lo - h, lo];\n  if (Number.isFinite(lo + h) && lo + h > lo) return [lo, lo + h];\n  return [lo - 1, lo + 1];\n}\nimport type { ContinuousScale, Tick, TickCandidates } from '../core/contracts';\nimport { MAX_TICKS, firstIndexAtOrAbove, lastIndexAtOrBelow, nextNiceStep, niceStepAtLeast, stepMultiple } from './nice';\n\n/** What a tick labeler knows about the set its value belongs to. */\nexport interface TickContext {\n  /** Distance between adjacent ticks of the set. */\n  readonly step: number;\n  /** Largest absolute tick value of the set. */\n  readonly maxAbs: number;\n}\n\n/** Writes one tick label. A plain `(value) => string` is a valid labeler. */\nexport type TickLabeler = (value: number, context: TickContext) => string;\n\nexport function linearScale(domain: readonly [number, number], range: readonly [number, number]): ContinuousScale {\n  return continuous('linear', domain, range);\n}\n\n/** Shared by linear and time scales: both are linear in their domain units (time: epoch ms). */\nexport function continuous(type: 'linear' | 'time', domain: readonly [number, number], range: readonly [number, number]): ContinuousScale {\n  const d0 = domain[0];\n  const d1 = domain[1];\n  const r0 = range[0];\n  const r1 = range[1];\n  const span = d1 - d0;\n  const extent = r1 - r0;\n  const mid = r0 / 2 + r1 / 2;\n  // A domain wider than the largest double (say [-1e308, 1e308]) is interpolated on halves, so the\n  // intermediate width never overflows.\n  const overflow = !Number.isFinite(span) && Number.isFinite(d0) && Number.isFinite(d1);\n  const halfSpan = d1 / 2 - d0 / 2;\n  let map: (v: number) => number;\n  let invert: (p: number) => number;\n  if (span === 0) map = () => mid; // a zero-width domain (one value, one instant) is drawn in the middle\n  else if (overflow) map = (v: number) => r0 + ((v / 2 - d0 / 2) / halfSpan) * extent;\n  else map = (v: number) => r0 + ((v - d0) / span) * extent;\n  if (extent === 0) invert = () => d0;\n  else if (overflow) invert = (p: number) => {\n    const f = (p - r0) / extent;\n    return d0 * (1 - f) + d1 * f;\n  };\n  else invert = (p: number) => d0 + ((p - r0) / extent) * span;\n  return { type, domain: [d0, d1], range: [r0, r1], map, invert };\n}\n\nfunction sortedDomain(domain: readonly [number, number]): [number, number] {\n  return domain[0] <= domain[1] ? [domain[0], domain[1]] : [domain[1], domain[0]];\n}\n\n/**\n * Tick sets at nice steps (1, 2, 5 × 10^k), densest first, every tick inside the domain.\n * The densest set has at most MAX_TICKS ticks; the sparsest has one.\n */\nexport function linearTickCandidates(domain: readonly [number, number], format: TickLabeler): TickCandidates {\n  const [lo, hi] = sortedDomain(domain);\n  if (!Number.isFinite(lo) || !Number.isFinite(hi)) return [];\n  // A width that no nice step can resolve (subnormal, or below the precision of the values) gets one tick.\n  // Divided before subtracting, so that [-1e308, 1e308] does not overflow.\n  const width = hi / (MAX_TICKS - 1) - lo / (MAX_TICKS - 1);\n  const tooNarrow = !(width > 1e-300) || hi - lo <= 4 * Number.EPSILON * Math.max(Math.abs(lo), Math.abs(hi));\n  if (lo === hi || tooNarrow) {\n    const v = lo === 0 ? 0 : lo;\n    return [[{ value: v, label: format(v, { step: 0, maxAbs: Math.abs(v) }) }]];\n  }\n  const sets: Tick[][] = [];\n  let step = niceStepAtLeast(width);\n  for (let guard = 0; guard < 40 && Number.isFinite(step.value); guard++) {\n    const i0 = firstIndexAtOrAbove(lo, step);\n    const i1 = lastIndexAtOrBelow(hi, step);\n    const count = i1 - i0 + 1;\n    if (count >= 1 && count <= MAX_TICKS) {\n      const values: number[] = [];\n      for (let i = i0; i <= i1; i++) {\n        const v = stepMultiple(i, step);\n        // Where the step is below the resolution of the values, neighbours collapse to one double.\n        if (v >= lo && v <= hi && values[values.length - 1] !== v) values.push(v);\n      }\n      if (values.length > 0) {\n        const maxAbs = Math.max(Math.abs(values[0] as number), Math.abs(values[values.length - 1] as number));\n        const context: TickContext = { step: step.value, maxAbs };\n        const set = values.map(value => ({ value, label: format(value, context) }));\n        pushCandidate(sets, set);\n      }\n    }\n    if (count <= 1) break;\n    step = nextNiceStep(step);\n  }\n  // Near the largest doubles the next step overflows; the only multiple of an infinite step is zero.\n  const last = sets[sets.length - 1];\n  if (!Number.isFinite(step.value) && last !== undefined && last.length > 1 && lo <= 0 && hi >= 0) {\n    pushCandidate(sets, [{ value: 0, label: format(0, { step: 0, maxAbs: 0 }) }]);\n  }\n  return sets;\n}\n\n/**\n * Keeps the sequence strictly decreasing in size. When a coarser step gives as many ticks as the previous\n * set, the coarser one replaces it: same density, rounder numbers.\n */\nexport function pushCandidate(sets: Tick[][], set: Tick[]): void {\n  const last = sets[sets.length - 1];\n  if (last !== undefined && set.length >= last.length) {\n    if (set.length === last.length) sets[sets.length - 1] = set;\n    return;\n  }\n  sets.push(set);\n}\nimport type { BandScale, Tick, TickCandidates } from '../core/contracts';\n\n/**\n * Bands of equal width. `padding` is the fraction of a step left empty, the same between bands and at both\n * ends, so the outer gaps match the inner ones. The range may run backwards (a vertical category axis\n * drawn top to bottom from a bottom origin); `map` always returns the lower pixel edge of the band, so a\n * rectangle at map(i) with width `bandwidth` covers it either way.\n */\nexport function bandScale(count: number, range: readonly [number, number], padding: number): BandScale {\n  const n = Math.max(0, Math.floor(count));\n  const p = Number.isFinite(padding) ? Math.min(Math.max(padding, 0), 0.95) : 0;\n  const r0 = range[0];\n  const r1 = range[1];\n  const extent = Math.abs(r1 - r0);\n  const forward = r1 >= r0;\n  const step = n === 0 ? 0 : extent / (n + p);\n  const bandwidth = step * (1 - p);\n  const outer = step * p;\n\n  // Offset of band i's leading edge from range[0], measured along the range direction.\n  const lead = (i: number): number => outer + i * step;\n  const map = (i: number): number => (forward ? r0 + lead(i) : r0 - lead(i) - bandwidth);\n\n  return {\n    type: 'band',\n    count: n,\n    range: [r0, r1],\n    step,\n    bandwidth,\n    map,\n    center: (i: number) => map(i) + bandwidth / 2,\n    invert(pixel: number): number {\n      if (n === 0) return -1;\n      if (step === 0 || !Number.isFinite(pixel)) return 0;\n      const along = forward ? pixel - r0 : r0 - pixel;\n      // Nearest band centre, so a pixel in the padding belongs to the closer band.\n      const i = Math.round((along - outer - bandwidth / 2) / step);\n      return Math.min(Math.max(i, 0), n - 1);\n    },\n  };\n}\n\n/**\n * Sets of category labels, densest first: every category, then every k-th, always keeping the first.\n *\n * Strides are 1 to 10, then 20, 50, 100, 200, 500, … (1, 2, 5 × 10^k), so there are about 3·log10(n) + 10\n * sets for n categories. Sets are built on first read and kept, so laying out 100,000 categories costs\n * only the sets layout actually looks at. The result is still a plain readonly array of arrays.\n */\nexport function bandTickCandidates(labels: readonly string[]): TickCandidates {\n  const n = labels.length;\n  if (n === 0) return [];\n  const strides: number[] = [];\n  let lastSize = Infinity;\n  for (const k of strideSequence(n)) {\n    const size = Math.ceil(n / k);\n    if (size < lastSize) {\n      strides.push(k);\n      lastSize = size;\n    }\n    if (size === 1) break;\n  }\n  const sets: Tick[][] = [];\n  strides.forEach((k, index) => {\n    let built: Tick[] | null = null;\n    Object.defineProperty(sets, index, {\n      enumerable: true,\n      get(): Tick[] {\n        if (built === null) {\n          const set: Tick[] = [];\n          for (let i = 0; i < n; i += k) set.push({ value: i, label: labels[i] as string });\n          built = set;\n        }\n        return built;\n      },\n    });\n  });\n  return sets;\n}\n\n/** 1, 2, …, 10, 20, 50, 100, 200, 500, … up to the first stride at or above n. */\nfunction strideSequence(n: number): number[] {\n  const out: number[] = [];\n  for (let k = 