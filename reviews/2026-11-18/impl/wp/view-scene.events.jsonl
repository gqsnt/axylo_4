|  23 ++\n reviews/2026-11-18/impl/wp/layout.review.md        | 138 ++++++++++\n .../2026-11-18/impl/wp/lookup-reader.events.jsonl  |  60 +++++\n reviews/2026-11-18/impl/wp/view-scene.events.jsonl |  51 ++++\n 26 files changed, 2295 insertions(+), 1 deletion(-)\n98:| F5 | No smoothing. When a line is denser than the screen, the drawing is simplified with this guarantee: for every device-pixel column, and every contiguous run of valid samples inside it, the drawn stroke covers exactly that run's minimum and maximum. A break between two runs is always kept, even when both fall in one pixel column; a slot a series merely has no row for (weekly data beside daily) does not break its line. Stacked areas are simplified on their cumulative sums. Exact values always come from the data, not the drawing. | Assertions on which source samples the drawing kept, for: one outlier in 1,000,000; two peaks and a gap in one column; alternating valid and missing samples; tied extremes; device pixel ratio 1 and 2; several zoom levels. A sample that the drawing dropped is still reachable by keyboard and in the table | D8, D9 |\n193:| Simplified drawing when dense | F5 | F5 on cumulative sums | No; more bars than pixels raises a hint | No | No in 1.0; above 50,000 points a hint says drawing may be slow |\nimport type { DatumRef, DonutView, Formatters, Lookup, Rect } from '../core/contracts';\nimport { contains, type PlotLayout } from './geometry';\nimport { pageDistance } from './search';\nimport { sliceText } from './text';\n\nconst TURN = 2 * Math.PI;\n\nfunction sectorBox(cx: number, cy: number, inner: number, outer: number, start: number, end: number): Rect {\n  let left = Infinity;\n  let right = -Infinity;\n  let top = Infinity;\n  let bottom = -Infinity;\n  function include(angle: number, radius: number) {\n    const x = cx + Math.sin(angle) * radius;\n    const y = cy - Math.cos(angle) * radius;\n    left = Math.min(left, x);\n    right = Math.max(right, x);\n    top = Math.min(top, y);\n    bottom = Math.max(bottom, y);\n  }\n  for (const radius of [inner, outer]) {\n    include(start, radius);\n    include(end, radius);\n    const quarter = Math.PI / 2;\n    for (let angle = Math.ceil(start / quarter) * quarter; angle < end; angle += quarter) include(angle, radius);\n  }\n  return { x: left, y: top, width: right - left, height: bottom - top };\n}\n\nexport function donutLookup(view: DonutView, layout: PlotLayout | null, formatters: Formatters, locale: string): Lookup {\n  const { slices } = view;\n  const keys = new Map(slices.map((slice, i) => [slice.key, i]));\n  const ring = layout?.projection.kind === 'ring' ? layout.projection : null;\n  const index = (datum: DatumRef) => datum.kind === 'slice' ? keys.get(datum.sliceKey) ?? -1 : -1;\n\n  function ref(i: number): DatumRef | null {\n    const slice = slices[i];\n    return slice ? { kind: 'slice', sliceKey: slice.key } : null;\n  }\n\n  const lookup: Lookup = {\n    pick(px, py) {\n      if (!ring || !layout || !contains(layout.plot, px, py) || !(ring.r1 > ring.r0)) return null;\n      const dx = px - ring.cx;\n      const dy = py - ring.cy;\n      const radius = Math.hypot(dx, dy);\n      if (radius < ring.r0 || radius > ring.r1) return null;\n      const raw = Math.atan2(dx, -dy);\n      const angle = raw < 0 ? raw + TURN : raw;\n      const slice = slices.find(slice => slice.angles && angle >= slice.angles[0] && angle < slice.angles[1]);\n      return slice ? { kind: 'slice', sliceKey: slice.key } : null;\n    },\n    tooltip(target) {\n      const datum = target.kind === 'slice' ? lookup.datum(target) : null;\n      return { title: datum?.seriesLabel ?? '', rows: datum ? [datum] : [], count: datum ? 1 : 0, total: null };\n    },\n    primary(target) { return target.kind === 'slice' && keys.has(target.sliceKey) ? target : null; },\n    datum(datum) {\n      const i = index(datum);\n      if (i < 0) return null;\n      const { label, value, percent, state, row } = sliceText(view, slices[i]!, formatters, locale);\n      return { ref: datum, seriesIndex: i, seriesLabel: label, x: label, value, percent, state, row };\n    },\n    anchor(datum) {\n      const angles = slices[index(datum)]?.angles;\n      return ring && ring.r1 > ring.r0 && angles && angles[1] > angles[0]\n        ? sectorBox(ring.cx, ring.cy, ring.r0, ring.r1, ...angles) : null;\n    },\n    count: slices.length,\n    ordinal: index,\n    step(from, direction) {\n      if (!from) return ref(0);\n      const i = index(from);\n      if (i < 0) return null;\n      switch (direction) {\n        case 'next': return ref(i + 1);\n        case 'previous': return ref(i - 1);\n        case 'first': return ref(0);\n        case 'last': return ref(slices.length - 1);\n        case 'page-next': return ref(Math.min(slices.length - 1, i + pageDistance(slices.length)));\n        case 'page-previous': return ref(Math.max(0, i - pageDistance(slices.length)));\n        case 'series-next':\n        case 'series-previous': return null;\n      }\n    },\n    resolve(datum) { return index(datum) < 0 ? null : datum; },\n  };\n  return lookup;\n}\n1:You wrote the `simplify` and `layout` modules of Axylo in this repository (brief: `reviews/2026-11-18/impl/wp/layout.prompt.md`). An independent reviewer from another provider tried to break them. Read `AGENTS.md` again, then the review at `reviews/2026-11-18/impl/wp/layout.review.md`.\n15:- **11 and 12.** Widen the property tests as the reviewer describes: every plot kind, ordered and plain axes, horizontal bars, sizes down to 100 × 60 and non-finite sizes; assert `plot` whenever a 120 × 80 plot is provably possible; assert every truncated label keeps characters on both sides and matches only its own source. For simplification, write the oracle independently of the implementation's density formula, and generate Float32Array y, x far outside the plot, device pixel ratios 1, 1.25, 1.5, 2 and 3, and ranges whose joined neighbour lies outside the range.\n19:The reviewer also noted a wording conflict that is now resolved in the spec (F5): a break between two runs is always kept; SLOT_NO_ROW does not break a line. Your code already follows that.\n","exit_code":0,"status":"completed"}}
