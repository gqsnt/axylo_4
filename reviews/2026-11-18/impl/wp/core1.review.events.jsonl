{"type":"item.completed","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"rg -n 'select|zoom:|validate' docs/api/{examples.ts,axylo.d.ts} && sed -n '116,132p' packages/axylo/src/core/contracts.ts && sed -n '197,212p' docs/02-product-spec.md && cat packages/axylo/src/lookup/donut.ts && sed -n '84,111p' packages/axylo/src/scene/index.ts\"","aggregated_output":"docs/api/axylo.d.ts:131:  select: Point<Row>;\ndocs/api/axylo.d.ts:132:  zoom: readonly [XValue, XValue] | null;\ndocs/api/axylo.d.ts:177:export function validate<Row>(type: 'line' | 'area' | 'bar', options: LineOptions<Row>): Diagnostic[];\ndocs/api/axylo.d.ts:178:export function validate<Row>(type: 'scatter', options: ScatterOptions<Row>): Diagnostic[];\ndocs/api/axylo.d.ts:179:export function validate<Row>(type: 'donut', options: DonutOptions<Row>): Diagnostic[];\ndocs/api/examples.ts:2:import { line, bar, area, donut, scatter, validate, type Chart, type LineOptions } from './axylo';\ndocs/api/examples.ts:48:const problems = validate('line', { data: rows, x: 'day', y: 'sessions', series: 'channel' });\ndocs/api/examples.ts:63:donut('#x', { data: shares, label: 'browser', value: 'share', zoom: true });\n  readonly x: Float64Array;\n  readonly y: Float64Array;\n  readonly row: Int32Array | null;\n}\n\n/**\n * The normalized, lossless data. Immutable: an update or append produces a new frame with a higher revision.\n * Buffers may be shared between revisions; a streaming store appends into spare capacity and hands out\n * subarray views, so an append does not copy what is already there.\n */\ninterface FrameBase {\n  readonly revision: number;\n  /** Changes when the data is replaced or the encoding changes; survives append and eviction. A DatumRef is only meaningful within one epoch. */\n  readonly epoch: number;\n  readonly source: RowSource;\n}\n\n| Limit that raises a diagnostic | Eight series | Eight series | Eight series | Eight slices | Eight series |\n| Reference lines and bands | Yes; included in the domain; listed in the summary and table caption | Yes | Yes | No | Yes |\n\n### 3.7 Compact variant\n\n`compact: true` on line, area and bar draws the marks and nothing else: no axes, gridlines, legend, toolbar, table control, zoom or tooltip. It is for a small tile where the page already shows the number and the label.\n\n| ID | Criterion | Verified by |\n|---|---|---|\n| C1 | A compact chart is a static image with a full text alternative: `role=\"img\"`, an accessible name (as in A1, including AX140 when none is given) and the generated summary as its description (series, x range, minimum, maximum, last value, omissions). It has no tab stop and no pointer-only behavior, so nothing is available to a mouse that is not available to a keyboard. | Accessibility-tree snapshot; a page of 40 has zero added tab stops |\n| C2 | The fidelity rules still hold: zero baseline for bar and area (F1), gaps (F2), diagnostics (F3), simplified drawing (F5), sorting (F11), no motion (I5), scheme from the page (L4). | The same fixtures as the full charts |\n| C3 | It fills its container at any size from 24×16 CSS px up; with no definite height it is 32 px tall. | Size tests |\n| C4 | With more than one series, lines differ by dash as well as color, since there is no legend; AX131 suggests one series per compact chart. | Two-series fixture |\n| C5 | When values were left out (F12), the description says so and a small marker with a text equivalent appears in the corner. | `dirty` fixture in compact mode |\n\nA compact chart does not give access to every value; the summary is its alternative. An author who needs every value reachable uses the full chart.\nimport type { DatumRef, DonutView, Formatters, Lookup, Rect } from '../core/contracts';\nimport { contains, type PlotLayout } from './geometry';\nimport { pageDistance } from './search';\nimport { sliceText } from './text';\n\nconst TURN = 2 * Math.PI;\n\nfunction sectorBox(cx: number, cy: number, inner: number, outer: number, start: number, end: number): Rect {\n  let left = Infinity;\n  let right = -Infinity;\n  let top = Infinity;\n  let bottom = -Infinity;\n  function include(angle: number, radius: number) {\n    const x = cx + Math.sin(angle) * radius;\n    const y = cy - Math.cos(angle) * radius;\n    left = Math.min(left, x);\n    right = Math.max(right, x);\n    top = Math.min(top, y);\n    bottom = Math.max(bottom, y);\n  }\n  for (const radius of [inner, outer]) {\n    include(start, radius);\n    include(end, radius);\n    const quarter = Math.PI / 2;\n    for (let angle = Math.ceil(start / quarter) * quarter; angle < end; angle += quarter) include(angle, radius);\n  }\n  return { x: left, y: top, width: right - left, height: bottom - top };\n}\n\nexport function donutLookup(view: DonutView, layout: PlotLayout | null, formatters: Formatters, locale?: string): Lookup {\n  const { slices } = view;\n  const keys = new Map(slices.map((slice, i) => [slice.key, i]));\n  const ring = layout?.projection.kind === 'ring' ? layout.projection : null;\n  const index = (datum: DatumRef) => datum.kind === 'slice' ? keys.get(datum.sliceKey) ?? -1 : -1;\n\n  function ref(i: number): DatumRef | null {\n    const slice = slices[i];\n    return slice ? { kind: 'slice', sliceKey: slice.key } : null;\n  }\n\n  function resolve(datum: DatumRef): DatumRef | null {\n    if (datum.kind !== 'slice') return null;\n    if (keys.has(datum.sliceKey)) return datum;\n    const folded = slices.find(slice => slice.members.length > 1 && slice.members.some(i => {\n      const label = view.frame.labels[i];\n      // The view prefixes author labels that would collide with the reserved Other key.\n      return label !== undefined && datum.sliceKey === (label.startsWith('__other__') ? '__other__' + label : label);\n    }));\n    return folded ? { kind: 'slice', sliceKey: folded.key } : null;\n  }\n\n  const lookup: Lookup = {\n    pick(px, py) {\n      if (!ring || !layout || !contains(layout.plot, px, py) || !(ring.r1 > ring.r0)) return null;\n      const dx = px - ring.cx;\n      const dy = py - ring.cy;\n      const radius = Math.hypot(dx, dy);\n      if (radius < ring.r0 || radius > ring.r1) return null;\n      const raw = Math.atan2(dx, -dy);\n      const angle = raw < 0 ? raw + TURN : raw;\n      const slice = slices.find(slice => slice.angles && angle >= slice.angles[0] && angle < slice.angles[1]);\n      return slice ? { kind: 'slice', sliceKey: slice.key } : null;\n    },\n    tooltip(target) {\n      const datum = target.kind === 'slice' ? lookup.datum(target) : null;\n      return { title: datum?.seriesLabel ?? '', rows: datum ? [datum] : [], count: datum ? 1 : 0, total: null };\n    },\n    primary(target) { return target.kind === 'slice' && keys.has(target.sliceKey) ? target : null; },\n    datum(datum) {\n      const i = index(datum);\n      if (i < 0) return null;\n      const { label, value, percent, state, row } = sliceText(view, slices[i]!, formatters, locale);\n      return { ref: datum, seriesIndex: i, seriesLabel: label, x: label, value, percent, state, row };\n    },\n    anchor(datum) {\n      const angles = slices[index(datum)]?.angles;\n      return ring && ring.r1 > ring.r0 && angles && angles[1] > angles[0]\n        ? sectorBox(ring.cx, ring.cy, ring.r0, ring.r1, ...angles) : null;\n    },\n    count: slices.length,\n    ordinal: index,\n    step(from, direction) {\n      if (!from) return ref(0);\n      const resolved = resolve(from);\n      if (!resolved) return null;\n      const i = index(resolved);\n      let to: number;\n      switch (direction) {\n        case 'next': to = i + 1; break;\n        case 'previous': to = i - 1; break;\n        case 'first': to = 0; break;\n        case 'last': to = slices.length - 1; break;\n        case 'page-next': to = Math.min(slices.length - 1, i + pageDistance(slices.length)); break;\n        case 'page-previous': to = Math.max(0, i - pageDistance(slices.length)); break;\n        case 'series-next':\n        case 'series-previous': return null;\n      }\n      return to === i ? null : ref(to);\n    },\n    resolve,\n  };\n  return lookup;\n}\n}\n\nexport function buildScene(view: View, layout: Layout, devicePixelRatio: number): Scene {\n  const { width, height } = layout;\n  if (layout.kind !== 'plot' && layout.kind !== 'compact') {\n    return { width, height, clip: { x: 0, y: 0, width, height }, marks: [] };\n  }\n  const { plot: clip, projection } = layout;\n  if (projection.kind === 'ring' || view.kind === 'donut') {\n    const marks = projection.kind === 'ring' && view.kind === 'donut' ? arcMarks(view, projection) : [];\n    return { width, height, clip, marks };\n  }\n\n  const compact = layout.kind === 'compact' || view.compact;\n  const { grid, edges } = layout.kind === 'plot' && !compact ? gridAndAxes(layout, projection) : { grid: [], edges: [] };\n  const { bands, lines } = compact ? { bands: [], lines: [] } : references(view, projection, clip);\n  const layers: (readonly Mark[])[] = [bands, grid];\n  if (view.kind === 'bar' && projection.kind === 'bands') {\n    layers.push(barMarks(view, projection, clip));\n  } else if (view.kind === 'scatter' && projection.kind === 'xy') {\n    layers.push(scatterPoints(view, projection));\n  } else if ((view.kind === 'line' || view.kind === 'area') && projection.kind === 'xy') {\n    const areas: AreaMark[] = [];\n    const seams: PathMark[] = [];\n    const paths: PathMark[] = [];\n    const points: PointMark[] = [];\n    const dpr = Number.isFinite(devicePixelRatio) && devicePixelRatio > 0 ? devicePixelRatio : 1;\n    const draw = drawing(view.frame.x.values, projection, clip, dpr);\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"sed -n '120,143p;185,199p' docs/02-product-spec.md && cat packages/axylo/src/scale/domain.ts && rg -n 'pin|borrow|ordered|immutable|AST|flag' docs/03-plan-typescript-release.md bench/README.md && rg -n 'height|mark' packages/axylo/src/render/canvas.ts | head -28\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"sed -n '120,143p;185,199p' docs/02-product-spec.md && cat packages/axylo/src/scale/domain.ts && rg -n 'pin|borrow|ordered|immutable|AST|flag' docs/03-plan-typescript-release.md bench/README.md && rg -n 'height|mark' packages/axylo/src/render/canvas.ts | head -28\"","aggregated_output":"### 3.3 Interaction\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| I1 | Pointing anywhere in the plot shows what is there, by the picking rule for the chart type (section 3.6), within one frame at the 95th percentile. On line, area and bar the tooltip lists every visible series at the nearest x; a series with no row at that x reads \"No observation\", distinct from \"No data\". The tooltip stays inside the viewport, does not cover the active mark, can itself be hovered, and lists at most eight rows plus \"+N more\". When it cannot fit, the same content appears in a fixed readout under the plot. Escape closes it until the pointer reaches a different datum. | Hover at 20 positions including all four edges; sparse-series fixture; narrow tile with eight series; Escape test | R15 |\n| I2 | Legend entries are toggle buttons with a pressed state, operable by click, Enter and Space. | Keyboard and accessibility-tree tests | R12 |\n| I3 | Zoom on time, date and numeric x axes is reachable four ways: visible Zoom in, Zoom out and Reset buttons that work with single clicks; drag to select a range; `+`, `-`, `0` and Shift+arrows; and pinch when `zoom: 'touch'` is set. The wheel zooms only while the plot has focus, and never when Ctrl or Meta is held, so browser zoom and page scrolling are not intercepted. | Reach a given range by clicks only; by keyboard only; by drag; page scrolls normally with the pointer over an unfocused chart | D7, R12, WCAG 2.5.1, 2.5.7, 1.4.4 |\n| I4 | Every interaction works with a single pointer without dragging, and by touch. Every control is at least 24×24 CSS px. A one-finger drag on a chart scrolls the page. | Touch emulation; size checks | WCAG 2.5.7, 2.5.8 |\n| I5 | First render is not animated. An update may transition for at most 200 ms. Under `prefers-reduced-motion: reduce` nothing transitions, on first render or on update. | After `document.fonts.ready`: first frame equals the frame at 2.5 s within a 0.1% pixel tolerance, in both settings; an update under reduced motion reaches its final frame in one step; a 24-chart filter change settles within 200 ms | R14 |\n| I6 | A chart fed by `append` shows a Pause/Resume control. While paused, new rows are buffered and the view does not move. | Stream test | WCAG 2.2.2 |\n\n### 3.4 Accessibility\n\nTarget: every WCAG 2.2 level AA success criterion that applies to what Axylo renders, as component-level evidence. Conformance of a page is a property of the page and remains the author's.\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| A1 | Every chart has an accessible name: its `title`, or the heading named by `labelledBy`, or else a generated name (\"Line chart of Sessions by Day\") with AX140 raised in every build. The title's heading level is the author's (`level`), and it can be hidden visually. Every chart has a generated summary: type, series, x range with time zone, y range, each series' minimum, maximum and last value, and any omissions. `description` adds to the summary and never removes the zone or omission statements. Element ids are unique per chart. | Accessibility-tree snapshot for every fixture; a 24-chart page has no duplicate ids; axe `heading-order` | R11, R13 |\n| A2 | Keyboard: at most two tab stops while the table is closed, the plot and one toolbar with roving focus that holds legend toggles, zoom, pause and the table control. Every point is reachable in order; the series can be switched; the ends can be reached directly; focus can leave the chart. The focus indicator is at least 2 px and 3:1 and is not hidden by the tooltip. The exact keys and roles are fixed after the pattern spike in M1 (section 8). | Forward and reverse traversal in collapsed, zoomed, streaming and table-open states; focus after hiding the focused series; indicator contrast | R12 |\n| A3 | Moving focus to a point conveys its text (series, x, value with unit, position) through the focused element's accessible name or a polite live region. On touch screen readers, every point is reachable by swiping, or the table is reachable within two gestures. | Accessibility-tree snapshot after each key; a recorded rehearsal on NVDA with Chrome, NVDA with Firefox, VoiceOver with Safari on macOS, VoiceOver on iOS, and TalkBack with Chrome | R12, R13 |\n| A4 | \"View as table\" shows the data as an HTML table built from the normalized data when opened: the title as caption, field labels with units as column headers, x values as row headers, values formatted as in F6. It covers the current x range, 100 rows per page, with every row reachable by paging or by jumping to an x value. It sits in a focusable scroll region no taller than the plot, and opening it does not move other charts. | Table content compared with fixture data, including a value near row 900,000 of 1,000,000; a 24-chart page layout test | R13 |\n| A5 | Series are never distinguished by color alone, in any mode. Each line and area carries a shape marker at its last point and at sparse intervals, repeated in the legend and tooltip; under `prefers-contrast: more` or forced colors, lines also differ by dash. Adjacent filled marks (slices, stacked segments) are separated by at least 1 px of background. The default palette has eight colors, each at least 3:1 on the default light and dark backgrounds, with a minimum pairwise OKLab difference of 0.10 (provisional) under normal vision and simulated protanopia, deuteranopia and tritanopia. On any other background, Axylo measures the palette against the resolved background and raises AX141 below 3:1. | Palette script scoring the rendered marks of an eight-series chart in both schemes, repeats included; rendered-pixel checks of separators; a grayscale screenshot in which three crossing lines can be told apart by marker | R7, WCAG 1.4.1, 1.4.11 |\n| A6 | Content reflows at 320 CSS px and 400% zoom without two-dimensional scrolling. User text-spacing overrides do not clip text. | Viewport and style-override tests in three engines | WCAG 1.4.10, 1.4.12 |\n| A7 | Data arriving does not speak. Announcements happen only for the reader's own navigation, and for a change of state (L7). While data streams, keyboard focus stays on the same datum until it leaves the window. | Stream test counting live-region changes with and without focus; 24 concurrent streams | R12 |\n\nThe split between AX104 and AX106 answers a reviewer's objection that common back ends return counts as strings (Postgres `bigint` and `numeric`, BigQuery): a whole column of plain decimal strings is unambiguous and is parsed; a stray string among numbers is a bug and is not.\n\n### 3.6 Type matrix\n\n| | Line | Area | Bar | Donut | Scatter |\n|---|---|---|---|---|---|\n| Picking by pointer | Nearest x | Nearest x | The band under the pointer | The slice under the pointer | Nearest point within 24 px; ties go to the later row |\n| Tooltip content | Every visible series at that x | Same, plus the stack total | Every series in that category | Label, value, percentage | The point's series, x and y; coincident points listed, up to eight |\n| Keyboard order | By x, then series | By x, then series | By category, then series | By slice order | By x, then y |\n| Zoom | Yes | Yes | On time, date and numeric x only | No | Yes, both axes later; x only in 1.0 |\n| Simplified drawing when dense | F5 | F5 on cumulative sums | No; more bars than pixels raises a hint | No | No in 1.0; above 50,000 points a hint says drawing may be slow |\n| Limit that raises a diagnostic | Eight series | Eight series | Eight series | Eight slices | Eight series |\n| Reference lines and bands | Yes; included in the domain; listed in the summary and table caption | Yes | Yes | No | Yes |\n\n/**\n * The value-axis domain (spec F1 and F7).\n *\n * Precedence: an author domain is used as given (widened to zero on bar and area); otherwise the automatic\n * domain covers the data, stack totals and reference values, and each end is the first nice tick at or\n * beyond the extreme, so it never overshoots by a whole step.\n */\nimport { firstIndexAtOrAbove, lastIndexAtOrBelow, niceStepAtLeast, stepMultiple, type NiceStep } from './nice';\n\nexport interface ValueDomainInput {\n  /** Smallest and largest value, stack totals included. NaN (or min > max) when there is no data. */\n  readonly min: number;\n  readonly max: number;\n  /** True for bar and area. */\n  readonly includeZero: boolean;\n  /** The field's `domain` option. */\n  readonly authorDomain?: readonly [number, number] | null;\n  /** The field's declared `scale`. */\n  readonly valueScale?: 'percent' | 'ratio' | null;\n  /** Reference values (lines and band ends) that must be visible. */\n  readonly references?: readonly number[];\n}\n\nexport interface ValueDomain {\n  readonly domain: [number, number];\n  /** True when an author domain excluded zero and was widened (the caller raises AX110). */\n  readonly widenedToZero: boolean;\n}\n\n/**\n * Number of intervals the automatic domain is rounded to. About five gives ends that are rarely more than\n * a fifth of the span beyond the data, on a step that is one of the tick candidate sets.\n */\nconst DOMAIN_INTERVALS = 5;\n\n/** The step the automatic domain of [lo, hi] is rounded to (lo < hi). Divided first so that a span wider than the largest double does not overflow. */\nexport function domainStep(lo: number, hi: number): NiceStep {\n  return niceStepAtLeast(hi / DOMAIN_INTERVALS - lo / DOMAIN_INTERVALS);\n}\n\nexport function valueDomain(input: ValueDomainInput): ValueDomain {\n  const author = input.authorDomain;\n  if (author != null && Number.isFinite(author[0]) && Number.isFinite(author[1])) {\n    // Author bounds take precedence (F7) and are used as given, a zero-width domain included (the scale\n    // draws it in the middle). Only the zero rule of F1 changes them.\n    let lo = Math.min(author[0], author[1]);\n    let hi = Math.max(author[0], author[1]);\n    let widenedToZero = false;\n    if (input.includeZero && (lo > 0 || hi < 0)) {\n      lo = Math.min(lo, 0);\n      hi = Math.max(hi, 0);\n      widenedToZero = true;\n    }\n    return { domain: [lo === 0 ? 0 : lo, hi === 0 ? 0 : hi], widenedToZero };\n  }\n\n  let lo = Infinity;\n  let hi = -Infinity;\n  if (Number.isFinite(input.min) && Number.isFinite(input.max) && input.min <= input.max) {\n    lo = input.min;\n    hi = input.max;\n  }\n  for (const r of input.references ?? []) {\n    if (!Number.isFinite(r)) continue;\n    if (r < lo) lo = r;\n    if (r > hi) hi = r;\n  }\n  if (lo > hi) return { domain: [0, 1], widenedToZero: false }; // nothing to show; the chart shows its empty state\n  if (input.includeZero) {\n    lo = Math.min(lo, 0);\n    hi = Math.max(hi, 0);\n  }\n  const full = input.valueScale === 'percent' ? 100 : input.valueScale === 'ratio' ? 1 : null;\n  // The full-scale end is fixed; only the other end is rounded.\n  const fixedTop = full !== null && hi >= full / 2 && hi <= full;\n  if (fixedTop) hi = full;\n  const domain = lo === hi ? aroundConstant(lo, fixedTop, input.includeZero) : niceExtent(lo, hi, fixedTop);\n  return { domain: usable(domain, lo, hi), widenedToZero: false };\n}\n\n/**\n * [lo, hi] rounded outwards to the first multiple of the domain step at or beyond each end. With `fixedTop`\n * the upper end is kept as it is.\n */\nexport function niceExtent(lo: number, hi: number, fixedTop = false): [number, number] {\n  const step = domainStep(lo, hi);\n  if (!(step.value > 0 && Number.isFinite(step.value))) return [lo, hi];\n  const a = stepMultiple(lastIndexAtOrBelow(lo, step), step);\n  const b = fixedTop ? hi : stepMultiple(firstIndexAtOrAbove(hi, step), step);\n  return [a, b];\n}\n\n/**\n * A usable domain for a single value v (only reached without includeZero, or for zero itself). Zero gets\n * [0, 1] or [-1, 1]; any other value gets a nice range about 10% either side, or below it when v is the\n * fixed full-scale top.\n */\nfunction aroundConstant(v: number, fixedTop: boolean, includeZero: boolean): [number, number] {\n  // Zero on a bar or area axis starts at the baseline.\n  if (v === 0) return includeZero ? [0, 1] : [-1, 1];\n  // Below 1e-300 a tenth of the value is not representable; such a value is drawn as zero would be.\n  if (Math.abs(v) < 1e-300) return [-1, 1];\n  const h = Math.abs(v) * 0.1;\n  if (fixedTop || !Number.isFinite(v + h)) return niceExtent(v - 2 * h, v, true);\n  if (!Number.isFinite(v - h)) return [v, niceExtent(v, v + 2 * h)[1]];\n  return niceExtent(v - h, v + h);\n}\n\n/**\n * The rounded domain if it is finite, ordered and contains [lo, hi]; otherwise the finite input bounds,\n * so no rounding artefact (overflow, underflow, a step below the resolution of the values) reaches a scale.\n */\nfunction usable(domain: [number, number], lo: number, hi: number): [number, number] {\n  const [a, b] = domain;\n  if (Number.isFinite(a) && Number.isFinite(b) && a <= lo && b >= hi && a < b) return [a === 0 ? 0 : a, b === 0 ? 0 : b];\n  if (lo < hi) return [lo, hi];\n  // A single value whose rounded neighbourhood failed: any finite interval around it.\n  const h = Math.abs(lo) * 0.2;\n  if (Number.isFinite(lo - h) && lo - h < lo) return [lo - h, lo];\n  if (Number.isFinite(lo + h) && lo + h > lo) return [lo, lo + h];\n  return [lo - 1, lo + 1];\n}\nbench/README.md:94:range; for streaming into a sample that stays in the final window), so a chart that clips or pins its y range fails\ndocs/03-plan-typescript-release.md:57:| Ownership | Row arrays are read once and never mutated. Typed columns are borrowed, not copied; the caller must not change them in place, and replaces them through `update`. |\n2: * Canvas 2D mark renderer (plan 2.3). Paints with `theme.paints` (concrete colors), so the chart must call\n4: * or focus ring can move without repainting the marks. The overlay's backing store is only allocated when an\n29:export function backingSize(width: number, height: number, dpr: number): [number, number] {\n30:  const w = Math.max(0, width), h = Math.max(0, height);\n50:    setStyles(c, { position: 'absolute', left: '0', top: '0', display: 'block', width: '0px', height: '0px' });\n55:  overlayCanvas.height = 0;\n72:    if (canvas.width === bw && canvas.height === bh) return false;\n74:    canvas.height = bh;\n80:    ctx.clearRect(0, 0, canvas.width, canvas.height);\n87:  function resize(width: number, height: number, dpr: number): void {\n88:    if (width !== cssWidth || height !== cssHeight) {\n90:      cssHeight = height;\n94:        el.style.setProperty('height', `${height}px`);\n98:    backing = backingSize(width, height, dpr);\n114:      resize(scene.width, scene.height, devicePixelRatio > 0 ? devicePixelRatio : 1);\n120:        sceneCtx.fillRect(0, 0, scene.width, scene.height);\n122:      paintMarks(sceneCtx, scene.marks, scene.clip, true, theme.paints, theme.moreContrast || theme.forcedColors, scaleX(), scaleY(), scratch);\n145:      sceneCanvas.width = sceneCanvas.height = 0;\n146:      overlayCanvas.width = overlayCanvas.height = 0;\n157: * Paints marks back to front. With `byRole`, axis and tick rules escape the clip (scene contract); without\n158: * it, every mark is clipped to `clip` when one is given (overlay lists).\n160:function paintMarks(ctx: Ctx, marks: readonly Mark[], clip: Rect | null, byRole: boolean, paints: PaintBindings, contrast: boolean, sx: number, sy: number, scratch: Float64Array): void {\n162:  for (const mark of marks) {\n163:    const want = clip !== null && !(byRole && mark.type === 'rule' && unclippedRule(mark.role));\n169:        ctx.rec