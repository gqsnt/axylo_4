icOf('AX103', 'w', 'B')], [], null);\n    32\t    a.deliver([publicOf('AX101', 'x', 'A')], [], null);\n    33\t    expect(out.lines.map(l => [l.channel, l.text.slice(0, 13)])).toEqual([['warn', '[axylo AX103]'], ['warn', '[axylo AX101]']]);\n    34\t    // Another page prints it again.\n    35\t    new Delivery({ console: out.console, development: false, page: {} }).deliver([publicOf('AX103', 'v')], [], null);\n    36\t    expect(out.lines).toHaveLength(3);\n    37\t  });\n    38\t\n    39\t  it('prints hints only in development builds', () => {\n    40\t    const prod = recorder();\n    41\t    new Delivery({ console: prod.console, development: false, page: {} }).deliver([publicOf('AX111', 'day')], [], null);\n    42\t    expect(prod.lines).toEqual([]);\n    43\t    const dev = recorder();\n    44\t    new Delivery({ console: dev.console, development: true, page: {} }).deliver([publicOf('AX111', 'day')], [], null);\n    45\t    expect(dev.lines.map(l => l.channel)).toEqual(['info']);\n    46\t  });\n    47\t\n    48\t  it('names the chart and the code in the printed line', () => {\n    49\t    const out = recorder();\n    50\t    new Delivery({ console: out.console, development: true, page: {} }).deliver([publicOf('AX140', undefined, 'Daily sessions')], [], null);\n    51\t    expect(out.lines[0]!.text).toMatch(/^\\[axylo AX140\\] \"Daily sessions\": /);\n    52\t  });\n    53\t\n    54\t  it('hands every new diagnostic to onDiagnostic, in production too, and not the same one twice', () => {\n    55\t    const seen: string[] = [];\n    56\t    const d = new Delivery({ console: recorder().console, development: false, page: {} });\n    57\t    const first = [publicOf('AX103', 'v'), publicOf('AX111', 'day')];\n    58\t    d.deliver(first, [], x => seen.push(x.code));\n    59\t    d.deliver(first, first, x => seen.push(x.code));\n    60\t    expect(seen).toEqual(['AX103', 'AX111']);\n    61\t  });\n    62\t\n    63\t  it('survives a listener that throws, and says so on