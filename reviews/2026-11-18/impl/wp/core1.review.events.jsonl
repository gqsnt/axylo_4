ges/axylo/src/format/time.ts\npackages/axylo/src/format/intl.ts\npackages/axylo/src/format/number.ts\npackages/axylo/src/diagnostics/index.ts\npackages/axylo/src/diagnostics/collector.ts\npackages/axylo/src/diagnostics/registry.ts\npackages/axylo/src/view/index.ts\npackages/axylo/src/view/stack.ts\npackages/axylo/src/view/references.ts\npackages/axylo/src/view/donut.ts\npackages/axylo/src/view/bar-bands.ts\npackages/axylo/src/scene/index.ts\npackages/axylo/src/scene/bars.ts\npackages/axylo/src/scene/areas.ts\npackages/axylo/src/scene/lines.ts\npackages/axylo/src/scene/geometry.ts\npackages/axylo/src/messages/index.ts\npackages/axylo/src/scale/index.ts\npackages/axylo/src/scale/time.ts\npackages/axylo/src/scale/band.ts\npackages/axylo/src/scale/zone.ts\npackages/axylo/src/scale/domain.ts\npackages/axylo/src/scale/linear.ts\npackages/axylo/src/scale/nice.ts\npackages/axylo/src/theme/palette.ts\npackages/axylo/src/theme/color.ts\npackages/axylo/src/theme/index.ts\npackages/axylo/src/theme/css.ts\npackages/axylo/src/theme/watch.ts\npackages/axylo/src/theme/styles.ts\npackages/axylo/src/theme/resolve.ts\npackages/axylo/src/render/svg.ts\npackages/axylo/src/render/index.ts\npackages/axylo/src/render/text.ts\npackages/axylo/src/render/geometry.ts\npackages/axylo/src/render/canvas.ts\npackages/axylo/src/public.ts\npackages/axylo/src/reader/index.ts\npackages/axylo/src/reader/table.ts\npackages/axylo/src/reader/x.ts\npackages/axylo/src/simplify/index.ts\npackages/axylo/src/layout/index.ts\npackages/axylo/src/layout/labels.ts\n","exit_code":0,"status":"completed"}}
