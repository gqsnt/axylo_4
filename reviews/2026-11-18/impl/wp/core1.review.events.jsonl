sStore({ title: { text: 'A', level: 2 }, x: 'day' });\n    10\t    const { next } = store.preview({ title: { text: 'B' } });\n    11\t    expect(next.title).toEqual({ text: 'B' });\n    12\t    expect(next.x).toBe('day');\n    13\t  });\n    14\t\n    15\t  it('removes a key set to undefined, so resolution supplies its default', () => {\n    16\t    const store = new OptionsStore({ title: 'A', legend: 'top' });\n    17\t    const { next, changed } = store.preview({ legend: undefined });\n    18\t    expect(Object.hasOwn(next, 'legend')).toBe(false);\n    19\t    expect(changed.has('legend')).toBe(true);\n    20\t    expect(next.title).toBe('A');\n    21\t  });\n    22\t\n    23\t  it('leaves absent keys alone and reports only what changed', () => {\n    24\t    const data = [{ a: 1 }];\n    25\t    const store = new OptionsStore({ data, title: 'A' });\n    26\t    const { next, changed } = store.preview({ title: 'A' });\n    27\t    expect(next.data).toBe(data);\n    28\t    expect([...changed]).toEqual([]);\n    29\t  });\n    30\t\n    31\t  it('does not change the store until commit (a rejected call keeps the last valid state)', () => {\n    32\t    const store = new OptionsStore({ title: 'A' });\n    33\t    const { next } = store.preview({ title: 'B' });\n    34\t    expect(store.current.title).toBe('A');\n    35\t    store.commit(next);\n    36\t    expect(store.current.title).toBe('B');\n    37\t  });\n    38\t\n    39\t  it('never stores the internal renderer switch', () => {\n    40\t    const store = new OptionsStore({ title: 'A', __renderer: 'svg' });\n    41\t    expect(Object.hasOwn(store.current, '__renderer')).toBe(false);\n    42\t  });\n    43\t\n    44\t  it('for any patch: present keys equal the patch, undefined keys are gone, absent keys keep their value', () => {\n    45\t    const key = fc.constantFrom('a', 'b', 'c', 'd', 'e');\n    46\t    const value = fc.oneof(fc.integer(), fc.string(), fc.constant(undefined), fc.record({ n: fc.integer() }));\n    47\t    fc.assert(fc.property(fc.dictionary(key, value), fc.dictionary(key, value), (initial, patch) => {\n    48\t      const before = applyPatch({}, initial).next;\n    49\t      const { next } = applyPatch(before, patch);\n    50\t      for (const k of ['a', 'b', 'c', 'd', 'e']) {\n    51\t        if (Object.hasOwn(patch, k)) {\n    52\t          if (patch[k] === undefined) expect(Object.hasOwn(next, k)).toBe(false);\n    53\t          else expect(next[k]).toBe(patch[k]);\n    54\t        } else if (Object.hasOwn(before, k)) {\n    55\t          expect(next[k]).toBe(before[k]);\n    56\t        } else {\n    57\t          expect(Object.hasOwn(next, k)).toBe(false);\n    58\t        }\n    59\t      }\n    60\t    }), { numRuns: 1000 });\n    61\t  });\n    62\t});\n    63\t\n    64\tdescribe('structural comparison of field specs', () => {\n    65\t  it('treats equal inline field objects as the same encoding', () => {\n    66\t    expect(sameValue({ field: 'ts', type: 'time' }, { field: 'ts', type: 'time' })).toBe(true);\n    67\t    expect(sameValue({ field: 'ts', domain: [1, 2] }, { field: 'ts', domain: [1, 3] })).toBe(false);\n    68\t    expect(sameValue(['a', { field: 'b' }], ['a', { field: 'b' }])).toBe(true);\n    69\t  });\n    70\t\n    71\t  it('compares functions by identity', () => {\n    72\t    const f = (v: number) => String(v);\n    73\t    expect(sameValue({ field: 'y', format: f }, { field: 'y', format: f })).toBe(true);\n    74\t    expect(sameValue({ field: 'y', format: f }, { field: 'y', format: (v: number) => String(v) })).toBe(false);\n    75\t  });\n    76\t});\npackages/axylo/test/core/validate.test.ts\n     1\timport { describe, expect, it } from 'vitest';\n     2\timport * as Axylo from '../../src/index';\n     3\t\n     4\tconst days = ['2026-01-05', '2026-01-06', '2026-01-07', '2026-01-08', '2026-01-09', '2026-01-10', '2026-01-11'];\n     5\t// The Phase 1 combined dirty fixture (research/harness/src/data.js).\n     6\tconst dirty = [10, 20, null, NaN, '40', undefined, 70];\n     7\t\n     8\tdescribe('the package in Node (spec DX8)', () => {\n     9\t  it('imports without a DOM and exports the five chart functions and validate', () => {\n    10\t    expect(typeof (globalThis as { document?: unknown }).document).toBe('undefined');\n    11\t    for (const name of ['line', 'area', 'bar', 'scatter', 'donut', 'validate'] as const) expect(typeof Axylo[name]).toBe('function');\n    12\t  });\n    13\t\n    14\t  it('validate reports the combined dirty fixture as AX102, AX103 and AX106, once each', () => {\n    15\t    const data = days.map((day, i) => (dirty[i] === undefined ? { day } : { day, value: dirty[i] }));\n    16\t    for (const type of ['line', 'area', 'bar'] as const) {\n    17\t      const codes = Axylo.validate(type, { title: 'Dirty input', data: data as never, x: 'day', y: 'value' as never }).map(d => d.code).sort();\n    18\t      expect(codes, type).toEqual(['AX102', 'AX103', 'AX106']);\n    19\t    }\n    20\t  });\n    21\t\n    22\t  it('validate works for scatter and donut', () => {\n    23\t    const points = [{ a: 1, b: 2 }, { a: 2, b: NaN }];\n    24\t    expect(Axylo.validate('scatter', { title: 'S', data: points, x: 'a', y: 'b' }).map(d => d.code)).toEqual(['AX103']);\n    25\t    const parts = [{ label: 'Chrome', share: 46.2 }, { label: 'Safari', share: -1 }];\n    26\t    expect(Axylo.validate('donut', { title: 'D', data: parts, label: 'label', value: 'share' }).map(d => d.code)).toEqual(['AX120']);\n    27\t  });\n    28\t\n    29\t  it('validate raises AX140 without a title or labelledBy, and AX101 for a misspelled field', () => {\n    30\t    const codes = Axylo.validate('line', { data: [{ day: '2026-01-01', value: 1 }], x: 'day', y: 'valeu' as never }).map(d => d.code).sort();\n    31\t    expect(codes).toEqual(['AX101', 'AX140']);\n    32\t  });\n    33\t\n    34\t  it('a chart function without a DOM fails with a message, not a crash at import', () => {\n    35\t    expect(() => Axylo.line('#nowhere', { data: [], x: 'a' as never, y: 'b' as never })).toThrow(/#nowhere/);\n    36\t  });\n    37\t});\npackages/axylo/test/browser/chart/data.browser.test.ts\n     1\t/**\n     2\t * Data the chart cannot draw as given (spec F3, F12, 3.5), states (L7) and calendar dates in three viewer\n     3\t * zones (F4). Expected codes come from the registry's statement for the combined dirty fixture.\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport { start, stop, url } from '../harness';\n     7\timport { aria, chartPage, closePage } from './util';\n     8\t\n     9\tbeforeAll(start);\n    10\tafterAll(stop);\n    11\t\n    12\tdescribe('dirty input (spec 3.5, F12)', () => {\n    13\t  for (const flavour of ['development', 'production'] as const) {\n    14\t    it(`the combined fixture yields AX102, AX103 and AX106 once each and shows the reader's note (${flavour} build)`, async () => {\n    15\t      const page = await chartPage();\n    16\t      if (flavour === 'production') await page.addScriptTag({ url: url('packages/axylo/dist/axylo.iife.min.js') });\n    17\t      const result = await page.evaluate(async () => {\n    18\t        const chart = window.Axylo.line!('#chart', { title: 'Dirty input', data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n    19\t        await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));\n    20\t        const note = document.querySelector('#chart .axylo-note') as HTMLElement;\n    21\t        return { codes: chart.diagnostics.map(d => d.code), note: note.hidden ? null : note.textContent, role: note.getAttribute('role') };\n    22\t      });\n    23\t      const warnings = result.codes.filter(c => ['AX102', 'AX103', 'AX106'].includes(c)).sort();\n    24\t      expect(warnings).toEqual(['AX102', 'AX103', 'AX106']);\n    25\t      expect(result.note).toBe('Values not shown: 3. See table.');\n    26\t      expect(result.role).toBe('status');\n    27\t      expect(await aria(page)).toMatch(/status: \"?Values not shown: 3\\. See table\\.\"?/);\n    28\t      expect(await closePage(page)).toEqual([]);\n    29\t    });\n    30\t  }\n    31\t\n    32\t  it('prints each warning once with console.warn', async () => {\n    33\t    const page = await chartPage();\n    34\t    const warned: string[] = [];\n    35\t    page.on('console', m => { if (m.type() === 'warning') warned.push(m.text().slice(0, 13)); });\n    36\t    await page.evaluate(async () => {\n    37\t      for (let i = 0; i < 3; i++) window.Axylo.line!(Object.assign(document.body.appendChild(document.createElement('div')), { style: 'width:300px' }), { title: `Dirty ${i}`, data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n    38\t      await window.nextFrames(2);\n    39\t    });\n    40\t    expect(warned.sort()).toEqual(['[axylo AX102]', '[axylo AX103]', '[axylo AX106]']);\n    41\t    expect(await closePage(page)).toEqual([]);\n    42\t  });\n    43\t\n    44\t  it('with strict: true the create call throws and leaves nothing in the target', async () => {\n    45\t    const page = await chartPage();\n    46\t    const result = await page.evaluate(async () => {\n    47\t      const target = document.getElementById('chart')!;\n    48\t      let error: { name: string; message: string; codes: string[] } | null = null;\n    49\t      try {\n    50\t        window.Axylo.line!(target, { title: 'Dirty input', strict: true, data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n    51\t      } catch (e) {\n    52\t        const err = e as Error & { diagnostics: { code: string }[] };\n    53\t        error = { name: err.name, message: err.message, codes: err.diagnostics.map(d => d.code) };\n    54\t      }\n    55\t      await window.nextFrames(2);\n    56\t      return { error, children: target.childElementCount, className: target.className, scheme: target.getAttribute('data-axylo-scheme') };\n    57\t    });\n    58\t    expect(result.error?.message).toMatch(/AX10[236]/);\n    59\t    expect(result.error?.codes.sort()).toEqual(['AX102', 'AX103', 'AX106']);\n    60\t    expect(result.children).toBe(0);\n    61\t    expect(result.className).toBe('');\n    62\t    expect(result.scheme).toBeNull();\n    63\t    expect(await closePage(page)).toEqual([]);\n    64\t  });\n    65\t});\n    66\t\n    67\tdescribe('formatters (spec F6, 3.5)', () => {\n    68\t  it('a custom formatter that throws falls back to the default, raises AX160 when found, and is never thrown', async () => {\n    69\t    const page = await chartPage();\n    70\t    const result = await page.evaluate(async () => {\n    71\t      const chart = window.Axylo.line!('#chart', {\n    72\t        title: 'Formatter', strict: true, data: [{ d: 1, v: 10 }, { d: 2, v: 20 }, { d: 3, v: 30 }], x: 'd',\n    73\t        y: { field: 'v', tickFormat: () => { throw new Error('author bug'); } },\n    74\t      });\n    75\t      await chart.__bench.ready();\n    76\t      return { codes: chart.diagnostics.map(d => d.code), ticks: [...document.querySelectorAll('#chart .axylo-label[data-role=\"tick-y\"]')].map(e => e.textContent) };\n    77\t    });\n    78\t    expect(result.codes).toContain('AX160');\n    79\t    expect(result.ticks).toContain('20');\n    80\t    expect(await closePage(page)).toEqual([]);\n    81\t  });\n    82\t});\n    83\t\n    84\tdescribe('states (spec L7)', () => {\n    85\t  it('empty data shows the empty message inside the plot and no tick labels', async () => {\n    86\t    const page = await chartPage();\n    87\t    const result = await page.evaluate(async () => {\n    88\t      const chart = window.Axylo.line!('#chart', { title: 'Nothing yet', data: [], x: 'day', y: 'value' });\n    89\t      await chart.__bench.ready();\n    90\t      const message = document.querySelector('#chart .axylo-plot .axylo-message') as HTMLElement;\n    91\t      return { message: message.hidden ? null : message.textContent, labels: document.querySelectorAll('#chart .axylo-label').length, errors: chart.diagnostics.filter(d => d.level === 'error').length };\n    92\t    });\n    93\t    expect(result.message).toBe('No data to show.');\n    94\t    expect(result.labels).toBe(0);\n    95\t    expect(result.errors).toBe(0);\n    96\t    expect(await aria(page)).toContain('No data to show.');\n    97\t    expect(await closePage(page)).toEqual([]);\n    98\t  });\n    99\t\n   100\t  it(\"state: 'loading' then update({ state: 'ready' }) is announced once\", async () => {\n   101\t    const page = await chartPage();\n   102\t    const result = await page.evaluate(async () => {\n   103\t      const chart = window.Axylo.line!('#chart', { title: 'Sessions', state: 'loading', data: [], x: 'day', y: 'sessions', series: 'channel' });\n   104\t      await chart.__bench.ready();\n   105\t      const live = document.querySelector('#chart [aria-live=\"polite\"]')!;\n   106\t      const message = document.querySelector('#chart .axylo-message') as HTMLElement;\n   107\t      const loading = message.hidden ? null : message.textContent;\n   108\t      const said: string[] = [];\n   109\t      new MutationObserver(() => said.push(live.textContent ?? '')).observe(live, { childList: true, characterData: true, subtree: true });\n   110\t      chart.update({ state: 'ready', data: window.fx.trendRows() });\n   111\t      await chart.__bench.ready();\n   112\t      await window.nextFrames(3);\n   113\t      return { loading, said, after: message.hidden };\n   114\t    });\n   115\t    expect(result.loading).toBe('Loading chart.');\n   116\t    expect(result.said).toEqual(['Sessions']);\n   117\t    expect(result.after).toBe(true);\n   118\t    expect(await closePage(page)).toEqual([]);\n   119\t  });\n   120\t\n   121\t  it('an author error state and an internal failure both show their message inside the plot, in the accessibility tree', async () => {\n   122\t    const page = await chartPage({ css: '#other { width: 400px; }' });\n   123\t    const consoleErrors: string[] = [];\n   124\t    page.on('console', m => { if (m.type() === 'error') consoleErrors.push(m.text()); });\n   125\t    const result = await page.evaluate(async () => {\n   126\t      const chart = window.Axylo.line!('#chart', { title: 'Sessions', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   127\t      await chart.__bench.ready();\n   128\t      chart.__dev.fail('reader');\n   129\t      chart.update({ title: 'Sessions, renamed' });\n   130\t      await window.nextFrames(2);\n   131\t      const message = document.querySelector('#chart .axylo-message') as HTMLElement;\n   132\t      const internal = message.hidden ? null : message.textContent;\n   133\t      const labels = document.querySelectorAll('#chart .axylo-label').length;\n   134\t      const el = Object.assign(document.body.appendChild(document.createElement('div')), { id: 'other' });\n   135\t      const other = window.Axylo.line!(el, { title: 'Other', state: { error: 'The query failed.' }, data: [], x: 'day', y: 'v' });\n   136\t      await other.__bench.ready();\n   137\t      return { internal, labels, authored: el.querySelector('.axylo-message')!.textContent };\n   138\t    });\n   139\t    expect(result.internal).toBe('Something went wrong while drawing the chart.');\n   140\t    expect(result.labels).toBe(0);\n   141\t    expect(result.authored).toBe('The query failed.');\n   142\t    expect(await aria(page)).toContain('Something went wrong while drawing the chart.');\n   143\t    expect(await aria(page, '#other')).toContain('The query failed.');\n   144\t    expect(consoleErrors.some(t => t.includes('internal error'))).toBe(true);\n   145\t    expect(await closePage(page)).toEqual([]);\n   146\t  });\n   147\t});\n   148\t\n   149\tdescribe('calendar dates in three viewer zones (spec F4 a)', () => {\n   150\t  it('the dates fixture as date strings gives identical tick text in UTC, America/Los_Angeles and Asia/Kolkata', async () => {\n   151\t    const texts: string[][] = [];\n   152\t    for (const timezoneId of ['UTC', 'America/Los_Angeles', 'Asia/Kolkata']) {\n   153\t      const page = await chartPage({ timezoneId });\n   154\t      texts.push(await page.evaluate(async () => {\n   155\t        const chart = window.Axylo.line!('#chart', { title: 'Daily sessions by channel', data: window.fx.datesRows(), x: 'day', y: 'sessions', series: 'channel' });\n   156\t        await chart.__bench.ready();\n   157\t        return [...document.querySelectorAll('#chart .axylo-label[data-role=\"tick-x\"]')].map(e => e.textContent ?? '');\n   158\t      }));\n   159\t      expect(await closePage(page)).toEqual([]);\n   160\t    }\n   161\t    expect(texts[0]!.length).toBeGreaterThan(2);\n   162\t    expect(texts[0]![0]).toMatch(/Jan/);\n   163\t    expect(texts[1]).toEqual(texts[0]);\n   164\t    expect(texts[2]).toEqual(texts[0]);\n   165\t  });\n   166\t});\npackages/axylo/test/browser/chart/lifecycle.browser.test.ts\n     1\t/**\n     2\t * Resize (spec L3), the commit contract (plan 1.5, spec DX5) and teardown, observed through the stage\n     3\t * counters the development build exposes (`chart.__dev.stages()`).\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport { start, stop } from '../harness';\n     7\timport { chartPage, closePage } from './util';\n     8\t\n     9\tbeforeAll(start);\n    10\tafterAll(stop);\n    11\t\n    12\tdescribe('resize (spec L3)', () => {\n    13\t  it('720 → 360 → 720 px relayouts with no call from the page and does not renormalize', async () => {\n    14\t    const page = await chartPage();\n    15\t    const result = await page.evaluate(async () => {\n    16\t      const el = document.getElementById('chart')!;\n    17\t      const chart = window.Axylo.line!(el, { title: 'T', data: window.fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel' });\n    18\t      window.charts.push(chart);\n    19\t      await chart.__bench.ready();\n    20\t      const widths: number[] = [];\n    21\t      const lastLabelRight = () => Math.max(...[...el.querySelectorAll('.axylo-label')].map(l => l.getBoundingClientRect().right)) - el.getBoundingClientRect().left;\n    22\t      const marks = () => (el.querySelector('.axylo-canvas') as HTMLElement).getBoundingClientRect().width;\n    23\t      const first = chart.__dev.stages();\n    24\t      widths.push(marks());\n    25\t      el.style.width = '360px';\n    26\t      await window.nextFrames(3);\n    27\t      widths.push(marks());\n    28\t      const narrow = lastLabelRight();\n    29\t      el.style.width = '720px';\n    30\t      await window.nextFrames(3);\n    31\t      widths.push(marks());\n    32\t      const last = chart.__dev.stages();\n    33\t      return { widths, narrow, first, last };\n    34\t    });\n    35\t    expect(result.widths).toEqual([720, 360, 720]);\n    36\t    expect(result.narrow).toBeLessThanOrEqual(361);\n    37\t    expect(result.last.layout - result.first.layout).toBe(2);\n    38\t    expect(result.last.normalize).toBe(result.first.normalize);\n    39\t    expect(result.last.options).toBe(result.first.options);\n    40\t    expect(await closePage(page)).toEqual([]);\n    41\t  });\n    42\t\n    43\t  it('a container created with display: none draws once shown', async () => {\n    44\t    const page = await chartPage({ css: '#chart { display: none; }' });\n    45\t    const result = await page.evaluate(async () => {\n    46\t      const chart = window.Axylo.line!('#chart', { title: 'Hidden', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    47\t      let ready = false;\n    48\t      void chart.__bench.ready().then(() => { ready = true; });\n    49\t      await window.nextFrames(3);\n    50\t      const hidden = { ready, draws: chart.__dev.stages().draw };\n    51\t      document.getElementById('chart')!.style.display = 'block';\n    52\t      await chart.__bench.ready();\n    53\t      await window.nextFrames(2);\n    54\t      return { hidden, draws: chart.__dev.stages().draw, labels: document.querySelectorAll('#chart .axylo-label').length };\n    55\t    });\n    56\t    expect(result.hidden).toEqual({ ready: false, draws: 0 });\n    57\t    expect(result.draws).toBe(1);\n    58\t    expect(result.labels).toBeGreaterThan(3);\n    59\t    expect(await closePage(page)).toEqual([]);\n    60\t  });\n    61\t\n    62\t  it('a height: auto container gets a 16:9 plot, clamped to 160–480 px, stable over 10 frames', async () => {\n    63\t    const page = await chartPage({ css: '#chart { height: auto; } .w { height: auto; }' });\n    64\t    const result = await page.evaluate(async () => {\n    65\t      const chart = window.Axylo.line!('#chart', { title: 'Auto', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    66\t      await chart.__bench.ready();\n    67\t      const plot = document.querySelector('#chart .axylo-plot')!;\n    68\t      const heights: number[] = [];\n    69\t      const layouts: number[] = [];\n    70\t      for (let i = 0; i < 10; i++) {\n    71\t        await window.nextFrames(1);\n    72\t        heights.push(plot.getBoundingClientRect().height);\n    73\t        layouts.push(chart.__dev.stages().layout);\n    74\t      }\n    75\t      const clamp: number[] = [];\n    76\t      for (const width of [200, 1200]) {\n    77\t        const el = Object.assign(document.body.appendChild(document.createElement('div')), { className: 'w' });\n    78\t        el.style.width = `${width}px`;\n    79\t        const c = window.Axylo.line!(el, { title: 'W', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    80\t        await c.__bench.ready();\n    81\t        clamp.push(el.querySelector('.axylo-plot')!.getBoundingClientRect().height);\n    82\t      }\n    83\t      return { heights, layouts, clamp };\n    84\t    });\n    85\t    expect(new Set(result.heights).size).toBe(1);\n    86\t    expect(result.heights[0]).toBeCloseTo(720 * 9 / 16, 0);\n    87\t    expect(new Set(result.layouts).size).toBe(1);\n    88\t    expect(result.clamp).toEqual([160, 480]);\n    89\t    expect(await closePage(page)).toEqual([]);\n    90\t  });\n    91\t\n    92\t  it('a definite container height is filled: the plot takes what the caption leaves', async () => {\n    93\t    const page = await chartPage({ css: '#chart { height: 300px; }' });\n    94\t    const result = await page.evaluate(async () => {\n    95\t      const chart = window.Axylo.line!('#chart', { title: 'Fixed', subtitle: 'Subtitle', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    96\t      await chart.__bench.ready();\n    97\t      const root = document.getElementById('chart')!.getBoundingClientRect();\n    98\t      const fig = document.querySelector('#chart figure')!.getBoundingClientRect();\n    99\t      const plot = document.querySelector('#chart .axylo-plot')!.getBoundingClientRect();\n   100\t      return { root: root.bottom, fig: fig.bottom, plot: plot.bottom, plotHeight: plot.height };\n   101\t    });\n   102\t    expect(result.fig).toBeCloseTo(result.root, 0);\n   103\t    expect(result.plot).toBeCloseTo(result.root, 0);\n   104\t    expect(result.plotHeight).toBeLessThan(300);\n   105\t    expect(await closePage(page)).toEqual([]);\n   106\t  });\n   107\t});\n   108\t\n   109\tdescribe('commit contract (plan 1.5, spec DX5)', () => {\n   110\t  it('update({ data }), append and zoom in one turn are drawn once and end in the expected state', async () => {\n   111\t    const page = await chartPage();\n   112\t    const result = await page.evaluate(async () => {\n   113\t      const DAY = 864e5;\n   114\t      const rows = (from: number, n: number) => Array.from({ length: n }, (_, i) => ({ day: from + i * DAY, v: i }));\n   115\t      const t0 = Date.UTC(2026, 0, 1);\n   116\t      const chart = window.Axylo.line!('#chart', { title: 'Seq', data: rows(t0, 30), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   117\t      await chart.__bench.ready();\n   118\t      const before = chart.__dev.stages();\n   119\t      const replaced = rows(t0 + 100 * DAY, 10);\n   120\t      chart.update({ data: replaced });\n   121\t      chart.append([{ day: t0 + 110 * DAY, v: 10 }, { day: t0 + 111 * DAY, v: 11 }]);\n   122\t      chart.zoom([new Date(t0 + 105 * DAY), new Date(t0 + 111 * DAY)]);\n   123\t      const sync = chart.__dev.stages();\n   124\t      await chart.__bench.ready();\n   125\t      await window.nextFrames(2);\n   126\t      const after = chart.__dev.stages();\n   127\t      return { before, sync, after, describe: chart.__bench.describe(), t0, DAY };\n   128\t    });\n   129\t    const { before, sync, after, describe, t0, DAY } = result;\n   130\t    expect(sync.draw).toBe(before.draw);\n   131\t    expect(after.draw - before.draw).toBe(1);\n   132\t    expect(after.frame - before.frame).toBe(1);\n   133\t    expect(describe.series[0]!.points).toBe(12);\n   134\t    expect(describe.series[0]!.oldestX).toBe(t0 + 100 * DAY);\n   135\t    expect(describe.series[0]!.newestX).toBe(t0 + 111 * DAY);\n   136\t    expect(describe.xDomain).toEqual([t0 + 105 * DAY, t0 + 111 * DAY]);\n   137\t    expect(await closePage(page)).toEqual([]);\n   138\t  });\n   139\t\n   140\t  it('append with keep keeps that many x values, and a window zoomed to the latest edge follows', async () => {\n   141\t    const page = await chartPage();\n   142\t    const result = await page.evaluate(async () => {\n   143\t      const t0 = Date.UTC(2026, 0, 1);\n   144\t      const M = 60000;\n   145\t      const chart = window.Axylo.line!('#chart', { title: 'Stream', data: { columns: { t: Float64Array.from({ length: 100 }, (_, i) => t0 + i * M), v: Float64Array.from({ length: 100 }, (_, i) => i) } }, x: { field: 't', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   146\t      chart.zoom([new Date(t0 + 80 * M), new Date(t0 + 99 * M)]);\n   147\t      for (let i = 100; i < 110; i++) chart.append([{ t: t0 + i * M, v: i }], { keep: 100 });\n   148\t      await chart.__bench.ready();\n   149\t      return { d: chart.__bench.describe(), stages: chart.__dev.stages(), t0, M };\n   150\t    });\n   151\t    const { d, t0, M } = result;\n   152\t    expect(d.series[0]!.points).toBe(100);\n   153\t    expect(d.series[0]!.oldestX).toBe(t0 + 10 * M);\n   154\t    expect(d.series[0]!.newestX).toBe(t0 + 109 * M);\n   155\t    expect(d.xDomain).toEqual([t0 + 90 * M, t0 + 109 * M]);\n   156\t    expect(result.stages.normalize).toBe(1);\n   157\t    expect(result.stages.draw).toBe(1);\n   158\t    expect(await closePage(page)).toEqual([]);\n   159\t  });\n   160\t\n   161\t  it('a title-only update does not renormalize, rebuild the view or relayout the plot', async () => {\n   162\t    const page = await chartPage({ css: '#chart { height: auto; }' });\n   163\t    const result = await page.evaluate(async () => {\n   164\t      const chart = window.Axylo.line!('#chart', { title: 'Before', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   165\t      await chart.__bench.ready();\n   166\t      const before = chart.__dev.stages();\n   167\t      chart.update({ title: 'After' });\n   168\t      await chart.__bench.ready();\n   169\t      await window.nextFrames(2);\n   170\t      return { before, after: chart.__dev.stages(), heading: document.querySelector('#chart .axylo-title')!.textContent };\n   171\t    });\n   172\t    expect(result.heading).toBe('After');\n   173\t    for (const stage of ['normalize', 'view', 'layout', 'scene', 'draw'] as const) expect(result.after[stage], stage).toBe(result.before[stage]);\n   174\t    expect(result.after.reader).toBe(result.before.reader! + 1);\n   175\t    expect(await closePage(page)).toEqual([]);\n   176\t  });\n   177\t\n   178\t  it('a data-only update that keeps the domains does not relayout', async () => {\n   179\t    const page = await chartPage();\n   180\t    const result = await page.evaluate(async () => {\n   181\t      const t0 = Date.UTC(2026, 0, 1);\n   182\t      const rows = (k: number) => Array.from({ length: 30 }, (_, i) => ({ day: t0 + i * 864e5, v: 50 + ((i * k) % 7) }));\n   183\t      const chart = window.Axylo.line!('#chart', { title: 'T', data: rows(1), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   184\t      await chart.__bench.ready();\n   185\t      const before = chart.__dev.stages();\n   186\t      chart.update({ data: rows(3) });\n   187\t      await chart.__bench.ready();\n   188\t      const same = chart.__dev.stages();\n   189\t      chart.update({ data: rows(3).map(r => ({ ...r, v: r.v * 3 })) });\n   190\t      await chart.__bench.ready();\n   191\t      return { before, same, wider: chart.__dev.stages() };\n   192\t    });\n   193\t    expect(result.same.normalize).toBe(result.before.normalize! + 1);\n   194\t    expect(result.same.layout).toBe(result.before.layout);\n   195\t    expect(result.same.scene).toBe(result.before.scene! + 1);\n   196\t    expect(result.wider.layout).toBe(result.before.layout! + 1);\n   197\t    expect(await closePage(page)).toEqual([]);\n   198\t  });\n   199\t\n   200\t  it('a rejected strict update throws and leaves the previous chart intact', async () => {\n   201\t    const page = await chartPage();\n   202\t    const result = await page.evaluate(async () => {\n   203\t      const good = Array.from({ length: 7 }, (_, i) => ({ day: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][i], value: i }));\n   204\t      const chart = window.Axylo.line!('#chart', { title: 'Strict', strict: true, data: good, x: 'day', y: 'value' });\n   205\t      await chart.__bench.ready();\n   206\t      const before = { stages: chart.__dev.stages(), diagnostics: chart.diagnostics, describe: chart.__bench.describe(), revision: chart.__bench.revision };\n   207\t      let thrown = '';\n   208\t      try {\n   209\t        chart.update({ data: window.fx.dirtyRows(), title: 'Changed' });\n   210\t      } catch (e) {\n   211\t        thrown = String(e);\n   212\t      }\n   213\t      await window.nextFrames(3);\n   214\t      return {\n   215\t        thrown, before,\n   216\t        after: { stages: chart.__dev.stages(), diagnostics: chart.diagnostics, describe: chart.__bench.describe(), revision: chart.__bench.revision },\n   217\t        heading: document.querySelector('#chart .axylo-title')!.textContent,\n   218\t      };\n   219\t    });\n   220\t    expect(result.thrown).toMatch(/AX10[236]/);\n   221\t    expect(result.after.diagnostics).toEqual(result.before.diagnostics);\n   222\t    expect(result.after.describe).toEqual(result.before.describe);\n   223\t    expect(result.after.revision).toBe(result.before.revision);\n   224\t    expect(result.after.stages.draw).toBe(result.before.stages.draw);\n   225\t    expect(result.heading).toBe('Strict');\n   226\t    expect(await closePage(page)).toEqual([]);\n   227\t  });\n   228\t\n   229\t  it('a rejected strict append leaves the data as it was', async () => {\n   230\t    const page = await chartPage();\n   231\t    const result = await page.evaluate(async () => {\n   232\t      const t0 = Date.UTC(2026, 0, 1);\n   233\t      const chart = window.Axylo.line!('#chart', { title: 'Strict stream', strict: true, data: [{ t: t0, v: 1 }, { t: t0 + 864e5, v: 2 }], x: { field: 't', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   234\t      let thrown = '';\n   235\t      try {\n   236\t        chart.append([{ t: t0 + 2 * 864e5, v: NaN }]);\n   237\t      } catch (e) {\n   238\t        thrown = String(e);\n   239\t      }\n   240\t      chart.append([{ t: t0 + 2 * 864e5, v: 3 }]);\n   241\t      await chart.__bench.ready();\n   242\t      return { thrown, d: chart.__bench.describe() };\n   243\t    });\n   244\t    expect(result.thrown).toMatch(/AX103/);\n   245\t    expect(result.d.series[0]!.points).toBe(3);\n   246\t    expect(result.d.series[0]!.missing).toBe(0);\n   247\t    expect(await closePage(page)).toEqual([]);\n   248\t  });\n   249\t\n   250\t  it('destroy() before the frame draws nothing, and empties the target of what the chart added', async () => {\n   251\t    const page = await chartPage();\n   252\t    const result = await page.evaluate(async () => {\n   253\t      const el = document.getElementById('chart')!;\n   254\t      el.classList.add('mine');\n   255\t      const chart = window.Axylo.line!(el, { title: 'Gone', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   256\t      chart.destroy();\n   257\t      await window.nextFrames(3);\n   258\t      const stages = chart.__dev.stages();\n   259\t      chart.update({ title: 'Again' });\n   260\t      chart.append([{ day: Date.now(), channel: 'Direct', sessions: 1 }]);\n   261\t      chart.zoom(null);\n   262\t      await window.nextFrames(2);\n   263\t      return { stages, later: chart.__dev.stages(), children: el.childElementCount, className: el.className, attributes: [...el.attributes].map(a => a.name) };\n   264\t    });\n   265\t    expect(result.stages.draw).toBe(0);\n   266\t    expect(result.stages.frame).toBe(0);\n   267\t    expect(result.later).toEqual(result.stages);\n   268\t    expect(result.children).toBe(0);\n   269\t    expect(result.className).toBe('mine');\n   270\t    expect(result.attributes.sort()).toEqual(['class', 'id']);\n   271\t    expect(await closePage(page)).toEqual([]);\n   272\t  });\n   273\t\n   274\t  it('after destroy() no observer or listener fires', async () => {\n   275\t    const page = await chartPage();\n   276\t    const result = await page.evaluate(async () => {\n   277\t      const el = document.getElementById('chart')!;\n   278\t      const chart = window.Axylo.line!(el, { title: 'Gone', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   279\t      await chart.__bench.ready();\n   280\t      chart.destroy();\n   281\t      const stages = chart.__dev.stages();\n   282\t      el.style.width = '300px';\n   283\t      document.documentElement.classList.add('dark');\n   284\t      document.body.setAttribute('data-theme', 'dark');\n   285\t      el.dispatchEvent(new PointerEvent('pointermove', { clientX: 100, clientY: 100 }));\n   286\t      await window.nextFrames(4);\n   287\t      return { stages, later: chart.__dev.stages(), children: el.childElementCount };\n   288\t    });\n   289\t    expect(result.later).toEqual(result.stages);\n   290\t    expect(result.children).toBe(0);\n   291\t    expect(await closePage(page)).toEqual([]);\n   292\t  });\n   293\t});\n   294\t\n   295\tdescribe('memory (spec P7, DX5)', () => {\n   296\t  // Method corrected by the coordinator on 2026-11-18. The first version compared cycles 200–400 with 800–1000\n   297\t  // and allowed 5%; it measured 5.3%, and heap snapshots put that growth in the engine's compiled code, which\n   298\t  // keeps growing until about 1,500 cycles and then stops. A leak is growth that does not stop, so the trend is\n   299\t  // now judged after that warm-up, with a tighter allowance (1%). The snapshot test below checks retained\n   300\t  // objects directly.\n   301\t  it('create–destroy cycles show no upward heap trend once the engine has warmed up', async () => {\n   302\t    const page = await chartPage();\n   303\t    const cdp = await page.context().newCDPSession(page);\n   304\t    await cdp.send('HeapProfiler.enable');\n   305\t    const samples: { cycle: number; used: number }[] = [];\n   306\t    const STEP = 25;\n   307\t    for (let cycle = 0; cycle < 2500; cycle += STEP) {\n   308\t      await page.evaluate(async n => {\n   309\t        const el = document.getElementById('chart')!;\n   310\t        const rows = window.fx.trendRows();\n   311\t        for (let i = 0; i < n; i++) {\n   312\t          const chart = window.Axylo.line!(el, { title: 'Cycle', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n   313\t          await chart.__bench.ready();\n   314\t          chart.destroy();\n   315\t        }\n   316\t      }, STEP);\n   317\t      await cdp.send('HeapProfiler.collectGarbage');\n   318\t      await cdp.send('HeapProfiler.collectGarbage');\n   319\t      const { usedSize } = await cdp.send('Runtime.getHeapUsage');\n   320\t      samples.push({ cycle: cycle + STEP, used: usedSize });\n   321\t    }\n   322\t    const mean = (from: number, to: number) => {\n   323\t      const s = samples.filter(x => x.cycle > from && x.cycle <= to);\n   324\t      return s.reduce((a, b) => a + b.used, 0) / s.length;\n   325\t    };\n   326\t    const early = mean(1500, 2000);\n   327\t    const late = mean(2000, 2500);\n   328\t    expect(late / early, `heap mean cycles 1500–2000: ${Math.round(early)} B, 2000–2500: ${Math.round(late)} B`).toBeLessThanOrEqual(1.01);\n   329\t    const leftovers = await page.evaluate(() => document.getElementById('chart')!.childElementCount);\n   330\t    expect(leftovers).toBe(0);\n   331\t    expect(await closePage(page)).toEqual([]);\n   332\t  }, 600_000);\n   333\t\n   334\t  // Supplementary to the test above. On this machine the heap measured that way grows by about 6% between\n   335\t  // cycles 200–400 and 800–1000 and levels off after about 1,500 cycles; heap snapshots attribute the growth\n   336\t  // to compiled code (V8 InstructionStream, Code and their metadata), not to objects the chart retains. This\n   337\t  // test counts only what a leak would leave: every heap object except compiled code and V8's own metadata.\n   338\t  it('objects other than compiled code do not grow from cycle 300 to cycle 1,000', async () => {\n   339\t    const page = await chartPage();\n   340\t    const cdp = await page.context().newCDPSession(page);\n   341\t    const cycles = (n: number) => page.evaluate(async k => {\n   342\t      const el = document.getElementById('chart')!;\n   343\t      const rows = window.fx.trendRows();\n   344\t      for (let i = 0; i < k; i++) {\n   345\t        const chart = window.Axylo.line!(el, { title: 'Cycle', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n   346\t        await chart.__bench.ready();\n   347\t        chart.destroy();\n   348\t      }\n   349\t    }, n);\n   350\t    const retained = async (): Promise<number> => {\n   351\t      await cdp.send('HeapProfiler.collectGarbage');\n   352\t      const chunks: string[] = [];\n   353\t      const onChunk = (e: { chunk: string }) => chunks.push(e.chunk);\n   354\t      cdp.on('HeapProfiler.addHeapSnapshotChunk', onChunk);\n   355\t      await cdp.send('HeapProfiler.takeHeapSnapshot', { reportProgress: false });\n   356\t      cdp.off('HeapProfiler.addHeapSnapshotChunk', onChunk);\n   357\t      const snap = JSON.parse(chunks.join('')) as { snapshot: { meta: { node_fields: string[]; node_types: [string[]] } }; nodes: number[]; strings: string[] };\n   358\t      const fields = snap.snapshot.meta.node_fields;\n   359\t      const types = snap.snapshot.meta.node_types[0];\n   360\t      const typeAt = fields.indexOf('type');\n   361\t      const nameAt = fields.indexOf('name');\n   362\t      const sizeAt = fields.indexOf('self_size');\n   363\t      let total = 0;\n   364\t      for (let i = 0; i < snap.nodes.length; i += fields.length) {\n   365\t        const type = types[snap.nodes[i + typeAt]!];\n   366\t        const name = snap.strings[snap.nodes[i + nameAt]!]!;\n   367\t        if (type === 'code' || name.startsWith('system / ')) continue;\n   368\t        total += snap.nodes[i + sizeAt]!;\n   369\t      }\n   370\t      return total;\n   371\t    };\n   372\t    await cycles(300);\n   373\t    const early = await retained();\n   374\t    await cycles(700);\n   375\t    const late = await retained();\n   376\t    // One leaked chart (its DOM, frame and scene) is several kilobytes; 700 of them would be megabytes.\n   377\t    expect(late - early, `non-code heap at cycle 300: ${early} B, at 1,000: ${late} B`).toBeLessThan(64 * 1024);\n   378\t    expect(await closePage(page)).toEqual([]);\n   379\t  }, 300_000);\n   380\t});\npackages/axylo/test/browser/chart/node.browser.test.ts\n     1\t/**\n     2\t * Spec DX8: the built package imports in a plain Node process (no DOM, no test framework) and `validate`\n     3\t * runs there. Lives with the browser tests because it needs `npm run build` first.\n     4\t */\n     5\timport { describe, expect, it } from 'vitest';\n     6\timport { execFileSync } from 'node:child_process';\n     7\timport path from 'node:path';\n     8\t\n     9\tconst dist = path.resolve(import.meta.dirname, '../../../dist');\n    10\t\n    11\tdescribe('the built package in plain Node (spec DX8)', () => {\n    12\t  for (const file of ['axylo.js', 'axylo.dev.js']) {\n    13\t    it(`import('${file}') does not throw and validate('line', …) returns diagnostics`, () => {\n    14\t      const script = `\n    15\t        const m = await import(${JSON.stringify(path.join(dist, file))});\n    16\t        const d = m.validate('line', { title: 'Dirty input', data: [{ day: 'Mon', value: 10 }, { day: 'Tue', value: NaN }], x: 'day', y: 'value' });\n    17\t        console.log(JSON.stringify({ exports: Object.keys(m).sort(), codes: d.map(x => x.code), document: typeof document }));`;\n    18\t      const out = JSON.parse(execFileSync(process.execPath, ['--input-type=module', '-e', script], { encoding: 'utf8' }).trim());\n    19\t      expect(out.exports).toEqual(['area', 'bar', 'donut', 'line', 'scatter', 'validate']);\n    20\t      expect(out.codes).toEqual(['AX103']);\n    21\t      expect(out.document).toBe('undefined');\n    22\t    });\n    23\t  }\n    24\t});\npackages/axylo/test/browser/chart/render.browser.test.ts\n     1\t/**\n     2\t * The chart types render their Phase 1 fixtures through the public API of the built bundle, with both mark\n     3\t * renderers (spec A1, C1, F2; plan M1 \"trend renders\"). Expected values come from the fixtures and the spec.\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport { start, stop } from '../harness';\n     7\timport { LIGHT } from '../../../src/theme/palette';\n     8\timport { aria, chartPage, closePage, columnsWith, count, hex, shot } from './util';\n     9\t\n    10\tbeforeAll(start);\n    11\tafterAll(stop);\n    12\t\n    13\tconst renderers = ['canvas', 'svg'] as const;\n    14\t\n    15\tdescribe('trend (3 series × 120 days, 7 nulls)', () => {\n    16\t  for (const renderer of renderers) {\n    17\t    it(`renders with the ${renderer} renderer: named group, summary of three series, three colors, a visible gap`, async () => {\n    18\t      const page = await chartPage();\n    19\t      const result = await page.evaluate(async r => {\n    20\t        const fx = window.fx;\n    21\t        const chart = window.Axylo.line!('#chart', {\n    22\t          title: fx.trend.title, data: fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' },\n    23\t          y: { field: 'sessions', label: fx.trend.yTitle }, series: 'channel', __renderer: r,\n    24\t        });\n    25\t        await chart.__bench.ready();\n    26\t        const fig = document.querySelector('#chart figure')!;\n    27\t        const summary = document.getElementById(fig.getAttribute('aria-describedby')!)!.textContent;\n    28\t        return { summary, renderer: chart.__dev.renderer, diagnostics: chart.diagnostics.map(d => d.level + ' ' + d.code) };\n    29\t      }, renderer);\n    30\t      expect(result.renderer).toBe(renderer);\n    31\t      expect(result.diagnostics.filter(d => d.startsWith('error'))).toEqual([]);\n    32\t      for (const name of ['Direct', 'Organic search', 'Referral']) expect(result.summary).toContain(name);\n    33\t      const tree = await aria(page);\n    34\t      expect(tree).toContain('group \"Daily sessions by channel\"');\n    35\t      expect(tree).toContain('heading \"Daily sessions by channel\" [level=3]');\n    36\t\n    37\t      const { img } = await shot(page, '#chart .axylo-plot');\n    38\t      const colors = LIGHT.series.slice(0, 3).map(hex);\n    39\t      for (const color of colors) expect(count(img, color, 40)).toBeGreaterThan(200);\n    40\t      // Referral (series 3) is null at days 60–66: a run of columns without its color, with color on both sides.\n    41\t      const has = columnsWith(img, colors[2]!, 0, img.height, 40);\n    42\t      const from = Math.floor(img.width * 0.35);\n    43\t      const to = Math.floor(img.width * 0.75);\n    44\t      let longest = 0;\n    45\t      let run = 0;\n    46\t      for (let x = from; x < to; x++) {\n    47\t        run = has[x] ? 0 : run + 1;\n    48\t        longest = Math.max(longest, run);\n    49\t      }\n    50\t      expect(longest).toBeGreaterThanOrEqual(20);\n    51\t      expect(has.slice(from - 40, from).some(Boolean)).toBe(true);\n    52\t      expect(has.slice(to, to + 40).some(Boolean)).toBe(true);\n    53\t      expect(await closePage(page)).toEqual([]);\n    54\t    });\n    55\t  }\n    56\t});\n    57\t\n    58\tdescribe('the other chart types', () => {\n    59\t  for (const renderer of renderers) {\n    60\t    it(`bar, area, scatter, donut and compact render their fixtures (${renderer})`, async () => {\n    61\t      const page = await chartPage({ css: '.tile { width: 480px; height: 300px; } .spark { width: 160px; }' });\n    62\t      const result = await page.evaluate(async r => {\n    63\t        const fx = window.fx;\n    64\t        const A = window.Axylo;\n    65\t        const box = (id: string, className = 'tile') => {\n    66\t          const el = document.createElement('div');\n    67\t          el.id = id;\n    68\t          el.className = className;\n    69\t          document.body.appendChild(el);\n    70\t          return el;\n    71\t        };\n    72\t        const barRows = fx.bars.categories.map((team, i) => ({ team, satisfied: fx.bars.values[i] }));\n    73\t        const groupRows = fx.bars.categories.flatMap((team, i) => [\n    74\t          { team, year: '2025', satisfied: fx.bars.values[i]! - 3 }, { team, year: '2026', satisfied: fx.bars.values[i] },\n    75\t        ]);\n    76\t        const random = fx.rng(3);\n    77\t        const points = Array.from({ length: 500 }, (_, i) => ({ x: random() * 100, y: random() * 50 + i * 0.01, group: i % 2 ? 'A' : 'B' }));\n    78\t        const charts = {\n    79\t          bar: A.bar!(box('bar'), { title: fx.bars.title, data: barRows, x: 'team', y: { field: 'satisfied', label: fx.bars.yTitle }, __renderer: r }),\n    80\t          grouped: A.bar!(box('grouped'), { title: 'Grouped', data: groupRows, x: 'team', y: 'satisfied', series: 'year', __renderer: r }),\n    81\t          stacked: A.bar!(box('stacked'), { title: 'Stacked', data: groupRows, x: 'team', y: 'satisfied', series: 'year', layout: 'stacked', __renderer: r }),\n    82\t          area: A.area!(box('area'), { title: 'Stacked area', data: fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel', stacked: true, __renderer: r }),\n    83\t          scatter: A.scatter!(box('scatter'), { title: 'Scatter of 500 points', data: points, x: 'x', y: 'y', series: 'group', __renderer: r }),\n    84\t          donut: A.donut!(box('donut'), { title: fx.parts.title, data: fx.parts.labels.map((label, i) => ({ label, share: fx.parts.values[i] })), label: 'label', value: { field: 'share', label: fx.parts.name }, __renderer: r }),\n    85\t          compact: A.line!(box('compact', 'spark'), { title: 'Sessions, last 120 days', data: fx.trendRows().filter(row => row.channel === 'Direct'), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', compact: true, __renderer: r }),\n    86\t        };\n    87\t        await Promise.all(Object.values(charts).map(c => c.__bench.ready()));\n    88\t        const out: Record<string, Record<string, unknown>> = {};\n    89\t        for (const [name, chart] of Object.entries(charts)) {\n    90\t          const fig = document.querySelector(`#${name} figure`) as HTMLElement;\n    91\t          const marks = fig.querySelector('.axylo-canvas canvas, .axylo-svg') as HTMLElement;\n    92\t          out[name] = {\n    93\t            role: fig.getAttribute('role'), label: fig.getAttribute('aria-label'), labelledby: fig.getAttribute('aria-labelledby'),\n    94\t            errors: chart.diagnostics.filter(d => d.level === 'error').map(d => d.code),\n    95\t            message: (fig.querySelector('.axylo-message') as HTMLElement).hidden ? null : fig.querySelector('.axylo-message')!.textContent,\n    96\t            marks: marks.getBoundingClientRect().height,\n    97\t            plotHeight: fig.querySelector('.axylo-plot')!.getBoundingClientRect().height,\n    98\t            tabStops: fig.querySelectorAll('[tabindex]').length,\n    99\t            summary: document.getElementById(fig.getAttribute('aria-describedby')!)!.textContent,\n   100\t          };\n   101\t        }\n   102\t        return out;\n   103\t      }, renderer);\n   104\t      for (const [name, r] of Object.entries(result) as [string, Record<string, unknown>][]) {\n   105\t        expect(r.errors, name).toEqual([]);\n   106\t        expect(r.message, name).toBeNull();\n   107\t        expect(r.marks, name).toBeGreaterThan(0);\n   108\t        expect(r.summary, name).not.toBe('');\n   109\t      }\n   110\t      for (const name of ['bar', 'grouped', 'stacked', 'area', 'scatter', 'donut']) {\n   111\t        expect(result[name]!.role, name).toBe('group');\n   112\t        expect(result[name]!.labelledby, name).toMatch(/-t$/);\n   113\t      }\n   114\t      // Compact (spec C1, C3): an image named by its title, described by the summary, no tab stop, 32 px tall.\n   115\t      expect(result.compact!.role).toBe('img');\n   116\t      expect(result.compact!.label).toBe('Sessions, last 120 days');\n   117\t      expect(result.compact!.tabStops).toBe(0);\n   118\t      expect(result.compact!.plotHeight).toBe(32);\n   119\t      const tree = await aria(page, '#compact');\n   120\t      expect(tree).toContain('img \"Sessions, last 120 days\"');\n   121\t      expect(tree).not.toContain('heading');\n   122\t      // Donut summary lists the slices with their values (spec F8 text).\n   123\t      expect(result.donut!.summary).toContain('Chrome');\n   124\t      expect(result.donut!.summary).toContain('Samsung Internet');\n   125\t      expect(await aria(page, '#donut')).toContain('group \"Sessions by browser\"');\n   126\t      expect(await closePage(page)).toEqual([]);\n   127\t    });\n   128\t  }\n   129\t});\n   130\t\n   131\tdescribe('compact variant (spec C1, C5)', () => {\n   132\t  it('with values left out, the description says so and a corner marker appears; there is no note element', async () => {\n   133\t    const page = await chartPage({ css: '#chart { width: 160px; height: auto; }' });\n   134\t    const result = await page.evaluate(async () => {\n   135\t      const chart = window.Axylo.line!('#chart', { title: 'Dirty spark', compact: true, data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n   136\t      await chart.__bench.ready();\n   137\t      const fig = document.querySelector('#chart figure')!;\n   138\t      const corner = fig.querySelector('.axylo-corner') as HTMLElement;\n   139\t      const note = fig.querySelector('.axylo-note') as HTMLElement;\n   140\t      return {\n   141\t        description: document.getElementById(fig.getAttribute('aria-describedby')!)!.textContent,\n   142\t        corner: corner.hidden ? null : corner.getBoundingClientRect().width, cornerTitle: corner.getAttribute('title'),\n   143\t        note: note.hidden, tabStops: fig.querySelectorAll('[tabindex]').length,\n   144\t      };\n   145\t    });\n   146\t    expect(result.description).toMatch(/3\\b.*not shown|not shown.*3\\b/i);\n   147\t    expect(result.corner).toBeGreaterThan(0);\n   148\t    expect(result.cornerTitle).toMatch(/not shown/i);\n   149\t    expect(result.note).toBe(true);\n   150\t    expect(result.tabStops).toBe(0);\n   151\t    expect(await closePage(page)).toEqual([]);\n   152\t  });\n   153\t});\n   154\t\n   155\tdescribe('names and ids', () => {\n   156\t  it('24 charts on one page: no duplicate ids, each its own name', async () => {\n   157\t    const page = await chartPage({ css: '.tile { width: 220px; height: 160px; display: inline-block; }' });\n   158\t    const result = await page.evaluate(async () => {\n   159\t      const charts = Array.from({ length: 24 }, (_, i) => {\n   160\t        const el = document.createElement('div');\n   161\t        el.className = 'tile';\n   162\t        document.body.appendChild(el);\n   163\t        return window.Axylo.line!(el, { title: `Chart ${i + 1}`, data: window.fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel' });\n   164\t      });\n   165\t      await Promise.all(charts.map(c => c.__bench.ready()));\n   166\t      const ids = [...document.querySelectorAll('[id]')].map(e => e.id);\n   167\t      const names = [...document.querySelectorAll('figure')].map(f => document.getElementById(f.getAttribute('aria-labelledby')!)?.textContent);\n   168\t      return { ids, duplicates: ids.filter((id, i) => ids.indexOf(id) !== i), names };\n   169\t    });\n   170\t    expect(result.duplicates).toEqual([]);\n   171\t    expect(new Set(result.names).size).toBe(24);\n   172\t    expect(result.names[23]).toBe('Chart 24');\n   173\t    expect(await closePage(page)).toEqual([]);\n   174\t  });\n   175\t\n   176\t  it('labelledBy names the chart from the page heading, with no heading of its own; title.level and visible are honoured', async () => {\n   177\t    const page = await chartPage();\n   178\t    const result = await page.evaluate(async () => {\n   179\t      const h = document.createElement('h2');\n   180\t      h.id = 'card-title';\n   181\t      h.textContent = 'Sessions card';\n   182\t      document.body.prepend(h);\n   183\t      const rows = window.fx.trendRows();\n   184\t      const a = window.Axylo.line!('#chart', { labelledBy: 'card-title', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n   185\t      const el = document.createElement('div');\n   186\t      el.id = 'second';\n   187\t      el.style.width = '400px';\n   188\t      document.body.appendChild(el);\n   189\t      const b = window.Axylo.line!(el, { title: { text: 'Hidden title', level: 4, visible: false }, data: rows, x: 'day', y: 'sessions', series: 'channel' });\n   190\t      await Promise.all([a.__bench.ready(), b.__bench.ready()]);\n   191\t      const t = el.querySelector('.axylo-title') as HTMLElement;\n   192\t      return {\n   193\t        a: document.querySelector('#chart figure')!.getAttribute('aria-labelledby'),\n   194\t        aHeading: (document.querySelector('#chart .axylo-title') as HTMLElement).hidden,\n   195\t        aCodes: a.diagnostics.map(d => d.code),\n   196\t        bLevel: t.getAttribute('aria-level'), bWidth: t.getBoundingClientRect().width,\n   197\t      };\n   198\t    });\n   199\t    expect(result.a).toBe('card-title');\n   200\t    expect(result.aHeading).toBe(true);\n   201\t    expect(result.aCodes).not.toContain('AX140');\n   202\t    expect(result.bLevel).toBe('4');\n   203\t    expect(result.bWidth).toBeLessThanOrEqual(1);\n   204\t    expect(await aria(page, '#second')).toContain('heading \"Hidden title\" [level=4]');\n   205\t    expect(await closePage(page)).toEqual([]);\n   206\t  });\n   207\t\n   208\t  it('a chart without title or labelledBy gets a generated name and AX140', async () => {\n   209\t    const page = await chartPage();\n   210\t    const result = await page.evaluate(async () => {\n   211\t      const chart = window.Axylo.line!('#chart', { data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   212\t      await chart.__bench.ready();\n   213\t      return { codes: chart.diagnostics.map(d => d.code), label: document.querySelector('#chart figure')!.getAttribute('aria-label') };\n   214\t    });\n   215\t    expect(result.codes).toContain('AX140');\n   216\t    expect(result.label).toBe('Line chart of sessions by day');\n   217\t    expect(await closePage(page)).toEqual([]);\n   218\t  });\n   219\t\n   220\t  it('a selector that matches nothing throws an error naming it', async () => {\n   221\t    const page = await chartPage();\n   222\t    const message = await page.evaluate(() => {\n   223\t      try {\n   224\t        window.Axylo.line!('#missing-chart', { data: [], x: 'a', y: 'b' });\n   225\t        return 'no error';\n   226\t      } catch (error) {\n   227\t        return String(error);\n   228\t      }\n   229\t    });\n   230\t    expect(message).toContain('#missing-chart');\n   231\t    expect(await closePage(page)).toEqual([]);\n   232\t  });\n   233\t\n   234\t  it('works with the stylesheet applied through ensureStyles (no linked axylo.css)', async () => {\n   235\t    const page = await chartPage({ standaloneCss: false });\n   236\t    const result = await page.evaluate(async () => {\n   237\t      const chart = window.Axylo.line!('#chart', { title: 'T', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   238\t      await chart.__bench.ready();\n   239\t      const summary = document.querySelector('#chart .axylo-summary')!;\n   240\t      return { sheets: document.adoptedStyleSheets.length, summaryWidth: summary.getBoundingClientRect().width, display: getComputedStyle(document.querySelector('#chart figure')!).display };\n   241\t    });\n   242\t    expect(result.sheets).toBe(1);\n   243\t    expect(result.display).toBe('flex');\n   244\t    expect(result.summaryWidth).toBeLessThanOrEqual(1);\n   245\t    expect(await closePage(page)).toEqual([]);\n   246\t  });\n   247\t});\n   248\t\n   249\tdescribe('tooltip', () => {\n   250\t  it('shows every series at the nearest x on pointer move, built as text, and hides on leave', async () => {\n   251\t    const page = await chartPage();\n   252\t    await page.evaluate(async () => {\n   253\t      const chart = window.Axylo.line!('#chart', { title: 'T', data: window.fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel' });\n   254\t      window.charts.push(chart);\n   255\t      await chart.__bench.ready();\n   256\t    });\n   257\t    const plot = (await page.locator('#chart .axylo-plot').boundingBox())!;\n   258\t    await page.mouse.move(plot.x + plot.width * 0.5, plot.y + plot.height * 0.5);\n   259\t    const tip = page.locator('#chart .axylo-tooltip');\n   260\t    await expect.poll(() => tip.isVisible()).toBe(true);\n   261\t    const text = await tip.textContent();\n   262\t    for (const name of ['Direct', 'Organic search', 'Referral']) expect(text).toContain(name);\n   263\t    expect(text).toContain('UTC');\n   264\t    expect(await tip.locator('script, img').count()).toBe(0);\n   265\t    await page.mouse.move(5, 5);\n   266\t    await expect.poll(() => tip.isVisible()).toBe(false);\n   267\t    expect(await closePage(page)).toEqual([]);\n   268\t  });\n   269\t});\npackages/axylo/test/browser/chart/theme.browser.test.ts\n     1\t/**\n     2\t * Light and dark from the page (spec L4), repaint on a runtime toggle for both renderers, and AX141 for an\n     3\t * author color with poor contrast (spec A5, 3.5). Colors are the default palette (src/theme/palette.ts).\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport type { Page } from 'playwright-core';\n     7\timport { start, stop } from '../harness';\n     8\timport { DARK, LIGHT } from '../../../src/theme/palette';\n     9\timport { chartPage, closePage, count, hex, shot } from './util';\n    10\t\n    11\tbeforeAll(start);\n    12\tafterAll(stop);\n    13\t\n    14\tasync function create(page: Page, renderer: 'canvas' | 'svg', extra: Record<string, unknown> = {}): Promise<{ scheme: string | null; codes: string[] }> {\n    15\t  return page.evaluate(async ([r, more]) => {\n    16\t    const chart = window.Axylo.line!('#chart', {\n    17\t      title: 'Theme', data: window.fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel', __renderer: r, ...more,\n    18\t    });\n    19\t    window.charts.push(chart);\n    20\t    await chart.__bench.ready();\n    21\t    return { scheme: document.getElementById('chart')!.getAttribute('data-axylo-scheme'), codes: chart.diagnostics.map(d => d.code) };\n    22\t  }, [renderer, extra] as const);\n    23\t}\n    24\t\n    25\tconst seriesPixels = async (page: Page, color: string): Promise<number> => count((await shot(page, '#chart .axylo-plot')).img, hex(color), 40);\n    26\t\n    27\tdescribe('scheme from the page (spec L4)', () => {\n    28\t  it('a page with color-scheme: dark draws the dark palette', async () => {\n    29\t    const page = await chartPage({ css: ':root { color-scheme: dark; } body { background: #16181d; color: #e8eaee; }' });\n    30\t    expect((await create(page, 'canvas')).scheme).toBe('dark');\n    31\t    expect(await seriesPixels(page, DARK.series[0]!)).toBeGreaterThan(200);\n    32\t    expect(await closePage(page)).toEqual([]);\n    33\t  });\n    34\t\n    35\t  it('a class-toggled dark page without color-scheme is dark, from the inherited text color', async () => {\n    36\t    const page = await chartPage({ css: 'html.dark body { background: #16181d; color: #e8eaee; }' });\n    37\t    await page.evaluate(() => document.documentElement.classList.add('dark'));\n    38\t    expect((await create(page, 'svg')).scheme).toBe('dark');\n    39\t    expect(await seriesPixels(page, DARK.series[0]!)).toBeGreaterThan(200);\n    40\t    expect(await closePage(page)).toEqual([]);\n    41\t  });\n    42\t\n    43\t  it('a light-only page under dark emulation stays light', async () => {\n    44\t    const page = await chartPage({ colorScheme: 'dark', css: ':root { color-scheme: light; }' });\n    45\t    expect((await create(page, 'canvas')).scheme).toBe('light');\n    46\t    expect(await seriesPixels(page, LIGHT.series[0]!)).toBeGreaterThan(200);\n    47\t    expect(await closePage(page)).toEqual([]);\n    48\t  });\n    49\t\n    50\t  for (const renderer of ['canvas', 'svg'] as const) {\n    51\t    it(`toggling a dark class repaints within a frame, without rebuilding the scene (${renderer})`, async () => {\n    52\t      const page = await chartPage({ css: 'html.dark body { background: #16181d; color: #e8eaee; }' });\n    53\t      expect((await create(page, renderer)).scheme).toBe('light');\n    54\t      const result = await page.evaluate(async () => {\n    55\t        const chart = window.charts[0]!;\n    56\t        const before = chart.__dev.stages();\n    57\t        document.documentElement.classList.add('dark');\n    58\t        // Let the attribute observer run, then read in the first frame after the toggle.\n    59\t        await Promise.resolve();\n    60\t        await new Promise(r => requestAnimationFrame(r));\n    61\t        return { before, after: chart.__dev.stages(), scheme: document.getElementById('chart')!.getAttribute('data-axylo-scheme') };\n    62\t      });\n    63\t      expect(result.scheme).toBe('dark');\n    64\t      expect(result.after.theme).toBe(result.before.theme! + 1);\n    65\t      expect(result.after.scene).toBe(result.before.scene);\n    66\t      // The same call for both renderers: canvas needs it to repaint, SVG restyles through CSS anyway.\n    67\t      expect(result.after.draw).toBe(result.before.draw + 1);\n    68\t      expect(result.after.layout).toBe(result.before.layout);\n    69\t      expect(await seriesPixels(page, DARK.series[0]!)).toBeGreaterThan(200);\n    70\t      expect(await seriesPixels(page, LIGHT.series[0]!)).toBeLessThan(20);\n    71\t      expect(await closePage(page)).toEqual([]);\n    72\t    });\n    73\t  }\n    74\t});\n    75\t\n    76\tdescribe('contrast (spec A5, AX141)', () => {\n    77\t  it('an author color with poor contrast raises AX141 after theme resolution, and strict does not throw for it', async () => {\n    78\t    const page = await chartPage();\n    79\t    const result = await create(page, 'svg', { strict: true, colors: { Direct: '#f4f4f4' } });\n    80\t    expect(result.codes).toContain('AX141');\n    81\t    const plain = await page.evaluate(async () => {\n    82\t      const el = Object.assign(document.body.appendChild(document.createElement('div')), { style: 'width: 300px' });\n    83\t      const chart = window.Axylo.line!(el, { title: 'Default colors', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    84\t      await chart.__bench.ready();\n    85\t      return chart.diagnostics.map(d => d.code);\n    86\t    });\n    87\t    expect(plain).not.toContain('AX141');\n    88\t    expect(await closePage(page)).toEqual([]);\n    89\t  });\n    90\t\n    91\t  it('onDiagnostic receives AX141 when it is found', async () => {\n    92\t    const page = await chartPage();\n    93\t    const codes = await page.evaluate(async () => {\n    94\t      const seen: string[] = [];\n    95\t      const chart = window.Axylo.line!('#chart', { title: 'T', colors: { Direct: '#fafafa' }, onDiagnostic: (d: { code: string }) => seen.push(d.code), data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    96\t      await chart.__bench.ready();\n    97\t      return seen;\n    98\t    });\n    99\t    expect(codes).toContain('AX141');\n   100\t    expect(await closePage(page)).toEqual([]);\n   101\t  });\n   102\t});\npackages/axylo/test/browser/chart/util.ts\n     1\t/**\n     2\t * Shared setup for the chart tests: the test page with the built script-tag bundle (`window.Axylo`, the\n     3\t * development flavour), and the Phase 1 fixtures (research/harness/src/data.js) installed as `window.fx`.\n     4\t */\n     5\timport type { BrowserContextOptions, Page } from 'playwright-core';\n     6\timport { openPage } from '../harness';\n     7\timport { decodePng, type Image } from '../render/png';\n     8\t\n     9\texport type { Image };\n    10\t\n    11\tdeclare global {\n    12\t  interface Window {\n    13\t    // The bundle's global and the fixtures, typed loosely: the tests drive the public API as a page would.\n    14\t    Axylo: Record<string, (...args: unknown[]) => ChartLike>;\n    15\t    fx: Fixtures;\n    16\t    charts: ChartLike[];\n    17\t    nextFrames(n?: number): Promise<void>;\n    18\t  }\n    19\t}\n    20\t\n    21\texport interface ChartLike {\n    22\t  update(patch: Record<string, unknown>): void;\n    23\t  append(rows: readonly unknown[], options?: { keep?: number }): void;\n    24\t  zoom(domain: readonly unknown[] | null): void;\n    25\t  on(event: string, listener: (payload: unknown) => void): () => void;\n    26\t  readonly diagnostics: readonly { code: string; level: string; message: string; field?: string; chart: string }[];\n    27\t  destroy(): void;\n    28\t  __bench: { revision: number; ready(): Promise<void>; describe(): { xDomain: number[] | null; yDomain: number[] | null; series: { key: string; points: number; oldestX: number; newestX: number; missing: number }[] } };\n    29\t  __dev: { stages(): Stages; fail(stage: string | null): void; renderer: string };\n    30\t}\n    31\t\n    32\t/** Counters per pipeline stage (src/core/chart.ts, STAGES). */\n    33\texport type Stages = Record<'options' | 'normalize' | 'append' | 'view' | 'frame' | 'theme' | 'formatters' | 'layout' | 'scene' | 'lookup' | 'reader' | 'draw' | 'text' | 'figure', number>;\n    34\t\n    35\texport interface Fixtures {\n    36\t  trend: { title: string; yTitle: string; t: number[]; series: { name: string; values: (number | null)[] }[] };\n    37\t  trendRows(): Record<string, unknown>[];\n    38\t  datesRows(): Record<string, unknown>[];\n    39\t  bars: { title: string; yTitle: string; name: string; categories: string[]; values: number[] };\n    40\t  parts: { title: string; name: string; labels: string[]; values: number[] };\n    41\t  dirtyRows(): Record<string, unknown>[];\n    42\t  scale(n: number): { title: string; t: number[]; y: number[] };\n    43\t  rng(seed: number): () => number;\n    44\t}\n    45\t\n    46\t/** Runs in the page: the Phase 1 fixtures, reproduced from research/harness/src/data.js. */\n    47\tfunction installFixtures(): void {\n    48\t  function rng(seed: number) {\n    49\t    let s = seed >>> 0;\n    50\t    return () => { s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };\n    51\t  }\n    52\t  const DAY = 864e5;\n    53\t  const START = Date.UTC(2026, 0, 1);\n    54\t  const trend = (() => {\n    55\t    const r = rng(7), n = 120;\n    56\t    const t = Array.from({ length: n }, (_, i) => START + i * DAY);\n    57\t    const mk = (base: number, growth: number, noise: number, season: number) => t.map((_, i) => Math.round(base + growth * i + season * Math.sin((i / 7) * 2 * Math.PI) + (r() - 0.5) * noise));\n    58\t    const series: { name: string; values: (number | null)[] }[] = [\n    59\t      { name: 'Direct', values: mk(31000, 120, 4000, 3000) },\n    60\t      { name: 'Organic search', values: mk(18000, 60, 3000, 2500) },\n    61\t      { name: 'Referral', values: mk(4200, -8, 1200, 400) },\n    62\t    ];\n    63\t    for (let i = 60; i < 67; i++) series[2]!.values[i] = null;\n    64\t    return { title: 'Daily sessions by channel', yTitle: 'Sessions', t, series };\n    65\t  })();\n    66\t  const days = trend.t.map(t => new Date(t).toISOString().slice(0, 10));\n    67\t  const dirty = { categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'], values: [10, 20, null, NaN, '40', undefined, 70] };\n    68\t  const fx = {\n    69\t    rng,\n    70\t    trend,\n    71\t    trendRows: () => trend.series.flatMap(s => s.values.map((v, i) => ({ day: trend.t[i], channel: s.name, sessions: v }))),\n    72\t    datesRows: () => trend.series.flatMap(s => s.values.map((v, i) => ({ day: days[i], channel: s.name, sessions: v }))),\n    73\t    bars: {\n    74\t      title: 'Customer satisfaction by team', yTitle: 'Satisfied (%)', name: 'Satisfied (%)',\n    75\t      categories: ['Billing', 'Customer Success & Onboarding', 'Platform', 'Mobile', 'Data', 'Security', 'Sales Eng.'],\n    76\t      values: [94, 88, 97, 82, 91, 85, 90],\n    77\t    },\n    78\t    parts: {\n    79\t      title: 'Sessions by browser', name: 'Share (%)',\n    80\t      labels: ['Chrome', 'Safari', 'Edge', 'Firefox', 'Samsung Internet', 'Other'],\n    81\t      values: [46.2, 27.5, 14.1, 8.9, 2.1, 1.2],\n    82\t    },\n    83\t    dirtyRows: () => dirty.categories.map((day, i) => (dirty.values[i] === undefined ? { day } : { day, value: dirty.values[i] })),\n    84\t    scale(n: number) {\n    85\t      const r = rng(1), t = new Array<number>(n), y = new Array<number>(n);\n    86\t      let v = 100;\n    87\t      for (let i = 0; i < n; i++) { v += (r() - 0.5) * 2; t[i] = START + i * 60000; y[i] = Math.round(v * 100) / 100; }\n    88\t      return { title: `${n.toLocaleString('en-US')} points`, t, y };\n    89\t    },\n    90\t  };\n    91\t  (window as unknown as { fx: unknown }).fx = fx;\n    92\t  (window as unknown as { charts: unknown[] }).charts = [];\n    93\t  (window as unknown as { nextFrames: (n?: number) => Promise<void> }).nextFrames = (n = 1) => new Promise(resolve => {\n    94\t    let left = n;\n    95\t    const step = () => { if (--left <= 0) resolve(); else requestAnimationFrame(step); };\n    96\t    requestAnimationFrame(step);\n    97\t  });\n    98\t}\n    99\t\n   100\texport async function chartPage(options: BrowserContextOptions & { query?: string; css?: string; standaloneCss?: boolean } = {}): Promise<Page> {\n   101\t  const { css, standaloneCss = true, ...rest } = options;\n   102\t  const page = await openPage(rest);\n   103\t  await page.evaluate(installFixtures);\n   104\t  // The test page links dist/axylo.css; without it the library applies the same sheet through ensureStyles.\n   105\t  if (!standaloneCss) await page.evaluate(() => document.querySelector('link[rel=\"stylesheet\"]')?.remove());\n   106\t  await page.addStyleTag({ content: `#before, #after { display: none; } ${css ?? ''}` });\n   107\t  return page;\n   108\t}\n   109\t\n   110\texport async function closePage(page: Page): Promise<string[]> {\n   111\t  const errors = (page as Page & { errors: string[] }).errors;\n   112\t  await page.context().close();\n   113\t  return errors;\n   114\t}\n   115\t\n   116\texport async function shot(page: Page, selector: string): Promise<{ img: Image; box: { x: number; y: number; width: number; height: number } }> {\n   117\t  const box = (await page.locator(selector).boundingBox())!;\n   118\t  const img = decodePng(await page.screenshot({ clip: box, animations: 'disabled', caret: 'hide' }));\n   119\t  return { img, box };\n   120\t}\n   121\t\n   122\texport type RGB = readonly [number, number, number];\n   123\t\n   124\texport function at(img: Image, x: number, y: number): RGB {\n   125\t  const o = (Math.floor(y) * img.width + Math.floor(x)) * 4;\n   126\t  return [img.data[o]!, img.data[o + 1]!, img.data[o + 2]!];\n   127\t}\n   128\t\n   129\texport const diff = (a: RGB, b: RGB): number => Math.max(Math.abs(a[0] - b[0]), Math.abs(a[1] - b[1]), Math.abs(a[2] - b[2]));\n   130\t\n   131\texport function hex(color: string): RGB {\n   132\t  const m = /^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(color);\n   133\t  if (!m) throw new Error(`not a hex color: ${color}`);\n   134\t  return [parseInt(m[1]!, 16), parseInt(m[2]!, 16), parseInt(m[3]!, 16)];\n   135\t}\n   136\t\n   137\t/** Pixels of `img` within `tolerance` of `color`. */\n   138\texport function count(img: Image, color: RGB, tolerance = 24, region?: { x0: number; y0: number; x1: number; y1: number }): number {\n   139\t  const { x0 = 0, y0 = 0, x1 = img.width, y1 = img.height } = region ?? {};\n   140\t  let n = 0;\n   141\t  for (let y = y0; y < y1; y++) for (let x = x0; x < x1; x++) if (diff(at(img, x, y), color) <= tolerance) n++;\n   142\t  return n;\n   143\t}\n   144\t\n   145\t/** Columns of `img` (within the rows given) that contain `color`. */\n   146\texport function columnsWith(img: Image, color: RGB, y0: number, y1: number, tolerance = 24): boolean[] {\n   147\t  const out: boolean[] = [];\n   148\t  for (let x = 0; x < img.width; x++) {\n   149\t    let hit = false;\n   150\t    for (let y = y0; y < y1 && !hit; y++) if (diff(at(img, x, y), color) <= tolerance) hit = true;\n   151\t    out.push(hit);\n   152\t  }\n   153\t  return out;\n   154\t}\n   155\t\n   156\t/** The accessibility tree of the chart target as Playwright's ARIA snapshot (YAML text). */\n   157\texport const aria = (page: Page, selector = '#chart'): Promise<string> => page.locator(selector).ariaSnapshot();\n","exit_code":0,"status":"completed"}}
