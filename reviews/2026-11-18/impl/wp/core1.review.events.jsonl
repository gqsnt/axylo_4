t type { ResolvedXField } from '../data';\nimport { Reports } from '../data/reports';\nimport { nameOf, XParser } from '../data/x';\nimport { report } from '../diagnostics';\nimport { diagnosticContext, type DiagnosticCode } from '../diagnostics/registry';\nimport type { Reference, XValue } from '../public';\n\nexport type Span<T = number> = readonly [T, T];\n\ninterface Option {\n  readonly field: string;\n  readonly sink: DiagnosticSink;\n  readonly axisPosition?: boolean;\n  readonly detail?: string;\n}\n\ntype PositionReader = (value: XValue, option?: Option) => number;\n\nexport function positionReader(\n  x: Pick<XColumn, 'kind' | 'categories' | 'timeZone'>,\n  field: ResolvedXField | undefined,\n): PositionReader {\n  if (x.kind === 'category') return (value, option) => {\n    const name = nameOf(value);\n    const index = name === null ? -1 : x.categories?.indexOf(name) ?? -1;\n    if (index >= 0) return index;\n    if (option) report(option.sink, 'AX107', 'none', {\n      field: option.field, detail: option.detail, outcome: 'The option is ignored.',\n    });\n    return NaN;\n  };\n  const resolved: ResolvedXField = field ?? {\n    field: 'x', label: 'x', unit: null, type: x.kind === 'wall' || x.kind === 'number' ? null : x.kind,\n    timeZone: x.timeZone ?? 'UTC', ordered: false, format: null, tickFormat: null, domain: null,\n  };\n  const parser = new XParser(resolved, x.kind, { timeZone: x.timeZone ?? 'UTC' });\n  return (value, option) => {\n    if (option?.axisPosition && x.kind !== 'number' && typeof value === 'number' && Number.isFinite(value)) return value;\n    const reports = new Reports(option?.field ?? resolved.field);\n    const position = parser.read(value, -1, reports);\n    // The parser's diagnostics still apply, but an option has no source row or omitted data values.\n    if (option) reports.flush({\n      add(diagnostic) {\n        const context = diagnosticContext(diagnostic);\n        report(option.sink, diagnostic.code as DiagnosticCode, 'none', {\n          ...context, field: diagnostic.field, count: diagnostic.count,\n          detail: diagnostic.effect === 'omitted' ? option.detail : context?.detail,\n          outcome: diagnostic.effect === 'omitted' ? 'The option is ignored.' : context?.outcome,\n        });\n      },\n    });\n    return position;\n  };\n}\n\nexport function readSpan(\n  input: Span<XValue> | null | undefined, read: PositionReader, field: string, sink: DiagnosticSink,\n  ordered = false,\n): Span | null {\n  if (!input) return null;\n  const option = { field, sink, axisPosition: true, detail: 'Supply two bounds in the x axis format.' };\n  const a = read(input[0], option);\n  const b = read(input[1], option);\n  if (!Number.isFinite(a) || !Number.isFinite(b) || ordered && a >= b) return null;\n  return [Math.min(a, b), Math.max(a, b)];\n}\n\nfunction isPair<T>(value: T | Span<T>): value is Span<T> {\n  return Array.isArray(value);\n}\n\nexport function resolveReferences(\n  input: readonly Reference[], readX: PositionReader, xKind: XKind, sink: DiagnosticSink,\n): ResolvedReference[] {\n  const references: ResolvedReference[] = [];\n  for (let i = 0; i < input.length; i++) {\n    const { x, y, label } = input[i]!;\n    const add = (axis: 'x' | 'y', from: number, to: number) => {\n      references.push({ axis, from: Math.min(from, to), to: Math.max(from, to), label });\n    };\n    if (x !== undefined) {\n      const pair = isPair(x);\n      const option = {\n        field: 'reference[' + i + '].x', sink,\n        detail: xKind === 'category' ? 'Use an existing category for each bound.' : 'Supply a reference in the x axis format.',\n      };\n      const from = readX(pair ? x[0] : x, option);\n      const to = pair ? readX(x[1], option) : from;\n      if (Number.isFinite(from) && Number.isFinite(to)) add('x', from, to);\n    }\n    if (y !== undefined) {\n      const pair = isPair(y);\n      const from = pair ? y[0] : y;\n      const to = pair ? y[1] : from;\n      if (Number.isFinite(from) && Number.isFinite(to)) {\n        add('y', from, to);\n      } else {\n        report(sink, 'AX103', 'none', { field: 'reference[' + i + '].y' });\n      }\n    }\n  }\n  return references;\n}\nimport type { DatumRef, Formatters, Lookup } from '../core/contracts';\nimport type { Messages } from '../public';\n\nconst chartSummary = '{type} chart with {seriesCount} series. {xLabel} from {xMin} to {xMax}.';\nconst fullChartSummary = chartSummary + ' {yLabel} from {yMin} to {yMax}.';\nconst donutSlice = '{label}: {value} ({percent}).';\n\nexport const defaultMessages: Messages = {\n  viewAsTable: 'View as table',\n  hideTable: 'Hide table',\n  noData: 'No data',\n  noObservation: 'No observation',\n  incompleteStack: 'incomplete',\n  moreRows: '+{count} more',\n  otherSlices: 'Other ({count})',\n  valuesNotShown: 'Values not shown: {count}. See table.',\n  valuesChanged: 'Values shown differently from the data: {count}. See table.',\n  labelsHidden: 'Some labels hidden. See table.',\n  loading: 'Loading chart.',\n  empty: 'No data to show.',\n  error: 'The chart could not be drawn.',\n  internalError: 'Something went wrong while drawing the chart.',\n  chartName: '{type} chart of {y} by {x}',\n  chartSummary: fullChartSummary,\n  seriesSummary: '{series}: minimum {min}, maximum {max}, last {last}.',\n  // Deprecated. Retained for callers with an existing override.\n  referenceSummary: 'Reference: {label}.',\n  timeZoneNote: 'Times are shown in {zone}.',\n  plotLabel: 'Chart plot',\n  controlsLabel: 'Chart controls',\n  pointOf: '{series}, {x}, {value}. Point {index} of {count}.',\n  zoomIn: 'Zoom in',\n  zoomOut: 'Zoom out',\n  resetZoom: 'Reset zoom',\n  pause: 'Pause',\n  resume: 'Resume',\n  previousPage: 'Previous page',\n  nextPage: 'Next page',\n  pageOf: 'Page {page} of {count}',\n  jumpToX: 'Jump to {x}',\n  showSeries: 'Show {series}',\n  hideSeries: 'Hide {series}',\n  category: 'Category',\n  percentage: 'Percentage',\n  series: 'Series',\n  value: 'Value',\n  typeLine: 'Line',\n  typeArea: 'Area',\n  typeBar: 'Bar',\n  typeScatter: 'Scatter',\n  typeDonut: 'Donut',\n  donutSummary: '{type} chart with {count} slices. Total {total}.',\n  seriesNoData: '{series}: no data.',\n  seriesNotDrawn: '{series} could not be drawn. See table.',\n  referenceLine: 'Reference line {label} at {from}.',\n  referenceBand: 'Reference band {label} from {from} to {to}.',\n};\n\nexport function fill(template: string, values: Readonly<Record<string, string | number>>): string {\n  return template.replace(/\\{(\\w+)\\}/g, (placeholder: string, name: string) =>\n    Object.hasOwn(values, name) ? String(values[name]) : placeholder,\n  );\n}\n\nexport function resolveMessages(overrides?: Partial<Messages> | null): Messages {\n  const messages = { ...defaultMessages };\n  for (const key of Object.keys(messages) as (keyof Messages)[]) {\n    messages[key] = overrides?.[key] ?? messages[key];\n  }\n  return messages;\n}\n\nexport function fillChartSummary(\n  template: string, values: Readonly<Record<string, string>>, range: { readonly yMin: string; readonly yMax: string } | null,\n): string {\n  if (range) return fill(template, { ...values, ...range });\n  // When a translation uses the same placeholders, omit the sentence that would describe the missing range.\n  const withoutRange = template === fullChartSummary ? chartSummary\n    : template.match(/[^.!?。！？]+[.!?。！？]*|[.!?。！？]+/gu)?.filter(part => !/\\{y(?:Min|Max)\\}/.test(part)).join('').trim();\n  return fill(withoutRange || chartSummary, values);\n}\n\nexport function fillDonutSlice(label: string, value: string, percent: string): string {\n  return fill(donutSlice, { label, value, percent });\n}\n\nexport function pointOf(lookup: Lookup, ref: DatumRef, formatters: Formatters, messages: Messages): string | null {\n  const ordinal = lookup.ordinal(ref);\n  if (ordinal < 0) return null;\n  const datum = lookup.datum(ref);\n  if (!datum) return null;\n  return fill(messages.pointOf, {\n    series: datum.seriesLabel, x: datum.x, value: datum.value,\n    index: formatters.count(ordinal + 1), count: formatters.count(lookup.count),\n  });\n}\n2:import { report } from '../diagnostics';\n15:  readonly labelledBy?: string;\n16:  /** Visible text of the external heading when the chart uses labelledBy. */\n20:  readonly disclosure?: { readonly omitted: number; readonly changed: number };\n26:  readonly diagnostics?: DiagnosticSink;\n126:  const { view, title, labelledBy, subtitle, description, formatters, messages, disclosure } = input;\n138:  if (!labelledBy && !titleText && input.diagnostics) report(input.diagnostics, 'AX140', 'none');\n140:  const name = labelledBy ? '' : titleText || generated;\n141:  const omitted = disclosure?.omitted ?? 0;\n142:  const changed = disclosure?.changed ?? 0;\n151:  const note = [omission, hidden > 0 ? fill(messages.labelsHidden, { count: formatters.count(hidden) }) : ''].filter(Boolean).join(' ') || null;\n155:  let summary: string | undefined;\n158:    name, note,\n159:    get summary() {\n161:      return summary ??= [...chartText(input, type, xLabel, yLabel), ...referencesForView(), subtitle, omission, description].filter(Boolean).join(' ');\n","exit_code":0,"status":"completed"}}
