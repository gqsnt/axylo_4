{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/{view,reader,format,theme,scene,messages,data,layout,lookup,render}/index.ts'","aggregated_output":"import {\n  SLOT_NO_ROW, SLOT_VALUE, type AlignedFrame, type AlignedView, type DiagnosticSink, type DonutFrame,\n  type DonutView, type Frame, type IndexRange, type MarkerShape, type PointFrame, type ResolvedReference,\n  type ScatterView, type SeriesCue, type StackView, type View,\n} from '../core/contracts';\nimport type { ResolvedXField } from '../data';\nimport { report } from '../diagnostics';\nimport type { Reference, ValueFieldOptions, XValue } from '../public';\nimport { valueDomain } from '../scale';\nimport { barExtent, barRange } from './bar-bands';\nimport { buildDonut } from './donut';\nimport { positionReader, readSpan, resolveReferences, type Span } from './references';\nimport { buildStack, reportStack } from './stack';\n\ninterface CartesianState {\n  readonly hidden?: ReadonlySet<string>;\n  readonly zoom?: Span<XValue> | null;\n  readonly xDomain?: Span<XValue> | null;\n  readonly valueDomain?: Span | null;\n  readonly valueScale?: ValueFieldOptions['scale'] | null;\n  /** Preserves the declared x type when parsing option values on an inferred axis. */\n  readonly xField?: ResolvedXField;\n  readonly valueField?: string;\n  readonly references?: readonly Reference[];\n}\n\nexport interface AlignedViewState extends CartesianState {\n  readonly kind: AlignedView['kind'];\n  readonly stacked?: boolean;\n  readonly horizontal?: boolean;\n  readonly compact?: boolean;\n  readonly previous?: View | null;\n}\n\nexport interface ScatterViewState extends CartesianState {\n  readonly kind: 'scatter';\n  readonly previous?: View | null;\n}\n\nexport interface DonutViewState {\n  readonly kind: 'donut';\n  readonly otherLabel: (count: number) => string;\n  readonly previous?: View | null;\n}\n\nexport type ViewState = AlignedViewState | ScatterViewState | DonutViewState;\n\nconst SHAPES: readonly MarkerShape[] = ['circle', 'square', 'triangle', 'diamond', 'cross', 'plus', 'triangle-down', 'star'];\nconst CONTRAST_DASHES: readonly SeriesCue['dash']['contrast'][] = [\n  null, [12, 5], [5, 4], [1, 5], [9, 4, 1, 4], [9, 4, 1, 4, 1, 4], [12, 4, 5, 4], [1, 2],\n];\nconst extrema = new WeakMap<AlignedView | ScatterView, Span>();\nconst widenedDomains = new WeakMap<AlignedView, string | undefined>();\n\nfunction reuse<T>(values: T[], previous: readonly T[] | undefined, same: (a: T, b: T) => boolean): readonly T[] {\n  if (!previous) return values;\n  let unchanged = previous.length === values.length;\n  for (let i = 0, end = Math.min(values.length, previous.length); i < end; i++) {\n    if (same(values[i]!, previous[i]!)) values[i] = previous[i]!;\n    else unchanged = false;\n  }\n  return unchanged ? previous : values;\n}\n\nfunction sameSpan(a: Span, b: Span): boolean {\n  return a[0] === b[0] && a[1] === b[1];\n}\n\nfunction sameRange(a: IndexRange, b: IndexRange): boolean {\n  return a.start === b.start && a.end === b.end;\n}\n\nfunction cues(count: number, compact: boolean, previous: AlignedView | ScatterView | undefined, sink: DiagnosticSink): readonly SeriesCue[] {\n  if (count > SHAPES.length && (previous?.cues.length ?? 0) <= SHAPES.length) report(sink, 'AX130', 'none');\n  if (compact && count > 1 && !(previous?.compact && previous.cues.length > 1)) report(sink, 'AX131', 'none');\n  const existing = previous?.compact === compact ? previous.cues : undefined;\n  if (existing?.length === count) return existing;\n  return Array.from({ length: count }, (_, i) => {\n    if (existing && i < existing.length) return existing[i]!;\n    const cycle = Math.floor(i / SHAPES.length);\n    const contrast = CONTRAST_DASHES[i % CONTRAST_DASHES.length]!;\n    return {\n      marker: SHAPES[(i + cycle) % SHAPES.length]!,\n      dash: { normal: cycle ? [2 + i, 3] : compact ? contrast : null, contrast },\n    };\n  });\n}\n\nfunction positionIndex(values: Float64Array, x: number, upper: boolean): number {\n  let start = 0;\n  let end = values.length;\n  while (start < end) {\n    const middle = start + Math.floor((end - start) / 2);\n    const value = values[middle]!;\n    if (value < x || upper && value === x) start = middle + 1;\n    else end = middle;\n  }\n  return start;\n}\n\nfunction rangeOf(values: Float64Array, domain: Span, previous?: IndexRange): IndexRange {\n  const range = { start: positionIndex(values, domain[0], false), end: positionIndex(values, domain[1], true) };\n  return previous && sameRange(range, previous) ? previous : range;\n}\n\nfunction nextObservation(slot: Uint8Array, from: number, end: number, direction: -1 | 1): number {\n  while (from !== end && slot[from] === SLOT_NO_ROW) from += direction;\n  return from;\n}\n\nfunction drawRange(slot: Uint8Array, range: IndexRange): IndexRange {\n  const { start, end } = range;\n  const first = nextObservation(slot, start, end, 1);\n  const last = first === end ? start - 1 : nextObservation(slot, end - 1, start - 1, -1);\n  let left = start;\n  let right = end;\n  if (first === end || slot[first] === SLOT_VALUE) {\n    const outside = nextObservation(slot, start - 1, -1, -1);\n    if (slot[outside] === SLOT_VALUE) left = outside;\n  }\n  if (first === end || slot[last] === SLOT_VALUE) {\n    const outside = nextObservation(slot, end, slot.length, 1);\n    if (slot[outside] === SLOT_VALUE) right = outside + 1;\n  }\n  // A view between observations can show their connecting segment, but only if both ends exist.\n  if (first === end && (left === start || right === end)) return range;\n  return left === start && right === end ? range : { start: left, end: right };\n}\n\nfunction interpolated(x: Float64Array, edge: number, left: number, right: number, a: number, b: number): number {\n  const start = x[left]!;\n  const end = x[right]!;\n  if (edge === start || a === b) return a;\n  if (edge === end) return b;\n  const width = end - start;\n  const t = Number.isFinite(width) ? (edge - start) / width : (edge / 2 - start / 2) / (end / 2 - start / 2);\n  const delta = b - a;\n  const value = Number.isFinite(delta) ? a + delta * t : a * (1 - t) + b * t;\n  return Math.max(Math.min(a, b), Math.min(value, Math.max(a, b)));\n}\n\nfunction alignedExtrema(\n  frame: AlignedFrame, visible: readonly boolean[], range: IndexRange, draws: readonly IndexRange[],\n  domain: Span, stack: StackView | null, kind: AlignedView['kind'],\n): Span {\n  let min = Infinity;\n  let max = -Infinity;\n  const x = frame.x.values;\n  const { start, end } = kind === 'bar' ? draws[0] ?? range : range;\n  const negative = stack?.negative.at(-1);\n  const positive = stack?.positive.at(-1);\n  if (negative && positive) {\n    for (let i = start; i < end; i++) {\n      min = Math.min(min, negative[i]!);\n      max = Math.max(max, positive[i]!);\n    }\n  }\n  const include = (value: number) => {\n    min = Math.min(min, value);\n    max = Math.max(max, value);\n  };\n  let reachesLeft = false;\n  let reachesRight = false;\n\n  for (let series = 0, k = 0; series < frame.series.length; series++) {\n    if (!visible[series]) continue;\n    const { y, slot } = frame.series[series]!;\n    if (!stack) {\n      for (let j = start; j < end; j++) {\n        if (slot[j] === SLOT_VALUE) include(y[j]!);\n      }\n    }\n    if (kind === 'bar') continue;\n\n    const draw = draws[series]!;\n    const below = stack?.negative[k];\n    const above = stack?.positive[k++];\n    const stroke = (index: number) => (y[index]! < 0 ? below : above)?.[index] ?? y[index]!;\n    if (draw.start < start) {\n      const right = nextObservation(slot, start, draw.end, 1);\n      include(interpolated(x, domain[0], draw.start, right, stroke(draw.start), stroke(right)));\n      reachesLeft = true;\n    }\n    if (draw.end > end) {\n      const left = nextObservation(slot, end - 1, draw.start - 1, -1);\n      const right = draw.end - 1;\n      include(interpolated(x, domain[1], left, right, stroke(left), stroke(right)));\n      reachesRight = true;\n    }\n  }\n  if (negative && positive) {\n    // Stacked fills use adjacent frame slots even when their component strokes join across NO_ROW.\n    if (reachesLeft) {\n      include(interpolated(x, domain[0], start - 1, start, negative[start - 1]!, negative[start]!));\n      include(interpolated(x, domain[0], start - 1, start, positive[start - 1]!, positive[start]!));\n    }\n    if (reachesRight) {\n      include(interpolated(x, domain[1], end - 1, end, negative[end - 1]!, negative[end]!));\n      include(interpolated(x, domain[1], end - 1, end, positive[end - 1]!, positive[end]!));\n    }\n  }\n  return [min, max];\n}\n\nfunction pointExtrema(frame: PointFrame, visible: readonly boolean[], ranges: readonly IndexRange[]): Span {\n  let min = Infinity;\n  let max = -Infinity;\n  for (let i = 0; i < frame.series.length; i++) {\n    if (!visible[i]) continue;\n    const { y } = frame.series[i]!;\n    const { start, end } = ranges[i]!;\n    for (let j = start; j < end; j++) {\n      min = Math.min(min, y[j]!);\n      max = Math.max(max, y[j]!);\n    }\n  }\n  return [min, max];\n}\n\nfunction scatterX(frame: PointFrame, sink: DiagnosticSink): Span {\n  let min = Infinity;\n  let max = -Infinity;\n  let count = 0;\n  for (const { x, drawable } of frame.series) {\n    if (!x.length) continue;\n    min = Math.min(min, x[0]!);\n    max = Math.max(max, x[x.length - 1]!);\n    if (drawable) count += x.length;\n  }\n  if (count > 50_000) report(sink, 'AX133', 'none');\n  return [min, max];\n}\n\nfunction fitZoom(full: Span, zoom: Span | null): Span {\n  if (!zoom) return full;\n  const [low, high] = full;\n  const [start, end] = zoom;\n  if (start >= low && end <= high) return zoom;\n  // Compare half-widths so even a window spanning the extremes of a numeric axis can be shifted.\n  const width = end - start;\n  const overflow = !Number.isFinite(width);\n  const halfWidth = end / 2 - start / 2;\n  if (overflow ? halfWidth >= high / 2 - low / 2 : width >= high - low) return full;\n  if (start < low) {\n    const shifted = overflow ? (low / 2 + halfWidth) * 2 : low + width;\n    return shifted > low ? [low, Math.min(high, shifted)] : full;\n  }\n  const shifted = overflow ? (high / 2 - halfWidth) * 2 : high - width;\n  return shifted < high ? [Math.max(low, shifted), high] : full;\n}\n\nfunction xExtents(\n  data: Span, category: boolean, readX: ReturnType<typeof positionReader>, references: readonly ResolvedReference[],\n  state: AlignedViewState | ScatterViewState, compact: boolean, sink: DiagnosticSink,\n): { xFull: Span; xDomain: Span } {\n  const authorInput = state.xDomain === undefined ? state.xField?.domain : state.xDomain;\n  const author = readSpan(authorInput, readX, 'x.domain', sink);\n  let [min, max] = data;\n  for (const reference of references) {\n    if (reference.axis !== 'x') continue;\n    min = Math.min(min, reference.from);\n    max = Math.max(max, reference.to);\n  }\n  const xFull: Span = author ?? (min <= max ? [min, max] : category ? [0, 0] : [0, 1]);\n  const zoom = compact || category && state.kind === 'bar' ? null : readSpan(state.zoom, readX, 'zoom', sink, true);\n  return { xFull, xDomain: fitZoom(xFull, zoom) };\n}\n\nfunction yExtent(\n  data: Span, references: readonly ResolvedReference[], state: AlignedViewState | ScatterViewState,\n  scale: CartesianState['valueScale'], sink: DiagnosticSink,\n): ReturnType<typeof valueDomain> {\n  const positions = references.flatMap(r => r.axis === 'y' ? [r.from, r.to] : []);\n  if (state.valueDomain && !state.valueDomain.every(Number.isFinite)) {\n    report(sink, 'AX103', 'none', { field: 'y.domain' });\n  }\n  return valueDomain({\n    min: data[0], max: data[1], includeZero: state.kind === 'bar' || state.kind === 'area',\n    authorDomain: state.valueDomain, valueScale: scale, references: positions,\n  });\n}\n\nfunction alignedScale(frame: AlignedFrame, visible: readonly boolean[]): CartesianState['valueScale'] {\n  const scale = frame.series.find((_, i) => visible[i])?.valueScale;\n  return frame.series.every((series, i) => !visible[i] || series.valueScale === scale) ? scale : null;\n}\n\nfunction keepSpan(span: Span, previous?: Span): Span {\n  return previous && sameSpan(span, previous) ? previous : span;\n}\n\nexport function buildView(frame: AlignedFrame, state: AlignedViewState, sink: DiagnosticSink): AlignedView;\nexport function buildView(frame: PointFrame, state: ScatterViewState, sink: DiagnosticSink): ScatterView;\nexport function buildView(frame: DonutFrame, state: DonutViewState, sink: DiagnosticSink): DonutView;\nexport function buildView(frame: Frame, state: ViewState, sink: DiagnosticSink): View;\nexport function buildView(frame: Frame, state: ViewState, sink: DiagnosticSink): View {\n  const previous = state.previous?.kind === state.kind ? state.previous : undefined;\n  if (frame.shape === 'donut' && state.kind === 'donut') {\n    return buildDonut(frame, state.otherLabel, previous?.kind === 'donut' ? previous : undefined, sink);\n  }\n  if (frame.shape === 'donut' || state.kind === 'donut' || (frame.shape === 'points') !== (state.kind === 'scatter')) {\n    throw new TypeError('The view kind must match the frame shape.');\n  }\n\n  const prior = previous?.kind !== 'donut' ? previous : undefined;\n  const sameFrame = prior?.frame === frame;\n  const compact = state.kind !== 'scatter' && (state.compact ?? false);\n  const visible = reuse(frame.series.map(series => series.drawable && !state.hidden?.has(series.key)), prior?.visible, (a, b) => a === b);\n  const seriesCues = cues(frame.series.length, compact, prior, sink);\n  const column = frame.shape === 'aligned' ? frame.x : { kind: frame.xKind, timeZone: frame.timeZone, categories: null };\n  const readX = positionReader(column, state.xField);\n  const references = reuse(resolveReferences(state.references ?? [], readX, column.kind, sink), prior?.references,\n    (a, b) => a.axis === b.axis && a.from === b.from && a.to === b.to && a.label === b.label);\n  const category = column.kind === 'category';\n  const continuousBars = state.kind === 'bar' && !category;\n  const xData: Span = frame.shape === 'aligned'\n    ? continuousBars ? barExtent(frame.x.values) : [frame.x.values[0] ?? Infinity, frame.x.values[frame.length - 1] ?? -Infinity]\n    : scatterX(frame, sink);\n  const spans = xExtents(xData, category, readX, references, state, compact, sink);\n  const xFull = keepSpan(spans.xFull, prior?.xFull);\n  const xDomain = sameSpan(xFull, spans.xDomain) ? xFull : keepSpan(spans.xDomain, prior?.xDomain);\n  const shared = { compact, visible, cues: seriesCues, references, revision: frame.revision, xFull, xDomain };\n  const sameShared = sameFrame && prior.compact === compact && prior.visible === visible &&\n    prior.cues === seriesCues && prior.references === references && prior.xFull === xFull && prior.xDomain === xDomain;\n  const oldExtrema = sameFrame && prior.visible === visible ? extrema.get(prior) : undefined;\n\n  if (frame.shape === 'points' && state.kind === 'scatter') {\n    const old = prior?.kind === 'scatter' ? prior : undefined;\n    const visiblePoints = sameFrame && old?.xDomain === xDomain ? old.visiblePoints : reuse(\n      frame.series.map(({ x }, i) => rangeOf(x, xDomain, old?.visiblePoints[i])), old?.visiblePoints, sameRange,\n    );\n    const data = oldExtrema && old?.visiblePoints === visiblePoints ? oldExtrema : pointExtrema(frame, visible, visiblePoints);\n    const yDomain = keepSpan(yExtent(data, references, state, state.valueScale, sink).domain, old?.yDomain);\n    if (sameShared && old?.visiblePoints === visiblePoints && old.yDomain === yDomain) return old;\n    const view: ScatterView = { ...shared, kind: 'scatter', frame, visiblePoints, yDomain };\n    extrema.set(view, data);\n    return view;\n  }\n\n  if (frame.shape !== 'aligned' || state.kind === 'scatter') throw new TypeError('Expected an aligned chart.');\n  const old = prior?.kind === state.kind ? prior : undefined;\n  const horizontal = state.kind === 'bar' && (state.horizontal ?? false);\n  const visibleSlots = sameFrame && old?.xDomain === xDomain ? old.visibleSlots : rangeOf(frame.x.values, xDomain, old?.visibleSlots);\n  const singlePosition = xDomain[0] === xDomain[1];\n  const sameDrawWindow = sameFrame && old !== undefined && (continuousBars ? old.xDomain === xDomain\n    : old.visibleSlots === visibleSlots && (old.xDomain[0] === old.xDomain[1]) === singlePosition);\n  const barSlots = continuousBars ? barRange(frame.x.values, visibleSlots, xDomain) : visibleSlots;\n  const drawSlots = sameDrawWindow ? old.drawSlots : reuse(\n    frame.series.map(({ slot }) => state.kind === 'bar' || category || singlePosition ? barSlots : drawRange(slot, visibleSlots)),\n    old?.drawSlots, sameRange,\n  );\n  const stack = state.stacked && state.kind !== 'line'\n    ? sameFrame && old?.visible === visible && old.stack ? old.stack : buildStack(frame, visible)\n    : null;\n  if (stack) reportStack(stack, sink);\n  const data = oldExtrema && old?.xDomain === xDomain && old.stack === stack\n    ? oldExtrema : alignedExtrema(frame, visible, visibleSlots, drawSlots, xDomain, stack, state.kind);\n  const scale = state.valueScale === undefined ? alignedScale(frame, visible) : state.valueScale;\n  const field = state.valueField ?? (frame.yLabel === null ? undefined : frame.series[0]?.field);\n  const { domain, widenedToZero } = yExtent(data, references, state, scale, sink);\n  const wasWidened = old !== undefined && widenedDomains.has(old);\n  const sameWidening = wasWidened === widenedToZero && (!wasWidened || widenedDomains.get(old!) === field);\n  if (widenedToZero && !sameWidening) report(sink, 'AX110', 'none', { field });\n  const yDomain = keepSpan(domain, old?.yDomain);\n  if (sameShared && old?.visibleSlots === visibleSlots && old.stack === stack &&\n    old.yDomain === yDomain && old.horizontal === horizontal && sameWidening) return old;\n  const view: AlignedView = { ...shared, kind: state.kind, frame, horizontal, visibleSlots, drawSlots, stack, yDomain };\n  extrema.set(view, data);\n  if (widenedToZero) widenedDomains.set(view, field);\n  return view;\n}\nimport { SLOT_VALUE, type DiagnosticSink, type Formatters, type IndexRange, type ReaderModel, type View } from '../core/contracts';\nimport { report } from '../diagnostics';\nimport { sliceText } from '../lookup/text';\nimport { defaultMessages, fill, fillChartSummary, fillDonutSlice } from '../messages';\nimport type { Messages, Title } from '../public';\nimport { buildTable, type ReaderLabels } from './table';\n\nexport interface ReaderInput {\n  readonly view: View;\n  readonly formatters: Formatters;\n  readonly messages: Messages;\n  /** Retained for callers that previously supplied the chart type label. */\n  readonly type: string;\n  readonly title?: string | Title;\n  readonly labelledBy?: string;\n  /** Visible text of the external heading when the chart uses labelledBy. */\n  readonly caption?: string;\n  readonly subtitle?: string;\n  readonly description?: string;\n  readonly disclosure?: { readonly omitted: number; readonly changed: number };\n  readonly labelsHidden?: number;\n  readonly table?: boolean;\n  readonly compact?: boolean;\n  readonly locale?: string;\n  readonly labels?: Partial<ReaderLabels>;\n  readonly diagnostics?: DiagnosticSink;\n}\n\nconst TYPE_MESSAGE = {\n  line: 'typeLine', area: 'typeArea', bar: 'typeBar', scatter: 'typeScatter', donut: 'typeDonut',\n} as const;\n\nfunction statistics(y: Float64Array | Float32Array, { start, end }: IndexRange, slot?: Uint8Array) {\n  let min = Infinity;\n  let max = -Infinity;\n  let last = NaN;\n  for (let i = start; i < end; i++) {\n    if (slot && slot[i] !== SLOT_VALUE) continue;\n    const value = y[i]!;\n    if (!Number.isFinite(value)) continue;\n    last = value;\n    if (last < min) min = last;\n    if (last > max) max = last;\n  }\n  return { min, max, last };\n}\n\nfunction chartText(input: ReaderInput, type: string, xLabel: string, yLabel: string): string[] {\n  const { view, formatters, messages } = input;\n  if (view.kind === 'donut') {\n    const drawn = view.slices.filter(slice => slice.angles && slice.angles[1] > slice.angles[0]);\n    if (!drawn.length) return [messages.empty];\n    return [\n      fill(messages.donutSummary, { type, count: formatters.count(drawn.length), total: formatters.value(0, view.total) }),\n      ...drawn.map(slice => {\n        const { label, value, percent } = sliceText(view, slice, formatters);\n        return fillDonutSlice(label, value, percent ?? '');\n      }),\n    ];\n  }\n\n  let xMin = Infinity;\n  let xMax = -Infinity;\n  let min = Infinity;\n  let max = -Infinity;\n  let minSeries = 0;\n  let maxSeries = 0;\n  let seriesCount = 0;\n  const entries: string[] = [];\n  const undrawn: string[] = [];\n  const { frame } = view;\n  const zone = view.kind === 'scatter'\n    ? view.frame.xKind === 'time' && view.frame.timeZone\n    : view.frame.x.kind === 'time' && view.frame.x.timeZone;\n\n  if (view.kind !== 'scatter') {\n    const { start, end } = view.visibleSlots;\n    if (start < end) {\n      xMin = view.frame.x.values[start]!;\n      xMax = view.frame.x.values[end - 1]!;\n    }\n  }\n  frame.series.forEach((series, s) => {\n    if (!series.drawable) {\n      undrawn.push(fill(messages.seriesNotDrawn, { series: series.label }));\n      return;\n    }\n    if (!view.visible[s]) return;\n    const range = view.kind === 'scatter' ? view.visiblePoints[s]! : view.visibleSlots;\n    if (range.start < range.end && 'x' in series) {\n      xMin = Math.min(xMin, series.x[range.start]!);\n      xMax = Math.max(xMax, series.x[range.end - 1]!);\n    }\n    const stats = statistics(series.y, range, 'slot' in series ? series.slot : undefined);\n    if (stats.min < min) { min = stats.min; minSeries = s; }\n    if (stats.max > max) { max = stats.max; maxSeries = s; }\n    seriesCount++;\n    entries.push(Number.isFinite(stats.last) ? fill(messages.seriesSummary, {\n      series: series.label, min: formatters.value(s, stats.min),\n      max: formatters.value(s, stats.max), last: formatters.value(s, stats.last),\n    }) : fill(messages.seriesNoData, { series: series.label }));\n  });\n\n  const zoneText = zone ? [fill(messages.timeZoneNote, { zone })] : [];\n  if (!seriesCount || !Number.isFinite(xMin) || !Number.isFinite(xMax)) return [...undrawn, messages.empty, ...zoneText];\n  const range = Number.isFinite(min) && Number.isFinite(max)\n    ? { yMin: formatters.value(minSeries, min), yMax: formatters.value(maxSeries, max) } : null;\n  return [\n    fillChartSummary(messages.chartSummary, {\n      type, seriesCount: formatters.count(seriesCount), xLabel, xMin: formatters.x(xMin), xMax: formatters.x(xMax), yLabel,\n    }, range),\n    ...zoneText, ...entries, ...undrawn,\n  ];\n}\n\nfunction referenceText(view: View, formatters: Formatters, messages: Messages): string[] {\n  if (view.kind === 'donut') return [];\n  return view.references.map(({ axis, from, to, label }) => {\n    const write = axis === 'x' ? (x: number) => formatters.x(x) : (y: number) => formatters.value(0, y);\n    const values = { label, axis, from: write(from) };\n    return from === to ? fill(messages.referenceLine, values) : fill(messages.referenceBand, { ...values, to: write(to) });\n  });\n}\n\nexport function buildReader(input: ReaderInput): ReaderModel {\n  const { view, title, labelledBy, subtitle, description, formatters, messages, disclosure } = input;\n  const labels = {\n    category: input.labels?.category ?? messages.category,\n    percentage: input.labels?.percentage ?? messages.percentage,\n    series: input.labels?.series ?? messages.series,\n    value: input.labels?.value ?? messages.value,\n  };\n  const type = messages[TYPE_MESSAGE[view.kind]];\n  const xLabel = view.kind === 'donut' ? labels.category : view.frame.xLabel;\n  const yLabel = view.kind === 'donut' ? view.frame.valueLabel\n    : view.kind === 'scatter' ? view.frame.yLabel : view.frame.yLabel || view.frame.series[0]?.field || labels.value;\n  const titleText = typeof title === 'string' ? title : title?.text;\n  if (!labelledBy && !titleText && input.diagnostics) report(input.diagnostics, 'AX140', 'none');\n  const generated = fill(messages.chartName, { type, x: xLabel, y: yLabel });\n  const name = labelledBy ? '' : titleText || generated;\n  const omitted = disclosure?.omitted ?? 0;\n  const changed = disclosure?.changed ?? 0;\n  const statements: string[] = [];\n  if (omitted > 0 || changed > 0) {\n    const counts = { omitted: formatters.count(omitted), changed: formatters.count(changed) };\n    if (omitted > 0) statements.push(fill(messages.valuesNotShown, { ...counts, count: counts.omitted }));\n    if (changed > 0) statements.push(fill(messages.valuesChanged, { ...counts, count: counts.changed }));\n  }\n  const omission = statements.join(' ');\n  const hidden = input.labelsHidden ?? 0;\n  const note = [omission, hidden > 0 ? fill(messages.labelsHidden, { count: formatters.count(hidden) }) : ''].filter(Boolean).join(' ') || null;\n  const compact = input.compact === true || (view.kind !== 'donut' && view.compact);\n  let references: string[] | undefined;\n  const referencesForView = () => references ??= referenceText(view, formatters, messages);\n  let summary: string | undefined;\n  const caption = [input.caption, name, generated, messages.plotLabel].find(text => text?.trim()) ?? defaultMessages.plotLabel;\n  return {\n    name, note,\n    get summary() {\n      // Opening the table should not scan the rest of the frame.\n      return summary ??= [...chartText(input, type, xLabel, yLabel), ...referencesForView(), subtitle, omission, description].filter(Boolean).join(' ');\n    },\n    table: input.table === false || compact ? null : buildTable(\n      view, [caption, ...referencesForView()].join(' '), formatters, messages, labels, input.locale,\n    ),\n  };\n}\n/**\n * The Formatters of a chart: how readers see values, x positions and missing slots in tooltip, table and\n * announcements (spec F2, F4, F6).\n */\nimport type { Environment, Formatters, SlotState, XKind } from '../core/contracts';\nimport { SLOT_NO_ROW, SLOT_VALUE } from '../core/contracts';\nimport { createNumberReadout, defaultReadoutNumber, type NumberFormatOption, type ValueScale } from './number';\nimport { createTimeReadout, type DateFormatOption } from './time';\n\nexport { createNumberReadout, createNumberTickLabeler, defaultReadoutNumber, defaultTickNumber, readoutFractionDigits } from './number';\nexport type { NumberFormatOption, NumberReadoutSpec, NumberTickSpec, ValueScale } from './number';\nexport { createTimeReadout, createTimeTickLabel, defaultTimeReadout } from './time';\nexport type { DateFormatOption, TemporalKind, TimeReadoutSpec } from './time';\n\n/** Formatting inputs of one value series. Built from the series and its field options. */\nexport interface SeriesFormatSpec {\n  /** Field name, passed to `onFormatterError`. */\n  readonly field: string;\n  readonly unit: string | null;\n  readonly scale: ValueScale;\n  /** The field's `format` option. */\n  readonly format?: NumberFormatOption | null;\n}\n\n/** Formatting inputs of the x axis. Built from the frame's x column and the x field options. */\nexport interface XFormatSpec {\n  readonly field: string;\n  readonly kind: XKind;\n  readonly unit: string | null;\n  /** For 'time': the zone; 'local' or null means the viewer's (Environment.timeZone). */\n  readonly timeZone: string | null;\n  readonly dateUnit: 'day' | 'month' | 'year' | null;\n  /** For 'category': the name of each position. */\n  readonly categories: readonly string[] | null;\n  /** The field's `format` option. Number options apply to 'number', date-time options to the temporal kinds. */\n  readonly format?: DateFormatOption | null;\n}\n\nexport interface FormatSpec {\n  readonly series: readonly SeriesFormatSpec[];\n  readonly x: XFormatSpec;\n  /** The chart's `locale` option; Environment.locale when absent. */\n  readonly locale?: string | null;\n  readonly messages: { readonly noData: string; readonly noObservation: string };\n  /** Called once per field and formatter when an author formatter throws (the caller raises AX160 for that field). */\n  readonly onFormatterError?: ((field: string, error: unknown) => void) | null;\n}\n\nexport function createFormatters(spec: FormatSpec, env: Pick<Environment, 'locale' | 'timeZone'>): Formatters {\n  const locale = spec.locale || env.locale;\n  const report = spec.onFormatterError;\n  const reporter = (field: string) => (report ? (error: unknown) => report(field, error) : null);\n\n  const values = spec.series.map(s =>\n    createNumberReadout({ locale, scale: s.scale, unit: s.unit, format: s.format ?? null, onError: reporter(s.field) }),\n  );\n  const x = createXReadout(spec.x, locale, env.timeZone, reporter(spec.x.field));\n  const { noData, noObservation } = spec.messages;\n\n  return {\n    value(seriesIndex: number, v: number): string {\n      const f = values[seriesIndex];\n      return f ? f(v) : defaultReadoutNumber(v, locale);\n    },\n    x,\n    percent(ratio: number): string {\n      return defaultReadoutNumber(ratio, locale, 'ratio');\n    },\n    count(n: number): string {\n      return defaultReadoutNumber(n, locale, null);\n    },\n    missing(state: SlotState): string {\n      if (state === SLOT_VALUE) return '';\n      // No row at this x for this series is \"No observation\"; every other non-value (null, invalid, gap,\n      // absent field) is \"No data\" (spec F2, I1).\n      return state === SLOT_NO_ROW ? noObservation : noData;\n    },\n  };\n}\n\nfunction createXReadout(\n  x: XFormatSpec,\n  locale: string,\n  viewerZone: string,\n  onError: ((error: unknown) => void) | null,\n): (position: number) => string {\n  switch (x.kind) {\n    case 'category': {\n      const names = x.categories ?? [];\n      const format = x.format;\n      const name = (position: number): string => names[position] ?? String(position);\n      // Intl options have no meaning for a name; only an author function changes it.\n      if (typeof format !== 'function') return name;\n      let reported = false;\n      return (position: number) => {\n        try {\n          return String(format(name(position)));\n        } catch (error) {\n          if (!reported && onError) onError(error);\n          reported = true;\n          return name(position);\n        }\n      };\n    }\n    case 'number': {\n      const format = x.format;\n      // Date-time options make no sense for a number; only a function or number options are used.\n      const numberOption: NumberFormatOption | null =\n        typeof format === 'function' ? (v: number) => format(v) : format != null && !isDateOptions(format) ? (format as Intl.NumberFormatOptions) : null;\n      return createNumberReadout({ locale, scale: null, unit: x.unit, format: numberOption, onError });\n    }\n    default: {\n      const timeZone = x.kind === 'time' ? (x.timeZone == null || x.timeZone === 'local' ? viewerZone : x.timeZone) : null;\n      return createTimeReadout({ kind: x.kind, timeZone, locale, dateUnit: x.dateUnit, format: x.format ?? null, onError });\n    }\n  }\n}\n\nconst DATE_KEYS = ['dateStyle', 'timeStyle', 'year', 'month', 'day', 'weekday', 'hour', 'minute', 'second', 'era', 'timeZoneName', 'hour12', 'hourCycle', 'dayPeriod', 'fractionalSecondDigits'];\n\nfunction isDateOptions(o: object): boolean {\n  return DATE_KEYS.some(k => k in o);\n}\nexport { AXYLO_CSS } from './css';\nexport { ensureStyles } from './styles';\nexport { resolveTheme, seriesBinding, TOKEN_BINDINGS, type ThemeResolution } from './resolve';\nexport { watchTheme } from './watch';\nexport { composite, contrastRatio, isLightColor, lowContrastSeries, parseColor, relativeLuminance, type Rgba } from './color';\nexport { DARK, LIGHT, SERIES_COUNT, type SchemeColors } from './palette';\nimport type {\n  AreaMark, BandMark, DonutView, Layout, Mark, Paint, PathMark, PointMark, Projection, Rect, RuleMark, Scene, View,\n} from '../core/contracts';\nimport { addArea, addStackedAreas } from './areas';\nimport { barMarks } from './bars';\nimport { clamp, position, rule, seriesPaint, token } from './geometry';\nimport { addLine, drawing, scatterPoints } from './lines';\n\ntype Plot = Extract<Layout, { kind: 'plot' }>;\ntype Cartesian = Exclude<Projection, { kind: 'ring' }>;\n\nconst TICK_LENGTH = 4;\n\nfunction axes(projection: Cartesian) {\n  return projection.kind === 'bands'\n    ? { x: projection.band, y: projection.value, horizontal: projection.horizontal }\n    : { x: projection.x, y: projection.y, horizontal: false };\n}\n\nfunction gridAndAxes(layout: Plot, projection: Cartesian): { grid: RuleMark[]; edges: RuleMark[] } {\n  const { x, y, horizontal } = axes(projection);\n  const { x: left, y: top, width, height } = layout.plot;\n  const right = left + width;\n  const bottom = top + height;\n  const axis = token('axis');\n  const gridPaint = token('grid');\n  const grid: RuleMark[] = [];\n  const edges = [rule('axis', axis, left, bottom, right, bottom), rule('axis', axis, left, top, left, bottom)];\n  const bottomScale = horizontal ? y : x;\n  const leftScale = horizontal ? x : y;\n  for (const tick of horizontal ? layout.yTicks : layout.xTicks) {\n    const pixel = position(bottomScale, tick.value);\n    if (pixel < left || pixel > right) continue;\n    edges.push(rule('tick', axis, pixel, bottom, pixel, bottom + TICK_LENGTH));\n  }\n  for (const tick of horizontal ? layout.xTicks : layout.yTicks) {\n    const pixel = position(leftScale, tick.value);\n    if (pixel < top || pixel > bottom) continue;\n    edges.push(rule('tick', axis, left - TICK_LENGTH, pixel, left, pixel));\n  }\n  for (const tick of layout.yTicks) {\n    const pixel = position(y, tick.value);\n    if (horizontal && pixel >= left && pixel <= right) grid.push(rule('grid', gridPaint, pixel, top, pixel, bottom));\n    if (!horizontal && pixel >= top && pixel <= bottom) grid.push(rule('grid', gridPaint, left, pixel, right, pixel));\n  }\n  return { grid, edges };\n}\n\nfunction references(view: Exclude<View, DonutView>, projection: Cartesian, plot: Rect): {\n  bands: BandMark[]; lines: RuleMark[];\n} {\n  const { x, y, horizontal } = axes(projection);\n  const bands: BandMark[] = [];\n  const lines: RuleMark[] = [];\n  const paint = token('reference');\n  for (const { axis, from, to } of view.references) {\n    const scale = axis === 'x' ? x : y;\n    const across = (axis === 'x') !== horizontal;\n    const start = across ? plot.x : plot.y;\n    const end = start + (across ? plot.width : plot.height);\n    const xReference = axis === 'x';\n    const [first, last] = view.xDomain;\n    if (xReference && (to < first || from > last)) continue;\n    const a = position(scale, xReference ? Math.max(from, first) : from);\n    const b = position(scale, xReference ? Math.min(to, last) : to);\n    if (from === to) {\n      if (a < start || a > end) continue;\n      lines.push(across ? rule('reference', paint, a, plot.y, a, plot.y + plot.height)\n        : rule('reference', paint, plot.x, a, plot.x + plot.width, a));\n    } else {\n      const low = clamp(Math.min(a, b), start, end);\n      const high = clamp(Math.max(a, b), start, end);\n      if (low === high) continue;\n      const box = across ? { ...plot, x: low, width: high - low } : { ...plot, y: low, height: high - low };\n      bands.push({ type: 'band', box, fill: paint, opacity: 0.12 });\n    }\n  }\n  return { bands, lines };\n}\n\nfunction arcMarks(view: DonutView, projection: Extract<Projection, { kind: 'ring' }>): Mark[] {\n  const angles: number[] = [];\n  const fills: Paint[] = [];\n  for (const slice of view.slices) {\n    if (slice.angles === null) continue;\n    angles.push(...slice.angles);\n    fills.push(slice.colorIndex === null ? token('muted') : seriesPaint(slice.colorIndex));\n  }\n  if (!angles.length) return [];\n  const { cx, cy, r0, r1 } = projection;\n  return [{ type: 'arcs', cx, cy, r0, r1, angles: Float32Array.from(angles), fills, gap: 1 }];\n}\n\nexport function buildScene(view: View, layout: Layout, devicePixelRatio: number): Scene {\n  const { width, height } = layout;\n  if (layout.kind !== 'plot' && layout.kind !== 'compact') {\n    return { width, height, clip: { x: 0, y: 0, width, height }, marks: [] };\n  }\n  const { plot: clip, projection } = layout;\n  if (projection.kind === 'ring' || view.kind === 'donut') {\n    const marks = projection.kind === 'ring' && view.kind === 'donut' ? arcMarks(view, projection) : [];\n    return { width, height, clip, marks };\n  }\n\n  const compact = layout.kind === 'compact' || view.compact;\n  const { grid, edges } = layout.kind === 'plot' && !compact ? gridAndAxes(layout, projection) : { grid: [], edges: [] };\n  const { bands, lines } = compact ? { bands: [], lines: [] } : references(view, projection, clip);\n  const layers: (readonly Mark[])[] = [bands, grid];\n  if (view.kind === 'bar' && projection.kind === 'bands') {\n    layers.push(barMarks(view, projection, clip));\n  } else if (view.kind === 'scatter' && projection.kind === 'xy') {\n    layers.push(scatterPoints(view, projection));\n  } else if ((view.kind === 'line' || view.kind === 'area') && projection.kind === 'xy') {\n    const areas: AreaMark[] = [];\n    const seams: PathMark[] = [];\n    const paths: PathMark[] = [];\n    const points: PointMark[] = [];\n    const dpr = Number.isFinite(devicePixelRatio) && devicePixelRatio > 0 ? devicePixelRatio : 1;\n    const draw = drawing(view.frame.x.values, projection, clip, dpr);\n    if (view.kind === 'area' && view.stack) {\n      addStackedAreas(draw, view, view.stack, compact, areas, seams, paths, points);\n    } else {\n      for (let i = 0; i < view.frame.series.length; i++) {\n        if (!view.visible[i]) continue;\n        const { slot, y } = view.frame.series[i]!;\n        const input = { ...draw, range: view.drawSlots[i]!, slot, y };\n        if (view.kind === 'area') addArea(input, view, i, compact, areas, paths, points);\n        else addLine(input, view, i, view.visibleSlots, compact, paths, points);\n      }\n    }\n    layers.push(areas, seams, paths, points);\n  }\n  layers.push(edges, lines);\n  return { width, height, clip, marks: layers.flat() };\n}\nimport type { DatumRef, Formatters, Lookup } from '../core/contracts';\nimport type { Messages } from '../public';\n\nconst chartSummary = '{type} chart with {seriesCount} series. {xLabel} from {xMin} to {xMax}.';\nconst fullChartSummary = chartSummary + ' {yLabel} from {yMin} to {yMax}.';\nconst donutSlice = '{label}: {value} ({percent}).';\n\nexport const defaultMessages: Messages = {\n  viewAsTable: 'View as table',\n  hideTable: 'Hide table',\n  noData: 'No data',\n  noObservation: 'No observation',\n  incompleteStack: 'incomplete',\n  moreRows: '+{count} more',\n  otherSlices: 'Other ({count})',\n  valuesNotShown: 'Values not shown: {count}. See table.',\n  valuesChanged: 'Values shown differently from the data: {count}. See table.',\n  labelsHidden: 'Some labels hidden. See table.',\n  loading: 'Loading chart.',\n  empty: 'No data to show.',\n  error: 'The chart could not be drawn.',\n  internalError: 'Something went wrong while drawing the chart.',\n  chartName: '{type} chart of {y} by {x}',\n  chartSummary: fullChartSummary,\n  seriesSummary: '{series}: minimum {min}, maximum {max}, last {last}.',\n  // Deprecated. Retained for callers with an existing override.\n  referenceSummary: 'Reference: {label}.',\n  timeZoneNote: 'Times are shown in {zone}.',\n  plotLabel: 'Chart plot',\n  controlsLabel: 'Chart controls',\n  pointOf: '{series}, {x}, {value}. Point {index} of {count}.',\n  zoomIn: 'Zoom in',\n  zoomOut: 'Zoom out',\n  resetZoom: 'Reset zoom',\n  pause: 'Pause',\n  resume: 'Resume',\n  previousPage: 'Previous page',\n  nextPage: 'Next page',\n  pageOf: 'Page {page} of {count}',\n  jumpToX: 'Jump to {x}',\n  showSeries: 'Show {series}',\n  hideSeries: 'Hide {series}',\n  category: 'Category',\n  percentage: 'Percentage',\n  series: 'Series',\n  value: 'Value',\n  typeLine: 'Line',\n  typeArea: 'Area',\n  typeBar: 'Bar',\n  typeScatter: 'Scatter',\n  typeDonut: 'Donut',\n  donutSummary: '{type} chart with {count} slices. Total {total}.',\n  seriesNoData: '{series}: no data.',\n  seriesNotDrawn: '{series} could not be drawn. See table.',\n  referenceLine: 'Reference line {label} at {from}.',\n  referenceBand: 'Reference band {label} from {from} to {to}.',\n};\n\nexport function fill(template: string, values: Readonly<Record<string, string | number>>): string {\n  return template.replace(/\\{(\\w+)\\}/g, (placeholder: string, name: string) =>\n    Object.hasOwn(values, name) ? String(values[name]) : placeholder,\n  );\n}\n\nexport function resolveMessages(overrides?: Partial<Messages> | null): Messages {\n  const messages = { ...defaultMessages };\n  for (const key of Object.keys(messages) as (keyof Messages)[]) {\n    messages[key] = overrides?.[key] ?? messages[key];\n  }\n  return messages;\n}\n\nexport function fillChartSummary(\n  template: string, values: Readonly<Record<string, string>>, range: { readonly yMin: string; readonly yMax: string } | null,\n): string {\n  if (range) return fill(template, { ...values, ...range });\n  // When a translation uses the same placeholders, omit the sentence that would describe the missing range.\n  const withoutRange = template === fullChartSummary ? chartSummary\n    : template.match(/[^.!?。！？]+[.!?。！？]*|[.!?。！？]+/gu)?.filter(part => !/\\{y(?:Min|Max)\\}/.test(part)).join('').trim();\n  return fill(withoutRange || chartSummary, values);\n}\n\nexport function fillDonutSlice(label: string, value: string, percent: string): string {\n  return fill(donutSlice, { label, value, percent });\n}\n\nexport function pointOf(lookup: Lookup, ref: DatumRef, formatters: Formatters, messages: Messages): string | null {\n  const ordinal = lookup.ordinal(ref);\n  if (ordinal < 0) return null;\n  const datum = lookup.datum(ref);\n  if (!datum) return null;\n  return fill(messages.pointOf, {\n    series: datum.seriesLabel, x: datum.x, value: datum.value,\n    index: formatters.count(ordinal + 1), count: formatters.count(lookup.count),\n  });\n}\nexport { normalize } from './normalize';\nexport type { DataEnvironment, FrameVersion } from './normalize';\nexport { resolveOptions } from './options';\nexport type { AlignedChartType, ChartType, ResolvedOptions, ResolvedValueField, ResolvedXField } from './options';\nexport { AlignedStore } from './store';\nexport { validateOptions } from './validate';\nimport type {\n  BandScale, ContinuousScale, DiagnosticSink, Layout, PlacedText, Projection, Rect,\n  TextMeasurer, TextStyle, TickCandidates, XScale,\n} from '../core/contracts';\nimport { fitBottom, fitLeftCategories, fitValue, messageLines, placeText, prepareLabels, wrapText } from './labels';\nimport type { FittedLabels, Metrics } from './labels';\n\ntype Span = readonly [number, number];\n\ninterface Axis {\n  readonly candidates: TickCandidates;\n  readonly title?: string;\n  readonly mayThin: boolean;\n}\n\nexport interface ValueAxis extends Axis {\n  readonly domain: Span;\n}\n\nexport interface ContinuousAxis extends ValueAxis {\n  readonly type: 'linear' | 'time';\n}\n\nexport interface BandAxis extends Axis {\n  readonly type: 'band';\n  readonly count: number;\n  readonly padding: number;\n}\n\nexport interface ScaleConstructors {\n  linear(domain: Span, range: Span): ContinuousScale;\n  time(domain: Span, range: Span): ContinuousScale;\n  band(count: number, range: Span, padding: number): BandScale;\n}\n\ninterface Size {\n  readonly width: number;\n  readonly height: number;\n}\n\ninterface Axes {\n  /** Logical category or independent axis, including for horizontal bars. */\n  readonly x: ContinuousAxis | BandAxis;\n  readonly y: ValueAxis;\n  readonly scales: ScaleConstructors;\n}\n\ntype Cartesian = Axes & (\n  | { readonly kind: 'xy' }\n  | { readonly kind: 'bands'; readonly horizontal: boolean }\n);\n\ninterface TextInput {\n  readonly measurer: TextMeasurer;\n  readonly style: TextStyle;\n}\n\ntype PlotInput = Size & {\n  /** Ignored. Presentation derives AX142 and AX143 from the returned layout. */\n  readonly diagnostics?: DiagnosticSink;\n  readonly compact?: boolean;\n};\n\nexport type LayoutInput =\n  | (PlotInput & Cartesian & TextInput)\n  | (PlotInput & { readonly kind: 'ring' })\n  | (Size & TextInput & { readonly kind: 'message'; readonly message: string });\n\nconst INSET = 4;\nconst GAP = 4;\nconst MIN_WIDTH = 120;\nconst MIN_HEIGHT = 80;\nconst UNCHANGED = { remedies: [], hidden: 0 } as const;\n\nfunction independentScale(axis: Axes['x'], range: Span, scales: ScaleConstructors): XScale {\n  return axis.type === 'band' ? scales.band(axis.count, range, axis.padding) : scales[axis.type](axis.domain, range);\n}\n\nfunction project(plot: Rect, axes: Cartesian): Exclude<Projection, { kind: 'ring' }> {\n  const across: Span = [plot.x, plot.x + plot.width];\n  const up: Span = [plot.y + plot.height, plot.y];\n  const horizontal = axes.kind === 'bands' && axes.horizontal;\n  const x = independentScale(axes.x, horizontal ? up : across, axes.scales);\n  const y = axes.scales.linear(axes.y.domain, horizontal ? across : up);\n  return axes.kind === 'xy' ? { kind: 'xy', x, y } : { kind: 'bands', horizontal, band: x, value: y };\n}\n\nfunction ring(plot: Rect): Projection {\n  const r1 = Math.min(plot.width, plot.height) / 2;\n  return { kind: 'ring', cx: plot.x + plot.width / 2, cy: plot.y + plot.height / 2, r0: r1 * 0.6, r1 };\n}\n\nfunction tooSmall(size: Size): Layout {\n  return { ...size, kind: 'too-small' };\n}\n\nfunction metrics(input: TextInput): Metrics {\n  const widths = new Map<string, number>();\n  return {\n    lineHeight: input.style.lineHeight,\n    width(text) {\n      const cached = widths.get(text);\n      if (cached !== undefined) return cached;\n      const width = input.measurer.width(text, input.style);\n      widths.set(text, width);\n      return width;\n    },\n  };\n}\n\nfunction moveText(text: PlacedText, dx: number, dy: number): PlacedText {\n  return { ...text, x: text.x + dx, y: text.y + dy, box: { ...text.box, x: text.box.x + dx, y: text.box.y + dy } };\n}\n\nfunction lane(fit: FittedLabels): number {\n  return fit.texts.length ? GAP + fit.depth : 0;\n}\n\nfunction hiddenTicks(candidates: TickCandidates): FittedLabels {\n  return { ticks: [], texts: [], depth: 0, fit: { remedies: [], hidden: candidates[0]?.length ?? 0 } };\n}\n\nfunction layoutAxes(input: PlotInput & Cartesian & TextInput, size: Size, text: Metrics, showTicks: boolean): Layout {\n  const { width, height } = size;\n  const horizontal = input.kind === 'bands' && input.horizontal;\n  const leftAxis = horizontal ? input.x : input.y;\n  const bottomAxis = horizontal ? input.y : input.x;\n  const leftCandidates = horizontal ? leftAxis.candidates.slice(0, 1) : leftAxis.candidates;\n  const bottomCandidates = !horizontal && !bottomAxis.mayThin ? bottomAxis.candidates.slice(0, 1) : bottomAxis.candidates;\n  const leftLabels = showTicks ? prepareLabels(leftCandidates) : undefined;\n  const bottomLabels = showTicks ? prepareLabels(bottomCandidates) : undefined;\n  const leftRole = horizontal ? 'tick-x' : 'tick-y';\n  const bottomRole = horizontal ? 'tick-y' : 'tick-x';\n  const clearance = leftLabels?.sets.some(set => set.ticks.length > 0) ? text.lineHeight / 2 : 0;\n  const top = INSET + clearance;\n  let left = INSET;\n  let bottom = INSET + clearance;\n  const visited = new Set<string>();\n  let growMargins = false;\n\n  for (;;) {\n    const plot = { x: left, y: top, width: width - left - INSET, height: height - top - bottom };\n    if (plot.width < MIN_WIDTH - 1e-7 || plot.height < MIN_HEIGHT - 1e-7) return tooSmall(size);\n\n    const projection = project(plot, input);\n    const xScale = projection.kind === 'xy' ? projection.x : projection.band;\n    const yScale = projection.kind === 'xy' ? projection.y : projection.value;\n    const leftTitle = leftAxis.title ? wrapText(leftAxis.title, plot.height, text) : [];\n    const bottomTitle = bottomAxis.title ? wrapText(bottomAxis.title, plot.width, text) : [];\n    if (leftTitle.some(line => text.width(line) > plot.height) ||\n        bottomTitle.some(line => text.width(line) > plot.width)) return tooSmall(size);\n    const leftTitleSize = leftTitle.length ? GAP + leftTitle.length * text.lineHeight : 0;\n    const bottomTitleSize = bottomTitle.length ? GAP + bottomTitle.length * text.lineHeight : 0;\n    const leftRoom = width - 2 * INSET - MIN_WIDTH - leftTitleSize - GAP;\n    const bottomRoom = height - top - MIN_HEIGHT - INSET - clearance - bottomTitleSize - GAP;\n\n    const leftFit = !leftLabels ? hiddenTicks(leftCandidates) : horizontal\n      ? fitLeftCategories(leftCandidates[0] ?? [], xScale, width, height, leftRole, text, leftRoom, leftLabels)\n      : fitValue(leftCandidates, yScale, 'left', height, leftRoom, leftRole, text, leftLabels);\n    const bottomFit = !bottomLabels ? hiddenTicks(bottomCandidates) : horizontal\n      ? fitValue(bottomCandidates, yScale, 'bottom', width, bottomRoom, bottomRole, text, bottomLabels)\n      : fitBottom(bottomCandidates, bottomAxis.mayThin, xScale, width, bottomRoom, bottomRole, text, bottomLabels);\n\n    const nextLeft = INSET + lane(leftFit) + leftTitleSize;\n    const nextBottom = INSET + clearance + lane(bottomFit) + bottomTitleSize;\n    const key = left + '/' + bottom;\n    // A sparser tick set can free space for a denser set on the next pass. If that\n    // cycles, keep enough margin for either fit and use the labels at the final ranges.\n    if (visited.has(key) || visited.size === 16) growMargins = true;\n    if ((!growMargins && nextLeft === left && nextBottom === bottom) ||\n        (growMargins && nextLeft <= left && nextBottom <= bottom)) {\n      const base = plot.y + plot.height + clearance;\n      const texts = [\n        ...leftFit.texts.map(label => moveText(label, left - GAP, 0)),\n        ...bottomFit.texts.map(label => moveText(label, 0, base + GAP)),\n      ];\n      if (leftAxis.title && leftTitle.length) {\n        texts.push(placeText(leftTitle, leftAxis.title, left - lane(leftFit) - GAP - leftTitle.length * text.lineHeight / 2,\n          plot.y + plot.height / 2, 'middle', 'middle', -90, horizontal ? 'title-x' : 'title-y', text));\n      }\n      if (bottomAxis.title && bottomTitle.length) {\n        texts.push(placeText(bottomTitle, bottomAxis.title, left + plot.width / 2, base + lane(bottomFit) + GAP,\n          'middle', 'top', 0, horizontal ? 'title-y' : 'title-x', text));\n      }\n\n      const xFit = horizontal ? leftFit : bottomFit;\n      const yFit = horizontal ? bottomFit : leftFit;\n      return { ...size, kind: 'plot', plot, projection, xTicks: xFit.ticks, yTicks: yFit.ticks, texts, fit: { x: xFit.fit, y: yFit.fit } };\n    }\n    visited.add(key);\n    left = growMargins ? Math.max(left, nextLeft) : nextLeft;\n    bottom = growMargins ? Math.max(bottom, nextBottom) : nextBottom;\n  }\n}\n\nexport function computeLayout(input: LayoutInput): Layout {\n  const { width, height } = input;\n  const size = { width, height };\n  if (!Number.isFinite(width) || !Number.isFinite(height) || width <= 0 || height <= 0) return { ...size, kind: 'unmeasured' };\n\n  if (input.kind === 'message') {\n    const text = metrics(input);\n    const maxLines = Math.floor((height - 2 * INSET) / text.lineHeight);\n    const lines = messageLines(input.message, width - 2 * INSET, maxLines, text);\n    return { ...size, kind: 'message', text: placeText(lines, input.message, width / 2, height / 2, 'middle', 'middle', 0, 'message', text) };\n  }\n  if (input.compact) {\n    const x = Math.min(2, width / 2);\n    const y = Math.min(2, height / 2);\n    const plot = { x, y, width: width - 2 * x, height: height - 2 * y };\n    return { ...size, kind: 'compact', plot, projection: input.kind === 'ring' ? ring(plot) : project(plot, input) };\n  }\n  if (input.kind === 'ring') {\n    if (width < MIN_WIDTH || height < MIN_HEIGHT) return tooSmall(size);\n    const plot = { x: 0, y: 0, width, height };\n    return { ...size, kind: 'plot', plot, projection: ring(plot), xTicks: [], yTicks: [], texts: [], fit: { x: UNCHANGED, y: UNCHANGED } };\n  }\n  if (width < MIN_WIDTH + 2 * INSET || height < MIN_HEIGHT + 2 * INSET) return tooSmall(size);\n  const text = metrics(input);\n  const layout = layoutAxes(input, size, text, true);\n  // A title may need the space otherwise reserved for ticks at the ends of the left axis.\n  return layout.kind === 'too-small' ? layoutAxes(input, size, text, false) : layout;\n}\nimport type { Formatters, Layout, Lookup, View } from '../core/contracts';\nimport type { Messages } from '../public';\nimport { alignedLookup } from './aligned';\nimport { donutLookup } from './donut';\nimport { scatterLookup } from './scatter';\n\n/** The optional locale is retained for callers that supplied it before Formatters owned all readouts. */\nexport function buildLookup(view: View, layout: Layout, formatters: Formatters, messages: Messages, locale?: string): Lookup {\n  const plot = layout.kind === 'plot' || layout.kind === 'compact' ? layout : null;\n  switch (view.kind) {\n    case 'donut': return donutLookup(view, plot, formatters, locale);\n    case 'scatter': return scatterLookup(view, plot, formatters);\n    default: return alignedLookup(view, plot, formatters, messages);\n  }\n}\nexport { createCanvasRenderer } from './canvas';\nexport { createSvgRenderer } from './svg';\nexport { createTextLayer, type TextLayer } from './text';\n","exit_code":0,"status":"completed"}}
