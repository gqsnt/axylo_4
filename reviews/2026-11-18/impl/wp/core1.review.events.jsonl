{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/public.ts && nl -ba packages/axylo/src/data/store.ts'","aggregated_output":"/**\n * Public types of Axylo. The functions that use them are exported from index.ts.\n * Source of truth for the public API; docs/api/axylo.d.ts is the reviewed sketch this file started from.\n */\n\n// ---------- data ----------\n\n/** Rows as an API returns them, or typed columns for large data. Both describe the same logical table. */\nexport type Data<Row> = readonly Row[] | { readonly columns: { readonly [K in keyof Row]: ArrayLike<Row[K]> } };\n\ntype Key<Row> = Extract<keyof Row, string>;\ntype KeysWhere<Row, V> = { [K in Key<Row>]: [Row[K]] extends [V] ? K : never }[Key<Row>];\n\n/** A field that can sit on a value axis as it is. */\nexport type NumberKey<Row> = KeysWhere<Row, number | null | undefined>;\n/** A field of numeric strings (Postgres bigint and numeric, BigQuery): allowed only with `parse: 'number'`. */\nexport type StringKey<Row> = KeysWhere<Row, string | null | undefined>;\n/** A field that can sit on an x axis: numbers, instants, calendar dates or categories. */\nexport type XKey<Row> = KeysWhere<Row, number | string | Date | null | undefined>;\n/** A field that names a series. */\nexport type SeriesKey<Row> = KeysWhere<Row, string | number | boolean>;\n\nexport type XValue = number | string | Date;\n\n// ---------- fields ----------\n\ninterface FieldCommon {\n  /** Axis title and the name used in tooltip, table and announcements. */\n  label?: string;\n  /** Unit appended to values in tooltip, table and announcements: 'ms', 'USD', … */\n  unit?: string;\n}\n\nexport interface ValueFieldOptions extends FieldCommon {\n  /** Declares percentage data and its convention: 'percent' = 0–100, 'ratio' = 0–1. Never inferred from the label. */\n  scale?: 'percent' | 'ratio';\n  /** How values are written in tooltip, table and announcements. Default: locale grouping, up to 6 significant fraction digits. */\n  format?: Intl.NumberFormatOptions | ((value: number) => string);\n  /** How axis ticks are written. Default: compact when it saves space. */\n  tickFormat?: Intl.NumberFormatOptions | ((value: number) => string);\n  /** What a missing value means. 'gap' (default) draws nothing; 'zero' is for counts where absence means none. */\n  missing?: 'gap' | 'zero';\n  /** Author bounds. On bar and area the domain is widened to include zero and AX110 is raised if it did not. */\n  domain?: readonly [number, number];\n}\n\nexport type ValueField<Row> =\n  | NumberKey<Row>\n  | ({ field: NumberKey<Row>; parse?: never } & ValueFieldOptions)\n  | ({ field: StringKey<Row>; parse: 'number' } & ValueFieldOptions);\n\nexport interface XFieldOptions extends FieldCommon {\n  /**\n   * 'date': calendar dates ('2026-02-24'); read the same in every time zone.\n   * 'time': instants (epoch milliseconds, Date objects, ISO strings with an offset); shown in `timeZone`.\n   * 'number' and 'category' as named. Inferred when omitted, except that numbers are never inferred to be instants.\n   */\n  type?: 'number' | 'time' | 'date' | 'category';\n  /** Category axes only: the categories have a natural order (months, age bands), so labels may be thinned when they do not fit. */\n  ordered?: boolean;\n  /** For instants only. Default 'local' (the viewer's zone). */\n  timeZone?: 'local' | 'UTC' | (string & {});\n  format?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n  tickFormat?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n  domain?: readonly [XValue, XValue];\n}\n\nexport type XField<Row> = XKey<Row> | ({ field: XKey<Row> } & XFieldOptions);\n\n/** Long form: one row per (x, series). Wide form: one row per x, one column per series. Never both. */\nexport type Encoding<Row> =\n  | { x: XField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> }\n  | { x: XField<Row>; y: readonly ValueField<Row>[]; series?: never };\n\n// ---------- options ----------\n\nexport interface Title { text: string; visible?: boolean; level?: 2 | 3 | 4 | 5 | 6 }\n\nexport interface CommonOptions<Row> {\n  data: Data<Row>;\n  /** Visible heading and accessible name. */\n  title?: string | Title;\n  /** Id of an existing heading that names the chart, for dashboard cards that already show a title. */\n  labelledBy?: string;\n  subtitle?: string;\n  /** Added to the generated summary. Mandatory disclosures (time zone, omitted values) are kept. */\n  description?: string;\n  state?: 'ready' | 'loading' | { error: string } | { empty: string };\n  legend?: 'auto' | false | 'top' | 'right' | 'bottom';\n  tooltip?: boolean;\n  /** \"View as table\" control. Default true. */\n  table?: boolean;\n  /** Fixed color per series name, so \"Direct\" is the same color on every chart: { Direct: 'var(--brand-1)' }. */\n  colors?: Readonly<Record<string, string>>;\n  /** Overrides for built-in text (\"View as table\", \"No data\", …). */\n  messages?: Partial<Messages>;\n  /** Default: the document language. */\n  locale?: string;\n  /** Throw on any warning or error diagnostic, synchronously from the call that caused it. */\n  strict?: boolean;\n  onDiagnostic?: (diagnostic: Diagnostic) => void;\n}\n\nexport interface Reference {\n  x?: XValue | readonly [XValue, XValue];\n  y?: number | readonly [number, number];\n  label: string;\n}\n\nexport interface CartesianOptions {\n  /** Default true on time, date and number x axes. 'touch' also captures pinch and two-finger drag on touch screens. */\n  zoom?: boolean | 'touch';\n  reference?: readonly Reference[];\n}\n\n/** Line, area and bar only. Marks only, as a static image with a text alternative: no axes, legend, toolbar, table, zoom or tooltip. */\nexport interface CompactOption { compact?: boolean }\n\nexport type LineOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row>;\nexport type AreaOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { stacked?: boolean };\nexport type BarOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { layout?: 'grouped' | 'stacked'; horizontal?: boolean };\n/** Scatter relates two measures: its x is a number, an instant or a date, never a category. */\nexport type ScatterXField<Row> = XKey<Row> | ({ field: XKey<Row>; type?: 'number' | 'time' | 'date'; ordered?: never } & Omit<XFieldOptions, 'type' | 'ordered'>);\nexport type ScatterOptions<Row> = CommonOptions<Row> & CartesianOptions & { x: ScatterXField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> };\nexport type DonutOptions<Row> = CommonOptions<Row> & { label: SeriesKey<Row>; value: ValueField<Row> };\n\n// ---------- handle ----------\n\nexport interface Point<Row> { series: string; x: XValue; y: number | null; row: Row | null; index: number }\n\nexport interface ChartEvents<Row> {\n  hover: Point<Row> | null;\n  select: Point<Row>;\n  zoom: readonly [XValue, XValue] | null;\n}\n\nexport interface Chart<Row, Options> {\n  /**\n   * Changes options. Keys present replace the old value; a key set to `undefined` returns to its default; absent keys stay.\n   * Validation and diagnostics are synchronous (a `strict` chart throws here and keeps its last valid state); drawing happens on the next frame.\n   */\n  update(patch: Partial<Options>): void;\n  /** Adds rows at the end. `keep` = number of distinct x values retained; older ones are dropped. */\n  append(rows: readonly Row[], options?: { keep?: number }): void;\n  /** Sets the visible x range; `null` shows everything. */\n  zoom(domain: readonly [XValue, XValue] | null): void;\n  on<E extends keyof ChartEvents<Row>>(event: E, listener: (payload: ChartEvents<Row>[E]) => void): () => void;\n  /** Diagnostics for the current options and data. Up to date as soon as create, update or append returns. */\n  readonly diagnostics: readonly Diagnostic[];\n  destroy(): void;\n}\n\nexport type Target = string | HTMLElement;\n\n\n\n\n\n\n\n// ---------- diagnostics ----------\n\nexport interface Diagnostic {\n  /** Stable and documented, one page per code. */\n  code: `AX${number}`;\n  level: 'error' | 'warning' | 'hint';\n  /** What is wrong, where, and how to fix it. */\n  message: string;\n  /** The chart it came from: its title, else its element id. */\n  chart: string;\n  /** Where applicable. A diagnostic about the chart as a whole (no title, low contrast) has neither. */\n  field?: string;\n  /** First offending row indexes in the caller's own data, capped at 10. */\n  rows?: readonly number[];\n  count?: number;\n}\n\n/** Runs normalization and validation only. Works without a DOM, so a server or an agent can check options before rendering. */\n\n/** Built-in text. Templates use {name} placeholders. Every entry can be replaced through `messages` (spec A10). */\nexport interface Messages {\n  viewAsTable: string; hideTable: string;\n  noData: string; noObservation: string; incompleteStack: string;\n  moreRows: string; otherSlices: string;\n  valuesNotShown: string; valuesChanged: string; labelsHidden: string;\n  loading: string; empty: string; error: string; internalError: string;\n  chartName: string; chartSummary: string; seriesSummary: string; referenceSummary: string; timeZoneNote: string;\n  plotLabel: string; controlsLabel: string; pointOf: string;\n  zoomIn: string; zoomOut: string; resetZoom: string; pause: string; resume: string;\n  previousPage: string; nextPage: string; pageOf: string; jumpToX: string;\n  showSeries: string; hideSeries: string;\n  /** Column headers and nouns. */\n  category: string; percentage: string; series: string; value: string;\n  /** Chart type names used in generated names and summaries. */\n  typeLine: string; typeArea: string; typeBar: string; typeScatter: string; typeDonut: string;\n  /** Summary sentences that have no cartesian form. */\n  donutSummary: string; seriesNoData: string; seriesNotDrawn: string; referenceLine: string; referenceBand: string;\n}\n     1\timport {\n     2\t  SLOT_ABSENT_FIELD, SLOT_GAP, SLOT_NO_ROW, SLOT_NULL, SLOT_VALUE,\n     3\t  type AlignedFrame, type DiagnosticInput, type DiagnosticSink, type XColumn,\n     4\t} from '../core/contracts';\n     5\timport { DiagnosticCollector } from '../diagnostics';\n     6\timport {\n     7\t  alignedFrame, alignmentFits, normalize, readX, reportGaps, seriesDescription,\n     8\t  type DataEnvironment, type FrameVersion, type XData,\n     9\t} from './normalize';\n    10\timport { checkFields, type AlignedChartType, type ResolvedOptions, type ResolvedValueField } from './options';\n    11\timport { Reports } from './reports';\n    12\timport { gapPosition, snapGap, stepDelta, stepMultiple, supportsSteps, tooSparse } from './steps';\n    13\timport { FrameBuffers, type SeriesBuffers } from './store-buffers';\n    14\timport { CalendarWindow } from './store-calendar';\n    15\timport { StreamDiagnostics } from './store-diagnostics';\n    16\timport { StreamRows } from './store-rows';\n    17\timport { rowValue, rowsTable, type Table } from './table';\n    18\timport { readValues, valueMode, type ValueMode, type Values } from './values';\n    19\timport { countKinds, dateUnitOf, kindOf, nameOf, positionName, preferredKind, type DateUnit, type KindVotes } from './x';\n    20\t\n    21\tconst quiet: DiagnosticSink = { add: () => {} };\n    22\ttype Fields = Omit<ResolvedOptions, 'table'>;\n    23\t\n    24\tinterface Cadence {\n    25\t  last: number;\n    26\t  differences: number;\n    27\t  min: number;\n    28\t  span: number;\n    29\t  matches: number;\n    30\t  multiple: boolean | null;\n    31\t}\n    32\t\n    33\tfunction cadence(): Cadence {\n    34\t  return { last: -Infinity, differences: 0, min: Infinity, span: 0, matches: 0, multiple: true };\n    35\t}\n    36\t\n    37\tfunction step(c: Cadence): number {\n    38\t  return c.multiple && c.differences >= 2 && 2 * c.matches >= c.differences ? c.min : 0;\n    39\t}\n    40\t\n    41\tfunction extend(c: Cadence, axis: XColumn, x: number): void {\n    42\t  const previous = c.last;\n    43\t  c.last = x;\n    44\t  if (previous === -Infinity || !supportsSteps(axis)) return;\n    45\t  const delta = stepDelta(axis, previous, x);\n    46\t  if (delta < c.min && stepMultiple(delta, c.min) !== 1) {\n    47\t    // An irregular prefix only needs a second pass if the smaller step later becomes frequent enough.\n    48\t    c.multiple = c.differences === c.matches ? c.differences === 0 || stepMultiple(c.min, delta) > 0 : null;\n    49\t    c.min = delta;\n    50\t    c.matches = 1;\n    51\t  } else {\n    52\t    const multiple = stepMultiple(delta, c.min);\n    53\t    if (multiple === 1) c.matches++;\n    54\t    if (multiple === 0) c.multiple = false;\n    55\t  }\n    56\t  c.span += delta;\n    57\t  c.differences++;\n    58\t}\n    59\t\n    60\tfunction absent(c: Cadence, size: number): number {\n    61\t  return size ? Math.max(0, Math.round(c.span / size) - c.differences) : 0;\n    62\t}\n    63\t\n    64\tclass Observations {\n    65\t  private positions = new Float64Array();\n    66\t  private start = 0;\n    67\t  private end = 0;\n    68\t\n    69\t  get first(): number | undefined { return this.at(0); }\n    70\t\n    71\t  at(index: number): number | undefined {\n    72\t    return this.start + index < this.end ? this.positions[this.start + index] : undefined;\n    73\t  }\n    74\t\n    75\t  add(position: number): void {\n    76\t    if (this.end === this.positions.length) this.resize(1);\n    77\t    this.positions[this.end++] = position;\n    78\t  }\n    79\t\n    80\t  evict(): void {\n    81\t    this.start++;\n    82\t    if (this.positions.length > Math.max(8, 4 * (this.end - this.start))) this.resize(0);\n    83\t  }\n    84\t\n    85\t  private resize(extra: number): void {\n    86\t    const retained = this.positions.subarray(this.start, this.end);\n    87\t    this.positions = new Float64Array(Math.max(4, 2 * (retained.length + extra)));\n    88\t    this.positions.set(retained);\n    89\t    this.start = 0;\n    90\t    this.end = retained.length;\n    91\t  }\n    92\t}\n    93\t\n    94\tfunction readCadence(axis: XColumn, observations: Observations): Cadence {\n    95\t  const c = cadence();\n    96\t  for (let i = 0, position = observations.first; position !== undefined; position = observations.at(++i)) {\n    97\t    if (i && supportsSteps(axis)) {\n    98\t      const delta = stepDelta(axis, c.last, position);\n    99\t      c.min = Math.min(c.min, delta);\n   100\t      c.span += delta;\n   101\t      c.differences++;\n   102\t    }\n   103\t    c.last = position;\n   104\t  }\n   105\t  for (let i = 1, position = observations.at(1); position !== undefined; position = observations.at(++i)) {\n   106\t    if (!supportsSteps(axis)) break;\n   107\t    const multiple = stepMultiple(stepDelta(axis, observations.at(i - 1)!, position), c.min);\n   108\t    if (multiple === 1) c.matches++;\n   109\t    if (!multiple) c.multiple = false;\n   110\t  }\n   111\t  return c;\n   112\t}\n   113\t\n   114\tfunction seriesKeys(table: Table, field: string | null): (string | null)[] | null {\n   115\t  if (field === null) return null;\n   116\t  const keys = new Array<string | null>(table.length);\n   117\t  for (let row = 0; row < table.length; row++) keys[row] = nameOf(table.read(row, field));\n   118\t  return keys;\n   119\t}\n   120\t\n   121\tfunction eachObservation(\n   122\t  options: Fields, x: XData, keys: readonly (string | null)[] | null,\n   123\t  visit: (key: string, position: number) => void,\n   124\t): void {\n   125\t  const length = x.order?.length ?? x.positions.length;\n   126\t  for (let i = 0; i < length; i++) {\n   127\t    const row = x.order?.[i] ?? i;\n   128\t    const position = x.positions[row]!;\n   129\t    if (keys) {\n   130\t      const key = keys[row];\n   131\t      if (key != null) visit(key, position);\n   132\t    } else {\n   133\t      for (const field of options.values) visit(field.field, position);\n   134\t    }\n   135\t  }\n   136\t}\n   137\t\n   138\tfunction cadences(options: Fields, table: Table, x: XData, axis: XColumn) {\n   139\t  const keys = seriesKeys(table, options.series);\n   140\t  const observations = new Map<string, Observations>();\n   141\t  const duplicates = new Map<string, Set<number>>();\n   142\t  const last = new Map<string, number>();\n   143\t  eachObservation(options, x, keys, (key, position) => {\n   144\t    let window = observations.get(key);\n   145\t    if (!window) observations.set(key, window = new Observations());\n   146\t    if (position === last.get(key)) {\n   147\t      let positions = duplicates.get(key);\n   148\t      if (!positions) duplicates.set(key, positions = new Set());\n   149\t      positions.add(position);\n   150\t    } else {\n   151\t      window.add(position);\n   152\t      last.set(key, position);\n   153\t    }\n   154\t  });\n   155\t  const history = new Map(Array.from(observations, ([key, window]) => [key, readCadence(axis, window)]));\n   156\t  return { history, observations, duplicates };\n   157\t}\n   158\t\n   159\tfunction calendarFor(x: XData, table: Table): CalendarWindow | null {\n   160\t  if (x.parser.kind !== 'time') return null;\n   161\t  const history = new CalendarWindow(x.parser.timeZone ?? 'UTC');\n   162\t  for (let i = 0, n = x.order?.length ?? x.positions.length; i < n; i++) {\n   163\t    history.observe(x.positions[x.order?.[i] ?? i]!);\n   164\t  }\n   165\t  for (let i = 0; i < x.positions.length; i++) {\n   166\t    if (Number.isFinite(x.positions[i])) history.record(table.rowIndex(i));\n   167\t  }\n   168\t  return history;\n   169\t}\n   170\t\n   171\tinterface ValueCounts {\n   172\t  decimal: number;\n   173\t  other: number;\n   174\t}\n   175\t\n   176\tfunction mode(counts: ValueCounts): ValueMode {\n   177\t  return counts.other ? 'other' : counts.decimal ? 'decimal' : 'empty';\n   178\t}\n   179\t\n   180\tfunction valueCounts(table: Table, field: string, positions: Float64Array): ValueCounts {\n   181\t  const counts = { decimal: 0, other: 0 };\n   182\t  for (let i = 0; i < table.length; i++) {\n   183\t    if (!Number.isFinite(positions[i])) continue;\n   184\t    const kind = valueMode(table.read(i, field), table.isColumnRow(i));\n   185\t    if (kind !== 'empty') counts[kind]++;\n   186\t  }\n   187\t  return counts;\n   188\t}\n   189\t\n   190\tinterface State {\n   191\t  readonly axis: XColumn;\n   192\t  readonly parser: XData['parser'];\n   193\t  readonly buffers: FrameBuffers;\n   194\t  readonly history: Map<string, Cadence>;\n   195\t  readonly observations: Map<string, Observations>;\n   196\t  readonly duplicates: Map<string, Set<number>>;\n   197\t  readonly modes: Map<string, ValueCounts>;\n   198\t  readonly calendar: CalendarWindow | null;\n   199\t  readonly votes: KindVotes | null;\n   200\t  readonly dateUnits: Record<DateUnit, number> | null;\n   201\t  readonly overBudget: boolean;\n   202\t  readonly diagnostics: StreamDiagnostics;\n   203\t}\n   204\t\n   205\tinterface BatchSeries {\n   206\t  readonly key: string;\n   207\t  readonly value: ResolvedValueField;\n   208\t  readonly values: Values;\n   209\t  readonly rows: readonly number[];\n   210\t  readonly cadence: Cadence;\n   211\t  readonly duplicates: readonly number[];\n   212\t  readonly gaps: Float64Array | null;\n   213\t  readonly sparse: number;\n   214\t}\n   215\t\n   216\tinterface Batch {\n   217\t  readonly positions: Float64Array;\n   218\t  readonly axis: XColumn;\n   219\t  readonly series: readonly BatchSeries[];\n   220\t  readonly x: Float64Array;\n   221\t  readonly observed: Uint8Array;\n   222\t  readonly modes: State['modes'];\n   223\t  readonly diagnostics: StreamDiagnostics;\n   224\t}\n   225\t\n   226\tfunction tail(\n   227\t  positions: Float64Array, series: readonly BatchSeries[], lastX: number,\n   228\t): { x: Float64Array; observed: Uint8Array } {\n   229\t  const gapCount = series.reduce((sum, item) => sum + (item.gaps?.length ?? 0), 0);\n   230\t  const distinct = new Float64Array(positions.length + gapCount);\n   231\t  let length = 0;\n   232\t  for (const position of positions) {\n   233\t    if (position > lastX && Number.isFinite(position) && (!length || position !== distinct[length - 1])) distinct[length++] = position;\n   234\t  }\n   235\t  const seen = distinct.subarray(0, length);\n   236\t  if (!gapCount) return { x: seen, observed: new Uint8Array(length).fill(1) };\n   237\t  const union = distinct.slice(0, length + gapCount);\n   238\t  for (const { gaps } of series) {\n   239\t    if (!gaps) continue;\n   240\t    union.set(gaps, length);\n   241\t    length += gaps.length;\n   242\t  }\n   243\t  union.sort();\n   244\t  const observed = new Uint8Array(length);\n   245\t  let index = 0;\n   246\t  let count = 0;\n   247\t  for (const x of union) {\n   248\t    if (count && x === union[count - 1]) continue;\n   249\t    union[count] = x;\n   250\t    if (seen[index] === x) {\n   251\t      observed[count] = 1;\n   252\t      index++;\n   253\t    }\n   254\t    count++;\n   255\t  }\n   256\t  return { x: union.subarray(0, count), observed: observed.subarray(0, count) };\n   257\t}\n   258\t\n   259\tfunction extendSeries(\n   260\t  key: string, field: ResolvedValueField, values: Values, rows: readonly number[],\n   261\t  positions: Float64Array, state: State, axis: XColumn, lastX: number,\n   262\t  duplicates: Reports, firstRow: number, observedX: () => Float64Array, label: string = key,\n   263\t): BatchSeries | null {\n   264\t  const previous = state.history.get(key) ?? cadence();\n   265\t  const next = { ...previous };\n   266\t  const observed: number[] = [];\n   267\t  const repeated: number[] = [];\n   268\t  for (const row of rows) {\n   269\t    const position = positions[row]!;\n   270\t    if (position === next.last) {\n   271\t      repeated.push(position);\n   272\t      duplicates.add('AX108', 'series-disabled', firstRow + row, undefined, undefined, {\n   273\t        series: label, position: axis.kind === 'category' ? JSON.stringify(state.parser.categoryName(position)) : positionName(axis, position),\n   274\t      });\n   275\t    } else {\n   276\t      extend(next, axis, position);\n   277\t      observed.push(row);\n   278\t    }\n   279\t  }\n   280\t  if (next.multiple === null && next.differences >= 2 && 2 * next.matches >= next.differences) return null;\n   281\t  const oldStep = step(previous);\n   282\t  const newStep = step(next);\n   283\t  const oldAbsent = absent(previous, oldStep);\n   284\t  const nextAbsent = absent(next, newStep);\n   285\t  const oldSparse = tooSparse(oldAbsent, previous.differences + 1);\n   286\t  const newSparse = tooSparse(nextAbsent, next.differences + 1);\n   287\t  if (oldSparse !== newSparse || oldStep !== newStep && !newSparse &&\n   288\t    (oldAbsent > 0 || absent(previous, newStep) > 0)) return null;\n   289\t  if (newSparse) return { key, value: field, values, rows: observed, cadence: next, gaps: null, duplicates: repeated, sparse: nextAbsent };\n   290\t\n   291\t  let gapCount = 0;\n   292\t  if (newStep) {\n   293\t    let last = previous.last;\n   294\t    for (const row of observed) {\n   295\t      const position = positions[row]!;\n   296\t      if (last !== -Infinity) gapCount += stepMultiple(stepDelta(axis, last, position), newStep) - 1;\n   297\t      last = position;\n   298\t    }\n   299\t  }\n   300\t  const gaps = gapCount ? new Float64Array(gapCount) : null;\n   301\t  if (gaps) {\n   302\t    let index = 0;\n   303\t    let last = previous.last;\n   304\t    for (const row of observed) {\n   305\t      const position = positions[row]!;\n   306\t      const multiple = last === -Infinity ? 0 : stepMultiple(stepDelta(axis, last, position), newStep);\n   307\t      for (let j = 1; j < multiple; j