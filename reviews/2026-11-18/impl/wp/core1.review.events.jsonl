on(event, listener) {\n   888\t      if (destroyed) return () => {};\n   889\t      let set = listeners.get(event);\n   890\t      if (!set) listeners.set(event, set = new Set());\n   891\t      set.add(listener as (payload: never) => void);\n   892\t      return () => { set!.delete(listener as (payload: never) => void); };\n   893\t    },\n   894\t    get diagnostics() {\n   895\t      return currentDiagnostics();\n   896\t    },\n   897\t    destroy,\n   898\t  };\n   899\t\n   900\t  const bench = (globalThis as { __AXYLO_BENCH__?: unknown }).__AXYLO_BENCH__ === true;\n   901\t  if (__DEV__ || bench) {\n   902\t    handle.__bench = {\n   903\t      get revision() {\n   904\t        return accepted?.revision ?? 0;\n   905\t      },\n   906\t      ready() {\n   907\t        const revision = accepted?.revision ?? 0;\n   908\t        if (destroyed || (drawn && drawn.drawnRevision >= revision && frameRequest === 0)) return Promise.resolve();\n   909\t        return new Promise<void>(resolve => waiters.push({ revision, resolve }));\n   910\t      },\n   911\t      describe() {\n   912\t        const d = drawn;\n   913\t        if (!d) return { xDomain: null, yDomain: null, series: [] };\n   914\t        return describe(d.accepted.view);\n   915\t      },\n   916\t    };\n   917\t  }\n   918\t  if (__DEV__) {\n   919\t    handle.__dev = {\n   920\t      stages: () => ({ ...counts }),\n   921\t      fail(name) {\n   922\t        failing = name;\n   923\t      },\n   924\t      renderer: renderer.kind,\n   925\t    };\n   926\t  }\n   927\t  return handle;\n   928\t}\n   929\t\n   930\tfunction indexOf(values: Float64Array, x: number): number {\n   931\t  let lo = 0;\n   932\t  let hi = values.length;\n   933\t  while (lo < hi) {\n   934\t    const mid = (lo + hi) >>> 1;\n   935\t    if (values[mid]! < x) lo = mid + 1;\n   936\t    else hi = mid;\n   937\t  }\n   938\t  return values[lo] === x ? lo : -1;\n   939\t}\n   940\t\n   941\tfunction hasData(view: View): boolean {\n   942\t  if (view.kind === 'donut') return view.slices.some(s => s.angles !== null);\n   943\t  if (view.kind === 'scatter') return view.frame.series.some((s, i) => view.visible[i] && s.x.length > 0);\n   944\t  const { start, end } = view.visibleSlots;\n   945\t  return view.frame.series.some((s, i) => {\n   946\t    if (!view.visible[i]) return false;\n   947\t    for (let j = start; j < end; j++) if (s.slot[j] === SLOT_VALUE) return true;\n   948\t    return false;\n   949\t  });\n   950\t}\n   951\t\n   952\tfunction describe(view: View): ReturnType<BenchHook['describe']> {\n   953\t  if (view.kind === 'donut') {\n   954\t    return { xDomain: null, yDomain: null, series: [] };\n   955\t  }\n   956\t  if (view.kind === 'scatter') {\n   957\t    return {\n   958\t      xDomain: view.xDomain, yDomain: view.yDomain,\n   959\t      series: view.frame.series.map(s => ({\n   960\t        key: s.key, points: s.x.length, oldestX: s.x[0] ?? NaN, newestX: s.x[s.x.length - 1] ?? NaN, missing: 0,\n   961\t      })),\n   962\t    };\n   963\t  }\n   964\t  const { frame } = view;\n   965\t  return {\n   966\t    xDomain: view.xDomain, yDomain: view.yDomain,\n   967\t    series: frame.series.map(s => {\n   968\t      let points = 0;\n   969\t      let missing = 0;\n   970\t      let first = -1;\n   971\t      let last = -1;\n   972\t      for (let i = 0; i < frame.length; i++) {\n   973\t        const state = s.slot[i];\n   974\t        if (state === SLOT_NO_ROW) continue;\n   975\t        points++;\n   976\t        if (first < 0) first = i;\n   977\t        last = i;\n   978\t        if (state !== SLOT_VALUE) missing++;\n   979\t      }\n   980\t      return {\n   981\t        key: s.key, points, missing,\n   982\t        oldestX: first < 0 ? NaN : frame.x.values[first]!, newestX: last < 0 ? NaN : frame.x.values[last]!,\n   983\t      };\n   984\t    }),\n   985\t  };\n   986\t}\n   987\t\n   988\tfunction resolveTarget(target: unknown): HTMLElement {\n   989\t  if (typeof target === 'string') {\n   990\t    const doc = (globalThis as { document?: Document }).document;\n   991\t    if (!doc) throw new Error(`Axylo: no document to find the target ${JSON.stringify(target)} in.`);\n   992\t    let found: Element | null = null;\n   993\t    try {\n   994\t      found = doc.querySelector(target);\n   995\t    } catch {\n   996\t      throw new Error(`Axylo: the target selector ${JSON.stringify(target)} is not a valid CSS selector.`);\n   997\t    }\n   998\t    if (!found) throw new Error(`Axylo: the target selector ${JSON.stringify(target)} matches no element.`);\n   999\t    return found as HTMLElement;\n  1000\t  }\n  1001\t  if (target !== null && typeof target === 'object' && (target as Node).nodeType === 1) return target as HTMLElement;\n  1002\t  throw new Error('Axylo: the target must be a CSS selector or an element.');\n  1003\t}\n  1004\t\n  1005\t/** For scatter and donut, which have no streaming store: the rows join the data, keeping `keep` distinct x. */\n  1006\tfunction appendRows(data: unknown, rows: readonly unknown[], xField: string, keep: number | undefined): unknown[] {\n  1007\t  let existing: unknown[];\n  1008\t  if (Array.isArray(data)) existing = data;\n  1009\t  else {\n  1010\t    const columns = object(object(data).columns) as Record<string, ArrayLike<unknown>>;\n  1011\t    const names = Object.keys(columns);\n  1012\t    const length = columns[names[0] ?? '']?.length ?? 0;\n  1013\t    existing = Array.from({ length }, (_, i) => Object.fromEntries(names.map(n => [n, columns[n]![i]])));\n  1014\t  }\n  1015\t  const all = existing.concat(rows);\n  1016\t  if (keep === undefined || !Number.isFinite(keep)) return all;\n  1017\t  const limit = Math.max(0, Math.floor(keep));\n  1018\t  const seen = new Set<unknown>();\n  1019\t  let start = all.length;\n  1020\t  for (let i = all.length - 1; i >= 0; i--) {\n  1021\t    const raw = object(all[i])[xField];\n  1022\t    const key = raw instanceof Date ? raw.getTime