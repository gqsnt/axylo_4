{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/core/chart.ts'","aggregated_output":"     1\t/**\n     2\t * The chart controller: one implementation behind `line`, `area`, `bar`, `scatter` and `donut`.\n     3\t *\n     4\t * Two phases (plan 1.5). A call (create, update, append, zoom) resolves options, normalizes what changed and\n     5\t * builds the view synchronously, so `diagnostics` is current when it returns and a `strict` chart can throw\n     6\t * from it before anything is accepted. Everything that needs the page (layout, scene, lookup, reader model,\n     7\t * marks, text, the figure's DOM) runs in the next animation frame, from the accepted state only, and switches\n     8\t * together: no frame mixes two revisions.\n     9\t *\n    10\t * Each frame stage is cached and reruns only when its inputs change (plan 2.2). In development builds the\n    11\t * handle exposes a counter per stage (`__dev.stages()`) so tests can assert what reran.\n    12\t */\n    13\timport {\n    14\t  SLOT_NO_ROW, SLOT_VALUE,\n    15\t  type DiagnosticInput, type Formatters, type Frame, type Layout, type Lookup, type MarkRenderer, type PickTarget,\n    16\t  type ReaderModel, type ResolvedTheme, type PaintBindings, type Scene, type TextStyle, type View,\n    17\t} from './contracts';\n    18\timport type { Chart, ChartEvents, Diagnostic, Messages, Point, Title, XValue } from '../public';\n    19\timport { AlignedStore, normalize, resolveOptions, type ChartType, type ResolvedOptions } from '../data';\n    20\timport { createDiagnostic, DiagnosticCollector, readerDisclosure, report, type DiagnosticCode } from '../diagnostics';\n    21\timport { createFormatters, type FormatSpec } from '../format';\n    22\timport { buildView, type ViewState } from '../view';\n    23\timport { computeLayout } from '../layout';\n    24\timport { buildScene } from '../scene';\n    25\timport { buildLookup } from '../lookup';\n    26\timport { buildReader } from '../reader';\n    27\timport { fill, resolveMessages } from '../messages';\n    28\timport { createCanvasRenderer, createSvgRenderer, createTextLayer, type TextLayer } from '../render';\n    29\timport { ensureStyles, lowContrastSeries, resolveTheme, watchTheme } from '../theme';\n    30\timport { OptionsStore, sameValue, type OptionRecord } from './options';\n    31\timport { Delivery, StrictError, strictViolations, type DeliveryConsole } from './delivery';\n    32\timport { createMeasurer, readTextStyle, resolveLocale, sameTextStyle, viewerTimeZone, watchEnvironment } from './environment';\n    33\timport { layoutInput, layoutKey, sameKey, type AxisContext } from './axes';\n    34\timport { createFigure, type Figure, type FigureModel } from '../dom/figure';\n    35\timport { createTooltip, type TooltipView } from '../dom/tooltip';\n    36\timport { sameTarget, watchPointer } from '../dom/pointer';\n    37\t\n    38\texport type ChartKind = ChartType;\n    39\t\n    40\ttype Span<T = number> = readonly [T, T];\n    41\t\n    42\t/** Option keys that change what normalization reads. */\n    43\tconst ENCODING_KEYS = ['x', 'y', 'series', 'label', 'value'] as const;\n    44\tconst STAGES = ['options', 'normalize', 'append', 'view', 'frame', 'theme', 'formatters', 'layout', 'scene', 'lookup',\n    45\t  'reader', 'draw', 'text', 'figure'] as const;\n    46\texport type Stage = typeof STAGES[number];\n    47\t\n    48\tconst KIND_NAMES: Record<ChartKind, string> = { line: 'Line', area: 'Area', bar: 'Bar', scatter: 'Scatter', donut: 'Donut' };\n    49\tconst KIND_MESSAGES = { line: 'typeLine', area: 'typeArea', bar: 'typeBar', scatter: 'typeScatter', donut: 'typeDonut' } as const;\n    50\t\n    51\tlet instances = 0;\n    52\t\n    53\t/** What the benchmark harness reads (bench/README.md): readiness and what the committed frame shows. */\n    54\texport interface BenchHook {\n    55\t  readonly revision: number;\n    56\t  ready(): Promise<void>;\n    57\t  describe(): {\n    58\t    xDomain: Span | null;\n    59\t    yDomain: Span | null;\n    60\t    series: { key: string; points: number; oldestX: number; newestX: number; missing: number }[];\n    61\t  };\n    62\t}\n    63\t\n    64\texport interface DevHook {\n    65\t  stages(): Record<Stage, number>;\n    66\t  /** Makes the named stage throw, to test the internal-error state; null stops it. */\n    67\t  fail(stage: Stage | null): void;\n    68\t  readonly renderer: 'canvas' | 'svg';\n    69\t}\n    70\t\n    71\texport type ChartHandle = Chart<unknown, Record<string, unknown>> & { __bench?: BenchHook; __dev?: DevHook };\n    72\t\n    73\t/** The state a call produced. Only accepted states are drawn. */\n    74\tinterface Accepted {\n    75\t  readonly options: OptionRecord;\n    76\t  readonly resolved: ResolvedOptions;\n    77\t  readonly store: AlignedStore | null;\n    78\t  readonly frame: Frame;\n    79\t  readonly dataDiagnostics: readonly DiagnosticInput[];\n    80\t  readonly optionDiagnostics: readonly DiagnosticInput[];\n    81\t  readonly viewDiagnostics: readonly DiagnosticInput[];\n    82\t  readonly view: View;\n    83\t  readonly viewKey: readonly unknown[];\n    84\t  readonly zoom: Span<XValue> | null;\n    85\t  /** Zoomed to the latest edge: the window follows appended data (plan 1.5). */\n    86\t  readonly follow: boolean;\n    87\t  readonly epoch: number;\n    88\t  readonly revision: number;\n    89\t  readonly messages: Messages;\n    90\t  readonly name: string;\n    91\t}\n    92\t\n    93\ttype Display =\n    94\t  | { readonly kind: 'ready' }\n    95\t  | { readonly kind: 'loading' | 'error' | 'empty' | 'internal'; readonly text: string };\n    96\t\n    97\tfunction object(value: unknown): Record<string, unknown> {\n    98\t  return value !== null && typeof value === 'object' ? value as Record<string, unknown> : {};\n    99\t}\n   100\t\n   101\tfunction titleOf(options: OptionRecord): { text: string; level: number; visible: boolean } | null {\n   102\t  const raw = options.title;\n   103\t  if (typeof raw === 'string') return raw ? { text: raw, level: 3, visible: true } : null;\n   104\t  const t = object(raw) as Partial<Title>;\n   105\t  if (typeof t.text !== 'string' || t.text === '') return null;\n   106\t  const level = typeof t.level === 'number' && t.level >= 2 && t.level <= 6 ? Math.floor(t.level) : 3;\n   107\t  return { text: t.text, level, visible: t.visible !== false };\n   108\t}\n   109\t\n   110\tfunction stringOption(options: OptionRecord, key: string): string | null {\n   111\t  const v = options[key];\n   112\t  return typeof v === 'string' && v !== '' ? v : null;\n   113\t}\n   114\t\n   115\tfunction isCompact(kind: ChartKind, options: OptionRecord): boolean {\n   116\t  return (kind === 'line' || kind === 'area' || kind === 'bar') && options.compact === true;\n   117\t}\n   118\t\n   119\tfunction toPublic(inputs: readonly DiagnosticInput[], chart: string): Diagnostic[] {\n   120\t  return inputs.map(({ effect: _e, origin: _o, ...d }) => ({ ...d, chart }));\n   121\t}\n   122\t\n   123\t/** An x position as the value the author would write, so a zoom window can be moved by positions. */\n   124\tfunction positionValue(frame: Frame, position: number): XValue {\n   125\t  if (frame.shape === 'donut') return position;\n   126\t  const kind = frame.shape === 'points' ? frame.xKind : frame.x.kind;\n   127\t  if (kind === 'time') return new Date(position);\n   128\t  if (kind === 'wall') return new Date(position).toISOString().slice(0, 23);\n   129\t  if (kind === 'category' && frame.shape === 'aligned') return frame.x.categories?.[position] ?? position;\n   130\t  return position;\n   131\t}\n   132\t\n   133\tfunction tail(values: Float64Array, limit: number): number {\n   134\t  return values.length ? values[values.length - 1]! : limit;\n   135\t}\n   136\t\n   137\texport interface ChartEnvironmentOverrides {\n   138\t  readonly console?