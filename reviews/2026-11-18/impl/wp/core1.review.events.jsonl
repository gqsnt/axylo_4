'scatter', 'donut']) {\n   111\t        expect(result[name]!.role, name).toBe('group');\n   112\t        expect(result[name]!.labelledby, name).toMatch(/-t$/);\n   113\t      }\n   114\t      // Compact (spec C1, C3): an image named by its title, described by the summary, no tab stop, 32 px tall.\n   115\t      expect(result.compact!.role).toBe('img');\n   116\t      expect(result.compact!.label).toBe('Sessions, last 120 days');\n   117\t      expect(result.compact!.tabStops).toBe(0);\n   118\t      expect(result.compact!.plotHeight).toBe(32);\n   119\t      const tree = await aria(page, '#compact');\n   120\t      expect(tree).toContain('img \"Sessions, last 120 days\"');\n   121\t      expect(tree).not.toContain('heading');\n   122\t      // Donut summary lists the slices with their values (spec F8 text).\n   123\t      expect(result.donut!.summary).toContain('Chrome');\n   124\t      expect(result.donut!.summary).toContain('Samsung Internet');\n   125\t      expect(await aria(page, '#donut')).toContain('group \"Sessions by browser\"');\n   126\t      expect(await closePage(page)).toEqual([]);\n   127\t    });\n   128\t  }\n   129\t});\n   130\t\n   131\tdescribe('compact variant (spec C1, C5)', () => {\n   132\t  it('with values left out, the description says so and a corner marker appears; there is no note element', async () => {\n   133\t    const page = await chartPage({ css: '#chart { width: 160px; height: auto; }' });\n   134\t    const result = await page.evaluate(async () => {\n   135\t      const chart = window.Axylo.line!('#chart', { title: 'Dirty spark', compact: true, data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n   136\t      await chart.__bench.ready();\n   137\t      const fig = document.querySelector('#chart figure')!;\n   138\t      const corner = fig.querySelector('.axylo-corner') as HTMLElement;\n   139\t      const note = fig.querySelector('.axylo-note') as HTMLElement;\n   140\t      return {\n   141\t        description: document.getElementById(fig.getAttribute('aria-describedby')!)!.textContent,\n   142\t        corner: corner.hidden ? null : corner.getBoundingClientRect().width, cornerTitle: corner.getAttribute('title'),\n   143\t        note: note.hidden, tabStops: fig.querySelectorAll('[tabindex]').length,\n   144\t      };\n   145\t    });\n   146\t    expect(result.description).toMatch(/3\\b.*not shown|not shown.*3\\b/i);\n   147\t    expect(result.corner).toBeGreaterThan(0);\n   148\t    expect(result.cornerTitle).toMatch(/not shown/i);\n   149\t    expect(result.note).toBe(true);\n   150\t    expect(result.tabStops).toBe(0);\n   151\t    expect(await closePage(page)).toEqual([]);\n   152\t  });\n   153\t});\n   154\t\n   155\tdescribe('names and ids', () => {\n   156\t  it('24 charts on one page: no duplicate ids, each its own name', async () => {\n   157\t    const page = await chartPage({ css: '.tile { width: 220px; height: 160px; display: inline-block; }' });\n   158\t    const result = await page.evaluate(async () => {\n   159\t      const charts = Array.from({ length: 24 }, (_, i) => {\n   160\t        const el = document.createElement('div');\n   161\t        el.className = 'tile';\n   162\t        document.body.appendChild(el);\n   163\t        return window.Axylo.line!(el, { title: `Chart ${i + 1}`, data: window.fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel' });\n   164\t      });\n   165\t      await Promise.all(charts.map(c => c.__bench.ready()));\n   166\t      const ids = [...document.querySelectorAll('[id]')].map(e => e.id);\n   167\t      const names = [...document.querySelectorAll('figure')].map(f => document.getElementById(f.getAttribute('aria-labelledby')!)?.textContent);\n   168\t      return { ids, duplicates: ids.filter((id, i) => ids.indexOf(id) !== i), names };\n   169\t    });\n   170\t    expect(result.duplicates).toEqual([]);\n   171\t    expect(new Set(result.names).size).toBe(24);\n   172\t    expect(result.names[23]).toBe('Chart 24');\n   173\t    expect(await closePage(page)).toEqual([]);\n   174\t  });\n   175\t\n   176\t  it('labelledBy names the chart from the page heading, with no heading of its own; title.level and visible are honoured', async () => {\n   177\t    const page = await chartPage();\n   178\t    const result = await page.evaluate(async () => {\n   179\t      const h = document.createElement('h2');\n   180\t      h.id = 'card-title';\n   181\t      h.textContent = 'Sessions card';\n   182\t      document.body.prepend(h);\n   183\t      const rows = window.fx.trendRows();\n   184\t      const a = window.Axylo.line!('#chart', { labelledBy: 'card-title', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n   185\t      const el = document.createElement('div');\n   186\t      el.id = 'second';\n   187\t      el.style.width = '400px';\n   188\t      document.body.appendChild(el);\n   189\t      const b = window.Axylo.line!(el, { title: { text: 'Hidden title', level: 4, visible: false }, data: rows, x: 'day', y: 'sessions', series: 'channel' });\n   190\t      await Promise.all([a.__bench.ready(), b.__bench.ready()]);\n   191\t      const t = el.querySelector('.axylo-title') as HTMLElement;\n   192\t      return {\n   193\t        a: document.querySelector('#chart figure')!.getAttribute('aria-labelledby'),\n   194\t        aHeading: (document.querySelector('#chart .axylo-title') as HTMLElement).hidden,\n   195\t        aCodes: a.diagnostics.map(d => d.code),\n   196\t        bLevel: t.getAttribute('aria-level'), bWidth: t.getBoundingClientRect().width,\n   197\t      };\n   198\t    });\n   199\t    expect(result.a).toBe('card-title');\n   200\t    expect(result.aHeading).toBe(true);\n   201\t    expect(result.aCodes).not.toContain('AX140');\n   202\t    expect(result.bLevel).toBe('4');\n   203\t    expect(result.bWidth).toBeLessThanOrEqual(1);\n   204\t    expect(await aria(page, '#second')).toContain('heading \"Hidden title\" [level=4]');\n   205\t    expect(await closePage(page)).toEqual([]);\n   206\t  });\n   207\t\n   208\t  it('a chart without title or labelledBy gets a generated name and AX140', async () => {\n   209\t    const page = await chartPage();\n   210\t    const result = await page.evaluate(async () => {\n   211\t      const chart = window.Axylo.line!('#chart', { data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   212\t      await chart.__bench.ready();\n   213\t      return { codes: chart.diagnostics.map(d => d.code), label: document.querySelector('#chart figure')!.getAttribute('aria-label') };\n   214\t    });\n   215\t    expect(result.codes).toContain('AX140');\n   216\t    expect(result.label).toBe('Line chart of sessions by day');\n   217\t    expect(await closePage(page)).toEqual([]);\n   218\t  });\n   219\t\n   220\t  it('a selector that matches nothing throws an error naming it', async () => {\n   221\t    const page = await chartPage();\n   222\t    const message = await page.evaluate(() => {\n   223\t      try {\n   224\t        window.Axylo.line!('#missing-chart', { data: [], x: 'a', y: 'b' });\n   225\t        return 'no error';\n   226\t      } catch (error) {\n   227\t        return String(error);\n   228\t      }\n   229\t    });\n   230\t    expect(message).toContain('#missing-chart');\n   231\t    expect(await closePage(page)).toEqual([]);\n   232\t  });\n   233\t\n   234\t  it('works with the stylesheet applied through ensureStyles (no linked axylo.css)', async () => {\n   235\t    const page = await chartPage({ standaloneCss: false });\n   236\t    const result = await page.evaluate(async () => {\n   237\t      const chart = window.Axylo.line!('#chart', { title: 'T', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   238\t      await chart.__bench.ready();\n   239\t      const summary = document.querySelector('#chart .axylo-summary')!;\n   240\t      return { sheets: document.adoptedStyleSheets.length, summaryWidth: summary.getBoundingClientRect().width, display: getComputedStyle(document.querySelector('#chart figure')!).display };\n   241\t    });\n   242\t    expect(result.sheets).toBe(1);\n   243\t    expect(result.display).toBe('flex');\n   244\t    expect(result.summaryWidth).toBeLessThanOrEqual(1);\n   245\t    expect(await closePage(page)).toEqual([]);\n   246\t  });\n   247\t});\n   248\t\n   249\tdescribe('tooltip', () => {\n   250\t  it('shows every series at the nearest x on pointer move, built as text, and hides on leave', async () => {\n   251\t    const page = await chartPage();\n   252\t    await page.evaluate(async () => {\n   253\t      const chart = window.Axylo.line!('#chart', { title: 'T', data: window.fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel' });\n   254\t      window.charts.push(chart);\n   255\t      await chart.__bench.ready();\n   256\t    });\n   257\t    const plot = (await page.locator('#chart .axylo-plot').boundingBox())!;\n   258\t    await page.mouse.move(plot.x + plot.width * 0.5, plot.y + plot.height * 0.5);\n   259\t    const tip = page.locator('#chart .axylo-tooltip');\n   260\t    await expect.poll(() => tip.isVisible()).toBe(true);\n   261\t    const text = await tip.textContent();\n   262\t    for (const name of ['Direct', 'Organic search', 'Referral']) expect(text).toContain(name);\n   263\t    expect(text).toContain('UTC');\n   264\t    expect(await tip.locator('script, img').count()).toBe(0);\n   265\t    await page.mouse.move(5, 5);\n   266\t    await expect.poll(() => tip.isVisible()).toBe(false);\n   267\t    expect(await closePage(page)).toEqual([]);\n   268\t  });\n   269\t});\n/**\n * Spec DX8: the built package imports in a plain Node process (no DOM, no test framework) and `validate`\n * runs there. Lives with the browser tests because it needs `npm run build` first.\n */\nimport { describe, expect, it } from 'vitest';\nimport { execFileSync } from 'node:child_process';\nimport path from 'node:path';\n\nconst dist = path.resolve(import.meta.dirname, '../../../dist');\n\ndescribe('the built package in plain Node (spec DX8)', () => {\n  for (const file of ['axylo.js', 'axylo.dev.js']) {\n    it(`import('${file}') does not throw and validate('line', …) returns diagnostics`, () => {\n      const script = `\n        const m = await import(${JSON.stringify(path.join(dist, file))});\n        const d = m.validate('line', { title: 'Dirty input', data: [{ day: 'Mon', value: 10 }, { day: 'Tue', value: NaN }], x: 'day', y: 'value' });\n        console.log(JSON.stringify({ exports: Object.keys(m).sort(), codes: d.map(x => x.code), document: typeof document }));`;\n      const out = JSON.parse(execFileSync(process.execPath, ['--input-type=module', '-e', script], { encoding: 'utf8' }).trim());\n      expect(out.exports).toEqual(['area', 'bar', 'donut', 'line', 'scatter', 'validate']);\n      expect(out.codes).toEqual(['AX103']);\n      expect(out.document).toBe('undefined');\n    });\n  }\n});\n","exit_code":0,"status":"completed"}}
