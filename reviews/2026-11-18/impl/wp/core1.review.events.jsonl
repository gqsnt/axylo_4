n true;\n   168\t}\npackages/axylo/src/core/options.ts\n     1\t/**\n     2\t * The options a chart currently holds, and the patch rule of the commit contract (plan 1.5): a key present in\n     3\t * a patch replaces the old value whole, a key set to `undefined` returns to its default (it is removed, and\n     4\t * resolution supplies the default), and absent keys stay. No deep merging.\n     5\t */\n     6\t\n     7\texport type OptionRecord = Readonly<Record<string, unknown>>;\n     8\t\n     9\t/** Keys the controller reads itself and never passes to option resolution. */\n    10\texport const INTERNAL_KEYS: readonly string[] = ['__renderer'];\n    11\t\n    12\texport interface Patched {\n    13\t  readonly next: OptionRecord;\n    14\t  /** Keys whose value is no longer the same object or primitive. */\n    15\t  readonly changed: ReadonlySet<string>;\n    16\t}\n    17\t\n    18\t/** Applies a patch to `current` without changing it. */\n    19\texport function applyPatch(current: OptionRecord, patch: unknown): Patched {\n    20\t  const next: Record<string, unknown> = { ...current };\n    21\t  const changed = new Set<string>();\n    22\t  if (patch === null || typeof patch !== 'object') return { next, changed };\n    23\t  for (const key of Object.keys(patch)) {\n    24\t    if (INTERNAL_KEYS.includes(key)) continue;\n    25\t    const value = (patch as Record<string, unknown>)[key];\n    26\t    const had = Object.hasOwn(current, key);\n    27\t    if (value === undefined) {\n    28\t      if (had) {\n    29\t        delete next[key];\n    30\t        changed.add(key);\n    31\t      }\n    32\t      continue;\n    33\t    }\n    34\t    if (!had || !Object.is(current[key], value)) changed.add(key);\n    35\t    next[key] = value;\n    36\t  }\n    37\t  return { next, changed };\n    38\t}\n    39\t\n    40\t/** Holds the accepted options. A rejected call never reaches `commit`, so the store stays on the last valid state. */\n    41\texport class OptionsStore {\n    42\t  private value: OptionRecord;\n    43\t\n    44\t  constructor(initial: unknown) {\n    45\t    this.value = applyPatch({}, initial).next;\n    46\t  }\n    47\t\n    48\t  get current(): OptionRecord {\n    49\t    return this.value;\n    50\t  }\n    51\t\n    52\t  /** What `patch` would give, without accepting it. */\n    53\t  preview(patch: unknown): Patched {\n    54\t    return applyPatch(this.value, patch);\n    55\t  }\n    56\t\n    57\t  commit(next: OptionRecord): void {\n    58\t    this.value = next;\n    59\t  }\n    60\t}\n    61\t\n    62\t/**\n    63\t * Structural equality for option values that describe encoding (field specs, domains, references): plain\n    64\t * objects and arrays by content, functions and everything else by identity. Data is never compared this way.\n    65\t */\n    66\texport function sameValue(a: unknown, b: unknown): boolean {\n    67\t  if (Object.is(a, b)) return true;\n    68\t  if (a instanceof Date && b instanceof Date) return a.getTime() === b.getTime();\n    69\t  if (Array.isArray(a) && Array.isArray(b)) {\n    70\t    return a.length === b.length && a.every((item, i) => sameValue(item, b[i]));\n    71\t  }\n    72\t  if (isPlain(a) && isPlain(b)) {\n    73\t    const keys = Object.keys(a);\n    74\t    if (keys.length !== Object.keys(b).length) return false;\n    75\t    return keys.every(key => Object.hasOwn(b, key) && sameValue(a[key], b[key]));\n    76\t  }\n    77\t  return false;\n    78\t}\n    79\t\n    80\tfunction isPlain(value: unknown): value is Record<string, unknown> {\n    81\t  if (value === null || typeof value !== 'object') return false;\n    82\t  const proto = Object.getPrototypeOf(value) as unknown;\n    83\t  return proto === Object.prototype || proto === null;\n    84\t}\npackages/axylo/src/core/environment.ts\n     1\t/**\n     2\t * The browser inputs that output depends on besides options and data (contracts: Environment), and the\n     3\t * watchers that say when one of