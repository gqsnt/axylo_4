wn[]): void;\n    16\t}\n    17\t\n    18\t/** Codes already printed, per page. The key is the document in a browser, any object in tests. */\n    19\tconst printed = new WeakMap<object, Set<string>>();\n    20\tconst fallbackPage = {};\n    21\t\n    22\texport interface DeliveryOptions {\n    23\t  readonly console: DeliveryConsole | null;\n    24\t  readonly development: boolean;\n    25\t  /** The page the once-per-code rule applies to. */\n    26\t  readonly page: object | null;\n    27\t}\n    28\t\n    29\texport type DiagnosticListener = (diagnostic: Diagnostic) => void;\n    30\t\n    31\texport function format(d: Diagnostic): string {\n    32\t  return `[axylo ${d.code}] ${JSON.stringify(d.chart)}: ${d.message}`;\n    33\t}\n    34\t\n    35\t/** Identity of a diagnostic for \"is this one new\": the same finding found again is not delivered twice. */\n    36\texport function diagnosticKey(d: Pick<Diagnostic, 'code' | 'field' | 'message'>): string {\n    37\t  return `${d.code}\\u0000${d.field ?? ''}\\u0000${d.message}`;\n    38\t}\n    39\t\n    40\texport class Delivery {\n    41\t  private listenerFailed = false;\n    42\t\n    43\t  constructor(private readonly options: DeliveryOptions) {}\n    44\t\n    45\t  /** Prints and hands to the listener the diagnostics in `found` that are not in `before`. */\n    46\t  deliver(found: readonly Diagnostic[], before: readonly Diagnostic[], listener: DiagnosticListener | null): void {\n    47\t    const known = new Set(before.map(diagnosticKey));\n    48\t    for (const d of found) {\n    49\t      if (known.has(diagnosticKey(d))) continue;\n    50\t      known.add(diagnosticKey(d));\n    51\t      this.print(d);\n    52\t      if (listener) this.call(listener, d);\n    53\t    }\n    54\t  }\n    55\t\n    56\t  print(d: Diagnostic): void {\n    57\t    const out = this.options.console;\n    58\t    if (!out) return;\n    59\t    if (d.level === 'hint' && !this.options.development) return;\n    60\t    const page