67\tfunction same(a: FigureModel, b: FigureModel): boolean {\n   168\t  return a.compact === b.compact && a.labelledBy === b.labelledBy && a.name === b.name && a.subtitle === b.subtitle &&\n   169\t    a.summary === b.summary && a.summaryVisible === b.summaryVisible && a.note === b.note && a.message === b.message &&\n   170\t    (a.title === b.title || (a.title !== null && b.title !== null && a.title.text === b.title.text &&\n   171\t      a.title.level === b.title.level && a.title.visible === b.title.visible));\n   172\t}\npackages/axylo/src/dom/pointer.ts\n     1\t/**\n     2\t * Pointer input over the plot, as plot-container coordinates. Deciding what is under the pointer and\n     3\t * showing it are the caller's; this only reports where the pointer is and when it left.\n     4\t */\n     5\timport type { PickTarget } from '../core/contracts';\n     6\t\n     7\texport interface PointerHandlers {\n     8\t  move(x: number, y: number): void;\n     9\t  leave(): void;\n    10\t}\n    11\t\n    12\texport function watchPointer(plot: HTMLElement, handlers: PointerHandlers): () => void {\n    13\t  const onMove = (event: PointerEvent): void => {\n    14\t    const box = plot.getBoundingClientRect();\n    15\t    handlers.move(event.clientX - box.left, event.clientY - box.top);\n    16\t  };\n    17\t  const onLeave = (): void => handlers.leave();\n    18\t  plot.addEventListener('pointermove', onMove);\n    19\t  plot.addEventListener('pointerleave', onLeave);\n    20\t  plot.addEventListener('pointercancel', onLeave);\n    21\t  return () => {\n    22\t    plot.removeEventListener('pointermove', onMove);\n    23\t    plot.removeEventListener('pointerleave', onLeave);\n    24\t    plot.removeEventListener('pointercancel', onLeave);\n    25\t  };\n    26\t}\n    27\t\n    28\t/** Two pick results name the same thing, so the tooltip need not be rebuilt. */\n    29\texport function sameTarget(a: PickTarget | null, b: PickTarget | null): boolean {\n    30\t  if (a === null || b === null) return a === b;\n    31\t  if (a.kind === 'x' && b.kind === 'x') return a.x === b.x;\n    32\t  if (a.kind === 'slice' && b.kind === 'slice') return a.sliceKey === b.sliceKey;\n    33\t  if (a.kind === 'point' && b.kind === 'point') {\n    34\t    return a.count === b.count && a.refs.length === b.refs.length && a.refs.every((r, i) => {\n    35\t      const o = b.refs[i]!;\n    36\t      return r.kind === 'point' && o.kind === 'point' && r.seriesKey === o.seriesKey && r.row === o.row && r.x === o.x;\n    37\t    });\n    38\t  }\n    39\t  return false;\n    40\t}\npackages/axylo/src/dom/tooltip.ts\n     1\t/**\n     2\t * Renders a tooltip model as text (spec I1, DX8: textContent only). It does not decide what is active; the\n     3\t * pointer module and, later, the keyboard decide, and both hand a model and an anchor point to `show`.\n     4\t */\n     5\timport type { TooltipModel } from '../core/contracts';\n     6\t\n     7\texport interface TooltipView {\n     8\t  /** Shows `model` near (x, y), in CSS px relative to the figure, kept inside the figure where it fits. */\n     9\t  show(model: TooltipModel, x: number, y: number, moreRows: (count: number) => string): void;\n    10\t  hide(): void;\n    11\t  readonly visible: boolean;\n    12\t}\n    13\t\n    14\tconst OFFSET = 12;\n    15\t\n    16\texport function createTooltip(element: HTMLElement, container: HTMLElement): TooltipView {\n    17\t  const doc = element.ownerDocument;\n    18\t  let visible = false;\n    19\t  return {\n    20\t    get visible() {\n    21\t      return visible;\n    22\t    },\n    23\t    show(model, x, y, moreRows) {\n    24\t      const heading = doc.createElement('div');\n    25\t      heading.className = 'axylo-tooltip-title';\n    26\t      heading.textContent = model.title;\n    27\t      const rows: HTMLElement[] = [heading];\n    28\t      for (const row of model.rows) {\n    29\t        const line = doc.createElement('div');\n    30\t        line.className = 'axylo-tooltip-row';\n    31\t        const name = doc.createElement('span');\n    32\t        name.className = 'axylo-tooltip-series';\n    33\t        name.textContent = row.seriesLabel;\n    34\t        const value = doc.createElement('span');\n    35\t        value.className = 'axylo-tooltip-value';\n    36\t        value.textContent = row.percent === null ? row.value : `${row.value} (${row.percent})`;\n    37\t        line.append(name, value);\n    38\t        rows.push(line);\n    39\t      }\n    40\t      if (model.count > model.rows.length) {\n    41\t        const more = doc.createElement('div');\n    42\t        more.textContent = moreRows(model.count - model.rows.length);\n    43\t        rows.push(more);\n    44\t      }\n    45\t      if (model.total !== null) {\n    46\t        const total = doc.createElement('div');\n    47\t        total.className = 'axylo-tooltip-total';\n    48\t        total.textContent = model.total;\n    49\t        rows.push(total);\n    50\t      }\n    51\t      element.replaceChildren(...rows);\n    52\t      element.hidden = false;\n    53\t      visible = true;\n    54\t      // Right of and below the pointer, flipped to the other side when it would leave the figure.\n    55\t      const width = element.offsetWidth;\n    56\t      const height = element.offsetHeight;\n    57\t      const room = container.clientWidth;\n    58\t      const left = x + OFFSET + width <= room ? x + OFFSET : Math.max(0, x - OFFSET - width);\n    59\t      const top = Math.max(0, y + OFFSET + height <= container.clientHeight ? y + OFFSET : y - OFFSET - height);\n    60\t      element.style.transform = `translate(${Math.round(left)}px, ${Math.round(top)}px)`;\n    61\t    },\n    62\t    hide() {\n    63\t      if (!visible) return;\n    64\t      visible = false;\n    65\t      element.hidden = true;\n    66\t      element.replaceChildren();\n    67\t    },\n    68\t  };\n    69\t}\npackages/axylo/src/theme/css.ts\n     1\t/**\n     2\t * The library's default stylesheet as a string. `ensureStyles` adopts it as a constructable stylesheet; the\n     3\t * build writes the same string to dist/axylo.css for pages that prefer to load it themselves.\n     4\t *\n     5\t * Everything sits in the `axylo` cascade layer so that any unlayered rule of the page wins over a default\n     6\t * without a specificity contest, whichever order the sheets arrive in.\n     7\t *\n     8\t * Token scheme: the sheet sets only private defaults (`--axylo-default-axis`, `--axylo-default-series-1`, …)\n     9\t * on `.axylo`. The public names (`--axylo-axis`, `--axylo-series-1`, `--axylo-background`, `--axylo-text`,\n    10\t * `--axylo-font-family`, …) are never set outside forced colors, so an author may set them anywhere,\n    11\t * including `:root`, and inheritance carries them in. Every use reads `var(--axylo-x, var(--axylo-default-x))`.\n    12\t *\n    13\t * Things this sheet must never do, because scheme detection (spec L4) reads them from the chart root: set\n    14\t * `color-scheme` or `color` on `.axylo`, or set `--axylo-background` outside forced colors.\n    15\t *\n    16\t * Component selectors are scoped beneath `.axylo`, so a page's own `.axylo-text` is left alone.\n    17\t */\n    18\timport { DARK, LIGHT, type SchemeColors } from './palette';\n    19\t\n    20\tfunction tokens(c: SchemeColors): string {\n    21\t  const series = c.series.map((v, i) => `    --axylo-default-series-${i + 1}: ${v};`).join('\\n');\n    22\t  return `${series}\n    23\t    --axylo-default-background: ${c.background};\n    24\t    --axylo-default-axis: ${c.axis};\n    25\t    --axylo-default-grid: ${c.grid};\n    26\t    --axylo-default-muted: ${c.muted};\n    27\t    --axylo-default-reference: ${c.reference};\n    28\t    --axylo-default-focus: ${c.focus};`;\n    29\t}\n    30\t\n    31\t// Forced colors: every paint becomes a system color. `!important` so an author's custom property, whether\n    32\t// inherited or set on the chart, cannot leak a brand color into a mode where the user chose the colors.\n    33\t// `--axylo-forced-series` switches off the author's pinned series colors (resolveTheme writes each as\n    34\t// `var(--axylo-forced-series, <author color>)` on the chart root), so they return when forced colors ends.\n    35\tconst forced = [\n    36\t  ...LIGHT.series.map((_, i) => `    --axylo-series-${i + 1}: CanvasText !important;`),\n    37\t  '    --axylo-forced-series: CanvasText !important;',\n    38\t  '    --axylo-background: Canvas !important;',\n    39\t  '    --axylo-default-background: Canvas !important;',\n    40\t  '    --axylo-text: CanvasText !important;',\n    41\t  '    --axylo-axis: CanvasText !important;',\n    42\t  '    --axylo-grid: GrayText !important;',\n    43\t  '    --axylo-muted: GrayText !important;',\n    44\t  '    --axylo-reference: CanvasText !important;',\n    45\t  '    --axylo-focus: Highlight !important;',\n    46\t].join('\\n');\n    47\t\n    48\texport const AXYLO_CSS = `/* Axylo default stylesheet */\n    49\t@layer axylo {\n    50\t  /* Lets ensureStyles find this sheet; it checks the sheet's effect as well, not only this sentinel. */\n    51\t  :root { --axylo-stylesheet: loaded; }\n    52\t\n    53\t  /* tokens: private defaults, light set */\n    54\t  .axylo {\n    55\t${tokens(LIGHT)}\n    56\t  }\n    57\t\n    58\t  /* tokens: private defaults, dark set, selected by the scheme the chart resolved */\n    59\t  .axylo[data-axylo-scheme=\"dark\"] {\n    60\t${tokens(DARK)}\n    61\t  }\n    62\t\n    63\t  @media (forced-colors: active) {\n    64\t    .axylo {\n    65\t${forced}\n    66\t    }\n    67\t  }\n    68\t\n    69\t  /* marks */\n    70\t  .axylo .axylo-svg, .axylo .axylo-canvas { position: absolute; left: 0; top: 0; display: block; pointer-events: none; }\n    71\t  .axylo .axylo-svg { overflow: hidden; }\n    72\t  .axylo .axylo-canvas > canvas { position: absolute; left: 0; top: 0; display: block; }\n    73\t\n    74\t  /*\n    75\t   * Dash patterns of the SVG renderer. Each dashed element carries its normal pattern inline and both\n    76\t   * patterns as custom properties; this switch needs no redraw (spec A5).\n    77\t   */\n    78\t  @media (prefers-contrast: more), (forced-colors: active) {\n    79\t    .axylo .axylo-svg .axylo-dashed { stroke-dasharray: var(--axylo-dash-contrast, none) !important; }\n    80\t  }\n    81\t\n    82\t  /*\n    83\t   * text layer: real HTML text, so it inherits the page font, honours text spacing and forced colors.\n    84\t   * Typography custom properties (spec DX6): --axylo-font-family, --axylo-font-size, --axylo-font-weight,\n    85\t   * --axylo-line-height, --axylo-letter-spacing. Unset, each inherits from the page. Layout measures with\n    86\t   * this layer's computed font, so the same values reach measurement.\n    87\t   */\n    88\t  .axylo .axylo-text {\n    89\t    position: absolute;\n    90\t    inset: 0;\n    91\t    pointer-events: none;\n    92\t    color: var(--axylo-text, currentColor);\n    93\t    font-family: var(--axylo-font-family, inherit);\n    94\t    font-size: var(--axylo-font-size, max(12px, 1em));\n    95\t    font-weight: var(--axylo-font-weight, inherit);\n    96\t    line-height: var(--axylo-line-height, inherit);\n    97\t    letter-spacing: var(--axylo-letter-spacing, inherit);\n    98\t    white-space: nowrap;\n    99\t  }\n   100\t  .axylo .axylo-text > .axylo-label { position: absolute; left: 0; top: 0; transform-origin: 0 0; white-space: pre; }\n   101\t  .axylo .axylo-text > .axylo-label > div { display: block; }\n   102\t}\n   103\t\n   104\t/* structure: added by the figure module (inside \"@layer axylo { … }\") */\n   105\t@layer axylo {\n   106\t  .axylo [hidden] { display: none !important; }\n   107\t  .axylo-visually-hidden {\n   108\t    position: absolute !important; width: 1px !important; height: 1px !important; margin: -1px !important;\n   109\t    padding: 0 !important; border: 0 !important; overflow: hidden !important; clip-path: inset(50%) !important;\n   110\t    white-space: nowrap !important;\n   111\t  }\n   112\t  /* The figure fills a container that has a definite height; otherwise it is as tall as its content. */\n   113\t  .axylo-figure {\n   114\t    position: relative; display: flex; flex-direction: column; box-sizing: border-box;\n   115\t    margin: 0; padding: 0; height: 100%; min-width: 0; min-height: 0;\n   116\t  }\n   117\t  .axylo-caption { flex: none; margin: 0 0 0.5em; min-width: 0; }\n   118\t  .axylo-caption:has(> :not([hidden]):not(.axylo-visually-hidden)) { margin-bottom: 0.5em; }\n   119\t  .axylo-caption:not(:has(> :not([hidden]):not(.axylo-visually-hidden))) { margin: 0; }\n   120\t  .axylo-title { font-weight: 600; font-size: 1.125em; line-height: 1.3; overflow-wrap: anywhere; }\n   121\t  .axylo-subtitle { margin: 0.125em 0 0; font-size: max(12px, 0.875em); color: var(--axylo-muted, var(--axylo-default-muted)); overflow-wrap: anywhere; }\n   122\t  .axylo-summary { margin: 0.25em 0 0; font-size: max(12px, 0.875em); }\n   123\t  /*\n   124\t   * The plot takes what the caption and note leave. Its content is a spacer that is 16:9 of its width,\n   125\t   * clamped to 160–480 px (spec L3): that is its height when the container has none of its own, and only\n   126\t   * its starting size when it does (flex then grows or shrinks it to fit).\n   127\t   */\n   128\t  .axylo-plot { position: relative; flex: 1 1 auto; min-height: 0; min-width: 0; overflow: hidden; }\n   129\t  .axylo-plot::before { content: \"\"; display: block; width: 100%; aspect-ratio: 16 / 9; min-height: 160px; max-height: 480px; }\n   130\t  .axylo-compact .axylo-plot::before { aspect-ratio: auto; min-height: 0; max-height: none; height: 32px; }\n   131\t  .axylo-message {\n   132\t    position: absolute; inset: 0; margin: 0; padding: 8px; box-sizing: border-box;\n   133\t    display: flex; align-items: center; justify-content: center; text-align: center;\n   134\t    font-size: max(12px, 1em); color: var(--axylo-muted, var(--axylo-default-muted)); overflow-wrap: anywhere;\n   135\t  }\n   136\t  .axylo-corner {\n   137\t    position: absolute; top: 0; right: 0; padding: 0 2px; font-size: 12px; line-height: 1;\n   138\t    color: var(--axylo-text, currentColor); pointer-events: none;\n   139\t  }\n   140\t  .axylo-note { flex: none; margin: 0.5em 0 0; font-size: max(12px, 0.875em); }\n   141\t  .axylo-tooltip {\n   142\t    position: absolute; left: 0; top: 0; z-index: 1; pointer-events: none; box-sizing: border-box;\n   143\t    max-width: min(320px, 100%); padding: 4px 8px; border: 1px solid var(--axylo-axis, var(--axylo-default-axis)); border-radius: 4px;\n   144\t    background: var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background))); color: var(--axylo-text, currentColor);\n   145\t    font-size: max(12px, 0.875em); line-height: 1.4;\n   146\t  }\n   147\t  .axylo-tooltip-title { font-weight: 600; }\n   148\t  .axylo-tooltip-row { display: flex; gap: 1em; justify-content: space-between; }\n   149\t  .axylo-tooltip-value { font-variant-numeric: tabular-nums; white-space: nowrap; }\n   150\t}\n   151\t`;\n","exit_code":0,"status":"completed"}}
