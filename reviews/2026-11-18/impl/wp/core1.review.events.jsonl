{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc 'cat vitest.config.ts tsconfig.base.json packages/axylo/tsconfig.json docs/api/tsconfig.json && cat packages/axylo/test/core/*.ts'","aggregated_output":"import { defineConfig } from 'vitest/config';\n\n// Unit and property tests run in Node. Browser tests (*.browser.test.ts) drive system Chrome through\n// Playwright against the built bundle: run `npm run build` first, then `npm run test:browser`.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    include: process.env.AXYLO_BROWSER ? ['packages/*/test/**/*.browser.test.ts'] : ['packages/*/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 10000,\n    fileParallelism: !process.env.AXYLO_BROWSER,\n  },\n});\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"strict\": true,\n    \"noUncheckedIndexedAccess\": true,\n    \"exactOptionalPropertyTypes\": false,\n    \"noImplicitOverride\": true,\n    \"noFallthroughCasesInSwitch\": true,\n    \"isolatedModules\": true,\n    \"verbatimModuleSyntax\": true,\n    \"skipLibCheck\": true,\n    \"declaration\": true,\n    \"types\": [\n      \"node\"\n    ]\n  }\n}\n{ \"extends\": \"../../tsconfig.base.json\", \"compilerOptions\": { \"rootDir\": \".\", \"outDir\": \"dist/types\" }, \"include\": [\"src\", \"test\"] }\n{ \"compilerOptions\": { \"strict\": true, \"noEmit\": true, \"target\": \"ES2022\", \"module\": \"ESNext\", \"moduleResolution\": \"Bundler\", \"lib\": [\"ES2022\", \"DOM\"], \"skipLibCheck\": false }, \"include\": [\"examples.ts\", \"axylo.d.ts\"] }\nimport { describe, expect, it } from 'vitest';\nimport { Delivery, StrictError, strictViolations } from '../../src/core/delivery';\nimport { createDiagnostic } from '../../src/diagnostics';\nimport type { Diagnostic } from '../../src/public';\n\nfunction recorder() {\n  const lines: { channel: 'warn' | 'info' | 'error'; text: string }[] = [];\n  return {\n    lines,\n    console: {\n      warn: (...a: unknown[]) => lines.push({ channel: 'warn', text: String(a[0]) }),\n      info: (...a: unknown[]) => lines.push({ channel: 'info', text: String(a[0]) }),\n      error: (...a: unknown[]) => lines.push({ channel: 'error', text: String(a[0]) }),\n    },\n  };\n}\n\nconst publicOf = (code: Parameters<typeof createDiagnostic>[0], field?: string, chart = 'Chart'): Diagnostic => {\n  const { effect: _e, origin: _o, ...d } = createDiagnostic(code, 'none', field === undefined ? {} : { field });\n  return { ...d, chart };\n};\n\n// Spec 3.5: errors and warnings print once per code per page in every build; hints only in development.\ndescribe('diagnostic delivery (spec 3.5)', () => {\n  it('prints an error or warning once per code per page, whatever chart raised it', () => {\n    const out = recorder();\n    const page = {};\n    const a = new Delivery({ console: out.console, development: false, page });\n    const b = new Delivery({ console: out.console, development: false, page });\n    a.deliver([publicOf('AX103', 'v', 'A')], [], null);\n    b.deliver([publicOf('AX103', 'w', 'B')], [], null);\n    a.deliver([publicOf('AX101', 'x', 'A')], [], null);\n    expect(out.lines.map(l => [l.channel, l.text.slice(0, 13)])).toEqual([['warn', '[axylo AX103]'], ['warn', '[axylo AX101]']]);\n    // Another page prints it again.\n    new Delivery({ console: out.console, development: false, page: {} }).deliver([publicOf('AX103', 'v')], [], null);\n    expect(out.lines).toHaveLength(3);\n  });\n\n  it('prints hints only in development builds', () => {\n    const prod = recorder();\n    new Delivery({ console: prod.console, development: false, page: {} }).deliver([publicOf('AX111', 'day')], [], null);\n    expect(prod.lines).toEqual([]);\n    const dev = recorder();\n    new Delivery({ console: dev.console, development: true, page: {} }).deliver([publicOf('AX111', 'day')], [], null);\n    expect(dev.lines.map(l => l.channel)).toEqual(['info']);\n  });\n\n  it('names the chart and the code in the printed line', () => {\n    const out = recorder();\n    new Delivery({ console: out.console, development: true, page: {} }).deliver([publicOf('AX140', undefined, 'Daily sessions')], [], null);\n    expect(out.lines[0]!.text).toMatch(/^\\[axylo AX140\\] \"Daily sessions\": /);\n  });\n\n  it('hands every new diagnostic to onDiagnostic, in production too, and not the same one twice', () => {\n    const seen: string[] = [];\n    const d = new Delivery({ console: recorder().console, development: false, page: {} });\n    const first = [publicOf('AX103', 'v'), publicOf('AX111', 'day')];\n    d.deliver(first, [], x => seen.push(x.code));\n    d.deliver(first, first, x => seen.push(x.code));\n    expect(seen).toEqual(['AX103', 'AX111']);\n  });\n\n  it('survives a listener that throws, and says so once', () => {\n    const out = recorder();\n    const d = new Delivery({ console: out.console, development: false, page: {} });\n    const boom = () => { throw new Error('author bug'); };\n    d.deliver([publicOf('AX103', 'v')], [], boom);\n    d.deliver([publicOf('AX106', 'v')], [], boom);\n    expect(out.lines.filter(l => l.channel === 'error')).toHaveLength(1);\n  });\n});\n\ndescribe('strict (spec 3.5)', () => {\n  it('throws on errors and warnings found while validating the call, never on hints or presentation findings', () => {\n    const call = [createDiagnostic('AX103', 'omitted', { field: 'v' }), createDiagnostic('AX111', 'none', { field: 'd' })];\n    expect(strictViolations(call).map(d => d.code)).toEqual(['AX103']);\n    const later = [createDiagnostic('AX141', 'none', {}, 'presentation'), createDiagnostic('AX160', 'changed', { field: 'v' }, 'presentation')];\n    expect(strictViolations(later)).toEqual([]);\n  });\n\n  it('carries every diagnostic of the rejected call', () => {\n    const list = [publicOf('AX111', 'd'), publicOf('AX103', 'v')];\n    const error = new StrictError('Chart', list);\n    expect(error.diagnostics).toBe(list);\n    expect(error.message).toMatch(/AX103/);\n  });\n});\nimport { describe, expect, it } from 'vitest';\nimport fc from 'fast-check';\nimport { applyPatch, OptionsStore, sameValue } from '../../src/core/options';\n\n// Plan 1.5, \"Patches\": a key present replaces the old value whole; a key set to undefined returns to its\n// default; absent keys stay. No deep merging.\ndescribe('option patches (plan 1.5)', () => {\n  it('replaces a present key whole, without merging nested objects', () => {\n    const store = new OptionsStore({ title: { text: 'A', level: 2 }, x: 'day' });\n    const { next } = store.preview({ title: { text: 'B' } });\n    expect(next.title).toEqual({ text: 'B' });\n    expect(next.x).toBe('day');\n  });\n\n  it('removes a key set to undefined, so resolution supplies its default', () => {\n    const store = new OptionsStore({ title: 'A', legend: 'top' });\n    const { next, changed } = store.preview({ legend: undefined });\n    expect(Object.hasOwn(next, 'legend')).toBe(false);\n    expect(changed.has('legend')).toBe(true);\n    expect(next.title).toBe('A');\n  });\n\n  it('leaves absent keys alone and reports only what changed', () => {\n    const data = [{ a: 1 }];\n    const store = new OptionsStore({ data, title: 'A' });\n    const { next, changed } = store.preview({ title: 'A' });\n    expect(next.data).toBe(data);\n    expect([...changed]).toEqual([]);\n  });\n\n  it('does not change the store until commit (a rejected call keeps the last valid state)', () => {\n    const store = new OptionsStore({ title: 'A' });\n    const { next } = store.preview({ title: 'B' });\n    expect(store.current.title).toBe('A');\n    store.commit(next);\n    expect(store.current.title).toBe('B');\n  });\n\n  it('never stores the internal renderer switch', () => {\n    const store = new OptionsStore({ title: 'A', __renderer: 'svg' });\n    expect(Object.hasOwn(store.current, '__renderer')).toBe(false);\n  });\n\n  it('for any patch: present keys equal the patch, undefined keys are gone, absent keys keep their value', () => {\n    const key = fc.constantFrom('a', 'b', 'c', 'd', 'e');\n    const value = fc.oneof(fc.integer(), fc.string(), fc.constant(undefined), fc.record({ n: fc.integer() }));\n    fc.assert(fc.property(fc.dictionary(key, value), fc.dictionary(key, value), (initial, patch) => {\n      const before = applyPatch({}, initial).next;\n      const { next } = applyPatch(before, patch);\n      for (const k of ['a', 'b', 'c', 'd', 'e']) {\n        if (Object.hasOwn(patch, k)) {\n          if (patch[k] === undefined) expect(Object.hasOwn(next, k)).toBe(false);\n          else expect(next[k]).toBe(patch[k]);\n        } else if (Object.hasOwn(before, k)) {\n          expect(next[k]).toBe(before[k]);\n        } else {\n          expect(Object.hasOwn(next, k)).toBe(false);\n        }\n      }\n    }), { numRuns: 1000 });\n  });\n});\n\ndescribe('structural comparison of field specs', () => {\n  it('treats equal inline field objects as the same encoding', () => {\n    expect(sameValue({ field: 'ts', type: 'time' }, { field: 'ts', type: 'time' })).toBe(true);\n    expect(sameValue({ field: 'ts', domain: [1, 2] }, { field: 'ts', domain: [1, 3] })).toBe(false);\n    expect(sameValue(['a', { field: 'b' }], ['a', { field: 'b' }])).toBe(true);\n  });\n\n  it('compares functions by identity', () => {\n    const f = (v: number) => String(v);\n    expect(sameValue({ field: 'y', format: f }, { field: 'y', format: f })).toBe(true);\n    expect(sameValue({ field: 'y', format: f }, { field: 'y', format: (v: number) => String(v) })).toBe(false);\n  });\n});\nimport { describe, expect, it } from 'vitest';\nimport * as Axylo from '../../src/index';\n\nconst days = ['2026-01-05', '2026-01-06', '2026-01-07', '2026-01-08', '2026-01-09', '2026-01-10', '2026-01-11'];\n// The Phase 1 combined dirty fixture (research/harness/src/data.js).\nconst dirty = [10, 20, null, NaN, '40', undefined, 70];\n\ndescribe('the package in Node (spec DX8)', () => {\n  it('imports without a DOM and exports the five chart functions and validate', () => {\n    expect(typeof (globalThis as { document?: unknown }).document).toBe('undefined');\n    for (const name of ['line', 'area', 'bar', 'scatter', 'donut', 'validate'] as const) expect(typeof Axylo[name]).toBe('function');\n  });\n\n  it('validate reports the combined dirty fixture as AX102, AX103 and AX106, once each', () => {\n    const data = days.map((day, i) => (dirty[i] === undefined ? { day } : { day, value: dirty[i] }));\n    for (const type of ['line', 'area', 'bar'] as const) {\n      const codes = Axylo.validate(type, { title: 'Dirty input', data: data as never, x: 'day', y: 'value' as never }).map(d => d.code).sort();\n      expect(codes, type).toEqual(['AX102', 'AX103', 'AX106']);\n    }\n  });\n\n  it('validate works for scatter and donut', () => {\n    const points = [{ a: 1, b: 2 }, { a: 2, b: NaN }];\n    expect(Axylo.validate('scatter', { title: 'S', data: points, x: 'a', y: 'b' }).map(d => d.code)).toEqual(['AX103']);\n    const parts = [{ label: 'Chrome', share: 46.2 }, { label: 'Safari', share: -1 }];\n    expect(Axylo.validate('donut', { title: 'D', data: parts, label: 'label', value: 'share' }).map(d => d.code)).toEqual(['AX120']);\n  });\n\n  it('validate raises AX140 without a title or labelledBy, and AX101 for a misspelled field', () => {\n    const codes = Axylo.validate('line', { data: [{ day: '2026-01-01', value: 1 }], x: 'day', y: 'valeu' as never }).map(d => d.code).sort();\n    expect(codes).toEqual(['AX101', 'AX140']);\n  });\n\n  it('a chart function without a DOM fails with a message, not a crash at import', () => {\n    expect(() => Axylo.line('#nowhere', { 