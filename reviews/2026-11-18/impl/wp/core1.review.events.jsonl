 options.tickFormat ?? null, domain: options.domain ?? null,\n  };\n}\n\nfunction resolveValue(input: unknown, path: string, sink: DiagnosticSink): ResolvedValueField {\n  const options = object(input) as ValueFieldOptions & { parse?: 'number' };\n  unknownKeys(object(input), valueKeys, sink, path);\n  const field = fieldName(input) ?? '';\n  return {\n    field, label: options.label ?? field, unit: options.unit ?? null,\n    scale: literal(options.scale, ['percent', 'ratio'], path + 'scale', sink) ?? null,\n    missing: literal(options.missing, ['gap', 'zero'], path + 'missing', sink) ?? 'gap',\n    parse: literal(options.parse, ['number'], path + 'parse', sink) ?? null, format: options.format ?? null,\n    tickFormat: options.tickFormat ?? null, domain: options.domain ?? null,\n  };\n}\n\nexport function resolveOptions(type: ChartType, input: unknown, sink: DiagnosticSink): ResolvedOptions {\n  const options = object(input);\n  unknownKeys(options, keysForChart[type], sink);\n  unknownKeys(object(options.title), ['text', 'visible', 'level'], sink, 'title.');\n  unknownKeys(object(options.state), ['error', 'empty'], sink, 'state.');\n  unknownKeys(object(options.messages), Object.keys(messageKeys), sink, 'messages.');\n  if (type !== 'donut' && Array.isArray(options.reference)) {\n    options.reference.forEach((reference, row) => {\n      unknownKeys(object(reference), ['x', 'y', 'label'], sink, 'reference[' + row + '].');\n    });\n  }\n\n  const { table, valid: validTable } = resolveTable(options.data, sink);\n  const donut = type === 'donut';\n  const xInput = donut ? options.label : options.x;\n  const x = resolveX(xInput, type, sink);\n  const wide = !donut && Array.isArray(options.y);\n  const supportsWide = type !== 'scatter' && !donut;\n  const valueInputs = wide ? options.y as readonly unknown[] : [donut ? options.value : options.y];\n  const values = valueInputs.map((field, index) =>\n    resolveValue(field, wide ? 'y[' + index + '].' : donut ? 'value.' : 'y.', sink));\n  const series = !wide && !donut && typeof options.series === 'string' ? options.series : null;\n  if (wide && options.series !== undefined) {\n    report(sink, 'AX150', 'none', { field: 'series', count: 1, detail: 'Use a single y field when naming a series field.' });\n  }\n  if (wide && !supportsWide) {\n    report(sink, 'AX150', 'chart-error', { field: 'y', count: 1, detail: 'Use a single y field for scatter charts.' });\n  }\n\n  let valid = validTable && (!wide || supportsWide);\n  const fields: [string | null, string][] = [[fieldName(xInput), donut ? 'label' : 'x']];\n  for (const input of valueInputs) fields.push([fieldName(input), donut ? 'value' : 'y']);\n  if (values.length === 0) fields.push([null, 'y']);\n  if (series !== null) fields.push([series, 'series']);\n  valid = checkFields(table, fields, sink) && valid;\n\n  const title = typeof options.title === 'string' ? options.title : object(options.title).text;\n  const name = typeof title === 'string' && title ? title\n    : typeof options.labelledBy === 'string' && options.labelledBy ? options.labelledBy : type;\n  return { table, x, values, form: wide ? 'wide' : 'long', series, valid, name };\n}\n\nexport function checkFields(table: Table, fields: readonly (readonly [string | null, string])[], sink: DiagnosticSink): boolean {\n  const reported = new Set<string>();\n  for (const [field, role] of fields) {\n    if (field !== null && (table.columns === null && table.length === 0 || table.hasField(field))) continue;\n    const name = field ?? role;\n    if (reported.has(name)) continue;\n    reported.add(name);\n    const keys = table.keys();\n    report(sink, 'AX101', 'chart-error', { field: name, keys, suggestion: field === null ? undefined : closest(name, keys), count: 1 });\n  }\n  return reported.size === 0;\n}\nimport { DiagnosticCollector, report } from '../diagnostics';\nimport type { Diagnostic } from '../public';\nimport { normalize, type DataEnvironment } from './normalize';\nimport { resolveOptions, type ChartType } from './options';\n\nexport function validateOptions(\n  type: ChartType, options: unknown, environment: DataEnvironment = { timeZone: Intl.DateTimeFormat().resolvedOptions().timeZone },\n): readonly Diagnostic[] {\n  const diagnostics = new DiagnosticCollector();\n  let name: string = type;\n  try {\n    const resolved = resolveOptions(type, options, diagnostics);\n    name = resolved.name;\n    normalize(type, resolved, environment, diagnostics, { epoch: 0, revision: 0 });\n  } catch {\n    report(diagnostics, 'AX150', 'chart-error', { detail: 'Supply readable options and data.' });\n  }\n  return diagnostics.list(name);\n}\nimport { SLOT_NO_ROW, type AlignedFrame, type RowSource, type Series, type XColumn } from '../core/contracts';\n\ntype SeriesDescription = Omit<Series, 'y' | 'slot' | 'row'>;\nexport interface SeriesBuffers {\n  description: SeriesDescription;\n  y: Float64Array;\n  slot: Uint8Array;\n  row: Int32Array;\n}\n\nfunction buffers(description: SeriesDescription, capacity: number): SeriesBuffers {\n  return { description, y: new Float64Array(capacity), slot: new Uint8Array(capacity), row: new Int32Array(capacity) };\n}\n\nexport class FrameBuffers {\n  x: Float64Array;\n  observed: Uint8Array;\n  private categoryPositions = new Float64Array();\n  readonly series = new Map<string, SeriesBuffers>();\n  start = 0;\n  end: number;\n  distinct: number;\n\n  constructor(frame: AlignedFrame, positions: Float64Array, order: Int32Array | null) {\n    this.end = frame.length;\n    this.distinct = 0;\n    const capacity = Math.max(16, this.end * 2);\n    this.x = new Float64Array(capacity);\n    this.x.set(frame.x.values);\n    this.observed = new Uint8Array(capacity);\n    let slot = 0;\n    const length = order?.length ?? positions.length;\n    for (let i = 0; i < length; i++) {\n      const x = positions[order?.[i] ?? i]!;\n      while (slot < this.end && this.x[slot]! < x) slot++;\n      if (slot < this.end && this.x[slot] === x && !this.observed[slot]) {\n        this.observed[slot] = 1;\n        this.distinct++;\n      }\n    }\n    for (const { row, slot, y, ...description } of frame.series) {\n      const series = buffers(description, capacity);\n      series.y.set(y);\n      series.slot.set(slot);\n      if (row) series.row.set(row);\n      else for (let i = 0; i < this.end; i++) series.row[i] = i;\n      this.series.set(description.key, series);\n    }\n  }\n\n  reserve(extra: number): boolean {\n    if (this.end + extra <= this.x.length) return false;\n    this.resize(extra);\n    return true;\n  }\n\n  shrink(): void {\n    if (this.x.length > Math.max(32, 4 * (this.end - this.start))) this.resize(0);\n  }\n\n  private resize(extra: number): void {\n    const { start, end } = this;\n    const count = end - start;\n    const capacity = Math.max(16, 2 * (count + extra));\n    const x = new Float64Array(capacity);\n    const observed = new Uint8Array(capacity);\n    x.set(this.x.subarray(start, end));\n    observed.set(this.observed.subarray(start, end));\n    this.x = x;\n    this.observed = observed;\n    if (this.categoryPositions.length > capacity) this.categoryPositions = new Float64Array();\n    for (const [key, previous] of this.series) {\n      const series = buffers(previous.description, capacity);\n      series.y.set(previous.y.subarray(start, end));\n      series.slot.set(previous.slot.subarray(start, end));\n      series.row.set(previous.row.subarray(start, end));\n      this.series.set(key, series);\n    }\n    this.start = 0;\n    this.end = count;\n  }\n\n  copySeries(series: SeriesBuffers): SeriesBuffers {\n    const copy = buffers(series.description, this.x.length);\n    const { start, end } = this;\n    copy.y.set(series.y.subarray(start, end), start);\n    copy.slot.set(series.slot.subarray(start, end), start);\n    copy.row.set(series.row.subarray(start, end), start);\n    this.series.set(series.description.key, copy);\n    return copy;\n  }\n\n  addSeries(description: SeriesDescription, zero: boolean): SeriesBuffers {\n    const series = buffers(description, this.x.length);\n    series.row.fill(-1, this.start, this.end);\n    if (!zero) {\n      series.y.fill(NaN, this.start, this.end);\n      series.slot.fill(SLOT_NO_ROW, this.start, this.end);\n    }\n    this.series.set(description.key, series);\n    return series;\n  }\n\n  trim(keep: number | undefined, evict: (x: number, observed: boolean) => void): void {\n    if (keep === undefined || keep >= this.distinct) return;\n    while (this.start < this.end && (this.distinct > keep || !this.observed[this.start])) {\n      const observed = this.observed[this.start] === 1;\n      if (observed) this.distinct--;\n      evict(this.x[this.start]!, observed);\n      this.start++;\n    }\n  }\n\n  frame(previous: AlignedFrame, axis: XColumn, source: RowSource, open?: (key: string) => boolean): AlignedFrame {\n    const { start, end } = this;\n    let positions = this.x.subarray(start, end);\n    if (axis.kind === 'category' && positions[0]) {\n      if (this.categoryPositions.length < positions.length) {\n        const capacity = Math.max(16, positions.length * 2);\n        this.categoryPositions = Float64Array.from({ length: capacity }, (_, i) => i);\n      }\n      positions = this.categoryPositions.subarray(0, positions.length);\n    }\n    return {\n      ...previous, source, revision: previous.revision, length: end - start,\n      x: {\n        values: positions, kind: axis.kind, dateUnit: axis.dateUnit,\n        timeZone: axis.timeZone, ordered: axis.ordered,\n        get categories() { return axis.kind === 'category' && end === start ? [] : axis.categories; },\n      },\n      series: Array.from(this.series.values(), ({ description, y, slot, row }) => {\n        if (end === start || !open?.(description.key)) {\n          return { ...description, y: y.subarray(start, end), slot: slot.subarray(start, end), row: row.subarray(start, end) };\n        }\n        // The last x may still receive an observation. Copy its older view only if a reader asks for it.\n        const tailY = y[end - 1]!;\n        const tailSlot = slot[end - 1]!;\n        const tailRow = row[end - 1]!;\n        let values: Float64Array | undefined;\n        let states: Uint8Array | undefined;\n        let rows: Int32Array | undefined;\n        return {\n          ...description,\n          get y() {\n            if (!values) {\n              values = y.slice(start, end);\n              values[values.length - 1] = tailY;\n            }\n            return values;\n          },\n          get slot() {\n            if (!states) {\n              states = slot.slice(start, end);\n              states[states.length - 1] = tailSlot;\n            }\n            return states;\n          },\n          get row() {\n            if (!rows) {\n              rows = row.slice(start, end);\n              rows[rows.length - 1] = tailRow;\n            }\n            return rows;\n          },\n        };\n      }),\n    };\n  }\n}\nimport type { RowSource } from '../core/contracts';\nimport { rowValue, type Table } from './table';\n\nexport class StreamRows {\n  private readonly added = new Map<number, unknown>();\n  private readonly columnRows = new Set<number>();\n  private readonly evicted = new Set<number>();\n  private readonly positions = new Map<number, number>();\n  private readonly previousAtPosition = new Map<number, number>();\n  private readonly unplaced = new Map<number, number>();\n  private latestPosition = -Infinity;\n  private original: Table | null;\n  private originalRemaining: number;\n  next: number;\n\n  constructor(table: Table) {\n    this.original = table;\n    this.originalRemaining = table.length;\n    this.next = table.length;\n  }\n\n  record(position: number, row: number): void {\n    if (!Number.isFinite(position)) {\n      this.unplaced.set(row, this.latestPosition);\n      return;\n    }\n    this.latestPosition = Math.max(position, this.latestPosition);\n    const previous = this.positions.get(position);\n    if (previous !== undefined) this.previousAtPosition.set(row, previous);\n    this.positions.set(position, row);\n  }\n\n  resetPositions(table: Table, positions: Float64Array): void {\n    this.positions.clear();\n    this.previousAtPosition.clear();\n    this.unplaced.clear();\n    this.latestPosition = -Infinity;\n    for (let i = 0; i < table.length; i++) this.record(positions[i] ?? NaN, table.rowIndex(i));\n  }\n\n  append(rows: readonly unknown[]): void {\n    for (const row of rows) this.added.set(this.next++, row);\n  }\n\n  forget(row: number): void {\n    if (this.original && row < this.original.length) {\n      this.evicted.add(row);\n      if (--this.originalRemaining === 0) {\n        this.original = null;\n        this.evicted.clear();\n      }\n    } else {\n      this.added.delete(row);\n      this.columnRows.delete(row);\n    }\n  }\n\n  evict(position: number, discard: (row: number, value?: unknown, column?: boolean) => void): void {\n    let row = this.positions.get(position);\n    while (row !== undefined) {\n      const previous = this.previousAtPosition.get(row);\n      this.previousAtPosition.delete(row);\n      this.discard(row, discard);\n      row = previous;\n    }\n    this.positions.delete(position);\n  }\n\n  trimUnplaced(keep: number, first: number, observed: number, discard: (row: number, value?: unknown, column?: boolean) => void): void {\n    // Invalid records need a bounded home even when every new record is unplaceable.\n    const capacity = observed ? 2 * keep : keep;\n    for (const [row, position] of this.unplaced) {\n      if (this.unplaced.size <= capacity && (!observed || position >= first)) break;\n      this.unplaced.delete(row);\n      this.discard(row, discard);\n    }\n  }\n\n  private read(row: number): unknown {\n    if (this.evicted.has(row)) return null;\n    if (this.original && row < this.original.length) return this.original.rowAt(row);\n    return this.added.has(row) ? this.added.get(row) : null;\n  }\n\n  private isColumn(row: number): boolean {\n    return (this.original?.isColumnRow(row) && row < this.original.length) || this.columnRows.has(row);\n  }\n\n  private discard(row: number, discard: (row: number, value?: unknown, column?: boolean) => void): void {\n    discard(row, this.read(row), this.isColumn(row));\n    this.forget(row);\n  }\n\n  compact(keep: number): void {\n    const original = this.original;\n    if (!original || this.originalRemaining > Math.max(keep, 16) || this.originalRemaining * 2 > original.length) return;\n    // A small remaining window should not keep all the caller's original columns alive.\n    for (let row = 0; row < original.length; row++) {\n      if (this.evicted.has(row)) continue;\n      this.added.set(row, original.rowAt(row));\n      if (original.isColumnRow(row)) this.columnRows.add(row);\n    }\n    this.original = null;\n    this.evicted.clear();\n  }\n\n  source(): RowSource {\n    const end = this.next;\n    return { rowAt: row => Number.isInteger(row) && row >= 0 && row < end ? this.read(row) : null };\n  }\n\n  table(incoming: readonly unknown[]): Table {\n    const original = this.original;\n    const originalLength = original?.length ?? 0;\n    const indexes: number[] = [];\n    for (let i = 0; i < originalLength; i++) if (!this.evicted.has(i)) indexes.push(i);\n    for (const row of this.added.keys()) indexes.push(row);\n    if (!original) indexes.sort((a, b) => a - b);\n    const first = this.next;\n    for (let i = 0; i < incoming.length; i++) indexes.push(first + i);\n    const source = this.source();\n    const data = (row: number) => row >= first ? incoming[row - first] : source.rowAt(row);\n    const read = (i: number, field: string): unknown => {\n      const row = indexes[i]!;\n      return original && row < originalLength ? original.read(row, field) : rowValue(data(row), field);\n    };\n    return {\n      length: indexes.length, columns: null, read,\n      rowIndex: i => indexes[i]!,\n      isColumnRow: i => this.isColumn(indexes[i]!),\n      rowAt: i => data(indexes[i]!),\n      hasField: field => indexes.some(row => Object.hasOwn(Object(data(row)), field)),\n      keys: () => [...new Set(indexes.flatMap(row => Object.keys(Object(data(row)))))],\n    };\n  }\n}\n","exit_code":0,"status":"completed"}}
