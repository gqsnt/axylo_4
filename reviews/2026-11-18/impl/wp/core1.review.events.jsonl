hart.__dev.stages();\n    33\t      return { widths, narrow, first, last };\n    34\t    });\n    35\t    expect(result.widths).toEqual([720, 360, 720]);\n    36\t    expect(result.narrow).toBeLessThanOrEqual(361);\n    37\t    expect(result.last.layout - result.first.layout).toBe(2);\n    38\t    expect(result.last.normalize).toBe(result.first.normalize);\n    39\t    expect(result.last.options).toBe(result.first.options);\n    40\t    expect(await closePage(page)).toEqual([]);\n    41\t  });\n    42\t\n    43\t  it('a container created with display: none draws once shown', async () => {\n    44\t    const page = await chartPage({ css: '#chart { display: none; }' });\n    45\t    const result = await page.evaluate(async () => {\n    46\t      const chart = window.Axylo.line!('#chart', { title: 'Hidden', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    47\t      let ready = false;\n    48\t      void chart.__bench.ready().then(() => { ready = true; });\n    49\t      await window.nextFrames(3);\n    50\t      const hidden = { ready, draws: chart.__dev.stages().draw };\n    51\t      document.getElementById('chart')!.style.display = 'block';\n    52\t      await chart.__bench.ready();\n    53\t      await window.nextFrames(2);\n    54\t      return { hidden, draws: chart.__dev.stages().draw, labels: document.querySelectorAll('#chart .axylo-label').length };\n    55\t    });\n    56\t    expect(result.hidden).toEqual({ ready: false, draws: 0 });\n    57\t    expect(result.draws).toBe(1);\n    58\t    expect(result.labels).toBeGreaterThan(3);\n    59\t    expect(await closePage(page)).toEqual([]);\n    60\t  });\n    61\t\n    62\t  it('a height: auto container gets a 16:9 plot, clamped to 160–480 px, stable over 10 frames', async () => {\n    63\t    const page = await chartPage({ css: '#chart { height: auto; } .w { height: auto; }' });\n    64\t    const result = await page.evaluate(async () => {\n    65\t      const chart = window.Axylo.line!('#chart', { title: 'Auto', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    66\t      await chart.__bench.ready();\n    67\t      const plot = document.querySelector('#chart .axylo-plot')!;\n    68\t      const heights: number[] = [];\n    69\t      const layouts: number[] = [];\n    70\t      for (let i = 0; i < 10; i++) {\n    71\t        await window.nextFrames(1);\n    72\t        heights.push(plot.getBoundingClientRect().height);\n    73\t        layouts.push(chart.__dev.stages().layout);\n    74\t      }\n    75\t      const clamp: number[] = [];\n    76\t      for (const width of [200, 1200]) {\n    77\t        const el = Object.assign(document.body.appendChild(document.createElement('div')), { className: 'w' });\n    78\t        el.style.width = `${width}px`;\n    79\t        const c = window.Axylo.line!(el, { title: 'W', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    80\t        await c.__bench.ready();\n    81\t        clamp.push(el.querySelector('.axylo-plot')!.getBoundingClientRect().height);\n    82\t      }\n    83\t      return { heights, layouts, clamp };\n    84\t    });\n    85\t    expect(new Set(result.heights).size).toBe(1);\n    86\t    expect(result.heights[0]).toBeCloseTo(720 * 9 / 16, 0);\n    87\t    expect(new Set(result.layouts).size).toBe(1);\n    88\t    expect(result.clamp).toEqual([160, 480]);\n    89\t    expect(await closePage(page)).toEqual([]);\n    90\t  });\n    91\t\n    92\t  it('a definite container height is filled: the plot takes what the caption leaves', async () => {\n    93\t    const page = await chartPage({ css: '#chart { height: 300px; }' });\n    94\t    const result = await page.evaluate(async () => {\n    95\t      const chart = window.Axylo.line!('#chart', { title: 'Fixed', subtitle: 'Subtitle', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    96\t      await chart.__bench.ready();\n    97\t      const root = document.getElementById('chart')!.getBoundingClientRect();\n    98\t      const fig = document.querySelector('#chart figure')!.getBoundingClientRect();\n    99\t      const plot = document.querySelector('#chart .axylo-plot')!.getBoundingClientRect();\n   100\t      return { root: root.bottom, fig: fig.bottom, plot: plot.bottom, plotHeight: plot.height };\n   101\t    });\n   102\t    expect(result.fig).toBeCloseTo(result.root, 0);\n   103\t    expect(result.plot).toBeCloseTo(result.root, 0);\n   104\t    expect(result.plotHeight).toBeLessThan(300);\n   105\t    expect(await closePage(page)).toEqual([]);\n   106\t  });\n   107\t});\n   108\t\n   109\tdescribe('commit contract (plan 1.5, spec DX5)', () => {\n   110\t  it('update({ data }), append and zoom in one turn are drawn once and end in the expected state', async () => {\n   111\t    const page = await chartPage();\n   112\t    const result = await page.evaluate(async () => {\n   113\t      const DAY = 864e5;\n   114\t      const rows = (from: number, n: number) => Array.from({ length: n }, (_, i) => ({ day: from + i * DAY, v: i }));\n   115\t      const t0 = Date.UTC(2026, 0, 1);\n   116\t      const chart = window.Axylo.line!('#chart', { title: 'Seq', data: rows(t0, 30), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   117\t      await chart.__bench.ready();\n   118\t      const before = chart.__dev.stages();\n   119\t      const replaced = rows(t0 + 100 * DAY, 10);\n   120\t      chart.update({ data: replaced });\n   121\t      chart.append([{ day: t0 + 110 * DAY, v: 10 }, { day: t0 + 111 * DAY, v: 11 }]);\n   122\t      chart.zoom([new Date(t0 + 105 * DAY), new Date(t0 + 111 * DAY)]);\n   123\t      const sync = chart.__dev.stages();\n   124\t      await chart.__bench.ready();\n   125\t      await window.nextFrames(2);\n   126\t      const after = chart.__dev.stages();\n   127\t      return { before, sync, after, describe: chart.__bench.describe(), t0, DAY };\n   128\t    });\n   129\t    const { before, sync, after, describe, t0, DAY } = result;\n   130\t    expect(sync.draw).toBe(before.draw);\n   131\t    expect(after.draw - before.draw).toBe(1);\n   132\t    expect(after.frame - before.frame).toBe(1);\n   133\t    expect(describe.series[0]!.points).toBe(12);\n   134\t    expect(describe.series[0]!.oldestX).toBe(t0 + 100 * DAY);\n   135\t    expect(describe.series[0]!.newestX).toBe(t0 + 111 * DAY);\n   136\t    expect(describe.xDomain).toEqual([t0 + 105 * DAY, t0 + 111 * DAY]);\n   137\t    expect(await closePage(page)).toEqual([]);\n   138\t  });\n   139\t\n   140\t  it('append with keep keeps that many x values, and a window zoomed to the latest edge follows', async () => {\n   141\t    const page = await chartPage();\n   142\t    const result = await page.evaluate(async () => {\n   143\t      const t0 = Date.UTC(2026, 0, 1);\n   144\t      const M = 60000;\n   145\t      const chart = window.Axylo.line!('#chart', { title: 'Stream', data: { columns: { t: Float64Array.from({ length: 100 }, (_, i) => t0 + i * M), v: Float64Array.from({ length: 100 }, (_, i) => i) } }, x: { field: 't', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   146\t      chart.zoom([new Date(t0 + 80 * M), new Date(t0 + 99 * M)]);\n   147\t      for (let i = 100; i < 110; i++) chart.append([{ t: t0 + i * M, v: i }], { keep: 100 });\n   148\t      await chart.__bench.ready();\n   149\t      return { d: chart.__bench.describe(), stages: chart.__dev.stages(), t0, M };\n   150\t    });\n   151\t    const { d, t0, M } = result;\n   152\t    expect(d.series[0]!.points).toBe(100);\n   153\t    expect(d.series[0]!.oldestX).toBe(t0 + 10 * M);\n   154\t    expect(d.series[0]!.newestX).toBe(t0 + 109 * M);\n   155\t    expect(d.xDomain).toEqual([t0 + 90 * M, t0 + 109 * M]);\n   156\t    expect(result.stages.normalize).toBe(1);\n   157\t    expect(result.stages.draw).toBe(1);\n   158\t    expect(await closePage(page)).toEqual([]);\n   159\t  });\n   160\t\n   161\t  it('a title-only update does not renormalize, rebuild the view or relayout the plot', async () => {\n   162\t    const page = await chartPage({ css: '#chart { height: auto; }' });\n   163\t    const result = await page.evaluate(async () => {\n   164\t      const chart = window.Axylo.line!('#chart', { title: 'Before', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   165\t      await chart.__bench.ready();\n   166\t      const before = chart.__dev.stages();\n   167\t      chart.update({ title: 'After' });\n   168\t      await chart.__bench.ready();\n   169\t      await window.nextFrames(2);\n   170\t      return { before, after: chart.__dev.stages(), heading: document.querySelector('#chart .axylo-title')!.textContent };\n   171\t    });\n   172\t    expect(result.heading).toBe('After');\n   173\t    for (const stage of ['normalize', 'view', 'layout', 'scene', 'draw'] as const) expect(result.after[stage], stage).toBe(result.before[stage]);\n   174\t    expect(result.after.reader).toBe(result.before.reader! + 1);\n   175\t    expect(await closePage(page)).toEqual([]);\n   176\t  });\n   177\t\n   178\t  it('a data-only update that keeps the domains does not relayout', async () => {\n   179\t    const page = await chartPage();\n   180\t    const result = await page.evaluate(async () => {\n   181\t      const t0 = Date.UTC(2026, 0, 1);\n   182\t      const rows = (k: number) => Array.from({ length: 30 }, (_, i) => ({ day: t0 + i * 864e5, v: 50 + ((i * k) % 7) }));\n   183\t      const chart = window.Axylo.line!('#chart', { title: 'T', data: rows(1), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   184\t      await chart.__bench.ready();\n   185\t      const before = chart.__dev.stages();\n   186\t      chart.update({ data: rows(3) });\n   187\t      await chart.__bench.ready();\n   188\t      const same = chart.__dev.stages();\n   189\t      chart.update({ data: rows(3).map(r => ({ ...r, v: r.v * 3 })) });\n   190\t      await chart.__bench.ready();\n   191\t      return { before, same, wider: chart.__dev.stages() };\n   192\t    });\n   193\t    expect(result.same.normalize).toBe(result.before.normalize! + 1);\n   194\t    expect(result.same.layout).toBe(result.before.layout);\n   195\t    expect(result.same.scene).toBe(result.before.scene! + 1);\n   196\t    expect(result.wider.layout).toBe(result.before.layout! + 1);\n   197\t    expect(await closePage(page)).toEqual([]);\n   198\t  });\n   199\t\n   200\t  it('a rejected strict update throws and leaves the previous chart intact', async () => {\n   201\t    const page = await chartPage();\n   202\t    const result = await page.evaluate(async () => {\n   203\t      const good = Array.from({ length: 7 }, (_, i) => ({ day: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][i], value: i }));\n   204\t      const chart = window.Axylo.line!('#chart', { title: 'Strict', strict: true, data: good, x: 'day', y: 'value' });\n   205\t      await chart.__bench.ready();\n   206\t      const before = { stages: chart.__dev.stages(), diagnostics: chart.diagnostics, describe: chart.__bench.describe(), revision: chart.__bench.revision };\n   207\t      let thrown = '';\n   208\t      try {\n   209\t        chart.update({ data: window.fx.dirtyRows(), title: 'Changed' });\n   210\t      } catch (e) {\n   211\t        thrown = String(e);\n   212\t      }\n   213\t      await window.nextFrames(3);\n   214\t      return {\n   215\t        thrown, before,\n   216\t        after: { stages: chart.__dev.stages(), diagnostics: chart.diagnostics, describe: chart.__bench.describe(), revision: chart.__bench.revision },\n   217\t        heading: document.querySelector('#chart .axylo-title')!.textContent,\n   218\t      };\n   219\t    });\n   220\t    expect(result.thrown).toMatch(/AX10[236]/);\n   221\t    expect(result.after.diagnostics).toEqual(result.before.diagnostics);\n   222\t    expect(result.after.describe).toEqual(result.before.describe);\n   223\t    expect(result.after.revision).toBe(result.before.revision);\n   224\t    expect(result.after.stages.draw).toBe(result.before.stages.draw);\n   225\t    expect(result.heading).toBe('Strict');\n   226\t    expect(await closePage(page)).toEqual([]);\n   227\t  });\n   228\t\n   229\t  it('a rejected strict append leaves the data as it was', async () => {\n   230\t    const page = await chartPage();\n   231\t    const result = await page.evaluate(async () => {\n   232\t      const t0 = Date.UTC(2026, 0, 1);\n   233\t      const chart = window.Axylo.line!('#chart', { title: 'Strict stream', strict: true, data: [{ t: t0, v: 1 }, { t: t0 + 864e5, v: 2 }], x: { field: 't', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   234\t      let thrown = '';\n   235\t      try {\n   236\t        chart.append([{ t: t0 + 2 * 864e5, v: NaN }]);\n   237\t      } catch (e) {\n   238\t        thrown = String(e);\n   239\t      }\n   240\t      chart.append([{ t: t0 + 2 * 864e5, v: 3 }]);\n   241\t      await chart.__bench.ready();\n   242\t      return { thrown, d: chart.__bench.describe() };\n   243\t    });\n   244\t    expect(result.thrown).toMatch(/AX103/);\n   245\t    expect(result.d.series[0]!.points).toBe(3);\n   246\t    expect(result.d.series[0]!.missing).toBe(0);\n   247\t    expect(await closePage(page)).toEqual([]);\n   248\t  });\n   249\t\n   250\t  it('destroy() before the frame draws nothing, and empties the target of what the chart added', async () => {\n   251\t    const page = await chartPage();\n   252\t    const result = await page.evaluate(async () => {\n   253\t      const el = document.getElementById('chart')!;\n   254\t      el.classList.add('mine');\n   255\t      const chart = window.Axylo.line!(el, { title: 'Gone', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   256\t      chart.destroy();\n   257\t      await window.nextFrames(3);\n   258\t      const stages = chart.__dev.stages();\n   259\t      chart.update({ title: 'Again' });\n   260\t      chart.append([{ day: Date.now(), channel: 'Direct', sessions: 1 }]);\n   261\t      chart.zoom(null);\n   262\t      await window.nextFrames(2);\n   263\t      return { stages, later: chart.__dev.stages(), children: el.childElementCount, className: el.className, attributes: [...el.attributes].map(a => a.name) };\n   264\t    });\n   265\t    expect(result.stages.draw).toBe(0);\n   266\t    expect(result.stages.frame).toBe(0);\n   267\t    expect(result.later).toEqual(result.stages);\n   268\t    expect(result.children).toBe(0);\n   269\t    expect(result.className).toBe('mine');\n   270\t    expect(result.attributes.sort()).toEqual(['class', 'id']);\n   271\t    expect(await closePage(page)).toEqual([]);\n   272\t  });\n   273\t\n   274\t  it('after destroy() no observer or listener fires', async () => {\n   275\t    const page = await chartPage();\n   276\t    const result = await page.evaluate(async () => {\n   277\t      const el = document.getElementById('chart')!;\n   278\t      const chart = window.Axylo.line!(el, { title: 'Gone', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   279\t      await chart.__bench.ready();\n   280\t      chart.destroy();\n   281\t      const stages = chart.__dev.stages();\n   282\t      el.style.width = '300px';\n   283\t      document.documentElement.classList.add('dark');\n   284\t      document.body.setAttribute('data-theme', 'dark');\n   285\t      el.dispatchEvent(new PointerEvent('pointermove', { clientX: 100, clientY: 100 }));\n   286\t      await window.nextFrames(4);\n   287\t      return { stages, later: chart.__dev.stages(), children: el.childElementCount };\n   288\t    });\n   289\t    expect(result.later).toEqual(result.stages);\n   290\t    expect(result.children).toBe(0);\n   291\t    expect(await closePage(page)).toEqual([]);\n   292\t  });\n   293\t});\n   294\t\n   295\tdescribe('memory (spec P7, DX5)', () => {\n   296\t  // Method corrected by the coordinator on 2026-11-18. The first version compared cycles 200–400 with 800–1000\n   297\t  // and allowed 5%; it measured 5.3%, and heap snapshots put that growth in the engine's compiled code, which\n   298\t  // keeps growing until about 1,500 cycles and then stops. A leak is growth that does not stop, so the trend is\n   299\t  // now judged after that warm-up, with a tighter allowance (1%). The snapshot test below checks retained\n   300\t  // objects directly.\n   301\t  it('create–destroy cycles show no upward heap trend once the engine has warmed up', async () => {\n   302\t    const page = await chartPage();\n   303\t    const cdp = await page.context().newCDPSession(page);\n   304\t    await cdp.send('HeapProfiler.enable');\n   305\t    const samples: { cycle: number; used: number }[] = [];\n   306\t    const STEP = 25;\n   307\t    for (let cycle = 0; cycle < 2500; cycle += STEP) {\n   308\t      await page.evaluate(async n => {\n   309\t        const el = document.getElementById('chart')!;\n   310\t        const rows = window.fx.trendRows();\n   311\t        for (let i = 0; i < n; i++) {\n   312\t          const chart = window.Axylo.line!(el, { title: 'Cycle', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n   313\t          await chart.__bench.ready();\n   314\t          chart.destroy();\n   315\t        }\n   316\t      }, STEP);\n   317\t      await cdp.send('HeapProfiler.collectGarbage');\n   318\t      await cdp.send('HeapProfiler.collectGarbage');\n   319\t      const { usedSize } = await cdp.send('Runtime.getHeapUsage');\n   320\t      samples.push({ cycle: cycle + STEP, used: usedSize });\n   321\t    }\n   322\t    const mean = (from: number, to: number) => {\n   323\t      const s = samples.filter(x => x.cycle > from && x.cycle <= to);\n   324\t      return s.reduce((a, b) => a + b.used, 0) / s.length;\n   325\t    };\n   326\t    const early = mean(1500, 2000);\n   327\t    const late = mean(2000, 2500);\n   328\t    expect(late / early, `heap mean cycles 1500–2000: ${Math.round(early)} B, 2000–2500: ${Math.round(late)} B`).toBeLessThanOrEqual(1.01);\n   329\t    const leftovers = await page.evaluate(() => document.getElementById('chart')!.childElementCount);\n   330\t    expect(leftovers).toBe(0);\n   331\t    expect(await closePage(page)).toEqual([]);\n   332\t  }, 600_000);\n   333\t\n   334\t  // Supplementary to the test above. On this machine the heap measured that way grows by about 6% between\n   335\t  // cycles 200–400 and 800–1000 and levels off after about 1,500 cycles; heap snapshots attribute the growth\n   336\t  // to compiled code (V8 InstructionStream, Code and their metadata), not to objects the chart retains. This\n   337\t  // test counts only what a leak would leave: every heap object except compiled code and V8's own metadata.\n   338\t  it('objects other than compiled code do not grow from cycle 300 to cycle 1,000', async () => {\n   339\t    const page = await chartPage();\n   340\t    const cdp = await page.context().newCDPSession(page);\n   341\t    const cycles = (n: number) => page.evaluate(async k => {\n   342\t      const el = document.getElementById('chart')!;\n   343\t      const rows = window.fx.trendRows();\n   344\t      for (let i = 0; i < k; i++) {\n   345\t        const chart = window.Axylo.line!(el, { title: 'Cycle', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n   346\t        await chart.__bench.ready();\n   347\t        chart.destroy();\n   348\t      }\n   349\t    }, n);\n   350\t    const retained = async (): Promise<number> => {\n   351\t      await cdp.send('HeapProfiler.collectGarbage');\n   352\t      const chunks: string[] = [];\n   353\t      const onChunk = (e: { chunk: string }) => chunks.push(e.chunk);\n   354\t      cdp.on('HeapProfiler.addHeapSnapshotChunk', onChunk);\n   355\t      await cdp.send('HeapProfiler.takeHeapSnapshot', { reportProgress: false });\n   356\t      cdp.off('HeapProfiler.addHeapSnapshotChunk', onChunk);\n   357\t      const snap = JSON.parse(chunks.join('')) as { snapshot: { meta: { node_fields: string[]; node_types: [string[]] } }; nodes: number[]; strings: string[] };\n   358\t      const fields = snap.snapshot.meta.node_fields;\n   359\t      const types = snap.snapshot.meta.node_types[0];\n   360\t      const typeAt = fields.indexOf('type');\n   361\t      const nameAt = fields.indexOf('name');\n   362\t      const sizeAt = fields.indexOf('self_size');\n   363\t      let total = 0;\n   364\t      for (let i = 0; i < snap.nodes.length; i += fields.length) {\n   365\t        const type = types[snap.nodes[i + typeAt]!];\n   366\t        const name = snap.strings[snap.nodes[i + nameAt]!]!;\n   367\t        if (type === 'code' || name.startsWith('system / ')) continue;\n   368\t        total += snap.nodes[i + sizeAt]!;\n   369\t      }\n   370\t      return total;\n   371\t    };\n   372\t    await cycles(300);\n   373\t    const early = await retained();\n   374\t    await cycles(700);\n   375\t    const late = await retained();\n   376\t    // One leaked chart (its DOM, frame and scene) is several kilobytes; 700 of them would be megabytes.\n   377\t    expect(late - early, `non-code heap at cycle 300: ${early} B, at 1,000: ${late} B`).toBeLessThan(64 * 1024);\n   378\t    expect(await closePage(page)).toEqual([]);\n   379\t  }, 300_000);\n   380\t});\n","exit_code":0,"status":"completed"}}
