hart)}: rejected by strict mode.`);\n    99\t    this.name = 'AxyloStrictError';\n   100\t    this.diagnostics = diagnostics;\n   101\t  }\n   102\t}\npackages/axylo/src/index.ts\n     1\t/**\n     2\t * Axylo's public entry points. Importing this module touches no DOM, so it loads in Node, where `validate`\n     3\t * runs; the chart functions need a document and are only called in a browser.\n     4\t */\n     5\timport type {\n     6\t  AreaOptions, BarOptions, Chart, Diagnostic, DonutOptions, LineOptions, ScatterOptions, Target,\n     7\t} from './public';\n     8\timport { createChart } from './core/chart';\n     9\timport { validateOptions } from './data';\n    10\timport { createDiagnostic } from './diagnostics';\n    11\t\n    12\texport type * from './public';\n    13\t\n    14\texport function line<Row>(target: Target, options: LineOptions<Row>): Chart<Row, LineOptions<Row>> {\n    15\t  return createChart('line', target, options) as unknown as Chart<Row, LineOptions<Row>>;\n    16\t}\n    17\t\n    18\texport function area<Row>(target: Target, options: AreaOptions<Row>): Chart<Row, AreaOptions<Row>> {\n    19\t  return createChart('area', target, options) as unknown as Chart<Row, AreaOptions<Row>>;\n    20\t}\n    21\t\n    22\texport function bar<Row>(target: Target, options: BarOptions<Row>): Chart<Row, BarOptions<Row>> {\n    23\t  return createChart('bar', target, options) as unknown as Chart<Row, BarOptions<Row>>;\n    24\t}\n    25\t\n    26\texport function scatter<Row>(target: Target, options: ScatterOptions<Row>): Chart<Row, ScatterOptions<Row>> {\n    27\t  return createChart('scatter', target, options) as unknown as Chart<Row, ScatterOptions<Row>>;\n    28\t}\n    29\t\n    30\texport function donut<Row>(target: Target, options: DonutOptions<Row>): Chart<Row, DonutOptions<Row>> {\n    31\t  return createChart('donut', target, options) as unknown as Chart<Row, DonutOptions<Row>>;\n    32\t}\n    33\t\n    34\t/** Runs option resolution and norma