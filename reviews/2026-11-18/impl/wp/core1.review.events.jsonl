{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/theme/{watch,styles,resolve}.ts'","aggregated_output":"/**\n * Notices the page changes that can change a chart's theme (spec L4): the three media features, and the\n * `class`, `style` or `data-theme` attribute of the chart or any of its ancestors (a class-toggled dark\n * theme may sit on `<html>`, `<body>` or a card in between). Bursts are folded into one call per frame.\n *\n * One MutationObserver covers the whole document (`subtree`), and a record counts only when its target is\n * the chart or one of its ancestors at that moment, so the watch keeps working when the chart is moved to\n * another parent or `<body>` is replaced. Inside a shadow root, that root is observed as well.\n */\n\nconst QUERIES = ['(prefers-color-scheme: dark)', '(forced-colors: active)', '(prefers-contrast: more)'];\nconst ATTRIBUTES = ['class', 'style', 'data-theme'];\n\n/** Declarations resolveTheme itself writes on the chart root; changes to them alone are not theme changes. */\nconst OWN = /--axylo-(?:series-color-\\d+|backdrop)\\s*:[^;]*;?\\s*/g;\n\n/** Calls `onChange` at most once per animation frame after a relevant change. Returns `stop`. */\nexport function watchTheme(element: Element, onChange: () => void): () => void {\n  const doc = element.ownerDocument;\n  const win = doc.defaultView;\n  if (win === null) return () => {};\n  let frame = 0;\n  let stopped = false;\n\n  const schedule = (): void => {\n    if (stopped || frame !== 0) return;\n    frame = win.requestAnimationFrame(() => {\n      frame = 0;\n      if (!stopped) onChange();\n    });\n  };\n\n  const lists = QUERIES.map(q => win.matchMedia(q));\n  for (const list of lists) list.addEventListener('change', schedule);\n\n  const observer = new win.MutationObserver(records => {\n    for (const r of records) {\n      if (!holds(r.target, element)) continue;\n      if (r.target === element && r.attributeName === 'style') {\n        const before = (r.oldValue ?? '').replace(OWN, '').trim();\n        const after = (element.getAttribute('style') ?? '').replace(OWN, '').trim();\n        if (before === after) continue;\n      }\n      schedule();\n      return;\n    }\n  });\n  const options: MutationObserverInit = { attributes: true, attributeFilter: ATTRIBUTES, attributeOldValue: true, subtree: true };\n  observer.observe(doc.documentElement, options);\n  const root = element.getRootNode();\n  if (root !== doc && 'host' in root) observer.observe(root, options);\n\n  return () => {\n    if (stopped) return;\n    stopped = true;\n    for (const list of lists) list.removeEventListener('change', schedule);\n    observer.disconnect();\n    if (frame !== 0) win.cancelAnimationFrame(frame);\n    frame = 0;\n  };\n}\n\n/** True when `target` is `element` or one of its ancestors, crossing shadow roots to their hosts. */\nfunction holds(target: Node, element: Node): boolean {\n  for (let n: Node | null = element; n !== null; n = n.parentNode ?? ('host' in n ? (n as ShadowRoot).host : null)) {\n    if (n === target) return true;\n  }\n  return false;\n}\n/**\n * Applies the default stylesheet (plan 2.4) to the root a chart lives in: its document, or the shadow root\n * that contains it (a document's sheets do not reach into a shadow tree).\n *\n * - Normally a constructable stylesheet is adopted (`adoptedStyleSheets`); no `<style>` element is created.\n * - A root that already has the standalone dist/axylo.css active gets nothing. \"Active\" is checked by its\n *   effect (a probe element picks up the sheet's own rules), not by trusting a sentinel property, and is\n *   checked again on later calls, so a sheet that was removed or disabled is replaced.\n * - Only where constructable or adopted stylesheets are missing is one `<style>` element inserted instead.\n *   This is the only case in which the library creates a style element.\n */\nimport { AXYLO_CSS } from './css';\n\ntype StyleRoot = Document | ShadowRoot;\n\ntype Installed =\n  | { readonly kind: 'adopted'; readonly sheet: CSSStyleSheet }\n  | { readonly kind: 'element'; readonly element: HTMLStyleElement }\n  | { readonly kind: 'standalone'; readonly sheet: CSSStyleSheet | null };\n\nconst installed = new WeakMap<StyleRoot, Installed>();\n/** One constructed sheet per document, shared by its document and shadow roots. */\nconst constructed = new WeakMap<Document, CSSStyleSheet>();\n\n/**\n * Makes the default styles apply to `root` (a Document or a ShadowRoot). Safe to call any number of times;\n * after the first call it costs a few property reads unless the sheet it relied on has gone away.\n */\nexport function ensureStyles(root: StyleRoot): void {\n  const state = installed.get(root);\n  if (state !== undefined && stillActive(root, state)) return;\n  const doc = 'ownerDocument' in root && root.ownerDocument !== null ? root.ownerDocument : (root as Document);\n  const win = doc.defaultView;\n  if (win === null) return;\n\n  const standalone = findStandalone(root, doc, win);\n  if (standalone !== undefined) { installed.set(root, { kind: 'standalone', sheet: standalone }); return; }\n\n  if (canAdopt(root, win)) {\n    let sheet = constructed.get(doc);\n    if (sheet === undefined) {\n      // The constructor must come from the document's own window, or adopting the sheet throws.\n      sheet = new win.CSSStyleSheet();\n      sheet.replaceSync(AXYLO_CSS);\n      constructed.set(doc, sheet);\n    }\n    const list = (root as { adoptedStyleSheets: CSSStyleSheet[] }).adoptedStyleSheets;\n    if (!list.includes(sheet)) (root as { adoptedStyleSheets: CSSStyleSheet[] }).adoptedStyleSheets = [...list, sheet];\n    installed.set(root, { kind: 'adopted', sheet });\n    return;\n  }\n\n  const element = doc.createElement('style');\n  element.setAttribute('data-axylo-styles', '');\n  element.textContent = AXYLO_CSS;\n  if (root === doc) (doc.head ?? doc.documentElement).appendChild(element);\n  else root.insertBefore(element, root.firstChild);\n  installed.set(root, { kind: 'element', element });\n}\n\nfunction stillActive(root: StyleRoot, state: Installed): boolean {\n  switch (state.kind) {\n    case 'adopted': return (root as { adoptedStyleSheets?: CSSStyleSheet[] }).adoptedStyleSheets?.includes(state.sheet) ?? false;\n    case 'element': return state.element.isConnected && state.element.sheet !== null && !state.element.sheet.disabled;\n    case 'standalone': {\n      if (state.sheet === null) return false; // not identifiable: verify by effect again\n      const owner = state.sheet.ownerNode;\n      return !state.sheet.disabled && owner !== null && owner.isConnected && Array.prototype.includes.call(root.styleSheets, state.sheet);\n    }\n  }\n}\n\nfunction canAdopt(root: StyleRoot, win: Window): boolean {\n  if (!('adoptedStyleSheets' in root)) return false;\n  const Sheet = (win as unknown as { CSSStyleSheet?: { new(): CSSStyleSheet; prototype: Partial<CSSStyleSheet> } }).CSSStyleSheet;\n  if (typeof Sheet !== 'function' || typeof Sheet.prototype.replaceSync !== 'function') return false;\n  try { new Sheet(); } catch { return false; }\n  return true;\n}\n\n/**\n * The standalone sheet if it is in effect in `root`: undefined if not, null if in effect but not\n * identifiable (a cross-origin sheet whose rules cannot be read). In effect means a probe chart root picks\n * up a private token and a mark rule that only this stylesheet defines; custom properties alone could be\n * inherited from outside a shadow root, so a non-inherited property is checked as well.\n */\nfunction findStandalone(root: StyleRoot, doc: Document, win: Window): CSSStyleSheet | null | undefined {\n  const probe = doc.createElement('div');\n  probe.className = 'axylo';\n  probe.style.setProperty('display', 'none');\n  const mark = doc.createElement('div');\n  mark.className = 'axylo-svg';\n  probe.appendChild(mark);\n  (root === doc ? doc.documentElement : root).appendChild(probe);\n  const token = win.getComputedStyle(probe).getPropertyValue('--axylo-default-background').trim();\n  const rule = win.getComputedStyle(mark).position;\n  probe.remove();\n  if (token === '' || rule !== 'absolute') return undefined;\n  for (const sheet of Array.from(root.styleSheets)) {\n    try {\n      for (const r of Array.from(sheet.cssRules)) if (r.cssText.includes('--axylo-stylesheet')) return sheet;\n    } catch {\n      // Cross-origin: its rules cannot be read.\n    }\n  }\n  return null;\n}\n/**\n * Theme resolution (spec L4, DX6, A5): decides light or dark for a chart root, and turns paints into both\n * CSS expressions (for the SVG renderer, which stays live) and concrete colors (for canvas and contrast\n * checks). Concrete colors come from the browser itself through probe elements, never from parsing CSS.\n *\n * The chart paints no background unless the author sets `--axylo-background`: marks sit on whatever is\n * behind the chart. So the background used for checks is the effective opaque backdrop, found by walking up\n * from the chart and compositing computed background colors; with `--axylo-background` it is that color\n * (composited over the backdrop), which the renderers then also paint. What is measured is what is drawn.\n */\nimport type { PaintBindings, PaintToken, ResolvedTheme } from '../core/contracts';\nimport { composite, isLightColor, parseColor, type Rgba } from './color';\nimport { LIGHT, SERIES_COUNT } from './palette';\n\n/** A resolved theme with what the renderers need beyond the contract. */\nexport interface ResolvedThemeDetails extends ResolvedTheme {\n  /**\n   * Concrete color to paint behind the whole scene, or null to paint nothing. Set when the author gives\n   * `--axylo-background`; the canvas renderer fills with it, the SVG renderer paints the live CSS value.\n   */\n  readonly plotBackground?: string | null;\n}\n\nexport interface ThemeResolution {\n  readonly bindings: PaintBindings;\n  readonly theme: ResolvedThemeDetails;\n  /**\n   * false when the element is not connected to a document: nothing could be computed, the paints are the\n   * light defaults, and the caller should resolve again once the chart is attached.\n   */\n  readonly resolved?: boolean;\n  /**\n   * false when the backdrop behind the chart could not be determined (a background image on the way up):\n   * `theme.paints.tokens.background` is then a guess, and the caller should skip the AX141 check.\n   */\n  readonly backdropKnown?: boolean;\n  /** Series keys whose author color the browser does not accept as a color; they use their palette slot. */\n  readonly invalidColors?: readonly string[];\n}\n\nconst TOKENS: readonly PaintToken[] = ['axis', 'grid', 'reference', 'muted', 'focus', 'background', 'text'];\n\n/**\n * CSS expressions for the token paints. Each public name (which an author may set anywhere, including\n * `:root`) falls back to a private default from the stylesheet.\n */\nexport const TOKEN_BINDINGS: Readonly<Record<PaintToken, string>> = Object.freeze({\n  axis: 'var(--axylo-axis, var(--axylo-default-axis))',\n  grid: 'var(--axylo-grid, var(--axylo-default-grid))',\n  reference: 'var(--axylo-reference, var(--axylo-default-reference))',\n  muted: 'var(--axylo-muted, var(--axylo-default-muted))',\n  focus: 'var(--axylo-focus, var(--axylo-default-focus))',\n  // The author's background if any; else the backdrop resolveTheme found (set on the chart root).\n  background: 'var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background)))',\n  // The chart inherits the page's text color unless the author sets --axylo-text (spec DX6).\n  text: 'var(--axylo-text, currentColor)',\n});\n\n/** The palette slot for a series index, as a CSS expression. */\nexport const seriesBinding = (index: number): string => {\n  const n = (index % SERIES_COUNT) + 1;\n  return `var(--axylo-series-${n}, var(--axylo-default-series-${n}))`;\n};\n\n/**\n * Name of the custom property, set on the