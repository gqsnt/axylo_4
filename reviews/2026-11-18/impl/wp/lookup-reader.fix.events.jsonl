Row>(target: Target, options: LineOptions<Row>): Chart<Row, LineOptions<Row>> {\n  return createChart('line', target, options) as unknown as Chart<Row, LineOptions<Row>>;\n}\n\nexport function area<Row>(target: Target, options: AreaOptions<Row>): Chart<Row, AreaOptions<Row>> {\n  return createChart('area', target, options) as unknown as Chart<Row, AreaOptions<Row>>;\n}\n\nexport function bar<Row>(target: Target, options: BarOptions<Row>): Chart<Row, BarOptions<Row>> {\n  return createChart('bar', target, options) as unknown as Chart<Row, BarOptions<Row>>;\n}\n\nexport function scatter<Row>(target: Target, options: ScatterOptions<Row>): Chart<Row, ScatterOptions<Row>> {\n  return createChart('scatter', target, options) as unknown as Chart<Row, ScatterOptions<Row>>;\n}\n\nexport function donut<Row>(target: Target, options: DonutOptions<Row>): Chart<Row, DonutOptions<Row>> {\n  return createChart('donut', target, options) as unknown as Chart<Row, DonutOptions<Row>>;\n}\n\n/** Runs option resolution and normalization only, without a DOM, and returns the diagnostics (plan 1.6). */\nexport function validate<Row>(type: 'line' | 'area' | 'bar', options: LineOptions<Row> | AreaOptions<Row> | BarOptions<Row>): Diagnostic[];\nexport function validate<Row>(type: 'scatter', options: ScatterOptions<Row>): Diagnostic[];\nexport function validate<Row>(type: 'donut', options: DonutOptions<Row>): Diagnostic[];\nexport function validate(type: 'line' | 'area' | 'bar' | 'scatter' | 'donut', options: unknown): Diagnostic[] {\n  const given = options !== null && typeof options === 'object';\n  const { __renderer: _renderer, ...rest } = (given ? options : {}) as Record<string, unknown>;\n  const found = [...validateOptions(type, given ? rest : options)];\n  // The chart raises AX140 when it is created; validate says the same.\n  const title = typeof rest.title === 'string' ? rest.title : (rest.title as { text?: unknown } | undefined)?.text;\n  const named = (typeof title === 'string' && title !== '') || (typeof rest.labelledBy === 'string' && rest.labelledBy !== '');\n  if (!named) {\n    const { effect: _e, origin: _o, ...d } = createDiagnostic('AX140', 'none');\n    found.push({ ...d, chart: type });\n  }\n  return found;\n}\n      }\n\n      // Reader model and caption first: the caption's height decides what is left for the plot, so it is\n      // final before the plot is measured. Hidden labels are only known after layout; if their count\n      // changes, the reader model is built again below.\n      const all = [...a.optionDiagnostics, ...a.dataDiagnostics, ...a.viewDiagnostics, ...presentation.values()];\n      const disclosure = readerDisclosure(all);\n      const hiddenIn = (l: Layout | undefined) => l?.kind === 'plot' ? l.fit.x.hidden + l.fit.y.hidden : 0;\n      const readerFor = (labelsHidden: number): { reader: ReaderModel; inputs: readonly unknown[] } => {\n        const inputs = [view, formatters, a.messages, a.options.title, a.options.labelledBy, a.options.subtitle,\n          a.options.description, disclosure.omitted, disclosure.changed, labelsHidden, a.options.table, compact, locale];\n        if (drawn && sameKey(drawn.readerInputs, inputs)) return { reader: drawn.reader, inputs: drawn.readerInputs };\n        stage('reader');\n        const title = a.options.title;\n        const reader = buildReader({\n          view, formatters: formatters!, messages: a.messages, type: a.messages[KIND_MESSAGES[kind]] || KIND_NAMES[kind],\n          title: typeof title === 'string' || (title && typeof title === 'object') ? title as string | Title : undefined,\n          labelledBy: stringOption(a.options, 'labelledBy') ?? undefined,\n          subtitle: stringOption(a.options, 'subtitle') ?? undefined,\n          description: stringOption(a.options, 'description') ?? undefined,\n          disclosure, labelsHidden, table: a.options.table !== false, compact, locale,\n        });\n        return { reader, inputs };\n      };\n      const modelFor = (reader: ReaderModel, tooSmall: boolean): FigureModel => ({\n        compact, title: titleOf(a.options), labelledBy: stringOption(a.options, 'labelledBy'), name: reader.name || a.name,\n        subtitle: stringOption(a.options, 'subtitle'), summary: reader.summary,\n        summaryVisible: tooSmall, note: shown.kind === 'ready' ? reader.note : null,\n        message: shown.kind === 'ready' ? null : shown.text,\n      });\n      let { reader, inputs: readerInputs } = readerFor(hiddenIn(drawn?.layout));\n      stage('figure');\n      figure.update(modelFor(reader, drawn?.layout.kind === 'too-small'));\n      size ??= measure();\n","exit_code":1,"status":"failed"}}
