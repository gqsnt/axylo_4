r.count,\n    ordinal(datum) {\n      const point = locate(datum);\n      return point ? order.ordinal(point.series, point.index) : -1;\n    },\n    step(from, direction) {\n      if (!from) return at(0);\n      const point = locate(from);\n      if (!point) return null;\n      const ordinal = order.ordinal(point.series, point.index);\n      if (ordinal < 0) return null;\n      switch (direction) {\n        case 'next': return at(ordinal + 1);\n        case 'previous': return at(ordinal - 1);\n        case 'first': return at(0);\n        case 'last': return at(order.count - 1);\n        case 'page-next': return at(Math.min(order.count - 1, ordinal + pageDistance(order.count)));\n        case 'page-previous': return at(Math.max(0, ordinal - pageDistance(order.count)));\n        case 'series-next':\n        case 'series-previous': {\n          const neighbor = active[active.indexOf(point.series) + (direction === 'series-next' ? 1 : -1)];\n          return neighbor === undefined ? null : nearest(point, neighbor);\n        }\n      }\n    },\n    resolve(datum) { return locate(datum) ? datum : null; },\n    get lastPickCandidates() { return grid?.examined ?? 0; },\n  };\n}\nimport type { IndexRange, PointSeries } from '../core/contracts';\nimport { lowerBound } from './search';\n\nexport interface PointIndex {\n  readonly series: number;\n  readonly index: number;\n}\n\n/** A sorted view of several already sorted columns, without a merged array of points. */\nexport function pointOrder(series: readonly PointSeries[], ranges: readonly IndexRange[]) {\n  const active: number[] = [];\n  let count = 0;\n  ranges.forEach(({ start, end }, s) => {\n    if (start < end) active.push(s);\n    count += end - start;\n  });\n\n  function compare(s: number, i: number, t: number, j: number): number {\n    return series[s]!.x[i]! - series[t]!.x[j]!\n      || series[s]!.y[i]! - series[t]!.y[j]! || s - t || i - j;\n  }\n\n  function at(ordinal: number): PointIndex | null {\n    if (!Number.isInteger(ordinal) || ordinal < 0 || ordinal >= count) return null;\n    if (active.length === 1) {\n      const s = active[0]!;\n      return { series: s, index: ranges[s]!.start + ordinal };\n    }\n    const remaining = active.slice();\n    const starts = remaining.map(s => ranges[s]!.start);\n    while (remaining.length > 1) {\n      // The smallest sampled point has at most `stride - 1` predecessors in each list.\n      // Discarding its prefix removes no more than `ordinal` points before the target.\n      const stride = Math.max(1, Math.floor(ordinal / remaining.length));\n      let chosen = 0;\n      let sampled = Math.min(starts[0]! + stride, ranges[remaining[0]!]!.end) - 1;\n      for (let k = 1; k < remaining.length; k++) {\n        const s = remaining[k]!;\n        const i = Math.min(starts[k]! + stride, ranges[s]!.end) - 1;\n        if (compare(s, i, remaining[chosen]!, sampled) < 0) {\n          chosen = k;\n          sampled = i;\n        }\n      }\n      if (ordinal === 0) return { series: remaining[chosen]!, index: sampled };\n      ordinal -= sampled + 1 - starts[chosen]!;\n      starts[chosen] = sampled + 1;\n      if (starts[chosen] === ranges[remaining[chosen]!]!.end) {\n        starts.splice(chosen, 1);\n        remaining.splice(chosen, 1);\n      }\n    }\n    return { series: remaining[0]!, index: starts[0]! + ordinal };\n  }\n\n  function ordinal(s: number, i: number): number {\n    const range = ranges[s];\n    if (!range || i < range.start || i >= range.end) return -1;\n    let before = 0;\n    for (const t of active) {\n      let { start, end } = ranges[t]!;\n      const first = start;\n      while (start < end) {\n        const mid = start + Math.floor((end - start) / 2);\n        if (compare(t, mid, s, i) < 0) start = mid + 1;\n        else end = mid;\n      }\n      before += start - first;\n    }\n    return before;\n  }\n\n  function beforeX(x: number): number {\n    let before = 0;\n    for (const s of active) {\n      const { start, end } = ranges[s]!;\n      before += lowerBound(series[s]!.x, x, start, end) - start;\n    }\n    return before;\n  }\n\n  return { at, ordinal, beforeX, count };\n}\nimport type { ScatterView } from '../core/contracts';\nimport { contains, type PlotLayout } from './geometry';\n\nconst CELL = 24;\nconst RADIUS2 = CELL * CELL;\nconst COINCIDENT2 = 0.5 ** 2;\nexport const POINT_LIMIT = 8;\n\nexport function scatterGrid(view: ScatterView, layout: PlotLayout & { projection: Extract<PlotLayout['projection'], { kind: 'xy' }> }, count: number) {\n  const { plot, projection } = layout;\n  const columns = Math.floor(plot.width / CELL) + 1;\n  const rows = Math.floor(plot.height / CELL) + 1;\n  const heads = new Map<number, number>();\n  const next = new Int32Array(count);\n  const series = new Uint32Array(count);\n  const points = new Uint32Array(count);\n  const xs = new Float64Array(count);\n  const ys = new Float64Array(count);\n  let length = 0;\n  let examined = 0;\n\n  const column = (x: number) => Math.floor((x - plot.x) / CELL);\n  const row = (y: number) => Math.floor((y - plot.y) / CELL);\n  view.frame.series.forEach((data, s) => {\n    if (!view.visible[s] || !data.drawable) return;\n    const { start, end } = view.visiblePoints[s]!;\n    for (let i = start; i < end; i++) {\n      const x = projection.x.map(data.x[i]!);\n      const y = projection.y.map(data.y[i]!);\n      if (!contains(plot, x, y)) continue;\n      const cell = column(x) + columns * row(y);\n      const at = length++;\n      next[at] = heads.get(cell) ?? -1;\n      heads.set(cell, at);\n      xs[at] = x;\n      ys[at] = y;\n      series[at] = s;\n      points[at] = i;\n    }\n  });\n\n  function visit(x: number, y: number, radius: number, examine: (at: number, distance: number) => void): void {\n    const left = Math.max(0, column(x - radius));\n    const right = Math.min(columns - 1, column(x + radius));\n    const top = Math.max(0, row(y - radius));\n    const bottom = Math.min(rows - 1, row(y + radius));\n    for (let cy = top; cy <= bottom; cy++) {\n      for (let cx = left; cx <= right; cx++) {\n        for (let at = heads.get(cx + cy * columns) ?? -1; at >= 0; at = next[at]!) {\n          examined++;\n          examine(at, (xs[at]! - x) ** 2 + (ys[at]! - y) ** 2);\n        }\n      }\n    }\n  }\n\n  function sourceRow(at: number): number {\n    const i = points[at]!;\n    return view.frame.series[series[at]!]!.row?.[i] ?? i;\n  }\n\n  return {\n    series, points,\n    get examined() { return examined; },\n    pick(x: number, y: number) {\n      examined = 0;\n      if (!contains(plot, x, y)) return null;\n      let nearest = -1;\n      let bestDistance = RADIUS2;\n      visit(x, y, CELL, (at, distance) => {\n        if (distance < bestDistance || distance === bestDistance && (nearest < 0 || sourceRow(at) > sourceRow(nearest))) {\n          nearest = at;\n          bestDistance = distance;\n        }\n      });\n      if (nearest < 0) return null;\n      const hits = [nearest];\n      let count = 1;\n      visit(xs[nearest]!, ys[nearest]!, 0.5, (at, distance) => {\n        if (at === nearest || distance > COINCIDENT2) return;\n        count++;\n        if (hits.length < POINT_LIMIT) hits.push(at);\n      });\n      return { hits, count };\n    },\n  };\n}\nimport { SLOT_VALUE, type DiagnosticSink, type DonutFrame, type DonutSlice, type DonutView } from '../core/contracts';\nimport { report } from '../diagnostics';\n\nconst TURN = 2 * Math.PI;\nconst OTHER = '__other__';\n\nexport function buildDonut(\n  frame: DonutFrame, otherLabel: (count: number) => string, previous: DonutView | undefined, sink: DiagnosticSink,\n): DonutView {\n  const result = { kind: 'donut' as const, frame, revision: frame.revision };\n  // Normalization has already reported chart errors. No partial ring should be drawn for either.\n  if (new Set(frame.labels).size !== frame.labels.length) return { ...result, slices: [], total: 0 };\n\n  let total = 0;\n  let max = 0;\n  let positive = 0;\n  const largest: number[] = [];\n  for (let i = 0; i < frame.labels.length; i++) {\n    if (frame.slot[i] !== SLOT_VALUE) continue;\n    const value = frame.values[i]!;\n    if (value < 0) return { ...result, slices: [], total: 0 };\n    if (value === 0) continue;\n    positive++;\n    total += value;\n    max = Math.max(max, value);\n    // Only the first seven ranks can affect grouping, even for a very large input.\n    const rank = largest.findIndex(index => frame.values[index]! < value);\n    if (rank >= 0) largest.splice(rank, 0, i);\n    else if (largest.length < 7) largest.push(i);\n    if (largest.length > 7) largest.pop();\n  }\n\n  const grouped = positive > 8;\n  const label = grouped ? otherLabel(positive - 7) : '';\n  if (grouped) report(sink, 'AX121', 'changed', { field: frame.valueLabel, count: positive - 7 });\n  const scaled = !Number.isFinite(total);\n  let denominator = total;\n  if (scaled) {\n    report(sink, 'AX103', 'changed', { field: frame.valueLabel });\n    denominator = 0;\n    for (let i = 0; i < frame.values.length; i++) {\n      if (frame.slot[i] === SLOT_VALUE) denominator += frame.values[i]! / max;\n    }\n  }\n  if (previous?.frame === frame && (!grouped || previous.slices.at(-1)?.label === label)) return previous;\n\n  const slices: DonutSlice[] = [];\n  let angle = 0;\n  let drawn = 0;\n  const drawnCount = grouped ? 8 : positive;\n  function add(key: string, label: string, members: readonly number[], value: number | null, weight: number): void {\n    const ratio = value === null ? null : weight === 0 ? 0 : weight / denominator;\n    let angles: DonutSlice['angles'] = null;\n    if (value !== null && value > 0) {\n      const end = ++drawn === drawnCount ? TURN : Math.min(TURN, angle + ratio! * TURN);\n      angles = [angle, end];\n      angle = end;\n    }\n    slices.push({ key, label, members, value, ratio, angles });\n  }\n\n  const kept = grouped ? new Set(largest) : null;\n  const others: number[] = [];\n  let otherValue = 0;\n  let otherWeight = 0;\n  for (let i = 0; i < frame.labels.length; i++) {\n    const name = frame.labels[i]!;\n    const value = frame.slot[i] === SLOT_VALUE ? frame.values[i]! : null;\n    const weight = scaled ? (value ?? 0) / max : value ?? 0;\n    if (kept && value !== null && value > 0 && !kept.has(i)) {\n      others.push(i);\n      otherValue += value;\n      otherWeight += weight;\n    } else {\n      const key = name.startsWith(OTHER) ? OTHER + name : name;\n      add(key, name, [i], value, weight);\n    }\n  }\n  if (grouped) add(OTHER, label, others, otherValue, otherWeight);\n  return { ...result, slices, total };\n}\npackages/axylo/src/core/contracts.ts:417:export type MarkerShape = 'circle' | 'square' | 'triangle' | 'diamond' | 'cross' | 'plus' | 'triangle-down' | 'star';\npackages/axylo/src/core/contracts.ts:420:export interface DashStyle {\npackages/axylo/src/core/contracts.ts:426:export interface PathMark {\npackages/axylo/src/core/contracts.ts:441:export interface AreaMark {\npackages/axylo/src/core/contracts.ts:452:export interface RectMark {\npackages/axylo/src/core/contracts.ts:462:export interface PointMark {\npackages/axylo/src/core/contracts.ts:472:export interface ArcMark {\npackages/axylo/src/core/contracts.ts:484:export interface RuleMark {\npackages/axylo/src/core/contracts.ts:494:export interface BandMark {\npackages/axylo/src/core/contracts.ts:501:export type Mark = PathMark | AreaMark | RectMark | PointMark | ArcMark | RuleMark | BandMark;\npackages/axylo/src/core/contracts.ts:504:export interface Scene {\npackages/axylo/src/core/contracts.ts:514:export type PaintToken = 'axis' | 'grid' | 'reference' | 'muted' | 'focus' | 'background' | 'text';\npackages/axylo/src/core/contracts.ts:517:export interface PaintBindings {\npackages/axylo/src/core/contracts.ts:524:export interface ResolvedTheme {\npackages/axylo/src/core/contracts.ts:534:export interface Overlay {\npackages/axylo/src/core/contracts.ts:548:export interface MarkRenderer {\npackages/axylo/src/core/contracts.ts:565:export type DatumRef =\npackages/axylo/src/core/contracts.ts:571:export type PickTarget =\npackages/axylo/src/core/contracts.ts:577:export interface DatumText {\npackages/axylo/src/core/contracts.ts:592:export interface TooltipModel {\npackages/axylo/src/core/contracts.ts:603:export type StepDirection = 'next' | 'previous' | 'first' | 'last' | 'series-next' | 'series-previous' | 'page-next' | 'page-previous';\npackages/axylo/src/core/contracts.ts:609:export interface Lookup {\npackages/axylo/src/core/contracts.ts:641:export interface TableModel {\npackages/axylo/src/core/contracts.ts:654:export interface ReaderModel {\npackages/axylo/src/core/contracts.ts:668:export interface Environment {\npackages/axylo/src/core/contracts.ts:680:export type { Diagnostic, XValue };\npackages/axylo/src/data/index.ts:1:export { normalize } from './normalize';\npackages/axylo/src/data/index.ts:2:export type { DataEnvironment, FrameVersion } from './normalize';\npackages/axylo/src/data/index.ts:3:export { resolveOptions } from './options';\npackages/axylo/src/data/index.ts:4:export type { AlignedChartType, ChartType, ResolvedOptions, ResolvedValueField, ResolvedXField } from './options';\npackages/axylo/src/data/index.ts:5:export { AlignedStore } from './store';\npackages/axylo/src/data/index.ts:6:export { validateOptions } from './validate';\npackages/axylo/src/data/x.ts:10:export const DAY = 86_400_000;\npackages/axylo/src/data/x.ts:11:export const HOUR = 3_600_000;\npackages/axylo/src/data/x.ts:12:export type DateUnit = NonNullable<XColumn['dateUnit']>;\npackages/axylo/src/data/x.ts:22:export function kindOf(value: unknown): XKind | null {\npackages/axylo/src/data/x.ts:42:export type KindVotes = Record<XKind, number>;\npackages/axylo/src/data/x.ts:44:export function countKinds(table: Table, field: string, series: string | null = null): KindVotes {\npackages/axylo/src/data/x.ts:63:export function preferredKind(votes: KindVotes): XKind | null {\npackages/axylo/src/data/x.ts:72:export function inferKind(table: Table, field: string, series: string | null = null): XKind | null {\npackages/axylo/src/data/x.ts:76:export function nameOf(value: unknown): string | null {\npackages/axylo/src/data/x.ts:82:export class XParser {\npackages/axylo/src/data/x.ts:211:export function dailyDelta(delta: number): number {\npackages/axylo/src/data/x.ts:216:export function sameDailyTime(first: number, position: number): boolean {\npackages/axylo/src/data/x.ts:221:export function positionName(axis: Pick<XColumn, 'kind' | 'dateUnit' | 'timeZone' | 'categories'>, position: number): string {\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/test/lookup/{fixtures,aligned.test,scatter.test,donut.test}.ts\nsed -n '1,85p' packages/axylo/test/reader/index.test.ts\nsed -n '610,647p' packages/axylo/src/core/chart.ts\nrg -n 'pointOf|formatters\\\\.count|ordinal\\\\(' packages/axylo/src/{dom,core}\nrg -n 'interface ResolvedReference|type ResolvedReference' -A12 packages/axylo/src/core/contracts.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/test/lookup/{fixtures,aligned.test,scatter.test,donut.test}.ts\nsed -n '1,85p' packages/axylo/test/reader/index.test.ts\nsed -n '610,647p' packages/axylo/src/core/chart.ts\nrg -n 'pointOf|formatters\\\\.count|ordinal\\\\(' packages/axylo/src/{dom,core}\nrg -n 'interface ResolvedReference|type ResolvedReference' -A12 packages/axylo/src/core/contracts.ts\"","aggregated_output":"import { SLOT_VALUE, type AlignedFrame, type AlignedView, type DonutFrame, type DonutView, type Formatters, type Frame, type Layout, type Projection, type ScatterView } from '../../src/core/contracts';\nimport { normalize, resolveOptions, type AlignedChartType, type ChartType } from '../../src/data';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { createFormatters } from '../../src/format';\nimport { defaultMessages } from '../../src/messages';\n\nconst env = { locale: 'en-US', timeZone: 'UTC' };\n\nexport function frame(type: AlignedChartType, options: unknown, revision?: number): AlignedFrame;\nexport function frame(type: 'scatter', options: unknown, revision?: number): ScatterView['frame'];\nexport function frame(type: 'donut', options: unknown, revision?: number): DonutFrame;\nexport function frame(type: ChartType, options: unknown, revision = 1): Frame {\n  const sink = new DiagnosticCollector();\n  return normalize(type, resolveOptions(type, options, sink), env, sink, { epoch: 1, revision });\n}\n\nexport function aligned(data: AlignedFrame, patch: Partial<Omit<AlignedView, 'frame'>> = {}): AlignedView {\n  const visibleSlots = patch.visibleSlots ?? { start: 0, end: data.length };\n  const xDomain = [data.x.values[visibleSlots.start] ?? 0, data.x.values[visibleSlots.end - 1] ?? 1] as const;\n  return {\n    kind: 'line', frame: data, visible: data.series.map(s => s.drawable), cues: [], compact: false,\n    xFull: xDomain, xDomain, yDomain: [0, 100], references: [], horizontal: false, stack: null,\n    revision: data.revision, visibleSlots, drawSlots: data.series.map(() => visibleSlots), ...patch,\n  };\n}\n\nexport function scatter(data: ScatterView['frame'], patch: Partial<Omit<ScatterView, 'frame'>> = {}): ScatterView {\n  return {\n    kind: 'scatter', frame: data, revision: data.revision, visible: data.series.map(s => s.drawable),\n    cues: [], compact: false, xFull: [0, 100], xDomain: [0, 100], yDomain: [0, 100], references: [],\n    visiblePoints: data.series.map(({ x }) => ({ start: 0, end: x.length })), ...patch,\n  };\n}\n\nexport function donut(data: DonutFrame): DonutView {\n  const total = data.values.reduce((sum, value, i) => sum + (data.slot[i] === SLOT_VALUE ? value : 0), 0);\n  let last = 0;\n  return {\n    kind: 'donut', frame: data, revision: data.revision, total,\n    slices: data.labels.map((label, i) => {\n      const value = data.slot[i] === SLOT_VALUE ? data.values[i]! : null;\n      const ratio = value === null ? null : value / total;\n      const angles = value ? [last, last += ratio! * 2 * Math.PI] as const : null;\n      return { key: label, label, members: [i], value, ratio, angles };\n    }),\n  };\n}\n\nexport function plot(projection: Projection, width = 100, height = 100): Extract<Layout, { kind: 'plot' }> {\n  const fit = { remedies: [], hidden: 0 } as const;\n  return {\n    kind: 'plot', width, height, plot: { x: 0, y: 0, width, height }, projection,\n    xTicks: [], yTicks: [], texts: [], fit: { x: fit, y: fit },\n  };\n}\n\nexport function formatter(data: Frame): Formatters {\n  const x = data.shape === 'aligned' ? data.x\n    : { kind: data.shape === 'points' ? data.xKind : 'category', categories: data.shape === 'donut' ? data.labels : null,\n      dateUnit: null, timeZone: data.shape === 'points' ? data.timeZone : null } as const;\n  const series = data.shape === 'aligned' ? data.series.map(s => ({ field: s.field, unit: s.unit, scale: s.valueScale }))\n    : data.shape === 'points' ? data.series.map(() => ({ field: 'y', unit: data.yUnit, scale: null }))\n      : [{ field: 'value', unit: data.unit, scale: data.valueScale }];\n  return createFormatters({\n    series, x: { field: 'x', unit: data.shape === 'points' ? data.xUnit : null, ...x }, messages: defaultMessages,\n  }, env);\n}\nimport fc from 'fast-check';\nimport { describe, expect, it } from 'vitest';\nimport type { AlignedView, DatumRef } from '../../src/core/contracts';\nimport { buildLookup } from '../../src/lookup';\nimport { defaultMessages } from '../../src/messages';\nimport { bandScale, linearScale } from '../../src/scale';\nimport { aligned, formatter, frame, plot } from './fixtures';\n\nconst datum = (seriesKey: string, x: number): DatumRef => ({ kind: 'aligned', seriesKey, x });\n\nfunction lookup(view: AlignedView) {\n  const layout = plot({ kind: 'xy', x: linearScale(view.xDomain, [0, 100]), y: linearScale(view.yDomain, [100, 0]) });\n  return buildLookup(view, layout, formatter(view.frame), defaultMessages);\n}\n\ndescribe('aligned picking', () => {\n  it('uses only visible slots, includes both plot edges, and gives midpoints to the later slot', () => {\n    // An irregular step keeps normalization from inserting missing slots between 20 and 50.\n    const data = frame('line', { data: [0, 10, 20, 50, 61].map(x => ({ x, y: 10 })), x: 'x', y: 'y' });\n    const model = lookup(aligned(data, { visibleSlots: { start: 1, end: 4 }, xDomain: [0, 50] }));\n    expect(model.pick(0, 0)).toEqual({ kind: 'x', x: 10 });\n    expect(model.pick(29.99, 90)).toEqual({ kind: 'x', x: 10 });\n    expect(model.pick(30, 90)).toEqual({ kind: 'x', x: 20 });\n    expect(model.pick(70, 10)).toEqual({ kind: 'x', x: 50 });\n    expect(model.pick(100, 100)).toEqual({ kind: 'x', x: 50 });\n    for (const [x, y] of [[-0.1, 50], [100.1, 50], [50, -0.1], [50, 100.1]] as const) expect(model.pick(x, y)).toBeNull();\n  });\n\n  it('picks a horizontal bar by y and returns the grouped mark bounds', () => {\n    const data = frame('bar', { data: [{ x: 'A', a: 2, b: 3 }, { x: 'B', a: 4, b: 5 }], x: 'x', y: ['a', 'b'] });\n    const view = aligned(data, { kind: 'bar', horizontal: true });\n    const layout = plot({ kind: 'bands', horizontal: true, band: bandScale(2, [100, 0], 0), value: linearScale([0, 10], [0, 100]) });\n    const model = buildLookup(view, layout, formatter(data), defaultMessages);\n    expect(model.pick(80, 75)).toEqual({ kind: 'x', x: 0 });\n    expect(model.pick(20, 25)).toEqual({ kind: 'x', x: 1 });\n    expect(model.anchor(datum('a', 0))).toEqual({ x: 0, y: 50, width: 20, height: 25 });\n    expect(model.anchor(datum('b', 1))).toEqual({ x: 0, y: 25, width: 50, height: 25 });\n  });\n});\n\ndescribe('aligned readout and steps', () => {\n  const data = frame('line', { x: 'x', y: { field: 'y', unit: 'ms' }, series: 'series', data: [\n    { x: 0, y: 10, series: 'A' }, { x: 1, y: 20, series: 'B' }, { x: 0, y: null, series: 'C' },\n    { x: 2, y: 30, series: 'A' }, { x: 2, y: 40, series: 'B' },\n  ] });\n\n  it('reads values, absent observations, and explicit nulls in series order', () => {\n    const model = lookup(aligned(data));\n    const target = { kind: 'x', x: 0 } as const;\n    const tooltip = model.tooltip(target);\n    expect(tooltip).toMatchObject({ title: '0', count: 3, total: null });\n    expect(tooltip.rows.map(({ seriesLabel, value, row }) => [seriesLabel, value, row])).toEqual([\n      ['A', '10 ms', 0], ['B', 'No observation', -1], ['C', 'No data', 2],\n    ]);\n    expect(model.primary(target)).toEqual(datum('A', 0));\n    expect(model.primary({ kind: 'x', x: 1 })).toEqual(datum('B', 1));\n    expect(model.anchor(datum('B', 0))).toBeNull();\n    const hidden = lookup(aligned(data, { visible: [false, true, true] }));\n    expect(hidden.tooltip(target).rows.map(row => row.seriesLabel)).toEqual(['B', 'C']);\n    expect(hidden.primary(target)).toEqual(datum('B', 0));\n  });\n\n  it('counts all nine series but returns only the first eight tooltip rows', () => {\n    const series = Array.from({ length: 9 }, (_, i) => ({ x: 0, y: i, key: `S${i}` }));\n    const model = lookup(aligned(frame('line', { data: series, x: 'x', y: 'y', series: 'key' })));\n    const { rows, count } = model.tooltip({ kind: 'x', x: 0 });\n    expect(count).toBe(9);\n    expect(rows.map(row => row.seriesLabel)).toEqual(series.slice(0, 8).map(row => row.key));\n  });\n\n  it('formats stacked totals and preserves the incomplete marker for announcements', () => {\n    const stacked = frame('area', { data: [{ x: 0, a: 3, b: null, c: -2 }, { x: 1, a: 3, b: 4, c: -2 }], x: 'x', y: ['a', 'b', 'c'] });\n    const model = lookup(aligned(stacked, { kind: 'area', stack: {\n      order: [0, 1, 2], incomplete: Uint8Array.of(1, 0),\n      positive: [Float64Array.of(3, 3), Float64Array.of(3, 7), Float64Array.of(3, 7)],\n      negative: [Float64Array.of(0, 0), Float64Array.of(0, 0), Float64Array.of(-2, -2)],\n    } }));\n    expect(model.tooltip({ kind: 'x', x: 0 }).total).toBe('1 (incomplete)');\n    expect(model.tooltip({ kind: 'x', x: 0 }).rows[1]?.value).toBe('No data');\n    expect(model.tooltip({ kind: 'x', x: 1 }).total).toBe('5');\n    expect(model.datum(datum('b', 0))?.value).toBe('No data (incomplete)');\n  });\n\n  it('steps within a series, switches series at the same x, and ranks by x then series', () => {\n    const model = lookup(aligned(data));\n    expect(model.step(null, 'next')).toEqual(datum('A', 0));\n    expect(model.step(datum('A', 0), 'next')).toEqual(datum('A', 2));\n    expect(model.step(datum('A', 2), 'previous')).toEqual(datum('A', 0));\n    expect(model.step(datum('A', 0), 'series-next')).toEqual(datum('B', 0));\n    expect(model.step(datum('B', 0), 'series-previous')).toEqual(datum('A', 0));\n    expect(model.datum(datum('B', 0))?.value).toBe('No observation');\n    expect(model.ordinal(datum('B', 0))).toBe(-1);\n    expect(model.step(datum('B', 0), 'first')).toEqual(datum('B', 1));\n    expect(model.step(datum('B', 1), 'last')).toEqual(datum('B', 2));\n    expect([datum('A', 0), datum('B', 1), datum('A', 2), datum('B', 2)].map(ref => model.ordinal(ref))).toEqual([0, 1, 2, 3]);\n    expect(model.count).toBe(4);\n  });\n\n  it('pages by a tenth of the visible slots, then skips a gap in the direction of travel', () => {\n    const data = frame('line', { data: Array.from({ length: 50 }, (_, x) => ({ x, y: x === 11 ? null : x })), x: 'x', y: 'y' });\n    const model = lookup(aligned(data, { visibleSlots: { start: 8, end: 28 } }));\n    expect(model.step(datum('y', 9), 'page-next')).toEqual(datum('y', 12));\n    expect(model.step(datum('y', 13), 'page-previous')).toEqual(datum('y', 10));\n    expect(model.step(datum('y', 13), 'first')).toEqual(datum('y', 8));\n    expect(model.step(datum('y', 13), 'last')).toEqual(datum('y', 27));\n    expect(model.step(datum('y', 27), 'page-next')).toBeNull();\n  });\n\n  it('walks every observation of the visible series with the correct identity and ordinal', () => {\n    fc.assert(fc.property(fc.array(fc.option(fc.integer({ min: 0, max: 99 }), { nil: null }), { maxLength: 50 }),\n      fc.nat(50), fc.nat(50), (values, a, b) => {\n        const start = Math.min(a, b, values.length);\n        const end = Math.min(Math.max(a, b), values.length);\n        const data = frame('line', { data: values.map((y, x) => ({ x, y, hidden: 1 })), x: 'x', y: ['y', 'hidden'] });\n        const model = lookup(aligned(data, { visibleSlots: { start, end }, visible: [true, false] }));\n        const expected = values.flatMap((value, x) => value !== null && x >= start && x < end ? [x] : []);\n        expect(model.count).toBe(expected.length);\n        let current = model.step(null, 'next');\n        for (const [ordinal, x] of expected.entries()) {\n          expect(current).toEqual(datum('y', x));\n          expect(model.ordinal(current!)).toBe(ordinal);\n          expect(model.datum(current!)).not.toBeNull();\n          expect(model.resolve(current!)).toBe(current);\n          current = model.step(current, 'next');\n        }\n        expect(current).toBeNull();\n      }), { numRuns: 100 });\n  });\n\n  it('resolves identity across eviction and anchors a survivor at its new pixel', () => {\n    function window(start: number, revision: number) {\n      const first = frame('line', { data: Array.from({ length: 11 }, (_, i) => ({ x: start + i, y: 20 })), x: 'x', y: 'y' }, revision);\n      // Retained source rows keep their original indexes across an append in the same epoch.\n      return lookup(aligned({ ...first, series: first.series.map(s => ({ ...s, row: Int32Array.from(s.y, (_, i) => start + i) })) }));\n    }\n    const first = window(0, 1);\n    const second = window(5, 2);\n    const surviving = datum('y', 7);\n    const evicted = datum('y', 3);\n    expect(second.resolve(surviving)).toBe(surviving);\n    expect(second.datum(surviving)).toEqual(first.datum(surviving));\n    expect(second.datum(evicted)).toBeNull();\n    expect(second.resolve(evicted)).toEqual(datum('y', 5));\n    expect(second.resolve(datum('y', 17))).toEqual(datum('y', 15));\n    expect(first.anchor(surviving)).toEqual({ x: 70, y: 80, width: 0, height: 0 });\n    expect(second.anchor(surviving)).toEqual({ x: 20, y: 80, width: 0, height: 0 });\n  });\n});\nimport fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport type { DatumRef } from '../../src/core/contracts';\nimport { buildLookup } from '../../src/lookup';\nimport { scatterLookup } from '../../src/lookup/scatter';\nimport { defaultMessages } from '../../src/messages';\nimport { linearScale } from '../../src/scale';\nimport { formatter, frame, plot, scatter } from './fixtures';\n\nconst point = (seriesKey: string, row: number): DatumRef => ({ kind: 'point', seriesKey, row });\nconst layout = plot({ kind: 'xy', x: linearScale([0, 100], [0, 100]), y: linearScale([0, 100], [0, 100]) });\n\nit('picks the nearest point within 24 px and breaks a tie by later source row', () => {\n  const data = frame('scatter', { data: [{ x: 60, y: 50 }, { x: 40, y: 50 }], x: 'x', y: 'y' });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const tie = model.pick(50, 50)!;\n  expect(tie).toEqual({ kind: 'point', refs: [point('y', 1)], count: 1 });\n  expect(model.primary(tie)).toEqual(point('y', 1));\n  expect(model.tooltip(tie)).toMatchObject({ title: '40', count: 1, total: null, rows: [{ seriesLabel: 'y', x: '40', value: '50', row: 1 }] });\n  expect(model.anchor(point('y', 1))).toEqual({ x: 40, y: 50, width: 0, height: 0 });\n  expect(model.pick(16, 50)).toEqual({ kind: 'point', refs: [point('y', 1)], count: 1 });\n  expect(model.pick(15.99, 50)).toBeNull();\n  expect(model.pick(58, 50)).toEqual({ kind: 'point', refs: [point('y', 0)], count: 1 });\n});\n\nit('finds coincident points across a cell boundary and retains the full count after truncation', () => {\n  const points = Array.from({ length: 10 }, (_, i) => ({ x: i % 2 ? 24.1 : 23.9, y: 50, series: `S${i}` }));\n  const input = { x: 'x', y: 'y', series: 'series' };\n  const small = frame('scatter', { ...input, data: points.slice(0, 3) });\n  const all = buildLookup(scatter(small), layout, formatter(small), defaultMessages).pick(23.9, 50)!;\n  expect(all.kind).toBe('point');\n  if (all.kind !== 'point') throw new Error('Expected scatter target');\n  expect(all.count).toBe(3);\n  expect(all.refs[0]).toEqual(point('S2', 2));\n  expect(all.refs).toEqual(expect.arrayContaining([point('S0', 0), point('S1', 1), point('S2', 2)]));\n\n  const data = frame('scatter', { ...input, data: [...points, { x: 24.7, y: 50, series: 'Different' }] });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const target = model.pick(24.1, 50)!;\n  expect(target).toMatchObject({ kind: 'point', count: 10 });\n  expect(model.primary(target)).toEqual(point('S9', 9));\n  expect(model.tooltip(target).rows).toHaveLength(8);\n  expect(model.tooltip(target).count).toBe(10);\n  expect(model.tooltip(target).rows.some(row => row.seriesLabel === 'Different')).toBe(false);\n});\n\nit('uses screen distance when moving to the neighbouring visible series', () => {\n  const data = frame('scatter', { x: 'x', y: 'y', series: 'series', data: [\n    { x: 10, y: 30, series: 'A' }, { x: 11, y: 31, series: 'Hidden' },\n    { x: 10, y: 80, series: 'B' }, { x: 12, y: 31, series: 'B' },\n  ] });\n  const model = buildLookup(scatter(data, { visible: [true, false, true] }), layout, formatter(data), defaultMessages);\n  expect(model.count).toBe(3);\n  expect(model.step(point('A', 0), 'next')).toEqual(point('B', 2));\n  expect(model.step(point('A', 0), 'series-next')).toEqual(point('B', 3));\n  expect(model.step(point('B', 3), 'series-previous')).toEqual(point('A', 0));\n});\n\nit('examines only nearby cells on a 200,000-point pick', () => {\n  const size = 200_000;\n  const x = Float64Array.from({ length: size }, (_, i) => i);\n  const y = Float64Array.from(x, i => i % 521);\n  const data = frame('scatter', { data: { columns: { x, y } }, x: 'x', y: 'y' });\n  const projection = { kind: 'xy', x: linearScale([0, size - 1], [0, 1200]), y: linearScale([0, 520], [520, 0]) } as const;\n  const model = scatterLookup(scatter(data), plot(projection, 1200, 520), formatter(data));\n  const i = 98_765;\n  expect(model.primary(model.pick(projection.x.map(i), 520 - (i % 521))!)).toEqual(point('y', i));\n  expect(model.lastPickCandidates).toBeGreaterThan(0);\n  expect(model.lastPickCandidates).toBeLessThan(5_000);\n});\n\nit('walks a multi-series scatter in fixture x and y order with consistent ranks and refs', () => {\n  fc.assert(fc.property(fc.array(fc.array(fc.integer({ min: 0, max: 6 }), { minLength: 1, maxLength: 17 }),\n    { minLength: 1, maxLength: 6 }), lists => {\n    const rows = lists.flatMap((ys, s) => ys.map((y, x) => ({ x, y, series: `S${s}` })));\n    const data = frame('scatter', { data: rows, x: 'x', y: 'y', series: 'series' });\n    const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n    const expected = rows.map((row, i) => ({ ...row, i })).sort((a, b) => a.x - b.x || a.y - b.y || a.i - b.i);\n    expect(model.count).toBe(expected.length);\n    let next = model.step(null, 'next');\n    for (const [i, row] of expected.entries()) {\n      expect(next).toEqual(point(row.series, row.i));\n      expect(model.ordinal(next!)).toBe(i);\n      expect(model.datum(next!)?.value).toBe(String(row.y));\n      expect(model.resolve(next!)).toBe(next);\n      next = model.step(next, 'next');\n    }\n    expect(next).toBeNull();\n  }), { numRuns: 60 });\n});\nimport { expect, it } from 'vitest';\nimport type { DatumRef } from '../../src/core/contracts';\nimport { buildLookup } from '../../src/lookup';\nimport { defaultMessages } from '../../src/messages';\nimport { donut, formatter, frame, plot } from './fixtures';\n\nconst parts = [\n  ['Chrome', 46.2], ['Safari', 27.5], ['Edge', 14.1], ['Firefox', 8.9], ['Samsung Internet', 2.1], ['Other', 1.2],\n] as const;\nconst layout = plot({ kind: 'ring', cx: 50, cy: 50, r0: 20, r1: 40 });\nconst data = frame('donut', { data: [...parts, ['Zero', 0], ['No sample', null]].map(([category, value]) => ({ category, value })),\n  label: 'category', value: { field: 'value', scale: 'percent' } });\nconst model = buildLookup(donut(data), layout, formatter(data), defaultMessages, 'en-US');\n\nit('picks the parts fixture from 12 o’clock clockwise within the ring', () => {\n  expect(model.pick(50, 20)).toEqual({ kind: 'slice', sliceKey: 'Chrome' });\n  expect(model.pick(80, 50)).toEqual({ kind: 'slice', sliceKey: 'Chrome' });\n  expect(model.pick(50, 80)).toEqual({ kind: 'slice', sliceKey: 'Safari' });\n  expect(model.pick(50, 50)).toBeNull();\n  expect(model.pick(50, 5)).toBeNull();\n  const target = model.pick(50, 20)!;\n  expect(model.tooltip(target)).toMatchObject({ title: 'Chrome', count: 1, total: null,\n    rows: [{ value: '46.2%', percent: '46.2%', seriesLabel: 'Chrome', row: 0 }] });\n  const anchor = model.anchor(model.primary(target)!);\n  expect(anchor?.x).toBeCloseTo(50);\n  expect(anchor?.y).toBeCloseTo(10);\n  expect(anchor?.width).toBeCloseTo(40);\n  expect(anchor?.height).toBeCloseTo(40 * (1 - Math.cos(0.462 * 2 * Math.PI)));\n});\n\nit('includes zero and missing slices in keyboard order, with no drawn anchor', () => {\n  const zero: DatumRef = { kind: 'slice', sliceKey: 'Zero' };\n  const missing: DatumRef = { kind: 'slice', sliceKey: 'No sample' };\n  expect(model.count).toBe(8);\n  expect(model.step({ kind: 'slice', sliceKey: 'Other' }, 'next')).toEqual(zero);\n  expect(model.step(zero, 'next')).toEqual(missing);\n  expect(model.ordinal(zero)).toBe(6);\n  expect(model.anchor(zero)).toBeNull();\n  expect(model.anchor(missing)).toBeNull();\n  expect(model.datum(zero)).toMatchObject({ value: '0%', percent: '0%' });\n  expect(model.datum(missing)).toMatchObject({ value: 'No data', percent: null });\n});\nimport { expect, it, vi } from 'vitest';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { defaultMessages, resolveMessages } from '../../src/messages';\nimport { buildReader, type ReaderInput } from '../../src/reader';\nimport { aligned, donut, formatter, frame, scatter } from '../lookup/fixtures';\n\nfunction read(view: ReaderInput['view'], input: Partial<ReaderInput> = {}) {\n  return buildReader({ view, formatters: formatter(view.frame), messages: defaultMessages, type: 'Line', locale: 'en-US', ...input });\n}\n\nconst trend = aligned(frame('line', {\n  x: { field: 'day', label: 'Day' }, y: { field: 'sessions', label: 'Sessions' }, series: 'channel', data: [\n    { day: 0, sessions: 90, channel: 'Direct' }, { day: 0, sessions: 90, channel: 'Search' }, { day: 0, sessions: 90, channel: 'Referral' },\n    { day: 1, sessions: 10, channel: 'Direct' }, { day: 1, sessions: 20, channel: 'Search' }, { day: 1, sessions: 7, channel: 'Referral' },\n    { day: 2, sessions: 30, channel: 'Direct' }, { day: 2, sessions: 12, channel: 'Search' }, { day: 2, sessions: 5, channel: 'Referral' },\n    { day: 3, sessions: 20, channel: 'Direct' }, { day: 3, sessions: null, channel: 'Search' }, { day: 3, sessions: 8, channel: 'Referral' },\n  ],\n}), { visibleSlots: { start: 1, end: 4 }, references: [{ axis: 'y', from: 20, to: 20, label: 'Target' }] });\n\nit('summarizes three visible series within the shown range and names the reference', () => {\n  const model = read(trend, { title: { text: 'Daily sessions', visible: false }, subtitle: 'Acquisition channels' });\n  expect(model.name).toBe('Daily sessions');\n  expect(model.summary).toBe('Line chart with 3 series. Day from 1 to 3. Sessions from 5 to 30. '\n    + 'Direct: minimum 10, maximum 30, last 20. Search: minimum 12, maximum 20, last 12. '\n    + 'Referral: minimum 5, maximum 8, last 8. Reference: Target. Acquisition channels');\n  expect(model.note).toBeNull();\n  expect(model.table?.caption).toBe('Daily sessions');\n});\n\nit('adds the zone for instants and leaves it out for calendar dates', () => {\n  function byDay(start: string, end: string) {\n    return aligned(frame('line', { data: [{ day: start, value: 1 }, { day: end, value: 5 }],\n      x: { field: 'day', timeZone: 'America/Los_Angeles' }, y: 'value' }));\n  }\n  const time = read(byDay('2026-02-24T12:00:00Z', '2026-02-25T13:00:00Z'));\n  const dates = read(byDay('2026-02-24', '2026-02-25'));\n  expect(time.summary).toContain('Times are shown in America/Los_Angeles.');\n  expect(time.table?.pageForX(new Date('2026-02-25T12:00:00Z'))).toBe(0);\n  expect(dates.summary).not.toContain('Times are shown');\n  expect(dates.table?.pageForX('2026-02-25')).toBe(0);\n  expect(dates.table?.pageForX('2026-02-30')).toBeNull();\n});\n\nit('keeps disclosures before the author description and joins both visible notes', () => {\n  const input = { description: 'The reporting period was revised.', disclosure: { omitted: 2, changed: 1 }, labelsHidden: 4 };\n  const model = read(trend, input);\n  expect(model.summary).toMatch(/3 values not shown\\. See table\\. The reporting period was revised\\.$/);\n  expect(model.note).toBe('3 values not shown. See table. Some labels hidden. See table.');\n  const custom = read(trend, { ...input, messages: resolveMessages({ valuesNotShown: 'Omitted {omitted}, changed {changed}.' }) });\n  expect(custom.note).toBe('Omitted 2, changed 1. Some labels hidden. See table.');\n  expect(read(trend, { disclosure: { omitted: 0, changed: 1 }, compact: true }).summary).toContain('1 values not shown. See table.');\n});\n\nit('uses the external heading when supplied, otherwise generates and reports a missing name', () => {\n  const diagnostics = new DiagnosticCollector();\n  expect(read(trend, { labelledBy: 'heading', diagnostics }).name).toBe('');\n  expect(diagnostics.inputs()).toEqual([]);\n  expect(read(trend, { diagnostics }).name).toBe('Line chart of Sessions by Day');\n  expect(diagnostics.inputs()).toMatchObject([{ code: 'AX140', effect: 'none' }]);\n  expect(read(trend, { messages: resolveMessages({ chartName: '{x} and {y} ({type})' }) }).name).toBe('Day and Sessions (Line)');\n});\n\nit('formats one requested row of a million-row table and finds its page by x', () => {\n  const size = 1_000_000;\n  const x = Float64Array.from({ length: size }, (_, i) => i * 2);\n  const duration = Float64Array.from(x, v => v / 2 + 0.5);\n  const hidden = Float64Array.from(x, v => v / 2 + 2);\n  const data = frame('line', { data: { columns: { x, duration, hidden } }, x: { field: 'x', label: 'Index' },\n    y: [{ field: 'duration', label: 'Duration', unit: 'ms' }, { field: 'hidden', label: 'Bytes', unit: 'B' }] });\n  expect(data.x.values).toBe(x);\n  const formatters = formatter(data);\n  const formatX = vi.fn(formatters.x);\n  const formatValue = vi.fn(formatters.value);\n  const view = aligned(data, { visible: [true, false] });\n  const start = performance.now();\n  const model = read(view, { title: 'Timing', formatters: { ...formatters, x: formatX, value: formatValue } });\n  expect(formatX).not.toHaveBeenCalled();\n  expect(formatValue).not.toHaveBeenCalled();\n  const table = model.table!;\n  expect(table.headers).toEqual(['Index', 'Duration (ms)', 'Bytes (B)']);\n  expect(table.rowCount).toBe(size);\n  expect(table.pageSize).toBe(100);\n  expect(table.row(900_000)).toEqual(['1,800,000', '900,000.5 ms', '900,002 B']);\n  expect(table.pageForX(1_799_999)).toBe(9000);\n  expect(table.pageForX(1_800_000)).toBe(9000);\n\n      // Lookup and reader read the frame through the view; they switch with the marks.\n      const lookupInputs = [view, layout, formatters, a.messages, locale];\n      let lookup = drawn?.lookup;\n      if (!lookup || !drawn || !sameKey(drawn.lookupInputs, lookupInputs)) {\n        stage('lookup');\n        lookup = buildLookup(view, layout, formatters, a.messages, locale);\n      }\n      const all = [...a.optionDiagnostics, ...a.dataDiagnostics, ...a.viewDiagnostics, ...presentation.values()];\n      const disclosure = readerDisclosure(all);\n      const labelsHidden = layout.kind === 'plot' ? layout.fit.x.hidden + layout.fit.y.hidden : 0;\n      const readerInputs = [view, formatters, a.messages, a.options.title, a.options.labelledBy, a.options.subtitle,\n        a.options.description, disclosure.omitted, disclosure.changed, labelsHidden, a.options.table, compact, locale];\n      let reader = drawn?.reader;\n      if (!reader || !drawn || !sameKey(drawn.readerInputs, readerInputs)) {\n        stage('reader');\n        const title = a.options.title;\n        reader = buildReader({\n          view, formatters, messages: a.messages, type: KIND_NAMES[kind],\n          title: typeof title === 'string' || (title && typeof title === 'object') ? title as string | Title : undefined,\n          labelledBy: stringOption(a.options, 'labelledBy') ?? undefined,\n          subtitle: stringOption(a.options, 'subtitle') ?? undefined,\n          description: stringOption(a.options, 'description') ?? undefined,\n          disclosure, labelsHidden, table: a.options.table !== false, compact, locale,\n        });\n      }\n\n      // Marks: drawn again for a new scene, a new theme or a new pixel ratio, never rebuilt for a theme alone.\n      const paintInputs = [scene, themeRevision, pixelRatio];\n      if (measured && (!drawn || !sameKey(drawn.paintInputs, paintInputs))) {\n        stage('draw');\n        renderer.draw(scene, theme!.bindings, theme!.theme, pixelRatio);\n      }\n      const texts = layout.kind === 'plot' ? layout.texts : [];\n      if (!drawn || drawn.layout !== layout || (drawn.layout.kind === 'plot') !== (layout.kind === 'plot')) {\n        stage('text');\n        textLayer.render(texts);\n      }\npackages/axylo/src/core/contracts.ts:625:  ordinal(ref: DatumRef): number;\npackages/axylo/src/core/chart.ts:748:    if (changed) emit('hover', pointOf(d, target));\npackages/axylo/src/core/chart.ts:755:  function pointOf(d: Drawn, target: PickTarget): Point<unknown> | null {\n233:export interface ResolvedReference {\n234-  readonly axis: 'x' | 'y';\n235-  readonly from: number;\n236-  /** Equal to `from` for a line. */\n237-  readonly to: number;\n238-  readonly label: string;\n239-}\n240-\n241-/** How one series is told apart without color (spec A5): a marker shape and dash patterns. */\n242-export interface SeriesCue {\n243-  readonly marker: MarkerShape;\n244-  readonly dash: DashStyle;\n245-}\n","exit_code":0,"status":"completed"}}
