ex | null {\n    if (!Number.isInteger(ordinal) || ordinal < 0 || ordinal >= count) return null;\n    if (active.length === 1) {\n      const s = active[0]!;\n      return { series: s, index: ranges[s]!.start + ordinal };\n    }\n    const remaining = active.slice();\n    const starts = remaining.map(s => ranges[s]!.start);\n    while (remaining.length > 1) {\n      // The smallest sampled point has at most `stride - 1` predecessors in each list.\n      // Discarding its prefix removes no more than `ordinal` points before the target.\n      const stride = Math.max(1, Math.floor(ordinal / remaining.length));\n      let chosen = 0;\n      let sampled = Math.min(starts[0]! + stride, ranges[remaining[0]!]!.end) - 1;\n      for (let k = 1; k < remaining.length; k++) {\n        const s = remaining[k]!;\n        const i = Math.min(starts[k]! + stride, ranges[s]!.end) - 1;\n        if (compare(s, i, remaining[chosen]!, sampled) < 0) {\n          chosen = k;\n          sampled = i;\n        }\n      }\n      if (ordinal === 0) return { series: remaining[chosen]!, index: sampled };\n      ordinal -= sampled + 1 - starts[chosen]!;\n      starts[chosen] = sampled + 1;\n      if (starts[chosen] === ranges[remaining[chosen]!]!.end) {\n        starts.splice(chosen, 1);\n        remaining.splice(chosen, 1);\n      }\n    }\n    return { series: remaining[0]!, index: starts[0]! + ordinal };\n  }\n\n  function ordinal(s: number, i: number): number {\n    const range = ranges[s];\n    if (!range || i < range.start || i >= range.end) return -1;\n    let before = 0;\n    for (const t of active) {\n      let { start, end } = ranges[t]!;\n      const first = start;\n      while (start < end) {\n        const mid = start + Math.floor((end - start) / 2);\n        if (compare(t, mid, s, i) < 0) start = mid + 1;\n        else end = mid;\n      }\n      before += start - first;\n    }\n    return before;\n  }\n\n  function beforeX(x: number): number {\n    let before = 0;\n    for (const s of active) {\n      const { start, end } = ranges[s]!;\n      before += lowerBound(series[s]!.x, x, start, end) - start;\n    }\n    return before;\n  }\n\n  return { at, ordinal, beforeX, count };\n}\nimport type { ScatterView } from '../core/contracts';\nimport { contains, type PlotLayout } from './geometry';\n\nconst CELL = 24;\nconst RADIUS2 = CELL * CELL;\nconst COINCIDENT2 = 0.5 ** 2;\nexport const POINT_LIMIT = 8;\n\nexport function scatterGrid(view: ScatterView, layout: PlotLayout & { projection: Extract<PlotLayout['projection'], { kind: 'xy' }> }, count: number) {\n  const { plot, projection } = layout;\n  const columns = Math.floor(plot.width / CELL) + 1;\n  const rows = Math.floor(plot.height / CELL) + 1;\n  const heads = new Map<number, number>();\n  const next = new Int32Array(count);\n  const series = new Uint32Array(count);\n  const points = new Uint32Array(count);\n  const xs = new Float64Array(count);\n  const ys = new Float64Array(count);\n  let length = 0;\n  let examined = 0;\n\n  const column = (x: number) => Math.floor((x - plot.x) / CELL);\n  const row = (y: number) => Math.floor((y - plot.y) / CELL);\n  view.frame.series.forEach((data, s) => {\n    if (!view.visible[s] || !data.drawable) return;\n    const { start, end } = view.visiblePoints[s]!;\n    for (let i = start; i < end; i++) {\n      const x = projection.x.map(data.x[i]!);\n      const y = projection.y.map(data.y[i]!);\n      if (!contains(plot, x, y)) continue;\n      const cell = column(x) + columns * row(y);\n      const at = length++;\n      next[at] = heads.get(cell) ?? -1;\n      heads.set(cell, at);\n      xs[at] = x;\n      ys[at] = y;\n      series[at] = s;\n      points[at] = i;\n    }\n  });\n\n  function visit(x: number, y: number, radius: number, examine: (at: number, distance: number) => void): void {\n    const left = Math.max(0, column(x - radius));\n    const right = Math.min(columns - 1, column(x + radius));\n    const top = Math.max(0, row(y - radius));\n    const bottom = Math.min(rows - 1, row(y + radius));\n    for (let cy = top; cy <= bottom; cy++) {\n      for (let cx = left; cx <= right; cx++) {\n        for (let at = heads.get(cx + cy * columns) ?? -1; at >= 0; at = next[at]!) {\n          examined++;\n          examine(at, (xs[at]! - x) ** 2 + (ys[at]! - y) ** 2);\n        }\n      }\n    }\n  }\n\n  function sourceRow(at: number): number {\n    const i = points[at]!;\n    return view.frame.series[series[at]!]!.row?.[i] ?? i;\n  }\n\n  return {\n    series, points,\n    get examined() { return examined; },\n    pick(x: number, y: number) {\n      examined = 0;\n      if (!contains(plot, x, y)) return null;\n      let nearest = -1;\n      let bestDistance = RADIUS2;\n      visit(x, y, CELL, (at, distance) => {\n        if (distance < bestDistance || distance === bestDistance && (nearest < 0 || sourceRow(at) > sourceRow(nearest))) {\n          nearest = at;\n          bestDistance = distance;\n        }\n      });\n      if (nearest < 0) return null;\n      const hits = [nearest];\n      let count = 1;\n      visit(xs[nearest]!, ys[nearest]!, 0.5, (at, distance) => {\n        if (at === nearest || distance > COINCIDENT2) return;\n        count++;\n        if (hits.length < POINT_LIMIT) hits.push(at);\n      });\n      return { hits, count };\n    },\n  };\n}\nexport function lowerBound(values: ArrayLike<number>, value: number, start = 0, end = values.length): number {\n  while (start < end) {\n    const mid = start + Math.floor((end - start) / 2);\n    if (values[mid]! < value) start = mid + 1;\n    else end = mid;\n  }\n  return start;\n}\n\nexport function pageDistance(count: number): number {\n  return Math.max(1, Math.floor(count / 10));\n}\nimport type { DatumRef, DonutView, Formatters, Lookup, Rect } from '../core/contracts';\nimport { contains, type PlotLayout } from './geometry';\nimport { pageDistance } from './search';\nimport { sliceText } from './text';\n\nconst TURN = 2 * Math.PI;\n\nfunction sectorBox(cx: number, cy: number, inner: number, outer: number, start: number, end: number): Rect {\n  let left = Infinity;\n  let right = -Infinity;\n  let top = Infinity;\n  let bottom = -Infinity;\n  function include(angle: number, radius: number) {\n    const x = cx + Math.sin(angle) * radius;\n    const y = cy - Math.cos(angle) * radius;\n    left = Math.min(left, x);\n    right = Math.max(right, x);\n    top = Math.min(top, y);\n    bottom = Math.max(bottom, y);\n  }\n  for (const radius of [inner, outer]) {\n    include(start, radius);\n    include(end, radius);\n    const quarter = Math.PI / 2;\n    for (let angle = Math.ceil(start / quarter) * quarter; angle < end; angle += quarter) include(angle, radius);\n  }\n  return { x: left, y: top, width: right - left, height: bottom - top };\n}\n\nexport function donutLookup(view: DonutView, layout: PlotLayout | null, formatters: Formatters, locale: string): Lookup {\n  const { slices } = view;\n  const keys = new Map(slices.map((slice, i) => [slice.key, i]));\n  const ring = layout?.projection.kind === 'ring' ? layout.projection : null;\n  const index = (datum: DatumRef) => datum.kind === 'slice' ? keys.get(datum.sliceKey) ?? -1 : -1;\n\n  function ref(i: number): DatumRef | null {\n    const slice = slices[i];\n    return slice ? { kind: 'slice', sliceKey: slice.key } : null;\n  }\n\n  const lookup: Lookup = {\n    pick(px, py) {\n      if (!ring || !layout || !contains(layout.plot, px, py) || !(ring.r1 > ring.r0)) return null;\n      const dx = px - ring.cx;\n      const dy = py - ring.cy;\n      const radius = Math.hypot(dx, dy);\n      if (radius < ring.r0 || radius > ring.r1) return null;\n      const raw = Math.atan2(dx, -dy);\n      const angle = raw < 0 ? raw + TURN : raw;\n      const slice = slices.find(slice => slice.angles && angle >= slice.angles[0] && angle < slice.angles[1]);\n      return slice ? { kind: 'slice', sliceKey: slice.key } : null;\n    },\n    tooltip(target) {\n      const datum = target.kind === 'slice' ? lookup.datum(target) : null;\n      return { title: datum?.seriesLabel ?? '', rows: datum ? [datum] : [], count: datum ? 1 : 0, total: null };\n    },\n    primary(target) { return target.kind === 'slice' && keys.has(target.sliceKey) ? target : null; },\n    datum(datum) {\n      const i = index(datum);\n      if (i < 0) return null;\n      const { label, value, percent, state, row } = sliceText(view, slices[i]!, formatters, locale);\n      return { ref: datum, seriesIndex: i, seriesLabel: label, x: label, value, percent, state, row };\n    },\n    anchor(datum) {\n      const angles = slices[index(datum)]?.angles;\n      return ring && ring.r1 > ring.r0 && angles && angles[1] > angles[0]\n        ? sectorBox(ring.cx, ring.cy, ring.r0, ring.r1, ...angles) : null;\n    },\n    count: slices.length,\n    ordinal: index,\n    step(from, direction) {\n      if (!from) return ref(0);\n      const i = index(from);\n      if (i < 0) return null;\n      switch (direction) {\n        case 'next': return ref(i + 1);\n        case 'previous': return ref(i - 1);\n        case 'first': return ref(0);\n        case 'last': return ref(slices.length - 1);\n        case 'page-next': return ref(Math.min(slices.length - 1, i + pageDistance(slices.length)));\n        case 'page-previous': return ref(Math.max(0, i - pageDistance(slices.length)));\n        case 'series-next':\n        case 'series-previous': return null;\n      }\n    },\n    resolve(datum) { return index(datum) < 0 ? null : datum; },\n  };\n  return lookup;\n}\nimport { SLOT_NULL, SLOT_VALUE, type DonutView, type DonutSlice, type Formatters, type SlotState } from '../core/contracts';\nimport { defaultReadoutNumber } from '../format';\nimport type { Messages } from '../public';\nimport { fill } from '../messages';\n\nexport function slotText(formatters: Formatters, series: number, value: number, state: SlotState): string {\n  return state === SLOT_VALUE ? formatters.value(series, value) : formatters.missing(state);\n}\n\nexport function incomplete(text: string, messages: Messages): string {\n  return `${text} (${fill(messages.incompleteStack, {})})`;\n}\n\nexport function sliceText(view: DonutView, slice: DonutSlice, formatters: Formatters, locale: string) {\n  const { frame } = view;\n  const member = slice.members[0];\n  const single = slice.members.length === 1 && member !== undefined;\n  let state = single ? frame.slot[member] as SlotState : SLOT_NULL;\n  let value = 0;\n  for (const i of slice.members) {\n    if (frame.slot[i] === SLOT_VALUE) {\n      value += frame.values[i]!;\n      state = SLOT_VALUE;\n    }\n  }\n  return {\n    label: single ? frame.labels[member]! : slice.label,\n    value: slotText(formatters, 0, value, state),\n    percent: state === SLOT_VALUE ? Number.isFinite(view.total) ? donutPercent(value, view.total, locale)\n      : defaultReadoutNumber(slice.ratio ?? 0, locale, 'ratio') : null,\n    state,\n    row: single ? frame.row?.[member] ?? member : -1,\n  };\n}\n\nexport function donutPercent(value: number, total: number, locale: string): string {\n  return defaultReadoutNumber(total > 0 ? value / total : 0, locale, 'ratio');\n}\nimport type { Layout, Rect } from '../core/contracts';\n\nexport type PlotLayout = Extract<Layout, { kind: 'plot' | 'compact' }>;\n\nexport function contains(rect: Rect, x: number, y: number): boolean {\n  return x >= rect.x && x <= rect.x + rect.width && y >= rect.y && y <= rect.y + rect.height;\n}\n\nexport function pointBox(x: number, y: number): Rect {\n  return { x, y, width: 0, height: 0 };\n}\n\nexport function clipBox(box: Rect, plot: Rect): Rect | null {\n  const x = Math.max(box.x, plot.x);\n  const y = Math.max(box.y, plot.y);\n  const right = Math.min(box.x + box.width, plot.x + plot.width);\n  const bottom = Math.min(box.y + box.height, plot.y + plot.height);\n  return x <= right && y <= bottom ? { x, y, width: right - x, height: bottom - y } : null;\n}\n","exit_code":0,"status":"completed"}}
