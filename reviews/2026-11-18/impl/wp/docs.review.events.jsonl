eColors): string {\n    22\t  const pair = (a: string, b: string) => `light-dark(${a}, ${b})`;\n    23\t  const series = light.series.map((v, i) => `    --axylo-default-series-${i + 1}: ${pair(v, dark.series[i]!)};`).join('\\n');\n    24\t  return `${series}\n    25\t    --axylo-default-background: ${pair(light.background, dark.background)};\n    26\t    --axylo-default-axis: ${pair(light.axis, dark.axis)};\n    27\t    --axylo-default-grid: ${pair(light.grid, dark.grid)};\n    28\t    --axylo-default-muted: ${pair(light.muted, dark.muted)};\n    29\t    --axylo-default-reference: ${pair(light.reference, dark.reference)};\n    30\t    --axylo-default-focus: ${pair(light.focus, dark.focus)};`;\n    31\t}\n    32\t\n    33\tfunction tokens(c: SchemeColors): string {\n    34\t  const series = c.series.map((v, i) => `    --axylo-default-series-${i + 1}: ${v};`).join('\\n');\n    35\t  return `${series}\n    36\t    --axylo-default-background: ${c.background};\n    37\t    --axylo-default-axis: ${c.axis};\n    38\t    --axylo-default-grid: ${c.grid};\n    39\t    --axylo-default-muted: ${c.muted};\n    40\t    --axylo-default-reference: ${c.reference};\n    41\t    --axylo-default-focus: ${c.focus};`;\n    42\t}\n    43\t\n    44\t// Forced colors: every paint becomes a system color. `!important` so an author's custom property, whether\n    45\t// inherited or set on the chart, cannot leak a brand color into a mode where the user chose the colors.\n    46\t// `--axylo-forced-series` switches off the author's pinned series colors (resolveTheme writes each as\n    47\t// `var(--axylo-forced-series, <author color>)` on the chart root), so they return when forced colors ends.\n    48\tconst forced = [\n    49\t  ...LIGHT.series.map((_, i) => `    --axylo-series-${i + 1}: CanvasText !important;`),\n    50\t  '    --axylo-forced-series: CanvasText !important;',\n    51\t  '    --axylo-background: Canvas !important;',\n    52\t  '    --axylo-default-background: Canvas !important;',\n    53\t  '    --axylo-text: CanvasText !important;',\n    54\t  '    --axylo-axis: CanvasText !important;',\n    55\t  '    --axylo-grid: GrayText !important;',\n    56\t  '    --axylo-muted: GrayText !important;',\n    57\t  '    --axylo-reference: CanvasText !important;',\n    58\t  '    --axylo-focus: Highlight !important;',\n    59\t].join('\\n');\n    60\t\n    61\texport const AXYLO_CSS = `/* Axylo default stylesheet */\n    62\t@layer axylo {\n    63\t  /* Lets ensureStyles find this sheet; it checks the sheet's effect as well, not only this sentinel. */\n    64\t  :root { --axylo-stylesheet: loaded; }\n    65\t\n    66\t  /*\n    67\t   * tokens: private defaults that follow the chart's used colour scheme (spec L4). Where the page gives the\n    68\t   * chart a color-scheme (light dark, dark, light, only …), resolveTheme writes no scheme attribute and these\n    69\t   * apply: a prefers-color-scheme change switches every var(--axylo-default-…) in the same frame as the media\n    70\t   * query, with no script (the SVG marks reference them; the canvas renderer repaints when the change event\n    71\t   * arrives, one frame behind). light-dark() is supported by the current and previous major versions of the\n    72\t   * four browsers in spec 2.3.\n    73\t   */\n    74\t  .axylo {\n    75\t${following(LIGHT, DARK)}\n    76\t  }\n    77\t\n    78\t  /* tokens: one fixed set, where the chart resolved its scheme itself (color-scheme normal; --axylo-background) */\n    79\t  .axylo[data-axylo-scheme=\"light\"] {\n    80\t${tokens(LIGHT)}\n    81\t  }\n    82\t  .axylo[data-axylo-scheme=\"dark\"] {\n    83\t${tokens(DARK)}\n    84\t  }\n    85\t\n    86\t  @media (forced-colors: active) {\n    87\t    .axylo {\n    88\t${forced}\n    89\t    }\n    90\t  }\n    91\t\n    92\t  /* marks */\n    93\t  .axylo .axylo-svg, .axylo .axylo-canvas { position: absolute; left: 0; top: 0; display: block; pointer-events: none; }\n    94\t  .axylo .axylo-svg { overflow