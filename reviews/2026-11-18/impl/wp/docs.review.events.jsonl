ns.values.map(field => [field.field, { ...initial }])),\n   192\t      observations: new Map(options.values.map(field => [field.field, window.fork()])),\n   193\t      duplicates: new Map<string, StoreMap<number, true>>(),\n   194\t    };\n   195\t  }\n   196\t  const keys = seriesKeys(table, options.series);\n   197\t  const observations = new Map<string, Observations>();\n   198\t  const duplicates = new Map<string, StoreMap<number, true>>();\n   199\t  const last = new Map<string, number>();\n   200\t  eachObservation(options, x, keys, (key, position) => {\n","exit_code":0,"status":"completed"}}
