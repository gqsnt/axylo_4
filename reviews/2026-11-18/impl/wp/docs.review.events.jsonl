{"type":"item.completed","item":{"id":"item_96","type":"command_execution","command":"/bin/bash -lc \"cat apps/docs/examples/react-line.tsx apps/docs/examples/donut-many.ts apps/docs/examples/zoom.html; rg -n 'git|source|sibling|dist|reproduc' apps/docs/README* apps/docs/build.mjs; nl -ba packages/axylo/src/data/steps.ts | sed -n '76,123p'\"","aggregated_output":"import { StrictMode, useMemo, useState } from 'react';\nimport { createRoot } from 'react-dom/client';\nimport { Line } from '@axylo/react';\nimport type { Point } from 'axylo';\n\ninterface Row { day: string; channel: string; sessions: number }\n\nfunction makeRows(): Row[] {\n  return Array.from({ length: 14 }, (_, i) => ['Direct', 'Referral'].map((channel, c) => ({\n    day: `2026-03-${String(i + 1).padStart(2, '0')}`,\n    channel,\n    sessions: Math.round((c ? 450 : 3100) + (c ? 40 : 300) * Math.sin(i / 2 + c)),\n  }))).flat();\n}\n\n// Events give dates as epoch milliseconds; a calendar date is its UTC midnight.\nconst day = (value: string | number | Date) => new Date(value).toISOString().slice(0, 10);\n\nfunction SessionsCard() {\n  // Memoised: `data` is compared by identity, so a new array on every render would be read again.\n  const rows = useMemo(makeRows, []);\n  const [hovered, setHovered] = useState<Point<Row> | null>(null);\n  return (\n    <section>\n      <Line\n        title=\"Daily sessions by channel\"\n        data={rows}\n        x=\"day\"\n        y={{ field: 'sessions', label: 'Sessions' }}\n        series=\"channel\"\n        onHover={setHovered}\n      />\n      <p>{hovered ? `${hovered.series} on ${day(hovered.x)}: ${hovered.y ?? 'no data'}` : 'Point at the chart.'}</p>\n    </section>\n  );\n}\n\ncreateRoot(document.getElementById('root')!).render(<StrictMode><SessionsCard /></StrictMode>);\nimport { donut } from 'axylo';\n\n// Raises AX121 on purpose: eleven countries. The seven largest are drawn, the rest are grouped as\n// \"Other (n)\", and the table still lists every country. Iceland has zero (listed, no arc);\n// Malta has no value (listed as \"No data\").\nconst rows = [\n  { country: 'United States', orders: 4210 }, { country: 'Germany', orders: 1830 },\n  { country: 'France', orders: 1290 }, { country: 'Japan', orders: 1120 },\n  { country: 'Brazil', orders: 760 }, { country: 'India', orders: 655 },\n  { country: 'Canada', orders: 610 }, { country: 'Spain', orders: 340 },\n  { country: 'Norway', orders: 120 }, { country: 'Iceland', orders: 0 },\n  { country: 'Malta', orders: null },\n];\n\ndonut('#chart', { title: 'Orders by country', data: rows, label: 'country', value: 'orders' });\n<div id=\"chart\"></div>\n<p>\n  <button type=\"button\" id=\"last-week\">Last 7 days</button>\n  <button type=\"button\" id=\"all\">Everything</button>\n</p>\n<p><output id=\"range\">Showing everything.</output></p>\n<p><output id=\"picked\">Press Enter on a point, or click one, to select it.</output></p>\n\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  const rows = Array.from({ length: 31 }, (_, i) => ({\n    day: `2026-03-${String(i + 1).padStart(2, '0')}`,\n    sessions: Math.round(3000 + 30 * i + 400 * Math.sin(i / 1.3)),\n  }));\n  const chart = line('#chart', { title: 'Daily sessions, March', data: rows, x: 'day', y: 'sessions' });\n\n  const range = document.querySelector('#range');\n  const picked = document.querySelector('#picked');\n  /**\n   * Events give dates as epoch milliseconds; a calendar date is its UTC midnight.\n   * @param {string | number | Date} value\n   */\n  const day = value => new Date(value).toISOString().slice(0, 10);\n\n  // `zoom` sets the visible x range; null shows everything. The buttons, a drag, the keys\n  // + - 0 and the toolbar all end in the same 'zoom' event.\n  document.querySelector('#last-week').addEventListener('click', () => chart.zoom(['2026-03-25', '2026-03-31']));\n  document.querySelector('#all').addEventListener('click', () => chart.zoom(null));\n\n  chart.on('zoom', window => {\n    range.textContent = window ? `Showing ${day(window[0])} to ${day(window[1])}.` : 'Showing everything.';\n  });\n  chart.on('select', point => {\n    picked.textContent = `Selected ${point.series} on ${day(point.x)}: ${point.y ?? 'no data'} (row ${point.index}).`;\n  });\n</script>\nrg: apps/docs/README*: No such file or directory (os error 2)\napps/docs/build.mjs:1:// Builds the documentation site into apps/docs/dist. Needs the library built first (`npm run build`).\n    76\t}\n    77\t\n    78\texport function inferGaps(\n    79\t  axis: Axis, count: number, xAt: (i: number) => number,\n    80\t  snap: (gap: number, a: number, b: number, step: number) => number,\n    81\t  sparse?: (gaps: number) => void,\n    82\t): Float64Array | null {\n    83\t  if (!supportsSteps(axis) || count < 3) return null;\n    84\t  let a = xAt(0);\n    85\t  let min = Infinity;\n    86\t  let max = 0;\n    87\t  for (let i = 1; i < count; i++) {\n    88\t    const b = xAt(i);\n    89\t    const delta = stepDelta(axis, a, b);\n    90\t    if (delta < min) min = delta;\n    91\t    if (delta > max) max = delta;\n    92\t    a = b;\n    93\t  }\n    94\t  if (stepMultiple(max, min) === 1 || !(min > 0)) return null;\n    95\t  let gaps = 0;\n    96\t  let consecutive = 0;\n    97\t  a = xAt(0);\n    98\t  for (let i = 1; i < count; i++) {\n    99\t    const b = xAt(i);\n   100\t    const multiple = stepMultiple(stepDelta(axis, a, b), min);\n   101\t    if (!multiple) return null;\n   102\t    if (multiple === 1) consecutive++;\n   103\t    gaps += multiple - 1;\n   104\t    a = b;\n   105\t  }\n   106\t  if (consecutive * 2 < count - 1 || !gaps) return null;\n   107\t  if (tooSparse(gaps, count)) {\n   108\t    sparse?.(gaps);\n   109\t    return null;\n   110\t  }\n   111\t\n   112\t  const positions = new Float64Array(gaps);\n   113\t  let next = 0;\n   114\t  a = xAt(0);\n   115\t  for (let i = 1; i < count; i++) {\n   116\t    const b = xAt(i);\n   117\t    const multiple = stepMultiple(stepDelta(axis, a, b), min);\n   118\t    for (let j = 1; j < multiple; j++) {\n   119\t      const gap = gapPosition(axis, a, b, min, j, multiple);\n   120\t      positions[next++] = axis.kind === 'number' ? snap(gap, a, b, min) : gap;\n   121\t    }\n   122\t    a = b;\n   123\t  }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_97","type":"command_execution","command":"/bin/bash -lc \"cat apps/docs/data/diagnostics.mjs | sed -n '230,286p;332,346p'; rg -n 'zoom|pin|strip|rows|near|Escape|24 px' docs/decisions/0004-tooltip-and-focused-text.md | head -24; sed -n '1,65p' apps/docs/test/theming.test.ts; ls packages/axylo/src/core\"","aggregated_output":"    code: 'AX130', level: 'warning', title: 'More than eight series',\n    condition: 'A chart has more than eight series.', drawn: 'All series, told apart by colour and dash or marker.',\n    see: 'Every series is drawn. Beyond eight, colours repeat, and each series still has its own combination of colour and dash or marker.',\n    why: 'Eight colours is about as many as a reader can keep apart, also with a colour-vision deficiency (F9).',\n    fix: 'Filter to the series that matter, group the rest, or split the chart into small multiples.',\n    run: 'node',\n    input: `validate('line', {\n  title: 'Sessions by region',\n  data: ['A', 'B', 'C', 'D', 'E', 'F', 'G', 'H', 'I'].flatMap(region =>\n    ['2026-01-01', '2026-01-02'].map(day => ({ day, region, sessions: 100 }))),\n  x: 'day',\n  y: 'sessions',\n  series: 'region',\n})`,\n  },\n  {\n    code: 'AX131', level: 'hint', title: 'Several series in a compact chart',\n    condition: 'A compact chart has more than one series.', drawn: 'Drawn, with dash differences.',\n    see: 'The lines are drawn with different dashes, since a compact chart has no legend. In development, the console suggests one series per compact chart.',\n    why: 'A compact chart has no legend, axes or tooltip, so nothing tells the reader which line is which.',\n    fix: 'Use one compact chart per series, or a full chart with a legend.',\n    run: 'node',\n    input: `validate('line', {\n  labelledBy: 'kpi-heading',\n  compact: true,\n  data: [{ day: '2026-01-01', a: 1, b: 2 }, { day: '2026-01-02', a: 2, b: 1 }],\n  x: 'day',\n  y: ['a', 'b'],\n})`,\n  },\n  {\n    code: 'AX132', level: 'hint', title: 'More bars than pixels',\n    condition: 'More bars than pixels along the category axis.', drawn: 'Drawn; the hint suggests aggregating.',\n    see: 'Every bar is drawn, thinner than a pixel. In development, the console suggests aggregating.',\n    why: 'Bars narrower than a pixel blur into an area and cannot be picked or compared.',\n    fix: 'Aggregate (weeks instead of days), show fewer categories, or use a line or area chart.',\n    run: 'browser',\n    sample: { chart: 'Requests per minute', details: { field: 'minute' } },\n    input: `target.style.width = '300px';\nbar(target, {\n  title: 'Requests per minute',\n  data: Array.from({ length: 2000 }, (_, i) => ({ minute: i, requests: i % 7 })),\n  x: { field: 'minute', type: 'category' },\n  y: 'requests',\n});`,\n  },\n  {\n    code: 'AX133', level: 'hint', title: 'A very large scatter chart',\n    condition: 'A scatter chart has more than 50,000 points.', drawn: 'Drawn; the hint says drawing may be slow.',\n    see: 'All points are drawn. In development, the console says drawing may be slow.',\n    why: 'Scatter points are not simplified in 1.0, so every point is drawn on every frame.',\n    fix: 'Sample or bin the data, or filter it to the range the reader needs.',\n    run: 'node',\n    input: `validate('scatter', {\n  title: 'Requests',\n  data: { columns: { size: new Float64Array(50001).map((_, i) => i), ms: new Float64Array(50001).fill(10) } },\n  x: 'size',\n});`,\n  },\n  {\n    code: 'AX142', level: 'hint', title: 'Not enough room for a plot',\n    condition: 'The plot would be smaller than 120 × 80 CSS px.', drawn: 'The title, the summary and the table control instead of the plot.',\n    see: 'The chart shows its title, a one-line summary and the \"View as table\" control, so the data stays reachable. In development, the console says the plot is too small.',\n    why: 'A plot that small cannot hold readable axes (L8). Drawing it anyway would produce overlapping or clipped labels.',\n    fix: 'Give the container more room, or use `compact: true` for a sparkline in a small tile.',\n    run: 'browser',\n    sample: { chart: 'Sessions' },\n    input: `target.style.width = '110px';\ntarget.style.height = '90px';\nline(target, {\n  title: 'Sessions',\n  data: [{ day: '2026-01-01', sessions: 120 }, { day: '2026-01-02', sessions: 130 }],\n14:2. **Candidates, in order:** above the box, below it, then to the right and to the left of it (for horizontal bars: right, left, above, below). Along the other axis it is centred on the box and shifted only as far as needed. A candidate is valid when the tooltip lies wholly inside the plot rectangle, inside the viewport and inside every clipping ancestor, and overlaps neither the box nor any control. The first valid candidate is used. For a donut the first candidate is the hole, when the tooltip fits inside it.\n17:4. **Rows are not controls while hovered.** A hovered tooltip is text. Clicking or tapping the plot pins the tooltip for that datum; a pinned tooltip takes pointer events, stays until Escape, a click elsewhere, or its datum leaves the displayed frame, and its rows are buttons of at least 24 × 24 CSS px (WCAG 2.5.8) that select a series. Keyboard focus shows the same tooltip by the same placement; it is never over the focus ring because the box includes the ring.\n18:5. **Readout mode is decided by layout, not by hover.** When the plot is narrower than 240 CSS px or shorter than 140 CSS px, the figure is in readout mode: a strip of two text lines is reserved under the plot in the layout, and the content that would be in the tooltip is written there as running text (\"x: series value; series value; +N more\"), wrapping to the two lines and ending in \"+N more\" when it does not fit. The strip is part of the figure's flow: it covers nothing and nothing covers it. In readout mode there is no floating tooltip. A pinned datum makes the strip's entries buttons of 24 px height.\n19:6. **When no candidate is valid outside readout mode** (a tooltip taller than the room around a tall stack, for example), rows are dropped from the end and counted in \"+N more\" until a candidate is valid; if none is with one row, the tooltip is placed inside the plot at the candidate that overlaps the box least. This is the only case in which the active mark may be partly covered, and the table still has every value.\n20:7. Escape dismisses a hovered or pinned tooltip without moving the pointer, until the pointer reaches a different datum.\n/**\n * The theming page documents exactly the CSS custom properties the library's stylesheet uses: a property in\n * packages/axylo/src/theme/css.ts that is not in apps/docs/data/tokens.mjs fails, and so does a documented one\n * that is not in the stylesheet. The private defaults (`--axylo-default-*`) are the values behind the public\n * names, not properties of their own; each documented default must exist in both schemes.\n */\nimport { describe, expect, it } from 'vitest';\nimport { AXYLO_CSS } from '../../../packages/axylo/src/theme/css';\nimport { readThemeDefaults } from '../lib/site.mjs';\nimport { internalTokens, tokens } from '../data/tokens.mjs';\n\nconst inStylesheet = [...new Set([...AXYLO_CSS.matchAll(/--axylo-[a-z0-9-]+/g)].map(m => m[0]))]\n  .filter(name => !name.startsWith('--axylo-default-'))\n  .sort();\nconst documented = [...tokens, ...internalTokens].map(t => t.name).sort();\n\ndescribe('theme custom properties', () => {\n  it('every custom property in the stylesheet is documented', () => {\n    expect(inStylesheet.filter(name => !documented.includes(name))).toEqual([]);\n  });\n  it('every documented custom property is in the stylesheet', () => {\n    expect(documented.filter(name => !inStylesheet.includes(name))).toEqual([]);\n  });\n  it('no property is documented twice', () => {\n    expect(documented.filter((name, i) => documented.indexOf(name) !== i)).toEqual([]);\n  });\n  it('every documented default exists in the light and the dark scheme', () => {\n    const { light, dark } = readThemeDefaults(AXYLO_CSS);\n    for (const t of tokens.filter(t => 'default' in t && t.default)) {\n      expect(light[t.default!], `${t.default} (light)`).toMatch(/^#[0-9a-f]{6}$/i);\n      expect(dark[t.default!], `${t.default} (dark)`).toMatch(/^#[0-9a-f]{6}$/i);\n    }\n  });\n  it('every private default in the stylesheet belongs to a documented property', () => {\n    const { light, dark } = readThemeDefaults(AXYLO_CSS);\n    const used = new Set(tokens.map(t => t.default).filter(Boolean));\n    expect([...new Set([...Object.keys(light), ...Object.keys(dark)])].filter(name => !used.has(name))).toEqual([]);\n  });\n  it('a property without a colour default says what happens when it is unset', () => {\n    for (const t of tokens.filter(t => !t.default)) expect(t.unset, t.name).toBeTruthy();\n  });\n});\naxes.ts\nchart.ts\ncontracts.ts\ncontroller.ts\ndelivery.ts\nenvironment.ts\nfocus.ts\nglobals.d.ts\noptions.ts\nstages.ts\n","exit_code":0,"status":"completed"}}
