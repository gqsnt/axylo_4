eries colours too close to the background',\n335:    code: 'AX142', level: 'hint', title: 'Not enough room for a plot',\n352:    code: 'AX143', level: 'hint', title: 'Labels hidden after every remedy',\n368:    code: 'AX150', level: 'warning', title: 'An option Axylo does not know',\n383:    code: 'AX151', level: 'warning', title: 'Appended rows out of order',\n399:    code: 'AX152', level: 'warning', title: 'An unknown time zone',\n413:    code: 'AX160', level: 'warning', title: 'A custom formatter threw',\n428:    code: 'AX199', level: 'error', title: 'Axylo failed',\n    94\t}\n    95\t\n    96\t// ---------- assets ----------\n    97\t\n    98\tfunction writeAssets(outDir, theme) {\n    99\t  const pick = (scheme, name) => {\n   100\t    const value = theme[scheme][`--axylo-default-${name}`];\n   101\t    if (!value || !HEX.test(value)) throw new Error(`axylo.css: no colour for --axylo-default-${name} (${scheme})`);\n   102\t    return value;\n   103\t  };\n   104\t  // The site's surfaces use the chart's own default tokens, so the pages and the charts match.\n   105\t  const vars = scheme => ['background', 'axis', 'grid', 'muted', 'focus', 'reference']\n   106\t    .map(name => `  --site-${name}: ${pick(scheme, name)};`).join('\\n');\n   107\t  const tokens = `/* Generated from packages/axylo/dist/axylo.css by apps/docs/lib/site.mjs. */\n   108\t:root {\n   109\t${vars('light')}\n   110\t}\n   111\t@media (prefers-color-scheme: dark) {\n   112\t  :root {\n   113\t${vars('dark')}\n   114\t  }\n   115\t}\n   237\t  const name = file.endsWith('.md') && !file.includes('/') ? file.slice(0, -3) : null;\n   238\t  if (name !== null && PAGE_NAMES.has(name)) return `${base}${name}.html${hash ? '#' + hash : ''}`;\n   239\t  // A path into the repository: pages/ and dist/ sit at the same depth, so it resolves the same from both\n   240\t  // when the site is served from the repository root.\n   241\t  return base + url;\n   242\t}\n   243\t\n   244\tfunction directive({ kind, name, target }, where, ctx) {\n   245\t  if (kind === 'example') return exampleBlock(name, target, where, ctx);\n   246\t  if (kind === 'source') return sourceBlock(name, target, where, ctx);\n   247\t  if (kind === 'table') return generatedTable(name, ctx);\n   248\t  throw new Error(`Unknown directive ${kind}`);\n   249\t}\n   250\t\n   251\tfunction exampleBlock(name, target, where, ctx) {\n   252\t  const file = path.resolve(path.dirname(where), target);\n   253\t  const example = ctx.examples.find(e => path.join(docsRoot, 'examples', e.file) === file);\n   254\t  if (!example) throw new Error(`${path.relative(repoRoot, where)}: example ${target} does not exist`);\n   255\t  if (example.name !== name) throw new Error(`${path.relative(repoRoot, where)}: example link text \"${name}\" does not match ${example.file}`);\n   256\t  const source = fs.readFileSync(file, 'utf8');\n   257\t  const targets = example.ext === 'ts' ? Math.max(1, (source.match(/\\b(?:line|area|bar|scatter|donut)\\(\\s*['\"]#/g) ?? []).length) : 1;\n   258\t  const raises = example.raises.length\n   259\t    ? `<p class=\"example-note\">This example raises ${listText(example.raises.map(c => `<a href=\"diagnostics/${c}.html\">${c}</a>`))} on purpose.</p>`\n   260\t    : '';\n   261\t  const height = example.ext === 'ts' ? targets * 470 : 470;\n   262\t  return `<figure class=\"example\" id=\"example-${escapeHtml(example.name)}\">\n   263\t<div class=\"example-live\"><iframe src=\"examples/${escapeHtml(example.name)}.html\" title=\"Live example: ${escapeHtml(example.name)}\" loading=\"lazy\" style=\"height: ${height}px\"></iframe></div>\n   264\t${raises}<figcaption><span>Source</span> <a href=\"../examples/${escapeHtml(example.file)}\">examples/${escapeHtml(example.file)}</a> · <a href=\"examples/${escapeHtml(example.name)}.html\">open on its own</a></figcaption>\n   265\t${codeBlock(source, example.ext)}\n   266\t</figure>`;\n   267\t}\n   268\t\n   269\t/** \"a\", \"a and b\", \"a, b and c\". */\n   270\tfunction listText(items) {\n   271\t  return items.length < 2 ? items.join('') : `${items.slice(0, -1).join(', ')} and ${items[items.length - 1]}`;\n   272\t}\n   273\t\n   274\tfunction sourceBlock(label, target, where, ctx) {\n   275\t  const [file, range] = target.split('#');\n   276\t  const absolute = path.resolve(path.dirname(where), file);\n   277\t  const shown = path.relative(repoRoot, absolute);\n   278\t  if (!fs.existsSync(absolute)) {\n   279\t    ctx.warnings.push(`${path.relative(repoRoot, where)}: ${shown} does not exist yet; the page shows a placeholder`);\n   280\t    return `<figure class=\"source source-missing\"><figcaption>${escapeHtml(label)}</figcaption><p>This snippet is quoted from <code>${escapeHtml(shown)}</code>, which did not exist when this site was built.</p></figure>`;\n   281\t  }\n   282\t  let text = fs.readFileSync(absolute, 'utf8').replace(/\\n$/, '');\n   283\t  const lines = range && /^L(\\d+)-L(\\d+)$/.exec(range);\n   284\t  if (range && !lines) throw new Error(`${path.relative(repoRoot, where)}: bad line range ${range}`);\n   285\t  if (lines) {\n   286\t    const all = text.split('\\n');\n   287\t    const [from, to] = [Number(lines[1]), Number(lines[2])];\n   288\t    if (from < 1 || to > all.length || from > to) throw new Error(`${path.relative(repoRoot, where)}: ${shown} has no lines ${from}–${to}`);\n   289\t    text = all.slice(from - 1, to).join('\\n');\n   290\t  }\n   291\t  const ext = path.extname(file).slice(1);\n   292\t  const named = label === shown || label === file ? '' : `${escapeHtml(label)} · `;\n   293\t  return `<figure class=\"source\"><figcaption>${named}<a href=\"${escapeHtml(target)}\">${escapeHtml(shown)}${lines ? `, lines ${lines[1]}–${lines[2]}` : ''}</a></figcaption>${codeBlock(text, ext)}</figure>`;\n   294\t}\n   295\t\n   296\tfunction generatedTable(name, ctx) {\n   408\t<p class=\"small\">${how}</p>\n   409\t<nav class=\"pager\" aria-label=\"Previous and next code\">${prev ? `<a rel=\"prev\" href=\"${prev.code}.html\">← ${prev.code}</a>` : '<span></span>'}${next ? `<a rel=\"next\" href=\"${next.code}.html\">${next.code} →</a>` : ''}</nav>`;\n   410\t  return layout({ title: `${d.code}: ${d.title}`, body, current: 'diagnostics', base: '../', ctx, sourcePath: `apps/docs/data/diagnostics.mjs` });\n   411\t}\n   412\t\n   413\tfunction levelText(level) {\n   414\t  if (level === 'error') return 'The chart, or the affected series, cannot be drawn: the chart shows its error state. Printed in every build; thrown by a `strict` chart.';\n   415\t  if (level === 'warning') return 'Something is not drawn as given; when values were left out or changed, the reader sees a note. Printed in every build; thrown by a `strict` chart when it comes from a call.';\n   416\t  return 'Advice for the author. Printed in development builds only; never thrown.';\n   417\t}\n   418\t\n   419\t// ---------- layout ----------\n   465\t      else if (f.endsWith('.html')) files.push(p);\n   466\t    }\n   467\t  };\n   468\t  walk(outDir);\n   469\t  const ids = new Map();\n   470\t  const idsOf = file => {\n   471\t    if (!ids.has(file)) ids.set(file, new Set([...fs.readFileSync(file, 'utf8').matchAll(/\\sid=\"([^\"]+)\"/g)].map(m => m[1])));\n   472\t    return ids.get(file);\n   473\t  };\n   474\t  for (const file of files) {\n   475\t    const html = fs.readFileSync(file, 'utf8');\n   476\t    for (const m of html.matchAll(/\\s(?:href|src)=\"([^\"]+)\"/g)) {\n   477\t      const url = m[1].replace(/&amp;/g, '&');\n   478\t      if (/^[a-z]+:/i.test(url)) continue;\n   479\t      const [target, hash] = url.split('#');\n   480\t      const resolved = target === '' ? file : path.resolve(path.dirname(file), decodeURIComponent(target));\n   481\t      if (!fs.existsSync(resolved)) { broken.push(`${path.relative(outDir, file)} → ${url}`); continue; }\n   482\t      if (hash && resolved.endsWith('.html') && resolved.startsWith(outDir) && !/^L\\d+/.test(hash) && !idsOf(resolved).has(hash)) {\n   483\t        broken.push(`${path.relative(outDir, file)} → ${url} (no such anchor)`);\n   484\t      }\n   485\t    }\n   486\t  }\n   487\t  return broken;\n   488\t}\n   489\t\n   490\texport { slug };\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -lc \"rg --files | rg -i 'conformance|axe.report|wcag' | head -80; nl -ba apps/docs/pages/theming.md | sed -n '46,60p'; cat apps/docs/pages/compact.md; cat apps/docs/pages/line.md; nl -ba packages/axylo/src/data/x.ts | sed -n '110,163p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_90","type":"command_execution","command":"/bin/bash -lc \"rg --files | rg -i 'conformance|axe.report|wcag' | head -80; nl -ba apps/docs/pages/theming.md | sed -n '46,60p'; cat apps/docs/pages/compact.md; cat apps/docs/pages/line.md; nl -ba packages/axylo/src/data/x.ts | sed -n '110,163p'\"","aggregated_output":"apps/docs/pages/conformance.md\n    46\tMarks are drawn as SVG by default, so they stay sharp at any zoom and in print. There is no print stylesheet in 1.0, and printing has not been tested; the toolbar prints as it appears on screen.\n    47\t\n    48\t## The default palette\n    49\t\n    50\t[table: palette](../../../packages/axylo/src/theme/palette.ts)\n    51\t\n    52\tEight colours, in the order blue, orange, green, purple, red, cyan, magenta, slate, with the same family in the same slot in light and dark charts. They were fitted to measurable limits, not chosen by eye:\n    53\t\n    54\t- each colour is at least 3:1 against the default light and dark backgrounds;\n    55\t- every pair stays apart (OKLab difference of at least 0.10) under normal vision and under simulated protanopia, deuteranopia and tritanopia, and the first four, which most charts use, further apart still;\n    56\t- they stay clear of the focus, reference and muted colours;\n    57\t- neighbouring colours stay apart as translucent and solid fills.\n    58\t\n    59\tColour is never the only cue: lines and areas also carry marker shapes, adjacent fills are separated by background, and the legend and tooltip repeat the cues. The palette is a proposal that meets those limits; whether it is pleasant to look at is still open. The reasoning, the measurements and what was tried are in [decision 0003](../../../docs/decisions/0003-default-palette.md).\n    60\t\n# Compact charts\n\nAfter this page you can put a sparkline in a KPI tile with `compact: true`, know what it shows and leaves out, and give it a text alternative that a screen-reader user can rely on.\n\n## When to use it\n\n`compact: true` on a line, area or bar chart draws the marks and nothing else: no axes, gridlines, legend, toolbar, table control, zoom or tooltip. It is for a small tile where the page already shows the number and its label, and the chart only says which way it is going.\n\n[example: compact-tiles](../examples/compact-tiles.html)\n\nA compact chart does not give access to every value; its summary is the alternative. When the reader needs every value, use the full chart.\n\n## What a compact chart is\n\n| Behaviour | Compact |\n|---|---|\n| For assistive technology | A static image (`role=\"img\"`) with an accessible name and the generated summary as its description: series, x range, minimum, maximum, last value, and any values left out. |\n| Name | `labelledBy` with the tile heading's id (best: the heading is already there), or `title`. In a compact chart the title is not shown; it is the accessible name. Without either, the name is generated and [AX140](diagnostics.md#ax140) is raised. |\n| Keyboard and pointer | No tab stop and no pointer behaviour, so nothing is available to a mouse that is not available to a keyboard. A page of forty tiles adds no tab stops. |\n| Size | Fills its container from 24 × 16 px up. With no height set, it is 32 px tall. |\n| Several series | Allowed, with lines told apart by dash as well as colour, since there is no legend; hint [AX131](diagnostics.md#ax131) suggests one series per tile. |\n| Fidelity | The rules of the full charts still hold: zero baseline for bar and area, gaps for missing values, diagnostics, simplified drawing of dense lines, sorting by x, no motion, and light or dark from the page. |\n| Reference lines | Not drawn. |\n\n## Options\n\n`compact` takes the options of its chart type ([line](line.md#options), [area](area.md#options), [bar](bar.md#options)). The ones that need axes or controls (`zoom`, `reference`, `legend`, `tooltip`, `table`) have no effect on a compact chart. Scatter and donut have no compact form: on them `compact` is a type error.\n\n## Edge case: a value left out\n\nWhen values were left out, the description says so and a small marker with a text equivalent appears in the corner of the chart.\n\n[example: compact-dirty](../examples/compact-dirty.html)\n# Line charts\n\nAfter this page you know when to use a line chart, which options it takes, and how a line is picked, read by keyboard, zoomed and simplified.\n\n## When to use it\n\nA line shows how a measure changed along an ordered x: sessions per day, latency per minute, revenue per month. Several series compare trends. The x can be calendar dates, instants, wall-clock times, numbers or categories.\n\nUse a [bar chart](bar.md) to compare a few categories, an [area chart](area.md) when the total and its parts matter, and a [compact line](compact.md) for a sparkline in a KPI tile.\n\n[example: line-time](../examples/line-time.ts)\n\n## Options\n\n```ts\nimport { line } from 'axylo';\nline(target, { data, x, y, series, ...options });\n```\n\n| Option | On a line chart |\n|---|---|\n| `x` | Dates, instants, wall-clock times, numbers or categories. See [the three kinds of time](data.md#three-kinds-of-time). |\n| `y` | One value field with `series` (long rows), or a list of fields (wide rows). |\n| `series` | The field that names each row's series, for long rows. |\n| `zoom` | On by default for date, time and number x. `'touch'` also takes pinch and two-finger pan. |\n| `reference` | Lines and bands: `{ y: 500, label: 'Objective' }`, `{ x: [from, to], label: 'Incident' }`. |\n| `compact` | Marks only, for a tile. See [Compact](compact.md). |\n| Common options | `title`, `labelledBy`, `subtitle`, `description`, `state`, `legend`, `tooltip`, `table`, `colors`, `messages`, `locale`, `strict`, `onDiagnostic`. |\n\nNot on a line chart, and a type error if given: `stacked` (stacking lines hides how each part moves; a stacked area shows it), `layout` and `horizontal` (bars only), `label` and `value` (donut only). At run time an option that does not apply is ignored with [AX150](diagnostics.md#ax150). The [options reference](options.md) has every option with its type and default.\n\n## How a line chart behaves\n\n| Behaviour | Line |\n|---|---|\n| Pointer | The nearest x wins, wherever the pointer is in the plot. The tooltip lists every visible series at that x. A series with no row at that x reads \"No observation\"; one whose value is missing reads \"No data\". |\n| Keyboard | By x, then series. Left and Right move along x and read every visible series at once; Up and Down narrow to one series and move between series; Escape returns to all series. |\n| Zoom | Date, time and number x: Zoom in and Zoom out buttons (Pan left, Pan right and Reset zoom once zoomed), dragging across the plot, the keys `+` `-` `0` and Shift with the arrows, the wheel while the plot has focus, and pinch with `zoom: 'touch'`. Category x is not zoomable in 1.0. |\n| Many points | When a line is denser than the screen, the drawing is simplified: in every device-pixel column, each run of valid samples keeps its minimum and maximum, and a gap is always kept. Nothing is smoothed. Tooltip, keyboard and table read the data, not the drawing, so every sample stays reachable. |\n| Markers | Each series carries its marker shape at its last point and at sparse intervals, repeated in the legend and tooltip. Every point gets a marker only when points are at least 12 px apart. A point alone between gaps always has one. |\n| Limit | Eight series have eight colours. Beyond eight, each series still has its own colour and dash or marker combination, with [AX130](diagnostics.md#ax130). |\n| Order and duplicates | Drawn in x order whatever the input order. Two rows for the same x in one series are [AX108](diagnostics.md#ax108), and that series is not drawn. |\n| Reference lines and bands | Drawn, labelled beside the line, included in the value domain, and listed in the summary and the table caption. |\n\nThe value axis of a line fits the data and need not start at zero, unlike a bar or area.\n\n## Edge case: values that cannot be drawn\n\nNull is a gap without comment. `NaN`, a stray string and an absent field are gaps too, each with its own diagnostic, and the reader is told how many values are not shown. A value alone between gaps is a point.\n\n[example: line-dirty](../examples/line-dirty.ts)\n   110\t    }\n   111\t    return votes;\n   112\t  }\n   113\t  for (let i = 0; i < table.length; i++) {\n   114\t    if (series !== null && nameOf(table.read(i, series)) === null) continue;\n   115\t    const value = table.read(i, field);\n   116\t    if (value == null || value === '' || Number.isNaN(value) && table.isColumnRow(i)) continue;\n   117\t    votes[kindOf(value) ?? 'category']++;\n   118\t  }\n   119\t  return votes;\n   120\t}\n   121\t\n   122\texport function preferredKind(votes: KindVotes): XKind | null {\n   123\t  const { date, time, wall, number, category } = votes;\n   124\t  const recognized = date + time + wall + number;\n   125\t  if (recognized + category === 0) return null;\n   126\t  if (category >= recognized) return 'category';\n   127\t  // Use a fixed order for ties so reordering records cannot change which values are drawn.\n   128\t  return kinds.find(kind => kind !== 'category' && votes[kind] === Math.max(date, time, wall, number))!;\n   129\t}\n   130\t\n   131\texport function inferKind(table: Table, field: string, series: string | null = null): XKind | null {\n   132\t  return preferredKind(countKinds(table, field, series));\n   133\t}\n   134\t\n   135\texport function nameOf(value: unknown): string | null {\n   136\t  if (typeof value === 'string') return value;\n   137\t  if (typeof value === 'boolean' || typeof value === 'number' && Number.isFinite(value)) return String(value);\n   138\t  return null;\n   139\t}\n   140\t\n   141\texport class XParser {\n   142\t  readonly timeZone: string | null;\n   143\t  private names: Labels | null;\n   144\t  private firstIndex = 0;\n   145\t  private indexes: StoreMap<string, number> | null;\n   146\t  dateUnit: DateUnit | null = null;\n   147\t\n   148\t  constructor(\n   149\t    readonly field: ResolvedXField,\n   150\t    readonly kind: XKind,\n   151\t    env: Pick<Environment, 'timeZone'>,\n   152\t    private readonly scatter = false,\n   153\t    categories?: readonly string[],\n   154\t  ) {\n   155\t    this.timeZone = kind === 'time'\n   156\t      ? (field.timeZone === 'local' ? undefined : canonicalZone(field.timeZone)) ??\n   157\t        canonicalZone(env.timeZone) ?? Intl.DateTimeFormat().resolvedOptions().timeZone\n   158\t      : null;\n   159\t    this.names = kind === 'category' ? new Labels(categories) : null;\n   160\t    this.indexes = this.names ? new StoreMap(new Map(categories?.map((name, index) => [name, index]))) : null;\n   161\t  }\n   162\t\n   163\t  get categories(): readonly string[] | null {\n","exit_code":0,"status":"completed"}}
