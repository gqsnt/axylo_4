: k;\n        };\n        const sx = scaleOf(plot.width, figure.plot.offsetWidth);\n        const sy = scaleOf(plot.height, figure.plot.offsetHeight);\n        // When the plot is squeezed to nothing, how far the rest overflows the figure is how much room is\n        // missing; that keeps the L8 decision continuous below zero.\n        const overflow = plot.height < 1 ? Math.max(0, figure.figure.scrollHeight - figure.figure.clientHeight) : 0;\n        const stage = figure.stage.getBoundingClientRect();\n        return { width: plot.width / sx, height: plot.height / sy - overflow, room: { width: stage.width / sx, height: stage.height / sy } };\n      },\n      devicePixelRatio: () => win.devicePixelRatio || 1,\n      // Scoped to this chart's own figure: properties and the scheme go with it (finding 10).\n      theme: (keys, colors) => resolveTheme(figure.figure, keys, colors),\n      surfaces(visible) {\n        // Hidden without drawing: the error revision does not depend on the methods that may have failed.\n        for (const el of [renderer.element, textLayer.element]) (el as HTMLElement).style.visibility = visible ? '' : 'hidden';\n      },\n      dispose: release,\n    });\n    resizeObserver.observe(figure.plot);\n    resizeObserver.observe(figure.figure);\n    if (root.isConnected) watch();\n    return controller.handle;\n  } catch (error) {\n    // A rejected strict create, or a failure part-way through: nothing stays behind, a controller that was\n    // already created (its first frame queued) included (review 3, finding 9).\n    const created = controller as Controller | null;\n    controller = null;\n    try { created?.handle.destroy(); } catch { /* releasing the rest matters more */ }\n    release();\n    throw error;\n  }\n}\n\nfunction resolveTarget(target: unknown): HTMLElement {\n  if (typeof target === 'string') {\n    const doc = (globalThis as { document?: Document }).document;\n    if (!doc) throw new Error(`Axylo: no document to find the target ${JSON.stringify(target)} in.`);\n    let found: Element | null = null;\n    try {\n      found = doc.querySelector(target);\n    } catch {\n      throw new Error(`Axylo: the target selector ${JSON.stringify(target)} is not a valid CSS selector.`);\n    }\n    if (!found) throw new Error(`Axylo: the target selector ${JSON.stringify(target)} matches no element.`);\n    return found as HTMLElement;\n  }\n  if (target !== null && typeof target === 'object' && (target as Node).nodeType === 1) return target as HTMLElement;\n  throw new Error('Axylo: the target must be a CSS selector or an element.');\n}\n/**\n * Diagnostic delivery (spec 3.5): what is printed, what reaches `onDiagnostic`, and what `strict` throws.\n *\n * Errors and warnings print with `console.warn` once per code per page in every build; hints print with\n * `console.info`, also once per code per page, and only in development builds. `onDiagnostic` receives every\n * diagnostic a chart newly finds. `strict` throws on errors and warnings found while validating a call\n * (origin 'call'); diagnostics found later (origin 'presentation') are reported and never thrown.\n */\nimport type { DiagnosticInput } from './contracts';\nimport type { Diagnostic } from '../public';\n\nexport interface DeliveryConsole {\n  warn(...args: unknown[]): void;\n  info(...args: unknown[]): void;\n  error(...args: unknown[]): void;\n}\n\n/** Codes already printed, per page. The key is the document in a browser, any object in tests. */\nconst printed = new WeakMap<object, Set<string>>();\nconst fallbackPage = {};\n\nexport interface DeliveryOptions {\n  readonly console: DeliveryConsole | null;\n  readonly development: boolean;\n  /** The page the once-per-code rule applies to. */\n  readonly page: object | null;\n}\n\nexport type DiagnosticListener = (diagnostic: Diagnostic) => void;\n\nexport function format(d: Diagnostic): string {\n  return `[axylo ${d.code}] ${JSON.stringify(d.chart)}: ${d.message}`;\n}\n\n/** Identity of a diagnostic for \"is this one new\": the same finding found again is not delivered twice. */\nexport function diagnosticKey(d: Pick<Diagnostic, 'code' | 'field' | 'message'>): string {\n  return `${d.code}\\u0000${d.field ?? ''}\\u0000${d.message}`;\n}\n\nexport class Delivery {\n  private listenerFailed = false;\n\n  constructor(private readonly options: DeliveryOptions) {}\n\n  /**\n   * Prints and hands to the listener the diagnostics in `found` that are not in `before`. The listener is\n   * author code: after each call `alive` says whether to go on (the chart may have been destroyed or have\n   * moved to a new state that delivers its own findings).\n   */\n  deliver(\n    found: readonly Diagnostic[], before: readonly Diagnostic[] | ReadonlySet<string>, listener: DiagnosticListener | null,\n    alive: () => boolean = () => true,\n  ): void {\n    const known = new Set(before instanceof Set ? before : (before as readonly Diagnostic[]).map(diagnosticKey));\n    for (const d of found) {\n      if (!alive()) return;\n      if (known.has(diagnosticKey(d))) continue;\n      known.add(diagnosticKey(d));\n      this.print(d);\n      if (listener) this.notify(listener, d);\n    }\n  }\n\n  print(d: Diagnostic): void {\n    const out = this.options.console;\n    if (!out) return;\n    if (d.level === 'hint' && !this.options.development) return;\n    const page = this.options.page ?? fallbackPage;\n    let codes = printed.get(page);\n    if (!codes) printed.set(page, codes = new Set());\n    if (codes.has(d.code)) return;\n    codes.add(d.code);\n    if (d.level === 'hint') out.info(format(d));\n    else out.warn(format(d));\n  }\n\n  /** An internal failure: the chart shows its internal-error state; this says why. Not a registry code. */\n  internal(chart: string, error: unknown): void {\n    this.options.console?.error(`[axylo] ${JSON.stringify(chart)}: internal error while drawing the chart.`, error);\n  }\n\n  /** Hands one diagnostic to the author's listener; a l