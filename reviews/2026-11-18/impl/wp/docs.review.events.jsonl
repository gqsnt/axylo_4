ect = record(row);\n    41\t      return object !== null && Object.hasOwn(object, field);\n    42\t    }),\n    43\t    keys: () => {\n    44\t      const keys = new Set<string>();\n    45\t      for (const row of rows) for (const key of Object.keys(record(row) ?? {})) keys.add(key);\n    46\t      return [...keys];\n    47\t    },\n    48\t  };\n    49\t  origins.set(table, rows);\n    50\t  return table;\n    51\t}\n    52\t\n    53\texport function columnsTable(columns: Columns, length: number): Table {\n    54\t  const keys = Object.keys(columns);\n    55\t  const table: Table = {\n    56\t    length,\n    57\t    columns,\n    58\t    read: (row, field) => Object.hasOwn(columns, field) ? columns[field]?.[row] : undefined,\n    59\t    rowAt: row => row >= 0 && row < length && Number.isInteger(row)\n    60\t      ? Object.fromEntries(keys.map(key => [key, columns[key]?.[row]]))\n    61\t      : null,\n    62\t    hasField: field => Object.hasOwn(columns, field),\n    63\t    isColumnRow: () => true,\n    64\t    rowIndex: row => row,\n    65\t    keys: () => keys,\n    66\t  };\n    67\t  origins.set(table, columns);\n    68\t  return table;\n    69\t}\npackages/axylo/src/format/time.ts:24:  /** Called once, the first time the author's format fails (the caller raises AX160). */\npackages/axylo/src/format/time.ts:34:export function defaultTimeReadout(\npackages/axylo/src/format/time.ts:62:/** Positions a Date can hold; Intl throws on any other (\"Invalid time value\"), so they are written as numbers. */\npackages/axylo/src/format/time.ts:83: * The author's format wrapped so that a failure falls back to `fallback` and is reported once. Null when\npackages/axylo/src/format/time.ts:101:        if (fallback === null) throw error;\npackages/axylo/src/format/time.ts:135:  const fallback = (position: number): string => defaultTimeReadout(position, spec.kind, spec.timeZone, spec.locale, spec.dateUnit);\npackages/axylo/src/format/time.ts:143: * so the built-in context-awa