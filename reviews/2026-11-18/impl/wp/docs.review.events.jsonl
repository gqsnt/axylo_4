{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc 'for f in apps/docs/examples/*.html; do echo \"$f\"; cat \"$f\"; done'","aggregated_output":"apps/docs/examples/a11y-card.html\n<style>\n  .card { padding: 16px; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 8px; }\n  .card h3 { margin: 0 0 4px; }\n  .card p { margin: 0 0 12px; }\n</style>\n\n<section class=\"card\" aria-labelledby=\"latency-heading\">\n  <h3 id=\"latency-heading\">Checkout latency by region</h3>\n  <p>95th percentile response time per day, in milliseconds.</p>\n  <div id=\"chart\"></div>\n</section>\n\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  const regions = ['Europe', 'North America'];\n  const rows = Array.from({ length: 21 }, (_, i) => regions.map((region, r) => ({\n    day: `2026-03-${String(i + 1).padStart(2, '0')}`,\n    region,\n    p95: Math.round((r ? 380 : 310) + 30 * Math.sin(i / 2 + r) + (i === 11 ? 520 : 0)),\n  }))).flat();\n\n  line('#chart', {\n    // The card's heading names the chart; the chart does not repeat it.\n    labelledBy: 'latency-heading',\n    // Added to the generated summary, which already gives the range, minimum, maximum and last value.\n    description: 'The spike on 12 March was the payment provider outage.',\n    data: rows,\n    x: 'day',\n    y: { field: 'p95', label: 'Latency (p95)', unit: 'ms' },\n    series: 'region',\n  });\n</script>\napps/docs/examples/compact-dirty.html\n<!-- Raises AX103 on purpose: one value is NaN. -->\n<style>\n  .tile { max-width: 220px; padding: 12px; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 8px; }\n  .tile h3 { margin: 0 0 8px; font-size: 0.875rem; font-weight: 500; }\n</style>\n\n<section class=\"tile\">\n  <h3 id=\"rate-heading\">Error rate, last 14 days</h3>\n  <div id=\"rate-spark\" style=\"height: 48px\"></div>\n</section>\n\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  const rates = [1.2, 1.4, 1.1, 0.9, 1.3, Number.NaN, 1.6, 1.8, 1.5, 1.2, 1.1, 1.0, 0.9, 1.1];\n  const rows = rates.map((rate, i) => ({ day: `2026-03-${String(i + 1).padStart(2, '0')}`, rate }));\n\n  // A value was left out, so the chart's description says so and a small marker with a text\n  // equivalent appears in its corner. With a definite height (48 px here) the chart fills it.\n  line('#rate-spark', { labelledBy: 'rate-heading', compact: true, data: rows, x: 'day', y: 'rate' });\n</script>\napps/docs/examples/compact-tiles.html\n<style>\n  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 12px; }\n  .tile { padding: 12px; border: 1px solid color-mix(in srgb, currentColor 25%, transparent); border-radius: 8px; }\n  .tile h3 { margin: 0; font-size: 0.875rem; font-weight: 500; }\n  .tile p { margin: 2px 0 8px; font-size: 1.5rem; font-weight: 600; font-variant-numeric: tabular-nums; }\n</style>\n\n<div class=\"tiles\">\n  <section class=\"tile\">\n    <h3 id=\"sessions-heading\">Sessions, last 30 days</h3>\n    <p>48,210</p>\n    <div id=\"sessions-spark\"></div>\n  </section>\n  <section class=\"tile\">\n    <h3 id=\"revenue-heading\">Revenue, last 30 days</h3>\n    <p>$182,400</p>\n    <div id=\"revenue-spark\"></div>\n  </section>\n  <section class=\"tile\">\n    <h3 id=\"errors-heading\">Errors per day</h3>\n    <p>37</p>\n    <div id=\"errors-spark\"></div>\n  </section>\n</div>\n\n<script type=\"module\">\n  import { line, area, bar } from 'axylo';\n\n  const days = Array.from({ length: 30 }, (_, i) => `2026-03-${String(i + 1).padStart(2, '0')}`);\n  const rows = days.map((day, i) => ({\n    day,\n    sessions: Math.round(1500 + 12 * i + 180 * Math.sin(i / 2)),\n    revenue: Math.round(5600 + 40 * i + 700 * Math.cos(i / 3)),\n    errors: Math.max(0, Math.round(30 + 10 * Math.sin(i * 1.3))),\n  }));\n\n  // Marks only. Each tile's heading names its chart; the chart describes itself to assistive\n  // technology with its generated summary (range, minimum, maximum, last value).\n  line('#sessions-spark', { labelledBy: 'sessions-heading', compact: true, data: rows, x: 'day', y: 'sessions' });\n  area('#revenue-spark', { labelledBy: 'revenue-heading', compact: true, data: rows, x: 'day', y: 'revenue' });\n  bar('#errors-spark', { labelledBy: 'errors-heading', compact: true, data: rows, x: 'day', y: 'errors' });\n</script>\napps/docs/examples/diagnostics-listener.html\n<!-- Raises AX102, AX103 and AX106 on purpose: the rows are the \"dirty\" fixture. -->\n<div id=\"chart\"></div>\n<p>Delivered to <code>onDiagnostic</code>:</p>\n<ul id=\"log\"></ul>\n\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  const days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];\n  const values = [10, 20, null, NaN, '40', undefined, 70];\n  // Untyped, as rows from an API response are.\n  const rows = /** @type {any[]} */ (days.map((day, i) => ({ day, value: values[i] })));\n  const log = document.querySelector('#log');\n\n  const chart = line('#chart', {\n    title: 'Dirty input',\n    data: rows,\n    x: 'day',\n    y: 'value',\n    // Called once for each diagnostic the chart newly finds, in every build.\n    onDiagnostic(d) {\n      const item = document.createElement('li');\n      item.textContent = `${d.code} (${d.level}), field ${d.field}, rows ${d.rows?.join(', ')}`;\n      log.append(item);\n    },\n  });\n\n  // The same list, current as soon as the call returns.\n  console.log(chart.diagnostics.map(d => d.code).join(' '));\n</script>\napps/docs/examples/script-tag.html\n<div id=\"chart\"></div>\n\n<!-- The script-tag build defines one global, Axylo. Use axylo.iife.min.js in production. -->\n<script src=\"axylo.iife.js\"></script>\n<script>\n  const rows = [\n    { day: '2026-03-02', sessions: 3120 },\n    { day: '2026-03-03', sessions: 3380 },\n    { day: '2026-03-04', sessions: 3290 },\n    { day: '2026-03-05', sessions: 3510 },\n    { day: '2026-03-06', sessions: 3460 },\n  ];\n  Axylo.line('#chart', { title: 'Daily sessions', data: rows, x: 'day', y: 'sessions' });\n</script>\napps/docs/examples/stream.html\n<div id=\"chart\"></div>\n\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  // One reading per second. `keep: 60` keeps the latest 60 distinct x values; older ones go.\n  let at = Date.UTC(2026, 2, 10, 9, 0, 0);\n  let i = 0;\n  const next = () => {\n    at += 1000;\n    i += 1;\n    return { at, rps: Math.round(240 + 40 * Math.sin(i / 6) + 15 * Math.sin(i * 1.9)) };\n  };\n  const rows = Array.from({ length: 60 }, next);\n\n  const chart = line('#chart', {\n    title: 'Requests per second',\n    data: rows,\n    x: { field: 'at', type: 'time', timeZone: 'UTC' },\n    y: { field: 'rps', label: 'Requests', unit: 'req/s' },\n  });\n\n  // After the first append the chart shows a Pause control: while paused, rows are kept and the\n  // view stands still; Resume shows everything that arrived.\n  setInterval(() => chart.append([next()], { keep: 60 }), 1000);\n</script>\napps/docs/examples/strict.html\n<div id=\"chart\"></div>\n<p><button type=\"button\" id=\"bad\">Update with a bad row</button></p>\n<p><output id=\"result\"></output></p>\n\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  const good = [\n    { day: '2026-03-02', sessions: 3120 },\n    { day: '2026-03-03', sessions: 3380 },\n    { day: '2026-03-04', sessions: 3290 },\n  ];\n  // A strict chart throws on any error or warning found while validating a call.\n  const chart = line('#chart', { title: 'Sessions', data: good, x: 'day', y: 'sessions', strict: true });\n\n  document.querySelector('#bad').addEventListener('click', () => {\n    // Untyped, as rows from an API response are.\n    const bad = /** @type {any[]} */ ([...good, { day: '2026-03-05', sessions: 'n/a' }]);\n    try {\n      chart.update({ data: bad });\n    } catch (error) {\n      // The update was rejected as a whole: the chart still shows the last valid data.\n      document.querySelector('#result').textContent = `Rejected: ${error instanceof Error ? error.message : error}`;\n    }\n  });\n</script>\napps/docs/examples/theme-colors.html\n<style>\n  :root {\n    --brand-direct: #1f6fb2;\n    --brand-organic: #2e7d32;\n    --brand-referral: #b4530f;\n    --brand-email: #7b3fa0;\n  }\n  @media (prefers-color-scheme: dark) {\n    :root { --brand-direct: #6cb4ee; --brand-organic: #81c784; --brand-referral: #f0a060; --brand-email: #c39be0; }\n  }\n</style>\n\n<div id=\"all-channels\"></div>\n<div id=\"two-channels\" style=\"margin-top: 24px\"></div>\n\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  // One colour per series name, for every chart on the page. Without it, \"Referral\" would take\n  // the third palette colour on the first chart and the first on the second.\n  const colors = {\n    Direct: 'var(--brand-direct)',\n    'Organic search': 'var(--brand-organic)',\n    Referral: 'var(--brand-referral)',\n    Email: 'var(--brand-email)',\n  };\n\n  /** @param {string[]} channels */\n  const rows = channels => Array.from({ length: 10 }, (_, i) => channels.map((channel, c) => ({\n    day: `2026-03-${String(i + 1).padStart(2, '0')}`,\n    channel,\n    sessions: Math.round(1000 + 600 * c + 150 * Math.sin(i / 2 + c)),\n  }))).flat();\n\n  line('#all-channels', {\n    title: 'Sessions, all channels', data: rows(['Direct', 'Organic search', 'Referral']),\n    x: 'day', y: 'sessions', series: 'channel', colors,\n  });\n  line('#two-channels', {\n    title: 'Sessions, campaigns', data: rows(['Referral', 'Email']),\n    x: 'day', y: 'sessions', series: 'channel', colors,\n  });\n</script>\napps/docs/examples/theme-toggle.html\n<style>\n  /* The page's own theme switch: a data attribute on <html>, as many design systems do it. */\n  html[data-theme=\"light\"] { color-scheme: light; }\n  html[data-theme=\"light\"] body { background: #ffffff; color: #1c1e23; }\n  html[data-theme=\"dark\"] { color-scheme: dark; }\n  html[data-theme=\"dark\"] body { background: #101216; color: #e3e5e9; }\n</style>\n\n<p><button type=\"button\" id=\"theme\">Switch theme</button></p>\n<div id=\"chart\"></div>\n\n<script type=\"module\">\n  import { bar } from 'axylo';\n\n  const rows = [\n    { region: 'Europe', quarter: 'Q1', orders: 420 }, { region: 'Europe', quarter: 'Q2', orders: 465 },\n    { region: 'North America', quarter: 'Q1', orders: 610 }, { region: 'North America', quarter: 'Q2', orders: 590 },\n    { region: 'Asia Pacific', quarter: 'Q1', orders: 300 }, { region: 'Asia Pacific', quarter: 'Q2', orders: 355 },\n  ];\n  bar('#chart', { title: 'Orders by region', data: rows, x: 'region', y: 'orders', series: 'quarter' });\n\n  // The chart repaints by itself when <html> or <body> changes its class, style or data-theme.\n  const root = document.documentElement;\n  const dark = matchMedia('(prefers-color-scheme: dark)').matches;\n  root.dataset.theme = dark ? 'dark' : 'light';\n  document.querySelector('#theme').addEventListener('click', () => {\n    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';\n  });\n</script>\napps/docs/examples/theme-tokens.html\n<style>\n  /* Public tokens can be set on any ancestor of the chart, :root included. */\n  .brand {\n    --axylo-series-1: #0b6e4f;\n    --axylo-series-2: #c84c09;\n    --axylo-grid: transparent;\n    font-family: Georgia, \"Times New Roman\", serif;\n  }\n  /* Pick colours with at least 3:1 against each background the chart can sit on. */\n  @media (prefers-color-scheme: dark) {\n    .brand { --axylo-series-1: #4fd1a5; --axylo-series-2: #ff9a62; }\n  }\n</style>\n\n<div class=\"brand\">\n  <div id=\"chart\"></div>\n</div>\n\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  const rows = Array.from({ length: 12 }, (_, m) => [\n    { month: `2025-${String(m + 1).padStart(2, '0')}`, kind: 'Signups', accounts: Math.round(820 + 40 * m + 90 * Math.sin(m)) },\n    { month: `2025-${String(m + 1).padStart(2, '0')}`, kind: 'Churned', accounts: Math.round(310 + 12 * m + 50 * Math.cos(m)) },\n  ]).flat();\n\n  // The chart inherits the font of .brand; no option is needed.\n  line('#chart', { title: 'Signups and churn', data: rows, x: 'month', y: 'accounts', series: 'kind' });\n</script>\napps/docs/examples/update.html\n<div id=\"chart\"></div>\n<p>\n  <button type=\"button\" id=\"metric\">Show revenue</button>\n  <button type=\"button\" id=\"subtitle\">Add a subtitle</button>\n  <button type=\"button\" id=\"next\">Next week's data</button>\n</p>\n\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  /** @param {number} start the first day of the week in March */\n  const week = start => Array.from({ length: 7 }, (_, i) => ({\n    day: `2026-03-${String(start + i).padStart(2, '0')}`,\n    orders: Math.round(180 + 25 * Math.sin(start + i)),\n    revenue: Math.round(9000 + 1400 * Math.cos(start + i)),\n  }));\n\n  const chart = line('#chart', { title: 'Orders', data: week(2), x: 'day', y: 'orders' });\n\n  const metric = document.querySelector('#metric');\n  let revenue = false;\n  metric.addEventListener('click', () => {\n    revenue = !revenue;\n    // A present key replaces its old value whole: `y` is a new field spec, `title` a new title.\n    chart.update(revenue\n      ? { title: 'Revenue', y: { field: 'revenue', label: 'Revenue', unit: 'USD' } }\n      : { title: 'Orders', y: 'orders' });\n    metric.textContent = revenue ? 'Show orders' : 'Show revenue';\n  });\n\n  const toggle = document.querySelector('#subtitle');\n  let subtitle = false;\n  toggle.addEventListener('click', () => {\n    subtitle = !subtitle;\n    // `undefined` returns the option to its default (no subtitle). Absent keys stay as they are.\n    chart.update({ subtitle: subtitle ? 'Week of 2 March' : undefined });\n    toggle.textContent = subtitle ? 'Remove the subtitle' : 'Add a subtitle';\n  });\n\n  let start = 2;\n  document.querySelector('#next').addEventListener('click', () => {\n    start = start === 2 ? 9 : 2;\n    chart.update({ data: week(start), subtitle: subtitle ? `Week of ${start} March` : undefined });\n  });\n</script>\napps/docs/examples/zoom.html\n<div id=\"chart\"></div>\n<p>\n  <button type=\"button\" id=\"last-week\">Last 7 days</button>\n  <button type=\"button\" id=\"all\">Everything</button>\n</p>\n<p><output id=\"range\">Showing everything.</output></p>\n<p><output id=\"picked\">Press Enter on a point, or click one, to select it.</output></p>\n\n<script type=\"module\">\n  import { line } from 'axylo';\n\n  const rows = Array.from({ length: 31 }, (_, i) => ({\n    day: `2026-03-${String(i + 1).padStart(2, '0')}`,\n    sessions: Math.round(3000 + 30 * i + 400 * Math.sin(i / 1.3)),\n  }));\n  const chart = line('#chart', { title: 'Daily sessions, March', data: rows, x: 'day', y: 'sessions' });\n\n  const range = document.querySelector('#range');\n  const picked = document.querySelector('#picked');\n  /**\n   * Events give dates as epoch milliseconds; a calendar date is its UTC midnight.\n   * @param {string | number | Date} value\n   */\n  const day = value => new Date(value).toISOString().slice(0, 10);\n\n  // `zoom` sets the visible x range; null shows everything. The buttons, a drag, the keys\n  // + - 0 and the toolbar all end in the same 'zoom' event.\n  document.querySelector('#last-week').addEventListener('click', () => chart.zoom(['2026-03-25', '2026-03-31']));\n  document.querySelector('#all').addEventListener('click', () => chart.zoom(null));\n\n  chart.on('zoom', window => {\n    range.textContent = window ? `Showing ${day(window[0])} to ${day(window[1])}.` : 'Showing everything.';\n  });\n  chart.on('select', point => {\n    picked.textContent = `Selected ${point.series} on ${day(point.x)}: ${point.y ?? 'no data'} (row ${point.index}).`;\n  });\n</script>\n","exit_code":0,"status":"completed"}}
