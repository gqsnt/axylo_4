{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"nl -ba apps/docs/lib/site.mjs | sed -n '127,244p'\nfor f in apps/docs/test/{options,theming,diagnostics,examples.browser,node.browser}.test.ts; do echo \\\"\"'$f\"; nl -ba \"$f\"; done'","aggregated_output":"   127\t/**\n   128\t * React and React DOM as ES modules for the import map. Both packages are CommonJS, so each entry is a small\n   129\t * module that re-exports the names the package has, read from the package itself.\n   130\t */\n   131\tasync function buildVendor(outDir) {\n   132\t  const require = createRequire(path.join(repoRoot, 'package.json'));\n   133\t  const dir = path.join(cacheDir, 'vendor');\n   134\t  fs.mkdirSync(dir, { recursive: true });\n   135\t  const entries = { react: 'react', 'jsx-runtime': 'react/jsx-runtime', 'react-dom-client': 'react-dom/client' };\n   136\t  const entryPoints = {};\n   137\t  for (const [out, specifier] of Object.entries(entries)) {\n   138\t    const names = Object.keys(require(specifier)).filter(n => /^[A-Za-z_$][\\w$]*$/.test(n) && n !== 'default');\n   139\t    const file = path.join(dir, `${out}.mjs`);\n   140\t    fs.writeFileSync(file, `import m from '${specifier}';\\nexport default m;\\n${names.map(n => `export const ${n} = m.${n};`).join('\\n')}\\n`);\n   141\t    entryPoints[out] = file;\n   142\t  }\n   143\t  await build({\n   144\t    entryPoints, bundle: true, format: 'esm', splitting: true, outdir: path.join(outDir, 'assets/vendor'), target: 'es2022',\n   145\t    define: { 'process.env.NODE_ENV': '\"development\"' }, logLevel: 'warning', nodePaths: [path.join(repoRoot, 'node_modules')],\n   146\t    absWorkingDir: repoRoot,\n   147\t  });\n   148\t}\n   149\t\n   150\t// ---------- examples ----------\n   151\t\n   152\tconst IMPORT_MAP = JSON.stringify({ imports: {\n   153\t  axylo: '../assets/axylo.js',\n   154\t  '@axylo/react': '../assets/axylo-react.js',\n   155\t  react: '../assets/vendor/react.js',\n   156\t  'react/jsx-runtime': '../assets/vendor/jsx-runtime.js',\n   157\t  'react-dom/client': '../assets/vendor/react-dom-client.js',\n   158\t} }, null, 2);\n   159\t\n   160\tasync function buildExamples(outDir) {\n   161\t  const examples = listExamples();\n   162\t  const compiled = examples.filter(e => e.ext !== 'html');\n   163\t  if (compiled.length) {\n   164\t    await build({\n   165\t      entryPoints: compiled.map(e => path.join(docsRoot, 'examples', e.file)), bundle: true, format: 'esm', target: 'es2022',\n   166\t      outdir: path.join(outDir, 'examples'), jsx: 'automatic', logLevel: 'warning',\n   167\t      external: ['axylo', '@axylo/react', 'react', 'react/jsx-runtime', 'react-dom', 'react-dom/client'],\n   168\t    });\n   169\t  }\n   170\t  const manifest = [];\n   171\t  for (const e of examples) {\n   172\t    fs.writeFileSync(path.join(outDir, 'examples', `${e.name}.html`), examplePage(e));\n   173\t    manifest.push({ name: e.name, file: e.file, ext: e.ext, raises: e.raises, noMarks: e.noMarks });\n   174\t  }\n   175\t  fs.writeFileSync(path.join(outDir, 'examples/manifest.json'), JSON.stringify(manifest, null, 2));\n   176\t  return manifest;\n   177\t}\n   178\t\n   179\tfunction examplePage(e) {\n   180\t  // An .html example's own <style> goes to the head, where it belongs; the reader sees it in the source as written.\n   181\t  const styles = e.ext === 'html' ? [...e.source.matchAll(/<style>[\\s\\S]*?<\\/style>\\n?/g)].map(m => m[0]).join('') : '';\n   182\t  const body = e.ext === 'html'\n   183\t    ? e.source.replace(/<style>[\\s\\S]*?<\\/style>\\n?/g, '')\n   184\t    : e.ext === 'tsx'\n   185\t      ? '<div id=\"root\"></div>\\n<script type=\"module\" src=\"' + e.name + '.js\"></script>'\n   186\t      : e.targets.map(id => `<div id=\"${escapeHtml(id)}\" class=\"example-target\"></div>`).join('\\n') +\n   187\t        `\\n<script type=\"module\" src=\"${e.name}.js\"></script>`;\n   188\t  return `<!doctype html>\n   189\t<html lang=\"en\">\n   190\t<head>\n   191\t<meta charset=\"utf-8\">\n   192\t<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n   193\t<meta name=\"color-scheme\" content=\"light dark\">\n   194\t<title>Example: ${escapeHtml(e.name)}</title>\n   195\t<link rel=\"icon\" href=\"data:,\">\n   196\t<link rel=\"stylesheet\" href=\"../assets/site.css\">\n   197\t<script type=\"importmap\">\n   198\t${IMPORT_MAP}\n   199\t</script>\n   200\t<script src=\"../assets/frame.js\" defer></script>\n   201\t${styles}</head>\n   202\t<body class=\"example-page\">\n   203\t${body}\n   204\t</body>\n   205\t</html>\n   206\t`;\n   207\t}\n   208\t\n   209\t// ---------- pages ----------\n   210\t\n   211\tfunction renderPage(entry, source, index, ctx) {\n   212\t  const headings = [];\n   213\t  const where = path.join(pagesDir, `${entry.page}.md`);\n   214\t  const body = markdownToHtml(source, {\n   215\t    headings,\n   216\t    link: url => pageLink(url),\n   217\t    directive: d => directive(d, where, ctx),\n   218\t  });\n   219\t  const title = headings.find(h => h.level === 1)?.text ?? entry.label;\n   220\t  const prev = pages[index - 1];\n   221\t  const next = pages[index + 1];\n   222\t  const pager = `<nav class=\"pager\" aria-label=\"Previous and next page\">${prev ? `<a rel=\"prev\" href=\"${prev.page}.html\">← ${escapeHtml(prev.label)}</a>` : '<span></span>'}${next ? `<a rel=\"next\" href=\"${next.page}.html\">${escapeHtml(next.label)} →</a>` : ''}</nav>`;\n   223\t  return layout({\n   224\t    title, body: body + pager, current: entry.page, base: '', ctx,\n   225\t    sourcePath: `apps/docs/pages/${entry.page}.md`,\n   226\t  });\n   227\t}\n   228\t\n   229\tconst PAGE_NAMES = new Set(pages.map(p => p.page));\n   230\t\n   231\t/** Rewrites a link written for the Markdown sources (readable on a code host) to its place in the site. */\n   232\texport function pageLink(url, base = '') {\n   233\t  if (/^[a-z]+:/i.test(url) || url.startsWith('#')) return url;\n   234\t  const [file, hash] = url.split('#');\n   235\t  const code = file === 'diagnostics.md' && hash && /^ax\\d{3}$/i.test(hash) ? hash.toUpperCase() : null;\n   236\t  if (code) return `${base}diagnostics/${code}.html`;\n   237\t  const name = file.endsWith('.md') && !file.includes('/') ? file.slice(0, -3) : null;\n   238\t  if (name !== null && PAGE_NAMES.has(name)) return `${base}${name}.html${hash ? '#' + hash : ''}`;\n   239\t  // A path into the repository: pages/ and dist/ sit at the same depth, so it resolves the same from both\n   240\t  // when the site is served from the repository root.\n   241\t  return base + url;\n   242\t}\n   243\t\n   244\tfunction directive({ kind, name, target }, where, ctx) {\napps/docs/test/options.test.ts\n     1\t/**\n     2\t * The options reference (apps/docs/pages/options.md) documents exactly the keys of the public types: every\n     3\t * key of every option type, field type, handle and event in packages/axylo/src/public.ts (and the React\n     4\t * props in packages/react/src/index.ts) appears in the reference, and nothing in the reference is missing\n     5\t * from the types. The keys are read with the TypeScript compiler API (typescript/unstable/sync, TypeScript 7)\n     6\t * from the source declarations, so the test needs no build.\n     7\t *\n     8\t * Each table in the reference is marked `<!-- options: Group -->`; its first column lists the keys in\n     9\t * backticks. GROUPS says which keys of the types each group stands for.\n    10\t */\n    11\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n    12\timport fs from 'node:fs';\n    13\timport path from 'node:path';\n    14\timport { API } from 'typescript/unstable/sync';\n    15\timport { cacheDir, docsRoot, repoRoot } from '../lib/examples.mjs';\n    16\timport { defaultMessages } from '../../../packages/axylo/src/messages/index';\n    17\t\n    18\tconst Keys = 'type Keys<T> = T extends unknown ? { [K in keyof T]-?: [Exclude<T[K], undefined>] extends [never] ? never : K }[keyof T] : never;';\n    19\tconst L = 'LineOptions<Row>';\n    20\tconst GROUPS: Record<string, string> = {\n    21\t  CommonOptions: 'Keys<CommonOptions<Row>>',\n    22\t  Title: 'Keys<Title>',\n    23\t  Encoding: 'Keys<Encoding<Row>>',\n    24\t  CartesianOptions: 'Keys<CartesianOptions>',\n    25\t  Reference: 'Keys<Reference>',\n    26\t  CompactOption: 'Keys<CompactOption>',\n    27\t  AreaOptions: `Exclude<Keys<AreaOptions<Row>>, Keys<${L}>>`,\n    28\t  BarOptions: `Exclude<Keys<BarOptions<Row>>, Keys<${L}>>`,\n    29\t  ScatterOptions: 'Exclude<Keys<ScatterOptions<Row>>, Keys<CommonOptions<Row>> | Keys<CartesianOptions>>',\n    30\t  DonutOptions: 'Exclude<Keys<DonutOptions<Row>>, Keys<CommonOptions<Row>>>',\n    31\t  ValueField: 'Keys<Exclude<ValueField<Row>, string>>',\n    32\t  XField: 'Keys<Exclude<XField<Row>, string>>',\n    33\t  ScatterXField: 'Keys<Exclude<ScatterXField<Row>, string>>',\n    34\t  Chart: `Keys<Chart<Row, ${L}>>`,\n    35\t  AppendOptions: `Keys<NonNullable<Parameters<Chart<Row, ${L}>['append']>[1]>>`,\n    36\t  ChartEvents: 'Keys<ChartEvents<Row>>',\n    37\t  Point: 'Keys<Point<Row>>',\n    38\t  Diagnostic: 'Keys<Diagnostic>',\n    39\t  ReactProps: `Exclude<Keys<LineProps<Row>>, Keys<${L}>>`,\n    40\t  ChartRef: `Keys<ChartRef<Row, ${L}>>`,\n    41\t};\n    42\t// Checks on the types themselves, so a key added to a composite type directly is not missed.\n    43\tconst EXTRA: Record<string, string> = {\n    44\t  LineOptions: `Keys<${L}>`,\n    45\t  Messages: 'Keys<Messages>',\n    46\t  DonutReactProps: 'Exclude<Keys<DonutProps<Row>>, Keys<DonutOptions<Row>>>',\n    47\t  AreaReactProps: 'Exclude<Keys<AreaProps<Row>>, Keys<AreaOptions<Row>>>',\n    48\t  BarReactProps: 'Exclude<Keys<BarProps<Row>>, Keys<BarOptions<Row>>>',\n    49\t  ScatterReactProps: 'Exclude<Keys<ScatterProps<Row>>, Keys<ScatterOptions<Row>>>',\n    50\t};\n    51\t\n    52\tconst dir = path.join(cacheDir, 'types');\n    53\tconst probe = path.join(dir, 'probe.ts');\n    54\tlet api: API;\n    55\tconst keys: Record<string, string[]> = {};\n    56\t\n    57\t/** `\"a\" | \"b\" | \\`data-${string}\\`` → ['a', 'b', 'data-*']. */\n    58\tfunction parseUnion(text: string): string[] {\n    59\t  if (text === 'never') return [];\n    60\t  return text.split(' | ').map(part => part.startsWith('\"') ? JSON.parse(part) as string : part.replace(/^`(.*)\\$\\{string\\}`$/, '$1*'));\n    61\t}\n    62\t\n    63\tbeforeAll(() => {\n    64\t  fs.mkdirSync(dir, { recursive: true });\n    65\t  const rel = (p: string) => path.relative(dir, path.join(repoRoot, p)).split(path.sep).join('/');\n    66\t  fs.writeFileSync(path.join(dir, 'tsconfig.json'), JSON.stringify({\n    67\t    extends: rel('tsconfig.base.json'),\n    68\t    compilerOptions: {\n    69\t      noEmit: true, types: [], jsx: 'react-jsx',\n    70\t      paths: { axylo: [rel('packages/axylo/src/index.ts')], '@axylo/react': [rel('packages/react/src/index.ts')] },\n    71\t    },\n    72\t    files: ['probe.ts', rel('packages/axylo/src/core/globals.d.ts')],\n    73\t  }, null, 2));\n    74\t  const all = { ...GROUPS, ...EXTRA };\n    75\t  fs.writeFileSync(probe, [\n    76\t    \"import type { AreaOptions, BarOptions, CartesianOptions, Chart, ChartEvents, CommonOptions, CompactOption, Diagnostic, DonutOptions, Encoding, LineOptions, Messages, Point, Reference, ScatterOptions, ScatterXField, Title, ValueField, XField } from 'axylo';\",\n    77\t    \"import type { AreaProps, BarProps, ChartRef, DonutProps, LineProps, ScatterProps } from '@axylo/react';\",\n    78\t    'interface Row { day: string; v: number; s: string }',\n    79\t    Keys,\n    80\t    ...Object.entries(all).map(([name, type]) => `export declare const k_${name}: ${type};`),\n    81\t  ].join('\\n'));\n    82\t  api = new API({ cwd: dir });\n    83\t  const snapshot = api.updateSnapshot({ openProjects: [path.join(dir, 'tsconfig.json')] });\n    84\t  const project = snapshot.getProjects()[0]!;\n    85\t  const text = project.program.getSourceFile(probe)!.text;\n    86\t  for (const name of Object.keys(all)) {\n    87\t    const type = project.checker.getTypeAtPosition(probe, text.indexOf(`k_${name}:`));\n    88\t    // 1 = TypeFormatFlags.NoTruncation: the whole union, however long.\n    89\t    keys[name] = parseUnion(project.checker.typeToString(type!, undefined, 1)).sort();\n    90\t  }\n    91\t}, 60_000);\n    92\t\n    93\tafterAll(() => api?.close());\n    94\t\n    95\t/** Keys per marked table of options.md. */\n    96\tfunction documented(): Record<string, string[]> {\n    97\t  const source = fs.readFileSync(path.join(docsRoot, 'pages/options.md'), 'utf8').split('\\n');\n    98\t  const out: Record<string, string[]> = {};\n    99\t  for (let i = 0; i < source.length; i++) {\n   100\t    const marker = /^<!-- options: (\\w+) -->$/.exec(source[i]!.trim());\n   101\t    if (!marker) continue;\n   102\t    const names: string[] = [];\n   103\t    // Skip the header and rule; read rows until the table ends.\n   104\t    for (let j = i + 3; j < source.length && source[j]!.startsWith('|'); j++) {\n   105\t      const first = source[j]!.split(/(?<!\\\\)\\|/)[1] ?? '';\n   106\t      names.push(...[...first.matchAll(/`([^`]+)`/g)].map(m => m[1]!));\n   107\t    }\n   108\t    out[marker[1]!] = names.sort();\n   109\t  }\n   110\t  return out;\n   111\t}\n   112\t\n   113\tdescribe('options reference against the public types', () => {\n   114\t  const docs = documented();\n   115\t\n   116\t  it('every marked table is a known group, and every group has a table', () => {\n   117\t    expect(Object.keys(docs).sort()).toEqual(Object.keys(GROUPS).sort());\n   118\t  });\n   119\t\n   120\t  it.each(Object.keys(GROUPS))('%s: documented keys equal the type\\'s keys', group => {\n   121\t    const types = keys[group]!;\n   122\t    expect(types.length, `${group} has keys`).toBeGreaterThan(0);\n   123\t    expect({ missingFromReference: types.filter(k => !docs[group]?.includes(k)), notInTypes: (docs[group] ?? []).filter(k => !types.includes(k)) })\n   124\t      .toEqual({ missingFromReference: [], notInTypes: [] });\n   125\t  });\n   126\t\n   127\t  it('LineOptions is exactly the common, encoding, cartesian and compact groups', () => {\n   128\t    const groups = [...keys.CommonOptions!, ...keys.Encoding!, ...keys.CartesianOptions!, ...keys.CompactOption!];\n   129\t    expect(keys.LineOptions).toEqual([...new Set(groups)].sort());\n   130\t  });\n   131\t\n   132\t  it('the React components take the same extra props, except onZoom on Donut', () => {\n   133\t    expect(keys.AreaReactProps).toEqual(keys.ReactProps);\n   134\t    expect(keys.BarReactProps).toEqual(keys.ReactProps);\n   135\t    expect(keys.ScatterReactProps).toEqual(keys.ReactProps);\n   136\t    expect(keys.DonutReactProps).toEqual(keys.ReactProps!.filter(k => k !== 'onZoom'));\n   137\t  });\n   138\t\n   139\t  it('the generated Messages table lists every key of Messages', () => {\n   140\t    // The table is generated from defaultMessages; this checks that defaultMessages has exactly the type's keys.\n   141\t    expect(Object.keys(defaultMessages).sort()).toEqual(keys.Messages);\n   142\t  });\n   143\t});\napps/docs/test/theming.test.ts\n     1\t/**\n     2\t * The theming page documents exactly the CSS custom properties the library's stylesheet uses: a property in\n     3\t * packages/axylo/src/theme/css.ts that is not in apps/docs/data/tokens.mjs fails, and so does a documented one\n     4\t * that is not in the stylesheet. The private defaults (`--axylo-default-*`) are the values behind the public\n     5\t * names, not properties of their own; each documented default must exist in both schemes.\n     6\t */\n     7\timport { describe, expect, it } from 'vitest';\n     8\timport { AXYLO_CSS } from '../../../packages/axylo/src/theme/css';\n     9\timport { readThemeDefaults } from '../lib/site.mjs';\n    10\timport { internalTokens, tokens } from '../data/tokens.mjs';\n    11\t\n    12\tconst inStylesheet = [...new Set([...AXYLO_CSS.matchAll(/--axylo-[a-z0-9-]+/g)].map(m => m[0]))]\n    13\t  .filter(name => !name.startsWith('--axylo-default-'))\n    14\t  .sort();\n    15\tconst documented = [...tokens, ...internalTokens].map(t => t.name).sort();\n    16\t\n    17\tdescribe('theme custom properties', () => {\n    18\t  it('every custom property in the stylesheet is documented', () => {\n    19\t    expect(inStylesheet.filter(name => !documented.includes(name))).toEqual([]);\n    20\t  });\n    21\t  it('every documented custom property is in the stylesheet', () => {\n    22\t    expect(documented.filter(name => !inStylesheet.includes(name))).toEqual([]);\n    23\t  });\n    24\t  it('no property is documented twice', () => {\n    25\t    expect(documented.filter((name, i) => documented.indexOf(name) !== i)).toEqual([]);\n    26\t  });\n    27\t  it('every documented default exists in the light and the dark scheme', () => {\n    28\t    const { light, dark } = readThemeDefaults(AXYLO_CSS);\n    29\t    for (const t of tokens.filter(t => 'default' in t && t.default)) {\n    30\t      expect(light[t.default!], `${t.default} (light)`).toMatch(/^#[0-9a-f]{6}$/i);\n    31\t      expect(dark[t.default!], `${t.default} (dark)`).toMatch(/^#[0-9a-f]{6}$/i);\n    32\t    }\n    33\t  });\n    34\t  it('every private default in the stylesheet belongs to a documented property', () => {\n    35\t    const { light, dark } = readThemeDefaults(AXYLO_CSS);\n    36\t    const used = new Set(tokens.map(t => t.default).filter(Boolean));\n    37\t    expect([...new Set([...Object.keys(light), ...Object.keys(dark)])].filter(name => !used.has(name))).toEqual([]);\n    38\t  });\n    39\t  it('a property without a colour default says what happens when it is unset', () => {\n    40\t    for (const t of tokens.filter(t => !t.default)) expect(t.unset, t.name).toBeTruthy();\n    41\t  });\n    42\t});\napps/docs/test/diagnostics.test.ts\n     1\t/**\n     2\t * Criterion DX4: every diagnostic code has a documentation page, and every documented code exists. The pages\n     3\t * are generated from apps/docs/data/diagnostics.mjs, one per entry, so the check is on that file against the\n     4\t * registry the library reports from (packages/axylo/src/diagnostics/registry.ts). The built pages themselves\n     5\t * are checked in diagnostics.browser.test.ts, after the site is built.\n     6\t *\n     7\t * Also: each entry's level is the registry's, its condition follows the spec table, and each minimal input\n     8\t * that runs in Node raises its code through validate().\n     9\t */\n    10\timport { describe, expect, it } from 'vitest';\n    11\timport { diagnosticRegistry, createDiagnostic } from '../../../packages/axylo/src/diagnostics/registry';\n    12\timport { validate } from '../../../packages/axylo/src/index';\n    13\timport { diagnostics } from '../data/diagnostics.mjs';\n    14\t\n    15\tconst registryCodes = Object.keys(diagnosticRegistry).sort();\n    16\tconst documented = diagnostics.map(d => d.code);\n    17\t\n    18\tdescribe('diagnostics documentation covers the registry', () => {\n    19\t  it('every code in the registry has a page', () => {\n    20\t    expect(registryCodes.filter(code => !documented.includes(code))).toEqual([]);\n    21\t  });\n    22\t  it('every page is for a code in the registry', () => {\n    23\t    expect(documented.filter(code => !registryCodes.includes(code))).toEqual([]);\n    24\t  });\n    25\t  it('no code has two pages', () => {\n    26\t    expect(documented.filter((code, i) => documented.indexOf(code) !== i)).toEqual([]);\n    27\t  });\n    28\t  it.each(diagnostics.map(d => [d.code, d] as const))('%s has the registry level and every section', (code, d) => {\n    29\t    expect(d.level).toBe(diagnosticRegistry[code as keyof typeof diagnosticRegistry].level);\n    30\t    for (const key of ['title', 'condition', 'drawn', 'see', 'why', 'fix', 'input'] as const) {\n    31\t      expect(typeof d[key] === 'string' && d[key].trim().length > 0, `${code}.${key}`).toBe(true);\n    32\t    }\n    33\t    expect(['node', 'browser']).toContain(d.run);\n    34\t  });\n    35\t});\n    36\t\n    37\tdescribe('minimal inputs that run in Node raise their code', () => {\n    38\t  const inNode = diagnostics.filter(d => d.run === 'node');\n    39\t  it.each(inNode.map(d => [d.code, d.input] as const))('%s', (code, input) => {\n    40\t    const found = new Function('validate', `return ${input}`)(validate) as { code: string }[];\n    41\t    expect(found.map(f => f.code)).toContain(code);\n    42\t  });\n    43\t});\n    44\t\n    45\tdescribe('documentation links in messages', () => {\n    46\t  // The registry's messages carry no URL today. If one is added, it must point at that code's own page,\n    47\t  // apps/docs/dist/diagnostics/<code>.html, under whatever base the site is published at.\n    48\t  it.each(registryCodes)('%s', code => {\n    49\t    const message = createDiagnostic(code as keyof typeof diagnosticRegistry, 'none', { field: 'f', rows: [1], count: 1 }).message;\n    50\t    for (const url of message.match(/https?:\\/\\/\\S+|\\S+\\.html\\b/g) ?? []) {\n    51\t      expect(url.replace(/[).,]+$/, '')).toMatch(new RegExp(`/diagnostics/${code}\\\\.html$`));\n    52\t    }\n    53\t  });\n    54\t});\napps/docs/test/examples.browser.test.ts\n     1\t/**\n     2\t * Criterion DX10: every runnable example in the documentation is compiled and rendered from the built\n     3\t * library. Run after `npm run build`:\n     4\t *\n     5\t *   AXYLO_BROWSER=1 npx vitest run apps/docs/test/examples.browser.test.ts\n     6\t *\n     7\t * 1. Type-checks every example against the package's declarations (packages/axylo/dist/index.d.ts and\n     8\t *    packages/react/dist/index.d.ts, reached through the workspace packages `axylo` and `@axylo/react`).\n     9\t * 2. Builds the site, which compiles the examples with esbuild and copies the library's built files.\n    10\t * 3. Opens each example's page in system Chrome and checks: every chart has an accessible name; every\n    11\t *    chart draws marks unless the example says it draws none on purpose; no console errors or page errors;\n    12\t *    the diagnostics printed are exactly the ones the example says it raises on purpose.\n    13\t *\n    14\t * Examples run in America/Los_Angeles, where an instant at UTC midnight is the previous evening, so the\n    15\t * date examples are exercised where they matter, and at 760 px, about the width an example has on a\n    16\t * documentation page on a desktop screen.\n    17\t */\n    18\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n    19\timport { execFileSync } from 'node:child_process';\n    20\timport path from 'node:path';\n    21\timport { chromium, type Browser } from 'playwright-core';\n    22\timport { buildSite } from '../lib/site.mjs';\n    23\timport { docsRoot, listExamples, repoRoot, writeTypecheckInputs } from '../lib/examples.mjs';\n    24\timport { serve } from '../lib/serve.mjs';\n    25\t\n    26\tinterface Example { name: string; file: string; ext: string; raises: string[]; noMarks: boolean }\n    27\t\n    28\t// Through node itself, so the same call works on Windows, where node_modules/.bin/tsc is a shell script.\n    29\tconst tsc = path.join(repoRoot, 'node_modules/typescript/bin/tsc');\n    30\t// Read from the sources at collection time, so each example is its own test.\n    31\tconst examples: Example[] = listExamples();\n    32\tlet server: Awaited<ReturnType<typeof serve>>;\n    33\tlet browser: Browser;\n    34\t\n    35\tfunction typecheck(config: string): string {\n    36\t  try {\n    37\t    execFileSync(process.execPath, [tsc, '-p', path.join(docsRoot, 'examples', config)], { cwd: repoRoot, encoding: 'utf8', stdio: 'pipe' });\n    38\t    return '';\n    39\t  } catch (error) {\n    40\t    const e = error as { stdout?: string; stderr?: string };\n    41\t    return `${e.stdout ?? ''}${e.stderr ?? ''}` || String(error);\n    42\t  }\n    43\t}\n    44\t\n    45\tbeforeAll(async () => {\n    46\t  writeTypecheckInputs();\n    47\t  await buildSite();\n    48\t  server = await serve();\n    49\t  browser = await chromium.launch({ channel: 'chrome', headless: true });\n    50\t}, 120_000);\n    51\t\n    52\tafterAll(async () => {\n    53\t  await browser?.close();\n    54\t  await server?.close();\n    55\t});\n    56\t\n    57\tdescribe('examples type-check against the package declarations', () => {\n    58\t  it('TypeScript and React examples (strict)', () => {\n    59\t    expect(typecheck('tsconfig.json')).toBe('');\n    60\t  });\n    61\t  it('scripts of the HTML examples (checkJs)', () => {\n    62\t    expect(typecheck('tsconfig.html.json')).toBe('');\n    63\t  });\n    64\t});\n    65\t\n    66\tdescribe('examples render in Chrome from the built library', () => {\n    67\t  it('there are examples', () => {\n    68\t    expect(examples.length).toBeGreaterThan(20);\n    69\t  });\n    70\t\n    71\t  it.each(examples.map(example => [example.file, example] as const))('%s', async (_file, example) => {\n    72\t    const context = await browser.newContext({\n    73\t      viewport: { width: 760, height: 900 }, locale: 'en-US', timezoneId: 'America/Los_Angeles',\n    74\t    });\n    75\t    const page = await context.newPage();\n    76\t    const errors: string[] = [];\n    77\t    const codes = new Set<string>();\n    78\t    page.on('pageerror', error => errors.push(`page error: ${error.message}`));\n    79\t    page.on('console', message => {\n    80\t      const text = message.text();\n    81\t      if (message.type() === 'error') errors.push(`console.error: ${text}`);\n    82\t      for (const m of text.matchAll(/^\\[axylo (AX\\d{3})\\]/g)) codes.add(m[1]!);\n    83\t      if (message.type() === 'warning' && !text.startsWith('[axylo ')) errors.push(`console.warn: ${text}`);\n    84\t    });\n    85\t    page.on('requestfailed', request => errors.push(`request failed: ${request.url()}`));\n    86\t    page.on('response', response => { if (response.status() >= 400) errors.push(`HTTP ${response.status()}: ${response.url()}`); });\n    87\t    await page.goto(server.url(`apps/docs/dist/examples/${example.name}.html`));\n    88\t\n    89\t    // Ready when every chart has drawn marks or shows a state message, and nothing changes for 3 frames.\n    90\t    await page.waitForFunction(() => {\n    91\t      const figures = [...document.querySelectorAll('figure.axylo-figure')];\n    92\t      return figures.length > 0 && figures.every(f =>\n    93\t        f.querySelector('svg [style*=\"--axylo-series-color\"], canvas') !== null ||\n    94\t        [...f.querySelectorAll('.axylo-message')].some(m => !(m as HTMLElement).hidden && m.textContent));\n    95\t    }, null, { timeout: 15_000 });\n    96\t    await page.evaluate(() => new Promise(resolve => {\n    97\t      let n = 0;\n    98\t      const tick = () => (++n < 3 ? requestAnimationFrame(tick) : resolve(null));\n    99\t      requestAnimationFrame(tick);\n   100\t    }));\n   101\t\n   102\t    const charts = await page.evaluate(() => [...document.querySelectorAll('figure.axylo-figure')].map(f => {\n   103\t      const labelled = f.getAttribute('aria-labelledby');\n   104\t      const name = (f.getAttribute('aria-label') ?? '') ||\n   105\t        (labelled ?? '').split(/\\s+/).map(id => document.getElementById(id)?.textContent ?? '').join(' ').trim();\n   106\t      const marks = [...f.querySelectorAll('svg [style*=\"--axylo-series-color\"]')].filter(el => {\n   107\t        const box = (el as SVGGraphicsElement).getBBox();\n   108\t        return box.width > 0 || box.height > 0;\n   109\t      }).length;\n   110\t      const message = [...f.querySelectorAll('.axylo-message')].find(m => !(m as HTMLElement).hidden)?.textContent ?? '';\n   111\t      return { role: f.getAttribute('role'), name, marks, message };\n   112\t    }));\n   113\t\n   114\t    expect(charts.length, `${example.file}: charts`).toBeGreaterThan(0);\n   115\t    for (const chart of charts) {\n   116\t      expect(['group', 'img'], `${example.file}: role`).toContain(chart.role);\n   117\t      expect(chart.name, `${example.file}: accessible name`).not.toBe('');\n   118\t      if (example.noMarks) expect(chart.message, `${example.file}: a state message`).not.toBe('');\n   119\t      else expect(chart.marks, `${example.file}: \"${chart.name}\" draws marks (message: \"${chart.message}\")`).toBeGreaterThan(0);\n   120\t    }\n   121\t    expect(errors, `${example.file}: errors`).toEqual([]);\n   122\t    expect([...codes].sort(), `${example.file}: diagnostics printed`).toEqual([...example.raises].sort());\n   123\t    await context.close();\n   124\t  }, 60_000);\n   125\t});\napps/docs/test/node.browser.test.ts\n     1\t/**\n     2\t * Runs in Node, after `npm run build`, with the browser suite (it needs the built package, not a browser).\n     3\t * The Node examples quoted on the Diagnostics page (apps/docs/examples/node) type-check against the package's\n     4\t * declarations and run against its built files: chart-data.test.ts is itself a Vitest test and runs with this\n     5\t * suite; validate.ts is a script and is run here. Also checks the React page's statement about server\n     6\t * rendering, through the package as an application imports it.\n     7\t */\n     8\timport { describe, expect, it, vi } from 'vitest';\n     9\timport { execFileSync } from 'node:child_process';\n    10\timport path from 'node:path';\n    11\timport { createElement } from 'react';\n    12\timport { renderToString } from 'react-dom/server';\n    13\timport { docsRoot, repoRoot } from '../lib/examples.mjs';\n    14\t\n    15\tdescribe('Node examples', () => {\n    16\t  it('type-check (examples/node/tsconfig.json)', () => {\n    17\t    let output = '';\n    18\t    try {\n    19\t      // Through node itself, so the same call works on Windows.\n    20\t      const tsc = path.join(repoRoot, 'node_modules/typescript/bin/tsc');\n    21\t      execFileSync(process.execPath, [tsc, '-p', path.join(docsRoot, 'examples/node/tsconfig.json')], { cwd: repoRoot, encoding: 'utf8', stdio: 'pipe' });\n    22\t    } catch (error) {\n    23\t      const e = error as { stdout?: string; stderr?: string };\n    24\t      output = `${e.stdout ?? ''}${e.stderr ?? ''}` || String(error);\n    25\t    }\n    26\t    expect(output).toBe('');\n    27\t  });\n    28\t\n    29\t  it('validate.ts runs and finds nothing blocking', async () => {\n    30\t    const log = vi.spyOn(console, 'log').mockImplementation(() => {});\n    31\t    await import('../examples/node/validate');\n    32\t    expect(log).toHaveBeenCalledWith('Checked \"Orders per day\": 0 diagnostics, none blocking.');\n    33\t    log.mockRestore();\n    34\t  });\n    35\t});\n    36\t\n    37\tdescribe('React server rendering', () => {\n    38\t  it('renders only the empty container, with its own attributes', async () => {\n    39\t    const { Line } = await import('@axylo/react');\n    40\t    const html = renderToString(createElement(Line as never, {\n    41\t      id: 'sessions', 'data-card': 'kpi', title: 'Sessions',\n    42\t      data: [{ day: '2026-03-02', sessions: 3120 }], x: 'day', y: 'sessions',\n    43\t    }));\n    44\t    const element = /^<div((?: [\\w-]+=\"[^\"]*\")*)><\\/div>$/.exec(html);\n    45\t    expect(element, html).not.toBeNull();\n    46\t    const attributes = Object.fromEntries([...element![1]!.matchAll(/ ([\\w-]+)=\"([^\"]*)\"/g)].map(m => [m[1], m[2]]));\n    47\t    expect(attributes).toEqual({ id: 'sessions', class: 'axylo', 'data-card': 'kpi' });\n    48\t  });\n    49\t});\n","exit_code":0,"status":"completed"}}
