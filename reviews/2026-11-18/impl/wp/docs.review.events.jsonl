{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"node -v\nls -a apps/docs/.cache/html-scripts\nnode_modules/.bin/vitest --help --expand-help | rg -i 'cache|loader|persist'\nls node_modules/typescript/lib\nrg -n 'Build plan|DX10|DX12|3.8|documentation site' docs/03-plan-typescript-release.md\"","aggregated_output":"v24.21.0\n.\n..\na11y-card.1.js\ncompact-dirty.1.js\ncompact-tiles.1.js\ndiagnostics-listener.1.js\nglobals.d.ts\nscript-tag.1.js\nstream.1.js\nstrict.1.js\ntheme-colors.1.js\ntheme-toggle.1.js\ntheme-tokens.1.js\nupdate.1.js\nzoom.1.js\n  --sequence.shuffle                                         Run files and tests in a random order. Enabling this option will impact Vitest's cache and have a performance impact. May be useful to find tests that accidentally depend on another run previously (default: false). Use '--help --sequence.shuffle' for more info. \n  --cache                                                    Store the results of test runs to run failed and longer test files first (default: true) \n  --fsModuleCache                                            Cache transformed modules on the file system and reuse them between reruns (default: true) \n  --fsModuleCachePath <path>                                 Directory where the fsModuleCache is stored (default: node_modules/.vitest-cache) \n  --configLoader <loader>                                    Use bundle to bundle the config with esbuild or runner (experimental) to process it on the fly. This is only available in vite version 6.1.0 and above. (default: bundle) \n  --clearCache                                               Delete all Vitest caches, including the fsModuleCache, without running any tests. This will reduce the performance in the subsequent test run. \n  --experimental.nodeLoader                                  Controls whether Vitest will use Node.js Loader API to process in-source or mocked files. This has no effect if viteModuleRunner is enabled. Disabling this can increase performance. (default: true) \n  --experimental.recordDependencies                          Record the modules loaded by every test file in the cache and use the records with --changed and --related instead of the static module graph. A test file without a record always runs. (default: false) \n  --experimental.diagnostics.transform                       Print a hint when transforming modules dominates the run and fsModuleCache would persist the results across runs. (default: true) \ngetExePath.d.ts\ngetExePath.js\ntsc.js\nversion.cjs\nversion.d.cts\n244:apps/docs/             documentation site; runnable examples are test fixtures\n350:- `@axylo/react` finished; script-tag builds; documentation site; migration notes from Chart.js and Recharts.\n356:- Every runnable docs example compiled and rendered from the packed distribution (DX10).\n357:- The agent rehearsal (DX12), recorded as rehearsal.\n381:| Packed distribution | Clean install fixtures | What users actually get (DX1, DX7, DX8, DX10). |\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'for f in apps/docs/examples/*.{ts,tsx}; do echo \"$f\"; cat \"$f\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'for f in apps/docs/examples/*.{ts,tsx}; do echo \"$f\"; cat \"$f\"; done'","aggregated_output":"apps/docs/examples/_phase1-data.ts\n// The Phase 1 datasets (research/harness/src/data.js), in TypeScript, for the migration examples:\n// the Chart.js and Recharts configurations on those pages received exactly these values.\nexport function rng(seed: number): () => number {\n  let s = seed >>> 0;\n  return () => {\n    s = (s + 0x6D2B79F5) | 0;\n    let t = Math.imul(s ^ (s >>> 15), 1 | s);\n    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n  };\n}\n\nconst DAY = 864e5;\nconst START = Date.UTC(2026, 0, 1);\n\n/** 3 series × 120 daily points at UTC midnights; \"Referral\" has a 7-day outage (nulls). */\nexport const trend = (() => {\n  const r = rng(7);\n  const n = 120;\n  const t = Array.from({ length: n }, (_, i) => START + i * DAY);\n  const mk = (base: number, growth: number, noise: number, season: number): (number | null)[] =>\n    t.map((_, i) => Math.round(base + growth * i + season * Math.sin((i / 7) * 2 * Math.PI) + (r() - 0.5) * noise));\n  const series = [\n    { name: 'Direct', values: mk(31000, 120, 4000, 3000) },\n    { name: 'Organic search', values: mk(18000, 60, 3000, 2500) },\n    { name: 'Referral', values: mk(4200, -8, 1200, 400) },\n  ];\n  for (let i = 60; i < 67; i++) series[2]!.values[i] = null;\n  return { title: 'Daily sessions by channel', yTitle: 'Sessions', t, series };\n})();\n\n/** One series, values 82–97, one long label. */\nexport const bars = {\n  title: 'Customer satisfaction by team', yTitle: 'Satisfied (%)', name: 'Satisfied (%)',\n  categories: ['Billing', 'Customer Success & Onboarding', 'Platform', 'Mobile', 'Data', 'Security', 'Sales Eng.'],\n  values: [94, 88, 97, 82, 91, 85, 90],\n};\n\n/** A 600-point window, one point per minute, and a source of further points. */\nexport function stream(): { title: string; t: number[]; y: number[]; next: () => [number, number] } {\n  const r = rng(1);\n  const t: number[] = [];\n  const y: number[] = [];\n  let v = 100;\n  for (let i = 0; i < 600; i++) {\n    v += (r() - 0.5) * 2;\n    t.push(START + i * 60000);\n    y.push(Math.round(v * 100) / 100);\n  }\n  const r2 = rng(2);\n  let last = y[y.length - 1]!;\n  let i = t.length;\n  return {\n    title: 'Streaming window', t, y,\n    next: () => { last += (r2() - 0.5) * 2; return [START + i++ * 60000, Math.round(last * 100) / 100]; },\n  };\n}\napps/docs/examples/area-incomplete.ts\nimport { area } from 'axylo';\n\n// Week 3 has no value for \"Mobile\". The stack there is drawn with that part at zero height, and\n// the tooltip, table and announcements mark the total for that week as incomplete.\nconst rows = [\n  { week: '2026-03-02', web: 410, mobile: 220 },\n  { week: '2026-03-09', web: 430, mobile: 240 },\n  { week: '2026-03-16', web: 455, mobile: null },\n  { week: '2026-03-23', web: 470, mobile: 260 },\n  { week: '2026-03-30', web: 480, mobile: 275 },\n];\n\narea('#chart', {\n  title: 'Weekly orders by platform',\n  data: rows,\n  x: 'week',\n  y: [{ field: 'web', label: 'Web' }, { field: 'mobile', label: 'Mobile' }],\n  stacked: true,\n});\napps/docs/examples/area-stacked.ts\nimport { area } from 'axylo';\n\nconst channels = ['Direct', 'Organic search', 'Referral'];\nconst rows = Array.from({ length: 12 }, (_, m) => channels.map((channel, c) => ({\n  month: `2025-${String(m + 1).padStart(2, '0')}`,\n  channel,\n  sessions: Math.round([42000, 27000, 6000][c]! * (1 + 0.03 * m) + 3000 * Math.cos(m / 2 + c)),\n}))).flat();\n\n// Stacked: each band sits on the ones before it; the tooltip adds the stack total.\narea('#chart', {\n  title: 'Monthly sessions by channel',\n  data: rows,\n  x: 'month',\n  y: { field: 'sessions', label: 'Sessions' },\n  series: 'channel',\n  stacked: true,\n});\napps/docs/examples/bar-horizontal.ts\nimport { bar } from 'axylo';\n\n// Long category names read best on horizontal bars. Two fields give grouped bars.\n// \"Partner integrations\" has no value for 2026: a \"no data\" mark, distinct from a zero bar.\nconst rows = [\n  { area: 'Account settings and profile', y2025: 42, y2026: 51 },\n  { area: 'Billing, invoices and refunds', y2025: 77, y2026: 64 },\n  { area: 'Partner integrations', y2025: 18, y2026: null },\n  { area: 'Data export and reporting', y2025: 35, y2026: 39 },\n  { area: 'Mobile app', y2025: 0, y2026: 12 },\n];\n\nbar('#chart', {\n  title: 'Support tickets by product area',\n  data: rows,\n  x: 'area',\n  y: [{ field: 'y2025', label: '2025' }, { field: 'y2026', label: '2026' }],\n  horizontal: true,\n});\napps/docs/examples/bar-stacked.ts\nimport { bar } from 'axylo';\n\n// Stacked bars with both signs: positive parts stack up from zero, negative parts down from it,\n// and the value axis covers both totals.\nconst rows = [\n  { quarter: '2025 Q1', new: 120, expansion: 45, churn: -60 },\n  { quarter: '2025 Q2', new: 135, expansion: 52, churn: -48 },\n  { quarter: '2025 Q3', new: 110, expansion: 61, churn: -75 },\n  { quarter: '2025 Q4', new: 150, expansion: 58, churn: -52 },\n];\n\nbar('#chart', {\n  title: 'Net revenue change by quarter',\n  data: rows,\n  x: { field: 'quarter', ordered: true },\n  y: [\n    { field: 'new', label: 'New', unit: 'k USD' },\n    { field: 'expansion', label: 'Expansion', unit: 'k USD' },\n    { field: 'churn', label: 'Churn', unit: 'k USD' },\n  ],\n  layout: 'stacked',\n});\napps/docs/examples/bar-target.ts\nimport { bar } from 'axylo';\n\n// The Phase 1 \"bars\" task: values between 82 and 97, one long label, and a target line.\nconst rows = [\n  { team: 'Billing', satisfied: 94 },\n  { team: 'Customer Success & Onboarding', satisfied: 88 },\n  { team: 'Platform', satisfied: 97 },\n  { team: 'Mobile', satisfied: 82 },\n  { team: 'Data', satisfied: 91 },\n  { team: 'Security', satisfied: 85 },\n  { team: 'Sales Eng.', satisfied: 90 },\n];\n\n// The value axis starts at zero, as bars must. Declared `percent`, it ends at 100.\nbar('#chart', {\n  title: 'Customer satisfaction by team',\n  data: rows,\n  x: 'team',\n  y: { field: 'satisfied', label: 'Satisfied', scale: 'percent' },\n  reference: [{ y: 90, label: 'Target' }],\n});\napps/docs/examples/data-columns.ts\nimport { line } from 'axylo';\n\n// Typed columns: one array per field, all the same length. Axylo borrows these arrays: it reads\n// them where they are and does not copy them, so do not change them in place afterwards.\nconst columns = {\n  day: ['2026-03-02', '2026-03-03', '2026-03-04', '2026-03-05'],\n  direct: new Float64Array([3120, 3380, 3290, 3510]),\n  referral: new Float64Array([410, 455, 390, 520]),\n};\n\nline('#chart', {\n  title: 'Sessions by channel',\n  data: { columns },\n  x: 'day',\n  y: [{ field: 'direct', label: 'Direct' }, { field: 'referral', label: 'Referral' }],\n});\napps/docs/examples/data-long.ts\nimport { line } from 'axylo';\n\n// Long rows: one row per x and series. `series` names the field that says which series a row is.\nconst rows = [\n  { day: '2026-03-02', channel: 'Direct', sessions: 3120 },\n  { day: '2026-03-02', channel: 'Referral', sessions: 410 },\n  { day: '2026-03-03', channel: 'Direct', sessions: 3380 },\n  { day: '2026-03-03', channel: 'Referral', sessions: 455 },\n  { day: '2026-03-04', channel: 'Direct', sessions: 3290 },\n  { day: '2026-03-04', channel: 'Referral', sessions: 390 },\n  { day: '2026-03-05', channel: 'Direct', sessions: 3510 },\n  { day: '2026-03-05', channel: 'Referral', sessions: 520 },\n];\n\nline('#chart', {\n  title: 'Sessions by channel',\n  data: rows,\n  x: 'day',\n  y: 'sessions',\n  series: 'channel',\n});\napps/docs/examples/data-wide.ts\nimport { line } from 'axylo';\n\n// Wide rows: one row per x, one field per series. `y` lists the fields; there is no `series`.\nconst rows = [\n  { day: '2026-03-02', direct: 3120, referral: 410 },\n  { day: '2026-03-03', direct: 3380, referral: 455 },\n  { day: '2026-03-04', direct: 3290, referral: 390 },\n  { day: '2026-03-05', direct: 3510, referral: 520 },\n];\n\nline('#chart', {\n  title: 'Sessions by channel',\n  data: rows,\n  x: 'day',\n  // A field object gives a series its display name.\n  y: [{ field: 'direct', label: 'Direct' }, { field: 'referral', label: 'Referral' }],\n});\napps/docs/examples/dates.ts\nimport { line } from 'axylo';\n\n// Raises AX111 on purpose: the first chart is given instants where calendar dates were meant.\nconst values = [120, 135, 128, 150, 162];\n\n// UTC midnights, as `new Date('2026-02-24').toISOString()` or many APIs produce them. These are\n// instants: shown in the viewer's time zone, and west of UTC each one falls on the evening before.\nconst instants = values.map((sessions, i) => ({ day: `2026-02-${24 + i}T00:00:00Z`, sessions }));\nline('#instants', { title: 'Sent as instants', data: instants, x: 'day', y: 'sessions' });\n\n// The same days as calendar dates: read the same in every time zone.\nconst dates = values.map((sessions, i) => ({ day: `2026-02-${24 + i}`, sessions }));\nline('#dates', { title: 'Sent as dates', data: dates, x: 'day', y: 'sessions' });\napps/docs/examples/donut-basic.ts\nimport { donut } from 'axylo';\n\n// The Phase 1 \"parts\" task. Slices keep this order, start at 12 o'clock and run clockwise; the\n// legend shows each value and its percentage as text.\nconst rows = [\n  { browser: 'Chrome', share: 46.2 },\n  { browser: 'Safari', share: 27.5 },\n  { browser: 'Edge', share: 14.1 },\n  { browser: 'Firefox', share: 8.9 },\n  { browser: 'Samsung Internet', share: 2.1 },\n  { browser: 'Other', share: 1.2 },\n];\n\ndonut('#chart', {\n  title: 'Sessions by browser',\n  data: rows,\n  label: 'browser',\n  value: { field: 'share', label: 'Share', scale: 'percent' },\n});\napps/docs/examples/donut-many.ts\nimport { donut } from 'axylo';\n\n// Raises AX121 on purpose: eleven countries. The seven largest are drawn, the rest are grouped as\n// \"Other (n)\", and the table still lists every country. Iceland has zero (listed, no arc);\n// Malta has no value (listed as \"No data\").\nconst rows = [\n  { country: 'United States', orders: 4210 }, { country: 'Germany', orders: 1830 },\n  { country: 'France', orders: 1290 }, { country: 'Japan', orders: 1120 },\n  { country: 'Brazil', orders: 760 }, { country: 'India', orders: 655 },\n  { country: 'Canada', orders: 610 }, { country: 'Spain', orders: 340 },\n  { country: 'Norway', orders: 120 }, { country: 'Iceland', orders: 0 },\n  { country: 'Malta', orders: null },\n];\n\ndonut('#chart', { title: 'Orders by country', data: rows, label: 'country', value: 'orders' });\napps/docs/examples/first-chart.ts\nimport { line } from 'axylo';\n\n// Rows as an API returns them: one row per day and channel.\nconst channels = ['Direct', 'Organic search', 'Referral'];\nconst rows = Array.from({ length: 30 }, (_, i) => channels.map((channel, c) => ({\n  day: `2026-03-${String(i + 1).padStart(2, '0')}`,\n  channel,\n  sessions: Math.round([31000, 18000, 4200][c]! * (1 + 0.004 * i) + 2500 * Math.sin(i / 1.1 + c)),\n}))).flat();\n\nline('#chart', {\n  title: 'Daily sessions by channel',\n  data: rows,\n  x: 'day',\n  y: 'sessions',\n  series: 'channel',\n});\napps/docs/examples/line-dirty.ts\nimport { line } from 'axylo';\n\n// Raises AX102, AX103 and AX106 on purpose: the values a real application sends by mistake.\nconst days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];\nconst values: unknown[] = [10, 20, null, NaN, '40', undefined, 70];\nconst rows = days.map((day, i) => ({ day, value: values[i] as number | null }));\n\n// Wed (null) is a gap, silently. Thu (NaN), Fri (a string) and Sat (no value) are gaps too, and\n// the chart tells the reader that three values are not shown. Sun, alone between gaps, is a point.\nline('#chart', { title: 'Dirty input', data: rows, x: 'day', y: 'value' });\napps/docs/examples/line-time.ts\nimport { line } from 'axylo';\n\n// Instants: epoch milliseconds, one per 10 minutes over a day, declared `type: 'time'`.\nconst start = Date.UTC(2026, 2, 10, 0, 0);\nconst services = ['checkout', 'search'];\nconst rows = Array.from({ length: 144 }, (_, i) => services.map((service, s) => ({\n  at: start + i * 600_000,\n  service,\n  p95: Math.round((s ? 180 : 320) + 60 * Math.sin(i / 12 + s) + (i >= 84 && i < 96 ? 400 : 0)),\n}))).flat();\n\nline('#chart', {\n  title: 'Response time, 10 March',\n  subtitle: 'p95 per 10 minutes',\n  data: rows,\n  // Shown in UTC for every viewer; the tooltip heading and the summary name the zone.\n  x: { field: 'at', type: 'time', timeZone: 'UTC' },\n  y: { field: 'p95', label: 'Response time', unit: 'ms' },\n  series: 'service',\n  reference: [\n    { y: 500, label: 'Objective' },\n    { x: [start + 84 * 600_000, start + 96 * 600_000], label: 'Incident' },\n  ],\n});\napps/docs/examples/migrate-stream.ts\nimport { line } from 'axylo';\nimport { stream } from './_phase1-data';\n\nconst d = stream();\nconst rows = d.t.map((t, i) => ({ t, value: d.y[i]! }));\n\nconst chart = line('#chart', {\n  title: d.title,\n  data: rows,\n  x: { field: 't', type: 'time', timeZone: 'UTC' },\n  y: 'value',\n});\n\n// One call per new point; the window keeps the latest 600 x values.\nsetInterval(() => {\n  const [t, value] = d.next();\n  chart.append([{ t, value }], { keep: 600 });\n}, 250);\napps/docs/examples/migrate-target.ts\nimport { bar } from 'axylo';\nimport { bars as d } from './_phase1-data';\n\nconst rows = d.categories.map((team, i) => ({ team, satisfied: d.values[i]! }));\n\nbar('#chart', {\n  title: d.title,\n  data: rows,\n  x: 'team',\n  y: { field: 'satisfied', label: 'Satisfied', scale: 'percent' },\n  reference: [{ y: 90, label: 'Target' }],\n});\napps/docs/examples/migrate-trend.ts\nimport { line } from 'axylo';\nimport { trend as d } from './_phase1-data';\n\n// Long rows from the fixture's columns. The fixture's x values are epoch milliseconds of UTC\n// midnights: `type: 'date'` reads each one as its calendar day, the same in every time zone.\nconst rows = d.series.flatMap(s => s.values.map((sessions, i) => ({ day: d.t[i]!, channel: s.name, sessions })));\n\nline('#chart', {\n  title: d.title,\n  data: rows,\n  x: { field: 'day', type: 'date' },\n  y: { field: 'sessions', label: d.yTitle },\n  series: 'channel',\n});\napps/docs/examples/missing.ts\nimport { line, bar } from 'axylo';\n\n// Raises AX105 on purpose: 2026-03-04 has no row in either chart.\nconst rows = [\n  { day: '2026-03-01', signups: 12 },\n  { day: '2026-03-02', signups: 0 },     // a real zero: drawn at zero\n  { day: '2026-03-03', signups: null },  // null: no data, drawn as a gap\n  { day: '2026-03-05', signups: 9 },     // 2026-03-04 is absent: also a gap\n  { day: '2026-03-06', signups: 14 },\n  { day: '2026-03-07', signups: 11 },\n];\n\nline('#gaps', { title: 'Missing means no data', data: rows, x: 'day', y: 'signups' });\n\n// For counts, a day without a row had no events: `missing: 'zero'` draws null and absent as zero.\nbar('#zeros', {\n  title: 'Missing means zero',\n  data: rows,\n  x: 'day',\n  y: { field: 'signups', missing: 'zero' },\n});\napps/docs/examples/numeric-strings.ts\nimport { bar } from 'axylo';\n\n// Postgres returns `count(*)` as a string (bigint). Declaring the parse says that is expected.\nconst rows = [\n  { day: '2026-03-02', orders: '182' },\n  { day: '2026-03-03', orders: '205' },\n  { day: '2026-03-04', orders: '199' },\n  { day: '2026-03-05', orders: '231' },\n];\n\nbar('#chart', {\n  title: 'Orders per day',\n  data: rows,\n  x: 'day',\n  y: { field: 'orders', parse: 'number', label: 'Orders' },\n});\napps/docs/examples/scatter-basic.ts\nimport { scatter } from 'axylo';\n\n// Two measures per request, coloured by region. Hover picks the nearest point within 24 px.\nconst regions = ['eu-west', 'us-east', 'ap-south'];\nconst rows = Array.from({ length: 150 }, (_, i) => {\n  const region = regions[i % 3]!;\n  const size = 5 + ((i * 37) % 95);\n  const ms = Math.round(40 + size * (1.2 + (i % 3) * 0.5) + 30 * Math.sin(i * 1.7));\n  return { size, ms, region };\n});\n\nscatter('#chart', {\n  title: 'Latency by payload size',\n  data: rows,\n  x: { field: 'size', label: 'Payload', unit: 'KB' },\n  y: { field: 'ms', label: 'Latency', unit: 'ms' },\n  series: 'region',\n});\napps/docs/examples/scatter-ties.ts\nimport { scatter } from 'axylo';\n\n// Ratings are whole numbers, so many reviews share both coordinates. On a scatter chart that is\n// ordinary data: the tooltip lists coincident points (up to eight), and the keyboard visits each.\nconst rows = [\n  [4, 5], [4, 5], [4, 5], [5, 5], [3, 4], [4, 4], [4, 4], [2, 3],\n  [5, 4], [5, 4], [1, 2], [3, 3], [3, 3], [3, 3], [2, 2], [5, 5],\n].map(([ease, overall]) => ({ ease: ease!, overall: overall! }));\n\nscatter('#chart', {\n  title: 'Ease of use against overall rating',\n  data: rows,\n  x: { field: 'ease', label: 'Ease of use' },\n  y: { field: 'overall', label: 'Overall rating' },\n});\napps/docs/examples/states.ts\nimport { line } from 'axylo';\n\n// Draws no marks on purpose: each chart shows one of the built-in states.\nconst fields = { x: 'day', y: 'orders' } as const;\ntype Order = { day: string; orders: number };\nconst none: Order[] = [];\n\n// While the query runs.\nline('#loading', { title: 'Orders', data: none, ...fields, state: 'loading' });\n\n// The query returned no rows: no option needed.\nline('#empty', { title: 'Orders this week', data: none, ...fields });\n\n// Your own wording for an empty result or a failure.\nline('#custom', { title: 'Refunds', data: none, ...fields, state: { empty: 'No refunds yet.' } });\nline('#failed', { title: 'Orders', data: none, ...fields, state: { error: 'The query timed out.' } });\napps/docs/examples/units.ts\nimport { line } from 'axylo';\n\nconst rows = [\n  { month: '2026-01', conversion: 0.031, p95: 412 },\n  { month: '2026-02', conversion: 0.034, p95: 388 },\n  { month: '2026-03', conversion: 0.029, p95: 455 },\n  { month: '2026-04', conversion: 0.038, p95: 1210 },\n];\n\n// A ratio (0–1) is declared, never guessed from the field name, and is written as a percentage.\n// Its axis ends at the first tick above the data, not at 100%, because the data stays far below\n// half of full scale.\nline('#ratio', {\n  title: 'Checkout conversion',\n  data: rows,\n  x: 'month',\n  y: { field: 'conversion', label: 'Conversion', scale: 'ratio' },\n});\n\n// A unit follows each value in tooltip, table and announcements, and titles the axis.\n// Ticks and readouts are formatted apart: ticks may be compact, readouts are exact.\nline('#latency', {\n  title: 'Checkout latency',\n  data: rows,\n  x: 'month',\n  y: { field: 'p95', label: 'Latency (p95)', unit: 'ms', tickFormat: { notation: 'compact' } },\n});\napps/docs/examples/unsorted.ts\nimport { line } from 'axylo';\n\n// Rows in any order: a line is drawn in x order. Nothing is reported, because nothing is wrong.\nconst rows = [\n  { week: '2026-03-16', tickets: 42 },\n  { week: '2026-03-02', tickets: 51 },\n  { week: '2026-03-23', tickets: 38 },\n  { week: '2026-03-09', tickets: 47 },\n];\n\nline('#chart', { title: 'Open tickets per week', data: rows, x: 'week', y: 'tickets' });\napps/docs/examples/react-line.tsx\nimport { StrictMode, useMemo, useState } from 'react';\nimport { createRoot } from 'react-dom/client';\nimport { Line } from '@axylo/react';\nimport type { Point } from 'axylo';\n\ninterface Row { day: string; channel: string; sessions: number }\n\nfunction makeRows(): Row[] {\n  return Array.from({ length: 14 }, (_, i) => ['Direct', 'Referral'].map((channel, c) => ({\n    day: `2026-03-${String(i + 1).padStart(2, '0')}`,\n    channel,\n    sessions: Math.round((c ? 450 : 3100) + (c ? 40 : 300) * Math.sin(i / 2 + c)),\n  }))).flat();\n}\n\n// Events give dates as epoch milliseconds; a calendar date is its UTC midnight.\nconst day = (value: string | number | Date) => new Date(value).toISOString().slice(0, 10);\n\nfunction SessionsCard() {\n  // Memoised: `data` is compared by identity, so a new array on every render would be read again.\n  const rows = useMemo(makeRows, []);\n  const [hovered, setHovered] = useState<Point<Row> | null>(null);\n  return (\n    <section>\n      <Line\n        title=\"Daily sessions by channel\"\n        data={rows}\n        x=\"day\"\n        y={{ field: 'sessions', label: 'Sessions' }}\n        series=\"channel\"\n        onHover={setHovered}\n      />\n      <p>{hovered ? `${hovered.series} on ${day(hovered.x)}: ${hovered.y ?? 'no data'}` : 'Point at the chart.'}</p>\n    </section>\n  );\n}\n\ncreateRoot(document.getElementById('root')!).render(<StrictMode><SessionsCard /></StrictMode>);\napps/docs/examples/react-stream.tsx\nimport { useEffect, useRef, useState } from 'react';\nimport { createRoot } from 'react-dom/client';\nimport { Line, type ChartRef } from '@axylo/react';\nimport type { LineOptions } from 'axylo';\n\ninterface Sample { at: number; rps: number }\n\nlet at = Date.UTC(2026, 2, 10, 9, 0, 0);\nlet step = 0;\nconst next = (): Sample => {\n  at += 1000;\n  step += 1;\n  return { at, rps: Math.round(240 + 40 * Math.sin(step / 6)) };\n};\n\nfunction Live() {\n  // The first rows are state, created once. A new `data` prop would replace what was appended.\n  const [initial] = useState(() => Array.from({ length: 60 }, next));\n  const ref = useRef<ChartRef<Sample, LineOptions<Sample>>>(null);\n\n  useEffect(() => {\n    // The ref reaches the chart's handle, for the methods props cannot express: append, zoom.\n    const timer = setInterval(() => ref.current?.chart?.append([next()], { keep: 60 }), 1000);\n    return () => clearInterval(timer);\n  }, []);\n\n  return (\n    <Line\n      ref={ref}\n      title=\"Requests per second\"\n      data={initial}\n      x={{ field: 'at', type: 'time', timeZone: 'UTC' }}\n      y={{ field: 'rps', label: 'Requests', unit: 'req/s' }}\n    />\n  );\n}\n\ncreateRoot(document.getElementById('root')!).render(<Live />);\napps/docs/examples/recharts-stream.tsx\nimport { useEffect, useRef, useState } from 'react';\nimport { createRoot } from 'react-dom/client';\nimport { Line, type ChartRef } from '@axylo/react';\nimport type { LineOptions } from 'axylo';\nimport { stream } from './_phase1-data';\n\ninterface Sample { t: number; value: number }\nconst d = stream();\n\nfunction Live() {\n  // Re-rendering with a new array would make the chart read every row again; appending through\n  // the ref adds only the new one.\n  const [rows] = useState<Sample[]>(() => d.t.map((t, i) => ({ t, value: d.y[i]! })));\n  const ref = useRef<ChartRef<Sample, LineOptions<Sample>>>(null);\n  useEffect(() => {\n    const timer = setInterval(() => {\n      const [t, value] = d.next();\n      ref.current?.chart?.append([{ t, value }], { keep: 600 });\n    }, 250);\n    return () => clearInterval(timer);\n  }, []);\n  return <Line ref={ref} title={d.title} data={rows} x={{ field: 't', type: 'time', timeZone: 'UTC' }} y=\"value\" />;\n}\n\ncreateRoot(document.getElementById('root')!).render(<Live />);\napps/docs/examples/recharts-target.tsx\nimport { createRoot } from 'react-dom/client';\nimport { Bar } from '@axylo/react';\nimport { bars as d } from './_phase1-data';\n\nconst rows = d.categories.map((team, i) => ({ team, satisfied: d.values[i]! }));\n\nfunction Satisfaction() {\n  return (\n    <Bar\n      title={d.title}\n      data={rows}\n      x=\"team\"\n      y={{ field: 'satisfied', label: 'Satisfied', scale: 'percent' }}\n      reference={[{ y: 90, label: 'Target' }]}\n    />\n  );\n}\n\ncreateRoot(document.getElementById('root')!).render(<Satisfaction />);\napps/docs/examples/recharts-trend.tsx\nimport { createRoot } from 'react-dom/client';\nimport { Line } from '@axylo/react';\nimport { trend as d } from './_phase1-data';\n\n// Built once, outside the component, so every render passes the same array.\nconst rows = d.series.flatMap(s => s.values.map((sessions, i) => ({ day: d.t[i]!, channel: s.name, sessions })));\n\nfunction Trend() {\n  return (\n    <Line\n      title={d.title}\n      data={rows}\n      x={{ field: 'day', type: 'date' }}\n      y={{ field: 'sessions', label: d.yTitle }}\n      series=\"channel\"\n    />\n  );\n}\n\ncreateRoot(document.getElementById('root')!).render(<Trend />);\n","exit_code":0,"status":"completed"}}
