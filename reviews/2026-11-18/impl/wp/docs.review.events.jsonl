{"type":"item.completed","item":{"id":"item_107","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,95p' packages/axylo/src/theme/css.ts | cut -c1-130; sed -n '1,85p' packages/axylo/src/diagnostics/registry.ts; rg -n 'error|double|throw|AX199' packages/axylo/src/core/delivery.ts packages/axylo/src/core/controller.ts packages/axylo/src/data/validate.ts | tail -29; ls packages/axylo/src/reader; cat apps/docs/examples/dates.ts | head -38; head -60 docs/decisions/0002-mark-renderer.md | tail -14\"","aggregated_output":"/**\n * The library's default stylesheet as a string. `ensureStyles` adopts it as a constructable stylesheet; the\n * build writes the same string to dist/axylo.css for pages that prefer to load it themselves.\n *\n * Everything sits in the `axylo` cascade layer so that any unlayered rule of the page wins over a default\n * without a specificity contest, whichever order the sheets arrive in.\n *\n * Token scheme: the sheet sets only private defaults (`--axylo-default-axis`, `--axylo-default-series-1`, …)\n * on `.axylo`. The public names (`--axylo-axis`, `--axylo-series-1`, `--axylo-background`, `--axylo-text`,\n * `--axylo-font-family`, …) are never set outside forced colors, so an author may set them anywhere,\n * including `:root`, and inheritance carries them in. Every use reads `var(--axylo-x, var(--axylo-default-x))`.\n *\n * Things this sheet must never do, because scheme detection (spec L4) reads them from the chart root: set\n * `color-scheme` or `color` on `.axylo`, or set `--axylo-background` outside forced colors.\n *\n * Component selectors are scoped beneath `.axylo`, so a page's own `.axylo-text` is left alone.\n */\nimport { DARK, LIGHT, type SchemeColors } from './palette';\n\n/** Each default as `light-dark(light, dark)`: the browser picks by the chart's used colour scheme. */\nfunction following(light: SchemeColors, dark: SchemeColors): string {\n  const pair = (a: string, b: string) => `light-dark(${a}, ${b})`;\n  const series = light.series.map((v, i) => `    --axylo-default-series-${i + 1}: ${pair(v, dark.series[i]!)};`).join('\\n');\n  return `${series}\n    --axylo-default-background: ${pair(light.background, dark.background)};\n    --axylo-default-axis: ${pair(light.axis, dark.axis)};\n    --axylo-default-grid: ${pair(light.grid, dark.grid)};\n    --axylo-default-muted: ${pair(light.muted, dark.muted)};\n    --axylo-default-reference: ${pair(light.reference, dark.reference)};\n    --axylo-default-focus: ${pair(light.focus, dark.focus)};`;\n}\n\nfunction tokens(c: SchemeColors): string {\n  const series = c.series.map((v, i) => `    --axylo-default-series-${i + 1}: ${v};`).join('\\n');\n  return `${series}\n    --axylo-default-background: ${c.background};\n    --axylo-default-axis: ${c.axis};\n    --axylo-default-grid: ${c.grid};\n    --axylo-default-muted: ${c.muted};\n    --axylo-default-reference: ${c.reference};\n    --axylo-default-focus: ${c.focus};`;\n}\n\n// Forced colors: every paint becomes a system color. `!important` so an author's custom property, whether\n// inherited or set on the chart, cannot leak a brand color into a mode where the user chose the colors.\n// `--axylo-forced-series` switches off the author's pinned series colors (resolveTheme writes each as\n// `var(--axylo-forced-series, <author color>)` on the chart root), so they return when forced colors ends.\nconst forced = [\n  ...LIGHT.series.map((_, i) => `    --axylo-series-${i + 1}: CanvasText !important;`),\n  '    --axylo-forced-series: CanvasText !important;',\n  '    --axylo-background: Canvas !important;',\n  '    --axylo-default-background: Canvas !important;',\n  '    --axylo-text: CanvasText !important;',\n  '    --axylo-axis: CanvasText !important;',\n  '    --axylo-grid: GrayText !important;',\n  '    --axylo-muted: GrayText !important;',\n  '    --axylo-reference: CanvasText !important;',\n  '    --axylo-focus: Highlight !important;',\n].join('\\n');\n\nexport const AXYLO_CSS = `/* Axylo default stylesheet */\n@layer axylo {\n  /* Lets ensureStyles find this sheet; it checks the sheet's effect as well, not only this sentinel. */\n  :root { --axylo-stylesheet: loaded; }\n\n  /*\n   * tokens: private defaults that follow the chart's used colour scheme (spec L4). Where the page gives the\n   * chart a color-scheme (light dark, dark, light, only …), resolveTheme writes no scheme attribute and these\n   * apply: a prefers-color-scheme change switches every var(--axylo-default-…) in the same frame as the media\n   * query, with no script (the SVG marks reference them; the canvas renderer repaints when the change event\n   * arrives, one frame behind). light-dark() is supported by the current and previous major versions of the\n   * four browsers in spec 2.3.\n   */\n  .axylo {\n${following(LIGHT, DARK)}\n  }\n\n  /* tokens: one fixed set, where the chart resolved its scheme itself (color-scheme normal; --axylo-background) */\n  .axylo[data-axylo-scheme=\"light\"] {\n${tokens(LIGHT)}\n  }\n  .axylo[data-axylo-scheme=\"dark\"] {\n${tokens(DARK)}\n  }\n\n  @media (forced-colors: active) {\n    .axylo {\n${forced}\n    }\n  }\n\n  /* marks */\n  .axylo .axylo-svg, .axylo .axylo-canvas { position: absolute; left: 0; top: 0; display: block; pointer-events: none; }\n  .axylo .axylo-svg { overflow: hidden; }\n  .axylo .axylo-canvas > canvas { position: absolute; left: 0; top: 0; display: block; }\nimport type { DiagnosticEffect, DiagnosticInput, DiagnosticSink, View, XKind } from '../core/contracts';\nimport type { Diagnostic } from '../public';\n\nexport interface DiagnosticDetails {\n  readonly field?: string;\n  readonly rows?: readonly number[];\n  readonly count?: number;\n  readonly examples?: readonly string[];\n  readonly keys?: readonly string[];\n  readonly suggestion?: string;\n  readonly detail?: string;\n  readonly series?: readonly string[];\n  readonly sparseSeries?: readonly string[];\n  readonly zeroSeries?: readonly string[];\n  readonly outcome?: string;\n  readonly chartType?: View['kind'];\n  readonly xKind?: XKind;\n  readonly horizontal?: boolean;\n}\n\nconst quote = (name: string) => JSON.stringify(name);\nconst field = (d: DiagnosticDetails) => d.field === undefined ? 'The chart' : 'Field ' + quote(d.field);\nconst rows = (d: DiagnosticDetails) => d.rows?.length ? ' at ' + (d.rows.length === 1 ? 'row ' : 'rows ') + d.rows.join(', ') : '';\nconst samples = (d: DiagnosticDetails) => d.examples?.length ? ' (' + d.examples.join(', ') + ')' : '';\nconst count = (d: DiagnosticDetails, word: string, plural = word + 's') =>\n  (d.count ?? 1) + ' ' + ((d.count ?? 1) === 1 ? word : plural);\nconst suggestion = (d: DiagnosticDetails) => d.suggestion === undefined ? '' : ' Did you mean ' + quote(d.suggestion) + '?';\nconst series = (names?: readonly string[]) => names?.length ? ' in series ' + names.map(quote).join(', ') : '';\n\ntype Entry = { readonly level: Diagnostic['level']; readonly message: (details: DiagnosticDetails) => string };\n\nfunction entry<Level extends Diagnostic['level']>(\n  level: Level, message: Entry['message'], outcome: string | Entry['message'],\n): Entry & { readonly level: Level } {\n  return {\n    level,\n    message: details => message(details) + ' ' +\n      (details.outcome ?? (typeof outcome === 'string' ? outcome : outcome(details))),\n  };\n}\n\nexport const diagnosticRegistry = {\n  AX100: entry('error', d =>\n    field(d) + ' belongs to columns with different lengths' + samples(d) + '. Supply equally long columns.',\n  'The chart shows its error state.'),\n  AX101: entry('error', d =>\n    field(d) + ' is missing from the data. Available fields: ' +\n    (d.keys?.length ? d.keys.map(quote).join(', ') : '(none)') + '.' + suggestion(d) + ' Use an available field or add the field to the data.',\n  'The chart shows its error state.'),\n  AX102: entry('warning', d =>\n    (d.outcome === 'The affected row is not drawn.'\n      ? field(d) + ' is absent' + rows(d) + ', affecting ' + count(d, 'value')\n      : field(d) + ' is absent in ' + count(d, 'record') + rows(d)) +\n    '. Supply the field and send null if the value is known to be missing.',\n  'Shown as gaps.'),\n  AX103: entry('warning', d =>\n    field(d) + ' has ' + count(d, 'non-finite value') + rows(d) + samples(d) + '. Check the calculation that produced it or send null for no data.',\n  'Shown as gaps.'),\n  AX104: entry('hint', d =>\n    field(d) + ' has ' + count(d, 'decimal string') + rows(d) + '. Set parse: \\'number\\' to make conversion explicit.',\n  'The strings are parsed and drawn as numbers.'),\n  AX105: entry('hint', d =>\n    field(d) + ' is missing ' + count(d, 'expected step') + series(d.series) + samples(d) +\n    '. Supply observations for those positions or explicit nulls to mark gaps.',\n  d => {\n    const outcomes = [];\n    const regular = d.series?.some(name => !d.sparseSeries?.includes(name) && !d.zeroSeries?.includes(name));\n    if (regular || !d.sparseSeries?.length && d.zeroSeries === undefined) outcomes.push('Shown as gaps.');\n    if (d.zeroSeries !== undefined) {\n      outcomes.push(regular || d.sparseSeries?.length ? 'Absent steps' + series(d.zeroSeries) + ' are shown as zeros.' : 'Shown as zeros.');\n    }\n    if (d.sparseSeries?.length) {\n      outcomes.push('The data' + series(d.sparseSeries) + ' was too sparse to show its absent steps as gaps.');\n    }\n    return outcomes.join(' ');\n  }),\n  AX106: entry('warning', d =>\n    field(d) + ' has ' + count(d, 'value that cannot be plotted as a number', 'values that cannot be plotted as numbers') +\n    rows(d) + samples(d) + '. Convert values to numbers where the data is produced.',\n  'The affected values are not drawn.'),\n  AX107: entry('warning', d =>\n    field(d) + ' has ' + count(d, 'unusable value') + rows(d) + samples(d) + '. ' +\n    (d.detail ?? 'Supply an x value in the declared or inferred format for each row.'),\n  'The affected rows are not drawn.'),\n  AX108: entry('error', d =>\npackages/axylo/src/core/controller.ts:914:        const own = typeof s.error === 'string' && s.error !== '';\npackages/axylo/src/core/controller.ts:915:        return { kind: 'error', text: own ? s.error as string : m.error, message: own ? null : 'error' };\npackages/axylo/src/core/controller.ts:922:    if (stateDiagnostics(a).some(d => d.effect === 'chart-error')) return { kind: 'error', text: m.error, message: 'error' };\npackages/axylo/src/core/controller.ts:931:        return { kind: 'error', text, message: 'seriesNotDrawn' };\npackages/axylo/src/core/controller.ts:948:  /** AX199 (spec 3.5): Axylo itself failed. Given to onDiagnostic and printed, beside the error state. */\npackages/axylo/src/core/controller.ts:949:  function raiseInternal(error: unknown): void {\npackages/axylo/src/core/controller.ts:951:    internalError = error;\npackages/axylo/src/core/controller.ts:952:    if (first) delivery.internal(accepted?.name ?? host.id, error);\npackages/axylo/src/core/controller.ts:953:    setPresentationQuiet('internal', [createDiagnostic('AX199', 'chart-error', {}, 'presentation')]);\npackages/axylo/src/core/controller.ts:998:    } catch (error) {\npackages/axylo/src/core/controller.ts:999:      if (error !== ABORT) failSafe(a, error);\npackages/axylo/src/core/controller.ts:1024:      if (destroyed) throw ABORT;\npackages/axylo/src/core/controller.ts:1026:        if (accepted !== a) throw ABORT;\npackages/axylo/src/core/controller.ts:1130:    const noteShown = shown.kind === 'ready' || shown.kind === 'empty' || shown.kind === 'error';\npackages/axylo/src/core/controller.ts:1134:      // Loading and error are not empty (documentation findings 1 and 3): their description is the state, not\npackages/axylo/src/core/controller.ts:1160:      inspectable: (shown.kind === 'empty' || (shown.kind === 'error' && shown.message === 'seriesNotDrawn')) &&\npackages/axylo/src/core/controller.ts:1170:    if (!current(a)) throw ABORT;\npackages/axylo/src/core/controller.ts:1288:      if (destroyed) throw ABORT;\npackages/axylo/src/core/controller.ts:1310:    if (destroyed) throw ABORT;\npackages/axylo/src/core/controller.ts:1415:   * An exception in our own pipeline: a complete error revision. The interaction layer is cleared (no old\npackages/axylo/src/core/controller.ts:1416:   * lookup answers the pointer), every output the error state cleared is invalidated so recovery redraws\npackages/axylo/src/core/controller.ts:1419:  function failSafe(a: Accepted, error: unknown): void {\npackages/axylo/src/core/controller.ts:1420:    raiseInternal(error);\npackages/axylo/src/core/controller.ts:1423:    // Nothing on screen needs rows any more: the error revision has none.\npackages/axylo/src/core/controller.ts:1446:   * The error revision on every layer, each step on its own (one that throws does not stop the others):\npackages/axylo/src/core/controller.ts:1523:        } catch (error) {\npackages/axylo/src/core/controller.ts:1524:          host.console?.error('[axylo] event listener threw:', error);\npackages/axylo/src/core/controller.ts:1645:  } catch (error) {\npackages/axylo/src/core/controller.ts:1648:    throw error;\nindex.ts\ntable.ts\nx.ts\nimport { line } from 'axylo';\n\n// Raises AX111 on purpose: the first chart is given instants where calendar dates were meant.\nconst values = [120, 135, 128, 150, 162];\n\n// UTC midnights, as `new Date('2026-02-24').toISOString()` or many APIs produce them. These are\n// instants: shown in the viewer's time zone, and west of UTC each one falls on the evening before.\nconst instants = values.map((sessions, i) => ({ day: `2026-02-${24 + i}T00:00:00Z`, sessions }));\nline('#instants', { title: 'Sent as instants', data: instants, x: 'day', y: 'sessions' });\n\n// The same days as calendar dates: read the same in every time zone.\nconst dates = values.map((sessions, i) => ({ day: `2026-02-${24 + i}`, sessions }));\nline('#dates', { title: 'Sent as dates', data: dates, x: 'day', y: 'sessions' });\n## What this does not establish\n\n- **GPU rasterization was not measured.** Headless Chrome here does not use a GPU. The resize, pixel-ratio-2 and process-memory results need a headed, GPU-backed rerun before they transfer.\n- **Dense point marks were not measured.** A scatter chart with tens of thousands of markers is the case most likely to favour canvas.\n- **One browser, one machine, one session.** Firefox and Safari may order the two differently.\n- **Many series, pan and zoom, and the budget workloads P4, P7 and P8 were not measured**, and the million-point comparison has four pairs.\n- Both renderers are far from uPlot in the configurations measured (about 80 ms against 12 ms at 100,000 points; uPlot draws no tooltip or accessibility layer). Where that time goes is not established.\n\n## Consequences\n\n- The working default is SVG. The canvas renderer stays in the code behind the same internal switch, with the pixel-agreement tests between the two kept.\n- Before the choice is final: fix the harness defects the review found (renderer identity in the readback, noise bands on replay, failed runs excluded from speed verdicts, gap-aware admission, the frame window), declare the primary endpoints and thresholds in advance, then rerun on a quiet machine with scatter at 10,000, 50,000 and 200,000 points, ten series of 100,000 points, pan and zoom, and the byte cost of keeping both renderers. Removing canvas from the bundle needs that evidence too.\n- When a real GPU and a second browser are available: rerun the resize and million-point workloads headed. If canvas wins there by more than the shipping thresholds in the performance plan, flip the switch back.\n- The plan's sections 2.2 and 2.3 are read with SVG in the \"marks\" position: a theme change no longer needs a redraw, and device pixel ratio matters only to simplification.\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_108","type":"command_execution","command":"/bin/bash -lc \"cat docs/decisions/0004-tooltip-and-focused-text.md | sed -n '8,39p'; cat packages/axylo/src/core/focus.ts | sed -n '124,156p'; rg -n 'MAX_.*SER|patterns|32|repeat' packages/axylo/src/scene packages/axylo/src/theme docs/02-product-spec.md | head -19; cat apps/docs/examples/first-chart.ts | head -26; cat apps/docs/pages/bar.md | head -10; cat apps/docs/data/diagnostics.mjs | sed -n '169,177p;306,315p;319,326p'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_108","type":"command_execution","command":"/bin/bash -lc \"cat docs/decisions/0004-tooltip-and-focused-text.md | sed -n '8,39p'; cat packages/axylo/src/core/focus.ts | sed -n '124,156p'; rg -n 'MAX_.*SER|patterns|32|repeat' packages/axylo/src/scene packages/axylo/src/theme docs/02-product-spec.md | head -19; cat apps/docs/examples/first-chart.ts | head -26; cat apps/docs/pages/bar.md | head -10; cat apps/docs/data/diagnostics.mjs | sed -n '169,177p;306,315p;319,326p'\"","aggregated_output":"\n**Problem.** WCAG 1.4.13 requires content shown on hover to stay when the pointer moves onto it. Spec I1 requires the readout to name the datum at the pointer on every move, the tooltip not to cover the active mark, to stay inside the viewport, and to fall back to a fixed readout when it cannot fit. On a line chart the whole plot picks, so anything that takes pointer events inside the plot blocks picking.\n\n**Rules.**\n\n1. **Position depends on the datum only.** For the datum on show, the tooltip is placed against the bounding box of that datum's active marks (all series at that x for line, area and bar; the point for scatter; the slice for donut), enlarged by the focus ring's width. The pointer's own position never enters the computation, so the tooltip does not move while the datum is unchanged, and it cannot run away from an approaching pointer.\n2. **Candidates, in order:** above the box, below it, then to the right and to the left of it (for horizontal bars: right, left, above, below). Along the other axis it is centred on the box and shifted only as far as needed. A candidate is valid when the tooltip lies wholly inside the plot rectangle, inside the viewport and inside every clipping ancestor, and overlaps neither the box nor any control. The first valid candidate is used. For a donut the first candidate is the hole, when the tooltip fits inside it.\n3. **A hovered tooltip never takes pointer events.** It is `pointer-events: none`. The plot keeps receiving every move, so picking never stalls at any speed, and a click goes to the plot and selects the datum under the pointer. Moving the pointer onto the tooltip therefore cannot hide it: on line, area and bar the tooltip stays for as long as the pointer's position along the reading axis still picks the same datum, which a straight approach across the reading axis does; on scatter and donut, while the pointer is inside the tooltip's rectangle the datum is held (computed from coordinates in the plot's own move handler, not by letting the tooltip take the event).\n3b. **A rest holds the datum along the way to the tooltip.** Rule 3 is enough when the tooltip sits across the reading axis (above or below), because a straight approach does not change what is picked. It is not enough when the straight path from the datum to its tooltip crosses positions that pick something else: a tooltip beside a tall bar or stack, a donut's tooltip in the hole or outside the ring, a scatter point's tooltip. For those: once the pointer has rested on a datum for 250 ms (no move larger than 2 CSS px), that datum is held while the pointer stays inside the corridor between its resting position and the tooltip's rectangle (the convex hull of the point and the rectangle) and inside the rectangle itself. Leaving the corridor, or leaving the rectangle on any side but back into the corridor, resumes picking at once. A pointer that has not rested is never held, so a sweep across the plot never stalls, whatever its speed. Placements across the reading axis never use the corridor.\n4. **Rows are not controls while hovered.** A hovered tooltip is text. Clicking or tapping the plot pins the tooltip for that datum; a pinned tooltip takes pointer events, stays until Escape, a click elsewhere, or its datum leaves the displayed frame, and its rows are buttons of at least 24 × 24 CSS px (WCAG 2.5.8) that select a series. Keyboard focus shows the same tooltip by the same placement; it is never over the focus ring because the box includes the ring.\n5. **Readout mode is decided by layout, not by hover.** When the plot is narrower than 240 CSS px or shorter than 140 CSS px, the figure is in readout mode: a strip of two text lines is reserved under the plot in the layout, and the content that would be in the tooltip is written there as running text (\"x: series value; series value; +N more\"), wrapping to the two lines and ending in \"+N more\" when it does not fit. The strip is part of the figure's flow: it covers nothing and nothing covers it. In readout mode there is no floating tooltip. A pinned datum makes the strip's entries buttons of 24 px height.\n6. **When no candidate is valid outside readout mode** (a tooltip taller than the room around a tall stack, for example), rows are dropped from the end and counted in \"+N more\" until a candidate is valid; if none is with one row, the tooltip is placed inside the plot at the candidate that overlaps the box least. This is the only case in which the active mark may be partly covered, and the table still has every value.\n7. Escape dismisses a hovered or pinned tooltip without moving the pointer, until the pointer reaches a different datum.\n\nRejected: revision 1; an interactive hovered tooltip with a \"safe triangle\" (still ambiguous when the reading axis and the approach coincide); always using the readout (loses the association between the values and the mark on plots that have room).\n\nWhat \"can itself be hovered\" (spec I1) means under this decision, for the tests: the pointer can be moved straight from the datum onto the tooltip's rectangle, and the tooltip is still shown, for the same datum, when the pointer is inside it. It does not mean the tooltip is the hit-test target.\n\n## 2. The focused point's text changes only for a reason the reader would name\n\n**Problem.** The plot's keyboard proxy is a native range whose value text describes the focused point, ending with its position (\"Point 4 of 120\"). While data streams in, the count changes on every append, so the text of a focused control changes without the reader acting. Spec A7 forbids unrequested announcements; whether a given screen reader speaks such a change cannot be tested here.\n\n**Rule.** The range's bounds and numeric value are always kept true to the displayed frame, silently. Its value text is rewritten only when:\n\n1. the reader moves (a key, an assistive adjustment, a pointer or touch selection that takes focus),\n2. the focused datum's own values change (the same x and series now read differently),\n3. the focused datum leaves the frame (the text must then say where focus went), or\n4. the plot regains focus.\n\nAn append that only changes the count or the ordinal of an unchanged datum does not rewrite the text. The position in the text can therefore be out of date until the next of the four events; it is recomputed then.\n\nTo check with a screen reader when one is available (added to decision 0001's list): idle appends with the plot focused are silent; an eviction of the focused point is spoken once; an increment immediately after an append lands on the expected neighbour and reads the current count.\n): string | null {\n  const ordinal = lookup.ordinal(focus);\n  if (ordinal < 0) return null;\n  const position = positionText(messages, formatters, ordinal, lookup.count);\n  if (view.kind === 'donut') {\n    const datum = lookup.datum(focus);\n    if (!datum) return null;\n    const share = datum.percent === null || datum.percent === datum.value ? '' : ` (${datum.percent})`;\n    return fill(messages.pointAll, {\n      x: datum.seriesLabel, values: datum.value + share, position,\n    });\n  }\n  if (view.kind !== 'scatter' && mode === 'all' && focus.kind === 'aligned') {\n    // What the tooltip shows at this x, the stack total included, said once (spec I1, F10).\n    const model = lookup.tooltip({ kind: 'x', x: focus.x });\n    const shown = new Set(model.rows.map(r => r.seriesIndex));\n    const rows = model.rows.map(r => fill(messages.seriesValue, { series: r.seriesLabel, value: r.value }));\n    for (const ref of refsAt(view, focus.x)) {\n      if (ref.kind !== 'aligned') continue;\n      const index = view.frame.series.findIndex(s => s.key === ref.seriesKey);\n      if (shown.has(index)) continue;\n      const datum = lookup.datum(ref);\n      if (datum) rows.push(fill(messages.seriesValue, { series: datum.seriesLabel, value: datum.value }));\n    }\n    if (model.total !== null) rows.push(fill(messages.seriesValue, { series: messages.total, value: model.total }));\n    if (!rows.length) return null;\n    return fill(messages.pointAll, { x: formatters.x(focus.x), values: rows.join('; '), position });\n  }\n  return pointOf(lookup, focus, formatters, messages);\n}\n\n// ── overlay ─────────────────────────────────────────────────────────────────────────────────────────\n\ndocs/02-product-spec.md:102:| F9 | Up to eight series, no two share a color. Beyond eight, each series still has a unique combination of color and dash or marker (for bars: color and fill pattern, which gives 32 distinct combinations; beyond 32 bar series combinations repeat), and AX130 is raised. | Tests with 6, 8 and 12 series | R7 |\ndocs/02-product-spec.md:141:| A5 | Series are never distinguished by color alone, in any mode. Each line and area carries a shape marker at its last point and at sparse intervals, repeated in the legend and tooltip; under `prefers-contrast: more` or forced colors, lines also differ by dash. Adjacent filled marks (slices, stacked segments) are separated by at least 1 px of background. The default palette has eight colors, each at least 3:1 on the default light and dark backgrounds, with a minimum pairwise OKLab difference of 0.10 (provisional) under normal vision and simulated protanopia, deuteranopia and tritanopia. On any other background, Axylo measures the palette against the resolved background and raises AX141 below 3:1. | Palette script scoring the rendered marks of an eight-series chart in both schemes, repeats included; rendered-pixel checks of separators; a grayscale screenshot in which three crossing lines can be told apart by marker | R7, WCAG 1.4.1, 1.4.11 |\ndocs/02-product-spec.md:142:| A6 | Content reflows at 320 CSS px and 400% zoom without two-dimensional scrolling. User text-spacing overrides do not clip text. | Viewport and style-override tests in three engines | WCAG 1.4.10, 1.4.12 |\ndocs/02-product-spec.md:177:| AX132 | Hint | More bars than pixels along the category axis | Drawn; the message suggests aggregating |\ndocs/02-product-spec.md:208:| C3 | It fills its container at any size from 24×16 CSS px up; with no definite height it is 32 px tall. | Size tests |\ndocs/02-product-spec.md:297:| Which keyboard and screen-reader pattern for the plot? | Decide from the M1 spike: three candidate patterns on the `trend` chart, rehearsed on the five pairs. | M1 record, confirmed in M4. |\npackages/axylo/src/theme/css.ts:98:   * Dash patterns of the SVG renderer. Each dashed element carries its normal pattern inline and both\npackages/axylo/src/theme/css.ts:99:   * patterns as custom properties; this switch needs no redraw (spec A5).\npackages/axylo/src/theme/css.ts:162:  .axylo-compact .axylo-plot::before { aspect-ratio: auto; min-height: 0; max-height: none; height: 32px; }\npackages/axylo/src/theme/css.ts:180:    max-width: min(320px, 100%); padding: 4px 8px; border: 1px solid var(--axylo-axis, var(--axylo-default-axis)); border-radius: 4px;\npackages/axylo/src/theme/css.ts:216:  /* The swatch repeats the dash the marks use, normal or contrast (spec A5; review 2, finding 22). */\npackages/axylo/src/scene/lines.ts:22:  input: LineInput & Drawing, range: IndexRange, isolated: Uint32Array, compact: boolean,\npackages/axylo/src/scene/lines.ts:23:): Uint32Array {\npackages/axylo/src/scene/lines.ts:44:  const indexes = new Uint32Array(capacity);\npackages/axylo/src/scene/lines.ts:62:function pointMark(series: number, cue: SeriesCue, xy: Float32Array): PointMark {\npackages/axylo/src/scene/lines.ts:89:    const xy = new Float32Array(2 * (end - start));\npackages/axylo/src/scene/geometry.ts:11:  // Far outside an author domain, extrapolation can overflow the packed Float32 geometry.\npackages/axylo/src/scene/bars.ts:65:    const values = new Float32Array(valid * 4);\npackages/axylo/src/scene/bars.ts:66:    const absent = new Float32Array((end - start - valid) * 4);\nimport { line } from 'axylo';\n\n// Rows as an API returns them: one row per day and channel.\nconst channels = ['Direct', 'Organic search', 'Referral'];\nconst rows = Array.from({ length: 30 }, (_, i) => channels.map((channel, c) => ({\n  day: `2026-03-${String(i + 1).padStart(2, '0')}`,\n  channel,\n  sessions: Math.round([31000, 18000, 4200][c]! * (1 + 0.004 * i) + 2500 * Math.sin(i / 1.1 + c)),\n}))).flat();\n\nline('#chart', {\n  title: 'Daily sessions by channel',\n  data: rows,\n  x: 'day',\n  y: 'sessions',\n  series: 'channel',\n});\n# Bar charts\n\nAfter this page you know when to use a bar chart, how to group, stack and turn bars horizontal, and what Axylo does with long labels, missing bars and negative values.\n\n## When to use it\n\nBars compare categories: satisfaction by team, tickets by product area, orders per region. A bar's length is its value, so the value axis always starts at zero. Bars over a date axis compare counts per period (orders per day).\n\nUse a [line chart](line.md) to show a trend over many points, and a [donut](donut.md) only for the shares of one whole.\n\n  {\n    code: 'AX111', level: 'hint', title: 'Instants that look like calendar dates',\n    condition: 'Instants look like calendar dates: all at the same time of day, whole days apart.', drawn: 'As instants, with the time zone shown.',\n    see: 'The chart shows instants in the viewer\\'s time zone and names the zone. West of UTC, midnight UTC is the previous evening, so each daily value appears one day early. In development, the console suggests date strings.',\n    why: 'A daily metric is usually a calendar date. Sent as `2026-02-24T00:00:00Z` (or epoch milliseconds of a UTC midnight) it is an instant, which is a different thing: the same moment is a different day in different places.',\n    fix: 'Send `\\'2026-02-24\\'` (a calendar date), or keep the instants and declare `x: { field: \\'day\\', type: \\'date\\' }`, which reads each instant as its UTC calendar day. See [the three kinds of time](data.md#three-kinds-of-time).',\n    run: 'node',\n    input: `validate('line', {\n  title: 'Sessions',\n    code: 'AX140', level: 'warning', title: 'A chart without a name',\n    condition: 'No `title` and no `labelledBy`.', drawn: 'A generated name.',\n    see: 'The chart is drawn and named for assistive technology from its type and fields (\"Line chart of sessions by day\"). The console says it has no name. The same code is raised when `labelledBy` names an element that does not exist.',\n    why: 'A screen-reader user moving through a dashboard hears each chart\\'s name first. A generated name says what is plotted, not what it means.',\n    fix: 'Give a `title`, or, when the card around the chart already has a heading, its id: `labelledBy: \\'card-heading\\'`. A title can be hidden visually with `title: { text: \\'…\\', visible: false }`.',\n    run: 'node',\n    input: `validate('line', {\n  data: [{ day: '2026-01-01', sessions: 120 }, { day: '2026-01-02', sessions: 130 }],\n  x: 'day',\n  y: 'sessions',\n    code: 'AX141', level: 'warning', title: 'Series colours too close to the background',\n    condition: 'The palette is below 3:1 against the resolved background.', drawn: 'As themed.',\n    see: 'The chart is drawn with your colours. The console says that the palette is below 3:1 against the background behind the chart; the diagnostic\\'s `count` says how many series colours are.',\n    why: 'Marks need 3:1 against what is behind them to be seen (WCAG 1.4.11). Axylo measures the colours the browser actually resolved against the colour actually behind the chart, so a dark card on a light page is measured as dark.',\n    fix: 'Choose series colours (`--axylo-series-1` … or `colors`) with at least 3:1 against your background, or set `--axylo-background` to the colour your card really has.',\n    run: 'browser',\n    sample: { chart: 'Sessions', details: { count: 1 } },\n    input: `target.style.setProperty('--axylo-series-1', '#eeeeee');\n","exit_code":0,"status":"completed"}}
