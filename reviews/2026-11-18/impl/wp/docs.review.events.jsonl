{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'cat apps/docs/examples/tsconfig*.json tsconfig.base.json vitest.config.ts apps/docs/vitest.config.ts package.json\nls -d node_modules/*typescript* packages/*/dist apps/docs/.cache/* apps/docs/dist research/harness/node_modules/{chart.js,recharts} \ncat examples/first-chart/{npm.ts,script.html,react.tsx}\nnl -ba packages/axylo/src/public.ts'","aggregated_output":"{\n  \"extends\": \"./tsconfig.json\",\n  \"compilerOptions\": {\n    // The scripts of the .html examples are plain JavaScript, written as a page would write them, so\n    // they are checked with checkJs. Everything is strict except null checks: `querySelector` on an\n    // element the example's own markup contains is not written with a guard.\n    \"allowJs\": true,\n    \"checkJs\": true,\n    \"strictNullChecks\": false\n  },\n  \"include\": [\"../.cache/html-scripts/*.js\", \"../.cache/html-scripts/*.d.ts\"]\n}\n{\n  \"extends\": \"../../../tsconfig.base.json\",\n  \"compilerOptions\": {\n    \"noEmit\": true,\n    \"jsx\": \"react-jsx\",\n    \"types\": [],\n    \"lib\": [\"ES2022\", \"DOM\", \"DOM.Iterable\"]\n  },\n  \"include\": [\"*.ts\", \"*.tsx\"]\n}\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"ESNext\",\n    \"moduleResolution\": \"Bundler\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"strict\": true,\n    \"noUncheckedIndexedAccess\": true,\n    \"exactOptionalPropertyTypes\": false,\n    \"noImplicitOverride\": true,\n    \"noFallthroughCasesInSwitch\": true,\n    \"isolatedModules\": true,\n    \"verbatimModuleSyntax\": true,\n    \"skipLibCheck\": true,\n    \"declaration\": true,\n    \"types\": [\n      \"node\"\n    ]\n  }\n}\nimport { defineConfig } from 'vitest/config';\n\n// Unit and property tests run in Node. Browser tests (*.browser.test.ts) drive system Chrome through\n// Playwright against the built bundle: run `npm run build` first, then `npm run test:browser`.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    include: process.env.AXYLO_BROWSER\n      ? ['packages/*/test/**/*.browser.test.ts', 'apps/docs/test/**/*.browser.test.ts', 'apps/docs/examples/node/*.test.ts']\n      : ['packages/*/test/**/*.test.ts', 'apps/docs/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    // Forked processes with --expose-gc: the store's tests force a collection to check that dropped rows are\n    // released, and fail loudly when they cannot.\n    pool: 'forks',\n    execArgv: ['--expose-gc'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 10000,\n    fileParallelism: !process.env.AXYLO_BROWSER,\n  },\n});\nimport { fileURLToPath } from 'node:url';\nimport { defineConfig } from 'vitest/config';\n\n// The documentation's tests, with the same split as the root vitest.config.ts: unit tests in Node, and\n// browser tests (*.browser.test.ts) against the built library and site when AXYLO_BROWSER is set. The root\n// config does not include apps/docs yet; until it does, run these with `--config apps/docs/vitest.config.ts`.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    root: fileURLToPath(new URL('../..', import.meta.url)),\n    // The Node examples import the package by name, so they run with the browser suite, after the build.\n    include: process.env.AXYLO_BROWSER\n      ? ['apps/docs/test/**/*.browser.test.ts', 'apps/docs/examples/node/*.test.ts']\n      : ['apps/docs/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 30000,\n    hookTimeout: 120000,\n    fileParallelism: false,\n  },\n});\n{\n  \"name\": \"axylo-workspace\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"typecheck\": \"tsc -p packages/axylo --noEmit && tsc -p docs/api && tsc -p packages/react && tsc -p tests/dist\",\n    \"test\": \"vitest run\",\n    \"build\": \"node scripts/build.mjs\",\n    \"size\": \"node scripts/size.mjs\",\n    \"docs:build\": \"node apps/docs/build.mjs\",\n    \"docs:screenshots\": \"node apps/docs/screenshots.mjs\",\n    \"test:browser\": \"AXYLO_BROWSER=1 vitest run\",\n    \"test:dist\": \"vitest run --config tests/dist/vitest.config.ts\",\n    \"test:dist:browser\": \"AXYLO_BROWSER=1 vitest run --config tests/dist/vitest.config.ts\",\n    \"check\": \"npm run typecheck && npm test && npm run build && npm run test:browser && npm run test:dist && npm run test:dist:browser && npm run size\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^26.6.6\",\n    \"@types/react\": \"^19.3.0\",\n    \"@types/react-dom\": \"^19.3.0\",\n    \"axe-core\": \"^4.14.1\",\n    \"esbuild\": \"^0.28.2\",\n    \"fast-check\": \"^4.10.2\",\n    \"playwright-core\": \"^1.65.1\",\n    \"react\": \"^19.3.1\",\n    \"react-dom\": \"^19.3.1\",\n    \"typescript\": \"^7.0.2\",\n    \"vitest\": \"^5.1.0\"\n  }\n}\napps/docs/.cache/html-scripts\napps/docs/.cache/types\napps/docs/.cache/vendor\napps/docs/dist\nnode_modules/@typescript\nnode_modules/typescript\npackages/axylo/dist\npackages/react/dist\nresearch/harness/node_modules/chart.js\nresearch/harness/node_modules/recharts\nimport { line } from 'axylo';\n\nconst rows = [\n  { month: '2026-01', visitors: 4210 },\n  { month: '2026-02', visitors: 4685 },\n  { month: '2026-03', visitors: 5302 },\n  { month: '2026-04', visitors: 5127 },\n];\n\nline('#chart', { title: 'Monthly visitors', data: rows, x: 'month', y: 'visitors' });\n<!doctype html>\n<html lang=\"en\">\n<link rel=\"stylesheet\" href=\"https://cdn.jsdelivr.net/npm/axylo/dist/axylo.css\">\n<script src=\"https://cdn.jsdelivr.net/npm/axylo/dist/axylo.iife.min.js\"></script>\n<div id=\"chart\"></div>\n<script>\n  const rows = [{ month: '2026-01', visitors: 4210 }, { month: '2026-02', visitors: 4685 },\n    { month: '2026-03', visitors: 5302 }, { month: '2026-04', visitors: 5127 }];\n  Axylo.line('#chart', { title: 'Monthly visitors', data: rows, x: 'month', y: 'visitors' });\n</script>\nimport { Line } from '@axylo/react';\n\nconst rows = [\n  { month: '2026-01', visitors: 4210 },\n  { month: '2026-02', visitors: 4685 },\n  { month: '2026-03', visitors: 5302 },\n  { month: '2026-04', visitors: 5127 },\n];\n\nexport function MonthlyVisitors() {\n  return <Line title=\"Monthly visitors\" data={rows} x=\"month\" y=\"visitors\" />;\n}\n     1\t/**\n     2\t * Public types of Axylo. The functions that use them are exported from index.ts.\n     3\t * Source of truth for the public API; docs/api/axylo.d.ts is the reviewed sketch this file started from.\n     4\t */\n     5\t\n     6\t// ---------- data ----------\n     7\t\n     8\t/** Rows as an API returns them, or typed columns for large data. Both describe the same logical table. */\n     9\texport type Data<Row> = readonly Row[] | { readonly columns: { readonly [K in keyof Row]: ArrayLike<Row[K]> } };\n    10\t\n    11\ttype Key<Row> = Extract<keyof Row, string>;\n    12\ttype KeysWhere<Row, V> = { [K in Key<Row>]: [Row[K]] extends [V] ? K : never }[Key<Row>];\n    13\t\n    14\t/** A field that can sit on a value axis as it is. */\n    15\texport type NumberKey<Row> = KeysWhere<Row, number | null | undefined>;\n    16\t/** A field of numeric strings (Postgres bigint and numeric, BigQuery): allowed only with `parse: 'number'`. */\n    17\texport type StringKey<Row> = KeysWhere<Row, string | null | undefined>;\n    18\t/** A field that can sit on an x axis: numbers, instants, calendar dates or categories. */\n    19\texport type XKey<Row> = KeysWhere<Row, number | string | Date | null | undefined>;\n    20\t/** A field that names a series. */\n    21\texport type SeriesKey<Row> = KeysWhere<Row, string | number | boolean>;\n    22\t\n    23\texport type XValue = number | string | Date;\n    24\t\n    25\t// ---------- fields ----------\n    26\t\n    27\tinterface FieldCommon {\n    28\t  /** Axis title and the name used in tooltip, table and announcements. */\n    29\t  label?: string;\n    30\t  /** Unit appended to values in tooltip, table and announcements: 'ms', 'USD', … */\n    31\t  unit?: string;\n    32\t}\n    33\t\n    34\texport interface ValueFieldOptions extends FieldCommon {\n    35\t  /** Declares percentage data and its convention: 'percent' = 0–100, 'ratio' = 0–1. Never inferred from the label. */\n    36\t  scale?: 'percent' | 'ratio';\n    37\t  /** How values are written in tooltip, table and announcements. Default: locale grouping, up to 6 significant fraction digits. */\n    38\t  format?: Intl.NumberFormatOptions | ((value: number) => string);\n    39\t  /** How axis ticks are written. Default: compact when it saves space. */\n    40\t  tickFormat?: Intl.NumberFormatOptions | ((value: number) => string);\n    41\t  /** What a missing value means. 'gap' (default) draws nothing; 'zero' is for counts where absence means none. */\n    42\t  missing?: 'gap' | 'zero';\n    43\t  /** Author bounds. On bar and area the domain is widened to include zero and AX110 is raised if it did not. */\n    44\t  domain?: readonly [number, number];\n    45\t}\n    46\t\n    47\texport type ValueField<Row> =\n    48\t  | NumberKey<Row>\n    49\t  | ({ field: NumberKey<Row>; parse?: never } & ValueFieldOptions)\n    50\t  | ({ field: StringKey<Row>; parse: 'number' } & ValueFieldOptions);\n    51\t\n    52\texport interface XFieldOptions extends FieldCommon {\n    53\t  /**\n    54\t   * 'date': calendar dates ('2026-02-24'); read the same in every time zone.\n    55\t   * 'time': instants (epoch milliseconds, Date objects, ISO strings with an offset); shown in `timeZone`.\n    56\t   * 'number' and 'category' as named. Inferred when omitted, except that numbers are never inferred to be instants.\n    57\t   */\n    58\t  type?: 'number' | 'time' | 'date' | 'category';\n    59\t  /** Category axes only: the categories have a natural order (months, age bands), so labels may be thinned when they do not fit. */\n    60\t  ordered?: boolean;\n    61\t  /** For instants only. Default 'local' (the viewer's zone). */\n    62\t  timeZone?: 'local' | 'UTC' | (string & {});\n    63\t  format?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n    64\t  tickFormat?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n    65\t  domain?: readonly [XValue, XValue];\n    66\t}\n    67\t\n    68\texport type XField<Row> = XKey<Row> | ({ field: XKey<Row> } & XFieldOptions);\n    69\t\n    70\t/** Long form: one row per (x, series). Wide form: one row per x, one column per series. Never both. */\n    71\texport type Encoding<Row> =\n    72\t  | { x: XField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> }\n    73\t  | { x: XField<Row>; y: readonly ValueField<Row>[]; series?: never };\n    74\t\n    75\t// ---------- options ----------\n    76\t\n    77\texport interface Title { text: string; visible?: boolean; level?: 2 | 3 | 4 | 5 | 6 }\n    78\t\n    79\texport interface CommonOptions<Row> {\n    80\t  data: Data<Row>;\n    81\t  /** Visible heading and accessible name. */\n    82\t  title?: string | Title;\n    83\t  /** Id of an existing heading that names the chart, for dashboard cards that already show a title. */\n    84\t  labelledBy?: string;\n    85\t  subtitle?: string;\n    86\t  /** Added to the generated summary. Mandatory disclosures (time zone, omitted values) are kept. */\n    87\t  description?: string;\n    88\t  state?: 'ready' | 'loading' | { error: string } | { empty: string };\n    89\t  legend?: 'auto' | false | 'top' | 'right' | 'bottom';\n    90\t  tooltip?: boolean;\n    91\t  /** \"View as table\" control. Default true. */\n    92\t  table?: boolean;\n    93\t  /** Fixed color per series name, so \"Direct\" is the same color on every chart: { Direct: 'var(--brand-1)' }. */\n    94\t  colors?: Readonly<Record<string, string>>;\n    95\t  /** Overrides for built-in text (\"View as table\", \"No data\", …). */\n    96\t  messages?: Partial<Messages>;\n    97\t  /** Default: the document language. */\n    98\t  locale?: string;\n    99\t  /** Throw on any warning or error diagnostic, synchronously from the call that caused it. */\n   100\t  strict?: boolean;\n   101\t  onDiagnostic?: (diagnostic: Diagnostic) => void;\n   102\t}\n   103\t\n   104\texport interface Reference {\n   105\t  x?: XValue | readonly [XValue, XValue];\n   106\t  y?: number | readonly [number, number];\n   107\t  label: string;\n   108\t}\n   109\t\n   110\texport interface CartesianOptions {\n   111\t  /** Default true on time, date and number x axes. 'touch' also captures pinch and two-finger drag on touch screens. */\n   112\t  zoom?: boolean | 'touch';\n   113\t  reference?: readonly Reference[];\n   114\t}\n   115\t\n   116\t/** Line, area and bar only. Marks only, as a static image with a text alternative: no axes, legend, toolbar, table, zoom or tooltip. */\n   117\texport interface CompactOption { compact?: boolean }\n   118\t\n   119\texport type LineOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row>;\n   120\texport type AreaOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { stacked?: boolean };\n   121\texport type BarOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { layout?: 'grouped' | 'stacked'; horizontal?: boolean };\n   122\t/** Scatter relates two measures: its x is a number, an instant or a date, never a category. */\n   123\texport type ScatterXField<Row> = XKey<Row> | ({ field: XKey<Row>; type?: 'number' | 'time' | 'date'; ordered?: never } & Omit<XFieldOptions, 'type' | 'ordered'>);\n   124\texport type ScatterOptions<Row> = CommonOptions<Row> & CartesianOptions & { x: ScatterXField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> };\n   125\texport type DonutOptions<Row> = CommonOptions<Row> & { label: SeriesKey<Row>; value: ValueField<Row> };\n   126\t\n   127\t// ---------- handle ----------\n   128\t\n   129\t/**\n   130\t * `x`, and the two ends of a `zoom` event, are in the form `zoom()` accepts for the axis: a Date for instants,\n   131\t * 'YYYY-MM-DD' for calendar dates, an ISO date-time without offset for wall-clock times, the category for a\n   132\t * category axis, otherwise the number. They can be passed to another chart's `zoom()` unchanged.\n   133\t */\n   134\texport interface Point<Row> { series: string; x: XValue; y: number | null; row: Row | null; index: number }\n   135\t\n   136\texport interface ChartEvents<Row> {\n   137\t  hover: Point<Row> | null;\n   138\t  select: Point<Row>;\n   139\t  zoom: readonly [XValue, XValue] | null;\n   140\t}\n   141\t\n   142\texport interface Chart<Row, Options> {\n   143\t  /**\n   144\t   * Changes options. Keys present replace the old value; a key set to `undefined` returns to its default; absent keys stay.\n   145\t   * Validation and diagnostics are synchronous (a `strict` chart throws here and keeps its last valid state); drawing happens on the next frame.\n   146\t   */\n   147\t  update(patch: Partial<Options>): void;\n   148\t  /** Adds rows at the end. `keep` = number of distinct x values retained; older ones are dropped. */\n   149\t  append(rows: readonly Row[], options?: { keep?: number }): void;\n   150\t  /** Sets the visible x range; `null` shows everything. */\n   151\t  zoom(domain: readonly [XValue, XValue] | null): void;\n   152\t  on<E extends keyof ChartEvents<Row>>(event: E, listener: (payload: ChartEvents<Row>[E]) => void): () => void;\n   153\t  /** Diagnostics for the current options and data. Up to date as soon as create, update or append returns. */\n   154\t  readonly diagnostics: readonly Diagnostic[];\n   155\t  destroy(): void;\n   156\t}\n   157\t\n   158\texport type Target = string | HTMLElement;\n   159\t\n   160\t\n   161\t\n   162\t\n   163\t\n   164\t\n   165\t\n   166\t// ---------- diagnostics ----------\n   167\t\n   168\texport interface Diagnostic {\n   169\t  /** Stable and documented, one page per code. */\n   170\t  code: `AX${number}`;\n   171\t  level: 'error' | 'warning' | 'hint';\n   172\t  /** What is wrong, where, and how to fix it. */\n   173\t  message: string;\n   174\t  /** The chart it came from: its title, else its element id. */\n   175\t  chart: string;\n   176\t  /** Where applicable. A diagnostic about the chart as a whole (no title, low contrast) has neither. */\n   177\t  field?: string;\n   178\t  /** First offending row indexes in the caller's own data, capped at 10. */\n   179\t  rows?: readonly number[];\n   180\t  count?: number;\n   181\t}\n   182\t\n   183\t/** Runs normalization and validation only. Works without a DOM, so a server or an agent can check options before rendering. */\n   184\t\n   185\t/** Built-in text. Templates use {name} placeholders. Every entry can be replaced through `messages` (spec A10). */\n   186\texport interface Messages {\n   187\t  viewAsTable: string; hideTable: string;\n   188\t  noData: string; noObservation: string; incompleteStack: string;\n   189\t  moreRows: string; otherSlices: string;\n   190\t  valuesNotShown: string; valuesChanged: string; labelsHidden: string;\n   191\t  loading: string; empty: string; error: string; internalError: string;\n   192\t  chartName: string; chartSummary: string; seriesSummary: string; referenceSummary: string; timeZoneNote: string;\n   193\t  plotLabel: string; controlsLabel: string; pointOf: string;\n   194\t  zoomIn: string; zoomOut: string; resetZoom: string; pause: string; resume: string;\n   195\t  previousPage: string; nextPage: string; pageOf: string; jumpToX: string;\n   196\t  showSeries: string; hideSeries: string;\n   197\t  /** Column headers and nouns. */\n   198\t  category: string; percentage: string; series: string; value: string;\n   199\t  /** Chart type names used in generated names and summaries. */\n   200\t  typeLine: string; typeArea: string; typeBar: string; typeScatter: string; typeDonut: string;\n   201\t  /** Summary sentences that have no cartesian form. */\n   202\t  donutSummary: string; seriesNoData: string; seriesNotDrawn: string; referenceLine: string; referenceBand: string;\n   203\t  /** What the keyboard proxy says it is (\"{type} chart\") and how it reads a position. */\n   204\t  plotRole: string; pointAll: string; seriesValue: string; position: string;\n   205\t  /** Label of the stack total in tooltips. */\n   206\t  total: string;\n   207\t  /** Single-click panning (WCAG 2.5.7), the table's \"Jump to\" when nothing matches, and how to move in the plot. */\n   208\t  panLeft: string; panRight: string; jumpNotFound: string; plotInstructions: string;\n   209\t  /** A stack whose components have mixed signs: both ends, in place of one total ('{positive} and {negative}'). */\n   210\t  totalMixed: string;\n   211\t  /** Incomplete stacks in a summary: named when few ('{label}: incomplete at {positions}.'), counted when many ('{label}: {count} incomplete stacks.'). */\n   212\t  incompleteAt: string; incompleteCount: string;\n   213\t  /** Fills `{seeTable}` in `valuesNotShown`, `valuesChanged`, `labelsHidden` and `seriesNotDrawn` when the chart has a table; without one the placeholder is removed. An override without the placeholder is used as written. */\n   214\t  seeTable: string;\n   215\t}\n","exit_code":0,"status":"completed"}}
