{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/core/{stages,chart,delivery}.ts\ncat packages/axylo/src/theme/{watch,styles}.ts\nrg -n 'borrow|\\\\.slice\\\\(|subarray|readValues|aligned|scatter' packages/axylo/src/data/normalize.ts\nrg -n 'state|seriesNotDrawn|summary|legend|small|seeTable' packages/axylo/src/reader/index.ts\"","aggregated_output":"/**\n * The DOM-free stages a call runs before anything is drawn (plan 1.5, 1.6): option resolution, the parts of\n * the options that decide what normalization reads, the view state, and the call-origin diagnostics the\n * view and the naming rule add. The chart controller and `validate()` both use these, so a server, a test or\n * a coding agent sees the same findings as a created chart (spec 3.5, DX8).\n */\nimport type { DiagnosticInput, Frame, View } from './contracts';\nimport type { Diagnostic, Messages, Title, XValue } from '../public';\nimport { normalize, resolveOptions, type ChartType, type ResolvedOptions } from '../data';\nimport { createDiagnostic, DiagnosticCollector, report } from '../diagnostics';\nimport { buildView, type ViewState } from '../view';\nimport { fill, resolveMessages } from '../messages';\nimport { sameValue, INTERNAL_KEYS, type OptionRecord } from './options';\n\nexport type Span<T = number> = readonly [T, T];\n\nexport function object(value: unknown): Record<string, unknown> {\n  return value !== null && typeof value === 'object' ? value as Record<string, unknown> : {};\n}\n\nexport function titleOf(options: OptionRecord): { text: string; level: number; visible: boolean } | null {\n  const raw = options.title;\n  if (typeof raw === 'string') return raw ? { text: raw, level: 3, visible: true } : null;\n  const t = object(raw) as Partial<Title>;\n  if (typeof t.text !== 'string' || t.text === '') return null;\n  const level = typeof t.level === 'number' && t.level >= 2 && t.level <= 6 ? Math.floor(t.level) : 3;\n  return { text: t.text, level, visible: t.visible !== false };\n}\n\nexport function stringOption(options: OptionRecord, key: string): string | null {\n  const v = options[key];\n  return typeof v === 'string' && v !== '' ? v : null;\n}\n\nexport function isCompact(kind: ChartType, options: OptionRecord): boolean {\n  return (kind === 'line' || kind === 'area' || kind === 'bar') && options.compact === true;\n}\n\n/** Options without the controller's own keys (the renderer switch). */\nexport function publicOptions(input: unknown): OptionRecord {\n  if (input === null || typeof input !== 'object') return {};\n  const out: Record<string, unknown> = {};\n  for (const key of Object.keys(input)) {\n    const value = (input as Record<string, unknown>)[key];\n    // A key set to undefined is a default, as the patch rule reads it on create (finding 14: one path).\n    if (!INTERNAL_KEYS.includes(key) && value !== undefined) out[key] = value;\n  }\n  return out;\n}\n\n/** Option keys whose content normalization reads. */\nconst ENCODING_KEYS = ['x', 'y', 'series', 'label', 'value'] as const;\n/** Parts of a field spec that only the view, layout or formatting read: changing them never renormalizes. */\nconst PRESENTATION_PARTS = new Set(['domain', 'format', 'tickFormat']);\n\nfunction fieldEncoding(spec: unknown, ignore: ReadonlySet<string> = PRESENTATION_PARTS): unknown {\n  if (Array.isArray(spec)) return spec.map(item => fieldEncoding(item, ignore));\n  // 'day' and { field: 'day' } read the same field.\n  if (typeof spec === 'string') return { field: spec };\n  if (spec === null || typeof spec !== 'object') return spec;\n  const out: Record<string, unknown> = {};\n  for (const key of Object.keys(spec)) if (!ignore.has(key)) out[key] = (spec as Record<string, unknown>)[key];\n  return out;\n}\n\n/** True when the field specs differ in something normalization reads (plan 2.2: author domains belong to the view). */\nexport function encodingChanged(before: OptionRecord, after: OptionRecord): boolean {\n  return ENCODING_KEYS.some(key => !sameValue(fieldEncoding(before[key]), fieldEncoding(after[key])));\n}\n\nconst NAMING_PARTS = new Set([...PRESENTATION_PARTS, 'label', 'unit']);\n\n/**\n * True when the field specs differ only in labels and units: the values read are the same, so the frame's\n * names can be updated without reading the data again (review 3, finding 12).\n */\nexport function namesOnlyChanged(before: OptionRecord, after: OptionRecord): boolean {\n  return ENCODING_KEYS.every(key => sameValue(fieldEncoding(before[key], NAMING_PARTS), fieldEncoding(after[key], NAMING_PARTS)));\n}\n\nexport function viewStateFor(\n  kind: ChartType, options: OptionRecord, resolved: ResolvedOptions, zoom: Span<XValue> | null,\n  previous: View | null, hidden: ReadonlySet<string>, messages: Messages,\n): ViewState {\n  if (kind === 'donut') return { kind, otherLabel: count => fill(messages.otherSlices, { count }), previous };\n  const value = resolved.values[0];\n  const common = {\n    hidden, zoom, xField: resolved.x, xDomain: resolved.x.domain, valueDomain: value?.domain ?? null,\n    valueField: value?.field, references: Array.isArray(options.reference) ? options.reference as never : [], previous,\n  };\n  // Scatter has no frame-level value scale to infer from: the declared one reaches the domain (F7).\n  if (kind === 'scatter') return { ...common, kind, valueScale: value?.scale ?? null };\n  return {\n    ...common, kind,\n    stacked: kind === 'area' ? options.stacked === true : kind === 'bar' ? options.layout === 'stacked' : false,\n    horizontal: kind === 'bar' && options.horizontal === true,\n    compact: isCompact(kind, options),\n  };\n}\n\n/** What the view depends on; equal keys mean the previous view is still right. */\nexport function viewKeyFor(\n  kind: ChartType, options: OptionRecord, resolved: ResolvedOptions, frame: Frame, zoom: Span<XValue> | null,\n  hidden: ReadonlySet<string>, messages: Messages,\n): readonly unknown[] {\n  return [frame, zoom, [...hidden].sort().join('\\u0000'), resolved.x.domain, resolved.values[0]?.domain, options.reference,\n    options.stacked, options.layout, options.horizontal, options.compact, kind === 'donut' ? messages.otherSlices : null];\n}\n\n/**\n * The view reports AX110, AX130 and AX131 only when they are new against the previous view it reuses. The\n * chart keeps the complete set: a finding the previous view had is kept while its condition still holds.\n */\nexport function completeViewDiagnostics(\n  kind: ChartType, found: readonly DiagnosticInput[], before: readonly DiagnosticInput[], view: View, state: ViewState,\n): DiagnosticInput[] {\n  const out = [...found];\n  if (view.kind === 'donut') return out;\n  const has = (code: string) => out.some(d => d.code === code);\n  const series = view.frame.series.length;\n  const domain = 'valueDomain' in state ? state.valueDomain : null;\n  const stillHolds: Record<string, boolean> = {\n    AX130: series > 8,\n    AX131: view.compact && series > 1,\n    AX110: (kind === 'bar' || kind === 'area') && domain !== null && domain !== undefined &&\n      domain.every(Number.isFinite) && (Math.min(domain[0], domain[1]) > 0 || Math.max(domain[0], domain[1]) < 0),\n  };\n  for (const d of before) {\n    if (stillHolds[d.code] && !has(d.code)) out.push(d);\n  }\n  return out;\n}\n\n/** AX140 (spec A1): no title and no `labelledBy`. A `labelledBy` that names nothing is checked when drawn. */\nexport function namingDiagnostics(options: OptionRecord): DiagnosticInput[] {\n  if (titleOf(options) !== null || stringOption(options, 'labelledBy') !== null) return [];\n  const sink = new DiagnosticCollector();\n  report(sink, 'AX140', 'none');\n  return [...sink.inputs()];\n}\n\n/** resolveOptions reports AX100 and AX101; normalization may report them again. Keep one copy. */\nexport function dedupe(options: readonly DiagnosticInput[], data: readonly DiagnosticInput[]): DiagnosticInput[] {\n  return options.filter(o => !data.some(d => d.code === o.code && d.field === o.field));\n}\n\nexport function toPublic(inputs: readonly DiagnosticInput[], chart: string): Diagnostic[] {\n  return inputs.map(({ effect: _e, origin: _o, ...d }) => ({ ...d, chart }));\n}\n\n/**\n * Everything a create call validates without a DOM, in the order the chart lists it: options, data, view,\n * naming. `validate()` returns this; a created chart reports the same call-origin findings.\n */\nexport function staticDiagnostics(kind: ChartType, input: unknown, timeZone: string): Diagnostic[] {\n  const options = publicOptions(input);\n  const optionSink = new DiagnosticCollector();\n  const dataSink = new DiagnosticCollector();\n  let name: string = kind;\n  try {\n    const resolved = resolveOptions(kind, options, optionSink);\n    name = resolved.name;\n    const frame = normalize(kind, resolved, { timeZone }, dataSink, { epoch: 1, revision: 1 });\n    const viewSink = new DiagnosticCollector();\n    const messages = resolveMessages(object(options.messages));\n    const state = viewStateFor(kind, options, resolved, null, null, new Set(), messages);\n    buildView(frame as never, state as never, viewSink);\n    const data = dataSink.inputs();\n    return toPublic([...dedupe(optionSink.inputs(), data), ...data, ...viewSink.inputs(), ...namingDiagnostics(options)], name);\n  } catch {\n    // A failure inside the stages (an x getter that throws): AX199, as a created chart reports it (finding 14).\n    return toPublic([...optionSink.inputs(), createDiagnostic('AX199', 'chart-error', {}, 'presentation'), ...namingDiagnostics(options)], name);\n  }\n}\n\nexport { createDiagnostic };\n/**\n * `createChart`: the browser host of the controller (controller.ts). It resolves the target, builds the\n * figure, the mark and text renderers and the interaction layer, and connects the page's observers to the\n * controller. Every setup step registers its own cleanup as soon as it succeeded, so a failure part-way\n * through creation, or `destroy()`, leaves the target as it was (including the custom properties the theme\n * wrote on it).\n *\n * Document-level listeners (theme and environment watchers, the interaction layer's keyboard and pointer\n * listeners on the document) are released when the target leaves the document without `destroy()`, so a\n * forgotten chart does not stay reachable from the page, and are attached again if the target comes back.\n * Detachment is noticed by the observers the chart already has (the resize observer reports a zero box),\n * not by polling.\n */\nimport type { MarkRenderer, Scene } from './contracts';\nimport { createCanvasRenderer, createSvgRenderer, createTextLayer, type TextLayer } from '../render';\nimport { ensureStyles, resolveTheme, watchTheme } from '../theme';\nimport { createFigure, type Figure } from '../dom/figure';\nimport { createInteraction, type Interaction } from '../dom/interaction';\nimport type { DeliveryConsole } from './delivery';\nimport { createMeasurer, noteFontLoad, readTextStyle, resolveLocale, viewerTimeZone, watchEnvironment, watchLanguage } from './environment';\nimport { createController, type ChartHandle, type ChartKind, type Controller, type ControllerActions } from './controller';\nimport { object } from './stages';\n\nexport type { BenchHook, ChartHandle, ChartKind, DevHook, Stage } from './controller';\n\nexport interface ChartEnvironmentOverrides {\n  readonly console?: DeliveryConsole | null;\n}\n\n/** Suffixes of the ids a chart gives its elements (figure, interaction, table). */\nconst ID_SUFFIXES = ['', '-t', '-st', '-s', '-m', '-n', '-i', '-proxy', '-table', '-table-caption', '-table-jump', '-table-jump-error'];\nlet instances = 0;\n\n/** An id prefix none of whose element ids exist in the page yet (spec A1: ids unique per chart). */\nfunction allocateId(doc: Document): string {\n  for (;;) {\n    const id = `axylo-${++instances}`;\n    if (ID_SUFFIXES.every(suffix => doc.getElementById(id + suffix) === null)) return id;\n  }\n}\n\nexport function createChart(kind: ChartKind, target: unknown, input: unknown, overrides: ChartEnvironmentOverrides = {}): ChartHandle {\n  const root = resolveTarget(target);\n  const doc = root.ownerDocument;\n  const win = doc.defaultView;\n  if (win === null) throw new Error('Axylo: the target element is not in a document with a window.');\n\n  // Cleanup in reverse order of setup; each step adds its own once it succeeded.\n  const cleanup: (() => void)[] = [];\n  const release = (): void => {\n    for (let fn = cleanup.pop(); fn; fn = cleanup.pop()) {\n      try {\n        fn();\n      } catch {\n        // Keep releasing the rest.\n      }\n    }\n  };\n\n  let controller: Controller | null = null;\n  try {\n    const requested = object(input).__renderer === 'canvas' ? 'canvas' : 'svg';\n    const id = allocateId(doc);\n\n    const renderer: MarkRenderer = requested === 'canvas' ? createCanvasRenderer(doc) : createSvgRenderer(doc);\n    cleanup.push(() => renderer.destroy());\n    const textLayer: TextLayer = createTextLayer(doc);\n    cleanup.push(() => textLayer.destroy());\n    const figure: Figure = createFigure(root, id, { marks: renderer.element, text: textLayer.element });\n    cleanup.push(() => figure.destroy());\n\n    // The interaction layer is built before the controller that answers it, so its actions forward late.\n    const actions: ControllerActions = {\n      zoom: w => controller?.actions.zoom(w),\n      toggle: k => controller?.actions.toggle(k),\n      pause: p => controller?.actions.pause(p),\n      select: r => controller?.actions.select(r),\n      hover: r => controller?.actions.hover(r),\n    };\n    const interaction: Interaction = createInteraction(figure, renderer, actions);\n    cleanup.push(() => interaction.destroy());\n    const measurer = createMeasurer(doc);\n    ensureStyles(doc);\n\n    // Watchers that the document holds; released while the target is out of the document.\n    let watching: (() => void) | null = null;\n    let watchedBefore = false;\n    const watch = (): void => {\n      if (watching || controller === null) return;\n      const c = controller;\n      if (watchedBefore) c.invalidate.page();\n      watchedBefore = true;\n      const stopTheme = watchTheme(root, () => c.invalidate.theme());\n      const stopEnvironment = watchEnvironment(win, {\n        pixelRatio: () => c.invalidate.pixelRatio(),\n        motion() {\n          // Nothing is animated yet (spec I5), so there is nothing to change.\n        },\n        fonts() {\n          noteFontLoad(doc);\n          c.invalidate.fonts();\n        },\n      });\n      const stopLanguage = watchLanguage(root, () => c.invalidate.language());\n      interaction.attach();\n      watching = () => {\n        stopTheme();\n        stopEnvironment();\n        stopLanguage();\n        interaction.detach();\n      };\n    };\n    const unwatch = (): void => {\n      watching?.();\n      watching = null;\n    };\n    cleanup.push(unwatch);\n\n    // A font can arrive without a 'loadingdone' (a FontFace loaded first and then added to document.fonts):\n    // a probe set like the labels changes size whenever their font does, and that is a font load (L1).\n    const fontProbe = doc.createElement('div');\n    fontProbe.className = 'axylo-font-probe';\n    textLayer.element.appendChild(fontProbe);\n    let probeSize: string | null = null;\n    const fontObserver = new win.ResizeObserver(() => {\n      const box = fontProbe.getBoundingClientRect();\n      const size = `${box.width}x${box.height}`;\n      if (probeSize !== null && size !== probeSize && controller !== null && root.isConnected) {\n        noteFontLoad(doc);\n        controller.invalidate.fonts();\n      }\n      probeSize = size;\n    });\n    fontObserver.observe(fontProbe);\n    cleanup.push(() => fontObserver.disconnect());\n\n    const resizeObserver = new win.ResizeObserver(() => {\n      if (controller === null) return;\n      // A target