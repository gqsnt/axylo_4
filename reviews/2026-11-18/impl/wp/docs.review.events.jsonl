{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/data/{steps,values,x}.ts'","aggregated_output":"import type { XColumn } from '../core/contracts';\nimport { instantToWall, utcFields, wallToInstant } from '../scale/zone';\nimport { DAY, HOUR, dailyDelta } from './x';\n\ntype Axis = Pick<XColumn, 'kind' | 'dateUnit' | 'timeZone'>;\n\nexport function stepDelta(axis: Axis, a: number, b: number): number {\n  if (axis.kind === 'time') return dailyDelta(b - a);\n  if (axis.kind !== 'date') return b - a;\n  if (axis.dateUnit === 'day') return (b - a) / DAY;\n  const from = new Date(a);\n  const to = new Date(b);\n  const years = to.getUTCFullYear() - from.getUTCFullYear();\n  return axis.dateUnit === 'year' ? years : 12 * years + to.getUTCMonth() - from.getUTCMonth();\n}\n\nexport function supportsSteps(axis: Axis): boolean {\n  return axis.kind === 'number' || axis.kind === 'date' || axis.kind === 'time' || axis.kind === 'wall';\n}\n\nexport function stepMultiple(delta: number, step: number): number {\n  const ratio = delta / step;\n  const whole = Math.round(ratio);\n  return whole >= 1 && Number.isFinite(whole) && Math.abs(ratio - whole) < 1e-9 ? whole : 0;\n}\n\nfunction numberGap(a: number, b: number, step: number, steps: number): number {\n  const position = a + steps * step;\n  if (Number.isInteger(a) && Number.isInteger(step)) return position;\n  const noise = Math.min(step * 1e-9, 8 * Number.EPSILON * Math.max(Math.abs(a), Math.abs(b)));\n  // Round at the precision of the input positions, since subtraction can lose more digits than the step has.\n  const factor = 10 ** Math.floor(-Math.log10(noise));\n  const units = Math.round(position * factor);\n  const rounded = units === 0 ? 0 : units / factor;\n  if (Number.isSafeInteger(units) && Math.abs(position - rounded) <= noise) return rounded;\n  return position;\n}\n\nexport function gapPosition(axis: Axis, a: number, b: number, step: number, steps: number, span: number): number {\n  if (axis.kind === 'number') return numberGap(a, b, step, steps);\n  if (axis.kind === 'date') {\n    if (axis.dateUnit === 'day') return a + steps * step * DAY;\n    const from = new Date(a);\n    return axis.dateUnit === 'year'\n      ? utcFields(from.getUTCFullYear() + steps * step, 0, 1)\n      : utcFields(from.getUTCFullYear(), from.getUTCMonth() + steps * step, 1);\n  }\n  if (axis.kind === 'time' && axis.timeZone !== null && step % DAY === 0 && axis.timeZone !== 'UTC') {\n    const wall = instantToWall(axis.timeZone, a);\n    if (instantToWall(axis.timeZone, b) - wall === dailyDelta(b - a)) {\n      return wallToInstant(axis.timeZone, wall + steps * step);\n    }\n  }\n  return a + steps * step;\n}\n\nexport function snapGap(\n  gap: number, a: number, b: number, step: number, count: number, at: (index: number) => number,\n): number {\n  let lo = 0;\n  let hi = count;\n  while (lo < hi) {\n    const mid = lo + Math.floor((hi - lo) / 2);\n    if (at(mid) < gap) lo = mid + 1;\n    else hi = mid;\n  }\n  const before = lo ? at(lo - 1) : -Infinity;\n  const after = lo < count ? at(lo) : Infinity;\n  const nearest = gap - before < after - gap ? before : after;\n  const roundingError = 4 * Number.EPSILON * Math.max(Math.abs(a), Math.abs(b));\n  return Math.abs(gap - nearest) <= Math.min(roundingError, step / 4) ? nearest : gap;\n}\n\nexport function tooSparse(gaps: number, observations: number): boolean {\n  return gaps > 1000 && gaps > 2 * observations;\n}\n\nexport function inferGaps(\n  axis: Axis, count: number, xAt: (i: number) => number,\n  snap: (gap: number, a: number, b: number, step: number) => number,\n  sparse?: (gaps: number) => void,\n): Float64Array | null {\n  if (!supportsSteps(axis) || count < 3) return null;\n  let a = xAt(0);\n  let min = Infinity;\n  let max = 0;\n  for (let i = 1; i < count; i++) {\n    const b = xAt(i);\n    const delta = stepDelta(axis, a, b);\n    if (delta < min) min = delta;\n    if (delta > max) max = delta;\n    a = b;\n  }\n  if (stepMultiple(max, min) === 1 || !(min > 0)) return null;\n  let gaps = 0;\n  let consecutive = 0;\n  a = xAt(0);\n  for (let i = 1; i < count; i++) {\n    const b = xAt(i);\n    const multiple = stepMultiple(stepDelta(axis, a, b), min);\n    if (!multiple) return null;\n    if (multiple === 1) consecutive++;\n    gaps += multiple - 1;\n    a = b;\n  }\n  if (consecutive * 2 < count - 1 || !gaps) return null;\n  if (tooSparse(gaps, count)) {\n    sparse?.(gaps);\n    return null;\n  }\n\n  const positions = new Float64Array(gaps);\n  let next = 0;\n  a = xAt(0);\n  for (let i = 1; i < count; i++) {\n    const b = xAt(i);\n    const multiple = stepMultiple(stepDelta(axis, a, b), min);\n    for (let j = 1; j < multiple; j++) {\n      const gap = gapPosition(axis, a, b, min, j, multiple);\n      positions[next++] = axis.kind === 'number' ? snap(gap, a, b, min) : gap;\n    }\n    a = b;\n  }\n  return positions;\n}\n\nexport function calendarIntervals(a: number, b: number, zone: string): number {\n  const delta = b - a;\n  const utc = delta % DAY === 0 ? 1 : 0;\n  if (zone === 'UTC' || delta < DAY - HOUR || Math.abs(delta - Math.round(delta / DAY) * DAY) > HOUR) return utc;\n  return (instantToWall(zone, b) - instantToWall(zone, a)) % DAY === 0 ? utc | 2 : utc;\n}\nimport { SLOT_ABSENT_FIELD, SLOT_INVALID, SLOT_NULL, SLOT_VALUE, type DiagnosticSink, type SlotState } from '../core/contracts';\nimport type { ResolvedValueField } from './options';\nimport { Reports } from './reports';\nimport type { Table } from './table';\n\nconst decimal = /^[+-]?\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$/;\nexport type ValueMode = 'empty' | 'decimal' | 'other';\nexport type ValueCounts = Record<Exclude<ValueMode, 'empty'>, number>;\n\nexport function valueMode(value: unknown, column: boolean): ValueMode {\n  if (value == null || value === '' || (column && typeof value === 'number' && Number.isNaN(value))) return 'empty';\n  return typeof value === 'string' && decimal.test(value) ? 'decimal' : 'other';\n}\n\nexport function inspectValues(table: Table, field: string, included?: (row: number) => boolean): ValueMode {\n  let mode: ValueMode = 'empty';\n  for (let i = 0; i < table.length; i++) {\n    if (included && !included(i)) continue;\n    const next = valueMode(table.read(i, field), table.isColumnRow(i));\n    if (next === 'other') return next;\n    if (next === 'decimal') mode = next;\n  }\n  return mode;\n}\n\nexport interface Values {\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n}\n\nexport function readValues(\n  table: Table,\n  field: ResolvedValueField,\n  sink: DiagnosticSink,\n  impute: boolean,\n  startRow = 0,\n  mode?: ValueMode,\n  included?: (row: number) => boolean,\n  outcome?: string,\n  counts?: ValueCounts,\n): Values {\n  const column = table.columns?.[field.field];\n  const borrowed = column instanceof Float64Array || column instanceof Float32Array;\n  const zero = impute && field.missing === 'zero';\n  const slot = new Uint8Array(table.length);\n  let y = borrowed ? column : new Float64Array(table.length);\n  let i = 0;\n  if (borrowed && !included) {\n    // Values and typed NaNs can stay in the caller's storage without generic row validation.\n    let missing = 0;\n    for (; i < table.length; i++) {\n      const value = column[i]!;\n      if (Number.isFinite(value)) continue;\n      if (zero || !Number.isNaN(value)) break;\n      slot[i] = SLOT_NULL;\n      missing++;\n    }\n    if (counts) counts.other += i - missing;\n    if (i === table.length) return { y, slot };\n  }\n  const reports = new Reports(field.field, sink);\n  mode ??= borrowed ? 'other' : inspectValues(table, field.field, included);\n\n  for (; i < table.length; i++) {\n    if (included && !included(i)) continue;\n    const raw = column === undefined ? table.read(i, field.field) : column[i];\n    if (counts) {\n      const kind = valueMode(raw, table.isColumnRow(i));\n      if (kind !== 'empty') counts[kind]++;\n    }\n    let value = NaN;\n    let state: SlotState = SLOT_VALUE;\n    if (typeof raw === 'number') {\n      if (Number.isFinite(raw)) value = raw;\n      else if (Number.isNaN(raw) && (column || table.isColumnRow(i))) state = SLOT_NULL;\n      else {\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n      }\n    } else if (raw === undefined) {\n      state = SLOT_ABSENT_FIELD;\n      reports.add('AX102', zero ? 'changed' : 'omitted', startRow + table.rowIndex(i), undefined, undefined,\n        { outcome: zero ? undefined : outcome });\n    } else if (raw === null || raw === '') {\n      state = SLOT_NULL;\n    } else if (mode === 'decimal') {\n      value = Number(raw);\n      if (!Number.isFinite(value)) {\n        value = NaN;\n        state = SLOT_INVALID;\n        reports.add('AX103', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n      }\n      if (field.parse !== 'number') reports.add('AX104', 'none', startRow + table.rowIndex(i));\n    } else {\n      state = SLOT_INVALID;\n      reports.add('AX106', 'omitted', startRow + table.rowIndex(i), raw, undefined, { outcome });\n    }\n    if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) value = 0;\n    if (y === column && !Object.is(y[i], value)) {\n      // Infinity and explicit zero imputation cannot be represented by an unchanged borrowed view.\n      y = y.slice();\n    }\n    if (y !== column) y[i] = value;\n    slot[i] = state;\n  }\n\n  reports.flush(sink);\n  return { y, slot };\n}\nimport { StoreMap } from './store-map';\nimport { Labels } from './store-window';\nimport type { DiagnosticInput, Environment, XColumn, XKind } from '../core/contracts';\nimport { DiagnosticCollector, report, type DiagnosticCode } from '../diagnostics';\nimport { diagnosticContext } from '../diagnostics/registry';\nimport type { XValue } from '../public';\nimport { canonicalZone, type ResolvedXField } from './options';\nimport { Reports } from './reports';\nimport type { Table } from './table';\n\nconst calendar = /^(\\d{4})(?:-(\\d{2})(?:-(\\d{2}))?)?$/;\nconst dateTime = /^(\\d{4})-(\\d{2})-(\\d{2})[Tt ](\\d{2}):(\\d{2})(?::(\\d{2})(?:\\.(\\d+))?)?([Zz]|[+-]\\d{2}:?\\d{2})?$/;\nconst daysInMonth = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31];\nconst maxInstant = 8_640_000_000_000_000;\nexport const DAY = 86_400_000;\nexport const HOUR = 3_600_000;\nexport type DateUnit = NonNullable<XColumn['dateUnit']>;\n\nexport interface XAxisMeta extends Pick<XColumn, 'kind' | 'categories' | 'timeZone'> {\n  readonly field?: ResolvedXField;\n}\n\nexport interface XPositionParser {\n  position(value: XValue): number | null;\n  readonly reports: readonly DiagnosticInput[];\n}\n\n/**\n * Converts author values to positions on a resolved axis. Categories must already exist.\n * Reports accumulate by code and field for this parser and have no source row provenance.\n */\nexport function createXParser(axis: XAxisMeta, environment: Pick<Environment, 'timeZone'>): XPositionParser {\n  const field = axis.field ?? {\n    field: 'x', label: 'x', unit: null, type: axis.kind === 'wall' || axis.kind === 'number' ? null : axis.kind,\n    timeZone: 'local', ordered: false, format: null, tickFormat: null, domain: null,\n  };\n  const parser = new XParser({ ...field, timeZone: axis.timeZone ?? field.timeZone }, axis.kind, environment);\n  const categories = new Map(axis.categories?.map((label, index) => [label, index]));\n  const diagnostics = new DiagnosticCollector();\n  return {\n    position(value) {\n      if (axis.kind === 'category') {\n        const name = nameOf(value);\n        const index = name === null ? undefined : categories.get(name);\n        if (index !== undefined) return index;\n        report(diagnostics, 'AX107', 'none', { field: field.field, rows: [], outcome: 'The option is ignored.' });\n        return null;\n      }\n      const reports = new Reports(field.field);\n      const position = parser.read(value, -1, reports);\n      reports.flush({ add(diagnostic) {\n        const { code, count, effect } = diagnostic;\n        const context = diagnosticContext(diagnostic);\n        report(diagnostics, code as DiagnosticCode, 'none', {\n          ...context, field: field.field, count, rows: [], outcome: effect === 'omitted' ? 'The option is ignored.' : context?.outcome,\n        });\n      } });\n      return Number.isFinite(position) ? position : null;\n    },\n    get reports() { return diagnostics.inputs(); },\n  };\n}\n\nexport function dateUnitOf(value: unknown): DateUnit {\n  if (typeof value === 'string' && calendar.test(value)) {\n    if (value.length === 4) return 'year';\n    if (value.length === 7) return 'month';\n  }\n  return 'day';\n}\n\nfunction validDate(year: string, month = '01', day = '01'): boolean {\n  const m = Number(month);\n  const y = Number(year);\n  const leap = y % 4 === 0 && (y % 100 !== 0 || y % 400 === 0);\n  const max = (daysInMonth[m - 1] ?? 0) + (m === 2 && leap ? 1 : 0);\n  return Number(day) >= 1 && Number(day) <= max;\n}\n\nexport function kindOf(value: unknown): XKind | null {\n  if (typeof value === 'number') return Number.isFinite(value) ? 'number' : null;\n  if (value instanceof Date) return 'time';\n  if (typeof value !== 'string') return null;\n  if (calendar.test(value)) return 'date';\n  const parts = dateTime.exec(value);\n  if (parts) return parts[8] ? 'time' : 'wall';\n  // An invalid ISO-looking value should be reported rather than establishing a category axis.\n  if (/^\\d{4}-\\d{2}-\\d{2}[Tt ]/.test(value)) return /(?:[Zz]|[+-]\\d{2}:?\\d{2})$/.test(value) ? 'time' : 'wall';\n  return 'category';\n}\n\nfunction instant(value: string, kind: 'time' | 'wall'): number {\n  const parts = dateTime.exec(value);\n  if (!parts || !validDate(parts[1]!, parts[2], parts[3]) || (kind === 'time') !== Boolean(parts[8])) return NaN;\n  const iso = value[10] === ' ' ? value.slice(0, 10) + 'T' + value.slice(11) : value;\n  return Date.parse(kind === 'wall' ? iso + 'Z' : iso);\n}\n\nconst kinds = ['date', 'time', 'wall', 'number', 'category'] as const;\nexport type KindVotes = Record<XKind, number>;\n\nexport function countKinds(table: Table, field: string, series: string | null = null): KindVotes {\n  const votes: KindVotes = { date: 0, time: 0, wall: 0, number: 0, category: 0 };\n  const column = table.columns?.[field];\n  if (series === null && (column instanceof Float64Array || column instanceof Float32Array)) {\n    for (let i = 0; i < column.length; i++) {\n      const value = column[i]!;\n      if (Number.isFinite(value)) votes.number++;\n      else if (!Number.isNaN(value)) votes.category++;\n    }\n    return votes;\n  }\n  for (let i = 0; i < table.length; i++) {\n    if (series !== null && nameOf(table.read(i, series)) === null) continue;\n    const value = table.read(i, field);\n    if (value == null || value === '' || Number.isNaN(value) && table.isColumnRow(i)) continue;\n    votes[kindOf(value) ?? 'category']++;\n  }\n  return votes;\n}\n\nexport function preferredKind(votes: KindVotes): XKind | null {\n  const { date, time, wall, number, category } = votes;\n  const recognized = date + time + wall + number;\n  if (recognized + category === 0) return null;\n  if (category >= recognized) return 'category';\n  // Use a fixed order for ties so reordering records cannot change which values are drawn.\n  return kinds.find(kind => kind !== 'category' && votes[kind] === Math.max(date, time, wall, number))!;\n}\n\nexport function inferKind(table: Table, field: string, series: string | null = null): XKind | null {\n  return preferredKind(countKinds(table, field, series));\n}\n\nexport function nameOf(value: unknown): string | null {\n  if (typeof value === 'string') return value;\n  if (typeof value === 'boolean' || typeof value === 'number' && Number.isFinite(value)) return String(value);\n  return null;\n}\n\nexport class XParser {\n  readonly timeZone: string | null;\n  private names: Labels | null;\n  private firstIndex = 0;\n  private indexes: StoreMap<string, number> | null;\n  dateUnit: DateUnit | null = null;\n\n  constructor(\n    readonly field: ResolvedXField,\n    readonly kind: XKind,\n    env: Pick<Environment, 'timeZone'>,\n    private readonly scatter = false,\n    categories?: readonly string[],\n  ) {\n    this.timeZone = kind === 'time'\n      ? (field.timeZone === 'local' ? undefined : canonicalZone(field.timeZone)) ??\n        canonicalZone(env.timeZone) ?? Intl.DateTimeFormat().resolvedOptions().timeZone\n      : null;\n    this.names = kind === 'category' ? new Labels(categories) : null;\n    this.indexes = this.names ? new StoreMap(new Map(categories?.map((name, index) => [name, index]))) : null;\n  }\n\n  get categories(): readonly string[] | null {\n    return this.names?.view() ?? null;\n  }\n\n  get categoryCount(): number {\n    return this.names?.length ?? 0;\n  }\n\n  categoryName(position: number): string | undefined {\n    return this.names?.at(position - this.firstIndex);\n  }\n\n  fork(): XParser {\n    return Object.assign(Object.create(XParser.prototype) as XParser, this, {\n      names: this.names?.fork() ?? null,\n      indexes: this.indexes?.fork() ?? null,\n    });\n  }\n\n  copy(): XParser {\n    const copy = new XParser(this.field, this.kind, { timeZone: this.timeZone ?? 'UTC' }, this.scatter, this.names?.snapshot());\n    copy.dateUnit = this.dateUnit;\n    return copy;\n  }\n\n  commit(): void { this.indexes?.commit(); }\n\n  evictCategories(count: number): void {\n    if (!this.names) return;\n    for (let i = 0; i < count; i++) this.indexes!.delete(this.names.at(i));\n    this.firstIndex += count;\n    this.names.drop(count);\n  }\n\n  private parse(raw: unknown, row: number, reports: Reports): number {\n    const kind = this.kind;\n    if (typeof raw === 'number' && Number.isFinite(raw)) {\n      if (kind === 'number' && !this.field.type && Math.abs(raw) >= 1e11 && Math.abs(raw) < 1e14) {\n        reports.add('AX109', 'none', row, undefined, 'Set type: \\'time\\' if these values are epoch milliseconds.');\n      }\n      if (kind === 'time' && this.field.type === 'time' && Math.abs(raw) >= 1e9 && Math.abs(raw) < 1e10) {\n        reports.add('AX109', 'none', row, undefined, 'These values look like seconds. Multiply them by 1,000 to supply epoch milliseconds.');\n      }\n      if (kind === 'number' || kind === 'time' && this.field.type === 'time' && Math.abs(raw) <= maxInstant) return raw;\n    }\n    if (kind === 'time' && raw instanceof Date) return raw.getTime();\n    if (kind === 'category' && !this.scatter) {\n      const name = this.field.type === 'category' ? nameOf(raw) : typeof raw === 'string' && kindOf(raw) === 'category' ? raw : null;\n      if (name === null) return NaN;\n      const known = this.indexes!.get(name);\n      if (known !== undefined) return known;\n      const index = this.firstIndex + this.categoryCount;\n      this.names!.push(name);\n      this.indexes!.set(name, index);\n      return index;\n    }\n    if (kind === 'date' && this.field.type === 'date' && (typeof raw === 'number' || raw instanceof Date ||\n      typeof raw === 'string' && kindOf(raw) === 'time')) {\n      const ms = typeof raw === 'number' ? new Date(raw).getTime() : raw instanceof Date ? raw.getTime() : instant(raw, 'time');\n      if (!Number.isFinite(ms)) return NaN;\n      this.dateUnit = 'day';\n      return Math.floor(ms / DAY) * DAY;\n    }\n    if (typeof raw !== 'string') return NaN;\n    if (kind === 'date') {\n      const parts = calendar.exec(raw);\n      if (!parts || !validDate(parts[1]!, parts[2], parts[3])) return NaN;\n      const unit: DateUnit = parts[3] !== undefined ? 'day' : parts[2] !== undefined ? 'month' : 'year';\n      if (this.dateUnit === null || unit === 'day' || unit === 'month' && this.dateUnit === 'year') this.dateUnit = unit;\n      return Date.parse(parts[1] + '-' + (parts[2] ?? '01') + '-' + (parts[3] ?? '01') + 'T00:00:00Z');\n    }\n    if (kind === 'wall' || kind === 'time') {\n      const position = instant(raw, kind);\n      if (kind === 'wall' && Number.isFinite(position)) reports.add('AX112', 'none', row);\n      return position;\n    }\n    return NaN;\n  }\n\n  read(raw: unknown, row: number, reports: Reports, omitted = 1): number {\n    if (raw === undefined) {\n      reports.add('AX102', 'omitted', row, undefined, undefined, { amount: omitted, outcome: 'The affected row is not drawn.' });\n      return NaN;\n    }\n    const result = this.parse(raw, row, reports);\n    if (!Number.isFinite(result)) {\n      const fix = this.scatter && this.kind === 'category'\n        ? 'Use a numeric, calendar date or time field for scatter x values.'\n        : undefined;\n      reports.add('AX107', 'omitted', row, raw, fix, { amount: omitted });\n    }\n    return result;\n  }\n\n  restore(categoryCount: number, dateUnit: DateUnit | null): void {\n    this.dateUnit = dateUnit;\n    if (!this.names) return;\n    while (this.categoryCount > categoryCount) this.indexes!.delete(this.names.pop()!);\n  }\n\n  column(values: Float64Array, shareCategories = false): XColumn {\n    return {\n      kind: this.kind, values, categories: shareCategories ? this.categories : this.names?.snapshot() ?? null,\n      timeZone: this.timeZone, dateUnit: this.kind === 'date' ? this.dateUnit ?? 'day' : null,\n      ordered: this.kind === 'category' && this.field.ordered,\n    };\n  }\n}\n\nexport function dailyDelta(delta: number): number {\n  const days = Math.round(delta / DAY);\n  return days > 0 && Math.abs(delta - days * DAY) <= HOUR ? days * DAY : delta;\n}\n\nexport function sameDailyTime(first: number, position: number): boolean {\n  const delta = position - first;\n  return Math.abs(delta - Math.round(delta / DAY) * DAY) <= HOUR;\n}\n\nconst positionFormats = new Map<string, Intl.DateTimeFormat>();\n\nexport function positionName(axis: Pick<XColumn, 'kind' | 'dateUnit' | 'timeZone' | 'categories'>, position: number): string {\n  if (axis.kind === 'category') return JSON.stringify(axis.categories?.[position] ?? position);\n  if (axis.kind === 'number') return String(position);\n  if (axis.kind === 'time') {\n    const zone = axis.timeZone ?? 'UTC';\n    if (zone === 'UTC') return new Date(position).toISOString();\n    let format = positionFormats.get(zone);\n    if (!format) {\n      format = new Intl.DateTimeFormat('en-CA', {\n        timeZone: zone, year: 'numeric', month: '2-digit', day: '2-digit',\n        hour: '2-digit', minute: '2-digit', second: '2-digit', fractionalSecondDigits: 3, hourCycle: 'h23',\n      });\n      positionFormats.set(zone, format);\n    }\n    return format.format(position) + ' ' + zone;\n  }\n  const iso = new Date(position).toISOString();\n  if (axis.kind === 'wall') return iso.slice(0, -1);\n  return iso.slice(0, axis.dateUnit === 'year' ? -20 : axis.dateUnit === 'month' ? -17 : -14);\n}\n","exit_code":0,"status":"completed"}}
