{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/view/*.ts; cat packages/axylo/test/scene/scene.test.ts'","aggregated_output":"import { normalize, resolveOptions } from '../../src/data';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { buildView, type AlignedViewState, type DonutViewState, type ScatterViewState } from '../../src/view';\n\nconst utc = { timeZone: 'UTC' };\nconst version = { revision: 8, epoch: 4 };\n\nexport function aligned(options: unknown, state: AlignedViewState) {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions(state.kind, options, diagnostics);\n  const frame = normalize(state.kind, resolved, utc, diagnostics, version);\n  const view = buildView(frame, {\n    xField: resolved.x, valueDomain: resolved.values[0]?.domain, ...state,\n  }, diagnostics);\n  return { frame, view, diagnostics };\n}\n\nexport function scatter(options: unknown, state: Omit<ScatterViewState, 'kind'> = {}) {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions('scatter', options, diagnostics);\n  const frame = normalize('scatter', resolved, utc, diagnostics, version);\n  const view = buildView(frame, {\n    kind: 'scatter', xField: resolved.x, valueDomain: resolved.values[0]?.domain, valueScale: resolved.values[0]?.scale, ...state,\n  }, diagnostics);\n  return { frame, view, diagnostics };\n}\n\nexport function donut(data: readonly { label: string; value: number | null }[], state: Partial<DonutViewState> = {}) {\n  const diagnostics = new DiagnosticCollector();\n  const options = resolveOptions('donut', { label: 'label', value: 'value', data }, diagnostics);\n  const frame = normalize('donut', options, utc, diagnostics, version);\n  const view = buildView(frame, { kind: 'donut', otherLabel: count => 'Other (' + count + ')', ...state }, diagnostics);\n  return { frame, view, diagnostics };\n}\nimport fc from 'fast-check';\nimport { describe, expect, it } from 'vitest';\nimport { SLOT_GAP, SLOT_NO_ROW, SLOT_NULL } from '../../src/core/contracts';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { buildView } from '../../src/view';\nimport { aligned, donut, scatter } from './fixtures';\n\ndescribe('view domains and visibility', () => {\n  it('widens the full x extent with author bounds and clamps a zoom on either side', () => {\n    const options = { x: { field: 'x', domain: [-3, 8] }, y: 'y', data: [{ x: 0, y: 1 }, { x: 5, y: 3 }] };\n    const { view } = aligned(options, { kind: 'line', zoom: [-10, 4] });\n    expect(view.xFull).toEqual([-3, 8]);\n    expect(view.xDomain).toEqual([-3, 4]);\n    expect(view.visibleSlots).toEqual({ start: 0, end: 1 });\n    expect(aligned(options, { kind: 'line', zoom: [4, 20] }).view.xDomain).toEqual([4, 8]);\n    expect(aligned({ ...options, x: 'x' }, { kind: 'line', zoom: [-10, 20] }).view.xDomain).toEqual([0, 5]);\n    expect(aligned(options, { kind: 'line', xDomain: null }).view.xFull).toEqual([0, 5]);\n  });\n\n  it('keeps category bars and compact charts on their full x ranges', () => {\n    const data = [{ x: 'North', y: 8 }, { x: 'East', y: 5 }, { x: 'South', y: 3 }];\n    const options = { x: 'x', y: 'y', data };\n    expect(aligned(options, { kind: 'bar', zoom: ['East', 'South'] }).view.xDomain).toEqual([0, 2]);\n    expect(aligned(options, { kind: 'line', compact: true, zoom: ['East', 'South'] }).view.xDomain).toEqual([0, 2]);\n  });\n\n  it('widens draw slots to the nearest joinable values and spans a view between observations', () => {\n    const data = Array.from({ length: 9 }, (_, x) => ({ x, y: 2, s: 'dense' }));\n    for (const x of [0, 2, 4, 5, 8]) data.push({ x, y: 10, s: 'sparse' });\n    const { frame, view } = aligned({ x: 'x', y: 'y', series: 's', data }, { kind: 'line', zoom: [3, 5] });\n    expect(frame.series[1]!.slot[3]).toBe(SLOT_NO_ROW);\n    expect(view.visibleSlots).toEqual({ start: 3, end: 6 });\n    expect(view.drawSlots).toEqual([{ start: 2, end: 7 }, { start: 2, end: 9 }]);\n    const between = buildView(frame, { kind: 'line', zoom: [6, 7] }, new DiagnosticCollector());\n    expect(between.visibleSlots).toEqual({ start: 6, end: 8 });\n    expect(between.drawSlots[1]).toEqual({ start: 5, end: 9 });\n  });\n\n  it('stops draw ranges at an explicit null or an expected step', () => {\n    const { frame, view } = aligned({\n      x: { field: 'x', type: 'date' }, y: 'y',\n      data: [1, 2, 3, 5, 6, 7].map(day => ({ x: '2026-03-0' + day, y: day === 6 ? null : day })),\n    }, { kind: 'line', zoom: ['2026-03-05', '2026-03-05'] });\n    expect(frame.series[0]!.slot[3]).toBe(SLOT_GAP);\n    expect(frame.series[0]!.slot[5]).toBe(SLOT_NULL);\n    expect(view.visibleSlots).toEqual({ start: 4, end: 5 });\n    expect(view.drawSlots).toEqual([{ start: 4, end: 5 }]);\n    const empty = buildView(frame, { kind: 'line', zoom: ['2026-03-04', '2026-03-04'] }, new DiagnosticCollector());\n    expect(empty.drawSlots).toEqual([{ start: 3, end: 4 }]);\n  });\n\n  it('ignores hidden, non-drawable and out-of-zoom values when fitting the y axis', () => {\n    const data = [\n      { x: 0, y: 99, s: 'valid' }, { x: 1, y: 1, s: 'valid' }, { x: 2, y: 3, s: 'valid' },\n      { x: 1, y: 100, s: 'hidden' }, { x: 1, y: 400, s: 'duplicate' }, { x: 1, y: 600, s: 'duplicate' },\n    ];\n    const { frame, view } = aligned({ x: 'x', y: 'y', series: 's', data },\n      { kind: 'line', hidden: new Set(['hidden']), zoom: [1, 2] });\n    expect(frame.series[2]!.drawable).toBe(false);\n    expect(view.visible).toEqual([true, false, false]);\n    expect(view.yDomain).toEqual([1, 3]);\n  });\n\n  it.each(['bar', 'area'] as const)('widens %s author domains to zero and reports AX110', kind => {\n    const options = { x: 'x', y: 'y', data: [{ x: 1, y: 82 }, { x: 2, y: 97 }] };\n    const { view, diagnostics } = aligned(options, { kind, valueDomain: [80, 100] });\n    expect(view.yDomain).toEqual([0, 100]);\n    expect(diagnostics.inputs()).toEqual([\n      expect.objectContaining({ code: 'AX110', field: 'y', level: 'warning', origin: 'call' }),\n    ]);\n    expect(aligned({\n      ...options, data: [{ x: 1, y: -9 }, { x: 2, y: -8 }],\n    }, { kind, valueDomain: [-10, -5] }).view.yDomain).toEqual([-10, 0]);\n  });\n\n  it('rounds a small maximum normally and includes full scale only above the percent threshold', () => {\n    const options = (a: number, b: number) => ({\n      x: 'x', y: { field: 'y', scale: 'percent' }, data: [{ x: 1, y: a }, { x: 2, y: b }],\n    });\n    expect(aligned(options(2, 4), { kind: 'bar' }).view.yDomain).toEqual([0, 4]);\n    expect(aligned(options(82, 94), { kind: 'bar' }).view.yDomain).toEqual([0, 100]);\n  });\n\n  it('resolves references against the frame kind and includes value bands and lines in the domain', () => {\n    const { view, diagnostics } = aligned({\n      x: 'x', y: 'y', data: [{ x: '2026-02', y: 2 }, { x: '2026-03', y: 5 }],\n    }, { kind: 'line', references: [\n      { x: ['2026-03', '2026-02'], y: [-5, -10], label: 'Range' },\n      { y: 20, label: 'Goal' },\n      { x: '2026-02-30', label: 'Invalid' },\n    ] });\n    expect(view.references).toEqual([\n      { axis: 'x', from: Date.UTC(2026, 1, 1), to: Date.UTC(2026, 2, 1), label: 'Range' },\n      { axis: 'y', from: -10, to: -5, label: 'Range' },\n      { axis: 'y', from: 20, to: 20, label: 'Goal' },\n    ]);\n    expect(view.yDomain).toEqual([-10, 20]);\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX107', field: 'reference[2].x' })]);\n  });\n\n  it('matches the normalization rules for instants, wall times and category names', () => {\n    const instant = aligned({\n      x: { field: 'x', type: 'time' }, y: 'y', data: [{ x: '2026-02-24T05:00:00-05:00', y: 3 }],\n    }, { kind: 'line', references: [{ x: new Date('2026-02-24T10:00:00Z'), label: 'Instant' }] }).view;\n    expect(instant.references[0]!.from).toBe(instant.frame.x.values[0]);\n    const wall = aligned({\n      x: 'x', y: 'y', data: [{ x: '2026-02-24T05:00:00', y: 3 }],\n    }, { kind: 'line', references: [{ x: '2026-02-24T05:00:00', label: 'Wall time' }] }).view;\n    expect(wall.references[0]!.from).toBe(Date.UTC(2026, 1, 24, 5));\n    const category = aligned({\n      x: 'x', y: 'y', data: [{ x: 'North', y: 3 }, { x: 'South', y: 4 }],\n    }, { kind: 'line', references: [{ x: 'South', label: 'Region' }] }).view;\n    expect(category.references[0]!.from).toBe(1);\n  });\n\n  it('reports a band whose equal bounds cannot be distinguished from a line', () => {\n    const { view, diagnostics } = aligned({ x: 'x', y: 'y', data: [{ x: 1, y: 4 }] }, {\n      kind: 'line', references: [{ x: [1, 1], label: 'Band' }, { x: 1, label: 'Line' }],\n    });\n    expect(view.references).toEqual([{ axis: 'x', from: 1, to: 1, label: 'Line' }]);\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX150', field: 'reference[0].x' })]);\n  });\n\n  it('keeps scatter ranges per series and uses only the points inside zoom for the value domain', () => {\n    const { view } = scatter({ x: 'x', y: 'y', series: 's', data: [\n      { x: 3, y: 100, s: 'a' }, { x: 1, y: 2, s: 'a' }, { x: 0, y: 6, s: 'b' }, { x: 2, y: 4, s: 'b' },\n      { x: 2, y: 1000, s: 'hidden' },\n    ] }, { hidden: new Set(['hidden']), zoom: [1, 2] });\n    expect(view.xFull).toEqual([0, 3]);\n    expect(view.visible).toEqual([true, true, false]);\n    expect(view.visiblePoints).toEqual([{ start: 0, end: 1 }, { start: 1, end: 2 }, { start: 0, end: 1 }]);\n    expect(view.yDomain).toEqual([2, 4]);\n  });\n});\n\ndescribe('stacks and series cues', () => {\n  it('accumulates on separate sides in series order and marks an incomplete stack', () => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'hidden', 'b', 'c'], data: [\n        { x: 0, a: 3, hidden: 800, b: -2, c: 1 },\n        { x: 1, a: -5, hidden: 800, b: 3, c: -1 },\n        { x: 2, a: null, hidden: 800, b: -3, c: 0 },\n      ],\n    }, { kind: 'area', stacked: true, hidden: new Set(['hidden']) });\n    expect(view.stack).toEqual({\n      order: [0, 2, 3],\n      positive: [Float64Array.of(3, 0, 0), Float64Array.of(3, 3, 0), Float64Array.of(4, 3, 0)],\n      negative: [Float64Array.of(0, -5, 0), Float64Array.of(-2, -5, -3), Float64Array.of(-2, -6, -3)],\n      incomplete: Uint8Array.of(0, 0, 1),\n    });\n    expect(view.yDomain).toEqual([-6, 4]);\n  });\n\n  it('reuses a view for identical inputs and its unchanged stack and cues across zooms', () => {\n    const { frame, view } = aligned({\n      x: 'x', y: ['a', 'b'], data: [{ x: '0', a: 3, b: -2 }, { x: '1', a: 2, b: -4 }],\n    }, { kind: 'area', stacked: true });\n    const sink = new DiagnosticCollector();\n    const same = buildView(frame, { kind: 'area', stacked: true, previous: view }, sink);\n    const zoomed = buildView(frame, { kind: 'area', stacked: true, zoom: ['1', '1'], previous: same }, sink);\n    expect(same).toBe(view);\n    expect(zoomed.frame).toBe(frame);\n    expect(zoomed.stack).toBe(view.stack);\n    expect(zoomed.cues).toBe(view.cues);\n    expect(zoomed.visibleSlots).toEqual({ start: 1, end: 2 });\n    expect(view.stack!.incomplete).toBeNull();\n  });\n\n  it('assigns a unique normal color/dash pair to each of 12 series and warns once', () => {\n    const y = Array.from({ length: 12 }, (_, i) => 'value' + i);\n    const { view, diagnostics } = aligned({\n      x: 'x', y, data: [{ x: 1, ...Object.fromEntries(y.map((name, i) => [name, i])) }],\n    }, { kind: 'line' });\n    expect(view.cues.slice(0, 8).map(cue => cue.marker)).toEqual([\n      'circle', 'square', 'triangle', 'diamond', 'cross', 'plus', 'triangle-down', 'star',\n    ]);\n    expect(view.cues.slice(0, 8).every(cue => cue.dash.normal === null)).toBe(true);\n    const identities = view.cues.map((cue, i) => JSON.stringify([i % 8, cue.dash.normal]));\n    expect(new Set(identities).size).toBe(12);\n    expect(new Set(view.cues.map(cue => JSON.stringify(cue.dash.contrast))).size).toBe(12);\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX130', level: 'warning' })]);\n  });\n\n  it('gives compact series distinct normal dashes and raises AX131', () => {\n    const { view, diagnostics } = aligned({\n      x: 'x', y: ['a', 'b'], data: [{ x: 1, a: 4, b: 8 }],\n    }, { kind: 'line', compact: true });\n    expect(view.cues[0]!.dash.normal).toBeNull();\n    expect(view.cues[1]!.dash.normal).not.toBeNull();\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX131', level: 'hint' })]);\n  });\n\n  it('keeps every cumulative total on its own side of zero for arbitrary signed values', () => {\n    const value = fc.option(fc.integer({ min: -300, max: 300 }), { nil: null });\n    fc.assert(fc.property(fc.array(fc.tuple(value, value, value), { minLength: 1, maxLength: 20 }), values => {\n      const data = values.map(([a, b, c], x) => ({ x, a, b, c }));\n      const { view } = aligned({ x: 'x', y: ['a', 'b', 'c'], data }, { kind: 'bar', stacked: true });\n      const stack = view.stack!;\n      for (let i = 0; i < values.length; i++) {\n        const row = values[i]!;\n        expect(stack.incomplete?.[i] ?? 0).toBe(row.includes(null) ? 1 : 0);\n        for (let k = 0; k < row.length; k++) {\n          const sum = row.slice(0, k + 1).reduce<number>((total, value) => total + Math.max(0, value ?? 0), 0);\n          const debt = row.slice(0, k + 1).reduce<number>((total, value) => total + Math.min(0, value ?? 0), 0);\n          expect(stack.positive[k]![i]).toBe(sum);\n          expect(stack.negative[k]![i]).toBe(debt);\n          expect(view.yDomain[0]).toBeLessThanOrEqual(debt);\n          expect(view.yDomain[1]).toBeGreaterThanOrEqual(sum);\n        }\n      }\n    }));\n  });\n});\n\ndescribe('donut slices', () => {\n  it('places the parts fixture clockwise in its given order from twelve o’clock', () => {\n    const labels = ['Chrome', 'Safari', 'Edge', 'Firefox', 'Samsung Internet', 'Other'];\n    const values = [46.2, 27.5, 14.1, 8.9, 2.1, 1.2];\n    const endpoints = [0, 46.2, 73.7, 87.8, 96.7, 98.8, 100];\n    const { view } = donut(labels.map((label, i) => ({ label, value: values[i]! })));\n    expect(view.slices.map(slice => slice.label)).toEqual(labels);\n    expect(view.total).toBeCloseTo(100);\n    for (let i = 0; i < labels.length; i++) {\n      const slice = view.slices[i]!;\n      expect(slice.members).toEqual([i]);\n      expect(slice.ratio).toBeCloseTo(values[i]! / 100, 12);\n      expect(slice.angles![0]).toBeCloseTo(endpoints[i]! * Math.PI / 50, 12);\n      expect(slice.angles![1]).toBeCloseTo(endpoints[i + 1]! * Math.PI / 50, 12);\n    }\n  });\n\n  it('lists zero and null entries with no arcs and leaves an all-zero ring empty', () => {\n    const entries = [{ label: 'Zero', value: 0 }, { label: 'Missing', value: null }, { label: 'Positive', value: 5 }];\n    const { view } = donut(entries);\n    expect(view.slices).toEqual([\n      { key: 'Zero', label: 'Zero', members: [0], value: 0, ratio: 0, angles: null },\n      { key: 'Missing', label: 'Missing', members: [1], value: null, ratio: null, angles: null },\n      { key: 'Positive', label: 'Positive', members: [2], value: 5, ratio: 1, angles: [0, 2 * Math.PI] },\n    ]);\n    const empty = donut(entries.slice(0, 2)).view;\n    expect(empty.total).toBe(0);\n    expect(empty.slices.every(slice => slice.angles === null)).toBe(true);\n  });\n\n  it('keeps the seven largest in original order, favoring the first tie at the cutoff', () => {\n    const values = [2, 10, 6, 8, 4, 4, 1, 9, 5, 7];\n    const { view, diagnostics } = donut(values.map((value, i) => ({ label: 'Category ' + i, value })),\n      { otherLabel: count => count + ' remaining' });\n    expect(view.total).toBe(56);\n    expect(view.slices.map(slice => slice.members)).toEqual([[1], [2], [3], [4], [7], [8], [9], [0, 5, 6]]);\n    expect(view.slices[7]).toEqual({\n      key: '__other__', label: '3 remaining', members: [0, 5, 6], value: 7, ratio: 1 / 8,\n      angles: [expect.closeTo(7 * Math.PI / 4, 12), 2 * Math.PI],\n    });\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX121', level: 'warning', count: 3 })]);\n  });\n\n  it('counts positive entries for grouping and does not render a partially negative ring', () => {\n    const data = Array.from({ length: 10 }, (_, i) => ({ label: 'Part ' + i, value: i === 0 ? null : i - 1 }));\n    const valid = donut(data);\n    expect(valid.view.slices).toHaveLength(10);\n    expect(valid.diagnostics.inputs()).toEqual([]);\n    const invalid = donut([...data, { label: 'Negative', value: -1 }]);\n    expect(invalid.view.slices).toEqual([]);\n    expect(invalid.diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX120', level: 'error' })]);\n  });\n\n  it('reserves the grouped slice key even if a category has that name', () => {\n    const { view } = donut(Array.from({ length: 9 }, (_, i) => ({ label: i === 0 ? '__other__' : 'Part ' + i, value: 1 })));\n    expect(view.slices[0]!.label).toBe('__other__');\n    expect(new Set(view.slices.map(slice => slice.key)).size).toBe(8);\n    expect(view.slices.at(-1)!.key).toBe('__other__');\n  });\n});\nimport fc from 'fast-check';\nimport { describe, expect, it } from 'vitest';\nimport type { Layout, Mark, Projection, Rect, Tick, View } from '../../src/core/contracts';\nimport { buildScene } from '../../src/scene';\nimport { bandScale, linearScale } from '../../src/scale';\nimport { aligned, donut, scatter } from '../view/fixtures';\n\nconst clip: Rect = { x: 10, y: 20, width: 140, height: 100 };\nconst tick = (value: number): Tick => ({ value, label: String(value) });\nconst fit = { remedies: [], hidden: 0 };\nconst dpr = 1;\n\nfunction layout(view: View, plot = clip, compact = false, padding = 0): Layout {\n  const across = [plot.x, plot.x + plot.width] as const;\n  const up = [plot.y + plot.height, plot.y] as const;\n  let projection: Projection;\n  if (view.kind === 'donut') {\n    projection = {\n      kind: 'ring', cx: plot.x + plot.width / 2, cy: plot.y + plot.height / 2,\n      r0: Math.min(plot.width, plot.height) * 0.3, r1: Math.min(plot.width, plot.height) / 2,\n    };\n  } else if (view.kind === 'bar') {\n    const range = view.horizontal ? up : across;\n    projection = {\n      kind: 'bands', horizontal: view.horizontal,\n      band: view.frame.x.kind === 'category' ? bandScale(view.frame.length, range, padding) : linearScale(view.xDomain, range),\n      value: linearScale(view.yDomain, view.horizontal ? across : up),\n    };\n  } else {\n    projection = {\n      kind: 'xy',\n      x: view.kind !== 'scatter' && view.frame.x.kind === 'category'\n        ? bandScale(view.frame.length, across, padding) : linearScale(view.xDomain, across),\n      y: linearScale(view.yDomain, up),\n    };\n  }\n\n  const size = { width: plot.x + plot.width + 10, height: plot.y + plot.height + 10, plot, projection };\n  if (compact) return { ...size, kind: 'compact' };\n  return {\n    ...size, kind: 'plot', xTicks: view.kind === 'donut' ? [] : view.xDomain.map(tick),\n    yTicks: view.kind === 'donut' ? [] : view.yDomain.map(tick), texts: [], fit: { x: fit, y: fit },\n  };\n}\n\nfunction marksOf<T extends Mark['type']>(marks: readonly Mark[], type: T): Extract<Mark, { type: T }>[] {\n  return marks.filter((mark): mark is Extract<Mark, { type: T }> => mark.type === type);\n}\n\nfunction line(values: readonly (number | null)[], compact = false) {\n  return aligned({ x: 'x', y: 'y', data: values.map((y, x) => ({ x, y })) },\n    { kind: 'line', compact, valueDomain: [0, 10] }).view;\n}\n\ndescribe('line and area geometry', () => {\n  it('packs the exact projected vertices and a pen lift, and shows the isolated value', () => {\n    const view = line([1, 2, null, 3, null, 4, 5, 6]);\n    const scene = buildScene(view, layout(view), dpr);\n    const [path] = marksOf(scene.marks, 'path');\n    expect(path).toEqual({\n      type: 'path', series: 0, xy: Float32Array.of(10, 110, 30, 100, NaN, NaN, 110, 80, 130, 70, 150, 60),\n      stroke: { kind: 'series', index: 0 }, strokeWidth: 2, dash: view.cues[0]!.dash,\n    });\n    expect(marksOf(scene.marks, 'points')).toEqual([{\n      type: 'points', series: 0, xy: Float32Array.of(10, 110, 30, 100, 70, 90, 110, 80, 130, 70, 150, 60),\n      shape: 'circle', size: 6, fill: { kind: 'series', index: 0 },\n    }]);\n    expect(scene.clip).toBe(clip);\n  });\n\n  it('keeps the joined neighbours past the zoom edges and puts identity markers inside the view', () => {\n    const { view } = aligned({ x: 'x', y: 'y', data: [0, 1, 2, 3, 4, 5].map(x => ({ x, y: x + 1 })) },\n      { kind: 'line', zoom: [1.5, 3.5], valueDomain: [0, 10] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    expect(marksOf(marks, 'path')[0]!.xy).toEqual(Float32Array.of(-25, 100, 45, 90, 115, 80, 185, 70));\n    expect(marksOf(marks, 'points')[0]!.xy).toEqual(Float32Array.of(45, 90, 115, 80));\n  });\n\n  it('uses a zero baseline for an unstacked area backed by a borrowed Float32 column', () => {\n    const x = Float64Array.of(0, 1, 2);\n    const y = Float32Array.of(2, -4, 6);\n    const { view } = aligned({ data: { columns: { x, y } }, x: 'x', y: 'y' },\n      { kind: 'area', valueDomain: [-5, 5] });\n    expect(view.frame.series[0]!.y).toBe(y);\n    const { marks } = buildScene(view, layout(view), dpr);\n    const [area] = marksOf(marks, 'area');\n    expect(area).toMatchObject({\n      opacity: 0.25, upper: Float32Array.of(10, 50, 80, 110, 150, 10),\n      lower: Float32Array.of(10, 70, 80, 70, 150, 70), runs: Uint32Array.of(0, 3, 0, 3),\n    });\n    expect(marksOf(marks, 'path')[0]!.strokeWidth).toBe(2);\n  });\n\n  it('shares exact packed boundaries between adjacent stacked areas on both sides of zero', () => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'b', 'c'], data: [\n        { x: 0, a: 2, b: 3, c: -2 }, { x: 1, a: -4, b: -1, c: 3 }, { x: 2, a: 2, b: null, c: 5 },\n      ],\n    }, { kind: 'area', stacked: true, valueDomain: [-10, 10] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const areas = marksOf(marks, 'area');\n    expect(areas).toHaveLength(3);\n    expect(areas[0]!.upper).toBe(areas[1]!.lower);\n    expect(areas[1]!.upper).toBe(areas[2]!.lower);\n    expect(areas[1]!.opacity).toBe(0.8);\n    expect(areas[1]!.upper).toEqual(Float32Array.of(10, 45, 80, 70, 150, 60, 10, 70, 80, 95, 150, 70));\n    expect(areas[1]!.runs).toEqual(Uint32Array.of(0, 3, 0, 3, 3, 3, 3, 3));\n    const paths = marksOf(marks, 'path').filter(mark => mark.stroke.kind === 'series');\n    expect(paths[1]!.xy).toEqual(Float32Array.of(10, 45, 80, 95));\n  });\n\n  it.each([1, 2])('retains the actual extrema in sampled columns of 100,000 points at DPR %s', ratio => {\n    const count = 100_000;\n    const x = Float64Array.from({ length: count }, (_, i) => i + 0.5);\n    const y = Float64Array.from({ length: count }, (_, i) => i % 101 - 50);\n    const { view } = aligned({ x: 'x', y: 'y', data: { columns: { x, y } } },\n      { kind: 'line', xDomain: [0, count], valueDomain: [-50, 50] });\n    const scene = buildScene(view, layout(view, { x: 0, y: 0, width: 200, height: 100 }), ratio);\n    const path = marksOf(scene.marks, 'path')[0]!;\n    expect(path.xy.length / 2).toBeLessThanOrEqual(4 * 200 * ratio);\n\n    const samplesPerColumn = count / (200 * ratio);\n    for (const column of [0, 1, 83, 137, 200 * ratio - 1]) {\n      const source = y.subarray(column * samplesPerColumn, (column + 1) * samplesPerColumn);\n      const drawn: number[] = [];\n      for (let i = 0; i < path.xy.length; i += 2) {\n        if (Math.floor(path.xy[i]! * ratio) === column) drawn.push(path.xy[i + 1]!);\n      }\n      expect(Math.min(...drawn)).toBe(50 - Math.max(...source));\n      expect(Math.max(...drawn)).toBe(50 - Math.min(...source));\n    }\n    const markers = marksOf(scene.marks, 'points')[0]!;\n    expect(markers.xy.length / 2).toBe(3);\n    expect(markers.xy.at(-2)).toBeCloseTo(199.999, 4);\n    expect(markers.xy.at(-1)).toBe(50 - y[count - 1]!);\n    for (let i = 0; i < markers.xy.length; i += 2) {\n      const index = Math.round(markers.xy[i]! * 500 - 0.5);\n      expect(markers.xy[i + 1]).toBe(50 - y[index]!);\n    }\n  });\n\n  it('draws compact paths without axes, references, or regular markers but keeps isolated points', () => {\n    const view = line([2, 4, 6], true);\n    const { marks } = buildScene({\n      ...view, references: [{ axis: 'y', from: 2, to: 2, label: 'Reference' }],\n    }, layout(view, clip, true), dpr);\n    expect(marks.map(mark => mark.type)).toEqual(['path']);\n    const isolated = line([null, 4, null], true);\n    const isolatedScene = buildScene(isolated, layout(isolated, clip, true), dpr);\n    expect(marksOf(isolatedScene.marks, 'points')[0]!.xy).toEqual(Float32Array.of(80, 80));\n  });\n});\n\ndescribe('bar geometry', () => {\n  it('uses projected zero as the baseline and represents missing and zero bars separately', () => {\n    const { view } = aligned({\n      x: 'x', y: 'y', data: [{ x: 'A', y: 4 }, { x: 'B', y: null }, { x: 'C', y: 0 }],\n    }, { kind: 'bar', valueDomain: [0, 10] });\n    const scene = buildScene(view, layout(view, { ...clip, width: 120 }), dpr);\n    expect(marksOf(scene.marks, 'rects')).toEqual([\n      { type: 'rects', variant: 'bar', series: 0, xywh: Float32Array.of(10, 80, 40, 40, 90, 120, 40, 0),\n        fill: { kind: 'series', index: 0 } },\n      { type: 'rects', variant: 'missing', series: 0, xywh: Float32Array.of(50, 120, 40, 0),\n        fill: { kind: 'token', name: 'muted' } },\n    ]);\n  });\n\n  it.each([false, true])('keeps both grouped bars in their band without overlap, horizontal %s', horizontal => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'b'], data: [{ x: 'A', a: 2, b: 3 }, { x: 'B', a: 4, b: 5 }],\n    }, { kind: 'bar', horizontal, valueDomain: [0, 10] });\n    const scene = buildScene(view, layout(view, clip, false, 0.25), dpr);\n    const [a, b] = marksOf(scene.marks, 'rects');\n    const dimension = horizontal ? clip.height : clip.width;\n    const step = dimension / 2.25;\n    const band = 0.75 * step;\n    const axis = horizontal ? 1 : 0;\n    for (let i = 0; i < 2; i++) {\n      const start = horizontal\n        ? clip.y + clip.height - (i + 0.25) * step - band : clip.x + (i + 0.25) * step;\n      expect(a!.xywh[4 * i + axis]).toBeCloseTo(start, 4);\n      expect(a!.xywh[4 * i + axis + 2]).toBeCloseTo(band / 2, 4);\n      expect(b!.xywh[4 * i + axis]).toBeCloseTo(start + band / 2, 4);\n      expect(b!.xywh[4 * i + axis + 2]).toBeCloseTo(band / 2, 4);\n    }\n  });\n\n  it('places mixed-sign stacks on their own sides with separation between filled segments', () => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'b', 'c', 'd'], data: [{ x: 'A', a: 3, b: -2, c: 4, d: -5 }],\n    }, { kind: 'bar', stacked: true, valueDomain: [-10, 10] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const bars = marksOf(marks, 'rects');\n    expect(bars.map(bar => Array.from(bar.xywh))).toEqual([\n      [10, 55, 140, 15], [10, 71, 140, 9], [10, 35, 140, 19], [10, 81, 140, 24],\n    ]);\n  });\n\n  it('draws every subpixel band with at least a CSS pixel of width', () => {\n    const { view } = aligned({\n      x: 'x', y: 'y', data: Array.from({ length: 250 }, (_, i) => ({ x: 'Category ' + i, y: 4 })),\n    }, { kind: 'bar' });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const [bar] = marksOf(marks, 'rects');\n    expect(bar!.xywh).toHaveLength(1000);\n    expect(bar!.xywh.every((value, i) => i % 4 !== 2 || value >= 1)).toBe(true);\n  });\n});\n\ndescribe('chart decorations and other projections', () => {\n  it('orders clipped reference bands, the value grid, data, axes, and reference rules', () => {\n    const view = line([2, 4, 6]);\n    const augmented = { ...view, references: [\n      { axis: 'x' as const, from: -1, to: 1, label: 'Range' },\n      { axis: 'y' as const, from: 5, to: 5, label: 'Goal' },\n      { axis: 'x' as const, from: 3, to: 3, label: 'Outside' },\n    ] };\n    const { marks } = buildScene(augmented, layout(augmented), dpr);\n    expect(marks.map(mark => mark.type === 'rule' ? mark.role : mark.type)).toEqual([\n      'band', 'grid', 'grid', 'path', 'points', 'axis', 'axis', 'tick', 'tick', 'tick', 'tick', 'reference',\n    ]);\n    expect(marks[0]).toEqual({\n      type: 'band', box: { ...clip, width: 70 }, fill: { kind: 'token', name: 'reference' }, opacity: 0.12,\n    });\n    expect(marks[1]).toMatchObject({ stroke: { kind: 'token', name: 'grid' }, x1: 10, y1: 120, x2: 150, y2: 120 });\n    expect(marks.at(-1)).toMatchObject({ stroke: { kind: 'token', name: 'reference' }, x1: 10, y1: 70, x2: 150, y2: 70 });\n  });\n\n  it('swaps the grid and reference axes for horizontal bars', () => {\n    const { view } = aligned({ x: 'x', y: 'y', data: [{ x: 'A', y: 4 }, { x: 'B', y: 7 }] }, {\n      kind: 'bar', horizontal: true, valueDomain: [0, 10], references: [{ x: 'B', label: 'Category' }, { y: 5, label: 'Target' }],\n    });\n    const rules = marksOf(buildScene(view, layout(view), dpr).marks, 'rule');\n    expect(rules.filter(mark => mark.role === 'grid')).toMatchObject([\n      { x1: 10, y1: 20, x2: 10, y2: 120 }, { x1: 150, y1: 20, x2: 150, y2: 120 },\n    ]);\n    expect(rules.filter(mark => mark.role === 'reference')).toMatchObject([\n      { x1: 10, y1: 45, x2: 150, y2: 45 }, { x1: 80, y1: 20, x2: 80, y2: 120 },\n    ]);\n  });\n\n  it('draws scatter points in series shapes, excluding hidden and out-of-zoom points', () => {\n    const { view } = scatter({ x: 'x', y: 'y', series: 's', data: [\n      { x: 0, y: 7, s: 'a' }, { x: 2, y: 3, s: 'a' }, { x: 3, y: 6, s: 'b' },\n      { x: 4, y: 5, s: 'b' }, { x: 2, y: 2, s: 'hidden' },\n    ] }, { zoom: [1, 3], valueDomain: [0, 10], hidden: new Set(['hidden']) });\n    const { marks } = buildScene(view, layout(view), dpr);\n    expect(marksOf(marks, 'points')).toEqual([\n      { type: 'points', series: 0, xy: Float32Array.of(80, 90), shape: 'circle', size: 6, fill: { kind: 'series', index: 0 } },\n      { type: 'points', series: 1, xy: Float32Array.of(150, 60), shape: 'square', size: 6, fill: { kind: 'series', index: 1 } },\n    ]);\n  });\n\n  it('uses the slice palette slots and a muted Other with a one-pixel gap', () => {\n    const { view } = donut(Array.from({ length: 10 }, (_, i) => ({ label: 'Part ' + i, value: i })));\n    const { marks } = buildScene(view, layout(view), dpr);\n    expect(marks).toHaveLength(1);\n    const [ring] = marksOf(marks, 'arcs');\n    expect(ring).toMatchObject({\n      cx: 80, cy: 70, r0: 30, r1: 50, gap: 1,\n      fills: [\n        ...Array.from({ length: 7 }, (_, i) => ({ kind: 'series', index: i + 1 })),\n        { kind: 'token', name: 'muted' },\n      ],\n    });\n    expect(ring!.angles).toHaveLength(16);\n    expect(ring!.angles[0]).toBe(0);\n    expect(ring!.angles.at(-1)).toBeCloseTo(2 * Math.PI, 6);\n  });\n\n  it('returns correctly sized empty scenes for non-drawing layouts and empty rings', () => {\n    const view = line([2, 4]);\n    for (const kind of ['too-small', 'unmeasured'] as const) {\n      expect(buildScene(view, { kind, width: 48, height: 24 }, dpr)).toEqual({\n        width: 48, height: 24, clip: { x: 0, y: 0, width: 48, height: 24 }, marks: [],\n      });\n    }\n    const empty = donut([{ label: 'Zero', value: 0 }]).view;\n    expect(buildScene(empty, layout(empty), dpr).marks).toEqual([]);\n  });\n});\n\nfunction expectPoint(x: number, y: number, plot: Rect, stroke = 0): void {\n  const margin = stroke + 0.0001;\n  expect(Number.isFinite(x) && Number.isFinite(y)).toBe(true);\n  expect(x).toBeGreaterThanOrEqual(plot.x - margin);\n  expect(x).toBeLessThanOrEqual(plot.x + plot.width + margin);\n  expect(y).toBeGreaterThanOrEqual(plot.y - margin);\n  expect(y).toBeLessThanOrEqual(plot.y + plot.height + margin);\n}\n\nfunction expectPacked(xy: Float32Array, plot: Rect, stroke?: number): void {\n  for (let i = 0; i < xy.length; i += 2) {\n    const x = xy[i]!;\n    const y = xy[i + 1]!;\n    if (stroke !== undefined && Number.isNaN(x)) expect(Number.isNaN(y)).toBe(true);\n    else expectPoint(x, y, plot, stroke);\n  }\n}\n\nfunction expectBox(x: number, y: number, width: number, height: number, plot: Rect): void {\n  expect(width).toBeGreaterThanOrEqual(0);\n  expect(height).toBeGreaterThanOrEqual(0);\n  expectPoint(x, y, plot);\n  expectPoint(x + width, y + height, plot);\n}\n\nfunction expectWithinClip(mark: Mark, plot: Rect): void {\n  switch (mark.type) {\n    case 'rule':\n      if (mark.role === 'axis' || mark.role === 'tick') {\n        expect([mark.x1, mark.y1, mark.x2, mark.y2].every(Number.isFinite)).toBe(true);\n      } else {\n        expectPoint(mark.x1, mark.y1, plot, mark.strokeWidth);\n        expectPoint(mark.x2, mark.y2, plot, mark.strokeWidth);\n      }\n      break;\n    case 'path': expectPacked(mark.xy, plot, mark.strokeWidth); break;\n    case 'points': expectPacked(mark.xy, plot); break;\n    case 'area':\n      expectPacked(mark.upper, plot);\n      expectPacked(mark.lower, plot);\n      for (let i = 0; i < mark.runs.length; i += 4) {\n        expect((mark.runs[i]! + mark.runs[i + 1]!) * 2).toBeLessThanOrEqual(mark.upper.length);\n        expect((mark.runs[i + 2]! + mark.runs[i + 3]!) * 2).toBeLessThanOrEqual(mark.lower.length);\n      }\n      break;\n    case 'rects':\n      for (let i = 0; i < mark.xywh.length; i += 4) {\n        expectBox(mark.xywh[i]!, mark.xywh[i + 1]!, mark.xywh[i + 2]!, mark.xywh[i + 3]!, plot);\n      }\n      break;\n    case 'band': expectBox(mark.box.x, mark.box.y, mark.box.width, mark.box.height, plot); break;\n    case 'arcs':\n      expectPoint(mark.cx - mark.r1, mark.cy - mark.r1, plot);\n      expectPoint(mark.cx + mark.r1, mark.cy + mark.r1, plot);\n      expect(Number.isFinite(mark.r0) && mark.angles.every(Number.isFinite)).toBe(true);\n      break;\n  }\n}\n\nit('keeps generated mark coordinates finite and clipped, with non-negative rectangle sizes', () => {\n  const value = fc.option(fc.integer({ min: -500, max: 500 }), { nil: null });\n  const values = fc.array(fc.tuple(value, value), { minLength: 1, maxLength: 18 });\n  const kind = fc.constantFrom('line', 'area', 'bar', 'scatter', 'donut');\n  const size = fc.integer({ min: 1, max: 200 });\n  fc.assert(fc.property(kind, values, size, size, fc.boolean(), fc.boolean(), (chart, rows, width, height, flag, compact) => {\n    const plot = { x: 12.25, y: 16.5, width, height };\n    const references = [{ y: [-15, 15] as const, label: 'Range' }, { y: 17, label: 'Goal' }];\n    let view: View;\n    if (chart === 'donut') {\n      view = donut(rows.map(([value], i) => ({ label: 'Part ' + i, value: value === null ? null : Math.abs(value) }))).view;\n    } else if (chart === 'scatter') {\n      view = scatter({ x: 'x', y: 'y', data: rows.map(([y], x) => ({ x, y })) }, { references }).view;\n    } else {\n      const data = rows.map(([a, b], x) => ({ x: chart === 'bar' ? 'Band ' + x : x, a, b }));\n      view = aligned({ x: 'x', y: ['a', 'b'], data }, {\n        kind: chart, stacked: flag, horizontal: flag, compact, references,\n      }).view;\n    }\n    const scene = buildScene(view, layout(view, plot, view.kind !== 'donut' && view.compact, 0.2), flag ? 2 : 1);\n    expect(scene.clip).toBe(plot);\n    for (const mark of scene.marks) expectWithinClip(mark, plot);\n  }), { numRuns: 200 });\n});\n","exit_code":0,"status":"completed"}}
