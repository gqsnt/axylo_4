{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,135p' packages/axylo/src/scene/areas.ts; sed -n '1,65p' packages/axylo/src/scale/linear.ts; sed -n '58,98p' packages/axylo/src/render/geometry.ts; git show HEAD:packages/axylo/src/render/geometry.ts | sed -n '1,95p'\"","aggregated_output":"import {\n  type AlignedView, type AreaMark, type IndexRange, type PathMark, type PointMark, type StackView,\n} from '../core/contracts';\nimport { buildPoints, simplifyArea, simplifyLine, type AreaBoundary, type JoinedRuns, type LineInput } from '../simplify';\nimport { seriesPaint, token } from './geometry';\nimport { addLine, type Drawing } from './lines';\n\nexport function addArea(\n  input: LineInput & Drawing, view: AlignedView, series: number, compact: boolean,\n  areas: AreaMark[], paths: PathMark[], points: PointMark[],\n): void {\n  let geometry: Pick<AreaMark, 'upper' | 'lower' | 'runs'>;\n  let selection: JoinedRuns;\n  if (input.y instanceof Float64Array) {\n    const area = simplifyArea({ ...input, upper: input.y, lower: 0 });\n    const { upper, lower, runs } = area;\n    geometry = { upper, lower, runs };\n    selection = area.upperBoundary.selection;\n  } else {\n    // The area helper takes Float64Array. A constant lower edge can share the upper selection\n    // instead of widening a borrowed Float32Array of values.\n    selection = simplifyLine(input);\n    const { indexes, breaks } = selection;\n    const runs = new Uint32Array(indexes.length ? (breaks.length + 1) * 4 : 0);\n    let start = 0;\n    for (let i = 0; i < runs.length; i += 4) {\n      const end = breaks[i / 4] ?? indexes.length;\n      runs[i] = runs[i + 2] = start;\n      runs[i + 1] = runs[i + 3] = end - start;\n      start = end;\n    }\n    geometry = { upper: buildPoints(indexes, input), lower: buildPoints(indexes, { ...input, y: 0 }), runs };\n  }\n  areas.push({ type: 'area', series, ...geometry, fill: seriesPaint(series), opacity: 0.25 });\n  addLine(input, view, series, view.visibleSlots, compact, paths, points, selection);\n}\n\nfunction boundaryIndex(boundary: AreaBoundary, slot: number): number {\n  const { indexes } = boundary.selection;\n  let start = 0;\n  let end = indexes.length;\n  while (start < end) {\n    const middle = start + Math.floor((end - start) / 2);\n    if (indexes[middle]! < slot) start = middle + 1;\n    else end = middle;\n  }\n  return start;\n}\n\nfunction addRun(\n  runs: number[], upper: AreaBoundary, lower: AreaBoundary, range: IndexRange,\n  upperOffset: number, lowerOffset: number,\n): void {\n  if (upper === lower) return;\n  const upperStart = boundaryIndex(upper, range.start);\n  const upperCount = boundaryIndex(upper, range.end) - upperStart;\n  const lowerStart = boundaryIndex(lower, range.start);\n  const lowerCount = boundaryIndex(lower, range.end) - lowerStart;\n  if (upperCount >= 2 && lowerCount >= 2) {\n    runs.push(upperStart + upperOffset, upperCount, lowerStart + lowerOffset, lowerCount);\n  }\n}\n\nfunction packEdges(positive: AreaBoundary | null, negative: AreaBoundary | null): Float32Array {\n  if (!positive) return negative!.xy;\n  if (!negative) return positive.xy;\n  const xy = new Float32Array(positive.xy.length + negative.xy.length);\n  xy.set(positive.xy);\n  xy.set(negative.xy, positive.xy.length);\n  return xy;\n}\n\nfunction addSeam(\n  paths: PathMark[], edge: AreaBoundary, range: IndexRange, series: number, width: number,\n  below: (slot: number) => boolean, above: (slot: number) => boolean,\n  changed: (slot: number) => boolean,\n): void {\n  const start = boundaryIndex(edge, range.start);\n  const end = boundaryIndex(edge, range.end);\n  if (end - start < 2) return;\n  const { indexes } = edge.selection;\n  let xy: Float32Array | undefined;\n  let count = 0;\n  let continuing = false;\n  for (let i = start + 1; i < end; i++) {\n    const a = indexes[i - 1]!;\n    const b = indexes[i]!;\n    if (!(changed(a) || changed(b)) || !(below(a) || below(b)) || !(above(a) || above(b))) {\n      continuing = false;\n      continue;\n    }\n    xy ??= new Float32Array(4 * (end - start));\n    if (!continuing) {\n      if (count) {\n        xy[count++] = NaN;\n        xy[count++] = NaN;\n      }\n      xy[count++] = edge.xy[2 * i - 2]!;\n      xy[count++] = edge.xy[2 * i - 1]!;\n    }\n    xy[count++] = edge.xy[2 * i]!;\n    xy[count++] = edge.xy[2 * i + 1]!;\n    continuing = true;\n  }\n  if (xy) paths.push({\n    type: 'path', series, xy: xy.subarray(0, count), stroke: token('background'), strokeWidth: width,\n    dash: { normal: null, contrast: null },\n  });\n}\n\nfunction extendBoundary(\n  input: Drawing & { range: IndexRange; slot: Uint8Array }, lower: AreaBoundary | null,\n  values: Float64Array, base: number, end: number,\n): AreaBoundary | null {\n  if (!lower) return null;\n  const upper = values.subarray(base, end);\n  if (upper.every((value, i) => value === lower.values[i])) return lower;\n  return simplifyArea({ ...input, upper, lower }).upperBoundary;\n}\n\nexport function addStackedAreas(\n  input: Drawing, view: AlignedView, stack: StackView, compact: boolean,\n  areas: AreaMark[], seams: PathMark[], paths: PathMark[], points: PointMark[],\n): void {\n  if (!stack.order.length) return;\n  let start = view.visibleSlots.start;\n  let end = view.visibleSlots.end;\n  for (const series of stack.order) {\n    start = Math.min(start, view.drawSlots[series]!.start);\n    end = Math.max(end, view.drawSlots[series]!.end);\n  }\n  const size = end - start;\n  const source = { ...input, x: input.x.subarray(start, end) };\n  const range = { start: 0, end: size };\n  // A missing stack component pinches to the preceding edge. Use a common set of x slots\nimport type { ContinuousScale, Tick, TickCandidates } from '../core/contracts';\nimport { MAX_TICKS, firstIndexAtOrAbove, lastIndexAtOrBelow, nextNiceStep, niceStepAtLeast, stepMultiple } from './nice';\n\n/** What a tick labeler knows about the set its value belongs to. */\nexport interface TickContext {\n  /** Distance between adjacent ticks of the set. */\n  readonly step: number;\n  /** Largest absolute tick value of the set. */\n  readonly maxAbs: number;\n}\n\n/** Writes one tick label. A plain `(value) => string` is a valid labeler. */\nexport type TickLabeler = (value: number, context: TickContext) => string;\n\nexport function linearScale(domain: readonly [number, number], range: readonly [number, number]): ContinuousScale {\n  return continuous('linear', domain, range);\n}\n\n/** Shared by linear and time scales: both are linear in their domain units (time: epoch ms). */\nexport function continuous(type: 'linear' | 'time', domain: readonly [number, number], range: readonly [number, number]): ContinuousScale {\n  const d0 = domain[0];\n  const d1 = domain[1];\n  const r0 = range[0];\n  const r1 = range[1];\n  const span = d1 - d0;\n  const extent = r1 - r0;\n  const mid = r0 / 2 + r1 / 2;\n  // A domain wider than the largest double (say [-1e308, 1e308]) is interpolated on halves, so the\n  // intermediate width never overflows.\n  const overflow = !Number.isFinite(span) && Number.isFinite(d0) && Number.isFinite(d1);\n  const halfSpan = d1 / 2 - d0 / 2;\n  let map: (v: number) => number;\n  let invert: (p: number) => number;\n  if (span === 0) map = () => mid; // a zero-width domain (one value, one instant) is drawn in the middle\n  else if (overflow) map = (v: number) => r0 + ((v / 2 - d0 / 2) / halfSpan) * extent;\n  else map = (v: number) => r0 + ((v - d0) / span) * extent;\n  if (extent === 0) invert = () => d0;\n  else if (overflow) invert = (p: number) => {\n    const f = (p - r0) / extent;\n    return d0 * (1 - f) + d1 * f;\n  };\n  else invert = (p: number) => d0 + ((p - r0) / extent) * span;\n  return { type, domain: [d0, d1], range: [r0, r1], map, invert };\n}\n\nfunction sortedDomain(domain: readonly [number, number]): [number, number] {\n  return domain[0] <= domain[1] ? [domain[0], domain[1]] : [domain[1], domain[0]];\n}\n\n/**\n * Tick sets at nice steps (1, 2, 5 × 10^k), densest first, every tick inside the domain.\n * The densest set has at most MAX_TICKS ticks; the sparsest has one.\n */\nexport function linearTickCandidates(domain: readonly [number, number], format: TickLabeler): TickCandidates {\n  const [lo, hi] = sortedDomain(domain);\n  if (!Number.isFinite(lo) || !Number.isFinite(hi)) return [];\n  // A width that no nice step can resolve (subnormal, or below the precision of the values) gets one tick.\n  // Divided before subtracting, so that [-1e308, 1e308] does not overflow.\n  const width = hi / (MAX_TICKS - 1) - lo / (MAX_TICKS - 1);\n  const tooNarrow = !(width > 1e-300) || hi - lo <= 4 * Number.EPSILON * Math.max(Math.abs(lo), Math.abs(hi));\n  if (lo === hi || tooNarrow) {\n    const v = lo === 0 ? 0 : lo;\n    return [[{ value: v, label: format(v, { step: 0, maxAbs: Math.abs(v) }) }]];\n  }\n  const sets: Tick[][] = [];\n * thinner side is the value axis. Along it the marker grows to MISSING_MIN, away from the baseline toward\n * the inside of `clip` (upwards, or downwards when zero is at the top of the plot; rightwards, or leftwards\n * when zero is at the right), so the plot clip never removes it. Along the category axis it keeps the\n * slot's own extent and never covers a neighbour. The renderers draw it hollow, with a diagonal, inset by\n * half the outline. Writes x, y, width, height of the outline path into `out`.\n */\nexport function missingBox(x: number, y: number, w: number, h: number, out: Float64Array, clip?: Box | null): void {\n  let left = w < 0 ? x + w : x;\n  let top = h < 0 ? y + h : y;\n  let width = Math.abs(w);\n  let height = Math.abs(h);\n  if (height <= width) {\n    if (height < MISSING_MIN) {\n      // Grow upwards from the baseline unless that would leave the plot; then downwards.\n      const bottom = top + height;\n      const upward = clip == null || bottom - MISSING_MIN >= clip.y - 1e-9;\n      top = upward ? bottom - MISSING_MIN : top;\n      height = MISSING_MIN;\n    }\n  } else if (width < MISSING_MIN) {\n    // Grow rightwards from the baseline unless that would leave the plot; then leftwards.\n    const rightward = clip == null || left + MISSING_MIN <= clip.x + clip.width + 1e-9;\n    left = rightward ? left : left + width - MISSING_MIN;\n    width = MISSING_MIN;\n  }\n  const inset = MISSING_STROKE / 2;\n  out[0] = left + Math.min(inset, width / 2); out[1] = top + Math.min(inset, height / 2);\n  out[2] = Math.max(0, width - MISSING_STROKE); out[3] = Math.max(0, height - MISSING_STROKE);\n}\n\n/** Result of `sector`. */\nexport const SECTOR_NONE = 0;    // nothing to draw\nexport const SECTOR_RING = 1;    // a full annulus (one slice that is the whole circle)\nexport const SECTOR_ARCS = 2;    // outer arc, then inner arc back\nexport const SECTOR_APEX = 3;    // outer arc, then one apex point (the two moved sides meet before the inner radius)\n\nconst TAU = 2 * Math.PI;\n/**\n * Spans this close to a full turn are a full turn. Angles arrive as Float32 (ArcMark.angles), whose spacing\n * near 4π is about 1e-6; 1e-4 rad is still far below a pixel of arc on any realistic ring (0.02 px at r 200).\n */\n/**\n * Geometry shared by the canvas and SVG renderers, so both draw the same picture. Pure: runs in Node.\n * Every function writes into a caller-owned scratch array instead of returning objects, so drawing\n * allocates nothing per mark element.\n */\nimport type { MarkerShape, Paint, PaintBindings, RuleMark } from '../core/contracts';\n\n/** True for NaN and ±Infinity: such a coordinate lifts the pen. */\nexport const lifted = (v: number): boolean => v - v !== 0;\n\n/** The paint's entry in a binding table (CSS expressions or concrete colors), or null for 'none'. */\nexport function paintOf(paint: Paint, table: PaintBindings): string | null {\n  if (paint.kind === 'none') return null;\n  if (paint.kind === 'token') return table.tokens[paint.name];\n  const s = table.series;\n  if (s.length === 0) return null;\n  return s[paint.index] ?? s[((paint.index % s.length) + s.length) % s.length]!;\n}\n\n/** Rules whose role is drawn outside the plot clip (the scene contract). */\nexport const unclippedRule = (role: RuleMark['role']): boolean => role === 'axis' || role === 'tick';\n\n/**\n * Snaps a horizontal or vertical rule to device pixels so a 1 px rule covers whole pixel rows and stays\n * crisp. Writes x1, y1, x2, y2 and the line width, all in CSS px, into `out`. Other rules pass through.\n */\nexport function snapRule(x1: number, y1: number, x2: number, y2: number, width: number, dpr: number, out: Float64Array): void {\n  const device = Math.max(1, Math.round(width * dpr));\n  const half = device / 2;\n  if (y1 === y2) {\n    const y = (Math.round(y1 * dpr - half) + half) / dpr;\n    out[0] = Math.round(x1 * dpr) / dpr; out[1] = y; out[2] = Math.round(x2 * dpr) / dpr; out[3] = y;\n    out[4] = device / dpr;\n  } else if (x1 === x2) {\n    const x = (Math.round(x1 * dpr - half) + half) / dpr;\n    out[0] = x; out[1] = Math.round(y1 * dpr) / dpr; out[2] = x; out[3] = Math.round(y2 * dpr) / dpr;\n    out[4] = device / dpr;\n  } else {\n    out[0] = x1; out[1] = y1; out[2] = x2; out[3] = y2; out[4] = width;\n  }\n}\n\n/** Smallest side of the \"no data\" marker, CSS px: large enough not to read as a hairline or a zero bar. */\nexport const MISSING_MIN = 6;\n/** Outline width of the \"no data\" marker, CSS px. */\nexport const MISSING_STROKE = 1.5;\n\n/**\n * Box of the \"no data\" marker of spec F2 for one 'missing' rect. The scene gives the empty slot at the\n * baseline: its band extent along the category axis and its edge on the baseline. A side thinner than\n * MISSING_MIN is grown away from the baseline (upwards for a zero height, rightwards for a zero width),\n * so the marker sits on the baseline. The renderers draw it hollow, with a diagonal, inset by half the\n * outline so the outline stays inside the box. Wr