{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"sed -n '70,420p' packages/axylo/test/scene/scene.test.ts\"","aggregated_output":"\n  it('keeps the joined neighbours past the zoom edges and puts identity markers inside the view', () => {\n    const { view } = aligned({ x: 'x', y: 'y', data: [0, 1, 2, 3, 4, 5].map(x => ({ x, y: x + 1 })) },\n      { kind: 'line', zoom: [1.5, 3.5], valueDomain: [0, 10] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    expect(marksOf(marks, 'path')[0]!.xy).toEqual(Float32Array.of(-25, 100, 45, 90, 115, 80, 185, 70));\n    expect(marksOf(marks, 'points')[0]!.xy).toEqual(Float32Array.of(45, 90, 115, 80));\n  });\n\n  it('uses a zero baseline for an unstacked area backed by a borrowed Float32 column', () => {\n    const x = Float64Array.of(0, 1, 2);\n    const y = Float32Array.of(2, -4, 6);\n    const { view } = aligned({ data: { columns: { x, y } }, x: 'x', y: 'y' },\n      { kind: 'area', valueDomain: [-5, 5] });\n    expect(view.frame.series[0]!.y).toBe(y);\n    const { marks } = buildScene(view, layout(view), dpr);\n    const [area] = marksOf(marks, 'area');\n    expect(area).toMatchObject({\n      opacity: 0.25, upper: Float32Array.of(10, 50, 80, 110, 150, 10),\n      lower: Float32Array.of(10, 70, 80, 70, 150, 70), runs: Uint32Array.of(0, 3, 0, 3),\n    });\n    expect(marksOf(marks, 'path')[0]!.strokeWidth).toBe(2);\n  });\n\n  it('shares exact packed boundaries between adjacent stacked areas on both sides of zero', () => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'b', 'c'], data: [\n        { x: 0, a: 2, b: 3, c: -2 }, { x: 1, a: -4, b: -1, c: 3 }, { x: 2, a: 2, b: null, c: 5 },\n      ],\n    }, { kind: 'area', stacked: true, valueDomain: [-10, 10] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const areas = marksOf(marks, 'area');\n    expect(areas).toHaveLength(3);\n    expect(areas[0]!.upper).toBe(areas[1]!.lower);\n    expect(areas[1]!.upper).toBe(areas[2]!.lower);\n    expect(areas[1]!.opacity).toBe(0.8);\n    expect(areas[1]!.upper).toEqual(Float32Array.of(10, 45, 80, 70, 150, 60, 10, 70, 80, 95, 150, 70));\n    expect(areas[1]!.runs).toEqual(Uint32Array.of(0, 3, 0, 3, 3, 3, 3, 3));\n    const paths = marksOf(marks, 'path').filter(mark => mark.stroke.kind === 'series');\n    expect(paths[1]!.xy).toEqual(Float32Array.of(10, 45, 80, 95));\n  });\n\n  it.each([1, 2])('retains the actual extrema in sampled columns of 100,000 points at DPR %s', ratio => {\n    const count = 100_000;\n    const x = Float64Array.from({ length: count }, (_, i) => i + 0.5);\n    const y = Float64Array.from({ length: count }, (_, i) => i % 101 - 50);\n    const { view } = aligned({ x: 'x', y: 'y', data: { columns: { x, y } } },\n      { kind: 'line', xDomain: [0, count], valueDomain: [-50, 50] });\n    const scene = buildScene(view, layout(view, { x: 0, y: 0, width: 200, height: 100 }), ratio);\n    const path = marksOf(scene.marks, 'path')[0]!;\n    expect(path.xy.length / 2).toBeLessThanOrEqual(4 * 200 * ratio);\n\n    const samplesPerColumn = count / (200 * ratio);\n    for (const column of [0, 1, 83, 137, 200 * ratio - 1]) {\n      const source = y.subarray(column * samplesPerColumn, (column + 1) * samplesPerColumn);\n      const drawn: number[] = [];\n      for (let i = 0; i < path.xy.length; i += 2) {\n        if (Math.floor(path.xy[i]! * ratio) === column) drawn.push(path.xy[i + 1]!);\n      }\n      expect(Math.min(...drawn)).toBe(50 - Math.max(...source));\n      expect(Math.max(...drawn)).toBe(50 - Math.min(...source));\n    }\n    const markers = marksOf(scene.marks, 'points')[0]!;\n    expect(markers.xy.length / 2).toBe(3);\n    expect(markers.xy.at(-2)).toBeCloseTo(199.999, 4);\n    expect(markers.xy.at(-1)).toBe(50 - y[count - 1]!);\n    for (let i = 0; i < markers.xy.length; i += 2) {\n      const index = Math.round(markers.xy[i]! * 500 - 0.5);\n      expect(markers.xy[i + 1]).toBe(50 - y[index]!);\n    }\n  });\n\n  it('draws compact paths without axes, references, or regular markers but keeps isolated points', () => {\n    const view = line([2, 4, 6], true);\n    const { marks } = buildScene({\n      ...view, references: [{ axis: 'y', from: 2, to: 2, label: 'Reference' }],\n    }, layout(view, clip, true), dpr);\n    expect(marks.map(mark => mark.type)).toEqual(['path']);\n    const isolated = line([null, 4, null], true);\n    const isolatedScene = buildScene(isolated, layout(isolated, clip, true), dpr);\n    expect(marksOf(isolatedScene.marks, 'points')[0]!.xy).toEqual(Float32Array.of(80, 80));\n  });\n});\n\ndescribe('bar geometry', () => {\n  it('uses projected zero as the baseline and represents missing and zero bars separately', () => {\n    const { view } = aligned({\n      x: 'x', y: 'y', data: [{ x: 'A', y: 4 }, { x: 'B', y: null }, { x: 'C', y: 0 }],\n    }, { kind: 'bar', valueDomain: [0, 10] });\n    const scene = buildScene(view, layout(view, { ...clip, width: 120 }), dpr);\n    expect(marksOf(scene.marks, 'rects')).toEqual([\n      { type: 'rects', variant: 'bar', series: 0, xywh: Float32Array.of(10, 80, 40, 40, 90, 120, 40, 0),\n        fill: { kind: 'series', index: 0 } },\n      { type: 'rects', variant: 'missing', series: 0, xywh: Float32Array.of(50, 120, 40, 0),\n        fill: { kind: 'token', name: 'muted' } },\n    ]);\n  });\n\n  it.each([false, true])('keeps both grouped bars in their band without overlap, horizontal %s', horizontal => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'b'], data: [{ x: 'A', a: 2, b: 3 }, { x: 'B', a: 4, b: 5 }],\n    }, { kind: 'bar', horizontal, valueDomain: [0, 10] });\n    const scene = buildScene(view, layout(view, clip, false, 0.25), dpr);\n    const [a, b] = marksOf(scene.marks, 'rects');\n    const dimension = horizontal ? clip.height : clip.width;\n    const step = dimension / 2.25;\n    const band = 0.75 * step;\n    const axis = horizontal ? 1 : 0;\n    for (let i = 0; i < 2; i++) {\n      const start = horizontal\n        ? clip.y + clip.height - (i + 0.25) * step - band : clip.x + (i + 0.25) * step;\n      expect(a!.xywh[4 * i + axis]).toBeCloseTo(start, 4);\n      expect(a!.xywh[4 * i + axis + 2]).toBeCloseTo(band / 2, 4);\n      expect(b!.xywh[4 * i + axis]).toBeCloseTo(start + band / 2, 4);\n      expect(b!.xywh[4 * i + axis + 2]).toBeCloseTo(band / 2, 4);\n    }\n  });\n\n  it('places mixed-sign stacks on their own sides with separation between filled segments', () => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'b', 'c', 'd'], data: [{ x: 'A', a: 3, b: -2, c: 4, d: -5 }],\n    }, { kind: 'bar', stacked: true, valueDomain: [-10, 10] });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const bars = marksOf(marks, 'rects');\n    expect(bars.map(bar => Array.from(bar.xywh))).toEqual([\n      [10, 55, 140, 15], [10, 71, 140, 9], [10, 35, 140, 19], [10, 81, 140, 24],\n    ]);\n  });\n\n  it('draws every subpixel band with at least a CSS pixel of width', () => {\n    const { view } = aligned({\n      x: 'x', y: 'y', data: Array.from({ length: 250 }, (_, i) => ({ x: 'Category ' + i, y: 4 })),\n    }, { kind: 'bar' });\n    const { marks } = buildScene(view, layout(view), dpr);\n    const [bar] = marksOf(marks, 'rects');\n    expect(bar!.xywh).toHaveLength(1000);\n    expect(bar!.xywh.every((value, i) => i % 4 !== 2 || value >= 1)).toBe(true);\n  });\n});\n\ndescribe('chart decorations and other projections', () => {\n  it('orders clipped reference bands, the value grid, data, axes, and reference rules', () => {\n    const view = line([2, 4, 6]);\n    const augmented = { ...view, references: [\n      { axis: 'x' as const, from: -1, to: 1, label: 'Range' },\n      { axis: 'y' as const, from: 5, to: 5, label: 'Goal' },\n      { axis: 'x' as const, from: 3, to: 3, label: 'Outside' },\n    ] };\n    const { marks } = buildScene(augmented, layout(augmented), dpr);\n    expect(marks.map(mark => mark.type === 'rule' ? mark.role : mark.type)).toEqual([\n      'band', 'grid', 'grid', 'path', 'points', 'axis', 'axis', 'tick', 'tick', 'tick', 'tick', 'reference',\n    ]);\n    expect(marks[0]).toEqual({\n      type: 'band', box: { ...clip, width: 70 }, fill: { kind: 'token', name: 'reference' }, opacity: 0.12,\n    });\n    expect(marks[1]).toMatchObject({ stroke: { kind: 'token', name: 'grid' }, x1: 10, y1: 120, x2: 150, y2: 120 });\n    expect(marks.at(-1)).toMatchObject({ stroke: { kind: 'token', name: 'reference' }, x1: 10, y1: 70, x2: 150, y2: 70 });\n  });\n\n  it('swaps the grid and reference axes for horizontal bars', () => {\n    const { view } = aligned({ x: 'x', y: 'y', data: [{ x: 'A', y: 4 }, { x: 'B', y: 7 }] }, {\n      kind: 'bar', horizontal: true, valueDomain: [0, 10], references: [{ x: 'B', label: 'Category' }, { y: 5, label: 'Target' }],\n    });\n    const rules = marksOf(buildScene(view, layout(view), dpr).marks, 'rule');\n    expect(rules.filter(mark => mark.role === 'grid')).toMatchObject([\n      { x1: 10, y1: 20, x2: 10, y2: 120 }, { x1: 150, y1: 20, x2: 150, y2: 120 },\n    ]);\n    expect(rules.filter(mark => mark.role === 'reference')).toMatchObject([\n      { x1: 10, y1: 45, x2: 150, y2: 45 }, { x1: 80, y1: 20, x2: 80, y2: 120 },\n    ]);\n  });\n\n  it('draws scatter points in series shapes, excluding hidden and out-of-zoom points', () => {\n    const { view } = scatter({ x: 'x', y: 'y', series: 's', data: [\n      { x: 0, y: 7, s: 'a' }, { x: 2, y: 3, s: 'a' }, { x: 3, y: 6, s: 'b' },\n      { x: 4, y: 5, s: 'b' }, { x: 2, y: 2, s: 'hidden' },\n    ] }, { zoom: [1, 3], valueDomain: [0, 10], hidden: new Set(['hidden']) });\n    const { marks } = buildScene(view, layout(view), dpr);\n    expect(marksOf(marks, 'points')).toEqual([\n      { type: 'points', series: 0, xy: Float32Array.of(80, 90), shape: 'circle', size: 6, fill: { kind: 'series', index: 0 } },\n      { type: 'points', series: 1, xy: Float32Array.of(150, 60), shape: 'square', size: 6, fill: { kind: 'series', index: 1 } },\n    ]);\n  });\n\n  it('uses the slice palette slots and a muted Other with a one-pixel gap', () => {\n    const { view } = donut(Array.from({ length: 10 }, (_, i) => ({ label: 'Part ' + i, value: i })));\n    const { marks } = buildScene(view, layout(view), dpr);\n    expect(marks).toHaveLength(1);\n    const [ring] = marksOf(marks, 'arcs');\n    expect(ring).toMatchObject({\n      cx: 80, cy: 70, r0: 30, r1: 50, gap: 1,\n      fills: [\n        ...Array.from({ length: 7 }, (_, i) => ({ kind: 'series', index: i + 1 })),\n        { kind: 'token', name: 'muted' },\n      ],\n    });\n    expect(ring!.angles).toHaveLength(16);\n    expect(ring!.angles[0]).toBe(0);\n    expect(ring!.angles.at(-1)).toBeCloseTo(2 * Math.PI, 6);\n  });\n\n  it('returns correctly sized empty scenes for non-drawing layouts and empty rings', () => {\n    const view = line([2, 4]);\n    for (const kind of ['too-small', 'unmeasured'] as const) {\n      expect(buildScene(view, { kind, width: 48, height: 24 }, dpr)).toEqual({\n        width: 48, height: 24, clip: { x: 0, y: 0, width: 48, height: 24 }, marks: [],\n      });\n    }\n    const empty = donut([{ label: 'Zero', value: 0 }]).view;\n    expect(buildScene(empty, layout(empty), dpr).marks).toEqual([]);\n  });\n});\n\nfunction expectPoint(x: number, y: number, plot: Rect, stroke = 0): void {\n  const margin = stroke + 0.0001;\n  expect(Number.isFinite(x) && Number.isFinite(y)).toBe(true);\n  expect(x).toBeGreaterThanOrEqual(plot.x - margin);\n  expect(x).toBeLessThanOrEqual(plot.x + plot.width + margin);\n  expect(y).toBeGreaterThanOrEqual(plot.y - margin);\n  expect(y).toBeLessThanOrEqual(plot.y + plot.height + margin);\n}\n\nfunction expectPacked(xy: Float32Array, plot: Rect, stroke?: number): void {\n  for (let i = 0; i < xy.length; i += 2) {\n    const x = xy[i]!;\n    const y = xy[i + 1]!;\n    if (stroke !== undefined && Number.isNaN(x)) expect(Number.isNaN(y)).toBe(true);\n    else expectPoint(x, y, plot, stroke);\n  }\n}\n\nfunction expectBox(x: number, y: number, width: number, height: number, plot: Rect): void {\n  expect(width).toBeGreaterThanOrEqual(0);\n  expect(height).toBeGreaterThanOrEqual(0);\n  expectPoint(x, y, plot);\n  expectPoint(x + width, y + height, plot);\n}\n\nfunction expectWithinClip(mark: Mark, plot: Rect): void {\n  switch (mark.type) {\n    case 'rule':\n      if (mark.role === 'axis' || mark.role === 'tick') {\n        expect([mark.x1, mark.y1, mark.x2, mark.y2].every(Number.isFinite)).toBe(true);\n      } else {\n        expectPoint(mark.x1, mark.y1, plot, mark.strokeWidth);\n        expectPoint(mark.x2, mark.y2, plot, mark.strokeWidth);\n      }\n      break;\n    case 'path': expectPacked(mark.xy, plot, mark.strokeWidth); break;\n    case 'points': expectPacked(mark.xy, plot); break;\n    case 'area':\n      expectPacked(mark.upper, plot);\n      expectPacked(mark.lower, plot);\n      for (let i = 0; i < mark.runs.length; i += 4) {\n        expect((mark.runs[i]! + mark.runs[i + 1]!) * 2).toBeLessThanOrEqual(mark.upper.length);\n        expect((mark.runs[i + 2]! + mark.runs[i + 3]!) * 2).toBeLessThanOrEqual(mark.lower.length);\n      }\n      break;\n    case 'rects':\n      for (let i = 0; i < mark.xywh.length; i += 4) {\n        expectBox(mark.xywh[i]!, mark.xywh[i + 1]!, mark.xywh[i + 2]!, mark.xywh[i + 3]!, plot);\n      }\n      break;\n    case 'band': expectBox(mark.box.x, mark.box.y, mark.box.width, mark.box.height, plot); break;\n    case 'arcs':\n      expectPoint(mark.cx - mark.r1, mark.cy - mark.r1, plot);\n      expectPoint(mark.cx + mark.r1, mark.cy + mark.r1, plot);\n      expect(Number.isFinite(mark.r0) && mark.angles.every(Number.isFinite)).toBe(true);\n      break;\n  }\n}\n\nit('keeps generated mark coordinates finite and clipped, with non-negative rectangle sizes', () => {\n  const value = fc.option(fc.integer({ min: -500, max: 500 }), { nil: null });\n  const values = fc.array(fc.tuple(value, value), { minLength: 1, maxLength: 18 });\n  const kind = fc.constantFrom('line', 'area', 'bar', 'scatter', 'donut');\n  const size = fc.integer({ min: 1, max: 200 });\n  fc.assert(fc.property(kind, values, size, size, fc.boolean(), fc.boolean(), (chart, rows, width, height, flag, compact) => {\n    const plot = { x: 12.25, y: 16.5, width, height };\n    const references = [{ y: [-15, 15] as const, label: 'Range' }, { y: 17, label: 'Goal' }];\n    let view: View;\n    if (chart === 'donut') {\n      view = donut(rows.map(([value], i) => ({ label: 'Part ' + i, value: value === null ? null : Math.abs(value) }))).view;\n    } else if (chart === 'scatter') {\n      view = scatter({ x: 'x', y: 'y', data: rows.map(([y], x) => ({ x, y })) }, { references }).view;\n    } else {\n      const data = rows.map(([a, b], x) => ({ x: chart === 'bar' ? 'Band ' + x : x, a, b }));\n      view = aligned({ x: 'x', y: ['a', 'b'], data }, {\n        kind: chart, stacked: flag, horizontal: flag, compact, references,\n      }).view;\n    }\n    const scene = buildScene(view, layout(view, plot, view.kind !== 'donut' && view.compact, 0.2), flag ? 2 : 1);\n    expect(scene.clip).toBe(plot);\n    for (const mark of scene.marks) expectWithinClip(mark, plot);\n  }), { numRuns: 200 });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/view/references.ts packages/axylo/src/view/stack.ts packages/axylo/src/data/index.ts packages/axylo/src/scale/domain.ts; sed -n '435,472p' packages/axylo/src/core/contracts.ts\"","aggregated_output":"import type { DiagnosticSink, ResolvedReference, XColumn, XKind } from '../core/contracts';\nimport type { ResolvedXField } from '../data';\nimport { Reports } from '../data/reports';\nimport { nameOf, XParser } from '../data/x';\nimport { report } from '../diagnostics';\nimport type { Reference, XValue } from '../public';\n\nexport type Span<T = number> = readonly [T, T];\n\nexport function positionReader(\n  x: Pick<XColumn, 'kind' | 'categories' | 'timeZone'>,\n  field: ResolvedXField | undefined,\n): (value: XValue) => number {\n  if (x.kind === 'category') return value => {\n    const name = nameOf(value);\n    const index = name === null ? -1 : x.categories?.indexOf(name) ?? -1;\n    return index < 0 ? NaN : index;\n  };\n  const resolved: ResolvedXField = field ?? {\n    field: 'x', label: 'x', unit: null, type: x.kind === 'wall' ? null : x.kind,\n    timeZone: x.timeZone ?? 'UTC', ordered: false, format: null, tickFormat: null, domain: null,\n  };\n  const parser = new XParser(resolved, x.kind, { timeZone: x.timeZone ?? 'UTC' });\n  // Option positions have no source row. Their diagnostics are reported with the option's name.\n  const reports = new Reports(resolved.field);\n  return value => parser.read(value, -1, reports);\n}\n\nexport function readSpan(\n  input: Span<XValue> | null | undefined, read: (x: XValue) => number, field: string, sink: DiagnosticSink,\n): Span | null {\n  if (!input) return null;\n  const a = read(input[0]);\n  const b = read(input[1]);\n  if (!Number.isFinite(a) || !Number.isFinite(b)) {\n    report(sink, 'AX107', 'none', { field, detail: 'Supply two bounds in the x axis format.' });\n    return null;\n  }\n  return [Math.min(a, b), Math.max(a, b)];\n}\n\nfunction isPair<T>(value: T | Span<T>): value is Span<T> {\n  return Array.isArray(value);\n}\n\nexport function resolveReferences(\n  input: readonly Reference[], readX: (value: XValue) => number, xKind: XKind, sink: DiagnosticSink,\n): ResolvedReference[] {\n  const references: ResolvedReference[] = [];\n  for (let i = 0; i < input.length; i++) {\n    const { x, y, label } = input[i]!;\n    const add = (axis: 'x' | 'y', from: number, to: number, pair: boolean) => {\n      // Equal resolved bounds identify a line in the view contract.\n      if (pair && from === to) {\n        report(sink, 'AX150', 'none', {\n          field: 'reference[' + i + '].' + axis, detail: 'Supply different bounds for a reference band.',\n        });\n      } else {\n        references.push({ axis, from: Math.min(from, to), to: Math.max(from, to), label });\n      }\n    };\n    if (x !== undefined) {\n      const pair = isPair(x);\n      const from = readX(pair ? x[0] : x);\n      const to = pair ? readX(x[1]) : from;\n      if (Number.isFinite(from) && Number.isFinite(to)) {\n        add('x', from, to, pair);\n      } else {\n        report(sink, 'AX107', 'none', {\n          field: 'reference[' + i + '].x',\n          detail: xKind === 'category' ? 'Use an existing category for each bound.' : 'Supply a reference in the x axis format.',\n        });\n      }\n    }\n    if (y !== undefined) {\n      const pair = isPair(y);\n      const from = pair ? y[0] : y;\n      const to = pair ? y[1] : from;\n      if (Number.isFinite(from) && Number.isFinite(to)) {\n        add('y', from, to, pair);\n      } else {\n        report(sink, 'AX103', 'none', { field: 'reference[' + i + '].y' });\n      }\n    }\n  }\n  return references;\n}\nimport { SLOT_VALUE, type AlignedFrame, type DiagnosticInput, type DiagnosticSink, type StackView } from '../core/contracts';\nimport { createDiagnostic } from '../diagnostics';\n\nconst overflow = new WeakMap<StackView, readonly DiagnosticInput[]>();\n\nexport function reportStack(stack: StackView, sink: DiagnosticSink): void {\n  for (const diagnostic of overflow.get(stack) ?? []) sink.add(diagnostic);\n}\n\nexport function buildStack(frame: AlignedFrame, visible: readonly boolean[]): StackView {\n  const order: number[] = [];\n  const positive: Float64Array[] = [];\n  const negative: Float64Array[] = [];\n  const diagnostics: DiagnosticInput[] = [];\n  let incomplete: Uint8Array | null = null;\n\n  for (let i = 0; i < frame.series.length; i++) {\n    if (!visible[i]) continue;\n    const series = frame.series[i]!;\n    const prevPositive = positive.at(-1);\n    const prevNegative = negative.at(-1);\n    const pos = new Float64Array(frame.length);\n    const neg = new Float64Array(frame.length);\n    let count = 0;\n    const rows: number[] = [];\n\n    for (let slot = 0; slot < frame.length; slot++) {\n      let above = prevPositive?.[slot] ?? 0;\n      let below = prevNegative?.[slot] ?? 0;\n      if (series.slot[slot] === SLOT_VALUE) {\n        const value = series.y[slot]!;\n        if (value >= 0) above += value;\n        else below += value;\n        if (!Number.isFinite(above) || !Number.isFinite(below)) {\n          above = Math.min(above, Number.MAX_VALUE);\n          below = Math.max(below, -Number.MAX_VALUE);\n          count++;\n          const row = series.row?.[slot] ?? slot;\n          if (row >= 0 && rows.length < 10) rows.push(row);\n        }\n      } else {\n        incomplete ??= new Uint8Array(frame.length);\n        incomplete[slot] = 1;\n      }\n      pos[slot] = above;\n      neg[slot] = below;\n    }\n\n    if (count) diagnostics.push(createDiagnostic('AX103', 'changed', { field: series.field, count, rows }));\n    order.push(i);\n    positive.push(pos);\n    negative.push(neg);\n  }\n\n  const stack = { order, positive, negative, incomplete };\n  if (diagnostics.length) overflow.set(stack, diagnostics);\n  return stack;\n}\nexport { normalize } from './normalize';\nexport type { DataEnvironment, FrameVersion } from './normalize';\nexport { resolveOptions } from './options';\nexport type { AlignedChartType, ChartType, ResolvedOptions, ResolvedValueField, ResolvedXField } from './options';\nexport { AlignedStore } from './store';\nexport { validateOptions } from './validate';\n/**\n * The value-axis domain (spec F1 and F7).\n *\n * Precedence: an author domain is used as given (widened to zero on bar and area); otherwise the automatic\n * domain covers the data, stack totals and reference values, and each end is the first nice tick at or\n * beyond the extreme, so it never overshoots by a whole step.\n */\nimport { firstIndexAtOrAbove, lastIndexAtOrBelow, niceStepAtLeast, stepMultiple, type NiceStep } from './nice';\n\nexport interface ValueDomainInput {\n  /** Smallest and largest value, stack totals included. NaN (or min > max) when there is no data. */\n  readonly min: number;\n  readonly max: number;\n  /** True for bar and area. */\n  readonly includeZero: boolean;\n  /** The field's `domain` option. */\n  readonly authorDomain?: readonly [number, number] | null;\n  /** The field's declared `scale`. */\n  readonly valueScale?: 'percent' | 'ratio' | null;\n  /** Reference values (lines and band ends) that must be visible. */\n  readonly references?: readonly number[];\n}\n\nexport interface ValueDomain {\n  readonly domain: [number, number];\n  /** True when an author domain excluded zero and was widened (the caller raises AX110). */\n  readonly widenedToZero: boolean;\n}\n\n/**\n * Number of intervals the automatic domain is rounded to. About five gives ends that are rarely more than\n * a fifth of the span beyond the data, on a step that is one of the tick candidate sets.\n */\nconst DOMAIN_INTERVALS = 5;\n\n/** The step the automatic domain of [lo, hi] is rounded to (lo < hi). Divided first so that a span wider than the largest double does not overflow. */\nexport function domainStep(lo: number, hi: number): NiceStep {\n  return niceStepAtLeast(hi / DOMAIN_INTERVALS - lo / DOMAIN_INTERVALS);\n}\n\nexport function valueDomain(input: ValueDomainInput): ValueDomain {\n  const author = input.authorDomain;\n  if (author != null && Number.isFinite(author[0]) && Number.isFinite(author[1])) {\n    // Author bounds take precedence (F7) and are used as given, a zero-width domain included (the scale\n    // draws it in the middle). Only the zero rule of F1 changes them.\n    let lo = Math.min(author[0], author[1]);\n    let hi = Math.max(author[0], author[1]);\n    let widenedToZero = false;\n    if (input.includeZero && (lo > 0 || hi < 0)) {\n      lo = Math.min(lo, 0);\n      hi = Math.max(hi, 0);\n      widenedToZero = true;\n    }\n    return { domain: [lo === 0 ? 0 : lo, hi === 0 ? 0 : hi], widenedToZero };\n  }\n\n  let lo = Infinity;\n  let hi = -Infinity;\n  if (Number.isFinite(input.min) && Number.isFinite(input.max) && input.min <= input.max) {\n    lo = input.min;\n    hi = input.max;\n  }\n  for (const r of input.references ?? []) {\n    if (!Number.isFinite(r)) continue;\n    if (r < lo) lo = r;\n    if (r > hi) hi = r;\n  }\n  if (lo > hi) return { domain: [0, 1], widenedToZero: false }; // nothing to show; the chart shows its empty state\n  if (input.includeZero) {\n    lo = Math.min(lo, 0);\n    hi = Math.max(hi, 0);\n  }\n  const full = input.valueScale === 'percent' ? 100 : input.valueScale === 'ratio' ? 1 : null;\n  // The full-scale end is fixed; only the other end is rounded.\n  const fixedTop = full !== null && hi >= full / 2 && hi <= full;\n  if (fixedTop) hi = full;\n  const domain = lo === hi ? aroundConstant(lo, fixedTop, input.includeZero) : niceExtent(lo, hi, fixedTop);\n  return { domain: usable(domain, lo, hi), widenedToZero: false };\n}\n\n/**\n * [lo, hi] rounded outwards to the first multiple of the domain step at or beyond each end. With `fixedTop`\n * the upper end is kept as it is.\n */\nexport function niceExtent(lo: number, hi: number, fixedTop = false): [number, number] {\n  const step = domainStep(lo, hi);\n  if (!(step.value > 0 && Number.isFinite(step.value))) return [lo, hi];\n  const a = stepMultiple(lastIndexAtOrBelow(lo, step), step);\n  const b = fixedTop ? hi : stepMultiple(firstIndexAtOrAbove(hi, step), step);\n  return [a, b];\n}\n\n/**\n * A usable domain for a single value v (only reached without includeZero, or for zero itself). Zero gets\n * [0, 1] or [-1, 1]; any other value gets a nice range about 10% either side, or below it when v is the\n * fixed full-scale top.\n */\nfunction aroundConstant(v: number, fixedTop: boolean, includeZero: boolean): [number, number] {\n  // Zero on a bar or area axis starts at the baseline.\n  if (v === 0) return includeZero ? [0, 1] : [-1, 1];\n  // Below 1e-300 a tenth of the value is not representable; such a value is drawn as zero would be.\n  if (Math.abs(v) < 1e-300) return [-1, 1];\n  const h = Math.abs(v) * 0.1;\n  if (fixedTop || !Number.isFinite(v + h)) return niceExtent(v - 2 * h, v, true);\n  if (!Number.isFinite(v - h)) return [v, niceExtent(v, v + 2 * h)[1]];\n  return niceExtent(v - h, v + h);\n}\n\n/**\n * The rounded domain if it is finite, ordered and contains [lo, hi]; otherwise the finite input bounds,\n * so no rounding artefact (overflow, underflow, a step below the resolution of the values) reaches a scale.\n */\nfunction usable(domain: [number, number], lo: number, hi: number): [number, number] {\n  const [a, b] = domain;\n  if (Number.isFinite(a) && Number.isFinite(b) && a <= lo && b >= hi && a < b) return [a === 0 ? 0 : a, b === 0 ? 0 : b];\n  if (lo < hi) return [lo, hi];\n  // A single value whose rounded neighbourhood failed: any finite interval around it.\n  const h = Math.abs(lo) * 0.2;\n  if (Number.isFinite(lo - h) && lo - h < lo) return [lo - h, lo];\n  if (Number.isFinite(lo + h) && lo + h > lo) return [lo, lo + h];\n  return [lo - 1, lo + 1];\n}\n  readonly xy: Float32Array;\n  readonly stroke: Paint;\n  readonly strokeWidth: number;\n  readonly dash: DashStyle;\n}\n\n/**\n * Filled regions between an upper and a lower boundary (area, stacked area). Each boundary is its own packed\n * polyline, so each can keep its own extremes when simplified (spec F5), and adjacent stack bands can share\n * the very same boundary array. `runs` holds quadruples (upperStart, upperCount, lowerStart, lowerCount) in\n * vertices; one quadruple is one polygon: its upper vertices forward, then its lower vertices in reverse.\n */\nexport interface AreaMark {\n  readonly type: 'area';\n  readonly series: number;\n  readonly upper: Float32Array;\n  readonly lower: Float32Array;\n  readonly runs: Uint32Array;\n  readonly fill: Paint;\n  readonly opacity: number;\n}\n\n/** Axis-aligned rectangles: x,y,width,height quadruples in CSS px. */\nexport interface RectMark {\n  readonly type: 'rects';\n  readonly series: number;\n  readonly xywh: Float32Array;\n  readonly fill: Paint;\n  /** 'missing' draws the \"no data\" mark of spec F2 instead of a filled bar. */\n  readonly variant: 'bar' | 'missing';\n  /**\n   * A second cue on top of the fill, for charts with more than eight series (spec F9): a pattern drawn in the\n   * background color over the fill. Absent or 'none' for the first eight.\n   */\n  readonly pattern?: 'none' | 'diagonal' | 'cross' | 'dots';\n}\n\n/** Markers: x,y pairs in CSS px. */\n","exit_code":0,"status":"completed"}}
