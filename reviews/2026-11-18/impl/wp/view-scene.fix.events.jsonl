{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/view/*.ts'","aggregated_output":"import { normalize, resolveOptions } from '../../src/data';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { buildView, type AlignedViewState, type DonutViewState, type ScatterViewState } from '../../src/view';\n\nconst utc = { timeZone: 'UTC' };\nconst version = { revision: 8, epoch: 4 };\n\nexport function aligned(options: unknown, state: AlignedViewState) {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions(state.kind, options, diagnostics);\n  const frame = normalize(state.kind, resolved, utc, diagnostics, version);\n  const view = buildView(frame, {\n    xField: resolved.x, valueDomain: resolved.values[0]?.domain, ...state,\n  }, diagnostics);\n  return { frame, view, diagnostics };\n}\n\nexport function scatter(options: unknown, state: Omit<ScatterViewState, 'kind'> = {}) {\n  const diagnostics = new DiagnosticCollector();\n  const resolved = resolveOptions('scatter', options, diagnostics);\n  const frame = normalize('scatter', resolved, utc, diagnostics, version);\n  const view = buildView(frame, {\n    kind: 'scatter', xField: resolved.x, valueDomain: resolved.values[0]?.domain, valueScale: resolved.values[0]?.scale, ...state,\n  }, diagnostics);\n  return { frame, view, diagnostics };\n}\n\nexport function donut(data: readonly { label: string; value: number | null }[], state: Partial<DonutViewState> = {}) {\n  const diagnostics = new DiagnosticCollector();\n  const options = resolveOptions('donut', { label: 'label', value: 'value', data }, diagnostics);\n  const frame = normalize('donut', options, utc, diagnostics, version);\n  const view = buildView(frame, { kind: 'donut', otherLabel: count => 'Other (' + count + ')', ...state }, diagnostics);\n  return { frame, view, diagnostics };\n}\nimport fc from 'fast-check';\nimport { describe, expect, it } from 'vitest';\nimport { SLOT_GAP, SLOT_NO_ROW, SLOT_NULL } from '../../src/core/contracts';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { buildView } from '../../src/view';\nimport { aligned, donut, scatter } from './fixtures';\n\ndescribe('view domains and visibility', () => {\n  it('widens the full x extent with author bounds and clamps a zoom on either side', () => {\n    const options = { x: { field: 'x', domain: [-3, 8] }, y: 'y', data: [{ x: 0, y: 1 }, { x: 5, y: 3 }] };\n    const { view } = aligned(options, { kind: 'line', zoom: [-10, 4] });\n    expect(view.xFull).toEqual([-3, 8]);\n    expect(view.xDomain).toEqual([-3, 4]);\n    expect(view.visibleSlots).toEqual({ start: 0, end: 1 });\n    expect(aligned(options, { kind: 'line', zoom: [4, 20] }).view.xDomain).toEqual([4, 8]);\n    expect(aligned({ ...options, x: 'x' }, { kind: 'line', zoom: [-10, 20] }).view.xDomain).toEqual([0, 5]);\n    expect(aligned(options, { kind: 'line', xDomain: null }).view.xFull).toEqual([0, 5]);\n  });\n\n  it('keeps category bars and compact charts on their full x ranges', () => {\n    const data = [{ x: 'North', y: 8 }, { x: 'East', y: 5 }, { x: 'South', y: 3 }];\n    const options = { x: 'x', y: 'y', data };\n    expect(aligned(options, { kind: 'bar', zoom: ['East', 'South'] }).view.xDomain).toEqual([0, 2]);\n    expect(aligned(options, { kind: 'line', compact: true, zoom: ['East', 'South'] }).view.xDomain).toEqual([0, 2]);\n  });\n\n  it('widens draw slots to the nearest joinable values and spans a view between observations', () => {\n    const data = Array.from({ length: 9 }, (_, x) => ({ x, y: 2, s: 'dense' }));\n    for (const x of [0, 2, 4, 5, 8]) data.push({ x, y: 10, s: 'sparse' });\n    const { frame, view } = aligned({ x: 'x', y: 'y', series: 's', data }, { kind: 'line', zoom: [3, 5] });\n    expect(frame.series[1]!.slot[3]).toBe(SLOT_NO_ROW);\n    expect(view.visibleSlots).toEqual({ start: 3, end: 6 });\n    expect(view.drawSlots).toEqual([{ start: 2, end: 7 }, { start: 2, end: 9 }]);\n    const between = buildView(frame, { kind: 'line', zoom: [6, 7] }, new DiagnosticCollector());\n    expect(between.visibleSlots).toEqual({ start: 6, end: 8 });\n    expect(between.drawSlots[1]).toEqual({ start: 5, end: 9 });\n  });\n\n  it('stops draw ranges at an explicit null or an expected step', () => {\n    const { frame, view } = aligned({\n      x: { field: 'x', type: 'date' }, y: 'y',\n      data: [1, 2, 3, 5, 6, 7].map(day => ({ x: '2026-03-0' + day, y: day === 6 ? null : day })),\n    }, { kind: 'line', zoom: ['2026-03-05', '2026-03-05'] });\n    expect(frame.series[0]!.slot[3]).toBe(SLOT_GAP);\n    expect(frame.series[0]!.slot[5]).toBe(SLOT_NULL);\n    expect(view.visibleSlots).toEqual({ start: 4, end: 5 });\n    expect(view.drawSlots).toEqual([{ start: 4, end: 5 }]);\n    const empty = buildView(frame, { kind: 'line', zoom: ['2026-03-04', '2026-03-04'] }, new DiagnosticCollector());\n    expect(empty.drawSlots).toEqual([{ start: 3, end: 4 }]);\n  });\n\n  it('ignores hidden, non-drawable and out-of-zoom values when fitting the y axis', () => {\n    const data = [\n      { x: 0, y: 99, s: 'valid' }, { x: 1, y: 1, s: 'valid' }, { x: 2, y: 3, s: 'valid' },\n      { x: 1, y: 100, s: 'hidden' }, { x: 1, y: 400, s: 'duplicate' }, { x: 1, y: 600, s: 'duplicate' },\n    ];\n    const { frame, view } = aligned({ x: 'x', y: 'y', series: 's', data },\n      { kind: 'line', hidden: new Set(['hidden']), zoom: [1, 2] });\n    expect(frame.series[2]!.drawable).toBe(false);\n    expect(view.visible).toEqual([true, false, false]);\n    expect(view.yDomain).toEqual([1, 3]);\n  });\n\n  it.each(['bar', 'area'] as const)('widens %s author domains to zero and reports AX110', kind => {\n    const options = { x: 'x', y: 'y', data: [{ x: 1, y: 82 }, { x: 2, y: 97 }] };\n    const { view, diagnostics } = aligned(options, { kind, valueDomain: [80, 100] });\n    expect(view.yDomain).toEqual([0, 100]);\n    expect(diagnostics.inputs()).toEqual([\n      expect.objectContaining({ code: 'AX110', field: 'y', level: 'warning', origin: 'call' }),\n    ]);\n    expect(aligned({\n      ...options, data: [{ x: 1, y: -9 }, { x: 2, y: -8 }],\n    }, { kind, valueDomain: [-10, -5] }).view.yDomain).toEqual([-10, 0]);\n  });\n\n  it('rounds a small maximum normally and includes full scale only above the percent threshold', () => {\n    const options = (a: number, b: number) => ({\n      x: 'x', y: { field: 'y', scale: 'percent' }, data: [{ x: 1, y: a }, { x: 2, y: b }],\n    });\n    expect(aligned(options(2, 4), { kind: 'bar' }).view.yDomain).toEqual([0, 4]);\n    expect(aligned(options(82, 94), { kind: 'bar' }).view.yDomain).toEqual([0, 100]);\n  });\n\n  it('resolves references against the frame kind and includes value bands and lines in the domain', () => {\n    const { view, diagnostics } = aligned({\n      x: 'x', y: 'y', data: [{ x: '2026-02', y: 2 }, { x: '2026-03', y: 5 }],\n    }, { kind: 'line', references: [\n      { x: ['2026-03', '2026-02'], y: [-5, -10], label: 'Range' },\n      { y: 20, label: 'Goal' },\n      { x: '2026-02-30', label: 'Invalid' },\n    ] });\n    expect(view.references).toEqual([\n      { axis: 'x', from: Date.UTC(2026, 1, 1), to: Date.UTC(2026, 2, 1), label: 'Range' },\n      { axis: 'y', from: -10, to: -5, label: 'Range' },\n      { axis: 'y', from: 20, to: 20, label: 'Goal' },\n    ]);\n    expect(view.yDomain).toEqual([-10, 20]);\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX107', field: 'reference[2].x' })]);\n  });\n\n  it('matches the normalization rules for instants, wall times and category names', () => {\n    const instant = aligned({\n      x: { field: 'x', type: 'time' }, y: 'y', data: [{ x: '2026-02-24T05:00:00-05:00', y: 3 }],\n    }, { kind: 'line', references: [{ x: new Date('2026-02-24T10:00:00Z'), label: 'Instant' }] }).view;\n    expect(instant.references[0]!.from).toBe(instant.frame.x.values[0]);\n    const wall = aligned({\n      x: 'x', y: 'y', data: [{ x: '2026-02-24T05:00:00', y: 3 }],\n    }, { kind: 'line', references: [{ x: '2026-02-24T05:00:00', label: 'Wall time' }] }).view;\n    expect(wall.references[0]!.from).toBe(Date.UTC(2026, 1, 24, 5));\n    const category = aligned({\n      x: 'x', y: 'y', data: [{ x: 'North', y: 3 }, { x: 'South', y: 4 }],\n    }, { kind: 'line', references: [{ x: 'South', label: 'Region' }] }).view;\n    expect(category.references[0]!.from).toBe(1);\n  });\n\n  it('reports a band whose equal bounds cannot be distinguished from a line', () => {\n    const { view, diagnostics } = aligned({ x: 'x', y: 'y', data: [{ x: 1, y: 4 }] }, {\n      kind: 'line', references: [{ x: [1, 1], label: 'Band' }, { x: 1, label: 'Line' }],\n    });\n    expect(view.references).toEqual([{ axis: 'x', from: 1, to: 1, label: 'Line' }]);\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX150', field: 'reference[0].x' })]);\n  });\n\n  it('keeps scatter ranges per series and uses only the points inside zoom for the value domain', () => {\n    const { view } = scatter({ x: 'x', y: 'y', series: 's', data: [\n      { x: 3, y: 100, s: 'a' }, { x: 1, y: 2, s: 'a' }, { x: 0, y: 6, s: 'b' }, { x: 2, y: 4, s: 'b' },\n      { x: 2, y: 1000, s: 'hidden' },\n    ] }, { hidden: new Set(['hidden']), zoom: [1, 2] });\n    expect(view.xFull).toEqual([0, 3]);\n    expect(view.visible).toEqual([true, true, false]);\n    expect(view.visiblePoints).toEqual([{ start: 0, end: 1 }, { start: 1, end: 2 }, { start: 0, end: 1 }]);\n    expect(view.yDomain).toEqual([2, 4]);\n  });\n});\n\ndescribe('stacks and series cues', () => {\n  it('accumulates on separate sides in series order and marks an incomplete stack', () => {\n    const { view } = aligned({\n      x: 'x', y: ['a', 'hidden', 'b', 'c'], data: [\n        { x: 0, a: 3, hidden: 800, b: -2, c: 1 },\n        { x: 1, a: -5, hidden: 800, b: 3, c: -1 },\n        { x: 2, a: null, hidden: 800, b: -3, c: 0 },\n      ],\n    }, { kind: 'area', stacked: true, hidden: new Set(['hidden']) });\n    expect(view.stack).toEqual({\n      order: [0, 2, 3],\n      positive: [Float64Array.of(3, 0, 0), Float64Array.of(3, 3, 0), Float64Array.of(4, 3, 0)],\n      negative: [Float64Array.of(0, -5, 0), Float64Array.of(-2, -5, -3), Float64Array.of(-2, -6, -3)],\n      incomplete: Uint8Array.of(0, 0, 1),\n    });\n    expect(view.yDomain).toEqual([-6, 4]);\n  });\n\n  it('reuses a view for identical inputs and its unchanged stack and cues across zooms', () => {\n    const { frame, view } = aligned({\n      x: 'x', y: ['a', 'b'], data: [{ x: '0', a: 3, b: -2 }, { x: '1', a: 2, b: -4 }],\n    }, { kind: 'area', stacked: true });\n    const sink = new DiagnosticCollector();\n    const same = buildView(frame, { kind: 'area', stacked: true, previous: view }, sink);\n    const zoomed = buildView(frame, { kind: 'area', stacked: true, zoom: ['1', '1'], previous: same }, sink);\n    expect(same).toBe(view);\n    expect(zoomed.frame).toBe(frame);\n    expect(zoomed.stack).toBe(view.stack);\n    expect(zoomed.cues).toBe(view.cues);\n    expect(zoomed.visibleSlots).toEqual({ start: 1, end: 2 });\n    expect(view.stack!.incomplete).toBeNull();\n  });\n\n  it('assigns a unique normal color/dash pair to each of 12 series and warns once', () => {\n    const y = Array.from({ length: 12 }, (_, i) => 'value' + i);\n    const { view, diagnostics } = aligned({\n      x: 'x', y, data: [{ x: 1, ...Object.fromEntries(y.map((name, i) => [name, i])) }],\n    }, { kind: 'line' });\n    expect(view.cues.slice(0, 8).map(cue => cue.marker)).toEqual([\n      'circle', 'square', 'triangle', 'diamond', 'cross', 'plus', 'triangle-down', 'star',\n    ]);\n    expect(view.cues.slice(0, 8).every(cue => cue.dash.normal === null)).toBe(true);\n    const identities = view.cues.map((cue, i) => JSON.stringify([i % 8, cue.dash.normal]));\n    expect(new Set(identities).size).toBe(12);\n    expect(new Set(view.cues.map(cue => JSON.stringify(cue.dash.contrast))).size).toBe(12);\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX130', level: 'warning' })]);\n  });\n\n  it('gives compact series distinct normal dashes and raises AX131', () => {\n    const { view, diagnostics } = aligned({\n      x: 'x', y: ['a', 'b'], data: [{ x: 1, a: 4, b: 8 }],\n    }, { kind: 'line', compact: true });\n    expect(view.cues[0]!.dash.normal).toBeNull();\n    expect(view.cues[1]!.dash.normal).not.toBeNull();\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX131', level: 'hint' })]);\n  });\n\n  it('keeps every cumulative total on its own side of zero for arbitrary signed values', () => {\n    const value = fc.option(fc.integer({ min: -300, max: 300 }), { nil: null });\n    fc.assert(fc.property(fc.array(fc.tuple(value, value, value), { minLength: 1, maxLength: 20 }), values => {\n      const data = values.map(([a, b, c], x) => ({ x, a, b, c }));\n      const { view } = aligned({ x: 'x', y: ['a', 'b', 'c'], data }, { kind: 'bar', stacked: true });\n      const stack = view.stack!;\n      for (let i = 0; i < values.length; i++) {\n        const row = values[i]!;\n        expect(stack.incomplete?.[i] ?? 0).toBe(row.includes(null) ? 1 : 0);\n        for (let k = 0; k < row.length; k++) {\n          const sum = row.slice(0, k + 1).reduce<number>((total, value) => total + Math.max(0, value ?? 0), 0);\n          const debt = row.slice(0, k + 1).reduce<number>((total, value) => total + Math.min(0, value ?? 0), 0);\n          expect(stack.positive[k]![i]).toBe(sum);\n          expect(stack.negative[k]![i]).toBe(debt);\n          expect(view.yDomain[0]).toBeLessThanOrEqual(debt);\n          expect(view.yDomain[1]).toBeGreaterThanOrEqual(sum);\n        }\n      }\n    }));\n  });\n});\n\ndescribe('donut slices', () => {\n  it('places the parts fixture clockwise in its given order from twelve o’clock', () => {\n    const labels = ['Chrome', 'Safari', 'Edge', 'Firefox', 'Samsung Internet', 'Other'];\n    const values = [46.2, 27.5, 14.1, 8.9, 2.1, 1.2];\n    const endpoints = [0, 46.2, 73.7, 87.8, 96.7, 98.8, 100];\n    const { view } = donut(labels.map((label, i) => ({ label, value: values[i]! })));\n    expect(view.slices.map(slice => slice.label)).toEqual(labels);\n    expect(view.total).toBeCloseTo(100);\n    for (let i = 0; i < labels.length; i++) {\n      const slice = view.slices[i]!;\n      expect(slice.members).toEqual([i]);\n      expect(slice.ratio).toBeCloseTo(values[i]! / 100, 12);\n      expect(slice.angles![0]).toBeCloseTo(endpoints[i]! * Math.PI / 50, 12);\n      expect(slice.angles![1]).toBeCloseTo(endpoints[i + 1]! * Math.PI / 50, 12);\n    }\n  });\n\n  it('lists zero and null entries with no arcs and leaves an all-zero ring empty', () => {\n    const entries = [{ label: 'Zero', value: 0 }, { label: 'Missing', value: null }, { label: 'Positive', value: 5 }];\n    const { view } = donut(entries);\n    expect(view.slices).toEqual([\n      { key: 'Zero', label: 'Zero', members: [0], value: 0, ratio: 0, angles: null },\n      { key: 'Missing', label: 'Missing', members: [1], value: null, ratio: null, angles: null },\n      { key: 'Positive', label: 'Positive', members: [2], value: 5, ratio: 1, angles: [0, 2 * Math.PI] },\n    ]);\n    const empty = donut(entries.slice(0, 2)).view;\n    expect(empty.total).toBe(0);\n    expect(empty.slices.every(slice => slice.angles === null)).toBe(true);\n  });\n\n  it('keeps the seven largest in original order, favoring the first tie at the cutoff', () => {\n    const values = [2, 10, 6, 8, 4, 4, 1, 9, 5, 7];\n    const { view, diagnostics } = donut(values.map((value, i) => ({ label: 'Category ' + i, value })),\n      { otherLabel: count => count + ' remaining' });\n    expect(view.total).toBe(56);\n    expect(view.slices.map(slice => slice.members)).toEqual([[1], [2], [3], [4], [7], [8], [9], [0, 5, 6]]);\n    expect(view.slices[7]).toEqual({\n      key: '__other__', label: '3 remaining', members: [0, 5, 6], value: 7, ratio: 1 / 8,\n      angles: [expect.closeTo(7 * Math.PI / 4, 12), 2 * Math.PI],\n    });\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX121', level: 'warning', count: 3 })]);\n  });\n\n  it('counts positive entries for grouping and does not render a partially negative ring', () => {\n    const data = Array.from({ length: 10 }, (_, i) => ({ label: 'Part ' + i, value: i === 0 ? null : i - 1 }));\n    const valid = donut(data);\n    expect(valid.view.slices).toHaveLength(10);\n    expect(valid.diagnostics.inputs()).toEqual([]);\n    const invalid = donut([...data, { label: 'Negative', value: -1 }]);\n    expect(invalid.view.slices).toEqual([]);\n    expect(invalid.diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX120', level: 'error' })]);\n  });\n\n  it('reserves the grouped slice key even if a category has that name', () => {\n    const { view } = donut(Array.from({ length: 9 }, (_, i) => ({ label: i === 0 ? '__other__' : 'Part ' + i, value: 1 })));\n    expect(view.slices[0]!.label).toBe('__other__');\n    expect(new Set(view.slices.map(slice => slice.key)).size).toBe(8);\n    expect(view.slices.at(-1)!.key).toBe('__other__');\n  });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/view/references.ts packages/axylo/src/data/index.ts packages/axylo/src/view/stack.ts packages/axylo/src/scale/domain.ts; sed -n '430,481p' packages/axylo/src/core/contracts.ts; sed -n '48,120p;148,212p' docs/02-product-spec.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/view/references.ts packages/axylo/src/data/index.ts packages/axylo/src/view/stack.ts packages/axylo/src/scale/domain.ts; sed -n '430,481p' packages/axylo/src/core/contracts.ts; sed -n '48,120p;148,212p' docs/02-product-spec.md\"","aggregated_output":"import type { DiagnosticSink, ResolvedReference, XColumn, XKind } from '../core/contracts';\nimport type { ResolvedXField } from '../data';\nimport { Reports } from '../data/reports';\nimport { nameOf, XParser } from '../data/x';\nimport { report } from '../diagnostics';\nimport type { Reference, XValue } from '../public';\n\nexport type Span<T = number> = readonly [T, T];\n\nexport function positionReader(\n  x: Pick<XColumn, 'kind' | 'categories' | 'timeZone'>,\n  field: ResolvedXField | undefined,\n): (value: XValue) => number {\n  if (x.kind === 'category') return value => {\n    const name = nameOf(value);\n    const index = name === null ? -1 : x.categories?.indexOf(name) ?? -1;\n    return index < 0 ? NaN : index;\n  };\n  const resolved: ResolvedXField = field ?? {\n    field: 'x', label: 'x', unit: null, type: x.kind === 'wall' ? null : x.kind,\n    timeZone: x.timeZone ?? 'UTC', ordered: false, format: null, tickFormat: null, domain: null,\n  };\n  const parser = new XParser(resolved, x.kind, { timeZone: x.timeZone ?? 'UTC' });\n  // Option positions have no source row. Their diagnostics are reported with the option's name.\n  const reports = new Reports(resolved.field);\n  return value => parser.read(value, -1, reports);\n}\n\nexport function readSpan(\n  input: Span<XValue> | null | undefined, read: (x: XValue) => number, field: string, sink: DiagnosticSink,\n): Span | null {\n  if (!input) return null;\n  const a = read(input[0]);\n  const b = read(input[1]);\n  if (!Number.isFinite(a) || !Number.isFinite(b)) {\n    report(sink, 'AX107', 'none', { field, detail: 'Supply two bounds in the x axis format.' });\n    return null;\n  }\n  return [Math.min(a, b), Math.max(a, b)];\n}\n\nfunction isPair<T>(value: T | Span<T>): value is Span<T> {\n  return Array.isArray(value);\n}\n\nexport function resolveReferences(\n  input: readonly Reference[], readX: (value: XValue) => number, xKind: XKind, sink: DiagnosticSink,\n): ResolvedReference[] {\n  const references: ResolvedReference[] = [];\n  for (let i = 0; i < input.length; i++) {\n    const { x, y, label } = input[i]!;\n    const add = (axis: 'x' | 'y', from: number, to: number, pair: boolean) => {\n      // Equal resolved bounds identify a line in the view contract.\n      if (pair && from === to) {\n        report(sink, 'AX150', 'none', {\n          field: 'reference[' + i + '].' + axis, detail: 'Supply different bounds for a reference band.',\n        });\n      } else {\n        references.push({ axis, from: Math.min(from, to), to: Math.max(from, to), label });\n      }\n    };\n    if (x !== undefined) {\n      const pair = isPair(x);\n      const from = readX(pair ? x[0] : x);\n      const to = pair ? readX(x[1]) : from;\n      if (Number.isFinite(from) && Number.isFinite(to)) {\n        add('x', from, to, pair);\n      } else {\n        report(sink, 'AX107', 'none', {\n          field: 'reference[' + i + '].x',\n          detail: xKind === 'category' ? 'Use an existing category for each bound.' : 'Supply a reference in the x axis format.',\n        });\n      }\n    }\n    if (y !== undefined) {\n      const pair = isPair(y);\n      const from = pair ? y[0] : y;\n      const to = pair ? y[1] : from;\n      if (Number.isFinite(from) && Number.isFinite(to)) {\n        add('y', from, to, pair);\n      } else {\n        report(sink, 'AX103', 'none', { field: 'reference[' + i + '].y' });\n      }\n    }\n  }\n  return references;\n}\nexport { normalize } from './normalize';\nexport type { DataEnvironment, FrameVersion } from './normalize';\nexport { resolveOptions } from './options';\nexport type { AlignedChartType, ChartType, ResolvedOptions, ResolvedValueField, ResolvedXField } from './options';\nexport { AlignedStore } from './store';\nexport { validateOptions } from './validate';\nimport { SLOT_VALUE, type AlignedFrame, type DiagnosticInput, type DiagnosticSink, type StackView } from '../core/contracts';\nimport { createDiagnostic } from '../diagnostics';\n\nconst overflow = new WeakMap<StackView, readonly DiagnosticInput[]>();\n\nexport function reportStack(stack: StackView, sink: DiagnosticSink): void {\n  for (const diagnostic of overflow.get(stack) ?? []) sink.add(diagnostic);\n}\n\nexport function buildStack(frame: AlignedFrame, visible: readonly boolean[]): StackView {\n  const order: number[] = [];\n  const positive: Float64Array[] = [];\n  const negative: Float64Array[] = [];\n  const diagnostics: DiagnosticInput[] = [];\n  let incomplete: Uint8Array | null = null;\n\n  for (let i = 0; i < frame.series.length; i++) {\n    if (!visible[i]) continue;\n    const series = frame.series[i]!;\n    const prevPositive = positive.at(-1);\n    const prevNegative = negative.at(-1);\n    const pos = new Float64Array(frame.length);\n    const neg = new Float64Array(frame.length);\n    let count = 0;\n    const rows: number[] = [];\n\n    for (let slot = 0; slot < frame.length; slot++) {\n      let above = prevPositive?.[slot] ?? 0;\n      let below = prevNegative?.[slot] ?? 0;\n      if (series.slot[slot] === SLOT_VALUE) {\n        const value = series.y[slot]!;\n        if (value >= 0) above += value;\n        else below += value;\n        if (!Number.isFinite(above) || !Number.isFinite(below)) {\n          above = Math.min(above, Number.MAX_VALUE);\n          below = Math.max(below, -Number.MAX_VALUE);\n          count++;\n          const row = series.row?.[slot] ?? slot;\n          if (row >= 0 && rows.length < 10) rows.push(row);\n        }\n      } else {\n        incomplete ??= new Uint8Array(frame.length);\n        incomplete[slot] = 1;\n      }\n      pos[slot] = above;\n      neg[slot] = below;\n    }\n\n    if (count) diagnostics.push(createDiagnostic('AX103', 'changed', { field: series.field, count, rows }));\n    order.push(i);\n    positive.push(pos);\n    negative.push(neg);\n  }\n\n  const stack = { order, positive, negative, incomplete };\n  if (diagnostics.length) overflow.set(stack, diagnostics);\n  return stack;\n}\n/**\n * The value-axis domain (spec F1 and F7).\n *\n * Precedence: an author domain is used as given (widened to zero on bar and area); otherwise the automatic\n * domain covers the data, stack totals and reference values, and each end is the first nice tick at or\n * beyond the extreme, so it never overshoots by a whole step.\n */\nimport { firstIndexAtOrAbove, lastIndexAtOrBelow, niceStepAtLeast, stepMultiple, type NiceStep } from './nice';\n\nexport interface ValueDomainInput {\n  /** Smallest and largest value, stack totals included. NaN (or min > max) when there is no data. */\n  readonly min: number;\n  readonly max: number;\n  /** True for bar and area. */\n  readonly includeZero: boolean;\n  /** The field's `domain` option. */\n  readonly authorDomain?: readonly [number, number] | null;\n  /** The field's declared `scale`. */\n  readonly valueScale?: 'percent' | 'ratio' | null;\n  /** Reference values (lines and band ends) that must be visible. */\n  readonly references?: readonly number[];\n}\n\nexport interface ValueDomain {\n  readonly domain: [number, number];\n  /** True when an author domain excluded zero and was widened (the caller raises AX110). */\n  readonly widenedToZero: boolean;\n}\n\n/**\n * Number of intervals the automatic domain is rounded to. About five gives ends that are rarely more than\n * a fifth of the span beyond the data, on a step that is one of the tick candidate sets.\n */\nconst DOMAIN_INTERVALS = 5;\n\n/** The step the automatic domain of [lo, hi] is rounded to (lo < hi). Divided first so that a span wider than the largest double does not overflow. */\nexport function domainStep(lo: number, hi: number): NiceStep {\n  return niceStepAtLeast(hi / DOMAIN_INTERVALS - lo / DOMAIN_INTERVALS);\n}\n\nexport function valueDomain(input: ValueDomainInput): ValueDomain {\n  const author = input.authorDomain;\n  if (author != null && Number.isFinite(author[0]) && Number.isFinite(author[1])) {\n    // Author bounds take precedence (F7) and are used as given, a zero-width domain included (the scale\n    // draws it in the middle). Only the zero rule of F1 changes them.\n    let lo = Math.min(author[0], author[1]);\n    let hi = Math.max(author[0], author[1]);\n    let widenedToZero = false;\n    if (input.includeZero && (lo > 0 || hi < 0)) {\n      lo = Math.min(lo, 0);\n      hi = Math.max(hi, 0);\n      widenedToZero = true;\n    }\n    return { domain: [lo === 0 ? 0 : lo, hi === 0 ? 0 : hi], widenedToZero };\n  }\n\n  let lo = Infinity;\n  let hi = -Infinity;\n  if (Number.isFinite(input.min) && Number.isFinite(input.max) && input.min <= input.max) {\n    lo = input.min;\n    hi = input.max;\n  }\n  for (const r of input.references ?? []) {\n    if (!Number.isFinite(r)) continue;\n    if (r < lo) lo = r;\n    if (r > hi) hi = r;\n  }\n  if (lo > hi) return { domain: [0, 1], widenedToZero: false }; // nothing to show; the chart shows its empty state\n  if (input.includeZero) {\n    lo = Math.min(lo, 0);\n    hi = Math.max(hi, 0);\n  }\n  const full = input.valueScale === 'percent' ? 100 : input.valueScale === 'ratio' ? 1 : null;\n  // The full-scale end is fixed; only the other end is rounded.\n  const fixedTop = full !== null && hi >= full / 2 && hi <= full;\n  if (fixedTop) hi = full;\n  const domain = lo === hi ? aroundConstant(lo, fixedTop, input.includeZero) : niceExtent(lo, hi, fixedTop);\n  return { domain: usable(domain, lo, hi), widenedToZero: false };\n}\n\n/**\n * [lo, hi] rounded outwards to the first multiple of the domain step at or beyond each end. With `fixedTop`\n * the upper end is kept as it is.\n */\nexport function niceExtent(lo: number, hi: number, fixedTop = false): [number, number] {\n  const step = domainStep(lo, hi);\n  if (!(step.value > 0 && Number.isFinite(step.value))) return [lo, hi];\n  const a = stepMultiple(lastIndexAtOrBelow(lo, step), step);\n  const b = fixedTop ? hi : stepMultiple(firstIndexAtOrAbove(hi, step), step);\n  return [a, b];\n}\n\n/**\n * A usable domain for a single value v (only reached without includeZero, or for zero itself). Zero gets\n * [0, 1] or [-1, 1]; any other value gets a nice range about 10% either side, or below it when v is the\n * fixed full-scale top.\n */\nfunction aroundConstant(v: number, fixedTop: boolean, includeZero: boolean): [number, number] {\n  // Zero on a bar or area axis starts at the baseline.\n  if (v === 0) return includeZero ? [0, 1] : [-1, 1];\n  // Below 1e-300 a tenth of the value is not representable; such a value is drawn as zero would be.\n  if (Math.abs(v) < 1e-300) return [-1, 1];\n  const h = Math.abs(v) * 0.1;\n  if (fixedTop || !Number.isFinite(v + h)) return niceExtent(v - 2 * h, v, true);\n  if (!Number.isFinite(v - h)) return [v, niceExtent(v, v + 2 * h)[1]];\n  return niceExtent(v - h, v + h);\n}\n\n/**\n * The rounded domain if it is finite, ordered and contains [lo, hi]; otherwise the finite input bounds,\n * so no rounding artefact (overflow, underflow, a step below the resolution of the values) reaches a scale.\n */\nfunction usable(domain: [number, number], lo: number, hi: number): [number, number] {\n  const [a, b] = domain;\n  if (Number.isFinite(a) && Number.isFinite(b) && a <= lo && b >= hi && a < b) return [a === 0 ? 0 : a, b === 0 ? 0 : b];\n  if (lo < hi) return [lo, hi];\n  // A single value whose rounded neighbourhood failed: any finite interval around it.\n  const h = Math.abs(lo) * 0.2;\n  if (Number.isFinite(lo - h) && lo - h < lo) return [lo - h, lo];\n  if (Number.isFinite(lo + h) && lo + h > lo) return [lo, lo + h];\n  return [lo - 1, lo + 1];\n}\n\n/** A polyline. `xy` is x0,y0,x1,y1,… in CSS px; a NaN pair lifts the pen. */\nexport interface PathMark {\n  readonly type: 'path';\n  readonly series: number;\n  readonly xy: Float32Array;\n  readonly stroke: Paint;\n  readonly strokeWidth: number;\n  readonly dash: DashStyle;\n}\n\n/**\n * Filled regions between an upper and a lower boundary (area, stacked area). Each boundary is its own packed\n * polyline, so each can keep its own extremes when simplified (spec F5), and adjacent stack bands can share\n * the very same boundary array. `runs` holds quadruples (upperStart, upperCount, lowerStart, lowerCount) in\n * vertices; one quadruple is one polygon: its upper vertices forward, then its lower vertices in reverse.\n */\nexport interface AreaMark {\n  readonly type: 'area';\n  readonly series: number;\n  readonly upper: Float32Array;\n  readonly lower: Float32Array;\n  readonly runs: Uint32Array;\n  readonly fill: Paint;\n  readonly opacity: number;\n}\n\n/** Axis-aligned rectangles: x,y,width,height quadruples in CSS px. */\nexport interface RectMark {\n  readonly type: 'rects';\n  readonly series: number;\n  readonly xywh: Float32Array;\n  readonly fill: Paint;\n  /** 'missing' draws the \"no data\" mark of spec F2 instead of a filled bar. */\n  readonly variant: 'bar' | 'missing';\n  /**\n   * A second cue on top of the fill, for charts with more than eight series (spec F9): a pattern drawn in the\n   * background color over the fill. Absent or 'none' for the first eight.\n   */\n  readonly pattern?: 'none' | 'diagonal' | 'cross' | 'dots';\n}\n\n/** Markers: x,y pairs in CSS px. */\nexport interface PointMark {\n  readonly type: 'points';\n  readonly series: number;\n  readonly xy: Float32Array;\n  readonly shape: MarkerShape;\n  readonly size: number;\n  readonly fill: Paint;\n}\n\n### 2.1 Chart types\n\n| Type | Variants | Typical question | Status |\n|---|---|---|---|\n| Line | Multi-series, gaps; time, date, numeric or category x | How did it change? | 1.0 |\n| Bar | Vertical, horizontal, grouped, stacked | How do categories compare? | 1.0 |\n| Area | Single, stacked | How did the total and its parts change? | 1.0 |\n| Donut | Up to eight slices | What share does each part have? | 1.0 |\n| Scatter | Optional series | How are two measures related? | 1.0 (owner's decision) |\n| Compact variant | Of line, area and bar: marks only, for KPI tiles and sparklines | Which way is it going? | 1.0 (owner's decision) |\n\nPlus, on every cartesian chart: reference lines and bands (a target, an incident window).\n\nThe Phase 1 harness exercised line, bar and donut in all ten libraries (donut in nine; uPlot has none). Area and scatter are added on judgment; Phase 1 found no usage data by chart type. Two reviewers argued for fewer types and one for a compact variant; the owner decided on all five types plus the compact variant. Scatter alone needs two-dimensional hit testing and its own navigation model, so it is built last and carries the most schedule risk.\n\nEach type has its own rules for picking, navigation and limits. They are in the type matrix in section 3.6, and a type does not ship until its row is fully tested.\n\n### 2.2 Workflows\n\n| # | Workflow | What it requires of Axylo |\n|---|---|---|\n| W1 | Show a query result | Rows in, chart out; field types inferred where that is safe; bad rows reported. |\n| W2 | Fill a dashboard | Dozens of charts per page; container-sized; themed by the page; loading, empty and error states; a chart can take its name from the card's own heading. |\n| W3 | Compare categories | Long labels; horizontal bars; grouped and stacked. |\n| W4 | Watch a live metric | Append without redraw cost growing; a pause control; no announcement flood. |\n| W5 | Explore a range | Tooltip anywhere, legend toggle, zoom and pan by single click, drag, touch and keyboard. |\n| W6 | Read it another way | Keyboard, screen reader, table view, high contrast, reduced motion, 400% zoom, color-vision deficiency. |\n\n### 2.3 Supported environments\n\n| Dimension | 1.0 |\n|---|---|\n| Browsers | The current and previous major versions of Chrome, Edge, Firefox and Safari (macOS and iOS). |\n| TypeScript | 5.4 and later. Plain JavaScript is fully supported; types are an aid, not a requirement. |\n| React | 18 and 19, through `@axylo/react`. |\n| Text direction | Left-to-right pages. Right-to-left text renders, but the layout is not mirrored; this is stated in the conformance table. |\n| Built-in text | English, overridable (A10). |\n\n## 3. Acceptance criteria: the reader's experience\n\nEvery criterion maps to at least one test in the acceptance matrix kept in the repository (criterion → test → chart types it applies to → result). \"Property test\" means the statement is checked over at least 1,000 generated datasets. Expected values come from the fixture data and this specification, never from the implementation's output.\n\n### 3.1 Faithful representation\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| F1 | Bar and area value axes always include zero. An author `domain` that excludes zero is widened and raises AX110. | Property test on domains, including all-negative and mixed-sign data; `bars` fixture (values 82–97) starts at 0 | R1 |\n| F2 | Missing values are never drawn as zero and never bridged unless the author asks. An explicit `null` is a gap, silently. An isolated value between two gaps is a visible point. A missing bar shows a \"no data\" mark at the baseline, distinct from a zero bar. On a time or date axis with a regular step, an absent step is a gap and raises AX105; `missing: 'zero'` on the field turns absent and null values into zeros for counts. Tooltip, table and announcements say \"No data\". | `trend` with nulls and `trend` with the same 7 rows deleted render the same gap; `dirty` fixtures; property test that no segment connects across a missing index | R5 |\n| F3 | Input that cannot be plotted as given is reported, never guessed. The diagnostic registry (section 3.5) fixes each case's level, what is drawn and what the reader sees. | One test per code; the combined `dirty` fixture and the four one-bad-value fixtures yield exactly the codes listed in section 3.5 | R5, D5 |\n| F4 | Three temporal types, never mixed silently. **Calendar dates** (`2026-02-24`, `2026-02`, `2026`) read the same in every viewer time zone. **Instants** (epoch milliseconds declared `type: 'time'`, `Date` objects, ISO strings with an offset) are shown in `timeZone` (default: the viewer's), with the zone named in the tooltip heading and the description. **Wall-clock times** (date-time strings without an offset) are shown as written, with hint AX112. Instants that all fall on the same time of day, whole days apart, raise hint AX111 (\"these look like calendar dates\"). A bare number is never assumed to be an instant. | Four fixture variants in UTC, America/Los_Angeles and Asia/Kolkata: (a) date strings: identical text in all three; (b) ISO strings with `Z`, (c) epoch ms with `type: 'time'`, (d) `Date` objects: each zone's correct local text, zone visible, AX111 raised; with `timeZone: 'UTC'` or `type: 'date'`: identical. Plus: both DST transitions, a leap day, an unparseable date | R3 |\n| F5 | No smoothing. When a line is denser than the screen, the drawing is simplified with this guarantee: for every device-pixel column, and every contiguous run of valid samples inside it, the drawn stroke covers exactly that run's minimum and maximum. A break between two runs is always kept, even when both fall in one pixel column; a slot a series merely has no row for (weekly data beside daily) does not break its line. Stacked areas are simplified on their cumulative sums. Exact values always come from the data, not the drawing. | Assertions on which source samples the drawing kept, for: one outlier in 1,000,000; two peaks and a gap in one column; alternating valid and missing samples; tied extremes; device pixel ratio 1 and 2; several zoom levels. A sample that the drawing dropped is still reachable by keyboard and in the table | D8, D9 |\n| F6 | Numbers and dates are formatted for the page locale. Ticks and readouts are formatted separately: ticks may be compact (`50K`); tooltip, table and announcements show the full integer part, and the fraction with up to six significant digits not counting the fraction's leading zeros (`123,456.75`; `0.000123456`; `0.1 + 0.2` reads `0.3`), with the unit. A custom formatter that throws falls back to the default and raises a diagnostic. | Expected strings for chosen values (large integers, small decimals, percentages, zoned times) in `en-US`, `de-DE` and `en-IN` | R4 |\n| F7 | Domains follow one order of precedence: the zoomed view is inside the author's `domain` if given, otherwise inside the automatic domain. The automatic domain contains all data, reference lines and stack totals, and ends at the first tick at or beyond each extreme. A field declared `scale: 'percent'` (0–100) or `'ratio'` (0–1) ends at full scale only when its maximum is at least half of full scale and not above it. Nothing is inferred from a label. | Property tests; `bars` ends at 100 when declared `percent`; a 4% maximum ends at the first tick at or above 4% | R1 |\n| F8 | Donut: slices keep the given order, start at 12 o'clock and run clockwise. The legend shows every slice's value and percentage as text, in slice order. A zero slice is listed without an arc; a `null` slice is listed as \"No data\". A negative value is AX120 and the chart shows its error state. With more than eight slices, the seven largest are drawn and the rest are grouped as \"Other (n)\", with AX121; the table lists every category. An all-zero donut shows the empty state. | `parts` fixture; one test per case | R7, landscape scoreboard 3.1 |\n| F9 | Up to eight series, no two share a color. Beyond eight, each series still has a unique combination of color and dash or marker, and AX130 is raised. | Tests with 6, 8 and 12 series | R7 |\n| F10 | Stacks place positive and negative values on their own sides of zero, and the axis covers both totals. A missing component is drawn with zero height and the stack is marked \"incomplete\" in tooltip, table and announcements. | Property test on stacked geometry; mixed-sign and incomplete fixtures | R5 |\n| F11 | Line, area and scatter are drawn in x order whatever the input order. On line, area and bar, two rows with the same x in one series are AX108 and that series is not drawn. On scatter, points sharing an x (or both coordinates) are ordinary data. | Shuffled `trend` renders identically; duplicate fixture | R5 |\n| F12 | When a warning means values were left out or changed, the chart says so to the reader: a short note (\"2 values not shown. See table.\") inside the figure and in the accessibility tree, in every build. | Production build given `dirty` shows the note | R5, R6 |\n\n### 3.2 Legibility\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| L1 | No visible text overlaps other text or is clipped, and no label disappears without the reader being told. Remedies, in order: thin (time, date, numeric and `ordered` category axes only); wrap to two lines; rotate up to 45°; truncate in the middle, keeping every label distinct, with the full text in tooltip and table. If labels still do not fit, a visible note (\"Some labels hidden. See table.\") appears and AX143 suggests horizontal bars. Axylo never changes a chart's orientation on its own. | In real browsers, after fonts load: for widths 240–1,920 px and generated label sets, zero intersecting text boxes (1 px tolerance), zero text outside the figure, truncated labels pairwise distinct. Repeated with the WCAG 1.4.12 text-spacing overrides, 200% text-only zoom, and a font that loads late | R2 |\n| L2 | Text is at least 12 CSS px and at least 4.5:1 against what is behind it, including text drawn inside a mark and legend entries for hidden series. Marks, axis lines and focus indicators are at least 3:1. Gridlines are exempt: they are not needed to read a value while the tooltip and table exist. Holds in light and dark. | Computed-style and rendered-pixel checks in both schemes | R7, R10 |\n| L3 | The chart follows its container with no call from the page, in both directions. With no definite height, the plot is 16:9, clamped between 160 and 480 CSS px tall, and the title, controls and table flow above and below it. A container that starts hidden or zero-sized draws when it gets a size. | Resize 720 → 360 → 720 px; hidden-then-shown test; `height: auto` container is stable over 10 frames | R16, D1 |\n| L4 | Light or dark is taken from the chart element's computed `color-scheme`; if that is not set, from the luminance of the inherited text color. `--axylo-background` overrides both. Marks repaint within one frame when the scheme, forced colors, contrast preference, or the `class`, `style` or `data-theme` of `<html>` or `<body>` changes. Forced-colors mode uses system colors. | A page that sets `color-scheme`; a class-toggled dark theme without it; a light-only page on a dark device (must stay light); a runtime toggle; forced-colors emulation | R10 |\n| L5 | A marker on every point appears only when adjacent points are at least 12 px apart (provisional value), and always for isolated points. | `trend` at 720 px has none; a 12-point line has them | R8 |\n| L6 | Title, subtitle and axis titles with units are part of the chart. Axis titles never overlap tick labels. | Layout tests; `trend` fixture | R9 |\n| L7 | Empty data shows a message inside the plot area; so do loading, error and Axylo's own internal failures. No invented axis ranges, no blank box. A change of state is announced once, politely. | `empty` fixture: message visible and in the accessibility tree, no tick labels; forced internal error shows the error state | R6 |\n| L8 | When the figure cannot hold a readable plot (less than 120×80 CSS px for the plot), it shows the title, the one-line summary and the table control instead, and raises AX142. | Narrow and short container tests | R2 |\n\n### 3.3 Interaction\n### 3.5 Diagnostic registry\n\nLevel decides delivery. **Error**: the chart or a series cannot be drawn; the chart shows its error state. **Warning**: something is not drawn as given; the reader sees the note in F12. **Hint**: advice for the author. Errors and warnings print once per code per page in every build; hints print in development builds only. `strict: true` throws on errors and warnings found while validating a create, `update` or `append` call, synchronously from that call. A diagnostic that can only arise later (a contrast check after the page's CSS changes, a custom formatter that throws when a table page is built, a label that stops fitting after a resize) is reported when it is found and is never thrown. Every diagnostic names the chart; those about data name the field and the first row indexes in the caller's own data.\n\n| Code | Level | Condition | What is drawn |\n|---|---|---|---|\n| AX100 | Error | Typed columns have different lengths | Error state; the message names the columns and their lengths |\n| AX101 | Error | A named field is not a key of any row | Error state; the message lists the keys that exist and the closest match |\n| AX102 | Warning | A field is absent (`undefined`) in some rows | Gaps |\n| AX103 | Warning | A value is `NaN` or infinite | Gap |\n| AX104 | Hint | Every non-missing value of a value field is a plain decimal string (`'40'`, `'-1.5'`) | Parsed and drawn; the message suggests `parse: 'number'`. An empty string counts as missing |\n| AX105 | Hint | Steps are absent on a regular time, date, wall-clock or number axis | Gaps. When a series would need more absent steps than twice its observations (and more than 1,000), it is treated as irregular instead: no gaps are created and the hint says so |\n| AX106 | Warning | A value field mixes numbers with strings, or holds strings that are not plain decimals (`'1,234'`, `'n/a'`) | The strings are not drawn |\n| AX107 | Warning | A date or time cannot be parsed | That row is not drawn |\n| AX108 | Error | Duplicate x within a series, or duplicate donut labels | That series, or the donut, is not drawn |\n| AX109 | Hint | Numbers on an axis declared `time` look like seconds, or a numeric x looks like epoch milliseconds without `type: 'time'` | As declared |\n| AX110 | Warning | An author domain on bar or area excluded zero | Domain widened to zero |\n| AX111 | Hint | Instants look like calendar dates | As instants, zone shown |\n| AX112 | Hint | Date-time strings have no offset | As written |\n| AX120 | Error | Negative donut value | Error state |\n| AX121 | Warning | More than eight donut slices | Seven largest plus \"Other (n)\" |\n| AX130 | Warning | More than eight series | All series, with dash or marker differences |\n| AX140 | Warning | No `title` and no `labelledBy` | Generated name |\n| AX141 | Warning | Palette below 3:1 on the resolved background | As themed |\n| AX142 | Hint | Plot too small to draw | Summary and table control |\n| AX143 | Hint | Labels hidden after every remedy | Note shown to the reader |\n| AX150 | Warning | Unknown option key | Ignored; the message suggests the closest known key |\n| AX151 | Warning | `append` rows out of order | Accepted through the slower full update |\n| AX131 | Hint | A compact chart has more than one series | Drawn, with dash differences |\n| AX132 | Hint | More bars than pixels along the category axis | Drawn; the message suggests aggregating |\n| AX133 | Hint | A scatter chart has more than 50,000 points | Drawn; the message says drawing may be slow |\n| AX134 | Error | Series × x positions exceeds 20,000,000 (long rows with many series and little shared x) | Error state; the message gives both counts and suggests fewer series or a scatter chart |\n| AX152 | Warning | `timeZone` is not a zone the browser knows | The viewer's zone is used |\n| AX160 | Warning | A custom formatter threw | The default format is used for that value |\n\nExpected results for the Phase 1 fixtures: the combined `dirty` fixture (`[10, 20, null, NaN, '40', undefined, 70]`) yields AX102, AX103 and AX106 once each, draws Mon–Tue as a segment and Sun as a point, and shows the F12 note. `dirty-string` (one `'40'` among numbers) yields AX106. A column made only of numeric strings yields AX104 and is drawn in full. `dirty-null` yields nothing.\n\nThe split between AX104 and AX106 answers a reviewer's objection that common back ends return counts as strings (Postgres `bigint` and `numeric`, BigQuery): a whole column of plain decimal strings is unambiguous and is parsed; a stray string among numbers is a bug and is not.\n\n### 3.6 Type matrix\n\n| | Line | Area | Bar | Donut | Scatter |\n|---|---|---|---|---|---|\n| Picking by pointer | Nearest x | Nearest x | The band under the pointer | The slice under the pointer | Nearest point within 24 px; ties go to the later row |\n| Tooltip content | Every visible series at that x | Same, plus the stack total | Every series in that category | Label, value, percentage | The point's series, x and y; coincident points listed, up to eight |\n| Keyboard order | By x, then series | By x, then series | By category, then series | By slice order | By x, then y |\n| Zoom | Yes | Yes | On time, date and numeric x only | No | Yes, both axes later; x only in 1.0 |\n| Simplified drawing when dense | F5 | F5 on cumulative sums | No; more bars than pixels raises a hint | No | No in 1.0; above 50,000 points a hint says drawing may be slow |\n| Limit that raises a diagnostic | Eight series | Eight series | Eight series | Eight slices | Eight series |\n| Reference lines and bands | Yes; included in the domain; listed in the summary and table caption | Yes | Yes | No | Yes |\n\n### 3.7 Compact variant\n\n`compact: true` on line, area and bar draws the marks and nothing else: no axes, gridlines, legend, toolbar, table control, zoom or tooltip. It is for a small tile where the page already shows the number and the label.\n\n| ID | Criterion | Verified by |\n|---|---|---|\n| C1 | A compact chart is a static image with a full text alternative: `role=\"img\"`, an accessible name (as in A1, including AX140 when none is given) and the generated summary as its description (series, x range, minimum, maximum, last value, omissions). It has no tab stop and no pointer-only behavior, so nothing is available to a mouse that is not available to a keyboard. | Accessibility-tree snapshot; a page of 40 has zero added tab stops |\n| C2 | The fidelity rules still hold: zero baseline for bar and area (F1), gaps (F2), diagnostics (F3), simplified drawing (F5), sorting (F11), no motion (I5), scheme from the page (L4). | The same fixtures as the full charts |\n| C3 | It fills its container at any size from 24×16 CSS px up; with no definite height it is 32 px tall. | Size tests |\n| C4 | With more than one series, lines differ by dash as well as color, since there is no legend; AX131 suggests one series per compact chart. | Two-series fixture |\n| C5 | When values were left out (F12), the description says so and a small marker with a text equivalent appears in the corner. | `dirty` fixture in compact mode |\n\nA compact chart does not give access to every value; the summary is its alternative. An author who needs every value reachable uses the full chart.\n\n","exit_code":0,"status":"completed"}}
