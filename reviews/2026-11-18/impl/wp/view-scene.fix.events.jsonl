me(value => value > 0) ? zero : null;\n  let negative = negativeTotal.some(value => value < 0) ? zero : null;\n  let lower = positive || negative ? packEdges(positive, negative) : zero.xy;\n\n  if (positive && negative) {\n    addSeam(seams, zero, range, stack.order[0]!, 2, i => negativeTotal[i]! < 0, i => positiveTotal[i]! > 0, () => true);\n  }\n\n  for (let k = 0; k < stack.order.length; k++) {\n    const series = stack.order[k]!;\n    const { y, slot } = view.frame.series[series]!;\n    const draw = view.drawSlots[series]!;\n    const local = { start: draw.start - start, end: draw.end - start };\n    const pos = extendBoundary(fillInput, positive, stack.positive[k]!, start, end);\n    const neg = extendBoundary(fillInput, negative, stack.negative[k]!, start, end);\n    const upper = pos === positive && neg === negative ? lower : packEdges(pos, neg);\n    const runs: number[] = [];\n    if (pos && positive) {\n      addRun(runs, pos, positive, local, 0, 0);\n      if (pos !== positive) addSeam(seams, pos, local, series, 4,\n        i => pos.values[i]! > 0, i => pos.values[i]! < positiveTotal[i]!,\n        i => pos.values[i] !== positive!.values[i]);\n    }\n    if (neg && negative) {\n      addRun(runs, neg, negative, local, (pos?.xy.length ?? 0) / 2, (positive?.xy.length ?? 0) / 2);\n      if (neg !== negative) addSeam(seams, neg, local, series, 4,\n        i => neg.values[i]! < 0, i => neg.values[i]! > negativeTotal[i]!,\n        i => neg.values[i] !== negative!.values[i]);\n    }\n    areas.push({ type: 'area', series, upper, lower, runs: Uint32Array.from(runs), fill: seriesPaint(series), opacity: 0.8 });\n    positive = pos;\n    negative = neg;\n    lower = upper;\n\n    const positiveLine = stack.positive[k]!;\n    const negativeLine = stack.negative[k]!;\n    const length = draw.end - draw.start;\n    let hasNegative = false;\n    let hasNonNegative = false;\n    for (let i = draw.start; i < draw.end && !(hasNegative && hasNonNegative); i++) {\n      if (y[i]! < 0) hasNegative = true;\n      else if (y[i]! >= 0) hasNonNegative = true;\n    }\n    const line = hasNegative && hasNonNegative\n      ? Float64Array.from(y.subarray(draw.start, draw.end), (value, i) =>\n        (value < 0 ? negativeLine : positiveLine)[draw.start + i]!)\n      : (hasNegative ? negativeLine : positiveLine).subarray(draw.start, draw.end);\n    addLine({\n      ...input, x: input.x.subarray(draw.start, draw.end), y: line, slot: slot.subarray(draw.start, draw.end),\n      range: { start: 0, end: length },\n    }, view, series, {\n      start: view.visibleSlots.start - draw.start, end: view.visibleSlots.end - draw.start,\n    }, compact, paths, points);\n  }\n}\nimport {\n  SLOT_VALUE, type AlignedView, type Projection, type Rect, type RectMark, type XScale,\n} from '../core/contracts';\nimport { clamp, position, seriesPaint, token } from './geometry';\n\ntype Bands = Extract<Projection, { kind: 'bands' }>;\n\nfunction bandExtents(\n  scale: XScale, values: Float64Array, start: number, end: number, low: number, high: number,\n): Float64Array {\n  const extents = new Float64Array((end - start) * 2);\n  for (let i = start, out = 0; i < end; i++) {\n    const value = values[i]!;\n    const center = position(scale, value);\n    let halfWidth: number;\n    if (scale.type === 'band') {\n      halfWidth = scale.bandwidth / 2;\n    } else {\n      const left = i > 0 ? Math.abs(center - position(scale, values[i - 1]!)) : Infinity;\n      const right = i + 1 < values.length ? Math.abs(position(scale, values[i + 1]!) - center) : Infinity;\n      // A continuous bar has no band width in its projection. Use the closest neighbour in x.\n      const step = Math.min(left, right);\n      halfWidth = 0.4 * (Number.isFinite(step) && step > 0 ? step : high - low);\n    }\n    extents[out++] = clamp(center - halfWidth, low, high);\n    extents[out++] = clamp(center + halfWidth, low, high);\n  }\n  return extents;\n}\n\nexport function barMarks(view: AlignedView, projection: Bands, plot: Rect): RectMark[] {\n  const { band, value, horizontal } = projection;\n  const { start, end } = view.visibleSlots;\n  const { stack } = view;\n  const order = stack?.order ?? view.visible.flatMap((shown, i) => shown ? [i] : []);\n  const low = horizontal ? plot.y : plot.x;\n  const high = low + (horizontal ? plot.height : plot.width);\n  const valueLow = horizontal ? plot.x : plot.y;\n  const valueHigh = valueLow + (horizontal ? plot.width : plot.height);\n  const baseline = (v: number) => clamp(position(value, v), valueLow, valueHigh);\n  const extents = bandExtents(band, view.frame.x.values, start, end, low, high);\n  const positives = stack?.positive.at(-1);\n  const divisor = stack ? 1 : order.length;\n  const bars: RectMark[] = [];\n  const missing: RectMark[] = [];\n\n  for (let i = 0; i < order.length; i++) {\n    const series = order[i]!;\n    const { slot, y } = view.frame.series[series]!;\n    const pos = stack?.positive[i];\n    const neg = stack?.negative[i];\n    const prevPos = stack?.positive[i - 1];\n    const prevNeg = stack?.negative[i - 1];\n    let valid = 0;\n    for (let j = start; j < end; j++) if (slot[j] === SLOT_VALUE) valid++;\n    const values = new Float32Array(valid * 4);\n    const absent = new Float32Array((end - start - valid) * 4);\n    let valueOffset = 0;\n    let missingOffset = 0;\n\n    for (let j = start, k = 0; j < end; j++, k += 2) {\n      const bandStart = extents[k]!;\n      const part = (extents[k + 1]! - bandStart) / divisor;\n      const width = Math.max(1, part);\n      const mid = bandStart + part * ((stack ? 0 : i) + 0.5);\n      const across = clamp(mid - width / 2, low, Math.max(low, high - width));\n      const isValue = slot[j] === SLOT_VALUE;\n      const negative = isValue && y[j]! < 0;\n      const base = (negative ? prevNeg?.[j] : prevPos?.[j]) ?? 0;\n      const tip = isValue ? (negative ? neg?.[j] : pos?.[j]) ?? y[j]! : base;\n      let from = baseline(base);\n      const to = baseline(tip);\n      if (stack && (base !== 0 || negative && positives![j]! > 0) && Math.abs(to - from) > 1 &&\n        position(value, base) === from) {\n        // Leave the shared edge clear without moving the outside end of the stack.\n        from += Math.sign(to - from);\n      }\n\n      const rects = isValue ? values : absent;\n      let offset = isValue ? valueOffset : missingOffset;\n      const along = Math.min(from, to);\n      const length = Math.abs(to - from);\n      rects[offset++] = horizontal ? along : across;\n      rects[offset++] = horizontal ? across : along;\n      rects[offset++] = horizontal ? length : width;\n      rects[offset++] = horizontal ? width : length;\n      if (isValue) valueOffset = offset;\n      else missingOffset = offset;\n    }\n\n    bars.push({ type: 'rects', series, xywh: values, fill: seriesPaint(series), variant: 'bar' });\n    if (absent.length) missing.push({ type: 'rects', series, xywh: absent, fill: token('muted'), variant: 'missing' });\n  }\n  return bars.concat(missing);\n}\nimport type { Paint, PaintToken, RuleMark, XScale } from '../core/contracts';\n\nconst LIMIT = 2 ** 120;\n\nexport const token = (name: PaintToken): Paint => ({ kind: 'token', name });\nexport const seriesPaint = (index: number): Paint => ({ kind: 'series', index });\n\nexport function position(scale: XScale, value: number): number {\n  if (scale.type === 'band') return scale.center(value);\n  const pixel = scale.map(value);\n  // Far outside an author domain, extrapolation can overflow the packed Float32 geometry.\n  if (Number.isNaN(pixel)) {\n    const [start, end] = scale.range;\n    if (start === end) return start;\n    return (value < scale.domain[0]) === (start < end) ? -LIMIT : LIMIT;\n  }\n  return clamp(pixel, -LIMIT, LIMIT);\n}\n\nexport function clamp(value: number, from: number, to: number): number {\n  return Math.max(from, Math.min(to, value));\n}\n\nexport function rule(\n  role: RuleMark['role'], paint: Paint, x1: number, y1: number, x2: number, y2: number,\n): RuleMark {\n  return { type: 'rule', role, x1, y1, x2, y2, stroke: paint, strokeWidth: 1, dash: null };\n}\nimport type {\n  AreaMark, BandMark, DonutView, Layout, Mark, Paint, PathMark, PointMark, Projection, Rect, RuleMark, Scene, View,\n} from '../core/contracts';\nimport { addArea, addStackedAreas } from './areas';\nimport { barMarks } from './bars';\nimport { clamp, position, rule, seriesPaint, token } from './geometry';\nimport { addLine, drawing, scatterPoints } from './lines';\n\ntype Plot = Extract<Layout, { kind: 'plot' }>;\ntype Cartesian = Exclude<Projection, { kind: 'ring' }>;\n\nconst TICK_LENGTH = 4;\n\nfunction axes(projection: Cartesian) {\n  return projection.kind === 'bands'\n    ? { x: projection.band, y: projection.value, horizontal: projection.horizontal }\n    : { x: projection.x, y: projection.y, horizontal: false };\n}\n\nfunction gridAndAxes(layout: Plot, projection: Cartesian): { grid: RuleMark[]; edges: RuleMark[] } {\n  const { x, y, horizontal } = axes(projection);\n  const { x: left, y: top, width, height } = layout.plot;\n  const right = left + width;\n  const bottom = top + height;\n  const axis = token('axis');\n  const gridPaint = token('grid');\n  const grid: RuleMark[] = [];\n  const edges = [rule('axis', axis, left, bottom, right, bottom), rule('axis', axis, left, top, left, bottom)];\n  const bottomScale = horizontal ? y : x;\n  const leftScale = horizontal ? x : y;\n  for (const tick of horizontal ? layout.yTicks : layout.xTicks) {\n    const pixel = position(bottomScale, tick.value);\n    if (pixel < left || pixel > right) continue;\n    edges.push(rule('tick', axis, pixel, bottom, pixel, bottom + TICK_LENGTH));\n  }\n  for (const tick of horizontal ? layout.xTicks : layout.yTicks) {\n    const pixel = position(leftScale, tick.value);\n    if (pixel < top || pixel > bottom) continue;\n    edges.push(rule('tick', axis, left - TICK_LENGTH, pixel, left, pixel));\n  }\n  for (const tick of layout.yTicks) {\n    const pixel = position(y, tick.value);\n    if (horizontal && pixel >= left && pixel <= right) grid.push(rule('grid', gridPaint, pixel, top, pixel, bottom));\n    if (!horizontal && pixel >= top && pixel <= bottom) grid.push(rule('grid', gridPaint, left, pixel, right, pixel));\n  }\n  return { grid, edges };\n}\n\nfunction references(view: Exclude<View, DonutView>, projection: Cartesian, plot: Rect): {\n  bands: BandMark[]; lines: RuleMark[];\n} {\n  const { x, y, horizontal } = axes(projection);\n  const bands: BandMark[] = [];\n  const lines: RuleMark[] = [];\n  const paint = token('reference');\n  for (const { axis, from, to } of view.references) {\n    const scale = axis === 'x' ? x : y;\n    const across = (axis === 'x') !== horizontal;\n    const start = across ? plot.x : plot.y;\n    const end = start + (across ? plot.width : plot.height);\n    const a = position(scale, from);\n    const b = position(scale, to);\n    if (from === to) {\n      if (a < start || a > end) continue;\n      lines.push(across ? rule('reference', paint, a, plot.y, a, plot.y + plot.height)\n        : rule('reference', paint, plot.x, a, plot.x + plot.width, a));\n    } else {\n      const low = clamp(Math.min(a, b), start, end);\n      const high = clamp(Math.max(a, b), start, end);\n      if (low === high) continue;\n      const box = across ? { ...plot, x: low, width: high - low } : { ...plot, y: low, height: high - low };\n      bands.push({ type: 'band', box, fill: paint, opacity: 0.12 });\n    }\n  }\n  return { bands, lines };\n}\n\nfunction arcMarks(view: DonutView, projection: Extract<Projection, { kind: 'ring' }>): Mark[] {\n  const angles: number[] = [];\n  const fills: Paint[] = [];\n  for (let k = 0; k < view.slices.length; k++) {\n    const slice = view.slices[k]!;\n    if (slice.angles === null) continue;\n    angles.push(...slice.angles);\n    fills.push(slice.key === '__other__' && slice.members.length > 1 ? token('muted') : seriesPaint(k));\n  }\n  if (!angles.length) return [];\n  const { cx, cy, r0, r1 } = projection;\n  return [{ type: 'arcs', cx, cy, r0, r1, angles: Float32Array.from(angles), fills, gap: 1 }];\n}\n\nexport function buildScene(view: View, layout: Layout, devicePixelRatio: number): Scene {\n  const { width, height } = layout;\n  if (layout.kind !== 'plot' && layout.kind !== 'compact') {\n    return { width, height, clip: { x: 0, y: 0, width, height }, marks: [] };\n  }\n  const { plot: clip, projection } = layout;\n  if (projection.kind === 'ring' || view.kind === 'donut') {\n    const marks = projection.kind === 'ring' && view.kind === 'donut' ? arcMarks(view, projection) : [];\n    return { width, height, clip, marks };\n  }\n\n  const compact = layout.kind === 'compact' || view.compact;\n  const { grid, edges } = layout.kind === 'plot' && !compact ? gridAndAxes(layout, projection) : { grid: [], edges: [] };\n  const { bands, lines } = compact ? { bands: [], lines: [] } : references(view, projection, clip);\n  const layers: (readonly Mark[])[] = [bands, grid];\n  if (view.kind === 'bar' && projection.kind === 'bands') {\n    layers.push(barMarks(view, projection, clip));\n  } else if (view.kind === 'scatter' && projection.kind === 'xy') {\n    layers.push(scatterPoints(view, projection));\n  } else if ((view.kind === 'line' || view.kind === 'area') && projection.kind === 'xy') {\n    const areas: AreaMark[] = [];\n    const seams: PathMark[] = [];\n    const paths: PathMark[] = [];\n    const points: PointMark[] = [];\n    const dpr = Number.isFinite(devicePixelRatio) && devicePixelRatio > 0 ? devicePixelRatio : 1;\n    const draw = drawing(view.frame.x.values, projection, clip, dpr);\n    if (view.kind === 'area' && view.stack) {\n      addStackedAreas(draw, view, view.stack, compact, areas, seams, paths, points);\n    } else {\n      for (let i = 0; i < view.frame.series.length; i++) {\n        if (!view.visible[i]) continue;\n        const { slot, y } = view.frame.series[i]!;\n        const input = { ...draw, range: view.drawSlots[i]!, slot, y };\n        if (view.kind === 'area') addArea(input, view, i, compact, areas, paths, points);\n        else addLine(input, view, i, view.visibleSlots, compact, paths, points);\n      }\n    }\n    layers.push(areas, seams, paths, points);\n  }\n  layers.push(edges, lines);\n  return { width, height, clip, marks: layers.flat() };\n}\nimport {\n  SLOT_VALUE, type AlignedView, type IndexRange, type PathMark, type PointMark, type Projection,\n  type Rect, type ScatterView, type SeriesCue,\n} from '../core/contracts';\nimport { buildPath, buildPoints, simplifyLine, type JoinedRuns, type LineInput } from '../simplify';\nimport { position, seriesPaint } from './geometry';\n\nexport type XY = Extract<Projection, { kind: 'xy' }>;\nexport type Drawing = Omit<LineInput, 'y' | 'slot' | 'range'> & {\n  readonly mapX: (x: number) => number;\n  readonly mapY: (y: number) => number;\n};\n\nexport function drawing(x: Float64Array, xy: XY, plot: Rect, devicePixelRatio: number): Drawing {\n  return {\n    x, mapX: value => position(xy.x, value), mapY: value => position(xy.y, value),\n    left: plot.x, width: plot.width, devicePixelRatio,\n  };\n}\n\nfunction markerIndexes(\n  input: LineInput & Drawing, range: IndexRange, isolated: Uint32Array, compact: boolean,\n): Uint32Array {\n  if (compact) return isolated;\n  const { slot, x, mapX } = input;\n  let count = 0;\n  let first = range.end;\n  let last = range.start;\n  for (let i = range.start; i < range.end; i++) {\n    if (slot[i] !== SLOT_VALUE) continue;\n    if (count++ === 0) first = i;\n    last = i;\n  }\n  if (!count) return isolated;\n  const span = Math.abs(mapX(x[last]!) - mapX(x[first]!));\n  const showAll = count <= 1 || span >= 12 * (count - 1);\n  const capacity = showAll ? count : Math.min(count, Math.floor(span / 80) + 1 + isolated.length);\n  const indexes = new Uint32Array(capacity);\n  let write = capacity;\n  let previous = Infinity;\n  let single = isolated.length - 1;\n  // Walk back from the last observed value so the series always has its identity at that end.\n  for (let i = last; i >= first; i--) {\n    if (slot[i] !== SLOT_VALUE) continue;\n    const pixel = mapX(x[i]!);\n    const required = isolated[single] === i;\n    if (required) single--;\n    if (showAll || required || Math.abs(previous - pixel) >= 80) {\n      indexes[--write] = i;\n      previous = pixel;\n    }\n  }\n  return indexes.subarray(write);\n}\n\nfunction pointMark(series: number, cue: SeriesCue, xy: Float32Array): PointMark {\n  return { type: 'points', series, xy, shape: cue.marker, size: 6, fill: seriesPaint(series) };\n}\n\nexport function addLine(\n  input: LineInput & Drawing, view: AlignedView, series: number, visible: IndexRange, compact: boolean,\n  paths: PathMark[], points: PointMark[], selection: JoinedRuns = simplifyLine(input),\n): void {\n  const cue = view.cues[series]!;\n  if (selection.indexes.length) {\n    paths.push({\n      type: 'path', series, xy: buildPath(selection.indexes, selection.breaks, input), stroke: seriesPaint(series),\n      strokeWidth: 2, dash: cue.dash,\n    });\n  }\n  const markers = markerIndexes(input, visible, selection.isolated, compact);\n  if (markers.length) points.push(pointMark(series, cue, buildPoints(markers, input)));\n}\n\nexport function scatterPoints(view: ScatterView, projection: XY): PointMark[] {\n  const result: PointMark[] = [];\n  for (let i = 0; i < view.frame.series.length; i++) {\n    if (!view.visible[i]) continue;\n    const { x, y } = view.frame.series[i]!;\n    const { start, end } = view.visiblePoints[i]!;\n    const xy = new Float32Array(2 * (end - start));\n    for (let index = start, out = 0; index < end; index++) {\n      xy[out++] = position(projection.x, x[index]!);\n      xy[out++] = position(projection.y, y[index]!);\n    }\n    result.push(pointMark(i, view.cues[i]!, xy));\n  }\n  return result;\n}\n\n","exit_code":0,"status":"completed"}}
