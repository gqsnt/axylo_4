Set<string>();\n   289\t  /** Increases with every delivery pass; a pass started inside author code supersedes the outer one. */\n   290\t  let destroyed = false;\n   291\t  let internalError: unknown = null;\n   292\t  /** `append` was called at least once: the pause control is offered (spec I6). */\n   293\t  let streaming = false;\n   294\t  let paused = false;\n   295\t  /** While paused: the store's newest frame and its findings, accepted but not shown. */\n   296\t  let held: { frame: Frame; dataDiagnostics: readonly DiagnosticInput[]; viewDiagnostics: readonly DiagnosticInput[] } | null = null;\n   297\t  /**\n   298\t   * The displayed snapshot's row ownership: what the marks on screen came from (see the invariants at the top\n   299\t   * of this file). `frozen` holds the caller's rows of that frame once the store had to let go of its revision.\n   300\t   */\n   301\t  let onScreen: { frame: Frame; store: Store | null; frozen: Map<number, unknown> | null } | null = null;\n   302\t  /** Frames a store produced (their rows live in that store's revisions). */\n   303\t  const storeFrames = new WeakSet<Frame>();\n   304\t  /**\n   305\t   * Rows copied out of the store for a frame that still needs them after the store moved on: the displayed\n   306\t   * frame, the pending (accepted, not yet drawn) one and the one being published each own theirs, so none of\n   307\t   * them pins the store's history (final review, finding 2).\n   308\t   */\n   309\t  let frozenRows = new WeakMap<Frame, Map<number, unknown>>();\n   310\t  /** The rows of `frame` by source index: its copy when it has one, else its source. */\n   311\t  const rowOf = (frame: Frame, row: number): unknown => {\n   312\t    const own = frozenRows.get(frame);\n   313\t    return own ? own.get(row) ?? null : frame.source.rowAt(row);\n   314\t  };\n   315\t  /** What the store held right after the last release with a frame on screen: the bound's baseline. */\n   316\t  let retainedBaseline = 0;\n   