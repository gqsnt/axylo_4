ce row. To keep a pick's cost independent of the\n636-   * number of points, positions may be compared after rounding to the device-pixel lattice (an error of at most\n637-   * 0.71 device px); the datum's reported values are always exact. A donut slice too thin to see is drawn,\n638-   * and picked, at a minimum of 1 CSS px of arc; its value and share are reported unchanged.\n639-   */\n640:  pick(px: number, py: number): PickTarget | null;\n641-  tooltip(target: PickTarget): TooltipModel;\n642-  /** The datum to focus when the keyboard takes over from a pointer target. */\n643-  primary(target: PickTarget): DatumRef | null;\n644-  datum(ref: DatumRef): DatumText | null;\n645-  /** Where the datum is drawn, for the cursor and focus ring; null if it is not visible. */\n646-  anchor(ref: DatumRef): Rect | null;\n   110\texport interface CartesianOptions {\n   111\t  /** Default true on time, date and number x axes. 'touch' also captures pinch and two-finger drag on touch screens. */\n   112\t  zoom?: boolean | 'touch';\n   113\t  reference?: readonly Reference[];\n   114\t}\n   115\t\n   116\t/** Line, area and bar only. Marks only, as a static image with a text alternative: no axes, legend, toolbar, table, zoom or tooltip. */\n   117\texport interface CompactOption { compact?: boolean }\n   118\t\n   119\texport type LineOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row>;\n   120\texport type AreaOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { stacked?: boolean };\n   121\texport type BarOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { layout?: 'grouped' | 'stacked'; horizontal?: boolean };\n   122\t/** Scatter relates two measures: its x is a number, an instant or a date, never a category. */\n   123\texport type ScatterXField<Row> = XKey<Row> | ({ field: XKey<Row>; type?: 'number' | 'time' | 'date'; ordered?: never } & Omit<XFieldOptions, 'type' | 'ordered'>);\n   124\texport type ScatterOptions<Row> = CommonOptions<Row> & CartesianOptions & { x: ScatterXField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> };\n   125\texport type DonutOptions<Row> = CommonOptions<Row> & { label: SeriesKey<Row>; value: ValueField<Row> };\n   126\t\n   127\t// ---------- handle ----------\n   128\t\n   129\t/**\n   130\t * `x`, and the two ends of a `zoom` event, are in the form `zoom()` accepts for the axis: a Date for instants,\n   131\t * 'YYYY-MM-DD' for calendar dates, an ISO date-time without offset for wall-clock times, the category for a\n   132\t * category axis, otherwise the number. They can be passed to another chart's `zoom()` unchanged. A position that\n   133\t * a Date or a string cannot hold exactly (between milliseconds, or between days) is given as a number, which\n   134\t * `zoom()` reads as the same position.\n   135\t */\n   136\texport interface Point<Row> { series: string; x: XValue; y: number | null; row: Row | null; index: number }\n   137\t\n   138\texport interface ChartEvents<Row> {\n   139\t  hover: Point<Row> | null;\n   140\t  select: Point<Row>;\n   141\t  zoom: readonly [XValue, XValue] | null;\n   142\t}\n   143\t\n   144\texport interface Chart<Row, Options> {\n   145\t  /**\n   146\t   * Changes options. Keys present replace the old value; a key set to `undefined` returns to its default; absent keys stay.\n   147\t   * Validation and diagnostics are synchronous (a `strict` chart throws here and keeps its last valid state); drawing happens on the next frame.\n   148\t   */\n   149\t  update(patch: Partial<Options>): void;\n   150\t  /** Adds rows at the end. `keep` = number of distinct x values retained; older ones are dropped. */\n   151\t  append(rows: readonly Row[], options?: { keep?: number }): void;\n   152\t  /** Sets the visible x range; `null` shows everything. */\n   153\t  zoom(domain: readonly [XValue, XValue] | null): void;\n   154\t  on<E extends keyof ChartEvents<Row>>(event: E, listener: (payload: ChartEvents<Row>[E]) => void): () => void;\n   155\t  /** Diagnostics for the current options and data. Up to date as soon as create, update or append returns. */\n   156\t  readonly diagnostics: readonly Diagnostic[];\n   157\t  destroy(): void;\n   158\t}\n   159\t\n   160\texport type Target = string | HTMLElement;\n","exit_code":0,"status":"completed"}}
