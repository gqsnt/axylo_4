nDiagnostic: (d: Diagnostic) => { if (resume && d.code === 'AX103') { resume = false; r.controller.actions.pause(false); } },\n   536\t    });\n   537\t    r.frames();\n   538\t    r.controller.handle.append([{ x: 2, y: 3, w: 3 }]);\n   539\t    r.frames();\n   540\t    r.controller.actions.pause(true);\n   541\t    r.controller.handle.append([{ x: 3, y: 4, w: Number.NaN }]);\n   542\t    resume = true;\n   543\t    r.controller.handle.update({ y: 'w' });\n   544\t    r.frames();\n   545\t    expect(resume).toBe(false);\n   546\t    // Running again, so nothing may stay held: the arrival at x 3 is on screen.\n   547\t    expect(xsOf(r)).toContain(3);\n   548\t    r.controller.handle.append([{ x: 4, y: 5, w: 5 }]);\n   549\t    r.frames();\n   550\t    expect(xsOf(r)).toContain(4);\n   551\t  });\n   552\t\n   553\t  it('a missing-field AX101 goes once a valid held append is resumed', () => {\n   554\t    const r = record('line', { title: 'A', data: [{ x: 0 }, { x: 1 }], x: 'x', y: 'y' });\n   555\t    r.frames();\n   556\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX101');\n   557\t    r.controller.actions.pause(true);\n   558\t    r.controller.handle.append([{ x: 2, y: 3 }]);\n   559\t    r.controller.actions.pause(false);\n   560\t    r.frames();\n   561\t    expect(r.controller.handle.diagnostics.map(d => d.code)).not.toContain('AX101');\n   562\t    expect(xsOf(r)).toContain(2);\n   563\t  });\n   564\t});\n   565\t\n   566\tdescribe('final review, displayed snapshots: two series on line, bar and scatter, with re-entry from event handlers', () => {\n   567\t  type Op =\n   568\t    | { op: 'append'; n: number; keep: number | null } | { op: 'title' } | { op: 'data' } | { op: 'reencode' }\n   569\t    | { op: 'pause' } | { op: 'resume' } | { op: 'zoom'; from: number; width: number } | { op: 'unzoom' } | { op: 'frame' }\n   570\t    | { op: 'fail'; stage: 'view' | 'layout' | 'scene' | 'lookup' | 'reader' | 'draw' | 'figure' } | { op: 'h