{"type":"item.completed","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"git show bbd7564:packages/axylo/test/core/host.ts | nl -ba; ls -d node_modules/*test*; rg -n 'startVitest\\\\(|function createVitest|function prepareVitest' node_modules/vitest/dist -g '*.js' -g '*.d.ts' | head -25\"","aggregated_output":"     1\t/**\n     2\t * A recording host for driving the chart controller in Node (the method of the core review): a manual\n     3\t * animation-frame queue, and substitutes for the figure, the renderers and the interaction layer that keep\n     4\t * what they were given. Sizes come from a small model of the figure's CSS: the plot gets what the caption\n     5\t * and the controls leave of the container.\n     6\t */\n     7\timport type { Layout, PlacedText, Scene, TextStyle } from '../../src/core/contracts';\n     8\timport { createController, type ChartKind, type Controller, type Host, type Size } from '../../src/core/controller';\n     9\timport type { FigureModel } from '../../src/dom/figure';\n    10\timport type { Committed, ControlsState } from '../../src/dom/interaction';\n    11\timport { TOKEN_BINDINGS } from '../../src/theme';\n    12\t\n    13\texport interface Recording {\n    14\t  readonly host: Host;\n    15\t  readonly controller: Controller;\n    16\t  /** Runs every queued animation frame (and those they queue), at most `limit` rounds. */\n    17\t  frames(limit?: number): number;\n    18\t  readonly pending: number;\n    19\t  draws: Scene[];\n    20\t  texts: (readonly PlacedText[])[];\n    21\t  models: FigureModel[];\n    22\t  announcements: string[];\n    23\t  prepared: ControlsState[];\n    24\t  committed: Committed | null;\n    25\t  commits: number;\n    26\t  clears: number;\n    27\t  themeCalls: { keys: readonly string[]; colors: Record<string, string> }[];\n    28\t  printed: string[];\n    29\t  disposed: number;\n    30\t  /** Host writes (figure, renderer, text, interaction) made after `dispose`. */\n    31\t  writesAfterDispose: number;\n    32\t  /** The last surfaces(visible) call: false while the error revision hides marks and text. */\n    33\t  surfaces: boolean;\n    34\t  /** The container (CSS px). The plot's height is what the caption and the controls leave. */\n    35\t  container: { width: number; height: number } | null;\n    36\t  /** Height of one caption line and of the controls row in the model of the figure. */\n    37\t  readonly lineHeight: number;\n    38\t  ids: Record<string, string>;\n    39\t  readonly layout: Layout | null;\n    40\t}\n    41\t\n    42\texport interface HostOptions {\n    43\t  readonly container?: { width: number; height: number } | null;\n    44\t  readonly console?: boolean;\n    45\t  readonly timeZone?: string;\n    46\t  readonly locale?: string;\n    47\t  readonly textWidth?: Host['measurer']['width'];\n    48\t  readonly captionLineHeight?: number;\n    49\t  /** The page's `lang` (A10); 'en' when not given. */\n    50\t  readonly pageLang?: string;\n    51\t  /** The target element's own id (an untitled chart's name in diagnostics). */\n    52\t  readonly targetId?: string;\n    53\t  /** Called inside the interaction layer's commit, as the DOM layer calls hover while it presents. */\n    54\t  readonly onCommit?: (state: Committed, controller: Controller) => void;\n    55\t}\n    56\t\n    57\texport function record(kind: ChartKind, options: Record<string, unknown>, settings: HostOptions = {}): Recording {\n    58\t  const queue = new Map<number, (time?: number) => void>();\n    59\t  /** Animation frame time: one value per batch of callbacks, as a browser gives it. */\n    60\t  let clock = 0;\n    61\t  let handles = 0;\n    62\t  const rec = {\n    63\t    draws: [] as Scene[], texts: [] as (readonly PlacedText[])[], models: [] as FigureModel[], announcements: [] as string[],\n    64\t    prepared: [] as ControlsState[], committed: null as Committed | null, commits: 0, clears: 0,\n    65\t    themeCalls: [] as { keys: readonly string[]; colors: Record<string, string> }[], printed: [] as string[], disposed: 0,\n    66\t    writesAfterDispose: 0, surfaces: true,\n    67\t    container: settings.container === undefined ? { width: 720, height: 400 } : settings.container,\n    68\t    lineHeight: settings.captionLineHeight ?? 20, ids: {} as Record<string, string>,\n    69\t  };\n    70\t  let model: FigureModel | null = null;\n    71\t  let controls: ControlsState | null = null;\n    72\t  const style: TextStyle = { font: '400 12px sans-serif', letterSpacing: 0, wordSpacing: 0, lineHeight: 15 };\n    73\t\n    74\t  /** The plot size the model figure gives: container minus caption (title, subtitle, visible summary) and controls. */\n    75\t  function plotSize(): Size | null {\n    76\t    const box = rec.container;\n    77\t    if (box === null) return null;\n    78\t    let used = 0;\n    79\t    if (model && !model.compact) {\n    80\t      if (model.title?.visible) used += rec.lineHeight;\n    81\t      if (model.subtitle) used += rec.lineHeight;\n    82\t      if (model.summaryVisible) used += 2 * rec.lineHeight;\n    83\t      if (model.note) used += rec.lineHeight;\n    84\t    }\n    85\t    if (controls && controls.interactive) {\n    86\t      // The legend and toolbar take a row; the fallback offers only the table control, which is a row too\n    87\t      // but shorter (no legend).\n    88\t      used += controls.tooSmall ? rec.lineHeight : 1.5 * rec.lineHeight;\n    89\t    }\n    90\t    return { width: box.width, height: box.height - used };\n    91\t  }\n    92\t\n    93\t  const host: Host = {\n    94\t    id: 'axylo-test',\n    95\t    targetId: settings.targetId ?? null,\n    96\t    console: settings.console === false ? null : {\n    97\t      warn: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n    98\t      info: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n    99\t      error: (...args: unknown[]) => {