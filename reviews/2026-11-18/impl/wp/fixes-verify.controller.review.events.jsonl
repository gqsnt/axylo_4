.reference.forEach((reference, row) => {\n   233\t      unknownKeys(object(reference), ['x', 'y', 'label'], sink, 'reference[' + row + '].');\n   234\t    });\n   235\t  }\n   236\t\n   237\t  const { table, valid: validTable } = retained ? { table: retained, valid: true } : resolveTable(options.data, sink);\n   238\t  const xInput = donut ? options.label : options.x;\n   239\t  const x = resolveX(xInput, type, compact, sink);\n   240\t  const wide = !donut && Array.isArray(options.y);\n   241\t  const supportsWide = type !== 'scatter' && !donut;\n   242\t  const valueInputs = wide ? options.y as readonly unknown[] : [donut ? options.value : options.y];\n   243\t  // Only the first value field supplies the shared axis's tick formatter.\n   244\t  const values = valueInputs.map((field, index) =>\n   245\t    resolveValue(field, wide ? 'y[' + index + '].' : donut ? 'value.' : 'y.', compact ? COMPACT_TICKS : donut ? DONUT_TICKS\n   246\t      : index > 0 ? 'The y fields share one value axis, labelled by y[0].tickFormat.' : null, sink));\n   247\t  const series = !wide && !donut && typeof options.series === 'string' ? options.series : null;\n   248\t  if (wide && options.series !== undefined) {\n   249\t    report(sink, 'AX150', 'none', { field: 'series', count: 1, detail: 'Use a single y field when naming a series field.' });\n   250\t  }\n   251\t  if (wide && !supportsWide) {\n   252\t    report(sink, 'AX150', 'chart-error', { field: 'y', count: 1, detail: 'Use a single y field for scatter charts.' });\n   253\t  }\n   254\t\n   255\t  let valid = validTable && (!wide || supportsWide);\n   256\t  const fields: [string | null, string][] = [[fieldName(xInput), donut ? 'label' : 'x']];\n   257\t  for (const input of valueInputs) fields.push([fieldName(input), donut ? 'value' : 'y']);\n   258\t  if (values.length === 0) fields.push([null, 'y']);\n   259\t  if (series !== null) fields.push([series, 'series']);\n   260\t  valid = checkFields(table, fields, sink) && valid;\