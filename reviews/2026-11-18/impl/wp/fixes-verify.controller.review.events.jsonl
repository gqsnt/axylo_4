{\n   153\t    return this.column(row) !== undefined;\n   154\t  }\n   155\t\n   156\t  count(bytes: ByteCount, name: string): void {\n   157\t    for (const [, block] of this.columns) {\n   158\t      const columns = block.table.columns!;\n   159\t      for (const key of Object.keys(columns)) {\n   160\t        const column = columns[key];\n   161\t        if (ArrayBuffer.isView(column)) bytes.add(name, column);\n   162\t      }\n   163\t    }\n   164\t  }\n   165\t\n   166\t  keysAt(row: number): readonly string[] {\n   167\t    return this.column(row)?.table.keys() ?? Object.keys(Object(this.objects.get(row)));\n   168\t  }\n   169\t\n   170\t  hasField(row: number, field: string): boolean {\n   171\t    return this.column(row)?.table.hasField(field) ?? Object.hasOwn(Object(this.objects.get(row)), field);\n   172\t  }\n   173\t\n   174\t  indexes(start: number, incoming: number): Int32Array {\n   175\t    const indexes = new Int32Array(this.size + incoming);\n   176\t    let i = 0;\n   177\t    for (const [index, { table, present }] of this.columns) {\n   178\t      const base = index * blockSize;\n   179\t      for (let offset = 0; offset < table.length; offset++) {\n   180\t        if (present === null || (present & rowBit(offset)) !== 0n) indexes[i++] = base + offset;\n   181\t      }\n   182\t    }\n   183\t    for (const row of this.objects.keys()) indexes[i++] = row;\n   184\t    for (let j = 0; j < incoming; j++) indexes[i++] = start + j;\n   185\t    return indexes;\n   186\t  }\n   187\t}\n   188\t\n   189\ttype Discard = (row: number, column: boolean) => void;\n   190\t\n   191\texport class StreamRows {\n   192\t  private retained = new RawRows();\n   193\t  private positions = new StoreMap<number, number>();\n   194\t  // A sorted, unique column prefix already has a typed position index and implicit source rows.\n   195\t  private seedPositions: Float64Array | null = null;\n   196\t  private seedOffset = 0;\n   197\t  private seedStart = 0;\n   198\t  private previousAtPosition = new StoreMap<number, number>();\n   199\t  private unplaced = new StoreMap<number, number>();\n   200\t  private latestPosition = -Infinity;\n   201\t  onForget?: (row: number) => void;\n   202\t  next: number;\n   203\t\n   204\t  constructor(table?: Table) {\n   205\t    if (table) this.retained.load(table);\n   206\t    this.next = table?.length ?? 0;\n   207\t  }\n   208\t\n   209\t  get size(): number { return this.retained.size; }\n   210\t\n   211\t  fork(): StreamRows {\n   212\t    const draft = new StreamRows();\n   213\t    draft.retained = this.retained.fork();\n   214\t    draft.positions = this.positions.fork();\n   215\t    draft.seedPositions = this.seedPositions;\n   216\t    draft.seedOffset = this.seedOffset;\n   217\t    draft.seedStart = this.seedStart;\n   218\t    draft.previousAtPosition = this.previousAtPosition.fork();\n   219\t    draft.unplaced = this.unplaced.fork();\n   220\t    draft.latestPosition = this.latestPosition;\n   221\t    draft.next = this.next;\n   222\t    return draft;\n   223\t  }\n   224\t\n   225\t  commit(): void {\n   226\t    this.retained.commit();\n   227\t    this.positions.commit();\n   228\t    this.previousAtPosition.commit();\n   229\t    this.unplaced.commit();\n   230\t  }\n   231\t\n   232\t  record(position: number, row: number): void {\n   233\t    if (!Number.isFinite(position)) {\n   234\t      this.unplaced.set(row, this.latestPosition);\n   235\t      return;\n   236\t    }\n   237\t    this.latestPosition = Math.max(position, this.latestPosition);\n   238\t    const previous = this.positions.get(position);\n   239\t    if (previous !== undefined) this.previousAtPosition.set(row, previous);\n   240\t    this.positions.set(position, row);\n   241\t  }\n   242\t\n   243\t  resetPositions(table: Table, positions: Float64Array, seed?: Float64Array): void {\n   244\t    this.positions = new StoreMap();\n   245\t    this.previousAtPosition = new StoreMap();\n   246\t    this.