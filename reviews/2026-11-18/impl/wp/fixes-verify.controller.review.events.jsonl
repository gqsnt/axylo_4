onst order = rows.subarray(0, labels.length);\n   428\t  const values = readValues(table, field, sink, true, 0, undefined, i => included[i] === 1);\n   429\t  const provenance = table.columns && order.length === table.length && field.missing !== 'zero'\n   430\t    ? null : Int32Array.from(order, table.rowIndex);\n   431\t  for (let i = 0; i < order.length; i++) {\n   432\t    const row = order[i]!;\n   433\t    const value = values.y[row]!;\n   434\t    if (value < 0) negatives.add('AX120', 'chart-error', table.rowIndex(row), value);\n   435\t    if (field.missing === 'zero' && (values.slot[row] === SLOT_NULL || values.slot[row] === SLOT_ABSENT_FIELD)) {\n   436\t      values.slot[row] = SLOT_VALUE;\n   437\t      provenance![i] = -1;\n   438\t    }\n   439\t  }\n   440\t  negatives.flush(sink);\n   441\t  const allRows = order.length === table.length;\n   442\t  return {\n   443\t    ...base(table, version), shape: 'donut', labels,\n   444\t    values: allRows && values.y instanceof Float64Array ? values.y : Float64Array.from(order, row => values.y[row]!),\n   445\t    slot: allRows ? values.slot : Uint8Array.from(order, row => values.slot[row]!),\n   446\t    row: provenance,\n   447\t    valueLabel: field.label, unit: field.unit, valueScale: field.scale,\n   448\t  };\n   449\t}\n   450\t\n   451\tinterface AlignedSeed {\n   452\t  readonly options: ResolvedOptions;\n   453\t  readonly type: AlignedChartType;\n   454\t  readonly x: XData;\n   455\t  readonly counts: Map<string, ValueCounts>;\n   456\t  readonly diagnostics: StreamDiagnostics;\n   457\t}\n   458\t\n   459\tconst alignedSeeds = new WeakMap<AlignedFrame, AlignedSeed>();\n   460\t\n   461\texport function alignedSeed(frame: AlignedFrame): AlignedSeed | undefined {\n   462\t  return alignedSeeds.get(frame);\n   463\t}\n   464\t\n   465\texport function normalize(type: AlignedChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): AlignedFrame;\n   466\