unt = 32;\n   704\t  const keys = Array.from({ length: count }, (_, s) => `S${String(s).padStart(2, '0')}`);\n   705\t  // Every series has values at three x positions (one category for bars), so each draws every mark it has.\n   706\t  function rows(xs: readonly unknown[]) {\n   707\t    return keys.flatMap((s, i) => xs.map((x, j) => ({ x, y: 1 + ((i + j) % 5), s })));\n   708\t  }\n   709\t\n   710\t  // What tells one series from another in the scene: its palette colour (eight, spec A5) and whatever else\n   711\t  // its marks carry: a dash, a marker shape, a fill pattern.\n   712\t  function cueOf(marks: readonly Mark[], series: number): string {\n   713\t    const own = marks.filter(mark => 'series' in mark && mark.series === series && !(mark.type === 'rects' && mark.variant === 'missing'));\n   714\t    const colours = new Set<number>();\n   715\t    const parts: string[] = [];\n   716\t    for (const mark of own) {\n   717\t      const paint = mark.type === 'path' ? mark.stroke : 'fill' in mark ? mark.fill : null;\n   718\t      if (paint && typeof paint === 'object' && 'kind' in paint && paint.kind === 'series') colours.add(paint.index % 8);\n   719\t      if (mark.type === 'path') parts.push(`dash ${JSON.stringify(mark.dash.normal)}`);\n   720\t      if (mark.type === 'points') parts.push(`marker ${mark.shape}`);\n   721\t      if (mark.type === 'rects') parts.push(`pattern ${mark.pattern ?? 'none'}`);\n   722\t    }\n   723\t    expect(colours.size, `series ${series} has one colour`).toBe(1);\n   724\t    expect(parts.length, `series ${series} has marks`).toBeGreaterThan(0);\n   725\t    return [...colours, ...new Set(parts)].join(' ');\n   726\t  }\n   727\t\n   728\t  const cases = [\n   729\t    ['line', false], ['area', false], ['bar', false], ['line', true], ['area', true], ['bar', true],\n   730\t  ] as const;\n   731\t  it.each(cases)('%s (compact: %s)', (kind, compact) => {\n   732\t    const xs = kind === 'bar' ? ['only'] : [0, 1, 2];\n   733\t  