   return Number.isInteger(row) && row >= 0 && row < this.end && this.read ? this.read(row) : null;\n   388\t  }\n   389\t\n   390\t  bind(read: (row: number) => unknown): void {\n   391\t    this.read = read;\n   392\t  }\n   393\t\n   394\t  release(): void {\n   395\t    this.read = null;\n   396\t  }\n   397\t}\n   398\t\n   399\texport class RowWindow {\n   400\t  private readonly archived = new RawRows();\n   401\t  private readonly lastSeen = new Map<number, number>();\n   402\t  private readonly evictions = new Map<number, number[]>();\n   403\t  private readonly sources = new Map<number, FrameSource>();\n   404\t  private latestRevision = -Infinity;\n   405\t  private latestEnd = 0;\n   406\t  private rows: StreamRows | null;\n   407\t  private closed = false;\n   408\t\n   409\t  constructor(rows: StreamRows) {\n   410\t    this.rows = rows;\n   411\t  }\n   412\t\n   413\t  get size(): number { return (this.rows?.size ?? 0) + this.archived.size; }\n   414\t  get disposable(): boolean { return this.closed && this.sources.size === 0; }\n   415\t\n   416\t  archive(row: number): void {\n   417\t    const revision = this.latestRevision;\n   418\t    // Newly appended rows can be evicted before any accepted frame has addressed them.\n   419\t    if (!this.sources.has(revision) || row >= this.latestEnd || !this.rows?.archive(row, this.archived)) return;\n   420\t    this.lastSeen.set(row, revision);\n   421\t    let indexes = this.evictions.get(revision);\n   422\t    if (!indexes) this.evictions.set(revision, indexes = []);\n   423\t    indexes.push(row);\n   424\t  }\n   425\t\n   426\t  publish(revision: number, source: FrameSource, rows: StreamRows): void {\n   427\t    this.rows = rows;\n   428\t    this.latestRevision = revision;\n   429\t    this.latestEnd = rows.next;\n   430\t    this.sources.set(revision, source);\n   431\t    source.bind(row => {\n   432\t      const last = this.lastSeen.get(row);\n   433\t      return last === undefined ? this.rows?