face Diagnostic {\n   171\t  /** Stable and documented, one page per code. */\n   172\t  code: `AX${number}`;\n   173\t  level: 'error' | 'warning' | 'hint';\n   174\t  /** What is wrong, where, and how to fix it. */\n   175\t  message: string;\n   176\t  /** The chart it came from: its title, else its element id. */\n   177\t  chart: string;\n   178\t  /** Where applicable. A diagnostic about the chart as a whole (no title, low contrast) has neither. */\n   179\t  field?: string;\n   180\t  /** First offending row indexes in the caller's own data, capped at 10. */\n   181\t  rows?: readonly number[];\n   182\t  count?: number;\n   183\t}\n   184\t\n   185\t/** Runs normalization and validation only. Works without a DOM, so a server or an agent can check options before rendering. */\n   186\t\n   187\t/** Built-in text. Templates use {name} placeholders. Every entry can be replaced through `messages` (spec A10). */\n   188\texport interface Messages {\n   189\t  viewAsTable: string; hideTable: string;\n   190\t  noData: string; noObservation: string; incompleteStack: string;\n   191\t  moreRows: string; otherSlices: string;\n   192\t  valuesNotShown: string; valuesChanged: string; labelsHidden: string;\n   193\t  loading: string; empty: string; error: string; internalError: string;\n   194\t  chartName: string; chartSummary: string; seriesSummary: string; referenceSummary: string; timeZoneNote: string;\n   195\t  plotLabel: string; controlsLabel: string; pointOf: string;\n   196\t  zoomIn: string; zoomOut: string; resetZoom: string; pause: string; resume: string;\n   197\t  previousPage: string; nextPage: string; pageOf: string; jumpToX: string;\n   198\t  showSeries: string; hideSeries: string;\n   199\t  /** Column headers and nouns. */\n   200\t  category: string; percentage: string; series: string; value: string;\n   201\t  /** Chart type names used in generated names and summaries. */\n   202\t  typeLine: string; typeArea: string; typeBar: string; typeScatter: string; typeDonut: string;\n   203\t  /** Summary sentences that have no cartesian form. */\n   204\t  donutSummary: string; seriesNoData: string; seriesNotDrawn: string; referenceLine: string; referenceBand: string;\n   205\t  /** What the keyboard proxy says it is (\"{type} chart\") and how it reads a position. */\n   206\t  plotRole: string; pointAll: string; seriesValue: string; position: string;\n   207\t  /** Label of the stack total in tooltips. */\n   208\t  total: string;\n   209\t  /** Single-click panning (WCAG 2.5.7), the table's \"Jump to\" when nothing matches, and how to move in the plot. */\n   210\t  panLeft: string; panRight: string; jumpNotFound: string; plotInstructions: string;\n   211\t  /** Toolbar toggle: while it is on, two clicks in the plot set the two ends of the zoom range (the non-dragging way to select a range, WCAG 2.5.7). */\n   212\t  selectRange: string;\n   213\t  /** A stack whose components have mixed signs: both ends, in place of one total ('{positive} and {negative}'). */\n   214\t  totalMixed: string;\n   215\t  /** Incomplete stacks in a summary: named when few ('{label}: incomplete at {positions}.'), counted when many ('{label}: {count} incomplete stacks.'). */\n   216\t  incompleteAt: string; incompleteCount: string;\n   217\t  /** Fills `{seeTable}` in `valuesNotShown`, `valuesChanged`, `labelsHidden` and `seriesNotDrawn` when the chart has a table; without one the placeholder is removed. An override without the placeholder is used as written. */\n   218\t  seeTable: string;\n   219\t}\n","exit_code":0,"status":"completed"}}
