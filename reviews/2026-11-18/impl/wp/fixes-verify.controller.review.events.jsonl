{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc \"git show bbd7564:scripts/size.mjs | nl -ba; git ls-tree -r --name-only bbd7564 tests .github | rg -i 'size|dist|workflow'; git grep -n -i -e '89,605' -e '106,738' -e '81920' -e 'size:check' bbd7564 -- STATUS.md package.json .github acceptance tests reviews/2026-11-18/impl/wp/size.analysis.md\"","aggregated_output":"     1\t// What a consumer downloads, minified and gzipped, measured from the packed tarballs (spec DX7, P6; plan M7).\n     2\t//\n     3\t//   node scripts/size.mjs           pack packages/*/dist (scripts/pack.mjs --no-build), measure, print, write bench/size-latest.json\n     4\t//   node scripts/size.mjs --check   the same, and exit 1 when a row exceeds its target: total gzip bytes\n     5\t//                                   compared as integers against targetKiB * 1024 (96 KiB means 98,304 B)\n     6\t//   node scripts/size.mjs --no-pack measure the fixtures already in tests/dist/fixtures\n     7\t//\n     8\t// Every row is built the way a consumer's bundler would build it: esbuild, from inside a fixture that installed\n     9\t// the tarball, minified, with the `production` export condition, so only the packed files and their `exports`\n    10\t// are read. The script-tag row is the two files the documented snippet loads, as shipped.\n    11\t//\n    12\t// Stylesheet: the JavaScript carries the stylesheet as a string and applies it at run time, so a bundler page\n    13\t// downloads it inside its JavaScript and needs no axylo.css; the script-tag snippet also links axylo.css, so\n    14\t// that row adds the file. \"total\" is what each page downloads.\n    15\t//\n    16\t// Targets (spec DX7, set by the owner on 2026-11-18): 96 KiB everything, 80 KiB a page that uses only `line`.\n    17\t// CI runs this script without --check until the targets are met: the flag is correct,\n    18\t// but it is not a gate yet. The rows for each other chart kind alone and for `validate` alone have no target;\n    19\t// they show what tree-shaking leaves.\n    20\t//\n    21\t// The per-module breakdown cannot come from the packed files, which are one pre-bundled file each: it rebuilds\n    22\t// packages/axylo/src with the release build's production settings, imported from scripts/build.mjs (the\n    23\t// minified stylesheet, PRODUCTION constants), reads esbuild's metafile, and states how far that rebuild is from\n    24\t// the packed axylo.js.\n    25\timport { build } from 'esbuild';\n    26\timport fs from 'node:fs';\n    27\timport path from 'node:path';\n    28\timport { gzipSync } from 'node:zlib';\n    29\timport { PRODUCTION, stylesheetPlugin, stylesheets } from './build.mjs';\n    30\timport { fixtureGuard, pack } from './pack.mjs';\n    31\t\n    32\tconst root = path.resolve(import.meta.dirname, '..');\n    33\tconst fixtures = path.join(root, 'tests/dist/fixtures');\n    34\tconst LEVEL = 9;\n    35\tconst gzip = bytes => gzipSync(bytes, { level: LEVEL }).length;\n    36\tconst kib = bytes => +(bytes / 1024).toFixed(2);\n    37\t\n    38\t/** Whether `totalBytes` is over a target given in KiB: integer bytes against targetKiB * 1024, never rounded KiB. */\n    39\texport const exceeds = (totalBytes, targetKiB) => targetKiB !== null && totalBytes > targetKiB * 1024;\n    40\t\n    41\tasync function main() {\n    42\t  if (!process.argv.includes('--no-pack')) pack({ build: false, log: () => {} });\n    43\t  const manifest = JSON.parse(fs.readFileSync(path.join(root, 'tests/dist/.packed/manifest.json'), 'utf8'));\n    44\t\n    45\t  async function consumer({ cwd, contents, external = [], metafile = false }) {\n    46\t    const r = await build({\n    47\t      stdin: { contents, resolveDir: cwd, loader: 'ts', sourcefile: 'consumer.ts' }, absWorkingDir: cwd, bundle: true, minify: true,\n    48\t      format: 'esm', target: 'es2022', conditions: ['production'], external, write: false, metafile, logLevel: 'silent',\n    49\t      plugins: [fixtureGuard([cwd])],\n    50\t    });\n    51\t    const inputs = Object.keys(r.metafile?.inputs ?? {});\n    52\t    return { bytes: r.outputFiles[0].contents, inputs };\n    53\t  }\n    54\t\n    55\t  const npm = path.join(fixtures, 'npm');\n    56\t  const axyloFile = file => fs.readFileSync(path.join(npm, 'node_modules/axylo/dist', file));\n    57\t  const css = axyloFile('axylo.css');\n    58\t\n    59\t  const cases = [\n    60\t    {\n    61\t      entry: 'line only (examples/first-chart/npm.ts)', targetKiB: 80,\n    62\t      build: () => consumer({ cwd: npm, contents: fs.readFileSync(path.join(npm, 'example/npm.ts'), 'utf8') }), cssFile: false,\n    63\t    },\n    64\t    { entry: 'everything (export * from axylo)', targetKiB: 96, build: () => consumer({ cwd: npm, contents: \"export * from 'axylo';\" }), cssFile: false },\n    65\t    ...['area', 'bar', 'scatter', 'donut', 'validate'].map(name => ({\n    66\t      entry: `${name} only (export { ${name} } from axylo)`, targetKiB: null, cssFile: false,\n    67\t      build: () => consumer({ cwd: npm, contents: `export { ${name} } from 'axylo';` }),\n    68\t    })),\n    69\t    { entry: 'script tag (axylo.iife.min.js + axylo.css)', targetKiB: null, build: async () => ({ bytes: axyloFile('axylo.iife.min.js') }), cssFile: true },\n    70\t  ];\n    71\t\n    72\t  const rows = [];\n    73\t  for (const c of cases) {\n    74\t    const { bytes } = await c.build();\n    75\t    const jsGzip = gzip(bytes);\n    76\t    const cssGzip = c.cssFile ? gzip(css) : 0;\n    77\t    const total = jsGzip + cssGzip;\n    78\t    rows.push({\n    79\t      entry: c.entry, minBytes: bytes.length, jsGzipBytes: jsGzip, cssFileGzipBytes: cssGzip, totalGzipBytes: total,\n    80\t      totalKiB: kib(total), targetKiB: c.targetKiB, targetBytes: c.targetKiB === null ? null : c.targetKiB * 1024,\n    81\t      over: exceeds(total, c.targetKiB),\n    82\t    });\n    83\t  }\n    84\t\n    85\t  console.log(`Download size from the packed tarballs (${manifest.packages.axylo.tarball}, packed ${manifest.packedAt}); esbuild minify, gzip level ${LEVEL}`);\n    86\t  console.table(rows.map(r => ({\n    87\t    entry: r.entry, 'min B': r.minBytes, 'js gzip B': r.jsGzipBytes, 'css file gzip B': r.cssFileGzipBytes || '—',\n    88\t    'total KiB': r.totalKiB, 'target KiB': r.targetKiB ?? '—', status: r.targetKiB === null ? 'no target' : r.over ? 'OVER' : 'ok',\n    89\t  })));\n    90\t  console.log(`The stylesheet is ${css.length} B, ${gzip(css)} B gzipped as a file; the same text is inside every JavaScript row above.`);\n    91\t\n    92\t  // Where the bytes of \"everything\" are: the source rebuilt as scripts/build.mjs builds dist/axylo.js.\n    93\t  const src = path.join(root, 'packages/axylo/src');\n    94\t  const { minified } = await stylesheets();\n    95\t  const rebuilt = await build({\n    96\t    entryPoints: [path.join(src, 'index.ts')], bundle: true, target: 'es2022', legalComments: 'none', format: 'esm', minify: true,\n    97\t    define: PRODUCTION, plugins: [stylesheetPlugin(minified)], write: false, metafile: true, logLevel: 'silent', absWorkingDir: root,\n    98\t  });\n    99\t  const packedProd = axyloFile('axylo.js').length;\n   100\t  const out = Object.values(rebuilt.metafile.outputs)[0];\n   101\t  const modules = Object.entries(out.inputs).map(([file, v]) => ({ file: path.relative(src, path.resolve(root, file)), bytes: v.bytesInOutput }))\n   102\t    .sort((a, b) => b.bytes - a.bytes);\n   103\t  const sum = modules.reduce((n, m) => n + m.bytes, 0);\n   104\t  const byDir = new Map();\n   105\t  for (const m of modules) { const d = m.file.includes(path.sep) ? m.file.split(path.sep)[0] : '(root)'; byDir.set(d, (byDir.get(d) ?? 0) + m.bytes); }\n   106\t  const dirs = [...byDir].sort((a, b) => b[1] - a[1]).map(([dir, bytes]) => ({ directory: dir, 'min B': bytes, share: `${((100 * bytes) / sum).toFixed(1)}%` }));\n   107\t  console.log(`\\nPer-module breakdown of \"everything\" (source rebuilt with the release settings: ${rebuilt.outputFiles[0].contents.length} B minified; the packed axylo.js is ${packedProd} B, ${rebuilt.outputFiles[0].contents.length === packedProd ? 'identical in size' : `a difference of ${rebuilt.outputFiles[0].contents.length - packedProd} B, so dist was built from different source`}). Minified bytes before gzip; gzip does not split by module.`);\n   108\t  console.table(dirs);\n   109\t  console.table(modules.slice(0, 25).map(m => ({ module: m.file, 'min B': m.bytes, share: `${((100 * m.bytes) / sum).toFixed(1)}%` })));\n   110\t\n   111\t  fs.mkdirSync(path.join(root, 'bench'), { recursive: true });\n   112\t  fs.writeFileSync(path.join(root, 'bench/size-latest.json'), JSON.stringify({\n   113\t    date: new Date().toISOString(),\n   114\t    method: 'esbuild consumer bundles from tests/dist/fixtures (packed tarballs), minify, production condition; gzip level 9',\n   115\t    packed: { at: manifest.packedAt, axylo: manifest.packages.axylo.integrity },\n   116\t    cssFileBytes: css.length, cssFileGzipBytes: gzip(css), rows,\n   117\t    breakdown: { rebuiltMinBytes: rebuilt.outputFiles[0].contents.length, packedMinBytes: packedProd, directories: dirs, modules },\n   118\t  }, null, 1));\n   119\t\n   120\t  if (process.argv.includes('--check') && rows.some(r => r.over)) {\n   121\t    console.error(`size target exceeded: ${rows.filter(r => r.over).map(r => `${r.entry} ${r.totalGzipBytes} B > ${r.targetBytes} B (${r.targetKiB} KiB)`).join('; ')}`);\n   122\t    process.exit(1);\n   123\t  }\n   124\t}\n   125\t\n   126\tif (path.resolve(process.argv[1] ?? '') === import.meta.filename) await main();\n.github/workflows/ci.yml\ntests/dist/README.md\ntests/dist/browser.ts\ntests/dist/conditions.test.ts\ntests/dist/csp.browser.test.ts\ntests/dist/first-chart.browser.test.ts\ntests/dist/fixtures/npm/consumer.ts\ntests/dist/fixtures/npm/node-import.mjs\ntests/dist/fixtures/npm/package.js