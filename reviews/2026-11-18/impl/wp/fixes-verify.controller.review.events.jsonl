 1]!, positive[start]!));\n   196\t    }\n   197\t    if (reachesRight) {\n   198\t      include(interpolated(x, domain[1], end - 1, end, negative[end - 1]!, negative[end]!));\n   199\t      include(interpolated(x, domain[1], end - 1, end, positive[end - 1]!, positive[end]!));\n   200\t    }\n   201\t  }\n   202\t  return [min, max];\n   203\t}\n   204\t\n   205\tfunction pointExtrema(frame: PointFrame, visible: readonly boolean[], ranges: readonly IndexRange[]): Span {\n   206\t  let min = Infinity;\n   207\t  let max = -Infinity;\n   208\t  for (let i = 0; i < frame.series.length; i++) {\n   209\t    if (!visible[i]) continue;\n   210\t    const { y } = frame.series[i]!;\n   211\t    const { start, end } = ranges[i]!;\n   212\t    for (let j = start; j < end; j++) {\n   213\t      min = Math.min(min, y[j]!);\n   214\t      max = Math.max(max, y[j]!);\n   215\t    }\n   216\t  }\n   217\t  return [min, max];\n   218\t}\n   219\t\n   220\tfunction scatterX(frame: PointFrame, sink: DiagnosticSink): Span {\n   221\t  let min = Infinity;\n   222\t  let max = -Infinity;\n   223\t  let count = 0;\n   224\t  for (const { x, drawable, missingX } of frame.series) {\n   225\t    if (x.length) {\n   226\t      min = Math.min(min, x[0]!);\n   227\t      max = Math.max(max, x[x.length - 1]!);\n   228\t      if (drawable) count += x.length;\n   229\t    }\n   230\t    // Observations with an x and no y belong to the default range too, so the table reaches them (F2).\n   231\t    if (missingX) for (let i = 0; i < missingX.length; i++) {\n   232\t      const v = missingX[i]!;\n   233\t      if (Number.isFinite(v)) { min = Math.min(min, v); max = Math.max(max, v); }\n   234\t    }\n   235\t  }\n   236\t  if (count > 50_000) report(sink, 'AX133', 'none');\n   237\t  return [min, max];\n   238\t}\n   239\t\n   240\tfunction fitZoom(full: Span, zoom: Span | null): Span {\n   241\t  if (!zoom) return full;\n   242\t  const [low, high] = full;\n   243\t  const [start, end] = zoom;\n   2