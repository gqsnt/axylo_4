{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc 'git show bbd7564:packages/axylo/src/core/axes.ts | nl -ba'","aggregated_output":"     1\t/**\n     2\t * Turns a view into the input of `computeLayout`: which axes the chart has, their domains, their candidate\n     3\t * tick sets with labels, and their titles. Also produces the key that decides whether layout must rerun\n     4\t * (plan 2.2: a data-only update reruns layout only when tick labels or margins would change).\n     5\t */\n     6\timport type { TextMeasurer, TextStyle, TickCandidates, View, XKind } from './contracts';\n     7\timport type { LayoutInput } from '../layout';\n     8\timport type { ResolvedOptions } from '../data';\n     9\timport { bandScale, bandTickCandidates, coarserDomains, linearScale, linearTickCandidates, timeScale, timeTickCandidates } from '../scale';\n    10\timport { createNumberTickLabeler, createTimeTickLabel, type NumberFormatOption } from '../format';\n    11\timport type { XValue } from '../public';\n    12\timport { withUnit } from '../reader/table';\n    13\t\n    14\ttype Span = readonly [number, number];\n    15\t\n    16\texport interface AxisContext {\n    17\t  readonly resolved: ResolvedOptions;\n    18\t  readonly locale: string;\n    19\t  readonly compact: boolean;\n    20\t  /** Called once per field when an author tick formatter throws (the chart raises AX160). */\n    21\t  readonly onFormatterError: (field: string, error: unknown) => void;\n    22\t  /** The author gave the x field a `label` (spec L6: only then is a time, date or category axis titled). */\n    23\t  readonly xLabelGiven: boolean;\n    24\t  /** Title of a value axis that shows several fields with no shared label (the `value` message). */\n    25\t  readonly valueTitle: string;\n    26\t}\n    27\t\n    28\tconst scales = {\n    29\t  linear: linearScale,\n    30\t  time: timeScale,\n    31\t  band: bandScale,\n    32\t};\n    33\t\n    34\tfunction numberTicks(domain: Span, locale: string, option: unknown, scale: 'percent' | 'ratio' | null, onError: (e: unknown) => void): TickCandidates {\n    35\t  const tickFormat = typeof option === 'function' || (option !== null && typeof option === 'object')\n    36\t    ? option as NumberFormatOption : null;\n    37\t  return linearTickCandidates(domain, createNumberTickLabeler({ locale, scale, tickFormat, onError }));\n    38\t}\n    39\t\n    40\tfunction temporalTicks(\n    41\t  domain: Span, kind: 'time' | 'date' | 'wall', timeZone: string | null, dateUnit: 'day' | 'month' | 'year' | null,\n    42\t  locale: string, option: unknown, onError: (e: unknown) => void,\n    43\t): TickCandidates {\n    44\t  const format = typeof option === 'function' || (option !== null && typeof option === 'object')\n    45\t    ? option as Parameters<typeof createTimeTickLabel>[0]['format'] : null;\n    46\t  const label = format ? createTimeTickLabel({ kind, timeZone, locale, dateUnit, format, onError }) : null;\n    47\t  return timeTickCandidates(domain, { kind, timeZone, locale, dateUnit, label });\n    48\t}\n    49\t\n    50\tfunction categoryLabels(categories: readonly string[], option: unknown, onError: (e: unknown) => void): readonly string[] {\n    51\t  if (typeof option !== 'function') return categories;\n    52\t  let failed = false;\n    53\t  return categories.map(name => {\n    54\t    try {\n    55\t      return String((option as (value: XValue) => string)(name));\n    56\t    } catch (error) {\n    57\t      if (!failed) onError(error);\n    58\t      failed = true;\n    59\t      return name;\n    60\t    }\n    61\t  });\n    62\t}\n    63\t\n    64\tfunction continuousX(\n    65\t  kind: Exclude<XKind, 'category'>, domain: Span, timeZone: string | null, dateUnit: 'day' | 'month' | 'year' | null,\n    66\t  ctx: AxisContext,\n    67\t) {\n    68\t  const option = ctx.resolved.x.tickFormat;\n    69\t  const onError = (e: unknown) => ctx.onFormatterError(ctx.resolved.x.field, e);\n    70\t  const candidates = kind === 'number'\n    71\t    ? numberTicks(domain, ctx.locale, option, null, onError)\n    72\t    : temporalTicks(domain, kind, timeZone, dateUnit, ctx.locale, option, onError);\n    73\t  return { type: kind === 'number' ? 'linear' as const : 'time' as const, domain, candidates, mayThin: true };\n    74\t}\n    75\t\n    76\t/** What a view's axes are, apart from the size: domains, tick candidates with their labels, titles. */\n    77\ttype AxisParts = Record<string, unknown>;\n    78\t\n    79\t/**\n    80\t * Axis parts per view, with the fields whose author tick formatter threw while their labels were made. The\n    81\t * labels are made once per view and options, so a frame can make them before it writes anything (no author\n    82\t * code runs once publication has started; final review, finding 1), and every layout computed from them,\n    83\t * cached or not, reports the same AX160 (finding 11).\n    84\t */\n    85\tconst axisMemo = new WeakMap<View, { key: readonly unknown[]; parts: AxisParts; failed: readonly string[] }>();\n    86\t\n    87\tfunction axisParts(view: View, ctx: AxisContext): { parts: AxisParts; failed: readonly string[] } {\n    88\t  const key = [ctx.resolved, ctx.locale, ctx.compact, ctx.xLabelGiven, ctx.valueTitle];\n    89\t  const hit = axisMemo.get(view);\n    90\t  if (hit && hit.key.length === key.length && hit.key.every((v, i) => v === key[i])) return hit;\n    91\t  const failed = new Set<string>();\n    92\t  const local: AxisContext = { ...ctx, onFormatterError: field => { failed.add(field); } };\n    93\t  const entry = { key, parts: view.kind === 'donut' ? {} : buildAxisParts(view, local), failed: [...failed] };\n    94\t  axisMemo.set(view, entry);\n    95\t  return entry;\n    96\t}\n    97\t\n    98\t/** The fields whose tick formatter threw while this view's tick labels were made (they are made if needed). */\n    99\texport function tickFormatFailures(view: View, ctx: AxisContext): readonly string[] {\n   100\t  if (view.kind === 'donut') return [];\n   101\t  return axisParts(view, ctx).failed;\n   102\t}\n   103\t\n   104\texport function layoutInput(\n   105\t  view: View, size: { width: number; height: number }, text: { measurer: TextMeasurer; style: TextStyle }, ctx: AxisContext,\n   106\t): LayoutInput {\n   107\t  const { width, height } = size;\n   108\t  if (view.kind === 'donut') return { width, height, kind: 'ring' };\n   109\t  const common = { width, height, compact: ctx.compact, measurer: text.measurer, style: text.style, scales };\n   110\t  return { ...common, ...axisParts(view, ctx).parts } as unknown as LayoutInput;\n   111\t}\n   112\t\n   113\tfunction buildAxisParts(view: Exclude<View, { kind: 'donut' }>, ctx: AxisContext): AxisParts {\n   114\t  const value = ctx.resolved.values[0];\n   115\t  const yOption = value?.tickFormat ?? null;\n   116\t  const onYError = (e: unknown) => ctx.onFormatterError(value?.field ?? 'y', e);\n   117\t  const visibleSeries = view.frame.series.filter((_, i) => view.visible[i]);\n   118\t  const firstScale = 'valueScale' in (visibleSeries[0] ?? {}) ? (visibleSeries[0] as { valueScale: 'percent' | 'ratio' | null }).valueScale : null;\n   119\t  const valueScale = view.kind === 'scatter' ? value?.scale ?? null\n   120\t    : visibleSeries.every(s => (s as { valueScale: unknown }).valueScale === firstScale) ? firstScale : null;\n   121\t  const titles = axisTitles(view, ctx);\n   122\t  const all = numberTicks(view.yDomain, ctx.locale, yOption, valueScale, onYError);\n   123\t  const extent = value?.domain ? null : valueExtent(view);\n   124\t  const full = valueScale === 'percent' ? 100 : valueScale === 'ratio' ? 1 : null;\n   125\t  const y = {\n   126\t    domain: view.yDomain,\n   127\t    // An automatic domain ends at the first drawn tick at or beyond each extreme (F7): layout may only choose\n   128\t    // among the tick sets for which that holds, and a plot too short for all of them takes a wider domain on\n   129\t    // a coarser step, chosen with its ticks. An author's domain is drawn as given.\n   130\t    candidates: extent ? endingCandidates(all, view.yDomain, extent, valueScale) : all,\n   131\t    coarser: extent ? coarserDomains(extent[0], extent[1], view.yDomain, full !== null && view.yDomain[1] === full).map(domain => ({\n   132\t      domain, candidates: endingCandidates(numberTicks(domain, ctx.locale, yOption, valueScale, onYError), domain, extent, valueScale),\n   133\t    })) : undefined,\n   134\t    title: titles.y, mayThin: true,\n   135\t  };\n   136\t\n   137\t  if (view.kind === 'scatter') {\n   138\t    const x = continuousX(view.frame.xKind, view.xDomain, view.frame.timeZone, null, ctx);\n   139\t    // Spec F7: both axes of scatter are value axes. An automatic number x domain (not the author's, not a\n   140\t    // zoomed window) ends at the first drawn tick at or beyond each extreme, like y.\n   141\t    const automatic = view.frame.xKind === 'number' && !ctx.resolved.x.domain &&\n   142\t      view.xDomain[0] === view.xFull[0] && view.xDomain[1] === view.xFull[1];\n   143\t    const xExtent = automatic ? scatterXExtent(view) : null;\n   144\t    const candidates = xExtent ? endingCandidates(x.candidates, view.xDomain, xExtent, null) : x.candidates;\n   145\t    return { kind: 'xy', x: { ...x, candidates, title: titles.x }, y, references: view.references };\n   146\t  }\n   147\t\n   148\t  const column = view.frame.x;\n   149\t  const xTitle = titles.x;\n   150\t  const references = view.references;\n   151\t  const onXError = (e: unknown) => ctx.onFormatterError(ctx.resolved.x.field, e);\n   152\t  if (column.kind === 'category') {\n   153\t    const labels = categoryLabels(column.categories ?? [], ctx.resolved.x.tickFormat, onXError);\n   154\t    const x = {\n   155\t      type: 'band' as const, count: labels.length, padding: view.kind === 'bar' ? 0.2 : 0,\n   156\t      candidates: bandTickCandidates(labels), mayThin: column.ordered, title: xTitle,\n   157\t    };\n   158\t    return view.kind === 'bar'\n   159\t      ? { kind: 'bands', horizontal: view.horizontal, x, y, references }\n   160\t      : { kind: 'xy', x, y, references };\n   161\t  }\n   162\t  // Bars on a continuous x: the view's domain already has room for the outer bars (view/bar-bands.ts), and\n   163\t  // ticks, marks and lookup all use that one domain.\n   164\t  const x = { ...continuousX(column.kind, view.xDomain, column.timeZone, column.dateUnit, ctx), title: xTitle };\n   165\t  return view.kind === 'bar'\n   166\t    ? { kind: 'bands', horizontal: view.horizontal, x, y, references }\n   167\t    : { kind: 'xy', x, y, references };\n   168\t}\n   169\t\n   170\t/** What scatter's automatic x domain was rounded from: the visible points' x and the x references. */\n   171\tfunction scatterXExtent(view: Extract<View, { kind: 'scatter' }>): Span | null {\n   172\t  let lo = Infinity;\n   173\t  let hi = -Infinity;\n   174\t  view.frame.series.forEach((s, i) => {\n   175\t    if (!view.visible[i]) return;\n   176\t    const { start, end } = view.visiblePoints[i]!;\n   177\t    if (end > start) { lo = Math.min(lo, s.x[start]!); hi = Math.max(hi, s.x[end - 1]!); }\n   178\t  });\n   179\t  for (const r of view.references) if (r.axis === 'x') { lo = Math.min(lo, r.from); hi = Math.max(hi, r.to); }\n   180\t  return lo <= hi ? [lo, hi] : null;\n   181\t}\n   182\t\n   183\t/**\n   184\t * What an automatic value domain was rounded from: the visible values (stack totals for a stack), the\n   185\t * reference lines and bands, and zero on bar and area (spec F1, F7).\n   186\t */\n   187\texport function valueExtent(view: Exclude<View, { kind: 'donut' }>): Span | null {\n   188\t  const known = extents.get(view);\n   189\t  if (known !== undefined) return known;\n   190\t  const extent = scanExtent(view);\n   191\t  extents.set(view, extent);\n   192\t  return extent;\n   193\t}\n   194\t\n   195\t/** Views are immutable: the extent is read once per view (layout input and layout key). */\n   196\tconst extents = new WeakMap<View, Span | null>();\n   197\t\n   198\tfunction scanExtent(view: Exclude<View, { kind: 'donut' }>): Span | null {\n   199\t  let lo = Infinity;\n   200\t  let hi = -Infinity;\n   201\t  const take = (v: number) => { if (Number.isFinite(v)) { if (v < lo) lo = v; if (v > hi) hi = v; } };\n   202\t  if (view.kind === 'scatter') {\n   203\t    view.frame.series.forEach((s, i) => {\n   204\t      if (!view.visible[i]) return;\n   205\t      const { start, end } = view.visiblePoints[i]!;\n   206\t      for (let j = start; j < end; j++) take(s.y[j]!);\n   207\t    });\n   208\t  } else if (view.stack) {\n   209\t    const top = view.stack.positive.at(-1);\n   210\t    const bottom = view.stack.negative.at(-1);\n   211\t    const { start, end } = view.kind === 'bar' ? view.drawSlots[0] ?? view.visibleSlots : view.visibleSlots;\n   212\t    for (let j = start; j < end; j++) { if (top) take(top[j]!); if (bottom) take(bottom[j]!); }\n   213\t  } else {\n   214\t    view.frame.series.forEach((s, i) => {\n   215\t      if (!view.visible[i]) return;\n   216\t      const { start, end } = view.kind === 'bar' ? view.drawSlots[i] ?? view.visibleSlots : view.visibleSlots;\n   217\t      for (let j = start; j < end; j++) if (s.slot[j] === 0) take(s.y[j]!);\n   218\t    });\n   219\t  }\n   220\t  for (const r of view.references) if (r.axis === 'y') { take(r.from); take(r.to); }\n   221\t  if (view.kind === 'bar' || view.kind === 'area') take(0);\n   222\t  return lo <= hi ? [lo, hi] : null;\n   223\t}\n   224\t\n   225\t/**\n   226\t * The candidate tick sets whose first and last ticks are the domain's ends and whose step leaves no tick\n   227\t * between an extreme and its end: then the drawn ticks and the domain come from one step (F7). A full-scale\n   228\t * end (percent, ratio) is fixed and need not be the first tick past the data. When no set qualifies (a very\n   229\t * short plot), every set is offered, so the axis still has ticks.\n   230\t */\n   231\texport function endingCandidates(sets: TickCandidates, domain: Span, extent: Span | null, scale: 'percent' | 'ratio' | null): TickCandidates {\n   232\t  if (!extent) return sets;\n   233\t  const [a, b] = domain;\n   234\t  const [lo, hi] = extent;\n   235\t  const full = scale === 'percent' ? 100 : scale === 'ratio' ? 1 : null;\n   236\t  const near = (p: number, q: number) => Math.abs(p - q) <= 1e-9 * Math.max(1, Math.abs(p), Math.abs(q));\n   237\t  const fits = sets.filter(set => {\n   238\t    if (set.length < 2) return false;\n   239\t    const first = set[0]!.value;\n   240\t    const last = set[set.length - 1]!.value;\n   241\t    if (!near(first, a) || !near(last, b) || !(set[1]!.value > first)) return false;\n   242\t    // Compared on the set's own ticks, not on `b - step` (0.2 - 0.1 is below 0.1 in doubles): the first tick\n   243\t    // reaching the maximum is the last one, and the last tick reaching the minimum is the first one.\n   244\t    const reachesHi = (t: number) => t >= hi || near(t, hi);\n   245\t    const reachesLo = (t: number) => t <= lo || near(t, lo);\n   246\t    const upper = (full !== null && near(b, full)) || set.findIndex(t => reachesHi(t.value)) === set.length - 1;\n   247\t    let lowest = -1;\n   248\t    for (let i = set.length - 1; i >= 0; i--) if (reachesLo(set[i]!.value)) { lowest = i; break; }\n   249\t    return upper && lowest === 0;\n   250\t  });\n   251\t  return fits.length ? fits : sets;\n   252\t}\n   253\t\n   254\t/** The axis titles layout draws (spec L6), with their units; undefined where an axis is untitled. */\n   255\tfunction axisTitles(view: Exclude<View, { kind: 'donut' }>, ctx: AxisContext): { x: string | undefined; y: string | undefined } {\n   256\t  if (ctx.compact) return { x: undefined, y: undefined };\n   257\t  if (view.kind === 'scatter') {\n   258\t    return {\n   259\t      x: xTitled(view.frame.xKind, ctx) ? withUnit(view.frame.xLabel, view.frame.xUnit) : undefined,\n   260\t      y: withUnit(view.frame.yLabel, view.frame.yUnit),\n   261\t    };\n   262\t  }\n   263\t  return {\n   264\t    x: xTitled(view.frame.x.kind, ctx) ? withUnit(view.frame.xLabel, ctx.resolved.x.unit) : undefined,\n   265\t    y: withUnit(view.frame.yLabel ?? alignedValueTitle(view.frame.series, ctx.valueTitle), sharedUnit(view.frame.series)),\n   266\t  };\n   267\t}\n   268\t\n   269\t/** Spec L6: a number x is a measure and is titled; time, date and category ticks already say what they are. */\n   270\tfunction xTitled(kind: XKind, ctx: AxisContext): boolean {\n   271\t  return kind === 'number' || ctx.xLabelGiven;\n   272\t}\n   273\t\n   274\t/** A value axis is always titled (spec L6): its label, else its one field, else the generic noun. */\n   275\tfunction alignedValueTitle(series: readonly { readonly field: string }[], generic: string): string {\n   276\t  const first = series[0]?.field;\n   277\t  return first !== undefined && series.every(s => s.field === first) ? first : generic;\n   278\t}\n   279\t\n   280\tfunction sharedUnit(series: readonly { readonly unit: string | null }[]): string | null {\n   281\t  const first = series[0]?.unit ?? null;\n   282\t  return series.every(s => s.unit === first) ? first : null;\n   283\t}\n   284\t\n   285\t/**\n   286\t * Everything layout reads, as comparable parts. Equal keys mean the previous layout is still right: same\n   287\t * size, text style, fonts, locale, domains, categories, titles and formatters.\n   288\t */\n   289\texport function layoutKey(\n   290\t  view: View, size: { width: number; height: number }, style: TextStyle, fontEpoch: number, ctx: AxisContext,\n   291\t): readonly unknown[] {\n   292\t  const base: unknown[] = [size.width, size.height, style.font, style.letterSpacing, style.wordSpacing, style.lineHeight,\n   293\t    fontEpoch, ctx.locale, ctx.compact, view.kind];\n   294\t  if (view.kind === 'donut') return base;\n   295\t  const value = ctx.resolved.values[0];\n   296\t  base.push(view.xDomain[0], view.xDomain[1], view.yDomain[0], view.yDomain[1], ctx.resolved.x.tickFormat,\n   297\t    ctx.resolved.x.label, ctx.resolved.x.unit, value?.tickFormat, value?.label, value?.unit, value?.scale,\n   298\t    ctx.xLabelGiven, ctx.valueTitle, view.references);\n   299\t  // The extremes choose among the tick sets and wider domains of an automatic domain (F7).\n   300\t  const extent = value?.domain ? null : valueExtent(view);\n   301\t  base.push(extent?.[0], extent?.[1]);\n   302\t  base.push(...view.visible);\n   303\t  // The titles as drawn: a unit can change on one series only and change the shared unit (review 2, finding 20).\n   304\t  const titles = axisTitles(view, ctx);\n   305\t  base.push(titles.x, titles.y);\n   306\t  if (view.kind === 'scatter') {\n   307\t    base.push(view.frame.xKind, view.frame.timeZone, view.frame.xLabel, view.frame.yLabel);\n   308\t    return base;\n   309\t  }\n   310\t  const column = view.frame.x;\n   311\t  // No slot indexes: layout reads domains, categories and labels only, never which slots are visible.\n   312\t  base.push(column.kind, column.timeZone, column.dateUnit, column.ordered, view.frame.xLabel, view.frame.yLabel,\n   313\t    view.horizontal, column.categories);\n   314\t  for (const s of view.frame.series) base.push(s.valueScale);\n   315\t  return base;\n   316\t}\n   317\t\n   318\texport function sameKey(a: readonly unknown[] | null, b: readonly unknown[]): boolean {\n   319\t  if (a === null || a.length !== b.length) return false;\n   320\t  for (let i = 0; i < a.length; i++) {\n   321\t    const x = a[i];\n   322\t    const y = b[i];\n   323\t    if (Object.is(x, y)) continue;\n   324\t    // Categories are compared by content: a renormalized frame has a new array with the same names.\n   325\t    if (Array.isArray(x) && Array.isArray(y) && x.length === y.length && x.every((v, k) => v === y[k])) continue;\n   326\t    return false;\n   327\t  }\n   328\t  return true;\n   329\t}\n","exit_code":0,"status":"completed"}}
