 115\t  let left = start;\n   116\t  let right = end;\n   117\t  if (first === end || slot[first] === SLOT_VALUE) {\n   118\t    const outside = nextObservation(slot, start - 1, -1, -1);\n   119\t    if (slot[outside] === SLOT_VALUE) left = outside;\n   120\t  }\n   121\t  if (first === end || slot[last] === SLOT_VALUE) {\n   122\t    const outside = nextObservation(slot, end, slot.length, 1);\n   123\t    if (slot[outside] === SLOT_VALUE) right = outside + 1;\n   124\t  }\n   125\t  // A view between observations can show their connecting segment, but only if both ends exist.\n   126\t  if (first === end && (left === start || right === end)) return range;\n   127\t  return left === start && right === end ? range : { start: left, end: right };\n   128\t}\n   129\t\n   130\tfunction interpolated(x: Float64Array, edge: number, left: number, right: number, a: number, b: number): number {\n   131\t  const start = x[left]!;\n   132\t  const end = x[right]!;\n   133\t  if (edge === start || a === b) return a;\n   134\t  if (edge === end) return b;\n   135\t  const width = end - start;\n   136\t  const t = Number.isFinite(width) ? (edge - start) / width : (edge / 2 - start / 2) / (end / 2 - start / 2);\n   137\t  const delta = b - a;\n   138\t  const value = Number.isFinite(delta) ? a + delta * t : a * (1 - t) + b * t;\n   139\t  return Math.max(Math.min(a, b), Math.min(value, Math.max(a, b)));\n   140\t}\n   141\t\n   142\tfunction alignedExtrema(\n   143\t  frame: AlignedFrame, visible: readonly boolean[], range: IndexRange, draws: readonly IndexRange[],\n   144\t  domain: Span, stack: StackView | null, kind: AlignedView['kind'],\n   145\t): Span {\n   146\t  let min = Infinity;\n   147\t  let max = -Infinity;\n   148\t  const x = frame.x.values;\n   149\t  const { start, end } = kind === 'bar' ? draws[0] ?? range : range;\n   150\t  const negative = stack?.negative.at(-1);\n   151\t  const positive = stack?.positive.at(-1);\n   152\t  if (negative && positive) {\n   153