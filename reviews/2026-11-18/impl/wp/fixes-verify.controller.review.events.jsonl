{"type":"item.completed","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"git show bbd7564:packages/axylo/test/core/final-review.test.ts | nl -ba | sed -n '1,410p'\"","aggregated_output":"     1\t/**\n     2\t * The final review of the controller (reviews/2026-11-18/impl/wp/core-final.controller.review.md): its Node\n     3\t * sequences, each as the reviewer ran it through this host stand-in.\n     4\t */\n     5\timport fc from 'fast-check';\n     6\timport { describe, expect, it } from 'vitest';\n     7\timport type { AlignedView, DatumRef } from '../../src/core/contracts';\n     8\timport type { Diagnostic, Point } from '../../src/public';\n     9\timport { lastModel, record, type Recording } from './host';\n    10\t\n    11\tconst rowsOf = (values: readonly number[]) => values.map(x => ({ x, y: x * 10 }));\n    12\tconst ref = (x: number, seriesKey = 'y'): DatumRef => ({ kind: 'aligned', seriesKey, x });\n    13\tconst xsOf = (r: Recording) => Array.from((r.committed!.view as AlignedView).frame.x.values);\n    14\t\n    15\tfunction hoverRow(r: Recording, x: number, seriesKey = 'y'): Point<unknown> | null | undefined {\n    16\t  let seen: Point<unknown> | null | undefined;\n    17\t  const off = r.controller.handle.on('hover', p => { seen = p; });\n    18\t  r.controller.actions.hover(null);\n    19\t  r.controller.actions.hover(ref(x, seriesKey));\n    20\t  r.frames(1);\n    21\t  off();\n    22\t  return seen;\n    23\t}\n    24\t\n    25\tdescribe('final review, finding 1: a frame keeps its source rows through publication', () => {\n    26\t  it('a tick formatter that appends during the frame: the frame draws 3 and hovering 3 gives its row', () => {\n    27\t    let chart: Recording['controller']['handle'] | null = null;\n    28\t    let armed = false;\n    29\t    const tickFormat = (v: number) => {\n    30\t      if (armed && chart) { armed = false; chart.append([{ x: 4, y: 40 }], { keep: 1 }); }\n    31\t      return String(v);\n    32\t    };\n    33\t    const r = record('line', { title: 'T', data: rowsOf([0, 1, 2]), x: 'x', y: { field: 'y', tickFormat } });\n    34\t    chart = r.controller.handle;\n    35\t    r.frames();\n    36\t    chart.append([{ x: 3, y: 30 }], { keep: 1 });\n    37\t    armed = true;\n    38\t    r.frames(1);\n    39\t    // What the first frame after the append drew, it can describe: its row is still there.\n    40\t    const shownXs = xsOf(r);\n    41\t    const x = shownXs[shownXs.length - 1]!;\n    42\t    const point = hoverRow(r, x);\n    43\t    expect(point?.row).toEqual({ x, y: x * 10 });\n    44\t    r.frames();\n    45\t    expect(xsOf(r)).toEqual([4]);\n    46\t  });\n    47\t\n    48\t  it('no author callback runs once a frame has started writing: tick and value formatters run before the first write', () => {\n    49\t    const calls: string[] = [];\n    50\t    let writes = 0;\n    51\t    const r = record('line', {\n    52\t      title: 'T', data: rowsOf([0, 1, 2]), x: 'x',\n    53\t      y: { field: 'y', tickFormat: (v: number) => { calls.push(`tick@${writes}`); return String(v); }, format: (v: number) => { calls.push(`value@${writes}`); return String(v); } },\n    54\t    });\n    55\t    const draws = () => r.models.length + r.draws.length + r.commits;\n    56\t    r.frames();\n    57\t    writes = draws();\n    58\t    calls.length = 0;\n    59\t    // A title update: everything the frame needs from the author is computed before the figure is written.\n    60\t    r.controller.handle.update({ title: 'U', data: rowsOf([5, 6, 7]) });\n    61\t    const before = draws();\n    62\t    let first: number | null = null;\n    63\t    const original = r.host.figure.update;\n    64\t    (r.host.figure as { update: typeof original }).update = model => { first ??= calls.length; return original(model); };\n    65\t    r.frames();\n    66\t    expect(draws()).toBeGreaterThan(before);\n    67\t    // Every formatter call came before the first host write of the frame.\n    68\t    expect(first).not.toBeNull();\n    69\t    expect(calls.length).toBe(first);\n    70\t  });\n    71\t\n    72\t  it('a stage failing after a callback changed the chart mid-publication does not put the newer update into AX199', () => {\n    73\t    let once = true;\n    74\t    const r = record('line', { title: 'A', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' }, {\n    75\t      onCommit: (_state, controller) => {\n    76\t        if (!once) return;\n    77\t        once = false;\n    78\t        controller.handle.update({ title: 'B' });\n    79\t        throw new Error('the interaction layer failed after the update');\n    80\t      },\n    81\t    });\n    82\t    r.frames();\n    83\t    expect(r.controller.handle.diagnostics.map(d => d.code)).not.toContain('AX199');\n    84\t    expect(lastModel(r).title?.text).toBe('B');\n    85\t    expect(lastModel(r).message).toBeNull();\n    86\t  });\n    87\t\n    88\t  it('destroy() from a hover listener while the frame commits: nothing is published after it, the data is let go', () => {\n    89\t    let destroyedAt = -1;\n    90\t    const r = record('line', { title: 'D', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' }, {\n    91\t      onCommit: (_state, controller) => controller.actions.hover(ref(1)),\n    92\t    });\n    93\t    r.controller.handle.on('hover', () => { destroyedAt = r.commits; r.controller.handle.destroy(); });\n    94\t    r.frames();\n    95\t    expect(destroyedAt).toBeGreaterThan(0);\n    96\t    expect(r.disposed).toBe(1);\n    97\t    expect(r.writesAfterDispose).toBe(0);\n    98\t    expect(r.controller.handle.__dev?.retainedRows()).toBe(0);\n    99\t  });\n   100\t});\n   101\t\n   102\tdescribe('final review, finding 2: keep bounds retention while paused', () => {\n   103\t  it('paused before the frame of an append, 500 more appends with keep 1 and no frames: a bounded store', () => {\n   104\t    const r = record('line', { title: 'K', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n   105\t    r.frames();\n   106\t    r.controller.handle.append([{ x: 2, y: 20 }], { keep: 1 });\n   107\t    r.controller.actions.pause(true);\n   108\t    for (let x = 3; x <= 503; x++) r.controller.handle.append([{ x, y: x }], { keep: 1 });\n   109\t    // Twice what was on screen (two rows) plus the slack of 8, at most: then the frames copy their rows.\n   110\t    expect(r.controller.handle.__dev?.retainedRows()).toBeLessThanOrEqual(12);\n   111\t  });\n   112\t\n   113\t  it('paused with 2 on screen, a frame after every append with keep 1: a bounded store', () => {\n   114\t    const r = record('line', { title: 'K', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n   115\t    r.frames();\n   116\t    r.controller.handle.append([{ x: 2, y: 20 }], { keep: 1 });\n   117\t    r.frames();\n   118\t    r.controller.actions.pause(true);\n   119\t    for (let x = 3; x <= 503; x++) {\n   120\t      r.controller.handle.append([{ x, y: x }], { keep: 1 });\n   121\t      r.frames();\n   122\t    }\n   123\t    // Twice what was on screen (two rows) plus the slack of 8, at most: then the frames copy their rows.\n   124\t    expect(r.controller.handle.__dev?.retainedRows()).toBeLessThanOrEqual(12);\n   125\t    // The paused screen still shows 2, with its row.\n   126\t    expect(xsOf(r)).toEqual([2]);\n   127\t    expect(hoverRow(r, 2)?.row).toEqual({ x: 2, y: 20 });\n   128\t  });\n   129\t});\n   130\t\n   131\tdescribe('final review, finding 3: an append after a failed Resume supersedes the held revision', () => {\n   132\t  it('display 2, pause, append 3, Resume fails, append 4, draw; a title update keeps 4 on screen with its row', () => {\n   133\t    const r = record('line', { title: 'R', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n   134\t    r.frames();\n   135\t    r.controller.handle.append([{ x: 2, y: 20 }], { keep: 1 });\n   136\t    r.frames();\n   137\t    r.controller.actions.pause(true);\n   138\t    r.controller.handle.append([{ x: 3, y: 30 }], { keep: 1 });\n   139\t    r.controller.handle.__dev!.fail('view');\n   140\t    r.controller.actions.pause(false);\n   141\t    r.controller.handle.__dev!.fail(null);\n   142\t    r.frames();\n   143\t    r.controller.handle.append([{ x: 4, y: 40 }], { keep: 1 });\n   144\t    r.frames();\n   145\t    expect(xsOf(r)).toEqual([4]);\n   146\t    r.controller.handle.update({ title: 'R2' });\n   147\t    r.frames();\n   148\t    expect(xsOf(r)).toEqual([4]);\n   149\t    expect(hoverRow(r, 4)?.row).toEqual({ x: 4, y: 40 });\n   150\t    const ax199 = r.controller.handle.diagnostics.filter((d: Diagnostic) => d.code === 'AX199');\n   151\t    expect(ax199).toEqual([]);\n   152\t  });\n   153\t});\n   154\t\n   155\tdescribe('final review, finding 11: a cached layout keeps its findings', () => {\n   156\t  it('a throwing y tick formatter: AX160 and the note survive a loading state and its end at the same size', () => {\n   157\t    const tickFormat = () => { throw new Error('tick'); };\n   158\t    const r = record('line', { title: 'C', data: rowsOf([0, 1, 2]), x: 'x', y: { field: 'y', tickFormat } });\n   159\t    r.frames();\n   160\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX160');\n   161\t    r.controller.handle.update({ state: 'loading' });\n   162\t    r.frames();\n   163\t    r.controller.handle.update({ state: undefined });\n   164\t    r.frames();\n   165\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX160');\n   166\t    expect(lastModel(r).note).toMatch(/shown differently|changed/i);\n   167\t  });\n   168\t});\n   169\t\n   170\tdescribe('final review, finding 12: temporal inputs are snapshots; emitted windows round-trip', () => {\n   171\t  const t = Date.UTC(2026, 0, 1);\n   172\t  const day = 86_400_000;\n   173\t  const data = [0, 1, 2, 3, 4].map(i => ({ x: new Date(t + i * day), y: i }));\n   174\t\n   175\t  it('a Date in x.domain mutated and resubmitted takes effect', () => {\n   176\t    const from = new Date(t);\n   177\t    const x = { field: 'x', domain: [from, new Date(t + 4 * day)] };\n   178\t    const r = record('line', { title: 'D', data, x, y: 'y' });\n   179\t    r.frames();\n   180\t    from.setTime(t + 2 * day);\n   181\t    r.controller.handle.update({ x });\n   182\t    r.frames();\n   183\t    expect((r.committed!.view as AlignedView).xDomain[0]).toBe(t + 2 * day);\n   184\t  });\n   185\t\n   186\t  it('a Date passed to zoom() and mutated later does not move the window', () => {\n   187\t    const r = record('line', { title: 'Z', data, x: 'x', y: 'y' });\n   188\t    r.frames();\n   189\t    const start = new Date(t + day);\n   190\t    r.controller.handle.zoom([start, new Date(t + 3 * day)]);\n   191\t    r.frames();\n   192\t    start.setTime(t);\n   193\t    r.controller.handle.update({ reference: [{ y: 1, label: 'R' }] });\n   194\t    r.frames();\n   195\t    expect((r.committed!.view as AlignedView).xDomain).toEqual([t + day, t + 3 * day]);\n   196\t  });\n   197\t\n   198\t  it('a window between milliseconds is emitted as numbers, which another chart reads as the same window', () => {\n   199\t    const r = record('line', { title: 'Z', data, x: 'x', y: 'y' });\n   200\t    r.frames();\n   201\t    let window: unknown = null;\n   202\t    r.controller.handle.on('zoom', w => { window = w; });\n   203\t    r.controller.actions.zoom([t + 0.25, t + 0.75]);\n   204\t    r.frames();\n   205\t    expect(window).toEqual([t + 0.25, t + 0.75]);\n   206\t    const other = record('line', { title: 'O', data, x: 'x', y: 'y' });\n   207\t    other.frames();\n   208\t    other.controller.handle.zoom(window as never);\n   209\t    other.frames();\n   210\t    expect((other.committed!.view as AlignedView).xDomain).toEqual([t + 0.25, t + 0.75]);\n   211\t  });\n   212\t});\n   213\t\n   214\tdescribe('final review, finding 13: zoom on a compact chart is a reported no-op', () => {\n   215\t  for (const kind of ['line', 'area', 'bar'] as const) {\n   216\t    it(`${kind}: no event, AX150, and nothing applied when compact is turned off`, () => {\n   217\t      const seen: string[] = [];\n   218\t      const r = record(kind, { title: 'C', compact: true, data: rowsOf([0, 1, 2, 3, 4]), x: 'x', y: 'y', onDiagnostic: (d: Diagnostic) => seen.push(d.code) });\n   219\t      r.frames();\n   220\t      let events = 0;\n   221\t      r.controller.handle.on('zoom', () => { events++; });\n   222\t      r.controller.handle.zoom([1, 3]);\n   223\t      r.frames();\n   224\t      expect(events).toBe(0);\n   225\t      expect(seen).toContain('AX150');\n   226\t      r.controller.handle.update({ compact: false });\n   227\t      r.frames();\n   228\t      const view = r.committed!.view as AlignedView;\n   229\t      expect(view.xDomain).toEqual(view.xFull);\n   230\t    });\n   231\t  }\n   232\t});\n   233\t\n   234\tdescribe('final review, finding 14: a watcher that fails part-way leaves nothing registered', () => {\n   235\t  it('the theme observer\\'s observe() throws after its three media listeners registered: all three are removed', async () => {\n   236\t    const { watchTheme } = await import('../../src/theme/watch');\n   237\t    const live = new Set<unknown>();\n   238\t    const list = () => ({\n   239\t      addEventListener: (_: string, fn: unknown) => { live.add(fn); },\n   240\t      removeEventListener: (_: string, fn: unknown) => { live.delete(fn); },\n   241\t    });\n   242\t    const win = {\n   243\t      matchMedia: () => list(),\n   244\t      MutationObserver: class { observe() { throw new Error('observe failed'); } disconnect() {} },\n   245\t    };\n   246\t    const doc = { defaultView: win, documentElement: {} };\n   247\t    const element = { ownerDocument: doc, getRootNode: () => doc };\n   248\t    expect(() => watchTheme(element as unknown as Element, () => {})).toThrow(/observe failed/);\n   249\t    expect(live.size).toBe(0);\n   250\t  });\n   251\t});\n   252\t\n   253\tdescribe('final review, finding 9 and decision 0004 revision 3, rule 5: three readout modes', () => {\n   254\t  const modeOf = (r: Recording) => (r.prepared.at(-1) as unknown as { readoutMode?: string }).readoutMode;\n   255\t  it('a 330 × 205 container: a 92 px plot cannot spare a strip and stay at 80 px, so no readout at all (not floating)', () => {\n   256\t    const r = record('line', { title: 'S', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' }, { container: { width: 330, height: 205 } });\n   257\t    r.frames();\n   258\t    const layout = r.layout!;\n   259\t    if (layout.kind !== 'plot') throw new Error('expected a plot');\n   260\t    expect(layout.plot.height).toBeLessThan(140);\n   261\t    expect(modeOf(r)).toBe('none');\n   262\t    expect(r.prepared.at(-1)!.readout).toBe(false);\n   263\t  });\n   264\t\n   265\t  it('a plot under 140 px that keeps 80 px beside the strip reserves the strip', () => {\n   266\t    const r = record('line', { title: 'S', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' }, { container: { width: 600, height: 250 } });\n   267\t    r.frames();\n   268\t    const layout = r.layout!;\n   269\t    if (layout.kind !== 'plot') throw new Error('expected a plot');\n   270\t    expect(layout.plot.height).toBeLessThan(140);\n   271\t    expect(layout.plot.height).toBeGreaterThanOrEqual(80 + 40);\n   272\t    expect(modeOf(r)).toBe('strip');\n   273\t    expect(r.prepared.at(-1)!.readout).toBe(true);\n   274\t  });\n   275\t\n   276\t  it('a large plot floats', () => {\n   277\t    const r = record('line', { title: 'S', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' }, { container: { width: 720, height: 400 } });\n   278\t    r.frames();\n   279\t    expect(modeOf(r)).toBe('floating');\n   280\t  });\n   281\t});\n   282\t\n   283\tdescribe('final review, finding 15 and amended F7: which axes follow the first-tick rule', () => {\n   284\t  it('a line on x 1.1 to 8.9 spans exactly its data (x is not a value axis)', () => {\n   285\t    const r = record('line', { title: 'L', data: [{ x: 1.1, y: 1 }, { x: 8.9, y: 2 }], x: 'x', y: 'y' });\n   286\t    r.frames();\n   287\t    expect((r.committed!.view as AlignedView).xDomain).toEqual([1.1, 8.9]);\n   288\t  });\n   289\t\n   290\t  it('a scatter on x 1.1 to 8.9: the x domain ends at its first and last drawn ticks, which reach the data', () => {\n   291\t    const r = record('scatter', { title: 'S', data: [{ x: 1.1, y: 1 }, { x: 8.9, y: 2 }], x: 'x', y: 'y' });\n   292\t    r.frames();\n   293\t    const layout = r.layout!;\n   294\t    if (layout.kind !== 'plot' || layout.projection.kind !== 'xy' || layout.projection.x.type === 'band') throw new Error('expected a plot');\n   295\t    const [a, b] = layout.projection.x.domain;\n   296\t    const ticks = layout.xTicks.map(t => t.value);\n   297\t    expect(a).toBeLessThanOrEqual(1.1);\n   298\t    expect(b).toBeGreaterThanOrEqual(8.9);\n   299\t    expect(ticks[0]).toBe(a);\n   300\t    expect(ticks.at(-1)).toBe(b);\n   301\t    // The lookup reads the same projection: the leftmost point is at the domain's place for 1.1.\n   302\t    expect(ticks.find(t => t >= 8.9)).toBe(b);\n   303\t    expect([...ticks].reverse().find(t => t <= 1.1)).toBe(a);\n   304\t  });\n   305\t});\n   306\t\n   307\tdescribe('eighth pass: what describe() reports is what was drawn', () => {\n   308\t  it('a short wide tile whose layout widens the automatic y domain: describe() gives the drawn domain', () => {\n   309\t    const data = Array.from({ length: 40 }, (_, i) => ({ x: i, y: 80 + (i * 37) % 100 }));\n   310\t    const r = record('line', { title: 'Tile', data, x: 'x', y: 'y' }, { container: { width: 1200, height: 180 } });\n   311\t    r.frames();\n   312\t    const layout = r.layout!;\n   313\t    if (layout.kind !== 'plot' || layout.projection.kind !== 'xy') throw new Error('expected a plot');\n   314\t    // The case the harness met: the drawn domain is not the view's (F7 widened it for the short plot).\n   315\t    expect(layout.projection.y.domain).not.toEqual((r.committed!.view as AlignedView).yDomain);\n   316\t    const d = r.controller.handle.__bench!.describe() as { yDomain: readonly number[] | null; plot?: { height: number } | null };\n   317\t    expect(d.yDomain).toEqual(layout.projection.y.domain);\n   318\t    expect(d.plot?.height).toBe(layout.plot.height);\n   319\t  });\n   320\t\n   321\t  it('describe() gives the drawn runs and the basis of kept indexes; memory() lists the chart\\'s own buffers', () => {\n   322\t    const data = [0, 1, 2, 3, 4, 5].map(x => ({ x, y: x === 3 ? null : x }));\n   323\t    const r = record('line', { title: 'Runs', data, x: 'x', y: 'y' });\n   324\t    r.frames();\n   325\t    const bench = r.controller.handle.__bench as unknown as {\n   326\t      describe(): { series: { kept?: number[]; breaks?: number[]; keptBasis?: string; isolatedMarkers?: boolean }[] };\n   327\t      memory(): { bytes: number; buffers: { name: string; bytes: number }[] };\n   328\t    };\n   329\t    const s = bench.describe().series[0]!;\n   330\t    expect(s.kept).toEqual([0, 1, 2, 4, 5]);\n   331\t    expect(s.breaks).toEqual([3]);\n   332\t    expect(s.keptBasis).toBe('rows');\n   333\t    const m = bench.memory();\n   334\t    expect(m.bytes).toBeGreaterThan(0);\n   335\t    expect(m.buffers.reduce((a, b) => a + b.bytes, 0)).toBe(m.bytes);\n   336\t  });\n   337\t});\n   338\t\n   339\tdescribe('final review, finding 7: a call that fails part-way agrees with validate() and with strict', () => {\n   340\t  const bad = () => [{ get x(): number { throw new Error('getter'); }, y: 1 }, { x: 2, y: 2 }];\n   341\t  for (const kind of ['line', 'area', 'bar', 'scatter'] as const) {\n   342\t    it(`${kind}: an unknown option and a throwing x getter: AX150 then AX199, as validate() says`, async () => {\n   343\t      const { staticDiagnostics } = await import('../../src/core/stages');\n   344\t      const options = { title: 'V', palete: 'x', data: bad(), x: 'x', y: 'y' };\n   345\t      const expected = staticDiagnostics(kind, options, 'UTC').map(d => d.code);\n   346\t      expect(expected).toEqual(['AX150', 'AX199']);\n   347\t      const r = record(kind, options);\n   348\t      r.frames();\n   349\t      expect(r.controller.handle.diagnostics.map(d => d.code)).toEqual(expected);\n   350\t    });\n   351\t  }\n   352\t\n   353\t  it('strict: create with them throws, and a strict update with a throwing getter keeps the last good chart', () => {\n   354\t    expect(() => record('line', { title: 'S', strict: true, palete: 'x', data: bad(), x: 'x', y: 'y' })).toThrow();\n   355\t    const r = record('line', { title: 'Good', strict: true, data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   356\t    r.frames();\n   357\t    expect(() => r.controller.handle.update({ title: 'Bad', data: bad() })).toThrow();\n   358\t    r.frames();\n   359\t    expect(lastModel(r).title?.text).toBe('Good');\n   360\t    expect(lastModel(r).message).toBeNull();\n   361\t    expect(r.controller.handle.diagnostics.map(d => d.code)).not.toContain('AX199');\n   362\t  });\n   363\t});\n   364\t\n   365\tdescribe('final review, finding 6 (part): while paused the held window counts for strict', () => {\n   366\t  it('a ninth series held while paused: update({ strict: true }) is rejected, as the append reported AX130', () => {\n   367\t    const data = Array.from({ length: 8 }, (_, k) => ({ x: 0, s: `s${k}`, y: k }));\n   368\t    const r = record('line', { title: 'P', data, x: 'x', y: 'y', series: 's' });\n   369\t    r.frames();\n   370\t    r.controller.handle.append([{ x: 1, s: 's0', y: 1 }]);\n   371\t    r.frames();\n   372\t    r.controller.actions.pause(true);\n   373\t    r.controller.handle.append([{ x: 2, s: 'ninth', y: 1 }]);\n   374\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX130');\n   375\t    expect(() => r.controller.handle.update({ strict: true })).toThrow();\n   376\t  });\n   377\t});\n   378\t\n   379\tdescribe('final review, displayed snapshots: a property over richer call sequences, against an independent model', () => {\n   380\t  type Op =\n   381\t    | { op: 'append'; n: number; keep: number | null } | { op: 'title' } | { op: 'data' } | { op: 'reencode' }\n   382\t    | { op: 'pause' } | { op: 'resume' } | { op: 'zoom'; from: number; width: number } | { op: 'unzoom' } | { op: 'frame' }\n   383\t    | { op: 'fail'; stage: 'view' | 'layout' | 'scene' | 'lookup' | 'reader' | 'draw' | 'figure' } | { op: 'heal' }\n   384\t    | { op: 'collapse' } | { op: 'restore' } | { op: 'reenter' };\n   385\t  const ops = fc.oneof(\n   386\t    fc.record({ op: fc.constant('append' as const), n: fc.integer({ min: 1, max: 3 }), keep: fc.option(fc.integer({ min: 1, max: 6 }), { nil: null }) }),\n   387\t    fc.record({ op: fc.constant('zoom' as const), from: fc.integer({ min: 0, max: 30 }), width: fc.integer({ min: 2, max: 10 }) }),\n   388\t    fc.record({ op: fc.constant('fail' as const), stage: fc.constantFrom('view', 'layout', 'scene', 'lookup', 'reader', 'draw', 'figure') }),\n   389\t    ...(['title', 'data', 'reencode', 'pause', 'resume', 'unzoom', 'frame', 'frame', 'frame', 'heal', 'collapse', 'restore', 'reenter'] as const)\n   390\t      .map(op => fc.constant({ op })),\n   391\t  ) as fc.Arbitrary<Op>;\n   392\t\n   393\t  it('what is drawn after each frame is the model\\'s window, with its caption, its rows and bounded retention', () => {\n   394\t    fc.assert(fc.property(fc.array(ops, { maxLength: 30 }), fc.boolean(), (sequence, destroyAtEnd) => {\n   395\t      const rows = new Map<number, Record<string, unknown>>();\n   396\t      const add = (xs: number[]) => xs.map(x => { const row = { x, a: x % 7, b: -(x % 5) }; rows.set(x, row); return row; });\n   397\t      let reenterOnce = false;\n   398\t      let chart: Recording['controller']['handle'] | null = null;\n   399\t      const format = (v: number) => {\n   400\t        // A formatter calling back into the chart once: the frame stays coherent and the call is drawn next.\n   401\t        if (reenterOnce && chart) { reenterOnce = false; chart.update({ subtitle: `re${v}` }); }\n   402\t        return String(v);\n   403\t      };\n   404\t      const r = record('line', { title: 'M0', data: add([0, 1, 2]), x: 'x', y: { field: 'a', format } });\n   405\t      chart = r.controller.handle;\n   406\t      // The model: the stream's rows (oldest first), what the screen may show, the caption.\n   407\t      let data = [0, 1, 2];\n   408\t      let visible = [0, 1, 2];\n   409\t      let title = 'M0';\n   410\t      let field: 'a' | 'b' = 'a';\n","exit_code":0,"status":"completed"}}
