e points in the pick square, (ceil(49 × ratio) + 1)². Tests pass 0 to force the lattice.\n    45\t   */\n    46\t  readonly exactBudget?: number;\n    47\t}\n    48\t\n    49\t/** Thrown inside an exact pick that ran out of budget; never escapes `pick`. */\n    50\tconst OVER_BUDGET = Symbol('over budget');\n    51\t\n    52\t/**\n    53\t * The pointer index of a scatter view (contract: `Lookup.pick`).\n    54\t *\n    55\t * A pick first compares exact positions. When the points near the pointer make that expensive (all of them\n    56\t * at nearly the same distance, as on a ring around the pointer, or a dense cluster), the pick is redone on a\n    57\t * second index where every point is rounded to the device-pixel lattice and the points of one lattice point\n    58\t * are merged, keeping their count and their latest source row. A lattice pick examines at most the occupied\n    59\t * lattice points near the pointer, so its cost depends on the radius and the pixel ratio, not on the number\n    60\t * of points; a rounded position is off by at most 0.71 device px, and the datum's values stay exact.\n    61\t */\n    62\texport function scatterGrid(\n    63\t  view: ScatterView, layout: PlotLayout & { projection: Extract<PlotLayout['projection'], { kind: 'xy' }> },\n    64\t  count: number, devicePixelRatio: number, options: GridOptions = {},\n    65\t) {\n    66\t  const { plot, projection } = layout;\n    67\t  const columns = Math.floor(plot.width / CELL) + 1;\n    68\t  const rows = Math.floor(plot.height / CELL) + 1;\n    69\t  const series = new Uint32Array(count);\n    70\t  const points = new Uint32Array(count);\n    71\t  const xs = new Float64Array(count);\n    72\t  const ys = new Float64Array(count);\n    73\t  const ratio = Number.isFinite(devicePixelRatio) && devicePixelRatio > 0 ? devicePixelRatio : 1;\n    74\t  const tieDistance = 0.5 / ratio;\n    75\t  const budget = options.exactBudget ?? (Math.ceil(49 * ratio) + 1) ** 2;\n    76\t  let length = 0;\n    77\t  let examined = 0;\n    78\t  let cellsExamined = 0;\n    79\t  let usedLattice = false;\n    80\t\n    81\t  function cellIndex(pixel: number, origin: number, size: number): number {\n    82\t    // Subtracting the origin from a rounded plot edge can place that edge one cell past the grid.\n    83\t    return Math.max(0, Math.min(size - 1, Math.floor((pixel - origin) / CELL)));\n    84\t  }\n    85\t\n    86\t  const column = (x: number) => cellIndex(x, plot.x, columns);\n    87\t  const row = (y: number) => cellIndex(y, plot.y, rows);\n    88\t\n    89\t  function sourceRow(at: number): number {\n    90\t    const i = points[at]!;\n    91\t    return view.frame.series[series[at]!]!.row?.[i] ?? i;\n    92\t  }\n    93\t\n    94\t  view.frame.series.forEach((data, s) => {\n    95\t    if (!view.visible[s] || !data.drawable) return;\n    96\t    const { start, end } = view.visiblePoints[s]!;\n    97\t    for (let i = start; i < end; i++) {\n    98\t      const x = scatterPosition(projection.x, data.x[i]!);\n    99\t      const y = scatterPosition(projection.y, data.y[i]!);\n   100\t      // Exact positions decide what is in the plot, on both indexes.\n   101\t      if (!contains(plot, x, y)) continue;\n   102\t      const at = length++;\n   103\t      xs[at] = x;\n   104\t      ys[at] = y;\n   105\t      series[at] = s;\n   106\t      points[at] = i;\n   107\t    }\n   108\t  });\n   109\t\n   110\t  type Index = (x: number, y: number, limit: number) => ScatterPick | null;\n   111\t\n   112\t  function index(px: Float64Array, py: Float64Array): Index {\n   113\t    const cellFor = (x: number, y: number) => column(x) + columns * row(y);\n   114\t    const heads = new Map<number, number>();\n   115\t    const next = new Int32Array(length);\n   116\t    for (let at = 0; at < length; at++) {\n   117\t      const cell = cellFor(px[at]!, py[at]!);\n   118\t      next[at] = heads.get(cell) ?? -1;\n   119\t      heads.set(cell, at);\n   120\t    }\n   121\t\n   122\t    function later(at: number, other: number): boolean {\n   123\t      const difference = sourceRow(at) - sourceRow(other);\n   124\t      if (difference !== 0) return difference > 0;\n   125\t      const cellDifference = cellFor(px[at]!, py[at]!) - cellFor(px[other]!, py[other]!);\n   126\t      return cellDifference < 0 || cellDifference === 0 && at > other;\n   127\t    }\n   128\t\n   129\t    const order = new Uint32Array(length);\n   130\t    const multiplicity = new Uint32Array(length);\n   131\t    const buckets = new Map<number, Bucket>();\n   132\t    function build(start: number, end: number, allowSkew = true): Bucket {\n   133\t      let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;\n   134\t      let count = 0;\n   135\t      for (let i = start; i < end; i++) {\n   136\t        const p = order[i]!;\n   137\t        minX = Math.min(minX, px[p]!);\n   138\t        maxX = Math.max(maxX, px[p]!);\n   139\t        minY = Math.min(minY, py[p]!);\n   140\t        maxY = Math.max(maxY, py[p]!);\n   141\t        count += multiplicity[p]!;\n   142\t      }\n   143\t      const bounds = { start, end, count, minX, maxX, minY, maxY };\n   144\t      if (end - start <= LEAF_SIZE) {\n   145\t        let latest = order[start]!;\n   146\t        for (let i = start + 1; i < end; i++) {\n   147\t          const at = order[i]!;\n   148\t          if (later(at, latest)) latest = at;\n   149\t        }\n   150\t        return { ...bounds, latest };\n   151\t      }\n   152\t\n   153\t      const byX = maxX - minX >= maxY - minY;\n   154\t      const positions = byX ? px : py;\n   155\t      const pivot = byX ? minX / 2 + maxX / 2 : minY / 2 + maxY / 2;\n   156\t      let mid = start;\n   157\t      for (let i = start; i < end; i++) {\n   158\t        const p = order[i]!;\n   159\t        if (positions[p]! >= pivot) continue;\n   160\t        order[i] = order[mid]!;\n   161\t        order[mid++] = p;\n   162\t      }\n   163\t      const smaller = Math.min(mid - start, end - mid);\n   164\t      const skewed = smaller < (end - start) / 8;\n   165\t      // Keep spatially separated groups together. Consecutive skewed splits need a median to bound depth.\n   166\t      const useSkew = skewed && allowSkew && smaller > 0;\n   167\t      if (skewed && !useSkew) {\n   168\t        order.subarray(start, end).sort((a, b) => positions[a]! - positions[b]!);\n   169\t        mid = start + Math.floor((end - start) / 2);\n   170\t      }\n   171\t      const left = build(start, mid, !useSkew);\n   172\t      const right = build(mid, end, !useSkew);\n   173\t      return { ...bounds, left, right, latest: later(left.latest, right.latest) ? left.latest : right.latest };\n   174\t    }\n   175\t\n   176\t    let end = 0;\n   177\t    for (const [cell, head] of heads) {\n   178\t      const start = end;\n   179\t      let uniform = true;\n   180\t      for (let at = head; at >= 0; at = next[at]!) {\n   181\t        order[end++] = at;\n   182\t        uniform &&= px[at] === px[head] && py[at] === py[head];\n   183\t      }\n   184\t      if (!uniform) order.subarray(start, end).sort((a, b) => px[a]! - px[b]! || py[a]! - py[b]!);\n   185\t\n   186\t      // Group identical positions before splitting the cell, so a median cannot spread them across leaves.\n   187\t      // Keep the latest row as the representative and link the others for the capped tooltip.\n   188\t      let write = start;\n   189\t      for (let i = start; i < end;) {\n   190\t        const first = order[i]!;\n   191\t        const groupStart = i++;\n   192\t        let last = first;\n   193\t        let winner = first;\n   194\t        let beforeWinner = -1;\n   195\t        for (; i < end; i++) {\n   196\t          const at = order[i]!;\n   197\t          if (px[at] !== px[first] || py[at] !== py[first]) break;\n   198\t          next[last] = at;\n   199\t          if (later(at, winner)) {\n   200\t            winner = at;\n   201\t            beforeWinner = last;\n   202\t          }\n   203\t          last = at;\n   204\t        }\n   205\t        next[last] = -1;\n   206\t        if (beforeWinner >= 0) {\n   207\t          next[beforeWinner] = next[winner]!;\n   208\t          next[winner] = first;\n   209\t        }\n   210\t        multiplicity[winner] = i - groupStart;\n   211\t        order[write++] = winner;\n   212\t      }\n   213\t      end = write;\n   214\t      buckets.set(cell, build(start, end));\n   215\t    }\n   216\t\n   217\t    return (x, y, limit) => {\n   218\t      // The window covers every compared position within the radius, and every 0.5 px neighbourhood of one.\n   219\t      const radius = CELL + COINCIDENT;\n   220\t      const left = column(x - radius);\n   221\t      const right = column(x + radius);\n   222\t      const top = row(y - radius);\n   223\t      const bottom = row(y + radius);\n   224\t      const nearby: Bucket[] = [];\n   225\t      for (let cy = top; cy <= bottom; cy++) {\n   226\t        for (let cx = left; cx <= right; cx++) {\n   227\t          cellsExamined++;\n   228\t          const bucket = buckets.get(cx + cy * columns);\n   229\t          if (bucket) nearby.push(bucket);\n   230\t        }\n   231\t      }\n   232\t      const visit = () => {\n   233\t        if (++examined > limit) throw OVER_BUDGET;\n   234\t      };\n   235\t\n   236\t      let nearest = -1;\n   237\t      let best = RADIUS2;\n   238\t      function consider(at: number): void {\n   239\t        visit();\n   240\t        const distance = (px[at]! - x) ** 2 + (py[at]! - y) ** 2;\n   241\t        if (distance < best || distance === best && (nearest < 0 || later(at, nearest))) {\n   242\t          nearest = at;\n   243\t          best = distance;\n   244\t        }\n   245\t      }\n   246\t      function search(bucket: Bucket, distance: number): void {\n   247\t        if (distance > best) return;\n   248\t        if (bucket.left && bucket.right) {\n   249\t          const left = distanceTo(bucket.left, x, y);\n   250\t          const right = distanceTo(bucket.right, x, y);\n   251\t          if (left <= right) {\n   252\t            search(bucket.left, left);\n   253\t            search(bucket.right, right);\n   254\t          } else {\n   255\t            search(bucket.right, right);\n   256\t            search(bucket.left, left);\n   257\t          }\n   258\t        } else {\n   259\t          for (let i = bucket.start; i < bucket.end; i++) consider(order[i]!);\n   260\t        }\n   261\t      }\n   262\t\n   263\t      nearby.sort((a, b) => distanceTo(a, x, y) - distanceTo(b, x, y));\n   264\t      for (const bucket of nearby) search(bucket, distanceTo(bucket, x, y));\n   265\t      if (nearest < 0) return null;\n   266\t\n   267\t      // Measuring from the closest point keeps a chain of near ties from extending the tie window.\n   268\t      const closest = Math.sqrt(best);\n   269\t      function inTie(distance: number): boolean {\n   270\t        return distance <= RADIUS2 && Math.sqrt(distance) - closest < tieDistance;\n   271\t      }\n   272\t      function searchTies(bucket: Bucket): void {\n   273\t        if (!later(bucket.latest, nearest) || !inTie(distanceTo(bucket, x, y))) return;\n   274\t        if (inTie(distanceAcross(bucket, x, y))) {\n   275\t          nearest = bucket.latest;\n   276\t        } else if (bucket.left && bucket.right) {\n   277\t          searchTies(bucket.left);\n   278\t          searchTies(bucket.right);\n   279\t        } else {\n   280\t          for (let i = bucket.start; i < bucket.end; i++) {\n   281\t            const at = order[i]!;\n   282\t            if (!later(at, nearest)) continue;\n   283\t            visit();\n   284\t            if (inTie((px[at]! - x) ** 2 + (py[at]! - y) ** 2)) nearest = at;\n   285\t          }\n   286\t        }\n   287\t      }\n   288\t      for (const bucket of nearby) searchTies(bucket);\n   289\t\n   290\t      const cx = px[nearest]!;\n   291\t      const cy = py[nearest]!;\n   292\t      const hits = [nearest];\n   293\t      let count = 0;\n   294\t      function sample(head: number): void {\n   295\t        for (let at = head; at >= 0 && hits.length < POINT_LIMIT; at = next[at]!) {\n   296\t          examined++;\n   297\t          if (at !== nearest) hits.push(at);\n   298\t        }\n   299\t      }\n   300\t      function collect(bucket: Bucket): void {\n   301\t        if (distanceTo(bucket, cx, cy) > COINCIDENT2) return;\n   302\t        if (distanceAcross(bucket, cx, cy) <= COINCIDENT2) {\n   303\t          count += bucket.count;\n   304\t          for (let i = bucket.start; i < bucket.end && hits.length < POINT_LIMIT; i++) sample(order[i]!);\n   305\t        } else if (bucket.left && bucket.right) {\n   306\t          collect(bucket.left);\n   307\t          collect(bucket.right);\n   308\t        } else {\n   309\t          for (let i = bucket.start; i < bucket.end; i++) {\n   310\t            const at = order[i]!;\n   311\t            visit();\n   312\t            if ((px[at]! - cx) ** 2 + (py[at]! - cy) ** 2 <= COINCIDENT2) {\n   313\t              count += multiplicity[at]!;\n   314\t              sample(at);\n   315\t            }\n   316\t          }\n   317\t        }\n   318\t      }\n   319\t      // The same cell set covers every possible 0.5 px neighbourhood of the nearest point.\n   320\t      for (const bucket of nearby) collect(bucket);\n   321\t      return { hits, count };\n   322\t    };\n   323\t  }\n   324\t\n   325\t  const exact = budget > 0 ? index(xs, ys) : null;\n   326\t  let lattice: Index | null = null;\n   327\t  function latticeIndex(): Index {\n   328\t    if (lattice) return lattice;\n   329\t    const lx = new Float64Array(length);\n   330\t    const ly = new Float64Array(length);\n   331\t    for (let at = 0; at < length; at++) {\n   332\t      lx[at] = Math.round(xs[at]! * ratio) / ratio;\n   333\t      ly[at] = Math.round(ys[at]! * ratio) / ratio;\n   334\t    }\n   335\t    return lattice = index(lx, ly);\n   336\t  }\n   337\t\n   338\t  return {\n   339\t    series, points,\n   340\t    // Count individual distance checks and rows visited while sampling tooltip refs, on both indexes.\n   341\t    get examined() { return examined; },\n   342\t    get cellsExamined() { return cellsExamined; },\n   343\t    /** Whether the last pick was answered on the device-pixel lattice. */\n   344\t    get usedLattice() { return usedLattice; },\n   345\t    pick(x: number, y: number): ScatterPick | null {\n   346\t      examined = 0;\n   347\t      cellsExamined = 0;\n   348\t      usedLattice = false;\n   349\t      if (!contains(plot, x, y)) return null;\n   350\t      if (exact) {\n   351\t        try {\n   352\t          return exact(x, y, budget);\n   353\t        } catch (error) {\n   354\t          if (error !== OVER_BUDGET) throw error;\n   355\t        }\n   356\t      }\n   357\t      usedLattice = true;\n   358\t      return latticeIndex()(x, y, Infinity);\n   359\t    },\n   360\t  };\n   361\t}\n","exit_code":0,"status":"completed"}}
