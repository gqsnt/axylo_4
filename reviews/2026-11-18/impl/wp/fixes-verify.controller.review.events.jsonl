{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"git show bbd7564:packages/axylo/src/core/controller.ts | nl -ba | sed -n '1,450p'\"","aggregated_output":"     1\t/**\n     2\t * The chart controller: one implementation behind `line`, `area`, `bar`, `scatter` and `donut`, written\n     3\t * against a `Host` that supplies everything the page provides (animation frames, the figure, the mark and\n     4\t * text renderers, the interaction layer, measurement, theme resolution). The browser host is built in\n     5\t * chart.ts; Node tests supply recording substitutes and a manual frame queue.\n     6\t *\n     7\t * Two phases (plan 1.5). A call (create, update, append, zoom) resolves options, normalizes or prepares\n     8\t * what changed and builds the view synchronously, so `diagnostics` is current when it returns and a `strict`\n     9\t * chart throws from it before anything is accepted: data changes are prepared in the store and committed\n    10\t * only after the candidate view validated. Everything that needs the page runs in the next animation frame,\n    11\t * from the accepted state only, and switches together: no frame mixes two revisions. A revision's rows are\n    12\t * retired only after the frame that replaced it has been drawn, so hover, tooltip, events and `Point.row`\n    13\t * always come from the displayed revision.\n    14\t *\n    15\t * Each frame stage is cached and reruns only when its inputs change (plan 2.2). In development builds the\n    16\t * handle exposes a counter per stage (`__dev.stages()`) so tests can assert what reran.\n    17\t */\n    18\timport {\n    19\t  SLOT_NO_ROW, SLOT_VALUE,\n    20\t  type DatumRef, type DiagnosticInput, type Formatters, type Frame, type Layout, type Lookup, type MarkRenderer,\n    21\t  type PlacedText, type ReaderModel, type ResolvedTheme, type PaintBindings, type Scene, type TextMeasurer,\n    22\t  type TextStyle, type View,\n    23\t} from './contracts';\n    24\timport type { ChartEvents, Diagnostic, Messages, Point, Title, XValue } from '../public';\n    25\timport type { PreparedFrame } from '../data';\n    26\timport { resolveOptions, withoutTable, type ChartType, type ResolvedOptions } from '../data/options';\n    27\timport { createDiagnostic, DiagnosticCollector, readerDisclosure, type DiagnosticCode } from '../diagnostics';\n    28\timport { createFormatters, type FormatSpec } from '../format';\n    29\timport { dateUnitOf } from '../data/x';\n    30\timport { rowsTable, type Table } from '../data/table';\n    31\timport { computeLayout } from '../layout';\n    32\timport { readerWith, seriesNotDrawnSentence } from '../reader';\n    33\timport { fill, resolveMessages } from '../messages';\n    34\timport { lowContrastSeries, type ThemeResolution } from '../theme';\n    35\timport { OptionsStore, sameValue, type OptionRecord } from './options';\n    36\timport { Delivery, diagnosticKey, StrictError, strictViolations, type DeliveryConsole } from './delivery';\n    37\timport { layoutInput, layoutKey, sameKey, tickFormatFailures, type AxisContext } from './axes';\n    38\timport { zoomApplies } from './focus';\n    39\timport { lowerBound } from '../lookup/search';\n    40\timport {\n    41\t  completeViewDiagnostics, dedupe, encodingChanged, isCompact, namesOnlyChanged, namingDiagnostics, object, publicOptions, stringOption,\n    42\t  titleOf, toPublic, viewKeyFor, viewStateFor, type Span,\n    43\t} from './stages';\n    44\timport type { FigureModel } from '../dom/figure';\n    45\timport type { Committed, ControlsState } from '../dom/interaction';\n    46\timport type { Composition, Store } from './composition';\n    47\timport { attachHooks, StageCounter, type ChartHandle, type Stage } from './instrument';\n    48\timport { COMPOSITIONS } from '../kinds';\n    49\t\n    50\texport type ChartKind = ChartType;\n    51\t\n    52\t/** Thrown inside a frame to stop it before anything was written (see `frame`). */\n    53\tconst ABORT = Symbol('axylo frame superseded');\n    54\t\n    55\texport type { BenchHook, ChartHandle, DevHook, Stage } from './instrument';\n    56\t\n    57\tconst KIND_NAMES: Record<ChartKind, string> = { line: 'Line', area: 'Area', bar: 'Bar', scatter: 'Scatter', donut: 'Donut' };\n    58\tconst KIND_MESSAGES = { line: 'typeLine', area: 'typeArea', bar: 'typeBar', scatter: 'typeScatter', donut: 'typeDonut' } as const;\n    59\t/** Option resolution reports these about the data; they belong to the call that set the data. */\n    60\tconst DATA_CODES = new Set(['AX100', 'AX101']);\n    61\t/** Rows a store may hold beyond twice what was on screen before the frames that pin it copy their rows. */\n    62\tconst RETENTION_SLACK = 8;\n    63\t/** Positions of the title, the labelledBy id and the caption in the reader's inputs: they name, they do not summarize. */\n    64\tconst NAMING_INPUTS = new Set([3, 4, 9, 13]);\n    65\t\n    66\texport interface Size {\n    67\t  readonly width: number;\n    68\t  readonly height: number;\n    69\t  /**\n    70\t   * The plot's column (the plot and, in readout mode, the strip under it): the same in both modes, so the\n    71\t   * mode decided from it does not flip with its own strip. Absent: the plot's size.\n    72\t   */\n    73\t  readonly room?: { readonly width: number; readonly height: number };\n    74\t}\n    75\t\n    76\t/** Decision 0004 revision 2, rule 5: a plot narrower or shorter than this is in readout mode. */\n    77\tconst READOUT_WIDTH = 240;\n    78\tconst READOUT_HEIGHT = 140;\n    79\t/** Where a pointed datum's values go: a floating tooltip, the reserved strip, or nowhere (rule 5). */\n    80\ttype ReadoutMode = 'floating' | 'strip' | 'none';\n    81\t/** Spec L8: the smallest plot height drawn. */\n    82\tconst MIN_PLOT_HEIGHT = 80;\n    83\t\n    84\t/** Everything the controller needs from the page. */\n    85\texport interface Host {\n    86\t  /** Allocated, for the DOM relationships (aria-describedby, the table's id). */\n    87\t  readonly id: string;\n    88\t  /** The target element's own `id`, when it has one: an untitled chart is named by it in diagnostics. */\n    89\t  readonly targetId?: string | null;\n    90\t  readonly console: DeliveryConsole | null;\n    91\t  /** The page the once-per-code printing rule applies to. */\n    92\t  readonly page: object;\n    93\t  readonly timeZone: string;\n    94\t  readonly renderer: Pick<MarkRenderer, 'kind' | 'draw'>;\n    95\t  readonly text: { render(texts: readonly PlacedText[]): void };\n    96\t  readonly figure: { update(model: FigureModel): boolean; announce(text: string, lang?: string | null): void };\n    97\t  readonly interaction: { prepare(state: ControlsState): boolean; commit(state: Committed | null): void; clear(): void };\n    98\t  readonly measurer: TextMeasurer;\n    99\t  /** The callback gets the animation frame's time when the host has one. */\n   100\t  requestFrame(callback: (time?: number) => void): number;\n   101\t  cancelFrame(handle: number): void;\n   102\t  locale(option: unknown): string;\n   103\t  pageLang(): string | null;\n   104\t  /** Text of the page element with this id, or null when there is none. */\n   105\t  labelText(id: string): string | null;\n   106\t  textStyle(): TextStyle;\n   107\t  /**\n   108\t   * The plot container's size as the figure lays it out, with what the rest of the figure overflows by\n   109\t   * subtracted from its height (so it can be negative); null when the figure is not laid out at all (hidden\n   110\t   * or detached), which is not the same as a visible figure whose caption left no room.\n   111\t   */\n   112\t  measure(): Size | null;\n   113\t  devicePixelRatio(): number;\n   114\t  theme(seriesKeys: readonly string[], colors: Record<string, string>): ThemeResolution;\n   115\t  /** Shows or hides the mark and text surfaces without drawing (the error revision hides them). */\n   116\t  surfaces?(visible: boolean): void;\n   117\t  /** Called once by destroy, after the controller released its own state. */\n   118\t  dispose(): void;\n   119\t}\n   120\t\n   121\t/** What the page tells the controller (observers, watchers). */\n   122\texport interface Invalidate {\n   123\t  resize(): void;\n   124\t  /** The chart came back into the document: anything about the page may have changed meanwhile. */\n   125\t  page(): void;\n   126\t  theme(): void;\n   127\t  /** The page's language changed: locale and English marking are read again in the next frame. */\n   128\t  language(): void;\n   129\t  fonts(): void;\n   130\t  pixelRatio(): void;\n   131\t}\n   132\t\n   133\t/** What the interaction layer may ask for; everything goes through the public paths. */\n   134\texport interface ControllerActions {\n   135\t  zoom(window: Span | null): void;\n   136\t  toggle(seriesKey: string): void;\n   137\t  pause(paused: boolean): void;\n   138\t  select(ref: DatumRef): void;\n   139\t  hover(ref: DatumRef | null): void;\n   140\t}\n   141\t\n   142\texport interface Controller {\n   143\t  readonly handle: ChartHandle;\n   144\t  readonly actions: ControllerActions;\n   145\t  readonly invalidate: Invalidate;\n   146\t  /** Runs the pending frame now (tests, and theme changes that arrive inside a frame). */\n   147\t  flush(): void;\n   148\t}\n   149\t\n   150\t/** The state a call produced. Only accepted states are drawn. */\n   151\tinterface Accepted {\n   152\t  readonly options: OptionRecord;\n   153\t  /** Options resolved for the latest call (domains, formats, labels). */\n   154\t  readonly resolved: ResolvedOptions;\n   155\t  /** The resolution the current data was normalized with (on the static path it holds the borrowed table). */\n   156\t  readonly source: ResolvedOptions;\n   157\t  /** null until the first append: a static chart keeps the normalized frame over the caller's data. */\n   158\t  readonly store: Store | null;\n   159\t  /** The frame shown (while paused, the store may hold a newer one). */\n   160\t  readonly frame: Frame;\n   161\t  readonly dataDiagnostics: readonly DiagnosticInput[];\n   162\t  /** AX100 and AX101 from the call that set the data; kept while the data and fields stay. */\n   163\t  readonly dataOptions: readonly DiagnosticInput[];\n   164\t  readonly optionDiagnostics: readonly DiagnosticInput[];\n   165\t  readonly viewDiagnostics: readonly DiagnosticInput[];\n   166\t  readonly naming: readonly DiagnosticInput[];\n   167\t  readonly view: View;\n   168\t  readonly viewKey: readonly unknown[];\n   169\t  readonly zoom: Span<XValue> | null;\n   170\t  /** Zoomed to the latest edge: the window follows appended data (plan 1.5). */\n   171\t  readonly follow: boolean;\n   172\t  readonly revision: number;\n   173\t  readonly messages: Messages;\n   174\t  readonly name: string;\n   175\t  /** Series the reader hid with the legend, by key (the view's hidden set). */\n   176\t  readonly hidden: ReadonlySet<string>;\n   177\t}\n   178\t\n   179\ttype Display =\n   180\t  | { readonly kind: 'ready' }\n   181\t  | {\n   182\t    readonly kind: 'loading' | 'error' | 'empty' | 'internal'; readonly text: string;\n   183\t    /** The built-in message shown, or null when the author wrote the text. */\n   184\t    readonly message: keyof Messages | null;\n   185\t  };\n   186\t\n   187\t/** Presentation diagnostics by the stage that found them (spec 3.5: reported when found, never thrown). */\n   188\ttype PresentationStage = 'theme' | 'layout' | 'fit' | 'format' | 'naming' | 'internal';\n   189\t\n   190\t/**\n   191\t * An x position in the form `zoom()` and the data read it, so an event's window or `Point.x` can be passed\n   192\t * to another chart unchanged (documentation finding 2): a Date for an instant, 'YYYY-MM-DD' for a date, an\n   193\t * ISO date-time without offset for a wall-clock time, the category's name, else the number.\n   194\t */\n   195\texport function positionValue(frame: Frame, position: number): XValue {\n   196\t  if (frame.shape === 'donut') return position;\n   197\t  const kind = frame.shape === 'points' ? frame.xKind : frame.x.kind;\n   198\t  // A Date holds whole milliseconds: a position between them is given as the number zoom() reads the same\n   199\t  // way, so an event's window can be passed on unchanged (final review, finding 12).\n   200\t  if (kind === 'time') return Number.isInteger(position) ? new Date(position) : position;\n   201\t  if ((kind === 'date' || kind === 'wall') && Number.isFinite(position)) {\n   202\t    if (!Number.isInteger(position)) return position;\n   203\t    const iso = new Date(position).toISOString();\n   204\t    // Only four-digit years read back as written; others stay positions.\n   205\t    if (iso.length !== 24) return position;\n   206\t    // A date is written as one; a position between dates (the padded end of a bar axis) stays a number,\n   207\t    // which zoom() reads as the same position.\n   208\t    if (kind === 'date') return iso.endsWith('T00:00:00.000Z') ? iso.slice(0, 10) : position;\n   209\t    // The shortest wall-clock form that keeps the time: seconds and milliseconds only when not zero.\n   210\t    return iso.endsWith(':00.000Z') ? iso.slice(0, 16) : iso.endsWith('.000Z') ? iso.slice(0, 19) : iso.slice(0, 23);\n   211\t  }\n   212\t  if (kind === 'category' && frame.shape === 'aligned') return frame.x.categories?.[position] ?? position;\n   213\t  return position;\n   214\t}\n   215\t\n   216\t/** Whether a window can be set on this frame's x axis: time, date and number axes only in 1.0 (spec I3). */\n   217\tfunction zoomable(frame: Frame): boolean {\n   218\t  return frame.shape === 'points' || (frame.shape === 'aligned' && frame.x.kind !== 'category');\n   219\t}\n   220\t\n   221\tfunction isWall(frame: Frame): boolean {\n   222\t  return frame.shape === 'aligned' ? frame.x.kind === 'wall' : frame.shape === 'points' && frame.xKind === 'wall';\n   223\t}\n   224\t\n   225\tfunction latestX(frame: Frame): number {\n   226\t  if (frame.shape === 'aligned') return frame.x.values.length ? frame.x.values[frame.x.values.length - 1]! : NaN;\n   227\t  if (frame.shape === 'points') {\n   228\t    let latest = -Infinity;\n   229\t    for (const s of frame.series) {\n   230\t      if (s.x.length) latest = Math.max(latest, s.x[s.x.length - 1]!);\n   231\t      // An observation with no y still marks how far the data reaches.\n   232\t      if (s.missingX) for (let i = 0; i < s.missingX.length; i++) if (Number.isFinite(s.missingX[i]!)) latest = Math.max(latest, s.missingX[i]!);\n   233\t    }\n   234\t    return latest;\n   235\t  }\n   236\t  return NaN;\n   237\t}\n   238\t\n   239\t/** A window that ends at the latest x and does not show everything follows the data (plan 1.5). */\n   240\tfunction followsLatest(view: View, zoom: Span<XValue> | null): boolean {\n   241\t  if (zoom === null || view.kind === 'donut') return false;\n   242\t  // The data's own latest position, not the niced or padded edge of the axis (finding 16).\n   243\t  const latest = latestX(view.frame);\n   244\t  return Number.isFinite(latest) && view.xDomain[1] >= latest && view.xDomain[0] > view.xFull[0];\n   245\t}\n   246\t\n   247\t/** What a destroyed controller holds instead of its host, so a handle kept by the page retains no DOM. */\n   248\tfunction deadHost(from: Host): Host {\n   249\t  const none = (): null => null;\n   250\t  const empty = { width: 0, height: 0 };\n   251\t  return {\n   252\t    id: from.id, console: null, page: {}, timeZone: from.timeZone,\n   253\t    renderer: { kind: from.renderer.kind, draw() {} }, text: { render() {} },\n   254\t    figure: { update: () => false, announce() {} }, interaction: { prepare: () => false, commit() {}, clear() {} },\n   255\t    measurer: { width: () => 0 }, requestFrame: () => 0, cancelFrame() {}, locale: () => 'en', pageLang: none,\n   256\t    labelText: none, textStyle: () => ({ font: '', let