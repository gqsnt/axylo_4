seen = new Set<ArrayBufferLike>();\n    41\t  private readonly entries = new Map<string, { bytes: number; buffers: number }>();\n    42\t\n    43\t  constructor(private readonly caller: CallerBuffers) {}\n    44\t\n    45\t  add(name: string, view: ArrayBufferView | null | undefined): void {\n    46\t    if (!view) return;\n    47\t    const buffer = view.buffer;\n    48\t    if (this.seen.has(buffer) || this.caller.has(buffer)) return;\n    49\t    this.seen.add(buffer);\n    50\t    if (!buffer.byteLength) return;\n    51\t    const entry = this.entries.get(name);\n    52\t    if (entry) {\n    53\t      entry.bytes += buffer.byteLength;\n    54\t      entry.buffers++;\n    55\t    } else this.entries.set(name, { bytes: buffer.byteLength, buffers: 1 });\n    56\t  }\n    57\t\n    58\t  /**\n    59\t   * Adds the columns a frame hands out that are plain properties. A column behind a getter is not read: reading\n    60\t   * it marks the store's open slot as seen and changes what the next append copies.\n    61\t   */\n    62\t  frame(frame: Frame): void {\n    63\t    if (frame.shape === 'aligned') {\n    64\t      this.add('frame x', frame.x.values);\n    65\t      for (const series of frame.series) this.plain(`frame series ${series.key}`, series, ['y', 'slot', 'row']);\n    66\t    } else if (frame.shape === 'points') {\n    67\t      for (const series of frame.series) this.plain(`frame series ${series.key}`, series, ['x', 'y', 'row', 'missingX', 'missingRow']);\n    68\t    } else {\n    69\t      this.plain('frame', frame, ['values', 'slot', 'row']);\n    70\t    }\n    71\t  }\n    72\t\n    73\t  private plain(name: string, owner: object, keys: readonly string[]): void {\n    74\t    for (const key of keys) {\n    75\t      const value: unknown = Object.getOwnPropertyDescriptor(owner, key)?.value;\n    76\t      if (ArrayBuffer.isView(value)) this.add(`${name} ${key}`, value);\n    77\t    }\n    78\t  }\n    79\t\n    80\t  result(): OwnedBytes {\n    81\t    let total = 0;\n    82\t    const buffers: OwnedBuffer[] = [];\n    83\t    for (const [name, entry] of this.entries) {\n    84\t      total += entry.bytes;\n    85\t      buffers.push({ name, ...entry });\n    86\t    }\n    87\t    return { total, buffers };\n    88\t  }\n    89\t}\n","exit_code":0,"status":"completed"}}
