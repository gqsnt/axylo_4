'Uint8Array'] as const) {\n    33\t    const original = globalThis[name];\n    34\t    // Species-based operations such as slice must go through the counter too.\n    35\t    const counted = new Proxy(original, {\n    36\t      construct(target, args, newTarget) {\n    37\t        const result = Reflect.construct(target, args, newTarget) as InstanceType<typeof original>;\n    38\t        if (!(args[0] instanceof ArrayBuffer) && !(args[0] instanceof SharedArrayBuffer)) bytes += result.byteLength;\n    39\t        return result;\n    40\t      },\n    41\t    });\n    42\t    Object.defineProperty(globalThis, name, { value: counted });\n    43\t    Object.defineProperty(original.prototype, 'constructor', { value: counted });\n    44\t    restore.push(() => {\n    45\t      Object.defineProperty(original.prototype, 'constructor', { value: original });\n    46\t      Object.defineProperty(globalThis, name, { value: original });\n    47\t    });\n    48\t  }\n    49\t  try {\n    50\t    const result = action();\n    51\t    return { result, bytes };\n    52\t  } finally {\n    53\t    restore.forEach(undo => undo());\n    54\t  }\n    55\t}\n    56\t\n    57\tfunction requireCollection() {\n    58\t  const collect = globalThis.gc;\n    59\t  if (!collect) throw new Error('Forced collection requires the Vitest fork execArgv option --expose-gc.');\n    60\t  return collect;\n    61\t}\n    62\t\n    63\tasync function expectCollected(...refs: WeakRef<object>[]) {\n    64\t  const collect = requireCollection();\n    65\t  for (let attempt = 0; attempt < 5; attempt++) {\n    66\t    // WeakRef keeps a dereferenced value alive only until the end of the job.\n    67\t    await new Promise<void>(resolve => setImmediate(resolve));\n    68\t    collect();\n    69\t    if (refs.every(ref => ref.deref() === undefined)) return;\n    70\t  }\n    71\t  expect(refs.map(ref => ref.deref() === undefined)).toEqual(refs.map(() => true));\n    72\t}\n    73\t\n    74\tit('does not copy a large series window when several fills are committed between draws', () => {\n    75\t  const size = 20_000;\n    76\t  const keys = ['a', 'b', 'c', 'd'];\n    77\t  const data = Array.from({ length: size }, (_, x) => keys.map(group => ({ x, y: x + 1, group }))).flat();\n    78\t  const s = new AlignedStore('line', resolveOptions('line', { data, x: 'x', y: 'y', series: 'group' }, quiet), utc, version);\n    79\t  for (const series of s.frame.series) expect(series.y.length).toBe(size);\n    80\t  const { bytes } = allocated(() => {\n    81\t    for (const [i, group] of keys.entries()) s.prepareAppend([{ x: size, y: i + 1, group }], { keep: size }).commit();\n    82\t  });\n    83\t  console.info(`shared-x prepare + commit: ${bytes} typed-array bytes per four-row tick`);\n    84\t  expect(s.frame.series.map(series => series.y.at(-1))).toEqual([1, 2, 3, 4]);\n    85\t  expect(bytes).toBeLessThanOrEqual(256 * keys.length);\n    86\t});\n    87\t\n    88\tit('bounds the retained typed-array backing after opening a million typed observations and appending', async () => {\n    89\t  const size = 1_000_000;\n    90\t  const data = { columns: { x: Float64Array.from({ length: size }, (_, i) => i), y: Float64Array.from({ length: size }, (_, i) => i / 3) } };\n    91\t  const collect = requireCollection();\n    92\t  async function arrayBuffers() {\n    93\t    await new Promise<void>(resolve => setImmediate(resolve));\n    94\t    collect();\n    95\t    collect();\n    96\t    return process.memoryUsage().arrayBuffers;\n    97\t  }\n    98\t  const baseline = await arrayBuffers();\n    99\t  const s = store('line', data);\n   100\t  s.prepareAppend([{ x: size, y: size / 3 }]).commit();\n   101\t  const frame = s.frame;\n   102\t  if (frame.shape !== 'aligned') throw new Error('Expected an aligned streaming frame.');\n   103\t  const bytes = await arrayBuffers() - baseline;\n   104\t  console.info(`million-point typed handoff: ${bytes} retained bytes beyond caller columns`);\n   105\t  expect(frame.x.values.at(-1)).toBe(size);\n   106\t  expect(frame.series[0]!.y.at(-1)).toBe(size / 3);\n   107\t  expect(frame.series[0]!.y.at(-2)).toBe((size - 1) / 3);\n   108\t  expect(frame.source.rowAt(size - 1)).toEqual({ x: size - 1, y: (size - 1) / 3 });\n   109\t  // P7 permits one extra copy of the caller’s two columns (2 × 8 × 1,000,000).\n   110\t  // A fully materialized post-append frame already needs 17 × 1,000,001 bytes for\n   111\t  // exact x, exact y and slot states before counting any spare capacity or row indexes.\n   112\t  expect(bytes).toBeLessThanOrEqual(data.columns.x.byteLength + data.columns.y.byteLength);\n   113\t});\n   114\t\n   115\tit('keeps typed-column rows implicit through in-order appends and gives exact rows once the window slides', () => {\n   116\t  const size = 1_000;\n   117\t  const data = { columns: { x: Float64Array.from({ length: size }, (_, i) => i), y: Float64Array.from({ length: size }, (_, i) => i / 3) } };\n   118\t  const s = store('line', data);\n   119\t  for (let i = 0; i < 3; i++) s.prepareAppend([{ x: size + i, y: i }]).commit();\n   120\t  const frame = s.frame;\n   121\t  if (frame.shape !== 'aligned') throw new Error('Expected an aligned frame.');\n   122\t  // The contract's null row index means \"slot i came from row i\" (spec P7: no dense identity index).\n   123\t  expect(frame.series[0]!.row).toBeNull();\n   124\t  expect(frame.source.rowAt(size + 2)).toEqual({ x: size + 2, y: 2 });\n   125\t  s.prepareAppend([{ x: size + 3, y: 3 }], { keep: 4 }).commit();\n   126\t  const slid = s.frame;\n   127\t  if (slid.shape !== 'aligned') throw new Error('Expected an aligned frame.');\n   128\t  expect([...slid.x.values]).toEqual([size, size + 1, size + 2, size + 3]);\n   129\t  expect([...slid.series[0]!.row!]).toEqual([size, size + 1, size + 2, size + 3]);\n   130\t  for (let i = 0; i < 4; i++) expect(slid.source.rowAt(slid.series[0]!.row![i]!)).toEqual({ x: size + i, y: i });\n   131\t});\n   132\t\n   133\tit('reports owned bytes that match the retained buffers and leave out the caller\\'s columns', async () => {\n   134\t  const size = 200_000;\n   135\t  const x = Float64Array.from({ length: size }, (_, i) => i);\n   136\t  const y = Float64Array.from({ length: size }, (_, i) => i / 3);\n   137\t  const collect = requireCollection();\n   138\t  async function arrayBuffers() {\n   139\t    await new Promise<void>(resolve => setImmediate(resolve));\n   140\t    collect();\n   141\t    collect();\n   142\t    return process.memoryUsage().arrayBuffers;\n   143\t  }\n   144\t  const baseline = await arrayBuffers();\n   145\t  for (const kind of types) {\n   146\t    const data = { columns: { x, y, label: Array.from(x, String) } };\n   147\t    const s = store(kind, data);\n   148\t    s.prepareAppend([row(size)]).commit();\n   149\t    const retained = await arrayBuffers() - baseline;\n   150\t    const owned = s.ownedBytes();\n   151\t    expect(owned.total).toBe(owned.buffers.reduce((sum, entry) => sum + entry.bytes, 0));\n   152\t    expect(owned.buffers.every(entry => entry.bytes > 0 && entry.buffers > 0 && entry.name.length > 0)).toBe(true);\n   153\t    // Everything the store keeps alive beyond the caller's columns is counted, and nothing else\n   154\t    // (the caller's x and y are 3.2 MB, so counting them would miss by far more than the slack).\n   155\t    expect(Math.abs(retained - owned.total)).toBeLessThan(64 * 1024);\n   156\t    void s.frame;\n   157\t  }\n   158\t});\n   159\t\n   160\tfor (const kind of types) {\n   161\t  it(`${kind} releases abandoned preview rows when their source first finds them dead`, async () => {\n   162\t    function setup() {\n   163\t      const s = store(kind, [row(0)]);\n   164\t      const rejected = row(1);\n   165\t      const ref = new WeakRef(rejected);\n   166\t      const { frame } = s.prepareAppend([rejected]);\n   167\t      expect(frame.source.rowAt(1)).toBe(rejected);\n   168\t      s.prepareAppend([row(2)]).commit();\n   169\t      expect(frame.source.rowAt(1)).toBeNull();\n   170\t      return { s, frame, ref };\n   171\t    }\n   172\t    const { s, frame, ref } = setup();\n   173\t    await expectCollected(ref);\n   174\t    expect(frame.source.rowAt(1)).toBeNull();\n   175\t    expect(s.frame.source.rowAt(1)).toEqual(row(2));\n   176\t  });\n   177\t}\n   178\t\n   179\tfor (const kind of types) {\n   180\t  it(`${kind} shares numeric buffers during preparation and commit when there is spare capacity`, () => {\n   181\t    const size = kind === 'donut' ? 500 : 50_000;\n   182\t    const s = store(kind, Array.from({ length: size }, (_, i) => row(i)));\n   183\t    const initial = numericBuffers(s.frame);\n   184\t    const first = s.prepareAppend([row(size)]);\n   185\t    const firstBuffers = numericBuffers(first.frame);\n   186\t    first.commit();\n   187\t    const before = s.frame;\n   188\t    const original = numericBuffers(before);\n   189\t    const measured = allocated(() => {\n   190\t      const candidate = s.prepareAppend([row(size + 1)]);\n   191\t      const during = numericBuffers(candidate.frame);\n   192\t      expect(s.frame).toBe(before);\n   193\t      candidate.commit();\n   194\t      return during.filter((buffer, i) => original[i] !== buffer).length;\n   195\t    });\n   196\t    console.info(`${kind}: ${measured.result} replaced numeric buffers, ${measured.bytes} typed-array bytes per appended row`);\n   197\t    expect(measured.result).toBe(0);\n   198\t    firstBuffers.forEach((buffer, index) => expect(buffer).toBe(initial[index]));\n   199\t    expect(measured.bytes).toBeLessThan(256);\n   200\t  });\n   201\t\n   202\t  it.each(['keep', 'replace'] as const)(`${kind} releases caller columns after %s and retirement`, async operation => {\n   203\t    function setup() {\n   204\t      const x = Float64Array.from({ length: 300 }, (_, i) => i);\n   205\t      const y = Float64Array.from(x, i => i + 1);\n   206\t      const label = Array.from(x, String);\n   207\t      const refs = [new WeakRef(x), new WeakRef(y), new WeakRef(label)];\n   208\t      const s = store(kind, { columns: { x, y, label } });\n   209\t      const old = s.frame;\n   210\t      if (operation === 'keep') s.prepareAppend([row(300)], { keep: 2 }).commit();\n   211\t      else {\n   212\t        const data = [row(300)];\n   213\t        s.prepareReplace(data, options(kind, data), { revision: old.revision + 1, epoch: old.epoch + 1 }).commit();\n   214\t      }\n   215\t      expect(old.source.rowAt(0)).toEqual({ x: 0, y: 1, label: '0' });\n   216\t      s.retire(old.revision);\n   217\t      return { refs, s, old };\n   218\t    }\n   219\t    const { refs, s, old } = setup();\n   220\t    await expectCollected(...refs);\n   221\t    expect(old.source.rowAt(0)).toBeNull();\n   222\t    expect(s.retainedRowCount).toBe(operation === 'keep' ? 2 : 1);\n   223\t  });\n   224\t}\n   225\t\n   226\tfor (const kind of types) {\n   227\t  it(`${kind} releases an object in a partly retained column block`, async () => {\n   228\t    function setup() {\n   229\t      const payload = [{ note: 'dropped' }, { note: 'retained' }];\n   230\t      const ref = new WeakRef(payload[0]!);\n   231\t      const data = { columns: { x: Float64Array.of(0, 1), y: Float64Array.of(1, 2), label: ['0', '1'], payload } };\n   232\t      const s = store(kind, data);\n   233\t      const before = s.frame;\n   234\t      s.prepareAppend([row(2)], { keep: 2 }).commit();\n   235\t      expect(before.source.rowAt(0)).toMatchObject({ payload: payload[0] });\n   236\t      expect(s.frame.source.rowAt(1)).toMatchObject({ payload: payload[1] });\n   237\t      s.retire(before.revision);\n   238\t      return { ref, s, before };\n   239\t    }\n   240\t    const { ref, s, before } = setup();\n   241\t    await expectCollected(ref);\n   242\t    expect(before.source.rowAt(0)).toBeNull();\n   243\t    expect(s.frame.source.rowAt(0)).toBeNull();\n   244\t    expect(s.frame.source.rowAt(1)).toMatchObject({ payload: { note: 'retained' } });\n   245\t  });\n   246\t}\n   247\t\n   248\tit('releases the original backing buffer of a sliced Uint8Array subclass', async () => {\n   249\t  function setup() {\n   250\t    const bytes = Buffer.alloc(300, 2);\n   251\t    const ref = new WeakRef(bytes.buffer);\n   252\t    const data = { columns: { x: Float64Array.from(bytes, (_, i) => i), y: bytes } };\n   253\t    const s = store('line', data);\n   254\t    const old = s.frame;\n   255\t    s.prepareAppend([row(300)], { keep: 2 }).commit();\n   256\t    s.retire(old.revision);\n   257\t    return { ref, s };\n   258\t  }\n   259\t  const { ref, s } = setup();\n   260\t  await expectCollected(ref);\n   261\t  expect(s.frame.source.rowAt(299)).toEqual({ x: 299, y: 2 });\n   262\t});\n   263\t\n   264\ttype Entry = { index: number; row: Omit<ReturnType<typeof row>, 'y' | 'z'> & { y: number | null; z: number | null } };\n   265\ttype Snapshot = { frame: Frame; rows: readonly Entry[]; field: 'y' | 'z'; next: number; zero?: boolean };\n   266\t\n   267\tfunction checkFrame({ frame, rows, field, next, zero = false }: Snapshot, live: boolean) {\n   268\t  const indexes = rows.map(entry => entry.index);\n   269\t  const xs = rows.map(entry => entry.row.x);\n   270\t  const values = rows.map(entry => entry.row[field]);\n   271\t  if (frame.shape === 'aligned') {\n   272\t    expect(frame.length).toBe(rows.length);\n   273\t    expect([...frame.x.values]).toEqual(xs);\n   274\t    if (rows.length) {\n   275\t      expect([...frame.series[0]!.y]).toEqual(values);\n   276\t      expect([...frame.series[0]!.slot]).toEqual(values.map(() => SLOT_VALUE));\n   277\t      expect([...frame.series[0]!.row!]).toEqual(indexes);\n   278\t    }\n   279\t  } else if (frame.shape === 'points') {\n   280\t    const points = rows.filter(entry => zero || entry.row[field] !== null);\n   281\t    const missing = zero ? [] : rows.filter(entry => entry.row[field] === null);\n   282\t    expect([...frame.series[0]!.x]).toEqual(points.map(entry => entry.row.x));\n   283\t    expect([...frame.series[0]!.y]).toEqual(points.map(entry => entry.row[field] ?? 0));\n   284\t    // A null row index means \"point i came from row i\" (contract).\n   285\t    expect([...frame.series[0]!.row ?? frame.series[0]!.x.keys()]).toEqual(points.map(entry => entry.index));\n   286\t    expect([...(frame.series[0]!.missingX ?? [])]).toEqual(missing.map(entry => entry.row.x));\n   287\t    // The contract: present whenever missingX and row are, one source row per entry of missingX.\n   288\t    expect(frame.series[0]!.missingRow === undefined).toBe(frame.series[0]!.missingX === undefined);\n   289\t    expect([...(frame.series[0]!.missingRow ?? [])]).toEqual(missing.map(entry => entry.index));\n   290\t  } else {\n   291\t    expect([...frame.labels]).toEqual(rows.map(entry => entry.row.label));\n   292\t    expect([...frame.values]).toEqual(values);\n   293\t    expect([...frame.slot]).toEqual(values.map(() => SLOT_VALUE));\n   294\t    expect([...frame.row!]).toEqual(indexes);\n   295\t  }\n   296\t\n   297\t  let cursor = 0;\n   298\t  for (let i = 0; i <= next; i++) {\n   299\t    const entry = rows[cursor];\n   300\t    expect(frame.source.rowAt(i)).toBe(live && entry?.index === i ? entry.row : null);\n   301\t    if (entry?.index === i) cursor++;\n   302\t  }\n   303\t}\n   304\t\n   305\tconst count = fc.integer({ min: 0, max: 7 });\n   306\tconst operations = fc.array(fc.oneof(\n   307\t  fc.record({ operation: fc.constant('append' as const), count, keep: fc.option(count, { nil: undefined }) }),\n   308\t  fc.record({ operation: fc.constant('replace' as const), count, start: fc.integer({ min: -50, max: 50 }) }),\n   309\t  fc.record({ operation: fc.constant('reencode' as const), field: fc.constantFrom('y' as const, 'z' as const), zero: fc.boolean() }),\n   310\t  fc.record({ operation: fc.constant('retire' as const), back: count }),\n   311\t), { minLength: 1, maxLength: 35 });\n   312\t\n   313\tfor (const kind of types) {\n   314\t  it(`${kind} matches a row model across live revisions and bounds append allocations`, () => {\n   315\t    fc.assert(fc.property(operations, ops => {\n   316\t      const s = store(kind, []);\n   317\t      let field: Snapshot['field'] = 'y';\n   318\t      let zero = false;\n   319\t      let rows: Entry[] = [];\n   320\t      let next = 0;\n   321\t      let x = 0;\n   322\t      let retired = s.frame.revision - 1;\n   323\t      let appendBytes = 0;\n   324\t      let rowsAdded = 0;\n   325\t      let seededRows = 0;\n   326\t      let appends = 0;\n   327\t      const snapshots: Snapshot[] = [{ frame: s.frame, rows, field, next, zero }];\n   328\t      const observation = (x: number): Entry['row'] => {\n   329\t        const item = row(x);\n   330\t        return kind === 'scatter' ? { ...item, y: x % 3 === 0 ? null : item.y, z: x % 5 === 0 ? null : item.z } : item;\n   331\t      };\n   332\t      const encoding = (data: unknown) => zero ? resolveOptions('scatter', {\n   333\t        data, x: { field: 'x', type: 'number' }, y: { field, missing: 'zero' },\n   334\t      }, quiet) : options(kind, data, field);\n   335\t      for (const op of ops) {\n   336\t        const before = s.frame;\n   337\t        const revised = { revision: before.revision + 1, epoch: before.epoch + 1 };\n   338\t        if (op.operation === 'append') {\n   339\t          const incoming = Array.from({ length: op.count }, () => observation(x++));\n   340\t          rows = [...rows, ...incoming.map(item => ({ index: next++, row: item }))];\n   341\t          if (op.keep !== undefined) rows = rows.slice(Math.max(0, rows.length - op.keep));\n   342\t          const { result: prepared, bytes } = allocated(() => s.prepareAppend(incoming, { keep: op.keep }));\n   343\t          appendBytes += bytes;\n   344\t          rowsAdded += incoming.length;\n   345\t          appends++;\n   346\t          expect(s.frame).toBe(before);\n   347\t          checkFrame({ frame: prepared.frame, rows, field, next, zero }, true);\n   348\t          prepared.commit();\n   349\t        } else if (op.operation === 'replace') {\n   350\t          x = op.start;\n   351\t          next = 0;\n   352\t          const data = Array.from({ length: op.count }, () => observation(x++));\n   353\t          rows = data.map(item => ({ index: next++, row: item }));\n   354\t          seededRows += rows.length;\n   355\t          s.prepareReplace(data, encoding(data), revised).commit();\n   356\t        } else if (op.operation === 'reencode') {\n   357\t          field = op.field;\n   358\t          zero = kind === 'scatter' && op.zero;\n   359\t          seededRows += rows.length;\n   360\t          s.prepareReencode(encoding(rows.map(entry => entry.row)), revised).commit();\n   361\t        } else {\n   362\t          retired = Math.max(retired, before.revision - op.back);\n   363\t          s.retire(retired);\n   364\t        }\n   365\t        if (s.frame !== before) snapshots.push({ frame: s.frame, rows, field, next, zero });\n   366\t        const retained = new Set(rows.map(entry => entry.row));\n   367\t        for (const snapshot of snapshots) {\n   368\t          const live = snapshot.frame.revision > retired;\n   369\t          checkFrame(snapshot, live);\n   370\t          if (live) for (const entry of snapshot.rows) retained.add(entry.row);\n   371\t        }\n   372\t        expect(s.retainedRowCount).toBe(retained.size);\n   373\t      }\n   374\t\n   375\t      // Each append has fixed scratch space and per-row scratch columns. A doubling\n   376\t      // or a compaction pays for itself across the rows inserted, evicted, or seeded.\n   377\t      expect(appendBytes).toBeLessThanOrEqual(2_048 * appends + 384 * (rowsAdded + seededRows));\n   378\t    }), { numRuns: 1_000 });\n   379\t  });\n   380\t\n   381\t  it(`${kind} uses offset views while sliding a fixed window and bounds long-run allocations`, () => {\n   382\t    const size = 600;\n   383\t    const s = store(kind, Array.from({ length: size }, (_, i) => row(i)));\n   384\t    const first = s.frame;\n   385\t    const a = s.prepareAppend([row(size)], { keep: size });\n   386\t    numericBuffers(a.frame).forEach((buffer, i) => expect(buffer).toBe(numericBuffers(first)[i]));\n   387\t    a.commit();\n   388\t    s.retire(first.revision);\n   389\t    const updates = 2_000;\n   390\t    const { bytes } = allocated(() => {\n   391\t      for (let i = 1; i <= updates; i++) {\n   392\t        const previous = s.frame;\n   393\t        s.prepareAppend([row(size + i)], { keep: size }).commit();\n   394\t        s.retire(previous.revision);\n   395\t      }\n   396\t    });\n   397\t    expect(s.retainedRowCount).toBe(size);\n   398\t    expect(bytes).toBeLessThan(256 * updates);\n   399\t  });\n   400\t}\n   401\t\n   402\tfunction frameValues(frame: Frame): unknown {\n   403\t  if (frame.shape === 'aligned') {\n   404\t    const values = contents(frame);\n   405\t    return { ...values, x: { ...values.x, categories: frame.x.categories && [...frame.x.categories] } };\n   406\t  }\n   407\t  if (frame.shape === 'donut') return {\n   408\t    labels: [...frame.labels], values: [...frame.values], slot: [...frame.slot], row: [...frame.row ?? []],\n   409\t  };\n   410\t  return frame.series.map(({ x, y, row, missingX, missingRow, ...description }) => ({\n   411\t    ...description, x: [...x], y: [...y], row: [...row ?? []], missingX: [...missingX ?? []], missingRow: [...missingRow ?? []],\n   412\t  }));\n   413\t}\n   414\t\n   415\tconst generatedRows = fc.array(fc.record({\n   416\t  delta: fc.integer({ min: -2, max: 3 }),\n   417\t  group: fc.constantFrom('a', 'b', 'c'),\n   418\t  y: fc.oneof(fc.constant(null), fc.nat(100)),\n   419\t}), { minLength: 1, maxLength: 4 });\n   420\tconst previewOps = fc.array(fc.record({\n   421\t  rows: generatedRows, rival: generatedRows,\n   422\t  mode: fc.constantFrom('plain', 'prepare', 'abandon', 'first-wins', 'second-wins'),\n   423\t  keep: fc.option(fc.nat(12), { nil: undefined }),\n   424\t  eager: fc.boolean(), retire: fc.option(fc.nat(4), { nil: undefined }),\n   425\t}), { minLength: 1, maxLength: 26 });\n   426\t\n   427\tfor (const kind of ['line', 'category', 'scatter', 'donut'] as const) {\n   428\t  it(`${kind} agrees with eagerly read snapshots across mixed preview and append sequences`, () => {\n   429\t    fc.assert(fc.property(previewOps, ops => {\n   430\t      const data = [{ ...row(0), group: 'a' }, { ...row(0), group: 'b' }, { ...row(1), group: 'a' }]\n   431\t        .map(item => ({ ...item, x: kind === 'category' ? item.label : item.x }));\n   432\t      function open() {\n   433\t        if (kind === 'donut') return store(kind, [data[0]!, data[2]!]);\n   434\t        const chartType = kind === 'category' ? 'line' : kind;\n   435\t        const options = resolveOptions(chartType, {\n   436\t          data, x: { field: 'x', type: kind === 'category' ? 'category' : 'number' }, y: 'y', series: 'group',\n   437\t        }, quiet);\n   438\t        return kind === 'scatter' ? new PointStore(options, utc, version) : new AlignedStore('line', options, utc, version);\n   439\t      }\n   440\t      const lazy = open();\n   441\t      const eager = open();\n   442\t      const frames: { frame: Frame; values: unknown; rows: unknown[]; preview: boolean }[] = [\n   443\t        { frame: lazy.frame, values: frameValues(eager.frame), rows: data.map((_, i) => eager.frame.source.rowAt(i)), preview: false },\n   444\t      ];\n   445\t      let retired = version.revision - 1;\n   446\t      let next = kind === 'donut' ? 2 : 3;\n   447\t      let high = 1;\n   448\t      for (const op of ops) {\n   449\t        const encode = (rows: typeof op.rows) => rows.map(({ delta, group, y }) => {\n   450\t          const x = high + delta;\n   451\t          return { x: kind === 'category' ? String(x) : x, label: String(x), group, y };\n   452\t        });\n   453\t        let accepted = encode(op.rows);\n   454\t        const rival = encode(op.rival);\n   455\t        const remember = (frame: Frame, oracle: Frame, end: number, preview: boolean) => {\n   456\t          const values = frameValues(oracle);\n   457\t          const rows = Array.from({ length: end }, (_, i) => oracle.source.rowAt(i));\n   458\t          if (op.eager) expect(frameValues(frame)).toEqual(values);\n   459\t          frames.push({ frame, values, rows, preview });\n   460\t        };\n   461\t        const prepare = (rows: typeof accepted, preview: boolean) => {\n   462\t          const a = lazy.prepareAppend(rows, { keep: op.keep });\n   463\t          const b = eager.prepareAppend(rows, { keep: op.keep });\n   464\t          remember(a.frame, b.frame, next + rows.length, preview);\n   465\t          expect(a.diagnostics).toEqual(b.diagnostics);\n   466\t          return [a, b] as const;\n   467\t        };\n   468\t        if (op.mode === 'plain') {\n   469\t          const a = lazy.append(accepted);\n   470\t          const b = eager.append(accepted);\n   471\t          remember(a, b, next + accepted.length, false);\n   472\t        } else if (op.mode === 'abandon') {\n   473\t          prepare(rival, true);\n   474\t          const a = lazy.append(accepted);\n   475\t          const b = eager.append(accepted);\n   476\t          remember(a, b, next + accepted.length, false);\n   477\t        } else {\n   478\t          const a = prepare(accepted, op.mode === 'second-wins');\n   479\t          const b = op.mode === 'prepare' ? null : prepare(rival, op.mode === 'first-wins');\n   480\t          const winner = op.mode === 'second-wins' ? b! : a;\n   481\t          if (winner === b) accepted = rival;\n   482\t          for (const draft of winner) draft.commit();\n   483\t        }\n   484\t        next += accepted.length;\n   485\t        for (const item of accepted) high = Math.max(high, Number(item.x));\n   486\t        if (op.retire !== undefined) {\n   487\t          retired = Math.max(retired, lazy.frame.revision - op.retire - 1);\n   488\t          lazy.retire(retired);\n   489\t          eager.retire(retired);\n   490\t        }\n   491\t        expect(lazy.diagnostics).toEqual(eager.diagnostics);\n   492\t        expect(lazy.retainedRowCount).toBe(eager.retainedRowCount);\n   493\t      }\n   494\t      for (const { frame, values, rows, preview } of frames) {\n   495\t        expect(frameValues(frame)).toEqual(values);\n   496\t        for (const [i, source] of rows.entries()) {\n   497\t          expect(frame.source.rowAt(i)).toBe(preview || frame.revision <= retired ? null : source);\n   498\t        }\n   499\t      }\n   500\t    }), { numRuns: 400 });\n   501\t  });\n   502\t}\n   503\t\n   504\tit('keeps a competing extension independent of a draft that claimed an unread shared-x slot', () => {\n   505\t  const data = [{ x: 0, y: 1, group: 'a' }, { x: 0, y: 2, group: 'b' }, { x: 1, y: 3, group: 'a' }];\n   506\t  const s = new AlignedStore('line', resolveOptions('line', { data, x: 'x', y: 'y', series: 'group' }, quiet), utc, version);\n   507\t  const base = s.frame;\n   508\t  const fill = s.prepareAppend([{ x: 1, y: 4, group: 'b' }]);\n   509\t  const extend = s.prepareAppend([{ x: 2, y: 5, group: 'a' }]);\n   510\t  extend.commit();\n   511\t  expect([...base.series[1]!.y]).toEqual([2, NaN]);\n   512\t  expect([...s.frame.series[1]!.y]).toEqual([2, NaN, NaN]);\n   513\t  expect([...fill.frame.series[1]!.y]).toEqual([2, 4]);\n   514\t  expect([...s.frame.series[1]!.row!]).toEqual([1, -1, -1]);\n   515\t});\n   516\t\n   517\tfor (const kind of types) {\n   518\t  it(`${kind} compacts a large window after dropping almost all its rows`, () => {\n   519\t    const size = 10_000;\n   520\t    const keep = 37;\n   521\t    const s = store(kind, Array.from({ length: size }, (_, i) => row(i)));\n   522\t    const old = s.frame;\n   523\t    s.prepareAppend([row(size)], { keep }).commit();\n   524\t    s.retire(old.revision);\n   525\t    expect(s.retainedRowCount).toBe(keep);\n   526\t    for (const buffer of numericBuffers(s.frame)) {\n   527\t      expect(buffer.byteLength).toBeLessThanOrEqual(2 * keep * Float64Array.BYTES_PER_ELEMENT);\n   528\t    }\n   529\t  });\n   530\t}\n   531\t\n   532\tit('shares scatter missing positions through append and offset keep, then retires the evicted rows', async () => {\n   533\t  function setup() {\n   534\t    const dropped = { x: 1, y: null };\n   535\t    const ref = new WeakRef(dropped);\n   536\t    const data = [dropped, { x: 2, y: 4 }, { x: 3, y: null }];\n   537\t    const s = new PointStore(options('scatter', data), utc, version);\n   538\t    const old = s.frame;\n   539\t    const missing = old.series[0]!.missingX!;\n   540\t    expect(missing).toEqual(Float64Array.of(1, 3));\n   541\t    const accepted = s.prepareAppend([{ x: 3, y: null }, { x: 4, y: null }], { keep: 3 });\n   542\t    const current = accepted.frame.series[0]!.missingX!;\n   543\t    expect(current).toEqual(Float64Array.of(3, 3, 4));\n   544\t    expect(current.buffer).toBe(missing.buffer);\n   545\t    expect(current.byteOffset).toBe(missing.byteOffset + Float64Array.BYTES_PER_ELEMENT);\n   546\t    expect(old.series[0]!.missingRow).toEqual(Int32Array.of(0, 2));\n   547\t    expect(accepted.frame.series[0]!.missingRow).toEqual(Int32Array.of(2, 3, 4));\n   548\t    expect(accepted.frame.series[0]!.missingRow!.buffer).toBe(old.series[0]!.missingRow!.buffer);\n   549\t    const competing = s.prepareAppend([{ x: 5, y: null }], { keep: 3 });\n   550\t    expect(competing.frame.series[0]!.missingX).toEqual(Float64Array.of(3, 5));\n   551\t    expect(competing.frame.series[0]!.missingRow).toEqual(Int32Array.of(2, 3));\n   552\t    accepted.commit();\n   553\t    expect(() => competing.commit()).toThrow('Cannot commit a superseded data revision.');\n   554\t    expect(current).toEqual(Float64Array.of(3, 3, 4));\n   555\t    expect(accepted.frame.series[0]!.missingRow).toEqual(Int32Array.of(2, 3, 4));\n   556\t    expect(old.source.rowAt(0)).toBe(dropped);\n   557\t    s.retire(old.revision);\n   558\t    expect(old.source.rowAt(0)).toBeNull();\n   559\t    expect(missing).toEqual(Float64Array.of(1, 3));\n   560\t    expect(s.retainedRowCount).toBe(4);\n   561\t    return { s, ref };\n   562\t  }\n   563\t  const { s, ref } = setup();\n   564\t  await expectCollected(ref);\n   565\t  expect(s.frame.series[0]!.missingX).toEqual(Float64Array.of(3, 3, 4));\n   566\t});\n   567\t\n   568\tit('rebuilds scatter missing positions for absent fields, re-encoding, and replacement', () => {\n   569\t  const s = new PointStore(options('scatter', [{ x: 1, y: 2 }, { x: 3, y: null }]), utc, version);\n   570\t  const missing = { x: 2 };\n   571\t  const next = s.append([missing, { x: 4, y: 5 }], { keep: 3 });\n   572\t  expect(next.series[0]!.missingX).toEqual(Float64Array.of(2, 3));\n   573\t  expect(s.diagnostics).toMatchObject([\n   574\t    { code: 'AX102', effect: 'omitted', rows: [2], count: 1 }, { code: 'AX151', rows: [2], count: 1 },\n   575\t  ]);\n   576\t  const encoding = s.resolveEncoding({ x: 'x', y: { field: 'y', missing: 'zero' } }, quiet);\n   577\t  const zeros = s.reencode(encoding, { epoch: version.epoch + 1, revision: next.revision + 1 });\n   578\t  expect(zeros.series[0]!.x).toEqual(Float64Array.of(2, 3, 4));\n   579\t  expect(zeros.series[0]!.y).toEqual(Float64Array.of(0, 0, 5));\n   580\t  expect(zeros.series[0]!.row).toEqual(Int32Array.of(2, 1, 3));\n   581\t  expect(zeros.source.rowAt(zeros.series[0]!.row![0]!)).toBe(missing);\n   582\t  expect(zeros.series[0]!.missingX?.length ?? 0).toBe(0);\n   583\t  expect(s.diagnostics).toMatchObject([{ code: 'AX102', effect: 'changed', rows: [2], count: 1 }]);\n   584\t  const replacement = [{ x: 10, y: null }, { x: 9, y: 1 }, { x: 11 }];\n   585\t  const final = s.replace(replacement, options('scatter', replacement), { epoch: zeros.epoch + 1, revision: zeros.revision + 1 });\n   586\t  expect(final.series[0]!.missingX).toEqual(Float64Array.of(10, 11));\n   587\t  s.retire(zeros.revision);\n   588\t  expect(zeros.source.rowAt(2)).toBeNull();\n   589\t  expect(next.series[0]!.missingX).toEqual(Float64Array.of(2, 3));\n   590\t  expect(s.retainedRowCount).toBe(3);\n   591\t});\n   592\t\n   593\tfor (const kind of types) {\n   594\t  it(`${kind} keeps competing previews and captured views independent`, () => {\n   595\t    const data = [row(0), row(1)];\n   596\t    const s = store(kind, data);\n   597\t    const before = s.frame;\n   598\t    const appended = row(2);\n   599\t    const accepted = s.prepareAppend([appended], { keep: 2 });\n   600\t    const rejected = s.prepareAppend([row(3)], { keep: 1 });\n   601\t    expect(rejected.frame.source.rowAt(2)).toEqual(row(3));\n   602\t    checkFrame({ frame: before, rows: data.map((row, index) => ({ row, index })), field: 'y', next: 2 }, true);\n   603\t    accepted.commit();\n   604\t    checkFrame({ frame: s.frame, rows: [{ row: data[1]!, index: 1 }, { row: appended, index: 2 }], field: 'y', next: 3 }, true);\n   605\t    expect(() => rejected.commit()).toThrow('Cannot commit a superseded data revision.');\n   606\t    expect(rejected.frame.source.rowAt(2)).toBeNull();\n   607\t    const values = rejected.frame.shape === 'aligned' ? rejected.frame.series[0]!.y :\n   608\t      rejected.frame.shape === 'points' ? rejected.frame.series[0]!.y : rejected.frame.values;\n   609\t    expect([...values]).toEqual([4]);\n   610\t    expect(s.frame.source.rowAt(2)).toEqual(row(2));\n   611\t  });\n   612\t}\n   613\t\n   614\tit('preserves a captured series view when a later row fills its shared-x slot', () => {\n   615\t  const data = [{ x: 0, y: 2, group: 'a' }, { x: 0, y: 3, group: 'b' }, { x: 1, y: 4, group: 'a' }];\n   616\t  const encoded = resolveOptions('line', { data, x: 'x', y: 'y', series: 'group' }, quiet);\n   617\t  const s = new AlignedStore('line', encoded, utc, version);\n   618\t  const before = s.frame;\n   619\t  const values = before.series[1]!.y;\n   620\t  const observation = { x: 1, y: 5, group: 'b' };\n   621\t  const candidate = s.prepareAppend([observation]);\n   622\t  expect([...candidate.frame.series[1]!.y]).toEqual([3, 5]);\n   623\t  expect([...values]).toEqual([3, NaN]);\n   624\t  candidate.commit();\n   625\t  expect([...values]).toEqual([3, NaN]);\n   626\t  expect(before.source.rowAt(3)).toBeNull();\n   627\t  expect(s.frame.source.rowAt(3)).toBe(observation);\n   628\t});\n   629\t\n   630\tit('shares ordered time-point storage and revalidates a daily cadence exposed by keep', () => {\n   631\t  const day = 86_400_000;\n   632\t  const firstDay = Date.UTC(2026, 0, 1);\n   633\t  const data = [row(firstDay - 3_600_000), row(firstDay), row(firstDay + day)];\n   634\t  const resolved = resolveOptions('scatter', { data, x: { field: 'x', type: 'time' }, y: 'y' }, quiet);\n   635\t  const s = new PointStore(resolved, utc, version);\n   636\t  const first = s.frame;\n   637\t  const prepared = s.prepareAppend([row(firstDay + 2 * day)]);\n   638\t  numericBuffers(prepared.frame).forEach((buffer, i) => expect(buffer).toBe(numericBuffers(first)[i]));\n   639\t  expect(prepared.diagnostics).toEqual([]);\n   640\t  prepared.commit();\n   641\t  const daily = s.prepareAppend([row(firstDay + 3 * day)], { keep: 3 });\n   642\t  expect(daily.diagnostics).toMatchObject([{ code: 'AX111', count: 3, rows: [2, 3, 4] }]);\n   643\t  daily.commit();\n   644\t  expect([...s.frame.series[0]!.x]).toEqual([firstDay + day, firstDay + 2 * day, firstDay + 3 * day]);\n   645\t  expect([...first.series[0]!.x]).toEqual(data.map(item => item.x));\n   646\t});\n   647\t\n   648\tit('keeps AX103 and AX106 positions in the scatter table column through append and eviction', () => {\n   649\t  const s = new PointStore(options('scatter', [{ x: 1, y: 4 }, { x: 2, y: null }]), utc, version);\n   650\t  const first = s.append([{ x: 3, y: Infinity }, { x: 4, y: 'bad' }, { x: 5, y: 5 }]);\n   651\t  expect(first.series[0]!.x).toEqual(Float64Array.of(1, 5));\n   652\t  expect(first.series[0]!.missingX).toEqual(Float64Array.of(2, 3, 4));\n   653\t  expect(s.diagnostics).toMatchObject([\n   654\t    { code: 'AX103', effect: 'omitted', rows: [2], count: 1 },\n   655\t    { code: 'AX106', effect: 'omitted', rows: [3], count: 1 },\n   656\t  ]);\n   657\t  const last = s.append([{ x: 6, y: 6 }], { keep: 3 });\n   658\t  expect(last.series[0]!.missingX).toEqual(Float64Array.of(4));\n   659\t  expect(last.series[0]!.x).toEqual(Float64Array.of(5, 6));\n   660\t  expect(s.diagnostics).toMatchObject([{ code: 'AX106', effect: 'omitted', rows: [3], count: 1 }]);\n   661\t  expect(first.series[0]!.missingX).toEqual(Float64Array.of(2, 3, 4));\n   662\t});\n   663\t\n   664\tit('re-encodes a scatter row whose y was missing from the retained rows, as a point when the new field has a value', () => {\n   665\t  // Final controller review, finding 6: { x: 1, y: null, z: 11 } must survive a change of y to z.\n   666\t  const data = [{ x: 0, y: 5, z: 10 }, { x: 1, y: null, z: 11 }, { x: 2, y: 7, z: null }];\n   667\t  const s = new PointStore(options('scatter', data), utc, version);\n   668\t  s.prepareAppend([{ x: 3, y: null, z: 13 }], { keep: 3 }).commit();\n   669\t  const before = s.frame.series[0]!;\n   670\t  expect([...before.x]).toEqual([2]);\n   671\t  expect([...before.missingX!]).toEqual([1, 3]);\n   672\t  expect([...before.missingRow!]).toEqual([1, 3]);\n   673\t  // What the rows behind the missing observations are, through the frame's own source.\n   674\t  expect([...before.missingRow!].map(row => s.frame.source.rowAt(row))).toEqual([data[1], { x: 3, y: null, z: 13 }]);\n   675\t\n   676\t  const encoding = s.resolveEncoding({ x: { field: 'x', type: 'number' }, y: 'z' }, quiet);\n   677\t  const reencoded = s.prepareReencode(encoding, { revision: s.frame.revision + 1, epoch: s.frame.epoch + 1 });\n   678\t  reencoded.commit();\n   679\t  const after = s.frame.series[0]!;\n   680\t  expect([...after.x]).toEqual([1, 3]);\n   681\t  expect([...after.y]).toEqual([11, 13]);\n   682\t  expect([...after.row!]).toEqual([1, 3]);\n   683\t  expect([...after.missingX!]).toEqual([2]);\n   684\t  expect([...after.missingRow!]).toEqual([2]);\n   685\t  expect(s.frame.source.rowAt(1)).toBe(data[1]);\n   686\t});\n   687\t\n   688\tdescribe('owned bytes stay near what the contract needs for each retained window', () => {\n   689\t  const size = 200_000;\n   690\t  // A retained slot or point the frame hands out needs, under the contract: exact x and y (8 + 8 bytes); an\n   691\t  // aligned slot state (1); a row index (4) once the window has slid, since slot i no longer came from row i.\n   692\t  // The caller's row behind it is kept for events and the table once the caller's columns are released: its\n   693\t  // x and y (8 + 8). Buffers may keep one eighth spare (plus 16 slots), as the stores allocate.\n   694\t  const spare = (n: number) => n + Math.max(16, Math.ceil(n / 8));\n   695\t  const columns = () => ({ columns: { x: Float64Array.from({ length: size }, (_, i) => i), y: Float64Array.from({ length: size }, (_, i) => i / 3) } });\n   696\t  const xCopies = (owned: ReturnType<AlignedStore['ownedBytes']>) =>\n   697\t    owned.buffers.filter(entry => /x history|x positions/.test(entry.name)).reduce((sum, entry) => sum + entry.bytes, 0);\n   698\t\n   699\t  it.each([80_000, 150_000])('a line that keeps %i of its first rows holds one copy of x and lets the caller\\'s columns go', async keep => {\n   700\t    function setup() {\n   701\t      const data = columns();\n   702\t      const refs = [new WeakRef(data.columns.x), new WeakRef(data.columns.y)];\n   703\t      const s = store('line', data) as AlignedStore;\n   704\t      const old = s.frame.revision;\n   705\t      s.prepareAppend([row(size)], { keep }).commit();\n   706\t      s.retire(old);\n   707\t      return { s, refs };\n   708\t    }\n   709\t    const { s, refs } = setup();\n   710\t    await expectCollected(...refs);\n   711\t    const owned = s.ownedBytes();\n   712\t    const frame = s.frame;\n   713\t    if (frame.shape !== 'aligned') throw new Error('Expected an aligned frame.');\n   714\t    expect(frame.length).toBe(keep);\n   715\t    expect(frame.source.rowAt(size)).toEqual(row(size));\n   716\t    // History and the eviction seed read x from the window's own buffer.\n   717\t    expect(xCopies(owned)).toBeLessThanOrEqual(1_024);\n   718\t    expect(owned.total).toBeLessThanOrEqual(spare(keep) * (8 + 8 + 1 + 4) + keep * (8 + 8) + 64 * 1_024);\n   719\t  });\n   720\t\n   721\t  it('a scatter store over typed columns keeps no position or row index that repeats its points', () => {\n   722\t    const s = store('scatter', columns()) as PointStore;\n   723\t    s.prepareAppend([{ x: size, y: 1 }]).commit();\n   724\t    const owned = s.ownedBytes();\n   725\t    expect(owned.buffers.map(entry => entry.name).filter(name => /^(x positions|row)$/.test(name))).toEqual([]);\n   726\t    expect(s.frame.shape === 'points' && s.frame.series[0]!.row).toBeNull();\n   727\t    // Exact x and y of every point, with the stores' opening tail (at most 4,096 slots).\n   728\t    expect(owned.total).toBeLessThanOrEqual((size + 1 + 4_096 + 16) * (8 + 8) + 1_024);\n   729\t  });\n   730\t\n   731\t  it('a scatter store that keeps part of its points holds x and y, the row index, and the kept rows', () => {\n   732\t    const keep = 80_000;\n   733\t    const s = store('scatter', columns()) as PointStore;\n   734\t    const old = s.frame.revision;\n   735\t    s.prepareAppend([{ x: size, y: 1 }], { keep }).commit();\n   736\t    // Rows evicted while an earlier frame still showed them are kept for it until it retires.\n   737\t    expect(s.ownedBytes().buffers.some(entry => entry.name === 'rows kept for earlier frames')).toBe(true);\n   738\t    s.retire(old);\n   739\t    const frame = s.frame;\n   740\t    if (frame.shape !== 'points') throw new Error('Expected a point frame.');\n   741\t    expect(frame.series[0]!.x.length).toBe(keep);\n   742\t    expect(frame.series[0]!.row![0]).toBe(size + 1 - keep);\n   743\t    expect(frame.source.rowAt(frame.series[0]!.row![0]!)).toEqual({ x: size + 1 - keep, y: (size + 1 - keep) / 3 });\n   744\t    expect(s.ownedBytes().total).toBeLessThanOrEqual(spare(keep) * (8 + 8 + 4) + keep * (8 + 8) + 64 * 1_024);\n   745\t  });\n   746\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"git show bbd7564:vitest.config.ts; git diff --name-status bbd7564 -- . ':\"'!reviews'\"' ':\"'!research'\"'\"","aggregated_output":"import { defineConfig } from 'vitest/config';\n\n// Unit and property tests run in Node. Browser tests (*.browser.test.ts) drive system Chrome through\n// Playwright against the built bundle: run `npm run build` first, then `npm run test:browser`.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    include: process.env.AXYLO_BROWSER\n      ? ['packages/*/test/**/*.browser.test.ts', 'apps/docs/test/**/*.browser.test.ts']\n      : ['packages/*/test/**/*.test.ts', 'apps/docs/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    // Forked processes with --expose-gc: the store's tests force a collection to check that dropped rows are\n    // released, and fail loudly when they cannot.\n    pool: 'forks',\n    execArgv: ['--expose-gc'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 10000,\n    fileParallelism: !process.env.AXYLO_BROWSER,\n  },\n});\nM\tdocs/02-product-spec.md\nM\tdocs/decisions/0003-default-palette.md\nM\tdocs/decisions/0004-tooltip-and-focused-text.md\nM\tpackages/axylo/src/core/chart.ts\nM\tpackages/axylo/src/core/focus.ts\nM\tpackages/axylo/src/dom/interaction.ts\nM\tpackages/axylo/test/browser/a11y/util.ts\nM\tpackages/axylo/test/browser/acceptance/a5-not-colour-alone.browser.test.ts\nM\tpackages/axylo/test/browser/acceptance/a6-a10.browser.test.ts\nM\tpackages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts\nM\tpackages/axylo/test/browser/acceptance/util.ts\nM\tpackages/axylo/test/browser/harness.ts\nM\tpackages/axylo/test/data/streaming-storage.test.ts\nM\tpackages/axylo/test/theme/palette.test.ts\n","exit_code":0,"status":"completed"}}
