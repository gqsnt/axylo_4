n   396\t  }), { numRuns: 60 });\n   397\t});\n   398\t\n   399\tit('uses one set of grid cells for a dense noncoincident pick and its neighbours', () => {\n   400\t  const width = 500;\n   401\t  const size = width * 400;\n   402\t  const base = points([[]]);\n   403\t  const data = { ...base, series: [{\n   404\t    ...base.series[0]!,\n   405\t    x: Float64Array.from({ length: size }, (_, i) => 20 + Math.floor(i / 400) / 100),\n   406\t    y: Float64Array.from({ length: size }, (_, i) => 48 + (i % 400) / 100),\n   407\t    row: null,\n   408\t  }] };\n   409\t  const scale = linearScale([0, 128], [0, 128]);\n   410\t  const layout = plot({ kind: 'xy', x: scale, y: scale });\n   411\t  const x = 24, y = 50;\n   412\t  const { x: xs, y: ys } = data.series[0]!;\n   413\t  let latestTie = 400 * 400 + 200;\n   414\t  for (let i = 0; i < size; i++) {\n   415\t    if (Math.hypot(xs[i]! - x, ys[i]! - y) < 0.5) latestTie = i;\n   416\t  }\n   417\t  for (const [ratio, row] of [[exactRatio, 400 * 400 + 200], [1, latestTie]] as const) {\n   418\t    const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio);\n   419\t    let expected = 0;\n   420\t    for (let i = 0; i < size; i++) {\n   421\t      if ((xs[i]! - xs[row]!) ** 2 + (ys[i]! - ys[row]!) ** 2 <= 0.5 ** 2) expected++;\n   422\t    }\n   423\t    const target = model.pick(x, y);\n   424\t    expect(target).toMatchObject({ kind: 'point', count: expected });\n   425\t    expect(model.primary(target!)).toEqual(point('S0', row, xs[row]!));\n   426\t    expect(model.lastPickCells).toBeLessThanOrEqual(16);\n   427\t    expect(model.lastPickCandidates).toBeLessThan(3_000);\n   428\t  }\n   429\t});\n   430\t\n   431\tit('finds next and previous by one binary successor search per series', () => {\n   432\t  const seriesCount = 500;\n   433\t  const rows = 400;\n   434\t  const base = points([[]]);\n   435\t  const data = { ...base, series: Array.from({ length: seriesCount }, (_, s) => ({\n   436\t    key: `S${s}`, label: `S${s}`, drawable: true,\n   437\t    x: Float64Array.from({ length: rows }, (_, i) => i), y: new Float64Array(rows).fill(s), row: null,\n   438\t  })) };\n   439\t  const work = { locations: 0, seriesCandidates: 0, orderComparisons: 0 };\n   440\t  const model = scatterLookup(scatter(data), null, formatter(data), work);\n   441\t  const from = point('S250', 398, 398);\n   442\t  expect(model.step(from, 'next')).toEqual(point('S251', 398, 398));\n   443\t  expect(work.orderComparisons).toBeGreaterThan(0);\n   444\t  expect(work.orderComparisons).toBeLessThanOrEqual(seriesCount * 10);\n   445\t  work.orderComparisons = 0;\n   446\t  expect(model.step(from, 'previous')).toEqual(point('S249', 398, 398));\n   447\t  expect(work.orderComparisons).toBeGreaterThan(0);\n   448\t  expect(work.orderComparisons).toBeLessThanOrEqual(seriesCount * 10);\n   449\t});\n   450\t\n   451\t// The lattice rule of `Lookup.pick`: every drawn point is compared at its position rounded to the nearest\n   452\t// device pixel; the closest within 24 px wins, compared points within half a device pixel of that distance\n   453\t// tie and the latest source row wins, and the count is every point whose rounded position is within 0.5 px\n   454\t// of the winner's.\n   455\tinterface Drawn { readonly x: number; readonly y: number; readonly ref: Extract<DatumRef, { kind: 'point' }> }\n   456\tfunction latticeOracle(drawn: readonly Drawn[], px: number, py: number, ratio: number) {\n   457\t  const snapped = drawn.map(d => ({ ...d, x: Math.round(d.x * ratio) / ratio, y: Math.round(d.y * ratio) / ratio }))\n   458\t    .map(d => ({ ...d, distance: (d.x - px) ** 2 + (d.y - py) ** 2 }));\n   459\t  let nearest = snapped[0]!;\n   460\t  for (const d of snapped) if (d.distance < nearest.distance) nearest = d;\n   461\t  if (nearest.distance > 24 ** 2) return null;\n   462\t  let winner = nearest;\n   463\t  for (const d of snapped) {\n   464\t    const tied = d.distance <= 24 ** 2 && Math.sqrt(d.distance) - Math.sqrt(nearest.distance) < 0.5 / ratio;\n   465\t    if (tied && d.ref.row > winner.ref.row) winner = d;\n   466\t  }\n   467\t  const coincident = snapped.filter(d => (d.x - winner.x) ** 2 + (d.y - winner.y) ** 2 <= 0.5 ** 2);\n   468\t  return { winner: winner.ref, coincident: coincident.map(d => d.ref) };\n   469\t}\n   470\t\n   471\tfunction cloud(positions: readonly (readonly [number, number])[], sourceRows?: readonly number[]): { data: PointFrame; drawn: Drawn[] } {\n   472\t  const data = points([positions], sourceRows);\n   473\t  const s = data.series[0]!;\n   474\t  const drawn = Array.from(s.x, (x, i) => ({ x, y: s.y[i]!, ref: point('S0', s.row![i]!, x) }));\n   475\t  return { data, drawn };\n   476\t}\n   477\t\n   478\tfunction expectLattice(target: ReturnType<ReturnType<typeof scatterLookup>['pick']>, expected: ReturnType<typeof latticeOracle>) {\n   479\t  if (!expected) return expect(target).toBeNull();\n   480\t  if (target?.kind !== 'point') throw new Error('Expected a scatter target');\n   481\t  expect(target.refs[0]).toEqual(expected.winner);\n   482\t  expect(target.count).toBe(expected.coincident.length);\n   483\t  expect(target.refs).toHaveLength(Math.min(8, expected.coincident.length));\n   484\t  expect(new Set(target.refs.map(ref => ref.kind === 'point' && ref.row)).size).toBe(target.refs.length);\n   485\t  expect(expected.coincident).toEqual(expect.arrayContaining([...target.refs]));\n   486\t}\n   487\t\n   488\tit('agrees with a brute-force pick under the device-pixel lattice rule', () => {\n   489\t  const axis = linearScale([0, 64], [0, 64]);\n   490\t  const layout = plot({ kind: 'xy', x: axis, y: axis }, 64, 64);\n   491\t  // Positions on a 1/16 px grid in a 12 px square crowd several points into each device pixel.\n   492\t  const position = fc.tuple(fc.integer({ min: 0, max: 192 }), fc.integer({ min: 0, max: 192 }))\n   493\t    .map(([x, y]) => [26 + x / 16, 26 + y / 16] as const);\n   494\t  fc.assert(fc.property(\n   495\t    fc.array(position, { minLength: 1, maxLength: 120 }), fc.nat(), fc.constantFrom(1, 1.25, 1.5, 2, 3),\n   496\t    fc.tuple(fc.integer({ min: -400, max: 400 }), fc.integer({ min: -400, max: 400 })),\n   497\t    (positions, seed, ratio, [dx, dy]) => {\n   498\t      const rows = Array.from(positions, (_, i) => i);\n   499\t      let random = seed;\n   500\t      for (let i = rows.length - 1; i > 0; i--) {\n   501\t        random = (Math.imul(1664525, random) + 1013904223) >>> 0;\n   502\t        const j = random % (i + 1);\n   503\t        [rows[i], rows[j]] = [rows[j]!, rows[i]!];\n   504\t      }\n   505\t      const { data, drawn } = cloud(positions, rows);\n   506\t      const witness = drawn[seed % drawn.length]!;\n   507\t      const px = clamp(witness.x + dx / 16, 0, 64);\n   508\t      const py = clamp(witness.y + dy / 16, 0, 64);\n   509\t      const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio, { exactBudget: 0 });\n   510\t      expectLattice(model.pick(px, py), latticeOracle(drawn, px, py, ratio));\n   511\t      expect(model.lastPickLattice).toBe(true);\n   512\t    },\n   513\t  ), { numRuns: 1_500 });\n   514\t});\n   515\t\n   516\tdescribe('a pick visits a number of index entries bounded by the radius and the pixel ratio', () => {\n   517\t  const axis = linearScale([0, 200], [0, 200]);\n   518\t  const layout = plot({ kind: 'xy', x: axis, y: axis }, 200, 200);\n   519\t  // The exact attempt may spend the lattice points of the 49 px pick square; the lattice pick visits at most\n   520\t  // the occupied lattice points near the pointer.\n   521\t  const bound = (ratio: number) => 2 * (Math.ceil(49 * ratio) + 1) ** 2;\n   522\t\n   523\t  it.each([[32_000, 1], [32_000, 2], [200_000, 1], [200_000, 2]])('%i points on a 20 px ring around the pointer at ratio %i', (size, ratio) => {\n   524\t    const positions = Array.from({ length: size }, (_, i) =>\n   525\t      [100 + 20 * Math.cos(2 * Math.PI * i / size), 100 + 20 * Math.sin(2 * Math.PI * i / size)] as const);\n   526\t    const { data, drawn } = cloud(positions);\n   527\t    const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio);\n   528\t    const target = model.pick(100, 100);\n   529\t    expect(model.lastPickLattice).toBe(true);\n   530\t    expect(model.lastPickCandidates).toBeLessThanOrEqual(bound(ratio));\n   531\t    expectLattice(target, latticeOracle(drawn, 100, 100, ratio));\n   532\t    // A second pick reuses the lattice index and does the same bounded work.\n   533\t    const visits = model.lastPickCandidates;\n   534\t    model.pick(100, 100);\n   535\t    expect(model.lastPickCandidates).toBe(visits);\n   536\t  });\n   537\t\n   538\t  it.each([1, 2, 3])('200,000 points in a dense 40 px cluster at ratio %i, exact and on the lattice', ratio => {\n   539\t    let random = 7;\n   540\t    const next = () => (random = (Math.imul(1664525, random) + 1013904223) >>> 0) / 2 ** 32;\n   541\t    const positions = Array.from({ length: 200_000 }, () => [80 + 40 * next(), 80 + 40 * next()] as const);\n   542\t    const { data, drawn } = cloud(positions);\n   543\t    for (const exactBudget of [undefined, 0]) {\n   544\t      const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio, { exactBudget });\n   545\t      const target = model.pick(100.3, 100.2);\n   546\t      expect(target).not.toBeNull();\n   547\t      expect(model.lastPickCandidates).toBeLessThanOrEqual(exactBudget === 0 ? bound(ratio) / 2 : bound(ratio));\n   548\t      if (model.lastPickLattice) expectLattice(target, latticeOracle(drawn, 100.3, 100.2, ratio));\n   549\t    }\n   550\t  });\n   551\t});\n","exit_code":0,"status":"completed"}}
