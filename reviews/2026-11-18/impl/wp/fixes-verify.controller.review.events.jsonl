(finding 12).\n   818\t      const own = (v: unknown) => v instanceof Date ? new Date(v.getTime()) : v;\n   819\t      const pair = Array.isArray(domain) && domain.length === 2 ? [own(domain[0]), own(domain[1])] as unknown as Span<XValue> : null;\n   820\t      const c = viewCandidate(previous, { zoom: pair });\n   821\t      const viewed = viewFor(c, previous);\n   822\t      // A window that cannot be read is reported and ignored; zoom never throws (spec 3.5).\n   823\t      // A hint (AX112: a wall-clock window on a wall-clock axis) does not make the window unreadable.\n   824\t      const bad = viewed.found.filter(d => d.field === 'zoom' && d.level !== 'hint');\n   825\t      if (bad.length) {\n   826\t        deliverRejected(bad, previous.name, previous.options.onDiagnostic);\n   827\t        return;\n   828\t      }\n   829\t      accept(c, viewed, followsLatest(viewed.view, pair), null);\n   830\t      const now = accepted;\n   831\t      if (destroyed || now === null) return;\n   832\t      const view = now.view;\n   833\t      const before = previous.view;\n   834\t      if (view.kind !== 'donut' && before.kind !== 'donut' &&\n   835\t        (view.xDomain[0] !== before.xDomain[0] || view.xDomain[1] !== before.xDomain[1] || (previous.zoom === null) !== (pair === null))) {\n   836\t        emit('zoom', zoomPayload(now));\n   837\t      }\n   838\t    });\n   839\t  }\n   840\t\n   841\t  /** The window shown, in the form `zoom()` reads (positionValue); null when the whole range is shown. */\n   842\t  function zoomPayload(a: Accepted): readonly [XValue, XValue] | null {\n   843\t    const view = a.view;\n   844\t    if (a.zoom === null || view.kind === 'donut') return null;\n   845\t    return [positionValue(a.frame, view.xDomain[0]), positionValue(a.frame, view.xDomain[1])];\n   846\t  }\n   847\t\n   848\t  /** A legend toggle: the series joins or leaves the view's hidden set (spec I2). */\n   849\t  function toggleSeries(key: string): void {\n   850\t    guarded(() => {\n   851\t      const previous = accepted;\n   852\t      if (!previous) return;\n   853\t      const hidden = new Set(previous.hidden);\n   854\t      if (!hidden.delete(key)) hidden.add(key);\n   855\t      const c = viewCandidate(previous, { hidden });\n   856\t      accept(c, viewFor(c, previous), previous.follow, null);\n   857\t    });\n   858\t  }\n   859\t\n   860\t  /** Pause and resume (spec I6). Resume shows the newest held frame. */\n   861\t  function setPaused(next: boolean): void {\n   862\t    if (destroyed || next === paused) return;\n   863\t    paused = next;\n   864\t    if (!next && held) {\n   865\t      const frame = held;\n   866\t      guarded(() => {\n   867\t        const previous = accepted;\n   868\t        if (!previous) return;\n   869\t        let zoomed = previous.zoom;\n   870\t        if (previous.follow && zoomed) zoomed = followLatest(frame.frame, previous.view) ?? zoomed;\n   871\t        let c = viewCandidate(previous, { frame: frame.frame, dataDiagnostics: frame.dataDiagnostics, zoom: zoomed });\n   872\t        let commit: (() => void) | null = null;\n   873\t        const store = previous.store;\n   874\t        if (store && previous.dataOptions.some(d => d.code === 'AX101') && previous.options.strict !== true) {\n   875\t          // A field the earlier data did not have, which the held arrivals bring: the frame is read again with\n   876\t          // the fields as given, and AX101 goes, as for a running append (final review, finding 6).\n   877\t          const check = new DiagnosticCollector();\n   878\t          const resolved = store.resolveEncoding(publicOptions(previous.options), check);\n   879\t          if (!check.inputs().some(d => d.code === 'AX101')) {\n   880\t            const again: PreparedFrame<Frame> = store.prepareReencode(resolved, nextVersion());\n   881\t            commit = again.commit;\n   882\t            c = {\n   883\t              ...c, resolved, source: resolved, frame: again.frame, dataDiagnostics: again.diagnostics, dataOptions: [],\n   884\t              optionDiagnostics: previous.optionDiagnostics.filter(d => !DATA_CODES.has(d.code)),\n   885\t            };\n   886\t          }\n   887\t        }\n   888\t        const viewed = viewFor(c, previous);\n   889\t        // The held frame is let go only once its replacement is accepted (review 3, finding 5).\n   890\t        held = null;\n   891\t        accept(c, viewed, previous.follow && zoomed !== null, commit);\n   892\t      });\n   893\t    }\n   894\t    schedule();\n   895\t  }\n   896\t\n   897\t  // ── frame phase ────────────────────────────────────────────────────────────────────────────────\n   898\t\n   899\t  let frameRequest = 0;\n   900\t  let frameScheduled = false;\n   901\t  let size: Size | null = null;\n   902\t  let sizeDirty = true;\n   903\t  /** The readout strip is reserved under the plot (decision 0004 revision 2, rule 5). */\n   904\t  let readoutMode = false;\n   905\t  /** The strip's height as last measured (two 24 px lines until then). */\n   906\t  let stripHeight = 0;\n   907\t  /** Decision 0004 revision 3, rule 5: how a datum's values are shown when pointed at. */\n   908\t  let readoutKind: ReadoutMode = 'floating';\n   909\t  /** L8 fallback: what the fallback's own DOM adds to the plot size, measured when it was entered. */\n   910\t  let fallback: { width: number; height: number } | null = null;\n   911\t  let textStyle: TextStyle | null = null;\n   912\t  let textStyleDirty = true;\n   913\t  let fontEpoch = 0;\n   914\t  let pixelRatio = host.devicePixelRatio();\n   915\t  let themeDirty = true;\n   916\t  let themeKey: readonly unknown[] | null = null;\n   917\t  let theme: { bindings: PaintBindings; theme: ResolvedTheme } | null = null;\n   918\t  let themeRevision = 0;\n   919\t  /** The display state last shown, for announcing changes once (spec L7). */\n   920\t  let announced: Display['kind'] | null = null;\n   921\t  /** The accepted revision the page last settled on (drawn, or its error shown). */\n   922\t  let settledRevision = 0;\n   923\t\n   924\t  interface Drawn {\n   925\t    accepted: Accepted;\n   926\t    formatters: Formatters;\n   927\t    formattersKey: readonly unknown[];\n   928\t    layout: Layout;\n   929\t    layoutKey: readonly unknown[] | null;\n   930\t    scene: Scene;\n   931\t    sceneInputs: readonly unknown[];\n   932\t    lookup: Lookup;\n   933\t    lookupInputs: readonly unknown[];\n   934\t    reader: ReaderModel;\n   935\t    readerInputs: readonly unknown[];\n   936\t    paintInputs: readonly unknown[];\n   937\t  }\n   938\t  let drawn: Drawn | null = null;\n   939\t  /** The last layout computed, also at a size that was only an estimate (the L8 fallback). */\n   940\t  let lastLayout: { layout: Layout; key: readonly unknown[] } | null = null;\n","exit_code":0,"status":"completed"}}
