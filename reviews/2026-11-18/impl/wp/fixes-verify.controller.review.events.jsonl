  596\t        let next = 4;\n   597\t        let tick = 1;\n   598\t        let keepUsed = Infinity;\n   599\t        const appendModel = (xs: number[], keep: number | null) => {\n   600\t          data = [...data, ...xs];\n   601\t          if (keep !== null) { data = data.slice(-keep); keepUsed = keep; }\n   602\t          if (!paused) visible = data;\n   603\t        };\n   604\t        for (const step of sequence) {\n   605\t          switch (step.op) {\n   606\t            case 'append': {\n   607\t              const xs = Array.from({ length: step.n }, () => next++);\n   608\t              chart.append(add(xs), step.keep === null ? undefined : { keep: step.keep });\n   609\t              appendModel(xs, step.keep);\n   610\t              break;\n   611\t            }\n   612\t            case 'title': title = `M${tick++}`; chart.update({ title }); break;\n   613\t            case 'data': data = [next, next + 1, next + 2]; next += 3; add(data); chart.update({ data: data.map(x => rows.get(x)) }); visible = data; keepUsed = Infinity; break;\n   614\t            case 'reencode': field = field === 'a' ? 'b' : 'a'; chart.update({ y: field }); break;\n   615\t            case 'pause': r.controller.actions.pause(true); paused = true; break;\n   616\t            case 'resume': r.controller.actions.pause(false); paused = false; if (!failing) visible = data; break;\n   617\t            case 'zoom': chart.zoom([step.from, step.from + step.width]); break;\n   618\t            case 'unzoom': chart.zoom(null); break;\n   619\t            case 'frame': r.frames(); break;\n   620\t            case 'fail': chart.__dev!.fail(step.stage); failing = true; failedSinceHeal = true; break;\n   621\t            case 'heal': chart.__dev!.fail(null); failing = false; break;\n   622\t            case 'collapse': r.container = { width: 0, height: 0 }; r.controller.invalidate.resize(); collapsed = true; break;\n   623\t            case 'restore': r.container = { width: 720, height: 400 }; r.controller.invalidate.resize(); collapsed = false; break;\n   624\t            case 'hoverHook': {\n   625\t              // A hover listener that updates the chart and changes its zoom, once.\n   626\t              const off = chart.on('hover', () => { off(); chart.update({ subtitle: `h${tick++}` }); chart.zoom(null); });\n   627\t              break;\n   628\t            }\n   629\t            case 'zoomHook': {\n   630\t              // A zoom listener that appends, once: the model takes the row when the listener runs.\n   631\t              const off = chart.on('zoom', () => {\n   632\t                off();\n   633\t                const x = next++;\n   634\t                chart.append(add([x]));\n   635\t                appendModel([x], null);\n   636\t              });\n   637\t              break;\n   638\t            }\n   639\t            case 'hover': {\n   640\t              const committed = r.committed;\n   641\t              if (committed && committed.view.kind !== 'donut' && committed.view.kind !== 'scatter') {\n   642\t                const v = committed.view as AlignedView;\n   643\t                const x = v.frame.x.values[0];\n   644\t                if (x !== undefined) r.controller.actions.hover(ref(x, String(rows.get(x)?.s ?? 'p')));\n   645\t              }\n   646\t              break;\n   647\t            }\n   648\t          }\n   649\t          if (step.op !== 'frame' || failing || failedSinceHeal || collapsed) {\n   650\t            if (!failing && step.op === 'frame') failedSinceHeal = false;\n   651\t            continue;\n   652\t          }\n   653\t          const committed = r.committed;\n   654\t          if (!committed) continue;\n   655\t          const view = committed.view;\n   656\t          const xs = view.kind === 'scatter'\n   657\t            ? [...new Set(view.frame.series.flatMap(s => Array.from(s.x)))].sort((p, q) => p - q)\n   658\t            : view.kind === 'donut' ? [] : Array.from((view as AlignedView).frame.x.values);\n   659\t          if (!paused) expect(xs).toEqual(visible);\n   660\t          else expect(visible.slice(-xs.length)).toEqual(xs);\n   661\t          expect(lastModel(r).title?.text).toBe(title);\n   662\t          if (view.kind !== 'scatter') {\n   663\t            for (const x of xs) {\n   664\t              const row = rows.get(x)!;\n   665\t              expect(hoverRow(r, x, String(row.s))?.row).toBe(row);\n   666\t            }\n   667\t          }\n   668\t          if (Number.isFinite(keepUsed)) expect(chart.__dev!.retainedRows()).toBeLessThanOrEqual(2 * Math.max(xs.length, keepUsed) + 8 + 3);\n   669\t        }\n   670\t        chart.destroy();\n   671\t        expect(chart.__dev!.retainedRows()).toBe(0);\n   672\t        expect(r.writesAfterDispose).toBe(0);\n   673\t      }), { numRuns: 200 });\n   674\t    });\n   675\t  }\n   676\t});\n","exit_code":0,"status":"completed"}}
