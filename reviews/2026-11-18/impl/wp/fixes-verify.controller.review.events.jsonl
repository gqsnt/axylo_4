d < observations && x.positions[source] === position) {\n   284\t      const state = values.slot[source]!;\n   285\t      if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) {\n   286\t        y[i] = 0;\n   287\t      } else {\n   288\t        slot[i] = state;\n   289\t        row[i] = table.rowIndex(source);\n   290\t        y[i] = values.y[source]!;\n   291\t      }\n   292\t      observed++;\n   293\t    } else {\n   294\t      const state = gaps?.[gap] === position ? SLOT_GAP : SLOT_NO_ROW;\n   295\t      if (state === SLOT_GAP) gap++;\n   296\t      if (!zero) slot[i] = state;\n   297\t      y[i] = zero ? 0 : NaN;\n   298\t    }\n   299\t  }\n   300\t  return { ...description, drawable, y, slot, row };\n   301\t}\n   302\t\n   303\tconst maxAlignedSlots = 20_000_000;\n   304\t\n   305\texport function alignmentFits(series: number, positions: number, sink: DiagnosticSink): boolean {\n   306\t  if (series * positions <= maxAlignedSlots) return true;\n   307\t  report(sink, 'AX134', 'chart-error', {\n   308\t    count: 1, detail: 'The aligned frame has ' + series + ' series and ' + positions + ' x positions, exceeding 20,000,000 slots.',\n   309\t  });\n   310\t  return false;\n   311\t}\n   312\t\n   313\texport function alignedFrame(\n   314\t  options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion, counts?: Map<string, ValueCounts>,\n   315\t): AlignedFrame {\n   316\t  const axis = x.parser.column(x.positions);\n   317\t  const { table } = options;\n   318\t  const frame = {\n   319\t    ...base(table, version), shape: 'aligned' as const,\n   320\t    xLabel: options.x.label, yLabel: options.values.length === 1 ? options.values[0]!.label : null,\n   321\t  };\n   322\t  const empty = () => ({ ...frame, x: { ...axis, values: new Float64Array(), categories: axis.categories && [] }, length: 0, series: [] });\n   323\t  const observed = combinePositions(x, []);\n   324\t  const groupsBySeries = groups(options, x, sink);\n   325\t  if (!alignmentFits(groupsBySeries.length, observed.length, sink)) return empty();\n   326\t  const aligned: AlignedGroup[] = [];\n   327\t  for (const group of groupsBySeries) {\n   328\t    aligned.push(alignGroup(group, x, axis, options.x.field, table, sink, options.series === null ? aligned[0] : undefined));\n   329\t  }\n   330\t  const positions = aligned.some(group => group.gaps) ? combinePositions(x, aligned) : observed;\n   331\t  if (!alignmentFits(aligned.length, positions.length, sink)) return empty();\n   332\t  const column = { ...axis, values: positions };\n   333\t  const included = x.order === null ? undefined : (row: number) => Number.isFinite(x.positions[row]);\n   334\t  const shared = options.series === null ? undefined : readValues(table, options.values[0]!, sink, true, 0, undefined, included);\n   335\t  const series = aligned.map(group => {\n   336\t    const value = group.group.value;\n   337\t    const count = counts ? { decimal: 0, other: 0 } : undefined;\n   338\t    const values = shared ?? readValues(table, value, sink, true, 0, undefined, included, undefined, count);\n   339\t    if (count) counts!.set(value.field, count);\n   340\t    return alignedSeries(group, column, x, table, values);\n   341\t  });\n   342\t  for (const { group, gaps, sparse } of aligned) {\n   343\t    reportGaps(sink, options.x.field, group.value.missing === 'zero', gaps, axis, group.label, sparse, group.key);\n   344\t  }\n   345\t  return { ...frame, x: column, length: positions.length, series };\n   346\t}\n   347\t\n   348\texport function pointFrame(options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion): PointFrame {\n   349\t  const { table } = options;\n   350\t  const value = options.values[0]!;\n   351\t  const included = x.order === null ? undefined : (row: number) => Number.isFinite(x.positions[row]);\n   352\t  const members = groups(options, x, sink);\n   353\t  const values = readValues(table, value, sink, true, 0, undefined, included, 'The affected points are not drawn.');\n   354\t  if (value.missing === 'zero') {\n   355\t    for (let row = 0; row < values.slot.length; row++) {\n   356\t      if (values.slot[row] === SLOT_NULL || values.slot[row] === SLOT_ABSENT_FIELD) values.slot[row] = SLOT_VALUE;\n   357\t    }\n   358\t  }\n   359\t  const series = members.map(group => {\n   360\t    const length = group.order?.length ?? x.positions.length;\n   361\t    if (!group.order && values.y instanceof Float64Array && values.slot.every(slot => slot === SLOT_VALUE)) {\n   362\t      return {\n   363\t        key: group.key, label: group.label, drawable: true, x: x.positions, y: values.y,\n   364\t        row: table.columns ? null : sourceRows(table),\n   365\t      };\n   366\t    }\n   367\t    const rows = new Int32Array(length);\n   368\t    let next = 0;\n   369\t    let missing = 0;\n   370\t    for (let i = 0; i < length; i++) {\n   371\t      const row = group.order?.[i] ?? i;\n   372\t      if (values.slot[row] === SLOT_VALUE) rows[next++] = row;\n   373\t      else missing++;\n   374\t    }\n   375\t    // The reader still needs each valid x when a diagnostic kept its y out of the plot.\n   376\t    // Their source rows too, so a re-encode can read them again (another field may have a value there).\n   377\t    const missingX = missing ? new Float64Array(missing) : undefined;\n   378\t    const missingRow = missing ? new Int32Array(missing) : undefined;\n   379\t    if (missingX && missingRow) {\n   380\t      let index = 0;\n   381\t      for (let i = 0; i < length; i++) {\n   382\t        const row = group.order?.[i] ?? i;\n   383\t        if (values.slot[row] === SLOT_VALUE) continue;\n   384\t        missingX[index] = x.positions[row]!;\n   385\t        missingRow[index++] = table.rowIndex(row);\n   386\t      }\n   387\t    }\n   388\t    const kept = rows.subarray(0, next);\n   389\t    kept.sort((a, b) => x.positions[a]! - x.positions[b]! || values.y[a]! - values.y[