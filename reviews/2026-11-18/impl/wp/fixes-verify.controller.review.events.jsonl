rything accepted, the held rows included (finding 6).\n   355\t    const a = held ? { ...accepted, dataDiagnostics: held.dataDiagnostics, viewDiagnostics: held.viewDiagnostics } : accepted;\n   356\t    return toPublic([...stateDiagnostics(a), ...presentationList()], accepted.name);\n   357\t  }\n   358\t\n   359\t  /** Replaces what a presentation stage found; outside a frame the change is delivered at once. */\n   360\t  function setPresentation(where: PresentationStage, list: readonly DiagnosticInput[]): void {\n   361\t    const before = presentation.get(where) ?? [];\n   362\t    if (before.length === 0 && list.length === 0) return;\n   363\t    if (before.length === list.length && before.every((d, i) => diagnosticKey(d) === diagnosticKey(list[i]!))) return;\n   364\t    if (list.length) presentation.set(where, list);\n   365\t    else presentation.delete(where);\n   366\t    if (!inFrame && !destroyed) {\n   367\t      deliverChanges();\n   368\t      // The reader's note may change with it (spec F12).\n   369\t      schedule();\n   370\t    }\n   371\t  }\n   372\t\n   373\t  function addPresentation(where: PresentationStage, d: DiagnosticInput): void {\n   374\t    const list = presentation.get(where) ?? [];\n   375\t    if (list.some(o => o.code === d.code && o.field === d.field)) return;\n   376\t    setPresentation(where, [...list, d]);\n   377\t  }\n   378\t\n   379\t  function formatterFailed(field: string): void {\n   380\t    addPresentation('format', createDiagnostic('AX160', 'changed', { field }, 'presentation'));\n   381\t  }\n   382\t\n   383\t  /**\n   384\t   * Notifications to author code (onDiagnostic, the console, event listeners) in call order: each delivery\n   385\t   * is a snapshot taken when it is made and is drained in full, and one made by author code during a drain\n   386\t   * waits behind it. Only destruction stops a drain (review 3, finding 7).\n   387\t   */\n   388\t  const notifications: (() => void)[] = [];\n   389\t  let dra