  let length = 0;\n    77\t  let examined = 0;\n    78\t  let cellsExamined = 0;\n    79\t  let usedLattice = false;\n    80\t\n    81\t  function cellIndex(pixel: number, origin: number, size: number): number {\n    82\t    // Subtracting the origin from a rounded plot edge can place that edge one cell past the grid.\n    83\t    return Math.max(0, Math.min(size - 1, Math.floor((pixel - origin) / CELL)));\n    84\t  }\n    85\t\n    86\t  const column = (x: number) => cellIndex(x, plot.x, columns);\n    87\t  const row = (y: number) => cellIndex(y, plot.y, rows);\n    88\t\n    89\t  function sourceRow(at: number): number {\n    90\t    const i = points[at]!;\n    91\t    return view.frame.series[series[at]!]!.row?.[i] ?? i;\n    92\t  }\n    93\t\n    94\t  view.frame.series.forEach((data, s) => {\n    95\t    if (!view.visible[s] || !data.drawable) return;\n    96\t    const { start, end } = view.visiblePoints[s]!;\n    97\t    for (let i = start; i < end; i++) {\n    98\t      const x = scatterPosition(projection.x, data.x[i]!);\n    99\t      const y = scatterPosition(projection.y, data.y[i]!);\n   100\t      // Exact positions decide what is in the plot, on both indexes.\n   101\t      if (!contains(plot, x, y)) continue;\n   102\t      const at = length++;\n   103\t      xs[at] = x;\n   104\t      ys[at] = y;\n   105\t      series[at] = s;\n   106\t      points[at] = i;\n   107\t    }\n   108\t  });\n   109\t\n   110\t  /** The most points in any 4 × 4 block of cells. */\n   111\t  function densestWindow(): number {\n   112\t    const counts = new Int32Array((columns + 1) * (rows + 1));\n   113\t    // Summed-area table, one row and column of zeros in front.\n   114\t    for (let at = 0; at < length; at++) counts[(row(ys[at]!) + 1) * (columns + 1) + column(xs[at]!) + 1]!++;\n   115\t    for (let r = 1; r <= rows; r++) {\n   116\t      for (let c = 1; c <= columns; c++) {\n   117\t        const i = r * (columns + 1) + c;\n   118\t        counts[i] = counts[i]! + counts[i - 1]! + counts[i - columns - 1]! - counts[i - columns - 2]!;\n   119\t      }\n   120\t    }\n   121\t    let densest = 0;\n   122\t    for (let r = 0; r < rows; r++) {\n   123\t      for (let c = 0; c < columns; c++) {\n   124\t        const r1 = Math.min(rows, r + 4);\n   125\t        const c1 = Math.min(columns, c + 4);\n   126\t        const sum = counts[r1 * (columns + 1) + c1]! - counts[r * (columns + 1) + c1]! - counts[r1 * (columns + 1) + c]! + counts[r * (columns + 1) + c]!;\n   127\t        densest = Math.max(densest, sum);\n   128\t      }\n   129\t    }\n   130\t    return densest;\n   131\t  }\n   132\t\n   133\t  type Index = (x: number, y: number, limit: number) => ScatterPick | null;\n   134\t\n   135\t  function index(px: Float64Array, py: Float64Array): Index {\n   136\t    const cellFor = (x: number, y: number) => column(x) + columns * row(y);\n   137\t    const heads = new Map<number, number>();\n   138\t    const next = new Int32Array(length);\n   139\t    for (let at = 0; at < length; at++) {\n   140\t      const cell = cellFor(px[at]!, py[at]!);\n   141\t      next[at] = heads.get(cell) ?? -1;\n   142\t      heads.set(cell, at);\n   143\t    }\n   144\t\n   145\t    function later(at: number, other: number): boolean {\n   146\t      const difference = sourceRow(at) - sourceRow(other);\n   147\t      if (difference !== 0) return difference > 0;\n   148\t      const cellDifference = cellFor(px[at]!, py[at]!) - cellFor(px[other]!, py[other]!);\n   149\t      return cellDifference < 0 || cellDifference === 0 && at > other;\n   150\t    }\n   151\t\n   152\t    const order = new Uint32Array(length);\n   153\t    const multiplicity = new Uint32Array(length);\n   154\t    const buckets = new Map<number, Bucket>();\n   155\t    function build(start: number, end: number, allowSkew = true): Bucket {\n   156\t      let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;\n   157\t      let count = 0;\n   158\t      for (let i