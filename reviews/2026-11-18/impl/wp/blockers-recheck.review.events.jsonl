edule();\n   588\t    }\n   589\t  }\n   590\t\n   591\t  function nextVersion(): { epoch: number; revision: number } {\n   592\t    return { epoch: ++epochs, revision: ++frameRevision };\n   593\t  }\n   594\t\n   595\t  function update(patch: unknown): void {\n   596\t    guarded(call => {\n   597\t      stage('options');\n   598\t      const { next, changed } = options.preview(patch);\n   599\t      const previous = accepted;\n   600\t      const supplied = patch !== null && typeof patch === 'object' && Object.hasOwn(patch, 'data');\n   601\t      const optionSink = new DiagnosticCollector();\n   602\t      Object.assign(call, {\n   603\t        sink: optionSink, strict: next.strict === true, name: chartName(next), handler: next.onDiagnostic,\n   604\t        naming: previous === null ? namingDiagnostics(next) : [],\n   605\t      });\n   606\t      const messages = messagesFor(next, previous);\n   607\t      let c: Candidate;\n   608\t      let commit: (() => void) | null = null;\n   609\t      let heldAfter: typeof held = null;\n   610\t      const replace = previous === null || changed.has('data') || (supplied && previous.store !== null);\n   611\t      const reencode = !replace && encodingChanged(previous!.options, next);\n   612\t      if (!replace && reencode && previous!.store === null && namesOnlyChanged(previous!.options, next)) {\n   613\t        // Labels or units only, over the caller's own data: the same columns with new names (finding 12).\n   614\t        const resolved = resolveOptions(kind, publicOptions(next), optionSink, previous!.source.table);\n   615\t        const p = previous!;\n   616\t        const opts = optionSink.inputs().filter(d => !DATA_CODES.has(d.code));\n   617\t        c = {\n   618\t          options: next, resolved, source: resolved, store: null, frame: renamed(p.frame, resolved, frameRevision += 1),\n   619\t          dataDiagnostics: p.dataDiagnostics, dataOptions: p.dataOptions,\n   620\t          optionDiagnostics: dedupe