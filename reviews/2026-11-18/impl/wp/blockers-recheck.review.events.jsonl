+ 0.5).length, rows: el.querySelectorAll('button').length };\n   134\t    });\n   135\t    if (t) {\n   136\t      expect(t.cut).toBe(0);\n   137\t      expect(t.box.y + t.box.height).toBeLessThanOrEqual(card.y + card.height + 0.5);\n   138\t      expect(t.rows).toBeGreaterThanOrEqual(1);\n   139\t    } else {\n   140\t      // Nothing visible could be shown: then nothing is pinned either.\n   141\t      expect((await tip(page)).pinned).toBe(false);\n   142\t    }\n   143\t    expect(await closePage(page)).toEqual([]);\n   144\t  });\n   145\t\n   146\t  it('a strip its card clips away entirely is not shown, and a click on the plot holds no pin', async () => {\n   147\t    // A 220 px tile (readout mode) in a card that ends at the plot's bottom: the strip is wholly cut off.\n   148\t    const page = await chartPage({ css: '#card { width: 220px; overflow: hidden; } #card #chart { width: 220px; height: 400px; }' });\n   149\t    await page.evaluate(() => {\n   150\t      const card = Object.assign(document.createElement('div'), { id: 'card' });\n   151\t      const chart = document.getElementById('chart')!;\n   152\t      chart.replaceWith(card);\n   153\t      card.appendChild(chart);\n   154\t    });\n   155\t    await create(page, 'line', { title: 'S', legend: false, table: false, data: [0, 1, 2].map(x => ({ x, y: x })), x: 'x', y: 'y' });\n   156\t    const p = await plotBox(page);\n   157\t    await page.evaluate(h => { document.getElementById('card')!.style.height = `${h}px`; }, p.y + p.height - (await page.locator('#card').boundingBox())!.y);\n   158\t    await settle(page);\n   159\t    await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   160\t    await page.mouse.down();\n   161\t    await page.mouse.up();\n   162\t    await settle(page);\n   163\t    expect(await page.locator('#chart .axylo-readout').evaluate(el => (el as HTMLElement).hidden)).toBe(true);\n   164\t    expect(await page.locator('#chart .axylo-readout-pinned').count()).toBe(0);\n   165\t    expect(await closePage(page)).toEqual([]);\n   166\t  });\n   167\t});\n   168\t\n   169\tdescribe('5: the visible region follows the composed clipping chain', () => {\n   170\t  it('a chart in a shadow root inside a clipping card: its tooltip stays inside the card; a press on a pinned row keeps the pin', async () => {\n   171\t    const page = await chartPage({ css: '#card { width: 360px; overflow: hidden; margin-top: 30px; }' });\n   172\t    await page.evaluate(() => {\n   173\t      const card = Object.assign(document.createElement('div'), { id: 'card' });\n   174\t      document.getElementById('chart')!.replaceWith(card);\n   175\t      const host = document.createElement('div');\n   176\t      card.appendChild(host);\n   177\t      const root = host.attachShadow({ mode: 'open' });\n   178\t      // The page's stylesheets (the library's among them) apply inside the shadow root too.\n   179\t      for (const sheet of document.querySelectorAll('style, link[rel=\"stylesheet\"]')) root.appendChild(sheet.cloneNode(true));\n   180\t      const inner = Object.assign(document.createElement('div'), { id: 'chart' });\n   181\t      inner.style.cssText = 'width: 360px; height: 360px;';\n   182\t      root.appendChild(inner);\n   183\t      (window as unknown as { shadowChart: HTMLElement }).shadowChart = inner;\n   184\t    });\n   185\t    await page.evaluate(async () => {\n   186\t      const target = (window as unknown as { shadowChart: HTMLElement }).shadowChart;\n   187\t      // Points on the plot's top edge: above them there is no room, below them the card ends soon.\n   188\t      const series = ['A', 'B'];\n   189\t      const chart = window.Axylo.line!(target, { title: 'Shadow', data: [0, 1, 2, 3].flatMap(x => series.map(s => ({ x, s, y: 10 }))), x: 'x', y: { field: 'y', domain: [0, 10] }, series: 's' });\n   190\t      window.charts.push(chart);\n   191\t      await chart.__bench.ready();\n   192\t      await window.nextFrames(2);\n   193\t    });\n 