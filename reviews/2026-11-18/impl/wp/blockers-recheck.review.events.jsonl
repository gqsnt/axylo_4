ck\n   276\t    // reaching the maximum is the last one, and the last tick reaching the minimum is the first one.\n   277\t    const reachesHi = (t: number) => t >= hi || near(t, hi);\n   278\t    const reachesLo = (t: number) => t <= lo || near(t, lo);\n   279\t    const upper = (full !== null && near(b, full)) || set.findIndex(t => reachesHi(t.value)) === set.length - 1;\n   280\t    let lowest = -1;\n   281\t    for (let i = set.length - 1; i >= 0; i--) if (reachesLo(set[i]!.value)) { lowest = i; break; }\n   282\t    return upper && lowest === 0;\n   283\t  });\n   284\t  return fits.length ? fits : sets;\n   285\t}\n   286\t\n   287\t/** The axis titles layout draws (spec L6), with their units; undefined where an axis is untitled. */\n   288\tfunction axisTitles(view: Exclude<View, { kind: 'donut' }>, ctx: AxisContext): { x: string | undefined; y: string | undefined } {\n   289\t  if (ctx.compact) return { x: undefined, y: undefined };\n   290\t  if (view.kind === 'scatter') {\n   291\t    return {\n   292\t      x: xTitled(view.frame.xKind, ctx) ? withUnit(view.frame.xLabel, view.frame.xUnit) : undefined,\n   293\t      y: withUnit(view.frame.yLabel, view.frame.yUnit),\n   294\t    };\n   295\t  }\n   296\t  return {\n   297\t    x: xTitled(view.frame.x.kind, ctx) ? withUnit(view.frame.xLabel, ctx.resolved.x.unit) : undefined,\n   298\t    y: withUnit(view.frame.yLabel ?? alignedValueTitle(view.frame.series, ctx.valueTitle), sharedUnit(view.frame.series)),\n   299\t  };\n   300\t}\n   301\t\n   302\t/** Spec L6: a number x is a measure and is titled; time, date and category ticks already say what they are. */\n   303\tfunction xTitled(kind: XKind, ctx: AxisContext): boolean {\n   304\t  return kind === 'number' || ctx.xLabelGiven;\n   305\t}\n   306\t\n   307\t/** A value axis is always titled (spec L6): its label, else its one field, else the generic noun. */\n   308\tfunction alignedValueTitle(series: readonly { readonly field: string }[], generic: string): 