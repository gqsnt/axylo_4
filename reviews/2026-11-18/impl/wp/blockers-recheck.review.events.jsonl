  const spot = { x: hole.cx - width / 2, y: hole.cy - height / 2, width, height };\n   135\t  // The corners are the farthest points of the rectangle from the centre.\n   136\t  const reach = (width / 2 / hole.rx) ** 2 + (height / 2 / hole.ry) ** 2;\n   137\t  if (reach > 1 + EPSILON || !insideRect(spot, p.visible)) return null;\n   138\t  if (p.controls.some(c => overlapArea(spot, c) > 0)) return null;\n   139\t  if (p.rings.some(r => strokes(r, p.ringStroke).some(s => overlapArea(spot, s) > 0))) return null;\n   140\t  return { x: spot.x, y: spot.y, side: 'hole' };\n   141\t}\n   142\t\n   143\t/** Rule 2: the first valid candidate for a tooltip of this size, or null. */\n   144\texport function placeTooltip(p: PlacementInput, width: number, height: number): Spot | null {\n   145\t  if (width > p.visible.width + EPSILON || height > p.visible.height + EPSILON) return null;\n   146\t  const hole = holeSpot(p, width, height);\n   147\t  if (hole) return hole;\n   148\t  const obstacles = [p.box, ...p.controls, ...p.rings];\n   149\t  for (const side of sides(p.order)) {\n   150\t    const { fixed, preferred } = anchorOf(side, p.box, width, height);\n   151\t    // The fixed coordinate must already be inside the visible part; only the free axis may shift.\n   152\t    const vertical = side === 'above' || side === 'below';\n   153\t    const inside = vertical\n   154\t      ? fixed >= p.visible.y - EPSILON && fixed + height <= p.visible.y + p.visible.height + EPSILON\n   155\t      : fixed >= p.visible.x - EPSILON && fixed + width <= p.visible.x + p.visible.width + EPSILON;\n   156\t    if (!inside) continue;\n   157\t    const spot = along(side, fixed, preferred, width, height, p.visible, obstacles);\n   158\t    if (spot) return spot;\n   159\t  }\n   160\t  return null;\n   161\t}\n   162\t\n   163\t/**\n   164\t * Rule 6's last resort, for one row that fits nowhere: each side pushed into the visible part and shifted\n   165\t * along its free axis clear of every control and focus ring; the one covering the box least. Null when no\n   166\t * such position exists (the tooltip is then not shown floating; the values are in the keyboard reading and\n   167\t * the table).\n   168\t */\n   169\texport function fallbackPlacement(p: PlacementInput, width: number, height: number): Spot | null {\n   170\t  if (width > p.visible.width + EPSILON || height > p.visible.height + EPSILON) return null;\n   171\t  const obstacles = [...p.controls, ...p.rings];\n   172\t  let best: { spot: Spot; cost: number; off: number } | null = null;\n   173\t  for (const side of sides(p.order)) {\n   174\t    const { fixed, preferred } = anchorOf(side, p.box, width, height);\n   175\t    const vertical = side === 'above' || side === 'below';\n   176\t    const pushed = vertical\n   177\t      ? Math.max(p.visible.y, Math.min(fixed, p.visible.y + p.visible.height - height))\n   178\t      : Math.max(p.visible.x, Math.min(fixed, p.visible.x + p.visible.width - width));\n   179\t    // Every legal position along the free axis where the overlap with the box can be least: the centred\n   180\t    // one, the bounds, each obstacle's edges, and where the tooltip just clears the box (review finding 11).\n   181\t    const lo = vertical ? p.visible.x : p.visible.y;\n   182\t    const hi = vertical ? p.visible.x + p.visible.width - width : p.visible.y + p.visible.height - height;\n   183\t    const size = vertical ? width : height;\n   184\t    const edges = [preferred, lo, hi, vertical ? p.box.x - size : p.box.y - size, vertical ? p.box.x + p.box.width : p.box.y + p.box.height];\n   185\t    for (const o of obstacles) edges.push(vertical ? o.x - size : o.y - size, vertical ? o.x + o.width : o.y + o.height);\n   186\t    for (const e of edges) {\n   187\t      const at = Math.max(lo, Math.min(hi, e));\n   188\t      const spot: Spot = vertical ? { x: at, y: pushed, side } : { x: pushed, y: at, side };\n   189\t      const r = { x: spot.x, y: spot.y, width, height };\n   190\t      if (obstacles.some(o => overlapArea(r, o) > 0)) continue;\n   191\t      const cost = overlapArea(r, p.box);\n   192\t      const off = Math.abs(at - preferred);\n   193\t      if (!best || cost < best.cost - EPSILON || (Math.abs(cost - best.cost) <= EPSILON && spot.side === best.spot.side && off < best.off - EPSILON)) best = { spot, cost, off };\n   194\t    }\n   195\t    // Candidates of later sides win only by covering less (the side order is kept on ties).\n   196\t    if (best && best.cost <= EPSILON) break;\n   197\t  }\n   198\t  return best?.spot ?? null;\n   199\t}\n   200\t\n   201\t/** Whether a tooltip at `spot` would be valid by rule 2 (for tests and for the caller's own checks). */\n   202\texport function validSpot(p: PlacementInput, spot: { x: number; y: number }, width: number, height: number): boolean {\n   203\t  const r = { x: spot.x, y: spot.y, width, height };\n   204\t  if (!insideRect(r, p.visible)) return false;\n   205\t  if (p.controls.some(c => overlapArea(r, c) > 0) || p.rings.some(c => overlapArea(r, c) > 0)) return false;\n   206\t  return overlapArea(r, p.box) === 0;\n   207\t}\n   208\t\n   209\t/** The rectangle two rectangles share, or an empty one at the first's corner. */\n   210\texport function intersect(a: Rect, b: Rect): Rect {\n","exit_code":0,"status":"completed"}}
