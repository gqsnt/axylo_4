{"type":"item.completed","item":{"id":"item_91","type":"command_execution","command":"/bin/bash -lc \"git show HEAD:packages/axylo/test/browser/chart/reattach.browser.test.ts | nl -ba | sed -n '1,112p'\"","aggregated_output":"     1\t/**\n     2\t * A chart taken out of the document and put back (core/chart.ts; verification of the controller fixes, defect\n     3\t * 11 and the missing regressions): a watcher that fails while the chart is put back leaves nothing subscribed\n     4\t * and does not stop the next notification from setting the watchers up; and a font that loaded while the\n     5\t * chart was out is measured with, once it is back (spec L1). Run on chromium, firefox and webkit (AXYLO_ENGINE).\n     6\t */\n     7\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     8\timport fs from 'node:fs';\n     9\timport type { Page } from 'playwright-core';\n    10\timport { openEntry, start, stop } from '../harness';\n    11\t\n    12\tbeforeAll(start);\n    13\tafterAll(stop);\n    14\t\n    15\tconst frames = (page: Page, n = 3) => page.evaluate((n: number) => new Promise<void>(resolve => {\n    16\t  const step = (k: number) => k === 0 ? resolve() : requestAnimationFrame(() => step(k - 1));\n    17\t  step(n);\n    18\t}), n);\n    19\t\n    20\tdescribe('a chart put back into the document', () => {\n    21\t  it('a watcher that throws once while it is put back: nothing stays subscribed, and the next resize sets them all up', async () => {\n    22\t    const page = await openEntry('packages/axylo/test/browser/chart/entries/reattach.entry.ts');\n    23\t    await page.evaluate(() => {\n    24\t      // Media-query listeners alive, one entry per list and listener (the theme watcher gives its three lists\n    25\t      // one function), counted at the page's own matchMedia; `failAt` makes one call throw.\n    26\t      const live: [MediaQueryList, unknown][] = [];\n    27\t      const original = window.matchMedia.bind(window);\n    28\t      const state = { live, calls: 0, failAt: -1 };\n    29\t      (window as unknown as { media: typeof state }).media = state;\n    30\t      window.matchMedia = (query: string) => {\n    31\t        if (state.calls++ === state.failAt) throw new Error('matchMedia failed');\n    32\t        const list = original(query);\n    33\t        const add = list.addEventListener.bind(list);\n    34\t        const remove = list.removeEventListener.bind(list);\n    35\t        list.addEventListener = ((type: string, fn: EventListenerOrEventListenerObject) => { live.push([list, fn]); add(type, fn); }) as typeof list.addEventListener;\n    36\t        list.removeEventListener = ((type: string, fn: EventListenerOrEventListenerObject) => {\n    37\t          const at = live.findIndex(([l, f]) => l === list && f === fn);\n    38\t          if (at >= 0) live.splice(at, 1);\n    39\t          remove(type, fn);\n    40\t        }) as typeof list.removeEventListener;\n    41\t        return list;\n    42\t      };\n    43\t      const box = document.body.appendChild(document.createElement('div'));\n    44\t      box.id = 'box';\n    45\t      (window as unknown as { box: HTMLElement }).box = box;\n    46\t      box.style.cssText = 'width: 600px; height: 320px;';\n    47\t      window.reattach.line(box, { title: 'R', data: [0, 1, 2].map(x => ({ x, y: x })), x: 'x', y: 'y' });\n    48\t    });\n    49\t    await frames(page);\n    50\t    type Media = { live: unknown[]; calls: number; failAt: number };\n    51\t    const liveCount = () => page.evaluate(() => (window as unknown as { media: Media }).media.live.length);\n    52\t    const watching = await liveCount();\n    53\t    // The theme watcher's three media features and the environment's resolution and motion queries.\n    54\t    expect(watching).toBe(5);\n    55\t    await page.evaluate(() => document.getElementById('box')!.remove());\n    56\t    await frames(page);\n    57\t    expect(await liveCount()).toBe(0);\n    58\t    // Put back with the environment watcher's first matchMedia throwing, after the theme watcher's three.\n    59\t    await page.evaluate(() => {\n    60\t      const media = (window as unknown as { media: Media }).media;\n    61\t      media.failAt = media.calls + 3;\n    62\t      document.body.appendChild((window as unknown as { box: HTMLElement }).box);\n    63\t    });\n    64\t    await frames(page);\n    65\t    expect(await liveCount()).toBe(0);\n    66\t    // The next notification (a resize) sets every watcher up.\n    67\t    await page.evaluate(() => { document.getElementById('box')!.style.width = '640px'; });\n    68\t    await frames(page);\n    69\t    expect(await liveCount()).toBe(watching);\n    70\t    await page.context().close();\n    71\t  });\n    72\t\n    73\t  it('a font loaded while it was out: once back, its tick labels are measured as they render, within 0.5 px', async () => {\n    74\t    const page = await openEntry('packages/axylo/test/browser/chart/entries/reattach.entry.ts');\n    75\t    const font = fs.readFileSync('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf').toString('base64');\n    76\t    await page.evaluate(() => {\n    77\t      const box = document.body.appendChild(document.createElement('div'));\n    78\t      box.id = 'box';\n    79\t      box.style.cssText = 'width: 600px; height: 320px; font-family: \"Late Sans\", sans-serif;';\n    80\t      window.reattach.line(box, { title: 'F', data: [0, 1, 2].map(x => ({ x, y: x * 14000 })), x: 'x', y: 'y' });\n    81\t    });\n    82\t    await frames(page);\n    83\t    const labels = () => page.evaluate(() => {\n    84\t      const layer = document.querySelector('#box .axylo-text')!;\n    85\t      // Tick labels, which are in the text layer's own style (titles have their own).\n    86\t      return Array.from(layer.querySelectorAll('.axylo-label[data-role^=\"tick\"]')).map(el => ({\n    87\t        text: el.textContent ?? '', rendered: el.getBoundingClientRect().width, measured: window.reattach.width(el.textContent ?? '', layer),\n    88\t      })).filter(l => l.text.trim() !== '');\n    89\t    });\n    90\t    const before = await labels();\n    91\t    expect(before.length).toBeGreaterThan(0);\n    92\t    await page.evaluate(async f => {\n    93\t      const box = document.getElementById('box')!;\n    94\t      box.remove();\n    95\t      await new Promise(r => requestAnimationFrame(() => r(null)));\n    96\t      // Loaded, then added: no 'loadingdone' reaches the chart, and it is out of the document meanwhile.\n    97\t      const bytes = Uint8Array.from(atob(f), c => c.charCodeAt(0));\n    98\t      const face = new FontFace('Late Sans', bytes);\n    99\t      await face.load();\n   100\t      document.fonts.add(face);\n   101\t      await document.fonts.ready;\n   102\t      document.body.appendChild(box);\n   103\t    }, font);\n   104\t    await frames(page, 4);\n   105\t    const after = await labels();\n   106\t    const widest = (list: typeof before) => Math.max(...list.map(l => l.rendered));\n   107\t    // The font did change the labels, so the check is about a real change.\n   108\t    expect(Math.abs(widest(after) - widest(before))).toBeGreaterThan(2);\n   109\t    for (const label of after) expect(Math.abs(label.measured - label.rendered), label.text).toBeLessThan(0.5);\n   110\t    await page.context().close();\n   111\t  });\n   112\t});\n","exit_code":0,"status":"completed"}}
