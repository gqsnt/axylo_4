{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc 'git show HEAD:packages/axylo/test/core/verify-pass.test.ts | nl -ba'","aggregated_output":"     1\t/**\n     2\t * The cross-provider verification of the controller fixes (reviews/2026-11-18/impl/wp/fixes-verify.controller.review.md):\n     3\t * each new defect in the controller's files as the reviewer's call sequence, and the regressions the review\n     4\t * found missing. Expected values come from the spec, the fixture rows and the retention policy's stated bound.\n     5\t */\n     6\timport { describe, expect, it } from 'vitest';\n     7\timport type { AlignedView, DatumRef, Frame, ScatterView } from '../../src/core/contracts';\n     8\timport type { Diagnostic, Point } from '../../src/public';\n     9\timport { lastModel, record, type Recording } from './host';\n    10\t\n    11\tconst rowsOf = (values: readonly number[]) => values.map(x => ({ x, y: x * 10 }));\n    12\tconst ref = (x: number, seriesKey = 'y'): DatumRef => ({ kind: 'aligned', seriesKey, x });\n    13\tconst xsOf = (r: Recording) => Array.from((r.committed!.view as AlignedView).frame.x.values);\n    14\tconst codes = (r: Recording) => r.controller.handle.diagnostics.map(d => d.code);\n    15\tconst points = (r: Recording) => (r.committed!.view as ScatterView).frame.series.flatMap(s => Array.from(s.x));\n    16\t\n    17\tfunction hoverPoint(r: Recording, target: DatumRef): Point<unknown> | null | undefined {\n    18\t  let seen: Point<unknown> | null | undefined;\n    19\t  const off = r.controller.handle.on('hover', p => { seen = p; });\n    20\t  r.controller.actions.hover(null);\n    21\t  r.controller.actions.hover(target);\n    22\t  r.frames(1);\n    23\t  off();\n    24\t  return seen;\n    25\t}\n    26\t\n    27\tdescribe('new defect 2: a hidden, paused chart keeps the retention bound', () => {\n    28\t  it('x=2 drawn with keep 1, Pause, hide, 500 appends with keep 1 and a frame after each: within twice what was on screen plus 8', () => {\n    29\t    const r = record('line', { title: 'K', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n    30\t    r.frames();\n    31\t    r.controller.handle.append([{ x: 2, y: 20 }], { keep: 1 });\n    32\t    r.frames();\n    33\t    expect(xsOf(r)).toEqual([2]);\n    34\t    // The policy's baseline: what the store held right after the frame that showed x=2.\n    35\t    const baseline = r.controller.handle.__dev!.retainedRows();\n    36\t    r.controller.actions.pause(true);\n    37\t    r.container = null;\n    38\t    r.controller.invalidate.resize();\n    39\t    let most = 0;\n    40\t    for (let x = 3; x <= 503; x++) {\n    41\t      r.controller.handle.append([{ x, y: x }], { keep: 1 });\n    42\t      r.frames();\n    43\t      most = Math.max(most, r.controller.handle.__dev!.retainedRows());\n    44\t    }\n    45\t    expect(most).toBeLessThanOrEqual(2 * baseline + 8);\n    46\t    // Shown again and resumed: the newest row, with its own row.\n    47\t    r.container = { width: 720, height: 400 };\n    48\t    r.controller.invalidate.resize();\n    49\t    r.controller.actions.pause(false);\n    50\t    r.frames();\n    51\t    expect(xsOf(r)).toEqual([503]);\n    52\t    expect(hoverPoint(r, ref(503))?.row).toEqual({ x: 503, y: 503 });\n    53\t  });\n    54\t});\n    55\t\n    56\tdescribe('new defect 3: a tick formatter that changes the chart', () => {\n    57\t  it('(a) one that switches to an unformatted field and throws: no AX160 is delivered under the new title', () => {\n    58\t    const seen: [string, string][] = [];\n    59\t    let chart: Recording['controller']['handle'] | null = null;\n    60\t    let armed = true;\n    61\t    const tickFormat = (v: number) => {\n    62\t      if (armed && chart) {\n    63\t        armed = false;\n    64\t        chart.update({ title: 'New', y: 'z' });\n    65\t        throw new Error('tick');\n    66\t      }\n    67\t      return String(v);\n    68\t    };\n    69\t    const data = [0, 1, 2].map(x => ({ x, y: x, z: 2 * x }));\n    70\t    const r = record('line', {\n    71\t      title: 'Old', data, x: 'x', y: { field: 'y', tickFormat }, onDiagnostic: (d: Diagnostic) => seen.push([d.code, d.chart]),\n    72\t    });\n    73\t    chart = r.controller.handle;\n    74\t    r.frames();\n    75\t    expect(lastModel(r).title?.text).toBe('New');\n    76\t    // The revision whose formatter threw was never drawn; the one drawn has no tick formatter.\n    77\t    expect(seen.filter(([code]) => code === 'AX160')).toEqual([]);\n    78\t    expect(codes(r)).not.toContain('AX160');\n    79\t  });\n    80\t\n    81\t  it('(b) one that calls update({ title }) on every call: the new title is drawn and no frame stays pending', () => {\n    82\t    let chart: Recording['controller']['handle'] | null = null;\n    83\t    const tickFormat = (v: number) => {\n    84\t      chart?.update({ title: 'New title' });\n    85\t      return String(v);\n    86\t    };\n    87\t    const r = record('line', { title: 'Old title', data: rowsOf([0, 1, 2]), x: 'x', y: { field: 'y', tickFormat } });\n    88\t    chart = r.controller.handle;\n    89\t    r.frames(6);\n    90\t    expect(lastModel(r).title?.text).toBe('New title');\n    91\t    expect(r.pending).toBe(0);\n    92\t  });\n    93\t});\n    94\t\n    95\tdescribe('new defect 4: re-encoding while paused', () => {\n    96\t  it('a ninth series held: after y is changed to another populated field AX130 stays, and update({ strict: true }) is rejected', () => {\n    97\t    const data = Array.from({ length: 8 }, (_, k) => ({ x: 0, s: `s${k}`, y: k, w: k + 1 }));\n    98\t    const r = record('line', { title: 'P', data, x: 'x', y: 'y', series: 's' });\n    99\t    r.frames();\n   100\t    r.controller.handle.append([{ x: 1, s: 's0', y: 1, w: 2 }]);\n   101\t    r.frames();\n   102\t    r.controller.actions.pause(true);\n   103\t    r.controller.handle.append([{ x: 2, s: 'ninth', y: 1, w: 2 }]);\n   104\t    expect(codes(r)).toContain('AX130');\n   105\t    r.controller.handle.update({ y: 'w' });\n   106\t    expect(codes(r)).toContain('AX130');\n   107\t    expect(() => r.controller.handle.update({ strict: true })).toThrow(/AX130/);\n   108\t  });\n   109\t\n   110\t  it('scatter: a displayed row with x null and a valid u is a point as soon as x becomes u, while paused', () => {\n   111\t    const data = [{ x: 0, u: 0, y: 1 }, { x: null, u: 5, y: 2 }, { x: 2, u: 2, y: 3 }];\n   112\t    const r = record('scatter', { title: 'S', data, x: 'x', y: 'y' });\n   113\t    r.frames();\n   114\t    r.controller.handle.append([{ x: 3, u: 3, y: 4 }]);\n   115\t    r.frames();\n   116\t    r.controller.actions.pause(true);\n   117\t    r.controller.handle.append([{ x: 4, u: 4, y: 5 }]);\n   118\t    r.controller.handle.update({ x: 'u' });\n   119\t    r.frames();\n   120\t    // The displayed rows read with x = u: 0, 5, 2, 3; the held arrival (u 4) waits for Resume.\n   121\t    expect(points(r).sort((p, q) => p - q)).toEqual([0, 2, 3, 5]);\n   122\t    r.controller.actions.pause(false);\n   123\t    r.frames();\n   124\t    expect(points(r).sort((p, q) => p - q)).toEqual([0, 2, 3, 4, 5]);\n   125\t  });\n   126\t\n   127\t  it('typed columns: a NaN in a typed column is \"no data\", not an omitted value, when re-encoded while paused', () => {\n   128\t    const columns = { x: Float64Array.from([0, 1, 2]), y: Float64Array.from([1, NaN, 3]), w: Float64Array.from([2, NaN, 4]) };\n   129\t    const r = record('line', { title: 'T', data: { columns }, x: 'x', y: 'y' });\n   130\t    r.frames();\n   131\t    expect(lastModel(r).note).toBeNull();\n   132\t    r.controller.handle.append([{ x: 3, y: 4, w: 5 }]);\n   133\t    r.frames();\n   134\t    r.controller.actions.pause(true);\n   135\t    r.controller.handle.append([{ x: 4, y: 5, w: 6 }]);\n   136\t    r.controller.handle.update({ y: 'w' });\n   137\t    r.frames();\n   138\t    expect(xsOf(r)).toEqual([0, 1, 2, 3]);\n   139\t    expect(codes(r)).not.toContain('AX103');\n   140\t    expect(lastModel(r).note).toBeNull();\n   141\t  });\n   142\t});\n   143\t\n   144\tdescribe('new defect 5: a frozen scatter frame keeps the precision its dates were written in', () => {\n   145\t  it('March (YYYY-MM) queued with keep 1, Pause before its frame, April to December with keep 1: March still reads as a month', () => {\n   146\t    const r = record('scatter', { title: 'M', data: [{ x: '2026-01', y: 1 }, { x: '2026-02', y: 2 }], x: 'x', y: 'y' });\n   147\t    r.frames();\n   148\t    r.controller.handle.append([{ x: '2026-03', y: 3 }], { keep: 1 });\n   149\t    r.controller.actions.pause(true);\n   150\t    for (let m = 4; m <= 12; m++) r.controller.handle.append([{ x: `2026-${String(m).padStart(2, '0')}`, y: m }], { keep: 1 });\n   151\t    r.frames();\n   152\t    const view = r.committed!.view as ScatterView;\n   153\t    const s = view.frame.series[0]!;\n   154\t    expect(s.x.length).toBe(1);\n   155\t    // Spec F4: '2026-03' is a month; its text names no day.\n   156\t    const text = r.committed!.formatters.x(s.x[0]!);\n   157\t    expect(text).toMatch(/2026/);\n   158\t    expect(text).not.toMatch(/\\b1\\b/);\n   159\t    const point = hoverPoint(r, { kind: 'point', seriesKey: s.key, row: s.row ? s.row[0]! : 0, x: s.x[0]! });\n   160\t    expect(point?.row).toEqual({ x: '2026-03', y: 3 });\n   161\t  });\n   162\t});\n   163\t\n   164\tdescribe('new defect 6: a throwing or re-entrant getter during a call', () => {\n   165\t  const throwing = () => ({ get x(): number { throw new Error('getter'); }, y: 1 });\n   166\t\n   167\t  it('strict: an append whose x getter throws is rejected, and the chart stays as it was', () => {\n   168\t    const r = record('line', { title: 'S', strict: true, data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   169\t    r.frames();\n   170\t    expect(() => r.controller.handle.append([throwing()])).toThrow();\n   171\t    r.frames();\n   172\t    expect(codes(r)).not.toContain('AX199');\n   173\t    expect(lastModel(r).message).toBeNull();\n   174\t    expect(xsOf(r)).toEqual([0, 1, 2]);\n   175\t  });\n   176\t\n   177\t  it('strict: a getter that runs a nested update does not end the outer call\\'s strict check', () => {\n   178\t    let chart: Recording['controller']['handle'] | null = null;\n   179\t    const r = record('line', { title: 'S', strict: true, data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   180\t    chart = r.controller.handle;\n   181\t    r.frames();\n   182\t    const data = [\n   183\t      { get x(): number { chart!.update({ subtitle: 'nested' }); return 5; }, y: 1 },\n   184\t      throwing(),\n   185\t    ];\n   186\t    expect(() => r.controller.handle.update({ data })).toThrow();\n   187\t    r.frames();\n   188\t    expect(codes(r)).not.toContain('AX199');\n   189\t    expect(xsOf(r)).toEqual([0, 1, 2]);\n   190\t  });\n   191\t\n   192\t  it('a getter that destroys the chart and returns: the destroyed handle keeps nothing', () => {\n   193\t    let chart: Recording['controller']['handle'] | null = null;\n   194\t    const r = record('line', { title: 'D', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   195\t    chart = r.controller.handle;\n   196\t    r.frames();\n   197\t    const data = [{ get x(): number { chart!.destroy(); return 1; }, y: 1 }, { x: 2, y: 2 }];\n   198\t    r.controller.handle.update({ palete: 'unknown option', data });\n   199\t    r.frames();\n   200\t    expect(r.disposed).toBe(1);\n   201\t    expect(chart.diagnostics).toEqual([]);\n   202\t    expect(chart.__dev!.retainedRows()).toBe(0);\n   203\t    expect(r.writesAfterDispose).toBe(0);\n   204\t    expect(r.pending).toBe(0);\n   205\t  });\n   206\t});\n   207\t\n   208\tdescribe('table finding 7: a call that fails part-way agrees with validate()', () => {\n   209\t  for (const kind of ['line', 'scatter'] as const) {\n   210\t    it(`${kind}, untitled: a throwing x getter gives what validate() gives, AX140 included`, async () => {\n   211\t      const { staticDiagnostics } = await import('../../src/core/stages');\n   212\t      const options = { data: [{ get x(): number { throw new Error('getter'); }, y: 1 }], x: 'x', y: 'y' };\n   213\t      const expected = staticDiagnostics(kind, options, 'UTC').map(d => d.code);\n   214\t      expect(expected).toEqual(['AX199', 'AX140']);\n   215\t      const r = record(kind, options);\n   216\t      r.frames();\n   217\t      expect(codes(r)).toEqual(expected);\n   218\t    });\n   219\t  }\n   220\t});\n   221\t\n   222\tdescribe('new defect 7 (controller half): the hover payload does not walk the points sharing x', () => {\n   223\t  it('50,000 points at one x, a hover subscriber, the last row picked: a few row indexes read, not one per point', () => {\n   224\t    const n = 50_000;\n   225\t    const data = Array.from({ length: n }, (_, i) => ({ x: 1, y: i }));\n   226\t    const r = record('scatter', { title: 'Same x', data, x: 'x', y: 'y' });\n   227\t    r.frames();\n   228\t    const view = r.committed!.view as ScatterView;\n   229\t    const series = view.frame.series[0]!;\n   230\t    const rows = series.row;\n   231\t    expect(rows).not.toBeNull();\n   232\t    const last = rows!.indexOf(n - 1);\n   233\t    const target: DatumRef = { kind: 'point', seriesKey: series.key, row: n - 1, x: 1 };\n   234\t    // The lookup locates the datum by itself; only the payload's own reads are counted.\n   235\t    expect(r.committed!.lookup.datum(target)?.row).toBe(n - 1);\n   236\t    let reads = 0;\n   237\t    const counted = new Proxy(rows!, { get(t, key) { if (typeof key === 'string' && /^\\d+$/.test(key)) reads++; const v = Reflect.get(t, key, t); return typeof v === 'function' ? v.bind(t) : v; } });\n   238\t    Object.defineProperty(series, 'row', { value: counted, configurable: true });\n   239\t    let seen: Point<unknown> | null = null;\n   240\t    r.controller.handle.on('hover', p => { seen = p; });\n   241\t    r.controller.actions.hover(target);\n   242\t    r.frames(1);\n   243\t    expect(seen).not.toBeNull();\n   244\t    expect(seen!.y).toBe(series.y[last]);\n   245\t    expect(seen!.row).toEqual({ x: 1, y: n - 1 });\n   246\t    expect(reads).toBeLessThanOrEqual(4);\n   247\t  });\n   248\t});\n   249\t\n   250\tdescribe('new defect 9: a donut with 112 px of plot room and a 48 px strip', () => {\n   251\t  const at = (height: number, settings: { strip: number; stripUnknown?: boolean }) => {\n   252\t    const r = record('donut', { title: 'D', data: [{ k: 'a', v: 1 }, { k: 'b', v: 2 }], label: 'k', value: 'v' }, { container: { width: 600, height }, ...settings });\n   253\t    r.frames();\n   254\t    return r;\n   255\t  };\n   256\t  // The plot's column is the container less the caption and the controls row (the host's model).\n   257\t  const columnOf = (r: Recording) => (r.host.measure() as { room?: { height: number } } | null)?.room?.height ?? NaN;\n   258\t  for (const stripUnknown of [false, true]) {\n   259\t    it(`${stripUnknown ? 'estimated' : 'measured'} strip: no strip is reserved, and the ring is drawn (rule 5, L8)`, () => {\n   260\t      let height = 100;\n   261\t      while (columnOf(at(height, { strip: 48 })) < 112) height++;\n   262\t      const r = at(height, { strip: 48, stripUnknown });\n   263\t      expect(columnOf(r)).toBe(112);\n   264\t      expect(r.layout!.kind).toBe('plot');\n   265\t      expect(codes(r)).not.toContain('AX142');\n   266\t      expect((r.prepared.at(-1) as unknown as { readoutMode?: string }).readoutMode).toBe('none');\n   267\t    });\n   268\t  }\n   269\t});\n   270\t\n   271\tdescribe('new defect 10: a narrow scatter keeps the automatic x domain ending at its ticks', () => {\n   272\t  it('x 1.1, 8.9, 10.7 with the last y null, at 185 × 400: the x domain\\'s ends are its first and last ticks', () => {\n   273\t    const data = [{ x: 1.1, y: 1 }, { x: 8.9, y: 2 }, { x: 10.7, y: null }];\n   274\t    const r = record('scatter', { title: 'N', data, x: 'x', y: 'y' });\n   275\t    r.frames();\n   276\t    r.container = { width: 185, height: 400 };\n   277\t    r.controller.invalidate.resize();\n   278\t    r.frames();\n   279\t    const layout = r.layout!;\n   280\t    if (layout.kind !== 'plot' || layout.projection.kind !== 'xy' || layout.projection.x.type === 'band') throw new Error('expected a plot');\n   281\t    const [a, b] = layout.projection.x.domain;\n   282\t    const ticks = layout.xTicks.map(t => t.value);\n   283\t    expect(a).toBeLessThanOrEqual(1.1);\n   284\t    expect(b).toBeGreaterThanOrEqual(10.7);\n   285\t    expect(ticks[0]).toBe(a);\n   286\t    expect(ticks.at(-1)).toBe(b);\n   287\t  });\n   288\t});\n   289\t\n   290\tdescribe('new defect 12 (controller half): memory() counts the buffers of every live frame', () => {\n   291\t  it('1,001 streamed rows drawn, Pause, an append with keep 2: the displayed frame\\'s buffers are counted', () => {\n   292\t    const r = record('line', { title: 'M', data: rowsOf([0]), x: 'x', y: 'y' });\n   293\t    r.frames();\n   294\t    r.controller.handle.append(rowsOf(Array.from({ length: 1000 }, (_, i) => i + 1)));\n   295\t    r.frames();\n   296\t    r.controller.actions.pause(true);\n   297\t    r.controller.handle.append(rowsOf([1001]), { keep: 2 });\n   298\t    r.frames();\n   299\t    const frame = r.committed!.view.frame as Extract<Frame, { shape: 'aligned' }>;\n   300\t    expect(frame.length).toBe(1001);\n   301\t    // The displayed frame's own buffers, each counted once at its full length.\n   302\t    const buffers = new Set<ArrayBufferLike>([frame.x.values.buffer]);\n   303\t    for (const s of frame.series) for (const key of ['y', 'slot', 'row'] as const) {\n   304\t      const value = Object.getOwnPropertyDescriptor(s, key)?.value as ArrayBufferView | null | undefined;\n   305\t      if (value) buffers.add(value.buffer);\n   306\t    }\n   307\t    const displayed = [...buffers].reduce((sum, b) => sum + b.byteLength, 0);\n   308\t    const memory = r.controller.handle.__bench!.memory();\n   309\t    expect(memory.bytes).toBeGreaterThanOrEqual(displayed);\n   310\t    expect(memory.buffers.reduce((sum, b) => sum + b.bytes, 0)).toBe(memory.bytes);\n   311\t  });\n   312\t});\n   313\t\n   314\tdescribe('claims not confirmed: the in-flight pin', () => {\n   315\t  it('the first stream frame publishing, an append with keep 1 from the commit, a hover from the commit: the frame\\'s own row', () => {\n   316\t    let seen: Point<unknown> | null | undefined;\n   317\t    let once = false;\n   318\t    const r = record('line', { title: 'Pin', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' }, {\n   319\t      onCommit: (_state, controller) => {\n   320\t        if (!once) return;\n   321\t        once = false;\n   322\t        // The frame being published is the store's first; this append evicts every one of its rows.\n   323\t        controller.handle.append([{ x: 9, y: 90 }], { keep: 1 });\n   324\t        controller.actions.hover(ref(3));\n   325\t      },\n   326\t    });\n   327\t    r.frames();\n   328\t    r.controller.handle.on('hover', p => { seen = p; });\n   329\t    r.controller.handle.append([{ x: 3, y: 30 }]);\n   330\t    once = true;\n   331\t    r.frames(1);\n   332\t    expect(seen?.row).toEqual({ x: 3, y: 30 });\n   333\t    r.frames();\n   334\t    expect(xsOf(r)).toEqual([9]);\n   335\t  });\n   336\t\n   337\t  it('the held datum itself evicted: hovering it on the paused screen gives its own row, and after Resume nothing stale', () => {\n   338\t    const r = record('line', { title: 'H', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   339\t    r.frames();\n   340\t    r.controller.handle.append([{ x: 3, y: 30 }]);\n   341\t    r.frames();\n   342\t    r.controller.actions.pause(true);\n   343\t    // Every row on screen, the hovered x 3 included, is evicted from the store while paused.\n   344\t    for (let x = 4; x < 40; x++) r.controller.handle.append([{ x, y: x * 10 }], { keep: 1 });\n   345\t    r.frames();\n   346\t    expect(xsOf(r)).toEqual([0, 1, 2, 3]);\n   347\t    expect(hoverPoint(r, ref(3))?.row).toEqual({ x: 3, y: 30 });\n   348\t    r.controller.actions.pause(false);\n   349\t    r.frames();\n   350\t    expect(xsOf(r)).toEqual([39]);\n   351\t    expect(hoverPoint(r, ref(3))).toBeNull();\n   352\t    expect(hoverPoint(r, ref(39))?.row).toEqual({ x: 39, y: 390 });\n   353\t  });\n   354\t});\n   355\t\n   356\tdescribe('claims not confirmed: a throwing value formatter and the first write', () => {\n   357\t  it('no value formatter call after the first host write of a frame, with a formatter that throws', () => {\n   358\t    let writes = 0;\n   359\t    const calls: number[] = [];\n   360\t    const format = () => { calls.push(writes); throw new Error('value'); };\n   361\t    const r = record('line', { title: 'F', data: rowsOf([0, 1, 2]), x: 'x', y: { field: 'y', format } });\n   362\t    const original = r.host.figure.update;\n   363\t    (r.host.figure as { update: typeof original }).update = model => { writes++; return original(model); };\n   364\t    const check = () => {\n   365\t      const before = writes;\n   366\t      calls.length = 0;\n   367\t      r.frames();\n   368\t      // Every call of this frame came before its first figure write.\n   369\t      expect(calls.every(w => w === before)).toBe(true);\n   370\t    };\n   371\t    check();\n   372\t    expect(codes(r)).toContain('AX160');\n   373\t    r.controller.handle.update({ title: 'G' });\n   374\t    check();\n   375\t    r.controller.handle.update({ data: rowsOf([3, 4, 5]) });\n   376\t    check();\n   377\t  });\n   378\t});\n","exit_code":0,"status":"completed"}}
