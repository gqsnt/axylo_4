rray(position, { minLength: 1, maxLength: 120 }), fc.nat(), fc.constantFrom(1, 1.25, 1.5, 2, 3),\n   498\t    fc.tuple(fc.integer({ min: -400, max: 400 }), fc.integer({ min: -400, max: 400 })),\n   499\t    (positions, seed, ratio, [dx, dy]) => {\n   500\t      const rows = Array.from(positions, (_, i) => i);\n   501\t      let random = seed;\n   502\t      for (let i = rows.length - 1; i > 0; i--) {\n   503\t        random = (Math.imul(1664525, random) + 1013904223) >>> 0;\n   504\t        const j = random % (i + 1);\n   505\t        [rows[i], rows[j]] = [rows[j]!, rows[i]!];\n   506\t      }\n   507\t      const { data, drawn } = cloud(positions, rows);\n   508\t      const witness = drawn[seed % drawn.length]!;\n   509\t      const px = clamp(witness.x + dx / 16, 0, 64);\n   510\t      const py = clamp(witness.y + dy / 16, 0, 64);\n   511\t      const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio, { exactBudget: 0 });\n   512\t      expectLattice(model.pick(px, py), latticeOracle(drawn, px, py, ratio));\n   513\t      expect(model.lastPickLattice).toBe(true);\n   514\t    },\n   515\t  ), { numRuns: 1_500 });\n   516\t});\n   517\t\n   518\tdescribe('a pick visits a number of index entries bounded by the radius and the pixel ratio', () => {\n   519\t  const axis = linearScale([0, 200], [0, 200]);\n   520\t  const layout = plot({ kind: 'xy', x: axis, y: axis }, 200, 200);\n   521\t  // The exact attempt may spend the lattice points of the 49 px pick square; the lattice pick visits at most\n   522\t  // the occupied lattice points near the pointer.\n   523\t  const bound = (ratio: number) => 2 * (Math.ceil(49 * ratio) + 1) ** 2;\n   524\t\n   525\t  it.each([[32_000, 1], [32_000, 2], [200_000, 1], [200_000, 2]])('%i points on a 20 px ring around the pointer at ratio %i', (size, ratio) => {\n   526\t    const positions = Array.from({ length: size }, (_, i) =>\n   527\t      [100 + 20 * Math.cos(2 * Math.PI * i / size), 100 + 20 * Math.sin(2 * Math.PI * i / size)] as const);\n   528\t    const { data, drawn } = cloud(positions);\n   529\t    const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio);\n   530\t    const target = model.pick(100, 100);\n   531\t    expect(model.lastPickLattice).toBe(true);\n   532\t    expect(model.lastPickCandidates).toBeLessThanOrEqual(bound(ratio));\n   533\t    expectLattice(target, latticeOracle(drawn, 100, 100, ratio));\n   534\t    // A second pick reuses the lattice index and does the same bounded work.\n   535\t    const visits = model.lastPickCandidates;\n   536\t    model.pick(100, 100);\n   537\t    expect(model.lastPickCandidates).toBe(visits);\n   538\t  });\n   539\t\n   540\t  it.each([1, 2, 3])('200,000 points in a dense 40 px cluster at ratio %i, exact and on the lattice', ratio => {\n   541\t    let random = 7;\n   542\t    const next = () => (random = (Math.imul(1664525, random) + 1013904223) >>> 0) / 2 ** 32;\n   543\t    const positions = Array.from({ length: 200_000 }, () => [80 + 40 * next(), 80 + 40 * next()] as const);\n   544\t    const { data, drawn } = cloud(positions);\n   545\t    for (const exactBudget of [undefined, 0]) {\n   546\t      const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio, { exactBudget });\n   547\t      const target = model.pick(100.3, 100.2);\n   548\t      expect(target).not.toBeNull();\n   549\t      expect(model.lastPickCandidates).toBeLessThanOrEqual(exactBudget === 0 ? bound(ratio) / 2 : bound(ratio));\n   550\t      if (model.lastPickLattice) expectLattice(target, latticeOracle(drawn, 100.3, 100.2, ratio));\n   551\t    }\n   552\t  });\n   553\t});\n   554\t\n   597\t        expect(model.pick(x, y)).toEqual(model.pick(...clamp2(x, y)));\n   598\t      }), { numRuns: 1_000 });\n   599\t  });\n   600\t});\n   601\t\n   602\tdescribe('a pointer move does no data-sized work (final review, finding 8; verification, finding 7)', () => {\n   603\t  // Typed-array bytes allocated while `action` runs: an index built for the data would show here.\n   604\t  function allocated(action: () => void): number {\n   605\t    let bytes = 0;\n   606\t    const restore: (() => void)[] = [];\n   607\t    for (const name of ['Float64Array', 'Float32Array', 'Int32Array', 'Uint32Array', 'Uint8Array'] as const) {\n   608\t      const original = globalThis[name];\n   609\t      const counted = new Proxy(original, {\n   610\t        construct(target, args, newTarget) {\n   611\t          const result = Reflect.construct(target, args, newTarget) as InstanceType<typeof original>;\n   612\t          if (!(args[0] instanceof ArrayBuffer)) bytes += result.byteLength;\n   613\t          return result;\n   614\t        },\n   615\t      });\n   616\t      Object.defineProperty(globalThis, name, { value: counted });\n   617\t      Object.defineProperty(original.prototype, 'constructor', { value: counted });\n   618\t      restore.push(() => {\n   619\t        Object.defineProperty(original.prototype, 'constructor', { value: original });\n   620\t        Object.defineProperty(globalThis, name, { value: original });\n   621\t      });\n   622\t    }\n   623\t    try {\n   624\t      action();\n   625\t    } finally {\n   626\t      restore.forEach(undo => undo());\n   627\t    }\n   628\t    return bytes;\n   629\t  }\n   630\t\n   631\t  it.each([1, 2])('the first pick at the centre of a 32,000-point ring at ratio %i', ratio => {\n   632\t    const size = 32_000;\n   633\t    const axis = linearScale([0, 200], [0, 200]);\n   634\t    const layout = plot({ kind: 'xy', x: axis, y: axis }, 200, 200);\n   635\t    const data = points([Array.from({ length: size }, (_, i) =>\n   636\t      [100 + 20 * Math.cos(2 * Math.PI * i / size), 100 + 20 * Math.sin(2 * Math.PI * i / size)] as const)]);\n   637\t    const model = scatterLookup(scatter(data), layout, formatter(data), undefined, ratio);\n   638\t    let target: ReturnType<typeof model.pick> = null;\n   639\t    // One position per point would be 256,000 bytes; the pick may allocate only what is near the pointer.\n   640\t    expect(allocated(() => { target = model.pick(100, 100); })).toBeLessThan(16 * 1_024);\n   641\t    expect(target).not.toBeNull();\n   642\t    expect(model.lastPickLattice).toBe(true);\n   643\t  });\n   644\t});\n","exit_code":0,"status":"completed"}}
