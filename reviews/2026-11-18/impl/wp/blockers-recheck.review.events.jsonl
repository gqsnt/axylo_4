ith no accepted row is a slot without a source row (contract: -1).\n   795\t            if (!caller) {\n   796\t              expect(row0).toBe(-1);\n   797\t              continue;\n   798\t            }\n   799\t            const absentOrNull = caller.y === null || caller.y === undefined || (position < opening.length && Number.isNaN(caller.y));\n   800\t            const row = series.row ? series.row[i]! : i;\n   801\t            // Contract: missing: 'zero' imputes null and absent values with row -1; otherwise the slot keeps its row.\n   802\t            if (missing === 'zero' && absentOrNull) {\n   803\t              expect(row).toBe(-1);\n   804\t              continue;\n   805\t            }\n   806\t            expect(row).toBe(position);\n   807\t            const got = frame.source.rowAt(row) as { x: number; y?: unknown };\n   808\t            expect(got.x).toBe(caller.x);\n   809\t            expect(got.y).toEqual(caller.y);\n   810\t          }\n   811\t        }\n   812\t      },\n   813\t    ), { numRuns: 500 });\n   814\t  });\n   815\t});\n   816\t\n   817\tit('drops the scatter x positions column once every retained row is a point again', () => {\n   818\t  const s = new PointStore(options('scatter', [{ x: 0, y: 1 }]), utc, version);\n   819\t  s.prepareAppend([{ x: 1, y: null }, { x: 2, y: 2 }]).commit();\n   820\t  expect(s.ownedBytes().buffers.map(entry => entry.name)).toContain('x positions');\n   821\t  s.prepareAppend([{ x: 3, y: 3 }], { keep: 2 }).commit();\n   822\t  const series = s.frame.shape === 'points' ? s.frame.series[0]! : null;\n   823\t  expect(series?.missingX).toBeUndefined();\n   824\t  expect([...series!.x]).toEqual([2, 3]);\n   825\t  expect(s.ownedBytes().buffers.map(entry => entry.name)).not.toContain('x positions');\n   826\t});\n   827\t\n   828\tit('counts the copy a frame makes of a column a competing tail fill has claimed', () => {\n   829\t  const data = Array.from({ length: 64 }, (_, x) => [{ x, y: x, s: 'a' }, { x, y: x, s: 'b' }]).flat();\n   830\t  const s = new AlignedStore('line', resolveOptions('line', { data, x: 'x', y: 'y', series: 's' }, quiet), utc, version);\n   831\t  s.prepareAppend([{ x: 64, y: 64, s: 'a' }]).commit();\n   832\t  const shown = s.frame;\n   833\t  // The fill writes b's open slot in place; the frame shown before it must read its own copy of that slot.\n   834\t  const fill = s.prepareAppend([{ x: 64, y: 4, s: 'b' }]);\n   835\t  const before = s.ownedBytes().total;\n   836\t  const y = shown.series[1]!.y;\n   837\t  expect(y[64]).toBeNaN();\n   838\t  expect(fill.frame.series[1]!.y[64]).toBe(4);\n   839\t  expect(y.buffer).not.toBe(fill.frame.series[1]!.y.buffer);\n   840\t  // Every buffer the store's frame holds is counted once: the copy just made is one more.\n   841\t  expect(s.ownedBytes().total - before).toBe(y.buffer.byteLength);\n   842\t  expect(s.ownedBytes().total).toBe(s.ownedBytes().total);\n   843\t});\n   844\t\n   845\tit('counts the buffers of other frames still held, each buffer once', () => {\n   846\t  const s = store('line', Array.from({ length: 16 }, (_, i) => row(i))) as AlignedStore;\n   847\t  const held = s.frame;\n   848\t  // Enough rows to outgrow the opening buffers: the held frame keeps the old ones.\n   849\t  s.prepareAppend(Array.from({ length: 64 }, (_, i) => row(16 + i))).commit();\n   850\t  if (held.shape !== 'aligned') throw new Error('Expected an aligned frame.');\n   851\t  const own = new Set([held.x.values.buffer, held.series[0]!.y.buffer, held.series[0]!.slot.buffer, held.series[0]!.row!.buffer]);\n   852\t  const extra = [...own].reduce((sum, buffer) => sum + buffer.byteLength, 0);\n   853\t  expect(held.x.values.buffer).not.toBe((s.frame as typeof held).x.values.buffer);\n   854\t  expect(s.ownedBytes([held]).total - s.ownedBytes().total).toBe(extra);\n   855\t  expect(s.ownedBytes([held, held, s.frame]).total).toBe(s.ownedBytes([held]).total);\n   856\t});\n","exit_code":0,"status":"completed"}}
