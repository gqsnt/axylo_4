bounds changed: a window that no longer ends at the latest x stops following.\n   698\t      const follow = followsLatest(viewed.view, c.zoom);\n   699\t      if (c.frame !== previous?.frame) held = null;\n   700\t      // The held arrivals are in place before anything is delivered: a handler that resumes from inside\n   701\t      // this call finds them, and no arrival stays held on a running chart (final review, finding 6).\n   702\t      if (heldAfter) held = heldAfter;\n   703\t      accept(c, viewed, follow, commit);\n   704\t    });\n   705\t  }\n   706\t\n   707\t  function openStore(a: Accepted): Store {\n   708\t    const store = composition.openStore(a.frame, a.source, a.options.data, environment, kind);\n   709\t    const table = a.source.table;\n   710\t    if (table) {\n   711\t      rowEnds.set(store.frame, table.length);\n   712\t      columnRows.set(store, table.columns ? table.length : 0);\n   713\t    }\n   714\t    return store;\n   715\t  }\n   716\t\n   717\t  function append(rows: unknown, appendOptions?: { keep?: number }): void {\n   718\t    guarded(call => {\n   719\t      const previous = accepted;\n   720\t      if (!previous) return;\n   721\t      // A row getter that throws is a failure of this call: under strict, a rejection (defect 6).\n   722\t      Object.assign(call, { strict: previous.options.strict === true, name: previous.name, handler: previous.options.onDiagnostic });\n   723\t      // The pause control appears (spec I6) once an append was accepted, not before it validated.\n   724\t      if (!Array.isArray(rows) || rows.length === 0) {\n   725\t        if (!streaming) { streaming = true; schedule(); }\n   726\t        return;\n   727\t      }\n   728\t      stage('append');\n   729\t      const keep = appendOptions?.keep;\n   730\t      const store = previous.store ?? openStore(previous);\n   731\t      const prepared = (store.prepareAppend as (r: readonly unknown[], o: { keep?: number }) => PreparedFrame<Frame>)(\n   732\t