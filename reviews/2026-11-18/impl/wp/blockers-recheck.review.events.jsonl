e: 'D', locale: 'de-DE', data: days, x: 'd', y: 'y' });\n   400\t    await page.locator('#chart button', { hasText: 'View as table' }).click();\n   401\t    const german = await page.evaluate(() => new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' }).format(new Date(Date.UTC(2026, 4, 31))));\n   402\t    const dates = await page.locator('#chart .axylo-table tbody th').allTextContents();\n   403\t    await page.locator('#chart .axylo-pager button', { hasText: 'Next page' }).click();\n   404\t    dates.push(...await page.locator('#chart .axylo-table tbody th').allTextContents());\n   405\t    expect(dates, `the chart writes ${german}`).toContain(german);\n   406\t    await page.locator('#chart .axylo-pager button', { hasText: 'Previous page' }).click();\n   407\t    await page.locator('#chart .axylo-jump-field').fill(german);\n   408\t    await page.keyboard.press('Enter');\n   409\t    expect(await page.locator('#chart .axylo-jump-field').getAttribute('aria-invalid'), german).toBeNull();\n   410\t    expect(await page.locator('#chart .axylo-page').textContent()).toMatch(/2/);\n   411\t    expect(await closePage(page)).toEqual([]);\n   412\t  });\n   413\t\n   414\t  it('on a German page with pointAll translated, single mode\\'s built-in pointOf is marked English as soon as it is read; a jump error carries its template\\'s language', async () => {\n   415\t    const page = await chartPage();\n   416\t    await page.evaluate(() => document.documentElement.setAttribute('lang', 'de'));\n   417\t    // 150 x positions, so the table has a pager and its jump field.\n   418\t    const data = Array.from({ length: 150 }, (_, x) => ['a', 'b'].map((s, i) => ({ x, s, y: x + i }))).flat();\n   419\t    await create(page, 'line', { title: 'T', messages: { pointAll: '{x}: {values}. {position}' }, data, x: 'x', y: 'y', series: 's' });\n   420\t    await page.locator(proxy).focus();\n   421\t    await page.keyboard.press('ArrowRight');\n   422\t    expect(await page.locator(proxy).getAttribute('lang')).toBeNull();\n   423\t    // No frame in between: the language goes with the reading.\n   424\t    const lang = await page.evaluate(() => {\n   425\t      const el = document.querySelector('#chart .axylo-proxy') as HTMLElement;\n   426\t      el.dispatchEvent(new KeyboardEvent('keydown', { key: 'ArrowDown', bubbles: true, cancelable: true }));\n   427\t      return el.getAttribute('lang');\n   428\t    });\n   429\t    expect(lang).toBe('en');\n   430\t    await page.locator('#chart button', { hasText: 'View as table' }).click();\n   431\t    await page.locator('#chart .axylo-jump-field').fill('nichts');\n   432\t    await page.keyboard.press('Enter');\n   433\t    expect(await page.locator('#chart .axylo-jump-error').getAttribute('lang')).toBe('en');\n   434\t    expect(await closePage(page)).toEqual([]);\n","exit_code":0,"status":"completed"}}
