{"type":"item.completed","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"git show HEAD:packages/axylo/src/dom/placement.ts | nl -ba | sed -n '1,210p'\"","aggregated_output":"     1\t/**\n     2\t * Where a floating tooltip goes (decision 0004 revision 3, rules 1, 2 and 6), as pure arithmetic over\n     3\t * rectangles in viewport pixels, so it runs and is tested in Node. The DOM side (tooltip.ts) measures the\n     4\t * tooltip and the obstacles and applies the result.\n     5\t *\n     6\t * - Candidates in order: above, below, right, left of the datum's box (horizontal bars: right, left, above,\n     7\t *   below); a donut tries its hole first.\n     8\t * - Along the free axis a candidate is centred on the box and shifted only as far as needed to be valid.\n     9\t * - Valid: wholly inside the visible part of the plot, and overlapping neither the box, nor any control, nor\n    10\t *   any focus ring. The hole is the one exception to the box: there the tooltip's four corners must lie\n    11\t *   inside the hole (the inner radius less the slice outline's clearance), and only the focus rings' strokes\n    12\t *   are kept clear, not their filled rectangles.\n    13\t * - Rule 6's last resort (`fallback`): each candidate pushed into the visible part, shifted along its free\n    14\t *   axis clear of every control and focus ring; the one that overlaps the box least. Controls and focus\n    15\t *   rings are never covered; when no such position exists the answer is null and nothing floats.\n    16\t */\n    17\timport type { Rect } from '../core/contracts';\n    18\t\n    19\t/** Gap between the datum's box and the tooltip. */\n    20\texport const OFFSET = 8;\n    21\tconst EPSILON = 1e-6;\n    22\t\n    23\texport interface Hole {\n    24\t  /** Centre and radii (an ellipse under a non-uniform scale) inside which the tooltip's corners must lie. */\n    25\t  readonly cx: number;\n    26\t  readonly cy: number;\n    27\t  readonly rx: number;\n    28\t  readonly ry: number;\n    29\t}\n    30\t\n    31\texport interface PlacementInput {\n    32\t  /** The datum's active marks enlarged by the focus ring's reach: never covered (except by rule 6). */\n    33\t  readonly box: Rect;\n    34\t  /** The visible part of the plot: the plot rectangle cut by the viewport and every clipping ancestor. */\n    35\t  readonly visible: Rect;\n    36\t  readonly order: 'vertical' | 'horizontal';\n    37\t  readonly hole: Hole | null;\n    38\t  readonly controls: readonly Rect[];\n    39\t  /** Outer rectangles of every focus ring on show (the keyboard's datum ring, wherever that datum is). */\n    40\t  readonly rings: readonly Rect[];\n    41\t  /** Width of a ring's stroke, surround included, for the hole's stroke test. */\n    42\t  readonly ringStroke: number;\n    43\t}\n    44\t\n    45\texport interface Spot {\n    46\t  readonly x: number;\n    47\t  readonly y: number;\n    48\t  readonly side: 'hole' | 'above' | 'below' | 'right' | 'left';\n    49\t}\n    50\t\n    51\ttype Side = Exclude<Spot['side'], 'hole'>;\n    52\t\n    53\t/** The area two rectangles share (touching edges share none). */\n    54\texport function overlapArea(a: Rect, b: Rect): number {\n    55\t  const w = Math.min(a.x + a.width, b.x + b.width) - Math.max(a.x, b.x);\n    56\t  const h = Math.min(a.y + a.height, b.y + b.height) - Math.max(a.y, b.y);\n    57\t  return w > EPSILON && h > EPSILON ? w * h : 0;\n    58\t}\n    59\t\n    60\tfunction insideRect(r: Rect, outer: Rect): boolean {\n    61\t  return r.x >= outer.x - EPSILON && r.y >= outer.y - EPSILON &&\n    62\t    r.x + r.width <= outer.x + outer.width + EPSILON && r.y + r.height <= outer.y + outer.height + EPSILON;\n    63\t}\n    64\t\n    65\t/** A ring's four strokes, `stroke` wide, inside its outer rectangle. */\n    66\tfunction strokes(ring: Rect, stroke: number): Rect[] {\n    67\t  const s = Math.min(stroke, ring.width / 2, ring.height / 2);\n    68\t  return [\n    69\t    { x: ring.x, y: ring.y, width: ring.width, height: s },\n    70\t    { x: ring.x, y: ring.y + ring.height - s, width: ring.width, height: s },\n    71\t    { x: ring.x, y: ring.y, width: s, height: ring.height },\n    72\t    { x: ring.x + ring.width - s, y: ring.y, width: s, height: ring.height },\n    73\t  ];\n    74\t}\n    75\t\n    76\t/**\n    77\t * The position along one axis nearest `preferred`, in [lo, hi], outside every open interval in `blocked`;\n    78\t * null when there is none.\n    79\t */\n    80\tfunction nearestFree(preferred: number, lo: number, hi: number, blocked: readonly (readonly [number, number])[]): number | null {\n    81\t  if (hi < lo - EPSILON) return null;\n    82\t  const clamp = (v: number) => Math.max(lo, Math.min(hi, v));\n    83\t  const free = (v: number) => v >= lo - EPSILON && v <= hi + EPSILON && blocked.every(([a, b]) => v <= a + EPSILON || v >= b - EPSILON);\n    84\t  const options = [clamp(preferred)];\n    85\t  for (const [a, b] of blocked) options.push(a, b);\n    86\t  let best: number | null = null;\n    87\t  for (const v of options) {\n    88\t    if (!free(v)) continue;\n    89\t    if (best === null || Math.abs(v - preferred) < Math.abs(best - preferred) - EPSILON) best = v;\n    90\t  }\n    91\t  return best === null ? null : clamp(best);\n    92\t}\n    93\t\n    94\t/**\n    95\t * The tooltip on one side of the box, with its fixed coordinate `fixed`, shifted along the free axis clear\n    96\t * of `obstacles` and inside `visible`; null when no shift is clear.\n    97\t */\n    98\tfunction along(side: Side, fixed: number, preferred: number, width: number, height: number, visible: Rect, obstacles: readonly Rect[]): Spot | null {\n    99\t  const vertical = side === 'above' || side === 'below';\n   100\t  // Obstacles that meet the band the tooltip occupies across the free axis block an interval of it.\n   101\t  const blocked: [number, number][] = [];\n   102\t  for (const o of obstacles