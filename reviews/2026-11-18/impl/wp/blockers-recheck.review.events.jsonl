{"type":"item.completed","item":{"id":"item_75","type":"command_execution","command":"/bin/bash -lc \"git show HEAD:packages/axylo/src/core/focus.ts | nl -ba | sed -n '100,227p;467,565p'\"","aggregated_output":"   100\t\n   101\t/** The refs of every readable series at x, in series order. */\n   102\texport function refsAt(view: AlignedView, x: number): DatumRef[] {\n   103\t  return readableSeries(view).map(s => ({ kind: 'aligned', seriesKey: view.frame.series[s]!.key, x }) as const);\n   104\t}\n   105\t\n   106\t/** The place of a datum among the visible ones, as the `position` message says it (\"Point 4 of 10\"). */\n   107\texport function positionText(messages: Messages, formatters: Formatters, ordinal: number, count: number): string {\n   108\t  return fill(messages.position, { index: formatters.count(ordinal + 1), count: formatters.count(count) });\n   109\t}\n   110\t\n   111\t/**\n   112\t * Value text of the proxy (decision 0001): what the reader is on, ending with its place. \"All\" mode reads\n   113\t * every series at the x with `pointAll` and `seriesValue`; one series (single mode, scatter) uses `pointOf`.\n   114\t */\n   115\texport function valueText(\n   116\t  view: View, lookup: Lookup, focus: DatumRef, mode: Mode, formatters: Formatters, messages: Messages,\n   117\t): string | null {\n   118\t  const ordinal = lookup.ordinal(focus);\n   119\t  if (ordinal < 0) return null;\n   120\t  const position = positionText(messages, formatters, ordinal, lookup.count);\n   121\t  if (view.kind === 'donut') {\n   122\t    const datum = lookup.datum(focus);\n   123\t    if (!datum) return null;\n   124\t    const share = datum.percent === null || datum.percent === datum.value ? '' : ` (${datum.percent})`;\n   125\t    return fill(messages.pointAll, {\n   126\t      x: datum.seriesLabel, values: datum.value + share, position,\n   127\t    });\n   128\t  }\n   129\t  if (view.kind !== 'scatter' && mode === 'all' && focus.kind === 'aligned') {\n   130\t    // What the tooltip shows at this x, the stack total included, said once (spec I1, F10).\n   131\t    // Every series at x, the ones past the tooltip's eight included, as the tooltip writes its rows: an\n   132\t    // incomplete stack is said once, on the total, not again on each series (review C2-7).\n   133\t    const model = lookup.tooltip({ kind: 'x', x: focus.x });\n   134\t    const rows = alignedRows(view, formatters, focus.x, model).map(r => fill(messages.seriesValue, { series: r.seriesLabel, value: r.value }));\n   135\t    if (model.total !== null) rows.push(fill(messages.seriesValue, { series: messages.total, value: model.total }));\n   136\t    if (!rows.length) return null;\n   137\t    return fill(messages.pointAll, { x: formatters.x(focus.x), values: rows.join('; '), position });\n   138\t  }\n   139\t  return pointOf(lookup, focus, formatters, messages);\n   140\t}\n   141\t\n   142\t/**\n   143\t * Every readable series' row at x, in series order: the tooltip's own rows first (they are the first of\n   144\t * them), then the rest written the same way, unqualified, as the tooltip writes a row. Used where every\n   145\t * series is read (the keyboard's \"all\" reading, a pinned tooltip's further rows).\n   146\t */\n   147\texport function alignedRows(view: AlignedView, formatters: Formatters, x: number, model: TooltipModel): DatumText[] {\n   148\t  const rows: DatumText[] = [...model.rows];\n   149\t  const shown = new Set(model.rows.map(r => r.seriesIndex));\n   150\t  const positions = view.frame.x.values;\n   151\t  const i = lowerBound(positions, x);\n   152\t  if (i >= positions.length || positions[i] !== x) return rows;\n   153\t  const title = formatters.x(x);\n   154\t  for (const s of readableSeries(view)) {\n   155\t    if (shown.has(s)) continue;\n   156\t    const series = view.frame.series[s]!;\n   157\t    const state = series.slot[i] as SlotState;\n   158\t    rows.push({\n   159\t      ref: { kind: 'aligned', seriesKey: series.key, x }, seriesIndex: s, seriesLabel: series.label, x: title,\n   160\t      value: slotText(formatters, s, series.y[i]!, state), state, percent: null, row: series.row?.[i] ?? i,\n   161\t    });\n   162\t  }\n   163\t  return rows;\n   164\t}\n   165\t\n   166\t/**\n   167\t * Every point shown with a scatter target: its refs, then the rest of its coincident group (the pick lists\n   168\t * at most eight; `count` is the group). Members are found by the lookup's own predicate: the points that the\n   169\t * pick at the first point's place returns, i.e. those nearest that place, `count` of them. Candidates are the\n   170\t * points whose anchors lie within a few pixels of it, walked in the lookup's x-then-y order until their x is\n   171\t * farther than that, so points of other heights interleaved in that order are passed over, not stopped at\n   172\t * (review finding 8).\n   173\t */\n   174\texport function groupRefs(lookup: Lookup, target: Extract<PickTarget, { kind: 'point' }>): DatumRef[] {\n   175\t  const refs = [...target.refs];\n   176\t  const first = refs[0];\n   177\t  const box = first ? lookup.anchor(first) : null;\n   178\t  if (!first || !box || target.count <= refs.length) return refs;\n   179\t  const cx = box.x + box.width / 2, cy = box.y + box.height / 2;\n   180\t  const REACH = 2;\n   181\t  const candidates: { ref: DatumRef; d: number }[] = [];\n   182\t  for (const direction of ['next', 'previous'] as const) {\n   183\t    let at: DatumRef | null = first;\n   184\t    for (let k = 0; at && k < lookup.count; k++) {\n   185\t      at = lookup.step(at, direction);\n   186\t      const b = at ? lookup.anchor(at) : null;\n   187\t      if (!at || !b) break;\n   188\t      const x = b.x + b.width / 2, y = b.y + b.height / 2;\n   189\t      if (Math.abs(x - cx) > REACH) break;\n   190\t      const d = Math.hypot(x - cx, y - cy);\n   191\t      if (d <= REACH && !refs.some(r => sameRef(r, at))) candidates.push({ ref: at, d });\n   192\t    }\n   193\t  }\n   194\t  candidates.sort((p, q) => p.d - q.d);\n   195\t  for (const c of candidates) {\n   196\t    if (refs.length >= target.count) break;\n   197\t    refs.push(c.ref);\n   198\t  }\n   199\t  return refs;\n   200\t}\n   201\t\n   202\t/**\n   203\t * What a reading says about the datum itself, for deciding whether the focused text must be rewritten\n   204\t * (decision 0004 part 2): its identity, its values and the templates that word them, never its place in\n   205\t * the range. Compared as data, not by taking one translated sentence out of another (review finding 14).\n   206\t */\n   207\texport function datumReading(view: View, lookup: Lookup, ref: DatumRef, mode: Mode, formatters: Formatters, messages: Messages): string | null {\n   208\t  if (lookup.ordinal(ref) < 0) return null;\n   209\t  const words = [messages.pointAll, messages.pointOf, messages.seriesValue, messages.total];\n   210\t  if (view.kind !== 'scatter' && view.kind !== 'donut' && mode === 'all' && ref.kind === 'aligned') {\n   211\t    const model = lookup.tooltip({ kind: 'x', x: ref.x });\n   212\t    const rows = alignedRows(view, formatters, ref.x, model).map(r => [r.seriesIndex, r.seriesLabel, r.value]);\n   213\t    return JSON.stringify(['all', ref.seriesKey, formatters.x(ref.x), rows, model.total, words]);\n   214\t  }\n   215\t  const datum = lookup.datum(ref);\n   216\t  if (!datum) return null;\n   217\t  // The datum's identity without its place: an aligned datum by series and x as read (a category's name,\n   218\t  // not its index, which a sliding window renumbers; review finding 10), a point by series and source row.\n   219\t  const id = ref.kind === 'point' ? [ref.seriesKey, ref.row] : ref.kind === 'aligned' ? [ref.seriesKey] : [ref.sliceKey];\n   220\t  return JSON.stringify(['one', ref.kind, id, datum.seriesLabel, datum.x, datum.value, datum.percent, words]);\n   221\t}\n   222\t\n   223\t// ── overlay ─────────────────────────────────────────────────────────────────────────────────────────\n   224\t\n   225\texport interface OverlayInput {\n   226\t  readonly view: View;\n   227\t  readonly layout: Layout;\n   467\t * pinching them never narrows (the same guard as zoomStep; review C3-7). A window already below the\n   468\t * smallest width (a public zoom can set one) stays as it is while the fingers spread.\n   469\t */\n   470\texport function pinchWidth(start: number, factor: number, minWidth: number): number {\n   471\t  const width = Math.max(minWidth, start * factor);\n   472\t  if (factor < 1) return width < start ? width : start;\n   473\t  if (factor > 1) return width > start ? width : start;\n   474\t  return start;\n   475\t}\n   476\t\n   477\t/** The window moved by `share` of its width (negative: towards the start); null when it would not move. */\n   478\texport function panWindow(full: Span, current: Span, share: number): Span | null {\n   479\t  const width = current[1] - current[0];\n   480\t  const moved = inside(full, current[0] + share * width, width);\n   481\t  return moved[0] === current[0] ? null : moved;\n   482\t}\n   483\t\n   484\t/**\n   485\t * Smallest window: about two x slots for aligned charts, a ten-thousandth of the range otherwise, but never\n   486\t * more than half the range, so one halving is always attainable (interaction review, part 1 item 9).\n   487\t */\n   488\texport function minimumWidth(view: View): number {\n   489\t  if (view.kind === 'donut') return 0;\n   490\t  const full = view.xFull[1] - view.xFull[0];\n   491\t  // Never below what doubles can tell apart at these positions: one unit in the last place keeps two ends.\n   492\t  const largest = Math.max(Math.abs(view.xFull[0]), Math.abs(view.xFull[1]), Number.MIN_VALUE);\n   493\t  const representable = 2 ** (Math.floor(Math.log2(largest)) - 52);\n   494\t  const wanted = view.kind === 'scatter' ? full / 1e4\n   495\t    : view.frame.x.values.length > 1 ? 2 * full / (view.frame.x.values.length - 1) : full;\n   496\t  return Math.max(Math.min(wanted, full / 2), representable);\n   497\t}\n   498\t\n   499\t/** Whether zoom applies to this chart (spec 3.6): not donut, not a category axis, not compact, not switched off. */\n   500\texport function zoomApplies(view: View, option: unknown): boolean {\n   501\t  if (option === false || view.kind === 'donut' || view.compact) return false;\n   502\t  if (view.kind === 'scatter') return true;\n   503\t  return view.frame.x.kind !== 'category';\n   504\t}\n   505\t\n   506\t/**\n   507\t * Narrowed mode on scatter (review 2, finding 7): the next or previous point of the same series in x order\n   508\t * among its visible points; null at an end.\n   509\t */\n   510\texport function stepInSeries(view: ScatterView, ref: DatumRef, direction: StepDirection): DatumRef | null {\n   511\t  if (ref.kind !== 'point') return null;\n   512\t  const s = view.frame.series.findIndex(series => series.key === ref.seriesKey);\n   513\t  const series = view.frame.series[s];\n   514\t  const range = view.visiblePoints[s];\n   515\t  if (!series || !range || range.end <= range.start) return null;\n   516\t  const rows = series.row;\n   517\t  let at = -1;\n   518\t  for (let i = range.start; i < range.end; i++) if ((rows ? rows[i]! : i) === ref.row) { at = i; break; }\n   519\t  if (at < 0) return null;\n   520\t  const page = pageDistance(range.end - range.start);\n   521\t  const to = direction === 'next' ? at + 1 : direction === 'previous' ? at - 1 : direction === 'first' ? range.start\n   522\t    : direction === 'last' ? range.end - 1 : direction === 'page-next' ? Math.min(range.end - 1, at + page)\n   523\t      : direction === 'page-previous' ? Math.max(range.start, at - page) : -1;\n   524\t  if (to < range.start || to >= range.end || to === at) return null;\n   525\t  return { kind: 'point', seriesKey: series.key, row: rows ? rows[to]! : to, x: series.x[to]! };\n   526\t}\n   527\t\n   528\t/**\n   529\t * The window between two x positions picked on the plot (a drag's two ends, or the two clicks of \"Select\n   530\t * range\", spec I4): ordered, clamped to `full`; null for the whole range; undefined when it is narrower than\n   531\t * the smallest window (nothing happens then, as for the buttons and keys; review 2, finding 9).\n   532\t */\n   533\texport function rangeWindow(full: Span, a: number, b: number, minWidth: number): Span | null | undefined {\n   534\t  const lo = Math.max(full[0], Math.min(a, b));\n   535\t  const hi = Math.min(full[1], Math.max(a, b));\n   536\t  if (!(hi > lo) || hi - lo < minWidth) return undefined;\n   537\t  return hi - lo >= full[1] - full[0] ? null : [lo, hi];\n   538\t}\n   539\t\n   540\t/** The plot pixel along the position axis of an x position (the inverse of positionAt); null on a band axis. */\n   541\texport function pixelOf(layout: Layout, position: number): number | null {\n   542\t  if (layout.kind !== 'plot') return null;\n   543\t  const p = layout.projection;\n   544\t  const scale = p.kind === 'xy' ? p.x : p.kind === 'bands' ? p.band : null;\n   545\t  return scale && scale.type !== 'band' ? scale.map(position) : null;\n   546\t}\n   547\t\n   548\t/** The x position under a plot pixel, from the layout's projection; null on a band (category) axis. */\n   549\texport function positionAt(layout: Layout, px: number, py: number): number | null {\n   550\t  if (layout.kind !== 'plot') return null;\n   551\t  const p = layout.projection;\n   552\t  if (p.kind === 'xy') return p.x.type === 'band' ? null : p.x.invert(px);\n   553\t  if (p.kind === 'bands') return p.band.type === 'band' ? null : p.band.invert(p.horizontal ? py : px);\n   554\t  return null;\n   555\t}\n   556\t\n   557\texport type { PlotLayout };\n","exit_code":0,"status":"completed"}}
