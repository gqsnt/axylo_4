{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"sed -n '50,165p;230,312p' packages/axylo/src/core/contracts.ts && sed -n '98,175p;195,263p' packages/axylo/src/core/axes.ts && sed -n '110,162p;300,350p' packages/axylo/src/data/normalize.ts && sed -n '1,110p' packages/axylo/test/browser/acceptance/compact.browser.test.ts\"","aggregated_output":" *  wall     – a date-time written without an offset. Position = the written fields read as if UTC;\n *             always formatted in UTC (\"shown as written\").\n *  category – a name. Position = index in first-seen order (bar, line) or given order (donut).\n */\nexport type XKind = 'number' | 'time' | 'date' | 'wall' | 'category';\n\n/** State of one slot of an aligned series. */\nexport const SLOT_VALUE = 0;         // a finite number\nexport const SLOT_NULL = 1;          // explicit null (or NaN in a typed column, or an empty string): \"no data\", silent\nexport const SLOT_INVALID = 2;       // present but not plottable (NaN or infinity in a row, a stray string): reported\nexport const SLOT_NO_ROW = 3;        // this series has no observation at this x and none was expected; neighbours may be joined across it\nexport const SLOT_GAP = 4;           // an expected step of this series is absent (AX105): never joined across\nexport const SLOT_ABSENT_FIELD = 5;  // the row exists but the field's key is absent or undefined (AX102)\nexport type SlotState = 0 | 1 | 2 | 3 | 4 | 5;\n/**\n * `missing: 'zero'` on a value field is applied by normalization: slots that would be SLOT_NULL, SLOT_NO_ROW,\n * SLOT_GAP or SLOT_ABSENT_FIELD become SLOT_VALUE with y = 0 and row = -1. SLOT_INVALID is never turned into zero.\n */\n\n/** Half-open range of indexes. */\nexport interface IndexRange { readonly start: number; readonly end: number }\n\nexport interface XColumn {\n  readonly kind: XKind;\n  /** Strictly ascending positions, one per slot. For 'category': 0, 1, 2, … */\n  readonly values: Float64Array;\n  /** For 'category': the name of each position. Otherwise null. */\n  readonly categories: readonly string[] | null;\n  /** For 'time': the resolved IANA zone ('UTC', 'America/Los_Angeles', …; 'local' is resolved before it gets here). Otherwise null. */\n  readonly timeZone: string | null;\n  /** For 'date': the precision the values were written in ('2026-02' is a month); the finest one if they are mixed. Otherwise null. */\n  readonly dateUnit: 'day' | 'month' | 'year' | null;\n  /** For 'category': true when the author declared the categories ordered, so the axis may be thinned (spec L1). */\n  readonly ordered: boolean;\n}\n\n/** The caller's data behind a frame, for events and for the table's provenance. */\nexport interface RowSource {\n  /** The caller's row at a source index (materialized on demand for typed columns), or null if it is no longer retained. */\n  rowAt(sourceIndex: number): unknown;\n}\n\n/** One series of an aligned frame: a y value and a state for every x slot. */\nexport interface Series {\n  /** Stable identity: the series value (long form) or the field name (wide form). Used for colors and toggling. */\n  readonly key: string;\n  /** Name shown to the reader. */\n  readonly label: string;\n  /** The value field this series was read from, for diagnostics. */\n  readonly field: string;\n  readonly unit: string | null;\n  readonly valueScale: 'percent' | 'ratio' | null;\n  /** False when the series cannot be drawn (duplicate x, AX108). It stays in the frame so the table and summary can say so. */\n  readonly drawable: boolean;\n  /** y per slot. NaN wherever `slot` is not SLOT_VALUE. May be a view on the caller's typed column. */\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n  /** Index of the caller's row each slot came from, -1 where there is none. null means \"slot i came from row i\" (typed columns). */\n  readonly row: Int32Array | null;\n}\n\n/** One series of a point frame (scatter): its own x and y, sorted by x then y. */\nexport interface PointSeries {\n  readonly key: string;\n  readonly label: string;\n  readonly drawable: boolean;\n  readonly x: Float64Array;\n  readonly y: Float64Array;\n  readonly row: Int32Array | null;\n  /**\n   * Observations that have a valid x and no plottable y: null, an absent field, or a value that cannot be\n   * plotted (the rows AX103 and AX106 report). Sorted by x, duplicates kept. They are not points: nothing is\n   * drawn or picked for them. They exist so the table can list them as \"No data\" (spec F2 and F12: the note\n   * sends the reader to the table, so the table must show every row that was left out). Absent or empty when\n   * there are none. With `missing: 'zero'` on the y field, null and absent values are points with y = 0 instead\n   * and do not appear here; a value that cannot be plotted is never imputed.\n   */\n  readonly missingX?: Float64Array;\n}\n\n/**\n * The normalized, lossless data. Immutable: an update or append produces a new frame with a higher revision.\n * Buffers may be shared between revisions; a streaming store appends into spare capacity and hands out\n * subarray views, so an append does not copy what is already there.\n */\ninterface FrameBase {\n  readonly revision: number;\n  /** Changes when the data is replaced or the encoding changes; survives append and eviction. A DatumRef is only meaningful within one epoch. */\n  readonly epoch: number;\n  readonly source: RowSource;\n}\n\nexport interface AlignedFrame extends FrameBase {\n  readonly shape: 'aligned';\n  readonly x: XColumn;\n  readonly series: readonly Series[];\n  /** Number of x slots. */\n  readonly length: number;\n  readonly xLabel: string;\n  readonly yLabel: string | null;\n}\n\nexport interface PointFrame extends FrameBase {\n  readonly shape: 'points';\n  readonly xKind: Exclude<XKind, 'category'>;\n  readonly timeZone: string | null;\n  readonly series: readonly PointSeries[];\n  readonly xLabel: string;\n  readonly yLabel: string;\n  readonly xUnit: string | null;\n  readonly yUnit: string | null;\n}\n\n/** Donut data: every category the caller gave, in the given order, before any grouping into \"Other\". */\nexport interface DonutFrame extends FrameBase {\n  readonly shape: 'donut';\n  readonly label: string;\n}\n\n/**\n * Candidate tick sets for one axis, from densest to sparsest. Layout picks the densest set that fits.\n * Every set is a subset of \"nice\" positions for that axis; for a band scale the sets are every k-th category.\n */\nexport type TickCandidates = readonly (readonly Tick[])[];\n\n// ───────────────────────────── view ─────────────────────────────\n\n/** A reference line (one position) or band (two) after its values were turned into axis positions. */\nexport interface ResolvedReference {\n  readonly axis: 'x' | 'y';\n  readonly from: number;\n  /** Equal to `from` for a line. */\n  readonly to: number;\n  readonly label: string;\n}\n\n/** How one series is told apart without color (spec A5): a marker shape and dash patterns. */\nexport interface SeriesCue {\n  readonly marker: MarkerShape;\n  readonly dash: DashStyle;\n}\n\n/**\n * Stacking (spec F10). Positive and negative values accumulate on their own sides of zero.\n * `positive[k]` is the upper boundary of the k-th stacked series' positive part, `positive[k - 1]` (or zero\n * for k = 0) its lower boundary; likewise `negative`. A component that is not SLOT_VALUE contributes zero\n * height and sets `incomplete` for that slot.\n */\nexport interface StackView {\n  /** Frame series indexes in accumulation order (hidden series are left out). */\n  readonly order: readonly number[];\n  readonly positive: readonly Float64Array[];\n  readonly negative: readonly Float64Array[];\n  /** 1 where at least one visible component is missing; null when every stack is complete. */\n  readonly incomplete: Uint8Array | null;\n}\n\ninterface CartesianViewBase {\n  readonly revision: number;\n  /** Visibility per series (legend toggles). */\n  readonly visible: readonly boolean[];\n  readonly cues: readonly SeriesCue[];\n  /** Full x domain of the data (plus the author's domain), and the zoomed domain actually shown. */\n  readonly xFull: readonly [number, number];\n  readonly xDomain: readonly [number, number];\n  /** Value domain after the rules of spec F1 and F7. */\n  readonly yDomain: readonly [number, number];\n  readonly references: readonly ResolvedReference[];\n  readonly compact: boolean;\n}\n\n/** What is currently shown of an aligned frame. */\nexport interface AlignedView extends CartesianViewBase {\n  readonly kind: 'line' | 'area' | 'bar';\n  readonly frame: AlignedFrame;\n  /** True only for horizontal bars. */\n  readonly horizontal: boolean;\n  /** Slots whose x lies inside xDomain. Pointer and keyboard only ever land on these. */\n  readonly visibleSlots: IndexRange;\n  /**\n   * Per series, the slot range to draw: visibleSlots widened on each side to that series' nearest value it\n   * may be joined to, so a line reaches the plot edge. Never used for picking.\n   */\n  readonly drawSlots: readonly IndexRange[];\n  readonly stack: StackView | null;\n}\n\nexport interface ScatterView extends CartesianViewBase {\n  readonly kind: 'scatter';\n  readonly frame: PointFrame;\n  /** Per series, the range of its points whose x lies inside xDomain. */\n  readonly visiblePoints: readonly IndexRange[];\n}\n\n/** One drawn slice or legend entry of a donut (spec F8). */\nexport interface DonutSlice {\n  readonly key: string;\n  readonly label: string;\n  /** Indexes into the donut frame: one for an ordinary slice, several for \"Other (n)\". */\n    // among the tick sets for which that holds, and a plot too short for all of them takes a wider domain on\n    // a coarser step, chosen with its ticks. An author's domain is drawn as given.\n    candidates: extent ? endingCandidates(all, view.yDomain, extent, valueScale) : all,\n    coarser: extent ? coarserDomains(extent[0], extent[1], view.yDomain, full !== null && view.yDomain[1] === full).map(domain => ({\n      domain, candidates: endingCandidates(numberTicks(domain, ctx.locale, yOption, valueScale, onYError), domain, extent, valueScale),\n    })) : undefined,\n    title: titles.y, mayThin: true,\n  };\n  const common = { width, height, compact: ctx.compact, measurer: text.measurer, style: text.style, scales };\n\n  if (view.kind === 'scatter') {\n    const x = continuousX(view.frame.xKind, view.xDomain, view.frame.timeZone, null, ctx);\n    return { ...common, kind: 'xy', x: { ...x, title: titles.x }, y, references: view.references };\n  }\n\n  const column = view.frame.x;\n  const xTitle = titles.x;\n  const references = view.references;\n  const onXError = (e: unknown) => ctx.onFormatterError(ctx.resolved.x.field, e);\n  if (column.kind === 'category') {\n    const labels = categoryLabels(column.categories ?? [], ctx.resolved.x.tickFormat, onXError);\n    const x = {\n      type: 'band' as const, count: labels.length, padding: view.kind === 'bar' ? 0.2 : 0,\n      candidates: bandTickCandidates(labels), mayThin: column.ordered, title: xTitle,\n    };\n    return view.kind === 'bar'\n      ? { ...common, kind: 'bands', horizontal: view.horizontal, x, y, references }\n      : { ...common, kind: 'xy', x, y, references };\n  }\n  // Bars on a continuous x: the view's domain already has room for the outer bars (view/bar-bands.ts), and\n  // ticks, marks and lookup all use that one domain.\n  const x = { ...continuousX(column.kind, view.xDomain, column.timeZone, column.dateUnit, ctx), title: xTitle };\n  return view.kind === 'bar'\n    ? { ...common, kind: 'bands', horizontal: view.horizontal, x, y, references }\n    : { ...common, kind: 'xy', x, y, references };\n}\n\n/**\n * What an automatic value domain was rounded from: the visible values (stack totals for a stack), the\n * reference lines and bands, and zero on bar and area (spec F1, F7).\n */\nexport function valueExtent(view: Exclude<View, { kind: 'donut' }>): Span | null {\n  const known = extents.get(view);\n  if (known !== undefined) return known;\n  const extent = scanExtent(view);\n  extents.set(view, extent);\n  return extent;\n}\n\n/** Views are immutable: the extent is read once per view (layout input and layout key). */\nconst extents = new WeakMap<View, Span | null>();\n\nfunction scanExtent(view: Exclude<View, { kind: 'donut' }>): Span | null {\n  let lo = Infinity;\n  let hi = -Infinity;\n  const take = (v: number) => { if (Number.isFinite(v)) { if (v < lo) lo = v; if (v > hi) hi = v; } };\n  if (view.kind === 'scatter') {\n    view.frame.series.forEach((s, i) => {\n      if (!view.visible[i]) return;\n      const { start, end } = view.visiblePoints[i]!;\n      for (let j = start; j < end; j++) take(s.y[j]!);\n    });\n  } else if (view.stack) {\n    const top = view.stack.positive.at(-1);\n    const bottom = view.stack.negative.at(-1);\n    const { start, end } = view.kind === 'bar' ? view.drawSlots[0] ?? view.visibleSlots : view.visibleSlots;\n    for (let j = start; j < end; j++) { if (top) take(top[j]!); if (bottom) take(bottom[j]!); }\n  } else {\n    view.frame.series.forEach((s, i) => {\n      if (!view.visible[i]) return;\n      const { start, end } = view.kind === 'bar' ? view.drawSlots[i] ?? view.visibleSlots : view.visibleSlots;\n      for (let j = start; j < end; j++) if (s.slot[j] === 0) take(s.y[j]!);\n    });\n  }\n  for (const r of view.references) if (r.axis === 'y') { take(r.from); take(r.to); }\n  if (view.kind === 'bar' || view.kind === 'area') take(0);\n  return lo <= hi ? [lo, hi] : null;\n}\n    // reaching the maximum is the last one, and the last tick reaching the minimum is the first one.\n    const reachesHi = (t: number) => t >= hi || near(t, hi);\n    const reachesLo = (t: number) => t <= lo || near(t, lo);\n    const upper = (full !== null && near(b, full)) || set.findIndex(t => reachesHi(t.value)) === set.length - 1;\n    let lowest = -1;\n    for (let i = set.length - 1; i >= 0; i--) if (reachesLo(set[i]!.value)) { lowest = i; break; }\n    return upper && lowest === 0;\n  });\n  return fits.length ? fits : sets;\n}\n\n/** The axis titles layout draws (spec L6), with their units; undefined where an axis is untitled. */\nfunction axisTitles(view: Exclude<View, { kind: 'donut' }>, ctx: AxisContext): { x: string | undefined; y: string | undefined } {\n  if (ctx.compact) return { x: undefined, y: undefined };\n  if (view.kind === 'scatter') {\n    return {\n      x: xTitled(view.frame.xKind, ctx) ? withUnit(view.frame.xLabel, view.frame.xUnit) : undefined,\n      y: withUnit(view.frame.yLabel, view.frame.yUnit),\n    };\n  }\n  return {\n    x: xTitled(view.frame.x.kind, ctx) ? withUnit(view.frame.xLabel, ctx.resolved.x.unit) : undefined,\n    y: withUnit(view.frame.yLabel ?? alignedValueTitle(view.frame.series, ctx.valueTitle), sharedUnit(view.frame.series)),\n  };\n}\n\n/** Spec L6: a number x is a measure and is titled; time, date and category ticks already say what they are. */\nfunction xTitled(kind: XKind, ctx: AxisContext): boolean {\n  return kind === 'number' || ctx.xLabelGiven;\n}\n\n/** A value axis is always titled (spec L6): its label, else its one field, else the generic noun. */\nfunction alignedValueTitle(series: readonly { readonly field: string }[], generic: string): string {\n  const first = series[0]?.field;\n  return first !== undefined && series.every(s => s.field === first) ? first : generic;\n}\n\nfunction sharedUnit(series: readonly { readonly unit: string | null }[]): string | null {\n  const first = series[0]?.unit ?? null;\n  return series.every(s => s.unit === first) ? first : null;\n}\n\n/**\n * Everything layout reads, as comparable parts. Equal keys mean the previous layout is still right: same\n * size, text style, fonts, locale, domains, categories, titles and formatters.\n */\nexport function layoutKey(\n  view: View, size: { width: number; height: number }, style: TextStyle, fontEpoch: number, ctx: AxisContext,\n): readonly unknown[] {\n  const base: unknown[] = [size.width, size.height, style.font, style.letterSpacing, style.wordSpacing, style.lineHeight,\n    fontEpoch, ctx.locale, ctx.compact, view.kind];\n  if (view.kind === 'donut') return base;\n  const value = ctx.resolved.values[0];\n  base.push(view.xDomain[0], view.xDomain[1], view.yDomain[0], view.yDomain[1], ctx.resolved.x.tickFormat,\n    ctx.resolved.x.label, ctx.resolved.x.unit, value?.tickFormat, value?.label, value?.unit, value?.scale,\n    ctx.xLabelGiven, ctx.valueTitle, view.references);\n  // The extremes choose among the tick sets and wider domains of an automatic domain (F7).\n  const extent = value?.domain ? null : valueExtent(view);\n  base.push(extent?.[0], extent?.[1]);\n  base.push(...view.visible);\n  // The titles as drawn: a unit can change on one series only and change the shared unit (review 2, finding 20).\n  const titles = axisTitles(view, ctx);\n  base.push(titles.x, titles.y);\n  if (view.kind === 'scatter') {\n    base.push(view.frame.xKind, view.frame.timeZone, view.frame.xLabel, view.frame.yLabel);\n    return base;\n  }\n  const column = view.frame.x;\n  // No slot indexes: layout reads domains, categories and labels only, never which slots are visible.\n  readonly order: Int32Array | null;\n}\n\nfunction groups(options: ResolvedOptions, x: XData, sink: DiagnosticSink): Group[] {\n  const { table, series } = options;\n  if (series === null) {\n    return options.values.map(value => ({\n      key: value.field, label: value.label, value, order: x.order,\n    }));\n  }\n\n  const indexes = new Map<string, number>();\n  const counts: number[] = [];\n  const membership = new Int32Array(table.length).fill(-1);\n  const reports = new Reports(series, sink);\n  for (let i = 0; i < table.length; i++) {\n    const raw = table.read(i, series);\n    const name = nameOf(raw);\n    if (name === null) {\n      if (Number.isNaN(raw) && table.isColumnRow(i)) continue;\n      if (raw === undefined) reports.add('AX102', 'omitted', table.rowIndex(i), undefined, undefined, { outcome: 'The affected row is not drawn.' });\n      else reports.add('AX107', 'omitted', table.rowIndex(i), raw, 'Supply a name for the series in each row.');\n      continue;\n    }\n    if (!Number.isFinite(x.positions[i])) continue;\n    let index = indexes.get(name);\n    if (index === undefined) {\n      index = indexes.size;\n      indexes.set(name, index);\n      counts.push(0);\n    }\n    membership[i] = index;\n    counts[index] = counts[index]! + 1;\n  }\n  reports.flush(sink);\n\n  const orders = counts.map(count => new Int32Array(count));\n  counts.fill(0);\n  for (let i = 0, n = x.order?.length ?? table.length; i < n; i++) {\n    const row = x.order?.[i] ?? i;\n    const index = membership[row]!;\n    if (index < 0) continue;\n    orders[index]![counts[index]!] = row;\n    counts[index] = counts[index]! + 1;\n  }\n  const value = options.values[0]!;\n  return Array.from(indexes, ([key, index]) => ({ key, label: key, value, order: orders[index]! }));\n}\n\ninterface AlignedGroup {\n  readonly group: Group;\n  readonly order: Int32Array | null;\n  readonly gaps: Float64Array | null;\n  return { ...description, drawable, y, slot, row };\n}\n\nconst maxAlignedSlots = 20_000_000;\n\nexport function alignmentFits(series: number, positions: number, sink: DiagnosticSink): boolean {\n  if (series * positions <= maxAlignedSlots) return true;\n  report(sink, 'AX134', 'chart-error', {\n    count: 1, detail: 'The aligned frame has ' + series + ' series and ' + positions + ' x positions, exceeding 20,000,000 slots.',\n  });\n  return false;\n}\n\nexport function alignedFrame(\n  options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion, counts?: Map<string, ValueCounts>,\n): AlignedFrame {\n  const axis = x.parser.column(x.positions);\n  const { table } = options;\n  const frame = {\n    ...base(table, version), shape: 'aligned' as const,\n    xLabel: options.x.label, yLabel: options.values.length === 1 ? options.values[0]!.label : null,\n  };\n  const empty = () => ({ ...frame, x: { ...axis, values: new Float64Array(), categories: axis.categories && [] }, length: 0, series: [] });\n  const observed = combinePositions(x, []);\n  const groupsBySeries = groups(options, x, sink);\n  if (!alignmentFits(groupsBySeries.length, observed.length, sink)) return empty();\n  const aligned: AlignedGroup[] = [];\n  for (const group of groupsBySeries) {\n    aligned.push(alignGroup(group, x, axis, options.x.field, table, sink, options.series === null ? aligned[0] : undefined));\n  }\n  const positions = aligned.some(group => group.gaps) ? combinePositions(x, aligned) : observed;\n  if (!alignmentFits(aligned.length, positions.length, sink)) return empty();\n  const column = { ...axis, values: positions };\n  const included = x.order === null ? undefined : (row: number) => Number.isFinite(x.positions[row]);\n  const shared = options.series === null ? undefined : readValues(table, options.values[0]!, sink, true, 0, undefined, included);\n  const series = aligned.map(group => {\n    const value = group.group.value;\n    const count = counts ? { decimal: 0, other: 0 } : undefined;\n    const values = shared ?? readValues(table, value, sink, true, 0, undefined, included, undefined, count);\n    if (count) counts!.set(value.field, count);\n    return alignedSeries(group, column, x, table, values);\n  });\n  for (const { group, gaps, sparse } of aligned) {\n    reportGaps(sink, options.x.field, group.value.missing === 'zero', gaps, axis, group.label, sparse, group.key);\n  }\n  return { ...frame, x: column, length: positions.length, series };\n}\n\nexport function pointFrame(options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion): PointFrame {\n  const { table } = options;\n  const value = options.values[0]!;\n/**\n * The compact variant, C1–C5 (spec 3.7), and the rules it keeps from the full charts (C2: F1, F2, F3, F11,\n * I5, L4), each for all three compact kinds: line, area and bar, which are drawn by different code. Read\n * from Chrome's accessibility tree, from the drawn marks' positions and from painted pixels.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport type { Page } from 'playwright-core';\nimport { start, stop } from '../harness';\nimport { axOf, axWithin, box, closePage, createRaw, devPage, inside, modeColor, prodPage, screenshot, settle, shapes, tabStops, type Box } from './util';\nimport { DIRTY, dirtyRows, missingClauses, withUnit, type Clause } from './fixtures';\nimport { inkColor, strokeRuns, traceMotion } from './checks';\n\nbeforeAll(start);\nafterAll(stop);\n\nconst KINDS = ['line', 'area', 'bar'] as const;\ntype Kind = typeof KINDS[number];\n\n/** Five days of one series. */\nconst VALUES = [12, 15, 11, 18, 16];\nconst ROWS = VALUES.map((v, i) => ({ day: `2026-03-0${i + 2}`, v }));\nconst options = (kind: Kind, extra: Record<string, unknown> = {}) => ({ compact: true, title: 'Energy, North', data: ROWS, x: { field: 'day', type: 'date' }, y: { field: 'v', label: 'Energy', unit: 'kWh' }, ...extra, kind });\n\nasync function make(page: Page, kind: Kind, extra: Record<string, unknown> = {}, target = '#chart') {\n  const { kind: fn, ...rest } = options(kind, extra);\n  return createRaw(page, fn, rest, target);\n}\n\n/** Where each datum is drawn: the bars' tops and centres, or the stroke's vertices (line, and area's upper edge). */\nasync function datumPoints(page: Page, kind: Kind, selector = '#chart'): Promise<{ x: number; y: number }[]> {\n  if (kind === 'bar') return ((await shapes(page, selector, 100000))[1] ?? []).map(s => ({ x: s.box.x + s.box.width / 2, y: s.box.y })).sort((a, b) => a.x - b.x);\n  return (await strokeRuns(page, 1, selector)).flat().sort((a, b) => a.x - b.x);\n}\n\nconst CLAUSES: Clause[] = [\n  { name: 'x range', fragments: ['day', 'Mar 2, 2026', 'Mar 6, 2026'] },\n  { name: 'y range', fragments: ['Energy', withUnit(11, 'kWh'), withUnit(18, 'kWh')] },\n  { name: 'series: minimum, maximum, last', fragments: ['Energy', withUnit(11, 'kWh'), withUnit(18, 'kWh'), withUnit(16, 'kWh')] },\n];\n\ndescribe('C1 a static image with a text alternative', () => {\n  for (const kind of KINDS) {\n    it(`C1 compact ${kind}: role img, named by its title, described by the generated summary (each named statement: x range, y range, the series' minimum, maximum and last value), with nothing inside exposed on its own`, async () => {\n      const page = await devPage({ css: '#chart { width: 200px; height: 48px; }' });\n      await make(page, kind);\n      const fig = await axOf(page, '#chart figure');\n      expect(fig.role).toBe('image');\n      expect(fig.name).toBe('Energy, North');\n      expect(missingClauses(fig.description, [{ name: 'type', fragments: [{ line: 'Line', area: 'Area', bar: 'Bar' }[kind]] }, ...CLAUSES]), fig.description).toEqual([]);\n      expect((await axWithin(page, '#chart figure')).filter(n => !['image', 'StaticText', 'generic', 'paragraph', 'InlineTextBox', 'none'].includes(n.role)).map(n => n.role)).toEqual([]);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    for (const build of ['development', 'production'] as const) {\n      it(`C1 compact ${kind}: without a title the name is generated and AX140 is raised (${build} build)`, async () => {\n        const page = build === 'development' ? await devPage() : await prodPage();\n        const built = await make(page, kind, { title: undefined, x: { field: 'day', type: 'date', label: 'Day' } });\n        expect(built.diagnostics.filter(d => d.code === 'AX140').map(d => d.level)).toEqual(['warning']);\n        expect((await axOf(page, '#chart figure')).name).toBe(`${{ line: 'Line', area: 'Area', bar: 'Bar' }[kind]} chart of Energy by Day`);\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n\n    it(`C1 compact ${kind}: a page of 40 compact charts adds no tab stop, and pointing at one changes nothing on the page: no element appears, no text changes, no pixel changes`, async () => {\n      const page = await devPage({ css: '.tile { width: 160px; height: 48px; }' });\n      await page.evaluate(() => {\n        const after = document.querySelector('#after')!;\n        for (let i = 0; i < 40; i++) { const el = document.createElement('div'); el.id = `tile-${i}`; el.className = 'tile'; after.before(el); }\n      });\n      for (let i = 0; i < 40; i++) await make(page, kind, { title: `Tile ${i}` }, `#tile-${i}`);\n      expect(await tabStops(page)).toEqual(['after']);\n      // Leave nothing focused, so a focus ring on the page's own button does not count as a change.\n      await page.evaluate(() => (document.activeElement as HTMLElement | null)?.blur());\n      await settle(page);\n      const state = () => page.evaluate(() => [...document.querySelectorAll('body *')].filter(e => (e as HTMLElement).offsetParent !== null || e.tagName === 'svg').map(e => `${e.tagName}:${e.getAttribute('class') ?? ''}:${e.children.length ? '' : e.textContent}`).join('\\n'));\n      const before = { dom: await state(), img: (await screenshot(page, 'body', { x: 0, y: 0, width: 900, height: 700 })).img };\n      for (const i of [0, 3, 39]) {\n        const b = await box(page, `#tile-${i}`);\n        await page.mouse.move(b.x + b.width / 2, b.y + b.height / 2);\n        await settle(page);\n        await page.mouse.down();\n        await page.mouse.up();\n        await settle(page);\n      }\n      expect(await state()).toBe(before.dom);\n      const after = (await screenshot(page, 'body', { x: 0, y: 0, width: 900, height: 700 })).img;\n      let differing = 0, x0 = Infinity, y0 = Infinity, x1 = -1, y1 = -1;\n      for (let k = 0; k < after.data.length; k += 4) if (after.data[k] !== before.img.data[k] || after.data[k + 1] !== before.img.data[k + 1] || after.data[k + 2] !== before.img.data[k + 2]) { differing++; const x = (k / 4) % after.width, y = Math.floor(k / 4 / after.width); x0 = Math.min(x0, x); y0 = Math.min(y0, y); x1 = Math.max(x1, x); y1 = Math.max(y1, y); }\n      expect(differing, `pixels changed in ${x0},${y0}–${x1},${y1}`).toBe(0);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\ndescribe('C2 the fidelity rules hold', () => {\n  for (const kind of ['area', 'bar'] as const) {\n    it(`C2 compact ${kind}: the value axis includes zero (F1): for the Phase 1 bars values (82–97) each datum is drawn at value / 97 of the height above the bottom`, async () => {\n      const page = await devPage({ css: '#chart { width: 280px; height: 100px; }' });\n      const values = [94, 88, 97, 82, 91, 85, 90];\n      await createRaw(page, kind, { compact: true, title: 'Satisfied', data: values.map((v, i) => ({ c: `T${i}`, v })), x: 'c', y: 'v' });\n      const pts = await datumPoints(page, kind);\n      expect(pts).toHaveLength(7);\n      // The baseline: the bottom of the tallest bar, or the lowest point of the area's fill.\n      const bottom = kind === 'bar'\n        ? Math.max(...((await shapes(page, '#chart', 100000))[1] ?? []).map(s => s.box.y + s.box.height))\n        : await page.evaluate(() => { const svg = document.querySelector('#chart svg.axylo-svg') as SVGSVGElement; const m = svg.getScreenCTM()!; let low = -Infinity; for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) { if (el.style.getPropertyValue('fill') !== 'currentcolor') continue; const n = el.getAttribute('d')!.match(/-?\\d*\\.?\\d+/g)!.map(Number); for (let i = 1; i < n.length; i += 2) low = Math.max(low, new DOMPoint(n[i - 1]!, n[i]!).matrixTransform(m).y); } return low; });\n      const top = Math.min(...pts.map(p => p.y));\n      const height = bottom - top;\n      values.forEach((v, i) => expect((bottom - pts[i]!.y) / height, `datum ${i + 1} (${v})`).toBeCloseTo(v / 97, 2));\n      expect(await closePage(page)).toEqual([]);\n","exit_code":0,"status":"completed"}}
