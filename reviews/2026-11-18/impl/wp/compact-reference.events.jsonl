ge: expect.stringMatching(/series \"y\".*too sparse/i),\n      }));\n    }\n    expect([...before.x.values]).toEqual([0, 1, 2, 3, 4]);\n    const other = aligned({\n      data: [...opts.data, extra].map(row => ({ ...row, s: 'sparse' })).concat({ x: 3, y: 3, s: 'other' }),\n      x: 'x', y: 'y', series: 's',\n  /** The callback gets the animation frame's time when the host has one. */\n  requestFrame(callback: (time?: number) => void): number;\n  cancelFrame(handle: number): void;\n  locale(option: unknown): string;\n  pageLang(): string | null;\n  /** Text of the page element with this id, or null when there is none. */\n  labelText(id: string): string | null;\n  textStyle(): TextStyle;\n  /**\n   * The plot container's size as the figure lays it out, with what the rest of the figure overflows by\n   * subtracted from its height (so it can be negative); null when the figure is not laid out at all (hidden\n   * or detached), which is not the same as a visible figure whose caption left no room.\n   */\n  measure(): Size | null;\n  devicePixelRatio(): number;\n  theme(seriesKeys: readonly string[], colors: Record<string, string>): ThemeResolution;\n  /** Shows or hides the mark and text surfaces without drawing (the error revision hides them). */\n  surfaces?(visible: boolean): void;\n  /** Called once by destroy, after the controller released its own state. */\n  dispose(): void;\n}\n\n/** What the page tells the controller (observers, watchers). */\nexport interface Invalidate {\n  resize(): void;\n  /** The chart came back into the document: anything about the page may have changed meanwhile. */\n  page(): void;\n  theme(): void;\n  /** The page's language changed: locale and English marking are read again in the next frame. */\n  language(): void;\n  fonts(): void;\n  pixelRatio(): void;\n}\n\n/** What the interaction layer may ask for; everything goes through the public paths. */\nexport interface ControllerActions {\n  zoom(window: Span | null): void;\n  toggle(seriesKey: string): void;\n  pause(paused: boolean): void;\n  select(ref: DatumRef): void;\n  hover(ref: DatumRef | null): void;\n}\n\nexport interface Controller {\n  readonly handle: ChartHandle;\n  readonly actions: ControllerActions;\n  readonly invalidate: Invalidate;\n  /** Runs the pending frame now (tests, and theme changes that arrive inside a frame). */\n  flush(): void;\n}\n\ntype Store = AlignedStore | PointStore | DonutStore;\nimport type { IndexRange } from '../core/contracts';\nimport type { Span } from './references';\n\nfunction spacing(values: Float64Array, i: number, j: number, fraction: number): number {\n  const a = values[i]!;\n  const b = values[j]!;\n  const difference = b - a;\n  return Number.isFinite(difference) ? difference * fraction : b * fraction - a * fraction;\n}\n\nexport function barHalfWidth(values: Float64Array, i: number): number {\n  if (values.length === 1) return 0.4;\n  return Math.min(\n    i > 0 ? spacing(values, i - 1, i, 0.4) : Infinity,\n    i + 1 < values.length ? spacing(values, i, i + 1, 0.4) : Infinity,\n  );\n}\n\nexport function barExtent(values: Float64Array): Span {\n  const last = values.length - 1;\n  if (last < 0) return [Infinity, -Infinity];\n  const firstHalf = last === 0 ? 0.5 : spacing(values, 0, 1, 0.5);\n  const lastHalf = last === 0 ? 0.5 : spacing(values, last - 1, last, 0.5);\n  return [\n    Math.max(-Number.MAX_VALUE, values[0]! - firstHalf),\n    Math.min(Number.MAX_VALUE, values[last]! + lastHalf),\n  ];\n}\n\nexport function barRange(values: Float64Array, range: IndexRange, domain: Span): IndexRange {\n  let { start, end } = range;\n  // A band's width is smaller than its neighbour spacing, so only adjacent slots can cross an edge.\n  if (start > 0 && domain[0] - values[start - 1]! < barHalfWidth(values, start - 1)) start--;\n  if (end < values.length && values[end]! - domain[1] < barHalfWidth(values, end)) end++;\n  return start === range.start && end === range.end ? range : { start, end };\n}\