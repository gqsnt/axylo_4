{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/core/options.ts && rg -n 'compact\\\\s*[=:]|CompactOption|reference' packages/axylo/src/index.ts packages/axylo/src/core/controller.ts packages/axylo/test/acceptance/f-domains.test.ts packages/axylo/test/browser/acceptance/compact.browser.test.ts && sed -n '1,45p' packages/axylo/test/reader/index.test.ts && cat packages/axylo/test/view/fixtures.ts && cat packages/axylo/test/data/helpers.ts\"","aggregated_output":"/**\n * The options a chart currently holds, and the patch rule of the commit contract (plan 1.5): a key present in\n * a patch replaces the old value whole, a key set to `undefined` returns to its default (it is removed, and\n * resolution supplies the default), and absent keys stay. No deep merging.\n */\n\nexport type OptionRecord = Readonly<Record<string, unknown>>;\n\n/** Keys the controller reads itself and never passes to option resolution. */\nexport const INTERNAL_KEYS: readonly string[] = ['__renderer'];\n\nexport interface Patched {\n  readonly next: OptionRecord;\n  /** Keys whose value is no longer the same object or primitive. */\n  readonly changed: ReadonlySet<string>;\n}\n\n/** Applies a patch to `current` without changing it. */\nexport function applyPatch(current: OptionRecord, patch: unknown): Patched {\n  const next: Record<string, unknown> = { ...current };\n  const changed = new Set<string>();\n  if (patch === null || typeof patch !== 'object') return { next, changed };\n  for (const key of Object.keys(patch)) {\n    if (INTERNAL_KEYS.includes(key)) continue;\n    const value = (patch as Record<string, unknown>)[key];\n    const had = Object.hasOwn(current, key);\n    if (value === undefined) {\n      if (had) {\n        delete next[key];\n        changed.add(key);\n      }\n      continue;\n    }\n    // Small option inputs are kept as given at the call (a copy), never the caller's object, so editing and\n    // resubmitting that object is seen as a change (review 3, finding 12). Data stays borrowed.\n    const kept = key === 'data' ? value : snapshot(value);\n    if (!had || !Object.is(current[key], value) && !sameValue(current[key], kept)) changed.add(key);\n    next[key] = kept;\n  }\n  return { next, changed };\n}\n\n/** A copy of plain objects and arrays (functions, dates, typed arrays and other objects as they are). */\nfunction snapshot(value: unknown): unknown {\n  if (Array.isArray(value)) return value.map(snapshot);\n  if (isPlain(value)) {\n    const out: Record<string, unknown> = {};\n    for (const key of Object.keys(value)) out[key] = snapshot(value[key]);\n    return out;\n  }\n  return value;\n}\n\n/** Holds the accepted options. A rejected call never reaches `commit`, so the store stays on the last valid state. */\nexport class OptionsStore {\n  private value: OptionRecord;\n\n  constructor(initial: unknown) {\n    this.value = applyPatch({}, initial).next;\n  }\n\n  get current(): OptionRecord {\n    return this.value;\n  }\n\n  /** What `patch` would give, without accepting it. */\n  preview(patch: unknown): Patched {\n    return applyPatch(this.value, patch);\n  }\n\n  commit(next: OptionRecord): void {\n    this.value = next;\n  }\n}\n\n/**\n * Structural equality for option values that describe encoding (field specs, domains, references): plain\n * objects and arrays by content, functions and everything else by identity. Data is never compared this way.\n */\nexport function sameValue(a: unknown, b: unknown): boolean {\n  if (Object.is(a, b)) return true;\n  if (a instanceof Date && b instanceof Date) return a.getTime() === b.getTime();\n  if (Array.isArray(a) && Array.isArray(b)) {\n    return a.length === b.length && a.every((item, i) => sameValue(item, b[i]));\n  }\n  if (isPlain(a) && isPlain(b)) {\n    const keys = Object.keys(a);\n    if (keys.length !== Object.keys(b).length) return false;\n    return keys.every(key => Object.hasOwn(b, key) && sameValue(a[key], b[key]));\n  }\n  return false;\n}\n\nfunction isPlain(value: unknown): value is Record<string, unknown> {\n  if (value === null || typeof value !== 'object') return false;\n  const proto = Object.getPrototypeOf(value) as unknown;\n  return proto === Object.prototype || proto === null;\n}\npackages/axylo/test/browser/acceptance/compact.browser.test.ts:22:const options = (kind: Kind, extra: Record<string, unknown> = {}) => ({ compact: true, title: 'Energy, North', data: ROWS, x: { field: 'day', type: 'date' }, y: { field: 'v', label: 'Energy', unit: 'kWh' }, ...extra, kind });\npackages/axylo/test/browser/acceptance/compact.browser.test.ts:100:      await createRaw(page, kind, { compact: true, title: 'Satisfied', data: values.map((v, i) => ({ c: `T${i}`, v })), x: 'c', y: 'v' });\npackages/axylo/test/browser/acceptance/compact.browser.test.ts:124:      const built = await createRaw(dirty, kind, { compact: true, title: 'Dirty', data: dirtyRows(), x: 'day', y: 'value' });\npackages/axylo/test/browser/acceptance/compact.browser.test.ts:163:    await createRaw(page, 'line', { compact: true, title: 'Gaps', data: [10, 20, null, 40, null, 60, 70].map((v, x) => ({ x, v })), x: 'x', y: 'v' });\npackages/axylo/test/browser/acceptance/compact.browser.test.ts:209:      const built = await createRaw(page, kind, { compact: true, title: 'Two', data, x: { field: 'day', type: 'date' }, y: 'v', series: 's' });\npackages/axylo/test/browser/acceptance/compact.browser.test.ts:243:      await createRaw(page, kind, { compact: true, title: 'Dirty', data: dirtyRows(), x: 'day', y: 'value' });\npackages/axylo/test/acceptance/f-domains.test.ts:64:  it(`F7 ${type}: for any generated extents the automatic domain includes data and references and the zoom stays inside its governing domain`, () => {\npackages/axylo/test/acceptance/f-domains.test.ts:67:      fc.assert(fc.property(value, value, value, fc.boolean(), (a, b, reference, authored) => {\npackages/axylo/test/acceptance/f-