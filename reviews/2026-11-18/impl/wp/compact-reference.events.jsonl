{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/test/acceptance/compact.test.ts && cat packages/axylo/test/acceptance/model.ts && sed -n '1,48p' packages/axylo/test/acceptance/EVIDENCE.json\"","aggregated_output":"import { expect, it } from 'vitest';\nimport { aligned, axes, chart, codes, committed, message, expectCompact, lastModel, marks, pathRuns, plot, scene } from './model';\n\nfor (const kind of aligned) {\n  it(`C1 compact: ${kind} has a name and full summary, and the committed model is static`, () => {\n    const r = chart('compact', [{ x: 1, y: 6 }, { x: 2, y: 4 }, { x: 3, y: 8 }], {\n      title: undefined, description: 'Collected outdoors.',\n    }, undefined, kind);\n    r.frames();\n    expect(codes(r)).toEqual(['AX140']);\n    const capitalized = kind[0]!.toUpperCase() + kind.slice(1);\n    expect(lastModel(r)).toMatchObject({ compact: true, name: message('chartName', { type: capitalized, x: 'x', y: 'y' }), summaryVisible: false });\n    expect(lastModel(r).summary).toContain('1 series');\n    expect(lastModel(r).summary).toContain('x from 1 to 3');\n    expect(lastModel(r).summary).toContain(message('seriesSummary', { series: 'y', min: 4, max: 8, last: 8 }));\n    expect(lastModel(r).summary).toContain('Collected outdoors.');\n    expectCompact(r);\n  });\n\n  it(`C2 compact: ${kind} draws only data marks, commits the sorted final geometry in one frame, and ignores public zoom`, () => {\n    const r = chart('compact', [{ x: 3, y: 8 }, { x: 1, y: 6 }, { x: 2, y: 4 }], {\n      reference: [{ y: 10, label: 'Target' }],\n    }, undefined, kind);\n    r.frames();\n    const initial = scene(r);\n    expect(initial.marks.length).toBeGreaterThan(0);\n    expect(initial.marks.every(mark => ['rects', 'area', 'path', 'points'].includes(mark.type))).toBe(true);\n    expect(lastModel(r).summary).toContain(message('seriesSummary', { series: 'y', min: 4, max: 8, last: 8 }));\n    r.controller.handle.zoom([1, 2]);\n    r.frames();\n    expect(scene(r)).toEqual(initial);\n    r.controller.handle.update({ data: [{ x: 3, y: 20 }, { x: 1, y: 5 }, { x: 2, y: 9 }] });\n    expect(scene(r)).toBe(initial);\n    expect(r.frames()).toBe(1);\n    expect(scene(r)).not.toEqual(initial);\n    expect(lastModel(r).summary).toContain(message('seriesSummary', { series: 'y', min: 5, max: 20, last: 20 }));\n    expectCompact(r);\n  });\n\n  it(`C3 compact: ${kind} fills a 24 by 16 CSS-pixel container and expands when measured (reading: stroke clearance can sit inside the container)`, () => {\n    const r = chart('compact', [{ x: 1, y: 3 }, { x: 2, y: 8 }], {}, { container: { width: 24, height: 16 } }, kind);\n    r.frames();\n    const initial = plot(r);\n    expect(initial).toMatchObject({ kind: 'compact', width: 24, height: 16 });\n    expect(initial.plot.width).toBeGreaterThan(0);\n    expect(initial.plot.height).toBeGreaterThan(0);\n    expect(scene(r).marks.length).toBeGreaterThan(0);\n    r.container = { width: 137, height: 32 };\n    r.controller.invalidate.resize();\n    r.frames();\n    expect(plot(r)).toMatchObject({ kind: 'compact', width: 137, height: 32 });\n    expect(plot(r).plot.width).toBeGreaterThan(initial.plot.width);\n    expect(plot(r).plot.height).toBeGreaterThan(initial.plot.height);\n    expect(codes(r)).toEqual([]);\n  });\n\n  it(`C5 compact: ${kind} supplies omission text for the corner marker and summary (reading: neither refers to an unavailable table)`, () => {\n    const r = chart('compact', [{ x: 1, y: 4 }, { x: 2, y: Infinity }, { x: 3, y: 6 }], {}, undefined, kind);\n    r.frames();\n    expect(codes(r)).toEqual(['AX103']);\n    expect(lastModel(r).compact).toBe(true);\n    expect(lastModel(r).note).toContain('Values not shown: 1.');\n    expect(lastModel(r).summary).toContain('Values not shown: 1.');\n    expect(lastModel(r).summary).toContain(message('seriesSummary', { series: 'y', min: 4, max: 6, last: 6 }));\n    expectCompact(r);\n    expect(committed(r).reader.table).toBeNull();\n    expect(lastModel(r).note).not.toContain('See table');\n    expect(lastModel(r).summary).not.toContain('See table');\n  });\n}\n\nfor (const kind of ['line', 'area'] as const) {\n  it(`C4 compact: two ${kind} strokes use distinct paint bindings and dashes and AX131 suggests one series`, () => {\n    const r = chart('compact', [{ x: 1, a: 3, b: 7 }, { x: 2, a: 4, b: 5 }], { y: ['a', 'b'] }, undefined, kind);\n    r.frames();\n    const [first, second] = marks(r, 'path');\n    expect(first?.stroke).toEqual({ kind: 'series', index: 0 });\n    expect(second?.stroke).toEqual({ kind: 'series', index: 1 });\n    expect(first?.dash.normal).not.toEqual(second?.dash.normal);\n    expect(pathRuns(first!.xy)[0]).toHaveLength(2);\n    expect(axes(r).y.domain[1]).toBeGreaterThanOrEqual(7);\n    expect(r.controller.handle.diagnostics).toMatchObject([{ code: 'AX131', message: expect.stringMatching(/one series/i) }]);\n    expectCompact(r);\n  });\n}\nimport { expect } from 'vitest';\nimport type { ChartKind } from '../../src/core/controller';\nimport type { DatumRef, Layout, Mark, TooltipModel, XScale } from '../../src/core/contracts';\nimport { defaultMessages } from '../../src/messages';\nimport { valueText } from '../../src/core/focus';\nimport { lastModel, record, type HostOptions, type Recording } from '../core/host';\n\nexport { lastModel, record, type Recording };\nexport const types = ['line', 'area', 'bar', 'scatter', 'donut', 'compact'] as const;\nexport const aligned = ['line', 'area', 'bar'] as const;\nexport const compactKinds = (type: Type) => type === 'compact' ? aligned : ['line'] as const;\nexport { defaultMessages };\nexport function message(key: keyof typeof defaultMessages, values: Record<string, string | number> = {}) {\n  let text = defaultMessages[key];\n  for (const [name, value] of Object.entries(values)) text = text.replaceAll(`{${name}}`, String(value));\n  return text.trim();\n}\nexport type Type = typeof types[number];\nexport const day = 86_400_000;\nexport const date = (offset: number) => Date.UTC(2024, 1, 24) + offset * day;\n\nexport function chart(type: Type, data: unknown, options: Record<string, unknown> = {}, host?: HostOptions, compactKind: typeof aligned[number] = 'line') {\n  const encoding = type === 'donut' ? { label: 'x', value: 'y' } : { x: 'x', y: 'y' };\n  const kind: ChartKind = type === 'compact' ? compactKind : type;\n  return record(kind, { title: 'Measurements', data, ...encoding, compact: type === 'compact' || undefined, ...options }, host);\n}\n\nexport function committed(r: Recording) {\n  expect(r.committed, 'frame handed to interaction').not.toBeNull();\n  return r.committed!;\n}\n\nexport function plot(r: Recording): Extract<Layout, { kind: 'plot' | 'compact' }> {\n  const layout = committed(r).layout;\n  if (layout.kind !== 'plot' && layout.kind !== 'compact') throw new Error('Expected a plot, got ' + layout.kind);\n  return layout;\n}\n\nexport function axes(r: Recording) {\n  const { projection } = plot(r);\n  if (projection.kind === 'ring') throw new Error('Expected Cartesian axes');\n  return projection.kind === 'xy' ? { x: projection.x, y: projection.y } : { x: projection.band, y: projection.value };\n}\n\nexport const pixel = (axis: XScale, x: number) => axis.type === 'band' ? axis.center(x) : axis.map(x);\nexport const codes = (r: Recording) => r.controller.handle.diagnostics.map(d => d.code);\nexport const scene = (r: Recording) => r.draws.at(-1)!;\nexport const marks = <Kind extends Mark['type']>(r: Recording, kind: Kind) =>\n  scene(r).marks.filter((mark): mark is Extract<Mark, { type: Kind }> => mark.type === kind);\nexport const rows = (r: Recording) => {\n  const table = committed(r).reader.table;\n  expect(table, 'table model handed to interaction').not.toBeNull();\n  return Array.from({ length: table!.rowCount }, (_, i) => table!.row(i)!);\n};\n\nexport function walk(r: Recording, limit = 100) {\n  const { lookup } = committed(r);\n  const result: DatumRef[] = [];\n  for (let ref = lookup.step(null, 'first'); ref !== null; ref = lookup.step(ref, 'next')) {\n    if (result.length === limit) throw new Error('Keyboard walk exceeded the expected fixture length');\n    result.push(ref);\n  }\n  return result;\n}\n\nexport function reading(r: Recording, ref: DatumRef, mode: 'all' | 'single' = 'all') {\n  const { view, lookup, formatters, messages } = committed(r);\n  return valueText(view, lookup, ref, mode, formatters, messages);\n}\n\nexport function at(r: Recording, x: number): TooltipModel {\n  return committed(r).lookup.tooltip({ kind: 'x', x });\n}\n\nexport function refAt(r: Recording, x: number): DatumRef {\n  const ref = committed(r).lookup.primary({ kind: 'x', x });\n  expect(ref, 'readable datum at the fixture x').not.toBeNull();\n  return ref!;\n}\n\nexport function expectValues(r: Recording, x: number, expected: readonly string[]) {\n  const tooltip = at(r, x);\n  expect(tooltip.rows.map(row => row.value)).toEqual(expected);\n  const ref = refAt(r, x);\n  for (const value of expected) expect(reading(r, ref)).toContain(value);\n}\n\nexport function points(xy: Float32Array): [number, number][] {\n  const result: [number, number][] = [];\n  for (let i = 0; i < xy.length; i += 2) result.push([xy[i]!, xy[i + 1]!]);\n  return result;\n}\n\nexport function pathRuns(xy: Float32Array): [number, number][][] {\n  const runs: [number, number][][] = [[]];\n  for (const pair of points(xy)) {\n    if (Number.isNaN(pair[0])) runs.push([]);\n    else runs.at(-1)!.push(pair);\n  }\n  return runs.filter(run => run.length > 0);\n}\n\nexport function expectGeometry(actual: readonly number[], expected: readonly number[]) {\n  expect(actual).toHaveLength(expected.length);\n  expected.forEach((number, i) => expect(actual[i]).toBeCloseTo(number, 3));\n}\n\nexport function expectCompact(r: Recording) {\n  expect(committed(r)).toMatchObject({ interactive: false, zoom: false, reader: { table: null } });\n