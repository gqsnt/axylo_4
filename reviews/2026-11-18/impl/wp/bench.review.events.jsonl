{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'nl -ba bench/src/stats.js; nl -ba bench/src/admission.js'","aggregated_output":"     1\t// Statistics for the runner (plan 3.3). Pure, runs in Node.\n     2\t// Unit of analysis: the run. Every per-frame or per-sample series is reduced to one number per run first.\n     3\timport { rng } from './fixtures.js';\n     4\t\n     5\texport function quantile(values, p) {\n     6\t  const s = Float64Array.from(values).sort();\n     7\t  if (!s.length) return NaN;\n     8\t  const h = (s.length - 1) * p, lo = Math.floor(h), hi = Math.ceil(h);\n     9\t  return s[lo] + (s[hi] - s[lo]) * (h - lo);\n    10\t}\n    11\texport const median = v => quantile(v, 0.5);\n    12\t\n    13\t/** n blocks, half AB and half BA, in a seeded random order. */\n    14\texport function balancedOrder(blocks, seed) {\n    15\t  if (!Number.isInteger(blocks) || blocks < 2 || blocks % 2) throw new Error(`blocks must be an even number >= 2 (as many AB as BA), got ${blocks}`);\n    16\t  const order = [...Array(blocks / 2).fill('AB'), ...Array(blocks / 2).fill('BA')];\n    17\t  const r = rng(seed);\n    18\t  for (let i = order.length - 1; i > 0; i--) { const j = Math.floor(r() * (i + 1)); [order[i], order[j]] = [order[j], order[i]]; }\n    19\t  return order;\n    20\t}\n    21\t\n    22\t/**\n    23\t * Paired bootstrap over blocks: resample whole blocks (keeping each A with its B), and take\n    24\t * median(B) - median(A) of each resample. Percentile 95% interval.\n    25\t */\n    26\texport function pairedBootstrap(a, b, { iterations = 10000, seed = 12345 } = {}) {\n    27\t  const n = a.length;\n    28\t  if (n !== b.length) throw new Error('paired samples must have equal length');\n    29\t  if (n < 2) return { n, estimate: n ? b[0] - a[0] : NaN, lo: NaN, hi: NaN, note: 'not available: fewer than 2 complete pairs' };\n    30\t  const r = rng(seed);\n    31\t  const diffs = new Float64Array(iterations);\n    32\t  const ra = new Float64Array(n), rb = new Float64Array(n);\n    33\t  for (let it = 0; it < iterations; it++) {\n    34\t    for (let k = 0; k < n; k++) { const i = Math.floor(r() * n); ra[k] = a[i]; rb[k] = b[i]; }\n    35\t    diffs[it] = median(rb) - median(ra);\n    36\t  }\n    37\t  return { n, estimate: median(b) - median(a), lo: quantile(diffs, 0.025), hi: quantile(diffs, 0.975) };\n    38\t}\n    39\t\n    40\t/**\n    41\t * Three outcomes for \"lower is better\" metrics. With a noise band (the A-versus-A interval for the same workload),\n    42\t * the interval must clear the band as well as zero.\n    43\t */\n    44\texport function classify(ci, band) {\n    45\t  if (!Number.isFinite(ci.lo) || !Number.isFinite(ci.hi)) return 'inconclusive';\n    46\t  const lo = band ? Math.min(0, band.lo) : 0, hi = band ? Math.max(0, band.hi) : 0;\n    47\t  if (ci.hi < lo) return 'better';\n    48\t  if (ci.lo > hi) return 'worse';\n    49\t  return 'inconclusive';\n    50\t}\n    51\t\n    52\t/** Below this many complete pairs an interval is still reported, but the outcome is always \"inconclusive\". */\n    53\texport const MIN_PAIRS = 6;\n    54\t\n    55\tconst NA = reason => ({ na: `not available: ${reason}` });\n    56\t\n    57\t/** Metric definitions per workload. Every metric: lower is better. `primary` marks the workload's primary metric. */\n    58\texport const METRICS = {\n    59\t  first: [\n    60\t    { key: 'taskMs', unit: 'ms', primary: true, what: 'main-thread TaskDuration from the create call to settle window end' },\n    61\t    { key: 'scriptMs', unit: 'ms', what: 'ScriptDuration in the same window' },\n    62\t    { key: 'layoutStyleMs', unit: 'ms', what: 'LayoutDuration + RecalcStyleDuration in the same window' },\n    63\t    { key: 'readyMs', unit: 'ms', what: 'wall clock from create call to the adapter\\'s ready signal' },\n    64\t    { key: 'readyFrameMs', unit: 'ms', what: 'wall clock to the first animation frame after ready' },\n    65\t    { key: 'rendererCpuMs', unit: 'ms', what: 'CPU time of the page renderer process, all threads, same window (SystemInfo.getProcessInfo)' },\n    66\t    { key: 'gpuCpuMs', unit: 'ms', what: 'CPU time of the GPU process, same window' },\n    67\t    { key: 'heapChartBytes', unit: 'bytes', what: 'JS heap after forced GC with the chart, minus the same with only the input data' },\n    68\t    { key: 'heapUsedBytes', unit: 'bytes', what: 'JS heap after forced GC with the chart (absolute)' },\n    69\t    { key: 'rendererPssBytes', unit: 'bytes', what: 'page renderer process PSS with the chart (Linux /proc, after GC)' },\n    70\t    { key: 'rendererPssChartBytes', unit: 'bytes', what: 'page renderer PSS with the chart minus with only the input data' },\n    71\t    { key: 'gpuPssBytes', unit: 'bytes', what: 'GPU process PSS with the chart' },\n    72\t    { key: 'gpuPssChartBytes', unit: 'bytes', what: 'GPU process PSS with the chart minus with only the input data' },\n    73\t    { key: 'canvasBackingBytes', unit: 'bytes', what: 'CALCULATED: sum of canvas.width x canvas.height x 4 over the chart canvases' },\n    74\t    { key: 'domNodes', unit: 'nodes', what: 'elements inside the chart containers' },\n    75\t  ],\n    76\t  theme: [\n    77\t    { key: 'taskMsPerToggle', unit: 'ms', primary: true, what: 'median over toggles of TaskDuration from the class toggle to 3 frames + 50 ms later' },\n    78\t    { key: 'taskMsToggleMax', unit: 'ms', what: 'largest per-toggle TaskDuration' },\n    79\t    { key: 'canvasCallsPerToggle', unit: 'calls', what: 'median Canvas 2D drawing calls per toggle window' },\n    80\t    { key: 'mutationsPerToggle', unit: 'records', what: 'median DOM mutation records inside the chart per toggle window' },\n    81\t    { key: 'framesToNewColor', unit: 'frames', what: 'largest number of frames until the marks changed color (untimed toggles)' },\n    82\t  ],\n    83\t  resize: [\n    84\t    { key: 'taskMs', unit: 'ms', primary: true, what: 'TaskDuration over the 2 s width animation and until the charts report ready' },\n    85\t    { key: 'frameP95Ms', unit: 'ms', what: '95th percentile animation-frame interval during the animation' },\n    86\t    { key: 'frameP99Ms', unit: 'ms', what: '99th percentile animation-frame interval' },\n    87\t    { key: 'framesOverThreshold', unit: 'frames', what: 'frame intervals over 1.5x the observed refresh interval' },\n    88\t    { key: 'frameMaxMs', unit: 'ms', what: 'largest frame interval' },\n    89\t    { key: 'rendererCpuMs', unit: 'ms', what: 'page renderer process CPU time, all threads, same window' },\n    90\t    { key: 'gpuCpuMs', unit: 'ms', what: 'GPU process CPU time, same window' },\n    91\t  ],\n    92\t  stream: [\n    93\t    { key: 'taskMsPerUpdate', unit: 'ms', primary: true, what: 'main-thread TaskDuration from stream start to last sample visible, / samples' },\n    94\t    { key: 'delayP50Ms', unit: 'ms', what: 'median per-sample delay, scheduled time to the frame whose drawn state includes it' },\n    95\t    { key: 'delayP95Ms', unit: 'ms', what: '95th percentile of that delay' },\n    96\t    { key: 'delayMaxMs', unit: 'ms', what: 'largest delay' },\n    97\t    { key: 'maxBacklog', unit: 'samples', what: 'largest number of due samples not yet shown after a frame' },\n    98\t    { key: 'coalesced', unit: 'samples', what: 'samples first shown in the same frame as a later sample' },\n    99\t    { key: 'frameP95Ms', unit: 'ms', what: '95th percentile animation-frame interval' },\n   100\t    { key: 'frameP99Ms', unit: 'ms', what: '99th percentile animation-frame interval' },\n   101\t    { key: 'framesOverThreshold', unit: 'frames', what: 'frame intervals over 1.5x the observed refresh interval (25 ms at 60 Hz)' },\n   102\t    { key: 'createTaskMs', unit: 'ms', what: 'TaskDuration to create the initial 600-point window and settle' },\n   103\t  ],\n   104\t};\n   105\tMETRICS.page = METRICS.first;\n   106\t\n   107\tconst ms = (deltas, from, to, name) => {\n   108\t  const d = deltas?.[`${from}->${to}`];\n   109\t  return d && Number.isFinite(d[name]) ? d[name] * 1000 : NaN;\n   110\t};\n   111\t\n   112\tconst cpuMs = (deltas, from, to, name) => {\n   113\t  const d = deltas?.[`${from}->${to}`];\n   114\t  return d && Number.isFinite(d[name]) ? d[name] * 1000 : NA(`${name} not sampled (process not identified)`);\n   115\t};\n   116\t\n   117\tfunction frameStats(out, frames, from, to, refresh) {\n   118\t  const f = frames.filter(t => t >= from && t <= to);\n   119\t  const iv = f.slice(1).map((t, i) => t - f[i]);\n   120\t  if (iv.length < 10) { out.frameP95Ms = out.frameP99Ms = out.framesOverThreshold = out.frameMaxMs = NA(`only ${iv.length} frame intervals in the window`); return; }\n   121\t  out.frameP95Ms = quantile(iv, 0.95);\n   122\t  out.frameP99Ms = quantile(iv, 0.99);\n   123\t  out.frameMaxMs = Math.max(...iv);\n   124\t  out.framesOverThreshold = Number.isFinite(refresh) ? iv.filter(v => v > 1.5 * refresh).length : NA('refresh rate not observed');\n   125\t  out.frameThresholdMs = Number.isFinite(refresh) ? 1.5 * refresh : null;\n   126\t  out.frameCount = iv.length;\n   127\t}\n   128\t\n   129\tfunction memorySummary(out, run) {\n   130\t  const m = run.memory?.samples;\n   131\t  const na = NA('memory not sampled');\n   132\t  if (!m?.chart || !m?.data) { for (const k of ['heapChartBytes', 'heapUsedBytes', 'rendererPssBytes', 'rendererPssChartBytes', 'gpuPssBytes', 'gpuPssChartBytes']) out[k] = na; }\n   133\t  else {\n   134\t    out.heapChartBytes = m.chart.heapUsed - m.data.heapUsed;\n   135\t    out.heapUsedBytes = m.chart.heapUsed;\n   136\t    out.rendererPssBytes = Number.isFinite(m.chart.renderer.pss) ? m.chart.renderer.pss : NA(m.chart.renderer.na ?? 'renderer PSS missing');\n   137\t    out.rendererPssChartBytes = Number.isFinite(m.chart.renderer.pss) && Number.isFinite(m.data.renderer.pss) ? m.chart.renderer.pss - m.data.renderer.pss : NA('renderer PSS missing');\n   138\t    out.gpuPssBytes = Number.isFinite(m.chart.gpu.pss) ? m.chart.gpu.pss : NA(m.chart.gpu.na ?? 'GPU PSS missing');\n   139\t    out.gpuPssChartBytes = Number.isFinite(m.chart.gpu.pss) && Number.isFinite(m.data.gpu.pss) ? m.chart.gpu.pss - m.data.gpu.pss : NA('GPU PSS missing');\n   140\t  }\n   141\t  const cb = run.result.canvasBacking;\n   142\t  out.canvasBackingBytes = cb ? cb.chartCanvasBytes : NA('not recorded');\n   143\t  out.domNodes = cb ? cb.domNodes : NA('not recorded');\n   144\t}\n   145\t\n   146\t/** One run's raw record -> one number per metric (or a \"not available\" reason). */\n   147\texport function summarizeRun(workload, run) {\n   148\t  const out = {};\n   149\t  const refresh = run.result.env?.refresh?.medianIntervalMs;\n   150\t  if (workload === 'theme') {\n   151\t    const t = run.result.theme;\n   152\t    const per = [];\n   153\t    for (let i = 0; i < t.toggles; i++) { const v = ms(run.deltas, `toggle${i}:start`, `toggle${i}:end`, 'TaskDuration'); if (Number.isFinite(v)) per.push(v); }\n   154\t    out.taskMsPerToggle = per.length ? median(per) : NA('TaskDuration missing');\n   155\t    out.taskMsToggleMax = per.length ? Math.max(...per) : NA('TaskDuration missing');\n   156\t    out.canvasCallsPerToggle = median(t.work.map(w => w.canvasCalls));\n   157\t    out.mutationsPerToggle = median(t.work.map(w => w.mutations));\n   158\t    out.framesToNewColor = t.framesToChange.every(v => v !== null) ? Math.max(...t.framesToChange) : NA('the marks did not change within 10 frames in an untimed toggle');\n   159\t    return out;\n   160\t  }\n   161\t  if (workload === 'resize') {\n   162\t    const r = run.result.resize;\n   163\t    const t = ms(run.deltas, 'resize:start', 'resize:end', 'TaskDuration');\n   164\t    out.taskMs = Number.isFinite(t) ? t : NA('TaskDuration missing');\n   165\t    frameStats(out, r.frames, r.startAt, r.endAt, refresh);\n   166\t    out.rendererCpuMs = cpuMs(run.deltas, 'resize:start', 'resize:end', 'rendererCpu');\n   167\t    out.gpuCpuMs = cpuMs(run.deltas, 'resize:start', 'resize:end', 'gpuCpu');\n   168\t    return out;\n   169\t  }\n   170\t  if (workload === 'stream') {\n   171\t    const s = run.result.stream;\n   172\t    const task = ms(run.deltas, 'stream:start', 'stream:end', 'TaskDuration');\n   173\t    out.taskMsPerUpdate = Number.isFinite(task) ? task / s.samples : NA('TaskDuration missing');\n   174\t    const delays = [];\n   175\t    for (let i = 0; i < s.samples; i++) if (Number.isFinite(s.visible[i]) && Number.isFinite(s.due[i])) delays.push(s.visible[i] - s.due[i]);\n   176\t    if (delays.length) { out.delayP50Ms = quantile(delays, 0.5); out.delayP95Ms = quantile(delays, 0.95); out.delayMaxMs = Math.max(...delays); }\n   177\t    else out.delayP50Ms = out.delayP95Ms = out.delayMaxMs = NA('no sample became visible');\n   178\t    out.maxBacklog = s.maxBacklog;\n   179\t    out.coalesced = s.coalesced;\n   180\t    out.neverVisible = s.neverVisible;\n   181\t    const from = s.startAt, to = s.endAt;\n   182\t    const f = s.frames.filter(t => t >= from && t <= to);\n   183\t    const iv = f.slice(1).map((t, i) => t - f[i]);\n   184\t    const refresh = run.result.env?.refresh?.medianIntervalMs;\n   185\t    if (iv.length >= 10) {\n   186\t      out.frameP95Ms = quantile(iv, 0.95);\n   187\t      out.frameP99Ms = quantile(iv, 0.99);\n   188\t      out.framesOverThreshold = Number.isFinite(refresh) ? iv.filter(v => v > 1.5 * refresh).length : NA('refresh rate not observed');\n   189\t      out.frameThresholdMs = Number.isFinite(refresh) ? 1.5 * refresh : null;\n   190\t      out.frameCount = iv.length;\n   191\t    } else out.frameP95Ms = out.frameP99Ms = out.framesOverThreshold = NA(`only ${iv.length} frame intervals in the stream window`);\n   192\t    const c = ms(run.deltas, 'create:start', 'create:end', 'TaskDuration');\n   193\t    out.createTaskMs = Number.isFinite(c) ? c : NA('TaskDuration missing');\n   194\t    return out;\n   195\t  }\n   196\t  const g = name => ms(run.deltas, 'create:start', 'create:end', name);\n   197\t  const t = g('TaskDuration');\n   198\t  out.taskMs = Number.isFinite(t) ? t : NA('TaskDuration missing');\n   199\t  out.scriptMs = g('ScriptDuration');\n   200\t  out.layoutStyleMs = g('LayoutDuration') + g('RecalcStyleDuration');\n   201\t  out.devtoolsMs = g('DevToolsCommandDuration');\n   202\t  out.readyMs = run.result.timing.readyMs;\n   203\t  out.readyFrameMs = run.result.timing.readyFrameMs;\n   204\t  out.rendererCpuMs = cpuMs(run.deltas, 'create:start', 'create:end', 'rendererCpu');\n   205\t  out.gpuCpuMs = cpuMs(run.deltas, 'create:start', 'create:end', 'gpuCpu');\n   206\t  memorySummary(out, run);\n   207\t  return out;\n   208\t}\n   209\t\n   210\t/**\n   211\t * Pair the summarized runs by block and compare B (candidate) with A (baseline) on every metric.\n   212\t * Only blocks in which both runs are \"ok\" and admitted are paired; the rest are counted.\n   213\t */\n   214\texport function analyze(workload, runs, { noise } = {}) {\n   215\t  const blocks = new Map();\n   216\t  for (const r of runs) {\n   217\t    if (r.phase !== 'timed') continue;\n   218\t    if (!blocks.has(r.block)) blocks.set(r.block, {});\n   219\t    blocks.get(r.block)[r.config] = r;\n   220\t  }\n   221\t  const complete = [...blocks.values()].filter(b => b.A?.outcome === 'ok' && b.B?.outcome === 'ok');\n   222\t  const outcomes = {};\n   223\t  for (const r of runs) if (r.phase === 'timed') outcomes[`${r.config}:${r.outcome}`] = (outcomes[`${r.config}:${r.outcome}`] ?? 0) + 1;\n   224\t  const metrics = {};\n   225\t  for (const m of METRICS[workload]) {\n   226\t    const pairs = complete.filter(b => typeof b.A.summary[m.key] === 'number' && typeof b.B.summary[m.key] === 'number' && Number.isFinite(b.A.summary[m.key]) && Number.isFinite(b.B.summary[m.key]));\n   227\t    const a = pairs.map(b => b.A.summary[m.key]), b = pairs.map(p => p.B.summary[m.key]);\n   228\t    if (!pairs.length) {\n   229\t      const reason = complete.map(p => p.A.summary[m.key]?.na ?? p.B.summary[m.key]?.na).find(Boolean) ?? 'no complete pair';\n   230\t      metrics[m.key] = { ...m, na: reason.startsWith('not available') ? reason : `not available: ${reason}` };\n   231\t      continue;\n   232\t    }\n   233\t    const ci = pairedBootstrap(a, b);\n   234\t    const band = noise?.metrics?.[m.key];\n   235\t    const bandUsable = band && Number.isFinite(band.lo) && Number.isFinite(band.hi) ? { lo: band.lo, hi: band.hi } : null;\n   236\t    metrics[m.key] = {\n   237\t      ...m, pairs: pairs.length,\n   238\t      medianA: median(a), medianB: median(b),\n   239\t      diff: ci.estimate, lo: ci.lo, hi: ci.hi, ...(ci.note ? { note: ci.note } : {}),\n   240\t      relative: median(a) ? ci.estimate / median(a) : null,\n   241\t      blockDiffs: pairs.map((p, i) => b[i] - a[i]),\n   242\t      noiseBand: bandUsable ?? (noise ? 'not available: metric missing in the noise run' : 'not available: no A-versus-A run given (--noise)'),\n   243\t      outcome: pairs.length >= MIN_PAIRS ? classify(ci, bandUsable) : 'inconclusive',\n   244\t      ...(pairs.length < MIN_PAIRS ? { outcomeNote: `inconclusive by rule: ${pairs.length} complete pairs, fewer than ${MIN_PAIRS}` } : {}),\n   245\t    };\n   246\t  }\n   247\t  return { completePairs: complete.length, blocks: blocks.size, outcomes, metrics };\n   248\t}\n     1\t// Admission check: compares what a chart reports it shows (adapter.describe()) with what the fixture says it must show.\n     2\t// Pure, runs in Node. A timing is accepted only for a run whose readback passes.\n     3\t\n     4\t// Loose enough for axis padding and nice-number rounding, tight enough to catch a pinned or runaway range.\n     5\tconst X_SLACK = 0.1;        // visible x range may exceed the data's x extent by 10% of that extent on each side\n     6\tconst Y_LOOSENESS = 4;      // visible y span may be at most 4x the larger of the data's y span and its largest |y|\n     7\tconst X_EXACT_MS = 1;       // oldest/newest x must match to the millisecond\n     8\t\n     9\t/**\n    10\t * @param {object} expected  from fixtures.expectedView\n    11\t * @param {object|null} seen from adapter.describe(): { x: [min, max], y: [min, max], series: [{ points, oldestX, newestX, missing? }], reads }\n    12\t * @returns {{ admitted: boolean, reasons: string[] }}\n    13\t */\n    14\texport function checkView(expected, seen) {\n    15\t  const reasons = [];\n    16\t  if (!seen) return { admitted: false, reasons: ['describe() returned nothing'] };\n    17\t  const num = v => typeof v === 'number' && Number.isFinite(v);\n    18\t  const [x0, x1] = seen.x ?? [];\n    19\t  const [y0, y1] = seen.y ?? [];\n    20\t  if (!num(x0) || !num(x1)) reasons.push(`visible x range is not two finite numbers: ${JSON.stringify(seen.x)}`);\n    21\t  if (!num(y0) || !num(y1)) reasons.push(`visible y range is not two finite numbers: ${JSON.stringify(seen.y)}`);\n    22\t  if (reasons.length) return { admitted: false, reasons };\n    23\t\n    24\t  const xSpan = expected.newestX - expected.oldestX;\n    25\t  if (x0 > expected.oldestX + X_EXACT_MS || x1 < expected.newestX - X_EXACT_MS)\n    26\t    reasons.push(`visible x [${x0}, ${x1}] does not contain the data's x extent [${expected.oldestX}, ${expected.newestX}]`);\n    27\t  if (x0 < expected.oldestX - X_SLACK * xSpan || x1 > expected.newestX + X_SLACK * xSpan)\n    28\t    reasons.push(`visible x [${x0}, ${x1}] is wider than the data's x extent plus ${X_SLACK * 100}% per side`);\n    29\t\n    30\t  if (y0 > expected.yMin || y1 < expected.yMax)\n    31\t    reasons.push(`visible y [${y0}, ${y1}] does not contain the data's y extent [${expected.yMin}, ${expected.yMax}]`);\n    32\t  const scale = Math.max(expected.yMax - expected.yMin, Math.abs(expected.yMin), Math.abs(expected.yMax));\n    33\t  if (y1 - y0 > Y_LOOSENESS * scale)\n    34\t    reasons.push(`visible y span ${y1 - y0} is more than ${Y_LOOSENESS}x the data's scale ${scale}`);\n    35\t  const ex = expected.extreme;\n    36\t  if (!(ex.y >= y0 && ex.y <= y1)) reasons.push(`injected extreme y=${ex.y} at x=${ex.x} is outside visible y [${y0}, ${y1}]`);\n    37\t  if (!(ex.x >= x0 && ex.x <= x1)) reasons.push(`injected extreme x=${ex.x} is outside visible x [${x0}, ${x1}]`);\n    38\t\n    39\t  const ss = seen.series ?? [];\n    40\t  if (ss.length !== expected.series) reasons.push(`chart holds ${ss.length} series, fixture has ${expected.series}`);\n    41\t  ss.slice(0, expected.series).forEach((s, i) => {\n    42\t    if (s.points !== expected.points) reasons.push(`series ${i}: chart holds ${s.points} points, fixture ${expected.points}`);\n    43\t    if (!(Math.abs(s.oldestX - expected.oldestX) <= X_EXACT_MS)) reasons.push(`series ${i}: oldest x ${s.oldestX}, fixture ${expected.oldestX}`);\n    44\t    if (!(Math.abs(s.newestX - expected.newestX) <= X_EXACT_MS)) reasons.push(`series ${i}: newest x ${s.newestX}, fixture ${expected.newestX}`);\n    45\t    if (s.missing !== undefined && s.missing !== expected.missing[i]) reasons.push(`series ${i}: chart holds ${s.missing} missing values, fixture ${expected.missing[i]}`);\n    46\t  });\n    47\t  return { admitted: reasons.length === 0, reasons };\n    48\t}\n    49\t\n    50\t/** Several charts (W-page): every one must pass. */\n    51\texport function checkViews(expectedList, seenList) {\n    52\t  if (!Array.isArray(seenList) || seenList.length !== expectedList.length)\n    53\t    return { admitted: false, reasons: [`expected ${expectedList.length} chart readbacks, got ${Array.isArray(seenList) ? seenList.length : typeof seenList}`] };\n    54\t  const reasons = [];\n    55\t  expectedList.forEach((e, i) => { for (const r of checkView(e, seenList[i]).reasons) reasons.push(`chart ${i}: ${r}`); });\n    56\t  return { admitted: reasons.length === 0, reasons };\n    57\t}\n","exit_code":0,"status":"completed"}}
