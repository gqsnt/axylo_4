{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'nl -ba bench/lib/driver.mjs; nl -ba bench/lib/refs.mjs; nl -ba bench/lib/report.mjs'","aggregated_output":"     1\t// Browser side of the runner: a file server that lives only as long as the calling script, system Chrome through\n     2\t// Playwright, and one run in a fresh browser context.\n     3\timport http from 'node:http';\n     4\timport fs from 'node:fs';\n     5\timport os from 'node:os';\n     6\timport path from 'node:path';\n     7\timport { execFileSync } from 'node:child_process';\n     8\timport { chromium } from 'playwright-core';\n     9\timport { BENCH, DIST, REPO, sha256 } from '../build.mjs';\n    10\timport { workloadData, expectedView, checksum } from '../src/fixtures.js';\n    11\timport { checkViews } from '../src/admission.js';\n    12\t\n    13\tconst TYPES = { '.html': 'text/html', '.js': 'text/javascript', '.json': 'application/json', '.css': 'text/css', '.map': 'application/json' };\n    14\t\n    15\texport function startServer() {\n    16\t  // /axylo/ is the snapshot build.mjs took of packages/axylo/dist (inside DIST).\n    17\t  const roots = { '/': DIST };\n    18\t  const server = http.createServer((req, res) => {\n    19\t    const url = new URL(req.url, 'http://x');\n    20\t    let file = null;\n    21\t    for (const [prefix, root] of Object.entries(roots)) {\n    22\t      if (!url.pathname.startsWith(prefix)) continue;\n    23\t      const rel = decodeURIComponent(url.pathname.slice(prefix.length)) || 'index.html';\n    24\t      const p = path.resolve(root, rel);\n    25\t      if (p.startsWith(root + path.sep)) file = p;\n    26\t      break;\n    27\t    }\n    28\t    if (!file || !fs.existsSync(file) || !fs.statSync(file).isFile()) { res.writeHead(404); res.end('not found'); return; }\n    29\t    res.writeHead(200, { 'content-type': TYPES[path.extname(file)] ?? 'application/octet-stream', 'cache-control': 'no-store' });\n    30\t    fs.createReadStream(file).pipe(res);\n    31\t  });\n    32\t  return new Promise(resolve => server.listen(0, '127.0.0.1', () => resolve({ base: `http://127.0.0.1:${server.address().port}/`, close: () => new Promise(r => server.close(r)) })));\n    33\t}\n    34\t\n    35\texport async function launchBrowser({ headed = false } = {}) {\n    36\t  return chromium.launch({ channel: 'chrome', headless: !headed });\n    37\t}\n    38\t\n    39\tconst tryRead = (p, fallback) => { try { return fs.readFileSync(p, 'utf8').trim(); } catch { return fallback; } };\n    40\tconst fileHash = p => { try { return sha256(fs.readFileSync(p)); } catch { return 'not available: file missing'; } };\n    41\t\n    42\t/** The machine and software record (plan 3.2). Per-run page facts (refresh rate, WebGL, pixel ratio) are added per run. */\n    43\texport function machineRecord(browser, { headed }) {\n    44\t  const cpus = os.cpus();\n    45\t  let commit;\n    46\t  try { commit = execFileSync('git', ['rev-parse', 'HEAD'], { cwd: REPO, stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim(); }\n    47\t  catch { commit = 'not available: the checkout is not a git repository (or git failed)'; }\n    48\t  const osRelease = tryRead('/etc/os-release', '').split('\\n').find(l => l.startsWith('PRETTY_NAME='))?.slice(13).replace(/\"/g, '');\n    49\t  return {\n    50\t    browser: { name: 'Google Chrome (system, via Playwright channel \"chrome\")', version: browser.version(), headless: !headed },\n    51\t    playwright: JSON.parse(fs.readFileSync(path.join(REPO, 'node_modules/playwright-core/package.json'), 'utf8')).version,\n    52\t    node: process.version,\n    53\t    cpu: { model: cpus[0]?.model ?? 'not available', logicalCores: cpus.length, governor: tryRead('/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor', 'not available: no cpufreq governor file') },\n    54\t    memoryGiB: +(os.totalmem() / 2 ** 30).toFixed(1),\n    55\t    os: { type: os.type(), release: os.release(), name: osRelease ?? 'not available', arch: os.arch() },\n    56\t    loadAverageAtStart: os.loadavg(),\n    57\t    hostIdle: 'not controlled: other processes (including other agents) may run on this machine during the session',\n    58\t    power: 'not available: power settings are not read by this harness',\n    59\t    commit,\n    60\t    lockfiles: { 'bench/package-lock.json': fileHash(path.join(BENCH, 'package-lock.json')), 'package-lock.json': fileHash(path.join(REPO, 'package-lock.json')) },\n    61\t    axyloBundles: {\n    62\t      'axylo.iife.min.js': { sha256: fileHash(path.join(DIST, 'axylo/axylo.iife.min.js')), role: 'production build (__DEV__ = false), snapshot of packages/axylo/dist taken by bench/build.mjs; used by the axylo adapters by default' },\n    63\t      'axylo.iife.js': { sha256: fileHash(path.join(DIST, 'axylo/axylo.iife.js')), role: 'development build (__DEV__ = true), same snapshot; used only with build=dev' },\n    64\t      gitStatusOfLibrarySources: (() => { try { return execFileSync('git', ['status', '--short', 'packages/axylo/src'], { cwd: REPO, stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim() || 'clean'; } catch { return 'not available'; } })(),\n    65\t    },\n    66\t  };\n    67\t}\n    68\t\n    69\tconst expectations = new Map();\n    70\t/** Fixture facts the admission check compares against, computed in Node from the same generator as the page. */\n    71\texport function expectedFor(workload, params) {\n    72\t  const key = JSON.stringify([workload, params]);\n    73\t  if (!expectations.has(key)) {\n    74\t    const fixtures = workloadData(workload, params);\n    75\t    expectations.set(key, { views: fixtures.map(expectedView), checksum: checksum(fixtures) });\n    76\t  }\n    77\t  return expectations.get(key);\n    78\t}\n    79\t\n    80\texport function admit(spec, result, floor) {\n    81\t  if (floor) return { admitted: true, reasons: ['not applicable: measurement floor, draws nothing'] };\n    82\t  if (!Array.isArray(result.describe)) return { admitted: false, reasons: ['no readback'] };\n    83\t  const exp = expectedFor(spec.workload, spec.params);\n    84\t  if (result.checksum !== exp.checksum) return { admitted: false, reasons: [`page fixture checksum ${result.checksum} differs from the runner's ${exp.checksum}`] };\n    85\t  const view = checkViews(exp.views, result.describe);\n    86\t  // Workload-specific end states, checked in the page: the marks changed color (theme), the charts follow their\n    87\t  // container's width (resize).\n    88\t  const extra = [...(result.themeCheck && !result.themeCheck.ok ? result.themeCheck.reasons.map(r => `theme: ${r}`) : []),\n    89\t    ...(result.resizeCheck && !result.resizeCheck.ok ? result.resizeCheck.reasons.map(r => `resize: ${r}`) : [])];\n    90\t  return { admitted: view.admitted && extra.length === 0, reasons: [...view.reasons, ...extra] };\n    91\t}\n    92\t\n    93\tconst DURATIONS = ['TaskDuration', 'ScriptDuration', 'LayoutDuration', 'RecalcStyleDuration', 'DevToolsCommandDuration', 'V8CompileDuration', 'TaskOtherDuration', 'ThreadTime'];\n    94\tconst COUNTS = ['LayoutCount', 'RecalcStyleCount', 'Nodes', 'JSEventListeners', 'JSHeapUsedSize', 'JSHeapTotalSize'];\n    95\t\n    96\t/** Every \"<name>:start\" / \"<name>:end\" snapshot pair -> metric deltas, keyed \"<name>:start-><name>:end\". */\n    97\tfunction deltas(snaps, cpu, pagePid, gpuPid) {\n    98\t  const out = {};\n    99\t  for (const from of Object.keys(snaps)) {\n   100\t    if (!from.endsWith(':start')) continue;\n   101\t    const to = `${from.slice(0, -6)}:end`;\n   102\t    if (!snaps[to]) continue;\n   103\t    const d = {};\n   104\t    for (const k of [...DURATIONS, ...COUNTS]) if (k in snaps[from] && k in snaps[to]) d[k] = snaps[to][k] - snaps[from][k];\n   105\t    d.endNodes = snaps[to].Nodes;\n   106\t    d.endJSHeapUsedSize = snaps[to].JSHeapUsedSize;\n   107\t    // CPU time of whole processes (all threads), from the browser: the page's renderer and the GPU process.\n   108\t    const c0 = cpu[from], c1 = cpu[to];\n   109\t    if (c0 && c1) {\n   110\t      if (pagePid && pagePid in c0 && pagePid in c1) d.rendererCpu = c1[pagePid] - c0[pagePid];\n   111\t      if (gpuPid && gpuPid in c0 && gpuPid in c1) d.gpuCpu = c1[gpuPid] - c0[gpuPid];\n   112\t    }\n   113\t    out[`${from}->${to}`] = d;\n   114\t  }\n   115\t  return out;\n   116\t}\n   117\t\n   118\t/** Linux only: proportional set size and resident size of a process, in bytes, from /proc. */\n   119\tfunction procMemory(pid) {\n   120\t  try {\n   121\t    const t = fs.readFileSync(`/proc/${pid}/smaps_rollup`, 'utf8');\n   122\t    const kb = name => Number((new RegExp(`^${name}:\\\\s+(\\\\d+) kB`, 'm').exec(t) ?? [])[1]) * 1024;\n   123\t    return { pss: kb('Pss'), rss: kb('Rss') };\n   124\t  } catch (e) { return { na: `not available: ${e.code ?? e.message}` }; }\n   125\t}\n   126\t\n   127\t/**\n   128\t * One run in a fresh context. Returns { outcome, ... } where outcome is one of\n   129\t * ok | not-admitted | not-available | error | timeout | crash.\n   130\t * spec: { adapter, adapterParams?, workload, params, settleMs, timeoutMs, dpr?, profile?: { file } }\n   131\t */\n   132\texport async function runOnce(browser, base, spec) {\n   133\t  const started = Date.now();\n   134\t  const ctx = await browser.newContext({ viewport: { width: 1440, height: 900 }, deviceScaleFactor: spec.dpr ?? 1, timezoneId: 'UTC', locale: 'en-US' });\n   135\t  const logs = [], pageErrors = [], snaps = {}, cpu = {}, mem = {};\n   136\t  let settle;\n   137\t  const finished = new Promise(r => { settle = r; });\n   138\t  let timer, bcdp;\n   139\t  try {\n   140\t    const page = await ctx.newPage();\n   141\t    const cdp = await ctx.newCDPSession(page);\n   142\t    bcdp = await browser.newBrowserCDPSession();\n   143\t    await cdp.send('Performance.enable', { timeDomain: 'timeTicks' });\n   144\t    const processes = async () => (await bcdp.send('SystemInfo.getProcessInfo')).processInfo;\n   145\t    const cpuSample = async label => { cpu[label] = Object.fromEntries((await processes()).map(p => [p.id, p.cpuTime])); };\n   146\t    let profiling = false;\n   147\t    await page.exposeBinding('__benchMetrics', async (_src, label) => {\n   148\t      // Order keeps the browser-side process sample outside the window: before the start, after the end.\n   149\t      if (label.endsWith(':start')) await cpuSample(label);\n   150\t      if (spec.profile && label === 'create:end' && profiling) { const { profile } = await cdp.send('Profiler.stop'); fs.writeFileSync(spec.profile.file, JSON.stringify(profile)); profiling = false; }\n   151\t      const { metrics } = await cdp.send('Performance.getMetrics');\n   152\t      snaps[label] = Object.fromEntries(metrics.map(m => [m.name, m.value]));\n   153\t      if (label.endsWith(':end')) await cpuSample(label);\n   154\t      if (spec.profile && label === 'create:start') {\n   155\t        await cdp.send('Profiler.enable');\n   156\t        await cdp.send('Profiler.setSamplingInterval', { interval: spec.profile.intervalUs ?? 100 });\n   157\t        await cdp.send('Profiler.start');\n   158\t        profiling = true;\n   159\t      }\n   160\t    });\n   161\t    await page.exposeBinding('__benchMemory', async (_src, label) => {\n   162\t      await cdp.send('HeapProfiler.collectGarbage');\n   163\t      const heap = await cdp.send('Runtime.getHeapUsage');\n   164\t      const procs = await processes();\n   165\t      mem[label] = {\n   166\t        heap,\n   167\t        processes: procs.filter(p => p.type === 'renderer' || p.type === 'GPU').map(p => ({ pid: p.id, type: p.type, cpuTime: p.cpuTime, ...procMemory(p.id) })),\n   168\t      };\n   169\t    });\n   170\t    await page.exposeBinding('__benchDone', (_src, result) => settle({ kind: 'done', result }));\n   171\t    page.on('crash', () => settle({ kind: 'crash' }));\n   172\t    page.on('pageerror', e => pageErrors.push(String(e?.stack ?? e).slice(0, 600)));\n   173\t    page.on('console', m => { if (m.type() === 'error' || m.type() === 'warning') logs.push(`${m.type()}: ${m.text().slice(0, 300)}`); });\n   174\t    timer = setTimeout(() => settle({ kind: 'timeout' }), spec.timeoutMs);\n   175\t    const q = new URLSearchParams({ adapter: spec.adapter, workload: spec.workload, params: JSON.stringify(spec.params), settle: String(spec.settleMs), aparams: JSON.stringify(spec.adapterParams ?? {}) });\n   176\t    page.goto(`${base}?${q}`).catch(e => settle({ kind: 'error', error: `navigation: ${e.message}` }));\n   177\t    // Test hook only (test/admission.test.mjs): crash the renderer to check that a crash is its own outcome.\n   178\t    if (spec.testCrashAfterMs) setTimeout(() => cdp.send('Page.crash').catch(() => {}), spec.testCrashAfterMs);\n   179\t    const end = await finished;\n   180\t    const rec = { adapter: spec.adapter, adapterParams: spec.adapterParams ?? {}, durationMs: Date.now() - started, logs: logs.slice(0, 20), pageErrors: pageErrors.slice(0, 10) };\n   181\t    if (end.kind === 'timeout') return { ...rec, outcome: 'timeout', reason: `no result within ${spec.timeoutMs} ms`, snapshots: Object.keys(snaps) };\n   182\t    if (end.kind === 'crash') return { ...rec, outcome: 'crash', reason: 'renderer process crashed' };\n   183\t    if (end.kind === 'error') return { ...rec, outcome: 'error', error: end.error };\n   184\t    const result = end.result;\n   185\t    if (result.outcome !== 'ok') return { ...rec, outcome: result.outcome, reason: result.reason, error: result.error, result: { env: result.env, adapter: result.adapter } };\n   186\t    if (pageErrors.length) return { ...rec, outcome: 'error', error: `uncaught page error(s): ${pageErrors[0]}`, result: { env: result.env, adapter: result.adapter } };\n   187\t\n   188\t    // The page's renderer is the renderer process that used the most CPU time over the run (the context may also\n   189\t    // hold Chrome's initial and spare renderers); the GPU process is the one process of that type.\n   190\t    const labels = Object.keys(cpu);\n   191\t    let pagePid = null, gpuPid = null;\n   192\t    const finalProcs = await processes();\n   193\t    gpuPid = finalProcs.find(p => p.type === 'GPU')?.id ?? null;\n   194\t    if (labels.length >= 2) {\n   195\t      const first = cpu[labels[0]], last = cpu[labels[labels.length - 1]];\n   196\t      let best = -1;\n   197\t      for (const p of finalProcs) if (p.type === 'renderer' && p.id in first && p.id in last && last[p.id] - first[p.id] > best) { best = last[p.id] - first[p.id]; pagePid = p.id; }\n   198\t    }\n   199\t    const memory = Object.keys(mem).length ? {\n   200\t      pagePid, gpuPid,\n   201\t      samples: Object.fromEntries(Object.entries(mem).map(([label, m]) => [label, {\n   202\t        heapUsed: m.heap.usedSize, heapTotal: m.heap.totalSize, embedderHeapUsed: m.heap.embedderHeapUsedSize, backingStorage: m.heap.backingStorageSize,\n   203\t        renderer: m.processes.find(p => p.pid === pagePid) ?? { na: 'not available: page renderer not identified' },\n   204\t        gpu: m.processes.find(p => p.pid === gpuPid) ?? { na: 'not available: no GPU process' },\n   205\t        otherRenderers: m.processes.filter(p => p.type === 'renderer' && p.pid !== pagePid).map(p => ({ pid: p.pid, pss: p.pss })),\n   206\t      }])),\n   207\t    } : null;\n   208\t\n   209\t    const admission = admit(spec, result, result.adapter.floor);\n   210\t    const run = { ...rec, outcome: admission.admitted ? 'ok' : 'not-admitted', admission, result, deltas: deltas(snaps, cpu, pagePid, gpuPid), memory };\n   211\t    if (!admission.admitted) {\n   212\t      // A timing that failed admission is not kept; only what the chart reported and why it was rejected.\n   213\t      run.reason = admission.reasons.slice(0, 5).join('; ');\n   214\t      delete run.deltas;\n   215\t      delete run.memory;\n   216\t      run.result = { env: result.env, adapter: result.adapter, checksum: result.checksum, describe: result.describe, themeCheck: result.themeCheck, resizeCheck: result.resizeCheck };\n   217\t    }\n   218\t    return run;\n   219\t  } catch (e) {\n   220\t    return { adapter: spec.adapter, outcome: 'error', error: String(e?.stack ?? e).slice(0, 1000), durationMs: Date.now() - started };\n   221\t  } finally {\n   222\t    clearTimeout(timer);\n   223\t    await bcdp?.detach().catch(() => {});\n   224\t    await ctx.close().catch(() => {});\n   225\t  }\n   226\t}\n     1\t// Adapter references and noise bands for the runner.\n     2\timport fs from 'node:fs';\n     3\timport path from 'node:path';\n     4\t\n     5\texport const WORKLOADS = ['first', 'page', 'stream', 'theme', 'resize'];\n     6\t\n     7\t/**\n     8\t * \"axylo:renderer=svg,build=dev\" -> { id: 'axylo', params: { renderer: 'svg', build: 'dev' } }.\n     9\t * Values stay strings except true/false and plain numbers.\n    10\t */\n    11\texport function parseAdapterRef(ref) {\n    12\t  const [id, rest] = String(ref).split(/:(.*)/s);\n    13\t  if (!/^[a-z0-9-]+$/.test(id)) throw new Error(`adapter reference \"${ref}\": the id must be lowercase letters, digits and dashes`);\n    14\t  const params = {};\n    15\t  if (rest) for (const part of rest.split(',')) {\n    16\t    const m = /^([A-Za-z][\\w-]*)=(.*)$/.exec(part);\n    17\t    if (!m) throw new Error(`adapter reference \"${ref}\": parameter \"${part}\" is not key=value`);\n    18\t    params[m[1]] = m[2] === 'true' ? true : m[2] === 'false' ? false : /^-?\\d+(\\.\\d+)?$/.test(m[2]) ? Number(m[2]) : m[2];\n    19\t  }\n    20\t  return { id, params };\n    21\t}\n    22\t\n    23\t/**\n    24\t * Loads one or more complete A-versus-A records for the same workload and parameters. With several, the band is\n    25\t * their union per metric (lowest lo, highest hi), the more cautious choice.\n    26\t */\n    27\texport function loadNoise(refs, historyDir, workload, params) {\n    28\t  const sources = [], metrics = {};\n    29\t  for (const ref of refs) {\n    30\t    const p = fs.existsSync(ref) ? ref : path.join(historyDir, `${ref}.json`);\n    31\t    if (!fs.existsSync(p)) throw new Error(`noise run ${ref} not found`);\n    32\t    const n = JSON.parse(fs.readFileSync(p, 'utf8'));\n    33\t    if (n.design?.mode !== 'aa' || n.status !== 'complete') throw new Error(`noise run ${ref} is not a complete A-versus-A run`);\n    34\t    if (n.design.workload !== workload || JSON.stringify(n.design.params) !== JSON.stringify(params)) throw new Error(`noise run ${ref} is for ${n.design.workload} ${JSON.stringify(n.design.params)}, not this workload`);\n    35\t    sources.push({ runId: n.runId, adapter: n.design.baseline, chrome: n.environment.browser.version, dpr: n.design.dpr });\n    36\t    for (const [k, m] of Object.entries(n.analysis.metrics)) {\n    37\t      if (!Number.isFinite(m.lo) || !Number.isFinite(m.hi)) continue;\n    38\t      const cur = metrics[k];\n    39\t      metrics[k] = cur ? { lo: Math.min(cur.lo, m.lo), hi: Math.max(cur.hi, m.hi) } : { lo: m.lo, hi: m.hi };\n    40\t    }\n    41\t  }\n    42\t  return { sources, metrics };\n    43\t}\n     1\t// Plain-text summary of a history record's analysis.\n     2\tconst fmtBytes = v => (typeof v !== 'number' || !Number.isFinite(v) ? 'n/a' : Math.abs(v) >= 2 ** 20 ? `${(v / 2 ** 20).toFixed(2)} MiB` : `${(v / 1024).toFixed(1)} KiB`);\n     3\tconst fmt = v => (typeof v !== 'number' || !Number.isFinite(v) ? 'n/a' : Math.abs(v) >= 100 ? v.toFixed(1) : Math.abs(v) >= 1 ? v.toFixed(2) : v.toFixed(3));\n     4\t\n     5\texport function formatAnalysis(record) {\n     6\t  const { design, analysis } = record;\n     7\t  const lines = [];\n     8\t  if (!analysis) return 'no analysis (run incomplete)';\n     9\t  if (analysis.notCompared) return `not compared: ${analysis.notCompared.join('; ')}`;\n    10\t  const A = design.mode === 'aa' ? `${design.baseline} (A)` : design.baseline, B = design.mode === 'aa' ? `${design.candidate} (A')` : design.candidate;\n    11\t  lines.push(`\\n${record.runId}  [${record.status}]`);\n    12\t  lines.push(`${design.mode === 'aa' ? 'A-versus-A' : 'comparison'}: A=${A}  B=${B}  workload ${design.workload} ${JSON.stringify(design.params)}`);\n    13\t  lines.push(`complete pairs ${analysis.completePairs}/${analysis.blocks}; run outcomes ${JSON.stringify(analysis.outcomes)}`);\n    14\t  lines.push(`noise band: ${design.noiseFrom ? `from ${[].concat(design.noiseFrom).map(n => n.runId).join(' + ')}` : 'none given (outcomes test against zero only)'}`);\n    15\t  lines.push('');\n    16\t  const head = ['metric', 'median A', 'median B', 'B-A', '95% CI', 'B/A-1', 'outcome'];\n    17\t  const rows = [head];\n    18\t  for (const [key, m] of Object.entries(analysis.metrics)) {\n    19\t    if (m.na) { rows.push([`${key}${m.primary ? ' *' : ''}`, m.na, '', '', '', '', '']); continue; }\n    20\t    const f = m.unit === 'bytes' ? fmtBytes : fmt;\n    21\t    rows.push([`${key}${m.primary ? ' *' : ''}`, f(m.medianA), f(m.medianB), f(m.diff), `[${f(m.lo)}, ${f(m.hi)}]`, m.relative == null ? 'n/a' : `${(m.relative * 100).toFixed(1)}%`, m.outcome + (m.outcomeNote ? ' (few pairs)' : '')]);\n    22\t  }\n    23\t  const w = head.map((_, i) => Math.max(...rows.map(r => String(r[i]).length)));\n    24\t  for (const r of rows) lines.push(r.map((c, i) => String(c).padEnd(w[i])).join('  '));\n    25\t  if (Object.values(analysis.metrics).some(m => m.outcomeNote)) lines.push(`(few pairs): fewer complete pairs than the minimum for a verdict; the interval is shown, the outcome is inconclusive by rule.`);\n    26\t  lines.push('* primary metric. Lower is better for every metric. Units: ms unless the metric counts something (samples, frames, calls, nodes) or is memory (KiB/MiB).');\n    27\t  if (design.mode === 'aa') lines.push('A-versus-A: the 95% CI column is this session\\'s noise band for each metric (one session; the plan asks for three).');\n    28\t  return lines.join('\\n');\n    29\t}\n","exit_code":0,"status":"completed"}}
