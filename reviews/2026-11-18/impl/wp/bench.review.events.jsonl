{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc 'nl -ba bench/profile.mjs; nl -ba bench/lib/profile-summary.mjs'","aggregated_output":"     1\t#!/usr/bin/env node\n     2\t// Records one Chrome CPU profile (CDP Profiler, 100 us sampling) of a create workload, from the create call to the\n     3\t// end of the settle window, and attributes it to Axylo's pipeline stages (lib/profile-summary.mjs).\n     4\t// A profiled run is never used as a timing: the profiler slows the page down.\n     5\t//\n     6\t//   node bench/profile.mjs --adapter axylo:renderer=svg,build=dev --workload first --size 1x100000 [--out bench/results/profiles]\n     7\timport fs from 'node:fs';\n     8\timport path from 'node:path';\n     9\timport { parseArgs } from 'node:util';\n    10\timport { build, BENCH } from './build.mjs';\n    11\timport { startServer, launchBrowser, runOnce, machineRecord } from './lib/driver.mjs';\n    12\timport { parseAdapterRef } from './lib/refs.mjs';\n    13\timport { summarizeProfile } from './lib/profile-summary.mjs';\n    14\t\n    15\tconst { values: a } = parseArgs({ options: {\n    16\t  adapter: { type: 'string' }, workload: { type: 'string', default: 'first' }, size: { type: 'string', default: '3x120' },\n    17\t  charts: { type: 'string' }, out: { type: 'string' }, settle: { type: 'string', default: '500' }, 'no-build': { type: 'boolean', default: false },\n    18\t} });\n    19\tif (!a.adapter) { console.error('usage: node bench/profile.mjs --adapter <ref> [--workload first|page] [--size 1x100000]'); process.exit(2); }\n    20\tconst ref = parseAdapterRef(a.adapter);\n    21\tconst out = path.resolve(a.out ?? path.join(BENCH, 'results/profiles'));\n    22\tfs.mkdirSync(out, { recursive: true });\n    23\tconst params = a.workload === 'page' ? { size: a.size, charts: Number(a.charts ?? 24), gaps: false } : { size: a.size, gaps: false };\n    24\tconst name = `${new Date().toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z')}-${a.workload}-${a.size}-${a.adapter.replace(/[^a-zA-Z0-9.-]+/g, '_')}`;\n    25\tconst file = path.join(out, `${name}.cpuprofile`);\n    26\t\n    27\tif (!a['no-build']) await build();\n    28\tconst browser = await launchBrowser();\n    29\tconst server = await startServer();\n    30\ttry {\n    31\t  const r = await runOnce(browser, server.base, { adapter: ref.id, adapterParams: ref.params, workload: a.workload, params, settleMs: Number(a.settle), timeoutMs: 120000, profile: { file } });\n    32\t  if (r.outcome !== 'ok') { console.error(`run outcome ${r.outcome}: ${r.reason ?? r.error}`); process.exit(1); }\n    33\t  const profile = JSON.parse(fs.readFileSync(file, 'utf8'));\n    34\t  const summary = await summarizeProfile(profile, ref.params.build === 'dev' ? 'dev' : 'prod');\n    35\t  const record = { name, adapter: a.adapter, config: r.result.adapter.config, workload: a.workload, params, profileFile: path.relative(BENCH, file), environment: machineRecord(browser, { headed: false }), page: r.result.env, note: 'profiled run: timings are slowed by the profiler and are not comparable with timed runs', summary };\n    36\t  fs.writeFileSync(path.join(out, `${name}.summary.json`), JSON.stringify(record, null, 1));\n    37\t  console.log(`${name}: ${summary.busyMs} ms busy of ${summary.totalMs} ms (${summary.mapping})`);\n    38\t  for (const s of summary.stages) console.log(`  ${String(s.ofBusy ?? '').padStart(5)}%  ${String(s.ms).padStart(8)} ms  ${s.k}`);\n    39\t} finally {\n    40\t  await browser.close();\n    41\t  await server.close();\n    42\t}\n     1\t// Attributes a Chrome CPU profile (CDP Profiler) of an Axylo run to the library's pipeline stages.\n     2\t//\n     3\t// Each sample is given to the deepest stack frame that is Axylo code (so time in a browser API called by Axylo,\n     4\t// such as a canvas call or a forced layout, counts for the Axylo function that called it). That frame's source\n     5\t// module decides the stage. Samples with no Axylo frame are \"(program)\" (native main-thread work outside\n     6\t// JavaScript: style, layout, paint, compositing setup), \"(garbage collector)\", \"(idle)\", or other JavaScript (the\n     7\t// harness page and anything else).\n     8\t//\n     9\t// Positions are mapped to source modules in two ways:\n    10\t//   development build (axylo.iife.js): esbuild writes \"// packages/axylo/src/<module>.ts\" before each module, so a\n    11\t//     line number gives the module;\n    12\t//   production build (axylo.iife.min.js): the bench rebuilds the same file with the same esbuild options plus a\n    13\t//     source map, checks that the code is byte-identical to the shipped file, and maps line and column through it.\n    14\timport fs from 'node:fs';\n    15\timport path from 'node:path';\n    16\timport { build } from 'esbuild';\n    17\timport { REPO } from '../build.mjs';\n    18\t\n    19\tconst AXYLO_SRC = path.join(REPO, 'packages/axylo/src');\n    20\t\n    21\t/** Directory (or file) under packages/axylo/src -> the pipeline stage named in the M1 brief. */\n    22\texport const STAGE_OF = {\n    23\t  data: 'normalize',\n    24\t  view: 'view', scale: 'view',\n    25\t  layout: 'layout', format: 'layout',\n    26\t  scene: 'scene', simplify: 'scene',\n    27\t  lookup: 'lookup',\n    28\t  reader: 'reader',\n    29\t  render: 'draw',\n    30\t  dom: 'DOM',\n    31\t  theme: 'theme (not one of the eight)',\n    32\t  core: 'orchestration: core/ (chart.ts, options, delivery)',\n    33\t  diagnostics: 'orchestration: diagnostics/',\n    34\t  messages: 'orchestration: messages/',\n    35\t  'index.ts': 'orchestration: index.ts',\n    36\t};\n    37\tconst stageOf = mod => STAGE_OF[mod.split('/')[0]] ?? `other: ${mod}`;\n    38\t\n    39\t/** Line (0-based) -> module path, from the development build's module comments. */\n    40\tfunction devLineMap(file) {\n    41\t  const lines = fs.readFileSync(file, 'utf8').split('\\n');\n    42\t  const starts = [];\n    43\t  lines.forEach((l, i) => { const m = /^\\s*\\/\\/ packages\\/axylo\\/src\\/(.+\\.ts)$/.exec(l); if (m) starts.push([i, m[1]]); });\n    44\t  return line => { let mod = null; for (const [i, m] of starts) { if (i <= line) mod = m; else break; } return mod; };\n    45\t}\n    46\t\n    47\tconst B64 = Object.fromEntries([...'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'].map((c, i) => [c, i]));\n    48\tfunction decodeVlq(str) {\n    49\t  const out = [];\n    50\t  let shift = 0, value = 0;\n    51\t  for (const ch of str) {\n    52\t    const d = B64[ch];\n    53\t    value += (d & 31) << shift;\n    54\t    if (d & 32) shift += 5;\n    55\t    else { out.push(value & 1 ? -(value >>> 1) : value >>> 1); value = 0; shift = 0; }\n    56\t  }\n    57\t  return out;\n    58\t}\n    59\t\n    60\t/** (line, column) -> module path, from a source map; null when the rebuilt file differs from the shipped one. */\n    61\tasync function prodPositionMap(file) {\n    62\t  const res = await build({\n    63\t    entryPoints: [path.join(AXYLO_SRC, 'index.ts')], bundle: true, target: 'es2022', legalComments: 'none', logLevel: 'silent',\n    64\t    format: 'iife', globalName: 'Axylo', minify: true, define: { __DEV__: 'false' }, sourcemap: 'external', write: false,\n    65\t    outfile: path.join(REPO, 'bench/dist/axylo-map/axylo.iife.min.js'), absWorkingDir: REPO,\n    66\t  });\n    67\t  const js = res.outputFiles.find(f => f.path.endsWith('.js')).text;\n    68\t  const map = JSON.parse(res.outputFiles.find(f => f.path.endsWith('.map')).text);\n    69\t  if (js !== fs.readFileSync(file, 'utf8')) return { map: null, note: 'not available: rebuilding packages/axylo/src now does not reproduce the measured production bundle byte for byte (the sources changed after it was built), so its minified positions cannot be mapped; see the development-build profile' };\n    70\t  const sources = map.sources.map(s => { const i = s.indexOf('packages/axylo/src/'); return i >= 0 ? s.slice(i + 'packages/axylo/src/'.length) : s; });\n    71\t  const lines = map.mappings.split(';').map(() => []);\n    72\t  let src = 0;\n    73\t  map.mappings.split(';').forEach((segs, line) => {\n    74\t    let col = 0;\n    75\t    for (const seg of segs.split(',')) {\n    76\t      if (!seg) continue;\n    77\t      const v = decodeVlq(seg);\n    78\t      col += v[0];\n    79\t      if (v.length >= 4) { src += v[1]; lines[line].push([col, src]); }\n    80\t    }\n    81\t  });\n    82\t  return {\n    83\t    map: (line, column) => {\n    84\t      const segs = lines[line];\n    85\t      if (!segs?.length) return null;\n    86\t      let lo = 0, hi = segs.length - 1, best = -1;\n    87\t      while (lo <= hi) { const mid = (lo + hi) >> 1; if (segs[mid][0] <= column) { best = mid; lo = mid + 1; } else hi = mid - 1; }\n    88\t      return best < 0 ? null : sources[segs[best][1]];\n    89\t    },\n    90\t    note: 'production bundle rebuilt with a source map and verified byte-identical to the shipped file',\n    91\t  };\n    92\t}\n    93\t\n    94\texport async function summarizeProfile(profile, build) {\n    95\t  // The snapshot the profiled run loaded (bench/dist/axylo), not whatever packages/axylo/dist holds now.\n    96\t  const file = path.join(REPO, 'bench/dist/axylo', build === 'dev' ? 'axylo.iife.js' : 'axylo.iife.min.js');\n    97\t  let locate, note;\n    98\t  if (build === 'dev') { const f = devLineMap(file); locate = (line) => f(line); note = 'development build, module comments'; }\n    99\t  else { const p = await prodPositionMap(file); note = p.note; locate = p.map; }\n   100\t  const nodes = new Map(profile.nodes.map(n => [n.id, n]));\n   101\t  const parent = new Map();\n   102\t  for (const n of profile.nodes) for (const c of n.children ?? []) parent.set(c, n.id);\n   103\t  const isAxylo = cf => /\\/axylo\\/axylo\\.iife(\\.min)?\\.js/.test(cf.url);\n   104\t  const byStage = {}, byModule = {}, byFunction = {};\n   105\t  let total = 0, inWindow = 0;\n   106\t  const add = (o, k, t) => { o[k] = (o[k] ?? 0) + t; };\n   107\t  profile.samples.forEach((id, i) => {\n   108\t    const t = (profile.timeDeltas[i] ?? 0) / 1000; // ms\n   109\t    total += t;\n   110\t    let n = nodes.get(id), hit = null;\n   111\t    const leaf = n.callFrame.functionName;\n   112\t    for (let cur = id; cur !== undefined; cur = parent.get(cur)) { const node = nodes.get(cur); if (isAxylo(node.callFrame)) { hit = node; break; } }\n   113\t    if (hit) {\n   114\t      const mod = locate ? locate(hit.callFrame.lineNumber, hit.callFrame.columnNumber) : null;\n   115\t      add(byStage, mod ? stageOf(mod) : 'axylo (unmapped)', t);\n   116\t      add(byModule, mod ?? '(unmapped)', t);\n   117\t      add(byFunction, `${hit.callFrame.functionName || '(anonymous)'} @ ${mod ?? '?'}:${hit.callFrame.lineNumber + 1}`, t);\n   118\t    } else if (leaf === '(idle)') add(byStage, '(idle)', t);\n   119\t    else if (leaf === '(program)') add(byStage, '(program): native main-thread work outside JS', t);\n   120\t    else if (leaf === '(garbage collector)') add(byStage, '(garbage collector)', t);\n   121\t    else add(byStage, 'other JavaScript (harness, page)', t);\n   122\t    inWindow++;\n   123\t  });\n   124\t  const busy = total - (byStage['(idle)'] ?? 0);\n   125\t  const table = o => Object.entries(o).sort((a, b) => b[1] - a[1]).map(([k, ms]) => ({ k, ms: +ms.toFixed(2), ofBusy: busy && k !== '(idle)' ? +(100 * ms / busy).toFixed(1) : null }));\n   126\t  return {\n   127\t    build, mapping: note, samples: inWindow, totalMs: +total.toFixed(2), busyMs: +busy.toFixed(2),\n   128\t    stages: table(byStage), modules: table(byModule).slice(0, 25), functions: table(byFunction).slice(0, 25),\n   129\t  };\n   130\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'nl -ba bench/src/page.js; nl -ba bench/src/page.html'","aggregated_output":"     1\t// The benchmark page: one adapter, one workload, chosen by URL parameters.\n     2\t//   ?adapter=uplot&workload=first&params={\"size\":\"1x100000\"}&settle=500&aparams={\"renderer\":\"svg\"}\n     3\t// The runner exposes three bindings: __benchMetrics(label) snapshots CDP Performance.getMetrics in Node and resolves\n     4\t// once the snapshot is taken; __benchMemory(label) forces a garbage collection and records heap and process memory;\n     5\t// __benchDone(result) hands the raw result back. Opened by hand, the page prints the result.\n     6\timport { workloadData, checksum } from './fixtures.js';\n     7\t\n     8\tconst q = new URLSearchParams(location.search);\n     9\tconst adapterId = q.get('adapter');\n    10\tconst workload = q.get('workload');\n    11\tconst params = JSON.parse(q.get('params') ?? '{}');\n    12\tconst settleMs = Number(q.get('settle') ?? 500);\n    13\tconst adapterParams = JSON.parse(q.get('aparams') ?? '{}');\n    14\t// Memory is sampled in the create workloads only, always outside the timed window.\n    15\tconst memoryWanted = (workload === 'first' || workload === 'page') && params.memory !== false;\n    16\t\n    17\t// The binding's reply arrives inside a DevTools command task, and code continuing after `await` would run inside it\n    18\t// (counted as DevToolsCommandDuration, not ScriptDuration). Measured work therefore starts inside the handler of a\n    19\t// fresh task. TaskDuration counts it either way; this only keeps the secondary script/devtools split honest.\n    20\tconst inTask = fn => new Promise((resolve, reject) => {\n    21\t  const c = new MessageChannel();\n    22\t  c.port1.onmessage = () => { try { resolve(fn()); } catch (e) { reject(e); } };\n    23\t  c.port2.postMessage(0);\n    24\t});\n    25\tconst metrics = label => (window.__benchMetrics ? window.__benchMetrics(label) : Promise.resolve());\n    26\tconst memory = label => (window.__benchMemory ? window.__benchMemory(label) : Promise.resolve());\n    27\tconst done = result => {\n    28\t  if (window.__benchDone) window.__benchDone(result);\n    29\t  else document.getElementById('status').textContent = JSON.stringify(result, (k, v) => (Array.isArray(v) && v.length > 20 ? `[${v.length} values]` : v), 1);\n    30\t};\n    31\tconst raf = () => new Promise(r => requestAnimationFrame(r));\n    32\tconst sleep = ms => new Promise(r => setTimeout(r, ms));\n    33\tconst r3 = v => Math.round(v * 1000) / 1000;\n    34\t\n    35\tfunction pageEnvironment() {\n    36\t  let webgl = 'not available: no WebGL context';\n    37\t  try {\n    38\t    const c = document.createElement('canvas');\n    39\t    const gl = c.getContext('webgl2') || c.getContext('webgl');\n    40\t    if (gl) {\n    41\t      const ext = gl.getExtension('WEBGL_debug_renderer_info');\n    42\t      webgl = ext ? gl.getParameter(ext.UNMASKED_RENDERER_WEBGL) : `not available: WEBGL_debug_renderer_info missing (${gl.getParameter(gl.RENDERER)})`;\n    43\t      gl.getExtension('WEBGL_lose_context')?.loseContext();\n    44\t    }\n    45\t  } catch (e) { webgl = `not available: ${e}`; }\n    46\t  return { devicePixelRatio, userAgent: navigator.userAgent, webglRenderer: webgl, viewport: [innerWidth, innerHeight], hardwareConcurrency: navigator.hardwareConcurrency };\n    47\t}\n    48\t\n    49\t// The refresh rate the page observes: median interval of 60 idle animation frames.\n    50\tasync function observeRefresh() {\n    51\t  const ts = [];\n    52\t  await new Promise(res => { const f = t => { ts.push(t); if (ts.length < 61) requestAnimationFrame(f); else res(); }; requestAnimationFrame(f); });\n    53\t  const d = ts.slice(1).map((t, i) => t - ts[i]).sort((a, b) => a - b);\n    54\t  const median = d[d.length >> 1];\n    55\t  return { medianIntervalMs: r3(median), hz: r3(1000 / median), minMs: r3(d[0]), maxMs: r3(d[d.length - 1]) };\n    56\t}\n    57\t\n    58\tfunction loadScript(src) {\n    59\t  return new Promise(res => {\n    60\t    const s = document.createElement('script');\n    61\t    s.src = src;\n    62\t    s.onload = () => res();\n    63\t    s.onerror = () => { window.__axyloLoadError = `could not load ${src}`; res(); };\n    64\t    document.head.appendChild(s);\n    65\t  });\n    66\t}\n    67\t\n    68\tfunction containers(count, grid, resizable) {\n    69\t  const root = document.getElementById('root');\n    70\t  const parent = grid || resizable ? Object.assign(document.createElement('div'), { className: `${grid ? 'grid' : ''} ${resizable ? 'resize-box' : ''}`.trim() }) : root;\n    71\t  if (parent !== root) root.appendChild(parent);\n    72\t  const els = Array.from({ length: count }, () => parent.appendChild(Object.assign(document.createElement('div'), { className: 'chart' })));\n    73\t  return { els, box: parent };\n    74\t}\n    75\t\n    76\t// Calculated, not measured: bytes a 4-byte-per-pixel backing store needs for every canvas on the page (canvas.width\n    77\t// and canvas.height are device pixels, so the pixel ratio is already in them). The browser may hold more (double\n    78\t// buffering, GPU copies) or less (canvases not yet drawn); the process figures are the measured ones.\n    79\tfunction canvasBacking() {\n    80\t  const root = document.getElementById('root');\n    81\t  let chart = 0, other = 0, count = 0;\n    82\t  for (const c of document.querySelectorAll('canvas')) {\n    83\t    const bytes = c.width * c.height * 4;\n    84\t    if (root.contains(c)) { chart += bytes; count++; } else other += bytes;\n    85\t  }\n    86\t  return { chartCanvasBytes: chart, chartCanvasCount: count, otherCanvasBytes: other, svgElements: root.querySelectorAll('svg').length, svgPaths: root.querySelectorAll('svg path').length, domNodes: root.getElementsByTagName('*').length };\n    87\t}\n    88\t\n    89\t// W-first and W-page: from the create call until a fixed settle window after every chart reports ready.\n    90\tasync function runCreate(adapter, fixtures, els) {\n    91\t  await metrics('create:start');\n    92\t  const { t0, handles, tSync } = await inTask(() => {\n    93\t    const t0 = performance.now();\n    94\t    const handles = fixtures.map((f, i) => adapter.create(els[i], f, { params: adapterParams }));\n    95\t    return { t0, handles, tSync: performance.now() };\n    96\t  });\n    97\t  await Promise.all(handles.map(h => h.ready));\n    98\t  const tReady = performance.now();\n    99\t  await raf();\n   100\t  const tReadyFrame = performance.now();\n   101\t  await sleep(settleMs);\n   102\t  await metrics('create:end');\n   103\t  const tEnd = performance.now();\n   104\t  const backing = canvasBacking();\n   105\t  if (memoryWanted) await memory('chart');\n   106\t  return {\n   107\t    timing: { syncMs: r3(tSync - t0), readyMs: r3(tReady - t0), readyFrameMs: r3(tReadyFrame - t0), windowMs: r3(tEnd - t0), settleMs },\n   108\t    canvasBacking: backing,\n   109\t    describe: handles.map(h => h.describe()),\n   110\t  };\n   111\t}\n   112\t\n   113\t// The producer: a worker with its own timers, so samples are due on a 60 Hz schedule whatever the page's main\n   114\t// thread and animation frames are doing. It sends the sequence number, the scheduled time and the send time, both\n   115\t// converted to the page's time base.\n   116\tconst PRODUCER = `\n   117\tonmessage = e => {\n   118\t  const { startAt, pageOrigin, period, count } = e.data;\n   119\t  const shift = pageOrigin - performance.timeOrigin; // page time = worker time - shift\n   120\t  const t0 = startAt + shift;\n   121\t  let k = 0;\n   122\t  const tick = () => {\n   123\t    const now = performance.now();\n   124\t    while (k < count && t0 + k * period <= now) { postMessage({ seq: k, due: t0 + k * period - shift, sent: now - shift }); k++; }\n   125\t    if (k < count) setTimeout(tick, Math.max(0, t0 + k * period - performance.now()));\n   126\t  };\n   127\t  setTimeout(tick, Math.max(0, t0 - performance.now()));\n   128\t};`;\n   129\t\n   130\t// W-stream: a window chart fed by the producer. Visibility is read from the chart's own draw record\n   131\t// (adapter.drawnNewestX), in an animation-frame callback registered after the append that needs it, so it runs\n   132\t// after any frame callback the library itself registered for that append.\n   133\tasync function runStream(adapter, fix, el) {\n   134\t  const N = fix.samples, period = 1000 / 60;\n   135\t  await metrics('create:start');\n   136\t  const handle = await inTask(() => adapter.create(el, { x: fix.initial.x, ys: fix.initial.ys, names: fix.names }, { window: fix.window, params: adapterParams }));\n   137\t  await handle.ready;\n   138\t  await sleep(settleMs);\n   139\t  await metrics('create:end');\n   140\t\n   141\t  const due = new Float64Array(N).fill(NaN), sent = new Float64Array(N).fill(NaN), received = new Float64Array(N).fill(NaN);\n   142\t  const visible = new Float64Array(N).fill(NaN), visibleFrame = new Float64Array(N).fill(NaN), appendMs = new Float64Array(N).fill(NaN);\n   143\t  const x0 = fix.stream.x[0];\n   144\t  const frames = [];\n   145\t  let receivedCount = 0, visibleCount = 0, coalesced = 0, framesWithNew = 0, maxBacklog = 0, readerPending = false, pacing = true;\n   146\t  let prevFrameNow = NaN, startAt = NaN;\n   147\t  let finish;\n   148\t  const finished = new Promise(r => { finish = r; });\n   149\t  const dueBy = t => Math.max(0, Math.min(N, Math.floor((t - startAt) / period) + 1));\n   150\t\n   151\t  // Frame pacing loop. Its callback runs first in each frame (registered earliest), so it accounts the previous\n   152\t  // frame: by then that frame's visibility has been read.\n   153\t  const pace = ts => {\n   154\t    if (!Number.isNaN(prevFrameNow)) maxBacklog = Math.max(maxBacklog, dueBy(prevFrameNow) - visibleCount);\n   155\t    prevFrameNow = performance.now();\n   156\t    frames.push(ts);\n   157\t    if (pacing) requestAnimationFrame(pace);\n   158\t  };\n   159\t  const reader = ts => {\n   160\t    readerPending = false;\n   161\t    const now = performance.now();\n   162\t    const newest = handle.drawnNewestX();\n   163\t    const upto = Math.min(N - 1, Math.round((newest - x0) / fix.step));\n   164\t    let k = 0;\n   165\t    while (visibleCount <= upto) { visible[visibleCount] = now; visibleFrame[visibleCount] = ts; visibleCount++; k++; }\n   166\t    if (k) { framesWithNew++; coalesced += k - 1; }\n   167\t    if (visibleCount === N) finish('all visible');\n   168\t    else if (visibleCount < receivedCount) { readerPending = true; requestAnimationFrame(reader); }\n   169\t  };\n   170\t\n   171\t  const worker = new Worker(URL.createObjectURL(new Blob([PRODUCER], { type: 'text/javascript' })));\n   172\t  worker.onmessage = e => {\n   173\t    const { seq, due: d, sent: s } = e.data;\n   174\t    received[seq] = performance.now(); due[seq] = d; sent[seq] = s; receivedCount++;\n   175\t    const a = performance.now();\n   176\t    handle.append(fix.stream.x[seq], [fix.stream.y[seq]]);\n   177\t    appendMs[seq] = performance.now() - a;\n   178\t    if (!readerPending) { readerPending = true; requestAnimationFrame(reader); }\n   179\t  };\n   180\t\n   181\t  await metrics('stream:start');\n   182\t  await inTask(() => {\n   183\t    requestAnimationFrame(pace);\n   184\t    startAt = performance.now() + 50;\n   185\t    worker.postMessage({ startAt, pageOrigin: performance.timeOrigin, period, count: N });\n   186\t  });\n   187\t  const lastDue = startAt + (N - 1) * period;\n   188\t  const timer = setInterval(() => { if (performance.now() > lastDue + 5000) finish('timeout: not every sample became visible within 5 s of the last one'); }, 250);\n   189\t  const how = await finished;\n   190\t  clearInterval(timer);\n   191\t  const tEnd = performance.now();\n   192\t  await metrics('stream:end');\n   193\t  pacing = false;\n   194\t  worker.terminate();\n   195\t  return {\n   196\t    stream: {\n   197\t      samples: N, periodMs: r3(period), startAt: r3(startAt), endAt: r3(tEnd), ended: how,\n   198\t      receivedCount, visibleCount, neverVisible: N - visibleCount, coalesced, framesWithNew, maxBacklog,\n   199\t      due: Array.from(due, r3), sent: Array.from(sent, r3), received: Array.from(received, r3),\n   200\t      visible: Array.from(visible, r3), visibleFrame: Array.from(visibleFrame, r3), appendMs: Array.from(appendMs, r3),\n   201\t      frames: frames.map(r3),\n   202\t    },\n   203\t    timing: { settleMs },\n   204\t    describe: [handle.describe()],\n   205\t  };\n   206\t}\n   207\t\n   208\t// ── theme ───────────────────────────────────────────────────────────────────────────────────────\n   209\t// What the marks look like, independent of the library: the computed stroke of every SVG path, and the most\n   210\t// frequent fully opaque colors of every canvas, read from a copy (the chart's own canvas is never read back, so\n   211\t// the browser has no reason to move it off the GPU path).\n   212\tfunction markSignature(el) {\n   213\t  const parts = [];\n   214\t  const strokes = new Set();\n   215\t  for (const p of el.querySelectorAll('svg path, svg polyline, svg line')) {\n   216\t    const st = getComputedStyle(p).stroke;\n   217\t    if (st && st !== 'none') strokes.add(st);\n   218\t  }\n   219\t  if (strokes.size) parts.push(`svg:${[...strokes].sort().join('|')}`);\n   220\t  for (const c of el.querySelectorAll('canvas')) {\n   221\t    if (!c.width || !c.height) continue;\n   222\t    const copy = document.createElement('canvas');\n   223\t    copy.width = c.width; copy.height = c.height;\n   224\t    const ctx = copy.getContext('2d', { willReadFrequently: true });\n   225\t    ctx.drawImage(c, 0, 0);\n   226\t    const d = ctx.getImageData(0, 0, c.width, c.height).data;\n   227\t    const hist = new Map();\n   228\t    for (let i = 0; i < d.length; i += 4) {\n   229\t      if (d[i + 3] !== 255) continue;\n   230\t      const k = (d[i] << 16) | (d[i + 1] << 8) | d[i + 2];\n   231\t      hist.set(k, (hist.get(k) ?? 0) + 1);\n   232\t    }\n   233\t    const top = [...hist.entries()].sort((a, b) => b[1] - a[1]).slice(0, 4).map(([k]) => `#${k.toString(16).padStart(6, '0')}`).sort();\n   234\t    parts.push(`canvas:${top.join('|')}`);\n   235\t  }\n   236\t  return parts.join(' ');\n   237\t}\n   238\t\n   239\t// Counts drawing work during a window: Canvas 2D calls that put pixels down, and DOM mutation records inside the\n   240\t// chart. Counting adds one increment per call and one observer callback per batch, the same for every adapter.\n   241\tfunction workCounter(el) {\n   242\t  const names = ['stroke', 'fill', 'fillRect', 'strokeRect', 'fillText', 'strokeText', 'clearRect', 'drawImage', 'putImageData'];\n   243\t  const proto = CanvasRenderingContext2D.prototype;\n   244\t  const saved = {};\n   245\t  const counts = { canvasCalls: 0, mutations: 0 };\n   246\t  for (const n of names) {\n   247\t    saved[n] = proto[n];\n   248\t    proto[n] = function (...args) { counts.canvasCalls++; return saved[n].apply(this, args); };\n   249\t  }\n   250\t  const mo = new MutationObserver(records => { counts.mutations += records.length; });\n   251\t  mo.observe(el, { subtree: true, attributes: true, childList: true, characterData: true });\n   252\t  return {\n   253\t    take() { const t = { ...counts, mutations: counts.mutations + mo.takeRecords().length }; counts.canvasCalls = 0; counts.mutations = 0; return t; },\n   254\t    stop() { for (const n of names) proto[n] = saved[n]; mo.disconnect(); },\n   255\t  };\n   256\t}\n   257\t\n   258\t// W-theme: toggle a class-based dark theme on <html> and measure main-thread task time per toggle, over a fixed\n   259\t// window of three animation frames plus 50 ms (Axylo promises the repaint within one frame, spec L4). The marks'\n   260\t// colors are checked after each window. How many frames the change took is measured in separate, untimed toggles\n   261\t// afterwards, because sampling pixels in every frame would add readback work to the measured window.\n   262\tasync function runTheme(adapter, fix, el) {\n   263\t  const toggles = params.toggles ?? 20;\n   264\t  await metrics('create:start');\n   265\t  const handle = await inTask(() => adapter.create(el, fix, { params: adapterParams }));\n   266\t  await handle.ready;\n   267\t  await sleep(settleMs);\n   268\t  await metrics('create:end');\n   269\t  const html = document.documentElement;\n   270\t  const signatures = [markSignature(el)];\n   271\t  const work = [];\n   272\t  const counter = workCounter(el);\n   273\t  for (let i = 0; i < toggles; i++) {\n   274\t    counter.take();\n   275\t    await metrics(`toggle${i}:start`);\n   276\t    await inTask(() => html.classList.toggle('bench-dark'));\n   277\t    await raf(); await raf(); await raf();\n   278\t    await sleep(50);\n   279\t    await metrics(`toggle${i}:end`);\n   280\t    work.push(counter.take());\n   281\t    signatures.push(markSignature(el));\n   282\t  }\n   283\t  counter.stop();\n   284\t  const reasons = [];\n   285\t  const light = signatures[0], dark = signatures[1];\n   286\t  if (light === dark) reasons.push(`marks did not change color on the first toggle (${light})`);\n   287\t  signatures.forEach((sig, i) => { const want = i % 2 ? dark : light; if (sig !== want) reasons.push(`after ${i} toggles the marks show ${sig}, expected ${want}`); });\n   288\t  // Latency: untimed toggles, the marks sampled after every frame until they change (at most 10 frames).\n   289\t  const framesToChange = [];\n   290\t  for (let i = 0; i < 4; i++) {\n   291\t    const before = markSignature(el);\n   292\t    html.classList.toggle('bench-dark');\n   293\t    // Let mutation observers (where a library notices the toggle) run first, so a frame callback the library\n   294\t    // registers in response comes before this sampler's in the same frame.\n   295\t    await Promise.resolve();\n   296\t    let n = 0, changed = false;\n   297\t    while (n < 10 && !changed) { await raf(); n++; changed = markSignature(el) !== before; }\n   298\t    framesToChange.push(changed ? n : null);\n   299\t  }\n   300\t  if (html.classList.contains('bench-dark')) html.classList.remove('bench-dark');\n   301\t  return {\n   302\t    theme: { toggles, windowFrames: 3, windowExtraMs: 50, work, signatures: [...new Set(signatures)], framesToChange },\n   303\t    themeCheck: { ok: reasons.length === 0, reasons: reasons.slice(0, 5) },\n   304\t    timing: { settleMs },\n   305\t    describe: [handle.describe()],\n   306\t  };\n   307\t}\n   308\t\n   309\t// ── resize ──────────────────────────────────────────────────────────────────────────────────────\n   310\t// W-resize: the box holding the chart(s) is animated 1,200 -> 400 -> 1,200 px over 2 s, one width per animation\n   311\t// frame, linear in time. Task time and frame intervals are recorded over the animation; afterwards every chart\n   312\t// must fill its container's new width (its widest canvas or svg within 90-100% of the container).\n   313\tasync function runResize(adapter, fixtures, els, box) {\n   314\t  const duration = params.durationMs ?? 2000, wide = 1200, narrow = 400;\n   315\t  await metrics('create:start');\n   316\t  const handles = await inTask(() => fixtures.map((f, i) => adapter.create(els[i], f, { params: adapterParams, resize: true })));\n   317\t  await Promise.all(handles.map(h => h.ready));\n   318\t  await sleep(settleMs);\n   319\t  await metrics('create:end');\n   320\t  const frames = [], widths = [];\n   321\t  await metrics('resize:start');\n   322\t  let startAt = NaN;\n   323\t  await new Promise(resolve => {\n   324\t    let after = 0;\n   325\t    const step = ts => {\n   326\t      if (Number.isNaN(startAt)) startAt = performance.now();\n   327\t      const t = performance.now() - startAt;\n   328\t      const half = duration / 2;\n   329\t      const w = t < half ? wide - (wide - narrow) * t / half : t < duration ? narrow + (wide - narrow) * (t - half) / half : wide;\n   330\t      box.style.width = `${w}px`;\n   331\t      frames.push(ts); widths.push(Math.round(w));\n   332\t      if (t >= duration) after++;\n   333\t      if (after > 2) resolve(); else requestAnimationFrame(step);\n   334\t    };\n   335\t    inTask(() => requestAnimationFrame(step));\n   336\t  });\n   337\t  const endAt = performance.now();\n   338\t  await Promise.all(handles.map(h => h.ready));\n   339\t  await metrics('resize:end');\n   340\t  await sleep(settleMs);\n   341\t  const reasons = [];\n   342\t  els.forEach((el, i) => {\n   343\t    const cw = el.clientWidth;\n   344\t    let widest = 0;\n   345\t    for (const g of el.querySelectorAll('canvas, svg')) widest = Math.max(widest, g.getBoundingClientRect().width);\n   346\t    if (!(widest >= 0.9 * cw && widest <= cw + 1)) reasons.push(`chart ${i}: widest canvas/svg is ${widest.toFixed(1)} px in a ${cw} px container after the resize`);\n   347\t  });\n   348\t  return {\n   349\t    resize: { durationMs: duration, from: wide, to: narrow, startAt: r3(startAt), endAt: r3(endAt), frames: frames.map(r3), widths },\n   350\t    resizeCheck: { ok: reasons.length === 0, reasons: reasons.slice(0, 5) },\n   351\t    timing: { settleMs },\n   352\t    describe: handles.map(h => h.describe()),\n   353\t  };\n   354\t}\n   355\t\n   356\tasync function main() {\n   357\t  const env = pageEnvironment();\n   358\t  // A computed URL keeps esbuild from bundling every adapter into the page; each run loads only its own.\n   359\t  const adapterUrl = new URL(`./adapters/${encodeURIComponent(adapterId)}.js`, location.href).href;\n   360\t  const adapter = (await import(adapterUrl)).default;\n   361\t  await adapter.load?.(adapterParams);\n   362\t  const meta = { id: adapter.id, library: adapter.library, version: adapter.version, config: adapter.configFor?.(adapterParams) ?? adapter.config, params: adapter.resolvedParams?.(adapterParams) ?? adapterParams, floor: !!adapter.floor };\n   363\t  const avail = adapter.available();\n   364\t  if (!avail.ok) return done({ outcome: 'not-available', reason: avail.reason, adapter: meta, env });\n   365\t  adapter.setup?.(adapterParams);\n   366\t  if (memoryWanted) await memory('blank');\n   367\t  const fixtures = workloadData(workload, params);\n   368\t  const sum = checksum(fixtures);\n   369\t  const { els, box } = containers(fixtures.length, workload === 'page' || (workload === 'resize' && fixtures.length > 1), workload === 'resize');\n   370\t  env.refresh = await observeRefresh();\n   371\t  await raf(); await raf(); // layout of the empty containers is done before the clock starts\n   372\t  if (memoryWanted) await memory('data');\n   373\t  let result;\n   374\t  try {\n   375\t    result = workload === 'stream' ? await runStream(adapter, fixtures[0], els[0])\n   376\t      : workload === 'theme' ? await runTheme(adapter, fixtures[0], els[0])\n   377\t      : workload === 'resize' ? await runResize(adapter, fixtures, els, box)\n   378\t      : await runCreate(adapter, fixtures, els);\n   379\t  } catch (e) {\n   380\t    if (e?.benchNotAdmitted) return done({ outcome: 'not-admitted', reason: e.message, adapter: meta, env, checksum: sum });\n   381\t    throw e;\n   382\t  }\n   383\t  done({ outcome: 'ok', adapter: meta, env, checksum: sum, ...result });\n   384\t}\n   385\t\n   386\tmain().catch(e => done({ outcome: 'error', error: String(e?.stack ?? e) }));\n     1\t<!doctype html>\n     2\t<html lang=\"en\">\n     3\t<head>\n     4\t<meta charset=\"utf-8\">\n     5\t<title>Axylo bench</title>\n     6\t<link rel=\"icon\" href=\"data:,\">\n     7\t<style>\n     8\t  html, body { margin: 0; background: #fff; color: #111; font: 12px system-ui, sans-serif; }\n     9\t  #root { padding: 8px; }\n    10\t  /* 2:1 containers: Chart.js's default aspect ratio is 2:1, so every library fills the same area. */\n    11\t  .chart { width: 800px; height: 400px; overflow: hidden; position: relative; }\n    12\t  .grid { display: grid; grid-template-columns: repeat(6, 230px); gap: 6px; }\n    13\t  .grid .chart { width: 230px; height: 115px; }\n    14\t  /* resize workload: the box's width is animated; charts fill it */\n    15\t  .resize-box { width: 1200px; }\n    16\t  .resize-box > .chart { width: 100%; height: 400px; }\n    17\t  .resize-box.grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }\n    18\t  .resize-box.grid > .chart { width: auto; height: 115px; }\n    19\t  /* theme workload: a class-toggled dark theme on <html>, as a page would ship it (spec L4) */\n    20\t  html.bench-dark, html.bench-dark body { color-scheme: dark; background: #111; color: #eee; }\n    21\t  #status { white-space: pre-wrap; font-family: monospace; }\n    22\t</style>\n    23\t</head>\n    24\t<body>\n    25\t<div id=\"root\"></div>\n    26\t<div id=\"status\"></div>\n    27\t<script type=\"module\" src=\"./page.js\"></script>\n    28\t</body>\n    29\t</html>\n","exit_code":0,"status":"completed"}}
