{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc \"for f in bench/src/adapters/*.js; do printf '\\\\n%s\\\\n' \\\"\"'$f\"; nl -ba \"$f\"; done'","aggregated_output":"\nbench/src/adapters/axylo-canvas.js\n     1\t// Axylo, Canvas 2D mark renderer, production build. See axylo-common.js.\n     2\timport { axyloAdapter } from './axylo-common.js';\n     3\texport default axyloAdapter('axylo-canvas', { renderer: 'canvas' });\n\nbench/src/adapters/axylo-common.js\n     1\t// Axylo, default options, from a script-tag build loaded as a classic script (the file users would load).\n     2\t//\n     3\t// Adapter parameters (runner: --baseline axylo:renderer=svg,build=dev; or the fixed axylo-canvas / axylo-svg):\n     4\t//   renderer  'canvas' (default) | 'svg'   selects the mark renderer through Axylo's internal `__renderer` option,\n     5\t//                                           which exists for the M1 renderer comparison only\n     6\t//   build     'prod' (default) | 'dev'     prod = packages/axylo/dist/axylo.iife.min.js (__DEV__ = false);\n     7\t//                                           dev = axylo.iife.js (__DEV__ = true), used only to attribute profiles\n     8\t//\n     9\t// The chart is created from typed columns as the spec's Data type allows: x as epoch milliseconds declared\n    10\t// `type: 'time'` in UTC, one wide y column per series. Every other option is Axylo's default.\n    11\t//\n    12\t// Readiness and readback come from Axylo's benchmark hook (plan 04, 3.1). The production build exposes it only when\n    13\t// `globalThis.__AXYLO_BENCH__` is true when the chart is created; load() sets it before the script runs.\n    14\t//   chart.__bench.ready()     resolves after the animation frame that drew the latest accepted revision\n    15\t//   chart.__bench.describe()  the committed view and frame: { xDomain, yDomain, series: [{ points, oldestX,\n    16\t//                             newestX, missing }] } (points = slots the series holds, missing = slots that are\n    17\t//                             not a finite value)\n    18\t// If the hook is absent the adapter reports \"not admitted\" rather than guessing readiness.\n    19\t// Streaming uses chart.append(rows, { keep: window }), the spec's API for a moving window.\n    20\t\n    21\tconst NO_HOOK = 'this Axylo build has no benchmark hook (chart.__bench); use a development build or set __AXYLO_BENCH__';\n    22\tconst FILES = { prod: './axylo/axylo.iife.min.js', dev: './axylo/axylo.iife.js' };\n    23\t\n    24\tconst resolve = (fixed, params) => {\n    25\t  const p = { renderer: 'canvas', build: 'prod', ...params, ...fixed };\n    26\t  if (!['canvas', 'svg'].includes(p.renderer)) throw new Error(`axylo: renderer must be canvas or svg, got ${p.renderer}`);\n    27\t  if (!FILES[p.build]) throw new Error(`axylo: build must be prod or dev, got ${p.build}`);\n    28\t  return p;\n    29\t};\n    30\t\n    31\tfunction loadScript(src) {\n    32\t  return new Promise(res => {\n    33\t    const s = document.createElement('script');\n    34\t    s.src = src;\n    35\t    s.onload = () => res(null);\n    36\t    s.onerror = () => res(`could not load ${src}`);\n    37\t    document.head.appendChild(s);\n    38\t  });\n    39\t}\n    40\t\n    41\texport function axyloAdapter(id, fixed = {}) {\n    42\t  let loadError = null;\n    43\t  return {\n    44\t    id,\n    45\t    library: 'Axylo',\n    46\t    version: __VERSIONS__.axylo,\n    47\t    config: 'default',\n    48\t    configFor: params => { const p = resolve(fixed, params); return `default options, ${p.renderer} mark renderer, ${p.build === 'prod' ? 'production build (axylo.iife.min.js)' : 'DEVELOPMENT build (axylo.iife.js)'}`; },\n    49\t    resolvedParams: params => resolve(fixed, params),\n    50\t    async load(params) {\n    51\t      const p = resolve(fixed, params);\n    52\t      globalThis.__AXYLO_BENCH__ = true;\n    53\t      loadError = await loadScript(FILES[p.build]);\n    54\t    },\n    55\t    available() {\n    56\t      const A = globalThis.Axylo;\n    57\t      if (!A) return { ok: false, reason: loadError ?? 'the Axylo script did not define the Axylo global' };\n    58\t      if (typeof A.line !== 'function') return { ok: false, reason: 'the Axylo build does not export line()' };\n    59\t      return { ok: true };\n    60\t    },\n    61\t    create(el, fix, opts = {}) {\n    62\t      const p = resolve(fixed, opts.params);\n    63\t      const columns = { t: fix.x };\n    64\t      fix.names.forEach((n, i) => { columns[n] = fix.ys[i]; });\n    65\t      const chart = globalThis.Axylo.line(el, {\n    66\t        data: { columns }, x: { field: 't', type: 'time', timeZone: 'UTC' }, y: fix.names, title: 'Benchmark',\n    67\t        ...(p.renderer === 'svg' ? { __renderer: 'svg' } : {}),\n    68\t      });\n    69\t      const hook = chart.__bench;\n    70\t      let ready;\n    71\t      if (hook) ready = hook.ready();\n    72\t      else {\n    73\t        ready = Promise.reject(Object.assign(new Error(NO_HOOK), { benchNotAdmitted: true }));\n    74\t        ready.catch(() => {}); // the page reads the reason; avoid an unhandled-rejection report\n    75\t      }\n    76\t      let drawnNewest = NaN;\n    77\t      // The newest x the chart had when it last drew. ready() resolves in the frame that drew, before the page's\n    78\t      // visibility reader (registered after the append) runs in that frame.\n    79\t      const record = () => {\n    80\t        const s = hook?.describe().series[0];\n    81\t        if (s) drawnNewest = s.newestX;\n    82\t      };\n    83\t      void Promise.resolve(ready).then(record, () => {});\n    84\t      return {\n    85\t        chart,\n    86\t        ready: { then: (a, b) => (hook ? hook.ready() : ready).then(a, b) }, // re-evaluated: the page may await it again after a resize\n    87\t        append(x, ys) {\n    88\t          const row = { t: x };\n    89\t          fix.names.forEach((n, i) => { row[n] = ys[i] === ys[i] ? ys[i] : null; });\n    90\t          chart.append([row], { keep: opts.window });\n    91\t          hook?.ready().then(record);\n    92\t        },\n    93\t        drawnNewestX: () => drawnNewest,\n    94\t        describe() {\n    95\t          if (!hook) return null;\n    96\t          const d = hook.describe();\n    97\t          return {\n    98\t            reads: 'Axylo chart.__bench.describe(): committed view xDomain/yDomain; per series slots held, first and last x, non-value slots',\n    99\t            x: d.xDomain, y: d.yDomain,\n   100\t            series: d.series.map(s => ({ points: s.points, oldestX: s.oldestX, newestX: s.newestX, missing: s.missing })),\n   101\t          };\n   102\t        },\n   103\t        destroy: () => chart.destroy(),\n   104\t      };\n   105\t    },\n   106\t  };\n   107\t}\n\nbench/src/adapters/axylo-svg.js\n     1\t// Axylo, SVG mark renderer, production build. See axylo-common.js.\n     2\timport { axyloAdapter } from './axylo-common.js';\n     3\texport default axyloAdapter('axylo-svg', { renderer: 'svg' });\n\nbench/src/adapters/axylo.js\n     1\t// Axylo with adapter parameters (renderer, build); see axylo-common.js. Default: canvas, production build.\n     2\timport { axyloAdapter } from './axylo-common.js';\n     3\texport default axyloAdapter('axylo');\n\nbench/src/adapters/chartjs-common.js\n     1\t// Chart.js plumbing shared by the starter-default and tuned adapters: readiness, the draw record used by the\n     2\t// streaming workload, and the readback for the admission check.\n     3\timport { Chart, animator } from 'chart.js/auto';\n     4\timport 'chartjs-adapter-date-fns'; // a date adapter must be registered before a time scale works\n     5\t\n     6\texport { Chart };\n     7\t\n     8\t/** Instrumentation plugin, identical in both configurations. It changes nothing that is drawn. */\n     9\texport function benchPlugin(state, newestOf) {\n    10\t  return {\n    11\t    id: 'axyloBench',\n    12\t    // Chart.js notifies afterRender once a render has finished, including its animation (onAnimationsComplete).\n    13\t    afterRender: chart => { if (!animator.running(chart)) state.readyResolve(); },\n    14\t    afterDraw: chart => { state.drawnNewest = newestOf(chart); },\n    15\t  };\n    16\t}\n    17\t\n    18\texport function handleFor(chart, state, append, heldData) {\n    19\t  return {\n    20\t    chart,\n    21\t    ready: state.ready,\n    22\t    append,\n    23\t    drawnNewestX: () => state.drawnNewest,\n    24\t    // Reads Chart.js's own objects, not the fixture:\n    25\t    //   x range  chart.scales.x.min / max  (time scale: epoch milliseconds)\n    26\t    //   y range  chart.scales.y.min / max\n    27\t    //   per series: the data the chart holds, from heldData(chart, i): the parsed points (meta._parsed) for the\n    28\t    //   starter config, and for the tuned config dataset._data when the decimation plugin has replaced\n    29\t    //   dataset.data with its decimated copy, else dataset.data. Points, first and last x, and the number of\n    30\t    //   points whose y is null or NaN (Chart.js skips both).\n    31\t    //   drawnPoints (not checked) is meta.data.length, the point elements Chart.js laid out.\n    32\t    describe() {\n    33\t      return {\n    34\t        reads: 'Chart.js chart.scales.x/y.{min,max}; held points per dataset; meta.data.length',\n    35\t        x: [chart.scales.x.min, chart.scales.x.max],\n    36\t        y: [chart.scales.y.min, chart.scales.y.max],\n    37\t        series: chart.data.datasets.map((_, i) => {\n    38\t          const pts = heldData(chart, i);\n    39\t          let missing = 0;\n    40\t          for (let k = 0; k < pts.length; k++) { const y = pts[k].y; if (y == null || y !== y) missing++; }\n    41\t          return { points: pts.length, oldestX: pts[0]?.x, newestX: pts[pts.length - 1]?.x, missing, drawnPoints: chart.getDatasetMeta(i).data.length };\n    42\t        }),\n    43\t      };\n    44\t    },\n    45\t    destroy: () => chart.destroy(),\n    46\t  };\n    47\t}\n    48\t\n    49\texport function newState() {\n    50\t  const state = { drawnNewest: NaN };\n    51\t  state.ready = new Promise(r => { state.readyResolve = r; });\n    52\t  return state;\n    53\t}\n    54\t\n    55\texport function canvasIn(el) {\n    56\t  const c = document.createElement('canvas');\n    57\t  el.appendChild(c);\n    58\t  return c;\n    59\t}\n\nbench/src/adapters/chartjs-tuned.js\n     1\t// Chart.js, tuned, keeping the same visible features as the starter default: time x axis, y axis, legend, tooltip.\n     2\t//\n     3\t// Every option that differs from chartjs.js, with the reason and the page that recommends it\n     4\t// (https://www.chartjs.org/docs/latest/general/performance.html unless noted):\n     5\t//   animation: false            \"Disable animations\": no entry or update animation, so a create or an update is\n     6\t//                               one render. Visible difference: the line appears without the entry animation.\n     7\t//   parsing: false, data as     \"Data structure and format\": skip parsing; data handed in Chart.js's internal\n     8\t//   {x, y} with numeric x       format. Required for the decimation plugin.\n     9\t//   normalized: true            \"Data normalization\": the fixture's x is unique, sorted and consistent across\n    10\t//                               datasets, so Chart.js may skip checking it.\n    11\t//   plugins.decimation:         \"Data decimation\" (docs/latest/configuration/decimation.html). min-max keeps each\n    12\t//     { enabled, 'min-max' }    pixel column's lowest and highest point, so spikes such as the injected extreme stay.\n    13\t//                               Active only above 4x the canvas width in points. Known fidelity risk: min-max skips\n    14\t//                               NaN values, so above that threshold a gap can be drawn across; the admission check\n    15\t//                               reads the held data (dataset._data), not the decimated copy, and does not catch this.\n    16\t//   elements.point.radius: 0    \"Disable point drawing\" (elements.point.radius / pointRadius). Visible difference:\n    17\t//                               no point markers, which on 3x120 are visible dots and on 10k+ points a solid band.\n    18\t//   interaction: { mode:        keeps the tooltip reachable without markers: with the default intersect: true and\n    19\t//     'nearest', axis: 'x',     radius 0 the pointer must hit a 1 px target (docs/latest/configuration/interactions.html).\n    20\t//     intersect: false }\n    21\t// Not applied: fixed scale min/max and ticks.sampleSize / rotation limits (\"Specify min and max for scales\",\n    22\t// \"Disable ticks rotation\") because they need knowledge of the data or change the axis labels.\n    23\t//\n    24\t// Input: one {x, y} object per point is built from the typed columns inside the timed work; Chart.js has no typed\n    25\t// column input. Streaming pushes and shifts the same array and calls chart.update('none').\n    26\timport { Chart, benchPlugin, handleFor, newState, canvasIn } from './chartjs-common.js';\n    27\t\n    28\tconst held = (chart, i) => { const d = chart.data.datasets[i]; return d._data ?? d.data; };\n    29\tconst newestHeld = chart => { const d = held(chart, 0); return d[d.length - 1]?.x; };\n    30\t\n    31\texport default {\n    32\t  id: 'chartjs-tuned',\n    33\t  library: 'Chart.js',\n    34\t  version: __VERSIONS__['chart.js'],\n    35\t  config: 'tuned, same visible features',\n    36\t  available: () => ({ ok: true }),\n    37\t  create(el, fix) {\n    38\t    const state = newState();\n    39\t    const n = fix.x.length;\n    40\t    const arrays = fix.ys.map(col => {\n    41\t      const pts = new Array(n);\n    42\t      for (let k = 0; k < n; k++) pts[k] = { x: fix.x[k], y: col[k] };\n    43\t      return pts;\n    44\t    });\n    45\t    const chart = new Chart(canvasIn(el), {\n    46\t      type: 'line',\n    47\t      data: { datasets: arrays.map((data, i) => ({ label: fix.names[i], data })) },\n    48\t      options: {\n    49\t        animation: false,\n    50\t        parsing: false,\n    51\t        normalized: true,\n    52\t        elements: { point: { radius: 0 } },\n    53\t        interaction: { mode: 'nearest', axis: 'x', intersect: false },\n    54\t        plugins: { decimation: { enabled: true, algorithm: 'min-max' } },\n    55\t        scales: { x: { type: 'time' } },\n    56\t      },\n    57\t      plugins: [benchPlugin(state, newestHeld)],\n    58\t    });\n    59\t    const append = (x, ys) => {\n    60\t      for (let s = 0; s < ys.length; s++) { arrays[s].push({ x, y: ys[s] }); arrays[s].shift(); }\n    61\t      chart.update('none');\n    62\t    };\n    63\t    return handleFor(chart, state, append, held);\n    64\t  },\n    65\t};\n\nbench/src/adapters/chartjs.js\n     1\t// Chart.js, starter default: what the \"Getting started\" page and the time-scale page lead a new user to write.\n     2\t//\n     3\t// Options set, and why (none of them is a performance option):\n     4\t//   type: 'line', data.labels + datasets[].data   the starter shape: x values as labels, y values as arrays\n     5\t//   scales.x.type: 'time'                         the fixture's x is time; without it Chart.js draws a category axis\n     6\t//                                                 of 120 to 1,000,000 label strings (needs the date-fns adapter)\n     7\t//   datasets[].label                              names in the legend\n     8\t// Everything else is the default: animation on, point markers on, responsive with the default 2:1 aspect ratio\n     9\t// (the bench containers are 2:1 so the canvas fills them as the other libraries do), legend, tooltip, Colors plugin.\n    10\t//\n    11\t// Input: Chart.js needs plain arrays here, so each typed column is copied with Array.from inside the timed work.\n    12\t// NaN is kept; Chart.js parses it to null and leaves a gap. Streaming uses push/shift and chart.update(), the\n    13\t// pattern in the Chart.js \"Updating charts\" page, with its default update animation.\n    14\timport { Chart, benchPlugin, handleFor, newState, canvasIn } from './chartjs-common.js';\n    15\t\n    16\tconst newestParsed = chart => { const p = chart.getDatasetMeta(0)._parsed; return p[p.length - 1]?.x; };\n    17\t\n    18\texport default {\n    19\t  id: 'chartjs',\n    20\t  library: 'Chart.js',\n    21\t  version: __VERSIONS__['chart.js'],\n    22\t  config: 'starter default',\n    23\t  available: () => ({ ok: true }),\n    24\t  create(el, fix) {\n    25\t    const state = newState();\n    26\t    const labels = Array.from(fix.x);\n    27\t    const datasets = fix.ys.map((c, i) => ({ label: fix.names[i], data: Array.from(c) }));\n    28\t    const chart = new Chart(canvasIn(el), {\n    29\t      type: 'line',\n    30\t      data: { labels, datasets },\n    31\t      options: { scales: { x: { type: 'time' } } },\n    32\t      plugins: [benchPlugin(state, newestParsed)],\n    33\t    });\n    34\t    const append = (x, ys) => {\n    35\t      labels.push(x); labels.shift();\n    36\t      for (let s = 0; s < ys.length; s++) { datasets[s].data.push(ys[s]); datasets[s].data.shift(); }\n    37\t      chart.update();\n    38\t    };\n    39\t    return handleFor(chart, state, append, (ch, i) => ch.getDatasetMeta(i)._parsed);\n    40\t  },\n    41\t};\n\nbench/src/adapters/noop.js\n     1\t// Measurement floor: takes the same inputs and calls as a real adapter and draws nothing.\n     2\t// Whatever a run of this adapter costs is the harness, the page and the browser, not a chart.\n     3\t\n     4\texport default {\n     5\t  id: 'noop',\n     6\t  library: 'none',\n     7\t  version: 'n/a',\n     8\t  config: 'floor',\n     9\t  floor: true,\n    10\t  available: () => ({ ok: true }),\n    11\t  create(el, fix) {\n    12\t    let newest = fix.x[fix.x.length - 1];\n    13\t    return {\n    14\t      ready: Promise.resolve(),\n    15\t      append(x) { newest = x; },\n    16\t      drawnNewestX: () => newest,\n    17\t      // There is no drawing to read back; the runner records admission as \"not applicable (floor)\".\n    18\t      describe: () => null,\n    19\t      destroy() {},\n    20\t    };\n    21\t  },\n    22\t};\n\nbench/src/adapters/uplot.js\n     1\t// uPlot, default configuration.\n     2\t//\n     3\t// Options set, and why (none of them is a performance option):\n     4\t//   width, height   uPlot has no automatic sizing; the container's size, minus room for its legend row below the plot.\n     5\t//                   In the resize workload a ResizeObserver calls setSize (see below).\n     6\t//   ms: 1           the fixture's x is epoch milliseconds; uPlot's default unit is seconds. The documented\n     7\t//                   alternative to dividing every timestamp by 1,000.\n     8\t//   series[].stroke uPlot has no default palette; without a stroke a series is not drawn.\n     9\t//   series[].label  names in the legend, as every adapter shows them.\n    10\t// Everything else (axes, legend, cursor, scales, gaps) is uPlot's default.\n    11\t//\n    12\t// Input: typed columns go to uPlot as they are (it accepts typed arrays). uPlot marks a gap with null, which a\n    13\t// Float64Array cannot hold, so a column containing NaN is copied into a plain array with null in its place; that\n    14\t// copy is part of the timed work because it is what feeding uPlot this data costs.\n    15\timport uPlot from 'uplot';\n    16\timport css from 'uplot/dist/uPlot.min.css';\n    17\t\n    18\tconst COLORS = ['#1f77b4', '#d62728', '#2ca02c', '#9467bd', '#ff7f0e'];\n    19\tconst LEGEND_ROOM = 30;\n    20\t\n    21\tfunction column(col, mutable) {\n    22\t  let gap = false;\n    23\t  for (let i = 0; i < col.length; i++) if (col[i] !== col[i]) { gap = true; break; }\n    24\t  if (!gap && !mutable) return col;\n    25\t  const out = new Array(col.length);\n    26\t  for (let i = 0; i < col.length; i++) out[i] = col[i] === col[i] ? col[i] : null;\n    27\t  return out;\n    28\t}\n    29\t\n    30\t/** Shared by the default adapter and the deliberately broken test variants; `tweak` may change options or behaviour. */\n    31\texport function createUplot(el, fix, opts = {}, tweak = {}) {\n    32\t  const stream = !!opts.window;\n    33\t  // Streaming appends with push/shift on plain arrays, uPlot's own streaming pattern; typed arrays cannot grow.\n    34\t  const data = [stream ? Array.from(fix.x) : fix.x, ...fix.ys.map(c => column(c, stream))];\n    35\t  let readyResolve, drawnNewest = NaN;\n    36\t  const ready = new Promise(r => { readyResolve = r; });\n    37\t  const options = {\n    38\t    width: el.clientWidth,\n    39\t    height: el.clientHeight - LEGEND_ROOM,\n    40\t    ms: 1,\n    41\t    series: [{}, ...fix.names.map((n, i) => ({ label: n, stroke: COLORS[i % COLORS.length] }))],\n    42\t    hooks: {\n    43\t      // Instrumentation, not configuration: record what the chart had when it last drew.\n    44\t      draw: [u => { const xs = u.data[0]; drawnNewest = xs[xs.length - 1]; readyResolve(); }],\n    45\t    },\n    46\t  };\n    47\t  tweak.options?.(options);\n    48\t  const u = new uPlot(options, data, el);\n    49\t  // Resize workload only: uPlot does not follow its container; its demos use a resize listener and setSize. A\n    50\t  // ResizeObserver on the container is the same pattern for a container that changes without a window resize.\n    51\t  let observer = null;\n    52\t  if (opts.resize) {\n    53\t    observer = new ResizeObserver(() => {\n    54\t      const w = el.clientWidth, h = el.clientHeight - LEGEND_ROOM;\n    55\t      if (w !== u.width || h !== u.height) u.setSize({ width: w, height: h });\n    56\t    });\n    57\t    observer.observe(el);\n    58\t  }\n    59\t  return {\n    60\t    u,\n    61\t    ready,\n    62\t    append(x, ys) {\n    63\t      data[0].push(x);\n    64\t      for (let s = 0; s < ys.length; s++) data[s + 1].push(ys[s] === ys[s] ? ys[s] : null);\n    65\t      if (!tweak.noTrim) {\n    66\t        data[0].shift();\n    67\t        for (let s = 0; s < ys.length; s++) data[s + 1].shift();\n    68\t      }\n    69\t      u.setData(data);\n    70\t    },\n    71\t    drawnNewestX: () => drawnNewest,\n    72\t    // Reads uPlot's own state, not the fixture:\n    73\t    //   x range  u.scales.x.min / max   (milliseconds, because of ms: 1)\n    74\t    //   y range  u.scales.y.min / max   (the one value scale every series uses by default)\n    75\t    //   per series: u.data[0].length, u.data[0][0], u.data[0][last], and the count of null in u.data[s]\n    76\t    describe() {\n    77\t      const xs = u.data[0];\n    78\t      return {\n    79\t        reads: 'uPlot u.scales.x/y.{min,max}; u.data[0] length and ends; null count in u.data[s]',\n    80\t        x: [u.scales.x.min, u.scales.x.max],\n    81\t        y: [u.scales.y.min, u.scales.y.max],\n    82\t        series: u.data.slice(1).map(col => {\n    83\t          let missing = 0;\n    84\t          for (let i = 0; i < col.length; i++) if (col[i] == null) missing++;\n    85\t          return { points: col.length, oldestX: xs[0], newestX: xs[xs.length - 1], missing };\n    86\t        }),\n    87\t      };\n    88\t    },\n    89\t    destroy: () => { observer?.disconnect(); u.destroy(); },\n    90\t  };\n    91\t}\n    92\t\n    93\texport default {\n    94\t  id: 'uplot',\n    95\t  library: 'uPlot',\n    96\t  version: __VERSIONS__.uplot,\n    97\t  config: 'default',\n    98\t  available: () => ({ ok: true }),\n    99\t  setup() {\n   100\t    const s = document.createElement('style');\n   101\t    s.textContent = css;\n   102\t    document.head.appendChild(s);\n   103\t  },\n   104\t  create: (el, fix, opts) => createUplot(el, fix, opts),\n   105\t};\n","exit_code":0,"status":"completed"}}
