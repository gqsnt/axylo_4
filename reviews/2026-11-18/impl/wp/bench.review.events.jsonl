{"type":"item.started","item":{"id":"item_35","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module <<'NODE'\nimport { analyze, balancedOrder, pairedBootstrap, summarizeRun } from './bench/src/stats.js';\nimport { lineFixture, expectedView, checksum } from './bench/src/fixtures.js';\nimport { admit } from './bench/lib/driver.mjs';\nconst toRuns = (blocks, make, seed = 42) => balancedOrder(blocks, seed).flatMap((order, block) =>\n  [...order].map((config, position) => ({ phase: 'timed', block, position, config, outcome: 'ok', ...make(config, block, position, order) })));\nconst summary = (taskMs, outcome = 'ok') => ({ outcome, summary: { taskMs } });\nconst print = (label, rs, key = 'taskMs', workload = 'first') => {\n  const { metrics, outcomes } = analyze(workload, rs);\n  const { outcome, medianA, medianB, lo, hi, pairs } = metrics[key];\n  console.log(label, JSON.stringify({ medianA, medianB, lo, hi, outcome, pairs, outcomes }));\n};\nprint('Informative censoring: candidate times out in 14/20', toRuns(20, (c, i) => c === 'A' ? summary(10) : i < 6 ? summary(5) : summary(null, 'timeout')));\nprint('Median percentile undercoverage: B sampled five 5s, one 11, true law P(11)=.51; true A=10', toRuns(6,(c,i) => summary(c === 'A' ? 10 : i < 5 ? 5 : 11)));\nconst h = .49, p = h**6 + 6*h**5*(1-h);\nconsole.log('probability of those falsely favorable counts, for six independent blocks:', p);\nprint('Fixed AB/BA with no library effect: AB samples loaded blocks, BA quiet; any run in second slot costs 10ms more', toRuns(20, (c, i, pos, order) => summary((order === 'AB' ? 40 : 10) + 10 * pos)));\nprint('Median count hides 2/20 bad streams', toRuns(20,(c,i) => ({ summary: { framesOverThreshold: c === 'B' && i < 2 ? 60 : 0 } })), 'framesOverThreshold', 'stream');\nconst sched = Array.from({ length: 300 }, (_, i) => i * (1000 / 60));\nconst resizeFrames = [91, 241, ...Array.from({ length: 120 }, (_, i) => 258 + i * (1000 / 60))];\nconst resizeSummary = summarizeRun('resize', { result:{ env:{ refresh:{medianIntervalMs:16.67}}, resize:{ startAt:100, endAt:2300, frames:resizeFrames }}, deltas:{'resize:start->resize:end':{TaskDuration:0.015}}});\nconsole.log('Resize 150ms straddling start, excluded:', JSON.stringify(resizeSummary));\nfunction streamCase(stalled) {\n  const frames = stalled ? [...sched.slice(0,298), sched[299]+5000] : sched;\n  const visible = stalled ? [...sched.slice(0,298), null, null] : sched;\n  const env = { refresh: { medianIntervalMs: 16.7 } };\n  const result = { adapter: {}, env, stream: { samples: 300, startAt: 0, endAt: frames.at(-1), due:sched, visible, frames, neverVisible: stalled ? 2 : 0, ended: stalled ? 'timeout: not every sample became visible' : 'all visible' } };\n  return { result, deltas: {'stream:start->stream:end':{TaskDuration:stalled ? .15 : .6}} };\n}\nconst data = { window:600, samples:300 };\nconst staticFix = lineFixture({series:1,points:10000,gaps:true});\nconst exp = expectedView(staticFix);\nconst bogus = e => ({ x:[e.oldestX,e.newestX], y:[e.yMin,e.yMax],series:e.missing.map(() => ({points:e.points,oldestX:e.oldestX,newestX:e.newestX})) });\nconsole.log('Blank / wrong drawing, gappy 1x10000, matching readback with missing omitted:', admit({workload:'first',params:{size:'1x10000',gaps:true}}, { describe: [bogus(exp)], checksum:checksum([staticFix]) }, false));\nconst { streamFixture } = await import('./bench/src/fixtures.js');\nconst streamFix = streamFixture(data);\nconst failing = streamCase(true);\nfailing.result.describe = [bogus(expectedView(streamFix))];\nfailing.result.checksum = checksum([streamFix]);\nconsole.log('Streaming timeout with a correct held final window:', JSON.stringify({ admission:admit({workload:'stream',params:data}, failing.result,false), summary:summarizeRun('stream',failing)}));\nprint('All candidate stream runs failed to finish but were admitted, primary only',toRuns(8,(c) => ({summary:summarizeRun('stream',streamCase(c==='B'))})), 'taskMsPerUpdate','stream');\nconst altA = [1, 101, 102], altB = [100, 1, 103];\nconsole.log('Difference of medians vs paired differences fixture:', pairedBootstrap(altA, altB));\nNODE\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
