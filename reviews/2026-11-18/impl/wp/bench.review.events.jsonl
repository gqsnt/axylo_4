{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'nl -ba bench/run.mjs; nl -ba bench/analyze.mjs; nl -ba bench/build.mjs'","aggregated_output":"     1\t#!/usr/bin/env node\n     2\t// Benchmark runner: a baseline and a candidate adapter, one workload, randomized balanced blocks, a fresh browser\n     3\t// context per run, raw samples written to bench/history/<run id>.json after every run.\n     4\t//\n     5\t//   node bench/run.mjs --baseline uplot --candidate chartjs-tuned --workload first --size 1x100000 --blocks 6\n     6\t//   node bench/run.mjs --aa uplot --workload first --size 1x100000 --blocks 8        (A-versus-A noise band)\n     7\t//   node bench/run.mjs ... --noise <run id of an A-versus-A run>[,<another>]             (use that band; several = union)\n     8\t//   node bench/run.mjs --baseline axylo:renderer=canvas --candidate axylo:renderer=svg ...  (adapter parameters)\n     9\t//\n    10\t// See bench/README.md for what each metric means.\n    11\timport fs from 'node:fs';\n    12\timport path from 'node:path';\n    13\timport os from 'node:os';\n    14\timport crypto from 'node:crypto';\n    15\timport { parseArgs } from 'node:util';\n    16\timport { build, BENCH } from './build.mjs';\n    17\timport { startServer, launchBrowser, runOnce, machineRecord, expectedFor } from './lib/driver.mjs';\n    18\timport { balancedOrder, summarizeRun, analyze } from './src/stats.js';\n    19\timport { formatAnalysis } from './lib/report.mjs';\n    20\timport { parseAdapterRef, loadNoise, WORKLOADS } from './lib/refs.mjs';\n    21\t\n    22\tconst { values: a } = parseArgs({\n    23\t  options: {\n    24\t    baseline: { type: 'string' }, candidate: { type: 'string' }, aa: { type: 'string' },\n    25\t    workload: { type: 'string', default: 'first' }, size: { type: 'string' }, gaps: { type: 'boolean', default: false },\n    26\t    charts: { type: 'string' }, window: { type: 'string' }, samples: { type: 'string' }, toggles: { type: 'string' },\n    27\t    blocks: { type: 'string', default: '6' }, settle: { type: 'string', default: '500' }, timeout: { type: 'string', default: '120000' },\n    28\t    seed: { type: 'string' }, dpr: { type: 'string', default: '1' }, headed: { type: 'boolean', default: false },\n    29\t    noise: { type: 'string' }, 'history-dir': { type: 'string' }, 'no-build': { type: 'boolean', default: false },\n    30\t    quiet: { type: 'boolean', default: false },\n    31\t  },\n    32\t});\n    33\t\n    34\tconst die = msg => { console.error(`run.mjs: ${msg}`); process.exit(2); };\n    35\tconst aa = a.aa ?? null;\n    36\tconst baseline = aa ?? a.baseline, candidate = aa ?? a.candidate;\n    37\tif (!baseline || !candidate) die('give --baseline and --candidate, or --aa <adapter>');\n    38\tlet refA, refB;\n    39\ttry { refA = parseAdapterRef(baseline); refB = parseAdapterRef(candidate); } catch (e) { die(e.message); }\n    40\tconst workload = a.workload;\n    41\tif (!WORKLOADS.includes(workload)) die(`unknown workload ${workload} (${WORKLOADS.join(', ')})`);\n    42\tconst params = workload === 'first' ? { size: a.size ?? '3x120', gaps: a.gaps }\n    43\t  : workload === 'page' ? { size: a.size ?? '3x120', charts: Number(a.charts ?? 24), gaps: a.gaps }\n    44\t  : workload === 'theme' ? { size: a.size ?? '3x120', toggles: Number(a.toggles ?? 20) }\n    45\t  : workload === 'resize' ? { size: a.size ?? '1x100000', charts: Number(a.charts ?? 1) }\n    46\t  : { window: Number(a.window ?? 600), samples: Number(a.samples ?? 300) };\n    47\tconst blocks = Number(a.blocks);\n    48\tconst seed = a.seed !== undefined ? Number(a.seed) : crypto.randomInt(1, 2 ** 31);\n    49\tlet order;\n    50\ttry { order = balancedOrder(blocks, seed); } catch (e) { die(e.message); }\n    51\tconst settleMs = Number(a.settle), timeoutMs = Number(a.timeout), dpr = Number(a.dpr);\n    52\tconst historyDir = path.resolve(a['history-dir'] ?? path.join(BENCH, 'history'));\n    53\tfs.mkdirSync(historyDir, { recursive: true });\n    54\t\n    55\tlet noise = null;\n    56\tif (a.noise) {\n    57\t  try { noise = loadNoise(a.noise.split(','), historyDir, workload, params); } catch (e) { die(e.message); }\n    58\t}\n    59\t\n    60\tconst stamp = new Date().toISOString().replace(/[-:]/g, '').replace(/\\.\\d+Z$/, 'Z');\n    61\tconst tag = workload === 'stream' ? `w${params.window}` : `${params.size}${params.gaps ? '-gaps' : ''}${params.charts > 1 ? `-x${params.charts}` : ''}`;\n    62\tconst slug = ref => ref.replace(/[^a-zA-Z0-9.-]+/g, '_');\n    63\tconst runId = `${stamp}-${workload}-${tag}${dpr !== 1 ? `-dpr${dpr}` : ''}-${aa ? `aa-${slug(aa)}` : `${slug(baseline)}-vs-${slug(candidate)}`}-${crypto.randomBytes(2).toString('hex')}`;\n    64\tconst file = path.join(historyDir, `${runId}.json`);\n    65\t\n    66\tconst record = {\n    67\t  schema: 'axylo-bench/1',\n    68\t  runId,\n    69\t  // Stays \"interrupted\" until the last run is analysed; a run cut short by a restart is never merged with another.\n    70\t  status: 'interrupted',\n    71\t  startedAt: new Date().toISOString(),\n    72\t  command: process.argv.slice(2),\n    73\t  design: {\n    74\t    mode: aa ? 'aa' : 'compare', baseline, candidate, labels: { A: baseline, B: candidate }, adapters: { A: refA, B: refB },\n    75\t    workload, params, blocks, order, seed, settleMs, timeoutMs, dpr, viewport: [1440, 900],\n    76\t    noiseFrom: noise ? noise.sources : null,\n    77\t  },\n    78\t  environment: null,\n    79\t  hashes: null,\n    80\t  admission: {},\n    81\t  runs: [],\n    82\t  analysis: null,\n    83\t};\n    84\tconst save = () => {\n    85\t  const tmp = `${file}.tmp`;\n    86\t  fs.writeFileSync(tmp, JSON.stringify(record, null, 1));\n    87\t  fs.renameSync(tmp, file);\n    88\t};\n    89\tconst log = (...m) => { if (!a.quiet) console.log(...m); };\n    90\t\n    91\tlet browser, server;\n    92\tconst stop = async (status, why) => {\n    93\t  record.status = status;\n    94\t  record.endedBecause = why;\n    95\t  record.finishedAt = new Date().toISOString();\n    96\t  save();\n    97\t  await browser?.close().catch(() => {});\n    98\t  await server?.close().catch(() => {});\n    99\t};\n   100\tfor (const sig of ['SIGINT', 'SIGTERM', 'SIGHUP']) process.on(sig, async () => { await stop('interrupted', `signal ${sig}`); console.error(`\\ninterrupted; partial record kept in ${file}`); process.exit(130); });\n   101\t\n   102\ttry {\n   103\t  const manifest = a['no-build'] ? JSON.parse(fs.readFileSync(path.join(BENCH, 'dist/manifest.json'), 'utf8')) : await build();\n   104\t  for (const { id } of [refA, refB]) if (!manifest.adapters[id]) die(`no adapter \"${id}\" (have: ${Object.keys(manifest.adapters).join(', ')})`);\n   105\t  const expected = expectedFor(workload, params);\n   106\t  record.hashes = { fixtureChecksum: expected.checksum, page: manifest.page, adapters: Object.fromEntries([refA.id, refB.id].map(id => [id, manifest.adapters[id]])) };\n   107\t  record.environment = { ...machineRecord(await (browser = await launchBrowser({ headed: a.headed })), { headed: a.headed }), libraries: manifest.versions };\n   108\t  server = await startServer();\n   109\t  save();\n   110\t  log(`run ${runId}\\n  ${aa ? `A-versus-A: ${aa}` : `A=${baseline}  B=${candidate}`}  ${workload} ${JSON.stringify(params)}  ${blocks} blocks  order ${order.join(' ')}  seed ${seed}`);\n   111\t  log(`  Chrome ${browser.version()} ${a.headed ? 'headed' : 'headless'}, history -> ${path.relative(process.cwd(), file)}`);\n   112\t\n   113\t  const refs = { [baseline]: refA, [candidate]: refB };\n   114\t  const spec = ref => ({ adapter: refs[ref].id, adapterParams: refs[ref].params, workload, params, settleMs, timeoutMs, dpr });\n   115\t\n   116\t  // Admission: one untimed run per adapter. An adapter that does not show the fixture is not timed at all.\n   117\t  for (const id of new Set([baseline, candidate])) {\n   118\t    const r = await runOnce(browser, server.base, spec(id));\n   119\t    const adm = { outcome: r.outcome, reason: r.reason ?? r.error ?? null, admission: r.admission ?? null, describe: r.result?.describe ?? null, adapter: r.result?.adapter ?? null, themeCheck: r.result?.themeCheck, resizeCheck: r.result?.resizeCheck };\n   120\t    record.admission[id] = adm;\n   121\t    if (r.result?.env && !record.environment.page) record.environment.page = r.result.env;\n   122\t    record.runs.push({ index: record.runs.length, phase: 'admission', adapter: id, outcome: r.outcome, reason: adm.reason, durationMs: r.durationMs, logs: r.logs, pageErrors: r.pageErrors });\n   123\t    save();\n   124\t    log(`  admission ${id}: ${r.outcome}${adm.reason ? ` (${adm.reason})` : ''}`);\n   125\t  }\n   126\t  const blocked = Object.entries(record.admission).filter(([, v]) => v.outcome !== 'ok');\n   127\t  if (blocked.length) {\n   128\t    record.analysis = { notCompared: blocked.map(([id, v]) => `${id}: ${v.outcome}${v.reason ? ` (${v.reason})` : ''}`) };\n   129\t    await stop('complete', 'admission failed or adapter not available; nothing was timed');\n   130\t    log(`  not timed: ${record.analysis.notCompared.join('; ')}`);\n   131\t    process.exit(0);\n   132\t  }\n   133\t\n   134\t  for (let b = 0; b < order.length; b++) {\n   135\t    for (let pos = 0; pos < 2; pos++) {\n   136\t      const config = order[b][pos];\n   137\t      const id = config === 'A' ? baseline : candidate;\n   138\t      const r = await runOnce(browser, server.base, spec(id));\n   139\t      const run = { index: record.runs.length, phase: 'timed', block: b, position: pos, config, adapter: id, startedAt: new Date(Date.now() - r.durationMs).toISOString(), ...r, ref: id };\n   140\t      if (r.outcome === 'ok') run.summary = summarizeRun(workload, r);\n   141\t      record.runs.push(run);\n   142\t      save();\n   143\t      const primary = run.summary ? Object.entries(run.summary).find(([k]) => k === 'taskMs' || k === 'taskMsPerUpdate' || k === 'taskMsPerToggle') : null;\n   144\t      log(`  block ${b + 1}/${order.length} ${order[b]} ${config}=${id}: ${r.outcome}${primary ? ` ${primary[0]}=${primary[1].toFixed(3)}` : ''}${r.reason ? ` (${r.reason})` : ''}${r.error ? ` (${String(r.error).split('\\n')[0]})` : ''}`);\n   145\t    }\n   146\t  }\n   147\t  record.environment.loadAverageAtEnd = os.loadavg();\n   148\t  record.analysis = analyze(workload, record.runs, { noise });\n   149\t  await stop('complete', 'all blocks run');\n   150\t  log(formatAnalysis(record));\n   151\t} catch (e) {\n   152\t  record.error = String(e?.stack ?? e);\n   153\t  await stop('aborted', 'runner error');\n   154\t  console.error(e);\n   155\t  process.exit(1);\n   156\t}\n     1\t#!/usr/bin/env node\n     2\t// Re-print, or re-analyse with a noise band, a history record. Does not modify the file.\n     3\t//   node bench/analyze.mjs <run id | path> [--noise <A-versus-A run id | path>]\n     4\timport fs from 'node:fs';\n     5\timport path from 'node:path';\n     6\timport { parseArgs } from 'node:util';\n     7\timport { BENCH } from './build.mjs';\n     8\timport { analyze } from './src/stats.js';\n     9\timport { formatAnalysis } from './lib/report.mjs';\n    10\timport { loadNoise } from './lib/refs.mjs';\n    11\t\n    12\tconst { values, positionals } = parseArgs({ allowPositionals: true, options: { noise: { type: 'string' } } });\n    13\tconst load = ref => JSON.parse(fs.readFileSync(fs.existsSync(ref) ? ref : path.join(BENCH, 'history', `${ref}.json`), 'utf8'));\n    14\tif (!positionals[0]) { console.error('usage: node bench/analyze.mjs <run id | path> [--noise <run id | path>]'); process.exit(2); }\n    15\tconst rec = load(positionals[0]);\n    16\tif (rec.status !== 'complete') console.log(`note: this record's status is \"${rec.status}\"${rec.endedBecause ? ` (${rec.endedBecause})` : ''}; analysing the runs it holds`);\n    17\tlet noise = null;\n    18\tif (values.noise) {\n    19\t  noise = loadNoise(values.noise.split(','), path.join(BENCH, 'history'), rec.design.workload, rec.design.params);\n    20\t  for (const src of noise.sources) if (src.chrome !== rec.environment.browser.version) console.log(`warning: noise run ${src.runId} used Chrome ${src.chrome}, this run ${rec.environment.browser.version}`);\n    21\t  rec.design.noiseFrom = noise.sources;\n    22\t}\n    23\tif (rec.runs.some(r => r.phase === 'timed')) rec.analysis = analyze(rec.design.workload, rec.runs, { noise });\n    24\tconsole.log(formatAnalysis(rec));\n     1\t// Builds bench/dist: the page, and one ESM bundle per adapter (src/adapters and the deliberately broken test/adapters).\n     2\t// Usage: node bench/build.mjs\n     3\timport { build as esbuild } from 'esbuild';\n     4\timport fs from 'node:fs';\n     5\timport path from 'node:path';\n     6\timport crypto from 'node:crypto';\n     7\timport { fileURLToPath } from 'node:url';\n     8\t\n     9\texport const BENCH = path.dirname(fileURLToPath(import.meta.url));\n    10\texport const DIST = path.join(BENCH, 'dist');\n    11\texport const REPO = path.resolve(BENCH, '..');\n    12\t\n    13\texport const sha256 = buf => crypto.createHash('sha256').update(buf).digest('hex');\n    14\tconst readJson = p => JSON.parse(fs.readFileSync(p, 'utf8'));\n    15\t\n    16\texport function libraryVersions() {\n    17\t  const v = {};\n    18\t  for (const name of ['uplot', 'chart.js', 'chartjs-adapter-date-fns', 'date-fns']) {\n    19\t    try { v[name] = readJson(path.join(BENCH, 'node_modules', name, 'package.json')).version; } catch { v[name] = 'not available: not installed'; }\n    20\t  }\n    21\t  try { v.axylo = readJson(path.join(REPO, 'packages/axylo/package.json')).version; } catch { v.axylo = 'not available'; }\n    22\t  return v;\n    23\t}\n    24\t\n    25\tfunction adapterSources() {\n    26\t  const list = [];\n    27\t  for (const [dir, test] of [['src/adapters', false], ['test/adapters', true]]) {\n    28\t    for (const f of fs.readdirSync(path.join(BENCH, dir))) {\n    29\t      if (!f.endsWith('.js') || f.endsWith('-common.js')) continue;\n    30\t      list.push({ id: f.slice(0, -3), file: path.join(BENCH, dir, f), test });\n    31\t    }\n    32\t  }\n    33\t  return list;\n    34\t}\n    35\t\n    36\texport async function build() {\n    37\t  fs.rmSync(DIST, { recursive: true, force: true });\n    38\t  fs.mkdirSync(path.join(DIST, 'adapters'), { recursive: true });\n    39\t  const versions = libraryVersions();\n    40\t  const common = {\n    41\t    bundle: true, format: 'esm', target: 'es2022', minify: true, legalComments: 'none', logLevel: 'warning',\n    42\t    loader: { '.css': 'text' },\n    43\t    // Production builds of every library (Chart.js and uPlot have no separate dev mode; this pins NODE_ENV anyway).\n    44\t    define: { __VERSIONS__: JSON.stringify(versions), 'process.env.NODE_ENV': '\"production\"' },\n    45\t  };\n    46\t  const adapters = adapterSources();\n    47\t  await Promise.all([\n    48\t    esbuild({ ...common, entryPoints: [path.join(BENCH, 'src/page.js')], outfile: path.join(DIST, 'page.js') }),\n    49\t    ...adapters.map(a => esbuild({ ...common, entryPoints: [a.file], outfile: path.join(DIST, 'adapters', `${a.id}.js`) })),\n    50\t  ]);\n    51\t  fs.copyFileSync(path.join(BENCH, 'src/page.html'), path.join(DIST, 'index.html'));\n    52\t  const hash = p => sha256(fs.readFileSync(p));\n    53\t  // Snapshot of the Axylo build. Other work rebuilds packages/axylo/dist while sessions run; every run of a session\n    54\t  // (run.mjs --no-build after one build) loads this copy, so all of them measure the same bytes.\n    55\t  const axylo = {};\n    56\t  fs.mkdirSync(path.join(DIST, 'axylo'), { recursive: true });\n    57\t  for (const f of ['axylo.iife.min.js', 'axylo.iife.js', 'axylo.css']) {\n    58\t    const from = path.join(REPO, 'packages/axylo/dist', f);\n    59\t    if (!fs.existsSync(from)) { axylo[f] = 'not available: not built'; continue; }\n    60\t    fs.copyFileSync(from, path.join(DIST, 'axylo', f));\n    61\t    axylo[f] = { sha256: hash(from), builtAt: fs.statSync(from).mtime.toISOString() };\n    62\t  }\n    63\t  const manifest = {\n    64\t    versions,\n    65\t    page: { 'page.js': hash(path.join(DIST, 'page.js')), 'index.html': hash(path.join(DIST, 'index.html')) },\n    66\t    axylo,\n    67\t    adapters: Object.fromEntries(adapters.map(a => [a.id, { sha256: hash(path.join(DIST, 'adapters', `${a.id}.js`)), test: a.test }])),\n    68\t  };\n    69\t  fs.writeFileSync(path.join(DIST, 'manifest.json'), JSON.stringify(manifest, null, 1));\n    70\t  return manifest;\n    71\t}\n    72\t\n    73\tif (process.argv[1] && path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {\n    74\t  const m = await build();\n    75\t  console.log(`built bench/dist: page + ${Object.keys(m.adapters).length} adapters (${Object.keys(m.adapters).join(', ')})`);\n    76\t}\n","exit_code":0,"status":"completed"}}
