{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc \"nl -ba bench/test/admission.test.mjs; nl -ba bench/test/stats.test.mjs; for f in bench/test/adapters/*.js; do printf '\\\\n%s\\\\n' \\\"\"'$f\"; nl -ba \"$f\"; done; nl -ba bench/package.json; nl -ba .github/workflows/ci.yml'","aggregated_output":"     1\t// Browser test: the admission check, run against real charts in system Chrome, rejects deliberately broken\n     2\t// adapters (test/adapters) and the runner then times nothing for them.\n     3\timport { test, before, after } from 'node:test';\n     4\timport assert from 'node:assert/strict';\n     5\timport fs from 'node:fs';\n     6\timport os from 'node:os';\n     7\timport path from 'node:path';\n     8\timport { execFileSync, spawn } from 'node:child_process';\n     9\timport { build, BENCH } from '../build.mjs';\n    10\timport { startServer, launchBrowser, runOnce } from '../lib/driver.mjs';\n    11\t\n    12\tlet browser, server;\n    13\tconst spec = (adapter, workload, params) => ({ adapter, workload, params, settleMs: 200, timeoutMs: 60000 });\n    14\t\n    15\tbefore(async () => { await build(); browser = await launchBrowser(); server = await startServer(); });\n    16\tafter(async () => { await browser?.close(); await server?.close(); });\n    17\t\n    18\ttest('uPlot default is admitted on first 3x120', async () => {\n    19\t  const r = await runOnce(browser, server.base, spec('uplot', 'first', { size: '3x120', gaps: false }));\n    20\t  assert.equal(r.outcome, 'ok', r.reason ?? r.error);\n    21\t  assert.ok(r.deltas['create:start->create:end'].TaskDuration > 0);\n    22\t});\n    23\t\n    24\ttest('uPlot with its y range pinned away from the data is not admitted, and its timing is not kept', async () => {\n    25\t  const r = await runOnce(browser, server.base, spec('uplot-pinned-y', 'first', { size: '3x120', gaps: false }));\n    26\t  assert.equal(r.outcome, 'not-admitted');\n    27\t  assert.match(r.reason, /visible y \\[1000000, 2000000\\] does not contain/);\n    28\t  assert.match(r.reason, /injected extreme/);\n    29\t  assert.equal(r.deltas, undefined);\n    30\t});\n    31\t\n    32\ttest('a streaming window that is never trimmed is not admitted', async () => {\n    33\t  const r = await runOnce(browser, server.base, spec('uplot-no-trim', 'stream', { window: 600, samples: 300 }));\n    34\t  assert.equal(r.outcome, 'not-admitted');\n    35\t  assert.match(r.reason, /holds 900 points, fixture 600/);\n    36\t});\n    37\t\n    38\ttest('the runner records \"not admitted\" and times nothing', () => {\n    39\t  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'axylo-bench-'));\n    40\t  try {\n    41\t    execFileSync(process.execPath, [path.join(BENCH, 'run.mjs'), '--baseline', 'uplot', '--candidate', 'uplot-pinned-y', '--workload', 'first', '--size', '3x120', '--blocks', '2', '--settle', '200', '--history-dir', dir, '--no-build', '--quiet']);\n    42\t    const files = fs.readdirSync(dir).filter(f => f.endsWith('.json'));\n    43\t    assert.equal(files.length, 1);\n    44\t    const rec = JSON.parse(fs.readFileSync(path.join(dir, files[0]), 'utf8'));\n    45\t    assert.equal(rec.status, 'complete');\n    46\t    assert.equal(rec.admission['uplot-pinned-y'].outcome, 'not-admitted');\n    47\t    assert.equal(rec.admission.uplot.outcome, 'ok');\n    48\t    assert.equal(rec.runs.filter(r => r.phase === 'timed').length, 0);\n    49\t    assert.match(rec.analysis.notCompared[0], /uplot-pinned-y: not-admitted/);\n    50\t  } finally { fs.rmSync(dir, { recursive: true, force: true }); }\n    51\t});\n    52\t\n    53\ttest('errors, timeouts and crashes are distinct outcomes', async () => {\n    54\t  const err = await runOnce(browser, server.base, spec('broken-throws', 'first', { size: '3x120', gaps: false }));\n    55\t  assert.equal(err.outcome, 'error');\n    56\t  assert.match(err.error, /deliberate failure in create/);\n    57\t  const slow = await runOnce(browser, server.base, { ...spec('broken-never-ready', 'first', { size: '3x120', gaps: false }), timeoutMs: 3000 });\n    58\t  assert.equal(slow.outcome, 'timeout');\n    59\t  const crash = await runOnce(browser, server.base, { ...spec('uplot', 'stream', { window: 600, samples: 300 }), testCrashAfterMs: 2500 });\n    60\t  assert.equal(crash.outcome, 'crash');\n    61\t});\n    62\t\n    63\ttest('a runner killed mid-session (as by a restart) leaves its record marked interrupted, with the runs so far', async () => {\n    64\t  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'axylo-bench-'));\n    65\t  try {\n    66\t    const child = spawn(process.execPath, [path.join(BENCH, 'run.mjs'), '--baseline', 'noop', '--candidate', 'uplot', '--workload', 'first', '--size', '3x120', '--blocks', '6', '--settle', '200', '--history-dir', dir, '--no-build', '--quiet'], { stdio: 'ignore' });\n    67\t    const read = () => { const f = fs.readdirSync(dir).find(n => n.endsWith('.json')); return f ? JSON.parse(fs.readFileSync(path.join(dir, f), 'utf8')) : null; };\n    68\t    const t0 = Date.now();\n    69\t    while (Date.now() - t0 < 30000 && !(read()?.runs.some(r => r.phase === 'timed'))) await new Promise(r => setTimeout(r, 100));\n    70\t    child.kill('SIGKILL'); // no handler runs: the file must already say \"interrupted\"\n    71\t    await new Promise(r => child.on('exit', r));\n    72\t    const rec = read();\n    73\t    assert.equal(rec.status, 'interrupted');\n    74\t    assert.ok(rec.runs.some(r => r.phase === 'timed'));\n    75\t    assert.equal(rec.analysis, null);\n    76\t  } finally { fs.rmSync(dir, { recursive: true, force: true }); }\n    77\t});\n    78\t\n    79\ttest('the theme workload does not admit a chart whose marks keep their colors (uPlot has no theme mechanism)', async () => {\n    80\t  const r = await runOnce(browser, server.base, spec('uplot', 'theme', { size: '3x120', toggles: 2 }));\n    81\t  assert.equal(r.outcome, 'not-admitted');\n    82\t  assert.match(r.reason, /marks did not change color/);\n    83\t});\n    84\t\n    85\ttest('Axylo production build, both renderers, are admitted through adapter parameters', async () => {\n    86\t  for (const renderer of ['canvas', 'svg']) {\n    87\t    const r = await runOnce(browser, server.base, { ...spec('axylo', 'first', { size: '3x120', gaps: false }), adapterParams: { renderer } });\n    88\t    assert.equal(r.outcome, 'ok', r.reason ?? r.error);\n    89\t    assert.match(r.result.adapter.config, new RegExp(`${renderer} mark renderer, production build`));\n    90\t  }\n    91\t});\n     1\t// Pure tests: statistics and the admission comparison, with expected values worked out by hand from the definitions.\n     2\timport { test } from 'node:test';\n     3\timport assert from 'node:assert/strict';\n     4\timport { balancedOrder, pairedBootstrap, classify, quantile, analyze, MIN_PAIRS } from '../src/stats.js';\n     5\timport { lineFixture, streamFixture, expectedView, checksum } from '../src/fixtures.js';\n     6\timport { checkView } from '../src/admission.js';\n     7\t\n     8\ttest('blocks are balanced: as many AB as BA, for any seed', () => {\n     9\t  for (const seed of [1, 2, 3, 99, 123456]) {\n    10\t    const o = balancedOrder(8, seed);\n    11\t    assert.equal(o.filter(x => x === 'AB').length, 4);\n    12\t    assert.equal(o.filter(x => x === 'BA').length, 4);\n    13\t  }\n    14\t  assert.throws(() => balancedOrder(5, 1));\n    15\t  assert.throws(() => balancedOrder(0, 1));\n    16\t});\n    17\t\n    18\ttest('quantile interpolates linearly between order statistics', () => {\n    19\t  assert.equal(quantile([1, 2, 3, 4], 0.5), 2.5);\n    20\t  assert.equal(quantile([10], 0.95), 10);\n    21\t  assert.equal(quantile([0, 10], 0.25), 2.5);\n    22\t});\n    23\t\n    24\ttest('paired bootstrap: a constant shift gives a zero-width interval at that shift', () => {\n    25\t  const a = [3, 9, 4, 7, 5, 6], b = a.map(v => v + 5);\n    26\t  const ci = pairedBootstrap(a, b);\n    27\t  assert.equal(ci.estimate, 5);\n    28\t  assert.equal(ci.lo, 5);\n    29\t  assert.equal(ci.hi, 5);\n    30\t});\n    31\t\n    32\ttest('paired bootstrap: the interval contains the estimate and widens with noise', () => {\n    33\t  const a = [10, 11, 9, 10, 12, 10, 11, 9], b = [12, 10, 13, 11, 12, 14, 9, 12];\n    34\t  const ci = pairedBootstrap(a, b);\n    35\t  assert.ok(ci.lo <= ci.estimate && ci.estimate <= ci.hi);\n    36\t  assert.ok(ci.hi - ci.lo > 0);\n    37\t});\n    38\t\n    39\ttest('three outcomes, lower is better; a noise band must be cleared as well as zero', () => {\n    40\t  assert.equal(classify({ lo: -3, hi: -1 }), 'better');\n    41\t  assert.equal(classify({ lo: 1, hi: 3 }), 'worse');\n    42\t  assert.equal(classify({ lo: -1, hi: 1 }), 'inconclusive');\n    43\t  assert.equal(classify({ lo: -3, hi: -1 }, { lo: -2, hi: 2 }), 'inconclusive');\n    44\t  assert.equal(classify({ lo: -5, hi: -3 }, { lo: -2, hi: 2 }), 'better');\n    45\t  assert.equal(classify({ lo: NaN, hi: NaN }), 'inconclusive');\n    46\t});\n    47\t\n    48\ttest('fewer complete pairs than the minimum never yields a verdict', () => {\n    49\t  const runs = [];\n    50\t  for (let b = 0; b < MIN_PAIRS - 1; b++) for (const [config, t] of [['A', 1], ['B', 100]])\n    51\t    runs.push({ phase: 'timed', block: b, config, outcome: 'ok', summary: { taskMs: t + b * 0.01 } });\n    52\t  const res = analyze('first', runs);\n    53\t  assert.equal(res.metrics.taskMs.outcome, 'inconclusive');\n    54\t  assert.match(res.metrics.taskMs.outcomeNote, /fewer than/);\n    55\t});\n    56\t\n    57\ttest('non-ok runs are not paired', () => {\n    58\t  const runs = [];\n    59\t  for (let b = 0; b < 8; b++) {\n    60\t    runs.push({ phase: 'timed', block: b, config: 'A', outcome: 'ok', summary: { taskMs: 1 } });\n    61\t    runs.push({ phase: 'timed', block: b, config: 'B', outcome: b === 3 ? 'timeout' : 'ok', summary: b === 3 ? undefined : { taskMs: 2 } });\n    62\t  }\n    63\t  const res = analyze('first', runs);\n    64\t  assert.equal(res.completePairs, 7);\n    65\t  assert.equal(res.outcomes['B:timeout'], 1);\n    66\t  assert.equal(res.metrics.taskMs.outcome, 'worse');\n    67\t});\n    68\t\n    69\tconst exact = fix => {\n    70\t  const e = expectedView(fix);\n    71\t  return { x: [e.oldestX, e.newestX], y: [e.yMin, e.yMax], series: e.missing.map(m => ({ points: e.points, oldestX: e.oldestX, newestX: e.newestX, missing: m })) };\n    72\t};\n    73\t\n    74\ttest('admission accepts a readback that matches the fixture', () => {\n    75\t  for (const fix of [lineFixture({ series: 3, points: 120 }), lineFixture({ series: 1, points: 10000, gaps: true }), streamFixture({})]) {\n    76\t    const r = checkView(expectedView(fix), exact(fix));\n    77\t    assert.deepEqual(r, { admitted: true, reasons: [] });\n    78\t  }\n    79\t});\n    80\t\n    81\ttest('gappy fixtures remove 5% of each series, never the extreme, first or last point', () => {\n    82\t  const fix = lineFixture({ series: 3, points: 10000, gaps: true });\n    83\t  for (const col of fix.ys) {\n    84\t    let n = 0;\n    85\t    for (const v of col) if (v !== v) n++;\n    86\t    assert.equal(n, 500);\n    87\t    assert.ok(col[0] === col[0] && col[col.length - 1] === col[col.length - 1]);\n    88\t  }\n    89\t  assert.ok(fix.ys[0][fix.extreme.index] === fix.extreme.y);\n    90\t});\n    91\t\n    92\ttest('fixtures are deterministic', () => {\n    93\t  assert.equal(checksum([lineFixture({ series: 1, points: 1000, seed: 4 })]), checksum([lineFixture({ series: 1, points: 1000, seed: 4 })]));\n    94\t  assert.notEqual(checksum([lineFixture({ series: 1, points: 1000, seed: 4 })]), checksum([lineFixture({ series: 1, points: 1000, seed: 5 })]));\n    95\t});\n    96\t\n    97\ttest('admission rejects a pinned y range, a clipped extreme, a wrong count and a stale window', () => {\n    98\t  const fix = lineFixture({ series: 3, points: 120 });\n    99\t  const e = expectedView(fix);\n   100\t  const pinned = { ...exact(fix), y: [1e6, 2e6] };\n   101\t  assert.equal(checkView(e, pinned).admitted, false);\n   102\t  const clipped = { ...exact(fix), y: [e.yMin, fix.extreme.y - 1] };\n   103\t  const rc = checkView(e, clipped);\n   104\t  assert.equal(rc.admitted, false);\n   105\t  assert.ok(rc.reasons.some(r => r.includes('injected extreme')));\n   106\t  const fewer = exact(fix); fewer.series[1].points = 119;\n   107\t  assert.equal(checkView(e, fewer).admitted, false);\n   108\t  const filledGaps = exact(lineFixture({ series: 1, points: 1000, gaps: true })); filledGaps.series[0].missing = 0;\n   109\t  assert.equal(checkView(expectedView(lineFixture({ series: 1, points: 1000, gaps: true })), filledGaps).admitted, false);\n   110\t  const s = streamFixture({});\n   111\t  const stale = exact(s); stale.series[0].newestX -= s.step;\n   112\t  assert.equal(checkView(expectedView(s), stale).admitted, false);\n   113\t  assert.equal(checkView(e, null).admitted, false);\n   114\t});\n   115\t\n   116\timport { parseAdapterRef } from '../lib/refs.mjs';\n   117\ttest('adapter references carry parameters', () => {\n   118\t  assert.deepEqual(parseAdapterRef('uplot'), { id: 'uplot', params: {} });\n   119\t  assert.deepEqual(parseAdapterRef('axylo:renderer=svg,build=dev'), { id: 'axylo', params: { renderer: 'svg', build: 'dev' } });\n   120\t  assert.deepEqual(parseAdapterRef('x:n=3,on=true'), { id: 'x', params: { n: 3, on: true } });\n   121\t  assert.throws(() => parseAdapterRef('axylo:renderer'));\n   122\t  assert.throws(() => parseAdapterRef('Bad Id'));\n   123\t});\n\nbench/test/adapters/broken-never-ready.js\n     1\t// Deliberately wrong: never reports ready. The run must be recorded as \"timeout\". Test use only.\n     2\texport default {\n     3\t  id: 'broken-never-ready', library: 'none', version: 'n/a', config: 'BROKEN: never ready',\n     4\t  available: () => ({ ok: true }),\n     5\t  create: () => ({ ready: new Promise(() => {}), append() {}, drawnNewestX: () => NaN, describe: () => null, destroy() {} }),\n     6\t};\n\nbench/test/adapters/broken-throws.js\n     1\t// Deliberately wrong: create() throws. The run must be recorded as \"error\", not as a timing. Test use only.\n     2\texport default {\n     3\t  id: 'broken-throws', library: 'none', version: 'n/a', config: 'BROKEN: create throws',\n     4\t  available: () => ({ ok: true }),\n     5\t  create() { throw new Error('deliberate failure in create'); },\n     6\t};\n\nbench/test/adapters/uplot-no-trim.js\n     1\t// Deliberately wrong: a streaming uPlot that appends but never drops the oldest point, so its window grows past 600\n     2\t// (cheaper per update than a correct window would be on some libraries). The admission check must reject it.\n     3\t// Used by test/admission.test.mjs only.\n     4\timport base, { createUplot } from '../../src/adapters/uplot.js';\n     5\t\n     6\texport default {\n     7\t  ...base,\n     8\t  id: 'uplot-no-trim',\n     9\t  config: 'BROKEN: streaming window never trimmed',\n    10\t  create: (el, fix, opts) => createUplot(el, fix, opts, { noTrim: true }),\n    11\t};\n\nbench/test/adapters/uplot-pinned-y.js\n     1\t// Deliberately wrong: uPlot with its y range pinned far away from the data. It draws without error, and a timing of\n     2\t// it would look plausible; the admission check must reject it. Used by test/admission.test.mjs only.\n     3\timport base, { createUplot } from '../../src/adapters/uplot.js';\n     4\t\n     5\texport default {\n     6\t  ...base,\n     7\t  id: 'uplot-pinned-y',\n     8\t  config: 'BROKEN: y range pinned to [1e6, 2e6]',\n     9\t  create: (el, fix, opts) => createUplot(el, fix, opts, { options: o => { o.scales = { y: { range: [1e6, 2e6] } }; } }),\n    10\t};\n     1\t{\n     2\t  \"name\": \"axylo-bench\",\n     3\t  \"private\": true,\n     4\t  \"type\": \"module\",\n     5\t  \"description\": \"Benchmark harness: the same workloads through Axylo and comparison libraries (docs/04-plan-performance.md).\",\n     6\t  \"scripts\": {\n     7\t    \"build\": \"node build.mjs\",\n     8\t    \"test\": \"node --test test/*.test.mjs\",\n     9\t    \"bench\": \"node run.mjs\",\n    10\t    \"analyze\": \"node analyze.mjs\"\n    11\t  },\n    12\t  \"dependencies\": {\n    13\t    \"chart.js\": \"^4.6.1\",\n    14\t    \"chartjs-adapter-date-fns\": \"^3.0.0\",\n    15\t    \"date-fns\": \"^4.4.0\",\n    16\t    \"uplot\": \"^1.6.32\"\n    17\t  }\n    18\t}\n     1\t# Not yet run: the repository has no remote. Written against the commands that\n     2\t# pass locally on Linux with system Chrome; Windows and macOS results are\n     3\t# unknown until this runs there.\n     4\tname: ci\n     5\t\n     6\ton:\n     7\t  push:\n     8\t    branches: [main]\n     9\t  pull_request:\n    10\t\n    11\tpermissions:\n    12\t  contents: read\n    13\t\n    14\tjobs:\n    15\t  check:\n    16\t    strategy:\n    17\t      fail-fast: false\n    18\t      matrix:\n    19\t        os: [ubuntu-latest, windows-latest, macos-latest]\n    20\t    runs-on: ${{ matrix.os }}\n    21\t    timeout-minutes: 20\n    22\t    steps:\n    23\t      - uses: actions/checkout@v4\n    24\t      - uses: actions/setup-node@v4\n    25\t        with:\n    26\t          node-version: 24\n    27\t          cache: npm\n    28\t      - run: npm ci\n    29\t      - run: npm run typecheck\n    30\t      - run: npm test\n    31\t      - run: npm run build\n    32\t      # The browser tests launch the runner's installed Chrome\n    33\t      # (playwright-core, channel \"chrome\"); no browser download.\n    34\t      # Called directly, not through the npm script: that script sets the\n    35\t      # variable with POSIX syntax, which npm on Windows runs through cmd.exe.\n    36\t      - run: npx vitest run\n    37\t        env:\n    38\t          AXYLO_BROWSER: 1\n    39\t      - run: npm run size\n    40\t      - run: node --test bench/test/*.test.mjs\n    41\t        shell: bash\n    42\t      - run: node acceptance/check.mjs\n","exit_code":0,"status":"completed"}}
