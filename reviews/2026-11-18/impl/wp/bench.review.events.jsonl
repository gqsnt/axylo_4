{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'nl -ba bench/src/fixtures.js'","aggregated_output":"     1\t// Deterministic workload data. Pure: runs in Node (the runner derives the expected readback from it) and in the\n     2\t// page (the adapters receive it). Only integer and basic float arithmetic is used, so both produce identical bits.\n     3\t\n     4\texport const DAY = 86_400_000;\n     5\texport const MINUTE = 60_000;\n     6\texport const START = Date.UTC(2026, 0, 1);\n     7\t\n     8\texport function rng(seed) {\n     9\t  // mulberry32: small, fast, and identical in every engine\n    10\t  let s = seed >>> 0;\n    11\t  return () => {\n    12\t    s = (s + 0x6d2b79f5) | 0;\n    13\t    let t = Math.imul(s ^ (s >>> 15), 1 | s);\n    14\t    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;\n    15\t    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;\n    16\t  };\n    17\t}\n    18\t\n    19\t/** \"3x120\" -> { series: 3, points: 120 } */\n    20\texport function parseSize(size) {\n    21\t  const m = /^(\\d+)x(\\d+)$/.exec(String(size));\n    22\t  if (!m) throw new Error(`size must look like 3x120, got ${size}`);\n    23\t  return { series: Number(m[1]), points: Number(m[2]) };\n    24\t}\n    25\t\n    26\t// Small charts get daily points like a dashboard trend; large ones a point per minute like a metrics feed.\n    27\tconst stepFor = points => (points <= 1000 ? DAY : MINUTE);\n    28\t\n    29\tfunction walk(r, n, base) {\n    30\t  const y = new Float64Array(n);\n    31\t  let v = base;\n    32\t  for (let i = 0; i < n; i++) {\n    33\t    v += (r() - 0.5) * 2;\n    34\t    y[i] = Math.round(v * 100) / 100;\n    35\t  }\n    36\t  return y;\n    37\t}\n    38\t\n    39\tfunction extent(col) {\n    40\t  let lo = Infinity, hi = -Infinity, missing = 0;\n    41\t  for (let i = 0; i < col.length; i++) {\n    42\t    const v = col[i];\n    43\t    if (v !== v) { missing++; continue; }\n    44\t    if (v < lo) lo = v;\n    45\t    if (v > hi) hi = v;\n    46\t  }\n    47\t  return { lo, hi, missing };\n    48\t}\n    49\t\n    50\t/**\n    51\t * One line chart worth of typed columns.\n    52\t * x: Float64Array of epoch milliseconds, strictly increasing, regular step.\n    53\t * ys: one Float64Array per series; NaN marks a missing value.\n    54\t * One extreme value is injected into series 0 so a chart that clips or pins its y range is caught.\n    55\t * With gaps, 5% of each series is removed in runs (contiguous stretches), never at the first or last index or at the extreme.\n    56\t */\n    57\texport function lineFixture({ series, points, gaps = false, seed = 1 }) {\n    58\t  const r = rng(seed);\n    59\t  const step = stepFor(points);\n    60\t  const x = new Float64Array(points);\n    61\t  for (let i = 0; i < points; i++) x[i] = START + i * step;\n    62\t  const ys = [];\n    63\t  for (let s = 0; s < series; s++) ys.push(walk(r, points, 100 + 40 * s));\n    64\t  const extremeIndex = Math.floor(points * 0.37);\n    65\t  {\n    66\t    const { lo, hi } = extent(ys[0]);\n    67\t    ys[0][extremeIndex] = Math.round((hi + (hi - lo) + 1) * 100) / 100;\n    68\t  }\n    69\t  if (gaps) {\n    70\t    const target = Math.round(points * 0.05);\n    71\t    const maxRun = Math.min(50, Math.max(2, Math.round(Math.sqrt(points) / 4)));\n    72\t    for (let s = 0; s < series; s++) {\n    73\t      const col = ys[s];\n    74\t      let removed = 0, guard = 0;\n    75\t      while (removed < target && guard++ < points * 10) {\n    76\t        const len = Math.min(target - removed, 1 + Math.floor(r() * maxRun));\n    77\t        const at = 1 + Math.floor(r() * (points - len - 2));\n    78\t        let ok = true;\n    79\t        for (let i = at - 1; i <= at + len; i++) if (col[i] !== col[i] || (s === 0 && i === extremeIndex)) { ok = false; break; }\n    80\t        if (!ok) continue; // keep runs separate so the count of runs is what was drawn\n    81\t        for (let i = at; i < at + len; i++) col[i] = NaN;\n    82\t        removed += len;\n    83\t      }\n    84\t    }\n    85\t  }\n    86\t  return { x, ys, names: ys.map((_, s) => `s${s}`), step, extreme: { series: 0, index: extremeIndex, x: x[extremeIndex], y: ys[0][extremeIndex] } };\n    87\t}\n    88\t\n    89\t/**\n    90\t * Streaming: an initial window, then `samples` appended points, one series.\n    91\t * The extreme is injected into a streamed sample that stays inside the final window.\n    92\t */\n    93\texport function streamFixture({ window = 600, samples = 300, seed = 2 }) {\n    94\t  const total = window + samples;\n    95\t  const r = rng(seed);\n    96\t  const x = new Float64Array(total);\n    97\t  for (let i = 0; i < total; i++) x[i] = START + i * MINUTE;\n    98\t  const y = walk(r, total, 100);\n    99\t  const extremeIndex = window + Math.floor(samples * 2 / 3);\n   100\t  {\n   101\t    const { lo, hi } = extent(y);\n   102\t    y[extremeIndex] = Math.round((hi + (hi - lo) + 1) * 100) / 100;\n   103\t  }\n   104\t  return {\n   105\t    window, samples, step: MINUTE, names: ['s0'],\n   106\t    initial: { x: x.subarray(0, window), ys: [y.subarray(0, window)] },\n   107\t    stream: { x: x.subarray(window), y: y.subarray(window) },\n   108\t    all: { x, ys: [y] },\n   109\t    extreme: { series: 0, index: extremeIndex, x: x[extremeIndex], y: y[extremeIndex] },\n   110\t  };\n   111\t}\n   112\t\n   113\t/** The data a workload feeds to the chart(s), as a list of line fixtures (one per chart). */\n   114\texport function workloadData(workload, params) {\n   115\t  if (workload === 'first') return [lineFixture({ ...parseSize(params.size), gaps: !!params.gaps, seed: params.seed ?? 1 })];\n   116\t  if (workload === 'page') {\n   117\t    const { series, points } = parseSize(params.size ?? '3x120');\n   118\t    const count = params.charts ?? 24;\n   119\t    return Array.from({ length: count }, (_, i) => lineFixture({ series, points, gaps: !!params.gaps, seed: (params.seed ?? 1) * 1000 + i }));\n   120\t  }\n   121\t  if (workload === 'stream') return [streamFixture({ window: params.window ?? 600, samples: params.samples ?? 300, seed: params.seed ?? 2 })];\n   122\t  if (workload === 'theme') return [lineFixture({ ...parseSize(params.size ?? '3x120'), seed: params.seed ?? 1 })];\n   123\t  if (workload === 'resize') {\n   124\t    const { series, points } = parseSize(params.size ?? '1x100000');\n   125\t    const count = params.charts ?? 1;\n   126\t    return Array.from({ length: count }, (_, i) => lineFixture({ series, points, seed: count === 1 ? (params.seed ?? 1) : (params.seed ?? 1) * 1000 + i }));\n   127\t  }\n   128\t  throw new Error(`unknown workload ${workload}`);\n   129\t}\n   130\t\n   131\t/** What a correct chart must show, derived from the fixture alone. */\n   132\texport function expectedView(fix) {\n   133\t  if (fix.initial) {\n   134\t    // stream: the final window after every sample has been appended\n   135\t    const { x, ys } = fix.all;\n   136\t    const from = x.length - fix.window;\n   137\t    const finalY = ys[0].subarray(from);\n   138\t    const { lo, hi, missing } = extent(finalY);\n   139\t    return { series: 1, points: fix.window, oldestX: x[from], newestX: x[x.length - 1], yMin: lo, yMax: hi, missing: [missing], extreme: fix.extreme };\n   140\t  }\n   141\t  let lo = Infinity, hi = -Infinity;\n   142\t  const missing = [];\n   143\t  for (const col of fix.ys) { const e = extent(col); lo = Math.min(lo, e.lo); hi = Math.max(hi, e.hi); missing.push(e.missing); }\n   144\t  return { series: fix.ys.length, points: fix.x.length, oldestX: fix.x[0], newestX: fix.x[fix.x.length - 1], yMin: lo, yMax: hi, missing, extreme: fix.extreme };\n   145\t}\n   146\t\n   147\t/** FNV-1a over the bytes of every column, so the runner can confirm the page built the same data it expects. */\n   148\texport function checksum(fixtures) {\n   149\t  let h = 0x811c9dc5;\n   150\t  const feed = arr => {\n   151\t    const b = new Uint8Array(arr.buffer, arr.byteOffset, arr.byteLength);\n   152\t    for (let i = 0; i < b.length; i++) { h ^= b[i]; h = Math.imul(h, 0x01000193); }\n   153\t  };\n   154\t  for (const f of fixtures) {\n   155\t    const cols = f.all ? [f.all.x, ...f.all.ys] : [f.x, ...f.ys];\n   156\t    for (const c of cols) feed(c);\n   157\t  }\n   158\t  return (h >>> 0).toString(16).padStart(8, '0');\n   159\t}\n","exit_code":0,"status":"completed"}}
