nd, { ...values, to: write(to) });\n   145\t  });\n   146\t}\n   147\t\n   148\texport function buildReader(input: ReaderInput): ReaderModel {\n   149\t  const { view, title, labelledBy, subtitle, description, formatters, messages, disclosure } = input;\n   150\t  const labels = {\n   151\t    category: input.labels?.category ?? messages.category,\n   152\t    percentage: input.labels?.percentage ?? messages.percentage,\n   153\t    series: input.labels?.series ?? messages.series,\n   154\t    value: input.labels?.value ?? messages.value,\n   155\t    xUnit: input.labels?.xUnit,\n   156\t  };\n   157\t  const type = messages[TYPE_MESSAGE[view.kind]];\n   158\t  const xLabel = view.kind === 'donut' ? labels.category : view.frame.xLabel;\n   159\t  const yLabel = view.kind === 'donut' ? view.frame.valueLabel\n   160\t    : view.kind === 'scatter' ? view.frame.yLabel : view.frame.yLabel || view.frame.series[0]?.field || labels.value;\n   161\t  const titleText = typeof title === 'string' ? title : title?.text;\n   162\t  if (!labelledBy && !titleText && input.diagnostics) report(input.diagnostics, 'AX140', 'none');\n   163\t  const generated = fill(messages.chartName, { type, x: xLabel, y: yLabel });\n   164\t  const name = labelledBy ? '' : titleText || generated;\n   165\t  const compact = input.compact === true || (view.kind !== 'donut' && view.compact);\n   166\t  let references: string[] | undefined;\n   167\t  const referencesForView = () => references ??= referenceText(view, formatters, messages);\n   168\t  const caption = [input.caption, name, generated, messages.plotLabel].find(text => text?.trim()) ?? defaultMessages.plotLabel;\n   169\t  const table = input.table === false || compact ? null : buildTable(\n   170\t    view, [caption, ...referencesForView()].join(' '), formatters, messages, labels, input.locale,\n   171\t  );\n   172\t  const seeTable = table ? messages.seeTable : '';\n   173\t  const omitted = disclosure?.omitted ?? 0;\n   174\t  const changed = disclosure?.changed ?? 0;\n   175\t  const statements: string[] = [];\n   176\t  if (omitted > 0 || changed > 0) {\n   177\t    const counts = { omitted: formatters.count(omitted), changed: formatters.count(changed) };\n   178\t    if (omitted > 0) statements.push(fillWithTable(messages.valuesNotShown, { ...counts, count: counts.omitted }, seeTable));\n   179\t    if (changed > 0) statements.push(fillWithTable(messages.valuesChanged, { ...counts, count: counts.changed }, seeTable));\n   180\t  }\n   181\t  const omission = statements.filter(Boolean).join(' ');\n   182\t  const hidden = input.labelsHidden ?? 0;\n   183\t  const labelsHidden = hidden > 0 ? fillWithTable(messages.labelsHidden, { count: formatters.count(hidden) }, seeTable) : '';\n   184\t  const note = [omission, labelsHidden].filter(Boolean).join(' ') || null;\n   185\t  let summary: string | undefined;\n   186\t  return {\n   187\t    name, note, table,\n   188\t    get summary() {\n   189\t      // Opening the table should not scan the rest of the frame.\n   190\t      return summary ??= [\n   191\t        ...chartText(input, type, xLabel, yLabel, seeTable), compact ? stackText(view, formatters, messages) : '',\n   192\t        ...referencesForView(), subtitle, omission, description,\n   193\t      ].filter(Boolean).join(' ');\n   194\t    },\n   195\t  };\n   196\t}\n   408\t}\n   409\t\n   410\tfunction updateBars(doc: Document, g: Node, mark: RectMark, bindings: PaintBindings, pattern: string | null): void {\n   411\t  // The group carries the color; each <rect> is painted on its own, so overlaps composite like canvas.\n   412\t  // With a pattern, every rectangle is repeated once more, filled with the pattern, after all the fills.\n   413\t  paint(g, 'fill', paintOf(mark.fill, bindings));\n   414\t  const q = mark.xywh;\n   415\t  const count = q.length >> 2;\n   416\t  const total = pattern === null ? count : 2 * count;\n   417\t  if (g.source !== null && g.source[0] === q && g.source[1] === pattern && g.kids.length === total) return;\n   418\t  syncKids(doc, g, total, 'rect');\n   419\t  g.source = [q, pattern];\n   420\t  for (let i = 0; i < total; i++) {\n   421\t    const k = i % count;\n   422\t    const x = q[4 * k]!, y = q[4 * k + 1]!, w = q[4 * k + 2]!, h = q[4 * k + 3]!;\n   423\t    const kid = g.kids[i]!;\n   424\t    const bad = lifted(x) || lifted(y) || lifted(w) || lifted(h);\n   425\t    attr(kid, 'x', bad ? '0' : String(f(w < 0 ? x + w : x)));\n   426\t    attr(kid, 'y', bad ? '0' : String(f(h < 0 ? y + h : y)));\n   427\t    attr(kid, 'width', bad ? '0' : String(f(Math.abs(w))));\n   428\t    attr(kid, 'height', bad ? '0' : String(f(Math.abs(h))));\n   429\t    css(kid, 'fill', i >= count ? pattern : null);\n   430\t  }\n   431\t}\n   432\t\n**Rule.** The range's bounds and numeric value are always kept true to the displayed frame, silently. Its value text is rewritten only when:\n\n1. the reader moves (a key, an assistive adjustment, a pointer or touch selection that takes focus),\n2. the focused datum's own values change (the same x and series now read differently),\n3. the focused datum leaves the frame (the text must then say where focus went), or\n4. the plot regains focus.\n\nAn append that only changes the count or the ordinal of an unchanged datum does not rewrite the text. The position in the text can therefore be out of date until the next of the four events; it is recomputed then.\n\nTo check with a screen reader when one is available (added to decision 0001's list): idle appends with the plot focused are silent; an eviction of the focused point is spoken once; an increment immediately after an append lands on the expected neighbour and reads the current count.\n     1\t/**\n     2\t * Spec DX1, the static half: each documented first chart is ten lines or fewer including the import, counted\n     3\t * as a reader counts them (non-blank lines), and passes no option besides data, fields and the title. The\n     4\t * title is there because without it the chart raises AX140, a warning (spec 3.5), and a first chart should\n     5\t * not print one; first-chart.browser.test.ts shows it is not required. The fixtures and the package READMEs\n     6\t * carry the files verbatim, so examples/first-chart stays the single source.\n     7\t */\n     8\timport { describe, expect, it } from 'vitest';\n     9\timport fs from 'node:fs';\n    10\timport path from 'node:path';\n    11\timport { examples, fixture, repo } from './paths';\n    12\t\n    13\tconst SNIPPETS = [\n    14\t  { file: 'npm.ts', fixture: 'npm', readme: 'packages/axylo/README.md' },\n    15\t  { file: 'script.html', fixture: 'script', readme: 'packages/axylo/README.md' },\n    16\t  { file: 'react.tsx', fixture: 'react', readme: 'packages/react/README.md' },\n    17\t] as const;\n    18\tconst ALLOWED = ['data', 'title', 'x', 'y'];\n    19\t\n    20\tconst read = (file: string): string => fs.readFileSync(path.join(examples, file), 'utf8');\n    21\t\n    22\t/** Option names passed to the chart: keys of the object literal given to line(), or the props of <Line>. */\n    23\tfunction optionNames(file: string, code: string): string[] {\n    24\t  if (file.endsWith('.tsx')) {\n    25\t    const tag = /<Line\\b([^>]*)\\/>/.exec(code);\n    26\t    return tag ? [...tag[1]!.matchAll(/\\b([A-Za-z]+)=/g)].map(m => m[1]!).sort() : [];\n    27\t  }\n    28\t  const call = /\\bline\\(\\s*'[^']*',\\s*\\{([^}]*)\\}\\s*\\)/.exec(code);\n    29\t  return call ? [...call[1]!.matchAll(/\\b([A-Za-z]+)\\s*:/g)].map(m => m[1]!).sort() : [];\n    30\t}\n    31\t\n    32\tdescribe.each(SNIPPETS)('examples/first-chart/$file', snippet => {\n    33\t  const code = read(snippet.file);\n    34\t\n    35\t  it('is ten lines or fewer, counting non-blank lines', () => {\n    36\t    const lines = code.split('\\n').filter(l => l.trim() !== '').length;\n    37\t    console.info(`${snippet.file}: ${lines} non-blank lines`);\n    38\t    expect(lines).toBeLessThanOrEqual(10);\n    39\t  });\n    40\t\n    41\t  it('starts with what loads the library (the import, or the script tag after the document head)', () => {\n    42\t    if (snippet.file === 'script.html') {\n    43\t      expect(code).toMatch(/<script src=\"[^\"]*\\/axylo\\.iife(\\.min)?\\.js\"><\\/script>/);\n    44\t      expect(code).toMatch(/<link rel=\"stylesheet\" href=\"[^\"]*\\/axylo\\.css\">/);\n    45\t    } else {\n    46\t      expect(code.split('\\n')[0]).toMatch(/^import \\{ (Line|line) \\} from '(axylo|@axylo\\/react)';$/);\n    47\t    }\n    48\t  });\n    49\t\n    50\t  it('passes no option besides data, fields and the title', () => {\n    51\t    const names = optionNames(snippet.file, code);\n    52\t    expect(names).toContain('data');\n    53\t    expect(names.filter(n => !ALLOWED.includes(n))).toEqual([]);\n    54\t  });\n    55\t\n    56\t  it('is copied verbatim into its fixture and its package README', () => {\n    57\t    expect(fs.readFileSync(fixture(snippet.fixture, 'example', snippet.file), 'utf8')).toBe(code);\n    58\t    expect(fs.readFileSync(path.join(repo, snippet.readme), 'utf8')).toContain(code);\n    59\t  });\n    60\t});\n     1\t/**\n     2\t * Shared setup for browser tests: a static server over the repository and one Chrome instance.\n     3\t * Tests load test/browser/page.html, which pulls in the built script-tag bundle, and drive it with Playwright.\n     4\t */\n     5\timport { chromium, type Browser, type BrowserContextOptions, type Page } from 'playwright-core';\n     6\timport http from 'node:http';\n     7\timport fs from 'node:fs';\n     8\timport path from 'node:path';\n     9\t\n    10\tconst root = path.resolve(import.meta.dirname, '../../../..');\n    11\tconst types: Record<string, string> = { '.html': 'text/html', '.js': 'text/javascript', '.mjs': 'text/javascript', '.css': 'text/css', '.json': 'application/json', '.png': 'image/png', '.woff2': 'font/woff2' };\n    12\t\n    13\tlet server: http.Server | undefined;\n    14\tlet browser: Browser | undefined;\n    15\tlet base = '';\n    16\t\n    17\texport async function start(): Promise<void> {\n    18\t  server = http.createServer((req, res) => {\n    19\t    const file = path.join(root, decodeURIComponent(new URL(req.url ?? '/', 'http://x').pathname));\n    20\t    if (!file.startsWith(root) || !fs.existsSync(file) || fs.statSync(file).isDirectory()) { res.writeHead(404).end(); return; }\n    21\t    res.writeHead(200, { 'content-type': types[path.extname(file)] ?? 'application/octet-stream' }).end(fs.readFileSync(file));\n    22\t  });\n    23\t  await new Promise<void>(r => server!.listen(0, '127.0.0.1', r));\n    24\t  base = `http://127.0.0.1:${(server.address() as { port: number }).port}`;\n    25\t  browser = await chromium.launch({ channel: 'chrome', headless: true });\n    26\t}\n    27\t\n    28\texport async function stop(): Promise<void> {\n    29\t  await browser?.close();\n    30\t  await new Promise<void>(r => server ? server.close(() => r()) : r());\n    31\t}\n    32\t\n    33\t/** Opens the blank test page with the Axylo script-tag bundle loaded as `window.Axylo`. */\n    34\texport async function openPage(options: BrowserContextOptions & { query?: string } = {}): Promise<Page> {\n    35\t  const { query = '', ...ctx } = options;\n    36\t  const context = await browser!.newContext({ viewport: { width: 900, height: 700 }, locale: 'en-US', timezoneId: 'UTC', ...ctx });\n    37\t  const page = await context.newPage();\n    38\t  const errors: string[] = [];\n    39\t  page.on('pageerror', e => errors.push(String(e)));\n    40\t  (page as Page & { errors: string[] }).errors = errors;\n    41\t  await page.goto(`${base}/packages/axylo/test/browser/page.html${query}`);\n    42\t  return page;\n    43\t}\n    44\t\n    45\texport const url = (p: string): string => `${base}/${p}`;\n    46\t\n    47\t/**\n    48\t * Bundles a TypeScript entry for the browser and opens a page that has run it. The entry talks to the test\n    49\t * through globals it sets on `window`. Use this to test a module in a real browser before the public bundle\n    50\t * exposes it.\n    51\t */\n    52\texport async function openEntry(entry: string, options: BrowserContextOptions & { query?: string; html?: string } = {}): Promise<Page> {\n    53\t  const { build } = await import('esbuild');\n    54\t  const out = path.join(root, 'packages/axylo/test/browser/.out', path.basename(entry).replace(/\\.tsx?$/, '.js'));\n    55\t  await build({ entryPoints: [path.resolve(root, entry)], bundle: true, format: 'iife', target: 'es2022', define: { __DEV__: 'true' }, outfile: out, logLevel: 'silent' });\n    56\t  const { query = '', html, ...ctx } = options;\n    57\t  const context = await browser!.newContext({ viewport: { width: 900, height: 700 }, locale: 'en-US', timezoneId: 'UTC', ...ctx });\n    58\t  const page = await context.newPage();\n    59\t  const errors: string[] = [];\n    60\t  page.on('pageerror', e => errors.push(String(e)));\n    61\t  (page as Page & { errors: string[] }).errors = errors;\n    62\t  await page.goto(`${base}/packages/axylo/test/browser/${html ?? 'blank.html'}${query}`);\n    63\t  await page.addScriptTag({ url: `${base}/${path.relative(root, out)}` });\n    64\t  return page;\n    65\t}\n","exit_code":0,"status":"completed"}}
