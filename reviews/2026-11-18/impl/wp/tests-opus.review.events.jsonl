e plot, the pixel ratio.\n--\npackages/axylo/src/core/controller.ts-1658-}\npackages/axylo/src/core/controller.ts-1659-\npackages/axylo/src/core/controller.ts-1660-function describe(view: View): Omit<ReturnType<BenchHook['describe']>, 'renderer'> {\npackages/axylo/src/core/controller.ts-1661-  if (view.kind === 'donut') {\npackages/axylo/src/core/controller.ts:1662:    return { xDomain: null, yDomain: null, series: [] };\npackages/axylo/src/core/controller.ts-1663-  }\npackages/axylo/src/core/controller.ts-1664-  if (view.kind === 'scatter') {\npackages/axylo/src/core/controller.ts-1665-    return {\npackages/axylo/src/core/controller.ts-1666-      xDomain: view.xDomain, yDomain: view.yDomain,\n75:    yDomain: Span | null;\n1550:        if (!d) return { xDomain: null, yDomain: null, series: [], renderer };\n1662:    return { xDomain: null, yDomain: null, series: [] };\n1666:      xDomain: view.xDomain, yDomain: view.yDomain,\n1674:    xDomain: view.xDomain, yDomain: view.yDomain,\n{\n  \"name\": \"axylo-fixture-npm\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"description\": \"A bundler application that installed the packed axylo tarball. scripts/pack.mjs unpacks it into node_modules; with a registry this would be `npm install ../../.packed/axylo-0.0.0.tgz`.\",\n  \"dependencies\": { \"axylo\": \"file:../../.packed/axylo-0.0.0.tgz\" }\n}\n    86\t        // Make every reader surface format every value: the summary is built at once; open the table too.\n    87\t        await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n    88\t        await settle(page);\n    89\t        // The note follows on a later frame (the formatter fails while the table page is built); the\n    90\t        // production handle has no `ready`, so wait for the note, then assert on it.\n    91\t        await page.waitForFunction(() => document.querySelector<HTMLElement>('#chart .axylo-note')?.hidden === false, null, { timeout: 5000 }).catch(() => undefined);\n    92\t        const note = await noteState(page);\n    93\t        expect(note, JSON.stringify(note)).toMatchObject({ visible: true, insideFigure: true, inTree: true });\n    94\t        expect(note.text).toMatch(/\\b1\\b/);\n    95\t        expect(note.text).toMatch(/table/i);\n    96\t        expect(await closePage(page)).toEqual([]);\n    97\t      });\n    98\t    }\n    99\t  }\n   100\t\n   101\t  it('F12 donut: more than eight slices are grouped into \"Other (n)\" (AX121) and the note says values are shown differently, in the figure and the accessibility tree', async () => {\n   102\t    const page = await devPage();\n   103\t    const values = [30, 20, 15, 10, 8, 6, 5, 4, 3, 2];\n   104\t    const built = await create(page, 'donut', { data: values.map((v, i) => ({ item: `S${i + 1}`, spend: v })) });\n   105\t    expect(built.diagnostics.map(d => d.code)).toContain('AX121');\n   106\t    const note = await noteState(page);\n   107\t    expect(note.visible).toBe(true);\n   108\t    // Three slices (S8–S10) are not drawn as given.\n   109\t    expect(note.text).toMatch(/\\b3\\b/);\n   110\t    expect(note.text).toMatch(/table/i);\n   111\t    expect(note.inTree).toBe(true);\n   112\t    expect(await closePage(page)).toEqual([]);\n    10\t\n    11\t1. A chart is read along its position axis (x for line, area, scatter and vertical bars; y for horizontal bars). The tooltip is placed on the other side of the pointer **across** that axis: above the pointer for a horizontal position axis (below when there is no room above), to the right for a vertical one (left when there is no room). Along the position axis it is centred on the active mark and shifted only as far as needed to stay inside the plot and every clipping ancestor.\n    12\t2. It keeps a clearance from the pointer and from the active mark, so moving along the position axis never enters it, at any speed. Moving straight toward it does not change the nearest datum (the position along the axis is unchanged), so the pointer reaches it with the same content showing: that is what makes it hoverable.\n    13\t3. While the pointer is on the tooltip, the datum is held. Leaving it back into the plot resumes picking; leaving it elsewhere closes it after the usual delay. Escape dismisses it without moving the pointer.\n    14\t4. When neither side across the axis has room (short tiles, compact layouts), the fixed readout under the plot is used instead. The readout has reserved space: it never covers the controls and is never pointer-transparent over them.\n    15\t5. Donut and other two-dimensional picks have no reading axis: the tooltip goes outside the ring toward the nearer edge of the plot, or to the fixed readout when it does not fit.\n    16\t6. A pinned tooltip (click, tap or keyboard) follows the same placement and stays until dismissed or until its datum leaves the displayed frame.\n    17\t\n","exit_code":0,"status":"completed"}}
