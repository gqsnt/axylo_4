{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/test/browser/acceptance/fixtures.ts && rg -n 'dispatchEvent|new (PointerEvent|TouchEvent|KeyboardEvent|WheelEvent|MouseEvent)|\\\\.click\\\\(\\\\)|waitForFunction|catch\\\\(|\\\\.skip|retry' packages/axylo/test/browser/acceptance --glob '*.ts' | rg -v 'locator|button|field|next.click|previous.click|pause.click|resume.click|tip|#chart|next\\\\('\"","aggregated_output":"     1\t/**\n     2\t * Hand-written fixtures for the acceptance suite, small enough to check by eye, and the expected reader\n     3\t * text derived from them with the platform's own formatters (en-US, the harness locale). Nothing here is\n     4\t * taken from what the implementation printed.\n     5\t *\n     6\t * Copied from research/harness/src/data.js where a Phase 1 fixture is named: `dirty` (the combined bad\n     7\t * values) and `bars` (82–97, one long label).\n     8\t */\n     9\t\n    10\texport type ChartType = 'line' | 'area' | 'bar' | 'scatter' | 'donut' | 'compact';\n    11\texport const TYPES: readonly ChartType[] = ['line', 'area', 'bar', 'scatter', 'donut', 'compact'];\n    12\t/** Types with the full reader layer (plot proxy, toolbar, table, tooltip). */\n    13\texport const FULL: readonly ChartType[] = ['line', 'area', 'bar', 'scatter', 'donut'];\n    14\t/** Cartesian full charts. */\n    15\texport const CARTESIAN: readonly ChartType[] = ['line', 'area', 'bar', 'scatter'];\n    16\t/** Charts whose x positions are shared by every series (picking by x / category). */\n    17\texport const ALIGNED: readonly ('line' | 'area' | 'bar')[] = ['line', 'area', 'bar'];\n    18\t\n    19\texport type Variant = 'default' | 'dirty' | 'instants' | 'stacked';\n    20\t\n    21\texport const number = (v: number): string => new Intl.NumberFormat('en-US', { maximumFractionDigits: 6 }).format(v);\n    22\t/** A readout value: the full number, then the unit (reading: separated by one space). */\n    23\texport const withUnit = (v: number, unit: string): string => `${number(v)} ${unit}`;\n    24\t/** Calendar dates as readouts show them (reading: the en-US medium date). */\n    25\texport const calendar = (iso: string): string =>\n    26\t  new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(Date.parse(`${iso}T00:00:00Z`));\n    27\t\n    28\t// ── line and area: energy by site over five calendar days ─────────────────────────────────────────\n    29\t\n    30\texport const ENERGY = {\n    31\t  title: 'Energy use by site',\n    32\t  days: ['2026-03-02', '2026-03-03', '2026-03-04', '2026-03-05', '2026-03-06'],\n    33\t  series: [\n    34\t    { name: 'North', values: [12, 15, 11, 18, 16] },\n    35\t    { name: 'South', values: [7, 9, 13, 8, 10] },\n    36\t  ],\n    37\t  label: 'Energy',\n    38\t  unit: 'kWh',\n    39\t};\n    40\texport const energyRows = (): Record<string, unknown>[] =>\n    41\t  ENERGY.series.flatMap(s => s.values.map((v, i) => ({ day: ENERGY.days[i], site: s.name, energy: v })));\n    42\t\n    43\t// ── bar: shipments per quarter, two series, category x ────────────────────────────────────────────\n    44\t\n    45\texport const SHIPPED = {\n    46\t  title: 'Shipments per quarter',\n    47\t  quarters: ['Q1', 'Q2', 'Q3', 'Q4'],\n    48\t  series: [\n    49\t    { name: 'Plan', values: [40, 45, 50, 55] },\n    50\t    { name: 'Actual', values: [38, 47, 52, 49] },\n    51\t  ],\n    52\t  label: 'Shipped',\n    53\t  unit: 't',\n    54\t};\n    55\texport const shippedRows = (): Record<string, unknown>[] =>\n    56\t  SHIPPED.series.flatMap(s => s.values.map((v, i) => ({ quarter: SHIPPED.quarters[i], kind: s.name, shipped: v })));\n    57\t\n    58\t// ── scatter: latency by payload, two regions, one shared x (20 kB) ────────────────────────────────\n    59\t\n    60\texport const LATENCY = {\n    61\t  title: 'Latency by payload size',\n    62\t  points: [\n    63\t    { size: 10, latency: 120, region: 'EU' }, { size: 20, latency: 140, region: 'EU' }, { size: 30, latency: 135, region: 'EU' },\n    64\t    { size: 15, latency: 90, region: 'US' }, { size: 20, latency: 100, region: 'US' }, { size: 35, latency: 95, region: 'US' },\n    65\t  ],\n    66\t  x: { label: 'Payload', unit: 'kB' },\n    67\t  y: { label: 'Latency', unit: 'ms' },\n    68\t};\n    69\t/** Keyboard order for scatter (spec 3.6): by x, then y. Ties at x = 20 go to the lower y (US 100 before EU 140). */\n    70\texport const LATENCY_ORDER = [...LATENCY.points].sort((a, b) => a.size - b.size || a.latency - b.latency);\n    71\t\n    72\t// ── donut: monthly spend, four slices, shares 50 / 25 / 15 / 10 % ─────────────────────────────────\n    73\t\n    74\texport const SPEND = {\n    75\t  title: 'Monthly spend',\n    76\t  items: ['Rent', 'Food', 'Travel', 'Books'],\n    77\t  values: [1200, 600, 360, 240],\n    78\t  label: 'Spend',\n    79\t  unit: 'EUR',\n    80\t};\n    81\texport const SPEND_TOTAL = SPEND.values.reduce((a, b) => a + b, 0);\n    82\texport const share = (v: number, total = SPEND_TOTAL): string =>\n    83\t  new Intl.NumberFormat('en-US', { style: 'percent', maximumFractionDigits: 1 }).format(v / total);\n    84\t\n    85\t// ── the Phase 1 `dirty` fixture (research/harness/src/data.js) ─────────────────────────────────────\n    86\t\n    87\t/** Mon–Sun: 10, 20, null, NaN, '40', undefined, 70. Left out by a warning: Thu (NaN), Fri ('40'), Sat (absent). */\n    88\texport const DIRTY = {\n    89\t  categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],\n    90\t  values: [10, 20, null, NaN, '40', undefined, 70] as unknown[],\n    91\t  leftOut: 3,\n    92\t};\n    93\t/** Rows as a page would build them; NaN does not survive JSON, so the page rebuilds it (see `dirtyOptions`). */\n    94\texport const dirtyRows = (): Record<string, unknown>[] => DIRTY.categories.map((day, i) =>\n    95\t  DIRTY.values[i] === undefined ? { day } : { day, value: Number.isNaN(DIRTY.values[i]) ? '__NaN__' : DIRTY.values[i] });\n    96\t\n    97\t/** Values arrive in the page through JSON; '__NaN__' is turned back into NaN there (see util `create`). */\n    98\texport const NAN = '__NaN__';\n    99\t\n   100\t/** The options for each chart type (development and production alike). */\n   101\texport function optionsFor(type: ChartType, variant: Variant = 'default'): { fn: string; options: Record<string, unknown> } {\n   102\t  if (variant === 'dirty') return dirtyOptions(type);\n   103\t  if (variant === 'instants') return instantOptions(type);\n   104\t  switch (type) {\n   105\t    case 'line':\n   106\t    case 'area':\n   107\t    case 'compact':\n   108\t      return {\n   109\t        fn: type === 'compact' ? 'line' : type,\n   110\t        options: {\n   111\t          title: ENERGY.title, data: type === 'compact' ? energyRows().filter(r => r.site === 'North') : energyRows(),\n   112\t          x: { field: 'day', type: 'date' }, y: { field: 'energy', label: ENERGY.label, unit: ENERGY.unit },\n   113\t          ...(type === 'compact' ? { compact: true } : { series: 'site' }),\n   114\t          ...(variant === 'stacked' && type === 'area' ? { stacked: true } : {}),\n   115\t        },\n   116\t      };\n   117\t    case 'bar':\n   118\t      return {\n   119\t        fn: 'bar',\n   120\t        options: {\n   121\t          title: SHIPPED.title, data: shippedRows(), x: 'quarter', y: { field: 'shipped', label: SHIPPED.label, unit: SHIPPED.unit }, series: 'kind',\n   122\t          ...(variant === 'stacked' ? { layout: 'stacked' } : {}),\n   123\t        },\n   124\t      };\n   125\t    case 'scatter':\n   126\t      return {\n   127\t        fn: 'scatter',\n   128\t        options: {\n   129\t          title: LATENCY.title, data: LATENCY.points, x: { field: 'size', ...LATENCY.x }, y: { field: 'latency', ...LATENCY.y }, series: 'region',\n   130\t        },\n   131\t      };\n   132\t    case 'donut':\n   133\t      return {\n   134\t        fn: 'donut',\n   135\t        options: {\n   136\t          title: SPEND.title, data: SPEND.items.map((item, i) => ({ item, spend: SPEND.values[i] })), label: 'item',\n   137\t          value: { field: 'spend', label: SPEND.label, unit: SPEND.unit },\n   138\t        },\n   139\t      };\n   140\t  }\n   141\t}\n   142\t\n   143\tfunction dirtyOptions(type: ChartType): { fn: string; options: Record<string, unknown> } {\n   144\t  const title = `Dirty input (${type})`;\n   145\t  if (type === 'scatter') {\n   146\t    // The same seven values as y over x = 1…7.\n   147\t    return { fn: 'scatter', options: { title, data: dirtyRows().map((r, i) => ({ ...r, n: i + 1 })), x: 'n', y: 'value' } };\n   148\t  }\n   149\t  if (type === 'donut') return { fn: 'donut', options: { title, data: dirtyRows(), label: 'day', value: 'value' } };\n   150\t  return { fn: type === 'compact' ? 'line' : type, options: { title, data: dirtyRows(), x: 'day', y: 'value', ...(type === 'compact' ? { compact: true } : {}) } };\n   151\t}\n   152\t\n   153\t/** Instants (epoch ms, `type: 'time'`) shown in Asia/Kolkata: the summary must name the zone (spec A1, F4). */\n   154\texport const ZONE = 'Asia/Kolkata';\n   155\t/** Names Chrome's Intl may give that zone, any of which says which zone the times are in. */\n   156\texport const ZONE_NAMES = ['Asia/Kolkata', 'India Standard Time', 'GMT+5:30', 'IST'];\n   157\tconst DAY = 864e5;\n   158\tconst T0 = Date.UTC(2026, 2, 2);\n   159\tfunction instantOptions(type: ChartType): { fn: string; options: Record<string, unknown> } {\n   160\t  const x = { field: 'at', type: 'time', timeZone: ZONE };\n   161\t  if (type === 'scatter') {\n   162\t    return { fn: 'scatter', options: { title: 'Instants', data: [0, 1, 2].map(i => ({ at: T0 + i * DAY, v: 10 + i })), x, y: 'v' } };\n   163\t  }\n   164\t  return {\n   165\t    fn: type === 'compact' ? 'line' : type,\n   166\t    options: { title: 'Instants', data: [0, 1, 2].map(i => ({ at: T0 + i * DAY, v: 10 + i })), x, y: 'v', ...(type === 'compact' ? { compact: true } : {}) },\n   167\t  };\n   168\t}\n   169\t\n   170\t/** What the generated name names (spec A1: \"Line chart of Sessions by Day\"): the type and the measure. */\n   171\texport const TYPE_WORD: Record<ChartType, string> = { line: 'Line', area: 'Area', bar: 'Bar', scatter: 'Scatter', donut: 'Donut', compact: 'Line' };\n   172\t\n   173\t/** The expected summary statements of each default fixture (spec A1), as text fragments in order. */\n   174\texport function summaryFragments(type: ChartType): string[][] {\n   175\t  switch (type) {\n   176\t    case 'line':\n   177\t    case 'area':\n   178\t      return [\n   179\t        [TYPE_WORD[type]],\n   180\t        [calendar(ENERGY.days[0]!), calendar(ENERGY.days.at(-1)!)],\n   181\t        [withUnit(7, ENERGY.unit), withUnit(18, ENERGY.unit)],\n   182\t        ['North', withUnit(11, 'kWh'), withUnit(18, 'kWh'), withUnit(16, 'kWh')],\n   183\t        ['South', withUnit(7, 'kWh'), withUnit(13, 'kWh'), withUnit(10, 'kWh')],\n   184\t      ];\n   185\t    case 'compact':\n   186\t      return [\n   187\t        ['Line'],\n   188\t        [calendar(ENERGY.days[0]!), calendar(ENERGY.days.at(-1)!)],\n   189\t        [withUnit(11, ENERGY.unit), withUnit(18, ENERGY.unit)],\n   190\t        // One series without a series field: it is named by the value field's label.\n   191\t        [ENERGY.label, withUnit(11, 'kWh'), withUnit(18, 'kWh'), withUnit(16, 'kWh')],\n   192\t      ];\n   193\t    case 'bar':\n   194\t      return [\n   195\t        ['Bar'],\n   196\t        ['Q1', 'Q4'],\n   197\t        [withUnit(38, 't'), withUnit(55, 't')],\n   198\t        ['Plan', withUnit(40, 't'), withUnit(55, 't'), withUnit(55, 't')],\n   199\t        ['Actual', withUnit(38, 't'), withUnit(52, 't'), withUnit(49, 't')],\n   200\t      ];\n   201\t    case 'scatter':\n   202\t      // \"Last\" on a scatter is the point with the largest x (reading: x order, as the keyboard walks it).\n   203\t      return [\n   204\t        ['Scatter'],\n   205\t        [withUnit(10, 'kB'), withUnit(35, 'kB')],\n   206\t        [withUnit(90, 'ms'), withUnit(140, 'ms')],\n   207\t        ['EU', withUnit(120, 'ms'), withUnit(140, 'ms'), withUnit(135, 'ms')],\n   208\t        ['US', withUnit(90, 'ms'), withUnit(100, 'ms'), withUnit(95, 'ms')],\n   209\t      ];\n   210\t    case 'donut':\n   211\t      // A donut has no x or y range; its summary is the type and each slice's value and share (reading).\n   212\t      return [\n   213\t        ['Donut'],\n   214\t        ...SPEND.items.map((item, i) => [item, withUnit(SPEND.values[i]!, SPEND.unit), share(SPEND.values[i]!)]),\n   215\t      ];\n   216\t  }\n   217\t}\n   218\t\n   219\t/** Whether `text` contains every fragment of `group` in order. */\n   220\texport function inOrder(text: string, group: readonly string[]): boolean {\n   221\t  let at = 0;\n   222\t  for (const part of group) {\n   223\t    const i = text.indexOf(part, at);\n   224\t    if (i < 0) return false;\n   225\t    at = i + part.length;\n   226\t  }\n   227\t  return true;\n   228\t}\npackages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts:341:      await page.waitForFunction(() => window.scrollY > 0, null, { timeout: 5000 });\npackages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts:400:      await page.waitForFunction(() => window.scrollY > 0, null, { timeout: 5000 }).catch(() => undefined);\n","exit_code":0,"status":"completed"}}
