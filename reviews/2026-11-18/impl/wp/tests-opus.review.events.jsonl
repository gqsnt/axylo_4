{"type":"item.started","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'for f in tests/dist/{csp.browser.test.ts,browser.ts,pages/charts.ts,pages/observe.js,pages/inject.js,first-chart.browser.test.ts}; do nl -ba \"$f\"; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'for f in tests/dist/{csp.browser.test.ts,browser.ts,pages/charts.ts,pages/observe.js,pages/inject.js,first-chart.browser.test.ts}; do nl -ba \"$f\"; done'","aggregated_output":"     1\t/**\n     2\t * Spec DX8, the browser half: the packed files under a strict Content Security Policy sent as a real\n     3\t * response header, with no 'unsafe-inline' and no 'unsafe-eval' for scripts or styles:\n     4\t *\n     5\t *   default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; report-uri /csp-report\n     6\t *\n     7\t * `script-src 'self'` is all that both the script-tag files and a bundled module need; `style-src 'self'`\n     8\t * admits the linked axylo.css and the page's own stylesheet. Every page draws all five chart types and the\n     9\t * compact variant, opens a tooltip and each table, and must produce no `securitypolicyviolation` event, no\n    10\t * report to the report URI and no console error. Both ways of getting the stylesheet are run: the library\n    11\t * applying it at run time, and the page linking axylo.css. The same pages check that label and formatter\n    12\t * text that looks like markup is inserted as text, and that a target matching nothing throws with the\n    13\t * selector in the message.\n    14\t */\n    15\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n    16\timport path from 'node:path';\n    17\timport { bundle, closeBrowser, drawn, figureName, launch, open, startServer, type Server } from './browser';\n    18\timport { fixture, here } from './paths';\n    19\t\n    20\texport const POLICY = \"default-src 'self'; script-src 'self'; style-src 'self'; object-src 'none'; base-uri 'none'; report-uri /csp-report\";\n    21\tconst IMG = '<img src=x onerror=\"window.__xss=(window.__xss||0)+1\">';\n    22\tconst SCRIPT = '<script>window.__xss=(window.__xss||0)+1</script>';\n    23\tconst CHARTS = ['line', 'area', 'bar', 'scatter', 'donut', 'compact'] as const;\n    24\tconst TITLES: Record<(typeof CHARTS)[number], string> = {\n    25\t  line: `Sessions ${IMG}`, area: `Stacked ${SCRIPT}`, bar: `Revenue ${IMG}`, scatter: `Latency ${SCRIPT}`, donut: `Browsers ${IMG}`, compact: `Compact ${IMG}`,\n    26\t};\n    27\t\n    28\tlet server: Server;\n    29\tconst scripts: Record<string, string> = {};\n    30\tconst pages = path.join(here, 'pages');\n    31\t\n    32\tbeforeAll(async () => {\n    33\t  server = await startServer();\n    34\t  await launch();\n    35\t  scripts.classic = (await bundle({ name: 'csp-charts-classic', cwd: pages, contents: `import { makeCharts, type Library } from './charts';\\nmakeCharts((window as unknown as { Axylo: Library }).Axylo);` })).url;\n    36\t  for (const condition of ['production', 'development']) {\n    37\t    scripts[`module-${condition}`] = (await bundle({\n    38\t      name: `csp-charts-module-${condition}`, cwd: fixture('npm'), format: 'esm', conditions: [condition],\n    39\t      contents: `import * as A from 'axylo';\\nimport { makeCharts } from ${JSON.stringify(path.join(pages, 'charts'))};\\nmakeCharts(A);`,\n    40\t    })).url;\n    41\t  }\n    42\t});\n    43\tafterAll(async () => { await closeBrowser(); await server?.close(); });\n    44\t\n    45\tconst LOADERS = {\n    46\t  'script tag, production (axylo.iife.min.js)': () => `<script src=\"/script/node_modules/axylo/dist/axylo.iife.min.js\"></script><script src=\"${scripts.classic}\"></script>`,\n    47\t  'script tag, development (axylo.iife.js)': () => `<script src=\"/script/node_modules/axylo/dist/axylo.iife.js\"></script><script src=\"${scripts.classic}\"></script>`,\n    48\t  'bundled module, production condition': () => `<script type=\"module\" src=\"${scripts['module-production']}\"></script>`,\n    49\t  'bundled module, development condition': () => `<script type=\"module\" src=\"${scripts['module-development']}\"></script>`,\n    50\t};\n    51\t\n    52\tfunction html(loader: string, linked: boolean): string {\n    53\t  return `<!doctype html>\n    54\t<html lang=\"en\"><head><meta charset=\"utf-8\"><title>Axylo under a strict policy</title>\n    55\t<link rel=\"stylesheet\" href=\"/pages/page.css\">\n    56\t${linked ? '<link rel=\"stylesheet\" href=\"/npm/node_modules/axylo/dist/axylo.css\">' : ''}\n    57\t<script src=\"/pages/observe.js\"></script>\n    58\t</head><body>\n    59\t<h1>Charts under a strict policy</h1>\n    60\t${CHARTS.map(id => `<div class=\"${id === 'compact' ? 'tile' : 'chart'}\" id=\"${id}\"></div>`).join('\\n')}\n    61\t${loader}\n    62\t</body></html>`;\n    63\t}\n    64\t\n    65\tinterface Seen {\n    66\t  violations: unknown[];\n    67\t  created: string[];\n    68\t  xss: unknown;\n    69\t  missing: string | null;\n    70\t  diagnostics: { chart: number; code: string; level: string }[];\n    71\t  adopted: number;\n    72\t  styleElements: number;\n    73\t  linkedActive: boolean;\n    74\t}\n    75\t\n    76\tlet counter = 0;\n    77\tdescribe.each(Object.entries(LOADERS))('%s', (_label, loader) => {\n    78\t  describe.each([['applied at run time', false], ['linked by the page', true]] as const)('stylesheet %s', (_how, linked) => {\n    79\t    it('draws every chart type, opens a tooltip and the tables, with no violation, no console error and no markup created', async () => {\n    80\t      const at = `/csp/page-${++counter}.html`;\n    81\t      server.pages.set(at, { html: html(loader(), linked), headers: { 'content-security-policy': POLICY } });\n    82\t      server.reports.length = 0;\n    83\t      const w = await open(server);\n    84\t      const response = await w.page.goto(`${server.origin}${at}`);\n    85\t      expect(response?.headers()['content-security-policy']).toBe(POLICY);\n    86\t\n    87\t      for (const id of CHARTS) {\n    88\t        const state = await drawn(w.page, `#${id}`);\n    89\t        expect(state.figures, `#${id} figures`).toBe(1);\n    90\t        expect(state.marks, `#${id} marks`).toBeGreaterThan(0);\n    91\t        expect(state.errorState, `#${id} error state`).toBe(false);\n    92\t        // The title is the accessible name, character for character: inserted as text.\n    93\t        expect(await figureName(w.page, `#${id}`), `#${id} name`).toContain(TITLES[id].slice(0, 20));\n    94\t        // A compact chart has no visible heading (spec 3.7); its name is its text alternative.\n    95\t        if (id !== 'compact') expect(await w.page.locator(`#${id} .axylo-title`).first().textContent()).toBe(TITLES[id]);\n    96\t      }\n    97\t\n    98\t      // Tooltips: the series or category name and the formatter output are shown as text. The pointer\n    99\t      // sweeps the plot left to right until the tooltip shows the datum carrying the payload.\n   100\t      for (const [id, expected] of [['line', IMG], ['bar', SCRIPT]] as const) {\n   101\t        await w.page.locator(`#${id} .axylo-plot`).scrollIntoViewIfNeeded();\n   102\t        const plot = (await w.page.locator(`#${id} .axylo-plot`).boundingBox())!;\n   103\t        // Spec I1: content too wide for a floating tooltip goes to the fixed readout under the plot instead,\n   104\t        // which these long payloads cause.\n   105\t        const tip = w.page.locator(`#${id} .axylo-tooltip, #${id} .axylo-readout`).filter({ visible: true });\n   106\t        let text = '';\n   107\t        for (let f = 0.3; f < 0.99 && !text.includes(expected); f += 0.05) {\n   108\t          await w.page.mouse.move(plot.x + plot.width * f, plot.y + plot.height * 0.5);\n   109\t          await w.page.waitForTimeout(50);\n   110\t          if (await tip.count() === 1) text = (await tip.textContent()) ?? '';\n   111\t        }\n   112\t        expect(text, `#${id} tooltip`).toContain(expected);\n   113\t        expect(text, `#${id} tooltip formatter output`).toContain('<img src=x onerror=');\n   114\t        await w.page.mouse.move(2, 2);\n   115\t      }\n   116\t\n   117\t      // Tables.\n   118\t      for (const id of ['line', 'area', 'bar', 'scatter', 'donut'] as const) {\n   119\t        await w.page.locator(`#${id} [role=\"toolbar\"] button`, { hasText: 'View as table' }).click();\n   120\t        const table = w.page.locator(`#${id} table`);\n   121\t        await expect.poll(() => table.count(), { timeout: 5000 }).toBeGreaterThan(0);\n   122\t        expect(await table.first().locator('tr').count(), `#${id} table rows`).toBeGreaterThan(1);\n   123\t        const text = (await table.first().textContent()) ?? '';\n   124\t        if (id !== 'area') expect(text, `#${id} table text`).toMatch(/<img src=x onerror=|<script>/);\n   125\t      }\n   126\t\n   127\t      await w.page.waitForTimeout(300); // reports are sent asynchronously\n   128\t      const seen: Seen = await w.page.evaluate(() => {\n   129\t        const g = window as unknown as Record<string, unknown>;\n   130\t        const charts = (g.__charts as { diagnostics: { code: string; level: string }[] }[] | undefined) ?? [];\n   131\t        const link = Array.from(document.styleSheets).find(s => s.href?.endsWith('/axylo.css'));\n   132\t        return {\n   133\t          violations: g.__violations as unknown[], created: g.__created as string[], xss: g.__xss ?? null, missing: g.__missing as string | null,\n   134\t          diagnostics: charts.flatMap((c, chart) => c.diagnostics.map(d => ({ chart, code: d.code, level: d.level }))),\n   135\t          adopted: document.adoptedStyleSheets.length, styleElements: document.querySelectorAll('style').length,\n   136\t          linkedActive: !!link && !link.disabled,\n   137\t        };\n   138\t      });\n   139\t      const errors = [...w.errors, ...w.console.filter(m => m.type === 'error').map(m => m.text)];\n   140\t      const warnings = w.console.filter(m => m.type === 'warning').map(m => m.text);\n   141\t      if (warnings.length) console.info(`console warnings: ${JSON.stringify(warnings)}`);\n   142\t      console.info(`stylesheets: adopted ${seen.adopted}, <style> ${seen.styleElements}, linked axylo.css active ${seen.linkedActive}`);\n   143\t\n   144\t      expect(seen.violations, 'securitypolicyviolation events').toEqual([]);\n   145\t      expect(server.reports, 'reports sent to the report URI').toEqual([]);\n   146\t      expect(errors, 'console errors and page errors').toEqual([]);\n   147\t      expect(seen.created, 'elements created from markup in text').toEqual([]);\n   148\t      expect(seen.xss, 'payload ran').toBeNull();\n   149\t      expect(seen.diagnostics.filter(d => d.level === 'error')).toEqual([]);\n   150\t      expect(seen.missing, 'error for a selector that matches nothing').toContain('#no-such-chart');\n   151\t      expect(seen.styleElements, 'the library creates no <style> element').toBe(0);\n   152\t      if (linked) {\n   153\t        expect(seen.linkedActive).toBe(true);\n   154\t        expect(seen.adopted, 'nothing adopted when the page links axylo.css').toBe(0);\n   155\t      } else {\n   156\t        expect(seen.adopted, 'the stylesheet adopted at run time').toBe(1);\n   157\t      }\n   158\t      expect(w.external).toEqual([]);\n   159\t      await w.context.close();\n   160\t    });\n   161\t  });\n   162\t});\n   163\t\n   164\tdescribe('the instruments themselves', () => {\n   165\t  it('catch text inserted as HTML: the observer records the element and the policy reports the inline handler and style', async () => {\n   166\t    const at = '/csp/negative-control.html';\n   167\t    server.pages.set(at, {\n   168\t      html: '<!doctype html>\\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>control</title><script src=\"/pages/observe.js\"></script></head><body><script src=\"/pages/inject.js\"></script></body></html>',\n   169\t      headers: { 'content-security-policy': POLICY },\n   170\t    });\n   171\t    server.reports.length = 0;\n   172\t    const w = await open(server);\n   173\t    await w.page.goto(`${server.origin}${at}`);\n   174\t    await w.page.waitForTimeout(500);\n   175\t    const seen = await w.page.evaluate(() => {\n   176\t      const g = window as unknown as Record<string, unknown>;\n   177\t      return { created: g.__created as string[], violations: (g.__violations as { effective: string }[]).map(v => v.effective).sort(), xss: g.__xss ?? null };\n   178\t    });\n   179\t    expect(seen.created.some(e => e.startsWith('<img'))).toBe(true);\n   180\t    expect(seen.violations).toEqual(expect.arrayContaining(['script-src-attr', 'style-src-attr']));\n   181\t    expect(seen.xss).toBeNull();\n   182\t    expect(server.reports.length).toBeGreaterThan(0);\n   183\t    await w.context.close();\n   184\t  });\n   185\t});\n     1\t/**\n     2\t * A local HTTP server over the fixtures and one system Chrome (playwright-core, channel 'chrome', headless)\n     3\t * for the distribution's browser tests. packages/axylo/test/browser/harness.ts is not reused: it serves the\n     4\t * whole repository with no response headers, and these tests need pages served with real headers from the\n     5\t * fixtures only.\n     6\t */\n     7\timport { chromium, type Browser, type BrowserContext, type ConsoleMessage, type Page } from 'playwright-core';\n     8\timport { build } from 'esbuild';\n     9\timport fs from 'node:fs';\n    10\timport http from 'node:http';\n    11\timport path from 'node:path';\n    12\timport { fixture, here, out } from './paths';\n    13\t\n    14\tconst TYPES: Record<string, string> = {\n    15\t  '.html': 'text/html; charset=utf-8', '.js': 'text/javascript; charset=utf-8', '.mjs': 'text/javascript; charset=utf-8',\n    16\t  '.css': 'text/css; charset=utf-8', '.json': 'application/json', '.map': 'application/json',\n    17\t};\n    18\t\n    19\t/** URL prefix → directory. Nothing else on disk is reachable. */\n    20\tconst MOUNTS: Record<string, string> = {\n    21\t  '/npm/': fixture('npm'), '/script/': fixture('script'), '/react/': fixture('react'), '/pages/': path.join(here, 'pages'), '/out/': out,\n    22\t};\n    23\t\n    24\texport interface Server {\n    25\t  origin: string;\n    26\t  /** Generated documents: path → body and response headers. */\n    27\t  pages: Map<string, { html: string; headers?: Record<string, string> }>;\n    28\t  /** Bodies POSTed to /csp-report. */\n    29\t  reports: unknown[];\n    30\t  close(): Promise<void>;\n    31\t}\n    32\t\n    33\texport async function startServer(): Promise<Server> {\n    34\t  const pages = new Map<string, { html: string; headers?: Record<string, string> }>();\n    35\t  const reports: unknown[] = [];\n    36\t  const server = http.createServer((req, res) => {\n    37\t    const pathname = decodeURIComponent(new URL(req.url ?? '/', 'http://x').pathname);\n    38\t    if (req.method === 'POST' && pathname === '/csp-report') {\n    39\t      let body = '';\n    40\t      req.on('data', chunk => { body += chunk; });\n    41\t      req.on('end', () => { try { reports.push(JSON.parse(body)); } catch { reports.push(body); } res.writeHead(204).end(); });\n    42\t      return;\n    43\t    }\n    44\t    const page = pages.get(pathname);\n    45\t    if (page) { res.writeHead(200, { 'content-type': TYPES['.html']!, ...page.headers }).end(page.html); return; }\n    46\t    const mount = Object.keys(MOUNTS).find(p => pathname.startsWith(p));\n    47\t    if (!mount) { res.writeHead(404).end(); return; }\n    48\t    const dir = MOUNTS[mount]!;\n    49\t    const file = path.join(dir, pathname.slice(mount.length));\n    50\t    if (!file.startsWith(dir + path.sep) || !fs.existsSync(file) || fs.statSync(file).isDirectory()) { res.writeHead(404).end(); return; }\n    51\t    res.writeHead(200, { 'content-type': TYPES[path.extname(file)] ?? 'application/octet-stream' }).end(fs.readFileSync(file));\n    52\t  });\n    53\t  await new Promise<void>(resolve => server.listen(0, '127.0.0.1', resolve));\n    54\t  const origin = `http://127.0.0.1:${(server.address() as { port: number }).port}`;\n    55\t  return { origin, pages, reports, close: () => new Promise<void>(resolve => server.close(() => resolve())) };\n    56\t}\n    57\t\n    58\tlet browser: Browser | undefined;\n    59\texport async function launch(): Promise<Browser> {\n    60\t  browser = await chromium.launch({ channel: 'chrome', headless: true });\n    61\t  return browser;\n    62\t}\n    63\texport async function closeBrowser(): Promise<void> {\n    64\t  await browser?.close();\n    65\t  browser = undefined;\n    66\t}\n    67\t\n    68\texport interface Watched {\n    69\t  page: Page;\n    70\t  context: BrowserContext;\n    71\t  console: { type: string; text: string }[];\n    72\t  errors: string[];\n    73\t  /** Requests to any origin but the local server, and whether they were answered. */\n    74\t  external: string[];\n    75\t}\n    76\t\n    77\t/** A fresh context whose only network is the local server (plus routes the caller adds), with console capture. */\n    78\texport async function open(server: Server, setup?: (context: BrowserContext) => Promise<unknown>): Promise<Watched> {\n    79\t  const context = await browser!.newContext({ viewport: { width: 900, height: 700 }, locale: 'en-US', timezoneId: 'UTC' });\n    80\t  const external: string[] = [];\n    81\t  await context.route(url => !url.href.startsWith(server.origin), route => { external.push(route.request().url()); return route.abort(); });\n    82\t  if (setup) await setup(context);\n    83\t  const page = await context.newPage();\n    84\t  const watched: Watched = { page, context, console: [], errors: [], external };\n    85\t  page.on('console', (m: ConsoleMessage) => watched.console.push({ type: m.type(), text: m.text() }));\n    86\t  page.on('pageerror', e => watched.errors.push(String(e)));\n    87\t  return watched;\n    88\t}\n    89\t\n    90\t/** Console lines that a clean first chart must not print. */\n    91\texport const problems = (w: Watched): string[] => [\n    92\t  ...w.errors.map(e => `pageerror: ${e}`),\n    93\t  ...w.console.filter(m => m.type === 'error' || m.type === 'warning').map(m => `${m.type}: ${m.text}`),\n    94\t];\n    95\t\n    96\t/** Bundles an entry for the browser, as an application's bundler would, from inside a fixture. */\n    97\texport async function bundle(options: {\n    98\t  name: string; cwd: string; entry?: string; contents?: string; format?: 'iife' | 'esm'; conditions?: string[]; nodeEnv?: 'development' | 'production';\n    99\t}): Promise<{ url: string; inputs: string[] }> {\n   100\t  const outfile = path.join(out, `${options.name}.js`);\n   101\t  const r = await build({\n   102\t    ...(options.entry ? { entryPoints: [options.entry] } : { stdin: { contents: options.contents!, resolveDir: options.cwd, loader: 'tsx' as const } }),\n   103\t    absWorkingDir: options.cwd, bundle: true, format: options.format ?? 'iife', target: 'es2022', jsx: 'automatic', outfile,\n   104\t    conditions: options.conditions ?? [], metafile: true, logLevel: 'silent',\n   105\t    define: { 'process.env.NODE_ENV': JSON.stringify(options.nodeEnv ?? 'production') },\n   106\t  });\n   107\t  return { url: `/out/${options.name}.js`, inputs: Object.keys(r.metafile.inputs).map(p => path.resolve(options.cwd, p)) };\n   108\t}\n   109\t\n   110\texport interface ChartState {\n   111\t  figures: number;\n   112\t  /** Shapes in the SVG scene that have geometry and are painted with a series color, or painted canvas pixels. */\n   113\t  marks: number;\n   114\t  /** Shapes in the scene that are not series-painted (grid, axes, references). */\n   115\t  other: number;\n   116\t  errorState: boolean;\n   117\t  text: string;\n   118\t}\n   119\t\n   120\t/**\n   121\t * What a chart under `selector` shows. A data mark is told from a gridline by its paint: the SVG renderer\n   122\t * paints every shape through `color` with the unresolved CSS expression of its paint (render/svg.ts,\n   123\t * contracts PaintBindings), so series shapes carry `var(--axylo-series-N)` and the grid `var(--axylo-grid)`.\n   124\t */\n   125\texport async function chartState(page: Page, selector: string): Promise<ChartState> {\n   126\t  return page.evaluate(sel => {\n   127\t    const root = document.querySelector(sel);\n   128\t    if (!root) return { figures: 0, marks: 0, other: 0, errorState: false, text: '' };\n   129\t    let marks = 0;\n   130\t    let other = 0;\n   131\t    for (const el of Array.from(root.querySelectorAll<SVGGraphicsElement>('.axylo-scene path, .axylo-scene rect, .axylo-scene circle, .axylo-scene line, .axylo-scene polyline'))) {\n   132\t      const geometry = el.tagName.toLowerCase() === 'path'\n   133\t        ? (el.getAttribute('d') ?? '').trim().length > 1\n   134\t        : (() => { const b = el.getBBox(); return b.width > 0 || b.height > 0; })();\n   135\t      if (!geometry) continue;\n   136\t      let painted: Element | null = el;\n   137\t      let color = '';\n   138\t      while (painted && painted !== root && !color) { color = (painted as SVGElement).style?.getPropertyValue('color') ?? ''; painted = painted.parentElement; }\n   139\t      if (color.includes('--axylo-series-')) marks++;\n   140\t      else other++;\n   141\t    }\n   142\t    for (const canvas of Array.from(root.querySelectorAll('canvas'))) {\n   143\t      const ctx = canvas.getContext('2d');\n   144\t      if (!ctx || canvas.width === 0 || canvas.height === 0) continue;\n   145\t      const data = ctx.getImageData(0, 0, canvas.width, canvas.height).data;\n   146\t      for (let i = 3; i < data.length; i += 4) if (data[i] !== 0) { marks++; break; }\n   147\t    }\n   148\t    const message = root.querySelector('.axylo-message') as HTMLElement | null;\n   149\t    const errorState = !!message && !message.hidden && getComputedStyle(message).display !== 'none' && (message.textContent ?? '').trim() !== '';\n   150\t    return { figures: root.querySelectorAll('figure').length, marks, other, errorState, text: root.textContent ?? '' };\n   151\t  }, selector);\n   152\t}\n   153\t\n   154\t/** Waits until the chart under `selector` has drawn marks, or the timeout passes; returns its last state. */\n   155\texport async function drawn(page: Page, selector: string, timeout = 10000): Promise<ChartState> {\n   156\t  const until = Date.now() + timeout;\n   157\t  let state = await chartState(page, selector);\n   158\t  while (state.marks === 0 && Date.now() < until) {\n   159\t    await page.waitForTimeout(50);\n   160\t    state = await chartState(page, selector);\n   161\t  }\n   162\t  console.info(`${selector}: ${state.figures} figure(s), ${state.marks} series-painted mark(s), ${state.other} other shape(s)${state.errorState ? ', error state' : ''}`);\n   163\t  return state;\n   164\t}\n   165\t\n   166\t/** The role and accessible name of the first figure under `selector`, as Playwright's accessibility snapshot computes them. */\n   167\texport async function figureName(page: Page, selector: string): Promise<string> {\n   168\t  const snapshot = await page.locator(`${selector} figure`).first().ariaSnapshot();\n   169\t  const first = snapshot.split('\\n')[0] ?? '';\n   170\t  console.info(`${selector}: ${first}`);\n   171\t  return first;\n   172\t}\n     1\t/**\n     2\t * The charts the CSP test pages draw: all five types and the compact variant, with author text that looks\n     3\t * like markup in every place a label or formatter output reaches (title, subtitle, series and category\n     4\t * names, field labels, units, value and tick formatters). Bundled by csp.browser.test.ts into a classic\n     5\t * script (window.Axylo from the script-tag file) and into a module that imports the package from a fixture.\n     6\t */\n     7\texport const IMG = '<img src=x onerror=\"window.__xss=(window.__xss||0)+1\">';\n     8\texport const SCRIPT = '<script>window.__xss=(window.__xss||0)+1</script>';\n     9\t\n    10\ttype Make = (target: string, options: Record<string, unknown>) => { diagnostics: readonly { code: string; level: string }[] };\n    11\texport interface Library { line: Make; area: Make; bar: Make; scatter: Make; donut: Make }\n    12\t\n    13\tconst days = ['2026-03-02', '2026-03-03', '2026-03-04', '2026-03-05', '2026-03-06', '2026-03-07', '2026-03-08'];\n    14\tconst channels = ['Direct', IMG];\n    15\tconst visits = days.flatMap((day, i) => channels.map((channel, c) => ({ day, channel, sessions: 1200 + 150 * i + 400 * c - 90 * (i % 3) })));\n    16\tconst regions = [\n    17\t  { region: 'North', revenue: 182000 }, { region: SCRIPT, revenue: 151000 }, { region: 'South', revenue: 97000 }, { region: 'West', revenue: 120500 },\n    18\t];\n    19\tconst points = Array.from({ length: 40 }, (_, i) => ({ size: 20 + i * 12.5, latency: 80 + ((i * 37) % 23) * 6 + i * 2, kind: i % 2 ? SCRIPT : 'Cached' }));\n    20\tconst shares = [{ browser: IMG, share: 41.2 }, { browser: 'Firefox', share: 22.5 }, { browser: 'Safari', share: 19.8 }, { browser: 'Other', share: 16.5 }];\n    21\tconst valueFormat = (v: number): string => `${IMG}${v}`;\n    22\t// Short, because tick labels take room from the plot: a 50-character tick would leave little to hover.\n    23\texport const TICK = '<img src=x onerror=1>';\n    24\tconst tickFormat = (v: number): string => `${TICK}${v}`;\n    25\t\n    26\texport function makeCharts(A: Library): void {\n    27\t  const w = window as unknown as Record<string, unknown>;\n    28\t  const charts = [\n    29\t    A.line('#line', {\n    30\t      title: `Sessions ${IMG}`, subtitle: SCRIPT, data: visits, x: 'day', series: 'channel',\n    31\t      y: { field: 'sessions', label: `Sessions ${SCRIPT}`, unit: IMG, format: valueFormat, tickFormat },\n    32\t    }),\n    33\t    A.area('#area', { title: `Stacked ${SCRIPT}`, data: visits, x: 'day', series: 'channel', y: { field: 'sessions', format: valueFormat }, stacked: true }),\n    34\t    A.bar('#bar', { title: `Revenue ${IMG}`, data: regions, x: { field: 'region', label: IMG }, y: { field: 'revenue', format: valueFormat, tickFormat } }),\n    35\t    A.scatter('#scatter', { title: `Latency ${SCRIPT}`, data: points, x: { field: 'size', label: SCRIPT }, y: { field: 'latency', unit: 'ms', format: valueFormat }, series: 'kind' }),\n    36\t    A.donut('#donut', { title: `Browsers ${IMG}`, data: shares, label: 'browser', value: { field: 'share', scale: 'percent', format: valueFormat } }),\n    37\t    A.line('#compact', { title: `Compact ${IMG}`, data: visits.filter(r => r.channel === 'Direct'), x: 'day', y: 'sessions', compact: true }),\n    38\t  ];\n    39\t  w.__charts = charts;\n    40\t  try {\n    41\t    A.line('#no-such-chart', { title: 'Missing', data: visits, x: 'day', y: 'sessions' });\n    42\t    w.__missing = null;\n    43\t  } catch (error) {\n    44\t    w.__missing = String((error as Error).message);\n    45\t  }\n    46\t}\n     1\t// Loaded first by the CSP test pages, as an external script (the policy allows no inline script). Records\n     2\t// policy violations, and every element the page gains that could run script or load content from markup\n     3\t// (spec DX8: label and formatter text is inserted as text, never as HTML).\n     4\twindow.__violations = [];\n     5\twindow.__created = [];\n     6\tdocument.addEventListener('securitypolicyviolation', e => {\n     7\t  window.__violations.push({ directive: e.violatedDirective, effective: e.effectiveDirective, blocked: e.blockedURI, source: e.sourceFile, line: e.lineNumber, sample: e.sample });\n     8\t});\n     9\tconst suspicious = el =>\n    10\t  ['IMG', 'IFRAME', 'OBJECT', 'EMBED'].includes(el.tagName.toUpperCase()) ||\n    11\t  (el.tagName.toUpperCase() === 'SCRIPT' && !el.hasAttribute('src')) ||\n    12\t  Array.from(el.attributes).some(a => /^on/i.test(a.name));\n    13\tnew MutationObserver(records => {\n    14\t  for (const r of records) for (const n of r.addedNodes) {\n    15\t    if (n.nodeType !== 1) continue;\n    16\t    for (const el of [n, ...n.querySelectorAll('*')]) if (suspicious(el)) window.__created.push(el.outerHTML.slice(0, 200));\n    17\t  }\n    18\t}).observe(document, { childList: true, subtree: true });\n     1\t// Negative control for csp.browser.test.ts: what a library that inserted label text as HTML would do.\n     2\tdocument.body.insertAdjacentHTML('beforeend', '<img src=x onerror=\"window.__xss=1\"><div style=\"color: red\">inline style</div>');\n     1\t/**\n     2\t * Spec DX1 in a browser: each documented first chart (examples/first-chart, copied verbatim into its\n     3\t * fixture) renders from the packed files in system Chrome: a figure with an accessible name, marks drawn, no\n     4\t * console errors or warnings. Diagnostics of level error or warning print with console.warn in every build\n     5\t * (spec 3.5), so a clean console also means no error diagnostics; the error state is checked as well.\n     6\t * Also: the title is not required (without it the chart still draws and raises only AX140), importing the\n     7\t * package changes nothing in the document (the `sideEffects` claim), and React StrictMode and hydration.\n     8\t */\n     9\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n    10\timport { build } from 'esbuild';\n    11\timport fs from 'node:fs';\n    12\timport path from 'node:path';\n    13\timport { bundle, closeBrowser, drawn, figureName, launch, open, problems, startServer, type Server } from './browser';\n    14\timport { fixture, inside, nodeJson } from './paths';\n    15\t\n    16\tlet server: Server;\n    17\tbeforeAll(async () => { server = await startServer(); await launch(); });\n    18\tafterAll(async () => { await closeBrowser(); await server?.close(); });\n    19\t\n    20\tconst NAME = /^- (group|figure|img) \"Monthly visitors\"/;\n    21\tconst page = (title: string, body: string): string =>\n    22\t  `<!doctype html>\\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>${title}</title></head><body>${body}</body></html>`;\n    23\t\n    24\t/** Every input of ours that esbuild bundled came from the fixture, never from packages/. */\n    25\tfunction fromFixture(inputs: string[], name: 'npm' | 'react'): void {\n    26\t  expect(inputs.filter(p => p.includes(`${path.sep}packages${path.sep}`) && !inside(fixture(name), p))).toEqual([]);\n    27\t}\n    28\t\n    29\tdescribe('npm: examples/first-chart/npm.ts bundled with esbuild from the npm fixture', () => {\n    30\t  for (const [flavour, conditions] of [['production', ['production']], ['development', ['development']]] as const) {\n    31\t    it(`renders under the ${flavour} condition`, async () => {\n    32\t      const { url, inputs } = await bundle({ name: `first-npm-${flavour}`, cwd: fixture('npm'), entry: fixture('npm', 'example/npm.ts'), conditions: [...conditions] });\n    33\t      fromFixture(inputs, 'npm');\n    34\t      expect(inputs).toContain(fixture('npm', 'node_modules/axylo/dist', flavour === 'production' ? 'axylo.js' : 'axylo.dev.js'));\n    35\t      server.pages.set(`/first/npm-${flavour}.html`, { html: page('npm', `<div id=\"chart\"></div><script src=\"${url}\"></script>`) });\n    36\t      const w = await open(server);\n    37\t      await w.page.goto(`${server.origin}/first/npm-${flavour}.html`);\n    38\t      const state = await drawn(w.page, '#chart');\n    39\t      expect(state.figures).toBe(1);\n    40\t      expect(state.marks).toBeGreaterThan(0);\n    41\t      expect(state.errorState).toBe(false);\n    42\t      expect(await figureName(w.page, '#chart')).toMatch(NAME);\n    43\t      expect(problems(w)).toEqual([]);\n    44\t      expect(w.external).toEqual([]);\n    45\t      await w.context.close();\n    46\t    });\n    47\t  }\n    48\t\n    49\t  it('does not require the title: without it the chart draws, with a generated name, and raises only AX140', async () => {\n    50\t    const code = fs.readFileSync(fixture('npm', 'example/npm.ts'), 'utf8');\n    51\t    const untitled = code.replace(\"title: 'Monthly visitors', \", '');\n    52\t    expect(untitled).not.toBe(code);\n    53\t    const { url } = await bundle({ name: 'first-npm-untitled', cwd: fixture('npm'), contents: untitled, conditions: ['production'] });\n    54\t    server.pages.set('/first/npm-untitled.html', { html: page('npm', `<div id=\"chart\"></div><script src=\"${url}\"></script>`) });\n    55\t    const w = await open(server);\n    56\t    await w.page.goto(`${server.origin}/first/npm-untitled.html`);\n    57\t    const state = await drawn(w.page, '#chart');\n    58\t    expect(state.marks).toBeGreaterThan(0);\n    59\t    expect(await figureName(w.page, '#chart')).toMatch(/^- (group|figure|img) \"[^\"]+\"/);\n    60\t    const printed = problems(w);\n    61\t    expect(printed).toHaveLength(1);\n    62\t    expect(printed[0]).toMatch(/^warning: \\[axylo AX140\\]/);\n    63\t    await w.context.close();\n    64\t  });\n    65\t\n    66\t  it('importing the package changes nothing in the document until a chart is created', async () => {\n    67\t    const { url } = await bundle({\n    68\t      name: 'first-npm-import-only', cwd: fixture('npm'), conditions: ['production'],\n    69\t      contents: `import * as axylo from 'axylo';\\n(window as unknown as { axylo: unknown }).axylo = axylo;`,\n    70\t    });\n    71\t    server.pages.set('/first/import-only.html', { html: page('import only', `<div id=\"chart\"></div><script src=\"${url}\"></script>`) });\n    72\t    const w = await open(server);\n    73\t    await w.page.goto(`${server.origin}/first/import-only.html`);\n    74\t    const seen = await w.page.evaluate(() => ({\n    75\t      loaded: typeof (window as unknown as { axylo?: { line?: unknown } }).axylo?.line === 'function',\n    76\t      adopted: document.adoptedStyleSheets.length,\n    77\t      sheets: document.styleSheets.length,\n    78\t      styles: document.querySelectorAll('style').length,\n    79\t      chart: document.getElementById('chart')!.outerHTML,\n    80\t      bodyChildren: document.body.children.length,\n    81\t    }));\n    82\t    expect(seen).toEqual({ loaded: true, adopted: 0, sheets: 0, styles: 0, chart: '<div id=\"chart\"></div>', bodyChildren: 2 });\n    83\t    expect(problems(w)).toEqual([]);\n    84\t    await w.context.close();\n    85\t  });\n    86\t});\n    87\t\n    88\tdescribe('script tag: examples/first-chart/script.html, with the CDN URLs answered from the packed files', () => {\n    89\t  it('renders', async () => {\n    90\t    const CDN = 'https://cdn.jsdelivr.net/npm/axylo/';\n    91\t    const served: string[] = [];\n    92\t    const w = await open(server, context => context.route(`${CDN}**`, route => {\n    93\t      // The CDN serves the published package's files by their path in the tarball.\n    94\t      const rel = route.request().url().slice(CDN.length);\n    95\t      const file = fixture('script', 'node_modules/axylo', rel);\n    96\t      if (!inside(fixture('script', 'node_modules/axylo'), file) || !fs.existsSync(file)) return route.fulfill({ status: 404 });\n    97\t      served.push(rel);\n    98\t      return route.fulfill({ status: 200, contentType: rel.endsWith('.css') ? 'text/css' : 'text/javascript', body: fs.readFileSync(file) });\n    99\t    }));\n   100\t    await w.page.goto(`${server.origin}/script/example/script.html`);\n   101\t    const state = await drawn(w.page, '#chart');\n   102\t    expect(served.sort()).toEqual(['dist/axylo.css', 'dist/axylo.iife.min.js']);\n   103\t    expect(state.figures).toBe(1);\n   104\t    expect(state.marks).toBeGreaterThan(0);\n   105\t    expect(state.errorState).toBe(false);\n   106\t    expect(await figureName(w.page, '#chart')).toMatch(NAME);\n   107\t    expect(problems(w)).toEqual([]);\n   108\t    expect(w.external).toEqual([]);\n   109\t    await w.context.close();\n   110\t  });\n   111\t});\n   112\t\n   113\tdescribe('React: examples/first-chart/react.tsx from the react fixture', () => {\n   114\t  it('renders under StrictMode (setup, cleanup, setup) with one chart left', async () => {\n   115\t    const { url, inputs } = await bundle({ name: 'first-react', cwd: fixture('react'), entry: fixture('react', 'main.tsx'), conditions: ['development'], nodeEnv: 'development' });\n   116\t    fromFixture(inputs, 'react');\n   117\t    expect(inputs).toContain(fixture('react', 'node_modules/@axylo/react/dist/index.dev.js'));\n   118\t    server.pages.set('/first/react.html', { html: page('react', `<div id=\"root\"></div><script src=\"${url}\"></script>`) });\n   119\t    const w = await open(server);\n   120\t    await w.page.goto(`${server.origin}/first/react.html`);\n   121\t    const state = await drawn(w.page, '#root');\n   122\t    expect(state.figures).toBe(1);\n   123\t    expect(state.marks).toBeGreaterThan(0);\n   124\t    expect(state.errorState).toBe(false);\n   125\t    expect(await figureName(w.page, '#root')).toMatch(NAME);\n   126\t    expect(problems(w)).toEqual([]);\n   127\t    await w.context.close();\n   128\t  });\n   129\t\n   130\t  it('hydrates the server-rendered markup without a mismatch and draws', async () => {\n   131\t    const ssr = fixture('react', '.out', 'ssr.mjs');\n   132\t    await build({\n   133\t      entryPoints: [fixture('react', 'ssr.tsx')], bundle: true, platform: 'node', format: 'esm', packages: 'external',\n   134\t      jsx: 'automatic', outfile: ssr, absWorkingDir: fixture('react'), logLevel: 'silent',\n   135\t    });\n   136\t    const { markup } = nodeJson<{ markup: Record<string, string> }>(path.dirname(ssr), [ssr]);\n   137\t    const { url } = await bundle({ name: 'first-react-hydrate', cwd: fixture('react'), entry: fixture('react', 'hydrate.tsx'), conditions: ['development'], nodeEnv: 'development' });\n   138\t    server.pages.set('/first/hydrate.html', { html: page('hydrate', `<div id=\"root\">${markup.MonthlyVisitors}</div><script src=\"${url}\"></script>`) });\n   139\t    const w = await open(server);\n   140\t    await w.page.goto(`${server.origin}/first/hydrate.html`);\n   141\t    const state = await drawn(w.page, '#root');\n   142\t    expect(state.figures).toBe(1);\n   143\t    expect(state.marks).toBeGreaterThan(0);\n   144\t    expect(await figureName(w.page, '#root')).toMatch(NAME);\n   145\t    expect(problems(w)).toEqual([]);\n   146\t    await w.context.close();\n   147\t  });\n   148\t});\n   149\t\n   150\tdescribe('development and production flavours from the packed files (spec 3.5: hints print in development builds only)', () => {\n   151\t  // Every value a plain decimal string: AX104, a hint (spec 3.5), and nothing else.\n   152\t  const consumer = `import { line } from 'axylo';\n   153\tline('#chart', { title: 'Counts', data: [{ day: '2026-01-01', count: '12' }, { day: '2026-01-02', count: '15' }, { day: '2026-01-03', count: '9' }], x: 'day', y: 'count' });`;\n   154\t  for (const [flavour, printed] of [['development', 1], ['production', 0]] as const) {\n   155\t    it(`${flavour}: the AX104 hint is printed ${printed ? 'once' : 'not at all'}, and the chart draws`, async () => {\n   156\t      const { url } = await bundle({ name: `hint-${flavour}`, cwd: fixture('npm'), contents: consumer, conditions: [flavour] });\n   157\t      server.pages.set(`/first/hint-${flavour}.html`, { html: page('hint', `<div id=\"chart\"></div><script src=\"${url}\"></script>`) });\n   158\t      const w = await open(server);\n   159\t      await w.page.goto(`${server.origin}/first/hint-${flavour}.html`);\n   160\t      expect((await drawn(w.page, '#chart')).marks).toBeGreaterThan(0);\n   161\t      const hints = w.console.filter(m => m.text.startsWith('[axylo AX'));\n   162\t      expect(hints.filter(m => m.text.startsWith('[axylo AX104]') && m.type === 'info')).toHaveLength(printed);\n   163\t      expect(hints.filter(m => !m.text.startsWith('[axylo AX104]'))).toEqual([]);\n   164\t      expect(problems(w)).toEqual([]);\n   165\t      await w.context.close();\n   166\t    });\n   167\t  }\n   168\t});\n","exit_code":0,"status":"completed"}}
