  else {\n    28\t        const fraction = Number.isFinite(span) ? half / span : (half / 2) / (scale.domain[1] / 2 - scale.domain[0] / 2);\n    29\t        // An extreme extrapolation still needs to fit the packed scene geometry.\n    30\t        halfWidth = Math.min(fraction * pixels, COORDINATE_LIMIT);\n    31\t      }\n    32\t    }\n    33\t    extents[out++] = center - halfWidth;\n    34\t    extents[out++] = center + halfWidth;\n    35\t  }\n    36\t  return extents;\n    37\t}\n    38\t\n    39\texport function barMarks(view: AlignedView, projection: Bands, plot: Rect): RectMark[] {\n    40\t  const { band, value, horizontal } = projection;\n    41\t  const { start, end } = view.drawSlots[0] ?? view.visibleSlots;\n    42\t  const { stack } = view;\n    43\t  const order = stack?.order ?? view.visible.flatMap((shown, i) => shown ? [i] : []);\n    44\t  const low = horizontal ? plot.y : plot.x;\n    45\t  const high = low + (horizontal ? plot.height : plot.width);\n    46\t  const valueLow = horizontal ? plot.x : plot.y;\n    47\t  const valueHigh = valueLow + (horizontal ? plot.width : plot.height);\n    48\t  const baseline = (v: number) => clamp(position(value, v), valueLow, valueHigh);\n    49\t  const extents = bandExtents(band, view.frame.x.values, start, end, low, high);\n    50\t  const positives = stack?.positive.at(-1);\n    51\t  const negatives = stack?.negative.at(-1);\n    52\t  const divisor = stack ? 1 : order.length;\n    53\t  const bars: RectMark[] = [];\n    54\t  const missing: RectMark[] = [];\n    55\t\n    56\t  for (let i = 0; i < order.length; i++) {\n    57\t    const series = order[i]!;\n    58\t    const { slot, y } = view.frame.series[series]!;\n    59\t    const pos = stack?.positive[i];\n    60\t    const neg = stack?.negative[i];\n    61\t    const prevPos = stack?.positive[i - 1];\n    62\t    const prevNeg = stack?.negative[i - 1];\n    63\t    let valid = 0;\n    64\t    for (let j = start; j < end; j++) if (slot[j] === SLOT_