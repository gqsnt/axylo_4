{"type":"item.completed","item":{"id":"item_25","type":"command_execution","command":"/bin/bash -lc 'for f in tests/dist/{conditions.test.ts,package-contents.test.ts,side-effects.test.ts}; do nl -ba \"$f\"; done'","aggregated_output":"     1\t/**\n     2\t * Development and production flavours (plan 1.6): the `development` export condition and the default\n     3\t * resolve to different files, in Node and in esbuild, and the production file carries none of the code the\n     4\t * source reserves for development.\n     5\t *\n     6\t * Which code is development-only is read from the source, not from the builds: every `if (__DEV__) …`\n     7\t * statement (exactly that condition) in packages/<pkg>/src, plus the bodies of same-file functions that only\n     8\t * such a statement calls. From those regions the test takes string-literal text and property names that\n     9\t * appear nowhere else in the package's source; each must be in the packed development file (so the check\n    10\t * has teeth) and absent from the packed production file. Hint *messages* are not development-only: hints\n    11\t * still reach `diagnostics` and `onDiagnostic` in production (spec 3.5); only their printing is.\n    12\t */\n    13\timport { describe, expect, it } from 'vitest';\n    14\timport { build } from 'esbuild';\n    15\timport fs from 'node:fs';\n    16\timport path from 'node:path';\n    17\timport { fixture, installed, nodeJson, packedJson, repo } from './paths';\n    18\t\n    19\ttype Name = 'axylo' | '@axylo/react';\n    20\tconst SOURCE: Record<Name, string> = { axylo: 'packages/axylo/src', '@axylo/react': 'packages/react/src' };\n    21\tconst FIXTURE: Record<Name, 'npm' | 'react'> = { axylo: 'npm', '@axylo/react': 'react' };\n    22\t\n    23\tconst targetOf = (name: Name, condition: string): string => {\n    24\t  const entry = packedJson(name).exports?.['.'];\n    25\t  if (!entry || typeof entry === 'string' || !entry[condition]) throw new Error(`${name} has no \"${condition}\" export`);\n    26\t  return installed(name, entry[condition]!.replace(/^\\.\\//, ''));\n    27\t};\n    28\t\n    29\t/** Index just past the end of the string, template, comment or regex-free region starting at `i`. */\n    30\tfunction skipLiteral(src: string, i: number): number {\n    31\t  const c = src[i];\n    32\t  if (c === '/' && src[i + 1] === '/') return src.indexOf('\\n', i) === -1 ? src.length : src.indexOf('\\n', i);\n    33\t  if (c === '/' && src[i + 1] === '*') return src.indexOf('*/', i + 2) + 2;\n    34\t  if (c === \"'\" || c === '\"' || c === '`') {\n    35\t    let j = i + 1;\n    36\t    while (j < src.length && src[j] !== c) {\n    37\t      if (src[j] === '\\\\') j++;\n    38\t      else if (c === '`' && src[j] === '$' && src[j + 1] === '{') j = matchBrace(src, j + 1);\n    39\t      j++;\n    40\t    }\n    41\t    return j + 1;\n    42\t  }\n    43\t  return i;\n    44\t}\n    45\t\n    46\t/** Index of the brace that closes the one at `open`. */\n    47\tfunction matchBrace(src: string, open: number): number {\n    48\t  let depth = 0;\n    49\t  for (let i = open; i < src.length; i++) {\n    50\t    const next = skipLiteral(src, i);\n    51\t    if (next !== i) { i = next - 1; continue; }\n    52\t    if (src[i] === '{') depth++;\n    53\t    else if (src[i] === '}' && --depth === 0) return i;\n    54\t  }\n    55\t  throw new Error('unbalanced braces');\n    56\t}\n    57\t\n    58\t/** The [start, end) ranges of `if (__DEV__) …` statements. */\n    59\tfunction devRegions(src: string): [number, number][] {\n    60\t  const regions: [number, number][] = [];\n    61\t  for (const m of src.matchAll(/\\bif\\s*\\(\\s*__DEV__\\s*\\)\\s*/g)) {\n    62\t    const start = m.index!;\n    63\t    let at = start + m[0].length;\n    64\t    if (src[at] === '{') { regions.push([start, matchBrace(src, at) + 1]); continue; }\n    65\t    let depth = 0;\n    66\t    for (; at < src.length; at++) {\n    67\t      const next = skipLiteral(src, at);\n    68\t      if (next !== at) { at = next - 1; continue; }\n    69\t      if ('([{'.includes(src[at]!)) depth++;\n    70\t      else if (')]}'.includes(src[at]!)) depth--;\n    71\t      else if (src[at] === ';' && depth === 0) break;\n    72\t    }\n    73\t    regions.push([start, at + 1]);\n    74\t  }\n    75\t  return regions;\n    76\t}\n    77\t\n    78\t/**\n    79\t * Text a minifier keeps, from esbuild's unminified output: the static parts of string and template literals\n    80\t * (each part up to its first escape) and property names (after a dot, or before a colon). A small lexer, so\n    81\t * that quotes inside comments, templates and regular expressions do not split the code wrongly.\n    82\t */\n    83\tfunction tokens(code: string): Set<string> {\n    84\t  const out = new Set<string>();\n    85\t  const keep = (text: string) => { const head = text.split('\\\\')[0]!; if (head.trim().length >= 5) out.add(head); };\n    86\t  let i = 0;\n    87\t  let previous = '';\n    88\t  const template = (): void => {\n    89\t    // At the opening backtick; leaves i just past the closing one.\n    90\t    let chunk = '';\n    91\t    for (i++; i < code.length && code[i] !== '`'; i++) {\n    92\t      if (code[i] === '\\\\') { chunk += code[i]! + code[i + 1]!; i++; continue; }\n    93\t      if (code[i] === '$' && code[i + 1] === '{') {\n    94\t        keep(chunk); chunk = '';\n    95\t        let depth = 0;\n    96\t        for (i++; i < code.length; i++) {\n    97\t          if (code[i] === '`') { template(); i--; continue; }\n    98\t          if (code[i] === \"'\" || code[i] === '\"') { const q = code[i]; for (i++; code[i] !== q; i++) if (code[i] === '\\\\') i++; continue; }\n    99\t          if (code[i] === '{') depth++;\n   100\t          else if (code[i] === '}' && --depth === 0) break;\n   101\t        }\n   102\t        continue;\n   103\t      }\n   104\t      chunk += code[i];\n   105\t    }\n   106\t    keep(chunk);\n   107\t    i++;\n   108\t  };\n   109\t  while (i < code.length) {\n   110\t    const c = code[i]!;\n   111\t    if (c === '/' && code[i + 1] === '/') { i = code.indexOf('\\n', i); if (i < 0) break; continue; }\n   112\t    if (c === '/' && code[i + 1] === '*') { i = code.indexOf('*/', i + 2) + 2; continue; }\n   113\t    if (c === '/' && (previous === '' || /[(,=:[!&|?{};+\\-*%<>~^]/.test(previous) || /\\b(return|typeof|case|in|of)$/.test(code.slice(Math.max(0, i - 8), i).trimEnd()))) {\n   114\t      let inClass = false;\n   115\t      for (i++; i < code.length; i++) {\n   116\t        if (code[i] === '\\\\') { i++; continue; }\n   117\t        if (code[i] === '[') inClass = true;\n   118\t        else if (code[i] === ']') inClass = false;\n   119\t        else if (code[i] === '/' && !inClass) break;\n   120\t      }\n   121\t      i++; previous = 'x'; continue;\n   122\t    }\n   123\t    if (c === \"'\" || c === '\"') {\n   124\t      let text = '';\n   125\t      for (i++; i < code.length && code[i] !== c; i++) { if (code[i] === '\\\\') { text += code[i]! + code[i + 1]!; i++; } else text += code[i]; }\n   126\t      keep(text); i++; previous = 'x'; continue;\n   127\t    }\n   128\t    if (c === '`') { template(); previous = 'x'; continue; }\n   129\t    if (!/\\s/.test(c)) previous = c;\n   130\t    i++;\n   131\t  }\n   132\t  for (const m of code.matchAll(/\\.\\s*([A-Za-z_$][\\w$]{4,})\\b/g)) out.add(m[1]!);\n   133\t  for (const m of code.matchAll(/\\b([A-Za-z_$][\\w$]{4,})\\s*:/g)) out.add(m[1]!);\n   134\t  return out;\n   135\t}\n   136\t\n   137\t/**\n   138\t * Text that only the development regions contribute: the package's source bundled with __DEV__ true, as is,\n   139\t * against the same source with each `if (__DEV__) …` statement cut out. esbuild only erases types and drops\n   140\t * what is no longer used (a function only those statements called); the regions come from the source.\n   141\t */\n   142\tasync function devOnlyTokens(name: Name): Promise<string[]> {\n   143\t  const dir = path.join(repo, SOURCE[name]);\n   144\t  const bundle = async (cut: boolean) => {\n   145\t    const r = await build({\n   146\t      entryPoints: [path.join(dir, 'index.ts')], bundle: true, write: false, format: 'esm', target: 'es2022', logLevel: 'silent',\n   147\t      define: { __DEV__: 'true' }, external: ['react', 'react/*', 'axylo'], legalComments: 'none', absWorkingDir: repo,\n   148\t      plugins: cut ? [{\n   149\t        name: 'cut-development-regions',\n   150\t        setup(b) {\n   151\t          b.onLoad({ filter: /\\.tsx?$/ }, args => {\n   152\t            if (!args.path.startsWith(dir)) return undefined;\n   153\t            let src = fs.readFileSync(args.path, 'utf8');\n   154\t            for (const [a, z] of devRegions(src).reverse()) src = `${src.slice(0, a)}${src.slice(z)}`;\n   155\t            return { contents: src, loader: args.path.endsWith('x') ? 'tsx' : 'ts' };\n   156\t          });\n   157\t        },\n   158\t      }] : [],\n   159\t    });\n   160\t    return r.outputFiles[0]!.text;\n   161\t  };\n   162\t  const full = tokens(await bundle(false));\n   163\t  const cut = tokens(await bundle(true));\n   164\t  return [...full].filter(t => !cut.has(t));\n   165\t}\n   166\t\n   167\tdescribe.each(['axylo', '@axylo/react'] as const)('%s', name => {\n   168\t  const dev = targetOf(name, 'development');\n   169\t  const prod = targetOf(name, 'default');\n   170\t\n   171\t  it('the development condition and the default name different files with different content', () => {\n   172\t    expect(dev).not.toBe(prod);\n   173\t    expect(fs.readFileSync(dev, 'utf8')).not.toBe(fs.readFileSync(prod, 'utf8'));\n   174\t  });\n   175\t\n   176\t  it('Node resolves the default without conditions and the development file with --conditions=development', () => {\n   177\t    const code = `console.log(JSON.stringify(import.meta.resolve(${JSON.stringify(name)})))`;\n   178\t    const resolve = (args: string[]) => fs.realpathSync(new URL(nodeJson<string>(fixture(FIXTURE[name]), [...args, '--input-type=module', '-e', code])));\n   179\t    expect(resolve([])).toBe(prod);\n   180\t    expect(resolve(['--conditions=development'])).toBe(dev);\n   181\t  });\n   182\t\n   183\t  it('esbuild resolves the development file under the development condition and the default under production', async () => {\n   184\t    const entry = async (conditions: string[]) => {\n   185\t      const r = await build({\n   186\t        stdin: { contents: `export * from ${JSON.stringify(name)};`, resolveDir: fixture(FIXTURE[name]) }, bundle: true, write: false,\n   187\t        metafile: true, format: 'esm', conditions, absWorkingDir: fixture(FIXTURE[name]), external: ['react', 'react/*', ...(name === 'axylo' ? [] : ['axylo'])], logLevel: 'silent',\n   188\t      });\n   189\t      return Object.keys(r.metafile.inputs).map(p => path.resolve(fixture(FIXTURE[name]), p)).filter(p => p === dev || p === prod);\n   190\t    };\n   191\t    expect(await entry(['development'])).toEqual([dev]);\n   192\t    expect(await entry(['production'])).toEqual([prod]);\n   193\t  });\n   194\t\n   195\t  it('neither file refers to the build-time __DEV__ constant', () => {\n   196\t    for (const file of [dev, prod]) expect(fs.readFileSync(file, 'utf8'), file).not.toMatch(/\\b__DEV__\\b/);\n   197\t  });\n   198\t\n   199\t  it('the production file carries none of the development-only text found in the source', async () => {\n   200\t    const found = await devOnlyTokens(name);\n   201\t    console.info(`${name} development-only text: ${JSON.stringify(found)}`);\n   202\t    expect(found.length).toBeGreaterThan(0);\n   203\t    const devCode = fs.readFileSync(dev, 'utf8');\n   204\t    const prodCode = fs.readFileSync(prod, 'utf8');\n   205\t    expect(found.filter(t => !devCode.includes(t)), 'missing from the development file').toEqual([]);\n   206\t    expect(found.filter(t => prodCode.includes(t)), 'present in the production file').toEqual([]);\n   207\t  });\n   208\t});\n     1\t/**\n     2\t * What the tarballs contain against what their package.json promises (plan M7). Expected files are derived\n     3\t * from the packed package.json (`exports`, `types`, `files`), from the declarations those entries import,\n     4\t * and from the documented script-tag files; anything else in the tarball is reported.\n     5\t */\n     6\timport { describe, expect, it } from 'vitest';\n     7\timport fs from 'node:fs';\n     8\timport path from 'node:path';\n     9\timport { exportTargets, installed, manifest, packedJson, repo } from './paths';\n    10\t\n    11\ttype Name = 'axylo' | '@axylo/react';\n    12\tconst NAMES: Name[] = ['axylo', '@axylo/react'];\n    13\t\n    14\t/** npm adds these whatever `files` says. */\n    15\tconst ALWAYS = ['package.json', 'README.md', 'LICENSE'];\n    16\t/**\n    17\t * The script-tag flavours (plan 1.6: a development and a production file; examples/first-chart/script.html\n    18\t * loads the production one). They are not in `exports`, because a bundler never imports them.\n    19\t */\n    20\tconst SCRIPT_TAG: Record<Name, string[]> = { axylo: ['dist/axylo.iife.js', 'dist/axylo.iife.min.js'], '@axylo/react': [] };\n    21\t\n    22\tconst strip = (p: string): string => p.replace(/^\\.\\//, '');\n    23\t\n    24\t/** Declaration files reachable from `entry` through relative imports, and the bare specifiers they import. */\n    25\tfunction declarationClosure(name: Name, entry: string): { files: Set<string>; bare: Set<string>; missing: string[] } {\n    26\t  const files = new Set<string>();\n    27\t  const bare = new Set<string>();\n    28\t  const missing: string[] = [];\n    29\t  const queue = [entry];\n    30\t  while (queue.length) {\n    31\t    const file = queue.pop()!;\n    32\t    if (files.has(file)) continue;\n    33\t    const abs = installed(name, file);\n    34\t    if (!fs.existsSync(abs)) { missing.push(file); continue; }\n    35\t    files.add(file);\n    36\t    const text = fs.readFileSync(abs, 'utf8');\n    37\t    for (const m of text.matchAll(/(?:\\bfrom\\s*|\\bimport\\s*\\(\\s*|\\bimport\\s+)['\"]([^'\"]+)['\"]/g)) {\n    38\t      const spec = m[1]!;\n    39\t      if (!spec.startsWith('.')) { bare.add(spec); continue; }\n    40\t      const base = path.posix.join(path.posix.dirname(file), spec).replace(/\\.(js|d\\.ts|ts)$/, '');\n    41\t      const candidates = [`${base}.d.ts`, `${base}/index.d.ts`];\n    42\t      queue.push(candidates.find(c => fs.existsSync(installed(name, c))) ?? candidates[0]!);\n    43\t    }\n    44\t  }\n    45\t  return { files, bare, missing };\n    46\t}\n    47\t\n    48\tdescribe.each(NAMES)('%s tarball', name => {\n    49\t  const pkg = packedJson(name);\n    50\t  const files = manifest().packages[name].files;\n    51\t\n    52\t  it('is the workspace package.json, unchanged by packing', () => {\n    53\t    const workspace = JSON.parse(fs.readFileSync(path.join(repo, manifest().packages[name].directory, 'package.json'), 'utf8'));\n    54\t    expect(pkg).toEqual(workspace);\n    55\t    expect(pkg.version).toBe('0.0.0');\n    56\t  });\n    57\t\n    58\t  it('contains every file its exports map names, under every condition', () => {\n    59\t    const targets = exportTargets(pkg.exports);\n    60\t    expect(targets.length).toBeGreaterThan(0);\n    61\t    for (const { subpath, condition, target } of targets) {\n    62\t      expect(files, `exports[\"${subpath}\"].${condition} → ${target}`).toContain(strip(target));\n    63\t    }\n    64\t  });\n    65\t\n    66\t  it('contains its top-level types, main and module entries, where declared', () => {\n    67\t    for (const field of ['types', 'main', 'module'] as const) {\n    68\t      const value = (pkg as unknown as Record<string, string | undefined>)[field];\n    69\t      if (value !== undefined) expect(files, `${field}: ${value}`).toContain(strip(value));\n    70\t    }\n    71\t  });\n    72\t\n    73\t  it('matches at least one shipped file with each \"files\" entry', () => {\n    74\t    expect(pkg.files?.length ?? 0).toBeGreaterThan(0);\n    75\t    for (const entry of pkg.files ?? []) {\n    76\t      const e = strip(entry).replace(/\\/$/, '');\n    77\t      expect(files.some(f => f === e || f.startsWith(`${e}/`)), `files entry ${entry}`).toBe(true);\n    78\t    }\n    79\t  });\n    80\t\n    81\t  it('ships a README and the MIT LICENSE', () => {\n    82\t    expect(files).toContain('README.md');\n    83\t    expect(files).toContain('LICENSE');\n    84\t  });\n    85\t\n    86\t  it('ships the declarations its types entries import, and they import only peers', () => {\n    87\t    const typeEntries = exportTargets(pkg.exports).filter(t => t.condition === 'types').map(t => strip(t.target));\n    88\t    expect(typeEntries.length).toBeGreaterThan(0);\n    89\t    for (const entry of typeEntries) {\n    90\t      const { bare, missing } = declarationClosure(name, entry);\n    91\t      expect(missing, `declarations imported from ${entry} but not shipped`).toEqual([]);\n    92\t      const allowed = new Set(Object.keys(pkg.peerDependencies ?? {}));\n    93\t      for (const spec of bare) {\n    94\t        const root = spec.startsWith('@') ? spec.split('/').slice(0, 2).join('/') : spec.split('/')[0]!;\n    95\t        expect(allowed.has(root), `${entry} imports ${spec}, which is not a peer dependency`).toBe(true);\n    96\t      }\n    97\t    }\n    98\t  });\n    99\t\n   100\t  it('ships nothing that is not an entry, a declaration an entry imports, a script-tag file or npm metadata', () => {\n   101\t    const expected = new Set<string>(ALWAYS);\n   102\t    for (const { condition, target } of exportTargets(pkg.exports)) {\n   103\t      expected.add(strip(target));\n   104\t      if (condition === 'types') for (const f of declarationClosure(name, strip(target)).files) expected.add(f);\n   105\t    }\n   106\t    for (const f of SCRIPT_TAG[name]) expected.add(f);\n   107\t    expect(files.filter(f => !expected.has(f))).toEqual([]);\n   108\t  });\n   109\t\n   110\t  it('ships no source, tests, source maps or build state', () => {\n   111\t    const forbidden = files.filter(f =>\n   112\t      /^src\\//.test(f) || /(^|\\/)(test|tests|__tests__)\\//.test(f) || /\\.(test|spec)\\./.test(f) || /\\.map$/.test(f) ||\n   113\t      /\\.tsbuildinfo$/.test(f) || (/\\.tsx?$/.test(f) && !/\\.d\\.ts$/.test(f)));\n   114\t    expect(forbidden).toEqual([]);\n   115\t    for (const f of files.filter(f => /\\.js$/.test(f))) {\n   116\t      expect(fs.readFileSync(installed(name, f), 'utf8'), `${f} refers to a source map`).not.toMatch(/sourceMappingURL/);\n   117\t    }\n   118\t  });\n   119\t\n   120\t  if (name === 'axylo') {\n   121\t    it('ships both script-tag flavours', () => {\n   122\t      for (const f of SCRIPT_TAG.axylo) expect(files).toContain(f);\n   123\t    });\n   124\t  }\n   125\t});\n     1\t/**\n     2\t * `sideEffects` in each package.json is a promise to bundlers. Two halves are checked:\n     3\t * - what the promise buys: a consumer that imports a package and uses nothing gets an empty bundle\n     4\t *   (measured with esbuild, minified, production condition, from the fixtures);\n     5\t * - that it is true: importing the JavaScript has no effect (no globals in Node: node.test.ts; no change to\n     6\t *   the document in a browser: first-chart.browser.test.ts), while the stylesheet subpath, which exists only\n     7\t *   for its effect, survives a side-effect import.\n     8\t */\n     9\timport { describe, expect, it } from 'vitest';\n    10\timport { build } from 'esbuild';\n    11\timport fs from 'node:fs';\n    12\timport path from 'node:path';\n    13\timport { fixture, out, packedJson } from './paths';\n    14\t\n    15\tconst bundle = async (contents: string, cwd: string, extra: Parameters<typeof build>[0] = {}) => {\n    16\t  const r = await build({\n    17\t    stdin: { contents, resolveDir: cwd, loader: 'ts' }, absWorkingDir: cwd, bundle: true, minify: true, format: 'esm',\n    18\t    write: false, conditions: ['production'], logLevel: 'silent', outdir: path.join(out, 'side-effects'), ...extra,\n    19\t  });\n    20\t  return r.outputFiles ?? [];\n    21\t};\n    22\t\n    23\tdescribe('a consumer that imports and uses nothing', () => {\n    24\t  for (const [name, cwd, external] of [\n    25\t    ['axylo', fixture('npm'), []],\n    26\t    ['@axylo/react', fixture('react'), ['react', 'react/*']],\n    27\t  ] as const) {\n    28\t    for (const statement of [`import ${JSON.stringify(name)};`, `import * as unused from ${JSON.stringify(name)};`]) {\n    29\t      it(`${name}: \"${statement}\" bundles to nothing`, async () => {\n    30\t        const files = await bundle(statement, cwd, { external: [...external] });\n    31\t        const bytes = files.reduce((n, f) => n + f.contents.length, 0);\n    32\t        console.info(`${name} \"${statement}\": ${bytes} bytes minified`);\n    33\t        expect(files.map(f => f.text.trim()).join('')).toBe('');\n    34\t      });\n    35\t    }\n    36\t  }\n    37\t});\n    38\t\n    39\tdescribe('the stylesheet subpath', () => {\n    40\t  it('is the only file either package declares as having side effects', () => {\n    41\t    expect(packedJson('@axylo/react').sideEffects).toBe(false);\n    42\t    const declared = packedJson('axylo').sideEffects;\n    43\t    expect(Array.isArray(declared)).toBe(true);\n    44\t    for (const pattern of declared as string[]) expect(pattern).toMatch(/\\.css$/);\n    45\t  });\n    46\t\n    47\t  it('declares itself in exports', () => {\n    48\t    expect(packedJson('axylo').exports?.['./axylo.css']).toBe('./dist/axylo.css');\n    49\t  });\n    50\t\n    51\t  it('survives `import \"axylo/axylo.css\"` in a bundler, so sideEffects does not tell bundlers to drop it', async () => {\n    52\t    const files = await bundle(`import 'axylo/axylo.css';`, fixture('npm'));\n    53\t    const css = files.find(f => f.path.endsWith('.css'));\n    54\t    const shipped = fs.readFileSync(fixture('npm', 'node_modules/axylo/dist/axylo.css'), 'utf8');\n    55\t    expect(css, 'no CSS output: the import was dropped').toBeDefined();\n    56\t    // Minified by the consumer's bundler, so compared by a rule every stylesheet of the library has.\n    57\t    expect(shipped).toContain('--axylo-stylesheet');\n    58\t    expect(css!.text).toContain('--axylo-stylesheet');\n    59\t  });\n    60\t});\n","exit_code":0,"status":"completed"}}
