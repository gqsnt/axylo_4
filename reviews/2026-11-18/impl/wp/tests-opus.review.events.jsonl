{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/acceptance/type-matrix.browser.test.ts'","aggregated_output":"     1\t/**\n     2\t * The type matrix (spec 3.6), every cell about rendered or interactive behaviour: picking by pointer,\n     3\t * tooltip content, keyboard order, zoom, dense drawing (the rendered half), the limit that raises a\n     4\t * diagnostic, and reference lines and bands.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport {\n    10\t  axOf, box, center, closePage, create, createRaw, devPage, plotGeometry, ring, settle, shapes, signature, valueText,\n    11\t} from './util';\n    12\timport { calendar, ENERGY, inOrder, LATENCY_ORDER, share, SHIPPED, SPEND, withUnit } from './fixtures';\n    13\t\n    14\tbeforeAll(start);\n    15\tafterAll(stop);\n    16\t\n    17\tconst tip = async (page: Page) => ((await page.locator('#chart .axylo-tooltip').isVisible()) ? (await page.locator('#chart .axylo-tooltip').textContent()) ?? '' : '');\n    18\tconst xDomain = (page: Page) => page.evaluate(() => (window as unknown as { charts: { __bench: { describe(): { xDomain: number[] | null; yDomain: number[] | null } } }[] }).charts[0]!.__bench.describe());\n    19\t\n    20\t// ── picking ───────────────────────────────────────────────────────────────────────────────────────\n    21\t\n    22\tdescribe('T-pointer: picking by pointer', () => {\n    23\t  for (const type of ['line', 'area'] as const) {\n    24\t    it(`T-pointer-${type}: the pointer picks the nearest x: 30 % of the way from one day to the next shows the first, 70 % the second`, async () => {\n    25\t      const page = await devPage();\n    26\t      await create(page, type);\n    27\t      const xs = ((await shapes(page, '#chart', 14))[1] ?? []).map(s => center(s.box).x).sort((a, b) => a - b);\n    28\t      expect(xs).toHaveLength(5);\n    29\t      const p = await box(page, '#chart .axylo-proxy');\n    30\t      for (const [f, want] of [[0.3, 1], [0.7, 2]] as const) {\n    31\t        // From outside the chart each time, so the last tooltip is not under the pointer.\n    32\t        await page.mouse.move(0, 0);\n    33\t        await settle(page);\n    34\t        await page.mouse.move(xs[1]! + f * (xs[2]! - xs[1]!), p.y + 5);\n    35\t        await settle(page);\n    36\t        expect(await tip(page)).toContain(calendar(ENERGY.days[want]!));\n    37\t      }\n    38\t      expect(await closePage(page)).toEqual([]);\n    39\t    });\n    40\t  }\n    41\t\n    42\t  it('T-pointer-bar: the band under the pointer is picked, even at its edge and away from the bars', async () => {\n    43\t    const page = await devPage();\n    44\t    await create(page, 'bar');\n    45\t    const rects = (await shapes(page, '#chart', 100000));\n    46\t    const plan = (rects[1] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n    47\t    const actual = (rects[2] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n    48\t    const p = await box(page, '#chart .axylo-proxy');\n    49\t    // The band of Q2 runs from half-way between Q1 and Q2 to half-way between Q2 and Q3.\n    50\t    const left = (actual[0]!.x + actual[0]!.width + plan[1]!.x) / 2, right = (actual[1]!.x + actual[1]!.width + plan[2]!.x) / 2;\n    51\t    for (const x of [left + 2, right - 2, plan[1]!.x + 1]) {\n    52\t      await page.mouse.move(0, 0);\n    53\t      await settle(page);\n    54\t      await page.mouse.move(x, p.y + 4);\n    55\t      await settle(page);\n    56\t      const text = await tip(page);\n    57\t      expect(text, `at ${x}`).toContain('Q2');\n    58\t      expect(text).not.toContain('Q1');\n    59\t      expect(text).not.toContain('Q3');\n    60\t    }\n    61\t    expect(await closePage(page)).toEqual([]);\n    62\t  });\n    63\t\n    64\t  it('T-pointer-donut: the slice under the pointer is picked; the hole and the outside pick nothing', async () => {\n    65\t    const page = await devPage();\n    66\t    await create(page, 'donut');\n    67\t    const g = await ring(page);\n    68\t    const total = SPEND.values.reduce((a, b) => a + b, 0);\n    69\t    let before = 0;\n    70\t    for (let i = 0; i < 4; i++) {\n    71\t      const a = 2 * Math.PI * (before + SPEND.values[i]! / 2) / total;\n    72\t      before += SPEND.values[i]!;\n    73\t      await page.mouse.move(0, 0);\n    74\t      await settle(page);\n    75\t      await page.mouse.move(g.cx + 0.85 * g.outer * Math.sin(a), g.cy - 0.85 * g.outer * Math.cos(a));\n    76\t      await settle(page);\n    77\t      expect(await tip(page)).toContain(SPEND.items[i]!);\n    78\t    }\n    79\t    await page.mouse.move(g.cx, g.cy);\n    80\t    await settle(page);\n    81\t    expect(await tip(page)).toBe('');\n    82\t    await page.mouse.move(g.cx + g.outer * 1.2, g.cy + g.outer * 0.9);\n    83\t    await settle(page);\n    84\t    expect(await tip(page)).toBe('');\n    85\t    expect(await closePage(page)).toEqual([]);\n    86\t  });\n    87\t\n    88\t  it('T-pointer-scatter: the nearest point within 24 px is picked, nothing beyond 24 px, and a tie goes to the later row', async () => {\n    89\t    const page = await devPage();\n    90\t    // Two points one x unit apart at the same y, with points far to each side so neither sits on an edge.\n    91\t    await createRaw(page, 'scatter', { title: 'Tie', data: [{ x: 0, y: 0, s: 'far' }, { x: 20, y: 5, s: 'first' }, { x: 21, y: 5, s: 'second' }, { x: 40, y: 9, s: 'far' }], x: 'x', y: 'y', series: 's' });\n    92\t    const drawn = await shapes(page, '#chart', 14);\n    93\t    const a = center(drawn[2]![0]!.box), b = center(drawn[3]![0]!.box);\n    94\t    await page.mouse.move(a.x - 3, a.y);\n    95\t    await settle(page);\n    96\t    expect(await tip(page)).toContain('first');\n    97\t    // Exactly between the two: a tie, so the later row (\"second\").\n    98\t    await page.mouse.move(0, 0);\n    99\t    await settle(page);\n   100\t    await page.mouse.move((a.x + b.x) / 2, (a.y + b.y) / 2);\n   101\t    await settle(page);\n   102\t    const text = await tip(page);\n   103\t    expect(text).toContain('second');\n   104\t    expect(text).not.toContain('first');\n   105\t    // 30 px above the first point: beyond 24 px of every point (from outside, so no tooltip is under it).\n   106\t    await page.mouse.move(0, 0);\n   107\t    await settle(page);\n   108\t    await page.mouse.move(a.x, a.y - 30);\n   109\t    await settle(page);\n   110\t    expect(await tip(page)).toBe('');\n   111\t    expect(await closePage(page)).toEqual([]);\n   112\t  });\n   113\t});\n   114\t\n   115\t// ── tooltip content ───────────────────────────────────────────────────────────────────────────────\n   116\t\n   117\tdescribe('T-tooltip: tooltip content', () => {\n   118\t  it('T-tooltip-line: every visible series at that x, and not a hidden one', async () => {\n   119\t    const page = await devPage();\n   120\t    await create(page, 'line');\n   121\t    const p = await box(page, '#chart .axylo-proxy');\n   122\t    const xs = ((await shapes(page, '#chart', 14))[1] ?? []).map(s => center(s.box).x).sort((a, b) => a - b);\n   123\t    await page.mouse.move(xs[3]!, p.y + 5);\n   124\t    await settle(page);\n   125\t    expect(inOrder(await tip(page), [calendar(ENERGY.days[3]!), 'North', withUnit(18, 'kWh'), 'South', withUnit(8, 'kWh')])).toBe(true);\n   126\t    await page.locator('#chart .axylo-legend-entry', { hasText: 'South' }).click();\n   127\t    await settle(page);\n   128\t    await page.mouse.move(xs[3]!, p.y + 6);\n   129\t    await settle(page);\n   130\t    const text = await tip(page);\n   131\t    expect(text).toContain('North');\n   132\t    expect(text).not.toContain('South');\n   133\t    expect(await closePage(page)).toEqual([]);\n   134\t  });\n   135\t\n   136\t  it('T-tooltip-area: every visible series at that x, plus the stack total', async () => {\n   137\t    const page = await devPage();\n   138\t    await create(page, 'area', {}, '#chart', 'stacked');\n   139\t    const p = await box(page, '#chart .axylo-proxy');\n   140\t    const xs = ((await shapes(page, '#chart', 14))[1] ?? []).map(s => center(s.box).x).sort((a, b) => a - b);\n   141\t    await page.mouse.move(xs[1]!, p.y + 5);\n   142\t    await settle(page);\n   143\t    // Day 2: North 15, South 9, total 24.\n   144\t    expect(inOrder(await tip(page), [calendar(ENERGY.days[1]!), 'North', withUnit(15, 'kWh'), 'South', withUnit(9, 'kWh')])).toBe(true);\n   145\t    expect(await tip(page)).toMatch(new RegExp(`Total\\\\s*${withUnit(24, 'kWh')}`));\n   146\t    expect(await closePage(page)).toEqual([]);\n   147\t  });\n   148\t\n   149\t  it('T-tooltip-bar: every series in that category', async () => {\n   150\t    const page = await devPage();\n   151\t    await create(page, 'bar');\n   152\t    const plan = ((await shapes(page, '#chart', 100000))[1] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n   153\t    const p = await box(page, '#chart .axylo-proxy');\n   154\t    await page.mouse.move(plan[2]!.x + plan[2]!.width / 2, p.y + 4);\n   155\t    await settle(page);\n   156\t    expect(inOrder(await tip(page), ['Q3', 'Plan', withUnit(50, 't'), 'Actual', withUnit(52, 't')])).toBe(true);\n   157\t    expect(await closePage(page)).toEqual([]);\n   158\t  });\n   159\t\n   160\t  it('T-tooltip-donut: label, value and percentage', async () => {\n   161\t    const page = await devPage();\n   162\t    await create(page, 'donut');\n   163\t    const g = await ring(page);\n   164\t    const a = 2 * Math.PI * (1200 + 600 / 2) / 2400;\n   165\t    await page.mouse.move(g.cx + 0.85 * g.outer * Math.sin(a), g.cy - 0.85 * g.outer * Math.cos(a));\n   166\t    await settle(page);\n   167\t    expect(inOrder(await tip(page), ['Food', withUnit(600, 'EUR'), share(600)])).toBe(true);\n   168\t    expect(await closePage(page)).toEqual([]);\n   169\t  });\n   170\t\n   171\t  it('T-tooltip-scatter: the point\\'s series, x and y; ten coincident points list eight and \"+2 more\"', async () => {\n   172\t    const page = await devPage();\n   173\t    await create(page, 'scatter');\n   174\t    const eu = ((await shapes(page, '#chart', 14))[1] ?? []).map(s => center(s.box)).sort((a, b) => a.x - b.x);\n   175\t    await page.mouse.move(eu[1]!.x, eu[1]!.y);\n   176\t    await settle(page);\n   177\t    // Its series, x and y (spec 3.6 lists what, not in which order).\n   178\t    for (const part of ['EU', withUnit(20, 'kB'), withUnit(140, 'ms')]) expect(await tip(page)).toContain(part);\n   179\t    await page.close();\n   180\t    const many = await devPage();\n   181\t    await createRaw(many, 'scatter', { title: 'Same place', data: [...Array.from({ length: 10 }, (_, i) => ({ x: 5, y: 5, s: `S${i + 1}` })), { x: 1, y: 1, s: 'S1' }, { x: 9, y: 9, s: 'S1' }], x: 'x', y: 'y', series: 's' });\n   182\t    const p = await box(many, '#chart .axylo-proxy');\n   183\t    await many.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   184\t    await settle(many);\n   185\t    expect(await many.locator('#chart .axylo-tooltip .axylo-tooltip-row').count()).toBe(8);\n   186\t    expect(await tip(many)).toContain('+2 more');\n   187\t    expect(await closePage(many)).toEqual([]);\n   188\t  });\n   189\t});\n   190\t\n   191\t// ── keyboard order ────────────────────────────────────────────────────────────────────────────────\n   192\t\n   193\tdescribe('T-keyboard: keyboard order', () => {\n   194\t  const orders: Record<string, { type: 'line' | 'area' | 'bar' | 'scatter' | 'donut'; first: string[]; stops: string[][] }> = {\n   195\t    'T-keyboard-line': { type: 'line', first: [], stops: ENERGY.days.map(d => [calendar(d), 'North', 'South']) },\n   196\t    'T-keyboard-area': { type: 'area', first: [], stops: ENERGY.days.map(d => [calendar(d), 'North', 'South']) },\n   197\t    'T-keyboard-bar': { type: 'bar', first: [], stops: SHIPPED.quarters.map(q => [q, 'Plan', 'Actual']) },\n   198\t    'T-keyboard-scatter': { type: 'scatter', first: [], stops: LATENCY_ORDER.map(p => [p.region, withUnit(p.size, 'kB'), withUnit(p.latency, 'ms')]) },\n   199\t    'T-keyboard-donut': { type: 'donut', first: [], stops: SPEND.items.map(i => [i]) },\n   200\t  };\n   201\t  const rule = { line: 'by x, then series', area: 'by x, then series', bar: 'by category, then series', scatter: 'by x, then y (x = 20 kB: 100 ms before 140 ms)', donut: 'by slice order' };\n   202\t  for (const [id, o] of Object.entries(orders)) {\n   203\t    it(`${id}: Right walks ${rule[o.type]}; Left walks back in reverse`, async () => {\n   204\t      const page = await devPage();\n   205\t      await create(page, o.type);\n   206\t      await page.focus('#chart .axylo-proxy');\n   207\t      const forwards = [await valueText(page)];\n   208\t      for (let i = 1; i < o.stops.length; i++) { await page.keyboard.press('ArrowRight'); forwards.push(await valueText(page)); }\n   209\t      o.stops.forEach((s, i) => expect(inOrder(forwards[i]!, s), `${i}: ${forwards[i]}`).toBe(true));\n   210\t      const backwards = [await valueText(page)];\n   211\t      for (let i = 1; i < o.stops.length; i++) { await page.keyboard.press('ArrowLeft'); backwards.push(await valueText(page)); }\n   212\t      expect(backwards).toEqual([...forwards].reverse());\n   213\t      if (o.type === 'line' || o.type === 'area' || o.type === 'bar') {\n   214\t        // \"Then series\": from all series at the first x, Down goes to the first series, Down again to the second.\n   215\t        await page.keyboard.press('ArrowDown');\n   216\t        const one = await valueText(page);\n   217\t        await page.keyboard.press('ArrowDown');\n   218\t        const two = await valueText(page);\n   219\t        expect(one).toContain(o.stops[0]![1]!);\n   220\t        expect(one).not.toContain(o.stops[0]![2]!);\n   221\t        expect(two).toContain(o.stops[0]![2]!);\n   222\t      }\n   223\t      expect(await closePage(page)).toEqual([]);\n   224\t    });\n   225\t  }\n   226\t});\n   227\t\n   228\t// ── zoom ──────────────────────────────────────────────────────────────────────────────────────────\n   229\t\n   230\tdescribe('T-zoom', () => {\n   231\t  for (const type of ['line', 'area', 'scatter'] as const) {\n   232\t    it(`T-zoom-${type}: ${type === 'scatter' ? 'x only in 1.0: zooming narrows the x range and offers zoom controls; the y axis is not zoomed' : 'zoom applies: controls are offered and + narrows the x range'}`, async () => {\n   233\t      const page = await devPage();\n   234\t      await create(page, type);\n   235\t      expect(await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'Zoom in' }).count()).toBe(1);\n   236\t      const before = await xDomain(page);\n   237\t      await page.focus('#chart .axylo-proxy');\n   238\t      await page.keyboard.press('+');\n   239\t      await settle(page);\n   240\t      const after = await xDomain(page);\n   241\t      expect(after.xDomain![1]! - after.xDomain![0]!).toBeLessThan(before.xDomain![1]! - before.xDomain![0]!);\n   242\t      if (type === 'scatter') {\n   243\t        // Spec 3.6: x only. The y axis keeps its full domain (reading: \"x only\" means y is not zoomed).\n   244\t        expect(after.yDomain).toEqual(before.yDomain);\n   245\t      }\n   246\t      expect(await closePage(page)).toEqual([]);\n   247\t    });\n   248\t  }\n   249\t\n   250\t  it('T-zoom-bar: a category bar chart has no zoom (no controls; +, wheel and drag leave the range alone); a date bar chart zooms', async () => {\n   251\t    const page = await devPage();\n   252\t    await create(page, 'bar');\n   253\t    expect(await page.locator('#chart button', { hasText: 'Zoom in' }).count()).toBe(0);\n   254\t    const before = await xDomain(page);\n   255\t    await page.focus('#chart .axylo-proxy');\n   256\t    await page.keyboard.press('+');\n   257\t    const p = await box(page, '#chart .axylo-proxy');\n   258\t    await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   259\t    await page.mouse.wheel(0, -300);\n   260\t    await page.mouse.move(p.x + 0.2 * p.width, p.y + p.height / 2);\n   261\t    await page.mouse.down();\n   262\t    await page.mouse.move(p.x + 0.6 * p.width, p.y + p.height / 2, { steps: 5 });\n   263\t    await page.mouse.up();\n   264\t    await settle(page);\n   265\t    expect(await xDomain(page)).toEqual(before);\n   266\t    await page.close();\n   267\t    const dated = await devPage();\n   268\t    const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n   269\t    await createRaw(dated, 'bar', { title: 'Daily', data: Array.from({ length: 30 }, (_, k) => ({ day: day(k), v: k % 7 + 1 })), x: { field: 'day', type: 'date' }, y: 'v' });\n   270\t    expect(await dated.locator('#chart button', { hasText: 'Zoom in' }).count()).toBe(1);\n   271\t    expect(await closePage(dated)).toEqual([]);\n   272\t  });\n   273\t\n   274\t  it('T-zoom-donut: a donut has no zoom: no controls, and +, - and the wheel change nothing drawn', async () => {\n   275\t    const page = await devPage();\n   276\t    await create(page, 'donut');\n   277\t    expect(await page.locator('#chart button', { hasText: /Zoom/ }).count()).toBe(0);\n   278\t    const scene = () => page.evaluate(() => document.querySelector('#chart svg.axylo-svg .axylo-scene')!.innerHTML);\n   279\t    const before = await scene();\n   280\t    await page.focus('#chart .axylo-proxy');\n   281\t    await page.keyboard.press('+');\n   282\t    await page.keyboard.press('-');\n   283\t    const g = await ring(page);\n   284\t    await page.mouse.move(g.cx, g.cy);\n   285\t    await page.mouse.wheel(0, -300);\n   286\t    await settle(page);\n   287\t    expect(await scene()).toBe(before);\n   288\t    expect(await closePage(page)).toEqual([]);\n   289\t  });\n   290\t});\n   291\t\n   292\t// ── dense drawing (rendered half) ─────────────────────────────────────────────────────────────────\n   293\t\n   294\tdescribe('T-dense', () => {\n   295\t  for (const type of ['line', 'area'] as const) {\n   296\t    it(`T-dense-${type}: 100,000 samples with one outlier: the drawing reaches the outlier, and the outlier is in the table`, async () => {\n   297\t      const page = await devPage();\n   298\t      await page.evaluate(async type => {\n   299\t        const n = 100_000;\n   300\t        const x = new Float64Array(n), y = new Float64Array(n);\n   301\t        for (let i = 0; i < n; i++) { x[i] = i; y[i] = 10 + (i % 3); }\n   302\t        y[61_234] = 100;\n   303\t        const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => { __bench: { ready(): Promise<void> } }>; charts: unknown[] };\n   304\t        const chart = w.Axylo[type]!('#chart', { title: 'Dense', data: { columns: { x, y } }, x: 'x', y: 'y' });\n   305\t        w.charts.push(chart);\n   306\t        await chart.__bench.ready();\n   307\t      }, type);\n   308\t      const g = await plotGeometry(page);\n   309\t      // The y of the outlier on screen: the top of the y domain if it ends at 100, else lower.\n   310\t      const top = g.plot.y + (1 - (100 - g.yDomain![0]!) / (g.yDomain![1]! - g.yDomain![0]!)) * g.plot.height;\n   311\t      const reach = await page.evaluate(() => {\n   312\t        const svg = document.querySelector('#chart svg.axylo-svg') as SVGSVGElement;\n   313\t        const m = svg.getScreenCTM()!;\n   314\t        let best = Infinity;\n   315\t        for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) {\n   316\t          // The stroked line only (markers' arc parameters are not coordinates).\n   317\t          if (!/--axylo-series-color-1\\b/.test(el.style.getPropertyValue('color')) || el.style.getPropertyValue('stroke') !== 'currentcolor') continue;\n   318\t          const nums = (el.getAttribute('d') ?? '').match(/-?\\d*\\.?\\d+/g)?.map(Number) ?? [];\n   319\t          for (let i = 1; i < nums.length; i += 2) best = Math.min(best, new DOMPoint(nums[i - 1]!, nums[i]!).matrixTransform(m).y);\n   320\t        }\n   321\t        return best;\n   322\t      });\n   323\t      expect(Math.abs(reach - top)).toBeLessThanOrEqual(1);\n   324\t      await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n   325\t      await settle(page);\n   326\t      await page.locator('#chart .axylo-jump-field').click();\n   327\t      await page.keyboard.type('61,234');\n   328\t      await page.keyboard.press('Enter');\n   329\t      await settle(page);\n   330\t      const row = await page.locator('#chart table tbody tr', { has: page.locator('th', { hasText: /^61,234$/ }) }).innerText();\n   331\t      expect(row).toContain('100');\n   332\t      expect(await closePage(page)).toEqual([]);\n   333\t    });\n   334\t  }\n   335\t\n   336\t  it('T-dense-bar: more bars than pixels raises the AX132 hint and every bar is still drawn', async () => {\n   337\t    const page = await devPage({ css: '#chart { width: 300px; }' });\n   338\t    const built = await createRaw(page, 'bar', { title: 'Many', data: Array.from({ length: 2000 }, (_, k) => ({ c: `c${k}`, v: 1 + (k % 5) })), x: 'c', y: 'v' });\n   339\t    expect(built.diagnostics.filter(d => d.code === 'AX132').map(d => d.level)).toEqual(['hint']);\n   340\t    expect(((await shapes(page, '#chart', 100000))[1] ?? []).length).toBe(2000);\n   341\t    expect(await closePage(page)).toEqual([]);\n   342\t  });\n   343\t\n   344\t  it('T-dense-donut: no simplified drawing: eight slices, the smallest under 0.5 %, are each drawn', async () => {\n   345\t    const page = await devPage();\n   346\t    const values = [600, 200, 100, 50, 30, 15, 4, 1];\n   347\t    await createRaw(page, 'donut', { title: 'Eight', data: values.map((v, i) => ({ l: `S${i + 1}`, v })), label: 'l', value: 'v' });\n   348\t    expect(await page.evaluate(() => document.querySelectorAll('#chart svg.axylo-svg .axylo-scene path').length)).toBe(8);\n   349\t    expect(await closePage(page)).toEqual([]);\n   350\t  });\n   351\t\n   352\t  it('T-dense-scatter: above 50,000 points the AX133 hint says drawing may be slow, and every point is drawn', async () => {\n   353\t    const page = await devPage();\n   354\t    const built = await page.evaluate(async () => {\n   355\t      const n = 50_001;\n   356\t      const rows = Array.from({ length: n }, (_, i) => ({ x: i % 1000, y: Math.floor(i / 1000) }));\n   357\t      const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => { diagnostics: { code: string; level: string }[]; __bench: { ready(): Promise<void> } }>; charts: unknown[] };\n   358\t      const chart = w.Axylo.scatter!('#chart', { title: 'Many', data: rows, x: 'x', y: 'y' });\n   359\t      w.charts.push(chart);\n   360\t      await chart.__bench.ready();\n   361\t      let subpaths = 0;\n   362\t      for (const el of document.querySelectorAll<SVGPathElement>('#chart svg.axylo-svg .axylo-scene path')) {\n   363\t        if (/--axylo-series-color-1\\b/.test(el.style.getPropertyValue('color'))) subpaths += ((el.getAttribute('d') ?? '').match(/M/g) ?? []).length;\n   364\t      }\n   365\t      return { codes: chart.diagnostics.map(d => `${d.level} ${d.code}`), subpaths };\n   366\t    });\n   367\t    expect(built.codes).toContain('hint AX133');\n   368\t    expect(built.subpaths).toBe(50_001);\n   369\t    expect(await closePage(page)).toEqual([]);\n   370\t  });\n   371\t});\n   372\t\n   373\t// ── limits ────────────────────────────────────────────────────────────────────────────────────────\n   374\t\n   375\t/** Per drawn series: its colour slot, line dash and marker shape, as an identity. */\n   376\tasync function identities(page: Page): Promise<string[]> {\n   377\t  const raw = await page.evaluate(() => {\n   378\t    const out = new Map<string, { color: string; dash: string; marker: string; pattern: string }>();\n   379\t    for (const el of document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene path, #chart svg.axylo-svg .axylo-scene g')) {\n   380\t      const slot = /--axylo-series-color-(\\d+)/.exec(el.style.getPropertyValue('color'));\n   381\t      if (!slot) continue;\n   382\t      // The element order groups a series' marks; the colour slot repeats after eight, so key by element run.\n   383\t      const key = `${el.tagName}:${el.getAttribute('data-series') ?? ''}:${out.size}`;\n   384\t      out.set(key, {\n   385\t        color: getComputedStyle(el).color,\n   386\t        dash: el.style.getPropertyValue('stroke') === 'currentcolor' ? getComputedStyle(el).strokeDasharray : '',\n   387\t        marker: el.style.getPropertyValue('fill') === 'currentcolor' ? (el.getAttribute('d') ?? '').split(/(?=M)/)[0] ?? '' : '',\n   388\t        pattern: el.getAttribute('fill')?.startsWith('url(') ? el.getAttribute('fill')! : '',\n   389\t      });\n   390\t    }\n   391\t    return [...out.values()];\n   392\t  });\n   393\t  return raw.map(r => `${r.color}|${r.dash}|${r.marker ? signature(r.marker) : ''}|${r.pattern}`);\n   394\t}\n   395\t\n   396\tdescribe('T-limit', () => {\n   397\t  for (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n   398\t    it(`T-limit-${type}: nine series raise AX130 and all nine are drawn, each with its own combination of colour and dash or marker`, async () => {\n   399\t      const page = await devPage();\n   400\t      const names = Array.from({ length: 9 }, (_, i) => `S${i + 1}`);\n   401\t      const data = type === 'scatter'\n   402\t        ? names.flatMap((s, i) => [1, 2, 3].map(x => ({ x: x + i / 10, y: i + x, s })))\n   403\t        : names.flatMap((s, i) => ['A', 'B', 'C'].map((x, k) => ({ x, s, y: 10 + i + k })));\n   404\t      const built = await createRaw(page, type, { title: 'Nine', data, x: 'x', y: 'y', series: 's' });\n   405\t      expect(built.diagnostics.filter(d => d.code === 'AX130').map(d => d.level)).toEqual(['warning']);\n   406\t      // Every series has drawn marks: nine legend entries, and the drawn identities include nine distinct ones.\n   407\t      expect(await page.locator('#chart .axylo-legend-entry').count()).toBe(9);\n   408\t      const legend = await page.locator('#chart .axylo-legend-entry svg.axylo-swatch').evaluateAll(els => els.map(e => `${getComputedStyle(e).color}|${e.innerHTML.replace(/\\s+/g, ' ')}`));\n   409\t      expect(new Set(legend).size, 'legend swatches, each a distinct cue').toBe(9);\n   410\t      const drawn = await identities(page);\n   411\t      expect(drawn.length).toBeGreaterThanOrEqual(9);\n   412\t      expect(await closePage(page)).toEqual([]);\n   413\t    });\n   414\t  }\n   415\t\n   416\t  it('T-limit-donut: nine slices raise AX121 and draw the seven largest plus \"Other (2)\"', async () => {\n   417\t    const page = await devPage();\n   418\t    const values = [30, 20, 15, 10, 8, 6, 5, 4, 2];\n   419\t    const built = await createRaw(page, 'donut', { title: 'Nine', data: values.map((v, i) => ({ l: `S${i + 1}`, v })), label: 'l', value: 'v' });\n   420\t    expect(built.diagnostics.filter(d => d.code === 'AX121').map(d => d.level)).toEqual(['warning']);\n   421\t    expect(await page.evaluate(() => document.querySelectorAll('#chart svg.axylo-svg .axylo-scene path').length)).toBe(8);\n   422\t    expect(await page.locator('#chart ul.axylo-legend-list > li .axylo-legend-name').allTextContents()).toEqual(['S1', 'S2', 'S3', 'S4', 'S5', 'S6', 'S7', 'Other (2)']);\n   423\t    expect(await closePage(page)).toEqual([]);\n   424\t  });\n   425\t});\n   426\t\n   427\t// ── reference lines and bands ─────────────────────────────────────────────────────────────────────\n   428\t\n   429\tdescribe('T-reference', () => {\n   430\t  for (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n   431\t    it(`T-reference-${type}: a reference line beyond the data is included in the y domain, drawn with its label next to it, and listed in the summary and the table caption; a band is listed too`, async () => {\n   432\t      const page = await devPage();\n   433\t      // Every fixture's values stay below 200; the reference sits at 200.\n   434\t      const band = type === 'bar' ? { y: [20, 30], label: 'Normal range' } : type === 'scatter' ? { x: [12, 18], label: 'Normal range' } : { x: ['2026-03-03', '2026-03-04'], label: 'Normal range' };\n   435\t      await create(page, type, { reference: [{ y: 200, label: 'Ceiling' }, band] });\n   436\t      const d = await xDomain(page);\n   437\t      expect(d.yDomain![1]).toBeGreaterThanOrEqual(200);\n   438\t      const label = page.locator('#chart .axylo-label[data-role=\"reference\"]', { hasText: 'Ceiling' });\n   439\t      expect(await label.count()).toBe(1);\n   440\t      const g = await plotGeometry(page);\n   441\t      const lineY = g.plot.y + (1 - (200 - d.yDomain![0]!) / (d.yDomain![1]! - d.yDomain![0]!)) * g.plot.height;\n   442\t      const lb = await box(page, '#chart .axylo-label[data-role=\"reference\"]');\n   443\t      expect(Math.min(Math.abs(lb.y - lineY), Math.abs(lb.y + lb.height - lineY)), 'label next to its line').toBeLessThanOrEqual(16);\n   444\t      const summary = (await axOf(page, '#chart figure')).description;\n   445\t      expect(summary).toContain('Ceiling');\n   446\t      expect(summary).toContain('Normal range');\n   447\t      await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n   448\t      await settle(page);\n   449\t      const caption = (await page.locator('#chart table caption').textContent()) ?? '';\n   450\t      expect(caption).toContain('Ceiling');\n   451\t      expect(caption).toContain('Normal range');\n   452\t      expect(await closePage(page)).toEqual([]);\n   453\t    });\n   454\t  }\n   455\t\n   456\t  it('T-reference-donut: a donut has no reference lines: an author reference is not drawn and not described, and is reported', async () => {\n   457\t    const page = await devPage();\n   458\t    const built = await create(page, 'donut', { reference: [{ y: 200, label: 'Ceiling' }] });\n   459\t    expect(await page.locator('#chart .axylo-label[data-role=\"reference\"]').count()).toBe(0);\n   460\t    expect((await axOf(page, '#chart figure')).description).not.toContain('Ceiling');\n   461\t    // An option that does not apply to the chart type is AX150 at run time (spec DX3).\n   462\t    expect(built.diagnostics.map(d => d.code)).toContain('AX150');\n   463\t    expect(await closePage(page)).toEqual([]);\n   464\t  });\n   465\t});\n   466\t\n   467\t\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'for f in a1-names.browser.test.ts a2-keyboard.browser.test.ts; do nl -ba packages/axylo/test/browser/acceptance/$f; done'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc 'for f in a1-names.browser.test.ts a2-keyboard.browser.test.ts; do nl -ba packages/axylo/test/browser/acceptance/$f; done'","aggregated_output":"     1\t/**\n     2\t * A1: every chart has an accessible name and a generated summary; ids are unique per chart (spec 3.4).\n     3\t * Read from Chrome's accessibility tree: the figure's computed role, name and description.\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport { start, stop } from '../harness';\n     7\timport { axe } from '../a11y/util';\n     8\timport { axOf, axWithin, closePage, create, devPage, prodPage } from './util';\n     9\timport { inOrder, summaryFragments, TYPES, TYPE_WORD, ZONE_NAMES, type ChartType } from './fixtures';\n    10\t\n    11\tbeforeAll(start);\n    12\tafterAll(stop);\n    13\t\n    14\tconst FIGURE = '#chart figure';\n    15\t/** The x label the generated-name test gives, and the measure each fixture plots. */\n    16\tconst X_LABEL: Record<ChartType, string | null> = { line: 'Day', area: 'Day', compact: 'Day', bar: 'Quarter', scatter: 'Payload', donut: null };\n    17\tconst MEASURE: Record<ChartType, string> = { line: 'Energy', area: 'Energy', compact: 'Energy', bar: 'Shipped', scatter: 'Latency', donut: 'Spend' };\n    18\t\n    19\tfunction untitled(type: ChartType): Record<string, unknown> {\n    20\t  // `title: undefined` returns the option to its default (no title); the x field gets a label to name.\n    21\t  const x = X_LABEL[type];\n    22\t  const extra: Record<string, unknown> = { title: undefined };\n    23\t  if (x && type === 'bar') extra.x = { field: 'quarter', label: x };\n    24\t  else if (x && type === 'scatter') extra.x = { field: 'size', label: x, unit: 'kB' };\n    25\t  else if (x) extra.x = { field: 'day', type: 'date', label: x };\n    26\t  return extra;\n    27\t}\n    28\t\n    29\tdescribe('A1 accessible name and summary', () => {\n    30\t  for (const type of TYPES) {\n    31\t    it(`A1 ${type}: the title is the accessible name and the description is the generated summary: type, series, x and y range, each series' minimum, maximum and last value`, async () => {\n    32\t      const page = await devPage();\n    33\t      await create(page, type);\n    34\t      const fig = await axOf(page, FIGURE);\n    35\t      expect(fig.role).toBe(type === 'compact' ? 'image' : 'group');\n    36\t      expect(fig.name).toBe(type === 'donut' ? 'Monthly spend' : type === 'bar' ? 'Shipments per quarter' : type === 'scatter' ? 'Latency by payload size' : 'Energy use by site');\n    37\t      for (const group of summaryFragments(type)) expect(inOrder(fig.description, group), `${JSON.stringify(group)} in \"${fig.description}\"`).toBe(true);\n    38\t      expect(await closePage(page)).toEqual([]);\n    39\t    });\n    40\t\n    41\t    for (const build of ['development', 'production'] as const) {\n    42\t      it(`A1 ${type}: with no title and no labelledBy the name is generated from type and measure (\"${TYPE_WORD[type]} chart of ${MEASURE[type]}…\") and AX140 is raised (${build} build)`, async () => {\n    43\t        const page = build === 'development' ? await devPage() : await prodPage();\n    44\t        const warnings: string[] = [];\n    45\t        page.on('console', m => { if (m.type() === 'warning') warnings.push(m.text()); });\n    46\t        const built = await create(page, type, untitled(type));\n    47\t        const fig = await axOf(page, FIGURE);\n    48\t        const x = X_LABEL[type];\n    49\t        if (x) expect(fig.name).toBe(`${TYPE_WORD[type]} chart of ${MEASURE[type]} by ${x}`);\n    50\t        else expect(fig.name.startsWith(`${TYPE_WORD[type]} chart of ${MEASURE[type]}`), fig.name).toBe(true);\n    51\t        expect(built.diagnostics.filter(d => d.code === 'AX140').map(d => d.level)).toEqual(['warning']);\n    52\t        // Spec 3.5: warnings print once per code per page in every build.\n    53\t        expect(warnings.filter(w => w.includes('AX140'))).toHaveLength(1);\n    54\t        // The summary is still there with the generated name.\n    55\t        expect(fig.description).toContain(TYPE_WORD[type]);\n    56\t        expect(await closePage(page)).toEqual([]);\n    57\t      });\n    58\t    }\n    59\t\n    60\t    it(`A1 ${type}: labelledBy names the chart from the page's own heading, without a heading of its own and without AX140`, async () => {\n    61\t      const page = await devPage();\n    62\t      await page.evaluate(() => {\n    63\t        const h = document.createElement('h2');\n    64\t        h.id = 'card-heading';\n    65\t        h.textContent = 'Card heading';\n    66\t        document.querySelector('#chart')!.before(h);\n    67\t      });\n    68\t      const built = await create(page, type, { title: undefined, labelledBy: 'card-heading' });\n    69\t      const fig = await axOf(page, FIGURE);\n    70\t      expect(fig.name).toBe('Card heading');\n    71\t      expect(built.diagnostics.map(d => d.code)).not.toContain('AX140');\n    72\t      const headings = (await axWithin(page, '#chart')).filter(n => n.role === 'heading');\n    73\t      expect(headings).toEqual([]);\n    74\t      expect(await closePage(page)).toEqual([]);\n    75\t    });\n    76\t\n    77\t    if (type !== 'compact') {\n    78\t      it(`A1 ${type}: the title's heading level is the author's, and a visually hidden title still names the chart`, async () => {\n    79\t        const page = await devPage();\n    80\t        await create(page, type, { title: { text: 'Level two', level: 2 } });\n    81\t        let heading = (await axWithin(page, '#chart')).find(n => n.role === 'heading');\n    82\t        expect(heading?.name).toBe('Level two');\n    83\t        expect(heading?.props.level).toBe(2);\n    84\t        await page.evaluate(() => {\n    85\t          const c = (window as unknown as { charts: { update(p: unknown): void }[] }).charts[0]!;\n    86\t          c.update({ title: { text: 'Hidden five', level: 5, visible: false } });\n    87\t        });\n    88\t        await page.evaluate(async () => { for (let i = 0; i < 3; i++) await new Promise(r => requestAnimationFrame(r)); });\n    89\t        heading = (await axWithin(page, '#chart')).find(n => n.role === 'heading');\n    90\t        expect(heading?.name).toBe('Hidden five');\n    91\t        expect(heading?.props.level).toBe(5);\n    92\t        expect((await axOf(page, FIGURE)).name).toBe('Hidden five');\n    93\t        // Visually hidden: no visible area on the page.\n    94\t        const size = await page.locator('#chart .axylo-title').evaluate(el => {\n    95\t          const r = el.getBoundingClientRect();\n    96\t          const s = getComputedStyle(el);\n    97\t          return { area: r.width * r.height, clipped: s.clipPath !== 'none' || s.clip !== 'auto' };\n    98\t        });\n    99\t        expect(size.area <= 1 || size.clipped).toBe(true);\n   100\t        expect(await closePage(page)).toEqual([]);\n   101\t      });\n   102\t    }\n   103\t\n   104\t    it(`A1 ${type}: an author description is added to the summary and never removes the zone or the omission statement`, async () => {\n   105\t      const page = await devPage();\n   106\t      // Instants in a named zone (not for a donut, which has no x) with one value that cannot be drawn.\n   107\t      const options: Record<string, unknown> = type === 'donut'\n   108\t        ? { data: [{ item: 'Rent', spend: 1200 }, { item: 'Food', spend: '__NaN__' }, { item: 'Travel', spend: 360 }] }\n   109\t        : type === 'scatter'\n   110\t          ? { data: [{ size: Date.UTC(2026, 2, 2), latency: 1 }, { size: Date.UTC(2026, 2, 3), latency: '__NaN__' }, { size: Date.UTC(2026, 2, 4), latency: 3 }], x: { field: 'size', type: 'time', timeZone: 'Asia/Kolkata' }, series: undefined }\n   111\t          : type === 'bar'\n   112\t            ? { data: [{ quarter: Date.UTC(2026, 2, 2), shipped: 1 }, { quarter: Date.UTC(2026, 2, 3), shipped: '__NaN__' }, { quarter: Date.UTC(2026, 2, 4), shipped: 3 }], x: { field: 'quarter', type: 'time', timeZone: 'Asia/Kolkata' }, series: undefined }\n   113\t            : { data: [{ day: Date.UTC(2026, 2, 2), energy: 1 }, { day: Date.UTC(2026, 2, 3), energy: '__NaN__' }, { day: Date.UTC(2026, 2, 4), energy: 3 }], x: { field: 'day', type: 'time', timeZone: 'Asia/Kolkata' }, series: undefined };\n   114\t      await create(page, type, { ...options, description: 'Readings from the main meter.' });\n   115\t      const fig = await axOf(page, FIGURE);\n   116\t      expect(fig.description).toContain('Readings from the main meter.');\n   117\t      if (type !== 'donut') expect(ZONE_NAMES.some(z => fig.description.includes(z)), fig.description).toBe(true);\n   118\t      // One value left out (NaN, AX103): the summary says so with its count (spec A1 \"any omissions\", F12).\n   119\t      expect(fig.description, fig.description).toMatch(/\\b1\\b[^.]*not shown|not shown[^.]*\\b1\\b/i);\n   120\t      expect(await closePage(page)).toEqual([]);\n   121\t    });\n   122\t\n   123\t    if (type !== 'donut') {\n   124\t      it(`A1 ${type}: the summary of instants states the time zone they are shown in`, async () => {\n   125\t        const page = await devPage();\n   126\t        await create(page, type, {}, '#chart', 'instants');\n   127\t        const fig = await axOf(page, FIGURE);\n   128\t        expect(ZONE_NAMES.some(z => fig.description.includes(z)), fig.description).toBe(true);\n   129\t        expect(await closePage(page)).toEqual([]);\n   130\t      });\n   131\t    }\n   132\t\n   133\t    it(`A1 ${type}: 24 charts on one page have no duplicate ids, each its own name, and axe heading-order passes`, async () => {\n   134\t      const page = await devPage({ css: '.tile { width: 340px; height: 200px; }' });\n   135\t      await page.evaluate(() => {\n   136\t        for (let i = 0; i < 24; i++) {\n   137\t          const el = document.createElement('div');\n   138\t          el.id = `tile-${i}`;\n   139\t          el.className = 'tile';\n   140\t          document.body.appendChild(el);\n   141\t        }\n   142\t      });\n   143\t      for (let i = 0; i < 24; i++) await create(page, type, { title: `Chart ${i + 1}` }, `#tile-${i}`);\n   144\t      const ids = await page.evaluate(() => [...document.querySelectorAll('[id]')].map(e => e.id));\n   145\t      expect(ids.filter((id, i) => ids.indexOf(id) !== i)).toEqual([]);\n   146\t      const names = [];\n   147\t      for (let i = 0; i < 24; i++) names.push((await axOf(page, `#tile-${i} figure`)).name);\n   148\t      expect(names).toEqual(Array.from({ length: 24 }, (_, i) => `Chart ${i + 1}`));\n   149\t      const result = await axe(page, 'body');\n   150\t      expect(result.violations.filter(v => v.id === 'heading-order' || v.id === 'duplicate-id' || v.id === 'duplicate-id-aria')).toEqual([]);\n   151\t      expect(await closePage(page)).toEqual([]);\n   152\t    });\n   153\t  }\n   154\t});\n   155\t\n     1\t/**\n     2\t * A2 (keyboard) and the type matrix's keyboard order (spec 3.4, 3.6; decision 0001): at most two tab stops\n     3\t * while the table is closed, the plot and one toolbar with roving focus; every point reachable in the type's\n     4\t * order; the series can be switched; the ends reached directly; focus can leave. The focus indicator is at\n     5\t * least 2 px and 3:1 and is not hidden by the tooltip. Keys are pressed with Playwright's keyboard.\n     6\t */\n     7\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     8\timport type { Page } from 'playwright-core';\n     9\timport { start, stop } from '../harness';\n    10\timport {\n    11\t  backgroundColor, box, call, closePage, contrast, create, devPage, focused, intersects, resolveColors, ring, settle, shapes, tabStops, valueText,\n    12\t} from './util';\n    13\timport {\n    14\t  calendar, ENERGY, FULL, inOrder, LATENCY_ORDER, share, SHIPPED, SPEND, withUnit, type ChartType,\n    15\t} from './fixtures';\n    16\t\n    17\tbeforeAll(start);\n    18\tafterAll(stop);\n    19\t\n    20\ttype Full = Exclude<ChartType, 'compact'>;\n    21\t\n    22\t/** Rows `append` adds in the streaming state: one more x for each type. */\n    23\tconst MORE: Record<Full, unknown[]> = {\n    24\t  line: [{ day: '2026-03-07', site: 'North', energy: 14 }, { day: '2026-03-07', site: 'South', energy: 9 }],\n    25\t  area: [{ day: '2026-03-07', site: 'North', energy: 14 }, { day: '2026-03-07', site: 'South', energy: 9 }],\n    26\t  bar: [{ quarter: 'Q5', kind: 'Plan', shipped: 60 }, { quarter: 'Q5', kind: 'Actual', shipped: 58 }],\n    27\t  scatter: [{ size: 40, latency: 130, region: 'EU' }],\n    28\t  donut: [{ item: 'Gifts', spend: 100 }],\n    29\t};\n    30\t\n    31\t/** What the reader must hear at each stop of a walk with Right from the first datum (spec 3.6 keyboard order). */\n    32\tfunction walk(type: Full): string[][] {\n    33\t  switch (type) {\n    34\t    case 'line':\n    35\t    case 'area':\n    36\t      return ENERGY.days.map((day, i) => [calendar(day), 'North', withUnit(ENERGY.series[0]!.values[i]!, 'kWh'), 'South', withUnit(ENERGY.series[1]!.values[i]!, 'kWh'), `${i + 1} of 5`]);\n    37\t    case 'bar':\n    38\t      return SHIPPED.quarters.map((q, i) => [q, 'Plan', withUnit(SHIPPED.series[0]!.values[i]!, 't'), 'Actual', withUnit(SHIPPED.series[1]!.values[i]!, 't'), `${i + 1} of 4`]);\n    39\t    case 'scatter':\n    40\t      return LATENCY_ORDER.map((p, i) => [p.region, withUnit(p.size, 'kB'), withUnit(p.latency, 'ms'), `${i + 1} of 6`]);\n    41\t    case 'donut':\n    42\t      return SPEND.items.map((item, i) => [item, withUnit(SPEND.values[i]!, 'EUR'), share(SPEND.values[i]!), `${i + 1} of 4`]);\n    43\t  }\n    44\t}\n    45\t\n    46\t/** The toolbar's controls in order, from the spec: legend toggles (two or more series), zoom where it applies, the table. */\n    47\tconst TOOLBAR: Record<Full, string[]> = {\n    48\t  line: ['North', 'South', 'Zoom in', 'Zoom out', 'View as table'],\n    49\t  area: ['North', 'South', 'Zoom in', 'Zoom out', 'View as table'],\n    50\t  // Category x: no zoom (spec 3.6).\n    51\t  bar: ['Plan', 'Actual', 'View as table'],\n    52\t  scatter: ['EU', 'US', 'Zoom in', 'Zoom out', 'View as table'],\n    53\t  // No legend toggles (the slice list is not a set of buttons) and no zoom (spec 3.6).\n    54\t  donut: ['View as table'],\n    55\t};\n    56\t\n    57\tasync function zoomIn(page: Page, type: Full): Promise<void> {\n    58\t  const range = type === 'scatter' ? [12, 30] : ['2026-03-03', '2026-03-05'];\n    59\t  await call(page, 'zoom', [range]);\n    60\t}\n    61\t\n    62\tdescribe('A2 tab stops', () => {\n    63\t  for (const type of FULL as Full[]) {\n    64\t    const states: [string, ((page: Page) => Promise<void>) | null][] = [\n    65\t      ['collapsed', async () => {}],\n    66\t      ['zoomed', type === 'line' || type === 'area' || type === 'scatter' ? page => zoomIn(page, type) : null],\n    67\t      ['streaming', async page => call(page, 'append', [MORE[type]])],\n    68\t    ];\n    69\t    for (const [state, enter] of states) {\n    70\t      if (!enter) continue;\n    71\t      it(`A2 ${type}: two tab stops with the table closed (${state}): the plot, then the toolbar; Shift+Tab reverses; Tab leaves the chart`, async () => {\n    72\t        const page = await devPage();\n    73\t        await create(page, type);\n    74\t        await enter(page);\n    75\t        const forwards = await tabStops(page);\n    76\t        expect(forwards).toHaveLength(3);\n    77\t        expect(forwards[0]).toBe('proxy');\n    78\t        expect(forwards[1]).toMatch(/^toolbar:/);\n    79\t        expect(forwards[2]).toBe('after');\n    80\t        const backwards = await tabStops(page, true);\n    81\t        expect(backwards[0]).toMatch(/^toolbar:/);\n    82\t        expect(backwards.slice(1)).toEqual(['proxy', 'before']);\n    83\t        if (state === 'streaming') expect(await page.locator('#chart [role=\"toolbar\"]').textContent()).toContain('Pause');\n    84\t        expect(await closePage(page)).toEqual([]);\n    85\t      });\n    86\t    }\n    87\t\n    88\t    it(`A2 ${type}: with the table open, Tab reaches the table's scroll region and the toolbar, and still leaves the chart both ways`, async () => {\n    89\t      const page = await devPage();\n    90\t      await create(page, type);\n    91\t      await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n    92\t      await settle(page);\n    93\t      const forwards = await tabStops(page);\n    94\t      expect(forwards).toContain('table');\n    95\t      expect(forwards.some(s => s.startsWith('toolbar:'))).toBe(true);\n    96\t      expect(forwards.at(-1)).toBe('after');\n    97\t      const backwards = await tabStops(page, true);\n    98\t      expect(backwards).toContain('table');\n    99\t      expect(backwards.at(-1)).toBe('before');\n   100\t      expect(await closePage(page)).toEqual([]);\n   101\t    });\n   102\t\n   103\t    it(`A2 ${type}: the toolbar holds ${TOOLBAR[type].join(', ')} with roving focus: one tab stop, arrows, Home and End move within it`, async () => {\n   104\t      const page = await devPage();\n   105\t      await create(page, type);\n   106\t      await page.focus('#before');\n   107\t      await page.keyboard.press('Tab');\n   108\t      await page.keyboard.press('Tab');\n   109\t      const label = () => page.evaluate(() => document.activeElement?.textContent ?? '');\n   110\t      const visited = [await label()];\n   111\t      for (let i = 1; i < TOOLBAR[type].length; i++) {\n   112\t        await page.keyboard.press('ArrowRight');\n   113\t        visited.push(await label());\n   114\t      }\n   115\t      expect(visited).toEqual(TOOLBAR[type]);\n   116\t      await page.keyboard.press('Home');\n   117\t      expect(await label()).toBe(TOOLBAR[type][0]);\n   118\t      await page.keyboard.press('End');\n   119\t      expect(await label()).toBe(TOOLBAR[type].at(-1));\n   120\t      expect(await page.locator('#chart [role=\"toolbar\"] [tabindex=\"0\"]').count()).toBe(1);\n   121\t      expect(await closePage(page)).toEqual([]);\n   122\t    });\n   123\t  }\n   124\t});\n   125\t\n   126\tdescribe('A2 and T-keyboard: every point in order, the ends, the series', () => {\n   127\t  for (const type of FULL as Full[]) {\n   128\t    const order = { line: 'by x, then series', area: 'by x, then series', bar: 'by category, then series', scatter: 'by x, then y', donut: 'by slice order' }[type];\n   129\t    it(`A2 ${type}: Right visits every datum ${order}, each read with its text; End and Home reach the ends; Tab leaves the chart`, async () => {\n   130\t      const page = await devPage();\n   131\t      await create(page, type);\n   132\t      await page.focus('#before');\n   133\t      await page.keyboard.press('Tab');\n   134\t      expect(await focused(page)).toBe('proxy');\n   135\t      const expected = walk(type);\n   136\t      const heard: string[] = [await valueText(page)];\n   137\t      for (let i = 1; i < expected.length; i++) {\n   138\t        await page.keyboard.press('ArrowRight');\n   139\t        heard.push(await valueText(page));\n   140\t      }\n   141\t      expected.forEach((group, i) => expect(inOrder(heard[i]!, group), `stop ${i + 1}: ${JSON.stringify(group)} in \"${heard[i]}\"`).toBe(true));\n   142\t      // Past the end Right stays on the last datum.\n   143\t      await page.keyboard.press('ArrowRight');\n   144\t      expect(inOrder(await valueText(page), expected.at(-1)!)).toBe(true);\n   145\t      await page.keyboard.press('Home');\n   146\t      expect(inOrder(await valueText(page), expected[0]!)).toBe(true);\n   147\t      await page.keyboard.press('End');\n   148\t      expect(inOrder(await valueText(page), expected.at(-1)!)).toBe(true);\n   149\t      await page.keyboard.press('Tab');\n   150\t      expect(await focused(page)).toMatch(/^toolbar:/);\n   151\t      await page.keyboard.press('Tab');\n   152\t      expect(await focused(page)).toBe('after');\n   153\t      expect(await closePage(page)).toEqual([]);\n   154\t    });\n   155\t  }\n   156\t\n   157\t  for (const type of ['line', 'area', 'bar'] as const) {\n   158\t    it(`A2 ${type}: Down narrows to the first series, Right stays in it, Down and Up switch series at the same ${type === 'bar' ? 'category' : 'x'}, Escape reads every series again`, async () => {\n   159\t      const page = await devPage();\n   160\t      await create(page, type);\n   161\t      const [first, second] = type === 'bar' ? SHIPPED.series : ENERGY.series;\n   162\t      const unit = type === 'bar' ? 't' : 'kWh';\n   163\t      const xs = type === 'bar' ? SHIPPED.quarters : ENERGY.days.map(calendar);\n   164\t      await page.focus('#chart .axylo-proxy');\n   165\t      await page.keyboard.press('ArrowDown');\n   166\t      let text = await valueText(page);\n   167\t      expect(inOrder(text, [first!.name, xs[0]!, withUnit(first!.values[0]!, unit)]), text).toBe(true);\n   168\t      expect(text).not.toContain(second!.name);\n   169\t      await page.keyboard.press('ArrowRight');\n   170\t      text = await valueText(page);\n   171\t      expect(inOrder(text, [first!.name, xs[1]!, withUnit(first!.values[1]!, unit)]), text).toBe(true);\n   172\t      await page.keyboard.press('ArrowDown');\n   173\t      text = await valueText(page);\n   174\t      expect(inOrder(text, [second!.name, xs[1]!, withUnit(second!.values[1]!, unit)]), text).toBe(true);\n   175\t      expect(text).not.toContain(first!.name);\n   176\t      await page.keyboard.press('ArrowUp');\n   177\t      text = await valueText(page);\n   178\t      expect(inOrder(text, [first!.name, xs[1]!]), text).toBe(true);\n   179\t      await page.keyboard.press('Escape');\n   180\t      text = await valueText(page);\n   181\t      if (!text.includes(second!.name)) {\n   182\t        // The first Escape may close the tooltip (decision 0001); the second leaves single-series mode.\n   183\t        await page.keyboard.press('Escape');\n   184\t        text = await valueText(page);\n   185\t      }\n   186\t      expect(inOrder(text, [xs[1]!, first!.name, second!.name]), text).toBe(true);\n   187\t      expect(await closePage(page)).toEqual([]);\n   188\t    });\n   189\t\n   190\t    it(`A2 ${type}: hiding the focused series with its legend toggle keeps focus on the same ${type === 'bar' ? 'category' : 'x'} and stops reading that series`, async () => {\n   191\t      const page = await devPage();\n   192\t      await create(page, type);\n   193\t      const [first, second] = type === 'bar' ? SHIPPED.series : ENERGY.series;\n   194\t      const xs = type === 'bar' ? SHIPPED.quarters : ENERGY.days.map(calendar);\n   195\t      await page.focus('#chart .axylo-proxy');\n   196\t      await page.keyboard.press('ArrowRight');\n   197\t      await page.keyboard.press('ArrowRight');\n   198\t      await page.keyboard.press('ArrowDown');\n   199\t      expect(await valueText(page)).toContain(first!.name);\n   200\t      await page.locator('#chart [role=\"toolbar\"] button', { hasText: first!.name }).click();\n   201\t      await settle(page);\n   202\t      const text = await valueText(page);\n   203\t      expect(text).toContain(xs[2]!);\n   204\t      expect(text).not.toContain(first!.name);\n   205\t      expect(text).toContain(second!.name);\n   206\t      expect(await closePage(page)).toEqual([]);\n   207\t    });\n   208\t  }\n   209\t\n   210\t  it('A2 scatter: Down switches to the other series and Right then stays in it, in x order (reading: Up and Down change series, as on the aligned charts)', async () => {\n   211\t    const page = await devPage();\n   212\t    await create(page, 'scatter');\n   213\t    await page.focus('#chart .axylo-proxy');\n   214\t    expect(await valueText(page)).toContain('EU');\n   215\t    await page.keyboard.press('ArrowDown');\n   216\t    const texts = [await valueText(page)];\n   217\t    expect(texts[0]).toContain('US');\n   218\t    for (let i = 0; i < 4; i++) {\n   219\t      await page.keyboard.press('ArrowRight');\n   220\t      texts.push(await valueText(page));\n   221\t    }\n   222\t    for (const t of texts) expect(t, t).toContain('US');\n   223\t    // The last US point by x is 35 kB.\n   224\t    expect(texts.at(-1)).toContain(withUnit(35, 'kB'));\n   225\t    expect(await closePage(page)).toEqual([]);\n   226\t  });\n   227\t});\n   228\t\n   229\tdescribe('A2 focus indicator', () => {\n   230\t  for (const type of FULL as Full[]) {\n   231\t    it(`A2 ${type}: the keyboard focus indicator is at least 2 px and 3:1 against the chart background, and the tooltip never covers the focused datum`, async () => {\n   232\t      const page = await devPage();\n   233\t      await create(page, type);\n   234\t      await page.focus('#before');\n   235\t      await page.keyboard.press('Tab');\n   236\t      const indicator = page.locator('#chart .axylo-focus-ring');\n   237\t      expect(await indicator.isVisible()).toBe(true);\n   238\t      const style = await indicator.evaluate(el => {\n   239\t        const s = getComputedStyle(el);\n   240\t        return { width: parseFloat(s.outlineWidth), style: s.outlineStyle, color: s.outlineColor };\n   241\t      });\n   242\t      expect(style.width).toBeGreaterThanOrEqual(2);\n   243\t      expect(style.style).not.toBe('none');\n   244\t      const [color] = await resolveColors(page, [style.color]);\n   245\t      expect(contrast(color!, await backgroundColor(page))).toBeGreaterThanOrEqual(3);\n   246\t      // At every datum the keyboard reaches, the tooltip (when shown) does not cover that datum's mark.\n   247\t      const steps = walk(type).length;\n   248\t      let checked = 0;\n   249\t      for (let i = 0; i < steps; i++) {\n   250\t        if (i > 0) await page.keyboard.press('ArrowRight');\n   251\t        const tip = page.locator('#chart .axylo-tooltip');\n   252\t        if (!(await tip.isVisible())) continue;\n   253\t        const tipBox = await box(page, '#chart .axylo-tooltip');\n   254\t        const drawn = await shapes(page, '#chart', type === 'donut' ? 10000 : type === 'bar' ? 10000 : 20);\n   255\t        const marks = datumMarks(type, drawn, i, type === 'donut' ? await ring(page) : null);\n   256\t        expect(marks.length, `marks for datum ${i}`).toBeGreaterThan(0);\n   257\t        checked++;\n   258\t        for (const m of marks) expect(intersects(tipBox, m, 0.5), `datum ${i}: tooltip ${JSON.stringify(tipBox)} over mark ${JSON.stringify(m)}`).toBe(false);\n   259\t      }\n   260\t      // The keyboard shows the tooltip at the datum it is on (decision 0001), so the check above ran.\n   261\t      expect(checked).toBe(steps);\n   262\t      expect(await closePage(page)).toEqual([]);\n   263\t    });\n   264\t  }\n   265\t});\n   266\t\n   267\t/** The drawn mark(s) of the i-th datum in keyboard order, from the SVG shapes grouped by colour slot. */\n   268\tfunction datumMarks(type: Full, drawn: Record<number, { box: { x: number; y: number; width: number; height: number }; commands: string }[]>, i: number, donut: { cx: number; cy: number; outer: number } | null) {\n   269\t  const bySlot = (slot: number) => (drawn[slot] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n   270\t  if (type === 'line' || type === 'area' || type === 'bar') return [bySlot(1)[i], bySlot(2)[i]].filter(b => b !== undefined);\n   271\t  if (type === 'donut') {\n   272\t    // A small box at the slice's middle angle, clockwise from 12 o'clock (spec F8), at 80 % of the outer radius.\n   273\t    if (!donut) return [];\n   274\t    const { cx, cy } = donut;\n   275\t    const r = 0.8 * donut.outer;\n   276\t    const before = SPEND.values.slice(0, i).reduce((a, b) => a + b, 0);\n   277\t    const angle = 2 * Math.PI * (before + SPEND.values[i]! / 2) / SPEND.values.reduce((a, b) => a + b, 0);\n   278\t    return [{ x: cx + r * Math.sin(angle) - 4, y: cy - r * Math.cos(angle) - 4, width: 8, height: 8 }];\n   279\t  }\n   280\t  // Scatter: the point at the i-th place in x-then-y order, from its series' shapes (EU slot 1, US slot 2).\n   281\t  const p = LATENCY_ORDER[i]!;\n   282\t  const slot = p.region === 'EU' ? 1 : 2;\n   283\t  const same = LATENCY_ORDER.filter(q => q.region === p.region);\n   284\t  return [bySlot(slot)[same.indexOf(p)]].filter(b => b !== undefined);\n   285\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/acceptance/a4-table.browser.test.ts && nl -ba packages/axylo/test/browser/acceptance/a6-a10.browser.test.ts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/acceptance/a4-table.browser.test.ts && nl -ba packages/axylo/test/browser/acceptance/a6-a10.browser.test.ts'","aggregated_output":"     1\t/**\n     2\t * A4: \"View as table\" (spec 3.4). The table is read from Chrome's accessibility tree (table, caption,\n     3\t * column and row headers, cells) and compared with the fixture data; paging and the jump field are driven\n     4\t * with real clicks and typing.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport { axWithin, box, call, closePage, create, createRaw, devPage, settle, type AX } from './util';\n    10\timport { calendar, ENERGY, FULL, inOrder, LATENCY_ORDER, share, SHIPPED, SPEND, withUnit, type ChartType } from './fixtures';\n    11\t\n    12\tbeforeAll(start);\n    13\tafterAll(stop);\n    14\t\n    15\ttype Full = Exclude<ChartType, 'compact'>;\n    16\t\n    17\t/** Expected table: caption, column headers (each as fragments in order), row headers, cells per row. */\n    18\tfunction expectedTable(type: Full): { caption: string; headers: string[][]; rows: string[]; cells: string[][] } {\n    19\t  switch (type) {\n    20\t    case 'line':\n    21\t    case 'area':\n    22\t      return {\n    23\t        caption: ENERGY.title,\n    24\t        // The x field has no label, so its name is the label (spec L6); value columns carry the unit.\n    25\t        headers: [['day'], ['North', 'kWh'], ['South', 'kWh']],\n    26\t        rows: ENERGY.days.map(calendar),\n    27\t        cells: ENERGY.days.map((_, i) => ENERGY.series.map(s => withUnit(s.values[i]!, 'kWh'))),\n    28\t      };\n    29\t    case 'bar':\n    30\t      return {\n    31\t        caption: SHIPPED.title,\n    32\t        headers: [['quarter'], ['Plan', 't'], ['Actual', 't']],\n    33\t        rows: SHIPPED.quarters,\n    34\t        cells: SHIPPED.quarters.map((_, i) => SHIPPED.series.map(s => withUnit(s.values[i]!, 't'))),\n    35\t      };\n    36\t    case 'scatter':\n    37\t      // One row per point in x-then-y order (spec 3.6); the x measure's label and unit head the first column.\n    38\t      return {\n    39\t        caption: 'Latency by payload size',\n    40\t        headers: [['Payload', 'kB'], ['Latency', 'ms']],\n    41\t        rows: LATENCY_ORDER.map(p => withUnit(p.size, 'kB')),\n    42\t        cells: LATENCY_ORDER.map(p => [p.region, withUnit(p.latency, 'ms')]),\n    43\t      };\n    44\t    case 'donut':\n    45\t      return {\n    46\t        caption: SPEND.title,\n    47\t        headers: [['Spend', 'EUR']],\n    48\t        rows: SPEND.items,\n    49\t        cells: SPEND.items.map((_, i) => [withUnit(SPEND.values[i]!, 'EUR'), share(SPEND.values[i]!)]),\n    50\t      };\n    51\t  }\n    52\t}\n    53\t\n    54\tasync function openTable(page: Page, selector = '#chart'): Promise<void> {\n    55\t  await page.locator(`${selector} [role=\"toolbar\"] button`, { hasText: 'View as table' }).click();\n    56\t  await settle(page);\n    57\t}\n    58\t\n    59\t/** The table as Chrome exposes it: its name (the caption), column headers, and per row the row header and cells. */\n    60\tasync function readTable(page: Page, selector = '#chart'): Promise<{ name: string; headers: string[]; rows: { header: string; cells: string[] }[] }> {\n    61\t  const nodes = await axWithin(page, selector);\n    62\t  const table = nodes.find(n => n.role === 'table');\n    63\t  if (!table) return { name: '', headers: [], rows: [] };\n    64\t  const all = await axWithin(page, `${selector} table`);\n    65\t  const byId = new Map(all.map(n => [n.id, n]));\n    66\t  const rows: { header: string; cells: string[] }[] = [];\n    67\t  const headers: string[] = [];\n    68\t  const kids = (n: AX): AX[] => n.children.map(c => byId.get(c)).filter((c): c is AX => !!c).flatMap(c => c.ignored || c.role === 'rowgroup' || c.role === 'generic' ? kids(c) : [c]);\n    69\t  for (const row of all.filter(n => n.role === 'row')) {\n    70\t    const cells = kids(row);\n    71\t    const head = cells.filter(c => c.role === 'columnheader');\n    72\t    if (head.length) { headers.push(...head.map(c => c.name)); continue; }\n    73\t    const rh = cells.find(c => c.role === 'rowheader');\n    74\t    rows.push({ header: rh?.name ?? '', cells: cells.filter(c => c.role === 'cell' || c.role === 'gridcell').map(c => c.name) });\n    75\t  }\n    76\t  return { name: table.name, headers, rows };\n    77\t}\n    78\t\n    79\tdescribe('A4 table content', () => {\n    80\t  for (const type of FULL as Full[]) {\n    81\t    it(`A4 ${type}: View as table opens an HTML table built from the data: title as caption, field labels with units as column headers, x values as row headers, values formatted as in F6`, async () => {\n    82\t      const page = await devPage();\n    83\t      await create(page, type);\n    84\t      expect(await page.locator('#chart table').count()).toBe(0);\n    85\t      await openTable(page);\n    86\t      const t = await readTable(page);\n    87\t      const want = expectedTable(type);\n    88\t      expect(t.name).toBe(want.caption);\n    89\t      for (const h of want.headers) expect(t.headers.some(x => inOrder(x, h)), `${JSON.stringify(h)} in ${JSON.stringify(t.headers)}`).toBe(true);\n    90\t      expect(t.rows.map(r => r.header)).toEqual(want.rows);\n    91\t      t.rows.forEach((r, i) => {\n    92\t        for (const cell of want.cells[i]!) expect(r.cells, `row ${want.rows[i]}`).toContain(cell);\n    93\t      });\n    94\t      expect(await closePage(page)).toEqual([]);\n    95\t    });\n    96\t\n    97\t    it(`A4 ${type}: the table sits in a focusable scroll region named by its caption, no taller than the plot, and opening it does not move another chart on the page`, async () => {\n    98\t      const page = await devPage({ css: '#second { width: 720px; height: 400px; }' });\n    99\t      await page.evaluate(() => {\n   100\t        const el = document.createElement('div');\n   101\t        el.id = 'second';\n   102\t        document.querySelector('#after')!.after(el);\n   103\t      });\n   104\t      await create(page, type);\n   105\t      await create(page, type, {}, '#second');\n   106\t      const plotHeight = (await box(page, '#chart .axylo-plot')).height;\n   107\t      const before = await box(page, '#second figure');\n   108\t      await openTable(page);\n   109\t      const after = await box(page, '#second figure');\n   110\t      expect(after).toEqual(before);\n   111\t      const region = (await axWithin(page, '#chart')).find(n => n.role === 'region');\n   112\t      expect(region?.name).toBe(expectedTable(type).caption);\n   113\t      expect(region?.props.focusable).toBe(true);\n   114\t      const scroll = await box(page, '#chart .axylo-table-scroll');\n   115\t      expect(scroll.height).toBeLessThanOrEqual(plotHeight + 0.5);\n   116\t      expect(await closePage(page)).toEqual([]);\n   117\t    });\n   118\t  }\n   119\t});\n   120\t\n   121\t/** 250 rows per type, so the table has three pages of at most 100. Row k (0-based) has x as `rowHeader(k)`. */\n   122\tfunction longData(type: Full): { fn: string; options: Record<string, unknown>; rowHeader(k: number): string; jumpText(k: number): string } {\n   123\t  const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n   124\t  const cat = (k: number) => `C${String(k + 1).padStart(3, '0')}`;\n   125\t  switch (type) {\n   126\t    case 'line':\n   127\t    case 'area':\n   128\t      return {\n   129\t        fn: type, options: { title: 'Long', data: Array.from({ length: 250 }, (_, k) => ({ day: day(k), v: k })), x: { field: 'day', type: 'date' }, y: 'v' },\n   130\t        rowHeader: k => calendar(day(k)), jumpText: k => calendar(day(k)),\n   131\t      };\n   132\t    case 'bar':\n   133\t      return {\n   134\t        fn: 'bar', options: { title: 'Long', data: Array.from({ length: 250 }, (_, k) => ({ c: cat(k), v: k + 1 })), x: 'c', y: 'v' },\n   135\t        rowHeader: cat, jumpText: cat,\n   136\t      };\n   137\t    case 'scatter':\n   138\t      return {\n   139\t        fn: 'scatter', options: { title: 'Long', data: Array.from({ length: 250 }, (_, k) => ({ x: k + 1, y: (k * 7) % 50 })), x: 'x', y: 'y' },\n   140\t        rowHeader: k => String(k + 1), jumpText: k => String(k + 1),\n   141\t      };\n   142\t    case 'donut':\n   143\t      return {\n   144\t        fn: 'donut', options: { title: 'Long', data: Array.from({ length: 250 }, (_, k) => ({ c: cat(k), v: 250 - k })), label: 'c', value: 'v' },\n   145\t        rowHeader: cat, jumpText: cat,\n   146\t      };\n   147\t  }\n   148\t}\n   149\t\n   150\tdescribe('A4 paging and jumping', () => {\n   151\t  for (const type of FULL as Full[]) {\n   152\t    it(`A4 ${type}: 250 rows are shown 100 per page; Next and Previous page reach every row; jumping to an x value shows the page that holds it`, async () => {\n   153\t      const page = await devPage();\n   154\t      const d = longData(type);\n   155\t      await createRaw(page, d.fn, d.options);\n   156\t      await openTable(page);\n   157\t      let t = await readTable(page);\n   158\t      expect(t.rows.map(r => r.header)).toEqual(Array.from({ length: 100 }, (_, k) => d.rowHeader(k)));\n   159\t      const next = page.locator('#chart .axylo-pager button', { hasText: 'Next page' });\n   160\t      const previous = page.locator('#chart .axylo-pager button', { hasText: 'Previous page' });\n   161\t      await next.click();\n   162\t      t = await readTable(page);\n   163\t      expect(t.rows.map(r => r.header)).toEqual(Array.from({ length: 100 }, (_, k) => d.rowHeader(100 + k)));\n   164\t      await next.click();\n   165\t      t = await readTable(page);\n   166\t      expect(t.rows.map(r => r.header)).toEqual(Array.from({ length: 50 }, (_, k) => d.rowHeader(200 + k)));\n   167\t      await previous.click();\n   168\t      await previous.click();\n   169\t      t = await readTable(page);\n   170\t      expect(t.rows[0]!.header).toBe(d.rowHeader(0));\n   171\t      // Jump to row 230 by typing its x as the table shows it.\n   172\t      const field = page.locator('#chart .axylo-jump-field');\n   173\t      await field.click();\n   174\t      await page.keyboard.type(d.jumpText(229));\n   175\t      await page.keyboard.press('Enter');\n   176\t      await settle(page);\n   177\t      t = await readTable(page);\n   178\t      expect(t.rows.map(r => r.header)).toContain(d.rowHeader(229));\n   179\t      expect(await closePage(page)).toEqual([]);\n   180\t    });\n   181\t\n   182\t    it(`A4 ${type}: a \"Jump to\" value that matches no row is identified and described in visible text (reading: WCAG 3.3.1 applies to the jump field)`, async () => {\n   183\t      const page = await devPage();\n   184\t      const d = longData(type);\n   185\t      await createRaw(page, d.fn, d.options);\n   186\t      await openTable(page);\n   187\t      const field = page.locator('#chart .axylo-jump-field');\n   188\t      await field.click();\n   189\t      await page.keyboard.type('no such value');\n   190\t      await page.keyboard.press('Enter');\n   191\t      await settle(page);\n   192\t      expect((await axWithin(page, '#chart')).find(n => n.role === 'textbox')?.props.invalid).toBe('true');\n   193\t      // The field's accessible description, or text next to it, says what went wrong.\n   194\t      const described = await page.evaluate(() => {\n   195\t        const f = document.querySelector('#chart .axylo-jump-field') as HTMLInputElement;\n   196\t        const ids = (f.getAttribute('aria-describedby') ?? '').split(/\\s+/).filter(Boolean);\n   197\t        const own = ids.map(id => document.getElementById(id)).filter((e): e is HTMLElement => !!e && e.offsetParent !== null).map(e => e.textContent ?? '');\n   198\t        const near = [...(f.closest('.axylo-pager')?.querySelectorAll<HTMLElement>('[role=\"alert\"], .axylo-jump-error, [aria-live]') ?? [])].filter(e => e.offsetParent !== null).map(e => e.textContent ?? '');\n   199\t        return [...own, ...near].join(' ');\n   200\t      });\n   201\t      expect(described).toMatch(/no such value|no row/i);\n   202\t      expect(await closePage(page)).toEqual([]);\n   203\t    });\n   204\t  }\n   205\t});\n   206\t\n   207\tdescribe('A4 current range', () => {\n   208\t  for (const type of ['line', 'area', 'scatter'] as const) {\n   209\t    it(`A4 ${type}: zoomed in, the table covers the current x range only`, async () => {\n   210\t      const page = await devPage();\n   211\t      await create(page, type);\n   212\t      const range = type === 'scatter' ? [12, 30] : ['2026-03-03', '2026-03-05'];\n   213\t      await call(page, 'zoom', [range]);\n   214\t      await openTable(page);\n   215\t      const t = await readTable(page);\n   216\t      const want = type === 'scatter'\n   217\t        ? LATENCY_ORDER.filter(p => p.size >= 12 && p.size <= 30).map(p => withUnit(p.size, 'kB'))\n   218\t        : ENERGY.days.slice(1, 4).map(calendar);\n   219\t      expect(t.rows.map(r => r.header)).toEqual(want);\n   220\t      expect(await closePage(page)).toEqual([]);\n   221\t    });\n   222\t  }\n   223\t\n   224\t  it('A4 line: a value near row 900,000 of a 1,000,000-row typed-column chart is reachable by jumping to its x', async () => {\n   225\t    const page = await devPage();\n   226\t    await page.evaluate(async () => {\n   227\t      const n = 1_000_000;\n   228\t      const x = new Float64Array(n);\n   229\t      const y = new Float64Array(n);\n   230\t      for (let i = 0; i < n; i++) { x[i] = i; y[i] = (i % 1000) + 0.25; }\n   231\t      const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => { __bench: { ready(): Promise<void> } }>; charts: unknown[] };\n   232\t      const chart = w.Axylo.line!('#chart', { title: 'A million', data: { columns: { x, y } }, x: 'x', y: 'y' });\n   233\t      w.charts.push(chart);\n   234\t      await chart.__bench.ready();\n   235\t    });\n   236\t    await openTable(page);\n   237\t    const field = page.locator('#chart .axylo-jump-field');\n   238\t    await field.click();\n   239\t    await page.keyboard.type('900,123');\n   240\t    await page.keyboard.press('Enter');\n   241\t    await settle(page);\n   242\t    const t = await readTable(page);\n   243\t    const row = t.rows.find(r => r.header === '900,123');\n   244\t    expect(row?.cells).toEqual(['123.25']);\n   245\t    expect(await closePage(page)).toEqual([]);\n   246\t  });\n   247\t});\n   248\t\n     1\t/**\n     2\t * A6 (reflow and text spacing, Chrome only), A7 (data arriving does not speak), A8 (axe-core in every\n     3\t * state) and A10 (replaceable built-in text, `lang=\"en\"` on a page in another language). Spec 3.4.\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport type { Page } from 'playwright-core';\n     7\timport { start, stop } from '../harness';\n     8\timport { axe } from '../a11y/util';\n     9\timport { axWithin, box, call, closePage, create, devPage, settle, valueText } from './util';\n    10\timport { FULL, TYPES, type ChartType } from './fixtures';\n    11\t\n    12\tbeforeAll(start);\n    13\tafterAll(stop);\n    14\t\n    15\ttype Full = Exclude<ChartType, 'compact'>;\n    16\t\n    17\t/** WCAG 1.4.12's text-spacing overrides, as a user style sheet would apply them. */\n    18\tconst TEXT_SPACING = '* { line-height: 1.5 !important; letter-spacing: 0.12em !important; word-spacing: 0.16em !important; } p { margin-bottom: 2em !important; }';\n    19\t\n    20\t/** Text-bearing elements of the chart that are rendered, and whether each is clipped or outside the figure. */\n    21\tasync function clippedText(page: Page): Promise<string[]> {\n    22\t  return page.evaluate(() => {\n    23\t    const fig = document.querySelector('#chart figure')!.getBoundingClientRect();\n    24\t    const out: string[] = [];\n    25\t    const walker = document.createTreeWalker(document.querySelector('#chart')!, NodeFilter.SHOW_TEXT);\n    26\t    for (let n = walker.nextNode(); n; n = walker.nextNode()) {\n    27\t      const el = n.parentElement!;\n    28\t      if (!n.textContent?.trim() || el.closest('[hidden], .axylo-visually-hidden, .axylo-tooltip, .axylo-readout')) continue;\n    29\t      const style = getComputedStyle(el);\n    30\t      if (style.display === 'none' || style.visibility === 'hidden') continue;\n    31\t      const range = document.createRange();\n    32\t      range.selectNodeContents(n);\n    33\t      const r = range.getBoundingClientRect();\n    34\t      if (r.width === 0 && r.height === 0) continue;\n    35\t      // Clipped by an ancestor that hides overflow: the text's box reaches outside that ancestor's box.\n    36\t      for (let a: HTMLElement | null = el; a && a !== document.body; a = a.parentElement) {\n    37\t        const s = getComputedStyle(a);\n    38\t        if (s.overflowX !== 'visible' || s.overflowY !== 'visible') {\n    39\t          const b = a.getBoundingClientRect();\n    40\t          if (r.left < b.left - 1 || r.right > b.right + 1 || r.top < b.top - 1 || r.bottom > b.bottom + 1) { out.push(`clipped: ${n.textContent}`); break; }\n    41\t        }\n    42\t      }\n    43\t      if (r.left < fig.left - 1 || r.right > fig.right + 1 || r.top < fig.top - 1 || r.bottom > fig.bottom + 1) out.push(`outside the figure: ${n.textContent}`);\n    44\t    }\n    45\t    return out;\n    46\t  });\n    47\t}\n    48\t\n    49\tdescribe('A6 reflow and text spacing (Chrome only)', () => {\n    50\t  for (const type of FULL as Full[]) {\n    51\t    it(`A6 ${type}: at 320 CSS px wide (400 % of 1280) the page does not scroll horizontally and no chart text is clipped (Chrome)`, async () => {\n    52\t      const page = await devPage({ viewport: { width: 320, height: 640 }, css: 'body { margin: 0; } #chart { width: auto; height: auto; }' });\n    53\t      await create(page, type);\n    54\t      const scroll = await page.evaluate(() => ({ width: document.documentElement.scrollWidth, client: document.documentElement.clientWidth }));\n    55\t      expect(scroll.width).toBeLessThanOrEqual(scroll.client);\n    56\t      expect(await clippedText(page)).toEqual([]);\n    57\t      expect(await closePage(page)).toEqual([]);\n    58\t    });\n    59\t\n    60\t    it(`A6 ${type}: with the WCAG 1.4.12 text-spacing overrides no chart text is clipped or pushed outside the figure (Chrome)`, async () => {\n    61\t      const page = await devPage({ css: TEXT_SPACING });\n    62\t      await create(page, type);\n    63\t      await settle(page);\n    64\t      expect(await clippedText(page)).toEqual([]);\n    65\t      expect(await closePage(page)).toEqual([]);\n    66\t    });\n    67\t  }\n    68\t});\n    69\t\n    70\t// ── A7 ────────────────────────────────────────────────────────────────────────────────────────────\n    71\t\n    72\t/** One more x for each type, numbered k; a sliding window keeps 5 x values (4 slices on the donut). */\n    73\tfunction streamRow(type: Full, k: number): unknown[] {\n    74\t  const day = new Date(Date.UTC(2026, 2, 7) + k * 864e5).toISOString().slice(0, 10);\n    75\t  switch (type) {\n    76\t    case 'line':\n    77\t    case 'area': return [{ day, site: 'North', energy: 10 + (k % 5) }, { day, site: 'South', energy: 5 + (k % 3) }];\n    78\t    case 'bar': return [{ quarter: `P${k}`, kind: 'Plan', shipped: 40 + k }, { quarter: `P${k}`, kind: 'Actual', shipped: 39 + k }];\n    79\t    case 'scatter': return [{ size: 40 + k, latency: 100 + k, region: 'EU' }];\n    80\t    case 'donut': return [{ item: `Item ${k}`, spend: 100 + k }];\n    81\t  }\n    82\t}\n    83\t\n    84\t/** Counts text changes of every live region in the page (aria-live other than off, role status or alert). */\n    85\tasync function watchLive(page: Page): Promise<void> {\n    86\t  await page.evaluate(() => {\n    87\t    const w = window as unknown as { liveChanges: string[] };\n    88\t    w.liveChanges = [];\n    89\t    const live = (el: Element | null): Element | null => {\n    90\t      for (let e = el; e; e = e.parentElement) {\n    91\t        const v = e.getAttribute('aria-live');\n    92\t        if (v === 'off') return null;\n    93\t        if (v === 'polite' || v === 'assertive' || e.getAttribute('role') === 'alert' || (e.getAttribute('role') === 'status' && v === null)) return e;\n    94\t      }\n    95\t      return null;\n    96\t    };\n    97\t    new MutationObserver(records => {\n    98\t      for (const r of records) {\n    99\t        const target = r.target.nodeType === Node.TEXT_NODE ? r.target.parentElement : r.target as Element;\n   100\t        const region = live(target);\n   101\t        if (region && (region.textContent ?? '').trim()) w.liveChanges.push(region.textContent ?? '');\n   102\t      }\n   103\t    }).observe(document.body, { subtree: true, childList: true, characterData: true });\n   104\t  });\n   105\t}\n   106\t\n   107\tdescribe('A7 data arriving does not speak', () => {\n   108\t  for (const type of FULL as Full[]) {\n   109\t    it(`A7 ${type}: 24 charts appending ten times each change no live region, with no chart focused`, async () => {\n   110\t      const page = await devPage({ css: '.tile { width: 340px; height: 200px; }' });\n   111\t      await page.evaluate(() => {\n   112\t        for (let i = 0; i < 24; i++) {\n   113\t          const el = document.createElement('div');\n   114\t          el.id = `tile-${i}`;\n   115\t          el.className = 'tile';\n   116\t          document.body.appendChild(el);\n   117\t        }\n   118\t      });\n   119\t      for (let i = 0; i < 24; i++) await create(page, type, {}, `#tile-${i}`);\n   120\t      await watchLive(page);\n   121\t      for (let k = 0; k < 10; k++) {\n   122\t        await page.evaluate(({ rows }) => {\n   123\t          for (const c of (window as unknown as { charts: { append(r: unknown[], o: unknown): void }[] }).charts) c.append(rows, { keep: 5 });\n   124\t        }, { rows: streamRow(type, k) });\n   125\t        await settle(page);\n   126\t      }\n   127\t      expect(await page.evaluate(() => (window as unknown as { liveChanges: string[] }).liveChanges)).toEqual([]);\n   128\t      expect(await closePage(page)).toEqual([]);\n   129\t    });\n   130\t\n   131\t    it(`A7 ${type}: with the plot focused, appends change no live region and focus stays on its datum while it is in the window`, async () => {\n   132\t      const page = await devPage();\n   133\t      await create(page, type);\n   134\t      await page.focus('#chart .axylo-proxy');\n   135\t      await page.keyboard.press('End');\n   136\t      const text = await valueText(page);\n   137\t      await watchLive(page);\n   138\t      // Growing, not sliding: the datum stays in the window.\n   139\t      for (let k = 0; k < 3; k++) await call(page, 'append', [streamRow(type, k)]);\n   140\t      const after = await valueText(page);\n   141\t      expect(await page.evaluate(() => (window as unknown as { liveChanges: string[] }).liveChanges)).toEqual([]);\n   142\t      // The same datum: its own words (everything before the position; on a donut also before the share,\n   143\t      // which an added slice changes) are unchanged.\n   144\t      const datum = (t: string) => t.replace(/\\.?\\s*Point \\d+ of \\d+\\.?$/, '').replace(/\\s*\\([^)]*%\\)/, '');\n   145\t      expect(datum(after)).toBe(datum(text));\n   146\t      expect(await closePage(page)).toEqual([]);\n   147\t    });\n   148\t\n   149\t    if (type !== 'donut') it(`A7 ${type}: with the plot focused, appended rows do not change what the focused plot says (reading: a focused range whose value text changes is spoken, so its position must not count arriving rows)`, async () => {\n   150\t      const page = await devPage();\n   151\t      await create(page, type);\n   152\t      await page.focus('#chart .axylo-proxy');\n   153\t      await page.keyboard.press('ArrowRight');\n   154\t      const text = await valueText(page);\n   155\t      for (let k = 0; k < 3; k++) await call(page, 'append', [streamRow(type, k)]);\n   156\t      expect(await valueText(page)).toBe(text);\n   157\t      expect(await closePage(page)).toEqual([]);\n   158\t    });\n   159\t  }\n   160\t});\n   161\t\n   162\t// ── A8 ────────────────────────────────────────────────────────────────────────────────────────────\n   163\t\n   164\ttype State = [string, (page: Page) => Promise<void>];\n   165\t\n   166\tfunction states(type: ChartType): State[] {\n   167\t  const list: State[] = [['default', async () => {}]];\n   168\t  if (type !== 'compact') {\n   169\t    list.push(['keyboard focus with tooltip', async page => { await page.focus('#before'); await page.keyboard.press('Tab'); await page.keyboard.press('ArrowRight'); }]);\n   170\t    list.push(['pointer tooltip', async page => { const p = await box(page, '#chart .axylo-proxy'); await page.mouse.move(p.x + p.width * 0.6, p.y + p.height * 0.5); }]);\n   171\t    list.push(['table open', async page => { await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click(); await settle(page); }]);\n   172\t    list.push(['streaming', async page => call(page, 'append', [streamRow(type as Full, 0)])]);\n   173\t  }\n   174\t  if (type === 'line' || type === 'area' || type === 'scatter') {\n   175\t    list.push(['zoomed', async page => call(page, 'zoom', [type === 'scatter' ? [12, 30] : ['2026-03-03', '2026-03-05']])]);\n   176\t  }\n   177\t  if (type !== 'compact' && type !== 'donut' && type !== 'scatter') {\n   178\t    list.push(['a series hidden', async page => { await page.locator('#chart .axylo-legend-entry').first().click(); await settle(page); }]);\n   179\t  }\n   180\t  list.push(['loading', async page => call(page, 'update', [{ state: 'loading' }])]);\n   181\t  list.push(['empty', async page => call(page, 'update', [{ data: [] }])]);\n   182\t  list.push(['error', async page => call(page, 'update', [{ state: { error: 'The query failed.' } }])]);\n   183\t  return list;\n   184\t}\n   185\t\n   186\tdescribe('A8 axe-core', () => {\n   187\t  for (const type of TYPES) {\n   188\t    it(`A8 ${type}: axe-core reports no violations in any state (${states(type).map(s => s[0]).join(', ')}, and with values left out)`, async () => {\n   189\t      const failures: string[] = [];\n   190\t      for (const [name, enter] of states(type)) {\n   191\t        const page = await devPage();\n   192\t        await create(page, type);\n   193\t        await enter(page);\n   194\t        const result = await axe(page, '#chart');\n   195\t        for (const v of result.violations) failures.push(`${name}: ${v.id} (${v.nodes.join(', ')})`);\n   196\t        await closePage(page);\n   197\t      }\n   198\t      const page = await devPage();\n   199\t      await create(page, type, {}, '#chart', 'dirty');\n   200\t      const result = await axe(page, '#chart');\n   201\t      for (const v of result.violations) failures.push(`values left out: ${v.id} (${v.nodes.join(', ')})`);\n   202\t      // heading-order is about the page's outline, so it is run over the page; the page's own landmarks\n   203\t      // (axe's \"region\") are the author's and are not counted (spec 3.4).\n   204\t      const outline = await axe(page, 'body');\n   205\t      for (const v of outline.violations.filter(v => v.id === 'heading-order')) failures.push(`values left out: ${v.id} (${v.nodes.join(', ')})`);\n   206\t      if (type !== 'compact') expect(outline.ran).toContain('heading-order');\n   207\t      await closePage(page);\n   208\t      expect(failures).toEqual([]);\n   209\t    });\n   210\t  }\n   211\t});\n   212\t\n   213\t// ── A10 ───────────────────────────────────────────────────────────────────────────────────────────\n   214\t\n   215\t/** Every key of the public `Messages` interface (src/public.ts), the spec's \"every built-in string\". */\n   216\tconst MESSAGE_KEYS = [\n   217\t  'viewAsTable', 'hideTable', 'noData', 'noObservation', 'incompleteStack', 'moreRows', 'otherSlices', 'valuesNotShown', 'valuesChanged', 'labelsHidden',\n   218\t  'loading', 'empty', 'error', 'internalError', 'chartName', 'chartSummary', 'seriesSummary', 'referenceSummary', 'timeZoneNote', 'plotLabel', 'controlsLabel',\n   219\t  'pointOf', 'zoomIn', 'zoomOut', 'resetZoom', 'pause', 'resume', 'previousPage', 'nextPage', 'pageOf', 'jumpToX', 'showSeries', 'hideSeries', 'category',\n   220\t  'percentage', 'series', 'value', 'typeLine', 'typeArea', 'typeBar', 'typeScatter', 'typeDonut', 'donutSummary', 'seriesNoData', 'seriesNotDrawn',\n   221\t  'referenceLine', 'referenceBand', 'plotRole', 'pointAll', 'seriesValue', 'position', 'total', 'panLeft', 'panRight', 'jumpNotFound', 'plotInstructions',\n   222\t] as const;\n   223\tconst PLACEHOLDERS = '{count} {type} {x} {y} {series} {value} {index} {page} {label} {from} {to} {zone} {min} {max} {last} {total} {xLabel} {xMin} {xMax} {yLabel} {yMin} {yMax} {seriesCount} {values} {position} {percent} {example}';\n   224\t/** Distinctive words of the built-in English text; none may remain once every message is replaced. */\n   225\tconst ENGLISH = ['View as table', 'Hide table', 'Chart plot', 'Chart controls', 'Zoom in', 'Zoom out', 'Reset zoom', 'No data', 'not shown', 'Previous page', 'Next page', 'Jump to', 'Category', 'Percentage', 'minimum', 'maximum', 'Point ', 'chart with', 'Pause', 'Times are shown', ' chart'];\n   226\t\n   227\t/** Every text an assistive technology or a sighted reader gets from the chart, after the reader used it. */\n   228\tasync function everyText(page: Page, type: ChartType): Promise<string> {\n   229\t  const parts: string[] = [];\n   230\t  if (type !== 'compact') {\n   231\t    await page.focus('#chart .axylo-proxy');\n   232\t    await page.keyboard.press('ArrowRight');\n   233\t    parts.push(await valueText(page));\n   234\t    await page.locator('#chart [role=\"toolbar\"] button').last().click();\n   235\t    await settle(page);\n   236\t  }\n   237\t  for (const n of await axWithin(page, '#chart')) parts.push(n.name, n.description, String(n.props.roledescription ?? ''));\n   238\t  parts.push(await page.locator('#chart').innerText());\n   239\t  return parts.join(' | ');\n   240\t}\n   241\t\n   242\tdescribe('A10 built-in text', () => {\n   243\t  for (const type of TYPES) {\n   244\t    it(`A10 ${type}: every built-in string is replaced through messages: none of the built-in English is left in the figure, the accessibility tree or the value text`, async () => {\n   245\t      const page = await devPage();\n   246\t      const messages = Object.fromEntries(MESSAGE_KEYS.map(k => [k, `ZZ-${k} ${PLACEHOLDERS}`]));\n   247\t      // Dirty data, so the note is shown; a donut and the cartesian types each get theirs.\n   248\t      await create(page, type, { messages, title: 'Replaced' }, '#chart', 'dirty');\n   249\t      if (type !== 'compact') await call(page, 'append', [type === 'donut' ? [{ day: 'Mon2', value: 5 }] : type === 'scatter' ? [{ n: 8, value: 5 }] : [{ day: 'Mon2', value: 5 }]]);\n   250\t      const text = await everyText(page, type);\n   251\t      expect(ENGLISH.filter(e => text.includes(e)), text.slice(0, 2000)).toEqual([]);\n   252\t      expect(text).toContain('ZZ-');\n   253\t      expect(await closePage(page)).toEqual([]);\n   254\t    });\n   255\t\n   256\t    it(`A10 ${type}: on a lang=\"de\" page the built-in English text is marked lang=\"en\", and the author's own text is not (reading: the generated summary's sentences are built-in English)`, async () => {\n   257\t      const page = await devPage();\n   258\t      await page.evaluate(() => document.documentElement.setAttribute('lang', 'de'));\n   259\t      await create(page, type, { title: 'Energieverbrauch' }, '#chart', 'dirty');\n   260\t      if (type !== 'compact') {\n   261\t        await page.focus('#chart .axylo-proxy');\n   262\t        await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n   263\t        await settle(page);\n   264\t      }\n   265\t      const wrong = await page.evaluate(() => {\n   266\t        const out: string[] = [];\n   267\t        const langOf = (el: Element) => el.closest('[lang]')?.getAttribute('lang') ?? '';\n   268\t        // Built-in English: the summary, the note, the toolbar's fixed controls, the plot's name and role, the table pager.\n   269\t        const builtIn = [\n   270\t          ...document.querySelectorAll('#chart .axylo-summary, #chart .axylo-note:not([hidden]), #chart .axylo-pager button, #chart .axylo-page'),\n   271\t          ...[...document.querySelectorAll('#chart [role=\"toolbar\"] button:not(.axylo-legend-entry)')],\n   272\t          ...document.querySelectorAll('#chart .axylo-proxy'),\n   273\t        ];\n   274\t        for (const el of builtIn) if (langOf(el) !== 'en') out.push(`not marked en: ${el.className} \"${(el.textContent || el.getAttribute('aria-label') || '').slice(0, 40)}\"`);\n   275\t        const title = document.querySelector('#chart .axylo-title:not([hidden])');\n   276\t        if (title && langOf(title) === 'en') out.push('author title marked en');\n   277\t        return out;\n   278\t      });\n   279\t      expect(wrong).toEqual([]);\n   280\t      expect(await closePage(page)).toEqual([]);\n   281\t    });\n   282\t  }\n   283\t});\n   284\t\n","exit_code":0,"status":"completed"}}
