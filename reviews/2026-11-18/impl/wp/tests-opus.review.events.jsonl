{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc 'for f in compact.browser.test.ts f2-gaps.browser.test.ts f8-donut.browser.test.ts f12-note.browser.test.ts; do nl -ba packages/axylo/test/browser/acceptance/$f; done'","aggregated_output":"     1\t/**\n     2\t * The compact variant, C1–C5 (spec 3.7), for compact line, area and bar: a static image with a full text\n     3\t * alternative, the fidelity rules kept, the container filled, dashes between series, and the omission\n     4\t * marker. Read from Chrome's accessibility tree and from the rendered marks.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport { axOf, axWithin, box, closePage, createRaw, devPage, prodPage, settle, shapes, tabStops } from './util';\n    10\timport { DIRTY, dirtyRows, inOrder, withUnit } from './fixtures';\n    11\t\n    12\tbeforeAll(start);\n    13\tafterAll(stop);\n    14\t\n    15\tconst KINDS = ['line', 'area', 'bar'] as const;\n    16\ttype Kind = typeof KINDS[number];\n    17\t\n    18\t/** Five days of one series; the Phase 1 `bars` values (82–97) for the baseline check. */\n    19\tconst ROWS = [12, 15, 11, 18, 16].map((v, i) => ({ day: `2026-03-0${i + 2}`, v }));\n    20\tconst options = (kind: Kind, extra: Record<string, unknown> = {}) => ({ compact: true, title: 'Energy, North', data: ROWS, x: { field: 'day', type: 'date' }, y: { field: 'v', label: 'Energy', unit: 'kWh' }, ...extra, kind });\n    21\t\n    22\tasync function make(page: Page, kind: Kind, extra: Record<string, unknown> = {}, target = '#chart') {\n    23\t  const { kind: fn, ...rest } = options(kind, extra);\n    24\t  return createRaw(page, fn, rest, target);\n    25\t}\n    26\t\n    27\tdescribe('C1 a static image with a text alternative', () => {\n    28\t  for (const kind of KINDS) {\n    29\t    it(`C1 compact ${kind}: role img, named by its title, described by the generated summary (series, x range, minimum, maximum, last value)`, async () => {\n    30\t      const page = await devPage({ css: '#chart { width: 200px; height: 48px; }' });\n    31\t      await make(page, kind);\n    32\t      const fig = await axOf(page, '#chart figure');\n    33\t      expect(fig.role).toBe('image');\n    34\t      expect(fig.name).toBe('Energy, North');\n    35\t      for (const group of [['Mar 2, 2026', 'Mar 6, 2026'], ['Energy', withUnit(11, 'kWh'), withUnit(18, 'kWh'), withUnit(16, 'kWh')]]) {\n    36\t        expect(inOrder(fig.description, group), `${JSON.stringify(group)} in ${fig.description}`).toBe(true);\n    37\t      }\n    38\t      // An image: nothing inside it is exposed on its own.\n    39\t      expect((await axWithin(page, '#chart figure')).filter(n => n.role !== 'image' && n.role !== 'StaticText' && n.role !== 'generic' && n.role !== 'paragraph' && n.role !== 'InlineTextBox')).toEqual([]);\n    40\t      expect(await closePage(page)).toEqual([]);\n    41\t    });\n    42\t\n    43\t    for (const build of ['development', 'production'] as const) {\n    44\t      it(`C1 compact ${kind}: without a title the name is generated and AX140 is raised (${build} build)`, async () => {\n    45\t        const page = build === 'development' ? await devPage() : await prodPage();\n    46\t        const built = await make(page, kind, { title: undefined, x: { field: 'day', type: 'date', label: 'Day' } });\n    47\t        expect(built.diagnostics.filter(d => d.code === 'AX140').map(d => d.level)).toEqual(['warning']);\n    48\t        const word = { line: 'Line', area: 'Area', bar: 'Bar' }[kind];\n    49\t        expect((await axOf(page, '#chart figure')).name).toBe(`${word} chart of Energy by Day`);\n    50\t        expect(await closePage(page)).toEqual([]);\n    51\t      });\n    52\t    }\n    53\t\n    54\t    it(`C1 compact ${kind}: a page of 40 compact charts adds no tab stop, and pointing at one shows nothing a keyboard cannot reach`, async () => {\n    55\t      const page = await devPage({ css: '.tile { width: 160px; height: 48px; }' });\n    56\t      await page.evaluate(() => {\n    57\t        const after = document.querySelector('#after')!;\n    58\t        for (let i = 0; i < 40; i++) {\n    59\t          const el = document.createElement('div');\n    60\t          el.id = `tile-${i}`;\n    61\t          el.className = 'tile';\n    62\t          after.before(el);\n    63\t        }\n    64\t      });\n    65\t      for (let i = 0; i < 40; i++) await make(page, kind, { title: `Tile ${i}` }, `#tile-${i}`);\n    66\t      // #chart is empty here: from #before the next stop is #after.\n    67\t      expect(await tabStops(page)).toEqual(['after']);\n    68\t      const b = await box(page, '#tile-3');\n    69\t      await page.mouse.move(b.x + b.width / 2, b.y + b.height / 2);\n    70\t      await settle(page);\n    71\t      const visible = await page.evaluate(() => [...document.querySelectorAll<HTMLElement>('#tile-3 .axylo-tooltip, #tile-3 .axylo-readout')].some(e => !e.hidden));\n    72\t      expect(visible).toBe(false);\n    73\t      expect(await closePage(page)).toEqual([]);\n    74\t    });\n    75\t  }\n    76\t});\n    77\t\n    78\tdescribe('C2 the fidelity rules hold', () => {\n    79\t  for (const kind of ['area', 'bar'] as const) {\n    80\t    it(`C2 compact ${kind}: the value axis includes zero: the Phase 1 bars values (82–97) are drawn from a zero baseline (F1)`, async () => {\n    81\t      const page = await devPage({ css: '#chart { width: 280px; height: 100px; }' });\n    82\t      const values = [94, 88, 97, 82, 91, 85, 90];\n    83\t      await createRaw(page, kind, { compact: true, title: 'Satisfied', data: values.map((v, i) => ({ c: `T${i}`, v })), x: 'c', y: 'v' });\n    84\t      if (kind === 'bar') {\n    85\t        const rects = ((await shapes(page, '#chart', 100000))[1] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n    86\t        expect(rects).toHaveLength(7);\n    87\t        // Heights proportional to the values from zero: 82 / 97 of the tallest, not a sliver.\n    88\t        const tallest = Math.max(...rects.map(r => r.height));\n    89\t        rects.forEach((r, i) => expect(r.height / tallest).toBeCloseTo(values[i]! / 97, 1));\n    90\t      } else {\n    91\t        const svg = await box(page, '#chart svg.axylo-svg');\n    92\t        const fill = await page.evaluate(() => {\n    93\t          const svg = document.querySelector('#chart svg.axylo-svg') as SVGSVGElement;\n    94\t          const m = svg.getScreenCTM()!;\n    95\t          let lowest = -Infinity, highest = Infinity;\n    96\t          for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) {\n    97\t            const nums = (el.getAttribute('d') ?? '').match(/-?\\d*\\.?\\d+/g)?.map(Number) ?? [];\n    98\t            for (let i = 1; i < nums.length; i += 2) { const y = new DOMPoint(nums[i - 1]!, nums[i]!).matrixTransform(m).y; lowest = Math.max(lowest, y); highest = Math.min(highest, y); }\n    99\t          }\n   100\t          return { lowest, highest };\n   101\t        });\n   102\t        // The fill reaches down to the zero baseline at the bottom; 82 sits well above it (82 / 97 of the height).\n   103\t        expect(fill.lowest).toBeGreaterThanOrEqual(svg.y + svg.height - 4);\n   104\t        expect(fill.lowest - fill.highest).toBeGreaterThan(svg.height * 0.8);\n   105\t      }\n   106\t      expect(await closePage(page)).toEqual([]);\n   107\t    });\n   108\t  }\n   109\t\n   110\t  for (const kind of KINDS) {\n   111\t    it(`C2 compact ${kind}: shuffled input draws the same marks as sorted input (F11), and the dirty fixture yields AX102, AX103 and AX106 (F3)`, async () => {\n   112\t      const page = await devPage({ css: '#chart, #other { width: 200px; height: 48px; }', viewport: { width: 900, height: 900 } });\n   113\t      await page.evaluate(() => { const el = document.createElement('div'); el.id = 'other'; document.querySelector('#after')!.after(el); });\n   114\t      await make(page, kind);\n   115\t      const shuffled = [ROWS[3], ROWS[0], ROWS[4], ROWS[2], ROWS[1]];\n   116\t      await make(page, kind, { data: shuffled }, '#other');\n   117\t      const scene = (sel: string) => page.evaluate(sel => document.querySelector(`${sel} svg.axylo-svg .axylo-scene`)!.innerHTML.replace(/axylo-clip-\\d+/g, 'clip'), sel);\n   118\t      expect(await scene('#other')).toBe(await scene('#chart'));\n   119\t      await page.close();\n   120\t      const dirty = await devPage({ css: '#chart { width: 200px; height: 48px; }' });\n   121\t      const built = await createRaw(dirty, kind, { compact: true, title: 'Dirty', data: dirtyRows(), x: 'day', y: 'value' });\n   122\t      expect(built.diagnostics.filter(d => d.level === 'warning').map(d => d.code).sort()).toEqual(['AX102', 'AX103', 'AX106']);\n   123\t      expect(await closePage(dirty)).toEqual([]);\n   124\t    });\n   125\t  }\n   126\t});\n   127\t\n   128\tdescribe('C3 size', () => {\n   129\t  for (const kind of KINDS) {\n   130\t    it(`C3 compact ${kind}: it fills containers of 24×16, 160×48 and 600×120 CSS px; with no definite height it is 32 px tall`, async () => {\n   131\t      const page = await devPage();\n   132\t      await make(page, kind);\n   133\t      for (const [w, h] of [[24, 16], [160, 48], [600, 120]] as const) {\n   134\t        await page.evaluate(([w, h]) => Object.assign((document.querySelector('#chart') as HTMLElement).style, { width: `${w}px`, height: `${h}px` }), [w, h]);\n   135\t        await settle(page);\n   136\t        const svg = await box(page, '#chart svg.axylo-svg');\n   137\t        expect(Math.abs(svg.width - w), `${w}×${h} width`).toBeLessThanOrEqual(1);\n   138\t        expect(Math.abs(svg.height - h), `${w}×${h} height`).toBeLessThanOrEqual(1);\n   139\t        const marks = await page.evaluate(() => [...document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene *')].filter(e => /--axylo-series-color-/.test(e.style.getPropertyValue('color'))).length);\n   140\t        expect(marks, `${w}×${h} marks`).toBeGreaterThan(0);\n   141\t      }\n   142\t      await page.evaluate(() => Object.assign((document.querySelector('#chart') as HTMLElement).style, { width: '200px', height: 'auto' }));\n   143\t      await settle(page);\n   144\t      expect(Math.round((await box(page, '#chart figure')).height)).toBe(32);\n   145\t      expect(await closePage(page)).toEqual([]);\n   146\t    });\n   147\t  }\n   148\t});\n   149\t\n   150\tdescribe('C4 more than one series', () => {\n   151\t  for (const kind of KINDS) {\n   152\t    it(`C4 compact ${kind}: two series differ by ${kind === 'bar' ? 'more than colour' : 'dash as well as colour'}, and AX131 suggests one series per compact chart`, async () => {\n   153\t      const page = await devPage({ css: '#chart { width: 240px; height: 60px; }' });\n   154\t      const data = ROWS.flatMap(r => [{ ...r, s: 'North' }, { ...r, v: r.v - 5, s: 'South' }]);\n   155\t      const built = await createRaw(page, kind, { compact: true, title: 'Two', data, x: { field: 'day', type: 'date' }, y: 'v', series: 's' });\n   156\t      expect(built.diagnostics.filter(d => d.code === 'AX131').map(d => d.level)).toEqual(['hint']);\n   157\t      const cues = await page.evaluate(() => {\n   158\t        const out: Record<string, string[]> = {};\n   159\t        for (const el of document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene *')) {\n   160\t          const slot = /--axylo-series-color-(\\d+)/.exec(el.style.getPropertyValue('color'));\n   161\t          if (!slot) continue;\n   162\t          const s = getComputedStyle(el);\n   163\t          (out[slot[1]!] ??= []).push(`${s.strokeDasharray}|${el.getAttribute('fill') ?? ''}|${s.fill.startsWith('url') ? 'pattern' : ''}`);\n   164\t        }\n   165\t        return Object.values(out).map(v => [...new Set(v)].sort().join(' '));\n   166\t      });\n   167\t      expect(cues).toHaveLength(2);\n   168\t      // Spec C4 names lines; for bars (reading) the second series needs some cue other than colour too.\n   169\t      expect(cues[0]).not.toBe(cues[1]);\n   170\t      expect(await closePage(page)).toEqual([]);\n   171\t    });\n   172\t  }\n   173\t});\n   174\t\n   175\tdescribe('C5 values left out', () => {\n   176\t  for (const kind of KINDS) {\n   177\t    it(`C5 compact ${kind}: with the dirty fixture the description says ${DIRTY.leftOut} values are not shown and a small corner marker appears, with a text equivalent`, async () => {\n   178\t      const page = await devPage({ css: '#chart { width: 200px; height: 48px; }' });\n   179\t      await createRaw(page, kind, { compact: true, title: 'Dirty', data: dirtyRows(), x: 'day', y: 'value' });\n   180\t      const fig = await axOf(page, '#chart figure');\n   181\t      expect(fig.description).toMatch(new RegExp(`not shown[^.]*\\\\b${DIRTY.leftOut}\\\\b|\\\\b${DIRTY.leftOut}\\\\b[^.]*not shown`, 'i'));\n   182\t      const corner = page.locator('#chart .axylo-corner');\n   183\t      expect(await corner.isVisible()).toBe(true);\n   184\t      const c = await box(page, '#chart .axylo-corner');\n   185\t      const fb = await box(page, '#chart figure');\n   186\t      expect(c.width * c.height).toBeLessThan(fb.width * fb.height / 4);\n   187\t      const nearCorner = (c.x - fb.x < 4 || fb.x + fb.width - (c.x + c.width) < 4) && (c.y - fb.y < 4 || fb.y + fb.height - (c.y + c.height) < 4);\n   188\t      expect(nearCorner).toBe(true);\n   189\t      // Its text equivalent: the image's description carries the statement the marker stands for.\n   190\t      const title = await corner.getAttribute('title');\n   191\t      expect(title && fig.description.includes(title.replace(/\\s*See table\\.?$/, '').trim()), `${title} in ${fig.description}`).toBe(true);\n   192\t      expect(await closePage(page)).toEqual([]);\n   193\t    });\n   194\t  }\n   195\t});\n     1\t/**\n     2\t * F2, rendered (spec 3.1): missing values are never drawn as zero and never bridged; an isolated value\n     3\t * between two gaps is a visible point; a missing bar shows a \"no data\" mark distinct from a zero bar;\n     4\t * explicit nulls and deleted rows on a regular date axis render the same gap (AX105); readouts say\n     5\t * \"No data\". Gaps are read from screenshots with the gridlines made transparent through the public\n     6\t * `--axylo-grid` property, so any non-background pixel in a gap is a drawn mark.\n     7\t */\n     8\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     9\timport type { Page } from 'playwright-core';\n    10\timport { start, stop } from '../harness';\n    11\timport { axWithin, backgroundColor, box, closePage, createRaw, devPage, distance, pixel, screenshot, settle, shapes, valueText } from './util';\n    12\t\n    13\tbeforeAll(start);\n    14\tafterAll(stop);\n    15\t\n    16\tconst NO_GRID = '#chart, #other { --axylo-grid: transparent; }';\n    17\t\n    18\t/** Values over x = 0…6: gaps at 2 and 4, so 3 is isolated between two gaps. */\n    19\tconst VALUES = [10, 20, null, 40, null, 60, 70];\n    20\t\n    21\t/** Vertices of each stroked series line, in viewport px, sorted by x. */\n    22\tasync function vertices(page: Page, selector = '#chart'): Promise<{ x: number; y: number }[]> {\n    23\t  return page.evaluate(selector => {\n    24\t    const svg = document.querySelector(`${selector} svg.axylo-svg`) as SVGSVGElement;\n    25\t    const m = svg.getScreenCTM()!;\n    26\t    const out: { x: number; y: number }[] = [];\n    27\t    for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) {\n    28\t      if (!/--axylo-series-color-1\\b/.test(el.style.getPropertyValue('color')) || el.style.getPropertyValue('stroke') !== 'currentcolor') continue;\n    29\t      const nums = (el.getAttribute('d') ?? '').match(/-?\\d*\\.?\\d+/g)?.map(Number) ?? [];\n    30\t      for (let i = 0; i + 1 < nums.length; i += 2) { const p = new DOMPoint(nums[i]!, nums[i + 1]!).matrixTransform(m); out.push({ x: p.x, y: p.y }); }\n    31\t    }\n    32\t    return out.sort((a, b) => a.x - b.x);\n    33\t  }, selector);\n    34\t}\n    35\t\n    36\t/** Non-background pixels in the columns [x0, x1) and rows [y0, y1) of the plot screenshot (viewport px). */\n    37\tasync function inkIn(page: Page, x0: number, x1: number, y0: number, y1: number): Promise<number> {\n    38\t  const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n    39\t  const bg = await backgroundColor(page);\n    40\t  let n = 0;\n    41\t  for (let y = Math.ceil(y0 - plot.y); y < y1 - plot.y; y++) for (let x = Math.ceil(x0 - plot.x); x < x1 - plot.x; x++) if (distance(pixel(img, x, y), bg) > 40) n++;\n    42\t  return n;\n    43\t}\n    44\t\n    45\tdescribe('F2 gaps in lines and areas', () => {\n    46\t  for (const type of ['line', 'area', 'compact'] as const) {\n    47\t    it(`F2 ${type}: null values are gaps, never zero and never bridged, and the value isolated between two gaps is a visible point`, async () => {\n    48\t      const page = await devPage({ css: `${NO_GRID} ${type === 'compact' ? '#chart { width: 240px; height: 60px; }' : ''}` });\n    49\t      await createRaw(page, type === 'compact' ? 'line' : type, {\n    50\t        title: 'Gaps', data: VALUES.map((v, x) => ({ x, v })), x: 'x', y: 'v', ...(type === 'compact' ? { compact: true } : {}),\n    51\t      });\n    52\t      // x positions from the drawn runs: points 0, 1, 5 and 6 are on the stroke, evenly spaced.\n    53\t      const v = await vertices(page);\n    54\t      expect(v.length).toBeGreaterThanOrEqual(4);\n    55\t      const x0 = v[0]!.x, step = (v.at(-1)!.x - x0) / 6;\n    56\t      const xs = VALUES.map((_, k) => x0 + k * step);\n    57\t      // No vertex at x = 2 or x = 4 (not drawn as zero), none bridging them.\n    58\t      for (const k of [2, 4]) expect(v.some(p => Math.abs(p.x - xs[k]!) < 1), `vertex at ${k}`).toBe(false);\n    59\t      const svg = await box(page, '#chart svg.axylo-svg');\n    60\t      const top = svg.y, bottom = type === 'compact' ? svg.y + svg.height : (await box(page, '#chart .axylo-proxy')).y + (await box(page, '#chart .axylo-proxy')).height - 3;\n    61\t      const margin = 7;\n    62\t      expect(await inkIn(page, xs[1]! + margin, xs[3]! - margin, top, bottom), 'between x = 1 and 3').toBe(0);\n    63\t      expect(await inkIn(page, xs[3]! + margin, xs[5]! - margin, top, bottom), 'between x = 3 and 5').toBe(0);\n    64\t      // The isolated value at x = 3 is drawn.\n    65\t      expect(await inkIn(page, xs[3]! - 4, xs[3]! + 4, top, bottom), 'at x = 3').toBeGreaterThan(4);\n    66\t      expect(await closePage(page)).toEqual([]);\n    67\t    });\n    68\t\n    69\t    it(`F2 ${type}: on a regular date axis, explicit nulls and the same rows deleted render the same gap, and the deleted rows raise AX105`, async () => {\n    70\t      const page = await devPage({ viewport: { width: 900, height: 1100 }, css: `${NO_GRID} #other { width: 720px; height: 400px; } ${type === 'compact' ? '#chart, #other { width: 240px; height: 60px; }' : ''}` });\n    71\t      await page.evaluate(() => { const el = document.createElement('div'); el.id = 'other'; document.querySelector('#after')!.after(el); });\n    72\t      const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n    73\t      const full = Array.from({ length: 20 }, (_, k) => ({ day: day(k), v: 10 + ((k * 7) % 11) }));\n    74\t      const withNulls = full.map((r, k) => (k >= 8 && k <= 10 ? { ...r, v: null } : r));\n    75\t      const deleted = full.filter((_, k) => k < 8 || k > 10);\n    76\t      const common = { title: 'Same gap', x: { field: 'day', type: 'date' }, y: 'v', ...(type === 'compact' ? { compact: true } : {}) };\n    77\t      const fn = type === 'compact' ? 'line' : type;\n    78\t      const a = await createRaw(page, fn, { ...common, data: withNulls }, '#chart');\n    79\t      const b = await createRaw(page, fn, { ...common, data: deleted }, '#other');\n    80\t      expect(a.diagnostics.map(d => d.code)).not.toContain('AX105');\n    81\t      expect(b.diagnostics.map(d => d.code)).toContain('AX105');\n    82\t      // The same drawing: identical mark geometry in both plots (the same pixels follow from it; a pixel\n    83\t      // comparison of two places on the page also measures the rasteriser, so it is not used).\n    84\t      const scene = (sel: string) => page.evaluate(sel => [...document.querySelectorAll(`${sel} .axylo-scene path, ${sel} .axylo-scene rect`)].map(e => e.getAttribute('d') ?? `${e.getAttribute('x')},${e.getAttribute('y')},${e.getAttribute('width')},${e.getAttribute('height')}`), sel);\n    85\t      const drawn = await scene('#chart');\n    86\t      expect(drawn.length).toBeGreaterThan(0);\n    87\t      expect(await scene('#other')).toEqual(drawn);\n    88\t      expect(await closePage(page)).toEqual([]);\n    89\t    });\n    90\t  }\n    91\t});\n    92\t\n    93\tdescribe('F2 bars', () => {\n    94\t  it('F2 bar: a missing bar shows a \"no data\" mark at the baseline, distinct from a zero bar and from an empty band', async () => {\n    95\t    const page = await devPage({ css: NO_GRID });\n    96\t    await createRaw(page, 'bar', { title: 'Missing and zero', data: [{ q: 'Q1', v: 10 }, { q: 'Q2', v: null }, { q: 'Q3', v: 0 }, { q: 'Q4', v: 20 }], x: 'q', y: 'v' });\n    97\t    const rects = ((await shapes(page, '#chart', 100000))[1] ?? []).map(s => s.box).filter(b => b.height > 2).sort((a, b) => a.x - b.x);\n    98\t    expect(rects).toHaveLength(2);\n    99\t    const c1 = rects[0]!.x + rects[0]!.width / 2, c4 = rects[1]!.x + rects[1]!.width / 2;\n   100\t    const step = (c4 - c1) / 3, half = rects[0]!.width / 2;\n   101\t    const baseline = rects[0]!.y + rects[0]!.height;\n   102\t    const patch = async (center: number) => {\n   103\t      const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n   104\t      const out: number[] = [];\n   105\t      for (let y = Math.round(baseline - plot.y - 14); y < baseline - plot.y - 1; y++) for (let x = Math.round(center - half - plot.x); x < center + half - plot.x; x++) out.push(...pixel(img, x, y));\n   106\t      return out;\n   107\t    };\n   108\t    const missing = await patch(c1 + step), zero = await patch(c1 + 2 * step);\n   109\t    const bg = await backgroundColor(page);\n   110\t    const ink = (p: number[]) => { let n = 0; for (let i = 0; i < p.length; i += 3) if (distance([p[i]!, p[i + 1]!, p[i + 2]!], bg) > 40) n++; return n; };\n   111\t    expect(ink(missing), 'the missing bar has a visible mark above the axis line').toBeGreaterThan(4);\n   112\t    let differing = 0;\n   113\t    for (let i = 0; i < missing.length; i += 3) if (distance([missing[i]!, missing[i + 1]!, missing[i + 2]!], [zero[i]!, zero[i + 1]!, zero[i + 2]!]) > 40) differing++;\n   114\t    expect(differing, 'the missing and zero bars look different').toBeGreaterThan(4);\n   115\t    expect(await closePage(page)).toEqual([]);\n   116\t  });\n   117\t});\n   118\t\n   119\tdescribe('F2 readouts say \"No data\"', () => {\n   120\t  for (const type of ['line', 'area', 'bar'] as const) {\n   121\t    it(`F2 ${type}: the tooltip, the table and the keyboard read \"No data\" at the missing value, and the zero next to it as 0`, async () => {\n   122\t      const page = await devPage();\n   123\t      const data = type === 'bar'\n   124\t        ? [{ q: 'Q1', v: 10 }, { q: 'Q2', v: null }, { q: 'Q3', v: 0 }, { q: 'Q4', v: 20 }]\n   125\t        : [{ q: '2026-03-02', v: 10 }, { q: '2026-03-03', v: null }, { q: '2026-03-04', v: 0 }, { q: '2026-03-05', v: 20 }];\n   126\t      await createRaw(page, type, { title: 'Missing', data, x: type === 'bar' ? 'q' : { field: 'q', type: 'date' }, y: { field: 'v', label: 'Count' } });\n   127\t      await page.focus('#chart .axylo-proxy');\n   128\t      await page.keyboard.press('ArrowRight');\n   129\t      expect(await valueText(page)).toContain('No data');\n   130\t      await page.keyboard.press('ArrowRight');\n   131\t      const zero = await valueText(page);\n   132\t      expect(zero).not.toContain('No data');\n   133\t      expect(zero).toMatch(/\\b0\\b/);\n   134\t      await page.keyboard.press('ArrowLeft');\n   135\t      expect(await page.locator('#chart .axylo-tooltip').textContent()).toContain('No data');\n   136\t      await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n   137\t      await settle(page);\n   138\t      const cells = (await axWithin(page, '#chart table')).filter(n => n.role === 'cell').map(n => n.name);\n   139\t      expect(cells).toEqual(['10', 'No data', '0', '20']);\n   140\t      expect(await closePage(page)).toEqual([]);\n   141\t    });\n   142\t  }\n   143\t\n   144\t  it('F2 scatter: a point with a missing y is not drawn (never at zero) and the keyboard skips it', async () => {\n   145\t    const page = await devPage();\n   146\t    await createRaw(page, 'scatter', { title: 'Missing', data: [{ x: 1, y: 5 }, { x: 2, y: null }, { x: 3, y: 7 }], x: 'x', y: 'y' });\n   147\t    const drawn = (await shapes(page, '#chart', 14))[1] ?? [];\n   148\t    expect(drawn).toHaveLength(2);\n   149\t    await page.focus('#chart .axylo-proxy');\n   150\t    expect(await valueText(page)).toMatch(/of 2\\b/);\n   151\t    expect(await closePage(page)).toEqual([]);\n   152\t  });\n   153\t\n   154\t  it('F2 donut: a null slice is not drawn and the table reads \"No data\" for it', async () => {\n   155\t    const page = await devPage();\n   156\t    await createRaw(page, 'donut', { title: 'Missing', data: [{ l: 'A', v: 3 }, { l: 'B', v: null }, { l: 'C', v: 1 }], label: 'l', value: 'v' });\n   157\t    await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n   158\t    await settle(page);\n   159\t    const rows = await page.locator('#chart table tbody tr').allInnerTexts();\n   160\t    expect(rows[1]).toContain('No data');\n   161\t    expect(rows[1]).not.toMatch(/\\d/);\n   162\t    expect(await closePage(page)).toEqual([]);\n   163\t  });\n   164\t});\n     1\t/**\n     2\t * F8, rendered (spec 3.1): donut slices keep the given order, start at 12 o'clock and run clockwise (read\n     3\t * from the screenshot along the ring); the legend shows every slice's value and percentage as text, in\n     4\t * slice order; zero, null, negative, more than eight and all-zero slices each have their own outcome.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport { start, stop } from '../harness';\n     8\timport { axWithin, closePage, create, devPage, distance, pixel, resolveColors, ring, screenshot, settle, type RGB } from './util';\n     9\timport { share, SPEND, withUnit } from './fixtures';\n    10\t\n    11\tbeforeAll(start);\n    12\tafterAll(stop);\n    13\t\n    14\t/** The colour of each legend entry's swatch, resolved by the page. */\n    15\tasync function legendColors(page: import('playwright-core').Page): Promise<RGB[]> {\n    16\t  const css = await page.locator('#chart ul.axylo-legend-list > li svg.axylo-swatch').evaluateAll(els => els.map(e => getComputedStyle(e).color));\n    17\t  return resolveColors(page, css);\n    18\t}\n    19\t\n    20\tasync function sliceCount(page: import('playwright-core').Page): Promise<number> {\n    21\t  // Every path of a donut's scene is a slice (the \"Other\" slice has its own muted colour).\n    22\t  return page.evaluate(() => document.querySelectorAll('#chart svg.axylo-svg .axylo-scene path').length);\n    23\t}\n    24\t\n    25\t/** Each legend entry as \"name value\": its name and value parts joined by a space. */\n    26\tasync function legend(page: import('playwright-core').Page): Promise<string[]> {\n    27\t  return page.locator('#chart ul.axylo-legend-list > li').evaluateAll(lis => lis.map(li =>\n    28\t    [li.querySelector('.axylo-legend-name')?.textContent ?? '', li.querySelector('.axylo-legend-value')?.textContent ?? ''].join(' ').trim()));\n    29\t}\n    30\t\n    31\tdescribe('F8 donut geometry and legend', () => {\n    32\t  it('F8 donut: slices keep the given order, start at 12 o\\'clock and run clockwise: the ring at each slice\\'s middle angle shows that slice\\'s legend colour', async () => {\n    33\t    const page = await devPage();\n    34\t    await create(page, 'donut');\n    35\t    const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n    36\t    const g = await ring(page);\n    37\t    const colors = await legendColors(page);\n    38\t    expect(colors).toHaveLength(4);\n    39\t    const total = SPEND.values.reduce((a, b) => a + b, 0);\n    40\t    const at = (degrees: number) => {\n    41\t      const a = degrees * Math.PI / 180, r = g.outer * 0.85;\n    42\t      return pixel(img, g.cx - plot.x + r * Math.sin(a), g.cy - plot.y - r * Math.cos(a));\n    43\t    };\n    44\t    let before = 0;\n    45\t    SPEND.values.forEach((v, i) => {\n    46\t      const mid = 360 * (before + v / 2) / total;\n    47\t      before += v;\n    48\t      const seen = at(mid);\n    49\t      const nearest = colors.map(c => distance(c, seen)).indexOf(Math.min(...colors.map(c => distance(c, seen))));\n    50\t      expect(nearest, `${SPEND.items[i]} at ${mid}°: ${seen}`).toBe(i);\n    51\t      expect(distance(colors[i]!, seen), `${SPEND.items[i]} at ${mid}°`).toBeLessThanOrEqual(24);\n    52\t    });\n    53\t    // Just clockwise of 12 o'clock is the first slice; just anticlockwise of it, the last.\n    54\t    expect(distance(at(3), colors[0]!)).toBeLessThanOrEqual(24);\n    55\t    expect(distance(at(357), colors[3]!)).toBeLessThanOrEqual(24);\n    56\t    expect(await closePage(page)).toEqual([]);\n    57\t  });\n    58\t\n    59\t  it('F8 donut: the legend shows every slice\\'s value and percentage as text, in slice order, and is in the accessibility tree', async () => {\n    60\t    const page = await devPage();\n    61\t    await create(page, 'donut');\n    62\t    const entries = await legend(page);\n    63\t    expect(entries).toHaveLength(4);\n    64\t    SPEND.items.forEach((item, i) => {\n    65\t      const e = entries[i]!;\n    66\t      expect(e.startsWith(item), e).toBe(true);\n    67\t      expect(e).toContain(withUnit(SPEND.values[i]!, SPEND.unit));\n    68\t      expect(e).toContain(share(SPEND.values[i]!));\n    69\t    });\n    70\t    const text = (await axWithin(page, '#chart ul.axylo-legend-list')).filter(n => n.role === 'StaticText').map(n => n.name).join(' ');\n    71\t    for (const item of SPEND.items) expect(text).toContain(item);\n    72\t    expect(text).toContain(share(1200));\n    73\t    expect(await closePage(page)).toEqual([]);\n    74\t  });\n    75\t\n    76\t  it('F8 donut: a zero slice is listed without an arc; a null slice is listed as \"No data\", without an arc', async () => {\n    77\t    const page = await devPage();\n    78\t    await create(page, 'donut', { data: [{ item: 'Rent', spend: 1200 }, { item: 'Gifts', spend: 0 }, { item: 'Food', spend: 600 }, { item: 'Pets', spend: null }] });\n    79\t    const entries = await legend(page);\n    80\t    expect(entries.map(e => e.split(/\\s/)[0])).toEqual(['Rent', 'Gifts', 'Food', 'Pets']);\n    81\t    expect(entries[1]).toContain(withUnit(0, SPEND.unit));\n    82\t    expect(entries[3]).toContain('No data');\n    83\t    expect(entries[3]).not.toMatch(/\\d/);\n    84\t    expect(await sliceCount(page)).toBe(2);\n    85\t    expect(await closePage(page)).toEqual([]);\n    86\t  });\n    87\t\n    88\t  it('F8 donut: a negative value is AX120 and the chart shows its error state inside the plot, with no slices', async () => {\n    89\t    const page = await devPage();\n    90\t    const built = await create(page, 'donut', { data: [{ item: 'Rent', spend: 1200 }, { item: 'Refund', spend: -50 }] });\n    91\t    expect(built.diagnostics.filter(d => d.code === 'AX120').map(d => d.level)).toEqual(['error']);\n    92\t    expect(await sliceCount(page)).toBe(0);\n    93\t    const message = page.locator('#chart .axylo-plot .axylo-message');\n    94\t    expect(await message.isVisible()).toBe(true);\n    95\t    expect(((await message.textContent()) ?? '').trim()).not.toBe('');\n    96\t    const text = (await axWithin(page, '#chart')).filter(n => n.role === 'StaticText').map(n => n.name).join(' ');\n    97\t    expect(text).toContain(((await message.textContent()) ?? '').trim());\n    98\t    expect(await closePage(page)).toEqual([]);\n    99\t  });\n   100\t\n   101\t  it('F8 donut: ten slices draw the seven largest and \"Other (3)\" with AX121; the table lists all ten categories', async () => {\n   102\t    const page = await devPage();\n   103\t    const values = [30, 20, 15, 10, 8, 6, 5, 4, 3, 2];\n   104\t    const built = await create(page, 'donut', { data: values.map((v, i) => ({ item: `S${i + 1}`, spend: v })) });\n   105\t    expect(built.diagnostics.filter(d => d.code === 'AX121').map(d => d.level)).toEqual(['warning']);\n   106\t    const entries = await legend(page);\n   107\t    expect(entries.map(e => e.replace(/\\s+[\\d,.]+\\s*EUR.*$/, ''))).toEqual(['S1', 'S2', 'S3', 'S4', 'S5', 'S6', 'S7', 'Other (3)']);\n   108\t    // Other is 4 + 3 + 2 = 9.\n   109\t    expect(entries[7]).toContain(withUnit(9, SPEND.unit));\n   110\t    expect(await sliceCount(page)).toBe(8);\n   111\t    await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n   112\t    await settle(page);\n   113\t    const rows = await page.locator('#chart table tbody th[scope=\"row\"]').allTextContents();\n   114\t    expect(rows).toEqual(values.map((_, i) => `S${i + 1}`));\n   115\t    expect(await closePage(page)).toEqual([]);\n   116\t  });\n   117\t\n   118\t  it('F8 donut: an all-zero donut shows the empty state inside the plot, with no slices', async () => {\n   119\t    const page = await devPage();\n   120\t    await create(page, 'donut', { data: SPEND.items.map(item => ({ item, spend: 0 })) });\n   121\t    expect(await sliceCount(page)).toBe(0);\n   122\t    const message = page.locator('#chart .axylo-plot .axylo-message');\n   123\t    expect(await message.isVisible()).toBe(true);\n   124\t    expect(((await message.textContent()) ?? '').trim()).not.toBe('');\n   125\t    expect(await closePage(page)).toEqual([]);\n   126\t  });\n   127\t});\n     1\t/**\n     2\t * F12, rendered: when a warning means values were left out or changed, a short note says so inside the\n     3\t * figure and in the accessibility tree, in every build (spec 3.1). Development bundle and the minified\n     4\t * production bundle (prod.html) alike; the tree is Chrome's own.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport { axWithin, box, closePage, create, devPage, inside, prodPage, settle } from './util';\n    10\timport { DIRTY, FULL, type ChartType } from './fixtures';\n    11\t\n    12\tbeforeAll(start);\n    13\tafterAll(stop);\n    14\t\n    15\ttype Full = Exclude<ChartType, 'compact'>;\n    16\t\n    17\t/** The note as the spec words it, for `n` values. */\n    18\tconst notShown = (n: number) => `Values not shown: ${n}. See table.`;\n    19\t\n    20\tasync function noteState(page: Page): Promise<{ text: string; visible: boolean; insideFigure: boolean; inTree: boolean }> {\n    21\t  const note = page.locator('#chart .axylo-note');\n    22\t  const visible = (await note.count()) > 0 && (await note.isVisible());\n    23\t  const text = visible ? ((await note.textContent()) ?? '').trim() : '';\n    24\t  const insideFigure = visible ? inside(await box(page, '#chart .axylo-note'), await box(page, '#chart figure')) : false;\n    25\t  const tree = await axWithin(page, '#chart');\n    26\t  const inTree = !!text && tree.some(n => (n.role === 'StaticText' || n.role === 'status') && n.name.includes(text));\n    27\t  return { text, visible, insideFigure, inTree };\n    28\t}\n    29\t\n    30\tdescribe('F12 values left out', () => {\n    31\t  for (const type of FULL as Full[]) {\n    32\t    for (const build of ['development', 'production'] as const) {\n    33\t      it(`F12 ${type}: the dirty fixture shows \"${notShown(DIRTY.leftOut)}\" inside the figure and in the accessibility tree (${build} build)`, async () => {\n    34\t        const page = build === 'development' ? await devPage() : await prodPage();\n    35\t        const built = await create(page, type, {}, '#chart', 'dirty');\n    36\t        // Thu (NaN, AX103), Fri ('40', AX106) and Sat (absent, AX102) are left out; Wed (null) is a silent gap.\n    37\t        expect(built.diagnostics.filter(d => d.level === 'warning').map(d => d.code).sort()).toEqual(['AX102', 'AX103', 'AX106']);\n    38\t        const note = await noteState(page);\n    39\t        expect(note.visible).toBe(true);\n    40\t        expect(note.text).toBe(notShown(DIRTY.leftOut));\n    41\t        expect(note.insideFigure).toBe(true);\n    42\t        expect(note.inTree).toBe(true);\n    43\t        expect(await closePage(page)).toEqual([]);\n    44\t      });\n    45\t    }\n    46\t\n    47\t    it(`F12 ${type}: one value left out reads correctly for a count of one, and clean data shows no note`, async () => {\n    48\t      const page = await devPage();\n    49\t      await create(page, type);\n    50\t      expect((await noteState(page)).visible).toBe(false);\n    51\t      await page.close();\n    52\t      const second = await devPage();\n    53\t      const data = type === 'donut' ? [{ item: 'Rent', spend: 1200 }, { item: 'Food', spend: '__NaN__' }, { item: 'Travel', spend: 360 }]\n    54\t        : type === 'scatter' ? [{ size: 1, latency: 3, region: 'EU' }, { size: 2, latency: '__NaN__', region: 'EU' }, { size: 3, latency: 5, region: 'EU' }]\n    55\t          : type === 'bar' ? [{ quarter: 'Q1', kind: 'Plan', shipped: 1 }, { quarter: 'Q2', kind: 'Plan', shipped: '__NaN__' }, { quarter: 'Q3', kind: 'Plan', shipped: 3 }]\n    56\t            : [{ day: '2026-03-02', site: 'North', energy: 1 }, { day: '2026-03-03', site: 'North', energy: '__NaN__' }, { day: '2026-03-04', site: 'North', energy: 3 }];\n    57\t      await create(second, type, { data });\n    58\t      const note = await noteState(second);\n    59\t      expect(note.text).toBe(notShown(1));\n    60\t      expect(note.inTree).toBe(true);\n    61\t      expect(await closePage(second)).toEqual([]);\n    62\t    });\n    63\t  }\n    64\t});\n    65\t\n    66\tdescribe('F12 values changed', () => {\n    67\t  for (const type of FULL as Full[]) {\n    68\t    for (const build of ['development', 'production'] as const) {\n    69\t      it(`F12 ${type}: a readout formatter that throws for one value (AX160) shows a note inside the figure and in the accessibility tree once a reader surface formats that value (reading: the default format in place of the author's is a changed value) (${build} build)`, async () => {\n    70\t        const page = build === 'development' ? await devPage() : await prodPage();\n    71\t        await page.evaluate(async type => {\n    72\t          const A = (window as unknown as { Axylo: Record<string, (t: string, o: unknown) => unknown> }).Axylo;\n    73\t          const format = (v: number) => { if (v === 15 || v === 600 || v === 140 || v === 47) throw new Error('no'); return `${v} units`; };\n    74\t          const opts: Record<string, Record<string, unknown>> = {\n    75\t            line: { title: 'T', data: [12, 15, 11].map((v, i) => ({ d: `2026-03-0${i + 2}`, v })), x: { field: 'd', type: 'date' }, y: { field: 'v', format } },\n    76\t            area: { title: 'T', data: [12, 15, 11].map((v, i) => ({ d: `2026-03-0${i + 2}`, v })), x: { field: 'd', type: 'date' }, y: { field: 'v', format } },\n    77\t            bar: { title: 'T', data: [45, 47, 50].map((v, i) => ({ q: `Q${i + 1}`, v })), x: 'q', y: { field: 'v', format } },\n    78\t            scatter: { title: 'T', data: [120, 140, 135].map((v, i) => ({ x: i + 1, v })), x: 'x', y: { field: 'v', format } },\n    79\t            donut: { title: 'T', data: [1200, 600, 360].map((v, i) => ({ l: `S${i}`, v })), label: 'l', value: { field: 'v', format } },\n    80\t          };\n    81\t          const chart = A[type]!('#chart', opts[type]) as { __bench?: { ready(): Promise<void> } };\n    82\t          (window as unknown as { charts: unknown[] }).charts.push(chart);\n    83\t          if (chart.__bench) await chart.__bench.ready();\n    84\t          for (let i = 0; i < 3; i++) await new Promise(r => requestAnimationFrame(r));\n    85\t        }, type);\n    86\t        // Make every reader surface format every value: the summary is built at once; open the table too.\n    87\t        await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n    88\t        await settle(page);\n    89\t        // The note follows on a later frame (the formatter fails while the table page is built); the\n    90\t        // production handle has no `ready`, so wait for the note, then assert on it.\n    91\t        await page.waitForFunction(() => document.querySelector<HTMLElement>('#chart .axylo-note')?.hidden === false, null, { timeout: 5000 }).catch(() => undefined);\n    92\t        const note = await noteState(page);\n    93\t        expect(note, JSON.stringify(note)).toMatchObject({ visible: true, insideFigure: true, inTree: true });\n    94\t        expect(note.text).toMatch(/\\b1\\b/);\n    95\t        expect(note.text).toMatch(/table/i);\n    96\t        expect(await closePage(page)).toEqual([]);\n    97\t      });\n    98\t    }\n    99\t  }\n   100\t\n   101\t  it('F12 donut: more than eight slices are grouped into \"Other (n)\" (AX121) and the note says values are shown differently, in the figure and the accessibility tree', async () => {\n   102\t    const page = await devPage();\n   103\t    const values = [30, 20, 15, 10, 8, 6, 5, 4, 3, 2];\n   104\t    const built = await create(page, 'donut', { data: values.map((v, i) => ({ item: `S${i + 1}`, spend: v })) });\n   105\t    expect(built.diagnostics.map(d => d.code)).toContain('AX121');\n   106\t    const note = await noteState(page);\n   107\t    expect(note.visible).toBe(true);\n   108\t    // Three slices (S8–S10) are not drawn as given.\n   109\t    expect(note.text).toMatch(/\\b3\\b/);\n   110\t    expect(note.text).toMatch(/table/i);\n   111\t    expect(note.inTree).toBe(true);\n   112\t    expect(await closePage(page)).toEqual([]);\n   113\t  });\n   114\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/acceptance/util.ts && nl -ba packages/axylo/test/browser/a11y/util.ts'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/acceptance/util.ts && nl -ba packages/axylo/test/browser/a11y/util.ts'","aggregated_output":"     1\t/**\n     2\t * Shared setup for the browser acceptance suite. Pages come from the existing harness (development\n     3\t * bundle, `chartPage`) or from `prod.html` in this directory (the minified production bundle). Charts are\n     4\t * created through the public API with the hand-written fixtures in `fixtures.ts`; the accessibility tree is\n     5\t * read from Chrome itself through the DevTools protocol (roles, names, descriptions, states), never from the\n     6\t * attributes the code sets, except where a comment says Chrome cannot report the property.\n     7\t */\n     8\timport type { Page } from 'playwright-core';\n     9\timport { openPage, url } from '../harness';\n    10\timport { chartPage, RENDERER } from '../chart/util';\n    11\timport { decodePng, type Image } from '../render/png';\n    12\timport { type ChartType, optionsFor, type Variant } from './fixtures';\n    13\t\n    14\texport { closePage, at, diff, shot } from '../chart/util';\n    15\texport type { Image };\n    16\t\n    17\t/** The two elements around every chart, so the tab order can be walked from and to the page. */\n    18\texport const SHOW_BUTTONS = '#before, #after { display: inline-block !important; }';\n    19\t\n    20\texport interface Built {\n    21\t  diagnostics: { code: string; level: string; message: string }[];\n    22\t}\n    23\t\n    24\t/** Development bundle page (`window.Axylo` from dist/axylo.iife.js), with `#before`, `#chart`, `#after`. */\n    25\texport async function devPage(options: Parameters<typeof chartPage>[0] = {}): Promise<Page> {\n    26\t  return chartPage({ ...options, css: `${SHOW_BUTTONS} ${options.css ?? ''}` });\n    27\t}\n    28\t\n    29\t/** Runs in the page: the same renderer switch chart/util.ts applies, for the production page. */\n    30\tfunction selectRenderer(renderer: string): void {\n    31\t  const original = (window as unknown as { Axylo: Record<string, unknown> }).Axylo;\n    32\t  const wrapped: Record<string, unknown> = { ...original };\n    33\t  for (const name of ['line', 'area', 'bar', 'scatter', 'donut']) {\n    34\t    const make = original[name] as (target: unknown, options: Record<string, unknown>) => unknown;\n    35\t    wrapped[name] = (target: unknown, options: Record<string, unknown>) => make(target, { __renderer: renderer, ...options });\n    36\t  }\n    37\t  (window as unknown as { Axylo: unknown }).Axylo = wrapped;\n    38\t}\n    39\t\n    40\t/** Production bundle page (dist/axylo.iife.min.js, `__DEV__` false): no test hooks on the handle. */\n    41\texport async function prodPage(options: { css?: string; viewport?: { width: number; height: number } } = {}): Promise<Page> {\n    42\t  const page = await openPage(options.viewport ? { viewport: options.viewport } : {});\n    43\t  await page.goto(url('packages/axylo/test/browser/acceptance/prod.html'));\n    44\t  if (RENDERER) await page.evaluate(selectRenderer, RENDERER);\n    45\t  await page.addStyleTag({ content: `${SHOW_BUTTONS} ${options.css ?? ''}` });\n    46\t  return page;\n    47\t}\n    48\t\n    49\t/**\n    50\t * Creates a chart from the fixture of `type` (with `extra` merged over its options) in `target` and waits\n    51\t * until it has drawn. Works on both pages: in production there is no `__bench.ready`, so it waits for\n    52\t * frames until the figure exists.\n    53\t */\n    54\texport async function create(page: Page, type: ChartType, extra: Record<string, unknown> = {}, target = '#chart', variant: Variant = 'default'): Promise<Built> {\n    55\t  const { fn, options } = optionsFor(type, variant);\n    56\t  return createRaw(page, fn, { ...options, ...extra }, target);\n    57\t}\n    58\t\n    59\t/** Creates a chart with options given in full. */\n    60\texport async function createRaw(page: Page, fn: string, options: Record<string, unknown>, target = '#chart'): Promise<Built> {\n    61\t  return page.evaluate(async ({ fn, options, target }) => {\n    62\t    const w = window as unknown as {\n    63\t      Axylo: Record<string, (t: unknown, o: unknown) => { diagnostics: Built['diagnostics']; __bench?: { ready(): Promise<void> } }>;\n    64\t      charts: unknown[];\n    65\t    };\n    66\t    w.charts ??= [];\n    67\t    // NaN does not survive the trip into the page as JSON; fixtures write it as '__NaN__'.\n    68\t    const rows = (options as { data?: unknown }).data;\n    69\t    if (Array.isArray(rows)) for (const row of rows) for (const k of Object.keys(row)) if (row[k] === '__NaN__') row[k] = NaN;\n    70\t    const chart = w.Axylo[fn]!(target, options);\n    71\t    w.charts.push(chart);\n    72\t    const frame = () => new Promise(r => requestAnimationFrame(r));\n    73\t    if (chart.__bench) await chart.__bench.ready();\n    74\t    for (let i = 0; i < 3; i++) await frame();\n    75\t    return { diagnostics: chart.diagnostics.map(d => ({ code: d.code, level: d.level, message: d.message })) };\n    76\t  }, { fn, options, target });\n    77\t}\n    78\t\n    79\t/** Waits for every chart on the page to draw what it was last given, then one more frame. */\n    80\texport async function settle(page: Page): Promise<void> {\n    81\t  await page.evaluate(async () => {\n    82\t    const charts = (window as unknown as { charts: { __bench?: { ready(): Promise<void> } }[] }).charts ?? [];\n    83\t    for (const c of charts) if (c.__bench) await c.__bench.ready();\n    84\t    for (let i = 0; i < 2; i++) await new Promise(r => requestAnimationFrame(r));\n    85\t  });\n    86\t}\n    87\t\n    88\t/** Calls a method on chart `index` in the page (`update`, `zoom`, `append`) and waits for it to draw. */\n    89\texport async function call(page: Page, method: 'update' | 'zoom' | 'append', args: unknown[], index = 0): Promise<void> {\n    90\t  await page.evaluate(({ method, args, index }) => {\n    91\t    const charts = (window as unknown as { charts: Record<string, (...a: unknown[]) => void>[] }).charts;\n    92\t    charts[index]![method]!(...args);\n    93\t  }, { method, args, index });\n    94\t  await settle(page);\n    95\t}\n    96\t\n    97\t// ── accessibility tree (Chrome's own, through the DevTools protocol) ───────────────────────────────\n    98\t\n    99\texport interface AX {\n   100\t  id: string;\n   101\t  role: string;\n   102\t  name: string;\n   103\t  description: string;\n   104\t  value: string;\n   105\t  ignored: boolean;\n   106\t  props: Record<string, unknown>;\n   107\t  children: string[];\n   108\t  backend: number | null;\n   109\t}\n   110\t\n   111\tinterface RawAX {\n   112\t  nodeId: string; ignored: boolean; role?: { value?: unknown }; name?: { value?: unknown }; description?: { value?: unknown };\n   113\t  value?: { value?: unknown }; properties?: { name: string; value: { value?: unknown } }[]; childIds?: string[]; backendDOMNodeId?: number;\n   114\t}\n   115\t\n   116\tfunction toAX(n: RawAX): AX {\n   117\t  const props: Record<string, unknown> = {};\n   118\t  for (const p of n.properties ?? []) props[p.name] = p.value?.value;\n   119\t  return {\n   120\t    id: n.nodeId, role: String(n.role?.value ?? ''), name: String(n.name?.value ?? ''), description: String(n.description?.value ?? ''),\n   121\t    value: String(n.value?.value ?? ''), ignored: n.ignored, props, children: n.childIds ?? [], backend: n.backendDOMNodeId ?? null,\n   122\t  };\n   123\t}\n   124\t\n   125\tasync function backendOf(page: Page, selector: string): Promise<number> {\n   126\t  const client = await page.context().newCDPSession(page);\n   127\t  try {\n   128\t    const { root } = await client.send('DOM.getDocument', { depth: 0 });\n   129\t    const { nodeId } = await client.send('DOM.querySelector', { nodeId: root.nodeId, selector });\n   130\t    if (!nodeId) throw new Error(`no element for ${selector}`);\n   131\t    const { node } = await client.send('DOM.describeNode', { nodeId });\n   132\t    return node.backendNodeId;\n   133\t  } finally {\n   134\t    await client.detach();\n   135\t  }\n   136\t}\n   137\t\n   138\t/** Chrome's accessibility node for the first element matching `selector`. */\n   139\texport async function axOf(page: Page, selector: string): Promise<AX> {\n   140\t  const backend = await backendOf(page, selector);\n   141\t  const client = await page.context().newCDPSession(page);\n   142\t  try {\n   143\t    const { nodes } = await client.send('Accessibility.getPartialAXTree', { backendNodeId: backend, fetchRelatives: false });\n   144\t    return toAX(nodes[0] as RawAX);\n   145\t  } finally {\n   146\t    await client.detach();\n   147\t  }\n   148\t}\n   149\t\n   150\t/**\n   151\t * The accessibility nodes inside the element matching `selector` (the element's own node first), in tree\n   152\t * order, without ignored nodes: what an assistive technology can reach there.\n   153\t */\n   154\texport async function axWithin(page: Page, selector = '#chart'): Promise<AX[]> {\n   155\t  const backend = await backendOf(page, selector);\n   156\t  const client = await page.context().newCDPSession(page);\n   157\t  try {\n   158\t    const { nodes } = await client.send('Accessibility.getFullAXTree');\n   159\t    const all = new Map((nodes as RawAX[]).map(n => [n.nodeId, toAX(n)]));\n   160\t    const start = [...all.values()].find(n => n.backend === backend);\n   161\t    if (!start) return [];\n   162\t    const out: AX[] = [];\n   163\t    const visit = (id: string) => {\n   164\t      const n = all.get(id);\n   165\t      if (!n) return;\n   166\t      if (!n.ignored) out.push(n);\n   167\t      for (const c of n.children) visit(c);\n   168\t    };\n   169\t    visit(start.id);\n   170\t    return out;\n   171\t  } finally {\n   172\t    await client.detach();\n   173\t  }\n   174\t}\n   175\t\n   176\t/** The text an assistive technology finds inside `selector`: names and static text of unignored nodes. */\n   177\texport async function axText(page: Page, selector = '#chart'): Promise<string> {\n   178\t  const nodes = await axWithin(page, selector);\n   179\t  return nodes.filter(n => n.role === 'StaticText').map(n => n.name).join(' • ');\n   180\t}\n   181\t\n   182\t/**\n   183\t * The plot proxy's value text. Chrome's DevTools tree reports the range's number, not `aria-valuetext`\n   184\t * (decision 0001), so this reads the attribute the platform tree is built from.\n   185\t */\n   186\texport async function valueText(page: Page, selector = '#chart'): Promise<string> {\n   187\t  return (await page.locator(`${selector} .axylo-proxy`).getAttribute('aria-valuetext')) ?? '';\n   188\t}\n   189\t\n   190\t// ── focus and tab order ────────────────────────────────────────────────────────────────────────────\n   191\t\n   192\t/** What has focus: 'proxy', 'toolbar:<label>', 'table', 'before', 'after', 'body' or tag.class. */\n   193\texport async function focused(page: Page): Promise<string> {\n   194\t  return page.evaluate(() => {\n   195\t    const el = document.activeElement as HTMLElement | null;\n   196\t    if (!el || el === document.body) return 'body';\n   197\t    if (el.id === 'before' || el.id === 'after') return el.id;\n   198\t    if (el.classList.contains('axylo-proxy')) return 'proxy';\n   199\t    if (el.closest('.axylo-toolbar')) return 'toolbar:' + (el.textContent ?? '');\n   200\t    if (el.classList.contains('axylo-table-scroll')) return 'table';\n   201\t    return el.tagName.toLowerCase() + '.' + el.className;\n   202\t  });\n   203\t}\n   204\t\n   205\t/** Presses Tab (or Shift+Tab) from #before (or #after) until focus leaves the chart; lists every stop. */\n   206\texport async function tabStops(page: Page, backwards = false): Promise<string[]> {\n   207\t  await page.focus(backwards ? '#after' : '#before');\n   208\t  const stops: string[] = [];\n   209\t  for (let i = 0; i < 16; i++) {\n   210\t    await page.keyboard.press(backwards ? 'Shift+Tab' : 'Tab');\n   211\t    const at = await focused(page);\n   212\t    stops.push(at);\n   213\t    if (at === 'before' || at === 'after' || at === 'body') break;\n   214\t  }\n   215\t  return stops;\n   216\t}\n   217\t\n   218\t// ── geometry ───────────────────────────────────────────────────────────────────────────────────────\n   219\t\n   220\texport interface Box { x: number; y: number; width: number; height: number }\n   221\t\n   222\texport async function box(page: Page, selector: string): Promise<Box> {\n   223\t  const b = await page.locator(selector).first().boundingBox();\n   224\t  if (!b) throw new Error(`no box for ${selector}`);\n   225\t  return b;\n   226\t}\n   227\t\n   228\t/** The plot area in viewport px (the keyboard proxy covers exactly it) and the drawn domains (dev only). */\n   229\texport async function plotGeometry(page: Page, index = 0, selector = '#chart'): Promise<{ plot: Box; xDomain: number[] | null; yDomain: number[] | null }> {\n   230\t  return page.evaluate(({ index, selector }) => {\n   231\t    const r = document.querySelector(`${selector} .axylo-proxy`)!.getBoundingClientRect();\n   232\t    const charts = (window as unknown as { charts: { __bench: { describe(): { xDomain: number[] | null; yDomain: number[] | null } } }[] }).charts;\n   233\t    const { xDomain, yDomain } = charts[index]!.__bench.describe();\n   234\t    return { plot: { x: r.x, y: r.y, width: r.width, height: r.height }, xDomain, yDomain };\n   235\t  }, { index, selector });\n   236\t}\n   237\t\n   238\texport const intersects = (a: Box, b: Box, slack = 0): boolean =>\n   239\t  a.x < b.x + b.width - slack && b.x < a.x + a.width - slack && a.y < b.y + b.height - slack && b.y < a.y + a.height - slack;\n   240\t\n   241\texport const inside = (inner: Box, outer: Box, slack = 1): boolean =>\n   242\t  inner.x >= outer.x - slack && inner.y >= outer.y - slack && inner.x + inner.width <= outer.x + outer.width + slack && inner.y + inner.height <= outer.y + outer.height + slack;\n   243\t\n   244\t// ── pixels and colour ──────────────────────────────────────────────────────────────────────────────\n   245\t\n   246\texport async function screenshot(page: Page, selector: string): Promise<{ img: Image; box: Box }> {\n   247\t  const b = await box(page, selector);\n   248\t  const img = decodePng(await page.screenshot({ clip: b, animations: 'disabled', caret: 'hide' }));\n   249\t  return { img, box: b };\n   250\t}\n   251\t\n   252\texport type RGB = readonly [number, number, number];\n   253\t\n   254\t/** Resolves any CSS colour the page understands to sRGB bytes, in the page. */\n   255\texport async function resolveColors(page: Page, colors: readonly string[]): Promise<RGB[]> {\n   256\t  return page.evaluate(colors => colors.map(c => {\n   257\t    const ctx = document.createElement('canvas').getContext('2d')!;\n   258\t    ctx.fillStyle = '#000';\n   259\t    ctx.fillStyle = c;\n   260\t    ctx.fillRect(0, 0, 1, 1);\n   261\t    const d = ctx.getImageData(0, 0, 1, 1).data;\n   262\t    return [d[0]!, d[1]!, d[2]!] as const;\n   263\t  }), colors as string[]) as Promise<RGB[]>;\n   264\t}\n   265\t\n   266\t/** WCAG 2.x relative luminance and contrast. */\n   267\texport function luminance([r, g, b]: RGB): number {\n   268\t  const f = (v: number) => { const s = v / 255; return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4; };\n   269\t  return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b);\n   270\t}\n   271\texport function contrast(a: RGB, b: RGB): number {\n   272\t  const [x, y] = [luminance(a), luminance(b)];\n   273\t  return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05);\n   274\t}\n   275\t\n   276\t/** The colour the marks are painted with, resolved in the page from the rendered SVG element's `color`. */\n   277\texport async function seriesColors(page: Page, selector = '#chart'): Promise<RGB[]> {\n   278\t  const css = await page.evaluate(selector => {\n   279\t    const seen = new Map<number, string>();\n   280\t    for (const el of document.querySelectorAll<SVGElement>(`${selector} svg.axylo-svg .axylo-scene *`)) {\n   281\t      const m = /--axylo-series-color-(\\d+)/.exec(el.style.getPropertyValue('color'));\n   282\t      if (m && !seen.has(Number(m[1]))) seen.set(Number(m[1]), getComputedStyle(el).color);\n   283\t    }\n   284\t    return [...seen.entries()].sort((a, b) => a[0] - b[0]).map(e => e[1]);\n   285\t  }, selector);\n   286\t  return resolveColors(page, css);\n   287\t}\n   288\t\n   289\t/**\n   290\t * The colour painted behind the marks: the chart's own background rect when it is opaque (an author's\n   291\t * `--axylo-background`), else the nearest ancestor background, else the canvas white.\n   292\t */\n   293\texport async function backgroundColor(page: Page, selector = '#chart'): Promise<RGB> {\n   294\t  const css = await page.evaluate(selector => {\n   295\t    const opaque = (c: string) => !!c && c !== 'transparent' && !/rgba\\(.*,\\s*0\\)$/.test(c);\n   296\t    const rect = document.querySelector(`${selector} svg.axylo-svg .axylo-background`) as SVGElement | null;\n   297\t    if (rect) {\n   298\t      // The background rect is painted through `color` and currentColor, like every mark (render/svg.ts).\n   299\t      const s = getComputedStyle(rect);\n   300\t      if (opaque(s.color)) return s.color;\n   301\t    }\n   302\t    let el: Element | null = document.querySelector(selector);\n   303\t    while (el) {\n   304\t      const c = getComputedStyle(el).backgroundColor;\n   305\t      if (opaque(c)) return c;\n   306\t      el = el.parentElement;\n   307\t    }\n   308\t    return 'rgb(255, 255, 255)';\n   309\t  }, selector);\n   310\t  return (await resolveColors(page, [css]))[0]!;\n   311\t}\n   312\t\n   313\t/**\n   314\t * The default background of the scheme the chart resolved: `--axylo-default-background` as the marks\n   315\t * inherit it (read on the mark layer, wherever the library puts the scheme switch).\n   316\t */\n   317\texport async function defaultBackground(page: Page, selector = '#chart'): Promise<RGB> {\n   318\t  const css = await page.evaluate(selector => {\n   319\t    const at = document.querySelector(`${selector} svg.axylo-svg`) ?? document.querySelector(`${selector} figure`) ?? document.querySelector(selector)!;\n   320\t    return getComputedStyle(at).getPropertyValue('--axylo-default-background').trim();\n   321\t  }, selector);\n   322\t  return (await resolveColors(page, [css]))[0]!;\n   323\t}\n   324\t\n   325\texport function pixel(img: Image, x: number, y: number): RGB {\n   326\t  const o = (Math.floor(y) * img.width + Math.floor(x)) * 4;\n   327\t  return [img.data[o]!, img.data[o + 1]!, img.data[o + 2]!];\n   328\t}\n   329\t\n   330\texport const distance = (a: RGB, b: RGB): number => Math.max(Math.abs(a[0] - b[0]), Math.abs(a[1] - b[1]), Math.abs(a[2] - b[2]));\n   331\t\n   332\t/** Pixels within `tolerance` of `color` in a region of `img`. */\n   333\texport function countColor(img: Image, color: RGB, tolerance = 30, region?: { x0: number; y0: number; x1: number; y1: number }): number {\n   334\t  const { x0 = 0, y0 = 0, x1 = img.width, y1 = img.height } = region ?? {};\n   335\t  let n = 0;\n   336\t  for (let y = Math.max(0, Math.floor(y0)); y < Math.min(img.height, y1); y++) {\n   337\t    for (let x = Math.max(0, Math.floor(x0)); x < Math.min(img.width, x1); x++) if (distance(pixel(img, x, y), color) <= tolerance) n++;\n   338\t  }\n   339\t  return n;\n   340\t}\n   341\t\n   342\t// ── marks as drawn (SVG renderer), to locate a datum on screen ─────────────────────────────────────\n   343\t\n   344\texport interface Shape {\n   345\t  /** Viewport box of one closed subpath or rect. */\n   346\t  box: Box;\n   347\t  /** The command letters of the subpath (\"MAAZ\" for a circle, \"MLLLZ\" for a square). */\n   348\t  commands: string;\n   349\t  /** The subpath's own path data ('rect' for a rect), for `signature`. */\n   350\t  sub: string;\n   351\t}\n   352\t\n   353\t/**\n   354\t * A shape's identity independent of size and position: its commands and its vertices scaled to the larger\n   355\t * side of its box, rounded. A circle, a square, a diamond and a triangle each give a different signature.\n   356\t */\n   357\texport function signature(sub: string): string {\n   358\t  if (sub === 'rect') return 'rect';\n   359\t  // Arcs: a round marker, whatever points its path happens to pass through.\n   360\t  if (/A/i.test(sub)) return 'round';\n   361\t  const tokens = sub.match(/[MLAZHV]|-?\\d*\\.?\\d+(?:e-?\\d+)?/gi) ?? [];\n   362\t  const pts: [number, number][] = [];\n   363\t  let cmds = '';\n   364\t  let cmd = '';\n   365\t  for (let i = 0; i < tokens.length;) {\n   366\t    const t = tokens[i]!;\n   367\t    if (/^[A-Za-z]$/.test(t)) { cmd = t.toUpperCase(); cmds += cmd; i++; continue; }\n   368\t    if (cmd === 'A') { pts.push([Number(tokens[i + 5]), Number(tokens[i + 6])]); i += 7; }\n   369\t    else if (cmd === 'M' || cmd === 'L') { pts.push([Number(tokens[i]), Number(tokens[i + 1])]); i += 2; }\n   370\t    else i++;\n   371\t  }\n   372\t  const x0 = Math.min(...pts.map(p => p[0])), y0 = Math.min(...pts.map(p => p[1]));\n   373\t  const size = Math.max(Math.max(...pts.map(p => p[0])) - x0, Math.max(...pts.map(p => p[1])) - y0) || 1;\n   374\t  // Sorted and unique, so where a shape's path starts does not matter.\n   375\t  const vertices = [...new Set(pts.map(([x, y]) => `${Math.round(4 * (x - x0) / size)},${Math.round(4 * (y - y0) / size)}`))].sort();\n   376\t  return cmds.replace(/Z/g, '').replace(/L+/g, 'L').replace(/A+/g, 'A') + ':' + vertices.join(' ');\n   377\t}\n   378\t\n   379\t/**\n   380\t * Per series colour slot (1-based, from `--axylo-series-color-N`), the small closed shapes drawn in that\n   381\t * colour: markers on lines and areas, scatter points, bar rects. Shapes larger than `maxSize` px (an area's\n   382\t * fill, a line's stroke) are left out.\n   383\t */\n   384\texport async function shapes(page: Page, selector = '#chart', maxSize = 20): Promise<Record<number, Shape[]>> {\n   385\t  return page.evaluate(({ selector, maxSize }) => {\n   386\t    const svg = document.querySelector(`${selector} svg.axylo-svg`) as SVGSVGElement | null;\n   387\t    const out: Record<number, { box: { x: number; y: number; width: number; height: number }; commands: string; sub: string }[]> = {};\n   388\t    if (!svg) return out;\n   389\t    const origin = svg.getBoundingClientRect();\n   390\t    const matrix = svg.getScreenCTM();\n   391\t    const toPage = (x: number, y: number) => {\n   392\t      if (!matrix) return { x: origin.x + x, y: origin.y + y };\n   393\t      const p = new DOMPoint(x, y).matrixTransform(matrix);\n   394\t      return { x: p.x, y: p.y };\n   395\t    };\n   396\t    const slotOf = (el: Element | null): number | null => {\n   397\t      for (let e = el; e && e !== svg; e = e.parentElement) {\n   398\t        const m = /--axylo-series-color-(\\d+)/.exec((e as SVGElement).style?.getPropertyValue('color') ?? '');\n   399\t        if (m) return Number(m[1]);\n   400\t      }\n   401\t      return null;\n   402\t    };\n   403\t    for (const el of svg.querySelectorAll('.axylo-scene path, .axylo-scene rect')) {\n   404\t      const slot = slotOf(el);\n   405\t      if (slot === null) continue;\n   406\t      const list = (out[slot] ??= []);\n   407\t      if (el.tagName.toLowerCase() === 'rect') {\n   408\t        const r = el as SVGRectElement;\n   409\t        const a = toPage(r.x.baseVal.value, r.y.baseVal.value);\n   410\t        const b = toPage(r.x.baseVal.value + r.width.baseVal.value, r.y.baseVal.value + r.height.baseVal.value);\n   411\t        list.push({ box: { x: a.x, y: a.y, width: b.x - a.x, height: b.y - a.y }, commands: 'rect', sub: 'rect' });\n   412\t        continue;\n   413\t      }\n   414\t      const d = el.getAttribute('d') ?? '';\n   415\t      for (const sub of d.split(/(?=M)/)) {\n   416\t        const tokens = sub.match(/[MLAZHV]|-?\\d*\\.?\\d+(?:e-?\\d+)?/gi) ?? [];\n   417\t        let commands = '';\n   418\t        const xs: number[] = [];\n   419\t        const ys: number[] = [];\n   420\t        let cmd = '';\n   421\t        for (let i = 0; i < tokens.length;) {\n   422\t          const t = tokens[i]!;\n   423\t          if (/^[A-Za-z]$/.test(t)) { cmd = t.toUpperCase(); commands += cmd; i++; if (cmd === 'Z') continue; }\n   424\t          if (cmd === 'A') { xs.push(Number(tokens[i + 5])); ys.push(Number(tokens[i + 6])); i += 7; }\n   425\t          else if (cmd === 'M' || cmd === 'L') { xs.push(Number(tokens[i])); ys.push(Number(tokens[i + 1])); i += 2; }\n   426\t          else i++;\n   427\t        }\n   428\t        if (!xs.length) continue;\n   429\t        const x0 = Math.min(...xs), x1 = Math.max(...xs), y0 = Math.min(...ys), y1 = Math.max(...ys);\n   430\t        const a = toPage(x0, y0);\n   431\t        const b = toPage(x1, y1);\n   432\t        const w = b.x - a.x, h = b.y - a.y;\n   433\t        if (w > maxSize || h > maxSize) continue;\n   434\t        // A circle's subpath records only the two ends of a horizontal diameter: widen it to the disc.\n   435\t        const round = commands.includes('A') && h < w / 2;\n   436\t        list.push({ box: round ? { x: a.x, y: a.y - w / 2, width: w, height: w } : { x: a.x, y: a.y, width: w, height: h }, commands, sub });\n   437\t      }\n   438\t    }\n   439\t    return out;\n   440\t  }, { selector, maxSize });\n   441\t}\n   442\t\n   443\texport const center = (b: Box): { x: number; y: number } => ({ x: b.x + b.width / 2, y: b.y + b.height / 2 });\n   444\t\n   445\t/** A donut's ring in viewport px: centre and outer radius, from the union of the drawn slices' boxes. */\n   446\texport async function ring(page: Page, selector = '#chart'): Promise<{ cx: number; cy: number; outer: number }> {\n   447\t  return page.evaluate(selector => {\n   448\t    const svg = document.querySelector(`${selector} svg.axylo-svg`) as SVGSVGElement;\n   449\t    const m = svg.getScreenCTM()!;\n   450\t    let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;\n   451\t    for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) {\n   452\t      if (!/--axylo-series-color-/.test(el.style.getPropertyValue('color'))) continue;\n   453\t      const b = el.getBBox();\n   454\t      const a = new DOMPoint(b.x, b.y).matrixTransform(m), c = new DOMPoint(b.x + b.width, b.y + b.height).matrixTransform(m);\n   455\t      x0 = Math.min(x0, a.x); y0 = Math.min(y0, a.y); x1 = Math.max(x1, c.x); y1 = Math.max(y1, c.y);\n   456\t    }\n   457\t    return { cx: (x0 + x1) / 2, cy: (y0 + y1) / 2, outer: (x1 - x0) / 2 };\n   458\t  }, selector);\n   459\t}\n     1\t/**\n     2\t * Shared setup for the accessibility and interaction tests: the fixture charts by name, Chrome's own\n     3\t * accessibility node for an element (through the DevTools protocol, so value text and role description are\n     4\t * what Chrome exposes, not a re-computation), axe-core, and the tab order.\n     5\t */\n     6\timport type { Page } from 'playwright-core';\n     7\timport path from 'node:path';\n     8\timport fs from 'node:fs';\n     9\timport { chartPage } from '../chart/util';\n    10\t\n    11\texport type FixtureName = 'trend' | 'bars' | 'parts' | 'scatter' | 'stacked' | 'dirty' | 'empty' | 'loading' | 'error' | 'compact';\n    12\texport const FIXTURES: readonly FixtureName[] = ['trend', 'bars', 'parts', 'scatter', 'stacked', 'dirty', 'empty', 'loading', 'error', 'compact'];\n    13\t\n    14\tdeclare global {\n    15\t  interface Window {\n    16\t    make(name: FixtureName, target: string | HTMLElement, extra?: Record<string, unknown>): import('../chart/util').ChartLike;\n    17\t  }\n    18\t}\n    19\t\n    20\t/** Runs in the page: builds a fixture chart. The trend fixture's x is UTC instants, as the Phase 1 harness has it. */\n    21\tfunction installMakers(): void {\n    22\t  const fx = window.fx;\n    23\t  const A = window.Axylo;\n    24\t  const trend = (extra: Record<string, unknown>) => ({\n    25\t    title: fx.trend.title, data: fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' },\n    26\t    y: { field: 'sessions', label: fx.trend.yTitle }, series: 'channel', ...extra,\n    27\t  });\n    28\t  window.make = (name, target, extra = {}) => {\n    29\t    switch (name) {\n    30\t      case 'trend': return A.line!(target, trend(extra));\n    31\t      case 'stacked': return A.area!(target, { ...trend(extra), title: 'Sessions, stacked', stacked: true });\n    32\t      case 'bars': return A.bar!(target, {\n    33\t        title: fx.bars.title, data: fx.bars.categories.map((team, i) => ({ team, satisfied: fx.bars.values[i] })),\n    34\t        x: 'team', y: { field: 'satisfied', label: 'Satisfied', scale: 'percent' }, reference: [{ y: 90, label: 'Target' }], ...extra,\n    35\t      });\n    36\t      case 'parts': return A.donut!(target, {\n    37\t        title: fx.parts.title, data: fx.parts.labels.map((browser, i) => ({ browser, share: fx.parts.values[i] })),\n    38\t        label: 'browser', value: { field: 'share', label: 'Share', scale: 'percent' }, ...extra,\n    39\t      });\n    40\t      case 'scatter': {\n    41\t        const r = fx.rng(3);\n    42\t        const data = Array.from({ length: 300 }, (_, i) => {\n    43\t          const size = 10 + r() * 990;\n    44\t          return { size: Math.round(size), latency: Math.round(20 + size * 0.08 + (r() - 0.5) * 40), region: ['EU', 'US', 'APAC'][i % 3] };\n    45\t        });\n    46\t        return A.scatter!(target, { title: 'Latency by payload size', data, x: { field: 'size', label: 'Payload', unit: 'kB' }, y: { field: 'latency', label: 'Latency', unit: 'ms' }, series: 'region', ...extra });\n    47\t      }\n    48\t      case 'dirty': return A.line!(target, { title: 'Dirty input', data: fx.dirtyRows(), x: 'day', y: 'value', ...extra });\n    49\t      case 'empty': return A.line!(target, { title: 'No rows returned', data: [], x: 'day', y: 'sessions', ...extra });\n    50\t      case 'loading': return A.line!(target, { title: 'Loading', state: 'loading', data: [], x: 'day', y: 'sessions', ...extra });\n    51\t      case 'error': return A.line!(target, { title: 'Failed', state: { error: 'The query failed.' }, data: [], x: 'day', y: 'sessions', ...extra });\n    52\t      case 'compact': return A.line!(target, { compact: true, title: 'Direct sessions', data: fx.trendRows().filter(r => r.channel === 'Direct'), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', ...extra });\n    53\t    }\n    54\t  };\n    55\t}\n    56\t\n    57\texport async function fixturePage(options: Parameters<typeof chartPage>[0] = {}): Promise<Page> {\n    58\t  const page = await chartPage(options);\n    59\t  await page.evaluate(installMakers);\n    60\t  return page;\n    61\t}\n    62\t\n    63\t/** Builds a fixture in #chart (or `target`) and waits for its first frame. */\n    64\texport async function make(page: Page, name: FixtureName, extra: Record<string, unknown> = {}, target = '#chart'): Promise<void> {\n    65\t  await page.evaluate(async ({ name, extra, target }) => {\n    66\t    const chart = window.make(name, target, extra);\n    67\t    window.charts.push(chart);\n    68\t    await chart.__bench.ready();\n    69\t    await window.nextFrames(1);\n    70\t  }, { name, extra, target });\n    71\t}\n    72\t\n    73\texport interface AxNode {\n    74\t  role: string;\n    75\t  name: string;\n    76\t  /** The range's value as Chrome exposes it (the ordinal). */\n    77\t  value: string;\n    78\t  max: number | null;\n    79\t  roledescription: string | null;\n    80\t  focused: boolean;\n    81\t  /**\n    82\t   * The value text. Chrome's DevTools accessibility view does not report `aria-valuetext` (its \"valuetext\"\n    83\t   * property shows the number, even for an ARIA slider), so this is the attribute the platform tree is built\n    84\t   * from; whether a screen reader speaks it can only be confirmed by rehearsal (decision 0001).\n    85\t   */\n    86\t  text: string;\n    87\t}\n    88\t\n    89\t/** Chrome's accessibility node for the first element matching `selector`. */\n    90\texport async function axNode(page: Page, selector: string): Promise<AxNode> {\n    91\t  const client = await page.context().newCDPSession(page);\n    92\t  try {\n    93\t    const { root } = await client.send('DOM.getDocument', { depth: 0 });\n    94\t    const { nodeId } = await client.send('DOM.querySelector', { nodeId: root.nodeId, selector });\n    95\t    if (!nodeId) throw new Error(`no element for ${selector}`);\n    96\t    const { node } = await client.send('DOM.describeNode', { nodeId });\n    97\t    const { nodes } = await client.send('Accessibility.getPartialAXTree', { backendNodeId: node.backendNodeId, fetchRelatives: false });\n    98\t    const ax = nodes[0]!;\n    99\t    const prop = (name: string) => ax.properties?.find(p => p.name === name)?.value?.value as unknown;\n   100\t    const roledescription = prop('roledescription');\n   101\t    const max = prop('valuemax');\n   102\t    return {\n   103\t      role: String(ax.role?.value ?? ''), name: String(ax.name?.value ?? ''), value: String(ax.value?.value ?? ''),\n   104\t      max: typeof max === 'number' ? max : null,\n   105\t      roledescription: roledescription === undefined ? null : String(roledescription), focused: prop('focused') === true,\n   106\t      text: (await page.locator(selector).first().getAttribute('aria-valuetext')) ?? '',\n   107\t    };\n   108\t  } finally {\n   109\t    await client.detach();\n   110\t  }\n   111\t}\n   112\t\n   113\tconst axeSource = fs.readFileSync(path.resolve(import.meta.dirname, '../../../../../node_modules/axe-core/axe.min.js'), 'utf8');\n   114\t\n   115\texport interface AxeViolation { id: string; impact: string | null; nodes: string[]; help: string }\n   116\t\n   117\t/** axe-core over `selector` (every rule axe enables by default, best practices such as heading-order included). */\n   118\texport async function axe(page: Page, selector = 'body'): Promise<{ violations: AxeViolation[]; ran: string[]; incomplete: string[] }> {\n   119\t  if (!(await page.evaluate(() => 'axe' in window))) await page.addScriptTag({ content: axeSource });\n   120\t  return page.evaluate(async selector => {\n   121\t    type Rule = { id: string; impact: string | null; help: string; nodes: { target: string[] }[] };\n   122\t    const run = (window as unknown as { axe: { run(context: unknown, options: unknown): Promise<{ violations: Rule[]; passes: Rule[]; incomplete: Rule[] }> } }).axe;\n   123\t    const result = await run.run(selector, { resultTypes: ['violations', 'passes', 'incomplete'] });\n   124\t    return {\n   125\t      violations: result.violations.map(v => ({ id: v.id, impact: v.impact, help: v.help, nodes: v.nodes.map(n => n.target.join(' ')) })),\n   126\t      // A rule axe could not decide is not a rule that ran (review 2, finding 21): it is reported apart.\n   127\t      ran: [...result.passes, ...result.violations].map(r => r.id),\n   128\t      incomplete: result.incomplete.map(r => r.id),\n   129\t    };\n   130\t  }, selector);\n   131\t}\n   132\t\n   133\t/** What has focus, as a short description: the chart part's class or the element's id. */\n   134\texport async function focused(page: Page): Promise<string> {\n   135\t  return page.evaluate(() => {\n   136\t    const el = document.activeElement as HTMLElement | null;\n   137\t    if (!el || el === document.body) return 'body';\n   138\t    if (el.id === 'before' || el.id === 'after') return el.id;\n   139\t    if (el.classList.contains('axylo-proxy')) return 'proxy';\n   140\t    if (el.closest('.axylo-toolbar')) return 'toolbar:' + (el.textContent ?? '');\n   141\t    if (el.classList.contains('axylo-table-scroll')) return 'table';\n   142\t    return el.tagName.toLowerCase() + '.' + el.className;\n   143\t  });\n   144\t}\n   145\t\n   146\t/** Presses Tab (or Shift+Tab) from `start` until focus leaves the chart, and lists the stops. */\n   147\texport async function tabStops(page: Page, backwards = false): Promise<string[]> {\n   148\t  await page.focus(backwards ? '#after' : '#before');\n   149\t  const stops: string[] = [];\n   150\t  for (let i = 0; i < 12; i++) {\n   151\t    await page.keyboard.press(backwards ? 'Shift+Tab' : 'Tab');\n   152\t    const at = await focused(page);\n   153\t    if (at === 'before' || at === 'after' || at === 'body') return [...stops, at];\n   154\t    stops.push(at);\n   155\t  }\n   156\t  return stops;\n   157\t}\n   158\t\n   159\t/** Text contrast per WCAG 2.x from two CSS colors resolved by the page. */\n   160\texport async function contrastOf(page: Page, selector: string): Promise<number> {\n   161\t  return page.evaluate(selector => {\n   162\t    const el = document.querySelector(selector) as HTMLElement;\n   163\t    const parse = (c: string) => {\n   164\t      const probe = document.createElement('canvas').getContext('2d')!;\n   165\t      probe.fillStyle = c;\n   166\t      probe.fillRect(0, 0, 1, 1);\n   167\t      const [r, g, b] = probe.getImageData(0, 0, 1, 1).data;\n   168\t      return [r!, g!, b!];\n   169\t    };\n   170\t    const lum = ([r, g, b]: number[]) => {\n   171\t      const f = (v: number) => { const s = v / 255; return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4; };\n   172\t      return 0.2126 * f(r!) + 0.7152 * f(g!) + 0.0722 * f(b!);\n   173\t    };\n   174\t    let bgEl: HTMLElement | null = el;\n   175\t    let bg = 'rgb(255, 255, 255)';\n   176\t    while (bgEl) {\n   177\t      const c = getComputedStyle(bgEl).backgroundColor;\n   178\t      if (c && c !== 'rgba(0, 0, 0, 0)' && c !== 'transparent') { bg = c; break; }\n   179\t      bgEl = bgEl.parentElement;\n   180\t    }\n   181\t    const fg = lum(parse(getComputedStyle(el).color));\n   182\t    const back = lum(parse(bg));\n   183\t    return (Math.max(fg, back) + 0.05) / (Math.min(fg, back) + 0.05);\n   184\t  }, selector);\n   185\t}\n","exit_code":0,"status":"completed"}}
