t')}`), sel);\n    85\t      const drawn = await scene('#chart');\n    86\t      expect(drawn.length).toBeGreaterThan(0);\n    87\t      expect(await scene('#other')).toEqual(drawn);\n    88\t      expect(await closePage(page)).toEqual([]);\n    89\t    });\n    90\t  }\n    91\t});\n    92\t\n    93\tdescribe('F2 bars', () => {\n    94\t  it('F2 bar: a missing bar shows a \"no data\" mark at the baseline, distinct from a zero bar and from an empty band', async () => {\n    95\t    const page = await devPage({ css: NO_GRID });\n    96\t    await createRaw(page, 'bar', { title: 'Missing and zero', data: [{ q: 'Q1', v: 10 }, { q: 'Q2', v: null }, { q: 'Q3', v: 0 }, { q: 'Q4', v: 20 }], x: 'q', y: 'v' });\n    97\t    const rects = ((await shapes(page, '#chart', 100000))[1] ?? []).map(s => s.box).filter(b => b.height > 2).sort((a, b) => a.x - b.x);\n    98\t    expect(rects).toHaveLength(2);\n    99\t    const c1 = rects[0]!.x + rects[0]!.width / 2, c4 = rects[1]!.x + rects[1]!.width / 2;\n   100\t    const step = (c4 - c1) / 3, half = rects[0]!.width / 2;\n   101\t    const baseline = rects[0]!.y + rects[0]!.height;\n   102\t    const patch = async (center: number) => {\n   103\t      const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n   104\t      const out: number[] = [];\n   105\t      for (let y = Math.round(baseline - plot.y - 14); y < baseline - plot.y - 1; y++) for (let x = Math.round(center - half - plot.x); x < center + half - plot.x; x++) out.push(...pixel(img, x, y));\n   106\t      return out;\n   107\t    };\n   108\t    const missing = await patch(c1 + step), zero = await patch(c1 + 2 * step);\n   109\t    const bg = await backgroundColor(page);\n   110\t    const ink = (p: number[]) => { let n = 0; for (let i = 0; i < p.length; i += 3) if (distance([p[i]!, p[i + 1]!, p[i + 2]!], bg) > 40) n++; return n; };\n237:Default styles are applied without injecting a `<style>` element, and a standalone stylesheet ships for pages that prefer