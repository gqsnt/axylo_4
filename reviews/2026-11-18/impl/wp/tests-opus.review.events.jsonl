{"type":"item.completed","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat tests/dist/node.test.ts && cat tests/dist/licence.test.ts && cat tests/dist/snippets.test.ts && cat tests/dist/side-effects.test.ts && cat tests/dist/vitest.config.ts && rg -n 'part|separator|compact|hover|200 %' docs/decisions/0004*\"","aggregated_output":"/**\n * Spec DX8, the Node half, from the packed files in child processes started inside the fixtures (so Node,\n * not Vitest's resolver, finds the packages, and no test-runner globals are present):\n * - importing `axylo` without DOM globals does not throw and adds no globals (the `sideEffects` claim);\n * - `validate()` runs there and reports the Phase 1 `dirty` fixture as spec 3.5 and plan 1.6 say;\n * - `@axylo/react` server-renders with react-dom/server.\n */\nimport { beforeAll, describe, expect, it } from 'vitest';\nimport { build } from 'esbuild';\nimport path from 'node:path';\nimport { fixture, inside, nodeJson } from './paths';\n\ninterface Probe {\n  domGlobals: string[];\n  resolved: string;\n  exports: string[];\n  addedGlobals: string[];\n  diagnostics: { code: string; level: string; field?: string; rows?: number[]; count?: number; chart: string }[];\n  missingTarget: string | null;\n}\n\ndescribe.each([[[]], [['--conditions=development']]] as const)('axylo in plain Node %j', conditions => {\n  const probe = nodeJson<Probe>(fixture('npm'), [...conditions, 'node-import.mjs']);\n\n  it('ran without DOM globals, from the packed file', () => {\n    // Node itself has had a `navigator` global since v21; the DOM ones must be absent.\n    expect(probe.domGlobals.filter(g => g !== 'navigator')).toEqual([]);\n    expect(inside(fixture('npm', 'node_modules/axylo'), new URL(probe.resolved).pathname)).toBe(true);\n  });\n\n  it('exports the five chart functions and validate, and adds no globals on import', () => {\n    expect(probe.exports).toEqual(['area', 'bar', 'donut', 'line', 'scatter', 'validate']);\n    expect(probe.addedGlobals).toEqual([]);\n  });\n\n  it('validate() reports the dirty fixture: AX102, AX103 and AX106 once each, with field and rows (spec 3.5, plan 1.6)', () => {\n    const problems = probe.diagnostics.filter(d => d.level !== 'hint');\n    expect(problems.map(d => d.code).sort()).toEqual(['AX102', 'AX103', 'AX106']);\n    const by = Object.fromEntries(problems.map(d => [d.code, d]));\n    // Row indexes: NaN is row 3 (Thu), '40' row 4 (Fri), the absent value row 5 (Sat).\n    expect(by.AX103).toMatchObject({ level: 'warning', field: 'value', rows: [3], chart: 'Dirty input' });\n    expect(by.AX106).toMatchObject({ level: 'warning', field: 'value', rows: [4], chart: 'Dirty input' });\n    expect(by.AX102).toMatchObject({ level: 'warning', field: 'value', rows: [5], chart: 'Dirty input' });\n  });\n\n  it('a chart function called without a document throws an error that names the target', () => {\n    expect(probe.missingTarget).toContain('#nowhere');\n  });\n});\n\ndescribe('@axylo/react server rendering', () => {\n  let result: { domGlobals: string[]; markup: Record<string, string> };\n\n  beforeAll(async () => {\n    // Bundled only to compile the TSX: every package stays external and is resolved by Node at run time\n    // from the output's location, which is inside the fixture.\n    const outfile = fixture('react', '.out', 'ssr.mjs');\n    await build({\n      entryPoints: [fixture('react', 'ssr.tsx')], bundle: true, platform: 'node', format: 'esm', packages: 'external',\n      jsx: 'automatic', outfile, absWorkingDir: fixture('react'), logLevel: 'silent',\n    });\n    result = nodeJson(path.dirname(outfile), [outfile]);\n  });\n\n  it('runs without DOM globals', () => {\n    expect(result.domGlobals.filter(g => g !== 'navigator')).toEqual([]);\n  });\n\n  it('renders the documented snippet and each component to its empty container (the chart is created on mount, plan 1.7)', () => {\n    expect(Object.keys(result.markup).sort()).toEqual(['Area', 'Bar', 'Donut', 'Line', 'MonthlyVisitors', 'Scatter']);\n    for (const [name, html] of Object.entries(result.markup)) expect(html, name).toMatch(/^<div[^<>]*><\\/div>$/);\n  });\n});\n/**\n * Spec DX11 (MIT for everything, third-party notices) and the zero-runtime-dependency half of DX7, checked\n * mechanically on the packed files and on the source they are built from. THIRD-PARTY-NOTICES.md lists\n * the same checks.\n */\nimport { describe, expect, it } from 'vitest';\nimport { build } from 'esbuild';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { installed, manifest, packedJson, repo } from './paths';\n\ntype Name = 'axylo' | '@axylo/react';\nconst NAMES: Name[] = ['axylo', '@axylo/react'];\n/** What the shipped JavaScript may import: nothing for the core; the core and React for the adapter (plan 1.7). */\nconst ALLOWED_IMPORTS: Record<Name, string[]> = { axylo: [], '@axylo/react': ['axylo', 'react'] };\nconst SOURCE: Record<Name, string> = { axylo: 'packages/axylo/src', '@axylo/react': 'packages/react/src' };\n\n// The standard MIT text (opensource.org/license/mit): its grant and its warranty disclaimer.\nconst MIT_GRANT = 'Permission is hereby granted, free of charge, to any person obtaining a copy';\nconst MIT_DISCLAIMER = 'THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND';\n/** Markers of a licence or copyright header copied in from elsewhere. */\nconst HEADER = /@license\\b|@preserve\\b|SPDX-License-Identifier|Copyright\\s+(\\(c\\)|©|\\d{4})|Licensed under|Permission is hereby granted|THE SOFTWARE IS PROVIDED/i;\n\ndescribe.each(NAMES)('%s', name => {\n  const pkg = packedJson(name);\n\n  it('is MIT: the license field and the shipped LICENSE file', () => {\n    expect(pkg.license).toBe('MIT');\n    const text = fs.readFileSync(installed(name, 'LICENSE'), 'utf8').replace(/\\s+/g, ' ');\n    expect(text.startsWith('MIT License')).toBe(true);\n    expect(text).toContain(MIT_GRANT);\n    expect(text).toContain(MIT_DISCLAIMER);\n  });\n\n  it('declares no runtime dependencies', () => {\n    const raw = pkg as unknown as Record<string, unknown>;\n    for (const field of ['dependencies', 'optionalDependencies', 'bundleDependencies', 'bundledDependencies']) expect(raw[field], field).toBeUndefined();\n    expect(Object.keys(pkg.peerDependencies ?? {}).sort()).toEqual(ALLOWED_IMPORTS[name]);\n  });\n\n  it('ships JavaScript that imports nothing but its peers', async () => {\n    const files = manifest().packages[name].files.filter(f => f.endsWith('.js'));\n    expect(files.length).toBeGreaterThan(0);\n    for (const file of files) {\n      const r = await build({\n        entryPoints: [installed(name, file)], bundle: true, write: false, metafile: true, logLevel: 'silent', format: 'esm',\n        plugins: [{ name: 'externals', setup(b) { b.onResolve({ filter: /^[^./]/ }, a => ({ path: a.path, external: true })); } }],\n      });\n      const imports = Object.values(r.metafile.inputs).flatMap(i => i.imports.filter(x => x.external).map(x => x.path));\n      const roots = [...new Set(imports.map(s => s.startsWith('@') ? s.split('/').slice(0, 2).join('/') : s.split('/')[0]!))].sort();\n      expect(roots.filter(s => !ALLOWED_IMPORTS[name].includes(s)), `${file} imports`).toEqual([]);\n      expect(Object.keys(r.metafile.inputs), `${file} pulls in other files`).toHaveLength(1);\n    }\n  });\n\n  it('is built from its own source only: no node_modules input when its entry is bundled as the release build does', async () => {\n    const src = path.join(repo, SOURCE[name]);\n    const r = await build({\n      entryPoints: [path.join(src, 'index.ts')], bundle: true, write: false, metafile: true, format: 'esm', target: 'es2022',\n      minify: true, define: { __DEV__: 'false' }, legalComments: 'none', logLevel: 'silent', absWorkingDir: repo,\n      external: ['react', 'react/jsx-runtime', 'react-dom', 'axylo'],\n    });\n    const inputs = Object.keys(r.metafile.inputs).map(p => path.resolve(repo, p));\n    expect(inputs.length).toBeGreaterThan(0);\n    expect(inputs.filter(p => !p.startsWith(src + path.sep))).toEqual([]);\n  });\n\n  it('has no copied licence or copyright header in its source or its shipped files', () => {\n    const src = path.join(repo, SOURCE[name]);\n    const sources = fs.readdirSync(src, { recursive: true, encoding: 'utf8' }).filter(f => /\\.[cm]?[jt]sx?$/.test(f)).map(f => path.join(src, f));\n    const shipped = manifest().packages[name].files.filter(f => !/^(LICENSE|README\\.md|package\\.json)$/.test(f)).map(f => installed(name, f));\n    const hits = [...sources, ...shipped].filter(f => HEADER.test(fs.readFileSync(f, 'utf8')));\n    expect(hits.map(f => path.relative(repo, f))).toEqual([]);\n  });\n});\n\ndescribe('THIRD-PARTY-NOTICES.md', () => {\n  const text = fs.readFileSync(path.join(repo, 'THIRD-PARTY-NOTICES.md'), 'utf8');\n\n  it('covers both published packages and states that they ship no third-party code', () => {\n    for (const name of NAMES) expect(text).toContain(`\\`${name}\\``);\n    expect(text).toMatch(/contain no third-party code/);\n  });\n});\n/**\n * Spec DX1, the static half: each documented first chart is ten lines or fewer including the import, counted\n * as a reader counts them (non-blank lines), and passes no option besides data, fields and the title. The\n * title is there because without it the chart raises AX140, a warning (spec 3.5), and a first chart should\n * not print one; first-chart.browser.test.ts shows it is not required. The fixtures and the package READMEs\n * carry the files verbatim, so examples/first-chart stays the single source.\n */\nimport { describe, expect, it } from 'vitest';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { examples, fixture, repo } from './paths';\n\nconst SNIPPETS = [\n  { file: 'npm.ts', fixture: 'npm', readme: 'packages/axylo/README.md' },\n  { file: 'script.html', fixture: 'script', readme: 'packages/axylo/README.md' },\n  { file: 'react.tsx', fixture: 'react', readme: 'packages/react/README.md' },\n] as const;\nconst ALLOWED = ['data', 'title', 'x', 'y'];\n\nconst read = (file: string): string => fs.readFileSync(path.join(examples, file), 'utf8');\n\n/** Option names passed to the chart: keys of the object literal given to line(), or the props of <Line>. */\nfunction optionNames(file: string, code: string): string[] {\n  if (file.endsWith('.tsx')) {\n    const tag = /<Line\\b([^>]*)\\/>/.exec(code);\n    return tag ? [...tag[1]!.matchAll(/\\b([A-Za-z]+)=/g)].map(m => m[1]!).sort() : [];\n  }\n  const call = /\\bline\\(\\s*'[^']*',\\s*\\{([^}]*)\\}\\s*\\)/.exec(code);\n  return call ? [...call[1]!.matchAll(/\\b([A-Za-z]+)\\s*:/g)].map(m => m[1]!).sort() : [];\n}\n\ndescribe.each(SNIPPETS)('examples/first-chart/$file', snippet => {\n  const code = read(snippet.file);\n\n  it('is ten lines or fewer, counting non-blank lines', () => {\n    const lines = code.split('\\n').filter(l => l.trim() !== '').length;\n    console.info(`${snippet.file}: ${lines} non-blank lines`);\n    expect(lines).toBeLessThanOrEqual(10);\n  });\n\n  it('starts with what loads the library (the import, or the script tag after the document head)', () => {\n    if (snippet.file === 'script.html') {\n      expect(code).toMatch(/<script src=\"[^\"]*\\/axylo\\.iife(\\.min)?\\.js\"><\\/script>/);\n      expect(code).toMatch(/<link rel=\"stylesheet\" href=\"[^\"]*\\/axylo\\.css\">/);\n    } else {\n      expect(code.split('\\n')[0]).toMatch(/^import \\{ (Line|line) \\} from '(axylo|@axylo\\/react)';$/);\n    }\n  });\n\n  it('passes no option besides data, fields and the title', () => {\n    const names = optionNames(snippet.file, code);\n    expect(names).toContain('data');\n    expect(names.filter(n => !ALLOWED.includes(n))).toEqual([]);\n  });\n\n  it('is copied verbatim into its fixture and its package README', () => {\n    expect(fs.readFileSync(fixture(snippet.fixture, 'example', snippet.file), 'utf8')).toBe(code);\n    expect(fs.readFileSync(path.join(repo, snippet.readme), 'utf8')).toContain(code);\n  });\n});\n/**\n * `sideEffects` in each package.json is a promise to bundlers. Two halves are checked:\n * - what the promise buys: a consumer that imports a package and uses nothing gets an empty bundle\n *   (measured with esbuild, minified, production condition, from the fixtures);\n * - that it is true: importing the JavaScript has no effect (no globals in Node: node.test.ts; no change to\n *   the document in a browser: first-chart.browser.test.ts), while the stylesheet subpath, which exists only\n *   for its effect, survives a side-effect import.\n */\nimport { describe, expect, it } from 'vitest';\nimport { build } from 'esbuild';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { fixture, out, packedJson } from './paths';\n\nconst bundle = async (contents: string, cwd: string, extra: Parameters<typeof build>[0] = {}) => {\n  const r = await build({\n    stdin: { contents, resolveDir: cwd, loader: 'ts' }, absWorkingDir: cwd, bundle: true, minify: true, format: 'esm',\n    write: false, conditions: ['production'], logLevel: 'silent', outdir: path.join(out, 'side-effects'), ...extra,\n  });\n  return r.outputFiles ?? [];\n};\n\ndescribe('a consumer that imports and uses nothing', () => {\n  for (const [name, cwd, external] of [\n    ['axylo', fixture('npm'), []],\n    ['@axylo/react', fixture('react'), ['react', 'react/*']],\n  ] as const) {\n    for (const statement of [`import ${JSON.stringify(name)};`, `import * as unused from ${JSON.stringify(name)};`]) {\n      it(`${name}: \"${statement}\" bundles to nothing`, async () => {\n        const files = await bundle(statement, cwd, { external: [...external] });\n        const bytes = files.reduce((n, f) => n + f.contents.length, 0);\n        console.info(`${name} \"${statement}\": ${bytes} bytes minified`);\n        expect(files.map(f => f.text.trim()).join('')).toBe('');\n      });\n    }\n  }\n});\n\ndescribe('the stylesheet subpath', () => {\n  it('is the only file either package declares as having side effects', () => {\n    expect(packedJson('@axylo/react').sideEffects).toBe(false);\n    const declared = packedJson('axylo').sideEffects;\n    expect(Array.isArray(declared)).toBe(true);\n    for (const pattern of declared as string[]) expect(pattern).toMatch(/\\.css$/);\n  });\n\n  it('declares itself in exports', () => {\n    expect(packedJson('axylo').exports?.['./axylo.css']).toBe('./dist/axylo.css');\n  });\n\n  it('survives `import \"axylo/axylo.css\"` in a bundler, so sideEffects does not tell bundlers to drop it', async () => {\n    const files = await bundle(`import 'axylo/axylo.css';`, fixture('npm'));\n    const css = files.find(f => f.path.endsWith('.css'));\n    const shipped = fs.readFileSync(fixture('npm', 'node_modules/axylo/dist/axylo.css'), 'utf8');\n    expect(css, 'no CSS output: the import was dropped').toBeDefined();\n    // Minified by the consumer's bundler, so compared by a rule every stylesheet of the library has.\n    expect(shipped).toContain('--axylo-stylesheet');\n    expect(css!.text).toContain('--axylo-stylesheet');\n  });\n});\nimport { defineConfig } from 'vitest/config';\nimport path from 'node:path';\n\n// Tests of the packed distribution (plan M7). They need a built packages/*/dist; the global setup packs it\n// (scripts/pack.mjs --no-build) and installs the tarballs into tests/dist/fixtures before any test runs, so\n// every run tests exactly what `npm pack` produces from the dist at that moment. Browser tests\n// (*.browser.test.ts) are selected with AXYLO_BROWSER=1, as in the root config.\nconst browser = !!process.env.AXYLO_BROWSER;\nexport default defineConfig({\n  root: path.resolve(import.meta.dirname, '../..'),\n  test: {\n    include: browser ? ['tests/dist/**/*.browser.test.ts'] : ['tests/dist/**/*.test.ts'],\n    exclude: ['**/node_modules/**', 'tests/dist/fixtures/**', 'tests/dist/.packed/**', ...(browser ? [] : ['**/*.browser.test.ts'])],\n    globalSetup: ['tests/dist/setup.ts'],\n    testTimeout: browser ? 60000 : 30000,\n    hookTimeout: 120000,\n    fileParallelism: !browser,\n  },\n});\n3:Status: decided by the coordinator on 2026-11-18 after the second review of the interaction layer (`reviews/2026-11-18/impl/wp/core3.interaction.review.md`, new findings 3 and 4). Not rehearsed with a screen reader or a screen magnifier; both parts need that before they are called verified.\n7:**Problem.** WCAG 1.4.13 requires content shown on hover to be hoverable: the pointer must be able to move onto it without it disappearing. Spec I1 requires the readout to name the datum nearest the pointer on every move. On a line chart the whole plot is the picking surface, so a tooltip placed beside the pointer is entered by ordinary left-to-right reading: the plot stops receiving moves and the readout stalls on the old datum. The first fix (12 px, then 22 px of clearance) made the outcome depend on pointer speed: a single move longer than the clearance still lands on the tooltip.\n12:2. It keeps a clearance from the pointer and from the active mark, so moving along the position axis never enters it, at any speed. Moving straight toward it does not change the nearest datum (the position along the axis is unchanged), so the pointer reaches it with the same content showing: that is what makes it hoverable.\n14:4. When neither side across the axis has room (short tiles, compact layouts), the fixed readout under the plot is used instead. The readout has reserved space: it never covers the controls and is never pointer-transparent over them.\n18:Rejected: making the tooltip transparent to the pointer (fails \"hoverable\"); a larger clearance alone (still speed-dependent); always using the fixed readout (loses the association between the readout and the mark on large plots, which is the main use of a tooltip).\n","exit_code":0,"status":"completed"}}
