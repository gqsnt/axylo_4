{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc 'for f in scripts/{pack,size}.mjs tests/dist/{paths.ts,isolation.test.ts,types.test.ts} packages/{axylo,react}/package.json; do nl -ba \"$f\"; done\nls -la tests/dist/.packed tests/dist/fixtures/npm/node_modules packages/axylo/dist\nnode --version'","aggregated_output":"     1\t// Packs the two published packages as npm would publish them and installs the tarballs into the fixtures under\n     2\t// tests/dist/fixtures, without a registry (plan M7; spec DX1, DX7, DX8, DX10).\n     3\t//\n     4\t//   node scripts/pack.mjs             runs the root build first (npm run build)\n     5\t//   node scripts/pack.mjs --no-build  packs whatever packages/*/dist holds now\n     6\t//\n     7\t// Output (all git-ignored):\n     8\t//   tests/dist/.packed/<name>-<version>.tgz   the tarballs, exactly what `npm publish` would upload\n     9\t//   tests/dist/.packed/manifest.json          what npm pack reported (file list, integrity) per package\n    10\t//   tests/dist/fixtures/<fixture>/node_modules  the tarballs unpacked as an install would, plus links to the\n    11\t//                                               root node_modules for third-party packages (react, types)\n    12\t//   tests/dist/fixtures/<fixture>/example/    copies of examples/first-chart, so they resolve from the fixture\n    13\t//\n    14\t// The packages are unpacked, never linked: a fixture must reach `axylo` and `@axylo/react` only through the\n    15\t// packed files and their `exports`, never through the workspace symlinks in the root node_modules.\n    16\timport { execFileSync } from 'node:child_process';\n    17\timport fs from 'node:fs';\n    18\timport path from 'node:path';\n    19\timport { gunzipSync } from 'node:zlib';\n    20\t\n    21\tconst root = path.resolve(import.meta.dirname, '..');\n    22\tconst distTests = path.join(root, 'tests/dist');\n    23\tconst packed = path.join(distTests, '.packed');\n    24\tconst windows = process.platform === 'win32';\n    25\t\n    26\texport const PACKAGES = { axylo: 'packages/axylo', '@axylo/react': 'packages/react' };\n    27\t\n    28\t/** What each fixture installs. `links` come from the root node_modules: third-party code, not ours. */\n    29\texport const FIXTURES = {\n    30\t  npm: { packages: ['axylo'], links: [], examples: ['npm.ts'] },\n    31\t  script: { packages: ['axylo'], links: [], examples: ['script.html'] },\n    32\t  react: {\n    33\t    packages: ['axylo', '@axylo/react'],\n    34\t    links: ['react', 'react-dom', '@types/react', '@types/react-dom'],\n    35\t    examples: ['react.tsx'],\n    36\t  },\n    37\t};\n    38\t\n    39\tconst run = (command, args, options = {}) =>\n    40\t  execFileSync(windows ? `${command}.cmd` : command, args, { cwd: root, encoding: 'utf8', shell: windows, ...options });\n    41\t\n    42\t/** Extracts a gzipped tarball as npm writes it (ustar, with pax or GNU long names), dropping the `package/` prefix. */\n    43\texport function untar(tarball, destination) {\n    44\t  const buffer = gunzipSync(fs.readFileSync(tarball));\n    45\t  const written = [];\n    46\t  let offset = 0;\n    47\t  let longName = null;\n    48\t  while (offset + 512 <= buffer.length) {\n    49\t    const header = buffer.subarray(offset, offset + 512);\n    50\t    if (header.every(byte => byte === 0)) break;\n    51\t    const text = (start, length) => header.subarray(start, start + length).toString('utf8').replace(/\\0[\\s\\S]*$/, '');\n    52\t    const size = parseInt(text(124, 12).trim() || '0', 8);\n    53\t    const type = String.fromCharCode(header[156] || 48);\n    54\t    const body = buffer.subarray(offset + 512, offset + 512 + size);\n    55\t    offset += 512 + Math.ceil(size / 512) * 512;\n    56\t    if (type === 'x' || type === 'L') {\n    57\t      if (type === 'L') longName = body.toString('utf8').replace(/\\0[\\s\\S]*$/, '');\n    58\t      else for (const line of body.toString('utf8').split('\\n')) {\n    59\t        const match = /^\\d+ path=(.*)$/.exec(line);\n    60\t        if (match) longName = match[1];\n    61\t      }\n    62\t      continue;\n    63\t    }\n    64\t    if (type === 'g') continue;\n    65\t    const prefix = text(345, 155);\n    66\t    const name = longName ?? (prefix ? `${prefix}/${text(0, 100)}` : text(0, 100));\n    67\t    longName = null;\n    68\t    const relative = name.replace(/^package\\//, '');\n    69\t    // A tarball is input we did not write by hand: refuse anything that would land outside the destination.\n    70\t    if (path.isAbsolute(relative) || relative.split(/[\\\\/]/).includes('..')) throw new Error(`unsafe path in ${tarball}: ${name}`);\n    71\t    const target = path.join(destination, relative);\n    72\t    if (type === '5') { fs.mkdirSync(target, { recursive: true }); continue; }\n    73\t    if (type !== '0') throw new Error(`unexpected entry type ${JSON.stringify(type)} for ${name} in ${tarball}`);\n    74\t    fs.mkdirSync(path.dirname(target), { recursive: true });\n    75\t    fs.writeFileSync(target, body);\n    76\t    written.push(relative.split(path.sep).join('/'));\n    77\t  }\n    78\t  return written;\n    79\t}\n    80\t\n    81\tfunction link(fixtureModules, name) {\n    82\t  const source = path.join(root, 'node_modules', name);\n    83\t  if (!fs.existsSync(source)) throw new Error(`${name} is not installed in the root node_modules`);\n    84\t  const at = path.join(fixtureModules, name);\n    85\t  fs.mkdirSync(path.dirname(at), { recursive: true });\n    86\t  // A junction needs no privilege on Windows; the type is ignored elsewhere.\n    87\t  fs.symlinkSync(fs.realpathSync(source), at, 'junction');\n    88\t}\n    89\t\n    90\texport function pack({ build = true, log = console.log } = {}) {\n    91\t  if (build) run('npm', ['run', 'build'], { stdio: 'inherit' });\n    92\t  fs.rmSync(packed, { recursive: true, force: true });\n    93\t  fs.mkdirSync(packed, { recursive: true });\n    94\t\n    95\t  const manifest = { packedAt: new Date().toISOString(), packages: {} };\n    96\t  for (const [name, dir] of Object.entries(PACKAGES)) {\n    97\t    const out = run('npm', ['pack', '--json', '--ignore-scripts', '--pack-destination', packed], { cwd: path.join(root, dir) });\n    98\t    const [report] = JSON.parse(out);\n    99\t    manifest.packages[name] = {\n   100\t      directory: dir,\n   101\t      tarball: report.filename,\n   102\t      integrity: report.integrity,\n   103\t      size: report.size,\n   104\t      unpackedSize: report.unpackedSize,\n   105\t      files: report.files.map(f => f.path).sort(),\n   106\t    };\n   107\t    log(`packed ${report.filename}: ${report.files.length} files, ${report.size} bytes`);\n   108\t  }\n   109\t\n   110\t  for (const [fixture, plan] of Object.entries(FIXTURES)) {\n   111\t    const dir = path.join(distTests, 'fixtures', fixture);\n   112\t    const modules = path.join(dir, 'node_modules');\n   113\t    fs.rmSync(modules, { recursive: true, force: true });\n   114\t    fs.rmSync(path.join(dir, 'example'), { recursive: true, force: true });\n   115\t    for (const name of plan.packages) {\n   116\t      const files = untar(path.join(packed, manifest.packages[name].tarball), path.join(modules, name));\n   117\t      const expected = manifest.packages[name].files;\n   118\t      if (files.slice().sort().join('\\n') !== expected.join('\\n')) throw new Error(`${name}: unpacked files differ from npm pack's list`);\n   119\t    }\n   120\t    for (const name of plan.links) link(modules, name);\n   121\t    fs.mkdirSync(path.join(dir, 'example'), { recursive: true });\n   122\t    for (const file of plan.examples) fs.copyFileSync(path.join(root, 'examples/first-chart', file), path.join(dir, 'example', file));\n   123\t  }\n   124\t  fs.writeFileSync(path.join(packed, 'manifest.json'), JSON.stringify(manifest, null, 1));\n   125\t  log(`fixtures ready: ${Object.keys(FIXTURES).join(', ')}`);\n   126\t  return manifest;\n   127\t}\n   128\t\n   129\tif (path.resolve(process.argv[1] ?? '') === import.meta.filename) {\n   130\t  pack({ build: !process.argv.includes('--no-build') });\n   131\t}\n     1\t// What a consumer downloads, minified and gzipped, measured from the packed tarballs (spec DX7, P6; plan M7).\n     2\t//\n     3\t//   node scripts/size.mjs           pack packages/*/dist (scripts/pack.mjs --no-build), measure, print, write bench/size-latest.json\n     4\t//   node scripts/size.mjs --check   the same, and exit 1 when a row exceeds its target\n     5\t//   node scripts/size.mjs --no-pack measure the fixtures already in tests/dist/fixtures\n     6\t//\n     7\t// Every row is built the way a consumer's bundler would build it: esbuild, from inside a fixture that installed\n     8\t// the tarball, minified, with the `production` export condition, so only the packed files and their `exports`\n     9\t// are read. The script-tag row is the two files the documented snippet loads, as shipped.\n    10\t//\n    11\t// Stylesheet: the JavaScript carries the stylesheet as a string and applies it at run time, so a bundler page\n    12\t// downloads it inside its JavaScript and needs no axylo.css; the script-tag snippet also links axylo.css, so\n    13\t// that row adds the file. \"total\" is what each page downloads. The targets are provisional (spec DX7).\n    14\t//\n    15\t// The per-module breakdown cannot come from the packed files, which are one pre-bundled file each: it rebuilds\n    16\t// packages/axylo/src with the release build's production settings (scripts/build.mjs) and reads esbuild's\n    17\t// metafile, then states how far that rebuild is from the packed axylo.js.\n    18\timport { build } from 'esbuild';\n    19\timport fs from 'node:fs';\n    20\timport path from 'node:path';\n    21\timport { gzipSync } from 'node:zlib';\n    22\timport { pack } from './pack.mjs';\n    23\t\n    24\tconst root = path.resolve(import.meta.dirname, '..');\n    25\tconst fixtures = path.join(root, 'tests/dist/fixtures');\n    26\tconst LEVEL = 9;\n    27\tconst gzip = bytes => gzipSync(bytes, { level: LEVEL }).length;\n    28\tconst kib = bytes => +(bytes / 1024).toFixed(2);\n    29\t\n    30\tif (!process.argv.includes('--no-pack')) pack({ build: false, log: () => {} });\n    31\tconst manifest = JSON.parse(fs.readFileSync(path.join(root, 'tests/dist/.packed/manifest.json'), 'utf8'));\n    32\t\n    33\tasync function consumer({ cwd, contents, external = [], metafile = false }) {\n    34\t  const r = await build({\n    35\t    stdin: { contents, resolveDir: cwd, loader: 'ts', sourcefile: 'consumer.ts' }, absWorkingDir: cwd, bundle: true, minify: true,\n    36\t    format: 'esm', target: 'es2022', conditions: ['production'], external, write: false, metafile, logLevel: 'silent',\n    37\t  });\n    38\t  const inputs = Object.keys(r.metafile?.inputs ?? {});\n    39\t  return { bytes: r.outputFiles[0].contents, inputs };\n    40\t}\n    41\t\n    42\tconst npm = path.join(fixtures, 'npm');\n    43\tconst react = path.join(fixtures, 'react');\n    44\tconst axyloFile = file => fs.readFileSync(path.join(npm, 'node_modules/axylo/dist', file));\n    45\tconst css = axyloFile('axylo.css');\n    46\t\n    47\tconst cases = [\n    48\t  {\n    49\t    entry: 'line only (examples/first-chart/npm.ts)', targetKiB: 25,\n    50\t    build: () => consumer({ cwd: npm, contents: fs.readFileSync(path.join(npm, 'example/npm.ts'), 'utf8') }), cssFile: false,\n    51\t  },\n    52\t  { entry: 'everything (export * from axylo)', targetKiB: 40, build: () => consumer({ cwd: npm, contents: \"export * from 'axylo';\" }), cssFile: false },\n    53\t  { entry: 'script tag (axylo.iife.min.js + axylo.css)', targetKiB: null, build: async () => ({ bytes: axyloFile('axylo.iife.min.js') }), cssFile: true },\n    54\t  {\n    55\t    entry: 'React adapter alone (react, axylo external)', targetKiB: 2, cssFile: false,\n    56\t    build: () => consumer({ cwd: react, contents: \"export * from '@axylo/react';\", external: ['react', 'react/*', 'react-dom', 'axylo'] }),\n    57\t  },\n    58\t];\n    59\t\n    60\tconst rows = [];\n    61\tfor (const c of cases) {\n    62\t  const { bytes } = await c.build();\n    63\t  const jsGzip = gzip(bytes);\n    64\t  const cssGzip = c.cssFile ? gzip(css) : 0;\n    65\t  const total = jsGzip + cssGzip;\n    66\t  rows.push({\n    67\t    entry: c.entry, minBytes: bytes.length, jsGzipBytes: jsGzip, cssFileGzipBytes: cssGzip, totalGzipBytes: total,\n    68\t    totalKiB: kib(total), targetKiB: c.targetKiB, over: c.targetKiB !== null && kib(total) > c.targetKiB,\n    69\t  });\n    70\t}\n    71\t\n    72\tconsole.log(`Download size from the packed tarballs (${manifest.packages.axylo.tarball}, ${manifest.packages['@axylo/react'].tarball}, packed ${manifest.packedAt}); esbuild minify, gzip level ${LEVEL}`);\n    73\tconsole.table(rows.map(r => ({\n    74\t  entry: r.entry, 'min B': r.minBytes, 'js gzip B': r.jsGzipBytes, 'css file gzip B': r.cssFileGzipBytes || '—',\n    75\t  'total KiB': r.totalKiB, 'target KiB': r.targetKiB ?? '—', status: r.targetKiB === null ? 'no target' : r.over ? 'OVER' : 'ok',\n    76\t})));\n    77\tconsole.log(`The stylesheet is ${css.length} B, ${gzip(css)} B gzipped as a file; the same text is inside every JavaScript row above.`);\n    78\t\n    79\t// Where the bytes of \"everything\" are: the source rebuilt as scripts/build.mjs builds dist/axylo.js.\n    80\tconst src = path.join(root, 'packages/axylo/src');\n    81\tconst rebuilt = await build({\n    82\t  entryPoints: [path.join(src, 'index.ts')], bundle: true, target: 'es2022', legalComments: 'none', format: 'esm', minify: true,\n    83\t  define: { __DEV__: 'false' }, write: false, metafile: true, logLevel: 'silent', absWorkingDir: root,\n    84\t});\n    85\tconst packedProd = axyloFile('axylo.js').length;\n    86\tconst out = Object.values(rebuilt.metafile.outputs)[0];\n    87\tconst modules = Object.entries(out.inputs).map(([file, v]) => ({ file: path.relative(src, path.resolve(root, file)), bytes: v.bytesInOutput }))\n    88\t  .sort((a, b) => b.bytes - a.bytes);\n    89\tconst sum = modules.reduce((n, m) => n + m.bytes, 0);\n    90\tconst byDir = new Map();\n    91\tfor (const m of modules) { const d = m.file.includes(path.sep) ? m.file.split(path.sep)[0] : '(root)'; byDir.set(d, (byDir.get(d) ?? 0) + m.bytes); }\n    92\tconst dirs = [...byDir].sort((a, b) => b[1] - a[1]).map(([dir, bytes]) => ({ directory: dir, 'min B': bytes, share: `${((100 * bytes) / sum).toFixed(1)}%` }));\n    93\tconsole.log(`\\nPer-module breakdown of \"everything\" (source rebuilt with the release settings: ${rebuilt.outputFiles[0].contents.length} B minified; the packed axylo.js is ${packedProd} B, ${rebuilt.outputFiles[0].contents.length === packedProd ? 'identical in size' : `a difference of ${rebuilt.outputFiles[0].contents.length - packedProd} B, so dist was built from different source`}). Minified bytes before gzip; gzip does not split by module.`);\n    94\tconsole.table(dirs);\n    95\tconsole.table(modules.slice(0, 25).map(m => ({ module: m.file, 'min B': m.bytes, share: `${((100 * m.bytes) / sum).toFixed(1)}%` })));\n    96\t\n    97\tfs.mkdirSync(path.join(root, 'bench'), { recursive: true });\n    98\tfs.writeFileSync(path.join(root, 'bench/size-latest.json'), JSON.stringify({\n    99\t  date: new Date().toISOString(),\n   100\t  method: 'esbuild consumer bundles from tests/dist/fixtures (packed tarballs), minify, production condition; gzip level 9',\n   101\t  packed: { at: manifest.packedAt, axylo: manifest.packages.axylo.integrity, react: manifest.packages['@axylo/react'].integrity },\n   102\t  cssFileBytes: css.length, cssFileGzipBytes: gzip(css), rows,\n   103\t  breakdown: { rebuiltMinBytes: rebuilt.outputFiles[0].contents.length, packedMinBytes: packedProd, directories: dirs, modules },\n   104\t}, null, 1));\n   105\t\n   106\tif (process.argv.includes('--check') && rows.some(r => r.over)) {\n   107\t  console.error(`size target exceeded: ${rows.filter(r => r.over).map(r => `${r.entry} ${r.totalKiB} KiB > ${r.targetKiB} KiB`).join('; ')}`);\n   108\t  process.exit(1);\n   109\t}\n     1\t/** Locations and small helpers shared by the distribution tests. */\n     2\timport { execFileSync } from 'node:child_process';\n     3\timport fs from 'node:fs';\n     4\timport path from 'node:path';\n     5\t\n     6\texport const repo = path.resolve(import.meta.dirname, '../..');\n     7\texport const here = import.meta.dirname;\n     8\texport const packed = path.join(here, '.packed');\n     9\texport const out = path.join(here, '.out');\n    10\texport const fixture = (name: 'npm' | 'script' | 'react', ...rest: string[]): string => path.join(here, 'fixtures', name, ...rest);\n    11\texport const examples = path.join(repo, 'examples/first-chart');\n    12\t\n    13\texport interface PackedPackage {\n    14\t  directory: string;\n    15\t  tarball: string;\n    16\t  integrity: string;\n    17\t  size: number;\n    18\t  unpackedSize: number;\n    19\t  /** Paths inside the tarball, without the `package/` prefix, as npm pack listed them. */\n    20\t  files: string[];\n    21\t}\n    22\texport interface Manifest { packedAt: string; packages: Record<'axylo' | '@axylo/react', PackedPackage> }\n    23\t\n    24\texport const manifest = (): Manifest => JSON.parse(fs.readFileSync(path.join(packed, 'manifest.json'), 'utf8')) as Manifest;\n    25\t\n    26\texport interface PackageJson {\n    27\t  name: string;\n    28\t  version: string;\n    29\t  license?: string;\n    30\t  type?: string;\n    31\t  sideEffects?: boolean | string[];\n    32\t  files?: string[];\n    33\t  types?: string;\n    34\t  main?: string;\n    35\t  exports?: Record<string, string | Record<string, string>>;\n    36\t  dependencies?: Record<string, string>;\n    37\t  peerDependencies?: Record<string, string>;\n    38\t}\n    39\t\n    40\t/** The package.json as it was packed (read from the unpacked tarball, not from the workspace). */\n    41\texport const packedJson = (name: 'axylo' | '@axylo/react'): PackageJson =>\n    42\t  JSON.parse(fs.readFileSync(installed(name, 'package.json'), 'utf8')) as PackageJson;\n    43\t\n    44\t/** A file of a package as unpacked into the fixture that installs it. */\n    45\texport const installed = (name: 'axylo' | '@axylo/react', ...rest: string[]): string =>\n    46\t  fixture(name === 'axylo' ? 'npm' : 'react', 'node_modules', name, ...rest);\n    47\t\n    48\t/** Every file path an `exports` map points at, by condition, for each subpath. */\n    49\texport function exportTargets(exports: PackageJson['exports']): { subpath: string; condition: string; target: string }[] {\n    50\t  const list: { subpath: string; condition: string; target: string }[] = [];\n    51\t  for (const [subpath, value] of Object.entries(exports ?? {})) {\n    52\t    if (typeof value === 'string') list.push({ subpath, condition: 'default', target: value });\n    53\t    else for (const [condition, target] of Object.entries(value)) list.push({ subpath, condition, target });\n    54\t  }\n    55\t  return list;\n    56\t}\n    57\t\n    58\texport const posix = (p: string): string => p.split(path.sep).join('/');\n    59\texport const inside = (parent: string, child: string): boolean => {\n    60\t  const relative = path.relative(parent, child);\n    61\t  return relative !== '' && !relative.startsWith('..') && !path.isAbsolute(relative);\n    62\t};\n    63\t\n    64\t/** Runs Node on a script, from `cwd`, and parses the one JSON line it prints. */\n    65\texport function nodeJson<T>(cwd: string, args: string[]): T {\n    66\t  const stdout = execFileSync(process.execPath, args, { cwd, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'] });\n    67\t  const line = stdout.trim().split('\\n').pop() ?? '';\n    68\t  return JSON.parse(line) as T;\n    69\t}\n     1\t/**\n     2\t * The fixtures reach `axylo` and `@axylo/react` only through the packed files: the installed packages are\n     3\t * real directories (not links to the workspace), and Node and esbuild both resolve them, including the\n     4\t * adapter's own `import 'axylo'`, to files under the fixture's node_modules. The root node_modules holds\n     5\t * workspace symlinks to packages/*, which a fixture would silently fall back to if its copy were missing.\n     6\t */\n     7\timport { describe, expect, it } from 'vitest';\n     8\timport { build } from 'esbuild';\n     9\timport fs from 'node:fs';\n    10\timport path from 'node:path';\n    11\timport { fixture, inside, nodeJson, repo } from './paths';\n    12\t\n    13\tconst workspace = path.join(repo, 'packages');\n    14\t\n    15\tdescribe('fixture installs', () => {\n    16\t  for (const [name, pkg] of [['npm', 'axylo'], ['script', 'axylo'], ['react', 'axylo'], ['react', '@axylo/react']] as const) {\n    17\t    it(`${name}: node_modules/${pkg} is an unpacked directory, not a link`, () => {\n    18\t      const at = fixture(name, 'node_modules', pkg);\n    19\t      expect(fs.lstatSync(at).isSymbolicLink()).toBe(false);\n    20\t      expect(fs.realpathSync(at)).toBe(at);\n    21\t    });\n    22\t  }\n    23\t\n    24\t  it('the root node_modules does link the workspace, so the check below has something to catch', () => {\n    25\t    expect(fs.realpathSync(path.join(repo, 'node_modules/axylo'))).toBe(path.join(workspace, 'axylo'));\n    26\t  });\n    27\t});\n    28\t\n    29\tdescribe('Node resolution from inside the fixtures', () => {\n    30\t  const probe = (cwd: string, specifiers: string[], conditions: string[] = []) => {\n    31\t    const code = `console.log(JSON.stringify(${JSON.stringify(specifiers)}.map(s => import.meta.resolve(s))))`;\n    32\t    return nodeJson<string[]>(cwd, [...conditions.map(c => `--conditions=${c}`), '--input-type=module', '-e', code])\n    33\t      .map(u => fs.realpathSync(new URL(u)));\n    34\t  };\n    35\t\n    36\t  for (const conditions of [[], ['development']]) {\n    37\t    it(`npm fixture, conditions [${conditions.join(', ')}]`, () => {\n    38\t      for (const file of probe(fixture('npm'), ['axylo', 'axylo/axylo.css'], conditions)) {\n    39\t        expect(inside(fixture('npm', 'node_modules/axylo'), file), file).toBe(true);\n    40\t      }\n    41\t    });\n    42\t\n    43\t    it(`react fixture, and the adapter's own import of axylo, conditions [${conditions.join(', ')}]`, () => {\n    44\t      const [adapter, core] = probe(fixture('react'), ['@axylo/react', 'axylo'], conditions);\n    45\t      expect(inside(fixture('react', 'node_modules/@axylo/react'), adapter!), adapter).toBe(true);\n    46\t      expect(inside(fixture('react', 'node_modules/axylo'), core!), core).toBe(true);\n    47\t      // Resolved from the adapter's own directory, as its `import ... from 'axylo'` is at run time.\n    48\t      const [fromAdapter] = probe(path.dirname(adapter!), ['axylo'], conditions);\n    49\t      expect(inside(fixture('react', 'node_modules/axylo'), fromAdapter!), fromAdapter).toBe(true);\n    50\t    });\n    51\t  }\n    52\t});\n    53\t\n    54\tdescribe('esbuild resolution from inside the fixtures', () => {\n    55\t  it('every bundled input of the React snippet that is ours comes from the fixture node_modules', async () => {\n    56\t    const r = await build({\n    57\t      entryPoints: [fixture('react', 'main.tsx')], bundle: true, write: false, metafile: true, jsx: 'automatic',\n    58\t      format: 'esm', logLevel: 'silent', absWorkingDir: fixture('react'), define: { 'process.env.NODE_ENV': '\"production\"' },\n    59\t    });\n    60\t    const inputs = Object.keys(r.metafile.inputs).map(p => path.resolve(fixture('react'), p));\n    61\t    // The production condition (esbuild applies none by default, so `default` is taken).\n    62\t    expect(inputs).toContain(fixture('react', 'node_modules/axylo/dist/axylo.js'));\n    63\t    expect(inputs).toContain(fixture('react', 'node_modules/@axylo/react/dist/index.js'));\n    64\t    expect(inputs.filter(p => inside(workspace, p))).toEqual([]);\n    65\t  });\n    66\t});\n     1\t/**\n     2\t * The packed declarations type-check an application (strict, skipLibCheck off) for both packages, with the\n     3\t * first-chart snippets among the checked files, and they are the declarations the compiler actually read:\n     4\t * the file list must show `axylo` and `@axylo/react` coming from the fixture's node_modules only.\n     5\t */\n     6\timport { describe, expect, it } from 'vitest';\n     7\timport { spawnSync } from 'node:child_process';\n     8\timport path from 'node:path';\n     9\timport { fixture, inside, repo } from './paths';\n    10\t\n    11\tconst tsc = path.join(repo, 'node_modules/typescript/bin/tsc');\n    12\t\n    13\tfunction check(project: string): { status: number | null; output: string; files: string[] } {\n    14\t  const r = spawnSync(process.execPath, [tsc, '-p', project, '--listFiles'], { cwd: project, encoding: 'utf8' });\n    15\t  const output = `${r.stdout}${r.stderr}`;\n    16\t  const files = output.split('\\n').map(l => l.trim()).filter(l => /\\.(d\\.)?tsx?$/.test(l)).map(l => path.resolve(project, l));\n    17\t  return { status: r.status, output, files };\n    18\t}\n    19\t\n    20\tdescribe.each([\n    21\t  ['npm', ['axylo']],\n    22\t  ['react', ['axylo', '@axylo/react']],\n    23\t] as const)('%s fixture', (name, packages) => {\n    24\t  const project = fixture(name);\n    25\t  const result = check(project);\n    26\t\n    27\t  it('type-checks with tsc --strict against the packed declarations', () => {\n    28\t    const errors = result.output.split('\\n').filter(l => /error TS\\d+/.test(l));\n    29\t    expect(errors).toEqual([]);\n    30\t    expect(result.status).toBe(0);\n    31\t  });\n    32\t\n    33\t  it('read the declarations from the fixture node_modules, never from the workspace', () => {\n    34\t    for (const pkg of packages) {\n    35\t      const dir = path.join(project, 'node_modules', pkg);\n    36\t      const read = result.files.filter(f => inside(dir, f));\n    37\t      expect(read.length, `${pkg} declarations read`).toBeGreaterThan(0);\n    38\t    }\n    39\t    expect(result.files.filter(f => inside(path.join(repo, 'packages'), f))).toEqual([]);\n    40\t  });\n    41\t\n    42\t  it('checked the first-chart snippet', () => {\n    43\t    expect(result.files).toContain(path.join(project, 'example', name === 'npm' ? 'npm.ts' : 'react.tsx'));\n    44\t  });\n    45\t});\n     1\t{\n     2\t  \"name\": \"axylo\",\n     3\t  \"version\": \"0.0.0\",\n     4\t  \"description\": \"Everyday charts that are faithful to the data, readable everywhere and accessible by default.\",\n     5\t  \"license\": \"MIT\",\n     6\t  \"type\": \"module\",\n     7\t  \"sideEffects\": [\"*.css\"],\n     8\t  \"files\": [\n     9\t    \"dist/axylo.js\",\n    10\t    \"dist/axylo.dev.js\",\n    11\t    \"dist/axylo.iife.js\",\n    12\t    \"dist/axylo.iife.min.js\",\n    13\t    \"dist/axylo.css\",\n    14\t    \"dist/index.d.ts\",\n    15\t    \"dist/public.d.ts\"\n    16\t  ],\n    17\t  \"exports\": {\n    18\t    \".\": {\n    19\t      \"types\": \"./dist/index.d.ts\",\n    20\t      \"development\": \"./dist/axylo.dev.js\",\n    21\t      \"default\": \"./dist/axylo.js\"\n    22\t    },\n    23\t    \"./axylo.css\": \"./dist/axylo.css\"\n    24\t  }\n    25\t}\n     1\t{\n     2\t  \"name\": \"@axylo/react\",\n     3\t  \"version\": \"0.0.0\",\n     4\t  \"description\": \"React components for Axylo charts.\",\n     5\t  \"license\": \"MIT\",\n     6\t  \"type\": \"module\",\n     7\t  \"sideEffects\": false,\n     8\t  \"files\": [\"dist/index.js\", \"dist/index.dev.js\", \"dist/index.d.ts\"],\n     9\t  \"exports\": { \".\": { \"types\": \"./dist/index.d.ts\", \"development\": \"./dist/index.dev.js\", \"default\": \"./dist/index.