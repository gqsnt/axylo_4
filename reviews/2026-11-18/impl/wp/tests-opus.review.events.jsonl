t src=\"https://cdn.jsdelivr.net/npm/axylo/dist/axylo.iife.min.js\"></script>\n     5\t<div id=\"chart\"></div>\n     6\t<script>\n     7\t  const rows = [{ month: '2026-01', visitors: 4210 }, { month: '2026-02', visitors: 4685 },\n     8\t    { month: '2026-03', visitors: 5302 }, { month: '2026-04', visitors: 5127 }];\n     9\t  Axylo.line('#chart', { title: 'Monthly visitors', data: rows, x: 'month', y: 'visitors' });\n    10\t</script>\n     1\t# Not yet run: the repository has no remote. Written against the commands that\n     2\t# pass locally on Linux with system Chrome; Windows and macOS results are\n     3\t# unknown until this runs there.\n     4\tname: ci\n     5\t\n     6\ton:\n     7\t  push:\n     8\t    branches: [main]\n     9\t  pull_request:\n    10\t\n    11\tpermissions:\n    12\t  contents: read\n    13\t\n    14\tjobs:\n    15\t  check:\n    16\t    strategy:\n    17\t      fail-fast: false\n    18\t      matrix:\n    19\t        os: [ubuntu-latest, windows-latest, macos-latest]\n    20\t    runs-on: ${{ matrix.os }}\n    21\t    timeout-minutes: 20\n    22\t    steps:\n    23\t      - uses: actions/checkout@v4\n    24\t      - uses: actions/setup-node@v4\n    25\t        with:\n    26\t          node-version: 24\n    27\t          cache: npm\n    28\t      - run: npm ci\n    29\t      - run: npm run typecheck\n    30\t      - run: npm test\n    31\t      - run: npm run build\n    32\t      # The browser tests launch the runner's installed Chrome\n    33\t      # (playwright-core, channel \"chrome\"); no browser download.\n    34\t      # Called directly, not through the npm script: that script sets the\n    35\t      # variable with POSIX syntax, which npm on Windows runs through cmd.exe.\n    36\t      - run: npx vitest run\n    37\t        env:\n    38\t          AXYLO_BROWSER: 1\n    39\t      # The packed tarballs, unpacked into clean fixtures.\n    40\t      - run: npx vitest run --config tests/dist/vitest.config.ts\n    41\t      - run: n