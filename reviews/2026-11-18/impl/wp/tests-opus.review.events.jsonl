xDomain(page))).toBeCloseTo(width(full), 0);\n   299\t      await page.keyboard.press('+');\n   300\t      await settle(page);\n   301\t      await page.keyboard.press('0');\n   302\t      await settle(page);\n   303\t      expect(await xDomain(page)).toEqual(full);\n   304\t      expect(await closePage(page)).toEqual([]);\n   305\t    });\n   306\t\n   307\t    it(`I3 ${type}: with zoom: 'touch' a two-finger pinch zooms; without it the pinch is left to the page`, async () => {\n   308\t      const pinch = async (page: Page) => {\n   309\t        const g = await plotGeometry(page);\n   310\t        const cx = g.plot.x + g.plot.width / 2, cy = g.plot.y + g.plot.height / 2;\n   311\t        const client = await page.context().newCDPSession(page);\n   312\t        const at = (d: number) => [{ x: cx - d, y: cy, id: 0 }, { x: cx + d, y: cy, id: 1 }];\n   313\t        await client.send('Input.dispatchTouchEvent', { type: 'touchStart', touchPoints: at(40) });\n   314\t        for (let d = 50; d <= 160; d += 10) await client.send('Input.dispatchTouchEvent', { type: 'touchMove', touchPoints: at(d) });\n   315\t        await client.send('Input.dispatchTouchEvent', { type: 'touchEnd', touchPoints: [] });\n   316\t        await client.detach();\n   317\t        await settle(page);\n   318\t      };\n   319\t      const page = await devPage({ hasTouch: true });\n   320\t      await zoomable(page, type);\n   321\t      await call(page, 'update', [{ zoom: 'touch' }]);\n   322\t      const full = await xDomain(page);\n   323\t      await pinch(page);\n   324\t      expect(width(await xDomain(page))).toBeLessThan(width(full) * 0.8);\n   325\t      await page.close();\n   326\t      const plain = await devPage({ hasTouch: true });\n   327\t      await zoomable(plain, type);\n   328\t      const before = await xDomain(plain);\n   329\t      await pinch(plain);\n   330\t      expect(await xDomain(plain)).toEqual(before);\n   331\t      expect(await closePage(plain)).toEqual([]);\n   332\t    });\n   333\t\n   334\t    it(`I3 ${type}: the wheel over an unfocused plot scrolls the page; over the focused plot it zooms; with Ctrl held it never zooms`, async () => {\n   335\t      const page = await devPage({ css: 'body { height: 3000px; }' });\n   336\t      await zoomable(page, type);\n   337\t      const full = await xDomain(page);\n   338\t      const g = await plotGeometry(page);\n   339\t      await page.mouse.move(g.plot.x + g.plot.width / 2, g.plot.y + g.plot.height / 2);\n   340\t      await page.mouse.wheel(0, 200);\n   341\t      await page.waitForFunction(() => window.scrollY > 0, null, { timeout: 5000 });\n   342\t      await settle(page);\n   343\t      expect(await xDomain(page)).toEqual(full);\n   344\t      await page.evaluate(() => window.scrollTo(0, 0));\n   345\t      await page.focus('#chart .axylo-proxy');\n   346\t      await page.keyboard.down('Control');\n   347\t      await page.mouse.move(g.plot.x + g.plot.width / 2, g.plot.y + g.plot.height / 2);\n   348\t      await page.mouse.wheel(0, -200);\n   349\t      await page.keyboard.up('Control');\n   350\t      await settle(page);\n   351\t      expect(await xDomain(page)).toEqual(full);\n   352\t      await page.mouse.wheel(0, -200);\n   353\t      await settle(page);\n   354\t      expect(width(await xDomain(page))).toBeLessThan(width(full));\n   355\t      expect(await closePage(page)).toEqual([]);\n   356\t    });\n   357\t  }\n   358\t});\n   359\t\n   360\t// ── I4 ────────────────────────────────────────────────────────────────────────────────────────────\n   361\t\n   362\tdescribe('I4 single pointer, touch and target size', () => {\n   363\t  for (const type of FULL as Full[]) {\n   364\t    it(`I4 ${type}: every control (toolbar, legend, table pager, jump field) is at least 24 × 24 CSS px`, async () => {\n   365\t      const page = await devPage();\n   366\t      await create(page, type);\n   367\t      // Streaming, so the Pause control is there too.\n   368\t      await call(page, 'append', [more(type, 0)]);\n   369\t      const small: string[] = [];\n   370\t      const measure = async () => {\n   371\t        for (const el of await page.locator('#chart button, #chart input:not(.axylo-proxy)').all()) {\n   372\t          if (!(await el.isVisible())) continue;\n   373\t          const b = (await el.boundingBox())!;\n   374\t          if (b.width < 24 || b.height < 24) small.push(`${(await el.textContent()) || (await el.getAttribute('class'))}: ${b.width}×${b.height}`);\n   375\t        }\n   376\t      };\n   377\t      await measure();\n   378\t      await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n   379\t      await settle(page);\n   380\t      await measure();\n   381\t      expect(small).toEqual([]);\n   382\t      expect(await closePage(page)).toEqual([]);\n   383\t    });\n   384\t\n   385\t    it(`I4 ${type}: a tap shows what is under the finger, and a one-finger vertical drag over the chart scrolls the page`, async () => {\n   386\t      const page = await devPage({ hasTouch: true, css: 'body { height: 3000px; }' });\n   387\t      await create(page, type);\n   388\t      const probe = (await probes(page, type))[type === 'donut' ? 0 : 3]!;\n   389\t      await page.touchscreen.tap(probe.x, probe.y);\n   390\t      await settle(page);\n   391\t      expect(await tooltip(page).isVisible()).toBe(true);\n   392\t      expect(says((await tooltip(page).textContent()) ?? '', probe)).toBe(true);\n   393\t      const client = await page.context().newCDPSession(page);\n   394\t      const p = await box(page, '#chart .axylo-proxy');\n   395\t      const x = p.x + p.width / 2, y0 = p.y + p.height - 20;\n   396\t      await client.send('Input.dispatchTouchEvent', { type: 'touchStart', touchPoints: [{ x, y: y0 }] });\n   397\t      for (let i = 1; i <= 10; i++) await client.send('Input.dispatchTouchEvent', { type: 'touchMove', touchPoints: [{ x, y: y0 - i * 15 }] });\n   398\t      await client.send('Input.dispatchTouchEvent', { type: 'touchEnd', touchPoints: [] });\n   399\t      await client.detach();\n   400\t      await page.waitForFunction(() => window.scrollY > 0, null, { timeout: 5000 }).catch(() => undefined);\n   401\t      expect(await page.evaluate(() => window.scrollY)).toBeGreaterThan(0);\n   402\t      expect(await closePage(page)).toEqual([]);\n   403\t    });\n   404\t  }\n   405\t});\n   406\t\n   407\t// ── I5 ────────────────────────────────────────────────────────────────────────────────────────────\n   408\t\n   409\t/** Fraction of pixels that differ by more than 8 per channel. */\n   410\tfunction changed(a: { data: Uint8Array | Buffer }, b: { data: Uint8Array | Buffer }): number {\n   411\t  let n = 0;\n   412\t  for (let i = 0; i < a.data.length; i += 4) if (Math.abs(a.data[i]! - b.data[i]!) > 8 || Math.abs(a.data[i + 1]! - b.data[i + 1]!) > 8 || Math.abs(a.data[i + 2]! - b.data[i + 2]!) > 8) n++;\n   413\t  return n / (a.data.length / 4);\n   414\t}\n   415\t\n   416\tdescribe('I5 motion', () => {\n   417\t  for (const type of TYPES) {\n   418\t    for (const motion of ['no-preference', 'reduce'] as const) {\n   419\t      it(`I5 ${type}: the first frame after fonts load equals the frame at 2.5 s within 0.1 % of pixels (prefers-reduced-motion: ${motion})`, async () => {\n   420\t        const page = await devPage({ reducedMotion: motion });\n   421\t        await page.evaluate(() => document.fonts.ready);\n   422\t        await create(page, type);\n   423\t        const first = (await screenshot(page, '#chart figure')).img;\n   424\t        await page.waitForTimeout(2500);\n   425\t        const later = (await screenshot(page, '#chart figure')).img;\n   426\t        expect(changed(first, later)).toBeLessThanOrEqual(0.001);\n   427\t        expect(await closePage(page)).toEqual([]);\n   428\t      });\n   429\t    }\n   430\t\n   431\t    it(`I5 ${type}: under reduced motion an update reaches its final frame in one step; without it the update has settled 300 ms later (reading: 200 ms plus 100 ms of slack on a loaded machine)`, async () => {\n   432\t      for (const motion of ['reduce', 'no-preference'] as const) {\n   433\t        const page = await devPage({ reducedMotion: motion });\n   434\t        await create(page, type);\n   435\t        const data = type === 'donut' ? [{ item: 'Rent', spend: 300 }, { item: 'Food', spend: 900 }]\n   436\t          : type === 'scatter' ? [{ size: 10, latency: 50, region: 'EU' }, { size: 30, latency: 150, region: 'US' }]\n   437\t            : type === 'bar' ? [{ quarter: 'Q1', kind: 'Plan', shipped: 5 }, { quarter: 'Q2', kind: 'Plan', shipped: 60 }]\n   438\t              : [{ day: '2026-03-02', site: 'North', energy: 30 }, { day: '2026-03-03', site: 'North', energy: 2 }];\n   439\t        await page.evaluate(d => (window as unknown as { charts: { update(p: unknown): void }[] }).charts[0]!.update({ data: d }), data);\n   440\t        await page.evaluate(() => new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r))));\n   441\t        const step = (await screenshot(page, '#chart figure')).img;\n   442\t        await page.waitForTimeout(300);\n   443\t        const settled = (await screenshot(page, '#chart figure')).img;\n   444\t        await page.waitForTimeout(700);\n   445\t        const final = (await screenshot(page, '#chart figure')).img;\n   446\t        if (motion === 'reduce') expect(changed(step, final), 'reduced motion: one step').toBeLessThanOrEqual(0.001);\n   447\t        expect(changed(settled, final), `${motion}: settled by 300 ms`).toBeLessThanOrEqual(0.001);\n   448\t        await closePage(page);\n   449\t      }\n   450\t    });\n   451\t  }\n   452\t});\n   453\t\n   454\t// ── I6 ────────────────────────────────────────────────────────────────────────────────────────────\n   455\t\n   456\tfunction more(type: Full, k: number): unknown[] {\n   457\t  const day = new Date(Date.UTC(2026, 2, 7) + k * 864e5).toISOString().slice(0, 10);\n   458\t  switch (type) {\n   459\t    case 'line': case 'area': return [{ day, site: 'North', energy: 10 + k }, { day, site: 'South', energy: 5 + k }];\n   460\t    case 'bar': return [{ quarter: `P${k}`, kind: 'Plan', shipped: 40 + k }, { quarter: `P${k}`, kind: 'Actual', shipped: 39 + k }];\n   461\t    case 'scatter': return [{ size: 40 + k, latency: 100 + k, region: 'EU' }];\n   462\t    case 'donut': return [{ item: `Item ${k}`, spend: 100 + k }];\n   463\t  }\n   464\t}\n   465\t\n   466\tdescribe('I6 pause', () => {\n   467\t  for (const type of FULL as Full[]) {\n   468\t    it(`I6 ${type}: append shows a Pause control; paused, new rows are buffered and nothing on screen moves; Resume applies them`, async () => {\n   469\t      const page = await devPage();\n   470\t      await create(page, type);\n   471\t      expect(await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'Pause' }).count()).toBe(0);\n   472\t      await call(page, 'append', [more(type, 0)]);\n   473\t      const pause = page.locator('#chart [role=\"toolbar\"] button', { hasText: 'Pause' });\n   474\t      expect(await pause.count()).toBe(1);\n   475\t      await pause.click();\n   476\t      await settle(page);\n   477\t      const scene = () => page.evaluate(() => document.querySelector('#chart svg.axylo-svg .axylo-scene')!.innerHTML);\n   478\t      const before = await scene();\n   479\t      for (let k = 1; k <= 3; k++) await call(page, 'append', [more(type, k)]);\n   480\t      expect(await scene()).toBe(before);\n   481\t      const resume = page.locator('#chart [role=\"toolbar\"] button', { hasText: 'Resume' });\n   482\t      expect(await resume.count()).toBe(1);\n   483\t      await resume.click();\n   484\t      await settle(page);\n   485\t      expect(await scene()).not.toBe(before);\n   486\t      // All three buffered appends arrived: the table holds them.\n   487\t      await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n   488\t      await settle(page);\n   489\t      const rows = await page.locator('#chart table tbody tr').count();\n   490\t      const base = type === 'scatter' ? 6 : type === 'donut' ? 4 : type === 'bar' ? 4 : 5;\n   491\t      expect(rows).toBe(base + 4);\n   492\t      expect(await closePage(page)).toEqual([]);\n   493\t    });\n   494\t  }\n   495\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"sed -n '100,219{=;p;}' packages/axylo/test/browser/acceptance/l-legibility.browser.test.ts\"","aggregated_output":"100\nasync function textContrast(page: Page): Promise<{ text: string; size: number; ratio: number }[]> {\n101\n  const raw = await page.evaluate(() => {\n102\n    const out: { text: string; size: number; color: string; bg: string }[] = [];\n103\n    const walker = document.createTreeWalker(document.querySelector('#chart')!, NodeFilter.SHOW_TEXT);\n104\n    const opaque = (c: string) => !!c && c !== 'transparent' && !/rgba\\(.*,\\s*0\\)$/.test(c);\n105\n    for (let n = walker.nextNode(); n; n = walker.nextNode()) {\n106\n      const el = n.parentElement!;\n107\n      if (!n.textContent?.trim() || el.closest('[hidden], .axylo-visually-hidden, svg')) continue;\n108\n      const s = getComputedStyle(el);\n109\n      if (s.display === 'none' || s.visibility === 'hidden') continue;\n110\n      let bg = 'rgb(255, 255, 255)';\n111\n      for (let a: Element | null = el; a; a = a.parentElement) { const c = getComputedStyle(a).backgroundColor; if (opaque(c)) { bg = c; break; } }\n112\n      out.push({ text: n.textContent.trim(), size: parseFloat(s.fontSize), color: s.color, bg });\n113\n    }\n114\n    return out;\n115\n  });\n116\n  const colors = await resolveColors(page, raw.flatMap(r => [r.color, r.bg]));\n117\n  return raw.map((r, i) => ({ text: r.text, size: r.size, ratio: contrast(colors[2 * i]!, colors[2 * i + 1]!) }));\n118\n}\n119\n\n120\n/** The resolved colours of the axis lines (the scene's rules painted with `--axylo-axis`). */\n121\nasync function axisColors(page: Page): Promise<RGB[]> {\n122\n  const css = await page.evaluate(() => [...document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene line')].filter(l => /--axylo-axis/.test(l.style.getPropertyValue('color'))).map(l => getComputedStyle(l).color));\n123\n  return resolveColors(page, [...new Set(css)]);\n124\n}\n125\n\n126\ndescribe('L2 text size and contrast', () => {\n127\n  for (const type of TYPES) {\n128\n    for (const scheme of ['light', 'dark'] as const) {\n129\n      it(`L2 ${type}: in the ${scheme} scheme every text is at least 12 CSS px and 4.5:1 (legend entries of hidden series included); marks, axis lines and the focus indicator are at least 3:1`, async () => {\n130\n        const page = await devPage({ css: scheme === 'dark' ? DARK_PAGE : '' });\n131\n        await create(page, type, { subtitle: 'All sites' });\n132\n        if (type !== 'compact' && type !== 'donut') {\n133\n          await page.locator('#chart .axylo-legend-entry').first().click();\n134\n          await settle(page);\n135\n        }\n136\n        const bad = (await textContrast(page)).filter(t => t.size < 12 || t.ratio < 4.5).map(t => `\"${t.text}\" ${t.size}px ${t.ratio.toFixed(2)}:1`);\n137\n        expect(bad).toEqual([]);\n138\n        const bg = await backgroundColor(page);\n139\n        // A hidden series draws no marks, so the marks measured are those of the shown series.\n140\n        for (const c of await seriesColors(page)) expect(contrast(c, bg), `mark ${c}`).toBeGreaterThanOrEqual(3);\n141\n        if (type !== 'donut' && type !== 'compact') for (const c of await axisColors(page)) expect(contrast(c, bg), `axis ${c}`).toBeGreaterThanOrEqual(3);\n142\n        if (type !== 'compact') {\n143\n          await page.focus('#before');\n144\n          await page.keyboard.press('Tab');\n145\n          const ring = await page.locator('#chart .axylo-focus-ring').evaluate(el => getComputedStyle(el).outlineColor);\n146\n          const [c] = await resolveColors(page, [ring]);\n147\n          expect(contrast(c!, bg), 'focus indicator').toBeGreaterThanOrEqual(3);\n148\n        }\n149\n        expect(await closePage(page)).toEqual([]);\n150\n      });\n151\n    }\n152\n  }\n153\n});\n154\n\n155\n// ── L3 ────────────────────────────────────────────────────────────────────────────────────────────\n156\n\n157\ndescribe('L3 the chart follows its container', () => {\n158\n  for (const type of FULL as Full[]) {\n159\n    it(`L3 ${type}: resized 720 → 360 → 720 px with no call from the page, the figure follows in both directions`, async () => {\n160\n      const page = await devPage();\n161\n      await create(page, type);\n162\n      const widths: number[] = [];\n163\n      for (const w of [720, 360, 720]) {\n164\n        await page.evaluate(w => { (document.querySelector('#chart') as HTMLElement).style.width = `${w}px`; }, w);\n165\n        await settle(page);\n166\n        widths.push(Math.round((await box(page, '#chart .axylo-plot')).width));\n167\n        expect((await box(page, '#chart svg.axylo-svg')).width).toBeLessThanOrEqual(w + 0.5);\n168\n      }\n169\n      expect(widths[1]).toBeLessThan(widths[0]!);\n170\n      expect(widths[2]).toBe(widths[0]);\n171\n      expect(await closePage(page)).toEqual([]);\n172\n    });\n173\n\n174\n    it(`L3 ${type}: with no definite height the plot is 16:9 of its width, clamped to 160–480 px, and stable over 10 frames`, async () => {\n175\n      const page = await devPage({ viewport: { width: 1300, height: 1200 }, css: '#chart { height: auto; }' });\n176\n      await create(page, type);\n177\n      for (const w of [240, 720, 1200]) {\n178\n        await page.evaluate(w => { (document.querySelector('#chart') as HTMLElement).style.width = `${w}px`; }, w);\n179\n        await settle(page);\n180\n        const heights: number[] = [];\n181\n        for (let i = 0; i < 10; i++) {\n182\n          heights.push((await box(page, '#chart .axylo-plot')).height);\n183\n          await page.evaluate(() => new Promise(r => requestAnimationFrame(r)));\n184\n        }\n185\n        const plot = await box(page, '#chart .axylo-plot');\n186\n        const expected = Math.min(480, Math.max(160, plot.width * 9 / 16));\n187\n        expect(Math.abs(heights[0]! - expected), `${w} px wide`).toBeLessThanOrEqual(1);\n188\n        expect(new Set(heights.map(h => Math.round(h))).size).toBe(1);\n189\n      }\n190\n      expect(await closePage(page)).toEqual([]);\n191\n    });\n192\n\n193\n    it(`L3 ${type}: a container that starts hidden draws when it is shown`, async () => {\n194\n      const page = await devPage({ css: '#chart.off { display: none; }' });\n195\n      await page.evaluate(() => document.querySelector('#chart')!.classList.add('off'));\n196\n      const { fn, options } = optionsFor(type);\n197\n      // Created while hidden: nothing can be drawn yet, so the test does not wait for a drawn frame here.\n198\n      await page.evaluate(({ fn, options }) => {\n199\n        const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => unknown>; charts: unknown[] };\n200\n        w.charts.push(w.Axylo[fn]!('#chart', options));\n201\n      }, { fn, options });\n202\n      await page.evaluate(() => new Promise(r => setTimeout(r, 100)));\n203\n      await page.evaluate(() => document.querySelector('#chart')!.classList.remove('off'));\n204\n      // Shown: the chart draws on its own; wait (bounded) for its marks, then assert.\n205\n      await page.waitForFunction(() => [...document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene *')].some(e => /--axylo-series-color-/.test(e.style.getPropertyValue('color'))), null, { timeout: 5000 }).catch(() => undefined);\n206\n      const marks = await page.evaluate(() => [...document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene *')].filter(e => /--axylo-series-color-/.test(e.style.getPropertyValue('color'))).length);\n207\n      expect(marks).toBeGreaterThan(0);\n208\n      expect((await box(page, '#chart .axylo-plot')).width).toBeGreaterThan(300);\n209\n      expect(await closePage(page)).toEqual([]);\n210\n    });\n211\n  }\n212\n});\n213\n\n214\n// ── L4 ────────────────────────────────────────────────────────────────────────────────────────────\n215\n\n216\ndescribe('L4 scheme from the page', () => {\n217\n  for (const type of TYPES) {\n218\n    it(`L4 ${type}: a page that sets color-scheme: dark gets the dark marks; a class-toggled dark theme without color-scheme repaints by the next frame`, async () => {\n219\n      const page = await devPage({ css: 'body.dark { background: #121212; color: #e8e8e8; }' });\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts | head -265'","aggregated_output":"     1\t/**\n     2\t * Interaction, I1–I6 (spec 3.3): the tooltip under a real pointer, legend toggles, zoom four ways, single\n     3\t * pointer and touch, motion, and the pause control. Pointer and keys are Playwright's own input; pinch and\n     4\t * a one-finger drag go through the DevTools protocol, which Playwright's touchscreen cannot produce.\n     5\t */\n     6\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     7\timport type { Page } from 'playwright-core';\n     8\timport { start, stop } from '../harness';\n     9\timport {\n    10\t  axWithin, box, call, center, closePage, create, createRaw, devPage, intersects, plotGeometry, ring, screenshot, settle, shapes, type Box,\n    11\t} from './util';\n    12\timport { calendar, CARTESIAN, ENERGY, FULL, inOrder, LATENCY, share, SHIPPED, SPEND, TYPES, withUnit, type ChartType } from './fixtures';\n    13\t\n    14\tbeforeAll(start);\n    15\tafterAll(stop);\n    16\t\n    17\ttype Full = Exclude<ChartType, 'compact'>;\n    18\tconst tooltip = (page: Page) => page.locator('#chart .axylo-tooltip');\n    19\t\n    20\tinterface Probe { x: number; y: number; expect: string[]; marks: Box[]; ordered?: boolean }\n    21\t\n    22\t/** Whether the tooltip text says what the probe expects: in order, or (scatter, spec 3.6 lists what, not in which order) all of it. */\n    23\tconst says = (text: string, probe: Probe) => (probe.ordered === false ? probe.expect.every(e => text.includes(e)) : inOrder(text, probe.expect));\n    24\t\n    25\t/** Where to point, and what the tooltip must then say, for 20 positions per type (edges included). */\n    26\tasync function probes(page: Page, type: Full): Promise<Probe[]> {\n    27\t  const p = await box(page, '#chart .axylo-proxy');\n    28\t  const drawn = await shapes(page, '#chart', type === 'bar' ? 100000 : 14);\n    29\t  if (type === 'donut') {\n    30\t    const g = await ring(page);\n    31\t    const total = SPEND.values.reduce((a, b) => a + b, 0);\n    32\t    return Array.from({ length: 20 }, (_, k) => {\n    33\t      const deg = 9 + k * 18;\n    34\t      let at = 0, i = 0;\n    35\t      for (; i < SPEND.values.length; i++) { at += SPEND.values[i]!; if (deg < (360 * at) / total) break; }\n    36\t      const a = (deg * Math.PI) / 180, r = g.outer * 0.85;\n    37\t      return { x: g.cx + r * Math.sin(a), y: g.cy - r * Math.cos(a), expect: [SPEND.items[i]!, withUnit(SPEND.values[i]!, 'EUR'), share(SPEND.values[i]!)], marks: [] };\n    38\t    });\n    39\t  }\n    40\t  if (type === 'scatter') {\n    41\t    // Each point, then offsets up to 16 px (inside the 24 px picking radius); points sit on the plot's edges.\n    42\t    const eu = LATENCY.points.filter(q => q.region === 'EU'), us = LATENCY.points.filter(q => q.region === 'US');\n    43\t    const sortedEU = (drawn[1] ?? []).map(s => center(s.box)).sort((a, b) => a.x - b.x);\n    44\t    const sortedUS = (drawn[2] ?? []).map(s => center(s.box)).sort((a, b) => a.x - b.x);\n    45\t    const named = [...sortedEU.map((c, i) => ({ c, q: eu[i]! })), ...sortedUS.map((c, i) => ({ c, q: us[i]! }))];\n    46\t    const offsets = [[0, 0], [10, 0], [-10, 0], [0, 12]];\n    47\t    return named.flatMap(({ c, q }) => offsets.map(([dx, dy]) => ({ x: Math.min(p.x + p.width - 1, Math.max(p.x + 1, c.x + dx!)), y: Math.min(p.y + p.height - 1, Math.max(p.y + 1, c.y + dy!)), expect: [q.region, withUnit(q.size, 'kB'), withUnit(q.latency, 'ms')], marks: [], ordered: false }))).slice(0, 20);\n    48\t  }\n    49\t  const xs = type === 'bar' ? SHIPPED.quarters : ENERGY.days.map(calendar);\n    50\t  const series = type === 'bar' ? SHIPPED.series : ENERGY.series;\n    51\t  const unit = type === 'bar' ? 't' : 'kWh';\n    52\t  const columns = [0, 0.1, 0.3, 0.5, 0.7, 0.9, 1];\n    53\t  const rows = [0, 0.5, 1];\n    54\t  const out: Probe[] = [];\n    55\t  const marks1 = (drawn[1] ?? []).map(s => s.box).sort((a, b) => a.x - b.x), marks2 = (drawn[2] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n    56\t  for (const f of columns) for (const g of rows) {\n    57\t    if (out.length >= 20) break;\n    58\t    const px = p.x + Math.min(p.width - 1, Math.max(1, f * p.width));\n    59\t    const py = p.y + Math.min(p.height - 1, Math.max(1, g * p.height));\n    60\t    // Nearest x (line, area: the marker centres), or the band under the pointer (bar: the middle of the\n    61\t    // group's two bars; bands meet half-way between neighbouring groups).\n    62\t    const centres = type === 'bar' ? marks1.map((m, k) => (m.x + marks2[k]!.x + marks2[k]!.width) / 2) : marks1.map(m => m.x + m.width / 2);\n    63\t    const i = centres.map(c => Math.abs(c - px)).indexOf(Math.min(...centres.map(c => Math.abs(c - px))));\n    64\t    out.push({ x: px, y: py, expect: [xs[i]!, series[0]!.name, withUnit(series[0]!.values[i]!, unit), series[1]!.name, withUnit(series[1]!.values[i]!, unit)], marks: [marks1[i]!, marks2[i]!].filter(Boolean) });\n    65\t  }\n    66\t  return out;\n    67\t}\n    68\t\n    69\tdescribe('I1 tooltip under the pointer', () => {\n    70\t  for (const type of FULL as Full[]) {\n    71\t    it(`I1 ${type}: at 20 positions, the four edges included, the tooltip shows what is there by the type's picking rule, stays inside the viewport and does not cover the active mark`, async () => {\n    72\t      const page = await devPage({ css: 'body { margin: 0; } #chart { width: 100vw; height: 100vh; }' });\n    73\t      await create(page, type);\n    74\t      const viewport = page.viewportSize()!;\n    75\t      const failures: string[] = [];\n    76\t      for (const probe of await probes(page, type)) {\n    77\t        // From outside the chart each time, so the last tooltip is not what the pointer lands on.\n    78\t        await page.mouse.move(0, 0);\n    79\t        await settle(page);\n    80\t        await page.mouse.move(probe.x, probe.y);\n    81\t        await settle(page);\n    82\t        // The tooltip, or where it cannot fit, the fixed readout under the plot (spec I1).\n    83\t        const surface = (await tooltip(page).isVisible()) ? '#chart .axylo-tooltip' : (await page.locator('#chart .axylo-readout').isVisible()) ? '#chart .axylo-readout' : null;\n    84\t        if (!surface) { failures.push(`${probe.x},${probe.y}: no tooltip and no readout`); continue; }\n    85\t        const text = (await page.locator(surface).textContent()) ?? '';\n    86\t        if (!says(text, probe)) failures.push(`${probe.x},${probe.y}: \"${text}\" lacks ${JSON.stringify(probe.expect)}`);\n    87\t        const t = await box(page, surface);\n    88\t        if (t.x < 0 || t.y < 0 || t.x + t.width > viewport.width || t.y + t.height > viewport.height) failures.push(`${probe.x},${probe.y}: outside the viewport`);\n    89\t        for (const m of probe.marks) {\n    90\t          // Bars: the top of the bar, where its value is read; markers whole.\n    91\t          const mark = type === 'bar' ? { x: m.x, y: m.y, width: m.width, height: Math.min(8, m.height) } : m;\n    92\t          if (intersects(t, mark, 0.5)) failures.push(`${probe.x},${probe.y}: covers the mark at ${Math.round(m.x)},${Math.round(m.y)}`);\n    93\t        }\n    94\t      }\n    95\t      expect(failures).toEqual([]);\n    96\t      expect(await closePage(page)).toEqual([]);\n    97\t    });\n    98\t\n    99\t    it(`I1 ${type}: the tooltip can itself be hovered without closing (reading: the pointer moves onto it in one step); Escape closes it until the pointer reaches a different datum`, async () => {\n   100\t      const page = await devPage();\n   101\t      await create(page, type);\n   102\t      const all = await probes(page, type);\n   103\t      const first = all.find(p => p.y > 0) ?? all[0]!;\n   104\t      const other = all.find(p => p.expect[0] !== first.expect[0])!;\n   105\t      await page.mouse.move(first.x, first.y);\n   106\t      await settle(page);\n   107\t      expect(await tooltip(page).isVisible()).toBe(true);\n   108\t      const t = await box(page, '#chart .axylo-tooltip');\n   109\t      // Onto the tooltip in one move (reading: WCAG 1.4.13 asks that the pointer can be put on the content;\n   110\t      // on a nearest-x chart the content follows a pointer that sweeps across the plot).\n   111\t      await page.mouse.move(t.x + t.width / 2, t.y + t.height / 2);\n   112\t      await settle(page);\n   113\t      expect(await tooltip(page).isVisible()).toBe(true);\n   114\t      await page.mouse.move(first.x, first.y, { steps: 4 });\n   115\t      await page.keyboard.press('Escape');\n   116\t      await settle(page);\n   117\t      expect(await tooltip(page).isVisible()).toBe(false);\n   118\t      await page.mouse.move(first.x + 1, first.y + 1);\n   119\t      await settle(page);\n   120\t      expect(await tooltip(page).isVisible()).toBe(false);\n   121\t      await page.mouse.move(other.x, other.y);\n   122\t      await settle(page);\n   123\t      expect(await tooltip(page).isVisible()).toBe(true);\n   124\t      expect(says((await tooltip(page).textContent()) ?? '', other)).toBe(true);\n   125\t      expect(await closePage(page)).toEqual([]);\n   126\t    });\n   127\t\n   128\t    if (type !== 'donut') {\n   129\t      it(`I1 ${type}: with ten series ${type === 'scatter' ? 'on one coincident point' : 'at one x'} the tooltip lists eight rows and \"+2 more\"; in a 260 px tile the same content appears in the fixed readout under the plot`, async () => {\n   130\t        const page = await devPage();\n   131\t        // Long names, so eight rows make a tooltip wider than the room on either side of the plot's middle.\n   132\t        const names = Array.from({ length: 10 }, (_, i) => `Region number ${i + 1}`);\n   133\t        const data = type === 'scatter'\n   134\t          ? names.map(s => ({ x: 5, y: 5, s })).concat([{ x: 1, y: 1, s: 'S1' }, { x: 9, y: 9, s: 'S1' }])\n   135\t          : names.flatMap((s, i) => ['A', 'B', 'C'].map((x, k) => ({ x, s, y: 10 + i + k })));\n   136\t        await createRaw(page, type, { title: 'Ten', data, x: 'x', y: 'y', series: 's' });\n   137\t        const p = await box(page, '#chart .axylo-proxy');\n   138\t        await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   139\t        await settle(page);\n   140\t        // Whichever surface shows the content (the tooltip, or the readout where it cannot fit).\n   141\t        const surface = (await tooltip(page).isVisible()) ? '#chart .axylo-tooltip' : '#chart .axylo-readout';\n   142\t        expect(await page.locator(`${surface} .axylo-tooltip-row:not(.axylo-tooltip-total)`).count()).toBe(8);\n   143\t        expect(((await page.locator(surface).textContent()) ?? '')).toContain('+2 more');\n   144\t        // A 260 px tile in a 280 px viewport: there is no room beside the marks for eight such rows. Tall, so\n   145\t        // the ten legend entries still leave a readable plot (spec L8).\n   146\t        await page.setViewportSize({ width: 280, height: 1000 });\n   147\t        await page.evaluate(() => Object.assign((document.querySelector('#chart') as HTMLElement).style, { width: '260px', height: '760px' }));\n   148\t        await settle(page);\n   149\t        const q = await box(page, '#chart .axylo-proxy');\n   150\t        await page.mouse.move(q.x + q.width / 2, q.y + q.height / 2);\n   151\t        await settle(page);\n   152\t        const readout = page.locator('#chart .axylo-readout');\n   153\t        expect(await readout.isVisible()).toBe(true);\n   154\t        expect(await tooltip(page).isVisible()).toBe(false);\n   155\t        const plot = await box(page, '#chart .axylo-plot');\n   156\t        const r = await box(page, '#chart .axylo-readout');\n   157\t        expect(r.y).toBeGreaterThanOrEqual(plot.y + plot.height - 1);\n   158\t        expect((await readout.textContent()) ?? '').toContain('+2 more');\n   159\t        expect(await closePage(page)).toEqual([]);\n   160\t      });\n   161\t    }\n   162\t  }\n   163\t\n   164\t  for (const type of ['line', 'area', 'bar'] as const) {\n   165\t    it(`I1 ${type}: a series with no row at the pointed x reads \"No observation\", distinct from \"No data\" for an explicit null`, async () => {\n   166\t      const page = await devPage();\n   167\t      // B has no row at the second x and a null at the third. The x values are irregular numbers (categories\n   168\t      // for the bar), so no absent step is turned into a gap (spec F2, AX105) and the absent row stays one.\n   169\t      const xs = type === 'bar' ? ['a', 'b', 'c', 'd'] : [1, 2, 5, 9];\n   170\t      const data = [\n   171\t        ...xs.map((x, i) => ({ x, s: 'A', y: i + 1 })),\n   172\t        { x: xs[0], s: 'B', y: 5 }, { x: xs[2], s: 'B', y: null }, { x: xs[3], s: 'B', y: 6 },\n   173\t      ];\n   174\t      await createRaw(page, type, { title: 'Sparse', data, x: 'x', y: 'y', series: 's' });\n   175\t      // Where each x is drawn: the centres of A's marks (A has a row at every x).\n   176\t      const centres = ((await shapes(page, '#chart', type === 'bar' ? 100000 : 14))[1] ?? []).map(m => center(m.box)).sort((a, b) => a.x - b.x);\n   177\t      expect(centres).toHaveLength(4);\n   178\t      const p = await box(page, '#chart .axylo-proxy');\n   179\t      const at = async (i: number) => {\n   180\t        await page.mouse.move(0, 0);\n   181\t        await settle(page);\n   182\t        await page.mouse.move(centres[i]!.x, p.y + p.height / 2);\n   183\t        await settle(page);\n   184\t        return (await tooltip(page).textContent()) ?? '';\n   185\t      };\n   186\t      const second = await at(1);\n   187\t      expect(inOrder(second, ['B', 'No observation']), second).toBe(true);\n   188\t      expect(second).not.toContain('No data');\n   189\t      const third = await at(2);\n   190\t      expect(inOrder(third, ['B', 'No data']), third).toBe(true);\n   191\t      expect(await closePage(page)).toEqual([]);\n   192\t    });\n   193\t  }\n   194\t});\n   195\t\n   196\t// ── I2 ────────────────────────────────────────────────────────────────────────────────────────────\n   197\t\n   198\tdescribe('I2 legend toggles', () => {\n   199\t  for (const type of CARTESIAN as ('line' | 'area' | 'bar' | 'scatter')[]) {\n   200\t    it(`I2 ${type}: legend entries are toggle buttons with a pressed state, operable by click, Enter and Space; the marks follow`, async () => {\n   201\t      const page = await devPage();\n   202\t      await create(page, type);\n   203\t      const name = type === 'bar' ? 'Plan' : type === 'scatter' ? 'EU' : 'North';\n   204\t      const pressed = async () => (await axWithin(page, '#chart')).find(n => n.role === 'button' && n.name === name)?.props.pressed;\n   205\t      const marks = async () => (await shapes(page, '#chart', 100000))[1]?.length ?? 0;\n   206\t      expect(await pressed()).toBe('true');\n   207\t      const shown = await marks();\n   208\t      expect(shown).toBeGreaterThan(0);\n   209\t      await page.locator('#chart .axylo-legend-entry', { hasText: name }).click();\n   210\t      await settle(page);\n   211\t      expect(await pressed()).toBe('false');\n   212\t      expect(await marks()).toBe(0);\n   213\t      await page.locator('#chart .axylo-legend-entry', { hasText: name }).focus();\n   214\t      await page.keyboard.press('Enter');\n   215\t      await settle(page);\n   216\t      expect(await pressed()).toBe('true');\n   217\t      expect(await marks()).toBe(shown);\n   218\t      await page.keyboard.press(' ');\n   219\t      await settle(page);\n   220\t      expect(await pressed()).toBe('false');\n   221\t      expect(await closePage(page)).toEqual([]);\n   222\t    });\n   223\t  }\n   224\t});\n   225\t\n   226\t// ── I3 ────────────────────────────────────────────────────────────────────────────────────────────\n   227\t\n   228\ttype Zoomable = 'line' | 'area' | 'bar' | 'scatter';\n   229\t/** A chart whose x can zoom: the bar uses a date x (spec 3.6: on time, date and numeric x only). */\n   230\tasync function zoomable(page: Page, type: Zoomable): Promise<void> {\n   231\t  if (type === 'bar') {\n   232\t    const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n   233\t    await createRaw(page, 'bar', { title: 'Daily', data: Array.from({ length: 40 }, (_, k) => ({ day: day(k), v: 10 + (k % 7) })), x: { field: 'day', type: 'date' }, y: 'v' });\n   234\t  } else if (type === 'scatter') {\n   235\t    await createRaw(page, 'scatter', { title: 'Points', data: Array.from({ length: 40 }, (_, k) => ({ x: k, y: (k * 7) % 13 })), x: 'x', y: 'y' });\n   236\t  } else {\n   237\t    await createRaw(page, type, { title: 'Numbers', data: Array.from({ length: 40 }, (_, k) => ({ x: k, y: 10 + (k % 7) })), x: 'x', y: 'y' });\n   238\t  }\n   239\t}\n   240\tconst xDomain = (page: Page) => page.evaluate(() => (window as unknown as { charts: { __bench: { describe(): { xDomain: number[] } } }[] }).charts[0]!.__bench.describe().xDomain);\n   241\tconst width = (d: number[]) => d[1]! - d[0]!;\n   242\t\n   243\tdescribe('I3 zoom four ways', () => {\n   244\t  for (const type of ['line', 'area', 'bar', 'scatter'] as Zoomable[]) {\n   245\t    it(`I3 ${type}: the last quarter of the x range is reached by single clicks only: Zoom in twice, then Pan right, and Reset returns`, async () => {\n   246\t      const page = await devPage();\n   247\t      await zoomable(page, type);\n   248\t      const full = await xDomain(page);\n   249\t      const button = (label: string) => page.locator('#chart [role=\"toolbar\"] button', { hasText: label });\n   250\t      await button('Zoom in').click();\n   251\t      await settle(page);\n   252\t      await button('Zoom in').click();\n   253\t      await settle(page);\n   254\t      expect(width(await xDomain(page))).toBeCloseTo(width(full) / 4, 0);\n   255\t      // Single-click panning (WCAG 2.5.7): a visible control moves the window without dragging.\n   256\t      expect(await button('Pan right').count()).toBe(1);\n   257\t      for (let i = 0; i < 20 && (await xDomain(page))[1]! < full[1]! - 1e-9; i++) { await button('Pan right').click(); await settle(page); }\n   258\t      const end = await xDomain(page);\n   259\t      expect(end[1]).toBeCloseTo(full[1]!, 5);\n   260\t      await button('Reset zoom').click();\n   261\t      await settle(page);\n   262\t      expect(await xDomain(page)).toEqual(full);\n   263\t      expect(await closePage(page)).toEqual([]);\n   264\t    });\n   265\t\n","exit_code":0,"status":"completed"}}
