{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/browser/acceptance/a5-not-colour-alone.browser.test.ts && nl -ba packages/axylo/test/browser/acceptance/vision.ts'","aggregated_output":"     1\t/**\n     2\t * A5: series are never distinguished by colour alone, in any mode (spec 3.4). Shape markers on lines and\n     3\t * areas (last point and sparse intervals), repeated in legend and tooltip; dash under more contrast and\n     4\t * forced colours; at least 1 px of background between adjacent filled marks; the palette's contrast and\n     5\t * OKLab distances measured on the colours Chrome resolved for the rendered marks; AX141 on a background the\n     6\t * palette does not suit; and a grayscale screenshot in which three crossing lines are told apart by marker.\n     7\t * Colours are never hard-coded: they are read from the page.\n     8\t */\n     9\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n    10\timport type { Page } from 'playwright-core';\n    11\timport { start, stop } from '../harness';\n    12\timport {\n    13\t  backgroundColor, box, center, defaultBackground, ring, closePage, contrast, createRaw, create, devPage, distance, pixel, screenshot, seriesColors, settle, shapes, signature,\n    14\t  type Image, type RGB, type Shape,\n    15\t} from './util';\n    16\timport { TYPES, type ChartType } from './fixtures';\n    17\timport { gray, minimumDistance, VISIONS } from './vision';\n    18\t\n    19\tbeforeAll(start);\n    20\tafterAll(stop);\n    21\t\n    22\t/** 120 calendar days, three series: denser than a marker per point allows (spec L5), so markers are sparse. */\n    23\tfunction denseRows(): Record<string, unknown>[] {\n    24\t  const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n    25\t  const f = [(k: number) => 50 + 30 * Math.sin(k / 9), (k: number) => 50 + 30 * Math.cos(k / 11), (k: number) => 20 + k / 4];\n    26\t  return ['Alpha', 'Beta', 'Gamma'].flatMap((s, i) => Array.from({ length: 120 }, (_, k) => ({ day: day(k), s, v: Math.round(f[i]!(k)) })));\n    27\t}\n    28\t\n    29\t/** The last vertex of each stroked line, per colour slot, in viewport px. */\n    30\tasync function lastVertices(page: Page): Promise<Record<number, { x: number; y: number }>> {\n    31\t  return page.evaluate(() => {\n    32\t    const svg = document.querySelector('#chart svg.axylo-svg') as SVGSVGElement;\n    33\t    const m = svg.getScreenCTM()!;\n    34\t    const out: Record<number, { x: number; y: number }> = {};\n    35\t    for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) {\n    36\t      const slot = /--axylo-series-color-(\\d+)/.exec(el.style.getPropertyValue('color'));\n    37\t      if (!slot || el.style.getPropertyValue('stroke') !== 'currentcolor') continue;\n    38\t      const nums = (el.getAttribute('d') ?? '').match(/-?\\d*\\.?\\d+/g)!.map(Number);\n    39\t      let best = { x: -Infinity, y: 0 };\n    40\t      for (let i = 0; i + 1 < nums.length; i += 2) if (nums[i]! > best.x) best = { x: nums[i]!, y: nums[i + 1]! };\n    41\t      const p = new DOMPoint(best.x, best.y).matrixTransform(m);\n    42\t      out[Number(slot[1])] = { x: p.x, y: p.y };\n    43\t    }\n    44\t    return out;\n    45\t  });\n    46\t}\n    47\t\n    48\t/** The marker signatures in the legend (in entry order) and in the tooltip rows (in row order). */\n    49\tasync function swatchSignatures(page: Page, where: '.axylo-legend-entry' | '.axylo-tooltip-row'): Promise<string[]> {\n    50\t  const ds = await page.locator(`#chart ${where}`).evaluateAll(els => els.map(e => e.querySelector('.axylo-swatch-marker')?.getAttribute('d') ?? ''));\n    51\t  return ds.map(d => (d ? signature(d.split(/(?=M)/)[0]!) : ''));\n    52\t}\n    53\t\n    54\tconst mostCommon = (list: Shape[]): string => {\n    55\t  const n = new Map<string, number>();\n    56\t  for (const s of list) n.set(signature(s.sub), (n.get(signature(s.sub)) ?? 0) + 1);\n    57\t  return [...n.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] ?? '';\n    58\t};\n    59\t\n    60\tdescribe('A5 markers repeat the series identity', () => {\n    61\t  for (const type of ['line', 'area'] as const) {\n    62\t    it(`A5 ${type}: each of three dense series carries a shape marker at its last point and at sparse intervals; the shapes differ by series and are repeated in the legend and the tooltip`, async () => {\n    63\t      const page = await devPage();\n    64\t      await createRaw(page, type, { title: 'Dense', data: denseRows(), x: { field: 'day', type: 'date' }, y: 'v', series: 's' });\n    65\t      const drawn = await shapes(page, '#chart', 14);\n    66\t      const ends = await lastVertices(page);\n    67\t      const plotSigs: string[] = [];\n    68\t      for (const slot of [1, 2, 3]) {\n    69\t        const marks = drawn[slot] ?? [];\n    70\t        // The last point, plus at least one more at an interval along the series.\n    71\t        expect(marks.length, `markers of series ${slot}`).toBeGreaterThanOrEqual(2);\n    72\t        const last = marks.map(m => center(m.box)).sort((a, b) => b.x - a.x)[0]!;\n    73\t        expect(Math.abs(last.x - ends[slot]!.x), `series ${slot} last marker x`).toBeLessThanOrEqual(3);\n    74\t        expect(Math.abs(last.y - ends[slot]!.y), `series ${slot} last marker y`).toBeLessThanOrEqual(3);\n    75\t        // Sparse: fewer markers than points (120), spread over the series rather than bunched at its end.\n    76\t        expect(marks.length).toBeLessThan(120);\n    77\t        const xs = marks.map(m => center(m.box).x);\n    78\t        expect(Math.max(...xs) - Math.min(...xs)).toBeGreaterThan((await box(page, '#chart .axylo-proxy')).width / 3);\n    79\t        plotSigs.push(mostCommon(marks));\n    80\t      }\n    81\t      expect(new Set(plotSigs).size, JSON.stringify(plotSigs)).toBe(3);\n    82\t      expect(await swatchSignatures(page, '.axylo-legend-entry')).toEqual(plotSigs);\n    83\t      const plot = await box(page, '#chart .axylo-proxy');\n    84\t      await page.mouse.move(plot.x + plot.width / 2, plot.y + plot.height / 2);\n    85\t      await settle(page);\n    86\t      expect(await swatchSignatures(page, '.axylo-tooltip-row')).toEqual(plotSigs);\n    87\t      expect(await closePage(page)).toEqual([]);\n    88\t    });\n    89\t  }\n    90\t\n    91\t  it('A5 scatter: each series is drawn with its own point shape, repeated in the legend and in the tooltip of each point', async () => {\n    92\t    const page = await devPage();\n    93\t    await create(page, 'scatter');\n    94\t    const drawn = await shapes(page, '#chart', 14);\n    95\t    const sigs = [mostCommon(drawn[1] ?? []), mostCommon(drawn[2] ?? [])];\n    96\t    expect(sigs[0]).not.toBe('');\n    97\t    expect(sigs[0]).not.toBe(sigs[1]);\n    98\t    expect(await swatchSignatures(page, '.axylo-legend-entry')).toEqual(sigs);\n    99\t    for (const slot of [1, 2]) {\n   100\t      // Hover the middle point of the series (the ends sit on the plot edge).\n   101\t      const marks = (drawn[slot] ?? []).map(s => center(s.box)).sort((a, b) => a.x - b.x);\n   102\t      const p = marks[1]!;\n   103\t      await page.mouse.move(p.x, p.y);\n   104\t      await settle(page);\n   105\t      const tip = await swatchSignatures(page, '.axylo-tooltip-row');\n   106\t      expect(tip.length).toBeGreaterThan(0);\n   107\t      expect(tip[0]).toBe(sigs[slot - 1]);\n   108\t    }\n   109\t    expect(await closePage(page)).toEqual([]);\n   110\t  });\n   111\t\n   112\t  it('A5 compact: two compact series differ by dash as well as colour, with no legend to tell them apart', async () => {\n   113\t    const page = await devPage({ css: '#chart { width: 240px; height: 48px; }' });\n   114\t    await createRaw(page, 'line', { compact: true, title: 'Two', data: denseRows().filter(r => r.s !== 'Gamma'), x: { field: 'day', type: 'date' }, y: 'v', series: 's' });\n   115\t    const dashes = await strokeDashes(page);\n   116\t    expect(dashes).toHaveLength(2);\n   117\t    expect(dashes[0]).not.toBe(dashes[1]);\n   118\t    expect(await closePage(page)).toEqual([]);\n   119\t  });\n   120\t});\n   121\t\n   122\t/** The computed dash of each stroked series line, in slot order. */\n   123\tasync function strokeDashes(page: Page, selector = '#chart'): Promise<string[]> {\n   124\t  return page.evaluate(selector => {\n   125\t    const out: [number, string][] = [];\n   126\t    for (const el of document.querySelectorAll<SVGPathElement>(`${selector} svg.axylo-svg .axylo-scene path`)) {\n   127\t      const slot = /--axylo-series-color-(\\d+)/.exec(el.style.getPropertyValue('color'));\n   128\t      if (!slot || el.style.getPropertyValue('stroke') !== 'currentcolor') continue;\n   129\t      out.push([Number(slot[1]), getComputedStyle(el).strokeDasharray]);\n   130\t    }\n   131\t    return out.sort((a, b) => a[0] - b[0]).map(e => e[1]);\n   132\t  }, selector);\n   133\t}\n   134\t\n   135\tdescribe('A5 dash under more contrast and forced colours', () => {\n   136\t  for (const type of ['line', 'area', 'compact'] as const) {\n   137\t    for (const mode of ['prefers-contrast: more', 'forced-colors: active'] as const) {\n   138\t      it(`A5 ${type}: under ${mode} three lines differ by dash, pairwise`, async () => {\n   139\t        const page = await devPage(type === 'compact' ? { css: '#chart { width: 240px; height: 48px; }' } : {});\n   140\t        await page.emulateMedia(mode === 'prefers-contrast: more' ? { contrast: 'more' } : { forcedColors: 'active' });\n   141\t        await createRaw(page, 'line' === type || type === 'compact' ? 'line' : 'area', {\n   142\t          title: 'Three', data: denseRows(), x: { field: 'day', type: 'date' }, y: 'v', series: 's', ...(type === 'compact' ? { compact: true } : {}),\n   143\t        });\n   144\t        const dashes = await strokeDashes(page);\n   145\t        expect(dashes).toHaveLength(3);\n   146\t        expect(new Set(dashes).size, JSON.stringify(dashes)).toBe(3);\n   147\t        expect(await closePage(page)).toEqual([]);\n   148\t      });\n   149\t    }\n   150\t  }\n   151\t});\n   152\t\n   153\t// ── separators between adjacent filled marks ──────────────────────────────────────────────────────\n   154\t\n   155\t/**\n   156\t * Walks `points` (image px) and, wherever the colour changes from one mark colour to another, sums how\n   157\t * much background the pixels in between show (reading of \"at least 1 px of background\" on an anti-aliased\n   158\t * raster: the background coverage of the pixels between two marks adds up to at least 0.75 px, which a\n   159\t * 1 px gap at any sub-pixel offset meets and two touching marks do not). A pixel's background coverage is\n   160\t * its projection onto the line from the nearest mark colour to the background.\n   161\t */\n   162\tfunction separated(img: Image, points: { x: number; y: number }[], colors: readonly RGB[], bg: RGB, tolerance = 24): { transitions: number; touching: number; at: { x: number; y: number; coverage: number }[] } {\n   163\t  const nearest = (c: RGB): { k: number; d: number } => {\n   164\t    let best = { k: -1, d: Infinity };\n   165\t    colors.forEach((m, k) => { const d = distance(c, m); if (d < best.d) best = { k, d }; });\n   166\t    return best;\n   167\t  };\n   168\t  let last = -1, coverage = 0, transitions = 0, touching = 0;\n   169\t  const at: { x: number; y: number; coverage: number }[] = [];\n   170\t  let prev = '';\n   171\t  for (const p of points) {\n   172\t    if (p.x < 0 || p.y < 0 || p.x >= img.width || p.y >= img.height) continue;\n   173\t    const key = `${Math.floor(p.x)},${Math.floor(p.y)}`;\n   174\t    if (key === prev) continue;\n   175\t    prev = key;\n   176\t    const c = pixel(img, p.x, p.y);\n   177\t    const n = nearest(c);\n   178\t    if (n.d <= tolerance) {\n   179\t      if (last >= 0 && n.k !== last) {\n   180\t        transitions++;\n   181\t        if (coverage < 0.75) { touching++; at.push({ ...p, coverage }); }\n   182\t      }\n   183\t      last = n.k;\n   184\t      coverage = 0;\n   185\t      continue;\n   186\t    }\n   187\t    const m = colors[n.k]!;\n   188\t    const w = [bg[0] - m[0], bg[1] - m[1], bg[2] - m[2]];\n   189\t    const q = [c[0] - m[0], c[1] - m[1], c[2] - m[2]];\n   190\t    const len = w[0]! * w[0]! + w[1]! * w[1]! + w[2]! * w[2]! || 1;\n   191\t    coverage += Math.min(1, Math.max(0, (q[0]! * w[0]! + q[1]! * w[1]! + q[2]! * w[2]!) / len));\n   192\t  }\n   193\t  return { transitions, touching, at };\n   194\t}\n   195\t\n   196\tconst vertical = (x: number, y0: number, y1: number) => Array.from({ length: Math.ceil(y1 - y0) }, (_, i) => ({ x, y: y0 + i }));\n   197\tconst horizontal = (y: number, x0: number, x1: number) => Array.from({ length: Math.ceil(x1 - x0) }, (_, i) => ({ x: x0 + i, y }));\n   198\t\n   199\tdescribe('A5 separators', () => {\n   200\t  it('A5 bar: stacked segments are separated by at least 1 px of background, in every stack (reading: anti-aliased background coverage summed, at least 0.75 px)', async () => {\n   201\t    const page = await devPage();\n   202\t    await create(page, 'bar', { layout: 'stacked' });\n   203\t    const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n   204\t    const colors = await seriesColors(page);\n   205\t    const bg = await backgroundColor(page);\n   206\t    const drawn = await shapes(page, '#chart', 100000);\n   207\t    const stacks = (drawn[1] ?? []).map(s => s.box);\n   208\t    expect(stacks).toHaveLength(4);\n   209\t    // Geometry first: the segment above starts at least 1 px above where the one below ends.\n   210\t    const above = (drawn[2] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n   211\t    [...stacks].sort((a, b) => a.x - b.x).forEach((below, i) => expect(below.y - (above[i]!.y + above[i]!.height), `stack ${i + 1} gap`).toBeGreaterThanOrEqual(1 - 0.01));\n   212\t    for (const s of stacks) {\n   213\t      const x = Math.round(s.x + s.width / 2 - plot.x);\n   214\t      const r = separated(img, vertical(x, 0, img.height), colors, bg);\n   215\t      expect(r.transitions, `stack at ${x}`).toBeGreaterThanOrEqual(1);\n   216\t      expect(r.touching, `stack at ${x}: ${JSON.stringify(r.at)}`).toBe(0);\n   217\t    }\n   218\t    expect(await closePage(page)).toEqual([]);\n   219\t  });\n   220\t\n   221\t  it('A5 bar: grouped bars of different series are separated by at least 1 px of background (reading: two touching bars are adjacent filled marks)', async () => {\n   222\t    const page = await devPage();\n   223\t    await create(page, 'bar');\n   224\t    const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n   225\t    const colors = await seriesColors(page);\n   226\t    const bg = await backgroundColor(page);\n   227\t    const drawn = await shapes(page, '#chart', 100000);\n   228\t    const plan = (drawn[1] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n   229\t    const actual = (drawn[2] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n   230\t    expect(plan).toHaveLength(4);\n   231\t    for (let i = 0; i < 4; i++) {\n   232\t      // Just above the baseline, where both bars of the group are drawn.\n   233\t      const y = Math.round(Math.min(plan[i]!.y + plan[i]!.height, actual[i]!.y + actual[i]!.height) - plot.y - 3);\n   234\t      const r = separated(img, horizontal(y, plan[i]!.x - plot.x, actual[i]!.x + actual[i]!.width - plot.x), colors, bg);\n   235\t      expect(r.transitions).toBe(1);\n   236\t      expect(r.touching, `group ${i + 1}: ${JSON.stringify(r.at)}`).toBe(0);\n   237\t    }\n   238\t    expect(await closePage(page)).toEqual([]);\n   239\t  });\n   240\t\n   241\t  it('A5 area: stacked areas are separated by at least 1 px of background along a vertical through the stack (reading: stacked areas are stacked segments)', async () => {\n   242\t    const page = await devPage();\n   243\t    await create(page, 'area', {}, '#chart', 'stacked');\n   244\t    const { img } = await screenshot(page, '#chart .axylo-plot');\n   245\t    const colors = await seriesColors(page);\n   246\t    const bg = await backgroundColor(page);\n   247\t    const plot = await box(page, '#chart .axylo-proxy');\n   248\t    const plotBox = await box(page, '#chart .axylo-plot');\n   249\t    for (const share of [0.3, 0.5, 0.7]) {\n   250\t      const x = Math.round(plot.x - plotBox.x + plot.width * share);\n   251\t      const r = separated(img, vertical(x, plot.y - plotBox.y, plot.y - plotBox.y + plot.height), colors, bg);\n   252\t      expect(r.transitions).toBeGreaterThanOrEqual(1);\n   253\t      expect(r.touching, `x at ${share}`).toBe(0);\n   254\t    }\n   255\t    expect(await closePage(page)).toEqual([]);\n   256\t  });\n   257\t\n   258\t  it('A5 donut: adjacent slices are separated by at least 1 px of background at every boundary of the ring (reading: anti-aliased background coverage summed, at least 0.75 px)', async () => {\n   259\t    const page = await devPage();\n   260\t    await create(page, 'donut');\n   261\t    const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n   262\t    const colors = await seriesColors(page);\n   263\t    const bg = await backgroundColor(page);\n   264\t    const g = await ring(page);\n   265\t    const cx = g.cx - plot.x, cy = g.cy - plot.y, outer = g.outer;\n   266\t    // Around the ring at 85 % of the outer radius, one point per 1/8 px of arc.\n   267\t    const r = outer * 0.85;\n   268\t    const n = Math.ceil(2 * Math.PI * r * 8);\n   269\t    const path = Array.from({ length: n + 1 }, (_, i) => {\n   270\t      const a = (i / n) * 2 * Math.PI;\n   271\t      return { x: Math.round(cx + r * Math.sin(a)), y: Math.round(cy - r * Math.cos(a)) };\n   272\t    });\n   273\t    const result = separated(img, path, colors, bg);\n   274\t    expect(result.transitions).toBeGreaterThanOrEqual(3);\n   275\t    expect(result.touching, JSON.stringify(result.at)).toBe(0);\n   276\t    expect(await closePage(page)).toEqual([]);\n   277\t  });\n   278\t});\n   279\t\n   280\t// ── palette ───────────────────────────────────────────────────────────────────────────────────────\n   281\t\n   282\t/** Eight series (or slices) of the type, so the whole default palette is drawn. */\n   283\tfunction eight(type: ChartType): { fn: string; options: Record<string, unknown> } {\n   284\t  const names = ['S1', 'S2', 'S3', 'S4', 'S5', 'S6', 'S7', 'S8'];\n   285\t  if (type === 'donut') return { fn: 'donut', options: { title: 'Eight', data: names.map((n, i) => ({ n, v: 10 + i })), label: 'n', value: 'v' } };\n   286\t  if (type === 'scatter') return { fn: 'scatter', options: { title: 'Eight', data: names.flatMap((s, i) => [1, 2, 3].map(x => ({ x: x + i / 10, y: i + x, s }))), x: 'x', y: 'y', series: 's' } };\n   287\t  const data = names.flatMap((s, i) => ['A', 'B', 'C'].map((x, k) => ({ x, s, y: 10 + i + k })));\n   288\t  return { fn: type === 'compact' ? 'line' : type, options: { title: 'Eight', data, x: 'x', y: 'y', series: 's', ...(type === 'compact' ? { compact: true } : {}) } };\n   289\t}\n   290\t\n   291\tdescribe('A5 palette', () => {\n   292\t  for (const type of TYPES) {\n   293\t    for (const scheme of ['light', 'dark'] as const) {\n   294\t      it(`A5 ${type}: the eight rendered colours (${scheme} scheme) are each at least 3:1 on the background and at least 0.10 apart in OKLab under normal vision and simulated protanopia, deuteranopia and tritanopia`, async () => {\n   295\t        const page = await devPage({ css: scheme === 'dark' ? '#chart { color-scheme: dark; }' : '' });\n   296\t        const { fn, options } = eight(type);\n   297\t        await createRaw(page, fn, options);\n   298\t        const colors = await seriesColors(page);\n   299\t        expect(colors).toHaveLength(8);\n   300\t        // The default background of the scheme the chart resolved (spec A5: \"the default light and dark backgrounds\").\n   301\t        const bg = await defaultBackground(page);\n   302\t        colors.forEach((c, i) => expect(contrast(c, bg), `series ${i + 1} ${c} on ${bg}`).toBeGreaterThanOrEqual(3));\n   303\t        for (const vision of VISIONS) {\n   304\t          const m = minimumDistance(colors, vision);\n   305\t          expect(m.distance, `${vision}: series ${m.pair[0] + 1} and ${m.pair[1] + 1}`).toBeGreaterThanOrEqual(0.1);\n   306\t        }\n   307\t        expect(await closePage(page)).toEqual([]);\n   308\t      });\n   309\t    }\n   310\t\n   311\t    it(`A5 ${type}: on a background the palette does not suit (the first series colour itself), AX141 is raised`, async () => {\n   312\t      const page = await devPage();\n   313\t      const { fn, options } = eight(type);\n   314\t      await createRaw(page, fn, options);\n   315\t      const [first] = await seriesColors(page);\n   316\t      await page.evaluate(([r, g, b]) => (document.querySelector('#chart') as HTMLElement).style.setProperty('--axylo-background', `rgb(${r}, ${g}, ${b})`), first!);\n   317\t      await settle(page);\n   318\t      const codes = await page.evaluate(() => (window as unknown as { charts: { diagnostics: { code: string }[] }[] }).charts[0]!.diagnostics.map(d => d.code));\n   319\t      expect(codes).toContain('AX141');\n   320\t      expect(await closePage(page)).toEqual([]);\n   321\t    });\n   322\t  }\n   323\t});\n   324\t\n   325\t// ── grayscale ─────────────────────────────────────────────────────────────────────────────────────\n   326\t\n   327\tdescribe('A5 grayscale', () => {\n   328\t  it('A5 line: in a grayscale screenshot three crossing lines are told apart by the marker at their last point (reading: the binarised markers, compared at their centres, overlap by at most 85 % of their union)', async () => {\n   329\t    const page = await devPage({ deviceScaleFactor: 2 });\n   330\t    // The lines cross in the middle; the last step rises by 10 on all three, so each marker is reached by\n   331\t    // the same stroke and only the marker can differ.\n   332\t    const values = { A: [10, 20, 40, 60, 70, 75, 78, 80, 90], B: [50, 50, 50, 50, 50, 50, 45, 40, 50], C: [90, 80, 60, 40, 20, 10, 5, 0, 10] };\n   333\t    const data = Object.entries(values).flatMap(([s, v]) => v.map((y, x) => ({ x, s, y })));\n   334\t    await createRaw(page, 'line', { title: 'Crossing', data, x: 'x', y: 'y', series: 's' });\n   335\t    const { img, box: plotBox } = await screenshot(page, '#chart .axylo-plot');\n   336\t    const scale = img.width / plotBox.width;\n   337\t    const bgGray = gray(await backgroundColor(page));\n   338\t    const drawn = await shapes(page, '#chart', 14);\n   339\t    const masks: boolean[][] = [];\n   340\t    const R = Math.round(8 * scale);\n   341\t    for (const slot of [1, 2, 3]) {\n   342\t      const last = (drawn[slot] ?? []).map(s => center(s.box)).sort((a, b) => b.x - a.x)[0];\n   343\t      expect(last, `marker of series ${slot}`).toBeDefined();\n   344\t      const cx = Math.round((last!.x - plotBox.x) * scale), cy = Math.round((last!.y - plotBox.y) * scale);\n   345\t      const mask: boolean[] = [];\n   346\t      for (let dy = -R; dy <= R; dy++) for (let dx = -R; dx <= R; dx++) mask.push(Math.abs(gray(pixel(img, cx + dx, cy + dy)) - bgGray) > 40);\n   347\t      masks.push(mask);\n   348\t    }\n   349\t    for (let i = 0; i < 3; i++) {\n   350\t      for (let j = i + 1; j < 3; j++) {\n   351\t        let both = 0, either = 0;\n   352\t        masks[i]!.forEach((v, k) => { if (v && masks[j]![k]) both++; if (v || masks[j]![k]) either++; });\n   353\t        expect(both / either, `series ${i + 1} and ${j + 1}`).toBeLessThanOrEqual(0.85);\n   354\t      }\n   355\t    }\n   356\t    expect(await closePage(page)).toEqual([]);\n   357\t  });\n   358\t});\n     1\t/**\n     2\t * Colour measures for A5, the suite's own code: OKLab (Ottosson), and colour-vision simulation by\n     3\t * Machado, Oliveira and Fernandes 2009 at severity 1.0 in linear RGB, clamped (the method decision 0003 and\n     4\t * research/harness/palette.mjs name). Inputs are the sRGB bytes Chrome resolved for the rendered marks.\n     5\t */\n     6\timport type { RGB } from './util';\n     7\t\n     8\texport type Vision = 'normal' | 'protan' | 'deutan' | 'tritan';\n     9\ttype Vec3 = readonly [number, number, number];\n    10\t\n    11\tconst MACHADO: Record<Vision, readonly Vec3[]> = {\n    12\t  normal: [[1, 0, 0], [0, 1, 0], [0, 0, 1]],\n    13\t  protan: [[0.152286, 1.052583, -0.204868], [0.114503, 0.786281, 0.099216], [-0.003882, -0.048116, 1.051998]],\n    14\t  deutan: [[0.367322, 0.860646, -0.227968], [0.280085, 0.672501, 0.047413], [-0.011820, 0.042940, 0.968881]],\n    15\t  tritan: [[1.255528, -0.076749, -0.178779], [-0.078411, 0.930809, 0.147602], [0.004733, 0.691367, 0.303900]],\n    16\t};\n    17\texport const VISIONS = Object.keys(MACHADO) as Vision[];\n    18\t\n    19\tconst lin = (v: number): number => (v <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);\n    20\tconst clamp = (v: number): number => Math.min(1, Math.max(0, v));\n    21\t\n    22\tfunction oklab([r, g, b]: Vec3): Vec3 {\n    23\t  const l = Math.cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b);\n    24\t  const m = Math.cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b);\n    25\t  const s = Math.cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b);\n    26\t  return [0.2104542553 * l + 0.793617785 * m - 0.0040720468 * s,\n    27\t    1.9779984951 * l - 2.428592205 * m + 0.4505937099 * s,\n    28\t    0.0259040371 * l + 0.7827717662 * m - 0.808675766 * s];\n    29\t}\n    30\t\n    31\t/** OKLab of a byte colour as seen with `vision`. */\n    32\texport function seen(rgb: RGB, vision: Vision): Vec3 {\n    33\t  const l = rgb.map(v => lin(v / 255)) as unknown as Vec3;\n    34\t  const M = MACHADO[vision];\n    35\t  return oklab([0, 1, 2].map(i => clamp(M[i]![0] * l[0] + M[i]![1] * l[1] + M[i]![2] * l[2])) as unknown as Vec3);\n    36\t}\n    37\t\n    38\texport const oklabDistance = (a: Vec3, b: Vec3): number => Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]);\n    39\t\n    40\t/** The smallest pairwise OKLab distance among `colors` seen with `vision`, and the pair. */\n    41\texport function minimumDistance(colors: readonly RGB[], vision: Vision): { distance: number; pair: [number, number] } {\n    42\t  let best = { distance: Infinity, pair: [0, 0] as [number, number] };\n    43\t  for (let i = 0; i < colors.length; i++) {\n    44\t    for (let j = i + 1; j < colors.length; j++) {\n    45\t      const d = oklabDistance(seen(colors[i]!, vision), seen(colors[j]!, vision));\n    46\t      if (d < best.distance) best = { distance: d, pair: [i, j] };\n    47\t    }\n    48\t  }\n    49\t  return best;\n    50\t}\n    51\t\n    52\t/** Rec. 709 luma of an sRGB byte colour, for a grayscale conversion of a screenshot. */\n    53\texport const gray = ([r, g, b]: RGB): number => 0.2126 * r + 0.7152 * g + 0.0722 * b;\n","exit_code":0,"status":"completed"}}
