{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc 'for f in l-legibility.browser.test.ts text.ts; do nl -ba packages/axylo/test/browser/acceptance/$f; done'","aggregated_output":"     1\t/**\n     2\t * Legibility, L1–L8 (spec 3.2), in Chrome after fonts load. Text boxes come from the rendered DOM (rotated\n     3\t * labels as rotated boxes); colours and contrast from what Chrome resolved; sizes from the layout.\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport type { Page } from 'playwright-core';\n     7\timport { start, stop } from '../harness';\n     8\timport {\n     9\t  axOf, axWithin, backgroundColor, box, call, center, closePage, contrast, create, createRaw, devPage, plotGeometry, resolveColors, seriesColors, settle, shapes, type RGB,\n    10\t} from './util';\n    11\timport { FULL, optionsFor, TYPES, type ChartType } from './fixtures';\n    12\timport { extent, overlaps, textBoxes } from './text';\n    13\t\n    14\tbeforeAll(start);\n    15\tafterAll(stop);\n    16\t\n    17\ttype Full = Exclude<ChartType, 'compact'>;\n    18\t\n    19\t/** Label-heavy data per type. `bars` and `parts` are the Phase 1 fixtures (research/harness/src/data.js). */\n    20\tfunction busy(type: Full): { fn: string; options: Record<string, unknown>; categories?: string[] } {\n    21\t  const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n    22\t  const names = ['Organic search', 'Direct', 'Referral partners'];\n    23\t  const series = names.flatMap((s, i) => Array.from({ length: 120 }, (_, k) => ({ day: day(k), s, v: 12000 + 3000 * i + 900 * Math.sin(k / 7 + i) })));\n    24\t  switch (type) {\n    25\t    case 'line': return { fn: 'line', options: { title: 'Daily sessions by channel', subtitle: 'All regions', data: series, x: { field: 'day', type: 'date' }, y: { field: 'v', label: 'Sessions' }, series: 's' } };\n    26\t    case 'area': return { fn: 'area', options: { title: 'Daily sessions by channel', data: series, x: { field: 'day', type: 'date' }, y: { field: 'v', label: 'Sessions' }, series: 's', stacked: true } };\n    27\t    case 'bar': {\n    28\t      const categories = ['Billing', 'Customer Success & Onboarding', 'Platform', 'Mobile', 'Data', 'Security', 'Sales Eng.'];\n    29\t      const values = [94, 88, 97, 82, 91, 85, 90];\n    30\t      return { fn: 'bar', categories, options: { title: 'Customer satisfaction by team', data: categories.map((team, i) => ({ team, satisfied: values[i] })), x: 'team', y: { field: 'satisfied', label: 'Satisfied', unit: '%' }, reference: [{ y: 90, label: 'Target' }] } };\n    31\t    }\n    32\t    case 'scatter': return { fn: 'scatter', options: { title: 'Latency by payload size', data: Array.from({ length: 60 }, (_, k) => ({ size: 100000 + k * 15000, latency: 1200 + ((k * 37) % 400), region: k % 2 ? 'Europe West' : 'North America East' })), x: { field: 'size', label: 'Payload', unit: 'B' }, y: { field: 'latency', label: 'Latency', unit: 'ms' }, series: 'region' } };\n    33\t    case 'donut': {\n    34\t      const labels = ['Chrome', 'Safari', 'Edge', 'Firefox', 'Samsung Internet', 'Other'];\n    35\t      const values = [46.2, 27.5, 14.1, 8.9, 2.1, 1.2];\n    36\t      return { fn: 'donut', options: { title: 'Sessions by browser', data: labels.map((browser, i) => ({ browser, share: values[i] })), label: 'browser', value: { field: 'share', label: 'Share', scale: 'percent' } } };\n    37\t    }\n    38\t  }\n    39\t}\n    40\t\n    41\tconst WIDTHS = [240, 320, 480, 720, 1280, 1920];\n    42\tconst CONDITIONS: Record<string, string> = {\n    43\t  'plain': '',\n    44\t  'WCAG 1.4.12 text spacing': '* { line-height: 1.5 !important; letter-spacing: 0.12em !important; word-spacing: 0.16em !important; } p { margin-bottom: 2em !important; }',\n    45\t  // Text-only zoom scales the text the page gives the chart, not the layout (reading: twice the inherited size).\n    46\t  '200 % text-only zoom': 'body { font-size: 28px !important; }',\n    47\t};\n    48\t\n    49\tasync function layoutProblems(page: Page, categories?: string[]): Promise<string[]> {\n    50\t  const problems: string[] = [];\n    51\t  const boxes = await textBoxes(page);\n    52\t  problems.push(...overlaps(boxes, 1).map(p => `overlap ${p}`));\n    53\t  const fig = await box(page, '#chart figure');\n    54\t  for (const b of boxes) {\n    55\t    const e = extent(b);\n    56\t    if (e.x0 < fig.x - 1 || e.y0 < fig.y - 1 || e.x1 > fig.x + fig.width + 1 || e.y1 > fig.y + fig.height + 1) problems.push(`outside the figure: \"${b.text}\"`);\n    57\t  }\n    58\t  for (const role of ['tick-x', 'tick-y']) {\n    59\t    const texts = boxes.filter(b => b.role === role).map(b => b.text);\n    60\t    const dupes = texts.filter((t, i) => texts.indexOf(t) !== i);\n    61\t    if (dupes.length) problems.push(`${role} labels not distinct: ${dupes.join(', ')}`);\n    62\t  }\n    63\t  if (categories) {\n    64\t    // Unordered categories may not be thinned: every one is shown, or the reader is told.\n    65\t    const shown = boxes.filter(b => b.role === 'tick-x').length;\n    66\t    const note = page.locator('#chart .axylo-note');\n    67\t    const told = (await note.isVisible()) && /labels hidden/i.test((await note.textContent()) ?? '');\n    68\t    if (shown < categories.length && !told) problems.push(`${categories.length - shown} category labels hidden without the note`);\n    69\t  }\n    70\t  return problems;\n    71\t}\n    72\t\n    73\tdescribe('L1 labels fit', () => {\n    74\t  for (const type of FULL as Full[]) {\n    75\t    for (const [condition, css] of Object.entries(CONDITIONS)) {\n    76\t      it(`L1 ${type}: at widths ${WIDTHS.join(', ')} px (${condition}) no text overlaps other text (1 px), none is outside the figure, tick labels are pairwise distinct, and no category label is hidden without the note`, async () => {\n    77\t        const page = await devPage({ viewport: { width: 2000, height: 900 }, css: `#chart { height: 360px; } ${css}` });\n    78\t        const d = busy(type);\n    79\t        await createRaw(page, d.fn, d.options);\n    80\t        await page.evaluate(() => document.fonts.ready);\n    81\t        const problems: string[] = [];\n    82\t        for (const width of WIDTHS) {\n    83\t          await page.evaluate(w => { (document.querySelector('#chart') as HTMLElement).style.width = `${w}px`; }, width);\n    84\t          await settle(page);\n    85\t          await settle(page);\n    86\t          problems.push(...(await layoutProblems(page, d.categories)).map(p => `${width} px: ${p}`));\n    87\t        }\n    88\t        expect(problems).toEqual([]);\n    89\t        expect(await closePage(page)).toEqual([]);\n    90\t      });\n    91\t    }\n    92\t  }\n    93\t});\n    94\t\n    95\t// ── L2 ────────────────────────────────────────────────────────────────────────────────────────────\n    96\t\n    97\tconst DARK_PAGE = 'html { color-scheme: dark; } body { background: #121212; color: #e8e8e8; }';\n    98\t\n    99\t/** Every visible text node's font size and contrast against the colour painted behind it. */\n   100\tasync function textContrast(page: Page): Promise<{ text: string; size: number; ratio: number }[]> {\n   101\t  const raw = await page.evaluate(() => {\n   102\t    const out: { text: string; size: number; color: string; bg: string }[] = [];\n   103\t    const walker = document.createTreeWalker(document.querySelector('#chart')!, NodeFilter.SHOW_TEXT);\n   104\t    const opaque = (c: string) => !!c && c !== 'transparent' && !/rgba\\(.*,\\s*0\\)$/.test(c);\n   105\t    for (let n = walker.nextNode(); n; n = walker.nextNode()) {\n   106\t      const el = n.parentElement!;\n   107\t      if (!n.textContent?.trim() || el.closest('[hidden], .axylo-visually-hidden, svg')) continue;\n   108\t      const s = getComputedStyle(el);\n   109\t      if (s.display === 'none' || s.visibility === 'hidden') continue;\n   110\t      let bg = 'rgb(255, 255, 255)';\n   111\t      for (let a: Element | null = el; a; a = a.parentElement) { const c = getComputedStyle(a).backgroundColor; if (opaque(c)) { bg = c; break; } }\n   112\t      out.push({ text: n.textContent.trim(), size: parseFloat(s.fontSize), color: s.color, bg });\n   113\t    }\n   114\t    return out;\n   115\t  });\n   116\t  const colors = await resolveColors(page, raw.flatMap(r => [r.color, r.bg]));\n   117\t  return raw.map((r, i) => ({ text: r.text, size: r.size, ratio: contrast(colors[2 * i]!, colors[2 * i + 1]!) }));\n   118\t}\n   119\t\n   120\t/** The resolved colours of the axis lines (the scene's rules painted with `--axylo-axis`). */\n   121\tasync function axisColors(page: Page): Promise<RGB[]> {\n   122\t  const css = await page.evaluate(() => [...document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene line')].filter(l => /--axylo-axis/.test(l.style.getPropertyValue('color'))).map(l => getComputedStyle(l).color));\n   123\t  return resolveColors(page, [...new Set(css)]);\n   124\t}\n   125\t\n   126\tdescribe('L2 text size and contrast', () => {\n   127\t  for (const type of TYPES) {\n   128\t    for (const scheme of ['light', 'dark'] as const) {\n   129\t      it(`L2 ${type}: in the ${scheme} scheme every text is at least 12 CSS px and 4.5:1 (legend entries of hidden series included); marks, axis lines and the focus indicator are at least 3:1`, async () => {\n   130\t        const page = await devPage({ css: scheme === 'dark' ? DARK_PAGE : '' });\n   131\t        await create(page, type, { subtitle: 'All sites' });\n   132\t        if (type !== 'compact' && type !== 'donut') {\n   133\t          await page.locator('#chart .axylo-legend-entry').first().click();\n   134\t          await settle(page);\n   135\t        }\n   136\t        const bad = (await textContrast(page)).filter(t => t.size < 12 || t.ratio < 4.5).map(t => `\"${t.text}\" ${t.size}px ${t.ratio.toFixed(2)}:1`);\n   137\t        expect(bad).toEqual([]);\n   138\t        const bg = await backgroundColor(page);\n   139\t        // A hidden series draws no marks, so the marks measured are those of the shown series.\n   140\t        for (const c of await seriesColors(page)) expect(contrast(c, bg), `mark ${c}`).toBeGreaterThanOrEqual(3);\n   141\t        if (type !== 'donut' && type !== 'compact') for (const c of await axisColors(page)) expect(contrast(c, bg), `axis ${c}`).toBeGreaterThanOrEqual(3);\n   142\t        if (type !== 'compact') {\n   143\t          await page.focus('#before');\n   144\t          await page.keyboard.press('Tab');\n   145\t          const ring = await page.locator('#chart .axylo-focus-ring').evaluate(el => getComputedStyle(el).outlineColor);\n   146\t          const [c] = await resolveColors(page, [ring]);\n   147\t          expect(contrast(c!, bg), 'focus indicator').toBeGreaterThanOrEqual(3);\n   148\t        }\n   149\t        expect(await closePage(page)).toEqual([]);\n   150\t      });\n   151\t    }\n   152\t  }\n   153\t});\n   154\t\n   155\t// ── L3 ────────────────────────────────────────────────────────────────────────────────────────────\n   156\t\n   157\tdescribe('L3 the chart follows its container', () => {\n   158\t  for (const type of FULL as Full[]) {\n   159\t    it(`L3 ${type}: resized 720 → 360 → 720 px with no call from the page, the figure follows in both directions`, async () => {\n   160\t      const page = await devPage();\n   161\t      await create(page, type);\n   162\t      const widths: number[] = [];\n   163\t      for (const w of [720, 360, 720]) {\n   164\t        await page.evaluate(w => { (document.querySelector('#chart') as HTMLElement).style.width = `${w}px`; }, w);\n   165\t        await settle(page);\n   166\t        widths.push(Math.round((await box(page, '#chart .axylo-plot')).width));\n   167\t        expect((await box(page, '#chart svg.axylo-svg')).width).toBeLessThanOrEqual(w + 0.5);\n   168\t      }\n   169\t      expect(widths[1]).toBeLessThan(widths[0]!);\n   170\t      expect(widths[2]).toBe(widths[0]);\n   171\t      expect(await closePage(page)).toEqual([]);\n   172\t    });\n   173\t\n   174\t    it(`L3 ${type}: with no definite height the plot is 16:9 of its width, clamped to 160–480 px, and stable over 10 frames`, async () => {\n   175\t      const page = await devPage({ viewport: { width: 1300, height: 1200 }, css: '#chart { height: auto; }' });\n   176\t      await create(page, type);\n   177\t      for (const w of [240, 720, 1200]) {\n   178\t        await page.evaluate(w => { (document.querySelector('#chart') as HTMLElement).style.width = `${w}px`; }, w);\n   179\t        await settle(page);\n   180\t        const heights: number[] = [];\n   181\t        for (let i = 0; i < 10; i++) {\n   182\t          heights.push((await box(page, '#chart .axylo-plot')).height);\n   183\t          await page.evaluate(() => new Promise(r => requestAnimationFrame(r)));\n   184\t        }\n   185\t        const plot = await box(page, '#chart .axylo-plot');\n   186\t        const expected = Math.min(480, Math.max(160, plot.width * 9 / 16));\n   187\t        expect(Math.abs(heights[0]! - expected), `${w} px wide`).toBeLessThanOrEqual(1);\n   188\t        expect(new Set(heights.map(h => Math.round(h))).size).toBe(1);\n   189\t      }\n   190\t      expect(await closePage(page)).toEqual([]);\n   191\t    });\n   192\t\n   193\t    it(`L3 ${type}: a container that starts hidden draws when it is shown`, async () => {\n   194\t      const page = await devPage({ css: '#chart.off { display: none; }' });\n   195\t      await page.evaluate(() => document.querySelector('#chart')!.classList.add('off'));\n   196\t      const { fn, options } = optionsFor(type);\n   197\t      // Created while hidden: nothing can be drawn yet, so the test does not wait for a drawn frame here.\n   198\t      await page.evaluate(({ fn, options }) => {\n   199\t        const w = window as unknown as { Axylo: Record<string, (t: string, o: unknown) => unknown>; charts: unknown[] };\n   200\t        w.charts.push(w.Axylo[fn]!('#chart', options));\n   201\t      }, { fn, options });\n   202\t      await page.evaluate(() => new Promise(r => setTimeout(r, 100)));\n   203\t      await page.evaluate(() => document.querySelector('#chart')!.classList.remove('off'));\n   204\t      // Shown: the chart draws on its own; wait (bounded) for its marks, then assert.\n   205\t      await page.waitForFunction(() => [...document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene *')].some(e => /--axylo-series-color-/.test(e.style.getPropertyValue('color'))), null, { timeout: 5000 }).catch(() => undefined);\n   206\t      const marks = await page.evaluate(() => [...document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene *')].filter(e => /--axylo-series-color-/.test(e.style.getPropertyValue('color'))).length);\n   207\t      expect(marks).toBeGreaterThan(0);\n   208\t      expect((await box(page, '#chart .axylo-plot')).width).toBeGreaterThan(300);\n   209\t      expect(await closePage(page)).toEqual([]);\n   210\t    });\n   211\t  }\n   212\t});\n   213\t\n   214\t// ── L4 ────────────────────────────────────────────────────────────────────────────────────────────\n   215\t\n   216\tdescribe('L4 scheme from the page', () => {\n   217\t  for (const type of TYPES) {\n   218\t    it(`L4 ${type}: a page that sets color-scheme: dark gets the dark marks; a class-toggled dark theme without color-scheme repaints by the next frame`, async () => {\n   219\t      const page = await devPage({ css: 'body.dark { background: #121212; color: #e8e8e8; }' });\n   220\t      await create(page, type);\n   221\t      const light = await seriesColors(page);\n   222\t      await page.close();\n   223\t      const dark = await devPage({ css: DARK_PAGE });\n   224\t      await create(dark, type);\n   225\t      const darkMarks = await seriesColors(dark);\n   226\t      expect(darkMarks).not.toEqual(light);\n   227\t      await closePage(dark);\n   228\t      const toggled = await devPage({ css: 'body.dark { background: #121212; color: #e8e8e8; }' });\n   229\t      await create(toggled, type);\n   230\t      expect(await seriesColors(toggled)).toEqual(light);\n   231\t      await toggled.evaluate(() => document.body.classList.add('dark'));\n   232\t      await toggled.evaluate(() => new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r))));\n   233\t      expect(await seriesColors(toggled)).toEqual(darkMarks);\n   234\t      await toggled.evaluate(() => document.body.classList.remove('dark'));\n   235\t      await toggled.evaluate(() => new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r))));\n   236\t      expect(await seriesColors(toggled)).toEqual(light);\n   237\t      expect(await closePage(toggled)).toEqual([]);\n   238\t    });\n   239\t\n   240\t    it(`L4 ${type}: a light-only page on a dark device stays light, and --axylo-background overrides the detected scheme`, async () => {\n   241\t      const page = await devPage();\n   242\t      await create(page, type);\n   243\t      const light = await seriesColors(page);\n   244\t      await page.close();\n   245\t      const device = await devPage({ colorScheme: 'dark' });\n   246\t      await create(device, type);\n   247\t      expect(await seriesColors(device)).toEqual(light);\n   248\t      await closePage(device);\n   249\t      const dark = await devPage({ css: DARK_PAGE });\n   250\t      await create(dark, type);\n   251\t      const darkMarks = await seriesColors(dark);\n   252\t      await dark.close();\n   253\t      const override = await devPage({ css: '#chart { --axylo-background: #101010; }' });\n   254\t      await create(override, type);\n   255\t      expect(await seriesColors(override)).toEqual(darkMarks);\n   256\t      expect(await closePage(override)).toEqual([]);\n   257\t    });\n   258\t\n   259\t    it(`L4 ${type}: in forced-colors mode the marks use system colours`, async () => {\n   260\t      const page = await devPage();\n   261\t      await page.emulateMedia({ forcedColors: 'active' });\n   262\t      await create(page, type);\n   263\t      const marks = await seriesColors(page);\n   264\t      expect(marks.length).toBeGreaterThan(0);\n   265\t      const system = await resolveColors(page, ['CanvasText', 'Canvas', 'GrayText', 'Highlight', 'LinkText', 'ButtonText']);\n   266\t      for (const m of marks) expect(system.some(s => s[0] === m[0] && s[1] === m[1] && s[2] === m[2]), `${m}`).toBe(true);\n   267\t      expect(await closePage(page)).toEqual([]);\n   268\t    });\n   269\t  }\n   270\t});\n   271\t\n   272\t// ── L5 ────────────────────────────────────────────────────────────────────────────────────────────\n   273\t\n   274\t/** Marker shapes per series slot: small closed subpaths in the series colour. */\n   275\tasync function markerCount(page: Page, slot = 1): Promise<number> {\n   276\t  return ((await shapes(page, '#chart', 14))[slot] ?? []).length;\n   277\t}\n   278\t\n   279\tdescribe('L5 point markers', () => {\n   280\t  for (const type of ['line', 'area'] as const) {\n   281\t    it(`L5 ${type}: 120 daily points in 720 px (about 5.5 px apart) do not get a marker on every point; 12 points do; an isolated point always has one`, async () => {\n   282\t      const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n   283\t      const page = await devPage();\n   284\t      await createRaw(page, type, { title: 'Dense', data: Array.from({ length: 120 }, (_, k) => ({ day: day(k), v: 10 + (k % 9) })), x: { field: 'day', type: 'date' }, y: 'v' });\n   285\t      expect(await markerCount(page)).toBeLessThan(120 / 2);\n   286\t      await page.close();\n   287\t      const sparse = await devPage();\n   288\t      await createRaw(sparse, type, { title: 'Twelve', data: Array.from({ length: 12 }, (_, k) => ({ day: day(k), v: 10 + (k % 5) })), x: { field: 'day', type: 'date' }, y: 'v' });\n   289\t      expect(await markerCount(sparse)).toBe(12);\n   290\t      await sparse.close();\n   291\t      const isolated = await devPage();\n   292\t      // Dense, with one value alone between two gaps at day 60.\n   293\t      const data = Array.from({ length: 120 }, (_, k) => ({ day: day(k), v: k === 59 || k === 61 ? null : 10 + (k % 9) }));\n   294\t      await createRaw(isolated, type, { title: 'Isolated', data, x: { field: 'day', type: 'date' }, y: 'v' });\n   295\t      const g = await plotGeometry(isolated);\n   296\t      const at60 = g.plot.x + (60 / 119) * g.plot.width;\n   297\t      const marks = ((await shapes(isolated, '#chart', 14))[1] ?? []).map(s => center(s.box).x);\n   298\t      expect(marks.some(x => Math.abs(x - at60) <= 3), `marker near ${at60}: ${marks.map(Math.round).join(', ')}`).toBe(true);\n   299\t      expect(await closePage(isolated)).toEqual([]);\n   300\t    });\n   301\t  }\n   302\t});\n   303\t\n   304\t// ── L6 ────────────────────────────────────────────────────────────────────────────────────────────\n   305\t\n   306\tasync function labels(page: Page, role: string): Promise<string[]> {\n   307\t  return page.locator(`#chart .axylo-label[data-role=\"${role}\"]`).allTextContents();\n   308\t}\n   309\t\n   310\tdescribe('L6 titles belong to the chart', () => {\n   311\t  for (const type of FULL as Full[]) {\n   312\t    it(`L6 ${type}: title and subtitle are part of the figure; axis titles follow the rule for the x kind, carry the unit, and do not overlap tick labels`, async () => {\n   313\t      const page = await devPage();\n   314\t      await create(page, type, { subtitle: 'Last quarter' });\n   315\t      const fig = await box(page, '#chart figure');\n   316\t      for (const sel of ['.axylo-title', '.axylo-subtitle']) {\n   317\t        expect(await page.locator(`#chart ${sel}`).isVisible(), sel).toBe(true);\n   318\t        const b = await box(page, `#chart ${sel}`);\n   319\t        expect(b.y >= fig.y - 1 && b.y + b.height <= fig.y + fig.height + 1).toBe(true);\n   320\t      }\n   321\t      const titles = { y: await labels(page, 'title-y'), x: await labels(page, 'title-x') };\n   322\t      if (type === 'line' || type === 'area') {\n   323\t        expect(titles.y).toEqual(['Energy (kWh)']);\n   324\t        // A date x axis is titled only with an author label.\n   325\t        expect(titles.x).toEqual([]);\n   326\t      } else if (type === 'bar') {\n   327\t        expect(titles.y).toEqual(['Shipped (t)']);\n   328\t        expect(titles.x).toEqual([]);\n   329\t      } else if (type === 'scatter') {\n   330\t        expect(titles.y).toEqual(['Latency (ms)']);\n   331\t        expect(titles.x).toEqual(['Payload (kB)']);\n   332\t      } else {\n   333\t        expect([...titles.x, ...titles.y]).toEqual([]);\n   334\t      }\n   335\t      const boxes = await textBoxes(page);\n   336\t      const axisTitles = boxes.filter(b => b.role === 'title-x' || b.role === 'title-y');\n   337\t      const ticks = boxes.filter(b => b.role === 'tick-x' || b.role === 'tick-y');\n   338\t      expect(overlaps([...axisTitles, ...ticks.map(t => ({ ...t, owner: t.owner + 100000 }))]).filter(o => axisTitles.some(a => o.includes(`\"${a.text}\"`)))).toEqual([]);\n   339\t      expect(await closePage(page)).toEqual([]);\n   340\t    });\n   341\t\n   342\t    if (type !== 'donut' && type !== 'scatter') {\n   343\t      it(`L6 ${type}: with an x label the ${type === 'bar' ? 'category' : 'date'} x axis is titled with it; a value field without a label is titled with its field name`, async () => {\n   344\t        const page = await devPage();\n   345\t        const x = type === 'bar' ? { field: 'quarter', label: 'Quarter' } : { field: 'day', type: 'date', label: 'Day' };\n   346\t        await create(page, type, { x, y: type === 'bar' ? 'shipped' : 'energy' });\n   347\t        expect(await labels(page, 'title-x')).toEqual([type === 'bar' ? 'Quarter' : 'Day']);\n   348\t        expect(await labels(page, 'title-y')).toEqual([type === 'bar' ? 'shipped' : 'energy']);\n   349\t        expect(await closePage(page)).toEqual([]);\n   350\t      });\n   351\t    }\n   352\t  }\n   353\t\n   354\t  it('L6 scatter: a number x without a label is titled with its field name', async () => {\n   355\t    const page = await devPage();\n   356\t    await create(page, 'scatter', { x: 'size', y: 'latency' });\n   357\t    expect(await labels(page, 'title-x')).toEqual(['size']);\n   358\t    expect(await labels(page, 'title-y')).toEqual(['latency']);\n   359\t    expect(await closePage(page)).toEqual([]);\n   360\t  });\n   361\t});\n   362\t\n   363\t// ── L7 ────────────────────────────────────────────────────────────────────────────────────────────\n   364\t\n   365\tdescribe('L7 states inside the plot', () => {\n   366\t  for (const type of TYPES) {\n   367\t    it(`L7 ${type}: empty data shows a message inside the plot and in the accessibility tree, with no tick labels and no invented axis`, async () => {\n   368\t      const page = await devPage();\n   369\t      await create(page, type, { data: [] });\n   370\t      const message = page.locator('#chart .axylo-message');\n   371\t      expect(await message.isVisible()).toBe(true);\n   372\t      const text = ((await message.textContent()) ?? '').trim();\n   373\t      expect(text).not.toBe('');\n   374\t      const plot = await box(page, '#chart .axylo-plot');\n   375\t      const m = await box(page, '#chart .axylo-message');\n   376\t      expect(m.x >= plot.x - 1 && m.y >= plot.y - 1 && m.x + m.width <= plot.x + plot.width + 1 && m.y + m.height <= plot.y + plot.height + 1).toBe(true);\n   377\t      expect((await axWithin(page, '#chart')).some(n => n.name.includes(text) || n.description.includes(text))).toBe(true);\n   378\t      expect(await page.locator('#chart .axylo-label[data-role^=\"tick\"]').count()).toBe(0);\n   379\t      expect(await page.evaluate(() => document.querySelectorAll('#chart svg.axylo-svg .axylo-scene line').length)).toBe(0);\n   380\t      expect(await closePage(page)).toEqual([]);\n   381\t    });\n   382\t\n   383\t    it(`L7 ${type}: loading, an author error and an internal failure each show their message inside the plot; loading → ready is announced once, politely`, async () => {\n   384\t      const page = await devPage();\n   385\t      await create(page, type, { state: 'loading' });\n   386\t      const message = page.locator('#chart .axylo-message');\n   387\t      expect(await message.isVisible()).toBe(true);\n   388\t      const loading = (await message.textContent())?.trim();\n   389\t      await page.evaluate(() => {\n   390\t        const w = window as unknown as { announced: string[] };\n   391\t        w.announced = [];\n   392\t        const live = document.querySelectorAll('#chart [aria-live=\"polite\"], #chart [aria-live=\"assertive\"]');\n   393\t        for (const el of live) new MutationObserver(() => { if (el.textContent?.trim()) w.announced.push(`${el.getAttribute('aria-live')}: ${el.textContent}`); }).observe(el, { childList: true, characterData: true, subtree: true });\n   394\t      });\n   395\t      await call(page, 'update', [{ state: 'ready' }]);\n   396\t      await settle(page);\n   397\t      const announced = await page.evaluate(() => (window as unknown as { announced: string[] }).announced);\n   398\t      expect(announced).toHaveLength(1);\n   399\t      expect(announced[0]!.startsWith('polite: ')).toBe(true);\n   400\t      expect(await message.isVisible()).toBe(false);\n   401\t      await call(page, 'update', [{ state: { error: 'The query failed.' } }]);\n   402\t      expect(await message.isVisible()).toBe(true);\n   403\t      expect(await message.textContent()).not.toBe(loading);\n   404\t      await call(page, 'update', [{ state: 'ready' }]);\n   405\t      await page.evaluate(() => (window as unknown as { charts: { __dev: { fail(s: string | null): void } }[] }).charts[0]!.__dev.fail('reader'));\n   406\t      await call(page, 'update', [{ title: 'Again' }]);\n   407\t      expect(await message.isVisible()).toBe(true);\n   408\t      expect(((await message.textContent()) ?? '').trim()).not.toBe('');\n   409\t      expect(await closePage(page)).toEqual([]);\n   410\t    });\n   411\t  }\n   412\t});\n   413\t\n   414\t// ── L8 ────────────────────────────────────────────────────────────────────────────────────────────\n   415\t\n   416\tdescribe('L8 too small for a plot', () => {\n   417\t  for (const type of FULL as Full[]) {\n   418\t    for (const [shape, css] of [['narrow', 'width: 110px; height: 300px;'], ['short', 'width: 600px; height: 90px;']] as const) {\n   419\t      it(`L8 ${type}: a ${shape} container (${css}) shows the title, the one-line summary and the table control instead of a plot, and raises AX142`, async () => {\n   420\t        const page = await devPage({ css: `#chart { ${css} }` });\n   421\t        const built = await create(page, type);\n   422\t        expect(built.diagnostics.filter(d => d.code === 'AX142').map(d => d.level)).toEqual(['hint']);\n   423\t        expect(await page.locator('#chart .axylo-title').isVisible()).toBe(true);\n   424\t        const summary = page.locator('#chart .axylo-summary');\n   425\t        expect(await summary.isVisible()).toBe(true);\n   426\t        expect(await summary.evaluate(el => el.classList.contains('axylo-visually-hidden'))).toBe(false);\n   427\t        expect(await page.locator('#chart button', { hasText: 'View as table' }).isVisible()).toBe(true);\n   428\t        const marks = await page.evaluate(() => [...document.querySelectorAll<SVGElement>('#chart svg.axylo-svg .axylo-scene *')].filter(e => /--axylo-series-color-/.test(e.style.getPropertyValue('color'))).length);\n   429\t        expect(marks).toBe(0);\n   430\t        expect((await axOf(page, '#chart figure')).name).not.toBe('');\n   431\t        expect(await closePage(page)).toEqual([]);\n   432\t      });\n   433\t    }\n   434\t  }\n   435\t});\n     1\t/**\n     2\t * Where the chart's visible text is, as oriented rectangles in viewport px, and whether two of them\n     3\t * overlap (separating-axis test with the spec's 1 px tolerance). A rotated tick label is measured as its\n     4\t * own rotated box, not as the axis-aligned box around it, so a 45° label that only seems to touch its\n     5\t * neighbour's bounding box is not counted.\n     6\t */\n     7\timport type { Page } from 'playwright-core';\n     8\t\n     9\texport interface TextBox { text: string; owner: number; cx: number; cy: number; w: number; h: number; angle: number; role: string }\n    10\t\n    11\texport async function textBoxes(page: Page, selector = '#chart'): Promise<TextBox[]> {\n    12\t  return page.evaluate(selector => {\n    13\t    const root = document.querySelector(selector)!;\n    14\t    const out: { text: string; owner: number; cx: number; cy: number; w: number; h: number; angle: number; role: string }[] = [];\n    15\t    const owners = new Map<Element, number>();\n    16\t    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);\n    17\t    for (let n = walker.nextNode(); n; n = walker.nextNode()) {\n    18\t      const el = n.parentElement!;\n    19\t      if (!n.textContent?.trim()) continue;\n    20\t      if (el.closest('[hidden], .axylo-visually-hidden, .axylo-tooltip, .axylo-readout, [aria-hidden=\"true\"] svg, script, style')) continue;\n    21\t      const style = getComputedStyle(el);\n    22\t      if (style.visibility === 'hidden' || style.display === 'none' || Number(style.opacity) === 0) continue;\n    23\t      // A transformed ancestor inside the chart (a placed label): measured as its own rotated box.\n    24\t      let moved: HTMLElement | null = null;\n    25\t      for (let a: HTMLElement | null = el; a && a !== root; a = a.parentElement) if (getComputedStyle(a).transform !== 'none') { moved = a; break; }\n    26\t      const owner = moved ?? el;\n    27\t      if (!owners.has(owner)) owners.set(owner, owners.size);\n    28\t      const role = owner.closest('[data-role]')?.getAttribute('data-role') ?? owner.className;\n    29\t      if (moved) {\n    30\t        if (out.some(b => b.owner === owners.get(owner))) continue;\n    31\t        const m = new DOMMatrix(getComputedStyle(moved).transform);\n    32\t        const r = moved.getBoundingClientRect();\n    33\t        out.push({ text: moved.textContent ?? '', owner: owners.get(owner)!, cx: r.x + r.width / 2, cy: r.y + r.height / 2, w: moved.offsetWidth, h: moved.offsetHeight, angle: Math.atan2(m.b, m.a), role });\n    34\t        continue;\n    35\t      }\n    36\t      const range = document.createRange();\n    37\t      range.selectNodeContents(n);\n    38\t      // The line box, not the font's content area: a content area taller than the line height reaches\n    39\t      // above and below the line with no ink in it.\n    40\t      const line = parseFloat(style.lineHeight);\n    41\t      for (const r of range.getClientRects()) {\n    42\t        if (r.width < 0.5 || r.height < 0.5) continue;\n    43\t        const h = Number.isFinite(line) ? Math.min(r.height, line) : r.height;\n    44\t        out.push({ text: n.textContent ?? '', owner: owners.get(owner)!, cx: r.x + r.width / 2, cy: r.y + r.height / 2, w: r.width, h, angle: 0, role });\n    45\t      }\n    46\t    }\n    47\t    return out;\n    48\t  }, selector);\n    49\t}\n    50\t\n    51\tfunction corners(b: TextBox, shrink: number): [number, number][] {\n    52\t  const w = Math.max(0, b.w / 2 - shrink), h = Math.max(0, b.h / 2 - shrink);\n    53\t  const c = Math.cos(b.angle), s = Math.sin(b.angle);\n    54\t  return ([[-w, -h], [w, -h], [w, h], [-w, h]] as const).map(([x, y]) => [b.cx + x * c - y * s, b.cy + x * s + y * c] as [number, number]);\n    55\t}\n    56\t\n    57\t/** Whether two boxes overlap by more than `tolerance` px (each is shrunk by half of it on every side). */\n    58\texport function overlap(a: TextBox, b: TextBox, tolerance = 1): boolean {\n    59\t  const pa = corners(a, tolerance / 2), pb = corners(b, tolerance / 2);\n    60\t  for (const poly of [pa, pb]) {\n    61\t    for (let i = 0; i < 4; i++) {\n    62\t      const [x1, y1] = poly[i]!, [x2, y2] = poly[(i + 1) % 4]!;\n    63\t      const nx = y2 - y1, ny = x1 - x2;\n    64\t      const project = (p: [number, number][]) => p.map(([x, y]) => x * nx + y * ny);\n    65\t      const A = project(pa), B = project(pb);\n    66\t      if (Math.max(...A) <= Math.min(...B) || Math.max(...B) <= Math.min(...A)) return false;\n    67\t    }\n    68\t  }\n    69\t  return true;\n    70\t}\n    71\t\n    72\t/** The axis-aligned extent of a box. */\n    73\texport function extent(b: TextBox): { x0: number; y0: number; x1: number; y1: number } {\n    74\t  const p = corners(b, 0);\n    75\t  return { x0: Math.min(...p.map(q => q[0])), y0: Math.min(...p.map(q => q[1])), x1: Math.max(...p.map(q => q[0])), y1: Math.max(...p.map(q => q[1])) };\n    76\t}\n    77\t\n    78\t/** Every pair of boxes from different elements that overlap. */\n    79\texport function overlaps(boxes: readonly TextBox[], tolerance = 1): string[] {\n    80\t  const out: string[] = [];\n    81\t  for (let i = 0; i < boxes.length; i++) {\n    82\t    for (let j = i + 1; j < boxes.length; j++) {\n    83\t      if (boxes[i]!.owner === boxes[j]!.owner) continue;\n    84\t      if (overlap(boxes[i]!, boxes[j]!, tolerance)) out.push(`\"${boxes[i]!.text}\" × \"${boxes[j]!.text}\"`);\n    85\t    }\n    86\t  }\n    87\t  return out;\n    88\t}\n","exit_code":0,"status":"completed"}}
