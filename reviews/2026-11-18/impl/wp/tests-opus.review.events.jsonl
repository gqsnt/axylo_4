{"type":"item.completed","item":{"id":"item_27","type":"command_execution","command":"/bin/bash -lc 'for f in tests/dist/{licence.test.ts,snippets.test.ts,node.test.ts,fixtures/npm/node-import.mjs,fixtures/react/{main.tsx,ssr.tsx},setup.ts,vitest.config.ts}; do nl -ba \"$f\"; done'","aggregated_output":"     1\t/**\n     2\t * Spec DX11 (MIT for everything, third-party notices) and the zero-runtime-dependency half of DX7, checked\n     3\t * mechanically on the packed files and on the source they are built from. THIRD-PARTY-NOTICES.md lists\n     4\t * the same checks.\n     5\t */\n     6\timport { describe, expect, it } from 'vitest';\n     7\timport { build } from 'esbuild';\n     8\timport fs from 'node:fs';\n     9\timport path from 'node:path';\n    10\timport { installed, manifest, packedJson, repo } from './paths';\n    11\t\n    12\ttype Name = 'axylo' | '@axylo/react';\n    13\tconst NAMES: Name[] = ['axylo', '@axylo/react'];\n    14\t/** What the shipped JavaScript may import: nothing for the core; the core and React for the adapter (plan 1.7). */\n    15\tconst ALLOWED_IMPORTS: Record<Name, string[]> = { axylo: [], '@axylo/react': ['axylo', 'react'] };\n    16\tconst SOURCE: Record<Name, string> = { axylo: 'packages/axylo/src', '@axylo/react': 'packages/react/src' };\n    17\t\n    18\t// The standard MIT text (opensource.org/license/mit): its grant and its warranty disclaimer.\n    19\tconst MIT_GRANT = 'Permission is hereby granted, free of charge, to any person obtaining a copy';\n    20\tconst MIT_DISCLAIMER = 'THE SOFTWARE IS PROVIDED \"AS IS\", WITHOUT WARRANTY OF ANY KIND';\n    21\t/** Markers of a licence or copyright header copied in from elsewhere. */\n    22\tconst HEADER = /@license\\b|@preserve\\b|SPDX-License-Identifier|Copyright\\s+(\\(c\\)|©|\\d{4})|Licensed under|Permission is hereby granted|THE SOFTWARE IS PROVIDED/i;\n    23\t\n    24\tdescribe.each(NAMES)('%s', name => {\n    25\t  const pkg = packedJson(name);\n    26\t\n    27\t  it('is MIT: the license field and the shipped LICENSE file', () => {\n    28\t    expect(pkg.license).toBe('MIT');\n    29\t    const text = fs.readFileSync(installed(name, 'LICENSE'), 'utf8').replace(/\\s+/g, ' ');\n    30\t    expect(text.startsWith('MIT License')).toBe(true);\n    31\t    expect(text).toContain(MIT_GRANT);\n    32\t    expect(text).toContain(MIT_DISCLAIMER);\n    33\t  });\n    34\t\n    35\t  it('declares no runtime dependencies', () => {\n    36\t    const raw = pkg as unknown as Record<string, unknown>;\n    37\t    for (const field of ['dependencies', 'optionalDependencies', 'bundleDependencies', 'bundledDependencies']) expect(raw[field], field).toBeUndefined();\n    38\t    expect(Object.keys(pkg.peerDependencies ?? {}).sort()).toEqual(ALLOWED_IMPORTS[name]);\n    39\t  });\n    40\t\n    41\t  it('ships JavaScript that imports nothing but its peers', async () => {\n    42\t    const files = manifest().packages[name].files.filter(f => f.endsWith('.js'));\n    43\t    expect(files.length).toBeGreaterThan(0);\n    44\t    for (const file of files) {\n    45\t      const r = await build({\n    46\t        entryPoints: [installed(name, file)], bundle: true, write: false, metafile: true, logLevel: 'silent', format: 'esm',\n    47\t        plugins: [{ name: 'externals', setup(b) { b.onResolve({ filter: /^[^./]/ }, a => ({ path: a.path, external: true })); } }],\n    48\t      });\n    49\t      const imports = Object.values(r.metafile.inputs).flatMap(i => i.imports.filter(x => x.external).map(x => x.path));\n    50\t      const roots = [...new Set(imports.map(s => s.startsWith('@') ? s.split('/').slice(0, 2).join('/') : s.split('/')[0]!))].sort();\n    51\t      expect(roots.filter(s => !ALLOWED_IMPORTS[name].includes(s)), `${file} imports`).toEqual([]);\n    52\t      expect(Object.keys(r.metafile.inputs), `${file} pulls in other files`).toHaveLength(1);\n    53\t    }\n    54\t  });\n    55\t\n    56\t  it('is built from its own source only: no node_modules input when its entry is bundled as the release build does', async () => {\n    57\t    const src = path.join(repo, SOURCE[name]);\n    58\t    const r = await build({\n    59\t      entryPoints: [path.join(src, 'index.ts')], bundle: true, write: false, metafile: true, format: 'esm', target: 'es2022',\n    60\t      minify: true, define: { __DEV__: 'false' }, legalComments: 'none', logLevel: 'silent', absWorkingDir: repo,\n    61\t      external: ['react', 'react/jsx-runtime', 'react-dom', 'axylo'],\n    62\t    });\n    63\t    const inputs = Object.keys(r.metafile.inputs).map(p => path.resolve(repo, p));\n    64\t    expect(inputs.length).toBeGreaterThan(0);\n    65\t    expect(inputs.filter(p => !p.startsWith(src + path.sep))).toEqual([]);\n    66\t  });\n    67\t\n    68\t  it('has no copied licence or copyright header in its source or its shipped files', () => {\n    69\t    const src = path.join(repo, SOURCE[name]);\n    70\t    const sources = fs.readdirSync(src, { recursive: true, encoding: 'utf8' }).filter(f => /\\.[cm]?[jt]sx?$/.test(f)).map(f => path.join(src, f));\n    71\t    const shipped = manifest().packages[name].files.filter(f => !/^(LICENSE|README\\.md|package\\.json)$/.test(f)).map(f => installed(name, f));\n    72\t    const hits = [...sources, ...shipped].filter(f => HEADER.test(fs.readFileSync(f, 'utf8')));\n    73\t    expect(hits.map(f => path.relative(repo, f))).toEqual([]);\n    74\t  });\n    75\t});\n    76\t\n    77\tdescribe('THIRD-PARTY-NOTICES.md', () => {\n    78\t  const text = fs.readFileSync(path.join(repo, 'THIRD-PARTY-NOTICES.md'), 'utf8');\n    79\t\n    80\t  it('covers both published packages and states that they ship no third-party code', () => {\n    81\t    for (const name of NAMES) expect(text).toContain(`\\`${name}\\``);\n    82\t    expect(text).toMatch(/contain no third-party code/);\n    83\t  });\n    84\t});\n     1\t/**\n     2\t * Spec DX1, the static half: each documented first chart is ten lines or fewer including the import, counted\n     3\t * as a reader counts them (non-blank lines), and passes no option besides data, fields and the title. The\n     4\t * title is there because without it the chart raises AX140, a warning (spec 3.5), and a first chart should\n     5\t * not print one; first-chart.browser.test.ts shows it is not required. The fixtures and the package READMEs\n     6\t * carry the files verbatim, so examples/first-chart stays the single source.\n     7\t */\n     8\timport { describe, expect, it } from 'vitest';\n     9\timport fs from 'node:fs';\n    10\timport path from 'node:path';\n    11\timport { examples, fixture, repo } from './paths';\n    12\t\n    13\tconst SNIPPETS = [\n    14\t  { file: 'npm.ts', fixture: 'npm', readme: 'packages/axylo/README.md' },\n    15\t  { file: 'script.html', fixture: 'script', readme: 'packages/axylo/README.md' },\n    16\t  { file: 'react.tsx', fixture: 'react', readme: 'packages/react/README.md' },\n    17\t] as const;\n    18\tconst ALLOWED = ['data', 'title', 'x', 'y'];\n    19\t\n    20\tconst read = (file: string): string => fs.readFileSync(path.join(examples, file), 'utf8');\n    21\t\n    22\t/** Option names passed to the chart: keys of the object literal given to line(), or the props of <Line>. */\n    23\tfunction optionNames(file: string, code: string): string[] {\n    24\t  if (file.endsWith('.tsx')) {\n    25\t    const tag = /<Line\\b([^>]*)\\/>/.exec(code);\n    26\t    return tag ? [...tag[1]!.matchAll(/\\b([A-Za-z]+)=/g)].map(m => m[1]!).sort() : [];\n    27\t  }\n    28\t  const call = /\\bline\\(\\s*'[^']*',\\s*\\{([^}]*)\\}\\s*\\)/.exec(code);\n    29\t  return call ? [...call[1]!.matchAll(/\\b([A-Za-z]+)\\s*:/g)].map(m => m[1]!).sort() : [];\n    30\t}\n    31\t\n    32\tdescribe.each(SNIPPETS)('examples/first-chart/$file', snippet => {\n    33\t  const code = read(snippet.file);\n    34\t\n    35\t  it('is ten lines or fewer, counting non-blank lines', () => {\n    36\t    const lines = code.split('\\n').filter(l => l.trim() !== '').length;\n    37\t    console.info(`${snippet.file}: ${lines} non-blank lines`);\n    38\t    expect(lines).toBeLessThanOrEqual(10);\n    39\t  });\n    40\t\n    41\t  it('starts with what loads the library (the import, or the script tag after the document head)', () => {\n    42\t    if (snippet.file === 'script.html') {\n    43\t      expect(code).toMatch(/<script src=\"[^\"]*\\/axylo\\.iife(\\.min)?\\.js\"><\\/script>/);\n    44\t      expect(code).toMatch(/<link rel=\"stylesheet\" href=\"[^\"]*\\/axylo\\.css\">/);\n    45\t    } else {\n    46\t      expect(code.split('\\n')[0]).toMatch(/^import \\{ (Line|line) \\} from '(axylo|@axylo\\/react)';$/);\n    47\t    }\n    48\t  });\n    49\t\n    50\t  it('passes no option besides data, fields and the title', () => {\n    51\t    const names = optionNames(snippet.file, code);\n    52\t    expect(names).toContain('data');\n    53\t    expect(names.filter(n => !ALLOWED.includes(n))).toEqual([]);\n    54\t  });\n    55\t\n    56\t  it('is copied verbatim into its fixture and its package README', () => {\n    57\t    expect(fs.readFileSync(fixture(snippet.fixture, 'example', snippet.file), 'utf8')).toBe(code);\n    58\t    expect(fs.readFileSync(path.join(repo, snippet.readme), 'utf8')).toContain(code);\n    59\t  });\n    60\t});\n     1\t/**\n     2\t * Spec DX8, the Node half, from the packed files in child processes started inside the fixtures (so Node,\n     3\t * not Vitest's resolver, finds the packages, and no test-runner globals are present):\n     4\t * - importing `axylo` without DOM globals does not throw and adds no globals (the `sideEffects` claim);\n     5\t * - `validate()` runs there and reports the Phase 1 `dirty` fixture as spec 3.5 and plan 1.6 say;\n     6\t * - `@axylo/react` server-renders with react-dom/server.\n     7\t */\n     8\timport { beforeAll, describe, expect, it } from 'vitest';\n     9\timport { build } from 'esbuild';\n    10\timport path from 'node:path';\n    11\timport { fixture, inside, nodeJson } from './paths';\n    12\t\n    13\tinterface Probe {\n    14\t  domGlobals: string[];\n    15\t  resolved: string;\n    16\t  exports: string[];\n    17\t  addedGlobals: string[];\n    18\t  diagnostics: { code: string; level: string; field?: string; rows?: number[]; count?: number; chart: string }[];\n    19\t  missingTarget: string | null;\n    20\t}\n    21\t\n    22\tdescribe.each([[[]], [['--conditions=development']]] as const)('axylo in plain Node %j', conditions => {\n    23\t  const probe = nodeJson<Probe>(fixture('npm'), [...conditions, 'node-import.mjs']);\n    24\t\n    25\t  it('ran without DOM globals, from the packed file', () => {\n    26\t    // Node itself has had a `navigator` global since v21; the DOM ones must be absent.\n    27\t    expect(probe.domGlobals.filter(g => g !== 'navigator')).toEqual([]);\n    28\t    expect(inside(fixture('npm', 'node_modules/axylo'), new URL(probe.resolved).pathname)).toBe(true);\n    29\t  });\n    30\t\n    31\t  it('exports the five chart functions and validate, and adds no globals on import', () => {\n    32\t    expect(probe.exports).toEqual(['area', 'bar', 'donut', 'line', 'scatter', 'validate']);\n    33\t    expect(probe.addedGlobals).toEqual([]);\n    34\t  });\n    35\t\n    36\t  it('validate() reports the dirty fixture: AX102, AX103 and AX106 once each, with field and rows (spec 3.5, plan 1.6)', () => {\n    37\t    const problems = probe.diagnostics.filter(d => d.level !== 'hint');\n    38\t    expect(problems.map(d => d.code).sort()).toEqual(['AX102', 'AX103', 'AX106']);\n    39\t    const by = Object.fromEntries(problems.map(d => [d.code, d]));\n    40\t    // Row indexes: NaN is row 3 (Thu), '40' row 4 (Fri), the absent value row 5 (Sat).\n    41\t    expect(by.AX103).toMatchObject({ level: 'warning', field: 'value', rows: [3], chart: 'Dirty input' });\n    42\t    expect(by.AX106).toMatchObject({ level: 'warning', field: 'value', rows: [4], chart: 'Dirty input' });\n    43\t    expect(by.AX102).toMatchObject({ level: 'warning', field: 'value', rows: [5], chart: 'Dirty input' });\n    44\t  });\n    45\t\n    46\t  it('a chart function called without a document throws an error that names the target', () => {\n    47\t    expect(probe.missingTarget).toContain('#nowhere');\n    48\t  });\n    49\t});\n    50\t\n    51\tdescribe('@axylo/react server rendering', () => {\n    52\t  let result: { domGlobals: string[]; markup: Record<string, string> };\n    53\t\n    54\t  beforeAll(async () => {\n    55\t    // Bundled only to compile the TSX: every package stays external and is resolved by Node at run time\n    56\t    // from the output's location, which is inside the fixture.\n    57\t    const outfile = fixture('react', '.out', 'ssr.mjs');\n    58\t    await build({\n    59\t      entryPoints: [fixture('react', 'ssr.tsx')], bundle: true, platform: 'node', format: 'esm', packages: 'external',\n    60\t      jsx: 'automatic', outfile, absWorkingDir: fixture('react'), logLevel: 'silent',\n    61\t    });\n    62\t    result = nodeJson(path.dirname(outfile), [outfile]);\n    63\t  });\n    64\t\n    65\t  it('runs without DOM globals', () => {\n    66\t    expect(result.domGlobals.filter(g => g !== 'navigator')).toEqual([]);\n    67\t  });\n    68\t\n    69\t  it('renders the documented snippet and each component to its empty container (the chart is created on mount, plan 1.7)', () => {\n    70\t    expect(Object.keys(result.markup).sort()).toEqual(['Area', 'Bar', 'Donut', 'Line', 'MonthlyVisitors', 'Scatter']);\n    71\t    for (const [name, html] of Object.entries(result.markup)) expect(html, name).toMatch(/^<div[^<>]*><\\/div>$/);\n    72\t  });\n    73\t});\n     1\t// Plain Node, no DOM globals (spec DX8): import the packed package by name from this fixture and run\n     2\t// validate() on the Phase 1 combined `dirty` fixture (spec 3.5; plan 1.6). Prints one JSON line.\n     3\t// Run by tests/dist/node.test.ts, with and without --conditions=development.\n     4\tconst domGlobals = ['window', 'document', 'navigator', 'HTMLElement', 'ResizeObserver', 'requestAnimationFrame']\n     5\t  .filter(name => name in globalThis);\n     6\tconst before = new Set(Object.getOwnPropertyNames(globalThis));\n     7\t\n     8\tconst resolved = import.meta.resolve('axylo');\n     9\tconst axylo = await import('axylo');\n    10\tconst addedGlobals = Object.getOwnPropertyNames(globalThis).filter(name => !before.has(name));\n    11\t\n    12\t// Mon–Sun: 10, 20, null, NaN, '40', absent, 70.\n    13\tconst days = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];\n    14\tconst values = [10, 20, null, NaN, '40', undefined, 70];\n    15\tconst rows = days.map((day, i) => (values[i] === undefined ? { day } : { day, value: values[i] }));\n    16\tconst diagnostics = axylo.validate('line', { title: 'Dirty input', data: rows, x: 'day', y: 'value' });\n    17\t\n    18\tlet missingTarget = null;\n    19\ttry {\n    20\t  axylo.line('#nowhere', { title: 'T', data: rows, x: 'day', y: 'value' });\n    21\t} catch (error) {\n    22\t  missingTarget = String(error?.message ?? error);\n    23\t}\n    24\t\n    25\tconsole.log(JSON.stringify({ domGlobals, resolved, exports: Object.keys(axylo).sort(), addedGlobals, diagnostics, missingTarget }));\n     1\t// Mounts the documented React snippet the way an application's entry would, under StrictMode (spec DX8:\n     2\t// setup, cleanup and setup again).\n     3\timport { StrictMode } from 'react';\n     4\timport { createRoot } from 'react-dom/client';\n     5\timport { MonthlyVisitors } from './example/react';\n     6\t\n     7\tcreateRoot(document.getElementById('root')!).render(<StrictMode><MonthlyVisitors /></StrictMode>);\n     1\t// Server rendering from the packed files, in plain Node with no DOM globals (spec DX8). Bundled by the test\n     2\t// with every package left external, into .out/ inside this fixture, so `@axylo/react`, `axylo` and React are\n     3\t// resolved by Node from this fixture's node_modules. Prints one JSON line.\n     4\timport { createElement } from 'react';\n     5\timport { renderToString } from 'react-dom/server';\n     6\timport { Area, Bar, Donut, Line, Scatter } from '@axylo/react';\n     7\timport { MonthlyVisitors } from './example/react';\n     8\t\n     9\tconst rows = [\n    10\t  { day: '2026-01-01', channel: 'Direct', sessions: 10, visits: 4 },\n    11\t  { day: '2026-01-02', channel: 'Direct', sessions: 12, visits: 5 },\n    12\t];\n    13\ttype Row = (typeof rows)[number];\n    14\tconst domGlobals = ['window', 'document', 'navigator', 'HTMLElement', 'ResizeObserver'].filter(name => name in globalThis);\n    15\t\n    16\tconst markup: Record<string, string> = {\n    17\t  MonthlyVisitors: renderToString(<MonthlyVisitors />),\n    18\t  Line: renderToString(createElement(Line<Row>, { data: rows, x: 'day', y: 'sessions', series: 'channel', title: 'Sessions' })),\n    19\t  Area: renderToString(createElement(Area<Row>, { data: rows, x: 'day', y: 'sessions', stacked: true, title: 'Sessions' })),\n    20\t  Bar: renderToString(createElement(Bar<Row>, { data: rows, x: 'channel', y: 'sessions', title: 'Sessions' })),\n    21\t  Scatter: renderToString(createElement(Scatter<Row>, { data: rows, x: 'visits', y: 'sessions', title: 'Sessions' })),\n    22\t  Donut: renderToString(createElement(Donut<Row>, { data: rows, label: 'channel', value: 'sessions', title: 'Sessions' })),\n    23\t};\n    24\tconsole.log(JSON.stringify({ domGlobals, markup }));\n     1\t// Packs packages/*/dist once per run and installs the tarballs into the fixtures (scripts/pack.mjs). Set\n     2\t// AXYLO_DIST_BUILD=1 to run the root build first; by default the dist already on disk is packed.\n     3\t// @ts-expect-error scripts/pack.mjs is plain JavaScript without declarations\n     4\timport { pack } from '../../scripts/pack.mjs';\n     5\t\n     6\texport default function setup(): void {\n     7\t  (pack as (options: { build: boolean; log: (line: string) => void }) => unknown)({\n     8\t    build: process.env.AXYLO_DIST_BUILD === '1',\n     9\t    log: line => console.log(`[pack] ${line}`),\n    10\t  });\n    11\t}\n     1\timport { defineConfig } from 'vitest/config';\n     2\timport path from 'node:path';\n     3\t\n     4\t// Tests of the packed distribution (plan M7). They need a built packages/*/dist; the global setup packs it\n     5\t// (scripts/pack.mjs --no-build) and installs the tarballs into tests/dist/fixtures before any test runs, so\n     6\t// every run tests exactly what `npm pack` produces from the dist at that moment. Browser tests\n     7\t// (*.browser.test.ts) are selected with AXYLO_BROWSER=1, as in the root config.\n     8\tconst browser = !!process.env.AXYLO_BROWSER;\n     9\texport default defineConfig({\n    10\t  root: path.resolve(import.meta.dirname, '../..'),\n    11\t  test: {\n    12\t    include: browser ? ['tests/dist/**/*.browser.test.ts'] : ['tests/dist/**/*.test.ts'],\n    13\t    exclude: ['**/node_modules/**', 'tests/dist/fixtures/**', 'tests/dist/.packed/**', ...(browser ? [] : ['**/*.browser.test.ts'])],\n    14\t    globalSetup: ['tests/dist/setup.ts'],\n    15\t    testTimeout: browser ? 60000 : 30000,\n    16\t    hookTimeout: 120000,\n    17\t    fileParallelism: !browser,\n    18\t  },\n    19\t});\n","exit_code":0,"status":"completed"}}
