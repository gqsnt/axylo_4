   expect(resolve(['--conditions=development'])).toBe(dev);\n   181\t  });\n   182\t\n   183\t  it('esbuild resolves the development file under the development condition and the default under production', async () => {\n   184\t    const entry = async (conditions: string[]) => {\n   185\t      const r = await build({\n   186\t        stdin: { contents: `export * from ${JSON.stringify(name)};`, resolveDir: fixture(FIXTURE[name]) }, bundle: true, write: false,\n   187\t        metafile: true, format: 'esm', conditions, absWorkingDir: fixture(FIXTURE[name]), external: ['react', 'react/*', ...(name === 'axylo' ? [] : ['axylo'])], logLevel: 'silent',\n   188\t      });\n   189\t      return Object.keys(r.metafile.inputs).map(p => path.resolve(fixture(FIXTURE[name]), p)).filter(p => p === dev || p === prod);\n   190\t    };\n   191\t    expect(await entry(['development'])).toEqual([dev]);\n   192\t    expect(await entry(['production'])).toEqual([prod]);\n   193\t  });\n   194\t\n   195\t  it('neither file refers to the build-time __DEV__ constant', () => {\n   196\t    for (const file of [dev, prod]) expect(fs.readFileSync(file, 'utf8'), file).not.toMatch(/\\b__DEV__\\b/);\n   197\t  });\n   198\t\n   199\t  it('the production file carries none of the development-only text found in the source', async () => {\n   200\t    const found = await devOnlyTokens(name);\n   201\t    console.info(`${name} development-only text: ${JSON.stringify(found)}`);\n   202\t    expect(found.length).toBeGreaterThan(0);\n   203\t    const devCode = fs.readFileSync(dev, 'utf8');\n   204\t    const prodCode = fs.readFileSync(prod, 'utf8');\n   205\t    expect(found.filter(t => !devCode.includes(t)), 'missing from the development file').toEqual([]);\n   206\t    expect(found.filter(t => prodCode.includes(t)), 'present in the production file').toEqual([]);\n   207\t  });\n   208\t});\n    53\t    }\n    54\t  });\n    55\t\n    56\t  it('is built from its own source only: no node_modules input when its entry is bundled as the release build does', async () => {\n    57\t    const src = path.join(repo, SOURCE[name]);\n    58\t    const r = await build({\n    59\t      entryPoints: [path.join(src, 'index.ts')], bundle: true, write: false, metafile: true, format: 'esm', target: 'es2022',\n    60\t      minify: true, define: { __DEV__: 'false' }, legalComments: 'none', logLevel: 'silent', absWorkingDir: repo,\n    61\t      external: ['react', 'react/jsx-runtime', 'react-dom', 'axylo'],\n    62\t    });\n    63\t    const inputs = Object.keys(r.metafile.inputs).map(p => path.resolve(repo, p));\n    64\t    expect(inputs.length).toBeGreaterThan(0);\n    65\t    expect(inputs.filter(p => !p.startsWith(src + path.sep))).toEqual([]);\n    66\t  });\n    67\t\n    68\t  it('has no copied licence or copyright header in its source or its shipped files', () => {\n    69\t    const src = path.join(repo, SOURCE[name]);\n    70\t    const sources = fs.readdirSync(src, { recursive: true, encoding: 'utf8' }).filter(f => /\\.[cm]?[jt]sx?$/.test(f)).map(f => path.join(src, f));\n    71\t    const shipped = manifest().packages[name].files.filter(f => !/^(LICENSE|README\\.md|package\\.json)$/.test(f)).map(f => installed(name, f));\n    72\t    const hits = [...sources, ...shipped].filter(f => HEADER.test(fs.readFileSync(f, 'utf8')));\n    73\t    expect(hits.map(f => path.relative(repo, f))).toEqual([]);\n    74\t  });\n    75\t});\n    76\t\n    77\tdescribe('THIRD-PARTY-NOTICES.md', () => {\n    78\t  const text = fs.readFileSync(path.join(repo, 'THIRD-PARTY-NOTICES.md'), 'utf8');\n    79\t\n    80\t  it('covers both published packages and states that they ship no third-party code', () => {\n    81\t    for (const name of NAMES) expect(text).toContain(`\\`${name}\\``);\n    82\t    expect(text).toMatch(/contain no third-party code/);\n    83\t  });\n    84\t});\n123:      expect(await closePage(dirty)).toEqual([]);\n145:      expect(await closePage(page)).toEqual([]);\n170:      expect(await closePage(page)).toEqual([]);\n175:describe('C5 values left out', () => {\n177:    it(`C5 compact ${kind}: with the dirty fixture the description says ${DIRTY.leftOut} values are not shown and a small corner marker appears, with a text equivalent`, async () => {\n187:      const nearCorner = (c.x - fb.x < 4 || fb.x + fb.width - (c.x + c.width) < 4) && (c.y - fb.y < 4 || fb.y + fb.height - (c.y + c.height) < 4);\n188:      expect(nearCorner).toBe(true);\n192:      expect(await closePage(page)).toEqual([]);\n","exit_code":0,"status":"completed"}}
