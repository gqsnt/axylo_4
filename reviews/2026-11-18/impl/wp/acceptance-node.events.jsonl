ate', timeZone } });\n      r.frames();\n      expect(codes(r)).toEqual([]);\n      check(r, type, [instant, following], ['Feb 29, 2024', 'Mar 1, 2024']);\n    }\n  });\n\n  it(\"'`F4 ${type}: mixing calendar dates with a wall time and an instant reports both incompatible rows (reading: a clear majority fixes the axis type)`, () => {\n    const r = chart(type, [\n      { x: '\"'2024-02-29', y: 3 }, { x: '2024-03-01T02:30', y: 40 },\n      { x: '2024-02-29T16:00Z', y: 50 }, { x: '2024-03-01', y: 4 },\n    ]);\n    r.frames();\n    expect(r.controller.handle.diagnostics).toMatchObject([{ code: 'AX107', field: 'x', rows: [1, 2] }]);\n    expect(lastModel(r).summary).toContain('maximum 4');\n    expect(lastModel(r).summary).toContain('Values not shown: 2.');\n    if (type \"'!== '\"'compact') expect(rows(r).map(row => row[0])).toEqual(['Feb 29, 2024', 'Mar 1, 2024']);\n  });\n}\nEOF\ncat >> packages/axylo/test/acceptance/dx-diagnostics.test.ts <<'EOF'\n\nit('F3 line: AX109 warns about seconds supplied as time and maps the values as milliseconds', () => {\n  const r = chart('line', [{ x: 1_700_000_000, y: 6 }, { x: 1_700_060_000, y: 8 }], {\n    x: { field: 'x', type: 'time', timeZone: 'UTC' },\n  });\n  r.frames();\n  expect(codes(r)).toEqual(['AX109']);\n  expect(r.controller.handle.diagnostics[0]?.message).toMatch(/multiply them by 1,000/i);\n  expect(axisDates()).toEqual(['Jan 20, 1970, 4:13:20 PM UTC', 'Jan 20, 1970, 4:14:20 PM UTC']);\n  expect(pathRuns(marks(r, 'path')[0]\"'!.xy)[0]).toHaveLength(2);\n\n  function axisDates() {\n    return rows(r).map(row => row[0]);\n  }\n});\nEOF'","aggregated_output":"","exit_code":0,"status":"completed"}}
