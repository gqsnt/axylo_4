replaceAll('\\\\u00a0', ' ')).toBe('12,5 %');\n  expect(reading(r, first)?.replaceAll('\\\\u00a0', ' ')).toContain('12,5 %');\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
