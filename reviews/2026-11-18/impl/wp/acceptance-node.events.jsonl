P8\n[\n  {\n    \"id\": \"F1\",\n    \"statement\": \"Bar and area value axes always include zero; a domain that excludes zero is widened and raises AX110.\",\n    \"appliesTo\": [\n      \"area\",\n      \"bar\",\n      \"compact\"\n    ],\n    \"notApplicable\": {\n      \"line\": \"Only bars and areas have this baseline or stack rule.\",\n      \"scatter\": \"Only bars and areas have this baseline or stack rule.\",\n      \"donut\": \"Donut uses slices, without Cartesian axes.\"\n    },\n    \"evidence\": {\n      \"area\": [\n        {\n          \"kind\": \"property\",\n          \"file\": \"packages/axylo/test/scale/domain.test.ts\",\n          \"title\": \"with includeZero always contains zero, author domain or not\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/view/view.test.ts\",\n          \"title\": \"widens area author domains to zero and reports AX110\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/scene/scene.test.ts\",\n          \"title\": \"uses a zero baseline for an unstacked area backed by a borrowed Float32 column\"\n        }\n      ],\n      \"bar\": [\n        {\n          \"kind\": \"property\",\n          \"file\": \"packages/axylo/test/scale/domain.test.ts\",\n          \"title\": \"with includeZero always contains zero, author domain or not\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/view/view.test.ts\",\n          \"title\": \"widens bar author domains to zero and reports AX110\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/scene/scene.test.ts\",\n          \"title\": \"uses projected zero as the baseline and represents missing and zero bars separately\"\n        }\n      ]\n    },\n    \"weak\": {\n      \"compact\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/view/review.test.ts\",\n          \"title\": \"reports AX130, AX131 and AX110 only when their conditions newly apply\",\n          \"reason\": \"Checks AX110 for a compact area with an author domain, but does not inspect its baseline or exercise compact bars.\"\n        }\n      ]\n    }\n  },\n  {\n    \"id\": \"F2\",\n    \"statement\": \"Missing values are never drawn as zero and never bridged unless the author asks; readouts say “No data”.\",\n    \"appliesTo\": [\n      \"line\",\n      \"area\",\n      \"bar\",\n      \"scatter\",\n      \"donut\",\n      \"compact\"\n    ],\n    \"notApplicable\": {},\n    \"weak\": {\n      \"line\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/data/normalize.test.ts\",\n          \"title\": \"represents seven explicit nulls and seven deleted daily rows with the same disallowed joins\",\n          \"reason\": \"Compares slot tags and diagnostics but does not compare the drawn gaps or readouts.\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/data/normalize.test.ts\",\n          \"title\": \"imputes zero for absent fields, nulls, gaps, and no row, with no invented provenance\",\n          \"reason\": \"Checks stored zero imputation without checking drawn marks and all readouts.\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/scene/scene.test.ts\",\n          \"title\": \"packs the exact projected vertices and a pen lift, and shows the isolated value\",\n          \"reason\": \"Checks one fixture’s gap and isolated mark but does not exercise deleted steps, zero imputation or accessible readouts.\"\n        },\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/lookup/aligned.test.ts\",\n          \"title\": \"reads values, absent observations, and explicit nulls in series order\",\n          \"reason\": \"Checks missing and unobserved tooltip values but does not check table cells or announcements.\"\n        }\n      ],\n      \"area\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/simplify/simplify.test.ts\",\n          \"title\": \"preserves each boundary’s own extremes and pairs matching endpoints across breaks\",\n          \"reason\": \"Checks supplied breaks in area boundaries but does not check how missing rows or imputation produce those breaks.\"\n        }\n      ],\n      \"bar\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/scene/scene.test.ts\",\n          \"title\": \"uses projected zero as the baseline and represents missing and zero bars separately\",\n          \"reason\": \"Distinguishes missing from zero at the baseline, but does not check step imputation or missing-value readouts.\"\n        }\n      ],\n      \"scatter\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/data/normalize.test.ts\",\n          \"title\": \"sorts scatter points by x then y and retains provenance while omitting invalid points\",\n          \"reason\": \"Checks invalid and missing rows at normalization, but does not exercise the declared zero-imputation path.\"\n        }\n      ],\n      \"donut\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/view/view.test.ts\",\n          \"title\": \"lists zero and null entries with no arcs and leaves an all-zero ring empty\",\n          \"reason\": \"Checks that null does not produce an arc but does not check “No data” in reader-facing text.\"\n        }\n      ],\n      \"compact\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/scene/scene.test.ts\",\n          \"title\": \"draws compact paths without axes, references, or regular markers but keeps isolated points\",\n          \"reason\": \"Exercises compact line gaps only and does not check missing compact bar or area marks.\"\n        }\n      ]\n    }\n  },\n  {\n    \"id\": \"F3\",\n    \"statement\": \"Input that cannot be plotted as given is reported, never guessed.\",\n    \"appliesTo\": [\n      \"line\",\n      \"area\",\n      \"bar\",\n      \"scatter\",\n      \"donut\",\n      \"compact\"\n    ],\n    \"notApplicable\": {},\n    \"weak\": {\n      \"line\": [\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/chart/data.browser.test.ts\",\n          \"prefix\": \"dirty input (spec 3.5, F12)\",\n          \"reason\": \"Checks three dirty-input codes and the note, but does not cover the full diagnostic registry and drawing outcomes.\"\n        }\n      ],\n      \"area\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/core/validate.test.ts\",\n          \"title\": \"validate reports the combined dirty fixture as AX102, AX103 and AX106, once each\",\n          \"reason\": \"Checks three codes through validate without asserting drawing or disclosures.\"\n        }\n      ],\n      \"bar\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/core/validate.test.ts\",\n          \"title\": \"validate reports the combined dirty fixture as AX102, AX103 and AX106, once each\",\n          \"reason\": \"Checks three codes through validate without asserting drawing or disclosures.\"\n        }\n      ],\n      \"scatter\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/core/validate.test.ts\",\n          \"title\": \"validate works for scatter and donut\",\n          \"reason\": \"Checks one diagnostic for each type without verifying other applicable codes or what the reader sees.\"\n        }\n      ],\n      \"donut\": [\n        {\n          \"kind\": \"unit\",\n          \"file\": \"packages/axylo/test/core/validate.test.ts\",\n          \"title\": \"validate works for scatter and donut\",\n          \"reason\": \"Checks one diagnostic for each type without verifying other applicable codes or what the reader sees.\"\n        }\n      ],\n      \"compact\": [\n        {\n          \"kind\": \"browser\",\n          \"file\": \"packages/axylo/test/browser/chart/render.browser.test.ts\",\n          \"title\": \"with values left out, the description says so and a corner marker appears; there is no note element\",\n// Shared, deterministic datasets. Every library receives exactly these values.\nexport function rng(seed) {\n  let s = seed >>> 0;\n  return () => { s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };\n}\nconst DAY = 864e5;\nconst START = Date.UTC(2026, 0, 1);\n\n// Task \"trend\": 3 series x 120 daily points (UTC midnights). \"Referral\" has a 7-day outage (nulls).\nexport const trend = (() => {\n  const r = rng(7), n = 120;\n  const t = Array.from({ length: n }, (_, i) => START + i * DAY);\n  const mk = (base, growth, noise, season) => t.map((_, i) => Math.round(base + growth * i + season * Math.sin((i / 7) * 2 * Math.PI) + (r() - 0.5) * noise));\n  const series = [\n    { name: 'Direct', values: mk(31000, 120, 4000, 3000) },\n    { name: 'Organic search', values: mk(18000, 60, 3000, 2500) },\n    { name: 'Referral', values: mk(4200, -8, 1200, 400) },\n  ];\n  for (let i = 60; i < 67; i++) series[2].values[i] = null;\n  return { title: 'Daily sessions by channel', yTitle: 'Sessions', t, series };\n})();\n\n// Task \"bars\": one series, all values between 82 and 97 (tests zero baseline), one long label.\nexport const bars = {\n  title: 'Customer satisfaction by team', yTitle: 'Satisfied (%)', name: 'Satisfied (%)',\n  categories: ['Billing', 'Customer Success & Onboarding', 'Platform', 'Mobile', 'Data', 'Security', 'Sales Eng.'],\n  values: [94, 88, 97, 82, 91, 85, 90],\n};\n\n// Task \"parts\": six shares, two of them small.\nexport const parts = {\n  title: 'Sessions by browser', name: 'Share (%)',\n  labels: ['Chrome', 'Safari', 'Edge', 'Firefox', 'Samsung Internet', 'Other'],\n  values: [46.2, 27.5, 14.1, 8.9, 2.1, 1.2],\n};\n\n// Task \"dirty\": values a real app sends by mistake. Correct reading: Wed, Thu, Sat are missing; Fri is ambiguous (a string).\nexport const dirty = {\n  title: 'Dirty input', name: 'Value',\n  categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],\n  values: [10, 20, null, NaN, '40', undefined, 70],\n};\n\n// Task \"scale\": one series, n points, one per minute, random walk.\nexport function scale(n) {\n  const r = rng(1), t = new Array(n), y = new Array(n);\n  let v = 100;\n  for (let i = 0; i < n; i++) { v += (r() - 0.5) * 2; t[i] = START + i * 60000; y[i] = Math.round(v * 100) / 100; }\n  return { title: `${n.toLocaleString('en-US')} points`, name: 'Value', t, y };\n}\n\n// Task \"stream\": 600-point window; the harness then pushes one new point per frame.\nexport function stream() {\n  const d = scale(600);\n  const r = rng(2);\n  let v = d.y[d.y.length - 1], i = d.t.length;\n  return { ...d, title: 'Streaming window', next: () => { v += (r() - 0.5) * 2; return [START + i++ * 60000, Math.round(v * 100) / 100]; } };\n}\n\n// Task \"dates\": the trend series keyed by calendar-date strings (no time, no zone), to separate\n// \"this library shifts instants into the viewer's zone\" from \"this library cannot show a date as a date\".\nexport const dates = { ...trend, days: trend.t.map(t => new Date(t).toISOString().slice(0, 10)) };\n\n// Tasks \"dirty-null\", \"dirty-nan\", \"dirty-string\", \"dirty-undefined\": one bad value at a time, in a line of\n// seven otherwise valid points, so each outcome can be attributed to one kind of input.\nexport function dirtyOne(kind) {\n  const bad = { null: null, nan: NaN, string: '40', undefined: undefined }[kind];\n  return { ...dirty, title: `One bad value: ${kind}`, values: [10, 20, 30, bad, 50, 60, 70] };\n}\n","exit_code":0,"status":"completed"}}
