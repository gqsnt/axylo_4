hanged presentation even though the value is still drawn`, () => {\n    const input = [{ x: type === '\"'donut' ? 'A' : 1, y: 1 }, { x: type === 'donut' ? 'B' : 2, y: 2 }];\n    const r = chart(type, input, {\n      [type === 'donut' ? 'value' : 'y']: { field: 'y', format: (value: number) => {\n        if (value === 2) throw new Error('fixture');\n        return String(value);\n      } },\n    });\n    r.frames();\n    expect(codes(r)).toEqual(['AX160']);\n    const note = 'Values shown differently from the data: 1. See table.';\n    expect(lastModel(r).note).toBe(note);\n    expect(lastModel(r).summary).toContain(note);\n    expect(rows(r).map(row => row[type === 'scatter' ? 2 : 1])).toEqual(['1', '2']);\n  });\n}\nEOF\ncat > packages/axylo/test/acceptance/compact.test.ts <<'EOF'\nimport { expect, it } from 'vitest';\nimport { aligned, axes, chart, codes, committed, expectCompact, lastModel, marks, pathRuns, plot, scene } from './model';\n\nfor (const kind of aligned) {\n  it(\"'`C1 compact: ${kind} has a name and full summary, and the committed model is static`, () => {\n    const r = chart('\"'compact', [{ x: 1, y: 6 }, { x: 2, y: 4 }, { x: 3, y: 8 }], {\n      title: undefined, description: 'Collected outdoors.',\n    }, undefined, kind);\n    r.frames();\n    expect(codes(r)).toEqual(['AX140']);\n    const capitalized = kind[0]\"'!.toUpperCase() + kind.slice(1);\n    expect(lastModel(r)).toMatchObject({ compact: true, name: capitalized + '\"' chart of y by x', summaryVisible: false });\n    expect(lastModel(r).summary).toContain('1 series');\n    expect(lastModel(r).summary).toContain('x from 1 to 3');\n    expect(lastModel(r).summary).toContain('minimum 4, maximum 8, last 8');\n    expect(lastModel(r).summary).toContain('Collected outdoors.');\n    expectCompact(r);\n  });\n\n  it(\"'`C2 compact: ${kind} draws only data marks, commits the sorted final geometry in one frame, and ignores public zoom`, () => {\n    const r = chart('\"'compact', [{ x: 3, y: 8 }, { x: 1, y: 6 }, { x: 2, y: 4 }], {\n      reference: [{ y: 10, label: 'Target' }],\n    }, undefined, kind);\n    r.frames();\n    const initial = scene(r);\n    expect(initial.marks.length).toBeGreaterThan(0);\n    expect(initial.marks.every(mark => ['rects', 'area', 'path', 'points'].includes(mark.type))).toBe(true);\n    expect(lastModel(r).summary).toContain('last 8');\n    r.controller.handle.zoom([1, 2]);\n    r.frames();\n    expect(scene(r)).toEqual(initial);\n    r.controller.handle.update({ data: [{ x: 3, y: 20 }, { x: 1, y: 5 }, { x: 2, y: 9 }] });\n    expect(scene(r)).toBe(initial);\n    expect(r.frames()).toBe(1);\n    expect(scene(r)).not.toEqual(initial);\n    expect(lastModel(r).summary).toContain('minimum 5, maximum 20, last 20');\n    expectCompact(r);\n  });\n\n  it(\"'`C3 compact: ${kind} fills a 24 by 16 CSS-pixel container and expands when the host measures a larger one`, () => {\n    const r = chart('\"'compact', [{ x: 1, y: 3 }, { x: 2, y: 8 }], {}, { container: { width: 24, height: 16 } }, kind);\n    r.frames();\n    expect(plot(r)).toMatchObject({ kind: 'compact', plot: { x: 0, y: 0, width: 24, height: 16 } });\n    expect(scene(r).marks.length).toBeGreaterThan(0);\n    r.container = { width: 137, height: 32 };\n    r.controller.invalidate.resize();\n    r.frames();\n    expect(plot(r)).toMatchObject({ kind: 'compact', plot: { x: 0, y: 0, width: 137, height: 32 } });\n    expect(codes(r)).toEqual([]);\n  });\n\n  it(\"'`C5 compact: ${kind} supplies omission text for the corner marker and repeats the count in its summary`, () => {\n    const r = chart('\"'compact', [{ x: 1, y: 4 }, { x: 2, y: Infinity }, { x: 3, y: 6 }], {}, undefined, kind);\n    r.frames();\n    expect(codes(r)).toEqual(['AX103']);\n    expect(lastModel(r)).toMatchObject({ compact: true, note: 'Values not shown: 1. See table.' });\n    expect(lastModel(r).summary).toContain('Values not shown: 1.');\n    expect(lastModel(r).summary).toContain('minimum 4, maximum 6, last 6');\n    expectCompact(r);\n    expect(committed(r).reader.table).toBeNull();\n  });\n}\n\nfor (const kind of ['line', 'area'] as const) {\n  it(\"'`C4 compact: two ${kind} strokes use distinct paint bindings and dashes and AX131 suggests one series`, () => {\n    const r = chart('\"'compact', [{ x: 1, a: 3, b: 7 }, { x: 2, a: 4, b: 5 }], { y: ['a', 'b'] }, undefined, kind);\n    r.frames();\n    const [first, second] = marks(r, 'path');\n    expect(first?.stroke).toEqual({ kind: 'series', index: 0 });\n    expect(second?.stroke).toEqual({ kind: 'series', index: 1 });\n    expect(first?.dash.normal).not.toEqual(second?.dash.normal);\n    expect(pathRuns(first\"'!.xy)[0]).toHaveLength(2);\n    expect(axes(r).y.domain[1]).toBeGreaterThanOrEqual(7);\n    expect(r.controller.handle.diagnostics).toMatchObject([{ code: '\"'AX131', message: expect.stringMatching(/one series/i) }]);\n    expectCompact(r);\n  });\n}\nEOF\ncat > packages/axylo/test/acceptance/dx-controller.test.ts <<'EOF'\nimport { expect, it } from 'vitest';\nimport { validate } from '../../src/index';\nimport type { ChartKind } from '../../src/core/controller';\nimport type { Diagnostic } from '../../src/public';\nimport { at, chart, codes, committed, lastModel, marks, rows, scene, types, type Recording, type Type } from './model';\n\nconst validateOptions = validate as (type: ChartKind, options: unknown) => Diagnostic[];\nconst input = (type: Type) => type === 'donut' ? [{ x: 'A', y: 6 }, { x: 'B', y: 8 }] : [{ x: 1, y: 6 }, { x: 2, y: 8 }];\nconst kindFor = (type: Type) => type === 'compact' ? 'line' : type;\nconst encodingFor = (type: Type) => type === 'donut' ? 'value' : 'y';\nconst valueColumn = (type: Type) => type === 'scatter' ? 2 : 1;\n\nfunction checkValues(r: Recording, type: Type, expected: readonly string[]) {\n  if (type === 'compact') {\n    expect(lastModel(r).summary).toContain('last ' + expected.at(-1));\n  } else {\n    expect(rows(r).map(row => row[valueColumn(type)])).toEqual(expected);\n  }\n}\n\nfor (const type of types) {\n  it(\"'`DX2 ${type}: supported row and column forms draw the same fixture and preserve caller row indexes in diagnostics`, () => {\n    const donut = type === '\"'donut';\n    const xs = donut ? ['A', 'B', 'C'] : [1, 2, 3];\n    const wide = [{ x: xs[0], y: 6 }, { x: xs[1], y: Infinity }, { x: xs[2], y: 8 }];\n    const columns = { columns: { x: donut ? xs : new Float64Array(xs as number[]), y: new Float32Array([6, Infinity, 8]) } };\n    const long = wide.map(row => ({ ...row, s: 'y' }));\n    const data = [chart(type, wide), chart(type, columns)];\n    if (\"'!donut) data.push(chart(type, long, { series: '\"'s' }));\n    if (\"'!donut && type !== '\"'scatter') data.push(chart(type, wide, { y: ['y'] }));\n    for (const r of data) {\n      r.frames();\n      expect(r.controller.handle.diagnostics).toMatchObject([{ code: 'AX103', field: 'y', rows: [1] }]);\n      expect(lastModel(r).summary).toContain('Values not shown: 1.');\n      const expected = type === 'scatter' ? ['6', '8'] : ['6', 'No data', '8'];\n      checkValues(r, type, expected);\n    }\n    for (const r of data.slice(1)) expect(scene(r)).toEqual(scene(data[0]\"'!));\n  });\n\n  it(`DX3 ${type}: untyped misspelled fields, numeric strings mixed with numbers and inapplicable keys report their codes`, () => {\n    const encoding = encodingFor(type);\n    const data = input(type);\n    const misspelled = chart(type, data, { [encoding]: '\"'wrong' });\n    expect(codes(misspelled)).toEqual(['AX101']);\n    misspelled.frames();\n    expect(lastModel(misspelled).message).toBe('The chart could not be drawn.');\n    const mixed = chart(type, [data[0], { ...data[1], y: 'oops' }]);\n    expect(codes(mixed)).toEqual(['AX106']);\n    mixed.frames();\n    expect(lastModel(mixed).summary).toContain('Values not shown: 1.');\n    const unsupported = chart(type, data, type === 'bar' ? { stacked: true } : { horizontal: true });\n    expect(codes(unsupported)).toEqual(['AX150']);\n    unsupported.frames();\n    expect(lastModel(unsupported).message).toBeNull();\n    checkValues(unsupported, type, ['6', '8']);\n  });\n\n  it(\"'`DX4 ${type}: reports one field, caller row index, chart name and a fix synchronously`, () => {\n    const received: Diagnostic[] = [];\n    const r = chart(type, [...input(type), { x: type === '\"'donut' ? 'C' : 3, y: Infinity }], {\n      onDiagnostic: (d: Diagnostic) => received.push(d),\n    });\n    expect(received).toMatchObject([{\n      code: 'AX103', level: 'warning', chart: 'Measurements', field: 'y', rows: [2],\n      message: expect.stringMatching(/y.*row 2.*check the calculation.*send null/i),\n    }]);\n    r.frames();\n    r.frames();\n    expect(received).toHaveLength(1);\n    expect(r.printed.filter(message => message.includes('AX103'))).toHaveLength(1);\n    expect(lastModel(r).summary).toContain('Values not shown: 1.');\n  });\n\n  it(\"'`DX5 ${type}: replace then append then zoom in one turn switches marks, text and lookup together`, () => {\n    const donut = type === '\"'donut';\n    const r = chart(type, input(type));\n    r.frames();\n    const before = committed(r);\n    const oldScene = scene(r);\n    const oldText = r.texts.at(-1);\n    const count = r.commits;\n    const handle = r.controller.handle;\n    handle.update({ data: [{ x: donut ? 'C' : 10, y: 21 }, { x: donut ? 'D' : 20, y: 35 }] });\n    handle.append([{ x: donut ? 'E' : 30, y: 72 }]);\n    handle.zoom([20, 30]);\n    expect(r.committed).toBe(before);\n    expect(scene(r)).toBe(oldScene);\n    expect(r.texts.at(-1)).toBe(oldText);\n    expect(lastModel(r).summary).not.toContain('72');\n    expect(r.pending).toBe(1);\n    expect(r.frames()).toBe(1);\n    expect(r.commits).toBe(count + 1);\n    expect(scene(r)).not.toEqual(oldScene);\n    expect(lastModel(r).summary).toContain('72');\n    checkValues(r, type, donut || type === 'compact' ? ['21', '35', '72'] : ['35', '72']);\n    if (type \"'!== '\"'compact') expect(committed(r).lookup.count).toBe(donut ? 3 : 2);\n    if (\"'!donut && type !== '\"'compact') expect(r.texts.at(-1)).not.toEqual(oldText);\n  });\n\n  it(\"'`DX5 ${type}: a present patch key replaces the whole field, undefined restores the default, and absent keys stay`, () => {\n    const key = encodingFor(type);\n    const r = chart(type, input(type), { [key]: { field: '\"'y', unit: 'old unit' }, title: 'Retained', table: false });\n    r.frames();\n    expect(lastModel(r).summary).toContain('8 old unit');\n    expect(committed(r).reader.table).toBeNull();\n    r.controller.handle.update({ [key]: { field: 'y', label: 'Measure' }, table: undefined });\n    r.frames();\n    expect(lastModel(r).summary).not.toContain('old unit');\n    expect(lastModel(r).title?.text).toBe('Retained');\n    checkValues(r, type, ['6', '8']);\n    if (type \"'!== '\"'compact') expect(committed(r).reader.table?.headers).toContain('Measure');\n  });\n\n  it(\"'`DX5 ${type}: strict create, update and append reject warnings synchronously and keep the last valid chart`, () => {\n    const bad = { x: type === '\"'donut' ? 'C' : 3, y: Infinity };\n    expect(() => chart(type, [...input(type), bad], { strict: true }, { console: false })).toThrow(/AX103/);\n    const r = chart(type, input(type), { strict: true }, { console: false });\n    const handle = r.controller.handle;\n    r.frames();\n    const before = committed(r);\n    const drawn = scene(r);\n    expect(() => handle.update({ data: [...input(type), bad] })).toThrow(/AX103/);\n    expect(() => handle.append([bad])).toThrow(/AX103/);\n    expect(codes(r)).toEqual([]);\n    expect(r.committed).toBe(before);\n    r.frames();\n    expect(scene(r)).toBe(drawn);\n    handle.append([{ ...bad, y: 10 }]);\n    r.frames();\n    checkValues(r, type, ['6', '8', '10']);\n  });\n\n  it(\"'`DX5 ${type}: destroy cancels the pending frame and later calls have no effect`, () => {\n    const r = chart(type, input(type));\n    const handle = r.controller.handle;\n    expect('\"'resize' in handle).toBe(false);\n    expect(r.pending).toBe(1);\n    handle.destroy();\n    handle.update({ title: 'Late' });\n    handle.append(input(type));\n    handle.zoom([1, 2]);\n    handle.destroy();\n    expect(r.disposed).toBe(1);\n    expect(r.frames()).toBe(0);\n    expect(r.draws).toEqual([]);\n    expect(r.texts).toEqual([]);\n    expect(r.models).toEqual([]);\n    expect(r.committed).toBeNull();\n  });\n\n  it(\"'`DX8 ${type}: Node import and validate give the same call-time diagnostics as the controller`, () => {\n    expect(typeof document).toBe('\"'undefined');\n    const end = [...input(type), { x: type === 'donut' ? 'C' : 3, y: NaN }];\n    const options = {\n      title: 'Measurements', data: end, ...(type === 'donut' ? { label: 'x', value: 'y' } : { x: 'x', y: 'y' }),\n      compact: type === 'compact' || undefined,\n    };\n    const r = chart(type, end);\n    const found = validateOptions(kindFor(type), options);\n    expect(found).toMatchObject([{ code: 'AX103', field: 'y', rows: [2], chart: 'Measurements' }]);\n    expect(found).toEqual(r.controller.handle.diagnostics);\n    expect(r.draws).toEqual([]);\n  });\n\n  it(\"'`DX6 ${type}: a named color reaches the theme by series key as other entries change`, () => {\n    const donut = type === '\"'donut';\n    const target = donut ? 'B' : 'North';\n    const colors = { [target]: 'rebeccapurple' };\n    const data = donut ? [{ x: 'A', y: 4 }, { x: 'B', y: 6 }] :\n      [{ x: 1, y: 4, s: 'South' }, { x: 1, y: 6, s: 'North' }, { x: 2, y: 7, s: 'North' }];\n    const r = chart(type, data, { colors, ...(donut ? {} : { series: 's' }) });\n    r.frames();\n    expect(r.themeCalls.at(-1)).toEqual({ keys: donut ? ['A', 'B'] : ['South', 'North'], colors });\n    r.controller.handle.update({ data: data.filter(row => 's' in row ? row.s === target : row.x === target) });\n    r.frames();\n    expect(r.themeCalls.at(-1)).toEqual({ keys: [target], colors });\n    const painted = donut ? marks(r, 'arcs')[0]?.fills[0] : type === 'bar' ? marks(r, 'rects')[0]?.fill :\n      type === 'scatter' ? marks(r, 'points')[0]?.fill : marks(r, 'path')[0]?.stroke;\n    expect(painted).toEqual({ kind: 'series', index: 0 });\n    if (\"'!donut && type !== '\"'scatter' && type \"'!== '\"'compact') expect(at(r, 1).rows[0]?.seriesLabel).toBe(target);\n  });\n}\n\nit('DX3 line: untyped wide y combined with series raises AX150 and still reads the wide field', () => {\n  const r = chart('line', [{ x: 1, y: 4, s: 'Named' }, { x: 2, y: 8, s: 'Named' }], { y: ['y'], series: 's' });\n  expect(codes(r)).toEqual(['AX150']);\n  r.frames();\n  expect(at(r, 1).rows.map(row => [row.seriesLabel, row.value])).toEqual([['y', '4']]);\n});\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_36","type":"command_execution","command":"/bin/bash -lc \"cat > packages/axylo/test/acceptance/type-matrix.test.ts <<'EOF'\nimport { expect, it } from 'vitest';\nimport { stepAcross, targetOf } from '../../src/core/focus';\nimport { aligned, at, axes, chart, codes, committed, day, expectGeometry, lastModel, marks, pixel, plot, reading, refAt, rows, seriesRows, walk } from './model';\n\nconst xy = [{ x: 1, y: 6 }, { x: 2, y: 8 }, { x: 3, y: 4 }];\nconst donut = [{ x: 'First', y: 3 }, { x: 'Zero', y: 0 }, { x: 'Missing', y: null }, { x: 'Last', y: 1 }];\n\nfor (const kind of aligned) {\n  it(\"'`T-keyboard-${kind} ${kind}: visits once per x then switches through series in declared order (reading: x and series use their own keys)`, () => {\n    const categories = kind === '\"'bar';\n    const values = categories ? ['West', 'East'] : [1, 2];\n    const r = chart(kind, [\n      { x: values[0], s: 'Website', y: 11 }, { x: values[1], s: 'Website', y: 22 },\n      { x: values[0], s: 'Phone', y: 33 }, { x: values[1], s: 'Phone', y: 44 },\n    ], { series: 's' });\n    r.frames();\n    const { view, lookup } = committed(r);\n    if (view.kind === 'donut' || view.kind === 'scatter') throw new Error('Expected aligned data');\n    const [first, second] = categories ? [0, 1] : [1, 2];\n    expect(stepAcross(view, null, 'first')).toBe(first);\n    expect(stepAcross(view, first, 'next')).toBe(second);\n    expect(stepAcross(view, second, 'next')).toBeNull();\n    expect(stepAcross(view, second, 'previous')).toBe(first);\n    for (const [x, expected] of [[first\"'!, ['\"'11', '33']], [second\"'!, ['\"'22', '44']]] as const) {\n      const selected = refAt(r, x);\n      const next = lookup.step(selected, 'series-next');\n      expect(lookup.datum(selected)?.seriesLabel).toBe('Website');\n      expect(lookup.datum(next\"'!)?.seriesLabel).toBe('\"'Phone');\n      expect(lookup.step(next, 'series-previous')).toEqual(selected);\n      expect([lookup.datum(selected)?.value, lookup.datum(next\"'!)?.value]).toEqual(expected);\n    }\n  });\n\n  it(`T-pointer-${kind} ${kind}: picks ${kind === '\"'bar' ? 'the category band under the pointer at either edge' : 'the nearest x regardless of pointer height'}\"'`, () => {\n    for (const horizontal of kind === '\"'bar' ? [false, true] : [false]) {\n      const r = chart(kind, kind === 'bar' ? [{ x: 'One', y: 10 }, { x: 'Two', y: 3 }, { x: 'Three', y: 8 }] : xy, horizontal ? { horizontal } : {});\n      r.frames();\n      const { x } = axes(r);\n      const { plot: box } = plot(r);\n      const projection = kind === 'bar' ? [0, 1, 2] : [1, 2, 3];\n      projection.forEach(position => {\n        const across = pixel(x, position);\n        const neighbor = kind === 'bar' ? 0 : position === 3 ? -1 : 1;\n        const near = neighbor ? across + (pixel(x, position + neighbor) - across) / 4 : across;\n        for (const side of [1, (horizontal ? box.width : box.height) - 1]) {\n          const [px, py] = horizontal ? [box.x + side, near] : [near, box.y + side];\n          expect(committed(r).lookup.pick(px, py)).toEqual({ kind: 'x', x: position });\n        }\n      });\n    }\n  });\n\n  it(\"'`T-tooltip-${kind} ${kind}: lists visible series in order and distinguishes No observation from No data`, () => {\n    const data = [\n      { x: 1, y: 5, s: '\"'Alpha' }, { x: 2, y: 6, s: 'Alpha' }, { x: 3, y: 7, s: 'Alpha' },\n      { x: 1, y: 8, s: 'Beta' }, { x: 2, y: null, s: 'Beta' },\n      { x: 1, y: 9, s: 'Gamma' }, { x: 3, y: 11, s: 'Gamma' },\n    ];\n    const r = chart(kind, data, { series: 's', ...(kind === 'area' ? { stacked: true } : {}) });\n    r.frames();\n    const readout = at(r, 2);\n    expect(readout.rows.map(row => [row.seriesLabel, row.value])).toEqual([\n      ['Alpha', '6'], ['Beta', 'No data'], ['Gamma', 'No observation'],\n    ]);\n    expect(readout.total).toBe(kind === 'area' ? '6 (incomplete)' : null);\n    const beta = readout.rows[1]\"'!.ref;\n    if (beta.kind !== '\"'aligned') throw new Error('Expected an aligned series');\n    r.controller.actions.toggle(beta.seriesKey);\n    r.frames();\n    expect(at(r, 2).rows.map(row => row.seriesLabel)).toEqual(['Alpha', 'Gamma']);\n    expect(reading(r, refAt(r, 2))).not.toContain('Beta');\n  });\n}\n\nit('T-keyboard-donut donut: steps through all slices in given order including zero and missing and returns in reverse', () => {\n  const r = chart('donut', donut);\n  r.frames();\n  const { lookup } = committed(r);\n  const refs = walk(r);\n  expect(refs.map(ref => lookup.datum(ref)?.seriesLabel)).toEqual(['First', 'Zero', 'Missing', 'Last']);\n  expect(refs.map(ref => lookup.datum(ref)?.value)).toEqual(['3', '0', 'No data', '1']);\n  expect(lookup.step(refs[0]\"'!, '\"'previous')).toBeNull();\n  expect(refs.slice(1).map(ref => lookup.step(ref, 'previous'))).toEqual(refs.slice(0, -1));\n});\n\nit('T-keyboard-scatter scatter: moves by x then y across series and can traverse all points in reverse', () => {\n  const r = chart('scatter', [{ x: 2, y: 1, s: 'B' }, { x: 1, y: 4, s: 'A' }, { x: 1, y: 3, s: 'B' }, { x: 2, y: 2, s: 'A' }], { series: 's' });\n  r.frames();\n  const { lookup } = committed(r);\n  const refs = walk(r);\n  expect(refs.map(ref => lookup.datum(ref)?.row)).toEqual([2, 1, 0, 3]);\n  expect(lookup.step(refs[0]\"'!, '\"'previous')).toBeNull();\n  expect(refs.slice(1).map(ref => lookup.step(ref, 'previous'))).toEqual(refs.slice(0, -1));\n});\n\nit('T-pointer-donut donut: picks clockwise by arc; the hole and outside of the ring yield no slice', () => {\n  const r = chart('donut', donut);\n  r.frames();\n  const { lookup } = committed(r);\n  const arc = marks(r, 'arcs')[0]\"'!;\n  const radius = (arc.r0 + arc.r1) / 2;\n  expect(lookup.pick(arc.cx + radius, arc.cy)).toEqual({ kind: '\"'slice', sliceKey: 'First' });\n  expect(lookup.pick(arc.cx - radius / Math.sqrt(2), arc.cy - radius / Math.sqrt(2))).toEqual({ kind: 'slice', sliceKey: 'Last' });\n  expect(lookup.pick(arc.cx, arc.cy)).toBeNull();\n  expect(lookup.pick(arc.cx + arc.r1 + 1, arc.cy)).toBeNull();\n});\n\nit('T-pointer-scatter scatter: picks the nearest point within 24 CSS pixels and breaks a distance tie by later caller row', () => {\n  const r = chart('scatter', [{ x: 49, y: 5 }, { x: 51, y: 5 }], {\n    x: { field: 'x', domain: [0, 100] }, y: { field: 'y', domain: [0, 10] },\n  });\n  r.frames();\n  const { x, y } = axes(r);\n  const { lookup } = committed(r);\n  const px = pixel(x, 49);\n  const py = y.map(5);\n  expect(lookup.primary(lookup.pick(px, py + 23.5)\"'!)?.kind).toBe('\"'point');\n  expect(lookup.pick(px, py + 24.5)).toBeNull();\n  const tx = (px + pixel(x, 51)) / 2;\n  const tied = lookup.pick(tx, py)\"'!;\n  expect(lookup.datum(lookup.primary(tied)!)?.row).toBe(1);\n});\n\nit('\"'T-tooltip-donut donut: tooltip gives slice label, value and percentage independently', () => {\n  const r = chart('donut', donut);\n  r.frames();\n  const { lookup } = committed(r);\n  const tooltip = lookup.tooltip(targetOf(walk(r)[0]\"'!));\n  expect(tooltip.title).toBe('\"'First');\n  expect(tooltip.rows).toMatchObject([{ seriesLabel: 'First', value: '3', percent: '75%' }]);\n  expect(tooltip.total).toBeNull();\n});\n\nit('T-tooltip-scatter scatter: lists at most eight coincident points, reports the total and includes series, x and y', () => {\n  const r = chart('scatter', Array.from({ length: 10 }, (_, i) => ({ x: 3, y: 6, s: 'Point ' + i })), { series: 's' });\n  r.frames();\n  const { x, y } = axes(r);\n  const { lookup } = committed(r);\n  const tooltip = lookup.tooltip(lookup.pick(pixel(x, 3), y.map(6))\"'!);\n  expect(tooltip.title).toBe('\"'3');\n  expect(tooltip.count).toBe(10);\n  expect(tooltip.rows).toHaveLength(8);\n  expect(tooltip.rows[0]).toMatchObject({ seriesLabel: 'Point 9', x: '3', value: '6', row: 9 });\n  expect(tooltip.rows.every(row => row.x === '3' && row.value === '6')).toBe(true);\n  expect(new Set(tooltip.rows.map(row => row.seriesLabel)).size).toBe(8);\n});\n\nfor (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n  it(\"'`T-zoom-${type} ${type}: numeric, time and calendar-date fields support zoom on x and Reset restores all observations`, () => {\n    const epoch = Date.UTC(2024, 1, 24);\n    for (const [kind, values] of [\n      ['\"'number', [1, 2, 3]],\n      ['time', [epoch, epoch + day, epoch + 2 * day]],\n      ['date', ['2024-02-24', '2024-02-25', '2024-02-26']],\n    ] as const) {\n      const r = chart(type, xy.map((row, i) => ({ ...row, x: values[i]\"'! })), { x: { field: '\"'x', type: kind }, y: { field: 'y', domain: [0, 10] } });\n      const handle = r.controller.handle;\n      r.frames();\n      expect(committed(r).zoom).toBe(true);\n      handle.zoom([values[1], values[2]]);\n      r.frames();\n      expect(committed(r).zoomed).toBe(true);\n      expect(committed(r).lookup.count).toBe(2);\n      expect(axes(r).y.domain).toEqual([0, 10]);\n      expect(committed(r).reader.table?.rowCount).toBe(2);\n      handle.zoom(null);\n      r.frames();\n      expect(committed(r).zoomed).toBe(false);\n      expect(committed(r).reader.table?.rowCount).toBe(3);\n    }\n  });\n\n  it(\"'`T-limit-${type} ${type}: eight series are accepted without AX130; the ninth raises it with all nine still readable`, () => {\n    const r = chart(type, seriesRows(8), { series: '\"'s' });\n    r.frames();\n    expect(codes(r)).toEqual([]);\n    r.controller.handle.update({ data: seriesRows(9) });\n    r.frames();\n    expect(codes(r)).toEqual(['AX130']);\n    expect(lastModel(r).summary).toContain('9 series');\n    const mark = type === 'bar' ? 'rects' : type === 'scatter' ? 'points' : 'path';\n    expect(marks(r, mark)).toHaveLength(9);\n    if (type === 'scatter') expect(committed(r).reader.table?.rowCount).toBe(18);\n    else expect(at(r, 1)).toMatchObject({ count: 9, rows: expect.arrayContaining([expect.objectContaining({ seriesLabel: 'Series 0' })]) });\n  });\n\n  it(\"'`T-reference-${type} ${type}: a line and band extend the appropriate domains, bind to reference paint and are listed in summary and caption`, () => {\n    const r = chart(type, xy, { reference: [{ y: 20, label: '\"'Target' }, { x: [4, 6], label: 'Outage' }] });\n    r.frames();\n    const { x, y } = axes(r);\n    if (x.type === 'band') throw new Error('Expected continuous axis');\n    expect(x.domain[1]).toBeGreaterThanOrEqual(6);\n    expect(y.domain[1]).toBeGreaterThanOrEqual(20);\n    const rule = marks(r, 'rule').find(mark => mark.role === 'reference')\"'!;\n    expect(rule.stroke).toEqual({ kind: '\"'token', name: 'reference' });\n    expectGeometry([rule.y1, rule.y2], [y.map(20), y.map(20)]);\n    const band = marks(r, 'band')[0]\"'!;\n    expect(band.fill).toEqual({ kind: '\"'token', name: 'reference' });\n    expectGeometry([band.box.x, band.box.width], [x.map(4), x.map(6) - x.map(4)]);\n    expect(r.texts.at(-1)?.filter(text => text.role === 'reference').map(text => text.full)).toEqual(expect.arrayContaining(['Target', 'Outage']));\n    for (const text of [lastModel(r).summary, committed(r).reader.table?.caption]) {\n      expect(text).toMatch(/Target at 20/);\n      expect(text).toMatch(/Outage from 4 to 6/);\n    }\n  });\n}\n\nit('T-zoom-bar bar: a category band axis ignores public zoom and retains all rows', () => {\n  const r = chart('bar', [{ x: 'B', y: 6 }, { x: 'A', y: 8 }, { x: 'C', y: 2 }]);\n  r.frames();\n  r.controller.handle.zoom(['A', 'C']);\n  r.frames();\n  expect(committed(r)).toMatchObject({ zoom: false, zoomed: false });\n  expect(rows(r).map(row => row[0])).toEqual(['B', 'A', 'C']);\n});\n\nit('T-zoom-donut donut: even an explicit zoom call leaves arc angles and table rows in slice order', () => {\n  const r = chart('donut', donut);\n  r.frames();\n  r.controller.handle.zoom([0, 1]);\n  r.frames();\n  expect(committed(r)).toMatchObject({ zoom: false, zoomed: false });\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(4);\n  expect(rows(r).map(row => row[0])).toEqual(['First', 'Zero', 'Missing', 'Last']);\n});\n\nit('T-limit-donut donut: eight positive values draw eight arcs; adding a ninth groups only the smallest two', () => {\n  const data = Array.from({ length: 9 }, (_, i) => ({ x: 'Slice ' + i, y: i + 1 }));\n  const r = chart('donut', data.slice(0, 8));\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(16);\n  r.controller.handle.update({ data });\n  r.frames();\n  expect(codes(r)).toEqual(['AX121']);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(16);\n  expect(lastModel(r).summary).toContain('Other (2): 3');\n  expect(rows(r)).toHaveLength(9);\n});\n\nit('T-reference-donut donut: a Cartesian reference option is diagnosed and produces neither reference marks nor reader text', () => {\n  const r = chart('donut', donut, { reference: [{ y: 20, label: 'Target' }] });\n  r.frames();\n  expect(codes(r)).toEqual(['AX150']);\n  expect(marks(r, 'rule')).toEqual([]);\n  expect(marks(r, 'band')).toEqual([]);\n  expect(lastModel(r).summary).not.toContain('Target');\n  expect(committed(r).reader.table?.caption).not.toContain('Target');\n});\nEOF\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
