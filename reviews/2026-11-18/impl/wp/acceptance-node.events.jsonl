{ x: 2, y: 5, s: 'Keep' },\n        { x: 1, y: 9, s: 'Duplicate' }, { x: 1, y: 10, s: 'Duplicate' },\n      ], { series: 's' }, undefined, kind);\n      r.frames();\n      expect(codes(r)).toContain('AX108');\n      expect(r.controller.handle.diagnostics.find(d => d.code === 'AX108')).toMatchObject({ level: 'error', field: 'x', rows: [3] });\n      const drawn = [...marks(r, 'path'), ...marks(r, 'area'), ...marks(r, 'rects'), ...marks(r, 'points')];\n      expect(drawn.length).toBeGreaterThan(0);\n      expect(new Set(drawn.map(mark => mark.series))).toEqual(new Set([0]));\n      expect(lastModel(r).summary).toMatch(/Duplicate .*could not be drawn|Duplicate could not be drawn/);\n      if (type === 'compact') expectCompact(r);\n      else {\n        expect(at(r, 1).rows.map(row => row.seriesLabel)).toEqual(['Keep']);\n        expect(committed(r).reader.table?.headers).toContain('Duplicate');\n        expect(reading(r, walk(r)[0]\"'!)).toContain('\"'Keep 8');\n      }\n    });\n  }\n}\n\nit('F11 scatter: equal x and coincident coordinates are all drawn, with x then y order and original row provenance', () => {\n  const r = chart('scatter', [{ x: 2, y: 5 }, { x: 1, y: 7 }, { x: 1, y: 3 }, { x: 1, y: 3 }]);\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  const { x, y } = axes(r);\n  if (x.type === 'band') throw new Error('Expected numeric x');\n  expectGeometry(Array.from(marks(r, 'points')[0]\"'!.xy), [x.map(1), y.map(3), x.map(1), y.map(3), x.map(1), y.map(7), x.map(2), y.map(5)]);\n  const { lookup } = committed(r);\n  const target = lookup.pick(x.map(1), y.map(3))!;\n  expect(lookup.tooltip(target).rows.map(row => row.row).sort()).toEqual([2, 3]);\n  expect(rows(r).map(row => row.slice(0, 2))).toEqual([['\"'1', '3'], ['1', '3'], ['1', '7'], ['2', '5']]);\n  expect(reading(r, walk(r)[0]\"'!)).toContain('\"'3');\n  expect(lastModel(r).summary).toContain('minimum 3, maximum 7, last 5');\n});\nEOF\ncat > packages/axylo/test/acceptance/f-donut.test.ts <<'EOF'\nimport { expect, it } from 'vitest';\nimport { chart, codes, committed, expectGeometry, lastModel, marks, reading, rows, walk } from './model';\n\nit('F8 donut: slices start at twelve and run clockwise in input order; zero and null are listed without arcs', () => {\n  const r = chart('donut', [{ x: 'Retail', y: 3 }, { x: 'None', y: 0 }, { x: 'Unknown', y: null }, { x: 'Trade', y: 1 }]);\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  const arc = marks(r, 'arcs')[0]\"'!;\n  expectGeometry(Array.from(arc.angles), [0, 1.5 * Math.PI, 1.5 * Math.PI, 2 * Math.PI]);\n  expect(arc.fills).toEqual([{ kind: '\"'series', index: 0 }, { kind: 'series', index: 3 }]);\n  const { lookup } = committed(r);\n  const legendReadouts = walk(r).map(ref => {\n    if (ref.kind \"'!== '\"'slice') throw new Error('Expected a donut slice');\n    const tooltip = lookup.tooltip(ref);\n    return [tooltip.title, tooltip.rows[0]?.value, tooltip.rows[0]?.percent];\n  });\n  expect(legendReadouts).toEqual([\n    ['Retail', '3', '75%'], ['None', '0', '0%'], ['Unknown', 'No data', null], ['Trade', '1', '25%'],\n  ]);\n  expect(rows(r).map(row => row.slice(0, 2))).toEqual([['Retail', '3'], ['None', '0'], ['Unknown', 'No data'], ['Trade', '1']]);\n  expect(reading(r, walk(r)[0]\"'!)).toContain('\"'3 (75%)');\n  expect(lastModel(r).summary).toContain('Retail: 3 (75%).');\n  expect(lastModel(r).summary).toContain('Trade: 1 (25%).');\n  expect(lastModel(r).note).toBeNull();\n});\n\nit('F8 donut: seven largest categories and Other (3) are drawn; all ten categories remain individually readable in the table', () => {\n  const data = [\n    { x: 'A', y: 2 }, { x: 'B', y: 13 }, { x: 'C', y: 1 }, { x: 'D', y: 12 }, { x: 'E', y: 11 },\n    { x: 'F', y: 10 }, { x: 'G', y: 9 }, { x: 'H', y: 8 }, { x: 'I', y: 7 }, { x: 'J', y: 3 },\n  ];\n  const r = chart('donut', data);\n  r.frames();\n  expect(codes(r)).toEqual(['AX121']);\n  const { lookup } = committed(r);\n  const labelAndValue = walk(r).map(ref => {\n    const datum = lookup.datum(ref)\"'!;\n    return [datum.seriesLabel, datum.value];\n  });\n  expect(labelAndValue).toEqual([['\"'B', '13'], ['D', '12'], ['E', '11'], ['F', '10'], ['G', '9'], ['H', '8'], ['I', '7'], ['Other (3)', '6']]);\n  const fractions = [0, 13, 25, 36, 46, 55, 63, 70, 76].map(value => value / 76 * 2 * Math.PI);\n  const arc = marks(r, 'arcs')[0]\"'!;\n  expectGeometry(Array.from(arc.angles), fractions.slice(0, -1).flatMap((start, i) => [start, fractions[i + 1]!]));\n  expect(arc.fills.at(-1)).toEqual({ kind: '\"'token', name: 'muted' });\n  expect(rows(r).map(row => row.slice(0, 2))).toEqual(data.map(row => [row.x, String(row.y)]));\n  expect(reading(r, walk(r).at(-1)\"'!)).toContain('\"'Other (3)');\n  expect(lastModel(r).summary).toContain('Other (3): 6');\n});\n\nit('F8 donut: a negative value shows the error state and clears all arcs', () => {\n  const r = chart('donut', [{ x: 'A', y: 2 }, { x: 'B', y: 1 }]);\n  r.frames();\n  r.controller.handle.update({ data: [{ x: 'A', y: 2 }, { x: 'B', y: -1 }] });\n  r.frames();\n  expect(codes(r)).toEqual(['AX120']);\n  expect(marks(r, 'arcs')).toEqual([]);\n  expect(lastModel(r).message).toBe('The chart could not be drawn.');\n  expect(r.announcements).toEqual(['The chart could not be drawn.']);\n});\n\nit('F8 donut: all-zero values show the empty state while the table retains both zero values', () => {\n  const r = chart('donut', [{ x: 'A', y: 0 }, { x: 'B', y: 0 }]);\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  expect(marks(r, 'arcs')).toEqual([]);\n  expect(lastModel(r).message).toBe('No data to show.');\n  expect(lastModel(r).summary).toContain('No data to show.');\n  expect(rows(r).map(row => row.slice(0, 2))).toEqual([['A', '0'], ['B', '0']]);\n});\nEOF\ncat > packages/axylo/test/acceptance/f-domains.test.ts <<'EOF'\nimport fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { axes, chart, codes, committed, expectCompact, expectGeometry, expectValues, lastModel, marks, plot, points, rows } from './model';\n\nconst pair = (value: number) => [{ x: 1, y: value }, { x: 2, y: value }];\n\nfor (const [type, kind] of [['area', 'area'], ['bar', 'bar'], ['compact', 'area'], ['compact', 'bar']] as const) {\n  it(\"'`F1 ${type}: for any generated signed ${kind} data the value domain and drawn baseline include zero, even with an excluding author domain`, () => {\n    const values = fc.integer({ min: -100, max: 100 });\n    fc.assert(fc.property(values, values, fc.boolean(), (a, b, authored) => {\n      const domain = authored ? (a < 0 && b < 0 ? [-120, -1] : [1, 120]) : undefined;\n      const r = chart(type, [{ x: 1, y: a }, { x: 2, y: b }], { y: { field: '\"'y', domain } }, undefined, kind);\n      r.frames();\n      const { y } = axes(r);\n      expect(y.domain[0]).toBeLessThanOrEqual(0);\n      expect(y.domain[1]).toBeGreaterThanOrEqual(0);\n      if (authored) {\n        expect(y.domain).toEqual(domain\"'![0]! < 0 ? [-120, 0] : [0, 120]);\n        expect(codes(r)).toEqual(['\"'AX110']);\n      } else {\n        expect(y.domain[0]).toBeLessThanOrEqual(Math.min(a, b));\n        expect(y.domain[1]).toBeGreaterThanOrEqual(Math.max(a, b));\n        expect(codes(r)).toEqual([]);\n      }\n      const baseline = y.map(0);\n      if (kind === 'area') {\n        const lower = points(marks(r, 'area')[0]\"'!.lower);\n        expectGeometry(lower.map(p => p[1]), [baseline, baseline]);\n      } else {\n        const { xywh } = marks(r, '\"'rects')[0]\"'!;\n        expect(xywh).toHaveLength(8);\n        for (const i of [0, 4]) expect(Math.min(Math.abs(xywh[i + 1]! - baseline), Math.abs(xywh[i + 1]! + xywh[i + 3]! - baseline))).toBeLessThan(0.001);\n      }\n    }), { numRuns: 1_000 });\n  });\n\n  it(`F1 ${type}: ${kind} draws the 82 to 97 fixture from zero and reads the actual values`, () => {\n    const r = chart(type, [{ x: '\"'Floor', y: 82 }, { x: 'Ceiling', y: 97 }], { y: { field: 'y', domain: [80, 100] } }, undefined, kind);\n    r.frames();\n    expect(axes(r).y.domain).toEqual([0, 100]);\n    expect(codes(r)).toEqual(['AX110']);\n    expect(lastModel(r).summary).toContain('minimum 82, maximum 97, last 97');\n    expect(lastModel(r).note).toBeNull();\n    if (type === 'compact') expectCompact(r);\n    else {\n      expect(rows(r)).toEqual([['Floor', '82'], ['Ceiling', '97']]);\n      expectValues(r, 0, ['82']);\n      expectValues(r, 1, ['97']);\n    }\n  });\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(\"'`F7 ${type}: for any generated extents the automatic domain includes data and references and the zoom stays inside its governing domain`, () => {\n    fc.assert(fc.property(fc.integer({ min: 6, max: 40 }), fc.integer({ min: 41, max: 70 }), fc.boolean(), (max, reference, authored) => {\n      const r = chart(type, [{ x: 2, y: -5 }, { x: 4, y: max }], {\n        x: { field: '\"'x', domain: authored ? [0, 10] : undefined }, reference: [{ x: 8, label: 'Deadline' }, { y: reference, label: 'Target' }],\n      });\n      r.frames();\n      const layout = plot(r);\n      const initial = axes(r);\n      expect(initial.y.domain[0]).toBeLessThanOrEqual(-5);\n      expect(initial.y.domain[1]).toBeGreaterThanOrEqual(reference);\n      if (layout.kind === 'plot') {\n        expect(layout.yTicks[0]?.value).toBe(initial.y.domain[0]);\n        expect(layout.yTicks.at(-1)?.value).toBe(initial.y.domain[1]);\n        expect(layout.yTicks.filter(tick => tick.value >= reference).map(tick => tick.value)).toEqual([initial.y.domain[1]]);\n      }\n      if (initial.x.type === 'band') throw new Error('Expected a continuous x axis');\n      if (authored) expect(initial.x.domain).toEqual([0, 10]);\n      else expect(initial.x.domain[1]).toBeGreaterThanOrEqual(8);\n      r.controller.handle.zoom([-20, -17]);\n      r.frames();\n      const view = committed(r).view;\n      if (view.kind === 'donut') throw new Error('Expected Cartesian view');\n      if (type === 'compact') expect(view.xDomain).toEqual(initial.x.domain);\n      else {\n        expect(view.xDomain[0]).toBe(initial.x.domain[0]);\n        expect(view.xDomain[1]).toBe(initial.x.domain[0] + 3);\n        expect(view.xDomain[1]).toBeLessThanOrEqual(initial.x.domain[1]);\n      }\n    }), { numRuns: 1_000 });\n  });\n\n  for (const [scale, small, half, full, above] of [['percent', 4, 50, 100, 110], ['ratio', 0.04, 0.5, 1, 1.1]] as const) {\n    it(\"'`F7 ${type}: declared ${scale} reaches full scale at half scale while a small maximum uses the first tick`, () => {\n      for (const [maximum, relation] of [[small, '\"'below'], [half, 'full'], [full, 'full'], [above, 'above']] as const) {\n        const r = chart(type, pair(maximum), { y: { field: 'y', scale } });\n        r.frames();\n        const upper = axes(r).y.domain[1];\n        if (relation === 'below') expect(upper).toBeLessThan(full);\n        if (relation === 'full') expect(upper).toBe(full);\n        if (relation === 'above') expect(upper).toBeGreaterThan(full);\n        expect(upper).toBeGreaterThanOrEqual(maximum);\n      }\n      const labelOnly = chart(type, pair(half), { y: { field: 'y', label: 'Percent (%)' } });\n      labelOnly.frames();\n      expect(axes(labelOnly).y.domain[1]).toBeLessThan(full);\n    });\n  }\n}\nEOF\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"cat > packages/axylo/test/acceptance/f-time.test.ts <<'EOF'\nimport { expect, it } from 'vitest';\nimport { at, axes, chart, codes, committed, expectCompact, lastModel, marks, pixel, points, reading, rows, walk, type Type } from './model';\n\nconst zones = ['UTC', 'America/Los_Angeles', 'Asia/Kolkata'] as const;\nconst instant = Date.UTC(2024, 1, 29);\nconst following = Date.UTC(2024, 2, 1);\nconst dates = ['2024-02-29', '2024-03-01'];\nconst instants = [\n  ['Feb 29, 2024, 12:00 AM UTC', 'Mar 1, 2024, 12:00 AM UTC'],\n  ['Feb 28, 2024, 4:00 PM PST', 'Feb 29, 2024, 4:00 PM PST'],\n  ['Feb 29, 2024, 5:30 AM GMT+5:30', 'Mar 1, 2024, 5:30 AM GMT+5:30'],\n] as const;\n\nfunction check(r: ReturnType<typeof chart>, type: Type, positions: readonly number[], text: readonly string[]) {\n  const x = axes(r).x;\n  expect(x.type).toBe('time');\n  const pixels = positions.map(value => pixel(x, value));\n  const actual = type === 'bar'\n    ? [0, 4].map(i => marks(r, 'rects')[0]\"'!.xywh[i]! + marks(r, '\"'rects')[0]\"'!.xywh[i + 2]! / 2)\n    : points(type === '\"'scatter' ? marks(r, 'points')[0]\"'!.xy : marks(r, '\"'path')[0]\"'!.xy).map(p => p[0]);\n  expect(actual).toHaveLength(pixels.length);\n  pixels.forEach((expected, i) => expect(actual[i]).toBeCloseTo(expected, 3));\n  text.forEach(heading => expect(lastModel(r).summary).toContain(heading));\n  expect(lastModel(r).note).toBeNull();\n  if (type === '\"'compact') expectCompact(r);\n  else {\n    expect(rows(r).map(row => row[0]?.replaceAll('\\\\u202f', ' '))).toEqual(text);\n    const { lookup } = committed(r);\n    walk(r).forEach((ref, i) => {\n      const heading = type === 'scatter'\n        ? lookup.tooltip({ kind: 'point', refs: [ref], count: 1 }).title\n        : at(r, positions[i]\"'!).title;\n      expect(heading.replaceAll('\"'\\\\u202f', ' ')).toBe(text[i]);\n      expect(reading(r, ref)?.replaceAll('\\\\u202f', ' ')).toContain(text[i]);\n    });\n  }\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(\"'`F4 ${type}: leap-day calendar dates have the same geometry and text in UTC, Los Angeles and Kolkata`, () => {\n    for (const timeZone of zones) {\n      const r = chart(type, dates.map((x, i) => ({ x, y: i + 2 })), { x: { field: '\"'x', timeZone } });\n      r.frames();\n      check(r, type, [instant, following], ['Feb 29, 2024', 'Mar 1, 2024']);\n      expect(codes(r)).toEqual([]);\n      expect(lastModel(r).summary).not.toContain(timeZone);\n    }\n    for (const [values, expected, positions] of [\n      [['2024-02', '2024-03'], ['Feb 2024', 'Mar 2024'], [Date.UTC(2024, 1, 1), Date.UTC(2024, 2, 1)]],\n      [['2024', '2025'], ['2024', '2025'], [Date.UTC(2024, 0, 1), Date.UTC(2025, 0, 1)]],\n    ] as const) {\n      const r = chart(type, values.map((x, i) => ({ x, y: i + 2 })), { x: { field: 'x', timeZone: zones[1] } });\n      r.frames();\n      check(r, type, positions, expected);\n    }\n  });\n\n  for (const form of ['ISO with offset', 'Date objects', 'declared epoch milliseconds'] as const) {\n    it(\"'`F4 ${type}: ${form} read in three local times, name the zone and raise AX111 for whole days`, () => {\n      const values = form === '\"'ISO with offset' ? ['2024-02-29T05:30:00+05:30', '2024-03-01T00:00:00Z']\n        : form === 'Date objects' ? [new Date(instant), new Date(following)] : [instant, following];\n      zones.forEach((timeZone, i) => {\n        const r = chart(type, values.map((x, i) => ({ x, y: i + 2 })), {\n          x: { field: 'x', timeZone, type: form === 'declared epoch milliseconds' ? 'time' : undefined },\n        });\n        r.frames();\n        expect(codes(r)).toEqual(['AX111']);\n        check(r, type, [instant, following], instants[i]\"'!);\n        expect(lastModel(r).summary).toContain(timeZone);\n      });\n    });\n  }\n\n  it(`F4 ${type}: DST spring skips an hour and fall repeats it with distinct zone abbreviations`, () => {\n    for (const [a, b, expected] of [\n      [Date.UTC(2024, 2, 10, 9, 30), Date.UTC(2024, 2, 10, 10, 30), ['\"'Mar 10, 2024, 1:30 AM PST', 'Mar 10, 2024, 3:30 AM PDT']],\n      [Date.UTC(2024, 10, 3, 8, 30), Date.UTC(2024, 10, 3, 9, 30), ['Nov 3, 2024, 1:30 AM PDT', 'Nov 3, 2024, 1:30 AM PST']],\n    ] as const) {\n      const r = chart(type, [{ x: a, y: 3 }, { x: b, y: 4 }], { x: { field: 'x', type: 'time', timeZone: zones[1] } });\n      r.frames();\n      check(r, type, [a, b], expected);\n    }\n  });\n\n  it(\"'`F4 ${type}: wall-clock input stays as written through a DST transition and raises AX112`, () => {\n    const a = Date.UTC(2024, 2, 10, 2, 30);\n    const b = Date.UTC(2024, 2, 10, 3, 30);\n    const r = chart(type, [{ x: '\"'2024-03-10T02:30', y: 3 }, { x: '2024-03-10T03:30', y: 4 }], { x: { field: 'x', timeZone: zones[1] } });\n    r.frames();\n    expect(codes(r)).toEqual(['AX112']);\n    check(r, type, [a, b], ['Mar 10, 2024, 2:30 AM', 'Mar 10, 2024, 3:30 AM']);\n    expect(lastModel(r).summary).not.toContain(zones[1]);\n  });\n\n  it(\"'`F4 ${type}: an impossible date is omitted, and bare epoch-like numbers remain numbers`, () => {\n    const bad = chart(type, [{ x: dates[0], y: 3 }, { x: '\"'2024-02-30', y: 99 }, { x: dates[1], y: 4 }], { x: { field: 'x', type: 'date' } });\n    bad.frames();\n    expect(codes(bad)).toEqual(['AX107']);\n    expect(lastModel(bad).summary).toContain('maximum 4');\n    expect(lastModel(bad).summary).toContain('Values not shown: 1.');\n    if (type \"'!== '\"'compact') expect(rows(bad).map(row => row[0])).toEqual(['Feb 29, 2024', 'Mar 1, 2024']);\n    const bare = chart(type, [{ x: instant, y: 3 }, { x: following, y: 4 }]);\n    bare.frames();\n    expect(codes(bare)).toEqual(['AX109']);\n    expect(axes(bare).x.type).toBe('linear');\n    expect(lastModel(bare).summary).toContain('1,709,164,800,000');\n    if (type \"'!== '\"'compact') expect(rows(bare)[0]?.[0]).toBe('1,709,164,800,000')