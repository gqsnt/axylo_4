kup = drawn?.lookup;\n    if (!lookup || !drawn || !sameKey(drawn.lookupInputs, lookupInputs)) {\n      stage('lookup');\n      lookup = buildLookup(view, layout, formatters, a.messages, locale);\n    }\n\n    // Marks: drawn again for a new scene, a new theme or a new pixel ratio, never rebuilt for a theme alone.\n    const paintInputs = [scene, themeRevision, pixelRatio];\n    if (measured && (!drawn || !sameKey(drawn.paintInputs, paintInputs))) {\n      stage('draw');\n      host.renderer.draw(scene, theme!.bindings, theme!.theme, pixelRatio);\n    }\n    if (!drawn || drawn.layout !== layout || (drawn.layout.kind === 'plot') !== (layout.kind === 'plot')) {\n      stage('text');\n      host.text.render(layout.kind === 'plot' ? layout.texts : []);\n    }\n\n    stage('figure');\n    host.figure.update(modelFor(reader, tooSmall));\n\n    // A change of state is said once, politely (spec L7). The first state is not announced: it is what\n    // the page shows on load, and 24 charts saying \"Loading\" at once is noise.\n    if (announced !== null && announced !== shown.kind) {\n      host.figure.announce(shown.kind === 'ready' ? readyText(a, reader, byText) : shown.text,\n        shown.kind !== 'ready' && shown.message ? english(shown.message) : null);\n    }\n    if (measured || announced !== null) announced = shown.kind;\n\n    drawn = {\n      accepted: a, formatters, formattersKey: fKey, layout, layoutKey: lKey, scene, sceneInputs,\n      lookup, lookupInputs, reader, readerInputs, paintInputs,\n    };\n    // The frame on screen is now this revision: rows only older revisions could address can go.\n    retire(a);\n    host.interaction.commit({\n      ...controlsFor(reader, tooSmall), layout, lookup, bindings: theme!.bindings, theme: theme!.theme, pixelRatio,\n    });\n    if (!current(a)) return;\n    if (measured) settle(a.revision);\n  }\n\n  /** Retires, in the store, every revision older than the frame now on screen. */\n  function retire(a: Accepted): void {\n    if (retiredFor === a.frame) return;\n    retiredFor = a.frame;\n    const store = a.store;\n    if (store && a.frame.revision > 0) store.retire(a.frame.revision - 1);\n  }\n\n  function readyText(a: Accepted, reader: ReaderModel, byText: string | null): string {\n    if (reader.name) return reader.name;\n    return byText?.trim() || a.name;\n  }\n\n  /**\n   * An exception in our own pipeline: a complete error revision. The interaction layer is cleared (no old\n   * lookup answers the pointer), every output the error state cleared is invalidated so recovery redraws\n   * it all, and readiness settles on this revision.\n   */\n  function failSafe(a: Accepted, error: unknown): void {\n    raiseInternal(error);\n    showInternal(a.messages, a.name, a.options);\n    drawn = null;\n    lastLayout = null;\n    themeDirty = true;\n    sizeDirty = true;\n    settle(a.revision);\n  }\n\n  function showInternal(m: Messages, name: string, o: OptionRecord): void {\n    try {\n      host.text.render([]);\n      host.interaction.clear();\nimport { SLOT_NULL, SLOT_VALUE } from '../core/contracts';\nimport type { AlignedView, DatumRef, DatumText, Formatters, Lookup, SlotState } from '../core/contracts';\nimport type { Messages } from '../public';\nimport { clipBox, contains, pointBox, type PlotLayout } from './geometry';\nimport { lowerBound, pageDistance } from './search';\nimport { incomplete, slotText } from './text';\n\nconst TOOLTIP_LIMIT = 8;\n\nfunction clamp(n: number, lo: number, hi: number): number {\n  return Math.max(lo, Math.min(hi, n));\n}\n\nexport function alignedLookup(view: AlignedView, layout: PlotLayout | null, formatters: Formatters, messages: Messages): Lookup {\n  const { frame, visibleSlots: { start, end }, stack } = view;\n  const positions = frame.x.values;\n  const visible = frame.series.flatMap((series, s) => view.visible[s] && series.drawable ? [s] : []);\n  const keys = new Map(frame.series.map((series, s) => [series.key, s]));\n  const projection = layout?.projection;\n  const xScale = projection?.kind === 'xy' ? projection.x : projection?.kind === 'bands' ? projection.band : null;\n\n  function ref(s: number, i: number): DatumRef {\n    return { kind: 'aligned', seriesKey: frame.series[s]!.key, x: positions[i]! };\n  }\n\n  function index(x: number): number {\n    const i = lowerBound(positions, x);\n    return positions[i] === x ? i : -1;\n  }\n\n  function isValue(s: number, i: number): boolean {\n    return frame.series[s]!.slot[i] === SLOT_VALUE;\n  }\n\n  function seek(s: number, i: number, delta: 1 | -1, lo = start, hi = end): number {\n    for (; i >= lo && i < hi; i += delta) if (isValue(s, i)) return i;\n    return -1;\n  }\n\n  function first(): DatumRef | null {\n    let earliest = end;\n    let series = -1;\n    for (const s of visible) {\n      const i = seek(s, start, 1, start, earliest);\n      if (i >= 0) {\n        earliest = i;\n        series = s;\n      }\n    }\n    return series < 0 ? null : ref(series, earliest);\n  }\n\n  function write(s: number, i: number, announce = false): DatumText {\n    const series = frame.series[s]!;\n    const state = series.slot[i] as SlotState;\n    const value = slotText(formatters, s, series.y[i]!, state);\n    return {\n      ref: ref(s, i), seriesIndex: s, seriesLabel: series.label, x: formatters.x(positions[i]!),\n      value: announce && stack?.incomplete?.[i] && visible.includes(s) ? incomplete(value, messages) : value,\n      state, percent: null, row: series.row?.[i] ?? i,\n    };\n  }\n\n  function primary(i: number): DatumRef | null {\n    if (i < start || i >= end) return null;\n    const s = visible.find(s => isValue(s, i)) ?? visible[0];\n    return s === undefined ? null : ref(s, i);\n  }\n\n  function resolve(datum: DatumRef): DatumRef | null {\n    if (datum.kind !== 'aligned') return null;\n    const s = keys.get(datum.seriesKey);\n    if (s === undefined) return null;\n    const i = lowerBound(positions, datum.x);\n    const inView = i >= start && i < end && positions[i] === datum.x;\n    if (!view.visible[s] || !frame.series[s]!.drawable) {\n      return inView && !view.visible[s] ? primary(i) : null;\n    }\n    if (inView) return datum;\n    const next = seek(s, Math.max(i, start), 1);\n    const replacement = next >= 0 ? next : seek(s, Math.min(i - 1, end - 1), -1);\n    return replacement < 0 ? null : ref(s, replacement);\n  }\n\n  function nearestSlot(pixel: number): number {\n    if (!xScale || start === end) return -1;\n    const x = xScale.invert(pixel);\n    if (xScale.type === 'band') return x >= start && x < end ? x : -1;\n    const right = lowerBound(positions, x, start, end);\n    if (right === start) return start;\n    if (right === end) return end - 1;\n    // Use screen distances for the final comparison because inversion can round at a midpoint.\n    const leftPixel = xScale.map(positions[right - 1]!);\n    const rightPixel = xScale.map(positions[right]!);\n    const midpoint = leftPixel / 2 + rightPixel / 2;\n    return (leftPixel <= rightPixel ? pixel >= midpoint : pixel <= midpoint) ? right : right - 1;\n  }\n\n  return {\n    pick(px, py) {\n      if (!layout || !visible.length || !contains(layout.plot, px, py)) return null;\n      const i = nearestSlot(projection?.kind === 'bands' && projection.horizontal ? py : px);\n      return i < 0 ? null : { kind: 'x', x: positions[i]! };\n    },\n    tooltip(target) {\n      const i = target.kind === 'x' ? index(target.x) : -1;\n      if (i < start || i >= end) return { title: '', rows: [], count: 0, total: null };\n      let total: string | null = null;\n      if (stack && stack.order.length) {\n        let sum = 0;\n        let hasValue = false;\n        for (const s of stack.order) {\n          if (!isValue(s, i)) continue;\n          sum += frame.series[s]!.y[i]!;\n          hasValue = true;\n        }\n        total = hasValue ? formatters.value(stack.order[0]!, sum) : formatters.missing(SLOT_NULL);\n        if (hasValue && stack.incomplete?.[i]) total = incomplete(total, messages);\n      }\n      return {\n        title: formatters.x(positions[i]!), rows: visible.slice(0, TOOLTIP_LIMIT).map(s => write(s, i)),\n        count: visible.length, total,\n      };\n    },\n    primary(target) {\n      return target.kind === 'x' ? primary(index(target.x)) : null;\n    },\n    datum(datum) {\n      if (datum.kind !== 'aligned') return null;\n      const s = keys.get(datum.seriesKey);\n      const i = index(datum.x);\n      return s === undefined || i < 0 ? null : write(s, i, true);\n    },\n    anchor(datum) {\n      if (datum.kind !== 'aligned' || !layout || !projection || !xScale) return null;\nfunction chartText(input: ReaderInput, type: string, xLabel: string, yLabel: string): string[] {\n  const { view, formatters, messages } = input;\n  if (view.kind === 'donut') {\n    const drawn = view.slices.filter(slice => slice.angles && slice.angles[1] > slice.angles[0]);\n    if (!drawn.length) return [messages.empty];\n    return [\n      fill(messages.donutSummary, { type, count: formatters.count(drawn.length), total: formatters.value(0, view.total) }),\n      ...drawn.map(slice => {\n        const { label, value, percent } = sliceText(view, slice, formatters);\n        return fillDonutSlice(label, value, percent ?? '');\n      }),\n    ];\n  }\n\n  let xMin = Infinity;\n  let xMax = -Infinity;\n  let min = Infinity;\n  let max = -Infinity;\n  let minSeries = 0;\n  let maxSeries = 0;\n  let seriesCount = 0;\n  const entries: string[] = [];\n  const undrawn: string[] = [];\n  const { frame } = view;\n  const zone = view.kind === 'scatter'\n    ? view.frame.xKind === 'time' && view.frame.timeZone\n    : view.frame.x.kind === 'time' && view.frame.x.timeZone;\n\n  if (view.kind !== 'scatter') {\n    const { start, end } = view.visibleSlots;\n    if (start < end) {\n      xMin = view.frame.x.values[start]!;\n      xMax = view.frame.x.values[end - 1]!;\n    }\n  }\n  frame.series.forEach((series, s) => {\n    if (!series.drawable) {\n      undrawn.push(fill(messages.seriesNotDrawn, { series: series.label }));\n      return;\n    }\n    if (!view.visible[s]) return;\n    const range = view.kind === 'scatter' ? view.visiblePoints[s]! : view.visibleSlots;\n    if (range.start < range.end && 'x' in series) {\n      xMin = Math.min(xMin, series.x[range.start]!);\n      xMax = Math.max(xMax, series.x[range.end - 1]!);\n    }\n    const stats = statistics(series.y, range, 'slot' in series ? series.slot : undefined);\n    if (stats.min < min) { min = stats.min; minSeries = s; }\n    if (stats.max > max) { max = stats.max; maxSeries = s; }\n    seriesCount++;\n    entries.push(Number.isFinite(stats.last) ? fill(messages.seriesSummary, {\n      series: series.label, min: formatters.value(s, stats.min),\n      max: formatters.value(s, stats.max), last: formatters.value(s, stats.last),\n    }) : fill(messages.seriesNoData, { series: series.label }));\n  });\n\n  const zoneText = zone ? [fill(messages.timeZoneNote, { zone })] : [];\n  if (!seriesCount || !Number.isFinite(xMin) || !Number.isFinite(xMax)) return [...undrawn, messages.empty, ...zoneText];\n  const range = Number.isFinite(min) && Number.isFinite(max)\n    ? { yMin: formatters.value(minSeries, min), yMax: formatters.value(maxSeries, max) } : null;\n  return [\n    fillChartSummary(messages.chartSummary, {\n      type, seriesCount: formatters.count(seriesCount), xLabel, xMin: formatters.x(xMin), xMax: formatters.x(xMax), yLabel,\n    }, range),\n    ...zoneText, ...entries, ...undrawn,\n  ];\n}\n\nfunction referenceText(view: View, formatters: Formatters, messages: Messages): string[] {\n  const yLabel = view.kind === 'donut' ? view.frame.valueLabel\n    : view.kind === 'scatter' ? view.frame.yLabel : view.frame.yLabel || view.frame.series[0]?.field || labels.value;\n  const titleText = typeof title === 'string' ? title : title?.text;\n  if (!labelledBy && !titleText && input.diagnostics) report(input.diagnostics, 'AX140', 'none');\n  const generated = fill(messages.chartName, { type, x: xLabel, y: yLabel });\n  const name = labelledBy ? '' : titleText || generated;\n  const omitted = disclosure?.omitted ?? 0;\n  const changed = disclosure?.changed ?? 0;\n  const statements: string[] = [];\n  if (omitted > 0 || changed > 0) {\n    const counts = { omitted: formatters.count(omitted), changed: formatters.count(changed) };\n    if (omitted > 0) statements.push(fill(messages.valuesNotShown, { ...counts, count: counts.omitted }));\n    if (changed > 0) statements.push(fill(messages.valuesChanged, { ...counts, count: counts.changed }));\n  }\n  const omission = statements.join(' ');\n  const hidden = input.labelsHidden ?? 0;\n  const note = [omission, hidden > 0 ? fill(messages.labelsHidden, { count: formatters.count(hidden) }) : ''].filter(Boolean).join(' ') || null;\n  const compact = input.compact === true || (view.kind !== 'donut' && view.compact);\n  let references: string[] | undefined;\n  const referencesForView = () => references ??= referenceText(view, formatters, messages);\n  let summary: string | undefined;\n  const caption = [input.caption, name, generated, messages.plotLabel].find(text => text?.trim()) ?? defaultMessages.plotLabel;\n  return {\n    name, note,\n    get summary() {\n      // Opening the table should not scan the rest of the frame.\n      return summary ??= [...chartText(input, type, xLabel, yLabel), ...referencesForView(), subtitle, omission, description].filter(Boolean).join(' ');\n    },\n    table: input.table === false || compact ? null : buildTable(\n      view, [caption, ...referencesForView()].join(' '), formatters, messages, labels, input.locale,\n    ),\nimport type { DatumRef, Formatters, Lookup } from '../core/contracts';\nimport type { Messages } from '../public';\n\nconst chartSummary = '{type} chart with {seriesCount} series. {xLabel} from {xMin} to {xMax}.';\nconst fullChartSummary = chartSummary + ' {yLabel} from {yMin} to {yMax}.';\nconst donutSlice = '{label}: {value} ({percent}).';\n\nexport const defaultMessages: Messages = {\n  viewAsTable: 'View as table',\n  hideTable: 'Hide table',\n  noData: 'No data',\n  noObservation: 'No observation',\n  incompleteStack: 'incomplete',\n  moreRows: '+{count} more',\n  otherSlices: 'Other ({count})',\n  valuesNotShown: 'Values not shown: {count}. See table.',\n  valuesChanged: 'Values shown differently from the data: {count}. See table.',\n  labelsHidden: 'Some labels hidden. See table.',\n  loading: 'Loading chart.',\n  empty: 'No data to show.',\n  error: 'The chart could not be drawn.',\n  internalError: 'Something went wrong while drawing the chart.',\n  chartName: '{type} chart of {y} by {x}',\n  chartSummary: fullChartSummary,\n  seriesSummary: '{series}: minimum {min}, maximum {max}, last {last}.',\n  // Deprecated. Retained for callers with an existing override.\n  referenceSummary: 'Reference: {label}.',\n  timeZoneNote: 'Times are shown in {zone}.',\n  plotLabel: 'Chart plot',\n  controlsLabel: 'Chart controls',\n  pointOf: '{series}, {x}, {value}. Point {index} of {count}.',\n  zoomIn: 'Zoom in',\n  zoomOut: 'Zoom out',\n  resetZoom: 'Reset zoom',\n  pause: 'Pause',\n  resume: 'Resume',\n  previousPage: 'Previous page',\n  nextPage: 'Next page',\n  pageOf: 'Page {page} of {count}',\n  jumpToX: 'Jump to {x}',\n  showSeries: 'Show {series}',\n  hideSeries: 'Hide {series}',\n  category: 'Category',\n  percentage: 'Percentage',\n  series: 'Series',\n  value: 'Value',\n  typeLine: 'Line',\n  typeArea: 'Area',\n  typeBar: 'Bar',\n  typeScatter: 'Scatter',\n  typeDonut: 'Donut',\n  donutSummary: '{type} chart with {count} slices. Total {total}.',\n  seriesNoData: '{series}: no data.',\n  seriesNotDrawn: '{series} could not be drawn. See table.',\n  referenceLine: 'Reference line {label} at {from}.',\n  referenceBand: 'Reference band {label} from {from} to {to}.',\n  plotRole: '{type} chart',\n  pointAll: '{x}. {values}. {position}',\n  seriesValue: '{series} {value}',\n  position: 'Point {index} of {count}',\n  total: 'Total',\n  panLeft: 'Pan left',\n  panRight: 'Pan right',\n  jumpNotFound: 'No row matches {x}. Example: {example}',\n  plotInstructions: 'Arrow keys move between points. Enter shows one series at a time. Plus and minus zoom.',\n};\n\nexport function fill(template: string, values: Readonly<Record<string, string | number>>): string {\n  return template.replace(/\\{(\\w+)\\}/g, (placeholder: string, name: string) =>\n    Object.hasOwn(values, name) ? String(values[name]) : placeholder,\n  );\n}\n\nexport function resolveMessages(overrides?: Partial<Messages> | null): Messages {\n  const messages = { ...defaultMessages };\n  for (const key of Object.keys(messages) as (keyof Messages)[]) {\n    messages[key] = overrides?.[key] ?? messages[key];\n  }\n  return messages;\n}\n\nexport function fillChartSummary(\n  template: string, values: Readonly<Record<string, string>>, range: { readonly yMin: string; readonly yMax: string } | null,\n): string {\n  if (range) return fill(template, { ...values, ...range });\n  // When a translation uses the same placeholders, omit the sentence that would describe the missing range.\n  const withoutRange = template === fullChartSummary ? chartSummary\n    : template.match(/[^.!?。！？]+[.!?。！？]*|[.!?。！？]+/gu)?.filter(part => !/\\{y(?:Min|Max)\\}/.test(part)).join('').trim();\n  return fill(withoutRange || chartSummary, values);\n}\n\nexport function fillDonutSlice(label: string, value: string, percent: string): string {\n  return fill(donutSlice, { label, value, percent });\n}\n\nexport function pointOf(lookup: Lookup, ref: DatumRef, formatters: Formatters, messages: Messages): string | null {\n  const ordinal = lookup.ordinal(ref);\n  if (ordinal < 0) return null;\n  const datum = lookup.datum(ref);\n  if (!datum) return null;\nimport {\n  type AlignedView, type AreaMark, type IndexRange, type PathMark, type PointMark, type StackView,\n} from '../core/contracts';\nimport { buildPoints, simplifyArea, simplifyLine, type AreaBoundary, type JoinedRuns, type LineInput } from '../simplify';\nimport { seriesPaint, token } from './geometry';\nimport { addLine, type Drawing } from './lines';\n\nexport function addArea(\n  input: LineInput & Drawing, view: AlignedView, series: number, compact: boolean,\n  areas: AreaMark[], paths: PathMark[], points: PointMark[],\n): void {\n  let geometry: Pick<AreaMark, 'upper' | 'lower' | 'runs'>;\n  let selection: JoinedRuns;\n  if (input.y instanceof Float64Array) {\n    const area = simplifyArea({ ...input, upper: input.y, lower: 0 });\n    const { upper, lower, runs } = area;\n    geometry = { upper, lower, runs };\n    selection = area.upperBoundary.selection;\n  } else {\n    // The area helper takes Float64Array. A constant lower edge can share the upper selection\n    // instead of widening a borrowed Float32Array of values.\n    selection = simplifyLine(input);\n    const { indexes, breaks } = selection;\n    const runs = new Uint32Array(indexes.length ? (breaks.length + 1) * 4 : 0);\n    let start = 0;\n    for (let i = 0; i < runs.length; i += 4) {\n      const end = breaks[i / 4] ?? indexes.length;\n      runs[i] = runs[i + 2] = start;\n      runs[i + 1] = runs[i + 3] = end - start;\n      start = end;\n    }\n    geometry = { upper: buildPoints(indexes, input), lower: buildPoints(indexes, { ...input, y: 0 }), runs };\n  }\n  areas.push({ type: 'area', series, ...geometry, fill: seriesPaint(series), opacity: 0.25 });\n  addLine(input, view, series, view.visibleSlots, compact, paths, points, selection);\n}\n\nfunction boundaryIndex(boundary: AreaBoundary, slot: number): number {\n  const { indexes } = boundary.selection;\n  let start = 0;\n  let end = indexes.length;\n  while (start < end) {\n    const middle = start + Math.floor((end - start) / 2);\n    if (indexes[middle]! < slot) start = middle + 1;\n    else end = middle;\n  }\n  return start;\n}\n\nfunction addRun(\n  runs: number[], upper: AreaBoundary, lower: AreaBoundary, range: IndexRange,\n  upperOffset: number, lowerOffset: number,\n): void {\n  if (upper === lower) return;\n  const upperStart = boundaryIndex(upper, range.start);\n  const upperCount = boundaryIndex(upper, range.end) - upperStart;\n  const lowerStart = boundaryIndex(lower, range.start);\n  const lowerCount = boundaryIndex(lower, range.end) - lowerStart;\n  if (upperCount >= 2 && lowerCount >= 2) {\n    runs.push(upperStart + upperOffset, upperCount, lowerStart + lowerOffset, lowerCount);\n  }\n}\n\nfunction packEdges(positive: AreaBoundary | null, negative: AreaBoundary | null): Float32Array {\n  if (!positive) return negative!.xy;\n  if (!negative) return positive.xy;\n  const xy = new Float32Array(positive.xy.length + negative.xy.length);\n  xy.set(positive.xy);\n  xy.set(negative.xy, positive.xy.length);\n  return xy;\n}\n\nfunction addSeam(\n  paths: PathMark[], edge: AreaBoundary, range: IndexRange, series: number, width: number,\n  below: (slot: number) => boolean, above: (slot: number) => boolean,\n  changed: (slot: number) => boolean,\n): void {\n  const start = boundaryIndex(edge, range.start);\n  const end = boundaryIndex(edge, range.end);\n  if (end - start < 2) return;\n  const { indexes } = edge.selection;\n  let xy: Float32Array | undefined;\n  let count = 0;\n  let continuing = false;\n  for (let i = start + 1; i < end; i++) {\n    const a = indexes[i - 1]!;\n    const b = indexes[i]!;\n    if (!(changed(a) || changed(b)) || !(below(a) || below(b)) || !(above(a) || above(b))) {\n      continuing = false;\n      continue;\n    }\n    xy ??= new Float32Array(4 * (end - start));\n    if (!continuing) {\n      if (count) {\n        xy[count++] = NaN;\n        xy[count++] = NaN;\n      }\n      xy[count++] = edge.xy[2 * i - 2]!;\n      xy[count++] = edge.xy[2 * i - 1]!;\n    }\n    xy[count++] = edge.xy[2 * i]!;\n    xy[count++] = edge.xy[2 * i + 1]!;\n    continuing = true;\n  }\n  if (xy) paths.push({\n    type: 'path', series, xy: xy.subarray(0, count), stroke: token('background'), strokeWidth: width,\n    dash: { normal: null, contrast: null },\n  });\n}\n\nfunction extendBoundary(\n  input: Drawing & { range: IndexRange; slot: Uint8Array }, lower: AreaBoundary | null,\n  values: Float64Array, base: number, end: number,\n): AreaBoundary | null {\n  if (!lower) return null;\n  const upper = values.subarray(base, end);\n  if (upper.every((value, i) => value === lower.values[i])) return lower;\n  return simplifyArea({ ...input, upper, lower }).upperBoundary;\n}\n\n","exit_code":0,"status":"completed"}}
