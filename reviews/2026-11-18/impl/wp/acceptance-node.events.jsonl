\n  /** The page's own language, for author text inside an element marked 'en'. */\n  readonly pageLang: string | null;\n}\n\n/** What one drawn frame shows, as the interaction layer needs it. */\nexport interface Committed extends ControlsState {\n  readonly layout: Layout;\n  readonly lookup: Lookup;\n  readonly bindings: PaintBindings;\n  readonly theme: ResolvedTheme;\n  readonly pixelRatio: number;\n}\n\nexport interface Actions {\n  /** A window in x positions, or null for everything. Goes through the public `zoom` path. */\n  zoom(window: Span | null): void;\n  toggle(seriesKey: string): void;\n  pause(paused: boolean): void;\n/**\n * The chart's document structure (plan 2.4; spec A1, C1, F12, L7). The author's target is the root; inside\n * it the figure holds the caption (title, subtitle, summary), the plot container (marks, text layer, state\n * message), the reader's note, a polite live region and the tooltip. Only text is ever set, never HTML.\n *\n * The interaction layer (dom/interaction.ts) adds the keyboard proxy inside the plot and fills the control\n * slots (`top` above the plot, `side` beside it, `controls` under it: legend, toolbar, table) and `readout`;\n * the figure only provides those slots. The plot and `side` share the `body` row.\n */\n\nexport interface TitleModel {\n  readonly text: string;\n  readonly level: number;\n  readonly visible: boolean;\n}\n\nexport interface FigureModel {\n  readonly compact: boolean;\n  /** The heading, or null when there is none (only `labelledBy`, or no title at all). */\n  readonly title: TitleModel | null;\n  /** Id of a heading the page already has. */\n  readonly labelledBy: string | null;\n  /** Accessible name when neither a title nor `labelledBy` names the chart (generated, AX140). */\n  readonly name: string;\n  readonly subtitle: string | null;\n  readonly summary: string;\n  /** The plot is too small to draw (spec L8): the summary is shown instead. */\n  readonly summaryVisible: boolean;\n  readonly note: string | null;\n  /** Loading, empty, error or internal-error text shown inside the plot (spec L7); null when marks are shown. */\n  readonly message: string | null;\n  /**\n   * `lang` for the message and the note: 'en' when they show built-in English on a page in another\n   * language (spec A10), else null.\n   */\n  readonly messageLang?: string | null;\n  readonly noteLang?: string | null;\n}\n\nexport interface Figure {\n  readonly figure: HTMLElement;\n  readonly plot: HTMLElement;\n  readonly tooltip: HTMLElement;\n\n\n// ---------- diagnostics ----------\n\nexport interface Diagnostic {\n  /** Stable and documented, one page per code. */\n  code: `AX${number}`;\n  level: 'error' | 'warning' | 'hint';\n  /** What is wrong, where, and how to fix it. */\n  message: string;\n  /** The chart it came from: its title, else its element id. */\n  chart: string;\n  /** Where applicable. A diagnostic about the chart as a whole (no title, low contrast) has neither. */\n  field?: string;\n  /** First offending row indexes in the caller's own data, capped at 10. */\n  rows?: readonly number[];\n  count?: number;\n}\n\n/** Runs normalization and validation only. Works without a DOM, so a server or an agent can check options before rendering. */\n\n/** Built-in text. Templates use {name} placeholders. Every entry can be replaced through `messages` (spec A10). */\n28:  targetBox, targetOf, valueText, PAN_SHARE, ZOOM_FACTOR, type Mode,\n423:    const text = ref ? valueText(d.view, d.lookup, ref, mode, d.formatters, d.messages) : null;\n29:const TYPE_MESSAGE = {\n33:function statistics(y: Float64Array | Float32Array, { start, end }: IndexRange, slot?: Uint8Array) {\n39:    const value = y[i]!;\n48:function chartText(input: ReaderInput, type: string, xLabel: string, yLabel: string): string[] {\n49:  const { view, formatters, messages } = input;\n51:    const drawn = view.slices.filter(slice => slice.angles && slice.angles[1] > slice.angles[0]);\n56:        const { label, value, percent } = sliceText(view, slice, formatters);\n69:  const entries: string[] = [];\n70:  const undrawn: string[] = [];\n71:  const { frame } = view;\n72:  const zone = view.kind === 'scatter'\n77:    const { start, end } = view.visibleSlots;\n89:    const range = view.kind === 'scatter' ? view.visiblePoints[s]! : view.visibleSlots;\n94:    const stats = statistics(series.y, range, 'slot' in series ? series.slot : undefined);\n104:  const zoneText = zone ? [fill(messages.timeZoneNote, { zone })] : [];\n106:  const range = Number.isFinite(min) && Number.isFinite(max)\n116:function referenceText(view: View, formatters: Formatters, messages: Messages): string[] {\n119:    const write = axis === 'x' ? (x: number) => formatters.x(x) : (y: number) => formatters.value(0, y);\n120:    const values = { label, axis, from: write(from) };\n125:export function buildReader(input: ReaderInput): ReaderModel {\n126:  const { view, title, labelledBy, subtitle, description, formatters, messages, disclosure } = input;\n127:  const labels = {\n133:  const type = messages[TYPE_MESSAGE[view.kind]];\n134:  const xLabel = view.kind === 'donut' ? labels.category : view.frame.xLabel;\n135:  const yLabel = view.kind === 'donut' ? view.frame.valueLabel\n137:  const titleText = typeof title === 'string' ? title : title?.text;\n139:  const generated = fill(messages.chartName, { type, x: xLabel, y: yLabel });\n140:  const name = labelledBy ? '' : titleText || generated;\n141:  const omitted = disclosure?.omitted ?? 0;\n142:  const changed = disclosure?.changed ?? 0;\n143:  const statements: string[] = [];\n145:    const counts = { omitted: formatters.count(omitted), changed: formatters.count(changed) };\n149:  const omission = statements.join(' ');\n150:  const hidden = input.labelsHidden ?? 0;\n151:  const note = [omission, hidden > 0 ? fill(messages.labelsHidden, { count: formatters.count(hidden) }) : ''].filter(Boolean).join(' ') || null;\n152:  const compact = input.compact === true || (view.kind !== 'donut' && view.compact);\n154:  const referencesForView = () => references ??= referenceText(view, formatters, messages);\n156:  const caption = [input.caption, name, generated, messages.plotLabel].find(text => text?.trim()) ?? defaultMessages.plotLabel;\n{ \"extends\": \"../../tsconfig.base.json\", \"compilerOptions\": { \"rootDir\": \".\", \"outDir\": \"dist/types\" }, \"include\": [\"src\", \"test\"] }\n63:Each type has its own rules for picking, navigation and limits. They are in the type matrix in section 3.6, and a type does not ship until its row is fully tested.\n88:Every criterion maps to at least one test in the acceptance matrix kept in the repository (criterion → test → chart types it applies to → result). \"Property test\" means the statement is checked over at least 1,000 generated datasets. Expected values come from the fixture data and this specification, never from the implementation's output.\n94:| F1 | Bar and area value axes always include zero. An author `domain` that excludes zero is widened and raises AX110. | Property test on domains, including all-negative and mixed-sign data; `bars` fixture (values 82–97) starts at 0 | R1 |\n95:| F2 | Missing values are never drawn as zero and never bridged unless the author asks. An explicit `null` is a gap, silently. An isolated value between two gaps is a visible point. A missing bar shows a \"no data\" mark at the baseline, distinct from a zero bar. On a time or date axis with a regular step, an absent step is a gap and raises AX105; `missing: 'zero'` on the field turns absent and null values into zeros for counts. Tooltip, table and announcements say \"No data\". | `trend` with nulls and `trend` with the same 7 rows deleted render the same gap; `dirty` fixtures; property test that no segment connects across a missing index | R5 |\n100:| F7 | Domains follow one order of precedence: the zoomed view is inside the author's `domain` if given, otherwise inside the automatic domain. The automatic domain contains all data, reference lines and stack totals, and ends at the first tick at or beyond each extreme. A field declared `scale: 'percent'` (0–100) or `'ratio'` (0–1) ends at full scale only when its maximum is at least half of full scale and not above it. Nothing is inferred from a label. | Property tests; `bars` ends at 100 when declared `percent`; a 4% maximum ends at the first tick at or above 4% | R1 |\n103:| F10 | Stacks place positive and negative values on their own sides of zero, and the axis covers both totals. A missing component is drawn with zero height and the stack is marked \"incomplete\" in tooltip, table and announcements. | Property test on stacked geometry; mixed-sign and incomplete fixtures | R5 |\n145:| A9 | A conformance table lists every applicable WCAG 2.2 AA success criterion, the test that covers it, and what the author must supply (a meaningful title or `labelledBy`, series names, units, the page's own structure). It also states the limits in section 3.8. | Published with each release; a CI check that every listed test exists | R11 |\n197:| Limit that raises a diagnostic | Eight series | Eight series | Eight series | Eight slices | Eight series |\n216:Automated checks establish structure: names, roles, focus order, contrast, text. They do not establish that a screen-reader user finds a chart understandable. The only evidence for that in 1.0 is A3's rehearsal by the developer on five reader and browser pairs, recorded as rehearsal. Axylo is built by one person with no access to study participants, so no claim of usability testing with disabled users is made, and the conformance table says so in those words. Reviewers proposed participant testing as a release gate; it is recorded here as a known limit instead.\n228:| DX7 | Zero runtime dependencies (reconsidered only with a measured comparison). Size targets, provisional until M1 measures a working slice: 40 KiB gzipped for everything, 25 KiB for a page that uses only `line`, 2 KiB for the React adapter, CSS included. | size-limit in CI on the packed distribution | D4 |\n237:These numbers are provisional. They are design targets taken from Phase 1's order-of-magnitude measurements, and they become release gates only after the benchmark harness built in M0 has measured a working Axylo slice in M1 and the limits have been recalibrated and frozen (plan, M1 and M6). Each budget names its workload, metric and statistic so that two people measuring the same build get the same verdict.\n239:| ID | Workload | Metric | Statistic | Provisional limit | Phase 1 reference |\n285:| Test with screen-reader users, outside developers or design partners before release | One-person project with no participants. Recorded as a stated limit (3.8). Agent rehearsal (DX12) and developer rehearsal (A3) are used and labelled as such. |\n","exit_code":0,"status":"completed"}}
