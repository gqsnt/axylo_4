ts draw no references.' });\n   223\t  } else if (!donut && Array.isArray(options.reference)) {\n   224\t    options.reference.forEach((reference, row) => {\n   225\t      unknownKeys(object(reference), ['x', 'y', 'label'], sink, 'reference[' + row + '].');\n   226\t    });\n   227\t  }\n   228\t\n   229\t  const { table, valid: validTable } = retained ? { table: retained, valid: true } : resolveTable(options.data, sink);\n   230\t  const xInput = donut ? options.label : options.x;\n   231\t  const x = resolveX(xInput, type, compact, sink);\n   232\t  const wide = !donut && Array.isArray(options.y);\n   233\t  const supportsWide = type !== 'scatter' && !donut;\n   234\t  const valueInputs = wide ? options.y as readonly unknown[] : [donut ? options.value : options.y];\n   235\t  // Only the first value field supplies the shared axis's tick formatter.\n   236\t  const values = valueInputs.map((field, index) =>\n   237\t    resolveValue(field, wide ? 'y[' + index + '].' : donut ? 'value.' : 'y.', compact && index === 0, sink));\n   238\t  const series = !wide && !donut && typeof options.series === 'string' ? options.series : null;\n   239\t  if (wide && options.series !== undefined) {\n   240\t    report(sink, 'AX150', 'none', { field: 'series', count: 1, detail: 'Use a single y field when naming a series field.' });\n   241\t  }\n   242\t  if (wide && !supportsWide) {\n   243\t    report(sink, 'AX150', 'chart-error', { field: 'y', count: 1, detail: 'Use a single y field for scatter charts.' });\n   244\t  }\n   245\t\n   246\t  let valid = validTable && (!wide || supportsWide);\n   247\t  const fields: [string | null, string][] = [[fieldName(xInput), donut ? 'label' : 'x']];\n   248\t  for (const input of valueInputs) fields.push([fieldName(input), donut ? 'value' : 'y']);\n   249\t  if (values.length === 0) fields.push([null, 'y']);\n   250\t  if (series !== null) fields.push([series, 'series']);\n   251\t  valid = checkFields(table, fields, sink) && valid;\n   252\t\n   253\t  const title = typeof options.title === 'string' ? options.title : object(options.title).text;\n   254\t  const name = typeof title === 'string' && title ? title\n   255\t    : typeof options.labelledBy === 'string' && options.labelledBy ? options.labelledBy : type;\n{\n  \"name\": \"axylo\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Everyday charts that are faithful to the data, readable everywhere and accessible by default.\",\n  \"license\": \"MIT\",\n  \"type\": \"module\",\n  \"sideEffects\": [\"*.css\"],\n  \"files\": [\n    \"dist/axylo.js\",\n    \"dist/axylo.dev.js\",\n    \"dist/axylo.iife.js\",\n    \"dist/axylo.iife.min.js\",\n    \"dist/axylo.css\",\n    \"dist/index.d.ts\",\n    \"dist/public.d.ts\"\n  ],\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"development\": \"./dist/axylo.dev.js\",\n      \"default\": \"./dist/axylo.js\"\n    },\n    \"./axylo.css\": \"./dist/axylo.css\"\n  }\n}\n// Builds packages/axylo/dist: ESM (production and development flavours), script-tag files, CSS and type declarations.\n//\n// Importing this file builds nothing: it exports what another build of the library from source needs to\n// reproduce these files (bench/build.mjs): `stylesheets()` and `stylesheetPlugin(text)`, and the `define`\n// objects. Run directly (`node scripts/build.mjs`, `npm run build`), it builds.\nimport { build } from 'esbuild';\nimport { execFileSync } from 'node:child_process';\nimport fs from 'node:fs';\nimport path from 'node:path';\n\nconst root = path.resolve(import.meta.dirname, '..');\nconst pkg = path.join(root, 'packages/axylo');\n\n/** Runs a source module through esbuild and imports it, for the values the build needs from the library. */\nasync function evaluate(entry) {\n  const r = await build({ entryPoints: [entry], bundle: true, format: 'esm', write: false, logLevel: 'silent' });\n  return import('data:text/javascript;base64,' + Buffer.from(r.outputFiles[0].contents).toString('bas