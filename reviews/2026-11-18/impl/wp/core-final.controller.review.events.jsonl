{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/src/theme/watch.ts\nnl -ba packages/axylo/src/view/references.ts\nnl -ba packages/axylo/src/data/options.ts | sed -n '105,255p'\ncat packages/axylo/package.json\nsed -n '1,140p' scripts/build.mjs\"","aggregated_output":"     1\t/**\n     2\t * Notices the page changes that can change a chart's theme (spec L4): the three media features, and the\n     3\t * `class`, `style` or `data-theme` attribute of the chart or any of its ancestors (a class-toggled dark\n     4\t * theme may sit on `<html>`, `<body>` or a card in between). Bursts are folded into one call.\n     5\t *\n     6\t * One MutationObserver covers the whole document (`subtree`), and a record counts only when its target is\n     7\t * the chart or one of its ancestors at that moment, so the watch keeps working when the chart is moved to\n     8\t * another parent or `<body>` is replaced. Inside a shadow root, that root is observed as well.\n     9\t */\n    10\t\n    11\tconst QUERIES = ['(prefers-color-scheme: dark)', '(forced-colors: active)', '(prefers-contrast: more)'];\n    12\tconst ATTRIBUTES = ['class', 'style', 'data-theme'];\n    13\t\n    14\t/** Declarations resolveTheme itself writes on the chart root; changes to them alone are not theme changes. */\n    15\tconst OWN = /--axylo-(?:series-color-\\d+|backdrop)\\s*:[^;]*;?\\s*/g;\n    16\t\n    17\t/**\n    18\t * Calls `onChange` for a burst of relevant changes (once per observer batch), so the caller can feed it to its own\n    19\t * frame scheduler: the repaint lands in the next animation frame with any other pending work, drawn once\n    20\t * (review 3, finding 19). Returns `stop`.\n    21\t */\n    22\texport function watchTheme(element: Element, onChange: () => void): () => void {\n    23\t  const doc = element.ownerDocument;\n    24\t  const win = doc.defaultView;\n    25\t  if (win === null) return () => {};\n    26\t  let stopped = false;\n    27\t\n    28\t  // At once: the observer already delivers a burst as one batch, and the caller only marks itself dirty and\n    29\t  // schedules its frame, so the repaint is in the very next animation frame.\n    30\t  const schedule = (): void => {\n    31\t    if (!stopped) onChange();\n    32\t  };\n    33\t\n    34\t  const lists = QUERIES.map(q => win.matchMedia(q));\n    35\t  for (const list of lists) list.addEventListener('change', schedule);\n    36\t\n    37\t  const observer = new win.MutationObserver(records => {\n    38\t    for (const r of records) {\n    39\t      if (!holds(r.target, element)) continue;\n    40\t      if (r.target === element && r.attributeName === 'style') {\n    41\t        const before = (r.oldValue ?? '').replace(OWN, '').trim();\n    42\t        const after = (element.getAttribute('style') ?? '').replace(OWN, '').trim();\n    43\t        if (before === after) continue;\n    44\t      }\n    45\t      schedule();\n    46\t      return;\n    47\t    }\n    48\t  });\n    49\t  const options: MutationObserverInit = { attributes: true, attributeFilter: ATTRIBUTES, attributeOldValue: true, subtree: true };\n    50\t  observer.observe(doc.documentElement, options);\n    51\t  const root = element.getRootNode();\n    52\t  if (root !== doc && 'host' in root) observer.observe(root, options);\n    53\t\n    54\t  return () => {\n    55\t    if (stopped) return;\n    56\t    stopped = true;\n    57\t    for (const list of lists) list.removeEventListener('change', schedule);\n    58\t    observer.disconnect();\n    59\t  };\n    60\t}\n    61\t\n    62\t/** True when `target` is `element` or one of its ancestors, crossing shadow roots to their hosts. */\n    63\tfunction holds(target: Node, element: Node): boolean {\n    64\t  for (let n: Node | null = element; n !== null; n = n.parentNode ?? ('host' in n ? (n as ShadowRoot).host : null)) {\n    65\t    if (n === target) return true;\n    66\t  }\n    67\t  return false;\n    68\t}\n     1\timport type { DiagnosticSink, ResolvedReference, XColumn, XKind } from '../core/contracts';\n     2\timport type { ResolvedXField } from '../data';\n     3\timport { Reports } from '../data/reports';\n     4\timport { nameOf, XParser } from '../data/x';\n     5\timport { report } from '../diagnostics';\n     6\timport { diagnosticContext, type DiagnosticCode } from '../diagnostics/registry';\n     7\timport type { Reference, XValue } from '../public';\n     8\t\n     9\texport type Span<T = number> = readonly [T, T];\n    10\t\n    11\tinterface Option {\n    12\t  readonly field: string;\n    13\t  readonly sink: DiagnosticSink;\n    14\t  readonly axisPosition?: boolean;\n    15\t  readonly detail?: string;\n    16\t}\n    17\t\n    18\ttype PositionReader = (value: XValue, option?: Option) => number;\n    19\t\n    20\texport function positionReader(\n    21\t  x: Pick<XColumn, 'kind' | 'categories' | 'timeZone'>,\n    22\t  field: ResolvedXField | undefined,\n    23\t): PositionReader {\n    24\t  if (x.kind === 'category') return (value, option) => {\n    25\t    const name = nameOf(value);\n    26\t    const index = name === null ? -1 : x.categories?.indexOf(name) ?? -1;\n    27\t    if (index >= 0) return index;\n    28\t    if (option) report(option.sink, 'AX107', 'none', {\n    29\t      field: option.field, detail: option.detail, outcome: 'The option is ignored.',\n    30\t    });\n    31\t    return NaN;\n    32\t  };\n    33\t  const resolved: ResolvedXField = field ?? {\n    34\t    field: 'x', label: 'x', unit: null, type: x.kind === 'wall' || x.kind === 'number' ? null : x.kind,\n    35\t    timeZone: x.timeZone ?? 'UTC', ordered: false, format: null, tickFormat: null, domain: null,\n    36\t  };\n    37\t  const parser = new XParser(resolved, x.kind, { timeZone: x.timeZone ?? 'UTC' });\n    38\t  return (value, option) => {\n    39\t    if (option?.axisPosition && x.kind !== 'number' && typeof value === 'number' && Number.isFinite(value)) return value;\n    40\t    const reports = new Reports(option?.field ?? resolved.field);\n    41\t    const position = parser.read(value, -1, reports);\n    42\t    // The parser's diagnostics still apply, but an option has no source row or omitted data values.\n    43\t    if (option) reports.flush({\n    44\t      add(diagnostic) {\n    45\t        const context = diagnosticContext(diagnostic);\n    46\t        report(option.sink, diagnostic.code as DiagnosticCode, 'none', {\n    47\t          ...context, field: diagnostic.field, count: diagnostic.count,\n    48\t          detail: diagnostic.effect === 'omitted' ? option.detail : context?.detail,\n    49\t          outcome: diagnostic.effect === 'omitted' ? 'The option is ignored.' : context?.outcome,\n    50\t        });\n    51\t      },\n    52\t    });\n    53\t    return position;\n    54\t  };\n    55\t}\n    56\t\n    57\texport function readSpan(\n    58\t  input: Span<XValue> | null | undefined, read: PositionReader, field: string, sink: DiagnosticSink,\n    59\t  ordered = false,\n    60\t): Span | null {\n    61\t  if (!input) return null;\n    62\t  const option = { field, sink, axisPosition: true, detail: 'Supply two bounds in the x axis format.' };\n    63\t  const a = read(input[0], option);\n    64\t  const b = read(input[1], option);\n    65\t  if (!Number.isFinite(a) || !Number.isFinite(b) || ordered && a >= b) return null;\n    66\t  return [Math.min(a, b), Math.max(a, b)];\n    67\t}\n    68\t\n    69\tfunction isPair<T>(value: T | Span<T>): value is Span<T> {\n    70\t  return Array.isArray(value);\n    71\t}\n    72\t\n    73\texport function resolveReferences(\n    74\t  input: readonly Reference[], readX: PositionReader, xKind: XKind, sink: DiagnosticSink,\n    75\t): ResolvedReference[] {\n    76\t  const references: ResolvedReference[] = [];\n    77\t  for (let i = 0; i < input.length; i++) {\n    78\t    const { x, y, label } = input[i]!;\n    79\t    const add = (axis: 'x' | 'y', from: number, to: number) => {\n    80\t      references.push({ axis, from: Math.min(from, to), to: Math.max(from, to), label });\n    81\t    };\n    82\t    if (x !== undefined) {\n    83\t      const pair = isPair(x);\n    84\t      const option = {\n    85\t        field: 'reference[' + i + '].x', sink,\n    86\t        detail: xKind === 'category' ? 'Use an existing category for each bound.' : 'Supply a reference in the x axis format.',\n    87\t      };\n    88\t      const from = readX(pair ? x[0] : x, option);\n    89\t      const to = pair ? readX(x[1], option) : from;\n    90\t      if (Number.isFinite(from) && Number.isFinite(to)) add('x', from, to);\n    91\t    }\n    92\t    if (y !== undefined) {\n    93\t      const pair = isPair(y);\n    94\t      const from = pair ? y[0] : y;\n    95\t      const to = pair ? y[1] : from;\n    96\t      if (Number.isFinite(from) && Number.isFinite(to)) {\n    97\t        add('y', from, to);\n    98\t      } else {\n    99\t        report(sink, 'AX103', 'none', { field: 'reference[' + i + '].y' });\n   100\t      }\n   101\t    }\n   102\t  }\n   103\t  return references;\n   104\t}\n   105\t  try {\n   106\t    return Intl.DateTimeFormat('en', { timeZone: zone }).resolvedOptions().timeZone;\n   107\t  } catch {\n   108\t    return undefined;\n   109\t  }\n   110\t}\n   111\t\n   112\tfunction object(value: unknown): Record<string, unknown> {\n   113\t  return value !== null && typeof value === 'object' ? value as Record<string, unknown> : {};\n   114\t}\n   115\t\n   116\tfunction unknownKeys(options: Record<string, unknown>, keys: readonly string[], sink: DiagnosticSink, path = ''): void {\n   117\t  for (const key of Object.keys(options)) {\n   118\t    if (!keys.includes(key)) {\n   119\t      const suggestion = closest(key, keys);\n   120\t      report(sink, 'AX150', 'none', { field: path + key, suggestion: suggestion && path + suggestion, count: 1 });\n   121\t    }\n   122\t  }\n   123\t}\n   124\t\n   125\texport function resolveTable(data: unknown, sink: DiagnosticSink): { table: Table; valid: boolean } {\n   126\t  if (Array.isArray(data)) return { table: rowsTable(data), valid: true };\n   127\t  const columns = object(object(data).columns) as Columns;\n   128\t  const keys = Object.keys(columns);\n   129\t  const length = columns[keys[0] ?? '']?.length ?? 0;\n   130\t  const differing = keys.find(key => {\n   131\t    const column = columns[key];\n   132\t    return typeof column !== 'object' || column === null || column.length !== length ||\n   133\t      !Number.isInteger(column.length) || column.length < 0 || column.length > 0x7fffffff;\n   134\t  });\n   135\t  if (differing !== undefined) {\n   136\t    report(sink, 'AX100', 'chart-error', {\n   137\t      field: differing, count: 1, examples: keys.map(key => JSON.stringify(key) + ': ' + columns[key]?.length),\n   138\t    });\n   139\t  }\n   140\t  return { table: columnsTable(columns, differing === undefined ? length : 0), valid: differing === undefined };\n   141\t}\n   142\t\n   143\tfunction fieldName(input: unknown): string | null {\n   144\t  const field = typeof input === 'string' ? input : object(input).field;\n   145\t  return typeof field === 'string' ? field : null;\n   146\t}\n   147\t\n   148\tfunction resolveTickFormat<T>(format: T | undefined, path: string, compact: boolean, sink: DiagnosticSink): T | null {\n   149\t  if (!compact || format == null) return format ?? null;\n   150\t  report(sink, 'AX150', 'none', { field: path + 'tickFormat', count: 1, detail: 'Compact charts draw no axis ticks.' });\n   151\t  return null;\n   152\t}\n   153\t\n   154\tfunction resolveX(input: unknown, type: ChartType, compact: boolean, sink: DiagnosticSink): ResolvedXField {\n   155\t  const options = object(input) as XFieldOptions;\n   156\t  if (type !== 'donut') unknownKeys(object(input), type === 'scatter' ? scatterXKeys : xKeys, sink, 'x.');\n   157\t  const field = fieldName(input) ?? '';\n   158\t  const declared = literal(options.type, ['number', 'time', 'date', 'category'], 'x.type', sink);\n   159\t  const zone = options.timeZone === undefined || options.timeZone === 'local'\n   160\t    ? 'local' : canonicalZone(options.timeZone);\n   161\t  if (zone === undefined) {\n   162\t    const examples = typeof options.timeZone === 'string' ? [JSON.stringify(options.timeZone)] : undefined;\n   163\t    report(sink, 'AX152', 'none', { field: 'x.timeZone', examples });\n   164\t  }\n   165\t  return {\n   166\t    field, label: options.label ?? field, unit: options.unit ?? null,\n   167\t    type: type === 'donut' ? 'category' : declared ?? null,\n   168\t    timeZone: zone ?? 'local', ordered: type !== 'scatter' && (options.ordered ?? false),\n   169\t    format: options.format ?? null, tickFormat: resolveTickFormat(options.tickFormat, 'x.', compact, sink),\n   170\t    domain: options.domain ?? null,\n   171\t  };\n   172\t}\n   173\t\n   174\tfunction resolveValue(input: unknown, path: string, compact: boolean, sink: DiagnosticSink): ResolvedValueField {\n   175\t  const options = object(input) as ValueFieldOptions & { parse?: 'number' };\n   176\t  unknownKeys(object(input), valueKeys, sink, path);\n   177\t  const field = fieldName(input) ?? '';\n   178\t  return {\n   179\t    field, label: options.label ?? field, unit: options.unit ?? null,\n   180\t    scale: literal(options.scale, ['percent', 'ratio'], path + 'scale', sink) ?? null,\n   181\t    missing: literal(options.missing, ['gap', 'zero'], path + 'missing', sink) ?? 'gap',\n   182\t    parse: literal(options.parse, ['number'], path + 'parse', sink) ?? null, format: options.format ?? null,\n   183\t    tickFormat: resolveTickFormat(options.tickFormat, path, compact, sink), domain: options.domain ?? null,\n   184\t  };\n   185\t}\n   186\t\n   187\tconst encodings = new WeakMap<ResolvedOptions, {\n   188\t  readonly named: readonly (readonly [string | null, string])[];\n   189\t  readon