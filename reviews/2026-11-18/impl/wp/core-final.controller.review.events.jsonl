es).toEqual([1, 2, 3, 5]);\n   584\t  });\n   585\t});\n   586\t\n   587\tdescribe('the bench describe names the kept samples and the renderer', () => {\n   588\t  it('a dense line keeps its outlier and both ends, never a missing row, and says which renderer draws it', () => {\n   589\t    const n = 10_000;\n   590\t    const y = Float64Array.from({ length: n }, (_, i) => (i === 5000 ? 1000 : i % 3));\n   591\t    y[7000] = NaN;\n   592\t    const r = record('line', { title: 'Dense', data: { columns: { x: Float64Array.from({ length: n }, (_, i) => i), y } }, x: 'x', y: 'y' });\n   593\t    r.frames();\n   594\t    const d = describeOf(r);\n   595\t    expect(d.renderer).toBe('svg');\n   596\t    const kept = d.series[0]!.kept!;\n   597\t    expect(kept.length).toBeLessThan(n / 4);\n   598\t    expect(kept).toContain(5000);\n   599\t    expect(kept[0]).toBe(0);\n   600\t    expect(kept.at(-1)).toBe(n - 1);\n   601\t    expect(kept).not.toContain(7000);\n   602\t    // The drawing itself, not describe()'s recomputation (controller review, finding 20): the stroke reaches\n   603\t    // the outlier's pixel and both ends, lifts the pen at the missing row, and is simplified.\n   604\t    const layout = r.layout;\n   605\t    if (layout?.kind !== 'plot' || layout.projection.kind !== 'xy') throw new Error('expected a plot');\n   606\t    const { x, y: yScale } = layout.projection;\n   607\t    if (x.type === 'band') throw new Error('expected a continuous x');\n   608\t    const path = r.draws.at(-1)!.marks.find(m => m.type === 'path' && m.series === 0);\n   609\t    if (path?.type !== 'path') throw new Error('expected the line');\n   610\t    const xs: number[] = [];\n   611\t    const ys: number[] = [];\n   612\t    let lifts = 0;\n   613\t    for (let i = 0; i < path.xy.length; i += 2) {\n   614\t      if (Number.isNaN(path.xy[i]!)) { lifts += 1; continue; }\n   615\t      xs.push(path.xy[i]!);\n   616\t      ys.push(path.xy[i + 1]!);\n   617\t    }\n   618\t    expect(xs.length).toBeLessThan(n / 4);\n   619\t    expect(Math.min(...ys)).toBeCloseTo(yScale.map(1000), 1);\n   620\t    expect(xs[0]).toBeCloseTo(x.map(0), 1);\n   621\t    expect(xs.at(-1)).toBeCloseTo(x.map(n - 1), 1);\n   622\t    expect(lifts).toBe(1);\n   623\t  });\n   624\t});\n   175\t  it('a segment crossing a zoomed window is drawn, not \"No data\"', async () => {\n   176\t    const page = await chartPage();\n   177\t    const result = await page.evaluate(async () => {\n   178\t      const chart = window.Axylo.line!('#chart', { title: 'Z', data: [{ x: 0, y: 0 }, { x: 10, y: 10 }], x: 'x', y: 'y' });\n   179\t      window.charts.push(chart);\n   180\t      chart.zoom([2, 4]);\n   181\t      await chart.__bench.ready();\n   182\t      await window.nextFrames(1);\n   183\t      const probe = document.querySelector('#chart figure')!.appendChild(document.createElement('span'));\n   184\t      probe.style.color = 'var(--axylo-series-color-1)';\n   185\t      const color = getComputedStyle(probe).color.match(/\\d+/g)!.map(Number);\n   186\t      probe.remove();\n   187\t      return {\n   188\t        hidden: (document.querySelector('#chart .axylo-message') as HTMLElement).hidden,\n   189\t        color,\n   190\t        valueText: document.querySelector('#chart .axylo-proxy')?.getAttribute('aria-valuetext') ?? null,\n   191\t      };\n   192\t    });\n   193\t    expect(result.hidden).toBe(true);\n   194\t    expect(result.valueText).not.toBe('No data to show.');\n   195\t    // The stroke itself (controller review, finding 20): the series color across most of the plot's width.\n   196\t    const { img } = await shot(page, '#chart .axylo-plot');\n   197\t    const has = columnsWith(img, result.color as unknown as RGB, 0, img.height, 40);\n   198\t    const inside = has.slice(Math.floor(img.width * 0.2), Math.floor(img.width * 0.9));\n   199\t    expect(inside.filter(Boolean).length).toBeGreaterThan(inside.length * 0.9);\n   200\t    expect(await closePage(page)).toEqual([]);\n   201\t  });\n   202\t\n   203\t  it('a window that no longer ends at the latest x after a data replacement stays put when rows arrive', async () => {\n   204\t    const page = await chartPage();\n   205\t    const domain = await page.evaluate(async () => {\n   206\t      const r = (xs: number[]) => xs.map(x => ({ x, y: x }));\n   207\t      const chart = window.Axylo.line!('#chart', { title: 'F', data: r([0, 5, 10]), x: 'x', y: 'y' });\n   208\t      chart.zoom([5, 10]);\n   209\t      chart.update({ data: r([0, 5, 10, 15]) });\n   210\t      chart.append([{ x: 20, y: 20 }]);\n   211\t      await chart.__bench.ready();\n   212\t      return chart.__bench.describe().xDomain;\n   280\t      // Count listeners on the document, its font set and media queries, and observers on the document.\n   281\t      const live = new Set<string>();\n   282\t      const add = EventTarget.prototype.addEventListener;\n   283\t      const remove = EventTarget.prototype.removeEventListener;\n   284\t      const name = (t: EventTarget, type: string, fn: unknown) => `${t === document ? 'document' : t === document.fonts ? 'fonts' : t instanceof MediaQueryList ? `mq:${t.media}` : 'other'}|${type}|${String(fn).length}|${(window as unknown as { ids: WeakMap<object, number> }).ids.get(fn as object)}`;\n   285\t      const ids = new WeakMap<object, number>();\n   286\t      (window as unknown as { ids: WeakMap<object, number> }).ids = ids;\n   287\t      let n = 0;\n   288\t      EventTarget.prototype.addEventListener = function (this: EventTarget, type: string, fn: EventListenerOrEventListenerObject | null, o?: boolean | AddEventListenerOptions) {\n   289\t        if (fn && (this === document || this === document.fonts || this instanceof MediaQueryList)) {\n   290\t          if (!ids.has(fn as object)) ids.set(fn as object, ++n);\n   291\t          const entry = name(this, type, fn);\n   292\t          live.add(entry);\n   293\t          // A listener removed by aborting its signal 