 : undefined;\n   319\t  return buildDonut(frame, state.otherLabel, previous, sink);\n   320\t}\n   321\t\n   322\t/** What the scatter and aligned views share: visibility, cues, references and the x domains. */\n   323\tfunction cartesianBase(\n   324\t  frame: AlignedFrame | PointFrame, state: AlignedViewState | ScatterViewState, sink: DiagnosticSink,\n   325\t  /** The data's x extent (the shape's own: bar bands, or scatter's points and their missing observations). */\n   326\t  extent: (continuousBars: boolean) => Span,\n   327\t) {\n   328\t  // A previous view of the same kind (never a donut here).\n   329\t  const prior = state.previous?.kind === state.kind ? state.previous as AlignedView | ScatterView : undefined;\n   330\t  const sameFrame = prior?.frame === frame;\n   331\t  const compact = state.kind !== 'scatter' && (state.compact ?? false);\n   332\t  const visible = reuse(frame.series.map(series => series.drawable && !state.hidden?.has(series.key)), prior?.visible, (a, b) => a === b);\n   333\t  const seriesCues = cues(frame.series.length, compact, prior, sink);\n   334\t  const column = frame.shape === 'aligned' ? frame.x : { kind: frame.xKind, timeZone: frame.timeZone, categories: null };\n   335\t  const readX = positionReader(column, state.xField);\n   336\t  const references = reuse(compact ? [] : resolveReferences(state.references ?? [], readX, column.kind, sink), prior?.references,\n   337\t    (a, b) => a.axis === b.axis && a.from === b.from && a.to === b.to && a.label === b.label);\n   338\t  const category = column.kind === 'category';\n   339\t  const continuousBars = state.kind === 'bar' && !category;\n   340\t  const xData = extent(continuousBars);\n   341\t  const spans = xExtents(xData, column.kind, readX, references, state, compact, sink);\n   342\t  const xFull = keepSpan(spans.xFull, prior?.xFull);\n   343\t  const xDomain = sameSpan(xFull, spans.xDomain) ? xFull : keepSpan(spans.xDomain, prior?.xDomain);\n   344\t  const shared = { c