{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/src/core/controller.ts | sed -n '1,610p'\"","aggregated_output":"     1\t/**\n     2\t * The chart controller: one implementation behind `line`, `area`, `bar`, `scatter` and `donut`, written\n     3\t * against a `Host` that supplies everything the page provides (animation frames, the figure, the mark and\n     4\t * text renderers, the interaction layer, measurement, theme resolution). The browser host is built in\n     5\t * chart.ts; Node tests supply recording substitutes and a manual frame queue.\n     6\t *\n     7\t * Two phases (plan 1.5). A call (create, update, append, zoom) resolves options, normalizes or prepares\n     8\t * what changed and builds the view synchronously, so `diagnostics` is current when it returns and a `strict`\n     9\t * chart throws from it before anything is accepted: data changes are prepared in the store and committed\n    10\t * only after the candidate view validated. Everything that needs the page runs in the next animation frame,\n    11\t * from the accepted state only, and switches together: no frame mixes two revisions. A revision's rows are\n    12\t * retired only after the frame that replaced it has been drawn, so hover, tooltip, events and `Point.row`\n    13\t * always come from the displayed revision.\n    14\t *\n    15\t * Each frame stage is cached and reruns only when its inputs change (plan 2.2). In development builds the\n    16\t * handle exposes a counter per stage (`__dev.stages()`) so tests can assert what reran.\n    17\t */\n    18\timport {\n    19\t  SLOT_NO_ROW, SLOT_VALUE,\n    20\t  type DatumRef, type DiagnosticInput, type Formatters, type Frame, type Layout, type Lookup, type MarkRenderer,\n    21\t  type PlacedText, type ReaderModel, type ResolvedTheme, type PaintBindings, type Scene, type TextMeasurer,\n    22\t  type TextStyle, type View,\n    23\t} from './contracts';\n    24\timport type { ChartEvents, Diagnostic, Messages, Point, Title, XValue } from '../public';\n    25\timport type { PreparedFrame } from '../data';\n    26\timport { resolveOptions, type ChartType, type ResolvedOptions } from '../data/options';\n    27\timport { createDiagnostic, DiagnosticCollector, readerDisclosure, type DiagnosticCode } from '../diagnostics';\n    28\timport { createFormatters, type FormatSpec } from '../format';\n    29\timport { dateUnitOf } from '../data/x';\n    30\timport { rowsTable, type Table } from '../data/table';\n    31\timport { computeLayout } from '../layout';\n    32\timport { readerWith, seriesNotDrawnSentence } from '../reader';\n    33\timport { fill, resolveMessages } from '../messages';\n    34\timport { lowContrastSeries, type ThemeResolution } from '../theme';\n    35\timport { OptionsStore, sameValue, type OptionRecord } from './options';\n    36\timport { Delivery, diagnosticKey, StrictError, strictViolations, type DeliveryConsole } from './delivery';\n    37\timport { layoutInput, layoutKey, sameKey, type AxisContext } from './axes';\n    38\timport { zoomApplies } from './focus';\n    39\timport { lowerBound } from '../lookup/search';\n    40\timport {\n    41\t  completeViewDiagnostics, dedupe, encodingChanged, isCompact, namesOnlyChanged, namingDiagnostics, object, publicOptions, stringOption,\n    42\t  titleOf, toPublic, viewKeyFor, viewStateFor, type Span,\n    43\t} from './stages';\n    44\timport type { FigureModel } from '../dom/figure';\n    45\timport type { Committed, ControlsState } from '../dom/interaction';\n    46\timport type { Composition, Store } from './composition';\n    47\timport { attachHooks, StageCounter, type ChartHandle, type Stage } from './instrument';\n    48\timport { COMPOSITIONS } from '../kinds';\n    49\t\n    50\texport type ChartKind = ChartType;\n    51\t\n    52\t/** Thrown inside a frame to stop it before anything was written (see `frame`). */\n    53\tconst ABORT = Symbol('axylo frame superseded');\n    54\t\n    55\texport type { BenchHook, ChartHandle, DevHook, Stage } from './instrument';\n    56\t\n    57\tconst KIND_NAMES: Record<ChartKind, string> = { line: 'Line', area: 'Area', bar: 'Bar', scatter: 'Scatter', donut: 'Donut' };\n    58\tconst KIND_MESSAGES = { line: 'typeLine', area: 'typeArea', bar: 'typeBar', scatter: 'typeScatter', donut: 'typeDonut' } as const;\n    59\t/** Option resolution reports these about the data; they belong to the call that set the data. */\n    60\tconst DATA_CODES = new Set(['AX100', 'AX101']);\n    61\t/** Positions of the title, the labelledBy id and the caption in the reader's inputs: they name, they do not summarize. */\n    62\tconst NAMING_INPUTS = new Set([3, 4, 13]);\n    63\t\n    64\texport interface Size {\n    65\t  readonly width: number;\n    66\t  readonly height: number;\n    67\t  /**\n    68\t   * The plot's column (the plot and, in readout mode, the strip under it): the same in both modes, so the\n    69\t   * mode decided from it does not flip with its own strip. Absent: the plot's size.\n    70\t   */\n    71\t  readonly room?: { readonly width: number; readonly height: number };\n    72\t}\n    73\t\n    74\t/** Decision 0004 revision 2, rule 5: a plot narrower or shorter than this is in readout mode. */\n    75\tconst READOUT_WIDTH = 240;\n    76\tconst READOUT_HEIGHT = 140;\n    77\t/** Spec L8: the smallest plot height drawn. */\n    78\tconst MIN_PLOT_HEIGHT = 80;\n    79\t\n    80\t/** Everything the controller needs from the page. */\n    81\texport interface Host {\n    82\t  /** Allocated, for the DOM relationships (aria-describedby, the table's id). */\n    83\t  readonly id: string;\n    84\t  /** The target element's own `id`, when it has one: an untitled chart is named by it in diagnostics. */\n    85\t  readonly targetId?: string | null;\n    86\t  readonly console: DeliveryConsole | null;\n    87\t  /** The page the once-per-code printing rule applies to. */\n    88\t  readonly page: object;\n    89\t  readonly timeZone: string;\n    90\t  readonly renderer: Pick<MarkRenderer, 'kind' | 'draw'>;\n    91\t  readonly text: { render(texts: readonly PlacedText[]): void };\n    92\t  readonly figure: { update(model: FigureModel): boolean; announce(text: string, lang?: string | null): void };\n    93\t  readonly interaction: { prepare(state: ControlsState): boolean; commit(state: Committed | null): void; clear(): void };\n    94\t  readonly measurer: TextMeasurer;\n    95\t  /** The callback gets the animation frame's time when the host has one. */\n    96\t  requestFrame(callback: (time?: number) => void): number;\n    97\t  cancelFrame(handle: number): void;\n    98\t  locale(option: unknown): string;\n    99\t  pageLang(): string | null;\n   100\t  /** Text of the page element with this id, or null when there is none. */\n   101\t  labelText(id: string): string | null;\n   102\t  textStyle(): TextStyle;\n   103\t  /**\n   104\t   * The plot container's size as the figure lays it out, with what the rest of the figure overflows by\n   105\t   * subtracted from its height (so it can be negative); null when the figure is not laid out at all (hidden\n   106\t   * or detached), which is not the same as a visible figure whose caption left no room.\n   107\t   */\n   108\t  measure(): Size | null;\n   109\t  devicePixelRatio(): number;\n   110\t  theme(seriesKeys: readonly string[], colors: Record<string, string>): ThemeResolution;\n   111\t  /** Shows or hides the mark and text surfaces without drawing (the error revision hides them). */\n   112\t  surfaces?(visible: boolean): void;\n   113\t  /** Called once by destroy, after the controller released its own state. */\n   114\t  dispose(): void;\n   115\t}\n   116\t\n   117\t/** What the page tells the controller (observers, watchers). */\n   118\texport interface Invalidate {\n   119\t  resize(): void;\n   120\t  /** The chart came back into the document: anything about the page may have changed meanwhile. */\n   121\t  page(): void;\n   122\t  theme(): void;\n   123\t  /** The page's language changed: locale and English marking are read again in the next frame. */\n   124\t  language(): void;\n   125\t  fonts(): void;\n   126\t  pixelRatio(): void;\n   127\t}\n   128\t\n   129\t/** What the interaction layer may ask for; everything goes through the public paths. */\n   130\texport interface ControllerActions {\n   131\t  zoom(window: Span | null): void;\n   132\t  toggle(seriesKey: string): void;\n   133\t  pause(paused: boolean): void;\n   134\t  select(ref: DatumRef): void;\n   135\t  hover(ref: DatumRef | null): void;\n   136\t}\n   137\t\n   138\texport interface Controller {\n   139\t  readonly handle: ChartHandle;\n   140\t  readonly actions: ControllerActions;\n   141\t  readonly invalidate: Invalidate;\n   142\t  /** Runs the pending frame now (tests, and theme changes that arrive inside a frame). */\n   143\t  flush(): void;\n   144\t}\n   145\t\n   146\t/** The state a call produced. Only accepted states are drawn. */\n   147\tinterface Accepted {\n   148\t  readonly options: OptionRecord;\n   149\t  /** Options resolved for the latest call (domains, formats, labels). */\n   150\t  readonly resolved: ResolvedOptions;\n   151\t  /** The resolution the current data was normalized with (on the static path it holds the borrowed table). */\n   152\t  readonly source: ResolvedOptions;\n   153\t  /** null until the first append: a static chart keeps the normalized frame over the caller's data. */\n   154\t  readonly store: Store | null;\n   155\t  /** The frame shown (while paused, the store may hold a newer one). */\n   156\t  readonly frame: Frame;\n   157\t  readonly dataDiagnostics: readonly DiagnosticInput[];\n   158\t  /** AX100 and AX101 from the call that set the data; kept while the data and fields stay. */\n   159\t  readonly dataOptions: readonly DiagnosticInput[];\n   160\t  readonly optionDiagnostics: readonly DiagnosticInput[];\n   161\t  readonly viewDiagnostics: readonly DiagnosticInput[];\n   162\t  readonly naming: readonly DiagnosticInput[];\n   163\t  readonly view: View;\n   164\t  readonly viewKey: readonly unknown[];\n   165\t  readonly zoom: Span<XValue> | null;\n   166\t  /** Zoomed to the latest edge: the window follows appended data (plan 1.5). */\n   167\t  readonly follow: boolean;\n   168\t  readonly revision: number;\n   169\t  readonly messages: Messages;\n   170\t  readonly name: string;\n   171\t  /** Series the reader hid with the legend, by key (the view's hidden set). */\n   172\t  readonly hidden: ReadonlySet<string>;\n   173\t}\n   174\t\n   175\ttype Display =\n   176\t  | { readonly kind: 'ready' }\n   177\t  | {\n   178\t    readonly kind: 'loading' | 'error' | 'empty' | 'internal'; readonly text: string;\n   179\t    /** The built-in message shown, or null when the author wrote the text. */\n   180\t    readonly message: keyof Messages | null;\n   181\t  };\n   182\t\n   183\t/** Presentation diagnostics by the stage that found them (spec 3.5: reported when found, never thrown). */\n   184\ttype PresentationStage = 'theme' | 'layout' | 'fit' | 'format' | 'naming' | 'internal';\n   185\t\n   186\t/**\n   187\t * An x position in the form `zoom()` and the data read it, so an event's window or `Point.x` can be passed\n   188\t * to another chart unchanged (documentation finding 2): a Date for an instant, 'YYYY-MM-DD' for a date, an\n   189\t * ISO date-time without offset for a wall-clock time, the category's name, else the number.\n   190\t */\n   191\texport function positionValue(frame: Frame, position: number): XValue {\n   192\t  if (frame.shape === 'donut') return position;\n   193\t  const kind = frame.shape === 'points' ? frame.xKind : frame.x.kind;\n   194\t  if (kind === 'time') return new Date(position);\n   195\t  if ((kind === 'date' || kind === 'wall') && Number.isFinite(position)) {\n   196\t    const iso = new Date(position).toISOString();\n   197\t    // Only four-digit years read back as written; others stay positions.\n   198\t    if (iso.length !== 24) return position;\n   199\t    // A date is written as one; a position between dates (the padded end of a bar axis) stays a number,\n   200\t    // which zoom() reads as the same position.\n   201\t    if (kind === 'date') return iso.endsWith('T00:00:00.000Z') ? iso.slice(0, 10) : position;\n   202\t    // The shortest wall-clock form that keeps the time: seconds and milliseconds only when not zero.\n   203\t    return iso.endsWith(':00.000Z') ? iso.slice(0, 16) : iso.endsWith('.000Z') ? iso.slice(0, 19) : iso.slice(0, 23);\n   204\t  }\n   205\t  if (kind === 'category' && frame.shape === 'aligned') return frame.x.categories?.[position] ?? position;\n   206\t  return position;\n   207\t}\n   208\t\n   209\t/** Whether a window can be set on this frame's x axis: time, date and number axes only in 1.0 (spec I3). */\n   210\tfunction zoomable(frame: Frame): boolean {\n   211\t  return frame.shape === 'points' || (frame.shape === 'aligned' && frame.x.kind !== 'category');\n   212\t}\n   213\t\n   214\tfunction isWall(frame: Frame): boolean {\n   215\t  return frame.shape === 'aligned' ? frame.x.kind === 'wall' : frame.shape === 'points' && frame.xKind === 'wall';\n   216\t}\n   217\t\n   218\tfunction latestX(frame: Frame): number {\n   219\t  if (frame.shape === 'aligned') return frame.x.values.length ? frame.x.values[frame.x.values.length - 1]! : NaN;\n   220\t  if (frame.shape === 'points') {\n   221\t    let latest = -Infinity;\n   222\t    for (const s of frame.series) {\n   223\t      if (s.x.length) latest = Math.max(latest, s.x[s.x.length - 1]!);\n   224\t      // An observation with no y still marks how far the data reaches.\n   225\t      if (s.missingX) for (let i = 0; i < s.missingX.length; i++) if (Number.isFinite(s.missingX[i]!)) latest = Math.max(latest, s.missingX[i]!);\n   226\t    }\n   227\t    return latest;\n   228\t  }\n   229\t  return NaN;\n   230\t}\n   231\t\n   232\t/** A window that ends at the latest x and does not show everything follows the data (plan 1.5). */\n   233\tfunction followsLatest(view: View, zoom: Span<XValue> | null): boolean {\n   234\t  if (zoom === null || view.kind === 'donut') return false;\n   235\t  // The data's own latest position, not the niced or padded edge of the axis (finding 16).\n   236\t  const latest = latestX(view.frame);\n   237\t  return Number.isFinite(latest) && view.xDomain[1] >= latest && view.xDomain[0] > view.xFull[0];\n   238\t}\n   239\t\n   240\t/** What a destroyed controller holds instead of its host, so a handle kept by the page retains no DOM. */\n   241\tfunction deadHost(from: Host): Host {\n   242\t  const none = (): null => null;\n   243\t  const empty = { width: 0, height: 0 };\n   244\t  return {\n   245\t    id: from.id, console: null, page: {}, timeZone: from.timeZone,\n   246\t    renderer: { kind: from.renderer.kind, draw() {} }, text: { render() {} },\n   247\t    figure: { update: () => false, announce() {} }, interaction: { prepare: () => false, commit() {}, clear() {} },\n   248\t    measurer: { width: () => 0 }, requestFrame: () => 0, cancelFrame() {}, locale: () => 'en', pageLang: none,\n   249\t    labelText: none, textStyle: () => ({ font: '', letterSpacing: 0, wordSpacing: 0, lineHeight: 0 }), measure: () => empty,\n   250\t    devicePixelRatio: () => 1,\n   251\t    theme: () => { throw new Error('Axylo: the chart was destroyed.'); },\n   252\t    dispose() {},\n   253\t  };\n   254\t}\n   255\t\n   256\t/** The controller for a kind given by name (tests and Node hosts); the chart functions pass their composition. */\n   257\texport function createController(kind: ChartKind, input: unknown, page: Host): Controller {\n   258\t  return controllerFor(COMPOSITIONS[kind], input, page);\n   259\t}\n   260\t\n   261\t/** The controller for one chart kind: every stage that differs between kinds comes from its composition. */\n   262\texport function controllerFor(composition: Composition, input: unknown, page: Host): Controller {\n   263\t  const kind = composition.kind;\n   264\t  let host = page;\n   265\t  // Instrumentation (core/instrument.ts): only in development and benchmark builds; the guard folds to false in\n   266\t  // the shipped production files, which then carry neither the counters nor the hooks.\n   267\t  const stages = __DEV__ || (typeof __BENCH__ !== 'undefined' && __BENCH__) ? new StageCounter() : null;\n   268\t  const stage = (name: Stage): void => {\n   269\t    if (__DEV__ || (typeof __BENCH__ !== 'undefined' && __BENCH__)) stages!.ran(name);\n   270\t  };\n   271\t  let delivery = new Delivery({ console: host.console, development: __DEV__, page: host.page });\n   272\t  const timeZone = host.timeZone;\n   273\t  const environment = { timeZone };\n   274\t\n   275\t  // ── synchronous phase ──────────────────────────────────────────────────────────────────────────\n   276\t\n   277\t  let options = new OptionsStore(input);\n   278\t  let accepted: Accepted | null = null;\n   279\t  const presentation = new Map<PresentationStage, readonly DiagnosticInput[]>();\n   280\t  /** Keys of the current diagnostics already printed and handed to `onDiagnostic`. */\n   281\t  let deliveredKeys = new Set<string>();\n   282\t  /** Increases with every delivery pass; a pass started inside author code supersedes the outer one. */\n   283\t  let destroyed = false;\n   284\t  let internalError: unknown = null;\n   285\t  /** `append` was called at least once: the pause control is offered (spec I6). */\n   286\t  let streaming = false;\n   287\t  let paused = false;\n   288\t  /** While paused: the store's newest frame and its findings, accepted but not shown. */\n   289\t  let held: { frame: Frame; dataDiagnostics: readonly DiagnosticInput[]; viewDiagnostics: readonly DiagnosticInput[] } | null = null;\n   290\t  /**\n   291\t   * The displayed snapshot's row ownership: what the marks on screen came from (see the invariants at the top\n   292\t   * of this file). `frozen` holds the caller's rows of that frame once the store had to let go of its revision.\n   293\t   */\n   294\t  let onScreen: { frame: Frame; store: Store | null; frozen: Map<number, unknown> | null } | null = null;\n   295\t  /** Frames a store produced (their rows live in that store's revisions). */\n   296\t  const storeFrames = new WeakSet<Frame>();\n   297\t  /** What the store held right after the last release with a frame on screen: the bound's baseline. */\n   298\t  let retainedBaseline = 0;\n   299\t  let epochs = 0;\n   300\t  let frameRevision = 0;\n   301\t  let commits = 0;\n   302\t  let listeners = new Map<keyof ChartEvents<unknown>, Set<(payload: never) => void>>();\n   303\t  /** True while a frame runs: findings are delivered at its end, not from inside a stage. */\n   304\t  let inFrame = false;\n   305\t\n   306\t  function chartName(o: OptionRecord): string {\n   307\t    return titleOf(o)?.text ?? (host.targetId || host.id);\n   308\t  }\n   309\t\n   310\t  /** Every presentation finding once: the same code and field found by two stages (ticks and readouts) is one. */\n   311\t  function presentationList(): DiagnosticInput[] {\n   312\t    const out: DiagnosticInput[] = [];\n   313\t    const seen = new Set<string>();\n   314\t    for (const list of presentation.values()) {\n   315\t      for (const d of list) {\n   316\t        const key = `${d.code}\\u0000${d.field ?? ''}`;\n   317\t        if (seen.has(key)) continue;\n   318\t        seen.add(key);\n   319\t        out.push(d);\n   320\t      }\n   321\t    }\n   322\t    return out;\n   323\t  }\n   324\t\n   325\t  function stateDiagnostics(a: Accepted): DiagnosticInput[] {\n   326\t    return [...a.optionDiagnostics, ...a.dataDiagnostics, ...a.viewDiagnostics, ...a.naming];\n   327\t  }\n   328\t\n   329\t  function currentDiagnostics(): Diagnostic[] {\n   330\t    // Before anything was accepted (a create that failed): what the failure raised (finding 14).\n   331\t    if (!accepted) return toPublic(presentationList(), chartName(options.current));\n   332\t    // While paused, `diagnostics` describes everything accepted, the held rows included (finding 6).\n   333\t    const a = held ? { ...accepted, dataDiagnostics: held.dataDiagnostics, viewDiagnostics: held.viewDiagnostics } : accepted;\n   334\t    return toPublic([...stateDiagnostics(a), ...presentationList()], accepted.name);\n   335\t  }\n   336\t\n   337\t  /** Replaces what a presentation stage found; outside a frame the change is delivered at once. */\n   338\t  function setPresentation(where: PresentationStage, list: readonly DiagnosticInput[]): void {\n   339\t    const before = presentation.get(where) ?? [];\n   340\t    if (before.length === 0 && list.length === 0) return;\n   341\t    if (before.length === list.length && before.every((d, i) => diagnosticKey(d) === diagnosticKey(list[i]!))) return;\n   342\t    if (list.length) presentation.set(where, list);\n   343\t    else presentation.delete(where);\n   344\t    if (!inFrame && !destroyed) {\n   345\t      deliverChanges();\n   346\t      // The reader's note may change with it (spec F12).\n   347\t      schedule();\n   348\t    }\n   349\t  }\n   350\t\n   351\t  function addPresentation(where: PresentationStage, d: DiagnosticInput): void {\n   352\t    const list = presentation.get(where) ?? [];\n   353\t    if (list.some(o => o.code === d.code && o.field === d.field)) return;\n   354\t    setPresentation(where, [...list, d]);\n   355\t  }\n   356\t\n   357\t  function formatterFailed(field: string): void {\n   358\t    addPresentation('format', createDiagnostic('AX160', 'changed', { field }, 'presentation'));\n   359\t  }\n   360\t\n   361\t  /**\n   362\t   * Notifications to author code (onDiagnostic, the console, event listeners) in call order: each delivery\n   363\t   * is a snapshot taken when it is made and is drained in full, and one made by author code during a drain\n   364\t   * waits behind it. Only destruction stops a drain (review 3, finding 7).\n   365\t   */\n   366\t  const notifications: (() => void)[] = [];\n   367\t  let draining = false;\n   368\t\n   369\t  function enqueue(work: () => void): void {\n   370\t    notifications.push(work);\n   371\t    if (draining) return;\n   372\t    draining = true;\n   373\t    try {\n   374\t      while (notifications.length && !destroyed) notifications.shift()!();\n   375\t    } finally {\n   376\t      draining = false;\n   377\t      if (destroyed) notifications.length = 0;\n   378\t    }\n   379\t  }\n   380\t\n   381\t  /**\n   382\t   * Prints and hands to `onDiagnostic` what is new. The set to deliver is fixed and marked delivered when the\n   383\t   * delivery is made, so a handler that updates the chart cannot be given a finding twice.\n   384\t   */\n   385\t  function deliverChanges(): void {\n   386\t    if (destroyed) return;\n   387\t    const now = currentDiagnostics();\n   388\t    const keys = new Set(now.map(diagnosticKey));\n   389\t    for (const k of [...deliveredKeys]) if (!keys.has(k)) deliveredKeys.delete(k);\n   390\t    const fresh = now.filter(d => !deliveredKeys.has(diagnosticKey(d)));\n   391\t    if (!fresh.length) return;\n   392\t    for (const d of fresh) deliveredKeys.add(diagnosticKey(d));\n   393\t    const handler = (accepted?.options ?? options.current).onDiagnostic;\n   394\t    enqueue(() => {\n   395\t      for (const d of fresh) {\n   396\t        if (destroyed) return;\n   397\t        delivery.print(d);\n   398\t        if (typeof handler === 'function') delivery.notify(handler as (d: Diagnostic) => void, d);\n   399\t      }\n   400\t    });\n   401\t  }\n   402\t\n   403\t  /** A rejected or ignored call's findings: printed and given to `onDiagnostic`, never part of `diagnostics`. */\n   404\t  function deliverRejected(found: readonly DiagnosticInput[], name: string, handler: unknown): void {\n   405\t    const list = toPublic(found, name).filter(d => !deliveredKeys.has(diagnosticKey(d)));\n   406\t    if (!list.length) return;\n   407\t    enqueue(() => {\n   408\t      for (const d of list) {\n   409\t        if (destroyed) return;\n   410\t        delivery.print(d);\n   411\t        if (typeof handler === 'function') delivery.notify(handler as (d: Diagnostic) => void, d);\n   412\t      }\n   413\t    });\n   414\t  }\n   415\t\n   416\t  interface Candidate {\n   417\t    readonly options: OptionRecord;\n   418\t    readonly resolved: ResolvedOptions;\n   419\t    readonly source: ResolvedOptions;\n   420\t    readonly store: Store | null;\n   421\t    readonly frame: Frame;\n   422\t    readonly dataDiagnostics: readonly DiagnosticInput[];\n   423\t    readonly dataOptions: readonly DiagnosticInput[];\n   424\t    readonly optionDiagnostics: readonly DiagnosticInput[];\n   425\t    readonly zoom: Span<XValue> | null;\n   426\t    readonly hidden: ReadonlySet<string>;\n   427\t    readonly messages: Messages;\n   428\t  }\n   429\t\n   430\t  interface Viewed {\n   431\t    readonly view: View;\n   432\t    readonly viewKey: readonly unknown[];\n   433\t    readonly viewDiagnostics: readonly DiagnosticInput[];\n   434\t    /** What this build found that the previous view did not have. */\n   435\t    readonly found: readonly DiagnosticInput[];\n   436\t  }\n   437\t\n   438\t  function viewFor(c: Candidate, previous: Accepted | null): Viewed {\n   439\t    // A window kept across a data change does not reach an axis it does not apply to.\n   440\t    const zoom = zoomable(c.frame) ? c.zoom : null;\n   441\t    const key = viewKeyFor(kind, c.options, c.resolved, c.frame, zoom, c.hidden, c.messages);\n   442\t    if (previous && sameValue(previous.viewKey, key)) {\n   443\t      return { view: previous.view, viewKey: previous.viewKey, viewDiagnostics: previous.viewDiagnostics, found: [] };\n   444\t    }\n   445\t    stage('view');\n   446\t    const sink = new DiagnosticCollector();\n   447\t    const state = viewStateFor(kind, c.options, c.resolved, zoom, previous?.view ?? null, c.hidden, c.messages);\n   448\t    const view = composition.view(c.frame, state, sink);\n   449\t    // A wall-clock window on a wall-clock axis is what the axis reads: the column's own AX112 already says\n   450\t    // the values have no offset, and the window is not news (documentation finding 2).\n   451\t    const found = sink.inputs().filter(d => !(d.code === 'AX112' && d.field === 'zoom' && isWall(c.frame)));\n   452\t    const before = previous?.viewDiagnostics ?? [];\n   453\t    const viewDiagnostics = completeViewDiagnostics(kind, found, before, view, state);\n   454\t    const known = new Set(before.map(diagnosticKey));\n   455\t    return { view, viewKey: key, viewDiagnostics, found: found.filter(d => !known.has(diagnosticKey(d))) };\n   456\t  }\n   457\t\n   458\t  function messagesFor(next: OptionRecord, previous: Accepted | null): Messages {\n   459\t    return previous && sameValue(previous.options.messages, next.messages) ? previous.messages : resolveMessages(object(next.messages));\n   460\t  }\n   461\t\n   462\t  /**\n   463\t   * Accepts a validated candidate: the store commits first (so the frame on screen and the store agree),\n   464\t   * then the options, then the state. Nothing before this changes the chart.\n   465\t   */\n   466\t  function accept(c: Candidate, viewed: Viewed, follow: boolean, commit: (() => void) | null): void {\n   467\t    commit?.();\n   468\t    if (commit && c.store && c.store.frame === c.frame) storeFrames.add(c.frame);\n   469\t    if (held && c.frame === held.frame) held = null;\n   470\t    options.commit(c.options);\n   471\t    frameRevision = Math.max(frameRevision, c.frame.revision);\n   472\t    accepted = {\n   473\t      options: c.options, resolved: c.resolved, source: c.source, store: c.store, frame: c.frame,\n   474\t      dataDiagnostics: c.dataDiagnostics, dataOptions: c.dataOptions, optionDiagnostics: c.optionDiagnostics,\n   475\t      viewDiagnostics: viewed.viewDiagnostics, naming: namingDiagnostics(c.options), view: viewed.view,\n   476\t      viewKey: viewed.viewKey, zoom: c.zoom, follow, revision: ++commits, messages: c.messages,\n   477\t      name: chartName(c.options), hidden: c.hidden,\n   478\t    };\n   479\t    if (internalError !== null) {\n   480\t      internalError = null;\n   481\t      setPresentationQuiet('internal', []);\n   482\t    }\n   483\t    release();\n   484\t    deliverChanges();\n   485\t    schedule();\n   486\t  }\n   487\t\n   488\t  function setPresentationQuiet(where: PresentationStage, list: readonly DiagnosticInput[]): void {\n   489\t    if (list.length) presentation.set(where, list);\n   490\t    else presentation.delete(where);\n   491\t  }\n   492\t\n   493\t  /** A strict chart rejects a create, update or append whose own findings include an error or warning. */\n   494\t  function rejectIfStrict(strict: boolean, found: readonly DiagnosticInput[], name: string, handler: unknown): void {\n   495\t    if (!strict || strictViolations(found).length === 0) return;\n   496\t    deliverRejected(found, name, handler);\n   497\t    throw new StrictError(name, toPublic(found, name));\n   498\t  }\n   499\t\n   500\t  /** Runs a call. A strict rejection propagates; anything else that throws becomes the internal-error state. */\n   501\t  function guarded(run: () => void): void {\n   502\t    if (destroyed) return;\n   503\t    try {\n   504\t      run();\n   505\t    } catch (error) {\n   506\t      if (error instanceof StrictError) throw error;\n   507\t      raiseInternal(error);\n   508\t      // A create that failed has nothing to draw from: show the error state now (never a blank box).\n   509\t      if (accepted === null) showInternal(resolveMessages(object(options.current.messages)), chartName(options.current), options.current);\n   510\t      schedule();\n   511\t    }\n   512\t  }\n   513\t\n   514\t  function nextVersion(): { epoch: number; revision: number } {\n   515\t    return { epoch: ++epochs, revision: ++frameRevision };\n   516\t  }\n   517\t\n   518\t  function update(patch: unknown): void {\n   519\t    guarded(() => {\n   520\t      stage('options');\n   521\t      const { next, changed } = options.preview(patch);\n   522\t      const previous = accepted;\n   523\t      const supplied = patch !== null && typeof patch === 'object' && Object.hasOwn(patch, 'data');\n   524\t      const optionSink = new DiagnosticCollector();\n   525\t      const messages = messagesFor(next, previous);\n   526\t      let c: Candidate;\n   527\t      let commit: (() => void) | null = null;\n   528\t      let heldAfter: typeof held = null;\n   529\t      const replace = previous === null || changed.has('data') || (supplied && previous.store !== null);\n   530\t      const reencode = !replace && encodingChanged(previous!.options, next);\n   531\t      if (!replace && reencode && previous!.store === null && namesOnlyChanged(previous!.options, next)) {\n   532\t        // Labels or units only, over the caller's own data: the same columns with new names (finding 12).\n   533\t        const resolved = resolveOptions(kind, publicOptions(next), optionSink, previous!.source.table);\n   534\t        const p = previous!;\n   535\t        const opts = optionSink.inputs().filter(d => !DATA_CODES.has(d.code));\n   536\t        c = {\n   537\t          options: next, resolved, source: resolved, store: null, frame: renamed(p.frame, resolved, frameRevision += 1),\n   538\t          dataDiagnostics: p.dataDiagnostics, dataOptions: p.dataOptions,\n   539\t          optionDiagnostics: dedupe([...p.dataOptions, ...opts], p.dataDiagnostics), zoom: p.zoom, hidden: p.hidden, messages,\n   540\t        };\n   541\t      } else if (replace || (reencode && previous!.store === null)) {\n   542\t        // New data, or new fields over the caller's own data: normalized from the options, b