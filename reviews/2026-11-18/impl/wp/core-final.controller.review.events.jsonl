internal);\n   106\t    expect(r.surfaces).toBe(false);\n   107\t    (r.host.text as { render: typeof render }).render = render;\n   108\t    r.controller.handle.update({ title: 'Back' });\n   109\t    r.frames();\n   110\t    expect(lastModel(r).message).toBeNull();\n   111\t    expect(r.surfaces).toBe(true);\n   112\t    expect(xsOf(r)).toEqual([5, 7]);\n   113\t  });\n   114\t\n   115\t  it('a mark renderer that always throws: the message still appears and the marks are hidden', () => {\n   116\t    const r = record('line', { title: 'T', data: rowsOf([0, 2]), x: 'x', y: 'y' });\n   117\t    r.frames();\n   118\t    (r.host.renderer as unknown as { draw: () => void }).draw = () => { throw new Error('marks broke'); };\n   119\t    r.controller.handle.update({ data: rowsOf([5, 7]) });\n   120\t    r.frames();\n   121\t    expect(lastModel(r).message).toBe(internal);\n   122\t    expect(r.surfaces).toBe(false);\n   123\t    expect(r.committed).toBeNull();\n   124\t  });\n   125\t});\n   126\t\n   127\tdescribe('controller blocker 4: keep bounds a stream whether or not frames run', () => {\n   128\t  it('1,000 appends with keep 3 and the first frame never run hold at most 3 rows', () => {\n   129\t    const r = record('line', { title: 'K', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   130\t    for (let i = 3; i < 1003; i++) r.controller.handle.append([{ x: i, y: i }], { keep: 3 });\n   131\t    expect(r.controller.handle.__dev!.retainedRows()).toBeLessThanOrEqual(3);\n   132\t  });\n   133\t\n   134\t  it('100 appends with keep 2 and every frame failing hold at most 2 rows', () => {\n   135\t    const r = record('line', { title: 'K', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n   136\t    r.controller.handle.__dev!.fail('reader');\n   137\t    for (let i = 2; i < 102; i++) {\n   138\t      r.controller.handle.append([{ x: i, y: i }], { keep: 2 });\n   139\t      r.frames();\n   140\t    }\n   141\t    expect(r.controller.handle.__dev!.retainedRows()).toBeLessThanOrEqual(2);\n   142\t  });\n   143\t\n   144\t  it('a frame with no size clears the marks before the rows behind them go', () => {\n   145\t    const r = record('line', { title: 'Z', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n   146\t    r.frames();\n   147\t    r.container = null;\n   148\t    r.controller.handle.append(rowsOf([2]), { keep: 1 });\n   149\t    r.controller.invalidate.resize();\n   150\t    r.frames();\n   151\t    expect(r.draws.at(-1)!.marks).toEqual([]);\n   152\t  });\n   153\t});\n   154\t\n   155\tdescribe('controller finding 5: re-encoding while paused, and a failed Resume', () => {\n   156\t  it('a failed Resume keeps the held rows; the next valid call after the cause is gone shows them', () => {\n   157\t    const r = record('line', { title: 'P', data: rowsOf([1, 2, 3]), x: 'x', y: 'y' });\n   158\t    r.frames();\n   159\t    r.controller.handle.append(rowsOf([4]));\n   160\t    r.frames();\n   161\t    r.controller.actions.pause(true);\n   162\t    r.controller.handle.append(rowsOf([5]));\n   163\t    r.controller.handle.__dev!.fail('view');\n   164\t    r.controller.actions.pause(false);\n   165\t    r.frames();\n   166\t    r.controller.handle.__dev!.fail(null);\n   167\t    r.controller.handle.update({ title: 'Again' });\n   168\t    r.frames();\n   169\t    expect(xsOf(r)).toEqual([1, 2, 3, 4, 5]);\n   170\t  });\n   171\t});\n   172\t\n   173\tdescribe('controller finding 6: append validation writes to the right state', () => {\n   174\t  it('a first strict append with NaN throws and turns nothing on', () => {\n   175\t    const r = record('line', { title: 'S', strict: true, data: rowsOf([1, 2]), x: 'x', y: 'y' });\n   176\t    r.frames();\n   177\t    expect(() => r.controller.handle.append([{ x: 3, y: NaN }])).toThrow(/AX103/);\n   178\t    expect(r.pending).toBe(0);\n   179\t    r.frames();\n   180\t    expect(r.prepared.at(-1)!.streaming).toBe(false);\n   181\t  });\n   182\t\n   183\t  it('a ninth series appended while paused is in diagnostics at once', () => {\n   184\t    const series = Array.from({ length: 8 }, (_, i) => `S${i}`);\n   185\t    const r = record('line', { title: 'N', data: series.map(s => ({ x: 1, s, y: 1 })), x: 'x', y: 'y', series: 's' });\n   186\t    r.frames();\n   187\t    r.controller.handle.append([{ x: 2, s: 'S0', y: 1 }]);\n   188\t    r.controller.actions.pause(true);\n   189\t    r.controller.handle.append([{ x: 3, s: 'S8', y: 1 }]);\n   190\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX130');\n   191\t  });\n   192\t\n   193\t  it('a negative donut value held while paused does not put the displayed ring into its error state', () => {\n   194\t    const r = record('donut', { title: 'D', data: [{ l: 'a', v: 1 }, { l: 'b', v: 2 }], label: 'l', value: 'v' });\n   195\t    r.frames();\n   196\t    r.controller.handle.append([{ l: 'c', v: 3 }]);\n   197\t    r.frames();\n   198\t    r.controller.actions.pause(true);\n   199\t    r.controller.handle.append([{ l: 'd', v: -1 }]);\n   200\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX120');\n   201\t    r.controller.invalidate.resize();\n   202\t    r.frames();\n   203\t    expect(lastModel(r).message).toBeNull();\n   204\t  });\n   205\t});\n   206\t\n   207\tdescribe('controller finding 7: re-entrant calls do not drop deliveries', () => {\n   208\t  it('a strict rejection delivers every finding even when the first handler updates the chart', () => {\n   209\t    const seen: string[] = [];\n   210\t    const r = record('line', { title: 'S', strict: true, data: rowsOf([1, 2]), x: 'x', y: 'y' });\n   211\t    const chart = r.controller.handle;\n   212\t    chart.update({ onDiagnostic: (d: Diagnostic) => { seen.push(d.code); if (seen.length === 1) chart.update({ title: 'Nested' }); } });\n   213\t    expect(() => chart.update({ data: [{ x: 1, y: NaN }, { x: 2, y: 'n' }] })).toThrow();\n   214\t    expect(seen.sort()).toEqual(['AX103', 'AX106']);\n   215\t  });\n   216\t\n   217\t  it('every zoom subscriber gets every zoom, in order, when the first one zooms again', () => {\n   218\t    const r = record('line', { title: 'Z', data: rowsOf([0, 1, 2, 3]), x: 'x', y: 'y' });\n   219\t    r.frames();\n   220\t    const first: unknown[] = [];\n   221\t    const second: unknown[] = [];\n   222\t    r.controller.handle.on('zoom', w => { first.push(w); if (first.length === 1) r.controller.handle.zoom([1, 2]); });\n   223\t    r.controller.handle.on('zoom', w => { second.push(w); });\n   224\t    r.controller.handle.zoom([0.5, 2]);\n   225\t    expect(second).toEqual([[0.5, 2], [1, 2]]);\n   226\t  });\n   227\t});\n   228\t\n   229\tdescribe('controller finding 9: an unsubscribe kept after destroy holds nothing of others', () => {\n   230\t  it('a kept unsubscribe function does not retain the other subscribers', () => {\n   231\t    const r = record('line', { title: 'U', data: rowsOf([0, 1]), x: 'x', y: 'y' });\n   232\t    const off = r.controller.handle.on('hover', () => {});\n   233\t    const other = () => {};\n   234\t    r.controller.handle.on('hover', other);\n   235\t    r.controller.handle.destroy();\n   236\t    // The closure resolves its set through the chart's (now emptied) map: nothing to reach `other` through.\n   237\t    expect(off.toString()).not.toMatch(/own\\b/);\n   238\t    off();\n   239\t  });\n   240\t});\n   241\t\n   242\tdescribe('controller finding 14: a create-stage exception is AX199, delivered, and validate agrees', () => {\n   243\t  it('an x getter that throws during normalization reaches onDiagnostic as AX199', () => {\n   244\t    const seen: string[] = [];\n   245\t    const row = { get x(): number { throw new Error('getter'); }, y: 1 };\n   246\t    const r = record('line', { title: 'E', data: [row], x: 'x', y: 'y', onDiagnostic: (d: Diagnostic) => seen.push(d.code) });\n   247\t    expect(seen).toContain('AX199');\n   248\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX199');\n   249\t  });\n   250\t});\n   251\t\n   252\tdescribe('controller finding 15: scatter keeps the declared percent and ratio scale in its domain (F7)', () => {\n   253\t  it('values 20 and 63 declared percent end at 100; 0.2 and 0.63 declared ratio end at 1', () => {\n   254\t    const p = record('scatter', { title: 'P', data: [{ x: 1, y: 20 }, { x: 2, y: 63 }], x: 'x', y: { field: 'y', scale: 'percent' } });\n   255\t    p.frames();\n   256\t    expect(p.committed!.view.kind === 'scatter' && p.committed!.view.yDomain[1]).toBe(100);\n   257\t    const q = record('scatter', { title: 'Q', data: [{ x: 1, y: 0.2 }, { x: 2, y: 0.63 }], x: 'x', y: { field: 'y', scale: 'ratio' } });\n   258\t    q.frames();\n   259\t    expect(q.committed!.view.kind === 'scatter' && q.committed!.view.yDomain[1]).toBe(1);\n   260\t  });\n   261\t});\n   262\t\n   263\tdescribe('controller finding 16: a window at the latest datum follows, for scatter and continuous bars', () => {\n   264\t  it('scatter [0, 9] zoomed to [5, 9]: appending 12 moves the window to end at 12', () => {\n   265\t    const r = record('scatter', { title: 'S', data: [{ x: 0, y: 0 }, { x: 9, y: 1 }], x: 'x', y: 'y' });\n   266\t    r.controller.handle.zoom([5, 9]);\n   267\t    r.controller.handle.append([{ x: 12, y: 2 }]);\n   268\t    r.frames();\n   269\t    expect(r.controller.handle.__bench!.describe().xDomain![1]).toBe(12);\n   270\t  });\n   271\t\n   272\t  it('bars 0, 5, 10 zoomed to [5, 10]: appending 15 follows', () => {\n   273\t    const r = record('bar', { title: 'B', data: [0, 5, 10].map(x => ({ x, y: 1 })), x: 'x', y: 'y' });\n   274\t    r.controller.handle.zoom([5, 10]);\n   275\t    r.controller.handle.append([{ x: 15, y: 1 }]);\n   276\t    r.frames();\n   277\t    const d = r.controller.handle.__bench!.describe().xDomain!;\n   278\t    expect(d[0]).toBeGreaterThan(5);\n   279\t  });\n   280\t});\n   281\t\n   282\tdescribe('controller finding 18: an all-missing bar window draws its missing marks (F2)', () => {\n   283\t  it('A: null, B: null shows the missing glyphs, not \"No data to show\"', () => {\n   284\t    const r = record('bar', { title: 'M', data: [{ x: 'A', y: null }, { x: 'B', y: null }], x: 'x', y: 'y' });\n   285\t    r.frames();\n   286\t    expect(lastModel(r).message).toBeNull();\n   287\t    expect(r.draws.at(-1)!.marks.some(m => m.type === 'rects' && m.variant === 'missing')).toBe(true);\n   288\t  });\n   289\t});\n   290\t\n   291\tdescribe('invariants over random call sequences', () => {\n   292\t  type Op =\n   293\t    | { op: 'append'; n: number; keep: number } | { op: 'title' } | { op: 'data' } | { op: 'pause' } | { op: 'resume' }\n   294\t    | { op: 'zoom' } | { op: 'frame' } | { op: 'fail' } | { op: 'heal' };\n   295\t  const ops = fc.oneof(\n   296\t    fc.record({ op: fc.constant('append' as const), n: fc.integer({ min: 1, max: 3 }), keep: fc.integer({ min: 1, max: 5 }) }),\n   297\t    ...(['title', 'data', 'pause', 'resume', 'zoom', 'frame', 'frame', 'fail', 'heal'] as const).map(op => fc.constant({ op })),\n   298\t  ) as fc.Arbitrary<Op>;\n   299\t\n   300\t  it('marks, lookup and figure agree on one revision; rows on screen keep their provenance; retention stays bounded', () => {\n   301\t    fc.assert(fc.property(fc.array(ops, { maxLength: 40 }), sequence => {\n   302\t      const rows = new Map<number, unknown>();\n   303\t      const add = (xs: number[]) => xs.map(x => { const row = { x, y: x % 7 }; rows.set(x, row); return row; });\n   304\t      const r = record('line', { title: 'Inv', data: add([0, 1, 2]), x: 'x', y: 'y' });\n   305\t      let next = 3;\n   306\t      let lastKeep = Infinity;\n   307\t      for (const step of sequence) {\n   308\t        switch (step.op) {\n   309\t          case 'append': r.controller.handle.append(add(Array.from({ length: step.n }, () => next++)), { keep: step.keep }); lastKeep = step.keep; break;\n   310\t          case 'title': r.controller.handle.update({ title: `T${next}` }); break;\n   311\t          case 'data': r.controller.handle.update({ data: add([next, next + 1]) }); next += 2; lastKeep = Infinity; break;\n   312\t          case 'pause': r.controller.actions.pause(true); break;\n   313\t          case 'resume': r.controller.actions.pause(false); break;\n   314\t          case 'zoom': r.controller.handle.zoom(null); break;\n   315\t          case 'frame': r.frames(); break;\n   316\t          case 'fail': r.controller.handle.__dev!.fail('reader'); r.controller.handle.update({ subtitle: `s${next}` }); r.frames(); break;\n   317\t          case 'heal': r.controller.handle.__dev!.fail(null); break;\n   318\t        }\n   319\t        const committed = r.committed;\n   320\t        const d = r.controller.handle.__bench!.describe();\n   321\t        if (committed) {\n   322\t          // The lookup the pointer reads and the view behind the marks are the same revision.\n   323\t          const view = committed.view as AlignedView;\n   324\t          expect(d.series[0]?.newestX).toBe(view.frame.x.values[view.frame.length - 1]);\n   325\t          // Every x on screen answers a hover with the caller's own row object.\n   326\t          for (const x of view.frame.x.values) {\n   327\t            const i = Array.prototype.indexOf.call(view.frame.x.values, x);\n   328\t            if (view.frame.series[0]!.slot[i] !== 0) continue;\n   329\t            expect(hoverRow(r, x)).toBe(rows.get(x));\n   330\t          }\n   331\t          // The figure's caption belongs to the same accepted call as the marks (no frame mixed two).\n   332\t          expect(r.prepared.at(-1)!.view).toBe(committed.view);\n   333\t        }\n   334\t        if (Number.isFinite(lastKeep)) {\n   335\t          const shownRows = committed ? (committed.view as AlignedView).frame.length : 0;\n   336\t          expect(r.controller.handle.__dev!.retainedRows()).toBeLessThanOrEqual(lastKeep + shownRows + 5 + 64);\n   337\t        }\n   338\t      }\n   339\t    }), { numRuns: 300 });\n   340\t  });\n   341\t});\n   342\t\n   343\tdescribe('controller finding 19: environment changes are read again, and one draw per animation frame', () => {\n   344\t  it('a pixel ratio changed while detached is read on reattachment', () => {\n   345\t    const r = record('line', { title: 'D', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   346\t    r.frames();\n   347\t    (r.host as { devicePixelRatio: () => number }).devicePixelRatio = () => 3;\n   348\t    r.controller.invalidate.page();\n   349\t    r.frames();\n   350\t    expect(r.committed!.pixelRatio).toBe(3);\n   351\t  });\n   352\t\n   353\t  it('a data update and a theme change in the same animation frame draw once', () => {\n   354\t    const r = record('line', { title: 'T', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   355\t    r.frames();\n   356\t    const before = r.draws.length;\n   357\t    r.controller.handle.update({ data: rowsOf([0, 1, 3]) });\n   358\t    // The theme watcher's own frame callback, in the same batch as the chart's.\n   359\t    r.host.requestFrame(() => r.controller.invalidate.theme());\n   360\t    r.frames(1);\n   361\t    expect(r.draws.length - before).toBe(1);\n   362\t    r.frames();\n   363\t    expect(r.draws.length - before).toBeLessThanOrEqual(2);\n   364\t  });\n   365\t});\n   366\t\n   367\tdescribe('scatter follow counts observations with no y (PointSeries.missingX)', () => {\n   368\t  it('a window ending at an omission at the latest x follows the next append', () => {\n   369\t    const r = record('scatter', { title: 'M', data: [{ x: 0, y: 0 }, { x: 9, y: 1 }, { x: 12, y: null }], x: 'x', y: 'y' });\n   370\t    r.frames();\n   371\t    r.controller.handle.zoom([6, 12]);\n   372\t    r.controller.handle.append([{ x: 15, y: 2 }]);\n   373\t    r.frames();\n   374\t    expect(r.controller.handle.__bench!.describe().xDomain![1]).toBe(15);\n   375\t  });\n   376\t});\n   377\t\n   378\tdescribe('pass 4: controller findings 5 and 8', () => {\n   379\t  it('re-encoding while paused shows the rows on screen with the new field and keeps the arrivals held', () => {\n   380\t    const data = [1, 2, 3].map(x => ({ x, a: x, b: -x }));\n   381\t    const r = record('line', { title: 'P', data, x: 'x', y: 'a' });\n   382\t    r.frames();\n   383\t    r.controller.handle.append([{ x: 4, a: 4, b: -4 }], { keep: 3 });\n   384\t    r.frames();\n   385\t    expect(xsOf(r)).toEqual([2, 3, 4]);\n   386\t    r.controller.actions.pause(true);\n   387\t    r.controller.handle.append([{ x: 5, a: 5, b: -5 }], { keep: 3 });\n   388\t    r.controller.handle.update({ y: 'b' });\n   389\t    r.frames();\n   390\t    const view = r.committed!.view as AlignedView;\n   391\t    expect(Array.from(view.frame.x.values)).toEqual([2, 3, 4]);\n   392\t    expect(Array.from(view.frame.series[0]!.y)).toEqual([-2, -3, -4]);\n   393\t    expect(hoverRow(r, 2, 'b')).toMatchObject({ x: 2, b: -2 });\n   394\t    r.controller.actions.pause(false);\n   395\t    r.frames();\n   396\t    const after = r.committed!.view as AlignedView;\n   397\t    expect(Array.from(after.frame.x.values)).toEqual([3, 4, 5]);\n   398\t    expect(Array.from(after.frame.series[0]!.y)).toEqual([-3, -4, -5]);\n   399\t  });\n   400\t\n   401\t  for (const kind of ['line', 'area', 'bar', 'scatter', 'donut'] as const) {\n   402\t    it(`${kind}: a valid append clears a stale AX101 and draws`, () => {\n   403\t      const enc = kind === 'donut' ? { label: 'x', value: 'v' } : { x: 'x', y: 'v' };\n   404\t      const r = record(kind, { title: 'F', data: [{ x: kind === 'donut' ? 'a' : 1 }], ...enc });\n   405\t      r.frames();\n   406\t      expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX101');\n   407\t      r.controller.handle.append([{ x: kind === 'donut' ? 'b' : 2, v: 5 }], { keep: 1 });\n   408\t      r.frames();\n   409\t      expect(r.controller.handle.diagnostics.map(d => d.code)).not.toContain('AX101');\n   410\t      expect(lastModel(r).message).toBeNull();\n   411\t    });\n   412\t  }\n   413\t});\n   414\t\n   415\tdescribe('pass 4: controller finding 12, resubmitted options', () => {\n   416\t  it('an edited reference, color, message and label passed back in the same objects take effect', () => {\n   417\t    const reference = [{ y: 5, label: 'Goal' }];\n   418\t    const colors: Record<string, string> = { y: 'red' };\n   419\t    const messages: Record<string, string> = { empty: 'Nothing' };\n   420\t    const y = { field: 'y', label: 'Before' };\n   421\t    const r = record('line', { title: 'M', data: rowsOf([0, 1]), x: 'x', y, reference, colors, messages });\n   422\t    r.frames();\n   423\t    reference[0]!.y = 7;\n   424\t    colors.y = 'blue';\n   425\t    messages.empty = 'Nichts';\n   426\t    y.label = 'After';\n   427\t    r.controller.handle.update({ reference, colors, messages, y });\n   428\t    r.frames();\n   429\t    const view = r.committed!.view as AlignedView;\n   430\t    expect(view.references[0]!.from).toBe(7);\n   431\t    expect(r.themeCalls.at(-1)!.colors).toEqual({ y: 'blue' });\n   432\t    expect(r.committed!.messages.empty).toBe('Nichts');\n   433\t    expect(view.frame.yLabel).toBe('After');\n   434\t  });\n   435\t\n   436\t  it('a label-only or unit-only change over static data does not renormalize', () => {\n   437\t    const r = record('line', { title: 'L', data: rowsOf([0, 1, 2]), x: 'x', y: { field: 'y', label: 'A' } });\n   438\t    r.frames();\n   439\t    const before = r.controller.handle.__dev!.stages().normalize;\n   440\t    r.controller.handle.update({ y: { field: 'y', label: 'B', unit: 'ms' } });\n   441\t    r.frames();\n   442\t    expect(r.controller.handle.__dev!.stages().normalize).toBe(before);\n   443\t    const view = r.committed!.view as AlignedView;\n   444\t    expect([view.frame.yLabel, view.frame.series[0]!.unit, view.frame.series[0]!.label]).toEqual(['B', 'ms', 'B']);\n   445\t  });\n   446\t});\n   447\t\n   448\tdescribe('pass 4: controller finding 13, AX160 follows its formatter', () => {\n   449\t  const throwing = () => { throw new Error('fmt'); };\n   450\t  it('a readout formatter that always throws keeps AX160 when the data is replaced', () => {\n   451\t    const r = record('line', { title: 'F', data: rowsOf([1, 2]), x: 'x', y: { field: 'y', format: throwing } });\n   452\t    r.frames();\n   453\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX160');\n   454\t    r.controller.handle.update({ data: rowsOf([3, 4]) });\n   455\t    r.frames();\n   456\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX160');\n   457\t    expect(lastModel(r).note).toMatch(/shown differently/);\n   458\t  });\n   459\t\n   460\t  it('an invalid Intl option combination reports AX160 when the formatters are built', () => {\n   461\t    // style 'currency' without a currency is a TypeError from Intl.NumberFormat.\n   462\t    const r = record('line', { title: 'F', data: rowsOf([1, 2]), x: 'x', y: { field: 'y', format: { style: 'currency' } } });\n   463\t    r.frames();\n   464\t    expect(r.controller.handle.diagnostics.filter(d => d.code === 'AX160').map(d => d.field)).toEqual(['y']);\n   465\t  });\n   466\t\n   467\t  it('one function for ticks and readouts gives one AX160', () => {\n   468\t    const r = record('line', { title: 'F', data: rowsOf([1, 2]), x: 'x', y: { field: 'y', format: throwing, tickFormat: throwing } });\n   469\t    r.frames();\n   470\t    expect(r.controller.handle.diagnostics.filter(d => d.code === 'AX160').length).toBe(1);\n   471\t  });\n   472\t\n   473\t  it('removing the formatters while the chart shows an error state retires AX160 and the note', () => {\n   474\t    const r = record('line', { title: 'F', data: rowsOf([1, 2]), x: 'x', y: { field: 'y', tickFormat: throwing } });\n   475\t    r.frames();\n   476\t    r.controller.handle.update({ y: 'y', state: { error: 'Down' } });\n   477\t    r.frames();\n   478\t    expect(r.controller.handle.diagnostics.map(d => d.code)).not.toContain('AX160');\n   479\t  });\n   480\t});\n   481\t\n   482\tdescribe('pass 4: controller finding 11, a title update is cheap', () => {\n   483\t  it('a title update on a stream does not walk the retained rows', async () => {\n   484\t    const { StreamRows } = await import('../../src/data/store-rows');\n   485\t    const many = Array.from({ length: 5000 }, (_, i) => ({ x: i, y: i }));\n   486\t    const r = record('line', { title: 'Before', data: many, x: 'x', y: 'y' });\n   487\t    r.frames();\n   488\t    r.controller.handle.append([{ x: 5000, y: 1 }]);\n   489\t    r.frames();\n   490\t    const table = vi.spyOn(StreamRows.prototype, 'table');\n   491\t    try {\n   492\t      r.controller.handle.update({ title: 'After' });\n   493\t      r.frames();\n   494\t      expect(table).not.toHaveBeenCalled();\n   495\t    } finally {\n   496\t      table.mockRestore();\n   497\t    }\n   498\t    expect(lastModel(r).title?.text).toBe('After');\n   499\t  });\n   500\t\n   501\t  it('a title update does not compute the summary statistics again', () => {\n   502\t    let calls = 0;\n   503\t    const format = (v: number) => { calls += 1; return String(v); };\n   504\t    const r = record('line', { title: 'Before', data: rowsOf([1, 2, 3]), x: 'x', y: { field: 'y', format } });\n   505\t    r.frames();\n   506\t    const summary = lastModel(r).summary;\n   507\t    calls = 0;\n   508\t    r.controller.handle.update({ title: 'After' });\n   509\t    r.frames();\n   510\t    // The summary's minimum, maximum and last value go through the readout formatter: nothing formatted again.\n   511\t    expect(calls).toBe(0);\n   512\t    expect(lastModel(r).summary).toBe(summary);\n   513\t    expect(lastModel(r).title?.text).toBe('After');\n   514\t  });\n   515\t});\n   516\t\n   517\tdescribe('pass 4: controller finding 17, zoom does not apply to a category axis in 1.0', () => {\n   518\t  const data = ['A', 'B', 'C', 'D'].map((x, i) => ({ x, y: i + 1 }));\n   519\t  for (const kind of ['line', 'area', 'bar'] as const) {\n   520\t    it(`${kind}: zoom(['B', 'C']) is a no-op reported as AX150; marks, ticks, lookup and controls unchanged`, () => {\n   521\t      const seen: Diagnostic[] = [];\n   522\t      const r = record(kind, { title: 'Z', data, x: 'x', y: 'y', onDiagnostic: (d: Diagnostic) => seen.push(d) },\n   523\t        { container: { width: 600, height: 300 } });\n   524\t      r.frames();\n   525\t      const before = { layout: r.layout, lookup: r.committed!.lookup, view: r.committed!.view, draws: r.draws.length };\n   526\t      expect(r.prepared.at(-1)!.zoom).toBe(false);\n   527\t      let zoomed = 0;\n   528\t      r.controller.handle.on('zoom', () => { zoomed += 1; });\n   529\t      r.controller.handle.zoom(['B', 'C']);\n   530\t      r.frames();\n   531\t      expect(seen.map(d => [d.code, d.field])).toEqual([['AX150', 'zoom']]);\n   532\t      expect(zoomed).toBe(0);\n   533\t      const c = r.committed!;\n   534\t      expect(c.view).toBe(before.view);\n   535\t      expect(c.lookup).toBe(before.lookup);\n   536\t      expect(c.zoomed).toBe(false);\n   537\t      expect(r.prepared.at(-1)!.zoom).toBe(false);\n   538\t      expect(r.draws.length).toBe(before.draws);\n   539\t      if (r.layout?.kind !== 'plot') throw new Error('expected a plot');\n   540\t      expect(r.layout.xTicks.map(t => t.label)).toEqual(['A', 'B', 'C', 'D']);\n   541\t      expect(r.layout).toBe(before.layout);\n   542\t    });\n   543\t  }\n   544\t\n   545\t  it('donut: the same AX150 for a zoom request', () => {\n   546\t    const seen: Diagnostic[] = [];\n   547\t    const r = record('donut', { title: 'Z', data: [{ l: 'A', v: 1 }, { l: 'B', v: 2 }], label: 'l', value: 'v', onDiagnostic: (d: Diagnostic) => seen.push(d) });\n   548\t    r.frames();\n   549\t    r.controller.handle.zoom(['A', 'B']);\n   550\t    r.controller.handle.zoom(null);\n   551\t    expect(seen.map(d => [d.code, d.field])).toEqual([['AX150', 'zoom']]);\n   552\t  });\n   553\t\n   554\t  it('a window kept from a numeric axis does not narrow the categories that replace it', () => {\n   555\t    const r = record('line', { title: 'Z', data: rowsOf([0, 1, 2, 3, 4]), x: 'x', y: 'y' }, { container: { width: 600, height: 300 } });\n   556\t    r.frames();\n   557\t    r.controller.handle.zoom([1, 3]);\n   558\t    r.frames();\n   559\t    r.controller.handle.update({ data });\n   560\t    r.frames();\n   561\t    const view = r.committed!.view as AlignedView;\n   562\t    expect(view.visibleSlots).toEqual({ start: 0, end: 4 });\n   563\t    if (r.layout?.kind !== 'plot') throw new Error('expected a plot');\n   564\t    expect(r.layout.xTicks.map(t => t.label)).toEqual(['A', 'B', 'C', 'D']);\n   565\t  });\n   566\t});\n   567\t\n   568\t\n   569\tdescribe('pass 4: documentation findings 1 and 3, the state the figure shows', () => {\n   570\t  it('AX108 on the only series is not an empty chart: the figure says the series could not be drawn', () => {\n   571\t    const r = record('line', { title: 'Dup', data: [{ x: 1, y: 1 }, { x: 1, y: 2 }, { x: 2, y: 3 }], x: 'x', y: 'y' });\n   572\t    r.frames();\n   573\t    expect(r.controller.handle.diagnostics.map(d => d.code)).toContain('AX108');\n   574\t    const model = lastModel(r);\n   575\t    expect(model.message).not.toBe(defaultMessages.empty);\n   576\t    expect(model.message).toMatch(/could not be drawn/);\n   577\t    expect(model.summary).not.toContain(defaultMessages.empty);\n   578\t  });\n   579\t\n   580\t  it('loading is not empty: the summary says the chart is loading', () => {\n   581\t    const r = record('line', { title: 'Wait', data: [], x: 'x', y: 'y', state: 'loading' });\n   582\t    r.frames();\n   583\t    const model = lastModel(r);\n   584\t    expect(model.message).toBe(defaultMessages.loading);\n   585\t    expect(model.summary).toBe(defaultMessages.loading);\n   586\t    expect(model.summary).not.toContain(defaultMessages.empty);\n   587\t  });\n   588\t\n   589\t  it('an error state does not describe data it does not show', () => {\n   590\t    const r = record('line', { title: 'E', data: rowsOf([1, 2]), x: 'x', y: 'y', state: { error: 'Feed down.' } });\n   591\t    r.frames();\n   592\t    expect(lastModel(r).summary).toBe('Feed down.');\n   593\t  });\n   594\t});\n   595\t\n   596\tdescribe('pass 4: documentation finding 2, the zoom event gives back what zoom() reads', () => {\n   597\t  const cases = [\n   598\t    { axis: 'time', xs: ['2026-01-01T00:00Z', '2026-01-02T00:00Z', '2026-01-03T00:00Z', '2026-01-04T00:00Z'].map(s => new Date(s)) },\n   599\t    { axis: 'date', xs: ['2026-01-01', '2026-01-02', '2026-01-03', '2026-01-04'] },\n   600\t    { axis: 'wall', xs: ['2026-01-01T00:00', '2026-01-02T00:00', '2026-01-03T00:00', '2026-01-04T00:00'] },\n   601\t    { axis: 'number', xs: [1, 2, 3, 4] },\n   602\t  ];\n   603\t  for (const { axis, xs } of cases) {\n   604\t    it(`${axis}: the event's window and Point.x are in the author's form and can be passed to another chart`, () => {\n   605\t      const data = xs.map((x, i) => ({ x, y: i }));\n   606\t      const rejected: string[] = [];\n   607\t      const make = () => record('line', { title: 'T', data, x: 'x', y: 'y', onDiagnostic: (d: Diagnostic) => { if (d.field === 'zoom') rejected.push(d.code); } });\n   608\t      const a = make();\n   609\t      a.frames();\n   610\t      let window: unknown = undefined;\n   611\t      a.controller.handle.on('zoom', p => { window = p; });\n   612\t      a.controller.handle.zoom([xs[1]!, xs[2]!]);\n   613\t      expect(window).toEqual([xs[1], xs[2]]);\n   614\t      let point: unknown;\n   615\t      a.controller.handle.on('hover', p => { point = p?.x; });\n   616\t      const view = a.committed!.view as AlignedView;\n   617\t      a.controller.actions.hover({ kind: 'aligned', seriesKey: 'y', x: view.frame.x.values[1]! });\n   618\t      expect(point).toEqual(xs[1]);\n   619\t      // Straight into another chart's zoom().\n   620\t      const b = make();\n   621\t      b.frames();\n   622\t      let again: unknown = undefined;\n   623\t      b.controller.handle.on('zoom', p => { again = p; });\n   624\t      b.controller.handle.zoom(window as never);\n   625\t      expect(again).toEqual(window);\n   626\t      expect(rejected).toEqual([]);\n   627\t    });\n   628\t  }\n   629\t});\n   630\t\n   631\tdescribe('pass 4: reader review finding 5, the sentences the controller shows', () => {\n   632\t  const dup = [{ x: 1, y: 1 }, { x: 1, y: 2 }, { x: 2, y: 3 }];\n   633\t  it('a series that could not be drawn points to the table the chart offers, as the summary does', () => {\n   634\t    const r = record('line', { title: 'Dup', data: dup, x: 'x', y: 'y' });\n   635\t    r.frames();\n   636\t    expect(lastModel(r).message).toBe(`y could not be drawn. ${defaultMessages.seeTable}`);\n   637\t    expect(r.prepared.at(-1)!.inspectable).toBe(true);\n   638\t  });\n   639\t\n   640\t  it(\"an override with the placeholder gets it filled; one without it is used as written\", () => {\n   641\t    const a = record('line', { title: 'Dup', data: dup, x: 'x', y: 'y', messages: { seriesNotDrawn: '{series} ({seeTable})!' } });\n   642\t    a.frames();\n   643\t    expect(lastModel(a).message).toBe(`y (${defaultMessages.seeTable})!`);\n   644\t    const b = record('line', { title: 'Dup', data: dup, x: 'x', y: 'y', messages: { seriesNotDrawn: 'Not drawn: {series} ' } });\n   645\t    b.frames();\n   646\t    expect(lastModel(b).message).toBe('Not drawn: y ');\n   647\t  });\n   648\t\n   649\t  it('on a German page the note is tagged English only when all of it is built-in, \"See table.\" included', () => {\n   650\t    const data = [{ x: 1, y: 1 }, { x: 2, y: NaN }, { x: 3, y: 3 }];\n   651\t    const built = record('line', { title: 'N', data, x: 'x', y: 'y' }, { pageLang: 'de' });\n   652\t    built.frames();\n   653\t    expect(lastModel(built).note).toMatch(/See table/);\n   654\t    expect(lastModel(built).noteLang).toBe('en');\n   655\t    const mixed = record('line', { title: 'N', data, x: 'x', y: 'y', messages: { seeTable: 'Siehe Tabelle.' } }, { pageLang: 'de' });\n   656\t    mixed.frames();\n   657\t    expect(lastModel(mixed).note).toMatch(/Siehe Tabelle/);\n   658\t    expect(lastModel(mixed).noteLang).toBeNull();\n   659\t    // Per run (the reader's runs): the built-in sentence in English, the author's \"See table.\" in the page's.\n   660\t    const runs = lastModel(mixed).noteSegments!;\n   661\t    expect(runs.map(r => r.text).join('')).toBe(lastModel(mixed).note);\n   662\t    expect(runs.at(-1)).toEqual({ text: 'Siehe Tabelle.', lang: null });\n   663\t    expect(runs.some(r => r.lang === 'en' && /not shown/.test(r.text))).toBe(true);\n   664\t    // And the other way round: only the sentence overridden, the built-in \"See table.\" is marked English.\n   665\t    const other = record('line', { title: 'N', data, x: 'x', y: 'y', messages: { valuesNotShown: '{count} Werte fehlen. {seeTable}' } }, { pageLang: 'de' });\n   666\t    other.frames();\n   667\t    const back = lastModel(other).noteSegments!;\n   668\t    expect(back.at(-1)).toEqual({ text: 'See table.', lang: 'en' });\n   669\t    expect(back[0]!.lang).toBeNull();\n   670\t  });\n   671\t});\n   672\t\n   673\tdescribe('pass 5: AX143 says which chart it is, so only vertical category bars get the horizontal-bar hint', () => {\n   674\t  const many = Array.from({ length: 40 }, (_, i) => ({ x: `A long category label ${i}`, y: i }));\n   675\t  const ax143 = (kind: 'bar' | 'line', extra: Record<string, unknown> = {}) => {\n   676\t    const r = record(kind, { title: 'L', data: many, x: 'x', y: 'y', ...extra }, { container: { width: 300, height: 240 } });\n   677\t    r.frames();\n   678\t    return r.controller.handle.diagnostics.find(d => d.code === 'AX143')?.message ?? null;\n   679\t  };\n   680\t  it('vertical bars on categories: the hint names horizontal bars', () => {\n   681\t    expect(ax143('bar')).toMatch(/horizontal: true/);\n   682\t  });\n   683\t  it('a line on categories: no horizontal-bar hint', () => {\n   684\t    const message = ax143('line');\n   685\t    if (message !== null) expect(message).not.toMatch(/horizontal/);\n   686\t  });\n   687\t});\n   688\t\n   689\tdescribe('seventh pass: an untitled chart is named in diagnostics by its target element\\'s id', () => {\n   690\t  it('a target with id \"sessions\": the diagnostics name \"sessions\", not the allocated id', () => {\n   691\t    const r = record('line', { data: rowsOf([1, 2]), x: 'x', y: 'y' }, { targetId: 'sessions' });\n   692\t    r.frames();\n   693\t    const ax140 = r.controller.handle.diagnostics.find(d => d.code === 'AX140');\n   694\t    expect(ax140?.chart).toBe('sessions');\n   695\t  });\n   696\t\n   697\t  it('a target without an id: the allocated id, as before', () => {\n   698\t    const r = record('line', { data: rowsOf([1, 2]), x: 'x', y: 'y' });\n   699\t    r.frames();\n   700\t    expect(r.controller.handle.diagnostics.find(d => d.code === 'AX140')?.chart).toBe('axylo-test');\n   701\t  });\n   702\t});\n","exit_code":0,"status":"completed"}}
