{"type":"item.completed","item":{"id":"item_51","type":"command_execution","command":"/bin/bash -lc \"nl -ba scripts/build.mjs | sed -n '1,164p'\nnl -ba tests/dist/tree-shaking.test.ts | sed -n '16,100p'\ncat scripts/size.mjs\"","aggregated_output":"     1\t// Builds packages/axylo/dist: ESM (production and development flavours), script-tag files, CSS and type declarations.\n     2\t//\n     3\t// Importing this file builds nothing: it exports what another build of the library from source needs to\n     4\t// reproduce these files (bench/build.mjs): `stylesheets()` and `stylesheetPlugin(text)`, and the `define`\n     5\t// objects. Run directly (`node scripts/build.mjs`, `npm run build`), it builds.\n     6\timport { build } from 'esbuild';\n     7\timport { execFileSync } from 'node:child_process';\n     8\timport fs from 'node:fs';\n     9\timport path from 'node:path';\n    10\t\n    11\tconst root = path.resolve(import.meta.dirname, '..');\n    12\tconst pkg = path.join(root, 'packages/axylo');\n    13\t\n    14\t/** Runs a source module through esbuild and imports it, for the values the build needs from the library. */\n    15\tasync function evaluate(entry) {\n    16\t  const r = await build({ entryPoints: [entry], bundle: true, format: 'esm', write: false, logLevel: 'silent' });\n    17\t  return import('data:text/javascript;base64,' + Buffer.from(r.outputFiles[0].contents).toString('base64'));\n    18\t}\n    19\t\n    20\t/**\n    21\t * The stylesheet's source of truth is src/theme/css.ts, a string in the library (it is also applied at run time\n    22\t * without a <style> element). The production files get it minified (src/theme/minify.ts: comments and layout\n    23\t * whitespace only) as a literal, so they do no work at import time, and dist/axylo.css is that same text. The\n    24\t * development files keep css.ts as written, so they stay what a plain build of the source gives.\n    25\t */\n    26\texport async function stylesheets() {\n    27\t  const { AXYLO_CSS: readable } = await evaluate(path.join(pkg, 'src/theme/css.ts'));\n    28\t  const { minifyCss } = await evaluate(path.join(pkg, 'src/theme/minify.ts'));\n    29\t  return { readable, minified: minifyCss(readable) };\n    30\t}\n    31\t\n    32\t/** Replaces src/theme/css.ts with the given stylesheet text as a literal. */\n    33\texport function stylesheetPlugin(text) {\n    34\t  const module = path.join(pkg, 'src/theme/css.ts');\n    35\t  return {\n    36\t    name: 'axylo-stylesheet',\n    37\t    setup(b) {\n    38\t      b.onLoad({ filter: /[\\\\/]theme[\\\\/]css\\.ts$/ }, args => path.resolve(args.path) === module\n    39\t        ? { contents: `export const AXYLO_CSS = ${JSON.stringify(text)};`, loader: 'js' } : undefined);\n    40\t    },\n    41\t  };\n    42\t}\n    43\t\n    44\t/**\n    45\t * Build-time constants. __BENCH__ carries the benchmark instrumentation (src/core/instrument.ts): false in every\n    46\t * shipped file (the development files have it through __DEV__); a benchmark build sets it true.\n    47\t */\n    48\texport const PRODUCTION = { __DEV__: 'false', __BENCH__: 'false' };\n    49\texport const DEVELOPMENT = { __DEV__: 'true', __BENCH__: 'false' };\n    50\t\n    51\tasync function main() {\n    52\t  const dist = path.join(pkg, 'dist');\n    53\t  fs.rmSync(dist, { recursive: true, force: true });\n    54\t  const { minified } = await stylesheets();\n    55\t  const common = { entryPoints: [path.join(pkg, 'src/index.ts')], bundle: true, target: 'es2022', legalComments: 'none', logLevel: 'warning', absWorkingDir: root };\n    56\t  const prod = { define: PRODUCTION, plugins: [stylesheetPlugin(minified)] };\n    57\t  const dev = { define: DEVELOPMENT };\n    58\t  await Promise.all([\n    59\t    build({ ...common, ...prod, format: 'esm', minify: true, outfile: path.join(dist, 'axylo.js') }),\n    60\t    build({ ...common, ...dev, format: 'esm', outfile: path.join(dist, 'axylo.dev.js') }),\n    61\t    build({ ...common, ...dev, format: 'iife', globalName: 'Axylo', outfile: path.join(dist, 'axylo.iife.js') }),\n    62\t    build({ ...common, ...prod, format: 'iife', globalName: 'Axylo', minify: true, outfile: path.join(dist, 'axylo.iife.min.js') }),\n    63\t  ]);\n    64\t  // For pages that prefer to load the stylesheet themselves, for example under a strict Content Security Policy.\n    65\t  fs.writeFileSync(path.join(dist, 'axylo.css'), minified);\n    66\t  execFileSync('npx', ['tsc', '-p', path.join(pkg, 'tsconfig.build.json')], { stdio: 'inherit', cwd: root });\n    67\t  console.log('built', fs.readdirSync(dist).filter(f => !fs.statSync(path.join(dist, f)).isDirectory()).join(', '));\n    68\t}\n    69\t\n    70\tif (path.resolve(process.argv[1] ?? '') === import.meta.filename) await main();\n    16\t * Each marker is first required in its own kind's bundle, so a marker that a rename made vanish fails here\n    17\t * instead of passing everything.\n    18\t *\n    19\t * The package ships one prebundled file per condition; that it can be shaken at all rests on its doing no work\n    20\t * at import time, which the first test proves.\n    21\t *\n    22\t * The markers can only see the code they name. The last group closes that gap a level up: the library's source,\n    23\t * bundled with the release build's production settings (scripts/build.mjs), one kind at a time, must not\n    24\t * include a module that belongs to another kind. Which module belongs to which kind is listed by hand from the\n    25\t * restructuring's map (reviews/2026-11-18/impl/wp/tree-shake.report.md): shared code that starts importing\n    26\t * another kind's composition, scene, lookup, view or store again brings in that kind's module, and fails there\n    27\t * even when the module's own text carries no marker. `validate` alone must carry no drawing, DOM, lookup or\n    28\t * reader module, since it runs only the synchronous stages (plan 1.6).\n    29\t */\n    30\timport { describe, expect, it } from 'vitest';\n    31\timport { build } from 'esbuild';\n    32\timport path from 'node:path';\n    33\timport { fixture, fixtureGuard, out, repo } from './paths';\n    34\t// @ts-expect-error scripts/build.mjs is plain JavaScript without declarations\n    35\timport { PRODUCTION, stylesheetPlugin, stylesheets } from '../../scripts/build.mjs';\n    36\t\n    37\tconst KINDS = ['line', 'area', 'bar', 'scatter', 'donut'] as const;\n    38\ttype Kind = typeof KINDS[number];\n    39\t\n    40\tconst ALIGNED_STORE = /adoptNormalized/;\n    41\tconst MARKERS: Record<Kind, readonly RegExp[]> = {\n    42\t  line: [/kind:\"line\",normalize:/],\n    43\t  area: [/kind:\"area\",normalize:/, /\\.upper\\b/],\n    44\t  bar: [/kind:\"bar\",normalize:/, /axylo-pattern-/],\n    45\t  scatter: [/kind:\"scatter\",normalize:/, /\\.minX\\b/],\n    46\t  donut: [/kind:\"donut\",normalize:/, /__other__/],\n    47\t};\n    48\tconst ALIGNED: readonly Kind[] = ['line', 'area', 'bar'];\n    49\t\n    50\tconst bundles = new Map<Kind, Promise<string>>();\n    51\tfunction consumer(kind: Kind): Promise<string> {\n    52\t  let text = bundles.get(kind);\n    53\t  if (!text) {\n    54\t    const cwd = fixture('npm');\n    55\t    text = build({\n    56\t      stdin: { contents: `export { ${kind} } from 'axylo';`, resolveDir: cwd, loader: 'ts', sourcefile: `${kind}.ts` }, absWorkingDir: cwd,\n    57\t      bundle: true, minify: true, format: 'esm', target: 'es2022', write: false, conditions: ['production'], logLevel: 'silent',\n    58\t      outdir: path.join(out, 'tree-shaking'), plugins: [fixtureGuard([cwd])],\n    59\t    }).then(r => r.outputFiles[0]!.text);\n    60\t    bundles.set(kind, text);\n    61\t  }\n    62\t  return text;\n    63\t}\n    64\t\n    65\tdescribe('the production file', () => {\n    66\t  // Why one prebundled file can be shaken: a bundler drops a top-level statement only when it can see that the\n    67\t  // statement does nothing. With `ignoreAnnotations` esbuild disregards the package's `sideEffects` promise, so\n    68\t  // an import for effect keeps exactly the statements that do work at import time: there must be none.\n    69\t  it('does no work at import time: imported for its effects, with side-effect hints ignored, it bundles to nothing', async () => {\n    70\t    const cwd = fixture('npm');\n    71\t    const r = await build({\n    72\t      stdin: { contents: `import 'axylo';`, resolveDir: cwd, loader: 'ts' }, absWorkingDir: cwd, bundle: true, minify: true, format: 'esm',\n    73\t      write: false, conditions: ['production'], ignoreAnnotations: true, logLevel: 'silent', outdir: path.join(out, 'tree-shaking'),\n    74\t      plugins: [fixtureGuard([cwd])],\n    75\t    });\n    76\t    expect(r.outputFiles[0]!.text.trim()).toBe('');\n    77\t  });\n    78\t});\n    79\t\n    80\tdescribe('a consumer that imports one chart kind', () => {\n    81\t  for (const kind of KINDS) {\n    82\t    it(`${kind}: carries its own composition and code (the markers are present)`, async () => {\n    83\t      const text = await consumer(kind);\n    84\t      for (const marker of MARKERS[kind]) expect(text, `${kind} lacks its own marker ${marker}`).toMatch(marker);\n    85\t      if (ALIGNED.includes(kind)) expect(text).toMatch(ALIGNED_STORE);\n    86\t    });\n    87\t\n    88\t    it(`${kind}: carries no other kind's code`, async () => {\n    89\t      const text = await consumer(kind);\n    90\t      const found: string[] = [];\n    91\t      for (const other of KINDS) {\n    92\t        if (other === kind) continue;\n    93\t        for (const marker of MARKERS[other]) if (marker.test(text)) found.push(`${other} ${marker}`);\n    94\t      }\n    95\t      if (!ALIGNED.includes(kind) && ALIGNED_STORE.test(text)) found.push(`aligned storage ${ALIGNED_STORE}`);\n    96\t      console.info(`${kind} only: ${text.length} bytes minified`);\n    97\t      expect(found).toEqual([]);\n    98\t    });\n    99\t  }\n   100\t});\n// What a consumer downloads, minified and gzipped, measured from the packed tarballs (spec DX7, P6; plan M7).\n//\n//   node scripts/size.mjs           pack packages/*/dist (scripts/pack.mjs --no-build), measure, print, write bench/size-latest.json\n//   node scripts/size.mjs --check   the same, and exit 1 when a row exceeds its target: total gzip bytes\n//                                   compared as integers against targetKiB * 1024 (96 KiB means 98,304 B)\n//   node scripts/size.mjs --no-pack measure the fixtures already in tests/dist/fixtures\n//\n// Every row is built the way a consumer's bundler would build it: esbuild, from inside a fixture that installed\n// the tarball, minified, with the `production` export condition, so only the packed files and their `exports`\n// are read. The script-tag row is the two files the documented snippet loads, as shipped.\n//\n// Stylesheet: the JavaScript carries the stylesheet as a string and applies it at run time, so a bundler page\n// downloads it inside its JavaScript and needs no axylo.css; the script-tag snippet also links axylo.css, so\n// that row adds the file. \"total\" is what each page downloads.\n//\n// Targets (spec DX7, set by the owner on 2026-11-18): 96 KiB everything, 80 KiB a page that uses only `line`.\n// CI runs this script without --check until the targets are met: the flag is correct,\n// but it is not a gate yet. The rows for each other chart kind alone and for `validate` alone have no target;\n// they show what tree-shaking leaves.\n//\n// The per-module breakdown cannot come from the packed files, which are one pre-bundled file each: it rebuilds\n// packages/axylo/src with the release build's production settings, imported from scripts/build.mjs (the\n// minified stylesheet, PRODUCTION constants), reads esbuild's metafile, and states how far that rebuild is from\n// the packed axylo.js.\nimport { build } from 'esbuild';\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { gzipSync } from 'node:zlib';\nimport { PRODUCTION, stylesheetPlugin, stylesheets } from './build.mjs';\nimport { fixtureGuard, pack } from './pack.mjs';\n\nconst root = path.resolve(import.meta.dirname, '..');\nconst fixtures = path.join(root, 'tests/dist/fixtures');\nconst LEVEL = 9;\nconst gzip = bytes => gzipSync(bytes, { level: LEVEL }).length;\nconst kib = bytes => +(bytes / 1024).toFixed(2);\n\n/** Whether `totalBytes` is over a target given in KiB: integer bytes against targetKiB * 1024, never rounded KiB. */\nexport const exceeds = (totalBytes, targetKiB) => targetKiB !== null && totalBytes > targetKiB * 1024;\n\nasync function main() {\n  if (!process.argv.includes('--no-pack')) pack({ build: false, log: () => {} });\n  const manifest = JSON.parse(fs.readFileSync(path.join(root, 'tests/dist/.packed/manifest.json'), 'utf8'));\n\n  async function consumer({ cwd, contents, external = [], metafile = false }) {\n    const r = await build({\n      stdin: { contents, resolveDir: cwd, loader: 'ts', sourcefile: 'consumer.ts' }, absWorkingDir: cwd, bundle: true, minify: true,\n      format: 'esm', target: 'es2022', conditions: ['production'], external, write: false, metafile, logLevel: 'silent',\n      plugins: [fixtureGuard([cwd])],\n    });\n    const inputs = Object.keys(r.metafile?.inputs ?? {});\n    return { bytes: r.outputFiles[0].contents, inputs };\n  }\n\n  const npm = path.join(fixtures, 'npm');\n  const axyloFile = file => fs.readFileSync(path.join(npm, 'node_modules/axylo/dist', file));\n  const css = axyloFile('axylo.css');\n\n  const cases = [\n    {\n      entry: 'line only (examples/first-chart/npm.ts)', targetKiB: 80,\n      build: () => consumer({ cwd: npm, contents: fs.readFileSync(path.join(npm, 'example/npm.ts'), 'utf8') }), cssFile: false,\n    },\n    { entry: 'everything (export * from axylo)', targetKiB: 96, build: () => consumer({ cwd: npm, contents: \"export * from 'axylo';\" }), cssFile: false },\n    ...['area', 'bar', 'scatter', 'donut', 'validate'].map(name => ({\n      entry: `${name} only (export { ${name} } from axylo)`, targetKiB: null, cssFile: false,\n      build: () => consumer({ cwd: npm, contents: `export { ${name} } from 'axylo';` }),\n    })),\n    { entry: 'script tag (axylo.iife.min.js + axylo.css)', targetKiB: null, build: async () => ({ bytes: axyloFile('axylo.iife.min.js') }), cssFile: true },\n  ];\n\n  const rows = [];\n  for (const c of cases) {\n    const { bytes } = await c.build();\n    const jsGzip = gzip(bytes);\n    const cssGzip = c.cssFile ? gzip(css) : 0;\n    const total = jsGzip + cssGzip;\n    rows.push({\n      entry: c.entry, minBytes: bytes.length, jsGzipBytes: jsGzip, cssFileGzipBytes: cssGzip, totalGzipBytes: total,\n      totalKiB: kib(total), targetKiB: c.targetKiB, targetBytes: c.targetKiB === null ? null : c.targetKiB * 1024,\n      over: exceeds(total, c.targetKiB),\n    });\n  }\n\n  console.log(`Download size from the packed tarballs (${manifest.packages.axylo.tarball}, packed ${manifest.packedAt}); esbuild minify, gzip level ${LEVEL}`);\n  console.table(rows.map(r => ({\n    entry: r.entry, 'min B': r.minBytes, 'js gzip B': r.jsGzipBytes, 'css file gzip B': r.cssFileGzipBytes || '—',\n    'total KiB': r.totalKiB, 'target KiB': r.targetKiB ?? '—', status: r.targetKiB === null ? 'no target' : r.over ? 'OVER' : 'ok',\n  })));\n  console.log(`The stylesheet is ${css.length} B, ${gzip(css)} B gzipped as a file; the same text is inside every JavaScript row above.`);\n\n  // Where the bytes of \"everything\" are: the source rebuilt as scripts/build.mjs builds dist/axylo.js.\n  const src = path.join(root, 'packages/axylo/src');\n  const { minified } = await stylesheets();\n  const rebuilt = await build({\n    entryPoints: [path.join(src, 'index.ts')], bundle: true, target: 'es2022', legalComments: 'none', format: 'esm', minify: true,\n    define: PRODUCTION, plugins: [stylesheetPlugin(minified)], write: false, metafile: true, logLevel: 'silent', absWorkingDir: root,\n  });\n  const packedProd = axyloFile('axylo.js').length;\n  const out = Object.values(rebuilt.metafile.outputs)[0];\n  const modules = Object.entries(out.inputs).map(([file, v]) => ({ file: path.relative(src, path.resolve(root, file)), bytes: v.bytesInOutput }))\n    .sort((a, b) => b.bytes - a.bytes);\n  const sum = modules.reduce((n, m) => n + m.bytes, 0);\n  const byDir = new Map();\n  for (const m of modules) { const d = m.file.includes(path.sep) ? m.file.split(path.sep)[0] : '(root)'; byDir.set(d, (byDir.get(d) ?? 0) + m.bytes); }\n  const dirs = [...byDir].sort((a, b) => b[1] - a[1]).map(([dir, bytes]) => ({ directory: dir, 'min B': bytes, share: `${((100 * bytes) / sum).toFixed(1)}%` }));\n  console.log(`\\nPer-module breakdown of \"everything\" (source rebuilt with the release settings: ${rebuilt.outputFiles[0].contents.length} B minified; the packed axylo.js is ${packedProd} B, ${rebuilt.outputFiles[0].contents.length === packedProd ? 'identical in size' : `a difference of ${rebuilt.outputFiles[0].contents.length - packedProd} B, so dist was built from different source`}). Minified bytes before gzip; gzip does not split by module.`);\n  console.table(dirs);\n  console.table(modules.slice(0, 25).map(m => ({ module: m.file, 'min B': m.bytes, share: `${((100 * m.bytes) / sum).toFixed(1)}%` })));\n\n  fs.mkdirSync(path.join(root, 'bench'), { recursive: true });\n  fs.writeFileSync(path.join(root, 'bench/size-latest.json'), JSON.stringify({\n    date: new Date().toISOString(),\n    method: 'esbuild consumer bundles from tests/dist/fixtures (packed tarballs), minify, production condition; gzip level 9',\n    packed: { at: manifest.packedAt, axylo: manifest.packages.axylo.integrity },\n    cssFileBytes: css.length, cssFileGzipBytes: gzip(css), rows,\n    breakdown: { rebuiltMinBytes: rebuilt.outputFiles[0].contents.length, packedMinBytes: packedProd, directories: dirs, modules },\n  }, null, 1));\n\n  if (process.argv.includes('--check') && rows.some(r => r.over)) {\n    console.error(`size target exceeded: ${rows.filter(r => r.over).map(r => `${r.entry} ${r.totalGzipBytes} B > ${r.targetBytes} B (${r.targetKiB} KiB)`).join('; ')}`);\n    process.exit(1);\n  }\n}\n\nif (path.resolve(process.argv[1] ?? '') === import.meta.filename) await main();\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc \"node - <<'AXYLO_REVIEW_STDIN'\nconst { buildSync, build } = require('esbuild');\nconst { execFileSync } = require('node:child_process');\nconst path = require('node:path');\nconst assert = require('node:assert/strict');\nconst cwd = process.cwd();\nfunction load(source, define = {__DEV__:'true'}, extra = {}) {\n  const b = buildSync({stdin:{contents:source,loader:'ts',resolveDir:cwd},bundle:true,write:false,format:'cjs',platform:'node',target:'es2022',define,logLevel:'silent',...extra});\n  return evaluate(b.outputFiles[0].text);\n}\nfunction evaluate(js){const m={exports:{}};new Function('module','exports','require',js)(m,m.exports,require);return m.exports;}\nconst fromHost=\\\"export {record,lastModel} from './packages/axylo/test/core/host';\\\";\nconst fromPublic=\\\"export {validate} from './packages/axylo/src/index';\\\";\nconst opts=(data,extra={})=>({title:'Review',data,x:'x',y:'y',...extra});\nconst rows=(xs)=>xs.map(x=>({x,y:x*10,z:x*100}));\nconst kinds=['line','area','bar','scatter','donut'];\nfunction hover(r,ref){let out;const off=r.controller.handle.on('hover',v=>out=v);r.controller.actions.hover(ref);off();return out;}\nfunction alignedXs(r){return [...r.committed.view.frame.x.values];}\nfunction hoverX(r,x,key='y'){return hover(r,{kind:'aligned',seriesKey:key,x});}\nfunction codes(c){return c.diagnostics.map(d=>d.code+(d.field?':'+d.field:''));}\n\nconst { readFileSync }=require('node:fs');\nconst git = (...args)=>execFileSync('git',args,{encoding:'utf8',maxBuffer:10*1024*1024});\nconst src='packages/axylo/src';\nconst shim='const dummy=new Proxy(()=>dummy,{get(){return dummy}}); export const expect=dummy; export const it=Object.assign((_,f)=>f(),{each:data=>(_,f)=>data.forEach(x=>Array.isArray(x)?f(...x):f(x))}); export const describe=(_,f)=>f();';\nasync function buildRev(rev, code, options={}, snapshotRegistry=false){\n  const files=new Set(git('ls-tree','-r','--name-only',rev,'--','packages/axylo').trim().split('\\\\n'));\n  const plugin={name:'git-blobs',setup(b){\n    b.onResolve({filter:/\"'^vitest$/},()=>({path:'\"'vitest',namespace:'shim'}));\n    b.onLoad({filter:/.*/,namespace:'shim'},()=>({contents:shim,loader:'js'}));\n    b.onResolve({filter:/\"'^'\"\\\\./},args=>{\n      const from=args.namespace==='git'?path.posix.dirname(args.importer):'';\n      const s=path.posix.join(from,args.path);\n      const p=[s,s.replace(/\\\\.js\"'$/,'\"'.ts'),s+'.ts',s+'/index.ts'].find(x=>files.has(x));\n      return p?{path:p,namespace:'git'}:{errors:[{text:'Not in '+rev+' '+s}]};\n    });\n    b.onLoad({filter:/.*/,namespace:'git'},args=>{\n      let contents=git('show',rev+':'+args.path);\n      if(snapshotRegistry && args.path.endsWith('/test/diagnostics/registry.test.ts'))\n        contents=git('show','a518cbb:'+args.path);\n      if(snapshotRegistry && args.path.endsWith('/src/diagnostics/registry.ts'))\n        contents=contents.replace('return diagnostic;', 'globalThis.axyloDiagnosticTrace.push(diagnostic); return diagnostic;');\n      return {contents,loader:'ts'};\n    });\n  }};\n  return await build({stdin:{contents:code,loader:'ts',resolveDir:cwd},bundle:true,format:'cjs',platform:'node',target:'es2022',write:false,define:{__DEV__:'true'},logLevel:'silent',...options,plugins:[plugin]});\n}\nasync function readRev(rev,...args){return evaluate((await buildRev(rev,...args)).outputFiles[0].text);}\n\n(async()=>{\n const registry=\\\"export {createDiagnostic, diagnosticRegistry} from './packages/axylo/src/diagnostics/registry'; import './packages/axylo/test/diagnostics/registry.test';\\\";\n globalThis.axyloDiagnosticTrace=[];\n const pre=await readRev('08b469b',registry,{},true);\n const oldTrace=globalThis.axyloDiagnosticTrace;\n globalThis.axyloDiagnosticTrace=[];\n const next=await readRev('a518cbb',registry,{},true);\n assert.deepEqual(globalThis.axyloDiagnosticTrace,oldTrace);\n console.log('registry-t