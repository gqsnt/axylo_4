troller.handle.update({data:circle});r.frames();\n  const p=r.committed.lookup.pick(cx,cy);\n  console.log('scatter 20px ring pick',n,r.committed.lookup.lastPickCandidates,r.committed.lookup.lastPickCells,p?.count);\n}\n{\n  const n=50000;const d=Array.from({length:n},(_,i)=>({x:i,y:i%10}));\n  const r=record('scatter',opts(d));r.frames();\n  const v=r.committed.view;const s=v.frame.series[0];\n  const end=s.x.at(-1);\n  const layout=r.layout;const pick=r.committed.lookup.pick(layout.projection.x.map(end),layout.projection.y.map(s.y.at(-1)));\n  const ref=r.committed.lookup.primary(pick);\n  const orig=s.row;let indexed=0;\n  Object.defineProperty(s,'row',{value:new Proxy(orig??{}, {get(o,k){if(/\"'^'\"\\\\d+\"'$/.test(String(k)))indexed++;return orig?o[k]:+k;}})});\n  const event=hover(r,ref);\n  console.log('\"'scatter hover controller row-index reads',n,ref.row,indexed,event?.row===d[ref.row]);\n}\nfor(const [kind,n,compact] of [['bar',32,true],['bar',32,false],['scatter',65,false]]){\n  const data=Array.from({length:n},(_,i)=>({x:kind==='bar'?'A':i,y:i+1,s:'S'+i}));\n  const r=record(kind,opts(data,{series:'s',compact}));r.frames();\n  const marks=r.draws.at(-1).marks.filter(m=>kind==='bar'?m.type==='rects':m.type==='points');\n  const seen=new Map(); const repeats=[];\n  for(const m of marks){\n    const sig=(m.series%8)+':'+(m.shape??m.pattern??'none');\n    if(seen.has(sig))repeats.push([seen.get(sig),m.series]);\n    else seen.set(sig,m.series);\n  }\n  console.log('series cue repeats',kind,n,compact,JSON.stringify(repeats));\n}\nAXYLO_REVIEW_STDIN\"","aggregated_output":"scatter 20px ring pick 2000 2064 12 15\nscatter 20px ring pick 8000 8047 12 63\nscatter 20px ring pick 32000 32048 12 255\nscatter hover controller row-index reads 50000 49999 50000 true\nseries cue repeats bar 32 true [[1,25],[2,26],[3,27],[4,28],[5,29],[6,30],[7,31]]\nseries cue repeats bar 32 false []\nseries cue repeats scatter 65 false [[0,64]]\n","exit_code":0,"status":"completed"}}
