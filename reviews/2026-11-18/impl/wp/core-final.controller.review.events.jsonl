pend([row(size)]);\n   140\t    const firstBuffers = numericBuffers(first.frame);\n   141\t    first.commit();\n   142\t    const before = s.frame;\n   143\t    const original = numericBuffers(before);\n   144\t    const measured = allocated(() => {\n   145\t      const candidate = s.prepareAppend([row(size + 1)]);\n   146\t      const during = numericBuffers(candidate.frame);\n   147\t      expect(s.frame).toBe(before);\n   148\t      candidate.commit();\n   149\t      return during.filter((buffer, i) => original[i] !== buffer).length;\n   150\t    });\n   151\t    console.info(`${kind}: ${measured.result} replaced numeric buffers, ${measured.bytes} typed-array bytes per appended row`);\n   152\t    expect(measured.result).toBe(0);\n   153\t    firstBuffers.forEach((buffer, index) => expect(buffer).toBe(initial[index]));\n   154\t    expect(measured.bytes).toBeLessThan(256);\n   155\t  });\n   156\t\n   157\t  it.each(['keep', 'replace'] as const)(`${kind} releases caller columns after %s and retirement`, async operation => {\n   158\t    function setup() {\n   159\t      const x = Float64Array.from({ length: 300 }, (_, i) => i);\n   160\t      const y = Float64Array.from(x, i => i + 1);\n   161\t      const label = Array.from(x, String);\n   162\t      const refs = [new WeakRef(x), new WeakRef(y), new WeakRef(label)];\n   163\t      const s = store(kind, { columns: { x, y, label } });\n   164\t      const old = s.frame;\n   165\t      if (operation === 'keep') s.prepareAppend([row(300)], { keep: 2 }).commit();\n   166\t      else {\n   167\t        const data = [row(300)];\n   168\t        s.prepareReplace(data, options(kind, data), { revision: old.revision + 1, epoch: old.epoch + 1 }).commit();\n   169\t      }\n   170\t      expect(old.source.rowAt(0)).toEqual({ x: 0, y: 1, label: '0' });\n   171\t      s.retire(old.revision);\n   172\t      return { refs, s, old };\n   173\t    }\n   174\t    const { refs, s, old } = setup();\n   175\t    await expectCollected(...refs);\n   176\t    expect(old.source.rowAt(0)).toBeNull();\n   177\t    expect(s.retainedRowCount).toBe(operation === 'keep' ? 2 : 1);\n   178\t  });\n   179\t}\n   180\t\n   181\tfor (const kind of types) {\n   182\t  it(`${kind} releases an object in a partly retained column block`, async () => {\n   183\t    function setup() {\n   184\t      const payload = [{ note: 'dropped' }, { note: 'retained' }];\n   185\t      const ref = new WeakRef(payload[0]!);\n   186\t      const data = { columns: { x: Float64Array.of(0, 1), y: Float64Array.of(1, 2), label: ['0', '1'], payload } };\n   187\t      const s = store(kind, data);\n   188\t      const before = s.frame;\n   189\t      s.prepareAppend([row(2)], { keep: 2 }).commit();\n   190\t      expect(before.source.rowAt(0)).toMatchObject({ payload: payload[0] });\n   191\t      expect(s.frame.source.rowAt(1)).toMatchObject({ payload: payload[1] });\n   192\t      s.retire(before.revision);\n   193\t      return { ref, s, before };\n   194\t    }\n   195\t    const { ref, s, before } = setup();\n   196\t    await expectCollected(ref);\n   197\t    expect(before.source.rowAt(0)).toBeNull();\n   198\t    expect(s.frame.source.rowAt(0)).toBeNull();\n   199\t    expect(s.frame.source.rowAt(1)).toMatchObject({ payload: { note: 'retained' } });\n   200\t  });\n   201\t}\n   202\t\n   203\tit('releases the original backing buffer of a sliced Uint8Array subclass', async () => {\n   204\t  function setup() {\n   205\t    const bytes = Buffer.alloc(300, 2);\n   206\t    const ref = new WeakRef(bytes.buffer);\n   207\t    const data = { columns: { x: Float64Array.from(bytes, (_, i) => i), y: bytes } };\n   208\t    const s = store('line', data);\n   209\t    const old = s.frame;\n   210\t    s.prepareAppend([row(300)], { keep: 2 }).commit();\n   211\t    s.retire(old.revision);\n   212\t    return { ref, s };\n   213\t  }\n   214\t  const { ref, s } = setup();\n   215\t  await expectCollected(ref);\n   216\t  expect(s.frame.source.rowAt(299)).toEqual({ x: 299, y: 2 });\n   217\t});\n   218\t\n   219\ttype Entry = { index: number; row: Omit<ReturnType<typeof row>, 'y' | 'z'> & { y: number | null; z: number | null } };\n   220\ttype Snapshot = { frame: Frame; rows: readonly Entry[]; field: 'y' | 'z'; next: number; zero?: boolean };\n   221\t\n   222\tfunction checkFrame({ frame, rows, field, next, zero = false }: Snapshot, live: boolean) {\n   223\t  const indexes = rows.map(entry => entry.index);\n   224\t  const xs = rows.map(entry => entry.row.x);\n   225\t  const values = rows.map(entry => entry.row[field]);\n   226\t  if (frame.shape === 'aligned') {\n   227\t    expect(frame.length).toBe(rows.length);\n   228\t    expect([...frame.x.values]).toEqual(xs);\n   229\t    if (rows.length) {\n   230\t      expect([...frame.series[0]!.y]).toEqual(values);\n   231\t      expect([...frame.series[0]!.slot]).toEqual(values.map(() => SLOT_VALUE));\n   232\t      expect([...frame.series[0]!.row!]).toEqual(indexes);\n   233\t    }\n   234\t  } else if (frame.shape === 'points') {\n   235\t    const points = rows.filter(entry => zero || entry.row[field] !== null);\n   236\t    const missing = zero ? [] : rows.filter(entry => entry.row[field] === null);\n   237\t    expect([...frame.series[0]!.x]).toEqual(points.map(entry => entry.row.x));\n   238\t    expect([...frame.series[0]!.y]).toEqual(points.map(entry => entry.row[field] ?? 0));\n   239\t    expect([...frame.series[0]!.row!]).toEqual(points.map(entry => entry.index));\n   240\t    expect([...(frame.series[0]!.missingX ?? [])]).toEqual(missing.map(entry => entry.row.x));\n   241\t  } else {\n   242\t    expect([...frame.labels]).toEqual(rows.map(entry => entry.row.label));\n   243\t    expect([...frame.values]).toEqual(values);\n   244\t    expect([...frame.slot]).toEqual(values.map(() => SLOT_VALUE));\n   245\t    expect([...frame.row!]).toEqual(indexes);\n   246\t  }\n   247\t\n   248\t  let cursor = 0;\n   249\t  for (let i = 0; i <= next; i++) {\n   250\t    const entry = rows[cursor];\n   251\t    expect(frame.source.rowAt(i)).toBe(live && entry?.index === i ? entry.row : null);\n   252\t    if (entry?.index === i) cursor++;\n   253\t  }\n   254\t}\n   255\t\n   256\tconst count = fc.integer({ min: 0, max: 7 });\n   257\tconst operations = fc.array(fc.oneof(\n   258\t  fc.record({ operation: fc.constant('append' as const), count, keep: fc.option(count, { nil: undefined }) }),\n   259\t  fc.record({ operation: fc.constant('replace' as const), count, start: fc.integer({ min: -50, max: 50 }) }),\n   260\t  fc.record({ operation: fc.constant('reencode' as const), field: fc.constantFrom('y' as const, 'z' as const), zero: fc.boolean() }),\n   261\t  fc.record({ operation: fc.constant('retire' as const), back: count }),\n   262\t), { minLength: 1, maxLength: 35 });\n   263\t\n   264\tfor (const kind of types) {\n   265\t  it(`${kind} matches a row model across live revisions and bounds append allocations`, () => {\n   266\t    fc.assert(fc.property(operations, ops => {\n   267\t      const s = store(kind, []);\n   268\t      let field: Snapshot['field'] = 'y';\n   269\t      let zero = false;\n   270\t      let rows: Entry[] = [];\n   271\t      let next = 0;\n   272\t      let x = 0;\n   273\t      let retired = s.frame.revision - 1;\n   274\t      let appendBytes = 0;\n   275\t      let rowsAdded = 0;\n   276\t      let seededRows = 0;\n   277\t      let appends = 0;\n   278\t      const snapshots: Snapshot[] = [{ frame: s.frame, rows, field, next, zero }];\n   279\t      const observation = (x: number): Entry['row'] => {\n   280\t        const item = row(x);\n   281\t        return kind === 'scatter' ? { ...item, y: x % 3 === 0 ? null : item.y, z: x % 5 === 0 ? null : item.z } : item;\n   282\t      };\n   283\t      const encoding = (data: unknown) => zero ? resolveOptions('scatter', {\n   284\t        data, x: { field: 'x', type: 'number' }, y: { field, missing: 'zero' },\n   285\t      }, quiet) : options(kind, data, field);\n   286\t      for (const op of ops) {\n   287\t        const before = s.frame;\n   288\t        const revised = { revision: before.revision + 1, epoch: before.epoch + 1 };\n   289\t        if (op.operation === 'append') {\n   290\t          const incoming = Array.from({ length: op.count }, () => observation(x++));\n   291\t          rows = [...rows, ...incoming.map(item => ({ index: next++, row: item }))];\n   292\t          if (op.keep !== undefined) rows = rows.slice(Math.max(0, rows.length - op.keep));\n   293\t          const { result: prepared, bytes } = allocated(() => s.prepareAppend(incoming, { keep: op.keep }));\n   294\t          appendBytes += bytes;\n   295\t          rowsAdded += incoming.length;\n   296\t          appends++;\n   297\t          expect(s.frame).toBe(before);\n   298\t          checkFrame({ frame: prepared.frame, rows, field, next, zero }, true);\n   299\t          prepared.commit();\n   300\t        } else if (op.operation === 'replace') {\n   301\t          x = op.start;\n   302\t          next = 0;\n   303\t          const data = Array.from({ length: op.count }, () => observation(x++));\n   304\t          rows = data.map(item => ({ index: next++, row: item }));\n   305\t          seededRows += rows.length;\n   306\t          s.prepareReplace(data, encoding(data), revised).commit();\n   307\t        } else if (op.operation === 'reencode') {\n   308\t          field = op.field;\n   309\t          zero = kind === 'scatter' && op.zero;\n   310\t          seededRows += rows.length;\n   311\t          s.prepareReencode(encoding(rows.map(entry => entry.row)), revised).commit();\n   312\t        } else {\n   313\t          retired = Math.max(retired, before.revision - op.back);\n   314\t          s.retire(retired);\n   315\t        }\n   316\t        if (s.frame !== before) snapshots.push({ frame: s.frame, rows, field, next, zero });\n   317\t        const retained = new Set(rows.map(entry => entry.row));\n   318\t        for (const snapshot of snapshots) {\n   319\t          const live = snapshot.frame.revision > retired;\n   320\t          checkFrame(snapshot, live);\n   321\t          if (live) for (const entry of snapshot.rows) retained.add(entry.row);\n   322\t        }\n   323\t        expect(s.retainedRowCount).toBe(retained.size);\n   324\t      }\n   325\t\n   326\t      // Each append has fixed scratch space and per-row scratch columns. A doubling\n   327\t      // or a compaction pays for itself across the rows inserted, evicted, or seeded.\n   328\t      expect(appendBytes).toBeLessThanOrEqual(2_048 * appends + 384 * (rowsAdded + seededRows));\n   329\t    }), { numRuns: 1_000 });\n   330\t  });\n   331\t\n   332\t  it(`${kind} uses offset views while sliding a fixed window and bounds long-run allocations`, () => {\n   333\t    const size = 600;\n   334\t    const s = store(kind, Array.from({ length: size }, (_, i) => row(i)));\n   335\t    const first = s.frame;\n   336\t    const a = s.prepareAppend([row(size)], { keep: size });\n   337\t    numericBuffers(a.frame).forEach((buffer, i) => expect(buffer).toBe(numericBuffers(first)[i]));\n   338\t    a.commit();\n   339\t    s.retire(first.revision);\n   340\t    const updates = 2_000;\n   341\t    const { bytes } = allocated(() => {\n   342\t      for (let i = 1; i <= updates; i++) {\n   343\t        const previous = s.frame;\n   344\t        s.prepareAppend([row(size + i)], { keep: size }).commit();\n   345\t        s.retire(previous.revision);\n   346\t      }\n   347\t    });\n   348\t    expect(s.retainedRowCount).toBe(size);\n   349\t    expect(bytes).toBeLessThan(256 * updates);\n   350\t  });\n   351\t}\n   352\t\n   353\tfunction frameValues(frame: Frame): unknown {\n   354\t  if (frame.shape === 'aligned') {\n   355\t    const values = contents(frame);\n   356\t    return { ...values, x: { ...values.x, categories: frame.x.categories && [...frame.x.categories] } };\n   357\t  }\n   358\t  if (frame.shape === 'donut') return {\n   359\t    labels: [...frame.labels], values: [...frame.values], slot: [...frame.slot], row: [...frame.row ?? []],\n   360\t  };\n   361\t  return frame.series.map(({ x, y, row, missingX, ...description }) => ({\n   362\t    ...description, x: [...x], y: [...y], row: [...row ?? []], missingX: [...missingX ?? []],\n   363\t  }));\n   364\t}\n   365\t\n   366\tconst generatedRows = fc.array(fc.record({\n   367\t  delta: fc.integer({ min: -2, max: 3 }),\n   368\t  group: fc.constantFrom('a', 'b', 'c'),\n   369\t  y: fc.oneof(fc.constant(null), fc.nat(100)),\n   370\t}), { minLength: 1, maxLength: 4 });\n   371\tconst previewOps = fc.array(fc.record({\n   372\t  rows: generatedRows, rival: generatedRows,\n   373\t  mode: fc.constantFrom('plain', 'prepare', 'abandon', 'first-wins', 'second-wins'),\n   374\t  keep: fc.option(fc.nat(12), { nil: undefined }),\n   375\t  eager: fc.boolean(), retire: fc.option(fc.nat(4), { nil: undefined }),\n   376\t}), { minLength: 1, maxLength: 26 });\n   377\t\n   378\tfor (const kind of ['line', 'category', 'scatter', 'donut'] as const) {\n   379\t  it(`${kind} agrees with eagerly read snapshots across mixed preview and append sequences`, () => {\n   380\t    fc.assert(fc.property(previewOps, ops => {\n   381\t      const data = [{ ...row(0), group: 'a' }, { ...row(0), group: 'b' }, { ...row(1), group: 'a' }]\n   382\t        .map(item => ({ ...item, x: kind === 'category' ? item.label : item.x }));\n   383\t      function open() {\n   384\t        if (kind === 'donut') return store(kind, [data[0]!, data[2]!]);\n   385\t        const chartType = kind === 'category' ? 'line' : kind;\n   386\t        const options = resolveOptions(chartType, {\n   387\t          data, x: { field: 'x', type: kind === 'category' ? 'category' : 'number' }, y: 'y', series: 'group',\n   388\t        }, quiet);\n   389\t        return kind === 'scatter' ? new PointStore(options, utc, version) : new AlignedStore('line', options, utc, version);\n   390\t      }\n   391\t      const lazy = open();\n   392\t      const eager = open();\n   393\t      const frames: { frame: Frame; values: unknown; rows: unknown[]; preview: boolean }[] = [\n   394\t        { frame: lazy.frame, values: frameValues(eager.frame), rows: data.map((_, i) => eager.frame.source.rowAt(i)), preview: false },\n   395\t      ];\n   396\t      let retired = version.revision - 1;\n   397\t      let next = kind === 'donut' ? 2 : 3;\n   398\t      let high = 1;\n   399\t      for (const op of ops) {\n   400\t        const encode = (rows: typeof op.rows) => rows.map(({ delta, group, y }) => {\n   401\t          const x = high + delta;\n   402\t          return { x: kind === 'category' ? String(x) : x, label: String(x), group, y };\n   403\t        });\n   404\t        let accepted = encode(op.rows);\n   405\t        const rival = encode(op.rival);\n   406\t        const remember = (frame: Frame, oracle: Frame, end: number, preview: boolean) => {\n   407\t          const values = frameValues(oracle);\n   408\t          const rows = Array.from({ length: end }, (_, i) => oracle.source.rowAt(i));\n   409\t          if (op.eager) expect(frameValues(frame)).toEqual(values);\n   410\t          frames.push({ frame, values, rows, preview });\n   411\t        };\n   412\t        const prepare = (rows: typeof accepted, preview: boolean) => {\n   413\t          const a = lazy.prepareAppend(rows, { keep: op.keep });\n   414\t          const b = eager.prepareAppend(rows, { keep: op.keep });\n   415\t          remember(a.frame, b.frame, next + rows.length, preview);\n   416\t          expect(a.diagnostics).toEqual(b.diagnostics);\n   417\t          return [a, b] as const;\n   418\t        };\n   419\t        if (op.mode === 'plain') {\n   420\t          const a = lazy.append(accepted);\n   421\t          const b = eager.append(accepted);\n   422\t          remember(a, b, next + accepted.length, false);\n   423\t        } else if (op.mode === 'abandon') {\n   4