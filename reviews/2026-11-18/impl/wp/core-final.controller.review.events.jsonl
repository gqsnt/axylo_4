me, revision, valueLabel: value?.label ?? frame.valueLabel, unit: value?.unit ?? null };\n  1658\t  if (frame.shape === 'points') {\n  1659\t    return { ...frame, revision, xLabel: resolved.x.label, yLabel: value?.label ?? frame.yLabel, xUnit: resolved.x.unit, yUnit: value?.unit ?? null };\n  1660\t  }\n  1661\t  const byField = new Map(resolved.values.map(v => [v.field, v]));\n  1662\t  return {\n  1663\t    ...frame, revision, xLabel: resolved.x.label, yLabel: resolved.values.length === 1 ? value!.label : null,\n  1664\t    series: frame.series.map(s => {\n  1665\t      const v = byField.get(s.field) ?? value;\n  1666\t      if (!v) return s;\n  1667\t      // Named by its field (wide form, or one series without a series field), else by its series value.\n  1668\t      return { ...s, unit: v.unit, label: resolved.form === 'wide' || resolved.series === null ? v.label : s.label };\n  1669\t    }),\n  1670\t  };\n  1671\t}\n  1672\t\n  1673\tconst pointDateUnits = new WeakMap<Frame, 'day' | 'month' | 'year'>();\n  1674\t\n  1675\t/**\n  1676\t * The precision calendar dates were written in on a scatter frame, the finest if mixed (\"2024-02\" is a month;\n  1677\t * spec F4). The point frame has no field for it (contracts: only the aligned x column does), so it is read\n  1678\t * from the caller's rows of the frame, once per frame.\n  1679\t */\n  1680\tfunction pointDateUnit(frame: Extract<Frame, { shape: 'points' }>, field: string): 'day' | 'month' | 'year' | null {\n  1681\t  if (frame.xKind !== 'date') return null;\n  1682\t  const known = pointDateUnits.get(frame);\n  1683\t  if (known) return known;\n  1684\t  let unit: 'day' | 'month' | 'year' = 'year';\n  1685\t  outer: for (const s of frame.series) {\n  1686\t    for (let i = 0; i < s.x.length; i++) {\n  1687\t      const row = frame.source.rowAt(s.row ? s.row[i]! : i);\n  1688\t      const raw = row !== null && typeof row === 'object' ? (row as Record<string, unknown>)[field] : undefined;\n  1689\t      co