{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/core/snapshot.test.ts'","aggregated_output":"     1\t/**\n     2\t * The displayed snapshot, the accepted state and the held state (core/controller.ts, invariants at the top):\n     3\t * the controller review's sequences (reviews/2026-11-18/impl/wp/core3.controller.review.md) as Node tests, and\n     4\t * the invariants as a property over random call sequences.\n     5\t */\n     6\timport fc from 'fast-check';\n     7\timport { describe, expect, it, vi } from 'vitest';\n     8\timport type { AlignedView, DatumRef } from '../../src/core/contracts';\n     9\timport type { Diagnostic, Point } from '../../src/public';\n    10\timport { defaultMessages } from '../../src/messages';\n    11\timport { lastModel, record, type Recording } from './host';\n    12\t\n    13\tconst xsOf = (r: Recording) => Array.from((r.committed!.view as AlignedView).frame.x.values);\n    14\tconst rowsOf = (values: readonly number[]) => values.map(x => ({ x, y: x * 10 }));\n    15\tconst ref = (x: number, seriesKey = 'y'): DatumRef => ({ kind: 'aligned', seriesKey, x });\n    16\tconst internal = 'Something went wrong while drawing the chart.';\n    17\t\n    18\tfunction hoverRow(r: Recording, x: number, seriesKey = 'y'): unknown {\n    19\t  let seen: Point<unknown> | null | undefined;\n    20\t  const off = r.controller.handle.on('hover', p => { seen = p; });\n    21\t  r.controller.actions.hover(null);\n    22\t  r.controller.actions.hover(ref(x, seriesKey));\n    23\t  off();\n    24\t  return seen?.row;\n    25\t}\n    26\t\n    27\tdescribe('controller blocker 1: one generation per frame', () => {\n    28\t  it('a readout formatter that updates the chart mid-frame leaves every layer on one revision', () => {\n    29\t    let chart: Recording['controller']['handle'] | null = null;\n    30\t    let fired = false;\n    31\t    const format = (v: number) => {\n  