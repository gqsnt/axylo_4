o(bucket: Bucket, x: number, y: number): number {\n    26\t  return Math.max(bucket.minX - x, x - bucket.maxX, 0) ** 2\n    27\t    + Math.max(bucket.minY - y, y - bucket.maxY, 0) ** 2;\n    28\t}\n    29\t\n    30\tfunction distanceAcross(bucket: Bucket, x: number, y: number): number {\n    31\t  return Math.max(Math.abs(bucket.minX - x), Math.abs(bucket.maxX - x)) ** 2\n    32\t    + Math.max(Math.abs(bucket.minY - y), Math.abs(bucket.maxY - y)) ** 2;\n    33\t}\n    34\t\n    35\texport function scatterGrid(\n    36\t  view: ScatterView, layout: PlotLayout & { projection: Extract<PlotLayout['projection'], { kind: 'xy' }> },\n    37\t  count: number, devicePixelRatio: number,\n    38\t) {\n    39\t  const { plot, projection } = layout;\n    40\t  const columns = Math.floor(plot.width / CELL) + 1;\n    41\t  const rows = Math.floor(plot.height / CELL) + 1;\n    42\t  const heads = new Map<number, number>();\n    43\t  const next = new Int32Array(count);\n    44\t  const series = new Uint32Array(count);\n    45\t  const points = new Uint32Array(count);\n    46\t  const xs = new Float64Array(count);\n    47\t  const ys = new Float64Array(count);\n    48\t  const tieDistance = 0.5 / (Number.isFinite(devicePixelRatio) && devicePixelRatio > 0 ? devicePixelRatio : 1);\n    49\t  let length = 0;\n    50\t  let examined = 0;\n    51\t  let cellsExamined = 0;\n    52\t\n    53\t  function cellIndex(pixel: number, origin: number, size: number): number {\n    54\t    // Subtracting the origin from a rounded plot edge can place that edge one cell past the grid.\n    55\t    return Math.max(0, Math.min(size - 1, Math.floor((pixel - origin) / CELL)));\n    56\t  }\n    57\t\n    58\t  const column = (x: number) => cellIndex(x, plot.x, columns);\n    59\t  const row = (y: number) => cellIndex(y, plot.y, rows);\n    60\t  const cellFor = (x: number, y: number) => column(x) + columns * row(y);\n    61\t\n    62\t  function sourceRow(at: number): number {\n    63\t    const i = points[at]!;\n    64\t    return view.frame.series[series[at]!]!.row?.[i] ?? i;\n    65\t  }\n    66\t\n    67\t  function later(at: number, other: number): boolean {\n    68\t    const difference = sourceRow(at) - sourceRow(other);\n    69\t    if (difference !== 0) return difference > 0;\n    70\t    const cellDifference = cellFor(xs[at]!, ys[at]!) - cellFor(xs[other]!, ys[other]!);\n    71\t    return cellDifference < 0 || cellDifference === 0 && at > other;\n    72\t  }\n    73\t\n    74\t  view.frame.series.forEach((data, s) => {\n    75\t    if (!view.visible[s] || !data.drawable) return;\n    76\t    const { start, end } = view.visiblePoints[s]!;\n    77\t    for (let i = start; i < end; i++) {\n    78\t      const x = scatterPosition(projection.x, data.x[i]!);\n    79\t      const y = scatterPosition(projection.y, data.y[i]!);\n    80\t      if (!contains(plot, x, y)) continue;\n    81\t      const cell = cellFor(x, y);\n    82\t      const at = length++;\n    83\t      next[at] = heads.get(cell) ?? -1;\n    84\t      heads.set(cell, at);\n    85\t      xs[at] = x;\n    86\t      ys[at] = y;\n    87\t      series[at] = s;\n    88\t      points[at] = i;\n    89\t    }\n    90\t  });\n    91\t\n    92\t  const order = new Uint32Array(length);\n    93\t  const multiplicity = new Uint32Array(length);\n    94\t  const buckets = new Map<number, Bucket>();\n    95\t  function build(start: number, end: number, allowSkew = true): Bucket {\n    96\t    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;\n    97\t    let count = 0;\n    98\t    for (let i = start; i < end; i++) {\n    99\t      const p = order[i]!;\n   100\t      minX = Math.min(minX, xs[p]!);\n   101\t      maxX = Math.max(maxX, xs[p]!);\n   102\t      minY = Math.min(minY, ys[p]!);\n   103\t      maxY = Math.max(maxY, ys[p]!);\n   104\t      count += multiplicity[p]!;\n   105\t    }\n   106\t    const bounds = { start, end, count, minX, maxX, minY, maxY };\n   107\t    if (end - start <= LEAF_SIZE) {\n   108\t      let latest = order[start]!;\n   109\t      for (let i = start + 1; i < end; i++) {\n   110\t        const at = order[i]!;\n   111\t        if (later(at, latest)) latest = at;\n   112\t      }\n   113\t      return { ...bounds, latest };\n   114\t    }\n   115\t\n   116\t    const byX = maxX - minX >= maxY - minY;\n   117\t    const positions = byX ? xs : ys;\n   118\t    const pivot = byX ? minX / 2 + maxX / 2 : minY / 2 + maxY / 2;\n   119\t    let mid = start;\n   120\t    for (let i = start; i < end; i++) {\n   121\t      const p = order[i]!;\n   122\t      if (positions[p]! >= pivot) continue;\n   123\t      order[i] = order[mid]!;\n   124\t      order[mid++] = p;\n   125\t    }\n   126\t    const smaller = Math.min(mid - start, end - mid);\n   127\t    const skewed = smaller < (end - start) / 8;\n   128\t    // Keep spatially separated groups together. Consecutive skewed splits need a median to bound depth.\n   129\t    const useSkew = skewed && allowSkew && smaller > 0;\n   130\t    if (skewed && !useSkew) {\n   131\t      order.subarray(start, end).sort((a, b) => positions[a]! - positions[b]!);\n   132\t      mid = start + Math.floor((end - start) / 2);\n   133\t    }\n   134\t    const left = build(start, mid, !useSkew);\n   135\t    const right = build(mid, end, !useSkew);\n   136\t    return { ...bounds, left, right, latest: later(left.latest, right.latest) ? left.latest : right.latest };\n   137\t  }\n   138\t\n   139\t  let end = 0;\n   140\t  for (const [cell, head] of heads) {\n   141\t    const start = end;\n   142\t    let uniform = true;\n   143\t    for (let at = head; at >= 0; at = next[at]!) {\n   144\t      order[end++] = at;\n   145\t      uniform &&= xs[at] === xs[head] && ys[at] === ys[head];\n   146\t    }\n   147\t    if (!uniform) order.subarray(start, end).sort((a, b) => xs[a]! - xs[b]! || ys[a]! - ys[b]!);\n   148\t\n   149\t    // Group identical positions before splitting the cell, so a median cannot spread them across leaves.\n   150\t    // Keep the latest row as the representative and link the others for the capped tooltip.\n   151\t    let write = start;\n   152\t    for (let i = start; i < end;) {\n   153\t      const first = order[i]!;\n   154\t      const groupStart = i++;\n   155\t      let last = first;\n   156\t      let winner = first;\n   157\t      let beforeWinner = -1;\n   158\t      for (; i < end; i++) {\n   159\t        const at = order[i]!;\n   160\t        if (xs[at] !== xs[first] || ys[at] !== ys[first]) break;\n   161\t        next[last] = at;\n   162\t        if (later(at, winner)) {\n   163\t          winner = at;\n   164\t          beforeWinner = last;\n   165\t        }\n   166\t        last = at;\n   167\t      }\n   168\t      next[last] = -1;\n   169\t      if (beforeWinner >= 0) {\n   170\t        next[beforeWinner] = next[winner]!;\n   171\t        next[winner] = first;\n   172\t      }\n   173\t      multiplicity[winner] = i - groupStart;\n   174\t      order[write++] = winner;\n   175\t    }\n   176\t    end = write;\n   177\t    buckets.set(cell, build(start, end));\n   178\t  }\n   179\t\n   180\t  return {\n   181\t    series, points,\n   182\t    // Count individual distance checks and rows visited while sampling tooltip refs.\n   183\t    get examined() { return examined; },\n   184\t    get cellsExamined() { return cellsExamined; },\n   185\t    pick(x: number, y: number) {\n   186\t      examined = 0;\n   187\t      cellsExamined = 0;\n   188\t      if (!contains(plot, x, y)) return null;\n   189\t      const radius = CELL + COINCIDENT;\n   190\t      const left = column(x - radius);\n   191\t      const right = column(x + radius);\n   192\t      const top = row(y - radius);\n   193\t      const bottom = row(y + radius);\n   194\t      const nearby: Bucket[] = [];\n   195\t      for (let cy = top; cy <= bottom; cy++) {\n   196\t        for (let cx = left; cx <= right; cx++) {\n   197\t          cellsExamined++;\n   198\t          const bucket = buckets.get(cx + cy * columns);\n   199\t          if (bucket) nearby.push(bucket);\n   200\t        }\n   201\t      }\n   202\t\n   203\t      let nearest = -1;\n   204\t      let best = RADIUS2;\n   205\t      function consider(at: number): void {\n   206\t        examined++;\n   207\t        const distance = (xs[at]! - x) ** 2 + (ys[at]! - y) ** 2;\n   208\t        if (distance < best || distance === best && (nearest < 0 || later(at, nearest))) {\n   209\t          nearest = at;\n   210\t          best = distance;\n   211\t        }\n   212\t      }\n   213\t      function search(bucket: Bucket, distance: number): void {\n   214\t        if (distance > best) return;\n   215\t        if (bucket.left && bucket.right) {\n   216\t          const left = distanceTo(bucket.left, x, y);\n   217\t          const right = distanceTo(bucket.right, x, y);\n   218\t          if (left <= right) {\n   219\t            search(bucket.left, left);\n   220\t            search(bucket.right, right);\n   221\t          } else {\n   222\t            search(bucket.right, right);\n   223\t            search(bucket.left, left);\n   224\t          }\n   225\t        } else {\n   226\t          for (let i = bucket.start; i < bucket.end; i++) consider(order[i]!);\n   227\t        }\n   228\t      }\n   229\t\n   230\t      nearby.sort((a, b) => distanceTo(a, x, y) - distanceTo(b, x, y));\n   231\t      for (const bucket of nearby) search(bucket, distanceTo(bucket, x, y));\n   232\t      if (nearest < 0) return null;\n   233\t\n   234\t      // Measuring from the closest point keeps a chain of near ties from extending the tie window.\n   235\t      const closest = Math.sqrt(best);\n   236\t      function inTie(distance: number): boolean {\n   237\t        return distance <= RADIUS2 && Math.sqrt(distance) - closest < tieDistance;\n   238\t      }\n   239\t      function searchTies(bucket: Bucket): void {\n   240\t        if (!later(bucket.latest, nearest) || !inTie(distanceTo(bucket, x, y))) return;\n   241\t        if (inTie(distanceAcross(bucket, x, y))) {\n   242\t          nearest = bucket.latest;\n   243\t        } else if (bucket.left && bucket.right) {\n   244\t          searchTies(bucket.left);\n   245\t          searchTies(bucket.right);\n   246\t        } else {\n   247\t          for (let i = bucket.start; i < bucket.end; i++) {\n   248\t            const at = order[i]!;\n   249\t            if (!later(at, nearest)) continue;\n   250\t            examined++;\n   251\t            if (inTie((xs[at]! - x) ** 2 + (ys[at]! - y) ** 2)) nearest = at;\n   252\t          }\n   253\t        }\n   254\t      }\n   255\t      for (const bucket of nearby) searchTies(bucket);\n   256\t\n   257\t      const px = xs[nearest]!;\n   258\t      const py = ys[nearest]!;\n   259\t      const hits = [nearest];\n   260\t      let count = 0;\n   261\t      function sample(head: number): void {\n   262\t        for (let at = head; at >= 0 && hits.length < POINT_LIMIT; at = next[at]!) {\n   263\t          examined++;\n   264\t          if (at !== nearest) hits.push(at);\n   265\t        }\n   266\t      }\n   267\t      function collect(bucket: Bucket): void {\n   268\t        if (distanceTo(bucket, px, py) > COINCIDENT2) return;\n   269\t        if (distanceAcross(bucket, px, py) <= COINCIDENT2) {\n   270\t          count += bucket.count;\n   271\t          for (let i = bucket.start; i < bucket.end && hits.length < POINT_LIMIT; i++) sample(order[i]!);\n   272\t        } else if (bucket.left && bucket.right) {\n   273\t          collect(bucket.left);\n   274\t          collect(bucket.right);\n   275\t        } else {\n   276\t          for (let i = bucket.start; i < bucket.end; i++) {\n   277\t            const at = order[i]!;\n   278\t            examined++;\n   279\t            if ((xs[at]! - px) ** 2 + (ys[at]! - py) ** 2 <= COINCIDENT2) {\n   280\t              count += multiplicity[at]!;\n   281\t              sample(at);\n   282\t           