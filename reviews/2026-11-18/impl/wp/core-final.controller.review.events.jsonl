+ ' is absent in ' + count(d, 'record') + rows(d)) +\n    57\t    '. Supply the field and send null if the value is known to be missing.',\n    58\t  outcome: 'Shown as gaps.' },\n    59\t  AX103: { level: 'warning', text: d =>\n    60\t    field(d) + ' has ' + count(d, 'non-finite value') + rows(d) + samples(d) + '. Check the calculation that produced it or send null for no data.',\n    61\t  outcome: 'Shown as gaps.' },\n    62\t  AX104: { level: 'hint', text: d =>\n    63\t    field(d) + ' has ' + count(d, 'decimal string') + rows(d) + '. Set parse: \\'number\\' to make conversion explicit.',\n    64\t  outcome: 'The strings are parsed and drawn as numbers.' },\n    65\t  AX105: { level: 'hint', text: d =>\n    66\t    field(d) + ' is missing ' + count(d, 'expected step') + series(d.series) + samples(d) +\n    67\t    '. Supply observations for those positions or explicit nulls to mark gaps.',\n    68\t  outcome: d => {\n    69\t    const outcomes = [];\n    70\t    const regular = d.series?.some(name => !d.sparseSeries?.includes(name) && !d.zeroSeries?.includes(name));\n    71\t    if (regular || !d.sparseSeries?.length && d.zeroSeries === undefined) outcomes.push('Shown as gaps.');\n    72\t    if (d.zeroSeries !== undefined) {\n    73\t      outcomes.push(regular || d.sparseSeries?.length ? 'Absent steps' + series(d.zeroSeries) + ' are shown as zeros.' : 'Shown as zeros.');\n    74\t    }\n    75\t    if (d.sparseSeries?.length) {\n    76\t      outcomes.push('The data' + series(d.sparseSeries) + ' was too sparse to show its absent steps as gaps.');\n    77\t    }\n    78\t    return outcomes.join(' ');\n    79\t  } },\n    80\t  AX106: { level: 'warning', text: d =>\n    81\t    field(d) + ' has ' + count(d, 'value that cannot be plotted as a number', 'values that cannot be plotted as numbers') +\n    82\t    rows(d) + samples(d) + '. Convert values to numbers where the data is produced.',\n    83\t  outcome: 'The affected values are not drawn.' },\n    84\t 