oup: 'b' }]);\n   460\t  const extend = s.prepareAppend([{ x: 2, y: 5, group: 'a' }]);\n   461\t  extend.commit();\n   462\t  expect([...base.series[1]!.y]).toEqual([2, NaN]);\n   463\t  expect([...s.frame.series[1]!.y]).toEqual([2, NaN, NaN]);\n   464\t  expect([...fill.frame.series[1]!.y]).toEqual([2, 4]);\n   465\t  expect([...s.frame.series[1]!.row!]).toEqual([1, -1, -1]);\n   466\t});\n   467\t\n   468\tfor (const kind of types) {\n   469\t  it(`${kind} compacts a large window after dropping almost all its rows`, () => {\n   470\t    const size = 10_000;\n   471\t    const keep = 37;\n   472\t    const s = store(kind, Array.from({ length: size }, (_, i) => row(i)));\n   473\t    const old = s.frame;\n   474\t    s.prepareAppend([row(size)], { keep }).commit();\n   475\t    s.retire(old.revision);\n   476\t    expect(s.retainedRowCount).toBe(keep);\n   477\t    for (const buffer of numericBuffers(s.frame)) {\n   478\t      expect(buffer.byteLength).toBeLessThanOrEqual(2 * keep * Float64Array.BYTES_PER_ELEMENT);\n   479\t    }\n   480\t  });\n   481\t}\n   482\t\n   483\tit('shares scatter missing positions through append and offset keep, then retires the evicted rows', async () => {\n   484\t  function setup() {\n   485\t    const dropped = { x: 1, y: null };\n   486\t    const ref = new WeakRef(dropped);\n   487\t    const data = [dropped, { x: 2, y: 4 }, { x: 3, y: null }];\n   488\t    const s = new PointStore(options('scatter', data), utc, version);\n   489\t    const old = s.frame;\n   490\t    const missing = old.series[0]!.missingX!;\n   491\t    expect(missing).toEqual(Float64Array.of(1, 3));\n   492\t    const accepted = s.prepareAppend([{ x: 3, y: null }, { x: 4, y: null }], { keep: 3 });\n   493\t    const current = accepted.frame.series[0]!.missingX!;\n   494\t    expect(current).toEqual(Float64Array.of(3, 3, 4));\n   495\t    expect(current.buffer).toBe(missing.buffer);\n   496\t    expect(current.byteOffset).toBe(missing.byteOffset + Float64Array.B