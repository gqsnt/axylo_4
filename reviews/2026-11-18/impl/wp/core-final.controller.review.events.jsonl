{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'for p in packages/axylo/src/core/{composition,stages,options,delivery,instrument,chart,environment}.ts packages/axylo/src/kinds/*.ts packages/axylo/src/index.ts; do nl -ba \"$p\"; done'","aggregated_output":"     1\t/**\n     2\t * What one chart kind brings to the shared controller and browser host: every stage that differs between\n     3\t * kinds, as functions the controller calls instead of dispatching on the kind itself. Each named entry\n     4\t * (`line`, `area`, …) passes its own composition (src/kinds), so a page that imports one kind bundles that\n     5\t * kind's stages only; the controller, the host, aligned data and Cartesian layout stay one implementation.\n     6\t */\n     7\timport type { DiagnosticSink, Frame, Layout, Scene, View } from './contracts';\n     8\timport type { ChartType, ResolvedOptions } from '../data/options';\n     9\timport type { DataEnvironment, FrameVersion } from '../data/normalize';\n    10\timport type { AlignedStore } from '../data/store';\n    11\timport type { DonutStore, PointStore } from '../data/store-unaligned';\n    12\timport type { ViewState } from '../view';\n    13\timport type { LookupBuilder } from '../lookup';\n    14\timport type { ReaderParts } from '../reader';\n    15\timport type { InteractionParts } from '../dom/interaction';\n    16\timport type { SvgMarks } from '../render/svg';\n    17\timport type { CanvasMarks } from '../render/canvas';\n    18\t\n    19\texport type Store = AlignedStore | PointStore | DonutStore;\n    20\t\n    21\texport interface Composition {\n    22\t  readonly kind: ChartType;\n    23\t  /** The frame shape's normalization; the kind is passed back in (the aligned kinds share one). */\n    24\t  normalize(kind: ChartType, resolved: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, version: FrameVersion): Frame;\n    25\t  /** Streaming storage for a static frame, opened by the first append. */\n    26\t  openStore(frame: Frame, source: ResolvedOptions, data: unknown, env: DataEnvironment, kind: ChartType): Store;\n    27\t  view(frame: Frame, state: ViewState, sink: DiagnosticSink): View;\n    28\t  scene(view: View, layout: Layout, devicePixelRatio: number): Scene;\n    29\t  readonly lookup: LookupBuilder;\n    30\t  readonly reader: ReaderParts;\n    31\t  readonly interaction: InteractionParts;\n    32\t  /** The mark handlers of each renderer, for the marks this kind's scenes and overlays can produce. */\n    33\t  readonly svg: SvgMarks;\n    34\t  readonly canvas: CanvasMarks;\n    35\t}\n     1\t/**\n     2\t * The DOM-free stages a call runs before anything is drawn (plan 1.5, 1.6): option resolution, the parts of\n     3\t * the options that decide what normalization reads, the view state, and the call-origin diagnostics the\n     4\t * view and the naming rule add. The chart controller and `validate()` both use these, so a server, a test or\n     5\t * a coding agent sees the same findings as a created chart (spec 3.5, DX8).\n     6\t */\n     7\timport type { DiagnosticInput, Frame, View } from './contracts';\n     8\timport type { Diagnostic, Messages, Title, XValue } from '../public';\n     9\timport { normalize, resolveOptions, type ChartType, type ResolvedOptions } from '../data';\n    10\timport { createDiagnostic, DiagnosticCollector, report } from '../diagnostics';\n    11\timport { buildView, type ViewState } from '../view';\n    12\timport { fill, resolveMessages } from '../messages';\n    13\timport { sameValue, INTERNAL_KEYS, type OptionRecord } from './options';\n    14\t\n    15\texport type Span<T = number> = readonly [T, T];\n    16\t\n    17\texport function object(value: unknown): Record<string, unknown> {\n    18\t  return value !== null && typeof value === 'object' ? value as Record<string, unknown> : {};\n    19\t}\n    20\t\n    21\texport function titleOf(options: OptionRecord): { text: string; level: number; visible: boolean } | null {\n    22\t  const raw = options.title;\n    23\t  if (typeof raw === 'string') return raw ? { text: raw, level: 3, visible: true } : null;\n    24\t  const t = object(raw) as Partial<Title>;\n    25\t  if (typeof t.text !== 'string' || t.text === '') return null;\n    26\t  const level = typeof t.level === 'number' && t.level >= 2 && t.level <= 6 ? Math.floor(t.level) : 3;\n    27\t  return { text: t.text, level, visible: t.visible !== false };\n    28\t}\n    29\t\n    30\texport function stringOption(options: OptionRecord, key: string): string | null {\n    31\t  const v = options[key];\n    32\t  return typeof v === 'string' && v !== '' ? v : null;\n    33\t}\n    34\t\n    35\texport function isCompact(kind: ChartType, options: OptionRecord): boolean {\n    36\t  return (kind === 'line' || kind === 'area' || kind === 'bar') && options.compact === true;\n    37\t}\n    38\t\n    39\t/** Options without the controller's own keys (the renderer switch). */\n    40\texport function publicOptions(input: unknown): OptionRecord {\n    41\t  if (input === null || typeof input !== 'object') return {};\n    42\t  const out: Record<string, unknown> = {};\n    43\t  for (const key of Object.keys(input)) {\n    44\t    const value = (input as Record<string, unknown>)[key];\n    45\t    // A key set to undefined is a default, as the patch rule reads it on create (finding 14: one path).\n    46\t    if (!INTERNAL_KEYS.includes(key) && value !== undefined) out[key] = value;\n    47\t  }\n    48\t  return out;\n    49\t}\n    50\t\n    51\t/** Option keys whose content normalization reads. */\n    52\tconst ENCODING_KEYS = ['x', 'y', 'series', 'label', 'value'] as const;\n    53\t/** Parts of a field spec that only the view, layout or formatting read: changing them never renormalizes. */\n    54\tconst PRESENTATION_PARTS = new Set(['domain', 'format', 'tickFormat']);\n    55\t\n    56\tfunction fieldEncoding(spec: unknown, ignore: ReadonlySet<string> = PRESENTATION_PARTS): unknown {\n    57\t  if (Array.isArray(spec)) return spec.map(item => fieldEncoding(item, ignore));\n    58\t  // 'day' and { field: 'day' } read the same field.\n    59\t  if (typeof spec === 'string') return { field: spec };\n    60\t  if (spec === null || typeof spec !== 'object') return spec;\n    61\t  const out: Record<string, unknown> = {};\n    62\t  for (const key of Object.keys(spec)) if (!ignore.has(key)) out[key] = (spec as Record<string, unknown>)[key];\n    63\t  return out;\n    64\t}\n    65\t\n    66\t/** True when the field specs differ in something normalization reads (plan 2.2: author domains belong to the view). */\n    67\texport function encodingChanged(before: OptionRecord, after: OptionRecord): boolean {\n    68\t  return ENCODING_KEYS.some(key => !sameValue(fieldEncoding(before[key]), fieldEncoding(after[key])));\n    69\t}\n    70\t\n    71\t/** PRESENTATION_PARTS with the names (a literal: no work at import time). */\n    72\tconst NAMING_PARTS = new Set(['domain', 'format', 'tickFormat', 'label', 'unit']);\n    73\t\n    74\t/**\n    75\t * True when the field specs differ only in labels and units: the values read are the same, so the frame's\n    76\t * names can be updated without reading the data again (review 3, finding 12).\n    77\t */\n    78\texport function namesOnlyChanged(before: OptionRecord, after: OptionRecord): boolean {\n    79\t  return ENCODING_KEYS.every(key => sameValue(fieldEncoding(before[key], NAMING_PARTS), fieldEncoding(after[key], NAMING_PARTS)));\n    80\t}\n    81\t\n    82\texport function viewStateFor(\n    83\t  kind: ChartType, options: OptionRecord, resolved: ResolvedOptions, zoom: Span<XValue> | null,\n    84\t  previous: View | null, hidden: ReadonlySet<string>, messages: Messages,\n    85\t): ViewState {\n    86\t  if (kind === 'donut') return { kind, otherLabel: count => fill(messages.otherSlices, { count }), previous };\n    87\t  const value = resolved.values[0];\n    88\t  const common = {\n    89\t    hidden, zoom, xField: resolved.x, xDomain: resolved.x.domain, valueDomain: value?.domain ?? null,\n    90\t    valueField: value?.field, references: Array.isArray(options.reference) ? options.reference as never : [], previous,\n    91\t  };\n    92\t  // Scatter has no frame-level value scale to infer from: the declared one reaches the domain (F7).\n    93\t  if (kind === 'scatter') return { ...common, kind, valueScale: value?.scale ?? null };\n    94\t  return {\n    95\t    ...common, kind,\n    96\t    stacked: kind === 'area' ? options.stacked === true : kind === 'bar' ? options.layout === 'stacked' : false,\n    97\t    horizontal: kind === 'bar' && options.horizontal === true,\n    98\t    compact: isCompact(kind, options),\n    99\t  };\n   100\t}\n   101\t\n   102\t/** What the view depends on; equal keys mean the previous view is still right. */\n   103\texport function viewKeyFor(\n   104\t  kind: ChartType, options: OptionRecord, resolved: ResolvedOptions, frame: Frame, zoom: Span<XValue> | null,\n   105\t  hidden: ReadonlySet<string>, messages: Messages,\n   106\t): readonly unknown[] {\n   107\t  return [frame, zoom, [...hidden].sort().join('\\u0000'), resolved.x.domain, resolved.values[0]?.domain, options.reference,\n   108\t    options.stacked, options.layout, options.horizontal, options.compact, kind === 'donut' ? messages.otherSlices : null];\n   109\t}\n   110\t\n   111\t/**\n   112\t * The view reports AX110, AX130 and AX131 only when they are new against the previous view it reuses. The\n   113\t * chart keeps the complete set: a finding the previous view had is kept while its condition still holds.\n   114\t */\n   115\texport function completeViewDiagnostics(\n   116\t  kind: ChartType, found: readonly DiagnosticInput[], before: readonly DiagnosticInput[], view: View, state: ViewState,\n   117\t): DiagnosticInput[] {\n   118\t  const out = [...found];\n   119\t  if (view.kind === 'donut') return out;\n   120\t  const has = (code: string) => out.some(d => d.code === code);\n   121\t  const series = view.frame.series.length;\n   122\t  const domain = 'valueDomain' in state ? state.valueDomain : null;\n   123\t  const stillHolds: Record<string, boolean> = {\n   124\t    AX130: series > 8,\n   125\t    AX131: view.compact && series > 1,\n   126\t    AX110: (kind === 'bar' || kind === 'area') && domain !== null && domain !== undefined &&\n   127\t      domain.every(Number.isFinite) && (Math.min(domain[0], domain[1]) > 0 || Math.max(domain[0], domain[1]) < 0),\n   128\t  };\n   129\t  for (const d of before) {\n   130\t    if (stillHolds[d.code] && !has(d.code)) out.push(d);\n   131\t  }\n   132\t  return out;\n   133\t}\n   134\t\n   135\t/** AX140 (spec A1): no title and no `labelledBy`. A `labelledBy` that names nothing is checked when drawn. */\n   136\texport function namingDiagnostics(options: OptionRecord): DiagnosticInput[] {\n   137\t  if (titleOf(options) !== null || stringOption(options, 'labelledBy') !== null) return [];\n   138\t  const sink = new DiagnosticCollector();\n   139\t  report(sink, 'AX140', 'none');\n   140\t  return [...sink.inputs()];\n   141\t}\n   142\t\n   143\t/** resolveOptions reports AX100 and AX101; normalization may report them again. Keep one copy. */\n   144\texport function dedupe(options: readonly DiagnosticInput[], data: readonly DiagnosticInput[]): DiagnosticInput[] {\n   145\t  return options.filter(o => !data.some(d => d.code === o.code && d.field === o.field));\n   146\t}\n   147\t\n   148\texport function toPublic(inputs: readonly DiagnosticInput[], chart: string): Diagnostic[] {\n   149\t  return inputs.map(({ effect: _e, origin: _o, ...d }) => ({ ...d, chart }));\n   150\t}\n   151\t\n   152\t/**\n   153\t * Everything a create call validates without a DOM, in the order the chart lists it: options, data, view,\n   154\t * naming. `validate()` returns this; a created chart reports the same call-origin findings.\n   155\t */\n   156\texport function staticDiagnostics(kind: ChartType, input: unknown, timeZone: string): Diagnostic[] {\n   157\t  const options = publicOptions(input);\n   158\t  const optionSink = new DiagnosticCollector();\n   159\t  const dataSink = new DiagnosticCollector();\n   160\t  let name: string = kind;\n   161\t  try {\n   162\t    const resolved = resolveOptions(kind, options, optionSink);\n   163\t    name = resolved.name;\n   164\t    const frame = normalize(kind, resolved, { timeZone }, dataSink, { epoch: 1, revision: 1 });\n   165\t    const viewSink = new DiagnosticCollector();\n   166\t    const messages = resolveMessages(object(options.messages));\n   167\t    const state = viewStateFor(kind, options, resolved, null, null, new Set(), messages);\n   168\t    buildView(frame as never, state as never, viewSink);\n   169\t    const data = dataSink.inputs();\n   170\t    return toPublic([...dedupe(optionSink.inputs(), data), ...data, ...viewSink.inputs(), ...namingDiagnostics(options)], name);\n   171\t  } catch {\n   172\t    // A failure inside the stages (an x getter that throws): AX199, as a created chart reports it (finding 14).\n   173\t    return toPublic([...optionSink.inputs(), createDiagnostic('AX199', 'chart-error', {}, 'presentation'), ...namingDiagnostics(options)], name);\n   174\t  }\n   175\t}\n   176\t\n   177\texport { createDiagnostic };\n     1\t/**\n     2\t * The options a chart currently holds, and the patch rule of the commit contract (plan 1.5): a key present in\n     3\t * a patch replaces the old value whole, a key set to `undefined` returns to its default (it is removed, and\n     4\t * resolution supplies the default), and absent keys stay. No deep merging.\n     5\t */\n     6\t\n     7\texport type OptionRecord = Readonly<Record<string, unknown>>;\n     8\t\n     9\t/** Keys the controller reads itself and never passes to option resolution. */\n    10\texport const INTERNAL_KEYS: readonly string[] = ['__renderer'];\n    11\t\n    12\texport interface Patched {\n    13\t  readonly next: OptionRecord;\n    14\t  /** Keys whose value is no longer the same object or primitive. */\n    15\t  readonly changed: ReadonlySet<string>;\n    16\t}\n    17\t\n    18\t/** Applies a patch to `current` without changing it. */\n    19\texport function applyPatch(current: OptionRecord, patch: unknown): Patched {\n    20\t  const next: Record<string, unknown> = { ...current };\n    21\t  const changed = new Set<string>();\n    22\t  if (patch === null || typeof patch !== 'object') return { next, changed };\n    23\t  for (const key of Object.keys(patch)) {\n    24\t    if (INTERNAL_KEYS.includes(key)) continue;\n    25\t    const value = (patch as Record<string, unknown>)[key];\n    26\t    const had = Object.hasOwn(current, key);\n    27\t    if (value === undefined) {\n    28\t      if (had) {\n    29\t        delete next[key];\n    30\t        changed.add(key);\n    31\t      }\n    32\t      continue;\n    33\t    }\n    34\t    // Small option inputs are kept as given at the call (a copy), never the caller's object, so editing and\n    35\t    // resubmitting that object is seen as a change (review 3, finding 12). Data stays borrowed.\n    36\t    const kept = key === 'data' ? value : snapshot(value);\n    37\t    if (!had || !Object.is(current[key], value) && !sameValue(current[key], kept)) changed.add(key);\n    38\t    next[key] = kept;\n    39\t  }\n    40\t  return { next, changed };\n    41\t}\n    42\t\n    43\t/** A copy of plain objects and arrays (functions, dates, typed arrays and other objects as they are). */\n    44\tfunction snapshot(value: unknown): unknown {\n    45\t  if (Array.isArray(value)) return value.map(snapshot);\n    46\t  if (isPlain(value)) {\n    47\t    const out: Record<string, unknown> = {};\n    48\t    for (const key of Object.keys(value)) out[key] = snapshot(value[key]);\n    49\t    return out;\n    50\t  }\n    51\t  return value;\n    52\t}\n    53\t\n    54\t/** Holds the accepted options. A rejected call never reaches `commit`, so the store stays on the last valid state. */\n    55\texport class OptionsStore {\n    56\t  private value: OptionRecord;\n    57\t\n    58\t  constructor(initial: unknown) {\n    59\t    this.value = applyPatch({}, initial).next;\n    60\t  }\n    61\t\n    62\t  get current(): OptionRecord {\n    63\t    return this.value;\n    64\t  }\n    65\t\n    66\t  /** What `patch` would give, without accepting it. */\n    67\t  preview(patch: unknown): Patched {\n    68\t    return applyPatch(this.value, patch);\n    69\t  }\n    70\t\n    71\t  commit(next: OptionRecord): void {\n    72\t    this.value = next;\n    73\t  }\n    74\t}\n    75\t\n    76\t/**\n    77\t * Structural equality for option values that describe encoding (field specs, domains, references): plain\n    78\t * objects and arrays by content, functions and everything else by identity. Data is never compared this way.\n    79\t */\n    80\texport function sameValue(a: unknown, b: unknown): boolean {\n    81\t  if (Object.is(a, b)) return true;\n    82\t  if (a instanceof Date && b instanceof Date) return a.getTime() === b.getTime();\n    83\t  if (Array.isArray(a) && Array.isArray(b)) {\n    84\t    return a.length === b.length && a.every((item, i) => sameValue(item, b[i]));\n    85\t  }\n    86\t  if (isPlain(a) && isPlain(b)) {\n    87\t    const keys = Object.keys(a);\n    88\t    if (keys.length !== Object.keys(b).length) return false;\n    89\t    return keys.every(key => Object.hasOwn(b, key) && sameValue(a[key], b[key]));\n    90\t  }\n    91\t  return false;\n    92\t}\n    93\t\n    94\tfunction isPlain(value: unknown): value is Record<string, unknown> {\n    95\t  if (value === null || typeof value !== 'object') return false;\n    96\t  const proto = Object.getPrototypeOf(value) as unknown;\n    97\t  return proto === Object.prototype || proto === null;\n    98\t}\n     1\t/**\n     2\t * Diagnostic delivery (spec 3.5): what is printed, what reaches `onDiagnostic`, and what `strict` throws.\n     3\t *\n     4\t * Errors and warnings print with `console.warn` once per code per page in every build; hints print with\n     5\t * `console.info`, also once per code per page, and only in development builds. `onDiagnostic` receives every\n     6\t * diagnostic a chart newly finds. `strict` throws on errors and warnings found while validating a call\n     7\t * (origin 'call'); diagnostics found later (origin 'presentation') are reported and never thrown.\n     8\t */\n     9\timport type { DiagnosticInput } from './contracts';\n    10\timport type { Diagnostic } from '../public';\n    11\t\n    12\texport interface DeliveryConsole {\n    13\t  warn(...args: unknown[]): void;\n    14\t  info(...args: unknown[]): void;\n    15\t  error(...args: unknown[]): void;\n    16\t}\n    17\t\n    18\t/** Codes already printed, per page. The key is the document in a browser, any object in tests. */\n    19\tconst printed = new WeakMap<object, Set<string>>();\n    20\tconst fallbackPage = {};\n    21\t\n    22\texport interface DeliveryOptions {\n    23\t  readonly console: DeliveryConsole | null;\n    24\t  readonly development: boolean;\n    25\t  /** The page the once-per-code rule applies to. */\n    26\t  readonly page: object | null;\n    27\t}\n    28\t\n    29\texport type DiagnosticListener = (diagnostic: Diagnostic) => void;\n    30\t\n    31\texport function format(d: Diagnostic): string {\n    32\t  return `[axylo ${d.code}] ${JSON.stringify(d.chart)}: ${d.message}`;\n    33\t}\n    34\t\n    35\t/** Identity of a diagnostic for \"is this one new\": the same finding found again is not delivered twice. */\n    36\texport function diagnosticKey(d: Pick<Diagnostic, 'code' | 'field' | 'message'>): string {\n    37\t  return `${d.code}\\u0000${d.field ?? ''}\\u0000${d.message}`;\n    38\t}\n    39\t\n    40\texport class Delivery {\n    41\t  private listenerFailed = false;\n    42\t\n    43\t  constructor(private readonly options: DeliveryOptions) {}\n    44\t\n    45\t  /**\n    46\t   * Prints and hands to the listener the diagnostics in `found` that are not in `before`. The listener is\n    47\t   * author code: after each call `alive` says whether to go on (the chart may have been destroyed or have\n    48\t   * moved to a new state that delivers its own findings).\n    49\t   */\n    50\t  deliver(\n    51\t    found: readonly Diagnostic[], before: readonly Diagnostic[] | ReadonlySet<string>, listener: DiagnosticListener | null,\n    52\t    alive: () => boolean = () => true,\n    53\t  ): void {\n    54\t    const known = new Set(before instanceof Set ? before : (before as readonly Diagnostic[]).map(diagnosticKey));\n    55\t    for (const d of found) {\n    56\t      if (!alive()) return;\n    57\t      if (known.has(diagnosticKey(d))) continue;\n    58\t      known.add(diagnosticKey(d));\n    59\t      this.print(d);\n    60\t      if (listener) this.notify(listener, d);\n    61\t    }\n    62\t  }\n    63\t\n    64\t  print(d: Diagnostic): void {\n    65\t    const out = this.options.console;\n    66\t    if (!out) return;\n    67\t    if (d.level === 'hint' && !this.options.development) return;\n    68\t    const page = this.options.page ?? fallbackPage;\n    69\t    let codes = printed.get(page);\n    70\t    if (!codes) printed.set(page, codes = new Set());\n    71\t    if (codes.has(d.code)) return;\n    72\t    codes.add(d.code);\n    73\t    if (d.level === 'hint') out.info(format(d));\n    74\t    else out.warn(format(d));\n    75\t  }\n    76\t\n    77\t  /** An internal failure: the chart shows its internal-error state; this says why. Not a registry code. */\n    78\t  internal(chart: string, error: unknown): void {\n    79\t    this.options.console?.error(`[axylo] ${JSON.stringify(chart)}: internal error while drawing the chart.`, error);\n    80\t  }\n    81\t\n    82\t  /** Hands one diagnostic to the author's listener; a listener that throws is reported once and ignored. */\n    83\t  notify(listener: DiagnosticListener, d: Diagnostic): void {\n    84\t    try {\n    85\t      listener(d);\n    86\t    } catch (error) {\n    87\t      // An author's handler that throws must not break the chart; say so once.\n    88\t      if (!this.listenerFailed) this.options.console?.error('[axylo] onDiagnostic threw:', error);\n    89\t      this.listenerFailed = true;\n    90\t    }\n    91\t  }\n    92\t}\n    93\t\n    94\t/** The diagnostics `strict` throws on: errors and warnings found while validating the call. */\n    95\texport function strictViolations(inputs: readonly DiagnosticInput[]): DiagnosticInput[] {\n    96\t  return inputs.filter(d => d.origin === 'call' && (d.level === 'error' || d.level === 'warning'));\n    97\t}\n    98\t\n    99\t/** The error a strict chart throws. It carries every diagnostic of the rejected call. */\n   100\texport class StrictError extends Error {\n   101\t  readonly diagnostics: readonly Diagnostic[];\n   102\t\n   103\t  constructor(chart: string, diagnostics: readonly Diagnostic[]) {\n   104\t    const first = diagnostics.find(d => d.level !== 'hint') ?? diagnostics[0];\n   105\t    super(first\n   106\t      ? `${format(first)}${diagnostics.length > 1 ? ` (and ${diagnostics.length - 1} more)` : ''}`\n   107\t      : `[axylo] ${JSON.stringify(chart)}: rejected by strict mode.`);\n   108\t    this.name = 'AxyloStrictError';\n   109\t    this.diagnostics = diagnostics;\n   110\t  }\n   111\t}\n     1\t/**\n     2\t * Test and benchmark instrumentation, in one place: the `__bench` handle the benchmark harness reads\n     3\t * (bench/README.md), the `__dev` handle the tests read (stage counters, the forced-failure hook), and the\n     4\t * stage counters behind them. It is present in the development files (`__DEV__`) and in a build made with\n     5\t * `__BENCH__` true (the benchmark harness's own build, where `__bench` is attached when the page set\n     6\t * `globalThis.__AXYLO_BENCH__`), and absent from every shipped production file: the controller calls in only\n     7\t * under `instrumented`, which the build folds to false. What the harness reads next goes here, from `Probe`.\n     8\t */\n     9\timport type { Layout, View } from './contracts';\n    10\timport { SLOT_NO_ROW, SLOT_VALUE } from './contracts';\n    11\timport type { Chart } from '../public';\n    12\timport { drawing } from '../scene/lines';\n    13\timport { simplifyLine } from '../simplify';\n    14\t\n    15\ttype Span = readonly [number, number];\n    16\t\n    17\texport const STAGES = ['options', 'normalize', 'append', 'view', 'frame', 'theme', 'formatters', 'layout', 'scene', 'lookup',\n    18\t  'reader', 'draw', 'text', 'figure'] as const;\n    19\texport type Stage = typeof STAGES[number];\n    20\t\n    21\t/** What the benchmark harness reads (bench/README.md): readiness and what the committed frame shows. */\n    22\texport interface BenchHook {\n    23\t  readonly revision: number;\n    24\t  ready(): Promise<void>;\n    25\t  describe(): {\n    26\t    xDomain: Span | null;\n    27\t    yDomain: Span | null;\n    28\t    series: {\n    29\t      key: string; points: number; oldestX: number; newestX: number; missing: number;\n    30\t      /**\n    31\t       * Line charts: the caller's row indexes of the samples the simplified drawing kept, in drawing order (spec\n    32\t       * F5), so drawn gaps and extremes can be checked index-exactly. Absent for other chart types.\n    33\t       */\n    34\t      kept?: number[];\n    35\t    }[];\n    36\t    /** The mark renderer drawing this chart. */\n    37\t    renderer: 'canvas' | 'svg';\n    38\t  };\n    39\t}\n    40\t\n    41\texport interface DevHook {\n    42\t  stages(): Record<Stage, number>;\n    43\t  /** Makes the named stage throw, to test the internal-error state; null stops it. */\n    44\t  fail(stage: Stage | null): void;\n    45\t  readonly renderer: 'canvas' | 'svg';\n    46\t  /** Rows the streaming store still holds for revisions not yet retired (0 for a static chart). */\n    47\t  retainedRows(): number;\n    48\t}\n    49\t\n    50\texport type ChartHandle = Chart<unknown, Record<string, unknown>> & { __bench?: BenchHook; __dev?: DevHook };\n    51\t\n    52\t// Whether a build carries the instrumentation is `__DEV__ || (typeof __BENCH__ !== 'undefined' && __BENCH__)`,\n    53\t// written out where the controller uses it rather than named here: the build must see the constants to drop what\n    54\t// they guard. `typeof` keeps a build that defines only __DEV__ working (it then has none).\n    55\t\n    56\t/** Counts the stages that ran and makes one throw on request (the internal-error tests). */\n    57\texport class StageCounter {\n    58\t  readonly counts = Object.fromEntries(STAGES.map(s => [s, 0])) as Record<Stage, number>;\n    59\t  failing: Stage | null = null;\n    60\t  ran(name: Stage): void {\n    61\t    this.counts[name]++;\n    62\t    if (this.failing === name) throw new Error(`Axylo test hook: forced failure in the ${name} stage.`);\n    63\t  }\n    64\t}\n    65\t\n    66\t/** What the controller lets the instrumentation read; the frame on screen and its revision. */\n    67\texport interface Probe {\n    68\t  readonly stages: StageCounter;\n    69\t  /** The accepted revision (0 before anything was accepted). */\n    70\t  revision(): number;\n    71\t  /** Resolves once the page settled on the accepted revision (drawn, or its error shown), or the chart is gone. */\n    72\t  ready(): Promise<void>;\n    73\t  /** The committed frame: its view and layout, and the pixel ratio it was drawn at; null before the first. */\n    74\t  shown(): { readonly view: View; readonly layout: Layout; readonly pixelRatio: number } | null;\n    75\t  renderer(): 'canvas' | 'svg';\n    76\t  retainedRows(): number;\n    77\t}\n    78\t\n    79\texport function attachHooks(handle: ChartHandle, probe: Probe): void {\n    80\t  if (__DEV__ || (globalThis as { __AXYLO_BENCH__?: unknown }).__AXYLO_BENCH__ === true) {\n    81\t    handle.__bench = {\n    82\t      get revision() {\n    83\t        return probe.revision();\n    84\t      },\n    85\t      ready: () => probe.ready(),\n    86\t      describe() {\n    87\t        const d = probe.shown();\n    88\t        const renderer = probe.renderer();\n    89\t        if (!d) return { xDomain: null, yDomain: null, series: [], renderer };\n    90\t        const out = { ...describe(d.view), renderer };\n    91\t        const view = d.view;\n    92\t        if (view.kind === 'line' && d.layout.kind === 'plot' && d.layout.projection.kind === 'xy') {\n    93\t          // The same selection the scene made (scene/index.ts): the frame's x, the plot, the pixel ratio.\n    94\t          const draw = drawing(view.frame.x.values, d.layout.projection, d.layout.plot, d.pixelRatio > 0 ? d.pixelRatio : 1);\n    95\t          out.series = out.series.map((s, i) => {\n    96\t            const series = view.frame.series[i]!;\n    97\t            if (!view.visible[i]) return { ...s, kept: [] };\n    98\t            const runs = simplifyLine({ ...draw, range: view.drawSlots[i]!, slot: series.slot, y: series.y });\n    99\t            return { ...s, kept: Array.from(runs.indexes, slot => series.row ? series.row[slot]! : slot) };\n   100\t          });\n   101\t        }\n   102\t        return out;\n   103\t      },\n   104\t    };\n   105\t  }\n   106\t  if (__DEV__) {\n   107\t    handle.__dev = {\n   108\t      stages: () => ({ ...probe.stages.counts }),\n   109\t      fail(name) {\n   110\t        probe.stages.failing = name;\n   111\t      },\n   112\t      renderer: probe.renderer(),\n   113\t      retainedRows: () => probe.retainedRows(),\n   114\t    };\n   115\t  }\n   116\t}\n   117\t\n   118\tfunction describe(view: View): Omit<ReturnType<BenchHook['describe']>, 'renderer'> {\n   119\t  if (view.kind === 'donut') {\n   120\t    return { xDomain: null, yDomain: null, series: [] };\n   121\t  }\n   122\t  if (view.kind === 'scatter') {\n   123\t    return {\n   124\t      xDomain: view.xDomain, yDomain: view.yDomain,\n   125\t      series: view.frame.series.map(s => ({\n   126\t        key: s.key, points: s.x.length, oldestX: s.x[0] ?? NaN, newestX: s.x[s.x.length - 1] ?? NaN, missing: 0,\n   127\t      })),\n   128\t    };\n   129\t  }\n   130\t  const { frame } = view;\n   131\t  return {\n   132\t    xDomain: view.xDomain, yDomain: view.yDomain,\n   133\t    series: frame.series.map(s => {\n   134\t      let points = 0;\n   135\t      let missing = 0;\n   136\t      let first = -1;\n   137\t      let last = -1;\n   138\t      for (let i = 0; i < frame.length; i++) {\n   139\t        const state = s.slot[i];\n   140\t        if (state === SLOT_NO_ROW) continue;\n   141\t        points++;\n   142\t        if (first < 0) first = i;\n   143\t        last = i;\n   144\t        if (state !== SLOT_VALUE) missing++;\n   145\t      }\n   146\t      return {\n   147\t        key: s.key, points, missing,\n   148\t        oldestX: first < 0 ? NaN : frame.x.values[first]!, newestX: last < 0 ? NaN : frame.x.values[last]!,\n   149\t      };\n   150\t    }),\n   151\t  };\n   152\t}\n     1\t/**\n     2\t * `createChart`: the browser host of the controller (controller.ts). It resolves the target, builds the\n     3\t * figure, the mark and text renderers and the interaction layer, and connects the page's observers to the\n     4\t * controller. Every setup step registers its own cleanup as soon as it succeeded, so a failure part-way\n     5\t * through creation, or `destroy()`, leaves the target as it was (including the custom properties the theme\n     6\t * wrote on it).\n     7\t *\n     8\t * Document-level listeners (theme and environment watchers, the interaction layer's keyboard and pointer\n     9\t * listeners on the document) are released when the target leaves the document without `destroy()`, so a\n    10\t * forgotten chart does not stay reachable from the page, and are attached again if the target comes back.\n    11\t * Detachment is noticed by the observers the chart already has (the resize observer reports a zero box),\n    12\t * not by polling.\n    13\t */\n    14\timport type { MarkRenderer, Scene } from './contracts';\n    15\timport { canvasRendererWith } from '../render/canvas';\n    16\timport { svgRendererWith } from '../render/svg';\n    17\timport { createTextLayer, type TextLayer } from '../render/text';\n    18\timport { ensureStyles, resolveTheme, watchTheme } from '../theme';\n    19\timport { createFigure, type Figure } from '../dom/figure';\n    20\timport { createInteraction, type Interaction } from '../dom/interaction';\n    21\timport type { DeliveryConsole } from './delivery';\n    22\timport { createMeasurer, noteFontLoad, readTextStyle, resolveLocale, viewerTimeZone, watchEnvironment, watchLanguage } from './environment';\n    23\timport { controllerFor, type ChartHandle, type Controller, type ControllerActions } from './controller';\n    24\timport type { Composition } from './composition';\n    25\timport { object } from './stages';\n    26\t\n    27\texport type { BenchHook, ChartHandle, ChartKind, DevHook, Stage } from './controller';\n    28\t\n    29\texport interface ChartEnvironmentOverrides {\n    30\t  readonly console?: DeliveryConsole | null;\n    31\t}\n    32\t\n    33\t/** Suffixes of the ids a chart gives its elements (figure, interaction, table). */\n    34\tconst ID_SUFFIXES = ['', '-t', '-st', '-s', '-m', '-n', '-i', '-proxy', '-table', '-table-caption', '-table-jump', '-table-jump-error'];\n    35\tlet instances = 0;\n    36\t\n    37\t/** An id prefix none of whose element ids exist in the page yet (spec A1: ids unique per chart). */\n    38\tfunction allocateId(doc: Document): string {\n    39\t  for (;;) {\n    40\t    const id = `axylo-${++instances}`;\n    41\t    if (ID_SUFFIXES.every(suffix => doc.getElementById(id + suffix) === null)) return id;\n    42\t  }\n    43\t}\n    44\t\n    45\texport function createChart(composition: Composition, target: unknown, input: unknown, overrides: ChartEnvironmentOverrides = {}): ChartHandle {\n    46\t  const root = resolveTarget(target);\n    47\t  const doc = root.ownerDocument;\n    48\t  const win = doc.defaultView;\n    49\t  if (win === null) throw new Error('Axylo: the target element is not in a document with a window.');\n    50\t\n    51\t  // Cleanup in reverse order of setup; each step adds its own once it succeeded.\n    52\t  const cleanup: (() => void)[] = [];\n    53\t  const release = (): void => {\n    54\t    for (let fn = cleanup.pop(); fn; fn = cleanup.pop()) {\n    55\t      try {\n    56\t        fn();\n    57\t      } catch {\n    58\t        // Keep releasing the rest.\n    59\t      }\n    60\t    }\n    61\t  };\n    62\t\n    63\t  let controller: Controller | null = null;\n    64\t  try {\n    65\t    const requested = object(input).__renderer === 'canvas' ? 'canvas' : 'svg';\n    66\t    const id = allocateId(doc);\n    67\t\n    68\t    const renderer: MarkRenderer = requested === 'canvas' ? canvasRendererWith(composition.canvas, doc) : svgRendererWith(composition.svg, doc);\n    69\t    cleanup.push(() => renderer.destroy());\n    70\t    const textLayer: TextLayer = createTextLayer(doc);\n    71\t    cleanup.push(() => textLayer.destroy());\n    72\t    const figure: Figure = createFigure(root, id, { marks: renderer.element, text: textLayer.element });\n    73\t    cleanup.push(() => figure.destroy());\n    74\t\n    75\t    // The interaction layer is built before the controller that answers it, so its actions forward late.\n    76\t    const actions: ControllerActions = {\n    77\t      zoom: w => controller?.actions.zoom(w),\n    78\t      toggle: k => controller?.actions.toggle(k),\n    79\t      pause: p => controller?.actions.pause(p),\n    80\t      select: r => controller?.actions.select(r),\n    81\t      hover: r => controller?.actions.hover(r),\n    82\t    };\n    83\t    const interaction: Interaction = createInteraction(composition.interaction, figure, renderer, actions);\n    84\t    cleanup.push(() => interaction.destroy());\n    85\t    const measurer = createMeasurer(doc);\n    86\t    ensureStyles(doc);\n    87\t\n    88\t    // Watchers that the document holds; released while the target is out of the document.\n    89\t    let watching: (() => void) | null = null;\n    90\t    let watchedBefore = false;\n    91\t    const watch = (): void => {\n    92\t      if (watching || controller === null) return;\n    93\t      const c = controller;\n    94\t      if (watchedBefore) c.invalidate.page();\n    95\t      watchedBefore = true;\n    96\t      const stopTheme = watchTheme(root, () => c.invalidate.theme());\n    97\t      const stopEnvironment = watchEnvironment(win, {\n    98\t        pixelRatio: () => c.invalidate.pixelRatio(),\n    99\t        motion() {\n   100\t          // Nothing is animated yet (spec I5), so there is nothing to change.\n   101\t        },\n   102\t        fonts() {\n   103\t          noteFontLoad(doc);\n   104\t          c.invalidate.fonts();\n   105\t        },\n   106\t      });\n   107\t      const stopLanguage = watchLanguage(root, () => c.invalidate.language());\n   108\t      interaction.attach();\n   109\t      watching = () => {\n   110\t        stopTheme();\n   111\t        stopEnvironment();\n   112\t        stopLanguage();\n   113\t        interaction.detach();\n   114\t      };\n   115\t    };\n   116\t    const unwatch = (): void => {\n   117\t      watching?.();\n   118\t      watching = null;\n   119\t    };\n   120\t    cleanup.push(unwatch);\n   121\t\n   122\t    // A font can arrive without a 'loadingdone' (a FontFace loaded first and then added to document.fonts):\n   123\t    // a probe set like the labels changes size whenever their font does, and that is a font load (L1).\n   124\t    const fontProbe = doc.createElement('div');\n   125\t    fontProbe.className = 'axylo-font-probe';\n   126\t    textLayer.element.appendChild(fontProbe);\n   127\t    let probeSize: string | null = null;\n   128\t    const fontObserver = new win.ResizeObserver(() => {\n   129\t      const box = fontProbe.getBoundingClientRect();\n   130\t      const size = `${box.width}x${box.height}`;\n   131\t      if (probeSize !== null && size !== probeSize && controller !== null && root.isConnected) {\n   132\t        noteFontLoad(doc);\n   133\t        controller.invalidate.fonts();\n   134\t      }\n   135\t      probeSize = size;\n   136\t    });\n   137\t    fontObserver.observe(fontProbe);\n   138\t    cleanup.push(() => fontObserver.disconnect());\n   139\t\n   140\t    const resizeObserver = new win.ResizeObserver(() => {\n   141\t      if (controller === null) return;\n   142\t      // A target taken out of the document reports a zero box: let go of the document until it returns.\n   143\t      if (!root.isConnected) {\n   144\t        unwatch();\n   145\t        return;\n   146\t      }\n   147\t      watch();\n   148\t      controller.invalidate.resize();\n   149\t    });\n   150\t    cleanup.push(() => resizeObserver.disconnect());\n   151\t\n   152\t    const timeZone = viewerTimeZone();\n   153\t    controller = controllerFor(composition, input, {\n   154\t      id,\n   155\t      // The author's own id names an untitled chart in diagnostics; the allocated one stays for the DOM.\n   156\t      targetId: root.id || null,\n   157\t      console: overrides.console === undefined ? (win.console as DeliveryConsole) : overrides.console,\n   158\t      page: doc,\n   159\t      timeZone,\n   160\t      renderer: {\n   161\t        kind: renderer.kind,\n   162\t        draw: (scene: Scene, bindings, theme, ratio) => renderer.draw(scene, bindings, theme, ratio),\n   163\t      },\n   164\t      text: textLayer,\n   165\t      figure,\n   166\t      interaction,\n   167\t      measurer,\n   168\t      requestFrame: callback => win.requestAnimationFrame(callback),\n   169\t      cancelFrame: handle => win.cancelAnimationFrame(handle),\n   170\t      locale: option => resolveLocale(option, doc),\n   171\t      pageLang() {\n   172\t        const lang = root.closest('[lang]')?.getAttribute('lang')?.trim();\n   173\t        return lang ? lang : null;\n   174\t      },\n   175\t      labelText(own) {\n   176\t        const el = doc.getElementById(own);\n   177\t        return el === null ? null : el.textContent ?? '';\n   178\t      },\n   179\t      textStyle: () => readTextStyle(textLayer.element),\n   180\t      measure() {\n   181\t        if (!root.isConnected) return null;\n   182\t        const box = figure.figure.getBoundingClientRect();\n   183\t        if (box.width <= 0 && box.height <= 0) return null;\n   184\t        const plot = figure.plot.getBoundingClientRect();\n   185\t        // Layout pixels, which the marks, the text and picking use: a CSS transform on an ancestor scales the\n   186\t        // bounding rect, not the layout (interaction review, part 1 item 12). Below 2% the ratio is the\n   187\t        // integer rounding of offsetWidth, and the fractional rect is kept.\n   188\t        const scaleOf = (rect: number, layout: number) => {\n   189\t          const k = layout > 0 && rect > 0 ? rect / layout : 1;\n   190\t          return Math.abs(k - 1) < 0.02 ? 1 : k;\n   191\t        };\n   192\t        const sx = scaleOf(plot.width, figure.plot.offsetWidth);\n   193\t        const sy = scaleOf(plot.height, figure.plot.offsetHeight);\n   194\t        // When the plot is squeezed to nothing, how far the rest overflows the figure is how much room is\n   195\t        // missing; that keeps the L8 decision continuous below zero.\n   196\t        const overflow = plot.height < 1 ? Math.max(0, figure.figure.scrollHeight - figure.figure.clientHeight) : 0;\n   197\t        const stage = figure.stage.getBoundingClientRect();\n   198\t        return { width: plot.width / sx, height: plot.height / sy - overflow, room: { width: stage.width / sx, height: stage.height / sy } };\n   199\t      },\n   200\t      devicePixelRatio: () => win.devicePixelRatio || 1,\n   201\t      // Scoped to this chart's own figure: properties and the scheme go with it (finding 10).\n   202\t      theme: (keys, colors) => resolveTheme(figure.figure, keys, colors),\n   203\t      surfaces(visible) {\n   204\t        // Hidden without drawing: the error revision does not depend on the methods that may have failed.\n   205\t        for (const el of [renderer.element, textLayer.element]) (el as HTMLElement).style.visibility = visible ? '' : 'hidden';\n   206\t      },\n   207\t      dispose: release,\n   208\t    });\n   209\t    resizeObserver.observe(figure.plot);\n   210\t    resizeObserver.observe(figure.figure);\n   211\t    if (root.isConnected) watch();\n   212\t    return controller.handle;\n   213\t  } catch (error) {\n   214\t    // A rejected strict create, or a failure part-way through: nothing stays behind, a controller that was\n   215\t    // already created (its first frame queued) included (review 3, finding 9).\n   216\t    const created = controller as Controller | null;\n   217\t    controller = null;\n   218\t    try { created?.handle.destroy(); } catch { /* releasing the rest matters more */ }\n   219\t    release();\n   220\t    throw error;\n   221\t  }\n   222\t}\n   223\t\n   224\tfunction resolveTarget(target: unknown): HTMLElement {\n   225\t  if (typeof target === 'string') {\n   226\t    const doc = (globalThis as { document?: Document }).document;\n   227\t    if (!doc) throw new Error(`Axylo: no document to find the target ${JSON.stringify(target)} in.`);\n   228\t    let found: Element | null = null;\n   229\t    try {\n   230\t      found = doc.querySelector(target);\n   231\t    } catch {\n   232\t      throw new Error(`Axylo: the target selector ${JSON.stringify(target)} is not a valid CSS selector.`);\n   