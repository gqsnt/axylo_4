veEventListener;\n   265\t      const name = (t: EventTarget, type: string, fn: unknown) => `${t === document ? 'document' : t === document.fonts ? 'fonts' : t instanceof MediaQueryList ? `mq:${t.media}` : 'other'}|${type}|${String(fn).length}|${(window as unknown as { ids: WeakMap<object, number> }).ids.get(fn as object)}`;\n   266\t      const ids = new WeakMap<object, number>();\n   267\t      (window as unknown as { ids: WeakMap<object, number> }).ids = ids;\n   268\t      let n = 0;\n   269\t      EventTarget.prototype.addEventListener = function (this: EventTarget, type: string, fn: EventListenerOrEventListenerObject | null, o?: boolean | AddEventListenerOptions) {\n   270\t        if (fn && (this === document || this === document.fonts || this instanceof MediaQueryList)) {\n   271\t          if (!ids.has(fn as object)) ids.set(fn as object, ++n);\n   272\t          const entry = name(this, type, fn);\n   273\t          live.add(entry);\n   274\t          // A listener removed by aborting its signal is removed as well.\n   275\t          const signal = typeof o === 'object' ? o.signal : undefined;\n   276\t          signal?.addEventListener('abort', () => live.delete(entry));\n   277\t        }\n   278\t        return add.call(this, type, fn, o);\n   279\t      } as typeof EventTarget.prototype.addEventListener;\n   280\t      EventTarget.prototype.removeEventListener = function (this: EventTarget, type: string, fn: EventListenerOrEventListenerObject | null, o?: boolean | EventListenerOptions) {\n   281\t        if (fn) live.delete(name(this, type, fn));\n   282\t        return remove.call(this, type, fn, o);\n   283\t      } as typeof EventTarget.prototype.removeEventListener;\n   284\t      const observing = new Set<MutationObserver>();\n   285\t      const observe = MutationObserver.prototype.observe;\n   286\t      const disconnect = MutationObserver.prototype.disconnect;\n   287\t      MutationObserver.prototype.observe = function (this: MutationObserver, target: Node, o?: MutationObserverInit) { observing.add(this); return observe.call(this, target, o); };\n   288\t      MutationObserver.prototype.disconnect = function (this: MutationObserver) { observing.delete(this); return disconnect.call(this); };\n   289\t\n   290\t      const el = document.getElementById('chart')!;\n   291\t      const chart = window.Axylo.line!(el, { title: 'D', data: [{ x: 1, y: 1 }, { x: 2, y: 2 }], x: 'x', y: 'y' });\n   292\t      await chart.__bench.ready();\n   293\t      const attached = { listeners: live.size, observers: observing.size };\n   294\t      const parent = el.parentNode!;\n   295\t      const next = el.nextSibling;\n   296\t      el.remove();\n   297\t      await window.nextFrames(3);\n   298\t      const detached = { listeners: live.size, observers: observing.size };\n   299\t      parent.insertBefore(el, next);\n   300\t      await window.nextFrames(3);\n   301\t      const back = { listeners: live.size, observers: observing.size };\n   302\t      // A theme change on the page reaches the chart again.\n   303\t      const draws = chart.__dev.stages().theme;\n   304\t      document.documentElement.setAttribute('data-theme', 'dark');\n   305\t      await window.nextFrames(3);\n   306\t      return { attached, detached, back, themed: chart.__dev.stages().theme > draws };\n   307\t    });\n   308\t    expect(result.attached.listeners).toBeGreaterThan(0);\n   309\t    expect(result.attached.observers).toBeGreaterThan(0);\n   310\t    expect(result.detached).toEqual({ listeners: 0, observers: 0 });\n   311\t    expect(result.back).toEqual(result.attached);\n   312\t    expect(result.themed).toBe(true);\n   313\t    expect(await closePage(page)).toEqual([]);\n   314\t  });\n   315\t\n   316\t  it('a failure part-way through creation leaves the target as it was', async () => {\n   317\t    const page = await chartPage();\n   318\t    const result = await page.evaluate(() => {\n   319\t      const el = document.getElementById('c