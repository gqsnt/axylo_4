{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/src/core/controller.ts | sed -n '1,490p'\"","aggregated_output":"     1\t/**\n     2\t * The chart controller: one implementation behind `line`, `area`, `bar`, `scatter` and `donut`, written\n     3\t * against a `Host` that supplies everything the page provides (animation frames, the figure, the mark and\n     4\t * text renderers, the interaction layer, measurement, theme resolution). The browser host is built in\n     5\t * chart.ts; Node tests supply recording substitutes and a manual frame queue.\n     6\t *\n     7\t * Two phases (plan 1.5). A call (create, update, append, zoom) resolves options, normalizes or prepares\n     8\t * what changed and builds the view synchronously, so `diagnostics` is current when it returns and a `strict`\n     9\t * chart throws from it before anything is accepted: data changes are prepared in the store and committed\n    10\t * only after the candidate view validated. Everything that needs the page runs in the next animation frame,\n    11\t * from the accepted state only, and switches together: no frame mixes two revisions. A revision's rows are\n    12\t * retired only after the frame that replaced it has been drawn, so hover, tooltip, events and `Point.row`\n    13\t * always come from the displayed revision.\n    14\t *\n    15\t * Each frame stage is cached and reruns only when its inputs change (plan 2.2). In development builds the\n    16\t * handle exposes a counter per stage (`__dev.stages()`) so tests can assert what reran.\n    17\t */\n    18\timport {\n    19\t  SLOT_NO_ROW, SLOT_VALUE,\n    20\t  type DatumRef, type DiagnosticInput, type Formatters, type Frame, type Layout, type Lookup, type MarkRenderer,\n    21\t  type PlacedText, type ReaderModel, type ResolvedTheme, type PaintBindings, type Scene, type TextMeasurer,\n    22\t  type TextStyle, type View,\n    23\t} from './contracts';\n    24\timport type { Chart, ChartEvents, Diagnostic, Messages, Point, Title, XValue } from '../public';\n    25\timport {\n    26\t  AlignedStore, DonutStore, normalize, PointStore, resolveOptions,\n    27\t  type AlignedChartType, type ChartType, type PreparedFrame, type ResolvedOptions,\n    28\t} from '../data';\n    29\timport { createDiagnostic, DiagnosticCollector, readerDisclosure, type DiagnosticCode } from '../diagnostics';\n    30\timport { createFormatters, type FormatSpec } from '../format';\n    31\timport { buildView } from '../view';\n    32\timport { computeLayout } from '../layout';\n    33\timport { buildScene } from '../scene';\n    34\timport { drawing } from '../scene/lines';\n    35\timport { simplifyLine } from '../simplify';\n    36\timport { buildLookup } from '../lookup';\n    37\timport { buildReader } from '../reader';\n    38\timport { resolveMessages } from '../messages';\n    39\timport { lowContrastSeries, type ThemeResolution } from '../theme';\n    40\timport { OptionsStore, sameValue, type OptionRecord } from './options';\n    41\timport { Delivery, diagnosticKey, StrictError, strictViolations, type DeliveryConsole } from './delivery';\n    42\timport { layoutInput, layoutKey, sameKey, type AxisContext } from './axes';\n    43\timport { zoomApplies } from './focus';\n    44\timport {\n    45\t  completeViewDiagnostics, dedupe, encodingChanged, isCompact, namingDiagnostics, object, publicOptions, stringOption,\n    46\t  titleOf, toPublic, viewKeyFor, viewStateFor, type Span,\n    47\t} from './stages';\n    48\timport type { FigureModel } from '../dom/figure';\n    49\timport type { Committed, ControlsState } from '../dom/interaction';\n    50\t\n    51\texport type ChartKind = ChartType;\n    52\t\n    53\tconst STAGES = ['options', 'normalize', 'append', 'view', 'frame', 'theme', 'formatters', 'layout', 'scene', 'lookup',\n    54\t  'reader', 'draw', 'text', 'figure'] as const;\n    55\texport type Stage = typeof STAGES[number];\n    56\t\n    57\tconst KIND_NAMES: Record<ChartKind, string> = { line: 'Line', area: 'Area', bar: 'Bar', scatter: 'Scatter', donut: 'Donut' };\n    58\tconst KIND_MESSAGES = { line: 'typeLine', area: 'typeArea', bar: 'typeBar', scatter: 'typeScatter', donut: 'typeDonut' } as const;\n    59\t/** Option resolution reports these about the data; they belong to the call that set the data. */\n    60\tconst DATA_CODES = new Set(['AX100', 'AX101']);\n    61\t\n    62\t/** What the benchmark harness reads (bench/README.md): readiness and what the committed frame shows. */\n    63\texport interface BenchHook {\n    64\t  readonly revision: number;\n    65\t  ready(): Promise<void>;\n    66\t  describe(): {\n    67\t    xDomain: Span | null;\n    68\t    yDomain: Span | null;\n    69\t    series: {\n    70\t      key: string; points: number; oldestX: number; newestX: number; missing: number;\n    71\t      /**\n    72\t       * Line charts: the caller's row indexes of the samples the simplified drawing kept, in drawing order (spec\n    73\t       * F5), so drawn gaps and extremes can be checked index-exactly. Absent for other chart types.\n    74\t       */\n    75\t      kept?: number[];\n    76\t    }[];\n    77\t    /** The mark renderer drawing this chart. */\n    78\t    renderer: 'canvas' | 'svg';\n    79\t  };\n    80\t}\n    81\t\n    82\texport interface DevHook {\n    83\t  stages(): Record<Stage, number>;\n    84\t  /** Makes the named stage throw, to test the internal-error state; null stops it. */\n    85\t  fail(stage: Stage | null): void;\n    86\t  readonly renderer: 'canvas' | 'svg';\n    87\t  /** Rows the streaming store still holds for revisions not yet retired (0 for a static chart). */\n    88\t  retainedRows(): number;\n    89\t}\n    90\t\n    91\texport type ChartHandle = Chart<unknown, Record<string, unknown>> & { __bench?: BenchHook; __dev?: DevHook };\n    92\t\n    93\texport interface Size { readonly width: number; readonly height: number }\n    94\t\n    95\t/** Everything the controller needs from the page. */\n    96\texport interface Host {\n    97\t  readonly id: string;\n    98\t  readonly console: DeliveryConsole | null;\n    99\t  /** The page the once-per-code printing rule applies to. */\n   100\t  readonly page: object;\n   101\t  readonly timeZone: string;\n   102\t  readonly renderer: Pick<MarkRenderer, 'kind' | 'draw'>;\n   103\t  readonly text: { render(texts: readonly PlacedText[]): void };\n   104\t  readonly figure: { update(model: FigureModel): boolean; announce(text: string, lang?: string | null): void };\n   105\t  readonly interaction: { prepare(state: ControlsState): boolean; commit(state: Committed | null): void; clear(): void };\n   106\t  readonly measurer: TextMeasurer;\n   107\t  requestFrame(callback: () => void): number;\n   108\t  cancelFrame(handle: number): void;\n   109\t  locale(option: unknown): string;\n   110\t  pageLang(): string | null;\n   111\t  /** Text of the page element with this id, or null when there is none. */\n   112\t  labelText(id: string): string | null;\n   113\t  textStyle(): TextStyle;\n   114\t  /**\n   115\t   * The plot container's size as the figure lays it out, with what the rest of the figure overflows by\n   116\t   * subtracted from its height (so it can be negative); null when the figure is not laid out at all (hidden\n   117\t   * or detached), which is not the same as a visible figure whose caption left no room.\n   118\t   */\n   119\t  measure(): Size | null;\n   120\t  devicePixelRatio(): number;\n   121\t  theme(seriesKeys: readonly string[], colors: Record<string, string>): ThemeResolution;\n   122\t  /** Called once by destroy, after the controller released its own state. */\n   123\t  dispose(): void;\n   124\t}\n   125\t\n   126\t/** What the page tells the controller (observers, watchers). */\n   127\texport interface Invalidate {\n   128\t  resize(): void;\n   129\t  /** The chart came back into the document: anything about the page may have changed meanwhile. */\n   130\t  page(): void;\n   131\t  theme(): void;\n   132\t  fonts(): void;\n   133\t  pixelRatio(): void;\n   134\t}\n   135\t\n   136\t/** What the interaction layer may ask for; everything goes through the public paths. */\n   137\texport interface ControllerActions {\n   138\t  zoom(window: Span | null): void;\n   139\t  toggle(seriesKey: string): void;\n   140\t  pause(paused: boolean): void;\n   141\t  select(ref: DatumRef): void;\n   142\t  hover(ref: DatumRef | null): void;\n   143\t}\n   144\t\n   145\texport interface Controller {\n   146\t  readonly handle: ChartHandle;\n   147\t  readonly actions: ControllerActions;\n   148\t  readonly invalidate: Invalidate;\n   149\t  /** Runs the pending frame now (tests, and theme changes that arrive inside a frame). */\n   150\t  flush(): void;\n   151\t}\n   152\t\n   153\ttype Store = AlignedStore | PointStore | DonutStore;\n   154\t\n   155\t/** The state a call produced. Only accepted states are drawn. */\n   156\tinterface Accepted {\n   157\t  readonly options: OptionRecord;\n   158\t  /** Options resolved for the latest call (domains, formats, labels). */\n   159\t  readonly resolved: ResolvedOptions;\n   160\t  /** The resolution the current data was normalized with (on the static path it holds the borrowed table). */\n   161\t  readonly source: ResolvedOptions;\n   162\t  /** null until the first append: a static chart keeps the normalized frame over the caller's data. */\n   163\t  readonly store: Store | null;\n   164\t  /** The frame shown (while paused, the store may hold a newer one). */\n   165\t  readonly frame: Frame;\n   166\t  readonly dataDiagnostics: readonly DiagnosticInput[];\n   167\t  /** AX100 and AX101 from the call that set the data; kept while the data and fields stay. */\n   168\t  readonly dataOptions: readonly DiagnosticInput[];\n   169\t  readonly optionDiagnostics: readonly DiagnosticInput[];\n   170\t  readonly viewDiagnostics: readonly DiagnosticInput[];\n   171\t  readonly naming: readonly DiagnosticInput[];\n   172\t  readonly view: View;\n   173\t  readonly viewKey: readonly unknown[];\n   174\t  readonly zoom: Span<XValue> | null;\n   175\t  /** Zoomed to the latest edge: the window follows appended data (plan 1.5). */\n   176\t  readonly follow: boolean;\n   177\t  readonly revision: number;\n   178\t  readonly messages: Messages;\n   179\t  readonly name: string;\n   180\t  /** Series the reader hid with the legend, by key (the view's hidden set). */\n   181\t  readonly hidden: ReadonlySet<string>;\n   182\t}\n   183\t\n   184\ttype Display =\n   185\t  | { readonly kind: 'ready' }\n   186\t  | {\n   187\t    readonly kind: 'loading' | 'error' | 'empty' | 'internal'; readonly text: string;\n   188\t    /** The built-in message shown, or null when the author wrote the text. */\n   189\t    readonly message: keyof Messages | null;\n   190\t  };\n   191\t\n   192\t/** Presentation diagnostics by the stage that found them (spec 3.5: reported when found, never thrown). */\n   193\ttype PresentationStage = 'theme' | 'layout' | 'fit' | 'format' | 'naming' | 'internal';\n   194\t\n   195\t/** An x position as the value the author would write, so a zoom window can be moved by positions. */\n   196\texport function positionValue(frame: Frame, position: number): XValue {\n   197\t  if (frame.shape === 'donut') return position;\n   198\t  const kind = frame.shape === 'points' ? frame.xKind : frame.x.kind;\n   199\t  if (kind === 'time') return new Date(position);\n   200\t  if (kind === 'wall') return new Date(position).toISOString().slice(0, 23);\n   201\t  if (kind === 'category' && frame.shape === 'aligned') return frame.x.categories?.[position] ?? position;\n   202\t  return position;\n   203\t}\n   204\t\n   205\tfunction latestX(frame: Frame): number {\n   206\t  if (frame.shape === 'aligned') return frame.x.values.length ? frame.x.values[frame.x.values.length - 1]! : NaN;\n   207\t  if (frame.shape === 'points') {\n   208\t    let latest = -Infinity;\n   209\t    for (const s of frame.series) if (s.x.length) latest = Math.max(latest, s.x[s.x.length - 1]!);\n   210\t    return latest;\n   211\t  }\n   212\t  return NaN;\n   213\t}\n   214\t\n   215\t/** A window that ends at the latest x and does not show everything follows the data (plan 1.5). */\n   216\tfunction followsLatest(view: View, zoom: Span<XValue> | null): boolean {\n   217\t  if (zoom === null || view.kind === 'donut') return false;\n   218\t  return view.xDomain[1] >= view.xFull[1] && view.xDomain[0] > view.xFull[0];\n   219\t}\n   220\t\n   221\t/** What a destroyed controller holds instead of its host, so a handle kept by the page retains no DOM. */\n   222\tfunction deadHost(from: Host): Host {\n   223\t  const none = (): null => null;\n   224\t  const empty = { width: 0, height: 0 };\n   225\t  return {\n   226\t    id: from.id, console: null, page: {}, timeZone: from.timeZone,\n   227\t    renderer: { kind: from.renderer.kind, draw() {} }, text: { render() {} },\n   228\t    figure: { update: () => false, announce() {} }, interaction: { prepare: () => false, commit() {}, clear() {} },\n   229\t    measurer: { width: () => 0 }, requestFrame: () => 0, cancelFrame() {}, locale: () => 'en', pageLang: none,\n   230\t    labelText: none, textStyle: () => ({ font: '', letterSpacing: 0, wordSpacing: 0, lineHeight: 0 }), measure: () => empty,\n   231\t    devicePixelRatio: () => 1,\n   232\t    theme: () => { throw new Error('Axylo: the chart was destroyed.'); },\n   233\t    dispose() {},\n   234\t  };\n   235\t}\n   236\t\n   237\texport function createController(kind: ChartKind, input: unknown, page: Host): Controller {\n   238\t  let host = page;\n   239\t  const counts = Object.fromEntries(STAGES.map(s => [s, 0])) as Record<Stage, number>;\n   240\t  let failing: Stage | null = null;\n   241\t  const stage = (name: Stage): void => {\n   242\t    counts[name]++;\n   243\t    if (failing === name) throw new Error(`Axylo test hook: forced failure in the ${name} stage.`);\n   244\t  };\n   245\t  let delivery = new Delivery({ console: host.console, development: __DEV__, page: host.page });\n   246\t  const timeZone = host.timeZone;\n   247\t  const environment = { timeZone };\n   248\t\n   249\t  // ── synchronous phase ──────────────────────────────────────────────────────────────────────────\n   250\t\n   251\t  let options = new OptionsStore(input);\n   252\t  let accepted: Accepted | null = null;\n   253\t  const presentation = new Map<PresentationStage, readonly DiagnosticInput[]>();\n   254\t  /** Keys of the current diagnostics already printed and handed to `onDiagnostic`. */\n   255\t  let deliveredKeys = new Set<string>();\n   256\t  /** Increases with every delivery pass; a pass started inside author code supersedes the outer one. */\n   257\t  let deliveryPass = 0;\n   258\t  let destroyed = false;\n   259\t  let internalError: unknown = null;\n   260\t  /** `append` was called at least once: the pause control is offered (spec I6). */\n   261\t  let streaming = false;\n   262\t  let paused = false;\n   263\t  /** While paused: the store's newest frame and its findings, accepted but not shown. */\n   264\t  let held: { frame: Frame; dataDiagnostics: readonly DiagnosticInput[] } | null = null;\n   265\t  /**\n   266\t   * While paused: the caller's rows of the frame on screen, kept here so the store can retire every revision\n   267\t   * older than its newest as rows arrive; `keep` then bounds what a paused stream holds (review 2, finding 5).\n   268\t   */\n   269\t  let frozen: { frame: Frame; rows: Map<number, unknown> } | null = null;\n   270\t  let epochs = 0;\n   271\t  let frameRevision = 0;\n   272\t  let commits = 0;\n   273\t  let listeners = new Map<keyof ChartEvents<unknown>, Set<(payload: never) => void>>();\n   274\t  /** True while a frame runs: findings are delivered at its end, not from inside a stage. */\n   275\t  let inFrame = false;\n   276\t\n   277\t  function chartName(o: OptionRecord): string {\n   278\t    return titleOf(o)?.text ?? host.id;\n   279\t  }\n   280\t\n   281\t  function presentationList(): DiagnosticInput[] {\n   282\t    const out: DiagnosticInput[] = [];\n   283\t    for (const list of presentation.values()) out.push(...list);\n   284\t    return out;\n   285\t  }\n   286\t\n   287\t  function stateDiagnostics(a: Accepted): DiagnosticInput[] {\n   288\t    return [...a.optionDiagnostics, ...a.dataDiagnostics, ...a.viewDiagnostics, ...a.naming];\n   289\t  }\n   290\t\n   291\t  function currentDiagnostics(): Diagnostic[] {\n   292\t    if (!accepted) return [];\n   293\t    return toPublic([...stateDiagnostics(accepted), ...presentationList()], accepted.name);\n   294\t  }\n   295\t\n   296\t  /** Replaces what a presentation stage found; outside a frame the change is delivered at once. */\n   297\t  function setPresentation(where: PresentationStage, list: readonly DiagnosticInput[]): void {\n   298\t    const before = presentation.get(where) ?? [];\n   299\t    if (before.length === 0 && list.length === 0) return;\n   300\t    if (before.length === list.length && before.every((d, i) => diagnosticKey(d) === diagnosticKey(list[i]!))) return;\n   301\t    if (list.length) presentation.set(where, list);\n   302\t    else presentation.delete(where);\n   303\t    if (!inFrame && !destroyed) {\n   304\t      deliverChanges();\n   305\t      // The reader's note may change with it (spec F12).\n   306\t      schedule();\n   307\t    }\n   308\t  }\n   309\t\n   310\t  function addPresentation(where: PresentationStage, d: DiagnosticInput): void {\n   311\t    const list = presentation.get(where) ?? [];\n   312\t    if (list.some(o => o.code === d.code && o.field === d.field)) return;\n   313\t    setPresentation(where, [...list, d]);\n   314\t  }\n   315\t\n   316\t  function formatterFailed(field: string): void {\n   317\t    addPresentation('format', createDiagnostic('AX160', 'changed