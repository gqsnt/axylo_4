ore ? before : after;\n   112\t    const index = fromBefore ? a++ : b++;\n   113\t    x[i] = group.x[index]!;\n   114\t    y[i] = group.y[index]!;\n   115\t    row[i] = group.row?.[index] ?? index;\n   116\t  }\n   117\t  return {\n   118\t    frame: { ...next.frame, series: [{ ...before, x, y, row }] },\n   119\t    positions: dropped ? all.slice(dropped) : all, dropped,\n   120\t  };\n   121\t}\n   122\t\n   123\tfunction extendDonut(frame: DonutFrame, positions: Float64Array, next: Result<DonutFrame>, keep: number | undefined): Extension<DonutFrame> | null {\n   124\t  if (frame.labels.length !== positions.length || next.frame.labels.length !== next.positions.length) return null;\n   125\t  const names = new Set(frame.labels);\n   126\t  const after = next.frame;\n   127\t  if (after.labels.some(label => names.has(label))) return null;\n   128\t  const count = frame.labels.length + after.labels.length;\n   129\t  const dropped = keep === undefined ? 0 : Math.max(0, count - keep);\n   130\t  const length = count - dropped;\n   131\t  const labels = new Array<string>(length);\n   132\t  const values = new Float64Array(length);\n   133\t  const slot = new Uint8Array(length);\n   134\t  const row = new Int32Array(length);\n   135\t  for (let i = 0; i < length; i++) {\n   136\t    const index = dropped + i;\n   137\t    const source = index < frame.labels.length ? frame : after;\n   138\t    const offset = source === frame ? index : index - frame.labels.length;\n   139\t    labels[i] = source.labels[offset]!;\n   140\t    values[i] = source.values[offset]!;\n   141\t    slot[i] = source.slot[offset]!;\n   142\t    row[i] = source.row?.[offset] ?? offset;\n   143\t  }\n   144\t  return {\n   145\t    frame: { ...after, labels, values, slot, row },\n   146\t    positions: Float64Array.from({ length }, (_, i) => i), dropped,\n   147\t  };\n   148\t}\n   149\t\n   150\tfunction removeRows(table: Table, positions: Float64Array, keep: number, first: number, rows: StreamRows