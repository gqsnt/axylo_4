{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc 'for f in stages delivery options; do nl -ba packages/axylo/src/core/$f.ts; done\nnl -ba packages/axylo/src/index.ts'","aggregated_output":"     1\t/**\n     2\t * The DOM-free stages a call runs before anything is drawn (plan 1.5, 1.6): option resolution, the parts of\n     3\t * the options that decide what normalization reads, the view state, and the call-origin diagnostics the\n     4\t * view and the naming rule add. The chart controller and `validate()` both use these, so a server, a test or\n     5\t * a coding agent sees the same findings as a created chart (spec 3.5, DX8).\n     6\t */\n     7\timport type { DiagnosticInput, Frame, View } from './contracts';\n     8\timport type { Diagnostic, Messages, Title, XValue } from '../public';\n     9\timport { normalize, resolveOptions, type ChartType, type ResolvedOptions } from '../data';\n    10\timport { createDiagnostic, DiagnosticCollector, report } from '../diagnostics';\n    11\timport { buildView, type ViewState } from '../view';\n    12\timport { fill, resolveMessages } from '../messages';\n    13\timport { sameValue, INTERNAL_KEYS, type OptionRecord } from './options';\n    14\t\n    15\texport type Span<T = number> = readonly [T, T];\n    16\t\n    17\texport function object(value: unknown): Record<string, unknown> {\n    18\t  return value !== null && typeof value === 'object' ? value as Record<string, unknown> : {};\n    19\t}\n    20\t\n    21\texport function titleOf(options: OptionRecord): { text: string; level: number; visible: boolean } | null {\n    22\t  const raw = options.title;\n    23\t  if (typeof raw === 'string') return raw ? { text: raw, level: 3, visible: true } : null;\n    24\t  const t = object(raw) as Partial<Title>;\n    25\t  if (typeof t.text !== 'string' || t.text === '') return null;\n    26\t  const level = typeof t.level === 'number' && t.level >= 2 && t.level <= 6 ? Math.floor(t.level) : 3;\n    27\t  return { text: t.text, level, visible: t.visible !== false };\n    28\t}\n    29\t\n    30\texport function stringOption(options: OptionRecord, key: string): string | null {\n    31\t  const v = options[key];\n    32\t  return typeof v === 'string' && v !== '' ? v : null;\n    33\t}\n    34\t\n    35\texport function isCompact(kind: ChartType, options: OptionRecord): boolean {\n    36\t  return (kind === 'line' || kind === 'area' || kind === 'bar') && options.compact === true;\n    37\t}\n    38\t\n    39\t/** Options without the controller's own keys (the renderer switch). */\n    40\texport function publicOptions(input: unknown): OptionRecord {\n    41\t  if (input === null || typeof input !== 'object') return {};\n    42\t  const out: Record<string, unknown> = {};\n    43\t  for (const key of Object.keys(input)) if (!INTERNAL_KEYS.includes(key)) out[key] = (input as Record<string, unknown>)[key];\n    44\t  return out;\n    45\t}\n    46\t\n    47\t/** Option keys whose content normalization reads. */\n    48\tconst ENCODING_KEYS = ['x', 'y', 'series', 'label', 'value'] as const;\n    49\t/** Parts of a field spec that only the view, layout or formatting read: changing them never renormalizes. */\n    50\tconst PRESENTATION_PARTS = new Set(['domain', 'format', 'tickFormat']);\n    51\t\n    52\tfunction fieldEncoding(spec: unknown): unknown {\n    53\t  if (Array.isArray(spec)) return spec.map(fieldEncoding);\n    54\t  // 'day' and { field: 'day' } read the same field.\n    55\t  if (typeof spec === 'string') return { field: spec };\n    56\t  if (spec === null || typeof spec !== 'object') return spec;\n    57\t  const out: Record<string, unknown> = {};\n    58\t  for (const key of Object.keys(spec)) if (!PRESENTATION_PARTS.has(key)) out[key] = (spec as Record<string, unknown>)[key];\n    59\t  return out;\n    60\t}\n    61\t\n    62\t/** True when the field specs differ in something normalization reads (plan 2.2: author domains belong to the view). */\n    63\texport function encodingChanged(before: OptionRecord, after: OptionRecord): boolean {\n    64\t  return ENCODING_KEYS.some(key => !sameValue(fieldEncoding(before[key]), fieldEncoding(after[key])));\n    65\t}\n    66\t\n    67\texport function viewStateFor(\n    68\t  kind: ChartType, options: OptionRecord, resolved: ResolvedOptions, zoom: Span<XValue> | null,\n    69\t  previous: View | null, hidden: ReadonlySet<string>, messages: Messages,\n    70\t): ViewState {\n    71\t  if (kind === 'donut') return { kind, otherLabel: count => fill(messages.otherSlices, { count }), previous };\n    72\t  const value = resolved.values[0];\n    73\t  const common = {\n    74\t    hidden, zoom, xField: resolved.x, xDomain: resolved.x.domain, valueDomain: value?.domain ?? null,\n    75\t    valueField: value?.field, references: Array.isArray(options.reference) ? options.reference as never : [], previous,\n    76\t  };\n    77\t  if (kind === 'scatter') return { ...common, kind };\n    78\t  return {\n    79\t    ...common, kind,\n    80\t    stacked: kind === 'area' ? options.stacked === true : kind === 'bar' ? options.layout === 'stacked' : false,\n    81\t    horizontal: kind === 'bar' && options.horizontal === true,\n    82\t    compact: isCompact(kind, options),\n    83\t  };\n    84\t}\n    85\t\n    86\t/** What the view depends on; equal keys mean the previous view is still right. */\n    87\texport function viewKeyFor(\n    88\t  kind: ChartType, options: OptionRecord, resolved: ResolvedOptions, frame: Frame, zoom: Span<XValue> | null,\n    89\t  hidden: ReadonlySet<string>, messages: Messages,\n    90\t): readonly unknown[] {\n    91\t  return [frame, zoom, [...hidden].sort().join('\\u0000'), resolved.x.domain, resolved.values[0]?.domain, options.reference,\n    92\t    options.stacked, options.layout, options.horizontal, options.compact, kind === 'donut' ? messages.otherSlices : null];\n    93\t}\n    94\t\n    95\t/**\n    96\t * The view reports AX110, AX130 and AX131 only when they are new against the previous view it reuses. The\n    97\t * chart keeps the complete set: a finding the previous view had is kept while its condition still holds.\n    98\t */\n    99\texport function completeViewDiagnostics(\n   100\t  kind: ChartType, found: readonly DiagnosticInput[], before: readonly DiagnosticInput[], view: View, state: ViewState,\n   101\t): DiagnosticInput[] {\n   102\t  const out = [...found];\n   103\t  if (view.kind === 'donut') return out;\n   104\t  const has = (code: string) => out.some(d => d.code === code);\n   105\t  const series = view.frame.series.length;\n   106\t  const domain = 'valueDomain' in state ? state.valueDomain : null;\n   107\t  const stillHolds: Record<string, boolean> = {\n   108\t    AX130: series > 8,\n   109\t    AX131: view.compact && series > 1,\n   110\t    AX110: (kind === 'bar' || kind === 'area') && domain !== null && domain !== undefined &&\n   111\t      domain.every(Number.isFinite) && (Math.min(domain[0], domain[1]) > 0 || Math.max(domain[0], domain[1]) < 0),\n   112\t  };\n   113\t  for (const d of before) {\n   114\t    if (stillHolds[d.code] && !has(d.code)) out.push(d);\n   115\t  }\n   116\t  return out;\n   117\t}\n   118\t\n   119\t/** AX140 (spec A1): no title and no `labelledBy`. A `labelledBy` that names nothing is checked when drawn. */\n   120\texport function namingDiagnostics(options: OptionRecord): DiagnosticInput[] {\n   121\t  if (titleOf(options) !== null || stringOption(options, 'labelledBy') !== null) return [];\n   122\t  const sink = new DiagnosticCollector();\n   123\t  report(sink, 'AX140', 'none');\n   124\t  return [...sink.inputs()];\n   125\t}\n   126\t\n   127\t/** resolveOptions reports AX100 and AX101; normalization may report them again. Keep one copy. */\n   128\texport function dedupe(options: readonly DiagnosticInput[], data: readonly DiagnosticInput[]): DiagnosticInput[] {\n   129\t  return options.filter(o => !data.some(d => d.code === o.code && d.field === o.field));\n   130\t}\n   131\t\n   132\texport function toPublic(inputs: readonly DiagnosticInput[], chart: string): Diagnostic[] {\n   133\t  return inputs.map(({ effect: _e, origin: _o, ...d }) => ({ ...d, chart }));\n   134\t}\n   135\t\n   136\t/**\n   137\t * Everything a create call validates without a DOM, in the order the chart lists it: options, data, view,\n   138\t * naming. `validate()` returns this; a created chart reports the same call-origin findings.\n   139\t */\n   140\texport function staticDiagnostics(kind: ChartType, input: unknown, timeZone: string): Diagnostic[] {\n   141\t  const options = publicOptions(input);\n   142\t  const optionSink = new DiagnosticCollector();\n   143\t  const dataSink = new DiagnosticCollector();\n   144\t  let name: string = kind;\n   145\t  try {\n   146\t    const resolved = resolveOptions(kind, options, optionSink);\n   147\t    name = resolved.name;\n   148\t    const frame = normalize(kind, resolved, { timeZone }, dataSink, { epoch: 1, revision: 1 });\n   149\t    const viewSink = new DiagnosticCollector();\n   150\t    const messages = resolveMessages(object(options.messages));\n   151\t    const state = viewStateFor(kind, options, resolved, null, null, new Set(), messages);\n   152\t    buildView(frame as never, state as never, viewSink);\n   153\t    const data = dataSink.inputs();\n   154\t    return toPublic([...dedupe(optionSink.inputs(), data), ...data, ...viewSink.inputs(), ...namingDiagnostics(options)], name);\n   155\t  } catch {\n   156\t    // Options so malformed that resolution itself fails: say so rather than throw from validate.\n   157\t    const fallback = new DiagnosticCollector();\n   158\t    report(fallback, 'AX150', 'chart-error', { detail: 'Supply readable options and data.' });\n   159\t    return toPublic([...optionSink.inputs(), ...fallback.inputs(), ...namingDiagnostics(options)], name);\n   160\t  }\n   161\t}\n   162\t\n   163\texport { createDiagnostic };\n     1\t/**\n     2\t * Diagnostic delivery (spec 3.5): what is printed, what reaches `onDiagnostic`, and what `strict` throws.\n     3\t *\n     4\t * Errors and warnings print with `console.warn` once per code per page in every build; hints print with\n     5\t * `console.info`, also once per code per page, and only in development builds. `onDiagnostic` receives every\n     6\t * diagnostic a chart newly finds. `strict` throws on errors and warnings found while validating a call\n     7\t * (origin 'call'); diagnostics found later (origin 'presentation') are reported and never thrown.\n     8\t */\n     9\timport type { DiagnosticInput } from './contracts';\n    10\timport type { Diagnostic } from '../public';\n    11\t\n    12\texport interface DeliveryConsole {\n    13\t  warn(...args: unknown[]): void;\n    14\t  info(...args: unknown[]): void;\n    15\t  error(...args: unknown[]): void;\n    16\t}\n    17\t\n    18\t/** Codes already printed, per page. The key is the document in a browser, any object in tests. */\n    19\tconst printed = new WeakMap<object, Set<string>>();\n    20\tconst fallbackPage = {};\n    21\t\n    22\texport interface DeliveryOptions {\n    23\t  readonly console: DeliveryConsole | null;\n    24\t  readonly development: boolean;\n    25\t  /** The page the once-per-code rule applies to. */\n    26\t  readonly page: object | null;\n    27\t}\n    28\t\n    29\texport type DiagnosticListener = (diagnostic: Diagnostic) => void;\n    30\t\n    31\texport function format(d: Diagnostic): string {\n    32\t  return `[axylo ${d.code}] ${JSON.stringify(d.chart)}: ${d.message}`;\n    33\t}\n    34\t\n    35\t/** Identity of a diagnostic for \"is this one new\": the same finding found again is not delivered twice. */\n    36\texport function diagnosticKey(d: Pick<Diagnostic, 'code' | 'field' | 'message'>): string {\n    37\t  return `${d.code}\\u0000${d.field ?? ''}\\u0000${d.message}`;\n    38\t}\n    39\t\n    40\texport class Delivery {\n    41\t  private listenerFailed = false;\n    42\t\n    43\t  constructor(private readonly options: DeliveryOptions) {}\n    44\t\n    45\t  /**\n    46\t   * Prints and hands to the listener the diagnostics in `found` that are not in `before`. The listener is\n    47\t   * author code: after each call `alive` says whether to go on (the chart may have been destroyed or have\n    48\t   * moved to a new state that delivers its own findings).\n    49\t   */\n    50\t  deliver(\n    51\t    found: readonly Diagnostic[], before: readonly Diagnostic[] | ReadonlySet<string>, listener: DiagnosticListener | null,\n    52\t    alive: () => boolean = () => true,\n    53\t  ): void {\n    54\t    const known = new Set(before instanceof Set ? before : (before as readonly Diagnostic[]).map(diagnosticKey));\n    55\t    for (const d of found) {\n    56\t      if (!alive()) return;\n    57\t      if (known.has(diagnosticKey(d))) continue;\n    58\t      known.add(diagnosticKey(d));\n    59\t      this.print(d);\n    60\t      if (listener) this.notify(listener, d);\n    61\t    }\n    62\t  }\n    63\t\n    64\t  print(d: Diagnostic): void {\n    65\t    const out = this.options.console;\n    66\t    if (!out) return;\n    67\t    if (d.level === 'hint' && !this.options.development) return;\n    68\t    const page = this.options.page ?? fallbackPage;\n    69\t    let codes = printed.get(page);\n    70\t    if (!codes) printed.set(page, codes = new Set());\n    71\t    if (codes.has(d.code)) return;\n    72\t    codes.add(d.code);\n    73\t    if (d.level === 'hint') out.info(format(d));\n    74\t    else out.warn(format(d));\n    75\t  }\n    76\t\n    77\t  /** An internal failure: the chart shows its internal-error state; this says why. Not a registry code. */\n    78\t  internal(chart: string, error: unknown): void {\n    79\t    this.options.console?.error(`[axylo] ${JSON.stringify(chart)}: internal error while drawing the chart.`, error);\n    80\t  }\n    81\t\n    82\t  /** Hands one diagnostic to the author's listener; a listener that throws is reported once and ignored. */\n    83\t  notify(listener: DiagnosticListener, d: Diagnostic): void {\n    84\t    try {\n    85\t      listener(d);\n    86\t    } catch (error) {\n    87\t      // An author's handler that throws must not break the chart; say so once.\n    88\t      if (!this.listenerFailed) this.options.console?.error('[axylo] onDiagnostic threw:', error);\n    89\t      this.listenerFailed = true;\n    90\t    }\n    91\t  }\n    92\t}\n    93\t\n    94\t/** The diagnostics `strict` throws on: errors and warnings found while validating the call. */\n    95\texport function strictViolations(inputs: readonly DiagnosticInput[]): DiagnosticInput[] {\n    96\t  return inputs.filter(d => d.origin === 'call' && (d.level === 'error' || d.level === 'warning'));\n    97\t}\n    98\t\n    99\t/** The error a strict chart throws. It carries every diagnostic of the rejected call. */\n   100\texport class StrictError extends Error {\n   101\t  readonly diagnostics: readonly Diagnostic[];\n   102\t\n   103\t  constructor(chart: string, diagnostics: readonly Diagnostic[]) {\n   104\t    const first = diagnostics.find(d => d.level !== 'hint') ?? diagnostics[0];\n   105\t    super(first\n   106\t      ? `${format(first)}${diagnostics.length > 1 ? ` (and ${diagnostics.length - 1} more)` : ''}`\n   107\t      : `[axylo] ${JSON.stringify(chart)}: rejected by strict mode.`);\n   108\t    this.name = 'AxyloStrictError';\n   109\t    this.diagnostics = diagnostics;\n   110\t  }\n   111\t}\n     1\t/**\n     2\t * The options a chart currently holds, and the patch rule of the commit contract (plan 1.5): a key present in\n     3\t * a patch replaces the old value whole, a key set to `undefined` returns to its default (it is removed, and\n     4\t * resolution supplies the default), and absent keys stay. No deep merging.\n     5\t */\n     6\t\n     7\texport type OptionRecord = Readonly<Record<string, unknown>>;\n     8\t\n     9\t/** Keys the controller reads itself and never passes to option resolution. */\n    10\texport const INTERNAL_KEYS: readonly string[] = ['__renderer'];\n    11\t\n    12\texport interface Patched {\n    13\t  readonly next: OptionRecord;\n    14\t  /** Keys whose value is no longer the same object or primitive. */\n    15\t  readonly changed: ReadonlySet<string>;\n    16\t}\n    17\t\n    18\t/** Applies a patch to `current` without changing it. */\n    19\texport function applyPatch(current: OptionRecord, patch: unknown): Patched {\n    20\t  const next: Record<string, unknown> = { ...current };\n    21\t  const changed = new Set<string>();\n    22\t  if (patch === null || typeof patch !== 'object') return { next, changed };\n    23\t  for (const key of Object.keys(patch)) {\n    24\t    if (INTERNAL_KEYS.includes(key)) continue;\n    25\t    const value = (patch as Record<string, unknown>)[key];\n    26\t    const had = Object.hasOwn(current, key);\n    27\t    if (value === undefined) {\n    28\t      if (had) {\n    29\t        delete next[key];\n    30\t        changed.add(key);\n    31\t      }\n    32\t      continue;\n    33\t    }\n    34\t    if (!had || !Object.is(current[key], value)) changed.add(key);\n    35\t    next[key] = value;\n    36\t  }\n    37\t  return { next, changed };\n    38\t}\n    39\t\n    40\t/** Holds the accepted options. A rejected call never reaches `commit`, so the store stays on the last valid state. */\n    41\texport class OptionsStore {\n    42\t  private value: OptionRecord;\n    43\t\n    44\t  constructor(initial: unknown) {\n    45\t    this.value = applyPatch({}, initial).next;\n    46\t  }\n    47\t\n    48\t  get current(): OptionRecord {\n    49\t    return this.value;\n    50\t  }\n    51\t\n    52\t  /** What `patch` would give, without accepting it. */\n    53\t  preview(patch: unknown): Patched {\n    54\t    return applyPatch(this.value, patch);\n    55\t  }\n    56\t\n    57\t  commit(next: OptionRecord): void {\n    58\t    this.value = next;\n    59\t  }\n    60\t}\n    61\t\n    62\t/**\n    63\t * Structural equality for option values that describe encoding (field specs, domains, references): plain\n    64\t * objects and arrays by content, functions and everything else by identity. Data is never compared this way.\n    65\t */\n    66\texport function sameValue(a: unknown, b: unknown): boolean {\n    67\t  if (Object.is(a, b)) return true;\n    68\t  if (a instanceof Date && b instanceof Date) return a.getTime() === b.getTime();\n    69\t  if (Array.isArray(a) && Array.isArray(b)) {\n    70\t    return a.length === b.length && a.every((item, i) => sameValue(item, b[i]));\n    71\t  }\n    72\t  if (isPlain(a) && isPlain(b)) {\n    73\t    const keys = Object.keys(a);\n    74\t    if (keys.length !== Object.keys(b).length) return false;\n    75\t    return keys.every(key => Object.hasOwn(b, key) && sameValue(a[key], b[key]));\n    76\t  }\n    77\t  return false;\n    78\t}\n    79\t\n    80\tfunction isPlain(value: unknown): value is Record<string, unknown> {\n    81\t  if (value === null || typeof value !== 'object') return false;\n    82\t  const proto = Object.getPrototypeOf(value) as unknown;\n    83\t  return proto === Object.prototype || proto === null;\n    84\t}\n     1\t/**\n     2\t * Axylo's public entry points. Importing this module touches no DOM, so it loads in Node, where `validate`\n     3\t * runs; the chart functions need a document and are only called in a browser.\n     4\t */\n     5\timport type {\n     6\t  AreaOptions, BarOptions, Chart, Diagnostic, DonutOptions, LineOptions, ScatterOptions, Target,\n     7\t} from './public';\n     8\timport { createChart } from './core/chart';\n     9\timport { staticDiagnostics } from './core/stages';\n    10\timport { viewerTimeZone } from './core/environment';\n    11\t\n    12\texport type * from './public';\n    13\t\n    14\texport function line<Row>(target: Target,