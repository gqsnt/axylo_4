{"type":"item.completed","item":{"id":"item_19","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/public.ts'","aggregated_output":"     1\t/**\n     2\t * Public types of Axylo. The functions that use them are exported from index.ts.\n     3\t * Source of truth for the public API; docs/api/axylo.d.ts is the reviewed sketch this file started from.\n     4\t */\n     5\t\n     6\t// ---------- data ----------\n     7\t\n     8\t/** Rows as an API returns them, or typed columns for large data. Both describe the same logical table. */\n     9\texport type Data<Row> = readonly Row[] | { readonly columns: { readonly [K in keyof Row]: ArrayLike<Row[K]> } };\n    10\t\n    11\ttype Key<Row> = Extract<keyof Row, string>;\n    12\ttype KeysWhere<Row, V> = { [K in Key<Row>]: [Row[K]] extends [V] ? K : never }[Key<Row>];\n    13\t\n    14\t/** A field that can sit on a value axis as it is. */\n    15\texport type NumberKey<Row> = KeysWhere<Row, number | null | undefined>;\n    16\t/** A field of numeric strings (Postgres bigint and numeric, BigQuery): allowed only with `parse: 'number'`. */\n    17\texport type StringKey<Row> = KeysWhere<Row, string | null | undefined>;\n    18\t/** A field that can sit on an x axis: numbers, instants, calendar dates or categories. */\n    19\texport type XKey<Row> = KeysWhere<Row, number | string | Date | null | undefined>;\n    20\t/** A field that names a series. */\n    21\texport type SeriesKey<Row> = KeysWhere<Row, string | number | boolean>;\n    22\t\n    23\texport type XValue = number | string | Date;\n    24\t\n    25\t// ---------- fields ----------\n    26\t\n    27\tinterface FieldCommon {\n    28\t  /** Axis title and the name used in tooltip, table and announcements. */\n    29\t  label?: string;\n    30\t  /** Unit appended to values in tooltip, table and announcements: 'ms', 'USD', … */\n    31\t  unit?: string;\n    32\t}\n    33\t\n    34\texport interface ValueFieldOptions extends FieldCommon {\n    35\t  /** Declares percentage data and its convention: 'percent' = 0–100, 'ratio' = 0–1. Never inferred from the label. */\n    36\t  scale?: 'percent' | 'ratio';\n    37\t  /** How values are written in tooltip, table and announcements. Default: locale grouping, up to 6 significant fraction digits. */\n    38\t  format?: Intl.NumberFormatOptions | ((value: number) => string);\n    39\t  /** How axis ticks are written. Default: compact when it saves space. */\n    40\t  tickFormat?: Intl.NumberFormatOptions | ((value: number) => string);\n    41\t  /** What a missing value means. 'gap' (default) draws nothing; 'zero' is for counts where absence means none. */\n    42\t  missing?: 'gap' | 'zero';\n    43\t  /** Author bounds. On bar and area the domain is widened to include zero and AX110 is raised if it did not. */\n    44\t  domain?: readonly [number, number];\n    45\t}\n    46\t\n    47\texport type ValueField<Row> =\n    48\t  | NumberKey<Row>\n    49\t  | ({ field: NumberKey<Row>; parse?: never } & ValueFieldOptions)\n    50\t  | ({ field: StringKey<Row>; parse: 'number' } & ValueFieldOptions);\n    51\t\n    52\texport interface XFieldOptions extends FieldCommon {\n    53\t  /**\n    54\t   * 'date': calendar dates ('2026-02-24'); read the same in every time zone.\n    55\t   * 'time': instants (epoch milliseconds, Date objects, ISO strings with an offset); shown in `timeZone`.\n    56\t   * 'number' and 'category' as named. Inferred when omitted, except that numbers are never inferred to be instants.\n    57\t   */\n    58\t  type?: 'number' | 'time' | 'date' | 'category';\n    59\t  /** Category axes only: the categories have a natural order (months, age bands), so labels may be thinned when they do not fit. */\n    60\t  ordered?: boolean;\n    61\t  /** For instants only. Default 'local' (the viewer's zone). */\n    62\t  timeZone?: 'local' | 'UTC' | (string & {});\n    63\t  format?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n    64\t  tickFormat?: Intl.DateTimeFormatOptions | Intl.NumberFormatOptions | ((value: XValue) => string);\n    65\t  domain?: readonly [XValue, XValue];\n    66\t}\n    67\t\n    68\texport type XField<Row> = XKey<Row> | ({ field: XKey<Row> } & XFieldOptions);\n    69\t\n    70\t/** Long form: one row per (x, series). Wide form: one row per x, one column per series. Never both. */\n    71\texport type Encoding<Row> =\n    72\t  | { x: XField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> }\n    73\t  | { x: XField<Row>; y: readonly ValueField<Row>[]; series?: never };\n    74\t\n    75\t// ---------- options ----------\n    76\t\n    77\texport interface Title { text: string; visible?: boolean; level?: 2 | 3 | 4 | 5 | 6 }\n    78\t\n    79\texport interface CommonOptions<Row> {\n    80\t  data: Data<Row>;\n    81\t  /** Visible heading and accessible name. */\n    82\t  title?: string | Title;\n    83\t  /** Id of an existing heading that names the chart, for dashboard cards that already show a title. */\n    84\t  labelledBy?: string;\n    85\t  subtitle?: string;\n    86\t  /** Added to the generated summary. Mandatory disclosures (time zone, omitted values) are kept. */\n    87\t  description?: string;\n    88\t  state?: 'ready' | 'loading' | { error: string } | { empty: string };\n    89\t  legend?: 'auto' | false | 'top' | 'right' | 'bottom';\n    90\t  tooltip?: boolean;\n    91\t  /** \"View as table\" control. Default true. */\n    92\t  table?: boolean;\n    93\t  /** Fixed color per series name, so \"Direct\" is the same color on every chart: { Direct: 'var(--brand-1)' }. */\n    94\t  colors?: Readonly<Record<string, string>>;\n    95\t  /** Overrides for built-in text (\"View as table\", \"No data\", …). */\n    96\t  messages?: Partial<Messages>;\n    97\t  /** Default: the document language. */\n    98\t  locale?: string;\n    99\t  /** Throw on any warning or error diagnostic, synchronously from the call that caused it. */\n   100\t  strict?: boolean;\n   101\t  onDiagnostic?: (diagnostic: Diagnostic) => void;\n   102\t}\n   103\t\n   104\texport interface Reference {\n   105\t  x?: XValue | readonly [XValue, XValue];\n   106\t  y?: number | readonly [number, number];\n   107\t  label: string;\n   108\t}\n   109\t\n   110\texport interface CartesianOptions {\n   111\t  /** Default true on time, date and number x axes. 'touch' also captures pinch and two-finger drag on touch screens. */\n   112\t  zoom?: boolean | 'touch';\n   113\t  reference?: readonly Reference[];\n   114\t}\n   115\t\n   116\t/** Line, area and bar only. Marks only, as a static image with a text alternative: no axes, legend, toolbar, table, zoom or tooltip. */\n   117\texport interface CompactOption { compact?: boolean }\n   118\t\n   119\texport type LineOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row>;\n   120\texport type AreaOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { stacked?: boolean };\n   121\texport type BarOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { layout?: 'grouped' | 'stacked'; horizontal?: boolean };\n   122\t/** Scatter relates two measures: its x is a number, an instant or a date, never a category. */\n   123\texport type ScatterXField<Row> = XKey<Row> | ({ field: XKey<Row>; type?: 'number' | 'time' | 'date'; ordered?: never } & Omit<XFieldOptions, 'type' | 'ordered'>);\n   124\texport type ScatterOptions<Row> = CommonOptions<Row> & CartesianOptions & { x: ScatterXField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> };\n   125\texport type DonutOptions<Row> = CommonOptions<Row> & { label: SeriesKey<Row>; value: ValueField<Row> };\n   126\t\n   127\t// ---------- handle ----------\n   128\t\n   129\texport interface Point<Row> { series: string; x: XValue; y: number | null; row: Row | null; index: number }\n   130\t\n   131\texport interface ChartEvents<Row> {\n   132\t  hover: Point<Row> | null;\n   133\t  select: Point<Row>;\n   134\t  zoom: readonly [XValue, XValue] | null;\n   135\t}\n   136\t\n   137\texport interface Chart<Row, Options> {\n   138\t  /**\n   139\t   * Changes options. Keys present replace the old value; a key set to `undefined` returns to its default; absent keys stay.\n   140\t   * Validation and diagnostics are synchronous (a `strict` chart throws here and keeps its last valid state); drawing happens on the next frame.\n   141\t   */\n   142\t  update(patch: Partial<Options>): void;\n   143\t  /** Adds rows at the end. `keep` = number of distinct x values retained; older ones are dropped. */\n   144\t  append(rows: readonly Row[], options?: { keep?: number }): void;\n   145\t  /** Sets the visible x range; `null` shows everything. */\n   146\t  zoom(domain: readonly [XValue, XValue] | null): void;\n   147\t  on<E extends keyof ChartEvents<Row>>(event: E, listener: (payload: ChartEvents<Row>[E]) => void): () => void;\n   148\t  /** Diagnostics for the current options and data. Up to date as soon as create, update or append returns. */\n   149\t  readonly diagnostics: readonly Diagnostic[];\n   150\t  destroy(): void;\n   151\t}\n   152\t\n   153\texport type Target = string | HTMLElement;\n   154\t\n   155\t\n   156\t\n   157\t\n   158\t\n   159\t\n   160\t\n   161\t// ---------- diagnostics ----------\n   162\t\n   163\texport interface Diagnostic {\n   164\t  /** Stable and documented, one page per code. */\n   165\t  code: `AX${number}`;\n   166\t  level: 'error' | 'warning' | 'hint';\n   167\t  /** What is wrong, where, and how to fix it. */\n   168\t  message: string;\n   169\t  /** The chart it came from: its title, else its element id. */\n   170\t  chart: string;\n   171\t  /** Where applicable. A diagnostic about the chart as a whole (no title, low contrast) has neither. */\n   172\t  field?: string;\n   173\t  /** First offending row indexes in the caller's own data, capped at 10. */\n   174\t  rows?: readonly number[];\n   175\t  count?: number;\n   176\t}\n   177\t\n   178\t/** Runs normalization and validation only. Works without a DOM, so a server or an agent can check options before rendering. */\n   179\t\n   180\t/** Built-in text. Templates use {name} placeholders. Every entry can be replaced through `messages` (spec A10). */\n   181\texport interface Messages {\n   182\t  viewAsTable: string; hideTable: string;\n   183\t  noData: string; noObservation: string; incompleteStack: string;\n   184\t  moreRows: string; otherSlices: string;\n   185\t  valuesNotShown: string; valuesChanged: string; labelsHidden: string;\n   186\t  loading: string; empty: string; error: string; internalError: string;\n   187\t  chartName: string; chartSummary: string; seriesSummary: string; referenceSummary: string; timeZoneNote: string;\n   188\t  plotLabel: string; controlsLabel: string; pointOf: string;\n   189\t  zoomIn: string; zoomOut: string; resetZoom: string; pause: string; resume: string;\n   190\t  previousPage: string; nextPage: string; pageOf: string; jumpToX: string;\n   191\t  showSeries: string; hideSeries: string;\n   192\t  /** Column headers and nouns. */\n   193\t  category: string; percentage: string; series: string; value: string;\n   194\t  /** Chart type names used in generated names and summaries. */\n   195\t  typeLine: string; typeArea: string; typeBar: string; typeScatter: string; typeDonut: string;\n   196\t  /** Summary sentences that have no cartesian form. */\n   197\t  donutSummary: string; seriesNoData: string; seriesNotDrawn: string; referenceLine: string; referenceBand: string;\n   198\t  /** What the keyboard proxy says it is (\"{type} chart\") and how it reads a position. */\n   199\t  plotRole: string; pointAll: string; seriesValue: string; position: string;\n   200\t  /** Label of the stack total in tooltips. */\n   201\t  total: string;\n   202\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/core/contracts.ts'","aggregated_output":"     1\t/**\n     2\t * Internal contracts of Axylo. Every module is written against these types and against nothing else in\n     3\t * another module. Changing this file is an architecture change: it needs a reason recorded in the commit.\n     4\t *\n     5\t * Pipeline (docs/03-plan-typescript-release.md, section 2):\n     6\t *\n     7\t *   options ─► normalize ─► Frame ─┬─► View ─► Layout ─► Scene ─► MarkRenderer / TextLayer\n     8\t *                │ diagnostics      ├─► lookup (exact values)\n     9\t *                                   ├─► summary, table\n    10\t *                                   └─► focus model\n    11\t *\n    12\t * Rule that must never be broken: exact values, the table, keyboard navigation, tooltips, summaries and\n    13\t * events read the Frame. The Scene is geometry for drawing and may be simplified. Nothing reads values\n    14\t * back from the Scene.\n    15\t */\n    16\timport type { Diagnostic, XValue } from '../public';\n    17\t\n    18\t// ───────────────────────────── diagnostics ─────────────────────────────\n    19\t\n    20\t/**\n    21\t * What a diagnostic did to the chart. Drives the reader's note (spec F12): only 'omitted' and 'changed'\n    22\t * count towards \"N values not shown\"; a warning about contrast or an unknown option does not.\n    23\t */\n    24\texport type DiagnosticEffect = 'none' | 'omitted' | 'changed' | 'series-disabled' | 'chart-error';\n    25\t\n    26\t/** A diagnostic before the chart adds its own name. */\n    27\texport type DiagnosticInput = Omit<Diagnostic, 'chart'> & {\n    28\t  readonly effect: DiagnosticEffect;\n    29\t  /**\n    30\t   * 'call': found while validating a create, update or append call; a `strict` chart throws from that call.\n    31\t   * 'presentation': found later (a contrast check after a CSS change, a formatter that throws on a lazily\n    32\t   * built table cell, a label that no longer fits after a resize); reported when found, never thrown.\n    33\t   */\n    34\t  readonly origin: 'call' | 'presentation';\n    35\t};\n    36\t\n    37\texport interface DiagnosticSink {\n    38\t  /** Adds one diagnostic. The sink merges by code, field and effect: counts are added, example rows capped at 10. */\n    39\t  add(d: DiagnosticInput): void;\n    40\t}\n    41\t\n    42\t// ───────────────────────────── frame ─────────────────────────────\n    43\t\n    44\t/**\n    45\t * What an x value is.\n    46\t *  number   – a plain measure.\n    47\t *  time     – an instant. Position = epoch milliseconds (UTC). Shown in `XColumn.timeZone`.\n    48\t *  date     – a calendar date, month or year. Position = epoch milliseconds of that date at 00:00 UTC;\n    49\t *             always formatted in UTC, so it reads the same in every viewer zone.\n    50\t *  wall     – a date-time written without an offset. Position = the written fields read as if UTC;\n    51\t *             always formatted in UTC (\"shown as written\").\n    52\t *  category – a name. Position = index in first-seen order (bar, line) or given order (donut).\n    53\t */\n    54\texport type XKind = 'number' | 'time' | 'date' | 'wall' | 'category';\n    55\t\n    56\t/** State of one slot of an aligned series. */\n    57\texport const SLOT_VALUE = 0;         // a finite number\n    58\texport const SLOT_NULL = 1;          // explicit null (or NaN in a typed column, or an empty string): \"no data\", silent\n    59\texport const SLOT_INVALID = 2;       // present but not plottable (NaN or infinity in a row, a stray string): reported\n    60\texport const SLOT_NO_ROW = 3;        // this series has no observation at this x and none was expected; neighbours may be joined across it\n    61\texport const SLOT_GAP = 4;           // an expected step of this series is absent (AX105): never joined across\n    62\texport const SLOT_ABSENT_FIELD = 5;  // the row exists but the field's key is absent or undefined (AX102)\n    63\texport type SlotState = 0 | 1 | 2 | 3 | 4 | 5;\n    64\t/**\n    65\t * `missing: 'zero'` on a value field is applied by normalization: slots that would be SLOT_NULL, SLOT_NO_ROW,\n    66\t * SLOT_GAP or SLOT_ABSENT_FIELD become SLOT_VALUE with y = 0 and row = -1. SLOT_INVALID is never turned into zero.\n    67\t */\n    68\t\n    69\t/** Half-open range of indexes. */\n    70\texport interface IndexRange { readonly start: number; readonly end: number }\n    71\t\n    72\texport interface XColumn {\n    73\t  readonly kind: XKind;\n    74\t  /** Strictly ascending positions, one per slot. For 'category': 0, 1, 2, … */\n    75\t  readonly values: Float64Array;\n    76\t  /** For 'category': the name of each position. Otherwise null. */\n    77\t  readonly categories: readonly string[] | null;\n    78\t  /** For 'time': the resolved IANA zone ('UTC', 'America/Los_Angeles', …; 'local' is resolved before it gets here). Otherwise null. */\n    79\t  readonly timeZone: string | null;\n    80\t  /** For 'date': the precision the values were written in ('2026-02' is a month); the finest one if they are mixed. Otherwise null. */\n    81\t  readonly dateUnit: 'day' | 'month' | 'year' | null;\n    82\t  /** For 'category': true when the author declared the categories ordered, so the axis may be thinned (spec L1). */\n    83\t  readonly ordered: boolean;\n    84\t}\n    85\t\n    86\t/** The caller's data behind a frame, for events and for the table's provenance. */\n    87\texport interface RowSource {\n    88\t  /** The caller's row at a source index (materialized on demand for typed columns), or null if it is no longer retained. */\n    89\t  rowAt(sourceIndex: number): unknown;\n    90\t}\n    91\t\n    92\t/** One series of an aligned frame: a y value and a state for every x slot. */\n    93\texport interface Series {\n    94\t  /** Stable identity: the series value (long form) or the field name (wide form). Used for colors and toggling. */\n    95\t  readonly key: string;\n    96\t  /** Name shown to the reader. */\n    97\t  readonly label: string;\n    98\t  /** The value field this series was read from, for diagnostics. */\n    99\t  readonly field: string;\n   100\t  readonly unit: string | null;\n   101\t  readonly valueScale: 'percent' | 'ratio' | null;\n   102\t  /** False when the series cannot be drawn (duplicate x, AX108). It stays in the frame so the table and summary can say so. */\n   103\t  readonly drawable: boolean;\n   104\t  /** y per slot. NaN wherever `slot` is not SLOT_VALUE. May be a view on the caller's typed column. */\n   105\t  readonly y: Float64Array | Float32Array;\n   106\t  readonly slot: Uint8Array;\n   107\t  /** Index of the caller's row each slot came from, -1 where there is none. null means \"slot i came from row i\" (typed columns). */\n   108\t  readonly row: Int32Array | null;\n   109\t}\n   110\t\n   111\t/** One series of a point frame (scatter): its own x and y, sorted by x then y. */\n   112\texport interface PointSeries {\n   113\t  readonly key: string;\n   114\t  readonly label: string;\n   115\t  readonly drawable: boolean;\n   116\t  readonly x: Float64Array;\n   117\t  readonly y: Float64Array;\n   118\t  readonly row: Int32Array | null;\n   119\t}\n   120\t\n   121\t/**\n   122\t * The normalized, lossless data. Immutable: an update or append produces a new frame with a higher revision.\n   123\t * Buffers may be shared between revisions; a streaming store appends into spare capacity and hands out\n   124\t * subarray views, so an append does not copy what is already there.\n   125\t */\n   126\tinterface FrameBase {\n   127\t  readonly revision: number;\n   128\t  /** Changes when the data is replaced or the encoding changes; survives append and eviction. A DatumRef is only meaningful within one epoch. */\n   129\t  readonly epoch: number;\n   130\t  readonly source: RowSource;\n   131\t}\n   132\t\n   133\texport interface AlignedFrame extends FrameBase {\n   134\t  readonly shape: 'aligned';\n   135\t  readonly x: XColumn;\n   136\t  readonly series: readonly Series[];\n   137\t  /** Number of x slots. */\n   138\t  readonly length: number;\n   139\t  readonly xLabel: string;\n   140\t  readonly yLabel: string | null;\n   141\t}\n   142\t\n   143\texport interface PointFrame extends FrameBase {\n   144\t  readonly shape: 'points';\n   145\t  readonly xKind: Exclude<XKind, 'category'>;\n   146\t  readonly timeZone: string | null;\n   147\t  readonly series: readonly PointSeries[];\n   148\t  readonly xLabel: string;\n   149\t  readonly yLabel: string;\n   150\t  readonly xUnit: string | null;\n   151\t  readonly yUnit: string | null;\n   152\t}\n   153\t\n   154\t/** Donut data: every category the caller gave, in the given order, before any grouping into \"Other\". */\n   155\texport interface DonutFrame extends FrameBase {\n   156\t  readonly shape: 'donut';\n   157\t  readonly labels: readonly string[];\n   158\t  /** NaN where `slot` is not SLOT_VALUE. */\n   159\t  readonly values: Float64Array;\n   160\t  readonly slot: Uint8Array;\n   161\t  readonly row: Int32Array | null;\n   162\t  readonly valueLabel: string;\n   163\t  readonly unit: string | null;\n   164\t  readonly valueScale: 'percent' | 'ratio' | null;\n   165\t}\n   166\t\n   167\texport type Frame = AlignedFrame | PointFrame | DonutFrame;\n   168\t\n   169\t/**\n   170\t * Join rule for lines and areas (spec F2). Two consecutive SLOT_VALUE slots i < j of one series are joined\n   171\t * if and only if every slot strictly between them is SLOT_NO_ROW. A value with no joined neighbour on either\n   172\t * side is an isolated point and must be drawn as a visible point.\n   173\t */\n   174\t\n   175\t// ───────────────────────────── formatting ─────────────────────────────\n   176\t\n   177\texport interface Formatters {\n   178\t  /** Value as readers see it in tooltip, table and announcements: full precision per spec F6, unit appended. */\n   179\t  value(seriesIndex: number, v: number): string;\n   180\t  /** x as readers see it in tooltip, table and announcements. For 'time' it includes the zone abbreviation. */\n   181\t  x(position: number): string;\n   182\t  /** Text for a slot that is not a value: \"No data\", \"No observation\". */\n   183\t  missing(state: SlotState): string;\n   184\t  /** A share of a whole (0–1) as a percentage in the chart's locale, for donut slices and stack shares. */\n   185\t  percent(ratio: number): string;\n   186\t  /** A count (of values, rows, series) in the chart's locale. */\n   187\t  count(n: number): string;\n   188\t}\n   189\t\n   190\t// ───────────────────────────── scales and ticks ─────────────────────────────\n   191\t\n   192\texport interface ContinuousScale {\n   193\t  readonly type: 'linear' | 'time';\n   194\t  readonly domain: readonly [number, number];\n   195\t  /** Pixel range in CSS px; range[0] maps domain[0]. */\n   196\t  readonly range: readonly [number, number];\n   197\t  map(value: number): number;\n   198\t  invert(pixel: number): number;\n   199\t}\n   200\t\n   201\texport interface BandScale {\n   202\t  readonly type: 'band';\n   203\t  readonly count: number;\n   204\t  readonly range: readonly [number, number];\n   205\t  /** Distance between the starts of adjacent bands. */\n   206\t  readonly step: number;\n   207\t  /** Width of one band after padding. */\n   208\t  readonly bandwidth: number;\n   209\t  /** Start pixel of band i. */\n   210\t  map(index: number): number;\n   211\t  center(index: number): number;\n   212\t  /** Band under a pixel, clamped to [0, count - 1]; -1 when count is 0. */\n   213\t  invert(pixel: number): number;\n   214\t}\n   215\t\n   216\texport type XScale = ContinuousScale | BandScale;\n   217\t\n   218\texport interface Tick {\n   219\t  /** Position in the scale's domain (category: index). */\n   220\t  readonly value: number;\n   221\t  readonly label: string;\n   222\t}\n   223\t\n   224\t/**\n   225\t * Candidate tick sets for one axis, from densest to sparsest. Layout picks the densest set that fits.\n   226\t * Every set is a subset of \"nice\" positions for that axis; for a band scale the sets are every k-th category.\n   227\t */\n   228\texport type TickCandidates = readonly (readonly Tick[])[];\n   229\t\n   230\t// ───────────────────────────── view ─────────────────────────────\n   231\t\n   232\t/** A reference line (one position) or band (two) after its values were turned into axis positions. */\n   233\texport interface ResolvedReference {\n   234\t  readonly axis: 'x' | 'y';\n   235\t  readonly from: number;\n   236\t  /** Equal to `from` for a line. */\n   237\t  readonly to: number;\n   238\t  readonly label: string;\n   239\t}\n   240\t\n   241\t/** How one series is told apart without color (spec A5): a marker shape and dash patterns. */\n   242\texport interface SeriesCue {\n   243\t  readonly marker: MarkerShape;\n   244\t  readonly dash: DashStyle;\n   245\t}\n   246\t\n   247\t/**\n   248\t * Stacking (spec F10). Positive and negative values accumulate on their own sides of zero.\n   249\t * `positive[k]` is the upper boundary of the k-th stacked series' positive part, `positive[k - 1]` (or zero\n   250\t * for k = 0) its lower boundary; likewise `negative`. A component that is not SLOT_VALUE contributes zero\n   251\t * height and sets `incomplete` for that slot.\n   252\t */\n   253\texport interface StackView {\n   254\t  /** Frame series indexes in accumulation order (hidden series are left out). */\n   255\t  readonly order: readonly number[];\n   256\t  readonly positive: readonly Float64Array[];\n   257\t  readonly negative: readonly Float64Array[];\n   258\t  /** 1 where at least one visible component is missing; null when every stack is complete. */\n   259\t  readonly incomplete: Uint8Array | null;\n   260\t}\n   261\t\n   262\tinterface CartesianViewBase {\n   263\t  readonly revision: number;\n   264\t  /** Visibility per series (legend toggles). */\n   265\t  readonly visible: readonly boolean[];\n   266\t  readonly cues: readonly SeriesCue[];\n   267\t  /** Full x domain of the data (plus the author's domain), and the zoomed domain actually shown. */\n   268\t  readonly xFull: readonly [number, number];\n   269\t  readonly xDomain: readonly [number, number];\n   270\t  /** Value domain after the rules of spec F1 and F7. */\n   271\t  readonly yDomain: readonly [number, number];\n   272\t  readonly references: readonly ResolvedReference[];\n   273\t  readonly compact: boolean;\n   274\t}\n   275\t\n   276\t/** What is currently shown of an aligned frame. */\n   277\texport interface AlignedView extends CartesianViewBase {\n   278\t  readonly kind: 'line' | 'area' | 'bar';\n   279\t  readonly frame: AlignedFrame;\n   280\t  /** True only for horizontal bars. */\n   281\t  readonly horizontal: boolean;\n   282\t  /** Slots whose x lies inside xDomain. Pointer and keyboard only ever land on these. */\n   283\t  readonly visibleSlots: IndexRange;\n   284\t  /**\n   285\t   * Per series, the slot range to draw: visibleSlots widened on each side to that series' nearest value it\n   286\t   * may be joined to, so a line reaches the plot edge. Never used for picking.\n   287\t   */\n   288\t  readonly drawSlots: readonly IndexRange[];\n   289\t  readonly stack: StackView | null;\n   290\t}\n   291\t\n   292\texport interface ScatterView extends CartesianViewBase {\n   293\t  readonly kind: 'scatter';\n   294\t  readonly frame: PointFrame;\n   295\t  /** Per series, the range of its points whose x lies inside xDomain. */\n   296\t  readonly visiblePoints: readonly IndexRange[];\n   297\t}\n   298\t\n   299\t/** One drawn slice or legend entry of a donut (spec F8). */\n   300\texport interface DonutSlice {\n   301\t  readonly key: string;\n   302\t  readonly label: string;\n   303\t  /** Indexes into the donut frame: one for an ordinary slice, several for \"Other (n)\". */\n   304\t  readonly members: readonly number[];\n   305\t  /** null = \"No data\". */\n   306\t  readonly value: number | null;\n   307\t  /** Share of the total, 0–1; null when there is no value. */\n   308\t  readonly ratio: number | null;\n   309\t  /** Start and end angle in radians, clockwise from 12 o'clock; null when nothing is drawn (zero or no data). */\n   310\t  readonly angles: readonly [number, number] | null;\n   311\t  /**\n   312\t   * Palette slot for this slice: its ordinal among the entries that are not \"Other\", so eight slices never\n   313\t   * share a color whatever arcless entries sit between them. null for \"Other\" (the muted token). The legend\n   314\t   * uses the same index.\n   315\t   */\n   316\t  readonly colorIndex: number | null;\n   317\t}\n   318\t\n   319\texport interface DonutView {\n   320\t  readonly kind: 'donut';\n   321\t  readonly revision: number;\n   322\t  readonly frame: DonutFrame;\n   323\t  readonly slices: readonly DonutSlice[];\n   324\t  readonly total: number;\n   325\t}\n   326\t\n   327\texport type View = AlignedView | ScatterView | DonutView;\n   328\t\n   329\t// ───────────────────────────── text measurement ─────────────────────────────\n   330\t\n   331\texport interface TextStyle {\n   332\t  /** CSS font shorthand resolved from the page, e.g. \"400 12px Inter, sans-serif\". */\n   333\t  readonly font: string;\n   334\t  readonly letterSpacing: number;\n   335\t  readonly wordSpacing: number;\n   336\t  /** Line height in CSS px. */\n   337\t  readonly lineHeight: number;\n   338\t}\n   339\t\n   340\t/** Injected into layout. Browser: canvas measureText with the page's computed spacing applied. Tests: fixed metrics. */\n   341\texport interface TextMeasurer {\n   342\t  width(text: string, style: TextStyle): number;\n   343\t}\n   344\t\n   345\t// ───────────────────────────── layout ─────────────────────────────\n   346\t\n   347\texport interface Rect { readonly x: number; readonly y: number; readonly width: number; readonly height: number }\n   348\t\n   349\texport type LabelRemedy = 'thinned' | 'wrapped' | 'rotated' | 'truncated';\n   350\t\n   351\texport interface PlacedText {\n   352\t  /** What is drawn (possibly truncated with an ellipsis in the middle). */\n   353\t  readonly lines: readonly string[];\n   354\t  /** The complete text, for tooltip and table. */\n   355\t  readonly full: string;\n   356\t  /** Anchor point in CSS px relative to the plot container. */\n   357\t  readonly x: number;\n   358\t  readonly y: number;\n   359\t  readonly anchor: 'start' | 'middle' | 'end';\n   360\t  readonly baseline: 'top' | 'middle' | 'bottom';\n   361\t  /** Degrees, clockwise; 0, -45 or -90 in 1.0. */\n   362\t  readonly rotate: number;\n   363\t  readonly role: 'tick-x' | 'tick-y' | 'title-x' | 'title-y' | 'value' | 'reference' | 'message';\n   364\t  /** Bounding box after rotation, for the overlap test. */\n   365\t  readonly box: Rect;\n   366\t}\n   367\t\n   368\t/** The mapping from data to pixels that scene building and lookup must share. */\n   369\texport type Projection =\n   370\t  | { readonly kind: 'xy'; readonly x: XScale; readonly y: ContinuousScale }\n   371\t  /** Bars: `band` runs along the category axis, `value` along the other; `horizontal` swaps the screen axes. */\n   372\t  | { readonly kind: 'bands'; readonly horizontal: boolean; readonly band: XScale; readonly value: ContinuousScale }\n   373\t  | { readonly kind: 'ring'; readonly cx: number; readonly cy: number; readonly r0: number; readonly r1: number };\n   374\t\n   375\t/** What label fitting did on one axis, in the order it did it (spec L1). */\n   376\texport interface AxisLabelFit {\n   377\t  readonly remedies: readonly LabelRemedy[];\n   378\t  /** Labels that could not be shown after every remedy. More than zero means the reader gets the L1 note. */\n   379\t  readonly hidden: number;\n   380\t}\n   381\t\n   382\tinterface LayoutSize {\n   383\t  /** Size of the plot container (the element that holds marks and tick text), CSS px. */\n   384\t  readonly width: number;\n   385\t  readonly height: number;\n   386\t}\n   387\t\n   388\t/**\n   389\t * Layout of the plot container only. The title, summary, legend, controls, notes and table are ordinary\n   390\t * HTML around it and are laid out by the browser; the plot container's size is whatever is left.\n   391\t */\n   392\texport type Layout =\n   393\t  | (LayoutSize & {\n   394\t      readonly kind: 'plot';\n   395\t      /** Where marks are drawn. */\n   396\t      readonly plot: Rect;\n   397\t      readonly projection: Projection;\n   398\t      readonly xTicks: readonly Tick[];\n   399\t      readonly yTicks: readonly Tick[];\n   400\t      readonly texts: readonly PlacedText[];\n   401\t      readonly fit: { readonly x: AxisLabelFit; readonly y: AxisLabelFit };\n   402\t    })\n   403\t  /** Compact variant (spec 3.7): marks fill the container, no text. */\n   404\t  | (LayoutSize & { readonly kind: 'compact'; readonly plot: Rect; readonly projection: Projection })\n   405\t  /** The plot would be below 120 × 80 CSS px (spec L8): only the summary and the table control are shown. */\n   406\t  | (LayoutSize & { readonly kind: 'too-small' })\n   407\t  /** Loading, empty or error state (spec L7): a message instead of marks. */\n   408\t  | (LayoutSize & { readonly kind: 'message'; readonly text: PlacedText })\n   409\t  /** The container has no size yet (hidden or detached). Nothing is drawn until it gets one. */\n   410\t  | (LayoutSize & { readonly kind: 'unmeasured' });\n   411\t\n   412\t// ───────────────────────────── scene ─────────────────────────────\n   413\t\n   414\t/**\n   415\t * A color that is resolved late, so an SVG renderer can use CSS variables and a canvas renderer can look\n   416\t * the value up in the resolved theme.\n   417\t */\n   418\texport type Paint =\n   419\t  | { readonly kind: 'series'; readonly index: number }   // palette slot or the author's color for that series\n   420\t  | { readonly kind: 'token'; readonly name: 'axis' | 'grid' | 'reference' | 'muted' | 'focus' | 'background' | 'text' }\n   421\t  | { readonly kind: 'none' };\n   422\t\n   423\texport type MarkerShape = 'circle' | 'square' | 'triangle' | 'diamond' | 'cross' | 'plus' | 'triangle-down' | 'star';\n   424\t\n   425\t/** Dash pattern in normal mode and under `prefers-contrast: more` or forced colors. null = solid. */\n   426\texport interface DashStyle {\n   427\t  readonly normal: readonly number[] | null;\n   428\t  readonly contrast: readonly number[] | null;\n   429\t}\n   430\t\n   431\t/** A polyline. `xy` is x0,y0,x1,y1,… in CSS px; a NaN pair lifts the pen. */\n   432\texport interface PathMark {\n   433\t  readonly type: 'path';\n   434\t  readonly series: number;\n   435\t  readonly xy: Float32Array;\n   436\t  readonly stroke: Paint;\n   437\t  readonly strokeWidth: number;\n   438\t  readonly dash: DashStyle;\n   439\t}\n   440\t\n   441\t/**\n   442\t * Filled regions between an upper and a lower boundary (area, stacked area). Each boundary is its own packed\n   443\t * polyline, so each can keep its own extremes when simplified (spec F5), and adjacent stack bands can share\n   444\t * the very same boundary array. `runs` holds quadruples (upperStart, upperCount, lowerStart, lowerCount) in\n   445\t * vertices; one quadruple is one polygon: its upper vertices forward, then its lower vertices in reverse.\n   446\t */\n   447\texport interface AreaMark {\n   448\t  readonly type: 'area';\n   449\t  readonly series: number;\n   450\t  readonly upper: Float32Array;\n   451\t  readonly lower: Float32Array;\n   452\t  readonly runs: Uint32Array;\n   453\t  readonly fill: Paint;\n   454\t  readonly opacity: number;\n   455\t}\n   456\t\n   457\t/** Axis-aligned rectangles: x,y,width,height quadruples in CSS px. */\n   458\texport interface RectMark {\n   459\t  readonly type: 'rects';\n   460\t  readonly series: number;\n   461\t  readonly xywh: Float32Array;\n   462\t  readonly fill: Paint;\n   463\t  /** 'missing' draws the \"no data\" mark of spec F2 instead of a filled bar. */\n   464\t  readonly variant: 'bar' | 'missing';\n   465\t  /**\n   466\t   * A second cue on top of the fill, for charts with more than eight series (spec F9): a pattern drawn in the\n   467\t   * background color over the fill. Absent or 'none' for the first eight.\n   468\t   */\n   469\t  readonly pattern?: 'none' | 'diagonal' | 'cross' | 'dots';\n   470\t}\n   471\t\n   472\t/** Markers: x,y pairs in CSS px. */\n   473\texport interface PointMark {\n   474\t  readonly type: 'points';\n   475\t  readonly series: number;\n   476\t  readonly xy: Float32Array;\n   477\t  readonly shape: MarkerShape;\n   478\t  readonly size: number;\n   479\t  readonly fill: Paint;\n   480\t}\n   481\t\n   482\t/** Annular sectors (donut). Angles in radians, clockwise from 12 o'clock. */\n   483\texport interface ArcMark {\n   484\t  readonly type: 'arcs';\n   485\t  readonly cx: number;\n   486\t  readonly cy: number;\n   487\t  readonly r0: number;\n   488\t  readonly r1: number;\n   489\t  readonly angles: Float32Array; // start0,end0,start1,end1,…\n   490\t  readonly fills: readonly Paint[];\n   491\t  /** Gap between adjacent slices in CSS px (spec A5). */\n   492\t  readonly gap: number;\n   493\t}\n   494\t\n   495\texport interface RuleMark {\n   496\t  readonly type: 'rule';\n   497\t  readonly x1: number; readonly y1: number; readonly x2: number; readonly y2: number;\n   498\t  readonly stroke: Paint;\n   499\t  readonly strokeWidth: number;\n   500\t  readonly dash: readonly number[] | null;\n   501\t  readonly role: 'grid' | 'axis' | 'tick' | 'reference' | 'cursor' | 'break';\n   502\t}\n   503\t\n   504\t/** A filled rectangle that is not data: a reference band. */\n   505\texport interface BandMark {\n   506\t  readonly type: 'band';\n   507\t  readonly box: Rect;\n   508\t  readonly fill: Paint;\n   509\t  readonly opacity: number;\n   510\t}\n   511\t\n   512\texport type Mark = PathMark | AreaMark | RectMark | PointMark | ArcMark | RuleMark | BandMark;\n   513\t\n   514\t/** Everything the mark renderer draws, back to front. Plain data: no functions, no DOM. */\n   515\texport interface Scene {\n   516\t  readonly width: number;\n   517\t  readonly height: number;\n   518\t  /** Marks are clipped to this rectangle unless their role is 'axis' or 'tick'. */\n   519\t  readonly clip: Rect;\n   520\t  readonly marks: readonly Mark[];\n   521\t}\n   522\t\n   523\t// ───────────────────────────── theme ─────────────────────────────\n   524\t\n   525\texport type PaintToken = 'axis' | 'grid' | 'reference' | 'muted' | 'focus' | 'background' | 'text';\n   526\t\n   527\t/** CSS color expressions per paint. May be `var(--axylo-series-1)` or an author's `var(--brand-1)`: unresolved. */\n   528\texport interface PaintBindings {\n   529\t  readonly tokens: Readonly<Record<PaintToken, string>>;\n   530\t  /** One expression per series index, already including the author's `colors` by series key. */\n   531\t  readonly series: readonly string[];\n   532\t}\n   533\t\n   534\t/** The same paints as concrete computed colors, plus what was detected about the page (spec L4, DX6). */\n   535\texport interface ResolvedTheme {\n   536\t  readonly scheme: 'light' | 'dark';\n   537\t  readonly forcedColors: boolean;\n   538\t  readonly moreContrast: boolean;\n   539\t  readonly paints: PaintBindings;\n   540\t}\n   541\t\n   542\t// ───────────────────────────── rendering ─────────────────────────────\n   543\t\n   544\t/** Transient decoration drawn above the scene: cursor rule and highlighted points (clipped to the plot), focus ring (not clipped). */\n   545\texport interface Overlay {\n   546\t  readonly clip: Rect;\n   547\t  readonly clipped: readonly Mark[];\n   548\t  readonly unclipped: readonly Mark[];\n   549\t}\n   550\t\n   551\t/**\n   552\t * Draws a scene's marks. Two implementations exist for the M1 comparison (canvas, svg); the rest of the\n   553\t * library does not know which one is in use.\n   554\t *\n   555\t * A canvas renderer paints with `theme.paints` (concrete colors) and must be told to draw again when the\n   556\t * theme changes. An SVG renderer paints with `bindings` (CSS expressions), so the browser restyles it on a\n   557\t * theme change without a call; it switches dash patterns with CSS media queries.\n   558\t */\n   559\texport interface MarkRenderer {\n   560\t  readonly kind: 'canvas' | 'svg';\n   561\t  /** The element to insert into the plot container. It must be aria-hidden. */\n   562\t  readonly element: HTMLElement | SVGSVGElement;\n   563\t  /** Draws the scene, replacing the previous one. Called at most once per animation frame. */\n   564\t  draw(scene: Scene, bindings: PaintBindings, theme: ResolvedTheme, devicePixelRatio: number): void;\n   565\t  /** Draws or clears (null) the overlay without redrawing the scene. */\n   566\t  drawOverlay(overlay: Overlay | null, bindings: PaintBindings, theme: ResolvedTheme, devicePixelRatio: number): void;\n   567\t  destroy(): void;\n   568\t}\n   569\t\n   570\t// ───────────────────────────── lookup ─────────────────────────────\n   571\t\n   572\t/**\n   573\t * A datum by identity, not by position, so it still means the same thing after a streaming window slides.\n   574\t * Valid within one frame epoch.\n   575\t */\n   576\texport type DatumRef =\n   577\t  | { readonly kind: 'aligned'; readonly seriesKey: string; /** x position (category: its index at the time; categories do not slide). */ readonly x: number }\n   578\t  | { readonly kind: 'point'; readonly seriesKey: string; /** source row index */ readonly row: number; /** x position, so a ref to an evicted point can resolve to its nearest surviving neighbour */ readonly x: number }\n   579\t  | { readonly kind: 'slice'; readonly sliceKey: string };\n   580\t\n   581\t/** What the pointer is over, by the picking rule of the chart type (spec 3.6). */\n   582\texport type PickTarget =\n   583\t  | { readonly kind: 'x'; readonly x: number }                      // line, area, bar: every series at this x\n   584\t  | { readonly kind: 'point'; readonly refs: readonly DatumRef[]; readonly count: number }  // scatter: nearest point and those coinciding with it (at most 8; `count` is the full number)\n   585\t  | { readonly kind: 'slice'; readonly sliceKey: string };\n   586\t\n   587\t/** One row of a tooltip or one announced point, as text. All text comes from the frame through the formatters. */\n   588\texport interface DatumText {\n   589\t  readonly ref: DatumRef;\n   590\t  readonly seriesIndex: number;\n   591\t  readonly seriesLabel: string;\n   592\t  /** x as the reader sees it. */\n   593\t  readonly x: string;\n   594\t  /** The value with its unit, or \"No data\" / \"No observation\". */\n   595\t  readonly value: string;\n   596\t  readonly state: SlotState;\n   597\t  /** Share of the whole for a donut slice, formatted; null elsewhere. */\n   598\t  readonly percent: string | null;\n   599\t  /** Source row index, or -1. */\n   600\t  readonly row: number;\n   601\t}\n   602\t\n   603\texport interface TooltipModel {\n   604\t  /** Heading: the x value (with its time zone for instants), the category, or the slice label. */\n   605\t  readonly title: string;\n   606\t  /** At most eight rows (spec I1). */\n   607\t  readonly rows: readonly DatumText[];\n   608\t  /** Rows before truncation. */\n   609\t  readonly count: number;\n   610\t  /** Stack total with \"incomplete\" where it applies, already formatted; null when the chart does not stack. */\n   611\t  readonly total: string | null;\n   612\t}\n   613\t\n   614\texport type StepDirection = 'next' | 'previous' | 'first' | 'last' | 'series-next' | 'series-previous' | 'page-next' | 'page-previous';\n   615\t\n   616\t/**\n   617\t * Exact answers from the frame for one view and projection, independent of how the scene was simplified.\n   618\t * Built once per (view, layout); cheap to build: binary search over x for aligned frames, a grid index for scatter.\n   619\t */\n   620\texport interface Lookup {\n   621\t  /** What is under a pixel of the plot container, or null. */\n   622\t  pick(px: number, py: number): PickTarget | null;\n   623\t  tooltip(target: PickTarget): TooltipModel;\n   624\t  /** The datum to focus when the keyboard takes over from a pointer target. */\n   625\t  primary(target: PickTarget): DatumRef | null;\n   626\t  datum(ref: DatumRef): DatumText | null;\n   627\t  /** Where the datum is drawn, for the cursor and focus ring; null if it is not visible. */\n   628\t  anchor(ref: DatumRef): Rect | null;\n   629\t  /**\n   630\t   * Position for \"point 4 of 120\" (spec A3). Aligned charts: `count` is the number of visible x slots and\n   631\t   * `ordinal` the zero-based place of the datum's x among them, whatever its series and whether or not it\n   632\t   * holds a value (a \"No data\" slot has a place too). Scatter: place among all visible points in x then y\n   633\t   * order. Donut: slice order. -1 only when the datum is not in the current view.\n   634\t   */\n   635\t  readonly count: number;\n   636\t  ordinal(ref: DatumRef): number;\n   637\t  /** Keyboard order per chart type (spec 3.6). `from` null starts at the first datum. Skips hidden series. */\n   638\t  step(from: DatumRef | null, direction: StepDirection): DatumRef | null;\n   639\t  /**\n   640\t   * Where focus should be after the data or the view changed. A datum is \"there\" only if its series is\n   641\t   * visible and drawable and its x (or point) is inside the current view. If it is: itself. If its series is\n   642\t   * hidden but its x is in view: the primary datum at that x. Otherwise the nearest datum of its series in\n   643\t   * view after it, else before it; for a donut slice folded into \"Other\", the \"Other\" slice. Else null.\n   644\t   * `step` always starts from the resolved datum, so focus can never get stuck on something out of reach.\n   645\t   */\n   646\t  resolve(ref: DatumRef): DatumRef | null;\n   647\t}\n   648\t\n   649\t// ───────────────────────────── reader model ─────────────────────────────\n   650\t\n   651\t/** The table of spec A4, built lazily from the frame: nothing is materialized until a page is asked for. */\n   652\texport interface TableModel {\n   653\t  readonly caption: string;\n   654\t  /** First entry is the x column. */\n   655\t  readonly headers: readonly string[];\n   656\t  readonly rowCount: number;\n   657\t  readonly pageSize: number;\n   658\t  /** Cells of one row as text; first cell is the row header. null outside the range. */\n   659\t  row(ordinal: number): readonly string[] | null;\n   660\t  /** Zero-based page that contains the first row at or after an x value; null if there is none. */\n   661\t  pageForX(x: XValue): number | null;\n   662\t}\n   663\t\n   664\t/** Everything a reader gets as text (spec A1, C1). */\n   665\texport interface ReaderModel {\n   666\t  /** Accessible name: the title, or a generated one. Empty when the chart is named by `labelledBy`. */\n   667\t  readonly name: string;\n   668\t  /** Generated summary plus the author's description, including time zone and omission statements. */\n   669\t  readonly summary: string;\n   670\t  /** The reader's note of spec F12 and L1, or null. */\n   671\t  readonly note: string | null;\n   672\t  /** null for the compact variant and when the table is turned off. */\n   673\t  readonly table: TableModel | null;\n   674\t}\n   675\t\n   676\t// ───────────────────────────── environment ─────────────────────────────\n   677\t\n   678\t/** Everything outside the options and data that output depends on. Part of every cache key that needs it. */\n   679\texport interface Environment {\n   680\t  readonly locale: string;\n   681\t  /** The viewer's zone, used when a time field says 'local'. */\n   682\t  readonly timeZone: string;\n   683\t  readonly devicePixelRatio: number;\n   684\t  readonly reducedMotion: boolean;\n   685\t  readonly textStyle: TextStyle;\n   686\t  /** Increases whenever web fonts finish loading; part of the layout cache key. */\n   687\t  readonly fontEpoch: number;\n   688\t  readonly development: boolean;\n   689\t}\n   690\t\n   691\texport type { Diagnostic, XValue };\n   692\t\n","exit_code":0,"status":"completed"}}
