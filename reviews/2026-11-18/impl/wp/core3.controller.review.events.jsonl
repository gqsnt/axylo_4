'function') return name;\n    94\t      let reported = false;\n    95\t      return (position: number) => {\n    96\t        try {\n    97\t          return String(format(name(position)));\n    98\t        } catch (error) {\n    99\t          if (!reported && onError) onError(error);\n   100\t          reported = true;\n   101\t          return name(position);\n   102\t        }\n   103\t      };\n   104\t    }\n   105\t    case 'number': {\n   106\t      const format = x.format;\n   107\t      // Date-time options make no sense for a number; only a function or number options are used.\n   108\t      const numberOption: NumberFormatOption | null =\n   109\t        typeof format === 'function' ? (v: number) => format(v) : format != null && !isDateOptions(format) ? (format as Intl.NumberFormatOptions) : null;\n   110\t      return createNumberReadout({ locale, scale: null, unit: x.unit, format: numberOption, onError });\n   111\t    }\n   112\t    default: {\n   113\t      const timeZone = x.kind === 'time' ? (x.timeZone == null || x.timeZone === 'local' ? viewerZone : x.timeZone) : null;\n   114\t      return createTimeReadout({ kind: x.kind, timeZone, locale, dateUnit: x.dateUnit, format: x.format ?? null, onError });\n   115\t    }\n   116\t  }\n   117\t}\n   118\t\n     1\timport type { DiagnosticInput, DiagnosticSink } from '../core/contracts';\n     2\timport type { Diagnostic } from '../public';\n     3\timport { createDiagnostic, diagnosticContext, type DiagnosticCode } from './registry';\n     4\t\n     5\tfunction samples(a?: readonly string[], b?: readonly string[]): readonly string[] {\n     6\t  return [...new Set([...(a ?? []), ...(b ?? [])])].slice(0, 10);\n     7\t}\n     8\t\n     9\texport class DiagnosticCollector implements DiagnosticSink {\n    10\t  protected readonly entries = new Map<string, DiagnosticInput>();\n    11\t\n    12\t  add(diagnostic: DiagnosticInput): void {\n    13\t    const { code, field, effect, rows, count } = diagnostic;\n    14\t    const key = JSON.stringify([code, field, effect]);\n    15\t    const first = this.entries.get(key);\n    16\t    if (!first) {\n    17\t      const context = diagnosticContext(diagnostic);\n    18\t      const unique = rows === undefined ? undefined : [...new Set(rows)].slice(0, 10);\n    19\t      const copy = unique?.length !== rows?.length && context\n    20\t        ? createDiagnostic(code as DiagnosticCode, effect, { ...context, field, rows: unique, count: count ?? rows?.length }, diagnostic.origin)\n    21\t        : unique?.length !== rows?.length ? { ...diagnostic, rows: unique, count: count ?? rows?.length } : diagnostic;\n    22\t      this.entries.set(key, copy);\n    23\t      return;\n    24\t    }\n    25\t\n    26\t    const mergedRows = first.rows || rows\n    27\t      ? [...new Set([...(first.rows ?? []), ...(rows ?? [])])].slice(0, 10)\n    28\t      : undefined;\n    29\t    const mergedCount = (first.count ?? first.rows?.length ?? 1) + (count ?? rows?.length ?? 1);\n    30\t    const origin = diagnostic.origin === 'call' ? 'call' : first.origin;\n    31\t    const context = diagnosticContext(first);\n    32\t    if (context) {\n    33\t      const later = diagnosticContext(diagnostic);\n    34\t      const examples = samples(context.examples, later?.examples);\n    35\t      const series = samples(context.series, later?.series);\n    36\t      const sparseSeries = samples(context.sparseSeries, later?.sparseSeries);\n    37\t      const zeroSeries = context.zeroSeries || later?.zeroSeries ? samples(context.zeroSeries, later?.zeroSeries) : undefined;\n    38\t      this.entries.set(key, createDiagnostic(code as DiagnosticCode, effect, {\n    39\t        ...context, examples, series, sparseSeries, zeroSeries, field, rows: mergedRows, count: mergedCount,\n    40\t      }, origin));\n    41\t    } else {\n    42\t      this.entries.set(key, { ...first, rows: mergedRows, count: mergedCount, origin });\n    43\t    }\n    44\t  }\n    45\t\n    46\t  inputs(): readonly DiagnosticInput[] {\n    47\t    return Array.from(this.entries.values());\n    48\t  }\n    49\t\n    50\t  list(chart: string): readonly Diagnostic[] {\n    51\t    return this.inputs().map(({ effect: _effect, origin: _origin, ...diagnostic }) => ({ ...diagnostic, chart }));\n    52\t  }\n    53\t}\n    54\t\n    55\texport function readerDisclosure(diagnostics: readonly DiagnosticInput[]): { omitted: number; changed: number } {\n    56\t  const disclosure = { omitted: 0, changed: 0 };\n    57\t  for (const { level, effect, count, rows } of diagnostics) {\n    58\t    if (level !== 'warning') continue;\n    59\t    if (effect === 'omitted' || effect === 'changed') disclosure[effect] += count ?? rows?.length ?? 1;\n    60\t  }\n    61\t  return disclosure;\n    62\t}\n","exit_code":0,"status":"completed"}}
