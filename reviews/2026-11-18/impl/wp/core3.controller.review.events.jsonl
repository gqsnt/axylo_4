{"type":"item.completed","item":{"id":"item_33","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/test/browser/chart/lifecycle.browser.test.ts | sed -n '1,422p'\"","aggregated_output":"     1\t/**\n     2\t * Resize (spec L3), the commit contract (plan 1.5, spec DX5) and teardown, observed through the stage\n     3\t * counters the development build exposes (`chart.__dev.stages()`).\n     4\t */\n     5\timport { afterAll, beforeAll, describe, expect, it } from 'vitest';\n     6\timport { start, stop } from '../harness';\n     7\timport { chartPage, closePage } from './util';\n     8\t\n     9\tbeforeAll(start);\n    10\tafterAll(stop);\n    11\t\n    12\tdescribe('resize (spec L3)', () => {\n    13\t  it('720 → 360 → 720 px relayouts with no call from the page and does not renormalize', async () => {\n    14\t    const page = await chartPage();\n    15\t    const result = await page.evaluate(async () => {\n    16\t      const el = document.getElementById('chart')!;\n    17\t      const chart = window.Axylo.line!(el, { title: 'T', data: window.fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel' });\n    18\t      window.charts.push(chart);\n    19\t      await chart.__bench.ready();\n    20\t      const widths: number[] = [];\n    21\t      const lastLabelRight = () => Math.max(...[...el.querySelectorAll('.axylo-label')].map(l => l.getBoundingClientRect().right)) - el.getBoundingClientRect().left;\n    22\t      // Either renderer: the canvas renderer's wrapper or the SVG element.\n    23\t      const marks = () => (el.querySelector('.axylo-canvas, .axylo-svg') as HTMLElement).getBoundingClientRect().width;\n    24\t      const first = chart.__dev.stages();\n    25\t      widths.push(marks());\n    26\t      el.style.width = '360px';\n    27\t      await window.nextFrames(3);\n    28\t      widths.push(marks());\n    29\t      const narrow = lastLabelRight();\n    30\t      el.style.width = '720px';\n    31\t      await window.nextFrames(3);\n    32\t      widths.push(marks());\n    33\t      const last = chart.__dev.stages();\n    34\t      return { widths, narrow, first, last };\n    35\t    });\n    36\t    expect(result.widths).toEqual([720, 360, 720]);\n    37\t    expect(result.narrow).toBeLessThanOrEqual(361);\n    38\t    expect(result.last.layout - result.first.layout).toBe(2);\n    39\t    expect(result.last.normalize).toBe(result.first.normalize);\n    40\t    expect(result.last.options).toBe(result.first.options);\n    41\t    expect(await closePage(page)).toEqual([]);\n    42\t  });\n    43\t\n    44\t  it('a container created with display: none draws once shown', async () => {\n    45\t    const page = await chartPage({ css: '#chart { display: none; }' });\n    46\t    const result = await page.evaluate(async () => {\n    47\t      const chart = window.Axylo.line!('#chart', { title: 'Hidden', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    48\t      let ready = false;\n    49\t      void chart.__bench.ready().then(() => { ready = true; });\n    50\t      await window.nextFrames(3);\n    51\t      const hidden = { ready, draws: chart.__dev.stages().draw };\n    52\t      document.getElementById('chart')!.style.display = 'block';\n    53\t      await chart.__bench.ready();\n    54\t      await window.nextFrames(2);\n    55\t      return { hidden, draws: chart.__dev.stages().draw, labels: document.querySelectorAll('#chart .axylo-label').length };\n    56\t    });\n    57\t    expect(result.hidden).toEqual({ ready: false, draws: 0 });\n    58\t    expect(result.draws).toBe(1);\n    59\t    expect(result.labels).toBeGreaterThan(3);\n    60\t    expect(await closePage(page)).toEqual([]);\n    61\t  });\n    62\t\n    63\t  it('a height: auto container gets a 16:9 plot, clamped to 160–480 px, stable over 10 frames', async () => {\n    64\t    const page = await chartPage({ css: '#chart { height: auto; } .w { height: auto; }' });\n    65\t    const result = await page.evaluate(async () => {\n    66\t      const chart = window.Axylo.line!('#chart', { title: 'Auto', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    67\t      await chart.__bench.ready();\n    68\t      const plot = document.querySelector('#chart .axylo-plot')!;\n    69\t      const heights: number[] = [];\n    70\t      const layouts: number[] = [];\n    71\t      for (let i = 0; i < 10; i++) {\n    72\t        await window.nextFrames(1);\n    73\t        heights.push(plot.getBoundingClientRect().height);\n    74\t        layouts.push(chart.__dev.stages().layout);\n    75\t      }\n    76\t      const clamp: number[] = [];\n    77\t      for (const width of [200, 1200]) {\n    78\t        const el = Object.assign(document.body.appendChild(document.createElement('div')), { className: 'w' });\n    79\t        el.style.width = `${width}px`;\n    80\t        const c = window.Axylo.line!(el, { title: 'W', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n    81\t        await c.__bench.ready();\n    82\t        clamp.push(el.querySelector('.axylo-plot')!.getBoundingClientRect().height);\n    83\t      }\n    84\t      return { heights, layouts, clamp };\n    85\t    });\n    86\t    expect(new Set(result.heights).size).toBe(1);\n    87\t    expect(result.heights[0]).toBeCloseTo(720 * 9 / 16, 0);\n    88\t    expect(new Set(result.layouts).size).toBe(1);\n    89\t    expect(result.clamp).toEqual([160, 480]);\n    90\t    expect(await closePage(page)).toEqual([]);\n    91\t  });\n    92\t\n    93\t  // Part 2 put the legend and toolbar under the plot (spec A2), so the plot now takes what the caption and\n    94\t  // the controls leave; with no controls (legend, zoom and table off) it reaches the bottom as before.\n    95\t  it('a definite container height is filled: the plot takes what the caption and the controls leave', async () => {\n    96\t    const page = await chartPage({ css: '#chart { height: 300px; } #bare { height: 300px; width: 720px; }' });\n    97\t    const result = await page.evaluate(async () => {\n    98\t      const options = { title: 'Fixed', subtitle: 'Subtitle', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' };\n    99\t      const chart = window.Axylo.line!('#chart', options);\n   100\t      const el = document.body.appendChild(Object.assign(document.createElement('div'), { id: 'bare' }));\n   101\t      const bare = window.Axylo.line!(el, { ...options, legend: false, zoom: false, table: false });\n   102\t      await Promise.all([chart.__bench.ready(), bare.__bench.ready()]);\n   103\t      const box = (selector: string) => document.querySelector(selector)!.getBoundingClientRect();\n   104\t      return {\n   105\t        root: box('#chart').bottom, fig: box('#chart figure').bottom, plot: box('#chart .axylo-plot').bottom,\n   106\t        plotHeight: box('#chart .axylo-plot').height, controls: box('#chart .axylo-controls'),\n   107\t        bare: { root: box('#bare').bottom, plot: box('#bare .axylo-plot').bottom, controls: (document.querySelector('#bare .axylo-controls') as HTMLElement).hidden },\n   108\t      };\n   109\t    });\n   110\t    expect(result.fig).toBeCloseTo(result.root, 0);\n   111\t    expect(result.controls.bottom).toBeCloseTo(result.root, 0);\n   112\t    expect(result.plot).toBeLessThanOrEqual(result.controls.top);\n   113\t    expect(result.plotHeight).toBeLessThan(300);\n   114\t    expect(result.bare.controls).toBe(true);\n   115\t    expect(result.bare.plot).toBeCloseTo(result.bare.root, 0);\n   116\t    expect(await closePage(page)).toEqual([]);\n   117\t  });\n   118\t});\n   119\t\n   120\tdescribe('commit contract (plan 1.5, spec DX5)', () => {\n   121\t  it('update({ data }), append and zoom in one turn are drawn once and end in the expected state', async () => {\n   122\t    const page = await chartPage();\n   123\t    const result = await page.evaluate(async () => {\n   124\t      const DAY = 864e5;\n   125\t      const rows = (from: number, n: number) => Array.from({ length: n }, (_, i) => ({ day: from + i * DAY, v: i }));\n   126\t      const t0 = Date.UTC(2026, 0, 1);\n   127\t      const chart = window.Axylo.line!('#chart', { title: 'Seq', data: rows(t0, 30), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   128\t      await chart.__bench.ready();\n   129\t      const before = chart.__dev.stages();\n   130\t      const replaced = rows(t0 + 100 * DAY, 10);\n   131\t      chart.update({ data: replaced });\n   132\t      chart.append([{ day: t0 + 110 * DAY, v: 10 }, { day: t0 + 111 * DAY, v: 11 }]);\n   133\t      chart.zoom([new Date(t0 + 105 * DAY), new Date(t0 + 111 * DAY)]);\n   134\t      const sync = chart.__dev.stages();\n   135\t      await chart.__bench.ready();\n   136\t      await window.nextFrames(2);\n   137\t      const after = chart.__dev.stages();\n   138\t      return { before, sync, after, describe: chart.__bench.describe(), t0, DAY };\n   139\t    });\n   140\t    const { before, sync, after, describe, t0, DAY } = result;\n   141\t    expect(sync.draw).toBe(before.draw);\n   142\t    expect(after.draw - before.draw).toBe(1);\n   143\t    expect(after.frame - before.frame).toBe(1);\n   144\t    expect(describe.series[0]!.points).toBe(12);\n   145\t    expect(describe.series[0]!.oldestX).toBe(t0 + 100 * DAY);\n   146\t    expect(describe.series[0]!.newestX).toBe(t0 + 111 * DAY);\n   147\t    expect(describe.xDomain).toEqual([t0 + 105 * DAY, t0 + 111 * DAY]);\n   148\t    expect(await closePage(page)).toEqual([]);\n   149\t  });\n   150\t\n   151\t  it('append with keep keeps that many x values, and a window zoomed to the latest edge follows', async () => {\n   152\t    const page = await chartPage();\n   153\t    const result = await page.evaluate(async () => {\n   154\t      const t0 = Date.UTC(2026, 0, 1);\n   155\t      const M = 60000;\n   156\t      const chart = window.Axylo.line!('#chart', { title: 'Stream', data: { columns: { t: Float64Array.from({ length: 100 }, (_, i) => t0 + i * M), v: Float64Array.from({ length: 100 }, (_, i) => i) } }, x: { field: 't', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   157\t      chart.zoom([new Date(t0 + 80 * M), new Date(t0 + 99 * M)]);\n   158\t      for (let i = 100; i < 110; i++) chart.append([{ t: t0 + i * M, v: i }], { keep: 100 });\n   159\t      await chart.__bench.ready();\n   160\t      return { d: chart.__bench.describe(), stages: chart.__dev.stages(), t0, M };\n   161\t    });\n   162\t    const { d, t0, M } = result;\n   163\t    expect(d.series[0]!.points).toBe(100);\n   164\t    expect(d.series[0]!.oldestX).toBe(t0 + 10 * M);\n   165\t    expect(d.series[0]!.newestX).toBe(t0 + 109 * M);\n   166\t    expect(d.xDomain).toEqual([t0 + 90 * M, t0 + 109 * M]);\n   167\t    expect(result.stages.normalize).toBe(1);\n   168\t    expect(result.stages.draw).toBe(1);\n   169\t    expect(await closePage(page)).toEqual([]);\n   170\t  });\n   171\t\n   172\t  it('a title-only update does not renormalize, rebuild the view or relayout the plot', async () => {\n   173\t    const page = await chartPage({ css: '#chart { height: auto; }' });\n   174\t    const result = await page.evaluate(async () => {\n   175\t      const chart = window.Axylo.line!('#chart', { title: 'Before', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   176\t      await chart.__bench.ready();\n   177\t      const before = chart.__dev.stages();\n   178\t      chart.update({ title: 'After' });\n   179\t      await chart.__bench.ready();\n   180\t      await window.nextFrames(2);\n   181\t      return { before, after: chart.__dev.stages(), heading: document.querySelector('#chart .axylo-title')!.textContent };\n   182\t    });\n   183\t    expect(result.heading).toBe('After');\n   184\t    for (const stage of ['normalize', 'view', 'layout', 'scene', 'draw'] as const) expect(result.after[stage], stage).toBe(result.before[stage]);\n   185\t    expect(result.after.reader).toBe(result.before.reader! + 1);\n   186\t    expect(await closePage(page)).toEqual([]);\n   187\t  });\n   188\t\n   189\t  it('a data-only update that keeps the domains does not relayout', async () => {\n   190\t    const page = await chartPage();\n   191\t    const result = await page.evaluate(async () => {\n   192\t      const t0 = Date.UTC(2026, 0, 1);\n   193\t      const rows = (k: number) => Array.from({ length: 30 }, (_, i) => ({ day: t0 + i * 864e5, v: 50 + ((i * k) % 7) }));\n   194\t      const chart = window.Axylo.line!('#chart', { title: 'T', data: rows(1), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   195\t      await chart.__bench.ready();\n   196\t      const before = chart.__dev.stages();\n   197\t      chart.update({ data: rows(3) });\n   198\t      await chart.__bench.ready();\n   199\t      const same = chart.__dev.stages();\n   200\t      chart.update({ data: rows(3).map(r => ({ ...r, v: r.v * 3 })) });\n   201\t      await chart.__bench.ready();\n   202\t      return { before, same, wider: chart.__dev.stages() };\n   203\t    });\n   204\t    expect(result.same.normalize).toBe(result.before.normalize! + 1);\n   205\t    expect(result.same.layout).toBe(result.before.layout);\n   206\t    expect(result.same.scene).toBe(result.before.scene! + 1);\n   207\t    expect(result.wider.layout).toBe(result.before.layout! + 1);\n   208\t    expect(await closePage(page)).toEqual([]);\n   209\t  });\n   210\t\n   211\t  it('a rejected strict update throws and leaves the previous chart intact', async () => {\n   212\t    const page = await chartPage();\n   213\t    const result = await page.evaluate(async () => {\n   214\t      const good = Array.from({ length: 7 }, (_, i) => ({ day: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][i], value: i }));\n   215\t      const chart = window.Axylo.line!('#chart', { title: 'Strict', strict: true, data: good, x: 'day', y: 'value' });\n   216\t      await chart.__bench.ready();\n   217\t      const before = { stages: chart.__dev.stages(), diagnostics: chart.diagnostics, describe: chart.__bench.describe(), revision: chart.__bench.revision };\n   218\t      let thrown = '';\n   219\t      try {\n   220\t        chart.update({ data: window.fx.dirtyRows(), title: 'Changed' });\n   221\t      } catch (e) {\n   222\t        thrown = String(e);\n   223\t      }\n   224\t      await window.nextFrames(3);\n   225\t      return {\n   226\t        thrown, before,\n   227\t        after: { stages: chart.__dev.stages(), diagnostics: chart.diagnostics, describe: chart.__bench.describe(), revision: chart.__bench.revision },\n   228\t        heading: document.querySelector('#chart .axylo-title')!.textContent,\n   229\t      };\n   230\t    });\n   231\t    expect(result.thrown).toMatch(/AX10[236]/);\n   232\t    expect(result.after.diagnostics).toEqual(result.before.diagnostics);\n   233\t    expect(result.after.describe).toEqual(result.before.describe);\n   234\t    expect(result.after.revision).toBe(result.before.revision);\n   235\t    expect(result.after.stages.draw).toBe(result.before.stages.draw);\n   236\t    expect(result.heading).toBe('Strict');\n   237\t    expect(await closePage(page)).toEqual([]);\n   238\t  });\n   239\t\n   240\t  it('a rejected strict append leaves the data as it was', async () => {\n   241\t    const page = await chartPage();\n   242\t    const result = await page.evaluate(async () => {\n   243\t      const t0 = Date.UTC(2026, 0, 1);\n   244\t      const chart = window.Axylo.line!('#chart', { title: 'Strict stream', strict: true, data: [{ t: t0, v: 1 }, { t: t0 + 864e5, v: 2 }], x: { field: 't', type: 'time', timeZone: 'UTC' }, y: 'v' });\n   245\t      let thrown = '';\n   246\t      try {\n   247\t        chart.append([{ t: t0 + 2 * 864e5, v: NaN }]);\n   248\t      } catch (e) {\n   249\t        thrown = String(e);\n   250\t      }\n   251\t      chart.append([{ t: t0 + 2 * 864e5, v: 3 }]);\n   252\t      await chart.__bench.ready();\n   253\t      return { thrown, d: chart.__bench.describe() };\n   254\t    });\n   255\t    expect(result.thrown).toMatch(/AX103/);\n   256\t    expect(result.d.series[0]!.points).toBe(3);\n   257\t    expect(result.d.series[0]!.missing).toBe(0);\n   258\t    expect(await closePage(page)).toEqual([]);\n   259\t  });\n   260\t\n   261\t  it('destroy() before the frame draws nothing, and empties the target of what the chart added', async () => {\n   262\t    const page = await chartPage();\n   263\t    const result = await page.evaluate(async () => {\n   264\t      const el = document.getElementById('chart')!;\n   265\t      el.classList.add('mine');\n   266\t      const chart = window.Axylo.line!(el, { title: 'Gone', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   267\t      chart.destroy();\n   268\t      await window.nextFrames(3);\n   269\t      const stages = chart.__dev.stages();\n   270\t      chart.update({ title: 'Again' });\n   271\t      chart.append([{ day: Date.now(), channel: 'Direct', sessions: 1 }]);\n   272\t      chart.zoom(null);\n   273\t      await window.nextFrames(2);\n   274\t      return { stages, later: chart.__dev.stages(), children: el.childElementCount, className: el.className, attributes: [...el.attributes].map(a => a.name) };\n   275\t    });\n   276\t    expect(result.stages.draw).toBe(0);\n   277\t    expect(result.stages.frame).toBe(0);\n   278\t    expect(result.later).toEqual(result.stages);\n   279\t    expect(result.children).toBe(0);\n   280\t    expect(result.className).toBe('mine');\n   281\t    expect(result.attributes.sort()).toEqual(['class', 'id']);\n   282\t    expect(await closePage(page)).toEqual([]);\n   283\t  });\n   284\t\n   285\t  it('after destroy() no observer or listener fires', async () => {\n   286\t    const page = await chartPage();\n   287\t    const result = await page.evaluate(async () => {\n   288\t      const el = document.getElementById('chart')!;\n   289\t      const chart = window.Axylo.line!(el, { title: 'Gone', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n   290\t      await chart.__bench.ready();\n   291\t      // The pointer listeners sit on the plot, not on the root: dispatch where they were.\n   292\t      const plot = el.querySelector('.axylo-plot')!;\n   293\t      const hovers: unknown[] = [];\n   294\t      chart.on('hover', p => hovers.push(p));\n   295\t      chart.destroy();\n   296\t      const stages = chart.__dev.stages();\n   297\t      el.style.width = '300px';\n   298\t      document.documentElement.classList.add('dark');\n   299\t      document.body.setAttribute('data-theme', 'dark');\n   300\t      plot.dispatchEvent(new PointerEvent('pointermove', { clientX: 100, clientY: 100, bubbles: true }));\n   301\t      if (hovers.length) throw new Error('hover after destroy');\n   302\t      await window.nextFrames(4);\n   303\t      return { stages, later: chart.__dev.stages(), children: el.childElementCount };\n   304\t    });\n   305\t    expect(result.later).toEqual(result.stages);\n   306\t    expect(result.children).toBe(0);\n   307\t    expect(await closePage(page)).toEqual([]);\n   308\t  });\n   309\t});\n   310\t\n   311\tdescribe('memory (spec P7, DX5)', () => {\n   312\t  it('a destroyed handle that the page keeps retains neither the data nor the figure', async () => {\n   313\t    const page = await chartPage();\n   314\t    const cdp = await page.context().newCDPSession(page);\n   315\t    await page.evaluate(async () => {\n   316\t      const el = document.getElementById('chart')!;\n   317\t      const w = window as unknown as { kept: unknown[]; refs: WeakRef<object>[] };\n   318\t      w.kept = [];\n   319\t      w.refs = [];\n   320\t      for (let i = 0; i < 5; i++) {\n   321\t        const rows = Array.from({ length: 1000 }, (_, k) => ({ x: k, y: k % 17 }));\n   322\t        const chart = window.Axylo.line!(el, { title: 'Kept', data: rows, x: 'x', y: 'y' });\n   323\t        await chart.__bench.ready();\n   324\t        chart.append([{ x: 1000, y: 1 }], { keep: 500 });\n   325\t        await chart.__bench.ready();\n   326\t        w.refs.push(new WeakRef(rows), new WeakRef(el.querySelector('figure')!));\n   327\t        chart.destroy();\n   328\t        w.kept.push(chart);\n   329\t      }\n   330\t    });\n   331\t    await cdp.send('HeapProfiler.collectGarbage');\n   332\t    await cdp.send('HeapProfiler.collectGarbage');\n   333\t    const alive = await page.evaluate(() => (window as unknown as { refs: WeakRef<object>[] }).refs.filter(r => r.deref() !== undefined).length);\n   334\t    expect(alive).toBe(0);\n   335\t    expect(await closePage(page)).toEqual([]);\n   336\t  });\n   337\t\n   338\t  // Method corrected by the coordinator on 2026-11-18. The first version compared cycles 200–400 with 800–1000\n   339\t  // and allowed 5%; it measured 5.3%, and heap snapshots put that growth in the engine's compiled code, which\n   340\t  // keeps growing until about 1,500 cycles and then stops. A leak is growth that does not stop, so the trend is\n   341\t  // now judged after that warm-up, with a tighter allowance (1%). The snapshot test below checks retained\n   342\t  // objects directly.\n   343\t  it('create–destroy cycles show no upward heap trend once the engine has warmed up', async () => {\n   344\t    const page = await chartPage();\n   345\t    const cdp = await page.context().newCDPSession(page);\n   346\t    await cdp.send('HeapProfiler.enable');\n   347\t    const samples: { cycle: number; used: number }[] = [];\n   348\t    const STEP = 25;\n   349\t    for (let cycle = 0; cycle < 2500; cycle += STEP) {\n   350\t      await page.evaluate(async n => {\n   351\t        const el = document.getElementById('chart')!;\n   352\t        const rows = window.fx.trendRows();\n   353\t        for (let i = 0; i < n; i++) {\n   354\t          const chart = window.Axylo.line!(el, { title: 'Cycle', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n   355\t          await chart.__bench.ready();\n   356\t          chart.destroy();\n   357\t        }\n   358\t      }, STEP);\n   359\t      await cdp.send('HeapProfiler.collectGarbage');\n   360\t      await cdp.send('HeapProfiler.collectGarbage');\n   361\t      const { usedSize } = await cdp.send('Runtime.getHeapUsage');\n   362\t      samples.push({ cycle: cycle + STEP, used: usedSize });\n   363\t    }\n   364\t    const mean = (from: number, to: number) => {\n   365\t      const s = samples.filter(x => x.cycle > from && x.cycle <= to);\n   366\t      return s.reduce((a, b) => a + b.used, 0) / s.length;\n   367\t    };\n   368\t    const early = mean(1500, 2000);\n   369\t    const late = mean(2000, 2500);\n   370\t    expect(late / early, `heap mean cycles 1500–2000: ${Math.round(early)} B, 2000–2500: ${Math.round(late)} B`).toBeLessThanOrEqual(1.01);\n   371\t    const leftovers = await page.evaluate(() => document.getElementById('chart')!.childElementCount);\n   372\t    expect(leftovers).toBe(0);\n   373\t    expect(await closePage(page)).toEqual([]);\n   374\t  }, 600_000);\n   375\t\n   376\t  // Supplementary to the test above. On this machine the heap measured that way grows by about 6% between\n   377\t  // cycles 200–400 and 800–1000 and levels off after about 1,500 cycles; heap snapshots attribute the growth\n   378\t  // to compiled code (V8 InstructionStream, Code and their metadata), not to objects the chart retains. This\n   379\t  // test counts only what a leak would leave: every heap object except compiled code and V8's own metadata.\n   380\t  it('objects other than compiled code do not grow from cycle 300 to cycle 1,000', async () => {\n   381\t    const page = await chartPage();\n   382\t    const cdp = await page.context().newCDPSession(page);\n   383\t    const cycles = (n: number) => page.evaluate(async k => {\n   384\t      const el = document.getElementById('chart')!;\n   385\t      const rows = window.fx.trendRows();\n   386\t      for (let i = 0; i < k; i++) {\n   387\t        const chart = window.Axylo.line!(el, { title: 'Cycle', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n   388\t        await chart.__bench.ready();\n   389\t        chart.destroy();\n   390\t      }\n   391\t    }, n);\n   392\t    const retained = async (): Promise<number> => {\n   393\t      await cdp.send('HeapProfiler.collectGarbage');\n   394\t      const chunks: string[] = [];\n   395\t      const onChunk = (e: { chunk: string }) => chunks.push(e.chunk);\n   396\t      cdp.on('HeapProfiler.addHeapSnapshotChunk', onChunk);\n   397\t      await cdp.send('HeapProfiler.takeHeapSnapshot', { reportProgress: false });\n   398\t      cdp.off('HeapProfiler.addHeapSnapshotChunk', onChunk);\n   399\t      const snap = JSON.parse(chunks.join('')) as { snapshot: { meta: { node_fields: string[]; node_types: [string[]] } }; nodes: number[]; strings: string[] };\n   400\t      const fields = snap.snapshot.meta.node_fields;\n   401\t      const types = snap.snapshot.meta.node_types[0];\n   402\t      const typeAt = fields.indexOf('type');\n   403\t      const nameAt = fields.indexOf('name');\n   404\t      const sizeAt = fields.indexOf('self_size');\n   405\t      let total = 0;\n   406\t      for (let i = 0; i < snap.nodes.length; i += fields.length) {\n   407\t        const type = types[snap.nodes[i + typeAt]!];\n   408\t        const name = snap.strings[snap.nodes[i + nameAt]!]!;\n   409\t        if (type === 'code' || name.startsWith('system / ')) continue;\n   410\t        total += snap.nodes[i + sizeAt]!;\n   411\t      }\n   412\t      return total;\n   413\t    };\n   414\t    await cycles(300);\n   415\t    const early = await retained();\n   416\t    await cycles(700);\n   417\t    const late = await retained();\n   418\t    // One leaked chart (its DOM, frame and scene) is several kilobytes; 700 of them