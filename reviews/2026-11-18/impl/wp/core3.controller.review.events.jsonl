{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/core/controller.test.ts'","aggregated_output":"     1\t/**\n     2\t * The controller's commit contract (plan 1.5, 2.2; spec 3.5, DX5), driven in Node through a recording host\n     3\t * with a manual animation-frame queue (test/core/host.ts). One block per finding of the core review\n     4\t * (reviews/2026-11-18/impl/wp/core1.review.md); expected values come from the plan and the spec.\n     5\t */\n     6\timport { describe, expect, it } from 'vitest';\n     7\timport type { AlignedView, DatumRef, DonutView, ScatterView } from '../../src/core/contracts';\n     8\timport type { Diagnostic, Point } from '../../src/public';\n     9\timport { validate } from '../../src/index';\n    10\timport { lastModel, record, type Recording } from './host';\n    11\t\n    12\tconst codes = (list: readonly { code: string }[]) => list.map(d => d.code).sort();\n    13\tconst describeOf = (r: Recording) => r.controller.handle.__bench!.describe();\n    14\tconst stages = (r: Recording) => r.controller.handle.__dev!.stages();\n    15\tconst xs = (r: Recording) => {\n    16\t  const view = r.committed!.view as AlignedView;\n    17\t  return Array.from(view.frame.x.values);\n    18\t};\n    19\tconst rowsOf = (values: readonly number[], field = 'y') => values.map(x => ({ x, [field]: x * 10 }));\n    20\t\n    21\tfunction catching(run: () => void): unknown {\n    22\t  try {\n    23\t    run();\n    24\t  } catch (error) {\n    25\t    return error;\n    26\t  }\n    27\t  return null;\n    28\t}\n    29\t\n    30\tdescribe('finding 1: a strict append is prepared, validated with its view, and only then committed', () => {\n    31\t  it('a ninth series is rejected (AX130), leaves store, frame, view and diagnostics as they were, and later appends work', () => {\n    32\t    const series = Array.from({ length: 8 }, (_, i) => `S${i}`);\n    33\t    const data = series.flatMap(s => [{ x: 1, s, y: 1 }, { x: 2, s, y: 2 }]);\n    34\t    const r = record('line', { title: 'Strict', strict: true, data, x: 'x', y: 'y', series: 's' });\n    35\t    r.frames();\n    36\t    const chart = r.controller.handle;\n    37\t    const before = { diagnostics: chart.diagnostics, describe: describeOf(r), revision: chart.__bench!.revision };\n    38\t    const error = catching(() => chart.append([{ x: 3, s: 'S8', y: 3 }]));\n    39\t    expect(String(error)).toMatch(/AX130/);\n    40\t    r.frames();\n    41\t    expect(chart.diagnostics).toEqual(before.diagnostics);\n    42\t    expect(describeOf(r)).toEqual(before.describe);\n    43\t    expect(chart.__bench!.revision).toBe(before.revision);\n    44\t    // A valid append to an existing series goes through.\n    45\t    chart.append([{ x: 3, s: 'S0', y: 3 }]);\n    46\t    r.frames();\n    47\t    expect(describeOf(r).series.length).toBe(8);\n    48\t    expect(describeOf(r).series[0]!.newestX).toBe(3);\n    49\t    // The rejected ninth series never entered the store.\n    50\t    chart.update({ strict: false });\n    51\t    r.frames();\n    52\t    expect(describeOf(r).series.map(s => s.key)).toEqual(series);\n    53\t  });\n    54\t\n    55\t  it('a rejected strict append is still delivered to onDiagnostic and the console, without replacing diagnostics', () => {\n    56\t    const seen: Diagnostic[] = [];\n    57\t    const r = record('line', { title: 'Strict', strict: true, data: rowsOf([1, 2]), x: 'x', y: 'y', onDiagnostic: (d: Diagnostic) => seen.push(d) });\n    58\t    r.frames();\n    59\t    expect(catching(() => r.controller.handle.append([{ x: 3, y: NaN }]))).toBeTruthy();\n    60\t    expect(codes(seen)).toEqual(['AX103']);\n    61\t    expect(r.printed.some(line => line.includes('AX103'))).toBe(true);\n    62\t    expect(r.controller.handle.diagnostics).toEqual([]);\n    63\t  });\n    64\t});\n    65\t\n    66\tdescribe('finding 2: an encoding change after streaming re-encodes the retained rows', () => {\n    67\t  it('[1,2,3] + 4 with keep 2 shows [3,4]; a new y field keeps [3,4] in a new epoch, and focus refs are cleared', () => {\n    68\t    const data = [1, 2, 3].map(x => ({ x, a: x, b: -x }));\n    69\t    const r = record('line', { title: 'Stream', data, x: 'x', y: 'a' });\n    70\t    r.frames();\n    71\t    r.controller.handle.append([{ x: 4, a: 4, b: -4 }], { keep: 2 });\n    72\t    r.frames();\n    73\t    expect(xs(r)).toEqual([3, 4]);\n    74\t    const epoch = r.committed!.epoch;\n    75\t    r.controller.handle.update({ y: 'b' });\n    76\t    r.frames();\n    77\t    expect(xs(r)).toEqual([3, 4]);\n    78\t    const view = r.committed!.view as AlignedView;\n    79\t    expect(Array.from(view.frame.series[0]!.y)).toEqual([-3, -4]);\n    80\t    expect(r.committed!.epoch).toBeGreaterThan(epoch);\n    81\t  });\n    82\t\n    83\t  it('a chart created empty and filled by append keeps its rows when re-encoded', () => {\n    84\t    const r = record('line', { title: 'Empty', data: [], x: 'x', y: 'a' });\n    85\t    r.frames();\n    86\t    r.controller.handle.append([{ x: 1, a: 1, b: 2 }, { x: 2, a: 2, b: 3 }]);\n    87\t    r.frames();\n    88\t    r.controller.handle.update({ y: 'b' });\n    89\t    r.frames();\n    90\t    expect(xs(r)).toEqual([1, 2]);\n    91\t  });\n    92\t\n    93\t  it('update({ data }) replaces the stream, even with the original array', () => {\n    94\t    const data = rowsOf([1, 2, 3]);\n    95\t    const r = record('line', { title: 'Replace', data, x: 'x', y: 'y' });\n    96\t    r.frames();\n    97\t    r.controller.handle.append([{ x: 4, y: 40 }]);\n    98\t    r.frames();\n    99\t    expect(xs(r)).toEqual([1, 2, 3, 4]);\n   100\t    r.controller.handle.update({ data });\n   101\t    r.frames();\n   102\t    expect(xs(r)).toEqual([1, 2, 3]);\n   103\t  });\n   104\t});\n   105\t\n   106\tdescribe('finding 3: rows of the displayed revision stay readable until the frame that replaced it is drawn', () => {\n   107\t  it('appending with keep 1 does not change a hover on the frame still shown', () => {\n   108\t    const data = [0, 1, 2].map(x => ({ x, y: x }));\n   109\t    const r = record('line', { title: 'Evict', data, x: 'x', y: 'y' });\n   110\t    r.frames();\n   111\t    const hovers: (Point<unknown> | null)[] = [];\n   112\t    r.controller.handle.on('hover', p => hovers.push(p));\n   113\t    r.controller.handle.append([{ x: 3, y: 3 }], { keep: 1 });\n   114\t    const ref: DatumRef = { kind: 'aligned', seriesKey: 'y', x: 0 };\n   115\t    r.controller.actions.hover(ref);\n   116\t    expect(hovers[0]).toEqual({ series: 'y', x: 0, y: 0, row: data[0], index: 0 });\n   117\t    r.frames();\n   118\t    expect(xs(r)).toEqual([3]);\n   119\t    // Once the new frame is drawn the old revision is retired: only the kept row is held.\n   120\t    expect(r.controller.handle.__dev!.retainedRows()).toBe(1);\n   121\t  });\n   122\t});\n   123\t\n   124\tdescribe('finding 4: an internal failure publishes a complete error revision, and recovery redraws everything', () => {\n   125\t  it('after a failing frame the pointer finds nothing; once the cause is gone an update draws axis labels again', async () => {\n   126\t    const r = record('line', { title: 'Fail', data: rowsOf([1, 2, 3, 4]), x: 'x', y: 'y' });\n   127\t    r.frames();\n   128\t    const labels = r.texts.at(-1)!.length;\n   129\t    expect(labels).toBeGreaterThan(2);\n   130\t    const hovers: unknown[] = [];\n   131\t    r.controller.handle.on('hover', p => hovers.push(p));\n   132\t    r.controller.handle.__dev!.fail('reader');\n   133\t    r.controller.handle.update({ title: 'Fail 2' });\n   134\t    r.frames();\n   135\t    expect(lastModel(r).message).toBe('Something went wrong while drawing the chart.');\n   136\t    expect(r.committed).toBeNull();\n   137\t    expect(r.texts.at(-1)).toEqual([]);\n   138\t    expect(codes(r.controller.handle.diagnostics)).toEqual(['AX199']);\n   139\t    r.controller.actions.hover({ kind: 'aligned', seriesKey: 'y', x: 2 });\n   140\t    expect(hovers).toEqual([null]);\n   141\t    // Readiness settles on the error revision.\n   142\t    await r.controller.handle.__bench!.ready();\n   143\t    r.controller.handle.__dev!.fail(null);\n   144\t    r.controller.handle.update({ title: 'Recovered' });\n   145\t    r.frames();\n   146\t    expect(lastModel(r).message).toBeNull();\n   147\t    expect(r.texts.at(-1)!.length).toBe(labels);\n   148\t    expect(r.committed?.ready).toBe(true);\n   149\t    expect(r.controller.handle.diagnostics).toEqual([]);\n   150\t  });\n   151\t});\n   152\t\n   153\tdescribe('finding 5: zoom and select events', () => {\n   154\t  it('a zoom from the controls fires zoom with the window as the author writes it; a select fires select', () => {\n   155\t    const r = record('line', { title: 'Events', data: rowsOf([0, 5, 10]), x: 'x', y: 'y' });\n   156\t    r.frames();\n   157\t    const zooms: unknown[] = [];\n   158\t    const selects: unknown[] = [];\n   159\t    r.controller.handle.on('zoom', w => zooms.push(w));\n   160\t    r.controller.handle.on('select', p => selects.push(p));\n   161\t    r.controller.actions.zoom([5, 10]);\n   162\t    r.controller.actions.zoom(null);\n   163\t    r.frames();\n   164\t    r.controller.actions.select({ kind: 'aligned', seriesKey: 'y', x: 5 });\n   165\t    expect(zooms).toEqual([[5, 10], null]);\n   166\t    expect(selects).toEqual([{ series: 'y', x: 5, y: 50, row: { x: 5, y: 50 }, index: 1 }]);\n   167\t  });\n   168\t});\n   169\t\n   170\tdescribe('finding 6: author callbacks cannot repeat a delivery or continue work after destruction', () => {\n   171\t  it('an onDiagnostic that updates the description is given each diagnostic once', () => {\n   172\t    const seen: string[] = [];\n   173\t    let chart: Recording['controller']['handle'] | null = null;\n   174\t    const r = record('line', {\n   175\t      data: rowsOf([1, 2]), x: 'x', y: 'y',\n   176\t      onDiagnostic: (d: Diagnostic) => { seen.push(d.code); chart?.update({ description: `seen ${seen.length}` }); },\n   177\t    });\n   178\t    chart = r.controller.handle;\n   179\t    chart.update({ subtitle: 'again' });\n   180\t    r.frames();\n   181\t    expect(seen).toEqual(['AX140']);\n   182\t  });\n   183\t\n   184\t  it('an onDiagnostic that destroys the chart on its first diagnostic receives no other', () => {\n   185\t    const seen: string[] = [];\n   186\t    const r = record('line', { title: 'Clean', data: rowsOf([1, 2]), x: 'x', y: 'y' });\n   187\t    const chart = r.controller.handle;\n   188\t    // Three findings (AX103, AX106, AX140) arrive with one update; the handler destroys on the first.\n   189\t    chart.update({\n   190\t      title: undefined, data: [{ x: 1, y: NaN }, { x: 2, y: '3' }, { x: 3, y: 1 }],\n   191\t      onDiagnostic: (d: Diagnostic) => { seen.push(d.code); chart.destroy(); },\n   192\t    });\n   193\t    r.frames();\n   194\t    expect(seen.length).toBe(1);\n   195\t    expect(r.draws.length).toBe(0);\n   196\t    expect(r.disposed).toBe(1);\n   197\t  });\n   198\t\n   199\t  it('a hover listener that destroys the chart stops the listeners after it', () => {\n   200\t    const r = record('line', { title: 'H', data: rowsOf([1, 2]), x: 'x', y: 'y' });\n   201\t    r.frames();\n   202\t    const calls: string[] = [];\n   203\t    r.controller.handle.on('hover', () => { calls.push('first'); r.controller.handle.destroy(); });\n   204\t    r.controller.handle.on('hover', () => { calls.push('second'); });\n   205\t    r.controller.actions.hover({ kind: 'aligned', seriesKey: 'y', x: 1 });\n   206\t    expect(calls).toEqual(['first']);\n   207\t  });\n   208\t\n   209\t  it('a formatter that destroys the chart during a frame stops that frame before anything is drawn', () => {\n   210\t    let destroy = (): void => {};\n   211\t    const r = record('line', {\n   212\t      title: 'F', data: rowsOf([1, 2]), x: 'x',\n   213\t      y: { field: 'y', format: (v: number) => { destroy(); return String(v); } },\n   214\t    });\n   215\t    destroy = () => r.controller.handle.destroy();\n   216\t    r.frames();\n   217\t    expect(r.draws.length).toBe(0);\n   218\t    expect(r.commits).toBe(0);\n   219\t    expect(r.disposed).toBe(1);\n   220\t    expect(describeOf(r)).toEqual({ xDomain: null, yDomain: null, series: [], renderer: 'svg' });\n   221\t  });\n   222\t});\n   223\t\n   224\tdescribe('finding 7: scatter and donut append through their stores', () => {\n   225\t  it('scatter [10, 20] + 5 with keep 2 keeps the latest two x positions [10, 20] and raises AX151', () => {\n   226\t    const r = record('scatter', { title: 'S', data: [{ x: 10, y: 1 }, { x: 20, y: 2 }], x: 'x', y: 'y' });\n   227\t    r.frames();\n   228\t    r.controller.handle.append([{ x: 5, y: 3 }], { keep: 2 });\n   229\t    r.frames();\n   230\t    const view = r.committed!.view as ScatterView;\n   231\t    expect(Array.from(view.frame.series[0]!.x)).toEqual([10, 20]);\n   232\t    expect(codes(r.controller.handle.diagnostics)).toContain('AX151');\n   233\t  });\n   234\t\n   235\t  it('a silent NaN in typed columns stays silent after a clean append (scatter and donut)', () => {\n   236\t    const s = record('scatter', { title: 'S', data: { columns: { x: Float64Array.of(1, 2, 3), y: Float64Array.of(1, NaN, 3) } }, x: 'x', y: 'y' });\n   237\t    s.frames();\n   238\t    s.controller.handle.append([{ x: 4, y: 4 }]);\n   239\t    s.frames();\n   240\t    expect(s.controller.handle.diagnostics).toEqual([]);\n   241\t    const d = record('donut', { title: 'D', data: { columns: { label: ['a', 'b'], value: Float64Array.of(1, NaN) } }, label: 'label', value: 'value' });\n   242\t    d.frames();\n   243\t    d.controller.handle.append([{ label: 'c', value: 2 }]);\n   244\t    d.frames();\n   245\t    expect(d.controller.handle.diagnostics).toEqual([]);\n   246\t    expect((d.committed!.view as DonutView).frame.labels).toEqual(['a', 'b', 'c']);\n   247\t  });\n   248\t\n   249\t  it('while paused, scatter and donut validate appended rows when append is called', () => {\n   250\t    const r = record('scatter', { title: 'P', strict: true, data: [{ x: 1, y: 1 }], x: 'x', y: 'y' });\n   251\t    r.frames();\n   252\t    r.controller.handle.append([{ x: 2, y: 2 }]);\n   253\t    r.controller.actions.pause(true);\n   254\t    r.frames();\n   255\t    expect(String(catching(() => r.controller.handle.append([{ x: 3, y: NaN }])))).toMatch(/AX103/);\n   256\t    r.controller.handle.append([{ x: 3, y: 3 }]);\n   257\t    r.frames();\n   258\t    expect(Array.from((r.committed!.view as ScatterView).frame.series[0]!.x)).toEqual([1, 2]);\n   259\t    r.controller.actions.pause(false);\n   260\t    r.frames();\n   261\t    expect(Array.from((r.committed!.view as ScatterView).frame.series[0]!.x)).toEqual([1, 2, 3]);\n   262\t  });\n   263\t});\n   264\t\n   265\tdescribe('finding 8: \"nothing to show\" comes from what the view draws', () => {\n   266\t  it('a line segment that crosses a zoomed window between its two points is drawn, not \"No data\"', () => {\n   267\t    const r = record('line', { title: 'Z', data: [{ x: 0, y: 0 }, { x: 10, y: 10 }], x: 'x', y: 'y' });\n   268\t    r.controller.handle.zoom([2, 4]);\n   269\t    r.frames();\n   270\t    expect(lastModel(r).message).toBeNull();\n   271\t    expect(r.draws.at(-1)!.marks.some(m => m.type === 'path')).toBe(true);\n   272\t  });\n   273\t\n   274\t  it('a scatter window with no point shows the empty state, and its zoom can still be reset', () => {\n   275\t    const r = record('scatter', { title: 'Z', data: [{ x: 0, y: 0 }, { x: 10, y: 10 }], x: 'x', y: 'y' });\n   276\t    r.controller.handle.zoom([2, 4]);\n   277\t    r.frames();\n   278\t    expect(lastModel(r).message).toBe('No data to show.');\n   279\t    expect(r.prepared.at(-1)!.zoomed).toBe(true);\n   280\t  });\n   281\t\n   282\t  it('an all-invalid chart keeps the reader note in its empty state (F12), and the compact marker (C5)', () => {\n   283\t    const data = [{ x: 1, y: 'n/a' }, { x: 2, y: 'n/a' }];\n   284\t    const full = record('line', { title: 'Bad', data, x: 'x', y: 'y' });\n   285\t    full.frames();\n   286\t    expect(lastModel(full).message).toBe('No data to show.');\n   287\t    expect(lastModel(full).note).toMatch(/Values not shown: 2/);\n   288\t    const compact = record('line', { title: 'Bad', compact: true, data, x: 'x', y: 'y' });\n   289\t    compact.frames();\n   290\t    expect(lastModel(compact).note).toMatch(/Values not shown: 2/);\n   291\t    expect(lastModel(compact).summary).toMatch(/^No data to show\\./);\n   292\t  });\n   293\t});\n   294\t\n   295\tdescribe('finding 9: the zoom window and the follow flag are reconciled when data or bounds change', () => {\n   296\t  it('[5,10] of [0,5,10]; data replaced up to 15: the window stays [5,10], and appending 20 does not move it', () => {\n   297\t    const r = record('line', { title: 'F', data: rowsOf([0, 5, 10]), x: 'x', y: 'y' });\n   298\t    r.controller.handle.zoom([5, 10]);\n   299\t    r.controller.handle.update({ data: rowsOf([0, 5, 10, 15]) });\n   300\t    r.frames();\n   301\t    expect(describeOf(r).xDomain).toEqual([5, 10]);\n   302\t    r.controller.handle.append([{ x: 20, y: 200 }]);\n   303\t    r.frames();\n   304\t    expect(describeOf(r).xDomain).toEqual([5, 10]);\n   305\t  });\n   306\t\n   307\t  it('a window at the latest edge follows appended data', () => {\n   308\t    const r = record('line', { title: 'F', data: rowsOf([0, 5, 10]), x: 'x', y: 'y' });\n   309\t    r.controller.handle.zoom([5, 10]);\n   310\t    r.controller.handle.append([{ x: 15, y: 150 }]);\n   311\t    r.frames();\n   312\t    expect(describeOf(r).xDomain).toEqual([10, 15]);\n   313\t  });\n   314\t});\n   315\t\n   316\tdescribe('finding 10: one set of call-origin diagnostics, whatever the entry point', () => {\n   317\t  const bar = { title: 'B', data: [{ x: 'a', y: 2 }, { x: 'b', y: 3 }], x: 'x', y: { field: 'y', domain: [1, 3] } } as const;\n   318\t\n   319\t  it('validate and a created bar chart both report AX110; a clean append keeps it while the domain excludes zero', () => {\n   320\t    expect(codes(validate('bar', bar as never))).toEqual(['AX110']);\n   321\t    const r = record('bar', { ...bar });\n   322\t    expect(codes(r.controller.handle.diagnostics)).toEqual(['AX110']);\n   323\t    r.controller.handle.append([{ x: 'c', y: 2 }]);\n   324\t    expect(codes(r.controller.handle.diagnostics)).toEqual(['AX110']);\n   325\t  });\n   326\t\n   327\t  it('validate and creation agree on AX130 and AX131 too', () => {\n   328\t    const many = Array.from({ length: 9 }, (_, i) => ({ x: 1, s: `S${i}`, y: i }));\n   329\t    const options = { title: 'M', data: many, x: 'x', y: 'y', series: 's', compact: true };\n   330\t    const created = record('line', options).controller.handle.diagnostics;\n   331\t    expect(codes(validate('line', options as never))).toEqual(codes(created));\n   332\t    expect(codes(created)).toEqual(['AX130', 'AX131']);\n   333\t  });\n   334\t\n   335\t  it('zoom never throws for a value it cannot read: it reports it and keeps the window', () => {\n   336\t    const seen: string[] = [];\n   337\t    const r = record('line', { title: 'Z', strict: true, data: rowsOf([1, 2, 3]), x: 'x', y: 'y', onDiagnostic: (d: Diagnostic) => seen.push(d.code) });\n   338\t    r.controller.handle.zoom([1, 2]);\n   339\t    expect(() => r.controller.handle.zoom(['oops', 'bad'])).not.toThrow();\n   340\t    r.frames();\n   341\t    expect(seen).toEqual(['AX107']);\n   342\t    expect(r.controller.handle.diagnostics).toEqual([]);\n   343\t    expect(describeOf(r).xDomain).toEqual([1, 2]);\n   344\t  });\n   345\t});\n   346\t\n   347\tdescribe('finding 11: presentation diagnostics belong to the stage and revision that found them', () => {\n   348\t  it('a tick formatter that throws gives AX160 and the reader note on that frame; a working one retires both', () => {\n   349\t    const throwing = { field: 'y', tickFormat: () => { throw new Error('tick'); } };\n   350\t    const r = record('line', { title: 'T', data: rowsOf([1, 2, 3]), x: 'x', y: throwing });\n   351\t    r.frames();\n   352\t    expect(codes(r.controller.handle.diagnostics)).toEqual(['AX160']);\n   353\t    expect(lastModel(r).note).toMatch(/shown differently/);\n   354\t    r.controller.handle.update({ y: { field: 'y', tickFormat: (v: number) => `${v}!` } });\n   355\t    r.frames();\n   356\t    expect(r.controller.handle.diagnostics).toEqual([]);\n   357\t    expect(lastModel(r).note).toBeNull();\n   358\t  });\n   359\t\n   360\t  it('a formatter that throws only for a hovered value is delivered when it is found', () => {\n   361\t    const seen: string[] = [];\n   362\t    const r = record('line', {\n   363\t      title: 'H', data: rowsOf([1, 2, 3]), x: 'x', onDiagnostic: (d: Diagnostic) => seen.push(d.code),\n   364\t      y: { field: 'y', format: (v: number) => { if (v === 20) throw new Error('hovered'); return String(v); } },\n   365\t    });\n   366\t    r.frames();\n   367\t    expect(seen).toEqual([]);\n   368\t    r.controller.actions.hover({ kind: 'aligned', seriesKey: 'y', x: 2 });\n   369\t    r.committed!.lookup.tooltip({ kind: 'x', x: 2 });\n   370\t    expect(seen).toEqual(['AX160']);\n   371\t  });\n   372\t});\n   373\t\n   374\tdescribe('finding 13: the L8 fallback is stable', () => {\n   375\t  it('stepping the container one pixel at a time through the boundary, both ways, switches once and never alternates', () => {\n   376\t    const r = record('line', { title: 'Small', data: rowsOf([1, 2, 3]), x: 'x', y: 'y' });\n   377\t    const states = (heights: number[]) => heights.map(height => {\n   378\t      r.container = { width: 400, height };\n   379\t      r.controller.invalidate.resize();\n   380\t      r.frames();\n   381\t      const settled = r.committed!.tooSmall;\n   382\t      // Ten more frames at the same size change nothing.\n   383\t      for (let i = 0; i < 10; i++) {\n   384\t        r.controller.invalidate.resize();\n   385\t        r.frames();\n   386\t        expect(r.committed!.tooSmall, `height ${height}, frame ${i}`).toBe(settled);\n   387\t      }\n   388\t      return settled;\n   389\t    });\n   390\t    const up = Array.from({ length: 80 }, (_, i) => 100 + i);\n   391\t    const grow = states(up);\n   392\t    const shrink = states([...up].reverse()).reverse();\n   393\t    expect(grow).toEqual(shrink);\n   394\t    const switches = grow.filter((v, i) => i > 0 && v !== grow[i - 1]).length;\n   395\t    expect(switches).toBe(1);\n   396\t    expect(grow[0]).toBe(true);\n   397\t    expect(grow.at(-1)).toBe(false);\n   398\t  });\n   399\t});\n   400\t\n   401\tdescribe('finding 15: bars on a continuous x use the view domain for ticks, marks and lookup', () => {\n   402\t  it('with x.domain [0, 20] no tick lies outside [0, 20], and the projection is the view domain', () => {\n   403\t    const r = record('bar', { title: 'B', data: [{ x: 5, y: 1 }, { x: 10, y: 2 }, { x: 15, y: 3 }], x: { field: 'x', domain: [0, 20] }, y: 'y' });\n   404\t    r.frames();\n   405\t    const layout = r.committed!.layout;\n   406\t    if (layout.kind !== 'plot' || layout.projection.kind !== 'bands') throw new Error('expected a bar layout');\n   407\t    const view = r.committed!.view as AlignedView;\n   408\t    expect(view.xDomain).toEqual([0, 20]);\n   409\t    expect((layout.projection.band as { domain: readonly number[] }).domain).toEqual([0, 20]);\n   410\t    for (const tick of layout.xTicks) {\n   411\t      expect(tick.value).toBeGreaterThanOrEqual(0);\n   412\t      expect(tick.value).toBeLessThanOrEqual(20);\n   413\t    }\n   414\t  });\n   415\t});\n   416\t\n   417\tdescribe('finding 16: a pinned donut color lands on its own slice', () => {\n   418\t  it('Empty: 0 before Sales: 4 with Sales pinned: the theme binds the pin to the palette slot the Sales arc uses', () => {\n   419\t    const r = record('donut', { title: 'D', data: [{ l: 'Empty', v: 0 }, { l: 'Sales', v: 4 }], label: 'l', value: 'v', colors: { Sales: 'red' } });\n   420\t    r.frames();\n   421\t    const view = r.committed!.view as DonutView;\n   422\t    const sales = view.slices.find(s => s.label === 'Sales')!;\n   423\t    const keys = r.themeCalls.at(-1)!.keys;\n   424\t    expect(keys[sales.colorIndex!]).toBe('Sales');\n   425\t    const arcs = r.draws.at(-1)!.marks.find(m => m.type === 'arcs');\n   426\t    if (!arcs || arcs.type !== 'arcs') throw new Error('expected arcs');\n   427\t    expect(arcs.fills).toContainEqual({ kind: 'series', index: sales.colorIndex });\n   428\t  });\n   429\t});\n   430\t\n   431\tdescribe('finding 17: a static chart borrows typed columns; author bounds do not renormalize', () => {\n   432\t  it('ascending Float64Array x and y are shared by the frame; x.domain, a value domain, reference, zoom and colors keep it', () => {\n   433\t    const t = Float64Array.of(1, 2, 3, 4);\n   434\t    const v = Float64Array.of(5, 6, 7, 8);\n   435\t    const r = record('line', { title: 'Borrowed', data: { columns: { t, v } }, x: 't', y: 'v' });\n   436\t    r.frames();\n   437\t    const frame = (r.committed!.view as AlignedView).frame;\n   438\t    expect(frame.x.values.buffer).toBe(t.buffer);\n   439\t    expect(frame.series[0]!.y.buffer).toBe(v.buffer);\n   440\t    const normalized = stages(r).normalize;\n   441\t    r.controller.handle.update({ x: { field: 't', domain: [0, 5] } });\n   442\t    r.controller.handle.update({ y: { field: 'v', domain: [0, 10] } });\n   443\t    r.controller.handle.update({ reference: [{ y: 6, label: 'Six' }] });\n   444\t    r.controller.handle.update({ zoom: false });\n   445\t    r.controller.handle.update({ colors: { v: 'red' } });\n   446\t    r.frames();\n   447\t    expect(stages(r).normalize).toBe(normalized);\n   448\t    expect((r.committed!.view as AlignedView).frame).toBe(frame);\n   449\t  });\n   450\t});\n   451\t\n   452\tdescribe('finding 18: a caption-only update reruns only the reader', () => {\n   453\t  it('every stage but options, frame, reader and figure keeps its count', () => {\n   454\t    const r = record('scatter', { title: 'Before', data: rowsOf([1, 2, 3]), x: 'x', y: 'y' });\n   455\t    r.frames();\n   456\t    const before = stages(r);\n   457\t    r.controller.handle.update({ description: 'Now with a description.' });\n   458\t    r.frames();\n   459\t    const after = stages(r);\n   460\t    const changed = Object.keys(after).filter(k => after[k as keyof typeof after] !== before[k as keyof typeof before]).sort();\n   461\t    expect(changed).toEqual(['figure', 'frame', 'options', 'reader']);\n   462\t    expect(after.reader - before.reader).toBe(1);\n   463\t  });\n   464\t\n   465\t  it('an aligned line whose interior sample count changes, with the same ranges, does not relayout', () => {\n   466\t    const r = record('line', { title: 'L', data: rowsOf([0, 5, 10]), x: 'x', y: 'y' });\n   467\t    r.frames();\n   468\t    const before = stages(r).layout;\n   469\t    r.controller.handle.update({ data: rowsOf([0, 2, 5, 7, 10]) });\n   470\t    r.frames();\n   471\t    expect(stages(r).layout).toBe(before);\n   472\t  });\n   473\t});\n   474\t\n   475\tdescribe('finding 19: naming and state text', () => {\n   476\t  it('a labelledBy that names nothing falls back to the generated name and raises AX140', () => {\n   477\t    const r = record('line', { labelledBy: 'missing', data: rowsOf([1, 2]), x: 'x', y: 'y' });\n   478\t    r.frames();\n   479\t    expect(lastModel(r).labelledBy).toBeNull();\n   480\t    expect(lastModel(r).name).toBe('Line chart of y by x');\n   481\t    expect(codes(r.controller.handle.diagnostics)).toEqual(['AX140']);\n   482\t    r.ids.missing = 'Now it exists';\n   483\t    r.controller.handle.update({ description: 'redraw' });\n   484\t    r.frames();\n   485\t    expect(lastModel(r).labelledBy).toBe('missing');\n   486\t    expect(r.controller.handle.diagnostics).toEqual([]);\n   487\t  });\n   488\t\n   489\t  it('labelledBy with a title creates no second heading', () => {\n   490\t    const r = record('line', { labelledBy: 'card', title: 'Also a title', data: rowsOf([1, 2]), x: 'x', y: 'y' });\n   491\t    r.ids.card = 'Card heading';\n   492\t    r.frames();\n   493\t    expect(lastModel(r).title).toBeNull();\n   494\t    expect(lastModel(r).labelledBy).toBe('card');\n   495\t  });\n   496\t\n   497\t  it(\"a compact chart's description says its current state\", () => {\n   498\t    for (const [state, text] of [['loading', 'Loading chart.'], [{ error: 'The query failed.' }, 'The query failed.']] as const) {\n   499\t      const r = record('line', { title: 'C', compact: true, state, data: rowsOf([1, 2]), x: 'x', y: 'y' });\n   500\t      r.frames();\n   501\t      expect(lastModel(r).summary).toBe(text);\n   502\t    }\n   503\t  });\n   504\t});\n   505\t\n   506\tdescribe('the stores retire what no displayed frame can address', () => {\n   507\t  it('a long stream with keep holds about keep rows once each frame is drawn', () => {\n   508\t    const r = record('line', { title: 'S', data: rowsOf([0]), x: 'x', y: 'y' });\n   509\t    r.frames();\n   510\t    for (let i = 1; i <= 200; i++) {\n   511\t      r.controller.handle.append([{ x: i, y: i }], { keep: 10 });\n   512\t      if (i % 7 === 0) r.frames();\n   513\t    }\n   514\t    r.frames();\n   515\t    expect(xs(r).length).toBe(10);\n   516\t    expect(r.controller.handle.__dev!.retainedRows()).toBeLessThanOrEqual(10);\n   517\t  });\n   518\t});\n   519\t\n   520\tdescribe('finding 14: typography is read again when a size change or a font load could have changed it', () => {\n   521\t  it('a resize rereads the computed text style; a font load reruns layout with the cached size', () => {\n   522\t    const r = record('line', { title: 'T', data: rowsOf([1, 2, 3]), x: 'x', y: 'y' });\n   523\t    let reads = 0;\n   524\t    const read = r.host.textStyle;\n   525\t    (r.host as { textStyle: () => ReturnType<typeof read> }).textStyle = () => { reads++; return read(); };\n   526\t    r.frames();\n   527\t    const first = reads;\n   528\t    r.frames();\n   529\t    expect(reads).toBe(first);\n   530\t    r.controller.invalidate.resize();\n   531\t    r.frames();\n   532\t    expect(reads).toBe(first + 1);\n   533\t    const layouts = stages(r).layout;\n   534\t    r.controller.invalidate.fonts();\n   535\t    r.frames();\n   536\t    expect(stages(r).layout).toBe(layouts + 1);\n   537\t  });\n   538\t});\n   539\t\n   540\tdescribe('review 2, finding 5: keep bounds what the store holds, paused or not', () => {\n   541\t  it('1,000 appends with keep 3 while paused hold at most the displayed rows plus 3 (scatter and line)', () => {\n   542\t    for (const kind of ['scatter', 'line'] as const) {\n   543\t      const r = record(kind, { title: 'K', data: rowsOf([0, 1, 2]), x: 'x', y: 'y' });\n   544\t      r.frames();\n   545\t      r.controller.handle.append([{ x: 3, y: 3 }], { keep: 3 });\n   546\t      r.frames();\n   547\t      r.controller.actions.pause(true);\n   548\t      for (let i = 4; i < 1004; i++) r.controller.handle.append([{ x: i, y: i }], { keep: 3 });\n   549\t      r.frames();\n   550\t      // The displayed frame (3 rows) stays addressable; the held store keeps 3 more.\n   551\t      expect(r.controller.handle.__dev!.retainedRows(), kind).toBeLessThanOrEqual(6);\n   552\t      r.controller.actions.pause(false);\n   553\t      r.frames();\n   554\t      expect(r.controller.handle.__dev!.retainedRows(), kind).toBeLessThanOrEqual(3);\n   555\t    }\n   556\t  });\n   557\t});\n   558\t\n   559\tdescribe('review 2, finding 1: paused calls validate at the call and apply in call order', () => {\n   560\t  it('a strict paused append that is invalid throws at once; the valid ones around it are shown on resume', () => {\n   561\t    const r = record('line', { title: 'P', strict: true, data: rowsOf([1]), x: 'x', y: 'y' });\n   562\t    r.frames();\n   563\t    r.controller.handle.append([{ x: 2, y: 20 }]);\n   564\t    r.controller.actions.pause(true);\n   565\t    r.controller.handle.append([{ x: 3, y: 30 }]);\n   566\t    expect(String(catching(() => r.controller.handle.append([{ x: 4, y: NaN }])))).toMatch(/AX103/);\n   567\t    r.controller.handle.append([{ x: 5, y: 50 }]);\n   568\t    r.frames();\n   569\t    expect(xs(r)).toEqual([1, 2]);\n   570\t    r.controller.actions.pause(false);\n   571\t    r.frames();\n   572\t    // x = 4 is an absent step of the regular axis (a gap slot, spec F2), not the rejected value.\n   573\t    const view = r.committed!.view as AlignedView;\n   574\t    const values = Array.from(view.frame.x.values).filter((_, i) => view.frame.series[0]!.slot[i] === 0);\n   575\t    expect(values).toEqual([1, 2, 3, 5]);\n   576\t  });\n   577\t});\n   578\t\n   579\tdescribe('the bench describe names the kept samples and the renderer', () => {\n   580\t  it('a dense line keeps its outlier and both ends, never a missing row, and says which renderer draws it', () => {\n   581\t    const n = 10_000;\n   582\t    const y = Float64Array.from({ length: n }, (_, i) => (i === 5000 ? 1000 : i % 3));\n   583\t    y[7000] = NaN;\n   584\t    const r = record('line', { title: 'Dense', data: { columns: { x: Float64Array.from({ length: n }, (_, i) => i), y } }, x: 'x', y: 'y' });\n   585\t    r.frames();\n   586\t    const d = describeOf(r);\n   587\t    expect(d.renderer).toBe('svg');\n   588\t    const kept = d.series[0]!.kept!;\n   589\t    expect(kept.length).toBeLessThan(n / 4);\n   590\t    expect(kept).toContain(5000);\n   591\t    expect(kept[0]).toBe(0);\n   592\t    expect(kept.at(-1)).toBe(n - 1);\n   593\t    expect(kept).not.toContain(7000);\n   594\t  });\n   595\t});\n","exit_code":0,"status":"completed"}}
