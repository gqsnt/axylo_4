d: ResolvedOptions;\n   360\t    readonly source: ResolvedOptions;\n   361\t    readonly store: Store | null;\n   362\t    readonly frame: Frame;\n   363\t    readonly dataDiagnostics: readonly DiagnosticInput[];\n   364\t    readonly dataOptions: readonly DiagnosticInput[];\n   365\t    readonly optionDiagnostics: readonly DiagnosticInput[];\n   366\t    readonly zoom: Span<XValue> | null;\n   367\t    readonly hidden: ReadonlySet<string>;\n   368\t    readonly messages: Messages;\n   369\t  }\n   370\t\n   371\t  interface Viewed {\n   372\t    readonly view: View;\n   373\t    readonly viewKey: readonly unknown[];\n   374\t    readonly viewDiagnostics: readonly DiagnosticInput[];\n   375\t    /** What this build found that the previous view did not have. */\n   376\t    readonly found: readonly DiagnosticInput[];\n   377\t  }\n   378\t\n   379\t  function viewFor(c: Candidate, previous: Accepted | null): Viewed {\n   380\t    const key = viewKeyFor(kind, c.options, c.resolved, c.frame, c.zoom, c.hidden, c.messages);\n   381\t    if (previous && sameValue(previous.viewKey, key)) {\n   382\t      return { view: previous.view, viewKey: previous.viewKey, viewDiagnostics: previous.viewDiagnostics, found: [] };\n   383\t    }\n   384\t    stage('view');\n   385\t    const sink = new DiagnosticCollector();\n   386\t    const state = viewStateFor(kind, c.options, c.resolved, c.zoom, previous?.view ?? null, c.hidden, c.messages);\n   387\t    const view = buildView(c.frame as never, state as never, sink) as View;\n   388\t    const found = sink.inputs();\n   389\t    const before = previous?.viewDiagnostics ?? [];\n   390\t    const viewDiagnostics = completeViewDiagnostics(kind, found, before, view, state);\n   391\t    const known = new Set(before.map(diagnosticKey));\n   392\t    return { view, viewKey: key, viewDiagnostics, found: found.filter(d => !known.has(diagnosticKey(d))) };\n   393\t  }\n   394\t\n   395\t  function messagesFor(next: OptionRecord, previous: Acc