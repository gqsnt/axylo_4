{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc 'for f in chart environment axes; do nl -ba packages/axylo/src/core/$f.ts; done'","aggregated_output":"     1\t/**\n     2\t * `createChart`: the browser host of the controller (controller.ts). It resolves the target, builds the\n     3\t * figure, the mark and text renderers and the interaction layer, and connects the page's observers to the\n     4\t * controller. Every setup step registers its own cleanup as soon as it succeeded, so a failure part-way\n     5\t * through creation, or `destroy()`, leaves the target as it was (including the custom properties the theme\n     6\t * wrote on it).\n     7\t *\n     8\t * Document-level listeners (theme and environment watchers, the interaction layer's keyboard and pointer\n     9\t * listeners on the document) are released when the target leaves the document without `destroy()`, so a\n    10\t * forgotten chart does not stay reachable from the page, and are attached again if the target comes back.\n    11\t * Detachment is noticed by the observers the chart already has (the resize observer reports a zero box),\n    12\t * not by polling.\n    13\t */\n    14\timport type { MarkRenderer, Scene } from './contracts';\n    15\timport { createCanvasRenderer, createSvgRenderer, createTextLayer, type TextLayer } from '../render';\n    16\timport { ensureStyles, resolveTheme, watchTheme } from '../theme';\n    17\timport { createFigure, type Figure } from '../dom/figure';\n    18\timport { createInteraction, type Interaction } from '../dom/interaction';\n    19\timport type { DeliveryConsole } from './delivery';\n    20\timport { createMeasurer, noteFontLoad, readTextStyle, resolveLocale, viewerTimeZone, watchEnvironment } from './environment';\n    21\timport { createController, type ChartHandle, type ChartKind, type Controller, type ControllerActions } from './controller';\n    22\timport { object } from './stages';\n    23\t\n    24\texport type { BenchHook, ChartHandle, ChartKind, DevHook, Stage } from './controller';\n    25\t\n    26\texport interface ChartEnvironmentOverrides {\n    27\t  readonly console?: DeliveryConsole | null;\n    28\t}\n    29\t\n    30\t/** Suffixes of the ids a chart gives its elements (figure, interaction, table). */\n    31\tconst ID_SUFFIXES = ['', '-t', '-st', '-s', '-m', '-n', '-proxy', '-table', '-table-caption', '-table-jump'];\n    32\tlet instances = 0;\n    33\t\n    34\t/** An id prefix none of whose element ids exist in the page yet (spec A1: ids unique per chart). */\n    35\tfunction allocateId(doc: Document): string {\n    36\t  for (;;) {\n    37\t    const id = `axylo-${++instances}`;\n    38\t    if (ID_SUFFIXES.every(suffix => doc.getElementById(id + suffix) === null)) return id;\n    39\t  }\n    40\t}\n    41\t\n    42\t/** Custom properties the theme writes on the root, so destroy can take back exactly those. */\n    43\tconst OWN_PROPERTY = /^--axylo-(?:backdrop|series-color-\\d+)$/;\n    44\t\n    45\tfunction ownProperties(root: HTMLElement): Map<string, string> {\n    46\t  const found = new Map<string, string>();\n    47\t  for (let i = 0; i < root.style.length; i++) {\n    48\t    const name = root.style.item(i);\n    49\t    if (OWN_PROPERTY.test(name)) found.set(name, root.style.getPropertyValue(name));\n    50\t  }\n    51\t  return found;\n    52\t}\n    53\t\n    54\texport function createChart(kind: ChartKind, target: unknown, input: unknown, overrides: ChartEnvironmentOverrides = {}): ChartHandle {\n    55\t  const root = resolveTarget(target);\n    56\t  const doc = root.ownerDocument;\n    57\t  const win = doc.defaultView;\n    58\t  if (win === null) throw new Error('Axylo: the target element is not in a document with a window.');\n    59\t\n    60\t  // Cleanup in reverse order of setup; each step adds its own once it succeeded.\n    61\t  const cleanup: (() => void)[] = [];\n    62\t  const release = (): void => {\n    63\t    for (let fn = cleanup.pop(); fn; fn = cleanup.pop()) {\n    64\t      try {\n    65\t        fn();\n    66\t      } catch {\n    67\t        // Keep releasing the rest.\n    68\t      }\n    69\t    }\n    70\t  };\n    71\t\n    72\t  let controller: Controller | null = null;\n    73\t  try {\n    74\t    const requested = object(input).__renderer === 'canvas' ? 'canvas' : 'svg';\n    75\t    const id = allocateId(doc);\n    76\t\n    77\t    const hadScheme = root.hasAttribute('data-axylo-scheme');\n    78\t    const before = ownProperties(root);\n    79\t    cleanup.push(() => {\n    80\t      if (!hadScheme) root.removeAttribute('data-axylo-scheme');\n    81\t      for (const [name] of ownProperties(root)) {\n    82\t        const was = before.get(name);\n    83\t        if (was === undefined) root.style.removeProperty(name);\n    84\t        else root.style.setProperty(name, was);\n    85\t      }\n    86\t      if (root.getAttribute('style') === '') root.removeAttribute('style');\n    87\t    });\n    88\t\n    89\t    const renderer: MarkRenderer = requested === 'canvas' ? createCanvasRenderer(doc) : createSvgRenderer(doc);\n    90\t    cleanup.push(() => renderer.destroy());\n    91\t    const textLayer: TextLayer = createTextLayer(doc);\n    92\t    cleanup.push(() => textLayer.destroy());\n    93\t    const figure: Figure = createFigure(root, id, { marks: renderer.element, text: textLayer.element });\n    94\t    cleanup.push(() => figure.destroy());\n    95\t\n    96\t    // The interaction layer is built before the controller that answers it, so its actions forward late.\n    97\t    const actions: ControllerActions = {\n    98\t      zoom: w => controller?.actions.zoom(w),\n    99\t      toggle: k => controller?.actions.toggle(k),\n   100\t      pause: p => controller?.actions.pause(p),\n   101\t      select: r => controller?.actions.select(r),\n   102\t      hover: r => controller?.actions.hover(r),\n   103\t    };\n   104\t    const interaction: Interaction = createInteraction(figure, renderer, actions);\n   105\t    cleanup.push(() => interaction.destroy());\n   106\t    const measurer = createMeasurer(doc);\n   107\t    ensureStyles(doc);\n   108\t\n   109\t    // Watchers that the document holds; released while the target is out of the document.\n   110\t    let watching: (() => void) | null = null;\n   111\t    let watchedBefore = false;\n   112\t    const watch = (): void => {\n   113\t      if (watching || controller === null) return;\n   114\t      const c = controller;\n   115\t      if (watchedBefore) c.invalidate.page();\n   116\t      watchedBefore = true;\n   117\t      const stopTheme = watchTheme(root, () => c.invalidate.theme());\n   118\t      const stopEnvironment = watchEnvironment(win, {\n   119\t        pixelRatio: () => c.invalidate.pixelRatio(),\n   120\t        motion() {\n   121\t          // Nothing is animated yet (spec I5), so there is nothing to change.\n   122\t        },\n   123\t        fonts() {\n   124\t          noteFontLoad(doc);\n   125\t          c.invalidate.fonts();\n   126\t        },\n   127\t      });\n   128\t      interaction.attach();\n   129\t      watching = () => {\n   130\t        stopTheme();\n   131\t        stopEnvironment();\n   132\t        interaction.detach();\n   133\t      };\n   134\t    };\n   135\t    const unwatch = (): void => {\n   136\t      watching?.();\n   137\t      watching = null;\n   138\t    };\n   139\t    cleanup.push(unwatch);\n   140\t\n   141\t    const resizeObserver = new win.ResizeObserver(() => {\n   142\t      if (controller === null) return;\n   143\t      // A target taken out of the document reports a zero box: let go of the document until it returns.\n   144\t      if (!root.isConnected) {\n   145\t        unwatch();\n   146\t        return;\n   147\t      }\n   148\t      watch();\n   149\t      controller.invalidate.resize();\n   150\t    });\n   151\t    cleanup.push(() => resizeObserver.disconnect());\n   152\t\n   153\t    const timeZone = viewerTimeZone();\n   154\t    controller = createController(kind, input, {\n   155\t      id,\n   156\t      console: overrides.console === undefined ? (win.console as DeliveryConsole) : overrides.console,\n   157\t      page: doc,\n   158\t      timeZone,\n   159\t      renderer: {\n   160\t        kind: renderer.kind,\n   161\t        draw: (scene: Scene, bindings, theme, ratio) => renderer.draw(scene, bindings, theme, ratio),\n   162\t      },\n   163\t      text: textLayer,\n   164\t      figure,\n   165\t      interaction,\n   166\t      measurer,\n   167\t      requestFrame: callback => win.requestAnimationFrame(callback),\n   168\t      cancelFrame: handle => win.cancelAnimationFrame(handle),\n   169\t      locale: option => resolveLocale(option, doc),\n   170\t      pageLang() {\n   171\t        const lang = root.closest('[lang]')?.getAttribute('lang')?.trim();\n   172\t        return lang ? lang : null;\n   173\t      },\n   174\t      labelText(own) {\n   175\t        const el = doc.getElementById(own);\n   176\t        return el === null ? null : el.textContent ?? '';\n   177\t      },\n   178\t      textStyle: () => readTextStyle(textLayer.element),\n   179\t      measure() {\n   180\t        if (!root.isConnected) return null;\n   181\t        const box = figure.figure.getBoundingClientRect();\n   182\t        if (box.width <= 0 && box.height <= 0) return null;\n   183\t        const plot = figure.plot.getBoundingClientRect();\n   184\t        // When the plot is squeezed to nothing, how far the rest overflows the figure is how much room is\n   185\t        // missing; that keeps the L8 decision continuous below zero.\n   186\t        const overflow = plot.height < 1 ? Math.max(0, figure.figure.scrollHeight - figure.figure.clientHeight) : 0;\n   187\t        return { width: plot.width, height: plot.height - overflow };\n   188\t      },\n   189\t      devicePixelRatio: () => win.devicePixelRatio || 1,\n   190\t      theme: (keys, colors) => resolveTheme(root, keys, colors),\n   191\t      dispose: release,\n   192\t    });\n   193\t    resizeObserver.observe(figure.plot);\n   194\t    resizeObserver.observe(figure.figure);\n   195\t    if (root.isConnected) watch();\n   196\t    return controller.handle;\n   197\t  } catch (error) {\n   198\t    // A rejected strict create, or a failure part-way through: nothing stays behind.\n   199\t    controller = null;\n   200\t    release();\n   201\t    throw error;\n   202\t  }\n   203\t}\n   204\t\n   205\tfunction resolveTarget(target: unknown): HTMLElement {\n   206\t  if (typeof target === 'string') {\n   207\t    const doc = (globalThis as { document?: Document }).document;\n   208\t    if (!doc) throw new Error(`Axylo: no document to find the target ${JSON.stringify(target)} in.`);\n   209\t    let found: Element | null = null;\n   210\t    try {\n   211\t      found = doc.querySelector(target);\n   212\t    } catch {\n   213\t      throw new Error(`Axylo: the target selector ${JSON.stringify(target)} is not a valid CSS selector.`);\n   214\t    }\n   215\t    if (!found) throw new Error(`Axylo: the target selector ${JSON.stringify(target)} matches no element.`);\n   216\t    return found as HTMLElement;\n   217\t  }\n   218\t  if (target !== null && typeof target === 'object' && (target as Node).nodeType === 1) return target as HTMLElement;\n   219\t  throw new Error('Axylo: the target must be a CSS selector or an element.');\n   220\t}\n     1\t/**\n     2\t * The browser inputs that output depends on besides options and data (contracts: Environment), and the\n     3\t * watchers that say when one of them changed: device pixel ratio, reduced motion, web fonts finishing a load.\n     4\t * Nothing here runs at import time; every function takes the window or element it reads.\n     5\t */\n     6\timport type { TextMeasurer, TextStyle } from './contracts';\n     7\t\n     8\texport function viewerTimeZone(): string {\n     9\t  try {\n    10\t    return Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC';\n    11\t  } catch {\n    12\t    return 'UTC';\n    13\t  }\n    14\t}\n    15\t\n    16\t/** `options.locale`, else the document language, else the browser's, as a locale Intl accepts. */\n    17\texport function resolveLocale(option: unknown, doc: Document | null): string {\n    18\t  const candidates = [option, doc?.documentElement.lang, doc?.defaultView?.navigator.language];\n    19\t  for (const candidate of candidates) {\n    20\t    if (typeof candidate !== 'string' || candidate.trim() === '') continue;\n    21\t    try {\n    22\t      const [canonical] = Intl.getCanonicalLocales(candidate.trim());\n    23\t      if (canonical) return canonical;\n    24\t    } catch {\n    25\t      // Not a locale tag; try the next source.\n    26\t    }\n    27\t  }\n    28\t  return new Intl.NumberFormat().resolvedOptions().locale;\n    29\t}\n    30\t\n    31\tfunction pixels(value: string, fontSize: number): number {\n    32\t  if (value === '' || value === 'normal') return NaN;\n    33\t  const n = parseFloat(value);\n    34\t  if (!Number.isFinite(n)) return NaN;\n    35\t  return value.endsWith('px') ? n : n * fontSize;\n    36\t}\n    37\t\n    38\t/**\n    39\t * The text style of tick labels, read from the text layer's own computed style, so measurement agrees with\n    40\t * what the layer renders (it uses `font-size: max(12px, 1em)`), including the page's text spacing (spec A6).\n    41\t */\n    42\texport function readTextStyle(element: Element): TextStyle {\n    43\t  const win = element.ownerDocument.defaultView;\n    44\t  const style = win?.getComputedStyle(element);\n    45\t  const fontSize = style ? parseFloat(style.fontSize) || 12 : 12;\n    46\t  if (!style) return { font: `${fontSize}px sans-serif`, letterSpacing: 0, wordSpacing: 0, lineHeight: fontSize * 1.2 };\n    47\t  const family = style.fontFamily || 'sans-serif';\n    48\t  const font = `${style.fontStyle || 'normal'} ${style.fontWeight || '400'} ${fontSize}px ${family}`;\n    49\t  const letterSpacing = pixels(style.letterSpacing, fontSize);\n    50\t  const wordSpacing = pixels(style.wordSpacing, fontSize);\n    51\t  const lineHeight = pixels(style.lineHeight, fontSize);\n    52\t  return {\n    53\t    font,\n    54\t    letterSpacing: Number.isFinite(letterSpacing) ? letterSpacing : 0,\n    55\t    wordSpacing: Number.isFinite(wordSpacing) ? wordSpacing : 0,\n    56\t    // 'normal' depends on the font's metrics; 1.2 is the common value and errs on the side of room.\n    57\t    lineHeight: Number.isFinite(lineHeight) ? lineHeight : Math.ceil(fontSize * 1.2),\n    58\t  };\n    59\t}\n    60\t\n    61\tconst contexts = new WeakMap<Document, CanvasRenderingContext2D | null>();\n    62\t/** Measured widths per document, for every style together, so the bound holds for the whole page. */\n    63\tconst caches = new WeakMap<Document, Map<string, number>>();\n    64\tconst fontEpochs = new WeakMap<Document, number>();\n    65\texport const MEASUREMENT_CACHE_LIMIT = 8192;\n    66\t\n    67\t/**\n    68\t * Web fonts finished loading in `doc`: widths measured with a fallback font are wrong now. Every chart of\n    69\t * the document calls this on the same event; the first clears the cache and the epoch moves on.\n    70\t */\n    71\texport function noteFontLoad(doc: Document): void {\n    72\t  fontEpochs.set(doc, (fontEpochs.get(doc) ?? 0) + 1);\n    73\t  caches.get(doc)?.clear();\n    74\t}\n    75\t\n    76\t/** How many widths the document's cache holds (for tests of its bound). */\n    77\texport function measurementCacheSize(doc: Document): number {\n    78\t  return caches.get(doc)?.size ?? 0;\n    79\t}\n    80\t\n    81\ttype SpacingContext = CanvasRenderingContext2D & { letterSpacing?: string; wordSpacing?: string };\n    82\t\n    83\t/**\n    84\t * Canvas `measureText` with the computed font and the page's letter and word spacing (spec A6). Where the\n    85\t * context supports `letterSpacing` and `wordSpacing` they are set on it, so the browser adds them as it\n    86\t * does for the text layer; otherwise they are added the way CSS adds them (after every character, and\n    87\t * after every space). Cached per document, font epoch, style and string.\n    88\t */\n    89\texport function createMeasurer(doc: Document): TextMeasurer {\n    90\t  return {\n    91\t    width(text: string, style: TextStyle): number {\n    92\t      let ctx = contexts.get(doc);\n    93\t      if (ctx === undefined) {\n    94\t        ctx = doc.createElement('canvas').getContext('2d');\n    95\t        contexts.set(doc, ctx);\n    96\t      }\n    97\t      let cache = caches.get(doc);\n    98\t      if (!cache) caches.set(doc, cache = new Map());\n    99\t      const key = `${fontEpochs.get(doc) ?? 0}|${style.font}|${style.letterSpacing}|${style.wordSpacing}|${text}`;\n   100\t      const hit = cache.get(key);\n   101\t      if (hit !== undefined) return hit;\n   102\t      let width: number;\n   103\t      let spaced = false;\n   104\t      if (ctx) {\n   105\t        const c = ctx as SpacingContext;\n   106\t        if (c.font !== style.font) c.font = style.font;\n   107\t        if (typeof c.letterSpacing === 'string' && typeof c.wordSpacing === 'string') {\n   108\t          const letter = `${style.letterSpacing}px`;\n   109\t          const word = `${style.wordSpacing}px`;\n   110\t          if (c.letterSpacing !== letter) c.letterSpacing = letter;\n   111\t          if (c.wordSpacing !== word) c.wordSpacing = word;\n   112\t          spaced = true;\n   113\t        }\n   114\t        width = c.measureText(text).width;\n   115\t      } else {\n   116\t        width = text.length * parseFloat(/(\\d+(?:\\.\\d+)?)px/.exec(style.font)?.[1] ?? '12') * 0.6;\n   117\t      }\n   118\t      if (!spaced) {\n   119\t        if (style.letterSpacing !== 0) width += style.letterSpacing * [...text].length;\n   120\t        if (style.wordSpacing !== 0) {\n   121\t          let spaces = 0;\n   122\t          for (let i = 0; i < text.length; i++) if (text.charCodeAt(i) === 32) spaces++;\n   123\t          width += style.wordSpacing * spaces;\n   124\t        }\n   125\t      }\n   126\t      if (cache.size >= MEASUREMENT_CACHE_LIMIT) cache.clear();\n   127\t      cache.set(key, width);\n   128\t      return width;\n   129\t    },\n   130\t  };\n   131\t}\n   132\t\n   133\texport function sameTextStyle(a: TextStyle | null, b: TextStyle): boolean {\n   134\t  return a !== null && a.font === b.font && a.letterSpacing === b.letterSpacing &&\n   135\t    a.wordSpacing === b.wordSpacing && a.lineHeight === b.lineHeight;\n   136\t}\n   137\t\n   138\t/**\n   139\t * Calls `onChange` when the device pixel ratio changes (browser zoom, moving to another screen), when\n   140\t * reduced motion is toggled, and when web fonts finish loading. Returns `stop`.\n   141\t */\n   142\texport function watchEnvironment(win: Window, handlers: { pixelRatio(): void; motion(): void; fonts(): void }): () => void {\n   143\t  let stopped = false;\n   144\t  let ratioQuery: MediaQueryList | null = null;\n   145\t  const onRatio = (): void => {\n   146\t    if (stopped) return;\n   147\t    arm();\n   148\t    handlers.pixelRatio();\n   149\t  };\n   150\t  // A resolution query matches one ratio only, so it is re-armed for the new ratio after each change.\n   151\t  function arm(): void {\n   152\t    ratioQuery?.removeEventListener('change', onRatio);\n   153\t    ratioQuery = win.matchMedia(`(resolution: ${win.devicePixelRatio}dppx)`);\n   154\t    ratioQuery.addEventListener('change', onRatio);\n   155\t  }\n   156\t  arm();\n   157\t  const motion = win.matchMedia('(prefers-reduced-motion: reduce)');\n   158\t  const onMotion = (): void => { if (!stopped) handlers.motion(); };\n   159\t  motion.addEventListener('change', onMotion);\n   160\t  const fonts = win.document.fonts as FontFaceSet | undefined;\n   161\t  const onFonts = (): void => { if (!stopped) handlers.fonts(); };\n   162\t  fonts?.addEventListener('loadingdone', onFonts);\n   163\t  return () => {\n   164\t    stopped = true;\n   165\t    ratioQuery?.removeEventListener('change', onRatio);\n   166\t    motion.removeEventListener('change', onMotion);\n   167\t    fonts?.removeEventListener('loadingdone', onFonts);\n   168\t  };\n   169\t}\n     1\t/**\n     2\t * Turns a view into the input of `computeLayout`: which axes the chart has, their domains, their candidate\n     3\t * tick sets with labels, and their titles. Also produces the key that decides whether layout must rerun\n     4\t * (plan 2.2: a data-only update reruns layout only when tick labels or margins would change).\n     5\t */\n     6\timport type { TextMeasurer, TextStyle, TickCandidates, View, XKind } from './contracts';\n     7\timport type { LayoutInput } from '../layout';\n     8\timport type { ResolvedOptions } from '../data';\n     9\timport { bandScale, bandTickCandidates, linearScale, linearTickCandidates, timeScale, timeTickCandidates } from '../scale';\n    10\timport { createNumberTickLabeler, createTimeTickLabel, type NumberFormatOption } from '../format';\n    11\timport type { XValue } from '../public';\n    12\t\n    13\ttype Span = readonly [number, number];\n    14\t\n    15\texport interface AxisContext {\n    16\t  readonly resolved: ResolvedOptions;\n    17\t  readonly locale: string;\n    18\t  readonly compact: boolean;\n    19\t  /** Called once per field when an author tick formatter throws (the chart raises AX160). */\n    20\t  readonly onFormatterError: (field: string, error: unknown) => void;\n    21\t  /** The author gave the x field a `label` (spec L6: only then is a time, date or category axis titled). */\n    22\t  readonly xLabelGiven: boolean;\n    23\t  /** Title of a value axis that shows several fields with no shared label (the `value` message). */\n    24\t  readonly valueTitle: string;\n    25\t}\n    26\t\n    27\tconst scales = {\n    28\t  linear: linearScale,\n    29\t  time: timeScale,\n    30\t  band: bandScale,\n    31\t};\n    32\t\n    33\tfunction withUnit(label: string, unit: string | null): string {\n    34\t  return unit ? `${label} (${unit})` : label;\n    35\t}\n    36\t\n    37\tfunction numberTicks(domain: Span, locale: string, option: unknown, scale: 'percent' | 'ratio' | null, onError: (e: unknown) => void): TickCandidates {\n    38\t  const tickFormat = typeof option === 'function' || (option !== null && typeof option === 'object')\n    39\t    ? option as NumberFormatOption : null;\n    40\t  return linearTickCandidates(domain, createNumberTickLabeler({ locale, scale, tickFormat, onError }));\n    41\t}\n    42\t\n    43\tfunction temporalTicks(\n    44\t  domain: Span, kind: 'time' | 'date' | 'wall', timeZone: string | null, dateUnit: 'day' | 'month' | 'year' | null,\n    45\t  locale: string, option: unknown, onError: (e: unknown) => void,\n    46\t): TickCandidates {\n    47\t  const format = typeof option === 'function' || (option !== null && typeof option === 'object')\n    48\t    ? option as Parameters<typeof createTimeTickLabel>[0]['format'] : null;\n    49\t  const label = format ? createTimeTickLabel({ kind, timeZone, locale, dateUnit, format, onError }) : null;\n    50\t  return timeTickCandidates(domain, { kind, timeZone, locale, dateUnit, label });\n    51\t}\n    52\t\n    53\tfunction categoryLabels(categories: readonly string[], option: unknown, onError: (e: unknown) => void): readonly string[] {\n    54\t  if (typeof option !== 'function') return categories;\n    55\t  let failed = false;\n    56\t  return categories.map(name => {\n    57\t    try {\n    58\t      return String((option as (value: XValue) => string)(name));\n    59\t    } catch (error) {\n    60\t      if (!failed) onError(error);\n    61\t      failed = true;\n    62\t      return name;\n    63\t    }\n    64\t  });\n    65\t}\n    66\t\n    67\tfunction continuousX(\n    68\t  kind: Exclude<XKind, 'category'>, domain: Span, timeZone: string | null, dateUnit: 'day' | 'month' | 'year' | null,\n    69\t  ctx: AxisContext,\n    70\t) {\n    71\t  const option = ctx.resolved.x.tickFormat;\n    72\t  const onError = (e: unknown) => ctx.onFormatterError(ctx.resolved.x.field, e);\n    73\t  const candidates = kind === 'number'\n    74\t    ? numberTicks(domain, ctx.locale, option, null, onError)\n    75\t    : temporalTicks(domain, kind, timeZone, dateUnit, ctx.locale, option, onError);\n    76\t  return { type: kind === 'number' ? 'linear' as const : 'time' as const, domain, candidates, mayThin: true };\n    77\t}\n    78\t\n    79\texport function layoutInput(\n    80\t  view: View, size: { width: number; height: number }, text: { measurer: TextMeasurer; style: TextStyle }, ctx: AxisContext,\n    81\t): LayoutInput {\n    82\t  const { width, height } = size;\n    83\t  if (view.kind === 'donut') return { width, height, kind: 'ring' };\n    84\t  const value = ctx.resolved.values[0];\n    85\t  const yOption = value?.tickFormat ?? null;\n    86\t  const onYError = (e: unknown) => ctx.onFormatterError(value?.field ?? 'y', e);\n    87\t  const visibleSeries = view.frame.series.filter((_, i) => view.visible[i]);\n    88\t  const firstScale = 'valueScale' in (visibleSeries[0] ?? {}) ? (visibleSeries[0] as { valueScale: 'percent' | 'ratio' | null }).valueScale : null;\n    89\t  const valueScale = view.kind === 'scatter' ? value?.scale ?? null\n    90\t    : visibleSeries.every(s => (s as { valueScale: unknown }).valueScale === firstScale) ? firstScale : null;\n    91\t  const titles = axisTitles(view, ctx);\n    92\t  const y = {\n    93\t    domain: view.yDomain, candidates: numberTicks(view.yDomain, ctx.locale, yOption, valueScale, onYError),\n    94\t    title: titles.y, mayThin: true,\n    95\t  };\n    96\t  const common = { width, height, compact: ctx.compact, measurer: text.measurer, style: text.style, scales };\n    97\t\n    98\t  if (view.kind === 'scatter') {\n    99\t    const x = continuousX(view.frame.xKind, view.xDomain, view.frame.timeZone, null, ctx);\n   100\t    return { ...common, kind: 'xy', x: { ...x, title: titles.x }, y, references: view.references };\n   101\t  }\n   102\t\n   103\t  const column = view.frame.x;\n   104\t  const xTitle = titles.x;\n   105\t  const references = view.references;\n   106\t  const onXError = (e: unknown) => ctx.onFormatterError(ctx.resolved.x.field, e);\n   107\t  if (column.kind === 'category') {\n   108\t    const labels = categoryLabels(column.categories ?? [], ctx.resolved.x.tickFormat, onXError);\n   109\t    const x = {\n   110\t      type: 'band' as const, count: labels.length, padding: view.kind === 'bar' ? 0.2 : 0,\n   111\t      candidates: bandTickCandidates(labels), mayThin: column.ordered, title: xTitle,\n   112\t    };\n   113\t    return view.kind === 'bar'\n   114\t      ? { ...common, kind: 'bands', horizontal: view.horizontal, x, y, references }\n   115\t      : { ...common, kind: 'xy', x, y, references };\n   116\t  }\n   117\t  // Bars on a continuous x: the view's domain already has room for the outer bars (view/bar-bands.ts), and\n   118\t  // ticks, marks and lookup all use that one domain.\n   119\t  const x = { ...continuousX(column.kind, view.xDomain, column.timeZone, column.dateUnit, ctx), title: xTitle };\n   120\t  return view.kind === 'bar'\n   121\t    ? { ...common, kind: 'bands', horizontal: view.horizontal, x, y, references }\n   122\t    : { ...common, kind: 'xy', x, y, references };\n   123\t}\n   124\t\n   125\t/** The axis titles layout draws (spec L6), with their units; undefined where an axis is untitled. */\n   126\tfunction axisTitles(view: Exclude<View, { kind: 'donut' }>, ctx: AxisContext): { x: string | undefined; y: string | undefined } {\n   127\t  if (ctx.compact) return { x: undefined, y: undefined };\n   128\t  if (view.kind === 'scatter') {\n   129\t    return {\n   130\t      x: xTitled(view.frame.xKind, ctx) ? withUnit(view.frame.xLabel, view.frame.xUnit) : undefined,\n   131\t      y: withUnit(view.frame.yLabel, view.frame.yUnit),\n   132\t    };\n   133\t  }\n   134\t  return {\n   135\t    x: xTitled(view.frame.x.kind, ctx) ? withUnit(view.frame.xLabel, ctx.resolved.x.unit) : undefined,\n   136\t    y: withUnit(view.frame.yLabel ?? alignedValueTitle(view.frame.series, ctx.valueTitle), sharedUnit(view.frame.series)),\n   137\t  };\n   138\t}\n   139\t\n   140\t/** Spec L6: a number x is a measure and is titled; time, date and category ticks already say what they are. */\n   141\tfunction xTitled(kind: XKind, ctx: AxisContext): boolean {\n   142\t  return kind === 'number' || ctx.xLabelGiven;\n   143\t}\n   144\t\n   145\t/** A value axis is always titled (spec L6): its label, else its one field, else the generic noun. */\n   146\tfunction alignedValueTitle(series: readonly { readonly field: string }[], generic: string): string {\n   147\t  const first = series[0]?.field;\n   148\t  return first !== undefined && series.every(s => s.field === first) ? first : generic;\n   149\t}\n   150\t\n   151\tfunction sharedUnit(series: readonly { readonly unit: string | null }[]): string | null {\n   152\t  const first = series[0]?.unit ?? null;\n   153\t  return series.every(s => s.unit === first) ? first : null;\n   154\t}\n   155\t\n   156\t/**\n   157\t * Everything layout reads, as comparable parts. Equal keys mean the previous layout is still right: same\n   158\t * size, text style, fonts, locale, domains, categories, titles and formatters.\n   159\t */\n   160\texport function layoutKey(\n   161\t  view: View, size: { width: number; height: number }, style: TextStyle, fontEpoch: number, ctx: AxisContext,\n   162\t): readonly unknown[] {\n   163\t  const base: unknown[] = [size.width, size.height, style.font, style.letterSpacing, style.wordSpacing, style.lineHeight,\n   164\t    fontEpoch, ctx.locale, ctx.compact, view.kind];\n   165\t  if (view.kind === 'donut') return base;\n   166\t  const value = ctx.resolved.values[0];\n   167\t  base.push(view.xDomain[0], view.xDomain[1], view.yDomain[0], view.yDomain[1], ctx.resolved.x.tickFormat,\n   168\t    ctx.resolved.x.label, ctx.resolved.x.unit, value?.tickFormat, value?.label, value?.unit, value?.scale,\n   169\t    ctx.xLabelGiven, ctx.valueTitle, view.references);\n   170\t  base.push(...view.visible);\n   171\t  // The titles as drawn: a unit can change on one series only and change the shared unit (review 2, finding 20).\n   172\t  const titles = axisTitles(view, ctx);\n   173\t  base.push(titles.x, titles.y);\n   174\t  if (view.kind === 'scatter') {\n   175\t    base.push(view.frame.xKind, view.frame.timeZone, view.frame.xLabel, view.frame.yLabel);\n   176\t    return base;\n   177\t  }\n   178\t  const column = view.frame.x;\n   179\t  // No slot indexes: layout reads domains, categories and labels only, never which slots are visible.\n   180\t  base.push(column.kind, column.timeZone, column.dateUnit, column.ordered, view.frame.xLabel, view.frame.yLabel,\n   181\t    view.horizontal, column.categories);\n   182\t  for (const s of view.frame.series) base.push(s.valueScale);\n   183\t  return base;\n   184\t}\n   185\t\n   186\texport function sameKey(a: readonly unknown[] | null, b: readonly unknown[]): boolean {\n   187\t  if (a === null || a.length !== b.length) return false;\n   188\t  for (let i = 0; i < a.length; i++) {\n   189\t    const x = a[i];\n   190\t    const y = b[i];\n   191\t    if (Object.is(x, y)) continue;\n   192\t    // Categories are compared by content: a renormalized frame has a new array with the same names.\n   193\t    if (Array.isArray(x) && Array.isArray(y) && x.length === y.length && x.every((v, k) => v === y[k])) continue;\n   194\t    return false;\n   195\t  }\n   196\t  return true;\n   197\t}\n","exit_code":0,"status":"completed"}}
