{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/test/core/host.ts'","aggregated_output":"     1\t/**\n     2\t * A recording host for driving the chart controller in Node (the method of the core review): a manual\n     3\t * animation-frame queue, and substitutes for the figure, the renderers and the interaction layer that keep\n     4\t * what they were given. Sizes come from a small model of the figure's CSS: the plot gets what the caption\n     5\t * and the controls leave of the container.\n     6\t */\n     7\timport type { Layout, PlacedText, Scene, TextStyle } from '../../src/core/contracts';\n     8\timport { createController, type ChartKind, type Controller, type Host, type Size } from '../../src/core/controller';\n     9\timport type { FigureModel } from '../../src/dom/figure';\n    10\timport type { Committed, ControlsState } from '../../src/dom/interaction';\n    11\timport { TOKEN_BINDINGS } from '../../src/theme';\n    12\t\n    13\texport interface Recording {\n    14\t  readonly host: Host;\n    15\t  readonly controller: Controller;\n    16\t  /** Runs every queued animation frame (and those they queue), at most `limit` rounds. */\n    17\t  frames(limit?: number): number;\n    18\t  readonly pending: number;\n    19\t  draws: Scene[];\n    20\t  texts: (readonly PlacedText[])[];\n    21\t  models: FigureModel[];\n    22\t  announcements: string[];\n    23\t  prepared: ControlsState[];\n    24\t  committed: Committed | null;\n    25\t  commits: number;\n    26\t  clears: number;\n    27\t  themeCalls: { keys: readonly string[]; colors: Record<string, string> }[];\n    28\t  printed: string[];\n    29\t  disposed: number;\n    30\t  /** The container (CSS px). The plot's height is what the caption and the controls leave. */\n    31\t  container: { width: number; height: number } | null;\n    32\t  /** Height of one caption line and of the controls row in the model of the figure. */\n    33\t  readonly lineHeight: number;\n    34\t  ids: Record<string, string>;\n    35\t  readonly layout: Layout | null;\n    36\t}\n    37\t\n    38\texport interface HostOptions {\n    39\t  readonly container?: { width: number; height: number } | null;\n    40\t  readonly console?: boolean;\n    41\t}\n    42\t\n    43\texport function record(kind: ChartKind, options: Record<string, unknown>, settings: HostOptions = {}): Recording {\n    44\t  const queue = new Map<number, () => void>();\n    45\t  let handles = 0;\n    46\t  const rec = {\n    47\t    draws: [] as Scene[], texts: [] as (readonly PlacedText[])[], models: [] as FigureModel[], announcements: [] as string[],\n    48\t    prepared: [] as ControlsState[], committed: null as Committed | null, commits: 0, clears: 0,\n    49\t    themeCalls: [] as { keys: readonly string[]; colors: Record<string, string> }[], printed: [] as string[], disposed: 0,\n    50\t    container: settings.container === undefined ? { width: 720, height: 400 } : settings.container,\n    51\t    lineHeight: 20, ids: {} as Record<string, string>,\n    52\t  };\n    53\t  let model: FigureModel | null = null;\n    54\t  let controls: ControlsState | null = null;\n    55\t  const style: TextStyle = { font: '400 12px sans-serif', letterSpacing: 0, wordSpacing: 0, lineHeight: 15 };\n    56\t\n    57\t  /** The plot size the model figure gives: container minus caption (title, subtitle, visible summary) and controls. */\n    58\t  function plotSize(): Size | null {\n    59\t    const box = rec.container;\n    60\t    if (box === null) return null;\n    61\t    let used = 0;\n    62\t    if (model && !model.compact) {\n    63\t      if (model.title?.visible) used += rec.lineHeight;\n    64\t      if (model.subtitle) used += rec.lineHeight;\n    65\t      if (model.summaryVisible) used += 2 * rec.lineHeight;\n    66\t      if (model.note) used += rec.lineHeight;\n    67\t    }\n    68\t    if (controls && controls.interactive) {\n    69\t      // The legend and toolbar take a row; the fallback offers only the table control, which is a row too\n    70\t      // but shorter (no legend).\n    71\t      used += controls.tooSmall ? rec.lineHeight : 1.5 * rec.lineHeight;\n    72\t    }\n    73\t    return { width: box.width, height: box.height - used };\n    74\t  }\n    75\t\n    76\t  const host: Host = {\n    77\t    id: 'axylo-test',\n    78\t    console: settings.console === false ? null : {\n    79\t      warn: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n    80\t      info: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n    81\t      error: (...args: unknown[]) => { rec.printed.push(String(args[0])); },\n    82\t    },\n    83\t    page: {},\n    84\t    timeZone: 'UTC',\n    85\t    renderer: { kind: 'svg', draw: scene => { rec.draws.push(scene); } },\n    86\t    text: { render: texts => { rec.texts.push(texts); } },\n    87\t    figure: {\n    88\t      update(next) {\n    89\t        const before = model;\n    90\t        model = next;\n    91\t        rec.models.push(next);\n    92\t        return before === null || before.summaryVisible !== next.summaryVisible || before.note !== next.note ||\n    93\t          before.title?.text !== next.title?.text || before.subtitle !== next.subtitle;\n    94\t      },\n    95\t      announce: text => { rec.announcements.push(text); },\n    96\t    },\n    97\t    interaction: {\n    98\t      prepare(state) {\n    99\t        const before = controls;\n   100\t        controls = state;\n   101\t        rec.prepared.push(state);\n   102\t        return before === null || before.tooSmall !== state.tooSmall || before.interactive !== state.interactive;\n   103\t      },\n   104\t      commit(state) {\n   105\t        rec.committed = state;\n   106\t        rec.commits++;\n   107\t      },\n   108\t      clear() {\n   109\t        rec.committed = null;\n   110\t        rec.clears++;\n   111\t      },\n   112\t    },\n   113\t    measurer: { width: text => text.length * 7 },\n   114\t    requestFrame(callback) {\n   115\t      const handle = ++handles;\n   116\t      queue.set(handle, callback);\n   117\t      return handle;\n   118\t    },\n   119\t    cancelFrame(handle) {\n   120\t      queue.delete(handle);\n   121\t    },\n   122\t    locale: option => typeof option === 'string' ? option : 'en-US',\n   123\t    pageLang: () => 'en',\n   124\t    labelText: id => Object.hasOwn(rec.ids, id) ? rec.ids[id]! : null,\n   125\t    textStyle: () => style,\n   126\t    measure: plotSize,\n   127\t    devicePixelRatio: () => 1,\n   128\t    theme(keys, colors) {\n   129\t      rec.themeCalls.push({ keys: [...keys], colors });\n   130\t      const series = keys.map((_, i) => `var(--axylo-series-color-${i + 1})`);\n   131\t      const paints = { tokens: { ...TOKEN_BINDINGS }, series };\n   132\t      return {\n   133\t        bindings: { tokens: TOKEN_BINDINGS, series },\n   134\t        theme: { scheme: 'light', forcedColors: false, moreContrast: false, paints },\n   135\t        resolved: true, backdropKnown: false,\n   136\t      };\n   137\t    },\n   138\t    dispose() {\n   139\t      rec.disposed++;\n   140\t    },\n   141\t  };\n   142\t\n   143\t  const controller = createController(kind, options, host);\n   144\t  return Object.assign(rec, {\n   145\t    host, controller,\n   146\t    frames(limit = 10): number {\n   147\t      let rounds = 0;\n   148\t      while (queue.size && rounds < limit) {\n   149\t        rounds++;\n   150\t        const callbacks = [...queue.values()];\n   151\t        queue.clear();\n   152\t        for (const cb of callbacks) cb();\n   153\t      }\n   154\t      return rounds;\n   155\t    },\n   156\t    get pending() {\n   157\t      return queue.size;\n   158\t    },\n   159\t    get layout() {\n   160\t      return rec.committed?.layout ?? null;\n   161\t    },\n   162\t  }) as Recording;\n   163\t}\n   164\t\n   165\texport const lastModel = (r: Recording): FigureModel => r.models[r.models.length - 1]!;\n","exit_code":0,"status":"completed"}}
