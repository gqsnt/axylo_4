a-labelledby'), codes: chart.diagnostics.map(d => d.code) };\n   431\t      chart.destroy();\n   432\t      const heading = document.body.insertBefore(Object.assign(document.createElement('h2'), { id: 'card', textContent: 'Card heading' }), el);\n   433\t      const named = window.Axylo.line!(el, { labelledBy: 'card', title: 'Also a title', data: [{ x: 1, y: 1 }, { x: 2, y: 2 }], x: 'x', y: 'y' });\n   434\t      await named.__bench.ready();\n   435\t      const f = el.querySelector('figure')!;\n   436\t      return {\n   437\t        missing, heading: heading.id,\n   438\t        withHeading: { labelledby: f.getAttribute('aria-labelledby'), internal: [...el.querySelectorAll('[role=\"heading\"]')].filter(h => !(h as HTMLElement).hidden).length },\n   439\t      };\n   440\t    });\n   441\t    expect(result.missing).toEqual({ label: 'Line chart of y by x', labelledby: null, codes: ['AX140'] });\n   442\t    expect(result.withHeading).toEqual({ labelledby: 'card', internal: 0 });\n   443\t    expect(await closePage(page)).toEqual([]);\n   444\t  });\n   445\t\n   446\t  it('generated ids do not collide with ids already in the page', async () => {\n   447\t    const page = await chartPage();\n   448\t    const duplicates = await page.evaluate(async () => {\n   449\t      for (const id of ['axylo-1-t', 'axylo-2', 'axylo-3-s']) document.body.appendChild(Object.assign(document.createElement('span'), { id }));\n   450\t      for (let i = 0; i < 3; i++) {\n   451\t        const el = document.body.appendChild(document.createElement('div'));\n   452\t        const chart = window.Axylo.line!(el, { title: `C${i}`, data: [{ x: 1, y: 1 }, { x: 2, y: 2 }], x: 'x', y: 'y' });\n   453\t        await chart.__bench.ready();\n   454\t      }\n   455\t      const ids = [...document.querySelectorAll('[id]')].map(e => e.id);\n   456\t      return ids.filter((id, i) => ids.indexOf(id) !== i);\n   457\t    });\n   458\t    expect(duplicates).toEqual([]);\n   459\t    expect(await closePage