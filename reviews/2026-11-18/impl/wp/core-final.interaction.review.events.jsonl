{"type":"item.completed","item":{"id":"item_20","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/src/dom/tooltip.ts | sed -n '1,185p' && cat packages/axylo/src/dom/pointer.ts\"","aggregated_output":"     1\t/**\n     2\t * Renders a tooltip model as text (spec I1, DX8: textContent only), placed by decision 0004 revision 2:\n     3\t *\n     4\t * - The position is a function of the datum only: the box of its active marks, enlarged by the focus ring.\n     5\t *   The pointer never enters the computation, so an approaching pointer cannot push the tooltip away.\n     6\t * - Candidates above, below, right and left of that box (horizontal bars: right, left, above, below; a donut\n     7\t *   tries its hole first), each valid only wholly inside the plot, the viewport and every clipping ancestor,\n     8\t *   and overlapping neither the box nor any control.\n     9\t * - A hovered tooltip is text and takes no pointer events; a pinned one takes events and its rows are buttons\n    10\t *   of at least 24 × 24 CSS px.\n    11\t * - When nothing fits, rows are dropped into \"+N more\"; with one row left and still nothing valid, the\n    12\t *   candidate that overlaps the box least is used, inside the plot (rule 6).\n    13\t *\n    14\t * In readout mode (decided by layout, rule 5) the same content is written as running text into a strip of\n    15\t * two lines reserved under the plot; there is no floating tooltip then.\n    16\t *\n    17\t * Both elements are aria-hidden: the keyboard proxy carries the same text as its value text, so a screen\n    18\t * reader is not told twice and nothing here behaves as a live region (spec A7).\n    19\t */\n    20\timport type { DatumText, Rect, TooltipModel } from '../core/contracts';\n    21\timport { createSwatch, type SwatchSpec } from './swatch';\n    22\t\n    23\texport interface TooltipContent {\n    24\t  readonly model: TooltipModel;\n    25\t  readonly swatch: (row: DatumText) => SwatchSpec | null;\n    26\t  readonly moreRows: (count: number) => string;\n    27\t  /** Label of the stack total row (the `total` message). */\n    28\t  readonly totalLabel?: string;\n    29\t  /** A row of a pinned tooltip was chosen (a click or a tap on it). */\n    30\t  readonly select?: (row: DatumText) => void;\n    31\t}\n    32\t\n    33\t/** Where a floating tooltip may go, all in viewport pixels. */\n    34\texport interface Placement {\n    35\t  /** The datum's active marks, enlarged by the focus ring: never covered. */\n    36\t  readonly box: Rect;\n    37\t  /** The plot rectangle the tooltip must stay inside. */\n    38\t  readonly plot: Rect;\n    39\t  /** 'vertical': above, below, right, left. 'horizontal' (horizontal bars): right, left, above, below. */\n    40\t  readonly order: 'vertical' | 'horizontal';\n    41\t  /** A donut's hole, tried first when the tooltip fits inside it. */\n    42\t  readonly hole?: Rect | null;\n    43\t  /** Controls the tooltip must not cover. */\n    44\t  readonly controls: readonly Rect[];\n    45\t}\n    46\t\n    47\texport interface TooltipView {\n    48\t  /** Floating, by the placement above. `pinned`: the tooltip takes events and its rows are buttons. */\n    49\t  show(content: TooltipContent, placement: Placement, pinned: boolean): void;\n    50\t  /** Readout mode: the content as running text in the strip under the plot, at most two lines. */\n    51\t  strip(content: TooltipContent, pinned: boolean): void;\n    52\t  hide(): void;\n    53\t  readonly visible: boolean;\n    54\t  /** Where the content is shown now. */\n    55\t  readonly where: 'floating' | 'readout' | null;\n    56\t  /** The floating tooltip's rectangle in viewport pixels, or null when it is not shown. */\n    57\t  rect(): Rect | null;\n    58\t  destroy(): void;\n    59\t}\n    60\t\n    61\tconst OFFSET = 8;\n    62\t\n    63\tinterface Bounds { left: number; top: number; right: number; bottom: number }\n    64\t\n    65\tfunction overlap(a: Bounds, b: Bounds): number {\n    66\t  const w = Math.min(a.right, b.right) - Math.max(a.left, b.left);\n    67\t  const h = Math.min(a.bottom, b.bottom) - Math.max(a.top, b.top);\n    68\t  return w > 0 && h > 0 ? w * h : 0;\n    69\t}\n    70\t\n    71\tconst bounds = (r: Rect): Bounds => ({ left: r.x, top: r.y, right: r.x + r.width, bottom: r.y + r.height });\n    72\t\n    73\t/**\n    74\t * Viewport pixels per layout pixel of `el`: 1 unless an ancestor scales it with a CSS transform. Bounding\n    75\t * rects are in viewport pixels, sizes and translations in layout pixels (part 1 item 12).\n    76\t */\n    77\texport function cssScale(el: HTMLElement): { x: number; y: number } {\n    78\t  const box = el.getBoundingClientRect();\n    79\t  // offsetWidth is rounded to an integer: within 2% the ratio is that rounding, not a transform.\n    80\t  const ratio = (rect: number, layout: number) => {\n    81\t    const k = layout > 0 && rect > 0 ? rect / layout : 1;\n    82\t    return Number.isFinite(k) && Math.abs(k - 1) >= 0.02 ? k : 1;\n    83\t  };\n    84\t  return { x: ratio(box.width, el.offsetWidth), y: ratio(box.height, el.offsetHeight) };\n    85\t}\n    86\t\n    87\t/** The viewport, cut down by every ancestor that clips its content. */\n    88\tfunction clipBounds(from: Element): Bounds {\n    89\t  const doc = from.ownerDocument;\n    90\t  const win = doc.defaultView;\n    91\t  const view = doc.documentElement;\n    92\t  const out: Bounds = { left: 0, top: 0, right: view.clientWidth, bottom: view.clientHeight };\n    93\t  for (let el: Element | null = from.parentElement; el && el !== view && win; el = el.parentElement) {\n    94\t    const style = win.getComputedStyle(el);\n    95\t    if (style.overflowX === 'visible' && style.overflowY === 'visible') continue;\n    96\t    const box = el.getBoundingClientRect();\n    97\t    out.left = Math.max(out.left, box.left);\n    98\t    out.top = Math.max(out.top, box.top);\n    99\t    out.right = Math.min(out.right, box.right);\n   100\t    out.bottom = Math.min(out.bottom, box.bottom);\n   101\t  }\n   102\t  return out;\n   103\t}\n   104\t\n   105\texport function createTooltip(element: HTMLElement, readoutElement: HTMLElement, figure: HTMLElement): TooltipView {\n   106\t  const doc = element.ownerDocument;\n   107\t  let where: 'floating' | 'readout' | null = null;\n   108\t  /** Row listeners belong to the rows of one fill; the next fill or hide removes them. */\n   109\t  let rows: AbortController | null = null;\n   110\t\n   111\t  function row(r: DatumText, content: TooltipContent, pinned: boolean, className: string): HTMLElement {\n   112\t    // A pinned row is a real control: a button named by its text, 24 px, outside the tab order (the closed\n   113\t    // chart keeps its two tab stops). A hovered row is text.\n   114\t    const select = pinned ? content.select : undefined;\n   115\t    const line = doc.createElement(select ? 'button' : 'div');\n   116\t    line.className = className;\n   117\t    if (line instanceof HTMLButtonElement && select) {\n   118\t      line.type = 'button';\n   119\t      line.tabIndex = -1;\n   120\t      line.classList.add('axylo-tooltip-choice');\n   121\t      // A press does not take focus from the plot, whose keyboard reading goes on from the chosen datum.\n   122\t      line.addEventListener('mousedown', event => event.preventDefault(), { signal: rows!.signal });\n   123\t      line.addEventListener('click', () => select(r), { signal: rows!.signal });\n   124\t    }\n   125\t    const name = doc.createElement('span');\n   126\t    name.className = 'axylo-tooltip-series';\n   127\t    const spec = content.swatch(r);\n   128\t    if (spec) name.appendChild(createSwatch(doc, spec));\n   129\t    name.appendChild(doc.createTextNode(r.seriesLabel));\n   130\t    const value = doc.createElement('span');\n   131\t    value.className = 'axylo-tooltip-value';\n   132\t    value.textContent = r.percent === null || r.percent === r.value ? r.value : `${r.value} (${r.percent})`;\n   133\t    // As running text in the strip, the name and the value are words of one sentence.\n   134\t    if (className === 'axylo-readout-entry') line.append(name, doc.createTextNode(' '), value);\n   135\t    else line.append(name, value);\n   136\t    return line;\n   137\t  }\n   138\t\n   139\t  /** The floating tooltip's content with the first `shown` rows; the rest are counted in \"+N more\". */\n   140\t  function fill(content: TooltipContent, pinned: boolean, shown: number): void {\n   141\t    rows?.abort();\n   142\t    rows = new AbortController();\n   143\t    const { model } = content;\n   144\t    const heading = doc.createElement('div');\n   145\t    heading.className = 'axylo-tooltip-title';\n   146\t    heading.textContent = model.title;\n   147\t    const children: HTMLElement[] = [heading];\n   148\t    for (const r of model.rows.slice(0, shown)) children.push(row(r, content, pinned, 'axylo-tooltip-row'));\n   149\t    const more = model.count - Math.min(shown, model.rows.length);\n   150\t    if (more > 0) {\n   151\t      const el = doc.createElement('div');\n   152\t      el.className = 'axylo-tooltip-more';\n   153\t      el.textContent = content.moreRows(more);\n   154\t      children.push(el);\n   155\t    }\n   156\t    if (model.total !== null) {\n   157\t      const total = doc.createElement('div');\n   158\t      total.className = 'axylo-tooltip-row axylo-tooltip-total';\n   159\t      const name = doc.createElement('span');\n   160\t      name.className = 'axylo-tooltip-series';\n   161\t      name.textContent = content.totalLabel ?? '';\n   162\t      const value = doc.createElement('span');\n   163\t      value.className = 'axylo-tooltip-value';\n   164\t      value.textContent = model.total;\n   165\t      total.append(name, value);\n   166\t      children.push(total);\n   167\t    }\n   168\t    element.replaceChildren(...children);\n   169\t  }\n   170\t\n   171\t  function hideFloating(): void {\n   172\t    if (element.hidden) return;\n   173\t    element.hidden = true;\n   174\t    element.classList.remove('axylo-tooltip-pinned');\n   175\t    element.replaceChildren();\n   176\t  }\n   177\t\n   178\t  function hideStrip(): void {\n   179\t    if (readoutElement.hidden) return;\n   180\t    readoutElement.hidden = true;\n   181\t    readoutElement.replaceChildren();\n   182\t  }\n   183\t\n   184\t  /** The candidates of rule 2 for a tooltip of this size, in order. */\n   185\t  function candidates(p: Placement, width: number, height: number): [number, number][] {\n/**\n * Comparing pick targets. Pointer, touch and drag input are handled by the interaction layer\n * (dom/interaction.ts); this only says whether two targets name the same thing.\n */\nimport type { PickTarget } from '../core/contracts';\n\n/** Two pick results name the same thing, so the tooltip need not be rebuilt. */\nexport function sameTarget(a: PickTarget | null, b: PickTarget | null): boolean {\n  if (a === null || b === null) return a === b;\n  if (a.kind === 'x' && b.kind === 'x') return a.x === b.x;\n  if (a.kind === 'slice' && b.kind === 'slice') return a.sliceKey === b.sliceKey;\n  if (a.kind === 'point' && b.kind === 'point') {\n    return a.count === b.count && a.refs.length === b.refs.length && a.refs.every((r, i) => {\n      const o = b.refs[i]!;\n      return r.kind === 'point' && o.kind === 'point' && r.seriesKey === o.seriesKey && r.row === o.row && r.x === o.x;\n    });\n  }\n  return false;\n}\n","exit_code":0,"status":"completed"}}
