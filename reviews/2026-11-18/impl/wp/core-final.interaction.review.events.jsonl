{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/table.ts && nl -ba packages/axylo/src/dom/toolbar.ts'","aggregated_output":"     1\t/**\n     2\t * \"View as table\" (spec A4): built only when opened, from the reader model's lazy table, and destroyed when\n     3\t * closed. A real table (caption, column headers with units, x values as row headers) inside a focusable,\n     4\t * labelled scroll region no taller than the plot, 100 rows per page, with a pager and a \"go to\" field that\n     5\t * jumps to the page holding an x value. Text only, never HTML.\n     6\t */\n     7\timport type { TableModel, XValue } from '../core/contracts';\n     8\timport { setAttr } from './attributes';\n     9\t\n    10\texport interface TableTexts {\n    11\t  readonly previousPage: string;\n    12\t  readonly nextPage: string;\n    13\t  /** \"Page {page} of {count}\" filled. */\n    14\t  pageOf(page: number, count: number): string;\n    15\t  /** Label of the \"go to\" field. */\n    16\t  readonly jump: string;\n    17\t  /** The error shown when nothing matches what was typed, with an example (the jumpNotFound message). */\n    18\t  readonly notFound?: (text: string) => string;\n    19\t  /** `lang` for each built-in string, or null. */\n    20\t  readonly lang: (key: 'previousPage' | 'nextPage' | 'pageOf' | 'jumpToX') => string | null;\n    21\t}\n    22\t\n    23\texport interface TableView {\n    24\t  readonly element: HTMLElement;\n    25\t  /** A new model (the data or the view changed): the current page is shown again from it. */\n    26\t  update(model: TableModel, texts: TableTexts, maxHeight: number): void;\n    27\t  /** Shows the page holding row `ordinal`. */\n    28\t  showRow(ordinal: number): void;\n    29\t  /** Moves focus to the table's scroll region. */\n    30\t  focus(): void;\n    31\t  readonly page: number;\n    32\t  destroy(): void;\n    33\t}\n    34\t\n    35\t/**\n    36\t * `toValue` turns what the reader typed into an x value the model understands (a number on a number axis,\n    37\t * the text otherwise).\n    38\t */\n    39\texport function createTableView(doc: Document, id: string, toValue: (text: string) => XValue | null): TableView {\n    40\t  const element = doc.createElement('div');\n    41\t  element.className = 'axylo-table';\n    42\t  const listening = new AbortController();\n    43\t  const signal = listening.signal;\n    44\t  element.id = `${id}-table`;\n    45\t  const scroll = doc.createElement('div');\n    46\t  scroll.className = 'axylo-table-scroll';\n    47\t  scroll.setAttribute('role', 'region');\n    48\t  scroll.tabIndex = 0;\n    49\t  const table = doc.createElement('table');\n    50\t  const caption = doc.createElement('caption');\n    51\t  caption.id = `${id}-table-caption`;\n    52\t  scroll.setAttribute('aria-labelledby', caption.id);\n    53\t  const head = doc.createElement('thead');\n    54\t  const body = doc.createElement('tbody');\n    55\t  table.append(caption, head, body);\n    56\t  scroll.appendChild(table);\n    57\t\n    58\t  const pager = doc.createElement('div');\n    59\t  pager.className = 'axylo-pager';\n    60\t  const previous = doc.createElement('button');\n    61\t  previous.type = 'button';\n    62\t  previous.className = 'axylo-control';\n    63\t  const status = doc.createElement('span');\n    64\t  status.className = 'axylo-page';\n    65\t  // The reader moved: saying the new page is an answer to their own action (spec A7).\n    66\t  status.setAttribute('aria-live', 'polite');\n    67\t  const next = doc.createElement('button');\n    68\t  next.type = 'button';\n    69\t  next.className = 'axylo-control';\n    70\t  const form = doc.createElement('form');\n    71\t  form.className = 'axylo-jump';\n    72\t  const label = doc.createElement('label');\n    73\t  const labelText = doc.createElement('span');\n    74\t  const field = doc.createElement('input');\n    75\t  field.type = 'text';\n    76\t  field.id = `${id}-table-jump`;\n    77\t  field.className = 'axylo-jump-field';\n    78\t  field.autocomplete = 'off';\n    79\t  label.htmlFor = field.id;\n    80\t  label.appendChild(labelText);\n    81\t  const error = doc.createElement('p');\n    82\t  error.className = 'axylo-jump-error';\n    83\t  error.id = `${id}-table-jump-error`;\n    84\t  error.hidden = true;\n    85\t  form.append(label, field, error);\n    86\t  pager.append(previous, status, next, form);\n    87\t  element.append(scroll, pager);\n    88\t\n    89\t  let model: TableModel | null = null;\n    90\t  let texts: TableTexts | null = null;\n    91\t  let page = 0;\n    92\t  let shownSignature = '';\n    93\t\n    94\t  const pages = () => model ? Math.max(1, Math.ceil(model.rowCount / model.pageSize)) : 1;\n    95\t\n    96\t  /**\n    97\t   * `reader`: the reader paged or jumped, so the new page is spoken. A render for new data keeps the status\n    98\t   * region quiet while its count changes (spec A7; review 2, finding 16).\n    99\t   */\n   100\t  function render(reader = false): void {\n   101\t    if (!model || !texts) return;\n   102\t    const count = pages();\n   103\t    page = Math.max(0, Math.min(page, count - 1));\n   104\t    const headers = model.headers.join('\\u0000');\n   105\t    if (caption.textContent !== model.caption) caption.textContent = model.caption;\n   106\t    if (head.dataset.headers !== headers) {\n   107\t      const row = doc.createElement('tr');\n   108\t      for (const text of model.headers) {\n   109\t        const th = doc.createElement('th');\n   110\t        th.scope = 'col';\n   111\t        th.textContent = text;\n   112\t        row.appendChild(th);\n   113\t      }\n   114\t      head.replaceChildren(row);\n   115\t      head.dataset.headers = headers;\n   116\t    }\n   117\t    const first = page * model.pageSize;\n   118\t    const last = Math.min(model.rowCount, first + model.pageSize);\n   119\t    const rows: HTMLTableRowElement[] = [];\n   120\t    for (let i = first; i < last; i++) {\n   121\t      const cells = model.row(i);\n   122\t      if (!cells) continue;\n   123\t      const tr = doc.createElement('tr');\n   124\t      cells.forEach((text, k) => {\n   125\t        const cell = doc.createElement(k === 0 ? 'th' : 'td');\n   126\t        if (k === 0) (cell as HTMLTableCellElement).scope = 'row';\n   127\t        cell.textContent = text;\n   128\t        tr.appendChild(cell);\n   129\t      });\n   130\t      rows.push(tr);\n   131\t    }\n   132\t    body.replaceChildren(...rows);\n   133\t    // A pager the reader is on does not vanish under them: focus goes to the table first (finding 17).\n   134\t    if (count <= 1 && pager.contains(doc.activeElement)) scroll.focus({ preventScroll: true });\n   135\t    pager.hidden = count <= 1;\n   136\t    previous.textContent = texts.previousPage;\n   137\t    next.textContent = texts.nextPage;\n   138\t    setAttr(previous, 'lang', texts.lang('previousPage'));\n   139\t    setAttr(next, 'lang', texts.lang('nextPage'));\n   140\t    setAttr(status, 'lang', texts.lang('pageOf'));\n   141\t    setAttr(label, 'lang', texts.lang('jumpToX'));\n   142\t    setAttr(previous, 'aria-disabled', page === 0 ? 'true' : null);\n   143\t    setAttr(next, 'aria-disabled', page >= count - 1 ? 'true' : null);\n   144\t    const pageText = texts.pageOf(page + 1, count);\n   145\t    if (status.textContent !== pageText) {\n   146\t      setAttr(status, 'aria-live', reader ? 'polite' : 'off');\n   147\t      status.textContent = pageText;\n   148\t    }\n   149\t    labelText.textContent = texts.jump;\n   150\t  }\n   151\t\n   152\t  previous.addEventListener('click', () => {\n   153\t    if (page > 0) { page--; render(true); scroll.scrollTop = 0; }\n   154\t  }, { signal });\n   155\t  next.addEventListener('click', () => {\n   156\t    if (page < pages() - 1) { page++; render(true); scroll.scrollTop = 0; }\n   157\t  }, { signal });\n   158\t  form.addEventListener('submit', event => {\n   159\t    event.preventDefault();\n   160\t    // As typed: a category is matched exactly; numbers and dates are trimmed by the parser (finding 18).\n   161\t    const value = toValue(field.value);\n   162\t    const target = value === null || !model ? null : model.pageForX(value);\n   163\t    if (target === null) {\n   164\t      field.setAttribute('aria-invalid', 'true');\n   165\t      if (texts?.notFound) {\n   166\t        error.textContent = texts.notFound(field.value.trim());\n   167\t        error.hidden = false;\n   168\t        field.setAttribute('aria-describedby', error.id);\n   169\t      }\n   170\t      return;\n   171\t    }\n   172\t    field.removeAttribute('aria-invalid');\n   173\t    field.removeAttribute('aria-describedby');\n   174\t    error.hidden = true;\n   175\t    page = target;\n   176\t    render(true);\n   177\t    scroll.scrollTop = 0;\n   178\t  }, { signal });\n   179\t\n   180\t  return {\n   181\t    element,\n   182\t    get page() {\n   183\t      return page;\n   184\t    },\n   185\t    update(nextModel, nextTexts, maxHeight) {\n   186\t      const signature = `${maxHeight}`;\n   187\t      model = nextModel;\n   188\t      texts = nextTexts;\n   189\t      // The table fills the plot's place (its stylesheet); the height is only a ceiling for the scroll region.\n   190\t      if (signature !== shownSignature) {\n   191\t        scroll.style.maxHeight = maxHeight > 0 ? `${Math.floor(maxHeight)}px` : '';\n   192\t        shownSignature = signature;\n   193\t      }\n   194\t      render();\n   195\t    },\n   196\t    focus() {\n   197\t      scroll.focus({ preventScroll: true });\n   198\t    },\n   199\t    showRow(ordinal) {\n   200\t      if (!model) return;\n   201\t      page = Math.floor(ordinal / model.pageSize);\n   202\t      render();\n   203\t    },\n   204\t    destroy() {\n   205\t      listening.abort();\n   206\t      element.remove();\n   207\t      model = null;\n   208\t    },\n   209\t  };\n   210\t}\n     1\t/**\n     2\t * The chart's one toolbar (spec A2, I2, I3, I4, I6): legend toggles, zoom, pause and the table control, as\n     3\t * ordinary buttons with roving focus, so the whole toolbar is a single tab stop. Arrow keys move between\n     4\t * controls, Home and End jump to the ends.\n     5\t *\n     6\t * Buttons are kept by key and updated in place, so a control the reader is on keeps focus across commits.\n     7\t * When the control that has focus goes away (Reset after resetting, Pause before any append), focus moves to\n     8\t * its neighbour instead of falling back to the page.\n     9\t */\n    10\timport { createSwatch, type SwatchSpec } from './swatch';\n    11\timport { setAttr } from './attributes';\n    12\t\n    13\texport interface ToolbarItem {\n    14\t  readonly key: string;\n    15\t  readonly label: string;\n    16\t  /** Toggle buttons (legend entries): aria-pressed. */\n    17\t  readonly pressed?: boolean;\n    18\t  /** Disclosure buttons (the table control): aria-expanded and, while expanded, aria-controls. */\n    19\t  readonly expanded?: boolean;\n    20\t  readonly controls?: string | null;\n    21\t  readonly swatch?: SwatchSpec;\n    22\t  /** A hidden series: struck-through name, outline swatch (never dimmed text, spec L2). */\n    23\t  readonly struck?: boolean;\n    24\t  /** `lang` of the button ('en' for built-in text on a page in another language), or null. */\n    25\t  readonly lang: string | null;\n    26\t  readonly className: string;\n    27\t  /** The control can do nothing now (Zoom in at the smallest window): aria-disabled, activation ignored. */\n    28\t  readonly disabled?: boolean;\n    29\t  activate(): void;\n    30\t}\n    31\t\n    32\texport interface Toolbar {\n    33\t  readonly element: HTMLElement;\n    34\t  render(items: readonly ToolbarItem[], label: string, lang: string | null): void;\n    35\t  /** Moves focus to the control with this key; false when there is none. */\n    36\t  focus(key: string): boolean;\n    37\t  destroy(): void;\n    38\t}\n    39\t\n    40\texport function createToolbar(doc: Document): Toolbar {\n    41\t  const element = doc.createElement('div');\n    42\t  element.className = 'axylo-toolbar';\n    43\t  element.setAttribute('role', 'toolbar');\n    44\t  // Every listener of the toolbar and its buttons goes with destroy (review 2: none left on removed elements).\n    45\t  const listening = new AbortController();\n    46\t  const signal = listening.signal;\n    47\t  const buttons = new Map<string, { button: HTMLButtonElement; item: ToolbarItem; signature: string }>();\n    48\t  let current: string | null = null;\n    49\t  let order: string[] = [];\n    50\t\n    51\t  function setCurrent(key: string | null): void {\n    52\t    current = key;\n    53\t    for (const [k, { button }] of buttons) button.tabIndex = k === current ? 0 : -1;\n    54\t  }\n    55\t\n    56\t  function move(to: number): void {\n    57\t    if (!order.length) return;\n    58\t    const key = order[(to + order.length) % order.length]!;\n    59\t    setCurrent(key);\n    60\t    buttons.get(key)!.button.focus();\n    61\t  }\n    62\t\n    63\t  element.addEventListener('keydown', (event: KeyboardEvent) => {\n    64\t    if (event.altKey || event.ctrlKey || event.metaKey) return;\n    65\t    const at = current === null ? -1 : order.indexOf(current);\n    66\t    switch (event.key) {\n    67\t      case 'ArrowRight': case 'ArrowDown': move(at + 1); break;\n    68\t      case 'ArrowLeft': case 'ArrowUp': move(at - 1); break;\n    69\t      case 'Home': move(0); break;\n    70\t      case 'End': move(order.length - 1); break;\n    71\t      default: return;\n    72\t    }\n    73\t    event.preventDefault();\n    74\t  }, { signal });\n    75\t  element.addEventListener('focusin', (event: FocusEvent) => {\n    76\t    for (const [key, { button }] of buttons) if (button === event.target) setCurrent(key);\n    77\t  }, { signal });\n    78\t\n    79\t  function fill(button: HTMLButtonElement, item: ToolbarItem): void {\n    80\t    const children: Node[] = [];\n    81\t    if (item.swatch) children.push(createSwatch(doc, item.swatch));\n    82\t    const text = doc.createElement('span');\n    83\t    text.className = 'axylo-control-label';\n    84\t    text.textContent = item.label;\n    85\t    children.push(text);\n    86\t    button.replaceChildren(...children);\n    87\t  }\n    88\t\n    89\t  return {\n    90\t    element,\n    91\t    render(items, label, lang) {\n    92\t      setAttr(element, 'aria-label', label);\n    93\t      setAttr(element, 'lang', lang);\n    94\t      const focused = doc.activeElement;\n    95\t      let focusedKey: string | null = null;\n    96\t      for (const [key, { button }] of buttons) if (button === focused) focusedKey = key;\n    97\t      const keys = items.map(i => i.key);\n    98\t      // Where a focused control that is going away hands focus: the control now at its place, or the last.\n    99\t      let heir: string | null = null;\n   100\t      if (focusedKey !== null && !keys.includes(focusedKey)) {\n   101\t        const was = order.indexOf(focusedKey);\n   102\t        const after = order.slice(was + 1).find(k => keys.includes(k));\n   103\t        const before = order.slice(0, was).reverse().find(k => keys.includes(k));\n   104\t        heir = after ?? before ?? keys[0] ?? null;\n   105\t      }\n   106\t      for (const [key, entry] of buttons) {\n   107\t        if (!keys.includes(key)) {\n   108\t          entry.button.remove();\n   109\t          buttons.delete(key);\n   110\t        }\n   111\t      }\n   112\t      let previous: HTMLButtonElement | null = null;\n   113\t      for (const item of items) {\n   114\t        let entry = buttons.get(item.key);\n   115\t        if (!entry) {\n   116\t          const button = doc.createElement('button');\n   117\t          button.type = 'button';\n   118\t          button.addEventListener('click', () => {\n   119\t            const current = buttons.get(item.key)?.item;\n   120\t            if (current && !current.disabled) current.activate();\n   121\t          }, { signal });\n   122\t          entry = { button, item, signature: '' };\n   123\t          buttons.set(item.key, entry);\n   124\t        }\n   125\t        entry.item = item;\n   126\t        const { button } = entry;\n   127\t        const signature = JSON.stringify([item.label, item.swatch, item.struck]);\n   128\t        if (signature !== entry.signature) {\n   129\t          fill(button, item);\n   130\t          entry.signature = signature;\n   131\t        }\n   132\t        if (button.className !== item.className) button.className = item.className;\n   133\t        button.classList.toggle('axylo-struck', item.struck === true);\n   134\t        setAttr(button, 'aria-pressed', item.pressed === undefined ? null : String(item.pressed));\n   135\t        setAttr(button, 'aria-expanded', item.expanded === undefined ? null : String(item.expanded));\n   136\t        setAttr(button, 'aria-controls', item.expanded ? item.controls ?? null : null);\n   137\t        setAttr(button, 'lang', item.lang);\n   138\t        setAttr(button, 'aria-disabled', item.disabled ? 'true' : null);\n   139\t        const place: ChildNode | null = previous ? previous.nextSibling : element.firstChild;\n   140\t        if (place !== button) element.insertBefore(button, place);\n   141\t        previous = button;\n   142\t      }\n   143\t      order = keys;\n   144\t      const keep = heir ?? (current !== null && keys.includes(current) ? current : keys[0] ?? null);\n   145\t      setCurrent(keep);\n   146\t      if (heir !== null) buttons.get(heir)!.button.focus();\n   147\t      // A reorder moves the focused button, which can drop focus: it is given back (review 2, finding 17).\n   148\t      else if (focusedKey !== null && doc.activeElement !== buttons.get(focusedKey)?.button) buttons.get(focusedKey)?.button.focus();\n   149\t    },\n   150\t    focus(key) {\n   151\t      const entry = buttons.get(key);\n   152\t      if (!entry) return false;\n   153\t      entry.button.focus();\n   154\t      return doc.activeElement === entry.button;\n   155\t    },\n   156\t    destroy() {\n   157\t      listening.abort();\n   158\t      element.remove();\n   159\t      buttons.clear();\n   160\t    },\n   161\t  };\n   162\t}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"cat docs/decisions/0001-plot-interaction-pattern.md | tail -18 && sed -n '188,200p' docs/02-product-spec.md && nl -ba packages/axylo/src/theme/css.ts | sed -n '185,211p' && rg -n 'readout|freeze|retire|held|discard|layoutKey' packages/axylo/src/core/{controller,axes}.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_23","type":"command_execution","command":"/bin/bash -lc \"cat docs/decisions/0001-plot-interaction-pattern.md | tail -18 && sed -n '188,200p' docs/02-product-spec.md && nl -ba packages/axylo/src/theme/css.ts | sed -n '185,211p' && rg -n 'readout|freeze|retire|held|discard|layoutKey' packages/axylo/src/core/{controller,axes}.ts\"","aggregated_output":"| C. One native `<input type=\"range\">` laid over the plot, its value the position along x, its `aria-valuetext` the point's text | A native control: desktop readers enter focus mode on it by themselves, arrow keys, Home, End and Page keys work without script, and a change of value text is read without a live region. Touch screen readers expose a native range as an adjustable element, so swiping up and down moves through points (from memory for VoiceOver on iOS and TalkBack; not verified here). One element whatever the number of points. | It is announced as a slider, which is not what a chart is; mitigated by `aria-roledescription` and a label that says what moving it does. Up and Down natively do the same as Right and Left. |\n\n## Choice: C\n\nOne visually transparent native range input covers the plot. It is the plot's single tab stop.\n\n- **Value**: the ordinal of the current x among the visible x positions (for scatter: among visible points in x then y order; for donut: slice order), from `Lookup.ordinal` and `Lookup.count`.\n- **Value text**: by default everything at that x, like the pointer tooltip: the x, then each visible series with its value, then \"point 4 of 120\". After the reader narrows to one series (Up or Down on a keyboard), only that series is read. Escape returns to all series.\n- **Keys**: Left and Right move along x (native). Home, End, Page Up and Page Down native. Up and Down are intercepted to change the series in focus. `+`, `-`, `0` and Shift+arrows zoom and pan. Enter or Space selects (fires `select`). Escape: closes the tooltip first, then leaves single-series mode; otherwise it is not consumed, so a chart inside a dialog does not swallow it.\n- **Touch screen readers**: swiping up or down on the adjustable element moves along x and reads every series at that x; the table is one control away in the toolbar.\n- **Everything else** (legend toggles, zoom buttons, pause, table) is ordinary buttons in one toolbar with roving focus: the chart's second and last tab stop while the table is closed.\n\n## What has to be checked by rehearsal\n\n1. NVDA with Chrome and with Firefox: focus mode is entered on the range without a keystroke; each arrow press reads the new value text once; Up and Down are passed through and the series change is read.\n2. VoiceOver with Safari on macOS: the same, and the role description is read sensibly.\n3. VoiceOver on iOS and TalkBack with Chrome: the element is reachable by touch exploration at the plot's position; swipe up and down move by one point and read it; the toolbar and table are reachable by swiping right.\n4. That a long value text (eight series) is not cut off, and that streaming data does not make the reader speak unless the reader moves.\n### 3.6 Type matrix\n\n| | Line | Area | Bar | Donut | Scatter |\n|---|---|---|---|---|---|\n| Picking by pointer | Nearest x | Nearest x | The band under the pointer | The slice under the pointer | Nearest point within 24 px; ties go to the later row |\n| Tooltip content | Every visible series at that x | Same, plus the stack total | Every series in that category | Label, value, percentage | The point's series, x and y; coincident points listed, up to eight |\n| Keyboard order | By x, then series | By x, then series | By category, then series | By slice order | By x, then y |\n| Zoom | On time, date and numeric x only | On time, date and numeric x only | On time, date and numeric x only | No | Yes, both axes later; x only in 1.0 |\n| Simplified drawing when dense | F5 | F5 on cumulative sums | No; more bars than pixels raises a hint | No | No in 1.0; above 50,000 points a hint says drawing may be slow |\n| Limit that raises a diagnostic | Eight series | Eight series | Eight series | Eight slices | Eight series |\n| Reference lines and bands | Yes; included in the domain; listed in the summary and table caption | Yes | Yes | No | Yes |\n\n### 3.7 Compact variant\n   185\t  /* Readout mode (rule 5): a strip of two lines reserved under the plot, in the plot's column, as running\n   186\t     text. Outside readout mode it does not exist. */\n   187\t  .axylo .axylo-readout { display: none; }\n   188\t  .axylo .axylo-readout-mode .axylo-readout {\n   189\t    display: block; flex: none; box-sizing: border-box; height: calc(2 * max(24px, 1.4 * max(12px, 0.875em)));\n   190\t    margin: 0; padding: 0 4px; overflow: hidden; font-size: max(12px, 0.875em); line-height: max(24px, 1.4em);\n   191\t    color: var(--axylo-text, currentColor); overflow-wrap: anywhere;\n   192\t  }\n   193\t  .axylo .axylo-readout-mode .axylo-readout[hidden] { display: block !important; visibility: hidden; }\n   194\t  .axylo .axylo-readout .axylo-tooltip-title { display: inline; }\n   195\t  .axylo .axylo-readout .axylo-readout-entry, .axylo .axylo-readout .axylo-tooltip-series { display: inline; }\n   196\t  .axylo .axylo-readout .axylo-swatch { vertical-align: middle; margin-inline-end: 0.25em; }\n   197\t  /* A pinned row or a slice-list entry can be chosen with a click or a tap (WCAG 2.5.1): real buttons, at\n   198\t     least 24 × 24 px (WCAG 2.5.8), that look like the text they hold. */\n   199\t  .axylo .axylo-tooltip-choice, .axylo .axylo-legend-choice {\n   200\t    cursor: pointer; box-sizing: border-box; margin: 0; padding: 0; border: 0; background: none;\n   201\t    font: inherit; color: inherit; text-align: inherit; align-items: center; min-height: 24px; min-width: 24px;\n   202\t  }\n   203\t  .axylo .axylo-legend-choice { display: inline-flex; gap: 0.375em; }\n   204\t  .axylo .axylo-tooltip .axylo-tooltip-choic