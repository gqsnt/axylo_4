t page.mouse.move(0, 0);\n   315\t        await page.focus('#before');\n   316\t        await page.keyboard.press('Tab');\n   317\t        for (let i = 0; i < 4; i++) { await page.keyboard.press('ArrowRight'); await settle(page); await check('keyboard'); }\n   318\t        await closePage(page);\n   319\t      }\n   320\t      expect(failures).toEqual([]);\n   321\t    });\n   322\t\n   323\t    for (const axis of ['width', 'height'] as const) {\n   324\t      it(`I1 ${type}: readout mode is decided by layout: on each side of the ${axis === 'width' ? '240 px width' : '140 px height'} limit (the plot jumps across it when the strip is reserved), a plot at or above it gets a floating tooltip and one below it gets the content in a strip reserved under the plot, with no floating tooltip; showing or hiding a datum moves nothing; the strip covers nothing and nothing covers it`, async () => {\n   325\t        const page = await devPage({ viewport: { width: 1000, height: 900 } });\n   326\t        await create(page, type);\n   327\t        const limit = axis === 'width' ? 240 : 140;\n   328\t        const sides = await plotSides(page, axis, limit);\n   329\t        for (const [side, readout] of [[sides.floating, false], [sides.readout, true]] as const) {\n   330\t          await page.evaluate(([a, s]) => { (document.querySelector('#chart') as HTMLElement).style[a as 'width' | 'height'] = `${s}px`; }, [axis, side.container] as const);\n   331\t          await settle(page);\n   332\t          const got = (await box(page, '#chart .axylo-proxy'))[axis];\n   333\t          const target = `${got.toFixed(1)} px`;\n   334\t          expect(readout ? got > 0 && got < limit : got >= limit, `${readout ? 'readout' : 'floating'} side: plot ${axis} ${target}`).toBe(true);\n   335\t          const layout = () => figureLayout(page);\n   336\t          await page.mouse.move(0, 0);\n   337\t          await settle(page);\n   338\t          const hidden = await layout();\n   339\t          const p = (await probes(page, type))[type === 'donut' ? 2 : type === 'scatter' ? 4 : 10]!;\n   340\t          await page.mouse.move(p.x, p.y);\n   341\t          await settle(page);\n   342\t          const strip = page.locator('#chart .axylo-readout');\n   343\t          if (readout) {\n   344\t            expect(await tooltip(page).isVisible(), `${target} px: no floating tooltip in readout mode`).toBe(false);\n   345\t            expect(await strip.isVisible(), `${target} px: the strip shows the datum`).toBe(true);\n   346\t            expect(says((await strip.textContent()) ?? '', p), `${target} px: strip text`).toBe(true);\n   347\t            const s = await box(page, '#chart .axylo-readout');\n   348\t            const plotBox = await box(page, '#chart .axylo-plot');\n   349\t            expect(s.y, 'under the plot').toBeGreaterThanOrEqual(plotBox.y + plotBox.height - 0.5);\n   350\t            const lines = await strip.evaluate(el => Math.round(el.getBoundingClientRect().height / parseFloat(getComputedStyle(el).lineHeight)));\n   351\t            expect(lines).toBeLessThanOrEqual(2);\n   352\t            // Covers nothing and is covered by nothing: no other visible element of the figure intersects it, and\n   353\t            // what is at its centre is the strip.\n   354\t            const others: Box[] = [];\n   355\t            for (const e of await page.locator('#chart button, #chart .axylo-legend-list li, #chart .axylo-note, #chart .axylo-plot').all()) if (await e.isVisible()) others.push((await e.boundingBox())!);\n   356\t            expect(covered(s, others).map(o => `${Math.round(o.x)},${Math.round(o.y)}`)).toEqual([]);\n   357\t            const atCentre = await page.evaluate(({ x, y }) => !!document.elementFromPoint(x, y)?.closest('.axylo-readout'), center(s));\n   358\t            expect(atCentre).toBe(true);\n   359\t          } else {\n   360\t            expect(await tooltip(page).isVisible(), `${target} px: a floating tooltip`).toBe(true);\n   361\t          }\n   362\t          expect(await layout(), `${target} px: showing a datum moved the layout`).toBe(hidden);\n   363\t          await page.mouse.move(0, 0);\n   364\t          await settle(page);\n   365\t          expect(await layout(), `${target} px: hiding it moved the layout`).toBe(hidden);\n   366\t        }\n   367\t        expect(await closePage(page)).toEqual([]);\n   368\t      });\n   369\t    }\n   370\t\n   371\t    if (type !== 'donut') {\n   372\t      it(`I1 ${type}: with ten series ${type === 'scatter' ? 'on one coincident point' : 'at one x'} the tooltip lists eight of the series by name and \"+2 more\"; in readout mode the strip, on at most two lines, names the same series in the same order up to where it is cut and counts the rest in \"+N more\"`, async () => {\n   373\t        const page = await devPage({ viewport: { width: 1000, height: 1000 } });\n   374\t        const names = Array.from({ length: 10 }, (_, i) => `Region number ${i + 1}`);\n   375\t        const data = type === 'scatter'\n   376\t          ? names.map(s => ({ x: 5, y: 5, s })).concat([{ x: 1, y: 1, s: names[0]! }, { x: 9, y: 9, s: names[0]! }])\n   377\t          : names.flatMap((s, i) => ['A', 'B', 'C'].map((x, k) => ({ x, s, y: 10 + i + k })));\n   378\t        await createRaw(page, type, { title: 'Ten', data, x: 'x', y: 'y', series: 's' });\n   379\t        const p = await box(page, '#chart .axylo-proxy');\n   380\t        await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n   381\t        await settle(page);\n   382\t        expect(await tooltip(page).isVisible()).toBe(true);\n   383\t        const shown = await page.locator('#chart .axylo-tooltip .axylo-tooltip-row:not(.axylo-tooltip-total) .axylo-tooltip-series').allTextContents();\n   384\t        expect(shown).toHaveLength(8);\n   385\t        expect(new Set(shown).size).toBe(8);\n   386\t        expect(shown.every(n => names.includes(n))).toBe(true);\n   387\t        expect((await tooltip(page).textContent()) ?? '').toContain('+2 more');\n   388\t        await page.mouse.move(0, 0);\n   389\t        // Tall, so the ten legend entries still leave a readable plot at that width (spec L8).\n   390\t        await page.evaluate(() => { (document.querySelector('#chart') as HTMLElement).style.height = '760px'; });\n   391\t        const got = await plotTo(page, 'width', 200);\n   392\t        expect(got).toBeLessThan(240);\n   393\t        expect(got).toBeGreaterThan(120);\n   394\t        const q = await box(page, '#chart .axylo-proxy');\n   395\t        await page.mouse.move(q.x + q.width / 2, q.y + q.height / 2);\n   396\t        await settle(page);\n   397\t        const strip = page.locator('#chart .axylo-readout');\n   398\t        expect(await strip.isVisible()).toBe(true);\n   399\t        expect(await tooltip(page).isVisible()).toBe(false);\n   400\t        const text = (await strip.textContent()) ?? '';\n   401\t        const inStrip = names.filter(n => new RegExp(`${n}(?!\\\\d)`).test(text)).sort((a, b) => text.indexOf(a) - text.indexOf(b));\n   402\t        expect(inStrip.length).toBeGreaterThan(0);\n   403\t        // In the tooltip's order, from its start.\n   404\t        expect(inStrip).toEqual(shown.slice(0, inStrip.length));\n   405\t        const more = /\\+(\\d+) more/.exec(text);\n   406\t        expect(more, 'the strip counts the rest').not.toBeNull();\n   407\t        expect(Number(more![1])).toBe(10 - inStrip.length);\n   408\t        const lines = await strip.evaluate(el => Math.round(el.getBoundingClientRect().height / parseFloat(getComputedStyle(el).lineHeight)));\n   409\t        expect(lines).toBeLessThanOrEqual(2);\n   410\t        expect(await closePage(page)).toEqual([]);\n   411\t      });\n   412\t    }\n   413\t  }\n   414\t\n   415\t  /** Bars that fill the plot's height (author domain [0, 100]), so a tooltip cannot go above or below and is placed beside. */\n   416\t  async function besideBars(page: Page): Promise<{ centres: number[]; tip: Box; plot: Box }> {\n   417\t    await createRaw(page, 'bar', { title: 'Tall', data: ['Q1', 'Q2', 'Q3', 'Q4', 'Q5', 'Q6'].map(q => ({ q, v: 100 })), x: 'q', y: { field: 'v', domain: [0, 100] } });\n   418\t    const centres = ((await shapes(page, '#chart', 100000))[1] ?? []).map(s => center(s.box).x).sort((a, b) => a - b);\n   419\t    const plot = await box(page, '#chart .axylo-proxy');\n   420\t    await page.mouse.move(centres[2]!, plot.y + plot.height / 2);\n   421\t    await settle(page);\n   422\t    const tip = await box(page, '#chart .axylo-tooltip');\n   423\t    return { centres, tip, plot };\n   424\t  }\n   425\t  const title = async (page: Page) => ((await tooltip(page).isVisible()) ? ((await page.locator('#chart .axylo-tooltip .axylo-tooltip-title').textContent()) ?? '') : '');\n   426\t\n   427\t  it('I1 bar: rule 3b converse: without a rest, the straight path to a tooltip placed beside a full-height bar changes the datum as soon as it crosses into the next band', async () => {\n   428\t    const page = await devPage();\n   429\t    const { centres, tip, plot } = await besideBars(page);\n   430\t    // Precondition: the tooltip is beside the bar (not above or below), so the path to it crosses bands.\n   431\t    expect(tip.x > centres[2]! || tip.x + tip.width < centres[2]!, `tooltip ${JSON.stringify(tip)} beside the bar at ${centres[2]}`).toBe(true);\n   432\t    const y = plot.y + plot.height / 2;\n   433\t    const toward = tip.x > centres[2]! ? 1 : -1;\n   434\t    const next = centres[2 + toward]!;\n   435\t    // No rest: arrive and leave at once, in steps of 6 px, past the half-way line to the next band.\n   436\t    await page.mouse.move(0, 0);\n   437\t    await page.mouse.move(centres[2]!, y);\n   438\t    const seen: string[] = [];\n   439\t    for (let x = centres[2]!; toward > 0 ? x <= next : x >= next; x += 6 * toward) {\n   440\t      await page.mouse.move(x, y, { steps: 1 });\n   441\t      seen.push(await title(page));\n   442\t    }\n   443\t    await settle(page);\n   444\t    seen.push(await title(page));\n   445\t    expect(seen.at(-1), `datum after crossing: ${seen.join(' → ')}`).toBe(toward > 0 ? 'Q4' : 'Q2');\n   446\t    expect(await closePage(page)).toEqual([]);\n   447\t  });\n   448\t\n   449\t  it('I1 bar: rule 3b converse: after a rest, leaving the corridor to the tooltip sideways resumes picking on that move', async () => {\n   450\t    const page = await devPage();\n   451\t    const { centres, tip, plot } = await besideBars(page);\n   452\t    const y = plot.y + plot.height / 2;\n   453\t    await page.waitForTimeout(300);\n   454\t    // Part of the way along the corridor (held), then straight up out of it, over the next band.\n   455\t    const toward = tip.x > centres[2]! ? 1 : -1;\n   456\t    const next = centres[2 + toward]!;\n   457\t    await page.mouse.move(next, y, { steps: 6 });\n   458\t    await settle(page);\n   459\t    expect(await title(page), 'held along the corridor').toBe('Q3');\n   460\t    await page.mouse.move(next, Math.max(plot.y + 4, tip.y - 30), { steps: 1 });\n   461\t    await settle(page);\n   462\t    expect(await title(page), 'out of the corridor: the band under the pointer').toBe(toward > 0 ? 'Q4' : 'Q2');\n   463\t    expect(await closePage(page)).toEqual([]);\n   464\t  });\n   465\t\n   466\t  it('I1 bar: a fast sweep that never rests is never held: one move per band, across a tooltip placed beside the bars, shows every band in turn', async () => {\n   467\t    const page = await devPage();\n   468\t    const { centres, plot } = await besideBars(page);\n   469\t    const y = plot.y + plot.height / 2;\n   470\t    await page.mouse.move(0, 0);\n   471\t    const shown: string[] = [];\n   472\t    for (const x of centres) { await page.mouse.move(x, y, { steps: 1 }); await settle(page); shown.push(await title(page)); }\n   473\t    expect(shown).toEqual(['Q1', 'Q2', 'Q3', 'Q4', 'Q5', 'Q6']);\n   474\t    expect(await closePage(page)).toEqual([]);\n   475\t  });\n   476\t\n   477\t  it('I1 donut: a fast sweep that never rests is never held: one move per slice, around the ring, shows every slice in turn', async () => {\n   478\t    const page = await devPage();\n   479\t    await create(page, 'donut');\n   480\t    const g = await ring(page);\n   481\t    await page.mouse.move(0, 0);\n   482\t    const shown: string[] = [];\n   483\t    let before = 0;\n   484\t    for (let i = 0; i < SPEND.values.length; i++) {\n   485\t      const a = (2 * Math.PI * (before + SPEND.values[i]! / 2)) / SPEND_TOTAL;\n   486\t      before += SPEND.values[i]!;\n   487\t      await page.mouse.move(g.cx + 0.85 * g.outer * Math.sin(a), g.cy - 0.85 * g.outer * Math.cos(a), { steps: 1 });\n   488\t      await settle(page);\n   489\t      shown.push((await tooltip(page).isVisible()) ? ((await tooltip(page).textContent()) ?? '') : '');\n   490\t    }\n   491\t    SPEND.items.forEach((item, i) => expect(shown[i], `slice ${i + 1}`).toContain(item));\n   492\t    expect(await closePage(page)).toEqual([]);\n   493\t  });\n   494\t\n   495\t  for (const type of ['line', 'area', 'bar'] as const) {\n   496\t    it(`I1 ${type}: a series with no row at the pointed x reads \"No observation\", distinct from \"No data\" for an explicit null`, async () => {\n   497\t      const page = await devPage();\n   498\t      // B has no row at the second x and a null at the third. The x values are irregular numbers (categories\n   499\t      // for the bar), so no absent step is turned into a gap (spec F2, AX105) and the absent row stays one.\n   500\t      const xs = type === 'bar' ? ['a', 'b', 'c', 'd'] : [1, 2, 5, 9];\n   501\t      const data = [...xs.map((x, i) => ({ x, s: 'A', y: i + 1 })), { x: xs[0], s: 'B', y: 5 }, { x: xs[2], s: 'B', y: null }, { x: xs[3], s: 'B', y: 6 }];\n   502\t      await createRaw(page, type, { title: 'Sparse', data, x: 'x', y: 'y', series: 's' });\n   503\t      const centres = ((await shapes(page, '#chart', type === 'bar' ? 100000 : 14))[1] ?? []).map(m => center(m.box)).sort((a, b) => a.x - b.x);\n   504\t      expect(centres).toHaveLength(4);\n   505\t      const p = await box(page, '#chart .axylo-proxy');\n   506\t      const at = async (i: number) => {\n   507\t        await page.mouse.move(0, 0);\n   508\t        await settle(page);\n   509\t        await page.mouse.move(centres[i]!.x, p.y + p.height / 2);\n   510\t        await settle(page);\n   511\t        return (await tooltip(page).textContent()) ?? '';\n   512\t      };\n   513\t      const second = await at(1);\n   514\t      expect(inOrder(second, ['B', 'No observation']), second).toBe(true);\n   515\t      expect(second).not.toContain('No data');\n   516\t      const third = await at(2);\n   517\t      expect(inOrder(third, ['B', 'No data']), third).toBe(true);\n   518\t      expect(await closePage(page)).toEqual([]);\n   519\t    });\n   520\t  }\n   521\t});\n   522\t\n   523\t// ── I2 ────────────────────────────────────────────────────────────────────────────────────────────\n   524\t\n   525\tdescribe('I2 legend toggles', () => {\n   526\t  for (const type of CARTESIAN as ('line' | 'area' | 'bar' | 'scatter')[]) {\n   527\t    it(`I2 ${type}: legend entries are toggle buttons with a pressed state, operable by click, Enter and Space; after each, the marks follow`, async () => {\n   528\t      const page = await devPage();\n   529\t      await create(page, type);\n   530\t      const name = type === 'bar' ? 'Plan' : type === 'scatter' ? 'EU' : 'North';\n   531\t      const pressed = async () => (await axWithin(page, '#chart')).find(n => n.role === 'button' && n.name === name)?.props.pressed;\n   532\t      const marks = async () => (await shapes(page, '#chart', 100000))[1]?.length ?? 0;\n   533\t      expect(await pressed()).toBe('true');\n   534\t      const shown = await marks();\n   535\t      expect(shown).toBeGreaterThan(0);\n   536\t      await page.locator('#chart .axylo-legend-entry', { hasText: name }).click();\n   537\t      await settle(page);\n   538\t      expect(await pressed()).toBe('false');\n   539\t      expect(await marks()).toBe(0);\n   540\t      await page.locator('#chart .axylo-legend-entry', { hasText: name }).focus();\n   541\t      await page.keyboard.press('Enter');\n   542\t      await settle(page);\n   543\t      expect(await pressed()).toBe('true');\n   544\t      expect(await marks()).toBe(shown);\n   545\t      await page.keyboard.press(' ');\n   546\t      await settle(page);\n   547\t      expect(await pressed()).toBe('false');\n   548\t      expect(await marks()).toBe(0);\n   549\t      expect(await closePage(page)).toEqual([]);\n   550\t    });\n   551\t  }\n   552\t});\n   553\t\n   554\t// ── I3 ────────────────────────────────────────────────────────────────────────────────────────────\n   555\t\n   556\ttype Zoomable = 'line' | 'area' | 'bar' | 'bar (date)' | 'scatter';\n   557\t/** A chart whose x can zoom: bars on a number and on a date axis (spec 3.6: never a category axis). */\n   558\tasync function zoomable(page: Page, type: Zoomable): Promise<void> {\n   559\t  if (type === 'bar (date)') {\n   560\t    const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n   561\t    await createRaw(page, 'bar', { title: 'Daily', data: Array.from({ length: 40 }, (_, k) => ({ day: day(k), v: 10 + (k % 7) })), x: { field: 'day', type: 'date' }, y: 'v' });\n   562\t  } else if (type === 'scatter') {\n   563\t    await createRaw(page, 'scatter', { title: 'Points', data: Array.from({ length: 40 }, (_, k) => ({ x: k, y: (k * 7) % 13 })), x: 'x', y: 'y' });\n   564\t  } else {\n   565\t    await createRaw(page, type, { title: 'Numbers', data: Array.from({ length: 40 }, (_, k) => ({ x: k, y: 10 + (k % 7) })), x: { field: 'x', type: 'number' }, y: 'y' });\n   566\t  }\n   567\t}\n   568\tconst xDomain = (page: Page) => page.evaluate(() => (window as unknown as { charts: { __bench: { describe(): { xDomain: number[] } } }[] }).charts[0]!.__bench.describe().xDomain);\n   569\tconst width = (d: number[]) => d[1]! - d[0]!;\n   570\tconst cell = (t: Zoomable): ChartType => (t === 'bar (date)' ? 'bar' : t);\n   571\t\n   572\tdescribe('I3 zoom four ways', () => {\n   573\t  for (const type of ['line', 'area', 'bar', 'bar (date)', 'scatter'] as Zoomable[]) {\n   574\t    it(`I3 ${cell(type)}${type === 'bar (date)' ? ' (date axis)' : type === 'bar' ? ' (number axis)' : ''}: by single clicks only: Zoom in twice quarters the range, Zoom out doubles it, Pan right reaches the end, Reset returns`, async () => {\n   575\t      const page = await devPage();\n   576\t      await zoomable(page, type);\n   577\t      const full = await xDomain(page);\n   578\t      const button = (label: string) => page.locator('#chart [role=\"toolbar\"] button', { hasText: label });\n   579\t      await button('Zoom in').click();\n   580\t      await settle(page);\n   581\t      await button('Zoom in').click();\n   582\t      await settle(page);\n   583\t      expect(width(await xDomain(page))).toBeCloseTo(width(full) / 4, 0);\n   584\t      await button('Zoom out').click();\n   585\t      await settle(page);\n   586\t      expect(width(await xDomain(page))).toBeCloseTo(width(full) / 2, 0);\n   587\t      // Single-click panning (WCAG 2.5.7): a visible control moves the window without dragging.\n   588\t      expect(await button('Pan right').count()).toBe(1);\n   589\t      for (let i = 0; i < 20 && (await xDomain(page))[1]! < full[1]! - 1e-9; i++) { await button('Pan right').click(); await settle(page); }\n   590\t      expect((await xDomain(page))[1]).toBeCloseTo(full[1]!, 5);\n   591\t      await button('Reset zoom').click();\n   592\t      await settle(page);\n   593\t      expect(await xDomain(page)).toEqual(full);\n   594\t      expect(await closePage(page)).toEqual([]);\n   595\t    });\n   596\t\n   597\t    it(`I3 ${cell(type)}${type === 'bar (date)' ? ' (date axis)' : type === 'bar' ? ' (number axis)' : ''}: dragging across the plot selects that x range`, async () => {\n   598\t      const page = await devPage();\n   599\t      await zoomable(page, type);\n   600\t      const g = await plotGeometry(page);\n   601\t      const full = g.xDomain!;\n   602\t      const y = g.plot.y + g.plot.height / 2;\n   603\t      await page.mouse.move(g.plot.x + 0.25 * g.plot.width, y);\n   604\t      await page.mouse.down();\n   605\t      await page.mouse.move(g.plot.x + 0.5 * g.plot.width, y, { steps: 6 });\n   606\t      await page.mouse.up();\n   607\t      await settle(page);\n   608\t      const d = await xDomain(page);\n   609\t      const want = [full[0]! + 0.25 * width(full), full[0]! + 0.5 * width(full)];\n   610\t      expect(Math.abs(d[0]! - want[0]!)).toBeLessThanOrEqual(width(full) / 40);\n   611\t      expect(Math.abs(d[1]! - want[1]!)).toBeLessThanOrEqual(width(full) / 40);\n   612\t      expect(await closePage(page)).toEqual([]);\n   613\t    });\n   614\t\n   615\t    it(`I3 ${cell(type)}${type === 'bar (date)' ? ' (date axis)' : type === 'bar' ? ' (number axis)' : ''}: from the keyboard, each of +, Shift+Right, Shift+Left, - and 0 has its own effect, checked after each key`, async () => {\n   616\t      const page = await devPage();\n   617\t      await zoomable(page, type);\n   618\t      const full = await xDomain(page);\n   619\t      await page.focus('#chart .axylo-proxy');\n   620\t      await page.keyboard.press('+');\n   621\t      await settle(page);\n   622\t      const half = await xDomain(page);\n   623\t      expect(width(half)).toBeCloseTo(width(full) / 2, 0);\n   624\t      await page.keyboard.press('Shift+ArrowRight');\n   625\t      await settle(page);\n   626\t      const right = await xDomain(page);\n   627\t      expect(right[0]).toBeGreaterThan(half[0]!);\n   628\t      expect(width(right)).toBeCloseTo(width(half), 0);\n   629\t      await page.keyboard.press('Shift+ArrowLeft');\n   630\t      await settle(page);\n   631\t      expect((await xDomain(page))[0]).toBeLessThan(right[0]!);\n   632\t      await page.keyboard.press('-');\n   633\t      await settle(page);\n   634\t      expect(width(await xDomain(page))).toBeCloseTo(width(full), 0);\n   635\t      await page.keyboard.press('+');\n   636\t      await settle(page);\n   637\t      expect(width(await xDomain(page))).toBeLessThan(width(full));\n   638\t      await page.keyboard.press('0');\n   639\t      await settle(page);\n   640\t      expect(await xDomain(page)).toEqual(full);\n   641\t      expect(await closePage(page)).toEqual([]);\n   642\t    });\n   643\t\n   644\t    it(`I3 ${cell(type)}${type === 'bar (date)' ? ' (date axis)' : type === 'bar' ? ' (number axis)' : ''}: with zoom: 'touch' a two-finger pinch zooms; without it the pinch is left to the page: the chart's range is unchanged and the browser's default is not prevented`, async () => {\n   645\t      const pinch = async (page: Page) => {\n   646\t        const g = await plotGeometry(page);\n   647\t        const cx = g.plot.x + g.plot.width / 2, cy = g.plot.y + g.plot.height / 2;\n   648\t        await page.evaluate(() => {\n   649\t          const w = window as unknown as { prevented: number };\n   650\t          w.prevented = 0;\n   651\t          // Registered on the window after the chart's own listeners: sees whether they cancelled the gesture.\n   652\t          for (const t of ['touchstart', 'touchmove']) window.addEventListener(t, e => { if (e.defaultPrevented) w.prevented++; }, { passive: true });\n   653\t        });\n   654\t        const client = await page.context().newCDPSession(page);\n   655\t        const at = (d: number) => [{ x: cx - d, y: cy, id: 0 }, { x: cx + d, y: cy, id: 1 }];\n   656\t        await client.send('Input.dispatchTouchEvent', { type: 'touchStart', touchPoints: at(40) });\n","exit_code":0,"status":"completed"}}
