leBuilder = (view, caption, formatters, messages, labels) => {\n    92\t  const { frame, total } = view as DonutView;\n    93\t  const rowCount = frame.labels.length;\n    94\t  let weights: { max: number; total: number } | undefined;\n    95\t  function writePercent(value: number): string {\n    96\t    if (Number.isFinite(total)) return formatters.percent(donutRatio(value, total));\n    97\t    if (!weights) {\n    98\t      let max = 0;\n    99\t      for (let i = 0; i < rowCount; i++) if (frame.slot[i] === SLOT_VALUE) max = Math.max(max, frame.values[i]!);\n   100\t      let scaled = 0;\n   101\t      for (let i = 0; i < rowCount; i++) if (frame.slot[i] === SLOT_VALUE) scaled += frame.values[i]! / max;\n   102\t      weights = { max, total: scaled };\n   103\t    }\n   104\t    return formatters.percent(donutRatio(value / weights.max, weights.total));\n   105\t  }\n   106\t  return {\n   107\t    caption, headers: [labels.category, withUnit(frame.valueLabel, frame.unit), labels.percentage], rowCount, pageSize: PAGE_SIZE,\n   108\t    row(i) {\n   109\t      if (!Number.isInteger(i) || i < 0 || i >= rowCount) return null;\n   110\t      const state = frame.slot[i] as SlotState;\n   111\t      const value = frame.values[i]!;\n   112\t      return [frame.labels[i]!, slotText(formatters, 0, value, state), state === SLOT_VALUE && value >= 0\n   113\t        ? writePercent(value) : messages.noData];\n   114\t    },\n   115\t    pageForX(x) { return page(readPosition(x, 'category', null, frame.labels), rowCount); },\n   116\t  };\n   117\t};\n   118\t\n   119\texport const scatterTable: TableBuilder = (view, caption, formatters, messages, labels, _locale, work) => {\n   120\t  const { frame } = view as ScatterView;\n   121\t  const order = scatterRows(view as ScatterView, work);\n   122\t  let next: (() => ScatterRow | null) | null = null;\n   123\t  let nextOrdinal = -1;\n   124\t  return {\n   125\t    caption, headers: [withUnit(frame.xLabel, frame.xUnit), labels.series, withUnit(frame.yLabel, frame.yUnit)],\n   126\t    rowCount: order.count, pageSize: PAGE_SIZE,\n   127\t    row(i) {\n   128\t      if (!Number.isInteger(i) || i < 0 || i >= order.count) return null;\n   129\t      if (i !== nextOrdinal) next = order.cursor(i);\n   130\t      const at = next?.();\n   131\t      nextOrdinal = i + 1;\n   132\t      if (!at) return null;\n   133\t      const series = frame.series[at.series]!;\n   134\t      if (at.missing) return [formatters.x(series.missingX![at.index]!), series.label, messages.noData];\n   135\t      return [formatters.x(series.x[at.index]!), series.label, formatters.value(at.series, series.y[at.index]!)];\n   136\t    },\n   137\t    pageForX(x) {\n   138\t      const xPos = readPosition(x, frame.xKind, frame.timeZone);\n   139\t      return Number.isFinite(xPos) ? page(order.beforeX(xPos), order.count) : null;\n   140\t    },\n   141\t  };\n   142\t};\n   143\t\n   144\texport const alignedTable: TableBuilder = (view, caption, formatters, messages, labels) => {\n   145\t  const { frame, visibleSlots: { start, end }, stack } = view as AlignedView;\n   146\t  const rowCount = end - start;\n   147\t  return {\n   148\t    caption, headers: [withUnit(frame.xLabel, labels.xUnit ?? null), ...frame.series.map(series => withUnit(series.label, series.unit))],\n   149\t    rowCount, pageSize: PAGE_SIZE,\n   150\t    row(i) {\n   151\t      if (!Number.isInteger(i) || i < 0 || i >= rowCount) return null;\n   152\t      const at = start + i;\n   153\t      const x = formatters.x(frame.x.values[at]!);\n   154\t      return [stack?.incomplete?.[at] ? incomplete(x, messages) : x,\n   155\t        ...frame.series.map((series, s) => slotText(formatters, s, series.y[at]!, series.slot[at] as SlotState))];\n   156\t    },\n   157\t    pageForX(x) {\n   158\t      const xPos = readPosition(x, frame.x.kind, frame.x.timeZone, frame.x.categories);\n   159\t      return Number.isFinite(xPos) ? page(lowerBound(frame.x.values, xPos, start, end) - start, rowCount) : null;\n   160\t    },\n   161\t  };\n   162\t};\n","exit_code":0,"status":"completed"}}
