tion readable(d: Committed): boolean {\n   412\t    return d.view.kind === 'donut' || d.view.visible.some(Boolean);\n   413\t  }\n   414\t\n   415\t  function initialFocusFor(d: Committed): DatumRef | null {\n   416\t    if (aligned(d.view)) {\n   417\t      const x = stepAcross(d.view, null, 'first');\n   418\t      return x === null ? null : d.lookup.primary({ kind: 'x', x });\n   419\t    }\n   420\t    return d.lookup.step(null, 'first');\n   421\t  }\n   422\t\n   423\t  /** The datum to start from when the keyboard arrives: the pointer's, else the first. */\n   424\t  function initialFocus(d: Committed): DatumRef | null {\n   425\t    if (source === 'pointer' && pointerTarget) {\n   426\t      const p = d.lookup.primary(pointerTarget);\n   427\t      if (p) return p;\n   428\t    }\n   429\t    if (aligned(d.view)) {\n   430\t      const x = stepAcross(d.view, null, 'first');\n   431\t      return x === null ? null : d.lookup.primary({ kind: 'x', x });\n   432\t    }\n   433\t    return d.lookup.step(null, 'first');\n   434\t  }\n   435\t\n   436\t  /** The keyboard takes over from a pointer target (contracts: Lookup.primary). */\n   437\t  function takeover(d: Committed): void {\n   438\t    if (source !== 'pointer' || !pointerTarget) {\n   439\t      focus ??= initialFocus(d);\n   440\t      return;\n   441\t    }\n   442\t    if (mode === 'single' && focus?.kind === 'aligned' && pointerTarget.kind === 'x') {\n   443\t      focus = d.lookup.resolve({ kind: 'aligned', seriesKey: focus.seriesKey, x: pointerTarget.x }) ?? d.lookup.primary(pointerTarget);\n   444\t    } else {\n   445\t      focus = d.lookup.primary(pointerTarget) ?? focus ?? initialFocus(d);\n   446\t    }\n   447\t  }\n   448\t\n   449\t  /** What the keyboard's datum shows, as a pointer would see it there: coincident scatter points included. */\n   450\t  function keyboardTarget(d: Committed, ref: DatumRef): PickTarget {\n   451\t    if (ref.kind === 'point' && d.view.kind === 'scatter') {\n 