: string {\n      const f = values[seriesIndex];\n      return f ? f(v) : defaultReadoutNumber(v, locale);\n    },\n    x,\n    percent(ratio: number): string {\n      return shareText(ratio, locale);\n    },\n    count(n: number): string {\n      return defaultReadoutNumber(n, locale, null);\n    },\n    missing(state: SlotState): string {\n      if (state === SLOT_VALUE) return '';\n      // No row at this x for this series is \"No observation\"; every other non-value (null, invalid, gap,\n      // absent field) is \"No data\" (spec F2, I1).\n      return state === SLOT_NO_ROW ? noObservation : noData;\n    },\n  };\n      accept(c, viewed, previous.follow && zoom !== null, commitAppend);\n    });\n  }\n\n  /**\n   * The caller's rows of a displayed frame as a table, in source order and with their own source indexes, so\n   * they can be normalized again on their own (re-encoding what is on screen while paused).\n   */\n  function displayedTable(frame: Frame): Table {\n    const own = onScreen && onScreen.frame === frame && onScreen.frozen ? onScreen.frozen : freeze(frame).rows;\n    const indexes = [...own.keys()].sort((p, q) => p - q);\n    const rows = indexes.map(i => own.get(i));\n    // Positions read the rows in order; provenance and events read them by their own source index.\n    return { ...rowsTable(rows), rowIndex: i => indexes[i]!, rowAt: index => own.get(index) ?? null };\n  }\n\n  /** The caller's rows every slot of `frame` refers to, read once, so the frame stays addressable on its own. */\n  function freeze(frame: Frame): { frame: Frame; rows: Map<number, unknown> } {\n    const rows = new Map<number, unknown>();\n    const keep = (row: number) => { if (row >= 0 && !rows.has(row)) rows.set(row, frame.source.rowAt(row)); };\n    const each = (index: Int32Array | null, length: number) => {\n      for (let i = 0; i < length; i++) keep(index ? index[i]! : i);\n    };\n    if (frame.shape === 'aligned') for (const s of frame.series) each(s.row, frame.length);\n    else if (frame.shape === 'points') for (const s of frame.series) each(s.row, s.x.length);\n    else each(frame.row, frame.labels.length);\n    return { frame, rows };\n  }\n\n  /** The window moved to end at the new latest x, keeping its width; null when it cannot follow. */\n  function followLatest(frame: Frame, before: View): Span<XValue> | null {\n    if (before.kind === 'donut' || frame.shape === 'donut') return null;\n    if (frame.shape === 'aligned' && frame.x.kind === 'category') return null;\n    const span = before.xDomain[1] - before.xDomain[0];\n    const latest = latestX(frame);\n    if (!Number.isFinite(latest) || !Number.isFinite(span)) return null;\n    return [positionValue(frame, latest - span), positionValue(frame, latest)];\n  }\n\n  /** Candidate for a call that changes only the view (zoom, legend, resume): same options, same data. */\n1041:      return shownKeys.length > 0 && keys.every(k => english(k)) ? 'en' : null;\n1110:        messageLang: message !== null && shown.kind !== 'ready' && shown.message ? english(shown.message) : null,\n1116:        summaryLang: message !== null && shown.kind !== 'ready' && shown.kind !== 'empty'\n1117:          ? (shown.message && english(shown.message) ? 'en' : null)\n1118:          : english('chartSummary') && english('seriesSummary') ? 'en' : null,\n1324:        shown.kind !== 'ready' && shown.message ? english(shown.message) : null);\n71:/** Counts animation frames in the page and records, per pointer move, the frame of the move and of the next change to the tooltip or readout. */\n80:    for (const sel of ['#chart .axylo-tooltip', '#chart .axylo-readout']) {\n110: * Both sides of the readout-mode limit along `axis`. Entering readout mode reserves the strip, so the plot\n113: * whose plot is under it (readout mode), each with the plot size measured there.\n115:async function plotSides(page: Page, axis: 'width' | 'height', limit: number): Promise<{ floating: { container: number; plot: number };