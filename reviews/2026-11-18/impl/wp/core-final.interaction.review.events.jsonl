ighlight on Canvas). */\n   248\t    forced-color-adjust: none;\n   249\t  }\n   250\t  .axylo .axylo-proxy:focus-visible + .axylo-focus-ring { display: block; }\n   251\t  /* The donut slice the keyboard is on, also when it has no arc. */\n   252\t  .axylo .axylo-legend-list > li.axylo-legend-current { outline: 2px solid var(--axylo-focus, var(--axylo-default-focus)); outline-offset: 1px; }\n   253\t  .axylo .axylo-selection {\n   254\t    position: absolute; z-index: 1; box-sizing: border-box; pointer-events: none;\n   255\t    border: 1px solid var(--axylo-focus, var(--axylo-default-focus));\n   256\t    background: color-mix(in srgb, var(--axylo-focus, var(--axylo-default-focus)) 16%, transparent);\n   257\t  }\n   258\t\n   259\t  /* Legend, toolbar and table, under the plot. */\n   260\t  .axylo .axylo-controls { flex: none; display: flex; flex-direction: column; gap: 0.5em; margin: 0.5em 0 0; min-width: 0; }\n   261\t  /* legend: 'top' puts the legend and its toolbar above the plot; 'right' beside it, entries stacked. */\n   262\t  .axylo .axylo-controls-top, .axylo .axylo-controls-side { flex: none; display: flex; flex-direction: column; gap: 0.5em; min-width: 0; }\n   263\t  .axylo .axylo-controls-top { margin: 0 0 0.5em; }\n   264\t  .axylo .axylo-controls-side { margin: 0 0 0 0.75em; max-width: 40%; overflow: auto; }\n   265\t  .axylo .axylo-controls-side .axylo-toolbar { flex-direction: column; align-items: stretch; flex-wrap: nowrap; }\n   266\t  .axylo .axylo-controls-side .axylo-legend-list { flex-direction: column; flex-wrap: nowrap; }\n   267\t  .axylo .axylo-controls-side .axylo-legend-entry + .axylo-control:not(.axylo-legend-entry) { margin-inline-start: 0; margin-block-start: 0.5em; }\n   268\t  .axylo .axylo-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 6px; min-width: 0; }\n   269\t  .axylo .axylo-control {\n   270\t    display: inline-flex; align-items: center; gap: 0.375em; box-sizing: border-box; min-width: 24px; min-height: 24px;\n   271\t    margin: 0; padding: 2px 8px; border: 1px solid var(--axylo-axis, var(--axylo-default-axis)); border-radius: 4px;\n   272\t    background: var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background))); color: var(--axylo-text, currentColor);\n   273\t    font: inherit; font-size: max(12px, 0.875em); line-height: 1.25; text-align: start; cursor: pointer;\n   274\t  }\n   275\t  /* Legend entries first; the other controls start on the right. */\n   276\t  .axylo .axylo-legend-entry + .axylo-control:not(.axylo-legend-entry) { margin-inline-start: auto; }\n   277\t  .axylo .axylo-control:focus-visible { outline: 2px solid var(--axylo-focus, var(--axylo-default-focus)); outline-offset: 1px; }\n   278\t  .axylo .axylo-control[aria-disabled=\"true\"] { cursor: default; border-style: dashed; }\n   279\t  /* Legend toggles read as legend entries; a hidden series keeps full-contrast text, struck through (spec L2). */\n   280\t  .axylo .axylo-legend-entry { border-color: transparent; padding-inline: 4px; }\n   281\t  .axylo .axylo-legend-entry:hover { border-color: var(--axylo-axis, var(--axylo-default-axis)); }\n   282\t  .axylo .axylo-legend-entry.axylo-struck .axylo-control-label { text-decoration: line-through; text-decoration-thickness: 1px; }\n   283\t  .axylo .axylo-legend-list {\n   284\t    display: flex; flex-wrap: wrap; gap: 4px 16px; margin: 0; padding: 0; list-style: none; font-size: max(12px, 0.875em);\n   285\t  }\n   286\t  .axylo .axylo-legend-list > li { display: inline-flex; align-items: center; gap: 0.375em; min-width: 0; }\n   287\t  .axylo .axylo-legend-value { font-variant-numeric: tabular-nums; }\n   288\t  .axylo .axylo-table { display: flex; flex-direction: column; gap: 0.5em; min-width: 0; }\n   289\t  /* The open table takes the plot's place at the plot's size, so nothing else moves (spec A4; review 2, finding 15). */\n   290\t  .axylo .axylo-stage > .axylo-table {\n   291\t    position: absolute; inset: 0; z-index: 4; box-sizing: border-box;\n   292\t    background: var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background)));\n   293\t  }\n   294\t  .axylo .axylo-stage > .axylo-table > .axylo-table-scroll { flex: 1 1 auto; }\n   295\t  .axylo .axylo-table-scroll { overflow: auto; box-sizing: border-box; min-height: 0; border: 1px solid var(--axylo-grid, var(--axylo-default-grid)); }\n   296\t  .axylo .axylo-table-scroll:focus-visible { outline: 2px solid var(--axylo-focus, var(--axylo-default-focus)); outline-offset: 1px; }\n   297\t  .axylo .axylo-table table { border-collapse: collapse; width: max-content; min-width: 100%; font-size: max(12px, 0.875em); font-variant-numeric: tabular-nums; }\n   298\t  .axylo .axylo-table caption { padding: 4px 8px; text-align: start; font-weight: 600; caption-side: top; }\n   299\t  .axylo .axylo-table th, .axylo .axylo-table td {\n   300\t    padding: 2px 8px; border-bottom: 1px solid var(--axylo-grid, var(--axylo-default-grid)); text-align: end; white-space: nowrap;\n   301\t  }\n   302\t  .axylo .axylo-table th[scope=\"row\"], .axylo .axylo-table thead th:first-child { text-align: start; }\n   303\t  .axylo .axylo-table thead th { position: sticky; top: 0; background: var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background))); }\n   304\t  .axylo .axylo-pager { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 8px; font-size: max(12px, 0.875em); }\n   305\t  .axylo .axylo-jump { display: inline-flex; align-items: center; gap: 0.375em; margin: 0; }\n   306\t  .axylo .axylo-jump-field {\n   307\t    box-sizing: border-box; min-height: 24px; width: 12em; padding: 2px 4px; font: inherit;\n   308\t    border: 1px solid var(--axylo-axis, var(--axylo-default-axis)); border-radius: 2px;\n   309\t    background: var(--axylo-background, var(--axylo-backdrop, var(--axylo-default-background))); color: var(--axylo-text, currentColor);\n   310\t  }\n   311\t  .axylo .axylo-jump { flex-wrap: wrap; }\n   312\t  .axylo .axylo-jump-error { flex-basis: 100%; margin: 0; font-size: max(12px, 0.875em); }\n   313\t  .axylo .axylo-jump-field:focus-visible { outline: 2px solid var(--axylo-focus, var(--axylo-default-focus)); outline-offset: 1px; }\n   314\t}\n   315\t`;\n","exit_code":0,"status":"completed"}}
