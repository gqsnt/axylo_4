{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/src/dom/interaction.ts | sed -n '1,505p'\"","aggregated_output":"     1\t/**\n     2\t * Everything a reader uses to explore a full chart (decision 0001; spec I1–I6, A2–A4, A7): one piece of\n     3\t * state, \"what the reader is on\", driven by pointer, touch and keyboard alike, and what is derived from it:\n     4\t * the tooltip, the overlay (drawn with `renderer.drawOverlay`, never by redrawing the scene), the keyboard\n     5\t * proxy's range and value text and the `hover` event. Plus the toolbar (legend, zoom, pause, table), the\n     6\t * table view and the zoom gestures.\n     7\t *\n     8\t * The controller calls `commit` after every frame it draws, with the state that frame shows; this module\n     9\t * never reads a newer state than the marks show. It changes the chart only through `actions`, which go\n    10\t * through the public paths (zoom, the view's hidden set, pause), so every change follows the commit contract.\n    11\t *\n    12\t * The proxy's range always matches the frame on screen: its bounds, value and text are compared with what\n    13\t * the lookup says now and rewritten where they differ (review 2, finding 4). A datum keeps its identity across\n    14\t * commits: on a sliding category axis a reference is moved to the same category's new place, and a datum\n    15\t * that left the window resolves by the lookup's rule (finding 2). No live region is touched by a commit.\n    16\t *\n    17\t * Every listener on the chart's own elements is registered with one abort signal per build, so clearing the\n    18\t * layer or destroying the chart removes them all.\n    19\t */\n    20\timport type {\n    21\t  DatumRef, DatumText, Formatters, Layout, Lookup, MarkRenderer, Overlay, PaintBindings, PickTarget, ReaderModel,\n    22\t  Rect, ResolvedTheme, StepDirection, View, XValue,\n    23\t} from '../core/contracts';\n    24\timport type { Messages } from '../public';\n    25\timport { fill } from '../messages';\n    26\timport {\n    27\t  overlayWith, OUTLINE_REACH, RING_REACH, canZoomIn, minimumWidth, panWindow, positionAt, positionText, refsAt, sameRef, stepAcross, zoomStep,\n    28\t  targetBox, targetOf, valueText, PAN_SHARE, ZOOM_FACTOR, type Mode, type TargetMarks,\n    29\t} from '../core/focus';\n    30\timport type { Figure } from './figure';\n    31\timport { sameTarget } from './pointer';\n    32\timport { createTableView, type TableView } from './table';\n    33\timport { createToolbar, type Toolbar, type ToolbarItem } from './toolbar';\n    34\timport { createTooltip, cssScale, type Placement, type TooltipContent } from './tooltip';\n    35\timport { createSwatch, swatchPattern, type SwatchPattern, type SwatchSpec } from './swatch';\n    36\timport { sliceText } from '../lookup/text';\n    37\timport { setAttr } from './attributes';\n    38\t\n    39\ttype Span = readonly [number, number];\n    40\t\n    41\t/**\n    42\t * What the controls under the plot need. Known before layout, so they are in place when the plot is\n    43\t * measured and their arrival never makes the plot relayout.\n    44\t */\n    45\texport interface ControlsState {\n    46\t  readonly kind: 'line' | 'area' | 'bar' | 'scatter' | 'donut';\n    47\t  readonly view: View;\n    48\t  readonly formatters: Formatters;\n    49\t  readonly messages: Messages;\n    50\t  readonly reader: ReaderModel;\n    51\t  /** The last layout was too small for a plot (spec L8): only the table control is offered. */\n    52\t  readonly tooSmall: boolean;\n    53\t  /** The chart shows data (not loading, empty or error). */\n    54\t  readonly ready: boolean;\n    55\t  /**\n    56\t   * The data can be inspected although nothing is drawn (an empty window, an all-zero donut): the table and\n    57\t   * the donut's slice list stay (spec F8, A4, L7).\n    58\t   */\n    59\t  readonly inspectable?: boolean;\n    60\t  /** The chart shows its empty state (not loading or error): a zoomed window with nothing in it can recover. */\n    61\t  readonly empty?: boolean;\n    62\t  /** The state's message while not ready (\"Loading chart.\"), which the plot reads instead of data. */\n    63\t  readonly message?: string | null;\n    64\t  /** A full chart; false for the compact variant, which is a static image (spec C1). */\n    65\t  readonly interactive: boolean;\n    66\t  readonly tooltip: boolean;\n    67\t  /** Where the legend part of the toolbar goes (plan 1.4, `legend`), or false for none. */\n    68\t  readonly legend: false | 'top' | 'right' | 'bottom';\n    69\t  /** Zoom applies to this chart (spec 3.6) and is not switched off; 'touch' also captures pinch. */\n    70\t  readonly zoom: false | true | 'touch';\n    71\t  readonly zoomed: boolean;\n    72\t  /** `append` has been called at least once (spec I6). */\n    73\t  readonly streaming: boolean;\n    74\t  readonly paused: boolean;\n    75\t  readonly epoch: number;\n    76\t  /** `lang` for an element that shows the built-in text of `key`: 'en' on a page in another language. */\n    77\t  english(key: keyof Messages): string | null;\n    78\t  /** The page's own language, for author text inside an element marked 'en'. */\n    79\t  readonly pageLang: string | null;\n    80\t  /**\n    81\t   * Readout mode (decision 0004 revision 2, rule 5), decided by layout: the plot is narrower than 240 or\n    82\t   * shorter than 140 CSS px. A strip of two lines is reserved under the plot and there is no floating tooltip.\n    83\t   */\n    84\t  readonly readout?: boolean;\n    85\t}\n    86\t\n    87\t/** What one drawn frame shows, as the interaction layer needs it. */\n    88\texport interface Committed extends ControlsState {\n    89\t  readonly layout: Layout;\n    90\t  readonly lookup: Lookup;\n    91\t  readonly bindings: PaintBindings;\n    92\t  readonly theme: ResolvedTheme;\n    93\t  readonly pixelRatio: number;\n    94\t}\n    95\t\n    96\texport interface Actions {\n    97\t  /** A window in x positions, or null for everything. Goes through the public `zoom` path. */\n    98\t  zoom(window: Span | null): void;\n    99\t  toggle(seriesKey: string): void;\n   100\t  pause(paused: boolean): void;\n   101\t  select(ref: DatumRef): void;\n   102\t  hover(ref: DatumRef | null): void;\n   103\t}\n   104\t\n   105\texport interface Interaction {\n   106\t  /**\n   107\t   * Before the plot is measured: the legend, toolbar and table for the state about to be drawn. Returns\n   108\t   * true when that changed what sits under the plot, so the plot's size must be read again.\n   109\t   */\n   110\t  prepare(state: ControlsState): boolean;\n   111\t  commit(state: Committed | null): void;\n   112\t  /** Internal failure or destroy: everything goes, nothing is left focusable. */\n   113\t  clear(): void;\n   114\t  /**\n   115\t   * The chart is in the document: listeners on the document itself (Escape, a tap outside a pinned\n   116\t   * tooltip, scrolling) may be held. `detach` lets go of them while the chart is out of the document.\n   117\t   */\n   118\t  attach(): void;\n   119\t  detach(): void;\n   120\t  destroy(): void;\n   121\t}\n   122\t\n   123\t/** Bar series past the eighth carry a pattern (spec F9); the same rule as the scene's bars. */\n   124\tconst PATTERNS = ['diagonal', 'cross', 'dots'] as const;\n   125\texport function seriesPattern(index: number): SwatchPattern['kind'] | null {\n   126\t  const group = Math.floor(index / 8);\n   127\t  return group ? PATTERNS[(group - 1) % PATTERNS.length]! : null;\n   128\t}\n   129\t\n   130\t/** How a series is drawn, repeated in its legend and tooltip swatch (spec A5). */\n   131\texport function seriesSwatch(kind: ControlsState['kind'], index: number, cue: SwatchSpec['cue'], hollow: boolean): SwatchSpec {\n   132\t  if (kind === 'bar') return barSwatch(index, cue, hollow);\n   133\t  if (kind === 'area') return areaSwatch(index, cue, hollow);\n   134\t  return kind === 'line' ? lineSwatch(index, cue, hollow) : pointSwatch(index, cue, hollow);\n   135\t}\n   136\t\n   137\t/** One chart kind's series swatch (seriesSwatch with the kind fixed). */\n   138\texport type SeriesSwatch = (index: number, cue: SwatchSpec['cue'], hollow: boolean) => SwatchSpec;\n   139\texport const barSwatch: SeriesSwatch = (index, cue, hollow) => {\n   140\t  const pattern = seriesPattern(index);\n   141\t  return { color: index, cue, line: false, hollow, fill: true, pattern: pattern && swatchPattern(pattern) };\n   142\t};\n   143\texport const areaSwatch: SeriesSwatch = (index, cue, hollow) => ({ color: index, cue, line: false, hollow, fill: true, marker: true, pattern: null });\n   144\texport const lineSwatch: SeriesSwatch = (index, cue, hollow) => ({ color: index, cue, line: true, hollow });\n   145\t/** Scatter, and the donut, whose series swatches are never asked for (its rows are slices). */\n   146\texport const pointSwatch: SeriesSwatch = (index, cue, hollow) => ({ color: index, cue, line: false, hollow });\n   147\t\n   148\t/** The donut's slice list beside the plot: the list to show (the one given, updated) or null for none. */\n   149\texport type SliceList = (doc: Document, d: ControlsState, actions: Actions, list: HTMLUListElement | null) => HTMLUListElement | null;\n   150\t\n   151\t/** What differs between chart kinds in the interaction layer; a kind's composition holds only its own. */\n   152\texport interface InteractionParts {\n   153\t  readonly overlay: TargetMarks;\n   154\t  readonly swatch: SeriesSwatch;\n   155\t  /** Single mode's Right and Left within one series (scatter); null where single mode steps through the lookup. */\n   156\t  readonly stepInSeries: ((view: Extract<View, { kind: 'scatter' }>, ref: DatumRef, direction: StepDirection) => DatumRef | null) | null;\n   157\t  readonly sliceList: SliceList | null;\n   158\t}\n   159\t\n   160\texport const donutSliceList: SliceList = (doc, d, actions, list) => {\n   161\t  const view = d.view;\n   162\t  // The slice list is part of the full chart; the too-small state shows only title, summary and table (L8).\n   163\t  if (view.kind !== 'donut' || !d.legend || d.tooSmall || !(d.ready || d.inspectable || (view.slices.length > 0 && view.total === 0))) {\n   164\t    return null;\n   165\t  }\n   166\t  list ??= doc.createElement('ul');\n   167\t  list.className = 'axylo-legend-list';\n   168\t  const entries = view.slices.map(slice => {\n   169\t    const datum = sliceText(view, slice, d.formatters);\n   170\t    const li = doc.createElement('li');\n   171\t    li.dataset.key = slice.key;\n   172\t    const swatch = createSwatch(doc, { color: slice.colorIndex, cue: null, line: false, hollow: slice.angles === null });\n   173\t    const name = doc.createElement('span');\n   174\t    name.className = 'axylo-legend-name';\n   175\t    name.textContent = slice.label;\n   176\t    const value = doc.createElement('span');\n   177\t    value.className = 'axylo-legend-value';\n   178\t    const percent = datum?.percent;\n   179\t    value.textContent = datum ? (percent && percent !== datum.value ? `${datum.value} (${percent})` : datum.value) : '';\n   180\t    // Every slice, a zero or null one included, can be chosen by pointer as by keyboard: a button named by\n   181\t    // the entry's text, 24 px tall, outside the tab order (new item 9).\n   182\t    const choose = doc.createElement('button');\n   183\t    choose.type = 'button';\n   184\t    choose.tabIndex = -1;\n   185\t    choose.className = 'axylo-legend-choice';\n   186\t    choose.append(swatch, name, value);\n   187\t    choose.addEventListener('mousedown', event => event.preventDefault());\n   188\t    choose.addEventListener('click', () => actions.select({ kind: 'slice', sliceKey: slice.key }));\n   189\t    li.append(choose);\n   190\t    return li;\n   191\t  });\n   192\t  const signature = entries.map(e => e.textContent).join('\\u0000') + view.slices.map(s => s.colorIndex).join();\n   193\t  if (list.dataset.signature !== signature) {\n   194\t    list.replaceChildren(...entries);\n   195\t    list.dataset.signature = signature;\n   196\t  }\n   197\t  return list;\n   198\t};\n   199\t\n   200\tconst NAVIGATION: Readonly<Record<string, StepDirection>> = {\n   201\t  ArrowRight: 'next', ArrowLeft: 'previous', Home: 'first', End: 'last', PageUp: 'page-next', PageDown: 'page-previous',\n   202\t};\n   203\tconst DRAG_THRESHOLD = 4;\n   204\t/** Decision 0004 rule 3b: a pointer that stays within 2 CSS px for 250 ms has come to rest on its datum. */\n   205\tconst REST_DISTANCE = 2;\n   206\tconst REST_TIME = 250;\n   207\tconst TAP_DISTANCE = 10;\n   208\tconst TAP_TIME = 500;\n   209\t\n   210\tfunction sameWindow(a: Span | null, b: Span | null): boolean {\n   211\t  return a === b || (a !== null && b !== null && a[0] === b[0] && a[1] === b[1]);\n   212\t}\n   213\t\n   214\tfunction categoriesOf(view: View): readonly string[] | null {\n   215\t  return view.kind !== 'donut' && view.kind !== 'scatter' && view.frame.x.kind === 'category' ? view.frame.x.categories : null;\n   216\t}\n   217\t\n   218\texport function createInteraction(parts: InteractionParts, figure: Figure, renderer: MarkRenderer, actions: Actions): Interaction {\n   219\t  const doc = figure.figure.ownerDocument;\n   220\t  const plot = figure.plot;\n   221\t  const tooltip = createTooltip(figure.tooltip, figure.readout, figure.figure);\n   222\t\n   223\t  let c: Committed | null = null;\n   224\t  /** The newest controls state (prepared or committed), for the toolbar's actions. */\n   225\t  let cs: ControlsState | null = null;\n   226\t  let focus: DatumRef | null = null;\n   227\t  let mode: Mode = 'all';\n   228\t  /** Which input last chose what is shown. */\n   229\t  let source: 'pointer' | 'keyboard' | null = null;\n   230\t  let pointer: { x: number; y: number } | null = null;\n   231\t  let pointerTarget: PickTarget | null = null;\n   232\t  let pinned = false;\n   233\t  /** Escape closed the tooltip for this target; it stays closed until the target changes. */\n   234\t  let dismissed: PickTarget | null = null;\n   235\t  let proxyFocused = false;\n   236\t  let clickFocus = false;\n   237\t  /** The proxy got focus from a click and no key has been pressed since: the pointer still leads. */\n   238\t  let fromClick = false;\n   239\t  let shownOrdinal = 0;\n   240\t  /** What the value text was last written about (decision 0004, part 2). */\n   241\t  let shownText: { ref: DatumRef | null; mode: Mode; reading: string | null } | null = null;\n   242\t  /** The pointer's datum and the rectangle its floating tooltip took (decision 0004 r2, rule 3). */\n   243\t  let heldTip: { target: PickTarget; rect: Rect; across: boolean } | null = null;\n   244\t  /** Rule 3b: where the pointer last came to rest (plot pixels) and since when (event time, ms). */\n   245\t  let rest: { at: { x: number; y: number }; time: number } | null = null;\n   246\t  /** Rule 3b: the datum held along the corridor from its resting position (viewport) to its tooltip. */\n   247\t  let corridor: { from: { x: number; y: number }; rect: Rect; target: PickTarget } | null = null;\n   248\t  let lastHover: DatumRef | null = null;\n   249\t  let presented = '';\n   250\t  let dirty = true;\n   251\t  /** A zoom requested but not committed yet, so quick repeats (wheel, key repeat) build on each other. */\n   252\t  let pendingWindow: Span | null | undefined;\n   253\t  let tableView: TableView | null = null;\n   254\t  let tableModel: unknown = null;\n   255\t  /** The one pointer that owns a press or drag (review 2, finding 10); others are ignored until it ends. */\n   256\t  let down: { id: number; x: number; y: number; dragging: boolean } | null = null;\n   257\t  const touches = new Map<number, { x: number; y: number; x0: number; y0: number; t0: number }>();\n   258\t  /** The two fingers a pinch st