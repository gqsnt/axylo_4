{"type":"item.completed","item":{"id":"item_34","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/src/core/focus.ts | sed -n '345,430p' && cat packages/axylo/src/messages/point.ts 2>/dev/null && rg -n 'incomplete|count\\\\(' packages/axylo/src/format packages/axylo/src/messages\"","aggregated_output":"   345\t\n   346\t/**\n   347\t * One zoom step (button, key, wheel) from `current`: the scaled window when it goes the way asked, a zoom-in\n   348\t * strictly narrower and a zoom-out strictly wider (or the whole range, null); undefined when it would not.\n   349\t * A window below the minimum (a public zoom() can set one) is not widened by zooming in (interaction review,\n   350\t * new item 7).\n   351\t */\n   352\texport function zoomStep(full: Span, current: Span, factor: number, center: number, minWidth: number): Span | null | undefined {\n   353\t  const width = current[1] - current[0];\n   354\t  const next = scaleWindow(full, current, factor, center, minWidth);\n   355\t  if (factor < 1) return next !== null && next[1] - next[0] < width ? next : undefined;\n   356\t  if (factor > 1) {\n   357\t    const whole = current[0] <= full[0] && current[1] >= full[1];\n   358\t    if (next === null) return whole ? undefined : null;\n   359\t    return next[1] - next[0] > width ? next : undefined;\n   360\t  }\n   361\t  return undefined;\n   362\t}\n   363\t\n   364\t/** Whether one Zoom in step from `window` would show a narrower window (else the control is not offered as working). */\n   365\texport function canZoomIn(view: View, window: Span): boolean {\n   366\t  if (view.kind === 'donut') return false;\n   367\t  return zoomStep(view.xFull, window, 1 / ZOOM_FACTOR, (window[0] + window[1]) / 2, minimumWidth(view)) !== undefined;\n   368\t}\n   369\t\n   370\t/** The window moved by `share` of its width (negative: towards the start); null when it would not move. */\n   371\texport function panWindow(full: Span, current: Span, share: number): Span | null {\n   372\t  const width = current[1] - current[0];\n   373\t  const moved = inside(full, current[0] + share * width, width);\n   374\t  return moved[0] === current[0] ? null : moved;\n   375\t}\n   376\t\n   377\t/**\n   378\t * Smallest window: about two x slots for aligned charts, a ten-thousandth of the range otherwise, but never\n   379\t * more than half the range, so one halving is always attainable (interaction review, part 1 item 9).\n   380\t */\n   381\texport function minimumWidth(view: View): number {\n   382\t  if (view.kind === 'donut') return 0;\n   383\t  const full = view.xFull[1] - view.xFull[0];\n   384\t  // Never below what doubles can tell apart at these positions: one unit in the last place keeps two ends.\n   385\t  const largest = Math.max(Math.abs(view.xFull[0]), Math.abs(view.xFull[1]), Number.MIN_VALUE);\n   386\t  const representable = 2 ** (Math.floor(Math.log2(largest)) - 52);\n   387\t  const wanted = view.kind === 'scatter' ? full / 1e4\n   388\t    : view.frame.x.values.length > 1 ? 2 * full / (view.frame.x.values.length - 1) : full;\n   389\t  return Math.max(Math.min(wanted, full / 2), representable);\n   390\t}\n   391\t\n   392\t/** Whether zoom applies to this chart (spec 3.6): not donut, not a category axis, not compact, not switched off. */\n   393\texport function zoomApplies(view: View, option: unknown): boolean {\n   394\t  if (option === false || view.kind === 'donut' || view.compact) return false;\n   395\t  if (view.kind === 'scatter') return true;\n   396\t  return view.frame.x.kind !== 'category';\n   397\t}\n   398\t\n   399\t/**\n   400\t * Narrowed mode on scatter (review 2, finding 7): the next or previous point of the same series in x order\n   401\t * among its visible points; null at an end.\n   402\t */\n   403\texport function stepInSeries(view: ScatterView, ref: DatumRef, direction: StepDirection): DatumRef | null {\n   404\t  if (ref.kind !== 'point') return null;\n   405\t  const s = view.frame.series.findIndex(series => series.key === ref.seriesKey);\n   406\t  const series = view.frame.series[s];\n   407\t  const range = view.visiblePoints[s];\n   408\t  if (!series || !range || range.end <= range.start) return null;\n   409\t  const rows = series.row;\n   410\t  let at = -1;\n   411\t  for (let i = range.start; i < range.end; i++) if ((rows ? rows[i]! : i) === ref.row) { at = i; break; }\n   412\t  if (at < 0) return null;\n   413\t  const page = pageDistance(range.end - range.start);\n   414\t  const to = direction === 'next' ? at + 1 : direction === 'previous' ? at - 1 : direction === 'first' ? range.start\n   415\t    : direction === 'last' ? range.end - 1 : direction === 'page-next' ? Math.min(range.end - 1, at + page)\n   416\t      : direction === 'page-previous' ? Math.max(range.start, at - page) : -1;\n   417\t  if (to < range.start || to >= range.end || to === at) return null;\n   418\t  return { kind: 'point', seriesKey: series.key, row: rows ? rows[to]! : to, x: series.x[to]! };\n   419\t}\n   420\t\n   421\t/** The x position under a plot pixel, from the layout's projection; null on a band (category) axis. */\n   422\texport function positionAt(layout: Layout, px: number, py: number): number | null {\n   423\t  if (layout.kind !== 'plot') return null;\n   424\t  const p = layout.projection;\n   425\t  if (p.kind === 'xy') return p.x.type === 'band' ? null : p.x.invert(px);\n   426\t  if (p.kind === 'bands') return p.band.type === 'band' ? null : p.band.invert(p.horizontal ? py : px);\n   427\t  return null;\n   428\t}\n   429\t\n   430\texport type { PlotLayout };\n","exit_code":1,"status":"failed"}}
