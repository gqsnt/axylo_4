{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/core/focus.ts'","aggregated_output":"     1\t/**\n     2\t * The pure part of the interaction layer: what the reader is on, how it moves, how it reads, and what is\n     3\t * drawn over the marks for it. Everything here reads the frame through the view and the lookup (never the\n     4\t * scene), and touches no DOM, so it is tested in Node.\n     5\t *\n     6\t * Decision 0001: the plot is one range input. Its value is the place of the current x among the visible x\n     7\t * slots. By default it reads every visible series at that x (\"all\" mode); after Up or Down it reads one series\n     8\t * (\"single\" mode) and moves with `lookup.step`, which skips that series' missing values as the contract says.\n     9\t */\n    10\timport {\n    11\t  type AlignedView, type DatumRef, type Formatters, type Layout, type Lookup, type Mark, type Overlay,\n    12\t  type PickTarget, type Rect, type RuleMark, type ScatterView, type StepDirection, type View,\n    13\t} from './contracts';\n    14\timport { donutGeometry } from '../view/donut-geometry';\n    15\timport type { Messages } from '../public';\n    16\timport { fill, pointOf } from '../messages';\n    17\timport { lowerBound } from '../lookup/search';\n    18\t\n    19\texport type Mode = 'all' | 'single';\n    20\ttype Span = readonly [number, number];\n    21\ttype PlotLayout = Extract<Layout, { kind: 'plot' }>;\n    22\t\n    23\t/** The pointer target that shows the same thing as a focused datum. */\n    24\texport function targetOf(ref: DatumRef): PickTarget {\n    25\t  switch (ref.kind) {\n    26\t    case 'aligned': return { kind: 'x', x: ref.x };\n    27\t    case 'point': return { kind: 'point', refs: [ref], count: 1 };\n    28\t    case 'slice': return { kind: 'slice', sliceKey: ref.sliceKey };\n    29\t  }\n    30\t}\n    31\t\n    32\texport function sameRef(a: DatumRef | null, b: DatumRef | null): boolean {\n    33\t  if (a === null || b === null) return a === b;\n    34\t  if (a.kind === 'aligned' && b.kind === 'aligned') return a.seriesKey === b.seriesKey && a.x === b.x;\n    35\t  if (a.kind === 'point' && b.kind === 'point') return a.seriesKey === b.seriesKey && a.row === b.row && a.x === b.x;\n    36\t  if (a.kind === 'slice' && b.kind === 'slice') return a.sliceKey === b.sliceKey;\n    37\t  return false;\n    38\t}\n    39\t\n    40\t/** Matches lookup's page size (spec A2 \"Page keys\"): a tenth of the visible positions, at least one. */\n    41\texport function pageDistance(count: number): number {\n    42\t  return Math.max(1, Math.floor(count / 10));\n    43\t}\n    44\t\n    45\t/** Series a reader can land on: visible and drawable. */\n    46\texport function readableSeries(view: AlignedView): number[] {\n    47\t  return view.frame.series.flatMap((s, i) => view.visible[i] && s.drawable ? [i] : []);\n    48\t}\n    49\t\n    50\t/**\n    51\t * In \"all\" mode the reader moves over x slots, every visible slot a place of its own, as the lookup counts\n    52\t * them (\"point 2 of 3\") and as the pointer reaches them: a slot where a series has no data reads \"No data\"\n    53\t * (spec F2), one only a hidden series observes reads \"No observation\" (review 2, finding 7).\n    54\t */\n    55\tfunction occupied(_view: AlignedView, _series: readonly number[], _i: number): boolean {\n    56\t  return true;\n    57\t}\n    58\t\n    59\t/** The x position \"all\" mode moves to, or null when there is nowhere to go in that direction. */\n    60\texport function stepAcross(view: AlignedView, x: number | null, direction: StepDirection): number | null {\n    61\t  const { start, end } = view.visibleSlots;\n    62\t  const positions = view.frame.x.values;\n    63\t  const series = readableSeries(view);\n    64\t  if (start >= end || series.length === 0) return null;\n    65\t  const seek = (from: number, delta: 1 | -1, lo = start, hi = end): number => {\n    66\t    for (let i = from; i >= lo && i < hi; i += delta) if (occupied(view, series, i)) return i;\n    67\t    return -1;\n    68\t  };\n    69\t  let at = x === null ? -1 : lowerBound(positions, x, start, end);\n    70\t  if (at >= 0 && (at >= end || positions[at] !== x)) at = -1;\n    71\t  let to = -1;\n    72\t  if (at < 0) {\n    73\t    to = direction === 'last' ? seek(end - 1, -1) : seek(start, 1);\n    74\t  } else {\n    75\t    const page = pageDistance(end - start);\n    76\t    switch (direction) {\n    77\t      case 'next': to = seek(at + 1, 1); break;\n    78\t      case 'previous': to = seek(at - 1, -1); break;\n    79\t      case 'first': to = seek(start, 1); break;\n    80\t      case 'last': to = seek(end - 1, -1); break;\n    81\t      case 'page-next': {\n    82\t        const target = Math.min(end - 1, at + page);\n    83\t        to = seek(target, 1);\n    84\t        if (to < 0) to = seek(target - 1, -1, at + 1);\n    85\t        break;\n    86\t      }\n    87\t      case 'page-previous': {\n    88\t        const target = Math.max(start, at - page);\n    89\t        to = seek(target, -1);\n    90\t        if (to < 0) to = seek(target + 1, 1, start, at);\n    91\t        break;\n    92\t      }\n    93\t      default: return null;\n    94\t    }\n    95\t    if (to === at) return null;\n    96\t  }\n    97\t  return to < 0 ? null : positions[to]!;\n    98\t}\n    99\t\n   100\t/** The refs of every readable series at x, in series order. */\n   101\texport function refsAt(view: AlignedView, x: number): DatumRef[] {\n   102\t  return readableSeries(view).map(s => ({ kind: 'aligned', seriesKey: view.frame.series[s]!.key, x }) as const);\n   103\t}\n   104\t\n   105\t/** The place of a datum among the visible ones, as the `position` message says it (\"Point 4 of 10\"). */\n   106\texport function positionText(messages: Messages, formatters: Formatters, ordinal: number, count: number): string {\n   107\t  return fill(messages.position, { index: formatters.count(ordinal + 1), count: formatters.count(count) });\n   108\t}\n   109\t\n   110\t/**\n   111\t * Value text of the proxy (decision 0001): what the reader is on, ending with its place. \"All\" mode reads\n   112\t * every series at the x with `pointAll` and `seriesValue`; one series (single mode, scatter) uses `pointOf`.\n   113\t */\n   114\texport function valueText(\n   115\t  view: View, lookup: Lookup, focus: DatumRef, mode: Mode, formatters: Formatters, messages: Messages,\n   116\t): string | null {\n   117\t  const ordinal = lookup.ordinal(focus);\n   118\t  if (ordinal < 0) return null;\n   119\t  const position = positionText(messages, formatters, ordinal, lookup.count);\n   120\t  if (view.kind === 'donut') {\n   121\t    const datum = lookup.datum(focus);\n   122\t    if (!datum) return null;\n   123\t    const share = datum.percent === null || datum.percent === datum.value ? '' : ` (${datum.percent})`;\n   124\t    return fill(messages.pointAll, {\n   125\t      x: datum.seriesLabel, values: datum.value + share, position,\n   126\t    });\n   127\t  }\n   128\t  if (view.kind !== 'scatter' && mode === 'all' && focus.kind === 'aligned') {\n   129\t    // What the tooltip shows at this x, the stack total included, said once (spec I1, F10).\n   130\t    const model = lookup.tooltip({ kind: 'x', x: focus.x });\n   131\t    const shown = new Set(model.rows.map(r => r.seriesIndex));\n   132\t    const rows = model.rows.map(r => fill(messages.seriesValue, { series: r.seriesLabel, value: r.value }));\n   133\t    for (const ref of refsAt(view, focus.x)) {\n   134\t      if (ref.kind !== 'aligned') continue;\n   135\t      const index = view.frame.series.findIndex(s => s.key === ref.seriesKey);\n   136\t      if (shown.has(index)) continue;\n   137\t      const datum = lookup.datum(ref);\n   138\t      if (datum) rows.push(fill(messages.seriesValue, { series: datum.seriesLabel, value: datum.value }));\n   139\t    }\n   140\t    if (model.total !== null) rows.push(fill(messages.seriesValue, { series: messages.total, value: model.total }));\n   141\t    if (!rows.length) return null;\n   142\t    return fill(messages.pointAll, { x: formatters.x(focus.x), values: rows.join('; '), position });\n   143\t  }\n   144\t  return pointOf(lookup, focus, formatters, messages);\n   145\t}\n   146\t\n   147\t// ── overlay ─────────────────────────────────────────────────────────────────────────────────────────\n   148\t\n   149\texport interface OverlayInput {\n   150\t  readonly view: View;\n   151\t  readonly layout: Layout;\n   152\t  readonly lookup: Lookup;\n   153\t  /** What is shown (pointer or keyboard). */\n   154\t  readonly target: PickTarget | null;\n   155\t  /** The keyboard's datum, when the proxy has focus and is focus-visible: it gets the focus ring. */\n   156\t  readonly ring: DatumRef | null;\n   157\t  /** In single mode only the focused series is highlighted. */\n   158\t  readonly only: DatumRef | null;\n   159\t}\n   160\t\n   161\tconst HALO = 13;\n   162\tconst MARKER = 9;\n   163\tconst RING_GAP = 4;\n   164\t/**\n   165\t * How far the keyboard's datum ring reaches beyond the datum's box: the widest gap, then the ring's 2 px in\n   166\t * the focus colour between 1 px of background colour on each side (WCAG 1.4.11: the surround separates the\n   167\t * focus colour from any mark it crosses, so it needs 3:1 against the background only).\n   168\t */\n   169\texport const RING_REACH = 10;\n   170\t/** The ring in the focus colour, and the background-coloured surround it is drawn on. */\n   171\tconst RING_WIDTH = 2;\n   172\tconst SURROUND_WIDTH = 4; // RING_WIDTH + 2, written out: no work at import time\n   173\t/** How far inside the plot's rectangle its focus outline reaches (2 px at an offset of -3 px). */\n   174\texport const OUTLINE_REACH = 4;\n   175\t\n   176\tfunction rule(x1: number, y1: number, x2: number, y2: number, name: 'axis' | 'focus' | 'text' | 'background', width: number): RuleMark {\n   177\t  return { type: 'rule', x1, y1, x2, y2, stroke: { kind: 'token', name }, strokeWidth: width, dash: null, role: 'cursor' };\n   178\t}\n   179\t\n   180\tfunction outline(box: Rect, gap: number, name: 'focus' | 'text' | 'background', width: number): RuleMark[] {\n   181\t  const x0 = box.x - gap, y0 = box.y - gap, x1 = box.x + box.width + gap, y1 = box.y + box.height + gap;\n   182\t  // Each side runs on by half the width at both ends, so the corners are closed as with square caps.\n   183\t  const h = width / 2;\n   184\t  return [\n   185\t    rule(x0 - h, y0, x1 + h, y0, name, width), rule(x1, y0 - h, x1, y1 + h, name, width),\n   186\t    rule(x1 + h, y1, x0 - h, y1, name, width), rule(x0, y1 + h, x0, y0 - h, name, width),\n   187\t  ];\n   188\t}\n   189\t\n   190\tfunction seriesIndex(view: View, ref: DatumRef): number {\n   191\t  if (view.kind === 'donut') return -1;\n   192\t  if (ref.kind === 'slice') return -1;\n   193\t  return view.frame.series.findIndex(s => s.key === ref.seriesKey);\n   194\t}\n   195\t\n   196\t/** Adds what a chart kind draws over its marks for the shown target (cursor, points, outlines). */\n   197\texport type TargetMarks = (input: OverlayInput, plot: Rect, clipped: Mark[], unclipped: Mark[]) => void;\n   198\t\n   199\t/** Aligned charts: the cursor rule at the x, with the points (lines, areas) or outlines (bars) there. */\n   200\texport const alignedTargetMarks: TargetMarks = ({ view, layout, lookup, target, only }, plot, clipped, unclipped) => {\n   201\t  if (target?.kind !== 'x' || view.kind === 'donut' || view.kind === 'scatter' || layout.kind !== 'plot') return;\n   202\t  const projection = layout.projection;\n   203\t  const refs = only ? [only] : refsAt(view, target.x);\n   204\t  const scale = projection.kind === 'xy' ? projection.x : projection.kind === 'bands' ? projection.band : null;\n   205\t  if (scale) {\n   206\t    const at = scale.type === 'band' ? scale.center(target.x) : scale.map(target.x);\n   207\t    const across = projection.kind === 'bands' && projection.horizontal;\n   208\t    if (Number.isFinite(at)) {\n   209\t      clipped.push(across ? rule(plot.x, at, plot.x + plot.width, at, 'axis', 1) : rule(at, plot.y, at, plot.y + plot.height, 'axis', 1));\n   210\t    }\n   211\t  }\n   212\t  for (const ref of refs) {\n   213\t    const box = lookup.anchor(ref);\n   214\t    if (!box) continue;\n   215\t    if (projection.kind === 'bands') {\n   216\t      unclipped.push(...outline(box, 1, 'text', 2));\n   217\t    } else {\n   218\t      const s = seriesIndex(view, ref);\n   219\t      const cue = view.cues[s];\n   220\t      const xy = Float32Array.of(box.x + box.width / 2, box.y + box.height / 2);\n   221\t      const shape = cue?.marker ?? 'circle';\n   222\t      clipped.push({ type: 'points', series: s, xy, shape, size: HALO, fill: { kind: 'token', name: 'background' } });\n   223\t      clipped.push({ type: 'points', series: s, xy, shape, size: MARKER, fill: { kind: 'series', index: s } });\n   224\t    }\n   225\t  }\n   226\t};\n   227\t\n   228\t/** Scatter: the points under the pointer, highlighted. */\n   229\texport const scatterTargetMarks: TargetMarks = ({ view, lookup, target }, _plot, clipped) => {\n   230\t  if (target?.kind !== 'point' || view.kind !== 'scatter') return;\n   231\t  for (const ref of target.refs) {\n   232\t    const box = lookup.anchor(ref);\n   233\t    if (!box) continue;\n   234\t    const s = seriesIndex(view, ref);\n   235\t    const xy = Float32Array.of(box.x, box.y);\n   236\t    const shape = view.cues[s]?.marker ?? 'circle';\n   237\t    clipped.push({ type: 'points', series: s, xy, shape, size: HALO, fill: { kind: 'token', name: 'text' } });\n   238\t    clipped.push({ type: 'points', series: s, xy, shape, size: MARKER, fill: { kind: 'series', index: s } });\n   239\t  }\n   240\t};\n   241\t\n   242\t/** Donut: the slice outlined, outside the ring and inside the hole. */\n   243\texport const donutTargetMarks: TargetMarks = ({ view, layout, target }, _plot, _clipped, unclipped) => {\n   244\t  if (target?.kind !== 'slice' || view.kind !== 'donut' || layout.kind !== 'plot' || layout.projection.kind !== 'ring') return;\n   245\t  const projection = layout.projection;\n   246\t  // The outline follows the slice as drawn: a slice thinner than a pixel of arc is widened to stay visible.\n   247\t  const geometry = donutGeometry(view.slices, projection);\n   248\t  const at = geometry.drawn.findIndex(s => s.key === target.sliceKey);\n   249\t  const slice = at >= 0 ? geometry.drawn[at] : undefined;\n   250\t  const from = at >= 0 ? geometry.angles[2 * at]! : 0;\n   251\t  const to = at >= 0 ? geometry.angles[2 * at + 1]! : 0;\n   252\t  if (slice && to > from) {\n   253\t    const angles = Float32Array.of(from, to);\n   254\t    const fills = [{ kind: 'token', name: 'text' } as const];\n   255\t    unclipped.push({ type: 'arcs', cx: projection.cx, cy: projection.cy, r0: projection.r1 + 1, r1: projection.r1 + 4, angles, fills, gap: 0 });\n   256\t    if (projection.r0 > 5) {\n   257\t      unclipped.push({ type: 'arcs', cx: projection.cx, cy: projection.cy, r0: projection.r0 - 4, r1: projection.r0 - 1, angles, fills, gap: 0 });\n   258\t    }\n   259\t  }\n   260\t};\n   261\t\n   262\tconst allTargetMarks: TargetMarks = (input, plot, clipped, unclipped) => {\n   263\t  const kind = input.view.kind;\n   264\t  (kind === 'donut' ? donutTargetMarks : kind === 'scatter' ? scatterTargetMarks : alignedTargetMarks)(input, plot, clipped, unclipped);\n   265\t};\n   266\t\n   267\t/** Cursor rule, highlighted points or bar and slice outlines, and the keyboard focus ring (contracts: Overlay). */\n   268\texport function buildOverlay(input: OverlayInput): Overlay | null {\n   269\t  return overlayWith(allTargetMarks, input);\n   270\t}\n   271\t\n   272\t/** The overlay with a chart kind's own target marks (a kind's composition holds only its own). */\n   273\texport function overlayWith(targetMarks: TargetMarks, input: OverlayInput): Overlay | null {\n   274\t  const { layout, lookup, target, ring } = input;\n   275\t  if (layout.kind !== 'plot' || (target === null && ring === null)) return null;\n   276\t  const plot = layout.plot;\n   277\t  const clipped: Mark[] = [];\n   278\t  const unclipped: Mark[] = [];\n   279\t  targetMarks(input, plot, clipped, unclipped);\n   280\t\n   281\t  if (ring) {\n   282\t    const box = lookup.anchor(ring);\n   283\t    if (box) {\n   284\t      // Drawn inside the plot's box, so it is painted at the last point and at the top of a donut too (A2):\n   285\t      // the ring's lines, surround included, are kept inside the plot. Two tones: the focus colour on a\n   286\t      // surround of the background colour (WCAG 1.4.11 against whatever mark the ring crosses).\n   287\t      const gap = box.width === 0 && box.height === 0 ? 8 : RING_GAP;\n   288\t      const inset = SURROUND_WIDTH / 2;\n   289\t      const x0 = Math.max(plot.x + inset, box.x - gap), y0 = Math.max(plot.y + inset, box.y - gap);\n   290\t      const x1 = Math.min(plot.x + plot.width - inset, box.x + box.width + gap), y1 = Math.min(plot.y + plot.height - inset, box.y + box.height + gap);\n   291\t      if (x1 > x0 && y1 > y0) {\n   292\t        const ringBox = { x: x0, y: y0, width: x1 - x0, height: y1 - y0 };\n   293\t        unclipped.push(...outline(ringBox, 0, 'background', SURROUND_WIDTH), ...outline(ringBox, 0, 'focus', RING_WIDTH));\n   294\t      }\n   295\t    }\n   296\t  }\n   297\t  return clipped.length || unclipped.length ? { clip: plot, clipped, unclipped } : null;\n   298\t}\n   299\t\n   300\t/** The union of the anchors a tooltip must not cover, in plot coordinates; null when nothing is drawn. */\n   301\texport function targetBox(view: View, lookup: Lookup, target: PickTarget, only: DatumRef | null): Rect | null {\n   302\t  let refs: readonly DatumRef[];\n   303\t  if (target.kind === 'x') refs = view.kind === 'donut' || view.kind === 'scatter' ? [] : only ? [only] : refsAt(view, target.x);\n   304\t  else if (target.kind === 'point') refs = target.refs;\n   305\t  else refs = [{ kind: 'slice', sliceKey: target.sliceKey }];\n   306\t  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;\n   307\t  for (const ref of refs) {\n   308\t    const box = lookup.anchor(ref);\n   309\t    if (!box) continue;\n   310\t    x0 = Math.min(x0, box.x);\n   311\t    y0 = Math.min(y0, box.y);\n   312\t    x1 = Math.max(x1, box.x + box.width);\n   313\t    y1 = Math.max(y1, box.y + box.height);\n   314\t  }\n   315\t  return Number.isFinite(x0) ? { x: x0, y: y0, width: x1 - x0, height: y1 - y0 } : null;\n   316\t}\n   317\t\n   318\t// ── zoom ────────────────────────────────────────────────────────────────────────────────────────────\n   319\t\n   320\t/** Factor of one zoom step (buttons, keys): the visible x range halves or doubles around its centre. */\n   321\texport const ZOOM_FACTOR = 2;\n   322\t/** Shift+arrow moves the window by this share of its width. */\n   323\texport const PAN_SHARE = 0.1;\n   324\t\n   325\t/** Keeps a window of the given width inside `full`, moving it rather than shrinking it. */\n   326\tfunction inside(full: Span, start: number, width: number): Span {\n   327\t  const a = Math.max(full[0], Math.min(start, full[1] - width));\n   328\t  return [a, a + width];\n   329\t}\n   330\t\n   331\t/**\n   332\t * The window after scaling `current` by `factor` around `center` (a position), clamped to `full` and to a\n   333\t * smallest width. null means the whole range (no zoom), so the reset control can disappear. A window that\n   334\t * cannot get narrower comes back unchanged; a result is always finite and strictly ordered.\n   335\t */\n   336\texport function scaleWindow(full: Span, current: Span, factor: number, center: number, minWidth: number): Span | null {\n   337\t  const fullWidth = full[1] - full[0];\n   338\t  const width = Math.max(minWidth, (current[1] - current[0]) * factor);\n   339\t  if (!(fullWidth > 0) || width >= fullWidth) return null;\n   340\t  const share = current[1] > current[0] ? (center - current[0]) / (current[1] - current[0]) : 0.5;\n   341\t  const next = inside(full, center - share * width, width);\n   342\t  if (!(Number.isFinite(next[0]) && Number.isFinite(next[1]) && next[1] > next[0])) return current;\n   343\t  return next;\n   344\t}\n   345\t\n   346\t/**\n   347\t * One zoom step (button, key, wheel) from `current`: the scaled window when it goes the way asked, a zoom-in\n   348\t * strictly narrower and a zoom-out strictly wider (or the whole range, null); undefined when it would not.\n   349\t * A window below the minimum (a public zoom() can set one) is not widened by zooming in (interaction review,\n   350\t * new item 7).\n   351\t */\n   352\texport function zoomStep(full: Span, current: Span, factor: number, center: number, minWidth: number): Span | null | undefined {\n   353\t  const width = current[1] - current[0];\n   354\t  const next = scaleWindow(full, current, factor, center, minWidth);\n   355\t  if (factor < 1) return next !== null && next[1] - next[0] < width ? next : undefined;\n   356\t  if (factor > 1) {\n   357\t    const whole = current[0] <= full[0] && current[1] >= full[1];\n   358\t    if (next === null) return whole ? undefined : null;\n   359\t    return next[1] - next[0] > width ? next : undefined;\n   360\t  }\n   361\t  return undefined;\n   362\t}\n   363\t\n   364\t/** Whether one Zoom in step from `window` would show a narrower window (else the control is not offered as working). */\n   365\texport function canZoomIn(view: View, window: Span): boolean {\n   366\t  if (view.kind === 'donut') return false;\n   367\t  return zoomStep(view.xFull, window, 1 / ZOOM_FACTOR, (window[0] + window[1]) / 2, minimumWidth(view)) !== undefined;\n   368\t}\n   369\t\n   370\t/** The window moved by `share` of its width (negative: towards the start); null when it would not move. */\n   371\texport function panWindow(full: Span, current: Span, share: number): Span | null {\n   372\t  const width = current[1] - current[0];\n   373\t  const moved = inside(full, current[0] + share * width, width);\n   374\t  return moved[0] === current[0] ? null : moved;\n   375\t}\n   376\t\n   377\t/**\n   378\t * Smallest window: about two x slots for aligned charts, a ten-thousandth of the range otherwise, but never\n   379\t * more than half the range, so one halving is always attainable (interaction review, part 1 item 9).\n   380\t */\n   381\texport function minimumWidth(view: View): number {\n   382\t  if (view.kind === 'donut') return 0;\n   383\t  const full = view.xFull[1] - view.xFull[0];\n   384\t  // Never below what doubles can tell apart at these positions: one unit in the last place keeps two ends.\n   385\t  const largest = Math.max(Math.abs(view.xFull[0]), Math.abs(view.xFull[1]), Number.MIN_VALUE);\n   386\t  const representable = 2 ** (Math.floor(Math.log2(largest)) - 52);\n   387\t  const wanted = view.kind === 'scatter' ? full / 1e4\n   388\t    : view.frame.x.values.length > 1 ? 2 * full / (view.frame.x.values.length - 1) : full;\n   389\t  return Math.max(Math.min(wanted, full / 2), representable);\n   390\t}\n   391\t\n   392\t/** Whether zoom applies to this chart (spec 3.6): not donut, not a category axis, not compact, not switched off. */\n   393\texport function zoomApplies(view: View, option: unknown): boolean {\n   394\t  if (option === false || view.kind === 'donut' || view.compact) return false;\n   395\t  if (view.kind === 'scatter') return true;\n   396\t  return view.frame.x.kind !== 'category';\n   397\t}\n   398\t\n   399\t/**\n   400\t * Narrowed mode on scatter (review 2, finding 7): the next or previous point of the same series in x order\n   401\t * among its visible points; null at an end.\n   402\t */\n   403\texport function stepInSeries(view: ScatterView, ref: DatumRef, direction: StepDirection): DatumRef | null {\n   404\t  if (ref.kind !== 'point') return null;\n   405\t  const s = view.frame.series.findIndex(series => series.key === ref.seriesKey);\n   406\t  const series = view.frame.series[s];\n   407\t  const range = view.visiblePoints[s];\n   408\t  if (!series || !range || range.end <= range.start) return null;\n   409\t  const rows = series.row;\n   410\t  let at = -1;\n   411\t  for (let i = range.start; i < range.end; i++) if ((rows ? rows[i]! : i) === ref.row) { at = i; break; }\n   412\t  if (at < 0) return null;\n   413\t  const page = pageDistance(range.end - range.start);\n   414\t  const to = direction === 'next' ? at + 1 : direction === 'previous' ? at - 1 : direction === 'first' ? range.start\n   415\t    : direction === 'last' ? range.end - 1 : direction === 'page-next' ? Math.min(range.end - 1, at + page)\n   416\t      : direction === 'page-previous' ? Math.max(range.start, at - page) : -1;\n   417\t  if (to < range.start || to >= range.end || to === at) return null;\n   418\t  return { kind: 'point', seriesKey: series.key, row: rows ? rows[to]! : to, x: series.x[to]! };\n   419\t}\n   420\t\n   421\t/** The x position under a plot pixel, from the layout's projection; null on a band (category) axis. */\n   422\texport function positionAt(layout: Layout, px: number, py: number): number | null {\n   423\t  if (layout.kind !== 'plot') return null;\n   424\t  const p = layout.projection;\n   425\t  if (p.kind === 'xy') return p.x.type === 'band' ? null : p.x.invert(px);\n   426\t  if (p.kind === 'bands') return p.band.type === 'band' ? null : p.band.invert(p.horizontal ? py : px);\n   427\t  return null;\n   428\t}\n   429\t\n   430\texport type { PlotLayout };\n","exit_code":0,"status":"completed"}}
