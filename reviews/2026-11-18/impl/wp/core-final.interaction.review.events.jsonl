{"type":"item.completed","item":{"id":"item_59","type":"command_execution","command":"/bin/bash -lc \"sed -n '95,113p' packages/axylo/test/browser/chart/review5.browser.test.ts && git show a518cbb:packages/axylo/test/browser/acceptance/a2-keyboard.browser.test.ts | sed -n '58,83p' && rg -n 'zero.*donut|empty.*slice|F8' docs/02-product-spec.md && sed -n '112,127p' packages/axylo/src/messages/index.ts && cat packages/axylo/src/dom/attributes.ts && git rev-parse --short a518cbb\"","aggregated_output":"    expect(await tipText(page)).toBeNull();\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('part 1 item 3: the slice list comes from the slices, not from the table option', () => {\n  it('an all-zero donut with table: false still lists its slices', async () => {\n    const page = await chartPage();\n    await create(page, 'donut', { title: 'Z', data: [{ l: 'A', v: 0 }, { l: 'B', v: 0 }], label: 'l', value: 'v', table: false });\n    const items = await page.locator('#chart .axylo-legend-list li').allTextContents();\n    expect(items.length).toBe(2);\n    expect(items[0]).toMatch(/^A/);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\n/** Taps over the plot until the tooltip shows `want`, sweeping around a guess (renderer-independent). */\nasync function tapUntil(page: Page, fx: number, fy: number, want: RegExp): Promise<boolean> {\n  const at = (await page.locator('#chart .axylo-plot').boundingBox())!;\nasync function zoomIn(page: Page, type: Full): Promise<void> {\n  const range = type === 'scatter' ? [12, 30] : ['2026-03-03', '2026-03-05'];\n  await call(page, 'zoom', [range]);\n}\n\ndescribe('A2 tab stops', () => {\n  for (const type of FULL as Full[]) {\n    const states: [string, ((page: Page) => Promise<void>) | null][] = [\n      ['collapsed', async () => {}],\n      ['zoomed', type === 'line' || type === 'area' || type === 'scatter' ? page => zoomIn(page, type) : null],\n      ['streaming', async page => call(page, 'append', [MORE[type]])],\n    ];\n    for (const [state, enter] of states) {\n      if (!enter) continue;\n      it(`A2 ${type}: two tab stops with the table closed (${state}): the plot, then the toolbar; Shift+Tab reverses; Tab leaves the chart`, async () => {\n        const page = await devPage();\n        await create(page, type);\n        await enter(page);\n        const forwards = await tabStops(page);\n        expect(forwards).toHaveLength(3);\n        expect(forwards[0]).toBe('proxy');\n        expect(forwards[1]).toMatch(/^toolbar:/);\n        expect(forwards[2]).toBe('after');\n        const backwards = await tabStops(page, true);\n        expect(backwards[0]).toMatch(/^toolbar:/);\n        expect(backwards.slice(1)).toEqual(['proxy', 'before']);\n101:| F8 | Donut: slices keep the given order, start at 12 o'clock and run clockwise. The legend shows every slice's value and percentage as text, in slice order. A zero slice is listed without an arc; a `null` slice is listed as \"No data\". A negative value is AX120 and the chart shows its error state. With more than eight slices that have an arc (a positive value), the seven largest are drawn and the rest of those are grouped as \"Other (n)\", with AX121; zero and `null` slices never count toward the limit and are never grouped, so each stays listed on its own; the table lists every category. Shares are shown with at most one fraction digit. An all-zero donut shows the empty state. | `parts` fixture; one test per case | R7, landscape scoreboard 3.1 |\nexport function pointOf(lookup: Lookup, ref: DatumRef, formatters: Formatters, messages: Messages): string | null {\n  const ordinal = lookup.ordinal(ref);\n  if (ordinal < 0) return null;\n  const datum = lookup.datum(ref);\n  if (!datum) return null;\n  return fill(messages.pointOf, {\n    series: datum.seriesLabel, x: datum.x, value: datum.value,\n    index: formatters.count(ordinal + 1), count: formatters.count(lookup.count),\n  });\n}\n/** Writes an attribute only when it changes; null removes it. Shared by the figure and its controls. */\nexport function setAttr(el: Element, name: string, value: string | null): void {\n  if (value === null) {\n    if (el.hasAttribute(name)) el.removeAttribute(name);\n  } else if (el.getAttribute(name) !== value) {\n    el.setAttribute(name, value);\n  }\n}\na518cbb\n","exit_code":0,"status":"completed"}}
