{"type":"item.completed","item":{"id":"item_21","type":"command_execution","command":"/bin/bash -lc 'nl -ba packages/axylo/src/dom/figure.ts'","aggregated_output":"     1\t/**\n     2\t * The chart's document structure (plan 2.4; spec A1, C1, F12, L7). The author's target is the root; inside\n     3\t * it the figure holds the caption (title, subtitle, summary), the plot container (marks, text layer, state\n     4\t * message), the reader's note, a polite live region and the tooltip. Only text is ever set, never HTML.\n     5\t *\n     6\t * The interaction layer (dom/interaction.ts) adds the keyboard proxy inside the plot and fills the control\n     7\t * slots (`top` above the plot, `side` beside it, `controls` under it: legend, toolbar, table) and `readout`;\n     8\t * the figure only provides those slots. The plot and `side` share the `body` row.\n     9\t */\n    10\timport { setAttr } from './attributes';\n    11\t\n    12\texport interface TitleModel {\n    13\t  readonly text: string;\n    14\t  readonly level: number;\n    15\t  readonly visible: boolean;\n    16\t}\n    17\t\n    18\texport interface NoteSegment {\n    19\t  readonly text: string;\n    20\t  readonly lang: string | null;\n    21\t}\n    22\t\n    23\texport interface FigureModel {\n    24\t  readonly compact: boolean;\n    25\t  /** The heading, or null when there is none (only `labelledBy`, or no title at all). */\n    26\t  readonly title: TitleModel | null;\n    27\t  /** Id of a heading the page already has. */\n    28\t  readonly labelledBy: string | null;\n    29\t  /** Accessible name when neither a title nor `labelledBy` names the chart (generated, AX140). */\n    30\t  readonly name: string;\n    31\t  readonly subtitle: string | null;\n    32\t  readonly summary: string;\n    33\t  /** The plot is too small to draw (spec L8): the summary is shown instead. */\n    34\t  readonly summaryVisible: boolean;\n    35\t  readonly note: string | null;\n    36\t  /** Loading, empty, error or internal-error text shown inside the plot (spec L7); null when marks are shown. */\n    37\t  readonly message: string | null;\n    38\t  /**\n    39\t   * `lang` for the message and the note: 'en' when they show built-in English on a page in another\n    40\t   * language (spec A10), else null.\n    41\t   */\n    42\t  readonly messageLang?: string | null;\n    43\t  readonly noteLang?: string | null;\n    44\t  /**\n    45\t   * The note as runs of text, each with its own `lang` (A10: a sentence can mix built-in English and the\n    46\t   * author's text). When given, it is the note's content and `noteLang` is not used.\n    47\t   */\n    48\t  readonly noteSegments?: readonly NoteSegment[] | null;\n    49\t  /** `lang` of the generated summary: 'en' when its built-in sentences are English on another page (A10). */\n    50\t  readonly summaryLang?: string | null;\n    51\t}\n    52\t\n    53\texport interface Figure {\n    54\t  readonly figure: HTMLElement;\n    55\t  readonly plot: HTMLElement;\n    56\t  readonly tooltip: HTMLElement;\n    57\t  /** The readout strip under the plot (readout mode, decided by layout): two reserved lines of running text. */\n    58\t  readonly readout: HTMLElement;\n    59\t  /** Legend, toolbar and table, in that order, between the plot and the note. */\n    60\t  readonly controls: HTMLElement;\n    61\t  /** Between the caption and the plot (`legend: 'top'`). */\n    62\t  readonly top: HTMLElement;\n    63\t  /** Beside the plot, in the same row (`legend: 'right'`). */\n    64\t  readonly side: HTMLElement;\n    65\t  /** The row holding the plot's column and `side`; it takes the height the caption and controls leave. */\n    66\t  readonly body: HTMLElement;\n    67\t  /** The plot's column inside `body`: the open table covers this, never the controls beside it. */\n    68\t  readonly stage: HTMLElement;\n    69\t  readonly id: string;\n    70\t  /** Returns true when something that can change the figure's layout was written. */\n    71\t  update(model: FigureModel): boolean;\n    72\t  /** Puts text in the polite live region (state changes only, spec L7, A7). */\n    73\t  /** `lang` marks built-in English on a page in another language (spec A10). */\n    74\t  announce(text: string, lang?: string | null): void;\n    75\t  /** Removes everything the figure added to the root, and the root's added class. */\n    76\t  destroy(): void;\n    77\t}\n    78\t\n    79\tconst HIDDEN = 'axylo-visually-hidden';\n    80\t\n    81\tfunction setText(el: HTMLElement, text: string): void {\n    82\t  if (el.textContent !== text) el.textContent = text;\n    83\t}\n    84\t\n    85\tfunction show(el: HTMLElement, visible: boolean): void {\n    86\t  if (el.hidden === visible) el.hidden = !visible;\n    87\t}\n    88\t\n    89\texport function createFigure(root: HTMLElement, id: string, parts: { marks: Element; text: Element }): Figure {\n    90\t  const doc = root.ownerDocument;\n    91\t  const addedClass = !root.classList.contains('axylo');\n    92\t  const hadClassAttribute = root.hasAttribute('class');\n    93\t  if (addedClass) root.classList.add('axylo');\n    94\t\n    95\t  const make = <K extends keyof HTMLElementTagNameMap>(tag: K, className: string): HTMLElementTagNameMap[K] => {\n    96\t    const el = doc.createElement(tag);\n    97\t    el.className = className;\n    98\t    return el;\n    99\t  };\n   100\t  // The figure carries the `axylo` class too: the theme writes its custom properties and scheme attribute on\n   101\t  // the figure, so two charts on one target never share them (review 3, finding 10).\n   102\t  const figure = make('figure', 'axylo axylo-figure');\n   103\t  figure.id = id;\n   104\t  // A div, not figcaption: a figure with a figcaption may not take the group or img role (ARIA in HTML), and\n   105\t  // the figure is named and described through aria-labelledby and aria-describedby anyway.\n   106\t  const caption = make('div', 'axylo-caption');\n   107\t  const title = make('div', 'axylo-title');\n   108\t  title.id = `${id}-t`;\n   109\t  title.setAttribute('role', 'heading');\n   110\t  const subtitle = make('p', 'axylo-subtitle');\n   111\t  subtitle.id = `${id}-st`;\n   112\t  // Hidden until the first update says otherwise, so nothing is measured with an empty caption.\n   113\t  title.hidden = true;\n   114\t  subtitle.hidden = true;\n   115\t  // The whole generated summary is the figure's description, always (visually hidden). What the too-small\n   116\t  // state shows (spec L8) is `summary`: the first sentence, one line (type, series count), aria-hidden since\n   117\t  // the description already says it.\n   118\t  const description = make('p', `axylo-description ${HIDDEN}`);\n   119\t  description.id = `${id}-s`;\n   120\t  const summary = make('p', `axylo-summary ${HIDDEN}`);\n   121\t  summary.setAttribute('aria-hidden', 'true');\n   122\t\n   123\t  const plot = make('div', 'axylo-plot');\n   124\t  const message = make('p', 'axylo-message');\n   125\t  message.id = `${id}-m`;\n   126\t  message.hidden = true;\n   127\t  const corner = make('span', 'axylo-corner');\n   128\t  corner.setAttribute('aria-hidden', 'true');\n   129\t  corner.textContent = '*';\n   130\t  corner.hidden = true;\n   131\t  plot.append(parts.marks, parts.text, message, corner);\n   132\t  const note = make('p', 'axylo-note');\n   133\t  note.id = `${id}-n`;\n   134\t  note.setAttribute('role', 'status');\n   135\t  // A status that is not live: the note can change as streamed data arrives (labels thinned, values left\n   136\t  // out), and data arriving must not speak (spec A7). The summary carries the same statements.\n   137\t  note.setAttribute('aria-live', 'off');\n   138\t  note.hidden = true;\n   139\t  const live = make('div', `axylo-live ${HIDDEN}`);\n   140\t  live.setAttribute('aria-live', 'polite');\n   141\t  const tooltip = make('div', 'axylo-tooltip');\n   142\t  tooltip.hidden = true;\n   143\t  tooltip.setAttribute('aria-hidden', 'true');\n   144\t  const readout = make('div', 'axylo-readout');\n   145\t  readout.hidden = true;\n   146\t  readout.setAttribute('aria-hidden', 'true');\n   147\t  const controls = make('div', 'axylo-controls');\n   148\t  controls.hidden = true;\n   149\t  const top = make('div', 'axylo-controls-top');\n   150\t  top.hidden = true;\n   151\t  const side = make('div', 'axylo-controls-side');\n   152\t  side.hidden = true;\n   153\t  const body = make('div', 'axylo-body');\n   154\t  const stage = make('div', 'axylo-stage');\n   155\t  // The readout strip sits under the plot in the plot's column: in readout mode it is in the flow there, so it\n   156\t  // covers nothing and nothing covers it (decision 0004 revision 2, rule 5).\n   157\t  stage.append(plot, readout);\n   158\t  body.append(stage, side);\n   159\t  caption.append(title, subtitle, description, summary);\n   160\t  figure.append(caption, top, body, controls, note, live, tooltip);\n   161\t  root.appendChild(figure);\n   162\t\n   163\t  let last: FigureModel | null = null;\n   164\t  /** The note's runs as last written, when it was written as runs. */\n   165\t  let noteRuns: string | null = null;\n   166\t\n   167\t  return {\n   168\t    figure,\n   169\t    plot,\n   170\t    tooltip,\n   171\t    readout,\n   172\t    controls,\n   173\t    top,\n   174\t    side,\n   175\t    body,\n   176\t    stage,\n   177\t    id,\n   178\t    update(model: FigureModel): boolean {\n   179\t      if (last !== null && same(last, model)) return false;\n   180\t      const moved = last === null || movesLayout(last, model);\n   181\t      last = model;\n   182\t      const { compact } = model;\n   183\t      figure.classList.toggle('axylo-compact', compact);\n   184\t      setAttr(figure, 'role', compact ? 'img' : 'group');\n   185\t\n   186\t      // Name: the title, else the page's own heading, else the generated name.\n   187\t      const heading = !compact && model.title !== null;\n   188\t      if (heading) {\n   189\t        setText(title, model.title!.text);\n   190\t        setAttr(title, 'aria-level', String(model.title!.level));\n   191\t        title.classList.toggle(HIDDEN, !model.title!.visible);\n   192\t      }\n   193\t      show(title, heading);\n   194\t      if (model.labelledBy) {\n   195\t        setAttr(figure, 'aria-labelledby', model.labelledBy);\n   196\t        setAttr(figure, 'aria-label', null);\n   197\t      } else if (heading) {\n   198\t        setAttr(figure, 'aria-labelledby', title.id);\n   199\t        setAttr(figure, 'aria-label', null);\n   200\t      } else {\n   201\t        setAttr(figure, 'aria-labelledby', null);\n   202\t        setAttr(figure, 'aria-label', model.name);\n   203\t      }\n   204\t\n   205\t      setText(subtitle, model.subtitle ?? '');\n   206\t      show(subtitle, !compact && !!model.subtitle);\n   207\t      setText(description, model.summary);\n   208\t      setAttr(description, 'lang', model.summaryLang ?? null);\n   209\t      setText(summary, /^.*?[.!?。！？](?=\\s|$)/u.exec(model.summary)?.[0] ?? model.summary);\n   210\t      setAttr(summary, 'lang', model.summaryLang ?? null);\n   211\t      summary.classList.toggle(HIDDEN, compact || !model.summaryVisible);\n   212\t      // Shown in the too-small state (spec L8) as one line (the stylesheet clips it after its first line), the\n   213\t      // whole text staying the figure's description for assistive technology.\n   214\t      setAttr(figure, 'aria-describedby', description.id);\n   215\t\n   216\t      // The compact variant has no note element: the summary says what was left out, and a corner marker\n   217\t      // shows it (spec C5); the marker's text equivalent is that description.\n   218\t      const segments = compact ? null : model.noteSegments ?? null;\n   219\t      if (segments && segments.length > 1) {\n   220\t        // Runs in their own languages: one span each, so assistive technology switches voice per run.\n   221\t        // Compared in memory: nothing but the runs' text reaches the page (the distribution test reads every\n   222\t        // attribute for stray serialized data).\n   223\t        const signature = segments.map(run => `${run.lang ?? ''}\\u0001${run.text}`).join('\\u0002');\n   224\t        if (noteRuns !== signature) {\n   225\t          note.replaceChildren(...segments.map(run => {\n   226\t            const span = doc.createElement('span');\n   227\t            // The runs carry their own spacing (the reader joins sentences with a space run).\n   228\t            span.textContent = run.text;\n   229\t            if (run.lang !== null) span.setAttribute('lang', run.lang);\n   230\t            return span;\n   231\t          }));\n   232\t          noteRuns = signature;\n   233\t        }\n   234\t        setAttr(note, 'lang', null);\n   235\t      } else {\n   236\t        noteRuns = null;\n   237\t        if (note.firstElementChild) note.textContent = '';\n   238\t        setText(note, compact ? '' : segments?.[0]?.text ?? model.note ?? '');\n   239\t        setAttr(note, 'lang', segments ? segments[0]?.lang ?? null : model.noteLang ?? null);\n   240\t      }\n   241\t      setAttr(message, 'lang', model.messageLang ?? null);\n   242\t      show(note, !compact && model.note !== null);\n   243\t      show(corner, compact && model.note !== null);\n   244\t      setAttr(corner, 'title', compact ? model.note : null);\n   245\t\n   246\t      setText(message, model.message ?? '');\n   247\t      show(message, model.message !== null);\n   248\t      return moved;\n   249\t    },\n   250\t    announce(text: string, lang: string | null = null): void {\n   251\t      setAttr(live, 'lang', lang);\n   252\t      setText(live, text);\n   253\t    },\n   254\t    destroy(): void {\n   255\t      figure.remove();\n   256\t      if (addedClass) root.classList.remove('axylo');\n   257\t      if (!hadClassAttribute && root.classList.length === 0) root.removeAttribute('class');\n   258\t    },\n   259\t  };\n   260\t}\n   261\t\n   262\t/** Whether going from `a` to `b` can change the size of anything around the plot (the caption or the note). */\n   263\tfunction movesLayout(a: FigureModel, b: FigureModel): boolean {\n   264\t  const heading = (m: FigureModel) => m.compact || m.title === null ? '' : `${m.title.visible}\\u0000${m.title.level}\\u0000${m.title.text}`;\n   265\t  return a.compact !== b.compact || heading(a) !== heading(b) || (a.compact ? '' : a.subtitle) !== (b.compact ? '' : b.subtitle) ||\n   266\t    a.summaryVisible !== b.summaryVisible || (b.summaryVisible && a.summary !== b.summary) ||\n   267\t    (a.compact ? null : a.note) !== (b.compact ? null : b.note);\n   268\t}\n   269\t\n   270\tfunction same(a: FigureModel, b: FigureModel): boolean {\n   271\t  return a.compact === b.compact && a.messageLang === b.messageLang && a.noteLang === b.noteLang && a.labelledBy === b.labelledBy && a.name === b.name && a.subtitle === b.subtitle &&\n   272\t    a.summary === b.summary && a.summaryLang === b.summaryLang && a.summaryVisible === b.summaryVisible && a.note === b.note && a.message === b.message &&\n   273\t    (a.title === b.title || (a.title !== null && b.title !== null && a.title.text === b.title.text &&\n   274\t      a.title.level === b.title.level && a.title.visible === b.title.visible));\n   275\t}\n","exit_code":0,"status":"completed"}}
