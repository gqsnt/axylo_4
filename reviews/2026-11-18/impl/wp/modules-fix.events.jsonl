ategories: axis.kind === 'category' ? [] : null },\n    };\n    this.latest = diagnostics;\n    return this.current;\n  }\n\n  private evictObservation(key: string, window: Observations, position: number, first: number): boolean {\n    const { axis, buffers, diagnostics, duplicates, history, observations } = this.state;\n    if (window.first !== position) return false;\n    window.evict();\n    const next = window.first;\n    const series = buffers.series.get(key)!;\n    if (next === undefined) {\n      history.delete(key);\n      observations.delete(key);\n      duplicates.delete(key);\n      diagnostics.evictSeries(key);\n      if (this.fields.series !== null) buffers.series.delete(key);\n      else if (!series.description.drawable) series.description = { ...series.description, drawable: true };\n      return false;\n    }\n    const repeats = duplicates.get(key);\n    repeats?.delete(position);\n    if (repeats?.size === 0) {\n      duplicates.delete(key);\n      series.description = { ...series.description, drawable: true };\n// A preparation only edits its delta. Publishing applies it in insertion order so a\n// retained-window scan can still stop as soon as it reaches rows it should keep.\nexport class StoreMap<K, V> {\n  private changes: Map<K, V> | null = null;\n  private removed: Set<K> | null = null;\n  private count = 0;\n\n  constructor(private readonly data = new Map<K, V>()) {}\n\n  fork(): StoreMap<K, V> {\n    const draft = new StoreMap(this.data);\n    draft.changes = new Map();\n    draft.removed = new Set();\n    draft.count = this.data.size;\n    return draft;\n  }\n\n  commit(): void {\n    if (!this.changes) return;\n    for (const key of this.removed!) this.data.delete(key);\n    for (const [key, value] of this.changes) this.data.set(key, value);\n    this.changes = this.removed = null;\n  }\n\n  get size(): number { return this.changes ? this.count : this.data.size; }\n\n  get(key: K): V | undefined {\n    const value = this.changes?.get(key);\n    if (value !== undefined || this.changes?.has(key) || this.removed?.has(key)) return value;\n    return this.data.get(key);\n  }\n\n  has(key: K): boolean {\n    return Boolean(this.changes?.has(key) || !this.removed?.has(key) && this.data.has(key));\n  }\n\n  set(key: K, value: V): void {\n    if (!this.changes) {\n      this.data.set(key, value);\n      return;\n    }\n    if (!this.has(key)) this.count++;\n    this.changes.set(key, value);\n  }\n\n  delete(key: K): void {\n    if (!this.changes) {\n      this.data.delete(key);\n      return;\n    }\n    if (!this.has(key)) return;\n    this.count--;\n    this.changes.delete(key);\n    if (this.data.has(key)) this.removed!.add(key);\n  }\n\n  *[Symbol.iterator](): IterableIterator<[K, V]> {\n    if (!this.changes) {\n      yield* this.data;\n      return;\n    }\n    for (const [key, value] of this.data) {\n      if (this.removed!.has(key)) continue;\n      yield [key, this.changes.has(key) ? this.changes.get(key)! : value];\n    }\n    for (const [key, value] of this.changes) {\n      if (!this.data.has(key) || this.removed!.has(key)) yield [key, value];\n    }\n  }\n\n  *keys(): IterableIterator<K> {\n    if (!this.changes) yield* this.data.keys();\n    else for (const [key] of this) yield key;\n  }\n}\n    \"typecheck\": \"tsc -p packages/axylo --noEmit && tsc -p docs/api && tsc -p packages/react && tsc -p tests/dist\",\n    \"test\": \"vitest run\",\n    \"test:browser\": \"AXYLO_BROWSER=1 vitest run\",\n    \"test:dist\": \"vitest run --config tests/dist/vitest.config.ts\",\n    \"test:dist:browser\": \"AXYLO_BROWSER=1 vitest run --config tests/dist/vitest.config.ts\",\n    \"check\": \"npm run typecheck && npm test && npm run build && npm run test:browser && npm run test:dist && npm run test:dist:browser && npm run size\"\n    \"vitest\": \"^5.1.0\"\nv24.21.0\npackages/axylo/test/acceptance/compact.test.ts:82:    expect(r.controller.handle.diagnostics).toMatchObject([{ code: 'AX131', message: expect.st