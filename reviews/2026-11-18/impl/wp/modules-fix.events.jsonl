s work for NodeNext consumers; review fixes to the distribution tests\nAGENTS.md\nvitest.config.ts\ntests/dist/vitest.config.ts\napps/docs/vitest.config.ts\npackages/axylo/src/lookup/aligned.ts\npackages/axylo/src/data/store-unaligned.ts\npackages/axylo/test/lookup/aligned.test.ts\npackages/axylo/test/data/streaming-storage.test.ts\npackages/axylo/test/data/transactions.test.ts\n","exit_code":0,"status":"completed"}}
