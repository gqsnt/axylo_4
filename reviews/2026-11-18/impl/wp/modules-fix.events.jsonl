xLabel, xMin: formatters.x(xMin), xMax: formatters.x(xMax), yLabel,\n    }, range),\n    ...zoneText, ...entries, ...undrawn,\n  ];\n}\n\nfunction stackText(view: View, formatters: Formatters, messages: Messages): string {\n  if (view.kind === 'donut' || view.kind === 'scatter') return '';\n  const flags = view.stack?.incomplete;\n  if (!flags) return '';\n  const positions: number[] = [];\n  let count = 0;\n  for (let i = view.visibleSlots.start; i < view.visibleSlots.end; i++) {\n    if (!flags[i]) continue;\n    if (count < MAX_STACK_POSITIONS) positions.push(view.frame.x.values[i]!);\n    count++;\n  }\n  if (!count) return '';\n  const details = count > MAX_STACK_POSITIONS\n    ? `${messages.total} ${formatters.count(count)}` : positions.map(position => formatters.x(position)).join(', ');\n  return `${incomplete(view.frame.xLabel, messages)}: ${details}.`;\n}\n\nfunction referenceText(view: View, formatters: Formatters, messages: Messages): string[] {\n  if (view.kind === 'donut') return [];\n  return view.references.map(({ axis, from, to, label }) => {\n    const write = axis === 'x' ? (x: number) => formatters.x(x) : (y: number) => formatters.value(0, y);\n    const values = { label, axis, from: write(from) };\n    return from === to ? fill(messages.referenceLine, values) : fill(messages.referenceBand, { ...values, to: write(to) });\n  });\n}\n\nexport function buildReader(input: ReaderInput): ReaderModel {\n  const { view, title, labelledBy, subtitle, description, formatters, messages, disclosure } = input;\n  const labels = {\n    category: input.labels?.category ?? messages.category,\n    percentage: input.labels?.percentage ?? messages.percentage,\n    series: input.labels?.series ?? messages.series,\n    value: input.labels?.value ?? messages.value,\n    xUnit: input.labels?.xUnit,\n  };\n  const type = messages[TYPE_MESSAGE[view.kind]];\n  const xLabel = view.kind === 'donut' ? labels.category : view.frame.xLabel;\n  const yLabel = view.kind === 'donut' ? view.frame.valueLabel\n    : view.kind === 'scatter' ? view.frame.yLabel : view.frame.yLabel || view.frame.series[0]?.field || labels.value;\n  const titleText = typeof title === 'string' ? title : title?.text;\n  if (!labelledBy && !titleText && input.diagnostics) report(input.diagnostics, 'AX140', 'none');\n  const generated = fill(messages.chartName, { type, x: xLabel, y: yLabel });\n  const name = labelledBy ? '' : titleText || generated;\n  const compact = input.compact === true || (view.kind !== 'donut' && view.compact);\n  let references: string[] | undefined;\n  const referencesForView = () => references ??= referenceText(view, formatters, messages);\n  const caption = [input.caption, name, generated, messages.plotLabel].find(text => text?.trim()) ?? defaultMessages.plotLabel;\n  const table = input.table === false || compact ? null : buildTable(\n    view, [caption, ...referencesForView()].join(' '), formatters, messages, labels, input.locale,\n  );\n  const seeTable = table ? messages.seeTable : '';\n  const omitted = disclosure?.omitted ?? 0;\n  const changed = disclosure?.changed ?? 0;\n  const statements: string[] = [];\n  if (omitted > 0 || changed > 0) {\n    const counts = { omitted: formatters.count(omitted), changed: formatters.count(changed) };\n    if (omitted > 0) statements.push(fillWithTable(messages.valuesNotShown, { ...counts, count: counts.omitted }, seeTable));\n    if (changed > 0) statements.push(fillWithTable(messages.valuesChanged, { ...counts, count: counts.changed }, seeTable));\n  }\n  const omission = statements.filter(Boolean).join(' ');\n  const hidden = input.labelsHidden ?? 0;\n  const labelsHidden = hidden > 0 ? fillWithTable(messages.labelsHidden, { count: formatters.count(hidden) }, seeTable) : '';\n  const note = [omission, labelsHidden].filter(Boolean).join(' ') || null;\n  let summary: string | undefined;\n  return {\n    name, note, table,\n    get summary() {\n      // Opening the table should not scan the rest of the frame.\n      return summary ??= [\n        ...chartText(input, type, xLabel, yLabel, seeTable), compact ? stackText(view, formatters, messages) : '',\n        ...referencesForView(), subtitle, omission, description,\n      ].filter(Boolean).join(' ');\n    },\n  };\n}\nimport type { Layout, Rect, XScale } from '../core/contracts';\n\nexport type PlotLayout = Extract<Layout, { kind: 'plot' | 'compact' }>;\n\nexport function contains(rect: Rect, x: number, y: number): boolean {\n  return x >= rect.x && x <= rect.x + rect.width && y >= rect.y && y <= rect.y + rect.height;\n}\n\nexport function scatterPosition(scale: XScale, value: number): number {\n  if (scale.type !== 'band' && scale.domain[0] !== scale.domain[1]) {\n    // Interpolation can round a domain endpoint outside the plot, especially on a reversed axis.\n    if (value === scale.domain[0]) return scale.range[0];\n    if (value === scale.domain[1]) return scale.range[1];\n  }\n  return scale.map(value);\n}\n\nexport function pointBox(x: number, y: number): Rect {\n  return { x, y, width: 0, height: 0 };\n}\n\nexport function clipBox(box: Rect, plot: Rect): Rect | null {\n  const x = Math.max(box.x, plot.x);\n  const y = Math.max(box.y, plot.y);\n  const right = Math.min(box.x + box.width, plot.x + plot.width);\n  const bottom = Math.min(box.y + box.height, plot.y + plot.height);\n  return x <= right && y <= bottom ? { x, y, width: right - x, height: bottom - y } : null;\n}\nimport { defineConfig } from 'vitest/config';\n\n// Unit and property tests run in Node. Browser tests (*.browser.test.ts) drive system Chrome through\n// Playwright against the built bundle: run `npm run build` first, then `npm run test:browser`.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    include: process.env.AXYLO_BROWSER\n      ? ['packages/*/test/**/*.browser.test.ts', 'apps/docs/test/**/*.browser.test.ts', 'apps/docs/examples/node/*.test.ts']\n      : ['packages/*/test/**/*.test.ts', 'apps/docs/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 10000,\n    fileParallelism: !process.env.AXYLO_BROWSER,\n  },\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/lookup/scatter-grid.ts; rg -n 'I1|Scatter.*nearest|nearest point' docs/02-product-spec.md; cat packages/axylo/src/lookup/{aligned,text}.ts | sed -n '1,200p'; rg -n 'total|incomplete|seeTable|hidden' packages/axylo/src/{reader/table,messages/index,diagnostics/registry}.ts; sed -n '1,180p;180,410p' packages/axylo/test/data/streaming-storage.test.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/src/lookup/scatter-grid.ts; rg -n 'I1|Scatter.*nearest|nearest point' docs/02-product-spec.md; cat packages/axylo/src/lookup/{aligned,text}.ts | sed -n '1,200p'; rg -n 'total|incomplete|seeTable|hidden' packages/axylo/src/{reader/table,messages/index,diagnostics/registry}.ts; sed -n '1,180p;180,410p' packages/axylo/test/data/streaming-storage.test.ts\"","aggregated_output":"import type { ScatterView } from '../core/contracts';\nimport { contains, scatterPosition, type PlotLayout } from './geometry';\n\nconst CELL = 24;\nconst RADIUS2 = CELL * CELL;\nconst COINCIDENT = 0.5;\nconst COINCIDENT2 = COINCIDENT ** 2;\nconst LEAF_SIZE = 32;\nexport const POINT_LIMIT = 8;\n\ninterface Bucket {\n  readonly start: number;\n  readonly end: number;\n  readonly count: number;\n  readonly minX: number;\n  readonly maxX: number;\n  readonly minY: number;\n  readonly maxY: number;\n  readonly left?: Bucket;\n  readonly right?: Bucket;\n}\n\nfunction distanceTo(bucket: Bucket, x: number, y: number): number {\n  return Math.max(bucket.minX - x, x - bucket.maxX, 0) ** 2\n    + Math.max(bucket.minY - y, y - bucket.maxY, 0) ** 2;\n}\n\nfunction distanceAcross(bucket: Bucket, x: number, y: number): number {\n  return Math.max(Math.abs(bucket.minX - x), Math.abs(bucket.maxX - x)) ** 2\n    + Math.max(Math.abs(bucket.minY - y), Math.abs(bucket.maxY - y)) ** 2;\n}\n\nexport function scatterGrid(view: ScatterView, layout: PlotLayout & { projection: Extract<PlotLayout['projection'], { kind: 'xy' }> }, count: number) {\n  const { plot, projection } = layout;\n  const columns = Math.floor(plot.width / CELL) + 1;\n  const rows = Math.floor(plot.height / CELL) + 1;\n  const heads = new Map<number, number>();\n  const next = new Int32Array(count);\n  const series = new Uint32Array(count);\n  const points = new Uint32Array(count);\n  const xs = new Float64Array(count);\n  const ys = new Float64Array(count);\n  let length = 0;\n  let examined = 0;\n  let cellsExamined = 0;\n\n  function cellIndex(pixel: number, origin: number, size: number): number {\n    // Subtracting the origin from a rounded plot edge can place that edge one cell past the grid.\n    return Math.max(0, Math.min(size - 1, Math.floor((pixel - origin) / CELL)));\n  }\n\n  const column = (x: number) => cellIndex(x, plot.x, columns);\n  const row = (y: number) => cellIndex(y, plot.y, rows);\n  const cellFor = (x: number, y: number) => column(x) + columns * row(y);\n\n  function sourceRow(at: number): number {\n    const i = points[at]!;\n    return view.frame.series[series[at]!]!.row?.[i] ?? i;\n  }\n\n  function later(at: number, other: number): boolean {\n    const difference = sourceRow(at) - sourceRow(other);\n    if (difference !== 0) return difference > 0;\n    const cellDifference = cellFor(xs[at]!, ys[at]!) - cellFor(xs[other]!, ys[other]!);\n    return cellDifference < 0 || cellDifference === 0 && at > other;\n  }\n\n  view.frame.series.forEach((data, s) => {\n    if (!view.visible[s] || !data.drawable) return;\n    const { start, end } = view.visiblePoints[s]!;\n    for (let i = start; i < end; i++) {\n      const x = scatterPosition(projection.x, data.x[i]!);\n      const y = scatterPosition(projection.y, data.y[i]!);\n      if (!contains(plot, x, y)) continue;\n      const cell = cellFor(x, y);\n      const at = length++;\n      next[at] = heads.get(cell) ?? -1;\n      heads.set(cell, at);\n      xs[at] = x;\n      ys[at] = y;\n      series[at] = s;\n      points[at] = i;\n    }\n  });\n\n  const order = new Uint32Array(length);\n  const multiplicity = new Uint32Array(length);\n  const buckets = new Map<number, Bucket>();\n  function build(start: number, end: number, allowSkew = true): Bucket {\n    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;\n    let count = 0;\n    for (let i = start; i < end; i++) {\n      const p = order[i]!;\n      minX = Math.min(minX, xs[p]!);\n      maxX = Math.max(maxX, xs[p]!);\n      minY = Math.min(minY, ys[p]!);\n      maxY = Math.max(maxY, ys[p]!);\n      count += multiplicity[p]!;\n    }\n    const bounds = { start, end, count, minX, maxX, minY, maxY };\n    if (end - start <= LEAF_SIZE) return bounds;\n\n    const byX = maxX - minX >= maxY - minY;\n    const positions = byX ? xs : ys;\n    const pivot = byX ? minX / 2 + maxX / 2 : minY / 2 + maxY / 2;\n    let mid = start;\n    for (let i = start; i < end; i++) {\n      const p = order[i]!;\n      if (positions[p]! >= pivot) continue;\n      order[i] = order[mid]!;\n      order[mid++] = p;\n    }\n    const smaller = Math.min(mid - start, end - mid);\n    const skewed = smaller < (end - start) / 8;\n    // Keep spatially separated groups together. Consecutive skewed splits need a median to bound depth.\n    const useSkew = skewed && allowSkew && smaller > 0;\n    if (skewed && !useSkew) {\n      order.subarray(start, end).sort((a, b) => positions[a]! - positions[b]!);\n      mid = start + Math.floor((end - start) / 2);\n    }\n    return { ...bounds, left: build(start, mid, !useSkew), right: build(mid, end, !useSkew) };\n  }\n\n  let end = 0;\n  for (const [cell, head] of heads) {\n    const start = end;\n    let uniform = true;\n    for (let at = head; at >= 0; at = next[at]!) {\n      order[end++] = at;\n      uniform &&= xs[at] === xs[head] && ys[at] === ys[head];\n    }\n    if (!uniform) order.subarray(start, end).sort((a, b) => xs[a]! - xs[b]! || ys[a]! - ys[b]!);\n\n    // Group identical positions before splitting the cell, so a median cannot spread them across leaves.\n    // Keep the latest row as the representative and link the others for the capped tooltip.\n    let write = start;\n    for (let i = start; i < end;) {\n      const first = order[i]!;\n      const groupStart = i++;\n      let last = first;\n      let winner = first;\n      let beforeWinner = -1;\n      for (; i < end; i++) {\n        const at = order[i]!;\n        if (xs[at] !== xs[first] || ys[at] !== ys[first]) break;\n        next[last] = at;\n        if (later(at, winner)) {\n          winner = at;\n          beforeWinner = last;\n        }\n        last = at;\n      }\n      next[last] = -1;\n      if (beforeWinner >= 0) {\n        next[beforeWinner] = next[winner]!;\n        next[winner] = first;\n      }\n      multiplicity[winner] = i - groupStart;\n      order[write++] = winner;\n    }\n    end = write;\n    buckets.set(cell, build(start, end));\n  }\n\n  return {\n    series, points,\n    // Count individual distance checks and rows visited while sampling tooltip refs.\n    get examined() { return examined; },\n    get cellsExamined() { return cellsExamined; },\n    pick(x: number, y: number) {\n      examined = 0;\n      cellsExamined = 0;\n      if (!contains(plot, x, y)) return null;\n      const radius = CELL + COINCIDENT;\n      const left = column(x - radius);\n      const right = column(x + radius);\n      const top = row(y - radius);\n      const bottom = row(y + radius);\n      const nearby: Bucket[] = [];\n      for (let cy = top; cy <= bottom; cy++) {\n        for (let cx = left; cx <= right; cx++) {\n          cellsExamined++;\n          const bucket = buckets.get(cx + cy * columns);\n          if (bucket) nearby.push(bucket);\n        }\n      }\n\n      let nearest = -1;\n      let best = RADIUS2;\n      function consider(at: number): void {\n        examined++;\n        const distance = (xs[at]! - x) ** 2 + (ys[at]! - y) ** 2;\n        if (distance < best || distance === best && (nearest < 0 || later(at, nearest))) {\n          nearest = at;\n          best = distance;\n        }\n      }\n      function search(bucket: Bucket, distance: number): void {\n        if (distance > best) return;\n        if (bucket.left && bucket.right) {\n          const left = distanceTo(bucket.left, x, y);\n          const right = distanceTo(bucket.right, x, y);\n          if (left <= right) {\n            search(bucket.left, left);\n            search(bucket.right, right);\n          } else {\n            search(bucket.right, right);\n            search(bucket.left, left);\n          }\n        } else {\n          for (let i = bucket.start; i < bucket.end; i++) consider(order[i]!);\n        }\n      }\n\n      nearby.sort((a, b) => distanceTo(a, x, y) - distanceTo(b, x, y));\n      for (const bucket of nearby) search(bucket, distanceTo(bucket, x, y));\n      if (nearest < 0) return null;\n\n      const px = xs[nearest]!;\n      const py = ys[nearest]!;\n      const hits = [nearest];\n      let count = 0;\n      function sample(head: number): void {\n        for (let at = head; at >= 0 && hits.length < POINT_LIMIT; at = next[at]!) {\n          examined++;\n          if (at !== nearest) hits.push(at);\n        }\n      }\n      function collect(bucket: Bucket): void {\n        if (distanceTo(bucket, px, py) > COINCIDENT2) return;\n        if (distanceAcross(bucket, px, py) <= COINCIDENT2) {\n          count += bucket.count;\n          for (let i = bucket.start; i < bucket.end && hits.length < POINT_LIMIT; i++) sample(order[i]!);\n        } else if (bucket.left && bucket.right) {\n          collect(bucket.left);\n          collect(bucket.right);\n        } else {\n          for (let i = bucket.start; i < bucket.end; i++) {\n            const at = order[i]!;\n            examined++;\n            if ((xs[at]! - px) ** 2 + (ys[at]! - py) ** 2 <= COINCIDENT2) {\n              count += multiplicity[at]!;\n              sample(at);\n            }\n          }\n        }\n      }\n      // The same cell set covers every possible 0.5 px neighbourhood of the nearest point.\n      for (const bucket of nearby) collect(bucket);\n      return { hits, count };\n    },\n  };\n}\n124:| I1 | Pointing anywhere in the plot shows what is there, by the picking rule for the chart type (section 3.6), within one frame at the 95th percentile. On line, area and bar the tooltip lists every visible series at the nearest x; a series with no row at that x reads \"No observation\", distinct from \"No data\". The tooltip stays inside the viewport, does not cover the active mark, can itself be hovered, and lists at most eight rows plus \"+N more\". When it cannot fit, the same content appears in a fixed readout under the plot. Escape closes it until the pointer reaches a different datum. | Hover at 20 positions including all four edges; sparse-series fixture; narrow tile with eight series; Escape test | R15 |\nimport { SLOT_NULL, SLOT_VALUE } from '../core/contracts';\nimport type { AlignedView, DatumRef, DatumText, Formatters, Lookup, SlotState } from '../core/contracts';\nimport type { Messages } from '../public';\nimport { clipBox, contains, pointBox, type PlotLayout } from './geometry';\nimport { lowerBound, pageDistance } from './search';\nimport { incomplete, slotText } from './text';\n\nconst TOOLTIP_LIMIT = 8;\n\nfunction clamp(n: number, lo: number, hi: number): number {\n  return Math.max(lo, Math.min(hi, n));\n}\n\nexport function alignedLookup(view: AlignedView, layout: PlotLayout | null, formatters: Formatters, messages: Messages): Lookup {\n  const { frame, visibleSlots: { start, end }, stack } = view;\n  const positions = frame.x.values;\n  const visible = frame.series.flatMap((series, s) => view.visible[s] && series.drawable ? [s] : []);\n  const keys = new Map(frame.series.map((series, s) => [series.key, s]));\n  const projection = layout?.projection;\n  const xScale = projection?.kind === 'xy' ? projection.x : projection?.kind === 'bands' ? projection.band : null;\n\n  function ref(s: number, i: number): DatumRef {\n    return { kind: 'aligned', seriesKey: frame.series[s]!.key, x: positions[i]! };\n  }\n\n  function index(x: number): number {\n    const i = lowerBound(positions, x);\n    return positions[i] === x ? i : -1;\n  }\n\n  function isValue(s: number, i: number): boolean {\n    return frame.series[s]!.slot[i] === SLOT_VALUE;\n  }\n\n  function seek(s: number, i: number, delta: 1 | -1, lo = start, hi = end): number {\n    for (; i >= lo && i < hi; i += delta) if (isValue(s, i)) return i;\n    return -1;\n  }\n\n  function first(): DatumRef | null {\n    let earliest = end;\n    let series = -1;\n    for (const s of visible) {\n      const i = seek(s, start, 1, start, earliest);\n      if (i >= 0) {\n        earliest = i;\n        series = s;\n      }\n    }\n    return series < 0 ? null : ref(series, earliest);\n  }\n\n  function write(s: number, i: number, announce = false): DatumText {\n    const series = frame.series[s]!;\n    const state = series.slot[i] as SlotState;\n    const value = slotText(formatters, s, series.y[i]!, state);\n    return {\n      ref: ref(s, i), seriesIndex: s, seriesLabel: series.label, x: formatters.x(positions[i]!),\n      value: announce && stack?.incomplete?.[i] && visible.includes(s) ? incomplete(value, messages) : value,\n      state, percent: null, row: series.row?.[i] ?? i,\n    };\n  }\n\n  function primary(i: number): DatumRef | null {\n    if (i < start || i >= end) return null;\n    const s = visible.find(s => isValue(s, i)) ?? visible[0];\n    return s === undefined ? null : ref(s, i);\n  }\n\n  function resolve(datum: DatumRef): DatumRef | null {\n    if (datum.kind !== 'aligned') return null;\n    const s = keys.get(datum.seriesKey);\n    if (s === undefined) return null;\n    const i = lowerBound(positions, datum.x);\n    const inView = i >= start && i < end && positions[i] === datum.x;\n    if (!view.visible[s] || !frame.series[s]!.drawable) {\n      return inView && !view.visible[s] ? primary(i) : null;\n    }\n    if (inView) return datum;\n    const next = seek(s, Math.max(i, start), 1);\n    const replacement = next >= 0 ? next : seek(s, Math.min(i - 1, end - 1), -1);\n    return replacement < 0 ? null : ref(s, replacement);\n  }\n\n  function nearestSlot(pixel: number): number {\n    if (!xScale || start === end) return -1;\n    const x = xScale.invert(pixel);\n    if (xScale.type === 'band') return x >= start && x < end ? x : -1;\n    const right = lowerBound(positions, x, start, end);\n    if (right === start) return start;\n    if (right === end) return end - 1;\n    // Use screen distances for the final comparison because inversion can round at a midpoint.\n    const leftPixel = xScale.map(positions[right - 1]!);\n    const rightPixel = xScale.map(positions[right]!);\n    const midpoint = leftPixel / 2 + rightPixel / 2;\n    return (leftPixel <= rightPixel ? pixel >= midpoint : pixel <= midpoint) ? right : right - 1;\n  }\n\n  return {\n    pick(px, py) {\n      if (!layout || !visible.length || !contains(layout.plot, px, py)) return null;\n      const i = nearestSlot(projection?.kind === 'bands' && projection.horizontal ? py : px);\n      return i < 0 ? null : { kind: 'x', x: positions[i]! };\n    },\n    tooltip(target) {\n      const i = target.kind === 'x' ? index(target.x) : -1;\n      if (i < start || i >= end) return { title: '', rows: [], count: 0, total: null };\n      let total: string | null = null;\n      if (stack && stack.order.length) {\n        let sum = 0;\n        let hasValue = false;\n        for (const s of stack.order) {\n          if (!isValue(s, i)) continue;\n          sum += frame.series[s]!.y[i]!;\n          hasValue = true;\n        }\n        total = hasValue ? formatters.value(stack.order[0]!, sum) : formatters.missing(SLOT_NULL);\n        if (hasValue && stack.incomplete?.[i]) total = incomplete(total, messages);\n      }\n      return {\n        title: formatters.x(positions[i]!), rows: visible.slice(0, TOOLTIP_LIMIT).map(s => write(s, i)),\n        count: visible.length, total,\n      };\n    },\n    primary(target) {\n      return target.kind === 'x' ? primary(index(target.x)) : null;\n    },\n    datum(datum) {\n      if (datum.kind !== 'aligned') return null;\n      const s = keys.get(datum.seriesKey);\n      const i = index(datum.x);\n      return s === undefined || i < 0 ? null : write(s, i, true);\n    },\n    anchor(datum) {\n      if (datum.kind !== 'aligned' || !layout || !projection || !xScale) return null;\n      const s = keys.get(datum.seriesKey);\n      const i = index(datum.x);\n      const lane = s === undefined ? -1 : visible.indexOf(s);\n      if (s === undefined || lane < 0 || i < start || i >= end) return null;\n      const value = frame.series[s]!.y[i]!;\n      const present = isValue(s, i);\n      const accumulated = stack?.order.indexOf(s) ?? -1;\n      const side = value < 0 ? stack?.negative : stack?.positive;\n      const top = accumulated < 0 ? value : side![accumulated]![i]!;\n      if (projection.kind === 'xy') {\n        if (!present) return null;\n        const x = xScale.type === 'band' ? xScale.center(datum.x) : xScale.map(datum.x);\n        const y = projection.y.map(top);\n        return contains(layout.plot, x, y) ? pointBox(x, y) : null;\n      }\n      if (projection.kind !== 'bands') return null;\n      const horizontal = projection.horizontal;\n      const { plot } = layout;\n      const low = horizontal ? plot.y : plot.x;\n      const high = low + (horizontal ? plot.height : plot.width);\n      const center = xScale.type === 'band' ? xScale.center(datum.x) : xScale.map(datum.x);\n      let half: number;\n      if (xScale.type === 'band') {\n        half = xScale.bandwidth / 2;\n      } else {\n        const adjacent = i > 0 ? Math.abs(center - xScale.map(positions[i - 1]!)) : Infinity;\n        const following = i + 1 < positions.length ? Math.abs(xScale.map(positions[i + 1]!) - center) : Infinity;\n        const spacing = Math.min(adjacent, following);\n        // Continuous bars use their closest neighbour to leave a gap on both sides of a mark.\n        half = 0.4 * (Number.isFinite(spacing) && spacing > 0 ? spacing : high - low);\n      }\n      const bandStart = clamp(center - half, low, high);\n      const part = (clamp(center + half, low, high) - bandStart) / (stack ? 1 : vis