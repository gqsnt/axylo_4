xis;\n    }\n    if (!supportsSteps(axis)) return false;\n    const before = history.get(key)!;\n    const previousStep = step(before);\n    const oldAbsent = absent(before, previousStep);\n    const oldSparse = tooSparse(oldAbsent, before.differences + 1);\n    const delta = stepDelta(axis, position, next);\n    const multiple = stepMultiple(delta, before.min);\n    let after = { ...before, span: before.span - delta, differences: before.differences - 1,\n      matches: before.matches - Number(multiple === 1) };\n    if (!after.matches || !multiple || before.multiple === null) after = readCadence(axis, window);\n    history.set(key, after);\n    const currentStep = step(after);\n    const newAbsent = absent(after, currentStep);\n    const newSparse = tooSparse(newAbsent, after.differences + 1);\n    if (oldSparse && newSparse) {\n      reportGaps(diagnostics, this.fields.x.field, false, null, axis, this.label(key), newAbsent, key);\n      return false;\n    }\n    if (oldSparse) diagnostics.evictSeries(key);\n    return (oldAbsent !== 0 || newAbsent !== 0) &&\n      (previousStep !== currentStep || oldSparse !== newSparse || !newSparse && multiple > 1 && next > first);\n  }\n\n  private trim(keep: number): boolean {\n    const { buffers, diagnostics, calendar, observations, modes, votes, parser, dateUnits } = this.state;\n    let update = false;\n    const priorModes = new Map(Array.from(modes, ([field, counts]) => [field, mode(counts)]));\n    let categories = 0;\n    let remove = buffers.distinct - keep;\n    let first = buffers.start;\n    while (remove > 0 && first < buffers.end) remove -= buffers.observed[first++]!;\n    while (first < buffers.end && !buffers.observed[first]) first++;\n    const firstX = buffers.x[first] ?? Infinity;\n    const discard = (row: number, column: boolean, placed = true) => {\n      diagnostics.evict(row, false);\n      calendar?.evictRow(row);\n      const x = this.rows.read(row, this.fields.x.field);\n      if (votes && (this.fields.series === null || nameOf(this.rows.read(row, this.fields.series)) !== null)) {\n        if (x != null && x !== '' && !(column && Number.isNaN(x))) votes[kindOf(x) ?? 'category']--;\n      }\n      if (!placed) return;\n      if (dateUnits) dateUnits[dateUnitOf(x)]--;\n      for (const [field, counts] of modes) {\n        const kind = valueMode(this.rows.read(row, field), column);\n        if (kind !== 'empty') counts[kind]--;\n      }\n    };\n    buffers.trim(keep, (position, observed) => {\n      diagnostics.evict(position, true);\n      if (!observed) return;\n      if (parser.kind === 'category') categories++;\n      calendar?.evictPosition(position);\n      for (const [key, window] of observations) {\n        update = this.evictObservation(key, window, position, firstX) || update;\n      }\n      this.rows.evictRead(position, discard);\n    });\n    buffers.shrink();\n    if (buffers.distinct === 0) buffers.series.clear();\n    this.rows.trimUnplacedRead(keep, firstX, buffers.distinct, (row, column) => discard(row, column, false));\n    if (categories) parser.evictCategories(categories);\n    for (const [field, counts] of modes) {\n      if (priorModes.get(field) === 'other' && mode(counts) === 'decimal') update = true;\n    }\n    if (dateUnits) {\n      const precision = dateUnits.day ? 'day' : dateUnits.month ? 'month' : dateUnits.year ? 'year' : null;\n      if (precision === null) parser.restore(parser.categoryCount, null);\n      else if (precision !== parser.dateUnit) update = true;\n    }\n    const inferred = votes && preferredKind(votes);\n    return update || Boolean(inferred && inferred !== parser.kind);\n  }\n\n  append(rows: readonly unknown[], options: { keep?: number } = {}, sink = this.sink): AlignedFrame {\n    if (retention(options) !== undefined) {\n      const prepared = this.prepareAppend(rows, options);\n      for (const diagnostic of prepared.callDiagnostics) sink.add(diagnostic);\n      prepared.commit();\n      return prepared.frame;\n    }\n    this.prepare(rows, options, sink).commit();\n    return this.current;\n  }\n\n  private appendInPlace(rows: readonly unknown[], options: StoreAppendOptions, sink: DiagnosticSink, preview = false): AlignedFrame {\n    const { parser, buffers } = this.state;\n    const categoryCount = parser.categoryCount;\n    const dateUnit = parser.dateUnit;\n    const keep = retention(options);\n    const version = { epoch: this.current.epoch, revision: this.current.revision + 1 };\n3:import { lowerBound } from '../lookup/search';\n154:      const points = lowerBound(draft.x.view(), first);\n159:      draft.missingX.drop(lowerBound(draft.missingX.view(), first));\naligned.test.ts\ndonut.test.ts\nfixtures.ts\nscatter.test.ts\nimport fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport type { DatumRef, PointFrame, Rect } from '../../src/core/contracts';\nimport { buildLookup } from '../../src/lookup';\nimport { scatterLookup } from '../../src/lookup/scatter';\nimport { defaultMessages } from '../../src/messages';\nimport { linearScale } from '../../src/scale';\nimport { LATENCY } from '../browser/acceptance/fixtures';\nimport { formatter, frame, plot, scatter } from './fixtures';\n\nconst point = (seriesKey: string, row: number, x: number): Extract<DatumRef, { kind: 'point' }> =>\n  ({ kind: 'point', seriesKey, row, x });\n\nfunction points(lists: readonly (readonly (readonly [number, number])[])[]): PointFrame {\n  let row = 0;\n  return {\n    shape: 'points', epoch: 1, revision: 1, source: { rowAt: () => null },\n    xKind: 'number', timeZone: null, xLabel: 'x', yLabel: 'y', xUnit: null, yUnit: null,\n    series: lists.map((list, s) => {\n      const sorted = list.map(([x, y]) => ({ x, y, row: row++ })).sort((a, b) => a.x - b.x || a.y - b.y || a.row - b.row);\n      return {\n        key: `S${s}`, label: `S${s}`, drawable: true, x: Float64Array.from(sorted, p => p.x),\n        y: Float64Array.from(sorted, p => p.y), row: Int32Array.from(sorted, p => p.row),\n      };\n    }),\n  };\n}\nconst layout = plot({ kind: 'xy', x: linearScale([0, 100], [0, 100]), y: linearScale([0, 100], [0, 100]) });\n\nfunction scatterLayout(rect: Rect, xDomain: readonly [number, number], yDomain: readonly [number, number]) {\n  return {\n    ...plot({\n      kind: 'xy',\n      x: linearScale(xDomain, [rect.x, rect.x + rect.width]),\n      y: linearScale(yDomain, [rect.y + rect.height, rect.y]),\n    }, rect.x + rect.width + 4, rect.y + rect.height + 4),\n    plot: rect,\n  };\n}\n\nfunction clamp(value: number, low: number, high: number): number {\n  return Math.max(low, Math.min(high, value));\n}\n\nit('picks the nearest point within 24 px and breaks a tie by later source row', () => {\n  const data = frame('scatter', { data: [{ x: 60, y: 50 }, { x: 40, y: 50 }], x: 'x', y: 'y' });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const tie = model.pick(50, 50)!;\n  expect(tie).toEqual({ kind: 'point', refs: [point('y', 1, 40)], count: 1 });\n  expect(model.primary(tie)).toEqual(point('y', 1, 40));\n  expect(model.tooltip(tie)).toMatchObject({ title: '40', count: 1, total: null, rows: [{ seriesLabel: 'y', x: '40', value: '50', row: 1 }] });\n  expect(model.anchor(point('y', 1, 40))).toEqual({ x: 40, y: 50, width: 0, height: 0 });\n  expect(model.pick(16, 50)).toEqual({ kind: 'point', refs: [point('y', 1, 40)], count: 1 });\n  expect(model.pick(15.99, 50)).toBeNull();\n  expect(model.pick(58, 50)).toEqual({ kind: 'point', refs: [point('y', 0, 60)], count: 1 });\n});\n\nit.each([\n  { x: 68.4, y: 12.4, width: 827.6, height: 674.35 },\n  { x: 68.375, y: 12.375, width: 647.625, height: 340 },\n])('picks the latency fixture on each edge and corner of a $width × $height plot', rect => {\n  const corners = [\n    { size: 10, latency: 140, region: 'NW' }, { size: 35, latency: 140, region: 'NE' },\n    { size: 10, latency: 90, region: 'SW' }, { size: 35, latency: 90, region: 'SE' },\n  ];\n  const data = frame('scatter', { data: [...LATENCY.points, ...corners], x: 'size', y: 'latency', series: 'region' });\n  const view = scatter(data, { xDomain: [10, 35], yDomain: [90, 140] });\n  const model = buildLookup(view, scatterLayout(rect, view.xDomain, view.yDomain), formatter(data), defaultMessages);\n  const { x: left, y: top, width, height } = rect;\n  const right = left + width;\n  const bottom = top + height;\n  const probes = [\n    [point('EU', 1, 20), left + (10 / 25) * width, top],\n    [point('US', 3, 15), left + (5 / 25) * width, bottom],\n    [point('EU', 0, 10), left, top + (20 / 50) * height],\n    [point('US', 5, 35), right, top + (45 / 50) * height],\n    [point('NW', 6, 10), left, top], [point('NE', 7, 35), right, top],\n    [point('SW', 8, 10), left, bottom], [point('SE', 9, 35), right, bottom],\n  ] as const;\n  for (const [ref, x, y] of probes) {\n    for (const [dx, dy] of [[0, 0], [10, 0], [-10, 0], [0, 12], [0, -12], [10, 12], [-10, -12]] as const) {\n      const target = model.pick(clamp(x + dx, left, right), clamp(y + dy, top, bottom));\n      expect(target, JSON.stringify({ ref, dx, dy })).toEqual({ kind: 'point', refs: [ref], count: 1 });\n    }\n    expect(model.anchor(ref)).toMatchObject({ x: expect.closeTo(x, 10), y: expect.closeTo(y, 10) });\n  }\n  expect(model.pick(left - 1, top)).toBeNull();\n});\n\nit('indexes the rounded right and bottom edges in the same cells it searches', () => {\n  const extent = 192 - 2 ** -45;\n  const rect = { x: 72, y: 72, width: extent, height: extent };\n  const data = points([[[0, 0], [1, 0.5], [0.5, 0.5], [0.5, 0]]]);\n  const model = buildLookup(scatter(data), scatterLayout(rect, [0, 1], [0, 1]), formatter(data), defaultMessages);\n  const right = rect.x + rect.width;\n  const bottom = rect.y + rect.height;\n  for (const [x, y, ref] of [\n    [right, rect.y + 96, point('S0', 1, 1)],\n    [rect.x + 96, bottom, point('S0', 3, 0.5)],\n    [right - 10, rect.y + 96, point('S0', 1, 1)],\n    [rect.x + 96, bottom - 10, point('S0', 3, 0.5)],\n  ] as const) {\n    expect(model.pick(x, y)).toEqual({ kind: 'point', refs: [ref], count: 1 });\n  }\n});\n\nit('agrees with a brute-force scatter pick anywhere within radius of a drawn point', () => {\n  const fraction = fc.oneof(fc.constant(0), fc.constant(1), fc.integer({ min: 0, max: 1024 }).map(n => n / 1024));\n  const fractions = fc.array(fc.tuple(fraction, fraction), { minLength: 1, maxLength: 42 });\n  const extent = fc.oneof(fc.constant(192 - 2 ** -45), fc.integer({ min: 80, max: 1200 }).map(n => n / 2));\n  const offset = fc.tuple(fc.integer({ min: -24, max: 24 }), fc.integer({ min: -24, max: 24 }))\n    .filter(([x, y]) => x * x + y * y <= 24 ** 2);\n  fc.assert(fc.property(\n    fc.tuple(fc.integer({ min: -120, max: 128 }), fc.integer({ min: -120, max: 128 }), extent, extent),\n    fractions, fractions, fc.nat(), offset,\n    ([left, top, width, height], a, b, seed, [dx, dy]) => {\n      const right = left + width;\n      const bottom = top + height;\n      const toPixels = ([x, y]: readonly [number, number]) => [left + x * width, top + y * height] as const;\n      const series = [a.map(toPixels), b.map(toPixels)];\n      let row = 0;\n      const drawn = series.flatMap((list, s) => list.map(([x, y]) => ({ x, y, ref: point(`S${s}`, row++, x) })));\n      const witness = drawn[seed % drawn.length]!;\n      const px = clamp(witness.x + dx, left, right);\n      const py = clamp(witness.y + dy, top, bottom);\n      const ranked = drawn.map(d => ({ ...d, distance: (d.x - px) ** 2 + (d.y - py) ** 2 }))\n        .sort((a, b) => a.distance - b.distance || b.ref.row - a.ref.row);\n      const nearest = ranked[0]!;\n      fc.pre(nearest.distance <= 24 ** 2);\n      const coincident = drawn.filter(d => (d.x - nearest.x) ** 2 + (d.y - nearest.y) ** 2 <= 0.5 ** 2);\n      const x = { ...linearScale([left, right], [left, right]), map: (p: number) => p };\n      const y = { ...linearScale([top, bottom], [top, bottom]), map: (p: number) => p };\n      const data = points(series);\n      const layout = { ...plot({ kind: 'xy', x, y }), plot: { x: left, y: top, width, height } };\n      const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n      const target = model.pick(px, py);\n      if (target?.kind !== 'point') throw new Error('Expected scatter target within 24 px');\n      expect(target.refs[0]).toEqual(nearest.ref);\n      expect(target.count).toBe(coincident.length);\n      expect(target.refs).toHaveLength(Math.min(8, coincident.length));\n      expect(new Set(target.refs.map(ref => ref.kind === 'point' && ref.row)).size).toBe(target.refs.length);\n      expect(coincident.map(d => d.ref)).toEqual(expect.arrayContaining([...target.refs]));\n    },\n  ), { numRuns: 1_500 });\n});\n\nit('finds coincident points across a cell boundary and retains the full count after truncation', () => {\n  const points = Array.from({ length: 10 }, (_, i) => ({ x: i % 2 ? 24.1 : 23.9, y: 50, series: `S${i}` }));\n  const input = { x: 'x', y: 'y', series: 'series' };\n  const small = frame('scatter', { ...input, data: points.slice(0, 3) });\n  const all = buildLookup(scatter(small), layout, formatter(small), defaultMessages).pick(23.9, 50)!;\n  expect(all.kind).toBe('point');\n  if (all.kind !== 'point') throw new Error('Expected scatter target');\n  expect(all.count).toBe(3);\n  expect(all.refs[0]).toEqual(point('S2', 2, 23.9));\n  expect(all.refs).toEqual(expect.arrayContaining([point('S0', 0, 23.9), point('S1', 1, 24.1), point('S2', 2, 23.9)]));\n\n  const data = frame('scatter', { ...input, data: [...points, { x: 24.7, y: 50, series: 'Different' }] });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const target = model.pick(24.1, 50)!;\n  expect(target).toMatchObject({ kind: 'point', count: 10 });\n  expect(model.primary(target)).toEqual(point('S9', 9, 24.1));\n  expect(model.tooltip(target).rows).toHaveLength(8);\n  expect(model.tooltip(target).count).toBe(10);\n  expect(model.tooltip(target).rows.some(row => row.seriesLabel === 'Different')).toBe(false);\n});\n\nit('keeps the earliest of ten coincident rows addressable when a pointer pick omits it', () => {\n  const data = frame('scatter', { x: 'x', y: 'y', series: 's',\n    data: Array.from({ length: 10 }, (_, i) => ({ x: 20, y: 40, s: `S${i}` })),\n  });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const earliest = point('S0', 0, 20);\n  expect(model.step(null, 'first')).toEqual(earliest);\n  expect(model.resolve(earliest)).toBe(earliest);\n  expect(model.ordinal(earliest)).toBe(0);\n  expect(model.datum(earliest)).toMatchObject({ ref: earliest, seriesLabel: 'S0', x: '20', value: '40', row: 0 });\n  expect(model.anchor(earliest)).toEqual({ x: 20, y: 40, width: 0, height: 0 });\n  const picked = model.pick(20, 40);\n  if (picked?.kind !== 'point') throw new Error('Expected scatter target');\n  expect(picked.count).toBe(10);\n  expect(picked.refs).toHaveLength(8);\n  expect(picked.refs).not.toContainEqual(earliest);\n  expect(model.tooltip(picked)).toMatchObject({ count: 10 });\n});\n\nit('uses screen distance when moving to the neighbouring visible series', () => {\n  const data = frame('scatter', { x: 'x', y: 'y', series: 'series', data: [\n    { x: 10, y: 30, series: 'A' }, { x: 11, y: 31, series: 'Hidden' },\n    { x: 10, y: 80, series: 'B' }, { x: 12, y: 31, series: 'B' },\n  ] });\n  const model = buildLookup(scatter(data, { visible: [true, false, true] }), layout, formatter(data), defaultMessages);\n  expect(model.count).toBe(3);\n  expect(model.step(point('A', 0, 10), 'next')).toEqual(point('B', 2, 10));\n  expect(model.step(point('A', 0, 10), 'series-next')).toEqual(point('B', 3, 12));\n  expect(model.step(point('B', 3, 12), 'series-previous')).toEqual(point('A', 0, 10));\n});\n\nit('examines only nearby cells on a 200,000-point pick', () => {\n  const size = 200_000;\n  const x = Float64Array.from({ length: size }, (_, i) => i);\n  const y = Float64Array.from(x, i => i % 521);\n  const data = frame('scatter', { data: { columns: { x, y } }, x: 'x', y: 'y' });\n  const projection = { kind: 'xy', x: linearScale([0, size - 1], [0, 1200]), y: linearScale([0, 520], [520, 0]) } as const;\n  const model = scatterLookup(scatter(data), plot(projection, 1200, 520), formatter(data));\n  const i = 98_765;\n  expect(model.primary(model.pick(projection.x.map(i), 520 - (i % 521))!)).toEqual(point('y', i, i));\n  expect(model.lastPickCandidates).toBeGreaterThan(0);\n  expect(model.lastPickCandidates).toBeLessThan(5_000);\n});\nimport type { DatumRef, Formatters, Lookup } from '../core/contracts';\nimport type { Messages } from '../public';\n\nconst chartSummary = '{type} chart with {seriesCount} series. {xLabel} from {xMin} to {xMax}.';\nconst fullChartSummary = chartSummary + ' {yLabel} from {yMin} to {yMax}.';\nconst donutSlice = '{label}: {value} ({percent}).';\n\nexport const defaultMessages: Messages = {\n  viewAsTable: 'View as table',\n  hideTable: 'Hide table',\n  noData: 'No data',\n  noObservation: 'No observation',\n  incompleteStack: 'incomplete',\n  moreRows: '+{count} more',\n  otherSlices: 'Other ({count})',\n  valuesNotShown: 'Values not shown: {count}. {seeTable}',\n  valuesChanged: 'Values shown differently from the data: {count}. {seeTable}',\n  labelsHidden: 'Some labels hidden. {seeTable}',\n  loading: 'Loading chart.',\n  empty: 'No data to show.',\n  error: 'The chart could not be drawn.',\n  internalError: 'Something went wrong while drawing the chart.',\n  chartName: '{type} chart of {y} by {x}',\n  chartSummary: fullChartSummary,\n  seriesSummary: '{series}: minimum {min}, maximum {max}, last {last}.',\n  // Deprecated. Retained for callers with an existing override.\n  referenceSummary: 'Reference: {label}.',\n  timeZoneNote: 'Times are shown in {zone}.',\n  plotLabel: 'Chart plot',\n  controlsLabel: 'Chart controls',\n  pointOf: '{series}, {x}, {value}. Point {index} of {count}.',\n  zoomIn: 'Zoom in',\n  zoomOut: 'Zoom out',\n  resetZoom: 'Reset zoom',\n  pause: 'Pause',\n  resume: 'Resume',\n  previousPage: 'Previous page',\n  nextPage: 'Next page',\n  pageOf: 'Page {page} of {count}',\n  jumpToX: 'Jump to {x}',\n  showSeries: 'Show {series}',\n  hideSeries: 'Hide {series}',\n  category: 'Category',\n  percentage: 'Percentage',\n  series: 'Series',\n  value: 'Value',\n  typeLine: 'Line',\n  typeArea: 'Area',\n  typeBar: 'Bar',\n  typeScatter: 'Scatter',\n  typeDonut: 'Donut',\n  donutSummary: '{type} chart with {count} slices. Total {total}.',\n  seriesNoData: '{series}: no data.',\n  seriesNotDrawn: '{series} could not be drawn. {seeTable}',\n  referenceLine: 'Reference line {label} at {from}.',\n  referenceBand: 'Reference band {label} from {from} to {to}.',\n  plotRole: '{type} chart',\n  pointAll: '{x}. {values}. {position}',\n  seriesValue: '{series} {value}',\n  position: 'Point {index} of {count}',\n  total: 'Total',\n  panLeft: 'Pan left',\n  panRight: 'Pan right',\n  jumpNotFound: 'No row matches {x}. Example: {example}',\n  plotInstructions: 'Left and right arrows move between points, up and down between series, and Enter selects. Plus and minus zoom; 0 resets.',\n  seeTable: 'See table.',\n  totalMixed: '{positive} and {negative}',\n  incompleteAt: '{label}: incomplete at {positions}.',\n  incompleteCount: '{label}: {count} incomplete stacks.',\n};\n\nexport function fill(template: string, values: Readonly<Record<string, string | number>>): string {\n  return template.replace(/\\{(\\w+)\\}/g, (placeholder: string, name: string) =>\n    Object.hasOwn(values, name) ? String(values[name]) : placeholder,\n  );\n}\n\nexport function resolveMessages(overrides?: Partial<Messages> | null): Messages {\n  const messages = { ...defaultMessages };\n  for (const key of Object.keys(messages) as (keyof Messages)[]) {\n    messages[key] = overrides?.[key] ?? messages[key];\n  }\n  return messages;\n}\n\nexport function fillChartSummary(\n  template: string, values: Readonly<Record<string, string>>, range: { readonly yMin: string; readonly yMax: string } | null,\n): string {\n  if (range) return fill(template, { ...values, ...range });\n  // When a translation uses the same placeholders, omit the sentence that would describe the missing range.\n  const withoutRange = template === fullChartSummary ? chartSummary\n    : template.match(/[^.!?。！？]+[.!?。！？]*|[.!?。！？]+/gu)?.filter(part => !/\\{y(?:Min|Max)\\}/.test(part)).join('').trim();\n  return fill(withoutRange || chartSummary, values);\n}\n\nexport function fillDonutSlice(label: string, value: string, percent: string): string {\n  return fill(donutSlice, { label, value, percent });\n}\n\nexport function pointOf(lookup: Lookup, ref: DatumRef, formatters: Formatters, messages: Messages): string | null {\n  const ordinal = lookup.ordinal(ref);\n  if (ordinal < 0) return null;\n  const datum = lookup.datum(ref);\n  if (!datum) return null;\n  return fill(messages.pointOf, {\n    series: datum.seriesLabel, x: datum.x, value: datum.value,\n    index: formatters.count(ordinal + 1), count: formatters.count(lookup.count),\n  });\n}\n      'AX112', 'hint', 'none', 'day', 1, [0], 'Include a UTC offset or Z');\n  });\n\n  it('AX120 identifies negative donut values', () => {\n    const diagnostic = check('donut', { data: [{ day: 'Mon', value: -1 }], label: 'day', value: 'value' }).diagnostics.inputs()[0];\n    expectDiagnostic(diagnostic, 'AX120', 'error', 'chart-error', 'value', 1, [0], 'Supply non-negative values');\n  });\n\n  it('AX143 keeps general label-fitting advice and suggests horizontal bars for vertical category bars', () => {\n    const diagnostic = createDiagnostic('AX143', 'none', { field: 'day', count: 4 }, 'presentation');\n    expect(diagnostic.message).toContain('Give the plot more room or shorten the labels.');\n    expect(diagnostic.message).toMatch(/for vertical bars with category labels, .*horizontal bars/i)