{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/data/store-buffers.ts && cat packages/axylo/src/data/store-rows.ts'","aggregated_output":"import { BufferWindow } from './store-window';\nimport { SLOT_NO_ROW, type AlignedFrame, type RowSource, type Series, type XColumn } from '../core/contracts';\n\ninterface OpenSlot {\n  readonly index: number;\n  exposed: boolean;\n  changed: boolean;\n}\n\ntype SeriesDescription = Omit<Series, 'y' | 'slot' | 'row'>;\nexport interface SeriesBuffers {\n  description: SeriesDescription;\n  y: Float64Array;\n  slot: Uint8Array;\n  row: Int32Array;\n  tail?: OpenSlot;\n}\n\nfunction buffers(description: SeriesDescription, capacity: number): SeriesBuffers {\n  return { description, y: new Float64Array(capacity), slot: new Uint8Array(capacity), row: new Int32Array(capacity) };\n}\n\nexport class FrameBuffers {\n  x: Float64Array;\n  observed: Uint8Array;\n  private categoryPositions = new Float64Array();\n  readonly series = new Map<string, SeriesBuffers>();\n  private range: BufferWindow;\n\n  get start(): number { return this.range.start; }\n  get end(): number { return this.range.end; }\n  set end(end: number) { this.range.end = end; }\n  distinct: number;\n\n  constructor(frame?: AlignedFrame, positions?: Float64Array, order: Int32Array | null = null) {\n    this.range = new BufferWindow(0, frame?.length ?? 0);\n    this.distinct = 0;\n    const capacity = Math.max(16, this.end * 2);\n    this.x = new Float64Array(capacity);\n    this.observed = new Uint8Array(capacity);\n    if (!frame || !positions) return;\n    this.x.set(frame.x.values);\n    let slot = 0;\n    const length = order?.length ?? positions.length;\n    for (let i = 0; i < length; i++) {\n      const x = positions[order?.[i] ?? i]!;\n      while (slot < this.end && this.x[slot]! < x) slot++;\n      if (slot < this.end && this.x[slot] === x && !this.observed[slot]) {\n        this.observed[slot] = 1;\n        this.distinct++;\n      }\n    }\n    for (const { row, slot, y, ...description } of frame.series) {\n      const series = buffers(description, capacity);\n      series.y.set(y);\n      series.slot.set(slot);\n      if (row) series.row.set(row);\n      else for (let i = 0; i < this.end; i++) series.row[i] = i;\n      this.series.set(description.key, series);\n    }\n  }\n\n  fork(): FrameBuffers {\n    const draft = Object.assign(Object.create(FrameBuffers.prototype) as FrameBuffers, this, {\n      range: this.range.fork(),\n      series: new Map(Array.from(this.series, ([key, series]) => [key, { ...series }])),\n    });\n    return draft;\n  }\n\n  reserve(extra: number): boolean {\n    const capacity = this.range.reserve(extra, this.x.length);\n    if (capacity) this.resize(capacity, extra);\n    return capacity !== 0;\n  }\n\n  shrink(): void {\n    const capacity = this.range.compact(this.x.length);\n    if (capacity) this.resize(capacity, 0);\n  }\n\n  private resize(capacity: number, extra: number): void {\n    const { start, end } = this;\n    const x = new Float64Array(capacity);\n    const observed = new Uint8Array(capacity);\n    x.set(this.x.subarray(start, end));\n    observed.set(this.observed.subarray(start, end));\n    this.x = x;\n    this.observed = observed;\n    if (this.categoryPositions.length > capacity) this.categoryPositions = new Float64Array();\n    for (const [key, previous] of this.series) {\n      const series = buffers(previous.description, capacity);\n      series.y.set(previous.y.subarray(start, end));\n      series.slot.set(previous.slot.subarray(start, end));\n      series.row.set(previous.row.subarray(start, end));\n      this.series.set(key, series);\n    }\n    this.range.rebase(extra);\n  }\n\n  copySeries(series: SeriesBuffers): SeriesBuffers {\n    const copy = buffers(series.description, this.x.length);\n    const { start, end } = this;\n    copy.y.set(series.y.subarray(start, end), start);\n    copy.slot.set(series.slot.subarray(start, end), start);\n    copy.row.set(series.row.subarray(start, end), start);\n    this.series.set(series.description.key, copy);\n    return copy;\n  }\n\n  writeTail(series: SeriesBuffers, prepared: boolean): SeriesBuffers {\n    if (prepared || series.tail?.exposed) return this.copySeries(series);\n    if (series.tail) series.tail.changed = true;\n    series.tail = undefined;\n    return series;\n  }\n\n  addSeries(description: SeriesDescription, zero: boolean): SeriesBuffers {\n    const series = buffers(description, this.x.length);\n    series.row.fill(-1, this.start, this.end);\n    if (!zero) {\n      series.y.fill(NaN, this.start, this.end);\n      series.slot.fill(SLOT_NO_ROW, this.start, this.end);\n    }\n    this.series.set(description.key, series);\n    return series;\n  }\n\n  trim(keep: number | undefined, evict: (x: number, observed: boolean) => void): void {\n    if (keep === undefined || keep >= this.distinct) return;\n    while (this.start < this.end && (this.distinct > keep || !this.observed[this.start])) {\n      const observed = this.observed[this.start] === 1;\n      if (observed) this.distinct--;\n      evict(this.x[this.start]!, observed);\n      this.range.start++;\n    }\n  }\n\n  frame(previous: AlignedFrame, axis: XColumn, source: RowSource, open: (key: string) => boolean): AlignedFrame {\n    const { start, end } = this;\n    let positions = this.x.subarray(start, end);\n    if (axis.kind === 'category' && positions[0]) {\n      if (this.categoryPositions.length < positions.length) {\n        const capacity = Math.max(16, positions.length * 2);\n        this.categoryPositions = Float64Array.from({ length: capacity }, (_, i) => i);\n      }\n      positions = this.categoryPositions.subarray(0, positions.length);\n    }\n    return {\n      ...previous, source, revision: previous.revision, length: end - start,\n      x: {\n        values: positions, kind: axis.kind, dateUnit: axis.dateUnit,\n        timeZone: axis.timeZone, ordered: axis.ordered,\n        get categories() { return axis.kind === 'category' && end === start ? [] : axis.categories; },\n      },\n      series: Array.from(this.series.values(), series => {\n        const { description, y, slot, row } = series;\n        if (start === end || !open(description.key)) {\n          return { ...description, y: y.subarray(start, end), slot: slot.subarray(start, end), row: row.subarray(start, end) };\n        }\n        const index = end - 1;\n        if (series.tail?.index !== index) series.tail = { index, exposed: false, changed: false };\n        const tail = series.tail;\n        // Keep open slots cheap to read. A writer can reuse an unexposed slot, and the\n        // older frame then reconstructs that column only if someone opens it later.\n        const tailY = y[index]!;\n        const tailSlot = slot[index]!;\n        const tailRow = row[index]!;\n        let values: Float64Array | undefined;\n        let states: Uint8Array | undefined;\n        let rows: Int32Array | undefined;\n        return {\n          ...description,\n          get y() { return values ??= readColumn(y, tail, start, end, tailY); },\n          get slot() { return states ??= readColumn(slot, tail, start, end, tailSlot); },\n          get row() { return rows ??= readColumn(row, tail, start, end, tailRow); },\n        };\n      }),\n    };\n  }\n}\n\nfunction readColumn<T extends Float64Array | Uint8Array | Int32Array>(\n  data: T, tail: OpenSlot, start: number, end: number, value: number,\n): T {\n  if (!tail.changed) {\n    tail.exposed = true;\n    return data.subarray(start, end) as T;\n  }\n  const snapshot = data.slice(start, end) as T;\n  snapshot[snapshot.length - 1] = value;\n  return snapshot;\n}\nimport type { RowSource } from '../core/contracts';\nimport { StoreMap } from './store-map';\nimport { columnsTable, rowValue, type Columns, type Table } from './table';\n\nconst blockSize = 256;\n\nclass RawRows {\n  constructor(\n    private readonly objects = new StoreMap<number, unknown>(),\n    private readonly columns = new StoreMap<number, Table>(),\n    private readonly references = new Map<string, StoreMap<number, object>>(),\n  ) {}\n\n  fork(): RawRows {\n    const references = new Map(Array.from(this.references, ([field, entries]) => [field, entries.fork()]));\n    return new RawRows(this.objects.fork(), this.columns.fork(), references);\n  }\n\n  commit(): void {\n    this.objects.commit();\n    this.columns.commit();\n    for (const entries of this.references.values()) entries.commit();\n  }\n\n  get size(): number { return this.objects.size + this.columns.size; }\n\n  load(table: Table): void {\n    if (!table.columns || table.length === 0) {\n      for (let i = 0; i < table.length; i++) this.objects.set(i, table.rowAt(i));\n      return;\n    }\n    const columns = table.columns;\n    const keys = Object.keys(columns);\n    // Evicting a block must release its buffers even if another block from the source survives.\n    for (let start = 0; start < table.length; start += blockSize) {\n      const end = Math.min(start + blockSize, table.length);\n      const block: Columns = Object.fromEntries(keys.map(key => [key, this.columnSlice(columns[key]!, key, start, end)]));\n      const range = columnsTable(block, end - start);\n      for (let i = start; i < end; i++) this.columns.set(i, range);\n    }\n  }\n\n  private columnSlice(column: ArrayLike<unknown>, field: string, start: number, end: number): ArrayLike<unknown> {\n    if (ArrayBuffer.isView(column) && 'BYTES_PER_ELEMENT' in column) {\n      // Some typed-array subclasses implement slice as a view onto the caller's buffer.\n      return Uint8Array.prototype.slice.call(column, start, end);\n    }\n    return Array.from({ length: end - start }, (_, i) => {\n      const value = column[start + i];\n      if (value === null || typeof value !== 'object' && typeof value !== 'function') return value;\n      // A partly retained block may keep primitive values, but an object belongs to one row.\n      this.reference(field, start + i, value);\n      return undefined;\n    });\n  }\n\n  private reference(field: string, row: number, value: object): void {\n    let entries = this.references.get(field);\n    if (!entries) this.references.set(field, entries = new StoreMap());\n    entries.set(row, value);\n  }\n\n  append(start: number, rows: readonly unknown[]): void {\n    for (let i = 0; i < rows.length; i++) this.objects.set(start + i, rows[i]);\n  }\n\n  copy(row: number, target: RawRows): boolean {\n    const columns = this.columns.get(row);\n    if (columns) {\n      target.columns.set(row, columns);\n      for (const [field, entries] of this.references) {\n        const value = entries.get(row);\n        if (value !== undefined) target.reference(field, row, value);\n      }\n    } else if (this.objects.has(row)) target.objects.set(row, this.objects.get(row));\n    else return false;\n    return true;\n  }\n\n  forget(row: number): void {\n    this.objects.delete(row);\n    if (this.columns.has(row)) {\n      this.columns.delete(row);\n      for (const entries of this.references.values()) entries.delete(row);\n    }\n  }\n\n  read(row: number, field: string): unknown {\n    const range = this.columns.get(row);\n    return range ? this.references.get(field)?.get(row) ?? range.read(row % blockSize, field) : rowValue(this.objects.get(row), field);\n  }\n\n  rowAt(row: number): unknown {\n    const range = this.columns.get(row);\n    if (!range) return this.objects.has(row) ? this.objects.get(row) : null;\n    if (this.references.size === 0) return range.rowAt(row % blockSize);\n    return Object.fromEntries(range.keys().map(field => [field, this.read(row, field)]));\n  }\n\n  isColumn(row: number): boolean {\n    return this.columns.has(row);\n  }\n\n  keysAt(row: number): readonly string[] {\n    return this.columns.get(row)?.keys() ?? Object.keys(Object(this.objects.get(row)));\n  }\n\n  hasField(row: number, field: string): boolean {\n    return this.columns.get(row)?.hasField(field) ?? Object.hasOwn(Object(this.objects.get(row)), field);\n  }\n\n  indexes(start: number, incoming: number): Int32Array {\n    const indexes = new Int32Array(this.size + incoming);\n    let i = 0;\n    for (const row of this.columns.keys()) indexes[i++] = row;\n    for (const row of this.objects.keys()) indexes[i++] = row;\n    for (let j = 0; j < incoming; j++) indexes[i++] = start + j;\n    return indexes;\n  }\n}\n\ntype Discard = (row: number, column: boolean) => void;\n\nexport class StreamRows {\n  private retained = new RawRows();\n  private positions = new StoreMap<number, number>();\n  private previousAtPosition = new StoreMap<number, number>();\n  private unplaced = new StoreMap<number, number>();\n  private latestPosition = -Infinity;\n  onForget?: (row: number) => void;\n  next: number;\n\n  constructor(table?: Table) {\n    if (table) this.retained.load(table);\n    this.next = table?.length ?? 0;\n  }\n\n  get size(): number { return this.retained.size; }\n\n  fork(): StreamRows {\n    const draft = new StreamRows();\n    draft.retained = this.retained.fork();\n    draft.positions = this.positions.fork();\n    draft.previousAtPosition = this.previousAtPosition.fork();\n    draft.unplaced = this.unplaced.fork();\n    draft.latestPosition = this.latestPosition;\n    draft.next = this.next;\n    return draft;\n  }\n\n  commit(): void {\n    this.retained.commit();\n    this.positions.commit();\n    this.previousAtPosition.commit();\n    this.unplaced.commit();\n  }\n\n  record(position: number, row: number): void {\n    if (!Number.isFinite(position)) {\n      this.unplaced.set(row, this.latestPosition);\n      return;\n    }\n    this.latestPosition = Math.max(position, this.latestPosition);\n    const previous = this.positions.get(position);\n    if (previous !== undefined) this.previousAtPosition.set(row, previous);\n    this.positions.set(position, row);\n  }\n\n  resetPositions(table: Table, positions: Float64Array): void {\n    this.positions = new StoreMap();\n    this.previousAtPosition = new StoreMap();\n    this.unplaced = new StoreMap();\n    this.latestPosition = -Infinity;\n    for (let i = 0; i < table.length; i++) this.record(positions[i] ?? NaN, table.rowIndex(i));\n  }\n\n  append(rows: readonly unknown[]): void {\n    this.retained.append(this.next, rows);\n    this.next += rows.length;\n  }\n\n  forget(row: number): void {\n    this.onForget?.(row);\n    this.retained.forget(row);\n  }\n\n  evictRead(position: number, discard?: Discard): void {\n    let row = this.positions.get(position);\n    while (row !== undefined) {\n      const previous = this.previousAtPosition.get(row);\n      this.previousAtPosition.delete(row);\n      discard?.(row, this.retained.isColumn(row));\n      this.forget(row);\n      row = previous;\n    }\n    this.positions.delete(position);\n  }\n\n  trimUnplacedRead(keep: number, first: number, observed: number, discard: Discard): void {\n    // Invalid records need a bounded home even when every new record is unplaceable.\n    const capacity = observed ? 2 * keep : keep;\n    for (const [row, position] of this.unplaced) {\n      if (this.unplaced.size <= capacity && (!observed || position >= first)) break;\n      this.unplaced.delete(row);\n      discard(row, this.retained.isColumn(row));\n      this.forget(row);\n    }\n  }\n\n  read(row: number, field: string): unknown {\n    return this.retained.read(row, field);\n  }\n\n  rowAt(row: number): unknown {\n    return this.retained.rowAt(row);\n  }\n\n  source(): RowSource {\n    return new FrameSource(this.next, this);\n  }\n\n  archive(row: number, target: RawRows): boolean {\n    return this.retained.copy(row, target);\n  }\n\n  table(incoming: readonly unknown[] = []): Table {\n    const retained = this.retained;\n    const first = this.next;\n    const indexes = retained.indexes(first, incoming.length);\n    return {\n      length: indexes.length, columns: null,\n      read: (i, field) => {\n        const row = indexes[i]!;\n        return row < first ? retained.read(row, field) : rowValue(incoming[row - first], field);\n      },\n      rowIndex: i => indexes[i]!,\n      isColumnRow: i => retained.isColumn(indexes[i]!),\n      rowAt: i => {\n        const row = indexes[i]!;\n        return row < first ? retained.rowAt(row) : incoming[row - first];\n      },\n      hasField: field => indexes.some(row => row < first ? retained.hasField(row, field) : Object.hasOwn(Object(incoming[row - first]), field)),\n      keys: () => {\n        const keys = new Set<string>();\n        for (const row of indexes) {\n          const fields = row < first ? retained.keysAt(row) : Object.keys(Object(incoming[row - first]));\n          for (const field of fields) keys.add(field);\n        }\n        return [...keys];\n      },\n    };\n  }\n}\n\nexport class FrameSource implements RowSource {\n  private read: ((row: number) => unknown) | null;\n\n  constructor(private readonly end: number, rows: StreamRows, live: () => boolean = () => true) {\n    this.read = row => live() ? rows.rowAt(row) : null;\n  }\n\n  rowAt(row: number): unknown {\n    return Number.isInteger(row) && row >= 0 && row < this.end && this.read ? this.read(row) : null;\n  }\n\n  bind(read: (row: number) => unknown): void {\n    this.read = read;\n  }\n\n  release(): void {\n    this.read = null;\n  }\n}\n\nexport class RowWindow {\n  private readonly archived = new RawRows();\n  private readonly lastSeen = new Map<number, number>();\n  private readonly evictions = new Map<number, number[]>();\n  private readonly sources = new Map<number, FrameSource>();\n  private latestRevision = -Infinity;\n  private latestEnd = 0;\n  private rows: StreamRows | null;\n  private closed = false;\n\n  constructor(rows: StreamRows) {\n    this.rows = rows;\n  }\n\n  get size(): number { return (this.rows?.size ?? 0) + this.archived.size; }\n  get disposable(): boolean { return this.closed && this.sources.size === 0; }\n\n  archive(row: number): void {\n    const revision = this.latestRevision;\n    // Newly appended rows can be evicted before any accepted frame has addressed them.\n    if (!this.sources.has(revision) || row >= this.latestEnd || !this.rows?.archive(row, this.archived)) return;\n    this.lastSeen.set(row, revision);\n    let indexes = this.evictions.get(revision);\n    if (!indexes) this.evictions.set(revision, indexes = []);\n    indexes.push(row);\n  }\n\n  publish(revision: number, source: FrameSource, rows: StreamRows): void {\n    this.rows = rows;\n    this.latestRevision = revision;\n    this.latestEnd = rows.next;\n    this.sources.set(revision, source);\n    source.bind(row => {\n      const last = this.lastSeen.get(row);\n      return last === undefined ? this.rows?.rowAt(row) : revision <= last ? this.archived.rowAt(row) : null;\n    });\n  }\n\n  close(): void {\n    this.closed = true;\n    if (this.sources.size === 0) this.rows = null;\n  }\n\n  retire(revision: number): void {\n    for (const [number, source] of this.sources) {\n      if (number > revision) break;\n      source.release();\n      this.sources.delete(number);\n    }\n    for (const [number, indexes] of this.evictions) {\n      if (number > revision) break;\n      for (const row of indexes) {\n        this.archived.forget(row);\n        this.lastSeen.delete(row);\n      }\n      this.evictions.delete(number);\n    }\n    if (this.closed && this.sources.size === 0) this.rows = null;\n  }\n}\n\nexport class RowRevisions {\n  private readonly windows = new Set<RowWindow>();\n  current: RowWindow;\n\n  constructor(rows: StreamRows) {\n    this.windows.add(this.current = new RowWindow(rows));\n  }\n\n  get size(): number {\n    let size = 0;\n    for (const window of this.windows) size += window.size;\n    return size;\n  }\n\n  replace(rows: StreamRows): void {\n    this.current.close();\n    if (this.current.disposable) this.windows.delete(this.current);\n    this.windows.add(this.current = new RowWindow(rows));\n  }\n\n  retire(revision: number): void {\n    for (const window of this.windows) {\n      window.retire(revision);\n      if (window.disposable) this.windows.delete(window);\n    }\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,45p;65,155p;587,660p' packages/axylo/src/core/contracts.ts && sed -n '230,254p' packages/axylo/src/core/controller.ts && sed -n '14,52p;214,254p' packages/axylo/src/dom/figure.ts && sed -n '90,107p;120,147p;235,255p' docs/02-product-spec.md && sed -n '169,204p' docs/03-plan-typescript-release.md && cat vitest.config.ts\"","aggregated_output":"/**\n * Internal contracts of Axylo. Every module is written against these types and against nothing else in\n * another module. Changing this file is an architecture change: it needs a reason recorded in the commit.\n *\n * Pipeline (docs/03-plan-typescript-release.md, section 2):\n *\n *   options ─► normalize ─► Frame ─┬─► View ─► Layout ─► Scene ─► MarkRenderer / TextLayer\n *                │ diagnostics      ├─► lookup (exact values)\n *                                   ├─► summary, table\n *                                   └─► focus model\n *\n * Rule that must never be broken: exact values, the table, keyboard navigation, tooltips, summaries and\n * events read the Frame. The Scene is geometry for drawing and may be simplified. Nothing reads values\n * back from the Scene.\n */\nimport type { Diagnostic, XValue } from '../public';\n\n// ───────────────────────────── diagnostics ─────────────────────────────\n\n/**\n * What a diagnostic did to the chart. Drives the reader's note (spec F12): only 'omitted' and 'changed'\n * count towards \"N values not shown\"; a warning about contrast or an unknown option does not.\n */\nexport type DiagnosticEffect = 'none' | 'omitted' | 'changed' | 'series-disabled' | 'chart-error';\n\n/** A diagnostic before the chart adds its own name. */\nexport type DiagnosticInput = Omit<Diagnostic, 'chart'> & {\n  readonly effect: DiagnosticEffect;\n  /**\n   * 'call': found while validating a create, update or append call; a `strict` chart throws from that call.\n   * 'presentation': found later (a contrast check after a CSS change, a formatter that throws on a lazily\n   * built table cell, a label that no longer fits after a resize); reported when found, never thrown.\n   */\n  readonly origin: 'call' | 'presentation';\n};\n\nexport interface DiagnosticSink {\n  /** Adds one diagnostic. The sink merges by code, field and effect: counts are added, example rows capped at 10. */\n  add(d: DiagnosticInput): void;\n}\n\n// ───────────────────────────── frame ─────────────────────────────\n\n/**\n * What an x value is.\n * `missing: 'zero'` on a value field is applied by normalization: slots that would be SLOT_NULL, SLOT_NO_ROW,\n * SLOT_GAP or SLOT_ABSENT_FIELD become SLOT_VALUE with y = 0 and row = -1. SLOT_INVALID is never turned into zero.\n */\n\n/** Half-open range of indexes. */\nexport interface IndexRange { readonly start: number; readonly end: number }\n\nexport interface XColumn {\n  readonly kind: XKind;\n  /** Strictly ascending positions, one per slot. For 'category': 0, 1, 2, … */\n  readonly values: Float64Array;\n  /** For 'category': the name of each position. Otherwise null. */\n  readonly categories: readonly string[] | null;\n  /** For 'time': the resolved IANA zone ('UTC', 'America/Los_Angeles', …; 'local' is resolved before it gets here). Otherwise null. */\n  readonly timeZone: string | null;\n  /** For 'date': the precision the values were written in ('2026-02' is a month); the finest one if they are mixed. Otherwise null. */\n  readonly dateUnit: 'day' | 'month' | 'year' | null;\n  /** For 'category': true when the author declared the categories ordered, so the axis may be thinned (spec L1). */\n  readonly ordered: boolean;\n}\n\n/** The caller's data behind a frame, for events and for the table's provenance. */\nexport interface RowSource {\n  /** The caller's row at a source index (materialized on demand for typed columns), or null if it is no longer retained. */\n  rowAt(sourceIndex: number): unknown;\n}\n\n/** One series of an aligned frame: a y value and a state for every x slot. */\nexport interface Series {\n  /** Stable identity: the series value (long form) or the field name (wide form). Used for colors and toggling. */\n  readonly key: string;\n  /** Name shown to the reader. */\n  readonly label: string;\n  /** The value field this series was read from, for diagnostics. */\n  readonly field: string;\n  readonly unit: string | null;\n  readonly valueScale: 'percent' | 'ratio' | null;\n  /** False when the series cannot be drawn (duplicate x, AX108). It stays in the frame so the table and summary can say so. */\n  readonly drawable: boolean;\n  /** y per slot. NaN wherever `slot` is not SLOT_VALUE. May be a view on the caller's typed column. */\n  readonly y: Float64Array | Float32Array;\n  readonly slot: Uint8Array;\n  /** Index of the caller's row each slot came from, -1 where there is none. null means \"slot i came from row i\" (typed columns). */\n  readonly row: Int32Array | null;\n}\n\n/** One series of a point frame (scatter): its own x and y, sorted by x then y. */\nexport interface PointSeries {\n  readonly key: string;\n  readonly label: string;\n  readonly drawable: boolean;\n  readonly x: Float64Array;\n  readonly y: Float64Array;\n  readonly row: Int32Array | null;\n  /**\n   * Observations that have a valid x and no plottable y: null, an absent field, or a value that cannot be\n   * plotted (the rows AX103 and AX106 report). Sorted by x, duplicates kept. They are not points: nothing is\n   * drawn or picked for them. They exist so the table can list them as \"No data\" (spec F2 and F12: the note\n   * sends the reader to the table, so the table must show every row that was left out). Absent or empty when\n   * there are none. With `missing: 'zero'` on the y field, null and absent values are points with y = 0 instead\n   * and do not appear here; a value that cannot be plotted is never imputed.\n   */\n  readonly missingX?: Float64Array;\n}\n\n/**\n * The normalized, lossless data. Immutable: an update or append produces a new frame with a higher revision.\n * Buffers may be shared between revisions; a streaming store appends into spare capacity and hands out\n * subarray views, so an append does not copy what is already there.\n */\ninterface FrameBase {\n  readonly revision: number;\n  /** Changes when the data is replaced or the encoding changes; survives append and eviction. A DatumRef is only meaningful within one epoch. */\n  readonly epoch: number;\n  readonly source: RowSource;\n}\n\nexport interface AlignedFrame extends FrameBase {\n  readonly shape: 'aligned';\n  readonly x: XColumn;\n  readonly series: readonly Series[];\n  /** Number of x slots. */\n  readonly length: number;\n  readonly xLabel: string;\n  readonly yLabel: string | null;\n}\n\nexport interface PointFrame extends FrameBase {\n  readonly shape: 'points';\n  readonly xKind: Exclude<XKind, 'category'>;\n  readonly timeZone: string | null;\n  | { readonly kind: 'point'; readonly seriesKey: string; /** source row index */ readonly row: number; /** x position, so a ref to an evicted point can resolve to its nearest surviving neighbour */ readonly x: number }\n  | { readonly kind: 'slice'; readonly sliceKey: string };\n\n/** What the pointer is over, by the picking rule of the chart type (spec 3.6). */\nexport type PickTarget =\n  | { readonly kind: 'x'; readonly x: number }                      // line, area, bar: every series at this x\n  | { readonly kind: 'point'; readonly refs: readonly DatumRef[]; readonly count: number }  // scatter: nearest point and those coinciding with it (at most 8; `count` is the full number)\n  | { readonly kind: 'slice'; readonly sliceKey: string };\n\n/** One row of a tooltip or one announced point, as text. All text comes from the frame through the formatters. */\nexport interface DatumText {\n  readonly ref: DatumRef;\n  readonly seriesIndex: number;\n  readonly seriesLabel: string;\n  /** x as the reader sees it. */\n  readonly x: string;\n  /** The value with its unit, or \"No data\" / \"No observation\". */\n  readonly value: string;\n  readonly state: SlotState;\n  /** Share of the whole for a donut slice, formatted; null elsewhere. */\n  readonly percent: string | null;\n  /** Source row index, or -1. */\n  readonly row: number;\n}\n\nexport interface TooltipModel {\n  /** Heading: the x value (with its time zone for instants), the category, or the slice label. */\n  readonly title: string;\n  /** At most eight rows (spec I1). */\n  readonly rows: readonly DatumText[];\n  /** Rows before truncation. */\n  readonly count: number;\n  /** Stack total with \"incomplete\" where it applies, already formatted; null when the chart does not stack. */\n  readonly total: string | null;\n}\n\nexport type StepDirection = 'next' | 'previous' | 'first' | 'last' | 'series-next' | 'series-previous' | 'page-next' | 'page-previous';\n\n/**\n * Exact answers from the frame for one view and projection, independent of how the scene was simplified.\n * Built once per (view, layout); cheap to build: binary search over x for aligned frames, a grid index for scatter.\n */\nexport interface Lookup {\n  /** What is under a pixel of the plot container, or null. */\n  pick(px: number, py: number): PickTarget | null;\n  tooltip(target: PickTarget): TooltipModel;\n  /** The datum to focus when the keyboard takes over from a pointer target. */\n  primary(target: PickTarget): DatumRef | null;\n  datum(ref: DatumRef): DatumText | null;\n  /** Where the datum is drawn, for the cursor and focus ring; null if it is not visible. */\n  anchor(ref: DatumRef): Rect | null;\n  /**\n   * Position for \"point 4 of 120\" (spec A3). Aligned charts: `count` is the number of visible x slots and\n   * `ordinal` the zero-based place of the datum's x among them, whatever its series and whether or not it\n   * holds a value (a \"No data\" slot has a place too). Scatter: place among all visible points in x then y\n   * order. Donut: slice order. -1 only when the datum is not in the current view.\n   */\n  readonly count: number;\n  ordinal(ref: DatumRef): number;\n  /** Keyboard order per chart type (spec 3.6). `from` null starts at the first datum. Skips hidden series. */\n  step(from: DatumRef | null, direction: StepDirection): DatumRef | null;\n  /**\n   * Where focus should be after the data or the view changed. A datum is \"there\" only if its series is\n   * visible and drawable and its x (or point) is inside the current view. If it is: itself. If its series is\n   * hidden but its x is in view: the primary datum at that x. Otherwise the nearest datum of its series in\n   * view after it, else before it; for a donut slice folded into \"Other\", the \"Other\" slice. Else null.\n   * `step` always starts from the resolved datum, so focus can never get stuck on something out of reach.\n   */\n  resolve(ref: DatumRef): DatumRef | null;\n}\n\n// ───────────────────────────── reader model ─────────────────────────────\n\n/** The table of spec A4, built lazily from the frame: nothing is materialized until a page is asked for. */\n/** Whether a window can be set on this frame's x axis: time, date and number axes only in 1.0 (spec I3). */\nfunction zoomable(frame: Frame): boolean {\n  return frame.shape === 'points' || (frame.shape === 'aligned' && frame.x.kind !== 'category');\n}\n\n/**\n * READER CALL SITE (review modules-codex, finding 5). The sentence for a series that could not be drawn,\n * by the reader's rule for `{seeTable}` (filled when the chart has a table; when it has none, removed with\n * the space before it only where the template has the placeholder; an override without it used as written).\n * This stands in for the reader's export of the same shape, which replaces it:\n *   seriesNotDrawnSentence(messages: Messages, series: string, table: boolean): string\n */\nfunction seriesNotDrawnSentence(messages: Messages, series: string, table: boolean): string {\n  const template = messages.seriesNotDrawn;\n  const seeTable = table ? messages.seeTable : '';\n  const text = fill(template, { series, seeTable });\n  return seeTable === '' && template.includes('{seeTable}') ? text.trimEnd() : text;\n}\n\nfunction isWall(frame: Frame): boolean {\n  return frame.shape === 'aligned' ? frame.x.kind === 'wall' : frame.shape === 'points' && frame.xKind === 'wall';\n}\n\nfunction latestX(frame: Frame): number {\n  if (frame.shape === 'aligned') return frame.x.values.length ? frame.x.values[frame.x.values.length - 1]! : NaN;\n  readonly visible: boolean;\n}\n\nexport interface NoteSegment {\n  readonly text: string;\n  readonly lang: string | null;\n}\n\nexport interface FigureModel {\n  readonly compact: boolean;\n  /** The heading, or null when there is none (only `labelledBy`, or no title at all). */\n  readonly title: TitleModel | null;\n  /** Id of a heading the page already has. */\n  readonly labelledBy: string | null;\n  /** Accessible name when neither a title nor `labelledBy` names the chart (generated, AX140). */\n  readonly name: string;\n  readonly subtitle: string | null;\n  readonly summary: string;\n  /** The plot is too small to draw (spec L8): the summary is shown instead. */\n  readonly summaryVisible: boolean;\n  readonly note: string | null;\n  /** Loading, empty, error or internal-error text shown inside the plot (spec L7); null when marks are shown. */\n  readonly message: string | null;\n  /**\n   * `lang` for the message and the note: 'en' when they show built-in English on a page in another\n   * language (spec A10), else null.\n   */\n  readonly messageLang?: string | null;\n  readonly noteLang?: string | null;\n  /**\n   * The note as runs of text, each with its own `lang` (A10: a sentence can mix built-in English and the\n   * author's text). When given, it is the note's content and `noteLang` is not used.\n   */\n  readonly noteSegments?: readonly NoteSegment[] | null;\n  /** `lang` of the generated summary: 'en' when its built-in sentences are English on another page (A10). */\n  readonly summaryLang?: string | null;\n}\n\nexport interface Figure {\n      summary.classList.toggle(HIDDEN, compact || !model.summaryVisible);\n      // Shown in the too-small state (spec L8) as one line (the stylesheet clips it after its first line), the\n      // whole text staying the figure's description for assistive technology.\n      setAttr(figure, 'aria-describedby', description.id);\n\n      // The compact variant has no note element: the summary says what was left out, and a corner marker\n      // shows it (spec C5); the marker's text equivalent is that description.\n      const segments = compact ? null : model.noteSegments ?? null;\n      if (segments && segments.length > 1) {\n        // Runs in their own languages: one span each, so assistive technology switches voice per run.\n        const signature = JSON.stringify(segments);\n        if (note.dataset.segments !== signature) {\n          note.replaceChildren(...segments.map((run, i) => {\n            const span = doc.createElement('span');\n            span.textContent = (i > 0 ? ' ' : '') + run.text;\n            if (run.lang !== null) span.setAttribute('lang', run.lang);\n            return span;\n          }));\n          note.dataset.segments = signature;\n        }\n        setAttr(note, 'lang', null);\n      } else {\n        delete note.dataset.segments;\n        if (note.firstElementChild) note.textContent = '';\n        setText(note, compact ? '' : segments?.[0]?.text ?? model.note ?? '');\n        setAttr(note, 'lang', segments ? segments[0]?.lang ?? null : model.noteLang ?? null);\n      }\n      setAttr(message, 'lang', model.messageLang ?? null);\n      show(note, !compact && model.note !== null);\n      show(corner, compact && model.note !== null);\n      setAttr(corner, 'title', compact ? model.note : null);\n\n      setText(message, model.message ?? '');\n      show(message, model.message !== null);\n      return moved;\n    },\n    announce(text: string, lang: string | null = null): void {\n      setAttr(live, 'lang', lang);\n      setText(live, text);\n    },\n    destroy(): void {\n### 3.1 Faithful representation\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| F1 | Bar and area value axes always include zero. An author `domain` that excludes zero is widened and raises AX110. | Property test on domains, including all-negative and mixed-sign data; `bars` fixture (values 82–97) starts at 0 | R1 |\n| F2 | Missing values are never drawn as zero and never bridged unless the author asks. An explicit `null` is a gap, silently. An isolated value between two gaps is a visible point. A missing bar shows a \"no data\" mark at the baseline, distinct from a zero bar. On a time or date axis with a regular step, an absent step is a gap and raises AX105; `missing: 'zero'` on the field turns absent and null values into zeros for counts. Tooltip, table and announcements say \"No data\". | `trend` with nulls and `trend` with the same 7 rows deleted render the same gap; `dirty` fixtures; property test that no segment connects across a missing index | R5 |\n| F3 | Input that cannot be plotted as given is reported, never guessed. The diagnostic registry (section 3.5) fixes each case's level, what is drawn and what the reader sees. | One test per code; the combined `dirty` fixture and the four one-bad-value fixtures yield exactly the codes listed in section 3.5 | R5, D5 |\n| F4 | Three temporal types, never mixed silently. **Calendar dates** (`2026-02-24`, `2026-02`, `2026`) read the same in every viewer time zone. **Instants** (epoch milliseconds declared `type: 'time'`, `Date` objects, ISO strings with an offset) are shown in `timeZone` (default: the viewer's), with the zone named in the tooltip heading and the description. **Wall-clock times** (date-time strings without an offset) are shown as written, with hint AX112. Instants that all fall on the same time of day, whole days apart, raise hint AX111 (\"these look like calendar dates\"). A bare number is never assumed to be an instant. | Four fixture variants in UTC, America/Los_Angeles and Asia/Kolkata: (a) date strings: identical text in all three; (b) ISO strings with `Z`, (c) epoch ms with `type: 'time'`, (d) `Date` objects: each zone's correct local text, zone visible, AX111 raised; with `timeZone: 'UTC'` or `type: 'date'`: identical. Plus: both DST transitions, a leap day, an unparseable date | R3 |\n| F5 | No smoothing. When a line is denser than the screen, the drawing is simplified with this guarantee: for every device-pixel column, and every contiguous run of valid samples inside it, the drawn stroke covers exactly that run's minimum and maximum. A break between two runs is always kept, even when both fall in one pixel column; a slot a series merely has no row for (weekly data beside daily) does not break its line. Stacked areas are simplified on their cumulative sums. Exact values always come from the data, not the drawing. | Assertions on which source samples the drawing kept, for: one outlier in 1,000,000; two peaks and a gap in one column; alternating valid and missing samples; tied extremes; device pixel ratio 1 and 2; several zoom levels. A sample that the drawing dropped is still reachable by keyboard and in the table | D8, D9 |\n| F6 | Numbers and dates are formatted for the page locale. Ticks and readouts are formatted separately: ticks may be compact (`50K`); tooltip, table and announcements show the full integer part, and the fraction with up to six significant digits not counting the fraction's leading zeros (`123,456.75`; `0.000123456`; `0.1 + 0.2` reads `0.3`), with the unit. A custom formatter that throws falls back to the default and raises a diagnostic. | Expected strings for chosen values (large integers, small decimals, percentages, zoned times) in `en-US`, `de-DE` and `en-IN` | R4 |\n| F7 | Domains follow one order of precedence: the zoomed view is inside the author's `domain` if given, otherwise inside the automatic domain. The automatic domain contains all data, reference lines and stack totals, and ends at the first tick at or beyond each extreme. A field declared `scale: 'percent'` (0–100) or `'ratio'` (0–1) ends at full scale only when its maximum is at least half of full scale and not above it. Nothing is inferred from a label. | Property tests; `bars` ends at 100 when declared `percent`; a 4% maximum ends at the first tick at or above 4% | R1 |\n| F8 | Donut: slices keep the given order, start at 12 o'clock and run clockwise. The legend shows every slice's value and percentage as text, in slice order. A zero slice is listed without an arc; a `null` slice is listed as \"No data\". A negative value is AX120 and the chart shows its error state. With more than eight slices that have an arc (a positive value), the seven largest are drawn and the rest of those are grouped as \"Other (n)\", with AX121; zero and `null` slices never count toward the limit and are never grouped, so each stays listed on its own; the table lists every category. Shares are shown with at most one fraction digit. An all-zero donut shows the empty state. | `parts` fixture; one test per case | R7, landscape scoreboard 3.1 |\n| F9 | Up to eight series, no two share a color. Beyond eight, each series still has a unique combination of color and dash or marker (for bars: color and fill pattern, which gives 32 distinct combinations; beyond 32 bar series combinations repeat), and AX130 is raised. | Tests with 6, 8 and 12 series | R7 |\n| F10 | Stacks place positive and negative values on their own sides of zero, and the axis covers both totals. The readout's total is the sum when every component has the same sign; when signs are mixed it gives the positive total and the negative total, the two ends the reader sees, not their net. A missing component is drawn with zero height and the stack is marked \"incomplete\" in tooltip, table and announcements. | Property test on stacked geometry; mixed-sign and incomplete fixtures | R5 |\n| F11 | Line, area and scatter are drawn in x order whatever the input order. On line, area and bar, two rows with the same x in one series are AX108 and that series is not drawn. On scatter, points sharing an x (or both coordinates) are ordinary data. | Shuffled `trend` renders identically; duplicate fixture | R5 |\n| F12 | When a warning means values were left out or changed, the chart says so to the reader: a short note (\"Values not shown: 2. See table.\", worded so it reads correctly for any count) inside the figure and in the accessibility tree, in every build. | Production build given `dirty` shows the note | R5, R6 |\n\n### 3.2 Legibility\n### 3.3 Interaction\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| I1 | Pointing anywhere in the plot shows what is there, by the picking rule for the chart type (section 3.6), within one frame at the 95th percentile. On line, area and bar the tooltip lists every visible series at the nearest x; a series with no row at that x reads \"No observation\", distinct from \"No data\". The tooltip stays inside the viewport, does not cover the active mark, can itself be hovered, and lists at most eight rows plus \"+N more\". When it cannot fit, the same content appears in a fixed readout under the plot. Escape closes it until the pointer reaches a different datum. | Hover at 20 positions including all four edges; sparse-series fixture; narrow tile with eight series; Escape test | R15 |\n| I2 | Legend entries are toggle buttons with a pressed state, operable by click, Enter and Space. | Keyboard and accessibility-tree tests | R12 |\n| I3 | Zoom on time, date and numeric x axes is reachable four ways: visible Zoom in, Zoom out and Reset buttons that work with single clicks; drag to select a range; `+`, `-`, `0` and Shift+arrows; and pinch when `zoom: 'touch'` is set. The wheel zooms only while the plot has focus, and never when Ctrl or Meta is held, so browser zoom and page scrolling are not intercepted. | Reach a given range by clicks only; by keyboard only; by drag; page scrolls normally with the pointer over an unfocused chart | D7, R12, WCAG 2.5.1, 2.5.7, 1.4.4 |\n| I4 | Every interaction works with a single pointer without dragging, and by touch. Every control is at least 24×24 CSS px. A one-finger drag on a chart scrolls the page. | Touch emulation; size checks | WCAG 2.5.7, 2.5.8 |\n| I5 | First render is not animated. An update may transition for at most 200 ms. Under `prefers-reduced-motion: reduce` nothing transitions, on first render or on update. | After `document.fonts.ready`: first frame equals the frame at 2.5 s within a 0.1% pixel tolerance, in both settings; an update under reduced motion reaches its final frame in one step; a 24-chart filter change settles within 200 ms | R14 |\n| I6 | A chart fed by `append` shows a Pause/Resume control. While paused, new rows are buffered and the view does not move. | Stream test | WCAG 2.2.2 |\n\n### 3.4 Accessibility\n\nTarget: every WCAG 2.2 level AA success criterion that applies to what Axylo renders, as component-level evidence. Conformance of a page is a property of the page and remains the author's.\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| A1 | Every chart has an accessible name: its `title`, or the heading named by `labelledBy`, or else a generated name (\"Line chart of Sessions by Day\") with AX140 raised in every build. The title's heading level is the author's (`level`), and it can be hidden visually. Every chart has a generated summary: type, series, x range with time zone, y range, each series' minimum, maximum and last value, and any omissions. `description` adds to the summary and never removes the zone or omission statements. Element ids are unique per chart. | Accessibility-tree snapshot for every fixture; a 24-chart page has no duplicate ids; axe `heading-order` | R11, R13 |\n| A2 | Keyboard: at most two tab stops while the table is closed, the plot and one toolbar with roving focus that holds legend toggles, zoom, pause and the table control. Every point is reachable in order; the series can be switched; the ends can be reached directly; focus can leave the chart. The focus indicator is at least 2 px and 3:1 and is not hidden by the tooltip. The exact keys and roles are fixed after the pattern spike in M1 (section 8). | Forward and reverse traversal in collapsed, zoomed, streaming and table-open states; focus after hiding the focused series; indicator contrast | R12 |\n| A3 | Moving focus to a point conveys its text (series, x, value with unit, position) through the focused element's accessible name or a polite live region. On touch screen readers, every point is reachable by swiping, or the table is reachable within two gestures. | Accessibility-tree snapshot after each key; a recorded rehearsal on NVDA with Chrome, NVDA with Firefox, VoiceOver with Safari on macOS, VoiceOver on iOS, and TalkBack with Chrome | R12, R13 |\n| A4 | \"View as table\" shows the data as an HTML table built from the normalized data when opened: the title as caption, field labels with units as column headers, x values as row headers, values formatted as in F6. It covers the current x range, 100 rows per page, with every row reachable by paging or by jumping to an x value. It sits in a focusable scroll region no taller than the plot, and opening it does not move other charts. | Table content compared with fixture data, including a value near row 900,000 of 1,000,000; a 24-chart page layout test | R13 |\n| A5 | Series are never distinguished by color alone, in any mode. Each line and area carries a shape marker at its last point and at sparse intervals, repeated in the legend and tooltip; under `prefers-contrast: more` or forced colors, lines also differ by dash. Adjacent filled marks (slices, stacked segments) are separated by at least 1 px of background. The default palette has eight colors, each at least 3:1 on the default light and dark backgrounds, with a minimum pairwise OKLab difference of 0.10 (provisional) under normal vision and simulated protanopia, deuteranopia and tritanopia. On any other background, Axylo measures the palette against the resolved background and raises AX141 below 3:1. | Palette script scoring the rendered marks of an eight-series chart in both schemes, repeats included; rendered-pixel checks of separators; a grayscale screenshot in which three crossing lines can be told apart by marker | R7, WCAG 1.4.1, 1.4.11 |\n| A6 | Content reflows at 320 CSS px and 400% zoom without two-dimensional scrolling. User text-spacing overrides do not clip text. | Viewport and style-override tests in three engines | WCAG 1.4.10, 1.4.12 |\n| A7 | Data arriving does not speak. Announcements happen only for the reader's own navigation, and for a change of state (L7). While data streams, keyboard focus stays on the same datum until it leaves the window. | Stream test counting live-region changes with and without focus; 24 concurrent streams | R12 |\n| A8 | axe-core reports no violations on any fixture in any state, including `heading-order` and `scrollable-region-focusable`. | CI | R11 |\n| A9 | A conformance table lists every applicable WCAG 2.2 AA success criterion, the test that covers it, and what the author must supply (a meaningful title or `labelledBy`, series names, units, the page's own structure). It also states the limits in section 3.8. | Published with each release; a CI check that every listed test exists | R11 |\n| A10 | Every built-in string can be replaced through `messages`. Built-in English text is marked `lang=\"en\"` when the document language is not English. | Test on a `lang=\"de\"` page | WCAG 3.1.2 |\n\n## 5. Performance budgets\n\nThese numbers are provisional. They are design targets taken from Phase 1's order-of-magnitude measurements, and they become release gates only after the benchmark harness built in M0 has measured a working Axylo slice in M1 and the limits have been recalibrated and frozen (plan, M1 and M6). Each budget names its workload, metric and statistic so that two people measuring the same build get the same verdict.\n\n| ID | Workload | Metric | Statistic | Provisional limit | Phase 1 reference |\n|---|---|---|---|---|---|\n| P1 | `trend` (3×120), default options, reference desktop | Main-thread task time from the call until the chart is complete | Median of 20 runs | 10 ms | Not comparable across libraries below about 35 ms with the Phase 1 method |\n| P2 | One series, 100,000 and 1,000,000 points, typed columns | Same | Median of 20 | 60 ms and 250 ms | See 01, section 5.3: uPlot and tuned Chart.js are the fastest measured |\n| P3 | 600-point window, one appended point per display frame at 60 Hz, driven by an independent clock | Main-thread task time per update (per run: task time in the window divided by the number of updates); and frames later than 25 ms | Median over runs; count per 300 frames | 2 ms; 0 | See 01, section 5.3 |\n| P4 | Pointer moved across a 100,000-point chart | Time from input to the frame showing the matching readout | 95th percentile | One frame (16.7 ms at 60 Hz) | Not measured in Phase 1 |\n| P5 | 24 `trend` charts created on one page, each tile 340 × 200 px | Total main-thread task time | Median of 20 | 200 ms | Not measured in Phase 1 |\n| P6 | Download | Minified and gzipped bytes, CSS included | Exact | DX7 | 01, section 1.4 |\n| P8 | 40 compact charts created on one page, each 160 × 48 px with one series | Total main-thread task time | Median of 20 | 80 ms | Not measured in Phase 1 |\n| P7 | Memory | Bytes owned by Axylo beyond the caller's columns for 1,000,000 points; heap trend over 1,000 create–destroy cycles | Measured after forced collection | At most 1× the size of the caller's two columns; no upward slope | Not measured in Phase 1 |\n\nThree rules hold whatever the numbers become:\n\n1. Budgets apply to default options. Finding D8 showed libraries that are fast only for authors who know which options to set.\n2. Budgets are absolute, on named hardware profiles. Comparison libraries, uPlot above all, are measured in the same runs and published beside Axylo, but a ratio to another library is not a gate: it would reward leaving out work that library does not do.\n3. The accessibility layer is on in every measured configuration.\n\n### 2.1 Pipeline\n\n```\noptions ─► normalize ─► frame ──┬─► view model ─► layout ─► scene ─► mark renderer\n            │ validate   (authoritative) │   scales, visible range         text renderer (DOM)\n            ▼ diagnostics                ├─► lookup: exact values by x, by point, by ordinal\n                                         ├─► summary and table\n                                         └─► focus model\n```\n\nThe **frame** is the normalized, lossless data: typed columns, a validity bitmap, dictionary-encoded categories, source-row indexes and a revision number. It is the only source for exact values. The table, the summary, keyboard navigation, tooltips and events read the frame. The **scene** is geometry for drawing and may be simplified (F5); nothing reads values back from it. The first draft derived accessibility from the scene, and two reviewers showed that a simplified drawing cannot return the samples it dropped.\n\n| Stage | Output | Notes |\n|---|---|---|\n| normalize | Frame, diagnostics | The only place raw input is read. Never coerces silently. |\n| view model | Scales, visible index ranges, series visibility | Domain rules implement F1 and F7. |\n| lookup | Nearest-x by binary search; nearest-point by a grid index (scatter) | Works on the frame within the visible range; cost bounded independently of the drawing. |\n| layout | Plot rectangle, tick sets, label boxes, legend and control placement | Implements L1, L3, L8. Takes a text-measurement interface as input. |\n| scene | Flat list of primitives (`path`, `rect`, `arc`, `rule`, `text`) | Plain data; testable in Node with injected text metrics. |\n| renderers | Marks; DOM text; accessibility DOM | See 2.3. |\n\n### 2.2 Invalidation\n\nStages are cached, and the cache keys are explicit. Caching on object identity alone, as the first draft said, would miss font loads, pixel-ratio changes and in-place mutation.\n\n| Stage | Reruns when |\n|---|---|\n| normalize | Data revision or field encoding changes. `append` extends the frame without renormalizing earlier rows. |\n| view model | Frame revision, zoom, series visibility, author domains. |\n| layout | View model; container size; resolved font and text spacing; `document.fonts` finishing a load; locale; any label text. A data-only update reruns layout when the tick labels would change, and skips it otherwise. |\n| scene | Layout or view model. |\n| mark raster | Scene; device pixel ratio; resolved colors (L4's triggers). |\n\nText is measured with the page's computed font, letter spacing and word spacing applied to the measuring context, and layout reruns when fonts finish loading. The measurement interface is a parameter, so Node tests inject fixed metrics and browser tests use the real one.\n\n### 2.3 Rendering\nimport { defineConfig } from 'vitest/config';\n\n// Unit and property tests run in Node. Browser tests (*.browser.test.ts) drive system Chrome through\n// Playwright against the built bundle: run `npm run build` first, then `npm run test:browser`.\nexport default defineConfig({\n  define: { __DEV__: 'true' },\n  test: {\n    include: process.env.AXYLO_BROWSER\n      ? ['packages/*/test/**/*.browser.test.ts', 'apps/docs/test/**/*.browser.test.ts', 'apps/docs/examples/node/*.test.ts']\n      : ['packages/*/test/**/*.test.ts', 'apps/docs/test/**/*.test.ts'],\n    exclude: process.env.AXYLO_BROWSER ? ['**/node_modules/**'] : ['**/node_modules/**', '**/*.browser.test.ts'],\n    testTimeout: process.env.AXYLO_BROWSER ? 60000 : 10000,\n    fileParallelism: !process.env.AXYLO_BROWSER,\n  },\n});\n","exit_code":0,"status":"completed"}}
