{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/data/streaming-storage.test.ts && cat packages/axylo/test/data/transactions.test.ts'","aggregated_output":"import fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { SLOT_VALUE, type Frame } from '../../src/core/contracts';\nimport { AlignedStore, DonutStore, PointStore, normalize, resolveOptions } from '../../src/data';\nimport { utc, version } from './helpers';\n\nconst quiet = { add() {} };\nconst types = ['line', 'scatter', 'donut'] as const;\ntype Kind = typeof types[number];\nfunction options(kind: Kind, data: unknown, y = 'y') {\n  return resolveOptions(kind, kind === 'donut' ? { data, label: 'label', value: y } :\n    { data, x: { field: 'x', type: 'number' }, y }, quiet);\n}\nfunction store(kind: Kind, data: unknown) {\n  const resolved = options(kind, data);\n  if (kind === 'scatter') return new PointStore(resolved, utc, version);\n  if (kind === 'donut') return new DonutStore(resolved, utc, version);\n  return AlignedStore.fromFrame(normalize('line', resolved, utc, quiet, version), resolved, data, utc);\n}\nfunction numericBuffers(frame: Frame): readonly ArrayBufferLike[] {\n  if (frame.shape === 'aligned') return [frame.x.values.buffer, frame.series[0]!.y.buffer];\n  if (frame.shape === 'points') return [frame.series[0]!.x.buffer, frame.series[0]!.y.buffer];\n  return [frame.values.buffer];\n}\nfunction row(x: number) {\n  return { x, label: String(x), y: x + 1, z: x + 2 };\n}\n\nfunction allocated<T>(action: () => T): { result: T; bytes: number } {\n  let bytes = 0;\n  const restore: (() => void)[] = [];\n  for (const name of ['Float64Array', 'Float32Array', 'Int32Array', 'Uint8Array'] as const) {\n    const original = globalThis[name];\n    // Species-based operations such as slice must go through the counter too.\n    const counted = new Proxy(original, {\n      construct(target, args, newTarget) {\n        const result = Reflect.construct(target, args, newTarget) as InstanceType<typeof original>;\n        if (!(args[0] instanceof ArrayBuffer) && !(args[0] instanceof SharedArrayBuffer)) bytes += result.byteLength;\n        return result;\n      },\n    });\n    Object.defineProperty(globalThis, name, { value: counted });\n    Object.defineProperty(original.prototype, 'constructor', { value: counted });\n    restore.push(() => {\n      Object.defineProperty(original.prototype, 'constructor', { value: original });\n      Object.defineProperty(globalThis, name, { value: original });\n    });\n  }\n  try {\n    const result = action();\n    return { result, bytes };\n  } finally {\n    restore.forEach(undo => undo());\n  }\n}\n\nasync function expectCollected(...refs: WeakRef<object>[]) {\n  const collect = globalThis.gc;\n  if (!collect) return;\n  for (let attempt = 0; attempt < 5; attempt++) {\n    // WeakRef keeps a dereferenced value alive only until the end of the job.\n    await new Promise<void>(resolve => setImmediate(resolve));\n    collect();\n    if (refs.every(ref => ref.deref() === undefined)) return;\n  }\n  expect(refs.map(ref => ref.deref() === undefined)).toEqual(refs.map(() => true));\n}\n\nfor (const kind of types) {\n  it(`${kind} shares numeric buffers during preparation and commit when there is spare capacity`, () => {\n    const size = kind === 'donut' ? 500 : 50_000;\n    const s = store(kind, Array.from({ length: size }, (_, i) => row(i)));\n    const initial = numericBuffers(s.frame);\n    const first = s.prepareAppend([row(size)]);\n    const firstBuffers = numericBuffers(first.frame);\n    first.commit();\n    const before = s.frame;\n    const original = numericBuffers(before);\n    const measured = allocated(() => {\n      const candidate = s.prepareAppend([row(size + 1)]);\n      const during = numericBuffers(candidate.frame);\n      expect(s.frame).toBe(before);\n      candidate.commit();\n      return during.filter((buffer, i) => original[i] !== buffer).length;\n    });\n    console.info(`${kind}: ${measured.result} replaced numeric buffers, ${measured.bytes} typed-array bytes per appended row`);\n    expect(measured.result).toBe(0);\n    firstBuffers.forEach((buffer, index) => expect(buffer).toBe(initial[index]));\n    expect(measured.bytes).toBeLessThan(256);\n  });\n\n  it.each(['keep', 'replace'] as const)(`${kind} releases caller columns after %s and retirement`, async operation => {\n    function setup() {\n      const x = Float64Array.from({ length: 300 }, (_, i) => i);\n      const y = Float64Array.from(x, i => i + 1);\n      const label = Array.from(x, String);\n      const refs = [new WeakRef(x), new WeakRef(y), new WeakRef(label)];\n      const s = store(kind, { columns: { x, y, label } });\n      const old = s.frame;\n      if (operation === 'keep') s.prepareAppend([row(300)], { keep: 2 }).commit();\n      else {\n        const data = [row(300)];\n        s.prepareReplace(data, options(kind, data), { revision: old.revision + 1, epoch: old.epoch + 1 }).commit();\n      }\n      expect(old.source.rowAt(0)).toEqual({ x: 0, y: 1, label: '0' });\n      s.retire(old.revision);\n      return { refs, s, old };\n    }\n    const { refs, s, old } = setup();\n    await expectCollected(...refs);\n    expect(old.source.rowAt(0)).toBeNull();\n    expect(s.retainedRowCount).toBe(operation === 'keep' ? 2 : 1);\n  });\n}\n\nfor (const kind of types) {\n  it(`${kind} releases an object in a partly retained column block`, async () => {\n    function setup() {\n      const payload = [{ note: 'dropped' }, { note: 'retained' }];\n      const ref = new WeakRef(payload[0]!);\n      const data = { columns: { x: Float64Array.of(0, 1), y: Float64Array.of(1, 2), label: ['0', '1'], payload } };\n      const s = store(kind, data);\n      const before = s.frame;\n      s.prepareAppend([row(2)], { keep: 2 }).commit();\n      expect(before.source.rowAt(0)).toMatchObject({ payload: payload[0] });\n      expect(s.frame.source.rowAt(1)).toMatchObject({ payload: payload[1] });\n      s.retire(before.revision);\n      return { ref, s, before };\n    }\n    const { ref, s, before } = setup();\n    await expectCollected(ref);\n    expect(before.source.rowAt(0)).toBeNull();\n    expect(s.frame.source.rowAt(0)).toBeNull();\n    expect(s.frame.source.rowAt(1)).toMatchObject({ payload: { note: 'retained' } });\n  });\n}\n\nit('releases the original backing buffer of a sliced Uint8Array subclass', async () => {\n  function setup() {\n    const bytes = Buffer.alloc(300, 2);\n    const ref = new WeakRef(bytes.buffer);\n    const data = { columns: { x: Float64Array.from(bytes, (_, i) => i), y: bytes } };\n    const s = store('line', data);\n    const old = s.frame;\n    s.prepareAppend([row(300)], { keep: 2 }).commit();\n    s.retire(old.revision);\n    return { ref, s };\n  }\n  const { ref, s } = setup();\n  await expectCollected(ref);\n  expect(s.frame.source.rowAt(299)).toEqual({ x: 299, y: 2 });\n});\n\ntype Entry = { index: number; row: Omit<ReturnType<typeof row>, 'y' | 'z'> & { y: number | null; z: number | null } };\ntype Snapshot = { frame: Frame; rows: readonly Entry[]; field: 'y' | 'z'; next: number; zero?: boolean };\n\nfunction checkFrame({ frame, rows, field, next, zero = false }: Snapshot, live: boolean) {\n  const indexes = rows.map(entry => entry.index);\n  const xs = rows.map(entry => entry.row.x);\n  const values = rows.map(entry => entry.row[field]);\n  if (frame.shape === 'aligned') {\n    expect(frame.length).toBe(rows.length);\n    expect([...frame.x.values]).toEqual(xs);\n    if (rows.length) {\n      expect([...frame.series[0]!.y]).toEqual(values);\n      expect([...frame.series[0]!.slot]).toEqual(values.map(() => SLOT_VALUE));\n      expect([...frame.series[0]!.row!]).toEqual(indexes);\n    }\n  } else if (frame.shape === 'points') {\n    const points = rows.filter(entry => zero || entry.row[field] !== null);\n    const missing = zero ? [] : rows.filter(entry => entry.row[field] === null);\n    expect([...frame.series[0]!.x]).toEqual(points.map(entry => entry.row.x));\n    expect([...frame.series[0]!.y]).toEqual(points.map(entry => entry.row[field] ?? 0));\n    expect([...frame.series[0]!.row!]).toEqual(points.map(entry => entry.index));\n    expect([...(frame.series[0]!.missingX ?? [])]).toEqual(missing.map(entry => entry.row.x));\n  } else {\n    expect([...frame.labels]).toEqual(rows.map(entry => entry.row.label));\n    expect([...frame.values]).toEqual(values);\n    expect([...frame.slot]).toEqual(values.map(() => SLOT_VALUE));\n    expect([...frame.row!]).toEqual(indexes);\n  }\n\n  let cursor = 0;\n  for (let i = 0; i <= next; i++) {\n    const entry = rows[cursor];\n    expect(frame.source.rowAt(i)).toBe(live && entry?.index === i ? entry.row : null);\n    if (entry?.index === i) cursor++;\n  }\n}\n\nconst count = fc.integer({ min: 0, max: 7 });\nconst operations = fc.array(fc.oneof(\n  fc.record({ operation: fc.constant('append' as const), count, keep: fc.option(count, { nil: undefined }) }),\n  fc.record({ operation: fc.constant('replace' as const), count, start: fc.integer({ min: -50, max: 50 }) }),\n  fc.record({ operation: fc.constant('reencode' as const), field: fc.constantFrom('y' as const, 'z' as const), zero: fc.boolean() }),\n  fc.record({ operation: fc.constant('retire' as const), back: count }),\n), { minLength: 1, maxLength: 35 });\n\nfor (const kind of types) {\n  it(`${kind} matches a row model across live revisions and bounds append allocations`, () => {\n    fc.assert(fc.property(operations, ops => {\n      const s = store(kind, []);\n      let field: Snapshot['field'] = 'y';\n      let zero = false;\n      let rows: Entry[] = [];\n      let next = 0;\n      let x = 0;\n      let retired = s.frame.revision - 1;\n      let appendBytes = 0;\n      let rowsAdded = 0;\n      let seededRows = 0;\n      let appends = 0;\n      const snapshots: Snapshot[] = [{ frame: s.frame, rows, field, next, zero }];\n      const observation = (x: number): Entry['row'] => {\n        const item = row(x);\n        return kind === 'scatter' ? { ...item, y: x % 3 === 0 ? null : item.y, z: x % 5 === 0 ? null : item.z } : item;\n      };\n      const encoding = (data: unknown) => zero ? resolveOptions('scatter', {\n        data, x: { field: 'x', type: 'number' }, y: { field, missing: 'zero' },\n      }, quiet) : options(kind, data, field);\n      for (const op of ops) {\n        const before = s.frame;\n        const revised = { revision: before.revision + 1, epoch: before.epoch + 1 };\n        if (op.operation === 'append') {\n          const incoming = Array.from({ length: op.count }, () => observation(x++));\n          rows = [...rows, ...incoming.map(item => ({ index: next++, row: item }))];\n          if (op.keep !== undefined) rows = rows.slice(Math.max(0, rows.length - op.keep));\n          const { result: prepared, bytes } = allocated(() => s.prepareAppend(incoming, { keep: op.keep }));\n          appendBytes += bytes;\n          rowsAdded += incoming.length;\n          appends++;\n          expect(s.frame).toBe(before);\n          checkFrame({ frame: prepared.frame, rows, field, next, zero }, true);\n          prepared.commit();\n        } else if (op.operation === 'replace') {\n          x = op.start;\n          next = 0;\n          const data = Array.from({ length: op.count }, () => observation(x++));\n          rows = data.map(item => ({ index: next++, row: item }));\n          seededRows += rows.length;\n          s.prepareReplace(data, encoding(data), revised).commit();\n        } else if (op.operation === 'reencode') {\n          field = op.field;\n          zero = kind === 'scatter' && op.zero;\n          seededRows += rows.length;\n          s.prepareReencode(encoding(rows.map(entry => entry.row)), revised).commit();\n        } else {\n          retired = Math.max(retired, before.revision - op.back);\n          s.retire(retired);\n        }\n        if (s.frame !== before) snapshots.push({ frame: s.frame, rows, field, next, zero });\n        const retained = new Set(rows.map(entry => entry.row));\n        for (const snapshot of snapshots) {\n          const live = snapshot.frame.revision > retired;\n          checkFrame(snapshot, live);\n          if (live) for (const entry of snapshot.rows) retained.add(entry.row);\n        }\n        expect(s.retainedRowCount).toBe(retained.size);\n      }\n\n      // Each append has fixed scratch space and per-row scratch columns. A doubling\n      // or a compaction pays for itself across the rows inserted, evicted, or seeded.\n      expect(appendBytes).toBeLessThanOrEqual(2_048 * appends + 384 * (rowsAdded + seededRows));\n    }), { numRuns: 1_000 });\n  });\n\n  it(`${kind} uses offset views while sliding a fixed window and bounds long-run allocations`, () => {\n    const size = 600;\n    const s = store(kind, Array.from({ length: size }, (_, i) => row(i)));\n    const first = s.frame;\n    const a = s.prepareAppend([row(size)], { keep: size });\n    numericBuffers(a.frame).forEach((buffer, i) => expect(buffer).toBe(numericBuffers(first)[i]));\n    a.commit();\n    s.retire(first.revision);\n    const updates = 2_000;\n    const { bytes } = allocated(() => {\n      for (let i = 1; i <= updates; i++) {\n        const previous = s.frame;\n        s.prepareAppend([row(size + i)], { keep: size }).commit();\n        s.retire(previous.revision);\n      }\n    });\n    expect(s.retainedRowCount).toBe(size);\n    expect(bytes).toBeLessThan(256 * updates);\n  });\n}\n\nit('shares scatter missing positions through append and offset keep, then retires the evicted rows', async () => {\n  function setup() {\n    const dropped = { x: 1, y: null };\n    const ref = new WeakRef(dropped);\n    const data = [dropped, { x: 2, y: 4 }, { x: 3, y: null }];\n    const s = new PointStore(options('scatter', data), utc, version);\n    const old = s.frame;\n    const missing = old.series[0]!.missingX!;\n    expect(missing).toEqual(Float64Array.of(1, 3));\n    const accepted = s.prepareAppend([{ x: 3, y: null }, { x: 4, y: null }], { keep: 3 });\n    const current = accepted.frame.series[0]!.missingX!;\n    expect(current).toEqual(Float64Array.of(3, 3, 4));\n    expect(current.buffer).toBe(missing.buffer);\n    expect(current.byteOffset).toBe(missing.byteOffset + Float64Array.BYTES_PER_ELEMENT);\n    const competing = s.prepareAppend([{ x: 5, y: null }], { keep: 3 });\n    expect(competing.frame.series[0]!.missingX).toEqual(Float64Array.of(3, 5));\n    accepted.commit();\n    expect(() => competing.commit()).toThrow('Cannot commit a superseded data revision.');\n    expect(current).toEqual(Float64Array.of(3, 3, 4));\n    expect(old.source.rowAt(0)).toBe(dropped);\n    s.retire(old.revision);\n    expect(old.source.rowAt(0)).toBeNull();\n    expect(missing).toEqual(Float64Array.of(1, 3));\n    expect(s.retainedRowCount).toBe(4);\n    return { s, ref };\n  }\n  const { s, ref } = setup();\n  await expectCollected(ref);\n  expect(s.frame.series[0]!.missingX).toEqual(Float64Array.of(3, 3, 4));\n});\n\nit('rebuilds scatter missing positions for absent fields, re-encoding, and replacement', () => {\n  const s = new PointStore(options('scatter', [{ x: 1, y: 2 }, { x: 3, y: null }]), utc, version);\n  const missing = { x: 2 };\n  const next = s.append([missing, { x: 4, y: 5 }], { keep: 3 });\n  expect(next.series[0]!.missingX).toEqual(Float64Array.of(2, 3));\n  expect(s.diagnostics).toMatchObject([\n    { code: 'AX102', effect: 'omitted', rows: [2], count: 1 }, { code: 'AX151', rows: [2], count: 1 },\n  ]);\n  const encoding = s.resolveEncoding({ x: 'x', y: { field: 'y', missing: 'zero' } }, quiet);\n  const zeros = s.reencode(encoding, { epoch: version.epoch + 1, revision: next.revision + 1 });\n  expect(zeros.series[0]!.x).toEqual(Float64Array.of(2, 3, 4));\n  expect(zeros.series[0]!.y).toEqual(Float64Array.of(0, 0, 5));\n  expect(zeros.series[0]!.row).toEqual(Int32Array.of(2, 1, 3));\n  expect(zeros.source.rowAt(zeros.series[0]!.row![0]!)).toBe(missing);\n  expect(zeros.series[0]!.missingX?.length ?? 0).toBe(0);\n  expect(s.diagnostics).toMatchObject([{ code: 'AX102', effect: 'changed', rows: [2], count: 1 }]);\n  const replacement = [{ x: 10, y: null }, { x: 9, y: 1 }, { x: 11 }];\n  const final = s.replace(replacement, options('scatter', replacement), { epoch: zeros.epoch + 1, revision: zeros.revision + 1 });\n  expect(final.series[0]!.missingX).toEqual(Float64Array.of(10, 11));\n  s.retire(zeros.revision);\n  expect(zeros.source.rowAt(2)).toBeNull();\n  expect(next.series[0]!.missingX).toEqual(Float64Array.of(2, 3));\n  expect(s.retainedRowCount).toBe(3);\n});\n\nfor (const kind of types) {\n  it(`${kind} keeps competing previews and captured views independent`, () => {\n    const data = [row(0), row(1)];\n    const s = store(kind, data);\n    const before = s.frame;\n    const accepted = s.prepareAppend([row(2)], { keep: 2 });\n    const rejected = s.prepareAppend([row(3)], { keep: 1 });\n    expect(rejected.frame.source.rowAt(2)).toEqual(row(3));\n    checkFrame({ frame: before, rows: data.map((row, index) => ({ row, index })), field: 'y', next: 2 }, true);\n    accepted.commit();\n    expect(() => rejected.commit()).toThrow('Cannot commit a superseded data revision.');\n    expect(rejected.frame.source.rowAt(2)).toBeNull();\n    const values = rejected.frame.shape === 'aligned' ? rejected.frame.series[0]!.y :\n      rejected.frame.shape === 'points' ? rejected.frame.series[0]!.y : rejected.frame.values;\n    expect([...values]).toEqual([4]);\n    expect(s.frame.source.rowAt(2)).toEqual(row(2));\n  });\n}\n\nit('preserves a captured series view when a later row fills its shared-x slot', () => {\n  const data = [{ x: 0, y: 2, group: 'a' }, { x: 0, y: 3, group: 'b' }, { x: 1, y: 4, group: 'a' }];\n  const encoded = resolveOptions('line', { data, x: 'x', y: 'y', series: 'group' }, quiet);\n  const s = new AlignedStore('line', encoded, utc, version);\n  const before = s.frame;\n  const values = before.series[1]!.y;\n  const observation = { x: 1, y: 5, group: 'b' };\n  const candidate = s.prepareAppend([observation]);\n  expect([...candidate.frame.series[1]!.y]).toEqual([3, 5]);\n  expect([...values]).toEqual([3, NaN]);\n  candidate.commit();\n  expect([...values]).toEqual([3, NaN]);\n  expect(before.source.rowAt(3)).toBeNull();\n  expect(s.frame.source.rowAt(3)).toBe(observation);\n});\n\nit('shares ordered time-point storage and revalidates a daily cadence exposed by keep', () => {\n  const day = 86_400_000;\n  const firstDay = Date.UTC(2026, 0, 1);\n  const data = [row(firstDay - 3_600_000), row(firstDay), row(firstDay + day)];\n  const resolved = resolveOptions('scatter', { data, x: { field: 'x', type: 'time' }, y: 'y' }, quiet);\n  const s = new PointStore(resolved, utc, version);\n  const first = s.frame;\n  const prepared = s.prepareAppend([row(firstDay + 2 * day)]);\n  numericBuffers(prepared.frame).forEach((buffer, i) => expect(buffer).toBe(numericBuffers(first)[i]));\n  expect(prepared.diagnostics).toEqual([]);\n  prepared.commit();\n  const daily = s.prepareAppend([row(firstDay + 3 * day)], { keep: 3 });\n  expect(daily.diagnostics).toMatchObject([{ code: 'AX111', count: 3, rows: [2, 3, 4] }]);\n  daily.commit();\n  expect([...s.frame.series[0]!.x]).toEqual([firstDay + day, firstDay + 2 * day, firstDay + 3 * day]);\n  expect([...first.series[0]!.x]).toEqual(data.map(item => item.x));\n});\n\nit('keeps AX103 and AX106 positions in the scatter table column through append and eviction', () => {\n  const s = new PointStore(options('scatter', [{ x: 1, y: 4 }, { x: 2, y: null }]), utc, version);\n  const first = s.append([{ x: 3, y: Infinity }, { x: 4, y: 'bad' }, { x: 5, y: 5 }]);\n  expect(first.series[0]!.x).toEqual(Float64Array.of(1, 5));\n  expect(first.series[0]!.missingX).toEqual(Float64Array.of(2, 3, 4));\n  expect(s.diagnostics).toMatchObject([\n    { code: 'AX103', effect: 'omitted', rows: [2], count: 1 },\n    { code: 'AX106', effect: 'omitted', rows: [3], count: 1 },\n  ]);\n  const last = s.append([{ x: 6, y: 6 }], { keep: 3 });\n  expect(last.series[0]!.missingX).toEqual(Float64Array.of(4));\n  expect(last.series[0]!.x).toEqual(Float64Array.of(5, 6));\n  expect(s.diagnostics).toMatchObject([{ code: 'AX106', effect: 'omitted', rows: [3], count: 1 }]);\n  expect(first.series[0]!.missingX).toEqual(Float64Array.of(2, 3, 4));\n});\nimport fc from 'fast-check';\nimport { describe, expect, it } from 'vitest';\nimport type { AlignedFrame } from '../../src/core/contracts';\nimport { AlignedStore, createXParser, DonutStore, PointStore, resolveOptions } from '../../src/data';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { aligned, check, contents, utc, version } from './helpers';\n\nconst quiet = { add() {} };\nconst numbers = { x: { field: 'x', type: 'number' }, y: 'y' };\nconst resolve = (options: unknown) => resolveOptions('line', options, quiet);\nconst stream = (data: readonly unknown[] = []) => new AlignedStore('line', resolve({ data, ...numbers }), utc, version);\nconst indexes = (frame: AlignedFrame) => [...frame.series[0]?.row ?? []].filter(i => i >= 0);\nconst revised = (frame: AlignedFrame) => ({ epoch: frame.epoch + 1, revision: frame.revision + 1 });\n\nfunction bytes(frame: AlignedFrame) {\n  return [frame.x.values, ...frame.series.flatMap(s => [s.y, s.slot, s.row!])].map(\n    a => [...new Uint8Array(a.buffer, a.byteOffset, a.byteLength)],\n  );\n}\n\n\ndescribe('prepared appends', () => {\n  // Changed by the coordinator on 2026-11-18. This test used to compare whole backing buffers, spare capacity\n  // included. Appends now share storage (plan 2.2: cost proportional to the rows appended), so a prepared\n  // append writes into capacity beyond every live frame's length. What a frame's holder may rely on is its\n  // own view, and that an abandoned transaction changes no later result; both are still asserted below.\n  it('leaves the store and every byte of the displayed frame unchanged when the transaction is abandoned', () => {\n    const rows = fc.array(fc.record({\n      x: fc.integer({ min: -10, max: 10 }),\n      y: fc.oneof(fc.integer(), fc.constant(NaN), fc.constant('2'), fc.constant(null)),\n    }), { maxLength: 20 });\n    fc.assert(fc.property(rows, rows, rows, fc.option(fc.nat(8), { nil: undefined }), (initial, rejected, accepted, keep) => {\n      const a = stream(initial);\n      const b = stream(initial);\n      const previous = a.frame;\n      const before = bytes(previous);\n      const discarded = a.prepareAppend(rejected, { keep });\n      const expectedCandidate = stream(initial);\n      expect(contents(discarded.frame)).toEqual(contents(expectedCandidate.append(rejected, { keep })));\n      expect(discarded.diagnostics).toEqual(expectedCandidate.diagnostics);\n      expect(a.frame).toBe(previous);\n      expect(bytes(previous)).toEqual(before);\n      expect(a.diagnostics).toEqual(b.diagnostics);\n      const actual = a.append(accepted, { keep });\n      const expected = b.append(accepted, { keep });\n      expect({ ...contents(actual), revision: actual.revision }).toEqual({ ...contents(expected), revision: expected.revision });\n      expect(bytes(actual)).toEqual(bytes(expected));\n      expect(a.diagnostics).toEqual(b.diagnostics);\n      for (const i of indexes(expected)) expect(actual.source.rowAt(i)).toBe(expected.source.rowAt(i));\n    }));\n  });\n\n  it('publishes the inspected frame on commit and rejects stale transactions', () => {\n    const s = stream([{ x: 1, y: 2 }]);\n    const pending = s.prepareAppend([{ x: 2, y: 3 }]);\n    const obsolete = s.prepareAppend([{ x: 4, y: 5 }]);\n    const frame = pending.frame;\n    expect(frame.source.rowAt(1)).toEqual({ x: 2, y: 3 });\n    pending.commit();\n    expect(s.frame).toBe(frame);\n    pending.commit();\n    expect(() => obsolete.commit()).toThrow();\n    expect(s.frame).toBe(frame);\n  });\n});\n\ndescribe('re-encoding', () => {\n  it('matches full normalization of the retained rows with their original provenance', () => {\n    const rows = fc.array(fc.record({\n      advance: fc.integer({ min: 1, max: 3 }), other: fc.integer({ min: -10, max: 10 }),\n      group: fc.constantFrom('a', 'b'), z: fc.oneof(fc.integer(), fc.constant(NaN)),\n    }), { minLength: 1, maxLength: 35 });\n    fc.assert(fc.property(rows, fc.nat(35), fc.nat(10), (input, split, keep) => {\n      let x = 0;\n      const data = input.map(r => ({ x: x += r.advance, y: r.other, ...r }));\n      const s = stream(data.slice(0, split));\n      const before = s.append(data.slice(split), { keep });\n      const retained = keep ? data.slice(-keep) : [];\n      const encoding = { x: 'other', y: 'z', series: 'group' };\n      const full = aligned({ data: retained, ...encoding });\n      const after = s.reencode(resolve({ data: data.slice(0, split), ...encoding }), revised(before));\n      const offset = data.length - retained.length;\n      const expected = contents(full.frame);\n      expect(contents(after)).toEqual({\n        ...expected, series: expected.series.map(series => ({\n          ...series, row: series.row.map(row => row < 0 ? row : row + offset),\n        })),\n      });\n      expect(s.diagnostics.map(d => [d.code, d.count, d.rows])).toEqual(\n        full.diagnostics.inputs().map(d => [d.code, d.count, d.rows?.map(row => row + offset)]),\n      );\n      expect(after.epoch).toBe(before.epoch + 1);\n      for (const row of indexes(before)) expect(before.source.rowAt(row)).toBe(data[row]);\n      for (let i = 0; i < data.length; i++) expect(after.source.rowAt(i)).toBe(i < offset ? null : data[i]);\n    }));\n  });\n\n  it('revalidates a new field against appended rows and replaces the stream even with the initial data', () => {\n    const data = [{ x: 1, y: 5 }];\n    const s = stream(data);\n    const before = s.append([{ x: 2, y: 6, z: NaN }], { keep: 1 });\n    const newEncoding = resolve({ data, x: 'x', y: 'z' });\n    expect(newEncoding.valid).toBe(false);\n    const findings = new DiagnosticCollector();\n    expect(s.resolveEncoding({ data, x: 'x', y: 'z' }, findings).valid).toBe(true);\n    expect(findings.inputs()).toEqual([]);\n    const change = s.prepareReencode(newEncoding, revised(before));\n    expect(s.frame).toBe(before);\n    expect(change.diagnostics).toMatchObject([{ code: 'AX103', rows: [1] }]);\n    change.commit();\n    expect(s.frame.series[0]?.row?.[0]).toBe(1);\n    const replacement = s.replace(data, resolve({ data, ...numbers }), revised(s.frame));\n    expect([...replacement.x.values]).toEqual([1]);\n    expect(indexes(replacement)).toEqual([0]);\n    expect(replacement.source.rowAt(0)).toBe(data[0]);\n    expect(before.source.rowAt(1)).toEqual({ x: 2, y: 6, z: NaN });\n    expect(replacement.source.rowAt(1)).toBeNull();\n    s.retire(before.revision);\n    expect(before.source.rowAt(1)).toBeNull();\n    expect(replacement.source.rowAt(0)).toBe(data[0]);\n  });\n\n  it('keeps typed missingness and source indexes after retaining only a small column range', () => {\n    const x = Float64Array.from({ length: 512 }, (_, i) => i);\n    const z = Float32Array.from(x, i => i === 511 ? NaN : -i);\n    const data = { columns: { x, y: x, z } };\n    const s = new AlignedStore('line', resolve({ data, ...numbers }), utc, version);\n    const before = s.append([{ x: 512, y: 1, z: Infinity }], { keep: 3 });\n    s.retire(before.revision - 1);\n    const after = s.reencode(resolve({ data, x: 'x', y: 'z' }), revised(before));\n    expect(indexes(after)).toEqual([510, 511, 512]);\n    expect([...after.series[0]!.y]).toEqual([-510, NaN, NaN]);\n    expect(s.diagnostics).toMatchObject([{ code: 'AX103', rows: [512] }]);\n    expect(after.source.rowAt(511)).toEqual({ x: 511, y: 511, z: NaN });\n    expect(after.source.rowAt(509)).toBeNull();\n  });\n});\n\ndescribe('revision leases', () => {\n  it('keeps the previous frame readable through an eviction until it is retired', () => {\n    const data = [{ x: 0, y: 1 }, { x: 1, y: 2 }];\n    const s = stream(data);\n    const a = s.frame;\n    const last = { x: 2, y: 3 };\n    const b = s.append([last], { keep: 1 });\n    indexes(a).forEach(i => expect(a.source.rowAt(i)).toBe(data[i]));\n    expect(s.retainedRowCount).toBe(3);\n    s.retire(a.revision);\n    indexes(a).forEach(i => expect(a.source.rowAt(i)).toBeNull());\n    expect(s.retainedRowCount).toBe(1);\n    expect(b.source.rowAt(2)).toBe(last);\n  });\n\n  it('stores exactly the union of the live windows during random retirement', () => {\n    const operations = fc.array(fc.record({\n      x: fc.integer({ min: -15, max: 15 }), keep: fc.nat(7), retire: fc.nat(10), preview: fc.boolean(),\n    }), { maxLength: 45 });\n    fc.assert(fc.property(operations, ops => {\n      const s = stream();\n      const frames: { frame: AlignedFrame; window: Set<number> }[] = [];\n      const rows = ops.map(({ x }, y) => ({ x, y }));\n      let retained = new Set<number>();\n      let retired = version.revision - 1;\n      ops.forEach(({ keep, retire, preview }, i) => {\n        const seen = new Set(retained).add(i);\n        const xs = [...new Set([...seen].map(index => rows[index]!.x))].sort((a, b) => a - b);\n        const keys = new Set(keep === 0 ? [] : xs.slice(-keep));\n        retained = new Set([...seen].filter(index => keys.has(rows[index]!.x)));\n        const pending = preview ? s.prepareAppend([rows[i]!], { keep }) : null;\n        pending?.commit();\n        const frame = pending?.frame ?? s.append([rows[i]!], { keep });\n        frames.push({ frame, window: retained });\n        if (retire < 5) {\n          retired = Math.max(retired, frame.revision - retire - 1);\n          s.retire(retired);\n        }\n        const union = new Set<number>();\n        for (const old of frames) {\n          const active = old.frame.revision > retired;\n          for (let index = 0; index <= i; index++) {\n            const addressed = active && old.window.has(index);\n            if (addressed) union.add(index);\n            expect(old.frame.source.rowAt(index)).toBe(addressed ? rows[index] : null);\n          }\n        }\n        expect(s.retainedRowCount).toBe(union.size);\n      });\n    }));\n  });\n});\n\ndescribe('static handoff', () => {\n  it('borrows typed columns until it creates an aligned store', () => {\n    const x = Float64Array.of(1, 2);\n    const y = Float64Array.of(3, 4);\n    const data = { columns: { x, y } };\n    const initial = aligned({ data, ...numbers });\n    expect(initial.frame.x.values.buffer).toBe(x.buffer);\n    expect(initial.frame.series[0]!.y.buffer).toBe(y.buffer);\n    const s = AlignedStore.fromFrame(initial.frame, initial.resolved, data, utc);\n    expect(s.frame.x.values.buffer).not.toBe(x.buffer);\n    expect(s.frame.series[0]!.y.buffer).not.toBe(y.buffer);\n    expect(contents(s.frame)).toEqual(contents(initial.frame));\n    expect([...s.append([{ x: 3, y: 5 }]).series[0]!.y]).toEqual([3, 4, 5]);\n    expect([...y]).toEqual([3, 4]);\n  });\n\n  it('can take over a normalized ascending frame without rereading its fields', () => {\n    let reads = 0;\n    const data = [1, 2, 3].map(n => ({\n      get x() { reads++; return n; },\n      get y() { reads++; return n * 2; },\n    }));\n    const initial = aligned({ data, ...numbers });\n    const atNormalize = reads;\n    const domainOnly = resolve({ data, ...numbers, x: { ...numbers.x, domain: [0, 10] } });\n    const s = AlignedStore.fromFrame(initial.frame, domainOnly, data, utc);\n    const frame = s.append([{ x: 4, y: 8 }]);\n    expect(reads).toBe(atNormalize);\n    expect([...frame.series[0]!.y]).toEqual([2, 4, 6, 8]);\n  });\n});\n\nconst scatterOptions = { ...numbers };\nconst donutOptions = { label: 'label', value: 'y' };\n\ndescribe('scatter and donut stores', () => {\n  it('does not reread existing fields when extending ordered points and distinct labels', () => {\n    let reads = 0;\n    const data = [1, 2, 3].map(n => ({\n      get x() { reads++; return n; },\n      get label() { reads++; return String(n); },\n      get y() { reads++; return n * 2; },\n    }));\n    const p = new PointStore(resolveOptions('scatter', { data, ...scatterOptions }, quiet), utc, version);\n    const d = new DonutStore(resolveOptions('donut', { data, ...donutOptions }, quiet), utc, version);\n    const atStart = reads;\n    const row = { x: 4, label: '4', y: 8 };\n    expect([...p.append([row], { keep: 2 }).series[0]!.y]).toEqual([6, 8]);\n    expect(d.append([row], { keep: 2 }).labels).toEqual(['3', '4']);\n    expect(reads).toBe(atStart);\n  });\n\n  it('keeps positions, reports out-of-order rows even if evicted, and keeps typed NaN silent', () => {\n    const data = { columns: { x: Float64Array.of(NaN, 10, 20), y: Float64Array.of(1, NaN, 2) } };\n    const s = new PointStore(resolveOptions('scatter', { data, ...scatterOptions }, quiet), utc, version);\n    expect(s.diagnostics).toEqual([]);\n    const prepare = s.prepareAppend([{ x: 5, y: 1 }, { x: 20, y: 3 }], { keep: 2 });\n    expect(prepare.diagnostics).toMatchObject([{ code: 'AX151', rows: [3] }]);\n    expect([...prepare.frame.series[0]!.x]).toEqual([20, 20]);\n    expect([...prepare.frame.series[0]!.row!]).toEqual([2, 4]);\n    expect(s.frame.source.rowAt(4)).toBeNull();\n    prepare.commit();\n    expect(s.frame.source.rowAt(1)).toEqual({ x: 10, y: NaN });\n    expect(s.frame.source.rowAt(3)).toBeNull();\n    expect(s.diagnostics.map(d => d.code)).toEqual(['AX151']);\n  });\n\n  it('still applies keep when removing rows changes the inferred scatter x kind', () => {\n    const options = resolveOptions('scatter', {\n      data: [1, 2, 3].map(x => ({ x, y: x })), x: 'x', y: 'y',\n    }, quiet);\n    const s = new PointStore(options, utc, version);\n    const next = s.append([{ x: '2026-01-01', y: 5 }, { x: '2026-01-02', y: 6 }], { keep: 1 });\n    expect(next.xKind).toBe('date');\n    expect([...next.series[0]!.x]).toEqual([Date.UTC(2026, 0, 2)]);\n    expect([...next.series[0]!.row!]).toEqual([4]);\n  });\n\n  it('validates duplicate labels before eviction and keeps typed NaN silent', () => {\n    const data = { columns: { label: ['A', 'B'], y: Float64Array.of(NaN, 2) } };\n    const s = new DonutStore(resolveOptions('donut', { data, ...donutOptions }, quiet), utc, version);\n    const first = s.frame;\n    const prepared = s.prepareAppend([{ label: 'A', y: 1 }, { label: 'C', y: 3 }], { keep: 2 });\n    expect(prepared.callDiagnostics).toMatchObject([{ code: 'AX108', rows: [2] }]);\n    expect(prepared.frame.labels).toEqual(['B', 'C']);\n    expect(prepared.diagnostics).toEqual([]);\n    prepared.commit();\n    expect(first.source.rowAt(0)).toEqual({ label: 'A', y: NaN });\n    s.retire(first.revision);\n    expect(first.source.rowAt(0)).toBeNull();\n    expect(s.frame.source.rowAt(1)).toEqual({ label: 'B', y: 2 });\n  });\n\n  it('agrees with one scatter normalization of the retained rows at every step', () => {\n    const points = fc.array(fc.record({ x: fc.integer({ min: -6, max: 6 }), y: fc.oneof(fc.integer(), fc.constant(null)) }), { maxLength: 28 });\n    fc.assert(fc.property(points, fc.nat(10), (input, keep) => {\n      const s = new PointStore(resolveOptions('scatter', { data: [], ...scatterOptions }, quiet), utc, version);\n      let retained: number[] = [];\n      input.forEach((row, i) => {\n        const f = s.append([row], { keep });\n        retained.push(i);\n        const xs = [...new Set(retained.map(i => input[i]!.x))].sort((a, b) => a - b);\n        const keys = new Set(keep === 0 ? [] : xs.slice(-keep));\n        retained = retained.filter(i => keys.has(input[i]!.x));\n        const normalized = check('scatter', { data: retained.map(i => input[i]), ...scatterOptions }).frame;\n        if (normalized.shape !== 'points') throw new Error('Expected a point frame');\n        expect(f.series).toEqual(normalized.series.map(s => ({\n          ...s, row: Int32Array.from(s.row ?? s.x.keys(), index => retained[index]!),\n        })));\n        for (const i of retained) expect(f.source.rowAt(i)).toBe(input[i]);\n      });\n    }));\n  });\n\n  it('agrees with one donut normalization of the retained labels at every step', () => {\n    const slices = fc.array(fc.record({ label: fc.constantFrom('A', 'B', 'C', 'D'), y: fc.oneof(fc.integer(), fc.constant(null)) }), { maxLength: 28 });\n    fc.assert(fc.property(slices, fc.nat(5), (input, keep) => {\n      const s = new DonutStore(resolveOptions('donut', { data: [], ...donutOptions }, quiet), utc, version);\n      let retained: number[] = [];\n      input.forEach((row, i) => {\n        const f = s.append([row], { keep });\n        retained.push(i);\n        const labels = [...new Set(retained.map(i => input[i]!.label))];\n        const keys = new Set(keep === 0 ? [] : labels.slice(-keep));\n        retained = retained.filter(i => keys.has(input[i]!.label));\n        const normalized = check('donut', { data: retained.map(i => input[i]), ...donutOptions }).frame;\n        if (normalized.shape !== 'donut') throw new Error('Expected a donut frame');\n        expect(f.labels).toEqual(normalized.labels);\n        expect(f.values).toEqual(normalized.values);\n        expect(f.slot).toEqual(normalized.slot);\n        expect(f.row).toEqual(Int32Array.from(normalized.row ?? normalized.values.keys(), index => retained[index]!));\n      });\n    }));\n  });\n\n  it('re-encodes and replaces point and donut data independently of old revisions', () => {\n    const data = [{ x: 1, y: 1, label: 'A', alternative: 3 }];\n    const row = { x: 2, y: 2, label: 'B', alternative: 4 };\n    const p = new PointStore(resolveOptions('scatter', { data, ...scatterOptions }, quiet), utc, version);\n    const d = new DonutStore(resolveOptions('donut', { data, ...donutOptions }, quiet), utc, version);\n    const pf = p.append([row], { keep: 1 });\n    const df = d.append([row], { keep: 1 });\n    const second = { epoch: 5, revision: 10 };\n    expect([...p.reencode(resolveOptions('scatter', { data, ...scatterOptions, y: 'alternative' }, quiet), second).series[0]!.y]).toEqual([4]);\n    expect([...d.reencode(resolveOptions('donut', { data, ...donutOptions, value: 'alternative' }, quiet), second).values]).toEqual([4]);\n    const third = { epoch: 6, revision: 11 };\n    expect([...p.replace(data, resolveOptions('scatter', { data, ...scatterOptions }, quiet), third).series[0]!.x]).toEqual([1]);\n    expect(d.replace(data, resolveOptions('donut', { data, ...donutOptions }, quiet), third).labels).toEqual(['A']);\n    expect(pf.source.rowAt(1)).toBe(row);\n    expect(df.source.rowAt(1)).toBe(row);\n    p.retire(second.revision);\n    d.retire(second.revision);\n    expect(pf.source.rowAt(1)).toBeNull();\n    expect(df.source.rowAt(1)).toBeNull();\n    expect(p.retainedRowCount).toBe(1);\n    expect(d.retainedRowCount).toBe(1);\n  });\n});\n\nit('parses numeric, category, calendar, instant and wall x values without normalizing a frame', () => {\n  const parser = (kind: 'number' | 'category' | 'date' | 'time' | 'wall', categories: readonly string[] | null = null) =>\n    createXParser({ kind, categories, timeZone: 'UTC' }, utc);\n  const numeric = parser('number');\n  expect(numeric.position(40)).toBe(40);\n  expect(numeric.position('40')).toBeNull();\n  expect(numeric.reports).toMatchObject([{ code: 'AX107', rows: [] }]);\n  const category = parser('category', ['one', '2']);\n  expect(category.position('one')).toBe(0);\n  expect(category.position('missing')).toBeNull();\n  expect(category.position(2)).toBe(1);\n  const date = parser('date');\n  expect(date.position('2024-02-29')).toBe(Date.UTC(2024, 1, 29));\n  expect(date.position('2025-02-29')).toBeNull();\n  expect(parser('time').position('2026-11-18T12:00:00+02:00')).toBe(Date.UTC(2026, 10, 18, 10));\n  const wall = parser('wall');\n  expect(wall.position('2026-11-18 12:00:00')).toBe(Date.UTC(2026, 10, 18, 12));\n  expect(wall.reports).toMatchObject([{ code: 'AX112', rows: [] }]);\n  expect(wall.position('2026-11-18T12:00:00Z')).toBeNull();\n});\n","exit_code":0,"status":"completed"}}
