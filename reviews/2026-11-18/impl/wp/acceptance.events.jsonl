  data.push({ x: 0, y: 9, s: 'weekly' }, { x: 6, y: 9, s: 'weekly' });\n  const { frame, view } = aligned({ x: 'x', y: 'y', series: 's', data }, { kind: 'line', zoom: [2, 4] });\n  expect(frame.series[1]!.slot.slice(2, 5)).toEqual(Uint8Array.of(SLOT_NO_ROW, SLOT_NO_ROW, SLOT_NO_ROW));\n  expect(view.yDomain).toEqual([0, 10]);\n});\n\nit('fits both interpolated stack totals between slots', () => {\n  const { view } = aligned({\n    x: 'x', y: ['a', 'b', 'c'], data: [{ x: 0, a: 8, b: 20, c: -8 }, { x: 2, a: 12, b: 24, c: -12 }],\n  }, { kind: 'area', stacked: true, zoom: [0.5, 1.5] });\n  // The positive total crosses the edges at 30 and 34, and the negative total at -9 and -11.\n  expect(view.yDomain).toEqual([-20, 40]);\n});\n\nit.each([\n\nit('includes x lines and bands in the automatic extent, including on scatter', () => {\n  const references = [{ x: 8, label: 'Future' }, { x: [-3, -1] as const, label: 'Past' }];\n  expect(aligned(line, { kind: 'line', references }).view.xFull).toEqual([-3, 8]);\n  expect(scatter(line, { references }).view.xFull).toEqual([-5, 10]);\n});\n\nit('uses a narrower author x domain over the data and references', () => {\n  const references = [{ x: 8, label: 'Future' }];\n  const { view } = aligned({ ...line, x: { field: 'x', domain: [0.5, 2.5] } },\n    { kind: 'line', zoom: [4, 5], references });\n  expect(view.xFull).toEqual([0.5, 2.5]);\n  expect(view.xDomain).toEqual([1.5, 2.5]);\n  expect(view.visibleSlots).toEqual({ start: 2, end: 3 });\n  expect(scatter(line, { xDomain: [0.5, 2.5], zoom: [4, 5], references }).view.xDomain).toEqual([1.5, 2.5]);\n});\n\nit('cycles eight qualitatively distinct contrast dashes with a different marker each cycle', () => {\n  it('returns too-small, compact, and unmeasured layouts', () => {\n    const small = input(teams, 100, 60);\n    expect(computeLayout(small)).toEqual({ kind: 'too-small', width: 100, height: 60 });\n    expect(computeLayout({ ...small, width: 24, height: 16, compact: true })).toEqual({\n      kind: 'compact', width: 24, height: 16,\n      plot: { x: 2, y: 2, width: 20, height: 12 },\n      projection: expect.objectContaining({ kind: 'xy' }),\n    });\n    expect(computeLayout({ ...small, width: 0, height: 0 })).toEqual({ kind: 'unmeasured', width: 0, height: 0 });\n    expect(computeLayout({ ...small, width: 0 })).toEqual({ kind: 'unmeasured', width: 0, height: 60 });\n  });\n\n  it('centers a ring of the largest radius and omits axes', () => {\n    const result = plot(computeLayout({ kind: 'ring', width: 360, height: 200 }));\n    expect(result.projection).toEqual({ kind: 'ring', cx: 180, cy: 100, r0: 60, r1: 100 });\n      data: [{ name: 'A', y: 2 }, { name: 'B', y: null }, { name: 'C' }],\n      label: 'name', value: { field: 'y', missing: 'zero' },\n    });\n    if (frame.shape !== 'donut') throw new Error('Expected donut');\n    expect([...frame.values]).toEqual([2, 0, 0]);\n    expect([...frame.slot]).toEqual([SLOT_VALUE, SLOT_VALUE, SLOT_VALUE]);\n    expect([...frame.row!]).toEqual([0, -1, -1]);\n    expect(readerDisclosure(diagnostics.inputs())).toEqual({ omitted: 0, changed: 1 });\n  });\n\n  it('keeps scatter points sharing x or both coordinates, ordered by x then y', () => {\n    const data = [{ x: 2, y: 1 }, { x: 1, y: 3 }, { x: 1, y: 1 }, { x: 1, y: 1 }];\n    const { frame, diagnostics } = check('scatter', { data, x: 'x', y: 'y' });\n    if (frame.shape !== 'points') throw new Error('Expected scatter');\n    expect(frame.series[0]).toMatchObject({\n      drawable: true, x: Float64Array.of(1, 1, 1, 2), y: Float64Array.of(1, 1, 3, 1), row: Int32Array.of(2, 3, 1, 0),\n    });\n    expect(diagnostics.inputs()).toEqual([]);\n  });\n});\n\nit.each([\n  ['America/Los_Angeles', ['2026-03-06T00:00-08:00', '2026-03-07T00:00-08:00', '2026-03-09T00:00-07:00', '2026-03-10T00:00-07:00'], Date.UTC(2026, 2, 8, 8)],\n  ['Europe/Paris', ['2026-03-27T00:00+01:00', '2026-03-28T00:00+01:00', '2026-03-30T00:00+02:00', '2026-03-31T00:00+02:00'], Date.UTC(2026, 2, 28, 23)],\n    expect(rules.filter(mark => mark.role === 'reference')).toMatchObject([\n      { x1: 10, y1: 95, x2: 150, y2: 95 }, { x1: 80, y1: 20, x2: 80, y2: 120 },\n    ]);\n  });\n\n  it('draws scatter points in series shapes, excluding hidden and out-of-zoom points', () => {\n    const { view } = scatter({ x: 'x', y: 'y', series: 's', data: [\n      { x: 0, y: 7, s: 'a' }, { x: 2, y: 3, s: 'a' }, { x: 3, y: 6, s: 'b' },\n      { x: 4, y: 5, s: 'b' }, { x: 2, y: 2, s: 'hidden' },\n    ] }, { zoom: [1, 3], valueDomain: [0, 10], hidden: new Set(['hidden']) });\n    const { marks } = buildScene(view, layout(view), dpr);\n    expect(marksOf(marks, 'points')).toEqual([\n      { type: 'points', series: 0, xy: Float32Array.of(80, 90), shape: 'circle', size: 6, fill: { kind: 'series', index: 0 } },\n      { type: 'points', series: 1, xy: Float32Array.of(150, 60), shape: 'square', size: 6, fill: { kind: 'series', index: 1 } },\n    ]);\n  });\n\n  it('uses the slice palette slots and a muted Other with a one-pixel gap', () => {\n    const { view } = donut(Array.from({ length: 10 }, (_, i) => ({ label: 'Part ' + i, value: i })));\n    const { marks } = buildScene(view, layout(view), dpr);\ndescribe('resize (spec L3)', () => {\n  it('720 → 360 → 720 px relayouts with no call from the page and does not renormalize', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const el = document.getElementById('chart')!;\n      const chart = window.Axylo.line!(el, { title: 'T', data: window.fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel' });\n      window.charts.push(chart);\n      await chart.__bench.ready();\n      const widths: number[] = [];\n      const lastLabelRight = () => Math.max(...[...el.querySelectorAll('.axylo-label')].map(l => l.getBoundingClientRect().right)) - el.getBoundingClientRect().left;\n      const marks = () => (el.querySelector('.axylo-canvas') as HTMLElement).getBoundingClientRect().width;\n      const first = chart.__dev.stages();\n      widths.push(marks());\n      el.style.width = '360px';\n      await window.nextFrames(3);\n      widths.push(marks());\n      const narrow = lastLabelRight();\n      el.style.width = '720px';\n      await window.nextFrames(3);\n      widths.push(marks());\n      const last = chart.__dev.stages();\n      return { widths, narrow, first, last };\n    });\n    expect(result.widths).toEqual([720, 360, 720]);\n    expect(result.narrow).toBeLessThanOrEqual(361);\n    expect(result.last.layout - result.first.layout).toBe(2);\n    expect(result.last.normalize).toBe(result.first.normalize);\n    expect(result.last.options).toBe(result.first.options);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('a container created with display: none draws once shown', async () => {\n    const page = await chartPage({ css: '#chart { display: none; }' });\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'Hidden', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n      let ready = false;\n      void chart.__bench.ready().then(() => { ready = true; });\n      await window.nextFrames(3);\n      const hidden = { ready, draws: chart.__dev.stages().draw };\n      document.getElementById('chart')!.style.display = 'block';\n      await chart.__bench.ready();\n      await window.nextFrames(2);\n      return { hidden, draws: chart.__dev.stages().draw, labels: document.querySelectorAll('#chart .axylo-label').length };\n    });\n    expect(result.hidden).toEqual({ ready: false, draws: 0 });\n    expect(result.draws).toBe(1);\n    expect(result.labels).toBeGreaterThan(3);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('a height: auto container gets a 16:9 plot, clamped to 160–480 px, stable over 10 frames', async () => {\n    const page = await chartPage({ css: '#chart { height: auto; } .w { height: auto; }' });\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'Auto', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n      await chart.__bench.ready();\n      const plot = document.querySelector('#chart .axylo-plot')!;\n      const heights: number[] = [];\n      const layouts: number[] = [];\n      for (let i = 0; i < 10; i++) {\n        await window.nextFrames(1);\n        heights.push(plot.getBoundingClientRect().height);\n        layouts.push(chart.__dev.stages().layout);\n      }\n      const clamp: number[] = [];\n      for (const width of [200, 1200]) {\n        const el = Object.assign(document.body.appendChild(document.createElement('div')), { className: 'w' });\n        el.style.width = `${width}px`;\n        const c = window.Axylo.line!(el, { title: 'W', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n        await c.__bench.ready();\n        clamp.push(el.querySelector('.axylo-plot')!.getBoundingClientRect().height);\n      }\n      return { heights, layouts, clamp };\n    });\n    expect(new Set(result.heights).size).toBe(1);\n    expect(result.heights[0]).toBeCloseTo(720 * 9 / 16, 0);\n    expect(new Set(result.layouts).size).toBe(1);\n    expect(result.clamp).toEqual([160, 480]);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  // Part 2 put the legend and toolbar under the plot (spec A2), so the plot now takes what the caption and\n  // the controls leave; with no controls (legend, zoom and table off) it reaches the bottom as before.\n  it('a definite container height is filled: the plot takes what the caption and the controls leave', async () => {\n    const page = await chartPage({ css: '#chart { height: 300px; } #bare { height: 300px; width: 720px; }' });\n    const result = await page.evaluate(async () => {\n      const options = { title: 'Fixed', subtitle: 'Subtitle', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' };\n      const chart = window.Axylo.line!('#chart', options);\n      const el = document.body.appendChild(Object.assign(document.createElement('div'), { id: 'bare' }));\n      const bare = window.Axylo.line!(el, { ...options, legend: false, zoom: false, table: false });\n      await Promise.all([chart.__bench.ready(), bare.__bench.ready()]);\n      const box = (selector: string) => document.querySelector(selector)!.getBoundingClientRect();\n      return {\n        root: box('#chart').bottom, fig: box('#chart figure').bottom, plot: box('#chart .axylo-plot').bottom,\n        plotHeight: box('#chart .axylo-plot').height, controls: box('#chart .axylo-controls'),\n        bare: { root: box('#bare').bottom, plot: box('#bare .axylo-plot').bottom, controls: (document.querySelector('#bare .axylo-controls') as HTMLElement).hidden },\n      };\n    });\n    expect(result.fig).toBeCloseTo(result.root, 0);\n    expect(result.controls.bottom).toBeCloseTo(result.root, 0);\n    expect(result.plot).toBeLessThanOrEqual(result.controls.top);\n    expect(result.plotHeight).toBeLessThan(300);\n    expect(result.bare.controls).toBe(true);\n    expect(result.bare.plot).toBeCloseTo(result.bare.root, 0);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('commit contract (plan 1.5, spec DX5)', () => {\n  it('update({ data }), append and zoom in one turn are drawn once and end in the expected state', async () => {\n    const page = await chartPage();\n{\n  \"name\": \"axylo\",\n  \"version\": \"0.0.0\",\n  \"description\": \"Everyday charts that are faithful to the data, readable everywhere and accessible by default.\",\n  \"license\": \"MIT\",\n  \"type\": \"module\",\n  \"sideEffects\": false,\n  \"files\": [\"dist\"],\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"development\": \"./dist/axylo.dev.js\",\n      \"default\": \"./dist/axylo.js\"\n    },\n    \"./axylo.css\": \"./dist/axylo.css\"\n  }\n}\n","exit_code":0,"status":"completed"}}
