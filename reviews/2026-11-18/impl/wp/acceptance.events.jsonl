Array.from({ length: count }, (_, index) => index / count);\n    const y = new Float64Array(count).fill(3);\n    y[outlier] = 1000;\n    const slot = new Uint8Array(count);\n    for (const width of [97, 320, 877]) {\n      for (const devicePixelRatio of [1, 2]) {\n        const mapX = (sample: number) => sample * width;\n        const column = (index: number) => Math.floor(mapX(x[index]!) * devicePixelRatio);\n        expect(column(outlier - 1)).toBe(column(outlier + 1));\n\n        const input = { x, y, slot, range: range(count), mapX, left: 0, width, devicePixelRatio,\n          affineX: { slope: width, offset: 0 } };\n        const kept = simplifyLine(input);\n        for (let run = 0; run < 4; run++) simplifyLine(input);\n        const times = Array.from({ length: 7 }, () => {\n          // Vitest runs other files in parallel. Measure CPU work independently of descheduling.\n          const cpuBefore = process.threadCpuUsage();\n          const before = performance.now();\n          simplifyLine(input);\n          const wall = performance.now() - before;\n          const { user, system } = process.threadCpuUsage(cpuBefore);\n          return { cpu: (user + system) / 1000, wall };\n        });\n        const median = (clock: 'cpu' | 'wall') => times.map(time => time[clock]).sort((a, b) => a - b)[3]!;\n        console.info(`Simplified ${count} slots at ${width}px and DPR ${devicePixelRatio}: ` +\n          `${median('cpu').toFixed(1)} ms CPU, ${median('wall').toFixed(1)} ms wall (medians)`);\n        expect(median('wall')).toBeLessThan(30);\n        expect(kept.indexes).toContain(outlier);\n        expect(kept.indexes.length).toBe(2 * width * devicePixelRatio + 1);\n      }\n    }\n  });\n\ndescribe('drawing areas', () => {\n  const upper = [3, 8, 1, 8, 2, 4, NaN, 4, 4, 4, 11, 4, 4, 2, NaN, 5];\n  const bottom = [0, 0, 0, -4, 0, 0, NaN, -1, -4, 0, -4, 0, 0, -1, NaN, 0];\n  const base = line(upper, upper.map(y => Number.isNaN(y) ? SLOT_GAP : SLOT_VALUE));\n  const input = { ...base, upper: Float64Array.from(upper), lower: Float64Array.from(bottom), mapY: identity };\n  const sourceIndexes = (xy: Float32Array) => Array.from(xy.filter((_, i) => i % 2 === 0), x => x * 32);\n\n  it('preserves each boundary’s own extremes and pairs matching endpoints across breaks', () => {\n    const area = simplifyArea(input);\n    expect(sourceIndexes(area.upper)).toEqual([0, 1, 2, 5, 7, 10, 13]);\n    expect(sourceIndexes(area.lower)).toEqual([0, 3, 5, 7, 8, 9, 13]);\n    expect([...area.runs]).toEqual([0, 4, 0, 3, 4, 3, 3, 4]);\n    expect([...area.isolated]).toEqual([15]);\n  });\n\n  it('shares an exact packed edge between adjacent bands and recalculates it for a new range', () => {\n    const area = simplifyArea(input);\n    const adjacent = { ...input, slot: input.slot.slice(), upper: Float64Array.from(input.upper, y => y + 10), lower: area.upperBoundary };\n    const next = simplifyArea(adjacent);\n    expect(next.lower).toBe(area.upper);\n    expect([...next.runs]).toEqual([0, 4, 0, 4, 4, 3, 4, 3]);\n    const zoomed = simplifyArea({ ...adjacent, range: range(14, 1) });\n    expect(zoomed.lower).not.toBe(area.upper);\n    expect(sourceIndexes(zoomed.lower)).toEqual([1, 2, 5, 7, 10, 13]);\n  });\n\n  it('recalculates a shared edge if the adjacent band has a different gap', () => {\n    const area = simplifyArea(input);\n    const slot = input.slot.slice();\n    slot[3] = SLOT_NULL;\n    const next = simplifyArea({ ...input, slot, lower: area.upperBoundary });\n    expect(next.lower).not.toBe(area.upper);\n    expect(sourceIndexes(next.lower)).toEqual([0, 1, 2, 4, 5, 7, 10, 13]);\n    expect([...next.runs]).toEqual([0, 3, 0, 3, 3, 2, 3, 2, 5, 3, 5, 3]);\n  });\n\n  it('recalculates an edge when adjacent bands differ in connectivity beyond the range', () => {\n    const slot = Uint8Array.of(SLOT_VALUE, SLOT_NO_ROW, SLOT_VALUE, SLOT_NULL);\n    const draw = { ...input, slot, range: range(4, 2) };\n    const broken = simplifyArea({ ...draw, slot: Uint8Array.of(SLOT_NULL, SLOT_NO_ROW, SLOT_VALUE, SLOT_NULL) });\n    const joined = simplifyArea({ ...draw, lower: broken.upperBoundary });\n    expect([...broken.isolated]).toEqual([2]);\n    expect([...joined.isolated]).toEqual([]);\n    expect(sourceIndexes(joined.lower)).toEqual([2]);\n    expect([...joined.runs]).toEqual([0, 1, 0, 1]);\n  });\n\n  it('supports an unstacked zero baseline without a full lower data column', () => {\n    const area = simplifyArea({ ...input, lower: 0, mapY: y => 100 - y });\n    expect(sourceIndexes(area.lower)).toEqual([0, 5, 7, 13]);\n    expect([...shuffled.x.values]).toEqual([...sorted.x.values]);\n    expect([...shuffled.series[0]!.y]).toEqual([3, 1, 2]);\n    expect([...shuffled.series[0]!.row!]).toEqual([1, 2, 0]);\n    expect(shuffled.source.rowAt(0)).toBe(data[2]);\n  });\n\n  it('preserves the first row and disables every affected wide series for duplicate x', () => {\n    const data = [{ x: 2, a: 2, b: 22 }, { x: 1, a: 1, b: 11 }, { x: 2, a: 99, b: 99 }, { x: 3, a: 3, b: 33 }];\n    const { frame, diagnostics } = aligned({ data, x: 'x', y: ['a', 'b'] });\n    expect(frame.series.map(s => s.drawable)).toEqual([false, false]);\n    expect(frame.series.map(s => [...s.y])).toEqual([[1, 2, 3], [11, 22, 33]]);\n    expect(diagnostics.inputs()).toMatchObject([{ code: 'AX108', count: 2, rows: [2] }]);\n  });\n\n  it('produces equal aligned values and slots from long, wide and typed inputs', () => {\n    const wide = [\n      { x: 2, a: 20, b: 200 }, { x: 0, a: 0, b: 100 }, { x: 1, a: null, b: 120 },\n    ];\n    const long = wide.flatMap(({ x, a, b }) => [{ x, group: 'a', y: a }, { x, group: 'b', y: b }]);\n    const typed = { columns: { x: Float64Array.of(2, 0, 1), a: Float32Array.of(20, 0, NaN), b: Float64Array.of(200, 100, 120) } };\n    for (const opts of [{ data: wide, y: ['a', 'b'] }, { data: long, y: 'y', series: 'group' }, { data: typed, y: ['a', 'b'] }]) {\n      const { frame, diagnostics } = aligned({ ...opts, x: 'x' });\n      expect([...frame.x.values]).toEqual([0, 1, 2]);\n      expect(frame.series.map(s => [...s.y])).toEqual([[0, NaN, 20], [100, 120, 200]]);\n      expect(frame.series.map(s => [...s.slot])).toEqual([[SLOT_VALUE, SLOT_NULL, SLOT_VALUE], [SLOT_VALUE, SLOT_VALUE, SLOT_VALUE]]);\n      expect(diagnostics.inputs()).toEqual([]);\n    }\n    const testWide = aligned({ data: [{ x: 0, a: 1, b: 2 }, { x: 1, a: Infinity, b: 4 }], x: 'x', y: ['a', 'b'] });\n    const testLong = aligned({ data: [{ x: 0, group: 'a', y: 1 }, { x: 0, group: 'b', y: 2 },\n      { x: 1, group: 'a', y: Infinity }, { x: 1, group: 'b', y: 4 }], x: 'x', y: 'y', series: 'group' });\n    const testTyped = aligned({ data: { columns: { x: [0, 1], a: Float32Array.of(1, Infinity), b: [2, 4] } }, x: 'x', y: ['a', 'b'] });\n    expect(testWide.diagnostics.inputs()).toMatchObject([{ code: 'AX103', field: 'a', rows: [1] }]);\n    expect(testLong.diagnostics.inputs()).toMatchObject([{ code: 'AX103', field: 'y', rows: [2] }]);\n    expect(testTyped.diagnostics.inputs()).toMatchObject([{ code: 'AX103', field: 'a', rows: [1] }]);\n    expect(testTyped.frame.source.rowAt(1)).toEqual({ x: 1, a: Infinity, b: 4 });\n    expect(testTyped.frame.series[0]!.y[1]).toBeNaN();\n  });\n\n  it('sorts scatter points by x then y and retains provenance while omitting invalid points', () => {\n    const data = [\n      { x: 2, y: 8, group: 'A' }, { x: 1, y: 5, group: 'A' }, { x: 1, y: 3, group: 'A' },\n      { x: 0, y: 7, group: 'B' }, { x: undefined, y: 3, group: 'B' }, { x: 4, y: null, group: 'B' },\n      { x: 5, y: NaN, group: 'B' },\n    ];\n    const { frame, diagnostics } = check('scatter', { data, x: { field: 'x', label: 'Hours', unit: 'h' }, y: { field: 'y', unit: 'kg' }, series: 'group' });\n    if (frame.shape !== 'points') throw new Error('Expected a point frame');\n    expect(frame).toMatchObject({ xLabel: 'Hours', xUnit: 'h', yUnit: 'kg', xKind: 'number' });\n    expect(frame.series.map(s => [[...s.x], [...s.y], [...s.row!], s.drawable])).toEqual([\n      [[1, 1, 2], [3, 5, 8], [2, 1, 0], true], [[0], [7], [3], true],\n    ]);\n    expect(frame.source.rowAt(2)).toBe(data[2]);\n    expect(diagnostics.inputs()).toMatchObject([\n      { code: 'AX102', field: 'x', rows: [4] }, { code: 'AX103', field: 'y', rows: [6] },\n    ]);\n  });\n\n  it('keeps donut labels, values, zeros and nulls in caller order', () => {\n    const data = [{ label: 'East', count: 0 }, { label: 'West', count: null }, { label: 'North', count: 15 }];\n    expect.objectContaining({ code: 'AX109', field: 'reference[0].x', count: 1 }),\n  ]);\n});\n\nit('reports AX130, AX131 and AX110 only when their conditions newly apply', () => {\n  const y = Array.from({ length: 9 }, (_, i) => 'value' + i);\n  const { frame } = aligned({\n    x: 'x', y, data: [0, 1, 2].map(x => ({ x, ...Object.fromEntries(y.map(name => [name, 3])) })),\n  }, { kind: 'area' });\n  const counts = (sink: DiagnosticCollector) => Object.fromEntries(sink.inputs().map(d => [d.code, d.count ?? 1]));\n  const sink = new DiagnosticCollector();\n  const previous = buildView(frame, { kind: 'area' }, sink);\n  const state = { kind: 'area', compact: true, valueDomain: [1, 8] } as const;\n  const view = buildView(frame, { ...state, previous }, sink);\n  expect(buildView(frame, { ...state, previous: view }, sink)).toBe(view);\n  const zoomed = buildView(frame, { ...state, compact: false, zoom: [0.25, 1.75], previous: view }, sink);\n  expect(counts(sink)).toEqual({ AX130: 1, AX131: 1, AX110: 1 });\n  const cleared = buildView(frame, { kind: 'area', previous: zoomed }, sink);\n  buildView(frame, { ...state, previous: cleared }, sink);\n  expect(counts(sink)).toEqual({ AX130: 1, AX131: 2, AX110: 2 });\n\n  const fewer = aligned({ ...line, y: 'y' }, { kind: 'area' }).frame;\n  const narrow = buildView(fewer, { kind: 'area', previous: cleared }, sink);\n  buildView(frame, { ...state, previous: narrow }, sink);\n  expect(counts(sink)).toEqual({ AX130: 2, AX131: 3, AX110: 3 });\n});\n","exit_code":0,"status":"completed"}}
