out forcing zero or changing an author domain', () => {\nview/view.test.ts:157:describe('stacks and series cues', () => {\nview/view.test.ts:158:  it('accumulates on separate sides in series order and marks an incomplete stack', () => {\nview/view.test.ts:175:  it('reuses a view for identical inputs and its unchanged stack and cues across zooms', () => {\nview/view.test.ts:190:  it('assigns a unique normal color/dash pair to each of 12 series and warns once', () => {\nview/view.test.ts:205:  it('gives compact series distinct normal dashes and raises AX131', () => {\nview/view.test.ts:214:  it('matches visible components of generated long-form stacks, including gaps and absent rows', () => {\nview/view.test.ts:251:    }), { numRuns: 1000 });\nview/view.test.ts:255:describe('donut slices', () => {\nview/view.test.ts:256:  it('places the parts fixture clockwise in its given order from twelve o’clock', () => {\nview/view.test.ts:272:  it('lists zero and null entries with no arcs and leaves an all-zero ring empty', () => {\nview/view.test.ts:285:  it('keeps the seven largest in original order, favoring the first tie at the cutoff', () => {\nview/view.test.ts:298:  it('counts positive entries for grouping and does not render a partially negative ring', () => {\nview/view.test.ts:308:  it('reserves the grouped slice key even if a category has that name', () => {\ndata/normalize.test.ts:31:describe('F2 and F3 slot states', () => {\ndata/normalize.test.ts:32:  it('preserves the combined dirty fixture, Mon–Tue segment, and isolated Sun point', () => {\ndata/normalize.test.ts:45:  it.each([\ndata/normalize.test.ts:59:  it('parses whole columns of decimal strings, with an opt-in to silence AX104', () => {\ndata/normalize.test.ts:73:  it('represents seven explicit nulls and seven deleted daily rows with the same disallowed joins', () => {\ndata/normalize.test.ts:89:  it('uses independent grids and lets weekly lines bridge daily-only slots', () => {\ndata/normalize.test.ts:98:  it('marks expected gaps that already have another series observation', () => {\ndata/normalize.test.ts:106:  it('imputes zero for absent fields, nulls, gaps, and no row, with no invented provenance', () => {\ndata/normalize.test.ts:120:describe('F4 x kinds', () => {\ndata/normalize.test.ts:124:  it.each(['UTC', 'America/Los_Angeles', 'Asia/Kolkata'])('keeps date positions and resolves instant zones for %s', timeZone => {\ndata/normalize.test.ts:141:  it('preserves precision and infers missing calendar months without assuming equal millisecond lengths', () => {\ndata/normalize.test.ts:155:  it('handles wall-clock text and explicit offsets without using the viewer zone for parsing', () => {\ndata/normalize.test.ts:168:  it.each([\ndata/normalize.test.ts:178:  it('does not silently mix temporal kinds and honors a declared category', () => {\ndata/normalize.test.ts:189:describe('F8, F11 and DX2 frame shapes', () => {\ndata/normalize.test.ts:190:  it('sorts shuffled input and preserves original row indexes', () => {\ndata/normalize.test.ts:201:  it('preserves the first row and disables every affected wide series for duplicate x', () => {\ndata/normalize.test.ts:209:  it('produces equal aligned values and slots from long, wide and typed inputs', () => {\ndata/normalize.test.ts:233:  it('sorts scatter points by x then y and retains provenance while omitting invalid points', () => {\ndata/normalize.test.ts:251:  it('keeps donut labels, values, zeros and nulls in caller order', () => {\ndata/normalize.test.ts:264:  it('borrows one million ascending typed values with a warmed median under 100 ms', () => {\ndata/normalize.test.ts:295:describe('normalization invariants', () => {\ndata/normalize.test.ts:296:  it('is deterministic with ascending positions, valid provenance, and NaN exactly where slots are not values', () => {\ndata/normalize.test.ts:326:it('matches a generated fractional gap to an existing observation within rounding error', () => {\ndata/normalize.test.ts:338:it(