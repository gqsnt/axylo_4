, y2: 100, role: 'cursor' });\npackages/axylo/test/core/focus.test.ts:105:    expect(points.map(p => p.type === 'points' ? p.series : -1)).toEqual([0, 0, 2, 2]);\npackages/axylo/test/core/focus.test.ts:106:    expect(overlay.unclipped).toHaveLength(4);\npackages/axylo/test/core/focus.test.ts:107:    expect(overlay.unclipped.every(m => m.type === 'rule' && m.stroke.kind === 'token' && m.stroke.name === 'focus' && m.strokeWidth >= 2)).toBe(true);\npackages/axylo/test/core/focus.test.ts:110:  it('in single-series mode only that series is highlighted; nothing to draw is null', () => {\npackages/axylo/test/core/focus.test.ts:113:    expect(overlay.clipped.filter(m => m.type === 'points').every(p => p.type === 'points' && p.series === 2)).toBe(true);\npackages/axylo/test/core/focus.test.ts:114:    expect(buildOverlay({ view, layout, lookup, target: null, ring: null, only: null })).toBeNull();\npackages/axylo/test/core/focus.test.ts:117:  it('the box a tooltip must not cover spans every highlighted marker at x', () => {\npackages/axylo/test/core/focus.test.ts:119:    expect(targetBox(view, lookup, { kind: 'x', x: 4 }, null)).toEqual({ x: 40, y: 100 - 34 * 2, width: 0, height: 20 * 2 });\npackages/axylo/test/core/focus.test.ts:123:describe('zoom arithmetic (spec I3)', () => {\npackages/axylo/test/core/focus.test.ts:124:  it('halves and doubles around a centre, stays inside the full range, and returns to null at full width', () => {\npackages/axylo/test/core/focus.test.ts:125:    expect(scaleWindow([0, 100], [0, 100], 0.5, 50, 1)).toEqual([25, 75]);\npackages/axylo/test/core/focus.test.ts:126:    expect(scaleWindow([0, 100], [25, 75], 2, 50, 1)).toBeNull();\npackages/axylo/test/core/focus.test.ts:127:    expect(scaleWindow([0, 100], [0, 20], 0.5, 0, 1)).toEqual([0, 10]);\npackages/axylo/test/core/focus.test.ts:128:    expect(scaleWindow([0, 100], [80, 100], 2, 100, 1)).toEqual([60, 100]);\npackages/axylo/test/core/focus.test.ts:129:    expect(scaleWindow([0, 100], [40, 42], 0.5, 41, 2)).toEqual([40, 42]);\npackages/axylo/test/core/focus.test.ts:132:  it('pans by a share of the width, clamped; at the edge it does not move', () => {\npackages/axylo/test/core/focus.test.ts:133:    expect(panWindow([0, 100], [20, 40], 0.1)).toEqual([22, 42]);\npackages/axylo/test/core/focus.test.ts:134:    expect(panWindow([0, 100], [80, 100], 0.1)).toBeNull();\npackages/axylo/test/core/focus.test.ts:135:    expect(panWindow([0, 100], [5, 25], -0.5)).toEqual([0, 20]);\npackages/axylo/test/core/focus.test.ts:138:  it('for any window and factor the result lies inside the full range and keeps the minimum width', () => {\npackages/axylo/test/core/focus.test.ts:139:    fc.assert(fc.property(\npackages/axylo/test/core/focus.test.ts:146:        expect(next[0]).toBeGreaterThanOrEqual(0);\npackages/axylo/test/core/focus.test.ts:147:        expect(next[1]).toBeLessThanOrEqual(100 + 1e-9);\npackages/axylo/test/core/focus.test.ts:148:        expect(next[1] - next[0]).toBeGreaterThanOrEqual(1 - 1e-9);\npackages/axylo/test/core/focus.test.ts:150:    ), { numRuns: 1000 });\npackages/axylo/test/core/focus.test.ts:153:  it('applies to time, date and number x; not to categories, donuts, compact charts or zoom: false (spec 3.6)', () => {\npackages/axylo/test/core/focus.test.ts:155:    expect(zoomApplies(view, undefined)).toBe(true);\npackages/axylo/test/core/focus.test.ts:156:    expect(zoomApplies(view, false)).toBe(false);\npackages/axylo/test/core/focus.test.ts:157:    expect(zoomApplies({ ...view, compact: true }, true)).toBe(false);\npackages/axylo/test/core/focus.test.ts:159:    expect(zoomApplies(aligned(bars, { kind: 'bar' }), true)).toBe(false);\n","exit_code":0,"status":"completed"}}
