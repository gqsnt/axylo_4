{"type":"item.started","item":{"id":"item_32","type":"command_execution","command":"/bin/bash -lc \"cat > acceptance/.fill.mjs <<'EOF'\nimport { readFileSync, writeFileSync } from 'node:fs';\n\nconst matrix = [];\nconst all = ['line', 'area', 'bar', 'scatter', 'donut', 'compact'];\nconst full = 'line area bar scatter donut';\nconst cart = 'line area bar scatter';\nconst compactOnly = 'Defined for the compact variant in section 3.7.';\nconst noCompact = 'Compact has marks and a text alternative only.';\nconst noDonut = 'Donut uses slices, without Cartesian axes.';\nconst missingSeries = 'Donut uses slices rather than toggleable series.';\nconst barArea = 'Only bars and areas have this baseline or stack rule.';\nconst unit = (file, title) => ({ kind: 'unit', file: 'packages/axylo/test/' + file + '.test.ts', title });\nconst property = (file, title) => ({ ...unit(file, title), kind: 'property' });\nconst browser = (file, title) => ({ kind: 'browser', file: 'packages/axylo/test/browser/' + file + '.browser.test.ts', title });\nconst suite = ({ kind, file }, prefix) => ({ kind, file, prefix });\nconst doc = file => ({ kind: 'document', file });\nconst benchmark = (file, workload, history, reason) => ({\n  kind: 'benchmark', file, workload,\n  ...(history?.length ? { history: history.map(file => 'bench/history/20261118T' + file + '.json') } : {}),\n  ...(reason ? { reason } : {}),\n});\nconst expand = mapping => Object.fromEntries(Object.entries(mapping ?? {}).flatMap(([types, refs]) => types.split(' ').map(type => [type, refs])));\nconst weak = (ref, reason) => ({ ...ref, reason });\nfunction add(id, statement, types, excluded, data = {}) {\n  const appliesTo = types.split(' ');\n  const notApplicable = Object.fromEntries(all.filter(type => \"'!appliesTo.includes(type))\n    .map(type => [type, typeof excluded === '\"'string' ? excluded : excluded[type]]));\n  const row = { id, statement, appliesTo, notApplicable };\n  for (const [field, mapping] of Object.entries(data))