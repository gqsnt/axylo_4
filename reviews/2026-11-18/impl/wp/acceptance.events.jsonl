es]: 'No complete bytes workload or matching history in bench. The targets remain provisional.' },\n});\nadd('P7', 'Measure owned bytes beyond one million caller points and heap trends over 1,000 create–destroy cycles after collection.', allTypes, '', {\n  evidence: { line: [benchmark('bench/src/page.js', 'first 1×1M with memory sampling', [firstMillion], 'Records heap and process memory, without a create–destroy trend.')] },\n  weak: { line: [weak(memory, 'Checks retained objects across 1,000 chart lifecycles, without the one-million-point owned memory measurement or a linked history file.')] },\n  pending: { line: provisional, 'area bar scatter donut compact': 'No per-type forced-GC memory measurement and lifecycle trend in benchmark history. Limits are provisional.' },\n});\nadd('P8', 'Create 40 compact charts · median total main-thread task time.', 'compact', 'The workload is explicitly 40 compact charts.', {\n  pending: { compact: noWorkload },\n});\n\nwriteFileSync('acceptance/matrix.json', JSON.stringify(matrix, null, 2) + '\\\\n');\nEOF\nnode acceptance/.fill.mjs\nwc -l acceptance/matrix.json\"","aggregated_output":"3306 acceptance/matrix.json\n","exit_code":0,"status":"completed"}}
