{"type":"item.completed","item":{"id":"item_11","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/browser/a11y/{axe,keyboard}.browser.test.ts'","aggregated_output":"/**\n * Automated accessibility checks (spec A8, L2, A10, I5, L4): axe-core on every fixture in every state,\n * forced colors and reduced motion emulation, and built-in English marked on a page in another language.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport type { Page } from 'playwright-core';\nimport { start, stop } from '../harness';\nimport { closePage } from '../chart/util';\nimport { axe, FIXTURES, fixturePage, make, type FixtureName } from './util';\n\nbeforeAll(start);\nafterAll(stop);\n\n/** The chart inside a page with its own structure, as a dashboard would have it. */\nasync function structuredPage(options: Parameters<typeof fixturePage>[0] = {}): Promise<Page> {\n  const page = await fixturePage(options);\n  await page.evaluate(() => {\n    const main = document.createElement('main');\n    const h1 = Object.assign(document.createElement('h1'), { textContent: 'Dashboard' });\n    const h2 = Object.assign(document.createElement('h2'), { textContent: 'Traffic' });\n    const chart = document.getElementById('chart')!;\n    chart.replaceWith(main);\n    main.append(h1, h2, chart);\n  });\n  return page;\n}\n\nconst settle = (page: Page) => page.evaluate(async () => { for (const c of window.charts) await c.__bench.ready(); await window.nextFrames(1); });\n\ntype State = 'default' | 'table open' | 'tooltip shown' | 'series hidden';\n\nasync function enter(page: Page, state: State): Promise<boolean> {\n  if (state === 'default') return true;\n  if (state === 'table open') {\n    const toggle = page.locator('#chart .axylo-toolbar button', { hasText: 'View as table' });\n    if (!(await toggle.count())) return false;\n    await toggle.click();\n    return true;\n  }\n  if (state === 'tooltip shown') {\n    const proxy = page.locator('#chart .axylo-proxy');\n    if (!(await proxy.count()) || !(await proxy.isVisible())) return false;\n    // The keyboard shows the tooltip at a datum on every chart type, wherever its marks are.\n    await proxy.focus();\n    await page.keyboard.press('ArrowRight');\n    return page.locator('#chart .axylo-tooltip').first().isVisible();\n  }\n  const entry = page.locator('#chart .axylo-legend-entry').first();\n  if (!(await entry.count())) return false;\n  await entry.click();\n  await settle(page);\n  return true;\n}\n\ndescribe('axe-core reports no violations (spec A8)', () => {\n  for (const fixture of FIXTURES) {\n    it(`${fixture}: default, table open, tooltip shown, series hidden`, async () => {\n      const page = await structuredPage();\n      await make(page, fixture as FixtureName);\n      const report: Record<string, string[]> = {};\n      const applied: State[] = [];\n      for (const state of ['default', 'tooltip shown', 'series hidden', 'table open'] as const) {\n        if (!(await enter(page, state))) continue;\n        applied.push(state);\n        const { violations, ran } = await axe(page);\n        report[state] = violations.map(v => `${v.id}: ${v.help} (${v.nodes.join(', ')})`);\n        expect(ran).toContain('heading-order');\n        // The rule applies only where the region scrolls: the trend table's 120 rows do.\n        if (state === 'table open' && fixture === 'trend') expect(ran).toContain('scrollable-region-focusable');\n      }\n      expect(report).toEqual(Object.fromEntries(applied.map(s => [s, []])));\n      // Which states apply follows from the fixture (spec C1, L7, 3.6).\n      const interactive = ['trend', 'bars', 'parts', 'scatter', 'stacked', 'dirty'].includes(fixture);\n      expect(applied.includes('table open')).toBe(interactive);\n      expect(applied.includes('tooltip shown')).toBe(interactive);\n      expect(applied.includes('series hidden')).toBe(['trend', 'scatter', 'stacked'].includes(fixture));\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\ndescribe('forced colors and reduced motion (spec L4, I5, A2)', () => {\n  it('every control and the focus indicator are visible in forced colors; nothing animates under reduced motion', async () => {\n    const page = await structuredPage({ forcedColors: 'active', reducedMotion: 'reduce' });\n    await make(page, 'trend');\n    await page.evaluate(async () => { window.charts[0]!.append([{ day: Date.UTC(2026, 4, 1), channel: 'Direct', sessions: 40000 }]); await window.charts[0]!.__bench.ready(); });\n    await page.locator('#chart .axylo-toolbar button', { hasText: 'Zoom in' }).click();\n    await settle(page);\n    const controls = await page.evaluate(() => [...document.querySelectorAll<HTMLElement>('#chart .axylo-toolbar button')].map(b => {\n      const s = getComputedStyle(b);\n      const r = b.getBoundingClientRect();\n      const swatch = b.querySelector('svg');\n      return {\n        text: b.textContent, width: r.width, height: r.height, color: s.color, background: s.backgroundColor,\n        swatch: swatch ? getComputedStyle(swatch).color : null,\n      };\n    }));\n    expect(controls.map(c => c.text)).toEqual(['Direct', 'Organic search', 'Referral', 'Zoom in', 'Zoom out', 'Reset zoom', 'Pause', 'View as table']);\n    for (const c of controls) {\n      expect(c.width).toBeGreaterThanOrEqual(24);\n      expect(c.height).toBeGreaterThanOrEqual(24);\n      expect(c.color).not.toBe(c.background);\n      if (c.swatch !== null) expect(c.swatch).not.toBe(c.background);\n    }\n    await page.focus('#chart .axylo-proxy');\n    await page.keyboard.press('ArrowRight');\n    const ring = await page.locator('#chart .axylo-focus-ring').evaluate(el => {\n      const s = getComputedStyle(el);\n      return { display: s.display, width: parseFloat(s.outlineWidth), style: s.outlineStyle, color: s.outlineColor, page: getComputedStyle(document.body).backgroundColor };\n    });\n    expect(ring).toMatchObject({ display: 'block', style: 'solid' });\n    expect(ring.width).toBeGreaterThanOrEqual(2);\n    expect(ring.color).not.toBe(ring.page);\n    await page.keyboard.press('Tab');\n    const button = await page.evaluate(() => {\n      const s = getComputedStyle(document.activeElement!);\n      return { style: s.outlineStyle, width: parseFloat(s.outlineWidth) };\n    });\n    expect(button.style).not.toBe('none');\n    expect(button.width).toBeGreaterThanOrEqual(2);\n    const motion = await page.evaluate(() => ({\n      animations: document.getAnimations().length,\n      transitions: [...document.querySelectorAll('#chart *')].filter(el => {\n        const s = getComputedStyle(el);\n        return s.transitionDuration.split(',').some(d => parseFloat(d) > 0) || s.animationName !== 'none';\n      }).length,\n    }));\n    expect(motion).toEqual({ animations: 0, transitions: 0 });\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('language (spec A10)', () => {\n  it('on a lang=\"de\" page built-in strings carry lang=\"en\"; an overridden string and the series names are in the page language', async () => {\n    const page = await fixturePage();\n    await page.evaluate(() => { document.documentElement.lang = 'de'; });\n    await make(page, 'trend', { messages: { zoomIn: 'Vergrößern' } });\n    const langs = await page.evaluate(() => {\n      const lang = (el: Element | null) => el?.closest('[lang]')?.getAttribute('lang') ?? null;\n      const button = (text: string) => [...document.querySelectorAll('#chart .axylo-toolbar button')].find(b => b.textContent === text) ?? null;\n      return {\n        toolbar: document.querySelector('#chart .axylo-toolbar')!.getAttribute('lang'),\n        zoomIn: button('Vergrößern')?.getAttribute('lang') ?? null, zoomInEffective: lang(button('Vergrößern')),\n        zoomOut: button('Zoom out')?.getAttribute('lang') ?? null,\n        table: button('View as table')?.getAttribute('lang') ?? null,\n        legend: lang(button('Direct')),\n      };\n    });\n    expect(langs).toEqual({ toolbar: 'en', zoomIn: 'de', zoomInEffective: 'de', zoomOut: 'en', table: 'en', legend: 'de' });\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('an overridden string is not marked English, even inherited, when it is the only text', async () => {\n    const page = await fixturePage();\n    await page.evaluate(() => { document.documentElement.lang = 'de'; });\n    await make(page, 'loading', { messages: { loading: 'Diagramm wird geladen.' } });\n    expect(await page.locator('#chart .axylo-message').evaluate(el => el.closest('[lang]')?.getAttribute('lang'))).toBe('de');\n    await page.evaluate(async () => { window.charts[0]!.update({ messages: undefined }); await window.charts[0]!.__bench.ready(); });\n    expect(await page.locator('#chart .axylo-message').getAttribute('lang')).toBe('en');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('on an English page nothing is marked', async () => {\n    const page = await fixturePage();\n    await make(page, 'trend');\n    expect(await page.locator('#chart [lang]').count()).toBe(0);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n/**\n * Keyboard and screen-reader proxy (decision 0001; spec A2, A3, A7). Expected text comes from the trend\n * fixture (three series over 120 UTC days, Referral null on days 60–66) and the built-in messages; the\n * accessibility node is read from Chrome itself through the DevTools protocol after each step.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport type { Page } from 'playwright-core';\nimport { start, stop } from '../harness';\nimport { aria, closePage } from '../chart/util';\nimport { axNode, fixturePage, make, tabStops } from './util';\n\nbeforeAll(start);\nafterAll(stop);\n\nconst SHOW_BUTTONS = '#before, #after { display: inline-block !important; }';\nconst DAY = 864e5;\nconst START = Date.UTC(2026, 0, 1);\nconst number = (v: number) => new Intl.NumberFormat('en-US').format(v);\nconst date = (i: number) => new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' }).format(START + i * DAY);\n\nasync function trendValues(page: Page): Promise<{ name: string; values: (number | null)[] }[]> {\n  return page.evaluate(() => window.fx.trend.series);\n}\n\nconst valueText = (page: Page) => page.locator('#chart .axylo-proxy').getAttribute('aria-valuetext');\n\ndescribe('tab order (spec A2): the plot, then the toolbar, then out', () => {\n  const states: [string, (page: Page) => Promise<void>][] = [\n    ['default', async () => {}],\n    ['zoomed', async page => {\n      await page.evaluate(async () => {\n        const c = window.charts[0]!;\n        c.zoom([Date.UTC(2026, 1, 1), Date.UTC(2026, 2, 1)]);\n        await c.__bench.ready();\n        await window.nextFrames(1);\n      });\n    }],\n    ['streaming', async page => {\n      await page.evaluate(async () => {\n        const c = window.charts[0]!;\n        c.append([{ day: Date.UTC(2026, 4, 1), channel: 'Direct', sessions: 41000 }], { keep: 120 });\n        await c.__bench.ready();\n        await window.nextFrames(1);\n      });\n    }],\n    ['hidden series', async page => {\n      await page.locator('#chart .axylo-legend-entry', { hasText: 'Referral' }).click();\n      await page.evaluate(async () => { await window.charts[0]!.__bench.ready(); await window.nextFrames(1); });\n    }],\n  ];\n  for (const [state, enter] of states) {\n    it(`exactly two stops in the ${state} state, forwards and backwards`, async () => {\n      const page = await fixturePage({ css: SHOW_BUTTONS });\n      await make(page, 'trend');\n      await enter(page);\n      const forwards = await tabStops(page);\n      expect(forwards[0]).toBe('proxy');\n      expect(forwards[1]).toMatch(/^toolbar:/);\n      expect(forwards.slice(2)).toEqual(['after']);\n      const backwards = await tabStops(page, true);\n      expect(backwards[0]).toMatch(/^toolbar:/);\n      expect(backwards[1]).toBe('proxy');\n      expect(backwards.slice(2)).toEqual(['before']);\n      if (state === 'streaming') expect(await page.locator('#chart .axylo-toolbar').textContent()).toContain('Pause');\n      if (state === 'zoomed') expect(await page.locator('#chart .axylo-toolbar').textContent()).toContain('Reset zoom');\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('the toolbar has roving focus: arrows, Home and End move within it; one tab stop', async () => {\n    const page = await fixturePage({ css: SHOW_BUTTONS });\n    await make(page, 'trend');\n    await page.focus('#before');\n    await page.keyboard.press('Tab');\n    await page.keyboard.press('Tab');\n    const label = () => page.evaluate(() => document.activeElement?.textContent ?? '');\n    expect(await label()).toBe('Direct');\n    await page.keyboard.press('ArrowRight');\n    expect(await label()).toBe('Organic search');\n    await page.keyboard.press('End');\n    expect(await label()).toBe('View as table');\n    await page.keyboard.press('Home');\n    expect(await label()).toBe('Direct');\n    await page.keyboard.press('ArrowLeft');\n    expect(await label()).toBe('View as table');\n    // Leaving and coming back lands on the control last used.\n    await page.keyboard.press('Shift+Tab');\n    await page.keyboard.press('Tab');\n    expect(await label()).toBe('View as table');\n    expect(await page.locator('#chart [role=\"toolbar\"] [tabindex=\"0\"]').count()).toBe(1);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('the table, once open, adds its scroll region after the toolbar; focus still leaves the chart', async () => {\n    const page = await fixturePage({ css: SHOW_BUTTONS });\n    await make(page, 'trend');\n    await page.locator('#chart button', { hasText: 'View as table' }).click();\n    const stops = await tabStops(page);\n    expect(stops.slice(0, 3)).toEqual(['proxy', expect.stringMatching(/^toolbar:/), 'table']);\n    expect(stops.at(-1)).toBe('after');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('a compact chart adds no tab stop (spec C1)', async () => {\n    const page = await fixturePage({ css: SHOW_BUTTONS });\n    await make(page, 'compact');\n    expect(await tabStops(page)).toEqual(['after']);\n    expect(await page.locator('#chart input, #chart button').count()).toBe(0);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('keyboard walk on the trend fixture (decision 0001)', () => {\n  it('reads every series at x, narrows to one with Down, reaches the ends, pages by a tenth, and selects', async () => {\n    const page = await fixturePage({ css: SHOW_BUTTONS });\n    await make(page, 'trend');\n    const series = await trendValues(page);\n    await page.evaluate(() => {\n      (window as unknown as { selected: unknown[] }).selected = [];\n      window.charts[0]!.on('select', p => {\n        const point = p as { series: string; x: Date; y: number | null; index: number };\n        (window as unknown as { selected: unknown[] }).selected.push({ series: point.series, x: point.x.toISOString(), y: point.y });\n      });\n    });\n    await page.focus('#before');\n    await page.keyboard.press('Tab');\n    let node = await axNode(page, '#chart .axylo-proxy');\n    expect(node).toMatchObject({ role: 'slider', name: 'Chart plot', roledescription: 'Line', focused: true, value: '0', max: 119 });\n    expect(node.text).toContain(date(0));\n    for (let i = 0; i < 3; i++) await page.keyboard.press('ArrowRight');\n\n    // Fourth x, all three series with their values, ending with the position.\n    node = await axNode(page, '#chart .axylo-proxy');\n    expect(node.role).toBe('slider');\n    expect(node.text.startsWith(date(3))).toBe(true);\n    for (const s of series) expect(node.text).toContain(`${s.name} ${number(s.values[3]!)}`);\n    expect(node.text.endsWith('Point 4 of 120.')).toBe(true);\n    expect(node).toMatchObject({ value: '3', max: 119, focused: true });\n    const tree = await aria(page);\n    expect(tree).toContain('slider \"Chart plot\"');\n    expect(tree).toContain('toolbar \"Chart controls\"');\n\n    // Down narrows to the first series, again to the second.\n    await page.keyboard.press('ArrowDown');\n    node = await axNode(page, '#chart .axylo-proxy');\n    expect(node.text.startsWith(`Direct, ${date(3)}`)).toBe(true);\n    expect(node.text.endsWith(`, ${number(series[0]!.values[3]!)}. Point 4 of 120.`)).toBe(true);\n    expect(node.text).not.toContain('Organic');\n    await page.keyboard.press('ArrowDown');\n    node = await axNode(page, '#chart .axylo-proxy');\n    expect(node.text.startsWith(`Organic search, ${date(3)}`)).toBe(true);\n    expect(node.text).toContain(number(series[1]!.values[3]!));\n\n    // Home and End reach the ends; Page Down moves back by a tenth (12 of 120).\n    await page.keyboard.press('Home');\n    node = await axNode(page, '#chart .axylo-proxy');\n    expect(node.text.startsWith(`Organic search, ${date(0)}`)).toBe(true);\n    expect(node.text.endsWith('Point 1 of 120.')).toBe(true);\n    await page.keyboard.press('End');\n    node = await axNode(page, '#chart .axylo-proxy');\n    expect(node.text.startsWith(`Organic search, ${date(119)}`)).toBe(true);\n    expect(node.text.endsWith('Point 120 of 120.')).toBe(true);\n    expect(node.value).toBe('119');\n    await page.keyboard.press('PageDown');\n    node = await axNode(page, '#chart .axylo-proxy');\n    expect(node.text.endsWith('Point 108 of 120.')).toBe(true);\n    expect(node.value).toBe('107');\n    await page.keyboard.press('PageUp');\n    expect((await axNode(page, '#chart .axylo-proxy')).text.endsWith('Point 120 of 120.')).toBe(true);\n    expect(await page.locator('#chart .axylo-proxy').inputValue()).toBe('119');\n\n    // Escape: first the tooltip, then single-series mode, then it is left to the page.\n    expect(await page.locator('#chart .axylo-tooltip').isVisible()).toBe(true);\n    await page.keyboard.press('Escape');\n    expect(await page.locator('#chart .axylo-tooltip').isVisible()).toBe(false);\n    expect((await axNode(page, '#chart .axylo-proxy')).text.startsWith('Organic search, ')).toBe(true);\n    await page.keyboard.press('Escape');\n    node = await axNode(page, '#chart .axylo-proxy');\n    expect(node.text.startsWith(date(119) + ', 12:00 AM UTC: Direct ')).toBe(true);\n    const escape = await page.evaluate(() => new Promise<boolean>(resolve => {\n      document.addEventListener('keydown', e => resolve(e.defaultPrevented), { once: true });\n      document.querySelector<HTMLElement>('#chart .axylo-proxy')!.dispatchEvent(new KeyboardEvent('keydown', { key: 'Escape', bubbles: true, cancelable: true }));\n    }));\n    expect(escape).toBe(false);\n\n    // Enter selects the datum the reader is on: the last day, the first series with a value.\n    await page.keyboard.press('Enter');\n    await page.keyboard.press('ArrowLeft');\n    await page.keyboard.press(' ');\n    const selected = await page.evaluate(() => (window as unknown as { selected: unknown[] }).selected);\n    expect(selected).toEqual([\n      { series: 'Direct', x: new Date(START + 119 * DAY).toISOString(), y: series[0]!.values[119] },\n      { series: 'Direct', x: new Date(START + 118 * DAY).toISOString(), y: series[0]!.values[118] },\n    ]);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('the focus ring is at least 2 px in the focus color and is drawn only for keyboard focus', async () => {\n    const page = await fixturePage({ css: SHOW_BUTTONS });\n    await make(page, 'trend');\n    const ring = page.locator('#chart .axylo-focus-ring');\n    expect(await ring.isVisible()).toBe(false);\n    await page.focus('#before');\n    await page.keyboard.press('Tab');\n    expect(await ring.isVisible()).toBe(true);\n    const style = await ring.evaluate(el => {\n      const s = getComputedStyle(el);\n      return { width: parseFloat(s.outlineWidth), style: s.outlineStyle, color: s.outlineColor };\n    });\n    expect(style.width).toBeGreaterThanOrEqual(2);\n    expect(style.style).toBe('solid');\n    // LIGHT.focus (#1f5fcc) is 6.0:1 on white (theme/palette.ts, spec L2 requires 3:1).\n    expect(style.color).toBe('rgb(31, 95, 204)');\n    // The tooltip sits beside the mark and never over the whole ring.\n    const [tip, box] = await Promise.all([page.locator('#chart .axylo-tooltip').first().boundingBox(), ring.boundingBox()]);\n    expect(tip!.width * tip!.height).toBeLessThan(box!.width * box!.height / 2);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('missing data and hidden series', () => {\n  it('stepping onto the outage reads \"No data\" for Referral; a hidden series is skipped; hiding the focused series keeps the x', async () => {\n    const page = await fixturePage({ css: SHOW_BUTTONS });\n    await make(page, 'trend');\n    await page.focus('#before');\n    await page.keyboard.press('Tab');\n    for (let i = 0; i < 60; i++) await page.keyboard.press('ArrowRight');\n    let text = (await axNode(page, '#chart .axylo-proxy')).text;\n    expect(text.startsWith(date(60))).toBe(true);\n    expect(text).toContain('Referral No data');\n    expect(text.endsWith('Point 61 of 120.')).toBe(true);\n\n    // In single-series mode Referral skips its own outage (lookup.step): from day 59 Right lands on day 67.\n    await page.keyboard.press('ArrowLeft');\n    await page.keyboard.press('ArrowUp');\n    text = (await axNode(page, '#chart .axylo-proxy')).text;\n    expect(text.startsWith(`Referral, ${date(59)}`)).toBe(true);\n    await page.keyboard.press('ArrowRight');\n    text = (await axNode(page, '#chart .axylo-proxy')).text;\n    expect(text.startsWith(`Referral, ${date(67)}`)).toBe(true);\n    expect(text.endsWith('Point 68 of 120.')).toBe(true);\n    await page.keyboard.press('ArrowLeft');\n\n    // Hide the focused series with the legend: focus resolves to the same x.\n    await page.locator('#chart .axylo-legend-entry', { hasText: 'Referral' }).click();\n    await page.evaluate(async () => { await window.charts[0]!.__bench.ready(); await window.nextFrames(1); });\n    text = (await valueText(page))!;\n    expect(text).toContain(date(59));\n    expect(text.endsWith('Point 60 of 120.')).toBe(true);\n    expect(text).not.toContain('Referral');\n\n    // Back on the plot, Up and Down move over the visible series only.\n    await page.focus('#chart .axylo-proxy');\n    await page.keyboard.press('Escape');\n    text = (await axNode(page, '#chart .axylo-proxy')).text;\n    expect(text).not.toContain('Referral');\n    await page.keyboard.press('ArrowDown');\n    await page.keyboard.press('ArrowDown');\n    await page.keyboard.press('ArrowDown');\n    text = (await axNode(page, '#chart .axylo-proxy')).text;\n    expect(text.startsWith(`Organic search, ${date(59)}`)).toBe(true);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/lookup/{aligned,donut,scatter}.test.ts'","aggregated_output":"import fc from 'fast-check';\nimport { describe, expect, it } from 'vitest';\nimport type { AlignedView, DatumRef } from '../../src/core/contracts';\nimport { buildLookup } from '../../src/lookup';\nimport { defaultMessages, pointOf } from '../../src/messages';\nimport { bandScale, linearScale } from '../../src/scale';\nimport { aligned, formatter, frame, plot } from './fixtures';\n\nconst datum = (seriesKey: string, x: number): DatumRef => ({ kind: 'aligned', seriesKey, x });\n\nfunction lookup(view: AlignedView) {\n  const layout = plot({ kind: 'xy', x: linearScale(view.xDomain, [0, 100]), y: linearScale(view.yDomain, [100, 0]) });\n  return buildLookup(view, layout, formatter(view.frame), defaultMessages);\n}\n\ndescribe('aligned picking', () => {\n  it('uses only visible slots, includes both plot edges, and gives midpoints to the later slot', () => {\n    // An irregular step keeps normalization from inserting missing slots between 20 and 50.\n    const data = frame('line', { data: [0, 10, 20, 50, 61].map(x => ({ x, y: 10 })), x: 'x', y: 'y' });\n    const model = lookup(aligned(data, { visibleSlots: { start: 1, end: 4 }, xDomain: [0, 50] }));\n    expect(model.pick(0, 0)).toEqual({ kind: 'x', x: 10 });\n    expect(model.pick(29.99, 90)).toEqual({ kind: 'x', x: 10 });\n    expect(model.pick(30, 90)).toEqual({ kind: 'x', x: 20 });\n    expect(model.pick(70, 10)).toEqual({ kind: 'x', x: 50 });\n    expect(model.pick(100, 100)).toEqual({ kind: 'x', x: 50 });\n    for (const [x, y] of [[-0.1, 50], [100.1, 50], [50, -0.1], [50, 100.1]] as const) expect(model.pick(x, y)).toBeNull();\n  });\n\n  it('picks a horizontal bar by y and returns the grouped mark bounds', () => {\n    const data = frame('bar', { data: [{ x: 'A', a: 2, b: 3 }, { x: 'B', a: 4, b: 5 }], x: 'x', y: ['a', 'b'] });\n    const view = aligned(data, { kind: 'bar', horizontal: true });\n    const layout = plot({ kind: 'bands', horizontal: true, band: bandScale(2, [100, 0], 0), value: linearScale([0, 10], [0, 100]) });\n    const model = buildLookup(view, layout, formatter(data), defaultMessages);\n    expect(model.pick(80, 75)).toEqual({ kind: 'x', x: 0 });\n    expect(model.pick(20, 25)).toEqual({ kind: 'x', x: 1 });\n    expect(model.anchor(datum('a', 0))).toEqual({ x: 0, y: 50, width: 20, height: 25 });\n    expect(model.anchor(datum('b', 1))).toEqual({ x: 0, y: 25, width: 50, height: 25 });\n  });\n});\n\ndescribe('aligned readout and steps', () => {\n  const data = frame('line', { x: 'x', y: { field: 'y', unit: 'ms' }, series: 'series', data: [\n    { x: 0, y: 10, series: 'A' }, { x: 1, y: 20, series: 'B' }, { x: 0, y: null, series: 'C' },\n    { x: 2, y: 30, series: 'A' }, { x: 2, y: 40, series: 'B' },\n  ] });\n\n  it('reads values, absent observations, and explicit nulls in series order', () => {\n    const model = lookup(aligned(data));\n    const target = { kind: 'x', x: 0 } as const;\n    const tooltip = model.tooltip(target);\n    expect(tooltip).toMatchObject({ title: '0', count: 3, total: null });\n    expect(tooltip.rows.map(({ seriesLabel, value, row }) => [seriesLabel, value, row])).toEqual([\n      ['A', '10 ms', 0], ['B', 'No observation', -1], ['C', 'No data', 2],\n    ]);\n    expect(model.primary(target)).toEqual(datum('A', 0));\n    expect(model.primary({ kind: 'x', x: 1 })).toEqual(datum('B', 1));\n    expect(model.anchor(datum('B', 0))).toBeNull();\n    const hidden = lookup(aligned(data, { visible: [false, true, true] }));\n    expect(hidden.tooltip(target).rows.map(row => row.seriesLabel)).toEqual(['B', 'C']);\n    expect(hidden.primary(target)).toEqual(datum('B', 0));\n  });\n\n  it('counts all nine series but returns only the first eight tooltip rows', () => {\n    const series = Array.from({ length: 9 }, (_, i) => ({ x: 0, y: i, key: `S${i}` }));\n    const model = lookup(aligned(frame('line', { data: series, x: 'x', y: 'y', series: 'key' })));\n    const { rows, count } = model.tooltip({ kind: 'x', x: 0 });\n    expect(count).toBe(9);\n    expect(rows.map(row => row.seriesLabel)).toEqual(series.slice(0, 8).map(row => row.key));\n  });\n\n  it('formats stacked totals and preserves the incomplete marker for announcements', () => {\n    const stacked = frame('area', { data: [{ x: 0, a: 3, b: null, c: -2 }, { x: 1, a: 3, b: 4, c: -2 }], x: 'x', y: ['a', 'b', 'c'] });\n    const model = lookup(aligned(stacked, { kind: 'area', stack: {\n      order: [0, 1, 2], incomplete: Uint8Array.of(1, 0),\n      positive: [Float64Array.of(3, 3), Float64Array.of(3, 7), Float64Array.of(3, 7)],\n      negative: [Float64Array.of(0, 0), Float64Array.of(0, 0), Float64Array.of(-2, -2)],\n    } }));\n    expect(model.tooltip({ kind: 'x', x: 0 }).total).toBe('1 (incomplete)');\n    expect(model.tooltip({ kind: 'x', x: 0 }).rows[1]?.value).toBe('No data');\n    expect(model.tooltip({ kind: 'x', x: 1 }).total).toBe('5');\n    expect(model.datum(datum('b', 0))?.value).toBe('No data (incomplete)');\n  });\n\n  it('steps within a series, switches series at the same x, and ranks by visible slot', () => {\n    const model = lookup(aligned(data));\n    expect(model.step(null, 'next')).toEqual(datum('A', 0));\n    expect(model.step(datum('A', 0), 'next')).toEqual(datum('A', 2));\n    expect(model.step(datum('A', 2), 'previous')).toEqual(datum('A', 0));\n    expect(model.step(datum('A', 0), 'series-next')).toEqual(datum('B', 0));\n    expect(model.step(datum('B', 0), 'series-previous')).toEqual(datum('A', 0));\n    expect(model.datum(datum('B', 0))?.value).toBe('No observation');\n    expect(model.ordinal(datum('B', 0))).toBe(0);\n    const formatters = { ...formatter(data), count: (n: number) => `count(${n})` };\n    expect(pointOf(model, datum('B', 0), formatters, defaultMessages))\n      .toBe('B, 0, No observation. Point count(1) of count(3).');\n    expect(pointOf(model, datum('B', -1), formatters, defaultMessages)).toBeNull();\n    expect(model.step(datum('B', 0), 'first')).toEqual(datum('B', 1));\n    expect(model.step(datum('B', 1), 'last')).toEqual(datum('B', 2));\n    expect([datum('A', 0), datum('B', 1), datum('A', 2), datum('B', 2)].map(ref => model.ordinal(ref))).toEqual([0, 1, 2, 2]);\n    expect(model.count).toBe(3);\n  });\n\n  it('pages by a tenth of the visible slots, then skips a gap in the direction of travel', () => {\n    const data = frame('line', { data: Array.from({ length: 50 }, (_, x) => ({ x, y: x === 11 ? null : x })), x: 'x', y: 'y' });\n    const model = lookup(aligned(data, { visibleSlots: { start: 8, end: 28 } }));\n    expect(model.step(datum('y', 9), 'page-next')).toEqual(datum('y', 12));\n    expect(model.step(datum('y', 13), 'page-previous')).toEqual(datum('y', 10));\n    expect(model.step(datum('y', 13), 'first')).toEqual(datum('y', 8));\n    expect(model.step(datum('y', 13), 'last')).toEqual(datum('y', 27));\n    expect(model.step(datum('y', 27), 'page-next')).toBeNull();\n  });\n\n  it('assigns the same visible-slot ordinal across series and skips a hidden middle series', () => {\n    const value = fc.option(fc.integer({ min: 0, max: 99 }), { nil: null });\n    fc.assert(fc.property(fc.array(fc.tuple(value, value), { minLength: 2, maxLength: 50 }),\n      fc.nat(50), fc.nat(50), (values, a, b) => {\n        const start = Math.min(a % values.length, b % values.length);\n        const end = Math.max(a % values.length, b % values.length) + 1;\n        const data = frame('line', { data: values.map(([a, b], x) => ({ x, a, hidden: 1, b })), x: 'x', y: ['a', 'hidden', 'b'] });\n        const model = lookup(aligned(data, { visibleSlots: { start, end }, visible: [true, false, true] }));\n        expect(model.count).toBe(end - start);\n        for (let x = start; x < end; x++) {\n          const first = datum('a', x);\n          const second = datum('b', x);\n          expect(model.step(first, 'series-next')).toEqual(second);\n          expect(model.ordinal(first)).toBe(x - start);\n          expect(model.ordinal(second)).toBe(x - start);\n          expect(model.ordinal(datum('hidden', x))).toBe(-1);\n          expect(model.datum(second)).not.toBeNull();\n          const next = values.findIndex(([value], i) => i > x && i < end && value !== null);\n          expect(model.step(first, 'next')).toEqual(next < 0 ? null : datum('a', next));\n        }\n      }), { numRuns: 100 });\n  });\n\n  it('resolves hidden aligned focus and steps from the primary datum', () => {\n    const data = frame('line', { data: [0, 1, 2, 3].map(x => ({ x, a: x, b: x })), x: 'x', y: ['a', 'b'] });\n    const model = lookup(aligned(data, { visible: [true, false] }));\n    const from = datum('b', 1);\n    expect(model.resolve(from)).toEqual(datum('a', 1));\n    expect(model.step(from, 'next')).toEqual(datum('a', 2));\n    expect(model.step(from, 'first')).toEqual(datum('a', 0));\n    expect(model.resolve(datum('b', -1))).toBeNull();\n  });\n\n  it('resolves zoomed-out aligned focus to the next value in range, then the previous one', () => {\n    const data = frame('line', { data: [0, 1, 2, 3, 4, 5].map(x => ({ x, y: x === 1 ? null : x })), x: 'x', y: 'y' });\n    const model = lookup(aligned(data, { visibleSlots: { start: 1, end: 5 } }));\n    expect(model.resolve(datum('y', 0))).toEqual(datum('y', 2));\n    expect(model.resolve(datum('y', 5))).toEqual(datum('y', 4));\n    expect(model.step(datum('y', 0), 'next')).toEqual(datum('y', 3));\n    expect(model.step(datum('y', 5), 'previous')).toEqual(datum('y', 3));\n    expect(model.step(datum('y', 2), 'first')).toBeNull();\n  });\n\n  it('resolves identity across eviction and anchors a survivor at its new pixel', () => {\n    function window(start: number, revision: number) {\n      const first = frame('line', { data: Array.from({ length: 11 }, (_, i) => ({ x: start + i, y: 20 })), x: 'x', y: 'y' }, revision);\n      // Retained source rows keep their original indexes across an append in the same epoch.\n      return lookup(aligned({ ...first, series: first.series.map(s => ({ ...s, row: Int32Array.from(s.y, (_, i) => start + i) })) }));\n    }\n    const first = window(0, 1);\n    const second = window(5, 2);\n    const surviving = datum('y', 7);\n    const evicted = datum('y', 3);\n    expect(second.resolve(surviving)).toBe(surviving);\n    expect(second.datum(surviving)).toEqual(first.datum(surviving));\n    expect(second.datum(evicted)).toBeNull();\n    expect(second.resolve(evicted)).toEqual(datum('y', 5));\n    expect(second.resolve(datum('y', 17))).toEqual(datum('y', 15));\n    expect(first.anchor(surviving)).toEqual({ x: 70, y: 80, width: 0, height: 0 });\n    expect(second.anchor(surviving)).toEqual({ x: 20, y: 80, width: 0, height: 0 });\n  });\n});\n\nit('uses the later instant at a midpoint on a reversed, irregular time scale', () => {\n  const data = frame('line', { data: [0, 1000, 4000, 7001].map(x => ({ x, y: 10 })), x: { field: 'x', type: 'time' }, y: 'y' });\n  const view = aligned(data, { visibleSlots: { start: 0, end: 3 }, xDomain: [0, 4000] });\n  const model = buildLookup(view, plot({\n    kind: 'xy', x: linearScale(view.xDomain, [100, 0]), y: linearScale([0, 10], [100, 0]),\n  }), formatter(data), defaultMessages);\n  expect(model.pick(100, 50)).toEqual({ kind: 'x', x: 0 });\n  expect(model.pick(37.51, 50)).toEqual({ kind: 'x', x: 1000 });\n  expect(model.pick(37.5, 50)).toEqual({ kind: 'x', x: 4000 });\n  expect(model.pick(0, 50)).toEqual({ kind: 'x', x: 4000 });\n});\n\nit('reads a stack total with no components as missing', () => {\n  const data = frame('area', { data: [{ x: 0, a: null, b: null }], x: 'x', y: ['a', 'b'] });\n  const model = lookup(aligned(data, { kind: 'area', stack: {\n    order: [0, 1], incomplete: Uint8Array.of(1),\n    positive: [Float64Array.of(0), Float64Array.of(0)], negative: [Float64Array.of(0), Float64Array.of(0)],\n  } }));\n  expect(model.tooltip({ kind: 'x', x: 0 }).total).toBe('No data');\n});\nimport { expect, it } from 'vitest';\nimport type { DatumRef } from '../../src/core/contracts';\nimport { buildLookup } from '../../src/lookup';\nimport { defaultMessages } from '../../src/messages';\nimport { donut, formatter, frame, plot } from './fixtures';\n\nconst parts = [\n  ['Chrome', 46.2], ['Safari', 27.5], ['Edge', 14.1], ['Firefox', 8.9], ['Samsung Internet', 2.1], ['Other', 1.2],\n] as const;\nconst layout = plot({ kind: 'ring', cx: 50, cy: 50, r0: 20, r1: 40 });\nconst data = frame('donut', { data: [...parts, ['Zero', 0], ['No sample', null]].map(([category, value]) => ({ category, value })),\n  label: 'category', value: { field: 'value', scale: 'percent' } });\nconst model = buildLookup(donut(data), layout, formatter(data), defaultMessages, 'en-US');\n\nit('picks the parts fixture from 12 o’clock clockwise within the ring', () => {\n  expect(model.pick(50, 20)).toEqual({ kind: 'slice', sliceKey: 'Chrome' });\n  expect(model.pick(80, 50)).toEqual({ kind: 'slice', sliceKey: 'Chrome' });\n  expect(model.pick(50, 80)).toEqual({ kind: 'slice', sliceKey: 'Safari' });\n  expect(model.pick(50, 50)).toBeNull();\n  expect(model.pick(50, 5)).toBeNull();\n  const target = model.pick(50, 20)!;\n  expect(model.tooltip(target)).toMatchObject({ title: 'Chrome', count: 1, total: null,\n    rows: [{ value: '46.2%', percent: '46.2%', seriesLabel: 'Chrome', row: 0 }] });\n  const anchor = model.anchor(model.primary(target)!);\n  expect(anchor?.x).toBeCloseTo(50);\n  expect(anchor?.y).toBeCloseTo(10);\n  expect(anchor?.width).toBeCloseTo(40);\n  expect(anchor?.height).toBeCloseTo(40 * (1 - Math.cos(0.462 * 2 * Math.PI)));\n});\n\nit('includes zero and missing slices in keyboard order, with no drawn anchor', () => {\n  const zero: DatumRef = { kind: 'slice', sliceKey: 'Zero' };\n  const missing: DatumRef = { kind: 'slice', sliceKey: 'No sample' };\n  expect(model.count).toBe(8);\n  expect(model.step({ kind: 'slice', sliceKey: 'Other' }, 'next')).toEqual(zero);\n  expect(model.step(zero, 'next')).toEqual(missing);\n  expect(model.ordinal(zero)).toBe(6);\n  expect(model.anchor(zero)).toBeNull();\n  expect(model.anchor(missing)).toBeNull();\n  expect(model.datum(zero)).toMatchObject({ value: '0%', percent: '0%' });\n  expect(model.datum(missing)).toMatchObject({ value: 'No data', percent: null });\n});\n\nit('resolves a folded category through Other and returns null for a step that cannot move', () => {\n  const original = donut(data);\n  const grouped = buildLookup({\n    ...original,\n    slices: [original.slices[0]!, { key: '__other__', label: 'Other (2)', colorIndex: 1, members: [1, 2], value: 41.6, ratio: 0.416, angles: [3, 6] }],\n  }, layout, formatter(data), defaultMessages);\n  const stale = { kind: 'slice', sliceKey: 'Safari' } as const;\n  expect(grouped.resolve(stale)).toEqual({ kind: 'slice', sliceKey: '__other__' });\n  expect(grouped.step(stale, 'previous')).toEqual({ kind: 'slice', sliceKey: 'Chrome' });\n  expect(grouped.step(stale, 'page-next')).toBeNull();\n  expect(grouped.step(stale, 'last')).toBeNull();\n  expect(grouped.step({ kind: 'slice', sliceKey: 'Chrome' }, 'page-previous')).toBeNull();\n});\n\nit('formats slice percentages through the supplied formatter regardless of the legacy locale argument', () => {\n  const formatters = { ...formatter(data), percent: (ratio: number) => `share(${ratio.toFixed(3)})` };\n  const lookup = buildLookup(donut(data), layout, formatters, defaultMessages, 'en-US');\n  expect(lookup.datum({ kind: 'slice', sliceKey: 'Chrome' })?.percent).toBe('share(0.462)');\n});\nimport fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport type { DatumRef, PointFrame } from '../../src/core/contracts';\nimport { buildLookup } from '../../src/lookup';\nimport { scatterLookup } from '../../src/lookup/scatter';\nimport { defaultMessages } from '../../src/messages';\nimport { linearScale } from '../../src/scale';\nimport { formatter, frame, plot, scatter } from './fixtures';\n\nconst point = (seriesKey: string, row: number, x: number): DatumRef => ({ kind: 'point', seriesKey, row, x });\n\nfunction points(lists: readonly (readonly (readonly [number, number])[])[]): PointFrame {\n  let row = 0;\n  return {\n    shape: 'points', epoch: 1, revision: 1, source: { rowAt: () => null },\n    xKind: 'number', timeZone: null, xLabel: 'x', yLabel: 'y', xUnit: null, yUnit: null,\n    series: lists.map((list, s) => {\n      const sorted = list.map(([x, y]) => ({ x, y, row: row++ })).sort((a, b) => a.x - b.x || a.y - b.y || a.row - b.row);\n      return {\n        key: `S${s}`, label: `S${s}`, drawable: true, x: Float64Array.from(sorted, p => p.x),\n        y: Float64Array.from(sorted, p => p.y), row: Int32Array.from(sorted, p => p.row),\n      };\n    }),\n  };\n}\nconst layout = plot({ kind: 'xy', x: linearScale([0, 100], [0, 100]), y: linearScale([0, 100], [0, 100]) });\n\nit('picks the nearest point within 24 px and breaks a tie by later source row', () => {\n  const data = frame('scatter', { data: [{ x: 60, y: 50 }, { x: 40, y: 50 }], x: 'x', y: 'y' });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const tie = model.pick(50, 50)!;\n  expect(tie).toEqual({ kind: 'point', refs: [point('y', 1, 40)], count: 1 });\n  expect(model.primary(tie)).toEqual(point('y', 1, 40));\n  expect(model.tooltip(tie)).toMatchObject({ title: '40', count: 1, total: null, rows: [{ seriesLabel: 'y', x: '40', value: '50', row: 1 }] });\n  expect(model.anchor(point('y', 1, 40))).toEqual({ x: 40, y: 50, width: 0, height: 0 });\n  expect(model.pick(16, 50)).toEqual({ kind: 'point', refs: [point('y', 1, 40)], count: 1 });\n  expect(model.pick(15.99, 50)).toBeNull();\n  expect(model.pick(58, 50)).toEqual({ kind: 'point', refs: [point('y', 0, 60)], count: 1 });\n});\n\nit('finds coincident points across a cell boundary and retains the full count after truncation', () => {\n  const points = Array.from({ length: 10 }, (_, i) => ({ x: i % 2 ? 24.1 : 23.9, y: 50, series: `S${i}` }));\n  const input = { x: 'x', y: 'y', series: 'series' };\n  const small = frame('scatter', { ...input, data: points.slice(0, 3) });\n  const all = buildLookup(scatter(small), layout, formatter(small), defaultMessages).pick(23.9, 50)!;\n  expect(all.kind).toBe('point');\n  if (all.kind !== 'point') throw new Error('Expected scatter target');\n  expect(all.count).toBe(3);\n  expect(all.refs[0]).toEqual(point('S2', 2, 23.9));\n  expect(all.refs).toEqual(expect.arrayContaining([point('S0', 0, 23.9), point('S1', 1, 24.1), point('S2', 2, 23.9)]));\n\n  const data = frame('scatter', { ...input, data: [...points, { x: 24.7, y: 50, series: 'Different' }] });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const target = model.pick(24.1, 50)!;\n  expect(target).toMatchObject({ kind: 'point', count: 10 });\n  expect(model.primary(target)).toEqual(point('S9', 9, 24.1));\n  expect(model.tooltip(target).rows).toHaveLength(8);\n  expect(model.tooltip(target).count).toBe(10);\n  expect(model.tooltip(target).rows.some(row => row.seriesLabel === 'Different')).toBe(false);\n});\n\nit('uses screen distance when moving to the neighbouring visible series', () => {\n  const data = frame('scatter', { x: 'x', y: 'y', series: 'series', data: [\n    { x: 10, y: 30, series: 'A' }, { x: 11, y: 31, series: 'Hidden' },\n    { x: 10, y: 80, series: 'B' }, { x: 12, y: 31, series: 'B' },\n  ] });\n  const model = buildLookup(scatter(data, { visible: [true, false, true] }), layout, formatter(data), defaultMessages);\n  expect(model.count).toBe(3);\n  expect(model.step(point('A', 0, 10), 'next')).toEqual(point('B', 2, 10));\n  expect(model.step(point('A', 0, 10), 'series-next')).toEqual(point('B', 3, 12));\n  expect(model.step(point('B', 3, 12), 'series-previous')).toEqual(point('A', 0, 10));\n});\n\nit('examines only nearby cells on a 200,000-point pick', () => {\n  const size = 200_000;\n  const x = Float64Array.from({ length: size }, (_, i) => i);\n  const y = Float64Array.from(x, i => i % 521);\n  const data = frame('scatter', { data: { columns: { x, y } }, x: 'x', y: 'y' });\n  const projection = { kind: 'xy', x: linearScale([0, size - 1], [0, 1200]), y: linearScale([0, 520], [520, 0]) } as const;\n  const model = scatterLookup(scatter(data), plot(projection, 1200, 520), formatter(data));\n  const i = 98_765;\n  expect(model.primary(model.pick(projection.x.map(i), 520 - (i % 521))!)).toEqual(point('y', i, i));\n  expect(model.lastPickCandidates).toBeGreaterThan(0);\n  expect(model.lastPickCandidates).toBeLessThan(5_000);\n});\n\nit('resolves hidden and zoomed-out scatter refs and steps from the replacement', () => {\n  const data = points([[[0, 5], [2, 3], [4, 8], [6, 1]], [[2, 99]], [[2, 4], [4, 1]]]);\n  const view = scatter(data, {\n    visible: [true, false, true], xDomain: [2, 4],\n    visiblePoints: [{ start: 1, end: 3 }, { start: 0, end: 1 }, { start: 0, end: 2 }],\n  });\n  const model = buildLookup(view, layout, formatter(data), defaultMessages);\n  expect(model.resolve(point('S1', 4, 2))).toEqual(point('S0', 1, 2));\n  expect(model.step(point('S1', 4, 2), 'next')).toEqual(point('S2', 5, 2));\n  expect(model.resolve(point('S0', 0, 0))).toEqual(point('S0', 1, 2));\n  expect(model.resolve(point('S0', 3, 6))).toEqual(point('S0', 2, 4));\n  expect(model.resolve(point('S0', 99, 2))).toEqual(point('S0', 2, 4));\n  expect(model.step(point('S0', 0, 0), 'next')).toEqual(point('S2', 5, 2));\n  expect(model.step(point('S0', 3, 6), 'previous')).toEqual(point('S2', 6, 4));\n  expect(model.step(point('S0', 2, 4), 'page-next')).toBeNull();\n  expect(model.step(point('S0', 1, 2), 'page-previous')).toBeNull();\n});\n\nit('bounds a pick in a cell of 200,000 coincident points and reports the full count', () => {\n  const size = 200_000;\n  const base = points([[]]);\n  const data = { ...base, series: [{\n    ...base.series[0]!, x: new Float64Array(size).fill(23.9), y: new Float64Array(size).fill(50), row: null,\n  }] };\n  const model = scatterLookup(scatter(data), layout, formatter(data));\n  const target = model.pick(24.1, 50);\n  expect(target).toMatchObject({ kind: 'point', count: size });\n  expect(model.primary(target!)).toEqual(point('S0', size - 1, 23.9));\n  expect(model.tooltip(target!).rows).toHaveLength(8);\n  expect(model.lastPickCandidates).toBeLessThan(3_000);\n});\n\nit('visits the binary-search window when switching series and locates recreated refs by x', () => {\n  const n = 80_000;\n  const data = points([Array.from({ length: n }, (_, x) => [n - x, 20] as const),\n    Array.from({ length: n }, (_, x) => [x, 20] as const)]);\n  const work = { locations: 0, seriesCandidates: 0, orderComparisons: 0 };\n  const scale = linearScale([0, n], [0, 100]);\n  let maps = 0;\n  const projection = { kind: 'xy' as const, x: { ...scale, map(x: number) { maps++; return scale.map(x); } }, y: scale };\n  const model = scatterLookup(scatter(data), plot(projection), formatter(data), work);\n  maps = 0;\n  expect(model.step(point('S0', 40_000, 40_000), 'series-next')).toEqual(point('S1', 120_000, 40_000));\n  expect(maps).toBeLessThan(20);\n  expect(work.locations).toBeGreaterThan(0);\n  expect(work.locations).toBeLessThan(20);\n  expect(work.seriesCandidates).toBeGreaterThan(0);\n  expect(work.seriesCandidates).toBeLessThan(20);\n});\n\nit('walks partial ranges with hidden series and duplicate x and y in fixture order', () => {\n  const pair = fc.tuple(fc.nat(5), fc.nat(4));\n  fc.assert(fc.property(fc.array(fc.array(pair, { minLength: 2, maxLength: 17 }),\n    { minLength: 3, maxLength: 6 }), fc.boolean(), (lists, trim) => {\n    const data = points(lists);\n    const visible = lists.map((_, s) => s !== 1);\n    const visiblePoints = data.series.map(({ x }) => ({ start: trim ? 1 : 0, end: x.length }));\n    const model = buildLookup(scatter(data, { visible, visiblePoints }), layout, formatter(data), defaultMessages);\n    const expected = data.series.flatMap((series, s) => visible[s] ? Array.from(series.x).flatMap((x, i) => i >= visiblePoints[s]!.start\n      ? [{ x, y: series.y[i]!, row: series.row![i]!, s, i }] : []) : [])\n      .sort((a, b) => a.x - b.x || a.y - b.y || a.s - b.s || a.i - b.i);\n    expect(model.count).toBe(expected.length);\n    let next = model.step(null, 'next');\n    for (const [i, row] of expected.entries()) {\n      expect(next).toEqual(point(`S${row.s}`, row.row, row.x));\n      expect(model.ordinal(next!)).toBe(i);\n      expect(model.datum(next!)?.value).toBe(String(row.y));\n      expect(model.step(next, 'previous')).toEqual(i === 0 ? null\n        : point(`S${expected[i - 1]!.s}`, expected[i - 1]!.row, expected[i - 1]!.x));\n      const distance = Math.max(1, Math.floor(expected.length / 10));\n      const page = expected[Math.min(expected.length - 1, i + distance)]!;\n      expect(model.step(next, 'page-next')).toEqual(i === expected.length - 1 ? null : point(`S${page.s}`, page.row, page.x));\n      next = model.step(next, 'next');\n    }\n    expect(next).toBeNull();\n  }), { numRuns: 60 });\n});\n\nit('uses one set of grid cells for a dense noncoincident pick and its neighbours', () => {\n  const width = 500;\n  const size = width * 400;\n  const base = points([[]]);\n  const data = { ...base, series: [{\n    ...base.series[0]!,\n    x: Float64Array.from({ length: size }, (_, i) => 20 + Math.floor(i / 400) / 100),\n    y: Float64Array.from({ length: size }, (_, i) => 48 + (i % 400) / 100),\n    row: null,\n  }] };\n  const scale = linearScale([0, 128], [0, 128]);\n  const model = scatterLookup(scatter(data), plot({ kind: 'xy', x: scale, y: scale }), formatter(data));\n  const x = 24, y = 50;\n  const { x: xs, y: ys } = data.series[0]!;\n  let expected = 0;\n  for (let i = 0; i < size; i++) {\n    if ((xs[i]! - x) ** 2 + (ys[i]! - y) ** 2 <= 0.5 ** 2) expected++;\n  }\n  const target = model.pick(x, y);\n  expect(target).toMatchObject({ kind: 'point', count: expected });\n  expect(model.primary(target!)).toEqual(point('S0', 400 * 400 + 200, x));\n  expect(model.lastPickCells).toBeLessThanOrEqual(16);\n  expect(model.lastPickCandidates).toBeLessThan(3_000);\n});\n\nit('finds next and previous by one binary successor search per series', () => {\n  const seriesCount = 500;\n  const rows = 400;\n  const base = points([[]]);\n  const data = { ...base, series: Array.from({ length: seriesCount }, (_, s) => ({\n    key: `S${s}`, label: `S${s}`, drawable: true,\n    x: Float64Array.from({ length: rows }, (_, i) => i), y: new Float64Array(rows).fill(s), row: null,\n  })) };\n  const work = { locations: 0, seriesCandidates: 0, orderComparisons: 0 };\n  const model = scatterLookup(scatter(data), null, formatter(data), work);\n  const from = point('S250', 398, 398);\n  expect(model.step(from, 'next')).toEqual(point('S251', 398, 398));\n  expect(work.orderComparisons).toBeGreaterThan(0);\n  expect(work.orderComparisons).toBeLessThanOrEqual(seriesCount * 10);\n  work.orderComparisons = 0;\n  expect(model.step(from, 'previous')).toEqual(point('S249', 398, 398));\n  expect(work.orderComparisons).toBeGreaterThan(0);\n  expect(work.orderComparisons).toBeLessThanOrEqual(seriesCount * 10);\n});\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/browser/chart/render.browser.test.ts\n cat packages/axylo/test/browser/chart/data.browser.test.ts'","aggregated_output":"/**\n * The chart types render their Phase 1 fixtures through the public API of the built bundle, with both mark\n * renderers (spec A1, C1, F2; plan M1 \"trend renders\"). Expected values come from the fixtures and the spec.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport { start, stop } from '../harness';\nimport { LIGHT } from '../../../src/theme/palette';\nimport { aria, chartPage, closePage, columnsWith, count, hex, shot } from './util';\n\nbeforeAll(start);\nafterAll(stop);\n\nconst renderers = ['canvas', 'svg'] as const;\n\ndescribe('trend (3 series × 120 days, 7 nulls)', () => {\n  for (const renderer of renderers) {\n    it(`renders with the ${renderer} renderer: named group, summary of three series, three colors, a visible gap`, async () => {\n      const page = await chartPage();\n      const result = await page.evaluate(async r => {\n        const fx = window.fx;\n        const chart = window.Axylo.line!('#chart', {\n          title: fx.trend.title, data: fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' },\n          y: { field: 'sessions', label: fx.trend.yTitle }, series: 'channel', __renderer: r,\n        });\n        await chart.__bench.ready();\n        const fig = document.querySelector('#chart figure')!;\n        const summary = document.getElementById(fig.getAttribute('aria-describedby')!)!.textContent;\n        return { summary, renderer: chart.__dev.renderer, diagnostics: chart.diagnostics.map(d => d.level + ' ' + d.code) };\n      }, renderer);\n      expect(result.renderer).toBe(renderer);\n      expect(result.diagnostics.filter(d => d.startsWith('error'))).toEqual([]);\n      for (const name of ['Direct', 'Organic search', 'Referral']) expect(result.summary).toContain(name);\n      const tree = await aria(page);\n      expect(tree).toContain('group \"Daily sessions by channel\"');\n      expect(tree).toContain('heading \"Daily sessions by channel\" [level=3]');\n\n      const { img } = await shot(page, '#chart .axylo-plot');\n      const colors = LIGHT.series.slice(0, 3).map(hex);\n      for (const color of colors) expect(count(img, color, 40)).toBeGreaterThan(200);\n      // Referral (series 3) is null at days 60–66: a run of columns without its color, with color on both sides.\n      const has = columnsWith(img, colors[2]!, 0, img.height, 40);\n      const from = Math.floor(img.width * 0.35);\n      const to = Math.floor(img.width * 0.75);\n      let longest = 0;\n      let run = 0;\n      for (let x = from; x < to; x++) {\n        run = has[x] ? 0 : run + 1;\n        longest = Math.max(longest, run);\n      }\n      expect(longest).toBeGreaterThanOrEqual(20);\n      expect(has.slice(from - 40, from).some(Boolean)).toBe(true);\n      expect(has.slice(to, to + 40).some(Boolean)).toBe(true);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\ndescribe('the other chart types', () => {\n  for (const renderer of renderers) {\n    it(`bar, area, scatter, donut and compact render their fixtures (${renderer})`, async () => {\n      const page = await chartPage({ css: '.tile { width: 480px; height: 300px; } .spark { width: 160px; }' });\n      const result = await page.evaluate(async r => {\n        const fx = window.fx;\n        const A = window.Axylo;\n        const box = (id: string, className = 'tile') => {\n          const el = document.createElement('div');\n          el.id = id;\n          el.className = className;\n          document.body.appendChild(el);\n          return el;\n        };\n        const barRows = fx.bars.categories.map((team, i) => ({ team, satisfied: fx.bars.values[i] }));\n        const groupRows = fx.bars.categories.flatMap((team, i) => [\n          { team, year: '2025', satisfied: fx.bars.values[i]! - 3 }, { team, year: '2026', satisfied: fx.bars.values[i] },\n        ]);\n        const random = fx.rng(3);\n        const points = Array.from({ length: 500 }, (_, i) => ({ x: random() * 100, y: random() * 50 + i * 0.01, group: i % 2 ? 'A' : 'B' }));\n        const charts = {\n          bar: A.bar!(box('bar'), { title: fx.bars.title, data: barRows, x: 'team', y: { field: 'satisfied', label: fx.bars.yTitle }, __renderer: r }),\n          grouped: A.bar!(box('grouped'), { title: 'Grouped', data: groupRows, x: 'team', y: 'satisfied', series: 'year', __renderer: r }),\n          stacked: A.bar!(box('stacked'), { title: 'Stacked', data: groupRows, x: 'team', y: 'satisfied', series: 'year', layout: 'stacked', __renderer: r }),\n          area: A.area!(box('area'), { title: 'Stacked area', data: fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel', stacked: true, __renderer: r }),\n          scatter: A.scatter!(box('scatter'), { title: 'Scatter of 500 points', data: points, x: 'x', y: 'y', series: 'group', __renderer: r }),\n          donut: A.donut!(box('donut'), { title: fx.parts.title, data: fx.parts.labels.map((label, i) => ({ label, share: fx.parts.values[i] })), label: 'label', value: { field: 'share', label: fx.parts.name }, __renderer: r }),\n          compact: A.line!(box('compact', 'spark'), { title: 'Sessions, last 120 days', data: fx.trendRows().filter(row => row.channel === 'Direct'), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', compact: true, __renderer: r }),\n        };\n        await Promise.all(Object.values(charts).map(c => c.__bench.ready()));\n        const out: Record<string, Record<string, unknown>> = {};\n        for (const [name, chart] of Object.entries(charts)) {\n          const fig = document.querySelector(`#${name} figure`) as HTMLElement;\n          const marks = fig.querySelector('.axylo-canvas canvas, .axylo-svg') as HTMLElement;\n          out[name] = {\n            role: fig.getAttribute('role'), label: fig.getAttribute('aria-label'), labelledby: fig.getAttribute('aria-labelledby'),\n            errors: chart.diagnostics.filter(d => d.level === 'error').map(d => d.code),\n            message: (fig.querySelector('.axylo-message') as HTMLElement).hidden ? null : fig.querySelector('.axylo-message')!.textContent,\n            marks: marks.getBoundingClientRect().height,\n            plotHeight: fig.querySelector('.axylo-plot')!.getBoundingClientRect().height,\n            tabStops: fig.querySelectorAll('[tabindex]').length,\n            summary: document.getElementById(fig.getAttribute('aria-describedby')!)!.textContent,\n          };\n        }\n        return out;\n      }, renderer);\n      for (const [name, r] of Object.entries(result) as [string, Record<string, unknown>][]) {\n        expect(r.errors, name).toEqual([]);\n        expect(r.message, name).toBeNull();\n        expect(r.marks, name).toBeGreaterThan(0);\n        expect(r.summary, name).not.toBe('');\n      }\n      for (const name of ['bar', 'grouped', 'stacked', 'area', 'scatter', 'donut']) {\n        expect(result[name]!.role, name).toBe('group');\n        expect(result[name]!.labelledby, name).toMatch(/-t$/);\n      }\n      // Compact (spec C1, C3): an image named by its title, described by the summary, no tab stop, 32 px tall.\n      expect(result.compact!.role).toBe('img');\n      expect(result.compact!.label).toBe('Sessions, last 120 days');\n      expect(result.compact!.tabStops).toBe(0);\n      expect(result.compact!.plotHeight).toBe(32);\n      const tree = await aria(page, '#compact');\n      expect(tree).toContain('img \"Sessions, last 120 days\"');\n      expect(tree).not.toContain('heading');\n      // Donut summary lists the slices with their values (spec F8 text).\n      expect(result.donut!.summary).toContain('Chrome');\n      expect(result.donut!.summary).toContain('Samsung Internet');\n      expect(await aria(page, '#donut')).toContain('group \"Sessions by browser\"');\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\ndescribe('compact variant (spec C1, C5)', () => {\n  it('with values left out, the description says so and a corner marker appears; there is no note element', async () => {\n    const page = await chartPage({ css: '#chart { width: 160px; height: auto; }' });\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'Dirty spark', compact: true, data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n      await chart.__bench.ready();\n      const fig = document.querySelector('#chart figure')!;\n      const corner = fig.querySelector('.axylo-corner') as HTMLElement;\n      const note = fig.querySelector('.axylo-note') as HTMLElement;\n      return {\n        description: document.getElementById(fig.getAttribute('aria-describedby')!)!.textContent,\n        corner: corner.hidden ? null : corner.getBoundingClientRect().width, cornerTitle: corner.getAttribute('title'),\n        note: note.hidden, tabStops: fig.querySelectorAll('[tabindex]').length,\n      };\n    });\n    expect(result.description).toMatch(/3\\b.*not shown|not shown.*3\\b/i);\n    expect(result.corner).toBeGreaterThan(0);\n    expect(result.cornerTitle).toMatch(/not shown/i);\n    expect(result.note).toBe(true);\n    expect(result.tabStops).toBe(0);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('names and ids', () => {\n  it('24 charts on one page: no duplicate ids, each its own name', async () => {\n    const page = await chartPage({ css: '.tile { width: 220px; height: 160px; display: inline-block; }' });\n    const result = await page.evaluate(async () => {\n      const charts = Array.from({ length: 24 }, (_, i) => {\n        const el = document.createElement('div');\n        el.className = 'tile';\n        document.body.appendChild(el);\n        return window.Axylo.line!(el, { title: `Chart ${i + 1}`, data: window.fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel' });\n      });\n      await Promise.all(charts.map(c => c.__bench.ready()));\n      const ids = [...document.querySelectorAll('[id]')].map(e => e.id);\n      const names = [...document.querySelectorAll('figure')].map(f => document.getElementById(f.getAttribute('aria-labelledby')!)?.textContent);\n      return { ids, duplicates: ids.filter((id, i) => ids.indexOf(id) !== i), names };\n    });\n    expect(result.duplicates).toEqual([]);\n    expect(new Set(result.names).size).toBe(24);\n    expect(result.names[23]).toBe('Chart 24');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('labelledBy names the chart from the page heading, with no heading of its own; title.level and visible are honoured', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const h = document.createElement('h2');\n      h.id = 'card-title';\n      h.textContent = 'Sessions card';\n      document.body.prepend(h);\n      const rows = window.fx.trendRows();\n      const a = window.Axylo.line!('#chart', { labelledBy: 'card-title', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n      const el = document.createElement('div');\n      el.id = 'second';\n      el.style.width = '400px';\n      document.body.appendChild(el);\n      const b = window.Axylo.line!(el, { title: { text: 'Hidden title', level: 4, visible: false }, data: rows, x: 'day', y: 'sessions', series: 'channel' });\n      await Promise.all([a.__bench.ready(), b.__bench.ready()]);\n      const t = el.querySelector('.axylo-title') as HTMLElement;\n      return {\n        a: document.querySelector('#chart figure')!.getAttribute('aria-labelledby'),\n        aHeading: (document.querySelector('#chart .axylo-title') as HTMLElement).hidden,\n        aCodes: a.diagnostics.map(d => d.code),\n        bLevel: t.getAttribute('aria-level'), bWidth: t.getBoundingClientRect().width,\n      };\n    });\n    expect(result.a).toBe('card-title');\n    expect(result.aHeading).toBe(true);\n    expect(result.aCodes).not.toContain('AX140');\n    expect(result.bLevel).toBe('4');\n    expect(result.bWidth).toBeLessThanOrEqual(1);\n    expect(await aria(page, '#second')).toContain('heading \"Hidden title\" [level=4]');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('a chart without title or labelledBy gets a generated name and AX140', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n      await chart.__bench.ready();\n      return { codes: chart.diagnostics.map(d => d.code), label: document.querySelector('#chart figure')!.getAttribute('aria-label') };\n    });\n    expect(result.codes).toContain('AX140');\n    expect(result.label).toBe('Line chart of sessions by day');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('a selector that matches nothing throws an error naming it', async () => {\n    const page = await chartPage();\n    const message = await page.evaluate(() => {\n      try {\n        window.Axylo.line!('#missing-chart', { data: [], x: 'a', y: 'b' });\n        return 'no error';\n      } catch (error) {\n        return String(error);\n      }\n    });\n    expect(message).toContain('#missing-chart');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('works with the stylesheet applied through ensureStyles (no linked axylo.css)', async () => {\n    const page = await chartPage({ standaloneCss: false });\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'T', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n      await chart.__bench.ready();\n      const summary = document.querySelector('#chart .axylo-summary')!;\n      return { sheets: document.adoptedStyleSheets.length, summaryWidth: summary.getBoundingClientRect().width, display: getComputedStyle(document.querySelector('#chart figure')!).display };\n    });\n    expect(result.sheets).toBe(1);\n    expect(result.display).toBe('flex');\n    expect(result.summaryWidth).toBeLessThanOrEqual(1);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('tooltip', () => {\n  it('shows every series at the nearest x on pointer move, built as text, and hides on leave', async () => {\n    const page = await chartPage();\n    await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'T', data: window.fx.trendRows(), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'sessions', series: 'channel' });\n      window.charts.push(chart);\n      await chart.__bench.ready();\n    });\n    const plot = (await page.locator('#chart .axylo-plot').boundingBox())!;\n    await page.mouse.move(plot.x + plot.width * 0.5, plot.y + plot.height * 0.5);\n    const tip = page.locator('#chart .axylo-tooltip');\n    await expect.poll(() => tip.isVisible()).toBe(true);\n    const text = await tip.textContent();\n    for (const name of ['Direct', 'Organic search', 'Referral']) expect(text).toContain(name);\n    expect(text).toContain('UTC');\n    expect(await tip.locator('script, img').count()).toBe(0);\n    await page.mouse.move(5, 5);\n    await expect.poll(() => tip.isVisible()).toBe(false);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n/**\n * Data the chart cannot draw as given (spec F3, F12, 3.5), states (L7) and calendar dates in three viewer\n * zones (F4). Expected codes come from the registry's statement for the combined dirty fixture.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport { start, stop, url } from '../harness';\nimport { aria, chartPage, closePage } from './util';\n\nbeforeAll(start);\nafterAll(stop);\n\ndescribe('dirty input (spec 3.5, F12)', () => {\n  for (const flavour of ['development', 'production'] as const) {\n    it(`the combined fixture yields AX102, AX103 and AX106 once each and shows the reader's note (${flavour} build)`, async () => {\n      const page = await chartPage();\n      if (flavour === 'production') await page.addScriptTag({ url: url('packages/axylo/dist/axylo.iife.min.js') });\n      const result = await page.evaluate(async () => {\n        const chart = window.Axylo.line!('#chart', { title: 'Dirty input', data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n        await new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));\n        const note = document.querySelector('#chart .axylo-note') as HTMLElement;\n        return { codes: chart.diagnostics.map(d => d.code), note: note.hidden ? null : note.textContent, role: note.getAttribute('role') };\n      });\n      const warnings = result.codes.filter(c => ['AX102', 'AX103', 'AX106'].includes(c)).sort();\n      expect(warnings).toEqual(['AX102', 'AX103', 'AX106']);\n      expect(result.note).toBe('Values not shown: 3. See table.');\n      expect(result.role).toBe('status');\n      expect(await aria(page)).toMatch(/status: \"?Values not shown: 3\\. See table\\.\"?/);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('prints each warning once with console.warn', async () => {\n    const page = await chartPage();\n    const warned: string[] = [];\n    page.on('console', m => { if (m.type() === 'warning') warned.push(m.text().slice(0, 13)); });\n    await page.evaluate(async () => {\n      for (let i = 0; i < 3; i++) window.Axylo.line!(Object.assign(document.body.appendChild(document.createElement('div')), { style: 'width:300px' }), { title: `Dirty ${i}`, data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n      await window.nextFrames(2);\n    });\n    expect(warned.sort()).toEqual(['[axylo AX102]', '[axylo AX103]', '[axylo AX106]']);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('with strict: true the create call throws and leaves nothing in the target', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const target = document.getElementById('chart')!;\n      let error: { name: string; message: string; codes: string[] } | null = null;\n      try {\n        window.Axylo.line!(target, { title: 'Dirty input', strict: true, data: window.fx.dirtyRows(), x: 'day', y: 'value' });\n      } catch (e) {\n        const err = e as Error & { diagnostics: { code: string }[] };\n        error = { name: err.name, message: err.message, codes: err.diagnostics.map(d => d.code) };\n      }\n      await window.nextFrames(2);\n      return { error, children: target.childElementCount, className: target.className, scheme: target.getAttribute('data-axylo-scheme') };\n    });\n    expect(result.error?.message).toMatch(/AX10[236]/);\n    expect(result.error?.codes.sort()).toEqual(['AX102', 'AX103', 'AX106']);\n    expect(result.children).toBe(0);\n    expect(result.className).toBe('');\n    expect(result.scheme).toBeNull();\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('formatters (spec F6, 3.5)', () => {\n  it('a custom formatter that throws falls back to the default, raises AX160 when found, and is never thrown', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', {\n        title: 'Formatter', strict: true, data: [{ d: 1, v: 10 }, { d: 2, v: 20 }, { d: 3, v: 30 }], x: 'd',\n        y: { field: 'v', tickFormat: () => { throw new Error('author bug'); } },\n      });\n      await chart.__bench.ready();\n      return { codes: chart.diagnostics.map(d => d.code), ticks: [...document.querySelectorAll('#chart .axylo-label[data-role=\"tick-y\"]')].map(e => e.textContent) };\n    });\n    expect(result.codes).toContain('AX160');\n    expect(result.ticks).toContain('20');\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('states (spec L7)', () => {\n  it('empty data shows the empty message inside the plot and no tick labels', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'Nothing yet', data: [], x: 'day', y: 'value' });\n      await chart.__bench.ready();\n      const message = document.querySelector('#chart .axylo-plot .axylo-message') as HTMLElement;\n      return { message: message.hidden ? null : message.textContent, labels: document.querySelectorAll('#chart .axylo-label').length, errors: chart.diagnostics.filter(d => d.level === 'error').length };\n    });\n    expect(result.message).toBe('No data to show.');\n    expect(result.labels).toBe(0);\n    expect(result.errors).toBe(0);\n    expect(await aria(page)).toContain('No data to show.');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it(\"state: 'loading' then update({ state: 'ready' }) is announced once\", async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'Sessions', state: 'loading', data: [], x: 'day', y: 'sessions', series: 'channel' });\n      await chart.__bench.ready();\n      const live = document.querySelector('#chart [aria-live=\"polite\"]')!;\n      const message = document.querySelector('#chart .axylo-message') as HTMLElement;\n      const loading = message.hidden ? null : message.textContent;\n      const said: string[] = [];\n      new MutationObserver(() => said.push(live.textContent ?? '')).observe(live, { childList: true, characterData: true, subtree: true });\n      chart.update({ state: 'ready', data: window.fx.trendRows() });\n      await chart.__bench.ready();\n      await window.nextFrames(3);\n      return { loading, said, after: message.hidden };\n    });\n    expect(result.loading).toBe('Loading chart.');\n    expect(result.said).toEqual(['Sessions']);\n    expect(result.after).toBe(true);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('an author error state and an internal failure both show their message inside the plot, in the accessibility tree', async () => {\n    const page = await chartPage({ css: '#other { width: 400px; }' });\n    const consoleErrors: string[] = [];\n    page.on('console', m => { if (m.type() === 'error') consoleErrors.push(m.text()); });\n    const result = await page.evaluate(async () => {\n      const chart = window.Axylo.line!('#chart', { title: 'Sessions', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' });\n      await chart.__bench.ready();\n      chart.__dev.fail('reader');\n      chart.update({ title: 'Sessions, renamed' });\n      await window.nextFrames(2);\n      const message = document.querySelector('#chart .axylo-message') as HTMLElement;\n      const internal = message.hidden ? null : message.textContent;\n      const labels = document.querySelectorAll('#chart .axylo-label').length;\n      const el = Object.assign(document.body.appendChild(document.createElement('div')), { id: 'other' });\n      const other = window.Axylo.line!(el, { title: 'Other', state: { error: 'The query failed.' }, data: [], x: 'day', y: 'v' });\n      await other.__bench.ready();\n      return { internal, labels, authored: el.querySelector('.axylo-message')!.textContent };\n    });\n    expect(result.internal).toBe('Something went wrong while drawing the chart.');\n    expect(result.labels).toBe(0);\n    expect(result.authored).toBe('The query failed.');\n    expect(await aria(page)).toContain('Something went wrong while drawing the chart.');\n    expect(await aria(page, '#other')).toContain('The query failed.');\n    expect(consoleErrors.some(t => t.includes('internal error'))).toBe(true);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('calendar dates in three viewer zones (spec F4 a)', () => {\n  it('the dates fixture as date strings gives identical tick text in UTC, America/Los_Angeles and Asia/Kolkata', async () => {\n    const texts: string[][] = [];\n    for (const timezoneId of ['UTC', 'America/Los_Angeles', 'Asia/Kolkata']) {\n      const page = await chartPage({ timezoneId });\n      texts.push(await page.evaluate(async () => {\n        const chart = window.Axylo.line!('#chart', { title: 'Daily sessions by channel', data: window.fx.datesRows(), x: 'day', y: 'sessions', series: 'channel' });\n        await chart.__bench.ready();\n        return [...document.querySelectorAll('#chart .axylo-label[data-role=\"tick-x\"]')].map(e => e.textContent ?? '');\n      }));\n      expect(await closePage(page)).toEqual([]);\n    }\n    expect(texts[0]!.length).toBeGreaterThan(2);\n    expect(texts[0]![0]).toMatch(/Jan/);\n    expect(texts[1]).toEqual(texts[0]);\n    expect(texts[2]).toEqual(texts[0]);\n  });\n});\n","exit_code":0,"status":"completed"}}
