{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"sed -n '12,55p;498,578p' packages/axylo/test/layout/layout.test.ts\n sed -n '355,383p' packages/axylo/test/browser/chart/interaction.browser.test.ts\n sed -n '27,76p' packages/axylo/test/browser/chart/theme.browser.test.ts\n sed -n '85,104p' packages/axylo/test/browser/render/render.browser.test.ts\"","aggregated_output":"const style: TextStyle = { font: '16px sans-serif', letterSpacing: 0, wordSpacing: 0, lineHeight: 16 };\nconst measurer = {\n  width(text: string, style: TextStyle): number {\n    return [...text].length * (7 + style.letterSpacing) + (text.match(/ /gu)?.length ?? 0) * style.wordSpacing;\n  },\n};\n\nfunction continuous(type: ContinuousScale['type'], domain: Span, range: Span): ContinuousScale {\n  const [min, max] = domain;\n  const [start, end] = range;\n  return {\n    type, domain, range,\n    map: value => start + (end - start) * (value - min) / (max - min),\n    invert: pixel => min + (max - min) * (pixel - start) / (end - start),\n  };\n}\n\nconst scales: ScaleConstructors = {\n  linear: (domain, range) => continuous('linear', domain, range),\n  time: (domain, range) => continuous('time', domain, range),\n  band(count, range, padding) {\n    const [start, end] = range;\n    const direction = Math.sign(end - start);\n    const step = Math.abs(end - start) / (count + padding);\n    const bandwidth = step * (1 - padding);\n    const center = (index: number) => start + direction * ((index + padding) * step + bandwidth / 2);\n    return {\n      type: 'band', count, range, step, bandwidth, center,\n      map: index => center(index) - bandwidth / 2,\n      invert: pixel => Math.max(0, Math.min(count - 1, Math.round(((pixel - start) * direction - bandwidth / 2) / step - padding))),\n    };\n  },\n};\n\nconst valueCandidates: TickCandidates = [\n  Array.from({ length: 11 }, (_, i) => ({ value: i * 10, label: String(i * 10) })),\n  [0, 25, 50, 75, 100].map(value => ({ value, label: String(value) })),\n  [0, 50, 100].map(value => ({ value, label: String(value) })),\n  [{ value: 50, label: '50' }],\n];\n\nfunction axis(labels: readonly string[], mayThin: boolean, title?: string): BandAxis {\n  const dense = labels.map((label, value) => ({ label, value }));\n  return {\n  it('checks every layout kind, minimum plots and label attribution across generated sizes', () => {\n    const unbroken = fc.string({ unit: 'grapheme-ascii', minLength: 1, maxLength: 60 }).filter(text => !/\\s/u.test(text));\n    const shared = fc.string({ unit: 'grapheme-ascii', minLength: 1, maxLength: 20 })\n      .map(suffix => `Customer Success International Services ${suffix}`);\n    const words = fc.array(fc.constantFrom('Team', 'Success', 'Onboarding', 'EMEA', 'Accounts', 'Web'), { minLength: 1, maxLength: 5 })\n      .map(words => words.join(' '));\n    const labels = fc.array(fc.oneof(unbroken, shared, words, fc.constant('')), { minLength: 1, maxLength: 40, size: 'large' });\n    const cases = fc.record({\n      labels,\n      width: fc.oneof(fc.integer({ min: 100, max: 1920 }), fc.constantFrom(100, 120, 148, NaN, Infinity)),\n      height: fc.oneof(fc.integer({ min: 60, max: 600 }), fc.constantFrom(60, 80, 108, 124, NaN, Infinity)),\n      letterSpacing: fc.constantFrom(0, 1.5), wordSpacing: fc.constantFrom(0, 2),\n      lineHeight: fc.constantFrom(16, 22, 28),\n      mode: fc.constantFrom('plain', 'ordered', 'linear', 'time', 'vertical', 'horizontal', 'compact', 'ring', 'message'),\n    });\n    const expectedOrder: LabelRemedy[] = ['thinned', 'wrapped', 'rotated', 'truncated'];\n\n    fc.assert(fc.property(cases, ({ labels, width, height, letterSpacing, wordSpacing, lineHeight, mode }) => {\n      const mayThin = mode === 'ordered' || mode === 'linear' || mode === 'time';\n      const common = {\n        ...input(labels, width, height, mayThin),\n        style: { ...style, letterSpacing, wordSpacing, lineHeight },\n      };\n      // Short titles make the space needed for a plot with hidden ticks independently calculable.\n      const cartesian = {\n        ...common, x: { ...common.x, title: 'X' }, y: { ...common.y, title: 'Y' },\n      };\n      let settings: LayoutInput = cartesian;\n      if (mode === 'horizontal' || mode === 'vertical') settings = { ...cartesian, kind: 'bands', horizontal: mode === 'horizontal' };\n      if (mode === 'linear' || mode === 'time') settings = { ...cartesian, x: {\n          type: mode, domain: [0, Math.max(1, labels.length - 1)], candidates: common.x.candidates, mayThin, title: 'X',\n      } };\n      if (mode === 'compact') settings = { ...cartesian, compact: true };\n      if (mode === 'ring') settings = { kind: 'ring', width, height };\n      if (mode === 'message') settings = { ...common, kind: 'message', message: labels.join(' ') };\n      const result = computeLayout(settings);\n      if (!Number.isFinite(width) || !Number.isFinite(height)) {\n        expect(result.kind).toBe('unmeasured');\n        return;\n      }\n      if (mode === 'compact' || mode === 'message') {\n        expect(result.kind).toBe(mode);\n        if (result.kind === 'message') {\n          const { box } = result.text;\n          expect(box.x).toBeGreaterThanOrEqual(4);\n          expect(box.y).toBeGreaterThanOrEqual(4);\n          expect(box.x + box.width).toBeLessThanOrEqual(width - 4);\n          expect(box.y + box.height).toBeLessThanOrEqual(height - 4);\n        }\n        return;\n      }\n      expect(['plot', 'too-small']).toContain(result.kind);\n      const titleLane = 4 + lineHeight;\n      if (mode === 'ring' ? width >= 120 && height >= 80\n        : width >= 120 + 8 + titleLane && height >= 80 + 8 + titleLane) {\n        expect(result.kind).toBe('plot');\n      }\n      if (result.kind !== 'plot') return;\n\n      expect(result.plot.width).toBeGreaterThanOrEqual(120 - 1e-6);\n      expect(result.plot.height).toBeGreaterThanOrEqual(80 - 1e-6);\n      const texts = tickLabels(result);\n      distinct(texts);\n      boxesFit(result);\n      if (mode === 'ring') {\n        expect(result.texts).toEqual([]);\n        expect(result.projection).toEqual({ kind: 'ring', cx: width / 2, cy: height / 2,\n          r0: Math.min(width, height) / 2 * 0.6, r1: Math.min(width, height) / 2 });\n        return;\n      }\n      identifiable(texts, labels);\n      expect(result.xTicks).toHaveLength(texts.length);\n      const remedies = result.fit.x.remedies;\n      if (texts.some(text => text.rotate === -45)) {\n        expect(height - result.plot.y - result.plot.height).toBeLessThanOrEqual(height * 0.4 + 1e-6);\n      }\n      if (!mayThin) expect(remedies).not.toContain('thinned');\n      if (!remedies.includes('thinned')) expect(result.fit.x.hidden).toBe(labels.length - texts.length);\n      expect(remedies).toEqual(expectedOrder.filter(remedy => remedies.includes(remedy)));\n    }), { numRuns: 1000 });\n  });\ndescribe('touch (spec I4)', () => {\n  it('a tap pins the tooltip and a tap elsewhere dismisses it; a one-finger vertical drag scrolls the page', async () => {\n    const page = await fixturePage({ hasTouch: true, css: 'body { height: 3000px; }' });\n    await make(page, 'trend');\n    const g = await geometry(page);\n    const x = g.plot.x + g.plot.width / 2;\n    await page.touchscreen.tap(x, g.plot.y + g.plot.height / 2);\n    await page.waitForTimeout(50);\n    expect(await floating(page).isVisible()).toBe(true);\n    await page.waitForTimeout(400);\n    expect(await floating(page).isVisible()).toBe(true);\n    await page.touchscreen.tap(450, 650);\n    await page.waitForTimeout(50);\n    expect(await floating(page).isVisible()).toBe(false);\n    expect(await page.locator('#chart .axylo-plot').evaluate(el => getComputedStyle(el).touchAction)).toBe('manipulation');\n\n    const client = await page.context().newCDPSession(page);\n    const y0 = g.plot.y + g.plot.height - 20;\n    await client.send('Input.dispatchTouchEvent', { type: 'touchStart', touchPoints: [{ x, y: y0 }] });\n    for (let i = 1; i <= 10; i++) {\n      await client.send('Input.dispatchTouchEvent', { type: 'touchMove', touchPoints: [{ x, y: y0 - i * 20 }] });\n    }\n    await client.send('Input.dispatchTouchEvent', { type: 'touchEnd', touchPoints: [] });\n    await page.waitForFunction(() => window.scrollY > 50, undefined, { timeout: 3000 });\n    expect(await floating(page).isVisible()).toBe(false);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it(\"with zoom: 'touch' a pinch zooms through the public path; without it the chart leaves pinch to the page\", async () => {\ndescribe('scheme from the page (spec L4)', () => {\n  it('a page with color-scheme: dark draws the dark palette', async () => {\n    const page = await chartPage({ css: ':root { color-scheme: dark; } body { background: #16181d; color: #e8eaee; }' });\n    expect((await create(page, 'canvas')).scheme).toBe('dark');\n    expect(await seriesPixels(page, DARK.series[0]!)).toBeGreaterThan(200);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('a class-toggled dark page without color-scheme is dark, from the inherited text color', async () => {\n    const page = await chartPage({ css: 'html.dark body { background: #16181d; color: #e8eaee; }' });\n    await page.evaluate(() => document.documentElement.classList.add('dark'));\n    expect((await create(page, 'svg')).scheme).toBe('dark');\n    expect(await seriesPixels(page, DARK.series[0]!)).toBeGreaterThan(200);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('a light-only page under dark emulation stays light', async () => {\n    const page = await chartPage({ colorScheme: 'dark', css: ':root { color-scheme: light; }' });\n    expect((await create(page, 'canvas')).scheme).toBe('light');\n    expect(await seriesPixels(page, LIGHT.series[0]!)).toBeGreaterThan(200);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  for (const renderer of ['canvas', 'svg'] as const) {\n    it(`toggling a dark class repaints within a frame, without rebuilding the scene (${renderer})`, async () => {\n      const page = await chartPage({ css: 'html.dark body { background: #16181d; color: #e8eaee; }' });\n      expect((await create(page, renderer)).scheme).toBe('light');\n      const result = await page.evaluate(async () => {\n        const chart = window.charts[0]!;\n        const before = chart.__dev.stages();\n        document.documentElement.classList.add('dark');\n        // Let the attribute observer run, then read in the first frame after the toggle.\n        await Promise.resolve();\n        await new Promise(r => requestAnimationFrame(r));\n        return { before, after: chart.__dev.stages(), scheme: document.getElementById('chart')!.getAttribute('data-axylo-scheme') };\n      });\n      expect(result.scheme).toBe('dark');\n      expect(result.after.theme).toBe(result.before.theme! + 1);\n      expect(result.after.scene).toBe(result.before.scene);\n      // The same call for both renderers: canvas needs it to repaint, SVG restyles through CSS anyway.\n      expect(result.after.draw).toBe(result.before.draw + 1);\n      expect(result.after.layout).toBe(result.before.layout);\n      expect(await seriesPixels(page, DARK.series[0]!)).toBeGreaterThan(200);\n      expect(await seriesPixels(page, LIGHT.series[0]!)).toBeLessThan(20);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\ndescribe('contrast (spec A5, AX141)', () => {\n      });\n\n      it('ring: four slices in their colors with background gaps between them', () => {\n        const mid = 32.5;\n        for (let k = 0; k < 4; k++) {\n          const a = Math.PI / 4 + (k * Math.PI) / 2;\n          expect(diff(px(300 + mid * Math.sin(a), 60 - mid * Math.cos(a)), series(4 + k)), `slice ${k}`).toBeLessThanOrEqual(8);\n        }\n        // Gap centres at 12, 3, 6 and 9 o'clock (4 px wide).\n        for (const [x, y] of [[299, 27], [300, 27], [332, 59], [332, 60], [299, 92], [300, 92], [267, 59], [267, 60]] as const) {\n          expect(diff(px(x, y), WHITE), `gap ${x},${y}`).toBeLessThanOrEqual(12);\n        }\n        // Inside the hole.\n        expect(diff(px(300, 60), WHITE)).toBeLessThanOrEqual(2);\n      });\n\n      it('clip: grid outside the clip is not drawn, axis and tick rules outside it are', () => {\n        expect(diff(px(25, 110), WHITE)).toBeLessThanOrEqual(2);\n        expect(diff(px(385, 110), WHITE)).toBeLessThanOrEqual(2);\n        expect(diff(px(370, 110), rgb(LIGHT.grid))).toBeLessThanOrEqual(3);\n","exit_code":0,"status":"completed"}}
