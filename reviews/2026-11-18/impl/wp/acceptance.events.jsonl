\n      \\\"line\\\": [{\\\"file\\\": \\\"chart.test.ts\\\", \\\"kind\\\": \\\"unit\\\", \\\"prefix\\\": \\\"render examp\\\"}]\n    }\n  },\n  {\n    \\\"id\\\": \\\"T-pointer-bar\\\",\n    \\\"statement\\\": \\\"Under the pointer.\\\",\n    \\\"appliesTo\\\": [\\\"bar\\\"],\n    \\\"notApplicable\\\": {\n      \\\"line\\\": \\\"Bar cell.\\\",\n      \\\"area\\\": \\\"Bar cell.\\\",\n      \\\"scatter\\\": \\\"Bar cell.\\\",\n      \\\"donut\\\": \\\"Bar cell.\\\",\n      \\\"compact\\\": \\\"Bar cell.\\\"\n    },\n    \\\"evidence\\\": {\n      \\\"bar\\\": [{\\\"file\\\": \\\"chart.test.ts\\\", \\\"kind\\\": \\\"unit\\\", \\\"prefix\\\": \\\"render examples\\\"}]\n    }\n  }\n]\nEOF\nnode --input-type=module <<'EOF'\nimport { readFileSync, writeFileSync } from 'node:fs';\nconst dir = 'acceptance/test/fixtures/';\nconst matrix = () => JSON.parse(readFileSync(dir + 'matrix.json'));\nconst write = (name, rows) => writeFileSync(dir + name, JSON.stringify(rows, null, 2) + '\\\\n');\nwrite('stale.json', [{ ...matrix()[0], id: 'F88' }, ...matrix().slice(1)]);\nconst rows = matrix();\nrows[0].weak.area[0].title = 'title in a comment';\nwrite('missing-title.json', rows);\nEOF\ncat > acceptance/test/check.test.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport test from 'node:test';\nimport { resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { check } from '../check.mjs';\n\nconst root = fileURLToPath(new URL('./fixtures/', import.meta.url));\nconst matrixFile = resolve(root, 'matrix.json');\nconst passed = resolve(root, 'results.json');\nconst failed = resolve(root, 'failed.json');\nconst run = options => check({ root, matrixFile, ...options });\n\ntest('a stale ID and its missing replacement are structural errors without --release', () => {\n  assert.throws(() => run({ matrixFile: resolve(root, 'stale.json') }),\n    /stale criterion ID: F88\\\\nmissing criterion ID: F1/);\n});\n\ntest('a title in a comment does not satisfy even a weak test reference', () => {\n  assert.throws(() => run({ matrixFile: resolve(root, 'missing-title.json') }),\n    /F1\\\\/area: missing test title in chart\\\\.test\\\\.ts: title in a comment/);\n});\n\ntest('a failed named result appears in the table and only blocks --release', () => {\n  const options = { resultFiles: [failed] };\n  const normal = run(options);\n  assert.match(normal.table, /\"'^'\"\\\\| F1 \\\\| [\"'^|]+'\"\\\\| fail \\\\| no evidence \\\\| not run \\\\|/m);\n  assert.equal(normal.counts.fail, 3);\n  assert.equal(normal.exitCode, 0);\n  assert.equal(run({ ...options, release: true }).exitCode, 1);\n});\n\ntest('evidence applies per chart type and weak tests cannot fill an evidence gap', () => {\n  const normal = run({ resultFiles: [passed] });\n  assert.match(normal.table, /\"'^'\"\\\\| F1 \\\\| [\"'^|]+'\"\\\\| pass \\\\| no evidence \\\\| pass \\\\| not applicable \\\\|/m);\n  assert.match(normal.table, /\"'^'\"\\\\| F2 \\\\| [\"'^|]+'\"\\\\| cannot be verified here \\\\|/m);\n  assert.match(normal.report, /No evidence · area/);\n  assert.match(normal.report, /The smoke test does not check the geometry\\\\./);\n  assert.deepEqual(normal.counts, {\n    pass: 2, fail: 0, 'no evidence': 1, 'not run': 2, 'cannot be verified here': 1, 'not applicable': 18,\n  });\n  assert.equal(run({ resultFiles: [passed], release: true }).exitCode, 1);\n});\n\ntest('a describe prefix needs all its cases, and a failure in either report remains a failure', () => {\n  const partial = run({ resultFiles: [passed] });\n  assert.match(partial.table, /\"'^'\"\\\\| T-pointer-line \\\\| [\"'^|]+'\"\\\\| not run \\\\|/m);\n  const combined = run({ resultFiles: [passed, failed] });\n  assert.match(combined.table, /\"'^'\"\\\\| T-pointer-line \\\\| [\"'^|]+'\"\\\\| fail \\\\|/m);\n  assert.equal(combined.counts.pass, 1);\n});\n\ntest('without results, named tests are not run and gaps remain visible', () => {\n  const result = run();\n  assert.match(result.report, /Static coverage only/);\n  assert.equal(result.counts.pass, 0);\n  assert.equal(result.counts['not run'], 4);\n  assert.equal(result.counts['no evidence'], 1);\n  assert.equal(result.exitCode, 0);\n});\nEOF\ncat > acceptance/README.md <<'EOF'\n# Release acceptance\n\nFrom the repository root\n\n\"'```sh\nnode --test acceptance/test/*.test.mjs\nnode acceptance/check.mjs\nmkdir -p acceptance/results\ntimeout 120 npx vitest run --reporter=json --outputFile=acceptance/results/unit.json\nnode acceptance/check.mjs --results acceptance/results/unit.json\nnode acceptance/check.mjs --release --results acceptance/results/unit.json\n```\n\nSupply any number of Vitest JSON reports after `--results`, including browser reports collected on a machine that can run them. The checker prints the table and rewrites [report.md](report.md). Structural errors always exit 1. With `--release`, any `fail` or `no evidence` also exits 1. Review the other open statuses before tagging a release.\n\n| Status | Meaning |\n|---|---|\n| pass | Every required test has a passing assertion result. |\n| fail | At least one required test failed in a supplied report. |\n| no evidence | The criterion applies and has no qualifying evidence. Weak checks appear in the gap list. |\n| not run | Required results are absent or skipped, or the budget has no frozen limit. Archived measurements are linked without a verdict. |\n| cannot be verified here | A required environment or rehearsal is unavailable. The cell gives the reason. |\n| not applicable | The criterion does not apply to this type. The cell gives the reason. |\n\nFirefox, Safari/WebKit, native phone behavior, screen-reader rehearsal and hardware GPU rasterisation cannot be verified here. The cited benchmark records use software rasterisation and measure main-thread work. Hardware rasterisation has no pass/fail budget of its own in spec §5.\n\n## Add a row\n\nUse the ID and short wording from the spec. Section 3.6 cells use `T-<rule>-<chart type>`. Add an `appliesTo` list and give a `notApplicable` reason for every excluded type. Negative type-matrix cells such as “No” zoom are applicable checks of absence. The compact column covers the variant defined in §3.7.\n\nRead each test body and file it under the chart type it actually exercises. An `evidence` item takes a repository-relative `file` and a `kind` of `unit`, `property`, `browser`, `benchmark`, `document` or `manual rehearsal`. For tests use the exact Vitest `title` or a `prefix` of a `describe` title when the entire suite is needed. Add a `reason` to each `weak` item. Benchmark entries take a `workload` and optional `history` paths. Use `cannotVerify` for environmental limits and `pending` for provisional work, with reasons by type.\n\nThe source scanner checks conventional registrations and simple parameterized titles without importing tests. Its limits are documented in [titles.mjs](titles.mjs). A failed assertion takes precedence across reports. Documents, manual notes and provisional benchmark measurements require review outside the Vitest result join.\nEOF\ncat > acceptance/results/.gitignore <<'\"'EOF'\n*\n\"'!.gitignore\nEOF\nnode --test acceptance/test/*.test.mjs\nnode acceptance/check.mjs > acceptance/results/static.txt\ntail -n 8 acceptance/results/static.txt'","aggregated_output":"✔ acceptance/test/check.test.mjs (51.706754ms)\nℹ tests 1\nℹ suites 0\nℹ pass 1\nℹ fail 0\nℹ cancelled 0\nℹ skipped 0\nℹ todo 0\nℹ duration_ms 57.686041\nL2/compact: missing describe prefix in packages/axylo/test/theme/palette.test.ts: default palette (spec A5)\n","exit_code":0,"status":"completed"}}
