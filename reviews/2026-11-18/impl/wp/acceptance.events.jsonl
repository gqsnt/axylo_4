ixed(2)}`);\n/**\n * Type tests, checked by `tsc -p packages/react` and never run. Each `@ts-expect-error` line must fail to\n * compile exactly as the matching core call does (plan 1.3, 1.2, 1.4).\n */\nimport { useRef } from 'react';\nimport { donut, line } from 'axylo';\nimport type { DonutOptions, LineOptions } from 'axylo';\nimport { Area, Bar, Donut, Line, Scatter, type ChartRef } from '../src/index';\n\ninterface Row { day: string; channel: string; sessions: number; visits: number; count: string }\ndeclare const rows: Row[];\n\nexport function Valid() {\n  const ref = useRef<ChartRef<Row, LineOptions<Row>>>(null);\n  ref.current?.chart?.append([{ day: '2026-01-02', channel: 'Direct', sessions: 1, visits: 2, count: '3' }]);\n  ref.current?.chart?.zoom(null);\n  const donut = useRef<ChartRef<Row, DonutOptions<Row>>>(null);\n  return (\n    <>\n      <Line ref={ref} data={rows} x=\"day\" y=\"sessions\" series=\"channel\" title=\"Daily sessions\" className=\"card\" style={{ height: 300 }} />\n      <Line data={rows} x={{ field: 'day', type: 'date' }} y={['sessions', { field: 'visits', label: 'Visits' }]} onHover={p => p?.row?.sessions} onZoom={d => d?.[0]} />\n      <Line data={rows} x=\"day\" y={{ field: 'count', parse: 'number' }} onDiagnostic={d => d.code} />\n      <Line data={rows} x=\"day\" y={['sessions', 'visits']} />\n      <Area data={rows} x=\"day\" y=\"sessions\" series=\"channel\" stacked />\n      <Bar data={rows} x=\"channel\" y=\"sessions\" layout=\"stacked\" horizontal />\n      <Scatter data={rows} x=\"visits\" y=\"sessions\" series=\"channel\" />\n      <Donut ref={donut} data={rows} label=\"channel\" value=\"sessions\" onSelect={p => p.index} />\n    </>\n  );\n}\n\nexport function Invalid() {\n  return (\n    <>\n      {/* @ts-expect-error misspelled field */}\n      <Line data={rows} x=\"day\" y=\"sesions\" />\n      {/* @ts-expect-error a text field on a value axis without parse: 'number' */}\n      <Line data={rows} x=\"day\" y=\"channel\" />\n      {/* @ts-expect-error series cannot be combined with wide y */}\n      <Line data={rows} x=\"day\" y={['sessions', 'visits']} series=\"channel\" />\n      {/* @ts-expect-error zoom does not apply to a donut */}\n      <Donut data={rows} label=\"channel\" value=\"sessions\" zoom />\n      {/* @ts-expect-error onZoom does not apply to a donut either */}\n      <Donut data={rows} label=\"channel\" value=\"sessions\" onZoom={() => {}} />\n      {/* @ts-expect-error the same misspelling on the other chart types */}\n      <Bar data={rows} x=\"day\" y=\"sesions\" />\n      {/* @ts-expect-error a category x on a scatter chart */}\n      <Scatter data={rows} x={{ field: 'channel', type: 'category' }} y=\"sessions\" />\n    </>\n  );\n}\n\n/** The same mistakes in core calls, so the components are seen to fail exactly where the core does. */\nexport function core(el: HTMLElement) {\n  // @ts-expect-error misspelled field\n  line(el, { data: rows, x: 'day', y: 'sesions' });\n  // @ts-expect-error a text field on a value axis without parse: 'number'\n  line(el, { data: rows, x: 'day', y: 'channel' });\n  // @ts-expect-error series cannot be combined with wide y\n  line(el, { data: rows, x: 'day', y: ['sessions', 'visits'], series: 'channel' });\n  // @ts-expect-error zoom does not apply to a donut\n  donut(el, { data: rows, label: 'channel', value: 'sessions', zoom: true });\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '248,295p;315,335p;371,425p' packages/axylo/test/core/controller.test.ts\n sed -n '120,153p;210,240p;305,391p' packages/axylo/test/browser/chart/lifecycle.browser.test.ts\n sed -n '20,61p;112,147p' packages/axylo/test/reader/index.test.ts\n sed -n '255,310p' packages/axylo/test/view/view.test.ts\n sed -n '410,470p' packages/axylo/test/browser/render/review.browser.test.ts\n node --input-type=module -e 'import fs from \\\"node:fs\\\";const j=JSON.parse(fs.readFileSync(\\\"acceptance/results/unit.json\\\")); const {numTotalTestSuites,numTotalTests,numPassedTests,numFailedTests,numPendingTests,success}=j; console.log({numTotalTestSuites,numTotalTests,numPassedTests,numFailedTests,numPendingTests,success}); for(const r of j.testResults)for(const a of r.assertionResults.filter(a=>a.status===\\\"failed\\\"))console.log(r.name,a.title,a.failureMessages[0]?.split(\\\"\\\\n\\\").slice(0,3))' \"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_28","type":"command_execution","command":"/bin/bash -lc \"sed -n '248,295p;315,335p;371,425p' packages/axylo/test/core/controller.test.ts\n sed -n '120,153p;210,240p;305,391p' packages/axylo/test/browser/chart/lifecycle.browser.test.ts\n sed -n '20,61p;112,147p' packages/axylo/test/reader/index.test.ts\n sed -n '255,310p' packages/axylo/test/view/view.test.ts\n sed -n '410,470p' packages/axylo/test/browser/render/review.browser.test.ts\n node --input-type=module -e 'import fs from \\\"node:fs\\\";const j=JSON.parse(fs.readFileSync(\\\"acceptance/results/unit.json\\\")); const {numTotalTestSuites,numTotalTests,numPassedTests,numFailedTests,numPendingTests,success}=j; console.log({numTotalTestSuites,numTotalTests,numPassedTests,numFailedTests,numPendingTests,success}); for(const r of j.testResults)for(const a of r.assertionResults.filter(a=>a.status===\\\"failed\\\"))console.log(r.name,a.title,a.failureMessages[0]?.split(\\\"\\\\n\\\").slice(0,3))' \"","aggregated_output":"  it('while paused, scatter and donut validate appended rows when append is called', () => {\n    const r = record('scatter', { title: 'P', strict: true, data: [{ x: 1, y: 1 }], x: 'x', y: 'y' });\n    r.frames();\n    r.controller.handle.append([{ x: 2, y: 2 }]);\n    r.controller.actions.pause(true);\n    r.frames();\n    expect(String(catching(() => r.controller.handle.append([{ x: 3, y: NaN }])))).toMatch(/AX103/);\n    r.controller.handle.append([{ x: 3, y: 3 }]);\n    r.frames();\n    expect(Array.from((r.committed!.view as ScatterView).frame.series[0]!.x)).toEqual([1, 2]);\n    r.controller.actions.pause(false);\n    r.frames();\n    expect(Array.from((r.committed!.view as ScatterView).frame.series[0]!.x)).toEqual([1, 2, 3]);\n  });\n});\n\ndescribe('finding 8: \"nothing to show\" comes from what the view draws', () => {\n  it('a line segment that crosses a zoomed window between its two points is drawn, not \"No data\"', () => {\n    const r = record('line', { title: 'Z', data: [{ x: 0, y: 0 }, { x: 10, y: 10 }], x: 'x', y: 'y' });\n    r.controller.handle.zoom([2, 4]);\n    r.frames();\n    expect(lastModel(r).message).toBeNull();\n    expect(r.draws.at(-1)!.marks.some(m => m.type === 'path')).toBe(true);\n  });\n\n  it('a scatter window with no point shows the empty state, and its zoom can still be reset', () => {\n    const r = record('scatter', { title: 'Z', data: [{ x: 0, y: 0 }, { x: 10, y: 10 }], x: 'x', y: 'y' });\n    r.controller.handle.zoom([2, 4]);\n    r.frames();\n    expect(lastModel(r).message).toBe('No data to show.');\n    expect(r.prepared.at(-1)!.zoomed).toBe(true);\n  });\n\n  it('an all-invalid chart keeps the reader note in its empty state (F12), and the compact marker (C5)', () => {\n    const data = [{ x: 1, y: 'n/a' }, { x: 2, y: 'n/a' }];\n    const full = record('line', { title: 'Bad', data, x: 'x', y: 'y' });\n    full.frames();\n    expect(lastModel(full).message).toBe('No data to show.');\n    expect(lastModel(full).note).toMatch(/Values not shown: 2/);\n    const compact = record('line', { title: 'Bad', compact: true, data, x: 'x', y: 'y' });\n    compact.frames();\n    expect(lastModel(compact).note).toMatch(/Values not shown: 2/);\n    expect(lastModel(compact).summary).toMatch(/^No data to show\\./);\n  });\n});\n\ndescribe('finding 9: the zoom window and the follow flag are reconciled when data or bounds change', () => {\n  it('[5,10] of [0,5,10]; data replaced up to 15: the window stays [5,10], and appending 20 does not move it', () => {\ndescribe('finding 10: one set of call-origin diagnostics, whatever the entry point', () => {\n  const bar = { title: 'B', data: [{ x: 'a', y: 2 }, { x: 'b', y: 3 }], x: 'x', y: { field: 'y', domain: [1, 3] } } as const;\n\n  it('validate and a created bar chart both report AX110; a clean append keeps it while the domain excludes zero', () => {\n    expect(codes(validate('bar', bar as never))).toEqual(['AX110']);\n    const r = record('bar', { ...bar });\n    expect(codes(r.controller.handle.diagnostics)).toEqual(['AX110']);\n    r.controller.handle.append([{ x: 'c', y: 2 }]);\n    expect(codes(r.controller.handle.diagnostics)).toEqual(['AX110']);\n  });\n\n  it('validate and creation agree on AX130 and AX131 too', () => {\n    const many = Array.from({ length: 9 }, (_, i) => ({ x: 1, s: `S${i}`, y: i }));\n    const options = { title: 'M', data: many, x: 'x', y: 'y', series: 's', compact: true };\n    const created = record('line', options).controller.handle.diagnostics;\n    expect(codes(validate('line', options as never))).toEqual(codes(created));\n    expect(codes(created)).toEqual(['AX130', 'AX131']);\n  });\n\n  it('zoom never throws for a value it cannot read: it reports it and keeps the window', () => {\n    const seen: string[] = [];\n});\n\ndescribe('finding 13: the L8 fallback is stable', () => {\n  it('stepping the container one pixel at a time through the boundary, both ways, switches once and never alternates', () => {\n    const r = record('line', { title: 'Small', data: rowsOf([1, 2, 3]), x: 'x', y: 'y' });\n    const states = (heights: number[]) => heights.map(height => {\n      r.container = { width: 400, height };\n      r.controller.invalidate.resize();\n      r.frames();\n      const settled = r.committed!.tooSmall;\n      // Ten more frames at the same size change nothing.\n      for (let i = 0; i < 10; i++) {\n        r.controller.invalidate.resize();\n        r.frames();\n        expect(r.committed!.tooSmall, `height ${height}, frame ${i}`).toBe(settled);\n      }\n      return settled;\n    });\n    const up = Array.from({ length: 80 }, (_, i) => 100 + i);\n    const grow = states(up);\n    const shrink = states([...up].reverse()).reverse();\n    expect(grow).toEqual(shrink);\n    const switches = grow.filter((v, i) => i > 0 && v !== grow[i - 1]).length;\n    expect(switches).toBe(1);\n    expect(grow[0]).toBe(true);\n    expect(grow.at(-1)).toBe(false);\n  });\n});\n\ndescribe('finding 15: bars on a continuous x use the view domain for ticks, marks and lookup', () => {\n  it('with x.domain [0, 20] no tick lies outside [0, 20], and the projection is the view domain', () => {\n    const r = record('bar', { title: 'B', data: [{ x: 5, y: 1 }, { x: 10, y: 2 }, { x: 15, y: 3 }], x: { field: 'x', domain: [0, 20] }, y: 'y' });\n    r.frames();\n    const layout = r.committed!.layout;\n    if (layout.kind !== 'plot' || layout.projection.kind !== 'bands') throw new Error('expected a bar layout');\n    const view = r.committed!.view as AlignedView;\n    expect(view.xDomain).toEqual([0, 20]);\n    expect((layout.projection.band as { domain: readonly number[] }).domain).toEqual([0, 20]);\n    for (const tick of layout.xTicks) {\n      expect(tick.value).toBeGreaterThanOrEqual(0);\n      expect(tick.value).toBeLessThanOrEqual(20);\n    }\n  });\n});\n\ndescribe('finding 16: a pinned donut color lands on its own slice', () => {\n  it('Empty: 0 before Sales: 4 with Sales pinned: the theme binds the pin to the palette slot the Sales arc uses', () => {\n    const r = record('donut', { title: 'D', data: [{ l: 'Empty', v: 0 }, { l: 'Sales', v: 4 }], label: 'l', value: 'v', colors: { Sales: 'red' } });\n    r.frames();\n    const view = r.committed!.view as DonutView;\n    const sales = view.slices.find(s => s.label === 'Sales')!;\n    const keys = r.themeCalls.at(-1)!.keys;\n    expect(keys[sales.colorIndex!]).toBe('Sales');\n    const arcs = r.draws.at(-1)!.marks.find(m => m.type === 'arcs');\n    if (!arcs || arcs.type !== 'arcs') throw new Error('expected arcs');\n  it('update({ data }), append and zoom in one turn are drawn once and end in the expected state', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const DAY = 864e5;\n      const rows = (from: number, n: number) => Array.from({ length: n }, (_, i) => ({ day: from + i * DAY, v: i }));\n      const t0 = Date.UTC(2026, 0, 1);\n      const chart = window.Axylo.line!('#chart', { title: 'Seq', data: rows(t0, 30), x: { field: 'day', type: 'time', timeZone: 'UTC' }, y: 'v' });\n      await chart.__bench.ready();\n      const before = chart.__dev.stages();\n      const replaced = rows(t0 + 100 * DAY, 10);\n      chart.update({ data: replaced });\n      chart.append([{ day: t0 + 110 * DAY, v: 10 }, { day: t0 + 111 * DAY, v: 11 }]);\n      chart.zoom([new Date(t0 + 105 * DAY), new Date(t0 + 111 * DAY)]);\n      const sync = chart.__dev.stages();\n      await chart.__bench.ready();\n      await window.nextFrames(2);\n      const after = chart.__dev.stages();\n      return { before, sync, after, describe: chart.__bench.describe(), t0, DAY };\n    });\n    const { before, sync, after, describe, t0, DAY } = result;\n    expect(sync.draw).toBe(before.draw);\n    expect(after.draw - before.draw).toBe(1);\n    expect(after.frame - before.frame).toBe(1);\n    expect(describe.series[0]!.points).toBe(12);\n    expect(describe.series[0]!.oldestX).toBe(t0 + 100 * DAY);\n    expect(describe.series[0]!.newestX).toBe(t0 + 111 * DAY);\n    expect(describe.xDomain).toEqual([t0 + 105 * DAY, t0 + 111 * DAY]);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('append with keep keeps that many x values, and a window zoomed to the latest edge follows', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const t0 = Date.UTC(2026, 0, 1);\n  it('a rejected strict update throws and leaves the previous chart intact', async () => {\n    const page = await chartPage();\n    const result = await page.evaluate(async () => {\n      const good = Array.from({ length: 7 }, (_, i) => ({ day: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'][i], value: i }));\n      const chart = window.Axylo.line!('#chart', { title: 'Strict', strict: true, data: good, x: 'day', y: 'value' });\n      await chart.__bench.ready();\n      const before = { stages: chart.__dev.stages(), diagnostics: chart.diagnostics, describe: chart.__bench.describe(), revision: chart.__bench.revision };\n      let thrown = '';\n      try {\n        chart.update({ data: window.fx.dirtyRows(), title: 'Changed' });\n      } catch (e) {\n        thrown = String(e);\n      }\n      await window.nextFrames(3);\n      return {\n        thrown, before,\n        after: { stages: chart.__dev.stages(), diagnostics: chart.diagnostics, describe: chart.__bench.describe(), revision: chart.__bench.revision },\n        heading: document.querySelector('#chart .axylo-title')!.textContent,\n      };\n    });\n    expect(result.thrown).toMatch(/AX10[236]/);\n    expect(result.after.diagnostics).toEqual(result.before.diagnostics);\n    expect(result.after.describe).toEqual(result.before.describe);\n    expect(result.after.revision).toBe(result.before.revision);\n    expect(result.after.stages.draw).toBe(result.before.stages.draw);\n    expect(result.heading).toBe('Strict');\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('a rejected strict append leaves the data as it was', async () => {\n    const page = await chartPage();\ndescribe('memory (spec P7, DX5)', () => {\n  // Method corrected by the coordinator on 2026-11-18. The first version compared cycles 200–400 with 800–1000\n  // and allowed 5%; it measured 5.3%, and heap snapshots put that growth in the engine's compiled code, which\n  // keeps growing until about 1,500 cycles and then stops. A leak is growth that does not stop, so the trend is\n  // now judged after that warm-up, with a tighter allowance (1%). The snapshot test below checks retained\n  // objects directly.\n  it('create–destroy cycles show no upward heap trend once the engine has warmed up', async () => {\n    const page = await chartPage();\n    const cdp = await page.context().newCDPSession(page);\n    await cdp.send('HeapProfiler.enable');\n    const samples: { cycle: number; used: number }[] = [];\n    const STEP = 25;\n    for (let cycle = 0; cycle < 2500; cycle += STEP) {\n      await page.evaluate(async n => {\n        const el = document.getElementById('chart')!;\n        const rows = window.fx.trendRows();\n        for (let i = 0; i < n; i++) {\n          const chart = window.Axylo.line!(el, { title: 'Cycle', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n          await chart.__bench.ready();\n          chart.destroy();\n        }\n      }, STEP);\n      await cdp.send('HeapProfiler.collectGarbage');\n      await cdp.send('HeapProfiler.collectGarbage');\n      const { usedSize } = await cdp.send('Runtime.getHeapUsage');\n      samples.push({ cycle: cycle + STEP, used: usedSize });\n    }\n    const mean = (from: number, to: number) => {\n      const s = samples.filter(x => x.cycle > from && x.cycle <= to);\n      return s.reduce((a, b) => a + b.used, 0) / s.length;\n    };\n    const early = mean(1500, 2000);\n    const late = mean(2000, 2500);\n    expect(late / early, `heap mean cycles 1500–2000: ${Math.round(early)} B, 2000–2500: ${Math.round(late)} B`).toBeLessThanOrEqual(1.01);\n    const leftovers = await page.evaluate(() => document.getElementById('chart')!.childElementCount);\n    expect(leftovers).toBe(0);\n    expect(await closePage(page)).toEqual([]);\n  }, 600_000);\n\n  // Supplementary to the test above. On this machine the heap measured that way grows by about 6% between\n  // cycles 200–400 and 800–1000 and levels off after about 1,500 cycles; heap snapshots attribute the growth\n  // to compiled code (V8 InstructionStream, Code and their metadata), not to objects the chart retains. This\n  // test counts only what a leak would leave: every heap object except compiled code and V8's own metadata.\n  it('objects other than compiled code do not grow from cycle 300 to cycle 1,000', async () => {\n    const page = await chartPage();\n    const cdp = await page.context().newCDPSession(page);\n    const cycles = (n: number) => page.evaluate(async k => {\n      const el = document.getElementById('chart')!;\n      const rows = window.fx.trendRows();\n      for (let i = 0; i < k; i++) {\n        const chart = window.Axylo.line!(el, { title: 'Cycle', data: rows, x: 'day', y: 'sessions', series: 'channel' });\n        await chart.__bench.ready();\n        chart.destroy();\n      }\n    }, n);\n    const retained = async (): Promise<number> => {\n      await cdp.send('HeapProfiler.collectGarbage');\n      const chunks: string[] = [];\n      const onChunk = (e: { chunk: string }) => chunks.push(e.chunk);\n      cdp.on('HeapProfiler.addHeapSnapshotChunk', onChunk);\n      await cdp.send('HeapProfiler.takeHeapSnapshot', { reportProgress: false });\n      cdp.off('HeapProfiler.addHeapSnapshotChunk', onChunk);\n      const snap = JSON.parse(chunks.join('')) as { snapshot: { meta: { node_fields: string[]; node_types: [string[]] } }; nodes: number[]; strings: string[] };\n      const fields = snap.snapshot.meta.node_fields;\n      const types = snap.snapshot.meta.node_types[0];\n      const typeAt = fields.indexOf('type');\n      const nameAt = fields.indexOf('name');\n      const sizeAt = fields.indexOf('self_size');\n      let total = 0;\n      for (let i = 0; i < snap.nodes.length; i += fields.length) {\n        const type = types[snap.nodes[i + typeAt]!];\n        const name = snap.strings[snap.nodes[i + nameAt]!]!;\n        if (type === 'code' || name.startsWith('system / ')) continue;\n        total += snap.nodes[i + sizeAt]!;\n      }\n      return total;\n    };\n    await cycles(300);\n    const early = await retained();\n    await cycles(700);\n    const late = await retained();\n    // One leaked chart (its DOM, frame and scene) is several kilobytes; 700 of them would be megabytes.\n    expect(late - early, `non-code heap at cycle 300: ${early} B, at 1,000: ${late} B`).toBeLessThan(64 * 1024);\n    expect(await closePage(page)).toEqual([]);\n  }, 300_000);\n});\n\nit('summarizes three visible series within the shown range and includes the reference position in the summary and caption', () => {\n  const model = read(trend, { title: { text: 'Daily sessions', visible: false }, subtitle: 'Acquisition channels' });\n  expect(model.name).toBe('Daily sessions');\n  expect(model.summary).toBe('Line chart with 3 series. Day from 1 to 3. Sessions from 5 to 30. '\n    + 'Direct: minimum 10, maximum 30, last 20. Search: minimum 12, maximum 20, last 12. '\n    + 'Referral: minimum 5, maximum 8, last 8. Reference line Target at 20. Acquisition channels');\n  expect(model.note).toBeNull();\n  expect(model.table?.caption).toBe('Daily sessions Reference line Target at 20.');\n});\n\nit('adds the zone for instants and leaves it out for calendar dates', () => {\n  function byDay(start: string, end: string) {\n    return aligned(frame('line', { data: [{ day: start, value: 1 }, { day: end, value: 5 }],\n      x: { field: 'day', timeZone: 'America/Los_Angeles' }, y: 'value' }));\n  }\n  const time = read(byDay('2026-02-24T12:00:00Z', '2026-02-25T13:00:00Z'));\n  const dates = read(byDay('2026-02-24', '2026-02-25'));\n  expect(time.summary).toContain('Times are shown in America/Los_Angeles.');\n  expect(time.table?.pageForX(new Date('2026-02-25T12:00:00Z'))).toBe(0);\n  expect(dates.summary).not.toContain('Times are shown');\n  expect(dates.table?.pageForX('2026-02-25')).toBe(0);\n  expect(dates.table?.pageForX('2026-02-30')).toBeNull();\n});\n\nit('keeps disclosures before the author description and joins both visible notes', () => {\n  const input = { description: 'The reporting period was revised.', disclosure: { omitted: 2, changed: 1 }, labelsHidden: 4 };\n  const model = read(trend, input);\n  expect(model.summary).toMatch(/Values not shown: 2\\. See table\\. Values shown differently from the data: 1\\. See table\\. The reporting period was revised\\.$/);\n  expect(model.note).toBe('Values not shown: 2. See table. Values shown differently from the data: 1. See table. Some labels hidden. See table.');\n  const custom = read(trend, {\n    ...input,\n    formatters: { ...formatter(trend.frame), count: n => `count(${n})` },\n    messages: resolveMessages({ valuesNotShown: 'Omitted {count}.', valuesChanged: 'Changed {count}.' }),\n  });\n  expect(custom.note).toBe('Omitted count(2). Changed count(1). Some labels hidden. See table.');\n  expect(custom.summary).toContain('Line chart with count(3) series.');\n  expect(read(trend, { disclosure: { omitted: 0, changed: 1 }, compact: true }).summary)\n    .toContain('Values shown differently from the data: 1. See table.');\n});\n\nit('uses the external heading when supplied, otherwise generates and reports a missing name', () => {\n  expect(read(trend, { table: false }).table).toBeNull();\n});\n\nit('marks an incomplete stack in its row header without changing the series cells', () => {\n  const data = frame('area', { data: [{ x: 0, a: 2, b: null }, { x: 1, a: 3, b: -1 }], x: 'x', y: ['a', 'b'] });\n  const table = read(aligned(data, { kind: 'area', stack: {\n    order: [0, 1], incomplete: Uint8Array.of(1, 0),\n    positive: [Float64Array.of(2, 3), Float64Array.of(2, 3)],\n    negative: [Float64Array.of(0, 0), Float64Array.of(0, -1)],\n  } })).table!;\n  expect(table.row(0)).toEqual(['0 (incomplete)', '2', 'No data']);\n  expect(table.row(1)).toEqual(['1', '3', '-1']);\n});\n\nit('presents grouped donut categories separately in the table and together in the summary', () => {\n  const values = [1, 2, 3, 4, 5, 6, 7, 8, 64];\n  const data = frame('donut', { data: values.map((value, i) => ({ category: `C${i}`, value })), label: 'category',\n    value: { field: 'value', label: 'Count', unit: 'sessions' } });\n  const base = donut(data);\n  const model = read({ ...base, slices: [...base.slices.slice(2), {\n    key: 'other', label: 'Other (2)', colorIndex: 7, members: [0, 1], value: 3, ratio: 0.03, angles: [0.97 * 2 * Math.PI, 2 * Math.PI],\n  }] }, { type: 'Donut' });\n  const table = model.table!;\n  expect(table.headers).toEqual(['Category', 'Count (sessions)', 'Percentage']);\n  expect(table.rowCount).toBe(9);\n  expect(table.row(0)).toEqual(['C0', '1 sessions', '1%']);\n  expect(table.row(1)).toEqual(['C1', '2 sessions', '2%']);\n  expect(table.row(8)).toEqual(['C8', '64 sessions', '64%']);\n  expect(table.pageForX('C8')).toBe(0);\n  expect(model.summary).toBe('Donut chart with 8 slices. Total 100 sessions. '\n    + 'C2: 3 sessions (3%). C3: 4 sessions (4%). C4: 5 sessions (5%). C5: 6 sessions (6%). '\n    + 'C6: 7 sessions (7%). C7: 8 sessions (8%). C8: 64 sessions (64%). Other (2): 3 sessions (3%).');\n  expect(model.summary).not.toContain('C0:');\n});\n\nit('merges scatter rows in x then y order including hidden series', () => {\ndescribe('donut slices', () => {\n  it('places the parts fixture clockwise in its given order from twelve o’clock', () => {\n    const labels = ['Chrome', 'Safari', 'Edge', 'Firefox', 'Samsung Internet', 'Other'];\n    const values = [46.2, 27.5, 14.1, 8.9, 2.1, 1.2];\n    const endpoints = [0, 46.2, 73.7, 87.8, 96.7, 98.8, 100];\n    const { view } = donut(labels.map((label, i) => ({ label, value: values[i]! })));\n    expect(view.slices.map(slice => slice.label)).toEqual(labels);\n    expect(view.total).toBeCloseTo(100);\n    for (let i = 0; i < labels.length; i++) {\n      const slice = view.slices[i]!;\n      expect(slice.members).toEqual([i]);\n      expect(slice.ratio).toBeCloseTo(values[i]! / 100, 12);\n      expect(slice.angles![0]).toBeCloseTo(endpoints[i]! * Math.PI / 50, 12);\n      expect(slice.angles![1]).toBeCloseTo(endpoints[i + 1]! * Math.PI / 50, 12);\n    }\n  });\n\n  it('lists zero and null entries with no arcs and leaves an all-zero ring empty', () => {\n    const entries = [{ label: 'Zero', value: 0 }, { label: 'Missing', value: null }, { label: 'Positive', value: 5 }];\n    const { view } = donut(entries);\n    expect(view.slices).toEqual([\n      { key: 'Zero', label: 'Zero', members: [0], value: 0, ratio: 0, angles: null, colorIndex: 1 },\n      { key: 'Missing', label: 'Missing', members: [1], value: null, ratio: null, angles: null, colorIndex: 2 },\n      { key: 'Positive', label: 'Positive', members: [2], value: 5, ratio: 1, angles: [0, 2 * Math.PI], colorIndex: 0 },\n    ]);\n    const empty = donut(entries.slice(0, 2)).view;\n    expect(empty.total).toBe(0);\n    expect(empty.slices.every(slice => slice.angles === null)).toBe(true);\n  });\n\n  it('keeps the seven largest in original order, favoring the first tie at the cutoff', () => {\n    const values = [2, 10, 6, 8, 4, 4, 1, 9, 5, 7];\n    const { view, diagnostics } = donut(values.map((value, i) => ({ label: 'Category ' + i, value })),\n      { otherLabel: count => count + ' remaining' });\n    expect(view.total).toBe(56);\n    expect(view.slices.map(slice => slice.members)).toEqual([[1], [2], [3], [4], [7], [8], [9], [0, 5, 6]]);\n    expect(view.slices[7]).toEqual({\n      key: '__other__', label: '3 remaining', members: [0, 5, 6], value: 7, ratio: 1 / 8, colorIndex: null,\n      angles: [expect.closeTo(7 * Math.PI / 4, 12), 2 * Math.PI],\n    });\n    expect(diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX121', level: 'warning', count: 3 })]);\n  });\n\n  it('counts positive entries for grouping and does not render a partially negative ring', () => {\n    const data = Array.from({ length: 10 }, (_, i) => ({ label: 'Part ' + i, value: i === 0 ? null : i - 1 }));\n    const valid = donut(data);\n    expect(valid.view.slices).toHaveLength(10);\n    expect(valid.diagnostics.inputs()).toEqual([]);\n    const invalid = donut([...data, { label: 'Negative', value: -1 }]);\n    expect(invalid.view.slices).toEqual([]);\n    expect(invalid.diagnostics.inputs()).toEqual([expect.objectContaining({ code: 'AX120', level: 'error' })]);\n  });\n\n  it('reserves the grouped slice key even if a category has that name', () => {\n    const { view } = donut(Array.from({ length: 9 }, (_, i) => ({ label: i === 0 ? '__other__' : 'Part ' + i, value: 1 })));\n    expect(view.slices[0]!.label).toBe('__other__');\n      const out: number[] = [];\n      for (const x of [20, 460]) {\n        const img = await shot(page, x, 60, 400, 300);\n        let n = 0;\n        for (let px = 60; px < 360; px++) if (diff(at(img, px, 150), WHITE) <= 10) n++;\n        out.push(n);\n      }\n      await close(page);\n      return out;\n    };\n    const normal = await gaps('no-preference');\n    const more = await gaps('more');\n    // [8, 3] over 300 px: about 3/11 of the line is gap; [2, 2]: about half.\n    for (const n of normal) { expect(n).toBeGreaterThan(50); expect(n).toBeLessThan(110); }\n    for (const n of more) expect(n).toBeGreaterThan(110);\n  });\n\n  it('text: after text-spacing overrides and after a late font, relaid-out labels land on their boxes and nothing is clipped', async () => {\n    const page = await open();\n    await page.evaluate(() => window.axr.mountText(20, 60));\n    await page.addStyleTag({ content: '* { letter-spacing: 0.12em !important; word-spacing: 0.16em !important; line-height: 1.5 !important; }' });\n    const check = (probes: { box: Record<string, number>; rect: Record<string, number>; overflow?: boolean }[], what: string): void => {\n      probes.forEach((p, i) => {\n        expect(p.overflow, `${what} ${i} overflow`).toBe(false);\n        for (const k of ['x', 'y', 'width', 'height']) expect(Math.abs(p.rect[k]! - p.box[k]!), `${what} ${i} ${k}`).toBeLessThanOrEqual(1.5);\n      });\n    };\n    check(await page.evaluate(() => window.axr.relayoutText()), 'spacing');\n    const before = await page.evaluate(() => window.axr.measureText());\n    const font = fs.readFileSync('/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf').toString('base64');\n    await page.evaluate(() => { (document.querySelector('.axylo-text')!.parentElement as HTMLElement).style.setProperty('font-family', '\"Late Serif\", sans-serif'); });\n    expect(await page.evaluate(f => window.axr.loadFont('Late Serif', f), font)).toBe(true);\n    const relaid = await page.evaluate(() => window.axr.relayoutText());\n    check(relaid, 'late font');\n    expect(relaid[2]!.rect.width).toBeGreaterThan(before[2]!.rect.width + 5);\n    await close(page);\n  });\n\n  it('DX8: text layer, renderers and styles work under a Content Security Policy without unsafe-inline, served with real headers', async () => {\n    const page = await open();\n    const violations: string[] = [];\n    await page.route('**/blank.html', async route => {\n      const response = await route.fetch();\n      await route.fulfill({ response, headers: { ...response.headers(), 'content-security-policy': \"default-src 'self'; script-src 'self'; style-src 'self'\" } });\n    });\n    await page.goto(url('packages/axylo/test/browser/blank.html'));\n    await page.exposeFunction('reportViolation', (v: string) => { violations.push(v); });\n    await page.evaluate(() => document.addEventListener('securitypolicyviolation', e => (window as unknown as { reportViolation(v: string): void }).reportViolation(`${e.violatedDirective} ${e.blockedURI}`)));\n    await page.addScriptTag({ url: url(`packages/axylo/test/browser/.out/${ENTRY.split('/').pop()!.replace(/\\.ts$/, '.js')}`) });\n    const probes = await page.evaluate(() => {\n      window.axr.mount('svg', 20, 360);\n      window.axr.mount('canvas', 460, 360);\n      return window.axr.mountText(20, 60);\n    });\n    for (const p of probes) for (const k of ['x', 'y', 'width', 'height'] as const) expect(Math.abs(p.rect[k] - p.box[k])).toBeLessThanOrEqual(1.5);\n    expect(await page.evaluate(() => getComputedStyle(document.querySelector('.axylo-svg')!).position)).toBe('absolute');\n    const img = await shot(page, 20, 360, 400, 300);\n    expect(diff(at(img, 85, 50), series(0))).toBeLessThanOrEqual(8);\n    await frames(page, 2);\n    expect(violations).toEqual([]);\n    await close(page);\n{\n  numTotalTestSuites: 142,\n  numTotalTests: 567,\n  numPassedTests: 567,\n  numFailedTests: 0,\n  