eadonly scales: ScaleConstructors;\n  readonly references?: readonly ResolvedReference[];\n  /** View bounds when they differ from the scale's domain, such as on a padded bar axis. */\n  readonly referenceXDomain?: Span;\n}\n\ntype Cartesian = Axes & (\n  | { readonly kind: 'xy' }\n  | { readonly kind: 'bands'; readonly horizontal: boolean }\n);\n\ninterface TextInput {\n  readonly measurer: TextMeasurer;\n  readonly style: TextStyle;\n}\n\ntype PlotInput = Size & {\n  /** Ignored. Presentation derives AX142 and AX143 from the returned layout. */\n  readonly diagnostics?: DiagnosticSink;\n  readonly compact?: boolean;\n};\n\nexport type LayoutInput =\n  | (PlotInput & Cartesian & TextInput)\n  | (PlotInput & { readonly kind: 'ring' })\n  | (Size & TextInput & { readonly kind: 'message'; readonly message: string });\n\nconst INSET = 4;\nconst GAP = 4;\nconst TICK_GAP = 6;\nconst MIN_WIDTH = 120;\nconst MIN_HEIGHT = 80;\nconst UNCHANGED = { remedies: [], hidden: 0 } as const;\n\nfunction independentScale(axis: Axes['x'], range: Span, scales: ScaleConstructors): XScale {\n  return axis.type === 'band' ? scales.band(axis.count, range, axis.padding) : scales[axis.type](axis.domain, range);\n}\n\nfunction project(plot: Rect, axes: Cartesian): Exclude<Projection, { kind: 'ring' }> {\n  const across: Span = [plot.x, plot.x + plot.width];\n  const up: Span = [plot.y + plot.height, plot.y];\n  const horizontal = axes.kind === 'bands' && axes.horizontal;\n  const down: Span = [plot.y, plot.y + plot.height];\n  const x = independentScale(axes.x, horizontal ? (axes.x.type === 'band' ? down : up) : across, axes.scales);\n  const y = axes.scales.linear(axes.y.domain, horizontal ? across : up);\n  return axes.kind === 'xy' ? { kind: 'xy', x, y } : { kind: 'bands', horizontal, band: x, value: y };\n}\n\nfunction ring(plot: Rect): Projection {\n  const r1 = Math.min(plot.width, plot.height) / 2;\n  return { kind: 'ring', cx: plot.x + plot.width / 2, cy: plot.y + plot.height / 2, r0: r1 * 0.6, r1 };\n}\n\nfunction tooSmall(size: Size): Layout {\n  return { ...size, kind: 'too-small' };\n}\n\nfunction metrics(input: TextInput): Metrics {\n  const widths = new Map<string, number>();\n  return {\n    lineHeight: input.style.lineHeight,\n    width(text) {\n      const cached = widths.get(text);\n      if (cached !== undefined) return cached;\n      const width = input.measurer.width(text, input.style);\n      widths.set(text, width);\n      return width;\n    },\n  };\n}\n\nfunction moveText(text: PlacedText, dx: number, dy: number): PlacedText {\n  return { ...text, x: text.x + dx, y: text.y + dy, box: { ...text.box, x: text.box.x + dx, y: text.box.y + dy } };\n}\n\nfunction lane(fit: FittedLabels): number {\n  return fit.texts.length ? TICK_GAP + fit.depth : 0;\n}\n\nfunction hiddenTicks(candidates: TickCandidates): FittedLabels {\n  return { ticks: [], texts: [], depth: 0, fit: { remedies: [], hidden: candidates[0]?.length ?? 0 } };\n}\n\nfunction layoutAxes(input: PlotInput & Cartesian & TextInput, size: Size, text: Metrics, showTicks: boolean): Layout {\n  const { width, height } = size;\n  const horizontal = input.kind === 'bands' && input.horizontal;\n  const leftAxis = horizontal ? input.x : input.y;\n  const bottomAxis = horizontal ? input.y : input.x;\n  const leftCandidates = horizontal ? leftAxis.candidates.slice(0, 1) : leftAxis.candidates;\n  const bottomCandidates = !horizontal && !bottomAxis.mayThin ? bottomAxis.candidates.slice(0, 1) : bottomAxis.candidates;\n  const leftLabels = showTicks ? prepareLabels(leftCandidates) : undefined;\n  const bottomLabels = showTicks ? prepareLabels(bottomCandidates) : undefined;\n  const leftRole = horizontal ? 'tick-x' : 'tick-y';\n  const bottomRole = horizontal ? 'tick-y' : 'tick-x';\n  const clearance = leftLabels?.sets.some(set => set.ticks.length > 0) ? text.lineHeight / 2 : 0;\n  const top = INSET + clearance;\n  let left = INSET;\n  let bottom = INSET + clearance;\n  const visited = new Set<string>();\n  let growMargins = false;\n\n  for (;;) {\n    const plot = { x: left, y: top, width: width - left - INSET, height: height - top - bottom };\n    if (plot.width < MIN_WIDTH - 1e-7 || plot.height < MIN_HEIGHT - 1e-7) return tooSmall(size);\n\n    const projection = project(plot, input);\n    const xScale = projection.kind === 'xy' ? projection.x : projection.band;\n    const yScale = projection.kind === 'xy' ? projection.y : projection.value;\n    const leftTitle = leftAxis.title ? wrapText(leftAxis.title, plot.height, text) : [];\n    const bottomTitle = bottomAxis.title ? wrapText(bottomAxis.title, plot.width, text) : [];\n60:export const LATENCY = {\n61-  title: 'Latency by payload size',\n62-  points: [\n63-    { size: 10, latency: 120, region: 'EU' }, { size: 20, latency: 140, region: 'EU' }, { size: 30, latency: 135, region: 'EU' },\n64-    { size: 15, latency: 90, region: 'US' }, { size: 20, latency: 100, region: 'US' }, { size: 35, latency: 95, region: 'US' },\n65-  ],\n66-  x: { label: 'Payload', unit: 'kB' },\n67-  y: { label: 'Latency', unit: 'ms' },\n68-};\n69-/** Keyboard order for scatter (spec 3.6): by x, then y. Ties at x = 20 go to the lower y (US 100 before EU 140). */\n70:export const LATENCY_ORDER = [...LATENCY.points].sort((a, b) => a.size - b.size || a.latency - b.latency);\n71-\n72-// ── donut: monthly spend, four slices, shares 50 / 25 / 15 / 10 % ─────────────────────────────────\n73-\n74-export const SPEND = {\n75-  title: 'Monthly spend',\n76-  items: ['Rent', 'Food', 'Travel', 'Books'],\n77-  values: [1200, 600, 360, 240],\n78-  label: 'Spend',\n79-  unit: 'EUR',\n80-};\n81-export const SPEND_TOTAL = SPEND.values.reduce((a, b) => a + b, 0);\n82-export const share = (v: number, total = SPEND_TOTAL): string =>\n83-  new Intl.NumberFormat('en-US', { style: 'percent', maximumFractionDigits: 1 }).format(v / total);\n84-\n85-// ── the Phase 1 `dirty` fixture (research/harness/src/data.js) ─────────────────────────────────────\n86-\n87-/** Mon–Sun: 10, 20, null, NaN, '40', undefined, 70. Left out by a warning: Thu (NaN), Fri ('40'), Sat (absent). */\n88-export const DIRTY = {\n89-  categories: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],\n90-  values: [10, 20, null, NaN, '40', undefined, 70] as unknown[],\n41:export async function prodPage(options: { css?: string; viewport?: { width: number; height: number } } = {}): Promise<Page> {\n42:  const page = await openPage(options.viewport ? { viewport: options.viewport } : {});\n228:/** The plot area in viewport px (the keyboard proxy covers exactly it) and the drawn domains (dev only). */\n445:/** A donut's ring in viewport px: centre and outer radius, from the union of the drawn slices' boxes. */\nUpdated [lookup](/home/canarit/projects/axylo/packages/axylo/src/lookup), [reader](/home/canarit/projects/axylo/packages/axylo/src/reader), [messages](/home/canarit/projects/axylo/packages/axylo/src/messages), and their tests. The regression run failed 21 tests before the implementation changes. The final owned run passed all 46 tests. No contract changes were needed.\n\n| Finding | Reproduced | Fixed | Coverage |\n|---|---|---|---|\n| 1. Stale focus | Yes | Yes | Hidden and zoomed-out refs in aligned and scatter views, including stepping from the replacement. |\n| 2. Position | Yes | Yes in owned code | Visible-slot ordinal property with two visible series and a hidden middle series. `pointOf` uses the formatted ordinal plus one and count. |\n| 3. Table caption | Yes | Yes in owned code | `labelledBy` with supplied heading text and with the generated fallback. |\n| 4. Disclosures | Yes | Yes | Separate omitted and changed sentences, combined notes, and formatter-supplied counts. |\n| 5. Localization | Yes | Yes | Message overrides for chart types and headers, plus field-name fallback. |\n| 6. Missing stack total | Yes | Yes | All-missing stack reads “No data.” |\n| 7. Empty ranges | Yes | Yes | One no-data sentence per series, no unavailable value