{"type":"item.completed","item":{"id":"item_4","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/src/lookup/scatter-grid.ts packages/axylo/src/lookup/scatter.ts packages/axylo/src/lookup/point-order.ts packages/axylo/src/lookup/geometry.ts packages/axylo/src/lookup/index.ts'","aggregated_output":"import type { ScatterView } from '../core/contracts';\nimport { contains, type PlotLayout } from './geometry';\n\nconst CELL = 24;\nconst RADIUS2 = CELL * CELL;\nconst COINCIDENT = 0.5;\nconst COINCIDENT2 = COINCIDENT ** 2;\nconst LEAF_SIZE = 32;\nexport const POINT_LIMIT = 8;\n\ninterface Bucket {\n  readonly start: number;\n  readonly end: number;\n  readonly minX: number;\n  readonly maxX: number;\n  readonly minY: number;\n  readonly maxY: number;\n  readonly left?: Bucket;\n  readonly right?: Bucket;\n  readonly coincident?: number;\n}\n\nfunction distanceTo(bucket: Bucket, x: number, y: number): number {\n  return Math.max(bucket.minX - x, x - bucket.maxX, 0) ** 2\n    + Math.max(bucket.minY - y, y - bucket.maxY, 0) ** 2;\n}\n\nfunction distanceAcross(bucket: Bucket, x: number, y: number): number {\n  return Math.max(Math.abs(bucket.minX - x), Math.abs(bucket.maxX - x)) ** 2\n    + Math.max(Math.abs(bucket.minY - y), Math.abs(bucket.maxY - y)) ** 2;\n}\n\nexport function scatterGrid(view: ScatterView, layout: PlotLayout & { projection: Extract<PlotLayout['projection'], { kind: 'xy' }> }, count: number) {\n  const { plot, projection } = layout;\n  const columns = Math.floor(plot.width / CELL) + 1;\n  const rows = Math.floor(plot.height / CELL) + 1;\n  const heads = new Map<number, number>();\n  const next = new Int32Array(count);\n  const series = new Uint32Array(count);\n  const points = new Uint32Array(count);\n  const xs = new Float64Array(count);\n  const ys = new Float64Array(count);\n  let length = 0;\n  let examined = 0;\n  let cellsExamined = 0;\n\n  const column = (x: number) => Math.floor((x - plot.x) / CELL);\n  const row = (y: number) => Math.floor((y - plot.y) / CELL);\n  const cellFor = (x: number, y: number) => column(x) + columns * row(y);\n\n  function sourceRow(at: number): number {\n    const i = points[at]!;\n    return view.frame.series[series[at]!]!.row?.[i] ?? i;\n  }\n\n  function later(at: number, other: number): boolean {\n    const difference = sourceRow(at) - sourceRow(other);\n    if (difference !== 0) return difference > 0;\n    const cellDifference = cellFor(xs[at]!, ys[at]!) - cellFor(xs[other]!, ys[other]!);\n    return cellDifference < 0 || cellDifference === 0 && at > other;\n  }\n\n  view.frame.series.forEach((data, s) => {\n    if (!view.visible[s] || !data.drawable) return;\n    const { start, end } = view.visiblePoints[s]!;\n    for (let i = start; i < end; i++) {\n      const x = projection.x.map(data.x[i]!);\n      const y = projection.y.map(data.y[i]!);\n      if (!contains(plot, x, y)) continue;\n      const cell = cellFor(x, y);\n      const at = length++;\n      next[at] = heads.get(cell) ?? -1;\n      heads.set(cell, at);\n      xs[at] = x;\n      ys[at] = y;\n      series[at] = s;\n      points[at] = i;\n    }\n  });\n\n  const order = new Uint32Array(length);\n  const buckets = new Map<number, Bucket>();\n  function build(start: number, end: number): Bucket {\n    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;\n    for (let i = start; i < end; i++) {\n      const p = order[i]!;\n      minX = Math.min(minX, xs[p]!);\n      maxX = Math.max(maxX, xs[p]!);\n      minY = Math.min(minY, ys[p]!);\n      maxY = Math.max(maxY, ys[p]!);\n    }\n    const bounds = { start, end, minX, maxX, minY, maxY };\n    if (minX === maxX && minY === maxY) {\n      let coincident = order[start]!;\n      for (let i = start + 1; i < end; i++) if (later(order[i]!, coincident)) coincident = order[i]!;\n      return { ...bounds, coincident };\n    }\n    if (end - start <= LEAF_SIZE) return bounds;\n\n    const byX = maxX - minX >= maxY - minY;\n    const positions = byX ? xs : ys;\n    const pivot = byX ? minX / 2 + maxX / 2 : minY / 2 + maxY / 2;\n    let mid = start;\n    for (let i = start; i < end; i++) {\n      const p = order[i]!;\n      if (positions[p]! >= pivot) continue;\n      order[i] = order[mid]!;\n      order[mid++] = p;\n    }\n    // Split the indexes, never the borrowed columns. Use a median for skewed cells to contain tree depth.\n    if (Math.min(mid - start, end - mid) < (end - start) / 8) {\n      order.subarray(start, end).sort((a, b) => positions[a]! - positions[b]!);\n      mid = start + Math.floor((end - start) / 2);\n    }\n    return { ...bounds, left: build(start, mid), right: build(mid, end) };\n  }\n\n  let end = 0;\n  for (const [cell, head] of heads) {\n    const start = end;\n    for (let at = head; at >= 0; at = next[at]!) order[end++] = at;\n    buckets.set(cell, build(start, end));\n  }\n\n  return {\n    series, points,\n    get examined() { return examined; },\n    get cellsExamined() { return cellsExamined; },\n    pick(x: number, y: number) {\n      examined = 0;\n      cellsExamined = 0;\n      if (!contains(plot, x, y)) return null;\n      const radius = CELL + COINCIDENT;\n      const left = Math.max(0, column(x - radius));\n      const right = Math.min(columns - 1, column(x + radius));\n      const top = Math.max(0, row(y - radius));\n      const bottom = Math.min(rows - 1, row(y + radius));\n      const nearby: Bucket[] = [];\n      for (let cy = top; cy <= bottom; cy++) {\n        for (let cx = left; cx <= right; cx++) {\n          cellsExamined++;\n          const bucket = buckets.get(cx + cy * columns);\n          if (bucket) nearby.push(bucket);\n        }\n      }\n\n      let nearest = -1;\n      let best = RADIUS2;\n      function consider(at: number): void {\n        examined++;\n        const distance = (xs[at]! - x) ** 2 + (ys[at]! - y) ** 2;\n        if (distance < best || distance === best && (nearest < 0 || later(at, nearest))) {\n          nearest = at;\n          best = distance;\n        }\n      }\n      function search(bucket: Bucket, distance: number): void {\n        if (distance > best) return;\n        if (bucket.coincident !== undefined) {\n          consider(bucket.coincident);\n        } else if (bucket.left && bucket.right) {\n          const left = distanceTo(bucket.left, x, y);\n          const right = distanceTo(bucket.right, x, y);\n          if (left <= right) {\n            search(bucket.left, left);\n            search(bucket.right, right);\n          } else {\n            search(bucket.right, right);\n            search(bucket.left, left);\n          }\n        } else {\n          for (let i = bucket.start; i < bucket.end; i++) consider(order[i]!);\n        }\n      }\n\n      nearby.sort((a, b) => distanceTo(a, x, y) - distanceTo(b, x, y));\n      for (const bucket of nearby) search(bucket, distanceTo(bucket, x, y));\n      if (nearest < 0) return null;\n\n      const px = xs[nearest]!;\n      const py = ys[nearest]!;\n      const hits = [nearest];\n      let count = 0;\n      function add(at: number): void {\n        if (hits.length < POINT_LIMIT && at !== nearest) hits.push(at);\n      }\n      function collect(bucket: Bucket): void {\n        if (distanceTo(bucket, px, py) > COINCIDENT2) return;\n        if (distanceAcross(bucket, px, py) <= COINCIDENT2) {\n          count += bucket.end - bucket.start;\n          for (let i = bucket.start; i < bucket.end && hits.length < POINT_LIMIT; i++) add(order[i]!);\n        } else if (bucket.left && bucket.right) {\n          collect(bucket.left);\n          collect(bucket.right);\n        } else {\n          for (let i = bucket.start; i < bucket.end; i++) {\n            const at = order[i]!;\n            examined++;\n            if ((xs[at]! - px) ** 2 + (ys[at]! - py) ** 2 <= COINCIDENT2) {\n              count++;\n              add(at);\n            }\n          }\n        }\n      }\n      // The same cell set covers every possible 0.5 px neighbourhood of the nearest point.\n      for (const bucket of nearby) collect(bucket);\n      return { hits, count };\n    },\n  };\n}\nimport { SLOT_VALUE } from '../core/contracts';\nimport type { DatumRef, DatumText, Formatters, Lookup, ScatterView } from '../core/contracts';\nimport { contains, pointBox, type PlotLayout } from './geometry';\nimport { pointOrder, type PointIndex } from './point-order';\nimport { POINT_LIMIT, scatterGrid } from './scatter-grid';\nimport { lowerBound, upperBound, pageDistance } from './search';\n\ninterface ScatterWork {\n  locations: number;\n  seriesCandidates: number;\n  orderComparisons: number;\n}\n\nexport function scatterLookup(\n  view: ScatterView, layout: PlotLayout | null, formatters: Formatters, work?: ScatterWork,\n): Lookup & { readonly lastPickCandidates: number; readonly lastPickCells?: number } {\n  const { series } = view.frame;\n  const keys = new Map(series.map((entry, i) => [entry.key, i]));\n  const locations = new WeakMap<DatumRef, PointIndex>();\n  const ranges = view.visiblePoints.map((range, s) => view.visible[s] && series[s]!.drawable ? range : { start: 0, end: 0 });\n  const order = pointOrder(series, ranges, work && {\n    get comparisons() { return work.orderComparisons; },\n    set comparisons(value) { work.orderComparisons = value; },\n  });\n  const active = ranges.flatMap((range, s) => range.end > range.start ? [s] : []);\n  const projection = layout?.projection.kind === 'xy' ? layout.projection : null;\n  const grid = layout && projection ? scatterGrid(view, { ...layout, projection }, order.count) : null;\n\n  function ref(s: number, i: number): DatumRef {\n    const entry = series[s]!;\n    const datum = { kind: 'point', seriesKey: entry.key, row: entry.row?.[i] ?? i, x: entry.x[i]! } as const;\n    // A pick already knows the point's position. A ref rebuilt by the caller still resolves by source row.\n    locations.set(datum, { series: s, index: i });\n    return datum;\n  }\n\n  function locate(datum: DatumRef): PointIndex | null {\n    if (datum.kind !== 'point') return null;\n    const known = locations.get(datum);\n    if (known) return known;\n    const s = keys.get(datum.seriesKey);\n    if (s === undefined) return null;\n    const { x, row } = series[s]!;\n    for (let i = lowerBound(x, datum.x); x[i] === datum.x; i++) {\n      if (work) work.locations++;\n      if ((row?.[i] ?? i) !== datum.row) continue;\n      const point = { series: s, index: i };\n      locations.set(datum, point);\n      return point;\n    }\n    return null;\n  }\n\n  function resolve(datum: DatumRef): DatumRef | null {\n    if (datum.kind !== 'point') return null;\n    const s = keys.get(datum.seriesKey);\n    if (s === undefined) return null;\n    const { start, end } = ranges[s]!;\n    if (!view.visible[s]) {\n      let primary: PointIndex | null = null;\n      let y = Infinity;\n      for (const t of active) {\n        const { start, end } = ranges[t]!;\n        const entry = series[t]!;\n        const i = lowerBound(entry.x, datum.x, start, end);\n        if (i < end && entry.x[i] === datum.x && entry.y[i]! < y) {\n          primary = { series: t, index: i };\n          y = entry.y[i]!;\n        }\n      }\n      return primary ? ref(primary.series, primary.index) : null;\n    }\n    if (start === end) return null;\n    const point = locate(datum);\n    if (point && point.index >= start && point.index < end) return datum;\n    const x = series[s]!.x;\n    const right = upperBound(x, datum.x, start, end);\n    if (right < end) return ref(s, right);\n    const left = lowerBound(x, datum.x, start, end) - 1;\n    return left >= start ? ref(s, left) : null;\n  }\n\n  function write(datum: DatumRef): DatumText | null {\n    const at = locate(datum);\n    if (!at || datum.kind !== 'point') return null;\n    const { series: s, index: i } = at;\n    const entry = series[s]!;\n    return {\n      ref: datum, seriesIndex: s, seriesLabel: entry.label, x: formatters.x(entry.x[i]!),\n      value: formatters.value(s, entry.y[i]!), percent: null, state: SLOT_VALUE, row: datum.row,\n    };\n  }\n\n  function nearest(from: PointIndex, s: number): DatumRef {\n    const { start, end } = ranges[s]!;\n    const entry = series[s]!;\n    const fromX = series[from.series]!.x[from.index]!;\n    const fromY = series[from.series]!.y[from.index]!;\n    const x = projection?.x.map(fromX) ?? fromX;\n    const y = projection?.y.map(fromY) ?? fromY;\n    let nearest = start;\n    let best = Infinity;\n\n    function consider(i: number, dx: number): void {\n      if (work) work.seriesCandidates++;\n      const py = projection?.y.map(entry.y[i]!) ?? entry.y[i]!;\n      const distance = Math.hypot(dx, py - y);\n      if (distance < best || distance === best && i < nearest) {\n        nearest = i;\n        best = distance;\n      }\n    }\n\n    const dx = (i: number) => Math.abs((projection?.x.map(entry.x[i]!) ?? entry.x[i]!) - x);\n    const flatY = projection && (projection.y.range[0] === projection.y.range[1] || projection.y.domain[0] === projection.y.domain[1]);\n    // Starting at x, only runs whose horizontal distance can still win need a y search.\n    let right = lowerBound(entry.x, fromX, start, end);\n    let left = right - 1;\n    while (left >= start || right < end) {\n      const leftDistance = left >= start ? dx(left) : Infinity;\n      const rightDistance = right < end ? dx(right) : Infinity;\n      const distance = Math.min(leftDistance, rightDistance);\n      if (distance > best) break;\n      let lo: number;\n      let hi: number;\n      if (leftDistance <= rightDistance && left >= start) {\n        hi = left + 1;\n        lo = left > start && entry.x[left] === entry.x[left - 1]\n          ? lowerBound(entry.x, entry.x[left]!, start, hi) : left;\n        left = lo - 1;\n      } else {\n        lo = right;\n        hi = right + 1 < end && entry.x[right] === entry.x[right + 1]\n          ? upperBound(entry.x, entry.x[right]!, right, end) : right + 1;\n        right = hi;\n      }\n      if (lo + 1 === hi || flatY) {\n        consider(lo, distance);\n      } else {\n        const middle = lowerBound(entry.y, fromY, lo, hi);\n        if (middle < hi) consider(middle, distance);\n        if (middle > lo) consider(lowerBound(entry.y, entry.y[middle - 1]!, lo, middle), distance);\n      }\n    }\n    return ref(s, nearest);\n  }\n\n  function toRef(point: PointIndex | null): DatumRef | null {\n    return point ? ref(point.series, point.index) : null;\n  }\n\n  return {\n    pick(px, py) {\n      const picked = grid?.pick(px, py);\n      return grid && picked ? {\n        kind: 'point', refs: picked.hits.map(i => ref(grid.series[i]!, grid.points[i]!)), count: picked.count,\n      } : null;\n    },\n    tooltip(target) {\n      if (target.kind !== 'point') return { title: '', rows: [], count: 0, total: null };\n      const rows = target.refs.slice(0, POINT_LIMIT).flatMap(datum => {\n        const text = write(datum);\n        return text ? [text] : [];\n      });\n      return { title: rows[0]?.x ?? '', rows, count: target.count, total: null };\n    },\n    primary(target) { return target.kind === 'point' ? target.refs[0] ?? null : null; },\n    datum: write,\n    anchor(datum) {\n      const point = locate(datum);\n      if (!point || !layout || !projection) return null;\n      const { start, end } = ranges[point.series]!;\n      if (point.index < start || point.index >= end) return null;\n      const entry = series[point.series]!;\n      const x = projection.x.map(entry.x[point.index]!);\n      const y = projection.y.map(entry.y[point.index]!);\n      return contains(layout.plot, x, y) ? pointBox(x, y) : null;\n    },\n    count: order.count,\n    ordinal(datum) {\n      const point = locate(datum);\n      return point ? order.ordinal(point.series, point.index) : -1;\n    },\n    step(from, direction) {\n      if (!from) return toRef(order.edge(1));\n      const resolved = resolve(from);\n      const point = resolved && locate(resolved);\n      if (!point) return null;\n      switch (direction) {\n        case 'next': return toRef(order.edge(1, point));\n        case 'previous': return toRef(order.edge(-1, point));\n        case 'first':\n        case 'last': {\n          const edge = order.edge(direction === 'first' ? 1 : -1);\n          return edge?.series === point.series && edge.index === point.index ? null : toRef(edge);\n        }\n        case 'page-next':\n        case 'page-previous': {\n          const ordinal = order.ordinal(point.series, point.index);\n          const to = direction === 'page-next' ? Math.min(order.count - 1, ordinal + pageDistance(order.count))\n            : Math.max(0, ordinal - pageDistance(order.count));\n          return to === ordinal ? null : toRef(order.at(to));\n        }\n        case 'series-next':\n        case 'series-previous': {\n          const neighbor = active[active.indexOf(point.series) + (direction === 'series-next' ? 1 : -1)];\n          return neighbor === undefined ? null : nearest(point, neighbor);\n        }\n      }\n    },\n    resolve,\n    get lastPickCandidates() { return grid?.examined ?? 0; },\n    get lastPickCells() { return grid?.cellsExamined ?? 0; },\n  };\n}\nimport type { IndexRange, PointSeries } from '../core/contracts';\nimport { lowerBound } from './search';\n\nexport interface PointIndex {\n  readonly series: number;\n  readonly index: number;\n}\n\nexport interface PointOrderWork {\n  comparisons: number;\n  seeks?: number;\n  steps?: number;\n}\n\n/** A sorted view of several already sorted columns, without a merged array of points. */\nexport function pointOrder(series: readonly PointSeries[], ranges: readonly IndexRange[], work?: PointOrderWork) {\n  const active: number[] = [];\n  let count = 0;\n  ranges.forEach(({ start, end }, s) => {\n    if (start < end) active.push(s);\n    count += end - start;\n  });\n\n  function compare(s: number, i: number, t: number, j: number): number {\n    if (work) work.comparisons++;\n    return series[s]!.x[i]! - series[t]!.x[j]!\n      || series[s]!.y[i]! - series[t]!.y[j]! || s - t || i - j;\n  }\n\n  function bound(s: number, t: number, j: number, start: number, end: number, after = false): number {\n    while (start < end) {\n      const mid = start + Math.floor((end - start) / 2);\n      const difference = compare(s, mid, t, j);\n      if (difference < 0 || after && difference === 0) start = mid + 1;\n      else end = mid;\n    }\n    return start;\n  }\n\n  function edge(direction: 1 | -1, from?: PointIndex): PointIndex | null {\n    let found = -1;\n    let index = -1;\n    for (const s of active) {\n      const { start, end } = ranges[s]!;\n      const i = !from ? direction === 1 ? start : end - 1\n        : bound(s, from.series, from.index, start, end, direction === 1) + (direction === 1 ? 0 : -1);\n      if (i < start || i >= end) continue;\n      if (found < 0 || direction * compare(s, i, found, index) < 0) {\n        found = s;\n        index = i;\n      }\n    }\n    return found < 0 ? null : { series: found, index };\n  }\n\n  function seek(ordinal: number) {\n    let starts = Uint32Array.from(ranges, range => range.start);\n    if (ordinal === 0) return { starts, point: edge(1)! };\n    if (active.length === 1) {\n      const s = active[0]!;\n      starts[s] = starts[s]! + ordinal;\n      return { starts, point: { series: s, index: starts[s]! } };\n    }\n\n    let ends = Uint32Array.from(ranges, range => range.end);\n    const mids = new Uint32Array(ranges.length);\n    let remaining = active;\n    let size = count;\n    while (true) {\n      for (const s of remaining) mids[s] = starts[s]! + Math.floor((ends[s]! - starts[s]! - 1) / 2);\n      const byMiddle = remaining.slice().sort((a, b) => compare(a, mids[a]!, b, mids[b]!));\n      // A weighted median of list midpoints discards a fixed fraction of the remaining points each round.\n      let pivot = byMiddle[0]!;\n      let weight = 0;\n      for (const s of byMiddle) {\n        pivot = s;\n        weight += ends[s]! - starts[s]!;\n        if (weight * 2 >= size) break;\n      }\n      const index = mids[pivot]!;\n      const cuts = starts.slice();\n      let before = 0;\n      for (const s of remaining) {\n        cuts[s] = s === pivot ? index : bound(s, pivot, index, starts[s]!, ends[s]!);\n        before += cuts[s]! - starts[s]!;\n      }\n      if (ordinal === before) return { starts: cuts, point: { series: pivot, index } };\n      if (ordinal < before) {\n        ends = cuts;\n        size = before;\n      } else {\n        cuts[pivot] = index + 1;\n        starts = cuts;\n        ordinal -= before + 1;\n        size -= before + 1;\n      }\n      remaining = remaining.filter(s => starts[s]! < ends[s]!);\n    }\n  }\n\n  function valid(ordinal: number): boolean {\n    return Number.isInteger(ordinal) && ordinal >= 0 && ordinal < count;\n  }\n\n  function at(ordinal: number): PointIndex | null {\n    if (!valid(ordinal)) return null;\n    if (ordinal === count - 1) return edge(-1);\n    return seek(ordinal).point;\n  }\n\n  function ordinal(s: number, i: number): number {\n    const range = ranges[s];\n    if (!range || i < range.start || i >= range.end) return -1;\n    let before = 0;\n    for (const t of active) {\n      const { start, end } = ranges[t]!;\n      before += bound(t, s, i, start, end) - start;\n    }\n    return before;\n  }\n\n  function beforeX(x: number): number {\n    let before = 0;\n    for (const s of active) {\n      const { start, end } = ranges[s]!;\n      before += lowerBound(series[s]!.x, x, start, end) - start;\n    }\n    return before;\n  }\n\n  function cursor(ordinal: number): (() => PointIndex | null) | null {\n    if (!valid(ordinal)) return null;\n    if (work?.seeks !== undefined) work.seeks++;\n    const { starts } = seek(ordinal);\n    const heap = active.filter(s => starts[s]! < ranges[s]!.end);\n    const precedes = (s: number, t: number) => compare(s, starts[s]!, t, starts[t]!) < 0;\n\n    function sift(at: number): void {\n      const s = heap[at]!;\n      while (2 * at + 1 < heap.length) {\n        let child = 2 * at + 1;\n        if (child + 1 < heap.length && precedes(heap[child + 1]!, heap[child]!)) child++;\n        if (!precedes(heap[child]!, s)) break;\n        heap[at] = heap[child]!;\n        at = child;\n      }\n      heap[at] = s;\n    }\n\n    for (let i = Math.floor(heap.length / 2) - 1; i >= 0; i--) sift(i);\n    return () => {\n      const series = heap[0];\n      if (series === undefined) return null;\n      if (work?.steps !== undefined) work.steps++;\n      const index = starts[series]!;\n      starts[series] = index + 1;\n      if (starts[series] === ranges[series]!.end) {\n        const last = heap.pop()!;\n        if (!heap.length) return { series, index };\n        heap[0] = last;\n      }\n      sift(0);\n      return { series, index };\n    };\n  }\n\n  return { at, edge, cursor, ordinal, beforeX, count };\n}\nimport type { Layout, Rect } from '../core/contracts';\n\nexport type PlotLayout = Extract<Layout, { kind: 'plot' | 'compact' }>;\n\nexport function contains(rect: Rect, x: number, y: number): boolean {\n  return x >= rect.x && x <= rect.x + rect.width && y >= rect.y && y <= rect.y + rect.height;\n}\n\nexport function pointBox(x: number, y: number): Rect {\n  return { x, y, width: 0, height: 0 };\n}\n\nexport function clipBox(box: Rect, plot: Rect): Rect | null {\n  const x = Math.max(box.x, plot.x);\n  const y = Math.max(box.y, plot.y);\n  const right = Math.min(box.x + box.width, plot.x + plot.width);\n  const bottom = Math.min(box.y + box.height, plot.y + plot.height);\n  return x <= right && y <= bottom ? { x, y, width: right - x, height: bottom - y } : null;\n}\nimport type { Formatters, Layout, Lookup, View } from '../core/contracts';\nimport type { Messages } from '../public';\nimport { alignedLookup } from './aligned';\nimport { donutLookup } from './donut';\nimport { scatterLookup } from './scatter';\n\n/** The optional locale is retained for callers that supplied it before Formatters owned all readouts. */\nexport function buildLookup(view: View, layout: Layout, formatters: Formatters, messages: Messages, locale?: string): Lookup {\n  const plot = layout.kind === 'plot' || layout.kind === 'compact' ? layout : null;\n  switch (view.kind) {\n    case 'donut': return donutLookup(view, plot, formatters, locale);\n    case 'scatter': return scatterLookup(view, plot, formatters);\n    default: return alignedLookup(view, plot, formatters, messages);\n  }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"cat AGENTS.md && sed -n '113,133p;148,207p' docs/02-product-spec.md && sed -n '170,191p;322,335p' docs/03-plan-typescript-release.md && sed -n '550,675p' packages/axylo/src/core/contracts.ts\"","aggregated_output":"# Working in this repository\n\nAxylo is a browser charting library. The product is specified in `docs/02-product-spec.md`; the build plan is `docs/03-plan-typescript-release.md`. Read the sections your task names before writing code.\n\n## Rules for every change\n\n- **Contracts are fixed.** `packages/axylo/src/core/contracts.ts` and `packages/axylo/src/public.ts` are the interfaces between modules. Do not edit them. If your work needs a change there, stop that part, finish what you can, and describe the exact change you need in your report.\n- **Stay in your files.** Each task lists the directories it owns. Do not create, edit or delete anything else, including configuration and other modules. Several agents work in this checkout at the same time.\n- **No runtime dependencies.** Use the platform (`Intl`, typed arrays). Dev dependencies already installed: TypeScript, Vitest, fast-check, esbuild, Playwright (system Chrome), axe-core. The network is not available; do not try to install anything.\n- **No DOM at import time.** A module that needs the DOM takes it as a parameter or touches it inside a function. Pure stages (data, scales, formatting, layout, scene) must run in Node.\n- **Hot paths use typed arrays.** No object per data point, no array of arrays per data point, no copying of large columns that the contracts say are borrowed.\n- **Never guess silently.** Anything that cannot be drawn as given is reported through the `DiagnosticSink` with the code from spec section 3.5.\n- **Tests come from the spec.** Expected values are derived from the specification and the fixture data, never by running the implementation and pasting its output. Use fast-check property tests for invariants (\"for any data …\"). A test you cannot make pass is reported as failing; do not weaken it or change its expected value.\n- **TypeScript strict, no `any`** in exported signatures. `__DEV__` is a build-time boolean (true in tests).\n- **Comments say why**, not what. Names are plain words.\n- **Do not commit.** The coordinator commits.\n\n## Commands\n\n```bash\nnpm run typecheck      # tsc over the library, its tests, and the API examples in docs/api\nnpm test               # unit and property tests (Node)\nnpm run build          # packages/axylo/dist\nnpm run test:browser   # browser tests against the built bundle, in system Chrome\n```\n\n## Your report\n\nEnd with a short report: what you built (files), what you verified and how (paste the last lines of the test run), what is not done or not verified, any contract change you need, and any place where the spec was ambiguous and what you assumed. Keep \"ran and saw\" apart from \"expect\".\n| L3 | The chart follows its container with no call from the page, in both directions. With no definite height, the plot is 16:9, clamped between 160 and 480 CSS px tall, and the title, controls and table flow above and below it. A container that starts hidden or zero-sized draws when it gets a size. | Resize 720 → 360 → 720 px; hidden-then-shown test; `height: auto` container is stable over 10 frames | R16, D1 |\n| L4 | Light or dark is taken from the chart element's computed `color-scheme`; if that is not set, from the luminance of the inherited text color. `--axylo-background` overrides both. Marks repaint within one frame when the scheme, forced colors, contrast preference, or the `class`, `style` or `data-theme` of `<html>` or `<body>` changes. Forced-colors mode uses system colors. | A page that sets `color-scheme`; a class-toggled dark theme without it; a light-only page on a dark device (must stay light); a runtime toggle; forced-colors emulation | R10 |\n| L5 | A marker on every point appears only when adjacent points are at least 12 px apart (provisional value), and always for isolated points. | `trend` at 720 px has none; a 12-point line has them | R8 |\n| L6 | Title, subtitle and axis titles with units are part of the chart. A value axis is titled with its label (the field name when none is given) and unit. An x axis that is a measure (number) is titled the same way; a time, date or category x axis is titled only when the author gives a `label`, since its ticks already say what it is. A reference line or band shows its label next to it. Axis titles never overlap tick labels. | Layout tests; `trend` fixture | R9 |\n| L7 | Empty data shows a message inside the plot area; so do loading, error and Axylo's own internal failures. No invented axis ranges, no blank box. A change of state is announced once, politely. | `empty` fixture: message visible and in the accessibility tree, no tick labels; forced internal error shows the error state | R6 |\n| L8 | When the figure cannot hold a readable plot (less than 120×80 CSS px for the plot), it shows the title, the one-line summary and the table control instead, and raises AX142. | Narrow and short container tests | R2 |\n\n### 3.3 Interaction\n\n| ID | Criterion | Verified by | Driven by |\n|---|---|---|---|\n| I1 | Pointing anywhere in the plot shows what is there, by the picking rule for the chart type (section 3.6), within one frame at the 95th percentile. On line, area and bar the tooltip lists every visible series at the nearest x; a series with no row at that x reads \"No observation\", distinct from \"No data\". The tooltip stays inside the viewport, does not cover the active mark, can itself be hovered, and lists at most eight rows plus \"+N more\". When it cannot fit, the same content appears in a fixed readout under the plot. Escape closes it until the pointer reaches a different datum. | Hover at 20 positions including all four edges; sparse-series fixture; narrow tile with eight series; Escape test | R15 |\n| I2 | Legend entries are toggle buttons with a pressed state, operable by click, Enter and Space. | Keyboard and accessibility-tree tests | R12 |\n| I3 | Zoom on time, date and numeric x axes is reachable four ways: visible Zoom in, Zoom out and Reset buttons that work with single clicks; drag to select a range; `+`, `-`, `0` and Shift+arrows; and pinch when `zoom: 'touch'` is set. The wheel zooms only while the plot has focus, and never when Ctrl or Meta is held, so browser zoom and page scrolling are not intercepted. | Reach a given range by clicks only; by keyboard only; by drag; page scrolls normally with the pointer over an unfocused chart | D7, R12, WCAG 2.5.1, 2.5.7, 1.4.4 |\n| I4 | Every interaction works with a single pointer without dragging, and by touch. Every control is at least 24×24 CSS px. A one-finger drag on a chart scrolls the page. | Touch emulation; size checks | WCAG 2.5.7, 2.5.8 |\n| I5 | First render is not animated. An update may transition for at most 200 ms. Under `prefers-reduced-motion: reduce` nothing transitions, on first render or on update. | After `document.fonts.ready`: first frame equals the frame at 2.5 s within a 0.1% pixel tolerance, in both settings; an update under reduced motion reaches its final frame in one step; a 24-chart filter change settles within 200 ms | R14 |\n| I6 | A chart fed by `append` shows a Pause/Resume control. While paused, new rows are buffered and the view does not move. | Stream test | WCAG 2.2.2 |\n\n### 3.4 Accessibility\n\nTarget: every WCAG 2.2 level AA success criterion that applies to what Axylo renders, as component-level evidence. Conformance of a page is a property of the page and remains the author's.\n### 3.5 Diagnostic registry\n\nLevel decides delivery. **Error**: the chart or a series cannot be drawn; the chart shows its error state. **Warning**: something is not drawn as given; the reader sees the note in F12. **Hint**: advice for the author. Errors and warnings print once per code per page in every build; hints print in development builds only. `strict: true` throws on errors and warnings found while validating a create, `update` or `append` call, synchronously from that call. A diagnostic that can only arise later (a contrast check after the page's CSS changes, a custom formatter that throws when a table page is built, a label that stops fitting after a resize) is reported when it is found and is never thrown. Every diagnostic names the chart; those about data name the field and the first row indexes in the caller's own data.\n\n| Code | Level | Condition | What is drawn |\n|---|---|---|---|\n| AX100 | Error | Typed columns have different lengths | Error state; the message names the columns and their lengths |\n| AX101 | Error | A named field is not a key of any row | Error state; the message lists the keys that exist and the closest match |\n| AX102 | Warning | A field is absent (`undefined`) in some rows | Gaps |\n| AX103 | Warning | A value is `NaN` or infinite | Gap |\n| AX104 | Hint | Every non-missing value of a value field is a plain decimal string (`'40'`, `'-1.5'`) | Parsed and drawn; the message suggests `parse: 'number'`. An empty string counts as missing |\n| AX105 | Hint | Steps are absent on a regular time, date, wall-clock or number axis | Gaps. When a series would need more absent steps than twice its observations (and more than 1,000), it is treated as irregular instead: no gaps are created and the hint says so |\n| AX106 | Warning | A value field mixes numbers with strings, or holds strings that are not plain decimals (`'1,234'`, `'n/a'`) | The strings are not drawn |\n| AX107 | Warning | A date or time cannot be parsed | That row is not drawn |\n| AX108 | Error | Duplicate x within a series, or duplicate donut labels | That series, or the donut, is not drawn |\n| AX109 | Hint | Numbers on an axis declared `time` look like seconds, or a numeric x looks like epoch milliseconds without `type: 'time'` | As declared |\n| AX110 | Warning | An author domain on bar or area excluded zero | Domain widened to zero |\n| AX111 | Hint | Instants look like calendar dates | As instants, zone shown |\n| AX112 | Hint | Date-time strings have no offset | As written |\n| AX120 | Error | Negative donut value | Error state |\n| AX121 | Warning | More than eight donut slices | Seven largest plus \"Other (n)\" |\n| AX130 | Warning | More than eight series | All series, with dash or marker differences |\n| AX140 | Warning | No `title` and no `labelledBy` | Generated name |\n| AX141 | Warning | Palette below 3:1 on the resolved background | As themed |\n| AX142 | Hint | Plot too small to draw | Summary and table control |\n| AX143 | Hint | Labels hidden after every remedy | Note shown to the reader |\n| AX150 | Warning | Unknown option key | Ignored; the message suggests the closest known key |\n| AX151 | Warning | `append` rows out of order | Accepted through the slower full update |\n| AX131 | Hint | A compact chart has more than one series | Drawn, with dash differences |\n| AX132 | Hint | More bars than pixels along the category axis | Drawn; the message suggests aggregating |\n| AX133 | Hint | A scatter chart has more than 50,000 points | Drawn; the message says drawing may be slow |\n| AX134 | Error | Series × x positions exceeds 20,000,000 (long rows with many series and little shared x) | Error state; the message gives both counts and suggests fewer series or a scatter chart |\n| AX152 | Warning | `timeZone` is not a zone the browser knows | The viewer's zone is used |\n| AX160 | Warning | A custom formatter threw | The default format is used for that value |\n| AX199 | Error | Axylo itself failed while building the chart | Error state with a generic message; the error is passed to `onDiagnostic` and printed |\n\nExpected results for the Phase 1 fixtures: the combined `dirty` fixture (`[10, 20, null, NaN, '40', undefined, 70]`) yields AX102, AX103 and AX106 once each, draws Mon–Tue as a segment and Sun as a point, and shows the F12 note. `dirty-string` (one `'40'` among numbers) yields AX106. A column made only of numeric strings yields AX104 and is drawn in full. `dirty-null` yields nothing.\n\nThe split between AX104 and AX106 answers a reviewer's objection that common back ends return counts as strings (Postgres `bigint` and `numeric`, BigQuery): a whole column of plain decimal strings is unambiguous and is parsed; a stray string among numbers is a bug and is not.\n\n### 3.6 Type matrix\n\n| | Line | Area | Bar | Donut | Scatter |\n|---|---|---|---|---|---|\n| Picking by pointer | Nearest x | Nearest x | The band under the pointer | The slice under the pointer | Nearest point within 24 px; ties go to the later row |\n| Tooltip content | Every visible series at that x | Same, plus the stack total | Every series in that category | Label, value, percentage | The point's series, x and y; coincident points listed, up to eight |\n| Keyboard order | By x, then series | By x, then series | By category, then series | By slice order | By x, then y |\n| Zoom | Yes | Yes | On time, date and numeric x only | No | Yes, both axes later; x only in 1.0 |\n| Simplified drawing when dense | F5 | F5 on cumulative sums | No; more bars than pixels raises a hint | No | No in 1.0; above 50,000 points a hint says drawing may be slow |\n| Limit that raises a diagnostic | Eight series | Eight series | Eight series | Eight slices | Eight series |\n| Reference lines and bands | Yes; included in the domain; listed in the summary and table caption | Yes | Yes | No | Yes |\n\n### 3.7 Compact variant\n\n`compact: true` on line, area and bar draws the marks and nothing else: no axes, gridlines, legend, toolbar, table control, zoom or tooltip. It is for a small tile where the page already shows the number and the label.\n\n| ID | Criterion | Verified by |\n|---|---|---|\n| C1 | A compact chart is a static image with a full text alternative: `role=\"img\"`, an accessible name (as in A1, including AX140 when none is given) and the generated summary as its description (series, x range, minimum, maximum, last value, omissions). It has no tab stop and no pointer-only behavior, so nothing is available to a mouse that is not available to a keyboard. | Accessibility-tree snapshot; a page of 40 has zero added tab stops |\n| C2 | The fidelity rules still hold: zero baseline for bar and area (F1), gaps (F2), diagnostics (F3), simplified drawing (F5), sorting (F11), no motion (I5), scheme from the page (L4). | The same fixtures as the full charts |\n\n```\noptions ─► normalize ─► frame ──┬─► view model ─► layout ─► scene ─► mark renderer\n            │ validate   (authoritative) │   scales, visible range         text renderer (DOM)\n            ▼ diagnostics                ├─► lookup: exact values by x, by point, by ordinal\n                                         ├─► summary and table\n                                         └─► focus model\n```\n\nThe **frame** is the normalized, lossless data: typed columns, a validity bitmap, dictionary-encoded categories, source-row indexes and a revision number. It is the only source for exact values. The table, the summary, keyboard navigation, tooltips and events read the frame. The **scene** is geometry for drawing and may be simplified (F5); nothing reads values back from it. The first draft derived accessibility from the scene, and two reviewers showed that a simplified drawing cannot return the samples it dropped.\n\n| Stage | Output | Notes |\n|---|---|---|\n| normalize | Frame, diagnostics | The only place raw input is read. Never coerces silently. |\n| view model | Scales, visible index ranges, series visibility | Domain rules implement F1 and F7. |\n| lookup | Nearest-x by binary search; nearest-point by a grid index (scatter) | Works on the frame within the visible range; cost bounded independently of the drawing. |\n| layout | Plot rectangle, tick sets, label boxes, legend and control placement | Implements L1, L3, L8. Takes a text-measurement interface as input. |\n| scene | Flat list of primitives (`path`, `rect`, `arc`, `rule`, `text`) | Plain data; testable in Node with injected text metrics. |\n| renderers | Marks; DOM text; accessibility DOM | See 2.3. |\n\n### 2.2 Invalidation\n\n### M5. Bar, area, donut, scatter and the compact variant (ceiling: 18 days)\n\nEach type is done when its column of the type matrix (spec 3.6) and every applicable row of the acceptance matrix pass, including the accessibility and performance rows. Types are finished one at a time, in this order: bar, area, donut, the compact variant, scatter.\n\nOutcomes:\n- `bars` fixture: starts at zero, long label handled by L1's remedies, missing bar distinct from zero.\n- Stacked area and bar: mixed signs, incomplete stacks, simplified drawing on cumulative sums.\n- `parts` fixture: legend carries values and percentages; ninth slice, zero slice, negative slice and all-zero cases.\n- Palette scored on rendered marks, repeats included, in both schemes; grayscale identification test.\n- Compact variant: criteria C1–C5; a page of 40 adds no tab stops and meets P8.\n- Scatter: picking, ties, coincident points and a clustered-data benchmark.\n\nExamples: one per type and variant. Docs: one page per type; Color.\n\n// ───────────────────────────── rendering ─────────────────────────────\n\n/** Transient decoration drawn above the scene: cursor rule and highlighted points (clipped to the plot), focus ring (not clipped). */\nexport interface Overlay {\n  readonly clip: Rect;\n  readonly clipped: readonly Mark[];\n  readonly unclipped: readonly Mark[];\n}\n\n/**\n * Draws a scene's marks. Two implementations exist for the M1 comparison (canvas, svg); the rest of the\n * library does not know which one is in use.\n *\n * A canvas renderer paints with `theme.paints` (concrete colors) and must be told to draw again when the\n * theme changes. An SVG renderer paints with `bindings` (CSS expressions), so the browser restyles it on a\n * theme change without a call; it switches dash patterns with CSS media queries.\n */\nexport interface MarkRenderer {\n  readonly kind: 'canvas' | 'svg';\n  /** The element to insert into the plot container. It must be aria-hidden. */\n  readonly element: HTMLElement | SVGSVGElement;\n  /** Draws the scene, replacing the previous one. Called at most once per animation frame. */\n  draw(scene: Scene, bindings: PaintBindings, theme: ResolvedTheme, devicePixelRatio: number): void;\n  /** Draws or clears (null) the overlay without redrawing the scene. */\n  drawOverlay(overlay: Overlay | null, bindings: PaintBindings, theme: ResolvedTheme, devicePixelRatio: number): void;\n  destroy(): void;\n}\n\n// ───────────────────────────── lookup ─────────────────────────────\n\n/**\n * A datum by identity, not by position, so it still means the same thing after a streaming window slides.\n * Valid within one frame epoch.\n */\nexport type DatumRef =\n  | { readonly kind: 'aligned'; readonly seriesKey: string; /** x position (category: its index at the time; categories do not slide). */ readonly x: number }\n  | { readonly kind: 'point'; readonly seriesKey: string; /** source row index */ readonly row: number; /** x position, so a ref to an evicted point can resolve to its nearest surviving neighbour */ readonly x: number }\n  | { readonly kind: 'slice'; readonly sliceKey: string };\n\n/** What the pointer is over, by the picking rule of the chart type (spec 3.6). */\nexport type PickTarget =\n  | { readonly kind: 'x'; readonly x: number }                      // line, area, bar: every series at this x\n  | { readonly kind: 'point'; readonly refs: readonly DatumRef[]; readonly count: number }  // scatter: nearest point and those coinciding with it (at most 8; `count` is the full number)\n  | { readonly kind: 'slice'; readonly sliceKey: string };\n\n/** One row of a tooltip or one announced point, as text. All text comes from the frame through the formatters. */\nexport interface DatumText {\n  readonly ref: DatumRef;\n  readonly seriesIndex: number;\n  readonly seriesLabel: string;\n  /** x as the reader sees it. */\n  readonly x: string;\n  /** The value with its unit, or \"No data\" / \"No observation\". */\n  readonly value: string;\n  readonly state: SlotState;\n  /** Share of the whole for a donut slice, formatted; null elsewhere. */\n  readonly percent: string | null;\n  /** Source row index, or -1. */\n  readonly row: number;\n}\n\nexport interface TooltipModel {\n  /** Heading: the x value (with its time zone for instants), the category, or the slice label. */\n  readonly title: string;\n  /** At most eight rows (spec I1). */\n  readonly rows: readonly DatumText[];\n  /** Rows before truncation. */\n  readonly count: number;\n  /** Stack total with \"incomplete\" where it applies, already formatted; null when the chart does not stack. */\n  readonly total: string | null;\n}\n\nexport type StepDirection = 'next' | 'previous' | 'first' | 'last' | 'series-next' | 'series-previous' | 'page-next' | 'page-previous';\n\n/**\n * Exact answers from the frame for one view and projection, independent of how the scene was simplified.\n * Built once per (view, layout); cheap to build: binary search over x for aligned frames, a grid index for scatter.\n */\nexport interface Lookup {\n  /** What is under a pixel of the plot container, or null. */\n  pick(px: number, py: number): PickTarget | null;\n  tooltip(target: PickTarget): TooltipModel;\n  /** The datum to focus when the keyboard takes over from a pointer target. */\n  primary(target: PickTarget): DatumRef | null;\n  datum(ref: DatumRef): DatumText | null;\n  /** Where the datum is drawn, for the cursor and focus ring; null if it is not visible. */\n  anchor(ref: DatumRef): Rect | null;\n  /**\n   * Position for \"point 4 of 120\" (spec A3). Aligned charts: `count` is the number of visible x slots and\n   * `ordinal` the zero-based place of the datum's x among them, whatever its series and whether or not it\n   * holds a value (a \"No data\" slot has a place too). Scatter: place among all visible points in x then y\n   * order. Donut: slice order. -1 only when the datum is not in the current view.\n   */\n  readonly count: number;\n  ordinal(ref: DatumRef): number;\n  /** Keyboard order per chart type (spec 3.6). `from` null starts at the first datum. Skips hidden series. */\n  step(from: DatumRef | null, direction: StepDirection): DatumRef | null;\n  /**\n   * Where focus should be after the data or the view changed. A datum is \"there\" only if its series is\n   * visible and drawable and its x (or point) is inside the current view. If it is: itself. If its series is\n   * hidden but its x is in view: the primary datum at that x. Otherwise the nearest datum of its series in\n   * view after it, else before it; for a donut slice folded into \"Other\", the \"Other\" slice. Else null.\n   * `step` always starts from the resolved datum, so focus can never get stuck on something out of reach.\n   */\n  resolve(ref: DatumRef): DatumRef | null;\n}\n\n// ───────────────────────────── reader model ─────────────────────────────\n\n/** The table of spec A4, built lazily from the frame: nothing is materialized until a page is asked for. */\nexport interface TableModel {\n  readonly caption: string;\n  /** First entry is the x column. */\n  readonly headers: readonly string[];\n  readonly rowCount: number;\n  readonly pageSize: number;\n  /** Cells of one row as text; first cell is the row header. null outside the range. */\n  row(ordinal: number): readonly string[] | null;\n  /** Zero-based page that contains the first row at or after an x value; null if there is none. */\n  pageForX(x: XValue): number | null;\n}\n\n/** Everything a reader gets as text (spec A1, C1). */\nexport interface ReaderModel {\n  /** Accessible name: the title, or a generated one. Empty when the chart is named by `labelledBy`. */\n  readonly name: string;\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/test/lookup/scatter.test.ts packages/axylo/test/lookup/fixtures.ts && rg -n -C 16 'I1 scatter|140|failure 5' packages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts reviews/2026-11-18/impl/wp/acceptance-browser.report.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/test/lookup/scatter.test.ts packages/axylo/test/lookup/fixtures.ts && rg -n -C 16 'I1 scatter|140|failure 5' packages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts reviews/2026-11-18/impl/wp/acceptance-browser.report.md\"","aggregated_output":"import fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport type { DatumRef, PointFrame } from '../../src/core/contracts';\nimport { buildLookup } from '../../src/lookup';\nimport { scatterLookup } from '../../src/lookup/scatter';\nimport { defaultMessages } from '../../src/messages';\nimport { linearScale } from '../../src/scale';\nimport { formatter, frame, plot, scatter } from './fixtures';\n\nconst point = (seriesKey: string, row: number, x: number): DatumRef => ({ kind: 'point', seriesKey, row, x });\n\nfunction points(lists: readonly (readonly (readonly [number, number])[])[]): PointFrame {\n  let row = 0;\n  return {\n    shape: 'points', epoch: 1, revision: 1, source: { rowAt: () => null },\n    xKind: 'number', timeZone: null, xLabel: 'x', yLabel: 'y', xUnit: null, yUnit: null,\n    series: lists.map((list, s) => {\n      const sorted = list.map(([x, y]) => ({ x, y, row: row++ })).sort((a, b) => a.x - b.x || a.y - b.y || a.row - b.row);\n      return {\n        key: `S${s}`, label: `S${s}`, drawable: true, x: Float64Array.from(sorted, p => p.x),\n        y: Float64Array.from(sorted, p => p.y), row: Int32Array.from(sorted, p => p.row),\n      };\n    }),\n  };\n}\nconst layout = plot({ kind: 'xy', x: linearScale([0, 100], [0, 100]), y: linearScale([0, 100], [0, 100]) });\n\nit('picks the nearest point within 24 px and breaks a tie by later source row', () => {\n  const data = frame('scatter', { data: [{ x: 60, y: 50 }, { x: 40, y: 50 }], x: 'x', y: 'y' });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const tie = model.pick(50, 50)!;\n  expect(tie).toEqual({ kind: 'point', refs: [point('y', 1, 40)], count: 1 });\n  expect(model.primary(tie)).toEqual(point('y', 1, 40));\n  expect(model.tooltip(tie)).toMatchObject({ title: '40', count: 1, total: null, rows: [{ seriesLabel: 'y', x: '40', value: '50', row: 1 }] });\n  expect(model.anchor(point('y', 1, 40))).toEqual({ x: 40, y: 50, width: 0, height: 0 });\n  expect(model.pick(16, 50)).toEqual({ kind: 'point', refs: [point('y', 1, 40)], count: 1 });\n  expect(model.pick(15.99, 50)).toBeNull();\n  expect(model.pick(58, 50)).toEqual({ kind: 'point', refs: [point('y', 0, 60)], count: 1 });\n});\n\nit('finds coincident points across a cell boundary and retains the full count after truncation', () => {\n  const points = Array.from({ length: 10 }, (_, i) => ({ x: i % 2 ? 24.1 : 23.9, y: 50, series: `S${i}` }));\n  const input = { x: 'x', y: 'y', series: 'series' };\n  const small = frame('scatter', { ...input, data: points.slice(0, 3) });\n  const all = buildLookup(scatter(small), layout, formatter(small), defaultMessages).pick(23.9, 50)!;\n  expect(all.kind).toBe('point');\n  if (all.kind !== 'point') throw new Error('Expected scatter target');\n  expect(all.count).toBe(3);\n  expect(all.refs[0]).toEqual(point('S2', 2, 23.9));\n  expect(all.refs).toEqual(expect.arrayContaining([point('S0', 0, 23.9), point('S1', 1, 24.1), point('S2', 2, 23.9)]));\n\n  const data = frame('scatter', { ...input, data: [...points, { x: 24.7, y: 50, series: 'Different' }] });\n  const model = buildLookup(scatter(data), layout, formatter(data), defaultMessages);\n  const target = model.pick(24.1, 50)!;\n  expect(target).toMatchObject({ kind: 'point', count: 10 });\n  expect(model.primary(target)).toEqual(point('S9', 9, 24.1));\n  expect(model.tooltip(target).rows).toHaveLength(8);\n  expect(model.tooltip(target).count).toBe(10);\n  expect(model.tooltip(target).rows.some(row => row.seriesLabel === 'Different')).toBe(false);\n});\n\nit('uses screen distance when moving to the neighbouring visible series', () => {\n  const data = frame('scatter', { x: 'x', y: 'y', series: 'series', data: [\n    { x: 10, y: 30, series: 'A' }, { x: 11, y: 31, series: 'Hidden' },\n    { x: 10, y: 80, series: 'B' }, { x: 12, y: 31, series: 'B' },\n  ] });\n  const model = buildLookup(scatter(data, { visible: [true, false, true] }), layout, formatter(data), defaultMessages);\n  expect(model.count).toBe(3);\n  expect(model.step(point('A', 0, 10), 'next')).toEqual(point('B', 2, 10));\n  expect(model.step(point('A', 0, 10), 'series-next')).toEqual(point('B', 3, 12));\n  expect(model.step(point('B', 3, 12), 'series-previous')).toEqual(point('A', 0, 10));\n});\n\nit('examines only nearby cells on a 200,000-point pick', () => {\n  const size = 200_000;\n  const x = Float64Array.from({ length: size }, (_, i) => i);\n  const y = Float64Array.from(x, i => i % 521);\n  const data = frame('scatter', { data: { columns: { x, y } }, x: 'x', y: 'y' });\n  const projection = { kind: 'xy', x: linearScale([0, size - 1], [0, 1200]), y: linearScale([0, 520], [520, 0]) } as const;\n  const model = scatterLookup(scatter(data), plot(projection, 1200, 520), formatter(data));\n  const i = 98_765;\n  expect(model.primary(model.pick(projection.x.map(i), 520 - (i % 521))!)).toEqual(point('y', i, i));\n  expect(model.lastPickCandidates).toBeGreaterThan(0);\n  expect(model.lastPickCandidates).toBeLessThan(5_000);\n});\n\nit('resolves hidden and zoomed-out scatter refs and steps from the replacement', () => {\n  const data = points([[[0, 5], [2, 3], [4, 8], [6, 1]], [[2, 99]], [[2, 4], [4, 1]]]);\n  const view = scatter(data, {\n    visible: [true, false, true], xDomain: [2, 4],\n    visiblePoints: [{ start: 1, end: 3 }, { start: 0, end: 1 }, { start: 0, end: 2 }],\n  });\n  const model = buildLookup(view, layout, formatter(data), defaultMessages);\n  expect(model.resolve(point('S1', 4, 2))).toEqual(point('S0', 1, 2));\n  expect(model.step(point('S1', 4, 2), 'next')).toEqual(point('S2', 5, 2));\n  expect(model.resolve(point('S0', 0, 0))).toEqual(point('S0', 1, 2));\n  expect(model.resolve(point('S0', 3, 6))).toEqual(point('S0', 2, 4));\n  expect(model.resolve(point('S0', 99, 2))).toEqual(point('S0', 2, 4));\n  expect(model.step(point('S0', 0, 0), 'next')).toEqual(point('S2', 5, 2));\n  expect(model.step(point('S0', 3, 6), 'previous')).toEqual(point('S2', 6, 4));\n  expect(model.step(point('S0', 2, 4), 'page-next')).toBeNull();\n  expect(model.step(point('S0', 1, 2), 'page-previous')).toBeNull();\n});\n\nit('bounds a pick in a cell of 200,000 coincident points and reports the full count', () => {\n  const size = 200_000;\n  const base = points([[]]);\n  const data = { ...base, series: [{\n    ...base.series[0]!, x: new Float64Array(size).fill(23.9), y: new Float64Array(size).fill(50), row: null,\n  }] };\n  const model = scatterLookup(scatter(data), layout, formatter(data));\n  const target = model.pick(24.1, 50);\n  expect(target).toMatchObject({ kind: 'point', count: size });\n  expect(model.primary(target!)).toEqual(point('S0', size - 1, 23.9));\n  expect(model.tooltip(target!).rows).toHaveLength(8);\n  expect(model.lastPickCandidates).toBeLessThan(3_000);\n});\n\nit('visits the binary-search window when switching series and locates recreated refs by x', () => {\n  const n = 80_000;\n  const data = points([Array.from({ length: n }, (_, x) => [n - x, 20] as const),\n    Array.from({ length: n }, (_, x) => [x, 20] as const)]);\n  const work = { locations: 0, seriesCandidates: 0, orderComparisons: 0 };\n  const scale = linearScale([0, n], [0, 100]);\n  let maps = 0;\n  const projection = { kind: 'xy' as const, x: { ...scale, map(x: number) { maps++; return scale.map(x); } }, y: scale };\n  const model = scatterLookup(scatter(data), plot(projection), formatter(data), work);\n  maps = 0;\n  expect(model.step(point('S0', 40_000, 40_000), 'series-next')).toEqual(point('S1', 120_000, 40_000));\n  expect(maps).toBeLessThan(20);\n  expect(work.locations).toBeGreaterThan(0);\n  expect(work.locations).toBeLessThan(20);\n  expect(work.seriesCandidates).toBeGreaterThan(0);\n  expect(work.seriesCandidates).toBeLessThan(20);\n});\n\nit('walks partial ranges with hidden series and duplicate x and y in fixture order', () => {\n  const pair = fc.tuple(fc.nat(5), fc.nat(4));\n  fc.assert(fc.property(fc.array(fc.array(pair, { minLength: 2, maxLength: 17 }),\n    { minLength: 3, maxLength: 6 }), fc.boolean(), (lists, trim) => {\n    const data = points(lists);\n    const visible = lists.map((_, s) => s !== 1);\n    const visiblePoints = data.series.map(({ x }) => ({ start: trim ? 1 : 0, end: x.length }));\n    const model = buildLookup(scatter(data, { visible, visiblePoints }), layout, formatter(data), defaultMessages);\n    const expected = data.series.flatMap((series, s) => visible[s] ? Array.from(series.x).flatMap((x, i) => i >= visiblePoints[s]!.start\n      ? [{ x, y: series.y[i]!, row: series.row![i]!, s, i }] : []) : [])\n      .sort((a, b) => a.x - b.x || a.y - b.y || a.s - b.s || a.i - b.i);\n    expect(model.count).toBe(expected.length);\n    let next = model.step(null, 'next');\n    for (const [i, row] of expected.entries()) {\n      expect(next).toEqual(point(`S${row.s}`, row.row, row.x));\n      expect(model.ordinal(next!)).toBe(i);\n      expect(model.datum(next!)?.value).toBe(String(row.y));\n      expect(model.step(next, 'previous')).toEqual(i === 0 ? null\n        : point(`S${expected[i - 1]!.s}`, expected[i - 1]!.row, expected[i - 1]!.x));\n      const distance = Math.max(1, Math.floor(expected.length / 10));\n      const page = expected[Math.min(expected.length - 1, i + distance)]!;\n      expect(model.step(next, 'page-next')).toEqual(i === expected.length - 1 ? null : point(`S${page.s}`, page.row, page.x));\n      next = model.step(next, 'next');\n    }\n    expect(next).toBeNull();\n  }), { numRuns: 60 });\n});\n\nit('uses one set of grid cells for a dense noncoincident pick and its neighbours', () => {\n  const width = 500;\n  const size = width * 400;\n  const base = points([[]]);\n  const data = { ...base, series: [{\n    ...base.series[0]!,\n    x: Float64Array.from({ length: size }, (_, i) => 20 + Math.floor(i / 400) / 100),\n    y: Float64Array.from({ length: size }, (_, i) => 48 + (i % 400) / 100),\n    row: null,\n  }] };\n  const scale = linearScale([0, 128], [0, 128]);\n  const model = scatterLookup(scatter(data), plot({ kind: 'xy', x: scale, y: scale }), formatter(data));\n  const x = 24, y = 50;\n  const { x: xs, y: ys } = data.series[0]!;\n  let expected = 0;\n  for (let i = 0; i < size; i++) {\n    if ((xs[i]! - x) ** 2 + (ys[i]! - y) ** 2 <= 0.5 ** 2) expected++;\n  }\n  const target = model.pick(x, y);\n  expect(target).toMatchObject({ kind: 'point', count: expected });\n  expect(model.primary(target!)).toEqual(point('S0', 400 * 400 + 200, x));\n  expect(model.lastPickCells).toBeLessThanOrEqual(16);\n  expect(model.lastPickCandidates).toBeLessThan(3_000);\n});\n\nit('finds next and previous by one binary successor search per series', () => {\n  const seriesCount = 500;\n  const rows = 400;\n  const base = points([[]]);\n  const data = { ...base, series: Array.from({ length: seriesCount }, (_, s) => ({\n    key: `S${s}`, label: `S${s}`, drawable: true,\n    x: Float64Array.from({ length: rows }, (_, i) => i), y: new Float64Array(rows).fill(s), row: null,\n  })) };\n  const work = { locations: 0, seriesCandidates: 0, orderComparisons: 0 };\n  const model = scatterLookup(scatter(data), null, formatter(data), work);\n  const from = point('S250', 398, 398);\n  expect(model.step(from, 'next')).toEqual(point('S251', 398, 398));\n  expect(work.orderComparisons).toBeGreaterThan(0);\n  expect(work.orderComparisons).toBeLessThanOrEqual(seriesCount * 10);\n  work.orderComparisons = 0;\n  expect(model.step(from, 'previous')).toEqual(point('S249', 398, 398));\n  expect(work.orderComparisons).toBeGreaterThan(0);\n  expect(work.orderComparisons).toBeLessThanOrEqual(seriesCount * 10);\n});\nimport { SLOT_VALUE, type AlignedFrame, type AlignedView, type DonutFrame, type DonutView, type Formatters, type Frame, type Layout, type Projection, type ScatterView } from '../../src/core/contracts';\nimport { normalize, resolveOptions, type AlignedChartType, type ChartType } from '../../src/data';\nimport { DiagnosticCollector } from '../../src/diagnostics';\nimport { createFormatters } from '../../src/format';\nimport { defaultMessages } from '../../src/messages';\n\nconst env = { locale: 'en-US', timeZone: 'UTC' };\n\nexport function frame(type: AlignedChartType, options: unknown, revision?: number): AlignedFrame;\nexport function frame(type: 'scatter', options: unknown, revision?: number): ScatterView['frame'];\nexport function frame(type: 'donut', options: unknown, revision?: number): DonutFrame;\nexport function frame(type: ChartType, options: unknown, revision = 1): Frame {\n  const sink = new DiagnosticCollector();\n  return normalize(type, resolveOptions(type, options, sink), env, sink, { epoch: 1, revision });\n}\n\nexport function aligned(data: AlignedFrame, patch: Partial<Omit<AlignedView, 'frame'>> = {}): AlignedView {\n  const visibleSlots = patch.visibleSlots ?? { start: 0, end: data.length };\n  const xDomain = [data.x.values[visibleSlots.start] ?? 0, data.x.values[visibleSlots.end - 1] ?? 1] as const;\n  return {\n    kind: 'line', frame: data, visible: data.series.map(s => s.drawable), cues: [], compact: false,\n    xFull: xDomain, xDomain, yDomain: [0, 100], references: [], horizontal: false, stack: null,\n    revision: data.revision, visibleSlots, drawSlots: data.series.map(() => visibleSlots), ...patch,\n  };\n}\n\nexport function scatter(data: ScatterView['frame'], patch: Partial<Omit<ScatterView, 'frame'>> = {}): ScatterView {\n  return {\n    kind: 'scatter', frame: data, revision: data.revision, visible: data.series.map(s => s.drawable),\n    cues: [], compact: false, xFull: [0, 100], xDomain: [0, 100], yDomain: [0, 100], references: [],\n    visiblePoints: data.series.map(({ x }) => ({ start: 0, end: x.length })), ...patch,\n  };\n}\n\nexport function donut(data: DonutFrame): DonutView {\n  const total = data.values.reduce((sum, value, i) => sum + (data.slot[i] === SLOT_VALUE ? value : 0), 0);\n  let last = 0;\n  return {\n    kind: 'donut', frame: data, revision: data.revision, total,\n    slices: data.labels.map((label, i) => {\n      const value = data.slot[i] === SLOT_VALUE ? data.values[i]! : null;\n      const ratio = value === null ? null : value / total;\n      const angles = value ? [last, last += ratio! * 2 * Math.PI] as const : null;\n      return { key: label, label, colorIndex: i, members: [i], value, ratio, angles };\n    }),\n  };\n}\n\nexport function plot(projection: Projection, width = 100, height = 100): Extract<Layout, { kind: 'plot' }> {\n  const fit = { remedies: [], hidden: 0 } as const;\n  return {\n    kind: 'plot', width, height, plot: { x: 0, y: 0, width, height }, projection,\n    xTicks: [], yTicks: [], texts: [], fit: { x: fit, y: fit },\n  };\n}\n\nexport function formatter(data: Frame): Formatters {\n  const x = data.shape === 'aligned' ? data.x\n    : { kind: data.shape === 'points' ? data.xKind : 'category', categories: data.shape === 'donut' ? data.labels : null,\n      dateUnit: null, timeZone: data.shape === 'points' ? data.timeZone : null } as const;\n  const series = data.shape === 'aligned' ? data.series.map(s => ({ field: s.field, unit: s.unit, scale: s.valueScale }))\n    : data.shape === 'points' ? data.series.map(() => ({ field: 'y', unit: data.yUnit, scale: null }))\n      : [{ field: 'value', unit: data.unit, scale: data.valueScale }];\n  return createFormatters({\n    series, x: { field: 'x', unit: data.shape === 'points' ? data.xUnit : null, ...x }, messages: defaultMessages,\n  }, env);\n}\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-57-   - Expected (reading): the generated summary sentences are built-in English and should be marked.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-58-   - Page: `.axylo-summary` has no English `lang` ancestor. The note, toolbar, plot and pager are marked correctly.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-59-   - Likely cause: `src/dom/figure.ts` `update()` sets `lang` only on the note and the message, and `FigureModel` has no summary language field.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-60-2. **A5 bar: grouped bars touch.**\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-61-   - Spec: \"Adjacent filled marks … are separated by at least 1 px of background.\"\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-62-   - Page: the two bars of a group touch; background coverage between them is 0.22 px.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-63-   - Likely cause: `src/scene/bars.ts` lines 71–75, where `width = part`, so there is no gap inside a group.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-64-   - Reading: grouped bars count as adjacent filled marks, although the spec only names slices and stacked segments.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-65-3. **C4 compact bar: two compact bar series differ by colour only.**\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-66-   - Page: both series draw with dash `none`, no fill pattern and no other cue.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-67-   - Reading: C4 names lines; I applied \"never by colour alone\" (A5) to bars.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-68-   - Likely cause: `src/scene/bars.ts` and the compact cue logic in `src/view` give compact bars no cue.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-69-4. **L1, line, area, scatter and donut, 200 % text only.**\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-70-   - Spec: zero text outside the figure.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-71-   - Page: at 240 and 320 px wide (360 px tall), the chart falls back to the too-small state (L8). It shows the whole multi-sentence summary, which overflows the figure, and \"View as table\" ends up outside it. On the donut, the legend list overflows too. With plain text and with the WCAG text-spacing overrides, all widths pass.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-72-   - Likely cause: `src/dom/figure.ts` (`summaryVisible`) shows the full summary, while L8 asks for a one-line summary.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md:73:5. **I1 scatter: one point cannot be picked.**\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md:74:   - Setup: a full-viewport chart (body margin 0, chart 100vw × 100vh). The point EU (20 kB, 140 ms) sits on the plot's top edge and shares x with US (20, 100).\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-75-   - Page: pointing exactly at it, or 10–12 px away, shows neither a tooltip nor the readout. The same point is pickable in the default 720 × 400 layout.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-76-   - Likely cause: `src/lookup/scatter-grid.ts` (`pick`, its row/column edge handling). Not confirmed.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-77-6. **I1 bar: the tooltip leaves the viewport.**\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-78-   - Spec: the tooltip \"stays inside the viewport\".\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-79-   - Page: pointing at the top edge of the plot in a full-viewport chart puts the tooltip partly outside the viewport, at all 7 columns.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-80-   - Likely cause: `src/dom/tooltip.ts` placement, which was being edited during the run.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-81-\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-82-### Not covered, and why\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-83-- **Cannot be verified here:** A3 with a real screen reader, A6 in Firefox and Safari, phone behaviour for I4, GPU rasterisation. A6 and I4 were run in Chrome only, with emulated touch.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-84-- **L1 with a late-loading font:** no font file is available offline.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-85-- **I5 \"24-chart filter change settles within 200 ms\":** a timing budget, so it is left out.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-86-- **A9:** a document, not a browser test.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-87-- **Node side:** F1, F3–F7, F9–F11, DX and P are left to the Node suite. F5 has only its rendered half here (T-dense-line and T-dense-area).\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-88-- **Canvas renderer:** not run; the known canvas separator gap is therefore not exercised.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-89-- **Note text and placement:** these tests rely on a `waitForFunction` wait. It gives the note time to appear and then asserts on it.\nreviews/2026-11-18/impl/wp/acceptance-browser.report.md-90-\n","exit_code":0,"status":"completed"}}
