color that is resolved late, so an SVG renderer can use CSS variables and a canvas renderer can look\n * the value up in the resolved theme.\n */\nexport type Paint =\n  | { readonly kind: 'series'; readonly index: number }   // palette slot or the author's color for that series\n  | { readonly kind: 'token'; readonly name: 'axis' | 'grid' | 'reference' | 'muted' | 'focus' | 'background' | 'text' }\n  | { readonly kind: 'none' };\n\nexport type MarkerShape = 'circle' | 'square' | 'triangle' | 'diamond' | 'cross' | 'plus' | 'triangle-down' | 'star';\n\n/** Dash pattern in normal mode and under `prefers-contrast: more` or forced colors. null = solid. */\nexport interface DashStyle {\n  readonly normal: readonly number[] | null;\n  readonly contrast: readonly number[] | null;\n}\n\n/** A polyline. `xy` is x0,y0,x1,y1,… in CSS px; a NaN pair lifts the pen. */\nexport interface PathMark {\n  readonly type: 'path';\n  readonly series: number;\n  readonly xy: Float32Array;\n  readonly stroke: Paint;\n  readonly strokeWidth: number;\n  readonly dash: DashStyle;\n}\n\n/**\n * Filled regions between an upper and a lower boundary (area, stacked area). Each boundary is its own packed\n * polyline, so each can keep its own extremes when simplified (spec F5), and adjacent stack bands can share\n * the very same boundary array. `runs` holds quadruples (upperStart, upperCount, lowerStart, lowerCount) in\n * vertices; one quadruple is one polygon: its upper vertices forward, then its lower vertices in reverse.\n */\nexport interface AreaMark {\n  readonly type: 'area';\nexport interface RuleMark {\n  readonly type: 'rule';\n  readonly x1: number; readonly y1: number; readonly x2: number; readonly y2: number;\n  readonly stroke: Paint;\n  readonly strokeWidth: number;\n  readonly dash: readonly number[] | null;\n  readonly role: 'grid' | 'axis' | 'tick' | 'reference' | 'cursor' | 'break';\n}\n\n/** A filled rectangle that is not data: a reference band. */\nexport interface BandMark {\n  readonly type: 'band';\n  readonly box: Rect;\n  readonly fill: Paint;\n  readonly opacity: number;\n}\n\nexport type Mark = PathMark | AreaMark | RectMark | PointMark | ArcMark | RuleMark | BandMark;\n\n/** Everything the mark renderer draws, back to front. Plain data: no functions, no DOM. */\n/**\n * Turns a view into the input of `computeLayout`: which axes the chart has, their domains, their candidate\n * tick sets with labels, and their titles. Also produces the key that decides whether layout must rerun\n * (plan 2.2: a data-only update reruns layout only when tick labels or margins would change).\n */\nimport type { TextMeasurer, TextStyle, TickCandidates, View, XKind } from './contracts';\nimport type { LayoutInput } from '../layout';\nimport type { ResolvedOptions } from '../data';\nimport { bandScale, bandTickCandidates, linearScale, linearTickCandidates, timeScale, timeTickCandidates } from '../scale';\nimport { createNumberTickLabeler, createTimeTickLabel, type NumberFormatOption } from '../format';\nimport type { XValue } from '../public';\n\ntype Span = readonly [number, number];\n\nexport interface AxisContext {\n  readonly resolved: ResolvedOptions;\n  readonly locale: string;\n  readonly compact: boolean;\n  /** Called once per field when an author tick formatter throws (the chart raises AX160). */\n  readonly onFormatterError: (field: string, error: unknown) => void;\n}\n\nconst scales = {\n  linear: linearScale,\n  time: timeScale,\n  band: bandScale,\n};\n\nfunction withUnit(label: string, unit: string | null): string {\n  return unit ? `${label} (${unit})` : label;\n}\n\nfunction numberTicks(domain: Span, locale: string, option: unknown, scale: 'percent' | 'ratio' | null, onError: (e: unknown) => void): TickCandidates {\n  const tickFormat = typeof option === 'function' || (option !== null && typeof option === 'object')\n    ? option as NumberFormatOption : null;\n  return linearTickCandidates(domain, createNumberTickLabeler({ locale, scale, tickFormat, onError }));\n}\n\nfunction temporalTicks(\n  domain: Span, kind: 'time' | 'date' | 'wall', timeZone: string | null, dateUnit: 'day' | 'month' | 'year' | null,\n  locale: string, option: unknown, onError: (e: unknown) => void,\n): TickCandidates {\n  const format = typeof option === 'function' || (option !== null && typeof option === 'object')\n    ? option as Parameters<typeof createTimeTickLabel>[0]['format'] : null;\n  const label = format ? createTimeTickLabel({ kind, timeZone, locale, dateUnit, format, onError }) : null;\n  return timeTickCandidates(domain, { kind, timeZone, locale, dateUnit, label });\n}\n\nfunction categoryLabels(categories: readonly string[], option: unknown, onError: (e: unknown) => void): readonly string[] {\n  if (typeof option !== 'function') return categories;\n  let failed = false;\n  return categories.map(name => {\n    try {\n      return String((option as (value: XValue) => string)(name));\n    } catch (error) {\n      if (!failed) onError(error);\n      failed = true;\n      return name;\n    }\n  });\n}\n\nfunction continuousX(\n  kind: Exclude<XKind, 'category'>, domain: Span, timeZone: string | null, dateUnit: 'day' | 'month' | 'year' | null,\n  ctx: AxisContext,\n) {\n  const option = ctx.resolved.x.tickFormat;\n  const onError = (e: unknown) => ctx.onFormatterError(ctx.resolved.x.field, e);\n  const candidates = kind === 'number'\n    ? numberTicks(domain, ctx.locale, option, null, onError)\n    : temporalTicks(domain, kind, timeZone, dateUnit, ctx.locale, option, onError);\n  return { type: kind === 'number' ? 'linear' as const : 'time' as const, domain, candidates, mayThin: true };\n}\n\n/** Bars on a continuous x need half a step of room at each end, or the outer bars are cut in half. */\nfunction barDomain(values: Float64Array, start: number, end: number, domain: Span): Span {\n  const count = end - start;\n  if (count < 1) return domain;\n  const step = count > 1 ? (values[end - 1]! - values[start]!) / (count - 1) : 1;\n  const half = step / 2;\n  return [domain[0] - half, domain[1] + half];\n}\n\nexport function layoutInput(\n  view: View, size: { width: number; height: number }, text: { measurer: TextMeasurer; style: TextStyle }, ctx: AxisContext,\n): LayoutInput {\n  const { width, height } = size;\n  if (view.kind === 'donut') return { width, height, kind: 'ring' };\n  const value = ctx.resolved.values[0];\n  const yOption = value?.tickFormat ?? null;\n  const onYError = (e: unknown) => ctx.onFormatterError(value?.field ?? 'y', e);\n  const visibleSeries = view.frame.series.filter((_, i) => view.visible[i]);\n  const firstScale = 'valueScale' in (visibleSeries[0] ?? {}) ? (visibleSeries[0] as { valueScale: 'percent' | 'ratio' | null }).valueScale : null;\n  const valueScale = view.kind === 'scatter' ? value?.scale ?? null\n    : visibleSeries.every(s => (s as { valueScale: unknown }).valueScale === firstScale) ? firstScale : null;\n  const yTitle = view.kind === 'scatter'\n    ? withUnit(view.frame.yLabel, view.frame.yUnit)\n    : view.frame.yLabel === null ? undefined : withUnit(view.frame.yLabel, value?.unit ?? null);\n  const y = {\n    domain: view.yDomain, candidates: numberTicks(view.yDomain, ctx.locale, yOption, valueScale, onYError),\n    title: ctx.compact ? undefined : yTitle, mayThin: true,\n  };\n  const common = { width, height, compact: ctx.compact, measurer: text.measurer, style: text.style, scales };\n\n  if (view.kind === 'scatter') {\n    const x = continuousX(view.frame.xKind, view.xDomain, view.frame.timeZone, null, ctx);\n    return { ...common, kind: 'xy', x: { ...x, title: ctx.compact ? undefined : withUnit(view.frame.xLabel, view.frame.xUnit) }, y };\n  }\n\n  const column = view.frame.x;\n  const xTitle = ctx.compact ? undefined : withUnit(view.frame.xLabel, ctx.resolved.x.unit);\n  const onXError = (e: unknown) => ctx.onFormatterError(ctx.resolved.x.field, e);\n  if (column.kind === 'category') {\n    const labels = categoryLabels(column.categories ?? [], ctx.resolved.x.tickFormat, onXError);\n    const x = {\n      type: 'band' as const, count: labels.length, padding: view.kind === 'bar' ? 0.2 : 0,\n      candidates: bandTickCandidates(labels), mayThin: column.ordered, title: xTitle,\n    };\n    return view.kind === 'bar'\n      ? { ...common, kind: 'bands', horizontal: view.horizontal, x, y }\n      : { ...common, kind: 'xy', x, y };\n  }\n  const domain = view.kind === 'bar'\n    ? barDomain(column.values, view.visibleSlots.start, view.visibleSlots.end, view.xDomain)\n    : view.xDomain;\n  const x = { ...continuousX(column.kind, domain, column.timeZone, column.dateUnit, ctx), title: xTitle };\n  return view.kind === 'bar'\n    ? { ...common, kind: 'bands', horizontal: view.horizontal, x, y }\n    : { ...common, kind: 'xy', x, y };\n}\n\n/**\n * Everything layout reads, as comparable parts. Equal keys mean the previous layout is still right: same\n * size, text style, fonts, locale, domains, categories, titles and formatters.\n */\nexport function layoutKey(\n  view: View, size: { width: number; height: number }, style: TextStyle, fontEpoch: number, ctx: AxisContext,\n): readonly unknown[] {\n  const base: unknown[] = [size.width, size.height, style.font, style.letterSpacing, style.wordSpacing, style.lineHeight,\n    fontEpoch, ctx.locale, ctx.compact, view.kind];\n  if (view.kind === 'donut') return base;\n  const value = ctx.resolved.values[0];\n  base.push(view.xDomain[0], view.xDomain[1], view.yDomain[0], view.yDomain[1], ctx.resolved.x.tickFormat,\n    ctx.resolved.x.label, ctx.resolved.x.unit, value?.tickFormat, value?.label, value?.unit, value?.scale);\n  base.push(...view.visible);\n  if (view.kind === 'scatter') {\n    base.push(view.frame.xKind, view.frame.timeZone, view.frame.xLabel, view.frame.yLabel);\n    return base;\n  }\n  const column = view.frame.x;\n  base.push(column.kind, column.timeZone, column.dateUnit, column.ordered, view.frame.xLabel, view.frame.yLabel,\n    view.horizontal, view.visibleSlots.start, view.visibleSlots.end, column.categories);\n  for (const s of view.frame.series) base.push(s.valueScale);\n  return base;\n}\n\nexport function sameKey(a: readonly unknown[] | null, b: readonly unknown[]): boolean {\n  if (a === null || a.length !== b.length) return false;\n  for (let i = 0; i < a.length; i++) {\n    const x = a[i];\n    const y = b[i];\n    if (Object.is(x, y)) continue;\n    // Categories are compared by content: a renormalized frame has a new array with the same names.\n    if (Array.isArray(x) && Array.isArray(y) && x.length === y.length && x.every((v, k) => v === y[k])) continue;\n    return false;\n  }\n  return true;\n}\nimport type { BandScale, Tick, TickCandidates } from '../core/contracts';\n\n/**\n * Bands of equal width. `padding` is the fraction of a step left empty, the same between bands and at both\n * ends, so the outer gaps match the inner ones. The range may run backwards (a vertical category axis\n * drawn top to bottom from a bottom origin); `map` always returns the lower pixel edge of the band, so a\n * rectangle at map(i) with width `bandwidth` covers it either way.\n */\nexport function bandScale(count: number, range: readonly [number, number], padding: number): BandScale {\n  const n = Math.max(0, Math.floor(count));\n  const p = Number.isFinite(padding) ? Math.min(Math.max(padding, 0), 0.95) : 0;\n  const r0 = range[0];\n  const r1 = range[1];\n  const extent = Math.abs(r1 - r0);\n  const forward = r1 >= r0;\n  const step = n === 0 ? 0 : extent / (n + p);\n  const bandwidth = step * (1 - p);\n  const outer = step * p;\n\n  // Offset of band i's leading edge from range[0], measured along the range direction.\n  const lead = (i: number): number => outer + i * step;\n  const map = (i: number): number => (forward ? r0 + lead(i) : r0 - lead(i) - bandwidth);\n\n  return {\n    type: 'band',\n    count: n,\n    range: [r0, r1],\n    step,\n    bandwidth,\n    map,\n    center: (i: number) => map(i) + bandwidth / 2,\n    invert(pixel: number): number {\n      if (n === 0) return -1;\n      if (step === 0 || !Number.isFinite(pixel)) return 0;\n      const along = forward ? pixel - r0 : r0 - pixel;\n      // Nearest band centre, so a pixel in the padding belongs to the closer band.\n      const i = Math.round((along - outer - bandwidth / 2) / step);\n      return Math.min(Math.max(i, 0), n - 1);\n    },\n  };\n}\n\n/**\n * Sets of category labels, densest first: every category, then every k-th, always keeping the first.\n *\n * Strides are 1 to 10, then 20, 50, 100, 200, 500, … (1, 2, 5 × 10^k), so there are about 3·log10(n) + 10\n * sets for n categories. Sets are built on first read and kept, so laying out 100,000 categories costs\n * only the sets layout actually looks at. The result is still a plain readonly array of arrays.\n */\nexport function bandTickCandidates(labels: readonly string[]): TickCandidates {\n  const n = labels.length;\n  if (n === 0) return [];\n  const strides: number[] = [];\n  let lastSize = Infinity;\n  for (const k of strideSequence(n)) {\n    const size = Math.ceil(n / k);\n    if (size < lastSize) {\n      strides.push(k);\n      lastSize = size;\n    }\n    if (size === 1) break;\n  }\n  const sets: Tick[][] = [];\n  strides.forEach((k, index) => {\n    let built: Tick[] | null = null;\n    Object.defineProperty(sets, index, {\n      enumerable: true,\n      get(): Tick[] {\n        if (built === null) {\n          const set: Tick[] = [];\n          for (let i = 0; i < n; i += k) set.push({ value: i, label: labels[i] as string });\n          built = set;\n        }\n        return built;\n      },\n    });\n  });\n  return sets;\n}\n\n/** 1, 2, …, 10, 20, 50, 100, 200, 500, … up to the first stride at or above n. */\nfunction strideSequence(n: number): number[] {\n  const out: number[] = [];\n  for (let k = 1; k <= 10; k++) out.push(k);\n  for (let base = 10; out[out.length - 1]! < n; base *= 10) out.push(2 * base, 5 * base, 10 * base);\n  return out;\n}\n/**\n * The value-axis domain (spec F1 and F7).\n *\n * Precedence: an author domain is used as given (widened to zero on bar and area); otherwise the automatic\n * domain covers the data, stack totals and reference values, and each end is the first nice tick at or\n * beyond the extreme, so it never overshoots by a whole step.\n */\nimport { firstIndexAtOrAbove, lastIndexAtOrBelow, niceStepAtLeast, stepMultiple, type NiceStep } from './nice';\n\nexport interface ValueDomainInput {\n  /** Smallest and largest value, stack totals included. NaN (or min > max) when there is no data. */\n  readonly min: number;\n  readonly max: number;\n  /** True for bar and area. */\n  readonly includeZero: boolean;\n  /** The field's `domain` option. */\n  readonly authorDomain?: readonly [number, number] | null;\n  /** The field's declared `scale`. */\n  readonly valueScale?: 'percent' | 'ratio' | null;\n  /** Reference values (lines and band ends) that must be visible. */\n  readonly references?: readonly number[];\n}\n\nexport interface ValueDomain {\n  readonly domain: [number, number];\n  /** True when an author domain excluded zero and was widened (the caller raises AX110). */\n  readonly widenedToZero: boolean;\n}\n\n/**\n * Number of intervals the automatic domain is rounded to. About five gives ends that are rarely more than\n * a fifth of the span beyond the data, on a step that is one of the tick candidate sets.\n */\nconst DOMAIN_INTERVALS = 5;\n\n/** The step the automatic domain of [lo, hi] is rounded to (lo < hi). Divided first so that a span wider than the largest double does not overflow. */\nexport function domainStep(lo: number, hi: number): NiceStep {\n  return niceStepAtLeast(hi / DOMAIN_INTERVALS - lo / DOMAIN_INTERVALS);\n}\n\nexport function valueDomain(input: ValueDomainInput): ValueDomain {\n  const author = input.authorDomain;\n  if (author != null && Number.isFinite(author[0]) && Number.isFinite(author[1])) {\n    // Author bounds take precedence (F7) and are used as given, a zero-width domain included (the scale\n    // draws it in the middle). Only the zero rule of F1 changes them.\n    let lo = Math.min(author[0], author[1]);\n    let hi = Math.max(author[0], author[1]);\n    let widenedToZero = false;\n    if (input.includeZero && (lo > 0 || hi < 0)) {\n      lo = Math.min(lo, 0);\n      hi = Math.max(hi, 0);\n      widenedToZero = true;\n    }\n    return { domain: [lo === 0 ? 0 : lo, hi === 0 ? 0 : hi], widenedToZero };\n  }\n\n  let lo = Infinity;\n  let hi = -Infinity;\n  if (Number.isFinite(input.min) && Number.isFinite(input.max) && input.min <= input.max) {\n    lo = input.min;\n    hi = input.max;\n  }\n  for (const r of input.references ?? []) {\n    if (!Number.isFinite(r)) continue;\n    if (r < lo) lo = r;\n    if (r > hi) hi = r;\n  }\n  if (lo > hi) return { domain: [0, 1], widenedToZero: false }; // nothing to show; the chart shows its empty state\n  if (input.includeZero) {\n    lo = Math.min(lo, 0);\n    hi = Math.max(hi, 0);\n  }\n  const full = input.valueScale === 'percent' ? 100 : input.valueScale === 'ratio' ? 1 : null;\n  // The full-scale end is fixed; only the other end is rounded.\n  const fixedTop = full !== null && hi >= full / 2 && hi <= full;\n  if (fixedTop) hi = full;\n  const domain = lo === hi ? aroundConstant(lo, fixedTop, input.includeZero) : niceExtent(lo, hi, fixedTop);\n  return { domain: usable(domain, lo, hi), widenedToZero: false };\n}\n\n/**\n * [lo, hi] rounded outwards to the first multiple of the domain step at or beyond each end. With `fixedTop`\n * the upper end is kept as it is.\n */\nexport function niceExtent(lo: number, hi: number, fixedTop = false): [number, number] {\n  const step = domainStep(lo, hi);\n  if (!(step.value > 0 && Number.isFinite(step.value))) return [lo, hi];\n  const a = stepMultiple(lastIndexAtOrBelow(lo, step), step);\n  const b = fixedTop ? hi : stepMultiple(firstIndexAtOrAbove(hi, step), step);\n  return [a, b];\n}\n\n/**\n * A usable domain for a single value v (only reached without includeZero, or for zero itself). Zero gets\n * [0, 1] or [-1, 1]; any other value gets a nice range about 10% either side, or below it when v is the\n * fixed full-scale top.\n */\nfunction aroundConstant(v: number, fixedTop: boolean, includeZero: boolean): [number, number] {\n  // Zero on a bar or area axis starts at the baseline.\n  if (v === 0) return includeZero ? [0, 1] : [-1, 1];\n  // Below 1e-300 a tenth of the value is not representable; such a value is drawn as zero would be.\n  if (Math.abs(v) < 1e-300) return [-1, 1];\n  const h = Math.abs(v) * 0.1;\n  if (fixedTop || !Number.isFinite(v + h)) return niceExtent(v - 2 * h, v, true);\n  if (!Number.isFinite(v - h)) return [v, niceExtent(v, v + 2 * h)[1]];\n  return niceExtent(v - h, v + h);\n}\n\n/**\n * The rounded domain if it is finite, ordered and contains [lo, hi]; otherwise the finite input bounds,\n * so no rounding artefact (overflow, underflow, a step below the resolution of the values) reaches a scale.\n */\nfunction usable(domain: [number, number], lo: number, hi: number): [number, number] {\n  const [a, b] = domain;\n  if (Number.isFinite(a) && Number.isFinite(b) && a <= lo && b >= hi && a < b) return [a === 0 ? 0 : a, b === 0 ? 0 : b];\n  if (lo < hi) return [lo, hi];\n  // A single value whose rounded neighbourhood failed: any finite interval around it.\n  const h = Math.abs(lo) * 0.2;\n  if (Number.isFinite(lo - h) && lo - h < lo) return [lo - h, lo];\n  if (Number.isFinite(lo + h) && lo + h > lo) return [lo, lo + h];\n  return [lo - 1, lo + 1];\n}\n/**\n * The DOM text layer (plan 2.3): tick labels, titles and messages as real HTML text, so they inherit the\n * page font and color, honour the reader's text spacing (spec A6) and adapt to forced colors. The layer is\n * aria-hidden; readers get the same information from the summary and table.\n *\n * Each label is one absolutely positioned element with one block child per line. Its transform puts the\n * anchor point of the text on (x, y) and rotates about that point. Elements are reused between renders,\n * text is only ever set through textContent (spec DX8), and render writes without reading layout.\n */\nimport type { PlacedText } from '../core/contracts';\n\nexport interface TextLayer {\n  readonly element: HTMLDivElement;\n  render(texts: readonly PlacedText[]): void;\n  destroy(): void;\n}\n\ninterface Label {\n  readonly el: HTMLDivElement;\n  css: string;\n  role: string;\n  readonly lines: HTMLDivElement[];\n  readonly text: string[];\n}\n\nconst ALIGN = { start: 'left', middle: 'center', end: 'right' } as const;\nconst SHIFT_X = { start: '0%', middle: '-50%', end: '-100%' } as const;\nconst SHIFT_Y = { top: '0%', middle: '-50%', bottom: '-100%' } as const;\n\n/** Rounded to 1/100 px so that equal positions produce equal strings and skip the write. */\nconst px = (v: number): string => `${Math.round(v * 100) / 100}px`;\n\nexport function labelStyle(t: PlacedText): string {\n  // Transforms apply right to left: move the anchor point of the text to the origin, rotate about it,\n  // then move the origin to (x, y).\n  const rotate = t.rotate !== 0 ? ` rotate(${t.rotate}deg)` : '';\n  return `position:absolute;left:0;top:0;transform-origin:0 0;white-space:pre;text-align:${ALIGN[t.anchor]};` +\n    `transform:translate(${px(t.x)},${px(t.y)})${rotate} translate(${SHIFT_X[t.anchor]},${SHIFT_Y[t.baseline]})`;\n}\n\nexport function createTextLayer(doc: Document = document): TextLayer {\n  const element = doc.createElement('div');\n  element.className = 'axylo-text';\n  element.setAttribute('aria-hidden', 'true');\n  let labels: Label[] = [];\n\n  return {\n    element,\n    render(texts: readonly PlacedText[]): void {\n      let fresh: DocumentFragment | null = null;\n      for (let i = 0; i < texts.length; i++) {\n        const t = texts[i]!;\n        let label = labels[i];\n        if (label === undefined) {\n          const el = doc.createElement('div');\n          el.className = 'axylo-label';\n          label = { el, css: '', role: '', lines: [], text: [] };\n          labels.push(label);\n          (fresh ??= doc.createDocumentFragment()).appendChild(el);\n        }\n        const css = labelStyle(t);\n        if (label.css !== css) { label.css = css; label.el.style.cssText = css; }\n        if (label.role !== t.role) { label.role = t.role; label.el.setAttribute('data-role', t.role); }\n        const lines = label.lines;\n        while (lines.length > t.lines.length) { lines.pop()!.remove(); label.text.pop(); }\n        while (lines.length < t.lines.length) {\n          const line = doc.createElement('div');\n          // A blank line still takes one line height (in the reader's spacing), so anchors stay put.\n          line.style.setProperty('min-height', '1lh');\n          label.el.appendChild(line);\n          lines.push(line);\n          label.text.push('');\n        }\n        for (let k = 0; k < lines.length; k++) {\n          const s = t.lines[k]!;\n          if (label.text[k] !== s) { label.text[k] = s; lines[k]!.textContent = s; }\n        }\n      }\n      for (let i = texts.length; i < labels.length; i++) labels[i]!.el.remove();\n      if (labels.length > texts.length) labels = labels.slice(0, texts.length);\n      if (fresh !== null) element.appendChild(fresh);\n    },\n    destroy(): void {\n      element.remove();\n      labels = [];\n    },\n  };\n}\n","exit_code":0,"status":"completed"}}
