andidate\npackages/axylo/src/layout/index.ts:196:export function computeLayout(input: LayoutInput): Layout {\npackages/axylo/src/core/chart.ts:23:import { computeLayout } from '../layout';\npackages/axylo/src/core/chart.ts:623:          layout = computeLayout(layoutInput(view, size, { measurer, style }, axisContext));\n{\n  \"name\": \"axylo-workspace\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"workspaces\": [\n    \"packages/*\"\n  ],\n  \"scripts\": {\n    \"typecheck\": \"tsc -p packages/axylo --noEmit && tsc -p docs/api\",\n    \"test\": \"vitest run\",\n    \"build\": \"node scripts/build.mjs\",\n    \"size\": \"node scripts/size.mjs\",\n    \"test:browser\": \"AXYLO_BROWSER=1 vitest run\",\n    \"check\": \"npm run typecheck && npm test && npm run build && npm run test:browser && npm run size\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^26.6.6\",\n    \"axe-core\": \"^4.14.1\",\n    \"esbuild\": \"^0.28.2\",\n    \"fast-check\": \"^4.10.2\",\n    \"playwright-core\": \"^1.65.1\",\n    \"typescript\": \"^7.0.2\",\n    \"vitest\": \"^5.1.0\"\n  }\n}\n","exit_code":0,"status":"completed"}}
