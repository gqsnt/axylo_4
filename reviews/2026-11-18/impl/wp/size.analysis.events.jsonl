ns', 'normalize', 'append', 'view', 'frame', 'theme', 'formatters', 'layout', 'scene', 'lookup',\n    58\t  'reader', 'draw', 'text', 'figure'] as const;\n    59\texport type Stage = typeof STAGES[number];\n    60\t\n    61\tconst KIND_NAMES: Record<ChartKind, string> = { line: 'Line', area: 'Area', bar: 'Bar', scatter: 'Scatter', donut: 'Donut' };\n    62\tconst KIND_MESSAGES = { line: 'typeLine', area: 'typeArea', bar: 'typeBar', scatter: 'typeScatter', donut: 'typeDonut' } as const;\n    63\t/** Option resolution reports these about the data; they belong to the call that set the data. */\n    64\tconst DATA_CODES = new Set(['AX100', 'AX101']);\n    65\t\n    66\t/** What the benchmark harness reads (bench/README.md): readiness and what the committed frame shows. */\n    67\texport interface BenchHook {\n    68\t  readonly revision: number;\n    69\t  ready(): Promise<void>;\n    70\t  describe(): {\n    71\t    xDomain: Span | null;\n    72\t    yDomain: Span | null;\n    73\t    series: {\n    74\t      key: string; points: number; oldestX: number; newestX: number; missing: number;\n    75\t      /**\n    76\t       * Line charts: the caller's row indexes of the samples the simplified drawing kept, in drawing order (spec\n    77\t       * F5), so drawn gaps and extremes can be checked index-exactly. Absent for other chart types.\n    78\t       */\n    79\t      kept?: number[];\n    80\t    }[];\n    81\t    /** The mark renderer drawing this chart. */\n    82\t    renderer: 'canvas' | 'svg';\n    83\t  };\n    84\t}\n    85\t\n    86\texport interface DevHook {\n    87\t  stages(): Record<Stage, number>;\n    88\t  /** Makes the named stage throw, to test the internal-error state; null stops it. */\n    89\t  fail(stage: Stage | null): void;\n    90\t  readonly renderer: 'canvas' | 'svg';\n    91\t  /** Rows the streaming store still holds for revisions not yet retired (0 for a static chart). */\n    92\t  retainedRows(): number;\n    93\t}\n    94\t\n    95\texport type ChartHandle = Chart<unknown, Record<string, unknown>> & { __bench?: BenchHook; __dev?: DevHook };\n    96\t\n    97\texport interface Size { readonly width: number; readonly height: number }\n    98\t\n    99\t/** Everything the controller needs from the page. */\n   100\texport interface Host {\n   101\t  readonly id: string;\n   102\t  readonly console: DeliveryConsole | null;\n   103\t  /** The page the once-per-code printing rule applies to. */\n   104\t  readonly page: object;\n   105\t  readonly timeZone: string;\n   106\t  readonly renderer: Pick<MarkRenderer, 'kind' | 'draw'>;\n   107\t  readonly text: { render(texts: readonly PlacedText[]): void };\n   108\t  readonly figure: { update(model: FigureModel): boolean; announce(text: string, lang?: string | null): void };\n   109\t  readonly interaction: { prepare(state: ControlsState): boolean; commit(state: Committed | null): void; clear(): void };\n   110\t  readonly measurer: TextMeasurer;\n   111\t  /** The callback gets the animation frame's time when the host has one. */\n   112\t  requestFrame(callback: (time?: number) => void): number;\n   113\t  cancelFrame(handle: number): void;\n   114\t  locale(option: unknown): string;\n   115\t  pageLang(): string | null;\n   116\t  /** Text of the page element with this id, or null when there is none. */\n   117\t  labelText(id: string): string | null;\n   118\t  textStyle(): TextStyle;\n   119\t  /**\n   120\t   * The plot container's size as the figure lays it out, with what the rest of the figure overflows by\n   121\t   * subtracted from its height (so it can be negative); null when the figure is not laid out at all (hidden\n   122\t   * or detached), which is not the same as a visible figure whose caption left no room.\n   123\t   */\n   124\t  measure(): Size | null;\n   125\t  devicePixelRatio(): number;\n   126\t  theme(seriesKeys: readonly string[], colors: Record<string, string>): ThemeResolution;\n   127\t  /** Shows or hides the mark and text surfaces without drawing (the error revision hides them). */\n   128\t  surfaces?(visible: boolean): void;\n   129\t  /** Called once by destroy, after the controller released its own state. */\n   130\t  dispose(): void;\n   131\t}\n   132\t\n   133\t/** What the page tells the controller (observers, watchers). */\n   134\texport interface Invalidate {\n   135\t  resize(): void;\n   136\t  /** The chart came back into the document: anything about the page may have changed meanwhile. */\n   137\t  page(): void;\n   138\t  theme(): void;\n   139\t  fonts(): void;\n   140\t  pixelRatio(): void;\n   141\t}\n   142\t\n   143\t/** What the interaction layer may ask for; everything goes through the public paths. */\n   144\texport interface ControllerActions {\n   145\t  zoom(window: Span | null): void;\n   146\t  toggle(seriesKey: string): void;\n   147\t  pause(paused: boolean): void;\n   148\t  select(ref: DatumRef): void;\n   149\t  hover(ref: DatumRef | null): void;\n   150\t}\n   151\t\n   152\texport interface Controller {\n   153\t  readonly handle: ChartHandle;\n   154\t  readonly actions: ControllerActions;\n   155\t  readonly invalidate: Invalidate;\n   156\t  /** Runs the pending frame now (tests, and theme changes that arrive inside a frame). */\n   157\t  flush(): void;\n   158\t}\n   159\t\n   160\ttype Store = AlignedStore | PointStore | DonutStore;\n   161\t\n   162\t/** The state a call produced. Only accepted states are drawn. */\n   163\tinterface Accepted {\n   164\t  readonly options: OptionRecord;\n   165\t  /** Options resolved for the latest call (domains, formats, labels). */\n   166\t  readonly resolved: ResolvedOptions;\n   167\t  /** The resolution the current data was normalized with (on the static path it holds the borrowed table). */\n   168\t  readonly source: ResolvedOptions;\n   169\t  /** null until the first append: a static chart keeps the normalized frame over the caller's data. */\n   170\t  readonly store: Store | null;\n   171\t  /** The frame shown (while paused, the store may hold a newer one). */\n   172\t  readonly frame: Frame;\n   173\t  readonly dataDiagnostics: readonly DiagnosticInput[];\n   174\t  /** AX100 and AX101 from the call that set the data; kept while the data and fields stay. */\n   175\t  readonly dataOptions: readonly DiagnosticInput[];\n   176\t  readonly optionDiagnostics: readonly DiagnosticInput[];\n   177\t  readonly viewDiagnostics: readonly DiagnosticInput[];\n   178\t  readonly naming: readonly DiagnosticInput[];\n   179\t  readonly view: View;\n   180\t  readonly viewKey: readonly unknown[];\n   181\t  readonly zoom: Span<XValue> | null;\n   182\t  /** Zoomed to the latest edge: the window follows appended data (plan 1.5). */\n   183\t  readonly follow: boolean;\n   184\t  readonly revision: number;\n   185\t  readonly messages: Messages;\n   186\t  readonly name: string;\n   187\t  /** Series the reader hid with the legend, by key (the view's hidden set). */\n   188\t  readonly hidden: ReadonlySet<string>;\n   189\t}\n   190\t\n   191\ttype Display =\n   192\t  | { readonly kind: 'ready' }\n   193\t  | {\n   194\t    readonly kind: 'loading' | 'error' | 'empty' | 'internal'; readonly text: string;\n   195\t    /** The built-in message shown, or null when the author wrote the text. */\n   196\t    readonly message: keyof Messages | null;\n   197\t  };\n   198\t\n   199\t/** Presentation diagnostics by the stage that found them (spec 3.5: reported when found, never thrown). */\n   200\ttype PresentationStage = 'theme' | 'layout' | 'fit' | 'format' | 'naming' | 'internal';\n   201\t\n   202\t/** An x position as the value the author would write, so a zoom window can be moved by positions. */\n   203\texport function positionValue(frame: Frame, position: number): XValue {\n   204\t  if (frame.shape === 'donut') return position;\n   205\t  const kind = frame.shape === 'points' ? frame.xKind : frame.x.kind;\n   206\t  if (kind === 'time') return new Date(position);\n   207\t  if (kind === 'wall') return new Date(position).toISOString().slice(0, 23);\n   208\t  if (kind === 'category' && frame.shape === 'aligned') return frame.x.categories?.[position] ?? position;\n   209\t  return position;\n   210\t}\n   211\t\n   212\tfunction latestX(frame: Frame): number {\n   213\t  if (frame.shape === 'aligned') return frame.x.values.length ? frame.x.values[frame.x.values.length - 1]! : NaN;\n   214\t  if (frame.shape === 'points') {\n   215\t    let latest = -Infinity;\n   216\t    for (const s of frame.series) {\n   217\t      if (s.x.length) latest = Math.max(latest, s.x[s.x.length - 1]!);\n   218\t      // An observation with no y still marks how far the data reaches.\n   219\t      if (s.missingX) for (let i = 0; i < s.missingX.length; i++) if (Number.isFinite(s.missingX[i]!)) latest = Math.max(latest, s.missingX[i]!);\n   220\t    }\n   221\t    return latest;\n   222\t  }\n   223\t  return NaN;\n   224\t}\n   225\t\n   226\t/** A window that ends at the latest x and does not show everything follows the data (plan 1.5). */\n   227\tfunction followsLatest(view: View, zoom: Span<XValue> | null): boolean {\n   228\t  if (zoom === null || view.kind === 'donut') return false;\n   229\t  // The data's own latest position, not the niced or padded edge of the axis (finding 16).\n   230\t  const latest = latestX(view.frame);\n   231\t  return Number.isFinite(latest) && view.xDomain[1] >= latest && view.xDomain[0] > view.xFull[0];\n   232\t}\n   233\t\n   234\t/** What a destroyed controller holds instead of its host, so a handle kept by the page retains no DOM. */\n   235\tfunction deadHost(from: Host): Host {\n   236\t  const none = (): null => null;\n   237\t  const empty = { width: 0, height: 0 };\n   238\t  return {\n   239\t    id: from.id, console: null, page: {}, timeZone: from.timeZone,\n   240\t    renderer: { kind: from.renderer.kind, draw() {} }, text: { render() {} },\n   241\t    figure: { update: () => false, announce() {} }, interaction: { prepare: () => false, commit() {}, clear() {} },\n   242\t    measurer: { width: () => 0 }, requestFrame: () => 0, cancelFrame() {}, locale: () => 'en', pageLang: none,\n   243\t    labelText: none, textStyle: () => ({ font: '', letterSpacing: 0, wordSpacing: 0, lineHeight: 0 }), measure: () => empty,\n   244\t    devicePixelRatio: () => 1,\n   245\t    theme: () => { throw new Error('Axylo: the chart was destroyed.'); },\n   246\t    dispose() {},\n   247\t  };\n   248\t}\n   249\t\n   250\texport function createController(kind: ChartKind, input: unknown, page: Host): Controller {\n   251\t  let host = page;\n   252\t  const counts = Object.fromEntries(STAGES.map(s => [s, 0])) as Record<Stage, number>;\n   253\t  let failing: Stage | null = null;\n   254\t  const stage = (name: Stage): void => {\n   255\t    counts[name]++;\n   256\t    if (failing === name) throw new Error(`Axylo test hook: forced failure in the ${name} stage.`);\n   257\t  };\n   258\t  let delivery = new Delivery({ console: host.console, development: __DEV__, page: host.page });\n   259\t  const timeZone = host.timeZone;\n   260\t  const environment = { timeZone };\n   261\t\n   262\t  // ── synchronous phase ──────────────────────────────────────────────────────────────────────────\n   263\t\n   264\t  let options = new OptionsStore(input);\n   265\t  let accepted: Accepted | null = null;\n   266\t  const presentation = new Map<PresentationStage, readonly DiagnosticInput[]>();\n   267\t  /** Keys of the current diagnostics already printed and handed to `onDiagnostic`. */\n   268\t  let deliveredKeys = new Set<string>();\n   269\t  /** Increases with every delivery pass; a pass started inside author code supersedes the outer one. */\n   270\t  let destroyed = false;\n   271\t  let internalError: unknown = null;\n   272\t  /** `append` was called at least once: the pause control is offered (spec I6). */\n   273\t  let streaming = false;\n   274\t  let paused = false;\n   275\t  /** While paused: the store's newest frame and its findings, accepted but not shown. */\n   276\t  let held: { frame: Frame; dataDiagnostics: readonly DiagnosticInput[]; viewDiagnostics: readonly DiagnosticInput[] } | null = null;\n   277\t  /**\n   278\t   * The displayed snapshot's row ownership: what the marks on screen came from (see the invariants at the top\n   279\t   * of this file). `frozen` holds the caller's rows of that frame once the store had to let go of its revision.\n   280\t   */\n   281\t  let onScreen: { frame: Frame; store: Store | null; frozen: Map<number, unknown> | null } | null = null;\n   282\t  /** Frames a store produced (their rows live in that store's revisions). */\n   283\t  const storeFrames = new WeakSet<Frame>();\n   284\t  /** What the store held right after the last release with a frame on screen: the bound's baseline. */\n   285\t  let retainedBaseline = 0;\n   286\t  let epochs = 0;\n   287\t  let frameRevision = 0;\n   288\t  let commits = 0;\n   289\t  let listeners = new Map<keyof ChartEvents<unknown>, Set<(payload: never) => void>>();\n   290\t  /** True while a frame runs: findings are delivered at its end, not from inside a stage. */\n   291\t  let inFrame = false;\n   292\t\n   293\t  function chartName(o: OptionRecord): string {\n   294\t    return titleOf(o)?.text ?? host.id;\n   295\t  }\n   296\t\n   297\t  function presentationList(): DiagnosticInput[] {\n   298\t    const out: DiagnosticInput[] = [];\n   299\t    for (const list of presentation.values()) out.push(...list);\n   300\t    return out;\n   301\t  }\n   302\t\n   303\t  function stateDiagnostics(a: Accepted): DiagnosticInput[] {\n   304\t    return [...a.optionDiagnostics, ...a.dataDiagnostics, ...a.viewDiagnostics, ...a.naming];\n   305\t  }\n   306\t\n   307\t  function currentDiagnostics(): Diagnostic[] {\n   308\t    // Before anything was accepted (a create that failed): what the failure raised (finding 14).\n   309\t    if (!accepted) return toPublic(presentationList(), chartName(options.current));\n   310\t    // While paused, `diagnostics` describes everything accepted, the held rows included (finding 6).\n   311\t    const a = held ? { ...accepted, dataDiagnostics: held.dataDiagnostics, viewDiagnostics: held.viewDiagnostics } : accepted;\n   312\t    return toPublic([...stateDiagnostics(a), ...presentationList()], accepted.name);\n   313\t  }\n   314\t\n   315\t  /** Replaces what a presentation stage found; outside a frame the change is delivered at once. */\n   316\t  function setPresentation(where: PresentationStage, list: readonly DiagnosticInput[]): void {\n   317\t    const before = presentation.get(where) ?? [];\n   318\t    if (before.length === 0 && list.length === 0) return;\n   319\t    if (before.length === list.length && before.every((d, i) => diagnosticKey(d) === diagnosticKey(list[i]!))) return;\n   320\t    if (list.length) presentation.set(where, list);\n   321\t    else presentation.delete(where);\n   322\t    if (!inFrame && !destroyed) {\n   323\t      deliverChanges();\n   324\t      // The reader's note may change with it (spec F12).\n   325\t      schedule();\n   326\t    }\n   327\t  }\n   328\t\n   329\t  function addPresentation(where: PresentationStage, d: DiagnosticInput): void {\n   330\t    const list = presentation.get(where) ?? [];\n   331\t    if (list.some(o => o.code === d.code && o.field === d.field)) return;\n   332\t    setPresentation(where, [...list, d]);\n   333\t  }\n   334\t\n   335\t  function formatterFailed(field: string): void {\n   336\t    addPresentation('format', createDiagnostic('AX160', 'changed', { field }, 'presentation'));\n   337\t  }\n   338\t\n   339\t  /**\n   340\t   * Notifications to author code (onDiagnostic, the console, event listeners) in call order: each delivery\n   341\t   * is a snapshot taken when it is made and is drained in full, and one made by author code during a drain\n   342\t   * waits behind it. Only destruction stops a drain