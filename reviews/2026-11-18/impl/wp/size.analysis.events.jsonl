ntests/dist/pages/observe.js\ntests/dist/pages/charts.ts\ntests/dist/pages/inject.js\ntests/dist/browser.ts\ntests/dist/types.test.ts\ntests/dist/setup.ts\ntests/dist/snippets.test.ts\ntests/dist/conditions.test.ts\ntests/dist/package-contents.test.ts\npackages/react/test/browser/probe.ts\npackages/react/test/browser/tree.ts\npackages/react/test/browser/app.tsx\npackages/react/test/browser/spy-axylo.ts\npackages/react/test/browser/open.ts\npackages/react/test/browser/react.browser.test.ts\ntests/dist/first-chart.browser.test.ts\ntests/dist/csp.browser.test.ts\ntests/dist/tsconfig.json\ntests/dist/README.md\ntests/dist/isolation.test.ts\ntests/dist/vitest.config.ts\ntests/dist/side-effects.test.ts\ntests/dist/licence.test.ts\ntests/dist/fixtures/script/package.json\ntests/dist/fixtures/react/main.tsx\ntests/dist/fixtures/react/package.json\ntests/dist/fixtures/react/ssr.tsx\ntests/dist/fixtures/react/consumer.tsx\ntests/dist/fixtures/react/tsconfig.json\ntests/dist/fixtures/react/hydrate.tsx\ntests/dist/fixtures/npm/tsconfig.json\ntests/dist/fixtures/npm/node-import.mjs\ntests/dist/fixtures/npm/consumer.ts\ntests/dist/fixtures/npm/package.json\n","exit_code":0,"status":"completed"}}
