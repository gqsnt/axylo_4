{"type":"item.completed","item":{"id":"item_60","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/src/lookup/scatter-grid.ts | sed -n '1,47p;79,172p;211,265p'; nl -ba packages/axylo/src/scale/time.ts | sed -n '40,74p;224,247p'; nl -ba packages/axylo/src/format/intl.ts\"","aggregated_output":"     1\timport type { ScatterView } from '../core/contracts';\n     2\timport { contains, scatterPosition, type PlotLayout } from './geometry';\n     3\t\n     4\tconst CELL = 24;\n     5\tconst RADIUS2 = CELL * CELL;\n     6\tconst COINCIDENT = 0.5;\n     7\tconst COINCIDENT2 = COINCIDENT ** 2;\n     8\tconst LEAF_SIZE = 32;\n     9\texport const POINT_LIMIT = 8;\n    10\t\n    11\tinterface Bucket {\n    12\t  readonly start: number;\n    13\t  readonly end: number;\n    14\t  readonly count: number;\n    15\t  readonly minX: number;\n    16\t  readonly maxX: number;\n    17\t  readonly minY: number;\n    18\t  readonly maxY: number;\n    19\t  readonly left?: Bucket;\n    20\t  readonly right?: Bucket;\n    21\t}\n    22\t\n    23\tfunction distanceTo(bucket: Bucket, x: number, y: number): number {\n    24\t  return Math.max(bucket.minX - x, x - bucket.maxX, 0) ** 2\n    25\t    + Math.max(bucket.minY - y, y - bucket.maxY, 0) ** 2;\n    26\t}\n    27\t\n    28\tfunction distanceAcross(bucket: Bucket, x: number, y: number): number {\n    29\t  return Math.max(Math.abs(bucket.minX - x), Math.abs(bucket.maxX - x)) ** 2\n    30\t    + Math.max(Math.abs(bucket.minY - y), Math.abs(bucket.maxY - y)) ** 2;\n    31\t}\n    32\t\n    33\texport function scatterGrid(view: ScatterView, layout: PlotLayout & { projection: Extract<PlotLayout['projection'], { kind: 'xy' }> }, count: number) {\n    34\t  const { plot, projection } = layout;\n    35\t  const columns = Math.floor(plot.width / CELL) + 1;\n    36\t  const rows = Math.floor(plot.height / CELL) + 1;\n    37\t  const heads = new Map<number, number>();\n    38\t  const next = new Int32Array(count);\n    39\t  const series = new Uint32Array(count);\n    40\t  const points = new Uint32Array(count);\n    41\t  const xs = new Float64Array(count);\n    42\t  const ys = new Float64Array(count);\n    43\t  let length = 0;\n    44\t  let examined = 0;\n    45\t  let cellsExamined = 0;\n    46\t\n    47\t  function cellIndex(pixel: number, origin: number, size: number): number {\n    79\t      xs[at] = x;\n    80\t      ys[at] = y;\n    81\t      series[at] = s;\n    82\t      points[at] = i;\n    83\t    }\n    84\t  });\n    85\t\n    86\t  const order = new Uint32Array(length);\n    87\t  const multiplicity = new Uint32Array(length);\n    88\t  const buckets = new Map<number, Bucket>();\n    89\t  function build(start: number, end: number, allowSkew = true): Bucket {\n    90\t    let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;\n    91\t    let count = 0;\n    92\t    for (let i = start; i < end; i++) {\n    93\t      const p = order[i]!;\n    94\t      minX = Math.min(minX, xs[p]!);\n    95\t      maxX = Math.max(maxX, xs[p]!);\n    96\t      minY = Math.min(minY, ys[p]!);\n    97\t      maxY = Math.max(maxY, ys[p]!);\n    98\t      count += multiplicity[p]!;\n    99\t    }\n   100\t    const bounds = { start, end, count, minX, maxX, minY, maxY };\n   101\t    if (end - start <= LEAF_SIZE) return bounds;\n   102\t\n   103\t    const byX = maxX - minX >= maxY - minY;\n   104\t    const positions = byX ? xs : ys;\n   105\t    const pivot = byX ? minX / 2 + maxX / 2 : minY / 2 + maxY / 2;\n   106\t    let mid = start;\n   107\t    for (let i = start; i < end; i++) {\n   108\t      const p = order[i]!;\n   109\t      if (positions[p]! >= pivot) continue;\n   110\t      order[i] = order[mid]!;\n   111\t      order[mid++] = p;\n   112\t    }\n   113\t    const smaller = Math.min(mid - start, end - mid);\n   114\t    const skewed = smaller < (end - start) / 8;\n   115\t    // Keep spatially separated groups together. Consecutive skewed splits need a median