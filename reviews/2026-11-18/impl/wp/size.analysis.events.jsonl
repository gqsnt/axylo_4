{"type":"item.completed","item":{"id":"item_54","type":"command_execution","command":"/bin/bash -lc \"git show 8ab0734:packages/axylo/src/public.ts | nl -ba | sed -n '102,238p'; nl -ba docs/03-plan-typescript-release.md | sed -n '104,149p;166,236p'; nl -ba docs/02-product-spec.md | sed -n '218,251p'\"","aggregated_output":"   102\t}\n   103\t\n   104\texport interface Reference {\n   105\t  x?: XValue | readonly [XValue, XValue];\n   106\t  y?: number | readonly [number, number];\n   107\t  label: string;\n   108\t}\n   109\t\n   110\texport interface CartesianOptions {\n   111\t  /** Default true on time, date and number x axes. 'touch' also captures pinch and two-finger drag on touch screens. */\n   112\t  zoom?: boolean | 'touch';\n   113\t  reference?: readonly Reference[];\n   114\t}\n   115\t\n   116\t/** Line, area and bar only. Marks only, as a static image with a text alternative: no axes, legend, toolbar, table, zoom or tooltip. */\n   117\texport interface CompactOption { compact?: boolean }\n   118\t\n   119\texport type LineOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row>;\n   120\texport type AreaOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { stacked?: boolean };\n   121\texport type BarOptions<Row> = CommonOptions<Row> & CartesianOptions & CompactOption & Encoding<Row> & { layout?: 'grouped' | 'stacked'; horizontal?: boolean };\n   122\t/** Scatter relates two measures: its x is a number, an instant or a date, never a category. */\n   123\texport type ScatterXField<Row> = XKey<Row> | ({ field: XKey<Row>; type?: 'number' | 'time' | 'date'; ordered?: never } & Omit<XFieldOptions, 'type' | 'ordered'>);\n   124\texport type ScatterOptions<Row> = CommonOptions<Row> & CartesianOptions & { x: ScatterXField<Row>; y: ValueField<Row>; series?: SeriesKey<Row> };\n   125\texport type DonutOptions<Row> = CommonOptions<Row> & { label: SeriesKey<Row>; value: ValueField<Row> };\n   126\t\n   127\t// ---------- handle ----------\n   128\t\n   129\texport interface Point<Row> { series: string; x: XValue; y: number | null; row: Row | null; index: number }\n   130\t\n   131\texport interface ChartEvents<Row> {\n   132\t  hover: Point<Row> | null;\n   133\t  select: Point<Row>;\n   134\t  zoom: readonly [XValue, XValue] | null;\n   135\t}\n   136\t\n   137\texport interface Chart<Row, Options> {\n   138\t  /**\n   139\t   * Changes options. Keys present replace the old value; a key set to `undefined` returns to its default; absent keys stay.\n   140\t   * Validation and diagnostics are synchronous (a `strict` chart throws here and keeps its last valid state); drawing happens on the next frame.\n   141\t   */\n   142\t  update(patch: Partial<Options>): void;\n   143\t  /** Adds rows at the end. `keep` = number of distinct x values retained; older ones are dropped. */\n   144\t  append(rows: readonly Row[], options?: { keep?: number }): void;\n   145\t  /** Sets the visible x range; `null` shows everything. */\n   146\t  zoom(domain: readonly [XValue, XValue] | null): void;\n   147\t  on<E extends keyof ChartEvents<Row>>(event: E, listener: (payload: ChartEvents<Row>[E]) => void): () => void;\n   148\t  /** Diagnostics for the current options and data. Up to date as soon as create, update or append returns. */\n   149\t  readonly diagnostics: readonly Diagnostic[];\n   150\t  destroy(): void;\n   151\t}\n   152\t\n   153\texport type Target = string | HTMLElement;\n   154\t\n   155\t\n   156\t\n   157\t\n   158\t\n   159\t\n   160\t\n   161\t// ---------- diagnostics ----------\n   162\t\n   163\texport interface Diagnostic {\n   164\t  /** Stable and documented, one page per code. */\n   165\t  code: `AX${number}`;\n   166\t  level: 'error' | 'warning' | 'hint';\n   167\t  /** What is wrong, where, and how to fix it. */\n   168\t  message: string;\n   169\t  /** The chart it came from: its title, else its element id. */\n   170\t  chart: string;\n   171\t  /** Where applicable. A diagnostic about the chart as a whole (no title, low contrast) has neither. */\n   172\t  field?: string;\n   173\t  /** First offending row indexes in the caller's own data, capped at 10. */\n   174\t  rows?: readonly number[];\n   175\t  count?: number;\n   176\t}\n   177\t\n   178\t/** Runs normalization and validation only. Works without a DOM, so a server or an agent can check options before rendering. */\n   179\t\n   180\t/** Built-in text. Templates use {name} placeholders. Every entry can be replaced through `messages` (spec A10). */\n   181\texport interface Messages {\n   182\t  viewAsTable: string; hideTable: string;\n   183\t  noData: string; noObservation: string; incompleteStack: string;\n   184\t  moreRows: string; otherSlices: string;\n   185\t  valuesNotShown: string; valuesChanged: string; labelsHidden: string;\n   186\t  loading: string; empty: string; error: string; internalError: string;\n   187\t  chartName: string; chartSummary: string; seriesSummary: string; referenceSummary: string; timeZoneNote: string;\n   188\t  plotLabel: string; controlsLabel: string; pointOf: string;\n   189\t  zoomIn: string; zoomOut: string; resetZoom: string; pause: string; resume: string;\n   190\t  previousPage: string; nextPage: string; pageOf: string; jumpToX: string;\n   191\t  showSeries: string; hideSeries: string;\n   192\t  /** Column headers and nouns. */\n   193\t  category: string; percentage: string; series: string; value: string;\n   194\t  /** Chart type names used in generated names and summaries. */\n   195\t  typeLine: string; typeArea: string; typeBar: string; typeScatter: string; typeDonut: string;\n   196\t  /** Summary sentences that have no cartesian form. */\n   197\t  donutSummary: string; seriesNoData: string; seriesNotDrawn: string; referenceLine: string; referenceBand: string;\n   198\t  /** What the keyboard proxy says it is (\"{type} chart\") and how it reads a position. */\n   199\t  plotRole: string; pointAll: string; seriesValue: string; position: string;\n   200\t  /** Label of the stack total in tooltips. */\n   201\t  total: string;\n   202\t  /** Single-click panning (WCAG 2.5.7), the table's \"Jump to\" when nothing matches, and how to move in the plot. */\n   203\t  panLeft: string; panRight: string; jumpNotFound: string; plotInstructions: string;\n   204\t  /** Fills `{seeTable}` in `valuesNotShown`, `valuesChanged`, `labelsHidden` and `seriesNotDrawn` when the chart has a table; without one the placeholder is removed. An override without the placeholder is used as written. */\n   205\t  seeTable: string;\n   206\t}\n   104\t\n   105\tThere is no `width`, `height`, `responsive`, `theme`, `palette` or `animation` option. Size comes from the container, colors from CSS, motion from the spec (I5). An unknown key raises AX150 with the closest known name.\n   106\t\n   107\t### 1.5 Handle and commit contract\n   108\t\n   109\t```ts\n   110\tchart.update({ title: 'Sessions' });                 // options\n   111\tchart.append([{ day: '2026-05-01', channel: 'Direct', sessions: 41210 }], { keep: 120 });   // rows\n   112\tchart.zoom(['2026-03-01', '2026-03-31']);            // view\n   113\tconst off = chart.on('hover', point => { … });\n   114\tchart.diagnostics;                                   // current, as soon as any call returns\n   115\tchart.destroy();\n   116\t```\n   117\t\n   118\tFinding D3: the ten libraries have seven update idioms. Axylo has three methods, one per kind of change, with one contract.\n   119\t\n   120\t| Rule | Detail |\n   121\t|---|---|\n   122\t| Order | Calls are applied in the order made. `update({ data })` followed by `append` appends to the new data. |\n   123\t| Two phases | Each call validates and normalizes synchronously: diagnostics are current when it returns, and a `strict` chart throws from that call. Drawing is deferred to the next animation frame, and calls made before that frame are drawn once. |\n   124\t| Atomic switch | Marks, labels, hit testing and the accessibility layer move to a new data revision together. No frame mixes two revisions. |\n   125\t| Patches | A key present in an `update` replaces the old value whole; a key set to `undefined` returns to its default; absent keys stay. No deep merging. |\n   126\t| Rejected changes | A call that throws under `strict` leaves the chart on its last valid state. |\n   127\t| Streaming | `keep` is the number of distinct x values retained. Rows before the last x are accepted through the slower full update and raise AX151. While zoomed to the latest edge the view follows new data; zoomed elsewhere, it stays put. Paused charts buffer (I6). Keyboard focus stays on its datum until that datum leaves the window (A7). |\n   128\t| Teardown | `destroy()` cancels the pending frame, disconnects observers and listeners, and makes later calls no-ops. |\n   129\t\n   130\t### 1.6 Diagnostics\n   131\t\n   132\tThe registry, with each code's level and outcome, is in the spec (section 3.5). Example for the Phase 1 combined dirty fixture (`[10, 20, null, NaN, '40', undefined, 70]`):\n   133\t\n   134\t```\n   135\t[axylo AX103] \"Dirty input\": y field \"value\" has 1 value that is not a finite number (NaN at row 3). Shown as a gap.\n   136\t  Check the calculation that produced it, or send null for \"no data\".\n   137\t[axylo AX106] \"Dirty input\": y field \"value\" mixes numbers with 1 string (\"40\" at row 4). The string is not plotted.\n   138\t  Convert it to a number where the data is produced.\n   139\t[axylo AX102] \"Dirty input\": y field \"value\" is absent in 1 row (row 5). Shown as a gap.\n   140\t  Send null if the value is known to be missing.\n   141\t```\n   142\t\n   143\tThe reader of that chart sees \"Values not shown: 3. See table.\" (F12).\n   144\t\n   145\t`validate(type, options)` runs the same normalization without a DOM and returns the diagnostics, so a server, a test or a coding agent can check a chart before rendering it.\n   146\t\n   147\tDevelopment and production flavours are selected through package `exports` conditions. The script-tag distribution ships `axylo.js` (development) and `axylo.min.js` (production). Errors and warnings print once per code per page in both; hints only in development.\n   148\t\n   149\t### 1.7 React adapter\n   166\t\n   167\t## 2. Architecture\n   168\t\n   169\t### 2.1 Pipeline\n   170\t\n   171\t```\n   172\toptions ─► normalize ─► frame ──┬─► view model ─► layout ─► scene ─► mark renderer\n   173\t            │ validate   (authoritative) │   scales, visible range         text renderer (DOM)\n   174\t            ▼ diagnostics                ├─► lookup: exact values by x, by point, by ordinal\n   175\t                                         ├─► summary and table\n   176\t                                         └─► focus model\n   177\t```\n   178\t\n   179\tThe **frame** is the normalized, lossless data: typed columns, a validity bitmap, dictionary-encoded categories, source-row indexes and a revision number. It is the only source for exact values. The table, the summary, keyboard navigation, tooltips and events read the frame. The **scene** is geometry for drawing and may be simplified (F5); nothing reads values back from it. The first draft derived accessibility from the scene, and two reviewers showed that a simplified drawing cannot return the samples it dropped.\n   180\t\n   181\t| Stage | Output | Notes |\n   182\t|---|---|---|\n   183\t| normalize | Frame, diagnostics | The only place raw input is read. Never coerces silently. |\n   184\t| view model | Scales, visible index ranges, series visibility | Domain rules implement F1 and F7. |\n   185\t| lookup | Nearest-x by binary search; nearest-point by a grid index (scatter) | Works on the frame within the visible range; cost bounded independently of the drawing. |\n   186\t| layout | Plot rectangle, tick sets, label boxes, legend and control placement | Implements L1, L3, L8. Takes a text-measurement interface as input. |\n   187\t| scene | Flat list of primitives (`path`, `rect`, `arc`, `rule`, `text`) | Plain data; testable in Node with injected text metrics. |\n   188\t| renderers | Marks; DOM text; accessibility DOM | See 2.3. |\n   189\t\n   190\t### 2.2 Invalidation\n   191\t\n   192\tStages are cached, and the cache keys are explicit. Caching on object identity alone, as the first draft said, would miss font loads, pixel-ratio changes and in-place mutation.\n   193\t\n   194\t| Stage | Reruns when |\n   195\t|---|---|\n   196\t| normalize | Data revision or field encoding changes. `append` extends the frame without renormalizing earlier rows. |\n   197\t| view model | Frame revision, zoom, series visibility, author domains. |\n   198\t| layout | View model; container size; resolved font and text spacing; `document.fonts` finishing a load; locale; any label text. A data-only update reruns layout when the tick labels would change, and skips it otherwise. |\n   199\t| scene | Layout or view model. |\n   200\t| mark raster | Scene; device pixel ratio; resolved colors (L4's triggers). |\n   201\t\n   202\tText is measured with the page's computed font, letter spacing and word spacing applied to the measuring context, and layout reruns when fonts finish loading. The measurement interface is a parameter, so Node tests inject fixed metrics and browser tests use the real one.\n   203\t\n   204\t### 2.3 Rendering\n   205\t\n   206\t**Working assumption: Canvas 2D for marks, HTML for all text.** Text stays in the DOM so that it inherits the page font and color, honors user text spacing and zoom (A6), adapts in forced-colors mode, and can be selected and translated.\n   207\t\n   208\t**This is reopened and decided in M1 by measurement.** The first draft justified canvas by Phase 1's slow SVG libraries, but those create a node per point; the one-path-per-series SVG chart in the harness was fast. With drawing simplified to a few vertices per pixel column (F5), an SVG path per series is small. SVG follows CSS variables and class-toggled themes with no repaint code, adapts to forced colors, prints sharply, needs no pixel-ratio handling and allocates no backing store (a 1,920×1,080 canvas at pixel ratio 2 is about 33 MB). Canvas is likely cheaper for per-frame redraw when streaming and hovering.\n   209\t\n   210\tM1 builds both mark renderers behind the same scene and compares them on: P1, P2, P3, P5, bytes, memory, a runtime theme toggle, forced colors, print, and browser zoom. The scene is renderer-neutral either way, so the choice is contained.\n   211\t\n   212\t**Simplified drawing.** Per device-pixel column and per contiguous run of valid samples, the stroke covers the run's minimum and maximum (F5). One rule for when it applies: more than four visible samples per device-pixel column on average. The pass over visible samples is O(visible) on typed columns and is measured separately from drawing; the vertex count is bounded by width times the number of runs, not by width alone.\n   213\t\n   214\t**No animation system.** First render is not animated (I5). Updates cut, or tween for at most 200 ms where the cost is negligible, and not at all under reduced motion.\n   215\t\n   216\t### 2.4 Document structure\n   217\t\n   218\t```html\n   219\t<figure class=\"axylo\" id=\"ax7\" role=\"group\" aria-labelledby=\"ax7-t\" aria-describedby=\"ax7-s\">\n   220\t  <figcaption>\n   221\t    <h3 id=\"ax7-t\">Daily sessions by channel</h3>        <!-- level from options; or omitted when labelledBy is used -->\n   222\t    <p id=\"ax7-s\" class=\"axylo-summary\">Line chart, 3 series, …</p>\n   223\t  </figcaption>\n   224\t  <div class=\"axylo-plot\" tabindex=\"0\"> … marks … <div class=\"axylo-text\" aria-hidden=\"true\">tick labels</div></div>\n   225\t  <div class=\"axylo-toolbar\" role=\"toolbar\" aria-label=\"Chart controls\">   <!-- one tab stop, roving focus -->\n   226\t    legend toggles · zoom in · zoom out · reset · pause · view as table\n   227\t  </div>\n   228\t  <p class=\"axylo-note\" role=\"status\">Values not shown: 2. See table.</p>\n   229\t  <div class=\"axylo-live\" aria-live=\"polite\"></div>\n   230\t  <div class=\"axylo-tooltip\" hidden></div>\n   231\t  <div class=\"axylo-table\" hidden><!-- built when opened: caption, headers, pager --></div>\n   232\t</figure>\n   233\t```\n   234\t\n   235\tIds are generated per chart. The plot's role, and how a focused point is conveyed, are not fixed here: M1 runs a spike with three candidate patterns and M4 confirms the choice (section 4).\n   236\t\n   218\t## 4. Acceptance criteria: the developer's experience\n   219\t\n   220\t| ID | Criterion | Verified by | Driven by |\n   221\t|---|---|---|---|\n   222\t| DX1 | The first chart takes ten lines or fewer, including import, by npm, by script tag and in React. No required option besides data and fields. | Three CI tests that render the documented snippet from the packed distribution | D1 |\n   223\t| DX2 | One logical table, three ways to pass it: long rows, wide rows, typed columns. The three forms of each fixture produce the same normalized data and the same diagnostics, with row indexes in the caller's own form. | Equivalence tests | D2 |\n   224\t| DX3 | With typed rows, a misspelled field, a text field on a value axis, wide `y` combined with `series`, and an option that does not apply to the chart type all fail to compile. At run time, for untyped rows, the same mistakes raise AX101, AX106 and AX150. | [docs/api/examples.ts](api/examples.ts) compiles and each marked mistake fails (already checked with TypeScript 7.0.2); runtime tests per code | D5 |\n   225\t| DX4 | Diagnostics follow the registry in section 3.5: stable code, chart name, field and rows where they apply, the fix, and a documentation page per code. | Message snapshots; link checker | R5, D5 |\n   226\t| DX5 | Three methods change a chart: `update` changes options, `append` adds rows, `zoom` sets the view. They apply in call order. Validation and diagnostics are synchronous; drawing is deferred to the next frame; marks, labels, hit testing and the accessibility layer always switch to a new state together. `destroy()` releases everything and cancels pending work. No `resize()` exists. | Sequence tests: replace then append then zoom in one turn; a rejected `strict` update leaves the last valid chart; destroy before the frame; 1,000 create–destroy cycles show no heap growth trend (P7) | D3, R16 |\n   227\t| DX6 | Colors, font and spacing are CSS custom properties with documented names; the chart inherits `font-family` and `color`. `colors` pins a color to a series name so the same series has the same color on every chart. There is no theme object and no positional palette option. | Theming tests, including a 24-tile page where series subsets differ | R10 |\n   228\t| DX7 | Zero runtime dependencies (reconsidered only with a measured comparison). Size targets, provisional until M1 measures a working slice: 40 KiB gzipped for everything, 25 KiB for a page that uses only `line`, 2 KiB for the React adapter, CSS included. | size-limit in CI on the packed distribution | D4 |\n   229\t| DX8 | Importing in Node without a DOM does not throw, and `validate()` runs there. Works under React StrictMode, including setup, cleanup and setup again. Works under a Content Security Policy without `unsafe-inline` or `unsafe-eval`, served with real headers. Labels and formatter output are inserted as text, never as HTML. A target that matches no element throws an error that names the selector. | CI tests | D1 |\n   230\t| DX9 | Semantic versioning. A deprecated API keeps working for at least one minor release and six months. At most one major version a year. The previous release's documented examples still compile and run against each release candidate. | Release policy; API report diff; upgrade test | D6 |\n   231\t| DX10 | Every runnable example in the documentation is compiled and rendered in CI from the packed distribution. | Docs build | D1 |\n   232\t| DX11 | MIT license for everything, including zoom and accessibility. Third-party notices are verified at release. | Repository; release check | D7 |\n   233\t| DX12 | A coding agent gets the first chart right. Given fixed prompts and trap fixtures (UTC-midnight ISO dates, numeric strings, unsorted rows, missing days, a misspelled field), an agent with only the published docs produces a chart with no error diagnostics that passes the reader criteria. Recorded as agent rehearsal, not as user evidence. | Scripted rehearsal at each release | D1, 1.2 |\n   234\t\n   235\t## 5. Performance budgets\n   236\t\n   237\tThese numbers are provisional. They are design targets taken from Phase 1's order-of-magnitude measurements, and they become release gates only after the benchmark harness built in M0 has measured a working Axylo slice in M1 and the limits have been recalibrated and frozen (plan, M1 and M6). Each budget names its workload, metric and statistic so that two people measuring the same build get the same verdict.\n   238\t\n   239\t| ID | Workload | Metric | Statistic | Provisional limit | Phase 1 reference |\n   240\t|---|---|---|---|---|---|\n   241\t| P1 | `trend` (3×120), default options, reference desktop | Main-thread task time from the call until the chart is complete | Median of 20 runs | 10 ms | Not comparable across libraries below about 35 ms with the Phase 1 method |\n   242\t| P2 | One series, 100,000 and 1,000,000 points, typed columns | Same | Median of 20 | 60 ms and 250 ms | See 01, section 5.3: uPlot and tuned Chart.js are the fastest measured |\n   243\t| P3 | 600-point window, one appended point per display frame at 60 Hz, driven by an independent clock | Main-thread task time per update (per run: task time in the window divided by the number of updates); and frames later than 25 ms | Median over runs; count per 300 frames | 2 ms; 0 | See 01, section 5.3 |\n   244\t| P4 | Pointer moved across a 100,000-point chart | Time from input to the frame showing the matching readout | 95th percentile | One frame (16.7 ms at 60 Hz) | Not measured in Phase 1 |\n   245\t| P5 | 24 `trend` charts created on one page, each tile 340 × 200 px | Total main-thread task time | Median of 20 | 200 ms | Not measured in Phase 1 |\n   246\t| P6 | Download | Minified and gzipped bytes, CSS included | Exact | DX7 | 01, section 1.4 |\n   247\t| P8 | 40 compact charts created on one page, each 160 × 48 px with one series | Total main-thread task time | Median of 20 | 80 ms | Not measured in Phase 1 |\n   248\t| P7 | Memory | Bytes owned by Axylo beyond the caller's columns for 1,000,000 points; heap trend over 1,000 create–destroy cycles | Measured after forced collection | At most 1× the size of the caller's two columns; no upward slope | Not measured in Phase 1 |\n   249\t\n   250\tThree rules hold whatever the numbers become:\n   251\t\n","exit_code":0,"status":"completed"}}
