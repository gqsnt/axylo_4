-d863.json\nbench/history/20261118T024512Z-resize-1x100000-axylo-canvas-vs-axylo-svg-c11f.json\nbench/history/20261118T024828Z-resize-3x120-x24-axylo-canvas-vs-axylo-svg-2888.json\nbench/history/20261118T025045Z-resize-3x120-x24-uplot-vs-axylo-svg-0221.json\nreviews/2026-11-18/impl/wp/size.analysis.prompt.md\nreviews/2026-11-18/impl/wp/size.analysis.events.jsonl\nreviews/2026-11-18/impl/wp/size.analysis.md\nreviews/2026-11-18/impl/wp/dist.report.md\n","exit_code":0,"status":"completed"}}
