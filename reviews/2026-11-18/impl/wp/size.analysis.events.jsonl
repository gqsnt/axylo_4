{"type":"item.completed","item":{"id":"item_15","type":"command_execution","command":"/bin/bash -lc \"nl -ba scripts/pack.mjs | sed -n '1,150p'; nl -ba packages/axylo/src/index.ts; nl -ba packages/axylo/src/core/chart.ts\"","aggregated_output":"     1\t// Packs the two published packages as npm would publish them and installs the tarballs into the fixtures under\n     2\t// tests/dist/fixtures, without a registry (plan M7; spec DX1, DX7, DX8, DX10).\n     3\t//\n     4\t//   node scripts/pack.mjs             runs the root build first (npm run build)\n     5\t//   node scripts/pack.mjs --no-build  packs whatever packages/*/dist holds now\n     6\t//\n     7\t// Output (all git-ignored):\n     8\t//   tests/dist/.packed/<name>-<version>.tgz   the tarballs, exactly what `npm publish` would upload\n     9\t//   tests/dist/.packed/manifest.json          what npm pack reported (file list, integrity) per package\n    10\t//   tests/dist/fixtures/<fixture>/node_modules  the tarballs unpacked as an install would, plus links to the\n    11\t//                                               root node_modules for third-party packages (react, types)\n    12\t//   tests/dist/fixtures/<fixture>/example/    copies of examples/first-chart, so they resolve from the fixture\n    13\t//\n    14\t// The packages are unpacked, never linked: a fixture must reach `axylo` and `@axylo/react` only through the\n    15\t// packed files and their `exports`, never through the workspace symlinks in the root node_modules.\n    16\timport { execFileSync } from 'node:child_process';\n    17\timport fs from 'node:fs';\n    18\timport path from 'node:path';\n    19\timport { gunzipSync } from 'node:zlib';\n    20\t\n    21\tconst root = path.resolve(import.meta.dirname, '..');\n    22\tconst distTests = path.join(root, 'tests/dist');\n    23\tconst packed = path.join(distTests, '.packed');\n    24\tconst windows = process.platform === 'win32';\n    25\t\n    26\texport const PACKAGES = { axylo: 'packages/axylo', '@axylo/react': 'packages/react' };\n    27\t\n    28\t/** What each fixture installs. `links` come from the root node_modules: third-party code, not ours. */\n    29\texport const FIXTURES = {\n    30\t  npm: { packages: ['axylo'], links: [], examples: ['npm.ts'] },\n    31\t  script: { packages: ['axylo'], links: [], examples: ['script.html'] },\n    32\t  react: {\n    33\t    packages: ['axylo', '@axylo/react'],\n    34\t    links: ['react', 'react-dom', '@types/react', '@types/react-dom'],\n    35\t    examples: ['react.tsx'],\n    36\t  },\n    37\t};\n    38\t\n    39\tconst run = (command, args, options = {}) =>\n    40\t  execFileSync(windows ? `${command}.cmd` : command, args, { cwd: root, encoding: 'utf8', shell: windows, ...options });\n    41\t\n    42\t/** Extracts a gzipped tarball as npm writes it (ustar, with pax or GNU long names), dropping the `package/` prefix. */\n    43\texport function untar(tarball, destination) {\n    44\t  const buffer = gunzipSync(fs.readFileSync(tarball));\n    45\t  const written = [];\n    46\t  let offset = 0;\n    47\t  let longName = null;\n    48\t  while (offset + 512 <= buffer.length) {\n    49\t    const header = buffer.subarray(offset, offset + 512);\n    50\t    if (header.every(byte => byte === 0)) break;\n    51\t    const text = (start, length) => header.subarray(start, start + length).toString('utf8').replace(/\\0[\\s\\S]*$/, '');\n    52\t    const size = parseInt(text(124, 12).trim() || '0', 8);\n    53\t    const type = String.fromCharCode(header[156] || 48);\n    54\t    const body = buffer.subarray(offset + 512, offset + 512 + size);\n    55\t    offset += 512 + Math.ceil(size / 512) * 512;\n    56\t    if (type === 'x' || type === 'L') {\n    57\t      if (type === 'L') longName = body.toString('utf8').replace(/\\0[\\s\\S]*$/, '');\n    58\t      else for (const line of body.toString('utf8').split('\\n')) {\n    59\t        const match = /^\\d+ path=(.*)$/.exec(line);\n    60\t        if (match) longName = match[1];\n    61\t      }\n    62\t      continue;\n    63\t    }\n    64\t    if (type === 'g') continue;\n    65\t    const prefix = text(345, 155);\n    66\t    const name = longName ?? (prefix ? `${prefix}/${text(0, 100)}` : text(0, 100));\n    67\t    longName = null;\n    68\t    const relative = name.replace(/^package\\//, '');\n    69\t    // A tarball is input we did not write by hand: refuse anything that would land outside the destination.\n    70\t    if (path.isAbsolute(relative) || relative.split(/[\\\\/]/).includes('..')) throw new Error(`unsafe path in ${tarball}: ${name}`);\n    71\t    const target = path.join(destination, relative);\n    72\t    if (type === '5') { fs.mkdirSync(target, { recursive: true }); continue; }\n    73\t    if (type !== '0') throw new Error(`unexpected entry type ${JSON.stringify(type)} for ${name} in ${tarball}`);\n    74\t    fs.mkdirSync(path.dirname(target), { recursive: true });\n    75\t    fs.writeFileSync(target, body);\n    76\t    written.push(relative.split(path.sep).join('/'));\n    77\t  }\n    78\t  return written;\n    79\t}\n    80\t\n    81\tfunction link(fixtureModules, name) {\n    82\t  const source = path.join(root, 'node_modules', name);\n    83\t  if (!fs.existsSync(source)) throw new Error(`${name} is not installed in the root node_modules`);\n    84\t  const at = path.join(fixtureModules, name);\n    85\t  fs.mkdirSync(path.dirname(at), { recursive: true });\n    86\t  // A junction needs no privilege on Windows; the type is ignored elsewhere.\n    87\t  fs.symlinkSync(fs.realpathSync(source), at, 'junction');\n    88\t}\n    89\t\n    90\texport function pack({ build = true, log = console.log } = {}) {\n    91\t  if (build) run('npm', ['run', 'build'], { stdio: 'inherit' });\n    92\t  fs.rmSync(packed, { recursive: true, force: true });\n    93\t  fs.mkdirSync(packed, { recursive: true });\n    94\t\n    95\t  const manifest = { packedAt: new Date().toISOString(), packages: {} };\n    96\t  for (const [name, dir] of Object.entries(PACKAGES)) {\n    97\t    const out = run('npm', ['pack', '--json', '--ignore-scripts', '--pack-destination', packed], { cwd: path.join(root, dir) });\n    98\t    const [report] = JSON.parse(out);\n    99\t    manifest.packages[name] = {\n   100\t      directory: dir,\n   101\t      tarball: report.filename,\n   102\t      integrity: report.integrity,\n   103\t      size: report.size,\n   104\t      unpackedSize: report.unpackedSize,\n   105\t      files: report.files.map(f => f.path).sort(),\n   106\t    };\n   107\t    log(`packed ${report.filename}: ${report.files.length} files, ${report.size} bytes`);\n   108\t  }\n   109\t\n   110\t  for (const [fixture, plan] of Object.entries(FIXTURES)) {\n   111\t    const dir = path.join(distTests, 'fixtures', fixture);\n   112\t    const modules = path.join(dir, 'node_modules');\n   113\t    fs.rmSync(modules, { recursive: true, force: true });\n   114\t    fs.rmSync(path.join(dir, 'example'), { recursive: true, force: true });\n   115\t    for (const name of plan.packages) {\n   116\t      const files = untar(path.join(packed, manifest.packages[name].tarball), path.join(modules, name));\n   117\t      const expected = manifest.packages[name].files;\n   118\t      if (files.slice().sort().join('\\n') !== expected.join('\\n')) throw new Error(`${name}: unpacked files differ from npm pack's list`);\n   119\t    }\n   120\t    for (const name of plan.links) link(modules, name);\n   121\t    fs.mkdirSync(path.join(dir, 'example'), { recursive: true });\n   122\t    for (const file of plan.examples) fs.copyFileSync(path.join(root, 'examples/first-chart', file), path.join(dir, 'example', file));\n   123\t  }\n   124\t  fs.writeFileSync(path.join(packed, 'manifest.json'), JSON.stringify(manifest, null, 1));\n   125\t  log(`fixtures ready: ${Object.keys(FIXTURES).join(', ')}`);\n   126\t  return manifest;\n   127\t}\n   128\t\n   129\tif (path.resolve(process.argv[1] ?? '') === import.meta.filename) {\n   130\t  pack({ build: !process.argv.includes('--no-build') });\n   131\t}\n     1\t/**\n     2\t * Axylo's public entry points. Importing this module touches no DOM, so it loads in Node, where `validate`\n     3\t * runs; the chart functions need a document and are only called in a browser.\n     4\t */\n     5\timport type {\n     6\t  AreaOptions, BarOptions, Chart, Diagnostic, DonutOptions, LineOptions, ScatterOptions, Target,\n     7\t} from './public';\n     8\timport { createChart } from './core/chart';\n     9\timport { staticDiagnostics } from './core/stages';\n    10\timport { viewerTimeZone } from './core/environment';\n    11\t\n    12\texport type * from './public';\n    13\t\n    14\texport function line<Row>(target: Target, options: LineOptions<Row>): Chart<Row, LineOptions<Row>> {\n    15\t  return createChart('line', target, options) as unknown as Chart<Row, LineOptions<Row>>;\n    16\t}\n    17\t\n    18\texport function area<Row>(target: Target, options: AreaOptions<Row>): Chart<Row, AreaOptions<Row>> {\n    19\t  return createChart('area', target, options) as unknown as Chart<Row, AreaOptions<Row>>;\n    20\t}\n    21\t\n    22\texport function bar<Row>(target: Target, options: BarOptions<Row>): Chart<Row, BarOptions<Row>> {\n    23\t  return createChart('bar', target, options) as unknown as Chart<Row, BarOptions<Row>>;\n    24\t}\n    25\t\n    26\texport function scatter<Row>(target: Target, options: ScatterOptions<Row>): Chart<Row, ScatterOptions<Row>> {\n    27\t  return createChart('scatter', target, options) as unknown as Chart<Row, ScatterOptions<Row>>;\n    28\t}\n    29\t\n    30\texport function donut<Row>(target: Target, options: DonutOptions<Row>): Chart<Row, DonutOptions<Row>> {\n    31\t  return createChart('donut', target, options) as unknown as Chart<Row, DonutOptions<Row>>;\n    32\t}\n    33\t\n    34\t/**\n    35\t * Runs the synchronous stages of a create call without a DOM (option resolution, normalization, the view's\n    36\t * domain and series checks, naming) and returns the same call-origin diagnostics a created chart reports\n    37\t * (plan 1.6). Each chart type takes its own options, so an option that does not apply does not compile.\n    38\t */\n    39\texport function validate<Row>(type: 'line', options: LineOptions<Row>): Diagnostic[];\n    40\texport function validate<Row>(type: 'area', options: AreaOptions<Row>): Diagnostic[];\n    41\texport function validate<Row>(type: 'bar', options: BarOptions<Row>): Diagnostic[];\n    42\texport function validate<Row>(type: 'scatter', options: ScatterOptions<Row>): Diagnostic[];\n    43\texport function validate<Row>(type: 'donut', options: DonutOptions<Row>): Diagnostic[];\n    44\texport function validate(type: 'line' | 'area' | 'bar' | 'scatter' | 'donut', options: unknown): Diagnostic[] {\n    45\t  return staticDiagnostics(type, options, viewerTimeZone());\n    46\t}\n     1\t/**\n     2\t * `createChart`: the browser host of the controller (controller.ts). It resolves the target, builds the\n     3\t * figure, the mark and text renderers and the interaction layer, and connects the page's observers to the\n     4\t * controller. Every setup step registers its own cleanup as soon as it succeeded, so a failure part-way\n     5\t * through creation, or `destroy()`, leaves the target as it was (including the custom properties the theme\n     6\t * wrote on it).\n     7\t *\n     8\t * Document-level listeners (theme and environment watchers, the interaction layer's keyboard and pointer\n     9\t * listeners on the document) are released when the target leaves the document without `destroy()`, so a\n    10\t * forgotten chart does not stay reachable from the page, and are attached again if the target comes back.\n    11\t * Detachment is noticed by the observers the chart already has (the resize observer reports a zero box),\n    12\t * not by polling.\n    13\t */\n    14\timport type { MarkRenderer, Scene } from './contracts';\n    15\timport { createCanvasRenderer, createSvgRenderer, createTextLayer, type TextLayer } from '../render';\n    16\timport { ensureStyles, resolveTheme, watchTheme } from '../theme';\n    17\timport { createFigure, type Figure } from '../dom/figure';\n    18\timport { createInteraction, type Interaction } from '../dom/interaction';\n    19\timport type { DeliveryConsole } from './delivery';\n    20\timport { createMeasurer, noteFontLoad, readTextStyle, resolveLocale, viewerTimeZone, watchEnvironment } from './environment';\n    21\timport { createController, type ChartHandle, type ChartKind, type Controller, type ControllerActions } from './controller';\n    22\timport { object } from './stages';\n    23\t\n    24\texport type { BenchHook, ChartHandle, ChartKind, DevHook, Stage } from './controller';\n    25\t\n    26\texport interface ChartEnvironmentOverrides {\n    27\t  readonly console?: DeliveryConsole | null;\n    28\t}\n    29\t\n    30\t/** Suffixes of the ids a chart gives its elements (figure, interaction, table). */\n    31\tconst ID_SUFFIXES = ['', '-t', '-st', '-s', '-m', '-n', '-i', '-proxy', '-table', '-table-caption', '-table-jump', '-table-jump-error'];\n    32\tlet instances = 0;\n    33\t\n    34\t/** An id prefix none of whose element ids exist in the page yet (spec A1: ids unique per chart). */\n    35\tfunction allocateId(doc: Document): string {\n    36\t  for (;;) {\n    37\t    const id = `axylo-${++instances}`;\n    38\t    if (ID_SUFFIXES.every(suffix => doc.getElementById(id + suffix) === null)) return id;\n    39\t  }\n    40\t}\n    41\t\n    42\texport function createChart(kind: ChartKind, target: unknown, input: unknown, overrides: ChartEnvironmentOverrides = {}): ChartHandle {\n    43\t  const root = resolveTarget(target);\n    44\t  const doc = root.ownerDocument;\n    45\t  const win = doc.defaultView;\n    46\t  if (win === null) throw new Error('Axylo: the target element is not in a document with a window.');\n    47\t\n    48\t  // Cleanup in reverse order of setup; each step adds its own once it succeeded.\n    49\t  const cleanup: (() => void)[] = [];\n    50\t  const release = (): void => {\n    51\t    for (let fn = cleanup.pop(); fn; fn = cleanup.pop()) {\n    52\t      try {\n    53\t        fn();\n    54\t      } catch {\n    55\t        // Keep releasing the rest.\n    56\t      }\n    57\t    }\n    58\t  };\n    59\t\n    60\t  let controller: Controller | null = null;\n    61\t  try {\n    62\t    const requested = object(input).__renderer === 'canvas' ? 'canvas' : 'svg';\n    63\t    const id = allocateId(doc);\n    64\t\n    65\t    const renderer: MarkRenderer = requested === 'canvas' ? createCanvasRenderer(doc) : createSvgRenderer(doc);\n    66\t    cleanup.push(() => renderer.destroy());\n    67\t    const textLayer: TextLayer = createTextLayer(doc);\n    68\t    cleanup.push(() => textLayer.destroy());\n    69\t    const figure: Figure = createFigure(root, id, { marks: renderer.element, text: textLayer.element });\n    70\t    cleanup.push(() => figure.destroy());\n    71\t\n    72\t    // The interaction layer is built before the controller that answers it, so its actions forward late.\n    73\t    const actions: ControllerActions = {\n    74\t      zoom: w => controller?.actions.zoom(w),\n    75\t      toggle: k => controller?.actions.toggle(k),\n    76\t      pause: p => controller?.actions.pause(p),\n    77\t      select: r => controller?.actions.select(r),\n    78\t      hover: r => controller?.actions.hover(r),\n    79\t    };\n    80\t    const interaction: Interaction = createInteraction(figure, renderer, actions);\n    81\t    cleanup.push(() => interaction.destroy());\n    82\t    const measurer = createMeasurer(doc);\n    83\t    ensureStyles(doc);\n    84\t\n    85\t    // Watchers that the document holds; released while the target is out of the document.\n    86\t    let watching: (() => void) | null = null;\n    87\t    let watchedBefore = false;\n    88\t    const watch = (): void => {\n    89\t      if (watching || controller === null) return;\n    90\t      const c = controller;\n    91\t      if (watchedBefore) c.invalidate.page();\n    92\t      watchedBefore = true;\n    93\t      const stopTheme = watchTheme(root, () => c.invalidate.theme());\n    94\t      const stopEnvironment = watchEnvironment(win, {\n    95\t        pixelRatio: () => c.invalidate.pixelRatio(),\n    96\t        motion() {\n    97\t          // Nothing is animated yet (spec I5), so there is nothing to change.\n    98\t        },\n    99\t        fonts() {\n   100\t          noteFontLoad(doc);\n   101\t          c.invalidate.fonts();\n   102\t        },\n   103\t      });\n   104\t      interaction.attach();\n   105\t      watching = () => {\n   106\t        stopTheme();\n   107\t        stopEnvironment();\n   108\t        interaction.detach();\n   109\t      };\n   110\t    };\n   111\t    const unwatch = (): void => {\n   112\t      watching?.();\n   113\t      watching = null;\n   114\t    };\n   115\t    cleanup.push(unwatch);\n   116\t\n   117\t    const resizeObserver = new win.ResizeObserver(() => {\n   118\t      if (controller === null) return;\n   119\t      // A target taken out of the document reports a zero box: let go of the document until it returns.\n   120\t      if (!root.isConnected) {\n   121\t        unwatch();\n   122\t        return;\n   123\t      }\n   124\t      watch();\n   125\t      controller.invalidate.resize();\n   126\t    });\n   127\t    cleanup.push(() => resizeObserver.disconnect());\n   128\t\n   129\t    const timeZone = viewerTimeZone();\n   130\t    controller = createController(kind, input, {\n   131\t      id,\n   132\t      console: overrides.console === undefined ? (win.console as DeliveryConsole) : overrides.console,\n   133\t      page: doc,\n   134\t      timeZone,\n   135\t      renderer: {\n   136\t        kind: renderer.kind,\n   137\t        draw: (scene: Scene, bindings, theme, ratio) => renderer.draw(scene, bindings, theme, ratio),\n   138\t      },\n   139\t      text: textLayer,\n   140\t      figure,\n   141\t      interaction,\n   142\t      measurer,\n   143\t      requestFrame: callback => win.requestAnimationFrame(callback),\n   144\t      cancelFrame: handle => win.cancelAnimationFrame(handle),\n   145\t      locale: option => resolveLocale(option, doc),\n   146\t      pageLang() {\n   147\t        const lang = root.closest('[lang]')?.getAttribute('lang')?.trim();\n   148\t        return lang ? lang : null;\n   149\t      },\n   150\t      labelText(own) {\n   151\t        const el = doc.getElementById(own);\n   152\t        return el === null ? null : el.textContent ?? '';\n   153\t      },\n   154\t      textStyle: () => readTextStyle(textLayer.element),\n   155\t      measure() {\n   156\t        if (!root.isConnected) return null;\n   157\t        const box = figure.figure.getBoundingClientRect();\n   158\t        if (box.width <= 0 && box.height <= 0) return null;\n   159\t        const plot = figure.plot.getBoundingClientRect();\n   160\t        // When the plot is squeezed to nothing, how far the rest overflows the figure is how much room is\n   161\t        // missing; that keeps the L8 decision continuous below zero.\n   162\t        const overflow = plot.height < 1 ? Math.max(0, figure.figure.scrollHeight - figure.figure.clientHeight) : 0;\n   163\t        return { width: plot.width, height: plot.height - overflow };\n   164\t      },\n   165\t      devicePixelRatio: () => win.devicePixelRatio || 1,\n   166\t      // Scoped to this chart's own figure: properties and the scheme go with it (finding 10).\n   167\t      theme: (keys, colors) => resolveTheme(figure.figure, keys, colors),\n   168\t      surfaces(visible) {\n   169\t        // Hidden without drawing: the error revision does not depend on the methods that may have failed.\n   170\t        for (const el of [renderer.element, textLayer.element]) (el as HTMLElement).style.visibility = visible ? '' : 'hidden';\n   171\t      },\n   172\t      dispose: release,\n   173\t    });\n   174\t    resizeObserver.observe(figure.plot);\n   175\t    resizeObserver.observe(figure.figure);\n   176\t    if (root.isConnected) watch();\n   177\t    return controller.handle;\n   178\t  } catch (error) {\n   179\t    // A rejected strict create, or a failure part-way through: nothing stays behind, a controller that was\n   180\t    // already created (its first frame queued) included (review 3, finding 9).\n   181\t    const created = controller as Controller | null;\n   182\t    controller = null;\n   183\t    try { created?.handle.destroy(); } catch { /* releasing the rest matters more */ }\n   184\t    release();\n   185\t    throw error;\n   186\t  }\n   187\t}\n   188\t\n   189\tfunction resolveTarget(target: unknown): HTMLElement {\n   190\t  if (typeof target === 'string') {\n   191\t    const doc = (globalThis as { document?: Document }).document;\n   192\t    if (!doc) throw new Error(`Axylo: no document to find the target ${JSON.stringify(target)} in.`);\n   193\t    let found: Element | null = null;\n   194\t    try {\n   195\t      found = doc.querySelector(target);\n   196\t    } catch {\n   197\t      throw new Error(`Axylo: the target selector ${JSON.stringify(target)} is not a valid CSS selector.`);\n   198\t    }\n   199\t    if (!found) throw new Error(`Axylo: the target selector ${JSON.stringify(target)} matches no element.`);\n   200\t    return found as HTMLElement;\n   201\t  }\n   202\t  if (target !== null && typeof target === 'object' && (target as Node).nodeType === 1) return target as HTMLElement;\n   203\t  throw new Error('Axylo: the target must be a CSS selector or an element.');\n   204\t}\n","exit_code":0,"status":"completed"}}
