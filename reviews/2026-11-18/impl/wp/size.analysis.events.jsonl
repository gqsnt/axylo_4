undefined, included, 'The affected points are not drawn.');\n   354\t  const isMissing = (row: number) => values.slot[row] === SLOT_NULL || values.slot[row] === SLOT_ABSENT_FIELD;\n   355\t  if (value.missing === 'zero') {\n   356\t    for (let row = 0; row < values.slot.length; row++) {\n   357\t      if (isMissing(row)) values.slot[row] = SLOT_VALUE;\n   358\t    }\n   359\t  }\n   360\t  const series = members.map(group => {\n   361\t    const length = group.order?.length ?? x.positions.length;\n   362\t    if (!group.order && values.y instanceof Float64Array && values.slot.every(slot => slot === SLOT_VALUE)) {\n   363\t      return {\n   364\t        key: group.key, label: group.label, drawable: true, x: x.positions, y: values.y,\n   365\t        row: table.columns ? null : sourceRows(table),\n   366\t      };\n   367\t    }\n   368\t    const rows = new Int32Array(length);\n   369\t    let next = 0;\n   370\t    let missing = 0;\n   371\t    for (let i = 0; i < length; i++) {\n   372\t      const row = group.order?.[i] ?? i;\n   373\t      if (values.slot[row] === SLOT_VALUE) rows[next++] = row;\n   374\t      else if (isMissing(row)) missing++;\n   375\t    }\n   376\t    const missingX = missing ? new Float64Array(missing) : undefined;\n   377\t    if (missingX) {\n   378\t      let index = 0;\n   379\t      for (let i = 0; i < length; i++) {\n   380\t        const row = group.order?.[i] ?? i;\n   381\t        if (isMissing(row)) missingX[index++] = x.positions[row]!;\n   382\t      }\n   383\t    }\n   384\t    const kept = rows.subarray(0, next);\n   385\t    kept.sort((a, b) => x.positions[a]! - x.positions[b]! || values.y[a]! - values.y[b]!);\n   386\t    return {\n   387\t      key: group.key, label: group.label, drawable: true, missingX,\n   388\t      x: Float64Array.from(kept, row => x.positions[row]!), y: Float64Array.from(kept, row => values.y[row]!), row: Int32Array.from(kept, table.rowIndex),\n   389\t    };\n   390\t  });\n   391\t\n   392\t  return {\n   393\t    ...base(options.table, version), shape: 'points', xKind: x.parser.kind === 'category' ? 'number' : x.parser.kind,\n   394\t    timeZone: x.parser.timeZone, series, xLabel: options.x.label, yLabel: value.label, xUnit: options.x.unit, yUnit: value.unit,\n   395\t  };\n   396\t}\n   397\t\n   398\tfunction donutFrame(options: ResolvedOptions, sink: DiagnosticSink, version: FrameVersion): DonutFrame {\n   399\t  const { table, x } = options;\n   400\t  const field = options.values[0]!;\n   401\t  const labels: string[] = [];\n   402\t  const seen = new Set<string>();\n   403\t  const issues = new Reports(x.field, sink);\n   404\t  const negatives = new Reports(field.field, sink);\n   405\t  const rows = new Int32Array(table.length);\n   406\t  const included = new Uint8Array(table.length);\n   407\t  for (let i = 0; i < table.length; i++) {\n   408\t    const raw = table.read(i, x.field);\n   409\t    const name = nameOf(raw);\n   410\t    if (name === null) {\n   411\t      if (Number.isNaN(raw) && table.isColumnRow(i)) continue;\n   412\t      if (raw === undefined) issues.add('AX102', 'omitted', table.rowIndex(i), undefined, undefined, { outcome: 'The affected slice is not drawn.' });\n   413\t      else issues.add('AX107', 'omitted', table.rowIndex(i), raw, 'Supply a label for each donut value.');\n   414\t    } else {\n   415\t      if (seen.has(name)) issues.add('AX108', 'chart-error', table.rowIndex(i), name);\n   416\t      seen.add(name);\n   417\t      rows[labels.length] = i;\n   418\t      labels.push(name);\n   419\t      included[i] = 1;\n   420\t    }\n   421\t  }\n   422\t  issues.flush(sink);\n   423\t  const order = rows.subarray(0, labels.length);\n   424\t  const values = readValues(table, field, sink, true, 0, undefined, i => included[i] === 1);\n   425\t  const provenance = table.columns && order.length === table.length && field.missing !== 'zero'\n   426\t    ? null : Int32Array.from(order, table.rowIndex);\n   427\t  for (let i = 0; i < order.length; i++) {\n   428\t    const row = order[i]!;\n   429\t    const value = values.y[row]!;\n   430\t    if (value < 0) negatives.add('AX120', 'chart-error', table.rowIndex(row), value);\n   431\t    if (field.missing === 'zero' && (values.slot[row] === SLOT_NULL || values.slot[row] === SLOT_ABSENT_FIELD)) {\n   432\t      values.slot[row] = SLOT_VALUE;\n   433\t      provenance![i] = -1;\n   434\t    }\n   435\t  }\n   436\t  negatives.flush(sink);\n   437\t  const allRows = order.length === table.length;\n   438\t  return {\n   439\t    ...base(table, version), shape: 'donut', labels,\n   440\t    values: allRows && values.y instanceof Float64Array ? values.y : Float64Array.from(order, row => values.y[row]!),\n   441\t    slot: allRows ? values.slot : Uint8Array.from(order, row => values.slot[row]!),\n   442\t    row: provenance,\n   443\t    valueLabel: field.label, unit: field.unit, valueScale: field.scale,\n   444\t  };\n   445\t}\n   446\t\n   447\tinterface AlignedSeed {\n   448\t  readonly options: ResolvedOptions;\n   449\t  readonly type: AlignedChartType;\n   450\t  readonly x: XData;\n   451\t  readonly counts: Map<string, ValueCounts>;\n   452\t  readonly diagnostics: StreamDiagnostics;\n   453\t}\n   454\t\n   455\tconst alignedSeeds = new WeakMap<AlignedFrame, AlignedSeed>();\n   456\t\n   457\texport function alignedSeed(frame: AlignedFrame): AlignedSeed | undefined {\n   458\t  return alignedSeeds.get(frame);\n   459\t}\n   460\t\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/src/theme/styles.ts; nl -ba packages/axylo/src/messages/index.ts; nl -ba packages/axylo/src/diagnostics/registry.ts | sed -n '1,228p'\"","aggregated_output":"     1\t/**\n     2\t * Applies the default stylesheet (plan 2.4) to the root a chart lives in: its document, or the shadow root\n     3\t * that contains it (a document's sheets do not reach into a shadow tree).\n     4\t *\n     5\t * - Normally a constructable stylesheet is adopted (`adoptedStyleSheets`); no `<style>` element is created.\n     6\t * - A root that already has the standalone dist/axylo.css active gets nothing. \"Active\" is checked by its\n     7\t *   effect (a probe element picks up the sheet's own rules), not by trusting a sentinel property, and is\n     8\t *   checked again on later calls, so a sheet that was removed or disabled is replaced.\n     9\t * - Only where constructable or adopted stylesheets are missing is one `<style>` element inserted instead.\n    10\t *   This is the only case in which the library creates a style element.\n    11\t */\n    12\timport { AXYLO_CSS } from './css';\n    13\t\n    14\ttype StyleRoot = Document | ShadowRoot;\n    15\t\n    16\ttype Installed =\n    17\t  | { readonly kind: 'adopted'; readonly sheet: CSSStyleSheet }\n    18\t  | { readonly kind: 'element'; readonly element: HTMLStyleElement }\n    19\t  | { readonly kind: 'standalone'; readonly sheet: CSSStyleSheet | null };\n    20\t\n    21\tconst installed = new WeakMap<StyleRoot, Installed>();\n    22\t/** One constructed sheet per document, shared by its document and shadow roots. */\n    23\tconst constructed = new WeakMap<Document, CSSStyleSheet>();\n    24\t\n    25\t/**\n    26\t * Makes the default styles apply to `root` (a Document or a ShadowRoot). Safe to call any number of times;\n    27\t * after the first call it costs a few property reads unless the sheet it relied on has gone away.\n    28\t */\n    29\texport function ensureStyles(root: StyleRoot): void {\n    30\t  const state = installed.get(root);\n    31\t  if (state !== undefined && stillActive(root, state)) return;\n    32\t  const doc = 'ownerDocument' in root && root.ownerDocument !== null ? root.ownerDocument : (root as Document);\n    33\t  const win = doc.defaultView;\n    34\t  if (win === null) return;\n    35\t\n    36\t  const standalone = findStandalone(root, doc, win);\n    37\t  if (standalone !== undefined) { installed.set(root, { kind: 'standalone', sheet: standalone }); return; }\n    38\t\n    39\t  if (canAdopt(root, win)) {\n    40\t    let sheet = constructed.get(doc);\n    41\t    if (sheet === undefined) {\n    42\t      // The constructor must come from the document's own window, or adopting the sheet throws.\n    43\t      sheet = new win.CSSStyleSheet();\n    44\t      sheet.replaceSync(AXYLO_CSS);\n    45\t      constructed.set(doc, sheet);\n    46\t    }\n    47\t    const list = (root as { adoptedStyleSheets: CSSStyleSheet[] }).adoptedStyleSheets;\n    48\t    if (!list.includes(sheet)) (root as { adoptedStyleSheets: CSSStyleSheet[] }).adoptedStyleSheets = [...list, sheet];\n    49\t    installed.set(root, { kind: 'adopted', sheet });\n    50\t    return;\n    51\t  }\n    52\t\n    53\t  const element = doc.createElement('style');\n    54\t  element.setAttribute('data-axylo-styles', '');\n    55\t  element.textContent = AXYLO_CSS;\n    56\t  if (root === doc) (doc.head ?? doc.documentElement).appendChild(element);\n    57\t  else root.insertBefore(element, root.firstChild);\n    58\t  installed.set(root, { kind: 'element', element });\n    59\t}\n    60\t\n    61\tfunction stillActive(root: StyleRoot, state: Installed): boolean {\n    62\t  switch (state.kind) {\n    63\t    case 'adopted': return (root as { adoptedStyleSheets?: CSSStyleSheet[] }).adoptedStyleSheets?.includes(state.sheet) ?? false;\n    64\t    case 'element': return state.element.isConnected && state.element.sheet !== null && !state.element.sheet.disabled;\n    65\t    case 'standalone': {\n    66\t      if (state.sheet === null) return false; // not identifiable: verify by effect again\n    67\t      const owner = state.sheet.ownerNode;\n    68\t      return !state.sheet.disabled && owner !== null && owner.isConnected && Array.prototype.includes.call(root.styleSheets, state.sheet);\n    69\t    }\n    70\t  }\n    71\t}\n    72\t\n    73\tfunction canAdopt(root: StyleRoot, win: Window): boolean {\n    74\t  if (!('adoptedStyleSheets' in root)) return false;\n    75\t  const Sheet = (win as unknown as { CSSStyleSheet?: { new(): CSSStyleSheet; prototype: Partial<CSSStyleSheet> } }).CSSStyleSheet;\n    76\t  if (typeof Sheet !== 'function' || typeof Sheet.prototype.replaceSync !== 'function') return false;\n    77\t  try { new Sheet(); } catch { return false; }\n    78\t  return true;\n    79\t}\n    80\t\n    81\t/**\n    82\t * The standalone sheet if it is in effect in `root`: undefined if not, null if in effect but not\n    83\t * identifiable (a cross-origin sheet whose rules cannot be read). In effect means a probe chart root picks\n    84\t * up a private token and a mark rule that only this stylesheet defines; custom properties alone could be\n    85\t * inherited from outside a shadow root, so a non-inherited property is checked as well.\n    86\t */\n    87\tfunction findStandalone(root: StyleRoot, doc: Document, win: Window): CSSStyleSheet | null | undefined {\n    88\t  const probe = doc.createElement('div');\n    89\t  probe.className = 'axylo';\n    90\t  probe.style.setProperty('display', 'none');\n    91\t  const mark = doc.createElement('div');\n    92\t  mark.className = 'axylo-svg';\n    93\t  probe.appendChild(mark);\n    94\t  (root === doc ? doc.documentElement : root).appendChild(probe);\n    95\t  const token = win.getComputedStyle(probe).getPropertyValue('--axylo-default-background').trim();\n    96\t  const rule = win.getComputedStyle(mark).position;\n    97\t  probe.remove();\n    98\t  if (token === '' || rule !== 'absolute') return undefined;\n    99\t  for (const sheet of Array.from(root.styleSheets)) {\n   100\t    try {\n   101\t      for (const r of Array.from(sheet.cssRules)) if (r.cssText.includes('--axylo-stylesheet')) return sheet;\n   102\t    } catch {\n   103\t      // Cross-origin: its rules cannot be read.\n   104\t    }\n   105\t  }\n   106\t  return null;\n   107\t}\n     1\timport type { DatumRef, Formatters, Lookup } from '../core/contracts';\n     2\timport type { Messages } from '../public';\n     3\t\n     4\tconst chartSummary = '{type} chart with {seriesCount} series. {xLabel} from {xMin} to {xMax}.';\n     5\tconst fullChartSummary = chartSummary + ' {yLabel} from {yMin} to {yMax}.';\n     6\tconst donutSlice = '{label}: {value} ({percent}).';\n     7\t\n     8\texport const defaultMessages: Messages = {\n     9\t  viewAsTable: 'View as table',\n    10\t  hideTable: 'Hide table',\n    11\t  noData: 'No data',\n    12\t  noObservation: 'No observation',\n    13\t  incompleteStack: 'incomplete',\n    14\t  moreRows: '+{count} more',\n    15\t  otherSlices: 'Other ({count})',\n    16\t  valuesNotShown: 'Values not shown: {count}. {seeTable}',\n    17\t  valuesChanged: 'Values shown differently from the data: {count}. {seeTable}',\n    18\t  labelsHidden: 'Some labels hidden. {seeTable}',\n    19\t  loading: 'Loading chart.',\n    20\t  empty: 'No data to show.',\n    21\t  error: 'The chart could not be drawn.',\n    22\t  internalError: 'Something went wrong while drawing the chart.',\n    23\t  chartName: '{type} chart of {y} by {x}',\n    24\t  chartSummary: fullChartSummary,\n    25\t  seriesSummary: '{series}: minimum {min}, maximum {max}, last {last}.',\n    26\t  // Deprecated. Retained for callers with an existing override.\n    27\t  referenceSummary: 'Reference: {label}.',\n    28\t  timeZoneNote: 'Times are shown in {zone}.',\n    29\t  plotLabel: 'Chart plot',\n    30\t  controlsLabel: 'Chart controls',\n    31\t  pointOf: '{series}, {x}, {value}. Point {index} of {count}.',\n    32\t  zoomIn: 'Zoom in',\n    33\t  zoomOut: 'Zoom out',\n    34\t  resetZoom: 'Reset zoom',\n    35\t  pause: 'Pause',\n    36\t  resume: 'Resume',\n    37\t  previousPage: 'Previous page',\n    38\t  nextPage: 'Next page',\n    39\t  pageOf: 'Page {page} of {count}',\n    40\t  jumpToX: 'Jump to {x}',\n    41\t  showSeries: 'Show {series}',\n    42\t  hideSeries: 'Hide {series}',\n    43\t  category: 'Category',\n    44\t  percentage: 'Percentage',\n    45\t  series: 'Series',\n    46\t  value: 'Value',\n    47\t  typeLine: 'Line',\n    48\t  typeArea: 'Area',\n    49\t  typeBar: 'Bar',\n    50\t  typeScatter: 'Scatter',\n    51\t  typeDonut: 'Donut',\n    52\t  donutSummary: '{type} chart with {count} slices. Total {total}.',\n    53\t  seriesNoData: '{series}: no data.',\n    54\t  seriesNotDrawn: '{series} could not be drawn. {seeTable}',\n    55\t  referenceLine: 'Reference line {label} at {from}.',\n    56\t  referenceBand: 'Reference band {label} from {from} to {to}.',\n    57\t  plotRole: '{type} chart',\n    58\t  pointAll: '{x}. {values}. {position}',\n    59\t  seriesValue: '{series} {value}',\n    60\t  position: 'Point {index} of {count}',\n    61\t  total: 'Total',\n    62\t  panLeft: 'Pan left',\n    63\t  panRight: 'Pan right',\n    64\t  jumpNotFound: 'No row matches {x}. Example: {example}',\n    65\t  plotInstructions: 'Left and right arrows move between points, up and down between series, and Enter selects. Plus and minus zoom; 0 resets.',\n    66\t  seeTable: 'See table.',\n    67\t};\n    68\t\n    69\texport function fill(template: string, values: Readonly<Record<string, string | number>>): string {\n    70\t  return template.replace(/\\{(\\w+)\\}/g, (placeholder: string, name: string) =>\n    71\t    Object.hasOwn(values, name) ? String(values[name]) : placeholder,\n    72\t  );\n    73\t}\n    74\t\n    75\texport function resolveMessages(overrides?: Partial<Messages> | null): Messages {\n    76\t  const messages = { ...defaultMessages };\n    77\t  for (const key of Object.keys(messages) as (keyof Messages)[]) {\n    78\t    messages[key] = overrides?.[key] ?? messages[key];\n    79\t  }\n    80\t  return messages;\n    81\t}\n    82\t\n    83\texport function fillChartSummary(\n    84\t  template: string, values: Readonly<Record<string, string>>, range: { readonly yMin: string; readonly yMax: string } | null,\n    85\t): string {\n    86\t  if (range) return fill(template, { ...values, ...range });\n    87\t  // When a translation uses the same placeholders, omit the sentence that would describe the missing range.\n    88\t  const withoutRange = template === fullChartSummary ? chartSummary\n    89\t    : template.match(/[^.!?。！？]+[.!?。！？]*|[.!?。！？]+/gu)?.filter(part => !/\\{y(?:Min|Max)\\}/.test(part)).join('').trim();\n    90\t  return fill(withoutRange || chartSummary, values);\n    91\t}\n    92\t\n    93\texport function fillDonutSlice(label: string, value: string, percent: string): string {\n    94\t  return fill(donutSlice, { label, value, percent });\n    95\t}\n    96\t\n    97\texport function pointOf(lookup: Lookup, ref: DatumRef, formatters: Formatters, messages: Messages): string | null {\n    98\t  const ordinal = lookup.ordinal(ref);\n    99\t  if (ordinal < 0) return null;\n   100\t  const datum = lookup.datum(ref);\n   101\t  if (!datum) return null;\n   102\t  return fill(messages.pointOf, {\n   103\t    series: datum.seriesLabel, x: datum.x, value: datum.value,\n   104\t    index: formatters.count(ordinal + 1), count: formatters.count(lookup.count),\n   105\t  });\n   106\t}\n     1\timport type { DiagnosticEffect, DiagnosticInput, DiagnosticSink } from '../core/contracts';\n     2\timport type { Diagnostic } from '../public';\n     3\t\n     4\texport interface DiagnosticDetails {\n     5\t  readonly field?: string;\n     6\t  rea