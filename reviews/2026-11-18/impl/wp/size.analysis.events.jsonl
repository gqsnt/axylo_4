(plot), xTicks: [], yTicks: [], texts: [], fit: { x: UNCHANGED, y: UNCHANGED } };\n   229\t  }\n   230\t  if (width < MIN_WIDTH + 2 * INSET || height < MIN_HEIGHT + 2 * INSET) return tooSmall(size);\n   231\t  const text = metrics(input);\n   232\t  const layout = layoutAxes(input, size, text, true);\n   233\t  // A title may need the space otherwise reserved for ticks at the ends of the left axis.\n   234\t  return layout.kind === 'too-small' ? layoutAxes(input, size, text, false) : layout;\n   235\t}\n     1\timport { SLOT_NULL, SLOT_VALUE } from '../core/contracts';\n     2\timport type { AlignedView, DatumRef, DatumText, Formatters, Lookup, SlotState } from '../core/contracts';\n     3\timport type { Messages } from '../public';\n     4\timport { clipBox, contains, pointBox, type PlotLayout } from './geometry';\n     5\timport { lowerBound, pageDistance } from './search';\n     6\timport { incomplete, slotText } from './text';\n     7\t\n     8\tconst TOOLTIP_LIMIT = 8;\n     9\t\n    10\tfunction clamp(n: number, lo: number, hi: number): number {\n    11\t  return Math.max(lo, Math.min(hi, n));\n    12\t}\n    13\t\n    14\texport function alignedLookup(view: AlignedView, layout: PlotLayout | null, formatters: Formatters, messages: Messages): Lookup {\n    15\t  const { frame, visibleSlots: { start, end }, stack } = view;\n    16\t  const positions = frame.x.values;\n    17\t  const visible = frame.series.flatMap((series, s) => view.visible[s] && series.drawable ? [s] : []);\n    18\t  const keys = new Map(frame.series.map((series, s) => [series.key, s]));\n    19\t  const projection = layout?.projection;\n    20\t  const xScale = projection?.kind === 'xy' ? projection.x : projection?.kind === 'bands' ? projection.band : null;\n    21\t\n    22\t  function ref(s: number, i: number): DatumRef {\n    23\t    return { kind: 'aligned', seriesKey: frame.series[s]!.key, x: positions[i]! };\n    24\t  }\n    25\t\n    26\t  function index(x: number): number {\n    27\t    const i = lowerBound(positions, x);\n    28\t    return positions[i] === x ? i : -1;\n    29\t  }\n    30\t\n    31\t  function isValue(s: number, i: number): boolean {\n    32\t    return frame.series[s]!.slot[i] === SLOT_VALUE;\n    33\t  }\n    34\t\n    35\t  function seek(s: number, i: number, delta: 1 | -1, lo = start, hi = end): number {\n    36\t    for (; i >= lo && i < hi; i += delta) if (isValue(s, i)) return i;\n    37\t    return -1;\n    38\t  }\n    39\t\n    40\t  function first(): DatumRef | null {\n    41\t    let earliest = end;\n    42\t    let series = -1;\n    43\t    for (const s of visible) {\n    44\t      const i = seek(s, start, 1, start, earliest);\n    45\t      if (i >= 0) {\n    46\t        earliest = i;\n    47\t        series = s;\n    48\t      }\n    49\t    }\n    50\t    return series < 0 ? null : ref(series, earliest);\n    51\t  }\n    52\t\n    53\t  function write(s: number, i: number, announce = false): DatumText {\n    54\t    const series = frame.series[s]!;\n    55\t    const state = series.slot[i] as SlotState;\n    56\t    const value = slotText(formatters, s, series.y[i]!, state);\n    57\t    return {\n    58\t      ref: ref(s, i), seriesIndex: s, seriesLabel: series.label, x: formatters.x(positions[i]!),\n    59\t      value: announce && stack?.incomplete?.[i] && visible.includes(s) ? incomplete(value, messages) : value,\n    60\t      state, percent: null, row: series.row?.[i] ?? i,\n    61\t    };\n    62\t  }\n    63\t\n    64\t  function primary(i: number): DatumRef | null {\n    65\t    if (i < start || i >= end) return null;\n    66\t    const s = visible.find(s => isValue(s, i)) ?? visible[0];\n    67\t    return s === undefined ? null : ref(s, i);\n    68\t  }\n    69\t\n    70\t  function resolve(datum: DatumRef): DatumRef | null {\n    71\t    if (datum.kind !== 'aligned') return null;\n    72\t    const s = keys.get(datum.seriesKey);\n    73\t    if (s === undefined) return null;\n    74\t    const i = lowerBound(positions, datum.x);\n    75\t    const inView = i >= start && i < end && positions[i] === datum.x;\n    76\t    if (!view.visible[s] || !frame.series[s]!.drawable) {\n    77\t      return inView && !view.visible[s] ? primary(i) : null;\n    78\t    }\n    79\t    if (inView) return datum;\n    80\t    const next = seek(s, Math.max(i, start), 1);\n    81\t    const replacement = next >= 0 ? next : seek(s, Math.min(i - 1, end - 1), -1);\n    82\t    return replacement < 0 ? null : ref(s, replacement);\n    83\t  }\n    84\t\n    85\t  function nearestSlot(pixel: number): number {\n    86\t    if (!xScale || start === end) return -1;\n    87\t    const x = xScale.invert(pixel);\n    88\t    if (xScale.type === 'band') return x >= start && x < end ? x : -1;\n    89\t    const right = lowerBound(positions, x, start, end);\n    90\t    if (right === start) return start;\n    91\t    if (right === end) return end - 1;\n    92\t    // Use screen distances for the final comparison because inversion can round at a midpoint.\n    93\t    const leftPixel = xScale.map(positions[right - 1]!);\n    94\t    const rightPixel = xScale.map(positions[right]!);\n    95\t    const midpoint = leftPixel / 2 + rightPixel / 2;\n    96\t    return (leftPixel <= rightPixel ? pixel >= midpoint : pixel <= midpoint) ? right : right - 1;\n    97\t  }\n    98\t\n    99\t  return {\n   100\t    pick(px, py) {\n   101\t      if (!layout || !visible.length || !contains(layout.plot, px, py)) return null;\n   102\t      const i = nearestSlot(projection?.kind === 'bands' && projection.horizontal ? py : px);\n   103\t      return i < 0 ? null : { kind: 'x', x: positions[i]! };\n   104\t    },\n   105\t    tooltip(target) {\n   106\t      const i = target.kind === 'x' ? index(target.x) : -1;\n   107\t      if (i < start || i >= end) return { title: '', rows: [], count: 0, total: null };\n   108\t      let total: string | null = null;\n   109\t      if (stack && stack.order.length) {\n   110\t