{"type":"item.completed","item":{"id":"item_29","type":"command_execution","command":"/bin/bash -lc \"nl -ba packages/axylo/src/data/normalize.ts | sed -n '1,460p'\"","aggregated_output":"     1\timport {\n     2\t  SLOT_ABSENT_FIELD, SLOT_GAP, SLOT_NO_ROW, SLOT_NULL, SLOT_VALUE,\n     3\t  type AlignedFrame, type DiagnosticSink, type DonutFrame, type Environment, type Frame, type PointFrame,\n     4\t  type RowSource, type Series, type XColumn,\n     5\t} from '../core/contracts';\n     6\timport { report, type DiagnosticDetails } from '../diagnostics';\n     7\timport type { AlignedChartType, ChartType, ResolvedOptions, ResolvedValueField } from './options';\n     8\timport { Reports } from './reports';\n     9\timport { calendarIntervals, inferGaps, snapGap } from './steps';\n    10\timport { recordDiagnostics, StreamDiagnostics, type DiagnosticTrace } from './store-diagnostics';\n    11\timport type { Table } from './table';\n    12\timport { readValues, type ValueCounts, type Values } from './values';\n    13\timport { dateUnitOf, inferKind, nameOf, positionName, XParser, type DateUnit } from './x';\n    14\t\n    15\texport type DataEnvironment = Pick<Environment, 'timeZone'>;\n    16\texport interface FrameVersion { readonly epoch: number; readonly revision: number }\n    17\t\n    18\tfunction base(source: RowSource, version: FrameVersion) {\n    19\t  return { epoch: version.epoch, revision: version.revision, source };\n    20\t}\n    21\t\n    22\tfunction sourceRows(table: Table): Int32Array {\n    23\t  const rows = new Int32Array(table.length);\n    24\t  for (let i = 0; i < rows.length; i++) rows[i] = table.rowIndex(i);\n    25\t  return rows;\n    26\t}\n    27\t\n    28\texport interface XData {\n    29\t  readonly parser: XParser;\n    30\t  readonly positions: Float64Array;\n    31\t  readonly order: Int32Array | null;\n    32\t  readonly dateUnits: Record<DateUnit, number> | null;\n    33\t}\n    34\t\n    35\texport function readX(type: ChartType, options: ResolvedOptions, env: DataEnvironment, sink: DiagnosticSink, categories?: readonly string[]): XData {\n    36\t  const { x, table } = options;\n    37\t  const kind = x.type ?? inferKind(table, x.field, options.series) ?? (categories ? 'category' : 'number');\n    38\t  const parser = new XParser(x, kind, env, type === 'scatter', categories);\n    39\t  const reports = new Reports(x.field, sink);\n    40\t  const dateUnits = kind === 'date' ? { day: 0, month: 0, year: 0 } : null;\n    41\t  const input = table.columns?.[x.field];\n    42\t  let positions = input instanceof Float64Array && (kind === 'number' || kind === 'time')\n    43\t    ? input : new Float64Array(table.length);\n    44\t  let ascending = true;\n    45\t  let last = -Infinity;\n    46\t  let i = 0;\n    47\t  if (options.series === null && input instanceof Float64Array && kind === 'number') {\n    48\t    // Skip parsing the strictly ascending numeric prefix, stopping before any row that can report a hint.\n    49\t    const inferred = x.type === null;\n    50\t    for (; i < table.length; i++) {\n    51\t      const value = input[i]!;\n    52\t      if (!(value > last && value < Infinity) || inferred && Math.abs(value) >= 1e11 && Math.abs(value) < 1e14) break;\n    53\t      last = value;\n    54\t    }\n    55\t  }\n    56\t  let valid = i;\n    57\t  for (; i < table.length; i++) {\n    58\t    const usableSeries = options.series === null || nameOf(table.read(i, options.series)) !== null;\n    59\t    const raw = usableSeries ? input === undefined ? table.read(i, x.field) : input[i] : undefined;\n    60\t    const value = usableSeries && !(Number.isNaN(raw) && table.isColumnRow(i))\n    61\t      ? parser.read(raw, table.rowIndex(i), reports, options.values.length) : NaN;\n    62\t    if (positions === input && !Object.is(positions[i], value)) positions = positions.slice();\n    63\t    if (positions !== input) positions[i] = value;\n    64\t    if (!Number.isFinite(value)) {\n    65\t      ascending = false;\n    66\t      continue;\n    67\t    }\n    68\t    if (!(value > last)) ascending = false;\n    69\t    if (dateUnits) dateUnits[dateUnitOf(raw)]++;\n    70\t    last = value;\n    71\t    valid++;\n    72\t  }\n    73\t  reports.flush(sink);\n    74\t  if (ascending) return { parser, positions, order: null, dateUnits };\n    75\t\n    76\t  const order = new Int32Array(valid);\n    77\t  let next = 0;\n    78\t  for (let i = 0; i < positions.length; i++) if (Number.isFinite(positions[i])) order[next++] = i;\n    79\t  order.sort((a, b) => positions[a]! - positions[b]!);\n    80\t  return { parser, positions, order, dateUnits };\n    81\t}\n    82\t\n    83\texport function reportCalendarDates(x: XData, table: Table, sink: DiagnosticSink): void {\n    84\t  if (x.parser.kind !== 'time') return;\n    85\t  const length = x.order?.length ?? x.positions.length;\n    86\t  if (length < 2) return;\n    87\t  const first = x.positions[x.order?.[0] ?? 0]!;\n    88\t  let last = first;\n    89\t  const zone = x.parser.timeZone ?? 'UTC';\n    90\t  let matches = 3;\n    91\t  for (let i = 1; i < length; i++) {\n    92\t    const position = x.positions[x.order?.[i] ?? i]!;\n    93\t    if (position === last) continue;\n    94\t    matches &= calendarIntervals(last, position, zone);\n    95\t    if (!matches) return;\n    96\t    last = position;\n    97\t  }\n    98\t  if (last === first) return;\n    99\t  const rows: number[] = [];\n   100\t  for (let i = 0; i < x.positions.length && rows.length < 10; i++) {\n   101\t    if (Number.isFinite(x.positions[i])) rows.push(table.rowIndex(i));\n   102\t  }\n   103\t  report(sink, 'AX111', 'none', { field: x.parser.field.field, count: length, rows });\n   104\t}\n   105\t\n   106\tinterface Group {\n   107\t  readonly key: string;\n   108\t  readonly label: string;\n   109\t  readonly value: ResolvedValueField;\n   110\t  readonly order: Int32Array | null;\n   111\t}\n   112\t\n   113\tfunction groups(o