  384\t    if (!list.length) return;\n   385\t    enqueue(() => {\n   386\t      for (const d of list) {\n   387\t        if (destroyed) return;\n   388\t        delivery.print(d);\n   389\t        if (typeof handler === 'function') delivery.notify(handler as (d: Diagnostic) => void, d);\n   390\t      }\n   391\t    });\n   392\t  }\n   393\t\n   394\t  interface Candidate {\n   395\t    readonly options: OptionRecord;\n   396\t    readonly resolved: ResolvedOptions;\n   397\t    readonly source: ResolvedOptions;\n   398\t    readonly store: Store | null;\n   399\t    readonly frame: Frame;\n   400\t    readonly dataDiagnostics: readonly DiagnosticInput[];\n   401\t    readonly dataOptions: readonly DiagnosticInput[];\n   402\t    readonly optionDiagnostics: readonly DiagnosticInput[];\n   403\t    readonly zoom: Span<XValue> | null;\n   404\t    readonly hidden: ReadonlySet<string>;\n   405\t    readonly messages: Messages;\n   406\t  }\n   407\t\n   408\t  interface Viewed {\n   409\t    readonly view: View;\n   410\t    readonly viewKey: readonly unknown[];\n   411\t    readonly viewDiagnostics: readonly DiagnosticInput[];\n   412\t    /** What this build found that the previous view did not have. */\n   413\t    readonly found: readonly DiagnosticInput[];\n   414\t  }\n   415\t\n   416\t  function viewFor(c: Candidate, previous: Accepted | null): Viewed {\n   417\t    const key = viewKeyFor(kind, c.options, c.resolved, c.frame, c.zoom, c.hidden, c.messages);\n   418\t    if (previous && sameValue(previous.viewKey, key)) {\n   419\t      return { view: previous.view, viewKey: previous.viewKey, viewDiagnostics: previous.viewDiagnostics, found: [] };\n   420\t    }\n   421\t    stage('view');\n   422\t    const sink = new DiagnosticCollector();\n   423\t    const state = viewStateFor(kind, c.options, c.resolved, c.zoom, previous?.view ?? null, c.hidden, c.messages);\n   424\t    const view = buildView(c.frame as never, state as never, sink) as View;\n   425\t    const found = sink.inputs();\n   426\t    const before = previous?.viewDiagnostics ?? [];\n   427\t    const viewDiagnostics = completeViewDiagnostics(kind, found, before, view, state);\n   428\t    const known = new Set(before.map(diagnosticKey));\n   429\t    return { view, viewKey: key, viewDiagnostics, found: found.filter(d => !known.has(diagnosticKey(d))) };\n   430\t  }\n   431\t\n   432\t  function messagesFor(next: OptionRecord, previous: Accepted | null): Messages {\n   433\t    return previous && sameValue(previous.options.messages, next.messages) ? previous.messages : resolveMessages(object(next.messages));\n   434\t  }\n   435\t\n   436\t  /**\n   437\t   * Accepts a validated candidate: the store commits first (so the frame on screen and the store agree),\n   438\t   * then the options, then the state. Nothing before this changes the chart.\n   439\t   */\n   440\t  function accept(c: Candidate, viewed: Viewed, follow: boolean, commit: (() => void) | null): void {\n   441\t    commit?.();\n   442\t    if (commit) storeFrames.add(c.frame);\n   443\t    if (held && c.frame === held.frame) held = null;\n   444\t    options.commit(c.options);\n   445\t    frameRevision = Math.max(frameRevision, c.frame.revision);\n   446\t    accepted = {\n   447\t      options: c.options, resolved: c.resolved, source: c.source, store: c.store, frame: c.frame,\n   448\t      dataDiagnostics: c.dataDiagnostics, dataOptions: c.dataOptions, optionDiagnostics: c.optionDiagnostics,\n   449\t      viewDiagnostics: viewed.viewDiagnostics, naming: namingDiagnostics(c.options), view: viewed.view,\n   450\t      viewKey: viewed.viewKey, zoom: c.zoom, follow, revision: ++commits, messages: c.messages,\n   451\t      name: chartName(c.options), hidden: c.hidden,\n   452\t    };\n   453\t    if (internalError !== null) {\n   454\t      internalError = null;\n   455\t      setPresentationQuiet('internal', []);\n   456\t    }\n   457\t    release();\n   458\t    deliverChanges();\n   459\t