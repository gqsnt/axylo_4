ed < observations && x.positions[source] === position) {\n   284\t      const state = values.slot[source]!;\n   285\t      if (zero && (state === SLOT_NULL || state === SLOT_ABSENT_FIELD)) {\n   286\t        y[i] = 0;\n   287\t      } else {\n   288\t        slot[i] = state;\n   289\t        row[i] = table.rowIndex(source);\n   290\t        y[i] = values.y[source]!;\n   291\t      }\n   292\t      observed++;\n   293\t    } else {\n   294\t      const state = gaps?.[gap] === position ? SLOT_GAP : SLOT_NO_ROW;\n   295\t      if (state === SLOT_GAP) gap++;\n   296\t      if (!zero) slot[i] = state;\n   297\t      y[i] = zero ? 0 : NaN;\n   298\t    }\n   299\t  }\n   300\t  return { ...description, drawable, y, slot, row };\n   301\t}\n   302\t\n   303\tconst maxAlignedSlots = 20_000_000;\n   304\t\n   305\texport function alignmentFits(series: number, positions: number, sink: DiagnosticSink): boolean {\n   306\t  if (series * positions <= maxAlignedSlots) return true;\n   307\t  report(sink, 'AX134', 'chart-error', {\n   308\t    count: 1, detail: 'The aligned frame has ' + series + ' series and ' + positions + ' x positions, exceeding 20,000,000 slots.',\n   309\t  });\n   310\t  return false;\n   311\t}\n   312\t\n   313\texport function alignedFrame(\n   314\t  options: ResolvedOptions, x: XData, sink: DiagnosticSink, version: FrameVersion, counts?: Map<string, ValueCounts>,\n   315\t): AlignedFrame {\n   316\t  const axis = x.parser.column(x.positions);\n   317\t  const { table } = options;\n   318\t  const frame = {\n   319\t    ...base(table, version), shape: 'aligned' as const,\n   320\t    xLabel: options.x.label, yLabel: options.values.length === 1 ? options.values[0]!.label : null,\n   321\t  };\n   322\t  const empty = () => ({ ...frame, x: { ...axis, values: new Float64Array(), categories: axis.categories && [] }, length: 0, series: [] });\n   323\t  const observed = combinePositions(x, []);\n   324\t  const groupsBySeries = groups(options, x, sink);\n   