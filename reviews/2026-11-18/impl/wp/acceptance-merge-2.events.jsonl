r hiding a datum moves nothing; the strip covers nothing and nothing covers it`, async () => {\n        const page = await devPage({ viewport: { width: 1000, height: 900 } });\n        await create(page, type);\n        for (const [target, readout] of [[axis === 'width' ? 241 : 141, false], [axis === 'width' ? 239 : 139, true]] as const) {\n          const got = await plotTo(page, axis, target);\n          expect(Math.abs(got - target), `plot ${axis} reached ${got}`).toBeLessThanOrEqual(0.5);\n          expect(await layout(), `${target} px: hiding it moved the layout`).toBe(hidden);\n        }\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n\n    if (type !== 'donut') {\n      it(`I1 ${type}: with ten series ${type === 'scatter' ? 'on one coincident point' : 'at one x'} the tooltip lists eight of the series by name and \"+2 more\"; in readout mode the strip, on at most two lines, names the same series in the same order up to where it is cut and counts the rest in \"+N more\"`, async () => {\n        const page = await devPage({ viewport: { width: 1000, height: 1000 } });\n        const names = Array.from({ length: 10 }, (_, i) => `Region number ${i + 1}`);\n        const data = type === 'scatter'\n          ? names.map(s => ({ x: 5, y: 5, s })).concat([{ x: 1, y: 1, s: names[0]! }, { x: 9, y: 9, s: names[0]! }])\n    const tallest = rects.reduce((a, b) => (b.height > a.height ? b : a));\n    expect(sorted.indexOf(tallest)).toBe(1234);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('T-dense-donut: no simplified drawing: eight slices, the smallest under 0.2 %, are each drawn at their angle in their colour', async () => {\n    const page = await devPage();\n    const values = [600, 200, 100, 50, 30, 15, 4, 1];\n    await createRaw(page, 'donut', { title: 'Eight', data: values.map((v, i) => ({ l: `S${i + 1}`, v })), label: 'l', value: 'v' });\n    const { img, box: plot, scale } = await screenshot(page, '#chart .axylo-plot');\n    const g = await ring(page);\n    const colors = await resolveColors(page, await page.locator('#chart ul.axylo-legend-list > li svg.axylo-swatch').evaluateAll(els => els.map(e => getComputedStyle(e).color)));\n    const wrong: string[] = [];\n    // The slices' own paths, by colour, with the angle their outer arc starts at (clockwise from 12 o'clock).\n    const starts = await page.evaluate(({ cx, cy }) => [...document.querySelectorAll<SVGPathElement>('#chart svg.axylo-svg .axylo-scene path')].filter(p => /M\\s*-?[\\d.]+[ ,]-?[\\d.]+/.test(p.getAttribute('d') ?? '')).map(p => {\n      const m = p.getScreenCTM()!; const [x, y] = /M\\s*(-?[\\d.]+)[ ,](-?[\\d.]+)/.exec(p.getAttribute('d')!)!.slice(1).map(Number);\n      const q = new DOMPoint(x!, y!).matrixTransform(m);\n      return { color: getComputedStyle(p).color, angle: (Math.atan2(q.x - cx, cy - q.y) + 2 * Math.PI) % (2 * Math.PI) };\n    }), g);\n    const css = await page.locator('#chart ul.axylo-legend-list > li svg.axylo-swatch').evaluateAll(els => els.map(e => getComputedStyle(e).color));\n    values.forEach((v, i) => {\n      const a = midAngle(values, i);\n      const arc = ((2 * Math.PI * v) / 1000) * g.outer;\n      // A slice wider than 4 px of arc is checked on the screen; a thinner one is hidden by its 1 px\n      // separators (spec A5), so its own path is checked to start where its share puts it.\n      if (arc > 4) {\n        const c = inkColorAt(img, (g.cx - plot.x + 0.85 * g.outer * Math.sin(a)) * scale, (g.cy - plot.y - 0.85 * g.outer * Math.cos(a)) * scale);\n        if (distance(c, colors[i]!) > 30) wrong.push(`S${i + 1}: ${c} vs ${colors[i]}`);\n      } else {\n        const start = (2 * Math.PI * values.slice(0, i).reduce((x, y) => x + y, 0)) / 1000;\n        if (!starts.some(p => p.color === css[i] && Math.abs(p.angle - start) < 0.02)) wrong.push(`S${i + 1}: no path of its colour starts at ${((start * 180) / Math.PI).toFixed(1)}°`);\n      }\n    });\n    expect(wrong).toEqual([]);\n    expect(await closePage(page)).toEqual([]);\n  });\n\nF7 [\n  'F7 area: declared percent reaches full scale at half scale while a small maximum uses the first tick',\n  'F7 area: declared ratio reaches full scale at half scale while a small maximum uses the first tick',\n  'F7 area: for any generated extents the automatic domain includes data and references and the zoom stays inside its governing domain',\n  'F7 area: for any generated reference extreme the automatic value domain ends at the first drawn tick that reaches it (reading: the tick is the one the reader sees)'\n]\nF8 [\n  'F8 donut: a negative value shows the error state and clears all arcs',\n  'F8 donut: all-zero values show the empty state while the table retains both zero values',\n  'F8 donut: seven largest categories and Other (3) are drawn; all ten categories remain individually readable in the table',\n  'F8 donut: slices start at twelve and run clockwise in input order; zero and null are listed without arcs',\n  'F8 donut: exactly eight slices including zero and null keep both arcless categories readable',\n  'F8 donut: zero and null slices stay separate and only positive slices count toward the limit'\n]\nA1 [\n  'A1 area: model preserves the author’s heading, uses an existing label when given and adds the description to the data summary'\n]\nF9 [\n  'F9 area: six and eight series have distinct paint bindings; twelve retain distinct painted cues and raise AX130'\n]\nDX8 [\n  'DX8 area: Node import and validate give the same call-time diagnostics as the controller'\n]\nT-zoom-donut [\n  'T-zoom-donut donut: even an explicit zoom call leaves arc angles and table rows in slice order'\n]\n","exit_code":0,"status":"completed"}}
