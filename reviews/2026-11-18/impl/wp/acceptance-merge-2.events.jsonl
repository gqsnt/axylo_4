etween two gaps is a visible point`, async () => {\n      const page = await devPage({ css: `${NO_GRID} ${type === 'compact' ? '#chart { width: 240px; height: 60px; }' : ''}` });\n      await createRaw(page, type === 'compact' ? 'line' : type, {\n        title: 'Gaps', data: VALUES.map((v, x) => ({ x, v })), x: 'x', y: 'v', ...(type === 'compact' ? { compact: true } : {}),\n      });\n      // x positions from the drawn runs: points 0, 1, 5 and 6 are on the stroke, evenly spaced.\n      const v = await vertices(page);\n      expect(v.length).toBeGreaterThanOrEqual(4);\n      const x0 = v[0]!.x, step = (v.at(-1)!.x - x0) / 6;\n      const xs = VALUES.map((_, k) => x0 + k * step);\n      // No vertex at x = 2 or x = 4 (not drawn as zero), none bridging them.\n      for (const k of [2, 4]) expect(v.some(p => Math.abs(p.x - xs[k]!) < 1), `vertex at ${k}`).toBe(false);\n      const svg = await box(page, '#chart svg.axylo-svg');\n      const top = svg.y, bottom = type === 'compact' ? svg.y + svg.height : (await box(page, '#chart .axylo-proxy')).y + (await box(page, '#chart .axylo-proxy')).height - 3;\n      const margin = 7;\n      expect(await inkIn(page, xs[1]! + margin, xs[3]! - margin, top, bottom), 'between x = 1 and 3').toBe(0);\n      expect(await inkIn(page, xs[3]! + margin, xs[5]! - margin, top, bottom), 'between x = 3 and 5').toBe(0);\n      // The isolated value at x = 3 is drawn.\n      expect(await inkIn(page, xs[3]! - 4, xs[3]! + 4, top, bottom), 'at x = 3').toBeGreaterThan(4);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    it(`F2 ${type}: on a regular date axis, explicit nulls and the same rows deleted render the same gap, and the deleted rows raise AX105`, async () => {\n      const page = await devPage({ viewport: { width: 900, height: 1100 }, css: `${NO_GRID} #other { width: 720px; height: 400px; } ${type === 'compact' ? '#chart, #other { width: 240px; height: 60px; }' : ''}` });\n      await page.evaluate(() => { const el = document.createElement('div'); el.id = 'other'; document.querySelector('#after')!.after(el); });\n      const day = (k: number) => new Date(Date.UTC(2026, 0, 1) + k * 864e5).toISOString().slice(0, 10);\n      const full = Array.from({ length: 20 }, (_, k) => ({ day: day(k), v: 10 + ((k * 7) % 11) }));\n      const withNulls = full.map((r, k) => (k >= 8 && k <= 10 ? { ...r, v: null } : r));\n      const deleted = full.filter((_, k) => k < 8 || k > 10);\n      const common = { title: 'Same gap', x: { field: 'day', type: 'date' }, y: 'v', ...(type === 'compact' ? { compact: true } : {}) };\n      const fn = type === 'compact' ? 'line' : type;\n      const a = await createRaw(page, fn, { ...common, data: withNulls }, '#chart');\n      const b = await createRaw(page, fn, { ...common, data: deleted }, '#other');\n      expect(a.diagnostics.map(d => d.code)).not.toContain('AX105');\n      expect(b.diagnostics.map(d => d.code)).toContain('AX105');\n      // The same drawing: identical mark geometry in both plots (the same pixels follow from it; a pixel\n      // comparison of two places on the page also measures the rasteriser, so it is not used).\n      const scene = (sel: string) => page.evaluate(sel => [...document.querySelectorAll(`${sel} .axylo-scene path, ${sel} .axylo-scene rect`)].map(e => e.getAttribute('d') ?? `${e.getAttribute('x')},${e.getAttribute('y')},${e.getAttribute('width')},${e.getAttribute('height')}`), sel);\n      const drawn = await scene('#chart');\n      expect(drawn.length).toBeGreaterThan(0);\n      expect(await scene('#other')).toEqual(drawn);\n      // And each, on its own, leaves days 8–10 undrawn: no vertex there, no ink between day 7 and day 11.\n      for (const sel of ['#chart', '#other']) {\n        const v = await vertices(page, sel);\n        const x0 = v[0]!.x, step = (v.at(-1)!.x - x0) / 19;\n        for (const k of [8, 9, 10]) expect(v.some(p => Math.abs(p.x - (x0 + k * step)) < 1), `${sel}: vertex at day ${k}`).toBe(false);\n        const svg = await box(page, `${sel} svg.axylo-svg`);\n        const top = svg.y, bottom = type === 'compact' ? svg.y + svg.height : (await box(page, `${sel} .axylo-proxy`)).y + (await box(page, `${sel} .axylo-proxy`)).height - 3;\n        expect(await inkIn(page, x0 + 7 * step + 7, x0 + 11 * step - 7, top, bottom, sel), `${sel}: ink in the gap`).toBe(0);\n      }\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\ndescribe(\"F2 missing: 'zero'\", () => {\n  for (const type of ['line', 'area', 'bar', 'compact'] as const) {\n    it(`F2 ${type}: with missing: 'zero' on the field, an explicit null and an absent step are drawn at zero, on the zero baseline`, async () => {\n19:describe('negative controls', () => {\n20:  it('A5 bar: negative control: the separator check, calibrated on a 1 px control, flags a 0.5 px gap and touching marks', async () => {\n36:  it('A5 line: negative control: painted-colour sampling reports marks made nearly transparent, and marks covered by an element', async () => {\n52:  it('A5 line: negative control: the grayscale marker-class check reports three identical markers as not distinct', async () => {\n81:  it('L1 line: negative control: the text check reports an overlapping label, a clipped one, and two lines that overlap by 1.1 px', async () => {\n113:  it('A4 line: negative control: the table comparison reports two swapped cells and two swapped headers', async () => {\n136:  it('A1 line: negative control: the summary check reports a summary without its range statement', async () => {\n147:  it('A2 line: negative control: reading the value text fails when the range has lost focus, and when it is no longer exposed as a slider', async () => {\n165:  it('I1 bar: negative control: the occlusion check reports a tooltip moved over the active bars', async () => {\n179:  it('I5 line: negative control: the motion trace reports an entry animation added to the marks, and an update transition that outlasts 200 ms', async () => {\n197:  it('T-reference-line: negative control: the reference check finds nothing once the line is removed, and a wrong colour once it is repainted', async () => {\n212:  it('I1 line: negative control: the layout comparison flags a strip that takes room in the flow only while a datum is shown', async () => {\n230:  it('T-dense-line: negative control: the spike-column check reports a spike moved five columns away', async () => {\nnegative controls cited: 0\nscoped citations: {\n  'L8 too small for a plot': 5,\n  'I1 tooltip under the pointer': 5,\n  'I4 single pointer, touch and target size': 5,\n  'A10 built-in text': 6\n}\nBrowser acceptance assertions 532\n","exit_code":0,"status":"completed"}}
