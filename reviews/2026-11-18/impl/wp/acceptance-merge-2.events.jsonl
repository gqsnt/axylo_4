"criterion\":\"DX4\",\"type\":\"line\",\"file\":\"packages/axylo/test/acceptance/dx-controller.test.ts\",\"title\":\"DX4 line: reports one field, caller row index, chart name and a fix synchronously\"},\n  {\"criterion\":\"DX4\",\"type\":\"scatter\",\"file\":\"packages/axylo/test/acceptance/dx-controller.test.ts\",\"title\":\"DX4 scatter: reports one field, caller row index, chart name and a fix synchronously\"},\n  {\"criterion\":\"DX5\",\"type\":\"area\",\"file\":\"packages/axylo/test/acceptance/dx-controller.test.ts\",\"title\":\"DX5 area: a present patch key replaces the whole field, undefined restores the default, and absent keys stay\"},\n  {\"criterion\":\"DX5\",\"type\":\"area\",\"file\":\"packages/axylo/test/acceptance/dx-controller.test.ts\",\"title\":\"DX5 area: a strict field error is synchronous and the accepted title, marks and reader survive it\"},\n  {\"criterion\":\"DX5\",\"type\":\"area\",\"file\":\"packages/axylo/test/acceptance/dx-controller.test.ts\",\"title\":\"DX5 area: destroy cancels the pending frame and later calls have no effect\"},\n  {\"criterion\":\"DX5\",\"type\":\"area\",\"file\":\"packages/axylo/test/acceptance/dx-controller.test.ts\",\"title\":\"DX5 area: replace then append then zoom in one turn switches marks, text and lookup together\"},\n  {\"criterion\":\"DX5\",\"type\":\"area\",\"file\":\"packages/axylo/test/acceptance/dx-controller.test.ts\",\"title\":\"DX5 area: strict create, update and append reject warnings synchronously and keep the last valid chart\"},\n  {\"criterion\":\"DX5\",\"type\":\"bar\",\"file\":\"packages/axylo/test/acceptance/dx-controller.test.ts\",\"title\":\"DX5 bar: a present patch key replaces the whole field, undefined restores the default, and absent keys stay\"},\n","exit_code":0,"status":"completed"}}
