{"type":"item.completed","item":{"id":"item_37","type":"command_execution","command":"/bin/bash -lc \"sed -n '111,143p' packages/axylo/test/browser/acceptance/f8-donut.browser.test.ts\nsed -n '1,84p' packages/axylo/test/browser/acceptance/f8-donut.browser.test.ts\nsed -n '88,104p' packages/axylo/test/browser/chart/lifecycle.browser.test.ts\nsed -n '205,241p' packages/axylo/test/browser/chart/review5.browser.test.ts\nhead -n 12 packages/axylo/test/browser/acceptance/util.ts\nrg -n 'C4|color|colour' packages/axylo/test/browser/acceptance/compact.browser.test.ts\"","aggregated_output":"    const values = [3, 30, 8, 2, 20, 15, 4, 10, 6, 5];\n    const built = await create(page, 'donut', { data: values.map((v, i) => ({ item: `S${i + 1}`, spend: v })) });\n    expect(built.diagnostics.filter(d => d.code === 'AX121').map(d => d.level)).toEqual(['warning']);\n    const drawn = [['S2', 30], ['S3', 8], ['S5', 20], ['S6', 15], ['S8', 10], ['S9', 6], ['S10', 5], ['Other (3)', 9]] as const;\n    const entries = await legend(page);\n    expect(entries.map(e => e.replace(/\\s+[\\d,.]+\\s*EUR.*$/, ''))).toEqual(drawn.map(d => d[0]));\n    drawn.forEach(([, v], i) => expect(entries[i]).toContain(withUnit(v, SPEND.unit)));\n    expect(await sliceCount(page)).toBe(8);\n    // Each arc sits where its share puts it, clockwise from 12 o'clock, in the legend's colour.\n    const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n    const g = await ring(page);\n    const colors = await legendColors(page);\n    const total = values.reduce((a, b) => a + b, 0);\n    let before = 0;\n    const wrong: string[] = [];\n    drawn.forEach(([name, v], i) => {\n      const a = (2 * Math.PI * (before + v / 2)) / total;\n      before += v;\n      const seen = pixel(img, g.cx - plot.x + 0.85 * g.outer * Math.sin(a), g.cy - plot.y - 0.85 * g.outer * Math.cos(a));\n      if (distance(seen, colors[i]!) > 24) wrong.push(`${name} at ${Math.round((a * 180) / Math.PI)}°: ${seen}, legend ${colors[i]}`);\n    });\n    expect(wrong).toEqual([]);\n    await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n    await settle(page);\n    const rows = await page.locator('#chart table tbody th[scope=\"row\"]').allTextContents();\n    expect(rows).toEqual(values.map((_, i) => `S${i + 1}`));\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('F8 donut: eight slices are all drawn and raise no AX121; the ninth is what groups', async () => {\n    const page = await devPage();\n    const built = await create(page, 'donut', { data: [5, 1, 4, 2, 8, 3, 7, 6].map((v, i) => ({ item: `S${i + 1}`, spend: v })) });\n    expect(built.diagnostics.map(d => d.code)).not.toContain('AX121');\n/**\n * F8, rendered (spec 3.1): donut slices keep the given order, start at 12 o'clock and run clockwise (read\n * from the screenshot along the ring); the legend shows every slice's value and percentage as text, in\n * slice order; zero, null, negative, more than eight and all-zero slices each have their own outcome.\n */\nimport { afterAll, beforeAll, describe, expect, it } from 'vitest';\nimport { start, stop } from '../harness';\nimport { axWithin, closePage, create, devPage, distance, pixel, resolveColors, ring, screenshot, settle, type RGB } from './util';\nimport { share, SPEND, withUnit } from './fixtures';\n\nbeforeAll(start);\nafterAll(stop);\n\n/** The colour of each legend entry's swatch, resolved by the page. */\nasync function legendColors(page: import('playwright-core').Page): Promise<RGB[]> {\n  const css = await page.locator('#chart ul.axylo-legend-list > li svg.axylo-swatch').evaluateAll(els => els.map(e => getComputedStyle(e).color));\n  return resolveColors(page, css);\n}\n\nasync function sliceCount(page: import('playwright-core').Page): Promise<number> {\n  // Every path of a donut's scene is a slice (the \"Other\" slice has its own muted colour).\n  return page.evaluate(() => document.querySelectorAll('#chart svg.axylo-svg .axylo-scene path').length);\n}\n\n/** Each legend entry as \"name value\": its name and value parts joined by a space. */\nasync function legend(page: import('playwright-core').Page): Promise<string[]> {\n  return page.locator('#chart ul.axylo-legend-list > li').evaluateAll(lis => lis.map(li =>\n    [li.querySelector('.axylo-legend-name')?.textContent ?? '', li.querySelector('.axylo-legend-value')?.textContent ?? ''].join(' ').trim()));\n}\n\ndescribe('F8 donut geometry and legend', () => {\n  it('F8 donut: slices keep the given (unsorted) order, start at 12 o\\'clock and run clockwise: the ring at each slice\\'s middle angle shows that slice\\'s legend colour', async () => {\n    const page = await devPage();\n    await create(page, 'donut');\n    const { img, box: plot } = await screenshot(page, '#chart .axylo-plot');\n    const g = await ring(page);\n    const colors = await legendColors(page);\n    expect(colors).toHaveLength(4);\n    const total = SPEND.values.reduce((a, b) => a + b, 0);\n    const at = (degrees: number) => {\n      const a = degrees * Math.PI / 180, r = g.outer * 0.85;\n      return pixel(img, g.cx - plot.x + r * Math.sin(a), g.cy - plot.y - r * Math.cos(a));\n    };\n    let before = 0;\n    SPEND.values.forEach((v, i) => {\n      const mid = 360 * (before + v / 2) / total;\n      before += v;\n      const seen = at(mid);\n      const nearest = colors.map(c => distance(c, seen)).indexOf(Math.min(...colors.map(c => distance(c, seen))));\n      expect(nearest, `${SPEND.items[i]} at ${mid}°: ${seen}`).toBe(i);\n      expect(distance(colors[i]!, seen), `${SPEND.items[i]} at ${mid}°`).toBeLessThanOrEqual(24);\n    });\n    // Just clockwise of 12 o'clock is the first slice; just anticlockwise of it, the last.\n    expect(distance(at(3), colors[0]!)).toBeLessThanOrEqual(24);\n    expect(distance(at(357), colors[3]!)).toBeLessThanOrEqual(24);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('F8 donut: the legend shows every slice\\'s value and percentage as text, in slice order, and is in the accessibility tree', async () => {\n    const page = await devPage();\n    await create(page, 'donut');\n    const entries = await legend(page);\n    expect(entries).toHaveLength(4);\n    SPEND.items.forEach((item, i) => {\n      const e = entries[i]!;\n      expect(e.startsWith(item), e).toBe(true);\n      expect(e).toContain(withUnit(SPEND.values[i]!, SPEND.unit));\n      expect(e).toContain(share(SPEND.values[i]!));\n    });\n    const text = (await axWithin(page, '#chart ul.axylo-legend-list')).filter(n => n.role === 'StaticText').map(n => n.name).join(' ');\n    for (const item of SPEND.items) expect(text).toContain(item);\n    expect(text).toContain(share(SPEND.values[0]!));\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  it('F8 donut: a zero slice is listed without an arc; a null slice is listed as \"No data\", without an arc', async () => {\n    const page = await devPage();\n    await create(page, 'donut', { data: [{ item: 'Rent', spend: 1200 }, { item: 'Gifts', spend: 0 }, { item: 'Food', spend: 600 }, { item: 'Pets', spend: null }] });\n    const entries = await legend(page);\n    expect(entries.map(e => e.split(/\\s/)[0])).toEqual(['Rent', 'Gifts', 'Food', 'Pets']);\n    expect(entries[1]).toContain(withUnit(0, SPEND.unit));\n    expect(entries[3]).toContain('No data');\n    expect(entries[3]).not.toMatch(/\\d/);\n    expect(await sliceCount(page)).toBe(2);\n    expect(new Set(result.layouts).size).toBe(1);\n    expect(result.clamp).toEqual([160, 480]);\n    expect(await closePage(page)).toEqual([]);\n  });\n\n  // Part 2 put the legend and toolbar under the plot (spec A2), so the plot now takes what the caption and\n  // the controls leave; with no controls (legend, zoom and table off) it reaches the bottom as before.\n  it('a definite container height is filled: the plot takes what the caption and the controls leave', async () => {\n    const page = await chartPage({ css: '#chart { height: 300px; } #bare { height: 300px; width: 720px; }' });\n    const result = await page.evaluate(async () => {\n      const options = { title: 'Fixed', subtitle: 'Subtitle', data: window.fx.trendRows(), x: 'day', y: 'sessions', series: 'channel' };\n      const chart = window.Axylo.line!('#chart', options);\n      const el = document.body.appendChild(Object.assign(document.createElement('div'), { id: 'bare' }));\n      const bare = window.Axylo.line!(el, { ...options, legend: false, zoom: false, table: false });\n      await Promise.all([chart.__bench.ready(), bare.__bench.ready()]);\n      const box = (selector: string) => document.querySelector(selector)!.getBoundingClientRect();\n      return {\n      expect(inner.top).toBeGreaterThanOrEqual(boxes.figure.top - 1);\n      expect(inner.bottom).toBeLessThanOrEqual(boxes.figure.bottom + 1);\n      expect(inner.right).toBeLessThanOrEqual(boxes.figure.right + 1);\n    }\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\ndescribe('the language watcher', () => {\n  it('changing lang on the document re-renders the language marking and the number formatting, without a theme callback', async () => {\n    const page = await chartPage();\n    await page.evaluate(() => { document.documentElement.lang = 'en'; });\n    await create(page, 'line', { title: 'L', data: [{ x: 1, y: 1234.5 }, { x: 2, y: 2000.25 }], x: 'x', y: 'y' });\n    const read = () => page.evaluate(() => {\n      const fig = document.querySelector('#chart figure')!;\n      const summary = document.getElementById(fig.getAttribute('aria-describedby')!)!.textContent ?? '';\n      return { summary, proxyLang: document.querySelector('#chart .axylo-proxy')!.getAttribute('lang'), theme: window.charts[0]!.__dev.stages().theme };\n    });\n    const before = await read();\n    expect(before.summary).toContain('1,234.5');\n    expect(before.proxyLang).toBeNull();\n    await page.evaluate(() => { document.documentElement.lang = 'de'; });\n    await page.evaluate(() => window.nextFrames(3));\n    await settle(page);\n    const after = await read();\n    expect(after.summary).toContain('1.234,5');\n    expect(after.proxyLang).toBe('en');\n    expect(after.theme).toBe(before.theme);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n/**\n * Shared setup for the browser acceptance suite. Pages come from the existing harness (development\n * bundle, `chartPage`) or from `prod.html` in this directory (the minified production bundle). Charts are\n * created through the public API with the hand-written fixtures in `fixtures.ts`; the accessibility tree is\n * read from Chrome itself through the DevTools protocol (roles, names, descriptions, states), never from the\n * attributes the code sets, except where a comment says Chrome cannot report the property.\n *\n * THIS SUITE IS EVIDENCE FOR THE SVG RENDERER ONLY. It locates marks by reading the SVG DOM (paths, rects,\n * their colour slots) before sampling their pixels, so it says nothing about the canvas renderer, and it\n * refuses to run when `AXYLO_RENDERER=canvas` is set rather than report SVG results under a canvas run.\n *\n * Every checker the suite leans on (separators, painted colour, text overlap, table comparison, the focused\n106:        : await page.evaluate(() => { const svg = document.querySelector('#chart svg.axylo-svg') as SVGSVGElement; const m = svg.getScreenCTM()!; let low = -Infinity; for (const el of svg.querySelectorAll<SVGPathElement>('.axylo-scene path')) { if (el.style.getPropertyValue('fill') !== 'currentcolor') continue; const n = el.getAttribute('d')!.match(/-?\\d*\\.?\\d+/g)!.map(Number); for (let i = 1; i < n.length; i += 2) low = Math.max(low, new DOMPoint(n[i - 1]!, n[i]!).matrixTransform(m).y); } return low; });\n140:    it(`C2 compact ${kind}: the scheme comes from the page (L4): a dark page paints the marks in other colours than a light one, and a class toggle repaints them`, async () => {\n141:      const page = await devPage({ deviceScaleFactor: 2, css: '#chart { width: 200px; height: 48px; } body.dk { background: #121212; color: #e8e8e8; }' });\n145:        const backdrop = modeColor(img, { x0: 0, y0: 0, x1: img.width, y1: img.height }).color;\n204:describe('C4 more than one series', () => {\n206:    it(`C4 compact ${kind}: two series differ by ${kind === 'bar' ? 'more than colour, as painted (reading: A5 asks a non-colour cue of bars too)' : 'dash as well as colour'}, and AX131 suggests one series per compact chart`, async () => {\n212:        // Painted texture: the share of a bar's interior that is not its own solid colour. A plain bar has\n213:        // none; a patterned one has its pattern. The two series must differ by more than colour.\n215:        const backdrop = modeColor(img, { x0: 0, y0: 0, x1: img.width, y1: img.height }).color;\n230:        const dashes = await page.evaluate(() => [...document.querySelectorAll<SVGPathElement>('#chart svg.axylo-svg .axylo-scene path')].filter(e => /--axylo-series-color-/.test(e.style.getPropertyValue('color')) && e.style.getPropertyValue('stroke') === 'currentcolor').map(e => getComputedStyle(e).strokeDasharray));\n256:      const backdrop = modeColor(img, { x0: 0, y0: 0, x1: img.width, y1: img.height }).color;\n","exit_code":0,"status":"completed"}}
