{"type":"item.completed","item":{"id":"item_16","type":"command_execution","command":"/bin/bash -lc \"sed -n '30,86p;128,152p;174,210p' research/palette/preview.mjs && sed -n '275,324p' packages/axylo/src/core/focus.ts && node -e 'for(const f of [\\\"palette\\\",\\\"raster\\\",\\\"strokes\\\",\\\"preview-pixels\\\",\\\"configs/fit-final\\\"]){const q=require(\\\"./research/palette/\\\"+f+\\\".json\\\"); console.log(f,Object.keys(q),q.schemes? Object.keys(q.schemes.light):q.solverLimits)}'\"","aggregated_output":"const sets = args.compare ? [{ label: labels[0], palette }, { label: labels[1], palette: load(args.compare) }] : [{ label: null, palette }];\nconst outDir = path.resolve(args.out ?? here), name = args.name ?? 'preview';\n\nfunction stats(scheme, palette) {\n  const t = theme[scheme], cols = palette[scheme];\n  return cols.map((c, i) => {\n    const near = Object.fromEntries(VISIONS.map(v => {\n      let m = Infinity, k = -1;\n      cols.forEach((o, j) => { if (j !== i) { const d = dist(labUnder(c, v), labUnder(o, v)); if (d < m) { m = d; k = j; } } });\n      return [v, { d: m, k }];\n    }));\n    return { hex: c, contrast: contrast(c, t.background), near };\n  });\n}\n\nfunction filterDefs() {\n  const row = M => `${M[0][0]} ${M[0][1]} ${M[0][2]} 0 0  ${M[1][0]} ${M[1][1]} ${M[1][2]} 0 0  ${M[2][0]} ${M[2][1]} ${M[2][2]} 0 0  0 0 0 1 0`;\n  const gray = '0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0.2126 0.7152 0.0722 0 0  0 0 0 1 0';\n  return `<svg width=\"0\" height=\"0\" style=\"position:absolute\"><defs>\n${['protan', 'deutan', 'tritan'].map(v => `<filter id=\"f-${v}\" color-interpolation-filters=\"linearRGB\"><feColorMatrix type=\"matrix\" values=\"${row(CVD[v])}\"/></filter>`).join('\\n')}\n<filter id=\"f-gray\" color-interpolation-filters=\"linearRGB\"><feColorMatrix type=\"matrix\" values=\"${gray}\"/></filter>\n</defs></svg>`;\n}\n\nconst html = `<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>Axylo palette preview</title>\n<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; font: 12px/1.35 system-ui, -apple-system, \"Segoe UI\", sans-serif; background: #888; }\n  .scheme { padding: 14px 16px 10px; width: 1440px; }\n  .scheme h1 { font-size: 15px; margin: 0 0 8px; font-weight: 600; }\n  .swatches { display: grid; grid-template-columns: repeat(8, 1fr); gap: 8px; margin-bottom: 10px; }\n  .sw { display: flex; flex-direction: column; gap: 3px; }\n  .chip { height: 34px; border-radius: 4px; }\n  .sw code { font: 12px ui-monospace, Menlo, Consolas, monospace; }\n  .meta { font-size: 11px; opacity: 0.85; }\n  .row { display: grid; grid-template-columns: 88px repeat(7, 1fr); gap: 8px; align-items: center; margin-top: 6px; }\n  .row .label { font-weight: 600; font-size: 12px; }\n  .cell svg { display: block; width: 100%; height: auto; }\n  .heads { display: grid; grid-template-columns: 88px repeat(7, 1fr); gap: 8px; font-size: 11px; opacity: 0.8; }\n</style></head><body>\n${filterDefs()}\n<div id=\"root\"></div>\n<script>\nconst SETS = ${JSON.stringify(sets.map(x => ({ label: x.label, palette: x.palette, stats: { light: stats('light', x.palette), dark: stats('dark', x.palette) } })))};\nconst THEME = ${JSON.stringify(theme)};\nconst ALL_ROWS = [['normal', ''], ['protanopia', 'url(#f-protan)'], ['deuteranopia', 'url(#f-deutan)'], ['tritanopia', 'url(#f-tritan)'], ['grayscale', 'url(#f-gray)']];\nconst VISION_ROWS = SETS.length > 1 ? ALL_ROWS.slice(0, 1) : ALL_ROWS;\nfunction rng(seed) { let s = seed >>> 0; return () => { s = (s + 0x6D2B79F5) | 0; let t = Math.imul(s ^ (s >>> 15), 1 | s); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; }; }\nconst W = 190, H = 120, P = 8;\nconst svg = (body, t) => '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"' + W + '\" height=\"' + H + '\" xmlns=\"http://www.w3.org/2000/svg\">'\n  + '<rect width=\"' + W + '\" height=\"' + H + '\" fill=\"' + t.background + '\"/>'\n  + [0.25, 0.5, 0.75].map(f => '<line x1=\"' + P + '\" x2=\"' + (W - P) + '\" y1=\"' + (P + f * (H - 2 * P)) + '\" y2=\"' + (P + f * (H - 2 * P)) + '\" stroke=\"' + t.grid + '\" stroke-width=\"1\"/>').join('')\n  + '<line x1=\"' + P + '\" x2=\"' + (W - P) + '\" y1=\"' + (H - P + 0.5) + '\" y2=\"' + (H - P + 0.5) + '\" stroke=\"' + t.axis + '\" stroke-width=\"1\"/>'\n  + body + '</svg>';\nconst SHAPES = ['circle', 'square', 'triangle', 'diamond', 'cross', 'plus', 'triangle-down', 'star'];\nfunction marker(shape, x, y, c, bg) {\nfunction donut(t, cols) {\n  const v = [30, 22, 16, 12, 9, 7, 6, 5], tot = v.reduce((a, b) => a + b, 0), cx = W / 2, cy = H / 2, R = 52, r0 = 31;\n  let a = -Math.PI / 2, out = '';\n  v.forEach((x, i) => {\n    const b = a + 2 * Math.PI * x / tot, large = b - a > Math.PI ? 1 : 0, p = (rr, t) => (cx + rr * Math.cos(t)).toFixed(2) + ' ' + (cy + rr * Math.sin(t)).toFixed(2);\n    out += '<path d=\"M' + p(R, a) + 'A' + R + ' ' + R + ' 0 ' + large + ' 1 ' + p(R, b) + 'L' + p(r0, b) + 'A' + r0 + ' ' + r0 + ' 0 ' + large + ' 0 ' + p(r0, a) + 'Z\" fill=\"' + cols[i] + '\" stroke=\"' + t.background + '\" stroke-width=\"1\"/>';\n    a = b;\n  });\n  return '<svg viewBox=\"0 0 ' + W + ' ' + H + '\" width=\"' + W + '\" height=\"' + H + '\" xmlns=\"http://www.w3.org/2000/svg\"><rect width=\"' + W + '\" height=\"' + H + '\" fill=\"' + t.background + '\"/>' + out + '</svg>';\n}\nfunction bars(t, cols) {\n  const r = rng(9), groups = 3, n = 6, gw = (W - 2 * P) / groups, bw = (gw - 10) / n;\n  let out = '';\n  for (let g = 0; g < groups; g++) for (let s = 0; s < n; s++) { const h = (0.3 + 0.65 * r()) * (H - 2 * P); out += '<rect x=\"' + (P + g * gw + 5 + s * bw).toFixed(1) + '\" y=\"' + (H - P - h).toFixed(1) + '\" width=\"' + (bw - 1).toFixed(1) + '\" height=\"' + h.toFixed(1) + '\" fill=\"' + cols[s] + '\"/>'; }\n  return svg(out, t);\n}\nconst fmt = x => x.toFixed(3);\nconst root = document.getElementById('root');\nfor (const scheme of (new URLSearchParams(location.search).get('scheme') || 'light,dark').split(',')) {\n  const t = THEME[scheme];\n  const ink = scheme === 'light' ? '#1d2129' : '#e6e8ec';\n  const el = document.createElement('section'); el.className = 'scheme'; el.id = scheme;\n  el.style.background = t.background; el.style.color = ink;\n  el.innerHTML = '<h1>' + scheme + ' scheme, background ' + t.background + '</h1>';\n  for (const set of SETS) {\n\nif (args.shot) {\n  const pixels = { method: 'one pixel at the middle of each donut slice (radius 41.5 of the 190×120 cell), per vision row, read from the PNG', schemes: {} };\n  const { chromium } = await import('playwright-core');\n  const browser = await chromium.launch({ channel: 'chrome', headless: true });\n  for (const scheme of ['light', 'dark']) {\n    const page = await browser.newPage({ viewport: { width: 1440, height: 900 }, deviceScaleFactor: 1 });\n    await page.goto('file://' + htmlPath + '?scheme=' + scheme);\n    const box = await page.locator('#' + scheme).boundingBox();\n    const png = path.join(outDir, `${name}-${scheme}.png`);\n    const buffer = await page.screenshot({ path: png, clip: box });\n    console.log('wrote', png);\n    if (sets.length === 1) {\n      // Read back the middle of every donut slice in every row of the PNG just written, so the record can score\n      // the image itself (simulated rows included), not only the rounding model of it.\n      pixels.schemes[scheme] = await page.evaluate(async ({ b64, box }) => {\n        const values = [30, 22, 16, 12, 9, 7, 6, 5], total = values.reduce((a, v) => a + v, 0);\n        const img = new Image(); img.src = 'data:image/png;base64,' + b64; await img.decode();\n        const c = document.createElement('canvas'); c.width = img.width; c.height = img.height;\n        const g = c.getContext('2d'); g.drawImage(img, 0, 0);\n        const rows = {};\n        for (const row of document.querySelectorAll('#' + box.id + ' .row')) {\n          const svg = row.querySelectorAll('.cell svg')[5], r = svg.getBoundingClientRect(), k = r.width / 190;\n          let a = -Math.PI / 2;\n          rows[row.dataset.vision] = values.map(v => {\n            const b = a + 2 * Math.PI * v / total, m = (a + b) / 2; a = b;\n            const x = Math.round(r.left - box.x + (95 + 41.5 * Math.cos(m)) * k), y = Math.round(r.top - box.y + (60 + 41.5 * Math.sin(m)) * k);\n            const d = g.getImageData(x, y, 1, 1).data;\n            return '#' + [d[0], d[1], d[2]].map(n => n.toString(16).padStart(2, '0')).join('');\n          });\n        }\n        return rows;\n      }, { b64: buffer.toString('base64'), box: { ...box, id: scheme } });\n      pixels.schemes[scheme].background = theme[scheme].background;\n      pixels.schemes[scheme].series = palette[scheme];\n    }\n    await page.close();\n  if (layout.kind !== 'plot' || (target === null && ring === null)) return null;\n  const plot = layout.plot;\n  const clipped: Mark[] = [];\n  const unclipped: Mark[] = [];\n  targetMarks(input, plot, clipped, unclipped);\n\n  if (ring) {\n    const box = lookup.anchor(ring);\n    if (box) {\n      // Drawn inside the plot's box, so it is painted at the last point and at the top of a donut too (A2):\n      // the ring's lines, surround included, are kept inside the plot. Two tones: the focus colour on a\n      // surround of the background colour (WCAG 1.4.11 against whatever mark the ring crosses).\n      const gap = box.width === 0 && box.height === 0 ? 8 : RING_GAP;\n      const inset = SURROUND_WIDTH / 2;\n      const x0 = Math.max(plot.x + inset, box.x - gap), y0 = Math.max(plot.y + inset, box.y - gap);\n      const x1 = Math.min(plot.x + plot.width - inset, box.x + box.width + gap), y1 = Math.min(plot.y + plot.height - inset, box.y + box.height + gap);\n      if (x1 > x0 && y1 > y0) {\n        const ringBox = { x: x0, y: y0, width: x1 - x0, height: y1 - y0 };\n        unclipped.push(...outline(ringBox, 0, 'background', SURROUND_WIDTH), ...outline(ringBox, 0, 'focus', RING_WIDTH));\n      }\n    }\n  }\n  return clipped.length || unclipped.length ? { clip: plot, clipped, unclipped } : null;\n}\n\n/** The union of the anchors a tooltip must not cover, in plot coordinates; null when nothing is drawn. */\nexport function targetBox(view: View, lookup: Lookup, target: PickTarget, only: DatumRef | null): Rect | null {\n  let refs: readonly DatumRef[];\n  if (target.kind === 'x') refs = view.kind === 'donut' || view.kind === 'scatter' ? [] : only ? [only] : refsAt(view, target.x);\n  else if (target.kind === 'point') refs = target.refs;\n  else refs = [{ kind: 'slice', sliceKey: target.sliceKey }];\n  let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;\n  for (const ref of refs) {\n    const box = lookup.anchor(ref);\n    if (!box) continue;\n    x0 = Math.min(x0, box.x);\n    y0 = Math.min(y0, box.y);\n    x1 = Math.max(x1, box.x + box.width);\n    y1 = Math.max(y1, box.y + box.height);\n  }\n  return Number.isFinite(x0) ? { x: x0, y: y0, width: x1 - x0, height: y1 - y0 } : null;\n}\n\n// ── zoom ────────────────────────────────────────────────────────────────────────────────────────────\n\n/** Factor of one zoom step (buttons, keys): the visible x range halves or doubles around its centre. */\nexport const ZOOM_FACTOR = 2;\n/** Shift+arrow moves the window by this share of its width. */\nexport const PAN_SHARE = 0.1;\n\npalette [ 'thresholds', 'schemes', 'oneByteEdits', 'strokes', 'refused' ] [\n  'background',    'tokens',\n  'series',        'minDelta',\n  'prefixes',      'minDeltaBytes',\n  'prefixesBytes', 'tokenDistance',\n  'composites',    'raster',\n  'checks',        'chromeRaster',\n  'previewImage',  'lightness',\n  'tight'\n]\nraster [ 'chrome', 'method', 'schemes' ] [ 'background', 'series', 'pixels' ]\nstrokes [ 'method', 'chrome', 'schemes' ] [ 'background', 'rows' ]\npreview-pixels [ 'method', 'schemes' ] [\n  'normal',\n  'protanopia',\n  'deuteranopia',\n  'tritanopia',\n  'grayscale',\n  'background',\n  'series'\n]\nconfigs/fit-final [ 'note', 'hueClip', 'solverLimits', 'tokens', 'slots' ] { composite: 0.063, minDelta: 0.102 }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module -e \\\"import {expect} from 'vitest';expect(1).toBe(1);console.log('vitest expect ok');\\\" && head -75 packages/axylo/src/theme/css.ts && head -55 packages/axylo/src/theme/color.ts\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"node --input-type=module -e \\\"import {expect} from 'vitest';expect(1).toBe(1);console.log('vitest expect ok');\\\" && head -75 packages/axylo/src/theme/css.ts && head -55 packages/axylo/src/theme/color.ts\"","aggregated_output":"vitest expect ok\n/**\n * The library's default stylesheet as a string. `ensureStyles` adopts it as a constructable stylesheet; the\n * build writes the same string to dist/axylo.css for pages that prefer to load it themselves.\n *\n * Everything sits in the `axylo` cascade layer so that any unlayered rule of the page wins over a default\n * without a specificity contest, whichever order the sheets arrive in.\n *\n * Token scheme: the sheet sets only private defaults (`--axylo-default-axis`, `--axylo-default-series-1`, …)\n * on `.axylo`. The public names (`--axylo-axis`, `--axylo-series-1`, `--axylo-background`, `--axylo-text`,\n * `--axylo-font-family`, …) are never set outside forced colors, so an author may set them anywhere,\n * including `:root`, and inheritance carries them in. Every use reads `var(--axylo-x, var(--axylo-default-x))`.\n *\n * Things this sheet must never do, because scheme detection (spec L4) reads them from the chart root: set\n * `color-scheme` or `color` on `.axylo`, or set `--axylo-background` outside forced colors.\n *\n * Component selectors are scoped beneath `.axylo`, so a page's own `.axylo-text` is left alone.\n */\nimport { DARK, LIGHT, type SchemeColors } from './palette';\n\n/** Each default as `light-dark(light, dark)`: the browser picks by the chart's used colour scheme. */\nfunction following(light: SchemeColors, dark: SchemeColors): string {\n  const pair = (a: string, b: string) => `light-dark(${a}, ${b})`;\n  const series = light.series.map((v, i) => `    --axylo-default-series-${i + 1}: ${pair(v, dark.series[i]!)};`).join('\\n');\n  return `${series}\n    --axylo-default-background: ${pair(light.background, dark.background)};\n    --axylo-default-axis: ${pair(light.axis, dark.axis)};\n    --axylo-default-grid: ${pair(light.grid, dark.grid)};\n    --axylo-default-muted: ${pair(light.muted, dark.muted)};\n    --axylo-default-reference: ${pair(light.reference, dark.reference)};\n    --axylo-default-focus: ${pair(light.focus, dark.focus)};`;\n}\n\nfunction tokens(c: SchemeColors): string {\n  const series = c.series.map((v, i) => `    --axylo-default-series-${i + 1}: ${v};`).join('\\n');\n  return `${series}\n    --axylo-default-background: ${c.background};\n    --axylo-default-axis: ${c.axis};\n    --axylo-default-grid: ${c.grid};\n    --axylo-default-muted: ${c.muted};\n    --axylo-default-reference: ${c.reference};\n    --axylo-default-focus: ${c.focus};`;\n}\n\n// Forced colors: every paint becomes a system color. `!important` so an author's custom property, whether\n// inherited or set on the chart, cannot leak a brand color into a mode where the user chose the colors.\n// `--axylo-forced-series` switches off the author's pinned series colors (resolveTheme writes each as\n// `var(--axylo-forced-series, <author color>)` on the chart root), so they return when forced colors ends.\nconst forced = [\n  ...LIGHT.series.map((_, i) => `    --axylo-series-${i + 1}: CanvasText !important;`),\n  '    --axylo-forced-series: CanvasText !important;',\n  '    --axylo-background: Canvas !important;',\n  '    --axylo-default-background: Canvas !important;',\n  '    --axylo-text: CanvasText !important;',\n  '    --axylo-axis: CanvasText !important;',\n  '    --axylo-grid: GrayText !important;',\n  '    --axylo-muted: GrayText !important;',\n  '    --axylo-reference: CanvasText !important;',\n  '    --axylo-focus: Highlight !important;',\n].join('\\n');\n\nexport const AXYLO_CSS = `/* Axylo default stylesheet */\n@layer axylo {\n  /* Lets ensureStyles find this sheet; it checks the sheet's effect as well, not only this sentinel. */\n  :root { --axylo-stylesheet: loaded; }\n\n  /*\n   * tokens: private defaults that follow the chart's used colour scheme (spec L4). Where the page gives the\n   * chart a color-scheme (light dark, dark, light, only …), resolveTheme writes no scheme attribute and these\n   * apply: a prefers-color-scheme change switches every var(--axylo-default-…) in the same frame as the media\n   * query, with no script (the SVG marks reference them; the canvas renderer repaints when the change event\n   * arrives, one frame behind). light-dark() is supported by the current and previous major versions of the\n   * four browsers in spec 2.3.\n   */\n  .axylo {\n${following(LIGHT, DARK)}\n/**\n * Color arithmetic for contrast checks (spec L2, A5). Pure: runs in Node. Input is what the browser hands\n * back from getComputedStyle (`rgb()`, `rgba()`, `color(srgb …)`) plus hex, which the default palette is\n * written in. Anything else returns null rather than a guess.\n */\nimport type { ResolvedTheme } from '../core/contracts';\n\n/** sRGB channels and alpha, each 0–1. */\nexport interface Rgba { readonly r: number; readonly g: number; readonly b: number; readonly a: number }\n\nconst clamp01 = (v: number): number => (v < 0 ? 0 : v > 1 ? 1 : v);\n\nfunction channel(token: string, scale: number): number {\n  if (token.endsWith('%')) return clamp01(parseFloat(token) / 100);\n  if (token === 'none') return 0;\n  return clamp01(parseFloat(token) / scale);\n}\n\nfunction alpha(token: string | undefined): number {\n  if (token === undefined) return 1;\n  return channel(token, 1);\n}\n\n/** Parses a computed color string. Returns null for anything that is not a plain sRGB color. */\nexport function parseColor(input: string): Rgba | null {\n  const s = input.trim().toLowerCase();\n  if (s === 'transparent') return { r: 0, g: 0, b: 0, a: 0 };\n  if (s.startsWith('#')) return parseHex(s.slice(1));\n  const open = s.indexOf('(');\n  if (open < 0 || !s.endsWith(')')) return null;\n  const name = s.slice(0, open).trim();\n  // Both the legacy comma form and the space form with \"/ alpha\".\n  const body = s.slice(open + 1, -1).replace(/,/g, ' ').replace('/', ' / ');\n  const parts = body.split(/\\s+/).filter(p => p.length > 0);\n  const slash = parts.indexOf('/');\n  const main = slash >= 0 ? parts.slice(0, slash) : parts;\n  const alphaToken = slash >= 0 ? parts[slash + 1] : undefined;\n  let r: number, g: number, b: number, a: number;\n  if (name === 'rgb' || name === 'rgba') {\n    if (main.length < 3) return null;\n    const legacyAlpha = main.length === 4 ? main[3] : alphaToken;\n    r = channel(main[0]!, 255); g = channel(main[1]!, 255); b = channel(main[2]!, 255); a = alpha(legacyAlpha);\n  } else if (name === 'color') {\n    if (main[0] !== 'srgb' || main.length < 4) return null;\n    r = channel(main[1]!, 1); g = channel(main[2]!, 1); b = channel(main[3]!, 1); a = alpha(alphaToken);\n  } else {\n    return null;\n  }\n  if (!Number.isFinite(r) || !Number.isFinite(g) || !Number.isFinite(b) || !Number.isFinite(a)) return null;\n  return { r, g, b, a };\n}\n\nfunction parseHex(h: string): Rgba | null {\n  if (!/^[0-9a-f]+$/.test(h)) return null;\n  const full = h.length === 3 || h.length === 4 ? h.split('').map(c => c + c).join('') : h;\n","exit_code":0,"status":"completed"}}
