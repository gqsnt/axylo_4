 labOfBytes(hexBytes('#777777'))), v).toBeLessThan(0.004);\n   186\t    }\n   187\t    // Deuteranopia collapses red and green toward the same hue: the classic confusion pair gets much closer.\n   188\t    expect(delta(seen(srgb('#d62728'), 'deutan'), seen(srgb('#2ca02c'), 'deutan'))).toBeLessThan(0.5 * delta(seen(srgb('#d62728'), 'normal'), seen(srgb('#2ca02c'), 'normal')));\n   189\t  });\n   190\t\n   191\t  it('models an 8-bit fill within one byte of the pixels two rasterizers produced', () => {\n   192\t    // A CPU Skia raster of the review of 51e1be5 drew #5f2083 and #ba5f50 at 25% over white as #d7c8e0 and #eed7d4.\n   193\t    for (const [color, drawn] of [['#5f2083', '#d7c8e0'], ['#ba5f50', '#eed7d4']] as const) {\n   194\t      const m = raster(color, 0.25, '#ffffff'), d = hexBytes(drawn);\n   195\t      for (const i of [0, 1, 2] as const) expect(Math.abs(m[i] - d[i]), `${color} channel ${i}`).toBeLessThanOrEqual(1);\n   196\t    }\n   197\t    expect(worstWithinOneByte([10, 20, 30], [10, 20, 30])).toBe(0);\n   198\t    expect(worstWithinOneByte([10, 20, 30], [10, 20, 33])).toBeGreaterThan(0);\n   199\t  });\n   200\t});\n   201\t\n   202\tdescribe('default palette (spec A5, decision 0003)', () => {\n   203\t  for (const [name, scheme, other] of SCHEMES) {\n   204\t    const series = scheme.series;\n   205\t    const r = record.schemes[name];\n   206\t\n   207\t    it(`${name}: eight distinct series colors`, () => {\n   208\t      expect(series).toHaveLength(8);\n   209\t      expect(new Set(series).size).toBe(8);\n   210\t      for (const color of series) expect(color).toMatch(/^#[0-9a-f]{6}$/);\n   211\t    });\n   212\t\n   213\t    it(`${name}: 1. every series color reaches 3:1 on the default background`, () => {\n   214\t      const bg = c(scheme.background);\n   215\t      for (const color of series) expect(contrastRatio(c(color), bg), color).toBeGreaterThanOrEqual(3);\n   216\t    });\n   217\t\n   218\t    it(`${name}: 2. the eight are at least 0.10 apart in OKLab under normal vision and simulated protanopia, deuteranopia, tritanopia`, () => {\n   219\t      for (const v of VISIONS) {\n   220\t        const { d, pair } = closest(series, v);\n   221\t        expect(d, `${v}: slots ${pair.join(' and ')}`).toBeGreaterThanOrEqual(0.10);\n   222\t      }\n   223\t    });\n   224\t\n   225\t    it(`${name}: 2. the same after the simulated colors are rounded to bytes`, () => {\n   226\t      for (const v of VISIONS) {\n   227\t        const { d, pair } = closest(series, v, seenBytes);\n   228\t        expect(d, `${v}: slots ${pair.join(' and ')}`).toBeGreaterThanOrEqual(0.10);\n   229\t      }\n   230\t    });\n   231\t\n   232\t    it(`${name}: 3. the first three, four, five and six are at least 0.10 apart, the first four at least 0.14 (analytic and in bytes)`, () => {\n   233\t      for (const n of [3, 4, 5, 6]) for (const v of VISIONS) for (const labOf of [undefined, seenBytes]) {\n   234\t        const { d, pair } = closest(series.slice(0, n), v, labOf);\n   235\t        expect(d, `first ${n}, ${v}${labOf ? ', bytes' : ''}: slots ${pair.join(' and ')}`).toBeGreaterThanOrEqual(n === 4 ? 0.14 : 0.10);\n   236\t      }\n   237\t    });\n   238\t\n   239\t    it(`${name}: 4. slot k is the same hue family in both schemes (OKLCH hue within 30°)`, () => {\n   240\t      series.forEach((color, k) => {\n   241\t        expect(hueDifference(oklch(color)[2], oklch(other.series[k]!)[2]), `slot ${k + 1}: ${color} / ${other.series[k]}`).toBeLessThanOrEqual(30);\n   242\t      });\n   243\t    });\n   244\t\n   245\t    it(`${name}: 5. no series color is within 0.10 of the focus or reference token (nor muted, the donut's \"Other\" slice)`, () => {\n   246\t      for (const token of ['focus', 'reference', 'muted'] as const) {\n   247\t        const t = seen(srgb(scheme[token]), 'normal');\n   248\t        for (const color of series) expect(delta(seen(srgb(color), 'normal'), t), `${color} vs ${token} ${scheme[token]}`).toBeGreaterThanOrEqual(0.10);\n   249\t      }\n   250\t    });\n   251\t\n   252\t    it(`${name}: 6. neighbours k and k+1 stay 0.06 apart as fills at 25% and 80% over the background`, () => {\n   253\t      for (const alpha of ALPHAS) {\n   254\t        const labs = series.map(color => seen(over(color, alpha, scheme.background), 'normal'));\n   255\t        for (let k = 0; k + 1 < labs.length; k++) {\n   256\t          expect(delta(labs[k]!, labs[k + 1]!), `${alpha * 100}%: slots ${k + 1} and ${k + 2}`).toBeGreaterThanOrEqual(0.06);\n   257\t        }\n   258\t      }\n   259\t    });\n   260\t\n   261\t    it(`${name}: 6. the same on an 8-bit raster, with alpha quantised by rounding and by flooring`, () => {\n   262\t      for (const alpha of ALPHAS) for (const quantise of [Math.round, Math.floor]) {\n   263\t        const px = series.map(color => raster(color, alpha, scheme.background, quantise));\n   264\t        for (let k = 0; k + 1 < px.length; k++) {\n   265\t          expect(delta(labOfBytes(px[k]!), labOfBytes(px[k + 1]!)), `${alpha * 100}%, ${quantise.name}: slots ${k + 1} and ${k + 2}`).toBeGreaterThanOrEqual(0.06);\n   266\t        }\n   267\t      }\n   268\t    });\n   269\t\n   270\t    it(`${name}: 6. the same on the pixels Chrome drew (research/palette/raster.json, canvas and SVG)`, () => {\n   271\t      expect(record.refused).toEqual([]);\n   272\t      expect(Object.keys(r.chromeRaster).sort()).toEqual(['canvas', 'svg']);\n   273\t      for (const [via, byAlpha] of Object.entries(r.chromeRaster)) {\n   274\t        expect(Object.keys(byAlpha).map(Number).sort()).toEqual([...ALPHAS]);\n   275\t        for (const alpha of ALPHAS) {\n   276\t          const drawn = byAlpha[String(alpha)]!.pixels;\n   277\t          expect(drawn).toHaveLength(8);\n   278\t          drawn.forEach((hex, k) => {\n   279\t            // The recorded pixel is a fill of this slot's color: within one byte of the model.\n   280\t            const m = raster(series[k]!, alpha, scheme.background), d = hexBytes(hex);\n   281\t            for (const i of [0, 1, 2] as const) expect(Math.abs(m[i] - d[i]), `${via} ${alpha} slot ${k + 1}`).toBeLessThanOrEqual(1);\n   282\t          });\n   283\t          for (let k = 0; k + 1 < drawn.length; k++) {\n   284\t            expect(delta(labOfBytes(hexBytes(drawn[k]!)), labOfBytes(hexBytes(drawn[k + 1]!))), `${via} ${alpha * 100}%: slots ${k + 1} and ${k + 2}`).toBeGreaterThanOrEqual(0.06);\n   285\t          }\n   286\t        }\n   287\t      }\n   288\t    });\n   289\t\n   290\t    it(`${name}: the research record holds these colors, its tokens, and the measured fields listed in research/palette/README.md at their written precision`, () => {\n   291\t      expect(r.background).toBe(scheme.background);\n   292\t      expect(r.tokens).toEqual({ axis: scheme.axis, grid: scheme.grid, muted: scheme.muted, reference: scheme.reference, focus: scheme.focus });\n   293\t      const Ls = series.map(color => oklch(color)[0]), Cs = series.map(color => oklch(color)[1]);\n   294\t      expect(atPrecision(Math.min(...Ls), r.lightness.min, 3) && atPrecision(Math.max(...Ls), r.lightness.max, 3), 'lightness range').toBe(true);\n   295\t      expect(atPrecision(Math.max(...Ls.slice(0, 3)) - Math.min(...Ls.slice(0, 3)), r.lightness.firstThreeSpread, 3), 'first-three spread').toBe(true);\n   296\t      expect(atPrecision(Math.max(...Cs), r.lightness.maxChroma, 3), 'largest chroma').toBe(true);\n   297\t      expect(r.series.map(s => s.hex)).toEqual([...series]);\n   298\t      series.forEach((color, k) => {\n   299\t        const s = r.series[k]!, [L, C, h] = oklch(color);\n   300\t        expect(s.slot).toBe(k + 1);\n   301\t        expect(atPrecision(L, s.oklch[0]!, 3) && atPrecision(C, s.oklch[1]!, 3) && atPrecision(h, s.oklch[2]!, 1), `${color} OKLCH ${s.oklch.join(' ')}`).toBe(true);\n   302\t        expect(atPrecision(contrastRatio(c(color), c(scheme.background)), s.contrast, 2), `${color} contrast ${s.contrast}`).toBe(true);\n   303\t        expect(atPrecision(hueDifference(h, oklch(other.series[k]!)[2]), s.hueDiffToOtherScheme, 1), `slot ${k + 1} hue shift`).toBe(true);\n   304\t      });\n   305\t      const pairs = (measured: { d: number; pair: number[] }, rec: PairRecord, label: string): void => {\n   306\t        expect(atPrecision(measured.d, rec.min, 3), `${label}: ${measured.d} vs ${rec.min}`).toBe(true);\n   307\t        expect(rec.pair, label).toEqual(measured.pair);\n   308\t      };\n   309\t      for (const v of VISIONS) {\n   310\t        pairs(closest(series, v), r.minDelta[v], `all 8, ${v}`);\n   311\t        pairs(closest(series, v, seenBytes), r.minDeltaBytes[v], `all 8, ${v}, bytes`);\n   312\t        for (const n of [3, 4, 5, 6]) {\n   313\t          pairs(closest(series.slice(0, n), v), r.prefixes[n]![v], `first ${n}, ${v}`);\n   314\t          pairs(closest(series.slice(0, n), v, seenBytes), r.prefixesBytes[n]![v], `first ${n}, ${v}, bytes`);\n   315\t        }\n   316\t      }\n   317\t      for (const token of ['focus', 'reference', 'muted'] as const) {\n   318\t        const t = seen(srgb(scheme[token]), 'normal'), ds = series.map(color => delta(seen(srgb(color), 'normal'), t));\n   319\t        const min = Math.min(...ds);\n   320\t        expect(atPrecision(min, r.tokenDistance[token]!.min, 3), token).toBe(true);\n   321\t        expect(r.tokenDistance[token]!.slot, token).toBe(ds.indexOf(min) + 1);\n   322\t      }\n   323\t      for (const alpha of ALPHAS) {\n   324\t        const key = String(alpha);\n   325\t        for (const v of VISIONS) {\n   326\t          // Fills under every vision, neighbours and the closing pairs of a donut ring (recorded, not required).\n   327\t          const labs = series.map(color => oklab(simulated(over(color, alpha, scheme.background), v)));\n   328\t          const nb = labs.slice(1).map((l, k) => delta(labs[k]!, l));\n   329\t          const rec = r.composites[key]![v];\n   330\t          nb.forEach((d, k) => expect(atPrecision(d, rec.neighbours[k]!, 3), `${alpha} ${v} neighbours ${k + 1}`).toBe(true));\n   331\t          expect(atPrecision(Math.min(...nb), rec.minNeighbour, 3), `${alpha} ${v}`).toBe(true);\n   332\t          expect(rec.pair).toEqual([nb.indexOf(Math.min(...nb)) + 1, nb.indexOf(Math.min(...nb)) + 2]);\n   333\t          const ring = [3, 4, 5, 6, 7, 8].map(n => ({ slots: [n, 1], d: delta(labs[n - 1]!, labs[0]!) }));\n   334\t          expect(rec.ringClosures.map(x => x.slots)).toEqual(ring.map(x => x.slots));\n   335\t          ring.forEach((x, k) => expect(atPrecision(x.d, rec.ringClosures[k]!.d, 3), `${alpha} ${v} ring ${x.slots.join('-')}`).toBe(true));\n   336\t        }\n   337\t        const px = series.map(color => raster(color, alpha, scheme.background));\n   338\t        const hex = (p: Vec3): string => '#' + p.map(v => v.toString(16).padStart(2, '0')).join('');\n   339\t        expect(r.raster[key]!.model).toEqual(px.map(hex));\n   340\t        expect(r.raster[key]!.modelFloor).toEqual(series.map(color => hex(raster(color, alpha, scheme.background, Math.floor))));\n   341\t        px.slice(1).forEach((p, k) => {\n   342\t          expect(atPrecision(delta(labOfBytes(px[k]!), labOfBytes(p)), r.raster[key]!.neighboursModel[k]!, 3), `${alpha} model ${k + 1}`).toBe(true);\n   343\t          expect(atPrecision(worstWithinOneByte(px[k]!, p), r.raster[key]!.neighboursWorstWithinOneByte[k]!, 3), `${alpha} worst ${k + 1}`).toBe(true);\n   344\t        });\n   345\t        for (const via of ['canvas', 'svg']) {\n   346\t          const x = r.chromeRaster[via]![key]!;\n   347\t          const d = x.pixels.slice(1).map((p, k) => delta(labOfBytes(hexBytes(x.pixels[k]!)), labOfBytes(hexBytes(p))));\n   348\t          d.forEach((v, k) => expect(atPrecision(v, x.neighbours[k]!, 3), `${via} ${alpha} ${k + 1}`).toBe(true));\n   349\t          expect(atPrecision(Math.min(...d), x.min, 3)).toBe(true);\n   350\t        }\n   351\t      }\n   352\t    });\n   353\t\n   354\t    it(`${name}: the 2 px stroke record is these colors, and every statistic in it follows from the raw pixel record`, () => {\n   355\t      const s = record.strokes.schemes[name], raw = strokesRaw.schemes[name];\n   356\t      expect(s.background).toBe(scheme.background);\n   357\t      expect(raw.background).toBe(scheme.background);\n   358\t      expect(s.rows.map(row => row.color)).toEqual([...series]);\n   359\t      expect(raw.rows.map(row => row.color)).toEqual([...series]);\n   360\t      s.rows.forEach((row, k) => {\n   361\t        const rawRow = raw.rows[k]!, ch = rawRow.channel as 0 | 1 | 2;\n   362\t        expect(atPrecision(contrastRatio(c(row.color), c(scheme.background)), row.swatch, 2), `${row.color} swatch`).toBe(true);\n   363\t        // The deciding channel is the one where ink and background differ most.\n   364\t        const ink = hexBytes(row.color), back = hexBytes(scheme.background);\n   365\t        expect(Math.abs(ink[ch] - back[ch])).toBe(Math.max(...[0, 1, 2].map(i => Math.abs(ink[i as 0] - back[i as 0]))));\n   366\t        for (const key of RENDERERS) {\n   367\t          const st = row[key] as StrokeStats, again = strokeStats(row.color, scheme.background, ch, rawRow[key] as string);\n   368\t          expect(st.columns, `${row.color} ${key}`).toBe(again.columns);\n   369\t          expect(st.columnsWithoutFullCoverage, `${row.color} ${key}`).toBe(again.columnsWithoutFullCoverage);\n   370\t          for (const stat of ['core', 'weighted'] as const) for (const q of ['p10', 'median'] as const) {\n   371\t            expect(atPrecision(again[stat][q], st[stat][q], 2), `${row.color} ${key} ${stat} ${q}: ${again[stat][q]} vs ${st[stat][q]}`).toBe(true);\n   372\t          }\n   373\t        }\n   374\t      });\n   375\t    });\n   376\t\n   377\t    it(`${name}: the preview PNG itself (donut slices read back from each row) matches the palette and keeps 0.10 apart`, () => {\n   378\t      const img = r.previewImage, rows = { normal: 'normal', protanopia: 'protan', deuteranopia: 'deutan', tritanopia: 'tritan' } as const;\n   379\t      expect(img.normal!.pixels).toEqual([...series]);\n   380\t      for (const [row, v] of Object.entries(rows)) {\n   381\t        const px = img[row]!.pixels;\n   382\t        px.forEach((hex, k) => {\n   383\t          // The image is the byte-rounding model within one byte per channel (Chrome's filter rounds differently).\n   384\t          const model = vec(i => Math.round(255 * enc(simulated(srgb(series[k]!), v)[i]))), d = hexBytes(hex);\n   385\t          for (const i of [0, 1, 2] as const) expect(Math.abs(model[i] - d[i]), `${row} slot ${k + 1}`).toBeLessThanOrEqual(1);\n   386\t        });\n   387\t        const labs = px.map(hex => labOfBytes(hexBytes(hex)));\n   388\t        let min = Infinity, pair = [0, 0];\n   389\t        for (let i = 0; i < 8; i++) for (let j = i + 1; j < 8; j++) { const d = delta(labs[i]!, labs[j]!); if (d < min) { min = d; pair = [i + 1, j + 1]; } }\n   390\t        expect(min, `${row}: slots ${pair.join(' and ')}`).toBeGreaterThanOrEqual(0.10);\n   391\t        expect(atPrecision(min, img[row]!.min, 3)).toBe(true);\n   392\t        expect(img[row]!.pair).toEqual(pair);\n   393\t      }\n   394\t    });\n   395\t\n   396\t    it(`${name}: the one-byte-edit count in the record is what every check gives for every one-byte edit`, () => {\n   397\t      let edits = 0, pass = 0;\n   398\t      series.forEach((hex, k) => {\n   399\t        for (const ch of [0, 1, 2] as const) for (const d of [-1, 1]) {\n   400\t          const b = [...hexBytes(hex)]; b[ch] = b[ch]! + d;\n   401\t          if (b[ch]! < 0 || b[ch]! > 255) continue;\n   402\t          const edited = series.slice(); edited[k] = '#' + b.map(v => v.toString(16).padStart(2, '0')).join('');\n   403\t          edits++;\n   404\t          if (meetsEveryCheck(edited, scheme, other.series)) pass++;\n   405\t        }\n   406\t      });\n   407\t      expect(meetsEveryCheck(series, scheme, other.series)).toBe(true);\n   408\t      expect(record.oneByteEdits[name]).toEqual({ edits, stillMeetEveryCheck: pass });\n   409\t    });\n   410\t\n   411\t    it(`${name}: token colors meet spec L2 (axis and focus 3:1; muted and reference 4.5:1, they label text)`, () => {\n   412\t      const bg = c(scheme.background);\n   413\t      expect(contrastRatio(c(scheme.axis), bg)).toBeGreaterThanOrEqual(3);\n   414\t      expect(contrastRatio(c(scheme.focus), bg)).toBeGreaterThanOrEqual(3);\n   415\t      expect(contrastRatio(c(scheme.muted), bg)).toBeGreaterThanOrEqual(4.5);\n   416\t      expect(contrastRatio(c(scheme.reference), bg)).toBeGreaterThanOrEqual(4.5);\n   417\t    });\n   418\t  }\n   419\t});\n   420\t\n   421\tdescribe('default stylesheet', () => {\n   422\t  it('defines the light and dark token sets, forced colors and the dash switch', () => {\n   423\t    for (let i = 1; i <= 8; i++) {\n   424\t      // Public names today, private defaults (--axylo-default-series-N) once the review's stylesheet change lands.\n   425\t      expect(AXYLO_CSS).toMatch(new RegExp(`--axylo-(default-)?series-${i}: ${LIGHT.series[i - 1]};`));\n   426\t      expect(AXYLO_CSS).toMatch(new RegExp(`--axylo-(default-)?series-${i}: ${DARK.series[i - 1]};`));\n   427\t      expect(AXYLO_CSS).toContain(`--axylo-series-${i}: CanvasText !important;`);\n   428\t    }\n   429\t    expect(AXYLO_CSS).toContain('.axylo[data-axylo-scheme=\"dark\"]');\n   430\t    expect(AXYLO_CSS).toContain('@media (forced-colors: active)');\n   431\t    expect(AXYLO_CSS).toMatch(/@media \\(prefers-contrast: more\\), \\(forced-colors: active\\) \\{\\s*(\\.axylo )?\\.axylo-svg \\.axylo-dashed \\{ stroke-dasharray: var\\(--axylo-dash-contrast/);\n   432\t    expect(AXYLO_CSS).toContain('--axylo-stylesheet: loaded');\n   433\t  });\n   434\t\n   435\t  it('never sets what scheme detection reads (color-scheme, color, --axylo-background) outside forced colors', () => {\n   436\t    const outsideForced = AXYLO_CSS.replace(/@media \\(forced-colors: active\\) \\{[\\s\\S]*?\\n {2}\\}\\n/, '');\n   437\t    expect(outsideForced).not.toMatch(/color-scheme\\s*:/);\n   438\t    expect(outsideForced).not.toMatch(/--axylo-background\\s*:/);\n   439\t    expect(outsideForced).not.toMatch(/\\.axylo\\s*\\{[^}]*[^-]color\\s*:/);\n   440\t  });\n   441\t\n   442\t  it('keeps the marker that separates the figure module\\'s structure rules from the token and mark part', () => {\n   443\t    const marker = AXYLO_CSS.indexOf('/* structure: added by the figure module');\n   444\t    expect(marker).toBeGreaterThan(AXYLO_CSS.indexOf('.axylo-text'));\n   445\t  });\n   446\t\n   447\t  it('balances its braces', () => {\n   448\t    expect(AXYLO_CSS.split('{').length).toBe(AXYLO_CSS.split('}').length);\n   449\t  });\n   450\t});\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '63,152p' reviews/2026-11-18/impl/wp/misc-opus.review.md && rg -n 'A5[. |*]|L2[. |*]' docs/02-product-spec.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc \"sed -n '63,152p' reviews/2026-11-18/impl/wp/misc-opus.review.md && rg -n 'A5[. |*]|L2[. |*]' docs/02-product-spec.md\"","aggregated_output":"## B. Palette refit · `52bbdf0`\n\n### Findings\n\n1. **B · The new dark focus token fails the adjacent-colour target. Ran WCAG contrast arithmetic and traced the focus geometry.** `#e3e8f0` gives **14.433:1** on `#16181d`. Against dark slots 1–8 it gives **1.934, 2.446, 1.195, 4.424, 3.739, 1.316 and 1.682 and 3.230:1**, respectively. Blue, orange, green, cyan and pink fail. The square datum outline can cross neighbouring marks and uses a single focus ink. Its OKLab separation cannot establish this contrast. In fact, the background and purple force a light single ink, and even white cannot reach 3:1 against the green. **Fix:** use a visible two-tone outline or a guaranteed background surround, for both the plot and datum indicators where they can cross marks. Check the actual adjacent colours. WCAG **1.4.11** supplies the adjacent-colour test. **2.4.11** is Focus Not Obscured and requires a layout check. **2.4.13** separately compares the same pixels in focused and unfocused states. [Token](/home/canarit/projects/axylo/packages/axylo/src/theme/palette.ts:45) · [Datum outline](/home/canarit/projects/axylo/packages/axylo/src/core/focus.ts:252) · [WCAG 1.4.11](https://www.w3.org/WAI/WCAG22/Understanding/non-text-contrast.html) · [WCAG 2.4.11](https://www.w3.org/WAI/WCAG22/Understanding/focus-not-obscured-minimum.html) · [WCAG 2.4.13](https://www.w3.org/WAI/WCAG22/Understanding/focus-appearance.html)\n\n2. **m · The simulated preview has a smaller margin than the byte model. Ran pixel extraction on the committed PNGs.** Light tritan slot 7 is `#b30f41` in the preview and `#b20f41` in the independently rounded model. The light tritan 5–7 distance is **0.100475** in the image versus **0.102175** in the model. The PNG still clears 0.10, and every other sampled channel matched. **Fix:** distinguish the image from the rounding model in the decision and retain a PNG-interior check. [Decision’s byte claim](/home/canarit/projects/axylo/docs/decisions/0003-default-palette.md:55) · [Preview filters](/home/canarit/projects/axylo/research/palette/preview.html:18)\n\n3. **m · The record checks cover fewer fields than they claim. Ran mutations in memory.** A wrong closest pair, a **0.01** contrast change, zeroed OKLCH coordinates and a stroke median of 99 each failed. All **32** palette tests still passed with a plausible but false stroke p10/median of **1.01/1.02**, and with false stored token, simulated-fill, lightness and edit-count fields. The scorer checks browser-record colours and backgrounds before importing them, but it rounds its Chrome distance before its pass/fail comparison. **Fix:** check the published fields against their independent calculation or the pinned raw measurement record, and apply the limit before rounding. Narrow the test’s “every measured field” claim to the fields it verifies. [Record test](/home/canarit/projects/axylo/packages/axylo/test/theme/palette.test.ts:234) · [Stroke assertions](/home/canarit/projects/axylo/packages/axylo/test/theme/palette.test.ts:287) · [Scorer](/home/canarit/projects/axylo/research/palette/score.mjs:68)\n\n4. **m · Two corrected passages still overstate their evidence. Ran the record comparison and reasoned from the stroke sampler.** The dark green DPR 1 weighted p10 is **8.32 Canvas / 8.23 SVG**, a **0.09** difference against the stated maximum of 0.05. Dark cyan differs by 0.07. Rounded core p10 equality does not recover the full-coverage count. The dark first-three normal closest pair is **2–3** at **0.251291**. The JSON is correct and the decision says **1–3**. The source palette comment also retains “left no room” for the former focus blue after the decision qualified that result as a timed search. **Fix:** label the stroke rows by renderer, retain raw coverage if claiming a count, correct the pair, and use the bounded search claim in the source comment. [Prefix table](/home/canarit/projects/axylo/docs/decisions/0003-default-palette.md:86) · [Stroke conclusion](/home/canarit/projects/axylo/docs/decisions/0003-default-palette.md:122) · [Palette comment](/home/canarit/projects/axylo/packages/axylo/src/theme/palette.ts:11)\n\n### Independent measurements\n\nI used linear sRGB → D65 XYZ → LMS → OKLab, WCAG luminance and full-severity Machado matrices. I rescored the recorded fill pixels directly. The independently rounded JSON values and pair identities agreed for the series, prefixes, token distances and fill rows I recomputed.\n\n| Slot | Light OKLCH | Light contrast | Dark OKLCH | Dark contrast | Hue shift |\n|---|---|---:|---|---:|---:|\n| 1 | .65984 / .14968 / 254.09° | 3.12186 | .73054 / .13525 / 251.85° | 7.46150 | 2.24° |\n| 2 | .67998 / .17508 / 51.91° | 3.05603 | .68092 / .15018 / 53.98° | 5.90148 | 2.07° |\n| 3 | .43000 / .14017 / 141.05° | 7.66859 | .86186 / .12085 / 133.26° | 12.07884 | 7.79° |\n| 4 | .43462 / .20512 / 310.08° | 8.93329 | .54393 / .17690 / 311.58° | 3.26215 | 1.50° |\n| 5 | .58678 / .13026 / 18.31° | 4.44794 | .57968 / .15057 / 31.95° | 3.86024 | 13.64° |\n| 6 | .54943 / .11522 / 234.15° | 4.75798 | .83482 / .11017 / 225.24° | 10.96692 | 8.91° |\n| 7 | .48859 / .17504 / 354.96° | 6.96149 | .78591 / .11937 / 0.71° | 8.58329 | 5.75° |\n| 8 | .66837 / .02645 / 283.13° | 3.02637 | .59924 / .03095 / 274.34° | 4.46895 | 8.79° |\n\nPrefix minima below are **analytic / byte-rounded**, in normal, protan, deutan and tritan order.\n\n| Prefix | Light | Dark |\n|---|---|---|\n| First 3 | .31936/.31936 · .15557/.15541 · .26996/.27056 · .24313/.24141 | .25129/.25129 · .24686/.24606 · .17800/.17750 · .15849/.15906 |\n| First 4 | .28436/.28436 · .15557/.15541 · .21746/.21728 · .15730/.15747 | .24553/.24553 · .24686/.24606 · .17800/.17750 · .15849/.15906 |\n| First 5 | .13533/.13533 · .10289/.10281 · .13599/.13716 · .10227/.10300 | .11640/.11640 · .12566/.12503 · .10852/.10869 · .10337/.10214 |\n| First 6 | .12427/.12427 · .10289/.10281 · .11728/.11720 · .10227/.10290 | .11640/.11640 · .12392/.12411 · .10852/.10869 · .10337/.10214 |\n| All 8 | .12403/.12403 · .10289/.10281 · .10342/.10345 · .10227/.10217 | .11640/.11640 · .10370/.10304 · .10301/.10217 · .10233/.10214 |\n\n| Other check | Light | Dark |\n|---|---:|---:|\n| Nearest focus / reference / muted | .100772 / .152348 / .110171 | .138042 / .104214 / .113348 |\n| 25% fill, ideal / round-alpha / floor-alpha / Chrome Canvas / Chrome SVG | .063696 / .063379 / .063351 / .063379 / .063379 | .063836 / .063524 / .064321 / .062652 / .062652 |\n| 80% fill, same order | .201393 / .201561 / .201561 / .201561 / .201561 | .178653 / .179037 / .179037 / .179152 / .179152 |\n| 25% fill, worst within one byte per channel | .056008 | .056477 |\n\nI also imported the installed `d3-scale-chromatic` **3.1.1** exports directly. The white-background counts below 3:1 reproduced as **5/10, 6/10, 4/10, 2/8 and 5/9** for Tableau 10, Observable 10, Category 10, Dark2 and Set1. All five first-eight distance rows reproduced at published precision, including Tableau’s red–green deutan distance of **0.006640**. [Reference record](/home/canarit/projects/axylo/research/palette/references.json)\n\n### More even light scheme\n\nI found the following pair through a wider hue search and independently rescored the resulting hex bytes. I allowed the dark partner to change while preserving `#64acfa`, both backgrounds and all tokens. The search holding **all eight** shipped dark colours fixed did not find a match. The example uses a bluer sixth slot and a green-grey neutral.\n\n```text\nLight  #1e97fa #c7872b #0f6f48 #8636c1 #c61405 #4f81b7 #921184 #8c9695\nDark   #64acfa #fbab2d #96e8c6 #9f46ae #fe573f #387bf0 #d571aa #5f6866\n```\n\n| Independently rescored | Light | Dark |\n|---|---:|---:|\n| OKLab L range | .460259–.672961 | .508900–.868833 |\n| Maximum OKLCH chroma | .207247 | .206878 |\n| Minimum background contrast | 3.030786 | 3.093900 |\n| All-eight minimum, analytic / bytes | .102381 / .102584 | .104403 / .105158 |\n| First-four minimum, analytic / bytes | .147095 / .146050 | .142679 / .141610 |\n| Nearest focus / reference / muted | .116345 / .129962 / .113856 | .112977 / .114918 / .120400 |\n| Minimum 25% fill across ideal and both byte models | .063153 | .064058 |\n| Minimum 80% fill across the same models | .209047 | .168102 |\n\nMaximum cross-scheme hue shift is **14.984°**. This meets the published solver margins. Browser rasterisation of the alternate pair is unverified.\n\n### Disposition of the nine earlier findings\n\n| Earlier finding | Status | Evidence |\n|---|---|---|\n| 1. Area swatches lose shape | **Fixed in the core** | Ran eight real swatch paths in Node and got eight distinct markers over the chips. Legend and tooltip share that path. The full rendered A5 suite was outside this run. |\n| 2. 25% fill raster failure | **Fixed for isolated fills** | Both recorded renderers clear 0.06 on both backgrounds. Overlap is outside the declared test. |\n| 3. Simulated preview pairs below 0.10 | **Fixed with a new defect** | Sampled PNG pairs pass. The claimed equality to the rounding model is off by one byte. |\n| 4. Lightness spread claimed necessary | **Fixed in the decision** | The text distinguishes finite search from proof. The source comment needs the same qualification. |\n| 5. Explorer timeout prunes orders | **Fixed** | Ran timeout and completed-prune cases. Traced the feasible-incumbent branch. Only a completed proof prunes the full order. |\n| 6. Stroke claims | **Partly** | The weighted statistic is now scoped to legibility. The numerical renderer-agreement and coverage wording still need correction. |\n| 7. Record cross-check | **Partly** | Pair identities, OKLCH and precision checks caught the old mutations. Plausible false stroke and unverified record fields passed. |\n| 8. Hand edits claimed fragile | **Fixed** | Independent enumeration reproduced **41/46 light** and **46/47 dark** passing edits. |\n| 9. Reference palettes | **Fixed** | The installed arrays and all five measured rows reproduced. |\n\n**Ran:** The in-memory palette mutation baseline finished `32 passed, 0 failed`. Both final fixed-grid searches completed and reproduced the refit, in **78 light** and **17,539 dark** nodes.\n\n- **Sound · Opaque palette.** Both schemes pass the contrast and separation limits under the four requested vision models.\n- **Sound · Isolated fills.** The ideal, byte-model and committed Chrome pixel rows clear 0.06 at both opacities.\n- **Sound · Feasibility.** The wider search produced a pair satisfying the requested lightness floor, chroma cap and solver margins.\n- **Sound · References.** The versioned D3 inputs and their recorded results match.\n\n## C. React adapter · `a63bbee`\n112:| L2 | Text is at least 12 CSS px and at least 4.5:1 against what is behind it, including text drawn inside a mark and legend entries for hidden series. Marks, axis lines and focus indicators are at least 3:1. Gridlines are exempt: they are not needed to read a value while the tooltip and table exist. Holds in light and dark. | Computed-style and rendered-pixel checks in both schemes | R7, R10 |\n141:| A5 | Series are never distinguished by color alone, in any mode. Each line and area carries a shape marker at its last point and at sparse intervals, repeated in the legend and tooltip; under `prefers-contrast: more` or forced colors, lines also differ by dash. Adjacent filled marks (slices, stacked segments) are separated by at least 1 px of background. The default palette has eight colors, each at least 3:1 on the default light and dark backgrounds, with a minimum pairwise OKLab difference of 0.10 (provisional) under normal vision and simulated protanopia, deuteranopia and tritanopia. On any other background, Axylo measures the palette against the resolved background and raises AX141 below 3:1. | Palette script scoring the rendered marks of an eight-series chart in both schemes, repeats included; rendered-pixel checks of separators; a grayscale screenshot in which three crossing lines can be told apart by marker | R7, WCAG 1.4.1, 1.4.11 |\n298:| Is the palette that meets A5 one people want to look at? | Hand-tune from the search output with the thresholds in CI. | M5. |\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"rg -n 'sample|donut|pixels|png|cx|cy' research/palette/preview.mjs && cat research/palette/strokes.mjs | tail -125 && ls node_modules | rg 'png|sharp|vitest|chai'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc \"rg -n 'sample|donut|pixels|png|cx|cy' research/palette/preview.mjs && cat research/palette/strokes.mjs | tail -125 && ls node_modules | rg 'png|sharp|vitest|chai'\"","aggregated_output":"3:// 80%, a donut with 1 px separators, grouped bars) under normal vision, simulated protanopia, deuteranopia,\n10:// With --shot and one palette it also writes <name>-pixels.json: the donut slice colors read back from each row of\n89:    case 'circle': return '<circle cx=\"' + x + '\" cy=\"' + y + '\" r=\"' + r + '\" ' + s + '/>';\n128:function donut(t, cols) {\n129:  const v = [30, 22, 16, 12, 9, 7, 6, 5], tot = v.reduce((a, b) => a + b, 0), cx = W / 2, cy = H / 2, R = 52, r0 = 31;\n132:    const b = a + 2 * Math.PI * x / tot, large = b - a > Math.PI ? 1 : 0, p = (rr, t) => (cx + rr * Math.cos(t)).toFixed(2) + ' ' + (cy + rr * Math.sin(t)).toFixed(2);\n158:      + '<div class=\"heads\"><span></span><span>3 lines, 2 px</span><span>5 lines</span><span>8 lines</span><span>3 areas, 25%</span><span>8 stacked, 80%</span><span>donut, 8 slices</span><span>grouped bars, 6</span></div>');\n161:      row.innerHTML = '<span class=\"label\">' + label + '</span>' + [lines(3, t, cols), lines(5, t, cols), lines(8, t, cols), overlap(t, cols), stacked(t, cols), donut(t, cols), bars(t, cols)].map(s => '<div class=\"cell\" style=\"filter:' + (filter || 'none') + '\">' + s + '</div>').join('');\n176:  const pixels = { method: 'one pixel at the middle of each donut slice (radius 41.5 of the 190×120 cell), per vision row, read from the PNG', schemes: {} };\n183:    const png = path.join(outDir, `${name}-${scheme}.png`);\n184:    const buffer = await page.screenshot({ path: png, clip: box });\n185:    console.log('wrote', png);\n187:      // Read back the middle of every donut slice in every row of the PNG just written, so the record can score\n189:      pixels.schemes[scheme] = await page.evaluate(async ({ b64, box }) => {\n191:        const img = new Image(); img.src = 'data:image/png;base64,' + b64; await img.decode();\n207:      pixels.schemes[scheme].background = theme[scheme].background;\n208:      pixels.schemes[scheme].series = palette[scheme];\n214:    const file = path.join(outDir, `${name}-pixels.json`);\n215:    fs.writeFileSync(file, JSON.stringify(pixels, null, 1) + '\\n');\n// Effective contrast of a 2 px line as Chrome renders it. Antialiasing blends a thin stroke's edge pixels with\n// the background, so a line reads lighter (on white) or darker (on dark) than its swatch. For each series color\n// this draws a random-walk polyline like a real data line (every angle, sub-pixel positions) at 2 CSS px through\n// the 2D canvas and through SVG (rasterized by drawing the SVG into a canvas), at device pixel ratios 1 and 2,\n// and reads the pixels back. Per pixel column it derives each pixel's coverage (how far the pixel moved from the\n// background toward the stroke color) and reports two colors for the cross-section:\n//   core      the most covered pixel (the darkest one on white);\n//   weighted  the coverage-weighted mean of the pixels the stroke touches, bg + (Σc² / Σc)(ink − bg), which is\n//             what the eye averages when the line is too thin to resolve its edge.\n// For each, the 10th percentile and the median contrast over all columns, and how many columns have no fully covered\n// pixel. The raw channel bytes go to strokes-raw.json.gz, from which the unit test recomputes every statistic.\n//\n//   node research/palette/strokes.mjs [--out=research/palette/strokes.json] [--raw=research/palette/strokes-raw.json.gz]\n//   node research/palette/strokes.mjs --palette=research/palette/candidates/candidate-b.json \\\n//     --out=research/palette/strokes-b.json --raw=research/palette/strokes-b-raw.json.gz\nimport fs from 'node:fs';\nimport path from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { gzipSync } from 'node:zlib';\nimport { chromium } from 'playwright-core';\nimport { contrast, strokeStats } from './color.mjs';\nimport { readThemeFile } from './theme-file.mjs';\n\nconst here = path.dirname(fileURLToPath(import.meta.url));\nconst args = Object.fromEntries(process.argv.slice(2).map(a => a.replace(/^--/, '').split('=')).map(([k, v]) => [k, v ?? 'true']));\nconst theme = readThemeFile();\n// --palette= measures a candidate's series ({ light: [8 hex], dark: [8 hex] }) on the shipped backgrounds.\nif (args.palette) {\n  if (!args.out || !args.raw) throw new Error('--palette needs --out and --raw (the defaults are the shipped record)');\n  const p = JSON.parse(fs.readFileSync(args.palette, 'utf8'));\n  for (const s of ['light', 'dark']) theme[s].series = p[s];\n}\n\nconst browser = await chromium.launch({ channel: 'chrome', headless: true });\nconst page = await browser.newPage();\nawait page.setContent('<!doctype html><html><body></body></html>');\nconst raw = { method: 'per renderer, base64 of [count, channel bytes…] per pixel column; channel = the one with the largest ink–background difference', schemes: {} };\nconst result = {\n  method: 'random-walk polyline (120 points over 600 CSS px, steps up to ±9 px), stroke width 2, round joins; per pixel column, '\n    + 'core = most covered pixel, weighted = coverage-weighted mean of touched pixels (coverage > 0.02); p10 and median over columns',\n  chrome: browser.version(), schemes: {},\n};\n\nfor (const scheme of ['light', 'dark']) {\n  const t = theme[scheme], rows = [], rawRows = [];\n  for (const color of t.series) {\n    const columns = await page.evaluate(async ({ color, bg }) => {\n      const hex = h => [1, 3, 5].map(i => parseInt(h.slice(i, i + 2), 16));\n      const ink = hex(color), back = hex(bg);\n      const ch = [0, 1, 2].reduce((m, i) => (Math.abs(ink[i] - back[i]) > Math.abs(ink[m] - back[m]) ? i : m), 0);\n      const Wd = 600, Ht = 140, N = 120;\n      let s = 12345; const r = () => { s = (s * 1103515245 + 12345) & 0x7fffffff; return s / 0x7fffffff; };\n      const pts = []; let y = 70.37;\n      for (let i = 0; i < N; i++) { y = Math.min(Ht - 12, Math.max(12, y + (r() - 0.5) * 18)); pts.push([10.21 + i * (Wd - 20) / (N - 1), y]); }\n      const d = pts.map((p, i) => (i ? 'L' : 'M') + p[0].toFixed(3) + ' ' + p[1].toFixed(3)).join('');\n      const out = {};\n      for (const dpr of [1, 2]) for (const via of ['canvas', 'svg']) {\n        const c = document.createElement('canvas'); c.width = Wd * dpr; c.height = Ht * dpr;\n        const g = c.getContext('2d');\n        g.fillStyle = bg; g.fillRect(0, 0, c.width, c.height);\n        if (via === 'canvas') {\n          g.scale(dpr, dpr); g.strokeStyle = color; g.lineWidth = 2; g.lineJoin = 'round';\n          g.beginPath(); pts.forEach((p, i) => (i ? g.lineTo(p[0], p[1]) : g.moveTo(p[0], p[1]))); g.stroke();\n        } else {\n          const svg = '<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"' + Wd * dpr + '\" height=\"' + Ht * dpr + '\" viewBox=\"0 0 ' + Wd + ' ' + Ht + '\"><path d=\"' + d + '\" fill=\"none\" stroke=\"' + color + '\" stroke-width=\"2\" stroke-linejoin=\"round\"/></svg>';\n          const img = new Image(); img.src = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg); await img.decode();\n          g.drawImage(img, 0, 0);\n        }\n        const px = g.getImageData(0, 0, c.width, c.height).data, cols = [];\n        for (let x = 12 * dpr; x < (Wd - 12) * dpr; x++) {\n          // Raw bytes of the deciding channel for every pixel of the column the stroke touched (coverage > 0.02).\n          const vs = [];\n          for (let yy = 0; yy < c.height; yy++) { const v = px[(yy * c.width + x) * 4 + ch]; if ((v - back[ch]) / (ink[ch] - back[ch]) > 0.02) vs.push(v); }\n          cols.push(vs);\n        }\n        out[via + '@' + dpr] = cols;\n      }\n      return { ch, out };\n    }, { color, bg: t.background });\n    const row = { color, swatch: +contrast(color, t.background).toFixed(2), channel: columns.ch };\n    const rawRow = { color, channel: columns.ch };\n    for (const [k, cols] of Object.entries(columns.out)) {\n      row[k] = strokeStats(color, t.background, columns.ch, cols);\n      // Column by column: a count byte, then that many channel bytes.\n      rawRow[k] = Buffer.from(cols.flatMap(vs => [vs.length, ...vs])).toString('base64');\n    }\n    rows.push(row); rawRows.push(rawRow);\n    console.log(scheme, color, JSON.stringify(row));\n  }\n  result.schemes[scheme] = { background: t.background, rows };\n  raw.schemes[scheme] = { background: t.background, rows: rawRows };\n}\nawait browser.close();\nfs.writeFileSync(args.out ?? path.join(here, 'strokes.json'), JSON.stringify(result, null, 1) + '\\n');\nfs.writeFileSync(args.raw ?? path.join(here, 'strokes-raw.json.gz'), gzipSync(JSON.stringify(raw) + '\\n', { level: 9 }));\n@vitest\nchai\nvitest\n","exit_code":0,"status":"completed"}}
