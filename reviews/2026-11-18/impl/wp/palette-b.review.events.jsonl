{"type":"item.completed","item":{"id":"item_10","type":"command_execution","command":"/bin/bash -lc 'nl -ba research/palette/score.mjs'","aggregated_output":"     1\t// Scores the palette that ships (packages/axylo/src/theme/palette.ts) against the hard constraints of decision\n     2\t// 0003 and writes the record the decision quotes, research/palette/palette.json. The unit test\n     3\t// (packages/axylo/test/theme/palette.test.ts) recomputes the measured fields with its own code and compares them at\n     4\t// the precision written here.\n     5\t//\n     6\t// Browser measurements are folded in when they describe exactly the scored colors and backgrounds, and are refused\n     7\t// otherwise: strokes.json and strokes-raw.json.gz (strokes.mjs, 2 px lines), raster.json (raster.mjs, translucent\n     8\t// fills) and preview-pixels.json (preview.mjs, the preview PNG read back).\n     9\t//\n    10\t//   node research/palette/score.mjs [--md]     (--md also prints the tables of the decision record)\n    11\t//\n    12\t// A candidate that does not ship is scored the same way from its own files, without touching palette.ts:\n    13\t//   node research/palette/score.mjs --palette=research/palette/candidates/candidate-b.json \\\n    14\t//     --raster=research/palette/raster-b.json --preview=research/palette/preview-b-pixels.json \\\n    15\t//     --strokes=research/palette/strokes-b.json --strokes-raw=research/palette/strokes-b-raw.json.gz \\\n    16\t//     --out=research/palette/palette-b.json\n    17\timport fs from 'node:fs';\n    18\timport { gunzipSync } from 'node:zlib';\n    19\timport path from 'node:path';\n    20\timport { fileURLToPath } from 'node:url';\n    21\timport { THRESHOLDS as T, TOKEN_NAMES, VISIONS, bytes, bytesToHex, checkScheme, dist, labOfBytes, lch, neighbourPairs } from './color.mjs';\n    22\timport { readThemeFile } from './theme-file.mjs';\n    23\t\n    24\tconst here = path.dirname(fileURLToPath(import.meta.url));\n    25\tconst md = process.argv.includes('--md');\n    26\tconst args = Object.fromEntries(process.argv.slice(2).filter(a => a.includes('=')).map(a => a.replace(/^--/, '').split('=')));\n    27\tconst theme = readThemeFile();\n    28\t// --palette: score a candidate's series against the shipped backgrounds and tokens; its browser records must then be\n    29\t// named explicitly (the defaults describe the shipped colors).\n    30\tif (args.palette) {\n    31\t  // palette.json is the shipped record the unit test reads; a candidate must never land there.\n    32\t  if (!args.out) throw new Error('--palette needs --out (palette.json is the record of the shipped palette)');\n    33\t  const p = JSON.parse(fs.readFileSync(args.palette, 'utf8'));\n    34\t  for (const s of ['light', 'dark']) theme[s].series = p[s];\n    35\t}\n    36\tconst input = (key, file) => (args[key] ? path.resolve(args[key]) : args.palette ? null : path.join(here, file));\n    37\tconst r3 = x => +x.toFixed(3);\n    38\tconst pair1 = p => p.map(i => i + 1);\n    39\t\n    40\t/** Why a browser record does not describe the scored palette, or null when it does. */\n    41\tfunction mismatch(rec, name) {\n    42\t  if (!rec?.schemes) return `${name}: no schemes`;\n    43\t  for (const s of ['light', 'dark']) {\n    44\t    const r = rec.schemes[s], t = theme[s];\n    45\t    if (!r) return `${name}: no ${s} scheme`;\n    46\t    if (r.background !== t.background) return `${name}: ${s} background ${r.background} is not ${t.background}`;\n    47\t    const colors = r.series ?? r.rows?.map(x => x.color);\n    48\t    if (JSON.stringify(colors) !== JSON.stringify(t.series)) return `${name}: ${s} colors ${JSON.stringify(colors)} are not the scored ${JSON.stringify(t.series)}`;\n    49\t  }\n    50\t  return null;\n    51\t}\n    52\tconst load = p => { if (!p || !fs.existsSync(p)) return null; const b = fs.readFileSync(p); return JSON.parse(p.endsWith('.gz') ? gunzipSync(b).toString('utf8') : b.toString('utf8')); };\n    53\tconst strokes = load(input('strokes', 'strokes.json')), strokesRaw = load(input('strokes-raw', 'strokes-raw.json.gz'));\n    54\tconst raster = load(input('raster', 'raster.json')), preview = load(input('preview', 'preview-pixels.json'));\n    55\tconst refused = [];\n    56\tfor (const [rec, name] of [[strokes, 'strokes.json'], [strokesRaw, 'strokes-raw.json.gz'], [raster, 'raster.json'], [preview, 'preview-pixels.json']]) {\n    57\t  const why = rec ? mismatch(rec, name) : `${name} missing`;\n    58\t  if (why) refused.push(why);\n    59\t}\n    60\t// The preview's normal row must be the scored colors themselves, or the image is of another palette.\n    61\tif (preview && !mismatch(preview, 'preview-pixels.json')) for (const s of ['light', 'dark']) {\n    62\t  if (JSON.stringify(preview.schemes[s].normal) !== JSON.stringify(theme[s].series)) refused.push(`preview-pixels.json: ${s} normal row is not the scored colors`);\n    63\t}\n    64\t\n    65\tconst record = { ...(args.palette ? { candidate: path.relative(path.resolve(here, '../..'), path.resolve(args.palette)) } : {}), thresholds: T, schemes: {} };\n    66\tfor (const [name, other] of [['light', 'dark'], ['dark', 'light']]) {\n    67\t  const s = theme[name], { checks, measured: m } = checkScheme(s, theme[other]);\n    68\t  const pairsOf = (map, n) => Object.fromEntries(VISIONS.map(v => [v, { min: r3(map[v].min), pair: pair1(map[v].pair) }]));\n    69\t  const scheme = {\n    70\t    background: s.background,\n    71\t    tokens: Object.fromEntries(['axis', 'grid', 'muted', 'reference', 'focus'].map(k => [k, s[k]])),\n    72\t    series: s.series.map((hex, k) => ({ slot: k + 1, hex, oklch: lch(hex).map((v, i) => +v.toFixed(i === 2 ? 1 : 3)), contrast: +m.contrast[k].toFixed(2), hueDiffToOtherScheme: +m.hue[k].toFixed(1) })),\n    73\t    minDelta: pairsOf(m.full),\n    74\t    prefixes: Object.fromEntries(T.prefixes.map(n => [n, pairsOf(m.prefixes[n])])),\n    75\t    minDeltaBytes: pairsOf(m.fullBytes),\n    76\t    prefixesBytes: Object.fromEntries(T.prefixes.map(n => [n, pairsOf(m.prefixesBytes[n])])),\n    77\t    tokenDistance: Object.fromEntries(TOKEN_NAMES.map(t => [t, { min: r3(m.tokens[t].min), slot: m.tokens[t].slot + 1 }])),\n    78\t    composites: Object.fromEntries(T.alphas.map(a => [a, Object.fromEntries(VISIONS.map(v => [v, {\n    79\t      minNeighbour: r3(m.composites[a][v].minNeighbour.d), pair: pair1(m.composites[a][v].minNeighbour.pair),\n    80\t      neighbours: m.composites[a][v].neighbours.map(x => r3(x.d)),\n    81\t      ringClosures: m.composites[a][v].ring.map(x => ({ slots: [x.pair[0] + 1, 1], d: r3(x.d) })),\n    82\t    }]))])),\n    83\t    raster: Object.fromEntries(T.alphas.map(a => [a, {\n    84\t      model: m.raster[a].pixels, modelFloor: m.raster[a].pixelsFloor,\n    85\t      neighboursModel: m.raster[a].neighbours.map(x => r3(x.model)),\n    86\t      neighboursWorstWithinOneByte: m.raster[a].neighbours.map(x => r3(x.worst)),\n    87\t      minModel: r3(m.raster[a].minModel), minWorstWithinOneByte: r3(m.raster[a].minWorst),\n    88\t    }])),\n    89\t    checks: checks.map(c => ({ constraint: c.id, check: c.label, value: r3(c.value), limit: c.limit, ok: c.ok })),\n    90\t  };\n    91\t  if (raster && !mismatch(raster, 'raster.json')) {\n    92\t    scheme.chromeRaster = Object.fromEntries(Object.entries(raster.schemes[name].pixels).map(([via, byAlpha]) => [via, Object.fromEntries(Object.entries(byAlpha).map(([a, px]) => {\n    93\t      const nb = neighbourPairs(px.length).map(([i, j]) => dist(labOfBytes(bytes(px[i])), labOfBytes(bytes(px[j]))));\n    94\t      return [a, { pixels: px, neighbours: nb.map(r3), min: r3(Math.min(...nb)) }];\n    95\t    }))]));\n    96\t    for (const [via, byAlpha] of Object.entries(raster.schemes[name].pixels)) for (const [a, px] of Object.entries(byAlpha)) {\n    97\t      // The limit is applied to the unrounded distance; the record keeps 3 decimals.\n    98\t      const min = Math.min(...neighbourPairs(px.length).map(([i, j]) => dist(labOfBytes(bytes(px[i])), labOfBytes(bytes(px[j])))));\n    99\t      scheme.checks.push({ constraint: '6b', check: `min neighbour ΔE at ${+a * 100}%, Chrome ${via} pixels`, value: r3(min), limit: T.composite, ok: min >= T.composite });\n   100\t    }\n   101\t  }\n   102\t  if (preview && !refused.some(x => x.startsWith('preview-pixels.json'))) {\n   103\t    // The preview PNG itself: pairwise differences of the donut slices as read back from each simulated row.\n   104\t    const rows = { normal: 'normal', protanopia: 'protan', deuteranopia: 'deutan', tritanopia: 'tritan' };\n   105\t    scheme.previewImage = Object.fromEntries(Object.entries(rows).map(([row, v]) => {\n   106\t      const px = preview.schemes[name][row], labs = px.map(h => labOfBytes(bytes(h)));\n   107\t      let min = Infinity, pair = null;\n   108\t      for (let i = 0; i < 8; i++) for (let j = i + 1; j < 8; j++) { const d = dist(labs[i], labs[j]); if (d < min) { min = d; pair = [i + 1, j + 1]; } }\n   109\t      scheme.checks.push({ constraint: '2i', check: `min pairwise ΔE in the preview PNG, ${row} row`, value: r3(min), limit: T.minDelta, ok: min >= T.minDelta });\n   110\t      return [row, { pixels: px, min: r3(min), pair }];\n   111\t    }));\n   112\t  }\n   113\t  // Evenness of weight: OKLab lightness range of the eight and of the first three, and the largest chroma.\n   114\t  const Ls = s.series.map(h => lch(h)[0]), Cs = s.series.map(h => lch(h)[1]);\n   115\t  scheme.lightness = { min: r3(Math.min(...Ls)), max: r3(Math.max(...Ls)), firstThreeSpread: r3(Math.max(...Ls.slice(0, 3)) - Math.min(...Ls.slice(0, 3))), maxChroma: r3(Math.max(...Cs)) };\n   116\t  // The pairs that bind: every measured value within 5% of its limit, with its margin.\n   117\t  scheme.tight = checks.filter(c => !c.upper && c.value < c.limit * 1.05).map(c => ({ check: c.label, value: r3(c.value), margin: r3(c.value - c.limit) }));\n   118\t  record.schemes[name] = scheme;\n   119\t}\n   120\t\n   121\t// Sensitivity to a hand edit: every one-byte change of one channel of one color, and whether the scheme still meets\n   122\t// every check above (analytic, byte-rounded and raster model). Measured, so the record says how fragile it is.\n   123\trecord.oneByteEdits = {};\n   124\tfor (const [name, other] of [['light', 'dark'], ['dark', 'light']]) {\n   125\t  let total = 0, pass = 0;\n   126\t  theme[name].series.forEach((hex, k) => {\n   127\t    for (let ch = 0; ch < 3; ch++) for (const d of [-1, 1]) {\n   128\t      const b = bytes(hex); b[ch] += d; if (b[ch] < 0 || b[ch] > 255) continue;\n   129\t      const series = theme[name].series.slice(); series[k] = bytesToHex(b);\n   130\t      const otherScheme = { ...theme[other] };\n   131\t      total++; if (checkScheme({ ...theme[name], series }, otherScheme).checks.every(c => c.ok)) pass++;\n   132\t    }\n   133\t  });\n   134\t  record.oneByteEdits[name] = { edits: total, stillMeetEveryCheck: pass };\n   135\t}\n   136\t\n   137\tif (strokes && !mismatch(strokes, 'strokes.json') && strokesRaw && !mismatch(strokesRaw, 'strokes-raw.json.gz')) record.strokes = strokes;\n   138\trecord.refused = refused;\n   139\tfs.writeFileSync(args.out ? path.resolve(args.out) : path.join(here, 'palette.json'), JSON.stringify(record, null, 1) + '\\n');\n   140\t\n   141\tfor (const why of refused) console.log(`not folded in: ${why}`);\n   142\tconst failed = Object.values(record.schemes).flatMap(s => s.checks.filter(c => !c.ok));\n   143\tconsole.log(failed.length ? `FAILED: ${failed.map(c => c.check).join('; ')}` : 'all hard constraints met');\n   144\tif (md) {\n   145\t  const L = record.schemes.light, D = record.schemes.dark, f = x => x.toFixed(3);\n   146\t  const val = c => c.constraint === 1 ? c.value.toFixed(2) : c.constraint === 4 ? c.value.toFixed(1) : f(c.value);\n   147\t  console.log('\\n| Constraint | Check | Limit | Light | Dark |\\n|---|---|---|---|---|');\n   148\t  L.checks.forEach((c, i) => { const d = D.checks[i]; console.log(`| ${c.constraint} | ${c.check} | ${c.constraint === 4 ? '≤ ' : '≥ '}${c.limit} | ${val(c)} | ${val(d)} |`); });\n   149\t  for (const [label, key, keyB] of [['analytic', 'prefixes', 'minDelta'], ['bytes', 'prefixesBytes', 'minDeltaBytes']]) {\n   150\t    console.log(`\\n| Prefix (${label}) | Vision | Light (pair) | Dark (pair) |\\n|---|---|---|---|`);\n   151\t    for (const n of T.prefixes) for (const v of VISIONS) console.log(`| first ${n} | ${v} | ${f(L[key][n][v].min)} (${L[key][n][v].pair.join('–')}) | ${f(D[key][n][v].min)} (${D[key][n][v].pair.join('–')}) |`);\n   152\t    for (const v of VISIONS) console.log(`| all 8 | ${v} | ${f(L[keyB][v].min)} (${L[keyB][v].pair.join('–')}) | ${f(D[keyB][v].min)} (${D[keyB][v].pair.join('–')}) |`);\n   153\t  }\n   154\t  for (const s of ['light', 'dark']) { console.log(`\\n${s} tight:`); for (const t of record.schemes[s].tight) console.log(`- ${t.check}: ${t.value} (margin ${t.margin})`); }\n   155\t  console.log('\\none-byte edits:', JSON.stringify(record.oneByteEdits));\n   156\t  for (const s of ['light', 'dark']) console.log(s, 'lightness', JSON.stringify(record.schemes[s].lightness));\n   157\t}\n   158\tprocess.exitCode = failed.length ? 1 : 0;\n","exit_code":0,"status":"completed"}}
