,'min contrast',Math.min(...b.map(c=>cr(c,rgb(s.background)))),'dist',p(vis.map(v=>all(v).d),4),'q',p(Math.min(...vis.map(v=>pairs(b,v,true)[0].d)),4),'focus/muted/oldfocusblue',p([ts('focus'),ts('muted'),diff(lab(rgb('#79a8ff')),lab(b[0]))],6));\n }}\nconst trial={light:['#1e97fa','#c7872b','#0f6f48','#8636c1','#c61405','#4f81b7','#921184','#8c9695'],dark:['#64acfa','#fbab2d','#96e8c6','#9f46ae','#fe573f','#387bf0','#d571aa','#5f6866']};\nfor(const name of Object.keys(trial)){const b=trial[name].map(rgb),bg=rgb(schemes[name].background),cl=b.map(polar);console.log('review pair',name,'CR',Math.min(...b.map(c=>cr(c,bg))),'chroma',p(cl.map(c=>c[1]),5),'hue',p(cl.map(c=>c[2]),5));}\n\nNODE\"","aggregated_output":"node:internal/child_process:1160\n    result.error = new ErrnoException(result.error, 'spawnSync ' + options.file);\n                   ^\n\n<ref *1> Error: spawnSync git EPERM\n    at Object.spawnSync (node:internal/child_process:1160:20)\n    at spawnSync (node:child_process:928:24)\n    at execFileSync (node:child_process:971:15)\n    at file:///home/canarit/projects/axylo/[eval1]:30:21\n    at ModuleJob.run (node:internal/modules/esm/module_job:561:25)\n    at process.processTicksAndRejections (node:internal/process/task_queues:104:5)\n    at async node:internal/modules/esm/loader:223:26\n    at async ModuleLoader.executeModuleJob (node:internal/modules/esm/loader:220:20)\n    at async asyncRunEntryPointWithESMLoader (node:internal/modules/run_main:101:5) {\n  errno: -1,\n  code: 'EPERM',\n  syscall: 'spawnSync git',\n  path: 'git',\n  spawnargs: [ 'show', '51e1be5:research/palette/palette.json' ],\n  error: [Circular *1],\n  status: 0,\n  signal: null,\n  output: [\n    null,\n    '{\\n' +\n      ' \"thresholds\": {\\n' +\n      '  \"contrast\": 3,\\n' +\n      '  \"minDelta\": 0.1,\\n' +\n      '  \"prefix4\": 0.14,\\n' +\n      '  \"hueMatch\": 30,\\n' +\n      '  \"token\": 0.1,\\n' +\n      '  \"composite\": 0.06,\\n' +\n      '  \"alphas\": [\\n' +\n