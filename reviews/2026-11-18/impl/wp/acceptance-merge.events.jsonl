ithout exercising all supported class, style, data-theme and media transitions on a chart.\"\n1265:          \"file\": \"packages/axylo/test/browser/render/theme.browser.test.ts\",\n2102:    \"statement\": \"Up to eight series have distinct colors; above eight each keeps a distinct cue and AX130 is raised.\",\n2119:          \"reason\": \"Checks dash and shape identities and AX130, but infers color from a palette index rather than checking the actual colors.\"\n2126:          \"title\": \"reports AX130, AX131 and AX110 only when their conditions newly apply\",\n2150:          \"title\": \"gives compact series distinct normal dashes and raises AX131\",\n2151:          \"reason\": \"Checks two line dashes and AX131, but not the eight-series color limit or AX130 in all compact variants.\"\n2174:          \"title\": \"a ninth series is rejected (AX130), leaves store, frame, view and diagnostics as they were, and later appends work\"\n2202:          \"title\": \"reports AX130, AX131 and AX110 only when their conditions newly apply\",\n2203:          \"reason\": \"Checks that nine series raise AX130 but does not test eight series without the warning.\"\n2580:    \"statement\": \"Multiple compact lines differ by dash as well as color; AX131 suggests one series per compact chart.\",\n2596:          \"title\": \"gives compact series distinct normal dashes and raises AX131\",\n2597:          \"reason\": \"Checks distinct dash settings and AX131 but does not assert distinct colors or render two compact lines.\"\n2603:          \"reason\": \"Draws an injected dash in a renderer fixture without verifying a two-series compact chart or AX131.\"\n2678:    \"statement\": \"Invalid typed calls fail to compile; their untyped equivalents raise AX101, AX106 or AX150.\",\n2698:          \"title\": \"validate raises AX140 without a title or labelledBy, and AX101 for a misspelled field\",\n2699:          \"reason\": \"Checks AX101 for a typo but does not assert AX106 and AX150 for the counterpart invalid calls.\"\n2805:          \"title\": \"scatter [10, 20] + 5 with keep 2 keeps the latest two x positions [10, 20] and raises AX151\",\n2827:          \"file\": \"packages/axylo/test/browser/render/theme.browser.test.ts\",\n2836:          \"title\": \"Empty: 0 before Sales: 4 with Sales pinned: the theme binds the pin to the palette slot the Sales arc uses\",\n3039:    \"statement\": \"Everything is MIT licensed, with third-party notices verified at release.\",\n3054:          \"reason\": \"Declares MIT in package metadata but does not verify notices or that release artifacts carry the license.\"\n3061:          \"reason\": \"Declares MIT in package metadata but does not verify notices or that release artifacts carry the license.\"\n3068:          \"reason\": \"Declares MIT in package metadata but does not verify notices or that release artifacts carry the license.\"\n3075:          \"reason\": \"Declares MIT in package metadata but does not verify notices or that release artifacts carry the license.\"\n3082:          \"reason\": \"Declares MIT in package metadata but does not verify notices or that release artifacts carry the license.\"\n3089:          \"reason\": \"Declares MIT in package metadata but does not verify notices or that release artifacts carry the license.\"\npackages/axylo/test/browser/a11y/axe.browser.test.ts\ndocs/api/examples.ts\ndocs/api/tsconfig.json\nexamples/first-chart/script.html\nexamples/first-chart/npm.ts\nexamples/first-chart/react.tsx\ndocs/decisions/0004-tooltip-and-focused-text.md\npackages/axylo/test/browser/render/theme.browser.test.ts\npackages/axylo/test/browser/render/pending-css.browser.test.ts\npackages/axylo/test/browser/chart/interaction.browser.test.ts\npackages/axylo/test/browser/chart/node.browser.test.ts\npackages/axylo/test/browser/chart/review2.browser.test.ts\npackages/axylo/test/browser/render/proposed-css.ts\npackages/axylo/test/browser/chart/review.browser.test.ts\npackages/axylo/test/browser/chart/review3.browser.test.ts\npackages/axylo/test/browser/chart/util.ts\npackages/axylo/test/browser/chart/lifecycle.browser.test.ts\npackages/axylo/test/browser/chart/theme.browser.test.ts\npackages/axylo/test/browser/chart/data.browser.test.ts\npackages/axylo/test/browser/chart/render.browser.test.ts\n    expect(result.touching, JSON.stringify(result.at)).toBe(0);\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\n// ── palette ───────────────────────────────────────────────────────────────────────────────────────\n\n/** Eight series (or slices) of the type, so the whole default palette is drawn. */\nfunction eight(type: ChartType): { fn: string; options: Record<string, unknown> } {\n  const names = ['S1', 'S2', 'S3', 'S4', 'S5', 'S6', 'S7', 'S8'];\n  if (type === 'donut') return { fn: 'donut', options: { title: 'Eight', data: names.map((n, i) => ({ n, v: 10 + i })), label: 'n', value: 'v' } };\n  if (type === 'scatter') return { fn: 'scatter', options: { title: 'Eight', data: names.flatMap((s, i) => [1, 2, 3].map(x => ({ x: x + i / 10, y: i + x, s }))), x: 'x', y: 'y', series: 's' } };\n  const data = names.flatMap((s, i) => ['A', 'B', 'C'].map((x, k) => ({ x, s, y: 10 + i + k })));\n  return { fn: type === 'compact' ? 'line' : type, options: { title: 'Eight', data, x: 'x', y: 'y', series: 's', ...(type === 'compact' ? { compact: true } : {}) } };\n}\n\ndescribe('A5 palette', () => {\n  for (const type of TYPES) {\n    for (const scheme of ['light', 'dark'] as const) {\n      it(`A5 ${type}: the eight rendered colours (${scheme} scheme) are each at least 3:1 on the background and at least 0.10 apart in OKLab under normal vision and simulated protanopia, deuteranopia and tritanopia`, async () => {\n        const page = await devPage({ css: scheme === 'dark' ? '#chart { color-scheme: dark; }' : '' });\n        const { fn, options } = eight(type);\n        await createRaw(page, fn, options);\n        const colors = await seriesColors(page);\n        expect(colors).toHaveLength(8);\n        // The default background of the scheme the chart resolved (spec A5: \"the default light and dark backgrounds\").\n        const bg = await defaultBackground(page);\n        colors.forEach((c, i) => expect(contrast(c, bg), `series ${i + 1} ${c} on ${bg}`).toBeGreaterThanOrEqual(3));\n        for (const vision of VISIONS) {\n          const m = minimumDistance(colors, vision);\n          expect(m.distance, `${vision}: series ${m.pair[0] + 1} and ${m.pair[1] + 1}`).toBeGreaterThanOrEqual(0.1);\n        }\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n\n    it(`A5 ${type}: on a background the palette does not suit (the first series colour itself), AX141 is raised`, async () => {\n      const page = await devPage();\n      const { fn, options } = eight(type);\n      await createRaw(page, fn, options);\n      const [first] = await seriesColors(page);\n      await page.evaluate(([r, g, b]) => (document.querySelector('#chart') as HTMLElement).style.setProperty('--axylo-background', `rgb(${r}, ${g}, ${b})`), first!);\n      await settle(page);\n      const codes = await page.evaluate(() => (window as unknown as { charts: { diagnostics: { code: string }[] }[] }).charts[0]!.diagnostics.map(d => d.code));\n      expect(codes).toContain('AX141');\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\n// ── grayscale ─────────────────────────────────────────────────────────────────────────────────────\n});\n\n// ── reference lines and bands ─────────────────────────────────────────────────────────────────────\n\ndescribe('T-reference', () => {\n  for (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n    it(`T-reference-${type}: a reference line beyond the data is included in the y domain, drawn with its label next to it, and listed in the summary and the table caption; a band is listed too`, async () => {\n      const page = await devPage();\n      // Every fixture's values stay below 200; the reference sits at 200.\n      const band = type === 'bar' ? { y: [20, 30], label: 'Normal range' } : type === 'scatter' ? { x: [12, 18], label: 'Normal range' } : { x: ['2026-03-03', '2026-03-04'], label: 'Normal range' };\n      await create(page, type, { reference: [{ y: 200, label: 'Ceiling' }, band] });\n      const d = await xDomain(page);\n      expect(d.yDomain![1]).toBeGreaterThanOrEqual(200);\n      const label = page.locator('#chart .axylo-label[data-role=\"reference\"]', { hasText: 'Ceiling' });\n      expect(await label.count()).toBe(1);\n      const g = await plotGeometry(page);\n      const lineY = g.plot.y + (1 - (200 - d.yDomain![0]!) / (d.yDomain![1]! - d.yDomain![0]!)) * g.plot.height;\n      const lb = await box(page, '#chart .axylo-label[data-role=\"reference\"]');\n      expect(Math.min(Math.abs(lb.y - lineY), Math.abs(lb.y + lb.height - lineY)), 'label next to its line').toBeLessThanOrEqual(16);\n      const summary = (await axOf(page, '#chart figure')).description;\n      expect(summary).toContain('Ceiling');\n      expect(summary).toContain('Normal range');\n      await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n      await settle(page);\n      const caption = (await page.locator('#chart table caption').textContent()) ?? '';\n      expect(caption).toContain('Ceiling');\n      expect(caption).toContain('Normal range');\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n\n  it('T-reference-donut: a donut has no reference lines: an author reference is not drawn and not described, and is reported', async () => {\n    const page = await devPage();\n    const built = await create(page, 'donut', { reference: [{ y: 200, label: 'Ceiling' }] });\n    expect(await page.locator('#chart .axylo-label[data-role=\"reference\"]').count()).toBe(0);\n    expect((await axOf(page, '#chart figure')).description).not.toContain('Ceiling');\n    // An option that does not apply to the chart type is AX150 at run time (spec DX3).\n    expect(built.diagnostics.map(d => d.code)).toContain('AX150');\n    expect(await closePage(page)).toEqual([]);\n  });\n});\n\n\n/**\n * An application's use of every export, type-checked (strict) against the packed declarations only: the\n * fixture's tsconfig has no path mapping and no ambient types, so `axylo` resolves through the tarball's\n * `exports` \"types\" condition. The mistakes at the end come from spec DX3 and docs/api/examples.ts; if the\n * declarations had collapsed to `any`, each @ts-expect-error would itself be an error.\n */\nimport { area, bar, donut, line, scatter, validate } from 'axylo';\nimport type { Chart, Diagnostic, LineOptions, Point } from 'axylo';\n\ninterface Visit { day: string; channel: string; sessions: number; share: string }\nconst rows: Visit[] = [{ day: '2026-01-01', channel: 'Direct', sessions: 31713, share: '0.41' }];\n\nconst options: LineOptions<Visit> = { title: 'Daily sessions', data: rows, x: 'day', y: 'sessions', series: 'channel' };\nconst chart: Chart<Visit, LineOptions<Visit>> = line('#sessions', options);\nchart.update({ title: 'Sessions', legend: undefined });\nchart.append([{ day: '2026-01-02', channel: 'Direct', sessions: 30211, share: '0.40' }], { keep: 120 });\nchart.zoom(['2026-01-01', '2026-01-02']);\nconst off: () => void = chart.on('hover', (point: Point<Visit> | null) => { if (point) console.log(point.series, point.y); });\noff();\nconst current: readonly Diagnostic[] = chart.diagnostics;\nchart.destroy();\n\narea(document.createElement('div'), { data: rows, x: 'day', y: 'sessions', series: 'channel', stacked: true });\nbar('#bar', { data: rows, x: 'channel', y: { field: 'share', parse: 'number', scale: 'ratio' }, horizontal: true });\nscatter('#scatter', { data: rows, x: { field: 'day', type: 'date' }, y: 'sessions' });\ndonut('#donut', { data: rows, label: 'channel', value: 'sessions' });\nline('#columns', { data: { columns: { t: new Float64Array(3), v: new Float32Array(3) } }, x: { field: 't', type: 'time', timeZone: 'UTC' }, y: 'v' });\nline('#tile', { data: rows, x: 'day', y: 'sessions', compact: true });\nconst found: Diagnostic[] = validate('line', options);\nconst levels: ('error' | 'warning' | 'hint')[] = found.map(d => d.level);\n\n// @ts-expect-error misspelled field\nline('#x', { data: rows, x: 'day', y: 'sesions' });\n// @ts-expect-error a string-valued field on a value axis without parse\nbar('#x', { data: rows, x: 'day', y: 'share' });\n// @ts-expect-error wide y together with series\nline('#x', { data: rows, x: 'day', y: ['sessions'], series: 'channel' });\n// @ts-expect-error zoom does not exist on a donut\ndonut('#x', { data: rows, label: 'channel', value: 'sessions', zoom: true });\n// @ts-expect-error compact does not exist on a scatter chart\nscatter('#x', { data: rows, x: 'day', y: 'sessions', compact: true });\n// @ts-expect-error validate('line', …) does not take an area-only option\nvalidate('line', { data: rows, x: 'day', y: 'sessions', stacked: true });\n\nexport { current, levels };\ndocs/02-product-spec.md:230:| DX9 | Semantic versioning. A deprecated API keeps working for at least one minor release and six months. At most one major version a year. The previous release's documented examples still compile and run against each release candidate. | Release policy; API report diff; upgrade test | D6 |\n      expect(await page.locator('#chart [role=\"toolbar\"] [tabindex=\"0\"]').count()).toBe(1);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\ndescribe('A2 and T-keyboard: every point in order, the ends, the series', () => {\n  for (const type of FULL as Full[]) {\n    const order = { line: 'by x, then series', area: 'by x, then series', bar: 'by category, then series', scatter: 'by x, then y', donut: 'by slice order' }[type];\n    it(`A2 ${type}: Right visits every datum ${order}, each read with its text; End and Home reach the ends; Tab leaves the chart`, async () => {\n      const page = await 