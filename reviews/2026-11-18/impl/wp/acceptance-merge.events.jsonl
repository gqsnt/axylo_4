nter}.html`;\n      server.pages.set(at, { html: html(loader(), linked), headers: { 'content-security-policy': POLICY } });\n      server.reports.length = 0;\n      const w = await open(server);\n      const response = await w.page.goto(`${server.origin}${at}`);\ntests/dist/snippets.test.ts [] [\n  {\n    title: 'is ten lines or fewer, counting non-blank lines',\n    ancestors: []\n  },\n  {\n    title: 'starts with what loads the library (the import, or the script tag after the document head)',\n    ancestors: []\n  },\n  {\n    title: 'passes no option besides data, fields and the title',\n    ancestors: []\n  },\n  {\n    title: 'is copied verbatim into its fixture and its package README',\n    ancestors: []\n  }\n] []\ntests/dist/licence.test.ts [ 'THIRD-PARTY-NOTICES.md' ] [\n  {\n    title: 'is MIT: the license field and the shipped LICENSE file',\n    ancestors: []\n  },\n  { title: 'declares no runtime dependencies', ancestors: [] },\n  {\n    title: 'ships JavaScript that imports nothing but its peers',\n    ancestors: []\n  },\n  {\n    title: 'is built from its own source only: no node_modules input when its entry is bundled as the release build does',\n    ancestors: []\n  },\n  {\n    title: 'has no copied licence or copyright header in its source or its shipped files',\n    ancestors: []\n  }\n] []\ntests/dist/csp.browser.test.ts [\n  'stylesheet applied at run time',\n  'stylesheet linked by the page',\n  'the instruments themselves'\n] [\n  {\n    title: 'draws every chart type, opens a tooltip and the tables, with no violation, no console error and no markup created',\n    ancestors: [\n      'stylesheet applied at run time',\n      'stylesheet linked by the page'\n    ]\n  },\n  {\n    title: 'catch text inserted as HTML: the observer records the element and the policy reports the inline handler and style',\n    ancestors: [ 'the instruments themselves' ]\n  }\n] []\ntests/dist/node.test.ts [\n  'axylo in plain Node %j',\n  'axylo in plain Node %j',\n  '@axylo/react server rendering'\n] [\n  {\n    title: 'ran without DOM globals, from the packed file',\n    ancestors: [ 'axylo in plain Node %j', 'axylo in plain Node %j' ]\n  },\n  {\n    title: 'exports the five chart functions and validate, and adds no globals on import',\n    ancestors: [ 'axylo in plain Node %j', 'axylo in plain Node %j' ]\n  },\n  {\n    title: 'validate() reports the dirty fixture: AX102, AX103 and AX106 once each, with field and rows (spec 3.5, plan 1.6)',\n    ancestors: [ 'axylo in plain Node %j', 'axylo in plain Node %j' ]\n  },\n  {\n    title: 'a chart function called without a document throws an error that names the target',\n    ancestors: [ 'axylo in plain Node %j', 'axylo in plain Node %j' ]\n  },\n  {\n    title: 'runs without DOM globals',\n    ancestors: [ '@axylo/react server rendering' ]\n  }\n] []\ntests/dist/types.test.ts [ 'npm fixture', 'react fixture' ] [\n  {\n    title: 'type-checks with tsc --strict against the packed declarations',\n    ancestors: [ 'npm fixture', 'react fixture' ]\n  },\n  {\n    title: 'read the declarations from the fixture node_modules, never from the workspace',\n    ancestors: [ 'npm fixture', 'react fixture' ]\n  },\n  {\n    title: 'checked the first-chart snippet',\n    ancestors: [ 'npm fixture', 'react fixture' ]\n  }\n] []\npackages/react/test/browser/react.browser.test.ts [\n  'lifecycle',\n  'StrictMode',\n  'commit phase (findings 2 and 3)',\n  'props to options',\n  'handlers',\n  'ref',\n  'errors',\n  'independence',\n  'hydration'\n] [\n  { title: null, ancestors: [ 'lifecycle' ] },\n  {\n    title: 'unmounting before the first frame cancels it: nothing is drawn after destroy, destroy runs once',\n    ancestors: [ 'lifecycle' ]\n  },\n  {\n    title: 'a key change destroys the old chart once and creates a new one',\n    ancestors: [ 'lifecycle' ]\n  },\n  {\n    title: 'setup, cleanup, setup leaves one chart; unmount leaves nothing behind',\n    ancestors: [ 'StrictMode' ]\n  }