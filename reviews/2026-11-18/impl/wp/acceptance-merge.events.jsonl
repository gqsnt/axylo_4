{"type":"item.completed","item":{"id":"item_46","type":"command_execution","command":"/bin/bash -lc \"cat packages/axylo/test/acceptance/f-stacks.test.ts\nsed -n '201,249p' packages/axylo/test/acceptance/type-matrix.test.ts\nsed -n '365,415p' packages/axylo/test/browser/acceptance/l-legibility.browser.test.ts\nsed -n '410,465p' packages/axylo/test/browser/render/review.browser.test.ts\nsed -n '160,215p' packages/axylo/test/browser/acceptance/a6-a10.browser.test.ts\nsed -n '29,140p' packages/axylo/test/browser/acceptance/a1-names.browser.test.ts\nsed -n '1,120p' acceptance/README.md\ngit ls-files acceptance\"","aggregated_output":"import fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { at, axes, chart, expectCompact, expectGeometry, lastModel, marks, pixel, points, reading, refAt, rows } from './model';\n\nconst stacks = [['area', 'area'], ['bar', 'bar'], ['compact', 'area'], ['compact', 'bar']] as const;\nconst options = (kind: 'area' | 'bar') => ({ y: ['a', 'b', 'c', 'd'], ...(kind === 'area' ? { stacked: true } : { layout: 'stacked' }) });\n\nfor (const [type, kind] of stacks) {\n  it(`F10 ${type}: for any generated mixed-sign ${kind} stacks each drawn component uses its own side of zero and the axis covers both sums`, () => {\n    const value = fc.integer({ min: 2, max: 20 });\n    fc.assert(fc.property(value, value, value, value, (a, b, c, d) => {\n      const records = [{ x: 1, a, b: -b, c, d: -d }, { x: 2, a, b: -b, c, d: -d }];\n      const r = chart(type, records, options(kind), undefined, kind);\n      r.frames();\n      const { y } = axes(r);\n      const bases = [0, 0, a, -b];\n      const tips = [a, -b, a + c, -b - d];\n      expect(y.domain[0]).toBeLessThanOrEqual(-b - d);\n      expect(y.domain[1]).toBeGreaterThanOrEqual(a + c);\n      if (kind === 'bar') {\n        for (const mark of marks(r, 'rects')) {\n          expect(mark.variant).toBe('bar');\n          expect(mark.xywh).toHaveLength(8);\n          for (const offset of [0, 4]) {\n            const pixelTop = mark.xywh[offset + 1]!;\n            const pixelBottom = pixelTop + mark.xywh[offset + 3]!;\n            const positive = tips[mark.series]! > 0;\n            expect(positive ? pixelTop : pixelBottom).toBeCloseTo(y.map(tips[mark.series]!), 3);\n            const base = positive ? pixelBottom : pixelTop;\n            expect(Math.abs(base - y.map(bases[mark.series]!))).toBeLessThanOrEqual(1.001);\n            expect(Math.sign(y.invert((pixelTop + pixelBottom) / 2))).toBe(positive ? 1 : -1);\n          }\n        }\n      } else {\n        for (const mark of marks(r, 'area')) {\n          const [top, count, bottom, lowerCount] = mark.runs;\n          expect([count, lowerCount]).toEqual([2, 2]);\n          expectGeometry(points(mark.upper).slice(top!, top! + count!).map(p => p[1]), [y.map(tips[mark.series]!), y.map(tips[mark.series]!)]);\n          expectGeometry(points(mark.lower).slice(bottom!, bottom! + lowerCount!).map(p => p[1]), [y.map(bases[mark.series]!), y.map(bases[mark.series]!)]);\n        }\n      }\n    }), { numRuns: 1_000 });\n  });\n\n  it(`F10 ${type}: a missing ${kind} component has zero height and the reader is told which stack is incomplete${type === 'compact' ? ' (reading: the summary provides the incomplete warning)' : ''}`, () => {\n    const r = chart(type, [\n      { x: 1, a: 5, b: -3, c: 4, d: -2 },\n      { x: 2, a: 5, b: -3, c: null, d: -2 },\n      { x: 3, a: 5, b: -3, c: 4, d: -2 },\n    ], options(kind), undefined, kind);\n    r.frames();\n    const { x, y } = axes(r);\n    if (kind === 'bar') {\n      const missing = marks(r, 'rects').find(mark => mark.series === 2 && mark.variant === 'missing');\n      expect(missing?.xywh).toHaveLength(4);\n      expectGeometry([missing!.xywh[1]!, missing!.xywh[3]!], [y.map(5), 0]);\n    } else {\n      const mark = marks(r, 'area').find(mark => mark.series === 2)!;\n      const middle = pixel(x, 2);\n      const ordinate = (xy: Float32Array) => points(xy).filter(p => Math.abs(p[0] - middle) < 0.001);\n      expect(ordinate(mark.upper).some(p => Math.abs(p[1] - y.map(5)) < 0.001)).toBe(true);\n      expect(ordinate(mark.lower).some(p => Math.abs(p[1] - y.map(5)) < 0.001)).toBe(true);\n    }\n    if (type === 'compact') {\n      expectCompact(r);\n      expect(lastModel(r).summary).toContain('incomplete');\n    } else {\n      expect(at(r, 1).total).toBe('4');\n      expect(at(r, 2).total).toBe('0 (incomplete)');\n      expect(at(r, 2).rows.map(row => row.value)).toEqual(['5', '-3', 'No data', '-2']);\n      expect(rows(r)[1]).toEqual(['2 (incomplete)', '5', '-3', 'No data', '-2']);\n      expect(reading(r, refAt(r, 2))).toContain('Total 0 (incomplete)');\n      expect(lastModel(r).note).toBeNull();\n    }\n  });\n}\n    for (const text of [lastModel(r).summary, committed(r).reader.table?.caption]) {\n      expect(text).toMatch(/Target at 20/);\n      expect(text).toMatch(/Outage from 4 to 6/);\n    }\n  });\n}\n\nit('T-zoom-bar bar: a category band axis ignores public zoom and retains all rows', () => {\n  const r = chart('bar', [{ x: 'B', y: 6 }, { x: 'A', y: 8 }, { x: 'C', y: 2 }]);\n  r.frames();\n  r.controller.handle.zoom(['A', 'C']);\n  r.frames();\n  expect(committed(r)).toMatchObject({ zoom: false, zoomed: false });\n  expect(rows(r).map(row => row[0])).toEqual(['B', 'A', 'C']);\n});\n\nit('T-zoom-donut donut: even an explicit zoom call leaves arc angles and table rows in slice order', () => {\n  const r = chart('donut', donut);\n  r.frames();\n  r.controller.handle.zoom([0, 1]);\n  r.frames();\n  expect(committed(r)).toMatchObject({ zoom: false, zoomed: false });\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(4);\n  expect(rows(r).map(row => row[0])).toEqual(['First', 'Zero', 'Missing', 'Last']);\n});\n\nit('T-limit-donut donut: eight positive values draw eight arcs; adding a ninth groups only the smallest two', () => {\n  const data = Array.from({ length: 9 }, (_, i) => ({ x: 'Slice ' + i, y: i + 1 }));\n  const r = chart('donut', data.slice(0, 8));\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(16);\n  r.controller.handle.update({ data });\n  r.frames();\n  expect(codes(r)).toEqual(['AX121']);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(16);\n  expect(lastModel(r).summary).toContain('Other (2): 3');\n  expect(rows(r)).toHaveLength(9);\n});\n\nit('T-reference-donut donut: a Cartesian reference option is diagnosed and produces neither reference marks nor reader text', () => {\n  const r = chart('donut', donut, { reference: [{ y: 20, label: 'Target' }] });\n  r.frames();\n  expect(codes(r)).toEqual(['AX150']);\n  expect(marks(r, 'rule')).toEqual([]);\n  expect(marks(r, 'band')).toEqual([]);\n  expect(lastModel(r).summary).not.toContain('Target');\n  expect(committed(r).reader.table?.caption).not.toContain('Target');\n});\ndescribe('L7 states inside the plot', () => {\n  for (const type of TYPES) {\n    it(`L7 ${type}: empty data shows a message inside the plot and in the accessibility tree, with no tick labels and no invented axis`, async () => {\n      const page = await devPage();\n      await create(page, type, { data: [] });\n      const message = page.locator('#chart .axylo-message');\n      expect(await message.isVisible()).toBe(true);\n      const text = ((await message.textContent()) ?? '').trim();\n      expect(text).not.toBe('');\n      const plot = await box(page, '#chart .axylo-plot');\n      const m = await box(page, '#chart .axylo-message');\n      expect(m.x >= plot.x - 1 && m.y >= plot.y - 1 && m.x + m.width <= plot.x + plot.width + 1 && m.y + m.height <= plot.y + plot.height + 1).toBe(true);\n      expect((await axWithin(page, '#chart')).some(n => n.name.includes(text) || n.description.includes(text))).toBe(true);\n      expect(await page.locator('#chart .axylo-label[data-role^=\"tick\"]').count()).toBe(0);\n      expect(await page.evaluate(() => document.querySelectorAll('#chart svg.axylo-svg .axylo-scene line').length)).toBe(0);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    it(`L7 ${type}: loading, an author error and an internal failure each show their message inside the plot; loading → ready is announced once, politely`, async () => {\n      const page = await devPage();\n      await create(page, type, { state: 'loading' });\n      const message = page.locator('#chart .axylo-message');\n      expect(await message.isVisible()).toBe(true);\n      const loading = (await message.textContent())?.trim();\n      await page.evaluate(() => {\n        const w = window as unknown as { announced: string[] };\n        w.announced = [];\n        const live = document.querySelectorAll('#chart [aria-live=\"polite\"], #chart [aria-live=\"assertive\"]');\n        for (const el of live) new MutationObserver(() => { if (el.textContent?.trim()) w.announced.push(`${el.getAttribute('aria-live')}: ${el.textContent}`); }).observe(el, { childList: true, characterData: true, subtree: true });\n      });\n      await call(page, 'update', [{ state: 'ready' }]);\n      await settle(page);\n      const announced = await page.evaluate(() => (window as unknown as { announced: string[] }).announced);\n      expect(announced).toHaveLength(1);\n      expect(announced[0]!.startsWith('polite: ')).toBe(true);\n      expect(await message.isVisible()).toBe(false);\n      await call(page, 'update', [{ state: { error: 'The query failed.' } }]);\n      expect(await message.isVisible()).toBe(true);\n      expect(await message.textContent()).not.toBe(loading);\n      await call(page, 'update', [{ state: 'ready' }]);\n      await page.evaluate(() => (window as unknown as { charts: { __dev: { fail(s: string | null): void } }[] }).charts[0]!.__dev.fail('reader'));\n      await call(page, 'update', [{ title: 'Again' }]);\n      expect(await message.isVisible()).toBe(true);\n      expect(((await message.textContent()) ?? '').trim()).not.toBe('');\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\n// ── L8 ────────────────────────────────────────────────────────────────────────────────────────────\n\n      const out: number[] = [];\n      for (const x of [20, 460]) {\n        const img = await shot(page, x, 60, 400, 300);\n        let n = 0;\n        for (let px = 60; px < 360; px++) if (diff(at(img, px, 150), WHITE) <= 10) n++;\n        out.push(n);\n      }\n      await close(page);\n      return out;\n    };\n    const normal = await gaps('no-preference');\n    const more = await gaps('more');\n    // [8, 3] over 300 px: about 3/11 of the line is gap; [2, 2]: about half.\n    for (const n of normal) { expect(n).toBeGreaterThan(50); expect(n).toBeLessThan(110); }\n    for (const n of more) expect(n).toBeGreaterThan(110);\n  });\n\n  it('text: after text-spacing overrides and after a late font, relaid-out labels land on their boxes and nothing is clipped', async () => {\n    const page = await open();\n    await page.evaluate(() => window.axr.mountText(20, 60));\n    await page.addStyleTag({ content: '* { letter-spacing: 0.12em !important; word-spacing: 0.16em !important; line-height: 1.5 !important; }' });\n    const check = (probes: { box: Record<string, number>; rect: Record<string, number>; overflow?: boolean }[], what: string): void => {\n      probes.forEach((p, i) => {\n        expect(p.overflow, `${what} ${i} overflow`).toBe(false);\n        for (const k of ['x', 'y', 'width', 'height']) expect(Math.abs(p.rect[k]! - p.box[k]!), `${what} ${i} ${k}`).toBeLessThanOrEqual(1.5);\n      });\n    };\n    check(await page.evaluate(() => window.axr.relayoutText()), 'spacing');\n    const before = await page.evaluate(() => window.axr.measureText());\n    const font = fs.readFileSync('/usr/share/fonts/truetype/dejavu/DejaVuSerif-Bold.ttf').toString('base64');\n    await page.evaluate(() => { (document.querySelector('.axylo-text')!.parentElement as HTMLElement).style.setProperty('font-family', '\"Late Serif\", sans-serif'); });\n    expect(await page.evaluate(f => window.axr.loadFont('Late Serif', f), font)).toBe(true);\n    const relaid = await page.evaluate(() => window.axr.relayoutText());\n    check(relaid, 'late font');\n    expect(relaid[2]!.rect.width).toBeGreaterThan(before[2]!.rect.width + 5);\n    await close(page);\n  });\n\n  it('DX8: text layer, renderers and styles work under a Content Security Policy without unsafe-inline, served with real headers', async () => {\n    const page = await open();\n    const violations: string[] = [];\n    await page.route('**/blank.html', async route => {\n      const response = await route.fetch();\n      await route.fulfill({ response, headers: { ...response.headers(), 'content-security-policy': \"default-src 'self'; script-src 'self'; style-src 'self'\" } });\n    });\n    await page.goto(url('packages/axylo/test/browser/blank.html'));\n    await page.exposeFunction('reportViolation', (v: string) => { violations.push(v); });\n    await page.evaluate(() => document.addEventListener('securitypolicyviolation', e => (window as unknown as { reportViolation(v: string): void }).reportViolation(`${e.violatedDirective} ${e.blockedURI}`)));\n    await page.addScriptTag({ url: url(`packages/axylo/test/browser/.out/${ENTRY.split('/').pop()!.replace(/\\.ts$/, '.js')}`) });\n    const probes = await page.evaluate(() => {\n      window.axr.mount('svg', 20, 360);\n      window.axr.mount('canvas', 460, 360);\n      return window.axr.mountText(20, 60);\n    });\n    for (const p of probes) for (const k of ['x', 'y', 'width', 'height'] as const) expect(Math.abs(p.rect[k] - p.box[k])).toBeLessThanOrEqual(1.5);\n    expect(await page.evaluate(() => getComputedStyle(document.querySelector('.axylo-svg')!).position)).toBe('absolute');\n});\n\n// ── A8 ────────────────────────────────────────────────────────────────────────────────────────────\n\ntype State = [string, (page: Page) => Promise<void>];\n\nfunction states(type: ChartType): State[] {\n  const list: State[] = [['default', async () => {}]];\n  if (type !== 'compact') {\n    list.push(['keyboard focus with tooltip', async page => { await page.focus('#before'); await page.keyboard.press('Tab'); await page.keyboard.press('ArrowRight'); }]);\n    list.push(['pointer tooltip', async page => { const p = await box(page, '#chart .axylo-proxy'); await page.mouse.move(p.x + p.width * 0.6, p.y + p.height * 0.5); }]);\n    list.push(['table open', async page => { await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click(); await settle(page); }]);\n    list.push(['streaming', async page => call(page, 'append', [streamRow(type as Full, 0)])]);\n  }\n  if (type === 'line' || type === 'area' || type === 'scatter') {\n    list.push(['zoomed', async page => call(page, 'zoom', [type === 'scatter' ? [12, 30] : ['2026-03-03', '2026-03-05']])]);\n  }\n  if (type !== 'compact' && type !== 'donut' && type !== 'scatter') {\n    list.push(['a series hidden', async page => { await page.locator('#chart .axylo-legend-entry').first().click(); await settle(page); }]);\n  }\n  list.push(['loading', async page => call(page, 'update', [{ state: 'loading' }])]);\n  list.push(['empty', async page => call(page, 'update', [{ data: [] }])]);\n  list.push(['error', async page => call(page, 'update', [{ state: { error: 'The query failed.' } }])]);\n  return list;\n}\n\ndescribe('A8 axe-core', () => {\n  for (const type of TYPES) {\n    it(`A8 ${type}: axe-core reports no violations in any state (${states(type).map(s => s[0]).join(', ')}, and with values left out)`, async () => {\n      const failures: string[] = [];\n      for (const [name, enter] of states(type)) {\n        const page = await devPage();\n        await create(page, type);\n        await enter(page);\n        const result = await axe(page, '#chart');\n        for (const v of result.violations) failures.push(`${name}: ${v.id} (${v.nodes.join(', ')})`);\n        await closePage(page);\n      }\n      const page = await devPage();\n      await create(page, type, {}, '#chart', 'dirty');\n      const result = await axe(page, '#chart');\n      for (const v of result.violations) failures.push(`values left out: ${v.id} (${v.nodes.join(', ')})`);\n      // heading-order is about the page's outline, so it is run over the page; the page's own landmarks\n      // (axe's \"region\") are the author's and are not counted (spec 3.4).\n      const outline = await axe(page, 'body');\n      for (const v of outline.violations.filter(v => v.id === 'heading-order')) failures.push(`values left out: ${v.id} (${v.nodes.join(', ')})`);\n      if (type !== 'compact') expect(outline.ran).toContain('heading-order');\n      await closePage(page);\n      expect(failures).toEqual([]);\n    });\n  }\n});\n\n// ── A10 ───────────────────────────────────────────────────────────────────────────────────────────\n\n/** Every key of the public `Messages` interface (src/public.ts), the spec's \"every built-in string\". */\ndescribe('A1 accessible name and summary', () => {\n  for (const type of TYPES) {\n    it(`A1 ${type}: the title is the accessible name and the description is the generated summary: type, series, x and y range, each series' minimum, maximum and last value`, async () => {\n      const page = await devPage();\n      await create(page, type);\n      const fig = await axOf(page, FIGURE);\n      expect(fig.role).toBe(type === 'compact' ? 'image' : 'group');\n      expect(fig.name).toBe(type === 'donut' ? 'Monthly spend' : type === 'bar' ? 'Shipments per quarter' : type === 'scatter' ? 'Latency by payload size' : 'Energy use by site');\n      for (const group of summaryFragments(type)) expect(inOrder(fig.description, group), `${JSON.stringify(group)} in \"${fig.description}\"`).toBe(true);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    for (const build of ['development', 'production'] as const) {\n      it(`A1 ${type}: with no title and no labelledBy the name is generated from type and measure (\"${TYPE_WORD[type]} chart of ${MEASURE[type]}…\") and AX140 is raised (${build} build)`, async () => {\n        const page = build === 'development' ? await devPage() : await prodPage();\n        const warnings: string[] = [];\n        page.on('console', m => { if (m.type() === 'warning') warnings.push(m.text()); });\n        const built = await create(page, type, untitled(type));\n        const fig = await axOf(page, FIGURE);\n        const x = X_LABEL[type];\n        if (x) expect(fig.name).toBe(`${TYPE_WORD[type]} chart of ${MEASURE[type]} by ${x}`);\n        else expect(fig.name.startsWith(`${TYPE_WORD[type]} chart of ${MEASURE[type]}`), fig.name).toBe(true);\n        expect(built.diagnostics.filter(d => d.code === 'AX140').map(d => d.level)).toEqual(['warning']);\n        // Spec 3.5: warnings print once per code per page in every build.\n        expect(warnings.filter(w => w.includes('AX140'))).toHaveLength(1);\n        // The summary is still there with the generated name.\n        expect(fig.description).toContain(TYPE_WORD[type]);\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n\n    it(`A1 ${type}: labelledBy names the chart from the page's own heading, without a heading of its own and without AX140`, async () => {\n      const page = await devPage();\n      await page.evaluate(() => {\n        const h = document.createElement('h2');\n        h.id = 'card-heading';\n        h.textContent = 'Card heading';\n        document.querySelector('#chart')!.before(h);\n      });\n      const built = await create(page, type, { title: undefined, labelledBy: 'card-heading' });\n      const fig = await axOf(page, FIGURE);\n      expect(fig.name).toBe('Card heading');\n      expect(built.diagnostics.map(d => d.code)).not.toContain('AX140');\n      const headings = (await axWithin(page, '#chart')).filter(n => n.role === 'heading');\n      expect(headings).toEqual([]);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    if (type !== 'compact') {\n      it(`A1 ${type}: the title's heading level is the author's, and a visually hidden title still names the chart`, async () => {\n        const page = await devPage();\n        await create(page, type, { title: { text: 'Level two', level: 2 } });\n        let heading = (await axWithin(page, '#chart')).find(n => n.role === 'heading');\n        expect(heading?.name).toBe('Level two');\n        expect(heading?.props.level).toBe(2);\n        await page.evaluate(() => {\n          const c = (window as unknown as { charts: { update(p: unknown): void }[] }).charts[0]!;\n          c.update({ title: { text: 'Hidden five', level: 5, visible: false } });\n        });\n        await page.evaluate(async () => { for (let i = 0; i < 3; i++) await new Promise(r => requestAnimationFrame(r)); });\n        heading = (await axWithin(page, '#chart')).find(n => n.role === 'heading');\n        expect(heading?.name).toBe('Hidden five');\n        expect(heading?.props.level).toBe(5);\n        expect((await axOf(page, FIGURE)).name).toBe('Hidden five');\n        // Visually hidden: no visible area on the page.\n        const size = await page.locator('#chart .axylo-title').evaluate(el => {\n          const r = el.getBoundingClientRect();\n          const s = getComputedStyle(el);\n          return { area: r.width * r.height, clipped: s.clipPath !== 'none' || s.clip !== 'auto' };\n        });\n        expect(size.area <= 1 || size.clipped).toBe(true);\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n\n    it(`A1 ${type}: an author description is added to the summary and never removes the zone or the omission statement`, async () => {\n      const page = await devPage();\n      // Instants in a named zone (not for a donut, which has no x) with one value that cannot be drawn.\n      const options: Record<string, unknown> = type === 'donut'\n        ? { data: [{ item: 'Rent', spend: 1200 }, { item: 'Food', spend: '__NaN__' }, { item: 'Travel', spend: 360 }] }\n        : type === 'scatter'\n          ? { data: [{ size: Date.UTC(2026, 2, 2), latency: 1 }, { size: Date.UTC(2026, 2, 3), latency: '__NaN__' }, { size: Date.UTC(2026, 2, 4), latency: 3 }], x: { field: 'size', type: 'time', timeZone: 'Asia/Kolkata' }, series: undefined }\n          : type === 'bar'\n            ? { data: [{ quarter: Date.UTC(2026, 2, 2), shipped: 1 }, { quarter: Date.UTC(2026, 2, 3), shipped: '__NaN__' }, { quarter: Date.UTC(2026, 2, 4), shipped: 3 }], x: { field: 'quarter', type: 'time', timeZone: 'Asia/Kolkata' }, series: undefined }\n            : { data: [{ day: Date.UTC(2026, 2, 2), energy: 1 }, { day: Date.UTC(2026, 2, 3), energy: '__NaN__' }, { day: Date.UTC(2026, 2, 4), energy: 3 }], x: { field: 'day', type: 'time', timeZone: 'Asia/Kolkata' }, series: undefined };\n      await create(page, type, { ...options, description: 'Readings from the main meter.' });\n      const fig = await axOf(page, FIGURE);\n      expect(fig.description).toContain('Readings from the main meter.');\n      if (type !== 'donut') expect(ZONE_NAMES.some(z => fig.description.includes(z)), fig.description).toBe(true);\n      // One value left out (NaN, AX103): the summary says so with its count (spec A1 \"any omissions\", F12).\n      expect(fig.description, fig.description).toMatch(/\\b1\\b[^.]*not shown|not shown[^.]*\\b1\\b/i);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    if (type !== 'donut') {\n      it(`A1 ${type}: the summary of instants states the time zone they are shown in`, async () => {\n        const page = await devPage();\n        await create(page, type, {}, '#chart', 'instants');\n        const fig = await axOf(page, FIGURE);\n        expect(ZONE_NAMES.some(z => fig.description.includes(z)), fig.description).toBe(true);\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n\n    it(`A1 ${type}: 24 charts on one page have no duplicate ids, each its own name, and axe heading-order passes`, async () => {\n      const page = await devPage({ css: '.tile { width: 340px; height: 200px; }' });\n      await page.evaluate(() => {\n        for (let i = 0; i < 24; i++) {\n          const el = document.createElement('div');\n          el.id = `tile-${i}`;\n          el.className = 'tile';\n          document.body.appendChild(el);\n# Release acceptance\n\nFrom the repository root\n\n```sh\nnode --test acceptance/test/*.test.mjs\nnode acceptance/check.mjs\nmkdir -p acceptance/results\nenv -u AXYLO_BROWSER timeout 120 npx vitest run --reporter=json --outputFile=acceptance/results/unit.json\nnode acceptance/check.mjs --results acceptance/results/unit.json\nnode acceptance/check.mjs --release --results acceptance/results/unit.json\n```\n\nSupply any number of Vitest JSON reports after `--results`, including browser reports collected on a machine that can run them. The checker prints the table and rewrites [report.md](report.md). Structural errors always exit 1. With `--release`, any `fail` or `no evidence` also exits 1. Review the other open statuses before tagging a release.\n\n| Status | Meaning |\n|---|---|\n| pass | Every required test has a passing assertion result. |\n| fail | At least one required test failed in a supplied report. |\n| no evidence | The criterion applies and has no qualifying evidence. Weak checks appear in the gap list. |\n| not run | Required results are absent or skipped, or a provisional budget has no matching measurement. |\n| cannot be verified here | A required environment or rehearsal is unavailable, or an archived measurement has no frozen limit to compare against. The report links measured history without a verdict. |\n| not applicable | The criterion does not apply to this type. The cell gives the reason. |\n\nFirefox, Safari/WebKit, native phone behavior, screen-reader rehearsal and hardware GPU rasterisation cannot be verified here. The cited benchmark records use software rasterisation and measure main-thread work. Hardware rasterisation has no pass/fail budget of its own in spec §5.\n\n## Add a row\n\nUse the ID and short wording from the spec. Section 3.6 cells use `T-<rule>-<chart type>`. Add an `appliesTo` list and give a `notApplicable` reason for every excluded type. Negative type-matrix cells such as “No” zoom are applicable checks of absence. The compact column covers the variant defined in §3.7.\n\nRead each test body and file it under the chart type it actually exercises. An `evidence` item takes a repository-relative `file` and a `kind` of `unit`, `property`, `browser`, `benchmark`, `document` or `manual rehearsal`. For tests use the exact Vitest `title` or a `prefix` of a `describe` title when the entire suite is needed. Add a `reason` to each `weak` item. Benchmark entries take a `workload` and optional `history` paths. Use `cannotVerify` for environmental limits and `pending` for provisional work, with reasons by type.\n\nThe source scanner checks conventional registrations and simple parameterized titles without importing tests. Its limits are documented in [titles.mjs](titles.mjs). A failed assertion takes precedence across reports. Documents, manual notes and provisional benchmark measurements require review outside the Vitest result join.\nacceptance/README.md\nacceptance/check.mjs\nacceptance/matrix.json\nacceptance/report.md\nacceptance/test/check.test.mjs\nacceptance/test/fixtures/cases.ts\nacceptance/test/fixtures/chart.test.ts\nacceptance/test/fixtures/docs/02-product-spec.md\nacceptance/test/fixtures/failed.json\nacceptance/test/fixtures/matrix.json\nacceptance/test/fixtures/missing-title.json\nacceptance/test/fixtures/results.json\nacceptance/test/fixtures/stale.json\nacceptance/titles.mjs\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"rg -n 'function axe|scrollable-region-focusable|24 .*chart|opening.*neighbor|paint|1 px' packages/axylo/test/browser/acceptance/util.ts packages/axylo/test/browser/a11y/axe.browser.test.ts\nsed -n '1,82p' packages/axylo/test/acceptance/f-missing-values.test.ts\nsed -n '182,210p' packages/axylo/test/acceptance/type-matrix.test.ts\nsed -n '246,285p' packages/axylo/test/browser/acceptance/a2-keyboard.browser.test.ts; cat acceptance/test/fixtures/{chart.test,cases}.ts\ncat scripts/size.mjs | tail -85\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_47","type":"command_execution","command":"/bin/bash -lc \"rg -n 'function axe|scrollable-region-focusable|24 .*chart|opening.*neighbor|paint|1 px' packages/axylo/test/browser/acceptance/util.ts packages/axylo/test/browser/a11y/axe.browser.test.ts\nsed -n '1,82p' packages/axylo/test/acceptance/f-missing-values.test.ts\nsed -n '182,210p' packages/axylo/test/acceptance/type-matrix.test.ts\nsed -n '246,285p' packages/axylo/test/browser/acceptance/a2-keyboard.browser.test.ts; cat acceptance/test/fixtures/{chart.test,cases}.ts\ncat scripts/size.mjs | tail -85\"","aggregated_output":"packages/axylo/test/browser/a11y/axe.browser.test.ts:69:        if (state === 'table open' && fixture === 'trend') expect(ran).toContain('scrollable-region-focusable');\npackages/axylo/test/browser/acceptance/util.ts:276:/** The colour the marks are painted with, resolved in the page from the rendered SVG element's `color`. */\npackages/axylo/test/browser/acceptance/util.ts:290: * The colour painted behind the marks: the chart's own background rect when it is opaque (an author's\npackages/axylo/test/browser/acceptance/util.ts:298:      // The background rect is painted through `color` and currentColor, like every mark (render/svg.ts).\nimport fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { aligned, at, axes, chart, codes, committed, date, expectCompact, expectGeometry, expectValues, lastModel, marks, pathRuns, pixel, points, reading, rows, walk } from './model';\n\nconst observations = [\n  { x: '2024-02-24', y: 6 },\n  { x: '2024-02-25', y: 8 },\n  { x: '2024-02-26', y: null },\n  { x: '2024-02-27', y: 5 },\n  { x: '2024-02-28' },\n  { x: '2024-03-01', y: 0 },\n  { x: '2024-03-02', y: 7 },\n];\n\nfor (const kind of aligned) {\n  for (const compact of [false, true]) {\n    const type = compact ? 'compact' : kind;\n    it(`F2 ${type}: ${kind} distinguishes null, absent field, absent date and zero in geometry and reader text`, () => {\n      const r = chart(type, observations, {}, undefined, kind);\n      r.frames();\n      expect(codes(r).sort()).toEqual(['AX102', 'AX105']);\n      const { x, y } = axes(r);\n      if (kind === 'bar') {\n        const [filled, missing] = marks(r, 'rects');\n        expect(filled?.variant).toBe('bar');\n        expect(missing?.variant).toBe('missing');\n        expect(filled?.xywh).toHaveLength(5 * 4);\n        expect(missing?.xywh).toHaveLength(3 * 4);\n        expectGeometry([filled!.xywh[13]!, filled!.xywh[15]!], [y.map(0), 0]);\n        const missingCenters = [0, 4, 8].map(i => missing!.xywh[i]! + missing!.xywh[i + 2]! / 2);\n        expectGeometry(missingCenters, [2, 4, 5].map(i => pixel(x, date(i))));\n        expectGeometry([1, 5, 9].map(i => missing!.xywh[i]!), [y.map(0), y.map(0), y.map(0)]);\n      } else {\n        const expectedRuns = [[0, 1], [6, 7]];\n        const stroke = marks(r, 'path')[0]!;\n        expect(pathRuns(stroke.xy)).toHaveLength(expectedRuns.length);\n        pathRuns(stroke.xy).forEach((run, i) => expectGeometry(run.map(p => p[0]), expectedRuns[i]!.map(j => pixel(x, date(j)))));\n        expect(marks(r, 'points').flatMap(mark => points(mark.xy)).some(p => Math.abs(p[0] - pixel(x, date(3))) < 0.001)).toBe(true);\n        if (kind === 'area') {\n          const area = marks(r, 'area')[0]!;\n          expect(Array.from(area.runs).filter((_, i) => i % 4 === 1)).toEqual([2, 2]);\n        }\n      }\n      expect(lastModel(r).summary).toContain('minimum 0, maximum 8, last 7');\n      expect(lastModel(r).summary).toContain('Values not shown: 1.');\n      if (compact) expectCompact(r);\n      else {\n        expect(lastModel(r).note).toBe('Values not shown: 1. See table.');\n        const values = ['6', '8', 'No data', '5', 'No data', 'No data', '0', '7'];\n        expect(rows(r).map(row => row[1])).toEqual(values);\n        values.forEach((value, i) => expectValues(r, date(i), [value]));\n      }\n    });\n\n    it(`F2 ${type}: ${kind} missing zero makes the requested count gaps ordinary zero values`, () => {\n      const r = chart(type, observations, { y: { field: 'y', missing: 'zero' } }, undefined, kind);\n      r.frames();\n      expect(lastModel(r).summary).toContain('minimum 0, maximum 8, last 7');\n      const { y } = axes(r);\n      if (kind === 'bar') {\n        const bars = marks(r, 'rects');\n        expect(bars).toHaveLength(1);\n        expect(bars[0]?.xywh).toHaveLength(32);\n        expectGeometry([2, 4, 5, 6].map(i => bars[0]!.xywh[4 * i + 3]!), [0, 0, 0, 0]);\n      } else {\n        const runs = pathRuns(marks(r, 'path')[0]!.xy);\n        expect(runs.map(run => run.length)).toEqual([8]);\n        expectGeometry([2, 4, 5, 6].map(i => runs[0]![i]![1]), [y.map(0), y.map(0), y.map(0), y.map(0)]);\n      }\n      expect(lastModel(r).summary).toContain('Values shown differently from the data: 1.');\n      if (compact) expectCompact(r);\n      else {\n        expect(lastModel(r).note).toBe('Values shown differently from the data: 1. See table.');\n        expect(rows(r).map(row => row[1])).toEqual(['6', '8', '0', '5', '0', '0', '0', '7']);\n        for (const i of [2, 4, 5, 6]) expectValues(r, date(i), ['0']);\n      }\n    });\n  }\n}\n\nfor (const type of ['line', 'area', 'compact'] as const) {\n  it(`F2 ${type}: for any generated missing index no stroke or fill run bridges it`, () => {\n    expect(marks(r, mark)).toHaveLength(9);\n    if (type === 'scatter') expect(committed(r).reader.table?.rowCount).toBe(18);\n    else expect(at(r, 1)).toMatchObject({ count: 9, rows: expect.arrayContaining([expect.objectContaining({ seriesLabel: 'Series 0' })]) });\n  });\n\n  it(`T-reference-${type} ${type}: a line and band extend the appropriate domains, bind to reference paint and are listed in summary and caption`, () => {\n    const r = chart(type, xy, { reference: [{ y: 20, label: 'Target' }, { x: [4, 6], label: 'Outage' }] });\n    r.frames();\n    const { x, y } = axes(r);\n    if (x.type === 'band') throw new Error('Expected continuous axis');\n    expect(x.domain[1]).toBeGreaterThanOrEqual(6);\n    expect(y.domain[1]).toBeGreaterThanOrEqual(20);\n    const rule = marks(r, 'rule').find(mark => mark.role === 'reference')!;\n    expect(rule.stroke).toEqual({ kind: 'token', name: 'reference' });\n    expectGeometry([rule.y1, rule.y2], [y.map(20), y.map(20)]);\n    const band = marks(r, 'band')[0]!;\n    expect(band.fill).toEqual({ kind: 'token', name: 'reference' });\n    expectGeometry([band.box.x, band.box.width], [x.map(4), x.map(6) - x.map(4)]);\n    expect(r.texts.at(-1)?.filter(text => text.role === 'reference').map(text => text.full)).toEqual(expect.arrayContaining(['Target', 'Outage']));\n    for (const text of [lastModel(r).summary, committed(r).reader.table?.caption]) {\n      expect(text).toMatch(/Target at 20/);\n      expect(text).toMatch(/Outage from 4 to 6/);\n    }\n  });\n}\n\nit('T-zoom-bar bar: a category band axis ignores public zoom and retains all rows', () => {\n  const r = chart('bar', [{ x: 'B', y: 6 }, { x: 'A', y: 8 }, { x: 'C', y: 2 }]);\n  r.frames();\n      // At every datum the keyboard reaches, the tooltip (when shown) does not cover that datum's mark.\n      const steps = walk(type).length;\n      let checked = 0;\n      for (let i = 0; i < steps; i++) {\n        if (i > 0) await page.keyboard.press('ArrowRight');\n        const tip = page.locator('#chart .axylo-tooltip');\n        if (!(await tip.isVisible())) continue;\n        const tipBox = await box(page, '#chart .axylo-tooltip');\n        const drawn = await shapes(page, '#chart', type === 'donut' ? 10000 : type === 'bar' ? 10000 : 20);\n        const marks = datumMarks(type, drawn, i, type === 'donut' ? await ring(page) : null);\n        expect(marks.length, `marks for datum ${i}`).toBeGreaterThan(0);\n        checked++;\n        for (const m of marks) expect(intersects(tipBox, m, 0.5), `datum ${i}: tooltip ${JSON.stringify(tipBox)} over mark ${JSON.stringify(m)}`).toBe(false);\n      }\n      // The keyboard shows the tooltip at the datum it is on (decision 0001), so the check above ran.\n      expect(checked).toBe(steps);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\n/** The drawn mark(s) of the i-th datum in keyboard order, from the SVG shapes grouped by colour slot. */\nfunction datumMarks(type: Full, drawn: Record<number, { box: { x: number; y: number; width: number; height: number }; commands: string }[]>, i: number, donut: { cx: number; cy: number; outer: number } | null) {\n  const bySlot = (slot: number) => (drawn[slot] ?? []).map(s => s.box).sort((a, b) => a.x - b.x);\n  if (type === 'line' || type === 'area' || type === 'bar') return [bySlot(1)[i], bySlot(2)[i]].filter(b => b !== undefined);\n  if (type === 'donut') {\n    // A small box at the slice's middle angle, clockwise from 12 o'clock (spec F8), at 80 % of the outer radius.\n    if (!donut) return [];\n    const { cx, cy } = donut;\n    const r = 0.8 * donut.outer;\n    const before = SPEND.values.slice(0, i).reduce((a, b) => a + b, 0);\n    const angle = 2 * Math.PI * (before + SPEND.values[i]! / 2) / SPEND.values.reduce((a, b) => a + b, 0);\n    return [{ x: cx + r * Math.sin(angle) - 4, y: cy - r * Math.cos(angle) - 4, width: 8, height: 8 }];\n  }\n  // Scatter: the point at the i-th place in x-then-y order, from its series' shapes (EU slot 1, US slot 2).\n  const p = LATENCY_ORDER[i]!;\n  const slot = p.region === 'EU' ? 1 : 2;\n  const same = LATENCY_ORDER.filter(q => q.region === p.region);\n  return [bySlot(slot)[same.indexOf(p)]].filter(b => b !== undefined);\n}\nimport { describe, it } from 'vitest';\nimport { kinds } from './cases';\n\ndescribe('render examples', () => {\n  for (const kind of kinds) {\n    it(`${kind} renders`, () => {});\n  }\n  it.each(['bar'] as const)('%s has a baseline', () => {});\n  // it('title in a comment', () => {});\n  const example = \"it('title in a string', () => {})\";\n});\nexport const kinds: readonly string[] = ['line', 'area'];\nconst fixtures = path.join(root, 'tests/dist/fixtures');\nconst LEVEL = 9;\nconst gzip = bytes => gzipSync(bytes, { level: LEVEL }).length;\nconst kib = bytes => +(bytes / 1024).toFixed(2);\n\nif (!process.argv.includes('--no-pack')) pack({ build: false, log: () => {} });\nconst manifest = JSON.parse(fs.readFileSync(path.join(root, 'tests/dist/.packed/manifest.json'), 'utf8'));\n\nasync function consumer({ cwd, contents, external = [], metafile = false }) {\n  const r = await build({\n    stdin: { contents, resolveDir: cwd, loader: 'ts', sourcefile: 'consumer.ts' }, absWorkingDir: cwd, bundle: true, minify: true,\n    format: 'esm', target: 'es2022', conditions: ['production'], external, write: false, metafile, logLevel: 'silent',\n  });\n  const inputs = Object.keys(r.metafile?.inputs ?? {});\n  return { bytes: r.outputFiles[0].contents, inputs };\n}\n\nconst npm = path.join(fixtures, 'npm');\nconst react = path.join(fixtures, 'react');\nconst axyloFile = file => fs.readFileSync(path.join(npm, 'node_modules/axylo/dist', file));\nconst css = axyloFile('axylo.css');\n\nconst cases = [\n  {\n    entry: 'line only (examples/first-chart/npm.ts)', targetKiB: 25,\n    build: () => consumer({ cwd: npm, contents: fs.readFileSync(path.join(npm, 'example/npm.ts'), 'utf8') }), cssFile: false,\n  },\n  { entry: 'everything (export * from axylo)', targetKiB: 40, build: () => consumer({ cwd: npm, contents: \"export * from 'axylo';\" }), cssFile: false },\n  { entry: 'script tag (axylo.iife.min.js + axylo.css)', targetKiB: null, build: async () => ({ bytes: axyloFile('axylo.iife.min.js') }), cssFile: true },\n  {\n    entry: 'React adapter alone (react, axylo external)', targetKiB: 2, cssFile: false,\n    build: () => consumer({ cwd: react, contents: \"export * from '@axylo/react';\", external: ['react', 'react/*', 'react-dom', 'axylo'] }),\n  },\n];\n\nconst rows = [];\nfor (const c of cases) {\n  const { bytes } = await c.build();\n  const jsGzip = gzip(bytes);\n  const cssGzip = c.cssFile ? gzip(css) : 0;\n  const total = jsGzip + cssGzip;\n  rows.push({\n    entry: c.entry, minBytes: bytes.length, jsGzipBytes: jsGzip, cssFileGzipBytes: cssGzip, totalGzipBytes: total,\n    totalKiB: kib(total), targetKiB: c.targetKiB, over: c.targetKiB !== null && kib(total) > c.targetKiB,\n  });\n}\n\nconsole.log(`Download size from the packed tarballs (${manifest.packages.axylo.tarball}, ${manifest.packages['@axylo/react'].tarball}, packed ${manifest.packedAt}); esbuild minify, gzip level ${LEVEL}`);\nconsole.table(rows.map(r => ({\n  entry: r.entry, 'min B': r.minBytes, 'js gzip B': r.jsGzipBytes, 'css file gzip B': r.cssFileGzipBytes || '—',\n  'total KiB': r.totalKiB, 'target KiB': r.targetKiB ?? '—', status: r.targetKiB === null ? 'no target' : r.over ? 'OVER' : 'ok',\n})));\nconsole.log(`The stylesheet is ${css.length} B, ${gzip(css)} B gzipped as a file; the same text is inside every JavaScript row above.`);\n\n// Where the bytes of \"everything\" are: the source rebuilt as scripts/build.mjs builds dist/axylo.js.\nconst src = path.join(root, 'packages/axylo/src');\nconst rebuilt = await build({\n  entryPoints: [path.join(src, 'index.ts')], bundle: true, target: 'es2022', legalComments: 'none', format: 'esm', minify: true,\n  define: { __DEV__: 'false' }, write: false, metafile: true, logLevel: 'silent', absWorkingDir: root,\n});\nconst packedProd = axyloFile('axylo.js').length;\nconst out = Object.values(rebuilt.metafile.outputs)[0];\nconst modules = Object.entries(out.inputs).map(([file, v]) => ({ file: path.relative(src, path.resolve(root, file)), bytes: v.bytesInOutput }))\n  .sort((a, b) => b.bytes - a.bytes);\nconst sum = modules.reduce((n, m) => n + m.bytes, 0);\nconst byDir = new Map();\nfor (const m of modules) { const d = m.file.includes(path.sep) ? m.file.split(path.sep)[0] : '(root)'; byDir.set(d, (byDir.get(d) ?? 0) + m.bytes); }\nconst dirs = [...byDir].sort((a, b) => b[1] - a[1]).map(([dir, bytes]) => ({ directory: dir, 'min B': bytes, share: `${((100 * bytes) / sum).toFixed(1)}%` }));\nconsole.log(`\\nPer-module breakdown of \"everything\" (source rebuilt with the release settings: ${rebuilt.outputFiles[0].contents.length} B minified; the packed axylo.js is ${packedProd} B, ${rebuilt.outputFiles[0].contents.length === packedProd ? 'identical in size' : `a difference of ${rebuilt.outputFiles[0].contents.length - packedProd} B, so dist was built from different source`}). Minified bytes before gzip; gzip does not split by module.`);\nconsole.table(dirs);\nconsole.table(modules.slice(0, 25).map(m => ({ module: m.file, 'min B': m.bytes, share: `${((100 * m.bytes) / sum).toFixed(1)}%` })));\n\nfs.mkdirSync(path.join(root, 'bench'), { recursive: true });\nfs.writeFileSync(path.join(root, 'bench/size-latest.json'), JSON.stringify({\n  date: new Date().toISOString(),\n  method: 'esbuild consumer bundles from tests/dist/fixtures (packed tarballs), minify, production condition; gzip level 9',\n  packed: { at: manifest.packedAt, axylo: manifest.packages.axylo.integrity, react: manifest.packages['@axylo/react'].integrity },\n  cssFileBytes: css.length, cssFileGzipBytes: gzip(css), rows,\n  breakdown: { rebuiltMinBytes: rebuilt.outputFiles[0].contents.length, packedMinBytes: packedProd, directories: dirs, modules },\n}, null, 1));\n\nif (process.argv.includes('--check') && rows.some(r => r.over)) {\n  console.error(`size target exceeded: ${rows.filter(r => r.over).map(r => `${r.entry} ${r.totalKiB} KiB > ${r.targetKiB} KiB`).join('; ')}`);\n  process.exit(1);\n}\n","exit_code":0,"status":"completed"}}
