o donut keeps its legend and the table control; a paused stream that is empty keeps Resume', async () => {\npackages/axylo/test/browser/chart/review2.browser.test.ts:225:    await page.evaluate(() => window.charts[0]!.update({ y: { field: 'y', unit: 's' }, locale: 'de-DE' }));\nasync function structuredPage(options: Parameters<typeof fixturePage>[0] = {}): Promise<Page> {\n  const page = await fixturePage(options);\n  await page.evaluate(() => {\n    const main = document.createElement('main');\n    const h1 = Object.assign(document.createElement('h1'), { textContent: 'Dashboard' });\n    const h2 = Object.assign(document.createElement('h2'), { textContent: 'Traffic' });\n    const chart = document.getElementById('chart')!;\n    chart.replaceWith(main);\n    main.append(h1, h2, chart);\n  });\n  return page;\n}\n\nconst settle = (page: Page) => page.evaluate(async () => { for (const c of window.charts) await c.__bench.ready(); await window.nextFrames(1); });\n\ntype State = 'default' | 'table open' | 'tooltip shown' | 'series hidden';\n\nasync function enter(page: Page, state: State): Promise<boolean> {\n  if (state === 'default') return true;\n  if (state === 'table open') {\n    const toggle = page.locator('#chart .axylo-toolbar button', { hasText: 'View as table' });\n    if (!(await toggle.count())) return false;\n    await toggle.click();\n    return true;\n  }\n  if (state === 'tooltip shown') {\n    const proxy = page.locator('#chart .axylo-proxy');\n    if (!(await proxy.count()) || !(await proxy.isVisible())) return false;\n    // The keyboard shows the tooltip at a datum on every chart type, wherever its marks are.\n    await proxy.focus();\n    await page.keyboard.press('ArrowRight');\n    return page.locator('#chart .axylo-tooltip').first().isVisible();\n  }\n  const entry = page.locator('#chart .axylo-legend-entry').first();\n  if (!(await entry.count())) return false;\n  await entry.click();\n  await settle(page);\n  return true;\n}\n\ndescribe('axe-core reports no violations (spec A8)', () => {\n  for (const fixture of FIXTURES) {\n    it(`${fixture}: default, table open, tooltip shown, series hidden`, async () => {\n      const page = await structuredPage();\n      await make(page, fixture as FixtureName);\n      const report: Record<string, string[]> = {};\n      const applied: State[] = [];\n      for (const state of ['default', 'tooltip shown', 'series hidden', 'table open'] as const) {\n        if (!(await enter(page, state))) continue;\n        applied.push(state);\n        const { violations, ran } = await axe(page);\n        report[state] = violations.map(v => `${v.id}: ${v.help} (${v.nodes.join(', ')})`);\n        expect(ran).toContain('heading-order');\n        // The rule applies only where the region scrolls: the trend table's 120 rows do.\n        if (state === 'table open' && fixture === 'trend') expect(ran).toContain('scrollable-region-focusable');\n      }\n      expect(report).toEqual(Object.fromEntries(applied.map(s => [s, []])));\n      // Which states apply follows from the fixture (spec C1, L7, 3.6).\n      const interactive = ['trend', 'bars', 'parts', 'scatter', 'stacked', 'dirty'].includes(fixture);\n      expect(applied.includes('table open')).toBe(interactive);\n      expect(applied.includes('tooltip shown')).toBe(interactive);\n      expect(applied.includes('series hidden')).toBe(['trend', 'scatter', 'stacked'].includes(fixture));\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n      const page = await devPage();\n      await create(page, type);\n      const all = await probes(page, type);\n      const first = all.find(p => p.y > 0) ?? all[0]!;\n      const other = all.find(p => p.expect[0] !== first.expect[0])!;\n      await page.mouse.move(first.x, first.y);\n      await settle(page);\n      expect(await tooltip(page).isVisible()).toBe(true);\n      const t = await box(page, '#chart .axylo-tooltip');\n      // Onto the tooltip in one move (reading: WCAG 1.4.13 asks that the pointer can be put on the content;\n      // on a nearest-x chart the content follows a pointer that sweeps across the plot).\n      await page.mouse.move(t.x + t.width / 2, t.y + t.height / 2);\n      await settle(page);\n      expect(await tooltip(page).isVisible()).toBe(true);\n      await page.mouse.move(first.x, first.y, { steps: 4 });\n      await page.keyboard.press('Escape');\n      await settle(page);\n      expect(await tooltip(page).isVisible()).toBe(false);\n      await page.mouse.move(first.x + 1, first.y + 1);\n      await settle(page);\n      expect(await tooltip(page).isVisible()).toBe(false);\n      await page.mouse.move(other.x, other.y);\n      await settle(page);\n      expect(await tooltip(page).isVisible()).toBe(true);\n      expect(says((await tooltip(page).textContent()) ?? '', other)).toBe(true);\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    if (type !== 'donut') {\n      it(`I1 ${type}: with ten series ${type === 'scatter' ? 'on one coincident point' : 'at one x'} the tooltip lists eight rows and \"+2 more\"; in a 260 px tile the same content appears in the fixed readout under the plot`, async () => {\n        const page = await devPage();\n        // Long names, so eight rows make a tooltip wider than the room on either side of the plot's middle.\n        const names = Array.from({ length: 10 }, (_, i) => `Region number ${i + 1}`);\n        const data = type === 'scatter'\n          ? names.map(s => ({ x: 5, y: 5, s })).concat([{ x: 1, y: 1, s: 'S1' }, { x: 9, y: 9, s: 'S1' }])\n          : names.flatMap((s, i) => ['A', 'B', 'C'].map((x, k) => ({ x, s, y: 10 + i + k })));\n        await createRaw(page, type, { title: 'Ten', data, x: 'x', y: 'y', series: 's' });\n        const p = await box(page, '#chart .axylo-proxy');\n        await page.mouse.move(p.x + p.width / 2, p.y + p.height / 2);\n        await settle(page);\n        // Whichever surface shows the content (the tooltip, or the readout where it cannot fit).\n        const surface = (await tooltip(page).isVisible()) ? '#chart .axylo-tooltip' : '#chart .axylo-readout';\n        expect(await page.locator(`${surface} .axylo-tooltip-row:not(.axylo-tooltip-total)`).count()).toBe(8);\n        expect(((await page.locator(surface).textContent()) ?? '')).toContain('+2 more');\n        // A 260 px tile in a 280 px viewport: there is no room beside the marks for eight such rows. Tall, so\n        // the ten legend entries still leave a readable plot (spec L8).\n        await page.setViewportSize({ width: 280, height: 1000 });\n        await page.evaluate(() => Object.assign((document.querySelector('#chart') as HTMLElement).style, { width: '260px', height: '760px' }));\n        await settle(page);\n        const q = await box(page, '#chart .axylo-proxy');\n        await page.mouse.move(q.x + q.width / 2, q.y + q.height / 2);\n        await settle(page);\n        const readout = page.locator('#chart .axylo-readout');\n        expect(await readout.isVisible()).toBe(true);\n        expect(await tooltip(page).isVisible()).toBe(false);\n        const plot = await box(page, '#chart .axylo-plot');\n        const r = await box(page, '#chart .axylo-readout');\n        expect(r.y).toBeGreaterThanOrEqual(plot.y + plot.height - 1);\n        expect((await readout.textContent()) ?? '').toContain('+2 more');\n        expect(await closePage(page)).toEqual([]);\n      });\n    }\n  }\n\n  for (const type of ['line', 'area', 'bar'] as const) {\n    it(`I1 ${type}: a series with no row at the pointed x reads \"No observation\", distinct from \"No data\" for an explicit null`, async () => {\n      const page = await devPage();\n      // B has no row at the second x and a null at the third. The x values are irregular numbers (categories\n      // for the bar), so no absent step is turned into a gap (spec F2, AX105) and the absent row stays one.\n      const xs = type === 'bar' ? ['a', 'b', 'c', 'd'] : [1, 2, 5, 9];\n      const data = [\n        ...xs.map((x, i) => ({ x, s: 'A', y: i + 1 })),\n        { x: xs[0], s: 'B', y: 5 }, { x: xs[2], s: 'B', y: null }, { x: xs[3], s: 'B', y: 6 },\n acceptance/check.mjs   |   277 +-\n acceptance/matrix.json | 13198 +++++++++++++++++++++++++++++++++++++++--------\n acceptance/report.md   |  1047 +---\n acceptance/titles.mjs  |    35 +-\n 4 files changed, 11369 insertions(+), 3188 deletions(-)\n","exit_code":0,"status":"completed"}}
