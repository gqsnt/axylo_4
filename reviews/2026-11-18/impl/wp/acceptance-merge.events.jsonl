{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"ls -la acceptance/results; git check-ignore acceptance/results/unit.json; sed -n '1,120p' acceptance/test/check.test.mjs; wc -l packages/axylo/test/{acceptance,browser/acceptance}/*.ts; sed -n '1,25p' acceptance/report.md; cat docs/decisions/0002-mark-renderer.md\"","aggregated_output":"total 372\ndrwxrwxr-x 2 canarit canarit   4096 Nov 18 07:11 .\ndrwxrwxr-x 4 canarit canarit   4096 Nov 18 07:03 ..\n-rw-rw-r-- 1 canarit canarit 326069 Nov 18 07:09 browser.json\n-rw-rw-r-- 1 canarit canarit   9318 Nov 18 07:09 dist-browser.json\n-rw-rw-r-- 1 canarit canarit  29281 Nov 18 07:09 dist.json\n-rw-rw-r-- 1 canarit canarit      0 Nov 18 07:11 unit.log\nacceptance/results/unit.json\nimport assert from 'node:assert/strict';\nimport test from 'node:test';\nimport { resolve } from 'node:path';\nimport { fileURLToPath } from 'node:url';\nimport { check } from '../check.mjs';\n\nconst root = fileURLToPath(new URL('./fixtures/', import.meta.url));\nconst matrixFile = resolve(root, 'matrix.json');\nconst passed = resolve(root, 'results.json');\nconst failed = resolve(root, 'failed.json');\nconst run = options => check({ root, matrixFile, ...options });\n\ntest('a stale ID and its missing replacement are structural errors without --release', () => {\n  assert.throws(() => run({ matrixFile: resolve(root, 'stale.json') }),\n    /stale criterion ID: F88\\nmissing criterion ID: F1/);\n});\n\ntest('a title in a comment does not satisfy even a weak test reference', () => {\n  assert.throws(() => run({ matrixFile: resolve(root, 'missing-title.json') }),\n    /F1\\/area: missing test title in chart\\.test\\.ts: title in a comment/);\n});\n\ntest('a failed named result appears in the table and only blocks --release', () => {\n  const options = { resultFiles: [failed] };\n  const normal = run(options);\n  assert.match(normal.table, /^\\| F1 \\| [^|]+\\| fail \\| no evidence \\| not run \\|/m);\n  assert.match(normal.report, /1 passed assertions, 1 reported failures/);\n  assert.equal(normal.counts.fail, 3);\n  assert.equal(normal.exitCode, 0);\n  assert.equal(run({ ...options, release: true }).exitCode, 1);\n});\n\ntest('evidence applies per chart type and weak tests cannot fill an evidence gap', () => {\n  const normal = run({ resultFiles: [passed] });\n  assert.match(normal.table, /^\\| F1 \\| [^|]+\\| pass \\| no evidence \\| pass \\| not applicable \\|/m);\n  assert.match(normal.table, /^\\| F2 \\| [^|]+\\| cannot be verified here \\|/m);\n  assert.match(normal.report, /No evidence · area/);\n  assert.match(normal.report, /The smoke test does not check the geometry\\./);\n  assert.deepEqual(normal.counts, {\n    pass: 2, fail: 0, 'no evidence': 1, 'not run': 2, 'cannot be verified here': 1, 'not applicable': 18,\n  });\n  assert.equal(run({ resultFiles: [passed], release: true }).exitCode, 1);\n});\n\ntest('a describe prefix needs all its cases, and a failure in either report remains a failure', () => {\n  const partial = run({ resultFiles: [passed] });\n  assert.match(partial.table, /^\\| T-pointer-line \\| [^|]+\\| not run \\|/m);\n  const combined = run({ resultFiles: [passed, failed] });\n  assert.match(combined.table, /^\\| T-pointer-line \\| [^|]+\\| fail \\|/m);\n  assert.equal(combined.counts.pass, 1);\n});\n\ntest('without results, named tests are not run and gaps remain visible', () => {\n  const result = run();\n  assert.match(result.report, /Static coverage only/);\n  assert.equal(result.counts.pass, 0);\n  assert.equal(result.counts['not run'], 4);\n  assert.equal(result.counts['no evidence'], 1);\n  assert.equal(result.exitCode, 0);\n});\n    85 packages/axylo/test/acceptance/compact.test.ts\n   201 packages/axylo/test/acceptance/dx-controller.test.ts\n   284 packages/axylo/test/acceptance/dx-diagnostics.test.ts\n   198 packages/axylo/test/acceptance/f-dense.test.ts\n    53 packages/axylo/test/acceptance/f-disclosure.test.ts\n   109 packages/axylo/test/acceptance/f-domains.test.ts\n    88 packages/axylo/test/acceptance/f-donut.test.ts\n   101 packages/axylo/test/acceptance/f-format.test.ts\n   193 packages/axylo/test/acceptance/f-missing-values.test.ts\n    65 packages/axylo/test/acceptance/f-order.test.ts\n    28 packages/axylo/test/acceptance/f-series.test.ts\n    76 packages/axylo/test/acceptance/f-stacks.test.ts\n   134 packages/axylo/test/acceptance/f-time.test.ts\n   110 packages/axylo/test/acceptance/model.ts\n    54 packages/axylo/test/acceptance/production.test.ts\n   379 packages/axylo/test/acceptance/reader-model.test.ts\n   249 packages/axylo/test/acceptance/type-matrix.test.ts\n   155 packages/axylo/test/browser/acceptance/a1-names.browser.test.ts\n   285 packages/axylo/test/browser/acceptance/a2-keyboard.browser.test.ts\n   248 packages/axylo/test/browser/acceptance/a4-table.browser.test.ts\n   358 packages/axylo/test/browser/acceptance/a5-not-colour-alone.browser.test.ts\n   284 packages/axylo/test/browser/acceptance/a6-a10.browser.test.ts\n   195 packages/axylo/test/browser/acceptance/compact.browser.test.ts\n   114 packages/axylo/test/browser/acceptance/f12-note.browser.test.ts\n   164 packages/axylo/test/browser/acceptance/f2-gaps.browser.test.ts\n   127 packages/axylo/test/browser/acceptance/f8-donut.browser.test.ts\n   228 packages/axylo/test/browser/acceptance/fixtures.ts\n   495 packages/axylo/test/browser/acceptance/i1-pointer.browser.test.ts\n   435 packages/axylo/test/browser/acceptance/l-legibility.browser.test.ts\n    88 packages/axylo/test/browser/acceptance/text.ts\n   467 packages/axylo/test/browser/acceptance/type-matrix.browser.test.ts\n   459 packages/axylo/test/browser/acceptance/util.ts\n    53 packages/axylo/test/browser/acceptance/vision.ts\n  6562 total\n# Acceptance report\n\nStatic coverage only. No Vitest reports supplied.\n\n## Status by chart type\n\n- pass · 0\n- fail · 0\n- no evidence · 251\n- not run · 38\n- cannot be verified here · 21\n- not applicable · 266\n\n| Criterion | Statement | line | area | bar | scatter | donut | compact |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| F1 | Bar and area value axes always include zero; a domain that excludes zero is widened and raises AX110. | not applicable | not run | not run | not applicable | not applicable | no evidence |\n| F2 | Missing values are never drawn as zero and never bridged unless the author asks; readouts say “No data”. | no evidence | no evidence | no evidence | no evidence | no evidence | no evidence |\n| F3 | Input that cannot be plotted as given is reported, never guessed. | no evidence | no evidence | no evidence | no evidence | no evidence | no evidence |\n| F12 | When warnings mean values were left out or changed, a note appears inside the figure and in the accessibility tree, in every build. | no evidence | no evidence | no evidence | no evidence | no evidence | not applicable |\n| F10 | Stacks place positive and negative values on their own sides of zero; missing components mark the stack incomplete. | not applicable | no evidence | no evidence | not applicable | not applicable | no evidence |\n| F8 | Donut slices keep order, start at 12 o’clock and run clockwise; nulls, zeros, negatives and excess slices have distinct outcomes. | not applicable | not applicable | not applicable | not applicable | no evidence | not applicable |\n| F4 | Calendar dates read the same in every zone; instants name their zone; wall-clock times are shown as written. | no evidence | no evidence | no evidence | no evidence | not applicable | no evidence |\n| F11 | Line, area and scatter draw in x order; duplicate x disables an aligned series, while scatter keeps coincident points. | no evidence | no evidence | no evidence | no evidence | not applicable | no evidence |\n| F5 | Dense drawing preserves the exact per-pixel extrema of each valid run and keeps every break. | no evidence | no evidence | not applicable | not applicable | not applicable | no evidence |\n| T-dense-line | Simplified drawing when dense · F5 | no evidence | not applicable | not applicable | not applicable | not applicable | not applicable |\n# Decision 0002: SVG paths draw the marks by default (provisional)\n\nStatus: **provisional working default**, set by the coordinator on 2026-11-18 from the M1 measurements and weakened the same day after an independent review of the benchmark harness (`reviews/2026-11-18/impl/wp/bench.review.md`, Codex gpt-6.2-sol at effort max). The owner asked for this to be settled by measurement. It is not settled: the measurements support using SVG while the line-chart slice is built and keeping canvas behind the internal switch. They do not establish a shipping winner or a reason to remove either renderer.\n\n## What the review changed\n\nThe table below is kept as measured. These statements made from it in the first version are withdrawn or narrowed:\n\n- **Withdrawn: \"nothing measured favours canvas except all-thread CPU during resize.\"** The recorded heap, DOM-node and layout counts also favour canvas.\n- **Withdrawn: the resize CPU gap is raster work.** The number is CPU for the whole renderer process; no stage was traced.\n- **Withdrawn: simplification bounds every chart by its width.** It was shown for line series only; point marks and many-series charts were not measured.\n- **Withdrawn: an SVG theme change needs no run-time work.** Both renderers recorded six DOM mutations per toggle; \"no canvas drawing call\" is all that was observed.\n- **Withdrawn: normalization and garbage collection explain the gap to uPlot.** About 71–73% of busy time in the production profiles is unmapped; the normalization share comes from development builds. It is a hypothesis to test, not a finding.\n- **Narrowed: \"half the renderer memory.\"** The halving is of the increase above a data-only page at pixel ratio 2 (34.2 → 17.7 MiB). Absolute renderer memory was 74.7 → 56.2 MiB, and at pixel ratio 1 the increase was 23.1 → 18.4 MiB.\n- **Narrowed: \"no frame later than 25 ms.\"** True of the recorded animation-frame callbacks; the window can miss an interval that spans its boundary, and a callback is not a presented frame.\n- **Void: every 24-chart page row** (page at pixel ratio 1 and 2, resize of the 24-chart page, and the memory row). The harness fix pass found that these runs drew no marks: at 230 × 115 px each tile is below the 120 × 80 px plot minimum of spec L8, so every chart showed its text fallback. The SVG records carry `svgPaths: 0`; the canvas runs held empty canvases. The numbers compare two empty charts and say nothing about the renderers. The harness now rejects a run whose chart drew no marks, and the page workload uses 340 × 200 px tiles.\n- **Narrowed: verdicts.** 149 metric comparisons were judged without adjustment for choosing among them, on six pairs or fewer per workload, with noise bands from one session and two workload shapes. Two \"SVG lower\" rows allow a gain as small as 0.16 ms (10,000 points) and 6.3 ms (dashboard at pixel ratio 2).\n\nEvidence: [bench/results/m1-renderer-comparison.md](../../bench/results/m1-renderer-comparison.md). One session of 39 runs, production build, headless Chrome 157, machine under load from other work, A-versus-A noise bands for two workloads only.\n\n## What was measured\n\nCanvas → SVG, medians of main-thread task time unless stated. \"Lower\" means the 95% interval cleared zero and the noise band where one existed.\n\n| Workload | Canvas | SVG | Verdict |\n|---|---|---|---|\n| Streaming, per update | 2.26 ms | 1.45 ms | SVG lower |\n| Theme change, per toggle | 2.68 ms and 27 drawing calls | 2.01 ms and no drawing call | SVG lower |\n| Resize, one chart of 100,000 points | 915 ms | 472 ms | SVG lower on the main thread |\n| Same, CPU across all threads | 1,035 ms | 1,770 ms | **SVG higher** |\n| Resize, 24-chart page | 730 ms | 525 ms | Void: no marks were drawn |\n| First chart, 10,000 points | 34.0 ms | 28.4 ms | SVG lower |\n| 24-chart page at pixel ratio 2 | 199 ms | 158 ms | Void: no marks were drawn |\n| First chart, 3 × 120 | 23.6 ms | 19.8 ms | Inconclusive |\n| First chart, 100,000 points | 81.8 ms | 83.5 ms | Inconclusive |\n| First chart, 1,000,000 points | 622 ms | 652 ms | Inconclusive (4 blocks) |\n| Memory, 24-chart page at pixel ratio 2 | 34.2 MiB renderer, 11.5 MiB GPU, 7.7 MiB backing stores | 17.7 MiB, 2.2 MiB, none | Void: no marks were drawn |\n\nNo frame was later than 25 ms in any configuration, so frame pacing does not separate the two.\n\n## Why SVG for now\n\n1. On the line workloads measured, main-thread task time was lower with SVG or the two could not be told apart.\n2. Line series are simplified to a few vertices per pixel column before either renderer sees them, so for line charts the path size follows the plot width, not the data.\n3. SVG follows the page with less code: forced colors and print work through CSS, browser zoom stays sharp, and there is no backing store to size, cap or lose. This is a design argument, not a measurement.\n\n## What this does not establish\n\n- **GPU rasterization was not measured.** Headless Chrome here does not use a GPU. The resize, pixel-ratio-2 and process-memory results need a headed, GPU-backed rerun before they transfer.\n- **Dense point marks were not measured.** A scatter chart with tens of thousands of markers is the case most likely to favour canvas.\n- **One browser, one machine, one session.** Firefox and Safari may order the two differently.\n- **Many series, pan and zoom, and the budget workloads P4, P7 and P8 were not measured**, and the million-point comparison has four pairs.\n- Both renderers are far from uPlot in the configurations measured (about 80 ms against 12 ms at 100,000 points; uPlot draws no tooltip or accessibility layer). Where that time goes is not established.\n\n## Consequences\n\n- The working default is SVG. The canvas renderer stays in the code behind the same internal switch, with the pixel-agreement tests between the two kept.\n- Before the choice is final: fix the harness defects the review found (renderer identity in the readback, noise bands on replay, failed runs excluded from speed verdicts, gap-aware admission, the frame window), declare the primary endpoints and thresholds in advance, then rerun on a quiet machine with scatter at 10,000, 50,000 and 200,000 points, ten series of 100,000 points, pan and zoom, and the byte cost of keeping both renderers. Removing canvas from the bundle needs that evidence too.\n- When a real GPU and a second browser are available: rerun the resize and million-point workloads headed. If canvas wins there by more than the shipping thresholds in the performance plan, flip the switch back.\n- The plan's sections 2.2 and 2.3 are read with SVG in the \"marks\" position: a theme change no longer needs a redraw, and device pixel ratio matters only to simplification.\n","exit_code":0,"status":"completed"}}
