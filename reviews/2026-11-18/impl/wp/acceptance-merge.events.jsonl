{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/acceptance/{f-missing-values,f-dense,compact}.test.ts'","aggregated_output":"import fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { aligned, at, axes, chart, codes, committed, date, expectCompact, expectGeometry, expectValues, lastModel, marks, pathRuns, pixel, points, reading, rows, walk } from './model';\n\nconst observations = [\n  { x: '2024-02-24', y: 6 },\n  { x: '2024-02-25', y: 8 },\n  { x: '2024-02-26', y: null },\n  { x: '2024-02-27', y: 5 },\n  { x: '2024-02-28' },\n  { x: '2024-03-01', y: 0 },\n  { x: '2024-03-02', y: 7 },\n];\n\nfor (const kind of aligned) {\n  for (const compact of [false, true]) {\n    const type = compact ? 'compact' : kind;\n    it(`F2 ${type}: ${kind} distinguishes null, absent field, absent date and zero in geometry and reader text`, () => {\n      const r = chart(type, observations, {}, undefined, kind);\n      r.frames();\n      expect(codes(r).sort()).toEqual(['AX102', 'AX105']);\n      const { x, y } = axes(r);\n      if (kind === 'bar') {\n        const [filled, missing] = marks(r, 'rects');\n        expect(filled?.variant).toBe('bar');\n        expect(missing?.variant).toBe('missing');\n        expect(filled?.xywh).toHaveLength(5 * 4);\n        expect(missing?.xywh).toHaveLength(3 * 4);\n        expectGeometry([filled!.xywh[13]!, filled!.xywh[15]!], [y.map(0), 0]);\n        const missingCenters = [0, 4, 8].map(i => missing!.xywh[i]! + missing!.xywh[i + 2]! / 2);\n        expectGeometry(missingCenters, [2, 4, 5].map(i => pixel(x, date(i))));\n        expectGeometry([1, 5, 9].map(i => missing!.xywh[i]!), [y.map(0), y.map(0), y.map(0)]);\n      } else {\n        const expectedRuns = [[0, 1], [6, 7]];\n        const stroke = marks(r, 'path')[0]!;\n        expect(pathRuns(stroke.xy)).toHaveLength(expectedRuns.length);\n        pathRuns(stroke.xy).forEach((run, i) => expectGeometry(run.map(p => p[0]), expectedRuns[i]!.map(j => pixel(x, date(j)))));\n        expect(marks(r, 'points').flatMap(mark => points(mark.xy)).some(p => Math.abs(p[0] - pixel(x, date(3))) < 0.001)).toBe(true);\n        if (kind === 'area') {\n          const area = marks(r, 'area')[0]!;\n          expect(Array.from(area.runs).filter((_, i) => i % 4 === 1)).toEqual([2, 2]);\n        }\n      }\n      expect(lastModel(r).summary).toContain('minimum 0, maximum 8, last 7');\n      expect(lastModel(r).summary).toContain('Values not shown: 1.');\n      if (compact) expectCompact(r);\n      else {\n        expect(lastModel(r).note).toBe('Values not shown: 1. See table.');\n        const values = ['6', '8', 'No data', '5', 'No data', 'No data', '0', '7'];\n        expect(rows(r).map(row => row[1])).toEqual(values);\n        values.forEach((value, i) => expectValues(r, date(i), [value]));\n      }\n    });\n\n    it(`F2 ${type}: ${kind} missing zero makes the requested count gaps ordinary zero values`, () => {\n      const r = chart(type, observations, { y: { field: 'y', missing: 'zero' } }, undefined, kind);\n      r.frames();\n      expect(lastModel(r).summary).toContain('minimum 0, maximum 8, last 7');\n      const { y } = axes(r);\n      if (kind === 'bar') {\n        const bars = marks(r, 'rects');\n        expect(bars).toHaveLength(1);\n        expect(bars[0]?.xywh).toHaveLength(32);\n        expectGeometry([2, 4, 5, 6].map(i => bars[0]!.xywh[4 * i + 3]!), [0, 0, 0, 0]);\n      } else {\n        const runs = pathRuns(marks(r, 'path')[0]!.xy);\n        expect(runs.map(run => run.length)).toEqual([8]);\n        expectGeometry([2, 4, 5, 6].map(i => runs[0]![i]![1]), [y.map(0), y.map(0), y.map(0), y.map(0)]);\n      }\n      expect(lastModel(r).summary).toContain('Values shown differently from the data: 1.');\n      if (compact) expectCompact(r);\n      else {\n        expect(lastModel(r).note).toBe('Values shown differently from the data: 1. See table.');\n        expect(rows(r).map(row => row[1])).toEqual(['6', '8', '0', '5', '0', '0', '0', '7']);\n        for (const i of [2, 4, 5, 6]) expectValues(r, date(i), ['0']);\n      }\n    });\n  }\n}\n\nfor (const type of ['line', 'area', 'compact'] as const) {\n  it(`F2 ${type}: for any generated missing index no stroke or fill run bridges it`, () => {\n    fc.assert(fc.property(fc.array(fc.option(fc.integer({ min: -8, max: 8 }), { nil: null }), { minLength: 3, maxLength: 14 }), values => {\n      const r = chart(type, values.map((y, x) => ({ x, y })), { x: { field: 'x', type: 'number' } }, undefined, type === 'compact' ? 'area' : 'line');\n      r.frames();\n      if (values.every(value => value === null)) {\n        expect(marks(r, 'path')).toEqual([]);\n        return;\n      }\n      const { x } = axes(r);\n      const indexes = (run: [number, number][]) => {\n        if (x.type === 'band') throw new Error('Expected a numeric x axis');\n        return run.map(([px]) => Math.round(x.invert(px)));\n      };\n      const strokes = marks(r, 'path').flatMap(mark => pathRuns(mark.xy));\n      const fills = marks(r, 'area').flatMap(mark => {\n        const vertices = points(mark.upper);\n        return Array.from({ length: mark.runs.length / 4 }, (_, run) => {\n          const start = mark.runs[run * 4]!;\n          return vertices.slice(start, start + mark.runs[run * 4 + 1]!);\n        });\n      });\n      for (const run of [...strokes, ...fills].map(indexes)) {\n        expect(values.slice(run[0]!, run.at(-1)! + 1)).not.toContain(null);\n      }\n    }), { numRuns: 1_000 });\n  });\n}\n\nit('F2 line: deleted daily rows and explicit nulls leave the same seven-day break', () => {\n  const data = Array.from({ length: 12 }, (_, i) => ({ x: new Date(date(i)).toISOString().slice(0, 10), y: i >= 2 && i <= 8 ? null : i }));\n  const explicit = chart('line', data);\n  const deleted = chart('line', data.filter(row => row.y !== null));\n  explicit.frames();\n  deleted.frames();\n  expect(codes(explicit)).toEqual([]);\n  expect(codes(deleted)).toContain('AX105');\n  expect(pathRuns(marks(deleted, 'path')[0]!.xy).map(run => run.length)).toEqual([2, 3]);\n  expect(marks(deleted, 'path')[0]?.xy).toEqual(marks(explicit, 'path')[0]?.xy);\n  expect(rows(deleted)).toEqual(rows(explicit));\n  expect(at(deleted, date(5)).rows[0]?.value).toBe('No data');\n});\n\nconst scatter = [{ x: 1, y: 4 }, { x: 2, y: null }, { x: 3 }, { x: 4, y: 0 }];\n\nit('F2 scatter: gaps are unplotted, zero is readable and the table says No data (reading: the table keeps omitted observations)', () => {\n  const r = chart('scatter', scatter);\n  r.frames();\n  expect(marks(r, 'points')[0]?.xy).toHaveLength(4);\n  const refs = walk(r);\n  const { lookup } = committed(r);\n  expect(refs.map(ref => lookup.datum(ref)?.value)).toEqual(['4', '0']);\n  expect(reading(r, refs[1]!)).toContain('0');\n  expect(lastModel(r).summary).toContain('minimum 0, maximum 4, last 0');\n  expect(rows(r).map(row => row[2])).toEqual(['4', 'No data', 'No data', '0']);\n});\n\nit('F2 scatter: missing zero draws two imputed zero points and exposes all four observations', () => {\n  const r = chart('scatter', scatter, { y: { field: 'y', missing: 'zero' } });\n  r.frames();\n  expect(marks(r, 'points')[0]?.xy).toHaveLength(8);\n  const refs = walk(r);\n  const { lookup } = committed(r);\n  expect(refs.map(ref => lookup.datum(ref)?.value)).toEqual(['4', '0', '0', '0']);\n  expect(rows(r).map(row => row[2])).toEqual(['4', '0', '0', '0']);\n  refs.slice(1).forEach(ref => expect(reading(r, ref)).toContain('0'));\n});\n\nit('F2 donut: null and absent slices have no arc and read No data; a real zero reads 0', () => {\n  const r = chart('donut', [{ x: 'A', y: 5 }, { x: 'B', y: null }, { x: 'C' }, { x: 'D', y: 0 }]);\n  r.frames();\n  expect(codes(r)).toEqual(['AX102']);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(2);\n  const refs = walk(r);\n  expect(refs).toHaveLength(4);\n  expect(rows(r).map(row => row[1])).toEqual(['5', 'No data', 'No data', '0']);\n  refs.forEach((ref, i) => expect(reading(r, ref)).toContain(['5', 'No data', 'No data', '0'][i]!));\n  expect(lastModel(r).summary).toContain('Total 5');\n  expect(lastModel(r).note).toBe('Values not shown: 1. See table.');\n});\n\nit('F2 bar: horizontal missing marks sit at zero and real zero is a zero-width bar', () => {\n  const r = chart('bar', [{ x: 'Valid', y: 8 }, { x: 'None', y: null }, { x: 'Zero', y: 0 }], { horizontal: true });\n  r.frames();\n  const { y } = axes(r);\n  const filled = marks(r, 'rects').find(mark => mark.variant === 'bar')!;\n  const missing = marks(r, 'rects').find(mark => mark.variant === 'missing')!;\n  expect(filled.xywh).toHaveLength(8);\n  expect(missing.xywh).toHaveLength(4);\n  expectGeometry([filled.xywh[4]!, filled.xywh[6]!, missing.xywh[0]!, missing.xywh[2]!], [y.map(0), 0, y.map(0), 0]);\n  expectValues(r, 1, ['No data']);\n  expectValues(r, 2, ['0']);\n  expect(rows(r)).toEqual([['Valid', '8'], ['None', 'No data'], ['Zero', '0']]);\n});\n\nit('F2 donut: missing zero makes null and absent counts readable as zero without drawing their arcs', () => {\n  const r = chart('donut', [{ x: 'A', y: 6 }, { x: 'B', y: null }, { x: 'C' }, { x: 'D', y: 0 }], {\n    value: { field: 'y', missing: 'zero' },\n  });\n  r.frames();\n  expect(codes(r)).toEqual(['AX102']);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(2);\n  const { lookup } = committed(r);\n  const zeros = walk(r).slice(1);\n  expect(zeros).toHaveLength(3);\n  for (const ref of zeros) {\n    if (ref.kind !== 'slice') throw new Error('Expected a slice');\n    expect(lookup.tooltip(ref).rows[0]).toMatchObject({ value: '0', percent: '0%' });\n    expect(reading(r, ref)).toContain('0 (0%)');\n  }\n  expect(rows(r).map(row => row[1])).toEqual(['6', '0', '0', '0']);\n  expect(lastModel(r).summary).toContain('Total 6');\n});\nimport fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { at, axes, chart, codes, committed, date, expectCompact, lastModel, marks, pathRuns, points, reading, refAt, rows } from './model';\n\ntype Sample = number | null;\n\nfunction observedRuns(values: readonly Sample[]) {\n  const result: number[][] = [];\n  let run: number[] = [];\n  values.forEach((value, index) => {\n    if (value !== null) run.push(index);\n    else if (run.length) {\n      result.push(run);\n      run = [];\n    }\n  });\n  if (run.length) result.push(run);\n  return result;\n}\n\nfunction extrema(indexes: readonly number[], column: (i: number) => number, values: readonly Sample[]) {\n  const result = new Map<number, [number, number]>();\n  for (const i of indexes) {\n    const key = column(i);\n    const value = values[i]!;\n    const bounds = result.get(key);\n    result.set(key, bounds ? [Math.min(bounds[0], value), Math.max(bounds[1], value)] : [value, value]);\n  }\n  return [...result];\n}\n\nfunction checkExtrema(r: ReturnType<typeof chart>, xy: readonly [number, number][][], values: readonly Sample[], ratio: number, from = 0, to = values.length - 1) {\n  const { x, y } = axes(r);\n  if (x.type === 'band') throw new Error('Expected a numeric projection');\n  const column = (i: number) => Math.floor(x.map(i) * ratio);\n  const expectedRuns = observedRuns(values.slice(from, to + 1)).filter(run => run.length > 1).map(run => run.map(i => i + from));\n  expect(xy).toHaveLength(expectedRuns.length);\n  xy.forEach((run, i) => {\n    const actual = run.map(([px, py]) => {\n      const index = Math.round(x.invert(px));\n      expect(py).toBeCloseTo(y.map(values[index]!), 3);\n      return index;\n    }).filter(index => index >= from && index <= to);\n    expect(extrema(actual, column, values)).toEqual(extrema(expectedRuns[i]!, column, values));\n  });\n}\n\nfor (const [type, kind] of [['line', 'line'], ['area', 'area'], ['compact', 'line'], ['compact', 'area']] as const) {\n  it(`F5 ${type}: for every generated dense ${kind} dataset the drawing keeps each run’s column extrema and its breaks`, () => {\n    const patterns = fc.array(fc.integer({ min: 1, max: 30 }), { minLength: 4, maxLength: 12 });\n    fc.assert(fc.property(patterns, fc.constantFrom(1, 2), (pattern, ratio) => {\n      const high = [9, 23, 29];\n      const values = Array.from({ length: 580 }, (_, i) => i === 262 ? null : high.includes(i) ? 67 : pattern[i % pattern.length]!);\n      const stacked = kind === 'area';\n      const base = 11;\n      const data = values.map((y, x) => ({ x, y, base }));\n      const r = chart(type, data, {\n        x: { field: 'x', domain: [0, 700] }, y: stacked ? ['base', 'y'] : 'y', stacked: stacked || undefined,\n      }, { container: { width: 245, height: 220 }, console: false }, kind);\n      r.host.devicePixelRatio = () => ratio;\n      r.frames();\n      if (stacked) {\n        const expected = values.map(value => base + (value ?? 0));\n        const band = marks(r, 'area').find(mark => mark.series === 1)!;\n        checkExtrema(r, [points(band.upper)], expected, ratio);\n      }\n      const boundary = stacked ? values.map(value => value === null ? null : base + value) : values;\n      const stroke = marks(r, 'path').find(mark => mark.series === Number(stacked) && mark.stroke.kind === 'series')!;\n      checkExtrema(r, pathRuns(stroke.xy), boundary, ratio);\n      if (type === 'compact') expectCompact(r);\n      else {\n        expectValuesAt(r, 23, '67', stacked ? '78' : null);\n        expect(lastModel(r).summary).toContain('maximum 67');\n      }\n    }), { numRuns: 1_000 });\n  });\n}\n\nfunction expectValuesAt(r: ReturnType<typeof chart>, index: number, expected: string, total: string | null) {\n  const tooltip = at(r, index);\n  expect(tooltip.rows.at(-1)?.value).toBe(expected);\n  expect(tooltip.total).toBe(total);\n  expect(committed(r).reader.table?.row(index)?.at(-1)).toBe(expected);\n  expect(reading(r, refAt(r, index))).toContain(expected);\n}\n\nit('F5 line: one outlier in one million stays drawn at DPR 1 and 2 and a dropped sample stays reachable by keyboard and table', () => {\n  const count = 1_000_000;\n  const outlier = 500_123;\n  const r = chart('line', { columns: {\n    x: Float64Array.from({ length: count }, (_, i) => i),\n    y: Float64Array.from({ length: count }, (_, i) => i === outlier ? 999 : 5),\n  } });\n  let ratio = 1;\n  r.host.devicePixelRatio = () => ratio;\n  r.frames();\n  for (const next of [1, 2]) {\n    ratio = next;\n    r.controller.invalidate.pixelRatio();\n    r.frames();\n    expect(committed(r).pixelRatio).toBe(next);\n    const { x, y } = axes(r);\n    if (x.type === 'band') throw new Error('Expected continuous x');\n    const vertices = points(marks(r, 'path')[0]!.xy);\n    const kept = new Set(vertices.map(([px]) => Math.round(x.invert(px))));\n    expect(vertices.length).toBeLessThan(4_000);\n    expect(kept.has(outlier)).toBe(true);\n    expect(Math.min(...vertices.map(p => p[1]))).toBeCloseTo(y.map(999), 3);\n    let dropped = 1;\n    while (kept.has(dropped)) dropped++;\n    const { lookup } = committed(r);\n    expect(lookup.step(refAt(r, dropped - 1), 'next')).toEqual(refAt(r, dropped));\n    expectValuesAt(r, dropped, '5', null);\n  }\n  expect(lastModel(r).summary).toContain('maximum 999');\n});\n\nit('F5 line: alternating null and valid slots produce isolated markers and no false segments', () => {\n  const r = chart('line', Array.from({ length: 800 }, (_, x) => ({ x, y: x % 2 === 0 ? 1 : null })));\n  r.frames();\n  expect(marks(r, 'path')).toEqual([]);\n  expect(marks(r, 'points')[0]?.xy).toHaveLength(800);\n  expect(at(r, 41).rows[0]?.value).toBe('No data');\n  expect(committed(r).reader.table?.row(41)?.[1]).toBe('No data');\n});\n\nit('F5 line: weekly observations connect across daily observations without inventing weekly rows', () => {\n  const data = Array.from({ length: 15 }, (_, i) => ({ x: date(i), y: 10, s: 'Daily' }));\n  data.push({ x: date(0), y: 2, s: 'Weekly' }, { x: date(7), y: 4, s: 'Weekly' }, { x: date(14), y: 3, s: 'Weekly' });\n  const r = chart('line', data, { x: { field: 'x', type: 'time' }, series: 's' });\n  r.frames();\n  const weekly = marks(r, 'path').find(mark => mark.series === 1)!;\n  expect(pathRuns(weekly.xy).map(run => run.length)).toEqual([3]);\n  expect(at(r, date(3)).rows.map(row => row.value)).toEqual(['10', 'No observation']);\n  expect(rows(r)[3]?.[2]).toBe('No observation');\n});\n\nfor (const type of ['line', 'area'] as const) {\n  it(`T-dense-${type} ${type}: two peaks and their gap survive at two zoom levels and two device-pixel ratios`, () => {\n    const values = Array.from({ length: 900 }, (_, i) => i === 250 ? null : i === 249 ? 29 : i === 251 ? 31 : 3);\n    const r = chart(type, values.map((y, x) => ({ x, y })), {}, { container: { width: 245, height: 220 } });\n    let ratio = 1;\n    r.host.devicePixelRatio = () => ratio;\n    r.frames();\n    for (const [from, to, dpr] of [[0, 899, 1], [110, 760, 2]] as const) {\n      ratio = dpr;\n      r.controller.invalidate.pixelRatio();\n      r.controller.handle.zoom([from, to]);\n      r.frames();\n      checkExtrema(r, pathRuns(marks(r, 'path')[0]!.xy), values, ratio, from, to);\n      expect(at(r, 250).rows[0]?.value).toBe('No data');\n      expect(at(r, 249).rows[0]?.value).toBe('29');\n      expect(at(r, 251).rows[0]?.value).toBe('31');\n    }\n  });\n}\n\nit('T-dense-bar bar: more bars than pixels raises AX132 and every rectangle is still drawn', () => {\n  const r = chart('bar', Array.from({ length: 375 }, (_, i) => ({ x: 'Band ' + i, y: 1 })), {}, { container: { width: 240, height: 240 } });\n  r.frames();\n  expect(codes(r)).toContain('AX132');\n  expect(marks(r, 'rects')[0]?.xywh).toHaveLength(375 * 4);\n  expect(committed(r).reader.table?.rowCount).toBe(375);\n});\n\nit('T-dense-donut donut: eight small positive slices retain all eight arcs', () => {\n  const r = chart('donut', Array.from({ length: 8 }, (_, i) => ({ x: 'Band ' + i, y: i === 0 ? 100_000 : 1 })));\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(16);\n  expect(committed(r).reader.table?.rowCount).toBe(8);\n});\n\nit('T-dense-scatter scatter: the hint starts above 50,000 points and none are simplified away', () => {\n  for (const length of [50_000, 50_001]) {\n    const r = chart('scatter', { columns: { x: Float64Array.from({ length }, (_, i) => i), y: new Float32Array(length).fill(4) } });\n    r.frames();\n    expect(codes(r)).toEqual(length > 50_000 ? ['AX133'] : []);\n    expect(marks(r, 'points')[0]?.xy).toHaveLength(length * 2);\n    expect(committed(r).reader.table?.rowCount).toBe(length);\n  }\n});\n\nit('F5 line: two peaks separated by a null in one device column remain in separate drawn runs', () => {\n  const values = Array.from({ length: 700 }, (_, i) => i === 250 ? null : i === 249 ? 29 : i === 251 ? 31 : 3);\n  const r = chart('line', values.map((y, x) => ({ x, y })), { x: { field: 'x', domain: [0, 500_000] } });\n  r.frames();\n  const { x } = axes(r);\n  if (x.type === 'band') throw new Error('Expected continuous x');\n  const columns = [249, 250, 251].map(sample => Math.floor(x.map(sample)));\n  expect(new Set(columns).size).toBe(1);\n  const runs = pathRuns(marks(r, 'path')[0]!.xy);\n  checkExtrema(r, runs, values, 1);\n  expect(runs.map(run => Math.round(x.invert(run[0]![0])))).toEqual([0, 251]);\n  expect(runs.map(run => Math.round(x.invert(run.at(-1)![0])))).toEqual([249, 699]);\n  expectValuesAt(r, 249, '29', null);\n  expectValuesAt(r, 251, '31', null);\n});\nimport { expect, it } from 'vitest';\nimport { aligned, axes, chart, codes, committed, expectCompact, lastModel, marks, pathRuns, plot, scene } from './model';\n\nfor (const kind of aligned) {\n  it(`C1 compact: ${kind} has a name and full summary, and the committed model is static`, () => {\n    const r = chart('compact', [{ x: 1, y: 6 }, { x: 2, y: 4 }, { x: 3, y: 8 }], {\n      title: undefined, description: 'Collected outdoors.',\n    }, undefined, kind);\n    r.frames();\n    expect(codes(r)).toEqual(['AX140']);\n    const capitalized = kind[0]!.toUpperCase() + kind.slice(1);\n    expect(lastModel(r)).toMatchObject({ compact: true, name: capitalized + ' chart of y by x', summaryVisible: false });\n    expect(lastModel(r).summary).toContain('1 series');\n    expect(lastModel(r).summary).toContain('x from 1 to 3');\n    expect(lastModel(r).summary).toContain('minimum 4, maximum 8, last 8');\n    expect(lastModel(r).summary).toContain('Collected outdoors.');\n    expectCompact(r);\n  });\n\n  it(`C2 compact: ${kind} draws only data marks, commits the sorted final geometry in one frame, and ignores public zoom`, () => {\n    const r = chart('compact', [{ x: 3, y: 8 }, { x: 1, y: 6 }, { x: 2, y: 4 }], {\n      reference: [{ y: 10, label: 'Target' }],\n    }, undefined, kind);\n    r.frames();\n    const initial = scene(r);\n    expect(initial.marks.length).toBeGreaterThan(0);\n    expect(initial.marks.every(mark => ['rects', 'area', 'path', 'points'].includes(mark.type))).toBe(true);\n    expect(lastModel(r).summary).toContain('last 8');\n    r.controller.handle.zoom([1, 2]);\n    r.frames();\n    expect(scene(r)).toEqual(initial);\n    r.controller.handle.update({ data: [{ x: 3, y: 20 }, { x: 1, y: 5 }, { x: 2, y: 9 }] });\n    expect(scene(r)).toBe(initial);\n    expect(r.frames()).toBe(1);\n    expect(scene(r)).not.toEqual(initial);\n    expect(lastModel(r).summary).toContain('minimum 5, maximum 20, last 20');\n    expectCompact(r);\n  });\n\n  it(`C3 compact: ${kind} fills a 24 by 16 CSS-pixel container and expands when measured (reading: stroke clearance can sit inside the container)`, () => {\n    const r = chart('compact', [{ x: 1, y: 3 }, { x: 2, y: 8 }], {}, { container: { width: 24, height: 16 } }, kind);\n    r.frames();\n    const initial = plot(r);\n    expect(initial).toMatchObject({ kind: 'compact', width: 24, height: 16 });\n    expect(initial.plot.width).toBeGreaterThan(0);\n    expect(initial.plot.height).toBeGreaterThan(0);\n    expect(scene(r).marks.length).toBeGreaterThan(0);\n    r.container = { width: 137, height: 32 };\n    r.controller.invalidate.resize();\n    r.frames();\n    expect(plot(r)).toMatchObject({ kind: 'compact', width: 137, height: 32 });\n    expect(plot(r).plot.width).toBeGreaterThan(initial.plot.width);\n    expect(plot(r).plot.height).toBeGreaterThan(initial.plot.height);\n    expect(codes(r)).toEqual([]);\n  });\n\n  it(`C5 compact: ${kind} supplies omission text for the corner marker and summary (reading: neither refers to an unavailable table)`, () => {\n    const r = chart('compact', [{ x: 1, y: 4 }, { x: 2, y: Infinity }, { x: 3, y: 6 }], {}, undefined, kind);\n    r.frames();\n    expect(codes(r)).toEqual(['AX103']);\n    expect(lastModel(r).compact).toBe(true);\n    expect(lastModel(r).note).toContain('Values not shown: 1.');\n    expect(lastModel(r).summary).toContain('Values not shown: 1.');\n    expect(lastModel(r).summary).toContain('minimum 4, maximum 6, last 6');\n    expectCompact(r);\n    expect(committed(r).reader.table).toBeNull();\n    expect(lastModel(r).note).not.toContain('See table');\n    expect(lastModel(r).summary).not.toContain('See table');\n  });\n}\n\nfor (const kind of ['line', 'area'] as const) {\n  it(`C4 compact: two ${kind} strokes use distinct paint bindings and dashes and AX131 suggests one series`, () => {\n    const r = chart('compact', [{ x: 1, a: 3, b: 7 }, { x: 2, a: 4, b: 5 }], { y: ['a', 'b'] }, undefined, kind);\n    r.frames();\n    const [first, second] = marks(r, 'path');\n    expect(first?.stroke).toEqual({ kind: 'series', index: 0 });\n    expect(second?.stroke).toEqual({ kind: 'series', index: 1 });\n    expect(first?.dash.normal).not.toEqual(second?.dash.normal);\n    expect(pathRuns(first!.xy)[0]).toHaveLength(2);\n    expect(axes(r).y.domain[1]).toBeGreaterThanOrEqual(7);\n    expect(r.controller.handle.diagnostics).toMatchObject([{ code: 'AX131', message: expect.stringMatching(/one series/i) }]);\n    expectCompact(r);\n  });\n}\n","exit_code":0,"status":"completed"}}
