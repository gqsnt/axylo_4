{"type":"item.completed","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc 'cat packages/axylo/test/acceptance/{f-domains,f-series,f-stacks,f-order,f-donut}.test.ts; cat packages/axylo/test/acceptance/{f-format,f-time,f-disclosure,production}.test.ts'","aggregated_output":"import fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { axes, chart, codes, committed, expectCompact, expectGeometry, expectValues, lastModel, marks, plot, points, rows } from './model';\n\nconst pair = (value: number) => [{ x: 1, y: value }, { x: 2, y: value }];\n\nfor (const [type, kind] of [['area', 'area'], ['bar', 'bar'], ['compact', 'area'], ['compact', 'bar']] as const) {\n  it(`F1 ${type}: for any generated signed ${kind} data the value domain and drawn baseline include zero, even with an excluding author domain`, () => {\n    const values = fc.integer({ min: -100, max: 100 });\n    fc.assert(fc.property(values, values, fc.boolean(), (a, b, authored) => {\n      const domain = authored ? (a < 0 && b < 0 ? [-120, -1] : [1, 120]) : undefined;\n      const r = chart(type, [{ x: 1, y: a }, { x: 2, y: b }], { y: { field: 'y', domain } }, undefined, kind);\n      r.frames();\n      const { y } = axes(r);\n      expect(y.domain[0]).toBeLessThanOrEqual(0);\n      expect(y.domain[1]).toBeGreaterThanOrEqual(0);\n      if (authored) {\n        expect(y.domain).toEqual(domain![0]! < 0 ? [-120, 0] : [0, 120]);\n        expect(codes(r)).toEqual(['AX110']);\n      } else {\n        expect(y.domain[0]).toBeLessThanOrEqual(Math.min(a, b));\n        expect(y.domain[1]).toBeGreaterThanOrEqual(Math.max(a, b));\n        expect(codes(r)).toEqual([]);\n      }\n      const baseline = y.map(0);\n      if (kind === 'area') {\n        const lower = points(marks(r, 'area')[0]!.lower);\n        expectGeometry(lower.map(p => p[1]), [baseline, baseline]);\n      } else {\n        const { xywh } = marks(r, 'rects')[0]!;\n        expect(xywh).toHaveLength(8);\n        for (const i of [0, 4]) expect(Math.min(Math.abs(xywh[i + 1]! - baseline), Math.abs(xywh[i + 1]! + xywh[i + 3]! - baseline))).toBeLessThan(0.001);\n      }\n    }), { numRuns: 1_000, seed: 4026 });\n  });\n\n  it(`F1 ${type}: ${kind} draws the 82 to 97 fixture from zero and reads the actual values`, () => {\n    const r = chart(type, [{ x: 'Floor', y: 82 }, { x: 'Ceiling', y: 97 }], { y: { field: 'y', domain: [80, 100] } }, undefined, kind);\n    r.frames();\n    expect(axes(r).y.domain).toEqual([0, 100]);\n    expect(codes(r)).toEqual(['AX110']);\n    expect(lastModel(r).summary).toContain('minimum 82, maximum 97, last 97');\n    expect(lastModel(r).note).toBeNull();\n    if (type === 'compact') expectCompact(r);\n    else {\n      expect(rows(r)).toEqual([['Floor', '82'], ['Ceiling', '97']]);\n      expectValues(r, 0, ['82']);\n      expectValues(r, 1, ['97']);\n    }\n  });\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F7 ${type}: for any generated extents the automatic domain includes data and references and the zoom stays inside its governing domain`, () => {\n    fc.assert(fc.property(fc.integer({ min: 6, max: 40 }), fc.integer({ min: 41, max: 70 }), fc.boolean(), (max, reference, authored) => {\n      const r = chart(type, [{ x: 2, y: -5 }, { x: 4, y: max }], {\n        x: { field: 'x', domain: authored ? [0, 10] : undefined }, reference: [{ x: 8, label: 'Deadline' }, { y: reference, label: 'Target' }],\n      });\n      r.frames();\n      const initial = axes(r);\n      expect(initial.y.domain[0]).toBeLessThanOrEqual(-5);\n      expect(initial.y.domain[1]).toBeGreaterThanOrEqual(reference);\n      if (initial.x.type === 'band') throw new Error('Expected a continuous x axis');\n      if (authored) expect(initial.x.domain).toEqual([0, 10]);\n      else expect(initial.x.domain[1]).toBeGreaterThanOrEqual(8);\n      r.controller.handle.zoom([-20, -17]);\n      r.frames();\n      const view = committed(r).view;\n      if (view.kind === 'donut') throw new Error('Expected Cartesian view');\n      if (type === 'compact') expect(view.xDomain).toEqual(initial.x.domain);\n      else {\n        expect(view.xDomain[0]).toBe(initial.x.domain[0]);\n        expect(view.xDomain[1]).toBe(initial.x.domain[0] + 3);\n        expect(view.xDomain[1]).toBeLessThanOrEqual(initial.x.domain[1]);\n      }\n    }), { numRuns: 1_000, seed: 4026 });\n  });\n\n  for (const [scale, small, half, full, above] of [['percent', 4, 50, 100, 110], ['ratio', 0.04, 0.5, 1, 1.1]] as const) {\n    it(`F7 ${type}: declared ${scale} reaches full scale at half scale while a small maximum uses the first tick`, () => {\n      for (const [maximum, relation] of [[small, 'below'], [half, 'full'], [full, 'full'], [above, 'above']] as const) {\n        const r = chart(type, pair(maximum), { y: { field: 'y', scale } });\n        r.frames();\n        const upper = axes(r).y.domain[1];\n        if (relation === 'below') expect(upper).toBeLessThan(full);\n        if (relation === 'full') expect(upper).toBe(full);\n        if (relation === 'above') expect(upper).toBeGreaterThan(full);\n        expect(upper).toBeGreaterThanOrEqual(maximum);\n      }\n      const labelOnly = chart(type, pair(half), { y: { field: 'y', label: 'Percent (%)' } });\n      labelOnly.frames();\n      expect(axes(labelOnly).y.domain[1]).toBeLessThan(full);\n    });\n  }\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n  it(`F7 ${type}: for any generated reference extreme the automatic value domain ends at the first drawn tick that reaches it (reading: the tick is the one the reader sees)`, () => {\n    fc.assert(fc.property(fc.integer({ min: 41, max: 70 }), reference => {\n      const r = chart(type, [{ x: 2, y: -5 }, { x: 4, y: 6 }], { reference: [{ y: reference, label: 'Target' }] });\n      r.frames();\n      const layout = plot(r);\n      if (layout.kind !== 'plot') throw new Error('Expected tick labels');\n      const { domain } = axes(r).y;\n      expect(layout.yTicks[0]?.value).toBe(domain[0]);\n      expect(domain[1]).toBe(layout.yTicks.find(tick => tick.value >= reference)?.value);\n    }), { numRuns: 1_000, seed: 4026 });\n  });\n}\nimport { expect, it } from 'vitest';\nimport { at, chart, codes, committed, expectCompact, lastModel, marks, seriesRows } from './model';\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F9 ${type}: six and eight series have distinct paint bindings; twelve retain distinct painted cues and raise AX130`, () => {\n    for (const size of [6, 8, 12]) {\n      const r = chart(type, seriesRows(size), { series: 's' });\n      r.frames();\n      expect(codes(r).includes('AX130')).toBe(size > 8);\n      const cues = type === 'bar' ? marks(r, 'rects').filter(mark => mark.variant === 'bar').map(mark => [mark.fill, mark.pattern ?? 'none'])\n        : type === 'scatter' ? marks(r, 'points').map(mark => [mark.fill, mark.shape])\n          : marks(r, 'path').map(mark => [mark.stroke, mark.dash.normal]);\n      expect(cues).toHaveLength(size);\n      const firstEight = cues.slice(0, 8).map(([paint]) => JSON.stringify(paint));\n      expect(new Set(firstEight).size).toBe(Math.min(8, size));\n      expect(new Set(cues.map(cue => JSON.stringify(cue))).size).toBe(size);\n      for (let i = 8; i < size; i++) expect(cues[i]![1]).not.toEqual(cues[i - 8]![1]);\n      expect(lastModel(r).summary).toContain(size + ' series');\n      expect(lastModel(r).note).toBeNull();\n      if (type === 'compact') expectCompact(r);\n      else if (type !== 'scatter') {\n        expect(at(r, 1).count).toBe(size);\n        expect(at(r, 1).rows.map(row => row.seriesLabel)).toEqual(seriesRows(Math.min(size, 8)).filter(row => row.x === 1).map(row => row.s));\n        expect(committed(r).reader.table?.headers).toHaveLength(size + 1);\n      }\n    }\n  });\n}\nimport fc from 'fast-check';\nimport { expect, it } from 'vitest';\nimport { at, axes, chart, expectCompact, expectGeometry, lastModel, marks, pixel, points, reading, refAt, rows } from './model';\n\nconst stacks = [['area', 'area'], ['bar', 'bar'], ['compact', 'area'], ['compact', 'bar']] as const;\nconst options = (kind: 'area' | 'bar') => ({ y: ['a', 'b', 'c', 'd'], ...(kind === 'area' ? { stacked: true } : { layout: 'stacked' }) });\n\nfor (const [type, kind] of stacks) {\n  it(`F10 ${type}: for any generated mixed-sign ${kind} stacks each drawn component uses its own side of zero and the axis covers both sums`, () => {\n    const value = fc.integer({ min: 2, max: 20 });\n    fc.assert(fc.property(value, value, value, value, (a, b, c, d) => {\n      const records = [{ x: 1, a, b: -b, c, d: -d }, { x: 2, a, b: -b, c, d: -d }];\n      const r = chart(type, records, options(kind), undefined, kind);\n      r.frames();\n      const { y } = axes(r);\n      const bases = [0, 0, a, -b];\n      const tips = [a, -b, a + c, -b - d];\n      expect(y.domain[0]).toBeLessThanOrEqual(-b - d);\n      expect(y.domain[1]).toBeGreaterThanOrEqual(a + c);\n      if (kind === 'bar') {\n        for (const mark of marks(r, 'rects')) {\n          expect(mark.variant).toBe('bar');\n          expect(mark.xywh).toHaveLength(8);\n          for (const offset of [0, 4]) {\n            const pixelTop = mark.xywh[offset + 1]!;\n            const pixelBottom = pixelTop + mark.xywh[offset + 3]!;\n            const positive = tips[mark.series]! > 0;\n            expect(positive ? pixelTop : pixelBottom).toBeCloseTo(y.map(tips[mark.series]!), 3);\n            const base = positive ? pixelBottom : pixelTop;\n            expect(Math.abs(base - y.map(bases[mark.series]!))).toBeLessThanOrEqual(1.001);\n            expect(Math.sign(y.invert((pixelTop + pixelBottom) / 2))).toBe(positive ? 1 : -1);\n          }\n        }\n      } else {\n        for (const mark of marks(r, 'area')) {\n          const [top, count, bottom, lowerCount] = mark.runs;\n          expect([count, lowerCount]).toEqual([2, 2]);\n          expectGeometry(points(mark.upper).slice(top!, top! + count!).map(p => p[1]), [y.map(tips[mark.series]!), y.map(tips[mark.series]!)]);\n          expectGeometry(points(mark.lower).slice(bottom!, bottom! + lowerCount!).map(p => p[1]), [y.map(bases[mark.series]!), y.map(bases[mark.series]!)]);\n        }\n      }\n    }), { numRuns: 1_000 });\n  });\n\n  it(`F10 ${type}: a missing ${kind} component has zero height and the reader is told which stack is incomplete${type === 'compact' ? ' (reading: the summary provides the incomplete warning)' : ''}`, () => {\n    const r = chart(type, [\n      { x: 1, a: 5, b: -3, c: 4, d: -2 },\n      { x: 2, a: 5, b: -3, c: null, d: -2 },\n      { x: 3, a: 5, b: -3, c: 4, d: -2 },\n    ], options(kind), undefined, kind);\n    r.frames();\n    const { x, y } = axes(r);\n    if (kind === 'bar') {\n      const missing = marks(r, 'rects').find(mark => mark.series === 2 && mark.variant === 'missing');\n      expect(missing?.xywh).toHaveLength(4);\n      expectGeometry([missing!.xywh[1]!, missing!.xywh[3]!], [y.map(5), 0]);\n    } else {\n      const mark = marks(r, 'area').find(mark => mark.series === 2)!;\n      const middle = pixel(x, 2);\n      const ordinate = (xy: Float32Array) => points(xy).filter(p => Math.abs(p[0] - middle) < 0.001);\n      expect(ordinate(mark.upper).some(p => Math.abs(p[1] - y.map(5)) < 0.001)).toBe(true);\n      expect(ordinate(mark.lower).some(p => Math.abs(p[1] - y.map(5)) < 0.001)).toBe(true);\n    }\n    if (type === 'compact') {\n      expectCompact(r);\n      expect(lastModel(r).summary).toContain('incomplete');\n    } else {\n      expect(at(r, 1).total).toBe('4');\n      expect(at(r, 2).total).toBe('0 (incomplete)');\n      expect(at(r, 2).rows.map(row => row.value)).toEqual(['5', '-3', 'No data', '-2']);\n      expect(rows(r)[1]).toEqual(['2 (incomplete)', '5', '-3', 'No data', '-2']);\n      expect(reading(r, refAt(r, 2))).toContain('Total 0 (incomplete)');\n      expect(lastModel(r).note).toBeNull();\n    }\n  });\n}\nimport { expect, it } from 'vitest';\nimport { aligned, at, axes, chart, codes, committed, expectCompact, expectGeometry, lastModel, marks, pathRuns, points, reading, rows, walk } from './model';\n\nfor (const type of ['line', 'area', 'scatter', 'compact'] as const) {\n  it(`F11 ${type}: shuffled observations draw in ascending x and the last value belongs to the largest x`, () => {\n    const sorted = [{ x: 1, y: 8 }, { x: 2, y: 5 }, { x: 3, y: 9 }];\n    const r = chart(type, [sorted[2], sorted[0], sorted[1]]);\n    r.frames();\n    const { x, y } = axes(r);\n    if (x.type === 'band') throw new Error('Expected numeric x');\n    const vertices = type === 'scatter' ? points(marks(r, 'points')[0]!.xy) : pathRuns(marks(r, 'path')[0]!.xy)[0]!;\n    expectGeometry(vertices.flat(), [x.map(1), y.map(8), x.map(2), y.map(5), x.map(3), y.map(9)]);\n    if (type === 'area') expectGeometry(Array.from(marks(r, 'area')[0]!.upper), vertices.flat());\n    expect(lastModel(r).summary).toContain('minimum 5, maximum 9, last 9');\n    expect(lastModel(r).note).toBeNull();\n    if (type === 'compact') expectCompact(r);\n    else {\n      expect(rows(r).map(row => [row[0], row[type === 'scatter' ? 2 : 1]])).toEqual([['1', '8'], ['2', '5'], ['3', '9']]);\n      const { lookup } = committed(r);\n      expect(walk(r).map(ref => lookup.datum(ref)?.row)).toEqual([1, 2, 0]);\n      const last = lookup.step(null, 'first');\n      expect(reading(r, last!)).toContain('8');\n    }\n  });\n}\n\nfor (const type of [...aligned, 'compact'] as const) {\n  const variants = type === 'compact' ? aligned : [type];\n  for (const kind of variants) {\n    it(`F11 ${type}: duplicate x disables just the affected ${kind} series and the model identifies that series`, () => {\n      const r = chart(type, [\n        { x: 1, y: 8, s: 'Keep' }, { x: 2, y: 5, s: 'Keep' },\n        { x: 1, y: 9, s: 'Duplicate' }, { x: 1, y: 10, s: 'Duplicate' },\n      ], { series: 's' }, undefined, kind);\n      r.frames();\n      expect(codes(r)).toContain('AX108');\n      expect(r.controller.handle.diagnostics.find(d => d.code === 'AX108')).toMatchObject({ level: 'error', field: 'x', rows: [3] });\n      const drawn = [...marks(r, 'path'), ...marks(r, 'area'), ...marks(r, 'rects'), ...marks(r, 'points')];\n      expect(drawn.length).toBeGreaterThan(0);\n      expect(new Set(drawn.map(mark => mark.series))).toEqual(new Set([0]));\n      expect(lastModel(r).summary).toMatch(/Duplicate .*could not be drawn|Duplicate could not be drawn/);\n      if (type === 'compact') expectCompact(r);\n      else {\n        expect(at(r, 1).rows.map(row => row.seriesLabel)).toEqual(['Keep']);\n        expect(committed(r).reader.table?.headers).toContain('Duplicate');\n        expect(reading(r, walk(r)[0]!)).toContain('Keep 8');\n      }\n    });\n  }\n}\n\nit('F11 scatter: equal x and coincident coordinates are all drawn, with x then y order and original row provenance', () => {\n  const r = chart('scatter', [{ x: 2, y: 5 }, { x: 1, y: 7 }, { x: 1, y: 3 }, { x: 1, y: 3 }]);\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  const { x, y } = axes(r);\n  if (x.type === 'band') throw new Error('Expected numeric x');\n  expectGeometry(Array.from(marks(r, 'points')[0]!.xy), [x.map(1), y.map(3), x.map(1), y.map(3), x.map(1), y.map(7), x.map(2), y.map(5)]);\n  const { lookup } = committed(r);\n  const target = lookup.pick(x.map(1), y.map(3))!;\n  expect(lookup.tooltip(target).rows.map(row => row.row).sort()).toEqual([2, 3]);\n  expect(rows(r).map(row => [row[0], row[2]])).toEqual([['1', '3'], ['1', '3'], ['1', '7'], ['2', '5']]);\n  expect(reading(r, walk(r)[0]!)).toContain('3');\n  expect(lastModel(r).summary).toContain('minimum 3, maximum 7, last 5');\n});\nimport { expect, it } from 'vitest';\nimport { sliceText } from '../../src/lookup/text';\nimport { chart, codes, committed, expectGeometry, lastModel, marks, reading, rows, walk } from './model';\n\nit('F8 donut: slices start at twelve and run clockwise in input order; zero and null are listed without arcs', () => {\n  const r = chart('donut', [{ x: 'Retail', y: 3 }, { x: 'None', y: 0 }, { x: 'Unknown', y: null }, { x: 'Trade', y: 1 }]);\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  const arc = marks(r, 'arcs')[0]!;\n  expectGeometry(Array.from(arc.angles), [0, 1.5 * Math.PI, 1.5 * Math.PI, 2 * Math.PI]);\n  expect(arc.fills.every(paint => paint.kind === 'series')).toBe(true);\n  expect(new Set(arc.fills.map(paint => JSON.stringify(paint))).size).toBe(2);\n  const { lookup, view, formatters } = committed(r);\n  if (view.kind !== 'donut') throw new Error('Expected a donut view');\n  expect(view.slices.map(slice => {\n    const { label, value, percent } = sliceText(view, slice, formatters);\n    return [label, value, percent];\n  })).toEqual([['Retail', '3', '75%'], ['None', '0', '0%'], ['Unknown', 'No data', null], ['Trade', '1', '25%']]);\n  const legendReadouts = walk(r).map(ref => {\n    if (ref.kind !== 'slice') throw new Error('Expected a donut slice');\n    const tooltip = lookup.tooltip(ref);\n    return [tooltip.title, tooltip.rows[0]?.value, tooltip.rows[0]?.percent];\n  });\n  expect(legendReadouts).toEqual([\n    ['Retail', '3', '75%'], ['None', '0', '0%'], ['Unknown', 'No data', null], ['Trade', '1', '25%'],\n  ]);\n  expect(rows(r).map(row => row.slice(0, 2))).toEqual([['Retail', '3'], ['None', '0'], ['Unknown', 'No data'], ['Trade', '1']]);\n  expect(reading(r, walk(r)[0]!)).toContain('3 (75%)');\n  expect(lastModel(r).summary).toContain('Retail: 3 (75%).');\n  expect(lastModel(r).summary).toContain('Trade: 1 (25%).');\n  expect(lastModel(r).note).toBeNull();\n});\n\nit('F8 donut: seven largest categories and Other (3) are drawn; all ten categories remain individually readable in the table', () => {\n  const data = [\n    { x: 'A', y: 2 }, { x: 'B', y: 13 }, { x: 'C', y: 1 }, { x: 'D', y: 12 }, { x: 'E', y: 11 },\n    { x: 'F', y: 10 }, { x: 'G', y: 9 }, { x: 'H', y: 8 }, { x: 'I', y: 7 }, { x: 'J', y: 3 },\n  ];\n  const r = chart('donut', data);\n  r.frames();\n  expect(codes(r)).toEqual(['AX121']);\n  const { lookup } = committed(r);\n  const labelAndValue = walk(r).map(ref => {\n    const datum = lookup.datum(ref)!;\n    return [datum.seriesLabel, datum.value];\n  });\n  expect(labelAndValue).toEqual([['B', '13'], ['D', '12'], ['E', '11'], ['F', '10'], ['G', '9'], ['H', '8'], ['I', '7'], ['Other (3)', '6']]);\n  const fractions = [0, 13, 25, 36, 46, 55, 63, 70, 76].map(value => value / 76 * 2 * Math.PI);\n  const arc = marks(r, 'arcs')[0]!;\n  expectGeometry(Array.from(arc.angles), fractions.slice(0, -1).flatMap((start, i) => [start, fractions[i + 1]!]));\n  expect(arc.fills.at(-1)).toEqual({ kind: 'token', name: 'muted' });\n  expect(rows(r).map(row => row.slice(0, 2))).toEqual(data.map(row => [row.x, String(row.y)]));\n  expect(reading(r, walk(r).at(-1)!)).toContain('Other (3)');\n  expect(lastModel(r).summary).toContain('Other (3): 6');\n});\n\nit('F8 donut: a negative value shows the error state and clears all arcs', () => {\n  const r = chart('donut', [{ x: 'A', y: 2 }, { x: 'B', y: 1 }]);\n  r.frames();\n  r.controller.handle.update({ data: [{ x: 'A', y: 2 }, { x: 'B', y: -1 }] });\n  r.frames();\n  expect(codes(r)).toEqual(['AX120']);\n  expect(marks(r, 'arcs')).toEqual([]);\n  expect(lastModel(r).message).toBe('The chart could not be drawn.');\n  expect(r.announcements).toEqual(['The chart could not be drawn.']);\n});\n\nit('F8 donut: all-zero values show the empty state while the table retains both zero values', () => {\n  const r = chart('donut', [{ x: 'A', y: 0 }, { x: 'B', y: 0 }]);\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  expect(marks(r, 'arcs')).toEqual([]);\n  expect(lastModel(r).message).toBe('No data to show.');\n  expect(lastModel(r).summary).toContain('No data to show.');\n  expect(rows(r).map(row => row.slice(0, 2))).toEqual([['A', '0'], ['B', '0']]);\n});\n\nit('F8 donut: the eight-arc limit keeps zero and missing categories separately readable (reading: only drawn arcs use the limit)', () => {\n  const r = chart('donut', [\n    ...Array.from({ length: 8 }, (_, i) => ({ x: 'Positive ' + i, y: i + 1 })),\n    { x: 'Zero', y: 0 }, { x: 'Missing', y: null },\n  ]);\n  r.frames();\n  expect(codes(r)).toEqual([]);\n  expect(marks(r, 'arcs')[0]?.angles).toHaveLength(16);\n  expect(rows(r).slice(-2).map(row => row.slice(0, 2))).toEqual([['Zero', '0'], ['Missing', 'No data']]);\n  expect(walk(r).slice(-2).map(ref => committed(r).lookup.datum(ref)?.seriesLabel)).toEqual(['Zero', 'Missing']);\n});\nimport { expect, it } from 'vitest';\nimport { chart, codes, committed, expectCompact, lastModel, marks, reading, rows, types, walk } from './model';\n\nconst examples = [\n  ['en-US', '123,456.75', '0.000123456', '0.3'],\n  ['de-DE', '123.456,75', '0,000123456', '0,3'],\n  ['en-IN', '1,23,456.75', '0.000123456', '0.3'],\n] as const;\n\nfor (const type of types) {\n  it(`F6 ${type}: localized readouts keep the full integer and six significant fraction digits, with the unit`, () => {\n    for (const [locale, large, small, sum] of examples) {\n      const field = { field: 'y', unit: 'ms' };\n      const r = chart(type, [\n        { x: type === 'donut' ? 'A' : 1, y: 123456.75 },\n        { x: type === 'donut' ? 'B' : 2, y: 0.000123456321 },\n        { x: type === 'donut' ? 'C' : 3, y: 0.1 + 0.2 },\n      ], { locale, [type === 'donut' ? 'value' : 'y']: field });\n      r.frames();\n      const expected = [large, small, sum].map(value => value + ' ms');\n      expect(codes(r)).toEqual([]);\n      expect(lastModel(r).summary).toContain(expected[0]);\n      expect(lastModel(r).summary).toContain(expected[1]);\n      expect(lastModel(r).summary).toContain(expected[2]);\n      expect(lastModel(r).note).toBeNull();\n      if (type === 'compact') expectCompact(r);\n      else {\n        expect(rows(r).map(row => row[type === 'scatter' ? 2 : 1])).toEqual(expected);\n        const { lookup } = committed(r);\n        walk(r).forEach((ref, i) => {\n          const target = ref.kind === 'aligned' ? { kind: 'x' as const, x: ref.x }\n            : ref.kind === 'point' ? { kind: 'point' as const, refs: [ref], count: 1 } : ref;\n          expect(lookup.tooltip(target).rows[0]?.value).toBe(expected[i]);\n          expect(reading(r, ref)).toContain(expected[i]);\n        });\n      }\n      const mark = type === 'donut' ? 'arcs' : type === 'scatter' ? 'points' : type === 'bar' ? 'rects' : 'path';\n      expect(marks(r, mark)).toHaveLength(1);\n    }\n  });\n\n  it(`F6 ${type}: a throwing value formatter falls back for reader text and preserves drawn marks`, () => {\n    const r = chart(type, [{ x: type === 'donut' ? 'A' : 1, y: 123456.75 }, { x: type === 'donut' ? 'B' : 2, y: 20 }], {\n      [type === 'donut' ? 'value' : 'y']: { field: 'y', unit: 'ms', format() { throw new Error('formatter fixture'); } },\n    });\n    r.frames();\n    expect(lastModel(r).summary).toContain('123,456.75 ms');\n    if (type === 'compact') expectCompact(r);\n    else {\n      expect(rows(r)[0]?.[type === 'scatter' ? 2 : 1]).toBe('123,456.75 ms');\n      expect(reading(r, walk(r)[0]!)).toContain('123,456.75 ms');\n    }\n    expect(codes(r)).toEqual(['AX160']);\n    const mark = type === 'donut' ? 'arcs' : type === 'scatter' ? 'points' : type === 'bar' ? 'rects' : 'path';\n    expect(marks(r, mark)).toHaveLength(1);\n  });\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n  it(`F6 ${type}: compact ticks and full readouts use separate formatters`, () => {\n    const r = chart(type, [{ x: 1, y: 50_000 }, { x: 2, y: 100_000 }], {\n      y: { field: 'y', unit: 'ms', domain: [0, 100_000], tickFormat: { notation: 'compact' } },\n    });\n    r.frames();\n    const ticks = r.texts.at(-1)?.filter(text => text.role === 'tick-y').map(text => text.full);\n    expect(ticks).toContain('100K');\n    expect(rows(r).map(row => row[type === 'scatter' ? 2 : 1])).toEqual(['50,000 ms', '100,000 ms']);\n    expect(reading(r, walk(r).at(-1)!)).toContain('100,000 ms');\n  });\n}\n\nit('F6 donut: percentage text is independently localized in tooltip and table', () => {\n  const r = chart('donut', [{ x: 'A', y: 1 }, { x: 'B', y: 7 }], { locale: 'de-DE' });\n  r.frames();\n  const first = walk(r)[0]!;\n  if (first.kind !== 'slice') throw new Error('Expected a slice');\n  const percent = committed(r).lookup.tooltip(first).rows[0]?.percent;\n  expect(percent?.replaceAll('\\u00a0', ' ')).toBe('12,5 %');\n  expect(rows(r)[0]?.[2]?.replaceAll('\\u00a0', ' ')).toBe('12,5 %');\n  expect(reading(r, first)?.replaceAll('\\u00a0', ' ')).toContain('12,5 %');\n});\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F6 ${type}: dates in the summary, table and readouts follow the locale with the same calendar day`, () => {\n    for (const locale of ['en-US', 'de-DE', 'en-IN']) {\n      const r = chart(type, [{ x: '2024-02-29', y: 18 }, { x: '2024-03-01', y: 20 }], { locale, x: { field: 'x', timeZone: 'Asia/Kolkata' } });\n      r.frames();\n      const formatter = new Intl.DateTimeFormat(locale, { month: 'short', day: 'numeric', year: 'numeric', timeZone: 'UTC' });\n      const expected = formatter.format(Date.UTC(2024, 1, 29));\n      expect(lastModel(r).summary).toContain(expected);\n      if (type === 'compact') expectCompact(r);\n      else {\n        const ref = walk(r)[0]!;\n        const target = ref.kind === 'aligned' ? { kind: 'x' as const, x: ref.x } : { kind: 'point' as const, refs: [ref], count: 1 };\n        expect(committed(r).lookup.tooltip(target).title).toBe(expected);\n        expect(rows(r)[0]?.[0]).toBe(expected);\n        expect(reading(r, ref)).toContain(expected);\n      }\n    }\n  });\n}\nimport { expect, it } from 'vitest';\nimport { at, axes, chart, codes, committed, expectCompact, lastModel, marks, pixel, points, reading, rows, walk, type Type } from './model';\n\nconst zones = ['UTC', 'America/Los_Angeles', 'Asia/Kolkata'] as const;\nconst instant = Date.UTC(2024, 1, 29);\nconst following = Date.UTC(2024, 2, 1);\nconst dates = ['2024-02-29', '2024-03-01'];\nconst instants = [\n  ['Feb 29, 2024, 12:00 AM UTC', 'Mar 1, 2024, 12:00 AM UTC'],\n  ['Feb 28, 2024, 4:00 PM PST', 'Feb 29, 2024, 4:00 PM PST'],\n  ['Feb 29, 2024, 5:30 AM GMT+5:30', 'Mar 1, 2024, 5:30 AM GMT+5:30'],\n] as const;\n\nfunction check(r: ReturnType<typeof chart>, type: Type, positions: readonly number[], text: readonly string[]) {\n  const x = axes(r).x;\n  expect(x.type).toBe('time');\n  const pixels = positions.map(value => pixel(x, value));\n  const actual = type === 'bar'\n    ? [0, 4].map(i => marks(r, 'rects')[0]!.xywh[i]! + marks(r, 'rects')[0]!.xywh[i + 2]! / 2)\n    : points(type === 'scatter' ? marks(r, 'points')[0]!.xy : marks(r, 'path')[0]!.xy).map(p => p[0]);\n  expect(actual).toHaveLength(pixels.length);\n  pixels.forEach((expected, i) => expect(actual[i]).toBeCloseTo(expected, 3));\n  text.forEach(heading => expect(lastModel(r).summary).toContain(heading));\n  expect(lastModel(r).note ?? '').not.toMatch(/values (not shown|shown differently)/i);\n  if (type === 'compact') expectCompact(r);\n  else {\n    expect(rows(r).map(row => row[0]?.replaceAll('\\u202f', ' '))).toEqual(text);\n    const { lookup } = committed(r);\n    walk(r).forEach((ref, i) => {\n      const heading = type === 'scatter'\n        ? lookup.tooltip({ kind: 'point', refs: [ref], count: 1 }).title\n        : at(r, positions[i]!).title;\n      expect(heading.replaceAll('\\u202f', ' ')).toBe(text[i]);\n      expect(reading(r, ref)?.replaceAll('\\u202f', ' ')).toContain(text[i]);\n    });\n  }\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F4 ${type}: calendar days, months and years keep their input precision across time zones (reading: month and year inputs keep their granularity)`, () => {\n    for (const timeZone of zones) {\n      const r = chart(type, dates.map((x, i) => ({ x, y: i + 2 })), { x: { field: 'x', timeZone } });\n      r.frames();\n      check(r, type, [instant, following], ['Feb 29, 2024', 'Mar 1, 2024']);\n      expect(codes(r)).toEqual([]);\n      expect(lastModel(r).summary).not.toContain(timeZone);\n    }\n    for (const [values, expected, positions] of [\n      [['2024-02', '2024-03'], ['Feb 2024', 'Mar 2024'], [Date.UTC(2024, 1, 1), Date.UTC(2024, 2, 1)]],\n      [['2024', '2025'], ['2024', '2025'], [Date.UTC(2024, 0, 1), Date.UTC(2025, 0, 1)]],\n    ] as const) {\n      const r = chart(type, values.map((x, i) => ({ x, y: i + 2 })), { x: { field: 'x', timeZone: zones[1] } });\n      r.frames();\n      check(r, type, positions, expected);\n    }\n  });\n\n  for (const form of ['ISO with offset', 'Date objects', 'declared epoch milliseconds'] as const) {\n    it(`F4 ${type}: ${form} read in three local times, name the zone and raise AX111 for whole days (reading: Intl zone aliases name the same zone)`, () => {\n      const values = form === 'ISO with offset' ? ['2024-02-29T05:30:00+05:30', '2024-03-01T00:00:00Z']\n        : form === 'Date objects' ? [new Date(instant), new Date(following)] : [instant, following];\n      zones.forEach((timeZone, i) => {\n        const r = chart(type, values.map((x, i) => ({ x, y: i + 2 })), {\n          x: { field: 'x', timeZone, type: form === 'declared epoch milliseconds' ? 'time' : undefined },\n        }, { container: { width: 1600, height: 400 } });\n        r.frames();\n        expect(codes(r).filter(code => code !== 'AX143')).toEqual(['AX111']);\n        check(r, type, [instant, following], instants[i]!);\n        expect(lastModel(r).summary).toContain('Times are shown in ' + new Intl.DateTimeFormat('en-US', { timeZone }).resolvedOptions().timeZone + '.');\n      });\n    });\n  }\n\n  it(`F4 ${type}: DST spring skips an hour and fall repeats it with distinct zone abbreviations`, () => {\n    for (const [a, b, expected] of [\n      [Date.UTC(2024, 2, 10, 9, 30), Date.UTC(2024, 2, 10, 10, 30), ['Mar 10, 2024, 1:30 AM PST', 'Mar 10, 2024, 3:30 AM PDT']],\n      [Date.UTC(2024, 10, 3, 8, 30), Date.UTC(2024, 10, 3, 9, 30), ['Nov 3, 2024, 1:30 AM PDT', 'Nov 3, 2024, 1:30 AM PST']],\n    ] as const) {\n      const r = chart(type, [{ x: a, y: 3 }, { x: b, y: 4 }], { x: { field: 'x', type: 'time', timeZone: zones[1] } });\n      r.frames();\n      check(r, type, [a, b], expected);\n    }\n  });\n\n  it(`F4 ${type}: wall-clock input stays as written through a DST transition and raises AX112`, () => {\n    const a = Date.UTC(2024, 2, 10, 2, 30);\n    const b = Date.UTC(2024, 2, 10, 3, 30);\n    const r = chart(type, [{ x: '2024-03-10T02:30', y: 3 }, { x: '2024-03-10T03:30', y: 4 }], { x: { field: 'x', timeZone: zones[1] } });\n    r.frames();\n    expect(codes(r)).toEqual(['AX112']);\n    check(r, type, [a, b], ['Mar 10, 2024, 2:30 AM', 'Mar 10, 2024, 3:30 AM']);\n    expect(lastModel(r).summary).not.toContain(zones[1]);\n  });\n\n  it(`F4 ${type}: an impossible date is omitted, and bare epoch-like numbers remain numbers`, () => {\n    const bad = chart(type, [{ x: dates[0], y: 3 }, { x: '2024-02-30', y: 99 }, { x: dates[1], y: 4 }], { x: { field: 'x', type: 'date' } });\n    bad.frames();\n    expect(codes(bad)).toEqual(['AX107']);\n    expect(lastModel(bad).summary).toContain('maximum 4');\n    expect(lastModel(bad).summary).toContain('Values not shown: 1.');\n    if (type !== 'compact') expect(rows(bad).map(row => row[0])).toEqual(['Feb 29, 2024', 'Mar 1, 2024']);\n    const bare = chart(type, [{ x: instant, y: 3 }, { x: following, y: 4 }]);\n    bare.frames();\n    expect(codes(bare)).toEqual(['AX109']);\n    expect(axes(bare).x.type).toBe('linear');\n    expect(lastModel(bare).summary).toContain('1,709,164,800,000');\n    if (type !== 'compact') expect(rows(bare)[0]?.[0]).toBe('1,709,164,800,000');\n  });\n}\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'compact'] as const) {\n  it(`F4 ${type}: declaring an instant column as date keeps its UTC calendar dates in every zone`, () => {\n    for (const timeZone of zones) {\n      const r = chart(type, [\n        { x: new Date(instant), y: 3 }, { x: following, y: 4 },\n      ], { x: { field: 'x', type: 'date', timeZone } });\n      r.frames();\n      expect(codes(r)).toEqual([]);\n      check(r, type, [instant, following], ['Feb 29, 2024', 'Mar 1, 2024']);\n    }\n  });\n\n  it(`F4 ${type}: mixing calendar dates with a wall time and an instant reports both incompatible rows (reading: a clear majority fixes the axis type)`, () => {\n    const r = chart(type, [\n      { x: '2024-02-29', y: 3 }, { x: '2024-03-01T02:30', y: 40 },\n      { x: '2024-02-29T16:00Z', y: 50 }, { x: '2024-03-01', y: 4 },\n    ]);\n    r.frames();\n    expect(r.controller.handle.diagnostics).toMatchObject([{ code: 'AX107', field: 'x', rows: [1, 2] }]);\n    expect(lastModel(r).summary).toContain('maximum 4');\n    expect(lastModel(r).summary).toContain('Values not shown: 2.');\n    if (type !== 'compact') expect(rows(r).map(row => row[0])).toEqual(['Feb 29, 2024', 'Mar 1, 2024']);\n  });\n}\nimport { expect, it } from 'vitest';\nimport { at, chart, codes, committed, lastModel, marks, pathRuns, reading, rows, walk } from './model';\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'donut'] as const) {\n  it(`F12 ${type}: three bad values leave a three-value note and summary while the chart preserves the good observations`, () => {\n    // The Phase 1 dirty fixture specifies the codes and the number of omitted values.\n    const values = [10, 20, null, NaN, '40', undefined, 70];\n    const weekdays = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];\n    const data = values.map((y, i) => ({ x: type === 'scatter' ? i + 1 : weekdays[i]!, y }));\n    const r = chart(type, data, { description: 'Collected every day.' });\n    r.frames();\n    expect(codes(r).sort()).toEqual(['AX102', 'AX103', 'AX106']);\n    const note = 'Values not shown: 3. See table.';\n    expect(lastModel(r).note).toBe(note);\n    expect(lastModel(r).summary).toContain(note);\n    expect(lastModel(r).summary).toContain('Collected every day.');\n    expect(committed(r).reader.note).toBe(note);\n    expect(r.announcements).toEqual([]);\n    if (type === 'line' || type === 'area') {\n      expect(pathRuns(marks(r, 'path')[0]!.xy).map(run => run.length)).toEqual([2]);\n      expect(marks(r, 'points').some(mark => mark.xy.length >= 2)).toBe(true);\n    } else if (type === 'bar') {\n      expect(marks(r, 'rects').find(mark => mark.variant === 'bar')?.xywh).toHaveLength(12);\n      expect(marks(r, 'rects').find(mark => mark.variant === 'missing')?.xywh).toHaveLength(16);\n    } else if (type === 'scatter') expect(marks(r, 'points')[0]?.xy).toHaveLength(6);\n    else expect(marks(r, 'arcs')[0]?.angles).toHaveLength(6);\n    if (type !== 'scatter') {\n      expect(rows(r).map(row => row[1])).toEqual(['10', '20', 'No data', 'No data', 'No data', 'No data', '70']);\n      if (type !== 'donut') expect(at(r, 4).rows[0]?.value).toBe('No data');\n      else expect(reading(r, walk(r)[4]!)).toContain('No data');\n    }\n    r.controller.handle.update({ data: [{ x: type === 'scatter' ? 1 : 'Mon', y: 10 }, { x: type === 'scatter' ? 2 : 'Tue', y: 20 }] });\n    r.frames();\n    expect(lastModel(r).note).toBeNull();\n    expect(lastModel(r).summary).not.toContain(note);\n  });\n\n  it(`F12 ${type}: a throwing formatter discloses changed presentation even though the value is still drawn`, () => {\n    const input = [{ x: type === 'donut' ? 'A' : 1, y: 1 }, { x: type === 'donut' ? 'B' : 2, y: 2 }];\n    const r = chart(type, input, {\n      [type === 'donut' ? 'value' : 'y']: { field: 'y', format: (value: number) => {\n        if (value === 2) throw new Error('fixture');\n        return String(value);\n      } },\n    });\n    r.frames();\n    expect(codes(r)).toEqual(['AX160']);\n    const note = 'Values shown differently from the data: 1. See table.';\n    expect(lastModel(r).note).toBe(note);\n    expect(lastModel(r).summary).toContain(note);\n    expect(rows(r).map(row => row[type === 'scatter' ? 2 : 1])).toEqual(['1', '2']);\n  });\n}\nimport { fileURLToPath } from 'node:url';\nimport { build } from 'esbuild';\nimport { beforeAll, expect, it } from 'vitest';\nimport type { record } from '../core/host';\nimport { codes, lastModel, scene } from './model';\n\nlet production: typeof record;\n\nbeforeAll(async () => {\n  // Bundle the same controller and recording host with the production define, without writing build files.\n  const bundle = await build({\n    entryPoints: [fileURLToPath(new URL('../core/host.ts', import.meta.url))],\n    bundle: true, platform: 'node', format: 'esm', write: false, define: { __DEV__: 'false' },\n  });\n  const url = 'data:text/javascript;base64,' + Buffer.from(bundle.outputFiles[0]!.contents).toString('base64');\n  production = (await import(/* @vite-ignore */ url) as { record: typeof record }).record;\n});\n\nfor (const type of ['line', 'area', 'bar', 'scatter', 'donut'] as const) {\n  it(`F12 ${type}: production still reports omitted values in the figure and summary`, () => {\n    const data = [{ x: 1, y: 8 }, { x: 2, y: Infinity }, { x: 3, y: 5 }];\n    const options = type === 'donut' ? { label: 'x', value: 'y' } : { x: 'x', y: 'y' };\n    const r = production(type, { ...options, data, title: 'Measured', locale: 'en-US' });\n    r.frames();\n    expect(codes(r)).toEqual(['AX103']);\n    expect(r.printed.filter(message => message.includes('AX103'))).toHaveLength(1);\n    expect(lastModel(r).note).toBe('Values not shown: 1. See table.');\n    expect(lastModel(r).summary).toContain('Values not shown: 1. See table.');\n    expect(scene(r).marks.some(mark => ['arcs', 'points', 'path', 'rects'].includes(mark.type))).toBe(true);\n  });\n}\n\nit('C5 compact: production supplies the omission count to both the corner marker and summary', () => {\n  const r = production('line', {\n    x: 'x', y: 'y', compact: true, title: 'Measured', data: [{ x: 1, y: 3 }, { x: 2, y: Infinity }, { x: 3, y: 8 }],\n  });\n  r.frames();\n  expect(codes(r)).toEqual(['AX103']);\n  expect(lastModel(r).compact).toBe(true);\n  expect(lastModel(r).note).toContain('Values not shown: 1.');\n  expect(lastModel(r).summary).toContain('Values not shown: 1.');\n});\n\nit('DX4 line: production delivers hint AX104 to the callback while keeping the console quiet', () => {\n  const received: string[] = [];\n  const r = production('line', {\n    x: 'x', y: 'y', data: [{ x: 1, y: '3' }, { x: 2, y: '8' }], title: 'Measured',\n    onDiagnostic: (d: { code: string }) => received.push(d.code),\n  });\n  r.frames();\n  expect(codes(r)).toEqual(['AX104']);\n  expect(received).toEqual(['AX104']);\n  expect(r.printed).toEqual([]);\n});\n","exit_code":0,"status":"completed"}}
