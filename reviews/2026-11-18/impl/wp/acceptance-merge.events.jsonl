{"type":"item.started","item":{"id":"item_63","type":"command_execution","command":"/bin/bash -lc 'node --test acceptance/test/*.test.mjs > acceptance/results/check-tests.log 2>&1\ntest_status=$?\nnode acceptance/check.mjs --results acceptance/results/unit.json > acceptance/results/check-unit.log\nunit_check_status=$?\nnode acceptance/check.mjs --results acceptance/results/unit.json acceptance/results/browser.json acceptance/results/dist.json acceptance/results/dist-browser.json --roots . tests/dist packages/axylo packages/react > acceptance/results/check.log\ncombined_status=$?\nnode acceptance/check.mjs --release --results acceptance/results/unit.json acceptance/results/browser.json acceptance/results/dist.json acceptance/results/dist-browser.json > acceptance/results/release-check.log\nrelease_status=$?\nprintf '\"'Exit codes — node test %s, unit-only join %s, combined join %s, release gate %s\\\\n' \\\"\"'$test_status\" \"$unit_check_status\" \"$combined_status\" \"$release_status\"\ntail -8 acceptance/results/check-tests.log\ntail -7 acceptance/results/check.log\ntail -1 acceptance/results/unit.log\nnode --input-type=module <<'\"'EOF'\nimport {readFileSync} from 'node:fs';\nconst read = path => JSON.parse(readFileSync(path, 'utf8'));\nconst matrix = new Map(read('acceptance/matrix.json').map(row => [row.id, row]));\nfor (const [path, run] of [['acceptance', 'unit'], ['browser/acceptance', 'browser']]) {\n  const index = read('packages/axylo/test/' + path + '/EVIDENCE.json');\n  const unlinked = index.filter(({criterion, type, file, title}) => {\n    const row = matrix.get(criterion);\n    return \"'![...(row.evidence?.[type] ?? []), ...(row.weak?.[type] ?? [])].some(ref => ref.file === file && ref.title === title);\n  });\n  const suites = read('\"'acceptance/results/' + run + '.json').testResults.filter(suite => suite.name.includes('/packages/axylo/test/' + path + '/'));\n  const counts = Object.fromEntries([...Map.groupBy(suites.flatMap(suite => suite.asserti