st/browser/chart/review.browser.test.ts:433:      const missing = { label: figure.getAttribute('aria-label'), labelledby: figure.getAttribute('aria-labelledby'), codes: chart.diagnostics.map(d => d.code) };\npackages/axylo/test/browser/chart/review.browser.test.ts:440:        missing, heading: heading.id,\npackages/axylo/test/browser/chart/review.browser.test.ts:444:    expect(result.missing).toEqual({ label: 'Line chart of y by x', labelledby: null, codes: ['AX140'] });\npackages/axylo/test/browser/chart/node.browser.test.ts:13:    it(`import('${file}') does not throw and validate('line', …) returns diagnostics`, () => {\n/** Every key of the public `Messages` interface (src/public.ts), the spec's \"every built-in string\". */\nconst MESSAGE_KEYS = [\n  'viewAsTable', 'hideTable', 'noData', 'noObservation', 'incompleteStack', 'moreRows', 'otherSlices', 'valuesNotShown', 'valuesChanged', 'labelsHidden',\n  'loading', 'empty', 'error', 'internalError', 'chartName', 'chartSummary', 'seriesSummary', 'referenceSummary', 'timeZoneNote', 'plotLabel', 'controlsLabel',\n  'pointOf', 'zoomIn', 'zoomOut', 'resetZoom', 'pause', 'resume', 'previousPage', 'nextPage', 'pageOf', 'jumpToX', 'showSeries', 'hideSeries', 'category',\n  'percentage', 'series', 'value', 'typeLine', 'typeArea', 'typeBar', 'typeScatter', 'typeDonut', 'donutSummary', 'seriesNoData', 'seriesNotDrawn',\n  'referenceLine', 'referenceBand', 'plotRole', 'pointAll', 'seriesValue', 'position', 'total', 'panLeft', 'panRight', 'jumpNotFound', 'plotInstructions',\n] as const;\nconst PLACEHOLDERS = '{count} {type} {x} {y} {series} {value} {index} {page} {label} {from} {to} {zone} {min} {max} {last} {total} {xLabel} {xMin} {xMax} {yLabel} {yMin} {yMax} {seriesCount} {values} {position} {percent} {example}';\n/** Distinctive words of the built-in English text; none may remain once every message is replaced. */\nconst ENGLISH = ['View as table', 'Hide table', 'Chart plot', 'Chart controls', 'Zoom in', 'Zoom out', 'Reset zoom', 'No data', 'not shown', 'Previous page', 'Next page', 'Jump to', 'Category', 'Percentage', 'minimum', 'maximum', 'Point ', 'chart with', 'Pause', 'Times are shown', ' chart'];\n\n/** Every text an assistive technology or a sighted reader gets from the chart, after the reader used it. */\nasync function everyText(page: Page, type: ChartType): Promise<string> {\n  const parts: string[] = [];\n  if (type !== 'compact') {\n    await page.focus('#chart .axylo-proxy');\n    await page.keyboard.press('ArrowRight');\n    parts.push(await valueText(page));\n    await page.locator('#chart [role=\"toolbar\"] button').last().click();\n    await settle(page);\n  }\n  for (const n of await axWithin(page, '#chart')) parts.push(n.name, n.description, String(n.props.roledescription ?? ''));\n  parts.push(await page.locator('#chart').innerText());\n  return parts.join(' | ');\n}\n\ndescribe('A10 built-in text', () => {\n  for (const type of TYPES) {\n    it(`A10 ${type}: every built-in string is replaced through messages: none of the built-in English is left in the figure, the accessibility tree or the value text`, async () => {\n      const page = await devPage();\n      const messages = Object.fromEntries(MESSAGE_KEYS.map(k => [k, `ZZ-${k} ${PLACEHOLDERS}`]));\n      // Dirty data, so the note is shown; a donut and the cartesian types each get theirs.\n      await create(page, type, { messages, title: 'Replaced' }, '#chart', 'dirty');\n      if (type !== 'compact') await call(page, 'append', [type === 'donut' ? [{ day: 'Mon2', value: 5 }] : type === 'scatter' ? [{ n: 8, value: 5 }] : [{ day: 'Mon2', value: 5 }]]);\n      const text = await everyText(page, type);\n      expect(ENGLISH.filter(e => text.includes(e)), text.slice(0, 2000)).toEqual([]);\n      expect(text).toContain('ZZ-');\n      expect(await closePage(page)).toEqual([]);\n    });\n\n    it(`A10 ${type}: on a lang=\"de\" page the built-in English text is marked lang=\"en\", and the author's own text is not (reading: the generated summary's sentences are built-in English)`, async () => {\n      const page = await devPage();\n      await page.evaluate(() => document.documentElement.setAttribute('lang', 'de'));\n      await create(page, type, { title: 'Energieverbrauch' }, '#chart', 'dirty');\n      if (type !== 'compact') {\n        await page.focus('#chart .axylo-proxy');\n        await page.locator('#chart [role=\"toolbar\"] button', { hasText: 'View as table' }).click();\n        await settle(page);\n      }\n      const wrong = await page.evaluate(() => {\n        const out: string[] = [];\n        const langOf = (el: Element) => el.closest('[lang]')?.getAttribute('lang') ?? '';\n        // Built-in English: the summary, the note, the toolbar's fixed controls, the plot's name and role, the table pager.\n        const builtIn = [\n          ...document.querySelectorAll('#chart .axylo-summary, #chart .axylo-note:not([hidden]), #chart .axylo-pager button, #chart .axylo-page'),\n          ...[...document.querySelectorAll('#chart [role=\"toolbar\"] button:not(.axylo-legend-entry)')],\n          ...document.querySelectorAll('#chart .axylo-proxy'),\n        ];\n        for (const el of builtIn) if (langOf(el) !== 'en') out.push(`not marked en: ${el.className} \"${(el.textContent || el.getAttribute('aria-label') || '').slice(0, 40)}\"`);\n        const title = document.querySelector('#chart .axylo-title:not([hidden])');\n        if (title && langOf(title) === 'en') out.push('author title marked en');\n        return out;\n      });\n      expect(wrong).toEqual([]);\n      expect(await closePage(page)).toEqual([]);\n    });\n  }\n});\n\n  const r = chart('donut', donut);\n  r.frames();\n  const { lookup } = committed(r);\n  const tooltip = lookup.tooltip(targetOf(walk(r)[0]!));\n  expect(tooltip.title).toBe('First');\n  expect(tooltip.rows).toMatchObject([{ seriesLabel: 'First', value: '3', percent: '75%' }]);\n  expect(tooltip.total).toBeNull();\n});\n\nit('T-tooltip-scatter scatter: lists at most eight coincident points, reports the total and includes series, x and y', () => {\n  const r = chart('scatter', Array.from({ length: 10 }, (_, i) => ({ x: 3, y: 6, s: 'Point ' + i })), { series: 's' });\n  r.frames();\n  const { x, y } = axes(r);\n  const { lookup } = committed(r);\n  const tooltip = lookup.tooltip(lookup.pick(pixel(x, 3), y.map(6))!);\n  expect(tooltip.title).toBe('3');\n  expect(tooltip.count).toBe(10);\n  expect(tooltip.rows).toHaveLength(8);\n  expect(tooltip.rows[0]).toMatchObject({ seriesLabel: 'Point 9', x: '3', value: '6', row: 9 });\n  expect(tooltip.rows.every(row => row.x === '3' && row.value === '6')).toBe(true);\n  expect(new Set(tooltip.rows.map(row => row.seriesLabel)).size).toBe(8);\n});\n\nfor (const type of ['line', 'area', 'bar', 'scatter'] as const) {\n  it(`T-zoom-${type} ${type}: numeric, time and calendar-date fields support zoom on x and Reset restores all observations`, () => {\n    const epoch = Date.UTC(2024, 1, 24);\n    for (const [kind, values] of [\n      ['number', [1, 2, 3]],\n      ['time', [epoch, epoch + day, epoch + 2 * day]],\n      ['date', ['2024-02-24', '2024-02-25', '2024-02-26']],\n    ] as const) {\n      const r = chart(type, xy.map((row, i) => ({ ...row, x: values[i]! })), { x: { field: 'x', type: kind }, y: { field: 'y', domain: [0, 10] } });\n      const handle = r.controller.handle;\n      r.frames();\n      expect(committed(r).zoom).toBe(true);\n      handle.zoom([values[1], values[2]]);\n      r.frames();\n      expect(committed(r).zoomed).toBe(true);\n      expect(committed(r).lookup.count).toBe(2);\n      expect(axes(r).y.domain).toEqual([0, 10]);\n      expect(committed(r).reader.table?.rowCount).toBe(2);\n      handle.zoom(null);\n      r.frames();\n      expect(committed(r).zoomed).toBe(false);\n      expect(committed(r).reader.table?.rowCount).toBe(3);\n    }\n  });\n\n  it(`T-limit-${type} ${type}: eight series are accepted without AX130; the ninth raises it with all nine still readable`, () => {\n    const r = chart(type, seriesRows(8), { series: 's' });\n    r.frames();\n    expect(codes(r)).toEqual([]);\n    r.controller.handle.update({ data: seriesRows(9) });\n    r.frames();\n    expect(codes(r)).toEqual(['AX130']);\n    expect(lastModel(r).summary).toContain('9 series');\n      expect(code).not.toMatch(/axylo-figure|ResizeObserver/);\n    });\n  }\n\n  it('the production file drops the development hint, the development file keeps it', () => {\n    expect(read('index.js')).not.toContain('[axylo/react]');\n    expect(read('index.dev.js')).toContain('[axylo/react]');\n  });\n\n  it('the production file is at most 2 KiB gzipped', () => {\n    const code = fs.readFileSync(path.join(pkg, 'dist/index.js'));\n    const gzip = gzipSync(code, { level: 9 }).length;\n    console.info(`@axylo/react dist/index.js: ${code.length} B, ${gzip} B gzip (level 9)`);\n    expect(gzip).toBeLessThanOrEqual(2048);\n  });\n\n  it('the declarations are what a consumer type-checks against', () => {\n    expect(read('index.d.ts')).toContain('export declare const Line: <Row>(props: LineProps<Row>) => ReactElement | null;');\n    // test/consumer imports '@axylo/react' with no path mapping, so it reaches dist/index.d.ts.\n    execFileSync('npx', ['tsc', '-p', path.join(pkg, 'test/consumer')], { cwd: repo, stdio: 'pipe' });\n  });\n});\n\ndescribe('server rendering through the package name', () => {\n  // Types from source, so `tsc -p packages/react` does not need dist; the runtime import is the shipped one.\n  type Components = typeof import('../src/index');\n  const shipped = (specifier: string) => import(specifier) as Promise<Components>;\n  const rows = [{ day: '2026-01-01', channel: 'Direct', sessions: 10, visits: 4 }, { day: '2026-01-02', channel: 'Direct', sessions: 12, visits: 5 }];\n  type Row = (typeof rows)[number];\n\n  const elements = ({ Area, Bar, Donut, Line, Scatter }: Components): [string, ReactElement][] => [\n    ['Line', createElement(Line<Row>, { data: rows, x: 'day', y: 'sessions', series: 'channel', title: 'Sessions' })],\n    ['Area', createElement(Area<Row>, { data: rows, x: 'day', y: 'sessions', stacked: true })],\n  scripts.classic = (await bundle({ name: 'csp-charts-classic', cwd: pages, contents: `import { makeCharts, type Library } from './charts';\\nmakeCharts((window as unknown as { Axylo: Library }).Axylo);` })).url;\n  for (const condition of ['production', 'development']) {\n    scripts[`module-${condition}`] = (await bundle({\n      name: `csp-charts-module-${condition}`, cwd: fixture('npm'), format: 'esm', conditions: [condition],\n      contents: `import * as A from 'axylo';\\nimport { makeCharts } from ${JSON.stringify(path.join(pages, 'charts'))};\\nmakeCharts(A);`,\n    })).url;\n  }\n});\nafterAll(async () => { await closeBrowser(); await server?.close(); });\n\nconst LOADERS = {\n  'script tag, production (axylo.iife.min.js)': () => `<script src=\"/script/node_modules/axylo/dist/axylo.iife.min.js\"></script><script src=\"${scripts.classic}\"></script>`,\n  'script tag, development (axylo.iife.js)': () => `<script src=\"/script/node_modules/axylo/dist/axylo.iife.js\"></script><script src=\"${scripts.classic}\"></script>`,\n  'bundled module, production condition': () => `<script type=\"module\" src=\"${scripts['module-production']}\"></script>`,\n  'bundled module, development condition': () => `<script type=\"module\" src=\"${scripts['module-development']}\"></script>`,\n};\n\nfunction html(loader: string, linked: boolean): string {\n  return `<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>Axylo under a strict policy</title>\n<link rel=\"stylesheet\" href=\"/pages/page.css\">\n${linked ? '<link rel=\"stylesheet\" href=\"/npm/node_modules/axylo/dist/axylo.css\">' : ''}\n<script src=\"/pages/observe.js\"></script>\n</head><body>\n<h1>Charts under a strict policy</h1>\n${CHARTS.map(id => `<div class=\"${id === 'compact' ? 'tile' : 'chart'}\" id=\"${id}\"></div>`).join('\\n')}\n${loader}\n</body></html>`;\n}\n\ninterface Seen {\n  violations: unknown[];\n  created: string[];\n  xss: unknown;\n  missing: string | null;\n  diagnostics: { chart: number; code: string; level: string }[];\n  adopted: number;\n  styleElements: number;\n  linkedActive: boolean;\n}\n\nlet counter = 0;\ndescribe.each(Object.entries(LOADERS))('%s', (_label, loader) => {\n  describe.each([['applied at run time', false], ['linked by the page', true]] as const)('stylesheet %s', (_how, linked) => {\n    it('draws every chart type, opens a tooltip and the tables, with no violation, no console error and no markup created', async () => {\n      const at = `/csp/page-${++counter}.html`;\n      server.pages.set(at, { html: html(loader(), linked), headers: { 'content-security-policy': POLICY } });\n      server.reports.length = 0;\n      const w = await open(server);\n      const response = await w.page.goto(`${server.origin}${at}`);\n      expect(response?.headers()['content-security-policy']).toBe(POLICY);\n\n      for (const id of CHARTS) {\n        const state = await drawn(w.page, `#${id}`);\n        expect(state.figures, `#${id} figures`).toBe(1);\n        expect(state.marks, `#${id} marks`).toBeGreaterThan(0);\n        expect(state.errorState, `#${id} error state`).toBe(false);\n        // The title is the accessible name, character for character: inserted as text.\n        expect(await figureName(w.page, `#${id}`), `#${id} name`).toContain(TITLES[id].slice(0, 20));\n        // A compact chart has no visible heading (spec 3.7); its name is its text alternative.\n        if (id !== 'compact') expect(await w.page.locator(`#${id} .axylo-title`).first().textContent()).toBe(TITLES[id]);\n      }\n\n      // Tooltips: the series or category name and the formatter output are shown as text. The pointer\n      // sweeps the plot left to right until the tooltip shows the datum carrying the payload.\n      for (const [id, expected] of [['line', IMG], ['bar', SCRIPT]] as const) {\n        await w.page.locator(`#${id} .axylo-plot`).scrollIntoViewIfNeeded();\n        const plot = (await w.page.locator(`#${id} .axylo-plot`).boundingBox())!;\n        // Spec I1: content too wide for a floating tooltip goes to the fixed readout under the plot instead,\n        // which these long payloads cause.\n        const tip = w.page.locator(`#${id} .axylo-tooltip, #${id} .axylo-readout`).filter({ visible: true });\n        let text = '';\n        for (let f = 0.3; f < 0.99 && !text.includes(expected); f += 0.05) {\n          await w.page.mouse.move(plot.x + plot.width * f, plot.y + plot.height * 0.5);\n          await w.page.waitForTimeout(50);\n          if (await tip.count() === 1) text = (await tip.textContent()) ?? '';\n        }\n        expect(text, `#${id} tooltip`).toContain(expected);\n        expect(text, `#${id} tooltip formatter output`).toContain('<img src=x onerror=');\n        await w.page.mouse.move(2, 2);\n      }\n\n      // Tables.\n      for (const id of ['line', 'area', 'bar', 'scatter', 'donut'] as const) {\n        await w.page.locator(`#${id} [role=\"toolbar\"] button`, { hasText: 'View as table' }).click();\n        const table = w.page.locator(`#${id} table`);\n        await expect.poll(() => table.count(), { timeout: 5000 }).toBeGreaterThan(0);\n        expect(await table.first().locator('tr').count(), `#${id} table rows`).toBeGreaterThan(1);\n        const text = (await table.first().textContent()) ?? '';\n        if (id !== 'area') expect(text, `#${id} table text`).toMatch(/<img src=x onerror=|<script>/);\n      }\n\n      await w.page.waitForTimeout(300); // reports are sent asynchronously\n      const seen: Seen = await w.page.evaluate(() => {\n        const g = window as unknown as Record<string, unknown>;\n        const charts = (g.__charts as { diagnostics: { code: string; level: string }[] }[] | undefined) ?? [];\n        const link = Array.from(document.styleSheets).find(s => s.href?.endsWith('/axylo.css'));\n        return {\n          violations: g.__violations as unknown[], created: g.__created as string[], xss: g.__xss ?? null, missing: g.__missing as string | null,\n          diagnostics: charts.flatMap((c, chart) => c.diagnostics.map(d => ({ chart, code: d.code, level: d.level }))),\n          adopted: document.adoptedStyleSheets.length, styleElements: document.querySelectorAll('style').length,\n          linkedActive: !!link && !link.disabled,\n        };\n      });\n      const errors = [...w.errors, ...w.console.filter(m => m.type === 'error').map(m => m.text)];\n      const warnings = w.console.filter(m => m.type === 'warning').map(m => m.text);\n      if (warnings.length) console.info(`console warnings: ${JSON.stringify(warnings)}`);\n      console.info(`stylesheets: adopted ${seen.adopted}, <style> ${seen.styleElements}, linked axylo.css active ${seen.linkedActive}`);\n\n      expect(seen.violations, 'securitypolicyviolation events').toEqual([]);\n      expect(server.reports, 'reports sent to the report URI').toEqual([]);\n      expect(errors, 'console errors and page errors').toEqual([]);\n      expect(seen.created, 'elements created from markup in text').toEqual([]);\n      expect(seen.xss, 'payload ran').toBeNull();\n      expect(seen.diagnostics.filter(d => d.level === 'error')).toEqual([]);\n      expect(seen.missing, 'error for a selector that matches nothing').toContain('#no-such-chart');\n      expect(seen.styleElements, 'the library creates no <style> element').toBe(0);\n      if (linked) {\n        expect(seen.linkedActive).toBe(true);\n        expect(seen.adopted, 'nothing adopted when the page links axylo.css').toBe(0);\n      } else {\n        expect(seen.adopted, 'the stylesheet adopted at run time').toBe(1);\n      }\n      expect(w.external).toEqual([]);\n      await w.context.close();\n    });\n  });\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_39","type":"agent_message","text":"The source review found several cases where the test title overstates the assertion. For example, L8 checks that the fallback summary is visible but never checks that it fits on one line. I’ll record that as partial evidence."}}
{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -lc \"cat > acceptance/results/merge.mjs <<'EOF'\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { execFileSync } from 'node:child_process';\nimport { readTitles, matchesTemplate } from '../titles.mjs';\n\nconst read = file => JSON.parse(readFileSync(file, 'utf8'));\nconst matrix = JSON.parse(execFileSync('git', ['show', 'HEAD:acceptance/matrix.json'], { encoding: 'utf8' }));\nconst rows = new Map(matrix.map(row => [row.id, row]));\nconst full = ['line', 'area', 'bar', 'scatter', 'donut'];\nconst cart = full.slice(0, 4);\nconst all = [...full, 'compact'];\nconst readCache = new Map();\nconst titles = file => {\n  if (\"'!readCache.has(file)) readCache.set(file, readTitles(readFileSync(file, '\"'utf8'), file));\n  return readCache.get(file);\n};\n\nfunction reference(file, title, kind, ancestors) {\n  const catalog = titles(file);\n  const ref = { kind, file, title };\n  if (\"'!catalog.tests.some(test => test.title === title)) {\n    const candidates = catalog.templates.filter(({ template }) => matchesTemplate(title, template));\n    if (candidates.length !== 1) throw new Error(file + '\"' · ' + title);\n    ref.registration = candidates[0].template;\n  }\n  if (ancestors) ref.ancestors = ancestors;\n  return ref;\n}\n\nfunction add(id, types, refs, reason) {\n  const row = rows.get(id);\n  const key = reason ? 'weak' : 'evidence';\n  row[key] ??= {};\n  for (const type of types) {\n    if (\"'!row.appliesTo.includes(type)) throw new Error(id + '\"'/' + type);\n    row[key][type] ??= [];\n    for (const ref of refs) {\n      if (\"'!row[key][type].some(r => r.file === ref.file && r.title === ref.title && JSON.stringify(r.ancestors) === JSON.stringify(ref.ancestors))) {\n        row[key][type].push(reason ? { ...ref, reason } : ref);\n      }\n    }\n  }\n}\nfunction gap(id, types, note) {\n  const row = rows.get(id);\n  row.gaps ??= {};\n  for (const type of types) row.gaps[type] = note;\n}\nfunction link(to, from, types, select = () => true) {\n  const row = rows.get(from);\n  for (const type of types) {\n    add(to, [type], (row.evidence?.[type] ?? []).filter(select));\n  }\n}\n\nconst indexes = [\n  ...read('\"'packages/axylo/test/acceptance/EVIDENCE.json'),\n  ...read('packages/axylo/test/browser/acceptance/EVIDENCE.json'),\n];\nconst reviewedCells = new Set(indexes.map(({ criterion, type }) => criterion + '/' + type));\n// Replace the old partial references where the new suites reach the same behavior through the chart.\nfor (const row of matrix) for (const type of row.appliesTo) {\n  if (reviewedCells.has(row.id + '/' + type)) delete row.weak?.[type];\n}\nfor (const { criterion, type, file, title } of indexes) {\n  const kind = file.includes('/browser/') ? 'browser' : /for any|for every generated/.test(title) ? 'property' : 'unit';\n  const ref = reference(file, title, kind);\n  const reason =\n    criterion === 'I5' && /300 ms/.test(title) ? 'A 300 ms wait cannot establish the 200 ms bound. The reduced-motion assertion compares an early screenshot with the final one.' :\n    criterion === 'F8' && /only drawn arcs use the limit/.test(title) ? 'This fixture checks eight positive arcs plus zero and missing rows, under an interpretation of which slices count toward eight.' :\n    criterion === 'F3' && /AX130 keeps all nine/.test(title) ? 'Counts nine marks and verifies AX130 but never compares secondary cues.' :\n    undefined;\n  add(criterion, [type], [ref], reason);\n}\n\n// Additional evidence where the acceptance indexes classify the same assertion under another criterion.\nlink('F1', 'C2', ['compact'], ref => ref.file.includes('/browser/') && ref.title.includes('82–97'));\nlink('F11', 'C2', ['compact'], ref => ref.file.includes('/browser/') && ref.title.includes('shuffled'));\nlink('F5', 'T-dense-line', ['line']);\nlink('F5', 'T-dense-area', ['area']);\nlink('T-dense-line', 'F5', ['line']);\nlink('T-dense-area