    if (!stack.length) return index;\n  }\n  return parts.length;\n}\n\nfunction literalList(parts, start) {\n  if (parts[start] !== '[') return null;\n  const values = [];\n  let index = start + 1;\n  while (index < parts.length && parts[index] !== ']') {\n    const token = parts[index];\n    if (token === '[') {\n      const nested = literalList(parts, index);\n      if (!nested) return null;\n      values.push(nested);\n      index = closing(parts, index);\n    } else {\n      const value = token === '-' ? token + parts[++index] : token;\n      if (/^['\"]/.test(value)) values.push(unescape(value.slice(1, -1)));\n      else if (/^-?\\d+$|^(true|false|null|NaN|Infinity|-Infinity)$/.test(value)) values.push(value);\n      else return null;\n    }\n    index++;\n    if (parts[index] === ',') index++;\n    else if (parts[index] !== ']') return null;\n  }\n  return parts[index] === ']' ? values : null;\n}\n\nfunction listByName(source, file, name) {\n  if (!/^\\w+$/.test(name)) return null;\n  const declaration = new RegExp('\\\\bconst\\\\s+' + name + '\\\\s*(?::[^=;]+)?=\\\\s*(?=\\\\[)');\n  const list = content => {\n    const match = declaration.exec(content);\n    return match && literalList(tokens(content.slice(match.index + match[0].length)), 0);\n  };\n  const local = list(source);\n  if (local) return local;\n  const imports = source.matchAll(/^import\\s*\\{([^}]+)\\}\\s*from\\s*['\"](\\.[^'\"]+)['\"]/gm);\n  for (const [, names, specifier] of imports) {\n    if (!names.split(',').some(imported => imported.trim() === name)) continue;\n    const base = resolve(dirname(file), specifier);\n    for (const candidate of [base, base + '.ts', base + '.js', base + '.mjs']) {\n      try {\n        return list(readFileSync(candidate, 'utf8'));\n      } catch (error) {\n        if (error.code !== 'ENOENT' && error.code !== 'EISDIR') throw error;\n      }\n    }\n  }\n  return null;\n}\n\nfunction expandTitles(token, rows, loops) {\n  if (!token || !/^['\"`]/.test(token)) return [];\n  const raw = token.slice(1, -1);\n  let titles = [raw];\n  if (token.startsWith('`')) {\n    for (const [expression, name] of raw.matchAll(/\\$\\{([^}]+)\\}/g)) {\n      const loop = loops.findLast(item => item.name === name.trim());\n      if (!loop || !loop.values || loop.values.some(Array.isArray)) return [];\n      titles = titles.flatMap(title => loop.values.map(value => title.replace(expression, () => value)));\n    }\n  }\n  if (rows) {\n    titles = titles.flatMap(title => rows.map((row, index) => {\n      const values = Array.isArray(row) ? row : [row];\n      let column = 0;\n      return title.replace(/%[sdi#%]/g, match => {\n        if (match === '%#') return index;\n        if (match === '%%') return '%';\n        return values[column++] ?? match;\n      });\n    }));\n  }\n  return titles.map(unescape);\n}\n\nexport function readTitles(source, file) {\n  const parts = tokens(source);\n  const suites = [];\n  const tests = [];\n  const loops = [];\n  for (let index = 0; index < parts.length; index++) {\n    const token = parts[index];\n    if (token === 'for' && parts[index + 1] === '(' && parts[index + 2] === 'const' && parts[index + 4] === 'of') {\n      const start = closing(parts, index + 1) + 1;\n      if (parts[start] === '{') {\n        const values = literalList(parts, index + 5) ?? listByName(source, file, parts[index + 5]);\n        loops.push({ name: parts[index + 3], start, end: closing(parts, start), values });\n      }\n    }\n    if (!['it', 'test', 'describe'].includes(token) || parts[index - 1] === '.') continue;\n    let call = index + 1;\n    let rows;\n    while (parts[call] === '.') {\n      const modifier = parts[call + 1];\n      call += 2;\n      if (['each', 'skipIf', 'runIf'].includes(modifier) && parts[call] === '(') {\n        if (modifier === 'each') rows = literalList(parts, call + 1) ?? [];\n        call = closing(parts, call) + 1;\n      }\n    }\n    if (parts[call] !== '(') continue;\n    const titles = parts[call + 2] === ','\n      ? expandTitles(parts[call + 1], rows, loops.filter(loop => loop.start < index && index < loop.end))\n      : [];\n    if (token === 'describe') {\n      const end = closing(parts, call);\n      // The callback's block ends just before the last argument or closing parenthesis.\n      const start = parts.indexOf('{', call + 3);\n      if (start !== -1 && start < end) for (const title of titles) suites.push({ title, start, end: closing(parts, start) });\n    } else {\n      const ancestors = suites.filter(suite => suite.start < index && index < suite.end).map(suite => suite.title);\n      // An unresolved case must stop a partially reported suite from appearing to pass.\n      for (const title of titles.length ? titles : [null]) tests.push({ title, ancestors });\n    }\n  }\n  return { suites: suites.map(suite => suite.title), tests };\n}\n{\n  \"testResults\": [{\n    \"name\": \"./chart.test.ts\",\n    \"assertionResults\": [\n      { \"title\": \"line renders\", \"ancestorTitles\": [\"render examples\"], \"status\": \"passed\" },\n      { \"title\": \"area renders\", \"ancestorTitles\": [\"render examples\"], \"status\": \"skipped\" },\n      { \"title\": \"bar has a baseline\", \"ancestorTitles\": [\"render examples\"], \"status\": \"passed\" }\n    ]\n  }]\n}\n{\n  \"testResults\": [{\n    \"name\": \"./chart.test.ts\",\n    \"assertionResults\": [\n      { \"title\": \"line renders\", \"ancestorTitles\": [\"render examples\"], \"status\": \"failed\" },\n      { \"title\": \"area renders\", \"ancestorTitles\": [\"render examples\"], \"status\": \"passed\" }\n    ]\n  }]\n}\n[\n  {\n    \"id\": \"F1\",\n    \"statement\": \"Show the fixture faithfully.\",\n    \"appliesTo\": [\"line\", \"area\", \"bar\"],\n    \"notApplicable\": {\n      \"scatter\": \"No scatter fixture.\",\n      \"donut\": \"No donut fixture.\",\n      \"compact\": \"Only full figures are scoped.\"\n    },\n    \"evidence\": {\n      \"line\": [{\"file\": \"chart.test.ts\", \"kind\": \"unit\", \"title\": \"line renders\"}],\n      \"bar\": [{\"file\": \"chart.test.ts\", \"kind\": \"unit\", \"title\": \"bar has a baseline\"}]\n    },\n    \"weak\": {\n      \"area\": [{\n        \"file\": \"chart.test.ts\", \"kind\": \"unit\", \"title\": \"area renders\",\n        \"reason\": \"The smoke test does not check the geometry.\"\n      }]\n    }\n  },\n  {\n    \"id\": \"F2\",\n    \"statement\": \"Keep breaks visible.\",\n    \"appliesTo\": [\"line\"],\n    \"notApplicable\": {\n      \"area\": \"Out of scope.\",\n      \"bar\": \"Out of scope.\",\n      \"scatter\": \"Out of scope.\",\n      \"donut\": \"Out of scope.\",\n      \"compact\": \"Out of scope.\"\n    },\n    \"cannotVerify\": {\"line\": \"A real phone is required.\"}\n  },\n  {\n    \"id\": \"T-pointer-line\",\n    \"statement\": \"Nearest x.\",\n    \"appliesTo\": [\"line\"],\n    \"notApplicable\": {\n      \"area\": \"Line cell.\",\n      \"bar\": \"Line cell.\",\n      \"scatter\": \"Line cell.\",\n      \"donut\": \"Line cell.\",\n      \"compact\": \"Line cell.\"\n    },\n    \"evidence\": {\n      \"line\": [{\"file\": \"chart.test.ts\", \"kind\": \"unit\", \"prefix\": \"render examp\"}]\n    }\n  },\n  {\n    \"id\": \"T-pointer-bar\",\n    \"statement\": \"Under the pointer.\",\n    \"appliesTo\": [\"bar\"],\n    \"notApplicable\": {\n      \"line\": \"Bar cell.\",\n      \"area\": \"Bar cell.\",\n      \"scatter\": \"Bar cell.\",\n      \"donut\": \"Bar cell.\",\n      \"compact\": \"Bar cell.\"\n    },\n    \"evidence\": {\n      \"bar\": [{\"file\": \"chart.test.ts\", \"kind\": \"unit\", \"prefix\": \"render examples\"}]\n    }\n  }\n]\n### 3.5 Diagnostic registry\n\nLevel decides delivery. **Error**: the chart or a series cannot be drawn; the chart shows its error state. **Warning**: something is not drawn as given; the reader sees the note in F12. **Hint**: advice for the author. Errors and warnings print once per code per page in every build; hints print in development builds only. `strict: true` throws on errors and warnings found while validating a create, `update` or `append` call, synchronously from that call. A diagnostic that can only arise later (a contrast check after the page's CSS changes, a custom formatter that throws when a table page is built, a label that stops fitting after a resize) is reported when it is found and is never thrown. Every diagnostic names the chart; those about data name the field and the first row indexes in the caller's own data.\n\n| Code | Level | Condition | What is drawn |\n|---|---|---|---|\n| AX100 | Error | Typed columns have different lengths | Error state; the message names the columns and their lengths |\n| AX101 | Error | A named field is not a key of any row | Error state; the message lists the keys that exist and the closest match |\n| AX102 | Warning | A field is absent (`undefined`) in some rows | Gaps |\n| AX103 | Warning | A value is `NaN` or infinite | Gap |\n| AX104 | Hint | Every non-missing value of a value field is a plain decimal string (`'40'`, `'-1.5'`) | Parsed and drawn; the message suggests `parse: 'number'`. An empty string counts as missing |\n| AX105 | Hint | Steps are absent on a regular time, date, wall-clock or number axis | Gaps. When a series would need more absent steps than twice its observations (and more than 1,000), it is treated as irregular instead: no gaps are created and the hint says so |\n| AX106 | Warning | A value field mixes numbers with strings, or holds strings that are not plain decimals (`'1,234'`, `'n/a'`) | The strings are not drawn |\n| AX107 | Warning | A date or time cannot be parsed | That row is not drawn |\n| AX108 | Error | Duplicate x within a series, or duplicate donut labels | That series, or the donut, is not drawn |\n| AX109 | Hint | Numbers on an axis declared `time` look like seconds, or a numeric x looks like epoch milliseconds without `type: 'time'` | As declared |\n| AX110 | Warning | An author domain on bar or area excluded zero | Domain widened to zero |\n| AX111 | Hint | Instants look like calendar dates | As instants, zone shown |\n| AX112 | Hint | Date-time strings have no offset | As written |\n| AX120 | Error | Negative donut value | Error state |\n| AX121 | Warning | More than eight donut slices | Seven largest plus \"Other (n)\" |\n| AX130 | Warning | More than eight series | All series, with dash or marker differences |\n| AX140 | Warning | No `title` and no `labelledBy` | Generated name |\n| AX141 | Warning | Palette below 3:1 on the resolved background | As themed |\n| AX142 | Hint | Plot too small to draw | Summary and table control |\n| AX143 | Hint | Labels hidden after every remedy | Note shown to the reader |\n| AX150 | Warning | Unknown option key | Ignored; the message suggests the closest known key |\n| AX151 | Warning | `append` rows out of order | Accepted through the slower full update |\n| AX131 | Hint | A compact chart has more than one series | Drawn, with dash differences |\n| AX132 | Hint | More bars than pixels along the category axis | Drawn; the message suggests aggregating |\n| AX133 | Hint | A scatter chart has more than 50,000 points | Drawn; the message says drawing may be slow |\n| AX134 | Error | Series × x positions exceeds 20,000,000 (long rows with many series and little shared x) | Error state; the message gives both counts and suggests fewer series or a scatter chart |\n| AX152 | Warning | `timeZone` is not a zone the browser knows | The viewer's zone is used |\n| AX160 | Warning | A custom formatter threw | The default format is used for that value |\n| AX199 | Error | Axylo itself failed while building the chart | Error state with a generic message; the error is passed to `onDiagnostic` and printed |\n\nExpected results for the Phase 1 fixtures: the combined `dirty` fixture (`[10, 20, null, NaN, '40', undefined, 70]`) yields AX102, AX103 and AX106 once each, draws Mon–Tue as a segment and Sun as a point, and shows the F12 note. `dirty-string` (one `'40'` among numbers) yields AX106. A column made only of numeric strings yields AX104 and is drawn in full. `dirty-null` yields nothing.\n\nThe split between AX104 and AX106 answers a reviewer's objection that common back ends return counts as strings (Postgres `bigint` and `numeric`, BigQuery): a whole column of plain decimal strings is unambiguous and is parsed; a stray string among numbers is a bug and is not.\n\n### 3.6 Type matrix\n","exit_code":0,"status":"completed"}}
